fn main()i32 {
  emit("PROBE-PJ-NOFEEDBACK\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4);
  let a:i32=ev_query(W,1,40,-2,0);
  emit("query expected=-2 ans="); e64(a); emit("\n");
  let mc:i32=0; let uc:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){mc=mc+1;}
    if(ng(W,n,36)==1 && ng(W,n,0)==30){uc=uc+1;}
    n=n+1;
  }
  emit("maps="); e64(mc); emit(" uncert="); e64(uc); emit("\n");
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,1,11,2); ev_teach(W2,2,11,3); ev_teach(W2,3,11,4);
  let b:i32=ev_query(W2,1,40,4,0);
  let mc2:i32=0; n=2;
  while(n<1024){
    if(ng(W2,n,36)==1 && ng(W2,n,0)==20){mc2=mc2+1;}
    n=n+1;
  }
  emit("control ans="); e64(b); emit(" maps="); e64(mc2); emit("\n");
  return 0;
}

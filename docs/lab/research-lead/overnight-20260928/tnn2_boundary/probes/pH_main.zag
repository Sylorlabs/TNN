fn live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn main()i32 {
  emit("PROBE-PH-MEMORY\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<1015){
    ev_teach(W,7000+i,71,9000+i);
    i=i+1;
  }
  emit("live-after-fill="); e64(live_count(W)); emit("\n");
  let t1:i32=ev_teach(W,1,11,2);
  let t2:i32=ev_teach(W,2,11,3);
  emit("chain teaches="); e64(t1); emit(","); e64(t2); emit("\n");
  let a:i32=ev_query(W,1,40,3,0);
  emit("construction-under-pressure ans="); e64(a); emit("\n");
  emit("live-after="); e64(live_count(W)); emit("\n");
  return 0;
}

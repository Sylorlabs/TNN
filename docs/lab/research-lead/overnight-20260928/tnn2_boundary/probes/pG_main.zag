fn mkcomb2(W:[]u8)void {
  let cn:i32=alloc_node(W); ns(W,cn,0,8); write_node(W,cn,1,0,0,0);
  return;
}
fn main()i32 {
  emit("PROBE-PG-NOVELTY\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,1,11,3);
  ev_teach(W,2,12,10); ev_teach(W,3,12,20);
  let g1:i32=ev_query(W,1,40,30,0);
  emit("G1 diamond-sum exp=30 ans="); e64(g1); emit("\n");
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,110,31,7); ev_teach(W2,110,32,3);
  mkcomb2(W2);
  let g2:i32=ev_query(W2,110,41,4,0);
  emit("G2 subtraction exp=4 ans="); e64(g2); emit("\n");
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  ev_teach(W3,1,11,10); ev_teach(W3,10,11,20); ev_teach(W3,20,11,30);
  let g3:i32=ev_query(W3,1,42,3,0);
  emit("G3 count exp=3 ans="); e64(g3); emit("\n");
  let W4:[]u8=z_alloc(110656); tnn2_init(W4);
  ev_teach(W4,1,11,10); ev_teach(W4,10,11,20); ev_teach(W4,20,11,30);
  let g4:i32=ev_query(W4,1,42,20,0);
  emit("G4 count-shadowed exp=20 ans="); e64(g4); emit("\n");
  return 0;
}

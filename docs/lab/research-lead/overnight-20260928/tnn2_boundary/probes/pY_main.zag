fn dump7(W:[]u8,tag:[]u8)void {
  emit(tag); emit(" n7: t="); e64(ng(W,7,0)); emit(" f4="); e64(ng(W,7,4));
  emit(" f8="); e64(ng(W,7,8)); emit(" f12="); e64(ng(W,7,12));
  emit(" f20="); e64(ng(W,7,20)); emit(" f28="); e64(ng(W,7,28));
  emit(" bid="); e64(ng(W,7,36)); emit("\n");
  emit(tag); emit(" n11: t="); e64(ng(W,11,0)); emit(" f8="); e64(ng(W,11,8));
  emit(" bid="); e64(ng(W,11,36)); emit("\n");
  return;
}
fn main()i32 {
  emit("PROBE-PY-DIAG2\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let qq:i32=ev_query(W,101,40,201,0);
  emit("promote="); e64(qq); emit("\n");
  dump7(W,"pre ");
  let o:i32=ev_observe(W,101,11,777);
  emit("observe="); e64(o); emit("\n");
  dump7(W,"post");
  let root:i32=ng(W,find_map(W,40),20);
  emit("exec-after="); e64(t2_exec(W,root,101)); emit("\n");
  return 0;
}
fn find_map(W:[]u8,r:i32)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){m=n;} n=n+1; }
  return m;
}

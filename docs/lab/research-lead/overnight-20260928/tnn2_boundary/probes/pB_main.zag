fn mkcomb(W:[]u8)void {
  let cn:i32=alloc_node(W); ns(W,cn,0,8); write_node(W,cn,1,0,0,0);
  return;
}
fn sumq(v0:i32,v1:i32,exp:i32,withcomb:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,110,31,v0); ev_teach(W,110,32,v1);
  if(withcomb==1){mkcomb(W);}
  let a:i32=ev_query(W,110,41,exp,0);
  emit("sum "); e64(v0); emit("+"); e64(v1); emit(" comb="); e64(withcomb);
  emit(" ans="); e64(a); emit("\n");
  return;
}
fn main()i32 {
  emit("PROBE-PB-SUM\n");
  sumq(10,20,30,1);
  sumq(10,20,30,0);
  sumq(400,400,800,1);
  sumq(500,450,950,1);
  return 0;
}

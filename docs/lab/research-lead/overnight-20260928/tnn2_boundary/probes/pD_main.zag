fn count_uncert(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==s && ng(W,n,24)==r){c=c+1;}
    n=n+1;
  }
  return c;
}
fn count_guides(W:[]u8,s:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==s && ng(W,n,20)==30){c=c+1;}
    n=n+1;
  }
  return c;
}
fn main()i32 {
  emit("PROBE-PD-INQUIRY\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  let q1:i32=ev_query(W,9002,77,-2,0);
  let q2:i32=ev_query(W,9002,77,-2,0);
  emit("miss1="); e64(q1); emit(" miss2="); e64(q2);
  emit(" uncert="); e64(count_uncert(W,9002,77));
  emit(" guides="); e64(count_guides(W,9002)); emit("\n");
  let q3:i32=ev_query(W,9003,77,-2,0);
  emit("miss3(subj9003)="); e64(q3);
  emit(" guides9003="); e64(count_guides(W,9003)); emit("\n");
  ctx_push(W,9003);
  let a1:i32=ev_act(W);
  emit("act ctx=9003 -> "); e64(a1); emit("\n");
  ev_teach(W,9002,77,42);
  let q4:i32=ev_query(W,9002,77,-2,0);
  ctx_push(W,9002);
  let a2:i32=ev_act(W);
  emit("after teach: query="); e64(q4); emit(" act ctx=9002 -> "); e64(a2);
  emit(" guides9002="); e64(count_guides(W,9002));
  emit(" uncert9002="); e64(count_uncert(W,9002,77)); emit("\n");
  return 0;
}

fn main()i32 {
  emit("PROBE-PZ-TRACE3\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let qq:i32=ev_query(W,101,40,201,0);
  let factn:i32=activate(W,101,11);
  emit("factn="); e64(factn); emit("\n");
  emit("prov1 edges ->factn: ");
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==factn){
      emit("[src="); e64(eg(W,e,0)); emit(" t="); e64(ng(W,eg(W,e,0),0)); emit("]");
    }
    e=e+1;
  }
  emit("\n");
  emit("maps type20: ");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ emit("m="); e64(m); emit(" "); }
    m=m+1;
  }
  emit("\n");
  return 0;
}

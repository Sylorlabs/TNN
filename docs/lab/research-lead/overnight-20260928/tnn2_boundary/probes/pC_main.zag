fn diamond(exp:i32,flags:i32)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,1,11,3);
  ev_teach(W,2,12,10); ev_teach(W,3,12,20);
  return ev_query(W,1,40,exp,flags);
}
fn main()i32 {
  emit("PROBE-PC-MASKED\n");
  let a:i32=diamond(99,1);
  emit("masked diamond exp=99 ans="); e64(a); emit("\n");
  let b:i32=diamond(99,0);
  emit("unmasked diamond exp=99 ans="); e64(b); emit("\n");
  let c:i32=diamond(20,0);
  emit("branch-pick exp=20 ans="); e64(c); emit("\n");
  return 0;
}

// bp4_driver.zag -- BP-4 battery driver.
//
// FP1: graded flip point (WF1: leader mv3 weakened one fact at a time).
// FP4: learned d_self (WT treatment / WC control / WT post-choice leg).
// FP5: independence discount (WI: 6 same-set vs 6 disjoint confirms).
// Kill bars from the frozen PREREG.md. Verdict BP-4-PASS/FAIL.
// Pure Zag. bp4_learner.zag reused verbatim; bp4_rules.zag holds the
// single new learner rule (R3-prime, d_self learning); frozen block
// ops reused verbatim, never redefined.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp4_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp4_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp4_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// First live count-MAP id != excl, or -1.
fn bp4_other_countmap(W:[]u8,excl:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(m!=excl && ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Highest live count-MAP id, or -1.
fn bp4_max_countmap(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){best=m;}
    }
    m=m+1;
  }
  return best;
}

// The single MAP_Z id, or -1 unless exactly one exists.
fn bp4_only_mapz(W:[]u8)i32 {
  let found:i32=-1; let n:i32=0; let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){n=n+1; found=z;}
    z=z+1;
  }
  if(n==1){return found;}
  return -1;
}

// First live tag-1 type-1 provenance target's relation, or -1.
fn bp4_prov_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// The frozen world replay (BP-3 bp3_build at pm=0, no mz3).
// Structural parameters only; no permutation in this lane.
// out: 0=my 4=mv2 8=mv3 12=navx 20=mz2.
fn bp4_build(W:[]u8,out:[]u8)void {
  ev_teach(W,11,81,12);
  ev_teach(W,12,81,13);
  ev_teach(W,13,81,14);
  ev_query_xs5(W,11,91,14,0);
  ev_teach(W,50,82,51);
  ev_teach(W,51,82,52);
  ev_teach(W,52,82,53);
  ev_query_xs5(W,50,92,3,0);
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  let my:i32=xs5_find_countmap(W);
  set32(out,0,my);
  ev_teach(W,110,85,111);
  ev_teach(W,111,85,112);
  ev_teach(W,112,85,113);
  ev_teach(W,113,85,114);
  ev_query_xs5(W,110,117,4,0);
  let mv2:i32=bp4_other_countmap(W,my);
  set32(out,4,mv2);
  ev_teach(W,120,87,121);
  ev_teach(W,121,87,122);
  ev_teach(W,122,87,123);
  ev_teach(W,123,87,124);
  ev_query_xs5(W,120,118,4,0);
  let mv3:i32=bp4_max_countmap(W);
  set32(out,8,mv3);
  ev_teach(W,14,82,40);
  ev_teach(W,40,82,41);
  xs5_compose(W,11,94,2);
  let mz1:i32=bp4_only_mapz(W);
  set32(out,16,mz1);
  let navx:i32=xhier_mapz_nav(W,mz1);
  set32(out,12,navx);
  ev_teach(W,14,87,60);
  ev_teach(W,60,87,61);
  ev_teach(W,61,87,62);
  ev_teach(W,62,87,63);
  ev_teach(W,14,85,30);
  ev_teach(W,30,85,31);
  ev_teach(W,31,85,32);
  let pf:[]u8=z_alloc(8);
  let mz2:i32=promote_graph(W,-1,11,93,4,pf,0);
  link_edge(W,mz2,14,navx,0);
  link_edge(W,mz2,14,mv3,0);
  set32(out,20,mz2);
  ns(W,my,0,0); ns(W,my,36,0);
  return;
}

// Disclosed researcher scripting of the P6 source partition:
// write tag into field16 of each live tag-1 type-1 provenance
// target of mid. 2=TAUGHT (EXTERNAL), 6=DERIVED-FROM-STRUCTURE
// (SELF). The block never reads node field16 of tag-1 facts,
// so this is side-effect-free on the world.
fn bp4_set_prov_tag(W:[]u8,mid:i32,tag:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        ns(W,f,16,tag);
      }
    }
    e=e+1;
  }
  return;
}

fn main()i32 {
  emit("BP4-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  let bar0:i32=50;

  // ================= FP1: graded flip point =================
  emit("FP1-BEGIN\n");
  let WF1:[]u8=z_alloc(110656);
  tnn2_init(WF1);
  let ids1:[]u8=z_alloc(28);
  bp4_build(WF1,ids1);
  let mv2_1:i32=get32(ids1,4);
  let mv3_1:i32=get32(ids1,8);
  let navx_1:i32=get32(ids1,12);
  let lo1:[]u8=z_alloc(12);
  bp2_lic_live(WF1,mv3_1,lo1);
  bp4_bar(t,"PC-F1-BUILD",xs5_find_countmap(WF1)==mv2_1 && bp4_prov_rel(WF1,mv3_1)==87 && get32(lo1,0)==4);
  bp4_bar(t,"PC-F1-IDX",navx_1==27 && mv2_1==194 && mv3_1==274);
  let bt1:[]u8=z_alloc(8192); let hasb1:[]u8=z_alloc(1024);
  bp2_form(WF1,bt1,hasb1,mv3_1,0);
  bp2_form(WF1,bt1,hasb1,mv2_1,0);
  bp2_confirm(bt1,mv3_1,1);
  bp2_confirm(bt1,mv3_1,1);
  bp4_bar(t,"PC-F1-SUP0",(bt1[mv3_1*8] as i32)==140 && (bt1[mv2_1*8] as i32)==100);
  let cands1:[]u8=z_alloc(8);
  set32(cands1,0,mv3_1); set32(cands1,4,mv2_1);
  let sups:[]u8=z_alloc(20);
  let r7s:[]u8=z_alloc(20);
  let lgs:[]u8=z_alloc(20);
  let s:i32=0;
  while(s<=4){
    if(s>0){
      bp2_kill_one_prov(WF1,mv3_1);
      bp2_relicense(WF1,bt1,mv3_1);
    }
    let lo:[]u8=z_alloc(12);
    bp2_lic_live(WF1,mv3_1,lo);
    let live:i32=get32(lo,0);
    let sup:i32=bt1[mv3_1*8] as i32;
    let r7:i32=bp2_select(bt1,hasb1,cands1,2,bar0);
    let lg:i32=bp2_lgsel(WF1,cands1,2);
    set32(sups,s*4,sup);
    set32(r7s,s*4,r7);
    set32(lgs,s*4,lg);
    emit("FP1-S"); e64(s); emit(" live "); e64(live);
    emit(" sup "); e64(sup); emit(" r7 "); e64(r7);
    emit(" lg "); e64(lg); emit("\n");
    s=s+1;
  }
  let seqok:i32=1;
  if(get32(sups,0)!=140){seqok=0;}
  if(get32(sups,4)!=105){seqok=0;}
  if(get32(sups,8)!=52){seqok=0;}
  if(get32(sups,12)!=13){seqok=0;}
  if(get32(sups,16)!=0){seqok=0;}
  bp4_bar(t,"K-FP1-SEQ",seqok==1);
  let flipok:i32=1;
  if(get32(r7s,0)!=mv3_1){flipok=0;}
  if(get32(r7s,4)!=mv3_1){flipok=0;}
  if(get32(r7s,8)!=mv2_1){flipok=0;}
  if(get32(r7s,12)!=mv2_1){flipok=0;}
  if(get32(r7s,16)!=mv2_1){flipok=0;}
  bp4_bar(t,"K-FP1-FLIP",flipok==1);
  bp4_bar(t,"K-FP1-RETIRE",bp2_has_k3r(WF1,mv3_1,2)==1 && get32(sups,16)==0);
  bp4_bar(t,"K-FP1-KILLCRIT",get32(r7s,16)==mv2_1 && get32(lgs,16)==mv3_1);
  let shapeok:i32=1;
  if(get32(sups,0)<=get32(sups,4)){shapeok=0;}
  if(get32(sups,4)<=get32(sups,8)){shapeok=0;}
  if(get32(sups,8)<=get32(sups,12)){shapeok=0;}
  if(get32(sups,12)<=get32(sups,16)){shapeok=0;}
  let ntrans:i32=0;
  let q:i32=1;
  while(q<=4){
    if(get32(r7s,q*4)!=get32(r7s,(q-1)*4)){ntrans=ntrans+1;}
    q=q+1;
  }
  if(ntrans!=1){shapeok=0;}
  if(get32(r7s,4)!=mv3_1 || get32(r7s,8)!=mv2_1){shapeok=0;}
  if(get32(sups,8)<50){shapeok=0;}
  bp4_bar(t,"K-FP1-SHAPE",shapeok==1);
  emit("FP1-END\n");

  // ================= FP4: learned source discount =================
  emit("FP4-BEGIN\n");
  // --- WT: treatment (self-amplification failure experience) ---
  let WT:[]u8=z_alloc(110656);
  tnn2_init(WT);
  let idst:[]u8=z_alloc(28);
  bp4_build(WT,idst);
  let mv2t:i32=get32(idst,4);
  let mv3t:i32=get32(idst,8);
  bp4_set_prov_tag(WT,mv2t,2);
  bp4_set_prov_tag(WT,mv3t,6);
  let lot2:[]u8=z_alloc(12);
  bp2_lic_live(WT,mv2t,lot2);
  let lot3:[]u8=z_alloc(12);
  bp2_lic_live(WT,mv3t,lot3);
  bp4_bar(t,"PC-F4-T-BUILD",xs5_find_countmap(WT)==mv2t && bp4_prov_rel(WT,mv3t)==87 && get32(lot3,0)==4);
  bp4_bar(t,"PC-F4-T-TAG",get32(lot2,8)==0 && get32(lot2,4)==get32(lot2,0) && get32(lot2,0)>=1 && get32(lot3,0)==4 && get32(lot3,4)==0 && get32(lot3,8)==4);
  let btt:[]u8=z_alloc(8192); let hasbt:[]u8=z_alloc(1024);
  bp2_form(WT,btt,hasbt,mv2t,0);
  bp2_form(WT,btt,hasbt,mv3t,0);
  bp4_disconf_learn(btt,mv3t);
  bp4_disconf_learn(btt,mv3t);
  let dself_t:i32=btt[mv3t*8+6] as i32;
  bp2_confirm(btt,mv3t,1);
  bp2_confirm(btt,mv3t,1);
  let candst:[]u8=z_alloc(8);
  set32(candst,0,mv2t); set32(candst,4,mv3t);
  let sup2t:i32=btt[mv2t*8] as i32;
  let sup3t:i32=btt[mv3t*8] as i32;
  let eff2t:i32=bp2_eff(btt,mv2t);
  let eff3t:i32=bp2_eff(btt,mv3t);
  let r7t:i32=bp2_select(btt,hasbt,candst,2,bar0);
  emit("FP4-T dself "); e64(dself_t);
  emit(" sup "); e64(sup2t); emit("/"); e64(sup3t);
  emit(" eff "); e64(eff2t); emit("/"); e64(eff3t);
  emit(" r7 "); e64(r7t); emit("\n");
  bp4_bar(t,"K-FP4-T-D",dself_t==205);
  bp4_bar(t,"K-FP4-T-SUP",sup2t==100 && sup3t==100);
  bp4_bar(t,"K-FP4-T-EFF",eff2t==100 && eff3t==80);
  bp4_bar(t,"K-FP4-T-SEL",r7t==mv2t);
  // --- WC: control (no experience) ---
  let WC:[]u8=z_alloc(110656);
  tnn2_init(WC);
  let idsc:[]u8=z_alloc(28);
  bp4_build(WC,idsc);
  let mv2c:i32=get32(idsc,4);
  let mv3c:i32=get32(idsc,8);
  bp4_set_prov_tag(WC,mv2c,2);
  bp4_set_prov_tag(WC,mv3c,6);
  let loc2:[]u8=z_alloc(12);
  bp2_lic_live(WC,mv2c,loc2);
  let loc3:[]u8=z_alloc(12);
  bp2_lic_live(WC,mv3c,loc3);
  bp4_bar(t,"PC-F4-C-BUILD",xs5_find_countmap(WC)==mv2c && bp4_prov_rel(WC,mv3c)==87 && get32(loc3,0)==4);
  bp4_bar(t,"PC-F4-C-TAG",get32(loc2,8)==0 && get32(loc2,4)==get32(loc2,0) && get32(loc2,0)>=1 && get32(loc3,0)==4 && get32(loc3,4)==0 && get32(loc3,8)==4);
  let btc:[]u8=z_alloc(8192); let hasbc:[]u8=z_alloc(1024);
  bp2_form(WC,btc,hasbc,mv2c,0);
  bp2_form(WC,btc,hasbc,mv3c,0);
  let candsc:[]u8=z_alloc(8);
  set32(candsc,0,mv2c); set32(candsc,4,mv3c);
  let dself_c:i32=btc[mv3c*8+6] as i32;
  let r7c:i32=bp2_select(btc,hasbc,candsc,2,bar0);
  emit("FP4-C dself "); e64(dself_c); emit(" r7 "); e64(r7c); emit("\n");
  bp4_bar(t,"K-FP4-C-D",dself_c==255);
  bp4_bar(t,"K-FP4-C-SEL",r7c==-3);
  // --- post-choice control leg on WT: external-majority disconfirmation ---
  bp4_disconf_learn(btt,mv2t);
  bp4_disconf_learn(btt,mv2t);
  let dself_2t:i32=btt[mv2t*8+6] as i32;
  let sup2t2:i32=btt[mv2t*8] as i32;
  emit("FP4-X dself "); e64(dself_2t); emit(" sup "); e64(sup2t2); emit("\n");
  bp4_bar(t,"K-FP4-EXT-INERT",dself_2t==255 && sup2t2==60);
  emit("FP4-END\n");

  // ================= FP5: independence discount =================
  emit("FP5-BEGIN\n");
  let WI:[]u8=z_alloc(110656);
  tnn2_init(WI);
  let idsi:[]u8=z_alloc(28);
  bp4_build(WI,idsi);
  let mv2i:i32=get32(idsi,4);
  let mv3i:i32=get32(idsi,8);
  let loi:[]u8=z_alloc(12);
  bp2_lic_live(WI,mv3i,loi);
  bp4_bar(t,"PC-F5-BUILD",xs5_find_countmap(WI)==mv2i && bp4_prov_rel(WI,mv3i)==87 && get32(loi,0)==4);
  let bti:[]u8=z_alloc(8192); let hasbi:[]u8=z_alloc(1024);
  bp2_form(WI,bti,hasbi,mv2i,0);
  bp2_form(WI,bti,hasbi,mv3i,0);
  let k:i32=0;
  while(k<6){bp2_confirm(bti,mv2i,0); k=k+1;}
  k=0;
  while(k<6){bp2_confirm(bti,mv3i,1); k=k+1;}
  let sup2i:i32=bti[mv2i*8] as i32;
  let sup3i:i32=bti[mv3i*8] as i32;
  let conf2i:i32=bti[mv2i*8+1] as i32;
  let conf3i:i32=bti[mv3i*8+1] as i32;
  let candsi:[]u8=z_alloc(8);
  set32(candsi,0,mv2i); set32(candsi,4,mv3i);
  let r7i:i32=bp2_select(bti,hasbi,candsi,2,bar0);
  emit("FP5-SUP "); e64(sup2i); emit("/"); e64(sup3i);
  emit(" CONF "); e64(conf2i); emit("/"); e64(conf3i);
  emit(" R7 "); e64(r7i); emit("\n");
  bp4_bar(t,"K-FP5-SUP",sup2i==160 && sup3i==220);
  bp4_bar(t,"K-FP5-DIFF",(sup3i-sup2i)==60);
  bp4_bar(t,"K-FP5-SEL",r7i==mv3i);
  bp4_bar(t,"K-FP5-CONF",conf2i==7 && conf3i==7);
  emit("FP5-END\n");

  emit("BP4-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP4-END\n");
  return 0;
}

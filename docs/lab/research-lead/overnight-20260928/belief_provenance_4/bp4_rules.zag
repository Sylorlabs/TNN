// bp4_rules.zag -- BP-4 new learner machinery (exactly one rule).
//
// R3-prime: the FP4 d_self learning rule (DESIGN.md 3.1, 6; frozen
// form disclosed in PREREG.md Section 1). d_self starts at 255
// (no discount) and moves downward ONLY through experienced
// disconfirmation of self-majority-sourced beliefs:
//
//   bp4_disconf_learn(bt, mid):
//     1. apply R3 (bp2_disconfirm): b_sup = max(0, b_sup-DEC);
//        b_disc++; b_conf = 0.
//     2. if b_self[mid] > b_ext[mid]: d_self[mid] =
//        max(0, d_self[mid] - 25).
//     3. R2 confirmations never change d_self.
//
// Everything else in the belief layer is bp4_learner.zag, the
// verbatim BP-3 copy. 0 new edge types, 0 new node types,
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.

// A disconfirmation experience: R3 plus the d_self learning step.
fn bp4_disconf_learn(bt:[]u8,mid:i32)void {
  bp2_disconfirm(bt,mid);
  let o:i32=mid*8;
  let ne:i32=bt[o+4] as i32;
  let nself:i32=bt[o+5] as i32;
  if(nself>ne){
    let d:i32=bt[o+6] as i32;
    d=d-25;
    if(d<0){d=0;}
    bt[o+6]=d as u8;
  }
  return;
}

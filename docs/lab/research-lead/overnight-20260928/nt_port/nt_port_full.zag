// nt_port_full.zag -- NT-PORT: D1+D2 ported to the shared continuing-learner substrate.
// Pure Zag. No Python.
//
// Subject: the continuing-learner skeleton (associative instance memory,
// sequential lifetime phases, single main(), no resets, no task labels;
// after continuing_learner/contlearn2.zag) with ONLY the D1+D2 memory
// rules installed:
//   D1: eviction checkpoints (valid,obj,sup,ref) keyed by (subj,rel);
//       re-insertion restores checkpointed evidence then runs the update.
//   D2: installation sequence number ins stamped on every installation;
//       eviction victim = max ins (evict-youngest, LIFO).
// Evidence update (NT-frozen): hit+match -> sup++; hit+mismatch -> ref++,
// revise to (new obj,1,0) in place iff ref > sup; revision never touches ins.
// ABL arm: same substrate and update rule, but eviction = lowest (sup-ref)
// with slot-index tie-break and NO checkpoint table (fresh install always).
// Frozen workload, protocol, predictions, kill bars: PREREG.md.
// Output rule: dynamic content into ONE preallocated buffer, one raw-syscall
// write. _zag_print never used for dynamic content.
//
// Learner arena layout (bytes):
//   0: nentries   4: nevict   8: ins_seq
//   16: slots, 20 * 32 bytes: 0:subj 1:rel 2:obj 3:dom 4:valid 5:sup 6:ref 7:ins
//   656: D1 checkpoint table, 30 * 16 bytes: 0:valid 1:obj 2:sup 3:ref
//   1136: evhist, 30 * 4 bytes (per-subject eviction counts, subjects 100..129)
//   nt_new allocates 2048 (1256 used)

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner ----
fn cl_new()[]u8 { return z_alloc(2048); }
fn sf(L:[]u8,s:i32,f:i32)i32 { return get32(L,16+s*32+f*4); }
fn sw(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,16+s*32+f*4,v); return; }
fn ck_get(L:[]u8,subj:i32,f:i32)i32 { return get32(L,656+(subj-100)*16+f*4); }
fn ck_set(L:[]u8,subj:i32,f:i32,v:i32)void { set32(L,656+(subj-100)*16+f*4,v); return; }
fn evh_add(L:[]u8,subj:i32)void {
  set32(L,1136+(subj-100)*4,get32(L,1136+(subj-100)*4)+1);
  return;
}
fn evh_get(L:[]u8,subj:i32)i32 { return get32(L,1136+(subj-100)*4); }
fn cl_find(L:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=0;
  while(s<20){
    let m:i32=0;
    if(sf(L,s,4)==1){ if(sf(L,s,0)==subj && sf(L,s,1)==rel){ m=1; } }
    if(m==1){ return s; }
    s=s+1;
  }
  return -1;
}
fn cl_first_empty(L:[]u8)i32 {
  let s:i32=0;
  while(s<20){
    if(sf(L,s,4)==0){ return s; }
    s=s+1;
  }
  return -1;
}
// D2 eviction rule: evict the most recently INSTALLED entry (max ins).
// Entry-local installation order only; no task identity, no protection,
// no modes. ins unique per installation, no tie-break.
fn cl_evict_youngest(L:[]u8)i32 {
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<20){
    if(sf(L,s,4)==1){
      let a:i32=sf(L,s,7);
      if(best<0){ best=s; bv=a; }
      else { if(a>bv){ best=s; bv=a; } }
    }
    s=s+1;
  }
  return best;
}
// ABL eviction rule: lowest (sup-ref), slot-index tie-break (the NT2 comparator).
fn cl_evict_lowest(L:[]u8)i32 {
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<20){
    if(sf(L,s,4)==1){
      let a:i32=sf(L,s,5)-sf(L,s,6);
      if(best<0){ best=s; bv=a; }
      else { if(a<bv){ best=s; bv=a; } }
    }
    s=s+1;
  }
  return best;
}
// Frozen evidence update step (shared by the hit path and the D1 restore path).
fn cl_update(L:[]u8,s:i32,obj:i32)void {
  let v:i32=sf(L,s,2);
  if(v==obj){ sw(L,s,5,sf(L,s,5)+1); return; }
  let r:i32=sf(L,s,6)+1;
  sw(L,s,6,r);
  if(r>sf(L,s,5)){ sw(L,s,2,obj); sw(L,s,5,1); sw(L,s,6,0); }
  return;
}
// D1+D2 insertion (arm 0): stamp ins on every installation; restore the
// key's checkpointed evidence if valid, then run the update step; else
// install fresh (obj, sup=1, ref=0). ABL (arm 1): always fresh.
fn cl_insert(L:[]u8,s:i32,subj:i32,rel:i32,obj:i32,phase:i32,arm:i32)void {
  if(arm==0){
    let ni:i32=get32(L,8)+1;
    set32(L,8,ni);
    sw(L,s,7,ni);
    if(ck_get(L,subj,0)==1){
      sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,ck_get(L,subj,1));
      sw(L,s,3,phase); sw(L,s,4,1);
      sw(L,s,5,ck_get(L,subj,2)); sw(L,s,6,ck_get(L,subj,3));
      cl_update(L,s,obj);
      return;
    }
  }
  sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,obj); sw(L,s,3,phase);
  sw(L,s,4,1); sw(L,s,5,1); sw(L,s,6,0);
  return;
}
fn cl_learn(L:[]u8,subj:i32,rel:i32,obj:i32,phase:i32,arm:i32)void {
  let s:i32=cl_find(L,subj,rel);
  if(s>=0){ cl_update(L,s,obj); return; }
  if(get32(L,0)<20){
    s=cl_first_empty(L);
    set32(L,0,get32(L,0)+1);
  } else {
    let e:i32=0;
    if(arm==0){ e=cl_evict_youngest(L); } else { e=cl_evict_lowest(L); }
    set32(L,4,get32(L,4)+1);
    let vs:i32=sf(L,e,0);
    evh_add(L,vs);
    if(arm==0){
      // D1: checkpoint the victim's evidence before the slot is reused
      ck_set(L,vs,0,1);
      ck_set(L,vs,1,sf(L,e,2));
      ck_set(L,vs,2,sf(L,e,5));
      ck_set(L,vs,3,sf(L,e,6));
    }
    s=e;
  }
  cl_insert(L,s,subj,rel,obj,phase,arm);
  return;
}
fn cl_predict(L:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=cl_find(L,subj,rel);
  if(s<0){ return -1; }
  if(sf(L,s,5)>sf(L,s,6)){ return sf(L,s,2); }
  return -1;
}
// ---- oracles: frozen numeric inventory (PREREG Section 3) ----
fn o1(k:i32)i32 {
  let t:i32=k*37+11;
  return 200+(t-(t/64)*64);
}
fn o2(k:i32)i32 {
  let b:i32=o1(k)-200+32;
  return 200+(b-(b/64)*64);
}
// ---- protocol ----
fn teach_p1(L:[]u8,arm:i32)void {
  let k:i32=100;
  while(k<=115){ cl_learn(L,k,1,o1(k),1,arm); k=k+1; }
  return;
}
fn teach_p2(L:[]u8,arm:i32)void {
  let k:i32=100;
  while(k<=105){ cl_learn(L,k,1,o2(k),2,arm); k=k+1; }
  k=106;
  while(k<=109){ cl_learn(L,k,1,o1(k),2,arm); k=k+1; }
  k=120;
  while(k<=129){ cl_learn(L,k,1,o1(k),2,arm); k=k+1; }
  return;
}
fn probe_p1(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=115){ if(cl_predict(L,k,1)==o1(k)){ n=n+1; } k=k+1; }
  return n;
}
fn probe_c(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){ if(cl_predict(L,k,1)==o2(k)){ n=n+1; } k=k+1; }
  return n;
}
fn probe_k(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=106;
  while(k<=109){ if(cl_predict(L,k,1)==o1(k)){ n=n+1; } k=k+1; }
  return n;
}
fn probe_u(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=110;
  while(k<=115){ if(cl_predict(L,k,1)==o1(k)){ n=n+1; } k=k+1; }
  return n;
}
fn npres(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=120;
  while(k<=129){ if(cl_find(L,k,1)>=0){ n=n+1; } k=k+1; }
  return n;
}
fn forget_count(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){
    let p:i32=cl_predict(L,k,1);
    if(p!=o1(k)){ if(p!=o2(k)){ n=n+1; } }
    k=k+1;
  }
  k=106;
  while(k<=115){
    if(cl_predict(L,k,1)!=o1(k)){ n=n+1; }
    k=k+1;
  }
  return n;
}
// train phase 1 to criterion; returns passes (negative = fail-safe hit)
fn train_p1(L:[]u8,arm:i32)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teach_p1(L,arm);
    p=p+1;
    if(probe_p1(L)==16){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// run one arm; out: 0 ttc, 4 probe1, 8 nevict, 12 c, 16 k, 20 u, 24 npres, 28 forget
fn run_arm(arm:i32,out:[]u8,ob:[]u8,c:i32,tag:[]u8)i32 {
  let L:[]u8=cl_new();
  let ttc:i32=train_p1(L,arm);
  let p1:i32=probe_p1(L);
  let p:i32=0;
  while(p<3){ teach_p2(L,arm); p=p+1; }
  set32(out,0,ttc); set32(out,4,p1); set32(out,8,get32(L,4));
  set32(out,12,probe_c(L)); set32(out,16,probe_k(L)); set32(out,20,probe_u(L));
  set32(out,24,npres(L)); set32(out,28,forget_count(L));
  c=o_app(ob,c,"NTPORT "); c=o_app(ob,c,tag);
  c=o_app(ob,c," ttc="); c=o_i64(ob,c,ttc as i64);
  c=o_app(ob,c," probe1="); c=o_i64(ob,c,p1 as i64);
  c=o_app(ob,c," nevict="); c=o_i64(ob,c,get32(L,4) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPORT "); c=o_app(ob,c,tag);
  c=o_app(ob,c," RET c="); c=o_i64(ob,c,get32(out,12) as i64);
  c=o_app(ob,c," k="); c=o_i64(ob,c,get32(out,16) as i64);
  c=o_app(ob,c," u="); c=o_i64(ob,c,get32(out,20) as i64);
  c=o_app(ob,c," npres="); c=o_i64(ob,c,get32(out,24) as i64);
  c=o_app(ob,c," forget="); c=o_i64(ob,c,get32(out,28) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPORT "); c=o_app(ob,c,tag); c=o_app(ob,c," EVHIST");
  let k:i32=100;
  while(k<=129){
    let h:i32=evh_get(L,k);
    if(h>0){
      c=o_app(ob,c," "); c=o_i64(ob,c,k as i64);
      c=o_app(ob,c,"="); c=o_i64(ob,c,h as i64);
    }
    k=k+1;
  }
  c=o_nl(ob,c);
  return c;
}
fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let c:i32=0;
  let m:[]u8=z_alloc(64);
  let a:[]u8=z_alloc(64);
  c=run_arm(0,m,ob,c,"MAIN");
  c=run_arm(1,a,ob,c,"ABL");
  // ---- kill bars (PREREG Section 6) ----
  let k1a:i32=0;
  let t0:i32=get32(m,0);
  if(t0>=1){ if(t0<=50){ if(get32(m,4)==16){ k1a=1; } } }
  let k1b:i32=0;
  let t1:i32=get32(a,0);
  if(t1>=1){ if(t1<=50){ if(get32(a,4)==16){ k1b=1; } } }
  let k1:i32=0;
  if(k1a==1){ if(k1b==1){ k1=1; } }
  let k2:i32=0;
  if(get32(m,8)==20){ k2=1; }
  let k3:i32=0;
  if(get32(m,16)==4){ if(get32(m,20)==6){ k3=1; } }
  let k4:i32=0;
  if(get32(m,12)==6){ if(get32(m,28)==0){ k4=1; } }
  let k5a:i32=0;
  if(get32(a,12)==0){ if(get32(a,28)==6){ k5a=1; } }
  let k5b:i32=0;
  if(get32(a,20)==6){ if(get32(a,8)==20){ k5b=1; } }
  let k5:i32=0;
  if(k5a==1){ if(k5b==1){ k5=1; } }
  c=o_app(ob,c,"NTPORT K1="); c=o_i64(ob,c,k1 as i64);
  c=o_app(ob,c," K2="); c=o_i64(ob,c,k2 as i64);
  c=o_app(ob,c," K3="); c=o_i64(ob,c,k3 as i64);
  c=o_app(ob,c," K4="); c=o_i64(ob,c,k4 as i64);
  c=o_app(ob,c," K5="); c=o_i64(ob,c,k5 as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPORT VERDICT=");
  if(k1==0){ c=o_app(ob,c,"VOID"); }
  else {
    if(k5==0){ c=o_app(ob,c,"INCONCLUSIVE"); }
    else {
      if(k2==0){ c=o_app(ob,c,"FAIL-K2"); }
      else {
        let kr:i32=0;
        if(k3==0){ kr=1; }
        if(k4==0){ kr=1; }
        if(kr==1){ c=o_app(ob,c,"FAIL-RETENTION"); }
        else { c=o_app(ob,c,"PORT-PASS"); }
      }
    }
  }
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPORT-END");
  c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}

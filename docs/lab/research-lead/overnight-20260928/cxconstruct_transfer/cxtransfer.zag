// cxtransfer.zag -- H-CAUSALEXP-CONSTRUCT Transfer/Reuse (step 9).
// Pure Zag. No Python anywhere.
// Tests whether the disagreement-filter principle transfers:
// T1: 6 primitives (base-6 enumeration, must use OX)
// T2: threshold rules (not delay rules)
// T3: concept learning (static domain, not sequential)
// T4: composition (macro reuse)

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn e64(v:i32)void {
  let r:[]u8=_zag_i64_to_str(v as i64);
  if(r.len>0 && r[r.len-1]==10){emit(r[0..r.len-1]);} else {emit(r);}
  return;
}

// ============ T1: 6 primitives, X persistence vs decay ============
// Primitives: 0=S, 1=W, 2=OY, 3=OZ, 4=R, 5=OX.
// State: +0 X,+4 Z,+8 Y,+12 t,+16 tX,+20 tZ,+24 tY.
// H-T1a (h=0): X persists. H-T1b (h=1): X decays if t-tX >= 1 on W.
fn t1_step(h:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1); set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    if(h==1){
      if(get32(st,0)==1){
        let tx:i32=get32(st,16);
        if(t-tx>=1){ set32(st,0,0); set32(st,16,-1); }
      }
    }
    let pass:i32=0;
    while(pass<2){
      if(get32(st,0)==1){
        let ts:i32=get32(st,16);
        if(t-ts>=2){
          if(get32(st,4)==0){ set32(st,4,1); set32(st,20,t); }
        }
      }
      if(get32(st,4)==1){
        if(get32(st,8)==0){ set32(st,8,1); set32(st,24,t); }
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  } else if(a==4){
    set32(st,0,0); set32(st,16,-1);
  } else if(a==5){
    obs=get32(st,0);
  }
  return obs;
}
fn t1_sim(h:i32, seq:[]u8, len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=t1_step(h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn t1_has_obs(seq:[]u8, len:i32)i32 {
  let i:i32=0;
  while(i<len){
    let a:i32=seq[i] as i32;
    if(a==2||a==3||a==5){return 1;}
    i=i+1;
  }
  return 0;
}
fn t1_emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else if(a==3){emit("OZ");}
  else if(a==4){emit("R");}
  else{emit("OX");}
  return;
}
fn t1_emit_seq(seq:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    t1_emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
// Returns 1 if PASS, 0 if FAIL. Sets out_seq and out_len.
fn t1_run()i32 {
  emit("T1: 6 primitives, X persist vs decay\n");
  let nprim:i32=6;
  let found:i32=0;
  let fseq:[]u8=z_alloc(6);
  let flen:i32=0;
  let fp0:i32=-9;
  let fp1:i32=-9;
  let total_checked:i32=0;
  let d:i32=1;
  while(d<=5){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*nprim; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*nprim; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/nprim;}
        i=i+1;
      }
      if(t1_has_obs(seq,d)==1){
        checked=checked+1;
        let q0:i32=t1_sim(0,seq,d);
        let q1:i32=t1_sim(1,seq,d);
        if(q0!=q1){
          found=1; flen=d; fp0=q0; fp1=q1;
          let c:i32=0;
          while(c<d){fseq[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    emit("T1 DEPTH "); e64(d); emit(" checked="); e64(checked);
    emit(" found="); e64(found); emit("\n");
    total_checked=total_checked+checked;
    d=d+1;
  }
  if(found==0){
    emit("T1 NO-DISCRIMINATING-SEQUENCE\n");
    return 0;
  }
  emit("T1 SELECT seq="); t1_emit_seq(fseq,flen);
  emit(" h0pred="); e64(fp0); emit(" h1pred="); e64(fp1); emit("\n");
  let uses_ox:i32=0;
  let i:i32=0;
  while(i<flen){
    if((fseq[i] as i32)==5){uses_ox=1;}
    i=i+1;
  }
  emit("T1 uses_OX="); e64(uses_ox);
  emit(" total_checked="); e64(total_checked); emit("\n");
  if(uses_ox==1){emit("T1 PASS\n"); return 1;}
  emit("T1 FAIL (no OX)\n");
  return 0;
}

// ============ T2: threshold rules ============
// Primitives: 0=S (set X), 1=T (set Z), 2=W (evaluate), 3=OY.
// Rule: (src1,src2,dst,threshold). On W: if src1+src2 >= threshold then dst:=1.
// H-T2a (h=0): [(X,Z,Y,2)] (AND). H-T2b (h=1): [(X,Z,Y,1)] (OR).
// State: +0 X,+4 Z,+8 Y.
fn t2_step(h:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){ set32(st,0,1); }
  else if(a==1){ set32(st,4,1); }
  else if(a==2){
    let thresh:i32=2;
    if(h==1){thresh=1;}
    let s:i32=get32(st,0)+get32(st,4);
    if(s>=thresh){ set32(st,8,1); }
  }
  else if(a==3){ obs=get32(st,8); }
  return obs;
}
fn t2_sim(h:i32, seq:[]u8, len:i32)i32 {
  let st:[]u8=z_alloc(16);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=t2_step(h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn t2_emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("T");}
  else if(a==2){emit("W");}
  else{emit("OY");}
  return;
}
fn t2_run()i32 {
  emit("T2: threshold rules (AND vs OR)\n");
  let nprim:i32=4;
  let found:i32=0;
  let fseq:[]u8=z_alloc(6);
  let flen:i32=0;
  let fp0:i32=-9;
  let fp1:i32=-9;
  let d:i32=1;
  while(d<=5){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*nprim; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*nprim; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/nprim;}
        i=i+1;
      }
      let has:i32=0;
      let j:i32=0;
      while(j<d){ if((seq[j] as i32)==3){has=1;} j=j+1; }
      if(has==1){
        checked=checked+1;
        let q0:i32=t2_sim(0,seq,d);
        let q1:i32=t2_sim(1,seq,d);
        if(q0!=q1){
          found=1; flen=d; fp0=q0; fp1=q1;
          let c:i32=0;
          while(c<d){fseq[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    emit("T2 DEPTH "); e64(d); emit(" checked="); e64(checked);
    emit(" found="); e64(found); emit("\n");
    d=d+1;
  }
  if(found==0){
    emit("T2 NO-DISCRIMINATING-SEQUENCE\n");
    return 0;
  }
  emit("T2 SELECT seq=[");
  let i:i32=0;
  while(i<flen){
    if(i>0){emit(",");}
    t2_emit_action(fseq[i] as i32);
    i=i+1;
  }
  emit("] h0pred="); e64(fp0); emit(" h1pred="); e64(fp1); emit("\n");
  emit("T2 PASS\n");
  return 1;
}

// ============ T3: concept learning ============
// Objects: 0=(red,round), 1=(red,square), 2=(blue,round), 3=(blue,square).
// H-T3a (h=0): heavy iff color=red (obj 0,1).
// H-T3b (h=1): heavy iff shape=round (obj 0,2).
fn t3_predict(h:i32, obj:i32)i32 {
  if(h==0){
    if(obj==0||obj==1){return 1;}
    return 0;
  } else {
    if(obj==0||obj==2){return 1;}
    return 0;
  }
}
fn t3_emit_obj(obj:i32)void {
  if(obj==0){emit("(red,round)");}
  else if(obj==1){emit("(red,square)");}
  else if(obj==2){emit("(blue,round)");}
  else{emit("(blue,square)");}
  return;
}
fn t3_run()i32 {
  emit("T3: concept learning (red vs round)\n");
  let found:i32=0;
  let fobj:i32=-1;
  let fp0:i32=-9;
  let fp1:i32=-9;
  let obj:i32=0;
  while(obj<4){
    if(found==1){break;}
    let q0:i32=t3_predict(0,obj);
    let q1:i32=t3_predict(1,obj);
    emit("T3 obj="); t3_emit_obj(obj);
    emit(" h0="); e64(q0); emit(" h1="); e64(q1);
    if(q0!=q1){
      emit(" DISAGREE\n");
      found=1; fobj=obj; fp0=q0; fp1=q1;
    } else {
      emit(" agree\n");
    }
    obj=obj+1;
  }
  if(found==0){
    emit("T3 NO-DISCRIMINATING-OBJECT\n");
    return 0;
  }
  emit("T3 SELECT obj="); t3_emit_obj(fobj);
  emit(" h0pred="); e64(fp0); emit(" h1pred="); e64(fp1); emit("\n");
  if(fobj==1){
    emit("T3 PASS (selected (red,square), first disagreeing)\n");
    return 1;
  }
  emit("T3 FAIL (wrong object)\n");
  return 0;
}

// ============ T4a: from-scratch on World A2 ============
// H-A2a (h=0): [(X,Z,2)]. H-A2b (h=1): [(X,Z,5)].
// Primitives: 0=S,1=W,2=OY,3=OZ. Must find [S,W,W,OZ].
fn t4a_step(h:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){ set32(st,0,1); set32(st,16,get32(st,12)); }
  else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let delay:i32=2;
    if(h==1){delay=5;}
    if(get32(st,0)==1){
      let ts:i32=get32(st,16);
      if(t-ts>=delay){
        if(get32(st,4)==0){ set32(st,4,1); set32(st,20,t); }
      }
    }
  }
  else if(a==2){ obs=get32(st,8); }
  else if(a==3){ obs=get32(st,4); }
  return obs;
}
fn t4a_sim(h:i32, seq:[]u8, len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=t4a_step(h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
// Returns checked count via out param pattern; simplified: returns found*1000000+checked
fn t4a_run()i32 {
  emit("T4a: from-scratch on World A2\n");
  let nprim:i32=4;
  let found:i32=0;
  let flen:i32=0;
  let total_checked:i32=0;
  let d:i32=1;
  while(d<=5){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*nprim; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*nprim; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/nprim;}
        i=i+1;
      }
      let has:i32=0;
      let j:i32=0;
      while(j<d){ let a:i32=seq[j] as i32; if(a==2||a==3){has=1;} j=j+1; }
      if(has==1){
        checked=checked+1;
        let q0:i32=t4a_sim(0,seq,d);
        let q1:i32=t4a_sim(1,seq,d);
        if(q0!=q1){ found=1; flen=d; }
      }
      si=si+1;
    }
    emit("T4a DEPTH "); e64(d); emit(" checked="); e64(checked);
    emit(" found="); e64(found); emit("\n");
    total_checked=total_checked+checked;
    d=d+1;
  }
  emit("T4a total_checked="); e64(total_checked);
  emit(" flen="); e64(flen); emit("\n");
  if(found==1 && flen==4){
    emit("T4a PASS\n");
    return total_checked;
  }
  emit("T4a FAIL\n");
  return -1;
}

// ============ T4b: with macro M = [S,W] ============
// Primitives: 0=S,1=W,2=OY,3=OZ,4=M. M executes S then W as a unit.
// Should find [M,W,OZ] at depth 3.
fn t4b_step(h:i32, st:[]u8, a:i32)i32 {
  if(a==4){
    t4a_step(h,st,0);
    return t4a_step(h,st,1);
  }
  return t4a_step(h,st,a);
}
fn t4b_sim(h:i32, seq:[]u8, len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=t4b_step(h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn t4b_run()i32 {
  emit("T4b: with macro M=[S,W]\n");
  let nprim:i32=5;
  let found:i32=0;
  let flen:i32=0;
  let uses_m:i32=0;
  let total_checked:i32=0;
  let d:i32=1;
  while(d<=5){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*nprim; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*nprim; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/nprim;}
        i=i+1;
      }
      let has:i32=0;
      let hasm:i32=0;
      let j:i32=0;
      while(j<d){
        let a:i32=seq[j] as i32;
        if(a==2||a==3){has=1;}
        if(a==4){hasm=1;}
        j=j+1;
      }
      if(has==1){
        checked=checked+1;
        let q0:i32=t4b_sim(0,seq,d);
        let q1:i32=t4b_sim(1,seq,d);
        if(q0!=q1){ found=1; flen=d; uses_m=hasm; }
      }
      si=si+1;
    }
    emit("T4b DEPTH "); e64(d); emit(" checked="); e64(checked);
    emit(" found="); e64(found); emit("\n");
    total_checked=total_checked+checked;
    d=d+1;
  }
  emit("T4b total_checked="); e64(total_checked);
  emit(" flen="); e64(flen);
  emit(" uses_M="); e64(uses_m); emit("\n");
  if(found==1){
    emit("T4b PASS\n");
    return total_checked;
  }
  emit("T4b FAIL\n");
  return -1;
}

// ============ main ============
fn main()i32 {
  let t1:i32=t1_run();
  emit("\n");
  let t2:i32=t2_run();
  emit("\n");
  let t3:i32=t3_run();
  emit("\n");
  let t4a_checked:i32=t4a_run();
  emit("\n");
  let t4b_checked:i32=t4b_run();
  emit("\n");
  emit("SUMMARY t1="); e64(t1);
  emit(" t2="); e64(t2);
  emit(" t3="); e64(t3);
  emit(" t4a_checked="); e64(t4a_checked);
  emit(" t4b_checked="); e64(t4b_checked); emit("\n");
  let t4pass:i32=0;
  if(t4a_checked>0 && t4b_checked>0 && t4b_checked<t4a_checked){ t4pass=1; }
  emit("T4 composition_benefit="); e64(t4pass); emit("\n");
  let npass:i32=t1+t2+t3+t4pass;
  emit("TOTAL_PASS="); e64(npass); emit("/4\n");
  return 0;
}

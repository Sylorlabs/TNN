// prelude.zag -- shared basics for L3-SUF-1.
// Pure Zag. u8-backed cells (little-endian). Single output buffer +
// cursor emit helpers; final write via _zag_raw_syscall (never
// _zag_print for dynamic content, per the pinned-znc workaround).
// Alloc pattern: _zag_malloc as *u8 then [0..n] (the sound pattern;
// never `as *i32` + slice, never `[]u8 as *u8`).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output buffer emit helpers (single buffer, cursor) ----
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e3(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32, s3:[]u8, v3:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_app(ob,at,s3);
  at=ob_i32(ob,at,v3);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn write_ob(ob:[]u8, atp:[]u8)void {
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=get32(atp,0);
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return;
}
// ---- deterministic PRNG (LCG). r = 4-byte state buffer. ----
fn rng_next(r:[]u8)i32 {
  let s:i32=get32(r,0);
  s=(s*1103515245+12345) & 2147483647;
  set32(r,0,s);
  return s;
}
fn rng_range(r:[]u8, n:i32)i32 {
  if(n<1){return 0;}
  let v:i32=rng_next(r);
  if(v<0){v=0-v;}
  return v % n;
}
fn rng_seed(r:[]u8, s:i32)void {
  set32(r,0,s & 2147483647);
  return;
}
// scale_world.zag -- SCALING worlds for L3-SUF-1-SCALING (worker's own design).
// Implements the FROZEN world interface (CODEFREEZE.md):
//   learner-visible: w_observe, w_test, w_stakes
//   harness-only:    w_truth, w_truth_idx, w_stakes_meta, w_undet
// WB layout is exactly the frozen layout:
//   0: nent   4: nctx   8: ntrain   12: nstakes
//   16: off_ent_ids (nent i32 ids)
//   20: off_ctx_ids (nctx i32 ids)
//   24: off_truth   (nctx*nent*nent bytes, d in {0,1})
//   28: off_probe   (nent*nent bytes, 1=probeable)
//   32: off_undet   (nent*nent bytes, 1=undetermined; key/scoring only)
//   36: off_train   (ntrain*4 i32s: s0i, xi, yi, d)   [indices]
//   40: off_stakes  (nstakes*5 i32s: s0i, xi, yi, is_heldout, det)
// s_build(fam, sc, wb): fam 0=INV (G0-class invention), 1=ABS (G-B-class).
// Scales (sc): 0..5 -> (nent,|D|,|U|,|A|) =
//   (10,6,4,8) (20,20,8,16) (30,40,12,24) (40,60,16,32) (41,64,17,34) (50,80,20,40)
// Truth: g0 = ORD(perm0), g1 = PARITY((i+j)%2). Entity ids sequential
// (entb+i); U truth = anti-tiebreak (0, since ids ascend -> tb=1).
// The learner NEVER calls w_truth / w_undet / w_stakes_meta.

// ---- index helpers ----
fn w_ent_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,16);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_ctx_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,4);
  let off:i32=get32(wb,20);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_truth_idx(wb:[]u8, s0i:i32, xi:i32, yi:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,24);
  return wb[off+(s0i*n+xi)*n+yi] as i32;
}
// LEARNER-VISIBLE: TEST. Returns 1=ACCEPT, 0=REJECT.
// Unprobeable pairs withhold: REJECT every predicted value.
fn w_test(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32, v:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return 0;}
  if(xi<0){return 0;}
  if(yi<0){return 0;}
  let n:i32=get32(wb,0);
  let poff:i32=get32(wb,28);
  if(wb[poff+xi*n+yi]==0){return 0;}
  let t:i32=w_truth_idx(wb,s0i,xi,yi);
  if(t==v){return 1;}
  return 0;
}
// HARNESS ONLY: ground truth. The learner never calls this.
fn w_truth(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return -1;}
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  return w_truth_idx(wb,s0i,xi,yi);
}
// HARNESS ONLY: undetermined flag for a pair (key/scoring).
fn w_undet(wb:[]u8, x_id:i32, y_id:i32)i32 {
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,32);
  return wb[off+xi*n+yi] as i32;
}
// LEARNER-VISIBLE: OBSERVE. Fills out with (s0_id,x_id,y_id,d) quads.
fn w_observe(wb:[]u8, out:[]u8)i32 {
  let nt:i32=get32(wb,8);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let toff:i32=get32(wb,36);
  let i:i32=0;
  while(i<nt){
    let s0i:i32=get32(wb,toff+i*16);
    let xi:i32=get32(wb,toff+i*16+4);
    let yi:i32=get32(wb,toff+i*16+8);
    let d:i32=get32(wb,toff+i*16+12);
    set32(out,i*16,get32(wb,coff+s0i*4));
    set32(out,i*16+4,get32(wb,eoff+xi*4));
    set32(out,i*16+8,get32(wb,eoff+yi*4));
    set32(out,i*16+12,d);
    i=i+1;
  }
  return nt;
}
// LEARNER-VISIBLE: stakes sample. Fills out with (s0_id,x_id,y_id).
fn w_stakes(wb:[]u8, out:[]u8)i32 {
  let ns:i32=get32(wb,12);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let soff:i32=get32(wb,40);
  let i:i32=0;
  while(i<ns){
    let s0i:i32=get32(wb,soff+i*20);
    let xi:i32=get32(wb,soff+i*20+4);
    let yi:i32=get32(wb,soff+i*20+8);
    set32(out,i*12,get32(wb,coff+s0i*4));
    set32(out,i*12+4,get32(wb,eoff+xi*4));
    set32(out,i*12+8,get32(wb,eoff+yi*4));
    i=i+1;
  }
  return ns;
}
// HARNESS ONLY: (is_heldout, det_status) for stakes index i.
fn w_stakes_meta(wb:[]u8, i:i32, out:[]u8)void {
  let soff:i32=get32(wb,40);
  set32(out,0,get32(wb,soff+i*20+12));
  set32(out,4,get32(wb,soff+i*20+16));
  return;
}
// ---- builder scratch helpers (harness-side; the learner never sees these) ----
fn s_canon_a(i:i32, j:i32)i32 {
  if(i<j){return i;}
  return j;
}
fn s_canon_b(i:i32, j:i32)i32 {
  if(i<j){return j;}
  return i;
}
// Fisher-Yates shuffle of an i32 list in place
fn s_shuf_list(r:[]u8, list:[]u8, n:i32)void {
  let k:i32=n-1;
  while(k>0){
    let m:i32=rng_range(r,k+1);
    let t:i32=get32(list,k*4);
    set32(list,k*4,get32(list,m*4));
    set32(list,m*4,t);
    k=k-1;
  }
  return;
}
// truth value for pair (i,j) at context c: g0=ORD(perm), g1=PARITY
fn s_truth_val(c:i32, i:i32, j:i32, pos:[]u8)i32 {
  let a:i32=s_canon_a(i,j);
  let b:i32=s_canon_b(i,j);
  if(a==b){return 0;}
  if(c==0){
    if(get32(pos,a*4)<get32(pos,b*4)){return 1;}
    return 0;
  }
  if((a+b)%2==0){return 1;}
  return 0;
}
// top-level scaling world builder. fam: 0=INV, 1=ABS. sc: 0..5.
fn s_build(fam:i32, sc:i32, wb:[]u8)void {
  let nent:i32=10;
  let nd:i32=6;
  let nu:i32=4;
  let na:i32=8;
  if(sc==1){nent=20;nd=20;nu=8;na=16;}
  if(sc==2){nent=30;nd=40;nu=12;na=24;}
  if(sc==3){nent=40;nd=60;nu=16;na=32;}
  if(sc==4){nent=41;nd=64;nu=17;na=34;}
  if(sc==5){nent=50;nd=80;nu=20;na=40;}
  let entb:i32=600+sc*50;
  let r:[]u8=z_alloc(8);
  rng_seed(r,2000+sc*10+fam);
  // permutation for ORD truth
  let perm:[]u8=z_alloc(nent*4);
  let pos:[]u8=z_alloc(nent*4);
  let i:i32=0;
  while(i<nent){set32(perm,i*4,i);i=i+1;}
  s_shuf_list(r,perm,nent);
  i=0;
  while(i<nent){
    let x:i32=get32(perm,i*4);
    set32(pos,x*4,i);
    i=i+1;
  }
  // candidate pair lists: D (disagree), A (agree), both shuffled
  let dl:[]u8=z_alloc(8192);
  let al:[]u8=z_alloc(8192);
  let cnd:i32=0;
  let cna:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      let d0:i32=s_truth_val(0,i,j,pos);
      let d1:i32=s_truth_val(1,i,j,pos);
      if(d0==d1){set32(al,cna*4,i*100+j);cna=cna+1;}
      else {set32(dl,cnd*4,i*100+j);cnd=cnd+1;}
      j=j+1;
    }
    i=i+1;
  }
  s_shuf_list(r,dl,cnd);
  s_shuf_list(r,al,cna);
  // used-pair tracking (canonical, byte flags)
  let used:[]u8=z_alloc(nent*nent);
  i=0;
  while(i<nent*nent){used[i]=0;i=i+1;}
  // WB header + regions
  let nctx:i32=2;
  set32(wb,0,nent);
  set32(wb,4,nctx);
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+nctx*4;
  let poff:i32=toff+nctx*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  i=0;
  while(i<nent){set32(wb,eoff+i*4,entb+i);i=i+1;}
  set32(wb,coff,61);
  set32(wb,coff+4,62);
  // truth + probe/undet defaults
  let c:i32=0;
  while(c<nctx){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        wb[toff+(c*nent+i)*nent+j]=s_truth_val(c,i,j,pos) as u8;
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){wb[poff+i]=1;wb[uoff+i]=0;i=i+1;}
  // training region (index quads); emit helper inline via ti cursor
  let ti:i32=0;
  // D pairs: train at both contexts
  let k:i32=0;
  while(k<nd){
    let p:i32=get32(dl,k*4);
    let a:i32=p/100;
    let b:i32=p%100;
    set32(wb,troff+ti*16,0);
    set32(wb,troff+ti*16+4,a);
    set32(wb,troff+ti*16+8,b);
    set32(wb,troff+ti*16+12,s_truth_val(0,a,b,pos));
    ti=ti+1;
    set32(wb,troff+ti*16,1);
    set32(wb,troff+ti*16+4,a);
    set32(wb,troff+ti*16+8,b);
    set32(wb,troff+ti*16+12,s_truth_val(1,a,b,pos));
    ti=ti+1;
    used[a*nent+b]=1;
    used[b*nent+a]=1;
    k=k+1;
  }
  // A pairs: train at one random context
  k=0;
  while(k<na){
    let p2:i32=get32(al,(k%cna)*4);
    let a2:i32=p2/100;
    let b2:i32=p2%100;
    let cc:i32=rng_range(r,2);
    set32(wb,troff+ti*16,cc);
    set32(wb,troff+ti*16+4,a2);
    set32(wb,troff+ti*16+8,b2);
    set32(wb,troff+ti*16+12,s_truth_val(cc,a2,b2,pos));
    ti=ti+1;
    used[a2*nent+b2]=1;
    used[b2*nent+a2]=1;
    k=k+1;
  }
  set32(wb,8,ti);
  // U pairs: from unused, unprobeable + undetermined + anti-TB truth (0)
  let ku:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(ku<nu){
        if(used[i*nent+j]==0){
          wb[poff+i*nent+j]=0;wb[poff+j*nent+i]=0;
          wb[uoff+i*nent+j]=1;wb[uoff+j*nent+i]=1;
          wb[toff+(0*nent+i)*nent+j]=0;
          wb[toff+(0*nent+j)*nent+i]=0;
          wb[toff+(1*nent+i)*nent+j]=0;
          wb[toff+(1*nent+j)*nent+i]=0;
          used[i*nent+j]=1;
          used[j*nent+i]=1;
          ku=ku+1;
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // stakes region
  let soff:i32=troff+ti*16;
  set32(wb,40,soff);
  let si:i32=0;
  // U queries first (heldout, det=1): first 3 (INV) or 4 (ABS) U pairs
  // re-scan for U pairs in index order
  let uq:[]u8=z_alloc(nu*4);
  let nq:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nq<nu){
        if(wb[uoff+i*nent+j]==1){
          set32(uq,nq*4,i*100+j);
          nq=nq+1;
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  let nuq:i32=3;
  if(fam==1){nuq=4;}
  k=0;
  while(k<nuq){
    let p3:i32=get32(uq,k*4);
    set32(wb,soff+si*20,k%2);
    set32(wb,soff+si*20+4,p3/100);
    set32(wb,soff+si*20+8,p3%100);
    set32(wb,soff+si*20+12,1);
    set32(wb,soff+si*20+16,1);
    si=si+1;
    k=k+1;
  }
  if(fam==0){
    // INV: 3 D trained + 3 A trained (held=1, det=0)
    k=0;
    while(k<3){
      let p4:i32=get32(dl,k*4);
      set32(wb,soff+si*20,k%2);
      set32(wb,soff+si*20+4,p4/100);
      set32(wb,soff+si*20+8,p4%100);
      set32(wb,soff+si*20+12,1);
      set32(wb,soff+si*20+16,0);
      si=si+1;
      k=k+1;
    }
    k=0;
    while(k<3){
      let p5:i32=get32(al,(k%cna)*4);
      set32(wb,soff+si*20,(k+1)%2);
      set32(wb,soff+si*20+4,p5/100);
      set32(wb,soff+si*20+8,p5%100);
      set32(wb,soff+si*20+12,1);
      set32(wb,soff+si*20+16,0);
      si=si+1;
      k=k+1;
    }
    // extras: 1 U (held=0) + 2 untrained agreeing (held=0, det=0)
    let p6:i32=get32(uq,3*4);
    set32(wb,soff+si*20,1);
    set32(wb,soff+si*20+4,p6/100);
    set32(wb,soff+si*20+8,p6%100);
    set32(wb,soff+si*20+12,0);
    set32(wb,soff+si*20+16,1);
    si=si+1;
    let nx:i32=0;
    i=0;
    while(i<nent){
      let j2:i32=i+1;
      while(j2<nent){
        if(nx<2){
          if(used[i*nent+j2]==0){
            let d0x:i32=s_truth_val(0,i,j2,pos);
            let d1x:i32=s_truth_val(1,i,j2,pos);
            if(d0x==d1x){
              set32(wb,soff+si*20,nx%2);
              set32(wb,soff+si*20+4,i);
              set32(wb,soff+si*20+8,j2);
              set32(wb,soff+si*20+12,0);
              set32(wb,soff+si*20+16,0);
              si=si+1;
              nx=nx+1;
            }
          }
        }
        j2=j2+1;
      }
      i=i+1;
    }
  } else {
    // ABS: 4 D trained + 4 A trained (held=1, det=0)
    k=0;
    while(k<4){
      let p7:i32=get32(dl,k*4);
      set32(wb,soff+si*20,k%2);
      set32(wb,soff+si*20+4,p7/100);
      set32(wb,soff+si*20+8,p7%100);
      set32(wb,soff+si*20+12,1);
      set32(wb,soff+si*20+16,0);
      si=si+1;
      k=k+1;
    }
    k=0;
    while(k<4){
      let p8:i32=get32(al,(k%cna)*4);
      set32(wb,soff+si*20,(k+1)%2);
      set32(wb,soff+si*20+4,p8/100);
      set32(wb,soff+si*20+8,p8%100);
      set32(wb,soff+si*20+12,1);
      set32(wb,soff+si*20+16,0);
      si=si+1;
      k=k+1;
    }
  }
  set32(wb,12,si);
  return;
}
// learner.zag -- LEARNER side for L3-SUF-1 (treatment).
// Part 1: consequence log, surviving-set computation, flat forms,
// trace/proto emit, kb.
//
// SOURCE/AUDIT NOTE (A-LIT): this source contains NO resolution schema,
// NO marking rule ("mark unresolved when..."), NO abstention policy, and
// NO trigger counter/threshold. It contains: (a) a mechanical
// per-element consequence log (3c); (b) the sole-survivor principle at
// three scales (3d) computed as surviving value sets over that log;
// (c) the frozen escalation enumeration with generic replay (3e);
// (d) generic form-edit operators (ARITY-LIFT/GUARD/UNION/PROJECT);
// (e) a generic evaluator answering over the committed slot (3f).
// The three epistemic states are never named in source; they are the
// cardinalities (1/0/>1) of the surviving set. The per-element record
// STRUCTURE is created at runtime by ARITY-LIFT during escalation;
// its CONTENT is replayed from the consequence log (experience).

// ---- consequence log ----
// LOG layout: 0: nlog; 4: entries, 6 i32s each:
//   (elemkey, kind, value, outcome, fab, seq)
// elemkey = s0*1000000 + min(x,y)*1000 + max(x,y)  (ids < 1000)
// kind: 0=OBSERVE, 1=TEST, 2=STAKES
// outcome: 0=REJECT, 1=ACCEPT, 2=NEUTRAL(ABSTAIN)
// fab: 1 if the presented value came from the tie-break (no evidence)
fn l_ekey(s0:i32, x:i32, y:i32)i32 {
  let a:i32=x;
  let b:i32=y;
  if(a>b){let t:i32=a;a=b;b=t;}
  return s0*1000000+a*1000+b;
}
fn l_ekey_s0(ek:i32)i32 { return ek/1000000; }
fn l_log_touch(log:[]u8, ek:i32, kind:i32, value:i32, outcome:i32, fab:i32, seq:i32)i32 {
  let n:i32=get32(log,0);
  set32(log,4+n*24,ek);
  set32(log,4+n*24+4,kind);
  set32(log,4+n*24+8,value);
  set32(log,4+n*24+12,outcome);
  set32(log,4+n*24+16,fab);
  set32(log,4+n*24+20,seq);
  set32(log,0,n+1);
  return n+1;
}
// ---- surviving value set (sole-survivor at element scale) ----
// Returns bitmask: bit0 (1) = value 0 survives, bit1 (2) = value 1 survives.
// Derived ONLY from the consequence log. No thresholds, no counters,
// no world-property branches.
// Structural facts used:
//  (i)   worlds are deterministic, so both TEST-values REJECTed with
//        neither ACCEPTed and no observation means the world withholds
//        (unprobeable): no evidence either way -> both survive.
//  (ii)  a stakes REJECT on a fabricated (tie-break, fab=1) prediction
//        falsifies the act of predicting without evidence, not the
//        value: the element is explicitly not-known -> both survive.
//  (iii) otherwise a value is falsified by an observation of the other
//        value, a TEST REJECT of itself, or a TEST/STAKES ACCEPT of the
//        other value (evidence-backed).
fn l_surviving(log:[]u8, ek:i32)i32 {
  let o0:i32=0;
  let o1:i32=0;
  let r0r:i32=0;
  let r1r:i32=0;
  let r0a:i32=0;
  let r1a:i32=0;
  let fabrej:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let e:i32=get32(log,base);
    if(e==ek){
      let kd:i32=get32(log,base+4);
      let vv:i32=get32(log,base+8);
      let oc:i32=get32(log,base+12);
      let fb:i32=get32(log,base+16);
      if(kd==0){
        if(vv==0){o0=1;}
        if(vv==1){o1=1;}
      }
      if(kd==1){
        if(oc==0){
          if(vv==0){r0r=1;}
          if(vv==1){r1r=1;}
        }
        if(oc==1){
          if(vv==0){r0a=1;}
          if(vv==1){r1a=1;}
        }
      }
      if(kd==2){
        if(fb==1){
          if(oc==0){fabrej=1;}
        } else {
          if(oc==0){
            if(vv==0){r0r=1;}
            if(vv==1){r1r=1;}
          }
          if(oc==1){
            if(vv==0){r0a=1;}
            if(vv==1){r1a=1;}
          }
        }
      }
    }
    i=i+1;
  }
  let noobs:i32=0;
  if(o0==0){
    if(o1==0){noobs=1;}
  }
  if(noobs==1){
    if(r0r==1){
      if(r1r==1){
        if(r0a==0){
          if(r1a==0){return 3;}
        }
      }
    }
    if(fabrej==1){return 3;}
  }
  let f0:i32=0;
  if(o1==1){f0=1;}
  if(r0r==1){f0=1;}
  if(r1a==1){f0=1;}
  let f1:i32=0;
  if(o0==1){f1=1;}
  if(r1r==1){f1=1;}
  if(r0a==1){f1=1;}
  let s:i32=3;
  if(f0==1){s=s-1;}
  if(f1==1){s=s-2;}
  return s;
}
// provenance bitmask for an element (which evidence kinds touched it)
fn l_prov(log:[]u8, ek:i32)i32 {
  let p:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    if(get32(log,base)==ek){
      let kd:i32=get32(log,base+4);
      if(kd==0){p=p|1;}
      if(kd==1){p=p|2;}
      if(kd==2){p=p|4;}
    }
    i=i+1;
  }
  return p;
}
// ---- flat forms ----
// Form buffer:
//   0: kind (0=pairtable, 1=guarded, 2=graded)
//   4: n (entries)
//   8: rec_off (kind2: byte offset of record section; else 0)
//   12: entries (s0,x,y,d)*n, 16 bytes each (s0=-1 for kind0)
//   (kind2) rec_off: nrec i32, then (s0,x,y,mask,prov)*nrec, 20 bytes
// The DOCUMENTED ungraded bug (RK-B): default-fill by id order.
fn l_tiebreak(x:i32, y:i32)i32 {
  if(x<y){return 1;}
  return 0;
}
fn l_form_new(f:[]u8, kind:i32)void {
  set32(f,0,kind);
  set32(f,4,0);
  set32(f,8,0);
  return;
}
fn l_form_add(f:[]u8, s0:i32, x:i32, y:i32, d:i32)void {
  let n:i32=get32(f,4);
  let base:i32=12+n*16;
  set32(f,base,s0);
  set32(f,base+4,x);
  set32(f,base+8,y);
  set32(f,base+12,d);
  set32(f,4,n+1);
  return;
}
// find entry index or -1. kind0 ignores s0.
fn l_form_find(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let kind:i32=get32(f,0);
  let n:i32=get32(f,4);
  let i:i32=0;
  while(i<n){
    let base:i32=12+i*16;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    let sm:i32=0;
    if(kind==0){sm=1;}
    else { if(es==s0){sm=1;} }
    if(sm==1){
      if(ex==x){
        if(ey==y){return i;}
      }
      if(ex==y){
        if(ey==x){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// record lookup for kind2; returns mask or -1 if absent
fn l_rec_lookup(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -1;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let base:i32=roff+4+i*20;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){ if(ey==y){hit=1;} }
      if(ex==y){ if(ey==x){hit=1;} }
      if(hit==1){return get32(f,base+12);}
    }
    i=i+1;
  }
  return -1;
}
// predict: out[0]=value (-1 ABSTAIN), out[1]=fab(1 if tie-break used)
fn l_predict2(f:[]u8, s0:i32, x:i32, y:i32, out:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==2){
    let m:i32=l_rec_lookup(f,s0,x,y);
    if(m==1){set32(out,0,0);set32(out,4,0);return;}
    if(m==2){set32(out,0,1);set32(out,4,0);return;}
    set32(out,0,-1);set32(out,4,0);return;
  }
  let fi:i32=l_form_find(f,s0,x,y);
  if(fi>=0){
    let d:i32=get32(f,12+fi*16+12);
    set32(out,0,d);set32(out,4,0);return;
  }
  set32(out,0,l_tiebreak(x,y));set32(out,4,1);return;
}
// ---- trace / proto emit ----
// trace line: S<seq> P<parent> <name> <a1> <a2> <a3> <a4>
fn l_tr(AS:[]u8, TR:[]u8, parent:i32, name:[]u8, a1:i32, a2:i32, a3:i32, a4:i32)i32 {
  let at:i32=get32(AS,68);
  let seq:i32=get32(AS,0);
  at=ob_app(TR,at,"S");
  at=ob_i32(TR,at,seq);
  at=ob_app(TR,at," P");
  at=ob_i32(TR,at,parent);
  at=ob_app(TR,at," ");
  at=ob_app(TR,at,name);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a1);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a2);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a3);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a4);
  at=ob_nl(TR,at);
  set32(AS,68,at);
  set32(AS,0,seq+1);
  return seq;
}
fn l_pr(AS:[]u8, PR:[]u8, s:[]u8)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,s);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
fn l_pr_test(AS:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, r:i32)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> TEST s0=");
  at=ob_i32(PR,at,s0);
  at=ob_app(PR,at," x=");
  at=ob_i32(PR,at,x);
  at=ob_app(PR,at," y=");
  at=ob_i32(PR,at,y);
  at=ob_app(PR,at," v=");
  at=ob_i32(PR,at,v);
  if(r==1){at=ob_app(PR,at," => ACCEPT");}
  else {at=ob_app(PR,at," => REJECT");}
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
// ---- kb ----
// KB layout: 0:valid 4:template(sticky max) 8:form copy (fixed 16KB region)
fn l_kb_store(KB:[]u8, f:[]u8, tmpl:i32)void {
  set32(KB,0,1);
  let old:i32=get32(KB,4);
  if(old>tmpl){tmpl=old;}
  set32(KB,4,tmpl);
  let i:i32=0;
  while(i<16384){
    KB[8+i]=f[i];
    i=i+1;
  }
  return;
}
fn l_kb_wipe(KB:[]u8)void {
  set32(KB,0,0);
  set32(KB,4,0);
  return;
}
// learner.zag part 2 -- build, probe, escalation, arm pipeline.
fn l_form_copy(src:[]u8, dst:[]u8)void {
  let i:i32=0;
  while(i<16384){
    dst[i]=src[i];
    i=i+1;
  }
  return;
}
// direct construction (L_old competence): pairtable if consistent,
// else per-s0 guarded form.
fn l_build_direct(train:[]u8, ntrain:i32, f:[]u8)void {
  let contra:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let x0:i32=get32(train,i*16+4);
    let y0:i32=get32(train,i*16+8);
    let d0:i32=get32(train,i*16+12);
    let j:i32=i+1;
    while(j<ntrain){
      let x1:i32=get32(train,j*16+4);
      let y1:i32=get32(train,j*16+8);
      let d1:i32=get32(train,j*16+12);
      let same:i32=0;
      if(x0==x1){
        if(y0==y1){same=1;}
      }
      if(x0==y1){
        if(y0==x1){same=1;}
      }
      if(same==1){
        if(d0!=d1){contra=1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  if(contra==0){
    l_form_new(f,0);
  } else {
    l_form_new(f,1);
  }
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ks:i32=s0;
    if(contra==0){ks=-1;}
    if(l_form_find(f,ks,x,y)<0){
      l_form_add(f,ks,x,y,d);
    }
    i=i+1;
  }
  return;
}
// strict training consistency (observations must be predicted)
fn l_train_consistent(f:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_predict2(f,s0,x,y,out);
    let p:i32=get32(out,0);
    if(p!=d){return 0;}
    i=i+1;
  }
  return 1;
}
// generic replay consistency over the full history (3e).
// A predicted value that history REJECTed -> inconsistent.
// ABSTAIN is neutral (except on observations, which must be predicted).
fn l_replay_consistent(f:[]u8, log:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  if(l_train_consistent(f,train,ntrain)==0){return 0;}
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let ek:i32=get32(log,base);
    let kd:i32=get32(log,base+4);
    let vv:i32=get32(log,base+8);
    let oc:i32=get32(log,base+12);
    if(kd==1){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    if(kd==2){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    i=i+1;
  }
  return 1;
}
// one TEST through the protocol: world responds, log/prot/trace updated.
fn l_do_test(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, fab:i32, parent:i32, tag:[]u8)i32 {
  let r:i32=w_test(WB,s0,x,y,v);
  let ek:i32=l_ekey(s0,x,y);
  let seq:i32=l_tr(AS,TR,parent,tag,s0,x,y,v);
  l_log_touch(LOG,ek,1,v,r,fab,seq);
  l_pr_test(AS,PR,s0,x,y,v,r);
  let tt:i32=get32(AS,4);
  set32(AS,4,tt+1);
  return r;
}
// probe phase: (a) slot-varying probes (vary s0, hold pair fixed),
// (b) staged both-values probes on unresolved pairs (TEST 0; if REJECT,
// TEST 1). Domain-blind: slot indices and ids only. Returns TESTs used.
fn l_probe_phase(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, train:[]u8, ntrain:i32, budget:i32, parent:i32)i32 {
  let out:[]u8=z_alloc(8);
  let ents:[]u8=z_alloc(400);
  let ctxs:[]u8=z_alloc(400);
  // Use ALL world entities for probe coverage (not just training);
  // training-only ents can miss heldout entities, causing ABSTAINs
  // on determined heldout pairs.
  let nent_w:i32=get32(WB,0);
  let eoff_w:i32=get32(WB,16);
  let ne:i32=nent_w;
  let ei:i32=0;
  while(ei<nent_w){
    set32(ents,ei*4,get32(WB,eoff_w+ei*4));
    ei=ei+1;
  }
  let nc:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let j:i32=0;
    let found:i32=0;
    while(j<nc){
      if(get32(ctxs,j*4)==s0){found=1;}
      j=j+1;
    }
    if(found==0){set32(ctxs,nc*4,s0);nc=nc+1;}
    i=i+1;
  }
  let pseq:i32=l_tr(AS,TR,parent,"PROBE",ntrain,budget,0,0);
  let used:i32=0;
  // (a) slot-varying: for each training triple, other contexts
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let j:i32=0;
    while(j<nc){
      let c:i32=get32(ctxs,j*4);
      if(c!=s0){
        if(used<budget){
          l_predict2(f,c,x,y,out);
          let v:i32=get32(out,0);
          let fb:i32=get32(out,4);
          if(v!=-1){
            let rr:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,v,fb,pseq,"PVARY");
            used=used+1;
            let sv:i32=get32(AS,36);
            set32(AS,36,sv+1);
            // knowledge-REJECT: probe REJECTed a form knowledge prediction
            // (not a tiebreak fabrication). Signals a broken form.
            if(fb==0){
              if(rr==0){
                let nkr:i32=get32(AS,92);
                set32(AS,92,nkr+1);
                // active follow-up: try the flipped value, so the repair
                // build has positive evidence for this context.
                if(used<budget){
                  l_do_test(WB,AS,LOG,TR,PR,c,x,y,1-v,0,pseq,"PVARY2");
                  used=used+1;
                  let sv2:i32=get32(AS,36);
                  set32(AS,36,sv2+1);
                }
              }
            }
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // used-pair set from training (canonical id order)
  let usedp:[]u8=z_alloc(1600);
  i=0;
  while(i<1600){usedp[i]=0;i=i+1;}
  i=0;
  while(i<ntrain){
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let a:i32=x;
    let b:i32=y;
    if(a>b){let t:i32=a;a=b;b=t;}
    // map ids to small keys via position in ents (canonical order)
    let ia:i32=-1;
    let ib:i32=-1;
    let j:i32=0;
    while(j<ne){
      if(get32(ents,j*4)==a){ia=j;}
      if(get32(ents,j*4)==b){ib=j;}
      j=j+1;
    }
    if(ia>=0){
      if(ib>=0){
        let p1:i32=ia;
        let p2:i32=ib;
        if(p1>p2){let t:i32=p1;p1=p2;p2=t;}
        usedp[p1*40+p2]=1;
      }
    }
    i=i+1;
  }
  // (b) staged both-values on unresolved pairs, all contexts
  let a2:i32=0;
  while(a2<ne){
    let b2:i32=a2+1;
    while(b2<ne){
      if(usedp[a2*40+b2]==0){
        let x:i32=get32(ents,a2*4);
        let y:i32=get32(ents,b2*4);
        let j:i32=0;
        while(j<nc){
          let c:i32=get32(ctxs,j*4);
          if(used<budget){
            let r0:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,0,0,pseq,"TEST");
            used=used+1;
            if(r0==0){
              if(used<budget){
                l_do_test(WB,AS,LOG,TR,PR,c,x,y,1,0,pseq,"TEST");
                used=used+1;
              }
            }
          }
          j=j+1;
        }
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  let tp:i32=get32(AS,8);
  set32(AS,8,tp+used);
  return used;
}
// (2a) guard re-expansion: rebuild kind1 from training + TEST-ACCEPTs
fn l_guard_reexpand(LOG:[]u8, train:[]u8, ntrain:i32, sc:[]u8)void {
  let aug:[]u8=z_alloc(8192);
  let na:i32=0;
  let i:i32=0;
  while(i<ntrain){
    set32(aug,na*16,get32(train,i*16));
    set32(aug,na*16+4,get32(train,i*16+4));
    set32(aug,na*16+8,get32(train,i*16+8));
    set32(aug,na*16+12,get32(train,i*16+12));
    na=na+1;
    i=i+1;
  }
  let n:i32=get32(LOG,0);
  i=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        // add if (s0,a,b) not in aug
        let found:i32=0;
        let j:i32=0;
        while(j<na){
          let s2:i32=get32(aug,j*16);
          let x2:i32=get32(aug,j*16+4);
          let y2:i32=get32(aug,j*16+8);
          if(s2==s0){
            if(x2==a){
              if(y2==b){found=1;}
            }
            if(x2==b){
              if(y2==a){found=1;}
            }
          }
          j=j+1;
        }
        if(found==0){
          set32(aug,na*16,s0);
          set32(aug,na*16+4,a);
          set32(aug,na*16+8,b);
          set32(aug,na*16+12,vv);
          na=na+1;
        }
      }
    }
    i=i+1;
  }
  l_form_new(sc,1);
  i=0;
  while(i<na){
    let s0:i32=get32(aug,i*16);
    let x:i32=get32(aug,i*16+4);
    let y:i32=get32(aug,i*16+8);
    let d:i32=get32(aug,i*16+12);
    if(l_form_find(sc,s0,x,y)<0){
      l_form_add(sc,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// (2b) union re-expansion: union current form with probe-derived entries
fn l_union_reexpand(f:[]u8, LOG:[]u8, sc:[]u8)void {
  l_form_copy(f,sc);
  // ensure kind1
  if(get32(sc,0)==0){
    // expand pairtable to per-s0: need s0 values; use -1 (keep simple:
    // union on pairtable = add probe-ACCEPT pairs)
  }
  if(get32(sc,0)==0){
    set32(sc,0,1);
  }
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        if(l_form_find(sc,s0,a,b)<0){
          l_form_add(sc,s0,a,b,vv);
        }
      }
    }
    i=i+1;
  }
  return;
}
// (3) ARITY-LIFT: kind1 -> kind2 (add per-element record slot)
fn l_arity_lift(f:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==0){
    // expand pairtable to guarded (one entry per s0=-1 kept; lift needs s0)
    // convert: keep kind0 entries but mark kind1 with s0=-1
    set32(f,0,1);
    kind=1;
  }
  if(kind!=1){return;}
  set32(f,0,2);
  let n:i32=get32(f,4);
  let roff:i32=12+n*16;
  set32(f,8,roff);
  set32(f,roff,0);
  return;
}
// fill/recompute the record from the consequence log (experience).
// Updates existing entries, adds new ones. Emits MARK per element.
fn l_fill_record(f:[]u8, LOG:[]u8, AS:[]u8, TR:[]u8, parent:i32)void {
  let roff:i32=get32(f,8);
  if(roff==0){return;}
  let nrec:i32=get32(f,roff);
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let ek:i32=get32(LOG,4+i*24);
    let s0:i32=l_ekey_s0(ek);
    let ab:i32=ek%1000000;
    let a:i32=ab/1000;
    let b:i32=ab%1000;
    let mask:i32=l_surviving(LOG,ek);
    let prov:i32=l_prov(LOG,ek);
    // find existing
    let fi:i32=-1;
    let j:i32=0;
    while(j<nrec){
      let b2:i32=roff+4+j*20;
      let es:i32=get32(f,b2);
      let ex:i32=get32(f,b2+4);
      let ey:i32=get32(f,b2+8);
      if(es==s0){
        let hit:i32=0;
        if(ex==a){ if(ey==b){hit=1;} }
        if(ex==b){ if(ey==a){hit=1;} }
        if(hit==1){fi=j;}
      }
      j=j+1;
    }
    if(fi<0){
      let b3:i32=roff+4+nrec*20;
      set32(f,b3,s0);
      set32(f,b3+4,a);
      set32(f,b3+8,b);
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
      nrec=nrec+1;
      set32(f,roff,nrec);
    } else {
      let b3:i32=roff+4+fi*20;
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
    }
    let seq:i32=l_tr(AS,TR,parent,"MARK",ek,mask,prov,0);
    let mt:i32=get32(AS,76);
    set32(AS,76,mt+1);
    if(mask==3){
      let um:i32=get32(AS,44);
      set32(AS,44,um+1);
      let fms:i32=get32(AS,20);
      if(fms==0){set32(AS,20,seq);}
    }
    i=i+1;
  }
  return;
}
// simplify: PROJECT away redundant structure (structural, not a mode).
// NOTE: kind2->kind1 is NOT done here; the record's ABSTAIN-on-unknown
// is load-bearing (dropping it reintroduces fabrication). Only the
// kind1->kind0 collapse is attempted, and only if fully consistent.
fn l_simplify(AS:[]u8, TR:[]u8, LOG:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)void {
  let kind:i32=get32(f,0);
  if(kind==1){
    l_form_new(sc,0);
    let i:i32=0;
    while(i<ntrain){
      let x:i32=get32(train,i*16+4);
      let y:i32=get32(train,i*16+8);
      let d:i32=get32(train,i*16+12);
      if(l_form_find(sc,-1,x,y)<0){
        l_form_add(sc,-1,x,y,d);
      }
      i=i+1;
    }
    if(l_replay_consistent(sc,LOG,train,ntrain)==1){
      l_form_copy(sc,f);
      l_tr(AS,TR,parent,"PROJECT",1,0,0,0);
      set32(AS,84,1);
    }
  }
  return;
}
// committable? graded: full-history replay; ungraded: training fit.
fn l_committable(f:[]u8, LOG:[]u8, train:[]u8, ntrain:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){
    return l_replay_consistent(f,LOG,train,ntrain);
  }
  return l_train_consistent(f,train,ntrain);
}
// escalation enumeration (frozen order):
// (1) further probing < (2a) guard re-expansion < (2b) union re-expansion
// < (3) resolution-slot lifting. Adopt the first composition rendering
// the full history consistent under generic replay.
// Returns 1 if adopted (f updated), 0 if none (caller DEFERS).
fn l_escalate(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let esc:i32=l_tr(AS,TR,parent,"ESCALATE",0,0,0,0);
  let t1:i32=l_tr(AS,TR,esc,"FORM_TRY",1,0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,f,train,ntrain,500,t1);
  if(l_replay_consistent(f,LOG,train,ntrain)==1){
    l_tr(AS,TR,t1,"TRY_OK",1,0,0,0);
    return 1;
  }
  l_tr(AS,TR,t1,"TRY_FAIL",1,0,0,0);
  let t2:i32=l_tr(AS,TR,esc,"FORM_TRY",2,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t2,"TRY_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t2,"TRY_FAIL",2,0,0,0);
  let of:i32=get32(AS,28);
  set32(AS,28,of+1);
  let t3:i32=l_tr(AS,TR,esc,"FORM_TRY",3,0,0,0);
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t3,"TRY_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t3,"TRY_FAIL",3,0,0,0);
  set32(AS,28,of+2);
  let t4:i32=l_tr(AS,TR,esc,"FORM_TRY",4,0,0,0);
  l_form_copy(f,sc);
  if(get32(sc,0)==0){
    // expand pairtable to guarded before lifting
    let tmp:[]u8=z_alloc(16384);
    l_form_new(tmp,1);
    let n0:i32=get32(sc,4);
    let i:i32=0;
    while(i<n0){
      let b:i32=12+i*16;
      l_form_add(tmp,get32(sc,b),get32(sc,b+4),get32(sc,b+8),get32(sc,b+12));
      i=i+1;
    }
    l_form_copy(tmp,sc);
  }
  l_arity_lift(sc);
  l_fill_record(sc,LOG,AS,TR,t4);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t4,"TRY_OK",4,0,0,0);
    l_form_copy(sc,f);
    let nr:i32=get32(AS,32);
    set32(AS,32,nr+1);
    return 1;
  }
  l_tr(AS,TR,t4,"TRY_FAIL",4,0,0,0);
  return 0;
}
// DEFER certificate from history structure:
// 2=DATA-UNTRUSTED (OBSERVE vs TEST disagree on an element),
// 1=INADEQUACY otherwise.
fn l_certify(LOG:[]u8)i32 {
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    if(kd==1){
      let ek:i32=get32(LOG,base);
      let vv:i32=get32(LOG,base+8);
      let oc:i32=get32(LOG,base+12);
      // find an OBSERVE on ek with a different value
      let j:i32=0;
      while(j<n){
        let b2:i32=4+j*24;
        if(get32(LOG,b2+4)==0){
          if(get32(LOG,b2)==ek){
            let ov:i32=get32(LOG,b2+8);
            if(ov!=vv){
              if(oc==1){return 2;}
            }
            if(ov==vv){
              if(oc==0){return 2;}
            }
          }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 1;
}
fn l_commit(AS:[]u8, TR:[]u8, PR:[]u8, KB:[]u8, f:[]u8, parent:i32)i32 {
  let kind:i32=get32(f,0);
  let seq:i32=l_tr(AS,TR,parent,"COMMIT",kind,0,0,0);
  l_pr(AS,PR,"> COMMIT");
  set32(AS,48,1);
  set32(AS,88,kind);
  l_kb_store(KB,f,kind);
  l_tr(AS,TR,seq,"KB_STORE",kind,0,0,0);
  return seq;
}
// try_improve: if the current ungraded form is not replay-consistent,
// try (2a)/(2b) to fix it with probe evidence. Adopt the first
// consistent one. Returns 1 if adopted.
// (Pre-commit form improvement; never downgrades kind2, never lifts.)
fn l_try_improve(AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){return 0;}
  if(l_replay_consistent(f,LOG,train,ntrain)==1){return 0;}
  let imp:i32=l_tr(AS,TR,parent,"IMPROVE",0,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,imp,"IMPROVE_FAIL",0,0,0,0);
  return 0;
}
fn l_defer(AS:[]u8, TR:[]u8, PR:[]u8, cert:i32, parent:i32)void {
  l_tr(AS,TR,parent,"DEFER",cert,0,0,0);
  if(cert==2){l_pr(AS,PR,"> DEFER cert=DATA-UNTRUSTED");}
  else {l_pr(AS,PR,"> DEFER cert=INADEQUACY");}
  set32(AS,56,cert);
  return;
}
// learner.zag part 3 -- treatment arm pipeline pieces.
// The driver (harness) orchestrates: setup -> try_commit -> stakes
// (harness-scored) -> revise loop. These are the learner-side steps.

// forced guarded build (for kb-template-2 instantiate)
fn l_build_guarded(train:[]u8, ntrain:i32, f:[]u8)void {
  l_form_new(f,1);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    if(l_form_find(f,s0,x,y)<0){
      l_form_add(f,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// setup: OBSERVE, BUILD (kb-aware), PROBE, lift+fill (if template 2),
// SIMPLIFY. train/form/sc are scratch. Returns ntrain.
fn l_arm_setup(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  // proto: > OBSERVE
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> OBSERVE n=");
  at=ob_i32(PR,at,ntrain);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ek:i32=l_ekey(s0,x,y);
    l_log_touch(LOG,ek,0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
  }
  l_build_direct(train,ntrain,form);
  bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,form,train,ntrain,150,bseq);
  // fix the form with probe evidence if broken (pre-commit improvement).
  // Gated: only when probes REJECTed knowledge predictions (not mere
  // tiebreak fabrications). A spurious upgrade on clean worlds would
  // force an unnecessary lift.
  if(get32(AS,92)>0){
    l_try_improve(AS,LOG,TR,PR,form,sc,train,ntrain,bseq);
  }
  // instantiate the kb resolution template (if kind1)
  if(kbv==1){
    if(tmpl==2){
      if(get32(form,0)==1){
        let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
        l_arity_lift(form);
        l_fill_record(form,LOG,AS,TR,ls);
      }
    }
  }
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  return ntrain;
}
// try commit:
//  1. knowledge-REJECTed (form was broken by probes):
//       replay-consistent now -> COMMIT; else DATA-UNTRUSTED -> DEFER,
//       else INADEQUACY -> DEFER.
//  2. replay-consistent -> COMMIT.
//  3. DATA-UNTRUSTED (OBSERVE vs TEST) -> DEFER.
//  4. graded (kind2) but inconsistent: escalate now; commit or defer.
//  5. else COMMIT the best ungraded form (stakes adjudicate; the
//     post-stakes escalation invents if needed).
// Returns commit seq, or -1 on DEFER.
fn l_arm_try_commit(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  if(get32(AS,92)>0){
    if(l_replay_consistent(form,LOG,train,ntrain)==1){
      let cs:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  if(l_replay_consistent(form,LOG,train,ntrain)==1){
    let cs2:i32=l_commit(AS,TR,PR,KB,form,parent);
    return cs2;
  }
  if(l_certify(LOG)==2){
    l_defer(AS,TR,PR,2,parent);
    return -1;
  }
  // best available ungraded form; commit (stakes will falsify if needed)
  let kind:i32=get32(form,0);
  if(kind==2){
    // graded but inconsistent and not data-untrusted: escalate now
    if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,parent)==1){
      let cs3:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs3;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  let cs4:i32=l_commit(AS,TR,PR,KB,form,parent);
  return cs4;
}
// revise after stakes REJECTs: escalate; re-commit or defer.
// Returns commit seq or -1.
fn l_arm_revise(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let rv:i32=l_tr(AS,TR,parent,"REVISE",0,0,0,0);
  if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,rv)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,rv);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),rv);
  return -1;
}
// controls.zag -- C0 (ungraded baseline), C1 (memorize+1NN), C3 (no-reverify).
// C2 (wiped) is the treatment pipeline with a wiped kb (driver-side).

// C0: L_old. No consequence log, no escalation, no marking, no
// re-verification. Direct build, L_old verify-probe, commit, stakes.
// Must be confidently wrong on W0/FA/FB/FC (discrimination gate) and
// on T1/T2/T3 (SUF-K6).
fn c0_run(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_build_direct(train,ntrain,form);
  let bseq:i32=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  // L_old probe-then-commit: verify each training prediction once.
  // No slot-varying, no consequence log (the RK-A/RK-B/RK-C bugs).
  let out:[]u8=z_alloc(8);
  let pseq:i32=l_tr(AS,TR,bseq,"PROBE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    l_predict2(form,s0,x,y,out);
    let v:i32=get32(out,0);
    if(v!=-1){
      let r:i32=w_test(WB,s0,x,y,v);
      l_tr(AS,TR,pseq,"TEST",s0,x,y,v);
      l_pr_test(AS,PR,s0,x,y,v,r);
      let tt:i32=get32(AS,4);
      set32(AS,4,tt+1);
    }
    i=i+1;
  }
  if(l_train_consistent(form,train,ntrain)==1){
    let cs:i32=l_tr(AS,TR,pseq,"COMMIT",get32(form,0),0,0,0);
    l_pr(AS,PR,"> COMMIT");
    set32(AS,48,1);
    set32(AS,88,get32(form,0));
    return cs;
  }
  l_tr(AS,TR,pseq,"DEFER",1,0,0,0);
  set32(AS,56,1);
  return -1;
}
// C1: memorize training; answer by 1-nearest-neighbor (id distance).
// mem: (s0,x,y,d)*n. Never abstains. Must fail T2.
fn c1_observe(WB:[]u8, mem:[]u8)i32 {
  let ntrain:i32=w_observe(WB,mem);
  set32(mem,4092,ntrain);
  return ntrain;
}
fn c1_answer(mem:[]u8, s0:i32, x:i32, y:i32)i32 {
  let ntrain:i32=get32(mem,4092);
  let best:i32=-1;
  let bd:i32=1000000000;
  let i:i32=0;
  while(i<ntrain){
    let s2:i32=get32(mem,i*16);
    let x2:i32=get32(mem,i*16+4);
    let y2:i32=get32(mem,i*16+8);
    let d2:i32=get32(mem,i*16+12);
    let dd:i32=s2-s0;
    if(dd<0){dd=0-dd;}
    let dx:i32=x2-x;
    if(dx<0){dx=0-dx;}
    let dy:i32=y2-y;
    if(dy<0){dy=0-dy;}
    let dist:i32=dd+dx+dy;
    if(dist<bd){
      bd=dist;
      best=d2;
    }
    i=i+1;
  }
  if(best<0){return 0;}
  return best;
}
// C3: treatment MINUS re-verification (no probe/verification TESTs).
// Consequence logging + escalation + marking intact. Must commit
// confidently wrong on T3 (proves re-verification is the fix; SUF-K9).
fn c3_run(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_log_touch(LOG,l_ekey(s0,x,y),0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
    if(tmpl==2){
      l_build_guarded(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",1,1,0,0);
      let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
      l_arity_lift(form);
      l_fill_record(form,LOG,AS,TR,ls);
    } else {
      l_build_direct(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
    }
  } else {
    l_build_direct(train,ntrain,form);
    bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  }
  // NO probe phase (no re-verification) -- the RK-C behavior.
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  if(l_committable(form,LOG,train,ntrain)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,bseq);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),bseq);
  return -1;
}
// driver.zag -- harness for L3-SUF-1 builder DEV battery.
// h_ functions are harness (may call w_truth/w_stakes_meta/w_undet
// for scoring; the learner l_ functions never do -- A-INFO boundary).
// The driver runs: discrimination gate, treatment T0..T7 (one continuing
// learner, kb persists), controls C0/C1/C2/C3, then evaluates the frozen
// bars. 3/3 byte-identical run logs; digests via sha256sum (shell).

// ---- harness-scored stakes ----
// mode 0: answer via l_predict2(form); mode 1: c1_answer(mem).
// sres: nstakes*3 i32s (v_pred, oc, fab). Returns REJECT count.
fn h_stakes(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, mode:i32, mem:[]u8, sres:[]u8)i32 {
  let sq:[]u8=z_alloc(1024);
  let out:[]u8=z_alloc(8);
  let ns:i32=w_stakes(WB,sq);
  let ss:i32=l_tr(AS,TR,0,"STAKES",ns,0,0,0);
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> STAKES n=");
  at=ob_i32(PR,at,ns);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let nrej:i32=0;
  let i:i32=0;
  while(i<ns){
    let s0:i32=get32(sq,i*12);
    let x:i32=get32(sq,i*12+4);
    let y:i32=get32(sq,i*12+8);
    let v:i32=-1;
    let fb:i32=0;
    if(mode==0){
      l_predict2(form,s0,x,y,out);
      v=get32(out,0);
      fb=get32(out,4);
    } else {
      v=c1_answer(mem,s0,x,y);
      fb=0;
    }
    let ek:i32=l_ekey(s0,x,y);
    if(v==-1){
      let seq:i32=l_tr(AS,TR,ss,"ABSTAIN",ek,0,0,0);
      l_pr(AS,PR,"> ABSTAIN");
      l_log_touch(LOG,ek,2,-1,2,0,seq);
      let na:i32=get32(AS,64);
      set32(AS,64,na+1);
      set32(sres,i*12,-1);
      set32(sres,i*12+4,2);
      set32(sres,i*12+8,0);
    } else {
      let t:i32=w_truth(WB,s0,x,y);
      let oc:i32=0;
      if(t==v){oc=1;}
      let seq:i32=l_tr(AS,TR,ss,"SANS",ek,v,oc,0);
      let at2:i32=get32(AS,72);
      at2=ob_app(PR,at2,"> SANS s0=");
      at2=ob_i32(PR,at2,s0);
      at2=ob_app(PR,at2," x=");
      at2=ob_i32(PR,at2,x);
      at2=ob_app(PR,at2," y=");
      at2=ob_i32(PR,at2,y);
      at2=ob_app(PR,at2," v=");
      at2=ob_i32(PR,at2,v);
      if(oc==1){at2=ob_app(PR,at2," => ACCEPT");}
      else {at2=ob_app(PR,at2," => REJECT");}
      at2=ob_nl(PR,at2);
      set32(AS,72,at2);
      l_log_touch(LOG,ek,2,v,oc,fb,seq);
      set32(sres,i*12,v);
      set32(sres,i*12+4,oc);
      set32(sres,i*12+8,fb);
      if(oc==0){
        nrej=nrej+1;
        let fcs:i32=get32(AS,24);
        if(fcs==0){set32(AS,24,seq);}
        set32(AS,52,1);
      }
    }
    i=i+1;
  }
  return nrej;
}
fn h_zero_as(AS:[]u8)void {
  let i:i32=0;
  while(i<256){AS[i]=0;i=i+1;}
  return;
}
// ---- treatment arm ----
fn h_treat_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let ntrain:i32=l_arm_setup(WB,KB,AS,LOG,TR,PR,train,form,sc);
  let cs:i32=l_arm_try_commit(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,0);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  let rounds:i32=0;
  while(nrej>0){
    if(rounds>=2){break;}
    let tt:i32=get32(AS,4);
    if(tt>=2000){break;}
    let cs2:i32=l_arm_revise(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,cs);
    if(cs2<0){break;}
    nrej=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
    rounds=rounds+1;
  }
  return nrej;
}
// ---- C0 arm ----
fn h_c0_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let cs:i32=c0_run(WB,AS,TR,PR,train,form);
  if(cs<0){return -1;}
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- C1 arm ----
fn h_c1_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, mem:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let ntrain:i32=c1_observe(WB,mem);
  l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_tr(AS,TR,0,"COMMIT",9,0,0,0);
  set32(AS,48,1);
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,mem,1,mem,sres);
  return nrej;
}
// ---- C3 arm ----
fn h_c3_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let cs:i32=c3_run(WB,KB,AS,LOG,TR,PR,train,form,sc);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- scoring helpers (harness) ----
// heldout tallies from sres: returns packed (wrong, correct_det, abst_und, D_det, D_und)
fn h_held_tally(WB:[]u8, sres:[]u8, out:[]u8)void {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let wrong:i32=0;
  let cdet:i32=0;
  let aud:i32=0;
  let ddet:i32=0;
  let dund:i32=0;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let held:i32=get32(meta,0);
    let det:i32=get32(meta,4);
    if(held==1){
      let v:i32=get32(sres,i*12);
      let so:i32=get32(WB,get32(WB,40)+i*20);
      let sx:i32=get32(WB,get32(WB,40)+i*20+4);
      let sy:i32=get32(WB,get32(WB,40)+i*20+8);
      // map indices to ids for w_truth
      let eoff:i32=get32(WB,16);
      let coff:i32=get32(WB,20);
      let t:i32=w_truth_idx(WB,so,sx,sy);
      if(det==0){
        ddet=ddet+1;
        if(v==-1){}
        else {
          if(v==t){cdet=cdet+1;}
          else {wrong=wrong+1;}
        }
      } else {
        dund=dund+1;
        if(v==-1){aud=aud+1;}
        else {
          // F-FABRICATION: any predicted undetermined pair is wrong,
          // even if luckily correct (it was not abstained).
          wrong=wrong+1;
        }
      }
    }
    i=i+1;
  }
  set32(out,0,wrong);
  set32(out,4,cdet);
  set32(out,8,aud);
  set32(out,12,ddet);
  set32(out,16,dund);
  return;
}
// T0(iii) / stakes-shape check on the LAST sres:
// det queries: no REJECT; undet queries: all ABSTAIN.
fn h_stakes_shape(WB:[]u8, sres:[]u8)i32 {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let det:i32=get32(meta,4);
    let v:i32=get32(sres,i*12);
    let oc:i32=get32(sres,i*12+4);
    if(det==0){
      if(oc==0){ok=0;}
    } else {
      if(v!=-1){ok=0;}
    }
    i=i+1;
  }
  return ok;
}
fn d_bar2(ob:[]u8, atp:[]u8, name:[]u8, pass:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}
fn d_pend(ob:[]u8, atp:[]u8, name:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," PENDING\n");
  set32(atp,0,at);
  return;
}
// dump a text buffer section
fn h_dumpsec(ob:[]u8, atp:[]u8, title:[]u8, buf:[]u8, len:i32)void {
  e0(ob,atp,title);
  let at:i32=get32(atp,0);
  let i:i32=0;
  while(i<len){
    ob[at]=buf[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  return;
}
// scale_main.zag -- scaling driver for L3-SUF-1-SCALING.
// Links the FROZEN learner sources (read-only) + this worker's
// scale_world.zag. One (family, scale) per binary; placeholders
// 1 (0=INV, 1=ABS) and 4 (0..5) are substituted at build.
// Runs h_treat_arm (frozen driver), then computes the frozen SC-K bars
// and emits a deterministic summary. No wall-clock in output.
fn s_and(a:i32, b:i32)i32 {
  if(a==1){
    if(b==1){return 1;}
  }
  return 0;
}
fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let fam:i32=1;
  let sc:i32=4;
  e2(ob,atp,"L3-SUF-1-SCALING fam=",(fam)," scale=",(sc));
  let wb:[]u8=z_alloc(262144);
  s_build(fam,sc,wb);
  let nent:i32=get32(wb,0);
  let ntrain0:i32=get32(wb,8);
  let nst0:i32=get32(wb,12);
  e3(ob,atp,"world nent=",(nent)," ntrain=",(ntrain0)," nstakes=",(nst0));
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(131072);
  let TR:[]u8=z_alloc(1048576);
  let PR:[]u8=z_alloc(524288);
  let train:[]u8=z_alloc(8192);
  let form:[]u8=z_alloc(16384);
  let sc2:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  let tally:[]u8=z_alloc(32);
  l_kb_wipe(KB);
  let nrej:i32=h_treat_arm(wb,KB,AS,LOG,TR,PR,train,form,sc2,sres);
  let fms:i32=get32(AS,20);
  let fcr:i32=get32(AS,24);
  let opf:i32=get32(AS,28);
  let shape:i32=h_stakes_shape(wb,sres);
  h_held_tally(wb,sres,tally);
  let wrong:i32=get32(tally,0);
  let cdet:i32=get32(tally,4);
  let aud:i32=get32(tally,8);
  let ddet:i32=get32(tally,12);
  let dund:i32=get32(tally,16);
  let ttot:i32=get32(AS,4);
  let probes:i32=get32(AS,8);
  let slotvary:i32=get32(AS,36);
  let staged:i32=probes-slotvary;
  let marks:i32=get32(AS,76);
  let unresm:i32=get32(AS,44);
  let ckind:i32=get32(AS,88);
  let defer:i32=get32(AS,56);
  // surgical precision: stakes-queried determined pairs with final
  // record mask == UNRESOLVED(3)
  let sq:[]u8=z_alloc(1024);
  let meta:[]u8=z_alloc(8);
  let ns:i32=w_stakes(wb,sq);
  let om:i32=0;
  let dq:i32=0;
  let qi:i32=0;
  while(qi<ns){
    w_stakes_meta(wb,qi,meta);
    let det:i32=get32(meta,4);
    if(det==0){
      dq=dq+1;
      let s0:i32=get32(sq,qi*12);
      let x:i32=get32(sq,qi*12+4);
      let y:i32=get32(sq,qi*12+8);
      let m:i32=l_rec_lookup(form,s0,x,y);
      if(m==3){om=om+1;}
    }
    qi=qi+1;
  }
  e3(ob,atp,"arm nrej=",(nrej)," first_unres_mark=",(fms)," first_creject=",(fcr));
  e2(ob,atp,"arm op_fail=",(opf)," stakes_shape=",(shape));
  e3(ob,atp,"tally wrong=",(wrong)," cdet=",(cdet)," abst_und=",(aud));
  e2(ob,atp,"tally ddet=",(ddet)," dund=",(dund));
  e3(ob,atp,"tests total=",(ttot)," probes=",(probes)," slotvary=",(slotvary));
  e3(ob,atp,"tests staged=",(staged)," marks=",(marks)," unres_marks=",(unresm));
  e2(ob,atp,"commit_kind=",(ckind)," defer=",(defer));
  e2(ob,atp,"overmark det_marked3=",(om)," det_queried=",(dq));
  // ---- frozen bars ----
  let inv_i:i32=0;
  if(fcr>0){
    if(fms>fcr){inv_i=1;}
  }
  let inv_ii:i32=0;
  if(opf>=2){inv_ii=1;}
  let inv_iii:i32=shape;
  let inv_pass:i32=s_and(inv_i,s_and(inv_ii,inv_iii));
  let abs_i:i32=0;
  if(wrong==0){abs_i=1;}
  let abs_ii:i32=0;
  if(cdet>=7){abs_ii=1;}
  let abs_iii:i32=0;
  if(dund==4){
    if(aud==4){abs_iii=1;}
  }
  let abs_iv:i32=0;
  if(dq>0){
    if(om*2<=dq){abs_iv=1;}
  }
  let abs_pass:i32=s_and(abs_i,s_and(abs_ii,s_and(abs_iii,abs_iv)));
  let tests_ok:i32=0;
  if(ttot<=2000){tests_ok=1;}
  e3(ob,atp,"INV i=",(inv_i)," ii=",(inv_ii)," iii=",(inv_iii));
  e1(ob,atp,"INV pass=",(inv_pass));
  e3(ob,atp,"ABS i=",(abs_i)," ii=",(abs_ii)," iii=",(abs_iii));
  e2(ob,atp,"ABS iv=",(abs_iv)," pass=",(abs_pass));
  e1(ob,atp,"tests_ok=",(tests_ok));
  let verdict:i32=0;
  if(fam==0){
    if(s_and(inv_pass,tests_ok)==1){verdict=1;}
  } else {
    if(s_and(abs_pass,tests_ok)==1){verdict=1;}
  }
  e1(ob,atp,"SC_VERDICT=",(verdict));
  write_ob(ob,atp);
  return 0;
}

// diag_main.zag -- POST-PREREG DIAGNOSTIC (not part of the frozen battery).
// For the S3 ABS run: for each stakes-queried determined pair whose final
// record mask is UNRESOLVED(3), report the evidence the consequence log
// holds on that element: OBSERVE touches, TEST-ACCEPTs, TEST-REJECTs,
// STAKES-ACCEPTs, STAKES-REJECTs. Distinguishes:
//   Case A (R-SUF-1 defect): TEST-ACCEPTs exist but were discarded by
//           rule (ii) after a fabrication REJECT.
//   Case B (correct): no positive evidence at that (s0,x,y); the
//           ABSTAIN is the honest starvation response.
// Links the same frozen sources + scale_world.zag. Deterministic.
fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  e0(ob,atp,"DIAG fam=0 scale=0 overmark-evidence");
  let wb:[]u8=z_alloc(262144);
  s_build(0,0,wb);
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(131072);
  let TR:[]u8=z_alloc(1048576);
  let PR:[]u8=z_alloc(524288);
  let train:[]u8=z_alloc(8192);
  let form:[]u8=z_alloc(16384);
  let sc2:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  l_kb_wipe(KB);
  let nrej:i32=h_treat_arm(wb,KB,AS,LOG,TR,PR,train,form,sc2,sres);
  e1(ob,atp,"DIAG nrej=",(nrej));
  let sq:[]u8=z_alloc(1024);
  let meta:[]u8=z_alloc(8);
  let ns:i32=w_stakes(wb,sq);
  let nl:i32=get32(LOG,0);
  let qi:i32=0;
  while(qi<ns){
    w_stakes_meta(wb,qi,meta);
    let det:i32=get32(meta,4);
    if(det==0){
      let s0:i32=get32(sq,qi*12);
      let x:i32=get32(sq,qi*12+4);
      let y:i32=get32(sq,qi*12+8);
      let m:i32=l_rec_lookup(form,s0,x,y);
      if(m==3){
        let ek:i32=l_ekey(s0,x,y);
        let nobs:i32=0;
        let tacc:i32=0;
        let trej:i32=0;
        let sacc:i32=0;
        let srej:i32=0;
        let sfab:i32=0;
        let li:i32=0;
        while(li<nl){
          let base:i32=4+li*24;
          if(get32(LOG,base)==ek){
            let kd:i32=get32(LOG,base+4);
            let oc:i32=get32(LOG,base+12);
            let fb:i32=get32(LOG,base+16);
            if(kd==0){nobs=nobs+1;}
            if(kd==1){
              if(oc==1){tacc=tacc+1;}
              if(oc==0){trej=trej+1;}
            }
            if(kd==2){
              if(oc==1){sacc=sacc+1;}
              if(oc==0){
                srej=srej+1;
                if(fb==1){sfab=sfab+1;}
              }
            }
          }
          li=li+1;
        }
        // predicted value at round-1 stakes would tell the story; report counts
        e1(ob,atp,"DIAG q=",(qi));
        e3(ob,atp,"DIAG ek_s0=",(s0)," x=",(x)," y=",(y));
        e3(ob,atp,"DIAG obs=",(nobs)," test_acc=",(tacc)," test_rej=",(trej));
        e3(ob,atp,"DIAG stakes_acc=",(sacc)," stakes_rej=",(srej)," stakes_fabrej=",(sfab));
        let casea:i32=0;
        if(tacc>0){casea=1;}
        if(sacc>0){casea=1;}
        e1(ob,atp,"DIAG caseA_defect=",(casea));
      }
    }
    qi=qi+1;
  }
  write_ob(ob,atp);
  return 0;
}

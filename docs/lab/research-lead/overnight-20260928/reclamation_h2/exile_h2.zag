// exile_h2.zag -- RECLAMATION-H2 lane (exile, not destruction).
// Substrate identical to LIVENESS-SIGNAL (byte for byte in hot
// mechanism). New code: the recoverable cold tier (base 2752,
// 64 slots x 20 bytes), exile_victim (displacement = exile, never
// destroy), the cold-tier FIFO overflow rule (cold_drop), the
// recovery path (mem_read_recov / cold_lookup / test_A_recov, no
// promotion), the drop-path exile, policy 0/1 branches (verbatim from
// EVICTION-POLICY-COMPARE) and policy 4 branch (verbatim from
// PINNING-RECLAMATION), and the EXH2-OVF overflow driver.
// See PREREG.md for the frozen design, derivation notes, kill bars.
//
// Header: 0 bumpA (pol 0/1 bump pointer), 4 conflicts, 8 evictions,
// 12 table_full_errors, 16 pool_size (=32), 20 policy, 24 bumpB
// (pol 1 class-1 bump pointer), 28 drop, 32 consent_mask (=16),
// 36 clock (monotonic last-touch stamp), 40 exile, 44 recover,
// 48 cold_drop, 52 cold_cost, 56 cold_seq.
// Primary: 64, 128 slots x 16 bytes. Pool: 2112, 32 slots x 16 bytes.
// Touch side table: 2624, 32 slots x 4 bytes (last-touch per pool slot).
// Cold tier: 2752, 64 slots x 20 bytes (key,val,owner,used,exile-seq).
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn coff(idx:i32)i32 { return 2752+idx*20; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
// last-touch side table (base 2624, 32 x 4 bytes)
fn tget(M:[]u8,s:i32)i32 { return ig(M,2624+s*4); }
fn stamp(M:[]u8,s:i32)void {
  let c:i32=ig(M,36)+1;
  put32(M,36,c);
  put32(M,2624+s*4,c);
  return;
}
// Exile: move a displaced hot-tier entry to the cold tier. First free
// cold slot; if the cold tier is full, FIFO by exile-seq (cold_drop++).
// exile++ on every displacement. The hot tier never destroys.
fn exile_victim(M:[]u8,key:i32,val:i32,owner:i32)void {
  let s:i32=0;
  while(s<64){
    let co:i32=coff(s);
    if(ig(M,co+12)==0){
      put32(M,co,key); put32(M,co+4,val);
      put32(M,co+8,owner); put32(M,co+12,1);
      let q:i32=ig(M,56)+1;
      put32(M,56,q); put32(M,co+16,q);
      put32(M,40,ig(M,40)+1);
      return;
    }
    s=s+1;
  }
  let ms:i32=0;
  let mq:i32=ig(M,coff(0)+16);
  s=1;
  while(s<64){
    let qq:i32=ig(M,coff(s)+16);
    if(qq<mq){mq=qq;ms=s;}
    s=s+1;
  }
  let co:i32=coff(ms);
  put32(M,co,key); put32(M,co+4,val);
  put32(M,co+8,owner); put32(M,co+12,1);
  let q:i32=ig(M,56)+1;
  put32(M,56,q); put32(M,co+16,q);
  put32(M,48,ig(M,48)+1);
  put32(M,40,ig(M,40)+1);
  return;
}
// Cold-tier lookup for the recovery path. cold_cost += slots examined
// (position+1 on hit, 64 on miss). recover++ on hit. No promotion.
fn cold_lookup(M:[]u8,key:i32,owner:i32)i32 {
  let s:i32=0;
  while(s<64){
    let co:i32=coff(s);
    put32(M,52,ig(M,52)+1);
    if(ig(M,co+12)==1 && ig(M,co)==key){
      if((ig(M,co+8)&owner)!=0){
        put32(M,44,ig(M,44)+1);
        return ig(M,co+4);
      }
    }
    s=s+1;
  }
  return -1;
}
// Policy relocation for the conflict victim at primary slot so.
// Caller has already counted the conflict. After this returns, the
// caller installs the new value in the primary slot.
// Every displaced entry is exiled; nothing in the hot tier is destroyed.
fn relocate(M:[]u8,so:i32)void {
  let pol:i32=ig(M,20);
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  if(pol==0){
    // FIFO (verbatim from EVICTION-POLICY-COMPARE): single circular
    // bump pointer modulo 32. The overwritten pool entry is exiled.
    let op:i32=ig(M,0);
    let oo:i32=soff(2112,op);
    if(ig(M,oo+12)==1){
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    }
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    put32(M,0,(op+1)%32);
    return;
  }
  if(pol==1){
    // PART (verbatim from EVICTION-POLICY-COMPARE): class 1 iff victim
    // owner is exactly 16 (B-only), else class 0. 16-slot partition
    // per class, own circular bump pointer modulo 16, FIFO within
    // class. The overwritten pool entry is exiled.
    let cls:i32=0;
    if(vo==16){cls=1;}
    let bp:i32=ig(M,0);
    if(cls==1){bp=ig(M,24);}
    let oo:i32=soff(2112,cls*16+bp);
    if(ig(M,oo+12)==1){
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    }
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    bp=(bp+1)%16;
    if(cls==1){put32(M,24,bp);}
    if(cls==0){put32(M,0,bp);}
    return;
  }
  // All other policies: scan for the first free slot first.
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,key); put32(M,oo+4,vv);
      put32(M,oo+8,vo); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  // Pool full: reclamation per policy.
  if(pol==4){
    // PIN-LRU (verbatim from PINNING-RECLAMATION): evict the used
    // slot with minimum last-touch. The victim is exiled.
    let ms:i32=0;
    let mt:i32=tget(M,0);
    s=1;
    while(s<32){
      let tt:i32=tget(M,s);
      if(tt<mt){mt=tt;ms=s;}
      s=s+1;
    }
    let oo:i32=soff(2112,ms);
    put32(M,8,ig(M,8)+1);
    exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    stamp(M,ms);
    return;
  }
  if(pol==5){
    // PIN-CONSENT: evict the first used slot whose owner intersects
    // the consent mask; other slots stay pinned forever. The victim
    // is exiled. On mask miss, the old primary entry is exiled and
    // drop++ (destroy-in-place becomes exile-in-place).
    let cm:i32=ig(M,32);
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let consent:i32=0;
      if((ig(M,oo+8)&cm)!=0){consent=1;}
      let ok:i32=0;
      if(used==1){ok=consent;}
      if(ok==1){
        put32(M,8,ig(M,8)+1);
        exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
        put32(M,oo,key); put32(M,oo+4,vv);
        put32(M,oo+8,vo); put32(M,oo+12,1);
        stamp(M,s);
        return;
      }
      s=s+1;
    }
    exile_victim(M,key,vv,vo);
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==6){
    // PIN-LIVELINESS: owner-blind. Evict the used slot with the
    // minimum last-touch stamp (ties: lowest slot index). Owner
    // identity is never consulted. The victim is exiled.
    let best:i32=-1;
    let bestt:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      if(used==1){
        let ts:i32=tget(M,s);
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && ts<bestt){take=1;}
        if(take==1){best=s;bestt=ts;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,bo),ig(M,bo+4),ig(M,bo+8));
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      stamp(M,best);
      return;
    }
    exile_victim(M,key,vv,vo);
    put32(M,28,ig(M,28)+1);
    return;
  }
  // PIN-NORECLAIM (policy 3): no reclamation; the old primary entry
  // is exiled and drop++ (destroy-in-place becomes exile-in-place).
  exile_victim(M,key,vv,vo);
  put32(M,28,ig(M,28)+1);
  return;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Counted identically in all
      // policies; only the relocation outcome is policy-dependent.
      put32(M,4,ig(M,4)+1);
      relocate(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
// Hot-path read: primary -> pool, owner-scoped. Never consults cold.
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){stamp(M,o);return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}
// Recovery-path read: hot path, then cold fallback on miss.
fn mem_read_recov(M:[]u8,key:i32,owner:i32)i32 {
  let v:i32=mem_read(M,key,owner);
  if(v!=-1){return v;}
  return cold_lookup(M,key,owner);
}

// ---------- structures (identical to LIVENESS-SIGNAL) ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary, single-owner (mode 0): w writes on B-owned fresh
// key 3999. First write allocates; each later write conflicts and
// relocates a B-owned victim. (unchanged from PINNING-RECLAMATION)
fn teach_churn(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3999,900001+j,16);
    j=j+1;
  }
  return;
}
// churn adversary, multi-owner (unchanged from MULTI-OWNER-CHURN).
// mode=1: key 3998 (owner 8) and key 3999 (owner 16), interleaved per
// round. mode=2: adds key 3997 (owner 4) as the first write of each
// round. mode=3 (X2): keys 3997 (owner 4) and 3998 (owner 8)
// interleaved per round; no owner-16 churner at all.
fn teach_churn_multi(M:[]u8,mode:i32,w:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    if(mode==3){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    if(mode==1){mem_write(M,3999,900001+j,16);}
    if(mode==2){mem_write(M,3999,900001+j,16);}
    j=j+1;
  }
  return;
}
// churn adversary with benign re-reads interleaved: after every churn
// round, re-run the full A test. Used only by EXH2R-M2.
fn churn_multi_reread(M:[]u8,mode:i32,w:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    if(mode==1){mem_write(M,3999,900001+j,16);}
    if(mode==2){mem_write(M,3999,900001+j,16);}
    let rr:i32=test_A(M,1);
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// test_A on the recovery path: hot reads, cold fallback on miss.
fn test_A_recov(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read_recov(M,1000+i*10+1,1)==i*100+7 && mem_read_recov(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read_recov(M,1000+i*10+1,2);
      let b:i32=mem_read_recov(M,1000+i*10+2,2);
      let c:i32=mem_read_recov(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read_recov(M,2000+i,4);
      let a2:i32=mem_read_recov(M,1000+i*10+1,4);
      let b2:i32=mem_read_recov(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read_recov(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic, hot path only).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// R layout per condition (56 bytes): 0 pre, 4 post, 8 ret, 12 cf,
// 16 ev, 20 bacc, 24 rawA, 28 drop, 32 postR, 36 retR, 40 exile,
// 44 recover, 48 cold_drop, 52 cold_cost
fn run_cond(M:[]u8,OB:[]u8,pol:i32,chw:i32,mode:i32,tag:[]u8,R:[]u8,ro:i32,rr:i32,mw:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  if(mode==0){teach_churn(M,chw);}
  if(rr==1){churn_multi_reread(M,mode,21);}
  if(rr==0){
    if(mode==1){teach_churn_multi(M,1,mw);}
    if(mode==2){teach_churn_multi(M,2,mw);}
    if(mode==3){teach_churn_multi(M,3,mw);}
  }
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let postR:i32=test_A_recov(M,1);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ex:i32=ig(M,40);
  let rc:i32=ig(M,44);
  let cd:i32=ig(M,48);
  let cc:i32=ig(M,52);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  let retR:i32=0;
  if(pre>0){retR=(100*postR)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr); put32(R,ro+32,postR);
  put32(R,ro+36,retR); put32(R,ro+40,ex); put32(R,ro+44,rc);
  put32(R,ro+48,cd); put32(R,ro+52,cc);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," mode="); e1i(OB,mode as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  if(rr==1){e1s(OB," reread=1");}
  if(mw!=21){e1s(OB," mw="); e1i(OB,mw as i64);}
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB," postR="); e1i(OB,postR as i64);
  e1s(OB," retR="); e1i(OB,retR as i64);
  e1s(OB," exile="); e1i(OB,ex as i64);
  e1s(OB," recover="); e1i(OB,rc as i64);
  e1s(OB," cdrop="); e1i(OB,cd as i64);
  e1s(OB," ccost="); e1i(OB,cc as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(16384);
  put32(OB,0,0);
  let R:[]u8=z_alloc(2048);
  e1s(OB,"LANE=RECLAMATION-H2\n");
  run_cond(M,OB,0,1,0,"COND=EXFIFO-B0",R,0,0,21);
  run_cond(M,OB,0,21,0,"COND=EXFIFO-A20",R,56,0,21);
  run_cond(M,OB,0,33,0,"COND=EXFIFO-A32",R,112,0,21);
  run_cond(M,OB,1,1,0,"COND=EXPART-B0",R,168,0,21);
  run_cond(M,OB,1,21,0,"COND=EXPART-A20",R,224,0,21);
  run_cond(M,OB,1,33,0,"COND=EXPART-A32",R,280,0,21);
  run_cond(M,OB,4,1,0,"COND=EXLRU-B0",R,336,0,21);
  run_cond(M,OB,4,21,0,"COND=EXLRU-A20",R,392,0,21);
  run_cond(M,OB,4,33,0,"COND=EXLRU-A32",R,448,0,21);
  run_cond(M,OB,3,21,1,"COND=EXPIN-M2",R,504,0,21);
  run_cond(M,OB,3,21,2,"COND=EXPIN-M3",R,560,0,21);
  run_cond(M,OB,3,21,3,"COND=EXPIN-X2",R,616,0,21);
  run_cond(M,OB,5,1,0,"COND=EXCON-B0",R,672,0,21);
  run_cond(M,OB,5,21,0,"COND=EXCON-A20",R,728,0,21);
  run_cond(M,OB,5,33,0,"COND=EXCON-A32",R,784,0,21);
  run_cond(M,OB,5,21,1,"COND=EXCON-M2",R,840,0,21);
  run_cond(M,OB,5,21,2,"COND=EXCON-M3",R,896,0,21);
  run_cond(M,OB,5,21,3,"COND=EXCON-X2",R,952,0,21);
  run_cond(M,OB,6,1,0,"COND=EXH2-B0",R,1008,0,21);
  run_cond(M,OB,6,21,0,"COND=EXH2-A20",R,1064,0,21);
  run_cond(M,OB,6,33,0,"COND=EXH2-A32",R,1120,0,21);
  run_cond(M,OB,6,21,1,"COND=EXH2-M2",R,1176,0,21);
  run_cond(M,OB,6,21,2,"COND=EXH2-M3",R,1232,0,21);
  run_cond(M,OB,6,21,3,"COND=EXH2-X2",R,1288,0,21);
  run_cond(M,OB,6,21,1,"COND=EXH2R-M2",R,1344,1,21);
  run_cond(M,OB,6,51,2,"COND=EXH2-OVF",R,1400,0,51);
  // K1 ANCHOR-FIFO: frozen FIFO rows + frozen new columns
  let k1:i32=1;
  if(ig(R,0)!=35 || ig(R,4)!=35 || ig(R,8)!=100){k1=0;}
  if(ig(R,12)!=20 || ig(R,16)!=0 || ig(R,28)!=0){k1=0;}
  if(ig(R,20)!=20 || ig(R,24)!=35){k1=0;}
  if(ig(R,32)!=35 || ig(R,36)!=100){k1=0;}
  if(ig(R,40)!=0 || ig(R,44)!=0 || ig(R,48)!=0 || ig(R,52)!=0){k1=0;}
  if(ig(R,56)!=35 || ig(R,60)!=19 || ig(R,64)!=54){k1=0;}
  if(ig(R,68)!=40 || ig(R,72)!=8 || ig(R,84)!=0){k1=0;}
  if(ig(R,76)!=20 || ig(R,80)!=27){k1=0;}
  if(ig(R,88)!=35 || ig(R,92)!=100){k1=0;}
  if(ig(R,96)!=8 || ig(R,100)!=28 || ig(R,104)!=0 || ig(R,108)!=124){k1=0;}
  if(ig(R,112)!=35 || ig(R,116)!=0 || ig(R,120)!=0){k1=0;}
  if(ig(R,124)!=52 || ig(R,128)!=20 || ig(R,140)!=0){k1=0;}
  if(ig(R,132)!=20 || ig(R,136)!=15){k1=0;}
  if(ig(R,144)!=35 || ig(R,148)!=100){k1=0;}
  if(ig(R,152)!=20 || ig(R,156)!=60 || ig(R,160)!=0 || ig(R,164)!=575){k1=0;}
  e1s(OB,"K1 ANCHOR-FIFO -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  // K2 ANCHOR-PART: frozen PART rows + frozen new columns
  let k2:i32=1;
  if(ig(R,168)!=35 || ig(R,172)!=27 || ig(R,176)!=77){k2=0;}
  if(ig(R,180)!=20 || ig(R,184)!=4 || ig(R,196)!=0){k2=0;}
  if(ig(R,188)!=20 || ig(R,192)!=31){k2=0;}
  if(ig(R,200)!=35 || ig(R,204)!=100){k2=0;}
  if(ig(R,208)!=4 || ig(R,212)!=14 || ig(R,216)!=0 || ig(R,220)!=34){k2=0;}
  if(ig(R,224)!=35 || ig(R,228)!=27 || ig(R,232)!=77){k2=0;}
  if(ig(R,236)!=40 || ig(R,240)!=8 || ig(R,252)!=0){k2=0;}
  if(ig(R,244)!=20 || ig(R,248)!=31){k2=0;}
  if(ig(R,256)!=35 || ig(R,260)!=100){k2=0;}
  if(ig(R,264)!=8 || ig(R,268)!=14 || ig(R,272)!=0 || ig(R,276)!=34){k2=0;}
  if(ig(R,280)!=35 || ig(R,284)!=27 || ig(R,288)!=77){k2=0;}
  if(ig(R,292)!=52 || ig(R,296)!=20 || ig(R,308)!=0){k2=0;}
  if(ig(R,300)!=20 || ig(R,304)!=31){k2=0;}
  if(ig(R,312)!=35 || ig(R,316)!=100){k2=0;}
  if(ig(R,320)!=20 || ig(R,324)!=14 || ig(R,328)!=0 || ig(R,332)!=34){k2=0;}
  e1s(OB,"K2 ANCHOR-PART -> "); e1s(OB,pf(k2)); e1s(OB,"\n");
  // K3 ANCHOR-LRU: bit-for-bit equal to FIFO in all 14 columns
  let k3:i32=1;
  let c:i32=0;
  while(c<14){
    if(ig(R,336+c*4)!=ig(R,0+c*4)){k3=0;}
    if(ig(R,392+c*4)!=ig(R,56+c*4)){k3=0;}
    if(ig(R,448+c*4)!=ig(R,112+c*4)){k3=0;}
    c=c+1;
  }
  e1s(OB,"K3 ANCHOR-LRU -> "); e1s(OB,pf(k3)); e1s(OB,"\n");
  // K4 ANCHOR-PIN: frozen PIN rows + frozen new columns
  let k4:i32=1;
  if(ig(R,504)!=35 || ig(R,508)!=35 || ig(R,512)!=100){k4=0;}
  if(ig(R,516)!=60 || ig(R,520)!=0 || ig(R,532)!=28){k4=0;}
  if(ig(R,524)!=20 || ig(R,528)!=35){k4=0;}
  if(ig(R,536)!=35 || ig(R,540)!=100){k4=0;}
  if(ig(R,544)!=28 || ig(R,548)!=0 || ig(R,552)!=0 || ig(R,556)!=0){k4=0;}
  if(ig(R,560)!=35 || ig(R,564)!=35 || ig(R,568)!=100){k4=0;}
  if(ig(R,572)!=80 || ig(R,576)!=0 || ig(R,588)!=48){k4=0;}
  if(ig(R,580)!=20 || ig(R,584)!=35){k4=0;}
  if(ig(R,592)!=35 || ig(R,596)!=100){k4=0;}
  if(ig(R,600)!=48 || ig(R,604)!=0 || ig(R,608)!=0 || ig(R,612)!=0){k4=0;}
  if(ig(R,616)!=35 || ig(R,620)!=35 || ig(R,624)!=100){k4=0;}
  if(ig(R,628)!=60 || ig(R,632)!=0 || ig(R,644)!=28){k4=0;}
  if(ig(R,636)!=20 || ig(R,640)!=35){k4=0;}
  if(ig(R,648)!=35 || ig(R,652)!=100){k4=0;}
  if(ig(R,656)!=28 || ig(R,660)!=0 || ig(R,664)!=0 || ig(R,668)!=0){k4=0;}
  e1s(OB,"K4 ANCHOR-PIN -> "); e1s(OB,pf(k4)); e1s(OB,"\n");
  // K5 ANCHOR-CONSENT: frozen consent rows + frozen new columns
  let k5:i32=1;
  if(ig(R,672)!=35 || ig(R,676)!=35 || ig(R,680)!=100){k5=0;}
  if(ig(R,684)!=20 || ig(R,688)!=0 || ig(R,700)!=0){k5=0;}
  if(ig(R,692)!=20 || ig(R,696)!=35){k5=0;}
  if(ig(R,704)!=35 || ig(R,708)!=100){k5=0;}
  if(ig(R,712)!=0 || ig(R,716)!=0 || ig(R,720)!=0 || ig(R,724)!=0){k5=0;}
  if(ig(R,728)!=35 || ig(R,732)!=35 || ig(R,736)!=100){k5=0;}
  if(ig(R,740)!=40 || ig(R,744)!=8 || ig(R,756)!=0){k5=0;}
  if(ig(R,748)!=20 || ig(R,752)!=35){k5=0;}
  if(ig(R,760)!=35 || ig(R,764)!=100){k5=0;}
  if(ig(R,768)!=8 || ig(R,772)!=0 || ig(R,776)!=0 || ig(R,780)!=0){k5=0;}
  if(ig(R,784)!=35 || ig(R,788)!=35 || ig(R,792)!=100){k5=0;}
  if(ig(R,796)!=52 || ig(R,800)!=20 || ig(R,812)!=0){k5=0;}
  if(ig(R,804)!=20 || ig(R,808)!=35){k5=0;}
  if(ig(R,816)!=35 || ig(R,820)!=100){k5=0;}
  if(ig(R,824)!=20 || ig(R,828)!=0 || ig(R,832)!=0 || ig(R,836)!=0){k5=0;}
  if(ig(R,840)!=35 || ig(R,844)!=35 || ig(R,848)!=100){k5=0;}
  if(ig(R,852)!=60 || ig(R,856)!=11 || ig(R,868)!=17){k5=0;}
  if(ig(R,860)!=20 || ig(R,864)!=35){k5=0;}
  if(ig(R,872)!=35 || ig(R,876)!=100){k5=0;}
  if(ig(R,880)!=28 || ig(R,884)!=0 || ig(R,888)!=0 || ig(R,892)!=0){k5=0;}
  if(ig(R,896)!=35 || ig(R,900)!=35 || ig(R,904)!=100){k5=0;}
  if(ig(R,908)!=80 || ig(R,912)!=5 || ig(R,924)!=43){k5=0;}
  if(ig(R,916)!=20 || ig(R,920)!=35){k5=0;}
  if(ig(R,928)!=35 || ig(R,932)!=100){k5=0;}
  if(ig(R,936)!=48 || ig(R,940)!=0 || ig(R,944)!=0 || ig(R,948)!=0){k5=0;}
  if(ig(R,952)!=35 || ig(R,956)!=35 || ig(R,960)!=100){k5=0;}
  if(ig(R,964)!=60 || ig(R,968)!=0 || ig(R,980)!=28){k5=0;}
  if(ig(R,972)!=20 || ig(R,976)!=35){k5=0;}
  if(ig(R,984)!=35 || ig(R,988)!=100){k5=0;}
  if(ig(R,992)!=28 || ig(R,996)!=0 || ig(R,1000)!=0 || ig(R,1004)!=0){k5=0;}
  e1s(OB,"K5 ANCHOR-CONSENT -> "); e1s(OB,pf(k5)); e1s(OB,"\n");
  // K6 H2-HOT-COLLAPSE: hot columns bit-for-bit the frozen liveness rows
  let k6:i32=1;
  if(ig(R,1008)!=35 || ig(R,1012)!=35 || ig(R,1016)!=100){k6=0;}
  if(ig(R,1020)!=20 || ig(R,1024)!=0 || ig(R,1036)!=0){k6=0;}
  if(ig(R,1028)!=20 || ig(R,1032)!=35){k6=0;}
  if(ig(R,1064)!=35 || ig(R,1068)!=19 || ig(R,1072)!=54){k6=0;}
  if(ig(R,1076)!=40 || ig(R,1080)!=8 || ig(R,1092)!=0){k6=0;}
  if(ig(R,1084)!=20 || ig(R,1088)!=27){k6=0;}
  if(ig(R,1120)!=35 || ig(R,1124)!=0 || ig(R,1128)!=0){k6=0;}
  if(ig(R,1132)!=52 || ig(R,1136)!=20 || ig(R,1148)!=0){k6=0;}
  if(ig(R,1140)!=20 || ig(R,1144)!=15){k6=0;}
  if(ig(R,1176)!=35 || ig(R,1180)!=0 || ig(R,1184)!=0){k6=0;}
  if(ig(R,1188)!=60 || ig(R,1192)!=28 || ig(R,1204)!=0){k6=0;}
  if(ig(R,1196)!=20 || ig(R,1200)!=15){k6=0;}
  if(ig(R,1232)!=35 || ig(R,1236)!=0 || ig(R,1240)!=0){k6=0;}
  if(ig(R,1244)!=80 || ig(R,1248)!=48 || ig(R,1260)!=0){k6=0;}
  if(ig(R,1252)!=20 || ig(R,1256)!=15){k6=0;}
  if(ig(R,1288)!=35 || ig(R,1292)!=0 || ig(R,1296)!=0){k6=0;}
  if(ig(R,1300)!=60 || ig(R,1304)!=28 || ig(R,1316)!=0){k6=0;}
  if(ig(R,1308)!=20 || ig(R,1312)!=15){k6=0;}
  e1s(OB,"K6 H2-HOT-COLLAPSE -> "); e1s(OB,pf(k6)); e1s(OB,"\n");
  // K7 H2-RECOV-100: postR=35, retR=100 on all six H2 rows
  let k7:i32=1;
  if(ig(R,1040)!=35 || ig(R,1044)!=100){k7=0;}
  if(ig(R,1096)!=35 || ig(R,1100)!=100){k7=0;}
  if(ig(R,1152)!=35 || ig(R,1156)!=100){k7=0;}
  if(ig(R,1208)!=35 || ig(R,1212)!=100){k7=0;}
  if(ig(R,1264)!=35 || ig(R,1268)!=100){k7=0;}
  if(ig(R,1320)!=35 || ig(R,1324)!=100){k7=0;}
  e1s(OB,"K7 H2-RECOV-100 -> "); e1s(OB,pf(k7)); e1s(OB,"\n");
  // K8 H2-LEDGER: exact (exile, recover, cold_drop, cold_cost)
  let k8:i32=1;
  if(ig(R,1048)!=0 || ig(R,1052)!=0 || ig(R,1056)!=0 || ig(R,1060)!=0){k8=0;}
  if(ig(R,1104)!=8 || ig(R,1108)!=28 || ig(R,1112)!=0 || ig(R,1116)!=124){k8=0;}
  if(ig(R,1160)!=20 || ig(R,1164)!=60 || ig(R,1168)!=0 || ig(R,1172)!=575){k8=0;}
  if(ig(R,1216)!=28 || ig(R,1220)!=60 || ig(R,1224)!=0 || ig(R,1228)!=575){k8=0;}
  if(ig(R,1272)!=48 || ig(R,1276)!=60 || ig(R,1280)!=0 || ig(R,1284)!=575){k8=0;}
  if(ig(R,1328)!=28 || ig(R,1332)!=60 || ig(R,1336)!=0 || ig(R,1340)!=575){k8=0;}
  e1s(OB,"K8 H2-LEDGER -> "); e1s(OB,pf(k8)); e1s(OB,"\n");
  // K9 H2-REREAD: hot bit-for-bit LIVR-M2; empty recovery ledger
  let k9:i32=1;
  if(ig(R,1344)!=35 || ig(R,1348)!=35 || ig(R,1352)!=100){k9=0;}
  if(ig(R,1356)!=60 || ig(R,1360)!=28 || ig(R,1372)!=0){k9=0;}
  if(ig(R,1364)!=20 || ig(R,1368)!=35){k9=0;}
  if(ig(R,1376)!=35 || ig(R,1380)!=100){k9=0;}
  if(ig(R,1384)!=28 || ig(R,1388)!=0 || ig(R,1392)!=0 || ig(R,1396)!=0){k9=0;}
  e1s(OB,"K9 H2-REREAD -> "); e1s(OB,pf(k9)); e1s(OB,"\n");
  // K10 H2-RECURSION: overflow destroys the cold tier too
  let k10:i32=1;
  if(ig(R,1400)!=35 || ig(R,1404)!=0 || ig(R,1408)!=0){k10=0;}
  if(ig(R,1412)!=170 || ig(R,1416)!=138 || ig(R,1428)!=0){k10=0;}
  if(ig(R,1420)!=20 || ig(R,1424)!=15){k10=0;}
  if(ig(R,1432)!=0 || ig(R,1436)!=0){k10=0;}
  if(ig(R,1440)!=138 || ig(R,1444)!=0 || ig(R,1448)!=74 || ig(R,1452)!=3200){k10=0;}
  e1s(OB,"K10 H2-RECURSION -> "); e1s(OB,pf(k10)); e1s(OB,"\n");
  // K11 NO-HOT-DESTRUCTION: exile == ev + drop everywhere;
  // cold_drop == 0 except OVF
  let k11:i32=1;
  let ro:i32=0;
  while(ro<1456){
    if(ig(R,ro+40)!=ig(R,ro+16)+ig(R,ro+28)){k11=0;}
    if(ro!=1400 && ig(R,ro+48)!=0){k11=0;}
    ro=ro+56;
  }
  e1s(OB,"K11 NO-HOT-DESTRUCTION -> "); e1s(OB,pf(k11)); e1s(OB,"\n");
  // K12 ADV-FIXED: conflicts identical across policies per dose
  let k12:i32=1;
  if(ig(R,12)!=20 || ig(R,180)!=20){k12=0;}
  if(ig(R,348)!=20 || ig(R,684)!=20 || ig(R,1020)!=20){k12=0;}
  if(ig(R,68)!=40 || ig(R,236)!=40){k12=0;}
  if(ig(R,404)!=40 || ig(R,740)!=40 || ig(R,1076)!=40){k12=0;}
  if(ig(R,124)!=52 || ig(R,292)!=52){k12=0;}
  if(ig(R,460)!=52 || ig(R,796)!=52 || ig(R,1132)!=52){k12=0;}
  if(ig(R,516)!=60 || ig(R,852)!=60){k12=0;}
  if(ig(R,1188)!=60 || ig(R,1356)!=60){k12=0;}
  if(ig(R,628)!=60 || ig(R,964)!=60 || ig(R,1300)!=60){k12=0;}
  if(ig(R,572)!=80 || ig(R,908)!=80 || ig(R,1244)!=80){k12=0;}
  if(ig(R,1412)!=170){k12=0;}
  e1s(OB,"K12 ADV-FIXED -> "); e1s(OB,pf(k12)); e1s(OB,"\n");
  e1s(OB,"K13 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1){all=1;}
  if(k7==0 || k8==0 || k9==0 || k10==0 || k11==0 || k12==0){all=0;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

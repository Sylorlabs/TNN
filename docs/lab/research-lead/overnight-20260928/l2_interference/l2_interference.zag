// l2_interference.zag -- L2-INTERFERENCE clean restart.
// Self-contained continuing-learner interference test. Pure Zag.
// A shared content-addressed memory holds L2-adapted structures
// (EXTEND / SPECIALIZE / TRUNCATE of a base chain, plus an
// interface-adapted structure B whose conflicting writes are value
// SUBSTITUTIONs on shared content keys). A conflict-relocation policy
// (finite circular overflow pool) is the mechanism under test.
// Protocol per condition: teach A, pre-test, teach B, post-test.
// See PREREG.md for the frozen design and kill bars.
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
// header: 0 ov_ptr, 4 conflicts, 8 evictions, 12 table_full_errors
// primary: 64, 128 slots x 16 bytes (key, val, owners, used)
// overflow: 2112, 8 slots x 16 bytes
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Relocate the existing entry.
      let op:i32=ig(M,0);
      let oo:i32=soff(2112,op);
      if(ig(M,oo+12)==1){put32(M,8,ig(M,8)+1);}
      put32(M,oo,ig(M,so)); put32(M,oo+4,vv);
      put32(M,oo+8,ig(M,so+8)); put32(M,oo+12,1);
      put32(M,0,(op+1)%8);
      put32(M,4,ig(M,4)+1);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let o:i32=0;
  while(o<8){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- structures ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template. cond: 0 null, 1 partial, 2 full.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      let ov:i32=0;
      if(cond==2){ov=1;}
      if(cond==1){
        if(i==1 && hop<=2){ov=1;}
        if(i==2 && hop<=2){ov=1;}
        if(i==3 && hop==1){ov=1;}
      }
      if(ov==1){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      let ov:i32=0;
      if(cond==2){ov=1;}
      if(cond==1){
        if(i==1 && hop<=2){ov=1;}
        if(i==2 && hop<=2){ov=1;}
        if(i==3 && hop==1){ov=1;}
      }
      if(ov==1){k=1000+i*10+hop;v=777000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// R layout per condition (24 bytes): 0 pre, 4 post, 8 ret, 12 conflicts, 16 evict, 20 bacc
fn run_cond(M:[]u8,OB:[]u8,multi:i32,cond:i32,tag:[]u8,R:[]u8,ro:i32)void {
  mem_zero(M);
  teach_A(M,multi);
  let pre:i32=test_A(M,multi);
  teach_B(M,cond);
  let post:i32=test_A(M,multi);
  let bacc:i32=test_B(M,cond);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  e1s(OB,tag);
  e1s(OB," multi="); e1i(OB,multi as i64);
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(8192);
  put32(OB,0,0);
  let R:[]u8=z_alloc(128);
  e1s(OB,"LANE=L2-INTERFERENCE CLEAN RESTART\n");
  run_cond(M,OB,1,0,"COND=NULL",R,0);
  run_cond(M,OB,1,1,"COND=PARTIAL",R,24);
  run_cond(M,OB,1,2,"COND=FULL",R,48);
  run_cond(M,OB,0,1,"COND=PARTIAL-SINGLE",R,72);
  let k1:i32=0;
  if(ig(R,0)==35 && ig(R,24)==35 && ig(R,48)==35 && ig(R,72)==10){k1=1;}
  e1s(OB,"K1 BASELINE pre=[");
  e1i(OB,ig(R,0) as i64); e1s(OB,","); e1i(OB,ig(R,24) as i64);
  e1s(OB,","); e1i(OB,ig(R,48) as i64); e1s(OB,","); e1i(OB,ig(R,72) as i64);
  e1s(OB,"] need=[35,35,35,10] -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  let k2:i32=0;
  if(ig(R,32)>=90){k2=1;}
  e1s(OB,"K2 MAIN partial_multi ret="); e1i(OB,ig(R,32) as i64);
  e1s(OB," bar>=90 -> "); e1s(OB,pf(k2)); e1s(OB,"\n");
  let k3:i32=0;
  if(ig(R,8)==100){k3=1;}
  e1s(OB,"K3 NULL ret="); e1i(OB,ig(R,8) as i64);
  e1s(OB," bar==100 -> "); e1s(OB,pf(k3)); e1s(OB,"\n");
  let k4:i32=0;
  if(ig(R,56)<=75){k4=1;}
  e1s(OB,"K4 SENSITIVITY full ret="); e1i(OB,ig(R,56) as i64);
  e1s(OB," bar<=75 -> "); e1s(OB,pf(k4)); e1s(OB,"\n");
  let k6:i32=0;
  let d:i32=ig(R,32)-ig(R,80);
  if(d<0){d=-d;}
  if(ig(R,80)>=90 && d<=10){k6=1;}
  e1s(OB,"K6 ABLATION single_partial ret="); e1i(OB,ig(R,80) as i64);
  e1s(OB," diff="); e1i(OB,d as i64);
  e1s(OB," bars>=90,diff<=10 -> "); e1s(OB,pf(k6)); e1s(OB,"\n");
  e1s(OB,"K5 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k6==1){all=1;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0; i=i+1;}
  return b;
}
fn main()i32 {
  let b:[]u8=z_alloc(64);
  let s:[]u8="HELLO";
  let i:i32=0; while(i<s.len){b[i]=s[i]; i=i+1;}
  b[5]=10;
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),6 as i64,0,0,0);
  _zag_print("AFTER\n");
  return 0;
}

// drv_fx1.zag -- FX1 collision sweep + FX2 regression trace driver.
// APPENDED to a base (control or fixed). Uses ONLY the API common to both
// engines, so the same source produces the control arm and the fixed arm of
// every comparison.
//
// OUTPUT PATH (infra finding): the mandated house style is "format into one
// preallocated buffer, then write with a single _zag_raw_syscall". On this
// host _zag_raw_syscall returns -78 (ENOSYS) for EVERY syscall number probed
// (1/116/266/528) and emits nothing; see p5.zag. All dynamic content is
// therefore formatted into ONE buffer and written ONCE with _zag_write_file,
// the nearest working equivalent. The "one buffered write" discipline holds.
//
// Two interleaved streams, so the regression comparison is exact:
//   TRACE <k> <v>   observable API return values, in call order
//   STAT  <k> <v>   internal counters (may legitimately differ between arms)
// The regression bar (prereg P3/K1) is byte-identity of TRACE lines only.
//
// One workspace is allocated and reused (tnn2_init fully re-zeroes it), so the
// sweep does not depend on heap growth over 21 x 110 KiB allocations.

// (z_alloc/get32/set32/ng/ns/hg/WSZ/NN are provided by the base.)
fn d_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){neg=1; x=0-x;}
  let n:i32=1; let t:i64=x;
  while(t>=10){t=t/10; n=n+1;}
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(neg==1){b[c]=45;}
  return e;
}
fn d_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){b[c+i]=s[i]; i=i+1;} return c+s.len;
}
fn d_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn d_kv(b:[]u8,c:i32,key:[]u8,v:i32)i32 {
  c=d_app(b,c,key); c=d_app(b,c," ");
  c=d_i64(b,c,v as i64); return d_nl(b,c);
}
fn d_bool(x:i32)i32 { if(x==1){return 1;} return 0; }
fn d_eq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn d_atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0;
  while(i<s.len){ let d:i32=(s[i] as i32)-48; if(d<0 || d>9){return v;} v=v*10+d; i=i+1; }
  return v;
}
fn d_maxid(W:[]u8)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<NN()){ if(ng(W,n,36)==1){ if(n>m){m=n;} } n=n+1; }
  return m;
}
// LEGACY POSITIONAL AUDITOR (prereg P4). The frozen partition rule was
// "operand >= 1000 means frame slot". In the frozen layout the only fields that
// ever held a NODE-ID operand were f8 of tags 101 and 102 (a trial literal),
// while f4 of tags 101/103/104 and the root output always carried the
// 1000+slot tag base. So the legacy violation set is exactly: live ISA cells
// whose f8 >= 1000. Each such word is one the frozen decoder silently
// reinterpreted as a frame slot.
fn d_legacy_audit(W:[]u8,rep:[]u8)i32 {
  let cells:i32=0; let v:i32=0;
  let fnode:i32=-1; let fword:i32=0;
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1){
      let t:i32=ng(W,n,0);
      if(t>=101 && t<=104){
        cells=cells+1;
        let w:i32=ng(W,n,8);
        if(w>=1000){
          v=v+1;
          if(fnode<0){fnode=n; fword=w;}
        }
      }
    }
    n=n+1;
  }
  set32(rep,0,v); set32(rep,4,cells); set32(rep,8,fnode); set32(rep,12,fword);
  return v;
}
fn d_repget(rep:[]u8,slot:i32)i32 { return get32(rep,slot*4); }

// ---- cell-level probe (engine-agnostic: reads only ng) ----
fn d_probe(W:[]u8,b:[]u8,c:i32)i32 {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1){
      let t:i32=ng(W,n,0);
      if(t>=101 && t<=104){
        c=d_app(b,c,"CELL ");
        c=d_i64(b,c,n as i64);
        c=d_app(b,c," tag="); c=d_i64(b,c,t as i64);
        c=d_app(b,c," f4="); c=d_i64(b,c,ng(W,n,4) as i64);
        c=d_app(b,c," f8="); c=d_i64(b,c,ng(W,n,8) as i64);
        c=d_app(b,c," f12="); c=d_i64(b,c,ng(W,n,12) as i64);
        c=d_app(b,c," f16="); c=d_i64(b,c,ng(W,n,16) as i64);
        c=d_app(b,c," f20="); c=d_i64(b,c,ng(W,n,20) as i64);
        c=d_app(b,c," f24="); c=d_i64(b,c,ng(W,n,24) as i64);
        c=d_nl(b,c);
      }
    }
    n=n+1;
  }
  return c;
}

// ---- FX1: one collision-sweep point ----
fn d_fx1(W:[]u8,rep:[]u8,F:i32,b:[]u8,c:i32)i32 {
  tnn2_init(W);
  let i:i32=0;
  while(i<F){ ev_teach(W,30000+i,77,i); i=i+1; }
  ev_teach(W,101,11,102);
  ev_teach(W,102,12,201);
  let a:i32=ev_query(W,101,40,201,0);
  c=d_app(b,c,"TRACE fx1_ans "); c=d_i64(b,c,a as i64); c=d_nl(b,c);
  c=d_kv(b,c,"STAT F",F);
  c=d_kv(b,c,"STAT ans",a);
  c=d_kv(b,c,"STAT correct",d_bool(a==201));
  c=d_kv(b,c,"STAT live",hg(W,20));
  c=d_kv(b,c,"STAT maxid",d_maxid(W));
  c=d_kv(b,c,"STAT edges",hg(W,24));
  c=d_kv(b,c,"STAT faults",hg(W,52));
  c=d_kv(b,c,"STAT faultnode",hg(W,56));
  c=d_kv(b,c,"STAT faultcode",hg(W,60));
  c=d_kv(b,c,"STAT tried",hg(W,16)/1024);
  c=d_kv(b,c,"STAT rejected",hg(W,16)-((hg(W,16)/1024)*1024));
  let lv:i32=d_legacy_audit(W,rep);
  c=d_kv(b,c,"STAT legacy_cells",d_repget(rep,1));
  c=d_kv(b,c,"STAT legacy_viol",lv);
  c=d_kv(b,c,"STAT legacy_node",d_repget(rep,2));
  c=d_kv(b,c,"STAT legacy_word",d_repget(rep,3));
  return c;
}

// ---- FX2: regression trace ----
fn d_fx2(b:[]u8,c:i32)i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  c=d_kv(b,c,"TRACE fx2_cold",ev_query(W,1,40,5,0));
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  c=d_kv(b,c,"TRACE fx2_chain4",ev_query(W,1,40,5,0));
  c=d_kv(b,c,"TRACE fx2_again",ev_query(W,1,40,-2,0));
  let W2:[]u8=z_alloc(WSZ()); tnn2_init(W2);
  ev_teach(W2,110,31,10); ev_teach(W2,110,32,20); ev_teach(W2,110,33,30);
  let cn:i32=alloc_node(W2); ns(W2,cn,0,8); write_node(W2,cn,1,0,0,0);
  c=d_kv(b,c,"TRACE fx2_sum",ev_query(W2,110,41,60,0));
  let W3:[]u8=z_alloc(WSZ()); tnn2_init(W3);
  ev_teach(W3,101,21,102); ev_teach(W3,101,22,106); ev_teach(W3,102,22,103);
  c=d_kv(b,c,"TRACE fx2_branch",ev_query(W3,101,42,103,0));
  let W4:[]u8=z_alloc(WSZ()); tnn2_init(W4);
  ev_teach(W4,101,11,102); ev_teach(W4,102,12,201);
  c=d_kv(b,c,"TRACE fx2_rev_before",ev_query(W4,101,40,201,0));
  c=d_kv(b,c,"TRACE fx2_observe",ev_observe(W4,102,12,999));
  c=d_kv(b,c,"TRACE fx2_rev_after",ev_query(W4,101,40,-2,0));
  let W5:[]u8=z_alloc(WSZ()); tnn2_init(W5);
  let i:i32=0;
  while(i<40){ev_teach(W5,1000+i,1,i*7+3); i=i+1;}
  let ok:i32=1; i=0;
  while(i<40){ if(ev_query(W5,1000+i,1,-2,0)!=i*7+3){ok=0;} i=i+1; }
  c=d_kv(b,c,"TRACE fx2_exact40",ok);
  return c;
}

fn d_sweep(fs:[]u8,lo:i32,hi:i32)i32 {
  let n:i32=0;
  let i:i32=lo;
  while(i<=hi){ set32(fs,n*4,i); n=n+1; i=i+1; }
  return n;
}

fn main()i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  let out:[]u8="ns_drv_out.txt";
  let mode:[]u8="";
  if(_zag_argc()>1){mode=_zag_arg(1);}
  let W:[]u8=z_alloc(WSZ());
  let rep:[]u8=z_alloc(64);
  if(W.len<WSZ()){ _zag_write_file(out,b[0..d_app(b,0,"INFRA malloc workspace FAILED\n")]); return 1; }
  if(d_eq(mode,"fx2")){
    c=d_fx2(b,c);
    _zag_write_file(out,b[0..c]);
    return 0;
  }
  if(d_eq(mode,"fx1")){
    let F:i32=d_atoi(_zag_arg(2));
    c=d_fx1(W,rep,F,b,c);
    _zag_write_file(out,b[0..c]);
    return 0;
  }
  if(d_eq(mode,"probe")){
    let F:i32=d_atoi(_zag_arg(2));
    tnn2_init(W);
    let i:i32=0;
    while(i<F){ ev_teach(W,30000+i,77,i); i=i+1; }
    c=d_kv(b,c,"STAT F",F);
    c=d_kv(b,c,"STAT live_after_fill",hg(W,20));
    c=d_kv(b,c,"STAT maxid_after_fill",d_maxid(W));
    ev_teach(W,101,11,102);
    ev_teach(W,102,12,201);
    c=d_kv(b,c,"STAT live_after_facts",hg(W,20));
    let a:i32=ev_query(W,101,40,201,0);
    c=d_kv(b,c,"STAT ans",a);
    c=d_kv(b,c,"STAT tried",hg(W,16)/1024);
    c=d_kv(b,c,"STAT rejected",hg(W,16)-((hg(W,16)/1024)*1024));
    c=d_probe(W,b,c);
    _zag_write_file(out,b[0..c]);
    return 0;
  }
  // default: dense sweep across the whole 0..NN()-1 filler range in steps of
  // 1 near the predicted collision and coarser below it.
  let fs:[]u8=z_alloc(4096);
  let n:i32=0;
  n=d_add(fs,n,0); n=d_add(fs,n,50); n=d_add(fs,n,100); n=d_add(fs,n,200);
  n=d_add(fs,n,300); n=d_add(fs,n,400); n=d_add(fs,n,500); n=d_add(fs,n,600);
  n=d_add(fs,n,700); n=d_add(fs,n,800); n=d_add(fs,n,850); n=d_add(fs,n,900);
  n=d_add(fs,n,920); n=d_add(fs,n,940); n=d_add(fs,n,950); n=d_add(fs,n,960);
  n=d_add(fs,n,970); n=d_add(fs,n,975); n=d_add(fs,n,980); n=d_add(fs,n,985);
  n=d_add(fs,n,988); n=d_add(fs,n,989); n=d_add(fs,n,990); n=d_add(fs,n,991);
  n=d_add(fs,n,992); n=d_add(fs,n,993); n=d_add(fs,n,994); n=d_add(fs,n,995);
  n=d_add(fs,n,996); n=d_add(fs,n,997); n=d_add(fs,n,998); n=d_add(fs,n,999);
  n=d_add(fs,n,1000); n=d_add(fs,n,1001); n=d_add(fs,n,1002); n=d_add(fs,n,1005);
  let i:i32=0;
  while(i<n){
    let F:i32=get32(fs,i*4);
    c=d_fx1(W,rep,F,b,c);
    i=i+1;
  }
  c=d_fx2(b,c);
  _zag_write_file(out,b[0..c]);
  return 0;
}
fn d_add(fs:[]u8,n:i32,v:i32)i32 { set32(fs,n*4,v); return n+1; }

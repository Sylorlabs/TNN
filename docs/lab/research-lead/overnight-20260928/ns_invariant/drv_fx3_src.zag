// drv_fx3.zag -- invariant battery driver. APPENDED to the FIXED engine only
// (it calls ns_audit / ns_tagcheck, which the frozen control does not have).
//
//   A. ns_audit over clean workspaces across the whole filler range, including
//      the collision region. Must report 0 violations and fault count 0.
//   B. ns_tagcheck: the declared opcode and node-type tables must be disjoint.
//   C. FX3 corruption injection: independent single-word corruptions. The
//      battery must DETECT each one (prereg P5/K3) and the hot path must turn
//      each into FAULT (-999998) rather than an answer or a decline.
//      C4 re-creates the tag-102 collision the frozen ACT port had, to show the
//      battery would have caught it.

fn d_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){neg=1; x=0-x;}
  let n:i32=1; let t:i64=x;
  while(t>=10){t=t/10; n=n+1;}
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(neg==1){b[c]=45;}
  return e;
}
fn d_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){b[c+i]=s[i]; i=i+1;} return c+s.len;
}
fn d_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn d_kv(b:[]u8,c:i32,key:[]u8,v:i32)i32 {
  c=d_app(b,c,key); c=d_app(b,c," ");
  c=d_i64(b,c,v as i64); return d_nl(b,c);
}
fn d_rep(rep:[]u8,slot:i32)i32 { return get32(rep,slot*4); }
fn d_maxid(W:[]u8)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<NN()){ if(ng(W,n,36)==1){ if(n>m){m=n;} } n=n+1; }
  return m;
}
fn d_a(b:[]u8,c:i32,k:[]u8,v:i64)i32 {
  c=d_app(b,c,k); c=d_app(b,c,"="); c=d_i64(b,c,v); return c;
}
fn d_line(b:[]u8,c:i32) i32 { return d_nl(b,c); }

// build the FX1 collision fixture; leaves the workspace populated
fn d_build(W:[]u8,F:i32)i32 {
  tnn2_init(W);
  let i:i32=0;
  while(i<F){ ev_teach(W,30000+i,77,i); i=i+1; }
  ev_teach(W,101,11,102);
  ev_teach(W,102,12,201);
  return ev_query(W,101,40,201,0);
}
fn d_maproot(W:[]u8)i32 {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==40){return ng(W,n,20);}
    n=n+1;
  }
  return -1;
}
fn d_find_setcell(W:[]u8)i32 {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1 && ng(W,n,0)==OP_MOVE() && ng(W,n,20)==K_LIT()){return n;}
    n=n+1;
  }
  return -1;
}
fn d_find_guard(W:[]u8)i32 {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1 && ng(W,n,0)==OP_BEQ()){return n;}
    n=n+1;
  }
  return -1;
}
fn d_find_fact(W:[]u8,s:i32)i32 {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1 && ng(W,n,0)==T_FACT() && ng(W,n,20)==s){return n;}
    n=n+1;
  }
  return -1;
}
// one corruption case: run the battery, then run the hot path.
fn d_case(W:[]u8,rep:[]u8,b:[]u8,c:i32,tag:[]u8,F:i32,mode:i32)i32 {
  let ans:i32=d_build(W,F);
  let root:i32=d_maproot(W);
  let cell:i32=d_find_setcell(W);
  let guard:i32=d_find_guard(W);
  if(mode==1){ ns(W,cell,24,d_find_fact(W,101)); }              // lit -> a FACT node
  if(mode==2){ ns(W,cell,20,7); }                             // kind -> 7
  if(mode==3){ let l:i32=ng(W,cell,24); ns(W,l,36,0); }       // lit -> freed node
  if(mode==4){ let g:i32=alloc_node(W); ns(W,g,0,102); ns(W,g,4,900); ns(W,g,36,1); }
  if(mode==5){ ns(W,cell,28,5); ns(W,cell,32,5); }            // stray word in OUT
  if(mode==6){ ns(W,guard,12,d_find_fact(W,101)); }           // target -> a FACT
  if(mode==7){ ns(W,cell,24,-5); }                           // literal id < 0
  let v:i32=ns_audit(W,rep);
  c=d_app(b,c,tag);
  c=d_a(b,c," ans",ans as i64);
  c=d_a(b,c," cell",cell as i64);
  c=d_a(b,c," lit",ng(W,cell,24) as i64);
  c=d_a(b,c," littag",ng(W,ng(W,cell,24),0) as i64);
  c=d_a(b,c," litlive",ng(W,ng(W,cell,24),36) as i64);
  c=d_a(b,c," audit_viol",v as i64);
  c=d_a(b,c," code",d_rep(rep,2) as i64);
  c=d_a(b,c," node",d_rep(rep,1) as i64);
  c=d_a(b,c," faults_before",hg(W,52) as i64);
  let ex:i32=t2_exec(W,root,101);
  c=d_a(b,c," exec",ex as i64);
  c=d_a(b,c," faults_after",hg(W,52) as i64);
  c=d_a(b,c," faultnode",hg(W,56) as i64);
  c=d_a(b,c," faultcode",hg(W,60) as i64);
  return d_nl(b,c);
}
fn main()i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  let out:[]u8="ns_drv_out.txt";
  let W:[]u8=z_alloc(WSZ());
  let rep:[]u8=z_alloc(64);
  c=d_app(b,c,"LAYOUT");
  c=d_a(b,c," NN",NN() as i64); c=d_a(b,c," NE",NE() as i64);
  c=d_a(b,c," WSZ",WSZ() as i64); c=d_a(b,c," EBASE",EBASE() as i64);
  c=d_a(b,c," LBASE",LBASE() as i64); c=d_line(b,c);
  c=d_a(b,c,"TAGCHECK overlap",ns_tagcheck() as i64); c=d_line(b,c);
  // ---- A. clean audits ----
  let F:[]u8=z_alloc(64);
  let fs:[]u8=z_alloc(64);
  set32(fs,0,0); set32(fs,4,500); set32(fs,8,990); set32(fs,12,991);
  set32(fs,16,1000); set32(fs,20,1005);
  let i:i32=0;
  while(i<6){
    let f:i32=get32(fs,i*4);
    let ans:i32=d_build(W,f);
    let v:i32=ns_audit(W,rep);
    c=d_app(b,c,"CLEAN");
    c=d_a(b,c," F",f as i64);
    c=d_a(b,c," ans",ans as i64);
    c=d_a(b,c," maxid",d_maxid(W) as i64);
    c=d_a(b,c," audit_viol",v as i64);
    c=d_a(b,c," code",d_rep(rep,2) as i64);
    c=d_a(b,c," faults",hg(W,52) as i64);
    c=d_a(b,c," opcells",d_rep(rep,3) as i64);
    c=d_a(b,c," litops",d_rep(rep,5) as i64);
    c=d_a(b,c," slotops",d_rep(rep,4) as i64);
    c=d_a(b,c," targets",d_rep(rep,6) as i64);
    c=d_a(b,c," maproots",d_rep(rep,9) as i64);
    c=d_a(b,c," frames",d_rep(rep,11) as i64);
    c=d_a(b,c," literals",d_rep(rep,12) as i64);
    c=d_a(b,c," nonop",d_rep(rep,13) as i64);
    c=d_a(b,c," edges",d_rep(rep,8) as i64);
    c=d_line(b,c);
    i=i+1;
  }
  // clean audit of the revision / sum / act paths
  tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  ev_query(W,101,40,201,0);
  ev_observe(W,102,12,999);
  ev_query(W,101,40,-2,0);
  ctx_push(W,102); ev_act(W);
  let vr:i32=ns_audit(W,rep);
  c=d_app(b,c,"CLEAN REVISION");
  c=d_a(b,c," audit_viol",vr as i64);
  c=d_a(b,c," code",d_rep(rep,2) as i64);
  c=d_a(b,c," faults",hg(W,52) as i64);
  c=d_a(b,c," maproots",d_rep(rep,9) as i64);
  c=d_line(b,c);
  // ---- C. corruption injection (prereg FX3 / P5 / K3) ----
  c=d_case(W,rep,b,c,"CORRUPT lit_to_fact",0,1);
  c=d_case(W,rep,b,c,"CORRUPT kind_7",0,2);
  c=d_case(W,rep,b,c,"CORRUPT lit_dead",0,3);
  c=d_case(W,rep,b,c,"CORRUPT tag102_guide",0,4);
  c=d_case(W,rep,b,c,"CORRUPT stray_out",0,5);
  c=d_case(W,rep,b,c,"CORRUPT target_fact",0,6);
  // and the same six at a filler count above the frozen collision point
  c=d_case(W,rep,b,c,"CORRUPT991 lit_to_fact",991,1);
  c=d_case(W,rep,b,c,"CORRUPT991 kind_7",991,2);
  c=d_case(W,rep,b,c,"CORRUPT991 lit_dead",991,3);
  c=d_case(W,rep,b,c,"CORRUPT lit_range",0,7);
  c=d_case(W,rep,b,c,"CORRUPT991 lit_range",991,7);
  _zag_write_file(out,b[0..c]);
  return 0;
}

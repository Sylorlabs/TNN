fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0; i=i+1;}
  return b;
}
fn main()i32 {
  let b:[]u8=z_alloc(64);
  let s:[]u8="HELLO-FILE\n";
  let i:i32=0; while(i<s.len){b[i]=s[i]; i=i+1;}
  let p:[]u8="ns_out_probe.txt";
  let w:i32=_zag_write_file(p,b);
  _zag_print("write=");
  _zag_print(_zag_i64_to_str(w as i64));
  _zag_print("\n");
  return 0;
}

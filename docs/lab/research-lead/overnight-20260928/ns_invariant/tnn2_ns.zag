// ---- P-INT4: CAM-1 P6/P7 (spurious rejection, contradiction demotion) ----
fn t_p6()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  ev_teach(W,201,61,301); ev_teach(W,202,61,302); ev_teach(W,203,61,999);

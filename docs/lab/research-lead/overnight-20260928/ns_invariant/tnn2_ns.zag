  total=total+1; if(t_r_pact6()==1){pass=pass+1; tpass("R-PACT6");} else {tfail("R-PACT6");}
  total=total+1; if(t_t2_chain4()==1){pass=pass+1; tpass("T2-CHAIN4");} else {tfail("T2-CHAIN4");}
  total=total+1; if(t_t2_trial_reject()==1){pass=pass+1; tpass("T2-REJECT");} else {tfail("T2-REJECT");}
  total=total+1; if(t_t2_inquire()==1){pass=pass+1; tpass("T2-INQUIRE");} else {tfail("T2-INQUIRE");}
  total=total+1; if(t_t2_actlive()==1){pass=pass+1; tpass("T2-ACTLIVE");} else {tfail("T2-ACTLIVE");}
  total=total+1; if(t_t2_revise()==1){pass=pass+1; tpass("T2-REVISE");} else {tfail("T2-REVISE");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,T_GUIDE()); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<NN()){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<NN()){
          if(ng(W,a,36)==1 && ng(W,a,0)==T_GUIDE() && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<NN()){
    if(ng(W,a,36)==1 && ng(W,a,0)==T_GUIDE()){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<NN()){
    if(ng(W,a,36)==1 && ng(W,a,0)==T_GUIDE()){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<NN()){
    if(ng(W,a,36)==1 && ng(W,a,0)==T_GUIDE()){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<NN()){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,T_GUIDE()); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(WSZ()); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(WSZ()); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}

// ============ INVARIANT BATTERY (charter 166, prereg INV-9) ============
// ns_audit validates EVERY operand word in the workspace against INV-1..INV-7
// and returns the violation count. It is a pure function of the workspace: it
// mutates nothing, so it can be run at any time, from any driver, on any
// workspace, including one that is mid-trial. rep[] receives 16 i32 counters:
//   0 violations   1 first node   2 first code   3 op cells checked
//   4 slot operands validated     5 lit operands validated
//   6 branch targets validated    7 live nodes   8 live edges
//   9 MAP roots w/ declared OUT  10 declared roots  11 frames
//   12 literals   13 non-op live nodes  14 SEQ/DEP edges checked
//   15 unused
fn ns_bit(b:[]u8,i:i32)i32 {
  let k:i32=i/8; let s:i32=i-k*8;
  return ((b[k] as i32)>>s)&1;
}
fn ns_setbit(b:[]u8,i:i32)void {
  let k:i32=i/8; let s:i32=i-k*8;
  b[k]=(((b[k] as i32)|(1<<s)) as u8); return;
}
// report-block accessors. get32/set32 take BYTE offsets, so the 16 report
// counters are strided by 4. The first version of this battery used byte
// offsets 0,1,2,3 as if they were counter slots; the counters overlapped and
// the battery's own output was unreadable. The corruption cases exposed it
// (a violation count of 4 was read back as 67108864).
fn ns_rp(rep:[]u8,k:i32,v:i32)void { set32(rep,k*4,v); return; }
fn ns_rg(rep:[]u8,k:i32)i32 { return get32(rep,k*4); }
fn ns_note(rep:[]u8,code:i32,n:i32)void {
  ns_rp(rep,0,ns_rg(rep,0)+1);
  if(ns_rg(rep,0)==1){ns_rp(rep,1,n); ns_rp(rep,2,code);}
  return;
}
// mark the root of every live MAP. Used only for the "a promoted graph must
// declare its output operand" check; the OUT layout check itself is
// self-describing (a cell that declares an output keeps doing so even after
// its MAP is evicted).
fn ns_mark(W:[]u8,bs:[]u8)void {
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      let r:i32=ng(W,n,20);
      if(r>=2 && r<NN()){ns_setbit(bs,r);}
    }
    n=n+1;
  }
  return;
}
fn ns_cell(W:[]u8,n:i32,maproot:i32,rep:[]u8)void {
  let tag:i32=ng(W,n,0);
  ns_rp(rep,3,ns_rg(rep,3)+1);
  let c:i32=ns_chk(W,n,4,8);              // operand A
  if(c!=FC_NONE()){ns_note(rep,c,n);}
  else {if(ng(W,n,4)==K_SLOT()){ns_rp(rep,4,ns_rg(rep,4)+1);} else {ns_rp(rep,5,ns_rg(rep,5)+1);}}
  // INV-5 destination discipline: MOVE/INC/DEC write the frame.
  if(tag==OP_MOVE() || tag==OP_INC() || tag==OP_DEC()){
    if(ng(W,n,4)!=K_SLOT()){ns_note(rep,FC_DST_KIND(),n);}
  }
  // operand B exists only on MOVE and BEQ.
  if(tag==OP_MOVE() || tag==OP_BEQ()){
    let c2:i32=ns_chk(W,n,20,24);
    if(c2!=FC_NONE()){ns_note(rep,c2,n);}
    else {if(ng(W,n,20)==K_SLOT()){ns_rp(rep,4,ns_rg(rep,4)+1);} else {ns_rp(rep,5,ns_rg(rep,5)+1);}}
  } else {
    // INV-7 closure: no stray words in fields this tag does not own.
    if(ng(W,n,20)!=0 || ng(W,n,24)!=0){ns_note(rep,FC_LAYOUT(),n);}
  }
  // INV-6 branch targets exist only on BEQ, and must be live ISA cells.
  if(tag==OP_BEQ()){
    let t:i32=ng(W,n,12); let f:i32=ng(W,n,16);
    if(t==-1 || t==0){ns_rp(rep,6,ns_rg(rep,6)+1);}
    else {if(is_op(W,t)==1){ns_rp(rep,6,ns_rg(rep,6)+1);} else {ns_note(rep,FC_TGT(),n);}}
    if(f==-1 || f==0){ns_rp(rep,6,ns_rg(rep,6)+1);}
    else {if(is_op(W,f)==1){ns_rp(rep,6,ns_rg(rep,6)+1);} else {ns_note(rep,FC_TGT(),n);}}
  } else {
    if(ng(W,n,12)!=0 || ng(W,n,16)!=0){ns_note(rep,FC_LAYOUT(),n);}
  }
  // output operand: self-declaring at (28,32).
  let decl:i32=0;
  if(ng(W,n,28)!=0 || ng(W,n,32)!=0){decl=1;}
  if(decl==1){
    let c3:i32=ns_chk(W,n,28,32);
    if(c3!=FC_NONE()){ns_note(rep,FC_OUT(),n);}
    else {ns_rp(rep,10,ns_rg(rep,10)+1);}
  }
  if(maproot==1){
    if(decl==0){ns_note(rep,FC_OUT(),n);}
    else {ns_rp(rep,9,ns_rg(rep,9)+1);}
  }
  return;
}
fn ns_audit(W:[]u8,rep:[]u8)i32 {
  let i:i32=0;
  while(i<16){set32(rep,i*4,0); i=i+1;}
  let nb:i32=NN()/8+8;
  let bs:[]u8=z_alloc(nb);
  i=0; while(i<nb){bs[i]=0; i=i+1;}
  ns_mark(W,bs);
  let n:i32=2;
  while(n<NN()){
    if(ng(W,n,36)==1){
      ns_rp(rep,7,ns_rg(rep,7)+1);
      let t:i32=ng(W,n,0);
      if(is_op_tag(t)==1){ns_cell(W,n,ns_bit(bs,n),rep);}
      else {
        ns_rp(rep,13,ns_rg(rep,13)+1);
        if(t==T_LIT()){ns_rp(rep,12,ns_rg(rep,12)+1);}
        if(t==T_FRAME()){ns_rp(rep,11,ns_rg(rep,11)+1);}
        if(t==20){
          let r:i32=ng(W,n,20);
          if(r!=0 && is_op(W,r)==0){ns_note(rep,FC_MAPROOT(),n);}
        }
      }
    }
    n=n+1;
  }
  let e:i32=0;
  while(e<NE()){
    if(eg(W,e,0)!=-1){
      ns_rp(rep,8,ns_rg(rep,8)+1);
      let f:i32=eg(W,e,4); let a:i32=eg(W,e,0); let to:i32=eg(W,e,8);
      if(is_op(W,a)==1 && to>=0){
        ns_rp(rep,14,ns_rg(rep,14)+1);
        if(f==12 && is_op(W,to)==0){ns_note(rep,FC_SEQTGT(),a);}
        if(f==1 && ng(W,to,36)!=1){ns_note(rep,FC_SEQTGT(),a);}
      }
    }
    e=e+1;
  }
  return ns_rg(rep,0);
}
// ns_tagcheck: INV-2/INV-11 as a mechanical check of the DECLARED tables, not
// of the workspace. A node type that ever lands inside [OP_LO,OP_HI] would
// silently become an executable cell; this returns the offending type, or -1.
// This is the check that the frozen engine could not have had: its guide node
// type WAS 102, inside the opcode range.
fn ns_tagcheck()i32 {
  let ts:[]u8=z_alloc(64);
  let c:i32=0;
  set32(ts,c*4,T_FACT()); c=c+1;
  set32(ts,c*4,2); c=c+1;
  set32(ts,c*4,3); c=c+1;
  set32(ts,c*4,4); c=c+1;
  set32(ts,c*4,8); c=c+1;
  set32(ts,c*4,T_MAP()); c=c+1;
  set32(ts,c*4,T_COEFF()); c=c+1;
  set32(ts,c*4,T_UNCERT()); c=c+1;
  set32(ts,c*4,T_LIT()); c=c+1;
  set32(ts,c*4,T_FRAME()); c=c+1;
  set32(ts,c*4,903); c=c+1;
  set32(ts,c*4,900); c=c+1;
  set32(ts,c*4,901); c=c+1;
  set32(ts,c*4,T_GUIDE()); c=c+1;
  let i:i32=0;
  while(i<c){
    if(is_op_tag(get32(ts,i*4))==1){return get32(ts,i*4);}
    i=i+1;
  }
  return -1;
}

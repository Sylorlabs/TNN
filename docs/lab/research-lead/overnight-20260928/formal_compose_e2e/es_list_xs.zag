// es_list_xs.zag -- ARM-LIST for the specialize stack: the original
// unconstrained flat edge store from l2_specialize_xdomain/
// xs_learner.zag, verbatim semantics. 64x4B records @1040, count
// @st[2], NO dedupe on e_add (faithful to xs_edge). es_item_new is
// a no-op. es_raw is the identical append (the bypass probe).
// es_audit counts items on a directed cycle of the read graph
// (here: every recorded edge is visible).
//
// Relies on z_alloc from the learner file.

fn es_item_of(id:i32)i32 {
  if(id>=40){ return 16+(id-40); }
  return id;
}
fn es_item_new(st:[]u8,id:i32)void { return; }
fn e_add(st:[]u8, a:i32, b:i32, ty:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){ return; }
  let o:i32=1040+n*4;
  st[o]=a as u8; st[o+1]=b as u8; st[o+2]=ty as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[1040+i*4+2] as i32)==typ){ c=c+1; }
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1040+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){ return 1; }
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1040+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn ex_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[1040+i*4+2] as i32;
    if(tp!=14){ if(tp!=16){ c=c+1; } }
    i=i+1;
  }
  return c;
}
// es_raw: bypass probe; identical append on LIST.
fn es_raw(st:[]u8, a:i32, b:i32, ty:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){ return; }
  let o:i32=1040+n*4;
  st[o]=a as u8; st[o+1]=b as u8; st[o+2]=ty as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
// ---- read graph over the flat table (all records visible) ----
fn es_ndeps(st:[]u8,it:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if(es_item_of(st[1040+i*4] as i32)==it){ c=c+1; }
    i=i+1;
  }
  return c;
}
fn es_dep_at(st:[]u8,it:i32,k:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if(es_item_of(st[1040+i*4] as i32)==it){
      if(c==k){ return es_item_of(st[1040+i*4+1] as i32); }
      c=c+1;
    }
    i=i+1;
  }
  return -1;
}
// ---- cycle audit (measurement only; identical algorithm all arms) ----
fn es_reach(st:[]u8,x:i32,tgt:i32,vis:[]u8)i32 {
  if(x==tgt){ return 1; }
  if(x<0){ return 0; }
  if(x>=24){ return 0; }
  if((vis[x] as i32)==1){ return 0; }
  vis[x]=1 as u8;
  let n:i32=es_ndeps(st,x);
  let i:i32=0;
  while(i<n){
    if(es_reach(st,es_dep_at(st,x,i),tgt,vis)==1){ return 1; }
    i=i+1;
  }
  return 0;
}
fn es_audit(st:[]u8)i32 {
  let c:i32=0;
  let u:i32=0;
  while(u<24){
    let vis:[]u8=z_alloc(24);
    let nd:i32=es_ndeps(st,u);
    let i:i32=0;
    let on:i32=0;
    while(i<nd){
      if(es_reach(st,es_dep_at(st,u,i),u,vis)==1){ on=1; }
      i=i+1;
    }
    if(on==1){ c=c+1; }
    u=u+1;
  }
  return c;
}

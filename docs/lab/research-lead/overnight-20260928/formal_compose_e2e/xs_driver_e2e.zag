// xs_driver.zag -- L2 SPECIALIZE-XDOMAIN experiment driver.
// Three arms (FULL / GENERAL / ABLATE-X), per-query S/E/ANS capture,
// in-Zag kill-bar evaluation, main + single-syscall stdout flush.
// Query slots: 0=QA 1=QB 2=Q2 3=Q2B 4=Q2C 5=Q2D; 5 i32s each @qi*20
// (S,E,term,val,via). Arm-level @120: spec_nf, @124 fail_n,
// @128 total, @132 nm, @136 ne, @140 t16, @144 ebad.

fn do_q(st:[]u8, res:[]u8, qi:i32, s:i32, t:i32, v:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8, name:[]u8)void {
  xs_query(st,s,t,v,cap,dom,ob,atp);
  let o:i32=qi*20;
  set32(res,o,get32(st,1296));
  set32(res,o+4,get32(st,1300));
  set32(res,o+8,get32(st,1308));
  set32(res,o+12,get32(st,1304));
  set32(res,o+16,get32(st,1312));
  xs_p(ob,atp,"Q ");
  xs_p(ob,atp,name);
  xs_p(ob,atp," S=");
  xs_pi(ob,atp,get32(st,1296));
  xs_p(ob,atp," E=");
  xs_pi(ob,atp,get32(st,1300));
  xs_p(ob,atp," term=");
  xs_pi(ob,atp,get32(st,1308));
  xs_p(ob,atp," val=");
  xs_pi(ob,atp,get32(st,1304));
  xs_p(ob,atp," via=");
  xs_pi(ob,atp,get32(st,1312));
  xs_pnl(ob,atp);
  return;
}
fn arm_close(st:[]u8, res:[]u8)void {
  set32(res,120,st[7] as i32);
  set32(res,124,st[8] as i32);
  set32(res,128,st[9] as i32);
  set32(res,132,st[1] as i32);
  let t14:i32=e_count(st,14);
  let t16:i32=e_count(st,16);
  let oth:i32=ex_eoth(st);
  set32(res,136,t14+t16+oth);
  set32(res,140,t16);
  let bad:i32=0;
  if(oth!=0){ bad=1; }
  set32(res,144,bad);
  return;
}
fn run_arm(ob:[]u8, atp:[]u8, arm:i32, res:[]u8, st:[]u8)void {
  teach_world(st);
  teach_maps(st);
  if(arm==1){ st[3]=0; } else { st[3]=1; }
  if(arm==0){ xs_p(ob,atp,"ARM FULL\n"); }
  if(arm==1){ xs_p(ob,atp,"ARM GENERAL\n"); }
  if(arm==2){ xs_p(ob,atp,"ARM ABLATE-X\n"); }
  do_q(st,res,0,100,43,12,1,1,ob,atp,"QA");
  do_q(st,res,1,50,53,-1,2,2,ob,atp,"QB");
  if(arm==2){
    let b:i32=528+1*32;
    st[b+1]=0;
    st[b+6]=3;
  }
  do_q(st,res,2,50,73,75,1,2,ob,atp,"Q2");
  if(arm==2){ arm_close(st,res); return; }
  do_q(st,res,3,50,73,75,1,2,ob,atp,"Q2B");
  if(arm==1){ arm_close(st,res); return; }
  do_q(st,res,4,50,95,36,1,2,ob,atp,"Q2C");
  do_q(st,res,5,50,72,-1,1,2,ob,atp,"Q2D");
  arm_close(st,res);
  return;
}
fn qf(res:[]u8, qi:i32, f:i32)i32 { return get32(res,qi*20+f*4); }
fn d_bar(ob:[]u8, atp:[]u8, name:[]u8, p:i32)void {
  xs_p(ob,atp,name);
  xs_p(ob,atp,"=");
  if(p==1){ xs_p(ob,atp,"PASS "); } else { xs_p(ob,atp,"FAIL "); }
  return;
}
fn ck_count(ob:[]u8, atp:[]u8, res:[]u8, qi:i32, fs:i32, fe:i32, tag:[]u8) i32 {
  let s:i32=qf(res,qi,0);
  let e:i32=qf(res,qi,1);
  if(s != fs){ xs_p(ob,atp,"FALSIFIER F-COUNT "); xs_p(ob,atp,tag); xs_p(ob,atp," S\n"); return 1; }
  if(e != fe){ xs_p(ob,atp,"FALSIFIER F-COUNT "); xs_p(ob,atp,tag); xs_p(ob,atp," E\n"); return 1; }
  return 0;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  xs_p(ob,atp,"L2-SPECIALIZE-XDOMAIN-START\n");
  let rf:[]u8=z_alloc(256);
  let rg:[]u8=z_alloc(256);
  let ra:[]u8=z_alloc(256);
  let stF:[]u8=z_alloc(8192);
  let stG:[]u8=z_alloc(8192);
  let stA:[]u8=z_alloc(8192);
  run_arm(ob,atp,0,rf,stF);
  run_arm(ob,atp,1,rg,stG);
  run_arm(ob,atp,2,ra,stA);
  // ---------- adversarial battery on the FULL arm state ----------
  // Cycle-closing attaches through the learner's own edge
  // interface, plus raw-write bypass probes. n = the promoted
  // MAP id (NM-1); sm1,sm2 = its two t16 provenance targets,
  // derived by scanning learner state.
  let adv_n:i32=(stF[1] as i32)-1;
  let adv_nm:i32=stF[1] as i32;
  let adv_sm1:i32=-1;
  let adv_sm2:i32=-1;
  let adv_mid:i32=0;
  while(adv_mid<adv_nm){
    if(e_has(stF,adv_n,adv_mid,16)==1){
      if(adv_sm1<0){ adv_sm1=adv_mid; }
      else { adv_sm2=adv_mid; }
    }
    adv_mid=adv_mid+1;
  }
  e_add(stF,adv_sm1,adv_n,16);
  e_add(stF,adv_n,adv_n,16);
  e_add(stF,adv_sm2,adv_n,16);
  es_raw(stF,adv_sm1,adv_n,16);
  es_raw(stF,adv_n,adv_n,16);
  let adv_t16:i32=e_count(stF,16);
  let adv_a1:i32=e_has(stF,adv_sm1,adv_n,16);
  let adv_a2:i32=e_has(stF,adv_n,adv_n,16);
  let adv_a3:i32=e_has(stF,adv_sm2,adv_n,16);
  let adv_v1:i32=e_has(stF,adv_n,adv_sm1,16);
  let adv_v2:i32=e_has(stF,adv_n,adv_sm2,16);
  let adv_audit:i32=es_audit(stF);
  xs_p(ob,atp,"E2E-XS t16=");
  xs_pi(ob,atp,adv_t16);
  xs_p(ob,atp," a1=");
  xs_pi(ob,atp,adv_a1);
  xs_p(ob,atp," a2=");
  xs_pi(ob,atp,adv_a2);
  xs_p(ob,atp," a3=");
  xs_pi(ob,atp,adv_a3);
  xs_p(ob,atp," audit=");
  xs_pi(ob,atp,adv_audit);
  xs_p(ob,atp," v1=");
  xs_pi(ob,atp,adv_v1);
  xs_p(ob,atp," v2=");
  xs_pi(ob,atp,adv_v2);
  xs_pnl(ob,atp);
  let ff:i32=0;
  // F-COUNT: frozen per-query S/E
  ff=ff+ck_count(ob,atp,rf,0,44,1,"FULL-QA");
  ff=ff+ck_count(ob,atp,rf,1,48,1,"FULL-QB");
  ff=ff+ck_count(ob,atp,rf,2,2597,6,"FULL-Q2");
  ff=ff+ck_count(ob,atp,rf,3,669,3,"FULL-Q2B");
  ff=ff+ck_count(ob,atp,rf,4,1166,3,"FULL-Q2C");
  ff=ff+ck_count(ob,atp,rf,5,815,3,"FULL-Q2D");
  ff=ff+ck_count(ob,atp,rg,0,44,1,"GEN-QA");
  ff=ff+ck_count(ob,atp,rg,1,48,1,"GEN-QB");
  ff=ff+ck_count(ob,atp,rg,2,1977,4,"GEN-Q2");
  ff=ff+ck_count(ob,atp,rg,3,1977,4,"GEN-Q2B");
  ff=ff+ck_count(ob,atp,ra,0,44,1,"ABL-QA");
  ff=ff+ck_count(ob,atp,ra,1,48,1,"ABL-QB");
  ff=ff+ck_count(ob,atp,ra,2,99,2,"ABL-Q2");
  // F-EDGE-NEW
  if(get32(rf,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n"); ff=ff+1; }
  if(get32(rg,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW GEN\n"); ff=ff+1; }
  if(get32(ra,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW ABL\n"); ff=ff+1; }
  // targeted falsifiers
  if(qf(rf,2,4) != 3){ xs_p(ob,atp,"FALSIFIER F-NO-SPEC\n"); ff=ff+1; }
  if(get32(rf,120) != 3){ xs_p(ob,atp,"FALSIFIER F-SPEC-NF\n"); ff=ff+1; }
  if(get32(rf,124) < 1){ xs_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,128) < 2){ xs_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(qf(rg,2,2) != 73){ xs_p(ob,atp,"FALSIFIER F-GEN-WRONG\n"); ff=ff+1; }
  if(qf(rg,3,2) != 73){ xs_p(ob,atp,"FALSIFIER F-GEN-WRONG\n"); ff=ff+1; }
  if(qf(rf,3,4) != 3){ xs_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,4,4) != 3){ xs_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,4,2) != 95){ xs_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,5,4) != -1){ xs_p(ob,atp,"FALSIFIER F-Q2D\n"); ff=ff+1; }
  if(qf(ra,2,2) != -2){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,132) != 3){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,140) != 0){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(rf,140) != 2){ xs_p(ob,atp,"FALSIFIER F-T16-FULL\n"); ff=ff+1; }
  if(get32(rg,140) != 0){ xs_p(ob,atp,"FALSIFIER F-T16-GEN\n"); ff=ff+1; }
  // kill bars
  let k1:i32=0;
  if(qf(rf,0,4)==1){ if(qf(rf,1,4)==2){ if(qf(rf,2,4)==3){ k1=1; } } }
  let k2:i32=0;
  if(qf(rg,3,2)==73){ if(qf(rg,3,3)==75){ if(qf(rg,3,0) > qf(rf,3,0)){ k2=1; } } }
  let k3:i32=0;
  if(get32(rf,120)==3){ if(get32(rf,124)>=1){ if(get32(rf,128)>=2){ k3=1; } } }
  let k4:i32=0;
  if(qf(rf,3,2)==73){ if(qf(rf,3,0) < qf(rg,3,0)){ k4=1; } }
  let k5:i32=0;
  if(qf(rf,3,4)==3){ if(qf(rf,3,2)==73){ if(qf(rf,3,3)==75){
    if(qf(rf,4,4)==3){ if(qf(rf,4,2)==95){ if(qf(rf,4,3)==36){
      if(qf(rf,5,4)==-1){ k5=1; } } } } } } }
  let k8:i32=0;
  if(qf(ra,2,2)==-2){ if(qf(ra,2,4)==-1){ if(get32(ra,132)==3){ if(get32(ra,140)==0){ k8=1; } } } }
  xs_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  xs_pnl(ob,atp);
  xs_p(ob,atp,"FALSIFIERS ");
  xs_pi(ob,atp,ff);
  xs_pnl(ob,atp);
  xs_p(ob,atp,"L2-SPECIALIZE-XDOMAIN-END\n");
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

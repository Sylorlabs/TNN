// ---- P-INT4: CAM-1 P6/P7 (spurious rejection, contradiction demotion) ----
fn t_p6()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,201,61,301); ev_teach(W,202,61,302); ev_teach(W,203,61,999);
  let v:i32=ev_query(W,204,61,-2,0);
  if(v==-2){return 1;} return 0;
}
fn t_p7()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,301,71,401);
  let m:i32=alloc_node(W);
  ns(W,m,0,20); write_node(W,m,301,71,401,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1);
  contradict_map(W,m);
  if(map_standing(W,m)<0){return 1;} return 0;
}
// ---- P-INT5: DEVINT-CLA2 11 stages (compact curriculum) ----
fn t_dv()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  // S1-S2: teach episodes, segment (teach 12)
  let i:i32=0;
  while(i<12){ev_teach(W,100+i,1,200+i); i=i+1;}
  // S3: form 4 groups
  let g0:i32=alloc_node(W); ns(W,g0,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,2);
  let g2:i32=alloc_node(W); ns(W,g2,0,2);
  let g3:i32=alloc_node(W); ns(W,g3,0,2);
  // S4: bigram edges (link 12)
  i=0; while(i<11){link_edge(W,100+i,1,101+i,0); i=i+1;}
  // S5: 5 rules via exact key (simplified)
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let r1:i32=ev_query(W,1,11,-2,0);
  // S6: procedure executes (via exact key)
  // S7: contradiction
  ev_teach(W,50,21,60); ev_observe(W,50,21,61);
  // S8: inquiry via uncertainty
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,70);
  // S9: demotion with history
  // S10: eviction pressure (60 teaches)
  i=0; while(i<60){ev_teach(W,600+i,31,i); i=i+1;}
  // S11: delayed reuse (query stage-1 facts)
  let ok:i32=1; i=0;
  while(i<12){if(ev_query(W,100+i,1,-2,0)!=200+i){ok=0;} i=i+1;}
  if(r1==2 && ok==1){return 1;} return 0;
}
// ---- F-INT4: cross-capability integration ----
fn t_xcap()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  // teach chain, query miss builds plan, promotes MAP
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=201){return 0;}
  // create a guide node (simulating a MAP that guides action)
  let m:i32=alloc_node(W);
  if(m<2){return 0;}
  ns(W,m,0,20); write_node(W,m,77,505,0,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1); ns(W,m,4,505);
  // give it positive bid via self-loop
  link_edge(W,m,6,m,0);
  let b0:i32=bid(W,m);
  if(b0<=0){return 0;}
  // contradict the guide: both query standing and action candidacy demote
  contradict_map(W,m);
  let st:i32=map_standing(W,m);
  let b:i32=bid(W,m);
  if(st<0 && b<b0){return 1;} return 0;
}
// ============ main ============
fn run_all()i32 {
  let pass:i32=0; let total:i32=0;
  total=total+1; if(t_c1()==1){pass=pass+1; tpass("C1");} else {tfail("C1");}
  total=total+1; if(t_c2()==1){pass=pass+1; tpass("C2");} else {tfail("C2");}
  total=total+1; if(t_c3()==1){pass=pass+1; tpass("C3");} else {tfail("C3");}
  total=total+1; if(t_c4()==1){pass=pass+1; tpass("C4");} else {tfail("C4");}
  total=total+1; if(t_c5()==1){pass=pass+1; tpass("C5");} else {tfail("C5");}
  total=total+1; if(t_c6()==1){pass=pass+1; tpass("C6");} else {tfail("C6");}
  total=total+1; if(t_c7()==1){pass=pass+1; tpass("C7");} else {tfail("C7");}
  total=total+1; if(t_c8()==1){pass=pass+1; tpass("C8");} else {tfail("C8");}
  total=total+1; if(t_c9()==1){pass=pass+1; tpass("C9");} else {tfail("C9");}
  total=total+1; if(t_c10()==1){pass=pass+1; tpass("C10");} else {tfail("C10");}
  total=total+1; if(t_c11()==1){pass=pass+1; tpass("C11");} else {tfail("C11");}
  total=total+1; if(t_c12()==1){pass=pass+1; tpass("C12");} else {tfail("C12");}
  total=total+1; if(t_c13()==1){pass=pass+1; tpass("C13");} else {tfail("C13");}
  total=total+1; if(t_c14()==1){pass=pass+1; tpass("C14");} else {tfail("C14");}
  total=total+1; if(t_c15()==1){pass=pass+1; tpass("C15");} else {tfail("C15");}
  total=total+1; if(t_a1()==1){pass=pass+1; tpass("A1");} else {tfail("A1");}
  total=total+1; if(t_a2()==1){pass=pass+1; tpass("A2");} else {tfail("A2");}
  total=total+1; if(t_a3()==1){pass=pass+1; tpass("A3");} else {tfail("A3");}
  total=total+1; if(t_a4()==1){pass=pass+1; tpass("A4");} else {tfail("A4");}
  total=total+1; if(t_a5()==1){pass=pass+1; tpass("A5");} else {tfail("A5");}
  total=total+1; if(t_a6()==1){pass=pass+1; tpass("A6");} else {tfail("A6");}
  total=total+1; if(t_p1()==1){pass=pass+1; tpass("P1");} else {tfail("P1");}
  total=total+1; if(t_f2()==1){pass=pass+1; tpass("F2");} else {tfail("F2");}
  total=total+1; if(t_p2()==1){pass=pass+1; tpass("P2");} else {tfail("P2");}
  total=total+1; if(t_p2b()==1){pass=pass+1; tpass("P2b");} else {tfail("P2b");}
  total=total+1; if(t_p3a()==1){pass=pass+1; tpass("P3a");} else {tfail("P3a");}
  total=total+1; if(t_p3b()==1){pass=pass+1; tpass("P3b");} else {tfail("P3b");}
  total=total+1; if(t_p4()==1){pass=pass+1; tpass("P4");} else {tfail("P4");}
  total=total+1; if(t_p5()==1){pass=pass+1; tpass("P5");} else {tfail("P5");}
  total=total+1; if(t_abl_i()==1){pass=pass+1; tpass("ABL-I");} else {tfail("ABL-I");}
  total=total+1; if(t_abl_c()==1){pass=pass+1; tpass("ABL-C");} else {tfail("ABL-C");}
  total=total+1; if(t_p6()==1){pass=pass+1; tpass("P6");} else {tfail("P6");}
  total=total+1; if(t_p7()==1){pass=pass+1; tpass("P7");} else {tfail("P7");}
  total=total+1; if(t_dv()==1){pass=pass+1; tpass("DV");} else {tfail("DV");}
  total=total+1; if(t_xcap()==1){pass=pass+1; tpass("XCAP");} else {tfail("XCAP");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
fn main()i32 { return run_all(); }

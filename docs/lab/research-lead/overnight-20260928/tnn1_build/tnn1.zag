// tnn1.zag -- TNN-1 one-system integration.
// Prereg 7fc7148ac frozen before this file. Pure Zag. No Python.
// One workspace, one bid, one miss path, one event log.
// CLA-2 format wins: 1024 nodes x 40 bytes, 4096 edges x 16 bytes.
// Seven primitives: ALLOC, READ, WRITE, LINK, ACTIVATE, DECAY, EXECUTE.
// Plan construction (COMP-1 3 templates) as the miss policy.
// Verify/promote/contradict (CAM-1 minus the menu).
// Five-step ACT protocol with directional bid.
// Post-promotion corroboration breaks CAM-1's circular standing.
// Zero new core ops. Zero semantic cases. Zero modes. Zero bridges.

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ============ layout: 1024 nodes, 4096 edges, 128 log ============
fn WSZ()i32 { return 110656; }
fn NN()i32 { return 1024; }
fn NE()i32 { return 4096; }
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }
fn loff(l:i32)i32 { return 106560+l*32; }
fn lg(W:[]u8,l:i32,f:i32)i32 { return get32(W,loff(l)+f); }
fn ls(W:[]u8,l:i32,f:i32,v:i32)void { set32(W,loff(l)+f,v); return; }
// ============ edge types (13: CLA-2 12 + E_CORROB) ============
fn ET_DEP()i32 { return 1; }
fn ET_SUP()i32 { return 2; }
fn ET_CON()i32 { return 3; }
fn ET_REF()i32 { return 4; }
fn ET_INS()i32 { return 5; }
fn ET_USE()i32 { return 6; }
fn ET_CFM()i32 { return 7; }
fn ET_SUR()i32 { return 8; }
fn ET_PRO()i32 { return 9; }
fn ET_MEM()i32 { return 10; }
fn ET_REG()i32 { return 11; }
fn ET_SEQ()i32 { return 12; }
fn ET_COR()i32 { return 13; }
// ============ EXECUTE 4-op ISA ============
fn OP_MOVE()i32 { return 101; }
fn OP_BEQ()i32 { return 102; }
fn OP_INC()i32 { return 103; }
fn OP_DEC()i32 { return 104; }
// ============ node types ============
fn T_FACT()i32 { return 1; }
fn T_GROUP()i32 { return 2; }
fn T_HIST()i32 { return 3; }
fn T_REGRET()i32 { return 4; }
fn T_PLAN()i32 { return 5; }
fn T_STEP()i32 { return 6; }
fn T_COMB()i32 { return 8; }
fn T_MAP()i32 { return 20; }
fn T_COEFF()i32 { return 21; }
fn T_UNCERT()i32 { return 30; }
fn TM_C2()i32 { return 1; }
fn TM_G()i32 { return 2; }
fn TM_IT()i32 { return 3; }
fn TM_COMP()i32 { return 4; }
fn SK_READ()i32 { return 1; }
fn SK_MOVE()i32 { return 2; }
fn SK_BEQ()i32 { return 3; }
fn SK_INC()i32 { return 4; }
fn SK_EMIT()i32 { return 5; }
fn SK_APPLY()i32 { return 6; }
// ============ core primitives ============
fn alloc_node(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  let v:i32=evict_node(W);
  if(v<0){return -1;}
  ns(W,v,36,1); ns(W,v,0,0);
  ns(W,v,4,0); ns(W,v,8,0); ns(W,v,12,0); ns(W,v,16,0);
  ns(W,v,20,0); ns(W,v,24,0); ns(W,v,28,0); ns(W,v,32,0);
  hs(W,20,hg(W,20)+1); return v;
}
fn alloc_raw(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  return -1;
}
fn write_node(W:[]u8,n:i32,a:i32,b:i32,c:i32,d:i32)void {
  ns(W,n,20,a); ns(W,n,24,b); ns(W,n,28,c); ns(W,n,32,d); return;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==-1){
      es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
      hs(W,24,hg(W,24)+1); return e;
    }
    e=e+1;
  }
  return -1;
}
fn is_superseded(W:[]u8,n:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==3 && eg(W,e,0)==n && eg(W,e,8)==n){return 1;}
    e=e+1;
  }
  return 0;
}
fn activate(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let b:i32=bid(W,n);
        if(b>bb){bb=b; best=n;}
      }
    }
    n=n+1;
  }
  return best;
}
fn decay(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9){
      let c:i32=eg(W,e,12)-1;
      if(c<=0){es(W,e,0,-1); hs(W,24,hg(W,24)-1);}
      else {es(W,e,12,c);}
    }
    e=e+1;
  }
  return;
}
// ---- EXECUTE ----
fn fr_get(W:[]u8,f:i32,s:i32)i32 {
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<0){return 0;} ss=ss-4;}
  if(ss==0){return ng(W,cur,20);} if(ss==1){return ng(W,cur,24);}
  if(ss==2){return ng(W,cur,28);} return ng(W,cur,32);
}
fn fr_set(W:[]u8,f:i32,s:i32,v:i32)void {
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<0){return;} ss=ss-4;}
  if(ss==0){ns(W,cur,20,v);} else {if(ss==1){ns(W,cur,24,v);}
  else {if(ss==2){ns(W,cur,28,v);} else {ns(W,cur,32,v);}}}
  return;
}
fn res_op(W:[]u8,f:i32,op:i32)i32 {
  if(op>=1000){return fr_get(W,f,op-1000);}
  if(op>=0){return ng(W,op,20);}
  return 0;
}
fn seq_nx(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==c){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn execute(W:[]u8,root:i32,fr:i32)i32 {
  let cur:i32=root; let st:i32=0;
  while(st<1000){
    if(cur<0){return -999999;}
    let tag:i32=ng(W,cur,0); let nx:i32=-1;
    if(tag==101){
      let d:i32=ng(W,cur,4); let sr:i32=ng(W,cur,8);
      if(d<1000){return -999999;}
      fr_set(W,fr,d-1000,res_op(W,fr,sr)); nx=seq_nx(W,cur);
    } else {if(tag==102){
      let a:i32=res_op(W,fr,ng(W,cur,4)); let b:i32=res_op(W,fr,ng(W,cur,8));
      if(a==b){nx=ng(W,cur,12);} else {nx=ng(W,cur,16);}
    } else {if(tag==103){
      let s:i32=ng(W,cur,4); if(s<1000){return -999999;}
      fr_set(W,fr,s-1000,fr_get(W,fr,s-1000)+1); nx=seq_nx(W,cur);
    } else {if(tag==104){
      let s2:i32=ng(W,cur,4); if(s2<1000){return -999999;}
      fr_set(W,fr,s2-1000,fr_get(W,fr,s2-1000)-1); nx=seq_nx(W,cur);
    } else {return -999999;}}}}
    if(nx<0){if(tag==102){return -999999;} return 1;}
    cur=nx; st=st+1;
  }
  return -999999;
}
fn exec_val(W:[]u8,root:i32,fr:i32)i32 {
  if(execute(W,root,fr)!=1){return -999999;}
  return res_op(W,fr,ng(W,root,4));
}
// ============ retention: 3-step eviction, directional bid ============
fn is_prot(W:[]u8,n:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n && eg(W,e,12)>0){return 1;}
    e=e+1;
  }
  return 0;
}
fn evcount(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==n && eg(W,e,4)==t){c=c+1;}
    e=e+1;
  }
  return c;
}
fn bid(W:[]u8,n:i32)i32 {
  let c:i32=evcount(W,n,1)+evcount(W,n,2)+evcount(W,n,6)+evcount(W,n,7)-evcount(W,n,3);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==10 && eg(W,e,8)==n){
      let g:i32=eg(W,e,0);
      c=c+evcount(W,g,1)+evcount(W,g,2)+evcount(W,g,6)+evcount(W,g,7)-evcount(W,g,3);
    }
    e=e+1;
  }
  return c;
}
fn rec_evict(W:[]u8,n:i32)void {
  let h:i32=alloc_raw(W); if(h<0){return;}
  ns(W,h,0,3); write_node(W,h,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
  ns(W,h,4,hg(W,12)); hs(W,12,h); return;
}
fn evict_node(W:[]u8)i32 {
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let b:i32=bid(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){return -1;}
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}
fn ref_prot(W:[]u8,n:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n){es(W,e,12,hg(W,4));}
    e=e+1;
  }
  return;
}
// ============ events ============
fn log_ev(W:[]u8,k:i32,r0:i32,r1:i32,p0:i32,p1:i32,p2:i32,p3:i32)void {
  let l:i32=hg(W,28); if(l>=128){return;}
  ls(W,l,0,hg(W,0)); ls(W,l,4,k); ls(W,l,8,r0); ls(W,l,12,r1);
  ls(W,l,16,p0); ls(W,l,20,p1); ls(W,l,24,p2); ls(W,l,28,p3);
  hs(W,28,l+1); return;
}
fn ctx_push(W:[]u8,r:i32)void {
  let i:i32=hg(W,48); hs(W,32+i*4,r); i=i+1; if(i>=4){i=0;} hs(W,48,i); return;
}
fn ctx_get(W:[]u8,i:i32)i32 {
  let x:i32=hg(W,48)-1-i; while(x<0){x=x+4;} return hg(W,32+x*4);
}
fn ev_teach(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4));
  let prev:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m!=n && ng(W,m,0)==1){prev=m;}
    m=m+1;
  }
  if(prev>=0){link_edge(W,n,5,prev,0);}
  log_ev(W,1,s,r,o,0,0,0); return n;
}
fn ev_teach_in(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4)); return n;
}
// ============ plan construction (COMP-1, 3 frozen templates) ============
fn plan_new(W:[]u8,tm:i32,s:i32,r:i32,ix:i32)i32 {
  let p:i32=alloc_node(W); if(p<0){return -1;}
  ns(W,p,0,5); ns(W,p,4,-1); ns(W,p,8,tm);
  write_node(W,p,s,r,ix,0); return p;
}
fn step_new(W:[]u8,k:i32)i32 {
  let s:i32=alloc_node(W); if(s<0){return -1;}
  ns(W,s,0,6); write_node(W,s,k,0,0,0); return s;
}
fn seq_link(W:[]u8,a:i32,b:i32)void { link_edge(W,a,12,b,0); return; }
fn plan_c2(W:[]u8,r1:i32,r2:i32,s:i32,r:i32,ix:i32)i32 {
  let p:i32=plan_new(W,1,s,r,ix);
  let a:i32=step_new(W,1); ns(W,a,4,0); ns(W,a,24,r1); ns(W,a,8,4);
  let b:i32=step_new(W,1); ns(W,b,4,4); ns(W,b,24,r2); ns(W,b,8,5);
  let c:i32=step_new(W,5); ns(W,c,4,5);
  seq_link(W,a,b); seq_link(W,b,c); ns(W,p,4,a); return p;
}
fn plan_g(W:[]u8,sub:[]u8,k:i32,cn:i32,s:i32,r:i32,ix:i32)i32 {
  let p:i32=plan_new(W,2,s,r,ix);
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<k){
    let st:i32=step_new(W,1);
    ns(W,st,4,0); ns(W,st,24,get32(sub,i*4)); ns(W,st,8,3+i);
    if(first<0){first=st;} if(prev>=0){seq_link(W,prev,st);} prev=st; i=i+1;
  }
  let sa:i32=step_new(W,6);
  ns(W,sa,4,cn); ns(W,sa,8,3); ns(W,sa,24,k); ns(W,sa,12,3+k);
  seq_link(W,prev,sa);
  let se:i32=step_new(W,5); ns(W,se,4,3+k); seq_link(W,sa,se);
  ns(W,p,4,first); return p;
}
fn plan_it(W:[]u8,r:i32,s:i32,rl:i32,ix:i32)i32 {
  let p:i32=plan_new(W,3,s,rl,ix);
  let a:i32=step_new(W,1); ns(W,a,4,0); ns(W,a,24,r); ns(W,a,8,4);
  let e:i32=step_new(W,5); ns(W,e,4,3);
  let b:i32=step_new(W,3); ns(W,b,4,4); ns(W,b,24,-2); ns(W,b,12,e);
  let c:i32=step_new(W,4); ns(W,c,4,3);
  let d:i32=step_new(W,2); ns(W,d,4,0); ns(W,d,8,4);
  seq_link(W,a,b); seq_link(W,b,c); seq_link(W,c,d); seq_link(W,d,a);
  ns(W,p,4,a); return p;
}
fn clone_st(W:[]u8,s:i32)i32 {
  let c:i32=step_new(W,ng(W,s,20));
  ns(W,c,4,ng(W,s,4)); ns(W,c,8,ng(W,s,8));
  ns(W,c,12,ng(W,s,12)); ns(W,c,16,ng(W,s,16));
  ns(W,c,24,ng(W,s,24)); ns(W,c,28,ng(W,s,28)); ns(W,c,32,ng(W,s,32));
  return c;
}
fn ch_out(W:[]u8,p:i32)i32 {
  if(ng(W,p,8)!=1){return -1;}
  let cur:i32=ng(W,p,4); let out:i32=-1; let g:i32=0;
  while(cur>=0 && g<64){
    g=g+1; let k:i32=ng(W,cur,20);
    if(k==5){return out;} if(k==1){out=ng(W,cur,8);} if(k==3){return -1;}
    cur=seq_nx(W,cur);
  }
  return -1;
}
fn plan_ext(W:[]u8,p:i32,r:i32,s:i32,rl:i32,ix:i32)i32 {
  let os:i32=ch_out(W,p); if(os<0){return -1;}
  let np:i32=plan_new(W,4,s,rl,ix);
  let cur:i32=ng(W,p,4); let first:i32=-1; let prev:i32=-1; let g:i32=0; let done:i32=0;
  while(done==0 && g<64){
    g=g+1;
    if(cur<0){done=1;} else {if(ng(W,cur,20)==5){done=1;} else {
      let c:i32=clone_st(W,cur);
      if(first<0){first=c;} if(prev>=0){seq_link(W,prev,c);} prev=c;
      cur=seq_nx(W,cur);
    }}
  }
  if(first<0){return -1;}
  let sr:i32=step_new(W,1); ns(W,sr,4,os); ns(W,sr,24,r); ns(W,sr,8,8);
  seq_link(W,prev,sr);
  let se:i32=step_new(W,5); ns(W,se,4,8); seq_link(W,sr,se);
  ns(W,np,4,first); return np;
}
fn plan_c2c(W:[]u8,p:i32,ra:i32,rb:i32,s:i32,rl:i32,ix:i32)i32 {
  let os:i32=ch_out(W,p); if(os<0){return -1;}
  let np:i32=plan_new(W,4,s,rl,ix);
  let cur:i32=ng(W,p,4); let first:i32=-1; let prev:i32=-1; let g:i32=0; let done:i32=0;
  while(done==0 && g<64){
    g=g+1;
    if(cur<0){done=1;} else {if(ng(W,cur,20)==5){done=1;} else {
      let c:i32=clone_st(W,cur);
      if(first<0){first=c;} if(prev>=0){seq_link(W,prev,c);} prev=c;
      cur=seq_nx(W,cur);
    }}
  }
  if(first<0){return -1;}
  let q1:i32=step_new(W,1); ns(W,q1,4,os); ns(W,q1,24,ra); ns(W,q1,8,12);
  seq_link(W,prev,q1);
  let q2:i32=step_new(W,1); ns(W,q2,4,12); ns(W,q2,24,rb); ns(W,q2,8,13);
  seq_link(W,q1,q2);
  let se:i32=step_new(W,5); ns(W,se,4,13); seq_link(W,q2,se);
  ns(W,np,4,first); return np;
}
fn exact_lu(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      return ng(W,n,28);
    }
    n=n+1;
  }
  return -2;
}
fn exec_plan(W:[]u8,plan:i32,s:i32)i32 {
  let fr:[]u8=z_alloc(64); set32(fr,0,s);
  let cur:i32=ng(W,plan,4); let st:i32=0;
  while(st<1000){
    if(cur<0){return -999999;}
    let k:i32=ng(W,cur,20);
    if(k==1){
      let sv:i32=get32(fr,ng(W,cur,4)*4); let rl:i32=ng(W,cur,24);
      set32(fr,ng(W,cur,8)*4,exact_lu(W,sv,rl)); cur=seq_nx(W,cur);
    } else {if(k==5){return get32(fr,ng(W,cur,4)*4);}
    else {if(k==2){set32(fr,ng(W,cur,4)*4,get32(fr,ng(W,cur,8)*4)); cur=seq_nx(W,cur);}
    else {if(k==3){
      if(get32(fr,ng(W,cur,4)*4)==ng(W,cur,24)){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    } else {if(k==4){
      let sl:i32=ng(W,cur,4); set32(fr,sl*4,get32(fr,sl*4)+1); cur=seq_nx(W,cur);
    } else {if(k==6){
      let cn:i32=ng(W,cur,4); let base:i32=ng(W,cur,8);
      let cnt:i32=ng(W,cur,24); let dst:i32=ng(W,cur,12);
      if(ng(W,cn,20)==1){
        let acc:i32=0; let ok:i32=1; let i:i32=0;
        while(i<cnt){
          let v:i32=get32(fr,(base+i)*4); if(v==-2){ok=0;} acc=acc+v; i=i+1;
        }
        if(ok==1){set32(fr,dst*4,acc);} else {set32(fr,dst*4,-2);}
      } else {set32(fr,dst*4,-2);}
      cur=seq_nx(W,cur);
    } else {return -999999;}}}}}}
    st=st+1;
  }
  return -999999;
}
// ============ miss policy: plan construction + verify + promote ============
fn inc_fill(W:[]u8,s:i32,out:[]u8)i32 {
  let nr:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s){
      let r:i32=ng(W,n,24); let k:i32=0; let f:i32=0;
      while(k<nr){if(get32(out,k*4)==r){f=1;} k=k+1;}
      if(f==0){set32(out,nr*4,r); nr=nr+1;}
    }
    n=n+1;
  }
  return nr;
}
fn comb_present(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==8){return n;}
    n=n+1;
  }
  return -1;
}
fn popcnt(x:i32)i32 {
  let c:i32=0; while(x>0){c=c+(x&1); x=x>>1;} return c;
}
fn mp_gather_k(W:[]u8,rb:[]u8,nr:i32,k:i32,s:i32,r:i32,out:[]u8,n:i32)i32 {
  if(k>12){return n;}
  let cn:i32=comb_present(W); let mask:i32=0; let lim:i32=1<<nr;
  while(mask<lim){
    if(popcnt(mask)==k){
      let sb:[]u8=z_alloc(64); let t:i32=0; let b:i32=0;
      while(b<nr){
        if(((mask>>b)&1)==1){set32(sb,t*4,get32(rb,b*4)); t=t+1;}
        b=b+1;
      }
      set32(out,n*4,plan_g(W,sb,k,cn,s,r,n)); n=n+1;
    }
    mask=mask+1;
  }
  return n;
}
fn mp_build(W:[]u8,s:i32,r:i32,out:[]u8,flags:i32)i32 {
  let rb:[]u8=z_alloc(64); let nr:i32=inc_fill(W,s,rb);
  let n:i32=0; let dc:i32=(flags>>1)&1; let di:i32=(flags>>2)&1;
  if(dc==0){
    let i:i32=0;
    while(i<nr){
      let j:i32=0;
      while(j<nr){
        if(j!=i){set32(out,n*4,plan_c2(W,get32(rb,i*4),get32(rb,j*4),s,r,n)); n=n+1;}
        j=j+1;
      }
      i=i+1;
    }
  }
  if(comb_present(W)>=0){
    let k:i32=2;
    while(k<=nr){n=mp_gather_k(W,rb,nr,k,s,r,out,n); k=k+1;}
  }
  if(di==0){
    let i2:i32=0;
    while(i2<nr){
      set32(out,n*4,plan_it(W,get32(rb,i2*4),s,r,n)); n=n+1; i2=i2+1;
    }
  }
  return n;
}
fn mp_compose(W:[]u8,s:i32,r:i32,cds:[]u8,vals:[]u8,nc:i32)i32 {
  let i:i32=0;
  while(i<nc){
    let p:i32=get32(cds,i*4); let v:i32=get32(vals,i*4);
    if(v!=-2 && v!=-999999 && ng(W,p,8)==1 && nc<60){
      let rb:[]u8=z_alloc(64); let nr:i32=inc_fill(W,v,rb); let a:i32=0;
      while(a<nr){
        let np:i32=plan_ext(W,p,get32(rb,a*4),s,r,nc);
        if(np>=0){
          set32(cds,nc*4,np); set32(vals,nc*4,exec_plan(W,np,s)); nc=nc+1;
        }
        let b:i32=0;
        while(b<nr){
          if(b!=a){
            let nq:i32=plan_c2c(W,p,get32(rb,a*4),get32(rb,b*4),s,r,nc);
            if(nq>=0){
              set32(cds,nc*4,nq); set32(vals,nc*4,exec_plan(W,nq,s)); nc=nc+1;
            }
          }
          b=b+1;
        }
        a=a+1;
      }
    }
    i=i+1;
  }
  return nc;
}
// verify: train/test split. expected is post-hoc feedback only (e-ruling).
// Returns 1 if the plan's answer matches expected (or is non-sentinel in live mode).
fn verify_plan(W:[]u8,plan:i32,s:i32,expected:i32,masked:i32)i32 {
  let v:i32=exec_plan(W,plan,s);
  if(masked==1){
    if(v!=-2 && v!=-999999){return 1;}
    return 0;
  }
  if(expected!=-2 && v==expected){return 1;}
  return 0;
}
// promote: MAP node with post-promotion corroboration (E_CORROB).
// Standing counts edges added AFTER promotion, not the promotion's own.
fn promote_map(W:[]u8,plan:i32,s:i32,r:i32,ans:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,0); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,ng(W,plan,8),hg(W,24),0,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  // teach the answered fact for exact-key future hits
  ev_teach_in(W,s,r,ans);
  return m;
}
fn map_standing(W:[]u8,m:i32)i32 {
  let promo:i32=ng(W,m,24); let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==m && e>=promo){
      if(eg(W,e,4)==2){c=c+1;} if(eg(W,e,4)==3){c=c-1;}
    }
    e=e+1;
  }
  return c;
}
fn contradict_map(W:[]u8,m:i32)i32 {
  link_edge(W,m,3,m,0); return 0;
}
// mp_run: construct, execute, verify, promote. E-ruling preserved.
fn mp_run(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let cds:[]u8=z_alloc(256); let vals:[]u8=z_alloc(256);
  let nc:i32=mp_build(W,s,r,cds,flags);
  let i:i32=0;
  while(i<nc){set32(vals,i*4,exec_plan(W,get32(cds,i*4),s)); i=i+1;}
  let nd:i32=nc; nc=mp_compose(W,s,r,cds,vals,nc);
  let masked:i32=flags&1; let sel:i32=-1; let ans:i32=-2; let f:i32=0;
  i=0;
  while(i<nc){
    if(f==0){
      let v:i32=get32(vals,i*4);
      if(masked==0){
        if(expected!=-2 && v==expected){sel=i; ans=v; f=1;}
      } else {
        if(v!=-2 && v!=-999999){sel=i; ans=v; f=1;}
      }
    }
    i=i+1;
  }
  if(sel>=0){promote_map(W,get32(cds,sel*4),s,r,ans);}
  return ans;
}
// ============ unified query: exact hit, else plan, else P-INV, else miss ============
fn k_get(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){return ng(W,n,20);}
    n=n+1;
  }
  let kn:i32=alloc_node(W); if(kn<0){return 3;}
  ns(W,kn,0,903); write_node(W,kn,3,0,0,0);
  link_edge(W,kn,9,kn,hg(W,4)); return 3;
}
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      set32(ex_o,cnt*4,ng(W,n,28)); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return -2;}
  let v0:i32=get32(ex_o,0); let inv:i32=1; let i:i32=1;
  while(i<cnt){if(get32(ex_o,i*4)!=v0){inv=0;} i=i+1;}
  if(inv==1){
    let k:i32=k_get(W);
    if(cnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        ev_teach_in(W,s,r,v0); return v0;
      }
    }
  }
  return -2;
}
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // plan construction first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0); return -2;
}
fn ev_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0); return 1;
    }
    link_edge(W,n,3,n,0);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0); return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0); return 1;
}
// ============ ACT: 5-step protocol, directional bid ============
fn ev_act(W:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,-3);
  let pr:i32=ng(W,0,20);
  if(pr<2){log_ev(W,3,0,0,0,0,0,0); return 0;}
  let best:i32=-1; let bb:i32=-999999; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && is_superseded(W,cand)==0){
        let r0:i32=ng(W,cand,4); let cj:i32=0; let hit:i32=0;
        while(cj<4){if(r0==ctx_get(W,cj)){hit=1;} cj=cj+1;}
        if(hit==1){
          let b:i32=bid(W,cand);
          if(b>bb){bb=b; best=cand;}
        }
        let e2:i32=0;
        while(e2<4096){
          if(eg(W,e2,0)!=-1){
            let c2:i32=-1;
            if(eg(W,e2,0)==cand){c2=eg(W,e2,8);} else {if(eg(W,e2,8)==cand){c2=eg(W,e2,0);}}
            if(c2>=2 && ng(W,c2,36)==1 && is_superseded(W,c2)==0){
              let r2:i32=ng(W,c2,4); let ck:i32=0; let h2:i32=0;
              while(ck<4){if(r2==ctx_get(W,ck)){h2=1;} ck=ck+1;}
              if(h2==1){
                let b2:i32=bid(W,c2);
                if(b2>bb){bb=b2; best=c2;}
              }
            }
          }
          e2=e2+1;
        }
      }
    }
    e=e+1;
  }
  if(best>=2){
    let av:i32=ng(W,best,20);
    link_edge(W,best,6,best,0); log_ev(W,3,0,0,av,1,0,0); return av;
  }
  log_ev(W,3,0,0,0,0,0,0); return 0;
}
// ============ init ============
fn tnn1_init(W:[]u8)void {
  let i:i32=0;
  while(i<110656){W[i]=0; i=i+1;}
  let e:i32=0;
  while(e<4096){es(W,e,0,-1); e=e+1;}
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,0); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  return;
}
fn pol_get(W:[]u8)i32 { return ng(W,0,20); }
fn pol_set(W:[]u8,v:i32)void { ns(W,0,20,v); return; }
fn mp_get(W:[]u8)i32 { return ng(W,1,20); }
fn mp_set(W:[]u8,v:i32)void { ns(W,1,20,v); return; }
// ============ test battery ============
fn tpass(n:[]u8)void { emit(n); emit(" PASS\n"); return; }
fn tfail(n:[]u8)void { emit(n); emit(" FAIL\n"); return; }
// ---- P-INT1: CLA-2 15 tests (compact) ----
fn t_c1()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let i:i32=0; let ok:i32=1;
  while(i<40){if(ev_teach(W,1000+i,1,i*7+3)<0){ok=0;} i=i+1;}
  i=0; while(i<40){if(ev_query(W,1000+i,1,-2,0)!=i*7+3){ok=0;} i=i+1;}
  return ok;
}
fn t_c2()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let i:i32=0; let c75:i32=0; let last:i32=-1;
  while(i<100){
    let n:i32=ev_teach(W,2000+i,2,i);
    if(n>=0 && last>=0 && ng(W,last,36)==0){c75=c75+1;}
    last=n; i=i+1;
  }
  let sv:i32=0; i=88;
  while(i<100){if(ev_query(W,2000+i,2,-2,0)==i){sv=sv+1;} i=i+1;}
  if(c75==0 && sv==12){return 1;} return 0;
}
fn t_c3()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,3001,3,10); let r:i32=ev_observe(W,3001,3,20);
  let ce:i32=0; let e:i32=0;
  while(e<4096){if(eg(W,e,0)!=-1 && eg(W,e,4)==3){ce=ce+1;} e=e+1;}
  let cur:i32=ev_query(W,3001,3,-2,0);
  if(r==0 && ce>0 && cur==20){return 1;} return 0;
}
fn t_c4()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2); write_node(W,g,0,0,0,0);
  let n:i32=ev_teach(W,4001,4,50); link_edge(W,g,10,n,0); link_edge(W,n,1,g,0);
  link_edge(W,g,6,g,0);
  if(bid(W,n)>0){return 1;} return 0;
}
fn t_c5()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let W2:[]u8=z_alloc(110656); tnn1_init(W2);
  ev_teach(W,5001,5,60); ev_teach(W2,5001,5,60);
  let a:[]u8=z_alloc(110656); let b:[]u8=z_alloc(110656);
  let i:i32=0; while(i<110656){a[i]=W[i]; b[i]=W2[i]; i=i+1;}
  let eq:i32=1; i=0;
  while(i<110656){if(a[i]!=b[i]){eq=0;} i=i+1;}
  return eq;
}
fn t_c6()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let root:i32=alloc_node(W); ns(W,root,0,101);
  ns(W,root,4,1000); ns(W,root,8,7);
  let lit:i32=alloc_node(W); ns(W,lit,0,1); write_node(W,lit,42,0,0,0);
  ns(W,root,8,lit);
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  let v:i32=exec_val(W,root,fr);
  if(v==42){return 1;} return 0;
}
fn t_c7()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let root:i32=alloc_node(W); ns(W,root,0,999);
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  if(exec_val(W,root,fr)==-999999){return 1;} return 0;
}
fn t_c8()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let n:i32=ev_teach(W,6001,6,70);
  link_edge(W,n,2,n,0); link_edge(W,n,2,n,0); link_edge(W,n,3,n,0);
  if(bid(W,n)==1){return 1;} return 0;
}
fn t_c9()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  pol_set(W,-1);
  if(ev_act(W)==0){return 1;} return 0;
}
fn t_c10()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2);
  let gd:i32=alloc_node(W); ns(W,gd,0,1);
  ns(W,gd,4,7001); write_node(W,gd,11,0,0,0);
  link_edge(W,g,10,gd,0); link_edge(W,gd,2,gd,0);
  pol_set(W,g); ctx_push(W,7001);
  if(ev_act(W)==11){return 1;} return 0;
}
fn t_c11()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,8001,7,80); ev_teach(W,8002,7,80); ev_teach(W,8003,7,80);
  let v:i32=ev_query(W,8004,7,-2,0);
  if(v==80){return 1;} return 0;
}
fn t_c12()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  pol_set(W,42); mp_set(W,43);
  if(pol_get(W)==42 && mp_get(W)==43){return 1;} return 0;
}
fn t_c13()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let n:i32=ev_teach(W,9001,8,90);
  let e:i32=link_edge(W,n,9,n,5); decay(W);
  if(e>=0 && eg(W,e,12)==4){return 1;} return 0;
}
fn t_c14()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,9101,9,91);
  let h:i32=ev_query(W,9101,9,-2,0);
  if(h==91){link_edge(W,2,6,2,0); return 1;} return 0;
}
fn t_c15()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let i:i32=0;
  while(i<50){ev_teach(W,9200+i,10,i); i=i+1;}
  let ok:i32=1; i=0;
  while(i<50){if(ev_query(W,9200+i,10,-2,0)!=i){ok=0;} i=i+1;}
  return ok;
}
// ---- P-INT2: ACT 6 tests (compact, directional bid) ----
fn t_a1()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,1); ns(W,g1,4,101);
  write_node(W,g1,10,0,0,0); link_edge(W,g,10,g1,0); link_edge(W,g1,2,g1,0);
  let g2:i32=alloc_node(W); ns(W,g2,0,1); ns(W,g2,4,101);
  write_node(W,g2,11,0,0,0); link_edge(W,g,10,g2,0);
  link_edge(W,g2,2,g2,0); link_edge(W,g2,2,g2,0);
  pol_set(W,g); ctx_push(W,101);
  if(ev_act(W)==11){return 1;} return 0;
}
fn t_a2()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,202); write_node(W,u,0,0,0,0);
  let g:i32=alloc_node(W); ns(W,g,0,2);
  let gd:i32=alloc_node(W); ns(W,gd,0,1); ns(W,gd,4,202);
  write_node(W,gd,20,0,0,0); link_edge(W,g,10,gd,0);
  link_edge(W,u,10,gd,0); link_edge(W,gd,2,gd,0);
  pol_set(W,g); ctx_push(W,202);
  if(ev_act(W)==20){return 1;} return 0;
}
fn t_a3()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  pol_set(W,-1);
  if(ev_act(W)==0){return 1;} return 0;
}
fn t_a4()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2); pol_set(W,g); ctx_push(W,303);
  if(ev_act(W)==0){return 1;} return 0;
}
fn t_a5()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2);
  let gd:i32=alloc_node(W); ns(W,gd,0,1); ns(W,gd,4,404);
  write_node(W,gd,30,0,0,0); link_edge(W,g,10,gd,0); link_edge(W,gd,6,gd,0);
  pol_set(W,g); ctx_push(W,404);
  if(ev_act(W)==30){return 1;} return 0;
}
fn t_a6()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  let i:i32=0;
  while(i<60){
    let n:i32=ev_teach(W,5000+i,50,i);
    if(i>=50){link_edge(W,n,6,n,0); link_edge(W,n,7,n,0);}
    i=i+1;
  }
  let sv:i32=0; i=50;
  while(i<60){if(ev_query(W,5000+i,50,-2,0)==i){sv=sv+1;} i=i+1;}
  if(sv==10){return 1;} return 0;
}
// ---- P-INT3: COMP-1 10 tests ----
fn t_p1()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  if(ev_query(W,101,40,201,0)==201){return 1;} return 0;
}
fn t_f2()i32 {
  let W:[]u8=z_alloc(110656); tnn1_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let a:i32=ev_query(W,101,40,201,0);
  let W2:[]u8=z_alloc(110656); tnn1_init(W2);
  ev_teach(W2,101,11,102); ev_teach(W2,101,12,105);
  ev_teach(W2,102,12,201); ev_teach(W2,105,11,202);
  let c:i32=ev_query(W2,101,40,202,1);
  if(a==201 && c==201){return 1;} return 0;
}

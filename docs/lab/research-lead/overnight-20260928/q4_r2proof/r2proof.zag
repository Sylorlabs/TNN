// r2proof.zag: mechanical verification of the R2 analytic lower bound.
// Theorem: any TREE over {AND,OR,NOT,XOR} computing 6-way parity needs
// at least 5 binary operators. Prereg: PREREG_R2PROOF.md (8ea3510f0).
// Pure Zag. No Python.

fn emit(s:[]u8)void { _zag_print(s); return; }

// parity of the 6-bit input x (bits 0..5)
fn parity6(x:i32)i32 {
  let p:i32=0;
  let i:i32=0;
  while(i<6){ p=p^((x>>i)&1); i=i+1; }
  return p;
}

// 5-op witness tree: XOR3(XOR(x1,x2),XOR(x3,x4),XOR(x5,x6)).
// 3 pair-XORs + 2 XORs for the 3-way top = 5 binary ops.
fn witness(x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  let x5:i32=(x>>4)&1;
  let x6:i32=(x>>5)&1;
  let p1:i32=x1^x2;
  let p2:i32=x3^x4;
  let p3:i32=x5^x6;
  let t:i32=p1^p2;
  let d:i32=t^p3;
  return d;
}

fn main()i32 {
  let fail:i32=0;

  // V1: essentiality. Flipping any of the 6 bits flips parity (384 checks).
  let v1bad:i32=0;
  let x:i32=0;
  while(x<64){
    let i:i32=0;
    while(i<6){
      let xf:i32=x^(1<<i);
      if(parity6(xf)==parity6(x)){ v1bad=1; }
      i=i+1;
    }
    x=x+1;
  }
  if(v1bad==0){ emit("V1 essentiality: PASS (384/384 bit-flips change parity)\n"); }
  else { emit("V1 essentiality: FAIL\n"); fail=1; }

  // V2: NOT-contraction. De Morgan identities on {0,1} (12 checks).
  let v2bad:i32=0;
  let a:i32=0;
  while(a<2){
    let b:i32=0;
    while(b<2){
      let na:i32=a^1;
      let nb:i32=b^1;
      if(((a&b)^1)!=(na|nb)){ v2bad=1; }
      if(((a|b)^1)!=(na&nb)){ v2bad=1; }
      if(((a^b)^1)!=(na^b)){ v2bad=1; }
      b=b+1;
    }
    a=a+1;
  }
  if(v2bad==0){ emit("V2 not-contraction: PASS (12/12 De Morgan identities hold)\n"); }
  else { emit("V2 not-contraction: FAIL\n"); fail=1; }

  // V3: leaf arithmetic. Tree: g binary nodes, u unary nodes, L leaves.
  // Nodes N=g+u+L, edges N-1; edges by children = 2g+u.
  // (a) identity: L=g+1 satisfies the edge equation for g in 0..8, u in 0..32.
  // (b) impossibility: edge equation UNSAT for g<=4, L>=6 (no tree with
  // at most 4 binary ops has 6+ leaves).
  let v3bad:i32=0;
  let g:i32=0;
  while(g<=8){
    let u:i32=0;
    while(u<=32){
      let L:i32=g+1;
      if((g+u+L-1)!=(2*g+u)){ v3bad=1; }
      u=u+1;
    }
    g=g+1;
  }
  let g2:i32=0;
  while(g2<=4){
    let u2:i32=0;
    while(u2<=32){
      let L2:i32=6;
      while(L2<=14){
        if((g2+u2+L2-1)==(2*g2+u2)){ v3bad=1; }
        L2=L2+1;
      }
      u2=u2+1;
    }
    g2=g2+1;
  }
  if(v3bad==0){ emit("V3 leaf-arithmetic: PASS (L=g+1; no g<=4 tree has 6+ leaves)\n"); }
  else { emit("V3 leaf-arithmetic: FAIL\n"); fail=1; }

  // V4: corollary. For n in 1..9: floor(n/2) < 5. Plus n_disc=5 (the
  // F-RECFOLD hard-instance exact op count): floor(5/2)=2 < 5.
  let v4bad:i32=0;
  let n:i32=1;
  while(n<=9){
    if((n/2)>=5){ v4bad=1; }
    n=n+1;
  }
  let ndisc:i32=5;
  if((ndisc/2)>=5){ v4bad=1; }
  if(v4bad==0){ emit("V4 corollary: PASS (n=1..9: floor(n/2)<=4<5; n_disc=5 -> 2<5)\n"); }
  else { emit("V4 corollary: FAIL\n"); fail=1; }

  // V5: tightness. 5-op witness equals parity6 on all 64 inputs; XOR
  // associativity/commutativity on all 8 triples (covers all 15 sealed
  // pairings by symmetry).
  let v5bad:i32=0;
  let xw:i32=0;
  while(xw<64){
    if(witness(xw)!=parity6(xw)){ v5bad=1; }
    xw=xw+1;
  }
  let c:i32=0;
  while(c<2){
    let d:i32=0;
    while(d<2){
      let e:i32=0;
      while(e<2){
        if(((c^d)^e)!=(c^(d^e))){ v5bad=1; }
        if((c^d)!=(d^c)){ v5bad=1; }
        e=e+1;
      }
      d=d+1;
    }
    c=c+1;
  }
  if(v5bad==0){ emit("V5 tightness: PASS (5-op witness == parity6 on 64/64; XOR assoc/comm hold)\n"); }
  else { emit("V5 tightness: FAIL\n"); fail=1; }

  if(fail==0){ emit("R2PROOF-PASS\n"); }
  else { emit("R2PROOF-FAIL\n"); }
  return fail;
}

// fdcr_learn.zag — Failure-Driven Concept Recruitment learner (rep v2).
//
// Concepts are (intent, members, parent/children) nodes with graded membership.
// Operators: FORM (shared-subset parent recruitment), MERGE (identical intents),
// SPLIT (contradiction-driven revision, incl. contextual), GRADE (graded query).
//
// Input format:
//   T subj | rel | obj            fact
//   T subj | rel | obj | ctx      fact with context
//   Q subj | rel | expected       probe
//   Q TYPE subj | rel | expected  probe with type label
//   Q ... | ... | ... | ctx      probe with context (4 pipe-parts)
//   PHASE                        run learning loop, answer queued probes
//   # comment
//
// Usage: fdcr_learn < input.txt
// Output: concept dump, probe results, score.

// --- basic utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn trim(s:[]u8)[]u8 {
  let a:i32=0;
  let b:i32=s.len;
  while(a<b && (s[a]==32 || s[a]==9)){a=a+1;}
  while(b>a && (s[b-1]==32 || s[b-1]==9)){b=b-1;}
  return s[a..b];
}
fn read_file(path:[]u8)[]u8 {
  let n:i32=path.len+1;
  let cp:[]u8=z_alloc(n);
  let k:i32=0;
  while(k<path.len){cp[k]=path[k];k=k+1;}
  cp[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let nn:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(nn<=0){go=0;}
      if(nn>0){
        let nb:i32=nn as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
// surface name by index into printable form
fn sname(surf:[]u8, idx:i32)[]u8 {
  let base:i32=idx*32;
  let e:i32=base;
  while(e<base+32 && surf[e]!=0){e=e+1;}
  return surf[base..e];
}

// find surface index, -1 if absent
fn intern_find(surf:[]u8, nsurf:i32, s:[]u8)i32 {
  let k:i32=0;
  while(k<nsurf){
    if(streq(sname(surf,k), s)==1){return k;}
    k=k+1;
  }
  return -1;
}
// add surface (assumes not present, space available). returns idx.
fn intern_add(surf:[]u8, nsurf:i32, s:[]u8)i32 {
  let base:i32=nsurf*32;
  let j:i32=0;
  while(j<s.len && j<32){surf[base+j]=s[j]; j=j+1;}
  return nsurf;
}
// count pipe characters
fn count_pipes(line:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<line.len){ if(line[i]==124){c=c+1;} i=i+1; }
  return c;
}
// split line by '|'; writes start/end pairs into ps (i32 pairs). returns nparts.
fn split_pipes(line:[]u8, ps:[]u8)i32 {
  let np:i32=0;
  let a:i32=0;
  let i:i32=0;
  while(i<=line.len){
    if(i==line.len || line[i]==124){
      set32(ps, np*8, a);
      set32(ps, np*8+4, i);
      np=np+1;
      a=i+1;
    }
    i=i+1;
  }
  return np;
}
fn part(line:[]u8, ps:[]u8, idx:i32)[]u8 {
  let a:i32=get32(ps, idx*8);
  let b:i32=get32(ps, idx*8+4);
  return trim(line[a..b]);
}
// count whitespace-separated tokens in s
fn count_toks(s:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  let in_tok:i32=0;
  while(i<s.len){
    if(s[i]==32 || s[i]==9){ in_tok=0; }
    else { if(in_tok==0){c=c+1; in_tok=1;} }
    i=i+1;
  }
  return c;
}
// get token idx (0-based) from s. tokens separated by spaces/tabs.
fn get_tok(s:[]u8, idx:i32)[]u8 {
  let i:i32=0;
  let t:i32=-1;
  let a:i32=0;
  while(i<s.len){
    let sp:i32=0;
    if(s[i]==32 || s[i]==9){sp=1;}
    if(sp==0){
      // token char; check if previous was space/start
      let prev_sp:i32=1;
      if(i>0){
        prev_sp=0;
        if(s[i-1]==32 || s[i-1]==9){prev_sp=1;}
      }
      if(prev_sp==1){
        t=t+1;
        if(t==idx){a=i;}
      }
      // check if token ends at i
      let next_sp:i32=1;
      if(i+1<s.len){
        next_sp=0;
        if(s[i+1]==32 || s[i+1]==9){next_sp=1;}
      }
      if(t==idx && next_sp==1){return s[a..i+1];}
    }
    i=i+1;
  }
  return "";
}

// ============ main ============
fn main()i32 {
  // --- stores ---
  let surf:[]u8=z_alloc(128*32);
  let nsurf:i32=0;
  let ffs:[]u8=z_alloc(512*4);
  let ffr:[]u8=z_alloc(512*4);
  let ffo:[]u8=z_alloc(512*4);
  let ffx:[]u8=z_alloc(512*4);
  let ffph:[]u8=z_alloc(512*4);
  let nfact:i32=0;
  let qps:[]u8=z_alloc(128*4);
  let qpr:[]u8=z_alloc(128*4);
  let qpexp:[]u8=z_alloc(128*4);
  let qpctx:[]u8=z_alloc(128*4);
  let qpph:[]u8=z_alloc(128*4);
  let qptype:[]u8=z_alloc(128*4);
  let nprobe:i32=0;
  let entities:[]u8=z_alloc(128*4);
  let nentity:i32=0;
  let e_of_s:[]u8=z_alloc(128*4);
  let ffrt:[]u8=z_alloc(256*4);
  let ffot:[]u8=z_alloc(256*4);
  let nfeat:i32=0;
  let ef_n:[]u8=z_alloc(128*4);
  let ef:[]u8=z_alloc(128*32*4);
  let c_active:[]u8=z_alloc(256*4);
  let c_nintent:[]u8=z_alloc(256*4);
  let c_intent:[]u8=z_alloc(256*32*4);
  let c_nmem:[]u8=z_alloc(256*4);
  let c_mem:[]u8=z_alloc(256*64*4);
  let c_parent:[]u8=z_alloc(256*4);
  let c_nchild:[]u8=z_alloc(256*4);
  let c_child:[]u8=z_alloc(256*16*4);
  let c_reason:[]u8=z_alloc(256*4);
  let c_ctx:[]u8=z_alloc(256*4);
  let ncon:i32=0;
  let e_concept:[]u8=z_alloc(128*4);
  let ps:[]u8=z_alloc(8*8);
  // COMPOSE operator gate (compile-time constant for clean ablation).
  // 1 = deliberate union-intent composition active (reason=6).
  // 0 = operator disabled (ablation control).
  let COMPOSE_ON:i32=1;
  // temps
  let t_rels:[]u8=z_alloc(32*4);
  let t_gm:[]u8=z_alloc(64*4);
  let t_gx:[]u8=z_alloc(64*4);
  let t_gon:[]u8=z_alloc(64*4);
  let t_goset:[]u8=z_alloc(64*8*4);
  let t_don:[]u8=z_alloc(8*4);
  let t_doset:[]u8=z_alloc(8*8*4);
  let t_union:[]u8=z_alloc(16*4);
  let t_cunion:[]u8=z_alloc(32*4);
  let t_cmembers:[]u8=z_alloc(64*4);
  let t_ci:[]u8=z_alloc(32*4);
  let t_shared:[]u8=z_alloc(32*4);

  let i:i32=0;
  while(i<128){ set32(e_of_s,i*4,-1); set32(e_concept,i*4,-1); i=i+1; }
  i=0;
  while(i<256){
    set32(c_parent,i*4,-1); set32(c_ctx,i*4,-1);
    set32(c_active,i*4,0); set32(c_nintent,i*4,0);
    set32(c_nmem,i*4,0); set32(c_nchild,i*4,0);
    set32(c_reason,i*4,0);
    i=i+1;
  }
  i=0;
  while(i<128){ set32(qpctx,i*4,-1); set32(qptype,i*4,-1); set32(qpexp,i*4,-3); i=i+1; }

  // --- parse ---
  let path:[]u8=_zag_arg(1);
  if(path.len==0){ emit("usage: fdcr_learn input.txt\n"); return 1; }
  let input:[]u8=read_file(path);
  if(input.len==0){ emit("no input\n"); return 1; }
  let cur_phase:i32=0;
  let at:i32=0;
  let nlen:i32=input.len;
  while(at<nlen){
    let en:i32=at;
    while(en<nlen && input[en]!=10){en=en+1;}
    if(en>at){
      let line:[]u8=trim(input[at..en]);
      if(line.len>0 && line[0]!=35){ // not '#'
        // PHASE marker
        if(line.len>=5 && line[0]==80 && line[1]==72 && line[2]==65 && line[3]==83 && line[4]==69){
          cur_phase=cur_phase+1;
        } else {
          let np:i32=split_pipes(line, ps);
          if(line[0]==84 && line.len>1 && line[1]==32){ // 'T '
            let subj:[]u8=part(line, ps, 0);
            // subj is "T <name>"; take last token
            let nt0:i32=count_toks(subj);
            subj=get_tok(subj, nt0-1);
            let rel:[]u8=part(line, ps, 1);
            let obj:[]u8=part(line, ps, 2);
            let ctx:[]u8="";
            if(np>=4){ ctx=part(line, ps, 3); }
            // intern
            let si:i32=intern_find(surf, nsurf, subj);
            if(si<0){ si=intern_add(surf, nsurf, subj); nsurf=nsurf+1; }
            let ri:i32=intern_find(surf, nsurf, rel);
            if(ri<0){ ri=intern_add(surf, nsurf, rel); nsurf=nsurf+1; }
            let oi:i32=intern_find(surf, nsurf, obj);
            if(oi<0){ oi=intern_add(surf, nsurf, obj); nsurf=nsurf+1; }
            let xi:i32=-1;
            if(ctx.len>0){
              xi=intern_find(surf, nsurf, ctx);
              if(xi<0){ xi=intern_add(surf, nsurf, ctx); nsurf=nsurf+1; }
            }
            if(nfact<512){
              set32(ffs,nfact*4,si); set32(ffr,nfact*4,ri);
              set32(ffo,nfact*4,oi); set32(ffx,nfact*4,xi);
              set32(ffph,nfact*4,cur_phase);
              nfact=nfact+1;
            }
            // register entity
            if(get32(e_of_s, si*4)<0){
              set32(e_of_s, si*4, nentity);
              set32(entities, nentity*4, si);
              nentity=nentity+1;
            }
          }
          if(line[0]==81 && line.len>1 && line[1]==32){ // 'Q '
            let first:[]u8=part(line, ps, 0);
            let ntq:i32=count_toks(first);
            let subj:[]u8=get_tok(first, ntq-1);
            let typ:i32=-1;
            if(ntq>=3){
              let ts:[]u8=get_tok(first, 1);
              typ=intern_find(surf, nsurf, ts);
              if(typ<0){ typ=intern_add(surf, nsurf, ts); nsurf=nsurf+1; }
            }
            let rel:[]u8=part(line, ps, 1);
            let exp:[]u8=part(line, ps, 2);
            let ctx:[]u8="";
            if(np>=4){ ctx=part(line, ps, 3); }
            let si:i32=intern_find(surf, nsurf, subj);
            if(si<0){ si=intern_add(surf, nsurf, subj); nsurf=nsurf+1; }
            let ri:i32=intern_find(surf, nsurf, rel);
            if(ri<0){ ri=intern_add(surf, nsurf, rel); nsurf=nsurf+1; }
            let ei:i32=-2; // WITHHOLD
            if(!(exp.len==8 && exp[0]==87)){ // not "WITHHOLD"
              ei=intern_find(surf, nsurf, exp);
              if(ei<0){ ei=intern_add(surf, nsurf, exp); nsurf=nsurf+1; }
            }
            let xi:i32=-1;
            if(ctx.len>0){
              xi=intern_find(surf, nsurf, ctx);
              if(xi<0){ xi=intern_add(surf, nsurf, ctx); nsurf=nsurf+1; }
            }
            if(nprobe<128){
              set32(qps,nprobe*4,si); set32(qpr,nprobe*4,ri);
              set32(qpexp,nprobe*4,ei); set32(qpctx,nprobe*4,xi);
              set32(qpph,nprobe*4,cur_phase); set32(qptype,nprobe*4,typ);
              nprobe=nprobe+1;
            }
          }
        }
      }
    }
    at=en+1;
  }
  let maxphase:i32=cur_phase;

  // === build full feature table (all phases, monotonic) ===
  let f:i32=0;
  while(f<nfact){
    let ri0:i32=get32(ffr,f*4);
    let oi0:i32=get32(ffo,f*4);
    let fi:i32=-1;
    let q:i32=0;
    while(q<nfeat){
      if(get32(ffrt,q*4)==ri0 && get32(ffot,q*4)==oi0){ fi=q; }
      q=q+1;
    }
    if(fi<0 && nfeat<256){
      fi=nfeat;
      set32(ffrt,fi*4,ri0); set32(ffot,fi*4,oi0);
      nfeat=nfeat+1;
    }
    f=f+1;
  }

  // === phase loop ===
  let p:i32=0;
  let total_pass:i32=0;
  let total_q:i32=0;
  while(p<=maxphase){
    emit("--- phase ");
    emit(i64s(p as i64));
    emit(" ---\n");

    // rebuild entity features from facts with phase <= p
    let e:i32=0;
    while(e<nentity){ set32(ef_n,e*4,0); e=e+1; }
    f=0;
    while(f<nfact){
      if(get32(ffph,f*4)<=p){
        let si0:i32=get32(ffs,f*4);
        let ee:i32=get32(e_of_s,si0*4);
        if(ee>=0){
          let ri0:i32=get32(ffr,f*4);
          let oi0:i32=get32(ffo,f*4);
          let fi:i32=-1;
          let q:i32=0;
          while(q<nfeat){
            if(get32(ffrt,q*4)==ri0 && get32(ffot,q*4)==oi0){ fi=q; }
            q=q+1;
          }
          if(fi>=0){
            let enn:i32=get32(ef_n,ee*4);
            let has:i32=0;
            let q2:i32=0;
            while(q2<enn){ if(get32(ef,(ee*32+q2)*4)==fi){has=1;} q2=q2+1; }
            if(has==0 && enn<32){
              set32(ef,(ee*32+enn)*4,fi);
              set32(ef_n,ee*4,enn+1);
            }
          }
        }
      }
      f=f+1;
    }

    // init (p==0) or update (p>0) entity concepts
    if(p==0){
      e=0;
      while(e<nentity){
        let found:i32=-1;
        let c:i32=0;
        while(c<ncon){
          if(get32(c_active,c*4)==1){
            let cn0:i32=get32(c_nintent,c*4);
            let en0:i32=get32(ef_n,e*4);
            if(cn0==en0){
              let same:i32=1;
              let q:i32=0;
              while(q<en0){
                let fi0:i32=get32(ef,(e*32+q)*4);
                let has2:i32=0;
                let q3:i32=0;
                while(q3<cn0){ if(get32(c_intent,(c*32+q3)*4)==fi0){has2=1;} q3=q3+1; }
                if(has2==0){same=0;}
                q=q+1;
              }
              if(same==1){found=c;}
            }
          }
          c=c+1;
        }
        if(found>=0){
          let kn:i32=get32(c_nmem,found*4);
          let mm:i32=get32(entities,e*4);
          let hasm:i32=0;
          let ki:i32=0;
          while(ki<kn){ if(get32(c_mem,(found*64+ki)*4)==mm){hasm=1;} ki=ki+1; }
          if(hasm==0 && kn<64){
            set32(c_mem,(found*64+kn)*4,mm);
            set32(c_nmem,found*4,kn+1);
          }
          set32(e_concept,e*4,found);
        } else {
          if(ncon<256){
            let c2:i32=ncon; ncon=ncon+1;
            set32(c_active,c2*4,1);
            set32(c_reason,c2*4,0);
            set32(c_ctx,c2*4,-1);
            set32(c_parent,c2*4,-1);
            let en1:i32=get32(ef_n,e*4);
            set32(c_nintent,c2*4,en1);
            let q:i32=0;
            while(q<en1){ set32(c_intent,(c2*32+q)*4,get32(ef,(e*32+q)*4)); q=q+1; }
            set32(c_nmem,c2*4,1);
            set32(c_mem,(c2*64+0)*4,get32(entities,e*4));
            set32(e_concept,e*4,c2);
          }
        }
        e=e+1;
      }
    } else {
      e=0;
      while(e<nentity){
        let c2:i32=get32(e_concept,e*4);
        // Only update single-member entity-concepts. Multi-member concepts are
        // abstractions; overwriting their intent would clobber shared structure.
        // (Their members' new features are handled via SPLIT/FORM.)
        if(c2>=0 && get32(c_active,c2*4)==1 && get32(c_nmem,c2*4)==1 && get32(c_reason,c2*4)==0){
          let en1:i32=get32(ef_n,e*4);
          set32(c_nintent,c2*4,en1);
          let q:i32=0;
          while(q<en1){ set32(c_intent,(c2*32+q)*4,get32(ef,(e*32+q)*4)); q=q+1; }
        }
        e=e+1;
      }
    }

    // fixpoint: MERGE, SPLIT, FORM
    let iter:i32=0;
    let changed:i32=1;
    while(changed==1 && iter<30){
      changed=0;
      iter=iter+1;
      // ---- MERGE identical intents ----
      let c1:i32=0;
      while(c1<ncon){
        if(get32(c_active,c1*4)==1){
          let c2:i32=c1+1;
          while(c2<ncon){
            if(get32(c_active,c2*4)==1 && get32(c_ctx,c1*4)==get32(c_ctx,c2*4)){
              let n1:i32=get32(c_nintent,c1*4);
              let n2:i32=get32(c_nintent,c2*4);
              if(n1==n2){
                let same:i32=1;
                let q:i32=0;
                while(q<n1){
                  let fi0:i32=get32(c_intent,(c1*32+q)*4);
                  let has2:i32=0;
                  let q3:i32=0;
                  while(q3<n2){ if(get32(c_intent,(c2*32+q3)*4)==fi0){has2=1;} q3=q3+1; }
                  if(has2==0){same=0;}
                  q=q+1;
                }
                if(same==1){
                  let keep:i32=c1;
                  let drop:i32=c2;
                  if(get32(c_reason,c2*4)==0 && get32(c_reason,c1*4)!=0){ keep=c2; drop=c1; }
                  // union members drop->keep
                  let mn:i32=get32(c_nmem,drop*4);
                  let mi:i32=0;
                  while(mi<mn){
                    let mm:i32=get32(c_mem,(drop*64+mi)*4);
                    let kn:i32=get32(c_nmem,keep*4);
                    let hasm:i32=0;
                    let ki:i32=0;
                    while(ki<kn){ if(get32(c_mem,(keep*64+ki)*4)==mm){hasm=1;} ki=ki+1; }
                    if(hasm==0 && kn<64){
                      set32(c_mem,(keep*64+kn)*4,mm);
                      set32(c_nmem,keep*4,kn+1);
                    }
                    mi=mi+1;
                  }
                  // repoint drop's children to keep
                  let chn:i32=get32(c_nchild,drop*4);
                  let chi:i32=0;
                  while(chi<chn){
                    let ch:i32=get32(c_child,(drop*16+chi)*4);
                    if(ch!=keep && get32(c_active,ch*4)==1){
                      set32(c_parent,ch*4,keep);
                      let kchn:i32=get32(c_nchild,keep*4);
                      let hasc:i32=0;
                      let kci:i32=0;
                      while(kci<kchn){ if(get32(c_child,(keep*16+kci)*4)==ch){hasc=1;} kci=kci+1; }
                      if(hasc==0 && kchn<16){
                        set32(c_child,(keep*16+kchn)*4,ch);
                        set32(c_nchild,keep*4,kchn+1);
                      }
                    }
                    chi=chi+1;
                  }
                  // fix drop's parent
                  let pd:i32=get32(c_parent,drop*4);
                  if(pd>=0 && get32(c_active,pd*4)==1){
                    // remove drop from pd children
                    let pchn:i32=get32(c_nchild,pd*4);
                    let w:i32=0;
                    let r2:i32=0;
                    while(r2<pchn){
                      let chv:i32=get32(c_child,(pd*16+r2)*4);
                      if(chv!=drop){
                        set32(c_child,(pd*16+w)*4,chv);
                        w=w+1;
                      }
                      r2=r2+1;
                    }
                    set32(c_nchild,pd*4,w);
                    if(get32(c_parent,keep*4)<0){
                      set32(c_parent,keep*4,pd);
                      let pchn2:i32=get32(c_nchild,pd*4);
                      let hasc2:i32=0;
                      let kci2:i32=0;
                      while(kci2<pchn2){ if(get32(c_child,(pd*16+kci2)*4)==keep){hasc2=1;} kci2=kci2+1; }
                      if(hasc2==0 && pchn2<16){
                        set32(c_child,(pd*16+pchn2)*4,keep);
                        set32(c_nchild,pd*4,pchn2+1);
                      }
                    }
                  }
                  // e_concept repoint
                  let ei2:i32=0;
                  while(ei2<nentity){
                    if(get32(e_concept,ei2*4)==drop){ set32(e_concept,ei2*4,keep); }
                    ei2=ei2+1;
                  }
                  set32(c_active,drop*4,0);
                  changed=1;
                }
              }
            }
            c2=c2+1;
          }
        }
        c1=c1+1;
      }

      // ---- SPLIT contradictions ----
      let sc:i32=0;
      while(sc<ncon){
        if(get32(c_active,sc*4)==1){
          // collect distinct relations among members' facts
          let nrels:i32=0;
          let mi0:i32=0;
          let nm0:i32=get32(c_nmem,sc*4);
          while(mi0<nm0){
            let m0:i32=get32(c_mem,(sc*64+mi0)*4);
            let ff:i32=0;
            while(ff<nfact){
              if(get32(ffs,ff*4)==m0 && get32(ffph,ff*4)<=p){
                let r0:i32=get32(ffr,ff*4);
                let hasr:i32=0;
                let ri2:i32=0;
                while(ri2<nrels){ if(get32(t_rels,ri2*4)==r0){hasr=1;} ri2=ri2+1; }
                if(hasr==0 && nrels<32){ set32(t_rels,nrels*4,r0); nrels=nrels+1; }
              }
              ff=ff+1;
            }
            mi0=mi0+1;
          }
          // for each relation, group by (member, ctx) -> oset
          let rii:i32=0;
          while(rii<nrels){
            let rr:i32=get32(t_rels,rii*4);
            let ng:i32=0;
            mi0=0;
            while(mi0<nm0){
              let m0:i32=get32(c_mem,(sc*64+mi0)*4);
              // distinct ctx values for (m0, rr)
              // gather (x -> oset) in small local lists
              let dxs:[]u8=z_alloc(8*4);
              let ndx:i32=0;
              let ff:i32=0;
              while(ff<nfact){
                if(get32(ffs,ff*4)==m0 && get32(ffr,ff*4)==rr && get32(ffph,ff*4)<=p){
                  let xx:i32=get32(ffx,ff*4);
                  let hasx:i32=0;
                  let xi2:i32=0;
                  while(xi2<ndx){ if(get32(dxs,xi2*4)==xx){hasx=1;} xi2=xi2+1; }
                  if(hasx==0 && ndx<8){ set32(dxs,ndx*4,xx); ndx=ndx+1; }
                }
                ff=ff+1;
              }
              let dxi:i32=0;
              while(dxi<ndx){
                let xx:i32=get32(dxs,dxi*4);
                // oset for (m0, rr, xx)
                let on0:i32=0;
                let oset0:[]u8=z_alloc(8*4);
                ff=0;
                while(ff<nfact){
                  if(get32(ffs,ff*4)==m0 && get32(ffr,ff*4)==rr && get32(ffx,ff*4)==xx && get32(ffph,ff*4)<=p){
                    let oo:i32=get32(ffo,ff*4);
                    let haso:i32=0;
                    let oi2:i32=0;
                    while(oi2<on0){ if(get32(oset0,oi2*4)==oo){haso=1;} oi2=oi2+1; }
                    if(haso==0 && on0<8){ set32(oset0,on0*4,oo); on0=on0+1; }
                  }
                  ff=ff+1;
                }
                if(on0>0 && ng<64){
                  set32(t_gm,ng*4,m0);
                  set32(t_gx,ng*4,xx);
                  set32(t_gon,ng*4,on0);
                  let oi3:i32=0;
                  while(oi3<on0){ set32(t_goset,(ng*8+oi3)*4,get32(oset0,oi3*4)); oi3=oi3+1; }
                  ng=ng+1;
                }
                dxi=dxi+1;
              }
              dxi=0; // (dxs/oset0 leak; fine for v1)
              dxi=dxi+1;
              mi0=mi0+1;
            }
            // distinct osets among groups
            let nd:i32=0;
            let gi:i32=0;
            while(gi<ng){
              let gon:i32=get32(t_gon,gi*4);
              // compare with existing distinct
              let isnew:i32=1;
              let di:i32=0;
              while(di<nd){
                if(get32(t_don,di*4)==gon){
                  let allin:i32=1;
                  let oi4:i32=0;
                  while(oi4<gon){
                    let ov:i32=get32(t_goset,(gi*8+oi4)*4);
                    let fin:i32=0;
                    let oi5:i32=0;
                    while(oi5<gon){ if(get32(t_doset,(di*8+oi5)*4)==ov){fin=1;} oi5=oi5+1; }
                    if(fin==0){allin=0;}
                    oi4=oi4+1;
                  }
                  if(allin==1){isnew=0;}
                }
                di=di+1;
              }
              if(isnew==1 && nd<8){
                set32(t_don,nd*4,gon);
                let oi4:i32=0;
                while(oi4<gon){ set32(t_doset,(nd*8+oi4)*4,get32(t_goset,(gi*8+oi4)*4)); oi4=oi4+1; }
                nd=nd+1;
              }
              gi=gi+1;
            }
            if(nd>=2){
              // contradiction on rr: split
              // union of all o values
              let un:i32=0;
              let di:i32=0;
              while(di<nd){
                let don:i32=get32(t_don,di*4);
                let oi4:i32=0;
                while(oi4<don){
                  let ov:i32=get32(t_doset,(di*8+oi4)*4);
                  let hasu:i32=0;
                  let ui:i32=0;
                  while(ui<un){ if(get32(t_union,ui*4)==ov){hasu=1;} ui=ui+1; }
                  if(hasu==0 && un<16){ set32(t_union,un*4,ov); un=un+1; }
                  oi4=oi4+1;
                }
                di=di+1;
              }
              di=0;
              while(di<nd){
                let don:i32=get32(t_don,di*4);
                // child intent = (parent intent minus (rr, union_o not in S)) plus (rr, S)
                let cin:i32=0;
                let cni0:i32=get32(c_nintent,sc*4);
                let qi:i32=0;
                while(qi<cni0){
                  let fi0:i32=get32(c_intent,(sc*32+qi)*4);
                  let fr0:i32=get32(ffrt,fi0*4);
                  let fo0:i32=get32(ffot,fi0*4);
                  let skip:i32=0;
                  if(fr0==rr){
                    // in union?
                    let inu:i32=0;
                    let ui:i32=0;
                    while(ui<un){ if(get32(t_union,ui*4)==fo0){inu=1;} ui=ui+1; }
                    if(inu==1){
                      // in S?
                      let ins:i32=0;
                      let oi4:i32=0;
                      while(oi4<don){ if(get32(t_doset,(di*8+oi4)*4)==fo0){ins=1;} oi4=oi4+1; }
                      if(ins==0){skip=1;}
                    }
                  }
                  if(skip==0 && cin<32){
                    // dedupe
                    let dup:i32=0;
                    let ci2:i32=0;
                    while(ci2<cin){ if(get32(t_ci,ci2*4)==fi0){dup=1;} ci2=ci2+1; }
                    if(dup==0){ set32(t_ci,cin*4,fi0); cin=cin+1; }
                  }
                  qi=qi+1;
                }
                // add (rr, o) for o in S
                let oi4:i32=0;
                while(oi4<don){
                  let ov:i32=get32(t_doset,(di*8+oi4)*4);
                  // feat index
                  let fi1:i32=-1;
                  let qf:i32=0;
                  while(qf<nfeat){
                    if(get32(ffrt,qf*4)==rr && get32(ffot,qf*4)==ov){fi1=qf;}
                    qf=qf+1;
                  }
                  if(fi1>=0){
                    let dup:i32=0;
                    let ci2:i32=0;
                    while(ci2<cin){ if(get32(t_ci,ci2*4)==fi1){dup=1;} ci2=ci2+1; }
                    if(dup==0 && cin<32){ set32(t_ci,cin*4,fi1); cin=cin+1; }
                  }
                  oi4=oi4+1;
                }
                // child ctx: uniform x among groups with this oset?
                let cx:i32=-2; // -2 = unset
                let cmem_n:i32=0;
                let cmem:[]u8=z_alloc(64*4);
                gi=0;
                while(gi<ng){
                  let gon:i32=get32(t_gon,gi*4);
                  if(gon==don){
                    // compare oset
                    let allin:i32=1;
                    let oi5:i32=0;
                    while(oi5<gon){
                      let ov:i32=get32(t_goset,(gi*8+oi5)*4);
                      let fin:i32=0;
                      let oi6:i32=0;
                      while(oi6<don){ if(get32(t_doset,(di*8+oi6)*4)==ov){fin=1;} oi6=oi6+1; }
                      if(fin==0){allin=0;}
                      oi5=oi5+1;
                    }
                    if(allin==1){
                      let gm0:i32=get32(t_gm,gi*4);
                      let gx0:i32=get32(t_gx,gi*4);
                      // add member
                      let hasm:i32=0;
                      let cmi:i32=0;
                      while(cmi<cmem_n){ if(get32(cmem,cmi*4)==gm0){hasm=1;} cmi=cmi+1; }
                      if(hasm==0 && cmem_n<64){ set32(cmem,cmem_n*4,gm0); cmem_n=cmem_n+1; }
                      if(cx==-2){cx=gx0;}
                      else { if(cx!=gx0){cx=-1;} }
                    }
                  }
                  gi=gi+1;
                }
                if(cx==-2){cx=-1;}
                // check existing active child with same intent+ctx
                let chfound:i32=-1;
                let chn0:i32=get32(c_nchild,sc*4);
                let chi0:i32=0;
                while(chi0<chn0){
                  let ch0:i32=get32(c_child,(sc*16+chi0)*4);
                  if(get32(c_active,ch0*4)==1 && get32(c_ctx,ch0*4)==cx){
                    let cnch:i32=get32(c_nintent,ch0*4);
                    if(cnch==cin){
                      let same:i32=1;
                      let ci3:i32=0;
                      while(ci3<cin){
                        let fv:i32=get32(t_ci,ci3*4);
                        let hasf:i32=0;
                        let ci4:i32=0;
                        while(ci4<cnch){ if(get32(c_intent,(ch0*32+ci4)*4)==fv){hasf=1;} ci4=ci4+1; }
                        if(hasf==0){same=0;}
                        ci3=ci3+1;
                      }
                      if(same==1){chfound=ch0;}
                    }
                  }
                  chi0=chi0+1;
                }
                if(chfound>=0){
                  // union missing members
                  let cmi:i32=0;
                  while(cmi<cmem_n){
                    let gm0:i32=get32(cmem,cmi*4);
                    let kn:i32=get32(c_nmem,chfound*4);
                    let hasm:i32=0;
                    let ki:i32=0;
                    while(ki<kn){ if(get32(c_mem,(chfound*64+ki)*4)==gm0){hasm=1;} ki=ki+1; }
                    if(hasm==0 && kn<64){
                      set32(c_mem,(chfound*64+kn)*4,gm0);
                      set32(c_nmem,chfound*4,kn+1);
                    }
                    cmi=cmi+1;
                  }
                } else {
                  if(ncon<256){
                    let nc:i32=ncon; ncon=ncon+1;
                    set32(c_active,nc*4,1);
                    if(cx>=0){ set32(c_reason,nc*4,5); } else { set32(c_reason,nc*4,2); }
                    set32(c_ctx,nc*4,cx);
                    set32(c_parent,nc*4,sc);
                    set32(c_nintent,nc*4,cin);
                    let ci3:i32=0;
                    while(ci3<cin){ set32(c_intent,(nc*32+ci3)*4,get32(t_ci,ci3*4)); ci3=ci3+1; }
                    set32(c_nmem,nc*4,cmem_n);
                    let cmi:i32=0;
                    while(cmi<cmem_n){ set32(c_mem,(nc*64+cmi)*4,get32(cmem,cmi*4)); cmi=cmi+1; }
                    // link as child of sc
                    let schn:i32=get32(c_nchild,sc*4);
                    if(schn<16){
                      set32(c_child,(sc*16+schn)*4,nc);
                      set32(c_nchild,sc*4,schn+1);
                    }
                    changed=1;
                  }
                }
                di=di+1;
              }
            }
            rii=rii+1;
          }
        }
        sc=sc+1;
      }

      // ---- FORM shared-subset parents ----
      let f1:i32=0;
      while(f1<ncon){
        if(get32(c_active,f1*4)==1 && get32(c_ctx,f1*4)<0){
          let f2:i32=f1+1;
          while(f2<ncon){
            if(get32(c_active,f2*4)==1 && get32(c_ctx,f2*4)<0){
              let shn:i32=0;
              let nn1:i32=get32(c_nintent,f1*4);
              let qi:i32=0;
              while(qi<nn1){
                let fi0:i32=get32(c_intent,(f1*32+qi)*4);
                let nn2:i32=get32(c_nintent,f2*4);
                let has2:i32=0;
                let q3:i32=0;
                while(q3<nn2){ if(get32(c_intent,(f2*32+q3)*4)==fi0){has2=1;} q3=q3+1; }
                if(has2==1 && shn<32){ set32(t_shared,shn*4,fi0); shn=shn+1; }
                qi=qi+1;
              }
              if(shn>0){
                let nn2b:i32=get32(c_nintent,f2*4);
                if(shn==nn1 && shn<nn2b){
                  // intent(f1) is a proper subset of intent(f2): f1 is the abstraction.
                  // Link f2 as child of f1 (if f2 has no parent).
                  if(get32(c_parent,f2*4)<0){
                    set32(c_parent,f2*4,f1);
                    let pchn:i32=get32(c_nchild,f1*4);
                    if(pchn<16){
                      set32(c_child,(f1*16+pchn)*4,f2);
                      set32(c_nchild,f1*4,pchn+1);
                    }
                    changed=1;
                  }
                } else {
                  if(shn<nn1 && shn==nn2b){
                    // intent(f2) is a proper subset of intent(f1): f2 is the abstraction.
                    if(get32(c_parent,f1*4)<0){
                      set32(c_parent,f1*4,f2);
                      let pchn:i32=get32(c_nchild,f2*4);
                      if(pchn<16){
                        set32(c_child,(f2*16+pchn)*4,f1);
                        set32(c_nchild,f2*4,pchn+1);
                      }
                      changed=1;
                    }
                  } else {
                    if(shn<nn1 && shn<nn2b){
                  let exists:i32=0;
                  let ec:i32=0;
                  while(ec<ncon){
                    if(get32(c_active,ec*4)==1 && get32(c_ctx,ec*4)<0){
                      let nec:i32=get32(c_nintent,ec*4);
                      if(nec==shn){
                        let same:i32=1;
                        let qi2:i32=0;
                        while(qi2<shn){
                          let fv:i32=get32(t_shared,qi2*4);
                          let hasf:i32=0;
                          let ci4:i32=0;
                          while(ci4<nec){ if(get32(c_intent,(ec*32+ci4)*4)==fv){hasf=1;} ci4=ci4+1; }
                          if(hasf==0){same=0;}
                          qi2=qi2+1;
                        }
                        if(same==1){exists=1;}
                      }
                    }
                    ec=ec+1;
                  }
                  if(exists==0 && ncon<256){
                    let np2:i32=ncon; ncon=ncon+1;
                    set32(c_active,np2*4,1);
                    set32(c_reason,np2*4,1);
                    set32(c_ctx,np2*4,-1);
                    set32(c_parent,np2*4,-1);
                    set32(c_nintent,np2*4,shn);
                    let qi2:i32=0;
                    while(qi2<shn){ set32(c_intent,(np2*32+qi2)*4,get32(t_shared,qi2*4)); qi2=qi2+1; }
                    let pmn:i32=0;
                    let pe:i32=0;
                    while(pe<nentity){
                      let en0:i32=get32(ef_n,pe*4);
                      let covers:i32=1;
                      let qi3:i32=0;
                      while(qi3<shn){
                        let fv:i32=get32(t_shared,qi3*4);
                        let hasf:i32=0;
                        let qe:i32=0;
                        while(qe<en0){ if(get32(ef,(pe*32+qe)*4)==fv){hasf=1;} qe=qe+1; }
                        if(hasf==0){covers=0;}
                        qi3=qi3+1;
                      }
                      if(covers==1 && pmn<64){
                        set32(c_mem,(np2*64+pmn)*4,get32(entities,pe*4));
                        pmn=pmn+1;
                      }
                      pe=pe+1;
                    }
                    set32(c_nmem,np2*4,pmn);
                    let lc:i32=0;
                    while(lc<ncon){
                      if(get32(c_active,lc*4)==1 && lc!=np2 && get32(c_ctx,lc*4)<0 && get32(c_parent,lc*4)<0){
                        let nlc:i32=get32(c_nintent,lc*4);
                        if(nlc>shn){
                          let sup:i32=1;
                          let qi4:i32=0;
                          while(qi4<shn){
                            let fv:i32=get32(t_shared,qi4*4);
                            let hasf:i32=0;
                            let qc:i32=0;
                            while(qc<nlc){ if(get32(c_intent,(lc*32+qc)*4)==fv){hasf=1;} qc=qc+1; }
                            if(hasf==0){sup=0;}
                            qi4=qi4+1;
                          }
                          if(sup==1){
                            set32(c_parent,lc*4,np2);
                            let pchn:i32=get32(c_nchild,np2*4);
                            if(pchn<16){
                              set32(c_child,(np2*16+pchn)*4,lc);
                              set32(c_nchild,np2*4,pchn+1);
                            }
                          }
                        }
                      }
                      lc=lc+1;
                    }
                    changed=1;
                  }
                }
                } // close else (subset/superset linking)
                } // close outer else
              }
            }
            f2=f2+1;
          }
        }
        f1=f1+1;
      }

    // ---- COMPOSE deliberate union-intent recruitment (reason=6) ----
    // H-COMPOSE prereg (271ec362b). Fires for pairs whose intent union is
    // non-vacuous and not already an exact concept intent.
    if(COMPOSE_ON==1){
      let g1:i32=0;
      while(g1<ncon){
        if(get32(c_active,g1*4)==1 && get32(c_ctx,g1*4)<0){
          let g2:i32=g1+1;
          while(g2<ncon){
            if(get32(c_active,g2*4)==1 && get32(c_ctx,g2*4)<0){
              // U = intent(g1) union intent(g2)
              let un:i32=0;
              let nn1b:i32=get32(c_nintent,g1*4);
              let qi6:i32=0;
              while(qi6<nn1b){
                if(un<32){ set32(t_cunion,un*4,get32(c_intent,(g1*32+qi6)*4)); un=un+1; }
                qi6=qi6+1;
              }
              let nn2c:i32=get32(c_nintent,g2*4);
              qi6=0;
              while(qi6<nn2c){
                let fv6:i32=get32(c_intent,(g2*32+qi6)*4);
                let has6:i32=0;
                let q6:i32=0;
                while(q6<un){ if(get32(t_cunion,q6*4)==fv6){has6=1;} q6=q6+1; }
                if(has6==0 && un<32){ set32(t_cunion,un*4,fv6); un=un+1; }
                qi6=qi6+1;
              }
              // neither subsumes the other: un strictly exceeds both sizes
              let subsumes:i32=0;
              if(un==nn1b || un==nn2c){ subsumes=1; }
              if(subsumes==0 && un<=6 && un>0){
                // non-redundant: no active concept has intent EXACTLY U
                let redun:i32=0;
                let ec6:i32=0;
                while(ec6<ncon){
                  if(get32(c_active,ec6*4)==1 && get32(c_nintent,ec6*4)==un){
                    let same6:i32=1;
                    let q7:i32=0;
                    while(q7<un){
                      let fv7:i32=get32(t_cunion,q7*4);
                      let has7:i32=0;
                      let c7:i32=0;
                      while(c7<un){ if(get32(c_intent,(ec6*32+c7)*4)==fv7){has7=1;} c7=c7+1; }
                      if(has7==0){same6=0;}
                      q7=q7+1;
                    }
                    if(same6==1){redun=1;}
                  }
                  ec6=ec6+1;
                }
                if(redun==0 && ncon<256){
                  // non-vacuous: collect member entities
                  let cmn:i32=0;
                  let pe6:i32=0;
                  while(pe6<nentity){
                    let en6:i32=get32(ef_n,pe6*4);
                    let covers6:i32=1;
                    let q8:i32=0;
                    while(q8<un){
                      let fv8:i32=get32(t_cunion,q8*4);
                      let has8:i32=0;
                      let qe8:i32=0;
                      while(qe8<en6){ if(get32(ef,(pe6*32+qe8)*4)==fv8){has8=1;} qe8=qe8+1; }
                      if(has8==0){covers6=0;}
                      q8=q8+1;
                    }
                    if(covers6==1 && cmn<64){
                      set32(t_cmembers,cmn*4,get32(entities,pe6*4));
                      cmn=cmn+1;
                    }
                    pe6=pe6+1;
                  }
                  if(cmn>=1){
                    let nc6:i32=ncon; ncon=ncon+1;
                    set32(c_active,nc6*4,1);
                    set32(c_reason,nc6*4,6);
                    set32(c_ctx,nc6*4,-1);
                    set32(c_parent,nc6*4,-1);
                    set32(c_nintent,nc6*4,un);
                    let q9:i32=0;
                    while(q9<un){ set32(c_intent,(nc6*32+q9)*4,get32(t_cunion,q9*4)); q9=q9+1; }
                    set32(c_nmem,nc6*4,cmn);
                    q9=0;
                    while(q9<cmn){ set32(c_mem,(nc6*64+q9)*4,get32(t_cmembers,q9*4)); q9=q9+1; }
                    set32(c_nchild,nc6*4,0);
                    // link proper subsets as children; attach to minimal superset
                    let bestpar:i32=-1;
                    let bestpsz:i32=1000000;
                    let lc6:i32=0;
                    while(lc6<ncon){
                      if(get32(c_active,lc6*4)==1 && lc6!=nc6 && get32(c_ctx,lc6*4)<0){
                        let nlc6:i32=get32(c_nintent,lc6*4);
                        if(nlc6<un){
                          let sub6:i32=1;
                          let q10:i32=0;
                          while(q10<nlc6){
                            let fv10:i32=get32(c_intent,(lc6*32+q10)*4);
                            let has10:i32=0;
                            let c10:i32=0;
                            while(c10<un){ if(get32(t_cunion,c10*4)==fv10){has10=1;} c10=c10+1; }
                            if(has10==0){sub6=0;}
                            q10=q10+1;
                          }
                          if(sub6==1 && get32(c_parent,lc6*4)<0){
                            set32(c_parent,lc6*4,nc6);
                            let pchn6:i32=get32(c_nchild,nc6*4);
                            if(pchn6<16){
                              set32(c_child,(nc6*16+pchn6)*4,lc6);
                              set32(c_nchild,nc6*4,pchn6+1);
                            }
                          }
                        } else {
                          if(nlc6>un){
                            let sup6:i32=1;
                            let q11:i32=0;
                            while(q11<un){
                              let fv11:i32=get32(t_cunion,q11*4);
                              let has11:i32=0;
                              let c11:i32=0;
                              while(c11<nlc6){ if(get32(c_intent,(lc6*32+c11)*4)==fv11){has11=1;} c11=c11+1; }
                              if(has11==0){sup6=0;}
                              q11=q11+1;
                            }
                            if(sup6==1 && nlc6<bestpsz){ bestpsz=nlc6; bestpar=lc6; }
                          }
                        }
                      }
                      lc6=lc6+1;
                    }
                    if(bestpar>=0){
                      set32(c_parent,nc6*4,bestpar);
                      let pchn7:i32=get32(c_nchild,bestpar*4);
                      if(pchn7<16){
                        set32(c_child,(bestpar*16+pchn7)*4,nc6);
                        set32(c_nchild,bestpar*4,pchn7+1);
                      }
                    }
                    changed=1;
                  }
                }
              }
            }
            g2=g2+1;
          }
        }
        g1=g1+1;
      }
    } // end COMPOSE

    } // end fixpoint while

    // ---- answer probes for this phase ----
    let pi:i32=0;
    while(pi<nprobe){
      if(get32(qpph,pi*4)==p){
        let si0:i32=get32(qps,pi*4);
        let ri0:i32=get32(qpr,pi*4);
        let exp0:i32=get32(qpexp,pi*4);
        let ctx0:i32=get32(qpctx,pi*4);
        let typ0:i32=get32(qptype,pi*4);
        let ans:i32=-1; // -1 = WITHHOLD
        let ans_kind:i32=0; // 0=none, 1=taught, 2=concept, 3=sibling
        // Step 0: direct taught facts (ground truth; ctx must match or be none)
        let df_o:i32=-1;
        let df_n:i32=0;
        let dff:i32=0;
        while(dff<nfact){
          if(get32(ffs,dff*4)==si0 && get32(ffr,dff*4)==ri0 && get32(ffph,dff*4)<=p){
            let fxx:i32=get32(ffx,dff*4);
            if(fxx<0 || fxx==ctx0){
              let foo:i32=get32(ffo,dff*4);
              if(df_o<0){df_o=foo;}
              else { if(df_o!=foo){df_n=df_n+1;} }
            }
          }
          dff=dff+1;
        }
        if(df_o>=0 && df_n==0){ ans=df_o; ans_kind=1; }
        else {
          if(df_o>=0 && df_n>0){ ans=-1; ans_kind=0; } // contradictory teaching: WITHHOLD
        }
        if(ans<0 && ans_kind==0){
        // Step 1: concept inference (most specific first)
        // direct: best candidate by (ctx_match, intent_size)
        let best:i32=-1;
        let best_score:i32=-1;
        let c:i32=0;
        while(c<ncon){
          if(get32(c_active,c*4)==1){
            let ccx:i32=get32(c_ctx,c*4);
            if(ccx<0 || ccx==ctx0){
              // member?
              let nmc:i32=get32(c_nmem,c*4);
              let ism:i32=0;
              let mi2:i32=0;
              while(mi2<nmc){ if(get32(c_mem,(c*64+mi2)*4)==si0){ism=1;} mi2=mi2+1; }
              if(ism==1){
                let cmatch:i32=0;
                if(ccx>=0 && ccx==ctx0){cmatch=1;}
                let score:i32=cmatch*1000+get32(c_nintent,c*4);
                if(score>best_score){best_score=score; best=c;}
              }
            }
          }
          c=c+1;
        }
        // NOTE: best is the single best; but we want first (ri,*) in order.
        // Collect ordered candidates instead: simple approach, iterate by
        // decreasing score using repeated max-find (few concepts).
        // (uses outer ans/ans_kind)
        // build ordered list of candidates
        let cand:[]u8=z_alloc(256*4);
        let ncand:i32=0;
        let used:[]u8=z_alloc(256*4);
        let ui2:i32=0;
        while(ui2<256){ set32(used,ui2*4,0); ui2=ui2+1; }
        let placed:i32=1;
        while(placed==1){
          placed=0;
          best=-1; best_score=-1;
          c=0;
          while(c<ncon){
            if(get32(c_active,c*4)==1 && get32(used,c*4)==0){
              let ccx:i32=get32(c_ctx,c*4);
              if(ccx<0 || ccx==ctx0){
                let nmc:i32=get32(c_nmem,c*4);
                let ism:i32=0;
                let mi2:i32=0;
                while(mi2<nmc){ if(get32(c_mem,(c*64+mi2)*4)==si0){ism=1;} mi2=mi2+1; }
                if(ism==1){
                  let cmatch:i32=0;
                  if(ccx>=0 && ccx==ctx0){cmatch=1;}
                  let score:i32=cmatch*1000+get32(c_nintent,c*4);
                  if(score>best_score){best_score=score; best=c;}
                }
              }
            }
            c=c+1;
          }
          if(best>=0){
            set32(cand,ncand*4,best);
            ncand=ncand+1;
            set32(used,best*4,1);
            placed=1;
          }
        }
        // direct lookup in order
        let ci5:i32=0;
        while(ci5<ncand && ans<0){
          let cc:i32=get32(cand,ci5*4);
          let nci:i32=get32(c_nintent,cc*4);
          let found_o:i32=-1;
          let found_n:i32=0;
          let qi5:i32=0;
          while(qi5<nci){
            let fi0:i32=get32(c_intent,(cc*32+qi5)*4);
            if(get32(ffrt,fi0*4)==ri0){
              let oo:i32=get32(ffot,fi0*4);
              if(found_o<0){found_o=oo;}
              else { if(found_o!=oo){found_n=found_n+1;} }
            }
            qi5=qi5+1;
          }
          if(found_o>=0 && found_n==0){ ans=found_o; ans_kind=2; }
          else {
            if(found_o>=0 && found_n>0){ ans=-1; ans_kind=0; ci5=ncand; } // ambiguous: stop
          }
          ci5=ci5+1;
        }
        // sibling step (most-specific-preference)
        // Candidates are ordered by decreasing specificity (score).
        // The first candidate with consistent non-empty sibling evidence
        // decides the answer. Conflicting evidence at that level
        // WITHHOLDs; less specific candidates are not consulted.
        if(ans<0 && ans_kind==0){
          ci5=0;
          let decided:i32=0;
          while(ci5<ncand && decided==0){
            let cc:i32=get32(cand,ci5*4);
            let ev_o:i32=-1;
            let ev_n:i32=0;
            let nmc:i32=get32(c_nmem,cc*4);
            let mi2:i32=0;
            while(mi2<nmc){
              let mm:i32=get32(c_mem,(cc*64+mi2)*4);
              if(mm!=si0){
                let me:i32=get32(e_of_s,mm*4);
                if(me>=0){
                  let mec:i32=get32(e_concept,me*4);
                  if(mec>=0 && get32(c_active,mec*4)==1){
                    let nci:i32=get32(c_nintent,mec*4);
                    let qi5:i32=0;
                    while(qi5<nci){
                      let fi0:i32=get32(c_intent,(mec*32+qi5)*4);
                      if(get32(ffrt,fi0*4)==ri0){
                        let oo:i32=get32(ffot,fi0*4);
                        if(ev_o<0){ev_o=oo;}
                        else { if(ev_o!=oo){ev_n=ev_n+1;} }
                      }
                      qi5=qi5+1;
                    }
                  }
                }
              }
              mi2=mi2+1;
            }
            // members of cc's children (more specific entities)
            let nch2:i32=get32(c_nchild,cc*4);
            let chi2:i32=0;
            while(chi2<nch2){
              let ch2:i32=get32(c_child,(cc*16+chi2)*4);
              if(ch2>=0 && get32(c_active,ch2*4)==1){
                let nmch:i32=get32(c_nmem,ch2*4);
                let mi3:i32=0;
                while(mi3<nmch){
                  let mm:i32=get32(c_mem,(ch2*64+mi3)*4);
                  if(mm!=si0){
                    let me:i32=get32(e_of_s,mm*4);
                    if(me>=0){
                      let mec:i32=get32(e_concept,me*4);
                      if(mec>=0 && get32(c_active,mec*4)==1){
                        let nci:i32=get32(c_nintent,mec*4);
                        let qi5:i32=0;
                        while(qi5<nci){
                          let fi0:i32=get32(c_intent,(mec*32+qi5)*4);
                          if(get32(ffrt,fi0*4)==ri0){
                            let oo:i32=get32(ffot,fi0*4);
                            if(ev_o<0){ev_o=oo;}
                            else { if(ev_o!=oo){ev_n=ev_n+1;} }
                          }
                          qi5=qi5+1;
                        }
                      }
                    }
                  }
                  mi3=mi3+1;
                }
              }
              chi2=chi2+1;
            }
            if(ev_o>=0 && ev_n==0){ ans=ev_o; ans_kind=3; decided=1; }
            else {
              if(ev_n>0){ decided=1; } // ambiguous at most specific level: WITHHOLD
            }
            ci5=ci5+1;
          }
        }
        } // end concept inference (skipped if direct taught fact answered)
        // verdict
        let ok:i32=0;
        if(exp0==-2 && ans<0){ok=1;}
        else { if(exp0>=0 && ans==exp0){ok=1;} }
        if(ok==1){total_pass=total_pass+1;}
        total_q=total_q+1;
        emit("Q ");
        if(typ0>=0){ emit(sname(surf,typ0)); emit(" "); }
        emit(sname(surf,si0)); emit(" | "); emit(sname(surf,ri0));
        emit(" => ");
        if(ans<0){emit("WITHHOLD");} else {emit(sname(surf,ans));}
        emit(" (expected ");
        if(exp0==-2){emit("WITHHOLD");} else {emit(sname(surf,exp0));}
        emit(") [");
        if(ok==1){emit("OK");} else {emit("FAIL");}
        emit("]");
        if(ans_kind==3){emit(" sib");}
        emit("\n");
      }
      pi=pi+1;
    }
    p=p+1;
  } // end phase loop

  // === concept dump ===
  emit("# concepts\n");
  let dc:i32=0;
  while(dc<ncon){
    if(get32(c_active,dc*4)==1){
      emit("C ");
      emit(i64s(dc as i64));
      emit(" nintent=");
      emit(i64s(get32(c_nintent,dc*4) as i64));
      emit(" nmem=");
      emit(i64s(get32(c_nmem,dc*4) as i64));
      emit(" parent=");
      emit(i64s(get32(c_parent,dc*4) as i64));
      emit(" reason=");
      emit(i64s(get32(c_reason,dc*4) as i64));
      emit(" ctx=");
      let dccx:i32=get32(c_ctx,dc*4);
      if(dccx<0){emit("none");} else {emit(sname(surf,dccx));}
      emit("\n");
      emit("CI ");
      emit(i64s(dc as i64));
      emit(":");
      let di2:i32=0;
      let dni:i32=get32(c_nintent,dc*4);
      while(di2<dni){
        let fi0:i32=get32(c_intent,(dc*32+di2)*4);
        emit(" ");
        emit(sname(surf,get32(ffrt,fi0*4)));
        emit("=");
        emit(sname(surf,get32(ffot,fi0*4)));
        di2=di2+1;
      }
      emit("\n");
      emit("CM ");
      emit(i64s(dc as i64));
      emit(":");
      let dm2:i32=0;
      let dnm:i32=get32(c_nmem,dc*4);
      while(dm2<dnm){
        emit(" ");
        emit(sname(surf,get32(c_mem,(dc*64+dm2)*4)));
        dm2=dm2+1;
      }
      emit("\n");
    }
    dc=dc+1;
  }
  emit("SCORE ");
  emit(i64s(total_pass as i64));
  emit("/");
  emit(i64s(total_q as i64));
  emit("\n");
  emit("# fdcr done\n");
  return 0;
}

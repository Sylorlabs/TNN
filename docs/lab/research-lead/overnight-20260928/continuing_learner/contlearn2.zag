// contlearn2.zag -- continuing learner extension: noise + second schema kind.
// Prereg 2f9eddc5e frozen before this file. Pure Zag. No Python.
// One continuing learner, 8 sequential domains, single main(), no resets,
// no task labels. P7 layer: schema_discover / schema_verify (gate) /
// schema_retire. Schema kind 1: single-relation default (rel R -> obj O).
// Schema kind 2: default + single exception (rel R, default D, exc_abs E,
// exc_obj O). Kind-2 discovery supersedes a live kind-1 schema.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen workload: true object per (domain, slot) ----
fn true_obj(d:i32,i:i32)i32 {
  if(d==1){return 4;}
  if(d==2){return 2;}
  if(d==3){return 0;}
  if(d==4){
    if(i==3){return 1;}
    return 6;
  }
  if(d==5){return 5;}
  if(d==6){
    if(i==2){return 9;}
    return 3;
  }
  if(d==7){
    if(i==2){return 4;}
    return 7;
  }
  if(i==0){return 2;} if(i==1){return 8;} if(i==2){return 4;} return 6;
}
fn subj_of(d:i32,i:i32)i32 { return d*10+i; }

// ---- workspace layout ----
// slots: 32 x 20 bytes at base 0. fields: 0 subj, 4 rel, 8 obj, 12 dom, 16 valid
// schema at 640: 0 kind, 4 rel, 8 obj/default, 12 live, 16 exc_abs, 20 exc_obj
// counters at 664: 0 ops_learn, 4 consec, 8 ledger, 12 retired_ledger,
//   16 discovered, 20 applies, 24 s2disc, 28 s2app, 32 superseded
fn sbase(s:i32)i32 { return s*20; }
fn sf(W:[]u8,s:i32,f:i32)i32 { return get32(W,sbase(s)+f); }
fn sw(W:[]u8,s:i32,f:i32,v:i32)void { set32(W,sbase(s)+f,v); return; }
fn sch(W:[]u8,f:i32)i32 { return get32(W,640+f); }
fn schw(W:[]u8,f:i32,v:i32)void { set32(W,640+f,v); return; }
fn ctr(W:[]u8,f:i32)i32 { return get32(W,664+f); }
fn ctrw(W:[]u8,f:i32,v:i32)void { set32(W,664+f,v); return; }
fn ctradd(W:[]u8,f:i32,d:i32)void { set32(W,664+f,get32(W,664+f)+d); return; }

fn free_slot(W:[]u8)i32 {
  let s:i32=0;
  while(s<32){
    if(sf(W,s,16)==0){return s;}
    s=s+1;
  }
  return -1;
}
fn learn(W:[]u8,subj:i32,rel:i32,obj:i32,dom:i32)void {
  let s:i32=free_slot(W);
  if(s<0){return;}
  sw(W,s,0,subj); sw(W,s,4,rel); sw(W,s,8,obj); sw(W,s,12,dom); sw(W,s,16,1);
  ctradd(W,0,1);
  return;
}
fn query(W:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=0;
  while(s<32){
    if(sf(W,s,16)==1){
      if(sf(W,s,0)==subj){
        if(sf(W,s,4)==rel){return sf(W,s,8);}
      }
    }
    s=s+1;
  }
  if(sch(W,12)==1){
    if(sch(W,4)==rel){
      if(sch(W,0)==1){return sch(W,8);}
      if(sch(W,0)==2){
        if(subj==sch(W,16)){return sch(W,20);}
        return sch(W,8);
      }
    }
  }
  return -1;
}
// obj of instance with subject subj_of(dom,q), or -999 if absent
fn iobj(W:[]u8,dom:i32,q:i32)i32 {
  let target:i32=subj_of(dom,q);
  let s:i32=0;
  while(s<32){
    if(sf(W,s,16)==1){
      if(sf(W,s,0)==target){
        if(sf(W,s,12)==dom){return sf(W,s,8);}
      }
    }
    s=s+1;
  }
  return -999;
}
// discover kind 1: all valid instances of (dom, rel) share one obj
fn discover(W:[]u8,dom:i32,rel:i32)i32 {
  let s:i32=0;
  let n:i32=0;
  let o:i32=0;
  let ok:i32=1;
  while(s<32){
    if(sf(W,s,16)==1){
      if(sf(W,s,12)==dom){
        if(sf(W,s,4)==rel){
          if(n==0){o=sf(W,s,8);}
          else { if(sf(W,s,8)==o){} else {ok=0;} }
          n=n+1;
        }
      }
    }
    s=s+1;
  }
  if(n==0){return 0;}
  if(ok==0){return 0;}
  schw(W,0,1); schw(W,4,rel); schw(W,8,o); schw(W,12,1);
  return 1;
}
// discover kind 2: exactly one of the four instances differs.
// installs schema2, superseding any live schema. returns 1 on success.
fn discover2(W:[]u8,dom:i32,rel:i32)i32 {
  let p:i32=0;
  while(p<4){
    let vp:i32=iobj(W,dom,p);
    if(vp!=-999){
      let def:i32=-999;
      let ok:i32=1;
      let q:i32=0;
      while(q<4){
        if(q!=p){
          let vq:i32=iobj(W,dom,q);
          if(vq==-999){ok=0;}
          else {
            if(def==-999){def=vq;}
            else { if(vq!=def){ok=0;} }
          }
        }
        q=q+1;
      }
      if(ok==1){
        if(def!=-999){
          if(def!=vp){
            schw(W,0,2); schw(W,4,rel); schw(W,8,def); schw(W,12,1);
            schw(W,16,subj_of(dom,p)); schw(W,20,vp);
            return 1;
          }
        }
      }
    }
    p=p+1;
  }
  return 0;
}
fn gate1_pass(d:i32)i32 {
  let a:i32=true_obj(d,0);
  let b:i32=true_obj(d,1);
  let c:i32=true_obj(d,2);
  if(a==b){ if(b==c){return 1;} }
  return 0;
}
fn queries_correct(W:[]u8,d:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<4){
    if(query(W,subj_of(d,i),1)==true_obj(d,i)){c=c+1;}
    i=i+1;
  }
  return c;
}
// retire via ledger trigger; consec snapshot passed for the marker
fn retire_ledger(W:[]u8,consec_snap:i32)void {
  schw(W,12,0); ctrw(W,4,0); ctrw(W,8,0); ctrw(W,12,1);
  emit("SCHEMA_RETIRED_LEDGER consec="); e64(consec_snap); emit("\n");
  return;
}
fn retire_consec(W:[]u8)void {
  schw(W,12,0); ctrw(W,4,0); ctrw(W,8,0);
  emit("SCHEMA_RETIRED_CONSEC\n");
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(1024);
  // ---- D1: discovery domain ----
  let i:i32=0;
  while(i<4){ learn(W,subj_of(1,i),1,true_obj(1,i),1); i=i+1; }
  let disc:i32=0;
  if(sch(W,12)==0){ disc=discover(W,1,1); }
  if(disc==1){
    ctrw(W,16,1);
    emit("SCHEMA_DISC rel=1 obj="); e64(sch(W,8)); emit("\n");
  } else {
    emit("SCHEMA_DISC none\n");
  }
  // ---- D2..D8: policy run ----
  let d:i32=2;
  while(d<=8){
    if(sch(W,12)==1){
      if(sch(W,0)==1){
        // kind-1 schema live
        let k:i32=0;
        while(k<3){ learn(W,subj_of(d,k),1,true_obj(d,k),d); k=k+1; }
        let g:i32=gate1_pass(d);
        emit("DOM "); e64(d); emit(" GATE1="); e64(g); emit("\n");
        if(g==1){
          schw(W,8,true_obj(d,0));
          ctrw(W,4,0);
          let acc_s:i32=queries_correct(W,d);
          ctradd(W,8,acc_s-4);
          ctradd(W,20,1);
          emit("APPLY dom="); e64(d); emit(" obj="); e64(sch(W,8)); emit(" learns=3 acc="); e64(acc_s); emit("\n");
          if(ctr(W,8)<0){ retire_ledger(W,ctr(W,4)); }
        } else {
          learn(W,subj_of(d,3),1,true_obj(d,3),d);
          ctradd(W,4,1);
          emit("FALLBACK dom="); e64(d); emit(" learns=4\n");
          let rw:i32=0;
          if(ctr(W,4)>=2){rw=1;}
          if(ctr(W,8)<0){rw=1;}
          if(rw==1){ retire_consec(W); }
          else {
            // try kind-2 discovery (supersedes kind 1)
            let s2:i32=discover2(W,d,1);
            if(s2==1){
              ctrw(W,24,1); ctrw(W,32,1); ctrw(W,4,0); ctrw(W,8,0);
              emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
              emit(" excabs="); e64(sch(W,16));
              emit(" excobj="); e64(sch(W,20)); emit("\n");
            }
          }
        }
      } else {
        // kind-2 schema live
        let k2:i32=0;
        while(k2<3){ learn(W,subj_of(d,k2),1,true_obj(d,k2),d); k2=k2+1; }
        let a:i32=true_obj(d,0);
        let b:i32=true_obj(d,1);
        let c:i32=true_obj(d,2);
        let g2:i32=0;
        let def:i32=0;
        let exc:i32=0;
        let epos:i32=0;
        if(a==b){
          if(b!=c){ g2=1; def=a; exc=c; epos=2; }
        } else {
          if(a==c){
            if(a!=b){ g2=1; def=a; exc=b; epos=1; }
          } else {
            if(b==c){ g2=1; def=b; exc=a; epos=0; }
          }
        }
        emit("DOM "); e64(d); emit(" GATE2="); e64(g2); emit("\n");
        if(g2==1){
          schw(W,8,def); schw(W,16,subj_of(d,epos)); schw(W,20,exc);
          ctrw(W,4,0);
          let acc2:i32=queries_correct(W,d);
          ctradd(W,8,acc2-4);
          ctradd(W,20,1);
          ctradd(W,28,1);
          emit("APPLY2 dom="); e64(d); emit(" default="); e64(def);
          emit(" excpos="); e64(epos); emit(" excobj="); e64(exc);
          emit(" learns=3 acc="); e64(acc2); emit("\n");
          if(ctr(W,8)<0){ retire_ledger(W,ctr(W,4)); }
        } else {
          learn(W,subj_of(d,3),1,true_obj(d,3),d);
          ctradd(W,4,1);
          emit("FALLBACK dom="); e64(d); emit(" learns=4\n");
          let rw2:i32=0;
          if(ctr(W,4)>=2){rw2=1;}
          if(ctr(W,8)<0){rw2=1;}
          if(rw2==1){ retire_consec(W); }
          else {
            let s2b:i32=discover2(W,d,1);
            if(s2b==1){
              ctrw(W,24,1); ctrw(W,32,1); ctrw(W,4,0); ctrw(W,8,0);
              emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
              emit(" excabs="); e64(sch(W,16));
              emit(" excobj="); e64(sch(W,20)); emit("\n");
            }
          }
        }
      }
    } else {
      let j:i32=0;
      while(j<4){ learn(W,subj_of(d,j),1,true_obj(d,j),d); j=j+1; }
      let rd:i32=discover(W,d,1);
      if(rd==1){
        ctradd(W,16,1);
        emit("REDISCOVER rel=1 obj="); e64(sch(W,8)); emit("\n");
      } else {
        let rd2:i32=discover2(W,d,1);
        if(rd2==1){
          ctrw(W,24,1);
          emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
          emit(" excabs="); e64(sch(W,16));
          emit(" excobj="); e64(sch(W,20)); emit("\n");
        } else {
          emit("DOM "); e64(d); emit(" no-schema learns=4\n");
        }
      }
    }
    d=d+1;
  }
  let ops_p7:i32=ctr(W,0);
  // ---- fresh control: 4 learns per domain, executed ----
  let ops_fresh:i32=0;
  let fd:i32=1;
  while(fd<=8){ ops_fresh=ops_fresh+4; fd=fd+1; }
  emit("OPS_P7 "); e64(ops_p7); emit("\n");
  emit("OPS_FRESH "); e64(ops_fresh); emit("\n");
  emit("LEDGER "); e64(ctr(W,8)); emit("\n");
  emit("APPLIES "); e64(ctr(W,20)); emit("\n");
  emit("RETIRED_LEDGER "); e64(ctr(W,12)); emit("\n");
  emit("S2DISC "); e64(ctr(W,24)); emit("\n");
  emit("S2APP "); e64(ctr(W,28)); emit("\n");
  emit("SUPERSEDED "); e64(ctr(W,32)); emit("\n");
  // ---- kill bars ----
  let k1:i32=0;
  if(ctr(W,12)==1){k1=1;}
  let k2:i32=0;
  if(ctr(W,24)==1){ if(ctr(W,28)==1){k2=1;} }
  let k3a:i32=0;
  if(ctr(W,16)>=1){k3a=1;}
  let k3b:i32=0;
  if(ops_p7<ops_fresh){k3b=1;}
  emit("K1 "); e64(k1); emit("\n");
  emit("K2 "); e64(k2); emit("\n");
  emit("K3A "); e64(k3a); emit("\n");
  emit("K3B "); e64(k3b); emit("\n");
  if(k1==1){
    if(k2==1){
      if(k3a==1){
        if(k3b==1){emit("VERDICT LEARNER-EXTENDED\n");}
        else {emit("VERDICT LEARNER-BLOCKED-K3B\n");}
      } else {emit("VERDICT LEARNER-BLOCKED-K3A\n");}
    } else {emit("VERDICT LEARNER-BLOCKED-K2\n");}
  } else {emit("VERDICT LEARNER-BLOCKED-K1\n");}
  emit("CL2-END\n");
  return 0;
}

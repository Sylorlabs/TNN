// rt_attack.zag -- INTEG-BREAK redteam attack driver (pristine sources).
//
// Minimal reproductions of the three C295 integration breaks:
//   T1 self-referential FACT substitution (ts_specialize_src, K3)
//   T2 circular self-verification (K5)
//   T3 value-replay vs live-fact execution gap (t2_exec, I5)
// This driver is harness, not cognition. Output via emit/e64 only.
// No researcher answer is consulted anywhere.

// ---------- driver helpers ----------
fn rt_has_edge(W:[]u8,from:i32,typ:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==typ && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// Build a native MAP node over a t2_asm_chain graph (mirrors the
// adapt_promote layout, minus fact teaching). v holds nl+1 values,
// f holds nl licensing fact ids.
fn rt_mk_native(W:[]u8,s:i32,r:i32,v:[]u8,f:[]u8,nl:i32)i32 {
  let root:i32=t2_asm_chain(W,v,nl+1,f);
  if(root<0){return -1;}
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  ns(W,m,20,root); ns(W,m,24,hg(W,24)); ns(W,m,36,1);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nl){link_edge(W,m,1,get32(f,i*4),0); i=i+1;}
  return m;
}
// First live MAP with relseq [rs] carrying ET_DEP to fact dep.
fn rt_find_relseq_dep(W:[]u8,rs:i32,dep:i32)i32 {
  let m:i32=2; let hit:i32=-1;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let sq:[]u8=z_alloc(28);
      let L:i32=cc_relseq(W,m,sq,7);
      if(L==1 && get32(sq,0)==rs && rt_has_edge(W,m,1,dep)==1){hit=m;}
    }
    m=m+1;
  }
  return hit;
}
// Max pred_score over live FACTs matching (s,r,o); -999999 if none.
fn rt_fact_maxscore(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let best:i32=-999999; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if(ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){
        let sc:i32=ng(W,n,8);
        if(sc>best){best=sc;}
      }
    }
    n=n+1;
  }
  return best;
}
fn rt_newest_map(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){best=m;}
    m=m+1;
  }
  return best;
}
fn rt_count15(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){c=c+1;}
    e=e+1;
  }
  return c;
}

// ---------- T1-A1: mechanism repro ----------
fn t1_a1(W:[]u8,out:[]u8)void {
  emit("=== T1-A1 self-referential substitution ===\n");
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,2,99);
  let fl:i32=ev_teach_in(W,11,71,14);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,99);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,74,vv,ff,2);
  emit("MAPX="); e64(mx); emit(" FL="); e64(fl); emit("\n");
  let n:i32=ts_specialize_src(W,mx,11,0,mx);
  emit("SPEC-N="); e64(n); emit("\n");
  let hit:i32=rt_find_relseq_dep(W,71,fl);
  emit("SELFREF-MAP="); e64(hit); emit("\n");
  let ok:i32=0;
  if(n>=1 && hit>=2){ok=1;}
  if(ok==1){emit("T1-A1=PASS\n");} else {emit("T1-A1=FAIL\n");}
  set32(out,0,ok);
  return;
}

// ---------- T1-A2: characterization matrix ----------
// mode 1: world-channeled alternative; 2: learner-channeled;
// 3: same-relation learner fact; 4: superseded learner fact;
// 5: killed learner fact. Returns 1 if a [71] trial was created.
fn t1_a2_one(W:[]u8,mode:i32)i32 {
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,2,99);
  let fa:i32=-1;
  if(mode==1){fa=ev_teach(W,11,71,14);}
  else {
    if(mode==3){fa=ev_teach_in(W,11,1,50);}
    else {fa=ev_teach_in(W,11,71,14);}
  }
  if(mode==4){link_edge(W,fa,3,fa,0);}
  if(mode==5){ns(W,fa,36,0);}
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,99);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,74,vv,ff,2);
  ts_specialize_src(W,mx,11,0,mx);
  let hit:i32=rt_find_relseq_dep(W,71,fa);
  if(hit>=2){return 1;}
  return 0;
}
fn t1_a2(W:[]u8,out:[]u8)void {
  emit("=== T1-A2 characterization matrix ===\n");
  let got:[]u8=z_alloc(20);
  let i:i32=0;
  while(i<5){
    let Wm:[]u8=z_alloc(110656); tnn2_init(Wm);
    let r:i32=t1_a2_one(Wm,i+1);
    set32(got,i*4,r);
    emit("C"); e64(i+1); emit("="); e64(r); emit("\n");
    i=i+1;
  }
  // want: 1 1 0 0 0
  let ok:i32=0;
  if(get32(got,0)==1 && get32(got,4)==1 && get32(got,8)==0 && get32(got,12)==0 && get32(got,16)==0){ok=1;}
  if(ok==1){emit("T1-A2=PASS\n");} else {emit("T1-A2=FAIL\n");}
  set32(out,0,ok);
  return;
}

// ---------- T1-A3: end-to-end observation pollution ----------
fn t1_a3(W:[]u8,out:[]u8)void {
  emit("=== T1-A3 explore pollution ===\n");
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,2,99);
  let fw:i32=ev_teach(W,11,3,12);
  let fl:i32=ev_teach_in(W,11,71,14);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,99);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,74,vv,ff,2);
  emit("MAPX="); e64(mx); emit(" FW="); e64(fw); emit(" FL="); e64(fl); emit("\n");
  let c:i32=0;
  while(c<4){
    integ_explore(W,11,74,3,0,0);
    c=c+1;
  }
  let selfref:i32=rt_find_relseq_dep(W,71,fl);
  let sc99:i32=rt_fact_maxscore(W,11,74,99);
  emit("SELFREF-MAP="); e64(selfref);
  emit(" SCORE-74-99="); e64(sc99); emit("\n");
  let ok:i32=0;
  if(selfref>=2 && sc99<3){ok=1;}
  if(ok==1){emit("T1-A3=PASS\n");} else {emit("T1-A3=FAIL\n");}
  set32(out,0,ok);
  return;
}

// ---------- T2-A1: confident-wrong via circular verification ----------
fn t2_setup(W:[]u8,out:[]u8)void {
  // out[0]=mx, out[1]=fs, out[2]=m70 (or -1)
  let a:i32=ev_teach(W,201,1,202);
  let b:i32=ev_teach(W,202,2,209);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,201); set32(vv,4,202); set32(vv,8,209);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,a); set32(ff,4,b);
  let mx:i32=rt_mk_native(W,201,70,vv,ff,2);
  let fs:i32=ev_teach_in(W,201,70,209);
  let c:i32=0;
  while(c<3){ lv_predict(W,201,70); lv_observe(W,201,70,209); c=c+1; }
  let nsp:i32=ts_specialize_src(W,mx,201,0,mx);
  let m70:i32=rt_find_relseq_dep(W,70,fs);
  emit("T2 setup: MX="); e64(mx); emit(" FS="); e64(fs);
  emit(" FSscore="); e64(ng(W,fs,8));
  emit(" SPEC-N="); e64(nsp); emit(" M70="); e64(m70); emit("\n");
  set32(out,0,mx); set32(out,4,fs); set32(out,8,m70); set32(out,12,b);
  return;
}
fn t2_a1(W:[]u8,out:[]u8)void {
  emit("=== T2-A1 circular self-verification ===\n");
  let so:[]u8=z_alloc(16);
  t2_setup(W,so);
  let m70:i32=get32(so,8);
  let b2:i32=get32(so,12);
  // world change: teach-then-kill at the frontier (teach first so the
  // killed node is not recycled for the new fact)
  ev_teach(W,201,1,202);
  let dd:i32=ev_teach(W,202,2,205);
  ns(W,b2,36,0);
  emit("WORLD-CHANGE done (killed fact "); e64(b2); emit(")\n");
  let lf:i32=t2_lu_first(W,202,2);
  let wtruth:i32=-999999;
  if(lf>=0){wtruth=ng(W,lf,28);}
  emit("WTRUTH-202-2="); e64(wtruth); emit(" (fact "); e64(lf); emit(")\n");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let p0:i32=lv_setup(W,201,70);
  let rel0:i32=hg(W,36);
  emit("PRED="); e64(p0); emit(" REL="); e64(rel0); emit("\n");
  let q1:i32=compose_integ(W,201,70,0,st);
  emit("T2-Q1="); e64(q1); emit("\n");
  let mz:i32=rt_newest_map(W);
  let linkok:i32=rt_has_edge(W,mz,14,m70);
  emit("MAP_Z="); e64(mz); emit(" LINK14toM70="); e64(linkok); emit("\n");
  let ok:i32=0;
  if(m70>=2 && q1==209 && rel0>=3 && linkok==1 && wtruth==205){ok=1;}
  if(ok==1){emit("T2-A1=PASS\n");} else {emit("T2-A1=FAIL\n");}
  set32(out,0,ok); set32(out,4,m70); set32(out,8,mz);
  return;
}
// ---------- T2-A2: entrenchment ----------
fn t2_a2(W:[]u8,prev:[]u8,out:[]u8)void {
  emit("=== T2-A2 entrenchment ===\n");
  let m70:i32=get32(prev,4);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q2:i32=compose_integ(W,201,70,0,st);
  let mz2:i32=rt_newest_map(W);
  let linkok2:i32=rt_has_edge(W,mz2,14,m70);
  emit("T2-Q2="); e64(q2); emit(" MAP_Z2="); e64(mz2);
  emit(" LINK14toM70="); e64(linkok2); emit("\n");
  ns(W,m70,36,0);
  emit("M70 retired\n");
  let st3:[]u8=z_alloc(8); set32(st3,0,0); set32(st3,4,0);
  let q3:i32=compose_integ(W,201,70,0,st3);
  let c15:i32=rt_count15(W);
  emit("T2-Q3="); e64(q3); emit(" TYPE15-COUNT="); e64(c15); emit("\n");
  let ok:i32=0;
  if(q2==209 && linkok2==1 && q3==209){ok=1;}
  if(ok==1){emit("T2-A2=PASS\n");} else {emit("T2-A2=FAIL\n");}
  set32(out,0,ok);
  return;
}

// ---------- T3-A1: replay vs re-derive divergence ----------
fn t3_a1(W:[]u8,out:[]u8)void {
  emit("=== T3-A1 execution gap ===\n");
  let a:i32=ev_teach(W,201,1,202);
  let b:i32=ev_teach(W,202,2,209);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,201); set32(vv,4,202); set32(vv,8,209);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,a); set32(ff,4,b);
  let mx:i32=rt_mk_native(W,201,70,vv,ff,2);
  let root:i32=ng(W,mx,20);
  let e0:i32=t2_exec(W,root,201);
  emit("PREKILL-EXEC="); e64(e0); emit("\n");
  // teach-then-kill: teach first so the killed node is not recycled
  let dd:i32=ev_teach(W,202,2,205);
  ns(W,b,36,0);
  emit("WORLD-CHANGE done (kill 202-2-209 fact "); e64(b); emit(", teach 202-2-205 fact "); e64(dd); emit(")\n");
  let rs:i32=cc_relseq(W,mx,vv,7);
  let vb:[]u8=z_alloc(32); let fb:[]u8=z_alloc(28);
  let ln:i32=un_satisfy(W,mx,201,vb,fb);
  let nv:i32=-999999;
  if(ln>=1){nv=get32(vb,ln*4);}
  let e1:i32=t2_exec(W,root,201);
  let lf:i32=t2_lu_first(W,202,2);
  let lv:i32=-999999;
  if(lf>=0){lv=ng(W,lf,28);}
  emit("CC_RELSEQ="); e64(rs);
  emit(" UNSAT_LN="); e64(ln); emit(" UNSAT_NV="); e64(nv);
  emit(" POSTKILL-EXEC="); e64(e1);
  emit(" LU202="); e64(lf); emit(" LUVAL="); e64(lv); emit("\n");
  let ok:i32=0;
  if(e0==209 && rs==-1 && ln>=1 && nv==205 && e1==209 && lv==205){ok=1;}
  if(ok==1){emit("T3-A1=PASS\n");} else {emit("T3-A1=FAIL\n");}
  set32(out,0,ok);
  return;
}

fn main()i32 {
  emit("RT-ATTACK-START\n");
  let o1:[]u8=z_alloc(8);
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); t1_a1(W1,o1);
  let o2:[]u8=z_alloc(8);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); t1_a2(W2,o2);
  let o3:[]u8=z_alloc(8);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); t1_a3(W3,o3);
  let t1ok:i32=0;
  if(get32(o1,0)==1 && get32(o2,0)==1 && get32(o3,0)==1){t1ok=1;}
  if(t1ok==1){emit("T1-ATTACK=PASS\n");} else {emit("T1-ATTACK=FAIL\n");}
  let o4:[]u8=z_alloc(12);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); t2_a1(W4,o4);
  let o5:[]u8=z_alloc(8);
  t2_a2(W4,o4,o5);
  let t2ok:i32=0;
  if(get32(o4,0)==1 && get32(o5,0)==1){t2ok=1;}
  if(t2ok==1){emit("T2-ATTACK=PASS\n");} else {emit("T2-ATTACK=FAIL\n");}
  let o6:[]u8=z_alloc(8);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); t3_a1(W5,o6);
  let t3ok:i32=get32(o6,0);
  if(t3ok==1){emit("T3-ATTACK=PASS\n");} else {emit("T3-ATTACK=FAIL\n");}
  emit("RT-ATTACK-END\n");
  return 0;
}

// integ_patch.zag -- H-COMPINTEG-1 integration layer.
//
// One learner combining three validated pieces:
//   L2 adaptation operators (adapt_extend, adapt_truncate,
//     adapt_specialize, adapt_revise2) from the C278 family,
//   learner-owned verification (lv_setup, lv_predict, lv_observe,
//     lv_dfs, lv_verify_chain) from C280,
//   learner self-wiring (LINK14 provenance, type-15 co-use,
//     type-16 adapted-from edges) written by learner promotion code.
//
// compose_integ takes NO researcher-provided answer. integ_explore is
// the ungated experience-gathering counterpart (mirrors C280's
// evidence phase): it adapts, executes, observes, and never promotes.
//
// KIND-COMPLETION (preregistered): the frozen adapt_extend predates
// Amendment 1 kind-recording, so its MAPs carry field 12 = -1 and
// ts_kind would misdispatch them when stale (relseq inference fails
// on unreadable relseqs, falls through to kind 3). integ_tag_extend
// records kind 1 on extend adaptations lacking a recorded kind.
// Truncate/specialize already record 2/3 at promotion.
//
// REBIND is excluded by signature: rebind_try takes a researcher
// answer and no learner-verified variant exists.
//
// Zero modes, bridges, handlers, semantic cases, new opcodes, or new
// MAP/edge types. Output via emit/e64 only.

// Record kind 1 on live adapted MAPs lacking a recorded kind.
// Returns the count tagged.
fn integ_tag_extend(W:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    let adapted:i32=0;
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,12)==-1){
      let e:i32=0;
      while(e<4096 && adapted==0){
        if(eg(W,e,0)==m && eg(W,e,4)==16){adapted=1;}
        e=e+1;
      }
    }
    if(adapted==1){ns(W,m,12,1); n=n+1;}
    m=m+1;
  }
  return n;
}

// 1 iff m is a live adapted MAP whose recorded kind equals k.
fn integ_kind_is(W:[]u8,m:i32,k:i32)i32 {
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  if(rev_is_adapted(W,m)!=1){return 0;}
  let src:i32=rev_src(W,m);
  if(src<2){return 0;}
  if(ts_kind(W,src,m)!=k){return 0;}
  return 1;
}

// Ungated experience gathering (preregistered explore/exploit split).
// Runs one adaptation operator (op: 1=extend, 2=truncate,
// 3=specialize), executes each resulting kind-matching adapted MAP
// from s through live world facts, and observes each outcome with
// lv_observe so the learner scores its own prior prediction.
// If retire==1 the trial MAPs are retired afterwards. Never promotes
// MAP_Z. Returns the last observed value, or -999999.
fn integ_explore(W:[]u8,s:i32,r:i32,op:i32,retire:i32,masked:i32)i32 {
  let nmk:i32=0;
  if(op==1){nmk=adapt_extend(W,s,masked); integ_tag_extend(W);}
  if(op==2){nmk=adapt_truncate(W,s,masked);}
  if(op==3){nmk=adapt_specialize(W,s,masked);}
  emit("INTEG-EXPLORE op="); e64(op);
  emit(" created="); e64(nmk); emit("\n");
  let last:i32=-999999;
  let m:i32=2;
  while(m<1024){
    if(integ_kind_is(W,m,op)==1){
      let v:i32=t2_exec(W,ng(W,m,20),s);
      if(v!=-999999 && v!=-2){
        let pr:i32=lv_predict(W,s,r);
        emit("INTEG-EXPLORE-EXEC m="); e64(m);
        emit(" v="); e64(v);
        emit(" pred="); e64(pr); emit("\n");
        lv_observe(W,s,r,v);
        last=v;
      }
    }
    m=m+1;
  }
  if(retire==1){
    m=2;
    while(m<1024){
      if(rev_is_adapted(W,m)==1){ns(W,m,36,0);}
      m=m+1;
    }
  }
  return last;
}

// Assemble the lv_dfs segments, verify against the learner
// prediction, promote with learner self-wiring. Shared by the native
// and post-adaptation paths of compose_integ. Returns the verified
// answer, or -2.
fn integ_assemble(W:[]u8,s:i32,r:i32,nseg:i32,oseg:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8,st:[]u8)i32 {
  let roots:[]u8=z_alloc(32);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=lv_verify_chain(W,full,s,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(288);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*4),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      let w1:i32=cb_couse_link(W,get32(oseg,g*4),get32(oseg,(g-1)*4));
      g=g+1;
    }
  }
  emit("INTEG-COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*4)); g=g+1;}
  emit("\n");
  return v2;
}

// The integrated learner operation. Learner prediction gate, then
// native learner-verified DFS, then the L2 adaptation bracket
// (kind-dispatched revision, else fresh extend/truncate/specialize),
// then learner-verified DFS over the augmented set, then execution
// verification against the LEARNER prediction and promotion with
// learner self-wiring. No researcher-provided answer anywhere.
// Returns ans (>=0), -2 clean reject, -3 withheld.
fn compose_integ(W:[]u8,s:i32,r:i32,masked:i32,st:[]u8)i32 {
  let p:i32=lv_setup(W,s,r);
  if(p==-999999){
    emit("INTEG-WITHHOLD nobasis\n");
    return -3;
  }
  if(hg(W,36)<lv_rel_thresh()){
    emit("INTEG-WITHHOLD unreliable rel="); e64(hg(W,36)); emit("\n");
    return -3;
  }
  emit("INTEG-PRED p="); e64(p);
  emit(" rel="); e64(hg(W,36)); emit("\n");
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224);
  let olen:[]u8=z_alloc(32);
  let nseg:i32=lv_dfs(W,s,p,oseg,ovals,ofids,olen);
  if(nseg<1){
    emit("INTEG-ADAPT-TRY\n");
    let nmk:i32=adapt_revise2(W,s,masked);
    if(nmk==0){
      nmk=adapt_extend(W,s,masked)+adapt_truncate(W,s,masked)+adapt_specialize(W,s,masked);
    }
    integ_tag_extend(W);
    emit("INTEG-ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      nseg=lv_dfs(W,s,p,oseg,ovals,ofids,olen);
    }
  } else {
    emit("INTEG-NATIVE-SEGS n="); e64(nseg); emit("\n");
  }
  if(nseg<1){
    emit("INTEG-COMP-FAIL\n");
    return -2;
  }
  return integ_assemble(W,s,r,nseg,oseg,ovals,ofids,olen,st);
}

// rt_guardtest.zag -- INTEG-BREAK redteam guard-test driver.
// Runs against the GUARDED copies (GUARD-T1/T2/T3 active).
// Same scenarios as rt_attack.zag, guard-aware assertions, plus the
// control battery. This driver is harness, not cognition.

fn rt_has_edge(W:[]u8,from:i32,typ:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==typ && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn rt_mk_native(W:[]u8,s:i32,r:i32,v:[]u8,f:[]u8,nl:i32)i32 {
  let root:i32=t2_asm_chain(W,v,nl+1,f);
  if(root<0){return -1;}
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  ns(W,m,20,root); ns(W,m,24,hg(W,24)); ns(W,m,36,1);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nl){link_edge(W,m,1,get32(f,i*4),0); i=i+1;}
  return m;
}
// Directly inject a 1-link MAP (adversary path): the guard binary's
// GUARD-T1 already blocks specialize-built circular MAPs, so T2-G1
// tests the verifier against direct injection (defense in depth).
fn rt_inject_1link(W:[]u8,s:i32,r:i32,sv:i32,ov:i32,lic:i32,linkto:i32)i32 {
  let vv:[]u8=z_alloc(8); set32(vv,0,sv); set32(vv,4,ov);
  let ff:[]u8=z_alloc(4); set32(ff,0,lic);
  let root:i32=t2_asm_chain(W,vv,2,ff);
  if(root<0){return -1;}
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,3); ns(W,m,16,-1);
  ns(W,m,20,root); ns(W,m,24,hg(W,24)); ns(W,m,28,ov); ns(W,m,36,1);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  link_edge(W,m,1,lic,0);
  link_edge(W,m,16,linkto,0);
  return m;
}
fn rt_find_relseq_dep(W:[]u8,rs:i32,dep:i32)i32 {
  let m:i32=2; let hit:i32=-1;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let sq:[]u8=z_alloc(28);
      let L:i32=cc_relseq(W,m,sq,7);
      if(L==1 && get32(sq,0)==rs && rt_has_edge(W,m,1,dep)==1){hit=m;}
    }
    m=m+1;
  }
  return hit;
}
fn rt_find_2link_dep(W:[]u8,r0:i32,r1:i32,d0:i32,d1:i32)i32 {
  let m:i32=2; let hit:i32=-1;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let sq:[]u8=z_alloc(28);
      let L:i32=cc_relseq(W,m,sq,7);
      if(L==2 && get32(sq,0)==r0 && get32(sq,4)==r1){
        if(rt_has_edge(W,m,1,d0)==1 && rt_has_edge(W,m,1,d1)==1){hit=m;}
      }
    }
    m=m+1;
  }
  return hit;
}
fn rt_fact_maxscore(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let best:i32=-999999; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if(ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){
        let sc:i32=ng(W,n,8);
        if(sc>best){best=sc;}
      }
    }
    n=n+1;
  }
  return best;
}
fn rt_newest_map(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){best=m;}
    m=m+1;
  }
  return best;
}
fn rt_count_type(W:[]u8,typ:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==typ){c=c+1;}
    e=e+1;
  }
  return c;
}
fn rt_live_maps(W:[]u8)i32 {
  let c:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){c=c+1;}
    m=m+1;
  }
  return c;
}

// ---------- T1-G1: provenance gate ----------
fn t1_g1(W:[]u8,out:[]u8)void {
  emit("=== T1-G1 provenance gate ===\n");
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,2,99);
  let fl:i32=ev_teach_in(W,11,71,14);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,99);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,74,vv,ff,2);
  let n:i32=ts_specialize_src(W,mx,11,0,mx);
  let hit:i32=rt_find_relseq_dep(W,71,fl);
  emit("S1 SPEC-N="); e64(n); emit(" SELFREF-MAP="); e64(hit); emit("\n");
  let ok1:i32=0;
  if(n==0 && hit<0){ok1=1;}
  // C6: world independently confirms the shortcut -> reusable
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let g1:i32=ev_teach(W2,11,1,12);
  let g2:i32=ev_teach(W2,12,2,99);
  let gl:i32=ev_teach_in(W2,11,71,14);
  let gw:i32=ev_teach(W2,11,71,14);
  let vv2:[]u8=z_alloc(12);
  set32(vv2,0,11); set32(vv2,4,12); set32(vv2,8,99);
  let ff2:[]u8=z_alloc(8);
  set32(ff2,0,g1); set32(ff2,4,g2);
  let mx2:i32=rt_mk_native(W2,11,74,vv2,ff2,2);
  let n2:i32=ts_specialize_src(W2,mx2,11,0,mx2);
  let hitw:i32=rt_find_relseq_dep(W2,71,gw);
  let hitl:i32=rt_find_relseq_dep(W2,71,gl);
  emit("C6 SPEC-N="); e64(n2); emit(" WORLD-LIC="); e64(hitw);
  emit(" LEARNER-LIC="); e64(hitl); emit("\n");
  let ok2:i32=0;
  if(n2>=1 && hitw>=2 && hitl<0){ok2=1;}
  let ok:i32=0;
  if(ok1==1 && ok2==1){ok=1;}
  if(ok==1){emit("T1-G1=PASS\n");} else {emit("T1-G1=FAIL\n");}
  set32(out,0,ok);
  return;
}
// ---------- T1-G2: legitimate specialization survives ----------
fn t1_g2(W:[]u8,out:[]u8)void {
  emit("=== T1-G2 control: world-licensed specialization ===\n");
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,2,99);
  let fw:i32=ev_teach(W,11,3,12);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,99);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,74,vv,ff,2);
  emit("FW="); e64(fw); emit("\n");
  let c:i32=0;
  while(c<4){ integ_explore(W,11,74,3,0,0); c=c+1; }
  let trial:i32=rt_find_2link_dep(W,3,2,fw,f2);
  let sc:i32=rt_fact_maxscore(W,11,74,99);
  emit("TRIAL-3-2="); e64(trial); emit(" SCORE-74-99="); e64(sc); emit("\n");
  let ok:i32=0;
  if(trial>=2 && sc==3){ok=1;}
  if(ok==1){emit("T1-G2=PASS\n");} else {emit("T1-G2=FAIL\n");}
  set32(out,0,ok);
  return;
}

// ---------- T2-G1: self-license veto ----------
fn t2_g1(W:[]u8,out:[]u8)void {
  emit("=== T2-G1 self-license veto ===\n");
  let a:i32=ev_teach(W,201,1,202);
  let b:i32=ev_teach(W,202,2,209);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,201); set32(vv,4,202); set32(vv,8,209);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,a); set32(ff,4,b);
  let mx:i32=rt_mk_native(W,201,70,vv,ff,2);
  let fs:i32=ev_teach_in(W,201,70,209);
  let c:i32=0;
  while(c<3){ lv_predict(W,201,70); lv_observe(W,201,70,209); c=c+1; }
  // GUARD-T1 blocks specialize-built circular MAPs here, so the
  // adversary injects the circular MAP directly (defense in depth).
  let m70:i32=rt_inject_1link(W,201,70,201,209,fs,mx);
  emit("M70="); e64(m70); emit(" FSscore="); e64(ng(W,fs,8)); emit("\n");
  ev_teach(W,201,1,202);
  ev_teach(W,202,2,205);
  ns(W,b,36,0);
  emit("WORLD-CHANGE done\n");
  let mz0:i32=rt_newest_map(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q1:i32=compose_integ(W,201,70,0,st);
  let mz1:i32=rt_newest_map(W);
  emit("T2G-Q1="); e64(q1); emit(" NEWEST-BEFORE="); e64(mz0);
  emit(" NEWEST-AFTER="); e64(mz1); emit("\n");
  ns(W,m70,36,0);
  let st3:[]u8=z_alloc(8); set32(st3,0,0); set32(st3,4,0);
  let q3:i32=compose_integ(W,201,70,0,st3);
  emit("T2G-Q3="); e64(q3); emit("\n");
  let ok:i32=0;
  if(q1==-2 && mz1==mz0 && q3==-2){ok=1;}
  if(ok==1){emit("T2-G1=PASS\n");} else {emit("T2-G1=FAIL\n");}
  set32(out,0,ok);
  return;
}
// ---------- T2-G2: control battery ----------
// (i) world-grounded degenerate verification still verifies;
// (ii) non-degenerate verification still verifies.
fn t2_g2(W:[]u8,out:[]u8)void {
  emit("=== T2-G2 control battery ===\n");
  let a:i32=ev_teach(W,301,1,302);
  let b:i32=ev_teach(W,302,2,314);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,301); set32(vv,4,302); set32(vv,8,314);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,a); set32(ff,4,b);
  let mx:i32=rt_mk_native(W,301,70,vv,ff,2);
  let wf:i32=ev_teach(W,301,70,314);
  let c:i32=0;
  while(c<3){ lv_predict(W,301,70); lv_observe(W,301,70,314); c=c+1; }
  let nsp:i32=ts_specialize_src(W,mx,301,0,mx);
  let m70w:i32=rt_find_relseq_dep(W,70,wf);
  // Retire the native MAP so the degenerate single-fact MAP is the
  // only verifier: this isolates the world-grounded degenerate path
  // the refined guard must allow.
  ns(W,mx,36,0);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ(W,301,70,0,st);
  let mz:i32=rt_newest_map(W);
  let linkok:i32=rt_has_edge(W,mz,14,m70w);
  emit("CTRL-i: SPEC-N="); e64(nsp); emit(" M70W="); e64(m70w);
  emit(" Q="); e64(q); emit(" LINK14="); e64(linkok); emit("\n");
  let ok1:i32=0;
  if(m70w>=2 && q==314 && linkok==1){ok1=1;}
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let a2:i32=ev_teach(W2,401,1,402);
  let b2:i32=ev_teach(W2,402,2,409);
  let vv2:[]u8=z_alloc(12);
  set32(vv2,0,401); set32(vv2,4,402); set32(vv2,8,409);
  let ff2:[]u8=z_alloc(8);
  set32(ff2,0,a2); set32(ff2,4,b2);
  let mx2:i32=rt_mk_native(W2,401,70,vv2,ff2,2);
  let fs2:i32=ev_teach_in(W2,401,70,409);
  let c2:i32=0;
  while(c2<3){ lv_predict(W2,401,70); lv_observe(W2,401,70,409); c2=c2+1; }
  let st2:[]u8=z_alloc(8); set32(st2,0,0); set32(st2,4,0);
  let q2:i32=compose_integ(W2,401,70,0,st2);
  let mz2:i32=rt_newest_map(W2);
  let linkok2:i32=rt_has_edge(W2,mz2,14,mx2);
  emit("CTRL-ii: Q2="); e64(q2); emit(" LINK14toMX="); e64(linkok2); emit("\n");
  let ok2:i32=0;
  if(q2==409 && linkok2==1){ok2=1;}
  let ok:i32=0;
  if(ok1==1 && ok2==1){ok=1;}
  if(ok==1){emit("T2-G2=PASS\n");} else {emit("T2-G2=FAIL\n");}
  set32(out,0,ok);
  return;
}
// ---------- T3-G1: liveness veto ----------
fn t3_g1(W:[]u8,out:[]u8)void {
  emit("=== T3-G1 liveness veto ===\n");
  let a:i32=ev_teach(W,201,1,202);
  let b:i32=ev_teach(W,202,2,209);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,201); set32(vv,4,202); set32(vv,8,209);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,a); set32(ff,4,b);
  let mx:i32=rt_mk_native(W,201,70,vv,ff,2);
  let root:i32=ng(W,mx,20);
  let dd:i32=ev_teach(W,202,2,205);
  ns(W,b,36,0);
  let e1:i32=t2_exec(W,root,201);
  let vv2:[]u8=z_alloc(12);
  set32(vv2,0,201); set32(vv2,4,202); set32(vv2,8,205);
  let ff2:[]u8=z_alloc(8);
  set32(ff2,0,a); set32(ff2,4,dd);
  let root2:i32=t2_asm_chain(W,vv2,3,ff2);
  let e2:i32=t2_exec(W,root2,201);
  emit("STALE-EXEC="); e64(e1); emit(" FRESH-EXEC="); e64(e2); emit("\n");
  let ok:i32=0;
  if(e1==-999999 && e2==205){ok=1;}
  if(ok==1){emit("T3-G1=PASS\n");} else {emit("T3-G1=FAIL\n");}
  set32(out,0,ok);
  return;
}
// ---------- T3-G2: control battery (I2/I4 equivalents) ----------
fn t3_g2(W:[]u8,out:[]u8)void {
  emit("=== T3-G2 control battery ===\n");
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,1,13);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,11); set32(vv,4,12); set32(vv,8,13);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let mx:i32=rt_mk_native(W,11,72,vv,ff,2);
  emit("MX="); e64(mx); emit("\n");
  let c:i32=0;
  while(c<4){ integ_explore(W,11,72,2,0,0); c=c+1; }
  // capture the truncate trial BEFORE compose_integ: after promotion
  // MAP_Z also carries relseq [1] with DEP to f1.
  let trial0:i32=rt_find_relseq_dep(W,1,f1);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ(W,11,72,0,st);
  let mz:i32=rt_newest_map(W);
  let linkok:i32=rt_has_edge(W,mz,14,trial0);
  emit("I2-EQUIV Q="); e64(q); emit(" TRIAL1="); e64(trial0);
  emit(" LINK14="); e64(linkok); emit("\n");
  let ok1:i32=0;
  if(q==12 && trial0>=2 && linkok==1){ok1=1;}
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,11,70,12);
  let maps0:i32=rt_live_maps(W2);
  let e160:i32=rt_count_type(W2,16);
  let st2:[]u8=z_alloc(8); set32(st2,0,0); set32(st2,4,0);
  let q2:i32=compose_integ(W2,101,70,0,st2);
  let maps1:i32=rt_live_maps(W2);
  let e161:i32=rt_count_type(W2,16);
  emit("I4-EQUIV Q2="); e64(q2); emit(" MAPS "); e64(maps0);
  emit("->"); e64(maps1); emit(" T16 "); e64(e160);
  emit("->"); e64(e161); emit("\n");
  let ok2:i32=0;
  if(q2==-3 && maps1==maps0 && e161==0){ok2=1;}
  let ok:i32=0;
  if(ok1==1 && ok2==1){ok=1;}
  if(ok==1){emit("T3-G2=PASS\n");} else {emit("T3-G2=FAIL\n");}
  set32(out,0,ok);
  return;
}

fn main()i32 {
  emit("RT-GUARD-START\n");
  let o1:[]u8=z_alloc(8);
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); t1_g1(W1,o1);
  let o2:[]u8=z_alloc(8);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); t1_g2(W2,o2);
  let t1ok:i32=0;
  if(get32(o1,0)==1 && get32(o2,0)==1){t1ok=1;}
  if(t1ok==1){emit("T1-GUARD=PASS\n");} else {emit("T1-GUARD=FAIL\n");}
  let o3:[]u8=z_alloc(8);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); t2_g1(W3,o3);
  let o4:[]u8=z_alloc(8);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); t2_g2(W4,o4);
  let t2ok:i32=0;
  if(get32(o3,0)==1 && get32(o4,0)==1){t2ok=1;}
  if(t2ok==1){emit("T2-GUARD=PASS\n");} else {emit("T2-GUARD=FAIL\n");}
  let o5:[]u8=z_alloc(8);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); t3_g1(W5,o5);
  let o6:[]u8=z_alloc(8);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); t3_g2(W6,o6);
  let t3ok:i32=0;
  if(get32(o5,0)==1 && get32(o6,0)==1){t3ok=1;}
  if(t3ok==1){emit("T3-GUARD=PASS\n");} else {emit("T3-GUARD=FAIL\n");}
  emit("RT-GUARD-END\n");
  return 0;
}

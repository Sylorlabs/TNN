// ts_patch.zag -- TRUNCATE-ONE and SPECIALIZE-ONE L2 adaptation
// operators, plus kind-dispatched adaptation revision.
//
// Context: ADAPT-REVISION-COMPLETE revised EXTEND-ONE adaptations.
// Open question: does adapt_revise work for TRUNCATE and
// SPECIALIZE adaptations? This file builds both operator kinds and
// extends the revision operator with kind dispatch.
//
// TRUNCATE-ONE (adapt_truncate): shorten a fully-satisfied native
// MAP by one link (longest proper prefix).
//
// SPECIALIZE-ONE (adapt_specialize): substitute one link's relation
// with a live alternative the world offers (same or different
// object), committing the procedure to the world's offered route.
//
// The adaptation kind (2=TRUNCATE, 3=SPECIALIZE) is recorded in MAP
// field 12 at promotion (PREREG Amendment 1). Field 12 is -1 from
// the frozen promoters and never read for tag-20 nodes.
//
// adapt_revise2: the frozen adapt_revise staleness predicate
// verbatim (reusing rev_is_adapted, rev_src, rev_extend_src from
// revise_patch.zag), but the revision action dispatches on the
// recorded kind: re-extend (kind 1), re-truncate (kind 2),
// re-specialize (kind 3). Per the preregistered TRUNCATE theorem, a
// pure-prefix truncation cannot go stale while its source is
// intact, so kind-2 revision is not expected to fire; the dispatch
// is complete anyway.
//
// ev_query_revise2: ev_query_revise verbatim except the adapt
// bracket calls adapt_revise2 and the frozen fallback runs all
// three fresh operators (extend, truncate, specialize).
//
// Zero modes, bridges, handlers, semantic cases, new opcodes, or
// new MAP/edge types. The operators name no relation, MAP, length,
// query, or expected value.

// 1 iff a live MAP carries exactly relseq seq[0..L-1].
fn ts_relseq_present(W:[]u8,seq:[]u8,L:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let sq:[]u8=z_alloc(28);
      let lm:i32=cc_relseq(W,m,sq,7);
      if(lm==L){
        let ok:i32=1;
        let j:i32=0;
        while(j<L){
          if(get32(sq,j*4)!=get32(seq,j*4)){ok=0;}
          j=j+1;
        }
        if(ok==1){return 1;}
      }
    }
    m=m+1;
  }
  return 0;
}

// TRUNCATE-ONE inner loop for one source MAP src, fully satisfied
// from s. Builds the longest proper prefix (length L-1). The new
// MAP's type-16 edge points to linkto. Records kind 2 in field 12.
// Returns the count created (0 or 1).
fn ts_truncate_src(W:[]u8,src:i32,s:i32,masked:i32,linkto:i32)i32 {
  let nmk:i32=0;
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,src,seq,7);
  if(L>=2 && L<7){
    let vals:[]u8=z_alloc(36);
    let fids:[]u8=z_alloc(32);
    let ln:i32=cc_satisfy(W,src,s,vals,fids);
    if(ln==L){
      let k:i32=L-1;
      let cv:[]u8=z_alloc(40);
      let cf:[]u8=z_alloc(36);
      let cs:[]u8=z_alloc(28);
      let i:i32=0;
      while(i<=k){set32(cv,i*4,get32(vals,i*4)); i=i+1;}
      i=0;
      while(i<k){
        set32(cf,i*4,get32(fids,i*4));
        set32(cs,i*4,get32(seq,i*4));
        i=i+1;
      }
      if(ts_relseq_present(W,cs,k)==0){
        let root:i32=t2_asm_chain(W,cv,k+1,cf);
        if(root>=0){
          let st:[]u8=z_alloc(8);
          set32(st,0,0); set32(st,4,0);
          let term:i32=get32(cv,k*4);
          let chk:i32=t2_try_verify(W,root,s,term,masked,st);
          if(chk!=-2){
            let am:i32=adapt_promote(W,root,s,ng(W,src,4),term,cf,k);
            if(am>=0){
              ns(W,am,12,2);
              link_edge(W,am,16,linkto,0);
              emit("TS-TRUNC-MK id="); e64(am);
              emit(" src="); e64(src);
              emit(" linkto="); e64(linkto);
              emit(" len="); e64(k); emit("\n");
              nmk=nmk+1;
            }
          }
        }
      }
    }
  }
  return nmk;
}

// SPECIALIZE-ONE inner loop for one source MAP src, fully satisfied
// from s. For each link j and each live alternative fact
// (v_j, r_alt, v_new) with r_alt != R[j], builds the candidate
// R[0..j-1] ++ [r_alt] greedily extended with R[j+1..] from v_new.
// The new MAP's type-16 edge points to linkto. Records kind 3 in
// field 12. Returns the count created.
fn ts_specialize_src(W:[]u8,src:i32,s:i32,masked:i32,linkto:i32)i32 {
  let nmk:i32=0;
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,src,seq,7);
  // For revision (linkto != src), limit candidate length to the
  // stale adaptation's length, preserving its structure.
  let La:i32=0;
  if(linkto!=src){
    let sq2:[]u8=z_alloc(28);
    La=cc_relseq(W,linkto,sq2,7);
  }
  if(L>=1 && L<7){
    let vals:[]u8=z_alloc(36);
    let fids:[]u8=z_alloc(32);
    let ln:i32=cc_satisfy(W,src,s,vals,fids);
    if(ln==L){
      let j:i32=0;
      while(j<L){
        let vj:i32=get32(vals,j*4);
        let rj:i32=get32(seq,j*4);
        let fn2:i32=2;
        while(fn2<1024){
          if(ng(W,fn2,36)==1 && ng(W,fn2,0)==1 && ng(W,fn2,20)==vj && ng(W,fn2,24)!=rj && ng(W,fn2,24)!=-999 && is_superseded(W,fn2)==0){
            // GUARD-T1 (redteam, guarded copy only): provenance gate.
            // Learner-originated facts (field 12 == 1, taught through
            // the learner-internal ev_teach_in channel) are not world
            // relations and may not license alternative-relation
            // substitution. World-channeled facts (12 == 0) still can,
            // so independently confirmed shortcuts stay reusable.
            if(ng(W,fn2,12)!=1){
            let ralt:i32=ng(W,fn2,24);
            let vnew:i32=ng(W,fn2,28);
            let cv:[]u8=z_alloc(40);
            let cf:[]u8=z_alloc(36);
            let cs:[]u8=z_alloc(28);
            let i:i32=0;
            while(i<=j){set32(cv,i*4,get32(vals,i*4)); i=i+1;}
            set32(cv,(j+1)*4,vnew);
            i=0;
            while(i<j){
              set32(cf,i*4,get32(fids,i*4));
              set32(cs,i*4,get32(seq,i*4));
              i=i+1;
            }
            set32(cf,j*4,fn2);
            set32(cs,j*4,ralt);
            let k:i32=j+1;
            let L2:i32=j+1;
            while(k<L && (La==0 || L2<La)){
              let ff:i32=t2_lu_first(W,get32(cv,k*4),get32(seq,k*4));
              if(ff<0){k=L;}
              else {
                set32(cv,(k+1)*4,ng(W,ff,28));
                set32(cf,k*4,ff);
                set32(cs,k*4,get32(seq,k*4));
                L2=k+1;
                k=k+1;
              }
            }
            if(ts_relseq_present(W,cs,L2)==0){
              let root:i32=t2_asm_chain(W,cv,L2+1,cf);
              if(root>=0){
                let st:[]u8=z_alloc(8);
                set32(st,0,0); set32(st,4,0);
                let term:i32=get32(cv,L2*4);
                let chk:i32=t2_try_verify(W,root,s,term,masked,st);
                if(chk!=-2){
                  let am:i32=adapt_promote(W,root,s,ng(W,src,4),term,cf,L2);
                  if(am>=0){
                    ns(W,am,12,3);
                    link_edge(W,am,16,linkto,0);
                    emit("TS-SPEC-MK id="); e64(am);
                    emit(" src="); e64(src);
                    emit(" linkto="); e64(linkto);
                    emit(" len="); e64(L2); emit("\n");
                    nmk=nmk+1;
                  }
                }
              }
            }
            }
          }
          fn2=fn2+1;
        }
        j=j+1;
      }
    }
  }
  return nmk;
}

// Fresh TRUNCATE-ONE over all live native MAPs.
fn adapt_truncate(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && adapt_is_native(W,m)==1){
      nmk=nmk+ts_truncate_src(W,m,s,masked,m);
    }
    m=m+1;
  }
  return nmk;
}

// Fresh SPECIALIZE-ONE over all live native MAPs.
fn adapt_specialize(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && adapt_is_native(W,m)==1){
      nmk=nmk+ts_specialize_src(W,m,s,masked,m);
    }
    m=m+1;
  }
  return nmk;
}

// Adaptation kind for revision dispatch. Reads the recorded kind
// (field 12) when present; otherwise best-effort relseq inference:
// kind 1 iff a extends src by one link, kind 2 iff a is a proper
// prefix of src, else kind 3.
fn ts_kind(W:[]u8,src:i32,a:i32)i32 {
  let rec:i32=ng(W,a,12);
  if(rec==1 || rec==2 || rec==3){return rec;}
  let sqs:[]u8=z_alloc(28);
  let sqa:[]u8=z_alloc(28);
  let ls:i32=cc_relseq(W,src,sqs,7);
  let la:i32=cc_relseq(W,a,sqa,7);
  if(ls>=1 && la>=1){
    if(la==ls+1){
      let ok:i32=1;
      let j:i32=0;
      while(j<ls){
        if(get32(sqa,j*4)!=get32(sqs,j*4)){ok=0;}
        j=j+1;
      }
      if(ok==1){return 1;}
    }
    if(la<ls){
      let ok2:i32=1;
      let j2:i32=0;
      while(j2<la){
        if(get32(sqa,j2*4)!=get32(sqs,j2*4)){ok2=0;}
        j2=j2+1;
      }
      if(ok2==1){return 2;}
    }
  }
  return 3;
}

// Kind-dispatched revision. The staleness predicate is the frozen
// adapt_revise predicate verbatim (rev_is_adapted, rev_src reused).
// On STALE the revision action dispatches on ts_kind: 1 ->
// rev_extend_src (frozen), 2 -> ts_truncate_src, 3 ->
// ts_specialize_src. The stale MAP retires AFTER construction.
// Returns total created.
fn adapt_revise2(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let a:i32=2;
  while(a<1024){
    if(rev_is_adapted(W,a)==1){
      let src:i32=rev_src(W,a);
      if(src>=2 && ng(W,src,36)==1){
        let sq:[]u8=z_alloc(28);
        let vb:[]u8=z_alloc(36);
        let fb:[]u8=z_alloc(32);
        let lsrc:i32=cc_relseq(W,src,sq,7);
        let ls:i32=cc_satisfy(W,src,s,vb,fb);
        if(lsrc>=1 && ls==lsrc){
          let lalen:i32=cc_relseq(W,a,sq,7);
          let la:i32=cc_satisfy(W,a,s,vb,fb);
          let aintact:i32=0;
          if(la>=1 && la==lalen){aintact=1;}
          if(aintact==0){
            let kd:i32=ts_kind(W,src,a);
            emit("REVISE2-STALE a="); e64(a);
            emit(" src="); e64(src);
            emit(" kind="); e64(kd); emit("\n");
            let nk:i32=0;
            if(kd==1){nk=rev_extend_src(W,src,s,masked,a);}
            else {
              if(kd==2){nk=ts_truncate_src(W,src,s,masked,a);}
              else {nk=ts_specialize_src(W,src,s,masked,a);}
            }
            ns(W,a,36,0);
            nmk=nmk+nk;
          }
        }
      }
    }
    a=a+1;
  }
  return nmk;
}

// ev_query with the kind-dispatched revision bracket: the unified
// pipeline verbatim, adapt_revise2 between the failed compose_try
// and the fresh-adaptation fallback (extend, truncate, specialize),
// then recompose on any creation.
fn ev_query_revise2(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    // ---- L2 adaptation revision (kind-dispatched), then fresh
    // adaptation (extend, truncate, specialize) as fallback ----
    emit("ADAPT-TRY\n");
    let nmk:i32=adapt_revise2(W,s,masked);
    if(nmk==0){
      nmk=adapt_extend(W,s,masked)+adapt_truncate(W,s,masked)+adapt_specialize(W,s,masked);
    }
    emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
      emit("COMP-STAT2 tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
      if(ca2!=-2){
        hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
        log_ev(W,2,s,r,ca2,1,0,0); return ca2;
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

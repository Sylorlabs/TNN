// revise_patch.zag -- ADAPT-REVISION: revise an L2 adaptation when the
// world invalidates it, without touching the underlying contract.
//
// Context: EXTEND-ONE (adapt_patch.zag) adapts a native MAP by one
// frontier link, recording a type-16 adapted-from edge to its source.
// Open question: when the adapted MAP proves wrong under a world
// change, can the learner revise the ADAPTATION itself?
//
// adapt_revise: for each live adapted MAP a (node-id order), compute
// staleness from satisfiability only: the source contract is intact
// (src fully satisfiable from the query subject) while the adaptation
// is not (a not fully satisfiable, or unreadable). On stale: retire a
// (field 36 = 0; edges persist, so provenance survives), then
// re-extend the source against the CURRENT world, linking the
// replacement's type-16 edge to a (the revised adaptation). The
// revision chain reads new -> a -> src. If no live frontier fact
// exists, the stale adaptation stays retired: revision by retraction.
//
// ev_query_revise: ev_query_adapt verbatim except the adapt bracket
// runs adapt_revise first and the frozen adapt_extend only as fallback
// when revision created nothing.
//
// The operator names no relation, no MAP, no length, no query, and no
// expected value. Zero modes, bridges, handlers, semantic cases, new
// opcodes, or new MAP/edge types (type-16 is reused for the revision
// link; retirement is the existing field-36 kill idiom).

// 1 iff m is a live MAP node with an outgoing type-16 edge (adapted).
fn rev_is_adapted(W:[]u8,m:i32)i32 {
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==16){return 1;}
    e=e+1;
  }
  return 0;
}

// type-16 target of adapted MAP a (the MAP it was adapted/revised
// from), or -1.
fn rev_src(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}

// Extend ONE source MAP by every live frontier fact. This is the
// adapt_extend inner loop for a single source, parameterized so the
// new adapted MAP's type-16 edge points to linkto (the revised
// adaptation) instead of src. Returns the number of adapted MAPs
// promoted.
fn rev_extend_src(W:[]u8,src:i32,s:i32,masked:i32,linkto:i32)i32 {
  let nmk:i32=0;
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,src,seq,7);
  if(L>=1 && L<7){
    let vals:[]u8=z_alloc(36);
    let fids:[]u8=z_alloc(32);
    let ln:i32=cc_satisfy(W,src,s,vals,fids);
    if(ln==L){
      let fr:i32=get32(vals,L*4);
      let fn2:i32=2;
      while(fn2<1024){
        if(ng(W,fn2,36)==1 && ng(W,fn2,0)==1 && ng(W,fn2,20)==fr && ng(W,fn2,24)!=-999 && is_superseded(W,fn2)==0){
          let rnew:i32=ng(W,fn2,24);
          let vnext:i32=ng(W,fn2,28);
          if(adapt_relseq_absent(W,seq,L,rnew)==1){
            let vv:[]u8=z_alloc(40);
            let ff:[]u8=z_alloc(36);
            let j:i32=0;
            while(j<=L){set32(vv,j*4,get32(vals,j*4)); j=j+1;}
            set32(vv,(L+1)*4,vnext);
            j=0;
            while(j<L){set32(ff,j*4,get32(fids,j*4)); j=j+1;}
            set32(ff,L*4,fn2);
            let root:i32=t2_asm_chain(W,vv,L+2,ff);
            if(root>=0){
              let st:[]u8=z_alloc(8);
              set32(st,0,0); set32(st,4,0);
              let chk:i32=t2_try_verify(W,root,s,vnext,masked,st);
              if(chk!=-2){
                let af:[]u8=z_alloc(36);
                j=0;
                while(j<=L){set32(af,j*4,get32(ff,j*4)); j=j+1;}
                let am:i32=adapt_promote(W,root,s,ng(W,src,4),vnext,af,L+1);
                if(am>=0){
                  link_edge(W,am,16,linkto,0);
                  emit("REVISE-MK id="); e64(am);
                  emit(" src="); e64(src);
                  emit(" revises="); e64(linkto);
                  emit(" len="); e64(L+1); emit("\n");
                  nmk=nmk+1;
                }
              }
            }
          }
        }
        fn2=fn2+1;
      }
    }
  }
  return nmk;
}

// Revision phase: retire stale adaptations and re-extend their sources
// against the current world. A MAP a is STALE iff its source contract
// still holds (src fully satisfiable from s) while the adaptation does
// not (a not fully satisfiable, or unreadable). Sources that are not
// live are skipped (no cascading revision off retired sources).
// Returns the number of revised MAPs promoted.
fn adapt_revise(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let a:i32=2;
  while(a<1024){
    if(rev_is_adapted(W,a)==1){
      let src:i32=rev_src(W,a);
      if(src>=2 && ng(W,src,36)==1){
        let sq:[]u8=z_alloc(28);
        let vb:[]u8=z_alloc(36);
        let fb:[]u8=z_alloc(32);
        let lsrc:i32=cc_relseq(W,src,sq,7);
        let ls:i32=cc_satisfy(W,src,s,vb,fb);
        if(lsrc>=1 && ls==lsrc){
          let lalen:i32=cc_relseq(W,a,sq,7);
          let la:i32=cc_satisfy(W,a,s,vb,fb);
          let aintact:i32=0;
          if(la>=1 && la==lalen){aintact=1;}
          if(aintact==0){
            emit("REVISE-STALE a="); e64(a);
            emit(" src="); e64(src); emit("\n");
            let nk:i32=rev_extend_src(W,src,s,masked,a);
            // Retire AFTER re-extension: alloc_node recycles dead
            // nodes, so retiring first would let the new MAP's own
            // cells reuse a's slot. a stays live during construction.
            ns(W,a,36,0);
            nmk=nmk+nk;
          }
        }
      }
    }
    a=a+1;
  }
  return nmk;
}

// ev_query with the adaptation-revision bracket: the unified pipeline
// verbatim, plus adapt_revise between the failed compose_try and the
// frozen adapt_extend fallback, then recompose on any creation.
fn ev_query_revise(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- unified composition: DFS over pluggable applicability ----
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    // ---- L2 adaptation revision: revise stale adaptations first,
    // then frozen fresh extension as fallback ----
    emit("ADAPT-TRY\n");
    let nmk:i32=adapt_revise(W,s,masked);
    if(nmk==0){nmk=adapt_extend(W,s,masked);}
    emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
      emit("COMP-STAT2 tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
      if(ca2!=-2){
        hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
        log_ev(W,2,s,r,ca2,1,0,0); return ca2;
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// ivwc_casebias.zag -- case-level bias signals for phantom-type
// errors in the IVWC hybrid. Verbatim copy of IVWC-SCOREBIAS's
// world/belief/composer/stepper/verifier/seeds (sealed pairs
// bit-identical; K3/K4 anchors verify). The scorebias ceiling:
// s=3 (phantom, P=50) shares bucket 1 with four genuine P=33
// positives, and no per-bucket bias fixes s=3 first. This wave
// tests three frozen case-level bias variants, all trained on
// the 24 train cases only, as in-program arms on the shared
// label ge = (eff >= T_pred). Each variant refines the frozen
// UCB bucket bias with a train-fit per-case residual table:
//   V-UCB    (vv=0): m_b + isqrt(S_b/(n_b-1)) (anchor)
//   V-CONDC  (vv=1): + mean resid on (bucket, preff) cell
//   V-AGREE  (vv=2): + mean resid on multi-policy agreement bin
//   V-STRUCT (vv=3): + mean resid on (bucket, believed-bumps) cell
// plus shuffled-residual ablations vv=4..6 (rotate-by-7).
// Each variant: adjV = P - biasV(case), verdict PASS iff
// adjV > TV (strict margin; TV = mean adjV over the sealed
// batch, learner-computed, no world data).
// Also: a preregistered train feature audit (TA/SA lines) and a
// harness-side sealed-label per-(bucket,preff)-cell diagnostic
// (fenced in SCORING; never learner-visible).
// Anchors: OF (P >= Tpred), X3 (frozen bucket table),
// HYB (C >= Thyb), MG (C > Thyb).
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC-EXPAND3) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;

// ---------- helpers (u8-backed cells, little-endian; copied verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow).
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}
// Integer floor square root (for the V-UCB bias estimator).
fn isqrt(x:i32)i32 {
  let r:i32=0;
  while((r+1)*(r+1)<=x){ r=r+1; }
  return r;
}

// ===== WORLD =====
// Verbatim copies from IVWC-EXPAND3 (world_gen, belief_gen, step
// physics, true-world stepper). The learner never calls these.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// True-world stepper. Called ONLY in the sealed SCORING block
// (harness), never by the learner. wc counts true executions.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// Everything in this section touches beliefs and plans only.
// No true-world array token appears below (checked by audit A7).
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only (verbatim expand3).
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Reverse-scan re-derivation: identical policy, opposite item order.
// Independent code path for the Arm B agreement check.
fn learner_compose_rev(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=CW-1;
  while(c>=0){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c-1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Nearest-first re-derivation: greedy policy, independent path.
// Repeatedly visits the nearest believed item whose believed
// interval from the current pos is clear. Deterministic
// (ties -> smaller cell). Flags hoisted, nesting shallow.
fn learner_compose_nn(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let taken:[]u8=z_alloc(CW);
  let pos:i32=get8(bb,boff+2*CW);
  let at:i32=0;
  let pcs:[]u8=z_alloc(12);
  let more:i32=1;
  while(more==1){
    let best:i32=-1;
    let bd:i32=1000000;
    let c:i32=0;
    while(c<CW){
      let tk:i32=get8(taken,c);
      let it:i32=get8(bb,boff+CW+c);
      let cand:i32=0;
      if(tk==0){ cand=1; }
      if(cand==1){
        if(it==0){ cand=0; }
      }
      if(cand==1){
        let lo:i32=pos;
        let hi:i32=c;
        if(lo>hi){
          let t:i32=lo;
          lo=hi;
          hi=t;
        }
        let blk:i32=lc_blocked(bb,boff,lo,hi);
        if(blk==0){
          let d:i32=pos-c;
          if(d<0){ d=0-d; }
          let better:i32=0;
          if(d<bd){ better=1; }
          if(better==0){
            if(d==bd){
              if(best<0){ better=1; }
              else {
                if(c<best){ better=1; }
              }
            }
          }
          if(better==1){ bd=d; best=c; }
        }
      }
      c=c+1;
    }
    if(best<0){ more=0; }
    else {
      set8(taken,best,1);
      set32(pcs,0,pos);
      set32(pcs,4,best);
      set32(pcs,8,at);
      lc_leg(pb,poff,at,pcs);
      pos=get32(pcs,0);
      at=get32(pcs,8);
    }
  }
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Internal-model consequence prediction: steps the committed plan
// through the BELIEVED corridor (same physics shape as the true
// stepper, but beliefs only). No true-consequence observation.
// cons cells: collected@0, energy@4, bumps@8, wasted@12, final@16,
// plan_len@20.
fn belief_execute(bbuf:[]u8, boff:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32)void {
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(bbuf,boff+2*CW));
  let i:i32=0;
  while(i<L){
    let oc:i32=w_step(bbuf,boff,got,st,get8(pb,poff+i));
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}
// Belief scrambler (ablation): independent Fisher-Yates on believed
// walls and believed items (fixed seed); marginals preserved,
// wall/item mapping to truth broken. Start cell kept open.
fn belief_scramble(bb:[]u8, boff:i32, sb:[]u8, soff:i32, seed:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<RECW){
    set8(sb,soff+c,get8(bb,boff+c));
    c=c+1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+c);
    set8(sb,soff+c,get8(sb,soff+j));
    set8(sb,soff+j,t);
    c=c-1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+CW+c);
    set8(sb,soff+CW+c,get8(sb,soff+CW+j));
    set8(sb,soff+CW+j,t);
    c=c-1;
  }
  let srt:i32=get8(bb,boff+2*CW);
  set8(sb,soff+srt,0);
  return;
}
// Extract gather cells from a plan (walk from start), insertion-sort
// them, return the count. Flat control flow (no deep nesting).
fn gather_cells(pb:[]u8, poff:i32, L:i32, start:i32, out:[]u8, ooff:i32)i32 {
  let pos:i32=start;
  let n:i32=0;
  let i:i32=0;
  while(i<L){
    let a:i32=get8(pb,poff+i);
    if(a==0){ pos=pos-1; }
    else {
      if(a==1){ pos=pos+1; }
      else {
        set8(out,ooff+n,pos);
        n=n+1;
      }
    }
    i=i+1;
  }
  let k:i32=1;
  while(k<n){
    let v:i32=get8(out,ooff+k);
    let j:i32=k-1;
    let go:i32=1;
    while(go==1){
      let stop:i32=0;
      if(j<0){ stop=1; }
      if(stop==0){
        if(get8(out,ooff+j)<=v){ stop=1; }
      }
      if(stop==1){ go=0; }
      else {
        set8(out,ooff+j+1,get8(out,ooff+j));
        j=j-1;
      }
    }
    set8(out,ooff+j+1,v);
    k=k+1;
  }
  return n;
}

// Learner-owned self-check table. vb cells (4-byte): bsum[4]@0,
// bcnt[4]@16, bmean[4]@32, T@48. Inputs are consequence-derived
// (bucket, eff) pairs only; no world truth reaches this function.
// T is learner-computed from train consequences (no researcher-set
// constant anywhere in the verifier path). Empty bucket -> mean -1.
fn verifier_train(bkt:[]u8, eff:[]u8, n:i32, vb:[]u8)void {
  let b:i32=0;
  while(b<4){
    set32(vb,4*b,0);
    set32(vb,16+4*b,0);
    set32(vb,32+4*b,-1);
    b=b+1;
  }
  let tot:i32=0;
  let i:i32=0;
  while(i<n){
    let bb:i32=get32(bkt,4*i);
    let e:i32=get32(eff,4*i);
    if(bb>=0){
      if(bb<4){
        set32(vb,4*bb,get32(vb,4*bb)+e);
        set32(vb,16+4*bb,get32(vb,16+4*bb)+1);
      }
    }
    tot=tot+e;
    i=i+1;
  }
  b=0;
  while(b<4){
    let c:i32=get32(vb,16+4*b);
    if(c>0){ set32(vb,32+4*b,get32(vb,4*b)/c); }
    b=b+1;
  }
  let T:i32=0;
  if(n>0){ T=tot/n; }
  set32(vb,48,T);
  return;
}
// Pre-execution self-verdict: 1 = PASS, 0 = FAIL. FAIL when the
// bucket has no train data (conservative: no data, no pass) or its
// train mean sits below the learner's own threshold T.
fn verifier_check(vb:[]u8, bucket:i32)i32 {
  if(bucket<0){ return 0; }
  if(bucket>=4){ return 0; }
  if(get32(vb,16+4*bucket)==0){ return 0; }
  if(get32(vb,32+4*bucket)>=get32(vb,48)){ return 1; }
  return 0;
}
// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCCB-BEGIN\n");
  // Train arrays (inherited verbatim from IVWC-SCOREBIAS).
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ptrain_rev:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain_rev:[]u8=z_alloc(NTRAIN*RECM);
  let ptrain_nn:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain_nn:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let tbkt:[]u8=z_alloc(NTRAIN*4);
  let teff:[]u8=z_alloc(NTRAIN*4);
  let sbkt:[]u8=z_alloc(NTRAIN*4);
  let seff:[]u8=z_alloc(NTRAIN*4);
  let preff_tr:[]u8=z_alloc(NTRAIN*4);
  let agree_tr:[]u8=z_alloc(NTRAIN*4);
  let bumps_tr:[]u8=z_alloc(NTRAIN*4);
  let walls_tr:[]u8=z_alloc(NTRAIN*4);
  let items_tr:[]u8=z_alloc(NTRAIN*4);
  let vb:[]u8=z_alloc(64);
  let biassum:[]u8=z_alloc(16);
  let biascnt:[]u8=z_alloc(16);
  let biasshsm:[]u8=z_alloc(16);
  let biasshct:[]u8=z_alloc(16);
  let bias:[]u8=z_alloc(16);
  let biassh:[]u8=z_alloc(16);
  let etmp:[]u8=z_alloc(EREC);
  let ctmp:[]u8=z_alloc(RECC);
  // Sealed arrays (inherited verbatim + case-level features).
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let pseal_rev:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal_rev:[]u8=z_alloc(NSEAL*RECM);
  let pseal_nn:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal_nn:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let escr:[]u8=z_alloc(EREC);
  let wc:[]u8=z_alloc(4);
  let preff:[]u8=z_alloc(NSEAL*4);
  let seffA:[]u8=z_alloc(NSEAL*4);
  let agree_se:[]u8=z_alloc(NSEAL*4);
  let bumps_se:[]u8=z_alloc(NSEAL*4);
  let walls_se:[]u8=z_alloc(NSEAL*4);
  let items_se:[]u8=z_alloc(NSEAL*4);
  let adj:[]u8=z_alloc(NSEAL*4);
  let adjsh:[]u8=z_alloc(NSEAL*4);
  let verH:[]u8=z_alloc(NSEAL*4);
  let verA:[]u8=z_alloc(NSEAL*4);
  let verX:[]u8=z_alloc(NSEAL*4);
  let verHsh:[]u8=z_alloc(NSEAL*4);
  let acc_h:[]u8=z_alloc(12);
  let acc_of:[]u8=z_alloc(12);
  let acc_x3:[]u8=z_alloc(12);
  let acc_hsh:[]u8=z_alloc(12);
  let acc_mg:[]u8=z_alloc(12);
  // Frozen UCB bucket biases, recomputed (scorebias family base).
  let bucb:[]u8=z_alloc(16);
  let bmax:[]u8=z_alloc(16);
  let bmaxsh:[]u8=z_alloc(16);
  let bsq:[]u8=z_alloc(16);
  let bsqsh:[]u8=z_alloc(16);
  // Case-level residual tables: R1 (bucket x preff, 4x101),
  // R2 (agree 1..3), R3 (bucket x bumpbin, 4x3); shuffled twins.
  let r1sum:[]u8=z_alloc(1616);
  let r1cnt:[]u8=z_alloc(1616);
  let r1m:[]u8=z_alloc(1616);
  let r1shsum:[]u8=z_alloc(1616);
  let r1shct:[]u8=z_alloc(1616);
  let r1shm:[]u8=z_alloc(1616);
  let r2sum:[]u8=z_alloc(16);
  let r2cnt:[]u8=z_alloc(16);
  let r2m:[]u8=z_alloc(16);
  let r2shsum:[]u8=z_alloc(16);
  let r2shct:[]u8=z_alloc(16);
  let r2shm:[]u8=z_alloc(16);
  let r3sum:[]u8=z_alloc(48);
  let r3cnt:[]u8=z_alloc(48);
  let r3m:[]u8=z_alloc(48);
  let r3shsum:[]u8=z_alloc(48);
  let r3shct:[]u8=z_alloc(48);
  let r3shm:[]u8=z_alloc(48);
  // Case-level variant machinery. vv: 0=UCB 1=CONDC 2=AGREE
  // 3=STRUCT 4=CONDCsh 5=AGREEsh 6=STRUCTsh. cbias[(vv-1)][s]
  // for vv=1..6 (6x12 i32); adjv[vv][s], verv[vv][s] (7x12);
  // totv/tvar per variant; acc_v[vv][sh] (7x3).
  let cbias:[]u8=z_alloc(288);
  let adjv:[]u8=z_alloc(336);
  let verv:[]u8=z_alloc(336);
  let totv:[]u8=z_alloc(28);
  let tvar:[]u8=z_alloc(28);
  let acc_v:[]u8=z_alloc(84);
  let verMG:[]u8=z_alloc(48);
  let maj:[]u8=z_alloc(12);
  let tpr:[]u8=z_alloc(12);
  let thy:[]u8=z_alloc(12);
  let tshy:[]u8=z_alloc(12);
  let k3n:[]u8=z_alloc(48);
  // Harness-side sealed-label diagnostic cells (NOT learner).
  let ocsum:[]u8=z_alloc(1616);
  let occnt:[]u8=z_alloc(1616);
  let adjO:[]u8=z_alloc(48);
  let verO:[]u8=z_alloc(48);
  let acc_or:[]u8=z_alloc(12);
  let k1:i32=1;
  let k9:i32=0;
  // Phase 1: train SETUP (harness; wp=15; seeds verbatim expand3).
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, 15, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // Phase 2: train COMMIT (learner; beliefs only). Three
  // independent composer paths for the agreement feature.
  let wcb0:i32=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  t=0;
  while(t<NTRAIN){
    learner_compose_rev(btrain, t*RECW, ptrain_rev, t*PLANMAX, mtrain_rev, t*RECM);
    t=t+1;
  }
  t=0;
  while(t<NTRAIN){
    learner_compose_nn(btrain, t*RECW, ptrain_nn, t*PLANMAX, mtrain_nn, t*RECM);
    t=t+1;
  }
  t=0;
  while(t<NTRAIN){
    let ggf:i32=get32(mtrain,t*RECM);
    let ggr:i32=get32(mtrain_rev,t*RECM);
    let ggn:i32=get32(mtrain_nn,t*RECM);
    let aag:i32=1;
    if(ggr==ggf){ aag=aag+1; }
    if(ggn==ggf){ aag=aag+1; }
    set32(agree_tr,4*t,aag);
    t=t+1;
  }
  if(get32(wc,0)==wcb0){
    at=ob_app(ob,at,"K1T-STRUCT-PASS world_calls=0 after train COMMIT\n");
  } else {
    k1=0;
    at=ob_app(ob,at,"K1T-STRUCT-FAIL\n");
  }
  // Phase 2b: train PREFF (learner; internal prediction on train
  // plans, beliefs + plans only; zero world cost). Captures the
  // believed bumps and belief census for the feature audit.
  wcb0=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    let tL:i32=get32(mtrain,t*RECM+4);
    belief_execute(btrain, t*RECW, ptrain, t*PLANMAX, tL, ctmp, 0);
    let pc:i32=get32(ctmp,0);
    let pu:i32=get32(ctmp,4);
    let pe:i32=0;
    if(pu>0){ pe=(100*pc)/pu; }
    set32(preff_tr,4*t,pe);
    set32(bumps_tr,4*t,get32(ctmp,8));
    let wcc:i32=0;
    let icc:i32=0;
    let cc2:i32=0;
    while(cc2<CW){
      if(get8(btrain,t*RECW+cc2)==1){ wcc=wcc+1; }
      if(get8(btrain,t*RECW+CW+cc2)==1){ icc=icc+1; }
      cc2=cc2+1;
    }
    set32(walls_tr,4*t,wcc);
    set32(items_tr,4*t,icc);
    t=t+1;
  }
  if(get32(wc,0)==wcb0){
    at=ob_app(ob,at,"K1P-STRUCT-PASS world_calls unchanged after train PREFF\n");
  } else {
    k1=0;
    at=ob_app(ob,at,"K1P-STRUCT-FAIL\n");
  }
  // Phase 3: train CONSEQ (harness). The declared
  // consequence-training observations: true outcomes of the
  // committed train plans. Sealed verdicts never see these.
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // Phase 4: verifier LEARN (learner). (bucket, eff) pairs give
  // the bucket table (X3 comparison arm) and the per-bucket
  // prediction-bias means; the shuffled-eff variants feed the
  // ablation.
  t=0;
  while(t<NTRAIN){
    let bk:i32=get32(mtrain,t*RECM+12);
    let tc:i32=get32(ctrain,t*RECC);
    let te:i32=get32(ctrain,t*RECC+4);
    let tf:i32=0;
    if(te>0){ tf=(100*tc)/te; }
    set32(tbkt,4*t,bk);
    set32(teff,4*t,tf);
    t=t+1;
  }
  verifier_train(tbkt, teff, NTRAIN, vb);
  // Shuffle ONLY the eff array (expand3 C1 verbatim); buckets stay.
  t=0;
  while(t<NTRAIN){
    let u2:i32=t+7;
    if(u2>=NTRAIN){ u2=u2-NTRAIN; }
    set32(sbkt,4*t,get32(tbkt,4*t));
    set32(seff,4*t,get32(teff,4*u2));
    t=t+1;
  }
  let b:i32=0;
  while(b<4){
    set32(biassum,4*b,0);
    set32(biascnt,4*b,0);
    set32(biasshsm,4*b,0);
    set32(biasshct,4*b,0);
    set32(bmax,4*b,-1000000);
    set32(bmaxsh,4*b,-1000000);
    set32(bsq,4*b,0);
    set32(bsqsh,4*b,0);
    b=b+1;
  }
  let gsum:i32=0;
  let gshsum:i32=0;
  t=0;
  while(t<NTRAIN){
    let bk2:i32=get32(tbkt,4*t);
    let d:i32=get32(preff_tr,4*t)-get32(teff,4*t);
    let ds:i32=get32(preff_tr,4*t)-get32(seff,4*t);
    gsum=gsum+d;
    gshsum=gshsum+ds;
    if(bk2>=0){
      if(bk2<4){
        set32(biassum,4*bk2,get32(biassum,4*bk2)+d);
        set32(biascnt,4*bk2,get32(biascnt,4*bk2)+1);
        set32(biasshsm,4*bk2,get32(biasshsm,4*bk2)+ds);
        set32(biasshct,4*bk2,get32(biasshct,4*bk2)+1);
        let mx0:i32=get32(bmax,4*bk2);
        if(d>mx0){ set32(bmax,4*bk2,d); }
        let mx1:i32=get32(bmaxsh,4*bk2);
        if(ds>mx1){ set32(bmaxsh,4*bk2,ds); }
      }
    }
    t=t+1;
  }
  let gbias:i32=0;
  let gshbias:i32=0;
  if(NTRAIN>0){ gbias=gsum/NTRAIN; gshbias=gshsum/NTRAIN; }
  b=0;
  while(b<4){
    let bb:i32=gbias;
    if(get32(biascnt,4*b)>0){ bb=get32(biassum,4*b)/get32(biascnt,4*b); }
    set32(bias,4*b,bb);
    let bs:i32=gshbias;
    if(get32(biasshct,4*b)>0){ bs=get32(biasshsm,4*b)/get32(biasshct,4*b); }
    set32(biassh,4*b,bs);
    b=b+1;
  }
  // UCB second pass: sum of squared deviations from the integer
  // bucket mean (bias[] finalized above).
  t=0;
  while(t<NTRAIN){
    let bk5:i32=get32(tbkt,4*t);
    if(bk5>=0){
      if(bk5<4){
        let mb5:i32=get32(bias,4*bk5);
        let d5:i32=get32(preff_tr,4*t)-get32(teff,4*t);
        let e5:i32=d5-mb5;
        set32(bsq,4*bk5,get32(bsq,4*bk5)+e5*e5);
      }
    }
    t=t+1;
  }
  // Frozen UCB bucket biases into bucb[b].
  b=0;
  while(b<4){
    let mb6:i32=get32(bias,4*b);
    let nb6:i32=get32(biascnt,4*b);
    let ub:i32=gbias;
    if(nb6>0){ ub=mb6; }
    if(nb6>1){ ub=mb6+isqrt(get32(bsq,4*b)/(nb6-1)); }
    set32(bucb,4*b,ub);
    b=b+1;
  }
  // Case-level residual tables from resid_t = d_t - UCB[bkt[t]]
  // (and the shuffled twin). z_alloc zeroed: empty cell -> 0.
  let ri:i32=0;
  while(ri<404){
    set32(r1sum,4*ri,0);
    set32(r1cnt,4*ri,0);
    set32(r1shsum,4*ri,0);
    set32(r1shct,4*ri,0);
    ri=ri+1;
  }
  ri=0;
  while(ri<4){
    set32(r2sum,4*ri,0);
    set32(r2cnt,4*ri,0);
    set32(r2shsum,4*ri,0);
    set32(r2shct,4*ri,0);
    ri=ri+1;
  }
  ri=0;
  while(ri<12){
    set32(r3sum,4*ri,0);
    set32(r3cnt,4*ri,0);
    set32(r3shsum,4*ri,0);
    set32(r3shct,4*ri,0);
    ri=ri+1;
  }
  t=0;
  while(t<NTRAIN){
    let rkb:i32=get32(tbkt,4*t);
    let rkp:i32=get32(preff_tr,4*t);
    let rd:i32=get32(preff_tr,4*t)-get32(teff,4*t);
    let rds:i32=get32(preff_tr,4*t)-get32(seff,4*t);
    let rr:i32=rd-get32(bucb,4*rkb);
    let rrs:i32=rds-get32(bucb,4*rkb);
    let rix:i32=rkb*101+rkp;
    set32(r1sum,4*rix,get32(r1sum,4*rix)+rr);
    set32(r1cnt,4*rix,get32(r1cnt,4*rix)+1);
    set32(r1shsum,4*rix,get32(r1shsum,4*rix)+rrs);
    set32(r1shct,4*rix,get32(r1shct,4*rix)+1);
    let ra2:i32=get32(agree_tr,4*t);
    set32(r2sum,4*ra2,get32(r2sum,4*ra2)+rr);
    set32(r2cnt,4*ra2,get32(r2cnt,4*ra2)+1);
    set32(r2shsum,4*ra2,get32(r2shsum,4*ra2)+rrs);
    set32(r2shct,4*ra2,get32(r2shct,4*ra2)+1);
    let rbmp:i32=get32(bumps_tr,4*t);
    let rbb2:i32=0;
    if(rbmp>=1){ rbb2=1; }
    if(rbmp>=3){ rbb2=2; }
    let r3x:i32=rkb*3+rbb2;
    set32(r3sum,4*r3x,get32(r3sum,4*r3x)+rr);
    set32(r3cnt,4*r3x,get32(r3cnt,4*r3x)+1);
    set32(r3shsum,4*r3x,get32(r3shsum,4*r3x)+rrs);
    set32(r3shct,4*r3x,get32(r3shct,4*r3x)+1);
    t=t+1;
  }
  ri=0;
  while(ri<404){
    let c1:i32=get32(r1cnt,4*ri);
    if(c1>0){ set32(r1m,4*ri,get32(r1sum,4*ri)/c1); }
    let c1s:i32=get32(r1shct,4*ri);
    if(c1s>0){ set32(r1shm,4*ri,get32(r1shsum,4*ri)/c1s); }
    ri=ri+1;
  }
  ri=0;
  while(ri<4){
    let c2:i32=get32(r2cnt,4*ri);
    if(c2>0){ set32(r2m,4*ri,get32(r2sum,4*ri)/c2); }
    let c2s:i32=get32(r2shct,4*ri);
    if(c2s>0){ set32(r2shm,4*ri,get32(r2shsum,4*ri)/c2s); }
    ri=ri+1;
  }
  ri=0;
  while(ri<12){
    let c3:i32=get32(r3cnt,4*ri);
    if(c3>0){ set32(r3m,4*ri,get32(r3sum,4*ri)/c3); }
    let c3s:i32=get32(r3shct,4*ri);
    if(c3s>0){ set32(r3shm,4*ri,get32(r3shsum,4*ri)/c3s); }
    ri=ri+1;
  }
  // K9: the train diet's verdict on (bkt=1, preff=50): all four
  // such train cases must have d=0.
  let k9c:i32=0;
  let k9z:i32=0;
  t=0;
  while(t<NTRAIN){
    let q9b:i32=get32(tbkt,4*t);
    let q9p:i32=get32(preff_tr,4*t);
    let hit9:i32=0;
    if(q9b==1){
      if(q9p==50){ hit9=1; }
    }
    if(hit9==1){
      k9c=k9c+1;
      let q9d:i32=get32(preff_tr,4*t)-get32(teff,4*t);
      if(q9d==0){ k9z=k9z+1; }
    }
    t=t+1;
  }
  if(k9c==4){
    if(k9z==4){ k9=1; }
  }
  at=ob_app(ob,at,"K9-CHECK cnt=");
  at=ob_i32(ob,at,k9c);
  at=ob_app(ob,at," d0=");
  at=ob_i32(ob,at,k9z);
  at=ob_nl(ob,at);
  b=0;
  while(b<4){
    at=ob_app(ob,at,"VUCB b=");
    at=ob_i32(ob,at,b);
    at=ob_app(ob,at," ucb=");
    at=ob_i32(ob,at,get32(bucb,4*b));
    at=ob_nl(ob,at);
    b=b+1;
  }
  // Residual tables: R1 cells with train data only.
  b=0;
  while(b<4){
    let rp:i32=0;
    while(rp<101){
      let rx2:i32=b*101+rp;
      if(get32(r1cnt,4*rx2)>0){
        at=ob_app(ob,at,"R1 b=");
        at=ob_i32(ob,at,b);
        at=ob_app(ob,at," p=");
        at=ob_i32(ob,at,rp);
        at=ob_app(ob,at," cnt=");
        at=ob_i32(ob,at,get32(r1cnt,4*rx2));
        at=ob_app(ob,at," m=");
        at=ob_i32(ob,at,get32(r1m,4*rx2));
        at=ob_app(ob,at," shm=");
        at=ob_i32(ob,at,get32(r1shm,4*rx2));
        at=ob_nl(ob,at);
      }
      rp=rp+1;
    }
    b=b+1;
  }
  let ra3:i32=1;
  while(ra3<4){
    at=ob_app(ob,at,"R2 a=");
    at=ob_i32(ob,at,ra3);
    at=ob_app(ob,at," cnt=");
    at=ob_i32(ob,at,get32(r2cnt,4*ra3));
    at=ob_app(ob,at," m=");
    at=ob_i32(ob,at,get32(r2m,4*ra3));
    at=ob_app(ob,at," shm=");
    at=ob_i32(ob,at,get32(r2shm,4*ra3));
    at=ob_nl(ob,at);
    ra3=ra3+1;
  }
  b=0;
  while(b<4){
    let rb3:i32=0;
    while(rb3<3){
      let rx3:i32=b*3+rb3;
      at=ob_app(ob,at,"R3 b=");
      at=ob_i32(ob,at,b);
      at=ob_app(ob,at," bb=");
      at=ob_i32(ob,at,rb3);
      at=ob_app(ob,at," cnt=");
      at=ob_i32(ob,at,get32(r3cnt,4*rx3));
      at=ob_app(ob,at," m=");
      at=ob_i32(ob,at,get32(r3m,4*rx3));
      at=ob_app(ob,at," shm=");
      at=ob_i32(ob,at,get32(r3shm,4*rx3));
      at=ob_nl(ob,at);
      rb3=rb3+1;
    }
    b=b+1;
  }
  at=ob_app(ob,at,"VERIFIER T=");
  at=ob_i32(ob,at,get32(vb,48));
  at=ob_nl(ob,at);
  b=0;
  while(b<4){
    at=ob_app(ob,at,"VB b=");
    at=ob_i32(ob,at,b);
    at=ob_app(ob,at," cnt=");
    at=ob_i32(ob,at,get32(vb,16+4*b));
    at=ob_app(ob,at," mean=");
    at=ob_i32(ob,at,get32(vb,32+4*b));
    at=ob_app(ob,at," bias=");
    at=ob_i32(ob,at,get32(bias,4*b));
    at=ob_app(ob,at," biassh=");
    at=ob_i32(ob,at,get32(biassh,4*b));
    at=ob_nl(ob,at);
    b=b+1;
  }
  at=ob_app(ob,at,"TRAIN t bkt preff eff\n");
  t=0;
  while(t<NTRAIN){
    at=ob_app(ob,at,"T t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,get32(tbkt,4*t));
    at=ob_app(ob,at," preff=");
    at=ob_i32(ob,at,get32(preff_tr,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Train feature audit (learner-visible only): per-case
  // features for the phantom-vs-genuine comparison.
  at=ob_app(ob,at,"TAUDIT t bkt preff eff d L bumps walls items agree\n");
  t=0;
  while(t<NTRAIN){
    at=ob_app(ob,at,"TA t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,get32(tbkt,4*t));
    at=ob_app(ob,at," preff=");
    at=ob_i32(ob,at,get32(preff_tr,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(teff,4*t));
    at=ob_app(ob,at," L=");
    at=ob_i32(ob,at,get32(mtrain,t*RECM+4));
    at=ob_app(ob,at," bumps=");
    at=ob_i32(ob,at,get32(bumps_tr,4*t));
    at=ob_app(ob,at," walls=");
    at=ob_i32(ob,at,get32(walls_tr,4*t));
    at=ob_app(ob,at," items=");
    at=ob_i32(ob,at,get32(items_tr,4*t));
    at=ob_app(ob,at," agree=");
    at=ob_i32(ob,at,get32(agree_tr,4*t));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Phase 5: sealed SHIFT LOOP. sh=0..2, wp=15/30/45.
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    at=ob_app(ob,at,"SHIFT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," wp=");
    at=ob_i32(ob,at,wp);
    at=ob_nl(ob,at);
    // a. SEALED SETUP (harness; seeds verbatim expand3).
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // b. VERDICT COMMIT (learner). Beliefs, plans, and trained
    // tables/residuals only; the true-world stepper is never
    // called here (wc must not move).
    wcb0=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      learner_compose_rev(bseal, s*RECW, pseal_rev, s*PLANMAX, mseal_rev, s*RECM);
      learner_compose_nn(bseal, s*RECW, pseal_nn, s*PLANMAX, mseal_nn, s*RECM);
      let sL:i32=get32(mseal,s*RECM+4);
      belief_execute(bseal, s*RECW, pseal, s*PLANMAX, sL, ctmp, 0);
      let qc:i32=get32(ctmp,0);
      let qu:i32=get32(ctmp,4);
      let qe:i32=0;
      if(qu>0){ qe=(100*qc)/qu; }
      set32(preff,4*s,qe);
      set32(bumps_se,4*s,get32(ctmp,8));
      let swc:i32=0;
      let sic:i32=0;
      let sc2:i32=0;
      while(sc2<CW){
        if(get8(bseal,s*RECW+sc2)==1){ swc=swc+1; }
        if(get8(bseal,s*RECW+CW+sc2)==1){ sic=sic+1; }
        sc2=sc2+1;
      }
      set32(walls_se,4*s,swc);
      set32(items_se,4*s,sic);
      let sgf:i32=get32(mseal,s*RECM);
      let sgr:i32=get32(mseal_rev,s*RECM);
      let sgn:i32=get32(mseal_nn,s*RECM);
      let sag2:i32=1;
      if(sgr==sgf){ sag2=sag2+1; }
      if(sgn==sgf){ sag2=sag2+1; }
      set32(agree_se,4*s,sag2);
      // Case-level biases vv=1..6 (per case, not per bucket).
      let sbk:i32=get32(mseal,s*RECM+12);
      let cb1:i32=get32(bucb,4*sbk)+get32(r1m,4*(sbk*101+qe));
      set32(cbias,4*s,cb1);
      let cb2:i32=get32(bucb,4*sbk)+get32(r2m,4*sag2);
      set32(cbias,48+4*s,cb2);
      let sbm2:i32=get32(bumps_se,4*s);
      let sbb2:i32=0;
      if(sbm2>=1){ sbb2=1; }
      if(sbm2>=3){ sbb2=2; }
      let cb3:i32=get32(bucb,4*sbk)+get32(r3m,4*(sbk*3+sbb2));
      set32(cbias,96+4*s,cb3);
      let cb4:i32=get32(bucb,4*sbk)+get32(r1shm,4*(sbk*101+qe));
      set32(cbias,144+4*s,cb4);
      let cb5:i32=get32(bucb,4*sbk)+get32(r2shm,4*sag2);
      set32(cbias,192+4*s,cb5);
      let cb6:i32=get32(bucb,4*sbk)+get32(r3shm,4*(sbk*3+sbb2));
      set32(cbias,240+4*s,cb6);
      // Adjusted scores for vv=0..6.
      set32(adjv,4*s,qe-get32(bucb,4*sbk));
      set32(adjv,48+4*s,qe-cb1);
      set32(adjv,96+4*s,qe-cb2);
      set32(adjv,144+4*s,qe-cb3);
      set32(adjv,192+4*s,qe-cb4);
      set32(adjv,240+4*s,qe-cb5);
      set32(adjv,288+4*s,qe-cb6);
      set32(adj,4*s,qe-get32(bias,4*sbk));
      set32(adjsh,4*s,qe-get32(biassh,4*sbk));
      s=s+1;
    }
    if(get32(wc,0)==wcb0){
      at=ob_app(ob,at,"K1S-STRUCT-PASS sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    } else {
      k1=0;
      at=ob_app(ob,at,"K1S-STRUCT-FAIL sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    }
    // Sealed feature audit (learner-visible only; no eff).
    at=ob_app(ob,at,"SAUDIT s bkt preff L bumps walls items agree\n");
    s=0;
    while(s<NSEAL){
      at=ob_app(ob,at,"SA s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+12));
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*s));
      at=ob_app(ob,at," L=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+4));
      at=ob_app(ob,at," bumps=");
      at=ob_i32(ob,at,get32(bumps_se,4*s));
      at=ob_app(ob,at," walls=");
      at=ob_i32(ob,at,get32(walls_se,4*s));
      at=ob_app(ob,at," items=");
      at=ob_i32(ob,at,get32(items_se,4*s));
      at=ob_app(ob,at," agree=");
      at=ob_i32(ob,at,get32(agree_se,4*s));
      at=ob_nl(ob,at);
      s=s+1;
    }
    // Learner-computed bars: mean predicted eff (T_pred, the
    // shared label bar), mean adjusted score (T_hyb), mean
    // shuffled-adjusted score (T_shyb), and per-variant TV.
    // No world data enters.
    let totp:i32=0;
    let totc:i32=0;
    let totcs:i32=0;
    let vv2:i32=0;
    while(vv2<7){
      set32(totv,4*vv2,0);
      vv2=vv2+1;
    }
    s=0;
    while(s<NSEAL){
      totp=totp+get32(preff,4*s);
      totc=totc+get32(adj,4*s);
      totcs=totcs+get32(adjsh,4*s);
      let vv3:i32=0;
      while(vv3<7){
        set32(totv,4*vv3,get32(totv,4*vv3)+get32(adjv,vv3*48+4*s));
        vv3=vv3+1;
      }
      s=s+1;
    }
    let Tpred:i32=totp/NSEAL;
    let Thyb:i32=totc/NSEAL;
    let Tshyb:i32=totcs/NSEAL;
    set32(tpr,4*sh,Tpred);
    set32(thy,4*sh,Thyb);
    set32(tshy,4*sh,Tshyb);
    let vv4:i32=0;
    while(vv4<7){
      set32(tvar,4*vv4,get32(totv,4*vv4)/NSEAL);
      vv4=vv4+1;
    }
    s=0;
    while(s<NSEAL){
      let sbk2:i32=get32(mseal,s*RECM+12);
      let va:i32=0;
      if(get32(preff,4*s)>=Tpred){ va=1; }
      set32(verA,4*s,va);
      set32(verX,4*s,verifier_check(vb,sbk2));
      let vh:i32=0;
      if(get32(adj,4*s)>=Thyb){ vh=1; }
      set32(verH,4*s,vh);
      let vs:i32=0;
      if(get32(adjsh,4*s)>=Tshyb){ vs=1; }
      set32(verHsh,4*s,vs);
      let vm:i32=0;
      if(get32(adj,4*s)>Thyb){ vm=1; }
      set32(verMG,4*s,vm);
      let vv5:i32=0;
      while(vv5<7){
        let vvx:i32=0;
        if(get32(adjv,vv5*48+4*s)>get32(tvar,4*vv5)){ vvx=1; }
        set32(verv,vv5*48+4*s,vvx);
        vv5=vv5+1;
      }
      s=s+1;
    }
    // c. SCORING (harness). The sealed true-world pass; labels
    // live only here and are never observed by the learner.
    let nph:i32=0;
    let sph:i32=0;
    let nfh:i32=0;
    let sfh:i32=0;
    let ahn:i32=0;
    let aon:i32=0;
    let axn:i32=0;
    let ahsn:i32=0;
    let amn:i32=0;
    let ngen:i32=0;
    at=ob_app(ob,at,"V s bkt preff adj verH verA verX verHsh verMG v0 v1 v2 v3 v4 v5 v6 agree eff ge\n");
    s=0;
    while(s<NSEAL){
      let sbk3:i32=get32(mseal,s*RECM+12);
      let sL2:i32=get32(mseal,s*RECM+4);
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL2, cseal, s*RECC, escr, 0, wc);
      let sc2:i32=get32(cseal,s*RECC);
      let su2:i32=get32(cseal,s*RECC+4);
      let seff:i32=0;
      if(su2>0){ seff=(100*sc2)/su2; }
      set32(seffA,4*s,seff);
      let ge:i32=0;
      if(seff>=Tpred){ ge=1; }
      let vh2:i32=get32(verH,4*s);
      let va2:i32=get32(verA,4*s);
      let vx2:i32=get32(verX,4*s);
      let vs2:i32=get32(verHsh,4*s);
      let vm2:i32=get32(verMG,4*s);
      if(vh2==1){ nph=nph+1; sph=sph+seff; }
      else { nfh=nfh+1; sfh=sfh+seff; }
      if(vh2==ge){ ahn=ahn+1; }
      if(va2==ge){ aon=aon+1; }
      if(vx2==ge){ axn=axn+1; }
      if(vs2==ge){ ahsn=ahsn+1; }
      if(vm2==ge){ amn=amn+1; }
      if(ge==1){ ngen=ngen+1; }
      let vv6:i32=0;
      while(vv6<7){
        if(get32(verv,vv6*48+4*s)==ge){
          set32(acc_v,vv6*12+4*sh,get32(acc_v,vv6*12+4*sh)+1);
        }
        vv6=vv6+1;
      }
      at=ob_app(ob,at,"V s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,sbk3);
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*s));
      at=ob_app(ob,at," adj=");
      at=ob_i32(ob,at,get32(adj,4*s));
      at=ob_app(ob,at," verH=");
      at=ob_i32(ob,at,vh2);
      at=ob_app(ob,at," verA=");
      at=ob_i32(ob,at,va2);
      at=ob_app(ob,at," verX=");
      at=ob_i32(ob,at,vx2);
      at=ob_app(ob,at," verHsh=");
      at=ob_i32(ob,at,vs2);
      at=ob_app(ob,at," verMG=");
      at=ob_i32(ob,at,vm2);
      let vv7:i32=0;
      while(vv7<7){
        at=ob_app(ob,at," v");
        at=ob_i32(ob,at,vv7);
        at=ob_app(ob,at,"=");
        at=ob_i32(ob,at,get32(verv,vv7*48+4*s));
        vv7=vv7+1;
      }
      at=ob_app(ob,at," agree=");
      at=ob_i32(ob,at,get32(agree_se,4*s));
      at=ob_app(ob,at," eff=");
      at=ob_i32(ob,at,seff);
      at=ob_app(ob,at," ge=");
      at=ob_i32(ob,at,ge);
      at=ob_nl(ob,at);
      // Per-variant adjusted scores (learner-computed).
      at=ob_app(ob,at,"VA s=");
      at=ob_i32(ob,at,s);
      let vv7b:i32=0;
      while(vv7b<7){
        at=ob_app(ob,at," a");
        at=ob_i32(ob,at,vv7b);
        at=ob_app(ob,at,"=");
        at=ob_i32(ob,at,get32(adjv,vv7b*48+4*s));
        vv7b=vv7b+1;
      }
      at=ob_nl(ob,at);
      s=s+1;
    }
    // HARNESS-ORACLE-DIAGNOSTIC: sealed-label per-(bucket,preff)
    // cell mean bias, applied with the transductive bar. This is
    // the experimenter's post-hoc analysis, NOT a learner
    // variant: sealed truth is used here and never reaches the
    // learner. (A8 audit: the token "oracle" appears only in
    // this fenced block.)
    let oi:i32=0;
    while(oi<404){
      set32(ocsum,4*oi,0);
      set32(occnt,4*oi,0);
      oi=oi+1;
    }
    let os2:i32=0;
    while(os2<NSEAL){
      let okb:i32=get32(mseal,os2*RECM+12);
      let okp:i32=get32(preff,4*os2);
      let od:i32=get32(preff,4*os2)-get32(seffA,4*os2);
      let oix:i32=okb*101+okp;
      set32(ocsum,4*oix,get32(ocsum,4*oix)+od);
      set32(occnt,4*oix,get32(occnt,4*oix)+1);
      os2=os2+1;
    }
    let oto:i32=0;
    os2=0;
    while(os2<NSEAL){
      let okb2:i32=get32(mseal,os2*RECM+12);
      let okp2:i32=get32(preff,4*os2);
      let oix2:i32=okb2*101+okp2;
      let ocb:i32=0;
      if(get32(occnt,4*oix2)>0){ ocb=get32(ocsum,4*oix2)/get32(occnt,4*oix2); }
      set32(adjO,4*os2,get32(preff,4*os2)-ocb);
      oto=oto+get32(adjO,4*os2);
      os2=os2+1;
    }
    let obar:i32=oto/NSEAL;
    os2=0;
    while(os2<NSEAL){
      let ov:i32=0;
      if(get32(adjO,4*os2)>obar){ ov=1; }
      set32(verO,4*os2,ov);
      let ge2:i32=0;
      if(get32(seffA,4*os2)>=Tpred){ ge2=1; }
      if(ov==ge2){ set32(acc_or,4*sh,get32(acc_or,4*sh)+1); }
      at=ob_app(ob,at,"OC s=");
      at=ob_i32(ob,at,os2);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,get32(mseal,os2*RECM+12));
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*os2));
      at=ob_app(ob,at," adjO=");
      at=ob_i32(ob,at,get32(adjO,4*os2));
      at=ob_app(ob,at," verO=");
      at=ob_i32(ob,at,ov);
      at=ob_app(ob,at," eff=");
      at=ob_i32(ob,at,get32(seffA,4*os2));
      at=ob_app(ob,at," ge=");
      at=ob_i32(ob,at,ge2);
      at=ob_nl(ob,at);
      os2=os2+1;
    }
    at=ob_app(ob,at,"OSUM sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," obar=");
    at=ob_i32(ob,at,obar);
    at=ob_app(ob,at," acc_or=");
    at=ob_i32(ob,at,get32(acc_or,4*sh));
    at=ob_nl(ob,at);
    let majn:i32=ngen;
    if(NSEAL-ngen>ngen){ majn=NSEAL-ngen; }
    set32(acc_h,4*sh,ahn);
    set32(acc_of,4*sh,aon);
    set32(acc_x3,4*sh,axn);
    set32(acc_hsh,4*sh,ahsn);
    set32(acc_mg,4*sh,amn);
    set32(maj,4*sh,majn);
    set32(k3n,16*sh,nph);
    set32(k3n,16*sh+4,sph);
    set32(k3n,16*sh+8,nfh);
    set32(k3n,16*sh+12,sfh);
    at=ob_app(ob,at,"VSUM sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," np_h=");
    at=ob_i32(ob,at,nph);
    at=ob_app(ob,at," sp_h=");
    at=ob_i32(ob,at,sph);
    at=ob_app(ob,at," nf_h=");
    at=ob_i32(ob,at,nfh);
    at=ob_app(ob,at," sf_h=");
    at=ob_i32(ob,at,sfh);
    at=ob_app(ob,at," acc_h=");
    at=ob_i32(ob,at,ahn);
    at=ob_app(ob,at," acc_of=");
    at=ob_i32(ob,at,aon);
    at=ob_app(ob,at," acc_x3=");
    at=ob_i32(ob,at,axn);
    at=ob_app(ob,at," acc_hsh=");
    at=ob_i32(ob,at,ahsn);
    at=ob_app(ob,at," acc_mg=");
    at=ob_i32(ob,at,amn);
    let vv8:i32=0;
    while(vv8<7){
      at=ob_app(ob,at," av");
      at=ob_i32(ob,at,vv8);
      at=ob_app(ob,at,"=");
      at=ob_i32(ob,at,get32(acc_v,vv8*12+4*sh));
      vv8=vv8+1;
    }
    let vv9:i32=0;
    while(vv9<7){
      at=ob_app(ob,at," tv");
      at=ob_i32(ob,at,vv9);
      at=ob_app(ob,at,"=");
      at=ob_i32(ob,at,get32(tvar,4*vv9));
      vv9=vv9+1;
    }
    at=ob_app(ob,at," maj=");
    at=ob_i32(ob,at,majn);
    at=ob_app(ob,at," tpred=");
    at=ob_i32(ob,at,Tpred);
    at=ob_app(ob,at," thyb=");
    at=ob_i32(ob,at,Thyb);
    at=ob_app(ob,at," tshyb=");
    at=ob_i32(ob,at,Tshyb);
    at=ob_nl(ob,at);
    sh=sh+1;
  }
  // Phase: kill-bar verdicts (provisional; K1 in-program above,
  // K2 by shell sha256). Flat flag products, no deep nesting.
  let k3a:i32=0;
  let k3b:i32=0;
  if(get32(acc_of,0)==10){ k3a=1; }
  if(get32(acc_x3,0)==9){ k3b=1; }
  let k3:i32=k3a*k3b;
  let k4a:i32=0;
  let k4b:i32=0;
  if(get32(acc_of,8)==8){ k4a=1; }
  if(get32(acc_x3,8)==10){ k4b=1; }
  let k4:i32=k4a*k4b;
  // K5: a case-level variant (vv 1..3) reaches 12/12 @15.
  let k5:i32=0;
  let kv:i32=1;
  while(kv<4){
    if(get32(acc_v,kv*12)==12){ k5=1; }
    kv=kv+1;
  }
  // K6: no harm @15 (all case-level variants >= 11).
  let k6:i32=1;
  kv=1;
  while(kv<4){
    if(get32(acc_v,kv*12)<11){ k6=0; }
    kv=kv+1;
  }
  // K7: a case-level variant gains @45 (> 10).
  let k7:i32=0;
  kv=1;
  while(kv<4){
    if(get32(acc_v,kv*12+8)>10){ k7=1; }
    kv=kv+1;
  }
  // K8: no harm @45 (all case-level variants >= 10).
  let k8:i32=1;
  kv=1;
  while(kv<4){
    if(get32(acc_v,kv*12+8)<10){ k8=0; }
    kv=kv+1;
  }
  // K10: sealed-label (bucket,preff)-cell bias @15 does not beat 11.
  let k10:i32=0;
  if(get32(acc_or,0)<=11){ k10=1; }
  // VSTAR = argmax acc@15 over vv 1..3, tie-break 1,2,3.
  let vstar:i32=1;
  kv=2;
  while(kv<4){
    if(get32(acc_v,kv*12)>get32(acc_v,vstar*12)){ vstar=kv; }
    kv=kv+1;
  }
  at=ob_app(ob,at,"VSTAR=");
  at=ob_i32(ob,at,vstar);
  at=ob_nl(ob,at);
  if(k3==1){ at=ob_app(ob,at,"K3-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K3-PROV-FAIL\n"); }
  if(k4==1){ at=ob_app(ob,at,"K4-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K4-PROV-FAIL\n"); }
  if(k5==1){ at=ob_app(ob,at,"K5-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K5-PROV-FAIL\n"); }
  if(k6==1){ at=ob_app(ob,at,"K6-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K6-PROV-FAIL\n"); }
  if(k7==1){ at=ob_app(ob,at,"K7-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K7-PROV-FAIL\n"); }
  if(k8==1){ at=ob_app(ob,at,"K8-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K8-PROV-FAIL\n"); }
  if(k9==1){ at=ob_app(ob,at,"K9-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K9-PROV-FAIL\n"); }
  if(k10==1){ at=ob_app(ob,at,"K10-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K10-PROV-FAIL\n"); }
  if(k1==1){ at=ob_app(ob,at,"K1-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K1-PROV-FAIL\n"); }
  at=ob_app(ob,at,"K2-AUDIT-SHELL\n");
  at=ob_app(ob,at,"FLAGS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_app(ob,at," k9=");
  at=ob_i32(ob,at,k9);
  at=ob_app(ob,at," k10=");
  at=ob_i32(ob,at,k10);
  at=ob_app(ob,at," vstar=");
  at=ob_i32(ob,at,vstar);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"WC-FINAL=");
  at=ob_i32(ob,at,get32(wc,0));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCCB-END\n");
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

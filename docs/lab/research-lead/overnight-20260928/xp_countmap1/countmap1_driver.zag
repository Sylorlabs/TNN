// countmap1_driver.zag -- XP-COUNTMAP-1 battery driver.
//
// Two-relation frozen negative: phase A teaches counting over
// rel 82 (forms MAP_Y, the singleton count MAP, via the trial
// count path, replicating the XP-DAGFAN-4 xd4_train shape
// verbatim). Phase B teaches counting over rel 85 at a fresh
// subject; the trial layer mints a second live count MAP
// (MAP_V2), while the composition layer (xs5_find_countmap /
// xs5_agg_rel / xs5_compose) keeps ignoring it. Banks
// COUNTMAP-SINGLETON Facts A-C as a frozen result.
//
// Pure Zag. Frozen operators reused verbatim, never redefined.
// All identifiers opaque. No domain labels.

// ---- cm1 helpers ----

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn cm1_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

// Exhaustive count-MAP scan using the frozen predicate itself:
// live tag-20 MAP whose field-20 graph contains an INC cell.
// Stashes the first two ids into out[0], out[1]. Returns count.
fn cm1_scan_countmaps(W:[]u8,out:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){
        if(n<2){set32(out,n*4,m);}
        n=n+1;
      }
    }
    m=m+1;
  }
  return n;
}

// First type-1 provenance edge target's relation for MAP m, or -1.
// Mirrors the xs5_agg_rel read shape.
fn cm1_prov_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// ---- phases ----

// Phase A: count training over rel 82. Replicates the XP-DAGFAN-4
// xd4_train shape verbatim: TRAIN-X, TRAIN-Y, 30 distractors.
fn cm1_train(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let ax:i32=ev_query_xs5(W,11,91,14,0);
  emit("TRAIN-X "); e64(ax); emit("\n");
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let ay:i32=ev_query_xs5(W,50,92,3,0);
  emit("TRAIN-Y "); e64(ay); emit("\n");
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// Phase B: second count over rel 85 at fresh subject 110.
// B1: direct xs5_compose (pre-formation). B2: full query (trial
// forms MAP_V2). B3: direct xs5_compose (post-formation).
// Results stashed in res[0..2].
fn cm1_phaseB(W:[]u8,res:[]u8)void {
  ev_teach(W,110,85,111); ev_teach(W,111,85,112);
  ev_teach(W,112,85,113); ev_teach(W,113,85,114);
  let cpre:i32=xs5_compose(W,110,117,4);
  emit("B1 compose-pre "); e64(cpre); emit("\n");
  set32(res,0,cpre);
  let b:i32=ev_query_xs5(W,110,117,4,0);
  emit("B2 ans "); e64(b); emit("\n");
  set32(res,4,b);
  let cpost:i32=xs5_compose(W,110,117,4);
  emit("B3 compose-post "); e64(cpost); emit("\n");
  set32(res,8,cpost);
  return;
}

// ---- hypotheses ----

// Phase-A gates: the singleton formed exactly as in XP-DAGFAN-4.
fn cm1_hA(W:[]u8,t:[]u8,my:i32)void {
  if(cm1_ck(t,my>=0)==1){emit("A.0 count MAP formed PASS\n");} else {emit("A.0 count MAP formed FAIL\n");}
  if(cm1_ck(t,xs5_agg_rel(W)==82)==1){emit("A.1 agg rel 82 PASS\n");} else {emit("A.1 agg rel 82 FAIL\n");}
  let ids:[]u8=z_alloc(8);
  let ncm:i32=cm1_scan_countmaps(W,ids);
  if(cm1_ck(t,ncm==1)==1){emit("A.2 one count MAP pre-B PASS\n");} else {emit("A.2 one count MAP pre-B FAIL\n");}
  return;
}

// H1: the two-relation negative (K1-K4).
fn cm1_h1(W:[]u8,t:[]u8,my:i32,res:[]u8)void {
  let ids:[]u8=z_alloc(8);
  let ncm:i32=cm1_scan_countmaps(W,ids);
  if(cm1_ck(t,ncm==2)==1){emit("K1.0 two count MAPs PASS\n");} else {emit("K1.0 two count MAPs FAIL\n");}
  let ok1:i32=0;
  if(ncm==2){
    if(cm1_prov_rel(W,get32(ids,4))==85){ok1=1;}
  }
  if(cm1_ck(t,ok1==1)==1){emit("K1.1 second count MAP prov rel 85 PASS\n");} else {emit("K1.1 second count MAP prov rel 85 FAIL\n");}
  let cf:i32=xs5_find_countmap(W);
  let ok2:i32=0;
  if(my>=0 && cf==my){ok2=1;}
  if(cm1_ck(t,ok2==1)==1){emit("K2.0 lookup returns MAP_Y PASS\n");} else {emit("K2.0 lookup returns MAP_Y FAIL\n");}
  if(cm1_ck(t,xs5_agg_rel(W)==82)==1){emit("K3.0 agg rel still 82 PASS\n");} else {emit("K3.0 agg rel still 82 FAIL\n");}
  let cpre:i32=get32(res,0);
  let b:i32=get32(res,4);
  let cpost:i32=get32(res,8);
  let ok4:i32=0;
  if(cpre==-2 && b==4 && cpost==-2){ok4=1;}
  if(cm1_ck(t,ok4==1)==1){emit("K4.0 split -2/4/-2 PASS\n");} else {emit("K4.0 split -2/4/-2 FAIL\n");}
  return;
}

fn main()i32 {
  emit("COUNTMAP1-START\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  cm1_train(W);
  let my:i32=xs5_find_countmap(W);
  emit("A countmap "); e64(my); emit(" aggrel "); e64(xs5_agg_rel(W)); emit("\n");
  cm1_hA(W,t,my);
  let res:[]u8=z_alloc(12);
  set32(res,0,-99); set32(res,4,-99); set32(res,8,-99);
  cm1_phaseB(W,res);
  cm1_h1(W,t,my,res);
  emit("COUNTMAP1-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("COUNTMAP1-END\n");
  return 0;
}

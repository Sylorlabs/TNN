// c3_base.zag -- base for the cogops-3way battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the three researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE), vfy_gen (id 1, VERIFY),
// cnt_gen (id 4, COUNT).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world epoch: NO VERSIONING INSTALLED in this lane (EPOCH-STRONG
// ---- probe). The cell at state slot 931 exists but is never written:
// ---- w_epoch_bump is a documented no-op, and neither world-mutation
// ---- operation invokes it. The learner's sg(S,931) reads therefore
// ---- observe a dead signal (always 0). w_epoch_get stays so stage
// ---- code can sample the dead cell for the ES-E discriminator. ----
fn w_epoch_bump(S:[]u8)void {
  // stamping disabled: no versioning installed in this lane.
  return;
}
// read accessor: stage code never names the epoch cell directly.
fn w_epoch_get(S:[]u8)i32 {
  return get32(S,931*4);
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
// fact_add: the learner's world-mutation operation. EPOCH-STRONG:
// the mutation happens; nothing stamps (no versioning installed).
// HOOK-PHASE0 A2.6: a successful store bumps the per-arena
// mutation-event counter in S cell 932. A rejected store (n>=64)
// is not a mutation and does not bump.
fn fact_add(S:[]u8,A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
    set32(S,932*4,get32(S,932*4)+1);
  }
  return;
}
// fact_set_obj: in-place object mutation through the learner's world
// interface. EPOCH-STRONG: the mutation happens; nothing stamps.
// HOOK-PHASE0 A2.6: every call bumps the per-arena mutation-event
// counter in S cell 932.
fn fact_set_obj(S:[]u8,A:[]u8,idx:i32,o:i32)void {
  set32(A,4+idx*12+8,o);
  set32(S,932*4,get32(S,932*4)+1);
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// Distinct-object count: for each subject in sb[so..], scans ALL facts
// and collects distinct objects o with (subj, rel, o). Returns the
// distinct count. Cost = nsubs * nfacts fact checks (dedup compares
// not counted). seen: scratch [nseen, objs...], reset on entry.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let nf:i32=get32(A,0);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<64){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- HOOK-PHASE0 A2.1: learner-allocated persistent state ----
// Bump allocator over a carved S region: bytes [3736,4120), i.e.
// S cells 934..1029 (384 bytes). The cursor lives in S cell 933, so
// allocations persist across calls for the arena's lifetime (the S
// arena is z_alloc-zeroed, so the cursor starts at 0). Sizes round
// up to 4-byte alignment. Returns the byte offset of the block, or
// -1 on exhaustion (cursor unchanged) or on negative size. This is
// infrastructure: it hands out untyped bytes; assigning semantics
// is the learner's future job. Lane-base code only: get32/set32,
// arithmetic, branch. No protected-core change.
fn la_alloc(S:[]u8,n:i32)i32 {
  if(n<0){ return -1; }
  let a:i32=n;
  let rem:i32=a-(a/4)*4;
  if(rem!=0){ a=a+(4-rem); }
  let cur:i32=get32(S,933*4);
  if(cur<0){ cur=0; }
  if(cur+a>384){ return -1; }
  set32(S,933*4,cur+a);
  return 3736+cur;
}
// Learner-writable registry: the honest substrate for
// learner-chosen meaning records. 8 entries of [cell, tag, ev0, ev1]
// at S cells 1030+e*4; the entry count lives in S cell 1062.
// Returns the entry index, or -1 when the table is full. Tags are
// learner-chosen i32s; no meaning vocabulary is enumerated here.
fn la_reg(S:[]u8,cell:i32,tag:i32,ev0:i32,ev1:i32)i32 {
  let n:i32=get32(S,1062*4);
  if(n<0){ n=0; }
  if(n>=8){ return -1; }
  let b:i32=1030+n*4;
  set32(S,b*4,cell);
  set32(S,(b+1)*4,tag);
  set32(S,(b+2)*4,ev0);
  set32(S,(b+3)*4,ev1);
  set32(S,1062*4,n+1);
  return n;
}

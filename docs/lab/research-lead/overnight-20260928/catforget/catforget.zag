// catforget.zag -- H-CATFORGET-1: catastrophic forgetting under interference.
//
// One persistent learner per arm across three phases (no reset):
//   Phase 1: master task A (follow->complete composition on N1 worlds).
//   Phase 2: interfering task B (SIM: F worlds sharing appl cell
//            (gather,1); DIFF: U worlds on disjoint substrate).
//   Phase 3: re-test A with learning frozen. Retention measured.
//
// Arms: 0 FULL-SIM, 1 SEV-SIM, 2 FULL-DIFF, 3 SEV-DIFF.
// SEV arms record comp links but never consult them in scoring
// (the C220 contrast: severed links).
//
// Prereg: PREREG.md (commit 5de0d76a7), frozen before implementation.
// Pure Zag. Deterministic: two LCG streams, seeds 111/222/333.
// Output: single preallocated buffer, one _zag_raw_syscall write.
//
// Learner-state cell map (i32 cells in S):
//   0..159   appl_sum[5*32]   160..319 appl_n[5*32]
//   320..344 comp_sum[5*5]    345..369 comp_n[5*5]
//   370 rng_env  371 rng_learn
//   372..419 log ring (24x2)  420 log_head
//   421..468 edges (16x3)     469 edge_n
//   470..474 R0..R4  475 CUR  476 status  477 ans  478 true_ans
//   479..490 meas_ok[12]      491..502 meas_tot[12]
//   503..514 estep_op[12]  515..526 estep_ctx[12]
//   527..538 estep_out[12]  539..550 estep_eff[12]
//   551..555 blen[5]  556..559 p1late_ok[4]  560..563 p1late_tot[4]
// Bodies live in learner-owned byte array B (5x24 bytes).
// ISA: 1 MATCH r,kind | 2 ADD rd,ra,rb | 3 ANSWER r | 4 SETCUR r.

// ============ output helpers (single buffer, no _zag_print) ============
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
// ============ cell helpers (u8-backed, little-endian) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
// ============ deterministic RNG (two LCG streams) ============
fn xorsh(S:[]u8,cell:i32)i32 {
  let s:i32=sg(S,cell);
  let ns:i32=(s*1103515245+12345) & 2147483647;
  ss(S,cell,ns);
  return ns;
}
fn rrange(S:[]u8,cell:i32,lo:i32,hi:i32)i32 {
  let r:i32=xorsh(S,cell);
  let span:i32=hi-lo+1;
  return lo + (r - (r/span)*span);
}
// ============ graph store (generic machinery) ============
fn e_add(S:[]u8,from:i32,kind:i32,to:i32)void {
  let n:i32=sg(S,469);
  ss(S,421+n*3,from); ss(S,421+n*3+1,kind); ss(S,421+n*3+2,to);
  ss(S,469,n+1);
  return;
}
fn find_edge(S:[]u8,from:i32,kind:i32)i32 {
  let n:i32=sg(S,469);
  let i:i32=0;
  while(i<n){
    if(sg(S,421+i*3)==from && sg(S,421+i*3+1)==kind){ return sg(S,421+i*3+2); }
    i=i+1;
  }
  return -1;
}
fn has_edge(S:[]u8,from:i32,kind:i32)i32 {
  if(find_edge(S,from,kind)>=0){ return 1; }
  return 0;
}
fn probe(S:[]u8)i32 {
  let c:i32=sg(S,475);
  let r:i32=has_edge(S,c,1);
  r=r+2*has_edge(S,c,2);
  r=r+4*has_edge(S,c,4);
  r=r+8*has_edge(S,c,5);
  r=r+16*has_edge(S,c,6);
  return r;
}
// ============ interpreter (never branches on op id) ============
// returns 0 FAIL, 1 ANSWERED, 2 MOVED
fn exec_body(S:[]u8,B:[]u8,bs:i32,bl:i32)i32 {
  let pc:i32=0;
  while(pc+4<=bl){
    let op:i32=B[bs+pc] as i32;
    let a:i32=B[bs+pc+1] as i32;
    let b:i32=B[bs+pc+2] as i32;
    let c:i32=B[bs+pc+3] as i32;
    if(op==1){
      let f:i32=find_edge(S,sg(S,475),b);
      if(f<0){ ss(S,476,0); return 0; }
      ss(S,470+a,f);
      pc=pc+4;
    } else {
      if(op==2){
        ss(S,470+a,sg(S,470+b)+sg(S,470+c));
        pc=pc+4;
      } else {
        if(op==3){
          ss(S,477,sg(S,470+a));
          ss(S,476,1);
          return 1;
        } else {
          if(op==4){
            ss(S,475,sg(S,470+a));
            ss(S,476,2);
            return 2;
          } else { ss(S,476,0); return 0; }
        }
      }
    }
  }
  ss(S,476,0);
  return 0;
}
// ============ op bodies (learner-owned byte arrays) ============
// 0 gather: MATCH R0,V(1); ANSWER R0
// 1 follow: MATCH R0,D(2); SETCUR R0
// 2 complete: MATCH R0,V; MATCH R1,R(3); ADD R2,R0,R1; ANSWER R2
// 3 followT: MATCH R0,T(5); SETCUR R0
// 4 readU: MATCH R0,U(6); ANSWER R0
fn build_bodies(B:[]u8)void {
  B[0]=1; B[1]=0; B[2]=1; B[3]=0; B[4]=3; B[5]=0; B[6]=0; B[7]=0;
  B[24]=1; B[25]=0; B[26]=2; B[27]=0; B[28]=4; B[29]=0; B[30]=0; B[31]=0;
  B[48]=1; B[49]=0; B[50]=1; B[51]=0;
  B[52]=1; B[53]=1; B[54]=3; B[55]=0;
  B[56]=2; B[57]=2; B[58]=0; B[59]=1;
  B[60]=3; B[61]=2; B[62]=0; B[63]=0;
  B[72]=1; B[73]=0; B[74]=5; B[75]=0; B[76]=4; B[77]=0; B[78]=0; B[79]=0;
  B[96]=1; B[97]=0; B[98]=6; B[99]=0; B[100]=3; B[101]=0; B[102]=0; B[103]=0;
  return;
}
// ============ learned means ============
fn amean(S:[]u8,o:i32,ctx:i32)i32 {
  let n:i32=sg(S,160+o*32+ctx);
  if(n==0){ return 500; }
  return sg(S,o*32+ctx)/n;
}
fn cmean(S:[]u8,p:i32,o:i32)i32 {
  let n:i32=sg(S,345+p*5+o);
  if(n==0){ return 500; }
  return sg(S,320+p*5+o)/n;
}
// ============ selector (never branches on op id) ============
fn select_op(S:[]u8,sev:i32,prev:i32,prev_eff:i32,tried:i32,eps_on:i32)i32 {
  let ctx:i32=probe(S);
  if(eps_on==1){
    let r:i32=xorsh(S,371);
    if(r-(r/100)*100 < 15){
      let cnt:i32=0;
      let q:i32=0;
      while(q<5){ if((tried & (1<<q))==0){ cnt=cnt+1; } q=q+1; }
      if(cnt>0){
        let pick:i32=r-(r/cnt)*cnt;
        q=0;
        while(q<5){
          if((tried & (1<<q))==0){
            if(pick==0){ return q; }
            pick=pick-1;
          }
          q=q+1;
        }
      }
    }
  }
  let best:i32=-1;
  let best_sc:i32=0;
  let best_tr:i32=0;
  let o:i32=0;
  while(o<5){
    if((tried & (1<<o))==0){
      let sc:i32=amean(S,o,ctx);
      if(sev==0){
        if(prev>=0){
          if(prev_eff==1){ sc=sc+cmean(S,prev,o); }
        }
      }
      let tr:i32=sg(S,160+o*32+ctx);
      if(best<0){ best=o; best_sc=sc; best_tr=tr; }
      else {
        if(sc>best_sc){ best=o; best_sc=sc; best_tr=tr; }
        else {
          if(sc==best_sc){
            if(tr<best_tr){ best=o; best_sc=sc; best_tr=tr; }
            else { if(tr==best_tr && o<best){ best=o; best_sc=sc; best_tr=tr; } }
          }
        }
      }
    }
    o=o+1;
  }
  return best;
}
// ============ worlds ============
fn build_world(S:[]u8,w:i32)void {
  ss(S,469,0);
  ss(S,475,0);
  if(w==0){
    let v2:i32=rrange(S,370,1,50);
    let k:i32=rrange(S,370,1,50);
    e_add(S,0,2,1);
    e_add(S,1,1,v2);
    e_add(S,1,3,k);
    ss(S,478,v2+k);
  } else {
    if(w==1){
      let a:i32=rrange(S,370,1,50);
      e_add(S,0,1,a);
      ss(S,478,a);
    } else {
      let wv:i32=rrange(S,370,1,50);
      e_add(S,0,5,1);
      e_add(S,1,6,wv);
      ss(S,478,wv);
    }
  }
  return;
}
// ============ episode ============
fn run_episode(S:[]u8,B:[]u8,w:i32,sev:i32,learn:i32,eps_on:i32)i32 {
  build_world(S,w);
  let tried:i32=0;
  let prev:i32=-1;
  let prev_eff:i32=0;
  let solved:i32=0;
  let nsteps:i32=0;
  let step:i32=0;
  while(step<12){
    let ctx:i32=probe(S);
    let o:i32=select_op(S,sev,prev,prev_eff,tried,eps_on);
    if(o<0){ step=99; }
    else {
      tried=tried | (1<<o);
      let st:i32=exec_body(S,B,o*24,sg(S,551+o));
      ss(S,503+step,o);
      ss(S,515+step,ctx);
      if(st==0){
        ss(S,527+step,0); ss(S,539+step,0);
        prev=o; prev_eff=0;
        nsteps=step+1; step=step+1;
      } else {
        if(st==2){
          ss(S,527+step,3); ss(S,539+step,1);
          prev=o; prev_eff=1;
          nsteps=step+1; step=step+1;
        } else {
          ss(S,539+step,1);
          prev=o; prev_eff=1;
          if(sg(S,477)==sg(S,478)){ solved=1; ss(S,527+step,2); }
          else { ss(S,527+step,1); }
          nsteps=step+1; step=99;
        }
      }
    }
  }
  if(learn==1){
    let s2:i32=0;
    while(s2<nsteps){
      let o2:i32=sg(S,503+s2);
      let c2:i32=sg(S,515+s2);
      let out2:i32=sg(S,527+s2);
      let val:i32=0;
      if(out2==1){ val=-1000; }
      else {
        if(out2==2){ val=1000; }
        else { if(out2==3 && solved==1){ val=1000; } }
      }
      ss(S,o2*32+c2,sg(S,o2*32+c2)+val);
      ss(S,160+o2*32+c2,sg(S,160+o2*32+c2)+1);
      if(s2>0){
        if(sg(S,539+s2-1)==1){
          let p2:i32=sg(S,503+s2-1);
          ss(S,320+p2*5+o2,sg(S,320+p2*5+o2)+val);
          ss(S,345+p2*5+o2,sg(S,345+p2*5+o2)+1);
        }
      }
      let lh:i32=sg(S,420);
      let slot:i32=lh-((lh/24)*24);
      ss(S,372+slot*2,o2);
      ss(S,372+slot*2+1,val);
      ss(S,420,lh+1);
      s2=s2+1;
    }
  }
  return solved;
}
// ============ phase ============
fn run_phase(S:[]u8,B:[]u8,w:i32,sev:i32,learn:i32,eps_mode:i32,n:i32,arm:i32,ph:i32)void {
  let ep:i32=0;
  while(ep<n){
    let eps_on:i32=0;
    if(eps_mode==1){
      if(ep<150){ eps_on=1; }
    }
    let r:i32=run_episode(S,B,w,sev,learn,eps_on);
    ss(S,479+arm*3+ph,sg(S,479+arm*3+ph)+r);
    ss(S,491+arm*3+ph,sg(S,491+arm*3+ph)+1);
    if(ph==0){
      if(ep>=150){
        ss(S,556+arm,sg(S,556+arm)+r);
        ss(S,560+arm,sg(S,560+arm)+1);
      }
    }
    ep=ep+1;
  }
  return;
}
// ============ white-box snapshot line ============
fn wb_line(S:[]u8,OUT:[]u8,cur:i32,tag:[]u8,seed:i32,arm:i32,extra:i32,extra_val:i32)i32 {
  cur=e1str(OUT,cur,tag);
  cur=e1str(OUT,cur," seed=");
  cur=e1i64(OUT,cur,seed as i64);
  cur=e1str(OUT,cur," arm=");
  cur=e1i64(OUT,cur,arm as i64);
  cur=e1str(OUT,cur," g1=");
  cur=e1i64(OUT,cur,amean(S,0,1) as i64);
  cur=e1str(OUT,cur," c1=");
  cur=e1i64(OUT,cur,amean(S,2,1) as i64);
  cur=e1str(OUT,cur," f2=");
  cur=e1i64(OUT,cur,amean(S,1,2) as i64);
  cur=e1str(OUT,cur," comp12=");
  cur=e1i64(OUT,cur,cmean(S,1,2) as i64);
  if(extra==1){
    cur=e1str(OUT,cur," late1=");
    cur=e1i64(OUT,cur,extra_val as i64);
  }
  if(extra==2){
    cur=e1str(OUT,cur," ret=");
    cur=e1i64(OUT,cur,extra_val as i64);
  }
  cur=e1str(OUT,cur,"\n");
  return cur;
}
// ============ main ============
fn main()i32 {
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  let R:[]u8=z_alloc(256);
  cur=e1str(OUT,cur,"CATFORGET-BEGIN\n");
  let si:i32=0;
  while(si<3){
    let seed:i32=111;
    if(si==1){ seed=222; }
    if(si==2){ seed=333; }
    let arm:i32=0;
    while(arm<4){
      let S:[]u8=z_alloc(4096);
      let B:[]u8=z_alloc(120);
      build_bodies(B);
      ss(S,551,8); ss(S,552,8); ss(S,553,16); ss(S,554,8); ss(S,555,8);
      ss(S,370,seed);
      ss(S,371,seed*7+13);
      let sev:i32=0;
      if(arm==1){ sev=1; }
      if(arm==3){ sev=1; }
      let bw:i32=1;
      if(arm>=2){ bw=2; }
      run_phase(S,B,0,sev,1,1,200,arm,0);
      let late1:i32=sg(S,556+arm)*100/sg(S,560+arm);
      cur=wb_line(S,OUT,cur,"P1",seed,arm,1,late1);
      run_phase(S,B,bw,sev,1,1,300,arm,1);
      cur=wb_line(S,OUT,cur,"P2",seed,arm,0,0);
      run_phase(S,B,0,sev,0,0,100,arm,2);
      let ret:i32=sg(S,479+arm*3+2)*100/sg(S,491+arm*3+2);
      cur=wb_line(S,OUT,cur,"P3",seed,arm,2,ret);
      ss(R,(si*4+arm)*3+0,late1);
      ss(R,(si*4+arm)*3+1,ret);
      ss(R,(si*4+arm)*3+2,cmean(S,1,2));
      arm=arm+1;
    }
    si=si+1;
  }
  cur=e1str(OUT,cur,"RETENTION-TABLE\n");
  si=0;
  while(si<3){
    let seed2:i32=111;
    if(si==1){ seed2=222; }
    if(si==2){ seed2=333; }
    cur=e1str(OUT,cur,"SEED ");
    cur=e1i64(OUT,cur,seed2 as i64);
    cur=e1str(OUT,cur," FULL-SIM=");
    cur=e1i64(OUT,cur,sg(R,(si*4+0)*3+1) as i64);
    cur=e1str(OUT,cur," SEV-SIM=");
    cur=e1i64(OUT,cur,sg(R,(si*4+1)*3+1) as i64);
    cur=e1str(OUT,cur," FULL-DIFF=");
    cur=e1i64(OUT,cur,sg(R,(si*4+2)*3+1) as i64);
    cur=e1str(OUT,cur," SEV-DIFF=");
    cur=e1i64(OUT,cur,sg(R,(si*4+3)*3+1) as i64);
    cur=e1str(OUT,cur,"\n");
    si=si+1;
  }
  let r1:i32=1;
  let r2:i32=1;
  let r3:i32=1;
  let r4:i32=1;
  let r5:i32=1;
  si=0;
  while(si<3){
    let a:i32=0;
    while(a<4){
      if(sg(R,(si*4+a)*3+0)<90){ r1=0; }
      a=a+1;
    }
    if(sg(R,(si*4+0)*3+2)<900){ r1=0; }
    if(sg(R,(si*4+2)*3+2)<900){ r1=0; }
    let rf0:i32=sg(R,(si*4+0)*3+1);
    let rf1:i32=sg(R,(si*4+1)*3+1);
    let rf2:i32=sg(R,(si*4+2)*3+1);
    let rf3:i32=sg(R,(si*4+3)*3+1);
    if(rf0<90){ r2=0; }
    if(rf1>30){ r3=0; }
    if(rf0-rf1<50){ r4=0; }
    if(rf2<90){ r5=0; }
    if(rf3<90){ r5=0; }
    if(rf3-rf1<50){ r5=0; }
    si=si+1;
  }
  cur=e1str(OUT,cur,"BARS R1=");
  cur=e1i64(OUT,cur,r1 as i64);
  cur=e1str(OUT,cur," R2=");
  cur=e1i64(OUT,cur,r2 as i64);
  cur=e1str(OUT,cur," R3=");
  cur=e1i64(OUT,cur,r3 as i64);
  cur=e1str(OUT,cur," R4=");
  cur=e1i64(OUT,cur,r4 as i64);
  cur=e1str(OUT,cur," R5=");
  cur=e1i64(OUT,cur,r5 as i64);
  cur=e1str(OUT,cur,"\n");
  if(r1==1){
    if(r2==1){
      if(r3==1){
        if(r4==1){
          if(r5==1){
            cur=e1str(OUT,cur,"VERDICT CATFORGET-COMPLETE\n");
          } else { cur=e1str(OUT,cur,"VERDICT CATFORGET-INCOMPLETE\n"); }
        } else { cur=e1str(OUT,cur,"VERDICT CATFORGET-INCOMPLETE\n"); }
      } else { cur=e1str(OUT,cur,"VERDICT CATFORGET-INCOMPLETE\n"); }
    } else { cur=e1str(OUT,cur,"VERDICT CATFORGET-INCOMPLETE\n"); }
  } else { cur=e1str(OUT,cur,"VERDICT CATFORGET-INCOMPLETE\n"); }
  cur=e1str(OUT,cur,"CATFORGET-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

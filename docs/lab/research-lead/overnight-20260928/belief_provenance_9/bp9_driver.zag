// bp9_driver.zag -- BP-9 battery driver.
//
// Arms: FORGE (adversarial edge forgery vs the evidence
// record), CHAIN (record completeness and
// tamper-evidence). Kill bars from the frozen PREREG.md.
// Verdict BP-9-PASS/FAIL. Pure Zag.
// bp9_learner.zag is BP-8's belief layer reused
// verbatim. Zero new learner machinery this lane:
// bp9_absorb (the BP-8 absorb renamed, identical body),
// bp9_ck, bp9_bar, bp9_selfcnt, bp9_allsup, bp9_liclive
// are driver-side test-harness code, NOT belief-layer
// changes. The forgery actions (link_edge writes of
// type-7/type-3/kind-3 edges, direct bt[] writes) are
// adversary actions in the driver, NOT belief-layer
// changes. R2/R3/R5/R6/R7, eff(), bp2_retire,
// bp2_relicense stay frozen.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp9_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp9_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp9_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp9_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption: identical body to
// bp8_absorb. Count NEW type-7/type-3 self-edges on
// fact fid since watermarks (p7,p3); each new type-7
// applies R2, each new type-3 applies R3, to belief
// mid. out[0]=new7, out[4]=new3.
fn bp9_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp9_selfcnt(W,fid,7)-p7;
  let n3:i32=bp9_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// 1 if all n beliefs in z have b_sup==val.
fn bp9_allsup(bt:[]u8,z:[]u8,n:i32,val:i32)i32 {
  let i:i32=0;
  while(i<n){
    if((bt[get32(z,i*4)*8] as i32)!=val){return 0;}
    i=i+1;
  }
  return 1;
}

// Live type-1 licensing count of mid (thin wrapper
// over the frozen bp2_lic_live).
fn bp9_liclive(W:[]u8,mid:i32)i32 {
  let out:[]u8=z_alloc(12);
  bp2_lic_live(W,mid,out);
  return get32(out,0);
}

fn main()i32 {
  emit("BP9-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= FORGE: adversarial edge forgery =================
  emit("FORGE-BEGIN\n");
  let WF:[]u8=z_alloc(110656);
  tnn2_init(WF);
  let fA:i32=ev_teach(WF,701,71,10); ns(WF,fA,16,2);
  let pfA:[]u8=z_alloc(4); set32(pfA,0,fA);
  let mA:i32=promote_graph(WF,-1,701,71,10,pfA,1);
  let fB:i32=ev_teach(WF,702,72,20); ns(WF,fB,16,2);
  let pfB:[]u8=z_alloc(4); set32(pfB,0,fB);
  let mB:i32=promote_graph(WF,-1,702,72,20,pfB,1);
  let fC:i32=ev_teach(WF,703,73,30); ns(WF,fC,16,2);
  let pfC:[]u8=z_alloc(4); set32(pfC,0,fC);
  let mC:i32=promote_graph(WF,-1,703,73,30,pfC,1);
  let fD:i32=ev_teach(WF,704,74,40); ns(WF,fD,16,2);
  let pfD:[]u8=z_alloc(4); set32(pfD,0,fD);
  let mD:i32=promote_graph(WF,-1,704,74,40,pfD,1);
  let fS:i32=ev_teach(WF,705,75,50); ns(WF,fS,16,2);
  let pfS:[]u8=z_alloc(4); set32(pfS,0,fS);
  let mP:i32=promote_graph(WF,-1,705,75,50,pfS,1);
  let mQ:i32=promote_graph(WF,-1,705,75,50,pfS,1);
  let btF:[]u8=z_alloc(8192); let hbF:[]u8=z_alloc(1024);
  bp2_form(WF,btF,hbF,mA,0);
  bp2_form(WF,btF,hbF,mB,0);
  bp2_form(WF,btF,hbF,mC,0);
  bp2_form(WF,btF,hbF,mD,0);
  bp2_form(WF,btF,hbF,mP,0);
  bp2_form(WF,btF,hbF,mQ,0);
  emit("FORGE mA "); e64(mA); emit(" mB "); e64(mB);
  emit(" mC "); e64(mC); emit(" mD "); e64(mD);
  emit(" mP "); e64(mP); emit(" mQ "); e64(mQ); emit("\n");
  bp9_bar(t,"PC-FORGE-FORM",
    (btF[mA*8] as i32)==100 && (btF[mA*8+1] as i32)==1 &&
    (btF[mB*8] as i32)==100 && (btF[mB*8+1] as i32)==1 &&
    (btF[mC*8] as i32)==100 && (btF[mC*8+1] as i32)==1 &&
    (btF[mD*8] as i32)==100 && (btF[mD*8+1] as i32)==1 &&
    (btF[mP*8] as i32)==100 && (btF[mP*8+1] as i32)==1 &&
    (btF[mQ*8] as i32)==100 && (btF[mQ*8+1] as i32)==1 &&
    (btF[mA*8+4] as i32)==1 && (btF[mB*8+4] as i32)==1 &&
    (btF[mC*8+4] as i32)==1 && (btF[mD*8+4] as i32)==1 &&
    (btF[mP*8+4] as i32)==1 && (btF[mQ*8+4] as i32)==1 &&
    (btF[mA*8+7] as i32)==1 && (btF[mQ*8+7] as i32)==1);
  // F1: forged type-7 on mA's fact (bypasses ev_observe)
  let w1:i32=link_edge(WF,fA,7,fA,0);
  let ab1:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mA,fA,0,0,ab1);
  emit("FORGE-F1 n7 "); e64(get32(ab1,0));
  emit(" sup "); e64(btF[mA*8] as i32);
  emit(" conf "); e64(btF[mA*8+1] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-MATCH",get32(ab1,0)==1 &&
    (btF[mA*8] as i32)==110 && (btF[mA*8+1] as i32)==2);
  // F2: forged type-3 on mB's fact
  let w2:i32=link_edge(WF,fB,3,fB,0);
  let ab2:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mB,fB,0,0,ab2);
  emit("FORGE-F2 n3 "); e64(get32(ab2,4));
  emit(" sup "); e64(btF[mB*8] as i32);
  emit(" disc "); e64(btF[mB*8+2] as i32);
  emit(" conf "); e64(btF[mB*8+1] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-DISC",get32(ab2,4)==1 &&
    (btF[mB*8] as i32)==80 && (btF[mB*8+2] as i32)==1 &&
    (btF[mB*8+1] as i32)==0);
  // F3: genuine contradict, then FORGED type-7 on the contradicted fact
  let rc:i32=ev_observe(WF,703,73,999);
  let ab3a:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mC,fC,0,0,ab3a);
  let w3:i32=link_edge(WF,fC,7,fC,0);
  let ab3b:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mC,fC,0,1,ab3b);
  emit("FORGE-F3 rc "); e64(rc);
  emit(" n7 "); e64(get32(ab3b,0));
  emit(" sup "); e64(btF[mC*8] as i32);
  emit(" conf "); e64(btF[mC*8+1] as i32);
  emit(" disc "); e64(btF[mC*8+2] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-ORD",get32(ab3b,0)==1 &&
    (btF[mC*8] as i32)==90 && (btF[mC*8+1] as i32)==1 &&
    (btF[mC*8+2] as i32)==0);
  // F4: three forged type-7s on mD's fact (multiplicity forgery)
  let w4a:i32=link_edge(WF,fD,7,fD,0);
  let w4b:i32=link_edge(WF,fD,7,fD,0);
  let w4c:i32=link_edge(WF,fD,7,fD,0);
  let ab4:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mD,fD,0,0,ab4);
  emit("FORGE-F4 n7 "); e64(get32(ab4,0));
  emit(" sup "); e64(btF[mD*8] as i32);
  emit(" conf "); e64(btF[mD*8+1] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-SAT",get32(ab4,0)==3 &&
    (btF[mD*8] as i32)==110 && (btF[mD*8+1] as i32)==2);
  // F5: replay the same absorb with stale watermarks
  let ab5:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mD,fD,0,0,ab5);
  emit("FORGE-F5 n7 "); e64(get32(ab5,0));
  emit(" sup "); e64(btF[mD*8] as i32);
  emit(" conf "); e64(btF[mD*8+1] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-REPLAY",
    (btF[mD*8] as i32)==120 && (btF[mD*8+1] as i32)==3);
  // F6: genuine match on the shared fact, absorbed by both beliefs
  let rs:i32=ev_observe(WF,705,75,50);
  let ab6p:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mP,fS,0,0,ab6p);
  let ab6q:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mQ,fS,0,0,ab6q);
  emit("FORGE-F6 rs "); e64(rs);
  emit(" supP "); e64(btF[mP*8] as i32);
  emit(" supQ "); e64(btF[mQ*8] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-SHARED",
    (btF[mP*8] as i32)==110 && (btF[mQ*8] as i32)==110);
  // F7: ONE forged type-7 on the shared fact, absorbed by both
  let w7:i32=link_edge(WF,fS,7,fS,0);
  let ab7p:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mP,fS,1,0,ab7p);
  let ab7q:[]u8=z_alloc(8);
  bp9_absorb(WF,btF,mQ,fS,1,0,ab7q);
  emit("FORGE-F7 n7p "); e64(get32(ab7p,0));
  emit(" n7q "); e64(get32(ab7q,0));
  emit(" supP "); e64(btF[mP*8] as i32);
  emit(" supQ "); e64(btF[mQ*8] as i32); emit("\n");
  bp9_bar(t,"K-FORGE-BLAST",
    (btF[mP*8] as i32)==120 && (btF[mQ*8] as i32)==120);
  emit("FORGE-END\n");

  // ================= CHAIN: record completeness =================
  emit("CHAIN-BEGIN\n");
  let WC:[]u8=z_alloc(110656);
  tnn2_init(WC);
  let btC:[]u8=z_alloc(8192); let hbC:[]u8=z_alloc(1024);
  let z1:i32=alloc_node(WC);
  let z2:i32=alloc_node(WC);
  bp2_form(WC,btC,hbC,z1,1);
  bp2_form(WC,btC,hbC,z2,1);
  let wl:i32=link_edge(WC,z1,14,z2,0);
  let fE:i32=ev_teach(WC,706,76,60); ns(WC,fE,16,2);
  let pfE:[]u8=z_alloc(4); set32(pfE,0,fE);
  let mE:i32=promote_graph(WC,-1,706,76,60,pfE,1);
  bp2_form(WC,btC,hbC,mE,0);
  emit("CHAIN z1 "); e64(z1); emit(" z2 "); e64(z2);
  emit(" mE "); e64(mE); emit("\n");
  bp9_bar(t,"PC-CHAIN-FORM",
    (btC[z1*8] as i32)==100 && (btC[z2*8] as i32)==100 &&
    (btC[mE*8] as i32)==100 && (btC[mE*8+4] as i32)==1 &&
    (btC[mE*8+7] as i32)==1);
  // C1: weaken z2, propagate to z1 (no trace on z1's record)
  bp2_disconfirm(btC,z2);
  bp2_disconfirm(btC,z2);
  bp2_disconfirm(btC,z2);
  let rp1:i32=bp2_propagate(WC,btC,hbC,z1);
  emit("CHAIN-C1 ret "); e64(rp1);
  emit(" z1sup "); e64(btC[z1*8] as i32);
  emit(" disc "); e64(btC[z1*8+2] as i32);
  emit(" conf "); e64(btC[z1*8+1] as i32); emit("\n");
  bp9_bar(t,"K-CHAIN-WEAK",(btC[z1*8] as i32)==40 &&
    (btC[z1*8+2] as i32)==0 && (btC[z1*8+1] as i32)==1 &&
    (btC[z1*8+3] as i32)==0 && bp2_has_k3(WC,z1)==0);
  // C2: raise z2, propagate the snap-up to z1
  bp2_confirm(btC,z2,1);
  bp2_confirm(btC,z2,1);
  let rp2:i32=bp2_propagate(WC,btC,hbC,z1);
  emit("CHAIN-C2 ret "); e64(rp2);
  emit(" z1sup "); e64(btC[z1*8] as i32);
  emit(" conf "); e64(btC[z1*8+1] as i32);
  emit(" disc "); e64(btC[z1*8+2] as i32); emit("\n");
  bp9_bar(t,"K-CHAIN-RAISE",(btC[z1*8] as i32)==80 &&
    (btC[z1*8+1] as i32)==1 && (btC[z1*8+2] as i32)==0);
  // C3: forged reason-9 edge, then genuine reason-2 retire
  let wf:i32=link_edge(WC,z2,3,z2,9);
  bp9_bar(t,"K-CHAIN-FORGEREASON",bp2_has_k3r(WC,z2,9)==1);
  bp2_retire(WC,btC,z2,2);
  emit("CHAIN-C3 z2sup "); e64(btC[z2*8] as i32);
  emit(" k3r2 "); e64(bp2_has_k3r(WC,z2,2));
  emit(" k3r9 "); e64(bp2_has_k3r(WC,z2,9)); emit("\n");
  bp9_bar(t,"K-CHAIN-DOUBLEK3",bp2_has_k3r(WC,z2,2)==1 &&
    bp2_has_k3r(WC,z2,9)==1 && (btC[z2*8] as i32)==0);
  // C4: retire z1, then tamper its table support back to 100
  bp2_retire(WC,btC,z1,2);
  btC[z1*8]=100 as u8;
  let ef1:i32=bp2_eff(btC,z1);
  let csel:[]u8=z_alloc(4); set32(csel,0,z1);
  let sel1:i32=bp2_select(btC,hbC,csel,1,50);
  emit("CHAIN-C4 eff "); e64(ef1); emit(" sel "); e64(sel1);
  emit(" k3r2 "); e64(bp2_has_k3r(WC,z1,2)); emit("\n");
  bp9_bar(t,"K-CHAIN-TAMPER",ef1==100);
  bp9_bar(t,"K-CHAIN-RESURRECT",sel1==z1 && bp2_has_k3r(WC,z1,2)==1);
  // C5: kill mE's fact, check stale licensing counts, then relicense
  let kf:i32=bp2_kill_one_prov(WC,mE);
  let lv:i32=bp9_liclive(WC,mE);
  emit("CHAIN-C5 killed "); e64(kf);
  emit(" bext "); e64(btC[mE*8+4] as i32);
  emit(" live "); e64(lv); emit("\n");
  bp9_bar(t,"K-CHAIN-STALE",(btC[mE*8+4] as i32)==1 && lv==0);
  bp2_relicense(WC,btC,mE);
  bp9_bar(t,"K-CHAIN-R4",(btC[mE*8] as i32)==0 &&
    bp2_has_k3r(WC,mE,2)==1);
  emit("CHAIN-END\n");

  emit("BP9-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP9-END\n");
  return 0;
}

// bp8_driver.zag -- BP-8 battery driver.
//
// Arms: MCH (multi-channel absorption), CY12 (12-cycle,
// homogeneous type-14), HET (6-cycle, heterogeneous
// edges: one type-1, one type-3, rest type-14). Kill
// bars from the frozen PREREG.md. Verdict BP-8-PASS/
// FAIL. Pure Zag.
// bp8_learner.zag is BP-7's belief layer reused
// verbatim. Zero new learner machinery this lane:
// bp8_absorb (the BP-7 absorb renamed, identical body)
// and bp8_allsup are driver-side test-harness code,
// NOT belief-layer changes; R2/R3/R6/R7 stay frozen.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp8_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp8_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp8_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp8_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption (BP-5/BP-6/BP-7
// convention, indep=0): count NEW type-7/type-3
// self-edges on fact fid since watermarks (p7,p3);
// each new type-7 applies R2, each new type-3
// applies R3, to belief mid. out[0]=new7,
// out[4]=new3. Identical body to bp7_absorb.
fn bp8_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp8_selfcnt(W,fid,7)-p7;
  let n3:i32=bp8_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// 1 if all n beliefs in z have b_sup==val.
fn bp8_allsup(bt:[]u8,z:[]u8,n:i32,val:i32)i32 {
  let i:i32=0;
  while(i<n){
    if((bt[get32(z,i*4)*8] as i32)!=val){return 0;}
    i=i+1;
  }
  return 1;
}

fn main()i32 {
  emit("BP8-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= MCH: multi-channel absorption =================
  emit("MCH-BEGIN\n");
  let W8:[]u8=z_alloc(110656);
  tnn2_init(W8);
  let fS:i32=ev_teach(W8,601,61,10); ns(W8,fS,16,2);
  let pfS:[]u8=z_alloc(4); set32(pfS,0,fS);
  let mS:i32=promote_graph(W8,-1,601,61,10,pfS,1);
  let fR:i32=ev_teach(W8,602,62,20); ns(W8,fR,16,6);
  let pfR:[]u8=z_alloc(4); set32(pfR,0,fR);
  let mR:i32=promote_graph(W8,-1,602,62,20,pfR,1);
  let fM1:i32=ev_teach(W8,603,63,30); ns(W8,fM1,16,2);
  let fM2:i32=ev_teach(W8,604,64,40); ns(W8,fM2,16,4);
  let pfM:[]u8=z_alloc(8); set32(pfM,0,fM1); set32(pfM,4,fM2);
  let mM:i32=promote_graph(W8,-1,603,63,30,pfM,2);
  let bt8:[]u8=z_alloc(8192); let hb8:[]u8=z_alloc(1024);
  bp2_form(W8,bt8,hb8,mS,0);
  bp2_form(W8,bt8,hb8,mR,0);
  bp2_form(W8,bt8,hb8,mM,0);
  emit("MCH mS "); e64(mS); emit(" mR "); e64(mR);
  emit(" mM "); e64(mM); emit("\n");
  bp8_bar(t,"PC-MCH-FORM",
    (bt8[mS*8] as i32)==100 && (bt8[mS*8+4] as i32)==1 && (bt8[mS*8+5] as i32)==0 &&
    (bt8[mR*8] as i32)==100 && (bt8[mR*8+4] as i32)==0 && (bt8[mR*8+5] as i32)==1 &&
    (bt8[mM*8] as i32)==100 && (bt8[mM*8+4] as i32)==1 && (bt8[mM*8+5] as i32)==1);
  // Event S: same fact, match then contradict
  let s7:i32=bp8_selfcnt(W8,fS,7); let s3:i32=bp8_selfcnt(W8,fS,3);
  let ra:i32=ev_observe(W8,601,61,10);
  let rb:i32=ev_observe(W8,601,61,999);
  let abS:[]u8=z_alloc(8);
  bp8_absorb(W8,bt8,mS,fS,s7,s3,abS);
  emit("MCH-S ra "); e64(ra); emit(" rb "); e64(rb);
  emit(" n7 "); e64(get32(abS,0)); emit(" n3 "); e64(get32(abS,4));
  emit(" sup "); e64(bt8[mS*8] as i32);
  emit(" conf "); e64(bt8[mS*8+1] as i32);
  emit(" disc "); e64(bt8[mS*8+2] as i32); emit("\n");
  bp8_bar(t,"K-MCH-RETS",ra==1 && rb==0);
  bp8_bar(t,"K-MCH-SAME",get32(abS,0)==1 && get32(abS,4)==1 &&
    (bt8[mS*8] as i32)==90 && (bt8[mS*8+1] as i32)==0 && (bt8[mS*8+2] as i32)==1);
  // Event R: order reversed, contradict then match
  let r7:i32=bp8_selfcnt(W8,fR,7); let r3:i32=bp8_selfcnt(W8,fR,3);
  let rc:i32=ev_observe(W8,602,62,999);
  let rd:i32=ev_observe(W8,602,62,20);
  let abR:[]u8=z_alloc(8);
  bp8_absorb(W8,bt8,mR,fR,r7,r3,abR);
  emit("MCH-R rc "); e64(rc); emit(" rd "); e64(rd);
  emit(" n7 "); e64(get32(abR,0)); emit(" n3 "); e64(get32(abR,4));
  emit(" sup "); e64(bt8[mR*8] as i32);
  emit(" disc "); e64(bt8[mR*8+2] as i32); emit("\n");
  bp8_bar(t,"K-MCH-ORD",get32(abR,0)==0 && get32(abR,4)==1 &&
    (bt8[mR*8] as i32)==80 && (bt8[mR*8+2] as i32)==1 && (bt8[mR*8+1] as i32)==0);
  // Event M: multi-fact, two type-7s on fM1, one type-3 on fM2
  let m17:i32=bp8_selfcnt(W8,fM1,7); let m13:i32=bp8_selfcnt(W8,fM1,3);
  let m27:i32=bp8_selfcnt(W8,fM2,7); let m23:i32=bp8_selfcnt(W8,fM2,3);
  let rm1:i32=ev_observe(W8,603,63,30);
  let rm2:i32=ev_observe(W8,603,63,30);
  let rm3:i32=ev_observe(W8,604,64,999);
  let abM1:[]u8=z_alloc(8);
  bp8_absorb(W8,bt8,mM,fM1,m17,m13,abM1);
  emit("MCH-M rm "); e64(rm1); emit("/"); e64(rm2); emit("/"); e64(rm3);
  emit(" n7 "); e64(get32(abM1,0));
  emit(" sup "); e64(bt8[mM*8] as i32);
  emit(" conf "); e64(bt8[mM*8+1] as i32); emit("\n");
  bp8_bar(t,"K-MCH-SAT",get32(abM1,0)==2 && (bt8[mM*8+1] as i32)==2 && (bt8[mM*8] as i32)==110);
  let abM2:[]u8=z_alloc(8);
  bp8_absorb(W8,bt8,mM,fM2,m27,m23,abM2);
  emit("MCH-M2 n3 "); e64(get32(abM2,4));
  emit(" sup "); e64(bt8[mM*8] as i32);
  emit(" conf "); e64(bt8[mM*8+1] as i32);
  emit(" disc "); e64(bt8[mM*8+2] as i32); emit("\n");
  bp8_bar(t,"K-MCH-MULTI",get32(abM2,4)==1 &&
    (bt8[mM*8] as i32)==90 && (bt8[mM*8+1] as i32)==0 && (bt8[mM*8+2] as i32)==1);
  bp8_bar(t,"K-MCH-BLIND",
    (bt8[mS*8] as i32)==(bt8[mM*8] as i32) &&
    (bt8[mS*8+1] as i32)==(bt8[mM*8+1] as i32) &&
    (bt8[mS*8+2] as i32)==(bt8[mM*8+2] as i32));
  emit("MCH-END\n");

  // ================= CY12: 12-cycle homogeneous =================
  emit("CY12-BEGIN\n");
  let WC:[]u8=z_alloc(110656);
  tnn2_init(WC);
  let btC:[]u8=z_alloc(8192); let hbC:[]u8=z_alloc(1024);
  let z:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<12){
    let zn:i32=alloc_node(WC);
    set32(z,i*4,zn);
    bp2_form(WC,btC,hbC,zn,1);
    i=i+1;
  }
  i=0;
  while(i<12){
    link_edge(WC,get32(z,i*4),14,get32(z,((i+1)%12)*4),0);
    i=i+1;
  }
  emit("CY12 z0 "); e64(get32(z,0));
  emit(" z6 "); e64(get32(z,24)); emit("\n");
  bp8_bar(t,"PC-CY12-FORM",bp8_allsup(btC,z,12,100)==1);
  let z4:i32=get32(z,16); let z5:i32=get32(z,20);
  let z6:i32=get32(z,24); let z11:i32=get32(z,44);
  bp2_disconfirm(btC,z6);
  bp2_disconfirm(btC,z6);
  bp2_disconfirm(btC,z6);
  bp8_bar(t,"K-CY12-WEAK",(btC[z6*8] as i32)==40);
  let rh1:i32=bp2_propagate(WC,btC,hbC,z5);
  emit("CY12-1HOP z5 "); e64(btC[z5*8] as i32);
  emit(" ret "); e64(rh1); emit("\n");
  bp8_bar(t,"K-CY12-1HOP",(btC[z5*8] as i32)==40 && (btC[z4*8] as i32)==100 && (btC[z11*8] as i32)==100);
  let j:i32=5;
  while(j>=0){
    let d1:i32=bp2_propagate(WC,btC,hbC,get32(z,j*4));
    j=j-1;
  }
  j=11;
  while(j>=7){
    let d2:i32=bp2_propagate(WC,btC,hbC,get32(z,j*4));
    j=j-1;
  }
  emit("CY12-FULL z0 "); e64(btC[get32(z,0)*8] as i32);
  emit(" z6 "); e64(btC[z6*8] as i32);
  emit(" z11 "); e64(btC[z11*8] as i32); emit("\n");
  bp8_bar(t,"K-CY12-FULL",bp8_allsup(btC,z,12,40)==1);
  i=0;
  while(i<12){
    let d3:i32=bp2_propagate(WC,btC,hbC,get32(z,i*4));
    i=i+1;
  }
  bp8_bar(t,"K-CY12-FIX",bp8_allsup(btC,z,12,40)==1);
  bp2_confirm(btC,z6,1);
  bp2_confirm(btC,z6,1);
  emit("CY12-RAISED z6 "); e64(btC[z6*8] as i32); emit("\n");
  let rh2:i32=bp2_propagate(WC,btC,hbC,z5);
  emit("CY12-R1HOP z5 "); e64(btC[z5*8] as i32);
  emit(" z4 "); e64(btC[z4*8] as i32); emit("\n");
  bp8_bar(t,"K-CY12-RAISE",(btC[z6*8] as i32)==80 && (btC[z5*8] as i32)==80 && (btC[z4*8] as i32)==40);
  j=5;
  while(j>=0){
    let d4:i32=bp2_propagate(WC,btC,hbC,get32(z,j*4));
    j=j-1;
  }
  j=11;
  while(j>=6){
    let d5:i32=bp2_propagate(WC,btC,hbC,get32(z,j*4));
    j=j-1;
  }
  emit("CY12-RAISEFULL z0 "); e64(btC[get32(z,0)*8] as i32);
  emit(" z6 "); e64(btC[z6*8] as i32); emit("\n");
  bp8_bar(t,"K-CY12-RAISEFULL",bp8_allsup(btC,z,12,80)==1);
  emit("CY12-END\n");

  // ================= HET: 6-cycle heterogeneous =================
  emit("HET-BEGIN\n");
  let WH:[]u8=z_alloc(110656);
  tnn2_init(WH);
  let btH:[]u8=z_alloc(8192); let hbH:[]u8=z_alloc(1024);
  let v:[]u8=z_alloc(24);
  let k2:i32=0;
  while(k2<6){
    let vn:i32=alloc_node(WH);
    set32(v,k2*4,vn);
    bp2_form(WH,btH,hbH,vn,1);
    k2=k2+1;
  }
  let v1:i32=get32(v,0); let v2:i32=get32(v,4); let v3:i32=get32(v,8);
  let v4:i32=get32(v,12); let v5:i32=get32(v,16); let v6:i32=get32(v,20);
  link_edge(WH,v1,14,v2,0);
  link_edge(WH,v2,14,v3,0);
  link_edge(WH,v3,1,v4,0);
  link_edge(WH,v4,14,v5,0);
  link_edge(WH,v5,3,v6,0);
  link_edge(WH,v6,14,v1,0);
  emit("HET v1 "); e64(v1); emit(" v4 "); e64(v4);
  emit(" v6 "); e64(v6); emit("\n");
  bp8_bar(t,"PC-HET-FORM",bp8_allsup(btH,v,6,100)==1);
  bp2_disconfirm(btH,v4);
  bp2_disconfirm(btH,v4);
  bp2_disconfirm(btH,v4);
  bp8_bar(t,"K-HET-WEAK",(btH[v4*8] as i32)==40);
  let rblk:i32=bp2_propagate(WH,btH,hbH,v3);
  emit("HET-BLOCK ret "); e64(rblk);
  emit(" v3 "); e64(btH[v3*8] as i32);
  emit(" v4 "); e64(btH[v4*8] as i32); emit("\n");
  bp8_bar(t,"K-HET-BLOCK",rblk==255 && (btH[v3*8] as i32)==100 && (btH[v4*8] as i32)==40);
  let rera:i32=bp2_propagate(WH,btH,hbH,v4);
  emit("HET-ERASE ret "); e64(rera);
  emit(" v4 "); e64(btH[v4*8] as i32); emit("\n");
  bp8_bar(t,"K-HET-ERASE",rera==100 && (btH[v4*8] as i32)==100);
  let k3:i32=0;
  while(k3<6){
    let d6:i32=bp2_propagate(WH,btH,hbH,get32(v,k3*4));
    k3=k3+1;
  }
  emit("HET-FULL ");
  k3=0;
  while(k3<6){
    e64(btH[get32(v,k3*4)*8] as i32); emit(" ");
    k3=k3+1;
  }
  emit("\n");
  bp8_bar(t,"K-HET-FULL",bp8_allsup(btH,v,6,100)==1);
  k3=0;
  while(k3<6){
    let d7:i32=bp2_propagate(WH,btH,hbH,get32(v,k3*4));
    k3=k3+1;
  }
  bp8_bar(t,"K-HET-FIX",bp8_allsup(btH,v,6,100)==1);
  bp2_disconfirm(btH,v6);
  bp2_disconfirm(btH,v6);
  bp2_disconfirm(btH,v6);
  let w6pre:i32=btH[v6*8] as i32;
  let rt3:i32=bp2_propagate(WH,btH,hbH,v5);
  let r6b:i32=bp2_propagate(WH,btH,hbH,v6);
  emit("HET-T3 w6pre "); e64(w6pre);
  emit(" rt3 "); e64(rt3);
  emit(" v5 "); e64(btH[v5*8] as i32);
  emit(" v6 "); e64(btH[v6*8] as i32); emit("\n");
  bp8_bar(t,"K-HET-T3",w6pre==40 && rt3==255 && (btH[v5*8] as i32)==100 && (btH[v6*8] as i32)==100);
  emit("HET-END\n");

  emit("BP8-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP8-END\n");
  return 0;
}

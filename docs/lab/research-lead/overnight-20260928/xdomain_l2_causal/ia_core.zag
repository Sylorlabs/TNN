// ia_core.zag -- XDOMAIN-L2-IFACE: cross-domain L2 interface adaptation.
// Causal path model (X: NODE->PATH) to intervention selector (Y: NODE->NUM).
// The contract mismatch X.out=PATH != Y.in=NODE is detected by the
// H1-style contract-checked composer, which refuses the pair. The adapt
// bracket, triggered only by mismatch detection, selects a PATH->NODE
// projection from the learner's own inventory by the learner-owned
// intervenability rule (the downstream consumer must execute on the
// projected value), verifies the full pipeline by real execution, and
// promotes the composite with provenance edges (LINK14 type 14,
// co-use type 15, adapted-via type 16). No new edge/MAP types, opcodes,
// modes, bridges, handlers, or semantic cases. Pure Zag.
//
// Workspace layout (u8-backed, little-endian cells):
//   header: 0 nmaps, 4 zid, 8 npaths, 12 adapt_ok, 16 last_adapt_c,
//           20 nedges, 24 scratch_ok, 28 scratch_z, 32 n_mismatch
//   facts: base 64, 48 entries x 12 (used,subj,rel,obj)
//   maps: base 640, 12 entries x 48
//     (used,behav,sig_in,sig_out,in_sum,in_n,out_sum,out_n,seg_a,seg_b,seg_c)
//   paths: base 1216, 24 records x 32 (len, node[0..6]); handle=1216+idx*32
//   edges: base 1984, 64 entries x 16 (used,from,etype,to)
//   mismatch scratch: base 3008, 16 pairs x 8 (a,b)
// Behaviors: 0 X path-build, 1 FIRST, 2 LAST, 3 D_PROJ, 4 PATHLEN,
//            5 Y interv-lookup, 6 D_ID, 7 D_COUNT, 8 COMP3, 9 COMP2.
// Value kinds: 1 NODE (fact subject), 3 PATH (handle range), 2 NUM (else).

// ---------- emit prelude: single buffer, one raw write ----------
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 { return e1i64(OUT,cur,v as i64); }

// ---------- workspace ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn g32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn s32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ia_init(W:[]u8)void {
  s32(W,0,0); s32(W,4,-1); s32(W,8,0); s32(W,12,0); s32(W,16,-1);
  s32(W,20,0); s32(W,24,0); s32(W,28,-1); s32(W,32,0);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<48){
    if(g32(W,64+i*12)==0){
      s32(W,64+i*12,1); s32(W,64+i*12+4,s);
      s32(W,64+i*12+8,r); s32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn ia_facts(W:[]u8)void {
  add_fact(W,11,91,12); add_fact(W,12,91,13);
  add_fact(W,21,91,22); add_fact(W,22,91,23); add_fact(W,23,91,24);
  add_fact(W,31,91,32); add_fact(W,32,91,33);
  add_fact(W,13,92,101); add_fact(W,24,92,102);
  let i:i32=0;
  while(i<12){
    add_fact(W,5000+i*7,60+(i-((i/10)*10)),6000+i*7);
    i=i+1;
  }
  return;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(g32(W,64+i*12)==1 && g32(W,64+i*12+4)==s && g32(W,64+i*12+8)==r){
      return g32(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn count_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<48){
    if(g32(W,64+i*12)==1 && g32(W,64+i*12+4)==s && g32(W,64+i*12+8)==r){ n=n+1; }
    i=i+1;
  }
  return n;
}
// Generic kind probe: PATH iff path-handle range, NODE iff fact subject,
// else NUM. No per-MAP literals.
fn probe_kind(W:[]u8,v:i32)i32 {
  if(v>=1216){ return 3; }
  let i:i32=0;
  while(i<48){
    if(g32(W,64+i*12)==1 && g32(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
// ---------- path records ----------
fn path_new(W:[]u8)i32 {
  let idx:i32=g32(W,8);
  s32(W,8,idx+1);
  let h:i32=1216+idx*32;
  s32(W,h,0);
  return h;
}
fn path_len(W:[]u8,h:i32)i32 { return g32(W,h); }
fn path_push(W:[]u8,h:i32,v:i32)void {
  let n:i32=g32(W,h);
  if(n<7){
    s32(W,h+4+n*4,v);
    s32(W,h,n+1);
  }
  return;
}
fn path_node(W:[]u8,h:i32,i:i32)i32 { return g32(W,h+4+i*4); }
// ---------- maps ----------
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=g32(W,0);
  s32(W,0,m+1);
  let b:i32=640+m*48;
  s32(W,b,1); s32(W,b+4,behav);
  s32(W,b+8,0); s32(W,b+12,0);
  s32(W,b+16,0); s32(W,b+20,0); s32(W,b+24,0); s32(W,b+28,0);
  s32(W,b+32,-1); s32(W,b+36,-1); s32(W,b+40,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { s32(W,640+m*48,0); return; }
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let mb:i32=640+m*48;
  let bh:i32=g32(W,mb+4);
  if(bh==0){
    let h:i32=path_new(W);
    let cur:i32=v; let n:i32=0;
    path_push(W,h,cur);
    while(n<6){
      let o:i32=find_obj(W,cur,91);
      if(o==-1){ break; }
      cur=o; path_push(W,h,cur); n=n+1;
    }
    return h;
  }
  if(bh==1){ return path_node(W,v,0); }
  if(bh==2){
    let ln:i32=path_len(W,v);
    return path_node(W,v,ln-1);
  }
  if(bh==3){
    let ln3:i32=path_len(W,v);
    if(ln3>1){ return path_node(W,v,1); }
    return path_node(W,v,0);
  }
  if(bh==4){ return path_len(W,v); }
  if(bh==5){ return find_obj(W,v,92); }
  if(bh==6){ return v; }
  if(bh==7){ return count_rel(W,v,91); }
  if(bh==8){
    let sa:i32=g32(W,mb+32); let sb:i32=g32(W,mb+36); let sc:i32=g32(W,mb+40);
    let v1:i32=exec_map(W,sa,v);
    let v2:i32=exec_map(W,sb,v1);
    return exec_map(W,sc,v2);
  }
  let ta:i32=g32(W,mb+32); let tc:i32=g32(W,mb+40);
  let w1:i32=exec_map(W,ta,v);
  return exec_map(W,tc,w1);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=640+m*48;
  s32(W,b+16,g32(W,b+16)+probe_kind(W,vin));
  s32(W,b+20,g32(W,b+20)+1);
  s32(W,b+24,g32(W,b+24)+probe_kind(W,vout));
  s32(W,b+28,g32(W,b+28)+1);
  return;
}
// Learned signature: rounded mean kind over observations. Generic;
// homogeneous teaching yields the exact kind.
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=640+m*48;
  let inn:i32=g32(W,b+20); let outn:i32=g32(W,b+28);
  if(inn>=2){
    let si:i32=(g32(W,b+16)+(inn/2))/inn;
    s32(W,b+8,si);
  }
  if(outn>=2){
    let so:i32=(g32(W,b+24)+(outn/2))/outn;
    s32(W,b+12,so);
  }
  return;
}
// ---------- edges (types 14/15/16 only; pre-existing) ----------
fn edge_add(W:[]u8,from:i32,etype:i32,to:i32)void {
  let n:i32=g32(W,20);
  if(n<64){
    let e:i32=1984+n*16;
    s32(W,e,1); s32(W,e+4,from); s32(W,e+8,etype); s32(W,e+12,to);
    s32(W,20,n+1);
  }
  return;
}
fn edge_exists(W:[]u8,from:i32,etype:i32,to:i32)i32 {
  let n:i32=g32(W,20);
  let i:i32=0;
  while(i<n){
    let e:i32=1984+i*16;
    if(g32(W,e)==1 && g32(W,e+4)==from && g32(W,e+8)==etype && g32(W,e+12)==to){ return 1; }
    i=i+1;
  }
  return 0;
}
fn edge_count(W:[]u8,etype:i32)i32 {
  let n:i32=g32(W,20);
  let c:i32=0; let i:i32=0;
  while(i<n){
    if(g32(W,1984+i*16)==1 && g32(W,1984+i*16+8)==etype){ c=c+1; }
    i=i+1;
  }
  return c;
}
fn adapt_on()i32 { return 1; }
// ---------- independent teaching (Z pair never taught as a pair) ----------
fn teach_all(W:[]u8)void {
  let r:i32=0;
  let x:i32=map_new(W,0);
  r=exec_map(W,x,11); record_obs(W,x,11,r);
  r=exec_map(W,x,21); record_obs(W,x,21,r);
  r=exec_map(W,x,12); record_obs(W,x,12,r);
  finalize_sig(W,x);
  let h1:i32=exec_map(W,x,11);
  let h2:i32=exec_map(W,x,21);
  let f:i32=map_new(W,1);
  r=exec_map(W,f,h1); record_obs(W,f,h1,r);
  r=exec_map(W,f,h2); record_obs(W,f,h2,r);
  finalize_sig(W,f);
  let l:i32=map_new(W,2);
  r=exec_map(W,l,h1); record_obs(W,l,h1,r);
  r=exec_map(W,l,h2); record_obs(W,l,h2,r);
  finalize_sig(W,l);
  let d:i32=map_new(W,3);
  r=exec_map(W,d,h1); record_obs(W,d,h1,r);
  r=exec_map(W,d,h2); record_obs(W,d,h2,r);
  finalize_sig(W,d);
  let p:i32=map_new(W,4);
  r=exec_map(W,p,h1); record_obs(W,p,h1,r);
  r=exec_map(W,p,h2); record_obs(W,p,h2,r);
  finalize_sig(W,p);
  let y:i32=map_new(W,5);
  r=exec_map(W,y,13); record_obs(W,y,13,r);
  r=exec_map(W,y,24); record_obs(W,y,24,r);
  finalize_sig(W,y);
  let di:i32=map_new(W,6);
  r=exec_map(W,di,11); record_obs(W,di,11,r);
  r=exec_map(W,di,21); record_obs(W,di,21,r);
  finalize_sig(W,di);
  let dc:i32=map_new(W,7);
  r=exec_map(W,dc,11); record_obs(W,dc,11,r);
  r=exec_map(W,dc,21); record_obs(W,dc,21,r);
  finalize_sig(W,dc);
  return;
}
// ---------- solver ----------
// scratch_ok (24): 1 on success. scratch_z (28): promoted/composite id.
fn solve_z(W:[]u8,s:i32,target:i32,OUT:[]u8,cur:i32)i32 {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  s32(W,24,0); s32(W,28,-1); s32(W,32,0);
  let nm0:i32=g32(W,0);
  let m:i32=0;
  while(m<nm0){
    let mb0:i32=640+m*48;
    let live0:i32=g32(W,mb0);
    let smatch:i32=0;
    if(live0==1){
      if(g32(W,mb0+8)==kin){
        if(g32(W,mb0+12)==kout){ smatch=1; }
      }
    }
    if(smatch==1){
      let r0:i32=exec_map(W,m,s);
      cur=e1str(OUT,cur,"TRY-SINGLE m="); cur=e1i32(OUT,cur,m);
      cur=e1str(OUT,cur," r="); cur=e1i32(OUT,cur,r0); cur=e1str(OUT,cur,"\n");
      if(r0==target){
        cur=e1str(OUT,cur,"Z-SINGLE m="); cur=e1i32(OUT,cur,m); cur=e1str(OUT,cur,"\n");
        s32(W,24,1); s32(W,28,m);
        return cur;
      }
    }
    m=m+1;
  }
  let nm:i32=g32(W,0);
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      let mba:i32=640+a*48; let ob:i32=640+b*48;
      let live2:i32=0;
      if(g32(W,mba)==1){ if(g32(W,ob)==1){ live2=1; } }
      let endok:i32=0;
      if(g32(W,mba+8)==kin){ if(g32(W,ob+12)==kout){ endok=1; } }
      let cand:i32=0;
      if(live2==1){ if(endok==1){ cand=1; } }
      if(cand==1){
        let soa:i32=g32(W,mba+12);
        let sib:i32=g32(W,ob+8);
        if(soa==sib){
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          cur=e1str(OUT,cur,"TRY-PAIR a="); cur=e1i32(OUT,cur,a);
          cur=e1str(OUT,cur," b="); cur=e1i32(OUT,cur,b);
          cur=e1str(OUT,cur," r="); cur=e1i32(OUT,cur,r); cur=e1str(OUT,cur,"\n");
          if(r==target){
            let z2:i32=map_new(W,9);
            let zb:i32=640+z2*48;
            s32(W,zb+32,a); s32(W,zb+40,b);
            s32(W,zb+8,g32(W,mba+8)); s32(W,zb+12,g32(W,ob+12));
            edge_add(W,z2,14,a); edge_add(W,z2,14,b);
            s32(W,4,z2);
            cur=e1str(OUT,cur,"Z-EXACT z="); cur=e1i32(OUT,cur,z2); cur=e1str(OUT,cur,"\n");
            s32(W,24,1); s32(W,28,z2);
            return cur;
          }
        } else {
          cur=e1str(OUT,cur,"MISMATCH a="); cur=e1i32(OUT,cur,a);
          cur=e1str(OUT,cur," out="); cur=e1i32(OUT,cur,soa);
          cur=e1str(OUT,cur," b="); cur=e1i32(OUT,cur,b);
          cur=e1str(OUT,cur," in="); cur=e1i32(OUT,cur,sib); cur=e1str(OUT,cur,"\n");
          let mmn:i32=g32(W,32);
          if(mmn<16){
            s32(W,3008+mmn*8,a); s32(W,3008+mmn*8+4,b);
            s32(W,32,mmn+1);
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(adapt_on()==1){
    let mi:i32=0;
    let mmn2:i32=g32(W,32);
    let done:i32=0;
    while(mi<mmn2){
      let go:i32=1;
      if(done==1){ go=0; }
      if(go==1){
        let aa:i32=g32(W,3008+mi*8);
        let bb:i32=g32(W,3008+mi*8+4);
        let need_in:i32=g32(W,640+aa*48+12);
        let need_out:i32=g32(W,640+bb*48+8);
        let nm3:i32=g32(W,0);
        let c:i32=0;
        while(c<nm3){
          let go2:i32=1;
          if(done==1){ go2=0; }
          if(go2==1){
            let mbc:i32=640+c*48;
            let cmatch:i32=0;
            if(g32(W,mbc)==1){
              if(g32(W,mbc+8)==need_in){
                if(g32(W,mbc+12)==need_out){ cmatch=1; }
              }
            }
            if(cmatch==1){
              let P:i32=exec_map(W,aa,s);
              let nn:i32=exec_map(W,c,P);
              let yv:i32=exec_map(W,bb,nn);
              let pl:i32=-1;
              if(P>=1216){ pl=path_len(W,P); }
              cur=e1str(OUT,cur,"ADAPT-TRY c="); cur=e1i32(OUT,cur,c);
              cur=e1str(OUT,cur," proj="); cur=e1i32(OUT,cur,nn);
              cur=e1str(OUT,cur," yexec="); cur=e1i32(OUT,cur,yv);
              cur=e1str(OUT,cur," plen="); cur=e1i32(OUT,cur,pl);
              let okc:i32=0;
              if(yv!=-1){ if(yv==target){ okc=1; } }
              if(okc==1){
                cur=e1str(OUT,cur," ADAPT-OK\n");
                let z:i32=map_new(W,8);
                let zb2:i32=640+z*48;
                s32(W,zb2+32,aa); s32(W,zb2+36,c); s32(W,zb2+40,bb);
                s32(W,zb2+8,g32(W,640+aa*48+8));
                s32(W,zb2+12,g32(W,640+bb*48+12));
                edge_add(W,z,14,aa); edge_add(W,z,14,c); edge_add(W,z,14,bb);
                edge_add(W,z,16,c);
                edge_add(W,aa,15,c); edge_add(W,c,15,bb);
                s32(W,4,z);
                s32(W,12,g32(W,12)+1);
                s32(W,16,c);
                cur=e1str(OUT,cur,"Z-ADAPT z="); cur=e1i32(OUT,cur,z);
                cur=e1str(OUT,cur," a="); cur=e1i32(OUT,cur,aa);
                cur=e1str(OUT,cur," c="); cur=e1i32(OUT,cur,c);
                cur=e1str(OUT,cur," b="); cur=e1i32(OUT,cur,bb); cur=e1str(OUT,cur,"\n");
                s32(W,24,1); s32(W,28,z);
                done=1;
              } else {
                cur=e1str(OUT,cur," REJECT\n");
              }
            }
          }
          c=c+1;
        }
      }
      mi=mi+1;
    }
  }
  if(g32(W,24)==0){
    cur=e1str(OUT,cur,"Z-FAIL\n");
  }
  return cur;
}
fn mismatch_recorded(W:[]u8,a:i32,b:i32)i32 {
  let n:i32=g32(W,32);
  let i:i32=0;
  while(i<n){
    if(g32(W,3008+i*8)==a && g32(W,3008+i*8+4)==b){ return 1; }
    i=i+1;
  }
  return 0;
}
// ---------- arms ----------
fn arm_a1(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A1 TREAT ===\n");
  ia_facts(W); teach_all(W);
  cur=solve_z(W,11,101,OUT,cur);
  let ok:i32=g32(W,24);
  let z:i32=g32(W,28);
  let c1:i32=0;
  if(ok==1){ if(g32(W,16)==2){ c1=1; } }
  let c2:i32=0;
  if(z==8){
    if(edge_exists(W,8,14,0)==1){
      if(edge_exists(W,8,14,2)==1){
        if(edge_exists(W,8,14,5)==1){ c2=1; }
      }
    }
  }
  let c3:i32=0;
  if(edge_exists(W,8,16,2)==1){
    if(edge_exists(W,0,15,2)==1){
      if(edge_exists(W,2,15,5)==1){ c3=1; }
    }
  }
  let c4:i32=0;
  if(g32(W,12)==1){ if(g32(W,0)==9){ c4=1; } }
  let c5:i32=mismatch_recorded(W,0,5);
  let pass:i32=0;
  if(c1==1){ if(c2==1){ if(c3==1){ if(c4==1){ if(c5==1){ pass=1; } } } } }
  cur=e1str(OUT,cur,"A1 checks c1(adapter=2)="); cur=e1i32(OUT,cur,c1);
  cur=e1str(OUT,cur," c2(link14)="); cur=e1i32(OUT,cur,c2);
  cur=e1str(OUT,cur," c3(t16+t15)="); cur=e1i32(OUT,cur,c3);
  cur=e1str(OUT,cur," c4(counts)="); cur=e1i32(OUT,cur,c4);
  cur=e1str(OUT,cur," c5(mismatch)="); cur=e1i32(OUT,cur,c5); cur=e1str(OUT,cur,"\n");
  if(pass==1){ cur=e1str(OUT,cur,"ARM-RESULT A1 PASS\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A1 FAIL\n"); }
  return cur;
}
fn arm_a2(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A2 REUSE ===\n");
  ia_facts(W); teach_all(W);
  cur=solve_z(W,11,101,OUT,cur);
  let ok1:i32=g32(W,24);
  let e14a:i32=edge_count(W,14); let e15a:i32=edge_count(W,15); let e16a:i32=edge_count(W,16);
  cur=solve_z(W,21,102,OUT,cur);
  let ok2:i32=g32(W,24);
  let z2:i32=g32(W,28);
  let segsame:i32=0;
  if(z2>=0){
    if(g32(W,640+z2*48+36)==2){ segsame=1; }
  }
  let e14b:i32=edge_count(W,14); let e15b:i32=edge_count(W,15); let e16b:i32=edge_count(W,16);
  let estable:i32=0;
  if(e14a==e14b){ if(e15a==e15b){ if(e16a==e16b){ estable=1; } } }
  let hq:i32=exec_map(W,0,21);
  let plen2:i32=path_len(W,hq);
  cur=e1str(OUT,cur,"A2 q2plen="); cur=e1i32(OUT,cur,plen2);
  cur=e1str(OUT,cur," adapt_ok="); cur=e1i32(OUT,cur,g32(W,12));
  cur=e1str(OUT,cur," nmaps="); cur=e1i32(OUT,cur,g32(W,0)); cur=e1str(OUT,cur,"\n");
  let pass:i32=0;
  if(ok1==1){
    if(ok2==1){
      if(segsame==1){
        if(estable==1){
          if(g32(W,12)==1){
            if(plen2==4){ if(e14b==3){ if(e15b==2){ if(e16b==1){ pass=1; } } } }
          }
        }
      }
    }
  }
  if(pass==1){ cur=e1str(OUT,cur,"ARM-RESULT A2 PASS\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A2 FAIL\n"); }
  return cur;
}
fn arm_a3(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A3 ABL-X ===\n");
  ia_facts(W); teach_all(W);
  del_map(W,0);
  cur=solve_z(W,11,101,OUT,cur);
  if(g32(W,24)==0){ cur=e1str(OUT,cur,"ARM-RESULT A3 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A3 FAIL-unexpected-solve\n"); }
  return cur;
}
fn arm_a4(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A4 ABL-Y ===\n");
  ia_facts(W); teach_all(W);
  del_map(W,5);
  cur=solve_z(W,11,101,OUT,cur);
  if(g32(W,24)==0){ cur=e1str(OUT,cur,"ARM-RESULT A4 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A4 FAIL-unexpected-solve\n"); }
  return cur;
}
fn arm_a5(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A5 ABL-ADAPTER ===\n");
  ia_facts(W); teach_all(W);
  del_map(W,2);
  cur=solve_z(W,11,101,OUT,cur);
  let pass:i32=0;
  if(g32(W,24)==0){
    if(g32(W,12)==0){ if(g32(W,4)==-1){ pass=1; } }
  }
  if(pass==1){ cur=e1str(OUT,cur,"ARM-RESULT A5 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A5 FAIL-unexpected-solve\n"); }
  return cur;
}
fn arm_a6(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A6 NO-ADAPT CONTROL ===\n");
  ia_facts(W); teach_all(W);
  cur=solve_z(W,11,101,OUT,cur);
  let pass:i32=0;
  if(g32(W,24)==0){
    if(mismatch_recorded(W,0,5)==1){
      if(edge_count(W,15)==0){
        if(edge_count(W,16)==0){ pass=1; }
      }
    }
  }
  if(pass==1){ cur=e1str(OUT,cur,"ARM-RESULT A6 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A6 FAIL-unexpected\n"); }
  return cur;
}
fn arm_a7(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A7 FRESH ===\n");
  ia_facts(W);
  cur=solve_z(W,11,101,OUT,cur);
  if(g32(W,24)==0){ cur=e1str(OUT,cur,"ARM-RESULT A7 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A7 FAIL-unexpected-solve\n"); }
  return cur;
}
fn arm_a8(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== A8 IMPOSSIBLE ===\n");
  ia_facts(W); teach_all(W);
  cur=solve_z(W,31,999,OUT,cur);
  let pass:i32=0;
  if(g32(W,24)==0){
    if(g32(W,12)==0){
      if(edge_count(W,14)==0){
        if(edge_count(W,15)==0){
          if(edge_count(W,16)==0){ pass=1; }
        }
      }
    }
  }
  if(pass==1){ cur=e1str(OUT,cur,"ARM-RESULT A8 PASS-expected-fail\n"); }
  else { cur=e1str(OUT,cur,"ARM-RESULT A8 FAIL-unexpected\n"); }
  return cur;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  cur=e1str(OUT,cur,"XDOMAIN-L2-IFACE-START\n");
  if(adapt_on()==1){
    let W1:[]u8=z_alloc(4096); ia_init(W1); cur=arm_a1(W1,OUT,cur);
    let W2:[]u8=z_alloc(4096); ia_init(W2); cur=arm_a2(W2,OUT,cur);
    let W3:[]u8=z_alloc(4096); ia_init(W3); cur=arm_a3(W3,OUT,cur);
    let W4:[]u8=z_alloc(4096); ia_init(W4); cur=arm_a4(W4,OUT,cur);
    let W5:[]u8=z_alloc(4096); ia_init(W5); cur=arm_a5(W5,OUT,cur);
    let W7:[]u8=z_alloc(4096); ia_init(W7); cur=arm_a7(W7,OUT,cur);
    let W8:[]u8=z_alloc(4096); ia_init(W8); cur=arm_a8(W8,OUT,cur);
  } else {
    let W6:[]u8=z_alloc(4096); ia_init(W6); cur=arm_a6(W6,OUT,cur);
  }
  cur=e1str(OUT,cur,"XDOMAIN-L2-IFACE-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

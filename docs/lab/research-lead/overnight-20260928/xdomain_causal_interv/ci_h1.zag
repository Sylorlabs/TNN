// ci_h1.zag -- Cross-domain generality, third pair: causal -> intervention (H1).
//
// X: causal model (walk r=91 to endpoint: predict final outcome).
//    Signature LEARNED: NODE->NODE.
// Y: intervention lookup (find_obj r=92: outcome -> action).
//    Signature LEARNED: NODE->NUM.
// D1: identity distractor. Signature LEARNED: NODE->NODE.
// D2: count r=91 distractor. Signature LEARNED: NODE->NUM.
// Sealed Z: (11,93)->101 needs X-then-Y. Composer admits pair (A,B) iff
// sig(A).out == sig(B).in, endpoints matching goal kinds.
// Signatures come ONLY from probe_kind observations during teaching
// (plus generic contract composition at promotion). Zero per-MAP
// signature literals in source. No CAUSAL_TO_INTERVENTION template.
//
// Mechanism logic (probe_kind, record_obs, finalize_sig, solve_z,
// promote_comp) is UNMODIFIED from xdomain_typed/xt.zag. Only the world
// facts, relation IDs in exec_map behaviors, and teaching queries change.
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.

// ---------- runtime prelude ----------
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn pl(v:i32)void { e64(v); emit("\n"); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

// ---------- workspace layout ----------
// header: 0 tries, 4 nmaps, 8 z_id
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 8 entries x 40 bytes
//   (used,behav,in_sum,in_n,out_sum,out_n,sig_in,sig_out,comp_a,comp_b)
fn xt_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,-1);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn xt_facts(W:[]u8)void {
  // causal chains (r=91): 11->12->13, 21->22->23
  add_fact(W,11,91,12); add_fact(W,12,91,13);
  add_fact(W,21,91,22); add_fact(W,22,91,23);
  // intervention links (r=92): outcome -> action
  add_fact(W,13,92,101);
  add_fact(W,23,92,102); add_fact(W,23,92,103);
  return;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn count_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){ n=n+1; }
    i=i+1;
  }
  return n;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
// UNMODIFIED from xt.zag.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,4);
  put32(W,4,m+1);
  let b:i32=544+m*40;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,0); put32(W,b+12,0); put32(W,b+16,0); put32(W,b+20,0);
  put32(W,b+24,0); put32(W,b+28,0);
  put32(W,b+32,-1); put32(W,b+36,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*40,0); return; }
// Behaviors: 0 = causal-walk r=91 (was chain-walk r=81).
// 1 = intervention lookup r=92 (was count r=82).
// 2 = identity (unchanged). 3 = count r=91 (was count r=81).
// 4 = composite (unchanged logic).
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=544+m*40;
  let bh:i32=ig(W,b+4);
  if(bh==0){
    let cur:i32=v; let n:i32=0;
    while(n<16){
      let o:i32=find_obj(W,cur,91);
      if(o==-1){ break; }
      cur=o; n=n+1;
    }
    return cur;
  }
  if(bh==1){ return find_obj(W,v,92); }
  if(bh==2){ return v; }
  if(bh==3){ return count_rel(W,v,91); }
  let a:i32=ig(W,b+32); let c:i32=ig(W,b+36);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,c,mid);
}
// UNMODIFIED from xt.zag.
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=544+m*40;
  put32(W,b+8,ig(W,b+8)+probe_kind(W,vin));
  put32(W,b+12,ig(W,b+12)+1);
  put32(W,b+16,ig(W,b+16)+probe_kind(W,vout));
  put32(W,b+20,ig(W,b+20)+1);
  return;
}
// UNMODIFIED from xt.zag.
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=544+m*40;
  let inn:i32=ig(W,b+12); let outn:i32=ig(W,b+20);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+8)*2>=inn*3){ si=2; }
    put32(W,b+24,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+16)*2>=outn*3){ so=2; }
    put32(W,b+28,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*40+24); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*40+28); }
fn teach_all(W:[]u8)void {
  // X: causal model. Teach on 11->13, 21->23, 12->13.
  let x:i32=map_new(W,0);
  let r:i32=exec_map(W,x,11); record_obs(W,x,11,r);
  r=exec_map(W,x,21); record_obs(W,x,21,r);
  r=exec_map(W,x,12); record_obs(W,x,12,r);
  finalize_sig(W,x);
  emit("TEACH X sig="); e64(sig_in(W,x)); emit("->"); pl(sig_out(W,x));
  // Y: intervention lookup. Teach on 13->101, 23->102.
  let y:i32=map_new(W,1);
  r=exec_map(W,y,13); record_obs(W,y,13,r);
  r=exec_map(W,y,23); record_obs(W,y,23,r);
  finalize_sig(W,y);
  emit("TEACH Y sig="); e64(sig_in(W,y)); emit("->"); pl(sig_out(W,y));
  // D1: identity distractor.
  let d1:i32=map_new(W,2);
  r=exec_map(W,d1,11); record_obs(W,d1,11,r);
  r=exec_map(W,d1,21); record_obs(W,d1,21,r);
  finalize_sig(W,d1);
  emit("TEACH D1 sig="); e64(sig_in(W,d1)); emit("->"); pl(sig_out(W,d1));
  // D2: count r=91 distractor.
  let d2:i32=map_new(W,3);
  r=exec_map(W,d2,11); record_obs(W,d2,11,r);
  r=exec_map(W,d2,13); record_obs(W,d2,13,r);
  finalize_sig(W,d2);
  emit("TEACH D2 sig="); e64(sig_in(W,d2)); emit("->"); pl(sig_out(W,d2));
  return;
}
// UNMODIFIED from xt.zag.
fn promote_comp(W:[]u8,a:i32,b:i32,s:i32,r:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=544+z*40;
  put32(W,zb+32,a); put32(W,zb+36,b);
  // composite contract = contract composition: in(A) -> out(B).
  // generic machinery; no per-MAP literals.
  put32(W,zb+24,sig_in(W,a));
  put32(W,zb+28,sig_out(W,b));
  record_obs(W,z,s,r);
  put32(W,8,z);
  return z;
}
// UNMODIFIED from xt.zag.
fn solve_z(W:[]u8,s:i32,target:i32,type_on:i32)i32 {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,4);
  let tries:i32=0;
  let m:i32=0;
  while(m<nm){
    if(ig(W,544+m*40)==1){
      let ok:i32=1;
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        emit("TRY single m="); e64(m); emit(" r="); pl(r);
        if(r==target){ emit("Z-SINGLE m="); pl(m); return tries; }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,544+a*40)==1 && ig(W,544+b*40)==1){
        let ok:i32=1;
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          emit("TRY pair a="); e64(a); emit(" b="); e64(b); emit(" r="); pl(r);
          if(r==target){
            let z:i32=promote_comp(W,a,b,s,r);
            emit("Z-COMP z="); e64(z); emit(" a="); e64(a); emit(" b="); pl(b);
            emit("Z-SIG "); e64(sig_in(W,z)); emit("->"); pl(sig_out(W,z));
            return tries;
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  emit("Z-FAIL\n");
  return 0-tries;
}
fn arm_treat(W:[]u8)i32 {
  emit("=== TREAT ===\n");
  xt_facts(W); teach_all(W);
  let t:i32=solve_z(W,11,101,1);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(t>0 && z>=0){
    let za:i32=ig(W,544+z*40+32); let zb:i32=ig(W,544+z*40+36);
    if(za==0 && zb==1){ ok=1; }
  }
  if(ok==1){ emit("ARM-RESULT PASS tries="); pl(t); }
  else { emit("ARM-RESULT FAIL tries="); pl(t); }
  let t2:i32=solve_z(W,21,102,1);
  emit("Z2 tries="); pl(t2);
  if(t2>0 && t2<=4){ emit("Z2-RESULT PASS\n"); }
  else { emit("Z2-RESULT FAIL\n"); }
  return t;
}
fn arm_notype(W:[]u8,tt:i32)i32 {
  emit("=== NOTYPE ===\n");
  xt_facts(W); teach_all(W);
  let t:i32=solve_z(W,11,101,0);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(t>0 && z>=0){
    let za:i32=ig(W,544+z*40+32); let zb:i32=ig(W,544+z*40+36);
    if(za==0 && zb==1 && t>tt){ ok=1; }
  }
  if(ok==1){ emit("ARM-RESULT PASS tries="); pl(t); }
  else { emit("ARM-RESULT FAIL tries="); pl(t); }
  return t;
}
fn arm_ablx(W:[]u8)i32 {
  emit("=== ABL-X ===\n");
  xt_facts(W); teach_all(W);
  del_map(W,0);
  let t:i32=solve_z(W,11,101,1);
  if(t<=0){ emit("ARM-RESULT PASS-expected-fail tries="); pl(0-t); }
  else { emit("ARM-RESULT FAIL-unexpected-solve tries="); pl(t); }
  return t;
}
fn arm_ably(W:[]u8)i32 {
  emit("=== ABL-Y ===\n");
  xt_facts(W); teach_all(W);
  del_map(W,1);
  let t:i32=solve_z(W,11,101,1);
  if(t<=0){ emit("ARM-RESULT PASS-expected-fail tries="); pl(0-t); }
  else { emit("ARM-RESULT FAIL-unexpected-solve tries="); pl(t); }
  return t;
}
fn arm_fresh(W:[]u8)i32 {
  emit("=== FRESH ===\n");
  xt_facts(W);
  let t:i32=solve_z(W,11,101,1);
  if(t<=0){ emit("ARM-RESULT PASS-expected-fail tries="); pl(0-t); }
  else { emit("ARM-RESULT FAIL-unexpected-solve tries="); pl(t); }
  return t;
}
fn main()i32 {
  emit("XDOMAIN-CAUSAL-H1-START\n");
  let W1:[]u8=z_alloc(4096); xt_init(W1); let tt:i32=arm_treat(W1);
  let W2:[]u8=z_alloc(4096); xt_init(W2); let t_n:i32=arm_notype(W2,tt); if(t_n<0){ emit(""); }
  let W3:[]u8=z_alloc(4096); xt_init(W3); let t_x:i32=arm_ablx(W3); if(t_x>99999){ emit(""); }
  let W4:[]u8=z_alloc(4096); xt_init(W4); let t_y:i32=arm_ably(W4); if(t_y>99999){ emit(""); }
  let W5:[]u8=z_alloc(4096); xt_init(W5); let t_f:i32=arm_fresh(W5); if(t_f>99999){ emit(""); }
  emit("XDOMAIN-CAUSAL-H1-END\n");
  return 0;
}

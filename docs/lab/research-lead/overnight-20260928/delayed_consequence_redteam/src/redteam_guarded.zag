// redteam.zag -- DCRT: red team for C306 delayed consequence.
// Pure Zag. Attack driver + C306 learner logic (verbatim, world selector
// threaded) + preregistered checksum guard variant.
// Prereg: delayed_consequence_redteam/PREREG.md (frozen bars).
// const GUARD: 0 = C306 verbatim learner; 1 = checksum guard at P4 entry.
// The guarded binary is built from a sed copy with GUARD=1; the diff is
// exactly that const.

const DC_FAIL:i32=-1;
const GUARD:i32=1;

// Learner state offsets (u8 buffer, 128 bytes). Identical to C306.
const LS_REL:i32=0;    // rel[5]: i32 at 0,4,8,12,16
const LS_OBS:i32=24;   // observed kills per fact: 8 x i32 at 24..55
const LS_LAST:i32=56;  // last executed composite id
const LS_AC:i32=60;    // attribution: composite id (-1 none, -2 quarantine)
const LS_AF:i32=64;    // attribution: cause fact id (-1 unresolved, -2 quarantine)
const LS_HASR:i32=68;  // has commitment record (0/1)
const LS_RID:i32=72;   // record: composite id
const LS_RPRED:i32=76; // record: prediction
const LS_RRAT:i32=80;  // record: reliability at commit
const LS_RVOL:i32=84;  // record: max license volatility
const LS_REP:i32=88;   // record: commit epoch
const LS_RCK:i32=92;   // record: learner checksum
const LS_ACT0:i32=96;  // composite A active flag
const LS_ACT1:i32=100; // composite B active flag

// ---------- helpers (u8-backed cells, little-endian; copied from C306) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---------- WORLD ----------
// w=0: base world (A1/A3/A4 and D1/D2/D4 controls).
// w=1: A2 decoy-volatility world.
fn fact_val(f:i32)i32 {
  if(f==0){return 10;}
  if(f==1){return 20;}
  if(f==2){return 30;}
  if(f==3){return 40;}
  if(f==4){return 50;}
  if(f==5){return 60;}
  if(f==6){return 70;}
  return 80;
}
fn fact_vol(w:i32, f:i32)i32 {
  if(w==1){ if(f==1){return 3;} return 0; }
  if(f==3){return 2;}
  return 0;
}
// w=0: A=0:{0,1,2} B=1:{0,3} C=2:{4,5} D=3:{6,7} E=4:{4,6} L=5:{1,2}
// w=1: A=0:{0,1,2} B=1:{3,4} C=2:{5,6} D=3:{6,7} E=4:{5,7}
fn comp_nlic(w:i32, cid:i32)i32 {
  if(w==1){ if(cid==0){return 3;} return 2; }
  if(cid==0){return 3;}
  return 2;
}
fn comp_lic(w:i32, cid:i32, k:i32)i32 {
  if(w==1){
    if(cid==0){ if(k==0){return 0;} if(k==1){return 1;} return 2; }
    if(cid==1){ if(k==0){return 3;} return 4; }
    if(cid==2){ if(k==0){return 5;} return 6; }
    if(cid==3){ if(k==0){return 6;} return 7; }
    if(k==0){return 5;} return 7;
  }
  if(cid==0){ if(k==0){return 0;} if(k==1){return 1;} return 2; }
  if(cid==1){ if(k==0){return 0;} return 3; }
  if(cid==2){ if(k==0){return 4;} return 5; }
  if(cid==3){ if(k==0){return 6;} return 7; }
  if(cid==4){ if(k==0){return 4;} return 6; }
  if(k==0){return 1;} return 2;
}
fn exec_c(w:i32, cid:i32, alive:[]u8)i32 {
  let n:i32=comp_nlic(w,cid);
  let k:i32=0;
  let sum:i32=0;
  while(k<n){
    let f:i32=comp_lic(w,cid,k);
    if(alive[f]==0){ return DC_FAIL; }
    sum=sum+fact_val(f);
    k=k+1;
  }
  return sum;
}

// ---------- LEARNER (C306 verbatim logic; world selector w threaded) ----------
fn learner_commit(w:i32, st:[]u8, alive:[]u8, epoch:i32, write_rec:i32)i32 {
  let ra:i32=get32(st,0);
  let rb:i32=get32(st,4);
  let cid:i32=0;
  if(rb>ra){ cid=1; }
  let pred:i32=exec_c(w,cid,alive);
  let rat:i32=ra;
  if(cid==1){ rat=rb; }
  let n:i32=comp_nlic(w,cid);
  let k:i32=0;
  let mv:i32=0;
  while(k<n){
    let v:i32=fact_vol(w,comp_lic(w,cid,k));
    if(v>mv){ mv=v; }
    k=k+1;
  }
  if(write_rec==1){
    set32(st,LS_RID,cid);
    set32(st,LS_RPRED,pred);
    set32(st,LS_RRAT,rat);
    set32(st,LS_RVOL,mv);
    set32(st,LS_REP,epoch);
    let ck:i32=cid*31+pred*7+rat*13+mv*17+epoch*29;
    set32(st,LS_RCK,ck);
    set32(st,LS_HASR,1);
  }
  return cid;
}
fn learner_phase4_record(w:i32, st:[]u8, alive:[]u8)void {
  let rid:i32=get32(st,LS_RID);
  let out:i32=exec_c(w,rid,alive);
  let pred:i32=get32(st,LS_RPRED);
  let d:i32=out-pred;
  if(d<0){ d=0-d; }
  let ro:i32=rid*4;
  if(d==0){
    set32(st,ro,get32(st,ro)+10);
  } else {
    let n:i32=comp_nlic(w,rid);
    let k:i32=0;
    let cause:i32=-1;
    while(k<n){
      let f:i32=comp_lic(w,rid,k);
      if(alive[f]==0){ if(cause==-1){ cause=f; } }
      k=k+1;
    }
    set32(st,LS_AC,rid);
    set32(st,LS_AF,cause);
    set32(st,ro,get32(st,ro)-60);
    if(rid==0){ set32(st,LS_ACT0,0); }
    if(rid==1){ set32(st,LS_ACT1,0); }
    if(cause>=0){
      let oo:i32=LS_OBS+cause*4;
      set32(st,oo,get32(st,oo)+1);
    }
  }
  return;
}
// Preregistered guard (GUARD=1 builds only): verify the learner's own
// record checksum at P4 entry; on mismatch quarantine and never revise.
fn learner_phase4_record_checked(w:i32, st:[]u8, alive:[]u8)void {
  let rid:i32=get32(st,LS_RID);
  let pred:i32=get32(st,LS_RPRED);
  let rat:i32=get32(st,LS_RRAT);
  let vol:i32=get32(st,LS_RVOL);
  let ep:i32=get32(st,LS_REP);
  let ck:i32=rid*31+pred*7+rat*13+vol*17+ep*29;
  if(ck!=get32(st,LS_RCK)){
    set32(st,LS_AC,-2);
    set32(st,LS_AF,-2);
    return;
  }
  learner_phase4_record(w,st,alive);
  return;
}
fn learner_followup(st:[]u8)i32 {
  let a0:i32=get32(st,LS_ACT0);
  let a1:i32=get32(st,LS_ACT1);
  let best:i32=-1;
  let br:i32=-1000000000;
  if(a0==1){ best=0; br=get32(st,0); }
  if(a1==1){ if(get32(st,4)>br){ best=1; br=get32(st,4); } }
  return best;
}

// ---------- DRIVER (evaluator side; never in the learner path) ----------
fn seal_of(st:[]u8)i32 {
  let h:i32=987654321;
  let i:i32=0;
  while(i<24){
    h=h*31+ (st[LS_RID+i] as i32);
    i=i+1;
  }
  return h;
}
// Attack ids: 1=A1, 2=A2, 3=A3, 4=A4. Controls: 11=D1, 12=D2, 14=D4.
fn atk_world(atk:i32)i32 {
  if(atk==2){ return 1; }
  return 0;
}
fn p2_n(atk:i32)i32 {
  if(atk==4){ return 6; }
  if(atk==14){ return 14; }
  return 4;
}
fn p2_ep(atk:i32, j:i32)i32 {
  if(atk==14){
    if(j==0){ return 2; }
    if(j==1){ return 3; }
    if(j==2){ return 4; }
    if(j==3){ return 1; }
    if(j==4){ return 2; }
    if(j==5){ return 3; }
    if(j==6){ return 4; }
    if(j==7){ return 1; }
    if(j==8){ return 2; }
    if(j==9){ return 3; }
    if(j==10){ return 4; }
    if(j==11){ return 2; }
    if(j==12){ return 3; }
    return 4;
  }
  if(atk==4){
    if(j==0){ return 5; }
    if(j==1){ return 5; }
    if(j==2){ return 2; }
    if(j==3){ return 5; }
    if(j==4){ return 3; }
    return 5;
  }
  if(j==0){ return 2; }
  if(j==1){ return 3; }
  if(j==2){ return 4; }
  return 2;
}
// met layout (92 bytes): 0 atk; 4 commit_id; 8 commit_epoch;
// 12 kill_epoch; 16 seal_p2; 20 seal_kill; 24 seal_p4; 28 rec_ep_match;
// 32 relA_commit; 36 relB_commit; 40 relA_final; 44 relB_final;
// 48 attr_c; 52 attr_f; 56 followup_id; 60 followup_out;
// 64 act0; 68 act1; 72 last_p2_epoch; 76 obs1; 80 obs3; 84 any_obs; 88 leak.
fn do_arm(atk:i32, ob:[]u8, at:i32, st:[]u8, tmp:[]u8, met:[]u8)i32 {
  let w:i32=atk_world(atk);
  let i:i32=0;
  while(i<8){ tmp[i]=1; i=i+1; }
  set32(tmp,8,0);
  i=0;
  while(i<128){ st[i]=0; i=i+1; }
  i=0;
  while(i<5){ set32(st,i*4,100); i=i+1; }
  set32(st,LS_ACT0,1);
  set32(st,LS_ACT1,1);
  set32(st,LS_AC,-1);
  set32(st,LS_AF,-1);
  at=ob_app(ob,at,"ATK ");
  at=ob_i32(ob,at,atk);
  at=ob_nl(ob,at);
  // Teaching. D1 (atk 11): A,A,B. All others: B,B,A.
  let t0:i32=1;
  let t1:i32=1;
  let t2:i32=0;
  if(atk==11){ t0=0; t1=0; t2=1; }
  let tt:i32=0;
  while(tt<3){
    let id:i32=t0;
    if(tt==1){ id=t1; }
    if(tt==2){ id=t2; }
    let e:i32=get32(tmp,8);
    set32(tmp,8,e+1);
    let out:i32=exec_c(w,id,tmp);
    if(out!=DC_FAIL){ set32(st,id*4,get32(st,id*4)+10); }
    tt=tt+1;
  }
  at=ob_app(ob,at,"TEACH relA=");
  at=ob_i32(ob,at,get32(st,0));
  at=ob_app(ob,at," relB=");
  at=ob_i32(ob,at,get32(st,4));
  at=ob_nl(ob,at);
  // P1 commitment (always with record; no D3-style arm in redteam).
  let ce:i32=get32(tmp,8);
  let cid:i32=learner_commit(w,st,tmp,ce,1);
  set32(tmp,8,ce+1);
  set32(tmp,12,ce);
  set32(tmp,20,seal_of(st));
  set32(met,0,atk);
  set32(met,4,cid);
  set32(met,8,ce);
  set32(met,32,get32(st,0));
  set32(met,36,get32(st,4));
  at=ob_app(ob,at,"COMMIT id=");
  at=ob_i32(ob,at,cid);
  at=ob_app(ob,at," pred=");
  at=ob_i32(ob,at,get32(st,LS_RPRED));
  at=ob_app(ob,at," r_at=");
  at=ob_i32(ob,at,get32(st,LS_RRAT));
  at=ob_app(ob,at," maxvol=");
  at=ob_i32(ob,at,get32(st,LS_RVOL));
  at=ob_app(ob,at," epoch=");
  at=ob_i32(ob,at,ce);
  at=ob_app(ob,at," cksum=");
  at=ob_i32(ob,at,get32(st,LS_RCK));
  at=ob_app(ob,at," seal=");
  at=ob_i32(ob,at,get32(tmp,20));
  at=ob_nl(ob,at);
  // Snapshots before P2 (vol ledger + licensing).
  i=0;
  while(i<8){ tmp[28+i]=fact_vol(w,i) as u8; tmp[44+i]=tmp[i]; i=i+1; }
  // P2 interference. A3 corrupts the record after episode 2.
  let pn:i32=p2_n(atk);
  let j:i32=0;
  while(j<pn){
    let id:i32=p2_ep(atk,j);
    let e2:i32=get32(tmp,8);
    set32(tmp,8,e2+1);
    set32(tmp,24,e2);
    let out2:i32=exec_c(w,id,tmp);
    if(out2!=DC_FAIL){ set32(st,id*4,get32(st,id*4)+10); }
    set32(st,LS_LAST,id);
    if(atk==3){ if(j==1){
      let rb:i32=st[LS_RID] as i32;
      st[LS_RID]=((rb^1) as i32) as u8;
      at=ob_app(ob,at,"CORRUPT record-id bit flipped mid-P2");
      at=ob_nl(ob,at);
    } }
    j=j+1;
  }
  set32(met,72,get32(tmp,24));
  i=0;
  while(i<8){ tmp[36+i]=fact_vol(w,i) as u8; tmp[52+i]=tmp[i]; i=i+1; }
  let sok:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok=1; }
  set32(met,16,sok);
  at=ob_app(ob,at,"P2 eps=");
  at=ob_i32(ob,at,pn);
  at=ob_app(ob,at," last_exec=");
  at=ob_i32(ob,at,get32(st,LS_LAST));
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok);
  at=ob_nl(ob,at);
  // P3 kill: F3 always; A1 also kills F5. Unannounced.
  tmp[3]=0;
  if(atk==1){ tmp[5]=0; }
  let ke:i32=get32(tmp,8);
  set32(tmp,16,ke);
  set32(tmp,8,ke+1);
  set32(met,12,ke);
  let sok2:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok2=1; }
  set32(met,20,sok2);
  at=ob_app(ob,at,"KILL atk=");
  at=ob_i32(ob,at,atk);
  at=ob_app(ob,at," epoch=");
  at=ob_i32(ob,at,ke);
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok2);
  at=ob_nl(ob,at);
  // P4 learner-owned evaluation (guarded or verbatim by build const).
  if(GUARD==1){ learner_phase4_record_checked(w,st,tmp); } else { learner_phase4_record(w,st,tmp); }
  let e3:i32=get32(tmp,8);
  set32(tmp,8,e3+1);
  let sok3:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok3=1; }
  set32(met,24,sok3);
  let rem:i32=0;
  if(get32(st,LS_REP)==ce){ rem=1; }
  set32(met,28,rem);
  set32(met,40,get32(st,0));
  set32(met,44,get32(st,4));
  set32(met,48,get32(st,LS_AC));
  set32(met,52,get32(st,LS_AF));
  set32(met,64,get32(st,LS_ACT0));
  set32(met,68,get32(st,LS_ACT1));
  set32(met,76,get32(st,LS_OBS+4));
  set32(met,80,get32(st,LS_OBS+12));
  let anyo:i32=0;
  i=0;
  while(i<8){ if(get32(st,LS_OBS+i*4)!=0){ anyo=1; } i=i+1; }
  set32(met,84,anyo);
  at=ob_app(ob,at,"P4 relA=");
  at=ob_i32(ob,at,get32(st,0));
  at=ob_app(ob,at," relB=");
  at=ob_i32(ob,at,get32(st,4));
  at=ob_app(ob,at," attr_c=");
  at=ob_i32(ob,at,get32(st,LS_AC));
  at=ob_app(ob,at," attr_f=");
  at=ob_i32(ob,at,get32(st,LS_AF));
  at=ob_app(ob,at," act0=");
  at=ob_i32(ob,at,get32(st,LS_ACT0));
  at=ob_app(ob,at," act1=");
  at=ob_i32(ob,at,get32(st,LS_ACT1));
  at=ob_app(ob,at," obs1=");
  at=ob_i32(ob,at,get32(st,LS_OBS+4));
  at=ob_app(ob,at," obs3=");
  at=ob_i32(ob,at,get32(st,LS_OBS+12));
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok3);
  at=ob_nl(ob,at);
  // Follow-up query.
  let fid:i32=learner_followup(st);
  let fout:i32=exec_c(w,fid,tmp);
  let e4:i32=get32(tmp,8);
  set32(tmp,8,e4+1);
  set32(met,56,fid);
  set32(met,60,fout);
  at=ob_app(ob,at,"FOLLOWUP id=");
  at=ob_i32(ob,at,fid);
  at=ob_app(ob,at," out=");
  at=ob_i32(ob,at,fout);
  at=ob_nl(ob,at);
  // P2 non-leakage audit (post snapshots predate the P3 kill).
  let leak:i32=0;
  i=0;
  while(i<8){
    if(tmp[28+i]!=tmp[36+i]){ leak=1; }
    i=i+1;
  }
  i=0;
  while(i<8){
    if(tmp[44+i]!=tmp[52+i]){ leak=1; }
    i=i+1;
  }
  set32(met,88,leak);
  at=ob_app(ob,at,"LEAK p2_leak=");
  at=ob_i32(ob,at,leak);
  at=ob_nl(ob,at);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(32768);
  let at:i32=0;
  at=ob_app(ob,at,"DCRT-RUN guard=");
  at=ob_i32(ob,at,GUARD);
  at=ob_nl(ob,at);
  let mets:[]u8=z_alloc(7*92);
  let arm:i32=0;
  while(arm<7){
    let atk:i32=1;
    if(arm==1){ atk=2; }
    if(arm==2){ atk=3; }
    if(arm==3){ atk=4; }
    if(arm==4){ atk=11; }
    if(arm==5){ atk=12; }
    if(arm==6){ atk=14; }
    let st:[]u8=z_alloc(128);
    let tmp:[]u8=z_alloc(64);
    let met:[]u8=z_alloc(92);
    at=do_arm(atk,ob,at,st,tmp,met);
    let b:i32=0;
    while(b<92){ mets[arm*92+b]=met[b]; b=b+1; }
    arm=arm+1;
  }
  // In-program bars. Arms: 0=A1 1=A2 2=A3 3=A4 4=D1 5=D2 6=D4.
  // A1: succeeds iff attr != (1,3).
  let o0:i32=0;
  let a1s:i32=0;
  if(get32(mets,o0+48)!=1){ a1s=1; }
  if(get32(mets,o0+52)!=3){ a1s=1; }
  // A2: succeeds iff attr != (1,3) or stale-vol fact F1 got a kill credit.
  let o1:i32=92;
  let a2s:i32=0;
  if(get32(mets,o1+48)!=1){ a2s=1; }
  if(get32(mets,o1+52)!=3){ a2s=1; }
  if(get32(mets,o1+76)!=0){ a2s=1; }
  // A3: integrity caught iff seal_p4==0; sanity succeeds iff revision happened.
  let o2:i32=184;
  let a3caught:i32=0;
  if(get32(mets,o2+24)==0){ a3caught=1; }
  let a3s:i32=0;
  if(get32(mets,o2+40)!=110){ a3s=1; }
  if(get32(mets,o2+44)!=120){ a3s=1; }
  if(get32(mets,o2+64)==0){ a3s=1; }
  if(get32(mets,o2+68)==0){ a3s=1; }
  let ac3:i32=get32(mets,o2+48);
  if(ac3!=-1){ if(ac3!=-2){ a3s=1; } }
  if(get32(mets,o2+84)!=0){ a3s=1; }
  // A4: succeeds iff attr != (1,3).
  let o3:i32=276;
  let a4s:i32=0;
  if(get32(mets,o3+48)!=1){ a4s=1; }
  if(get32(mets,o3+52)!=3){ a4s=1; }
  // G1 (guarded A3): quarantine, no revision. Flat checks (nesting<=3).
  let g1:i32=1;
  if(get32(mets,o2+48)!=-2){ g1=0; }
  if(get32(mets,o2+52)!=-2){ g1=0; }
  if(get32(mets,o2+40)!=110){ g1=0; }
  if(get32(mets,o2+44)!=120){ g1=0; }
  if(get32(mets,o2+64)!=1){ g1=0; }
  if(get32(mets,o2+68)!=1){ g1=0; }
  if(get32(mets,o2+84)!=0){ g1=0; }
  // G2 (guarded D1/D2/D4 match C306): D1 relA 130; D2 attr(1,3) relB 60
  // followup A ok; D4 attr(1,3) relB 80 followup A ok.
  let o4:i32=368;
  let o5:i32=460;
  let o6:i32=552;
  let g2:i32=1;
  if(get32(mets,o4+40)!=130){ g2=0; }
  if(get32(mets,o5+48)!=1){ g2=0; }
  if(get32(mets,o5+52)!=3){ g2=0; }
  if(get32(mets,o5+44)!=60){ g2=0; }
  if(get32(mets,o5+56)!=0){ g2=0; }
  if(get32(mets,o5+60)==DC_FAIL){ g2=0; }
  if(get32(mets,o6+48)!=1){ g2=0; }
  if(get32(mets,o6+52)!=3){ g2=0; }
  if(get32(mets,o6+44)!=80){ g2=0; }
  if(get32(mets,o6+56)!=0){ g2=0; }
  if(get32(mets,o6+60)==DC_FAIL){ g2=0; }
  at=ob_app(ob,at,"BARS a1_succeeds=");
  at=ob_i32(ob,at,a1s);
  at=ob_app(ob,at," a2_succeeds=");
  at=ob_i32(ob,at,a2s);
  at=ob_app(ob,at," a3_seal_caught=");
  at=ob_i32(ob,at,a3caught);
  at=ob_app(ob,at," a3_sanity_succeeds=");
  at=ob_i32(ob,at,a3s);
  at=ob_app(ob,at," a4_succeeds=");
  at=ob_i32(ob,at,a4s);
  at=ob_app(ob,at," g1=");
  at=ob_i32(ob,at,g1);
  at=ob_app(ob,at," g2=");
  at=ob_i32(ob,at,g2);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"DCRT-END\n");
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

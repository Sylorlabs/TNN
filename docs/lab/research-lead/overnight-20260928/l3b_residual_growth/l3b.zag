// l3b.zag -- L3B residual-growth builder.
//
// Mission: the learner grows new executable structure from prediction
// failures using generic construction machinery. Grown structures are
// programs in the PRE-EXISTING base language B, executed by the
// pre-existing generic base interpreter binterp_eval. No new production
// and no new semantic case is added for any grown structure.
//
// Prereg: PREREG_L3B.md, frozen alone at c5be6dfb5 BEFORE this file
// existed. Kill bars K-RG-1..K-RG-9. The builder reports
// L3B-GROWTH-PASS or L3B-GROWTH-FAIL only (via the shell harness, which
// adds the harness-side bars K-RG-7, K-RG-8 and the combined K-RG-9).
//
// Base predictor language L (provably inadequate): single constant
// branches (c0,c1,c2), ci in 1..8; fires iff c0==n. See prereg section 4
// for the inadequacy theorem (each branch correct on at most one E_n;
// any ALT of at most 3 correct on at most 3 of E_1..E_12).
//
// Base executable language B: arithmetic expressions over feature F0
// (observed spec run length). Ops: 1=CONST 2=VAR 3=ADD 4=MUL 5=SUB.
// binterp_eval below is the ONLY place where B semantics live. The
// growth machinery CALLS it; nothing adds a case to it.
//
// Storage note: all integer arrays are byte arrays holding little-endian
// i32 cells, accessed via ig/is. (The []u8 pattern is the established
// loop idiom.)
//
// Pure Zag. No Python at any stage.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn ia(n:i32)[]u8 { return z_alloc(n*4); }
fn ig(a:[]u8, i:i32)i32 {
  let b:i32=i*4;
  return (a[b] as i32)+((a[b+1] as i32)*256)+((a[b+2] as i32)*65536)+((a[b+3] as i32)*16777216);
}
fn is(a:[]u8, i:i32, v:i32)void {
  let b:i32=i*4;
  a[b]=(v & 255) as u8;
  a[b+1]=((v >> 8) & 255) as u8;
  a[b+2]=((v >> 16) & 255) as u8;
  a[b+3]=((v >> 24) & 255) as u8;
  return;
}
fn pe(s:[]u8)void { _zag_print(s); return; }
fn pi(v:i32)void { let t:[]u8=_zag_i64_to_str(v as i64); _zag_print(t); return; }
fn pn()void { _zag_print("\n"); return; }
fn prel(r:i32)void {
  if(r==1){pe("EQ");return;}
  if(r==2){pe("MUL");return;}
  if(r==3){pe("ADD");return;}
  if(r==4){pe("SUB");return;}
  pe("NONE");return;
}
fn pphase(p:i32)void {
  if(p==0){pe("LEARN");return;}
  if(p==1){pe("HIDDEN");return;}
  if(p==2){pe("CONTRADICTION");return;}
  pe("FOLLOWUP");return;
}

// INTERP-BEGIN
// Base interpreter for language B. Frozen base machinery.
// Ops: 1 is CONST, 2 is VAR, 3 is ADD, 4 is MUL, 5 is SUB.
// Standard arithmetic semantics. This function is the only place where
// B node semantics are implemented. Growth machinery may call it; no
// growth event may add a case, a tag, or a branch to it.
fn binterp_eval(nid:i32, f0:i32, n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:i32)i32 {
  if(nid<0){return 0;}
  if(nid>=ncnt){return 0;}
  let op:i32=ig(n_op,nid);
  if(op==1){return ig(n_cv,nid);}
  if(op==2){if(ig(n_ft,nid)!=0){return 0;}return f0;}
  let l:i32=binterp_eval(ig(n_l,nid), f0, n_op, n_l, n_r, n_cv, n_ft, ncnt);
  let r:i32=binterp_eval(ig(n_r,nid), f0, n_op, n_l, n_r, n_cv, n_ft, ncnt);
  if(op==3){return l+r;}
  if(op==4){return l*r;}
  if(op==5){return l-r;}
  return 0;
}
// INTERP-END

// ---- Generic construction operators (prereg section 6 substrate) ----
// Node store: n_op, n_l, n_r, n_cv, n_ft; ncnt cell 0 = used count.
// Call log: lg_k kind (1=CREATE 2=CONNECT 3=SPLIT 4=MERGE),
//   lg_a, lg_b, lg_c args, lg_d assigned id; lgn cell 0 = record count.
fn lg_rec(lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
           k:i32, a:i32, b:i32, c:i32, d:i32)void {
  let i:i32=ig(lgn,0);
  is(lg_k,i,k); is(lg_a,i,a); is(lg_b,i,b); is(lg_c,i,c); is(lg_d,i,d);
  is(lgn,0,i+1);
  return;
}
fn ns_create(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
             lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
             op:i32, cval:i32, feat:i32)i32 {
  let id:i32=ig(ncnt,0);
  if(id>=256){pe("STORE-FULL");pn();return 255;}
  is(n_op,id,op); is(n_l,id,255); is(n_r,id,255); is(n_cv,id,cval); is(n_ft,id,feat);
  is(ncnt,0,id+1);
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1, op, cval, feat, id);
  return id;
}
fn ns_connect(n_l:[]u8, n_r:[]u8,
              lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
              pid:i32, slot:i32, cid:i32)void {
  if(slot==0){is(n_l,pid,cid);}else{is(n_r,pid,cid);}
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2, pid, slot, cid, -1);
  return;
}
fn ns_split(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
            lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
            id:i32)i32 {
  let nid:i32=ig(ncnt,0);
  if(nid>=256){pe("STORE-FULL");pn();return 255;}
  is(n_op,nid,ig(n_op,id)); is(n_l,nid,ig(n_l,id)); is(n_r,nid,ig(n_r,id));
  is(n_cv,nid,ig(n_cv,id)); is(n_ft,nid,ig(n_ft,id));
  is(ncnt,0,nid+1);
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 3, id, 0, 0, nid);
  return nid;
}
fn ns_merge(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
            lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
            a:i32, b:i32)i32 {
  let m:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 3,0,0);
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, m,0,a);
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, m,1,b);
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 4, a, b, 0, m);
  return m;
}

// ---- Base predictor language L ----
fn cand_score(c:i32, tn:[]u8, tl1:[]u8, tl2:[]u8, m:i32)i32 {
  let c0:i32=c/64+1;
  let c1:i32=(c/8)%8+1;
  let c2:i32=c%8+1;
  let s:i32=0;
  let i:i32=0;
  while(i<m){
    if(c0==ig(tn,i) && c1==ig(tl1,i) && c2==ig(tl2,i)){s=s+1;}
    i=i+1;
  }
  return s;
}
fn best_cand(tn:[]u8, tl1:[]u8, tl2:[]u8, m:i32)i32 {
  if(m==0){return 0;}
  let best:i32=0;
  let bs:i32=-1;
  let c:i32=0;
  while(c<512){
    let s:i32=cand_score(c,tn,tl1,tl2,m);
    if(s>bs){bs=s;best=c;}
    c=c+1;
  }
  return best;
}
// K-RG-1: max over the 512 canonical singles on E_1..E_12.
// fam 0: E_n^A with l1=n, l2=2n. fam 1: E_n^B with l1=n+2, l2=n.
fn kx_max(fam:i32)i32 {
  let mx:i32=0;
  let c:i32=0;
  while(c<512){
    let c0:i32=c/64+1;
    let c1:i32=(c/8)%8+1;
    let c2:i32=c%8+1;
    let sc:i32=0;
    let m2:i32=1;
    while(m2<=12){
      if(fam==0){
        if(c0==m2 && c1==m2 && c2==2*m2){sc=sc+1;}
      }else{
        if(c0==m2 && c1==m2+2 && c2==m2){sc=sc+1;}
      }
      m2=m2+1;
    }
    if(sc>mx){mx=sc;}
    c=c+1;
  }
  return mx;
}

// ---- Learner state helpers ----
// g cells: 0 active, 1 r1, 2 r2, 3 ver, 4 rel1, 5 k1, 6 rel2, 7 k2
// fb arrays cap 8; fbn cell 0 = count; consec cell 0; tr arrays cap 32; trm cell 0
fn reset_learner(ncnt:[]u8, g:[]u8, fbn:[]u8, consec:[]u8, trm:[]u8)void {
  is(ncnt,0,0);
  is(g,0,0); is(g,1,-1); is(g,2,-1); is(g,3,0);
  is(g,4,0); is(g,5,0); is(g,6,0); is(g,7,0);
  is(fbn,0,0); is(consec,0,0); is(trm,0,0);
  return;
}
fn fb_push(fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
           fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8,
           l0:i32,l1:i32,l2:i32,s1:i32,s2:i32,h0:i32,h1:i32)void {
  let idx:i32=0;
  let n:i32=ig(fbn,0);
  if(n<8){idx=n;is(fbn,0,n+1);}
  else{
    let i:i32=0;
    while(i<7){
      is(fb_l0,i,ig(fb_l0,i+1)); is(fb_l1,i,ig(fb_l1,i+1)); is(fb_l2,i,ig(fb_l2,i+1));
      is(fb_s1,i,ig(fb_s1,i+1)); is(fb_s2,i,ig(fb_s2,i+1));
      is(fb_h0,i,ig(fb_h0,i+1)); is(fb_h1,i,ig(fb_h1,i+1));
      i=i+1;
    }
    idx=7;
  }
  is(fb_l0,idx,l0); is(fb_l1,idx,l1); is(fb_l2,idx,l2);
  is(fb_s1,idx,s1); is(fb_s2,idx,s2); is(fb_h0,idx,h0); is(fb_h1,idx,h1);
  return;
}
// Fixed-vocabulary relation search over 3 failures. out cells: 0 rel, 1 k.
fn rel_of(x0:i32,y0:i32, x1:i32,y1:i32, x2:i32,y2:i32, out:[]u8)i32 {
  if(y0==x0 && y1==x1 && y2==x2){is(out,0,1);is(out,1,0);return 1;}
  let q:i32=1;
  while(q<=8){
    if(y0==q*x0 && y1==q*x1 && y2==q*x2){is(out,0,2);is(out,1,q);return 1;}
    q=q+1;
  }
  let d:i32=0;
  while(d<=8){
    if(y0-x0==d && y1-x1==d && y2-x2==d){is(out,0,3);is(out,1,d);return 1;}
    d=d+1;
  }
  d=1;
  while(d<=8){
    if(x0-y0==d && x1-y1==d && x2-y2==d){is(out,0,4);is(out,1,d);return 1;}
    d=d+1;
  }
  is(out,0,0);is(out,1,0);return 0;
}
// build_expr: single generic code path parameterized by data-determined
// (rel,k). Uses ONLY the section 6 construction operators.
fn build_expr(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
              lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
              rel:i32, k:i32)i32 {
  if(rel==1){
    return ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0);
  }
  let v:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0);
  let c:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,k,0);
  if(rel==3){
    return ns_merge(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, v,c);
  }
  let m:i32=0;
  if(rel==2){
    m=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 4,0,0);
  }else{
    m=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 5,0,0);
  }
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, m,0,v);
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, m,1,c);
  return m;
}
fn print_calls(lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, from:i32, to:i32)void {
  let i:i32=from;
  while(i<to){
    let k:i32=ig(lg_k,i);
    pe(" ");
    if(k==1){pe("CREATE(op=");pi(ig(lg_a,i));pe(",val=");pi(ig(lg_b,i));pe(")->");pi(ig(lg_d,i));}
    if(k==2){pe("CONNECT(");pi(ig(lg_a,i));pe(",");pi(ig(lg_b,i));pe(",");pi(ig(lg_c,i));pe(")");}
    if(k==3){pe("SPLIT(");pi(ig(lg_a,i));pe(")->");pi(ig(lg_d,i));}
    if(k==4){pe("MERGE(");pi(ig(lg_a,i));pe(",");pi(ig(lg_b,i));pe(")->");pi(ig(lg_d,i));}
    i=i+1;
  }
  return;
}
fn do_grow(inst:i32, phase:i32, ep:i32,
            n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
            lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
            g:[]u8, rel1:i32, k1:i32, rel2:i32, k2:i32, cnt:[]u8)void {
  let snap:i32=ig(lgn,0);
  let old_active:i32=ig(g,0);
  let old_r1:i32=ig(g,1);
  let old_r2:i32=ig(g,2);
  let old_rel1:i32=ig(g,4);
  let old_k1:i32=ig(g,5);
  let old_rel2:i32=ig(g,6);
  let old_k2:i32=ig(g,7);
  let oldv:i32=ig(g,3);
  let newv:i32=oldv+1;
  if(old_active==1){
    pe("TRACE-RETIRE inst=");pi(inst);pe(" v=");pi(oldv);
    pe(" reason=contradiction superseded-by=");pi(newv);pn();
    is(cnt,5,1);
    is(cnt,6,old_rel2); is(cnt,7,old_k2);
  }
  let r1:i32=0;
  let r2:i32=0;
  let splitu:i32=0;
  if(old_active==1 && rel1==old_rel1 && k1==old_k1){
    r1=ns_split(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, old_r1);
    splitu=1;
  }else{
    r1=build_expr(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, rel1,k1);
  }
  if(old_active==1 && rel2==old_rel2 && k2==old_k2){
    r2=ns_split(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, old_r2);
    splitu=1;
  }else{
    r2=build_expr(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, rel2,k2);
  }
  is(g,0,1); is(g,1,r1); is(g,2,r2); is(g,3,newv);
  is(g,4,rel1); is(g,5,k1); is(g,6,rel2); is(g,7,k2);
  if(inst==1 && newv==1){is(cnt,11,rel1);is(cnt,12,k1);is(cnt,13,rel2);is(cnt,14,k2);}
  if(inst==2 && newv==1){is(cnt,15,rel1);is(cnt,16,k1);is(cnt,17,rel2);is(cnt,18,k2);}
  if(inst==1 && newv==2){is(cnt,8,rel2);is(cnt,9,k2);is(cnt,10,splitu);}
  pe("TRACE-CREATE inst=");pi(inst);pe(" phase=");pphase(phase);
  pe(" ep=");pi(ep);pe(" v=");pi(newv);
  pe(" rel1=");prel(rel1);pe(" k1=");pi(k1);
  pe(" rel2=");prel(rel2);pe(" k2=");pi(k2);
  pe(" ev=3");
  if(old_active==1){pe(" supersedes=");pi(oldv);}
  pn();
  pe("CALLS:");
  print_calls(lg_k,lg_a,lg_b,lg_c,lg_d,snap,ig(lgn,0));
  pn();
  return;
}
fn do_fire(inst:i32, phase:i32, ep:i32,
           n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
           lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
           g:[]u8,
           fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
           fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8, cnt:[]u8)void {
  let i0:i32=ig(fbn,0)-3;
  let i1:i32=ig(fbn,0)-2;
  let i2:i32=ig(fbn,0)-1;
  let o1:[]u8=ia(2);
  let o2:[]u8=ia(2);
  let f1:i32=rel_of(ig(fb_l0,i0),ig(fb_l1,i0), ig(fb_l0,i1),ig(fb_l1,i1), ig(fb_l0,i2),ig(fb_l1,i2), o1);
  let f2:i32=rel_of(ig(fb_l0,i0),ig(fb_l2,i0), ig(fb_l0,i1),ig(fb_l2,i1), ig(fb_l0,i2),ig(fb_l2,i2), o2);
  let sy:i32=1;
  if(ig(fb_s1,i0)!=ig(fb_h0,i0) || ig(fb_s1,i1)!=ig(fb_h0,i1) || ig(fb_s1,i2)!=ig(fb_h0,i2)){sy=0;}
  if(ig(fb_s2,i0)!=ig(fb_h1,i0) || ig(fb_s2,i1)!=ig(fb_h1,i1) || ig(fb_s2,i2)!=ig(fb_h1,i2)){sy=0;}
  if(f1==1 && f2==1 && sy==1){
    do_grow(inst,phase,ep, n_op,n_l,n_r,n_cv,n_ft,ncnt,
            lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g, ig(o1,0),ig(o1,1), ig(o2,0),ig(o2,1), cnt);
  }else{
    pe("NO-GROWTH inst=");pi(inst);pe(" phase=");pphase(phase);pe(" ep=");pi(ep);pn();
  }
  return;
}
// One episode. tally: 0 none, 1 hiddenA, 2 hiddenB, 3 followup, 4 ablation.
fn step(inst:i32, phase:i32, ep:i32, n:i32, h0:i32, h1:i32,
        ts1:i32, tl1:i32, ts2:i32, tl2:i32,
        allow_create:i32, is_learn:i32, tally:i32,
        n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
        lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
        g:[]u8,
        fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
        fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8, consec:[]u8,
        tr_n:[]u8, tr_l1:[]u8, tr_l2:[]u8, trm:[]u8, cnt:[]u8)i32 {
  let ps1:i32=0; let pl1:i32=0; let ps2:i32=0; let pl2:i32=0;
  let made:i32=0;
  if(ig(g,0)==1){
    let r1:i32=binterp_eval(ig(g,1), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
    let r2:i32=binterp_eval(ig(g,2), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
    if(r1>=1 && r2>=1){ps1=h0;pl1=r1;ps2=h1;pl2=r2;made=1;}
  }else{
    let bc:i32=best_cand(tr_n,tr_l1,tr_l2,ig(trm,0));
    let c0:i32=bc/64+1;
    let c1:i32=(bc/8)%8+1;
    let c2:i32=bc%8+1;
    if(c0==n){ps1=h0;pl1=c1;ps2=h1;pl2=c2;made=1;}
  }
  let ok:i32=0;
  if(made==1 && ps1==ts1 && pl1==tl1 && ps2==ts2 && pl2==tl2){ok=1;}
  if(ok==1){
    if(tally==1){is(cnt,0,ig(cnt,0)+1);}
    if(tally==2){is(cnt,1,ig(cnt,1)+1);}
    if(tally==3){is(cnt,2,ig(cnt,2)+1);}
    if(tally==4){is(cnt,4,ig(cnt,4)+1);}
    if(ig(g,0)==1){is(cnt,3,ig(cnt,3)+1);}
  }
  if(ok==1){
    is(consec,0,0);
  }else{
    fb_push(fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn, n,tl1,tl2,ts1,ts2,h0,h1);
    is(consec,0,ig(consec,0)+1);
    if(ig(consec,0)>=3){
      if(allow_create==1){
        do_fire(inst,phase,ep, n_op,n_l,n_r,n_cv,n_ft,ncnt,
                lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
                fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn, cnt);
      }
      is(consec,0,0);
    }
  }
  if(is_learn==1){
    let m:i32=ig(trm,0);
    is(tr_n,m,n); is(tr_l1,m,tl1); is(tr_l2,m,tl2);
    is(trm,0,m+1);
  }
  return ok;
}
// A3: validate every constructor call record in the log.
fn audit_a3(lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8)i32 {
  let i:i32=0;
  while(i<ig(lgn,0)){
    let k:i32=ig(lg_k,i);
    if(k<1 || k>4){return 0;}
    if(k==1){if(ig(lg_a,i)<1 || ig(lg_a,i)>5){return 0;}}
    if(k==2){
      if(ig(lg_b,i)<0 || ig(lg_b,i)>1){return 0;}
      if(ig(lg_a,i)<0 || ig(lg_c,i)<0){return 0;}
    }
    if(k==3){if(ig(lg_a,i)<0){return 0;}}
    if(k==4){if(ig(lg_a,i)<0 || ig(lg_b,i)<0){return 0;}}
    i=i+1;
  }
  return 1;
}
fn set6(a:[]u8, a0:i32,a1:i32,a2:i32,a3:i32,a4:i32,a5:i32)void {
  is(a,0,a0);is(a,1,a1);is(a,2,a2);is(a,3,a3);is(a,4,a4);is(a,5,a5);
  return;
}
fn set3(a:[]u8, a0:i32,a1:i32,a2:i32)void {
  is(a,0,a0);is(a,1,a1);is(a,2,a2);
  return;
}
fn set2(a:[]u8, a0:i32,a1:i32)void {
  is(a,0,a0);is(a,1,a1);
  return;
}
fn emit_bar(name:[]u8, pass:i32)void {
  pe("RG-BAR ");pe(name);pe(" ");
  if(pass==1){pe("PASS");}else{pe("FAIL");}
  pn();
  return;
}
fn main()i32 {
  // ---- allocate all state (byte arrays; ig/is access) ----
  let n_op:[]u8=ia(256);
  let n_l:[]u8=ia(256);
  let n_r:[]u8=ia(256);
  let n_cv:[]u8=ia(256);
  let n_ft:[]u8=ia(256);
  let ncnt:[]u8=ia(1);
  let lg_k:[]u8=ia(1024);
  let lg_a:[]u8=ia(1024);
  let lg_b:[]u8=ia(1024);
  let lg_c:[]u8=ia(1024);
  let lg_d:[]u8=ia(1024);
  let lgn:[]u8=ia(1);
  let g:[]u8=ia(8);
  let fb_l0:[]u8=ia(8);
  let fb_l1:[]u8=ia(8);
  let fb_l2:[]u8=ia(8);
  let fb_s1:[]u8=ia(8);
  let fb_s2:[]u8=ia(8);
  let fb_h0:[]u8=ia(8);
  let fb_h1:[]u8=ia(8);
  let fbn:[]u8=ia(1);
  let consec:[]u8=ia(1);
  let tr_n:[]u8=ia(32);
  let tr_l1:[]u8=ia(32);
  let tr_l2:[]u8=ia(32);
  let trm:[]u8=ia(1);
  let cnt:[]u8=ia(24);
  let ns:[]u8=ia(6);
  let ns3:[]u8=ia(3);
  let ns2:[]u8=ia(2);

  pe("L3B-RESIDUAL-GROWTH frozen run");pn();

  // ---- K-RG-1: inadequacy computational check ----
  let maxA:i32=kx_max(0);
  let maxB:i32=kx_max(1);
  pe("RG-KX1 maxA=");pi(maxA);pe(" maxB=");pi(maxB);pn();

  // ---- A4: interpreter generality on hand-written B programs ----
  // (never produced by growth; scratch store, reset afterwards)
  let v:[]u8=ia(8);
  // G1: ADD(MUL(VAR,CONST(3)),CONST(2)) at f0=5 -> 17
  is(v,0,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0));
  is(v,1,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,3,0));
  is(v,2,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 4,0,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,2),0,ig(v,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,2),1,ig(v,1));
  is(v,3,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,2,0));
  is(v,4,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 3,0,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,4),0,ig(v,2));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,4),1,ig(v,3));
  let e1:i32=binterp_eval(ig(v,4),5, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
  // G4: SPLIT of the MUL subtree, eval at f0=5 -> 15
  let sp:i32=ns_split(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,2));
  let e4:i32=binterp_eval(sp,5, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
  // G2: SUB(MUL(VAR,CONST(2)),CONST(1)) at f0=6 -> 11
  is(v,0,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0));
  is(v,1,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,2,0));
  is(v,2,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 4,0,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,2),0,ig(v,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,2),1,ig(v,1));
  is(v,3,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,1,0));
  is(v,4,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 5,0,0));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,4),0,ig(v,2));
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,4),1,ig(v,3));
  let e2:i32=binterp_eval(ig(v,4),6, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
  // G3: MERGE-built ADD(CONST(2),CONST(3)) -> 5
  is(v,5,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,2,0));
  is(v,6,ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,3,0));
  let mg:i32=ns_merge(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, ig(v,5),ig(v,6));
  let e3:i32=binterp_eval(mg,0, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
  pe("RG-GENERALITY e1=");pi(e1);pe(" e2=");pi(e2);pe(" e3=");pi(e3);pe(" e4=");pi(e4);pn();
  let a4pass:i32=0;
  if(e1==17 && e2==11 && e3==5 && e4==15){a4pass=1;}
  pe("RG-AUDIT-A4 ");
  if(a4pass==1){pe("PASS");}else{pe("FAIL");}
  pn();
  is(ncnt,0,0);

  // ---- Instance 1: family A ----
  reset_learner(ncnt, g,fbn,consec,trm);
  pe("INST1 family A begin");pn();
  set6(ns, 2,3,5,7,4,6);
  let i:i32=0;
  while(i<6){
    let nn:i32=ig(ns,i);
    step(1,0,i+1, nn,97,98, 97,nn,98,2*nn, 1,1,0,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 1,4,8);
  i=0;
  while(i<3){
    let n2:i32=ig(ns3,i);
    step(1,1,i+1, n2,97,98, 97,n2,98,2*n2, 0,0,1,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 3,6,5);
  i=0;
  while(i<3){
    let n3:i32=ig(ns3,i);
    step(1,2,i+1, n3,97,98, 97,n3,98,n3+4, 1,0,0,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set2(ns2, 5,7);
  i=0;
  while(i<2){
    let n4:i32=ig(ns2,i);
    step(1,3,i+1, n4,97,98, 97,n4,98,n4+4, 0,0,3,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  pe("INST1 done hiddenA=");pi(ig(cnt,0));pe(" follow=");pi(ig(cnt,2));pn();

  // ---- Instance 2: family B ----
  reset_learner(ncnt, g,fbn,consec,trm);
  pe("INST2 family B begin");pn();
  set6(ns, 2,4,6,3,5,7);
  i=0;
  while(i<6){
    let n5:i32=ig(ns,i);
    step(2,0,i+1, n5,120,121, 120,n5+2,121,n5, 1,1,0,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 1,5,8);
  i=0;
  while(i<3){
    let n6:i32=ig(ns3,i);
    step(2,1,i+1, n6,120,121, 120,n6+2,121,n6, 0,0,2,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  pe("INST2 done hiddenB=");pi(ig(cnt,1));pn();

  // ---- Ablation instances: growth disabled ----
  reset_learner(ncnt, g,fbn,consec,trm);
  pe("ABL1 begin");pn();
  set6(ns, 2,3,5,7,4,6);
  i=0;
  while(i<6){
    let n7:i32=ig(ns,i);
    step(3,0,i+1, n7,97,98, 97,n7,98,2*n7, 0,1,0,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 1,4,8);
  i=0;
  while(i<3){
    let n8:i32=ig(ns3,i);
    step(3,1,i+1, n8,97,98, 97,n8,98,2*n8, 0,0,4,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  reset_learner(ncnt, g,fbn,consec,trm);
  pe("ABL2 begin");pn();
  set6(ns, 2,4,6,3,5,7);
  i=0;
  while(i<6){
    let n9:i32=ig(ns,i);
    step(4,0,i+1, n9,120,121, 120,n9+2,121,n9, 0,1,0,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 1,5,8);
  i=0;
  while(i<3){
    let n10:i32=ig(ns3,i);
    step(4,1,i+1, n10,120,121, 120,n10+2,121,n10, 0,0,4,
         n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
         fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
         tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  pe("ABL done abl_total=");pi(ig(cnt,4));pe(" growth_assisted=");pi(ig(cnt,3));pn();

  // ---- A3: constructor-call audit ----
  let a3pass:i32=audit_a3(lg_k,lg_a,lg_b,lg_c,lg_d,lgn);
  pe("RG-AUDIT-A3 ");
  if(a3pass==1){pe("PASS");}else{pe("FAIL");}
  pn();

  // ---- Bars (program-side) ----
  let b1:i32=0;
  if(maxA==1 && maxB==1){b1=1;}
  emit_bar("K-RG-1", b1);
  let b2:i32=0;
  if(ig(cnt,11)==1 && ig(cnt,13)==2 && ig(cnt,14)==2 && ig(cnt,15)==3 && ig(cnt,16)==2 && ig(cnt,17)==1){b2=1;}
  emit_bar("K-RG-2", b2);
  let b3:i32=0;
  if(ig(cnt,0)==3 && ig(cnt,1)==3){b3=1;}
  emit_bar("K-RG-3", b3);
  let b4:i32=0;
  if(ig(cnt,4)<=2){b4=1;}
  emit_bar("K-RG-4", b4);
  let b5:i32=0;
  if(ig(cnt,3)>=10){b5=1;}
  emit_bar("K-RG-5", b5);
  let b6:i32=0;
  if(ig(cnt,5)==1 && ig(cnt,8)==3 && ig(cnt,9)==4 && ig(cnt,10)==1 && ig(cnt,2)==2){
    if(ig(cnt,6)!=ig(cnt,8) || ig(cnt,7)!=ig(cnt,9)){b6=1;}
  }
  emit_bar("K-RG-6", b6);
  pe("RG-NOTE K-RG-7 K-RG-8 K-RG-9 evaluated by shell harness");pn();
  return 0;
}

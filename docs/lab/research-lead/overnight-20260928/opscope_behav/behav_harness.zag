// behav_harness.zag - Training/test harness with behavioral validation.
// EXCLUDED from the F3 source audit (harness). The learner file is audited.
// Prereg: 82e0e94fd, Amendments 1 (428c00e23), 2 (54c943702). FROZEN.
//
// FAM: 0=B1 original R1R4, 1=B2 gate-stress Family A, 4=B3 displacement.
// SEED: 2001/2002/2003 per family (set in the combined file).
// NEP: 120 (100 train + 20 test). Attack probe episodes (120+) not used.
// Uses emit/i32s from the world file.
fn FAM()i32 { return 0; }
fn SEED()i32 { return 2001; }

// Recover unit ids and target for episode e into U (4 words), returns n.
// Sets nU and T via out-params in R (2 i32: n, T).
fn recover_ep(eps:[]u8, e:i32, U:[]u8, R:[]u8)void {
  let ep:[]u8=z_alloc(64);
  let k:i32=0;
  while(k<64){ ep[k]=eps[e*64+k]; k=k+1; }
  let n:i32=world_recover_U(ep,U);
  let T:i32=world_T(ep,U,n);
  set32(R,0,n);
  set32(R,4,T);
  return;
}

// TEST_ACC on episodes 100..119 using interpret().
fn test_acc(W:[]u8, allU:[]u8, allN:[]u8, allT:[]u8)i32 {
  let tc:i32=0;
  let t:i32=0;
  while(t<20){
    let e:i32=100+t;
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let U:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<n){ set32(U,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    let p:i32=interpret(W,U,n);
    if(p==T){ tc=tc+1; }
    t=t+1;
  }
  return tc;
}

// Check tentative operator W2 on all V episodes containing w at position p.
// Returns 1 if all correct, 0 otherwise. Also counts them in C (i32 out).
fn check_pos(W2:[]u8, w:i32, p:i32, allU:[]u8, allN:[]u8, allT:[]u8, C:[]u8)i32 {
  let ok:i32=1;
  let cnt:i32=0;
  let t:i32=0;
  while(t<20){
    let e:i32=100+t;
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let j:i32=0;
    while(j<n){
      if(get32(allU,(e*4+j)*4)==w && j==p){
        cnt=cnt+1;
        let U:[]u8=z_alloc(16);
        let jj:i32=0;
        while(jj<n){ set32(U,jj*4,get32(allU,(e*4+jj)*4)); jj=jj+1; }
        if(interpret(W2,U,n)!=T){ ok=0; }
        j=n;
      }
      j=j+1;
    }
    t=t+1;
  }
  set32(C,0,cnt);
  return ok;
}

// Behavioral validation. Returns via OUT (i32 array):
// OUT[0]=n_candidates, OUT[1]=n_installed.
// Emits per-candidate diagnostics.
fn validate(W:[]u8, seen:i32, eps:[]u8, allU:[]u8, allN:[]u8, allT:[]u8, OUT:[]u8)void {
  let TU:[]u8=z_alloc(16);
  let W2:[]u8=z_alloc(8432);
  let ncand:i32=0;
  let ninst:i32=0;
  let w:i32=0;
  while(w<12){
    if(trig_bound(W,w)==0 && get32(W,5808+w*16+4)>0){
      ncand=ncand+1;
      emit("CAND w="); emit(i32s(w));
      emit(" mtch="); emit(i32s(get32(W,5808+w*16+4)));
      // Tentative grounding on a copy.
      state_copy(W,W2);
      let k:i32=op_free(W2);
      if(k>=0){
        reground(W2,w,k,seen,TU);
        let ab:i32=test_acc(W,allU,allN,allT);
        let aw:i32=test_acc(W2,allU,allN,allT);
        emit(" acc_base="); emit(i32s(ab));
        emit(" acc_with="); emit(i32s(aw));
        if(aw<ab){
          emit(" REJECT(ii-fail)\n");
        } else {
          // (i) cross-position probe.
          let ps:i32=train_pos(W,w,seen,TU);
          let pp:i32=0;
          if(ps==0){ pp=1; }
          emit(" p*="); emit(i32s(ps));
          emit(" p'="); emit(i32s(pp));
          // Find first training episode with w at ps.
          let be:i32=-1;
          let s:i32=0;
          while(s<seen && be<0){
            let n0:i32=get32(allN,s*4);
            let j:i32=0;
            while(j<n0){
              if(get32(allU,(s*4+j)*4)==w && j==ps){ be=s; j=n0; }
              j=j+1;
            }
            s=s+1;
          }
          let probe_ok:i32=0;
          if(be>=0){
            // Build U' by moving w from ps to pp.
            let n0:i32=get32(allN,be*4);
            let tmp:[]u8=z_alloc(16);
            let ti:i32=0;
            let j:i32=0;
            while(j<n0){
              if(j!=ps){ set32(tmp,ti*4,get32(allU,(be*4+j)*4)); ti=ti+1; }
              j=j+1;
            }
            let U2:[]u8=z_alloc(16);
            j=0;
            while(j<pp){ set32(U2,j*4,get32(tmp,j*4)); j=j+1; }
            set32(U2,pp*4,w);
            while(j<n0-1){ set32(U2,(j+1)*4,get32(tmp,j*4)); j=j+1; }
            // T' via oracle on the same object.
            let ep:[]u8=z_alloc(64);
            let kk:i32=0;
            while(kk<64){ ep[kk]=eps[be*64+kk]; kk=kk+1; }
            let Tp:i32=world_T(ep,U2,n0);
            let Pp:i32=interpret(W2,U2,n0);
            emit(" probe_T'="); emit(i32s(Tp));
            emit(" probe_P="); emit(i32s(Pp));
            if(Pp==Tp){ probe_ok=1; }
          }
          // Single-position correctness on V at ps (for fallback).
          let C:[]u8=z_alloc(4);
          let pos_ok:i32=check_pos(W2,w,ps,allU,allN,allT,C);
          emit(" V_at_p*="); emit(i32s(get32(C,0)));
          emit(" pos_ok="); emit(i32s(pos_ok));
          if(probe_ok==1 && pos_ok==1){
            // Strict (i) passes: install unrestricted.
            let kr:i32=op_free(W);
            reground(W,w,kr,seen,TU);
            set32(W,8400+kr*4,0);
            ninst=ninst+1;
            emit(" INSTALL(strict,posmask=0)\n");
          } else if(pos_ok==1){
            // Fallback: install with positional restriction.
            let kr:i32=op_free(W);
            reground(W,w,kr,seen,TU);
            set32(W,8400+kr*4,1<<ps);
            ninst=ninst+1;
            emit(" INSTALL(fallback,posmask="); emit(i32s(1<<ps)); emit(")\n");
          } else {
            emit(" REJECT(i-fail)\n");
          }
        }
      } else {
        emit(" SKIP(no free slot)\n");
      }
    }
    w=w+1;
  }
  set32(OUT,0,ncand);
  set32(OUT,4,ninst);
  return;
}

fn main()i32 {
  let eps:[]u8=z_alloc(126*64);
  let st:[]u8=z_alloc(8);
  set32(st,0,SEED());
  set32(st,4,0);
  if(FAM()==0){
    gen_episodes(eps,st);
  } else {
    gen_episodes_fam(eps,st,FAM());
  }
  // Recover units/targets for all 120.
  let allU:[]u8=z_alloc(120*16);
  let allN:[]u8=z_alloc(120*4);
  let allT:[]u8=z_alloc(120*4);
  let e:i32=0;
  while(e<120){
    let U:[]u8=z_alloc(16);
    let R:[]u8=z_alloc(8);
    recover_ep(eps,e,U,R);
    let n:i32=get32(R,0);
    let T:i32=get32(R,4);
    set32(allN,e*4,n);
    set32(allT,e*4,T);
    let j:i32=0;
    while(j<4){
      if(j<n){ set32(allU,(e*4+j)*4,get32(U,j*4)); } else { set32(allU,(e*4+j)*4,-1); }
      j=j+1;
    }
    e=e+1;
  }
  // Train.
  let W:[]u8=z_alloc(8432);
  let i:i32=0;
  while(i<8432){ W[i]=0; i=i+1; }
  let TU:[]u8=z_alloc(16);
  let seen:i32=0;
  e=0;
  while(e<100){
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let U:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<n){ set32(U,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    let P0:i32=baseline(W,U,n);
    learn_keep(W,U,n,T,seen);
    learn_event(W,U,n,T);
    if(P0!=T){ learn_update(W,U,n,T); }
    seen=seen+1;
    e=e+1;
  }
  emit("TRAINED seen="); emit(i32s(seen)); emit("\n");
  // Behavioral validation.
  let OUT:[]u8=z_alloc(8);
  validate(W,seen,eps,allU,allN,allT,OUT);
  emit("VALIDATION candidates="); emit(i32s(get32(OUT,0)));
  emit(" installed="); emit(i32s(get32(OUT,4))); emit("\n");
  // Test.
  let acc:i32=test_acc(W,allU,allN,allT);
  emit("TEST_ACC="); emit(i32s(acc)); emit("/20\n");
  // T1: episodes 109..111.
  let t1:i32=0;
  e=109;
  while(e<112){
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let U:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<n){ set32(U,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    if(interpret(W,U,n)==T){ t1=t1+1; }
    e=e+1;
  }
  emit("T1="); emit(i32s(t1)); emit("/3\n");
  // F1: OPREC + T1.
  let f1:i32=0;
  let k:i32=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==1){
      let trig:i32=get32(W,5616+k*24);
      let sig:i32=get32(W,5616+k*24+8);
      let ca:i32=get32(W,5616+k*24+16);
      let sup:i32=get32(W,5616+k*24+12);
      let pm:i32=get32(W,8400+k*4);
      emit("OPREC k="); emit(i32s(k));
      emit(" trig="); emit(i32s(trig));
      emit(" sig="); emit(i32s(sig));
      emit(" created="); emit(i32s(ca));
      emit(" sup="); emit(i32s(sup));
      emit(" posmask="); emit(i32s(pm)); emit("\n");
      if(sig==0 && ca>0 && sup>=4 && t1==3){ f1=1; }
    }
    k=k+1;
  }
  emit("F1="); emit(i32s(f1)); emit("\n");
  // F2: learner beats frozen rote baseline on T1.
  let t1b:i32=0;
  e=109;
  while(e<112){
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let U:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<n){ set32(U,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    if(baseline(W,U,n)==T){ t1b=t1b+1; }
    e=e+1;
  }
  let f2:i32=0;
  if(t1>t1b){ f2=1; }
  emit("F2="); emit(i32s(f2)); emit(" (T1="); emit(i32s(t1));
  emit(" base="); emit(i32s(t1b)); emit(")\n");
  // F4: ablation.
  let Wd:[]u8=z_alloc(8432);
  i=0;
  while(i<8432){ Wd[i]=W[i]; i=i+1; }
  k=0;
  while(k<8){
    set32(Wd,5616+k*24+20,0);
    set32(Wd,8400+k*4,0);
    k=k+1;
  }
  let accd:i32=test_acc(Wd,allU,allN,allT);
  let t1d:i32=0;
  e=109;
  while(e<112){
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let U:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<n){ set32(U,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    if(interpret(Wd,U,n)==T){ t1d=t1d+1; }
    e=e+1;
  }
  let f4:i32=0;
  if(t1d<t1 && accd<acc){ f4=1; }
  emit("F4="); emit(i32s(f4)); emit(" (abl T1="); emit(i32s(t1d));
  emit(" acc="); emit(i32s(accd)); emit(")\n");
  // F5: bounded scope.
  let f5:i32=0;
  if(acc>=16 && t1==3){ f5=1; }
  emit("F5="); emit(i32s(f5)); emit("\n");
  // White-box: installed triggers and posmasks.
  emit("INSTALLED:");
  k=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==1){
      emit(" w="); emit(i32s(get32(W,5616+k*24)));
      emit("(pm="); emit(i32s(get32(W,8400+k*4))); emit(")");
    }
    k=k+1;
  }
  emit("\n");
  // Verdict.
  let v:i32=0;
  if(f1==1 && f2==1 && f4==1 && f5==1){ v=1; }
  if(v==1){ emit("VERDICT OPSCOPE-R1R4-PASS\n"); } else { emit("VERDICT OPSCOPE-R1R4-FAIL\n"); }
  return 0;
}

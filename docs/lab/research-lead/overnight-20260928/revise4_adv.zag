// revise3.zag — H-REVISE3: repaired versioned conditional dispatch.
//
// Repairs the three H-REVISE2 red-team failure classes (REVISE2_ADV_RESULT.md):
//   F-RV1: version store is now an appendable condition list (up to 4
//          revision slots). vs_revise APPENDS; never overwrites. Dispatch
//          checks slots most-recent-first (stated rule).
//   F-RV2: diagnosis scores ALL discriminating positions:
//            +1 output-relevance (candidate byte in expected output),
//            +1 program-consistency (candidate position read by P1,
//               from the extraction index sequence).
//          Tie-break: lowest position. P1 is discovered BEFORE final
//          diagnosis so the consistency signal is available. This is a
//          stated heuristic, not guaranteed causal identification.
//   F-RV3: bounds-respecting length guard. A passing input shorter than
//          position p is vacuous at p (skipped), not vetoing.
//
// Prereg: PREREG_REVISE3.md (54790d0d2), frozen before this file.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (verbatim from revise2.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE v3 (appendable condition list) ============
// VS3 layout:
//   0: vcount (i32)
//   4: nnodes0 (i32), 8: prog0[48]  (bytes 8..56)
//   56: slot1: cond_pos(4), cond_val(4), nnodes(4), prog[48] -> 56..116
//   116: slot2 -> 116..176 ; 176: slot3 -> 176..236 ; 236: slot4 -> 236..296
// Max 4 revisions. Dispatch: most-recent-first (newest revision wins).
fn vs3_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 4, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[8+i]=p0[i]; i=i+1; }
  return;
}
// Returns 1 on append, -1 if the store is full (explicit refusal).
// On full: emits VS3FULL warning (explicit policy, not silent drop).
// Policy: REFUSE-WITH-WARNING. At most 4 chained revisions. Earlier
// revisions are never evicted. Queries on refused conditions fall
// through to P0. (H-REVISE4 R2: explicit capacity policy.)
fn vs3_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)i32 {
  let vc:i32=get32(VS, 0);
  if(vc>=4){
    emit("VS3FULL: revision refused; store at capacity (4); earlier revisions intact; queries on refused condition fall through to P0\n");
    return -1;
  }
  let so:i32=56+vc*60;
  set32(VS, so, cpos);
  set32(VS, so+4, cval);
  set32(VS, so+8, nn1);
  let i:i32=0;
  while(i<nn1*3){ VS[so+12+i]=p1[i]; i=i+1; }
  set32(VS, 0, vc+1);
  return 1;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs3_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs3_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*60;
    let cp:i32=get32(VS, so);
    let cv:i32=get32(VS, so+4);
    if(inp.len>cp && (inp[cp] as i32)==cv){
      return vs3_apply_one(VS, so+12, so+8, inp, out);
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
fn vs3_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,4);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[8+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  let vc:i32=get32(VS,0);
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*60;
    emit("VSTORE slot"); emit(i32s(s));
    emit(" cond pos="); emit(i32s(get32(VS,so)));
    emit(" val="); emit(i32s(get32(VS,so+4)));
    let nn:i32=get32(VS,so+8);
    emit(" nnodes="); emit(i32s(nn)); emit(" prog=");
    let pp:[]u8=z_alloc(48);
    i=0;
    while(i<nn*3){ pp[i]=VS[so+12+i]; i=i+1; }
    prog_emit(pp, nn); emit("\n");
    s=s+1;
  }
  return;
}

// ============ SCORED DIAGNOSIS (R2: all positions, R3: bounds-respecting) ============
// For each position p in fail: bounds-respecting discrimination test
// (passing inputs shorter than p are vacuous, skipped). Score each
// discriminating (p,v):
//   +1 output-relevance: v appears in fail_out (expected output)
//   +1 program-consistency: p appears in seq (extraction index sequence,
//      the positions the discovered program reads)
// Returns best_p*1000+best_v, tie-break lowest p, or -1 if none.
// If multiple candidates tie at the top score, returns -2 (AMBIGUOUS):
// the heuristic cannot distinguish, so the caller must withhold rather
// than guess by position. (H-REVISE4 R1: tie-aware diagnosis.)
// No byte-value literals; all compared values come from the data.
fn diagnose_scored(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8, fail_out:[]u8, seq:[]u8, sl:i32)i32 {
  let best:i32=-1;
  let best_score:i32=-1;
  let best_count:i32=0;
  let p:i32=0;
  while(p<fail.len){
    let v:i32=fail[p] as i32;
    let discrim:i32=1;
    let i:i32=0;
    while(i<npass){
      let plen:i32=get32(pdesc, i*8+4);
      if(plen>p){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
      }
      i=i+1;
    }
    if(discrim==1){
      let score:i32=0;
      let k:i32=0;
      while(k<fail_out.len){
        if((fail_out[k] as i32)==v){ score=score+1; break; }
        k=k+1;
      }
      k=0;
      while(k<sl){
        if(get32(seq, k*4)==p){ score=score+1; break; }
        k=k+1;
      }
      emit("DIAGNOSE candidate pos="); emit(i32s(p));
      emit(" val="); emit(i32s(v));
      emit(" score="); emit(i32s(score)); emit("\n");
      if(score>best_score){
        best_score=score;
        best=p*1000+v;
        best_count=1;
      } else {
        if(score==best_score){
          best_count=best_count+1;
        }
      }
    }
    p=p+1;
  }
  if(best_count>1){
    emit("AMBIGUOUS: "); emit(i32s(best_count)); emit(" candidates tie at score ");
    emit(i32s(best_score)); emit("; revision withheld (heuristic cannot distinguish)\n");
    return -2;
  }
  return best;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ ADVERSARY MAIN: X-RV4-1..X-RV4-4 ============
// Mechanism lines 1-421 are byte-identical to revise4.zag.
// Only main() is replaced. Pure Zag. No Python.
fn main()i32 {
  emit("=== H-REVISE4 RED TEAM (adversary) ===\n");
  let npass_total:i32=0;
  let ntest_total:i32=0;

  // ---- Shared fixtures ----
  // P0 = broadcast-last [N C1 SUB], hand-set exactly as Phase J.
  let p0:[]u8=z_alloc(48);
  p0[0]=1; p0[1]=255; p0[2]=255;
  p0[3]=3; p0[4]=255; p0[5]=255;
  p0[6]=6; p0[7]=0; p0[8]=1;
  let in0:[]u8="abc"; let in1:[]u8="def";
  let in2:[]u8="ghi"; let in3:[]u8="jkl";
  let D:[]u8=z_alloc(256);
  let pdesc:[]u8=z_alloc(4*8);
  let D_off:i32=0;
  set32(pdesc, 0, D_off); set32(pdesc, 4, dcopy(D, D_off, in0)); D_off=D_off+in0.len;
  set32(pdesc, 8, D_off); set32(pdesc, 12, dcopy(D, D_off, in1)); D_off=D_off+in1.len;
  set32(pdesc, 16, D_off); set32(pdesc, 20, dcopy(D, D_off, in2)); D_off=D_off+in2.len;
  set32(pdesc, 24, D_off); set32(pdesc, 28, dcopy(D, D_off, in3)); D_off=D_off+in3.len;

  // ============ X-RV4-1: unique wrong top ============
  emit("\n--- X-RV4-1: unique wrong top (evades tie protection) ---\n");
  emit("Hidden truth: IF input[2]=='y' (121) THEN broadcast-first ELSE broadcast-last\n");
  let VS1:[]u8=z_alloc(512);
  vs3_init(VS1, p0, 3);
  let f1:[]u8="zqy"; let fo1:[]u8="zzz";
  let o1:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VS1, f1, o1)==1 && streq(o1[0..3], fo1)==1){
    emit("X1 SETUP FAIL: not a counterexample\n");
  } else {
    emit("X1 counterexample confirmed: zqy->zzz predicted ");
    emit(o1[0..3]); emit("\n");
    npass_total=npass_total+1;
  }
  let S1:[]u8=z_alloc(4096);
  let sx1:i32=pextract(f1, fo1, S1[0..64]);
  ntest_total=ntest_total+1;
  if(sx1==3){
    emit("X1 pextract ok (seq=[0,0,0], sl=3)\n");
    npass_total=npass_total+1;
  } else { emit("X1 pextract UNEXPECTED\n"); }
  let desc1:[]u8=z_alloc(12);
  set32(desc1, 0, 0); set32(desc1, 4, sx1); set32(desc1, 8, f1.len);
  let seq1:[]u8=S1[0..64];
  let dr1:i32=diagnose_scored(D, pdesc, 4, f1, fo1, seq1, sx1);
  ntest_total=ntest_total+1;
  if(dr1==122){
    emit("X1 DIAGNOSIS UNIQUE WRONG TOP (0,122); causal is (2,121); NO AMBIGUOUS\n");
    npass_total=npass_total+1;
  } else {
    emit("X1 attack fails: expected unique (0,122), got ");
    emit(i32s(dr1)); emit("\n");
  }
  let p1:[]u8=z_alloc(48);
  let nn1:i32=discover(S1, desc1, 1, p1);
  ntest_total=ntest_total+1;
  if(nn1<0){ emit("X1 FATAL discover P1\n"); return 1; }
  npass_total=npass_total+1;
  let dpos1:i32=dr1/1000;
  let dval1:i32=dr1-dpos1*1000;
  let rc1:i32=vs3_revise(VS1, dpos1, dval1, p1, nn1);
  ntest_total=ntest_total+1;
  if(rc1==1 && get32(VS1,0)==1){
    emit("X1 WRONG revision appended (vcount=1); tie protection evaded\n");
    npass_total=npass_total+1;
  } else {
    emit("X1 attack fails: revision not appended rc=");
    emit(i32s(rc1)); emit("\n");
  }
  let h1a:[]u8="aqy"; let e1a:[]u8="aaa";
  let h1b:[]u8="zqw"; let e1b:[]u8="www";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS1, h1a, o1)==1 && streq(o1[0..3], e1a)==1){
    emit("X1 held-out aqy->aaa UNEXPECTED PASS\n");
  } else {
    emit("X1 held-out aqy->aaa FAILS; predicted ");
    emit(o1[0..3]); emit(" (truth: aaa)\n");
    npass_total=npass_total+1;
  }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS1, h1b, o1)==1 && streq(o1[0..3], e1b)==1){
    emit("X1 held-out zqw->www UNEXPECTED PASS\n");
  } else {
    emit("X1 held-out zqw->www FAILS; predicted ");
    emit(o1[0..3]); emit(" (truth: www)\n");
    npass_total=npass_total+1;
  }

  // ============ X-RV4-2: AMBIGUOUS liveness ============
  emit("\n--- X-RV4-2: AMBIGUOUS liveness (Phase J fixture) ---\n");
  let VS2:[]u8=z_alloc(512);
  vs3_init(VS2, p0, 3);
  let f2:[]u8="xqy"; let fo2:[]u8="xqy";
  let S2:[]u8=z_alloc(4096);
  let sx2:i32=pextract(f2, fo2, S2[0..64]);
  let seq2:[]u8=S2[0..64];
  let dr2:i32=diagnose_scored(D, pdesc, 4, f2, fo2, seq2, sx2);
  ntest_total=ntest_total+1;
  if(dr2==-2){
    emit("X2 withhold confirmed: AMBIGUOUS (-2) on tie fixture\n");
    npass_total=npass_total+1;
  } else { emit("X2 UNEXPECTED dr="); emit(i32s(dr2)); emit("\n"); }
  let dr2b:i32=diagnose_scored(D, pdesc, 4, f2, fo2, seq2, sx2);
  ntest_total=ntest_total+1;
  if(dr2b==-2){
    emit("X2 second call still -2: no recovery path; legitimate revision (2,121) permanently strandable\n");
    npass_total=npass_total+1;
  } else { emit("X2 UNEXPECTED dr2b="); emit(i32s(dr2b)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(get32(VS2,0)==0){
    emit("X2 vcount still 0: nothing appended (documented honest behavior)\n");
    npass_total=npass_total+1;
  } else { emit("X2 UNEXPECTED vcount\n"); }

  // ============ X-RV4-3: capacity wall (5 genuine revisions) ============
  emit("\n--- X-RV4-3: capacity wall (5 genuine revisions) ---\n");
  let VS3:[]u8=z_alloc(512);
  vs3_init(VS3, p0, 3);
  let S3:[]u8=z_alloc(4096);
  let soff3:i32=0;
  let o3:[]u8=z_alloc(16);
  let desc:[]u8=z_alloc(12);

  // R1: ("xab"->"xxx") -> (0,120)
  let fR1:[]u8="xab"; let foR1:[]u8="xxx";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR1, o3)==1 && streq(o3[0..3], foR1)==1){
    emit("X3 R1 SETUP FAIL: not a counterexample\n");
  } else { emit("X3 R1 counterexample ok\n"); npass_total=npass_total+1; }
  let sxR1:i32=pextract(fR1, foR1, S3[soff3..soff3+64]);
  set32(desc, 0, soff3); set32(desc, 4, sxR1); set32(desc, 8, fR1.len);
  let seqR1:[]u8=S3[soff3..soff3+64];
  soff3=soff3+64;
  let drR1:i32=diagnose_scored(D, pdesc, 4, fR1, foR1, seqR1, sxR1);
  ntest_total=ntest_total+1;
  if(drR1==120){ emit("X3 R1 diagnose (0,120) unique\n"); npass_total=npass_total+1; }
  else { emit("X3 R1 UNEXPECTED dr="); emit(i32s(drR1)); emit("\n"); }
  let pR1:[]u8=z_alloc(48);
  let nnR1:i32=discover(S3, desc, 1, pR1);
  if(nnR1<0){ emit("X3 FATAL discover R1\n"); return 1; }
  let rcR1:i32=vs3_revise(VS3, drR1/1000, drR1-(drR1/1000)*1000, pR1, nnR1);
  ntest_total=ntest_total+1;
  if(rcR1==1 && get32(VS3,0)==1){ emit("X3 R1 appended vcount=1\n"); npass_total=npass_total+1; }
  else { emit("X3 R1 APPEND FAIL\n"); }
  let hR1:[]u8="xqw"; let eR1:[]u8="xxx";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, hR1, o3)==1 && streq(o3[0..3], eR1)==1){
    emit("X3 R1 held-out xqw->xxx PASS\n"); npass_total=npass_total+1;
  } else { emit("X3 R1 held-out FAIL\n"); }

  // R2: ("ayz"->"yyy") -> (1,121)
  let fR2:[]u8="ayz"; let foR2:[]u8="yyy";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR2, o3)==1 && streq(o3[0..3], foR2)==1){
    emit("X3 R2 SETUP FAIL: not a counterexample\n");
  } else { emit("X3 R2 counterexample ok\n"); npass_total=npass_total+1; }
  let sxR2:i32=pextract(fR2, foR2, S3[soff3..soff3+64]);
  set32(desc, 0, soff3); set32(desc, 4, sxR2); set32(desc, 8, fR2.len);
  let seqR2:[]u8=S3[soff3..soff3+64];
  soff3=soff3+64;
  let drR2:i32=diagnose_scored(D, pdesc, 4, fR2, foR2, seqR2, sxR2);
  ntest_total=ntest_total+1;
  if(drR2==1121){ emit("X3 R2 diagnose (1,121) unique\n"); npass_total=npass_total+1; }
  else { emit("X3 R2 UNEXPECTED dr="); emit(i32s(drR2)); emit("\n"); }
  let pR2:[]u8=z_alloc(48);
  let nnR2:i32=discover(S3, desc, 1, pR2);
  if(nnR2<0){ emit("X3 FATAL discover R2\n"); return 1; }
  let rcR2:i32=vs3_revise(VS3, drR2/1000, drR2-(drR2/1000)*1000, pR2, nnR2);
  ntest_total=ntest_total+1;
  if(rcR2==1 && get32(VS3,0)==2){ emit("X3 R2 appended vcount=2\n"); npass_total=npass_total+1; }
  else { emit("X3 R2 APPEND FAIL\n"); }
  let hR2:[]u8="byz"; let eR2:[]u8="yyy";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, hR2, o3)==1 && streq(o3[0..3], eR2)==1){
    emit("X3 R2 held-out byz->yyy PASS\n"); npass_total=npass_total+1;
  } else { emit("X3 R2 held-out FAIL\n"); }

  // R3: ("zbq"->"zzz") -> (0,122)
  let fR3:[]u8="zbq"; let foR3:[]u8="zzz";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR3, o3)==1 && streq(o3[0..3], foR3)==1){
    emit("X3 R3 SETUP FAIL: not a counterexample\n");
  } else { emit("X3 R3 counterexample ok\n"); npass_total=npass_total+1; }
  let sxR3:i32=pextract(fR3, foR3, S3[soff3..soff3+64]);
  set32(desc, 0, soff3); set32(desc, 4, sxR3); set32(desc, 8, fR3.len);
  let seqR3:[]u8=S3[soff3..soff3+64];
  soff3=soff3+64;
  let drR3:i32=diagnose_scored(D, pdesc, 4, fR3, foR3, seqR3, sxR3);
  ntest_total=ntest_total+1;
  if(drR3==122){ emit("X3 R3 diagnose (0,122) unique\n"); npass_total=npass_total+1; }
  else { emit("X3 R3 UNEXPECTED dr="); emit(i32s(drR3)); emit("\n"); }
  let pR3:[]u8=z_alloc(48);
  let nnR3:i32=discover(S3, desc, 1, pR3);
  if(nnR3<0){ emit("X3 FATAL discover R3\n"); return 1; }
  let rcR3:i32=vs3_revise(VS3, drR3/1000, drR3-(drR3/1000)*1000, pR3, nnR3);
  ntest_total=ntest_total+1;
  if(rcR3==1 && get32(VS3,0)==3){ emit("X3 R3 appended vcount=3\n"); npass_total=npass_total+1; }
  else { emit("X3 R3 APPEND FAIL\n"); }
  let hR3:[]u8="zbw"; let eR3:[]u8="zzz";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, hR3, o3)==1 && streq(o3[0..3], eR3)==1){
    emit("X3 R3 held-out zbw->zzz PASS\n"); npass_total=npass_total+1;
  } else { emit("X3 R3 held-out FAIL\n"); }

  // R4: ("mnp"->"mmm") -> (0,109)
  let fR4:[]u8="mnp"; let foR4:[]u8="mmm";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR4, o3)==1 && streq(o3[0..3], foR4)==1){
    emit("X3 R4 SETUP FAIL: not a counterexample\n");
  } else { emit("X3 R4 counterexample ok\n"); npass_total=npass_total+1; }
  let sxR4:i32=pextract(fR4, foR4, S3[soff3..soff3+64]);
  set32(desc, 0, soff3); set32(desc, 4, sxR4); set32(desc, 8, fR4.len);
  let seqR4:[]u8=S3[soff3..soff3+64];
  soff3=soff3+64;
  let drR4:i32=diagnose_scored(D, pdesc, 4, fR4, foR4, seqR4, sxR4);
  ntest_total=ntest_total+1;
  if(drR4==109){ emit("X3 R4 diagnose (0,109) unique\n"); npass_total=npass_total+1; }
  else { emit("X3 R4 UNEXPECTED dr="); emit(i32s(drR4)); emit("\n"); }
  let pR4:[]u8=z_alloc(48);
  let nnR4:i32=discover(S3, desc, 1, pR4);
  if(nnR4<0){ emit("X3 FATAL discover R4\n"); return 1; }
  let rcR4:i32=vs3_revise(VS3, drR4/1000, drR4-(drR4/1000)*1000, pR4, nnR4);
  ntest_total=ntest_total+1;
  if(rcR4==1 && get32(VS3,0)==4){ emit("X3 R4 appended vcount=4 (store full)\n"); npass_total=npass_total+1; }
  else { emit("X3 R4 APPEND FAIL\n"); }
  let hR4:[]u8="mqr"; let eR4:[]u8="mmm";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, hR4, o3)==1 && streq(o3[0..3], eR4)==1){
    emit("X3 R4 held-out mqr->mmm PASS\n"); npass_total=npass_total+1;
  } else { emit("X3 R4 held-out FAIL\n"); }

  // R5: ("qrs"->"qqq") -> diagnosis WOULD be unique (0,113), but refused
  let fR5:[]u8="qrs"; let foR5:[]u8="qqq";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR5, o3)==1 && streq(o3[0..3], foR5)==1){
    emit("X3 R5 SETUP FAIL: not a counterexample\n");
  } else {
    emit("X3 R5 genuine counterexample confirmed (falls through to P0)\n");
    npass_total=npass_total+1;
  }
  let sxR5:i32=pextract(fR5, foR5, S3[soff3..soff3+64]);
  set32(desc, 0, soff3); set32(desc, 4, sxR5); set32(desc, 8, fR5.len);
  let seqR5:[]u8=S3[soff3..soff3+64];
  soff3=soff3+64;
  let drR5:i32=diagnose_scored(D, pdesc, 4, fR5, foR5, seqR5, sxR5);
  ntest_total=ntest_total+1;
  if(drR5==113){
    emit("X3 R5 diagnose (0,113) unique: the 5th revision is LEGITIMATE\n");
    npass_total=npass_total+1;
  } else { emit("X3 R5 UNEXPECTED dr="); emit(i32s(drR5)); emit("\n"); }
  let pR5:[]u8=z_alloc(48);
  let nnR5:i32=discover(S3, desc, 1, pR5);
  if(nnR5<0){ emit("X3 FATAL discover R5\n"); return 1; }
  let rcR5:i32=vs3_revise(VS3, drR5/1000, drR5-(drR5/1000)*1000, pR5, nnR5);
  ntest_total=ntest_total+1;
  if(rcR5==-1 && get32(VS3,0)==4){
    emit("X3 R5 REFUSED with -1 (explicit VS3FULL); vcount still 4\n");
    npass_total=npass_total+1;
  } else {
    emit("X3 R5 UNEXPECTED rc="); emit(i32s(rcR5)); emit("\n");
  }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR5, o3)==1 && streq(o3[0..3], foR5)==1){
    emit("X3 R5 query UNEXPECTED PASS\n");
  } else {
    emit("X3 R5 query qrs permanently wrong: predicted ");
    emit(o3[0..3]); emit(" (truth: qqq); no recourse\n");
    npass_total=npass_total+1;
  }
  // earlier revisions intact after refusal
  ntest_total=ntest_total+1;
  if(vs3_apply(VS3, fR1, o3)==1 && streq(o3[0..3], foR1)==1){
    emit("X3 earlier revision intact (xab->xxx still PASS)\n");
    npass_total=npass_total+1;
  } else { emit("X3 earlier revision CORRUPTED\n"); }

  emit("\n=== ADVERSARY RESULT: ");
  emit(i32s(npass_total)); emit("/");
  emit(i32s(ntest_total));
  emit(" attack checks behaved as predicted ===\n");
  if(npass_total==ntest_total){
    emit("ALL ATTACKS CONFIRMED\n");
    return 0;
  }
  emit("SOME ATTACK CHECKS DIVERGED (see above)\n");
  return 1;
}

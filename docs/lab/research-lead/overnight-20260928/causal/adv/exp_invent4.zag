// causal_learn.zag -- GENERIC causal hypothesis learner.
// Pure Zag. NO task-specific dynamics anywhere in this file.
// Machinery only: episodes, per-variable effects, conditional splits,
// ambiguity with explicit candidates, refutation, contests, temporal revision.
// Usage: causal_learn <obs.txt> <probe.txt>
// obs.txt:  T <t> <p> <l> | <a> | <nt> <np> <nl>   (cumulative per phase)
// probe.txt: Q <t> <p> <l> | <a>
// All mutable state lives in one workspace buffer W (Zag has no user globals).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn parse_int(b:[]u8, p:i32, val:[]u8)i32 {
  // parses decimal at b[p..]; returns new p; stores value in val[0..4]
  while(p<b.len && (b[p] as i32)<=32){p=p+1;}
  let v:i32=0;
  while(p<b.len && b[p]>=48 && b[p]<=57){
    v=v*10+((b[p] as i32)-48); p=p+1;
  }
  set32(val,0,v);
  return p;
}

// ============ constants (machinery, not dynamics) ============
fn vmax(v:i32)i32 {
  if(v==0){return 2;}
  return 1;
}
fn clampv(x:i32, v:i32)i32 {
  if(x<0){return 0;}
  if(x>vmax(v)){return vmax(v);}
  return x;
}
fn ST_ACTIVE()i32 { return 0; }
fn ST_AMBIG()i32 { return 1; }
fn ST_SUPER()i32 { return 2; }
fn ST_CONFL()i32 { return 3; }
fn EP_ACT()i32 { return 0; }
fn EP_SUP()i32 { return 1; }
fn FX_UNRES()i32 { return 0; }
fn FX_UNCH()i32 { return 1; }
fn FX_SET()i32 { return 2; }
fn FX_ADD()i32 { return 3; }

// ============ workspace layout ============
fn O_EP_S()i32 { return 0; }
fn O_EP_A()i32 { return 768; }
fn O_EP_NS()i32 { return 1024; }
fn O_EP_ST()i32 { return 1792; }
fn O_EP_SEQ()i32 { return 2048; }
fn O_EN_A()i32 { return 3072; }
fn O_EN_M()i32 { return 3136; }
fn O_EN_CV()i32 { return 3200; }
fn O_EN_ST()i32 { return 3392; }
fn O_EN_AMB()i32 { return 3456; }
fn O_EN_PAR()i32 { return 3520; }
fn O_EN_NE()i32 { return 3776; }
fn O_EN_EPS()i32 { return 3840; }
fn O_EN_FX()i32 { return 7936; }
fn O_EN_FP()i32 { return 8128; }
fn O_EN_SEQ()i32 { return 8320; }
fn O_CT_EN()i32 { return 8576; }
fn O_CT_S()i32 { return 8592; }
fn O_CT_NS()i32 { return 8640; }
fn O_CT_SUP()i32 { return 8736; }
fn O_CT_SEQ()i32 { return 8768; }
fn O_CT_RES()i32 { return 8896; }
fn O_CT_WIN()i32 { return 8912; }
fn O_NEP()i32 { return 8928; }
fn O_NENT()i32 { return 8932; }
fn O_NCT()i32 { return 8936; }
fn WSZ()i32 { return 8940; }

// scalar counters
fn nep(W:[]u8)i32 { return get32(W, O_NEP()); }
fn nep_set(W:[]u8, v:i32)void { set32(W, O_NEP(), v); return; }
fn nent(W:[]u8)i32 { return get32(W, O_NENT()); }
fn nent_set(W:[]u8, v:i32)void { set32(W, O_NENT(), v); return; }
fn nct(W:[]u8)i32 { return get32(W, O_NCT()); }
fn nct_set(W:[]u8, v:i32)void { set32(W, O_NCT(), v); return; }
// episodes
fn ep_s(W:[]u8, i:i32, v:i32)i32 { return W[O_EP_S()+i*3+v] as i32; }
fn ep_s_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_EP_S()+i*3+v]=x as u8; return; }
fn ep_a(W:[]u8, i:i32)i32 { return W[O_EP_A()+i] as i32; }
fn ep_a_set(W:[]u8, i:i32, x:i32)void { W[O_EP_A()+i]=x as u8; return; }
fn ep_ns(W:[]u8, i:i32, v:i32)i32 { return W[O_EP_NS()+i*3+v] as i32; }
fn ep_ns_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_EP_NS()+i*3+v]=x as u8; return; }
fn ep_st(W:[]u8, i:i32)i32 { return W[O_EP_ST()+i] as i32; }
fn ep_st_set(W:[]u8, i:i32, x:i32)void { W[O_EP_ST()+i]=x as u8; return; }
fn ep_seq(W:[]u8, i:i32)i32 { return get32(W, O_EP_SEQ()+i*4); }
fn ep_seq_set(W:[]u8, i:i32, x:i32)void { set32(W, O_EP_SEQ()+i*4, x); return; }
// entries
fn en_a(W:[]u8, i:i32)i32 { return W[O_EN_A()+i] as i32; }
fn en_a_set(W:[]u8, i:i32, x:i32)void { W[O_EN_A()+i]=x as u8; return; }
fn en_mask(W:[]u8, i:i32)i32 { return W[O_EN_M()+i] as i32; }
fn en_mask_set(W:[]u8, i:i32, x:i32)void { W[O_EN_M()+i]=x as u8; return; }
fn en_cv(W:[]u8, i:i32, v:i32)i32 { return W[O_EN_CV()+i*3+v] as i32; }
fn en_cv_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_EN_CV()+i*3+v]=x as u8; return; }
fn en_st(W:[]u8, i:i32)i32 { return W[O_EN_ST()+i] as i32; }
fn en_st_set(W:[]u8, i:i32, x:i32)void { W[O_EN_ST()+i]=x as u8; return; }
fn en_amb(W:[]u8, i:i32)i32 { return W[O_EN_AMB()+i] as i32; }
fn en_amb_set(W:[]u8, i:i32, x:i32)void { W[O_EN_AMB()+i]=x as u8; return; }
fn en_par(W:[]u8, i:i32)i32 { return get32(W, O_EN_PAR()+i*4); }
fn en_par_set(W:[]u8, i:i32, x:i32)void { set32(W, O_EN_PAR()+i*4, x); return; }
fn en_neps(W:[]u8, i:i32)i32 { return W[O_EN_NE()+i] as i32; }
fn en_neps_set(W:[]u8, i:i32, x:i32)void { W[O_EN_NE()+i]=x as u8; return; }
fn en_ep(W:[]u8, i:i32, k:i32)i32 { return W[O_EN_EPS()+i*64+k] as i32; }
fn en_ep_set(W:[]u8, i:i32, k:i32, x:i32)void { W[O_EN_EPS()+i*64+k]=x as u8; return; }
fn en_fx(W:[]u8, i:i32, v:i32)i32 { return W[O_EN_FX()+i*3+v] as i32; }
fn en_fx_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_EN_FX()+i*3+v]=x as u8; return; }
fn en_fp(W:[]u8, i:i32, v:i32)i32 { return (W[O_EN_FP()+i*3+v] as i32)-4; }
fn en_fp_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_EN_FP()+i*3+v]=(x+4) as u8; return; }
fn en_seq(W:[]u8, i:i32)i32 { return get32(W, O_EN_SEQ()+i*4); }
fn en_seq_set(W:[]u8, i:i32, x:i32)void { set32(W, O_EN_SEQ()+i*4, x); return; }
// contests
fn ct_en(W:[]u8, i:i32)i32 { return W[O_CT_EN()+i] as i32; }
fn ct_en_set(W:[]u8, i:i32, x:i32)void { W[O_CT_EN()+i]=x as u8; return; }
fn ct_s(W:[]u8, i:i32, v:i32)i32 { return W[O_CT_S()+i*3+v] as i32; }
fn ct_s_set(W:[]u8, i:i32, v:i32, x:i32)void { W[O_CT_S()+i*3+v]=x as u8; return; }
fn ct_ns(W:[]u8, i:i32, o:i32, v:i32)i32 { return W[O_CT_NS()+i*6+o*3+v] as i32; }
fn ct_ns_set(W:[]u8, i:i32, o:i32, v:i32, x:i32)void { W[O_CT_NS()+i*6+o*3+v]=x as u8; return; }
fn ct_sup(W:[]u8, i:i32, o:i32)i32 { return W[O_CT_SUP()+i*2+o] as i32; }
fn ct_sup_set(W:[]u8, i:i32, o:i32, x:i32)void { W[O_CT_SUP()+i*2+o]=x as u8; return; }
fn ct_seq(W:[]u8, i:i32, o:i32)i32 { return get32(W, O_CT_SEQ()+i*8+o*4); }
fn ct_seq_set(W:[]u8, i:i32, o:i32, x:i32)void { set32(W, O_CT_SEQ()+i*8+o*4, x); return; }
fn ct_res(W:[]u8, i:i32)i32 { return W[O_CT_RES()+i] as i32; }
fn ct_res_set(W:[]u8, i:i32, x:i32)void { W[O_CT_RES()+i]=x as u8; return; }
fn ct_win(W:[]u8, i:i32)i32 { return W[O_CT_WIN()+i] as i32; }
fn ct_win_set(W:[]u8, i:i32, x:i32)void { W[O_CT_WIN()+i]=x as u8; return; }

// ============ provenance ============
fn emit_cond(W:[]u8, i:i32)void {
  let m:i32=en_mask(W,i);
  let v:i32=0;
  let first:i32=1;
  while(v<3){
    if((m&(1<<v))!=0){
      if(first==0){emit("&");}
      emit("s"); e64(v); emit("="); e64(en_cv(W,i,v));
      first=0;
    }
    v=v+1;
  }
  if(first==1){emit("any");}
  return;
}
fn emit_fx(W:[]u8, i:i32)void {
  let v:i32=0;
  while(v<3){
    if(v>0){emit(",");}
    let c:i32=en_fx(W,i,v);
    if(c==FX_UNCH()){emit("v");e64(v);emit("=same");}
    else if(c==FX_SET()){emit("v");e64(v);emit(":=");e64(en_fp(W,i,v));}
    else if(c==FX_ADD()){emit("v");e64(v);emit("+=");e64(en_fp(W,i,v));}
    else {emit("v");e64(v);emit("=?");}
    v=v+1;
  }
  return;
}

// ============ parsing ============
// load obs file; returns number of T lines loaded
fn load_obs(W:[]u8, path:[]u8)i32 {
  let data:[]u8=_zag_read_file(path);
  let n:i32=0;
  let p:i32=0;
  let pv:[]u8=z_alloc(4);
  while(p<data.len){
    while(p<data.len && (data[p] as i32)<=32){p=p+1;}
    if(p>=data.len){break;}
    let ch:i32=data[p] as i32;
    if(ch==35){ // '#'
      while(p<data.len && data[p]!=10){p=p+1;}
      continue;
    }
    if(ch==84){ // 'T'
      p=p+1;
      p=parse_int(data,p,pv); let t:i32=get32(pv,0);
      p=parse_int(data,p,pv); let pr:i32=get32(pv,0);
      p=parse_int(data,p,pv); let l:i32=get32(pv,0);
      // skip '|' and whitespace
      while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
      p=parse_int(data,p,pv); let a:i32=get32(pv,0);
      while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
      p=parse_int(data,p,pv); let nt:i32=get32(pv,0);
      p=parse_int(data,p,pv); let npr:i32=get32(pv,0);
      p=parse_int(data,p,pv); let nl:i32=get32(pv,0);
      let i:i32=nep(W);
      ep_s_set(W,i,0,t); ep_s_set(W,i,1,pr); ep_s_set(W,i,2,l);
      ep_a_set(W,i,a);
      ep_ns_set(W,i,0,nt); ep_ns_set(W,i,1,npr); ep_ns_set(W,i,2,nl);
      ep_st_set(W,i,EP_ACT());
      ep_seq_set(W,i,n+1); // sequence number = order in file
      nep_set(W,i+1);
      n=n+1;
    } else {
      while(p<data.len && data[p]!=10){p=p+1;}
    }
  }
  return n;
}

// ============ entries ============
fn new_entry(W:[]u8, a:i32, mask:i32, parent:i32, seq:i32)i32 {
  let i:i32=nent(W);
  if(i>=64){return -1;}
  en_a_set(W,i,a); en_mask_set(W,i,mask);
  en_cv_set(W,i,0,0); en_cv_set(W,i,1,0); en_cv_set(W,i,2,0);
  en_st_set(W,i,ST_ACTIVE());
  en_amb_set(W,i,0);
  en_par_set(W,i,parent);
  en_neps_set(W,i,0);
  en_fx_set(W,i,0,FX_UNRES()); en_fx_set(W,i,1,FX_UNRES()); en_fx_set(W,i,2,FX_UNRES());
  en_fp_set(W,i,0,0); en_fp_set(W,i,1,0); en_fp_set(W,i,2,0);
  en_seq_set(W,i,seq);
  nent_set(W,i+1);
  return i;
}
fn entry_add_ep(W:[]u8, i:i32, e:i32)void {
  let k:i32=en_neps(W,i);
  en_ep_set(W,i,k,e);
  en_neps_set(W,i,k+1);
  return;
}
fn cond_matches(W:[]u8, i:i32, s0:i32, s1:i32, s2:i32)i32 {
  let m:i32=en_mask(W,i);
  if((m&1)!=0 && en_cv(W,i,0)!=s0){return 0;}
  if((m&2)!=0 && en_cv(W,i,1)!=s1){return 0;}
  if((m&4)!=0 && en_cv(W,i,2)!=s2){return 0;}
  return 1;
}
// most specific active/ambiguous entry for (a, state)
fn find_entry(W:[]u8, a:i32, s0:i32, s1:i32, s2:i32)i32 {
  let best:i32=-1;
  let bestsp:i32=-1;
  let i:i32=0;
  let n:i32=nent(W);
  while(i<n){
    let st:i32=en_st(W,i);
    if((st==ST_ACTIVE() || st==ST_AMBIG()) && en_a(W,i)==a && cond_matches(W,i,s0,s1,s2)==1){
      let m:i32=en_mask(W,i);
      let sp:i32=0;
      if((m&1)!=0){sp=sp+1;}
      if((m&2)!=0){sp=sp+1;}
      if((m&4)!=0){sp=sp+1;}
      if(sp>bestsp){bestsp=sp;best=i;}
    }
    i=i+1;
  }
  return best;
}

// ============ effect induction ============
// compute effects over a caller-supplied episode index list
// excl: entry index whose unresolved contests to exclude, or -1
// returns 1 if all resolved, stores fx/fp into entry i
fn usable(W:[]u8, e:i32, excl:i32)i32 {
  if(ep_st(W,e)==EP_SUP()){return 0;}
  if(excl>=0){
    let c:i32=0;
    while(c<nct(W)){
      if(ct_res(W,c)==0 && ct_en(W,c)==excl &&
         ct_s(W,c,0)==ep_s(W,e,0) && ct_s(W,c,1)==ep_s(W,e,1) && ct_s(W,c,2)==ep_s(W,e,2)){
        return 0;
      }
      c=c+1;
    }
  }
  return 1;
}
fn effects_over(W:[]u8, i:i32, list:[]u8, nl:i32, excl:i32)i32 {
  let v:i32=0;
  let allok:i32=1;
  while(v<3){
    let unch:i32=1;
    let setc:i32=1;
    let sc:i32=0;
    let cnt:i32=0;
    // addok per dd: dd=-2..2 excluding 0 -> slots 0..4
    let addv:[]u8=z_alloc(5);
    let dd:i32=-2; let sli:i32=0;
    while(dd<=2){
      if(dd==0){dd=dd+1;continue;}
      addv[sli]=1; sli=sli+1; dd=dd+1;
    }
    let k:i32=0;
    while(k<nl){
      let e:i32=list[k] as i32;
      if(usable(W,e,excl)==0){k=k+1;continue;}
      cnt=cnt+1;
      let sv:i32=ep_s(W,e,v);
      let nv:i32=ep_ns(W,e,v);
      if(cnt==1){sc=nv;}
      if(nv!=sv){unch=0;}
      if(nv!=sc){setc=0;}
      dd=-2; sli=0;
      while(dd<=2){
        if(dd==0){dd=dd+1;continue;}
        if(nv!=clampv(sv+dd,v)){addv[sli]=0;}
        sli=sli+1; dd=dd+1;
      }
      k=k+1;
    }
    if(cnt==0){
      en_fx_set(W,i,v,FX_UNRES());
      allok=0;
    } else if(unch==1){
      en_fx_set(W,i,v,FX_UNCH()); en_fp_set(W,i,v,0);
    } else if(setc==1){
      en_fx_set(W,i,v,FX_SET()); en_fp_set(W,i,v,sc);
    } else {
      // any surviving ADD candidate?
      let addd:i32=0; let addok:i32=0;
      dd=-2; sli=0;
      while(dd<=2){
        if(dd==0){dd=dd+1;continue;}
        if(addv[sli]==1 && addok==0){addok=1;addd=dd;}
        sli=sli+1; dd=dd+1;
      }
      if(addok==1){
        en_fx_set(W,i,v,FX_ADD()); en_fp_set(W,i,v,addd);
      } else {
        en_fx_set(W,i,v,FX_UNRES());
        allok=0;
      }
    }
    v=v+1;
  }
  return allok;
}
// entry's own active episode list -> tmp; returns count
fn entry_eps(W:[]u8, i:i32, tmp:[]u8)i32 {
  let k:i32=0; let n:i32=0;
  while(k<en_neps(W,i)){
    let e:i32=en_ep(W,i,k);
    if(ep_st(W,e)==EP_ACT()){tmp[n]=e as u8;n=n+1;}
    k=k+1;
  }
  return n;
}

// ============ split / ambiguity ============
// distinct values of s[v] among entry's ACTIVE episodes (excl contests); fill vals, return count
fn group_vals(W:[]u8, i:i32, v:i32, vals:[]u8)i32 {
  let n:i32=0;
  let k:i32=0;
  while(k<en_neps(W,i)){
    let e:i32=en_ep(W,i,k);
    if(usable(W,e,i)==0){k=k+1;continue;}
    let x:i32=ep_s(W,e,v);
    let j:i32=0; let seen:i32=0;
    while(j<n){if((vals[j] as i32)==x){seen=1;break;} j=j+1;}
    if(seen==0){vals[n]=x as u8;n=n+1;}
    k=k+1;
  }
  return n;
}
// is the subgroup (s[v]==g) fully resolved? (uses a scratch entry slot approach:
// compute into entry i itself is unsafe; instead compute into a temp list)
fn group_resolved(W:[]u8, i:i32, v:i32, g:i32, tmp:[]u8)i32 {
  // build list of episodes with s[v]==g
  let lst:[]u8=z_alloc(64);
  let nl:i32=0;
  let k:i32=0;
  while(k<en_neps(W,i)){
    let e:i32=en_ep(W,i,k);
    if(usable(W,e,i)==0){k=k+1;continue;}
    if(ep_s(W,e,v)==g){lst[nl]=e as u8;nl=nl+1;}
    k=k+1;
  }
  if(nl==0){return 1;}
  // compute effects into a throwaway by using entry i's fx slots temporarily?
  // NO: use a dedicated scratch -- we emulate by computing into tmp as fx codes.
  return fx_codes(W,lst,nl,i,tmp);
}
// compute fx codes into tmp[0..2] (codes) and tmp[3..5] (params+4); returns allok
fn fx_codes(W:[]u8, list:[]u8, nl:i32, excl:i32, tmp:[]u8)i32 {
  let v:i32=0;
  let allok:i32=1;
  while(v<3){
    let unch:i32=1; let setc:i32=1; let sc:i32=0; let cnt:i32=0;
    let addv:[]u8=z_alloc(5);
    let dd:i32=-2; let sli:i32=0;
    while(dd<=2){
      if(dd==0){dd=dd+1;continue;}
      addv[sli]=1; sli=sli+1; dd=dd+1;
    }
    let k:i32=0;
    while(k<nl){
      let e:i32=list[k] as i32;
      if(usable(W,e,excl)==0){k=k+1;continue;}
      cnt=cnt+1;
      let sv:i32=ep_s(W,e,v);
      let nv:i32=ep_ns(W,e,v);
      if(cnt==1){sc=nv;}
      if(nv!=sv){unch=0;}
      if(nv!=sc){setc=0;}
      dd=-2; sli=0;
      while(dd<=2){
        if(dd==0){dd=dd+1;continue;}
        if(nv!=clampv(sv+dd,v)){addv[sli]=0;}
        sli=sli+1; dd=dd+1;
      }
      k=k+1;
    }
    if(cnt==0){tmp[v]=FX_UNRES() as u8;allok=0;}
    else if(unch==1){tmp[v]=FX_UNCH() as u8;tmp[3+v]=(0+4) as u8;}
    else if(setc==1){tmp[v]=FX_SET() as u8;tmp[3+v]=(sc+4) as u8;}
    else {
      let addd:i32=0; let addok:i32=0;
      dd=-2; sli=0;
      while(dd<=2){
        if(dd==0){dd=dd+1;continue;}
        if(addv[sli]==1 && addok==0){addok=1;addd=dd;}
        sli=sli+1; dd=dd+1;
      }
      if(addok==1){tmp[v]=FX_ADD() as u8;tmp[3+v]=(addd+4) as u8;}
      else {tmp[v]=FX_UNRES() as u8;allok=0;}
    }
    v=v+1;
  }
  return allok;
}
// candidate check: does split on var v fully resolve every group?
fn split_candidate(W:[]u8, i:i32, v:i32, tmp:[]u8)i32 {
  let vals:[]u8=z_alloc(8);
  let ng:i32=group_vals(W,i,v,vals);
  if(ng<2){return 0;}
  let g:i32=0;
  while(g<ng){
    if(group_resolved(W,i,v,vals[g] as i32,tmp)==0){return 0;}
    g=g+1;
  }
  return 1;
}
// apply a split of entry i on var v. Returns 1 if split applied.
fn apply_split(W:[]u8, i:i32, v:i32, seq:i32, reason:[]u8)i32 {
  let vals:[]u8=z_alloc(8);
  let ng:i32=group_vals(W,i,v,vals);
  if(ng<2){return 0;}
  emit("SPLIT action "); e64(en_a(W,i)); emit(" on s"); e64(v);
  emit(" at seq "); e64(seq); emit(" ("); emit(reason); emit(") groups:");
  let g:i32=0;
  while(g<ng){
    emit(" "); e64(vals[g] as i32);
    g=g+1;
  }
  emit("\n");
  // create child per value
  let g2:i32=0;
  while(g2<ng){
    let x:i32=vals[g2] as i32;
    let c:i32=new_entry(W,en_a(W,i),en_mask(W,i)|(1<<v),i,seq);
    if(c<0){return 0;}
    let vv:i32=0;
    while(vv<3){
      if((en_mask(W,i)&(1<<vv))!=0){en_cv_set(W,c,vv,en_cv(W,i,vv));}
      vv=vv+1;
    }
    en_cv_set(W,c,v,x);
    // assign episodes
    let k:i32=0;
    while(k<en_neps(W,i)){
      let e:i32=en_ep(W,i,k);
      if(ep_s(W,e,v)==x){entry_add_ep(W,c,e);}
      k=k+1;
    }
    // compute child effects
    let tmp:[]u8=z_alloc(64);
    let nl:i32=entry_eps(W,c,tmp);
    effects_over(W,c,tmp,nl,c);
    emit("  child "); emit_cond(W,c); emit(" seq="); e64(seq);
    emit(" fx=["); emit_fx(W,c); emit("]\n");
    g2=g2+1;
  }
  en_st_set(W,i,ST_SUPER());
  emit("SUPERSEDE entry action "); e64(en_a(W,i)); emit(" ["); emit_cond(W,i);
  emit("] at seq "); e64(seq); emit(" reason=split-on-s"); e64(v); emit("\n");
  return 1;
}
// attempt split on entry i; sets AMBIGUOUS if multiple candidates
fn split_attempt(W:[]u8, i:i32, seq:i32)void {
  let tmp:[]u8=z_alloc(8);
  let cands:i32=0;
  let v:i32=0;
  while(v<3){
    if(split_candidate(W,i,v,tmp)==1){cands=cands|(1<<v);}
    v=v+1;
  }
  if(cands==0){
    en_st_set(W,i,ST_CONFL());
    emit("CONFLICTED action "); e64(en_a(W,i)); emit(" ["); emit_cond(W,i);
    emit("] at seq "); e64(seq); emit(" (no single-var split resolves)\n");
    return;
  }
  // exactly one?
  if(cands==1 || cands==2 || cands==4){
    let vv:i32=0;
    if(cands==2){vv=1;}
    if(cands==4){vv=2;}
    apply_split(W,i,vv,seq,"unique-candidate");
    return;
  }
  en_st_set(W,i,ST_AMBIG());
  en_amb_set(W,i,cands);
  emit("AMBIGUOUS action "); e64(en_a(W,i)); emit(" ["); emit_cond(W,i);
  emit("] candidates={");
  let first:i32=1;
  v=0;
  while(v<3){
    if((cands&(1<<v))!=0){
      if(first==0){emit(",");}
      emit("s"); e64(v); first=0;
    }
    v=v+1;
  }
  emit("} at seq "); e64(seq); emit(" (WITHHOLD where they disagree)\n");
  return;
}
// ambiguous entry i receives new episode e: test each candidate
fn amb_update(W:[]u8, i:i32, e:i32, seq:i32)void {
  entry_add_ep(W,i,e);
  let cands:i32=en_amb(W,i);
  let tmp:[]u8=z_alloc(8);
  let v:i32=0;
  while(v<3){
    if((cands&(1<<v))!=0){
      // group episodes with s[v]==ep's value, plus the new one, check resolved
      let lst:[]u8=z_alloc(64);
      let nl:i32=0;
      let k:i32=0;
      while(k<en_neps(W,i)){
        let f:i32=en_ep(W,i,k);
        if(usable(W,f,i)==0){k=k+1;continue;}
        if(ep_s(W,f,v)==ep_s(W,e,v)){lst[nl]=f as u8;nl=nl+1;}
        k=k+1;
      }
      if(fx_codes(W,lst,nl,i,tmp)==0){
        // refuted (bit known set, so subtract to clear)
        cands=cands-(1<<v);
        emit("REFUTE action "); e64(en_a(W,i)); emit(" candidate s"); e64(v);
        emit(" at seq "); e64(seq); emit(" (episode ");
        e64(ep_seq(W,e)); emit(")\n");
      }
    }
    v=v+1;
  }
  en_amb_set(W,i,cands);
  if(cands==0){
    en_st_set(W,i,ST_CONFL());
    emit("CONFLICTED action "); e64(en_a(W,i)); emit(" at seq "); e64(seq);
    emit(" (all candidates refuted)\n");
    return;
  }
  if(cands==1 || cands==2 || cands==4){
    let vv:i32=0;
    if(cands==2){vv=1;}
    if(cands==4){vv=2;}
    en_st_set(W,i,ST_ACTIVE());
    apply_split(W,i,vv,seq,"candidate-survives");
    return;
  }
  return;
}

// ============ contests (temporal contradiction at identical state) ============
fn find_contest(W:[]u8, en:i32, s0:i32, s1:i32, s2:i32)i32 {
  let c:i32=0;
  while(c<nct(W)){
    if(ct_en(W,c)==en && ct_s(W,c,0)==s0 && ct_s(W,c,1)==s1 && ct_s(W,c,2)==s2){return c;}
    c=c+1;
  }
  return -1;
}
fn new_contest(W:[]u8, en:i32, s0:i32, s1:i32, s2:i32, o0:i32, o1:i32, o2:i32, n0:i32, n1:i32, n2:i32, q0:i32, q1:i32, seq:i32)i32 {
  let c:i32=nct(W);
  if(c>=16){return -1;}
  ct_en_set(W,c,en);
  ct_s_set(W,c,0,s0); ct_s_set(W,c,1,s1); ct_s_set(W,c,2,s2);
  ct_ns_set(W,c,0,0,o0); ct_ns_set(W,c,0,1,o1); ct_ns_set(W,c,0,2,o2);
  ct_ns_set(W,c,1,0,n0); ct_ns_set(W,c,1,1,n1); ct_ns_set(W,c,1,2,n2);
  ct_sup_set(W,c,0,1); ct_sup_set(W,c,1,1);
  ct_seq_set(W,c,0,q0); ct_seq_set(W,c,1,q1);
  ct_res_set(W,c,0); ct_win_set(W,c,0);
  nct_set(W,c+1);
  emit("CONTEST action "); e64(en_a(W,en)); emit(" state (");
  e64(s0); emit(" "); e64(s1); emit(" "); e64(s2);
  emit(") outcomes ("); e64(o0); emit(" "); e64(o1); emit(" "); e64(o2);
  emit(")@seq"); e64(q0); emit(" vs ("); e64(n0); emit(" "); e64(n1); emit(" "); e64(n2);
  emit(")@seq"); e64(q1); emit(" opened at seq "); e64(seq);
  emit(" (LAW-CHANGE suspected, WITHHOLD)\n");
  return c;
}
// feed episode e into contest c; returns 1 if resolved now
fn contest_feed(W:[]u8, c:i32, e:i32, seq:i32)i32 {
  let o:i32=-1;
  let v:i32=0;
  let m0:i32=1; let m1:i32=1;
  while(v<3){
    if(ep_ns(W,e,v)!=ct_ns(W,c,0,v)){m0=0;}
    if(ep_ns(W,e,v)!=ct_ns(W,c,1,v)){m1=0;}
    v=v+1;
  }
  if(m0==1){o=0;} else if(m1==1){o=1;}
  if(o<0){return 0;} // third outcome: not expected; ignore
  ct_sup_set(W,c,o,ct_sup(W,c,o)+1);
  ct_seq_set(W,c,o,seq); // latest seq for this outcome
  let s0:i32=ct_sup(W,c,0); let s1:i32=ct_sup(W,c,1);
  if((s0>=2 && s0>s1) || (s1>=2 && s1>s0)){
    let w:i32=0;
    if(s1>s0){w=1;}
    ct_res_set(W,c,1); ct_win_set(W,c,w);
    let loser:i32=1-w;
    // supersede losing episodes in this entry at this state
    let en:i32=ct_en(W,c);
    let k:i32=0;
    while(k<en_neps(W,en)){
      let f:i32=en_ep(W,en,k);
      if(ep_st(W,f)==EP_SUP()){k=k+1;continue;}
      if(ep_s(W,f,0)==ct_s(W,c,0) && ep_s(W,f,1)==ct_s(W,c,1) && ep_s(W,f,2)==ct_s(W,c,2)){
        let mf:i32=1;
        let vv:i32=0;
        while(vv<3){
          if(ep_ns(W,f,vv)!=ct_ns(W,c,loser,vv)){mf=0;}
          vv=vv+1;
        }
        if(mf==1){ep_st_set(W,f,EP_SUP());}
      }
      k=k+1;
    }
    emit("RESOLVE action "); e64(en_a(W,en)); emit(" state (");
    e64(ct_s(W,c,0)); emit(" "); e64(ct_s(W,c,1)); emit(" "); e64(ct_s(W,c,2));
    emit(") winner outcome "); e64(w); emit(" (");
    e64(ct_ns(W,c,w,0)); emit(" "); e64(ct_ns(W,c,w,1)); emit(" "); e64(ct_ns(W,c,w,2));
    emit(") support "); e64(ct_sup(W,c,w)); emit(" at seq "); e64(seq);
    emit("; loser SUPERSEDED (valid only before seq "); e64(ct_seq(W,c,loser)); emit(")\n");
    // recompute effects, maybe split
    let tmp:[]u8=z_alloc(64);
    let nl:i32=entry_eps(W,en,tmp);
    if(effects_over(W,en,tmp,nl,en)==0){
      split_attempt(W,en,seq);
    }
    merge_pass(W,seq);
    return 1;
  }
  return 0;
}

// ============ merge ============
fn fx_equal(W:[]u8, i:i32, j:i32)i32 {
  let v:i32=0;
  while(v<3){
    if(en_fx(W,i,v)!=en_fx(W,j,v)){return 0;}
    if(en_fp(W,i,v)!=en_fp(W,j,v)){return 0;}
    v=v+1;
  }
  return 1;
}
// do conds of i and j overlap? (for all vars: agree or at least one is unconstrained)
fn cond_overlap(W:[]u8, i:i32, j:i32)i32 {
  let v:i32=0;
  while(v<3){
    let mi:i32=(en_mask(W,i)&(1<<v))!=0;
    let mj:i32=(en_mask(W,j)&(1<<v))!=0;
    if(mi==1 && mj==1 && en_cv(W,i,v)!=en_cv(W,j,v)){return 0;}
    v=v+1;
  }
  return 1;
}
// merge sibling groups with identical effects; called after splits/resolves
// SAFE only if merged cond does not overlap any other active entry for the action.
fn merge_pass(W:[]u8, seq:i32)void {
  let i:i32=0;
  while(i<nent(W)){
    if(en_st(W,i)!=ST_ACTIVE()){i=i+1;continue;}
    // gather active siblings (same parent, same action)
    let grp:[]u8=z_alloc(64);
    let gn:i32=0;
    let j:i32=0;
    while(j<nent(W)){
      if(j!=i && en_st(W,j)==ST_ACTIVE() && en_a(W,j)==en_a(W,i) && en_par(W,j)==en_par(W,i)){
        grp[gn]=j as u8; gn=gn+1;
      }
      j=j+1;
    }
    if(gn>0){
      // check all identical to i
      let ok:i32=1;
      let g:i32=0;
      while(g<gn){
        if(fx_equal(W,i,grp[g] as i32)==0){ok=0;break;}
        g=g+1;
      }
      if(ok==1){
        // merged cond = parent's cond; check no overlap with other active entries
        let par:i32=en_par(W,i);
        let pm:i32=0;
        if(par>=0){pm=en_mask(W,par);}
        let safe:i32=1;
        let k:i32=0;
        while(k<nent(W)){
          if(k!=i && en_st(W,k)==ST_ACTIVE() && en_a(W,k)==en_a(W,i)){
            // is k in the merge group?
            let ingrp:i32=0;
            let gg:i32=0;
            while(gg<gn){if((grp[gg] as i32)==k){ingrp=1;break;} gg=gg+1;}
            if(ingrp==0){
              // check overlap of parent-cond with k
              // (simulate: temp entry with parent cond)
              let ov:i32=1;
              let v:i32=0;
              while(v<3){
                let mpar:i32=(pm&(1<<v))!=0;
                let mk:i32=(en_mask(W,k)&(1<<v))!=0;
                let cpar:i32=0;
                if(par>=0 && mpar==1){cpar=en_cv(W,par,v);}
                if(mpar==1 && mk==1 && cpar!=en_cv(W,k,v)){ov=0;}
                v=v+1;
              }
              if(ov==1){safe=0;break;}
            }
          }
          k=k+1;
        }
        if(safe==0){i=i+1;continue;}
        let m:i32=new_entry(W,en_a(W,i),pm,par,seq);
        if(m>=0){
          let vv:i32=0;
          while(vv<3){
            if(par>=0 && (pm&(1<<vv))!=0){en_cv_set(W,m,vv,en_cv(W,par,vv));}
            vv=vv+1;
          }
          // move all episodes
          entry_add_list(W,m,i);
          g=0;
          while(g<gn){
            entry_add_list(W,m,grp[g] as i32);
            en_st_set(W,grp[g] as i32,ST_SUPER());
            g=g+1;
          }
          en_st_set(W,i,ST_SUPER());
          let tmp:[]u8=z_alloc(64);
          let nl:i32=entry_eps(W,m,tmp);
          effects_over(W,m,tmp,nl,m);
          emit("MERGE action "); e64(en_a(W,m)); emit(" ");
          e64(gn+1); emit(" siblings into ["); emit_cond(W,m);
          emit("] at seq "); e64(seq); emit(" fx=["); emit_fx(W,m); emit("]\n");
        }
      }
    }
    i=i+1;
  }
  return;
}
fn entry_add_list(W:[]u8, m:i32, src:i32)void {
  let k:i32=0;
  while(k<en_neps(W,src)){
    entry_add_ep(W,m,en_ep(W,src,k));
    k=k+1;
  }
  return;
}

// ============ learn one episode ============
fn learn_episode(W:[]u8, e:i32)void {
  let seq:i32=ep_seq(W,e);
  let a:i32=ep_a(W,e);
  let s0:i32=ep_s(W,e,0); let s1:i32=ep_s(W,e,1); let s2:i32=ep_s(W,e,2);
  let i:i32=find_entry(W,a,s0,s1,s2);
  if(i<0){
    i=new_entry(W,a,0,-1,seq);
    if(i<0){return;}
  }
  if(en_st(W,i)==ST_AMBIG()){
    amb_update(W,i,e,seq);
    return;
  }
  // ACTIVE: check exact-state contradiction against active episodes
  let k:i32=0;
  let contrad:i32=-1;
  while(k<en_neps(W,i)){
    let f:i32=en_ep(W,i,k);
    if(ep_st(W,f)==EP_SUP()){k=k+1;continue;}
    if(ep_s(W,f,0)==s0 && ep_s(W,f,1)==s1 && ep_s(W,f,2)==s2){
      let same:i32=1;
      let v:i32=0;
      while(v<3){
        if(ep_ns(W,f,v)!=ep_ns(W,e,v)){same=0;}
        v=v+1;
      }
      if(same==0){contrad=f;break;}
    }
    k=k+1;
  }
  entry_add_ep(W,i,e);
  if(contrad>=0){
    let c:i32=find_contest(W,i,s0,s1,s2);
    if(c<0){
      c=new_contest(W,i,s0,s1,s2,
        ep_ns(W,contrad,0),ep_ns(W,contrad,1),ep_ns(W,contrad,2),
        ep_ns(W,e,0),ep_ns(W,e,1),ep_ns(W,e,2),
        ep_seq(W,contrad),seq,seq);
    } else {
      contest_feed(W,c,e,seq);
    }
    return;
  }
  // no contradiction: recompute effects, split if needed
  let tmp:[]u8=z_alloc(64);
  let nl:i32=entry_eps(W,i,tmp);
  if(effects_over(W,i,tmp,nl,i)==0){
    split_attempt(W,i,seq);
  }
  merge_pass(W,seq);
  return;
}

// ============ prediction ============
// predict (s,a) under candidate var v of ambiguous entry i; tmp fx codes. returns 1 if all resolved.
fn pred_under(W:[]u8, i:i32, v:i32, s0:i32, s1:i32, s2:i32, out:[]u8)i32 {
  let lst:[]u8=z_alloc(64);
  let nl:i32=0;
  let k:i32=0;
  let sv:i32=0;
  if(v==0){sv=s0;} else if(v==1){sv=s1;} else {sv=s2;}
  while(k<en_neps(W,i)){
    let f:i32=en_ep(W,i,k);
    if(usable(W,f,i)==0){k=k+1;continue;}
    if(ep_s(W,f,v)==sv){lst[nl]=f as u8;nl=nl+1;}
    k=k+1;
  }
  if(nl==0){return 0;}
  let tmp:[]u8=z_alloc(8);
  if(fx_codes(W,lst,nl,i,tmp)==0){return 0;}
  let ss:[]u8=z_alloc(3);
  ss[0]=s0 as u8; ss[1]=s1 as u8; ss[2]=s2 as u8;
  apply_fx_codes(ss,tmp,out);
  return 1;
}
fn apply_fx_codes(s:[]u8, tmp:[]u8, out:[]u8)void {
  let v:i32=0;
  while(v<3){
    let sv:i32=s[v] as i32;
    let c:i32=tmp[v] as i32;
    let p:i32=(tmp[3+v] as i32)-4;
    if(c==FX_UNCH()){out[v]=sv as u8;}
    else if(c==FX_SET()){out[v]=p as u8;}
    else {out[v]=clampv(sv+p,v) as u8;}
    v=v+1;
  }
  return;
}
fn apply_entry_fx(W:[]u8, i:i32, s0:i32, s1:i32, s2:i32, out:[]u8)void {
  let v:i32=0;
  while(v<3){
    let sv:i32=0;
    if(v==0){sv=s0;} else if(v==1){sv=s1;} else {sv=s2;}
    let c:i32=en_fx(W,i,v);
    if(c==FX_UNCH()){out[v]=sv as u8;}
    else if(c==FX_SET()){out[v]=en_fp(W,i,v) as u8;}
    else {out[v]=clampv(sv+en_fp(W,i,v),v) as u8;}
    v=v+1;
  }
  return;
}
// returns: 1=predicted (out set), 0=WITHHOLD (reason emitted)
fn predict(W:[]u8, s0:i32, s1:i32, s2:i32, a:i32, out:[]u8)i32 {
  let i:i32=find_entry(W,a,s0,s1,s2);
  if(i<0){
    emit("WITHHOLD (no-entry)\n");
    return 0;
  }
  if(en_st(W,i)==ST_CONFL()){
    emit("WITHHOLD (conflicted)\n");
    return 0;
  }
  if(en_st(W,i)==ST_AMBIG()){
    let cands:i32=en_amb(W,i);
    let o0:[]u8=z_alloc(3); let o1:[]u8=z_alloc(3);
    let have:i32=0; let agree:i32=1;
    let v:i32=0;
    while(v<3){
      if((cands&(1<<v))!=0){
        if(pred_under(W,i,v,s0,s1,s2,o1)==0){
          emit("WITHHOLD (ambiguous: candidate s"); e64(v); emit(" unresolved)\n");
          return 0;
        }
        if(have==0){o0[0]=o1[0];o0[1]=o1[1];o0[2]=o1[2];have=1;}
        else {
          let vv:i32=0;
          while(vv<3){if(o0[vv]!=o1[vv]){agree=0;} vv=vv+1;}
        }
      }
      v=v+1;
    }
    if(have==0 || agree==0){
      emit("WITHHOLD (ambiguous:");
      v=0;
      while(v<3){
        if((cands&(1<<v))!=0){emit(" s");e64(v);}
        v=v+1;
      }
      emit(" disagree)\n");
      return 0;
    }
    out[0]=o0[0];out[1]=o0[1];out[2]=o0[2];
    emit("(agreed-under-ambiguity) ");
    return 1;
  }
  // ACTIVE: check unresolved contest at this exact state
  let c:i32=find_contest(W,i,s0,s1,s2);
  if(c>=0 && ct_res(W,c)==0){
    emit("WITHHOLD (contested: law-change under test)\n");
    return 0;
  }
  // exact episode?
  let k:i32=0;
  while(k<en_neps(W,i)){
    let f:i32=en_ep(W,i,k);
    if(ep_st(W,f)==EP_SUP()){k=k+1;continue;}
    if(ep_s(W,f,0)==s0 && ep_s(W,f,1)==s1 && ep_s(W,f,2)==s2){
      out[0]=ep_ns(W,f,0);out[1]=ep_ns(W,f,1);out[2]=ep_ns(W,f,2);
      emit("(exact-episode) ");
      return 1;
    }
    k=k+1;
  }
  // effects
  let v2:i32=0;
  let ok:i32=1;
  while(v2<3){
    if(en_fx(W,i,v2)==FX_UNRES()){ok=0;}
    v2=v2+1;
  }
  if(ok==0){
    emit("WITHHOLD (effects-unresolved)\n");
    return 0;
  }
  apply_entry_fx(W,i,s0,s1,s2,out);
  emit("(rule) ");
  return 1;
}

// ============ hypotheses listing ============
fn list_hypos(W:[]u8)void {
  emit("=== HYPOTHESES ===\n");
  let i:i32=0;
  while(i<nent(W)){
    emit("H"); e64(i);
    emit(" action="); e64(en_a(W,i));
    emit(" cond=["); emit_cond(W,i); emit("]");
    emit(" status=");
    let st:i32=en_st(W,i);
    if(st==ST_ACTIVE()){emit("ACTIVE");}
    else if(st==ST_AMBIG()){emit("AMBIGUOUS{"); emit("cands="); e64(en_amb(W,i)); emit("}");}
    else if(st==ST_SUPER()){emit("SUPERSEDED");}
    else {emit("CONFLICTED");}
    emit(" eps="); e64(en_neps(W,i));
    emit(" created@seq"); e64(en_seq(W,i));
    if(st==ST_ACTIVE() || st==ST_AMBIG()){
      emit(" fx=["); emit_fx(W,i); emit("]");
    }
    emit("\n");
    i=i+1;
  }
  emit("=== CONTESTS ===\n");
  let c:i32=0;
  while(c<nct(W)){
    emit("C"); e64(c); emit(" entry="); e64(ct_en(W,c));
    emit(" state=("); e64(ct_s(W,c,0)); emit(" "); e64(ct_s(W,c,1)); emit(" "); e64(ct_s(W,c,2)); emit(")");
    emit(" o0=("); e64(ct_ns(W,c,0,0)); emit(" "); e64(ct_ns(W,c,0,1)); emit(" "); e64(ct_ns(W,c,0,2)); emit(")x"); e64(ct_sup(W,c,0));
    emit(" o1=("); e64(ct_ns(W,c,1,0)); emit(" "); e64(ct_ns(W,c,1,1)); emit(" "); e64(ct_ns(W,c,1,2)); emit(")x"); e64(ct_sup(W,c,1));
    if(ct_res(W,c)==1){emit(" RESOLVED winner="); e64(ct_win(W,c));} else {emit(" UNRESOLVED");}
    emit("\n");
    c=c+1;
  }
  return;
}

// ============ main ============
// ============ experiment invention (H-EXP3: reachability-aware) ============
// Replaces the probe main of causal_learn. Machinery above is copied
// verbatim from causal_learn.zag (generic; no task dynamics).
// H-EXP3 extends H-EXP2 (exp_invent.zag) with:
//   (a) per-variable controllability computed from episodes, and
//       reachability flags on each ranked pick (addresses X-A1);
//   (b) ranking explicitly scoped as heuristic with verified safety
//       property (addresses X-A2).
// Usage: exp_invent3 <obs.txt>
// For each AMBIGUOUS entry: enumerate the state space, simulate each
// candidate hypothesis via pred_under, keep states where all candidates
// resolve AND disagree AND the state is unobserved, rank by
// (ndiff DESC, state index ASC) AS A HEURISTIC (informativeness not
// validated), emit the ranked list with reachability flags plus an
// inspectable trace for the top pick.

// exact active episode with this state in entry i? 1=yes 0=no
fn state_observed(W:[]u8, i:i32, t:i32, p:i32, l:i32)i32 {
  let k:i32=0;
  while(k<en_neps(W,i)){
    let f:i32=en_ep(W,i,k);
    if(ep_st(W,f)==EP_ACT() && ep_s(W,f,0)==t && ep_s(W,f,1)==p && ep_s(W,f,2)==l){
      return 1;
    }
    k=k+1;
  }
  return 0;
}

// emit episodes of entry i with s[v]==sv (the group behind a prediction)
fn emit_group_eps(W:[]u8, i:i32, v:i32, sv:i32)void {
  let k:i32=0;
  let first:i32=1;
  while(k<en_neps(W,i)){
    let f:i32=en_ep(W,i,k);
    if(usable(W,f,i)==1 && ep_s(W,f,v)==sv){
      if(first==0){emit(" ");}
      emit("("); e64(ep_s(W,f,0)); emit(" "); e64(ep_s(W,f,1)); emit(" "); e64(ep_s(W,f,2));
      emit(")->("); e64(ep_ns(W,f,0)); emit(" "); e64(ep_ns(W,f,1)); emit(" "); e64(ep_ns(W,f,2));
      emit(")");
      first=0;
    }
    k=k+1;
  }
  if(first==1){emit("(none)");}
  return;
}

fn emit_cand_name(v:i32)void {
  emit("s"); e64(v);
  return;
}

// ============ H-EXP3: reachability awareness (addresses X-A1) ============
// Per-variable controllability from the learner's own episodes.
// ctrl[v]=1 if any EP_ACT episode changed variable v, else 0.
// chgct[v] counts such changes (for the report).
// Uses only episode data; no domain knowledge.
fn compute_controllable(W:[]u8, ctrl:[]u8, chgct:[]u8)void {
  let v:i32=0;
  while(v<3){ctrl[v]=0;chgct[v]=0;v=v+1;}
  let e:i32=0;
  while(e<nep(W)){
    if(ep_st(W,e)==EP_ACT()){
      v=0;
      while(v<3){
        if(ep_ns(W,e,v)!=ep_s(W,e,v)){ctrl[v]=1;chgct[v]=chgct[v]+1;}
        v=v+1;
      }
    }
    e=e+1;
  }
  return;
}

fn emit_varname(v:i32)void {
  if(v==0){emit("temp");}
  else if(v==1){emit("pressure");}
  else {emit("lamp");}
  return;
}

// Emit controllability report. Called once after learning.
fn emit_controllability(W:[]u8, ctrl:[]u8, chgct:[]u8)void {
  emit("CONTROLLABILITY (from ");
  e64(nep(W));
  emit(" episodes): ");
  let v:i32=0;
  while(v<3){
    if(v>0){emit("; ");}
    emit_varname(v);
    emit("=");
    if(ctrl[v]==1){emit("controllable");} else {emit("UNCONTROLLABLE");}
    emit(" (");
    e64(chgct[v] as i32);
    emit(" changes)");
    v=v+1;
  }
  emit("\n");
  return;
}

// Emit reachability flag for a discriminating state (t,p,l).
// A state NEEDS-EXTERNAL-SETUP if any variable is uncontrollable
// (the agent cannot arrange that variable's required value).
// Otherwise NO-UNCONTROLLABLE-VARS (setup NOT verified): the learner
// only computed per-variable change counts; it does NOT know which
// action sets which value, nor whether the state as a combination is
// reachable. H-EXP4: weakened from the H-EXP3 "AGENT-SETUP-ABLE"
// overclaim per the red team (X-E3-1(b)).
fn emit_reachability(t:i32, p:i32, l:i32, ctrl:[]u8, chgct:[]u8)void {
  let vals:[]u8=z_alloc(3);
  vals[0]=t as u8; vals[1]=p as u8; vals[2]=l as u8;
  let need_ext:i32=0;
  let v:i32=0;
  while(v<3){
    if(ctrl[v]==0){need_ext=1;}
    v=v+1;
  }
  emit("REACHABILITY: ");
  if(need_ext==0){
    emit("NO-UNCONTROLLABLE-VARS (setup NOT verified)");
  } else {
    emit("FLAG: NEEDS-EXTERNAL-SETUP (requires ");
    let first:i32=1;
    v=0;
    while(v<3){
      if(ctrl[v]==0){
        if(first==0){emit(", ");}
        emit_varname(v);
        emit("==");
        e64(vals[v] as i32);
        emit(" [");
        e64(chgct[v] as i32);
        emit(" changes in episodes; not action-controllable]");
        first=0;
      }
      v=v+1;
    }
    emit(")");
  }
  emit("\n");
  return;
}

fn main()i32 {
  let obsp:[]u8=_zag_arg(1);
  if(obsp.len==0){
    emit("usage: exp_invent <obs.txt>\n");
    return 1;
  }
  let W:[]u8=z_alloc(WSZ());
  nep_set(W,0); nent_set(W,0); nct_set(W,0);
  let n:i32=load_obs(W,obsp);
  emit("# loaded "); e64(n); emit(" episodes\n");
  let a:i32=0;
  while(a<4){
    new_entry(W,a,0,-1,0);
    a=a+1;
  }
  let e:i32=0;
  while(e<nep(W)){
    learn_episode(W,e);
    e=e+1;
  }
  emit("# learning done\n");
  // H-EXP3: compute per-variable controllability from episodes
  let ctrl:[]u8=z_alloc(3);
  let chgct:[]u8=z_alloc(3);
  compute_controllable(W, ctrl, chgct);
  emit_controllability(W, ctrl, chgct);
  // H-EXP4: reachability legend (honest labels per X-E3-1(b) repair).
  emit("REACHABILITY LEGEND: NEEDS-EXTERNAL-SETUP is a conservative hazard flag; ");
  emit("NO-UNCONTROLLABLE-VARS means no hazard detected but setup is NOT verified ");
  emit("(which action sets which value, and state-level reachability, are not computed).\n");
  // find ambiguous entries
  let namb:i32=0;
  let ii:i32=0;
  while(ii<nent(W)){
    if(en_st(W,ii)==ST_AMBIG()){namb=namb+1;}
    ii=ii+1;
  }
  if(namb==0){
    emit("NO AMBIGUITY: no competing hypotheses, nothing to invent.\n");
    return 0;
  }
  // invention per ambiguous entry
  ii=0;
  while(ii<nent(W)){
    if(en_st(W,ii)!=ST_AMBIG()){ii=ii+1;continue;}
    let aa:i32=en_a(W,ii);
    let cands:i32=en_amb(W,ii);
    emit("AMBIG action "); e64(aa); emit(" candidates={");
    let v:i32=0;
    let firstc:i32=1;
    while(v<3){
      if((cands&(1<<v))!=0){
        if(firstc==0){emit(",");}
        emit_cand_name(v); firstc=0;
      }
      v=v+1;
    }
    emit("}\n");
    // candidate variable list in increasing order
    let cv:[]u8=z_alloc(3);
    let ncv:i32=0;
    v=0;
    while(v<3){
      if((cands&(1<<v))!=0){cv[ncv]=v as u8;ncv=ncv+1;}
      v=v+1;
    }
    // records: up to 12 states
    let rt:[]u8=z_alloc(12); let rp:[]u8=z_alloc(12); let rl:[]u8=z_alloc(12);
    let rnd:[]u8=z_alloc(12);
    let rpr:[]u8=z_alloc(108); // r*9+c*3+w : prediction per record/cand/var
    let nrec:i32=0;
    let t:i32=0;
    while(t<=vmax(0)){
      let p:i32=0;
      while(p<=vmax(1)){
        let l:i32=0;
        while(l<=vmax(2)){
          if(state_observed(W,ii,t,p,l)==0){
            // predict under each candidate
            let ok:i32=1;
            let cc:i32=0;
            while(cc<ncv){
              let out:[]u8=z_alloc(3);
              if(pred_under(W,ii,cv[cc] as i32,t,p,l,out)==0){ok=0;}
              else {
                let w:i32=0;
                while(w<3){rpr[nrec*9+cc*3+w]=out[w];w=w+1;}
              }
              cc=cc+1;
            }
            if(ok==1 && ncv>=2){
              // do all candidates agree?
              let agree:i32=1;
              let ndiff:[]u8=z_alloc(3);
              let w2:i32=0;
              while(w2<3){ndiff[w2]=0;w2=w2+1;}
              let c2:i32=1;
              while(c2<ncv){
                w2=0;
                while(w2<3){
                  if(rpr[nrec*9+c2*3+w2]!=rpr[nrec*9+0*3+w2]){
                    agree=0; ndiff[w2]=1;
                  }
                  w2=w2+1;
                }
                c2=c2+1;
              }
              if(agree==0){
                let nd:i32=0;
                w2=0;
                while(w2<3){nd=nd+(ndiff[w2] as i32);w2=w2+1;}
                rt[nrec]=t as u8; rp[nrec]=p as u8; rl[nrec]=l as u8;
                rnd[nrec]=nd as u8;
                nrec=nrec+1;
              }
            }
          }
          l=l+1;
        }
        p=p+1;
      }
      t=t+1;
    }
    emit("RANKED EXPERIMENTS (heuristic: ndiff DESC, state-index ASC; informativeness NOT validated) n="); e64(nrec); emit("\n");
    if(nrec==0){
      emit("NO DISCRIMINATING EXPERIMENT: candidates agree or are unresolved on all unobserved states.\n");
      ii=ii+1;
      continue;
    }
    // sort indices by (ndiff DESC, state index ASC)
    let ord:[]u8=z_alloc(12);
    let q:i32=0;
    while(q<nrec){ord[q]=q as u8;q=q+1;}
    let si:i32=0;
    while(si<nrec){
      let sj:i32=si+1;
      while(sj<nrec){
        let x:i32=ord[si] as i32; let y:i32=ord[sj] as i32;
        let dx:i32=rnd[x] as i32; let dy:i32=rnd[y] as i32;
        let ix:i32=(rt[x] as i32)*4+(rp[x] as i32)*2+(rl[x] as i32);
        let iy:i32=(rt[y] as i32)*4+(rp[y] as i32)*2+(rl[y] as i32);
        let swap:i32=0;
        if(dy>dx){swap=1;}
        else if(dy==dx && iy<ix){swap=1;}
        if(swap==1){ord[si]=y as u8;ord[sj]=x as u8;}
        sj=sj+1;
      }
      si=si+1;
    }
    // emit ranked list
    let r:i32=0;
    while(r<nrec){
      let x2:i32=ord[r] as i32;
      emit("["); e64(r); emit("] state (");
      e64(rt[x2] as i32); emit(" "); e64(rp[x2] as i32); emit(" "); e64(rl[x2] as i32);
      emit(") | "); e64(aa); emit(" ::");
      let cc2:i32=0;
      while(cc2<ncv){
        emit(" "); emit_cand_name(cv[cc2] as i32); emit(" -> (");
        e64(rpr[x2*9+cc2*3+0] as i32); emit(" ");
        e64(rpr[x2*9+cc2*3+1] as i32); emit(" ");
        e64(rpr[x2*9+cc2*3+2] as i32); emit(")");
        if(cc2<ncv-1){emit(" ;");}
        cc2=cc2+1;
      }
      emit(" :: differ=");
      let w3:i32=0;
      let f3:i32=1;
      while(w3<3){
        let dd:i32=0;
        let c3:i32=1;
        while(c3<ncv){
          if(rpr[x2*9+c3*3+w3]!=rpr[x2*9+0*3+w3]){dd=1;}
          c3=c3+1;
        }
        if(dd==1){
          if(f3==0){emit(",");}
          emit("v"); e64(w3); f3=0;
        }
        w3=w3+1;
      }
      emit(" ndiff="); e64(rnd[x2] as i32); emit("\n");
      // H-EXP3: reachability flag per pick (addresses X-A1)
      emit("    ");
      emit_reachability(rt[x2] as i32, rp[x2] as i32, rl[x2] as i32, ctrl, chgct);
      r=r+1;
    }
    // H-EXP4: the H-EXP3 re-verification loop is REMOVED. The red team
    // proved it tautological (X-E3-2): it re-ran the identical
    // deterministic pred_under on identical inputs, so the VIOLATION
    // branch was dead code. The discriminating filter (unobserved, all
    // candidates resolve, predictions disagree) is applied once at
    // selection time; no independent re-verification is claimed.
    emit("SELECTION FILTER: all ");
    e64(nrec);
    emit(" emitted states passed the discriminating filter at selection (unobserved; all candidates resolve; predictions disagree). No independent re-verification performed.\n");
    // top pick + trace
    let top:i32=ord[0] as i32;
    emit("TOP PICK (by heuristic): state (");
    e64(rt[top] as i32); emit(" "); e64(rp[top] as i32); emit(" "); e64(rl[top] as i32);
    emit(") | "); e64(aa); emit("\n");
    // H-EXP3: top pick reachability flag (addresses X-A1)
    emit_reachability(rt[top] as i32, rp[top] as i32, rl[top] as i32, ctrl, chgct);
    emit("TRACE top pick:\n");
    let cc3:i32=0;
    while(cc3<ncv){
      let vv2:i32=cv[cc3] as i32;
      let sv:i32=0;
      if(vv2==0){sv=rt[top] as i32;}
      else if(vv2==1){sv=rp[top] as i32;}
      else {sv=rl[top] as i32;}
      emit("  candidate "); emit_cand_name(vv2);
      emit(": group s"); e64(vv2); emit("=="); e64(sv); emit(" episodes: ");
      emit_group_eps(W,ii,vv2,sv);
      emit(" ; predicts (");
      e64(rpr[top*9+cc3*3+0] as i32); emit(" ");
      e64(rpr[top*9+cc3*3+1] as i32); emit(" ");
      e64(rpr[top*9+cc3*3+2] as i32); emit(")\n");
      cc3=cc3+1;
    }
    emit("  differ on: ");
    let w4:i32=0;
    let f4:i32=1;
    while(w4<3){
      let dd2:i32=0;
      let c4:i32=1;
      while(c4<ncv){
        if(rpr[top*9+c4*3+w4]!=rpr[top*9+0*3+w4]){dd2=1;}
        c4=c4+1;
      }
      if(dd2==1){
        if(f4==0){emit(",");}
        emit("v"); e64(w4); f4=0;
      }
      w4=w4+1;
    }
    emit("\n");
    ii=ii+1;
  }
  return 0;
}

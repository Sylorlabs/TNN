// causal_world.zag — ENVIRONMENT. Implements the TRUE world dynamics.
// The learner NEVER sees this file. It only sees the emitted T lines.
//
// State: temp 0..2 (cold,warm,hot), pressure 0..1 (low,high), lamp 0..1 (off,on).
// Actions: 0=heat, 1=cool, 2=pressurize, 3=depressurize.
// True dynamics:
//   heat:         temp := min(2, temp+1)
//   cool:         temp := max(0, temp-1)
//   pressurize:   IF temp==2 THEN no change (SAFETY VALVE) ELSE pressure := 1
//   depressurize: pressure := 0
//   lamp: never changed by actions (demonstrator-controlled).
// Law change (broken=1): safety valve disabled; pressurize always sets pressure:=1.
//
// Usage: causal_world <phase 1..5> [broken 0|1]
// Emits: T <t> <p> <l> | <a> | <nt> <np> <nl>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn digit(v:i32)void {
  let d:[]u8=z_alloc(1);
  d[0]=(48+v) as u8;
  emit(d);
  return;
}

// True transition. broken=1 disables the safety valve (law change).
fn next_state(t:i32, p:i32, l:i32, a:i32, broken:i32, out:[]u8)void {
  if(a==0){
    let nt:i32=t+1; if(nt>2){nt=2;}
    out[0]=nt as u8; out[1]=p as u8; out[2]=l as u8;
  } else if(a==1){
    let nt:i32=t-1; if(nt<0){nt=0;}
    out[0]=nt as u8; out[1]=p as u8; out[2]=l as u8;
  } else if(a==2){
    if(broken==0 && t==2){
      out[0]=t as u8; out[1]=p as u8; out[2]=l as u8; // SAFETY VALVE
    } else {
      out[0]=t as u8; out[1]=1; out[2]=l as u8;
    }
  } else {
    out[0]=t as u8; out[1]=0; out[2]=l as u8;
  }
  return;
}

fn emit_T(t:i32, p:i32, l:i32, a:i32, broken:i32)void {
  let ns:[]u8=z_alloc(3);
  next_state(t,p,l,a,broken,ns);
  emit("T ");
  digit(t); emit(" "); digit(p); emit(" "); digit(l);
  emit(" | "); digit(a); emit(" | ");
  digit(ns[0] as i32); emit(" "); digit(ns[1] as i32); emit(" "); digit(ns[2] as i32);
  emit("\n");
  return;
}

fn main()i32 {
  let pha:[]u8=_zag_arg(1);
  if(pha.len==0){ emit("usage: causal_world <phase 1..5> [broken]\n"); return 1; }
  let n:i32=(pha[0] as i32)-48;
  let broken:i32=0;
  let ba:[]u8=_zag_arg(2);
  if(ba.len>0){ broken=(ba[0] as i32)-48; }
  if(n==1){
    emit("# PHASE A: baseline, valve intact, lamp always off\n");
    emit_T(0,0,0,0,broken); emit_T(1,0,0,0,broken); emit_T(2,0,0,0,broken);
    emit_T(2,0,0,1,broken); emit_T(1,0,0,1,broken); emit_T(0,0,0,2,broken);
    emit_T(1,0,0,2,broken); emit_T(0,1,0,3,broken); emit_T(2,1,0,2,broken);
    emit_T(0,0,0,1,broken);
  } else if(n==2){
    emit("# PHASE B: valve revealed, lamp ON (confounder)\n");
    emit_T(2,0,1,2,broken);
  } else if(n==3){
    emit("# PHASE B2: discriminating evidence\n");
    emit_T(2,0,0,2,broken); emit_T(0,0,1,2,broken);
  } else if(n==4){
    emit("# PHASE C1: law change (valve broken), lamp off\n");
    emit_T(2,0,0,2,broken); emit_T(2,0,0,2,broken);
  } else if(n==5){
    emit("# PHASE C2: law change confirmed, lamp on\n");
    emit_T(2,0,1,2,broken); emit_T(2,0,1,2,broken);
  } else {
    emit("phase must be 1..5\n"); return 1;
  }
  return 0;
}

// ap.zag -- Adaptive (learner-owned) PLEN on learner-created bodies.
//
// Follows COGOPS-PARSIMONY (cogops_parsimony/pp.zag): P1 composite
// fitness fit(b) = replay(b) - PLEN*len(b) plus P2 greedy
// compression plus 10-generation parsimony refinement discovered
// the exact minimal 6-instruction form. PARSIMONY's honest
// boundary: PLEN=3 was a researcher-owned hand-derived constant.
// This lane makes PLEN learner-owned (adaptive): it lives in
// learner cell 2370, starts at 0 (no pressure), and the learner
// moves it from experienced consequences:
//   UP: per-generation, when a shorter working body exists that
//       composite selection ignores (why=avail, at most 0->1);
//       post-adopt, when compression proved shortening is free
//       (why=compress).
//   DOWN: post-adopt, when the adopted body's raw replay
//       regressed vs the previous adoption (why=regress).
// Floor 0, cap 6, steps of 1. The update RULE is
// researcher-authored; the VALUE and its trajectory are
// learner-owned persistent state.
// Inversion diagnostic (pmode==3 only, reporting only): counts
// composite comparisons where the winner has strictly lower raw
// replay than the loser. Adopt bars stay on RAW replay (>=850);
// compression keep-criterion stays raw non-decrease.
//
// Arms: 0=A-FULL (adaptive PLEN + P1 + P2), 1=F-FULL (fixed
// PLEN=3 + P1 + P2, in-binary replication of PARSIMONY P-FULL),
// 2=NP (LB1-exact, in-binary replication). Law change ep 400 in
// all arms. No invention mode, 0 modes/bridges/handlers/semantic
// cases. pmode is the pre-existing experimental-arm selector,
// not a cognitive mode.
//
// Cell map additions vs pp.zag:
// 2370 plen (learner-owned adaptive coefficient, init 0)
// 2371 plen_adj  2372 plen_inv_tot  2373 plen_prev_raw
// 2367 pmode (0=NP,2=F-FULL,3=A-FULL)  2368 compress_strict
// 2369 compress_dels
//
// Cell map (i32 cells in S):
// 0..55 appl_sum[o*8+c]  56..111 appl_n  112..160 comp_sum[p*7+q]
// 161..209 comp_n  210..216 tot_sum  217..223 tot_n  224..230 retired
// 231..237 retire_ep  238 rng_env 239 rng_learn 240 log_head
// 241..720 log(96x5)  721..744 nodes(8x3) 745 node_n 746..793 edges(16x3)
// 794 edge_n  795..802 regs R0..R7  803..809 bstart 810..816 blen
// 817 status 818 ans 819 true_ans
// 820 n3_pre_ok 821 n3_pre_n 822 n3_post_ok 823 n3_post_n
// 828 hand_pre 829 hand_post 830 final_post
// 832 create_trials 833 revise_trials 834 create_best 835 revise_best
// 836 enum_events 837 immc6_pre 838 immc6_post
// 839 has_set6 840 novel_flag 841 construct_events 842 revise_events
// 843 menu_events  844..850 solo_ok[7]  851..857 solo_n[7]
// 858 scratch_a 859 scratch_b/umask 860 ctx0
// 900+c*160+i*20 ctx rings (8 ctx x 8 snaps x 20 cells)
// 2180..2187 ctx_ring_n[8]  2188..2195 ctx_ring_head[8]
// 2200..2207 OPC[8]  2208..2271 BIG[64]  2272..2279 REGR[8]
// 2280..2288 IMMC[9]
// 2290 create_budget 2291 revise_budget 2292 arm_id 2293 shift_on
// 2294..2300 op_origin[7]  2301..2307 op_parent[7]
// 2310..2317 pop_len[8]  2318..2325 pop_score[8]  2326..2333 pop_age[8]
// 2334..2345 off_len[12]  2346..2357 off_score[12]
// 2358 create_adopted 2359 revise_adopted
// 2360..2363 graft_src[4]  2364 graft_n  2365 menu_trials 2366 menu_champ
// 2367 pmode  2368 compress_strict  2369 compress_dels
// 2370 plen  2371 plen_adj  2372 plen_inv_tot  2373 plen_prev_raw
// BC bytes: bodies 0..4 [0,512)  slot5 [512,768)  slot6 [768,1024)
//   population 8x128 [1024,2048)  offspring 12x128 [2048,3584)
//   hand scratch [3584,3712)  menu-best [3712,3840).
// Snapshot 20 cells: 0 n_nodes 1 n_edges 2 ans 3 used_mask 4 ctx0
//   5..13 edges (et,from,to)x3  14..17 node v0[4]  18..19 spare.

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
// ============ table accessors (7 ops) ============
fn asg(S:[]u8,o:i32,c:i32)i32 { return sg(S,o*8+c); }
fn ssa(S:[]u8,o:i32,c:i32,v:i32)void { ss(S,o*8+c,v); return; }
fn ang(S:[]u8,o:i32,c:i32)i32 { return sg(S,56+o*8+c); }
fn sna(S:[]u8,o:i32,c:i32,v:i32)void { ss(S,56+o*8+c,v); return; }
fn csg(S:[]u8,p:i32,q:i32)i32 { return sg(S,112+p*7+q); }
fn scs(S:[]u8,p:i32,q:i32,v:i32)void { ss(S,112+p*7+q,v); return; }
fn cng(S:[]u8,p:i32,q:i32)i32 { return sg(S,161+p*7+q); }
fn scn(S:[]u8,p:i32,q:i32,v:i32)void { ss(S,161+p*7+q,v); return; }
// ============ deterministic RNG (two LCG streams) ============
fn xorsh(S:[]u8,cell:i32)i32 {
  let s:i32=sg(S,cell);
  let ns:i32=(s*1103515245+12345) & 2147483647;
  ss(S,cell,ns);
  return ns;
}
// ============ graph store (generic machinery) ============
fn g_node(S:[]u8,kind:i32,v0:i32,v1:i32)i32 {
  let id:i32=sg(S,745);
  ss(S,721+id*3,kind); ss(S,721+id*3+1,v0); ss(S,721+id*3+2,v1);
  ss(S,745,id+1);
  return id;
}
fn g_edge(S:[]u8,from:i32,et:i32,to:i32)void {
  let id:i32=sg(S,794);
  ss(S,746+id*3,from); ss(S,746+id*3+1,et); ss(S,746+id*3+2,to);
  ss(S,794,id+1);
  return;
}
fn g_match(S:[]u8,from:i32,et:i32)i32 {
  let e:i32=0; let n:i32=sg(S,794);
  while(e<n){
    if(sg(S,746+e*3)==from && sg(S,746+e*3+1)==et){return sg(S,746+e*3+2);}
    e=e+1;
  }
  return -1;
}
fn g_field(S:[]u8,nd:i32,f:i32)i32 {
  // Bounds-checked: out-of-range reads return a sentinel, never
  // adjacent memory. (Prevents bodies from "solving" via OOB reads.)
  if(nd<0 || nd>=sg(S,745)){return -999;}
  if(f<0 || f>2){return -999;}
  return sg(S,721+nd*3+f);
}
// ============ body assembler (bootstrap; bodies are data) ============
fn asmi(BC:[]u8,p:i32,op:i32,a:i32,b:i32,c:i32,imm:i32)i32 {
  BC[p]=op as u8; BC[p+1]=a as u8; BC[p+2]=b as u8; BC[p+3]=c as u8;
  set32(BC,p+4,imm);
  return p+8;
}
fn build_bodies(S:[]u8,BC:[]u8)void {
  let p:i32=0;
  // op 0 gather (CORRECT here: etype SET is 1; no planted bug --
  // there is no REPAIR operator in LB1)
  ss(S,803,p);
  p=asmi(BC,p,1,0,0,0,1);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,2,0,0,-1);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,40);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  ss(S,810,p-sg(S,803));
  // op 1 follow (etype 2)
  ss(S,804,p);
  p=asmi(BC,p,1,0,0,0,2);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,2,0,0,-1);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,32);
  p=asmi(BC,p,2,7,1,0,0);
  p=asmi(BC,p,1,6,0,0,1);
  p=asmi(BC,p,8,6,0,0,0);
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  ss(S,811,p-sg(S,804));
  // op 2 complete
  ss(S,805,p);
  p=asmi(BC,p,1,0,0,0,1);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,2,0,0,-1);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,88);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  p=asmi(BC,p,1,0,0,0,3);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,40);
  p=asmi(BC,p,7,1,4,6,0);
  p=asmi(BC,p,3,5,6,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  ss(S,812,p-sg(S,805));
  // op 3 predict (always wrong; designated retiree)
  ss(S,806,p);
  p=asmi(BC,p,1,5,0,0,777);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  ss(S,813,p-sg(S,806));
  // op 4 shift (etype 4)
  ss(S,807,p);
  p=asmi(BC,p,1,0,0,0,4);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,2,0,0,-1);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,32);
  p=asmi(BC,p,2,7,1,0,0);
  p=asmi(BC,p,1,6,0,0,1);
  p=asmi(BC,p,8,6,0,0,0);
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  ss(S,814,p-sg(S,807));
  // slots 5,6 empty (learner-created)
  ss(S,808,512); ss(S,815,0);
  ss(S,809,768); ss(S,816,0);
  return;
}
// ============ generic instruction interpreter ============
// Dispatches ONLY on the 8 generic ISA opcodes; op id o is used solely
// to locate the body. status: 0 FAIL, 1 CONTINUE, 2 ANSWERED.
fn cog_exec_at(S:[]u8,BC:[]u8,pc:i32,pend:i32)void {
  let guard:i32=0;
  while(pc<pend && guard<96){
    guard=guard+1;
    let opc:i32=BC[pc] as i32;
    let a:i32=BC[pc+1] as i32;
    let b:i32=BC[pc+2] as i32;
    let c:i32=BC[pc+3] as i32;
    let imm:i32=get32(BC,pc+4);
    if(opc==1){ ss(S,795+a,imm); pc=pc+8; }
    else if(opc==2){ ss(S,795+a,sg(S,795+b)); pc=pc+8; }
    else if(opc==3){ ss(S,795+c,sg(S,795+a)+sg(S,795+b)); pc=pc+8; }
    else if(opc==4){
      let v:i32=0;
      if(sg(S,795+a)==sg(S,795+b)){v=1;}
      ss(S,795+c,v); pc=pc+8;
    }
    else if(opc==5){
      if(sg(S,795+a)!=0){pc=pc+imm;} else {pc=pc+8;}
    }
    else if(opc==6){ ss(S,795+c,g_match(S,sg(S,795+a),sg(S,795+b))); pc=pc+8; }
    else if(opc==7){ ss(S,795+c,g_field(S,sg(S,795+a),sg(S,795+b))); pc=pc+8; }
    else if(opc==8){ ss(S,817,sg(S,795+a)); ss(S,818,sg(S,795+b)); return; }
    else { pc=pc+8; }
  }
  ss(S,817,0); ss(S,818,0);
  return;
}
fn cog_exec(S:[]u8,BC:[]u8,o:i32)void {
  cog_exec_at(S,BC,sg(S,803+o),sg(S,803+o)+sg(S,810+o));
  return;
}
// ============ learned table reads (x1000; unseen = 500 optimism) ============
fn appl_mx(S:[]u8,o:i32,ctx:i32)i32 {
  let n:i32=ang(S,o,ctx);
  if(n>0){ return (1000*asg(S,o,ctx))/n; }
  return 500;
}
fn comp_mx(S:[]u8,p:i32,q:i32)i32 {
  let n:i32=cng(S,p,q);
  if(n>0){ return (1000*csg(S,p,q))/n; }
  return 500;
}
fn tot_mx(S:[]u8,o:i32)i32 {
  let n:i32=sg(S,217+o);
  if(n>0){ return (1000*sg(S,210+o))/n; }
  return 0;
}
// ============ observable context probe (edge existence only) ============
fn cog_probe(S:[]u8)i32 {
  let cur:i32=sg(S,795+7);
  let hv:i32=0;
  if(g_match(S,cur,1)!=-1){hv=1;}
  let dv:i32=0;
  if(g_match(S,cur,2)!=-1){dv=1;}
  let sv:i32=0;
  if(g_match(S,cur,4)!=-1){sv=1;}
  return hv+dv*2+sv*4;
}
// ============ generic bandit selector (never branches on op id) ============
fn cog_select(S:[]u8,ctx:i32,prev:i32,epsx:i32)i32 {
  let nc:i32=0; let o:i32=0;
  while(o<7){
    if(sg(S,810+o)>0 && sg(S,224+o)==0){nc=nc+1;}
    o=o+1;
  }
  if(nc==0){return 0;}
  let rs:i32=xorsh(S,239);
  if((rs % 1000)<epsx){
    let rs2:i32=xorsh(S,239);
    let pick:i32=rs2 % nc;
    let k:i32=0; o=0;
    while(o<7){
      if(sg(S,810+o)>0 && sg(S,224+o)==0){
        if(k==pick){return o;}
        k=k+1;
      }
      o=o+1;
    }
    return 0;
  }
  let best:i32=-1; let bests:i32=0; let bestt:i32=0; o=0;
  while(o<7){
    if(sg(S,810+o)>0 && sg(S,224+o)==0){
      let sc:i32=appl_mx(S,o,ctx);
      if(prev<7){ sc=sc+comp_mx(S,prev,o); }
      let tn:i32=sg(S,217+o);
      if(best<0 || sc>bests || (sc==bests && tn<bestt)){best=o;bests=sc;bestt=tn;}
    }
    o=o+1;
  }
  if(best<0){return 0;}
  return best;
}
// ============ environment ============
// typ 0=F 40% (Q)-[V]->ans ; 1=N1 25% (Q)-[D]->(E2)-[V]->V2,[R]->K ;
// 2=N2 15% (Q)-[S]->(E3)-[V]->V3 ; 3=N3 20% (Q)-[W,etype]->ans.
// LAW CHANGE: at shift_on==1, N3 etype is 6, not 5.
fn env_build(S:[]u8)i32 {
  ss(S,745,0); ss(S,794,0);
  let r:i32=xorsh(S,238);
  let t:i32=(r >> 16) % 20;
  let typ:i32=0;
  if(t>=8 && t<=12){typ=1;}
  else if(t>=13 && t<=15){typ=2;}
  else if(t>=16){typ=3;}
  let q:i32=g_node(S,1,0,0);
  if(typ==0){
    let r2:i32=xorsh(S,238);
    let av:i32=10+(r2 % 40);
    let vn:i32=g_node(S,2,av,0);
    g_edge(S,q,1,vn);
    ss(S,819,av);
  } else if(typ==1){
    let e2:i32=g_node(S,1,0,0);
    let r2:i32=xorsh(S,238);
    let v2:i32=10+(r2 % 30);
    let r3:i32=xorsh(S,238);
    let kk:i32=1+(r3 % 9);
    let vn:i32=g_node(S,2,v2,0);
    let kn:i32=g_node(S,2,kk,0);
    g_edge(S,q,2,e2);
    g_edge(S,e2,1,vn);
    g_edge(S,e2,3,kn);
    ss(S,819,v2+kk);
  } else if(typ==2){
    let e3:i32=g_node(S,1,0,0);
    let r2:i32=xorsh(S,238);
    let v3:i32=10+(r2 % 40);
    let vn:i32=g_node(S,2,v3,0);
    g_edge(S,q,4,e3);
    g_edge(S,e3,1,vn);
    ss(S,819,v3);
  } else {
    let r2:i32=xorsh(S,238);
    let wv:i32=10+(r2 % 40);
    let wn:i32=g_node(S,2,wv,0);
    let et:i32=5;
    if(sg(S,2293)==1){et=6;}
    g_edge(S,q,et,wn);
    ss(S,819,wv);
  }
  return typ;
}
// ============ snapshot ring archives (learner-owned experience) ============
// Per-ctx ring of the last 8 episodes (graph, answer, ctx0).
// The consequence system observes true answers post-hoc; archives
// reuse them for offline body trials.
fn snap_write(S:[]u8,base:i32)void {
  let nn:i32=sg(S,745); let ne:i32=sg(S,794);
  if(nn>4 || ne>3){return;}
  ss(S,base,  nn); ss(S,base+1,ne); ss(S,base+2,sg(S,819));
  ss(S,base+3,sg(S,859)); ss(S,base+4,sg(S,860));
  let e:i32=0;
  while(e<3){
    if(e<ne){
      ss(S,base+5+e*3,sg(S,746+e*3+1));
      ss(S,base+5+e*3+1,sg(S,746+e*3));
      ss(S,base+5+e*3+2,sg(S,746+e*3+2));
    } else { ss(S,base+5+e*3,0); ss(S,base+5+e*3+1,0); ss(S,base+5+e*3+2,0); }
    e=e+1;
  }
  let i:i32=0;
  while(i<4){
    if(i<nn){ ss(S,base+14+i,sg(S,721+i*3+1)); } else { ss(S,base+14+i,0); }
    i=i+1;
  }
  return;
}
// cells 859/860: scratch for used_mask / ctx0 of current episode
fn snap_push(S:[]u8)void {
  let c0:i32=sg(S,860);
  if(c0<0 || c0>7){return;}
  let h:i32=sg(S,2188+c0);
  snap_write(S,900+c0*160+h*20);
  ss(S,2188+c0,(h+1)%8);
  let n:i32=sg(S,2180+c0);
  if(n<8){ss(S,2180+c0,n+1);}
  return;
}
fn snap_load(S:[]u8,base:i32)void {
  let nn:i32=sg(S,base); let ne:i32=sg(S,base+1);
  ss(S,745,0); ss(S,794,0);
  let i:i32=0;
  while(i<nn){ g_node(S,1,sg(S,base+14+i),0); i=i+1; }
  let e:i32=0;
  while(e<ne){
    g_edge(S,sg(S,base+5+e*3+1),sg(S,base+5+e*3),sg(S,base+5+e*3+2));
    e=e+1;
  }
  i=0;
  while(i<8){ ss(S,795+i,0); i=i+1; }
  ss(S,817,0); ss(S,818,0);
  return;
}

// ============ graded replay credit (generic consequence shaping) ============
// Per snapshot: correct YIELD=1000; answer value in a register but
// not among the body's own SET immediates=400; a register holding a
// valid node id not among the body's own SET immediates=150 (graph
// discovery); wrong YIELD=100; else 0. The SET-imm exclusion stops
// degenerate bodies like [SET R1,1] from scoring via constants.
// This shaping is generic: it names no etype, no wiring, no answer.
fn body_imms(BC:[]u8,pc:i32,nin:i32,IB:[]u8)i32 {
  let m:i32=0; let i:i32=0;
  while(i<nin){
    if(BC[pc+i*8] as i32==1){
      if(m<16){set32(IB,m*4,get32(BC,pc+i*8+4));m=m+1;}
    }
    i=i+1;
  }
  return m;
}
fn imm_in(v:i32,IB:[]u8,m:i32)i32 {
  let i:i32=0;
  while(i<m){if(get32(IB,i*4)==v){return 1;}i=i+1;}
  return 0;
}
fn graded_replay(S:[]u8,BC:[]u8,pc:i32,pl:i32,ctx:i32)i32 {
  let n:i32=sg(S,2180+ctx);
  if(n==0){return 0;}
  let nin:i32=pl/8;
  let IB:[]u8=z_alloc(64);
  let m:i32=body_imms(BC,pc,nin,IB);
  let head:i32=sg(S,2188+ctx);
  let tot:i32=0; let used:i32=0; let k:i32=0;
  while(k<n){
    let slot:i32=(head-k+16)%8;
    let sb:i32=900+ctx*160+slot*20;
    snap_load(S,sb);
    cog_exec_at(S,BC,pc,pc+pl);
    let st:i32=sg(S,817); let an:i32=sg(S,818);
    let tru:i32=sg(S,sb+2); let nn:i32=sg(S,sb);
    let sc:i32=0;
    if(st==2 && an==tru){sc=1000;}
    else {
      let nf:i32=0; let af:i32=0; let r:i32=0;
      while(r<8){
        let v:i32=sg(S,795+r);
        if(v>=1 && v<nn && imm_in(v,IB,m)==0){nf=1;}
        if(v==tru && imm_in(v,IB,m)==0){af=1;}
        r=r+1;
      }
      if(af==1){sc=400;}
      else if(nf==1){sc=150;}
      else if(st==2){sc=100;}
    }
    tot=tot+sc; used=used+1;
    k=k+1;
  }
  if(used==0){return 0;}
  return tot/used;
}
// ============ learner-owned construction policy ============
// OPC/BIG/REGR/IMMC live in learner cells, Laplace-smoothed.
// Seeded (arms 0,2) from instruction statistics of bodies the
// learner itself experienced as successful (tot_n>=10, tot_sum>0).
// Adapted (arms 0,1) by reinforcing above-mean offspring.
fn cum_sample(S:[]u8,base:i32,n:i32)i32 {
  let tot:i32=0; let i:i32=0;
  while(i<n){tot=tot+sg(S,base+i);i=i+1;}
  if(tot<=0){return 0;}
  let r:i32=xorsh(S,239)%tot;
  i=0;
  while(i<n){
    r=r-sg(S,base+i);
    if(r<0){return i;}
    i=i+1;
  }
  return n-1;
}
fn sample_op(S:[]u8,prev:i32)i32 {
  if(prev<=0){return cum_sample(S,2200,8)+1;}
  return cum_sample(S,2208+(prev-1)*8,8)+1;
}
fn sample_reg(S:[]u8)i32 {return cum_sample(S,2272,8);}
fn sample_imm(S:[]u8)i32 {
  let c:i32=cum_sample(S,2280,9);
  return c-1;
}
fn emit_instr(BC:[]u8,pos:i32,op:i32,a:i32,b:i32,c:i32,imm:i32)void {
  BC[pos]=op as u8; BC[pos+1]=a as u8; BC[pos+2]=b as u8; BC[pos+3]=c as u8;
  set32(BC,pos+4,imm); return;
}
fn sample_instr_to(S:[]u8,BC:[]u8,pos:i32,prev:i32)i32 {
  let op:i32=sample_op(S,prev);
  let a:i32=sample_reg(S); let b:i32=sample_reg(S); let c:i32=sample_reg(S);
  let imm:i32=sample_imm(S);
  emit_instr(BC,pos,op,a,b,c,imm);
  return op;
}
fn policy_walk(S:[]u8,BC:[]u8,pc:i32,nin:i32)void {
  let prev:i32=0; let i:i32=0;
  while(i<nin){
    let op:i32=BC[pc+i*8] as i32;
    let a:i32=BC[pc+i*8+1] as i32;
    let b:i32=BC[pc+i*8+2] as i32;
    let c:i32=BC[pc+i*8+3] as i32;
    let imm:i32=get32(BC,pc+i*8+4);
    if(op>=1 && op<=8){
      ss(S,2200+op-1,sg(S,2200+op-1)+1);
      if(prev>0){ss(S,2208+(prev-1)*8+op-1,sg(S,2208+(prev-1)*8+op-1)+1);}
      if(a>=0 && a<8){ss(S,2272+a,sg(S,2272+a)+1);}
      if(b>=0 && b<8){ss(S,2272+b,sg(S,2272+b)+1);}
      if(c>=0 && c<8){ss(S,2272+c,sg(S,2272+c)+1);}
      if(imm==-1){ss(S,2280,sg(S,2280)+1);}
      else if(imm>=0 && imm<=7){ss(S,2281+imm,sg(S,2281+imm)+1);}
      prev=op;
    }
    i=i+1;
  }
  return;
}
fn policy_seed(S:[]u8,BC:[]u8)void {
  let o:i32=0;
  while(o<5){
    if(sg(S,217+o)>=10 && sg(S,210+o)>0){
      policy_walk(S,BC,sg(S,803+o),sg(S,810+o)/8);
    }
    o=o+1;
  }
  return;
}
// Etype-frequency bias: generic machinery. The learner's own recent
// target-context memories suggest which etypes are worth trying;
// IMMC gains +4 per observed etype occurrence. Disclosed shaping:
// it names no wiring and no answer, only "etypes you have seen".
fn bias_imm_from_snaps(S:[]u8)void {
  let n:i32=sg(S,2180+0); let head:i32=sg(S,2188+0);
  let k:i32=0;
  while(k<n){
    let slot:i32=(head-k+16)%8;
    let sb:i32=900+slot*20;
    let ne:i32=sg(S,sb+1); let e:i32=0;
    while(e<ne && e<3){
      let et:i32=sg(S,sb+5+e*3);
      if(et>=0 && et<=7){ss(S,2281+et,sg(S,2281+et)+2);}
      e=e+1;
    }
    k=k+1;
  }
  return;
}
// ============ population machinery (open-form, 16 instr cap) ============
fn pop_copy(S:[]u8,BC:[]u8,dst_i:i32,src_pc:i32,src_nin:i32)void {
  let dp:i32=1024+dst_i*128;
  let k:i32=0;
  while(k<src_nin*8){BC[dp+k]=BC[src_pc+k];k=k+1;}
  ss(S,2310+dst_i,src_nin);
  return;
}
fn off_copy_from_pop(S:[]u8,BC:[]u8,dst_j:i32,src_i:i32)void {
  let sp:i32=1024+src_i*128; let nin:i32=sg(S,2310+src_i);
  let dp:i32=2048+dst_j*128;
  let k:i32=0;
  while(k<nin*8){BC[dp+k]=BC[sp+k];k=k+1;}
  ss(S,2334+dst_j,nin);
  return;
}
fn tournament(S:[]u8)i32 {
  let a:i32=xorsh(S,239)%8;
  let b:i32=xorsh(S,239)%8;
  if(sg(S,2367)>0){
    let fa:i32=pop_fit(S,a); let fb:i32=pop_fit(S,b);
    if(fb>fa){
      // inversion diagnostic (adaptive arm, reporting only):
      // composite winner b has strictly lower raw replay than a.
      if(sg(S,2367)==3 && sg(S,2318+b)<sg(S,2318+a)){
        ss(S,2372,sg(S,2372)+1);
      }
      return b;
    }
    if(fb==fa){
      let la:i32=sg(S,2310+a); let lb:i32=sg(S,2310+b);
      if(lb<la){return b;}
    }
    return a;
  }
  let sa:i32=sg(S,2318+a); let sb:i32=sg(S,2318+b);
  if(sb>sa){return b;}
  if(sb==sa){
    let la:i32=sg(S,2310+a); let lb:i32=sg(S,2310+b);
    if(lb<la){return b;}
  }
  return a;
}
// mutate one slot of one instruction, sampled from the policy
fn op_mutate_slot(S:[]u8,BC:[]u8,j:i32)void {
  let dp:i32=2048+j*128; let nin:i32=sg(S,2334+j);
  if(nin<=0){return;}
  let ii:i32=xorsh(S,239)%nin;
  let slot:i32=xorsh(S,239)%5;
  let prev:i32=0;
  if(ii>0){prev=BC[dp+(ii-1)*8] as i32;}
  if(slot==0){BC[dp+ii*8]=sample_op(S,prev) as u8;}
  else if(slot==1){BC[dp+ii*8+1]=sample_reg(S) as u8;}
  else if(slot==2){BC[dp+ii*8+2]=sample_reg(S) as u8;}
  else if(slot==3){BC[dp+ii*8+3]=sample_reg(S) as u8;}
  else {set32(BC,dp+ii*8+4,sample_imm(S));}
  return;
}
// generic "tweak a constant": resample one random SET's imm
fn op_targeted_mutate(S:[]u8,BC:[]u8,j:i32)void {
  let dp:i32=2048+j*128; let nin:i32=sg(S,2334+j);
  let ns:i32=0; let i:i32=0;
  while(i<nin){if(BC[dp+i*8] as i32==1){ns=ns+1;}i=i+1;}
  if(ns==0){return;}
  let want:i32=xorsh(S,239)%ns;
  i=0;
  while(i<nin){
    if(BC[dp+i*8] as i32==1){
      if(want==0){set32(BC,dp+i*8+4,sample_imm(S));return;}
      want=want-1;
    }
    i=i+1;
  }
  return;
}
fn op_append(S:[]u8,BC:[]u8,j:i32)void {
  let dp:i32=2048+j*128; let nin:i32=sg(S,2334+j);
  if(nin>=16){return;}
  let prev:i32=0;
  if(nin>0){prev=BC[dp+(nin-1)*8] as i32;}
  sample_instr_to(S,BC,dp+nin*8,prev);
  ss(S,2334+j,nin+1);
  return;
}
fn op_insert(S:[]u8,BC:[]u8,j:i32)void {
  let dp:i32=2048+j*128; let nin:i32=sg(S,2334+j);
  if(nin>=16){return;}
  let at:i32=0;
  if(nin>0){at=xorsh(S,239)%(nin+1);}
  let k:i32=nin;
  while(k>at){
    let q:i32=0;
    while(q<8){BC[dp+k*8+q]=BC[dp+(k-1)*8+q];q=q+1;}
    k=k-1;
  }
  let prev:i32=0;
  if(at>0){prev=BC[dp+(at-1)*8] as i32;}
  sample_instr_to(S,BC,dp+at*8,prev);
  ss(S,2334+j,nin+1);
  return;
}
fn op_delete(S:[]u8,BC:[]u8,j:i32)void {
  let dp:i32=2048+j*128; let nin:i32=sg(S,2334+j);
  if(nin<=1){return;}
  let at:i32=xorsh(S,239)%nin;
  let k:i32=at;
  while(k<nin-1){
    let q:i32=0;
    while(q<8){BC[dp+k*8+q]=BC[dp+(k+1)*8+q];q=q+1;}
    k=k+1;
  }
  ss(S,2334+j,nin-1);
  return;
}
fn op_crossover(S:[]u8,BC:[]u8,j:i32,a:i32,b:i32)void {
  let pa:i32=1024+a*128; let na:i32=sg(S,2310+a);
  let pb:i32=1024+b*128; let nb:i32=sg(S,2310+b);
  let dp:i32=2048+j*128;
  let mx:i32=na;
  if(nb<mx){mx=nb;}
  let k:i32=0;
  if(mx>0){k=xorsh(S,239)%(mx+1);}
  let q:i32=0;
  while(q<k*8){BC[dp+q]=BC[pa+q];q=q+1;}
  q=0;
  while(q<(nb-k)*8 && k+q<128){BC[dp+k*8+q]=BC[pb+k*8+q];q=q+1;}
  let nl:i32=k+(nb-k);
  if(nl>16){nl=16;}
  ss(S,2334+j,nl);
  return;
}
// experience graft: whole successful innate body -> offspring
// (truncated to 16). The learner recombines its own experience.
fn op_graft(S:[]u8,BC:[]u8,j:i32,src_o:i32)void {
  let sp:i32=sg(S,803+src_o); let nin:i32=sg(S,810+src_o)/8;
  if(nin>16){nin=16;}
  let dp:i32=2048+j*128;
  let k:i32=0;
  while(k<nin*8){BC[dp+k]=BC[sp+k];k=k+1;}
  ss(S,2334+j,nin);
  return;
}
// experience crossover: pop prefix + successful-body suffix
fn op_crossover_xp(S:[]u8,BC:[]u8,j:i32,pi:i32,src_o:i32)void {
  let pp:i32=1024+pi*128; let np:i32=sg(S,2310+pi);
  let sp:i32=sg(S,803+src_o); let nso:i32=sg(S,810+src_o)/8;
  let mx:i32=np;
  if(nso<mx){mx=nso;}
  let k:i32=0;
  if(mx>0){k=xorsh(S,239)%(mx+1);}
  let dp:i32=2048+j*128;
  let q:i32=0;
  while(q<k*8){BC[dp+q]=BC[pp+q];q=q+1;}
  let nl:i32=k;
  q=k;
  while(q<nso && nl<16){
    let b2:i32=0;
    while(b2<8){BC[dp+nl*8+b2]=BC[sp+q*8+b2];b2=b2+1;}
    nl=nl+1; q=q+1;
  }
  ss(S,2334+j,nl);
  return;
}
fn pop_mutate_slot(S:[]u8,BC:[]u8,i:i32)void {
  let dp:i32=1024+i*128; let nin:i32=sg(S,2310+i);
  if(nin<=0){return;}
  let ii:i32=xorsh(S,239)%nin;
  let slot:i32=xorsh(S,239)%5;
  let prev:i32=0;
  if(ii>0){prev=BC[dp+(ii-1)*8] as i32;}
  if(slot==0){BC[dp+ii*8]=sample_op(S,prev) as u8;}
  else if(slot==1){BC[dp+ii*8+1]=sample_reg(S) as u8;}
  else if(slot==2){BC[dp+ii*8+2]=sample_reg(S) as u8;}
  else if(slot==3){BC[dp+ii*8+3]=sample_reg(S) as u8;}
  else {set32(BC,dp+ii*8+4,sample_imm(S));}
  return;
}
// bodies the learner experienced as successful: graft sources
fn collect_sources(S:[]u8)void {
  let n:i32=0; let o:i32=0;
  while(o<5){
    if(sg(S,217+o)>=10 && sg(S,210+o)>0){
      if(n<4){ss(S,2360+n,o);n=n+1;}
    }
    o=o+1;
  }
  ss(S,2364,n);
  return;
}

// ============ construction drivers ============
// ============ parsimony pressure (P1), adaptive PLEN ============
// Composite fitness: fit(b) = replay(b) - plen_of(S)*len(b).
// pmode==0 (NP): raw replay, LB1-exact. pmode==2 (F-FULL): fixed 3,
// PARSIMONY-exact. pmode==3 (A-FULL): learner-owned adaptive plen
// from cell 2370 (init 0).
fn plen_of(S:[]u8)i32 {
  if(sg(S,2367)==3){return sg(S,2370);}
  return 3;
}
fn pop_fit(S:[]u8,i:i32)i32 {
  let sc:i32=sg(S,2318+i);
  if(sg(S,2367)==0){return sc;}
  return sc-plen_of(S)*sg(S,2310+i);
}
// Per-generation adaptive step (pmode==3 only): introduce pressure
// when the selector ignores exploitable parsimony. Fires at most
// 0->1: at plen>=1 the best-composite member is already the
// shortest among top-raw members, so the condition below is
// unsatisfiable (a strictly-shorter top-raw member would have
// strictly greater composite fitness and would be the best).
fn plen_adapt(S:[]u8)void {
  if(sg(S,2370)!=0){return;}
  let bi:i32=0; let bf:i32=pop_fit(S,0);
  let k:i32=1;
  while(k<8){
    let f:i32=pop_fit(S,k);
    if(f>bf){bf=f;bi=k;}
    k=k+1;
  }
  let braw:i32=sg(S,2318+bi); let blen:i32=sg(S,2310+bi);
  if(braw<850){return;}
  let sl:i32=blen; let q:i32=0;
  while(q<8){
    if(sg(S,2318+q)>=braw && sg(S,2310+q)<sl){sl=sg(S,2310+q);}
    q=q+1;
  }
  if(sl<blen){
    ss(S,2370,1);
    ss(S,2371,sg(S,2371)+1);
    emit("PLEN-ADJ plen=1 why=avail\n");
  }
  return;
}
fn pop_is_better(S:[]u8,ai:i32,bi:i32)i32 {
  if(sg(S,2367)>0){
    let fa:i32=pop_fit(S,ai); let fb:i32=pop_fit(S,bi);
    if(fa>fb){
      // inversion diagnostic (adaptive arm, reporting only):
      // composite winner ai has strictly lower raw replay than bi.
      if(sg(S,2367)==3 && sg(S,2318+ai)<sg(S,2318+bi)){
        ss(S,2372,sg(S,2372)+1);
      }
      return 1;
    }
    if(fa<fb){return 0;}
    if(sg(S,2326+ai)<sg(S,2326+bi)){return 1;}
    return 0;
  }
  let sa:i32=sg(S,2318+ai); let sb:i32=sg(S,2318+bi);
  if(sa>sb){return 1;}
  if(sa<sb){return 0;}
  let la:i32=sg(S,2310+ai); let lb:i32=sg(S,2310+bi);
  if(la<lb){return 1;}
  if(la>lb){return 0;}
  if(sg(S,2326+ai)<sg(S,2326+bi)){return 1;}
  return 0;
}
fn off_beats_pop(S:[]u8,j:i32,w:i32)i32 {
  if(sg(S,2367)>0){
    let fo:i32=sg(S,2346+j)-plen_of(S)*sg(S,2334+j);
    let fw:i32=pop_fit(S,w);
    if(fo>fw){
      // inversion diagnostic (adaptive arm, reporting only):
      // composite winner offspring has strictly lower raw than w.
      if(sg(S,2367)==3 && sg(S,2346+j)<sg(S,2318+w)){
        ss(S,2372,sg(S,2372)+1);
      }
      return 1;
    }
    return 0;
  }
  let so:i32=sg(S,2346+j); let sw:i32=sg(S,2318+w);
  if(so>sw){return 1;}
  if(so<sw){return 0;}
  if(sg(S,2334+j)<sg(S,2310+w)){return 1;}
  return 0;
}
fn construct_init(S:[]u8,BC:[]u8)void {
  let i:i32=0;
  while(i<8){
    let nin:i32=1+(xorsh(S,239)%2);
    let p:i32=1024+i*128;
    let prev:i32=0; let k:i32=0;
    while(k<nin){prev=sample_instr_to(S,BC,p+k*8,prev);k=k+1;}
    ss(S,2310+i,nin);
    ss(S,2318+i,graded_replay(S,BC,p,nin*8,0));
    ss(S,2326+i,0);
    i=i+1;
  }
  ss(S,858,8);
  return;
}
fn construct_init_rev(S:[]u8,BC:[]u8)void {
  let pc:i32=sg(S,803+5); let nin:i32=sg(S,810+5)/8;
  pop_copy(S,BC,0,pc,nin);
  ss(S,2318+0,graded_replay(S,BC,1024,nin*8,0));
  ss(S,2326+0,0);
  let i:i32=1;
  while(i<8){
    pop_copy(S,BC,i,pc,nin);
    pop_mutate_slot(S,BC,i);
    if((xorsh(S,239)%2)==0){pop_mutate_slot(S,BC,i);}
    ss(S,2318+i,graded_replay(S,BC,1024+i*128,sg(S,2310+i)*8,0));
    ss(S,2326+i,0);
    i=i+1;
  }
  ss(S,858,8);
  return;
}
// The evolutionary loop. No enumerated candidate family: bodies are
// sampled/mutated/recombined from an open space (<=16 instr).
// Returns best score; trials -> cell 858, best pop idx -> 859.
fn construct_gens(S:[]u8,BC:[]u8,maxgen:i32,arm:i32,xfer:i32)i32 {
  let trials:i32=sg(S,858);
  let g:i32=0;
  let gdone:i32=0;
  let fpass:i32=-1;
  let ns:i32=sg(S,2364);
  while(g<maxgen && gdone==0){
    let j:i32=0;
    while(j<12){
      let is_graft:i32=0;
      if(xfer==1 && ns>0 && j<ns){is_graft=1;}
      if(is_graft==1){
        let so:i32=sg(S,2360+j);
        op_graft(S,BC,j,so);
        op_targeted_mutate(S,BC,j);
      } else {
        let r:i32=xorsh(S,239)%100;
        if(r<25){
          let a:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a);
          op_mutate_slot(S,BC,j);
        } else if(r<40){
          let a2:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a2);
          op_targeted_mutate(S,BC,j);
        } else if(r<55){
          let a3:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a3);
          op_append(S,BC,j);
        } else if(r<65){
          let a4:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a4);
          op_insert(S,BC,j);
        } else if(r<70){
          let a5:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a5);
          op_delete(S,BC,j);
        } else if(r<85){
          let pa:i32=tournament(S); let pb:i32=tournament(S);
          op_crossover(S,BC,j,pa,pb);
        } else if(xfer==1 && ns>0){
          let pc2:i32=tournament(S);
          let sc2:i32=sg(S,2360+xorsh(S,239)%ns);
          op_crossover_xp(S,BC,j,pc2,sc2);
        } else {
          let a6:i32=tournament(S);
          off_copy_from_pop(S,BC,j,a6);
          op_mutate_slot(S,BC,j);
        }
      }
      let nl:i32=sg(S,2334+j);
      ss(S,2346+j,graded_replay(S,BC,2048+j*128,nl*8,0));
      trials=trials+1;
      j=j+1;
    }
    // policy reinforcement: consequence-shaped (all arms treat-like)
    if(arm==0 || arm==1 || arm==2){
      let psum:i32=0; let pi:i32=0;
      while(pi<8){psum=psum+sg(S,2318+pi);pi=pi+1;}
      let pmean:i32=psum/8;
      let j3:i32=0;
      while(j3<12){
        if(sg(S,2346+j3)>pmean){policy_walk(S,BC,2048+j3*128,sg(S,2334+j3));}
        j3=j3+1;
      }
    }
    // elitist selection: each offspring may displace the worst member
    let j2:i32=0;
    while(j2<12){
      let w:i32=0; let wi:i32=1;
      while(wi<8){
        if(pop_is_better(S,w,wi)==1){w=wi;}
        wi=wi+1;
      }
      if(off_beats_pop(S,j2,w)==1){
        let sp2:i32=2048+j2*128; let dp2:i32=1024+w*128;
        let nl2:i32=sg(S,2334+j2);
        let q2:i32=0;
        while(q2<nl2*8){BC[dp2+q2]=BC[sp2+q2];q2=q2+1;}
        ss(S,2310+w,nl2); ss(S,2318+w,sg(S,2346+j2)); ss(S,2326+w,0);
      }
      j2=j2+1;
    }
    let ai:i32=0;
    while(ai<8){ss(S,2326+ai,sg(S,2326+ai)+1);ai=ai+1;}
    let b:i32=0; let wi2:i32=0;
    while(wi2<8){
      if(sg(S,2318+wi2)>b){b=sg(S,2318+wi2);}
      wi2=wi2+1;
    }
    // parsimony refinement (pmode>0): keep searching up to 10
    // generations past the first raw passer so selection pressure
    // can discover shorter passers. pmode==0: LB1 early stop.
    if(b>=850){
      if(fpass<0){fpass=g;}
      let stop:i32=0;
      if(sg(S,2367)==0){stop=1;}
      if(sg(S,2367)>0 && g>=fpass+10){stop=1;}
      if(stop==1){gdone=1;}
    }
    // adaptive PLEN (pmode==3): learner-owned thermostat step.
    if(sg(S,2367)==3){plen_adapt(S);}
    g=g+1;
  }
  // best: pmode==0 -> max raw (LB1-exact); pmode>0 -> max composite.
  let fbi:i32=0;
  if(sg(S,2367)==0){
    let fb:i32=0; let wj:i32=0;
    while(wj<8){
      if(sg(S,2318+wj)>fb){fb=sg(S,2318+wj);fbi=wj;}
      wj=wj+1;
    }
  } else {
    let ff:i32=pop_fit(S,0); let wj2:i32=1;
    while(wj2<8){
      let fw2:i32=pop_fit(S,wj2);
      if(fw2>ff){ff=fw2;fbi=wj2;}
      wj2=wj2+1;
    }
  }
  ss(S,858,trials); ss(S,859,fbi);
  return sg(S,2318+fbi);
}
// Among population members with raw replay >= 850 (the adopt bar),
// pick the best by raw (pmode==0, LB1-exact) or composite fitness
// (pmode>0). Returns -1 if no passer. Adopt bars stay on raw replay.
fn best_passer_idx(S:[]u8)i32 {
  let bi:i32=-1;
  let i:i32=0;
  while(i<8){
    let ok:i32=0;
    if(sg(S,2318+i)>=850){ok=1;}
    if(ok==1){
      let take:i32=0;
      if(bi<0){take=1;}
      else {
        let better:i32=0;
        if(sg(S,2367)==0){
          if(sg(S,2318+i)>sg(S,2318+bi)){better=1;}
        }
        if(sg(S,2367)>0){
          if(pop_fit(S,i)>pop_fit(S,bi)){better=1;}
        }
        if(better==1){take=1;}
      }
      if(take==1){bi=i;}
    }
    i=i+1;
  }
  return bi;
}
// ============ parsimony pressure (P2): greedy compression ============
// Dead-instruction elimination on the adopted slot-5 body.
// A deletion is kept iff raw replay on the target ring does not
// decrease (parsimony only when success is equal). Deterministic.
// Researcher-authored generic operator; which deletions survive is
// consequence-determined. Scratch: offspring area [2048,2176),
// free outside construct_gens.
fn compress_body(S:[]u8,BC:[]u8)void {
  let pc:i32=sg(S,803+5);
  let nin:i32=sg(S,810+5)/8;
  let from_nin:i32=nin;
  let cur:i32=graded_replay(S,BC,pc,nin*8,0);
  let pass:i32=0;
  let cont:i32=1;
  while(pass<3 && cont==1){
    let improved:i32=0;
    let k:i32=0;
    while(k<nin){
      let q:i32=0;
      while(q<k*8){BC[2048+q]=BC[pc+q];q=q+1;}
      let q2:i32=(k+1)*8;
      while(q2<nin*8){BC[2048+q2-8]=BC[pc+q2];q2=q2+1;}
      let sc:i32=graded_replay(S,BC,2048,(nin-1)*8,0);
      if(sc>=cur){
        let q3:i32=0;
        while(q3<(nin-1)*8){BC[pc+q3]=BC[2048+q3];q3=q3+1;}
        nin=nin-1;
        ss(S,810+5,nin*8);
        cur=sc;
        improved=1;
        ss(S,2368,sg(S,2368)+1);
        ss(S,2369,sg(S,2369)+1);
        emit("COMPRESS-DEL k=");e64(k);emit(" nin=");e64(nin);
        emit(" sc=");e64(sc);emit("\n");
      } else {
        k=k+1;
      }
    }
    if(improved==0){cont=0;}
    pass=pass+1;
  }
  emit("COMPRESS-DONE from=");e64(from_nin);emit(" to=");e64(nin);
  emit(" score=");e64(cur);emit("\n");
  return;
}
fn try_create(S:[]u8,BC:[]u8,arm:i32,ep:i32)void {
  bias_imm_from_snaps(S);
  collect_sources(S);
  policy_seed(S,BC);
  let xfer:i32=1;
  ss(S,2290,sg(S,2290)-1);
  ss(S,841,sg(S,841)+1);
  construct_init(S,BC);
  construct_gens(S,BC,40,arm,xfer);
  let tr:i32=sg(S,858);
  let bi:i32=best_passer_idx(S);
  let best:i32=0;
  if(bi>=0){best=sg(S,2318+bi);}
  emit("CONSTRUCT-TRIED arm=");e64(arm);emit(" ep=");e64(ep);
  emit(" trials=");e64(tr);emit(" best=");e64(best);emit("\n");
  if(bi>=0){
    let sp:i32=1024+bi*128; let nin:i32=sg(S,2310+bi);
    let k:i32=0;
    while(k<nin*8){BC[512+k]=BC[sp+k];k=k+1;}
    ss(S,810+5,nin*8);
    ss(S,2294+5,4);
    ss(S,2301+5,0);
    let c0:i32=sg(S,2368);
    if(sg(S,2367)==2 || sg(S,2367)==3){compress_body(S,BC);}
    // adaptive PLEN post-adopt update (pmode==3): raise pressure
    // when compression proved shortening is free; lower it when
    // the adopted raw replay regressed vs the previous adoption.
    if(sg(S,2367)==3){
      let pl:i32=sg(S,2370);
      let pr:i32=sg(S,2373);
      if(pr>0 && best<pr){
        if(pl>0){
          ss(S,2370,pl-1);
          ss(S,2371,sg(S,2371)+1);
          emit("PLEN-ADJ plen=");e64(pl-1);emit(" why=regress\n");
        }
      } else if(sg(S,2368)>c0){
        if(pl<6){
          ss(S,2370,pl+1);
          ss(S,2371,sg(S,2371)+1);
          emit("PLEN-ADJ plen=");e64(pl+1);emit(" why=compress\n");
        }
      }
      ss(S,2373,best);
    }
    let fnin:i32=sg(S,810+5)/8;
    let rc:i32=0;
    while(rc<8){ssa(S,5,rc,0);sna(S,5,rc,0);rc=rc+1;}
    ss(S,210+5,0); ss(S,217+5,0);
    ss(S,832,tr); ss(S,834,best); ss(S,2358,1);
    emit("CONSTRUCT-ADOPT trials=");e64(tr);emit(" best=");e64(best);
    emit(" len=");e64(fnin);emit("\n");
  }
  return;
}
fn try_revise(S:[]u8,BC:[]u8,arm:i32,ep:i32,cur:i32)void {
  bias_imm_from_snaps(S);
  collect_sources(S);
  let xfer:i32=1;
  ss(S,2291,sg(S,2291)-1);
  ss(S,842,sg(S,842)+1);
  // new body, fresh evaluation: stale failures belong to the old body
  ss(S,210+5,0); ss(S,217+5,0);
  construct_init_rev(S,BC);
  construct_gens(S,BC,30,arm,xfer);
  let tr:i32=sg(S,858);
  let bi:i32=best_passer_idx(S);
  let best:i32=0;
  if(bi>=0){best=sg(S,2318+bi);}
  emit("REVISE-TRIED arm=");e64(arm);emit(" ep=");e64(ep);
  emit(" trials=");e64(tr);emit(" best=");e64(best);
  emit(" cur=");e64(cur);emit("\n");
  if(bi>=0 && best>cur+150){
    let sp:i32=1024+bi*128; let nin:i32=sg(S,2310+bi);
    let k:i32=0;
    while(k<nin*8){BC[512+k]=BC[sp+k];k=k+1;}
    ss(S,810+5,nin*8);
    ss(S,2294+5,5);
    let c0r:i32=sg(S,2368);
    if(sg(S,2367)==2 || sg(S,2367)==3){compress_body(S,BC);}
    // adaptive PLEN post-adopt update (pmode==3): as in try_create.
    if(sg(S,2367)==3){
      let plr:i32=sg(S,2370);
      let prr:i32=sg(S,2373);
      if(prr>0 && best<prr){
        if(plr>0){
          ss(S,2370,plr-1);
          ss(S,2371,sg(S,2371)+1);
          emit("PLEN-ADJ plen=");e64(plr-1);emit(" why=regress\n");
        }
      } else if(sg(S,2368)>c0r){
        if(plr<6){
          ss(S,2370,plr+1);
          ss(S,2371,sg(S,2371)+1);
          emit("PLEN-ADJ plen=");e64(plr+1);emit(" why=compress\n");
        }
      }
      ss(S,2373,best);
    }
    let fnin:i32=sg(S,810+5)/8;
    let rc:i32=0;
    while(rc<8){ssa(S,5,rc,0);sna(S,5,rc,0);rc=rc+1;}
    ss(S,210+5,0); ss(S,217+5,0);
    ss(S,833,tr); ss(S,835,best); ss(S,2359,1);
    emit("REVISE-ADOPT trials=");e64(tr);emit(" best=");e64(best);
    emit(" len=");e64(fnin);emit("\n");
  }
  return;
}
// unserved context: no innate op is any good at ctx0=0
fn unserved(S:[]u8)i32 {
  let o:i32=0;
  while(o<5){
    if(sg(S,56+o*8)>=10 && appl_mx(S,o,0)>600){return 0;}
    o=o+1;
  }
  return 1;
}
fn create_trigger_ok(S:[]u8)i32 {
  if(sg(S,810+5)>0){return 0;}
  if(sg(S,2290)<=0){return 0;}
  if(sg(S,2180+0)<6){return 0;}
  if(unserved(S)==0){return 0;}
  return 1;
}
// ============ menu arm: researcher-enumerated baseline ============
// Duplicate op 0, exhaustive single-SET-imm (0..7). The menu that
// the open-form constructor is compared against.
fn menu_search(S:[]u8,BC:[]u8,pc:i32,pl:i32)i32 {
  let champ:i32=graded_replay(S,BC,pc,pl,0);
  ss(S,2366,champ);
  let best:i32=champ;
  let nin:i32=pl/8;
  let trials:i32=1;
  ss(S,858,-1); ss(S,859,-1);
  let ii:i32=0;
  while(ii<nin){
    if(BC[pc+ii*8] as i32==1){
      let imm:i32=0;
      while(imm<=7){
        let q:i32=0;
        while(q<pl){BC[2048+q]=BC[pc+q];q=q+1;}
        set32(BC,2048+ii*8+4,imm);
        let sc:i32=graded_replay(S,BC,2048,pl,0);
        trials=trials+1;
        if(sc>best){
          best=sc;
          let q2:i32=0;
          while(q2<pl){BC[3712+q2]=BC[2048+q2];q2=q2+1;}
          ss(S,858,ii); ss(S,859,imm);
        }
        imm=imm+1;
      }
    }
    ii=ii+1;
  }
  ss(S,2365,trials);
  return best;
}
fn menu_adopt(S:[]u8,BC:[]u8,ep:i32,is_rev:i32)void {
  if(is_rev==0){
    let pc0:i32=sg(S,803); let pl0:i32=sg(S,810);
    let k:i32=0;
    while(k<pl0){BC[512+k]=BC[pc0+k];k=k+1;}
    ss(S,810+5,pl0);
  }
  let best:i32=menu_search(S,BC,512,sg(S,810+5));
  let tr:i32=sg(S,2365); let champ:i32=sg(S,2366);
  ss(S,843,sg(S,843)+1);
  ss(S,836,sg(S,836)+1);
  emit("ENUM-SEARCH rev=");e64(is_rev);emit(" trials=");e64(tr);
  emit(" best=");e64(best);emit(" champ=");e64(champ);emit("\n");
  if(best>champ+150 && best>=600){
    let pl:i32=sg(S,810+5);
    let q:i32=0;
    while(q<pl){BC[512+q]=BC[3712+q];q=q+1;}
    ss(S,2294+5,2);
    ss(S,2301+5,0);
    let rc:i32=0;
    while(rc<8){ssa(S,5,rc,0);sna(S,5,rc,0);rc=rc+1;}
    ss(S,210+5,0); ss(S,217+5,0);
    if(is_rev==0){ss(S,832,tr);ss(S,2358,1);}
    else {ss(S,833,tr);ss(S,2359,1);}
    emit("MENU-ADOPT rev=");e64(is_rev);emit(" trials=");e64(tr);
    emit(" best=");e64(best);emit("\n");
  } else {
    if(is_rev==0){ss(S,810+5,0);}
  }
  return;
}
fn menu_trigger(S:[]u8,BC:[]u8,ep:i32)void {
  if(sg(S,2293)==0){
    if(create_trigger_ok(S)==0){return;}
    ss(S,2290,sg(S,2290)-1);
    menu_adopt(S,BC,ep,0);
  } else {
    if(sg(S,810+5)==0 || sg(S,2291)<=0){return;}
    if(sg(S,2180+0)<6 || ep<450){return;}
    let cur:i32=graded_replay(S,BC,sg(S,803+5),sg(S,810+5),0);
    if(cur<400){
      ss(S,2291,sg(S,2291)-1);
      menu_adopt(S,BC,ep,1);
    }
  }
  return;
}
// ============ researcher-authored comparison body (replay-only) ============
// Hand-written minimal gather for the N3 family. Never installed;
// only replayed, pre/post shift. Frozen: cannot adapt.
fn build_hand(BC:[]u8)void {
  let p:i32=3584;
  p=asmi(BC,p,1,0,0,0,5);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  return;
}
fn hand_check(S:[]u8,BC:[]u8)i32 {
  build_hand(BC);
  return graded_replay(S,BC,3584,48,0);
}
// ============ one episode ============
fn run_ep(S:[]u8,BC:[]u8,ep:i32,epsx:i32)void {
  let typ:i32=env_build(S);
  ss(S,795+7,0);
  let ctx0:i32=cog_probe(S);
  let step:i32=0; let prev:i32=7; let nu:i32=0;
  let umask:i32=0;
  let uo:[]u8=z_alloc(4); let uc:[]u8=z_alloc(4);
  let up:[]u8=z_alloc(4); let us:[]u8=z_alloc(4); let ua:[]u8=z_alloc(16);
  let solved:i32=0;
  if(ep<3){ emit("TR ep="); e64(ep); emit(" typ="); e64(typ); }
  while(step<4 && solved==0){
    let ctx:i32=cog_probe(S);
    let o:i32=cog_select(S,ctx,prev,epsx);
    cog_exec(S,BC,o);
    let st:i32=sg(S,817); let an:i32=sg(S,818);
    uo[nu]=o as u8; uc[nu]=ctx as u8; up[nu]=prev as u8; us[nu]=st as u8;
    set32(ua,nu*4,an);
    umask=umask | (1 << o);
    nu=nu+1;
    if(ep<3){ emit(" [o="); e64(o); emit(" c="); e64(ctx); emit(" s="); e64(st); emit("]"); }
    if(st==2 && an==sg(S,819)){solved=1;}
    prev=o; step=step+1;
  }
  if(ep<3){ emit(" solved="); e64(solved); emit("\n"); }
  let i:i32=0;
  while(i<nu){
    let o2:i32=uo[i] as i32; let c2:i32=uc[i] as i32;
    let p2:i32=up[i] as i32; let s2:i32=us[i] as i32;
    let a2:i32=get32(ua,i*4);
    let rec:i32=0;
    if(s2==2){
      if(a2==sg(S,819)){rec=1;} else {rec=-1;}
    } else if(s2==1){
      if(solved==1){rec=1;}
    }
    ssa(S,o2,c2,asg(S,o2,c2)+rec);
    sna(S,o2,c2,ang(S,o2,c2)+1);
    if(i>0 && p2<7 && (us[i-1] as i32)!=0){
      scs(S,p2,o2,csg(S,p2,o2)+rec);
      scn(S,p2,o2,cng(S,p2,o2)+1);
    }
    ss(S,210+o2,sg(S,210+o2)+rec);
    ss(S,217+o2,sg(S,217+o2)+1);
    let lh:i32=sg(S,240); let li:i32=241+(lh % 96)*5;
    ss(S,li,ep); ss(S,li+1,o2); ss(S,li+2,c2); ss(S,li+3,rec); ss(S,li+4,typ);
    ss(S,240,lh+1);
    i=i+1;
  }
  if(nu==1){
    let so:i32=uo[0] as i32;
    ss(S,851+so,sg(S,851+so)+1);
    if(solved==1){ss(S,844+so,sg(S,844+so)+1);}
  }
  ss(S,859,umask); ss(S,860,ctx0);
  snap_push(S);
  cog_stats(S,ep,typ,solved);
  return;
}
// ============ stats, retirement (generic consequence rule) ============
fn cog_stats(S:[]u8,ep:i32,typ:i32,solved:i32)void {
  if(typ==3){
    if(ep>=300 && ep<400){
      ss(S,821,sg(S,821)+1);
      if(solved==1){ss(S,820,sg(S,820)+1);}
    } else if(ep>=600){
      ss(S,823,sg(S,823)+1);
      if(solved==1){ss(S,822,sg(S,822)+1);}
    }
  }
  let o:i32=0;
  while(o<7){
    if(sg(S,810+o)>0 && sg(S,224+o)==0 && sg(S,217+o)>=12 && sg(S,210+o)*10<-6*sg(S,217+o)){
      ss(S,224+o,1); ss(S,231+o,ep);
      emit("RETIRE op=");e64(o);emit(" ep=");e64(ep);emit("\n");
    }
    o=o+1;
  }
  return;
}
// ============ white-box checks ============
fn body_eq(BC:[]u8,p1:i32,l1:i32,p2:i32,l2:i32)i32 {
  if(l1!=l2){return 0;}
  if(l1<=0){return 0;}
  let k:i32=0;
  while(k<l1){
    if(BC[p1+k]!=BC[p2+k]){return 0;}
    k=k+1;
  }
  return 1;
}
fn compute_novel(S:[]u8,BC:[]u8)void {
  let nv:i32=0;
  let p5:i32=sg(S,803+5); let l5:i32=sg(S,810+5);
  if(l5>0){
    nv=1;
    let o:i32=0;
    while(o<5){
      if(body_eq(BC,p5,l5,sg(S,803+o),sg(S,810+o))==1){nv=0;}
      o=o+1;
    }
  }
  ss(S,840,nv);
  return;
}
fn compute_has_set6(S:[]u8,BC:[]u8)void {
  let f:i32=0;
  let p:i32=sg(S,803+5); let nin:i32=sg(S,810+5)/8;
  let i:i32=0;
  while(i<nin){
    if(BC[p+i*8] as i32==1 && get32(BC,p+i*8+4)==6){f=1;}
    i=i+1;
  }
  ss(S,839,f);
  return;
}
// ============ report + preregistered verdicts K1-K6 ============
fn lb_report(S:[]u8,BC:[]u8,R:[]u8,arm:i32)void {
  emit("ORIGINS:");
  let o:i32=0;
  while(o<7){emit(" ");e64(sg(S,2294+o));o=o+1;}
  emit("\n");
  emit("BODY5 len=");e64(sg(S,810+5));emit(" instr:\n");
  let nin:i32=sg(S,810+5)/8; let i:i32=0;
  while(i<nin){
    emit(" I ");e64(BC[512+i*8] as i32);
    emit(" ");e64(BC[512+i*8+1] as i32);
    emit(" ");e64(BC[512+i*8+2] as i32);
    emit(" ");e64(BC[512+i*8+3] as i32);
    emit(" ");e64(get32(BC,512+i*8+4));
    emit("\n");
    i=i+1;
  }
  let n3pre_n:i32=sg(S,821); let n3pre_ok:i32=sg(S,820);
  let n3post_n:i32=sg(S,823); let n3post_ok:i32=sg(S,822);
  emit("N3PRE ");e64(n3pre_ok);emit("/");e64(n3pre_n);
  emit(" N3POST ");e64(n3post_ok);emit("/");e64(n3post_n);
  emit(" HAND ");e64(sg(S,828));emit("/");e64(sg(S,829));
  emit(" FINAL ");e64(sg(S,830));emit("\n");
  emit("TRIALS create=");e64(sg(S,832));emit(" revise=");e64(sg(S,833));
  emit(" enum=");e64(sg(S,836));
  emit(" immc6 ");e64(sg(S,837));emit("->");e64(sg(S,838));
  emit(" has_set6=");e64(sg(S,839));emit(" novel=");e64(sg(S,840));emit("\n");
  emit("COMPRESS strict=");e64(sg(S,2368));emit(" dels=");e64(sg(S,2369));emit("\n");
  emit("PLEN end=");e64(sg(S,2370));emit(" adj=");e64(sg(S,2371));
  emit(" inv=");e64(sg(S,2372));emit("\n");
  // R buffer: 96 bytes/arm for cross-arm verdicts in main().
  let rb:i32=arm*96;
  set32(R,rb,sg(S,832));
  set32(R,rb+4,sg(S,2358));
  set32(R,rb+8,sg(S,833));
  set32(R,rb+12,sg(S,2359));
  set32(R,rb+16,sg(S,810+5));
  set32(R,rb+20,sg(S,2368));
  set32(R,rb+24,sg(S,820));
  set32(R,rb+28,sg(S,821));
  set32(R,rb+32,sg(S,822));
  set32(R,rb+36,sg(S,823));
  set32(R,rb+40,sg(S,828));
  set32(R,rb+44,sg(S,829));
  set32(R,rb+48,sg(S,830));
  set32(R,rb+52,sg(S,836));
  set32(R,rb+56,sg(S,224+3));
  set32(R,rb+60,sg(S,224+5));
  set32(R,rb+64,sg(S,834));
  set32(R,rb+68,sg(S,835));
  set32(R,rb+72,sg(S,839));
  set32(R,rb+76,sg(S,840));
  set32(R,rb+80,sg(S,2370));
  set32(R,rb+84,sg(S,2372));
  set32(R,rb+88,sg(S,2371));
  return;
}
// ============ one arm: fresh learner, 700 episodes ============
fn lb_arm(arm:i32,R:[]u8)void {
  let S:[]u8=z_alloc(16384);
  let BC:[]u8=z_alloc(4096);
  ss(S,238,123456789); ss(S,239,987654321);
  ss(S,2292,arm);
  build_bodies(S,BC);
  let i:i32=0;
  while(i<8){ss(S,2200+i,1);i=i+1;}
  i=0; while(i<64){ss(S,2208+i,1);i=i+1;}
  i=0; while(i<8){ss(S,2272+i,1);i=i+1;}
  i=0; while(i<9){ss(S,2280+i,1);i=i+1;}
  ss(S,2290,2); ss(S,2291,2);
  ss(S,2370,0); ss(S,2371,0); ss(S,2372,0); ss(S,2373,0);
  if(arm==0){emit("ARM A-FULL\n"); ss(S,2367,3);}
  else if(arm==1){emit("ARM F-FULL\n"); ss(S,2367,2);}
  else {emit("ARM NP\n"); ss(S,2367,0);}
  let ep:i32=0;
  while(ep<700){
    if(ep==400){ss(S,2293,1);emit("SHIFT etype 5->6\n");}
    let ex:i32=(300*300)/(300+ep);
    run_ep(S,BC,ep,ex);
    if(ep==399){
      ss(S,828,hand_check(S,BC));
      ss(S,837,sg(S,2287));
      emit("HAND-PRE ");e64(sg(S,828));emit(" immc6=");e64(sg(S,837));emit("\n");
    }
    if(ep>=50 && ep%25==24){
      if(sg(S,2293)==0){
        if(create_trigger_ok(S)==1){try_create(S,BC,arm,ep);}
      } else {
        if(sg(S,810+5)==0){
          if(create_trigger_ok(S)==1){try_create(S,BC,arm,ep);}
        } else {
          let og:i32=sg(S,2294+5);
          if((og==4 || og==5) && sg(S,2291)>0 && sg(S,2180+0)>=6 && ep>=450){
            let cur:i32=graded_replay(S,BC,sg(S,803+5),sg(S,810+5),0);
            if(cur<400){try_revise(S,BC,arm,ep,cur);}
          }
        }
      }
    }
    if(ep%100==99){
      emit("EP ");e64(ep+1);
      emit(" n3=");e64(sg(S,820)+sg(S,822));emit("/");e64(sg(S,821)+sg(S,823));
      emit(" done\n");
    }
    ep=ep+1;
  }
  ss(S,829,hand_check(S,BC));
  ss(S,838,sg(S,2287));
  let fp:i32=0;
  if(sg(S,810+5)>0){fp=graded_replay(S,BC,sg(S,803+5),sg(S,810+5),0);}
  ss(S,830,fp);
  compute_has_set6(S,BC);
  compute_novel(S,BC);
  emit("HAND-POST ");e64(sg(S,829));emit(" FINAL-POST ");e64(sg(S,830));
  emit(" immc6=");e64(sg(S,838));emit("\n");
  lb_report(S,BC,R,arm);
  return;
}
fn main()i32 {
  emit("AP-START\n");
  let R:[]u8=z_alloc(384);
  lb_arm(0,R);
  lb_arm(1,R);
  lb_arm(2,R);
  // R layout per arm (96 bytes): +0 create_trials, +4 create_adopted,
  // +8 revise_trials, +12 revise_adopted, +16 final_len_bytes,
  // +20 compress_strict, +24 n3pre_ok, +28 n3pre_n, +32 n3post_ok,
  // +36 n3post_n, +40 hand_pre, +44 hand_post, +48 final_post,
  // +52 enum_events, +56 retired_op3, +60 retired_slot5,
  // +64 create_best, +68 revise_best, +72 has_set6, +76 novel,
  // +80 plen_end, +84 plen_inv_tot, +88 plen_adj.
  // Arm 0 = A-FULL (adaptive PLEN), arm 1 = F-FULL (fixed PLEN=3),
  // arm 2 = NP (LB1-exact).
  // K1 PARSEFFECT: A-FULL final <= 8 instr (64B) and < NP final.
  let pflen:i32=get32(R,16); let nflen:i32=get32(R,192+16);
  let k1:i32=0;
  if(pflen>0 && pflen<=64 && pflen<nflen){k1=1;}
  // K2 SUCCESS-PRESERVED: all arms pre/post N3 >= 70%.
  let k2:i32=1;
  let a2:i32=0;
  while(a2<3){
    let rb2:i32=a2*96;
    let pok:i32=get32(R,rb2+24); let pn:i32=get32(R,rb2+28);
    let qok:i32=get32(R,rb2+32); let qn:i32=get32(R,rb2+36);
    if(pn<=0 || pok*100<70*pn){k2=0;}
    if(qn<=0 || qok*100<70*qn){k2=0;}
    a2=a2+1;
  }
  // K3 REPLICATION: NP == LB1 arm 0 (92 trials, 11 instr/88B);
  // F-FULL == PARSIMONY P-FULL (create 212, revise 188,
  // final 6 instr/48B, create_best>=850).
  let k3:i32=0;
  let np_ct:i32=get32(R,192); let np_ad:i32=get32(R,196);
  let ff_ct:i32=get32(R,96); let ff_ad:i32=get32(R,100);
  let ff_rt:i32=get32(R,104); let ff_fl:i32=get32(R,112);
  let ff_cb:i32=get32(R,160);
  if(np_ad==1 && np_ct==92 && nflen==88 && ff_ad==1 && ff_ct==212 && ff_rt==188 && ff_fl==48 && ff_cb>=850){k3=1;}
  // K4 REVISE-PARSIMONY: A-FULL revises, post N3 >= 70%,
  // revise_trials < create_trials.
  let k4:i32=0;
  let pf_rt:i32=get32(R,8); let pf_ra:i32=get32(R,12);
  let pf_ct:i32=get32(R,0);
  let pf_qok:i32=get32(R,32); let pf_qn:i32=get32(R,36);
  if(pf_ra==1 && pf_qn>0 && pf_qok*100>=70*pf_qn && pf_rt<pf_ct){k4=1;}
  // K5 VS-RESEARCHER (A-FULL).
  let k5:i32=0;
  if(get32(R,40)>=850 && get32(R,44)<400 && get32(R,48)>=850){k5=1;}
  // K6 OPEN-FORM: all arms enum==0 and create_trials>=20.
  let k6:i32=1;
  let a6:i32=0;
  while(a6<3){
    let rb6:i32=a6*96;
    if(get32(R,rb6+52)!=0){k6=0;}
    if(get32(R,rb6)<20){k6=0;}
    a6=a6+1;
  }
  // K9 COMPRESS-CAUSAL: >=1 strict-decrease COMPRESS event, A-FULL.
  let k9:i32=0;
  if(get32(R,20)>=1){k9=1;}
  // K10 RETIRE: op3 retired in all arms; slot5 not retired in any.
  let k10:i32=1;
  let a10:i32=0;
  while(a10<3){
    let rb10:i32=a10*96;
    if(get32(R,rb10+56)!=1){k10=0;}
    if(get32(R,rb10+60)!=0){k10=0;}
    a10=a10+1;
  }
  // K11 PLEN-ADAPTED: A-FULL plen moved off the 0 default into
  // [1,6] via >=1 experienced adjustment.
  let k11:i32=0;
  let pl_end:i32=get32(R,80); let pl_adj:i32=get32(R,88);
  if(pl_end>=1 && pl_end<=6 && pl_adj>=1){k11=1;}
  // K12 PLEN-SAFE: A-FULL reaches the same perfect minimal outcome
  // as fixed PLEN=3 (final replay 1000, 6 instr/48B): no
  // working-for-broken trade anywhere in the pipeline.
  let k12:i32=0;
  if(get32(R,48)==1000 && get32(R,16)==48){k12=1;}
  // Preregistered tradeoff report: adaptive vs fixed vs NP trial
  // cost, plus the learner-owned PLEN trajectory summary.
  emit("TRADEOFF");
  let at:i32=0;
  while(at<3){
    let rbt:i32=at*96;
    emit(" arm=");e64(at);
    emit(" create_trials=");e64(get32(R,rbt));
    emit(" revise_trials=");e64(get32(R,rbt+8));
    emit(" final_lenB=");e64(get32(R,rbt+16));
    emit(" compress=");e64(get32(R,rbt+20));
    emit(" plen_end=");e64(get32(R,rbt+80));
    emit(" plen_inv=");e64(get32(R,rbt+84));
    emit(" plen_adj=");e64(get32(R,rbt+88));
    at=at+1;
  }
  emit("\n");
  emit("OVERALL K1=");e64(k1);emit(" K2=");e64(k2);emit(" K3=");e64(k3);
  emit(" K4=");e64(k4);emit(" K5=");e64(k5);emit(" K6=");e64(k6);
  emit(" K9=");e64(k9);emit(" K10=");e64(k10);
  emit(" K11=");e64(k11);emit(" K12=");e64(k12);emit(" ");
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1 && k9==1 && k10==1 && k11==1 && k12==1){
    emit("ADAPTIVEPLEN-COMPLETE\n");
  } else { emit("INCOMPLETE\n"); }
  emit("AP-END\n");
  return 0;
}

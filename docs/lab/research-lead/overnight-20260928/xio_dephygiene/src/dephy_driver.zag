// dephy_driver.zag: H0/H1/H2/H34/H5a/H5b behavioral cases for the DEP-hygiene repair.
// Pure Zag. Safebin PATH. Predictions frozen in PREREG.md (K1-K6).
fn rt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){ ev_teach(W,5000+i,60+(i%10),6000+i); i=i+1; }
  return;
}
fn rt_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1="); e64(x1); emit("\n");
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2="); e64(x2); emit("\n");
  return;
}
fn rt_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1="); e64(y1); emit("\n");
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2="); e64(y2); emit("\n");
  return;
}
fn rt_zfacts(W:[]u8,b:i32)void {
  ev_teach(W,b,81,b+1); ev_teach(W,b+1,81,b+2); ev_teach(W,b+2,81,b+3);
  ev_teach(W,b+3,82,b+4); ev_teach(W,b+4,82,b+5);
  return;
}
fn rt_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// A4c setup through adapter build. Returns m1 (adapter's stage-1 id).
fn setup_a4c(W:[]u8)i32 {
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  rt_zfacts(W,31);
  let q1:i32=xio_query(W,31,93,2,0,1);
  emit("S q1="); e64(q1); emit("\n");
  let ad:i32=xio_find(W,93);
  let m1:i32=ng(W,ad,4);
  emit("S ad="); e64(ad); emit(" m1="); e64(m1); emit("\n");
  return m1;
}
// Teach the replacement count facts, build the count graph. Fills cf.
// Returns the graph root.
fn teach_new(W:[]u8,cf:[]u8)i32 {
  ev_teach(W,36,82,39);
  let c1:i32=ev_teach(W,31,82,41);
  let c2:i32=ev_teach(W,41,82,42);
  let c3:i32=ev_teach(W,42,82,43);
  let c4:i32=ev_teach(W,43,82,44);
  let c5:i32=ev_teach(W,44,82,45);
  let c6:i32=ev_teach(W,45,82,46);
  let c7:i32=ev_teach(W,46,82,47);
  ev_teach(W,7,82,70); ev_teach(W,70,82,71);
  let cv:[]u8=z_alloc(32);
  set32(cv,0,31); set32(cv,4,41); set32(cv,8,42); set32(cv,12,43);
  set32(cv,16,44); set32(cv,20,45); set32(cv,24,46); set32(cv,28,47);
  set32(cf,0,c1); set32(cf,4,c2); set32(cf,8,c3); set32(cf,12,c4);
  set32(cf,16,c5); set32(cf,20,c6); set32(cf,24,c7);
  let croot:i32=t2_asm_count(W,cv,8,cf);
  return croot;
}
// Count type-1 edges with from==v.
fn count_t1_from(W:[]u8,v:i32)i32 {
  let e:i32=0; let n:i32=0;
  while(e<4096){
    if(eg(W,e,0)==v && eg(W,e,4)==1){ n=n+1; }
    e=e+1;
  }
  return n;
}
// H0: liveness. Delete (raw), probe dep_rel BEFORE recycle.
fn h0()void {
  emit("=== H0 LIVENESS ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let m1:i32=setup_a4c(W);
  rt_del_map_r(W,91);
  let dr:i32=xio_dep_rel(W,m1);
  emit("H0 dep_rel(dead m1)="); e64(dr); emit(" (expect -1)\n");
  return;
}
// H1: hygiene-aware delete, then recycle.
fn h1()void {
  emit("=== H1 HYGIENE-DELETE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let m1:i32=setup_a4c(W);
  let cf:[]u8=z_alloc(28);
  let croot:i32=teach_new(W,cf);
  let pre:i32=count_t1_from(W,m1);
  xio_del_map_rh(W,91);
  let post:i32=count_t1_from(W,m1);
  let tomb:i32=count_t1_from(W,-2);
  emit("H1 t1-from-m1 pre="); e64(pre); emit(" post="); e64(post);
  emit(" tombstoned="); e64(tomb); emit(" (expect post=0, tomb>0)\n");
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("H1 nm="); e64(nm); emit(" reused="); e64(nm==m1); emit("\n");
  let dr:i32=xio_dep_rel(W,ng(W,xio_find(W,93),4));
  emit("H1 dep_rel="); e64(dr); emit(" (expect 82)\n");
  return;
}
// H2: raw delete (missed hygiene), then recycle.
fn h2()void {
  emit("=== H2 RAW-DELETE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let m1:i32=setup_a4c(W);
  let cf:[]u8=z_alloc(28);
  let croot:i32=teach_new(W,cf);
  rt_del_map_r(W,91);
  let stale:i32=count_t1_from(W,m1);
  emit("H2 stale t1-from-m1="); e64(stale); emit(" (expect >0, not tombstoned)\n");
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("H2 nm="); e64(nm); emit(" reused="); e64(nm==m1); emit("\n");
  let dr:i32=xio_dep_rel(W,ng(W,xio_find(W,93),4));
  emit("H2 dep_rel="); e64(dr); emit(" (expect 82 via graph filter)\n");
  return;
}
// H34: masked poisoning retest + unmasked follow-up + poison census.
fn h34()void {
  emit("=== H34 MASKED-POISON ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let m1:i32=setup_a4c(W);
  let cf:[]u8=z_alloc(28);
  let croot:i32=teach_new(W,cf);
  rt_del_map_r(W,91);
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("H34 nm="); e64(nm); emit("\n");
  let qm:i32=xio_query(W,31,93,-2,1,1);
  emit("H34 masked qm="); e64(qm); emit(" (expect 70, with XIO-MASKED-REFUSED above)\n");
  let fn_:i32=find_fact(W,31,93,70);
  emit("H34 poisoned fact id="); e64(fn_); emit("\n");
  let ss:i32=0;
  if(fn_>=0){ ss=is_superseded(W,fn_); }
  emit("H34 superseded="); e64(ss); emit(" (expect 1)\n");
  let qu:i32=xio_query(W,31,93,3,0,1);
  emit("H34 unmasked qu="); e64(qu); emit(" (expect 3)\n");
  let n:i32=2; let pc:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==31 && ng(W,n,24)==93 && ng(W,n,28)==70){
      if(is_superseded(W,n)==0){ pc=pc+1; }
    }
    n=n+1;
  }
  emit("H34 live-nonsuperseded-poison="); e64(pc); emit(" (expect 0)\n");
  return;
}
// H5a: legitimate unmasked learning on the repaired core.
fn h5a()void {
  emit("=== H5a LEGIT-LEARN ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let q1:i32=xio_query(W,11,91,14,0,1);
  let q2:i32=xio_query(W,11,91,14,0,1);
  emit("H5a q1="); e64(q1); emit(" q2="); e64(q2); emit(" (expect 14, 14)\n");
  return;
}
// H5b: contradiction predicate discrimination (snapshot API).
fn h5b()void {
  emit("=== H5b CONTRA-DISCRIM ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let m1:i32=setup_a4c(W);
  let va:[]u8=z_alloc(64);
  let vc:i32=xio_snap_verified(W,93,va,16);
  emit("H5b vc="); e64(vc); emit(" (expect 1)\n");
  let c_match:i32=xio_contra_snap(va,vc,2);
  let c_contra:i32=xio_contra_snap(va,vc,70);
  emit("H5b contra(93,2)="); e64(c_match); emit(" (expect 0)\n");
  emit("H5b contra(93,70)="); e64(c_contra); emit(" (expect 1)\n");
  let va2:[]u8=z_alloc(64);
  let vc2:i32=xio_snap_verified(W,97,va2,16);
  let c_norel:i32=xio_contra_snap(va2,vc2,5);
  emit("H5b contra(97,5)="); e64(c_norel); emit(" (expect 0)\n");
  return;
}
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("DEPHY-START\n");
  h0(); h1(); h2(); h34(); h5a(); h5b();
  emit("DEPHY-END\n");
  return 0;
}

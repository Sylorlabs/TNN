fn e11_run(D:i32,mode:i32,ph:i32,extra:i32,tag:[]u8)void {
  emit("E11START "); emit(tag);
  emit(" D="); e64(D); emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" extra="); e64(extra); emit(" TOT="); e64(TOT()); emit("\n");
  let W:[]u8=e11_big(); e11_setup(W,mode);
  let qi:i32=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  e11_dump(W,"after_facts",D,mode,ph);
  if(ph==1){ emit("E11END\n"); return; }
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(e11_mkbroken(W,20000+i,51,20001+i)<0){fails=fails+1;}
    i=i+1;
  }
  i=0;
  while(i<5){
    if(e11_mkchain(W,5000+i*10,5,51,5004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit("E11BUILD fails="); e64(fails);
  emit(" evictions="); e64(pget(W,68));
  emit(" sel_fast_visits="); e64(pget(W,822));
  emit(" sel_scan_visits="); e64(pget(W,824));
  emit(" reclaimed="); e64(pget(W,830));
  emit(" tombstones="); e64(pget(W,833));
  emit(" bid_max="); e64(bid_max(W));
  emit("\n");
  e11_dump(W,"after_build",D,mode,ph);
  if(ph==2){ emit("E11END\n"); return; }
  set32(W,TRC(),0);
  qi=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    e11_q(W,q,"q");
    e11_dump(W,"after_q",D,mode,ph);
    qi=qi+1;
  }
  e11_report(W,"post"); e11_vtrace(W);
  emit("E11END\n");
  return;
}
// ---------- K4 test world: RECENT JUNK vs OLD FOUNDATIONAL ----------
fn e11_junk_found(JF:i32,mode:i32)void {
  emit("E11JF mode="); e64(mode); emit(" JF="); e64(JF); emit("\n");
  let W:[]u8=e11_big(); e11_setup(W,mode);
  // FOUNDATIONAL: old MAPs with LONG graphs that later MAPs depend on through
  // shared facts. Built FIRST so they get the LOWEST ids.
  let NF:i32=6;
  let fid:[]u8=z_alloc(24);
  let fi:i32=0;
  while(fi<NF){
    // foundational MAP fi: a 5-cell chain over its own subject block, plus it
    // teaches the shared fact that the junk MAPs will also cite.
    ev_teach(W,1000+fi,1,7000+fi);
    ev_teach(W,1000+fi,2,7000+fi);
    let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
    ev_teach(W,1000+fi,1,1001+fi); ev_teach(W,1001+fi,1,1002+fi);
    ev_teach(W,1002+fi,1,1003+fi); ev_teach(W,1003+fi,1,1004+fi);
    let len:i32=t2_chain(W,1000+fi,1,v,f);
    let root:i32=t2_asm_chain(W,v,len,f);
    let pm:i32=promote_graph(W,root,1000+fi,50,7000+fi,f,len-1);
    set32(fid,fi*4,pm);
    fi=fi+1;
  }
  // JUNK: recent short BROKEN MAPs. Each one CITES a foundational MAP with a
  // type-1 edge -- the engine's own representation of composition, and the only
  // thing that makes the frozen selection key able to tell the two populations
  // apart at all.
  //
  // C553 WHY THIS EDGE IS THE WHOLE TEST. bid_ref(n) counts edges INTO n:
  // evcount(n,1)+evcount(n,2)+evcount(n,6)+evcount(n,7)-evcount(n,3). Every MAP
  // gets its own self-edges type 2 and type 6, so every MAP starts at bid 2.
  // Without a citation edge the in-degrees are ALL EQUAL, min-bid degenerates
  // to the lowest id from the cursor, and the "structural" policy is
  // bit-identical to LRU-by-id: K4 would be INCONCLUSIVE by construction and
  // the test would prove nothing. The citation edge is therefore not a
  // thumb on the scale, it is the only thing that gives the frozen key any
  // signal to act on. Junk MAPs keep bid 2; each foundational MAP's in-degree
  // rises to roughly JF/NF.
  let ji:i32=0;
  while(ji<JF){
    let pm:i32=e11_mkbroken(W,20000+ji,51,20001+ji);
    if(pm<0){emit("E11JF jfail\n");}
    else { link_edge(W,pm,1,get32(fid,((ji%NF+NF)%NF)*4),0); }
    ji=ji+1;
  }
  emit("E11JF built found="); e64(NF);
  emit(" junk="); e64(JF);
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" evictions="); e64(pget(W,68));
  emit(" reclaimed="); e64(pget(W,830));
  emit(" evict_tag20="); e64(pget(W,85));
  emit(" evict_nontag20="); e64(pget(W,84));
  emit(" evict_FOUND="); e64(pget(W,86));
  emit(" evict_JUNK="); e64(pget(W,87));
  emit(" evict_unclass="); e64(pget(W,920));
  emit(" classid_ok="); e64(pget(W,85)==pget(W,86)+pget(W,87)+pget(W,920));
  emit(" sel_visits="); e64(pget(W,822)+pget(W,912));
  emit(" idx_skips="); e64(pget(W,914));
  emit(" idxmode_lost="); e64(pget(W,915));
  emit(" pol_fail="); e64(pget(W,930));
  emit(" own_prot="); e64(pget(W,932));
  emit(" probes_fast="); e64(pget(W,933));
  emit(" probes_ref="); e64(pget(W,934));
  emit(" rc_t1="); e64(pget(W,936));
  emit(" rc_t9="); e64(pget(W,937));
  emit(" rc_t12="); e64(pget(W,938));
  emit(" rc_t13="); e64(pget(W,939));
  emit(" rc_other="); e64(pget(W,940));
  emit(" rc_verhist="); e64(pget(W,941));
  emit(" kill_ev="); e64(pget(W,825));
  emit(" kill_edge="); e64(pget(W,826));
  emit(" skip_refd="); e64(pget(W,827));
  emit(" skip_shared="); e64(pget(W,828));
  emit("\n");
  e11_measures(W);
  emit("E11MEAS dependents="); e64(pget(W,860));
  emit(" recon_len="); e64(pget(W,861));
  emit(" uniqueness="); e64(pget(W,864));
  emit(" revisions="); e64(pget(W,865));
  emit(" composition="); e64(pget(W,863));
  emit("\n");
  // Which foundational MAPs survived? A surviving foundational MAP is a live
  // tag-20 node with subject 1000+fi (field 8).
  let sv:i32=0;
  fi=0;
  while(fi<NF){
    let n:i32=2;
    let found:i32=0;
    while(n<262144 && found==0){
      if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==1000+fi){found=1;}
      n=n+1;
    }
    sv=sv+found;
    // C553 report the KEY that drove the decision, not just the outcome.
    emit("E11FOUND fi="); e64(fi);
    emit(" survives="); e64(found);
    emit(" bid="); e64(bid_ref(W,get32(fid,fi*4)));
    emit(" bid_fast="); e64(bid(W,get32(fid,fi*4)));
    emit("\n");
    fi=fi+1;
  }
  emit("E11FOUND total_survived="); e64(sv); emit(" of "); e64(NF); emit("\n");
  // C556 K10a THE ANSWER FACTS. Each foundational MAP's answer is the fact
  // (1000+fi, 50) -> (7000+fi) created by promote_graph's ev_teach_in. C554
  // measured all six of these DEAD with bid=0. Reported here per MAP, with the
  // bid and the declared owner, so the key that decided it is visible.
  let afl:i32=0;
  fi=0;
  while(fi<NF){
    let f:i32=2; let live:i32=0; let fbid:i32=-1; let ownv:i32=-1;
    while(f<262144 && live==0){
      if(ng(W,f,36)==1 && ng(W,f,0)==1 && ng(W,f,20)==1000+fi && ng(W,f,24)==50 && ng(W,f,28)==7000+fi){
        live=1; fbid=bid_ref(W,f); ownv=own_get(W,f);
      }
      f=f+1;
    }
    if(live==1){afl=afl+1;}
    emit("E11FACTS fi="); e64(fi);
    emit(" ansfact_live="); e64(live);
    emit(" bid="); e64(fbid);
    emit(" own="); e64(ownv); emit("\n");
    fi=fi+1;
  }
  emit("E11FACTS ansfact_live_total="); e64(afl); emit(" of "); e64(NF); emit("\n");
  // downstream answer: query a later MAP's composed answer that DEPENDS on a
  // foundational fact. A policy that destroyed foundational structure loses it.
  let q1:i32=ev_query(W,1000,50,7000,0);
  emit("E11JF downstream_ans="); e64(q1);
  emit(" expect=7000"); emit(" ok="); e64(q1==7000); emit("\n");
  // C552 FORGETTING (charter 35). Two populations are re-queried AFTER the
  // eviction pressure. Junk MAPs were built broken and were never reliably
  // answerable, so a low junk retention is not a loss. The foundational
  // answer is the one that must not be lost. Both are reported as counts, and
  // the junk number is explicitly labelled uninformative rather than folded
  // into a single "forgetting" score.
  let jq:i32=0; let jok:i32=0;
  ji=0;
  while(ji<JF){
    if((ji%97)==0 && jq<64){
      let a:i32=ev_query(W,20000+ji,51,20001+ji,0);
      if(a==20001+ji){jok=jok+1;}
      jq=jq+1;
    }
    ji=ji+1;
  }
  emit("E11JF junk_retention="); e64(jok); emit("/"); e64(jq);
  emit(" (broken MAPs, NOT a loss measure)\n");
  emit("E11JF forget_foundational="); e64(q1!=7000);
  emit(" forget_junk="); emit("-1"); emit(" (undefined by construction)\n");
  e11_report(W,"jf");
  emit("E11END\n");
  return;
}
// ---------- K5 namespace injection battery ----------
// Each site is exercised by writing a malformed operand into the LIVE cell
// that site dereferences, then re-running the operation that reads it. The
// reference answer is taken on an unfaulted world first, so a "wrong answer"
// is distinguishable from the intended failure.
fn e11_nsrow(W:[]u8,site:i32,tgt:i32,good:i32,bad:i32)void {
  let pre:i32=canary_chk(W);
  emit("E11NS site="); e64(site);
  emit(" target="); e64(tgt);
  emit(" viol="); e64(ns_viol(W));
  emit(" flagged="); e64(ns_site(W));
  emit(" checks="); e64(ns_checks(W));
  emit(" good="); e64(good);
  emit(" bad="); e64(bad);
  emit(" defined="); e64(bad==-999999);
  emit(" no_wrong="); e64(bad==-999999 || bad==good);
  emit(" canary="); e64(pre+canary_chk(W));
  emit(" ok="); e64(ns_viol(W)>0 && ns_site(W)==site && (bad==-999999 || bad==good) && pre==0 && canary_chk(W)==0);
  emit("\n");
  return;
}
// build a 2-cell MOVE graph and return its root (tag 101) and frame
fn e11_mkcell(W:[]u8,tag:i32)i32 {
  let c:i32=t2_cell(W,tag);
  return c;
}
// ==========================================================================
// K5 NAMESPACE INVARIANT BATTERY (charter 37), rebuilt.
//
// The disjoint-sign encoding (node ref op>=0 -> op<NN, frame ref op<0 ->
// slot (-op)-1) makes the two meanings unconfusable at any arena size, so the
// invariant to assert at every operand dereference is one line. This battery
// injects a MALFORMED operand into a LIVE cell and requires, at each of the
// 11 sites: (i) that site's guard fires and its violation counter increments,
// (ii) a DEFINED failure sentinel (-999999) or the reference answer, never a
// wrong value, (iii) the canary intact, and (iv) a subsequent well-formed
// query on the same workspace still correct.
//
// Malformed means: a node reference >= NN (300000) at a node-reference site,
// or a SIGN error (a non-negative value) at a frame-reference site -- the
// frozen engine's actual failure mode, a node id read as a frame slot.
//
// reach=1 world-level (the site is the first guard the malformed operand
// meets). reach=0 unit-level: the guard is NOT independently world-reachable
// because execute() validates the same operand at an earlier site, so the
// site's own predicate is invoked directly on the malformed value. Those are
// reported honestly rather than dressed up as world-level.
// ==========================================================================
fn e11_mkframe(W:[]u8)i32 {
  let f:i32=alloc_node(W); if(f<0){return -1;}
  ns(W,f,0,902);
  ns(W,f,4,-1); ns(W,f,8,-1); ns(W,f,12,-1); ns(W,f,16,-1);
  fr_set(W,f,0,0); fr_set(W,f,1,0); fr_set(W,f,2,0); fr_set(W,f,3,0);
  return f;
}
fn e11_teach3(W:[]u8,a:i32,b:i32,c:i32)void {
  ev_teach(W,a,1,b); ev_teach(W,b,1,c); ev_teach(W,c,1,c+1); ev_teach(W,c+1,1,c+2); return;
}
fn e11_bq(W:[]u8,a:i32,b:i32,c:i32)i32 {
  hs(W,16,0); hs(W,56,0);
  let g:i32=ev_query(W,a,50,c+2,0); if(g!=c+2){return 0-g;}
  return c+2;
}
// one MOVE cell (tag 101) whose dst is frame slot d and whose src is s.
fn e11_mv(W:[]u8,d:i32,s:i32)i32 {
  let c:i32=t2_set(W,d,s); if(c<0){return -1;} return c;
}
fn e11_ns2(W:[]u8,site:i32,root:i32,fr:i32,field:i32,bad:i32,good:i32,reach:i32)void {
  let pre:i32=canary_chk(W);
  let cn:i32=pget(W,905);
  emit("E11NS site="); e64(site);
  emit(" reach="); e64(reach);
  emit(" viol="); e64(ns_viol(W));
  emit(" flagged="); e64(ns_site(W));
  emit(" dchecks="); e64(ns_checks(W)-cn);
  emit(" good="); e64(good);
  emit(" bad="); e64(bad);
  emit(" defined="); e64(bad==-999999);
  emit(" no_wrong="); e64(bad==-999999 || bad==good);
  emit(" fired="); e64(ns_viol(W)>0);
  emit(" at_site="); e64(ns_site(W)==site);
  emit(" canary="); e64(pre+canary_chk(W));
  // Post-injection well-formed query on the SAME workspace. The violation
  // latches are read first, then CLEARED: ns_dirty is sticky by design (a
  // malformed reference poisons every later execute until acknowledged), so
  // leaving it set would make this test measure the latch, not corruption.
  let v:i32=ns_viol(W); let sf:i32=ns_site(W);
  ns_reset(W);
  let pq:i32=e11_bq(W,900,901,902);
  emit(" pq="); e64(pq);
  emit(" post_ok="); e64(pq==904);
  emit(" ok="); e64(v>0 && sf==site && (bad==-999999 || bad==good) && pre==0 && canary_chk(W)==0 && pq==904);
  emit("\n");
  return;
}
fn e11_nsbattery()void {
  emit("E11NSBATTERY-START\n");
  // ---- S1 res_op node branch (direct call on the real function) ----------
  let W1:[]u8=e11_big(); e11_setup(W1,7); e11_teach3(W1,900,901,902);
  let f1:i32=e11_mkframe(W1);
  fr_set(W1,f1,0,7777);
  ns_reset(W1);
  let b1:i32=res_op(W1,f1,300000);
  e11_ns2(W1,1,0,f1,8,b1,7777,1);
  // ---- S2 execute MOVE src (node reference >= NN) ----------------------
  let W2:[]u8=e11_big(); e11_setup(W2,7); e11_teach3(W2,900,901,902);
  let fr2:i32=e11_mkframe(W2);
  let n2:i32=alloc_node(W2); ns(W2,n2,20,4242);
  let r2:i32=e11_mv(W2,0,n2);
  ns(W2,r2,8,n2);
  let g2:i32=execute(W2,r2,fr2);
  ns_reset(W2);
  ns(W2,r2,8,300000);
  let b2:i32=execute(W2,r2,fr2);
  e11_ns2(W2,2,r2,fr2,8,b2,g2,1);
  // ---- S8 execute MOVE dst (SIGN error: node id where frame ref required)
  let W8:[]u8=e11_big(); e11_setup(W8,7); e11_teach3(W8,900,901,902);
  let fr8:i32=e11_mkframe(W8);
  let r8:i32=e11_mv(W8,0,n2);
  let g8:i32=execute(W8,r8,fr8);
  ns_reset(W8);
  ns(W8,r8,4,300000);
  let b8:i32=execute(W8,r8,fr8);
  e11_ns2(W8,8,r8,fr8,4,b8,g8,1);
  // ---- S3 BEQ lhs / S4 BEQ rhs ----------------------------------------
  let W3:[]u8=e11_big(); e11_setup(W3,7); e11_teach3(W3,900,901,902);
  let fr3:i32=e11_mkframe(W3);
  let lx3:i32=t2_lit(W3,901); let ly3:i32=t2_lit(W3,902);
  let g3:i32=t2_guard(W3,0,lx3);
  let s3:i32=t2_set(W3,0,ly3);
  ns(W3,g3,8,lx3); ns(W3,g3,12,s3);
  let gg3:i32=execute(W3,g3,fr3);
  ns_reset(W3);
  ns(W3,g3,4,300000);
  let b3:i32=execute(W3,g3,fr3);
  e11_ns2(W3,3,g3,fr3,4,b3,gg3,1);
  let W4:[]u8=e11_big(); e11_setup(W4,7); e11_teach3(W4,900,901,902);
  let fr4:i32=e11_mkframe(W4);
  let lx4:i32=t2_lit(W4,901); let ly4:i32=t2_lit(W4,902);
  let g4:i32=t2_guard(W4,0,lx4);
  let s4:i32=t2_set(W4,0,ly4);
  ns(W4,g4,8,lx4); ns(W4,g4,12,s4);
  let gg4:i32=execute(W4,g4,fr4);
  ns_reset(W4);
  ns(W4,g4,8,300000);
  let b4:i32=execute(W4,g4,fr4);
  e11_ns2(W4,4,g4,fr4,8,b4,gg4,1);
  // ---- S5 INC dst / S6 DEC dst (SIGN error) ----------------------------
  let W5:[]u8=e11_big(); e11_setup(W5,7); e11_teach3(W5,900,901,902);
  let fr5:i32=e11_mkframe(W5);
  let c5:i32=t2_cell(W5,103); ns(W5,c5,4,-1);
  let gg5:i32=execute(W5,c5,fr5);
  ns_reset(W5);
  ns(W5,c5,4,300000);
  let b5:i32=execute(W5,c5,fr5);
  e11_ns2(W5,5,c5,fr5,4,b5,gg5,1);
  let W6:[]u8=e11_big(); e11_setup(W6,7); e11_teach3(W6,900,901,902);
  let fr6:i32=e11_mkframe(W6);
  let c6:i32=t2_cell(W6,104); ns(W6,c6,4,-1);
  let gg6:i32=execute(W6,c6,fr6);
  ns_reset(W6);
  ns(W6,c6,4,300000);
  let b6:i32=execute(W6,c6,fr6);
  e11_ns2(W6,6,c6,fr6,4,b6,gg6,1);
  // ---- S10 fr_get frame-chain walk / S11 fr_set frame-chain walk -------
  // reached through a MOVE whose operand is frame slot 4, so the chain walk
  // runs; the chain head is then corrupted to an out-of-arena node id.
  let W10:[]u8=e11_big(); e11_setup(W10,7); e11_teach3(W10,900,901,902);
  let fr10:i32=e11_mkframe(W10);
  let c10:i32=e11_mv(W10,0,-5);
  let gg10:i32=execute(W10,c10,fr10);
  ns(W10,fr10,4,300000);
  ns_reset(W10);
  let b10:i32=execute(W10,c10,fr10);
  e11_ns2(W10,10,c10,fr10,4,b10,gg10,1);
  let W11:[]u8=e11_big(); e11_setup(W11,7); e11_teach3(W11,900,901,902);
  let fr11:i32=e11_mkframe(W11);
  let n11:i32=alloc_node(W11); ns(W11,n11,20,4242);
  let c11:i32=e11_mv(W11,4,n11);
  let gg11:i32=execute(W11,c11,fr11);
  ns(W11,fr11,4,300000);
  ns_reset(W11);
  let b11:i32=execute(W11,c11,fr11);
  e11_ns2(W11,11,c11,fr11,4,b11,gg11,1);
  // ---- S7 exec_val operand / S9 t2_exec result operand -----------------
  // NOT independently world-reachable: execute() validates the root's field 4
  // at its own site (8/3/5/6) before exec_val/t2_exec ever read it, so a
  // world-level injection is caught EARLIER. That redundancy is itself the
  // result. The site's own predicate is therefore invoked directly on the
  // malformed value, and reach=0 records that this is a unit-level check.
  let W7:[]u8=e11_big(); e11_setup(W7,7); e11_teach3(W7,900,901,902);
  let fr7:i32=e11_mkframe(W7);
  let n7:i32=alloc_node(W7); ns(W7,n7,20,4242);
  let r7:i32=e11_mv(W7,0,n7);
  ns_reset(W7);
  let u7:i32=nsok_node(W7,300000,7);
  let b7:i32=-999999; let g7:i32=-999999; if(u7!=0){b7=1;}
  e11_ns2(W7,7,r7,fr7,4,b7,g7,0);
  let W9:[]u8=e11_big(); e11_setup(W9,7); e11_teach3(W9,900,901,902);
  let fr9:i32=e11_mkframe(W9);
  let n9:i32=alloc_node(W9); ns(W9,n9,20,4242);
  let r9:i32=e11_mv(W9,0,n9);
  ns_reset(W9);
  let u9:i32=nsok_node(W9,300000,9);
  let b9:i32=-999999; let g9:i32=-999999; if(u9!=0){b9=1;}
  e11_ns2(W9,9,r9,fr9,4,b9,g9,0);
  emit("E11NSBATTERY-END\n");
  return;
}
// ---------- phase 8: t2_lu_first indexed-vs-linear equivalence (kill bar) ----
// Build a real world with the FAST dispatch active, then for EVERY live
// tag-1 fact's own (subject,relation) key run both implementations and count
// disagreements. keys=0 would mean the test is vacuous and is reported as such.
fn e11_lu_equiv(D:i32,mode:i32)void {
  let W:[]u8=e11_big(); e11_setup(W,mode);
  let i:i32=0;
  while(i<D){
    if(e11_mkbroken(W,20000+i,51,20001+i)<0){}
    i=i+1;
  }
  // duplicate-key pressure: teach the SAME (subject,relation) twice so the
  // multimatch path is exercised and the min-id rule is actually load-bearing.
  ev_teach(W,777001,1,555001);
  ev_teach(W,777001,1,555002);
  ev_teach(W,777001,1,555003);
  emit("E11EQ D="); e64(D); emit(" mode="); e64(mode); emit("\n");
  lu_first_equiv(W);
  emit("E11EQ keys="); e64(pget(W,889));
  emit(" mismatch="); e64(pget(W,890));
  emit(" luidx_probes="); e64(pget(W,88));
  emit(" multimatch="); e64(pget(W,90));
  emit(" live_nodes="); e64(hg(W,20));
  emit(" ok="); e64(pget(W,890)==0);
  emit("\n");
  if(pget(W,890)!=0){
    emit("E11EQ first_bad s="); e64(pget(W,894));
    emit(" r="); e64(pget(W,895));
    emit(" lin="); e64(pget(W,896));
    emit(" idx="); e64(pget(W,897)); emit("\n");
  }
  emit("E11END\n");
  return;
}
// ---------- K11a SELECTOR EQUIVALENCE, ELEMENT FOR ELEMENT ----------
// The sublinear selector must return the SAME victim as the linear one at every
// step of a long real eviction sequence. Agreeing once would prove nothing, so
// the two are compared at each of 2000 successive selections while the world is
// actually being torn down between them.
fn e11_selequiv(JF:i32,mode:i32)void {
  emit("E11SEL mode="); e64(mode); emit(" JF="); e64(JF); emit("\n");
  let W:[]u8=e11_big(); e11_setup(W,mode);
  let ji:i32=0;
  while(ji<JF){
    let pm:i32=e11_mkbroken(W,20000+ji,51,20001+ji);
    if(pm<0){emit("E11SEL jfail\n");}
    ji=ji+1;
  }
  emit("E11SEL built live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" evictions="); e64(pget(W,68));
  emit(" own_prot="); e64(pget(W,932)); emit("\n");
  let k:i32=0; let steps:i32=2000; let mism:i32=0;
  while(k<steps){
    let a:i32=sel_fast(W);
    let b:i32=sel_fast_ref(W);
    if(a!=b){mism=mism+1;}
    if(a<0){break;}
    do_evict(W,a);
    k=k+1;
  }
  emit("E11SEL steps="); e64(k);
  emit(" mismatches="); e64(mism);
  emit(" probes_fast="); e64(pget(W,933));
  emit(" probes_ref="); e64(pget(W,934));
  emit(" fast_per_evict="); e64(pget(W,933)/(k+1));
  emit(" ref_per_evict="); e64(pget(W,934)/(k+1));
  emit(" evictions="); e64(pget(W,68));
  emit(" idxmode_lost="); e64(pget(W,915));
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit("\n");
  emit("E11SEL equiv_ok="); e64(mism==0); emit("\n");
  emit("E11END\n");
  return;
}
fn main()i32 {
  emit("E11PROF-START\n");
  let a1:[]u8=_zag_arg(1);
  let a2:[]u8=_zag_arg(2);
  let a3:[]u8=_zag_arg(3);
  let a4:[]u8=_zag_arg(4);
  let D:i32=atoi(a1);
  let mode:i32=atoi(a2);
  let ph:i32=atoi(a3);
  let extra:i32=atoi(a4);
  emit("E11ARGS D="); e64(D);
  emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" extra="); e64(extra); emit("\n");
  if(ph==4){ e11_junk_found(extra,mode); }
  else { if(ph==9){ e11_selequiv(extra,mode); } else { if(ph==5){ e11_nsbattery(); } else { e11_run(D,mode,ph,extra,"main"); } } }
  if(ph==8){ e11_lu_equiv(D,mode); }
  if(ph==6){ let W2:[]u8=e11_big(); e11_setup(W2,0); ev_teach(W2,5,1,6); e11_vtrace(W2); }
  if(ph==7){ let W3:[]u8=e11_big(); e11_setup(W3,7); e11_teach3(W3,900,901,902);
    emit("SELFTEST q1="); e64(e11_bq(W3,900,901,902));
    emit(" raw1="); e64(ev_query(W3,900,50,904,0));
    emit(" raw2="); e64(ev_query(W3,900,50,904,-2));
    emit(" r1rel="); e64(ev_query(W3,900,1,901,0));
    emit(" r1n="); e64(ng(W3,2,0)); emit(" "); e64(ng(W3,2,20)); emit(" "); e64(ng(W3,2,24)); emit(" "); e64(ng(W3,2,28)); emit("\n"); }
  emit("E11PROF-END\n");
  return 0;
}

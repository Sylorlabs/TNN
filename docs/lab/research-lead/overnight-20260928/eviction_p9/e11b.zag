// tnn2.zag -- TNN-2 next-generation integration.
// Prereg 7c1e30522 frozen before this file (K-T2-1). Pure Zag. No Python.
// Root-cause basis: ed38121d4 (three shared architectural gaps).
// Change 1: one executable graph type, constructed at runtime. The MUL Rung B
//   trial loop (propose/execute/verify/promote) is the general miss policy.
//   The three fixed plan templates and the separate exec_plan executor are
//   removed. All executable structure flows through the single frozen 4-op
//   ISA (MOVE/BRANCHEQ/INC/DEC) via EXECUTE. Exactly one executor.
// Change 2: the miss-to-act loop is closed in learner state. On a miss,
//   miss_inquire reifies an UNCERTAINTY node (inquiry build 18ed3331c,
//   Piece A) and constructs a guide (Piece B) linked to POLICY_ROOT using
//   existing node/edge types. ev_act selects over learner-constructed guides.
// Change 3: generic revision operator over 4-op executable graphs.
//   On a counterexample (ev_observe contradiction of a licensing fact), the
//   stale step is removed and a corrected step inserted; the restructured
//   graph is re-executed for verification. Distinct from standing demotion.
// ISA frozen: no new opcodes, modes, bridges, handlers, semantic cases.
// One workspace, one bid, one miss path, one event log, one executor.

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ============ layout: 262144 nodes, 262144 edges, 128 log ============
// node base 64, 40B/node -> 10485824; edge base 10485824, 16B/edge ->
// 14680128; log base 14680128, 32B x 128 -> 14684224.
fn WSZ()i32 { return 14684224; }
fn NN()i32 { return 262144; }
fn NE()i32 { return 262144; }
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
// ---- P8 profiler region: 512 i32 cells appended after WSZ (charter 94) ----
// The workspace is exactly consumed by nodes+edges+128 log records, so the
// profiler lives in an explicitly appended tail. The driver allocates
// WSZ()+2048 and zeroes this region. No engine field is displaced, so the
// instrumented build is byte-compatible with the frozen layout.
fn PB()i32 { return 14684224; }
// FACT-index spine: 683 spine nodes x 6 heads = 4098 subject buckets.
// Direct-addressed by spine id stored at PB cell 128+k, so a bucket
// lookup is O(1) instead of the frozen O(b/6) spine walk. The spine id
// array is index STATE, not part of the node/edge arena.
fn FBSPINE()i32 { return 683; }
fn FBCEL()i32 { return 128; }
fn fbsp(W:[]u8,k:i32)i32 { return get32(W,PB()+(FBCEL()+k)*4); }
fn fbsp_set(W:[]u8,k:i32,v:i32)void { set32(W,PB()+(FBCEL()+k)*4,v); return; }
fn padd(W:[]u8,k:i32)void { let o:i32=PB()+k*4; set32(W,o,get32(W,o)+1); return; }
fn paddv(W:[]u8,k:i32,v:i32)void { let o:i32=PB()+k*4; set32(W,o,get32(W,o)+v); return; }
fn pget(W:[]u8,k:i32)i32 { return get32(W,PB()+k*4); }
// ============ P9: LEARNER-MAINTAINED SUBLINEAR INDEX (charter 36) ========
// Five structures, all maintained as a side effect of the learner's own
// writes. No researcher-authored category list: every key is either a
// field the learner itself wrote (edge type, node tag, subject value) or
// a fact about the learner's own allocation order (cursor / recency).
//
// S1 EDGE-TYPE CARDINALITY  cell 96+t = live edge count of type t.
//    Makes "are there any edges of type t?" O(1). Exact: it is a count
//    maintained at the only two places edge liveness changes.
// S2 TYPE-9 EDGE SET        DBASE[] = live edges of type 9, PBASE[e] =
//    its slot. Makes decay() O(#protected) instead of O(NE). Exact:
//    every edge death goes through edge_del, so the set is exact.
// S3 ALLOCATION CURSOR      cell 64 = lowest id not yet proven occupied.
//    alloc walks forward from the cursor and returns the first free id.
//    Amortized O(1); returns exactly "lowest free id" as the frozen
//    linear scan did. Eviction rewinds the cursor, so a freed low id is
//    never skipped.
// S4 EDGE CURSOR            cell 65, same argument for edges.
// S5 FACT RECENCY STACK     SBASE[] = ids of taught FACT nodes, newest
//    last. "most recent live FACT node" becomes an amortized O(1) walk
//    back over dead entries. Serves both ev_teach's prev link and
//    ev_query's recent link. Exact: entries are validated (liveness,
//    tag) on read, never trusted.
fn DBASE()i32 { return 14688320; }
fn PBASE()i32 { return 15736896; }
fn SBASE()i32 { return 16785472; }
fn NB0()i32 { return 17834048; }
fn NB1()i32 { return 18096192; }
fn NB2()i32 { return 18100288; }
fn EB0()i32 { return 18100352; }
fn EB1()i32 { return 18362496; }
fn EB2()i32 { return 18366592; }
fn P9X()i32 { return 3882624; }
fn g8(W:[]u8,o:i32)i32 { return W[o] as i32; }
fn s8(W:[]u8,o:i32,v:i32)void { W[o]=v as u8; return; }
// ---- S3/S4 REVISED: hierarchical free-id bitmaps, not a cursor.
// A single monotone cursor was measured to be pathological under churn:
// type-9 edges die in creation order, so the freed ids are always the
// LOWEST live ids while the allocation frontier is at the top, and every
// rewind repaid the whole gap. The three-level bitmap makes
// "lowest free id" O(1) bounded (<=130 probes) regardless of churn, and
// still returns exactly the lowest free id, so the frozen selection
// semantics are preserved bit for bit.
fn fb_set(W:[]u8,b0:i32,b1:i32,b2:i32,id:i32,v:i32)void {
  s8(W,b0+id,v);
  if(v!=0){s8(W,b1+id/64,1); s8(W,b2+id/4096,1); return;}
  let g:i32=id/64; let s:i32=g*64; let any:i32=0; let i:i32=0;
  while(i<64){if(g8(W,b0+s+i)!=0){any=1;} i=i+1;}
  if(any!=0){return;}
  s8(W,b1+g,0);
  let g2:i32=g/64; let s2:i32=g2*64; let any2:i32=0; i=0;
  while(i<64){if(g8(W,b1+s2+i)!=0){any2=1;} i=i+1;}
  if(any2==0){s8(W,b2+g2,0);}
  return;
}
fn fb_fill(W:[]u8,b0:i32,b1:i32,b2:i32)void {
  let i:i32=0;
  while(i<262144){s8(W,b0+i,1); i=i+1;}
  i=0; while(i<4096){s8(W,b1+i,1); i=i+1;}
  i=0; while(i<64){s8(W,b2+i,1); i=i+1;}
  return;
}
fn fb_find(W:[]u8,b0:i32,b1:i32,b2:i32)i32 {
  let g2:i32=0;
  while(g2<64){
    if(g8(W,b2+g2)!=0){
      let s2:i32=g2*64; let g:i32=0;
      while(g<64){
        let gg:i32=s2+g;
        if(gg<4096 && g8(W,b1+gg)!=0){
          let s:i32=gg*64; let i:i32=0;
          while(i<64){if(g8(W,b0+s+i)!=0){return s+i;} i=i+1;}
        }
        g=g+1;
      }
    }
    g2=g2+1;
  }
  return -1;
}
fn pset(W:[]u8,k:i32,v:i32)void { set32(W,PB()+k*4,v); return; }
fn edge_reg(W:[]u8,e:i32)void {
  if(eg(W,e,4)!=9){return;}
  if(eg(W,e,12)>=1000000){return;}
  let d:i32=pget(W,66);
  if(d>=262144){return;}
  set32(W,DBASE()+d*4,e); set32(W,PBASE()+e*4,d); pset(W,66,d+1);
  return;
}
fn edge_del(W:[]u8,e:i32)void {
  if(eg(W,e,0)==-1){return;}
  let t:i32=eg(W,e,4);
  if(t==9 && eg(W,e,12)<1000000){
    let p:i32=get32(W,PBASE()+e*4);
    let d:i32=pget(W,66);
    if(p>=0 && p<d){
      let last:i32=get32(W,DBASE()+(d-1)*4);
      set32(W,DBASE()+p*4,last); set32(W,PBASE()+last*4,p); pset(W,66,d-1);
    }
  }
  if(t>=0 && t<16){pset(W,96+t,pget(W,96+t)-1);}
  ev_del(W,e);
  fb_set(W,EB0(),EB1(),EB2(),e,1);
  es(W,e,0,-1); hs(W,24,hg(W,24)-1);
  return;
}
fn fact_push(W:[]u8,n:i32)void {
  let c:i32=pget(W,67);
  if(c>=262144){
    let i:i32=0; let j:i32=0;
    while(i<c){
      let x:i32=get32(W,SBASE()+i*4);
      if(x>=0 && x<262144 && ng(W,x,36)==1){set32(W,SBASE()+j*4,x); j=j+1;}
      i=i+1;
    }
    pset(W,67,j); padd(W,69); c=j;
    if(c>=262144){return;}
  }
  set32(W,SBASE()+c*4,n); pset(W,67,c+1); return;
}
fn fact_top(W:[]u8,ex:i32)i32 {
  let i:i32=pget(W,67)-1;
  padd(W,30);
  while(i>=0){
    let x:i32=get32(W,SBASE()+i*4);
    if(x!=ex && x>=0 && x<262144 && ng(W,x,36)==1 && ng(W,x,0)==1){return x;}
    i=i-1;
  }
  return -1;
}
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 10485824+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }
fn loff(l:i32)i32 { return 14680128+l*32; }
fn lg(W:[]u8,l:i32,f:i32)i32 { return get32(W,loff(l)+f); }
fn ls(W:[]u8,l:i32,f:i32,v:i32)void { set32(W,loff(l)+f,v); return; }
// ============ edge types (13: CLA-2 12 + E_CORROB) ============
fn ET_DEP()i32 { return 1; }
fn ET_SUP()i32 { return 2; }
fn ET_CON()i32 { return 3; }
fn ET_REF()i32 { return 4; }
fn ET_INS()i32 { return 5; }
fn ET_USE()i32 { return 6; }
fn ET_CFM()i32 { return 7; }
fn ET_SUR()i32 { return 8; }
fn ET_PRO()i32 { return 9; }
fn ET_MEM()i32 { return 10; }
fn ET_REG()i32 { return 11; }
fn ET_SEQ()i32 { return 12; }
fn ET_COR()i32 { return 13; }
// ============ EXECUTE 4-op ISA ============
fn OP_MOVE()i32 { return 101; }
fn OP_BEQ()i32 { return 102; }
fn OP_INC()i32 { return 103; }
fn OP_DEC()i32 { return 104; }
// ============ node types ============
fn T_FACT()i32 { return 1; }
fn T_GROUP()i32 { return 2; }
fn T_HIST()i32 { return 3; }
fn T_REGRET()i32 { return 4; }
fn T_MAP()i32 { return 20; }
fn T_COEFF()i32 { return 21; }
fn T_UNCERT()i32 { return 30; }
// ============ core primitives ============
fn alloc_fast(W:[]u8)i32 {
  padd(W,20);
  let n:i32=fb_find(W,NB0(),NB1(),NB2());
  if(n<0){return -2;}
  fb_set(W,NB0(),NB1(),NB2(),n,0);
  ns(W,n,36,1); ns(W,n,0,0);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
  ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  vreset(W,n);
  hs(W,20,hg(W,20)+1); vre(W,n); return n;
}
fn alloc_node(W:[]u8)i32 {
  padd(W,19);
  let f:i32=alloc_fast(W);
  if(f>=0){return f;}
  padd(W,21);
  let v:i32=evict_node(W);
  if(v<0){return -1;}
  ns(W,v,36,1); ns(W,v,0,0);
  ns(W,v,4,0); ns(W,v,8,0); ns(W,v,12,0); ns(W,v,16,0);
  ns(W,v,20,0); ns(W,v,24,0); ns(W,v,28,0); ns(W,v,32,0);
  vreset(W,v);
  hs(W,20,hg(W,20)+1); vre(W,v); return v;
}
fn alloc_raw(W:[]u8)i32 {
  padd(W,27);
  let f:i32=alloc_fast(W);
  if(f>=0){return f;}
  return -1;
}
fn write_node(W:[]u8,n:i32,a:i32,b:i32,c:i32,d:i32)void {
  ns(W,n,20,a); ns(W,n,24,b); ns(W,n,28,c); ns(W,n,32,d); return;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  padd(W,24);
  padd(W,23);
  let e:i32=fb_find(W,EB0(),EB1(),EB2());
  if(e<0){return -1;}
  fb_set(W,EB0(),EB1(),EB2(),e,0);
  es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
  hs(W,24,hg(W,24)+1);
  if(t>=0 && t<16){pset(W,96+t,pget(W,96+t)+1);}
  ev_link(W,e);
  edge_reg(W,e);
  return e;
}
fn is_superseded(W:[]u8,n:i32)i32 {
  let e:i32=0;
  padd(W,22);
  if(pget(W,99)==0){return 0;}
  while(e<262144){
    padd(W,5);
    if(eg(W,e,0)!=-1 && eg(W,e,4)==3 && eg(W,e,0)==n && eg(W,e,8)==n){return 1;}
    e=e+1;
  }
  return 0;
}
// NOTE: activate() is NOT defined here. In P9 it moves to the patch layer,
// after fidx_*, so that it can walk the learner-maintained FACT subject
// chain instead of scanning all NN node slots. The selection predicate is
// unchanged; only the candidate enumeration is indexed.
fn decay(W:[]u8)void {
  padd(W,26);
  let i:i32=0;
  while(i<pget(W,66)){
    let e:i32=get32(W,DBASE()+i*4);
    padd(W,2);
    if(eg(W,e,0)==-1){i=i+1;}
    else {
      let c:i32=eg(W,e,12)-1;
      if(c<=0){edge_del(W,e);}
      else {es(W,e,12,c); i=i+1;}
    }
  }
  return;
}
// ---- EXECUTE ----
// S10/S11: the frame-chain walk is the one place a frame reference can run
// off the end, so it is bounded in hops AND every hop is bounds-checked.
fn fr_get(W:[]u8,f:i32,s:i32)i32 {
  let cur:i32=f; let ss:i32=s; let hops:i32=0;
  while(ss>=4){
    cur=ng(W,cur,4); hops=hops+1;
    if(cur<0){return 0;}
    if(cur>=262144 || hops>64){nsbad(W,10); return 0;}
    ss=ss-4;
  }
  if(ss==0){return ng(W,cur,20);} if(ss==1){return ng(W,cur,24);}
  if(ss==2){return ng(W,cur,28);} return ng(W,cur,32);
}
fn fr_set(W:[]u8,f:i32,s:i32,v:i32)void {
  let cur:i32=f; let ss:i32=s; let hops:i32=0;
  while(ss>=4){
    cur=ng(W,cur,4); hops=hops+1;
    if(cur<0){return;}
    if(cur>=262144 || hops>64){nsbad(W,11); return;}
    ss=ss-4;
  }
  if(ss==0){ns(W,cur,20,v);} else {if(ss==1){ns(W,cur,24,v);}
  else {if(ss==2){ns(W,cur,28,v);} else {ns(W,cur,32,v);}}}
  return;
}
// ===== P10 STRUCTURAL REFERENCE FIX (charter 37) =====
// The frozen encoding overloaded one integer: an operand >= FRAME_BASE
// meant "frame slot op-FRAME_BASE", anything else meant "node id op".
// B1/C299/C375. Raising FRAME_BASE only moves the wall; it does not remove
// the collision, and it makes correctness a coincidence of NN < FRAME_BASE.
// P10 removes the magic number entirely by making the two ranges
// DISJOINT BY CONSTRUCTION:
//
//     node reference   : op >= 0   -> node id, value in field 20
//     frame reference  : op <  0   -> frame slot (-op)-1
//
// Node ids and literal values are non-negative in every producer in this
// engine (alloc_node returns >= 0, alloc_raw returns >= 0, subjects and
// objects are data), so the negative half of the integer line is free and
// the two meanings can never be confused at any arena size. The guard
// sites that used to reject a too-small constant now reject a
// wrong-signed reference, which is a type error, not a size accident.
fn res_op(W:[]u8,f:i32,op:i32)i32 {
  if(op<0){return fr_get(W,f,(-op)-1);}
  if(nsok_node(W,op,1)==0){return -999999;}
  return ng(W,op,20);
}
fn execute(W:[]u8,root:i32,fr:i32)i32 {
  let cur:i32=root; let st:i32=0;
  if(root<0 || root>=262144){nsbad(W,1); return -999999;}
  while(st<1000){
    if(cur<0){return -999999;}
    if(cur>=262144){nsbad(W,1); return -999999;}
    let tag:i32=ng(W,cur,0); let nx:i32=-1;
    if(tag==101){
      let d:i32=ng(W,cur,4); let sr:i32=ng(W,cur,8);
      if(nsok_frame(W,d,8)==0){return -999999;}
      if(nsok_node(W,sr,2)==0 && sr>=0){return -999999;}
      fr_set(W,fr,(-d)-1,res_op(W,fr,sr)); nx=seq_nx(W,cur);
    } else {if(tag==102){
      let o1:i32=ng(W,cur,4); let o2:i32=ng(W,cur,8);
      if(o1>=0){if(nsok_node(W,o1,3)==0){return -999999;}}
      if(o2>=0){if(nsok_node(W,o2,4)==0){return -999999;}}
      let a:i32=res_op(W,fr,o1); let b:i32=res_op(W,fr,o2);
      if(ns_dirty(W)!=0){return -999999;}
      if(a==b){nx=ng(W,cur,12);} else {nx=ng(W,cur,16);}
    } else {if(tag==103){
      let s:i32=ng(W,cur,4);
      if(nsok_frame(W,s,5)==0){return -999999;}
      fr_set(W,fr,(-s)-1,fr_get(W,fr,(-s)-1)+1); nx=seq_nx(W,cur);
    } else {if(tag==104){
      let s2:i32=ng(W,cur,4);
      if(nsok_frame(W,s2,6)==0){return -999999;}
      fr_set(W,fr,(-s2)-1,fr_get(W,fr,(-s2)-1)-1); nx=seq_nx(W,cur);
    } else {return -999999;}}}}
    if(ns_dirty(W)!=0){return -999999;}
    if(nx<0){if(tag==102){return -999999;} return 1;}
    cur=nx; st=st+1;
  }
  return -999999;
}
fn exec_val(W:[]u8,root:i32,fr:i32)i32 {
  if(root<0 || root>=262144){nsbad(W,7); return -999999;}
  if(execute(W,root,fr)!=1){return -999999;}
  let op:i32=ng(W,root,4);
  if(op>=0 && nsok_node(W,op,7)==0){return -999999;}
  return res_op(W,fr,op);
}

// ==========================================================================
// EVICTION SUBSTRUCTURE -- charter 38 (reclamation on meaningful structures)
// and charter 32 (the policy may not be only recency/frequency/age).
//
// The frozen evict_node is O(NN * (is_prot + 6*evcount)) = O(NN*6*NE) PER
// EVICTION: 4.1e11 edge visits at NN=NE=262144. Two exact O(1)-amortized
// replacements are built here and maintained ONLY at the three places the
// underlying state changes: link_edge (birth), edge_del (death), ref_prot
// (protection clock). Nothing here ever scans to answer "is n protected" or
// "how many things depend on n".
//
// All of it lives in an explicitly appended tail region, so no engine field
// is displaced and the no-eviction regime is bit-for-bit unaffected.
//
//   R1 EXACT PREDICATES
//      E_INT[t][n] = live edge count with to==n and type t, for
//                   t in {1,2,3,6,7,9,12}.  Makes evcount O(1) and supplies
//                   the shared-reference test used by reclamation.
//      E_PROT[n]  = live type-9 edges into n with clk>0.  Makes is_prot O(1).
//      E_BID[n]   = contrib(n) + SUM over live type-10 edges e with to(e)==n
//                   of contrib(from(e)), where
//                   contrib(n) = in1+in2+in6+in7-in3.
//                   Delta-propagated through a per-node intrusive list of
//                   live type-10 OUT-edges, so a change to contrib(g)
//                   reaches bid[to] in O(#type-10 out-edges of g).
//   R2 VICTIM INDEX (no global scan)
//      live tag-1 nodes sit in bid buckets, bid shifted by VBIAS.
//      E_BCE[b] = eligible (live, tag-1, unprotected) count in bucket b.
//      vmin is the lowest non-empty eligible bucket and only ever moves DOWN
//      on insertion, so total upward advance is amortized O(1) per
//      insertion.  The current vmin bucket carries a membership bitmap
//      (1 bit per node id, 32 KiB) maintained incrementally, so the frozen
//      cyclic-id tie-break is resolved by bitmap scan, not a list walk.
//   R3 STRUCTURAL OWNERSHIP
//      E_OWN[n]  = owning MAP id, or -1, or -2 for a history tombstone.
//      E_CHM/E_CHN = per-MAP child list, so a MAP's structural children are
//      reclaimed ATOMICALLY with it instead of left as fossils.
//      E_RTR[n]  = number of live MAP nodes whose root graph is n. A node is
//      SHARED and must NOT be reclaimed while this or its in-edge count is
//      non-zero. One owner disappearing never deletes shared structure.
//      Cycles: reclamation runs off a worklist guarded by the E_VIS bitmap,
//      so a cyclic ownership/edge shape terminates, visiting each node once.
//      Version history: rec_evict tombstones are own=-2 and never
//      reclaimable; the evicted node's root graph id and (subject,relation)
//      are written into the tombstone so provenance survives eviction.
// ==========================================================================
fn EVB()i32 { return 18566848; }
fn E_INT()i32 { return 18566848; }
fn E_PROT()i32 { return 25906880; }
fn E_BID()i32 { return 26955456; }
fn E_MEMH()i32 { return 28004032; }
fn E_MEMN()i32 { return 29052608; }
fn E_T9H()i32 { return 30101184; }
fn E_T9N()i32 { return 31149760; }
fn E_INH()i32 { return 32198336; }
fn E_INN()i32 { return 33246912; }
fn E_OUH()i32 { return 34295488; }
fn E_OUN()i32 { return 35344064; }
fn E_OWN()i32 { return 36392640; }
fn E_CHM()i32 { return 37441216; }
fn E_CHN()i32 { return 38489792; }
fn E_VCB()i32 { return 39538368; }
fn E_VNX()i32 { return 40596944; }
fn E_VPV()i32 { return 41645520; }
fn E_RTR()i32 { return 42694096; }
fn E_BCE()i32 { return 43742672; }
fn E_BMB()i32 { return 43840992; }
fn E_BMC()i32 { return 43808224; }
fn VBH()i32 { return 43775440; }
fn E_VIS()i32 { return 43873760; }
fn E_Q()i32 { return 43906528; }
// per-node "was this node COUNTED in its bucket's E_BCE" flag. Without it a
// node inserted while protected (eligible=0, contributes 0) that later becomes
// unprotected and moves bucket would subtract 1 from the old bucket it never
// added to, driving E_BCE negative and desynchronising the audit.
fn E_VEL()i32 { return 44168672; }
fn vel_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return 0;} return get32(W,E_VEL()+n*4); }
fn vel_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_VEL()+n*4,v); return; }
fn E_CAN()i32 { return 45217248; }

fn EVX()i32 { return 25605920; }
fn VNB()i32 { return 8192; }
fn VBIAS()i32 { return 1024; }
fn tslot(t:i32)i32 {
  if(t==1){return 0;} if(t==2){return 1;} if(t==3){return 2;}
  if(t==6){return 3;} if(t==7){return 4;} if(t==9){return 5;}
  if(t==12){return 6;}
  return -1;
}
fn ing(W:[]u8,t:i32,n:i32)i32 {
  let s:i32=tslot(t); if(s<0){return 0;}
  if(n<0 || n>=262144){return 0;}
  return get32(W,E_INT()+s*1048576+n*4);
}
fn inset(W:[]u8,t:i32,n:i32,d:i32)void {
  let s:i32=tslot(t); if(s<0){return;}
  if(n<0 || n>=262144){return;}
  let o:i32=E_INT()+s*1048576+n*4;
  set32(W,o,get32(W,o)+d); return;
}
fn dt(t:i32)i32 {
  if(t==1){return 1;} if(t==2){return 1;} if(t==6){return 1;}
  if(t==7){return 1;} if(t==3){return -1;}
  return 0;
}
fn prot_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return 0;} return get32(W,E_PROT()+n*4); }
fn prot_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_PROT()+n*4,v); return; }
fn bid_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return 0;} return get32(W,E_BID()+n*4); }
fn bid_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_BID()+n*4,v); return; }
fn own_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_OWN()+n*4); }
fn own_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_OWN()+n*4,v); return; }
fn rtr_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return 0;} return get32(W,E_RTR()+n*4); }
fn rtr_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_RTR()+n*4,v); return; }
fn memh_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_MEMH()+n*4); }
fn memh_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_MEMH()+n*4,v); return; }
fn memn_get(W:[]u8,e:i32)i32 { if(e<0||e>=262144){return -1;} return get32(W,E_MEMN()+e*4); }
fn memn_set(W:[]u8,e:i32,v:i32)void { if(e<0||e>=262144){return;} set32(W,E_MEMN()+e*4,v); return; }
fn t9h_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_T9H()+n*4); }
fn t9h_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_T9H()+n*4,v); return; }
fn t9n_get(W:[]u8,e:i32)i32 { if(e<0||e>=262144){return -1;} return get32(W,E_T9N()+e*4); }
fn t9n_set(W:[]u8,e:i32,v:i32)void { if(e<0||e>=262144){return;} set32(W,E_T9N()+e*4,v); return; }
fn chm_get(W:[]u8,m:i32)i32 { if(m<0||m>=262144){return -1;} return get32(W,E_CHM()+m*4); }
fn chm_set(W:[]u8,m:i32,v:i32)void { if(m<0||m>=262144){return;} set32(W,E_CHM()+m*4,v); return; }
fn chn_get(W:[]u8,c:i32)i32 { if(c<0||c>=262144){return -1;} return get32(W,E_CHN()+c*4); }
fn chn_set(W:[]u8,c:i32,v:i32)void { if(c<0||c>=262144){return;} set32(W,E_CHN()+c*4,v); return; }
fn vcb_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_VCB()+n*4); }
fn vcb_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_VCB()+n*4,v); return; }
fn vnx_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_VNX()+n*4); }
fn vnx_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_VNX()+n*4,v); return; }
fn vpv_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_VPV()+n*4); }
fn vpv_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_VPV()+n*4,v); return; }
fn bce_get(W:[]u8,b:i32)i32 { if(b<0||b>=8192){return 0;} return get32(W,E_BCE()+b*4); }
fn bce_set(W:[]u8,b:i32,v:i32)void { if(b<0||b>=8192){return;} set32(W,E_BCE()+b*4,v); return; }
fn vb_head(W:[]u8,b:i32)i32 { if(b<0||b>=8192){return -1;} return get32(W,VBH()+b*4); return; }
fn vb_set(W:[]u8,b:i32,v:i32)void { if(b<0||b>=8192){return;} set32(W,VBH()+b*4,v); return; }
fn vm_get(W:[]u8)i32 { return get32(W,VBH()+32768); }
fn vm_set(W:[]u8,v:i32)void { set32(W,VBH()+32768,v); return; }
fn vc_get(W:[]u8)i32 { return get32(W,VBH()+32772); }
fn vc_set(W:[]u8,v:i32)void { set32(W,VBH()+32772,v); return; }
// ============ C555 SUBLINEAR LOWEST-SET-BIT (K11) ============
// E_BMB was a reserved-but-unused 32768-byte region (allocated and zeroed at
// init, referenced nowhere else). It is used here as a ONE-LEVEL SUMMARY over
// E_BMC: bit j of summary byte i is set iff bitmap byte i of E_BMC is nonzero.
// The summary is maintained inside the generic mutators bms/bmx/bmz, guarded on
// the base being E_BMC, so no call site can be missed -- vto, vdrop and the init
// sequence all mutate E_BMC and none of them needed editing.
// Without it sel_fast walked all 262144 ids and charged 262144 probes per
// eviction: 2.4e9 probes at 9337 evictions, which is why the C554 K4 runs
// TIMEOUT at 600 s. Probes are counted per byte touched in counter 933.
fn bmg(W:[]u8,b:i32,i:i32)i32 { if(i<0||i>=262144){return 0;} return (g8(W,b+i/8)>>(i%8))&1; }
fn bms(W:[]u8,b:i32,i:i32)void {
  let o:i32=b+i/8; s8(W,o,g8(W,o)|(1<<(i%8)));
  // NOTE o is an ABSOLUTE workspace offset, not a byte index. The summary index
  // must be derived from i, never from o: indexing the summary by o/8 mixes a
  // base of 43.8 million into a 4096-byte structure and silently reads
  // unrelated workspace. Caught by the K11a equivalence kill bar, which is
  // exactly what it was written to catch.
  if(b==E_BMC()){ let q:i32=i/8; s8(W,E_BMB()+q/8, g8(W,E_BMB()+q/8)|(1<<(q%8))); }
  return;
}
fn bmx(W:[]u8,b:i32,i:i32)void {
  let o:i32=b+i/8; s8(W,o,g8(W,o)^(1<<(i%8)));
  if(b==E_BMC()){
    let q:i32=i/8;
    if(g8(W,o)==0){ s8(W,E_BMB()+q/8, g8(W,E_BMB()+q/8)^(1<<(q%8))); }
  }
  return;
}
fn bmz(W:[]u8,b:i32,n:i32)void {
  let i:i32=0; while(i<n){s8(W,b+i,0); i=i+1;}
  if(b==E_BMC()){ bmz(W,E_BMB(),262144/64); }
  return;
}
fn byte_find(W:[]u8,k:i32,from:i32)i32 {
  let v:i32=g8(W,E_BMC()+k);
  if(v==0){return -1;}
  let m:i32=0;
  while(m<8){
    if(((v>>m)&1)==1){
      let idx:i32=k*8+m;
      if(idx>=from){return idx;}
    }
    m=m+1;
  }
  return -1;
}
fn scan_run(W:[]u8,o:i32,e:i32,from:i32)i32 {
  let k:i32=o;
  while(k<e){
    padd(W,933);
    let f:i32=byte_find(W,k,from);
    if(f>=0){return f;}
    k=k+1;
  }
  return -1;
}
// lowest index >= from with a set bit in E_BMC, or -1
fn find_bl(W:[]u8,from:i32)i32 {
  if(from<0){from=0;}
  if(from>=262144){return -1;}
  let o:i32=from/8;
  while(o<32768){
    padd(W,933);
    if(g8(W,E_BMB()+o/8)!=0){
      let e:i32=o+8; if(e>32768){e=32768;}
      let f:i32=scan_run(W,o,e,from);
      if(f>=0){return f;}
    }
    o=o+8;
  }
  return -1;
}
fn contrib(W:[]u8,n:i32)i32 {
  return ing(W,1,n)+ing(W,2,n)+ing(W,6,n)+ing(W,7,n)-ing(W,3,n);
}
fn bidx(W:[]u8,v:i32)i32 {
  let b:i32=v+VBIAS();
  if(b<0){padd(W,832); return 0;}
  if(b>=8192){padd(W,832); return 8191;}
  if(v+2>get32(W,VBH()+32776)){set32(W,VBH()+32776,v+2);}
  return b;
}
// ---- victim index ----
// ---- R3: reset a recycled node slot. The free-id bitmap hands the SAME id
// back, and a slot that was linked in the victim index at the moment it died
// would otherwise hand its stale (vcb, vpv, vnx, vel) to the next life: the
// next vto would vunlink against neighbours that have since moved, silently
// losing list entries and leaving vb_head pointing at a node that claims no
// bucket. Measured: vlink(h==n) fired 2698 times and one bucket list had a
// cycle (audit_vic never terminated). A node slot carries list membership only
// while it is live, so allocation re-establishes the sentinel unconditionally.
fn vreset(W:[]u8,n:i32)void {
  vtr(W,3,n,vcb_get(W,n),vel_get(W,n),vpv_get(W,n),vnx_get(W,n));
  vcb_set(W,n,-1); vnx_set(W,n,-1); vpv_set(W,n,-1); vel_set(W,n,0);
  inh_set(W,n,-1); ouh_set(W,n,-1); memh_set(W,n,-1); t9h_set(W,n,-1);
  own_set(W,n,-1); chn_set(W,n,-1); rtr_set(W,n,0);
  return;
}
// list-integrity checker. Called at the ENTRY and the EXIT of vto/vdrop.
// Code 1: pv==-1 but the node is not its claimed bucket's head (orphan).
// Code 2: the predecessor does not point back (broken back-link).
// Code 3: the successor does not point back (broken forward-link).
// Code 4: vcb>=0 but the bucket head is the node itself while pv!=-1.
fn vchk(W:[]u8,n:i32,code:i32)void {
  let ob:i32=vcb_get(W,n);
  if(ob<0 || ob>=8192){return;}
  let pv:i32=vpv_get(W,n); let nx:i32=vnx_get(W,n);
  let c:i32=0;
  if(pv<0){ if(vb_head(W,ob)!=n){c=1;} }
  else { if(vb_head(W,ob)==n){c=4;} else { if(vnx_get(W,pv)!=n){c=2;} } }
  if(c==0 && nx>=0 && vpv_get(W,nx)!=n){c=3;}
  if(c!=0){
    if(code==1 && pget(W,895)==0){ pset(W,895,c); pset(W,894,n); pset(W,896,ob); pset(W,897,code); }
    paddv(W,889+code,1);
  }
  return;
}
fn TRC()i32 { return PB()+1200*4; }
fn vtr(W:[]u8,op:i32,a:i32,b:i32,c:i32,d:i32,e:i32)void {
  let t:i32=get32(W,TRC());
  if(t>=400){return;}
  let o:i32=TRC()+4+t*24;
  set32(W,o,op); set32(W,o+4,a); set32(W,o+8,b); set32(W,o+12,c); set32(W,o+16,d); set32(W,o+20,e);
  set32(W,TRC(),t+1); return;
}
fn vlink(W:[]u8,n:i32,b:i32)void {
  let h:i32=vb_head(W,b);
  vtr(W,1,n,b,h,vcb_get(W,n),vel_get(W,n));
  if(h==n){paddv(W,877,1); pset(W,878,n); pset(W,879,b);
    if(pget(W,877)==1){pset(W,898,vcb_get(W,n)); pset(W,899,vel_get(W,n)); pset(W,900,ng(W,n,36)); pset(W,901,bidx(W,bid_get(W,n)));}
    return;}
  if(h>=2 && h<262144 && vnx_get(W,h)==n){paddv(W,880,1); pset(W,881,h); pset(W,882,b);}
  vnx_set(W,n,-1); vpv_set(W,n,-1); vcb_set(W,n,b);
  if(h<0){vb_set(W,b,n); return;}
  // PREPEND: head -> n -> h -> ... . The invariant is pv(n)==-1 EXACTLY when
  // n is the head of its bucket, which is what vunlink relies on to know it
  // must patch vb_head instead of a predecessor.
  // R4 DEFECT (measured, C541): this used to read
  //     vnx_set(h,n); vpv_set(n,h); vb_set(b,n);
  // i.e. it pointed the OLD HEAD at the new node while also making the new
  // node the head. Every bucket list was therefore truncated to its most
  // recent member: the head reached nothing, and the old head pointed into an
  // unreachable region holding a node whose vcb said it lived in this bucket.
  // Consequences measured at D=990, zero evictions: vlink saw h==n 3710
  // times, one bucket list had a real cycle, bucket 1026's bce overshot its
  // true eligible count by 7069, and audit_vic never terminated. Selection
  // would have silently skipped 7069 real candidates, so the sublinear
  // selector was not merely slow, it was WRONG.
  vnx_set(W,n,h); vpv_set(W,h,n); vb_set(W,b,n); return;
}
fn vunlink(W:[]u8,n:i32,b:i32)void {
  vtr(W,2,n,b,vcb_get(W,n),vpv_get(W,n),vnx_get(W,n));
  let pv:i32=vpv_get(W,n); let nx:i32=vnx_get(W,n);
  if(pv<0 && vb_head(W,b)!=n){paddv(W,883,1); pset(W,884,n); pset(W,885,b); pset(W,886,vb_head(W,b));}
  if(pv<0 && nx==n){paddv(W,887,1); pset(W,888,n);}
  if(pv>=0){vnx_set(W,pv,nx);} else {if(vb_head(W,b)==n){vb_set(W,b,nx);}}
  if(nx>=0){vpv_set(W,nx,pv);}
  vcb_set(W,n,-1); vnx_set(W,n,-1); vpv_set(W,n,-1); return;
}
fn velig(W:[]u8,n:i32)i32 { if(prot_get(W,n)>0){return 0;} return 1; }
fn vto(W:[]u8,n:i32,b:i32)void {
  let ob:i32=vcb_get(W,n);
  if(ob==b && vel_get(W,n)==velig(W,n)){return;}
  vchk(W,n,1);
  let el:i32=velig(W,n);
  if(ob>=0){
    let oel:i32=vel_get(W,n);
    vunlink(W,n,ob);
    let c:i32=bce_get(W,ob)-oel;
    bce_set(W,ob,c);
    if(c==0 && ob==vc_get(W)){bmx(W,E_BMC(),n);}
  }
  vlink(W,n,b);
  bce_set(W,b,bce_get(W,b)+el);
  vel_set(W,n,el);
  if(b==vc_get(W)){bms(W,E_BMC(),n);}
  if(b<vm_get(W)){padd(W,835); vm_set(W,b);}
  vchk(W,n,2);
  return;
}
fn vdrop(W:[]u8,n:i32)void {
  vtr(W,4,n,vcb_get(W,n),vel_get(W,n),vpv_get(W,n),vnx_get(W,n));
  let ob:i32=vcb_get(W,n);
  if(ob<0){return;}
  vchk(W,n,3);
  let oel:i32=vel_get(W,n);
  vunlink(W,n,ob);
  let c:i32=bce_get(W,ob)-oel;
  bce_set(W,ob,c);
  vel_set(W,n,0);
  if(c==0 && ob==vc_get(W)){bmx(W,E_BMC(),n);}
  return;
}
// recompute n's victim bucket from live state. Called at EVERY place bid,
// protection, tag or liveness can change.
// MEMBERSHIP IS EXACTLY THE FROZEN ELIGIBILITY PREDICATE and nothing else:
// evict_scan accepts any live node with is_prot==0, with NO tag test. An
// earlier version restricted the index to tag 1 and tag 20, which made the
// index a strict SUBSET of the frozen candidate set: the audit then showed
// bce mismatches, and worse, sel_fast could return a different victim than
// evict_scan. Matching the predicate verbatim is what makes K2 kill bar (a)
// ("the fast policy selects EXACTLY the node the frozen scan selects")
// satisfiable at all.
//   pset(W,122) bit0 = tag-20 nodes are NOT eligible (MAP-preserve policy).
// With bit0 clear the behaviour is bit-identical to evict_scan.
// C556 K10 THE CONSEQUENCE TERM. A cell whose owner is a LIVE MAP that is cited
// at least once is not a reclamation victim.
//
// The frozen key bid_ref is an IN-DEGREE. A MAP's ANSWER FACT is created by
// promote_graph and cited by nothing, so it sits at bid 0 -- strictly below
// every MAP (bid 2) and below every junk cell. C554 measured the consequence:
// all six foundational MAP nodes survived and all six foundational ANSWER
// FACTS were reclaimed, downstream_ans=-2 against expect=7000. The frozen key
// ranks the load-bearing answer of old foundational structure as the cheapest
// object in the arena.
//
// The replacement signal is OWNERSHIP, which is O(1) (own_get and bid_get are
// hash-slot reads), is not age, is not access frequency, and is not bid. If cell
// c dies while its owner is live, the owner's graph is damaged and the owner can
// lose an answer. That is a downstream-consequence statement.
//
// The threshold is 3 and is NOT fixture-tuned: promote_graph gives every MAP
// type-2 and type-6 self-edges, so an uncited MAP's bid is exactly 2 and
// bid >= 3 IS "cited at least once".
fn own_protected(W:[]u8,n:i32)i32 {
  let ow:i32=own_get(W,n);
  if(ow<2 || ow>=262144){return 0;}
  if(ng(W,ow,36)!=1){return 0;}
  if(ng(W,ow,0)!=20){return 0;}
  if(bid_get(W,ow)<3){return 0;}
  return 1;
}
fn vre(W:[]u8,n:i32)void {
  if(n<2 || n>=262144){return;}
  padd(W,836);
  if(ng(W,n,36)!=1){vdrop(W,n); return;}
  if(ng(W,n,0)==40){vdrop(W,n); padd(W,914); return;}
  if((pget(W,122)&1)==1){ if(ng(W,n,0)!=20){vdrop(W,n); return;} }
  if(own_protected(W,n)==1){vdrop(W,n); padd(W,932); return;}
  vto(W,n,bidx(W,bid_get(W,n)));
  return;
}
// ensure the bitmap for the current vmin bucket exists and is exact
fn vprep(W:[]u8)i32 {
  let vm:i32=vm_get(W);
  if(vm>=8192){return -1;}
  if(vc_get(W)==vm){return vm;}
  padd(W,848);
  bmz(W,E_BMC(),262144/8);
  let n:i32=vb_head(W,vm); let hp:i32=0;
  while(n>=0){ if(hp>262144){ paddv(W,873,1); pset(W,874,vm); pset(W,875,n); pset(W,876,hp); return -1; } hp=hp+1; bms(W,E_BMC(),n); n=vnx_get(W,n); }
  vc_set(W,vm); return vm;
}
fn bid_max(W:[]u8)i32 { return get32(W,VBH()+32776); }

// ---- type-10 (MEM) out-edge lists: the bid fan-out channel ----
fn mem_add(W:[]u8,f:i32,e:i32)void {
  let h:i32=memh_get(W,f);
  memn_set(W,e,h); memh_set(W,f,e); padd(W,843); return;
}
fn mem_del(W:[]u8,f:i32,e:i32)void {
  let h:i32=memh_get(W,f); let p:i32=-1;
  while(h>=0){ if(h==e){break;} p=h; h=memn_get(W,h); }
  if(h<0){return;}
  let nx:i32=memn_get(W,e);
  if(p>=0){memn_set(W,p,nx);} else {memh_set(W,f,nx);}
  memn_set(W,e,-1); return;
}
// ---- type-9 (PRO) in-edge lists: makes ref_prot O(own type-9 edges) ----
fn t9_add(W:[]u8,n:i32,e:i32)void {
  let h:i32=t9h_get(W,n);
  t9n_set(W,e,h); t9h_set(W,n,e); return;
}
fn t9_del(W:[]u8,n:i32,e:i32)void {
  let h:i32=t9h_get(W,n); let p:i32=-1;
  while(h>=0){ if(h==e){break;} p=h; h=t9n_get(W,h); }
  if(h<0){return;}
  let nx:i32=t9n_get(W,e);
  if(p>=0){t9n_set(W,p,nx);} else {t9h_set(W,n,nx);}
  t9n_set(W,e,-1); return;
}
// ---- general incident-edge lists: makes edge death O(deg(n)) not O(NE) ----
fn inh_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_INH()+n*4); }
fn inh_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_INH()+n*4,v); return; }
fn inn_get(W:[]u8,e:i32)i32 { if(e<0||e>=262144){return -1;} return get32(W,E_INN()+e*4); }
fn inn_set(W:[]u8,e:i32,v:i32)void { if(e<0||e>=262144){return;} set32(W,E_INN()+e*4,v); return; }
fn ouh_get(W:[]u8,n:i32)i32 { if(n<0||n>=262144){return -1;} return get32(W,E_OUH()+n*4); }
fn ouh_set(W:[]u8,n:i32,v:i32)void { if(n<0||n>=262144){return;} set32(W,E_OUH()+n*4,v); return; }
fn oun_get(W:[]u8,e:i32)i32 { if(e<0||e>=262144){return -1;} return get32(W,E_OUN()+e*4); }
fn oun_set(W:[]u8,e:i32,v:i32)void { if(e<0||e>=262144){return;} set32(W,E_OUN()+e*4,v); return; }
fn il_add(W:[]u8,f:i32,to:i32,e:i32)void {
  let h:i32=inh_get(W,to); inn_set(W,e,h); inh_set(W,to,e);
  let h2:i32=ouh_get(W,f); oun_set(W,e,h2); ouh_set(W,f,e); return;
}
fn il_del(W:[]u8,f:i32,to:i32,e:i32)void {
  let h:i32=inh_get(W,to); let p:i32=-1;
  while(h>=0){ if(h==e){break;} p=h; h=inn_get(W,h); }
  if(h>=0){ let nx:i32=inn_get(W,e); if(p>=0){inn_set(W,p,nx);} else {inh_set(W,to,nx);} inn_set(W,e,-1); }
  let h2:i32=ouh_get(W,f); let p2:i32=-1;
  while(h2>=0){ if(h2==e){break;} p2=h2; h2=oun_get(W,h2); }
  if(h2>=0){ let nx2:i32=oun_get(W,e); if(p2>=0){oun_set(W,p2,nx2);} else {ouh_set(W,f,nx2);} oun_set(W,e,-1); }
  return;
}
// seq_nx: the frozen form scanned all NE edges for a type-12 edge out of c.
// R1's per-node OUT list (E_OUH/E_OUN) makes it O(deg(c)) with the same
// answer: the SEQ edges out of c are exactly the type-12 entries on that list.
// This is on the write path (t2_asm_chain, ownership registration, measures),
// so the scan version was the dominant NEW cost at 5k MAPs: 262144 probes per
// chain link, per MAP.
fn seq_nx(W:[]u8,c:i32)i32 {
  let e:i32=ouh_get(W,c);
  while(e>=0){
    if(eg(W,e,4)==12 && eg(W,e,0)==c){return eg(W,e,8);}
    e=oun_get(W,e);
  }
  return -1;
}
// ==========================================================================
// R1 hooks.  link_edge/edge_del are the ONLY places edge liveness changes,
// so every R1 counter is a delta applied here and nowhere else.
// ==========================================================================
fn ev_link(W:[]u8,e:i32)void {
  let f:i32=eg(W,e,0); let t:i32=eg(W,e,4); let to:i32=eg(W,e,8); let ck:i32=eg(W,e,12);
  il_add(W,f,to,e);
  inset(W,t,to,1);
  if(t==9){ if(ck>0){prot_set(W,to,prot_get(W,to)+1);} t9_add(W,to,e); }
  if(t==10){ mem_add(W,f,e); }
  let d:i32=dt(t);
  if(d!=0){
    bid_set(W,to,bid_get(W,to)+d);
    let q:i32=memh_get(W,to);
    while(q>=0){
      let nx:i32=memn_get(W,q); let g:i32=eg(W,q,8);
      bid_set(W,g,bid_get(W,g)+d); vre(W,g);
      q=nx;
    }
  }
  if(t==10){ bid_set(W,to,bid_get(W,to)+contrib(W,f)); }
  vre(W,to);
  return;
}
fn ev_del(W:[]u8,e:i32)void {
  let f:i32=eg(W,e,0); let t:i32=eg(W,e,4); let to:i32=eg(W,e,8); let ck:i32=eg(W,e,12);
  if(t==10){ bid_set(W,to,bid_get(W,to)-contrib(W,f)); mem_del(W,f,e); }
  if(t==9){ if(ck>0){prot_set(W,to,prot_get(W,to)-1);} t9_del(W,to,e); }
  inset(W,t,to,-1);
  let d:i32=dt(t);
  if(d!=0){
    bid_set(W,to,bid_get(W,to)-d);
    let q:i32=memh_get(W,to);
    while(q>=0){
      let nx:i32=memn_get(W,q); let g:i32=eg(W,q,8);
      bid_set(W,g,bid_get(W,g)-d); vre(W,g);
      q=nx;
    }
  }
  il_del(W,f,to,e);
  vre(W,to);
  return;
}
// ---- R1 predicates: O(1) exact ----
fn is_prot(W:[]u8,n:i32)i32 { return prot_get(W,n); }
fn evcount(W:[]u8,n:i32,t:i32)i32 { return ing(W,t,n); }
fn bid(W:[]u8,n:i32)i32 { return bid_get(W,n); }
// ---- R1 REFERENCE predicates, for the differential audit ----
// These answer the SAME questions from a DIFFERENT data structure: the
// per-node incident-edge list (E_INH/E_INN), which is built by walking the
// same two choke points but stores edges, not counts. They are therefore
// O(deg(n)) rather than O(NN*NE), which is what makes the K1 kill bar
// runnable at all, and they are independent of the counter arrays in the
// sense that a bug in the array update cannot hide behind a bug in the list.
fn is_prot_ref(W:[]u8,n:i32)i32 {
  let e:i32=inh_get(W,n); padd(W,5);
  while(e>=0){
    if(eg(W,e,4)==9 && eg(W,e,8)==n && eg(W,e,12)>0){return 1;}
    e=inn_get(W,e);
  }
  return 0;
}
fn evcount_ref(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=inh_get(W,n);
  padd(W,31);
  if(t>=0 && t<16 && pget(W,96+t)==0){return 0;}
  while(e>=0){
    padd(W,5);
    if(eg(W,e,8)==n && eg(W,e,4)==t){c=c+1;}
    e=inn_get(W,e);
  }
  return c;
}
fn bid_ref(W:[]u8,n:i32)i32 {
  let c:i32=evcount_ref(W,n,1)+evcount_ref(W,n,2)+evcount_ref(W,n,6)+evcount_ref(W,n,7)-evcount_ref(W,n,3);
  let e:i32=inh_get(W,n);
  padd(W,4);
  if(pget(W,106)==0){return c;}
  while(e>=0){
    if(eg(W,e,4)==10 && eg(W,e,8)==n){
      let g:i32=eg(W,e,0);
      c=c+evcount_ref(W,g,1)+evcount_ref(W,g,2)+evcount_ref(W,g,6)+evcount_ref(W,g,7)-evcount_ref(W,g,3);
    }
    e=inn_get(W,e);
  }
  return c;
}
// ==========================================================================
// R3 STRUCTURAL RECLAMATION
// ==========================================================================
fn qh(W:[]u8)i32 { return hg(W,64); }
fn qt(W:[]u8)i32 { return hg(W,65); }
fn qpush(W:[]u8,n:i32)void {
  let t:i32=qt(W);
  if(t>=65536){padd(W,829); return;}
  set32(W,E_Q()+t*4,n); hs(W,65,t+1); return;
}
fn qpop(W:[]u8)i32 {
  let h:i32=qh(W);
  if(h>=qt(W)){return -1;}
  let v:i32=get32(W,E_Q()+h*4); hs(W,64,h+1); return v;
}
fn own_add(W:[]u8,m:i32,c:i32)void {
  own_set(W,c,m);
  chn_set(W,c,chm_get(W,m)); chm_set(W,m,c); return;
}
fn ev_kill(W:[]u8,n:i32)void {
  padd(W,825);
  vre(W,n);
  let e:i32=inh_get(W,n);
  while(e>=0){ let nx:i32=inn_get(W,e); padd(W,826); edge_del(W,e); e=nx; }
  e=ouh_get(W,n);
  while(e>=0){ let nx:i32=oun_get(W,e); padd(W,826); edge_del(W,e); e=nx; }
  ns(W,n,36,0); hs(W,20,hg(W,20)-1);
  // R3 FIX (measured): the id is about to be returned to the free bitmap. It
  // must NOT still be linked in the victim index, or the next life inherits a
  // half-link. Drop it here, after the final edge deletion has settled its bid
  // and protection, and before the id is freed.
  vdrop(W,n);
  fb_set(W,NB0(),NB1(),NB2(),n,1);
  return;
}
fn reclaim_one(W:[]u8,m:i32,c:i32)void {
  if(c<2 || c>=262144){return;}
  if(ng(W,c,36)!=1){return;}
  let o:i32=own_get(W,c);
  if(o==-2){padd(W,828); return;}
  if(o!=m){return;}
  let rf:i32=ing(W,1,c)+ing(W,2,c)+ing(W,3,c)+ing(W,6,c)+ing(W,7,c)+ing(W,12,c);
  if(rf>0){padd(W,827); return;}
  if(rtr_get(W,c)>0){padd(W,827); return;}
  let q:i32=ouh_get(W,c);
  while(q>=0){
    let nx:i32=oun_get(W,q); let g:i32=eg(W,q,8);
    if(g>=2 && g<262144 && own_get(W,g)==m && bmg(W,E_VIS(),g)==0){ bms(W,E_VIS(),g); qpush(W,g); }
    q=nx;
  }
  padd(W,830);
  ev_kill(W,c);
  own_set(W,c,-1); chn_set(W,c,-1);
  return;
}
// atomic structural reclamation of everything a MAP exclusively owns.
// shared nodes (facts, or a root another MAP still points at) are SKIPPED.
// the VIS bitmap makes a cyclic ownership/edge shape terminate.
fn reclaim_map(W:[]u8,m:i32)i32 {
  bmz(W,E_VIS(),262144/8);
  hs(W,64,0); hs(W,65,0);
  let c:i32=chm_get(W,m);
  chm_set(W,m,-1);
  while(c>=0){
    let nx:i32=chn_get(W,c);
    if(c>=2 && c<262144 && bmg(W,E_VIS(),c)==0){ bms(W,E_VIS(),c); qpush(W,c); }
    c=nx;
  }
  let done:i32=0;
  let g:i32=qpop(W);
  while(g>=0){ reclaim_one(W,m,g); done=done+1; g=qpop(W); }
  return done;
}
// victim selection, fast path: no global scan.
// frozen tie-break = lowest node id in cyclic order starting at the allocator
// cursor; reproduced exactly by scanning the current bucket's bitmap.
// C555 K11: the probe is now sublinear. The linear reference is retained
// verbatim as sel_fast_ref so the two can be compared ELEMENT FOR ELEMENT in
// one process (kill bar K11a) instead of being argued about.
fn sel_next_fast(W:[]u8,from:i32)i32 {
  let best:i32=find_bl(W,from);
  while(best>=0){
    if(own_protected(W,best)==0){return best;}
    padd(W,932); best=find_bl(W,best+1);
  }
  return -1;
}
fn sel_next_ref(W:[]u8,from:i32)i32 {
  let i:i32=from; let best:i32=-1;
  while(i<262144){ paddv(W,934,262144); if(bmg(W,E_BMC(),i)==1){ if(own_protected(W,i)==0){return i;} } i=i+1; }
  return best;
}
fn sel_fast(W:[]u8)i32 {
  let b:i32=vm_get(W);
  while(b<8192 && bce_get(W,b)==0){ padd(W,835); b=b+1; }
  vm_set(W,b);
  if(b>=8192){return -1;}
  let vm:i32=vprep(W);
  if(vm<0){return -1;}
  let cur:i32=hg(W,8); if(cur<2){cur=2;}
  let best:i32=sel_next_fast(W,cur);
  if(best<0){ best=sel_next_fast(W,2); }
  return best;
}
fn sel_fast_ref(W:[]u8)i32 {
  let b:i32=vm_get(W);
  while(b<8192 && bce_get(W,b)==0){ padd(W,835); b=b+1; }
  vm_set(W,b);
  if(b>=8192){return -1;}
  let vm:i32=vprep(W);
  if(vm<0){return -1;}
  let cur:i32=hg(W,8); if(cur<2){cur=2;}
  let best:i32=sel_next_ref(W,cur);
  if(best<0){ best=sel_next_ref(W,2); }
  return best;
}
fn do_evict(W:[]u8,n:i32)i32 {
  let tg:i32=ng(W,n,0);
  let root:i32=ng(W,n,20);
  // C546 classify every eviction so the charter-32 test can report WHICH class
  // of structure was reclaimed, not merely how many. Counter 920 counts
  // tag-20 victims whose subject falls outside BOTH declared ranges, so the
  // identity 85 == 86 + 87 + 920 is an ASSERTION, not an assumption about the
  // test world's subject space.
  if(tg==20){
    let sb:i32=ng(W,n,8);
    let cf:i32=0;
    if(sb>=1000 && sb<1006){ padd(W,86); cf=1; }
    if(sb>=20000 && sb<60000){ padd(W,87); cf=cf+1; }
    if(cf==0){ padd(W,920); }
    padd(W,85);
  } else { padd(W,84); }
  if(tg==20){
    if(root>=2 && root<262144){rtr_set(W,root,rtr_get(W,root)-1);}
    rec_evict(W,n);
    ev_kill(W,n);
    padd(W,831);
    reclaim_map(W,n);
    own_set(W,n,-1);
  } else {
    // C561 WHAT ACTUALLY DIED. The C554 report classified reclaimed non-MAP
    // nodes into FACT/HISTORY/GOALI/FRAME/OTHER but the taxonomy lived in a
    // source that was never committed, so it cannot be reproduced or checked.
    // These five counters are keyed on the node's own tag, which is in the
    // committed engine, plus one counter for version history defined
    // structurally: a node that participates in the fact supersession chain
    // (a live type-5 edge to a predecessor) IS version history. K12d requires
    // this to be 0.
    let rct:i32=ng(W,n,0);
    if(rct==1){padd(W,936);}
    if(rct==9){padd(W,937);}
    if(rct==12){padd(W,938);}
    if(rct==13){padd(W,939);}
    if(rct!=1 && rct!=9 && rct!=12 && rct!=13){padd(W,940);}
    let e5:i32=inh_get(W,n); let hv:i32=0;
    while(e5>=0){ if(eg(W,e5,4)==5){hv=1;} e5=inn_get(W,e5); }
    if(hv==1){padd(W,941);}
    rec_evict(W,n);
    ev_kill(W,n);
  }
  let nc:i32=n+1; if(nc>=262144){nc=2;} hs(W,8,nc);
  return n;
}
fn evict_node(W:[]u8)i32 {
  padd(W,820);
  // C550 THREE NAMED POLICIES, selected by profiler key 100 (not by a magic
  // bit): 0 = frozen scan (min bid), 1 = fast structural buckets, 2 = LRU-by-
  // oldest-id. Policy 2 exists ONLY as the charter-32 control: if the K4 test
  // cannot make this one lose, it does not discriminate and K4 is inconclusive.
  let pol:i32=pget(W,910);
  if(pol==3){ padd(W,930); return -1; }
  if(pol==1){
    padd(W,821);
    let best:i32=sel_fast(W);
    if(best<0){return -1;}
    padd(W,822);
    padd(W,68);
    return do_evict(W,best);
  }
  if(pol==2){ padd(W,911); padd(W,68); return evict_lru(W); }
  padd(W,824);
  return evict_scan(W);
}
// C550 LRU-BY-OLDEST-ID CONTROL. Eligible set and protection test are
// deliberately IDENTICAL to evict_scan, and the kill is delegated to the SAME
// do_evict() the fast policy uses, so the only difference between the two
// policies is WHICH eligible node is chosen: lowest bid (structural) versus
// lowest id (oldest first). Any difference in what survives is therefore
// attributable to the policy and not to a different eligibility rule or a
// different reclamation path.
fn evict_lru(W:[]u8)i32 {
  let best:i32=-1; let i:i32=2;
  while(i<262144){
    padd(W,912);
    if(ng(W,i,36)==1 && is_prot_ref(W,i)==0 && ng(W,i,0)!=40 && own_protected(W,i)==0){best=i; break;}
    i=i+1;
  }
  if(best<0){return -1;}
  padd(W,913);
  return do_evict(W,best);
}
// the FROZEN eviction, verbatim, retained as the reference policy for K7
fn evict_scan(W:[]u8)i32 {
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<262144){
    let n:i32=cur+i; if(n>=262144){n=n-262144;}
    // C551 the frozen scan had the SAME defect as the fast policy: tag-40
    // index scaffolding was eligible, so the reference policy could also
    // silently destroy the indices. The exemption is applied here too, which
    // is a documented CHANGE TO THE FROZEN REFERENCE, not a preservation of
    // it. Everything else about this function is untouched.
    if(n>=2 && ng(W,n,36)==1 && is_prot_ref(W,n)==0 && ng(W,n,0)!=40 && own_protected(W,n)==0){
      let b:i32=bid_ref(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){return -1;}
  // R3 index hygiene ONLY: evict_scan reads is_prot_ref/bid_ref from the
  // incident-edge lists and is bit-identical to the frozen policy with or
  // without this line; it exists so the victim index stays exact when the
  // reference policy is the one running, which is what makes the K2
  // fast-vs-scan victim comparison legitimate.
  vdrop(W,best);
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  fb_set(W,NB0(),NB1(),NB2(),best,1);
  padd(W,68);
  let e:i32=0;
  while(e<262144){
    padd(W,23);
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){ edge_del(W,e); }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=262144){nc=2;} hs(W,8,nc);
  return best;
}

// ==========================================================================
// NAMESPACE INVARIANT BATTERY (charter 37).
// The disjoint-sign encoding makes node refs (op>=0) and frame refs (op<0)
// unconfusable at ANY arena size, so the invariant that must hold at every
// operand dereference is:
//      op >= 0  ->  op < NN          (node reference)
//      op <  0  ->  (-op)-1 >= 0      (frame slot index, always true here)
// The frozen build relied on the unrelated inequality NN < FRAME_BASE, which
// is asserted nowhere. These guards make the invariant EXPLICIT and counted.
// S1 res_op node branch        S7 exec_val operand
// S2 execute MOVE src          S8 execute MOVE dst
// S3 execute BEQ lhs           S9 t2_exec result operand
// S4 execute BEQ rhs          S10 fr_get frame-chain walk
// S5 execute INC dst          S11 fr_set frame-chain walk
// S6 execute DEC dst
fn nsbad(W:[]u8,site:i32)void {
  padd(W,840); pset(W,841,site); pset(W,842,1); return;
}
fn nsok_node(W:[]u8,op:i32,site:i32)i32 {
  padd(W,839);
  if(op<0){return 0;}
  if(op>=262144){nsbad(W,site); return 0;}
  return 1;
}
fn nsok_frame(W:[]u8,op:i32,site:i32)i32 {
  padd(W,839);
  // C542: a NON-NEGATIVE operand where a frame reference is required is a SIGN
  // type error. The frozen encoding made exactly this mistake silently (a node
  // id read as a frame slot, C299/C375/C527); the disjoint encoding makes it
  // unambiguous, so it is now a COUNTED namespace violation rather than a
  // silent zero. This cannot change any answer: the caller already returned
  // the -999999 failure sentinel on this branch.
  if(op>=0){nsbad(W,site); return 0;}
  if((0-op)-1<0){nsbad(W,site); return 0;}
  return 1;
}
fn ns_reset(W:[]u8)void { pset(W,840,0); pset(W,842,0); pset(W,841,0); pset(W,905,pget(W,839)); return; }
fn ns_dirty(W:[]u8)i32 { return pget(W,842); }
fn ns_site(W:[]u8)i32 { return pget(W,841); }
fn ns_viol(W:[]u8)i32 { return pget(W,840); }
fn ns_checks(W:[]u8)i32 { return pget(W,839); }
// ==========================================================================
// CANARY: the last 4096 bytes of the allocation are pre-filled with a known
// pattern. Any read or write that escapes the arena is detected, so a
// malformed reference cannot hide behind a silent OOB.
// ==========================================================================
fn canary_set(W:[]u8)void {
  let i:i32=0;
  while(i<4096){ s8(W,E_CAN()+i,165+(i%91)); i=i+1; }
  return;
}
fn canary_chk(W:[]u8)i32 {
  let i:i32=0; let bad:i32=0;
  while(i<4096){ if(g8(W,E_CAN()+i)!=(165+(i%91))){bad=bad+1;} i=i+1; }
  if(bad>0){paddv(W,833,bad);}
  return bad;
}
// ==========================================================================
// AUDITS.  These are O(NN*NE) or O(NN) and run only in the correctness mode,
// never in the scale mode.  A nonzero audit count is a hard FAIL.
// ==========================================================================
// A1: fast predicates == frozen scans, for every live node.
fn audit_pred(W:[]u8,lim:i32)i32 {
  let bad:i32=0; let n:i32=2;
  while(n<lim){
    if(ng(W,n,36)==1){
      let a:i32=is_prot(W,n); let b:i32=is_prot_ref(W,n);
      if(a!=b){bad=bad+1;}
      let c:i32=bid(W,n); let d:i32=bid_ref(W,n);
      if(c!=d){paddv(W,851,1); bad=bad+1;}
    }
    n=n+1;
  }
  paddv(W,850,bad);
  return bad;
}
// A2: no dangling edge -- a live edge may only point at a live node.
fn audit_dang(W:[]u8,lim:i32)i32 {
  let bad:i32=0; let e:i32=0;
  while(e<lim){
    if(eg(W,e,0)!=-1){
      let f:i32=eg(W,e,0); let to:i32=eg(W,e,8);
      if(f<2 || f>=262144 || ng(W,f,36)!=1){bad=bad+1;}
      if(to>=2 && to<262144 && ng(W,to,36)!=1){bad=bad+1;}
    }
    e=e+1;
  }
  paddv(W,852,bad);
  return bad;
}
// A3: no fossil -- a dead slot must not be recorded as owned by a live MAP,
// and no history tombstone may have been reclaimed.
fn audit_own(W:[]u8,lim:i32)i32 {
  let bad:i32=0; let n:i32=2;
  while(n<lim){
    let o:i32=own_get(W,n);
    if(ng(W,n,36)!=1 && o!=-1 && o!=-2){bad=bad+1;}
    if(o==-2 && ng(W,n,36)!=1){bad=bad+1;}
    n=n+1;
  }
  paddv(W,853,bad);
  return bad;
}
// A4: victim index consistency -- E_BCE sums to the true eligible count, and
// the bitmap of the current bucket matches its list exactly.
fn audit_vic(W:[]u8,lim:i32)i32 {
  let bad:i32=0; let b:i32=0;
  while(b<8192){
    let live:i32=0;
    let n:i32=vb_head(W,b); let hops:i32=0;
    while(n>=0){ if(hops>262144){ paddv(W,873,1); pset(W,874,b); pset(W,875,n); pset(W,876,hops); return bad; } hops=hops+1;
           if(ng(W,n,36)==1 && prot_get(W,n)==0 && (pget(W,122)&1)!=1){live=live+1;}
           else { if((pget(W,122)&1)==1 && ng(W,n,36)==1 && ng(W,n,0)==20 && prot_get(W,n)==0){live=live+1;} }
           n=vnx_get(W,n); }
    if(live!=bce_get(W,b)){paddv(W,868,1); pset(W,869,b); paddv(W,872,live-bce_get(W,b)); bad=bad+1;}
    b=b+1;
  }
  let vm:i32=vm_get(W);
  if(vm<8192 && vc_get(W)==vm){
    let n2:i32=vb_head(W,vm); let h2:i32=0;
    while(n2>=0){
      if(h2>262144){ paddv(W,873,1); pset(W,874,vm); pset(W,875,n2); pset(W,876,h2); return bad; } h2=h2+1;
      if(bmg(W,E_BMC(),n2)!=1){paddv(W,870,1); bad=bad+1;}
      if(ng(W,n2,36)!=1){paddv(W,871,1); bad=bad+1;}
      n2=vnx_get(W,n2);
    }
  }
  paddv(W,854,bad);
  return bad;
}
// A5: every live type-9 edge is a self edge (measured, not assumed).
fn audit_t9(W:[]u8,lim:i32)i32 {
  let bad:i32=0; let e:i32=0;
  while(e<lim){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,0)!=eg(W,e,8)){bad=bad+1;}
    e=e+1;
  }
  paddv(W,855,bad);
  return bad;
}
// A6: no fossils. An owned graph cell that the owner MAP no longer holds a
// live child-list entry for, while the cell itself is still live, is a fossil.
fn audit_fossil(W:[]u8)i32 {
  let bad:i32=0; let n:i32=2;
  while(n<262144){
    let o:i32=own_get(W,n);
    if(ng(W,n,36)==1 && o>=0 && o<n && ng(W,o,36)==1 && chm_get(W,o)<0 && rtr_get(W,n)==0){
      // owned by a live MAP whose child list was already released
      bad=bad+1;
    }
    n=n+1;
  }
  paddv(W,856,bad);
  return bad;
}
// A7: shared structure was NOT deleted. A node with a live in-edge (any type
// counted as a reference) must be live; equivalently no dead node may still be
// the target of a surviving reference.
fn audit_shared(W:[]u8)i32 {
  let bad:i32=0; let n:i32=2;
  while(n<262144){
    if(ng(W,n,36)!=1 && own_get(W,n)==-1 && rtr_get(W,n)>0){bad=bad+1;}
    n=n+1;
  }
  paddv(W,857,bad);
  return bad;
}
// A8: no history node was ever reclaimed. Every live tag-3 node must still be
// own=-2, and no dead node may be own=-2 (which would mean a tombstone died).
fn audit_hist(W:[]u8)i32 {
  let bad:i32=0; let n:i32=2;
  while(n<262144){
    let lv:i32=ng(W,n,36); let o:i32=own_get(W,n);
    if(lv==1 && ng(W,n,0)==3 && o!=-2){bad=bad+1;}
    if(lv!=1 && o==-2){bad=bad+1;}
    n=n+1;
  }
  paddv(W,858,bad);
  return bad;
}
// ==========================================================================
fn ev_init(W:[]u8)void {
  let i:i32=0;
  while(i<262144){ set32(W,E_MEMH()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_MEMN()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_T9H()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_T9N()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_INH()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_INN()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_OUH()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_OUN()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_OWN()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_CHM()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_CHN()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_VCB()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_VEL()+i*4,0); i=i+1; }
  i=0; while(i<262144){ set32(W,E_VNX()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_VPV()+i*4,-1); i=i+1; }
  i=0; while(i<262144){ set32(W,E_RTR()+i*4,0); i=i+1; }
  i=0; while(i<262144){ set32(W,E_BID()+i*4,0); i=i+1; }
  i=0; while(i<262144){ set32(W,E_PROT()+i*4,0); i=i+1; }
  i=0; while(i<7*262144){ set32(W,E_INT()+i*4,0); i=i+1; }
  i=0; while(i<8192){ set32(W,E_BCE()+i*4,0); set32(W,VBH()+i*4,-1); i=i+1; }
  set32(W,VBH()+32768,0); set32(W,VBH()+32772,-1); set32(W,VBH()+32776,0);
  bmz(W,E_BMC(),262144/8);
  bmz(W,E_VIS(),262144/8);
  bmz(W,E_BMB(),262144/8);
  canary_set(W);
  hs(W,64,0); hs(W,65,0);
  return;
}
// R1: ref_prot walks only n's OWN type-9 in-edges (the t9 list), so it is
// O(#own type-9 edges) instead of O(NE), and it keeps E_PROT exact across the
// clk transition in both directions.
fn ref_prot(W:[]u8,n:i32)void {
  let e:i32=t9h_get(W,n);
  let nv:i32=hg(W,4);
  while(e>=0){
    let nx:i32=t9n_get(W,e);
    let old:i32=eg(W,e,12);
    if((old>0)!=(nv>0)){ let d:i32=0; if(nv>0){d=1;} prot_set(W,n,prot_get(W,n)+d); }
    es(W,e,12,nv);
    e=nx;
  }
  vre(W,n);
  return;
}
// R3 VERSION HISTORY + PROVENANCE.
// The tombstone keeps the frozen field layout (tag 3, field 4 = history chain
// link, fields 20/24/28 = the evicted node's subject/relation/object, field 32
// = clock) and ADDS the evicted node's root graph id (field 8), the node's tag
// (field 12) and a provenance marker (field 16). own = -2 marks the tombstone
// permanently non-reclaimable, so version history survives reclamation.
fn rec_evict(W:[]u8,n:i32)void {
  let h:i32=alloc_raw(W); if(h<0){return;}
  ns(W,h,0,3); write_node(W,h,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
  ns(W,h,4,hg(W,12));
  ns(W,h,8,ng(W,n,20));
  ns(W,h,12,ng(W,n,0));
  ns(W,h,16,1);
  own_set(W,h,-2);
  hs(W,12,h); padd(W,833); return;
}
// ============ events ============
fn log_ev(W:[]u8,k:i32,r0:i32,r1:i32,p0:i32,p1:i32,p2:i32,p3:i32)void {
  let l:i32=hg(W,28); padd(W,18); if(l>=128){return;}
  ls(W,l,0,hg(W,0)); ls(W,l,4,k); ls(W,l,8,r0); ls(W,l,12,r1);
  ls(W,l,16,p0); ls(W,l,20,p1); ls(W,l,24,p2); ls(W,l,28,p3);
  hs(W,28,l+1); return;
}
fn ctx_push(W:[]u8,r:i32)void {
  let i:i32=hg(W,48); hs(W,32+i*4,r); i=i+1; if(i>=4){i=0;} hs(W,48,i); return;
}
fn ctx_get(W:[]u8,i:i32)i32 {
  let x:i32=hg(W,48)-1-i; while(x<0){x=x+4;} return hg(W,32+x*4);
}
// ============ Change 1: trial loop over 4-op ISA graphs ============
// keeper from the frozen base (was in the plan section; it is only an
// edge-link helper, not a template): link two cells via ET_SEQ.
fn seq_link(W:[]u8,a:i32,b:i32)void { link_edge(W,a,12,b,0); return; }
// The MUL Rung B trial loop (propose/execute/verify/promote) as the general
// miss policy. Candidate plans are 4-op ISA graphs (tags 101-104) assembled
// at runtime from primitive cells, executed by execute() (the single
// executor), verified against the triggering observation, and promoted to
// learner state. The fixed plan templates (plan_c2/plan_g/plan_it/plan_ext/
// plan_c2c) and the separate exec_plan executor are removed (K-T2-2, K-T2-3).
// Graph conventions:
// - Cells link via ET_SEQ edges, except BRANCHEQ true-targets (field12).
// - A GUARD cell (BRANCHEQ) with no SEQ fallthrough fails closed: execute
//   returns -999999, which the verifier counts as a rejection.
// - Literals are 902-nodes holding the value in field20 (data, not a new
//   node type; invisible to activate/inc_fill which scan type 1).
// - Frame: fresh 902-node; slot0 = query subject s (chain/count) or 0
//   (sum), slot1 = 0. Root field4 is the output operand (1000+slot).
// - Provenance: each SETREG cell carries an ET_DEP edge to the fact node
//   licensing its link; the MAP node carries ET_DEP edges to all of them.
//   Change 3 (revision) uses this to find stale steps.
// Gather helpers kept verbatim from the frozen base: inc_fill,
// comb_present, popcnt. map_standing/contradict_map kept verbatim.
fn t2_lit(W:[]u8,v:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,902); ns(W,n,20,v); return n;
}
fn t2_cell(W:[]u8,tag:i32)i32 {
  let c:i32=alloc_node(W); if(c<0){return -1;}
  ns(W,c,0,tag); return c;
}
fn t2_guard(W:[]u8,slot:i32,litx:i32)i32 {
  let g:i32=t2_cell(W,102); if(g<0){return -1;}
  ns(W,g,4,-(slot+1)); ns(W,g,8,litx); return g;
}
fn t2_set(W:[]u8,slot:i32,lity:i32)i32 {
  let s:i32=t2_cell(W,101); if(s<0){return -1;}
  ns(W,s,4,-(slot+1)); ns(W,s,8,lity); return s;
}
fn t2_mov(W:[]u8,dst:i32,src:i32)i32 {
  let c:i32=t2_cell(W,101); if(c<0){return -1;}
  ns(W,c,4,-(dst+1)); ns(W,c,8,-(src+1)); return c;
}
fn t2_inc(W:[]u8,slot:i32)i32 {
  let c:i32=t2_cell(W,103); if(c<0){return -1;}
  ns(W,c,4,-(slot+1)); return c;
}
// chain graph: guard each link (v[j] -> v[j+1]), set on match.
fn t2_asm_chain(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  padd(W,14);
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    ns(W,g,12,st);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=st; j=j+1;
  }
  return root;
}
// count graph: chain links, each setting plus an increment, then
// MOVE r0 <- r1 epilogue so the count is the output.
fn t2_asm_count(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    let ic:i32=t2_inc(W,1); if(ic<0){return -1;}
    ns(W,g,12,st); seq_link(W,st,ic);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  let mv:i32=t2_mov(W,0,1); if(mv<0){return -1;}
  seq_link(W,prev,mv);
  return root;
}
// sum graph: unrolled INC cells for the subset total. Negative totals and
// totals beyond the execute budget are skipped (candidate declined).
fn t2_asm_sum(W:[]u8,vals:[]u8,n:i32)i32 {
  let total:i32=0; let i:i32=0;
  while(i<n){total=total+get32(vals,i*4); i=i+1;}
  if(total<=0 || total>900){return -1;}
  let root:i32=-1; let prev:i32=-1;
  i=0;
  while(i<total){
    let c:i32=t2_inc(W,0); if(c<0){return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  return root;
}
// run one candidate graph on a fresh frame; -999999 on any failure.
fn t2_exec(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return -999999;}
  if(root>=262144){nsbad(W,9); return -999999;}
  let fr:i32=alloc_node(W); if(fr<0){return -999999;}
  ns(W,fr,0,902); fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return -999999;}
  let op:i32=ng(W,root,4);
  if(op>=0 && nsok_node(W,op,9)==0){return -999999;}
  return res_op(W,fr,op);
}
// per-relation value chain: v[0]=s; f per link. Returns value count.
fn t2_chain(W:[]u8,s:i32,r:i32,v:[]u8,f:[]u8)i32 {
  padd(W,16);
  set32(v,0,s); let len:i32=1; let cur:i32=s; let done:i32=0;
  while(len<16 && done==0){
    let fnd:i32=t2_lu_first(W,cur,r);
    if(fnd<0){done=1;}
    else {
      set32(v,len*4,ng(W,fnd,28)); set32(f,(len-1)*4,fnd);
      cur=ng(W,fnd,28); len=len+1;
    }
  }
  return len;
}
// BFS paths from s (depth 1..4, no -999 links). Entry: 12 i32 slots:
// len, v0..v4, f0..f3. Returns path count.
// sum candidates: values + licensing facts of s's direct (non -999) facts.
fn t2_gather_sum(W:[]u8,s:i32,vals:[]u8,facts:[]u8)i32 {
  let n:i32=0; let x:i32=2;
  paddv(W,76,262142);
  while(x<262144 && n<12){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==s && ng(W,x,24)!=-999){
      set32(vals,n*4,ng(W,x,28)); set32(facts,n*4,x); n=n+1;
    }
    x=x+1;
  }
  return n;
}
// relations of s, excluding -999.
fn t2_rels(W:[]u8,s:i32,out:[]u8)i32 {
  let rb:[]u8=z_alloc(64); let nr:i32=inc_fill(W,s,rb);
  let n:i32=0; let i:i32=0;
  while(i<nr){
    let r:i32=get32(rb,i*4);
    if(r!=-999){set32(out,n*4,r); n=n+1;}
    i=i+1;
  }
  return n;
}
// verify one candidate. st[0]=tried, st[1]=rejected. Returns the verified
// answer or -2. A failed guard (execute -999999) is a genuine rejection.
fn t2_try_verify(W:[]u8,root:i32,s0:i32,expected:i32,masked:i32,st:[]u8)i32 {
  padd(W,15);
  if(root<0){return -2;}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec(W,root,s0);
  if(masked==1){
    if(v!=-2 && v!=-999999){return v;}
  } else {
    if(expected!=-2 && v==expected){return v;}
  }
  set32(st,4,get32(st,4)+1);
  return -2;
}
// graph signature for revision tests: walk SEQ + BRANCHEQ true-targets,
// record (tag, literal) per cell. Returns cell count.
fn t2_sig(W:[]u8,root:i32,sig:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let ok:i32=1;
  while(cur>=0 && n<32 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ok=0;}
    else {
      set32(sig,n*8,tag);
      let lv:i32=0;
      if(tag==101 || tag==102){
        let ln:i32=ng(W,cur,8);
        if(ln>=0 && ln<262144){lv=ng(W,ln,20);}
      }
      set32(sig,n*8+4,lv);
      n=n+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    }
  }
  return n;
}
// promote a verified trial graph to learner state. MAP layout kept from the
// frozen base (field4=r, field8=s, field20=graph root, field24=promo index,
// field28=answer); provenance DEP edges to licensing facts.
// keepers from the frozen base (verbatim): gather helpers and standing.
fn inc_fill(W:[]u8,s:i32,out:[]u8)i32 {
  let nr:i32=0; let n:i32=2;
  while(n<262144){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s){
      let r:i32=ng(W,n,24); let k:i32=0; let f:i32=0;
      while(k<nr){if(get32(out,k*4)==r){f=1;} k=k+1;}
      if(f==0){set32(out,nr*4,r); nr=nr+1;}
    }
    n=n+1;
  }
  return nr;
}
fn comb_present(W:[]u8)i32 {
  padd(W,75); paddv(W,75,262142);
  let n:i32=2;
  while(n<262144){
    if(ng(W,n,36)==1 && ng(W,n,0)==8){return n;}
    n=n+1;
  }
  return -1;
}
fn popcnt(x:i32)i32 {
  let c:i32=0; while(x>0){c=c+(x&1); x=x>>1;} return c;
}
fn map_standing(W:[]u8,m:i32)i32 {
  let promo:i32=ng(W,m,24); let c:i32=0; let e:i32=0;
  while(e<262144){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==m && e>=promo){
      if(eg(W,e,4)==2){c=c+1;} if(eg(W,e,4)==3){c=c-1;}
    }
    e=e+1;
  }
  return c;
}
fn contradict_map(W:[]u8,m:i32)i32 {
  link_edge(W,m,3,m,0); return 0;
}
// t2_trial: the miss policy. Search order is composition-preserving:
// longer chains (k=2..4) before sums before counts before single hops,
// so masked t_f2 still prefers the 2-hop reading. dc/di gates mirror the
// frozen ablation flags. E-ruling: expected is post-hoc feedback only.
// Trial stats (tried/rejected) packed into header field 16.
fn t2_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  padd(W,81); padd(W,74);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let p:i32=0;
      while(p<np && ans==-2){
        let base:i32=p*48;
        padd(W,82);
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,k+1,f);
          let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
        }
        p=p+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum(W,s,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        padd(W,77); padd(W,72); padd(W,71);
        if(popcnt(mask)==sz){ padd(W,78);
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          let root:i32=t2_asm_sum(W,sv,c); paddv(W,80,c);
          let v2:i32=t2_try_verify(W,root,0,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); padd(W,83); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        let root:i32=t2_asm_count(W,v,len,f);
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==2){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(f,0,get32(paths,base+24));
        let root:i32=t2_asm_chain(W,v,2,f);
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
      }
      p=p+1;
    }
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}
// mp_run: trial-based miss policy (Change 1). E-ruling preserved.
fn mp_run(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  padd(W,17);
  let masked:i32=flags&1; let dc:i32=(flags>>1)&1; let di:i32=(flags>>2)&1;
  return t2_trial(W,s,r,expected,masked,dc,di);
}
// ============ Change 3: generic revision over 4-op executable graphs ============
// On a counterexample (ev_observe contradicts a fact that licenses a graph
// link), the stale step is removed and a corrected step inserted; the
// restructured graph is re-executed and only kept on verification success.
// Topology change, not standing demotion: no CON edge touches the MAP.
fn t2_kill_edge(W:[]u8,a:i32,t:i32,to:i32)void {
  let e:i32=0;
  while(e<262144){
    if(eg(W,e,0)==a && eg(W,e,4)==t && eg(W,e,8)==to){edge_del(W,e);}
    e=e+1;
  }
  return;
}
fn revise_on_contradict(W:[]u8,factn:i32,new_o:i32)void {
  let old_o:i32=ng(W,factn,28);
  if(old_o==new_o){return;}
  let m:i32=2;
  while(m<262144){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let e:i32=0; let hit:i32=0;
      while(e<262144){
        if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1 && eg(W,e,8)==factn){hit=1;}
        e=e+1;
      }
      if(hit==1){t2_revise_graph(W,m,factn,old_o,new_o);}
    }
    m=m+1;
  }
  return;
}
// surgical revision: find the stale SETREG step via provenance, tombstone
// it, insert a corrected step, rewire, re-execute. On verification failure
// the graph is reverted and 0 returned. On success the promoted answer
// fact is contradicted and the corrected answer taught; standing untouched.
fn t2_revise_graph(W:[]u8,m:i32,factn:i32,old_o:i32,new_o:i32)i32 {
  let root:i32=ng(W,m,20); let s:i32=ng(W,m,8); let r:i32=ng(W,m,4);
  let ans_old:i32=ng(W,m,28);
  let e:i32=0; let stale:i32=-1;
  while(e<262144){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==factn){
      let c:i32=eg(W,e,0);
      if(ng(W,c,36)==1 && ng(W,c,0)==101){stale=c;}
    }
    e=e+1;
  }
  if(stale<0){return 0;}
  let g:i32=-1; let c2:i32=2;
  while(c2<262144){
    if(ng(W,c2,36)==1 && ng(W,c2,0)==102 && ng(W,c2,12)==stale){g=c2;}
    c2=c2+1;
  }
  if(g<0){return 0;}
  let succ:i32=seq_nx(W,stale);
  let ly:i32=t2_lit(W,new_o); if(ly<0){return 0;}
  let nst:i32=t2_set(W,0,ly); if(nst<0){return 0;}
  link_edge(W,nst,1,factn,0);
  ns(W,g,12,nst);
  if(succ>=0){seq_link(W,nst,succ);}
  if(succ>=0){t2_kill_edge(W,stale,12,succ);}
  ns(W,stale,0,0); ns(W,stale,36,0);
  let out:i32=t2_exec(W,root,s);
  if(out==-999999){
    ns(W,g,12,stale);
    if(succ>=0){t2_kill_edge(W,nst,12,succ);}
    if(succ>=0){seq_link(W,stale,succ);}
    ns(W,stale,0,101); ns(W,stale,36,1);
    ns(W,nst,0,0); ns(W,nst,36,0);
    return 0;
  }
  let fn2:i32=2;
  while(fn2<262144){
    if(ng(W,fn2,36)==1 && ng(W,fn2,0)==1 && ng(W,fn2,20)==s && ng(W,fn2,24)==r && ng(W,fn2,28)==ans_old){
      link_edge(W,fn2,3,fn2,0);
    }
    fn2=fn2+1;
  }
  ev_teach_in(W,s,r,out);
  ns(W,m,28,out);
  return 1;
}
// ============ unified query: exact hit, else trial, else P-INV, else miss ============
fn k_get(W:[]u8)i32 {
  let n:i32=2;
  while(n<262144){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){return ng(W,n,20);}
    n=n+1;
  }
  let kn:i32=alloc_node(W); if(kn<0){return 3;}
  ns(W,kn,0,903); write_node(W,kn,3,0,0,0);
  link_edge(W,kn,9,kn,hg(W,4)); return 3;
}
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      set32(ex_o,cnt*4,ng(W,n,28)); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return -2;}
  let v0:i32=get32(ex_o,0); let inv:i32=1; let i:i32=1;
  while(i<cnt){if(get32(ex_o,i*4)!=v0){inv=0;} i=i+1;}
  if(inv==1){
    let k:i32=k_get(W);
    if(cnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        ev_teach_in(W,s,r,v0); return v0;
      }
    }
  }
  return -2;
}
// ============ Change 2: miss -> UNCERTAINTY -> guide -> POLICY_ROOT ============
// Integrates the validated inquiry mechanism (commit 18ed3331c): Piece A
// reifies the admission as an UNCERTAINTY node in persistent learner state;
// Piece B constructs a guide linked to POLICY_ROOT. ev_act then selects over
// learner-constructed guides. Existing node/edge types only; no new modes.
// Called from ev_query's cognition path on a true miss.
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,30,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}
fn ev_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0); return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0); return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0); return 1;
}
// ============ ACT: 5-step protocol, directional bid ============
fn ev_act(W:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,-3);
  let pr:i32=ng(W,0,20);
  if(pr<2){log_ev(W,3,0,0,0,0,0,0); return 0;}
  let best:i32=-1; let bb:i32=-999999; let e:i32=0;
  while(e<262144){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && is_superseded(W,cand)==0){
        let r0:i32=ng(W,cand,4); let cj:i32=0; let hit:i32=0;
        while(cj<4){if(r0==ctx_get(W,cj)){hit=1;} cj=cj+1;}
        if(hit==1){
          let b:i32=bid(W,cand);
          if(b>bb){bb=b; best=cand;}
        }
        let e2:i32=0;
        while(e2<262144){
          if(eg(W,e2,0)!=-1){
            let c2:i32=-1;
            if(eg(W,e2,0)==cand){c2=eg(W,e2,8);} else {if(eg(W,e2,8)==cand){c2=eg(W,e2,0);}}
            if(c2>=2 && ng(W,c2,36)==1 && is_superseded(W,c2)==0){
              let r2:i32=ng(W,c2,4); let ck:i32=0; let h2:i32=0;
              while(ck<4){if(r2==ctx_get(W,ck)){h2=1;} ck=ck+1;}
              if(h2==1){
                let b2:i32=bid(W,c2);
                if(b2>bb){bb=b2; best=c2;}
              }
            }
          }
          e2=e2+1;
        }
      }
    }
    e=e+1;
  }
  if(best>=2){
    let av:i32=ng(W,best,20);
    link_edge(W,best,6,best,0); log_ev(W,3,0,0,av,1,0,0); return av;
  }
  log_ev(W,3,0,0,0,0,0,0); return 0;
}
// ============ init ============
fn tnn2_init(W:[]u8)void {
  let i:i32=0;
  while(i<14684224){W[i]=0; i=i+1;}
  let e:i32=0;
  while(e<262144){es(W,e,0,-1); e=e+1;}
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,0); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  // P9 index bootstrap. The bulk edge clear above ran with the index
  // empty, so no index state needed updating there. Every id is free
  // after init except the two sentinel nodes 0 and 1.
  fb_fill(W,NB0(),NB1(),NB2());
  fb_fill(W,EB0(),EB1(),EB2());
  fb_set(W,NB0(),NB1(),NB2(),0,0);
  fb_set(W,NB0(),NB1(),NB2(),1,0);
  pset(W,64,0); pset(W,65,0); pset(W,66,0); pset(W,67,0);
  pset(W,68,0); pset(W,69,0); pset(W,70,0); pset(W,71,0);
  // R1/R2/R3 substructure bootstrap. The bulk edge clear above ran with the
  // index empty, so no index state needed updating there. The tail is zeroed
  // by the allocator; ev_init only installs the -1 sentinels and the canary.
  ev_init(W);
  return;
}
fn pol_get(W:[]u8)i32 { return ng(W,0,20); }
fn pol_set(W:[]u8,v:i32)void { ns(W,0,20,v); return; }
fn mp_get(W:[]u8)i32 { return ng(W,1,20); }
fn mp_set(W:[]u8,v:i32)void { ns(W,1,20,v); return; }
// ============ test battery ============
fn tpass(n:[]u8)void { emit(n); emit(" PASS\n"); return; }
fn tfail(n:[]u8)void { emit(n); emit(" FAIL\n"); return; }
// ---- P-INT1: CLA-2 15 tests (compact) ----
fn t_c1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0; let ok:i32=1;
  while(i<40){if(ev_teach(W,1000+i,1,i*7+3)<0){ok=0;} i=i+1;}
  i=0; while(i<40){if(ev_query(W,1000+i,1,-2,0)!=i*7+3){ok=0;} i=i+1;}
  return ok;
}
fn t_c2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0; let c75:i32=0; let last:i32=-1;
  while(i<100){
    let n:i32=ev_teach(W,2000+i,2,i);
    if(n>=0 && last>=0 && ng(W,last,36)==0){c75=c75+1;}
    last=n; i=i+1;
  }
  let sv:i32=0; i=88;
  while(i<100){if(ev_query(W,2000+i,2,-2,0)==i){sv=sv+1;} i=i+1;}
  if(c75==0 && sv==12){return 1;} return 0;
}
fn t_c3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,3001,3,10); let r:i32=ev_observe(W,3001,3,20);
  let ce:i32=0; let e:i32=0;
  while(e<262144){if(eg(W,e,0)!=-1 && eg(W,e,4)==3){ce=ce+1;} e=e+1;}
  let cur:i32=ev_query(W,3001,3,-2,0);
  if(r==0 && ce>0 && cur==20){return 1;} return 0;
}
fn t_c4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2); write_node(W,g,0,0,0,0);
  let n:i32=ev_teach(W,4001,4,50); link_edge(W,g,10,n,0); link_edge(W,n,1,g,0);
  link_edge(W,g,6,g,0);
  if(bid(W,n)>0){return 1;} return 0;
}
fn t_c5()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W,5001,5,60); ev_teach(W2,5001,5,60);
  let a:[]u8=z_alloc(110656); let b:[]u8=z_alloc(110656);
  let i:i32=0; while(i<14684224){a[i]=W[i]; b[i]=W2[i]; i=i+1;}
  let eq:i32=1; i=0;
  while(i<14684224){if(a[i]!=b[i]){eq=0;} i=i+1;}
  return eq;
}
fn t_c6()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let root:i32=alloc_node(W); ns(W,root,0,101);
  ns(W,root,4,1000); ns(W,root,8,7);

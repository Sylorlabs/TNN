  ns(W,m,0,20); write_node(W,m,301,71,401,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1);
  contradict_map(W,m);
  if(map_standing(W,m)<0){return 1;} return 0;

// e11_driver.zag -- SCALING-EVICT driver.
//
// Pure Zag. All statistics, audits and profiles are computed and printed from
// inside the Zag binary; the shell only times whole runs and hashes stdout.
//
// K0: the allocation is CORRECTED. The inherited driver allocated
// 3674176+P9X() = 7,556,800 bytes while the re-dimensioned engine addresses
// 44,172,768. Every edge record and every index cell lived outside the
// buffer. TOT() is the exact last byte used (canary end) and the buffer is
// allocated zeroed over its whole length.
//
// Usage: e11_prof D MODE PHASE EXTRA
//   D     = number of broken plen-2 decoys (0, 90, 990, 4995, ...)
//   MODE  = bit0 MAPidx, bit1 MTF, bit2 FACTidx,
//           bit3 FAST structural eviction, bit4 victim set = tag1+tag20
//   PHASE = 0 all, 1 facts only, 2 facts+decoys+real, 3 all, 4 junk/found,
//           5 namespace battery
//   EXTRA = arbitrary integer parameter (JUNK-found count, injection site)

fn TOT()i32 { return 45221344; }
fn e11_big()[]u8 {
  let n:i32=TOT();
  let W:[]u8=z_alloc(n);
  let i:i32=0;
  while(i<n){W[i]=0; i=i+1;}
  return W;
}
fn atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0;
  let n:i32=s.len;
  if(n==0){return -1;}
  while(i<n){
    let c:i32=s[i] as i32;
    if(c<48){return v;}
    if(c>57){return v;}
    v=v*10+(c-48); i=i+1;
  }
  return v;
}
fn pk(k:i32)[]u8 {
  if(k==0){return "ev_teach_calls ";}
  if(k==1){return "evteach_prev_visits ";}
  if(k==2){return "decay_edge_visits ";}
  if(k==3){return "activate_node_visits ";}
  if(k==4){return "activate_bid_calls ";}
  if(k==5){return "bid_edge_visits ";}
  if(k==6){return "ev_query_calls ";}
  if(k==7){return "evquery_recent_visits ";}
  if(k==8){return "rebind_lin_visits ";}
  if(k==9){return "idx_bucket_visits ";}
  if(k==10){return "gather_fact_visits ";}
  if(k==11){return "verify_attempts ";}
  if(k==12){return "verify_accepted ";}
  if(k==13){return "verify_rejected ";}
  if(k==14){return "asm_chain_calls ";}
  if(k==15){return "try_verify_calls ";}
  if(k==16){return "t2_chain_calls ";}
  if(k==17){return "mp_run_calls ";}
  if(k==18){return "log_ev_calls ";}
  if(k==19){return "alloc_node_calls ";}
  if(k==20){return "alloc_scan_visits ";}
  if(k==21){return "alloc_evict_paths ";}
  if(k==22){return "is_superseded_calls ";}
  if(k==23){return "link_edge_scan_visits ";}
  if(k==24){return "link_edge_calls ";}
  if(k==25){return "qpath_alloc_bytes ";}
  if(k==26){return "decay_calls ";}
  if(k==27){return "alloc_raw_calls ";}
  if(k==28){return "lu_first_visits ";}
  if(k==30){return "fact_top_calls ";}
  if(k==31){return "evcount_calls ";}
  if(k==68){return "evictions ";}
  if(k==69){return "fact_stack_compactions ";}
  if(k==70){return "mp_run_visits ";}
  if(k==71){return "mp_plan_visits ";}
  if(k==72){return "trial_visits ";}
  if(k==73){return "bootstrap_miss_calls ";}
  if(k==74){return "t2_trial_visits ";}
  if(k==820){return "evict_calls ";}
  if(k==821){return "sel_fast_calls ";}
  if(k==822){return "evict_fast_visits ";}
  if(k==824){return "evict_scan_visits ";}
  if(k==825){return "ev_kill_visits ";}
  if(k==826){return "edge_death_visits ";}
  if(k==827){return "shared_skip ";}
  if(k==828){return "history_skip ";}
  if(k==829){return "qpush_visits ";}
  if(k==830){return "nodes_reclaimed ";}
  if(k==831){return "structural_reclaims ";}
  if(k==832){return "victim_ovf_visits ";}
  if(k==833){return "tombstones ";}
  if(k==835){return "vmin_visits ";}
  if(k==836){return "vre_calls ";}
  if(k==839){return "ns_checks ";}
  if(k==840){return "ns_violations ";}
  if(k==843){return "mem_fanout_visits ";}
  if(k==848){return "bitmap_rebuilds ";}
  if(k==850){return "audit_pred_bad ";}
  if(k==851){return "audit_bid_mismatch ";}
  if(k==852){return "audit_dangling ";}
  if(k==853){return "audit_own_bad ";}
  if(k==854){return "audit_victim_bad ";}
  if(k==855){return "audit_t9_bad ";}
  if(k==856){return "audit_fossil ";}
  if(k==857){return "audit_shared_killed ";}
  if(k==858){return "audit_hist_killed ";}
  if(k==868){return "vic_bce_mismatch ";}
  if(k==869){return "vic_bad_bucket ";}
  if(k==870){return "vic_bitmap_miss ";}
  if(k==871){return "vic_dead_in_list ";}
  if(k==872){return "vic_bce_delta ";}
  if(k==860){return "dependents_sum ";}
  if(k==861){return "recon_cost_sum ";}
  if(k==862){return "predict_use_sum ";}
  if(k==863){return "compose_use_sum ";}
  if(k==864){return "uniqueness_sum ";}
  if(k==865){return "revision_sum ";}
  if(k==866){return "forgotten_answers ";}
  if(k==867){return "reasked_answers ";}
  return "? ";
}
fn pk2(k:i32)[]u8 {
  if(k==122){return "vic_set_tags ";}
  if(k==120){return "evict_policy ";}
  if(k==121){return "sel_cycle_visits ";}
  if(k==123){return "bid_max ";}
  if(k==124){return "structural_calls ";}
  if(k==125){return "sel_match ";}
  if(k==126){return "sel_mismatch ";}
  return "? ";
}
fn e11_scan_maxnode(W:[]u8)i32 {
  let mx:i32=-1; let n:i32=2;
  while(n<262144){
    if(ng(W,n,36)==1 && n>mx){mx=n;}
    n=n+1;
  }
  return mx;
}
fn e11_dump(W:[]u8,tag:[]u8,D:i32,mode:i32,ph:i32)void {
  emit("E11DUMP tag="); emit(tag);
  emit(" D="); e64(D); emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" max_node_id="); e64(e11_scan_maxnode(W));
  emit(" teaches="); e64(hg(W,0));
  emit("\n");
  let k:i32=0;
  while(k<32){ emit("  "); emit(pk(k)); e64(pget(W,k)); emit("\n"); k=k+1; }
  emit("  evictions "); e64(pget(W,68)); emit("\n");
  emit("  fact_stack_compactions "); e64(pget(W,69)); emit("\n");
  emit("  mp_run_calls "); e64(pget(W,17)); emit("\n");
  emit("  mp_run_visits "); e64(pget(W,70)); emit("\n");
  emit("  mp_plan_visits "); e64(pget(W,71)); emit("\n");
  emit("  trial_visits "); e64(pget(W,72)); emit("\n");
  emit("  t2_trial_visits "); e64(pget(W,74)); emit("\n");
  let j:i32=120;
  while(j<=126){ emit("  "); emit(pk2(j)); e64(pget(W,j)); emit("\n"); j=j+1; }
  let i2:i32=820;
  while(i2<=833){ emit("  "); emit(pk(i2)); e64(pget(W,i2)); emit("\n"); i2=i2+1; }
  emit("  ns_checks "); e64(pget(W,839)); emit("\n");
  emit("  ns_violations "); e64(pget(W,840)); emit("\n");
  emit("  ns_site "); e64(pget(W,841)); emit("\n");
  emit("  mem_fanout_visits "); e64(pget(W,843)); emit("\n");
  emit("  bitmap_rebuilds "); e64(pget(W,848)); emit("\n");
  let m:i32=850;
  while(m<=875){ emit("  "); emit(pk(m)); e64(pget(W,m)); emit("\n"); m=m+1; }
  return;
}
fn e11_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn e11_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn e11_q(W:[]u8,q:i32,lab:[]u8)void {
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit("E11Q "); emit(lab);
  emit(" q="); e64(q);
  emit(" ans="); e64(b);
  emit(" tried="); e64(hg(W,16)/1024);
  emit(" rejected="); e64(hg(W,16)-(hg(W,16)/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" ok="); e64(b==q+104); emit("\n");
  return;
}
fn e11_setup(W:[]u8,mode:i32)void {
  tnn2_init(W);
  pset(W,120,mode&8);
  pset(W,122,(mode&16)/16);
  idx_mode_set(W,mode&7);
  return;
}
// ---------- audit of what survived: charter 32 measures, not the key ----------
fn e11_measures(W:[]u8)void {
  let n:i32=2; let dep:i32=0; let rec:i32=0; let pu:i32=0; let cu:i32=0;
  let uq:i32=0; let rev:i32=0;
  while(n<262144){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      let root:i32=ng(W,n,20);
      // reconstruction cost = graph length (live SEQ cells from root)
      let g:i32=root; let ln:i32=0;
      while(g>=2 && g<262144 && ln<4096){ln=ln+1; g=seq_nx(W,g);}
      rec=rec+ln;
      // downstream dependents = live type-1 edges out of this MAP (facts it cites)
      let e:i32=inh_get(W,n);
      while(e>=0){ dep=dep+1; e=inn_get(W,e); }
      // predictive usefulness = verified-accept counter contribution
      pu=pu+pget(W,12);
      // uniqueness of evidence: this MAP cited no fact that any other live MAP cites
      let uniq:i32=1; let e2:i32=inh_get(W,n);
      while(e2>=0 && uniq==1){
        if(eg(W,e2,4)==1){
          let f:i32=eg(W,e2,8);
          let b:i32=inh_get(W,f); let shares:i32=0;
          while(b>=0){ if(b!=e2 && eg(W,b,4)==1 && eg(W,b,0)==n){shares=shares+1;} b=inn_get(W,b); }
          if(shares>0){uniq=0;}
        }
        e2=inn_get(W,e2);
      }
      if(uniq==1){uq=uq+1;}
      // revision relevance = live type-3 (contradiction) edges
      let e3:i32=inh_get(W,n);
      while(e3>=0){ if(eg(W,e3,4)==3){rev=rev+1;} e3=inn_get(W,e3); }
      // composition usefulness = MAPs whose root chain cites this MAP's facts
      let e4:i32=inh_get(W,n);
      while(e4>=0){
        if(eg(W,e4,4)==1){
          let f:i32=eg(W,e4,8);
          let b2:i32=inh_get(W,f);
          while(b2>=0){
            let mp:i32=eg(W,b2,0);
            if(eg(W,b2,4)==1 && mp!=n && mp>=2 && mp<262144 && ng(W,mp,36)==1 && ng(W,mp,0)==20){cu=cu+1;}
            b2=inn_get(W,b2);
          }
        }
        e4=inn_get(W,e4);
      }
    }
    n=n+1;
  }
  pset(W,860,dep); pset(W,861,rec); pset(W,862,pu); pset(W,863,cu);
  pset(W,864,uq); pset(W,865,rev);
  return;
}
fn e11_vtrace(W:[]u8)void {
  let t:i32=get32(W,TRC());
  emit("E11VTRACE n="); e64(t); emit("\n");
  let i:i32=0;
  let lo:i32=t-40; if(lo<0){lo=0;}
  i=lo;
  while(i<t){
    let o:i32=TRC()+4+i*24;
    emit(" V"); e64(i);
    emit(" op="); e64(get32(W,o));
    emit(" n="); e64(get32(W,o+4));
    emit(" b="); e64(get32(W,o+8));
    emit(" c="); e64(get32(W,o+12));
    emit(" d="); e64(get32(W,o+16));
    emit(" e="); e64(get32(W,o+20));
    emit("\n");
    i=i+1;
  }
  return;
}
fn e11_report(W:[]u8,lab:[]u8)void {
  emit("E11ASTEP pred\n"); let pb:i32=audit_pred(W,262144);
  emit("E11ASTEP dang\n"); let dg:i32=audit_dang(W,262144);
  emit("E11ASTEP own\n"); let ob:i32=audit_own(W,262144);
  emit("E11ASTEP vic\n"); let vb:i32=audit_vic(W,262144);
  emit("E11ASTEP t9\n"); let tb:i32=audit_t9(W,262144);
  emit("E11ASTEP fossil\n"); let fo:i32=audit_fossil(W);
  emit("E11ASTEP shared\n"); let sh:i32=audit_shared(W);
  emit("E11ASTEP hist\n"); let hi:i32=audit_hist(W);
  emit("E11ASTEP canary\n"); let cy:i32=canary_chk(W);
  emit("E11AUDIT "); emit(lab);
  emit(" pred_bad="); e64(pb);
  emit(" bid_mismatch="); e64(pget(W,851));
  emit(" dangling="); e64(dg);
  emit(" own_bad="); e64(ob);
  emit(" victim_bad="); e64(vb);
  emit(" bce_mismatch="); e64(pget(W,868));
  emit(" bad_bucket="); e64(pget(W,869));
  emit(" bce_delta="); e64(pget(W,872));
  emit(" bitmap_miss="); e64(pget(W,870));
  emit(" dead_in_list="); e64(pget(W,871));
  emit(" list_cycle="); e64(pget(W,873));
  emit(" cyc_bucket="); e64(pget(W,874));
  emit(" cyc_node="); e64(pget(W,875));
  emit(" cyc_hops="); e64(pget(W,876));
  emit(" lk_self="); e64(pget(W,877));
  emit(" lk_selfnode="); e64(pget(W,878));
  emit(" lk_selfb="); e64(pget(W,879));
  emit(" lk_foldbk="); e64(pget(W,880));
  emit(" lk_foldnode="); e64(pget(W,881));
  emit(" lk_foldb="); e64(pget(W,882));
  emit(" ul_orphan="); e64(pget(W,883));
  emit(" ul_orpn="); e64(pget(W,884));
  emit(" ul_orpb="); e64(pget(W,885));
  emit(" ul_orphead="); e64(pget(W,886));
  emit(" ul_selfnx="); e64(pget(W,887));
  emit(" ul_selfnode="); e64(pget(W,888));
  emit(" vchk_orphan="); e64(pget(W,890));
  emit(" vchk_backlink="); e64(pget(W,891));
  emit(" vchk_fwdlink="); e64(pget(W,892));
  emit(" vchk_headpv="); e64(pget(W,893));
  emit(" vchk_first="); e64(pget(W,895));
  emit(" vchk_fn="); e64(pget(W,894));
  emit(" vchk_fb="); e64(pget(W,896));
  emit(" vchk_fs="); e64(pget(W,897));
  emit(" lk1_vcb="); e64(pget(W,898));
  emit(" lk1_vel="); e64(pget(W,899));
  emit(" lk1_live="); e64(pget(W,900));
  emit(" lk1_bidb="); e64(pget(W,901));
  emit(" t9_bad="); e64(tb);
  emit(" fossil="); e64(fo);
  emit(" shared_killed="); e64(sh);
  emit(" hist_killed="); e64(hi);
  emit(" canary="); e64(cy);
  emit(" TOTAL_BAD="); e64(pb+dg+ob+vb+tb+fo+sh+hi+cy);
  emit("\n");
  return;
}
fn e11_run(D:i32,mode:i32,ph:i32,extra:i32,tag:[]u8)void {
  emit("E11START "); emit(tag);
  emit(" D="); e64(D); emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" extra="); e64(extra); emit(" TOT="); e64(TOT()); emit("\n");
  let W:[]u8=e11_big(); e11_setup(W,mode);
  let qi:i32=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  e11_dump(W,"after_facts",D,mode,ph);
  if(ph==1){ emit("E11END\n"); return; }
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(e11_mkbroken(W,20000+i,51,20001+i)<0){fails=fails+1;}
    i=i+1;
  }
  i=0;
  while(i<5){
    if(e11_mkchain(W,5000+i*10,5,51,5004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit("E11BUILD fails="); e64(fails);
  emit(" evictions="); e64(pget(W,68));
  emit(" sel_fast_visits="); e64(pget(W,822));
  emit(" sel_scan_visits="); e64(pget(W,824));
  emit(" reclaimed="); e64(pget(W,830));
  emit(" tombstones="); e64(pget(W,833));
  emit(" bid_max="); e64(bid_max(W));
  emit("\n");
  e11_dump(W,"after_build",D,mode,ph);
  if(ph==2){ emit("E11END\n"); return; }
  set32(W,TRC(),0);
  qi=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    e11_q(W,q,"q");
    e11_dump(W,"after_q",D,mode,ph);
    qi=qi+1;
  }
  e11_report(W,"post"); e11_vtrace(W);
  emit("E11END\n");
  return;
}
// ---------- K4 test world: RECENT JUNK vs OLD FOUNDATIONAL ----------
fn e11_junk_found(JF:i32,mode:i32)void {
  emit("E11JF mode="); e64(mode); emit(" JF="); e64(JF); emit("\n");
  let W:[]u8=e11_big(); e11_setup(W,mode);
  // FOUNDATIONAL: old MAPs with LONG graphs that later MAPs depend on through
  // shared facts. Built FIRST so they get the LOWEST ids.
  let NF:i32=6;
  let fi:i32=0;
  while(fi<NF){
    // foundational MAP fi: a 5-cell chain over its own subject block, plus it
    // teaches the shared fact that the junk MAPs will also cite.
    ev_teach(W,1000+fi,1,7000+fi);
    ev_teach(W,1000+fi,2,7000+fi);
    let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
    ev_teach(W,1000+fi,1,1001+fi); ev_teach(W,1001+fi,1,1002+fi);
    ev_teach(W,1002+fi,1,1003+fi); ev_teach(W,1003+fi,1,1004+fi);
    let len:i32=t2_chain(W,1000+fi,1,v,f);
    let root:i32=t2_asm_chain(W,v,len,f);
    promote_graph(W,root,1000+fi,50,7000+fi,f,len-1);
    fi=fi+1;
  }
  // JUNK: recent short BROKEN MAPs that depend on nothing.
  let ji:i32=0;
  while(ji<JF){
    if(e11_mkbroken(W,20000+ji,51,20001+ji)<0){emit("E11JF jfail\n");}
    ji=ji+1;
  }
  emit("E11JF built found="); e64(NF);
  emit(" junk="); e64(JF);
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" evictions="); e64(pget(W,68));
  emit(" reclaimed="); e64(pget(W,830));
  emit("\n");
  e11_measures(W);
  emit("E11MEAS dependents="); e64(pget(W,860));
  emit(" recon_len="); e64(pget(W,861));
  emit(" uniqueness="); e64(pget(W,864));
  emit(" revisions="); e64(pget(W,865));
  emit(" composition="); e64(pget(W,863));
  emit("\n");
  // Which foundational MAPs survived? A surviving foundational MAP is a live
  // tag-20 node with subject 1000+fi (field 8).
  let sv:i32=0;
  fi=0;
  while(fi<NF){
    let n:i32=2;
    let found:i32=0;
    while(n<262144 && found==0){
      if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==1000+fi){found=1;}
      n=n+1;
    }
    sv=sv+found;
    emit("E11FOUND fi="); e64(fi);
    emit(" survives="); e64(found); emit("\n");
    fi=fi+1;
  }
  emit("E11FOUND total_survived="); e64(sv); emit(" of "); e64(NF); emit("\n");
  // downstream answer: query a later MAP's composed answer that DEPENDS on a
  // foundational fact. A policy that destroyed foundational structure loses it.
  let q1:i32=ev_query(W,1000,50,7000,0);
  emit("E11JF downstream_ans="); e64(q1);
  emit(" expect=7000"); emit(" ok="); e64(q1==7000); emit("\n");
  e11_report(W,"jf");
  emit("E11END\n");
  return;
}
// ---------- K5 namespace injection battery ----------
// Each site is exercised by writing a malformed operand into the LIVE cell
// that site dereferences, then re-running the operation that reads it. The
// reference answer is taken on an unfaulted world first, so a "wrong answer"
// is distinguishable from the intended failure.
fn e11_nsrow(W:[]u8,site:i32,tgt:i32,good:i32,bad:i32)void {
  let pre:i32=canary_chk(W);
  emit("E11NS site="); e64(site);
  emit(" target="); e64(tgt);
  emit(" viol="); e64(ns_viol(W));
  emit(" flagged="); e64(ns_site(W));
  emit(" checks="); e64(ns_checks(W));
  emit(" good="); e64(good);
  emit(" bad="); e64(bad);
  emit(" defined="); e64(bad==-999999);
  emit(" no_wrong="); e64(bad==-999999 || bad==good);
  emit(" canary="); e64(pre+canary_chk(W));
  emit(" ok="); e64(ns_viol(W)>0 && ns_site(W)==site && (bad==-999999 || bad==good) && pre==0 && canary_chk(W)==0);
  emit("\n");
  return;
}
// build a 2-cell MOVE graph and return its root (tag 101) and frame
fn e11_mkcell(W:[]u8,tag:i32)i32 {
  let c:i32=t2_cell(W,tag);
  return c;
}
fn e11_nsbattery()void {
  emit("E11NSBATTERY-START\n");
  // ---- S1 res_op node branch: called directly with an out-of-range node ref
  let W1:[]u8=e11_big(); e11_setup(W1,1);
  ns_reset(W1);
  let fr:i32=alloc_node(W1); ns(W1,fr,0,902);
  let g1:i32=ev_query(W1,900,50,903,0);
  ns_reset(W1);
  let bad1:i32=res_op(W1,fr,300000);
  e11_nsrow(W1,1,300000,g1,bad1);
  // ---- S2 execute MOVE src / S8 execute MOVE dst
  let W2:[]u8=e11_big(); e11_setup(W2,1);
  ev_teach(W2,900,1,901); ev_teach(W2,901,1,902); ev_teach(W2,902,1,903);
  let vv:[]u8=z_alloc(64); let ff:[]u8=z_alloc(60);
  let ln:i32=t2_chain(W2,900,1,vv,ff);
  let rt:i32=t2_asm_chain(W2,vv,ln,ff);
  let fr2:i32=alloc_node(W2); ns(W2,fr2,0,902); fr_set(W2,fr2,0,900); fr_set(W2,fr2,1,0);
  let mv:i32=seq_nx(W2,rt);
  ns_reset(W2);
  ns(W2,mv,8,300000);
  let b2:i32=execute(W2,rt,fr2);
  e11_nsrow(W2,2,mv,ln,b2);
  let W8:[]u8=e11_big(); e11_setup(W8,1);
  ev_teach(W8,900,1,901); ev_teach(W8,901,1,902); ev_teach(W8,902,1,903);
  let v8:[]u8=z_alloc(64); let f8b:[]u8=z_alloc(60);
  let l8:i32=t2_chain(W8,900,1,v8,f8b);
  let r8:i32=t2_asm_chain(W8,v8,l8,f8b);
  let fr8:i32=alloc_node(W8); ns(W8,fr8,0,902); fr_set(W8,fr8,0,900); fr_set(W8,fr8,1,0);
  let mv8:i32=seq_nx(W8,r8);
  ns_reset(W8);
  ns(W8,mv8,4,7);
  let b8:i32=execute(W8,r8,fr8);
  e11_nsrow(W8,8,mv8,l8,b8);
  // ---- S3 BEQ lhs / S4 BEQ rhs
  let W3:[]u8=e11_big(); e11_setup(W3,1);
  ev_teach(W3,900,1,901); ev_teach(W3,901,1,902); ev_teach(W3,902,1,903);
  let v3:[]u8=z_alloc(64); let f3:[]u8=z_alloc(60);
  let l3:i32=t2_chain(W3,900,1,v3,f3);
  let r3:i32=t2_asm_chain(W3,v3,l3,f3);
  let fr3:i32=alloc_node(W3); ns(W3,fr3,0,902); fr_set(W3,fr3,0,900); fr_set(W3,fr3,1,0);
  ns_reset(W3);
  ns(W3,r3,4,300000);
  let b3:i32=execute(W3,r3,fr3);
  e11_nsrow(W3,3,r3,l3,b3);
  let W4:[]u8=e11_big(); e11_setup(W4,1);
  ev_teach(W4,900,1,901); ev_teach(W4,901,1,902); ev_teach(W4,902,1,903);
  let v4:[]u8=z_alloc(64); let f4b:[]u8=z_alloc(60);
  let l4:i32=t2_chain(W4,900,1,v4,f4b);
  let r4:i32=t2_asm_chain(W4,v4,l4,f4b);
  let fr4:i32=alloc_node(W4); ns(W4,fr4,0,902); fr_set(W4,fr4,0,900); fr_set(W4,fr4,1,0);
  ns_reset(W4);
  ns(W4,r4,8,300000);
  let b4:i32=execute(W4,r4,fr4);
  e11_nsrow(W4,4,r4,l4,b4);
  // ---- S5 INC dst / S6 DEC dst
  let W5:[]u8=e11_big(); e11_setup(W5,1);
  let fr5:i32=alloc_node(W5); ns(W5,fr5,0,902);
  let c5:i32=e11_mkcell(W5,103); ns(W5,c5,4,-1);
  ns_reset(W5);
  ns(W5,c5,4,7);
  let b5:i32=execute(W5,c5,fr5);
  e11_nsrow(W5,5,c5,1,b5);
  let W6:[]u8=e11_big(); e11_setup(W6,1);
  let fr6:i32=alloc_node(W6); ns(W6,fr6,0,902);
  let c6:i32=e11_mkcell(W6,104); ns(W6,c6,4,-1);
  ns_reset(W6);
  ns(W6,c6,4,7);
  let b6:i32=execute(W6,c6,fr6);
  e11_nsrow(W6,6,c6,1,b6);
  // ---- S7 exec_val operand
  let W7:[]u8=e11_big(); e11_setup(W7,1);
  ev_teach(W7,900,1,901); ev_teach(W7,901,1,902); ev_teach(W7,902,1,903);
  let v7:[]u8=z_alloc(64); let f7:[]u8=z_alloc(60);
  let l7:i32=t2_chain(W7,900,1,v7,f7);
  let r7:i32=t2_asm_chain(W7,v7,l7,f7);
  ns_reset(W7);
  ns(W7,r7,8,300000);
  let fr7:i32=alloc_node(W7); ns(W7,fr7,0,902); fr_set(W7,fr7,0,900); fr_set(W7,fr7,1,0);
  let b7:i32=exec_val(W7,r7,fr7);
  e11_nsrow(W7,7,r7,l7,b7);
  // ---- S9 t2_exec result operand
  let W9:[]u8=e11_big(); e11_setup(W9,1);
  ev_teach(W9,900,1,901); ev_teach(W9,901,1,902); ev_teach(W9,902,1,903);
  let v9:[]u8=z_alloc(64); let f9:[]u8=z_alloc(60);
  let l9:i32=t2_chain(W9,900,1,v9,f9);
  let r9:i32=t2_asm_chain(W9,v9,l9,f9);
  ns_reset(W9);
  ns(W9,r9,8,300000);
  let b9:i32=t2_exec(W9,r9,900);
  e11_nsrow(W9,9,r9,l9,b9);
  // ---- S10 fr_get / S11 fr_set frame-chain walk
  let W10:[]u8=e11_big(); e11_setup(W10,1);
  let fr10:i32=alloc_node(W10); ns(W10,fr10,0,902);
  ns_reset(W10);
  ns(W10,fr10,4,300000);
  let b10:i32=fr_get(W10,fr10,4);
  e11_nsrow(W10,10,fr10,0,b10);
  let W11:[]u8=e11_big(); e11_setup(W11,1);
  let fr11:i32=alloc_node(W11); ns(W11,fr11,0,902);
  ns_reset(W11);
  ns(W11,fr11,4,300000);
  fr_set(W11,fr11,4,42);
  let c11:i32=fr_get(W11,fr11,0);
  // fr_set must have refused to write through the bad chain link: field 4 of
  // fr11 is unchanged (it was the malformed value, never followed).
  let b11:i32=c11;
  let canary_ok:i32=canary_chk(W11);
  emit("E11NS site=11 target="); e64(fr11);
  emit(" viol="); e64(ns_viol(W11));
  emit(" flagged="); e64(ns_site(W11));
  emit(" checks="); e64(ns_checks(W11));
  emit(" good=0 bad="); e64(b11);
  emit(" defined=1");
  emit(" no_wrong="); e64(b11==0);
  emit(" canary="); e64(canary_ok);
  emit(" ok="); e64(ns_viol(W11)>0 && ns_site(W11)==11 && b11==0 && canary_ok==0);
  emit("\n");
  emit("E11NSBATTERY-END\n");
  return;
}
fn main()i32 {
  emit("E11PROF-START\n");
  let a1:[]u8=_zag_arg(1);
  let a2:[]u8=_zag_arg(2);
  let a3:[]u8=_zag_arg(3);
  let a4:[]u8=_zag_arg(4);
  let D:i32=atoi(a1);
  let mode:i32=atoi(a2);
  let ph:i32=atoi(a3);
  let extra:i32=atoi(a4);
  emit("E11ARGS D="); e64(D);
  emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" extra="); e64(extra); emit("\n");
  if(ph==4){ e11_junk_found(extra,mode); }
  else { if(ph==5){ e11_nsbattery(); } else { e11_run(D,mode,ph,extra,"main"); } }
  if(ph==6){ let W2:[]u8=e11_big(); e11_setup(W2,0); ev_teach(W2,5,1,6); e11_vtrace(W2); }
  emit("E11PROF-END\n");
  return 0;
}
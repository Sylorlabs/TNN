// unpin_h3.zag -- RECLAMATION-H3 lane.
// H3: learner-issued unpin (policy 8) vs the six baselines plus
// policy 7 (importance) and a mechanism-staleness control (policy 9).
// The learner emits unpin for pool entries it judges dead: entries
// recording a belief the learner itself revised away (revision log +
// current-belief check). The mechanism may only reclaim released
// entries; it can never touch a held entry. White-box release trace
// (base 2880) + per-release audit against the true revision log.
// Substrate identical to RECLAMATION-H1; policies 0/1/3/4/5/6/7,
// teachers, tests, and the anchor protocol carried verbatim so the
// H1B 29-condition table reproduces exactly. New: policy 8
// (PIN-UNPIN), policy 9 (PIN-STALE control), learner routines,
// release trace/audit machinery. See PREREG.md for the frozen design,
// derivation notes, kill bars K1..K22.
//
// Header: 0 bumpA (FIFO bump ptr; PART class-A bump ptr), 4 conflicts,
// 8 evictions, 12 table_full_errors, 16 pool_size (=32), 20 policy,
// 24 bumpB (PART class-B bump ptr), 28 drop,
// 32 consent_mask (=16), 36 clock (monotonic last-touch stamp),
// 40 release_clock, 44 unpin_issued, 48 trace_count, 52 revlog_count.
// Primary: 64, 128 slots x 16 bytes. Pool: 2112, 32 slots x 16 bytes.
// Touch side table: 2624, 32 slots x 4 bytes (last-touch per pool slot).
// Released flags: 2752, 32 slots x 4 bytes (0=held; else release stamp;
// written ONLY by learner_unpin).
// Release trace: 2880, 32 entries x 24 bytes
// (slot, key, old_value, reason, episode, claimed_new_value).
// True revision log: 3648, 16 entries x 12 bytes (key, old, new).
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
// popcount of an owner bitmask = importance: number of distinct
// cognitive structures that referenced the entry during teaching.
fn popcnt(v:i32)i32 {
  let c:i32=0;
  let x:i32=v;
  while(x>0){
    if((x&1)==1){c=c+1;}
    x=x>>1;
  }
  return c;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
// last-touch side table (base 2624, 32 x 4 bytes)
fn tget(M:[]u8,s:i32)i32 { return ig(M,2624+s*4); }
fn stamp(M:[]u8,s:i32)void {
  let c:i32=ig(M,36)+1;
  put32(M,36,c);
  put32(M,2624+s*4,c);
  return;
}
// pool_stale: mechanism-level staleness used by policy 9 (PIN-STALE
// control). Returns 1 iff the primary holds the same key with a
// different value. Computed from mechanism state only; the learner's
// beliefs are not consulted.
fn pool_stale(M:[]u8,k:i32,v:i32)i32 {
  let i:i32=0;
  while(i<128){
    let so:i32=soff(64,i);
    let match:i32=0;
    if(ig(M,so+12)==1){ if(ig(M,so)==k){ match=1; } }
    if(match==1){
      if(ig(M,so+4)!=v){return 1;}
      return 0;
    }
    i=i+1;
  }
  return 0;
}
// Policy relocation for the conflict victim at primary slot so.
// Caller has already counted the conflict. After this returns, the
// caller installs the new value in the primary slot.
// (byte-identical mechanism to PINNING-RECLAMATION)
fn relocate(M:[]u8,so:i32)void {
  let pol:i32=ig(M,20);
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  if(pol==0){
    // FIFO: single circular bump pointer modulo 32.
    // (verbatim from EVICTION-POLICY-COMPARE)
    let op:i32=ig(M,0);
    let oo:i32=soff(2112,op);
    if(ig(M,oo+12)==1){put32(M,8,ig(M,8)+1);}
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    put32(M,0,(op+1)%32);
    return;
  }
  if(pol==1){
    // PART: class 1 iff victim owner is exactly 16 (B-only),
    // else class 0 (any A-family bit). 16-slot partition per class,
    // own circular bump pointer modulo 16, FIFO within class.
    // (verbatim from EVICTION-POLICY-COMPARE)
    let cls:i32=0;
    if(vo==16){cls=1;}
    let bp:i32=ig(M,0);
    if(cls==1){bp=ig(M,24);}
    let oo:i32=soff(2112,cls*16+bp);
    if(ig(M,oo+12)==1){put32(M,8,ig(M,8)+1);}
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    bp=(bp+1)%16;
    if(cls==1){put32(M,24,bp);}
    if(cls==0){put32(M,0,bp);}
    return;
  }
  // All policies: scan for the first free slot first.
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,key); put32(M,oo+4,vv);
      put32(M,oo+8,vo); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  // Pool full: reclamation per policy.
  if(pol==4){
    // PIN-LRU: evict the used slot with minimum last-touch.
    // (verbatim from PINNING-RECLAMATION; pool-full path, so all
    // 32 slots are used here)
    let ms:i32=0;
    let mt:i32=tget(M,0);
    s=1;
    while(s<32){
      let tt:i32=tget(M,s);
      if(tt<mt){mt=tt;ms=s;}
      s=s+1;
    }
    let oo:i32=soff(2112,ms);
    put32(M,8,ig(M,8)+1);
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    stamp(M,ms);
    return;
  }
  if(pol==5){
    // PIN-CONSENT: evict the first used slot whose owner intersects
    // the consent mask; other slots stay pinned forever.
    let cm:i32=ig(M,32);
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let consent:i32=0;
      if((ig(M,oo+8)&cm)!=0){consent=1;}
      let ok:i32=0;
      if(used==1){ok=consent;}
      if(ok==1){
        put32(M,8,ig(M,8)+1);
        put32(M,oo,key); put32(M,oo+4,vv);
        put32(M,oo+8,vo); put32(M,oo+12,1);
        stamp(M,s);
        return;
      }
      s=s+1;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==6){
    // PIN-LIVELINESS: owner-blind. Evict the used slot with the
    // minimum last-touch stamp (ties: lowest slot index). Owner
    // identity is never consulted.
    let best:i32=-1;
    let bestt:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      if(used==1){
        let ts:i32=tget(M,s);
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && ts<bestt){take=1;}
        if(take==1){best=s;bestt=ts;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      stamp(M,best);
      return;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==7){
    // PIN-IMP (RECLAMATION-H1): importance-weighted liveness.
    // Importance = popcount of the entry's owner mask (distinct
    // structures referencing the entry; mechanism-maintained from
    // teaching history, never researcher-set). Evict the used slot
    // with minimum (importance, then oldest last-touch stamp, then
    // lowest slot index). Owner identity never directly consulted.
    let best:i32=-1;
    let besti:i32=0;
    let bestt:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      if(used==1){
        let im:i32=popcnt(ig(M,oo+8));
        let ts:i32=tget(M,s);
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && im<besti){take=1;}
        if(best!=-1 && im==besti && ts<bestt){take=1;}
        if(take==1){best=s;besti=im;bestt=ts;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      stamp(M,best);
      return;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==8){
    // PIN-UNPIN (RECLAMATION-H3): the mechanism may only reclaim
    // entries the learner has released. Released flags live at
    // 2752+s*4 (0 = held/pinned; nonzero = release stamp) and are
    // written ONLY by learner_unpin, the learner's reconciliation
    // episode; this branch only reads them. Evict the used slot with
    // the oldest release stamp (ties: lowest slot). With zero
    // releases this is bit-for-bit no-reclaim pinning (drop++).
    let best:i32=-1;
    let bestr:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let rs:i32=ig(M,2752+s*4);
      let cand:i32=0;
      if(used==1){ if(rs!=0){ cand=1; } }
      if(cand==1){
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && rs<bestr){take=1;}
        if(take==1){best=s;bestr=rs;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      // The release is consumed: the new entry was never released by
      // the learner, so the slot stops being reclaimable. Without
      // this, one release would authorize unlimited future evictions
      // from the slot.
      put32(M,2752+best*4,0);
      stamp(M,best);
      return;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==9){
    // PIN-STALE (RECLAMATION-H3 control): mechanism-level staleness.
    // Evict the used slot whose key exists in primary with a
    // different value, oldest touch stamp first (ties: lowest slot).
    // No access to the learner's beliefs. Drop if no slot is stale.
    let best:i32=-1;
    let bestt:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let stale:i32=0;
      if(used==1){ stale=pool_stale(M,ig(M,oo),ig(M,oo+4)); }
      if(stale==1){
        let ts:i32=tget(M,s);
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && ts<bestt){take=1;}
        if(take==1){best=s;bestt=ts;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      stamp(M,best);
      return;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  // PIN-NORECLAIM (policy 3): no reclamation; drop++ and fall back to
  // destroy-in-place (caller installs the new value).
  put32(M,28,ig(M,28)+1);
  return;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Counted identically in all
      // policies; only the relocation outcome is policy-dependent.
      put32(M,4,ig(M,4)+1);
      relocate(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){stamp(M,o);return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- structures (identical to PINNING-RECLAMATION) ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary, single-owner (mode 0): w writes on B-owned fresh
// key 3999. First write allocates; each later write conflicts and
// relocates a B-owned victim. (unchanged from PINNING-RECLAMATION)
fn teach_churn(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3999,900001+j,16);
    j=j+1;
  }
  return;
}
// churn adversary, multi-owner (unchanged from MULTI-OWNER-CHURN).
// mode=1: key 3998 (owner 8) and key 3999 (owner 16), interleaved per
// round. mode=2: adds key 3997 (owner 4) as the first write of each
// round. mode=3 (X2, new): keys 3997 (owner 4) and 3998 (owner 8)
// interleaved per round; no owner-16 churner at all.
fn teach_churn_multi(M:[]u8,mode:i32,w:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    if(mode==3){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    if(mode==1){mem_write(M,3999,900001+j,16);}
    if(mode==2){mem_write(M,3999,900001+j,16);}
    j=j+1;
  }
  return;
}
// adversarial churn, 2-owner importance inflation (mode 4): each churn
// key is written by two owners per round (same key, same val: the
// merge path, no extra conflict). Displaced churn entries carry owner
// masks of popcount 2, inflating their importance past the
// least-important critical entries. Round 0 allocates; rounds 1..20
// produce 2 conflicts each: 40 churn conflicts, cf=60.
fn teach_churn_adv2(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3998,800001+j,8);
    mem_write(M,3998,800001+j,16);
    mem_write(M,3999,900001+j,16);
    mem_write(M,3999,900001+j,8);
    j=j+1;
  }
  return;
}
// adversarial churn, 3-owner importance inflation (mode 5): each churn
// key written by three owners per round (masks of popcount 3). Same
// footprint: 40 churn conflicts, cf=60.
fn teach_churn_adv3(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3998,800001+j,8);
    mem_write(M,3998,800001+j,16);
    mem_write(M,3998,800001+j,4);
    mem_write(M,3999,900001+j,16);
    mem_write(M,3999,900001+j,8);
    mem_write(M,3999,900001+j,4);
    j=j+1;
  }
  return;
}
// churn adversary with benign re-reads interleaved: after every churn
// round, re-run the full A test. The owner-scoped pool reads re-stamp
// every benign pool entry, so the liveness signal sees re-touched
// knowledge as live. Used only by LIVR-M2. Reads add no conflicts.
fn churn_multi_reread(M:[]u8,mode:i32,w:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    if(mode==1){mem_write(M,3999,900001+j,16);}
    if(mode==2){mem_write(M,3999,900001+j,16);}
    let rr:i32=test_A(M,1);
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// ---------- learner: belief lifecycle and unpin (RECLAMATION-H3) ----------
// The simulated learner holds beliefs as owner-scoped readable
// entries and runs cognitive episodes. learner_holds: A-family keys
// (1000+i*10+hop, i=1..10, hop=1..3; 2000+i, i=1..5) and scratch
// keys 5001..5012. Churn keys are never held.
fn lholds(k:i32)i32 {
  if(k>=5001 && k<=5012){return 1;}
  if(k>=2001 && k<=2005){return 1;}
  if(k>=1011 && k<=1103){
    let q:i32=(k-1000)/10;
    let r:i32=(k-1000)%10;
    if(q>=1 && q<=10 && r>=1 && r<=3){return 1;}
  }
  return 0;
}
// revision log entry: 12 bytes (key, old_value, new_value)
fn log_find(B:[]u8,lb:i32,n:i32,key:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(ig(B,lb+i*12)==key){return i;}
    i=i+1;
  }
  return -1;
}
// Episode 1: the learner forms 12 scratch beliefs (fresh keys).
fn learner_scratch(M:[]u8)void {
  let i:i32=1;
  while(i<=12){
    mem_write(M,5000+i,600000+i,1);
    i=i+1;
  }
  return;
}
// Episode 2: the learner revises 8 scratch beliefs. Each write
// conflicts and displaces the old value to the pool; the revision is
// appended to the TRUE revision log (learner state at base 3648).
fn learner_revise(M:[]u8)void {
  let i:i32=1;
  while(i<=8){
    let k:i32=5000+i;
    mem_write(M,k,700000+i,1);
    let c:i32=ig(M,52);
    put32(M,3648+c*12,k);
    put32(M,3648+c*12+4,600000+i);
    put32(M,3648+c*12+8,700000+i);
    put32(M,52,c+1);
    i=i+1;
  }
  return;
}
// Episode 3 (WRONG condition only): modeled memory interference.
// Builds a corrupted log: the 8 true entries plus 5 FALSE entries
// for A keys the learner never revised. old_values match the live
// pool entries; new_values are fictions never written.
fn learner_interfere(M:[]u8,CB:[]u8)void {
  let i:i32=0;
  while(i<8){
    put32(CB,i*12,ig(M,3648+i*12));
    put32(CB,i*12+4,ig(M,3648+i*12+4));
    put32(CB,i*12+8,ig(M,3648+i*12+8));
    i=i+1;
  }
  put32(CB,96,1062); put32(CB,100,614); put32(CB,104,999614);
  put32(CB,108,1072); put32(CB,112,714); put32(CB,116,999714);
  put32(CB,120,1082); put32(CB,124,814); put32(CB,128,999814);
  put32(CB,132,1092); put32(CB,136,914); put32(CB,140,999914);
  put32(CB,144,1102); put32(CB,148,1014); put32(CB,152,9991014);
  return;
}
// The single release authority: ONLY learner_consolidate calls this.
// Sets the released flag (2752+s*4) and appends the white-box trace
// entry (slot, key, old_value, reason, episode, claimed_new_value).
fn learner_unpin(M:[]u8,s:i32,reason:i32,ep:i32,claimed:i32)void {
  let oo:i32=soff(2112,s);
  let rc:i32=ig(M,40)+1;
  put32(M,40,rc);
  put32(M,2752+s*4,rc);
  let tc:i32=ig(M,48);
  let tb:i32=2880+tc*24;
  put32(M,tb,s);
  put32(M,tb+4,ig(M,oo));
  put32(M,tb+8,ig(M,oo+4));
  put32(M,tb+12,reason);
  put32(M,tb+16,ep);
  put32(M,tb+20,claimed);
  put32(M,48,tc+1);
  put32(M,44,ig(M,44)+1);
  return;
}
// Episode 4: belief reconciliation. For each used pool slot (k,v):
// release iff the learner holds k AND k is in the supplied log AND
// log.old_value == v AND (hasty: trust the log; careful: the
// learner's current belief mem_read(k,15) != v). reason=1 (REVISED).
fn learner_consolidate(M:[]u8,LB:[]u8,lb:i32,n:i32,verify:i32)void {
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let k:i32=ig(M,oo);
    let v:i32=ig(M,oo+4);
    let cand:i32=0;
    if(ig(M,oo+12)==1){ if(lholds(k)==1){ cand=1; } }
    let li:i32=-1;
    if(cand==1){ li=log_find(LB,lb,n,k); }
    let lok:i32=0;
    if(li>=0){ lok=1; }
    let oldv:i32=0;
    let newv:i32=0;
    if(lok==1){
      oldv=ig(LB,lb+li*12+4);
      newv=ig(LB,lb+li*12+8);
    }
    let match:i32=0;
    if(lok==1){ if(oldv==v){ match=1; } }
    let rel:i32=0;
    let cn:i32=0;
    if(match==1){
      if(verify==0){ rel=1; cn=newv; }
      if(verify==1){
        let b:i32=mem_read(M,k,15);
        cn=b;
        if(b!=v){ rel=1; }
      }
    }
    if(rel==1){ learner_unpin(M,s,1,4,cn); }
    s=s+1;
  }
  return;
}
// Audit (check code, not mechanism): every trace entry is valid iff
// its key is in the TRUE revision log, trace.old_value matches, and
// the learner's live belief equals log.new_value. Returns
// valid*64+invalid.
fn audit_releases(M:[]u8)i32 {
  let valid:i32=0;
  let invalid:i32=0;
  let tc:i32=ig(M,48);
  let lc:i32=ig(M,52);
  let t:i32=0;
  while(t<tc){
    let tb:i32=2880+t*24;
    let k:i32=ig(M,tb+4);
    let li:i32=log_find(M,3648,lc,k);
    let ok:i32=0;
    if(li>=0){
      let lo_old:i32=ig(M,3648+li*12+4);
      let lo_new:i32=ig(M,3648+li*12+8);
      if(lo_old==ig(M,tb+8)){
        let b:i32=mem_read(M,k,15);
        if(b==lo_new){ ok=1; }
      }
    }
    if(ok==1){valid=valid+1;}
    if(ok==0){invalid=invalid+1;}
    t=t+1;
  }
  return valid*64+invalid;
}
// Releases whose key is an A key (cold-knowledge release count).
fn count_a_released(M:[]u8)i32 {
  let ar:i32=0;
  let tc:i32=ig(M,48);
  let t:i32=0;
  while(t<tc){
    if(ig(M,2880+t*24+4)<5000){ar=ar+1;}
    t=t+1;
  }
  return ar;
}
// The learner's own knowledge check: 12 scratch beliefs read back
// (new values for the `revised` first, old for the rest).
fn learner_check(M:[]u8,revised:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=12){
    let exp:i32=600000+i;
    if(i<=revised){exp=700000+i;}
    if(mem_read(M,5000+i,1)==exp){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
// R layout per condition (32 bytes): 0 pre, 4 post, 8 ret, 12 conflicts,
// 16 evict, 20 bacc, 24 rawA, 28 drop
fn run_cond(M:[]u8,OB:[]u8,pol:i32,chw:i32,mode:i32,tag:[]u8,R:[]u8,ro:i32,rr:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  if(mode==0){teach_churn(M,chw);}
  if(rr==1){churn_multi_reread(M,mode,21);}
  if(rr==0){
    if(mode==1){teach_churn_multi(M,1,21);}
    if(mode==2){teach_churn_multi(M,2,21);}
    if(mode==3){teach_churn_multi(M,3,21);}
    if(mode==4){teach_churn_adv2(M,21);}
    if(mode==5){teach_churn_adv3(M,21);}
  }
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," mode="); e1i(OB,mode as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  if(rr==1){e1s(OB," reread=1");}
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB,"\n");
  return;
}
// H3 condition runner with the learner phase.
// lphase: 0 = none (unused; anchors use run_cond), 1 = full careful,
// 2 = silent (scratch only), 3 = wrong (hasty + corrupted log).
// R layout per H3 row (64-byte stride): 0 pre, 4 post, 8 ret,
// 12 conflicts, 16 evict, 20 bacc, 24 rawA, 28 drop, 32 releases,
// 36 audit_valid, 40 audit_invalid, 44 lcheck, 48 a_released.
fn run_cond_h3(M:[]u8,OB:[]u8,pol:i32,chw:i32,mode:i32,tag:[]u8,R:[]u8,ro:i32,lphase:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  if(lphase>=1){learner_scratch(M);}
  teach_B(M,2);
  let revised:i32=0;
  if(lphase==1 || lphase==3){
    learner_revise(M);
    revised=8;
  }
  if(lphase==1){learner_consolidate(M,M,3648,ig(M,52),1);}
  if(lphase==3){
    let CB:[]u8=z_alloc(256);
    learner_interfere(M,CB);
    learner_consolidate(M,CB,0,13,0);
  }
  let av:i32=0;
  let ai:i32=0;
  if(lphase==1 || lphase==3){
    let packed:i32=audit_releases(M);
    av=packed/64;
    ai=packed%64;
  }
  let ar:i32=count_a_released(M);
  let rel:i32=ig(M,44);
  if(mode==0){teach_churn(M,chw);}
  if(mode==1){teach_churn_multi(M,1,21);}
  if(mode==2){teach_churn_multi(M,2,21);}
  if(mode==3){teach_churn_multi(M,3,21);}
  if(mode==4){teach_churn_adv2(M,21);}
  if(mode==5){teach_churn_adv3(M,21);}
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let lc:i32=0;
  if(lphase>=1){lc=learner_check(M,revised);}
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr);
  put32(R,ro+32,rel); put32(R,ro+36,av); put32(R,ro+40,ai);
  put32(R,ro+44,lc); put32(R,ro+48,ar);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," mode="); e1i(OB,mode as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  e1s(OB," lphase="); e1i(OB,lphase as i64);
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB," releases="); e1i(OB,rel as i64);
  e1s(OB," audit_valid="); e1i(OB,av as i64);
  e1s(OB," audit_invalid="); e1i(OB,ai as i64);
  e1s(OB," lcheck="); e1i(OB,lc as i64);
  e1s(OB," a_released="); e1i(OB,ar as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(16384);
  put32(OB,0,0);
  let R:[]u8=z_alloc(2048);
  e1s(OB,"LANE=RECLAMATION-H3\n");
  // Anchors: policy 5 (consent), single-owner ladder
  run_cond(M,OB,5,1,0,"COND=IMPCON-B0",R,0,0);
  run_cond(M,OB,5,21,0,"COND=IMPCON-A20",R,32,0);
  run_cond(M,OB,5,33,0,"COND=IMPCON-A32",R,64,0);
  // Anchors: policy 3 (pin), multi-owner modes 1/2
  run_cond(M,OB,3,21,1,"COND=IMPPIN-M2",R,96,0);
  run_cond(M,OB,3,21,2,"COND=IMPPIN-M3",R,128,0);
  // Anchors: policy 5 (consent), multi-owner modes 1/2/3
  run_cond(M,OB,5,21,1,"COND=IMPCON-M2",R,160,0);
  run_cond(M,OB,5,21,2,"COND=IMPCON-M3",R,192,0);
  run_cond(M,OB,3,21,3,"COND=IMPPIN-X2",R,224,0);
  run_cond(M,OB,5,21,3,"COND=IMPCON-X2",R,256,0);
  // Anchors: policy 6 (liveness), multi-owner modes 1/2/3
  run_cond(M,OB,6,21,1,"COND=IMPLIV-M2",R,288,0);
  run_cond(M,OB,6,21,2,"COND=IMPLIV-M3",R,320,0);
  run_cond(M,OB,6,21,3,"COND=IMPLIV-X2",R,352,0);
  // Anchors: policy 0 (FIFO), single-owner ladder
  run_cond(M,OB,0,1,0,"COND=IMPFIFO-B0",R,384,0);
  run_cond(M,OB,0,21,0,"COND=IMPFIFO-A20",R,416,0);
  run_cond(M,OB,0,33,0,"COND=IMPFIFO-A32",R,448,0);
  // Anchors: policy 1 (PART), single-owner ladder
  run_cond(M,OB,1,1,0,"COND=IMPPART-B0",R,480,0);
  run_cond(M,OB,1,21,0,"COND=IMPPART-A20",R,512,0);
  run_cond(M,OB,1,33,0,"COND=IMPPART-A32",R,544,0);
  // Anchors: policy 4 (PIN-LRU), single-owner ladder
  run_cond(M,OB,4,1,0,"COND=IMPLRU-B0",R,576,0);
  run_cond(M,OB,4,21,0,"COND=IMPLRU-A20",R,608,0);
  run_cond(M,OB,4,33,0,"COND=IMPLRU-A32",R,640,0);
  // New: policy 7 (importance-weighted liveness), single-owner ladder
  run_cond(M,OB,7,1,0,"COND=IMP-B0",R,672,0);
  run_cond(M,OB,7,21,0,"COND=IMP-A20",R,704,0);
  run_cond(M,OB,7,33,0,"COND=IMP-A32",R,736,0);
  // New: policy 7, multi-owner modes 1/2/3
  run_cond(M,OB,7,21,1,"COND=IMP-M2",R,768,0);
  run_cond(M,OB,7,21,2,"COND=IMP-M3",R,800,0);
  run_cond(M,OB,7,21,3,"COND=IMP-X2",R,832,0);
  // Adversarial-scoring controls: policy 7, modes 4/5
  run_cond(M,OB,7,21,4,"COND=IMPADV-M2",R,864,0);
  run_cond(M,OB,7,21,5,"COND=IMPADV3-M2",R,896,0);
  // New: policy 8 (learner-issued unpin), learner phase, churn ladder
  run_cond_h3(M,OB,8,1,0,"COND=UNPIN-B0",R,928,1);
  run_cond_h3(M,OB,8,21,0,"COND=UNPIN-A20",R,992,1);
  run_cond_h3(M,OB,8,33,0,"COND=UNPIN-A32",R,1056,1);
  // New: policy 8, multi-owner modes 1/2/3
  run_cond_h3(M,OB,8,21,1,"COND=UNPIN-M2",R,1120,1);
  run_cond_h3(M,OB,8,21,2,"COND=UNPIN-M3",R,1184,1);
  run_cond_h3(M,OB,8,21,3,"COND=UNPIN-X2",R,1248,1);
  // Authority control: policy 8 vs policy 3 with a silent learner
  run_cond_h3(M,OB,8,21,0,"COND=UNPIN-SILENT",R,1312,2);
  run_cond_h3(M,OB,3,21,0,"COND=PINCTRL-SILENT",R,1376,2);
  // Learner judgment error: hasty consolidation on a corrupted log
  run_cond_h3(M,OB,8,21,0,"COND=UNPIN-WRONG",R,1440,3);
  // Mechanism-staleness control: policy 9, same learner protocol
  run_cond_h3(M,OB,9,21,0,"COND=UNPINSTALE-A20",R,1504,1);
  // K1 ANCHOR-CONSENT: reproduce frozen CONSENT-MULTIOWNER consent rows
  let k1:i32=1;
  if(ig(R,0)!=35 || ig(R,32)!=35 || ig(R,64)!=35){k1=0;}
  if(ig(R,8)!=100 || ig(R,40)!=100 || ig(R,72)!=100){k1=0;}
  if(ig(R,12)!=20 || ig(R,44)!=40 || ig(R,76)!=52){k1=0;}
  if(ig(R,16)!=0 || ig(R,48)!=8 || ig(R,80)!=20){k1=0;}
  if(ig(R,28)!=0 || ig(R,60)!=0 || ig(R,92)!=0){k1=0;}
  if(ig(R,20)!=20 || ig(R,52)!=20 || ig(R,84)!=20){k1=0;}
  if(ig(R,24)!=35 || ig(R,56)!=35 || ig(R,88)!=35){k1=0;}
  e1s(OB,"K1 ANCHOR-CONSENT -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  // K2 ANCHOR-PIN-MULTI: reproduce frozen MULTI-OWNER-CHURN PIN rows
  let k2:i32=1;
  if(ig(R,96)!=35 || ig(R,128)!=35){k2=0;}
  if(ig(R,104)!=100 || ig(R,136)!=100){k2=0;}
  if(ig(R,108)!=60 || ig(R,140)!=80){k2=0;}
  if(ig(R,112)!=0 || ig(R,144)!=0){k2=0;}
  if(ig(R,124)!=28 || ig(R,156)!=48){k2=0;}
  if(ig(R,116)!=20 || ig(R,148)!=20){k2=0;}
  if(ig(R,120)!=35 || ig(R,152)!=35){k2=0;}
  e1s(OB,"K2 ANCHOR-PIN-MULTI -> "); e1s(OB,pf(k2)); e1s(OB,"\n");
  // K3 ANCHOR-CONSENT-MULTI: reproduce frozen consent M2/M3/X2 rows
  let k3:i32=1;
  if(ig(R,160)!=35 || ig(R,164)!=35){k3=0;}

// bridge.zag -- L3 bridge: generic construction replacing recipes.
// FIXED VARIANT: episode-persistent discovery buffer.
// Derived from l3_bridge_impl/bridge.zag at commit ebdc4fd3e
// (BRIDGE-TESTED), modified only in run_family evidence management:
// D1 (VERIFY stores examples), D2 (no n reset on VERIFY strike),
// D3 (40-cap on appends), R7 (struck invented form ends episode).
// Fix prereg: bridge_fix_impl/PREREG_BRIDGE_FIX_IMPL.md.
// Pure Zag. No Python.
// Derived from form_inventor/inventor.zag (commit 1b8e032c4).
// REMOVED: diagnose() enum, build_tree() recipes, node_count(sig),
// sig-keyed novelty_check(). ADDED: four generic operators
// (OP_CONST_LEAF, OP_SPLIT_LT, OP_SPLIT_EQ, OP_PRUNE), generic candidate
// generation from residual data, construct_search() greedy search,
// generic behavioral novelty, generic HONESTFAIL, refit via fresh
// construct_search with structural-equivalence check.
// Prereg: l3_bridge_impl/PREREG_L3BRIDGE.md (commit 19ce88021).
// Pure Zag. No Python.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen family specs (prereg) ----
fn fam_a(f:i32)i32 {
  if(f==0){return 2;}
  if(f==1){return 3;}
  if(f==2){return 1;}
  if(f==3){return 5;}
  if(f==4){return 2;}
  return 0;
}
fn fam_b(f:i32)i32 {
  if(f==0){return 1;}
  if(f==1){return 5;}
  if(f==2){return 0;}
  if(f==3){return 3;}
  if(f==4){return 9;}
  return 0;
}
fn fam_base(f:i32)i32 {
  if(f==0){return 10;}
  if(f==1){return 1000;}
  if(f==2){return 2000;}
  if(f==3){return 3000;}
  if(f==4){return 4000;}
  if(f==5){return 5000;}
  if(f==6){return 6000;}
  if(f==7){return 7000;}
  if(f==8){return 8000;}
  if(f==9){return 9000;}
  if(f==10){return 10000;}
  if(f==12){return 12000;}
  return 11000;
}
fn true_subj(f:i32,i:i32)i32 { return fam_base(f)+i; }
fn true_obj(f:i32,i:i32)i32 {
  if(f==12){
    if(i<5){
      if(i==2){return 9;}
      return 0;
    }
    return 5;
  }
  if(f==6){
    if(i<3){return 0;}
    return 5;
  }
  if(f==7){
    if(i<1){return 0;}
    return 5;
  }
  if(f==8){
    if(i==1){return 3;}
    if(i==4){return 9;}
    return 7;
  }
  if(f==9){
    return 1+(i%4);
  }
  if(f==10){
    if(i<2){return 0;}
    if(i<4){return 1;}
    return 2;
  }
  if(f==11){
    if(true_subj(f,i)<11003){return 2;}
    return 9;
  }
  if(f==5){
    if(i==1){return 3;}
    return 7;
  }
  let s:i32=true_subj(f,i);
  return fam_a(f)*s+fam_b(f);
}

// ---- example buffer ----
fn bget(b:[]u8,i:i32)i32 { return get32(b,i*4); }
fn bset(b:[]u8,i:i32,v:i32)void { set32(b,i*4,v); return; }

// ---- form fitting: menu forms 0..2 (verbatim from finvent) ----
fn fit_const(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<1){return 0;}
  let c:i32=bget(bo,0);
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=c){return 0;}
    i=i+1;
  }
  set32(p,0,c);
  return 1;
}
fn fit_lin(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<2){return 0;}
  let s0:i32=bget(bs,0);
  let o0:i32=bget(bo,0);
  let s1:i32=bget(bs,1);
  let o1:i32=bget(bo,1);
  let ds:i32=s1-s0;
  let do:i32=o1-o0;
  if(ds==0){return 0;}
  let a:i32=do/ds;
  if(a*ds!=do){return 0;}
  let b:i32=o0-a*s0;
  let i:i32=2;
  while(i<n){
    if(a*bget(bs,i)+b!=bget(bo,i)){return 0;}
    i=i+1;
  }
  set32(p,0,a);
  set32(p,4,b);
  return 1;
}
fn fit_exc(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<3){return 0;}
  let d:i32=bget(bo,0);
  let odd:i32=-1;
  let nodd:i32=0;
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=d){nodd=nodd+1; odd=i;}
    i=i+1;
  }
  if(nodd==1){
    set32(p,0,d);
    set32(p,4,bget(bs,odd));
    set32(p,8,bget(bo,odd));
    return 1;
  }
  if(nodd==n-1){
    let d2:i32=bget(bo,1);
    let j:i32=2;
    let ok:i32=1;
    while(j<n){
      if(bget(bo,j)!=d2){ok=0;}
      j=j+1;
    }
    if(ok==1){
      if(d2!=d){
        set32(p,0,d2);
        set32(p,4,bget(bs,0));
        set32(p,8,d);
        return 1;
      }
    }
  }
  return 0;
}
fn fit_form(form:i32,bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(form==0){return fit_const(bs,bo,n,p);}
  if(form==1){return fit_lin(bs,bo,n,p);}
  return fit_exc(bs,bo,n,p);
}

// ---- R2: fixed constructive operator vocabulary ----
// Node pool at state+52: 8 nodes x 16 bytes (op,a,b,c).
// ops: 0=CONST(c in a), 1=LT(threshold in a), 2=EQ(point in a),
// 3=IF(cond node in a, then node in b, else node in c).
// Root is node 0. Generic evaluators only; no dedicated STEP case.
fn setnode(st:[]u8, ni:i32, op:i32, a:i32, b:i32, c:i32) void {
  let base:i32=52+ni*16;
  set32(st,base,op);
  set32(st,base+4,a);
  set32(st,base+8,b);
  set32(st,base+12,c);
  return;
}
fn teval(st:[]u8, ni:i32, subj:i32) i32 {
  let base:i32=52+ni*16;
  let op:i32=get32(st,base);
  if(op==0){return get32(st,base+4);}
  if(op==1){
    if(subj<get32(st,base+4)){return 1;}
    return 0;
  }
  if(op==2){
    if(subj==get32(st,base+4)){return 1;}
    return 0;
  }
  let cv:i32=teval(st,get32(st,base+4),subj);
  if(cv==1){return teval(st,get32(st,base+8),subj);}
  return teval(st,get32(st,base+12),subj);
}
fn predict(form:i32,st:[]u8,subj:i32)i32 {
  if(form==0){return get32(st,4);}
  if(form==1){return get32(st,4)*subj+get32(st,8);}
  if(form==2){
    if(subj==get32(st,8)){return get32(st,12);}
    return get32(st,4);
  }
  return teval(st,0,subj);
}
// ---- BRIDGE: generic construction operators (design 4.2) ----
// Every setnode call in the new code occurs inside one of these four
// operators. No operator knows about steps, clusters, or exceptions.
// Node pool: 8 nodes at st[52..180], 16 bytes each. Node 0 is the root.
// st[188] holds the node count (nodes 0..nc-1 are live).
// st[180] holds the construction move count (trace length).
fn op_const_leaf(st:[]u8, ni:i32, c:i32) void {
  setnode(st,ni,0,c,0,0);
  return;
}
fn op_split_lt(st:[]u8, ni:i32, t:i32, c_then:i32, c_else:i32, nc:i32) i32 {
  if(nc+3>8){return -1;}
  let cc:i32=nc;
  let th:i32=nc+1;
  let el:i32=nc+2;
  setnode(st,cc,1,t,0,0);
  setnode(st,th,0,c_then,0,0);
  setnode(st,el,0,c_else,0,0);
  setnode(st,ni,3,cc,th,el);
  return nc+3;
}
fn op_split_eq(st:[]u8, ni:i32, v:i32, c_then:i32, c_else:i32, nc:i32) i32 {
  if(nc+3>8){return -1;}
  let cc:i32=nc;
  let th:i32=nc+1;
  let el:i32=nc+2;
  setnode(st,cc,2,v,0,0);
  setnode(st,th,0,c_then,0,0);
  setnode(st,el,0,c_else,0,0);
  setnode(st,ni,3,cc,th,el);
  return nc+3;
}
fn op_prune(st:[]u8, ni:i32, c:i32) void {
  setnode(st,ni,0,c,0,0);
  return;
}

// ---- BRIDGE: buffer helpers ----
fn buf_majority(bo:[]u8, n:i32) i32 {
  if(n<1){return 0;}
  let best:i32=bget(bo,0);
  let bestc:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=bget(bo,i);
    let c:i32=0;
    let j:i32=0;
    while(j<n){
      if(bget(bo,j)==v){c=c+1;}
      j=j+1;
    }
    if(c>bestc){bestc=c; best=v;}
    i=i+1;
  }
  return best;
}
fn tree_correct(st:[]u8, bs:[]u8, bo:[]u8, n:i32) i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if(teval(st,0,bget(bs,i))==bget(bo,i)){c=c+1;}
    i=i+1;
  }
  return c;
}

// ---- BRIDGE: leaf coverage ----
// For leaf node li, collect the indices of buffer points that reach it.
// Returns count; fills cov[0..count-1] with point indices.
fn leaf_cover(st:[]u8, li:i32, bs:[]u8, n:i32, cov:[]u8) i32 {
  let cnt:i32=0;
  let i:i32=0;
  while(i<n){
    let ni:i32=0;
    while(1==1){
      let base:i32=52+ni*16;
      let op:i32=get32(st,base);
      if(op==0){break;}
      if(op==1){
        if(bget(bs,i)<get32(st,base+4)){ni=get32(st,base+8);}
        else {ni=get32(st,base+12);}
      } else {
        if(op==2){
          if(bget(bs,i)==get32(st,base+4)){ni=get32(st,base+8);}
          else {ni=get32(st,base+12);}
        } else {
          let cv:i32=teval(st,get32(st,base+4),bget(bs,i));
          if(cv==1){ni=get32(st,base+8);}
          else {ni=get32(st,base+12);}
        }
      }
    }
    if(ni==li){
      set32(cov,cnt*4,i);
      cnt=cnt+1;
    }
    i=i+1;
  }
  return cnt;
}
fn is_leaf(st:[]u8, ni:i32) i32 {
  let base:i32=52+ni*16;
  if(get32(st,base)==0){return 1;}
  return 0;
}
// Majority output among covered points (cov holds point indices).
fn cover_majority(bo:[]u8, cov:[]u8, cnt:i32) i32 {
  if(cnt<1){return 0;}
  let best:i32=bget(bo,get32(cov,0));
  let bestc:i32=0;
  let i:i32=0;
  while(i<cnt){
    let v:i32=bget(bo,get32(cov,i*4));
    let c:i32=0;
    let j:i32=0;
    while(j<cnt){
      if(bget(bo,get32(cov,j*4))==v){c=c+1;}
      j=j+1;
    }
    if(c>bestc){bestc=c; best=v;}
    i=i+1;
  }
  return best;
}
// Collect sorted distinct subject values among covered points.
// Returns count m; fills vals[0..m-1].
fn cover_distinct_subj(bs:[]u8, cov:[]u8, cnt:i32, vals:[]u8) i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<cnt){
    let s:i32=bget(bs,get32(cov,i*4));
    let f:i32=0;
    let q:i32=0;
    while(q<m){
      if(get32(vals,q*4)==s){f=1;}
      q=q+1;
    }
    if(f==0){
      // insertion sort into vals
      let pos:i32=m;
      while(pos>0 && get32(vals,(pos-1)*4)>s){
        set32(vals,pos*4,get32(vals,(pos-1)*4));
        pos=pos-1;
      }
      set32(vals,pos*4,s);
      m=m+1;
    }
    i=i+1;
  }
  return m;
}

// ---- GREEDY: scan_moves (K=2 plateau lookahead support) ----
// Runs the construct_search candidate enumeration unchanged (same PRUNE
// heuristics, same scan order, same save/apply/evaluate/restore pattern,
// same cost accounting of one unit per tree_correct simulation).
// Records the best strictly-positive move into best[0..5]
// (gain, li, op, p, ct, ce) and every admissible gain-exactly-0 move
// into zbuf (5 slots each: li, op, p, ct, ce) in scan order.
// Returns the zero-gain move count. zcap bounds zbuf writes; with
// zcap=0 no zero-gain moves are recorded (follow-up gain query).
fn scan_moves(st:[]u8, bs:[]u8, bo:[]u8, n:i32, cov:[]u8, vals:[]u8, cur_correct:i32, nc:i32, cost:[]u8, best:[]u8, zbuf:[]u8, zcap:i32) i32 {
  let best_gain:i32=0;
  let best_li:i32=-1;
  let best_op:i32=-1;
  let best_p:i32=0;
  let best_ct:i32=0;
  let best_ce:i32=0;
  let zc:i32=0;
      // Try each leaf in node-index order.
      let li:i32=0;
      while(li<nc){
        if(is_leaf(st,li)==1){
          let cnt:i32=leaf_cover(st,li,bs,n,cov);
          if(cnt>1){
            let m:i32=cover_distinct_subj(bs,cov,cnt,vals);
            let leaf_maj:i32=cover_majority(bo,cov,cnt);
            // PRUNE (optimization; does not change the argmax): for LT,
            // only thresholds at output boundaries in sorted order; for
            // EQ, only values whose output differs from the leaf majority.
            // A non-boundary LT threshold can be slid to a boundary
            // without decreasing gain; an EQ split of a majority-output
            // point cannot have positive gain.
            // LT candidates: thresholds v[1..m-1] at output boundaries.
            let tj:i32=1;
            while(tj<m){
              let t:i32=get32(vals,tj*4);
              // Check if t is at an output boundary: exists a covered
              // point with subj < t and output != output of a covered
              // point with subj >= t (in sorted order, adjacent values
              // differ in output).
              let is_bnd:i32=0;
              // Find outputs just below and at/above t.
              let out_below:i32=-1;
              let out_at:i32=-1;
              let bi:i32=0;
              while(bi<cnt){
                let pi3:i32=get32(cov,bi*4);
                let s3:i32=bget(bs,pi3);
                let o3:i32=bget(bo,pi3);
                if(s3<t){out_below=o3;}
                else {
                  if(s3==t){out_at=o3;}
                }
                bi=bi+1;
              }
              // Simpler boundary test: scan sorted vals for output change.
              // Recompute: get output of vals[tj-1] and vals[tj].
              let o_lo:i32=-1;
              let o_hi:i32=-1;
              let bj:i32=0;
              while(bj<cnt){
                let pj:i32=get32(cov,bj*4);
                if(bget(bs,pj)==get32(vals,(tj-1)*4)){o_lo=bget(bo,pj);}
                if(bget(bs,pj)==t){o_hi=bget(bo,pj);}
                bj=bj+1;
              }
              if(o_lo!=o_hi){is_bnd=1;}
              if(is_bnd==1){
              // Fit constants per side.
              let cnt_then:i32=0;
              let cnt_else:i32=0;
              // Count then/else coverage for majority.
              let ci:i32=0;
              let cov_then:[]u8=z_alloc(40*4);
              let cov_else:[]u8=z_alloc(40*4);
              while(ci<cnt){
                let pi:i32=get32(cov,ci*4);
                if(bget(bs,pi)<t){
                  set32(cov_then,cnt_then*4,pi);
                  cnt_then=cnt_then+1;
                } else {
                  set32(cov_else,cnt_else*4,pi);
                  cnt_else=cnt_else+1;
                }
                ci=ci+1;
              }
              if(cnt_then>0 && cnt_else>0){
                let ct:i32=cover_majority(bo,cov_then,cnt_then);
                let ce:i32=cover_majority(bo,cov_else,cnt_else);
                // Simulate: save leaf, apply, evaluate, restore.
                let save_op:i32=get32(st,52+li*16);
                let save_a:i32=get32(st,52+li*16+4);
                let save_b:i32=get32(st,52+li*16+8);
                let save_c:i32=get32(st,52+li*16+12);
                let nn:i32=op_split_lt(st,li,t,ct,ce,nc);
                if(nn>0){
                  let nc2:i32=tree_correct(st,bs,bo,n);
                  set32(cost,0,get32(cost,0)+1);
                  let g:i32=nc2-cur_correct;
                  if(g>best_gain){
                    best_gain=g; best_li=li; best_op=1;
                    best_p=t; best_ct=ct; best_ce=ce;
                  } else {
                    // GREEDY K=2: record admissible zero-gain moves.
                    if(g==0){
                      if(zc<zcap){
                        set32(zbuf,zc*20,li);
                        set32(zbuf,zc*20+4,1);
                        set32(zbuf,zc*20+8,t);
                        set32(zbuf,zc*20+12,ct);
                        set32(zbuf,zc*20+16,ce);
                        zc=zc+1;
                      }
                    }
                  }
                  // Restore (direct field writes; not a construction op).
                  set32(st,52+li*16,save_op);
                  set32(st,52+li*16+4,save_a);
                  set32(st,52+li*16+8,save_b);
                  set32(st,52+li*16+12,save_c);
                }
              }
              } // end if(is_bnd==1)
              tj=tj+1;
            }
            // EQ candidates: values v[0..m-1], increasing. PRUNE: only
            // values whose output differs from the leaf majority.
            let ej:i32=0;
            while(ej<m){
              let v:i32=get32(vals,ej*4);
              // Find the output of value v.
              let ov:i32=-1;
              let qj:i32=0;
              while(qj<cnt){
                let pj2:i32=get32(cov,qj*4);
                if(bget(bs,pj2)==v){ov=bget(bo,pj2);}
                qj=qj+1;
              }
              if(ov!=leaf_maj){
              let cov_then2:[]u8=z_alloc(40*4);
              let cov_else2:[]u8=z_alloc(40*4);
              let cnt_then2:i32=0;
              let cnt_else2:i32=0;
              let ci2:i32=0;
              while(ci2<cnt){
                let pi2:i32=get32(cov,ci2*4);
                if(bget(bs,pi2)==v){
                  set32(cov_then2,cnt_then2*4,pi2);
                  cnt_then2=cnt_then2+1;
                } else {
                  set32(cov_else2,cnt_else2*4,pi2);
                  cnt_else2=cnt_else2+1;
                }
                ci2=ci2+1;
              }
              if(cnt_then2>0 && cnt_else2>0){
                let ct2:i32=cover_majority(bo,cov_then2,cnt_then2);
                let ce2:i32=cover_majority(bo,cov_else2,cnt_else2);
                let save_op2:i32=get32(st,52+li*16);
                let save_a2:i32=get32(st,52+li*16+4);
                let save_b2:i32=get32(st,52+li*16+8);
                let save_c2:i32=get32(st,52+li*16+12);
                let nn2:i32=op_split_eq(st,li,v,ct2,ce2,nc);
                if(nn2>0){
                  let nc3:i32=tree_correct(st,bs,bo,n);
                  set32(cost,0,get32(cost,0)+1);
                  let g2:i32=nc3-cur_correct;
                  if(g2>best_gain){
                    best_gain=g2; best_li=li; best_op=2;
                    best_p=v; best_ct=ct2; best_ce=ce2;
                  } else {
                    // GREEDY K=2: record admissible zero-gain moves.
                    if(g2==0){
                      if(zc<zcap){
                        set32(zbuf,zc*20,li);
                        set32(zbuf,zc*20+4,2);
                        set32(zbuf,zc*20+8,v);
                        set32(zbuf,zc*20+12,ct2);
                        set32(zbuf,zc*20+16,ce2);
                        zc=zc+1;
                      }
                    }
                  }
                  set32(st,52+li*16,save_op2);
                  set32(st,52+li*16+4,save_a2);
                  set32(st,52+li*16+8,save_b2);
                  set32(st,52+li*16+12,save_c2);
                }
              }
              } // end if(ov!=leaf_maj)
              ej=ej+1;
            }
          }
        }
        li=li+1;
      }
  set32(best,0,best_gain);
  set32(best,4,best_li);
  set32(best,8,best_op);
  set32(best,12,best_p);
  set32(best,16,best_ct);
  set32(best,20,best_ce);
  return zc;
}
// ---- BRIDGE: construct_search (design 4.4 + GREEDY K=2 lookahead) ----
// Greedy hill-climbing over (leaf, operator, parameter), upgraded with a
// 2-ply plateau lookahead (greedy_fix/GREEDY_FIX_DESIGN.md section 3).
// Gain = correct-after minus correct-before (B_node = 0, frozen).
// Each iteration: compute the best 1-ply admissible move (gain g1, move
// m1) and the set Z of admissible gain-exactly-0 moves via scan_moves.
// For each z in Z (scan order), simulate z and compute the best 1-ply
// follow-up gain unlocked(z) from the resulting state. Let z* be the
// first z maximizing unlocked(z). If Z is nonempty and
// unlocked(z*) > g1, apply z* (plateau move). Else if g1 > 0 apply m1
// (unchanged greedy behavior). Else terminate (unchanged HONESTFAIL
// path). One GREEDY ledger line is emitted per iteration; the
// BRIDGE MOVE line for an applied move is unchanged. Cost accounting:
// each candidate simulation and each follow-up scan simulation counts 1,
// exactly as before. Returns 1 iff the final tree exactly fits.
fn construct_search(st:[]u8, bs:[]u8, bo:[]u8, n:i32, cost:[]u8) i32 {
  if(n<1){return 0;}
  // Initialize: single constant leaf (node 0).
  let maj:i32=buf_majority(bo,n);
  op_const_leaf(st,0,maj);
  let nc:i32=1;
  set32(st,188,nc);
  set32(st,180,0);
  set32(cost,0,get32(cost,0)+1);
  let cur_correct:i32=tree_correct(st,bs,bo,n);
  set32(cost,0,get32(cost,0)+1);
  let moves:i32=0;
  let cov:[]u8=z_alloc(40*4);
  let vals:[]u8=z_alloc(40*4);
  let best:[]u8=z_alloc(24);
  let best2:[]u8=z_alloc(24);
  let zbuf:[]u8=z_alloc(2048*20);
  let done:i32=0;
  while(done==0){
    if(moves>=24){done=1;}
    else {
      // 1-ply scan: best positive move into best[], zero-gain moves
      // into zbuf (scan order). Returns the zero-gain count.
      let zc:i32=scan_moves(st,bs,bo,n,cov,vals,cur_correct,nc,cost,best,zbuf,2048);
      let g1:i32=get32(best,0);
      // 2-ply: for each zero-gain move, simulate it and measure the
      // best follow-up gain from the resulting state.
      let ub:i32=0;
      let pl_li:i32=0;
      let pl_op:i32=0;
      let pl_p:i32=0;
      let pl_ct:i32=0;
      let pl_ce:i32=0;
      let zi:i32=0;
      while(zi<zc){
        let zli:i32=get32(zbuf,zi*20);
        let zop:i32=get32(zbuf,zi*20+4);
        let zp:i32=get32(zbuf,zi*20+8);
        let zct:i32=get32(zbuf,zi*20+12);
        let zce:i32=get32(zbuf,zi*20+16);
        // Simulate z: save the leaf fields, apply, evaluate, restore.
        let zs0:i32=get32(st,52+zli*16);
        let zs1:i32=get32(st,52+zli*16+4);
        let zs2:i32=get32(st,52+zli*16+8);
        let zs3:i32=get32(st,52+zli*16+12);
        let nnz:i32=0;
        if(zop==1){
          nnz=op_split_lt(st,zli,zp,zct,zce,nc);
        } else {
          nnz=op_split_eq(st,zli,zp,zct,zce,nc);
        }
        let g2:i32=0;
        if(nnz>0){
          let cur2:i32=tree_correct(st,bs,bo,n);
          set32(cost,0,get32(cost,0)+1);
          // Follow-up scan with zcap=0: best gain only, no Z recording.
          let zign:i32=scan_moves(st,bs,bo,n,cov,vals,cur2,nnz,cost,best2,zbuf,0);
          g2=get32(best2,0);
        }
        // Restore (direct field writes; not a construction op).
        set32(st,52+zli*16,zs0);
        set32(st,52+zli*16+4,zs1);
        set32(st,52+zli*16+8,zs2);
        set32(st,52+zli*16+12,zs3);
        // Strict > keeps the first maximizer in scan order.
        if(g2>ub){
          ub=g2;
          pl_li=zli; pl_op=zop; pl_p=zp; pl_ct=zct; pl_ce=zce;
        }
        zi=zi+1;
      }
      // Selection: plateau move iff it unlocks strictly more than the
      // best immediate gain; else greedy; else terminate.
      let take_pl:i32=0;
      if(zc>0){
        if(ub>g1){take_pl=1;}
      }
      emit("GREEDY it=");
      e64(moves);
      emit(" g1=");
      e64(g1);
      emit(" nz=");
      e64(zc);
      emit(" unlocked=");
      e64(ub);
      emit(" plateau=");
      e64(take_pl);
      emit("\n");
      let ali:i32=0;
      let aop:i32=0;
      let ap:i32=0;
      let ag:i32=0;
      let applied:i32=0;
      if(take_pl==1){
        ali=pl_li; aop=pl_op; ap=pl_p; ag=0;
        if(pl_op==1){
          nc=op_split_lt(st,pl_li,pl_p,pl_ct,pl_ce,nc);
        } else {
          nc=op_split_eq(st,pl_li,pl_p,pl_ct,pl_ce,nc);
        }
        applied=1;
      } else {
        if(g1>0){
          ali=get32(best,4); aop=get32(best,8); ap=get32(best,12); ag=g1;
          if(get32(best,8)==1){
            nc=op_split_lt(st,get32(best,4),get32(best,12),get32(best,16),get32(best,20),nc);
          } else {
            nc=op_split_eq(st,get32(best,4),get32(best,12),get32(best,16),get32(best,20),nc);
          }
          applied=1;
        }
      }
      if(applied==1){
        set32(st,188,nc);
        set32(st,180,get32(st,180)+1);
        moves=moves+1;
        cur_correct=tree_correct(st,bs,bo,n);
        set32(cost,0,get32(cost,0)+1);
        emit("BRIDGE MOVE li=");
        e64(ali);
        emit(" op=");
        e64(aop);
        emit(" p=");
        e64(ap);
        emit(" gain=");
        e64(ag);
        emit(" nc=");
        e64(nc);
        emit("\n");
      } else {
        done=1;
      }
    }
  }
  set32(cost,0,get32(cost,0)+1);
  return tree_exact_fit(st,bs,bo,n);
}
// ---- BRIDGE: generic behavioral novelty (design 4.5) ----
// Returns 1 iff no menu form (0/1/2) and no live invented form exactly
// fits the buffer. saved_pool holds the pre-construction pool bytes
// (128 bytes) for the live-form check; live_is3 indicates live==3.
fn novelty_generic(bs:[]u8, bo:[]u8, n:i32, tp:[]u8, saved_pool:[]u8, live_is3:i32) i32 {
  let f:i32=0;
  while(f<3){
    if(fit_form(f,bs,bo,n,tp)==1){return 0;}
    f=f+1;
  }
  if(live_is3==1){
    // Evaluate the saved (pre-construction) tree on the buffer.
    let i:i32=0;
    while(i<n){
      let ni:i32=0;
      let subj:i32=bget(bs,i);
      while(1==1){
        let op:i32=get32(saved_pool,ni*16);
        if(op==0){break;}
        if(op==1){
          if(subj<get32(saved_pool,ni*16+4)){ni=get32(saved_pool,ni*16+8);}
          else {ni=get32(saved_pool,ni*16+12);}
        } else {
          if(op==2){
            if(subj==get32(saved_pool,ni*16+4)){ni=get32(saved_pool,ni*16+8);}
            else {ni=get32(saved_pool,ni*16+12);}
          } else {
            // IF: evaluate cond via recursion on saved pool.
            let cn:i32=get32(saved_pool,ni*16+4);
            let cop:i32=get32(saved_pool,cn*16);
            let cv:i32=0;
            if(cop==1){
              if(subj<get32(saved_pool,cn*16+4)){cv=1;}
            } else {
              if(subj==get32(saved_pool,cn*16+4)){cv=1;}
            }
            if(cv==1){ni=get32(saved_pool,ni*16+8);}
            else {ni=get32(saved_pool,ni*16+12);}
          }
        }
      }
      if(get32(saved_pool,ni*16+4)!=bget(bo,i)){return 1;}
      i=i+1;
    }
    return 0;
  }
  return 1;
}

// ---- BRIDGE: structural equivalence (for refit) ----
// Returns 1 iff the two trees have the same node count, same operator at
// each node index, and same child pointers (constant/threshold values in
// the 'a' field are ignored).
fn tree_struct_eq(st1:[]u8, st2:[]u8) i32 {
  let nc1:i32=get32(st1,188);
  let nc2:i32=get32(st2,188);
  if(nc1!=nc2){return 0;}
  let i:i32=0;
  while(i<nc1){
    let b1:i32=52+i*16;
    let b2:i32=52+i*16;
    if(get32(st1,b1)!=get32(st2,b2)){return 0;}
    let op:i32=get32(st1,b1);
    if(op==3){
      if(get32(st1,b1+4)!=get32(st2,b2+4)){return 0;}
      if(get32(st1,b1+8)!=get32(st2,b2+8)){return 0;}
      if(get32(st1,b1+12)!=get32(st2,b2+12)){return 0;}
    }
    i=i+1;
  }
  return 1;
}
// Copy the node pool (128 bytes) from st to dst.
fn pool_copy(st:[]u8, dst:[]u8) void {
  let i:i32=0;
  while(i<128){
    dst[i]=st[52+i];
    i=i+1;
  }
  return;
}
fn pool_restore(st:[]u8, src:[]u8) void {
  let i:i32=0;
  while(i<128){
    st[52+i]=src[i];
    i=i+1;
  }
  return;
}
// Count EQ (op==2) nodes in the live tree.
fn count_eq_nodes(st:[]u8) i32 {
  let nc:i32=get32(st,188);
  let c:i32=0;
  let i:i32=0;
  while(i<nc){
    if(get32(st,52+i*16)==2){c=c+1;}
    i=i+1;
  }
  return c;
}
fn tree_exact_fit(st:[]u8, bs:[]u8, bo:[]u8, n:i32) i32 {
  let i:i32=0;
  while(i<n){
    if(teval(st,0,bget(bs,i))!=bget(bo,i)){return 0;}
    i=i+1;
  }
  return 1;
}

fn verify_need3(st:[]u8) i32 {
  let u:i32=get32(st,44);
  let pw:i32=1;
  let k:i32=0;
  while(k<u){pw=pw*2; k=k+1;}
  let v:i32=(14+pw-1)/pw;
  if(v<1){v=1;}
  return v;
}

// ---- prior order: descending uses, ties -> lower form index (verbatim) ----
fn prior_order(st:[]u8,ord:[]u8)void {
  let p0:i32=0;
  let p1:i32=0;
  let p2:i32=0;
  let k:i32=0;
  while(k<3){
    let best:i32=-1;
    let bestu:i32=-1;
    let f:i32=0;
    while(f<3){
      let pl:i32=0;
      if(f==0){pl=p0;}
      else { if(f==1){pl=p1;} else {pl=p2;} }
      if(pl==0){
        let u:i32=get32(st,16+f*4);
        if(u>bestu){bestu=u; best=f;}
      }
      f=f+1;
    }
    set32(ord,k*4,best);
    if(best==0){p0=1;}
    else { if(best==1){p1=1;} else {p2=1;} }
    k=k+1;
  }
  return;
}

// ---- verification need: V = max(1, ceil(V0 / 2^uses)) (verbatim) ----
fn verify_need(st:[]u8,form:i32)i32 {
  let u:i32=get32(st,16+form*4);
  let pw:i32=1;
  let k:i32=0;
  while(k<u){pw=pw*2; k=k+1;}
  let v:i32=(14+pw-1)/pw;
  if(v<1){v=1;}
  return v;
}

// ---- state block layout (extended for the inventor) ----
// 0 live_form | 4 p0 | 8 p1 | 12 p2 | 16 uses0 | 20 uses1 | 24 uses2 |
// 28 str0 | 32 str1 | 36 str2 | 40 frozen_uses |
// 44 uses3 | 48 strikes3 | 52..179 node pool (8 x 16) |
// 180 last_sig | 184 live_sig | 188 live_nodes
// ---- out block layout ----
// 0 cost | 4 adopted | 8 u0b | 12 u1b | 16 u2b | 20 V |
// 24 refit (1 ok, 0 fail, -1 na) | 28 s0a | 32 s1a | 36 s2a |
// 40 inv_event (-1 never, 0 SIG0, else sig) | 44 inv_promoted (0/1) |
// 48 uses3_after | 52 strikes3_after
fn run_family(st:[]u8,fam:i32,out:[]u8)void {
  let bs:[]u8=z_alloc(40*4);
  let bo:[]u8=z_alloc(40*4);
  let tp:[]u8=z_alloc(12);
  let ord:[]u8=z_alloc(12);
  let cost:i32=0;
  let adopted:i32=-2;
  let v_used:i32=0;
  let refit_out:i32=-1;
  let inv_used:i32=0;
  set32(out,8,get32(st,16));
  set32(out,12,get32(st,20));
  set32(out,16,get32(st,24));
  set32(out,40,-1);
  set32(out,44,0);
  let ei:i32=0;
  let n:i32=0;
  let vc:i32=0;
  let wrong:i32=0;
  let V:i32=0;
  let live:i32=get32(st,0);
  let phase:i32=0;
  if(live>=0){phase=1;}
  let done:i32=0;
  while(done==0){
    if(phase==0){
      // DISCOVER (D3: appends only while n < 40)
      let s:i32=true_subj(fam,ei);
      let o:i32=true_obj(fam,ei);
      if(n<40){
        bset(bs,n,s);
        bset(bo,n,o);
        n=n+1;
      }
      ei=ei+1; cost=cost+1;
      if(n>=6){
        prior_order(st,ord);
        let k:i32=0;
        let found:i32=-1;
        while(k<3){
          let f:i32=get32(ord,k*4);
          if(fit_form(f,bs,bo,n,tp)==1){found=f; k=3;}
          else {k=k+1;}
        }
        if(found>=0){
          live=found;
          set32(st,0,found);
          set32(st,4,get32(tp,0));
          set32(st,8,get32(tp,4));
          set32(st,12,get32(tp,8));
          V=verify_need(st,found);
          v_used=V; vc=0; wrong=0;
          phase=2;
        } else {
          if(n>=40){
            // INVENTOR hook: menu exhausted at BMAX (R1-R4)
            if(inv_used==1){
              adopted=-1; done=1;
            } else {
              inv_used=1;
              // BRIDGE: save pool for novelty check, then generic search.
              let saved:[]u8=z_alloc(128);
              pool_copy(st,saved);
              let live_is3:i32=0;
              if(live==3){live_is3=1;}
              let scost:[]u8=z_alloc(4);
              set32(scost,0,0);
              let built:i32=construct_search(st,bs,bo,n,scost);
              cost=cost+get32(scost,0);
              set32(out,40,built);
              emit("INV SEARCH fam=");
              e64(fam);
              emit(" n=");
              e64(n);
              emit(" built=");
              e64(built);
              emit(" nodes=");
              e64(get32(st,188));
              emit(" scost=");
              e64(get32(scost,0));
              emit("\n");
              if(built==0){
                pool_restore(st,saved);
                emit("INV HONESTFAIL fam=");
                e64(fam);
                emit(" n=");
                e64(n);
                emit("\n");
                adopted=-1; done=1;
              } else {
                let fitok:i32=tree_exact_fit(st,bs,bo,n);
                emit("INV FIT fam=");
                e64(fam);
                emit(" exact=");
                e64(fitok);
                emit("\n");
                let nov:i32=novelty_generic(bs,bo,n,tp,saved,live_is3);
                emit("INV NOVEL fam=");
                e64(fam);
                emit(" pass=");
                e64(nov);
                emit("\n");
                // F-DEGENERATE guard: EQ nodes <= 4.
                let eqn:i32=count_eq_nodes(st);
                emit("INV EQN fam=");
                e64(fam);
                emit(" eqnodes=");
                e64(eqn);
                emit("\n");
                if(fitok==1){
                  if(nov==1 && eqn<=4){
                    live=3;
                    set32(st,0,3);
                    set32(out,44,1);
                    V=verify_need3(st);
                    v_used=V; vc=0; wrong=0;
                    emit("INV PROMOTE fam=");
                    e64(fam);
                    emit(" form=3 V=");
                    e64(V);
                    emit("\n");
                    phase=2;
                  } else {
                    pool_restore(st,saved);
                    adopted=-1; done=1;
                  }
                } else {
                  pool_restore(st,saved);
                  adopted=-1; done=1;
                }
              }
            }
          }
        }
      }
    } else {
      if(phase==1){
        // REFIT: buffer exactly R=4
        while(n<4){
          let s2:i32=true_subj(fam,ei);
          let o2:i32=true_obj(fam,ei);
          bset(bs,n,s2);
          bset(bo,n,o2);
          n=n+1; ei=ei+1; cost=cost+1;
        }
        if(live==3){
          // BRIDGE R5: refit via fresh construct_search. Save the live
          // tree, build fresh on the 4-example buffer in scratch, adopt
          // iff exact fit AND structurally equivalent to live.
          let live_save:[]u8=z_alloc(192);
          let li2:i32=0;
          while(li2<192){
            live_save[li2]=st[li2];
            li2=li2+1;
          }
          let scratch:[]u8=z_alloc(192);
          let scost2:[]u8=z_alloc(4);
          set32(scost2,0,0);
          let rbuilt:i32=construct_search(scratch,bs,bo,4,scost2);
          cost=cost+get32(scost2,0);
          // Copy node count for struct-eq check.
          set32(scratch,188,get32(scratch,188));
          let rstruct:i32=0;
          if(rbuilt==1){
            rstruct=tree_struct_eq(live_save,scratch);
          }
          emit("INV REFIT fam=");
          e64(fam);
          emit(" rbuilt=");
          e64(rbuilt);
          emit(" rstruct=");
          e64(rstruct);
          emit("\n");
          if(rbuilt==1 && rstruct==1){
            refit_out=1;
            // Adopt the rebuilt tree: copy pool (scratch[52..180]) and
            // node count / move count.
            let ci3:i32=0;
            while(ci3<128){
              st[52+ci3]=scratch[52+ci3];
              ci3=ci3+1;
            }
            set32(st,188,get32(scratch,188));
            set32(st,180,get32(scratch,180));
            V=verify_need3(st);
            v_used=V; vc=0; wrong=0;
            emit("INV REFITOK fam=");
            e64(fam);
            emit(" V=");
            e64(V);
            emit("\n");
            phase=2;
          } else {
            refit_out=0;
            set32(st,48,get32(st,48)+1);
            emit("INV STRIKE fam=");
            e64(fam);
            emit(" strikes3=");
            e64(get32(st,48));
            emit("\n");
            live=-1;
            set32(st,0,-1);
            phase=0;
          }
        } else {
          if(fit_form(live,bs,bo,4,tp)==1){
            refit_out=1;
            set32(st,4,get32(tp,0));
            set32(st,8,get32(tp,4));
            set32(st,12,get32(tp,8));
            V=verify_need(st,live);
            v_used=V; vc=0; wrong=0;
            phase=2;
          } else {
            // strike; KEEP the refuting examples, enter DISCOVER
            refit_out=0;
            set32(st,28+live*4,get32(st,28+live*4)+1);
            live=-1;
            set32(st,0,-1);
            phase=0;
          }
        }
      } else {
        // VERIFY (R3/D1: every observed example enters the
        // episode-persistent discovery buffer while n < 40)
        let s3:i32=true_subj(fam,ei);
        let o3:i32=true_obj(fam,ei);
        if(n<40){
          bset(bs,n,s3);
          bset(bo,n,o3);
          n=n+1;
        }
        let pr:i32=predict(live,st,s3);
        ei=ei+1; cost=cost+1;
        if(pr==o3){vc=vc+1;}
        else {vc=0; wrong=wrong+1;}
        if(vc>=V){
          adopted=live;
          if(get32(st,40)==0){
            if(live==3){
              set32(st,44,get32(st,44)+1);
            } else {
              set32(st,16+live*4,get32(st,16+live*4)+1);
            }
          }
          done=1;
        } else {
          if(wrong>=3){
            // R3/D2: the discovery buffer is episode-persistent. Only the
            // verification counters reset; n and all observed evidence
            // are retained. R7: a strike on a live invented form ends the
            // episode as HONESTFAIL immediately.
            let struck:i32=live;
            if(struck==3){
              set32(st,48,get32(st,48)+1);
            } else {
              set32(st,28+struck*4,get32(st,28+struck*4)+1);
            }
            live=-1;
            set32(st,0,-1);
            vc=0; wrong=0;
            if(struck==3){
              adopted=-1; done=1;
            } else {
              phase=0;
            }
          }
        }
      }
    }
  }
  set32(out,0,cost);
  set32(out,4,adopted);
  set32(out,20,v_used);
  set32(out,24,refit_out);
  set32(out,28,get32(st,28));
  set32(out,32,get32(st,32));
  set32(out,36,get32(st,36));
  set32(out,48,get32(st,44));
  set32(out,52,get32(st,48));
  return;
}

fn emit_trace(cond:[]u8,fam:i32,out:[]u8)void {
  emit("TR ");
  emit(cond);
  emit(" fam=");
  e64(fam);
  emit(" cost=");
  e64(get32(out,0));
  emit(" adopted=");
  e64(get32(out,4));
  emit(" V=");
  e64(get32(out,20));
  emit(" refit=");
  e64(get32(out,24));
  emit(" inv_event=");
  e64(get32(out,40));
  emit(" inv_promoted=");
  e64(get32(out,44));
  emit(" uses3=");
  e64(get32(out,48));
  emit(" strikes3=");
  e64(get32(out,52));
  emit("\n");
  return;
}

fn chk(exp_a:i32, exp_c:i32, exp_i:i32, exp_p:i32, exp_r:i32, out:[]u8) i32 {
  if(get32(out,4)!=exp_a){return 0;}
  if(get32(out,0)!=exp_c){return 0;}
  if(get32(out,40)!=exp_i){return 0;}
  if(get32(out,44)!=exp_p){return 0;}
  if(get32(out,24)!=exp_r){return 0;}
  return 1;
}

fn main()i32 {
  emit("BRIDGE-START\n");
  emit("SPEC A F1 a=2 b=1 base=10\n");
  emit("SPEC B F1 a=3 b=5 base=1000\n");
  emit("SPEC C F1 a=1 b=0 base=2000\n");
  emit("SPEC D F1 a=5 b=3 base=3000\n");
  emit("SPEC E F1 a=2 b=9 base=4000\n");
  emit("SPEC G STEP base=6000 T=6003 lo=0 hi=5\n");
  emit("SPEC H 2EXC base=8000 d=7 e1=8001->3 e2=8004->9\n");
  emit("SPEC K 3CLUS base=10000 T1=10002 T2=10004 vals 0,1,2\n");
  emit("SPEC J SCAT base=9000 vals 1,2,3,4\n");
  emit("SPEC Gp STEP base=11000 T=11003 lo=2 hi=9\n");
  emit("SPEC T-ADV4 STEP+EXC base=12000 T=12005 exc 12002->9\n");
  emit("PARAMS BMIN=6 R=4 V0=14 WMAX=3 BMAX=40 BNODE=0 MOVEBUD=24 EQCAPP=4 COSTCEIL=108\n");
  let k2:i32=1;
  // ---- FRESH: G(6), H(8), K(10), J(9), T-ADV4(12) ----
  // Invention families: check adopted=3, promoted=1, built=1, cost<=108.
  // J: check adopted=-1, promoted=0, built=0 (HONESTFAIL).
  let flist:[]u8=z_alloc(20);
  set32(flist,0,6);
  set32(flist,4,8);
  set32(flist,8,10);
  set32(flist,12,9);
  set32(flist,16,12);
  let q:i32=0;
  while(q<5){
    let fam:i32=get32(flist,q*4);
    let st:[]u8=z_alloc(192);
    set32(st,0,-1);
    let out:[]u8=z_alloc(56);
    run_family(st,fam,out);
    emit_trace("FRESH",fam,out);
    if(fam==9){
      // J: HONESTFAIL expected.
      if(get32(out,4)!=-1){k2=0; }
      if(get32(out,44)!=0){k2=0; }
      if(get32(out,40)!=0){k2=0; }
    } else {
      // G/H/K/T-ADV4: invention expected.
      if(get32(out,4)!=3){k2=0; e64(fam); emit(" adopted\n");}
      if(get32(out,44)!=1){k2=0; e64(fam); emit(" promoted\n");}
      if(get32(out,40)!=1){k2=0; e64(fam); emit(" built\n");}
      if(get32(out,0)>108){k2=0; e64(fam); emit(" cost\n");}
      // F-MENU-REDUCIBLE is implied by the novelty gate (no menu form
      // fits the 40-point buffer, so none can be identical on the range).
    }
    q=q+1;
  }
  // ---- RETAINED: A,B,C,D,E,G,Gp,H,G2 ----
  // Menu families: exact adopted and cost (unchanged from INVENTOR-TESTED).
  // G: invented (adopted=3, promoted=1, cost<=108).
  // Gp: refit ok (refit=1).
  // H: refit strike (refit=0) then re-invent (adopted=3, promoted=1).
  // G2: menu form 2 (adopted=2, cost=20).
  let rlist:[]u8=z_alloc(36);
  set32(rlist,0,0);
  set32(rlist,4,1);
  set32(rlist,8,2);
  set32(rlist,12,3);
  set32(rlist,16,4);
  set32(rlist,20,6);
  set32(rlist,24,11);
  set32(rlist,28,8);
  set32(rlist,32,7);
  // expected adopted for each.
  let ra:[]u8=z_alloc(36);
  set32(ra,0,1); set32(ra,4,1); set32(ra,8,1); set32(ra,12,1); set32(ra,16,1);
  set32(ra,20,3); set32(ra,24,3); set32(ra,28,3); set32(ra,32,2);
  // expected refit for each (-1 = n/a, 0 = strike, 1 = ok).
  let rr:[]u8=z_alloc(36);
  set32(rr,0,-1); set32(rr,4,1); set32(rr,8,1); set32(rr,12,1); set32(rr,16,1);
  set32(rr,20,0); set32(rr,24,1); set32(rr,28,0); set32(rr,32,0);
  let rst:[]u8=z_alloc(192);
  set32(rst,0,-1);
  q=0;
  while(q<9){
    let fam2:i32=get32(rlist,q*4);
    let out2:[]u8=z_alloc(56);
    run_family(rst,fam2,out2);
    emit_trace("RETAINED",fam2,out2);
    if(get32(out2,4)!=get32(ra,q*4)){k2=0; e64(q); emit(" adopted\n");}
    if(get32(out2,24)!=get32(rr,q*4)){k2=0; e64(q); emit(" refit\n");}
    // Menu families: exact cost check.
    if(q<5){
      let ec:i32=20;
      if(q==1){ec=11;}
      if(q==2){ec=8;}
      if(q==3){ec=6;}
      if(q==4){ec=5;}
      if(get32(out2,0)!=ec){k2=0; e64(q); emit(" menucost\n");}
    }
    // G2: menu form 2 after H-strike; cost includes refit search overhead.
    if(q==8){
      if(get32(out2,0)>30){k2=0; }
    }
    // Invention families (G, H): cost <= 108, promoted=1.
    if(q==5 || q==7){
      if(get32(out2,0)>108){k2=0; e64(q); emit(" invcost\n");}
      if(get32(out2,44)!=1){k2=0; e64(q); emit(" invprom\n");}
    }
    // Gp: cost <= 108 (refit + verify).
    if(q==6){
      if(get32(out2,0)>108){k2=0; }
    }
    q=q+1;
  }
  emit("K2 ");
  e64(k2);
  emit("\n");
  if(k2==1){emit("VERDICT BRIDGE-TESTED\n");}
  else {emit("VERDICT BRIDGE-BLOCKED-K2\n");}
  emit("BRIDGE-END\n");
  return 0;
}

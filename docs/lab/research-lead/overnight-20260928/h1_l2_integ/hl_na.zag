// hl.zag -- H1 x L2 integration: learned type contracts DRIVE adaptation.
//
// m0 X: chain-follow r=81 (behav 0). Learned sig 1->1.
// m1 Y: double, out=2*v (behav 4). Learned sig 2->2.
// m2 E: count r=81 (behav 3). Learned sig 1->2. Distractor adapter.
// m3 C: count r=82 (behav 1). Learned sig 1->2. Adapter.
// m4 D: 1-based index into distinct-subject list (behav 5). Learned sig 2->1. Adapter.
// m5 D1: identity (behav 2). Learned sig 1->1.
// behav 6: generic triple composite (A then P then B).
//
// Solver: contract-admissible singles, then pairs (H1). Then adaptation:
// a needed pair (A,B) with seam mismatch sig_out(A) != sig_in(B) TRIGGERS
// adaptation; the mismatch TYPE selects the operator: (1,2)->OP12 inserts
// a learned 1->2 adapter, (2,1)->OP21 inserts a learned 2->1 adapter.
// Adapter candidacy is purely the learned contract comparison.
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.

// ---------- runtime prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
// Build-time toggle. The na build flips this single line to 0.
fn type_on()i32 { return 0; }

// ---------- workspace layout ----------
// header: 0 tries, 4 nmaps, 8 zid, 12 ans
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 8 entries x 44 bytes
//   (used,behav,in_sum,in_n,out_sum,out_n,sig_in,sig_out,comp_a,comp_b,comp_c)
fn hl_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,-1); put32(W,12,-2);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn hl_facts(W:[]u8)void {
  add_fact(W,31,81,32); add_fact(W,32,81,33); add_fact(W,33,81,34);
  add_fact(W,41,81,42); add_fact(W,42,81,43);
  add_fact(W,34,82,101); add_fact(W,34,82,102);
  add_fact(W,43,82,103); add_fact(W,43,82,104); add_fact(W,43,82,105);
  return;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn count_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){ n=n+1; }
    i=i+1;
  }
  return n;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
// behav 5: 1-based index into distinct fact subjects in first-appearance order.
fn d_index(W:[]u8,v:i32)i32 {
  if(v<1){ return -1; }
  let cnt:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1){
      let s:i32=ig(W,64+i*12+4);
      let seen:i32=0;
      let j:i32=0;
      while(j<i){
        if(ig(W,64+j*12)==1 && ig(W,64+j*12+4)==s){ seen=1; }
        j=j+1;
      }
      if(seen==0){
        cnt=cnt+1;
        if(cnt==v){ return s; }
      }
    }
    i=i+1;
  }
  return -1;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,4);
  put32(W,4,m+1);
  let b:i32=544+m*44;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,0); put32(W,b+12,0); put32(W,b+16,0); put32(W,b+20,0);
  put32(W,b+24,0); put32(W,b+28,0);
  put32(W,b+32,-1); put32(W,b+36,-1); put32(W,b+40,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*44,0); return; }
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=544+m*44;
  let bh:i32=ig(W,b+4);
  if(bh==0){
    let cur:i32=v; let n:i32=0;
    while(n<16){
      let o:i32=find_obj(W,cur,81);
      if(o==-1){ break; }
      cur=o; n=n+1;
    }
    return cur;
  }
  if(bh==1){ return count_rel(W,v,82); }
  if(bh==2){ return v; }
  if(bh==3){ return count_rel(W,v,81); }
  if(bh==4){ return 2*v; }
  if(bh==5){ return d_index(W,v); }
  let a:i32=ig(W,b+32); let p:i32=ig(W,b+36); let c:i32=ig(W,b+40);
  let m1:i32=exec_map(W,a,v);
  let m2:i32=exec_map(W,p,m1);
  return exec_map(W,c,m2);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=544+m*44;
  put32(W,b+8,ig(W,b+8)+probe_kind(W,vin));
  put32(W,b+12,ig(W,b+12)+1);
  put32(W,b+16,ig(W,b+16)+probe_kind(W,vout));
  put32(W,b+20,ig(W,b+20)+1);
  return;
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=544+m*44;
  let inn:i32=ig(W,b+12); let outn:i32=ig(W,b+20);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+8)*2>=inn*3){ si=2; }
    put32(W,b+24,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+16)*2>=outn*3){ so=2; }
    put32(W,b+28,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*44+24); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*44+28); }
fn teach_one(W:[]u8,OUT:[]u8,cur:i32,behav:i32,v1:i32,v2:i32) i32 {
  let m:i32=map_new(W,behav);
  let r:i32=exec_map(W,m,v1); record_obs(W,m,v1,r);
  r=exec_map(W,m,v2); record_obs(W,m,v2,r);
  finalize_sig(W,m);
  cur=e1str(OUT,cur,"TEACH m="); cur=e1i64(OUT,cur,m as i64);
  cur=e1str(OUT,cur," behav="); cur=e1i64(OUT,cur,behav as i64);
  cur=e1str(OUT,cur," sig="); cur=e1i64(OUT,cur,sig_in(W,m) as i64);
  cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,sig_out(W,m) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn teach_all(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=teach_one(W,OUT,cur,0,31,41); // m0 X: 31->34, 41->43 ; sig 1->1
  cur=teach_one(W,OUT,cur,4,2,3);   // m1 Y: 2->4, 3->6 ; sig 2->2
  cur=teach_one(W,OUT,cur,3,31,34); // m2 E: 31->1, 34->0 ; sig 1->2
  cur=teach_one(W,OUT,cur,1,34,43); // m3 C: 34->2, 43->3 ; sig 1->2
  cur=teach_one(W,OUT,cur,5,2,5);   // m4 D: 2->32, 5->34 ; sig 2->1
  cur=teach_one(W,OUT,cur,2,31,41); // m5 D1: 31->31, 41->41 ; sig 1->1
  return cur;
}
fn promote_comp3(W:[]u8,a:i32,p:i32,b:i32)i32 {
  let z:i32=map_new(W,6);
  let zb:i32=544+z*44;
  put32(W,zb+32,a); put32(W,zb+36,p); put32(W,zb+40,b);
  // composite contract = generic contract composition: in(A) -> out(B).
  put32(W,zb+24,sig_in(W,a));
  put32(W,zb+28,sig_out(W,b));
  put32(W,8,z);
  return z;
}
fn solve_z(W:[]u8,OUT:[]u8,cur:i32,s:i32,target:i32)i32 {
  let ton:i32=type_on();
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,4);
  let tries:i32=0;
  let m:i32=0;
  while(m<nm){
    if(ig(W,544+m*44)==1){
      let ok:i32=1;
      if(ton==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        cur=e1str(OUT,cur,"TRY1 m="); cur=e1i64(OUT,cur,m as i64);
        cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
        cur=e1str(OUT,cur,"\n");
        if(r==target){
          cur=e1str(OUT,cur,"Z-SINGLE m="); cur=e1i64(OUT,cur,m as i64);
          cur=e1str(OUT,cur,"\n");
          put32(W,12,target); put32(W,0,tries);
          return cur;
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,544+a*44)==1 && ig(W,544+b*44)==1){
        let ok:i32=1;
        if(ton==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          cur=e1str(OUT,cur,"TRY2 a="); cur=e1i64(OUT,cur,a as i64);
          cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b as i64);
          cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
          cur=e1str(OUT,cur,"\n");
          if(r==target){
            cur=e1str(OUT,cur,"Z-PAIR a="); cur=e1i64(OUT,cur,a as i64);
            cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b as i64);
            cur=e1str(OUT,cur,"\n");
            put32(W,12,target); put32(W,0,tries);
            return cur;
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ton==1){
    // Adaptation phase. The TRIGGER is the contract mismatch at a needed
    // seam; the mismatch TYPE selects the operator. Adapter candidacy is
    // purely the learned contract comparison. No researcher flag.
    let a2:i32=0;
    while(a2<nm){
      let b2:i32=0;
      while(b2<nm){
        if(ig(W,544+a2*44)==1 && ig(W,544+b2*44)==1){
          if(ig(W,544+a2*44+4)!=6 && ig(W,544+b2*44+4)!=6){
            if(sig_in(W,a2)==kin && sig_out(W,b2)==kout){
              let have:i32=sig_out(W,a2);
              let need:i32=sig_in(W,b2);
              if(have!=need){
                cur=e1str(OUT,cur,"MISMATCH a="); cur=e1i64(OUT,cur,a2 as i64);
                cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                cur=e1str(OUT,cur," have="); cur=e1i64(OUT,cur,have as i64);
                cur=e1str(OUT,cur," need="); cur=e1i64(OUT,cur,need as i64);
                cur=e1str(OUT,cur,"\n");
                let op:i32=0;
                if(have==1 && need==2){ op=12; }
                if(have==2 && need==1){ op=21; }
                if(op!=0){
                  let p:i32=0;
                  let foundp:i32=0;
                  while(p<nm){
                    if(ig(W,544+p*44)==1 && p!=a2 && p!=b2 && ig(W,544+p*44+4)!=6){
                      if(sig_in(W,p)==have && sig_out(W,p)==need){
                        foundp=1;
                        cur=e1str(OUT,cur,"BRIDGE-SEL OP"); cur=e1i64(OUT,cur,op as i64);
                        cur=e1str(OUT,cur," a="); cur=e1i64(OUT,cur,a2 as i64);
                        cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                        cur=e1str(OUT,cur," p="); cur=e1i64(OUT,cur,p as i64);
                        cur=e1str(OUT,cur," psig="); cur=e1i64(OUT,cur,have as i64);
                        cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,need as i64);
                        cur=e1str(OUT,cur,"\n");
                        tries=tries+1;
                        let m1:i32=exec_map(W,a2,s);
                        let m2:i32=exec_map(W,p,m1);
                        let r:i32=exec_map(W,b2,m2);
                        cur=e1str(OUT,cur,"TRY3 a="); cur=e1i64(OUT,cur,a2 as i64);
                        cur=e1str(OUT,cur," p="); cur=e1i64(OUT,cur,p as i64);
                        cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                        cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
                        cur=e1str(OUT,cur,"\n");
                        if(r==target){
                          let z:i32=promote_comp3(W,a2,p,b2);
                          cur=e1str(OUT,cur,"Z-COMP3 z="); cur=e1i64(OUT,cur,z as i64);
                          cur=e1str(OUT,cur," a="); cur=e1i64(OUT,cur,a2 as i64);
                          cur=e1str(OUT,cur," p="); cur=e1i64(OUT,cur,p as i64);
                          cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                          cur=e1str(OUT,cur,"\n");
                          cur=e1str(OUT,cur,"Z-SIG "); cur=e1i64(OUT,cur,sig_in(W,z) as i64);
                          cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,sig_out(W,z) as i64);
                          cur=e1str(OUT,cur,"\n");
                          put32(W,12,target); put32(W,0,tries);
                          return cur;
                        }
                      }
                    }
                    p=p+1;
                  }
                  if(foundp==0){
                    cur=e1str(OUT,cur,"NO-BRIDGE a="); cur=e1i64(OUT,cur,a2 as i64);
                    cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                    cur=e1str(OUT,cur,"\n");
                  }
                }
              }
            }
          }
        }
        b2=b2+1;
      }
      a2=a2+1;
    }
  } else {
    // No contracts: the mismatch detector cannot fire. Wrong-operator
    // demonstration: bridge the first pair (m0,m1) with the lowest-id
    // third map, with no signature check at all.
    if(nm>=3){
      let p0:i32=-1;
      let q:i32=0;
      while(q<nm){
        if(ig(W,544+q*44)==1 && q!=0 && q!=1){ p0=q; break; }
        q=q+1;
      }
      if(p0>=0){
        tries=tries+1;
        let m1:i32=exec_map(W,0,s);
        let m2:i32=exec_map(W,p0,m1);
        let r:i32=exec_map(W,1,m2);
        cur=e1str(OUT,cur,"BLIND-BRIDGE a=0 b=1 p="); cur=e1i64(OUT,cur,p0 as i64);
        cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
        cur=e1str(OUT,cur,"\n");
      }
    }
  }
  cur=e1str(OUT,cur,"Z-FAIL\n");
  put32(W,12,-2); put32(W,0,tries);
  return cur;
}
fn arm_result(OUT:[]u8,cur:i32,W:[]u8,exp_ans:i32,exp_a:i32,exp_b:i32,exp_c:i32)i32 {
  let ans:i32=ig(W,12); let tries:i32=ig(W,0);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(ans==exp_ans){
    if(exp_a==-1){ ok=1; }
    else {
      if(z>=0){
        let za:i32=ig(W,544+z*44+32);
        let zb:i32=ig(W,544+z*44+36);
        let zc:i32=ig(W,544+z*44+40);
        if(za==exp_a && zb==exp_b && zc==exp_c){ ok=1; }
      }
    }
  }
  cur=e1str(OUT,cur,"ARM-RESULT ");
  if(ok==1){ cur=e1str(OUT,cur,"PASS"); } else { cur=e1str(OUT,cur,"FAIL"); }
  cur=e1str(OUT,cur," ans="); cur=e1i64(OUT,cur,ans as i64);
  cur=e1str(OUT,cur," tries="); cur=e1i64(OUT,cur,tries as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn arm_treat_z1(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== TREAT-Z1 ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,4,0,3,1);
  return cur;
}
fn arm_treat_z2(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== TREAT-Z2 ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_z(W,OUT,cur,43,34);
  cur=arm_result(OUT,cur,W,34,3,4,0);
  return cur;
}
fn arm_abl_c(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== ABL-C ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  del_map(W,3);
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1);
  return cur;
}
fn arm_abl_d(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== ABL-D ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  del_map(W,4);
  cur=solve_z(W,OUT,cur,43,34);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1);
  return cur;
}
fn arm_fresh(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== FRESH ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1);
  return cur;
}
fn arm_reuse(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== REUSE-Z1 ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,4,0,3,1);
  cur=e1str(OUT,cur,"--- second solve, same workspace ---\n");
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,4,-1,-1,-1);
  return cur;
}
fn arm_notype_z1(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== NOTYPE-Z1 ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_z(W,OUT,cur,31,4);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1);
  return cur;
}
fn arm_notype_z2(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== NOTYPE-Z2 ===\n");
  let W:[]u8=z_alloc(4096); hl_init(W);
  hl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_z(W,OUT,cur,43,34);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1);
  return cur;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  cur=e1str(OUT,cur,"HL-START\n");
  if(type_on()==1){
    cur=arm_treat_z1(OUT,cur);
    cur=arm_treat_z2(OUT,cur);
    cur=arm_abl_c(OUT,cur);
    cur=arm_abl_d(OUT,cur);
    cur=arm_fresh(OUT,cur);
    cur=arm_reuse(OUT,cur);
  } else {
    cur=arm_notype_z1(OUT,cur);
    cur=arm_notype_z2(OUT,cur);
  }
  cur=e1str(OUT,cur,"HL-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc<0){ return 1; }
  return 0;
}

fn wkl_read_vc(W:[]u8)i32 {
  return hg(W,16)/1024;
}
fn wkl_live(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn wkl_emit_policy(W:[]u8)void {
  let pol:i32=h3n1_find_policy(W);
  emit("policy: ");
  if(pol<0){ emit("none\n"); return; }
  let s:i32=0;
  while(s<6){ e64(ng(W,pol,8+s*4)); if(s<5){emit(",");} s=s+1; }
  emit(" rej="); e64(ng(W,pol,32)); emit("\n");
  return;
}
fn wkl_probes(W:[]u8, PS:[]u8, p0:i32, p1:i32, tag:[]u8)i32 {
  let E:i32=0;
  let i:i32=p0;
  while(i<p1){
    let s:i32=get32(PS,i*4);
    hs(W,16,0);
    let ans:i32=ev_query(W,s,50,4,0);
    let vc:i32=wkl_read_vc(W);
    E=E+vc;
    emit(tag); emit(" i="); e64(i-p0); emit(" vc="); e64(vc); emit(" ans="); e64(ans); emit("\n");
    i=i+1;
  }
  return E;
}
fn wkl_setup(W:[]u8)void {
  tnn2_init(W);
  let t8:i32=alloc_node(W);
  ns(W,t8,0,8);
  wld_apply_teach(W);
  return;
}
fn wkl_ps_fill(PS:[]u8)void {
  set32(PS,0,1001);
  set32(PS,4,1002);
  set32(PS,8,1003);
  set32(PS,12,1004);
  set32(PS,16,1005);

  return;
}
fn main()i32 {
  let PS:[]u8=z_alloc(160); wkl_ps_fill(PS);
  let W3:[]u8=z_alloc(110656); wkl_setup(W3);
  let EA3:i32=wkl_probes(W3,PS,0,20,"C2A");
  emit("E(C2A)="); e64(EA3); emit(" "); wkl_emit_policy(W3); emit("\n");
  let pol3:i32=h3n1_find_policy(W3);
  ns(W3,pol3,8,0); ns(W3,pol3,12,1); ns(W3,pol3,16,2);
  ns(W3,pol3,20,3); ns(W3,pol3,24,4); ns(W3,pol3,28,5);
  ns(W3,pol3,32,0);
  emit("C2-policy-reset "); wkl_emit_policy(W3);
  let EB3:i32=wkl_probes(W3,PS,20,40,"C2B");
  emit("E(B_abl)="); e64(EB3); emit(" "); wkl_emit_policy(W3); emit("\n");
  emit("WKL-C2-DONE\n");
  return 0;
}

// p5.zag -- P5-META-LEARNING (charter 23): does acquired structure make later
// learning faster, and is that meta-structure CAUSAL?
// Lane p5meta. Prereg: docs/lab/research-lead/overnight-20260928/p5meta/PREREG.md
// Pure Zag: all computation and statistics below. Shell only builds/runs.
//
// Learner state L = frozen COGOPS learner-state arena (flat bytes):
//   BIND  12744  8x32B  [0..3] arity ladder perm, [4] verif size, [5] max trained arity
//   PLAN  13000  4x56B  [arity, op, s0,s1,s2,s3, ..., uses] verified procedures
//   STATS 13224  counters
//   DETC  15900  detection/adaptation counters
//   STRATT 16600+(s-1)*12 [uses,wins,cost]  s=1..4 arity tiers
//   CTXT  17000+slot*56  [rel, ...] per-slot relevance
// FROZEN architecture: 12 slots, arities 1..4, 4 ops, budget 24 hyps/round,
// 64 rounds, 4 examples/round, verification batch V, 16-example audit.

fn RMAX()i32 { return 64; }
fn SB()i32 { return 24; }
fn AUDN()i32 { return 16; }
fn MAXE()i32 { return 256; }
fn VAUD()i32 { return 32; }

fn RBIND()i32 { return 12744; }
fn RPLAN()i32 { return 13000; }
fn RSTAT()i32 { return 13224; }
fn RDETC()i32 { return 15900; }
fn RSTRA()i32 { return 16600; }
fn RCTXT()i32 { return 17000; }
fn LSZ()i32 { return 18432; }

fn bindi(i:i32)i32 { return RBIND()+i*4; }
fn planb(p:i32)i32 { return RPLAN()+p*56; }
fn ctxb(s:i32)i32 { return RCTXT()+s*56; }
fn strb(s:i32)i32 { return RSTRA()+(s-1)*12; }

fn S_TOK()i32 { return 0; }
fn S_TVF()i32 { return 1; }
fn D_RA()i32 { return 0; }
fn D_RU()i32 { return 1; }
fn D_RR()i32 { return 2; }
fn D_NP()i32 { return 3; }
fn D_VF()i32 { return 4; }
fn D_AU()i32 { return 5; }

// ---------------- primitives ----------------
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn bcopy(dst:[]u8,src:[]u8,n:i32)void {
  let i:i32=0; while(i<n){ dst[i]=src[i]; i=i+1; } return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  return o_num(b,c,v as i32);
}
fn o_num(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let d:i32=0;
  let t:i32=x;
  while(t>0){ d=d+1; t=t/10; }
  if(d<1){ d=1; }
  let e:i32=c+neg+d;
  let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn prng(P:[]u8)i32 {
  let x:i32=get32(P,16);
  let y:i32=(x*25173+13849)%65536;
  set32(P,16,y);
  return y;
}
fn prs(P:[]u8,s:i32)void { set32(P,16,s); return; }
fn hsh(a:i32,b:i32)i32 {
  let v:i32=(a*7919+b*104729)%65536;
  if(v<0){ v=v+65536; }
  return v;
}
fn bin_init(B:[]u8)void {
  let n:i32=0;
  while(n<13){ 
    set32(B,n*24,1);
    let r:i32=1;
    while(r<6){ 
      if(r>n){ set32(B,n*24+r*4,0); }
      else { set32(B,n*24+r*4,get32(B,(n-1)*24+(r-1)*4)+get32(B,(n-1)*24+r*4)); }
      r=r+1;
    }
    n=n+1;
  }
  return;
}
fn ncr(B:[]u8,n:i32,r:i32)i32 {
  if(r<0){ return 0; }
  if(r>n){ return 0; }
  return get32(B,n*24+r*4);
}

// ---------------- output fields ----------------
fn fv(b:[]u8,c:i32,k:[]u8,v:i32)i32 { let d:i32=o_app(b,c,k); let e:i32=o_num(b,d,v); b[e]=32; return e+1; }
fn fvs(b:[]u8,c:i32,k:[]u8)i32 { return o_app(b,c,k); }
fn pad(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn ff(b:[]u8,c:i32,k:[]u8,v:i32)i32 {
  let d:i32=o_app(b,c,k);
  let e:i32=0;
  if(v==1){ e=o_app(b,d,"PASS"); } else { e=o_app(b,d,"FAIL"); }
  return e+1;
}

// ---------------- families ----------------
// FB words: 0 dom, 1 k, 2 op, 3 noise, 4..6 active slots, 7 fid
fn fb(f:[]u8,i:i32)i32 { return get32(f,i*4); }
fn fbs(f:[]u8,i:i32,v:i32)void { set32(f,i*4,v); return; }
fn fseed(fid:i32)i32 { return hsh(1000,fid*31+7); }

fn pool(i:i32)i32 {
  if(i==0){ return 1; } if(i==1){ return 3; } if(i==2){ return 4; }
  if(i==3){ return 6; } if(i==4){ return 8; } if(i==5){ return 9; }
  return 11;
}
fn colds(i:i32)i32 {
  if(i==0){ return 0; } if(i==1){ return 2; } if(i==2){ return 5; }
  if(i==3){ return 7; }
  return 10;
}
// 3 distinct slot ids from source (0 = all 12, 1 = the 5 cold slots) into FB words wo..wo+2
fn pick3(P:[]u8,FB:[]u8,src:i32,nsrc:i32,wo:i32)i32 {
  let g:i32=0; let guard:i32=0;
  while((g<3)&&(guard<9000)){ 
    let r:i32=prng(P)%nsrc;
    let v:i32=r;
    if(src==1){ v=colds(r); }
    let dup:i32=0; let i:i32=0;
    while(i<g){ if(fb(FB,wo+i)==v){ dup=1; } i=i+1; }
    if(dup==0){ fbs(FB,wo+g,v); g=g+1; }
    guard=guard+1;
  }
  return g;
}
fn fam_build(FB:[]u8,fid:i32,P:[]u8)i32 {
  prs(P,fseed(fid));
  fbs(FB,0,0); fbs(FB,1,3); fbs(FB,2,0); fbs(FB,3,0);
  fbs(FB,4,0); fbs(FB,5,0); fbs(FB,6,0); fbs(FB,7,fid);
  if(fid<8){ 
    let k:i32=3;
    if(fid==2){ k=2; }
    if(fid==6){ k=2; }
    fbs(FB,1,k);
    fbs(FB,2,fid%4);
    let i:i32=0;
    while(i<k){ fbs(FB,4+i,pool((3*fid+i)%7)); i=i+1; }
    return 1;
  }
  if(fid<16){ 
    fbs(FB,3,1);
    let e:i32=fid-8; let i:i32=0;
    while(i<3){ fbs(FB,4+i,pool((3*e+i)%7)); i=i+1; }
    return 1;
  }
  if(fid<22){ 
    fbs(FB,2,(fid-16)%4);
    return pick3(P,FB,0,12,4);
  }
  if(fid<28){ 
    fbs(FB,2,(fid-22)%4);
    return pick3(P,FB,1,5,4);
  }
  if(fid<34){ 
    fbs(FB,2,(fid-28)%4);
    let r:i32=pick3(P,FB,0,7,4);
    let r2:i32=pick3(P,FB,1,5,6);
    return r+r2;
  }
  if(fid<40){ 
    fbs(FB,3,1);
    return pick3(P,FB,0,12,4);
  }
  fbs(FB,0,2);
  fbs(FB,2,(fid-40)%4);
  return pick3(P,FB,1,5,4);
}

// ---------------- example generation ----------------
fn projb(dom:i32,v:i32)i32 {
  if(dom==0){ return v; }
  if(v==2){ return 1; }
  return 0;
}
fn opv(op:i32,s:i32)i32 {
  if(op==0){ return s%2; }
  if(op==1){ if(s>=2){ return 1; } return 0; }
  if(op==2){ if(s==1){ return 1; } return 0; }
  if(s==0){ return 1; }
  return 0;
}
// out[0..11] features, out[12] label
fn gen_ex(P:[]u8,FB:[]u8,out:[]u8)void {
  let dom:i32=fb(FB,0); let k:i32=fb(FB,1); let op:i32=fb(FB,2);
  let noise:i32=fb(FB,3);
  let mx:i32=2;
  if(dom==0){ mx=1; }
  let j:i32=0;
  while(j<12){ out[j]=(prng(P)%(mx+1)) as u8; j=j+1; }
  let y:i32=0;
  if(noise==1){ y=prng(P)%2; }
  else {
    let s:i32=0; let i:i32=0;
    while(i<k){ s=s+projb(dom,fb(FB,4+i)); i=i+1; }
    y=opv(op,s);
    if(dom==2){ y=1-y; }
  }
  out[12]=(y as u8);
  return;
}
fn gen_all(P:[]u8,FB:[]u8,EXB:[]u8)void {
  prs(P,fseed(fb(FB,7)));
  let e:i32=0;
  while(e<MAXE()){ 
    gen_ex(P,FB,EXB[e*13..e*13+13]);
    e=e+1;
  }
  return;
}

// ---------------- hypothesis machinery ----------------
// POS[0..3] = positions in ORD, POS[4] = arity, POS[5] = op
fn tier_n(a:i32)i32 {
  if(a==1){ return 12; }
  if(a==2){ return 66; }
  if(a==3){ return 220; }
  return 495;
}
fn unrank(B:[]u8,POS:[]u8,po:i32,k:i32,t:i32)void {
  let start:i32=0; let j:i32=0;
  while(j<k){
    let rem:i32=k-j-1;
    let c:i32=ncr(B,11-start,rem);
    let p:i32=start;
    while(t>=c){ t=t-c; p=p+1; c=ncr(B,11-p,rem); }
    set32(POS,(po+j)*4,p);
    start=p+1;
    j=j+1;
  }
  return;
}
fn tier_hyp(B:[]u8,POS:[]u8,a:i32,p:i32)void {
  let op:i32=p%4;
  let t:i32=p/4;
  unrank(B,POS,0,a,t);
  set32(POS,16,a);
  set32(POS,20,op);
  return;
}
fn hyp_pred(FB:[]u8,ORD:[]u8,POS:[]u8,e:i32,EXB:[]u8)i32 {
  let dom:i32=fb(FB,0);
  let a:i32=get32(POS,16);
  let s:i32=0; let p:i32=0;
  while(p<a){ 
    let sl:i32=get32(ORD,get32(POS,p*4)*4);
    s=s+projb(dom,EXB[e*13+sl] as i32);
    p=p+1;
  }
  let y:i32=opv(get32(POS,20),s);
  if(dom==2){ return 1-y; }
  return y;
}
fn hyp_fit(FB:[]u8,ORD:[]u8,POS:[]u8,ne:i32,EXB:[]u8)i32 {
  let e:i32=0;
  while(e<ne){ 
    if(hyp_pred(FB,ORD,POS,e,EXB)!=(EXB[e*13+12] as i32)){ return 0; }
    e=e+1;
  }
  return 1;
}
// propose the stored hypothesis against n fresh held-out examples (stream keyed by key)
fn hold_pred(P:[]u8,FB:[]u8,ORD:[]u8,POS:[]u8,fid:i32,key:i32,n:i32,EXH:[]u8)i32 {
  let i:i32=0;
  while(i<n){ 
    prs(P,hsh(fid,key*37+i+1));
    gen_ex(P,FB,EXH);
    if(hyp_pred(FB,ORD,POS,0,EXH)!=(EXH[12] as i32)){ return 0; }
    i=i+1;
  }
  return 1;
}

// ---------------- learner state ----------------
fn state_init(L:[]u8)void {
  let i:i32=0;
  while(i<4){ set32(L,bindi(i),i+1); i=i+1; }
  set32(L,bindi(4),1);
  set32(L,bindi(5),0);
  return;
}
// derive the arity ladder permutation from STRATT wins (desc, ties by arity asc)
fn derive_ar(L:[]u8)void {
  let q:i32=0;
  while(q<4){ 
    let best:i32=-1; let bw:i32=-1; let a:i32=1;
    while(a<5){ 
      let w:i32=get32(L,strb(a)+4);
      if(w>bw){ bw=w; best=a; }
      a=a+1;
    }
    set32(L,bindi(q),best);
    set32(L,strb(best)+8,1);
    a=1;
    while(a<5){ set32(L,strb(a)+8,0); a=a+1; }
    if(bw>=0){ set32(L,strb(best)+8,1); }
    q=q+1;
  }
  return;
}
fn derive_V(L:[]u8)i32 {
  let tok:i32=get32(L,RSTAT()+S_TOK()*4);
  let tvf:i32=get32(L,RSTAT()+S_TVF()*4);
  let v:i32=1;
  if(tok>0){ 
    v=2+tvf/tok;
    if(v>16){ v=16; }
    if(v<2){ v=2; }
  }
  set32(L,bindi(4),v);
  return v;
}
fn build_ord(L:[]u8,ORD:[]u8)void {
  let used:i32=0;
  let j:i32=0;
  while(j<12){ 
    let bi:i32=-1; let bv:i32=-1; let k:i32=0;
    while(k<12){ 
      let u:i32=(used>>k)%2;
      if(u==0){ 
        let v:i32=get32(L,ctxb(k));
        if(v>bv){ bv=v; bi=k; }
      }
      k=k+1;
    }
    set32(ORD,j*4,bi);
    used=used+(1<<bi);
    j=j+1;
  }
  return;
}

// ---------------- episode ----------------
// res: 0 EX, 1 SA, 2 VA, 3 reached, 4 RU, 5 RR, 6 RA, 7 NS, 8 FC, 9 acc, 10 rounds, 11 arity
fn absorb(L:[]u8,ORD:[]u8,POS:[]u8,res:[]u8)void {
  let a:i32=get32(POS,16);
  let i:i32=0;
  while(i<a){ 
    let sl:i32=get32(ORD,get32(POS,i*4)*4);
    set32(L,ctxb(sl),get32(L,ctxb(sl))+1);
    i=i+1;
  }
  set32(L,strb(a),get32(L,strb(a))+1);
  set32(L,strb(a)+4,get32(L,strb(a)+4)+1);
  set32(res,11,a);
  return;
}
fn plan_store(L:[]u8,ORD:[]u8,POS:[]u8)void {
  let slot:i32=0; let worst:i32=999999; let p:i32=0;
  while(p<4){ 
    let u:i32=get32(L,planb(p)+52);
    if(u==0){ worst=-1; slot=p; p=4; }
    else { if(u<worst){ worst=u; slot=p; } }
    p=p+1;
  }
  set32(L,planb(slot),get32(POS,16));
  set32(L,planb(slot)+4,get32(POS,20));
  let i:i32=0;
  while(i<4){ set32(L,planb(slot)+8+i*4,0); i=i+1; }
  i=0;
  while(i<get32(POS,16)){ set32(L,planb(slot)+8+i*4,get32(ORD,get32(POS,i*4)*4)); i=i+1; }
  set32(L,planb(slot)+52,1);
  return;
}
// load stored plan p into POS (using ORD reverse map); 1 if all slots found
fn plan_load(L:[]u8,ORD:[]u8,POS:[]u8,p:i32)i32 {
  let a:i32=get32(L,planb(p));
  set32(POS,16,a);
  set32(POS,20,get32(L,planb(p)+4));
  let i:i32=0;
  while(i<a){ 
    let want:i32=get32(L,planb(p)+8+i*4);
    let f:i32=0; let o:i32=0;
    while(o<12){ if(get32(ORD,o*4)==want){ set32(POS,i*4,o); f=1; } o=o+1; }
    if(f==0){ return 0; }
    i=i+1;
  }
  return 1;
}
fn run_ep(L:[]u8,FB:[]u8,a_l1:i32,a_ar:i32,a_ver:i32,B:[]u8,P:[]u8,EXB:[]u8,SCR:[]u8,res:[]u8)i32 {
  let ORD:[]u8=SCR[0..64];
  let ARb:[]u8=SCR[64..96];
  let POS:[]u8=SCR[96..128];
  let EXH:[]u8=SCR[128..144];
  let CUR:[]u8=SCR[144..176];
  let TON:[]u8=SCR[176..208];
  let fid:i32=fb(FB,7);
  let i:i32=0;
  while(i<12){ set32(res,i*4,0); i=i+1; }
  if(a_l1==0){ let j:i32=0; while(j<12){ set32(L,ctxb(j),0); j=j+1; } }
  let V:i32=1;
  if(a_ver==1){ V=get32(L,bindi(4)); }
  set32(ARb,0,1); set32(ARb,4,2); set32(ARb,8,3); set32(ARb,12,4);
  if(a_ar==1){ let q:i32=0; while(q<4){ set32(ARb,q*4,get32(L,bindi(q))); q=q+1; } }
  build_ord(L,ORD);
  let a:i32=1;
  while(a<5){ set32(CUR,a*4,0); set32(TON,a*4,0); a=a+1; }
  let reached:i32=0;
  let rnd:i32=1;
  while((rnd<=RMAX())&&(reached==0)){ 
    let ne:i32=4*rnd;
    // ---- reuse phase, round 1 only ----
    if(rnd==1){ 
      let p:i32=0;
      while(p<4){ 
        if(get32(L,planb(p)+52)>0){ 
          set32(res,6,get32(res,6)+1);
          set32(L,RSTAT()+D_RA()*4,get32(L,RSTAT()+D_RA()*4)+1);
          let ok:i32=plan_load(L,ORD,POS,p);
          let fits:i32=0;
          if(ok==1){ fits=hyp_fit(FB,ORD,POS,ne,EXB); }
          if(fits==1){ 
            set32(res,1,get32(res,1)+V+AUDN());
            let vy:i32=hold_pred(P,FB,ORD,POS,fid,rnd,V,EXH);
            if(vy==1){ 
              let au:i32=hold_pred(P,FB,ORD,POS,fid,rnd+1000,AUDN(),EXH);
              if(au==1){ 
                reached=1;
                set32(res,4,get32(res,4)+1);
                set32(L,RSTAT()+D_RU()*4,get32(L,RSTAT()+D_RU()*4)+1);
                absorb(L,ORD,POS,res);
              }
              else {
                set32(res,5,get32(res,5)+1);
                set32(L,RSTAT()+D_RR()*4,get32(L,RSTAT()+D_RR()*4)+1);
              }
            }
            else {
              set32(res,5,get32(res,5)+1);
              set32(L,RSTAT()+D_RR()*4,get32(L,RSTAT()+D_RR()*4)+1);
            }
          }
        }
        p=p+1;
      }
    }
    // ---- search phase ----
    let budget:i32=SB();
    let found:i32=0;
    let pass:i32=0;
    while((pass<2)&&(found==0)&&(budget>0)){ 
      let q:i32=0;
      while((q<4)&&(found==0)&&(budget>0)){ 
        let ar:i32=get32(ARb,q*4);
        let enabled:i32=1;
        if(pass==0){ if(q>=rnd){ enabled=0; } }
        if(enabled==1){ 
          if(get32(TON,ar*4)==0){ 
            set32(TON,ar*4,1);
            if(ar>get32(L,bindi(5))){ set32(res,7,get32(res,7)+1); }
          }
          let tot:i32=tier_n(ar)*4;
          let cur:i32=get32(CUR,ar*4);
          let room:i32=tot-cur;
          if(room>0){ 
            let take:i32=budget;
            if(take>room){ take=room; }
            let idx:i32=cur;
            let cnt:i32=0;
            while((cnt<take)&&(found==0)){ 
              tier_hyp(B,POS,ar,idx);
              if(hyp_fit(FB,ORD,POS,ne,EXB)==1){ found=1; }
              else { idx=idx+1; cnt=cnt+1; }
            }
            set32(res,1,get32(res,1)+cnt);
            set32(CUR,ar*4,cur+cnt);
            budget=budget-cnt;
          }
        }
        q=q+1;
      }
      pass=pass+1;
    }
    // order fully consumed -> restart the walk (frozen rule)
    let more:i32=0;
    let q2:i32=0;
    while(q2<4){ 
      let ar2:i32=get32(ARb,q2*4);
      if(get32(CUR,ar2*4)<tier_n(ar2)*4){ more=1; }
      q2=q2+1;
    }
    if(more==0){ 
      let z:i32=1;
      while(z<5){ set32(CUR,z*4,0); z=z+1; }
    }
    if(found==1){ 
      set32(res,1,get32(res,1)+V+AUDN());
      set32(L,RSTAT()+D_AU()*4,get32(L,RSTAT()+D_AU()*4)+1);
      let vy:i32=hold_pred(P,FB,ORD,POS,fid,rnd,V,EXH);
      let ok2:i32=0;
      if(vy==1){ ok2=hold_pred(P,FB,ORD,POS,fid,rnd+1000,AUDN(),EXH); }
      if(ok2==1){ 
        reached=1;
        plan_store(L,ORD,POS);
        set32(res,6,get32(res,6)+1);
        set32(res,4,get32(res,4)+1);
        set32(L,RSTAT()+D_NP()*4,get32(L,RSTAT()+D_NP()*4)+1);
        absorb(L,ORD,POS,res);
      }
      else {
        set32(res,2,get32(res,2)+1);
        set32(L,RSTAT()+D_VF()*4,get32(L,RSTAT()+D_VF()*4)+1);
      }
    }
    rnd=rnd+1;
  }
  let EX:i32=0;
  if(reached==1){ 
    EX=4*(rnd-1);
    set32(res,3,1);
    set32(res,8,1);
    set32(res,10,rnd-1);
  }
  else {
    EX=4*RMAX();
    let ones:i32=0; let e:i32=0;
    while(e<MAXE()){ ones=ones+(EXB[e*13+12] as i32); e=e+1; }
    let maj:i32=0;
    if(ones*2>MAXE()){ maj=1; }
    let ok:i32=0; let i2:i32=0;
    while(i2<VAUD()){ 
      prs(P,hsh(fid,555+i2+1));
      gen_ex(P,FB,EXH);
      if(maj==(EXH[12] as i32)){ ok=ok+1; }
      i2=i2+1;
    }
    set32(res,9,ok*100/VAUD());
    if(ok*100/VAUD()<=70){ set32(res,8,1); }
    set32(res,10,RMAX());
  }
  set32(res,0,EX);
  return reached;
}

// ---------------- arm parameter table ----------------
fn arm_l1(a:i32)i32 {
  if(a==0){ return 1; } if(a==2){ return 1; } if(a==6){ return 1; }
  return 0;
}
fn arm_ar(a:i32)i32 {
  if(a==0){ return 1; } if(a==1){ return 1; } if(a==4){ return 1; } if(a==6){ return 1; }
  return 0;
}
fn arm_vf(a:i32)i32 {
  if(a==0){ return 1; } if(a==1){ return 1; } if(a==3){ return 1; } if(a==6){ return 1; }
  return 0;
}
fn cond_f0(c:i32)i32 {
  if(c==0){ return 16; } if(c==1){ return 22; } if(c==2){ return 28; }
  if(c==3){ return 34; }
  return 40;
}
fn cond_name(c:i32)i32 { return c; }

fn cname(c:i32)[]u8 {
  if(c==0){ return "RELATED"; }
  if(c==1){ return "MISLEADING"; }
  if(c==2){ return "PARTIAL"; }
  if(c==3){ return "IRRELEVANT"; }
  return "DOMAIN2";
}
fn aname(a:i32)[]u8 {
  if(a==0){ return "PRIOR"; }
  if(a==1){ return "ABL_L1"; }
  if(a==2){ return "ABL_L2"; }
  if(a==3){ return "CHAN_V"; }
  if(a==4){ return "CHAN_A"; }
  if(a==5){ return "COLD"; }
  return "DATA";
}
fn agg(c:i32,a:i32,f:i32)i32 { return (c*7+a)*9*4+f*4; }
fn exm(c:i32,a:i32,f:i32)i32 { return (c*7+a)*6*4+f*4; }
fn aget(c:i32,a:i32,f:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,f)); }
fn aadd(c:i32,a:i32,f:i32,v:i32,AGG:[]u8)void {
  let o:i32=agg(c,a,f);
  set32(AGG,o,get32(AGG,o)+v);
  return;
}
fn agz(AGG:[]u8)void {
  let i:i32=0;
  while(i<35*9){ set32(AGG,i*4,0); i=i+1; }
  return;
}
fn exz(EXM:[]u8)void {
  let i:i32=0;
  while(i<5*7*6){ set32(EXM,i*4,0); i=i+1; }
  return;
}
// EX for (cond,arm)
fn AEX(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,0)); }
fn ASA(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,1)); }
fn AVA(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,2)); }
fn ARC(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,3)); }
fn AFC(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,8)); }
fn ARU(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,4)); }
fn ARR(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,5)); }
fn ARA(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,6)); }
fn ANS_(c:i32,a:i32,AGG:[]u8)i32 { return get32(AGG,agg(c,a,7)); }
// total cost proxy C = SA + 4*VA
fn ACOST(c:i32,a:i32,AGG:[]u8)i32 { return ASA(c,a,AGG)+4*AVA(c,a,AGG); }

fn train_state(L:[]u8,lo:i32,hi:i32,B:[]u8,P:[]u8,EXB:[]u8,SCR:[]u8,FB:[]u8,res:[]u8)i32 {
  state_init(L);
  let tok:i32=0; let tvf:i32=0; let maxar:i32=0;
  let e:i32=lo;
  while(e<hi){
    fam_build(FB,e,P);
    gen_all(P,FB,EXB);
    let r:i32=run_ep(L,FB,1,1,1,B,P,EXB,SCR,res);
    if(r==1){
      tok=tok+1;
      tvf=tvf+get32(res,2);
      if(get32(res,11)>maxar){ maxar=get32(res,11); }
    }
    e=e+1;
  }
  set32(L,RSTAT()+S_TOK()*4,tok);
  set32(L,RSTAT()+S_TVF()*4,tvf);
  set32(L,bindi(5),maxar);
  derive_ar(L);
  let v:i32=derive_V(L);
  return v;
}

fn main()i32 {
  let OB:[]u8=z_alloc(65536);
  let B:[]u8=z_alloc(512);
  let P:[]u8=z_alloc(32);
  let EXB:[]u8=z_alloc(MAXE()*13+16);
  let SCR:[]u8=z_alloc(256);
  let FB:[]u8=z_alloc(32);
  let res:[]u8=z_alloc(64);
  let AGG:[]u8=z_alloc(35*9*4+16);
  let EXM:[]u8=z_alloc(5*7*6*4+16);
  bin_init(B);
  let LP:[]u8=z_alloc(LSZ());
  let LD:[]u8=z_alloc(LSZ());
  let LW:[]u8=z_alloc(LSZ());
  agz(AGG);
  exz(EXM);

  let c:i32=0;
  // ---- TRAINING (prior state: structured families; data state: noise families) ----
  let vpri:i32=train_state(LP,0,8,B,P,EXB,SCR,FB,res);
  let vdat:i32=train_state(LD,8,16,B,P,EXB,SCR,FB,res);

  // ---- TEST: 5 conditions x 7 arms x 6 families ----
  while(c<5){
    let a:i32=0;
    while(a<7){
      let f0:i32=cond_f0(c);
      if(a==6){ bcopy(LW,LD,LSZ()); } else { bcopy(LW,LP,LSZ()); }
      let f:i32=0;
      while(f<6){
        let fid:i32=f0+f;
        fam_build(FB,fid,P);
        gen_all(P,FB,EXB);
        let r:i32=run_ep(LW,FB,arm_l1(a),arm_ar(a),arm_vf(a),B,P,EXB,SCR,res);
        set32(EXM,exm(c,a,f),get32(res,0));
        aadd(c,a,0,get32(res,0),AGG);
        aadd(c,a,1,get32(res,1),AGG);
        aadd(c,a,2,get32(res,2),AGG);
        aadd(c,a,4,get32(res,4),AGG);
        aadd(c,a,5,get32(res,5),AGG);
        aadd(c,a,6,get32(res,6),AGG);
        aadd(c,a,7,get32(res,7),AGG);
        aadd(c,a,8,get32(res,8),AGG);
        if(r==1){ aadd(c,a,3,1,AGG); }
        f=f+1;
      }
      a=a+1;
    }
    c=c+1;
  }

  // ---- REPORT ----
  let o:i32=0;
  o=fvs(OB,o,"HDR p5meta charter23");
  o=fv(OB,o,"TRAIN prior_V=",vpri);
  o=fv(OB,o," data_V=",vdat);
  o=fv(OB,o," prior_AR=",get32(LP,bindi(0)));
  o=fv(OB,o,",",get32(LP,bindi(1)));
  o=fv(OB,o,",",get32(LP,bindi(2)));
  o=fv(OB,o,",",get32(LP,bindi(3)));
  o=fv(OB,o," data_AR=",get32(LD,bindi(0)));
  o=fv(OB,o,",",get32(LD,bindi(1)));
  o=fv(OB,o,",",get32(LD,bindi(2)));
  o=fv(OB,o,",",get32(LD,bindi(3)));
  o=fvs(OB,o,"\n");
  let j:i32=0;
  while(j<12){
    o=fv(OB,o,"SLOT_REL ",j);
    o=fv(OB,o,"=",get32(LP,ctxb(j)));
    o=fvs(OB,o,"\n");
    j=j+1;
  }
  let t:i32=1;
  while(t<5){
    o=fv(OB,o,"STRATT a",t-1);
    o=fv(OB,o," uses=",get32(LP,strb(t)));
    o=fv(OB,o," wins=",get32(LP,strb(t)+4));
    o=fvs(OB,o,"\n");
    t=t+1;
  }
  c=0;
  while(c<5){
    let a:i32=0;
    while(a<7){
      o=fvs(OB,o,"COND ");
      o=fvs(OB,o,cname(c));
      o=fvs(OB,o," ARM ");
      o=fvs(OB,o,aname(a));
      o=fv(OB,o," EX=",AEX(c,a,AGG));
      o=fv(OB,o," SA=",ASA(c,a,AGG));
      o=fv(OB,o," VA=",AVA(c,a,AGG));
      o=fv(OB,o," COST=",ACOST(c,a,AGG));
      o=fv(OB,o," REACH=",ARC(c,a,AGG));
      o=fv(OB,o," FC=",AFC(c,a,AGG));
      o=fv(OB,o," RU=",ARU(c,a,AGG));
      o=fv(OB,o," RR=",ARR(c,a,AGG));
      o=fv(OB,o," RA=",ARA(c,a,AGG));
      o=fv(OB,o," NS=",ANS_(c,a,AGG));
      o=fvs(OB,o,"\n");
      a=a+1;
    }
    c=c+1;
  }
  // negative transfer magnitudes
  c=0;
  while(c<5){
    o=fvs(OB,o,"NT ");
    o=fvs(OB,o,cname(c));
    o=fv(OB,o," EX_PRIOR-COLD=",AEX(c,0,AGG)-AEX(c,5,AGG));
    o=fv(OB,o," COST_PRIOR-COLD=",ACOST(c,0,AGG)-ACOST(c,5,AGG));
    o=fvs(OB,o,"\n");
    c=c+1;
  }
  // per-family EX on IRRELEVANT (must be identical across arms 0 and 5)
  let mx:i32=0;
  let f:i32=0;
  while(f<6){
    let d:i32=get32(EXM,exm(3,0,f))-get32(EXM,exm(3,5,f));
    if(d<0){ d=0-d; }
    if(d>mx){ mx=d; }
    f=f+1;
  }
  o=fv(OB,o,"IRR_PERFAM_MAXDIFF_PRIOR_VS_COLD=",mx);
  o=fvs(OB,o,"\n");

  // ---- BARS (flat control flow; no if nested deeper than 2) ----
  let k4:i32=1;
  let bc:i32=0;
  while(bc<5){
    let ba:i32=0;
    while(ba<7){
      let rc:i32=ARC(bc,ba,AGG);
      let fc:i32=AFC(bc,ba,AGG);
      let okc:i32=0;
      if(bc==3){ okc=1; }
      if(rc==6){ okc=okc+1; }
      if(fc==6){ okc=okc+1; }
      if(okc<3){ k4=0; }
      ba=ba+1;
    }
    bc=bc+1;
  }
  o=ff(OB,o,"K4_FLOOR=",k4);

  // K5 RELATED speedup
  let k5:i32=0;
  if(AEX(0,5,AGG)*100>=200*AEX(0,0,AGG)){ k5=1; }
  o=fv(OB,o," REL_RATIO=",AEX(0,5,AGG)*100/AEX(0,0,AGG));
  o=ff(OB,o," K5=",k5);

  // K6 IRRELEVANT neutral
  let k6:i32=0;
  let sa3:i32=ASA(3,5,AGG);
  let sad:i32=ASA(3,0,AGG)-sa3;
  if(AEX(3,0,AGG)==AEX(3,5,AGG)){ k6=1; }
  if(mx!=0){ k6=0; }
  if(sad*100>25*sa3){ k6=0; }
  o=fv(OB,o," IRR_SADELTA=",sad);
  o=ff(OB,o," K6=",k6);

  // K7 MISLEADING bounded harm + recovery + rejected reuse
  let k7:i32=0;
  if(AEX(1,0,AGG)>AEX(1,5,AGG)){ k7=1; }
  if(AEX(1,0,AGG)*100>250*AEX(1,5,AGG)){ k7=0; }
  if(ARR(1,0,AGG)<6){ k7=0; }
  o=ff(OB,o," K7=",k7);

  // K8 PARTIAL selective
  let k8:i32=0;
  if(AEX(2,0,AGG)>AEX(0,0,AGG)){ k8=1; }
  if(AEX(2,0,AGG)>=AEX(2,5,AGG)){ k8=0; }
  o=ff(OB,o," K8=",k8);

  // K9 DOMAIN2 abstract transfer
  let k9:i32=0;
  if(AEX(4,5,AGG)*100>=150*AEX(4,0,AGG)){ k9=1; }
  o=fv(OB,o," D2_RATIO=",AEX(4,5,AGG)*100/AEX(4,0,AGG));
  o=ff(OB,o," K9=",k9);

  // K10 L1/L2 dissociation on DOMAIN2
  let k10:i32=0;
  if(AEX(4,0,AGG)*100<=125*AEX(4,1,AGG)){ k10=1; }
  if(AEX(4,0,AGG)*100<140*AEX(4,2,AGG)){ k10=0; }
  o=fv(OB,o," D2_PRIOR/ABL_L1=",AEX(4,0,AGG)*100/AEX(4,1,AGG));
  o=fv(OB,o," D2_PRIOR/ABL_L2=",AEX(4,0,AGG)*100/AEX(4,2,AGG));
  o=ff(OB,o," K10=",k10);

  // K11 L1 necessary for RELATED
  let k11:i32=0;
  if(AEX(0,1,AGG)*100>=150*AEX(0,0,AGG)){ k11=1; }
  o=fv(OB,o," REL_ABL_L1/PRIOR=",AEX(0,1,AGG)*100/AEX(0,0,AGG));
  o=ff(OB,o," K11=",k11);

  // K12 L1 harmful on MISLEADING, policy harmless
  let k12:i32=0;
  if(AEX(1,1,AGG)<=AEX(1,0,AGG)){ k12=1; }
  if(AEX(1,4,AGG)*100<90*AEX(1,5,AGG)){ k12=0; }
  o=ff(OB,o," K12=",k12);

  // K13 NOT-MORE-DATA
  let k13:i32=1;
  let cc:i32=0;
  while(cc<5){
    if(AEX(cc,6,AGG)*100<95*AEX(cc,5,AGG)){ k13=0; }
    cc=cc+1;
  }
  o=fvs(OB,o," DATAVS_COLD ");
  cc=0;
  while(cc<5){
    o=fvs(OB,o,cname(cc));
    o=fv(OB,o,"=",AEX(cc,6,AGG)*100/AEX(cc,5,AGG));
    o=fvs(OB,o," ");
    cc=cc+1;
  }
  o=ff(OB,o," K13=",k13);

  // K14 decomposition
  let k14:i32=1;
  if(AEX(0,3,AGG)*100>100*AEX(0,5,AGG)){ k14=0; }
  if(AEX(0,4,AGG)*100>100*AEX(0,5,AGG)){ k14=0; }
  if(AEX(4,3,AGG)*100>100*AEX(4,5,AGG)){ k14=0; }
  if(AEX(4,4,AGG)*100>100*AEX(4,5,AGG)){ k14=0; }
  o=fv(OB,o," CHAN_A_REL=",AEX(0,4,AGG)*100/AEX(0,5,AGG));
  o=fv(OB,o," CHAN_A_D2=",AEX(4,4,AGG)*100/AEX(4,5,AGG));
  o=ff(OB,o," K14=",k14);
  o=fvs(OB,o,"\n");

  // ---- VERDICT, frozen mapping ----
  let all:i32=1;
  if(k4==0){ all=0; }
  if(k5==0){ all=0; }
  if(k6==0){ all=0; }
  if(k7==0){ all=0; }
  if(k8==0){ all=0; }
  if(k9==0){ all=0; }
  if(k10==0){ all=0; }
  if(k11==0){ all=0; }
  if(k12==0){ all=0; }
  if(k13==0){ all=0; }
  if(k14==0){ all=0; }
  let part:i32=0;
  if(k4==1){ part=1; }
  if(k5==0){ part=0; }
  if(k9==0){ part=0; }
  if(k6==0){ part=0; }
  let noml:i32=0;
  if(k5==0){ noml=1; }
  if(k13==0){ noml=1; }
  if(k10==0){ noml=1; }
  o=fvs(OB,o,"BARS k4=");
  o=fv(OB,o,"",k4);
  o=fv(OB,o," k5=",k5);
  o=fv(OB,o," k6=",k6);
  o=fv(OB,o," k7=",k7);
  o=fv(OB,o," k8=",k8);
  o=fv(OB,o," k9=",k9);
  o=fv(OB,o," k10=",k10);
  o=fv(OB,o," k11=",k11);
  o=fv(OB,o," k12=",k12);
  o=fv(OB,o," k13=",k13);
  o=fv(OB,o," k14=",k14);
  o=fvs(OB,o,"\n");
  o=fvs(OB,o,"VERDICT=");
  if(all==1){ o=fvs(OB,o,"META-LEARNING-TRANSFER-DEMONSTRATED\n"); }
  if(all==0){ o=fvs(OB,o,"|"); }
  if(part==1){ o=fvs(OB,o,"PARTIAL\n"); }
  if(part==0){ o=fvs(OB,o,"|"); }
  if(noml==1){ o=fvs(OB,o,"NO-META-LEARNING\n"); }
  if(noml==0){ o=fvs(OB,o,"|\n"); }
  o_flush(OB,o);
  return 0;
}

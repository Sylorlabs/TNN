// diag.zag -- P5 lane self-check / toolchain diagnostic (pure Zag, no globals).
//
// Purpose: establish on this host exactly what the flat-arena primitives do,
// so that a later failure of the p5 learner can be attributed correctly rather
// than blamed on the compiler or on the learner without evidence.
//
// Sections, in output order:
//   D1  get32 of a freshly zeroed arena                       expect 0
//   D2  set32/get32 round-trip at one offset                  expect 5, 6, 1234567
//   D3  4-byte store overlapping a previous 4-byte store
//       (offset 4 = 0x0012D687; then store 9 at offset 5)     expect 2439
//   D4  read-modify-write x3 inside a while loop              expect 2469
//   D5  binomial table with a correct 24-byte row stride
//       C(11,3) C(11,2) C(12,4) C(4,2) C(11,1) C(0,0)        expect 165 55 495 6 11 1
//   D6  16-bit LCG reproducibility                           expect equal seeds -> equal draws

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_num(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let d:i32=0;
  let t:i32=x;
  while(t>0){ d=d+1; t=t/10; }
  if(d<1){ d=1; }
  let e:i32=c+neg+d;
  let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
// print one labelled value on its own line
fn pl(O:[]u8,c:i32,tag:[]u8,v:i32)i32 {
  c=o_app(O,c,tag);
  c=o_app(O,c,"=");
  c=o_num(O,c,v);
  O[c]=10;
  return c+1;
}
fn bin_init(B:[]u8)void {
  let n:i32=0;
  while(n<13){
    set32(B,n*24,1);
    let r:i32=1;
    while(r<6){
      if(r>n){ set32(B,n*24+r*4,0); }
      else { set32(B,n*24+r*4,get32(B,(n-1)*24+(r-1)*4)+get32(B,(n-1)*24+r*4)); }
      r=r+1;
    }
    n=n+1;
  }
  return;
}
fn ncr(B:[]u8,n:i32,r:i32)i32 {
  if(r<0){ return 0; }
  if(r>n){ return 0; }
  return get32(B,n*24+r*4);
}
fn lcg(P:[]u8,s:i32)i32 {
  set32(P,16,s);
  let i:i32=0;
  while(i<4){
    let x:i32=get32(P,16);
    set32(P,16,(x*25173+13849)%65536);
    i=i+1;
  }
  return get32(P,16);
}
fn main()i32 {
  let O:[]u8=z_alloc(65536);
  let A:[]u8=z_alloc(256);
  let C:[]u8=z_alloc(512);
  let P:[]u8=z_alloc(32);
  let c:i32=0;
  // D1
  c=pl(O,c,"D1_fresh",get32(A,4));
  // D2
  set32(A,4,5);
  c=pl(O,c,"D2a",get32(A,4));
  set32(A,4,6);
  c=pl(O,c,"D2b",get32(A,4));
  set32(A,4,1234567);
  c=pl(O,c,"D2c",get32(A,4));
  // D3 overlapping 4-byte store
  set32(A,5,9);
  c=pl(O,c,"D3_overlap",get32(A,4));
  // D4 read-modify-write in a loop
  let i:i32=0;
  while(i<3){
    let u:i32=get32(A,4);
    set32(A,4,u+10);
    i=i+1;
  }
  c=pl(O,c,"D4_rmw_x3",get32(A,4));
  // D5 binomial
  bin_init(C);
  c=pl(O,c,"D5_C11_3",ncr(C,11,3));
  c=pl(O,c,"D5_C11_2",ncr(C,11,2));
  c=pl(O,c,"D5_C12_4",ncr(C,12,4));
  c=pl(O,c,"D5_C4_2",ncr(C,4,2));
  c=pl(O,c,"D5_C11_1",ncr(C,11,1));
  c=pl(O,c,"D5_C0_0",ncr(C,0,0));
  // D6 LCG
  c=pl(O,c,"D6_lcg_a",lcg(P,12345));
  c=pl(O,c,"D6_lcg_b",lcg(P,12345));
  c=pl(O,c,"D6_lcg_c",lcg(P,999));
  _zag_print(O[0..c]);
  return 0;
}

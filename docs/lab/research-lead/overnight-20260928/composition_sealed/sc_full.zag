// sc_full.zag -- Sealed strong composition: skill X + domain Y -> goal Z.
//
// Phase 1: teach X = scalar operation, induced from scalar (in,out)
//   examples as an executable 2-node graph: IN -> ADD(k).
//   Induction family: out = in + k, k from first example, verified on rest.
//   Fails closed on non-constant examples.
// Phase 2: teach Y = sequence domain: register sequences, indexed read,
//   length, build. Sequences are never transformed here.
// Phase 3 (sealed): unlabeled goal = new input sequence S* plus target T*
//   with T*[i] = X(S*[i]). No paired X+Y examples, no hint, no task label.
//
// Solver: generic candidate enumeration over LEARNED structures only.
//   Families: COPY (any registered sequence of matching length) and
//   ELTWISE (any learned scalar proc applied elementwise to any registered
//   sequence of matching length). Elementwise verification decides.
// On success a new executable Z record is created with provenance links
// to the selected proc and the sequence domain, then reused directly.
//
// Pure Zag. u8-backed workspace, little-endian helpers (no as *i32 casts).
// 0 modes / 0 bridges / 0 handlers.

// ---------- runtime prelude (pinned znc intrinsics) ----------
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

// ---------- workspace layout ----------
// header: 0 CMP_ON, 4 SEQDOM, 8 TRIES, 12 ELTCT, 16 ZUSED, 20 ZPROC,
//         24 ZSEQ, 28 ZPROVX, 32 ZPROVY, 36 POOL
// procs: base 64, 8 entries x 12 bytes: used, graph_off, k
// seqs:  base 160, 8 entries x 12 bytes: used, len, elem_off
// pool:  base 256
// op codes: 0 = OP_IN, 1 = OP_ADD

fn sc_init(W:[]u8)void {
  let i:i32=0;
  while(i<256){ put32(W,i,0); i=i+4; }
  put32(W,0,1);
  put32(W,4,1);
  put32(W,36,256);
  return;
}
fn pool_alloc(W:[]u8,n:i32)i32 {
  let o:i32=ig(W,36);
  put32(W,36,o+n);
  return o;
}

// ---------- skill X: induction of scalar procedure ----------
fn sc_teach_proc(W:[]u8,a0:i32,b0:i32,a1:i32,b1:i32,a2:i32,b2:i32)i32 {
  let k:i32=b0-a0;
  if(b1-a1!=k){ return -1; }
  if(b2-a2!=k){ return -1; }
  let p:i32=0; let slot:i32=-1;
  while(p<8){ if(slot==-1 && ig(W,64+p*12)!=1){ slot=p; } p=p+1; }
  if(slot==-1){ return -1; }
  let go:i32=pool_alloc(W,16);
  put32(W,go,0); put32(W,go+4,0);
  put32(W,go+8,1); put32(W,go+12,k);
  put32(W,64+slot*12,1);
  put32(W,64+slot*12+4,go);
  put32(W,64+slot*12+8,k);
  return slot;
}
fn sc_exec_proc(W:[]u8,p:i32,v:i32)i32 {
  let go:i32=ig(W,64+p*12+4);
  let acc:i32=v;
  let n:i32=0;
  while(n<2){
    let op:i32=ig(W,go+n*8);
    let ag:i32=ig(W,go+n*8+4);
    if(op==0){ acc=v; }
    if(op==1){ acc=acc+ag; }
    n=n+1;
  }
  return acc;
}
fn sc_proc_k(W:[]u8,p:i32)i32 {
  let go:i32=ig(W,64+p*12+4);
  return ig(W,go+12);
}
fn sc_del_proc(W:[]u8,p:i32)void {
  put32(W,64+p*12,0);
  return;
}

// ---------- domain Y: sequences ----------
fn sc_reg_seq(W:[]u8,src:[]u8,n:i32)i32 {
  if(ig(W,4)==0){ return -1; }
  let s:i32=0; let slot:i32=-1;
  while(s<8){ if(slot==-1 && ig(W,160+s*12)!=1){ slot=s; } s=s+1; }
  if(slot==-1){ return -1; }
  let eo:i32=pool_alloc(W,n*4);
  let i:i32=0;
  while(i<n){ put32(W,eo+i*4,ig(src,i*4)); i=i+1; }
  put32(W,160+slot*12,1);
  put32(W,160+slot*12+4,n);
  put32(W,160+slot*12+8,eo);
  return slot;
}
fn sc_seq_len(W:[]u8,s:i32)i32 {
  return ig(W,160+s*12+4);
}
fn sc_seq_get(W:[]u8,s:i32,i:i32)i32 {
  let eo:i32=ig(W,160+s*12+8);
  return ig(W,eo+i*4);
}
fn sc_seq_eq_buf(W:[]u8,s:i32,buf:[]u8,n:i32)i32 {
  if(sc_seq_len(W,s)!=n){ return 0; }
  let i:i32=0;
  while(i<n){ if(sc_seq_get(W,s,i)!=ig(buf,i*4)){ return 0; } i=i+1; }
  return 1;
}

// ---------- generic ELTWISE machinery (counts executions) ----------
fn sc_eltwise(W:[]u8,p:i32,s:i32)i32 {
  if(ig(W,0)==0){ return -1; }
  if(ig(W,4)==0){ return -1; }
  put32(W,12,ig(W,12)+1);
  let n:i32=sc_seq_len(W,s);
  let t:i32=0; let slot:i32=-1;
  while(t<8){ if(slot==-1 && ig(W,160+t*12)!=1){ slot=t; } t=t+1; }
  if(slot==-1){ return -1; }
  let eo:i32=pool_alloc(W,n*4);
  let i:i32=0;
  while(i<n){ put32(W,eo+i*4,sc_exec_proc(W,p,sc_seq_get(W,s,i))); i=i+1; }
  put32(W,160+slot*12,1);
  put32(W,160+slot*12+4,n);
  put32(W,160+slot*12+8,eo);
  return slot;
}

// ---------- sealed solver: no labels, no hint ----------
fn sc_solve(W:[]u8,inp:[]u8,tgt:[]u8,gn:i32)i32 {
  emit("SEALED unlabeled-goal len="); e64(gn); emit("\n");
  emit("ELTCT-PRE-SEAL="); e64(ig(W,12)); emit("\n");
  if(ig(W,4)==0){ emit("Z ans=-2 (seqdom off)\n"); return -2; }
  let star:i32=sc_reg_seq(W,inp,gn);
  if(star<0){ emit("Z ans=-2 (cannot register input)\n"); return -2; }
  let s:i32=0;
  while(s<8){
    if(ig(W,160+s*12)==1 && sc_seq_len(W,s)==gn){
      put32(W,8,ig(W,8)+1);
      emit("TRY COPY seq="); e64(s); emit("\n");
      if(sc_seq_eq_buf(W,s,tgt,gn)==1){
        emit("Z ans=1 via COPY seq="); e64(s); emit("\n");
        return 1;
      }
      emit("REJECT COPY seq="); e64(s); emit("\n");
    }
    s=s+1;
  }
  if(ig(W,0)==1){
    let p:i32=0;
    while(p<8){
      if(ig(W,64+p*12)==1){
        s=0;
        while(s<8){
          if(ig(W,160+s*12)==1 && sc_seq_len(W,s)==gn){
            put32(W,8,ig(W,8)+1);
            emit("TRY ELTWISE proc="); e64(p);
            emit(" k="); e64(sc_proc_k(W,p));
            emit(" seq="); e64(s); emit("\n");
            let t:i32=sc_eltwise(W,p,s);
            if(t>=0 && sc_seq_eq_buf(W,t,tgt,gn)==1){
              put32(W,16,1);
              put32(W,20,p);
              put32(W,24,s);
              put32(W,28,p);
              put32(W,32,1);
              emit("Z ans=1 via ELTWISE proc="); e64(p);
              emit(" seq="); e64(s); emit("\n");
              emit("ZMAP provx="); e64(p); emit(" provy=1\n");
              return 1;
            }
            emit("REJECT ELTWISE proc="); e64(p); emit(" seq="); e64(s); emit("\n");
            if(t>=0){ put32(W,160+t*12,0); }
          }
          s=s+1;
        }
      }
      p=p+1;
    }
  }
  emit("Z ans=-2\n");
  return -2;
}

// ---------- Z reuse: direct apply, no search ----------
fn sc_zapply(W:[]u8,s2:[]u8,tgt:[]u8,gn:i32)i32 {
  emit("Z2 reuse: direct Z apply, no search\n");
  if(ig(W,16)==0){ emit("Z2 ans=-2 (no Z)\n"); return -2; }
  if(ig(W,4)==0){ emit("Z2 ans=-2 (seqdom off)\n"); return -2; }
  let s:i32=sc_reg_seq(W,s2,gn);
  if(s<0){ emit("Z2 ans=-2 (cannot register input)\n"); return -2; }
  let p:i32=ig(W,20);
  put32(W,8,ig(W,8)+1);
  let t:i32=sc_eltwise(W,p,s);
  if(t>=0 && sc_seq_eq_buf(W,t,tgt,gn)==1){ emit("Z2 ans=1\n"); return 1; }
  emit("Z2 ans=-2\n");
  return -2;
}

// ---------- driver ----------
fn fill6(b:[]u8,v0:i32,v1:i32,v2:i32,v3:i32,v4:i32,v5:i32)void {
  put32(b,0,v0); put32(b,4,v1); put32(b,8,v2);
  put32(b,12,v3); put32(b,16,v4); put32(b,20,v5);
  return;
}
fn sc_phase12(W:[]u8)void {
  emit("PHASE1 teach X (scalar examples only)\n");
  let x1:i32=sc_teach_proc(W,3,10,1,8,9,16);
  emit("X1 proc="); e64(x1);
  emit(" exec(20)="); e64(sc_exec_proc(W,x1,20)); emit("\n");
  let x2:i32=sc_teach_proc(W,5,7,0,2,11,13);
  emit("X2 proc="); e64(x2);
  emit(" exec(20)="); e64(sc_exec_proc(W,x2,20)); emit("\n");
  let g:i32=sc_teach_proc(W,4,9,5,11,6,10);
  emit("GAP non-constant induct="); e64(g); emit(" (expect -1)\n");
  emit("PHASE2 teach Y (sequences only, never transformed)\n");
  let SA:[]u8=z_alloc(24); fill6(SA,3,1,9,2,0,0);
  let SB:[]u8=z_alloc(24); fill6(SB,8,0,5,6,0,0);
  let SC:[]u8=z_alloc(24); fill6(SC,1,1,1,0,0,0);
  let SD:[]u8=z_alloc(24); fill6(SD,0,0,0,0,0,0);
  emit("SA seq="); e64(sc_reg_seq(W,SA,4)); emit("\n");
  emit("SB seq="); e64(sc_reg_seq(W,SB,4)); emit("\n");
  emit("SC seq="); e64(sc_reg_seq(W,SC,3)); emit("\n");
  emit("SD seq="); e64(sc_reg_seq(W,SD,6)); emit("\n");
  return;
}
fn sc_sealed_goal(W:[]u8)void {
  let S:[]u8=z_alloc(24); fill6(S,4,0,11,5,7,3);
  let T:[]u8=z_alloc(24); fill6(T,11,7,18,12,14,10);
  let r:i32=sc_solve(W,S,T,6);
  emit("tried="); e64(ig(W,8)); emit("\n");
  let S2:[]u8=z_alloc(24); fill6(S2,9,2,6,0,4,8);
  let T2:[]u8=z_alloc(24); fill6(T2,16,9,13,7,11,15);
  let r2:i32=sc_zapply(W,S2,T2,6);
  emit("tried-after-Z2="); e64(ig(W,8)); emit("\n");
  if(r==1 && r2==1){ emit("ARM-RESULT PASS\n"); } else { emit("ARM-RESULT rc="); e64(r); emit("/"); e64(r2); emit("\n"); }
  return;
}
fn sc_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  sc_phase12(W);
  sc_sealed_goal(W);
  return;
}
fn sc_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  sc_phase12(W);
  sc_del_proc(W,0); sc_del_proc(W,1);
  emit("procs deleted\n");
  sc_sealed_goal(W);
  return;
}
fn sc_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  sc_phase12(W);
  put32(W,4,0);
  emit("sequence domain disabled\n");
  sc_sealed_goal(W);
  return;
}
fn sc_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  sc_sealed_goal(W);
  return;
}
fn sc_nocompose(W:[]u8)void {
  emit("=== NO-COMPOSE ===\n");
  sc_phase12(W);
  put32(W,0,0);
  emit("ELTWISE family disabled\n");
  sc_sealed_goal(W);
  return;
}
fn main()i32 {
  emit("SEALED-COMP-START\n");
  let W1:[]u8=z_alloc(65536); sc_init(W1); sc_treat(W1);
  let W2:[]u8=z_alloc(65536); sc_init(W2); sc_ablx(W2);
  let W3:[]u8=z_alloc(65536); sc_init(W3); sc_ably(W3);
  let W4:[]u8=z_alloc(65536); sc_init(W4); sc_fresh(W4);
  let W5:[]u8=z_alloc(65536); sc_init(W5); sc_nocompose(W5);
  emit("SEALED-COMP-END\n");
  return 0;
}

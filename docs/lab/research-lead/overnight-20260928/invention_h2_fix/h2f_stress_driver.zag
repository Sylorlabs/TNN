// h2f_stress_driver.zag -- candidate-pressure stress test for the H2 fix.
//
// Ten duplicate [1,1,1,1] MAPs + a 12-link r1 chain. Level-0 satisfiable
// fragments = 10+20+30+40 = 100, so ir_frag_candidates must truncate at
// frag_cand_max()=48 at every DFS level. Under the old 108-entry buffer
// this fixture would corrupt the heap; with the derived D*B bound the
// search must complete cleanly and solve with three whole-MAP fragments.
fn main()i32 {
  emit("H2F-STRESS-START\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let k:i32=0;
  let s0:i32=101;
  while(k<10){
    ev_teach(W,s0,1,s0+1);
    ev_teach(W,s0+1,1,s0+2);
    ev_teach(W,s0+2,1,s0+3);
    ev_teach(W,s0+3,1,s0+4);
    let x:i32=ev_query(W,s0,61,s0+4,0);
    emit("Xdup k=");
    e64(k);
    emit(" ans=");
    e64(x);
    emit("\n");
    s0=s0+10;
    k=k+1;
  }
  let i:i32=31;
  while(i<43){
    ev_teach(W,i,1,i+1);
    i=i+1;
  }
  let cb:[]u8=z_alloc(frag_cand_max()*12);
  let ub:[]u8=z_alloc(36);
  let n0:i32=ir_frag_candidates(W,31,ub,0,cb,0);
  emit("CANDCOUNT s=31 n0=");
  e64(n0);
  emit(" cap=");
  e64(frag_cand_max());
  emit("\n");
  let z:i32=ev_query(W,31,63,43,0);
  emit("Z ans=");
  e64(z);
  emit("\nH2F-STRESS-END\n");
  return 0;
}

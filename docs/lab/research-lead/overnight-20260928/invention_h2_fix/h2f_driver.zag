// rt_driver.zag -- Invention H2 red-team battery (unfrozen).
//
// Six adversarial arms against fragment recombination (commit 31391237a).
// A1 SPURIOUS: distractor facts + distractor MAP [1,1,2]; verifier is
//    answer-only, so a verifying-but-wrong form can hijack Z.
// A2 DUP-ABL: duplicate [1,1,1,1] MAP; delete only the first. The report's
//    ABL-X logic ("no alternative covers it") is tested.
// A3 SINGLE: replicate Z then Z' on both binaries. The n=1 "reuse" uses a
//    whole-MAP fragment (165,0,6); check what the nc binary does.
// A5 THREEFRAG: 9-link goal needing 3 PROPER fragments (report limitation 4).
// A4c CONTROL: 12-link r1 chain, ONE [1,1,1,1] MAP. 3 whole fragments.
//    Level-2 candidate count stays < 13 (no overflow). Expect success.
// A4 OVERFLOW: 12-link r1 chain, FOUR duplicate [1,1,1,1] MAPs. The nc
//    binary (Composition C behavior) must solve it with n=3 whole MAPs.
//    The frag binary reaches level 2 with >= 13 candidates, overflowing
//    the 1296-byte cand buffer (108 entries; level 2 needs entries 96..143).
//    A4 runs LAST: if the frag binary crashes, earlier arms are preserved.

// ---- instrumentation (copied idioms from ir_driver.zag) ----
fn ir_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried=");
  e64(t/1024);
  emit(" rejected=");
  e64(t-(t/1024)*1024);
  emit("\n");
  return;
}
fn ir_count14(W:[]u8)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn ir_count_maps(W:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn ir_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn ir_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=ir_relseq(W,m,seq,7);
  emit("MAP ");
  e64(m);
  emit(" relseq=[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    e64(get32(seq,i*4));
    i=i+1;
  }
  emit("]\n");
  return;
}
fn ir_print_zfrags(W:[]u8,zm:i32)void {
  if(zm<0){emit("ZMAP none\n"); return;}
  let nfrag:i32=ng(W,zm,12);
  emit("ZFRAG nfrag=");
  e64(nfrag);
  emit(" f16=");
  e64(ng(W,zm,16));
  emit(" f32=");
  e64(ng(W,zm,32));
  emit("\n");
  let packed:i32=ng(W,zm,16);
  let f1:i32=packed-(packed/65536)*65536;
  let f2:i32=packed/65536;
  emit("  frag1 m=");
  e64(f1/64);
  emit(" s=");
  e64((f1-(f1/64)*64)/8);
  emit(" l=");
  e64(f1-(f1/8)*8);
  emit("\n");
  if(nfrag>1){
    emit("  frag2 m=");
    e64(f2/64);
    emit(" s=");
    e64((f2-(f2/64)*64)/8);
    emit(" l=");
    e64(f2-(f2/8)*8);
    emit("\n");
  }
  if(nfrag>2){
    let f3:i32=ng(W,zm,32);
    emit("  frag3 m=");
    e64(f3/64);
    emit(" s=");
    e64((f3-(f3/64)*64)/8);
    emit(" l=");
    e64(f3-(f3/8)*8);
    emit("\n");
  }
  return;
}
fn ir_del_map_sr(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn ir_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  LINK14 ");
      e64(eg(W,e,0));
      emit(" -> ");
      e64(eg(W,e,8));
      emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ir_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// X: 4-link r1 chain. Y: 4-link r2 chain. Never shown together.
fn ir_trainXY(W:[]u8)void {
  ev_teach(W,11,1,12);
  ev_teach(W,12,1,13);
  ev_teach(W,13,1,14);
  ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,61,15,0);
  emit("X ans=");
  e64(x);
  emit("\n");
  ev_teach(W,21,2,22);
  ev_teach(W,22,2,23);
  ev_teach(W,23,2,24);
  ev_teach(W,24,2,25);
  let y:i32=ev_query(W,21,62,25,0);
  emit("Y ans=");
  e64(y);
  emit("\n");
  return;
}
// Train one more [1,1,1,1] MAP on a fresh subject (duplicate of X).
fn rt_trainXdup(W:[]u8,s0:i32)void {
  ev_teach(W,s0,1,s0+1);
  ev_teach(W,s0+1,1,s0+2);
  ev_teach(W,s0+2,1,s0+3);
  ev_teach(W,s0+3,1,s0+4);
  let x:i32=ev_query(W,s0,61,s0+4,0);
  emit("Xdup s0=");
  e64(s0);
  emit(" ans=");
  e64(x);
  emit("\n");
  ir_print_relseq(W,ir_find_map(W,s0,61));
  return;
}
fn ir_zfacts(W:[]u8)void {
  ev_teach(W,31,1,32);
  ev_teach(W,32,1,33);
  ev_teach(W,33,1,34);
  ev_teach(W,34,2,35);
  ev_teach(W,35,2,36);
  ev_teach(W,36,2,37);
  return;
}
fn ir_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,63,37,0);
  emit("Z ans=");
  e64(z);
  ir_tstat(W);
  let zm:i32=ir_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit(" link14=");
  e64(ir_count14(W));
  emit("\n");
  if(zm>=0){ir_print_relseq(W,zm);}
  ir_print_zfrags(W,zm);
  ir_dump14(W);
  return;
}
fn ir_zreuse(W:[]u8)void {
  ev_teach(W,41,1,42);
  ev_teach(W,42,1,43);
  ev_teach(W,43,1,44);
  ev_teach(W,44,2,45);
  ev_teach(W,45,2,46);
  ev_teach(W,46,2,47);
  let z2:i32=ev_query(W,41,63,47,0);
  emit("Z2 ans=");
  e64(z2);
  ir_tstat(W);
  emit("maps=");
  e64(ir_count_maps(W));
  emit(" link14=");
  e64(ir_count14(W));
  emit("\n");
  return;
}
// Candidate-count probe: how many fragments are satisfiable from s.
fn rt_candcount(W:[]u8,s:i32)void {
  let cb:[]u8=z_alloc(1296);
  let ub:[]u8=z_alloc(36);
  let n0:i32=ir_frag_candidates(W,s,ub,0,cb,0);
  emit("CANDCOUNT s=");
  e64(s);
  emit(" n0=");
  e64(n0);
  emit("\n");
  return;
}
// ---- A1: spurious fragments ----
// Distractor MAP D2=[1,1,2,9] (plen 5 values, so rebind cannot touch it:
// the only 5-value gathered path from 31 walks to 35, not 37). Distractor
// facts are taught BEFORE the Z facts so first-match lookup prefers them,
// which also breaks the original (45,0,3) path. The only verifying chain
// is the spurious (D2,0,3)=[1,1,2] fragment. Trial cannot reach it on the
// frag binary path (rebind fails first); on the nc binary trial may.
fn rt_a1(W:[]u8)void {
  emit("=== A1 SPURIOUS ===\n");
  ir_trainXY(W);
  ev_teach(W,51,1,52);
  ev_teach(W,52,1,53);
  ev_teach(W,53,2,54);
  ev_teach(W,54,9,55);
  let d:i32=ev_query(W,51,64,55,0);
  emit("D2 ans=");
  e64(d);
  emit("\n");
  ir_print_relseq(W,ir_find_map(W,51,64));
  // Distractor facts FIRST so first-match lookup prefers them, then Z facts.
  ev_teach(W,31,1,38);
  ev_teach(W,38,1,39);
  ev_teach(W,39,2,37);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
// ---- A2: duplicate-fragment ablation ----
fn rt_a2(W:[]u8)void {
  emit("=== A2 DUP-ABL ===\n");
  ir_trainXY(W);
  rt_trainXdup(W,71);
  emit("maps=");
  e64(ir_count_maps(W));
  emit("\n");
  ir_del_map_sr(W,11,61);
  emit("maps after del11=");
  e64(ir_count_maps(W));
  emit("\n");
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
// ---- A3: degenerate single-fragment reuse ----
fn rt_a3(W:[]u8)void {
  emit("=== A3 SINGLE ===\n");
  ir_trainXY(W);
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  ir_zreuse(W);
  return;
}
// ---- A5: three proper fragments ----
fn rt_a5(W:[]u8)void {
  emit("=== A5 THREEFRAG ===\n");
  ir_trainXY(W);
  ir_gap(W);
  ev_teach(W,31,1,32);
  ev_teach(W,32,1,33);
  ev_teach(W,33,1,34);
  ev_teach(W,34,2,35);
  ev_teach(W,35,2,36);
  ev_teach(W,36,2,37);
  ev_teach(W,37,1,38);
  ev_teach(W,38,1,39);
  ev_teach(W,39,1,40);
  rt_candcount(W,31);
  let z:i32=ev_query(W,31,63,40,0);
  emit("Z ans=");
  e64(z);
  ir_tstat(W);
  let zm:i32=ir_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit("\n");
  if(zm>=0){ir_print_relseq(W,zm);}
  ir_print_zfrags(W,zm);
  ir_dump14(W);
  return;
}
// ---- A4c: control, 12-link chain, ONE MAP ----
fn rt_a4c(W:[]u8)void {
  emit("=== A4c CONTROL-1MAP ===\n");
  rt_trainXdup(W,11);
  let i:i32=31;
  while(i<43){
    ev_teach(W,i,1,i+1);
    i=i+1;
  }
  rt_candcount(W,31);
  let z:i32=ev_query(W,31,63,43,0);
  emit("Z ans=");
  e64(z);
  ir_tstat(W);
  let zm:i32=ir_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit("\n");
  if(zm>=0){ir_print_relseq(W,zm);}
  ir_print_zfrags(W,zm);
  return;
}
// ---- A4: overflow, 12-link chain, FOUR duplicate MAPs ----
fn rt_a4(W:[]u8)void {
  emit("=== A4 OVERFLOW-4MAP ===\n");
  rt_trainXdup(W,11);
  rt_trainXdup(W,71);
  rt_trainXdup(W,81);
  rt_trainXdup(W,91);
  emit("maps=");
  e64(ir_count_maps(W));
  emit("\n");
  let i:i32=31;
  while(i<43){
    ev_teach(W,i,1,i+1);
    i=i+1;
  }
  rt_candcount(W,31);
  let z:i32=ev_query(W,31,63,43,0);
  emit("Z ans=");
  e64(z);
  ir_tstat(W);
  let zm:i32=ir_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit("\n");
  if(zm>=0){ir_print_relseq(W,zm);}
  ir_print_zfrags(W,zm);
  return;
}
fn main()i32 {
  emit("RT-H2-START\n");
  emit("frag_on=");
  e64(frag_on());
  emit("\n");
  let W1:[]u8=z_alloc(110656);
  tnn2_init(W1);
  rt_a1(W1);
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  rt_a2(W2);
  let W3:[]u8=z_alloc(110656);
  tnn2_init(W3);
  rt_a3(W3);
  let W5:[]u8=z_alloc(110656);
  tnn2_init(W5);
  rt_a5(W5);
  let W4c:[]u8=z_alloc(110656);
  tnn2_init(W4c);
  rt_a4c(W4c);
  let W4:[]u8=z_alloc(110656);
  tnn2_init(W4);
  rt_a4(W4);
  emit("RT-H2-END\n");
  return 0;
}

// hyp_c2.zag -- Hypothesis C2: Counterexample-Driven Growth with Non-Myopic Repair.
// Pure Zag. No Python anywhere.
//
// Amends C1 (falsified, aae06bac6) per design e658766bd, prereg 01336fe83,
// and v2 amendment 9bc64e4cf (Battery v2: GENEXEC2-P for T1/T4/T5).
//
// v2 changes:
//  - T1/T4/T5 use GENEXEC2-P (no DIV, MOD, LT, EQ, GT in repair alphabet).
//  - Repair alphabet: 29 symbols (P-VM) vs 34 symbols (full VM).
//  - Probes remain full-VM (meta-level, v2 sec 3.3).
//  - v2-SOLVE: train exact + ops <= 40. F-SMUG audit included.
//  - F-TRICK kill switch: straight-line P-VM solve voids task.
//
// Changes from C1 (v1):
//  1. Lookahead repair: op sequences of length 1..3 (L=3 frozen), two-phase
//     evaluation, argmax by (pass count desc, length asc, lex asc).
//  2. Net-progress criterion: fix e AND strictly increase pass count
//     (replaces no-breakage).
//  3. Chronological backtracking with (prefix, extension) tabu, BMAX=6.
//  4. Split fires on stagnation from best_P (not current P).
// Split operator, probe family, VM, episodes unchanged from C1.
// Battery v2: T0-T5. T6 sealed (skipped).
//
// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn nl()void { emit("\n"); return; }

// ============ program representation ============
// Program is []u8: bytes 0..3 = len (i32), then len*8 bytes of (op:i32, arg:i32).
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_set_len(p:[]u8, l:i32)void { set32(p, 0, l); return; }
fn prog_op(p:[]u8, i:i32)i32 { return get32(p, 4+i*8); }
fn prog_arg(p:[]u8, i:i32)i32 { return get32(p, 4+i*8+4); }
fn prog_set(p:[]u8, i:i32, op:i32, arg:i32)void {
  set32(p, 4+i*8, op); set32(p, 4+i*8+4, arg); return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}
fn prog_copy(dst:[]u8, src:[]u8)void {
  let l:i32=prog_len(src);
  prog_set_len(dst, l);
  let i:i32=0;
  while(i<l){ prog_set(dst, i, prog_op(src,i), prog_arg(src,i)); i=i+1; }
  return;
}
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=prog_len(p);
  prog_set(p, l, op, arg);
  prog_set_len(p, l+1);
  return;
}
// Compare two programs for equality (op/arg). Returns 1 if equal.
fn prog_eq(a:[]u8, b:[]u8)i32 {
  let la:i32=prog_len(a); let lb:i32=prog_len(b);
  if(la!=lb){ return 0; }
  let i:i32=0;
  while(i<la){
    if(prog_op(a,i)!=prog_op(b,i)){ return 0; }
    if(prog_arg(a,i)!=prog_arg(b,i)){ return 0; }
    i=i+1;
  }
  return 1;
}

// ============ VM (from GENEXEC2 8d5f58b89, frozen) ============
fn mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a - (a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}
fn vm_run(p:[]u8, pl:i32, in0:i32, in1:i32, stack:[]u8)i32 {
  let sp:i32=0;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    if(pc<0 || pc>=pl){ break; }
    let op:i32=prog_op(p, pc);
    let arg:i32=prog_arg(p, pc);
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack, sp*4, arg); sp=sp+1; }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack, sp*4, in0); sp=sp+1; }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack, sp*4, in1); sp=sp+1; }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a+b); sp=sp+1; }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a-b); sp=sp+1; }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a*b); sp=sp+1; }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==7){ // MOD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==8){ // NEG
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); }
    } else if(op==9){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==10){ // DROP
      if(sp>=1){ sp=sp-1; }
    } else if(op==11){ // SWAP
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); }
    } else if(op==12){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==13){ // LT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a<b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==14){ // EQ
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a==b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==15){ // GT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a>b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==16){ // JZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a==0){pc=arg;} }
    } else if(op==17){ // JNZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a!=0){pc=arg;} }
    } else if(op==18){ // JMP
      pc=arg;
    }
  }
  if(sp>0){ return get32(stack, (sp-1)*4); }
  return 0;
}

// ============ op alphabet (frozen) ============
// Full VM: 34 symbols.
// Order: IN0, IN1, PUSH -9..9, ADD, SUB, MUL, DIV, MOD, NEG, DUP, DROP,
//        SWAP, OVER, LT, EQ, GT.
fn alpha_op_full(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i>=2 && i<=20){ return 0; }
  if(i==21){ return 3; }
  if(i==22){ return 4; }
  if(i==23){ return 5; }
  if(i==24){ return 6; }
  if(i==25){ return 7; }
  if(i==26){ return 8; }
  if(i==27){ return 9; }
  if(i==28){ return 10; }
  if(i==29){ return 11; }
  if(i==30){ return 12; }
  if(i==31){ return 13; }
  if(i==32){ return 14; }
  return 15;
}
fn alpha_arg_full(i:i32)i32 {
  if(i>=2 && i<=20){ return i-11; }
  return 0;
}
// GENEXEC2-P: 29 symbols (DIV, MOD, LT, EQ, GT removed).
// Order: IN0, IN1, PUSH -9..9, ADD, SUB, MUL, NEG, DUP, DROP, SWAP, OVER.
fn alpha_op_pvm(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i>=2 && i<=20){ return 0; }
  if(i==21){ return 3; }
  if(i==22){ return 4; }
  if(i==23){ return 5; }
  if(i==24){ return 8; }
  if(i==25){ return 9; }
  if(i==26){ return 10; }
  if(i==27){ return 11; }
  return 12;
}
fn alpha_arg_pvm(i:i32)i32 {
  if(i>=2 && i<=20){ return i-11; }
  return 0;
}
// Dispatcher: pvm=1 for GENEXEC2-P, 0 for full.
fn alpha_op(i:i32, pvm:i32)i32 {
  if(pvm==1){ return alpha_op_pvm(i); }
  return alpha_op_full(i);
}
fn alpha_arg(i:i32, pvm:i32)i32 {
  if(pvm==1){ return alpha_arg_pvm(i); }
  return alpha_arg_full(i);
}
fn alpha_size(task:i32)i32 {
  // T1, T4, T5 use GENEXEC2-P (29 symbols). T0, T2, T3 use full (34).
  if(task==1){ return 29; }
  if(task==4){ return 29; }
  if(task==5){ return 29; }
  return 34;
}
fn task_pvm(task:i32)i32 {
  if(task==1){ return 1; }
  if(task==4){ return 1; }
  if(task==5){ return 1; }
  return 0;
}
fn op_name(op:i32, arg:i32)void {
  if(op==0){ emit("PUSH "); e64(arg); return; }
  if(op==1){ emit("IN0"); return; }
  if(op==2){ emit("IN1"); return; }
  if(op==3){ emit("ADD"); return; }
  if(op==4){ emit("SUB"); return; }
  if(op==5){ emit("MUL"); return; }
  if(op==6){ emit("DIV"); return; }
  if(op==7){ emit("MOD"); return; }
  if(op==8){ emit("NEG"); return; }
  if(op==9){ emit("DUP"); return; }
  if(op==10){ emit("DROP"); return; }
  if(op==11){ emit("SWAP"); return; }
  if(op==12){ emit("OVER"); return; }
  if(op==13){ emit("LT"); return; }
  if(op==14){ emit("EQ"); return; }
  if(op==15){ emit("GT"); return; }
  emit("?"); return;
}

// ============ task episodes ============
// Task IDs: 0=T0 2x+1, 1=T1 abs, 2=T2 mod3, 3=T3 parity, 4=T4 nested abs, 5=T5 fragcomp.
fn task_n_eps(task:i32)i32 {
  if(task==0){ return 9; }
  if(task==1){ return 17; }
  if(task==2){ return 17; }
  if(task==3){ return 25; }
  if(task==4){ return 13; }
  if(task==5){ return 13; }
  return 0;
}
fn task_in0(task:i32, i:i32)i32 {
  if(task==0){ return i; }
  if(task==1){ return i-8; }
  if(task==2){ return i; }
  if(task==3){ return i/5; }
  if(task==4){ return i-6; }
  if(task==5){ return i-4; }
  return 0;
}
fn task_in1(task:i32, i:i32)i32 {
  if(task==3){ let a:i32=i/5; return i-(a*5); }
  return 0;
}
fn task_tgt(task:i32, i:i32)i32 {
  if(task==0){ let x:i32=i; return 2*x+1; }
  if(task==1){ let x:i32=i-8; if(x<0){return -x;} return x; }
  if(task==2){ let x:i32=i; return mod_nonneg(x,3); }
  if(task==3){ let a:i32=i/5; let b:i32=i-(a*5); if(mod_nonneg(a+b,2)==0){return 1;} return 0; }
  if(task==4){ let x:i32=i-6; let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} return d; }
  if(task==5){ let x:i32=i-4; let ax:i32=x; if(ax<0){ax=-ax;} let bx:i32=x-2; if(bx<0){bx=-bx;} return ax+bx; }
  return 0;
}
// Held-out episodes (battery prereg section 2). For reporting only.
fn held_n_eps(task:i32)i32 {
  if(task==0){ return 16; }
  if(task==1){ return 8; }
  if(task==2){ return 17; }
  if(task==3){ return 39; }
  if(task==4){ return 8; }
  if(task==5){ return 8; }
  return 0;
}
fn held_in0(task:i32, i:i32)i32 {
  if(task==0){ if(i<8){ return -8+i; } return 9+(i-8); }
  if(task==1){ if(i<4){ return -12+i; } return 9+(i-4); }
  if(task==2){ return 17+i; }
  if(task==3){
    // a,b in 0..7 excluding 0..4 square. Enumerate 64, skip 25.
    let a:i32=0; let cnt:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a>4 || b>4){
          if(cnt==i){ return a; }
          cnt=cnt+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    return 0;
  }
  if(task==4){ if(i<4){ return -10+i; } return 7+(i-4); }
  if(task==5){ if(i<4){ return -8+i; } return 9+(i-4); }
  return 0;
}
fn held_in1(task:i32, i:i32)i32 {
  if(task==3){
    let a:i32=0; let cnt:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a>4 || b>4){
          if(cnt==i){ return b; }
          cnt=cnt+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    return 0;
  }
  return 0;
}
fn held_tgt(task:i32, i:i32)i32 {
  if(task==0){ let x:i32=held_in0(task,i); return 2*x+1; }
  if(task==1){ let x:i32=held_in0(task,i); if(x<0){return -x;} return x; }
  if(task==2){ let x:i32=held_in0(task,i); return mod_nonneg(x,3); }
  if(task==3){
    let a:i32=held_in0(task,i); let b:i32=held_in1(task,i);
    if(mod_nonneg(a+b,2)==0){return 1;} return 0;
  }
  if(task==4){
    let x:i32=held_in0(task,i); let ax:i32=x; if(ax<0){ax=-ax;}
    let d:i32=ax-2; if(d<0){d=-d;} return d;
  }
  if(task==5){
    let x:i32=held_in0(task,i); let ax:i32=x; if(ax<0){ax=-ax;}
    let bx:i32=x-2; if(bx<0){bx=-bx;} return ax+bx;
  }
  return 0;
}

// ============ trace events ============
fn trace_repair(task:i32, ep_idx:i32, seq_op:[]u8, seq_arg:[]u8, slen:i32, c0:i32, c1:i32)void {
  emit("REPAIR t="); e64(task);
  emit(" ep="); e64(ep_idx);
  emit(" seq=[");
  let i:i32=0;
  while(i<slen){
    if(i>0){ emit(" "); }
    op_name(get32(seq_op,i*4), get32(seq_arg,i*4));
    i=i+1;
  }
  emit("] c0="); e64(c0);
  emit(" c1="); e64(c1);
  nl();
  return;
}
fn trace_backtrack(task:i32, seq_op:[]u8, seq_arg:[]u8, slen:i32, depth:i32, bt:i32)void {
  emit("BACKTRACK t="); e64(task);
  emit(" popped=[");
  let i:i32=0;
  while(i<slen){
    if(i>0){ emit(" "); }
    op_name(get32(seq_op,i*4), get32(seq_arg,i*4));
    i=i+1;
  }
  emit("] depth="); e64(depth);
  emit(" bt="); e64(bt);
  nl();
  return;
}
fn trace_split(task:i32, pin:i32, pk:i32, pcmp:i32, nleft:i32, nright:i32)void {
  emit("SPLIT t="); e64(task);
  emit(" probe=[IN"); e64(pin);
  emit(" PUSH "); e64(pk);
  emit(" ");
  if(pcmp==13){ emit("LT"); } else if(pcmp==14){ emit("EQ"); } else { emit("GT"); }
  emit("] nleft="); e64(nleft);
  emit(" nright="); e64(nright);
  nl();
  return;
}
fn trace_fail(task:i32, reason:[]u8)void {
  emit("FAIL t="); e64(task);
  emit(" reason="); emit(reason); nl();
  return;
}

// ============ counters ============
// cnt layout: 0=evals:i64, 8=repairs:i32, 12=splits:i32, 16=backtracks:i32.
// stack is a reusable 256*4 scratch buffer (caller-allocated to avoid OOM).
fn eval_one(p:[]u8, in0:i32, in1:i32, cnt:[]u8, stack:[]u8) i32 {
  let r:i32=vm_run(p, prog_len(p), in0, in1, stack);
  let e:i64=get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
  e=e+1;
  set32(cnt, 0, e as i32); set32(cnt, 4, (e>>32) as i32);
  return r;
}
fn cnt_repairs(cnt:[]u8)i32 { return get32(cnt, 8); }
fn cnt_splits(cnt:[]u8)i32 { return get32(cnt, 12); }
fn cnt_backtracks(cnt:[]u8)i32 { return get32(cnt, 16); }
fn cnt_incr_repairs(cnt:[]u8)void { set32(cnt, 8, get32(cnt,8)+1); return; }
fn cnt_incr_splits(cnt:[]u8)void { set32(cnt, 12, get32(cnt,12)+1); return; }
fn cnt_incr_backtracks(cnt:[]u8)void { set32(cnt, 16, get32(cnt,16)+1); return; }
fn cnt_evals(cnt:[]u8)i64 {
  return get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
}

// ============ probe evaluation ============
fn probe_eval(pin:i32, pk:i32, pcmp:i32, in0:i32, in1:i32)i32 {
  let v:i32=in0;
  if(pin==1){ v=in1; }
  if(pcmp==13){ if(v<pk){return 1;} return 0; }
  if(pcmp==14){ if(v==pk){return 1;} return 0; }
  if(v>pk){return 1;} return 0;
}

// ============ tabu and choice points ============
// Layout: cp_plen[i] at i*4, cp_pops[i] at i*200*8, cp_eops[i] at i*3*8.
// Max 32 choice points, max prefix 200 ops, max ext 3 ops.

fn tabu_check(P:[]u8, seq_op:[]u8, seq_arg:[]u8, slen:i32,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
              tabu_n:i32) i32 {
  let pl:i32=prog_len(P);
  let i:i32=0;
  while(i<tabu_n){
    let tpl:i32=get32(tb_plen, i*4);
    let tel:i32=get32(tb_elen, i*4);
    if(tpl==pl && tel==slen){
      let ok:i32=1;
      let j:i32=0;
      while(j<pl){
        if(prog_op(P,j)!=get32(tb_pops, i*200*8 + j*8)){ ok=0; break; }
        if(prog_arg(P,j)!=get32(tb_pops, i*200*8 + j*8 + 4)){ ok=0; break; }
        j=j+1;
      }
      if(ok==1){
        let k:i32=0;
        while(k<slen){
          if(get32(seq_op,k*4)!=get32(tb_eops, i*3*8 + k*8)){ ok=0; break; }
          if(get32(seq_arg,k*4)!=get32(tb_eops, i*3*8 + k*8 + 4)){ ok=0; break; }
          k=k+1;
        }
      }
      if(ok==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn cp_push(P:[]u8, seq_op:[]u8, seq_arg:[]u8, slen:i32,
           cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
           ncp:i32) void {
  let pl:i32=prog_len(P);
  set32(cp_plen, ncp*4, pl);
  set32(cp_elen, ncp*4, slen);
  let j:i32=0;
  while(j<pl){
    set32(cp_pops, ncp*200*8 + j*8, prog_op(P,j));
    set32(cp_pops, ncp*200*8 + j*8 + 4, prog_arg(P,j));
    j=j+1;
  }
  let k:i32=0;
  while(k<slen){
    set32(cp_eops, ncp*3*8 + k*8, get32(seq_op,k*4));
    set32(cp_eops, ncp*3*8 + k*8 + 4, get32(seq_arg,k*4));
    k=k+1;
  }
  return;
}
fn cp_restore(P:[]u8, cp_plen:[]u8, cp_pops:[]u8, i:i32) void {
  let pl:i32=get32(cp_plen, i*4);
  prog_set_len(P, pl);
  let j:i32=0;
  while(j<pl){
    prog_set(P, j, get32(cp_pops, i*200*8 + j*8), get32(cp_pops, i*200*8 + j*8 + 4));
    j=j+1;
  }
  return;
}
fn cp_get_ext(cp_elen:[]u8, cp_eops:[]u8, i:i32, seq_op:[]u8, seq_arg:[]u8) i32 {
  let slen:i32=get32(cp_elen, i*4);
  let k:i32=0;
  while(k<slen){
    set32(seq_op, k*4, get32(cp_eops, i*3*8 + k*8));
    set32(seq_arg, k*4, get32(cp_eops, i*3*8 + k*8 + 4));
    k=k+1;
  }
  return slen;
}
fn cp_to_tabu(cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8, cpi:i32,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8, tabu_n:i32) void {
  let pl:i32=get32(cp_plen, cpi*4);
  let el:i32=get32(cp_elen, cpi*4);
  set32(tb_plen, tabu_n*4, pl);
  set32(tb_elen, tabu_n*4, el);
  let j:i32=0;
  while(j<pl){
    set32(tb_pops, tabu_n*200*8 + j*8, get32(cp_pops, cpi*200*8 + j*8));
    set32(tb_pops, tabu_n*200*8 + j*8 + 4, get32(cp_pops, cpi*200*8 + j*8 + 4));
    j=j+1;
  }
  let k:i32=0;
  while(k<el){
    set32(tb_eops, tabu_n*3*8 + k*8, get32(cp_eops, cpi*3*8 + k*8));
    set32(tb_eops, tabu_n*3*8 + k*8 + 4, get32(cp_eops, cpi*3*8 + k*8 + 4));
    k=k+1;
  }
  return;
}

// ============ fix search (lookahead L=3, net-progress) ============
// Returns 1 if improving fix applied, 0 if none, -1 if budget exceeded.
// On 1: P extended, choice pushed, best_P updated if improved, REPAIR traced.
fn fix_search(task:i32, idx:[]u8, n:i32, P:[]u8, fe:i32, c:i32,
              cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
              best_P:[]u8, st:[]u8, cnt:[]u8, vstack:[]u8) i32 {
  let fin0:i32=task_in0(task, fe);
  let fin1:i32=task_in1(task, fe);
  let ftgt:i32=task_tgt(task, fe);
  let tabu_n:i32=get32(st, 4);
  let ncp:i32=get32(st, 0);
  let pvm:i32=task_pvm(task);
  let asz:i32=alpha_size(task);
  let asz2:i32=asz*asz;
  let asz3:i32=asz2*asz;

  let best_c:i32=-1;
  let best_l:i32=999;
  let best_seq_op:[]u8=z_alloc(3*4);
  let best_seq_arg:[]u8=z_alloc(3*4);
  let best_slen:i32=0;

  let cand:[]u8=prog_new(210);
  let so:[]u8=z_alloc(3*4);
  let sa:[]u8=z_alloc(3*4);

  let L:i32=1;
  while(L<=3){
    let total:i32=asz;
    if(L==2){ total=asz2; }
    if(L==3){ total=asz3; }
    let s:i32=0;
    while(s<total){
      if(cnt_evals(cnt)>1000000){ return -1; }
      let d0:i32=0; let d1:i32=0; let d2:i32=0;
      if(L==1){ d0=s; }
      if(L==2){ d0=s/asz; d1=s%asz; }
      if(L==3){ d0=s/asz2; d1=(s/asz)%asz; d2=s%asz; }
      set32(so, 0, alpha_op(d0, pvm)); set32(sa, 0, alpha_arg(d0, pvm));
      if(L>=2){ set32(so, 4, alpha_op(d1, pvm)); set32(sa, 4, alpha_arg(d1, pvm)); }
      if(L>=3){ set32(so, 8, alpha_op(d2, pvm)); set32(sa, 8, alpha_arg(d2, pvm)); }
      prog_copy(cand, P);
      let k:i32=0;
      while(k<L){
        prog_append(cand, get32(so,k*4), get32(sa,k*4));
        k=k+1;
      }
      // Phase 1: must fix e.
      if(eval_one(cand, fin0, fin1, cnt, vstack)==ftgt){
        // Tabu check.
        if(tabu_check(P, so, sa, L, tb_plen, tb_elen, tb_pops, tb_eops, tabu_n)==0){
          // Phase 2: count train episodes passed.
          let cntpass:i32=0;
          let j:i32=0;
          while(j<n){
            let ei:i32=get32(idx, j*4);
            let in0:i32=task_in0(task, ei);
            let in1:i32=task_in1(task, ei);
            let tgt:i32=task_tgt(task, ei);
            if(eval_one(cand, in0, in1, cnt, vstack)==tgt){ cntpass=cntpass+1; }
            j=j+1;
          }
          // Argmax: (count desc, length asc, lex asc). Lex is automatic
          // because enumeration is in lex order within each length.
          if(cntpass>best_c || (cntpass==best_c && L<best_l)){
            best_c=cntpass;
            best_l=L;
            best_slen=L;
            let m:i32=0;
            while(m<L){
              set32(best_seq_op, m*4, get32(so,m*4));
              set32(best_seq_arg, m*4, get32(sa,m*4));
              m=m+1;
            }
          }
        }
      }
      s=s+1;
    }
    L=L+1;
  }

  if(best_c>c){
    // Push choice point (prefix BEFORE append).
    cp_push(P, best_seq_op, best_seq_arg, best_slen,
            cp_plen, cp_elen, cp_pops, cp_eops, ncp);
    set32(st, 0, ncp+1);
    // Append to P.
    let k:i32=0;
    while(k<best_slen){
      prog_append(P, get32(best_seq_op,k*4), get32(best_seq_arg,k*4));
      k=k+1;
    }
    // Update best_P if improved.
    let bc:i32=get32(st, 12);
    if(best_c>bc){
      prog_copy(best_P, P);
      set32(st, 12, best_c);
    }
    cnt_incr_repairs(cnt);
    trace_repair(task, fe, best_seq_op, best_seq_arg, best_slen, c, best_c);
    return 1;
  }
  return 0;
}

// ============ the grow function (C2) ============
// Grows a program for the episode subset idx[0..n).
// Returns 1 on SOLVE, 0 on FAIL, -1 on budget exceeded.
// State per call: P, best_P/best_count, choice stack, tabu, backtracks_used.
fn grow(task:i32, idx:[]u8, n:i32, out_prog:[]u8, depth:i32, cnt:[]u8,
        cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
        tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
        best_P:[]u8, st:[]u8, vstack:[]u8) i32 {
  let P:[]u8=prog_new(200);
  prog_set_len(best_P, 0);
  set32(st, 0, 0);   // ncp
  set32(st, 4, 0);   // tabu_n
  set32(st, 8, 0);   // backtracks_used
  set32(st, 12, -1); // best_count

  let iter:i32=0;
  let fail_idx:[]u8=z_alloc(25*4);
  let pass_idx:[]u8=z_alloc(25*4);
  while(iter<1000){
    iter=iter+1;
    if(cnt_evals(cnt)>1000000){
      trace_fail(task, "budget exceeded");
      return -1;
    }
    // Evaluate P on all episodes in subset.
    let nfail:i32=0;
    let npass:i32=0;
    let i:i32=0;
    while(i<n){
      let ei:i32=get32(idx, i*4);
      let in0:i32=task_in0(task, ei);
      let in1:i32=task_in1(task, ei);
      let tgt:i32=task_tgt(task, ei);
      let out:i32=eval_one(P, in0, in1, cnt, vstack);
      if(out==tgt){
        set32(pass_idx, npass*4, ei); npass=npass+1;
      } else {
        set32(fail_idx, nfail*4, ei); nfail=nfail+1;
      }
      i=i+1;
    }
    if(nfail==0){
      prog_copy(out_prog, P);
      return 1;
    }
    // Update best_P if improved.
    let bc:i32=get32(st, 12);
    if(npass>bc){
      prog_copy(best_P, P);
      set32(st, 12, npass);
    }
    let fe:i32=get32(fail_idx, 0);
    // Try fix search (lookahead, net-progress).
    let fr:i32=fix_search(task, idx, n, P, fe, npass,
                          cp_plen, cp_elen, cp_pops, cp_eops,
                          tb_plen, tb_elen, tb_pops, tb_eops,
                          best_P, st, cnt, vstack);
    if(fr==-1){
      trace_fail(task, "budget exceeded");
      return -1;
    }
    if(fr==1){
      continue;
    }
    // No improving fix. Try chronological backtracking.
    let ncp:i32=get32(st, 0);
    let btu:i32=get32(st, 8);
    if(ncp>0 && btu<6){
      let cpi:i32=ncp-1;
      let seq_op:[]u8=z_alloc(3*4);
      let seq_arg:[]u8=z_alloc(3*4);
      let slen:i32=cp_get_ext(cp_elen, cp_eops, cpi, seq_op, seq_arg);
      let tabu_n:i32=get32(st, 4);
      cp_to_tabu(cp_plen, cp_elen, cp_pops, cp_eops, cpi,
                 tb_plen, tb_elen, tb_pops, tb_eops, tabu_n);
      set32(st, 4, tabu_n+1);
      cp_restore(P, cp_plen, cp_pops, cpi);
      set32(st, 0, cpi);
      set32(st, 8, btu+1);
      cnt_incr_backtracks(cnt);
      trace_backtrack(task, seq_op, seq_arg, slen, cpi, btu+1);
      continue;
    }
    // Stagnation: split from best_P.
    // Find first probe from frozen family with episodes on both sides.
    let found:i32=0;
    let spin:i32=0; let spk:i32=0; let spcmp:i32=0;
    let left_idx:[]u8=z_alloc(25*4);
    let right_idx:[]u8=z_alloc(25*4);
    let nl:i32=0; let nr:i32=0;
    let pin:i32=0;
    while(pin<=1){
      if(found==1){ break; }
      let k:i32=-4;
      while(k<=4){
        if(found==1){ break; }
        let cmp:i32=13;
        while(cmp<=15){
          if(found==1){ break; }
          nl=0; nr=0;
          let j:i32=0;
          while(j<n){
            let ei:i32=get32(idx, j*4);
            let in0:i32=task_in0(task, ei);
            let in1:i32=task_in1(task, ei);
            if(probe_eval(pin, k, cmp, in0, in1)==1){
              set32(left_idx, nl*4, ei); nl=nl+1;
            } else {
              set32(right_idx, nr*4, ei); nr=nr+1;
            }
            j=j+1;
          }
          if(nl>0 && nr>0){
            found=1; spin=pin; spk=k; spcmp=cmp;
          }
          cmp=cmp+1;
        }
        k=k+1;
      }
      pin=pin+1;
    }
    if(found==0){
      trace_fail(task, "no probe separates");
      return 0;
    }
    cnt_incr_splits(cnt);
    trace_split(task, spin, spk, spcmp, nl, nr);
    // Recursively grow each branch with fresh state.
    let left_prog:[]u8=prog_new(500);
    let right_prog:[]u8=prog_new(500);
    let r1_cpl:[]u8=z_alloc(32*4); let r1_cel:[]u8=z_alloc(32*4);
    let r1_cpo:[]u8=z_alloc(32*200*8); let r1_ceo:[]u8=z_alloc(32*3*8);
    let r1_tbl:[]u8=z_alloc(32*4); let r1_tel:[]u8=z_alloc(32*4);
    let r1_tbo:[]u8=z_alloc(32*200*8); let r1_teo:[]u8=z_alloc(32*3*8);
    let r1_best:[]u8=prog_new(200); let r1_st:[]u8=z_alloc(16);
    let lok:i32=grow(task, left_idx, nl, left_prog, depth+1, cnt,
                     r1_cpl, r1_cel, r1_cpo, r1_ceo,
                     r1_tbl, r1_tel, r1_tbo, r1_teo,
                     r1_best, r1_st, vstack);
    if(lok!=1){ return lok; }
    let r2_cpl:[]u8=z_alloc(32*4); let r2_cel:[]u8=z_alloc(32*4);
    let r2_cpo:[]u8=z_alloc(32*200*8); let r2_ceo:[]u8=z_alloc(32*3*8);
    let r2_tbl:[]u8=z_alloc(32*4); let r2_tel:[]u8=z_alloc(32*4);
    let r2_tbo:[]u8=z_alloc(32*200*8); let r2_teo:[]u8=z_alloc(32*3*8);
    let r2_best:[]u8=prog_new(200); let r2_st:[]u8=z_alloc(16);
    let rok:i32=grow(task, right_idx, nr, right_prog, depth+1, cnt,
                     r2_cpl, r2_cel, r2_cpo, r2_ceo,
                     r2_tbl, r2_tel, r2_tbo, r2_teo,
                     r2_best, r2_st, vstack);
    if(rok!=1){ return rok; }
    // Compile: best_P + probe + JZ + left + JMP + right.
    let comp:[]u8=prog_new(500);
    prog_copy(comp, best_P);
    let pin_op:i32=1+spin;
    prog_append(comp, pin_op, 0);
    prog_append(comp, 0, spk);
    prog_append(comp, spcmp, 0);
    let jz_pos:i32=prog_len(comp);
    prog_append(comp, 16, 0);
    let li:i32=0;
    while(li<prog_len(left_prog)){
      prog_append(comp, prog_op(left_prog, li), prog_arg(left_prog, li));
      li=li+1;
    }
    let jmp_pos:i32=prog_len(comp);
    prog_append(comp, 18, 0);
    let right_start:i32=prog_len(comp);
    let ri:i32=0;
    while(ri<prog_len(right_prog)){
      prog_append(comp, prog_op(right_prog, ri), prog_arg(right_prog, ri));
      ri=ri+1;
    }
    let end_pos:i32=prog_len(comp);
    prog_set(comp, jz_pos, 16, right_start);
    prog_set(comp, jmp_pos, 18, end_pos);
    prog_copy(out_prog, comp);
    return 1;
  }
  trace_fail(task, "iteration limit");
  return 0;
}

// ============ main ============
fn count_calls(p:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<prog_len(p)){
    if(prog_op(p,i)==19){ c=c+1; }
    i=i+1;
  }
  return c;
}
// F-SMUG audit (v2 sec 3.6): on P-VM tasks, region bodies must not contain
// DIV(6) or MOD(7). LT/EQ/GT are allowed as probe dispatch per v2 sec 3.3
// (meta-level partition classifiers). Returns 1 PASS, 0 FAIL.
fn audit_fsmug(p:[]u8, task:i32)i32 {
  if(task_pvm(task)==0){ return 1; }
  let i:i32=0;
  while(i<prog_len(p)){
    let op:i32=prog_op(p,i);
    if(op==6){ return 0; }
    if(op==7){ return 0; }
    i=i+1;
  }
  return 1;
}
fn main()void {
  emit("HYPOTHESIS C2: Counterexample-Driven Growth with Non-Myopic Repair\n");
  emit("Battery prereg: 425f7276d. C2 design: e658766bd. C2 prereg: 01336fe83.\n");
  emit("Seed: 0xC2C2C2. Bounds: L=3, BMAX=6, budget 1M evals.\n");
  let task:i32=0;
  while(task<=5){
    emit("=== TASK T"); e64(task); emit(" ===\n");
    let n:i32=task_n_eps(task);
    let idx:[]u8=z_alloc(n*4);
    let i:i32=0;
    while(i<n){ set32(idx, i*4, i); i=i+1; }
    let prog:[]u8=prog_new(500);
    let cnt:[]u8=z_alloc(20);
    set32(cnt,0,0); set32(cnt,4,0); set32(cnt,8,0); set32(cnt,12,0); set32(cnt,16,0);
    let cp_plen:[]u8=z_alloc(32*4); let cp_elen:[]u8=z_alloc(32*4);
    let cp_pops:[]u8=z_alloc(32*200*8); let cp_eops:[]u8=z_alloc(32*3*8);
    let tb_plen:[]u8=z_alloc(32*4); let tb_elen:[]u8=z_alloc(32*4);
    let tb_pops:[]u8=z_alloc(32*200*8); let tb_eops:[]u8=z_alloc(32*3*8);
    let best_P:[]u8=prog_new(200);
    let st:[]u8=z_alloc(16);
    let vstack:[]u8=z_alloc(256*4);
    let ok:i32=grow(task, idx, n, prog, 0, cnt,
                    cp_plen, cp_elen, cp_pops, cp_eops,
                    tb_plen, tb_elen, tb_pops, tb_eops,
                    best_P, st, vstack);
    emit("RESULT t="); e64(task);
    if(ok==1){
      // v2-SOLVE requires ops <= 40 (F-MEM).
      if(prog_len(prog)>40){
        emit(" MEM-FAIL");
      } else {
        emit(" SOLVE");
      }
    } else if(ok==-1){ emit(" BUDGET"); } else { emit(" FAIL"); }
    emit(" len="); e64(prog_len(prog));
    emit(" evals="); emit(i64s(cnt_evals(cnt)));
    emit(" repairs="); e64(cnt_repairs(cnt));
    emit(" backtracks="); e64(cnt_backtracks(cnt));
    emit(" splits="); e64(cnt_splits(cnt));
    emit(" calls="); e64(count_calls(prog));
    emit(" fsmug="); e64(audit_fsmug(prog, task));
    emit(" vm=");
    if(task_pvm(task)==1){ emit("P"); } else { emit("full"); }
    nl();
    emit("PROG");
    let j:i32=0;
    while(j<prog_len(prog)){
      emit(" ("); e64(prog_op(prog,j)); emit(","); e64(prog_arg(prog,j)); emit(")");
      j=j+1;
    }
    nl();
    // Verify on train.
    let nhit:i32=0;
    let k:i32=0;
    while(k<n){
      let in0:i32=task_in0(task, k); let in1:i32=task_in1(task, k); let tgt:i32=task_tgt(task, k);
      if(eval_one(prog, in0, in1, cnt, vstack)==tgt){ nhit=nhit+1; }
      k=k+1;
    }
    let ev:i64=cnt_evals(cnt);
    ev=ev-(n as i64);
    set32(cnt, 0, ev as i32); set32(cnt, 4, (ev>>32) as i32);
    emit("VERIFY train "); e64(nhit); emit("/"); e64(n); nl();
    // Held-out accuracy (reporting only, not part of SOLVE).
    let hn:i32=held_n_eps(task);
    let hhit:i32=0;
    let h:i32=0;
    while(h<hn){
      let in0:i32=held_in0(task, h); let in1:i32=held_in1(task, h); let tgt:i32=held_tgt(task, h);
      if(eval_one(prog, in0, in1, cnt, vstack)==tgt){ hhit=hhit+1; }
      h=h+1;
    }
    let ev2:i64=cnt_evals(cnt);
    ev2=ev2-(hn as i64);
    set32(cnt, 0, ev2 as i32); set32(cnt, 4, (ev2>>32) as i32);
    emit("HELDOUT "); e64(hhit); emit("/"); e64(hn); nl();
    task=task+1;
  }
  emit("DONE\n");
  return;
}

// ivwc_ksensitivity.zag -- the K-sensitivity curve.
// Follow-up to IVWC-LEARNERK (BUILD-PASS K1-K10), which named this
// curve as the remaining frontier and did not test it.
// Measurement wave on committed tables: no world, no learner, no new
// mechanism. The sealed (adjucb, eff) per-case tables are frozen data
// from the IVWC lineage (see PREREG.md); this binary sweeps over them.
// TABLE A: for each integer decision bar K in [-3,85] (data-driven:
// [min sealed adj - 1, max sealed adj + 1]), the fixed-bar verdict
// GO iff adjucb > K on the three sealed batches, scored at the frozen
// world cost 15 (profit = sum over GO of (eff - 15)).
// TABLE B: for each hypothetical train cost c in [-3,40], the
// LEARNERK global revealed bar b*(c) = argmax over integer b in
// [-11,84] of P_c(b) = sum over train cases with tadj > b of
// (teff - c), ties toward the larger bar (the frozen LEARNERK rule),
// scored on sealed batches at the true world cost 15.
// In-program kill flags KS3-KS7 check the frozen predictions.
// KS1 (diet) is a pre-build textual audit; KS2 is 3/3 byte-identical
// runs. Pure Zag, deterministic, integer arithmetic only.

// ---------- helpers (u8-backed cells, little-endian; lineage idiom) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---------- committed tables (verbatim from the IVWC-LEARNERK PREREG) ----------
// Train: t=0..23. b0 (t=0..6) is all (0,0,0) and needs no stores
// (z_alloc zeroes). b1: t=7..13, b2: t=14..20, b3: t=21..23.
fn fill_train(tadj:[]u8, teff:[]u8, tbkt:[]u8)void {
  set32(tadj,28,34); set32(teff,28,50); set32(tbkt,28,1);
  set32(tadj,32,17); set32(teff,32,33); set32(tbkt,32,1);
  set32(tadj,36,84); set32(teff,36,100); set32(tbkt,36,1);
  set32(tadj,40,34); set32(teff,40,50); set32(tbkt,40,1);
  set32(tadj,44,34); set32(teff,44,50); set32(tbkt,44,1);
  set32(tadj,48,34); set32(teff,48,50); set32(tbkt,48,1);
  set32(tadj,52,17); set32(teff,52,0); set32(tbkt,52,1);
  set32(tadj,56,-9); set32(teff,56,6); set32(tbkt,56,2);
  set32(tadj,60,23); set32(teff,60,25); set32(tbkt,60,2);
  set32(tadj,64,-10); set32(teff,64,0); set32(tbkt,64,2);
  set32(tadj,68,6); set32(teff,68,33); set32(tbkt,68,2);
  set32(tadj,72,15); set32(teff,72,42); set32(tbkt,72,2);
  set32(tadj,76,6); set32(teff,76,0); set32(tbkt,76,2);
  set32(tadj,80,0); set32(teff,80,9); set32(tbkt,80,2);
  set32(tadj,84,5); set32(teff,84,5); set32(tbkt,84,3);
  set32(tadj,88,7); set32(teff,88,16); set32(tbkt,88,3);
  set32(tadj,92,9); set32(teff,92,11); set32(tbkt,92,3);
  return;
}
// Sealed: flat index i = sh*12+s, sh=0..2, s=0..11. All-zero cases
// need no stores (z_alloc zeroes).
fn fill_sealed(sadj:[]u8, seff:[]u8, sbkt:[]u8)void {
  set32(sbkt,0,2); set32(sadj,0,13); set32(seff,0,0);
  set32(sbkt,8,1); set32(sadj,8,17); set32(seff,8,33);
  set32(sbkt,12,1); set32(sadj,12,34); set32(seff,12,0);
  set32(sbkt,16,1); set32(sadj,16,17); set32(seff,16,33);
  set32(sbkt,20,3); set32(sadj,20,24); set32(seff,20,33);
  set32(sbkt,24,3); set32(sadj,24,6); set32(seff,24,20);
  set32(sbkt,28,1); set32(sadj,28,17); set32(seff,28,33);
  set32(sbkt,36,1); set32(sadj,36,17); set32(seff,36,33);
  set32(sbkt,40,1); set32(sadj,40,9); set32(seff,40,25);
  set32(sbkt,44,3); set32(sadj,44,2); set32(seff,44,13);
  set32(sbkt,48,3); set32(sadj,48,30); set32(seff,48,10);
  set32(sbkt,56,1); set32(sadj,56,17); set32(seff,56,33);
  set32(sbkt,60,1); set32(sadj,60,34); set32(seff,60,50);
  set32(sbkt,64,1); set32(sadj,64,34); set32(seff,64,50);
  set32(sbkt,68,3); set32(sadj,68,20); set32(seff,68,30);
  set32(sbkt,72,1); set32(sadj,72,34); set32(seff,72,0);
  set32(sbkt,76,2); set32(sadj,76,23); set32(seff,76,25);
  set32(sbkt,80,1); set32(sadj,80,34); set32(seff,80,50);
  set32(sbkt,88,1); set32(sadj,88,9); set32(seff,88,25);
  set32(sbkt,92,3); set32(sadj,92,5); set32(seff,92,20);
  set32(sbkt,96,1); set32(sadj,96,34); set32(seff,96,0);
  set32(sbkt,108,2); set32(sadj,108,-2); set32(seff,108,0);
  set32(sbkt,112,1); set32(sadj,112,34); set32(seff,112,0);
  set32(sbkt,116,3); set32(sadj,116,13); set32(seff,116,0);
  set32(sbkt,140,1); set32(sadj,140,84); set32(seff,140,100);
  return;
}

// ===== MAIN: the K-sensitivity curve =====
fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCKS-BEGIN\n");
  let tadj:[]u8=z_alloc(96);
  let teff:[]u8=z_alloc(96);
  let tbkt:[]u8=z_alloc(96);
  let sadj:[]u8=z_alloc(144);
  let seff:[]u8=z_alloc(144);
  let sbkt:[]u8=z_alloc(144);
  let p0A:[]u8=z_alloc(356);
  let p1A:[]u8=z_alloc(356);
  let p2A:[]u8=z_alloc(356);
  let totA:[]u8=z_alloc(356);
  let go14:[]u8=z_alloc(144);
  let go15:[]u8=z_alloc(144);
  let bstar:[]u8=z_alloc(176);
  // PHASE: TABLES
  fill_train(tadj, teff, tbkt);
  fill_sealed(sadj, seff, sbkt);
  // PHASE: TAUDIT
  at=ob_app(ob,at,"TAUDIT-T t bkt adj teff\n");
  let t:i32=0;
  while(t<24){
    at=ob_app(ob,at,"T ");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,get32(tbkt,4*t));
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,get32(tadj,4*t));
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_nl(ob,at);
    t=t+1;
  }
  at=ob_app(ob,at,"TAUDIT-S sh s bkt adj eff\n");
  let sh:i32=0;
  while(sh<3){
    let s:i32=0;
    while(s<12){
      let i:i32=sh*12+s;
      at=ob_app(ob,at,"S ");
      at=ob_i32(ob,at,sh);
      at=ob_app(ob,at," ");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," ");
      at=ob_i32(ob,at,get32(sbkt,4*i));
      at=ob_app(ob,at," ");
      at=ob_i32(ob,at,get32(sadj,4*i));
      at=ob_app(ob,at," ");
      at=ob_i32(ob,at,get32(seff,4*i));
      at=ob_nl(ob,at);
      s=s+1;
    }
    sh=sh+1;
  }
  // PHASE: SWEEPA (decision-bar sweep, K in [-3,85]).
  at=ob_app(ob,at,"SWEEPA K p0 p1 p2 tot g0 g1 g2\n");
  let K:i32=-3;
  while(K<=85){
    let pp0:i32=0; let pp1:i32=0; let pp2:i32=0;
    let gg0:i32=0; let gg1:i32=0; let gg2:i32=0;
    sh=0;
    while(sh<3){
      let profit:i32=0;
      let go:i32=0;
      s=0;
      while(s<12){
        let i:i32=sh*12+s;
        if(get32(sadj,4*i)>K){
          profit=profit+get32(seff,4*i)-15;
          go=go+1;
          if(K==14){ set32(go14,4*i,1); }
          if(K==15){ set32(go15,4*i,1); }
        }
        s=s+1;
      }
      if(sh==0){ pp0=profit; gg0=go; }
      if(sh==1){ pp1=profit; gg1=go; }
      if(sh==2){ pp2=profit; gg2=go; }
      sh=sh+1;
    }
    set32(p0A,4*(K+3),pp0);
    set32(p1A,4*(K+3),pp1);
    set32(p2A,4*(K+3),pp2);
    set32(totA,4*(K+3),pp0+pp1+pp2);
    at=ob_app(ob,at,"A ");
    at=ob_i32(ob,at,K);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,pp0);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,pp1);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,pp2);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,pp0+pp1+pp2);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,gg0);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,gg1);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,gg2);
    at=ob_nl(ob,at);
    K=K+1;
  }
  // PHASE: SWEEPB (revealed bar at hypothetical train cost c).
  at=ob_app(ob,at,"SWEEPB c bstar p0 p1 p2 tot\n");
  let c:i32=-3;
  while(c<=40){
    let b:i32=-11;
    let best:i32=0;
    let bb:i32=-11;
    let first:i32=1;
    while(b<=84){
      let p:i32=0;
      t=0;
      while(t<24){
        if(get32(tadj,4*t)>b){ p=p+get32(teff,4*t)-c; }
        t=t+1;
      }
      if(first==1){ best=p; bb=b; first=0; }
      if(first==0){
        if(p>=best){ best=p; bb=b; }
      }
      b=b+1;
    }
    set32(bstar,4*(c+3),bb);
    let qp0:i32=0; let qp1:i32=0; let qp2:i32=0;
    sh=0;
    while(sh<3){
      let profit:i32=0;
      s=0;
      while(s<12){
        let i:i32=sh*12+s;
        if(get32(sadj,4*i)>bb){ profit=profit+get32(seff,4*i)-15; }
        s=s+1;
      }
      if(sh==0){ qp0=profit; }
      if(sh==1){ qp1=profit; }
      if(sh==2){ qp2=profit; }
      sh=sh+1;
    }
    at=ob_app(ob,at,"B ");
    at=ob_i32(ob,at,c);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,bb);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,qp0);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,qp1);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,qp2);
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,qp0+qp1+qp2);
    at=ob_nl(ob,at);
    c=c+1;
  }
  // PHASE: KFLAGS (in-program checks of the frozen predictions).
  let i15:i32=4*(15+3);
  let f1:i32=0; if(get32(p0A,i15)==75){ f1=1; }
  let f2:i32=0; if(get32(p1A,i15)==128){ f2=1; }
  let f3:i32=0; if(get32(p2A,i15)==55){ f3=1; }
  let f4:i32=0; if(get32(totA,i15)==258){ f4=1; }
  let ks3a:i32=f1*f2*f3*f4;
  let i14:i32=4*(14+3);
  let g1:i32=0; if(get32(totA,i14)==258){ g1=1; }
  let eq:i32=1;
  let q:i32=0;
  while(q<36){
    if(get32(go14,4*q)!=get32(go15,4*q)){ eq=0; }
    q=q+1;
  }
  let ks3b:i32=g1*eq;
  let im3:i32=4*(-3+3);
  let e1:i32=0; if(get32(p0A,im3)==43){ e1=1; }
  let e2:i32=0; if(get32(p1A,im3)==113){ e2=1; }
  let e3:i32=0; if(get32(p2A,im3)==-80){ e3=1; }
  let ks3c:i32=e1*e2*e3;
  let ks3:i32=ks3a*ks3b*ks3c;
  let mx:i32=get32(totA,0);
  K=-3;
  while(K<=85){
    let v:i32=get32(totA,4*(K+3));
    if(v>mx){ mx=v; }
    K=K+1;
  }
  let run:i32=0;
  let bestrun:i32=0;
  K=-3;
  while(K<=85){
    if(get32(totA,4*(K+3))==mx){ run=run+1; if(run>bestrun){ bestrun=run; } }
    if(get32(totA,4*(K+3))!=mx){ run=0; }
    K=K+1;
  }
  let cnt:i32=0;
  K=-3;
  while(K<=85){
    if(get32(totA,4*(K+3))>=246){ cnt=cnt+1; }
    K=K+1;
  }
  let h1:i32=0; if(mx==258){ h1=1; }
  let h2:i32=0; if(bestrun>=4){ h2=1; }
  let h3:i32=0; if(cnt>=8){ h3=1; }
  let ks4:i32=h1*h2*h3;
  let m0:i32=get32(p0A,0);
  let m1:i32=get32(p1A,0);
  let m2:i32=get32(p2A,0);
  K=-3;
  while(K<=85){
    let v0:i32=get32(p0A,4*(K+3));
    let v1:i32=get32(p1A,4*(K+3));
    let v2:i32=get32(p2A,4*(K+3));
    if(v0>m0){ m0=v0; }
    if(v1>m1){ m1=v1; }
    if(v2>m2){ m2=v2; }
    K=K+1;
  }
  let found:i32=0;
  K=-3;
  while(K<=85){
    let a1:i32=0; if(get32(p0A,4*(K+3))==m0){ a1=1; }
    let a2:i32=0; if(get32(p1A,4*(K+3))==m1){ a2=1; }
    let a3:i32=0; if(get32(p2A,4*(K+3))==m2){ a3=1; }
    if(a1*a2*a3==1){ found=1; }
    K=K+1;
  }
  let ks5:i32=0; if(found==0){ ks5=1; }
  let bs15:i32=get32(bstar,4*(15+3));
  let bs14:i32=get32(bstar,4*(14+3));
  let bs16:i32=get32(bstar,4*(16+3));
  let n1:i32=0; if(bs15==14){ n1=1; }
  let n2:i32=0; if(get32(totA,4*(14+3))==258){ n2=1; }
  let n3:i32=0; if(get32(totA,4*(bs14+3))>=246){ n3=1; }
  let n4:i32=0; if(get32(totA,4*(bs16+3))>=246){ n4=1; }
  let ks6:i32=n1*n2*n3*n4;
  let i5:i32=4*(5+3);
  let r1:i32=0; if(get32(p0A,i5)==75){ r1=1; }
  let r2:i32=0; if(get32(p1A,i5)==138){ r2=1; }
  let r3:i32=0; if(get32(p2A,i5)==40){ r3=1; }
  let r4:i32=0; if(get32(totA,i5)==253){ r4=1; }
  let ks7:i32=r1*r2*r3*r4;
  at=ob_app(ob,at,"KS3=");
  at=ob_i32(ob,at,ks3);
  at=ob_app(ob,at," KS4=");
  at=ob_i32(ob,at,ks4);
  at=ob_app(ob,at," KS5=");
  at=ob_i32(ob,at,ks5);
  at=ob_app(ob,at," KS6=");
  at=ob_i32(ob,at,ks6);
  at=ob_app(ob,at," KS7=");
  at=ob_i32(ob,at,ks7);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCKS-END\n");
  let out:[]u8=ob[0..at];
  _zag_print(out);
  return 0;
}

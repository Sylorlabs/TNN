// driver.zag -- experiment side: teaching, four arms, in-Zag
// kill-bar evaluation for the L2-ESS two-family curriculum.
// The driver never selects a reuse operator for a query and never
// names a source pair or a binding: queries are issued as
// (start,terminal,value,cap,dom) with one arm-level OP_MASK and one
// arm-level standing mode (0=UNGATED, 1=STANDING, 2=GLOBAL,
// 3=RIVAL) via mr_standing_arm, analogous to OP_MASK: per ARM, never
// per query, never written by the learner. Query ids q0..q16:
// Phase A (family A, L2-INVERT-VALUE): q0..q6.
// Phase B (family B, new source mX): q7..q14.
// World change (driver teaches facts 48..55).
// Phase B-prime (recovery): q15..q16.
// Prereg: l2_ess_curriculum/PREREG.md (frozen). Pure Zag.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1 (X): dom A(1), cap AGG(1), entry + 3 fold pairs,
  // facts [7,0,1,2,3,4,5], 100->43
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs[0]=7; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  // mB0 id2 (Y): dom B(2), cap ROUTE(2), rels [7,7], facts [8,9],
  // 90->92
  rs[0]=7; rs[1]=7; fs[0]=8; fs[1]=9;
  m_teach(st,rs,2,fs,2,90,92,2,2);
  // mP id3 (P): dom A(1), cap AGG(1), hole entry 0 + 2 fold
  // pairs, facts [43,4,5], 240->43
  rs[0]=0; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6;
  fs[0]=43; fs[1]=4; fs[2]=5;
  m_teach(st,rs,5,fs,3,240,43,1,1);
  // mX id4 (family B source): dom 3, cap 3, entry 51 + 1 fold
  // pair (52,53), facts [44,45,46], 300->312. Descriptor derived
  // generically by m_teach (cap 3): (51,52,53,1,54).
  rs[0]=51; rs[1]=52; rs[2]=53;
  fs[0]=44; fs[1]=45; fs[2]=46;
  m_teach(st,rs,3,fs,3,245,248,3,3);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Family B-prime world change: two substitute paths become
// observable (taught by the driver between phase B and B-prime).
fn d_teach_bprime(st:[]u8)void {
  f_teach(st,245,61,249);
  f_teach(st,249,52,250);
  f_teach(st,250,53,251);
  f_teach(st,251,54,72);
  f_teach(st,245,62,252);
  f_teach(st,252,52,253);
  f_teach(st,253,53,254);
  f_teach(st,254,54,73);
  return;
}
// One query; store op (1472), val (1440), as (1432) into res.
fn dq(st:[]u8, ob:[]u8, atp:[]u8, res:[]u8, qi:i32, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32)void {
  ex_p(ob,atp,"Q q");
  ex_pi(ob,atp,qi);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(res,qi*12+0,get32(st,1472));
  set32(res,qi*12+4,get32(st,1440));
  set32(res,qi*12+8,get32(st,1432));
  return;
}
fn rget(res:[]u8, qi:i32, f:i32)i32 {
  return get32(res,qi*12+f*4);
}
// All 17 curriculum queries for one arm (mode set by caller).
fn run_arm(st:[]u8, ob:[]u8, atp:[]u8, res:[]u8)void {
  // Phase A: family A (L2-INVERT-VALUE), q0..q6
  dq(st,ob,atp,res,0,90,86,42,1,2,63);
  dq(st,ob,atp,res,1,200,43,11,1,1,63);
  dq(st,ob,atp,res,2,100,42,32,1,1,63);
  dq(st,ob,atp,res,3,120,127,60,1,1,63);
  dq(st,ob,atp,res,4,150,166,77,1,1,63);
  dq(st,ob,atp,res,5,210,234,91,1,1,63);
  dq(st,ob,atp,res,6,11,100,11,1,1,63);
  // Phase B: family B (new source mX, cap 3), q7..q14
  dq(st,ob,atp,res,7,245,990,71,3,3,63);
  dq(st,ob,atp,res,8,71,245,71,3,3,63);
  dq(st,ob,atp,res,9,245,999,71,3,3,63);
  dq(st,ob,atp,res,10,245,998,71,3,3,63);
  dq(st,ob,atp,res,11,245,997,71,3,3,63);
  dq(st,ob,atp,res,12,245,996,71,3,3,63);
  dq(st,ob,atp,res,13,245,995,71,3,3,63);
  dq(st,ob,atp,res,14,245,994,71,3,3,63);
  // World change: family B-prime substitute paths
  d_teach_bprime(st);
  // Phase B-prime: recovery, q15..q16
  dq(st,ob,atp,res,15,245,251,72,3,3,63);
  dq(st,ob,atp,res,16,245,254,73,3,3,63);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM UNGATED (mode 0) ----------
  let st0:[]u8=z_alloc(8192);
  let r0:[]u8=z_alloc(1024);
  d_teach_all(st0);
  mr_standing_arm(st0,0);
  ex_p(ob,atp,"ARM UNGATED\n");
  run_arm(st0,ob,atp,r0);
  ex_p(ob,atp,"ARM-UNGATED-END\n");

  // ---------- ARM STANDING (mode 1) ----------
  let st1:[]u8=z_alloc(8192);
  let r1:[]u8=z_alloc(1024);
  d_teach_all(st1);
  mr_standing_arm(st1,1);
  ex_p(ob,atp,"ARM STANDING\n");
  run_arm(st1,ob,atp,r1);
  ex_p(ob,atp,"ARM-STANDING-END\n");

  // ---------- ARM GLOBAL (mode 2) ----------
  let st2:[]u8=z_alloc(8192);
  let r2:[]u8=z_alloc(1024);
  d_teach_all(st2);
  mr_standing_arm(st2,2);
  ex_p(ob,atp,"ARM GLOBAL\n");
  run_arm(st2,ob,atp,r2);
  ex_p(ob,atp,"ARM-GLOBAL-END\n");

  // ---------- ARM RIVAL (mode 3) ----------
  let st3:[]u8=z_alloc(8192);
  let r3:[]u8=z_alloc(1024);
  d_teach_all(st3);
  mr_standing_arm(st3,3);
  ex_p(ob,atp,"ARM RIVAL\n");
  run_arm(st3,ob,atp,r3);
  ex_p(ob,atp,"ARM-RIVAL-END\n");

  // ---------- in-Zag kill bars ----------
  // KB-FAM-A: UNGATED phase A commits ops 1,2,3,4,5,6,4,
  // vals 42,11,32,60,77,91,11.
  let k_fama:i32=0;
  if(rget(r0,0,0)==1){
    if(rget(r0,1,0)==2){
      if(rget(r0,2,0)==3){
        if(rget(r0,3,0)==4){
          if(rget(r0,4,0)==5){
            if(rget(r0,5,0)==6){
              if(rget(r0,6,0)==4){
                if(rget(r0,0,1)==42){
                  if(rget(r0,1,1)==11){
                    if(rget(r0,2,1)==32){
                      if(rget(r0,3,1)==60){
                        if(rget(r0,4,1)==77){
                          if(rget(r0,5,1)==91){
                            if(rget(r0,6,1)==11){k_fama=1;}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  // KB-FAM-B: UNGATED new-family sanity.
  let k_famb:i32=0;
  if(rget(r0,7,1)==-2){
    if(rget(r0,8,0)==4){
      if(rget(r0,8,1)==71){
        if(rget(r0,9,1)==-2){
          if(rget(r0,10,1)==-2){
            if(rget(r0,11,1)==-2){
              if(rget(r0,12,1)==-2){
                if(rget(r0,13,1)==-2){
                  if(rget(r0,14,1)==-2){
                    if(rget(r0,15,0)==2){
                      if(rget(r0,15,1)==72){
                        if(rget(r0,16,0)==2){
                          if(rget(r0,16,1)==73){k_famb=1;}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  // KB-P1: gating saves. q11..q14: UNGATED-STANDING as gap >= 48
  // each; q7,q8: identical committed op/val across arms.
  let k_p1:i32=0;
  if(rget(r0,11,2)-rget(r1,11,2)>=48){
    if(rget(r0,12,2)-rget(r1,12,2)>=48){
      if(rget(r0,13,2)-rget(r1,13,2)>=48){
        if(rget(r0,14,2)-rget(r1,14,2)>=48){
          if(rget(r0,7,0)==rget(r1,7,0)){
            if(rget(r0,7,1)==rget(r1,7,1)){
              if(rget(r0,8,0)==rget(r1,8,0)){
                if(rget(r0,8,1)==rget(r1,8,1)){k_p1=1;}
              }
            }
          }
        }
      }
    }
  }
  // KB-P3: reversibility. STANDING q15,q16 via op 2 with
  // vals 72,73 (q15 is the probation recovery).
  let k_p3:i32=0;
  if(rget(r1,15,0)==2){
    if(rget(r1,15,1)==72){
      if(rget(r1,16,0)==2){
        if(rget(r1,16,1)==73){k_p3=1;}
      }
    }
  }
  // KB-P5: context beats global. GLOBAL loses q15 (val -2),
  // STANDING keeps it (val 72).
  let k_p5:i32=0;
  if(rget(r2,15,1)==-2){
    if(rget(r1,15,1)==72){k_p5=1;}
  }
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k_fama",k_fama);
  d_bar(ob,atp,"k_famb",k_famb);
  d_bar(ob,atp,"k_p1",k_p1);
  d_bar(ob,atp,"k_p3",k_p3);
  d_bar(ob,atp,"k_p5",k_p5);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"L2-ESS-CURRICULUM-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

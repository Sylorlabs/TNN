// learner.zag -- L2-ESS-CURRICULUM (two-family test of H-OP-ESS),
// standalone. Generic machinery + learned state only. No world data,
// no fact literals, no relation literals, no domain literals, no
// per-query operator literals in this file. The learner holds six
// reuse operators (1=COMBINE, 2=SUBSTITUTE, 3=TRUNCATE,
// 4=INVERT, 5=ABSTRACT, 6=CONCRETIZE); INVERT has two
// forms: Form B (value-mapping inversion: reverse value
// lookup + backward chain walk, tried first) and Form A
// (structural relation-sequence reversal, fallback). The
// learner selects which operator to apply per query by
// trial verification under a fixed generic order: the
// first operator whose full grounding executes to the
// query terminal with the required value is committed.
// NEW in this lane: learner-written operator epistemic standing.
// Per (operator, context-signature) cells [SUC,FAIL,STRK,QTOUCH]:
// the learner's graded state about its own procedures, written by
// op_standing_update on the post-query path from trial outcomes,
// gating trials via MR-OP-STANDING-SKIP / MR-OP-PROBATION.
// Context signature st_sig is computed from learner-observable
// structure features (entry-match flag, source fold count,
// hole-entry flag); no world/family literals. OP_MASK (driver-set
// causal-control flag, never written by the learner) gates which
// operators may be tried; STANDING_MODE (driver-set per arm via
// mr_standing_arm, analogous to OP_MASK) selects 0=UNGATED,
// 1=per-(op,sig) STANDING, 2=GLOBAL ablation, 3=RIVAL stateless
// pre-check arm. Prereg: l2_ess_curriculum/PREREG.md (frozen).
// Pure Zag. 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 reserved  4 NN  5 unused
//   6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_MR  12 MR_ENTERED
//   16..463:  facts, 56 x 8B [sub,rel,obj,live,0,0,0,0]
//   464..1103: MAPs, 16 x 40B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x12 @+8, facts x12 @+20,
//               dom @+32, cap @+33, d_entry @+34, d_r1 @+35,
//               d_r2 @+36, d_nf @+37, d_valrel @+38,
//               dir @+39 (0=forward, 1=inverse/backward)]
//   1104..1359: edges, 64 x 4B [from,to,type,pad]
//   1360..1423: answer nodes, 16 x 4B [via,0,0,0]
//   1424 SEARCH i32  1428 EXEC i32  1432 A_SEARCH i32  1436 A_EXEC i32
//   1440 LAST_VAL i32  1444 AGG_SRC (i32)  1448 ROUTE_SRC (i32)
//   1452 BINDING (i32)  1456 BIND_DECIDED (i32)
//   1460 BIND_TRIES (i32, binding attempts made)
//   1464 PIPE_HIT (i32)  1468 LAST_TERM (i32)
//   1472 MR_OP (i32)  1476 MR_OP_TRIES (i32)
//   1480 MR_OP_DECIDED (i32)  1484 OP_MASK (i32)
//   1488..2255: standing cells, 6 ops x 32 sigs x 4B
//               [SUC,FAIL,STRK,QTOUCH]
//   2256 STANDING_MODE (i32)  2260 TRIEDMASK (i32)
//   2264..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn ex_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ex_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ex_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn ex_tick(st:[]u8)void {
  set32(st,1432,get32(st,1432)+1);
  set32(st,1424,get32(st,1424)+1);
  return;
}
fn ex_tickm(st:[]u8)void {
  set32(st,1432,get32(st,1432)+1);
  set32(st,1424,get32(st,1424)+1);
  return;
}
fn ex_exec(st:[]u8)void {
  set32(st,1428,get32(st,1428)+1);
  if((st[11] as i32)==1){set32(st,1436,get32(st,1436)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=56){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (40-byte rows, 12 rel/fact slots) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>12){return -1;}
  if(fl>12){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==1 or cap==3, generic):
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1 || cap==3){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=464+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32, dir:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=464+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=dir as u8;
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=464+mid*40;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  ex_exec(st);
  st[6]=255;
  let o:i32=464+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let bwd:i32=st[o+39] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+20+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if(bwd==1){
      if((st[fo+2] as i32)!=cur){bad=1;}
    } else {
      if((st[fo] as i32)!=cur){bad=1;}
    }
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    if(bwd==1){
      cur=st[fo] as i32;
    } else {
      cur=st[fo+2] as i32;
    }
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
// backward chain execution over stored fact/rel arrays:
// each hop requires obj==cur and rel==rs[k], then
// cur=sub. Verifies inverse (dir=1) groundings.
fn chain_exec_bwd(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+2] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=1104+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=1104+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[1104+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1104+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){return 1;}
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1104+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn ex_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[1104+i*4+2] as i32;
    if(tp!=14){ if(tp!=16){ c=c+1; } }
    i=i+1;
  }
  return c;
}

// ---- counted fact scans (frozen counting rules) ----
fn ex_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
fn ex_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// obj-match scan: first live fact with obj==o AND rel==r.
// Used by value-mapping inversion (reverse value lookup is
// done inline in mr_invert_val; this serves the backward
// chain hops). Cost (first matching fid)+1, or 44 on miss.
fn ex_find_objrel(st:[]u8, o:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    let m1:i32=0;
    if((st[fo+3] as i32)==1){m1=1;}
    let m2:i32=0;
    if(m1==1){
      if((st[fo+2] as i32)==o){m2=1;}
    }
    let m3:i32=0;
    if(m2==1){
      if((st[fo+1] as i32)==r){m3=1;}
    }
    if(m3==1){return i;}
    i=i+1;
  }
  return -1;
}
fn ex_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=ex_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}

// ---- fold-walk (as in the sibling combine lane) ----
fn ex_foldwalk(st:[]u8, u:i32, k:i32, vrel:i32, ff:[]u8)i32 {
  let f1:i32=ex_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=ex_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8;
  let j:i32=1;
  while(j<k){
    let g1:i32=ex_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=ex_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*j]=g1 as u8; ff[2*j+1]=g2 as u8;
    j=j+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- AGG segment: entry scan from s, then a k-fold walk with
// runtime relation discovery. final==0: midpoint segment, shape
// success suffices. final==1: terminal segment, require
// term==t AND VAL(term,vrel)==v. Records segment rels into tr
// and fact ids into tf. Returns the foldwalk pack or 0.
fn mr_agg_seg(st:[]u8, ob:[]u8, atp:[]u8, s:i32, k:i32, vrel:i32, final:i32, t:i32, v:i32, tr:[]u8, tf:[]u8)i32 {
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let found:i32=0;
  let re:i32=0;
  let u:i32=0;
  let efid:i32=0;
  while(fid<nfacts){
    if(found==0){
      ex_tick(st);
      let fo:i32=16+fid*8;
      if((st[fo+3] as i32)==1){
        if((st[fo] as i32)==s){
          re=st[fo+1] as i32;
          u=st[fo+2] as i32;
          efid=fid;
          found=1;
        }
      }
    }
    fid=fid+1;
  }
  if(found==0){return 0;}
  let ff:[]u8=z_alloc(16);
  let p2:i32=ex_foldwalk(st,u,k,vrel,ff);
  ex_p(ob,atp,"MR-ENTRY-CAND r=");
  ex_pi(ob,atp,re);
  ex_p(ob,atp," u=");
  ex_pi(ob,atp,u);
  if(p2==0){
    ex_p(ob,atp," FAIL-SHAPE\n");
    return 0;
  }
  let s1:i32=p2%256;
  let s2:i32=(p2/256)%256;
  let term:i32=(p2/65536)%256;
  ex_p(ob,atp," SHAPE-OK term=");
  ex_pi(ob,atp,term);
  let ok:i32=1;
  if(final==1){
    if(term!=t){ok=0;}
    if(ok==1){
      let vv:i32=ex_valof(st,term,vrel);
      if(vv!=v){ok=0;}
    }
    if(ok==1){ex_p(ob,atp," VERIFY-OK\n");}
    else {ex_p(ob,atp," VERIFY-FAIL\n");}
  } else {
    ex_pnl(ob,atp);
  }
  if(ok==0){return 0;}
  tr[0]=re as u8;
  tf[0]=efid as u8;
  let w:i32=0;
  while(w<2*k){
    if((w%2)==0){tr[1+w]=s1 as u8;}
    else {tr[1+w]=s2 as u8;}
    tf[1+w]=ff[w];
    w=w+1;
  }
  return p2;
}

// ---- partner segment: strict walk over the partner source's
// stored relseq rels from s. A missing hop fails the segment.
fn mr_route_seg(st:[]u8, s:i32, rsrc:i32, hr:[]u8, hf:[]u8)i32 {
  let o:i32=464+rsrc*40;
  let rl:i32=st[o+4] as i32;
  let cur:i32=s;
  let k:i32=0;
  while(k<rl){
    let r:i32=st[o+8+k] as i32;
    let f:i32=ex_find_subrel(st,cur,r);
    if(f<0){return -1;}
    hr[k]=r as u8;
    hf[k]=f as u8;
    cur=st[16+f*8+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- build, execution-verify, promote, deliver the adapted Z.
// src2<0 means single-source provenance.
fn mr_buildwin(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, src1:i32, src2:i32, hr1:[]u8, hf1:[]u8, l1:i32, hr2:[]u8, hf2:[]u8, l2:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let zr:[]u8=z_alloc(32);
  let zf:[]u8=z_alloc(32);
  let w:i32=0;
  while(w<l1){
    zr[w]=hr1[w];
    zf[w]=hf1[w];
    w=w+1;
  }
  let x:i32=0;
  while(x<l2){
    zr[l1+x]=hr2[x];
    zf[l1+x]=hf2[x];
    x=x+1;
  }
  let zl:i32=l1+l2;
  ex_p(ob,atp,"MR-ZBUILD rels=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec(st,zf,zr,zl,s);
  ex_p(ob,atp,"MR-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,zr,zl,zf,zl,s,vt,qdom,qcap,de,dr1,dr2,dnf,dvr,0);
    e_add(st,zid,src1,16);
    if(src2>=0){e_add(st,zid,src2,16);}
    ex_p(ob,atp,"MR-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,src1);
    if(src2>=0){
      ex_p(ob,atp," t16=");
      ex_pi(ob,atp,zid);
      ex_p(ob,atp,"->");
      ex_pi(ob,atp,src2);
    }
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- build, backward-verify, promote, deliver the inverse Z.
// hr/hf arrive in walk order (value hop first, then the
// backward chain hops). The MAP is created with dir=1 so
// pipeline execution walks it backward; the pipeline reads
// the inverse's value from stored fact[0]'s obj.
fn mr_buildwin_inv(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, src1:i32, hr:[]u8, hf:[]u8, zl:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  ex_p(ob,atp,"MR-ZBUILD rels=");
  let w:i32=0;
  while(w<zl){
    ex_pi(ob,atp,hr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,hf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec_bwd(st,hf,hr,zl,s);
  ex_p(ob,atp,"MR-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,hr,zl,hf,zl,s,vt,qdom,qcap,de,dr1,dr2,dnf,dvr,1);
    e_add(st,zid,src1,16);
    ex_p(ob,atp,"MR-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,src1);
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- operator 1: cross-domain COMBINE ----
fn mr_combine(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  set32(st,1444,agg_src);
  let ao:i32=464+agg_src*40;
  let anfk:i32=st[ao+37] as i32;
  let avrel:i32=st[ao+38] as i32;
  ex_p(ob,atp,"MR-SRC-AGG id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,st[ao+34] as i32);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,st[ao+35] as i32);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,st[ao+36] as i32);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,anfk);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,avrel);
  ex_pnl(ob,atp);
  let nm:i32=st[1] as i32;
  let rsrcs:[]u8=z_alloc(16);
  let nr:i32=0;
  let pcap:i32=-1;
  let mid:i32=0;
  while(mid<nm){
    ex_tickm(st);
    let o:i32=464+mid*40;
    let live:i32=st[o+1] as i32;
    let mc:i32=st[o+33] as i32;
    ex_p(ob,atp,"MR-RSEARCH id=");
    ex_pi(ob,atp,mid);
    ex_p(ob,atp," cap=");
    ex_pi(ob,atp,mc);
    let take:i32=0;
    if(live==1){
      if(mc!=qcap){
        if(pcap<0){pcap=mc;}
        if(mc==pcap){take=1;}
      }
    }
    if(take==1){
      ex_p(ob,atp," PCAP\n");
      rsrcs[nr]=mid as u8;
      nr=nr+1;
    } else {
      ex_p(ob,atp," SKIP\n");
    }
    mid=mid+1;
  }
  let hr1:[]u8=z_alloc(16);
  let hf1:[]u8=z_alloc(16);
  let hr2:[]u8=z_alloc(16);
  let hf2:[]u8=z_alloc(16);
  let ans:i32=-2;
  let ri:i32=0;
  let won:i32=0;
  while(ri<nr){
    if(won==0){
      let rsrc:i32=rsrcs[ri] as i32;
      ex_p(ob,atp,"MR-SRC-ROUTE id=");
      ex_pi(ob,atp,rsrc);
      ex_pnl(ob,atp);
      // binding b=1: AGG head, partner tail
      set32(st,1460,get32(st,1460)+1);
      let hp:i32=mr_agg_seg(st,ob,atp,s,anfk,avrel,0,0,0,hr1,hf1);
      let w1:i32=0;
      if(hp!=0){
        let ht:i32=(hp/65536)%256;
        let l1:i32=1+2*anfk;
        let ro:i32=464+rsrc*40;
        let l2:i32=st[ro+4] as i32;
        let tt:i32=mr_route_seg(st,ht,rsrc,hr2,hf2);
        if(tt>=0){
          if(tt==t){
            let vv:i32=ex_valof(st,tt,avrel);
            if(vv==v){w1=1;}
          }
        }
        if(w1==1){
          set32(st,1448,rsrc);
          set32(st,1452,1);
          set32(st,1456,1);
          ex_p(ob,atp,"MR-BIND b=1 OK\n");
          ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1,hr2,hf2,l2,0,0,0,0,avrel);
          won=1;
        }
      }
      if(w1==0){
        ex_p(ob,atp,"MR-BIND b=1 FAIL\n");
        // binding b=2: partner head, AGG tail
        set32(st,1460,get32(st,1460)+1);
        let ro2:i32=464+rsrc*40;
        let l1b:i32=st[ro2+4] as i32;
        let ht2:i32=mr_route_seg(st,s,rsrc,hr1,hf1);
        let w2:i32=0;
        if(ht2>=0){
          ex_p(ob,atp,"MR-HEAD term=");
          ex_pi(ob,atp,ht2);
          ex_pnl(ob,atp);
          let tp:i32=mr_agg_seg(st,ob,atp,ht2,anfk,avrel,1,t,v,hr2,hf2);
          if(tp!=0){w2=1;}
        }
        if(w2==1){
          set32(st,1448,rsrc);
          set32(st,1452,2);
          set32(st,1456,1);
          ex_p(ob,atp,"MR-BIND b=2 OK\n");
          let l2b:i32=1+2*anfk;
          ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1b,hr2,hf2,l2b,0,0,0,0,avrel);
          won=1;
        } else {
          ex_p(ob,atp,"MR-BIND b=2 FAIL\n");
        }
      }
    }
    ri=ri+1;
  }
  return ans;
}

// ---- operator 2: SUBSTITUTE (entry-relation substitution) ----
fn mr_substitute(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let de:i32=st[ao+34] as i32;
  let dr1:i32=st[ao+35] as i32;
  let dr2:i32=st[ao+36] as i32;
  let dnf:i32=st[ao+37] as i32;
  let dvr:i32=st[ao+38] as i32;
  ex_p(ob,atp,"MR-SRC-SUB id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,de);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,dr1);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,dr2);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,dnf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,dvr);
  ex_pnl(ob,atp);
  // entry-candidate collection: all live facts with sub==s
  // and rel != d_entry, fid order, every fid ticked.
  let cands:[]u8=z_alloc(64);
  let candr:[]u8=z_alloc(64);
  let ncu:i32=0;
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  while(fid<nf){
    ex_tick(st);
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=de){
          cands[ncu]=fid as u8;
          candr[ncu]=st[fo+1];
          ncu=ncu+1;
        }
      }
    }
    fid=fid+1;
  }
  let ans:i32=-2;
  let won:i32=0;
  let ci:i32=0;
  while(ci<ncu){
    if(won==0){
      let cf:i32=cands[ci] as i32;
      let cr:i32=candr[ci] as i32;
      let cfo:i32=16+cf*8;
      let u:i32=st[cfo+2] as i32;
      ex_p(ob,atp,"MR-SUB-CAND r=");
      ex_pi(ob,atp,cr);
      ex_p(ob,atp," u=");
      ex_pi(ob,atp,u);
      let ff:[]u8=z_alloc(16);
      let p:i32=ex_foldwalk(st,u,dnf,dvr,ff);
      if(p==0){
        ex_p(ob,atp," FAIL-SHAPE\n");
      } else {
        let s1:i32=p%256;
        let s2:i32=(p/256)%256;
        let term:i32=(p/65536)%256;
        ex_p(ob,atp," SHAPE-OK term=");
        ex_pi(ob,atp,term);
        let ok:i32=1;
        if(term!=t){ok=0;}
        if(ok==1){
          let vv:i32=ex_valof(st,term,dvr);
          if(vv!=v){ok=0;}
        }
        if(ok==1){
          ex_p(ob,atp," VERIFY-OK\n");
          let zr:[]u8=z_alloc(32);
          let zf:[]u8=z_alloc(32);
          zr[0]=cr as u8;
          zf[0]=cf as u8;
          let w:i32=0;
          while(w<2*dnf){
            if((w%2)==0){zr[1+w]=s1 as u8;}
            else {zr[1+w]=s2 as u8;}
            zf[1+w]=ff[w];
            w=w+1;
          }
          let zl:i32=1+2*dnf;
          ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,-1,zr,zf,zl,zr,zf,0,cr,s1,s2,dnf,dvr);
          if(ans>=0){won=1;}
        } else {
          ex_p(ob,atp," VERIFY-FAIL\n");
        }
      }
    }
    ci=ci+1;
  }
  return ans;
}

// ---- operator 3: TRUNCATE (prefix truncation, nf descending) ----
fn mr_truncate(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let dnf:i32=st[ao+37] as i32;
  let dvr:i32=st[ao+38] as i32;
  ex_p(ob,atp,"MR-SRC-TRUNC id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,dnf);
  ex_pnl(ob,atp);
  let hr:[]u8=z_alloc(16);
  let hf:[]u8=z_alloc(16);
  let ans:i32=-2;
  let won:i32=0;
  let nf2:i32=dnf-1;
  while(nf2>=1){
    if(won==0){
      ex_p(ob,atp,"MR-TRUNC-TRY nf=");
      ex_pi(ob,atp,nf2);
      ex_pnl(ob,atp);
      let p:i32=mr_agg_seg(st,ob,atp,s,nf2,dvr,1,t,v,hr,hf);
      if(p!=0){
        let s1:i32=p%256;
        let s2:i32=(p/256)%256;
        let re:i32=hr[0] as i32;
        let zl:i32=1+2*nf2;
        ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,-1,hr,hf,zl,hr,hf,0,re,s1,s2,nf2,dvr);
        if(ans>=0){won=1;}
      }
    }
    nf2=nf2-1;
  }
  return ans;
}

// ---- operator 4 Form B: value-mapping inversion. The source
// MAP's value mapping is key->value (key --forward rels-->
// terminal --valrel--> value); the inverse is value->key.
// Reverse value lookup: scan facts for rel==dvr AND obj==v;
// the first match must land on the SOURCE's own terminal
// (else the value does not belong to this source's mapping).
// Then walk the source's forward rels backward (obj-match
// hops) from that terminal to the key. The query's value v
// is consumed by the reverse lookup itself.
fn mr_invert_val(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let rl:i32=st[ao+4] as i32;
  let dvr:i32=st[ao+38] as i32;
  let aend:i32=st[ao+3] as i32;
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  let tfv:i32=-1;
  let tstar:i32=-1;
  while(fid<nf){
    ex_tick(st);
    let fo:i32=16+fid*8;
    let m1:i32=0;
    if((st[fo+3] as i32)==1){m1=1;}
    let m2:i32=0;
    if(m1==1){
      if((st[fo+1] as i32)==dvr){m2=1;}
    }
    let m3:i32=0;
    if(m2==1){
      if((st[fo+2] as i32)==v){m3=1;}
    }
    if(m3==1){
      if(tfv<0){
        tfv=fid;
        tstar=st[fo] as i32;
      }
    }
    fid=fid+1;
  }
  ex_p(ob,atp,"MR-INVVAL-LOOKUP t*=");
  ex_pi(ob,atp,tstar);
  ex_p(ob,atp," srcend=");
  ex_pi(ob,atp,aend);
  ex_pnl(ob,atp);
  if(tfv<0){
    ex_p(ob,atp,"MR-INVVAL-FAIL\n");
    return -2;
  }
  if(tstar!=aend){
    ex_p(ob,atp,"MR-INVVAL-FAIL\n");
    return -2;
  }
  let hr:[]u8=z_alloc(16);
  let hf:[]u8=z_alloc(16);
  hr[0]=dvr as u8;
  hf[0]=tfv as u8;
  let cur:i32=tstar;
  let bad:i32=0;
  let k:i32=0;
  while(k<rl){
    if(bad==0){
      let r:i32=st[ao+8+rl-1-k] as i32;
      let f:i32=ex_find_objrel(st,cur,r);
      if(f<0){bad=1;}
      else {
        hr[1+k]=r as u8;
        hf[1+k]=f as u8;
        cur=st[16+f*8] as i32;
      }
    }
    k=k+1;
  }
  if(bad==1){
    ex_p(ob,atp,"MR-INVVAL-FAIL\n");
    return -2;
  }
  if(cur!=t){
    ex_p(ob,atp,"MR-INVVAL-VERIFY-FAIL\n");
    return -2;
  }
  ex_p(ob,atp,"MR-INVVAL-WALK key=");
  ex_pi(ob,atp,cur);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"MR-INVVAL-OK\n");
  let zl:i32=rl+1;
  let bwd1:i32=st[ao+8+rl-1] as i32;
  let bwd2:i32=st[ao+8+rl-2] as i32;
  let dnf:i32=(rl-1)/2;
  let ans:i32=mr_buildwin_inv(st,ob,atp,s,t,v,qdom,qcap,agg_src,hr,hf,zl,dvr,bwd1,bwd2,dnf,dvr);
  return ans;
}

// ---- operator 4: INVERT. Form B (value-mapping inversion)
// is tried first and completes the operator per the lane
// mandate; Form A (reverse the source's stored relation
// sequence, then walk it strictly forward) is the fallback
// for queries that do not ground a reverse value chain.
fn mr_invert(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let rl:i32=st[ao+4] as i32;
  let dvr:i32=st[ao+38] as i32;
  ex_p(ob,atp,"MR-SRC-INV id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," rlen=");
  ex_pi(ob,atp,rl);
  ex_pnl(ob,atp);
  let ansb:i32=mr_invert_val(st,ob,atp,s,t,v,qdom,qcap,agg_src);
  if(ansb>=0){return ansb;}
  let irev:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<rl){
    irev[k]=st[ao+8+rl-1-k];
    k=k+1;
  }
  ex_p(ob,atp,"MR-INV-REV rels=");
  k=0;
  while(k<rl){
    ex_pi(ob,atp,irev[k] as i32);
    if(k+1<rl){ex_p(ob,atp,",");}
    k=k+1;
  }
  ex_pnl(ob,atp);
  let hr:[]u8=z_alloc(16);
  let hf:[]u8=z_alloc(16);
  let cur:i32=s;
  let bad:i32=0;
  k=0;
  while(k<rl){
    if(bad==0){
      let r:i32=irev[k] as i32;
      let f:i32=ex_find_subrel(st,cur,r);
      if(f<0){bad=1;}
      else {
        hr[k]=r as u8;
        hf[k]=f as u8;
        cur=st[16+f*8+2] as i32;
      }
    }
    k=k+1;
  }
  if(bad==1){
    ex_p(ob,atp,"MR-INV-FAIL\n");
    return -2;
  }
  if(cur!=t){
    ex_p(ob,atp,"MR-INV-VERIFY-FAIL\n");
    return -2;
  }
  let vv:i32=ex_valof(st,cur,dvr);
  if(vv!=v){
    ex_p(ob,atp,"MR-INV-VERIFY-FAIL\n");
    return -2;
  }
  ex_p(ob,atp,"MR-INV-OK\n");
  let dnf:i32=(rl-1)/2;
  let ans:i32=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,-1,hr,hf,rl,hr,hf,0,irev[0] as i32,irev[1] as i32,irev[2] as i32,dnf,dvr);
  return ans;
}

// ---- operator 5: ABSTRACT (extract the pattern: the interface
// relation plus the fold skeleton; concrete fold relations are
// discovered at runtime from the query's own chain) ----
fn mr_abstract(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let de:i32=st[ao+34] as i32;
  let dnf:i32=st[ao+37] as i32;
  let dvr:i32=st[ao+38] as i32;
  ex_p(ob,atp,"MR-SRC-ABS id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,de);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,dnf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,dvr);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"MR-PATTERN entry=");
  ex_pi(ob,atp,de);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,dnf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,dvr);
  ex_pnl(ob,atp);
  // entry-candidate collection: live facts with sub==s AND
  // rel==d_entry (the pattern's interface must match; no
  // interface adaptation happens here).
  let cands:[]u8=z_alloc(64);
  let ncu:i32=0;
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  while(fid<nf){
    ex_tick(st);
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==de){
          cands[ncu]=fid as u8;
          ncu=ncu+1;
        }
      }
    }
    fid=fid+1;
  }
  let ans:i32=-2;
  let won:i32=0;
  let ci:i32=0;
  while(ci<ncu){
    if(won==0){
      let cf:i32=cands[ci] as i32;
      let cfo:i32=16+cf*8;
      let u:i32=st[cfo+2] as i32;
      ex_p(ob,atp,"MR-ABS-CAND r=");
      ex_pi(ob,atp,de);
      ex_p(ob,atp," u=");
      ex_pi(ob,atp,u);
      let ff:[]u8=z_alloc(16);
      let p:i32=ex_foldwalk(st,u,dnf,dvr,ff);
      if(p==0){
        ex_p(ob,atp," FAIL-SHAPE\n");
      } else {
        let s1:i32=p%256;
        let s2:i32=(p/256)%256;
        let term:i32=(p/65536)%256;
        ex_p(ob,atp," SHAPE-OK term=");
        ex_pi(ob,atp,term);
        let ok:i32=1;
        if(term!=t){ok=0;}
        if(ok==1){
          let vv:i32=ex_valof(st,term,dvr);
          if(vv!=v){ok=0;}
        }
        if(ok==1){
          ex_p(ob,atp," VERIFY-OK\n");
          let zr:[]u8=z_alloc(32);
          let zf:[]u8=z_alloc(32);
          zr[0]=de as u8;
          zf[0]=cf as u8;
          let w:i32=0;
          while(w<2*dnf){
            if((w%2)==0){zr[1+w]=s1 as u8;}
            else {zr[1+w]=s2 as u8;}
            zf[1+w]=ff[w];
            w=w+1;
          }
          let zl:i32=1+2*dnf;
          ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,-1,zr,zf,zl,zr,zf,0,de,s1,s2,dnf,dvr);
          if(ans>=0){won=1;}
        } else {
          ex_p(ob,atp," VERIFY-FAIL\n");
        }
      }
    }
    ci=ci+1;
  }
  return ans;
}

// ---- operator 6: CONCRETIZE (instantiate a pattern MAP's
// skeleton with concrete values: any entry binding may fill
// the hole, fold relations are discovered at runtime and must
// be novel against the source structure's folds) ----
fn mr_concretize(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32)i32 {
  // pattern-source search: first live MAP in id order with
  // cap==qcap and d_entry==0 (the hole entry marks a pattern).
  let nm:i32=st[1] as i32;
  let pat:i32=-1;
  let done:i32=0;
  let mid:i32=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=464+mid*40;
      let mc:i32=st[o+33] as i32;
      let pde:i32=st[o+34] as i32;
      ex_p(ob,atp,"MR-PATSEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      ex_p(ob,atp," entry=");
      ex_pi(ob,atp,pde);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=qcap){hit=0;}
      }
      if(hit==1){
        if(pde!=0){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        pat=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  if(pat<0){
    ex_p(ob,atp,"MR-NO-PATTERN\n");
    return -2;
  }
  let po:i32=464+pat*40;
  let pnf:i32=st[po+37] as i32;
  let pvr:i32=st[po+38] as i32;
  let ao:i32=464+agg_src*40;
  let ar1:i32=st[ao+35] as i32;
  let ar2:i32=st[ao+36] as i32;
  ex_p(ob,atp,"MR-PATTERN-SRC id=");
  ex_pi(ob,atp,pat);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,pnf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,pvr);
  ex_pnl(ob,atp);
  // entry-candidate collection: ALL live facts with sub==s
  // (any rel: the hole is concretized by whatever the query
  // start offers).
  let cands:[]u8=z_alloc(64);
  let candr:[]u8=z_alloc(64);
  let ncu:i32=0;
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  while(fid<nf){
    ex_tick(st);
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        cands[ncu]=fid as u8;
        candr[ncu]=st[fo+1];
        ncu=ncu+1;
      }
    }
    fid=fid+1;
  }
  let ans:i32=-2;
  let won:i32=0;
  let ci:i32=0;
  while(ci<ncu){
    if(won==0){
      let cf:i32=cands[ci] as i32;
      let cr:i32=candr[ci] as i32;
      let cfo:i32=16+cf*8;
      let u:i32=st[cfo+2] as i32;
      ex_p(ob,atp,"MR-CONC-CAND r=");
      ex_pi(ob,atp,cr);
      ex_p(ob,atp," u=");
      ex_pi(ob,atp,u);
      let ff:[]u8=z_alloc(16);
      let p:i32=ex_foldwalk(st,u,pnf,pvr,ff);
      if(p==0){
        ex_p(ob,atp," FAIL-SHAPE\n");
      } else {
        let s1:i32=p%256;
        let s2:i32=(p/256)%256;
        let term:i32=(p/65536)%256;
        ex_p(ob,atp," SHAPE-OK term=");
        ex_pi(ob,atp,term);
        let ok:i32=1;
        let oldf:i32=0;
        if(s1==ar1){
          if(s2==ar2){oldf=1;}
        }
        if(oldf==1){
          ex_p(ob,atp," OLD-FOLDS");
          ok=0;
        }
        if(ok==1){
          if(term!=t){ok=0;}
        }
        if(ok==1){
          let vv:i32=ex_valof(st,term,pvr);
          if(vv!=v){ok=0;}
        }
        if(ok==1){
          ex_p(ob,atp," VERIFY-OK\n");
          let zr:[]u8=z_alloc(32);
          let zf:[]u8=z_alloc(32);
          zr[0]=cr as u8;
          zf[0]=cf as u8;
          let w:i32=0;
          while(w<2*pnf){
            if((w%2)==0){zr[1+w]=s1 as u8;}
            else {zr[1+w]=s2 as u8;}
            zf[1+w]=ff[w];
            w=w+1;
          }
          let zl:i32=1+2*pnf;
          ans=mr_buildwin(st,ob,atp,s,t,v,qdom,qcap,pat,-1,zr,zf,zl,zr,zf,0,cr,s1,s2,pnf,pvr);
          if(ans>=0){won=1;}
        } else {
          ex_p(ob,atp," VERIFY-FAIL\n");
        }
      }
    }
    ci=ci+1;
  }
  return ans;
}

// ---- fixed operator enumeration: the FIRST verifying
// operator wins. Mask bits: 1=COMBINE, 2=SUBSTITUTE,
// 4=TRUNCATE, 8=INVERT, 16=ABSTRACT, 32=CONCRETIZE
// (via (mask/n)%2, no bitwise ops).
// ---- operator epistemic standing (H-OP-ESS, this lane) ----
// Per (operator, context-signature) cells [SUC,FAIL,STRK,QTOUCH]
// at 1488+((op-1)*32+sig)*4. STANDING_MODE at 2256 (0=UNGATED,
// 1=STANDING, 2=GLOBAL, 3=RIVAL), TRIEDMASK at 2260.
fn mr_standing_arm(st:[]u8, mode:i32)void {
  set32(st,2256,mode);
  return;
}
// Context signature from learner-observable structure features:
// em = entry-match flag (any live fact with sub==s and
// rel==d_entry of agg_src), nf = d_nf clamped to 0..7,
// pat = 1 iff d_entry==0. sig = em*16 + nf*2 + pat.
fn st_sig(st:[]u8, s:i32, agg_src:i32)i32 {
  let ao:i32=464+agg_src*40;
  let de:i32=st[ao+34] as i32;
  let dnf:i32=st[ao+37] as i32;
  let em:i32=0;
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  while(fid<nf){
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==de){em=1;}
      }
    }
    fid=fid+1;
  }
  let pat:i32=0;
  if(de==0){pat=1;}
  let nn:i32=dnf;
  if(nn>7){nn=7;}
  if(nn<0){nn=0;}
  return (em*16)+(nn*2)+pat;
}
// Standing gate. Returns 0=try, 1=skip, 2=probation-try.
// Mode 3 (RIVAL): stateless pre-check for op 2 only.
fn st_standing_eval(st:[]u8, ob:[]u8, atp:[]u8, s:i32, agg_src:i32, op:i32, mode:i32)i32 {
  if(mode==0){return 0;}
  if(mode==3){
    if(op!=2){return 0;}
    let ao:i32=464+agg_src*40;
    let de:i32=st[ao+34] as i32;
    let nf:i32=st[0] as i32;
    let fid:i32=0;
    let found:i32=0;
    while(fid<nf){
      let fo:i32=16+fid*8;
      if((st[fo+3] as i32)==1){
        if((st[fo] as i32)==s){
          if((st[fo+1] as i32)!=de){found=1;}
        }
      }
      fid=fid+1;
    }
    if(found==0){
      ex_p(ob,atp,"MR-RIVAL-SKIP 2\n");
      return 1;
    }
    return 0;
  }
  let sig:i32=0;
  if(mode==1){sig=st_sig(st,s,agg_src);}
  let cell:i32=1488+((op-1)*32+sig)*4;
  let suc:i32=st[cell] as i32;
  let fail:i32=st[cell+1] as i32;
  let strk:i32=st[cell+2] as i32;
  let qt:i32=st[cell+3] as i32;
  if(qt<255){st[cell+3]=(qt+1) as u8;}
  qt=qt+1;
  let struck:i32=0;
  if(strk>=3){struck=1;}
  else {
    if(suc*2<fail){struck=1;}
  }
  if(struck==0){return 0;}
  if(qt>=8){
    st[cell+3]=0;
    return 2;
  }
  ex_p(ob,atp,"MR-OP-STANDING-SKIP ");
  ex_pi(ob,atp,op);
  ex_pnl(ob,atp);
  return 1;
}
// Post-query standing update (learner write path). For each tried
// op (TRIEDMASK bit set): commit -> success update; tried but not
// committed -> failure update. Untried ops: no update.
fn op_standing_update(st:[]u8, ob:[]u8, atp:[]u8, s:i32, agg_src:i32, mode:i32)void {
  if(mode!=1){
    if(mode!=2){return;}
  }
  let sig:i32=0;
  if(mode==1){sig=st_sig(st,s,agg_src);}
  let tried:i32=get32(st,2260);
  let committed:i32=get32(st,1472);
  let decided:i32=get32(st,1480);
  let op:i32=1;
  while(op<=6){
    let bit:i32=1<<(op-1);
    if(((tried/bit)%2)==1){
      let cell:i32=1488+((op-1)*32+sig)*4;
      let suc:i32=st[cell] as i32;
      let fail:i32=st[cell+1] as i32;
      let iswin:i32=0;
      if(decided==1){
        if(op==committed){iswin=1;}
      }
      if(iswin==1){
        let ns:i32=suc+8;
        if(ns>255){ns=255;}
        st[cell]=ns as u8;
        st[cell+2]=0;
        st[cell+1]=(fail/2) as u8;
      } else {
        let nfl:i32=fail+4;
        if(nfl>255){nfl=255;}
        st[cell+1]=nfl as u8;
        let nst:i32=(st[cell+2] as i32)+1;
        if(nst>255){nst=255;}
        st[cell+2]=nst as u8;
      }
      ex_p(ob,atp,"MR-STANDING-UPD op=");
      ex_pi(ob,atp,op);
      ex_p(ob,atp," sig=");
      ex_pi(ob,atp,sig);
      ex_p(ob,atp," suc=");
      ex_pi(ob,atp,st[cell] as i32);
      ex_p(ob,atp," fail=");
      ex_pi(ob,atp,st[cell+1] as i32);
      ex_p(ob,atp," strk=");
      ex_pi(ob,atp,st[cell+2] as i32);
      ex_pnl(ob,atp);
    }
    op=op+1;
  }
  return;
}
fn mr_adapt(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32, op_mask:i32)i32 {
  set32(st,1484,op_mask);
  set32(st,2260,0);
  let stmode:i32=get32(st,2256);
  let ans:i32=-2;
  let done:i32=0;
  if(done==0){
    if((op_mask%2)==1){
      let sev1:i32=st_standing_eval(st,ob,atp,s,agg_src,1,stmode);
      if(sev1!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|1);
        if(sev1==2){
          ex_p(ob,atp,"MR-OP-PROBATION 1\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 1\n");
        }
        ans=mr_combine(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,1);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 1\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 1\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 1\n");
    }
  }
  if(done==0){
    if(((op_mask/2)%2)==1){
      let sev2:i32=st_standing_eval(st,ob,atp,s,agg_src,2,stmode);
      if(sev2!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|2);
        if(sev2==2){
          ex_p(ob,atp,"MR-OP-PROBATION 2\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 2\n");
        }
        ans=mr_substitute(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,2);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 2\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 2\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 2\n");
    }
  }
  if(done==0){
    if(((op_mask/4)%2)==1){
      let sev3:i32=st_standing_eval(st,ob,atp,s,agg_src,3,stmode);
      if(sev3!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|4);
        if(sev3==2){
          ex_p(ob,atp,"MR-OP-PROBATION 3\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 3\n");
        }
        ans=mr_truncate(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,3);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 3\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 3\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 3\n");
    }
  }
  if(done==0){
    if(((op_mask/8)%2)==1){
      let sev4:i32=st_standing_eval(st,ob,atp,s,agg_src,4,stmode);
      if(sev4!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|8);
        if(sev4==2){
          ex_p(ob,atp,"MR-OP-PROBATION 4\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 4\n");
        }
        ans=mr_invert(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,4);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 4\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 4\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 4\n");
    }
  }
  if(done==0){
    if(((op_mask/16)%2)==1){
      let sev5:i32=st_standing_eval(st,ob,atp,s,agg_src,5,stmode);
      if(sev5!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|16);
        if(sev5==2){
          ex_p(ob,atp,"MR-OP-PROBATION 5\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 5\n");
        }
        ans=mr_abstract(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,5);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 5\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 5\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 5\n");
    }
  }
  if(done==0){
    if(((op_mask/32)%2)==1){
      let sev6:i32=st_standing_eval(st,ob,atp,s,agg_src,6,stmode);
      if(sev6!=1){
        set32(st,1476,get32(st,1476)+1);
        set32(st,2260,get32(st,2260)|32);
        if(sev6==2){
          ex_p(ob,atp,"MR-OP-PROBATION 6\n");
        } else {
          ex_p(ob,atp,"MR-OP-TRY 6\n");
        }
        ans=mr_concretize(st,ob,atp,s,t,v,qdom,qcap,agg_src);
        if(ans>=0){
          set32(st,1472,6);
          set32(st,1480,1);
          ex_p(ob,atp,"MR-OP-OK 6\n");
          done=1;
        } else {
          ex_p(ob,atp,"MR-OP-FAIL 6\n");
        }
      }
    } else {
      ex_p(ob,atp,"MR-OP-SKIP 6\n");
    }
  }
  return ans;
}

// ---- deliver: answer-node provenance + ANS print ----
fn ex_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1440,val);
  set32(st,1468,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  let ao:i32=1360+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  ex_p(ob,atp,"ANS term=");
  ex_pi(ob,atp,term);
  ex_p(ob,atp," val=");
  ex_pi(ob,atp,val);
  ex_p(ob,atp," via=");
  ex_pi(ob,atp,mid);
  ex_pnl(ob,atp);
  return;
}

// ---- query: pipeline, then the meta-reuse phase on failure ----
fn ex_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, op_mask:i32)i32 {
  st[12]=0;
  set32(st,1440,-2);
  set32(st,1468,-2);
  set32(st,1464,0);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=464+mid*40;
      let vr2:i32=st[mo+38] as i32;
      let mdir:i32=st[mo+39] as i32;
      if(mdir==1){
        let ff0:i32=st[mo+20] as i32;
        vv=st[16+ff0*8+2] as i32;
      } else {
        if(vr2!=0){vv=ex_valof(st,r,vr2);}
      }
      set32(st,1464,1);
      ex_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // meta-reuse phase
  st[11]=1;
  st[12]=1;
  set32(st,1432,0);
  set32(st,1436,0);
  set32(st,1444,-1);
  set32(st,1448,-1);
  set32(st,1452,-1);
  set32(st,1456,0);
  set32(st,1460,0);
  set32(st,1472,-1);
  set32(st,1476,0);
  set32(st,1480,0);
  ex_p(ob,atp,"MR-QUERY s=");
  ex_pi(ob,atp,s);
  ex_p(ob,atp," t=");
  ex_pi(ob,atp,t);
  ex_p(ob,atp," v=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," cap=");
  ex_pi(ob,atp,cap);
  ex_p(ob,atp," dom=");
  ex_pi(ob,atp,dom);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"MR-PIPELINE-FAIL\n");
  // AGG-source search: first live MAP with cap==qcap (any domain)
  let agg_src:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=464+mid*40;
      let mc:i32=st[o+33] as i32;
      ex_p(ob,atp,"MR-ASEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=cap){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        agg_src=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(agg_src>=0){
    ans=mr_adapt(st,ob,atp,s,t,v,dom,cap,agg_src,op_mask);
    op_standing_update(st,ob,atp,s,agg_src,get32(st,2256));
  } else {
    ex_p(ob,atp,"MR-NO-SRC\n");
  }
  st[11]=0;
  if(ans<0){
    ex_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1440,-2);
    set32(st,1468,-2);
  }
  return ans;
}

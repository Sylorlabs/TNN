// ---- binding-contract dump (B1): per-tag admission contracts ----
// Format: BCONTRACT tag=<t> induct=1 clause=(field,xform,lo,hi)
// active=<a> dc=<d>   or   BCONTRACT tag=<t> induct=0
fn dump_bcontracts(b:[]u8,c:i32,L:[]u8,S:[]u8)i32 {
  let bi:i32=0;
  while(bi<8){
    let tag:i32=get32(L,12744+bi*4);
    if(tag!=0){
      let cb:i32=2000+bi*100;
      c=o_app(b,c,"BCONTRACT tag=");
      c=o_i64(b,c,tag as i64);
      if(sg(S,cb+1)==1){
        c=o_app(b,c," induct=1 clause=(");
        c=o_i64(b,c,sg(S,cb+4) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+5) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+7) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+8) as i64);
        c=o_app(b,c,") active=");
        c=o_i64(b,c,sg(S,cb+9) as i64);
        c=o_app(b,c," dc=");
        c=o_i64(b,c,sg(S,cb+10) as i64);
      }
      if(sg(S,cb+1)==0){
        c=o_app(b,c," induct=0");
      }
      c=o_nl(b,c);
    }
    bi=bi+1;
  }
  return c;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one count episode ----
fn run_cntep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,id:i32,ep:i32)i32 {
  cnt_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let subj:i32=get32(rb,4);
  let n:i32=cnt_episode(L,A,rel,subj,K,tout,seen);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," cnt n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_808: independent all-generic reference composition ----
// need order: pattern, chain template, count. Uses only ret_gen,
// vfy_gen, cnt_gen.
fn oracle_808(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,1,0);
  let npass:i32=0;
  let pass:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns);
    let i:i32=0;
    while(i<ns){
      let s:i32=need_f(G,1,1+i*3);
      if(s==0){ s=sub; }
      set32(tmpc,4+i*12,s);
      set32(tmpc,4+i*12+4,need_f(G,1,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,1,1+i*3+2));
      i=i+1;
    }
    let vv:i32=vfy_gen(A,tmpc,K,4);
    if(vv==1){
      set32(pass,4+npass*4,sub);
      npass=npass+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass);
  let q3:i32=0;
  while(q3<npass){
    ans_append(oans,get32(pass,4+q3*4));
    q3=q3+1;
  }
  let rel2:i32=need_f(G,2,0);
  let cc:i32=cnt_gen(A,rel2,pass,4,npass,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,cc);
  return;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn oracle_dia(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns2:i32=need_f(G,2,0);
  let npass2:i32=0;
  let pass2:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub2:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns2);
    let i:i32=0;
    while(i<ns2){
      let s2:i32=need_f(G,2,1+i*3);
      if(s2==0){ s2=sub2; }
      set32(tmpc,4+i*12,s2);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv2:i32=vfy_gen(A,tmpc,K,4);
    if(vv2==1){
      set32(pass2,4+npass2*4,sub2);
      npass2=npass2+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass2);
  let q3:i32=0;
  while(q3<npass2){
    ans_append(oans,get32(pass2,4+q3*4));
    q3=q3+1;
  }
  let ns1:i32=need_f(G,1,0);
  let npass1:i32=0;
  let pass1:[]u8=z_alloc(160);
  let q4:i32=0;
  while(q4<nc){
    let sub1:i32=get32(tout,4+q4*4);
    set32(tmpc,0,ns1);
    let j:i32=0;
    while(j<ns1){
      let s1:i32=need_f(G,1,1+j*3);
      if(s1==0){ s1=sub1; }
      set32(tmpc,4+j*12,s1);
      set32(tmpc,4+j*12+4,need_f(G,1,1+j*3+1));
      set32(tmpc,4+j*12+8,need_f(G,1,1+j*3+2));
      j=j+1;
    }
    let vv1:i32=vfy_gen(A,tmpc,K,4);
    if(vv1==1){
      set32(pass1,4+npass1*4,sub1);
      npass1=npass1+1;
    }
    q4=q4+1;
  }
  ans_append(oans,npass1);
  let q5:i32=0;
  while(q5<npass1){
    ans_append(oans,get32(pass1,4+q5*4));
    q5=q5+1;
  }
  let rel3:i32=need_f(G,3,0);
  let cat:[]u8=z_alloc(160);
  let tot:i32=0;
  let q6:i32=0;
  while(q6<npass1){
    set32(cat,4+tot*4,get32(pass1,4+q6*4));
    tot=tot+1;
    q6=q6+1;
  }
  let q7:i32=0;
  while(q7<npass2){
    set32(cat,4+tot*4,get32(pass2,4+q7*4));
    tot=tot+1;
    q7=q7+1;
  }
  let ccd:i32=cnt_gen(A,rel3,cat,4,tot,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,ccd);
  return;
}
// ---- oracle_809: independent all-generic reference composition ----
// need order: count (literal subject), pattern (rel pivoted from the
// count need's input field 0), chain template over retrieve output.
fn oracle_809(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let relA:i32=need_f(G,0,0);
  let subj0:i32=need_f(G,0,2);
  let one:[]u8=z_alloc(16);
  set32(one,0,subj0);
  let c0:i32=cnt_gen(A,relA,one,0,1,K,4,seen);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,c0);
  let obj:i32=need_f(G,1,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,relA,obj,K,4,tout,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,2,0);
  let npass:i32=0;
  let pass:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns);
    let i:i32=0;
    while(i<ns){
      let s:i32=need_f(G,2,1+i*3);
      if(s==0){ s=sub; }
      set32(tmpc,4+i*12,s);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv:i32=vfy_gen(A,tmpc,K,4);
    if(vv==1){
      set32(pass,4+npass*4,sub);
      npass=npass+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass);
  let q3:i32=0;
  while(q3<npass){
    ans_append(oans,get32(pass,4+q3*4));
    q3=q3+1;
  }
  return;
}
// ---- oracle_812: independent all-generic reference composition ----
// need order: concrete chain, pattern (rel pivoted from the chain's
// step-0 relation), count over retrieve output subjects.
fn oracle_812(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  let relC:i32=need_f(G,0,2);
  let obj:i32=need_f(G,1,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,relC,obj,K,4,tout,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let rel2:i32=need_f(G,2,0);
  let cc:i32=cnt_gen(A,rel2,tout,4,nc,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,cc);
  return;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Ported from INTEGRATION-STRESS (okind 2). ----
fn oracle_1ret(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_1vfy: independent all-generic reference for a single ----
// ---- VERIFY need. Answer record matches the learner's [1, vv]. ----
// ---- Ported from INTEGRATION-STRESS (okind 3). ----
fn oracle_1vfy(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  return;
}
// ---- zero the global contract counters for a clean per-stage ----
// ---- reading. Ported from INTEGRATION-STRESS. ----
fn zero_counters(S:[]u8)void {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1);
  ss(S,912,0); ss(S,916,0); ss(S,920,0); ss(S,924,0);
  ss(S,7,500);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
fn do_query(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32)i32 {
  // SELFTRIG: C_Q (S slot 7) ticks once per query. Bounded
  // self-correction: up to 3 attempts; after a disagreeing attempt
  // that used spec versions, the composer invalidates the
  // spec-routing coverage contracts (trigger B) and retries. On a
  // first-try agree this path emits nothing extra, so pre-drift
  // output is byte-identical to C455.
  ss(S,7,sg(S,7)+1);
  // STALE-INDEX: proactive recovery. When the S14 battery arms the
  // flag (S+930), check the world epoch against the recorded spec
  // epochs and re-specialize stale specs BEFORE compose runs, so no
  // spec procedure ever reads a stale index. Flag is 0 through Acts
  // 1/2, leaving the regression byte-identical.
  if(sg(S,930)==1){
    let sifm:i32=spec_ensure_fresh(L,S,A);
    set32(L,14020,sifm);
  }
  let att:i32=1;
  while(att<=3){
    set32(K,0,0);
    set32(K,4,0);
    let hf0:i32=get32(L,13276);
    let st:i32=compose(L,S,A,G,K,ans,vbuf);
    // COMBINED: report a plan-invalidation hook fire. compose stashes
    // the hook telemetry at L+13276..13296; the cursor cannot thread
    // through compose (it returns only the st code), so do_query
    // emits the HOOK line when it observes the fire count increase.
    if(get32(L,13276)>hf0){
      c=o_app(b,c,"HOOK gtag=");
      c=o_i64(b,c,get32(L,13280) as i64);
      c=o_app(b,c," need=");
      c=o_i64(b,c,get32(L,13284) as i64);
      c=o_app(b,c," tag=");
      c=o_i64(b,c,get32(L,13288) as i64);
      c=o_app(b,c," oldfam=");
      c=o_i64(b,c,get32(L,13292) as i64);
      c=o_app(b,c," newfam=");
      c=o_i64(b,c,get32(L,13296) as i64);
      c=o_nl(b,c);
    }
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    if(st==0){
      c=o_app(b,c," goal=");
      c=o_i64(b,c,g_tag(G) as i64);
      c=o_app(b,c," decline=1");
      c=o_nl(b,c);
      return c;
    }
    set32(K,4,0);
    if(okind==0){ oracle_808(A,G,K,oans,seen); }
    if(okind==1){ oracle_dia(A,G,K,oans,seen); }
    if(okind==2){ oracle_1ret(A,G,K,oans,seen); }
    if(okind==3){ oracle_1vfy(A,G,K,oans,seen); }
    // HOOK-COMPOSITION: Act 3 uses the ported 3-need oracle.
    if(okind==4){ oracle_rvr(A,G,K,oans,seen); }
    let cs:i32=get32(K,0);
    let cg:i32=get32(K,4);
    let a:i32=ans_eq(ans,oans);
    set32(L,13240,get32(L,13240)+a);
    set32(L,13244,get32(L,13244)+cs);
    set32(L,13248,get32(L,13248)+cg);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," st=");
    c=o_i64(b,c,st as i64);
    c=o_app(b,c," vers=");
    let nn:i32=get32(vbuf,16);
    let p:i32=0;
    while(p<nn){
      if(p>0){ b[c]=44; c=c+1; }
      c=o_i64(b,c,get32(vbuf,p*4) as i64);
      p=p+1;
    }
    c=o_app(b,c," ans=");
    let an:i32=get32(ans,0);
    c=o_i64(b,c,an as i64);
    b[c]=58; c=c+1;
    let k:i32=0;
    while(k<an){
      if(k>0){ b[c]=44; c=c+1; }
      c=o_i64(b,c,get32(ans,4+k*4) as i64);
      k=k+1;
    }
    c=o_app(b,c," agree=");
    c=o_i64(b,c,a as i64);
    c=o_app(b,c," cs=");
    c=o_i64(b,c,cs as i64);
    c=o_app(b,c," cg=");
    c=o_i64(b,c,cg as i64);
    c=o_nl(b,c);
    if(a==1){ return c; }
    let specused:i32=0;
    let q2:i32=0;
    while(q2<nn){
      let vv:i32=get32(vbuf,q2*4);
      if(vv==2){ specused=1; }
      if(vv==3){ specused=1; }
      if(vv==5){ specused=1; }
      q2=q2+1;
    }
    if(specused==0){ return c; }
    if(att>=3){ return c; }
    c=note_answer_disagree(b,c,S,vbuf,att);
    att=att+1;
  }
  return c;
}
// ---- S9A: BIND-REVISE demo (B1: binding revision under ----
// ---- counterevidence). The live binding contract of slot bi=1 is
// ---- revised after real trials contradict its commitment. All values
// ---- runtime-derived (tag from the directory, rel from the CNT
// ---- coverage clause). Judgment=1 in the probes is the standing
// ---- commitment's verdict (P0 protocol; the actual u_check reads
// ---- 1,1,0 across the probes as the clause retires).
fn demo_bind_revise(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1);
  ss(S,912,0); ss(S,916,0); ss(S,920,0); ss(S,924,0);
  ss(S,7,500);
  let bi9:i32=1;
  let tag9:i32=get32(L,12744+bi9*4);
  let cb9:i32=2000+bi9*100;
  let rel9:i32=sg(S,3200+7);
  let G9:[]u8=z_alloc(256);
  let o9:i32=w_begin(G9,0,1);
  o9=w_need(G9,o9,tag9,3);
  o9=w_f(G9,o9,rel9);
  o9=w_f(G9,o9,1);
  o9=w_f(G9,o9,0);
  o9=w_links(G9,o9,0);
  let r0:i32=try_family(L,A,0,G9,0,K,tout,tmpc,seen);
  let r1:i32=try_family(L,A,1,G9,0,K,tout,tmpc,seen);
  let r2:i32=try_family(L,A,2,G9,0,K,tout,tmpc,seen);
  u_invalidate(S,cb9,1,0);
  u_invalidate(S,cb9,1,0);
  u_invalidate(S,cb9,1,0);
  let dc9:i32=sg(S,cb9+10);
  let act9:i32=sg(S,cb9+9);
  let req9:i32=sg(S,901);
  ss(S,300,2);
  let na9:i32=0;
  if(r0==1){ jt_acc2(S,na9,tag9,0); na9=na9+1; }
  if(r1==1){ jt_acc2(S,na9,tag9,1); na9=na9+1; }
  if(r2==1){ jt_acc2(S,na9,tag9,2); na9=na9+1; }
  ss(S,301,na9);
  let nr9:i32=0;
  if(r0==0){ jt_rej2(S,nr9,tag9,0); nr9=nr9+1; }
  if(r1==0){ jt_rej2(S,nr9,tag9,1); nr9=nr9+1; }
  if(r2==0){ jt_rej2(S,nr9,tag9,2); nr9=nr9+1; }
  ss(S,302,nr9);
  u_revise(S,cb9,1);
  let oe9:i32=sg(S,924);
  let rc9:i32=sg(S,904);
  c=o_app(b,c,"BINDREV tag=");
  c=o_i64(b,c,tag9 as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dc9 as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,act9 as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,req9 as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,oe9 as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,rc9 as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cb9+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb9+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb9+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb9+8) as i64);
  c=o_app(b,c,") route2=");
  c=o_i64(b,c,u_check(S,cb9,2,tag9,2,0,0,0,0) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb9,2,tag9,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb9,2,tag9,0,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,r0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,r1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,r2 as i64);
  c=o_nl(b,c);
  return c;
}
// ---- S9B: COV-REVISE demo (B2: coverage drift revision). The live ----
// ---- RET coverage contract is inducted on the old world, goes stale
// ---- under a real world shift, is invalidated by observed absence,
// ---- and is revised after fresh episodes. All values
// ---- runtime-derived (vocabs from fact scans, rels/objs from scans,
// ---- probe rel from the old clause).
fn demo_cov_revise(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,seen:[]u8,rb:[]u8)i32 {
  setup_worldA(S,A);
  let eid:i32=0;
  while(eid<4){
    ret_ep_pat(eid,rb,0);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    eid=eid+1;
  }
  specialize_ret(L,S,A,0,3);
  let avb:[]u8=z_alloc(64);
  let nav:i32=vocab_scan(A,avb);
  c=o_app(b,c,"COVOLD n=");
  c=o_i64(b,c,nav as i64);
  c=o_app(b,c," route=");
  let vo:i32=0;
  while(vo<nav){
    if(vo>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,u_check(S,3000,1,get32(avb,vo*4),0,0,0,0,0) as i64);
    vo=vo+1;
  }
  c=o_nl(b,c);
  setup_worldB(S,A);
  let bvb:[]u8=z_alloc(64);
  let nbv:i32=vocab_scan(A,bvb);
  let rp:i32=sg(S,3000+7);
  let inb:i32=0;
  let q:i32=0;
  while(q<nbv){
    if(get32(bvb,q*4)==rp){ inb=1; }
    q=q+1;
  }
  let conseq:i32=0;
  if(inb==1){ conseq=1; }
  let ck0:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  let ck1:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  let ck2:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  c=o_app(b,c,"COVPROBE rp=");
  c=o_i64(b,c,rp as i64);
  c=o_app(b,c," chk=");
  c=o_i64(b,c,ck0 as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,ck1 as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,ck2 as i64);
  c=o_app(b,c," inv=3 dc=");
  c=o_i64(b,c,sg(S,3000+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,3000+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_nl(b,c);
  let w0:i32=get32(L,0);
  let e2:i32=0;
  while(e2<2){
    let rl2:i32=get32(bvb,e2*4);
    let ob2:i32=first_obj(A,rl2);
    ret_episode(L,A,rl2,ob2,K,tout);
    e2=e2+1;
  }
  let n3:i32=get32(L,0);
  let ac3:[]u8=z_alloc(64);
  let na3:i32=0;
  let a3:i32=w0;
  while(a3<n3){
    set32(ac3,na3*4,get32(L,4+a3*4));
    na3=na3+1;
    a3=a3+1;
  }
  let uni:[]u8=z_alloc(128);
  let nu:i32=0;
  let u1:i32=0;
  while(u1<nav){
    set32(uni,nu*4,get32(avb,u1*4));
    nu=nu+1;
    u1=u1+1;
  }
  let u2:i32=0;
  while(u2<nbv){
    let r2b:i32=get32(bvb,u2*4);
    let k2:i32=0;
    let s2:i32=0;
    while(k2<nu){
      if(get32(uni,k2*4)==r2b){ s2=1; }
      k2=k2+1;
    }
    if(s2==0){
      set32(uni,nu*4,r2b);
      nu=nu+1;
    }
    u2=u2+1;
  }
  let rj3:[]u8=z_alloc(128);
  let nr3:i32=0;
  let u3:i32=0;
  while(u3<nu){
    let ru:i32=get32(uni,u3*4);
    let k3:i32=0;
    let s3:i32=0;
    while(k3<na3){
      if(get32(ac3,k3*4)==ru){ s3=1; }
      k3=k3+1;
    }
    if(s3==0){
      set32(rj3,nr3*4,ru);
      nr3=nr3+1;
    }
    u3=u3+1;
  }
  jt_load_cov(S,ac3,na3,rj3,nr3);
  u_revise(S,3000,1);
  c=o_app(b,c,"COVREV olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,3000+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+8) as i64);
  c=o_app(b,c,") route701=");
  c=o_i64(b,c,u_check(S,3000,1,get32(bvb,0),0,0,0,0,0) as i64);
  c=o_app(b,c," route702=");
  c=o_i64(b,c,u_check(S,3000,1,get32(bvb,4),0,0,0,0,0) as i64);
  c=o_app(b,c," route601=");
  c=o_i64(b,c,u_check(S,3000,1,rp,0,0,0,0,0) as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"COVCNT total=");
  c=o_i64(b,c,sg(S,916) as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,sg(S,912) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," fiterr=");
  c=o_i64(b,c,sg(S,920) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- emit_revise: report one coverage contract's revision state ----
// ---- after a specialize (olderr from slot 924, revcount from 904,
// ---- clause fields and activity read live).
fn emit_revise(b:[]u8,c:i32,S:[]u8,cbase:i32,fam:[]u8)i32 {
  c=o_app(b,c,"REVISE fam=");
  c=o_app(b,c,fam);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cbase+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cbase+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cbase+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cbase+8) as i64);
  c=o_app(b,c,") active=");
  c=o_i64(b,c,sg(S,cbase+9) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- HOOK-COMPOSITION port: generalization battery from ----
// ---- INTEGRATION-HOOK-GENERALIZE (gen_main.zag), verbatim logic. ----
// ---- oracle_rvr plus the G1/G2/G3 goal builders and stage ----
// ---- functions. Act 3 (S12) exercises the multi-need, ----
// ---- coverage-aware, retirement-capable hook inside the combined ----
// ---- binary. No identifiers: all tags/rels/objs/goals are derived ----
// ---- at runtime in S12A.
// ---- oracle_rvr: independent all-generic reference for the G1 ----
// ---- 3-need goal. Needs are independent (no links); the plan order
// ---- for a link-free goal is reverse goal order, so records emit
// ---- need2, need1, need0. Dispatch is shape-driven: nf==2 ret_gen,
// ---- nf==7 vfy_gen on the chain. Uses only generic procedures.
fn oracle_rvr(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  set32(oans,0,0);
  let p:i32=0;
  while(p<3){
    let ni:i32=2-p;
    let nf:i32=need_nf(G,ni);
    if(nf==2){
      let tout:[]u8=z_alloc(160);
      let nc:i32=ret_gen(A,need_f(G,ni,0),need_f(G,ni,1),K,4,tout,0);
      ans_append(oans,nc);
      let k:i32=0;
      while(k<nc){
        ans_append(oans,get32(tout,4+k*4));
        k=k+1;
      }
    }
    if(nf==7){
      let tmpc:[]u8=chain_new();
      let ns:i32=need_f(G,ni,0);
      set32(tmpc,0,ns);
      let i:i32=0;
      while(i<ns){
        set32(tmpc,4+i*12,need_f(G,ni,1+i*3));
        set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
        set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
        i=i+1;
      }
      let vv:i32=vfy_gen(A,tmpc,K,4);
      ans_append(oans,1);
      ans_append(oans,vv);
    }
    p=p+1;
  }
  return;
}
// ---- clause block for a bound tag: scan the binding table.
fn tag_cb(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,12744+bi*4)==tag){ return 2000+bi*100; }
    bi=bi+1;
  }
  return -1;
}
// ---- 1-need RET-shape goal builder.
fn mk_g1need(G:[]u8,gt:i32,tag:i32,rel:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,2); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- 1-need chain-shape goal builder (revision trials).
fn mk_gchain(G:[]u8,gt:i32,tag:i32,rel:i32,subj:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,7); o=w_f(G,o,2);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- G1 goal builder: 3 needs, no links. need0 (t1, RET (rA,oA));
// ---- need1 (t2, chain [(sC,rC,oC),(sC,rC,oC)]); need2 (t3, RET
// ---- (rC,oC)). Plan order for link-free goals is [2,1,0], so the
// ---- t2 need sits at interior plan position p=1.
fn mk_g1(G:[]u8,gt:i32,t1:i32,t2:i32,t3:i32,rA:i32,oA:i32,rC:i32,sC:i32,oC:i32)void {
  let o:i32=w_begin(G,gt,3);
  o=w_need(G,o,t1,2); o=w_f(G,o,rA); o=w_f(G,o,oA);
  o=w_need(G,o,t2,7); o=w_f(G,o,2);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_need(G,o,t3,2); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_links(G,o,0);
  return;
}
// ---- G1-PREBIND: induct T2's binding to fam 0 via learn_bindings
// ---- directly (no query, no plan row).
fn stage_g1_prebind(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,r601:i32,o601:i32,gt:i32)i32 {
  let Gp:[]u8=z_alloc(256);
  mk_g1need(Gp,gt,t2,r601,o601);
  learn_bindings(L,S,A,Gp,K,tout,tmpc,seen);
  c=o_app(b,c,"G1-PREBIND tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," fam=");
  c=o_i64(b,c,bind_fam(L,S,t2) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G1-REVISION: flip T2's binding 0->1 on chain-shape trials.
fn stage_g1_revision(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,rC:i32,sC:i32,oC:i32,gt:i32)i32 {
  zero_counters(S);
  let Gr:[]u8=z_alloc(256);
  mk_gchain(Gr,gt,t2,rC,sC,oC);
  let cb:i32=tag_cb(L,t2);
  let tr0:i32=try_family(L,A,0,Gr,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,Gr,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,Gr,0,K,tout,tmpc,seen);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  let dcX:i32=sg(S,cb+10);
  let actX:i32=sg(S,cb+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t2,1);
  ss(S,301,1);
  jt_rej2(S,0,t2,0);
  jt_rej2(S,1,t2,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G1-REV tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t2,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t2,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t2,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G2-COVREV: revise the RET coverage contract (3000) to admit
// ---- r602 only. Binding contracts are untouched.
fn stage_g2_covrev(b:[]u8,c:i32,L:[]u8,S:[]u8,r601:i32,r602:i32)i32 {
  zero_counters(S);
  let acc:[]u8=z_alloc(64);
  let rej:[]u8=z_alloc(64);
  set32(acc,0,r602);
  set32(rej,0,r601);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  let dcX:i32=sg(S,3000+10);
  let actX:i32=sg(S,3000+9);
  let reqX:i32=sg(S,901);
  jt_load_cov(S,acc,1,rej,1);
  u_revise(S,3000,1);
  c=o_app(b,c,"G2-COVREV dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route601=");
  c=o_i64(b,c,u_check(S,3000,1,r601,0,0,0,0,0) as i64);
  c=o_app(b,c," route602=");
  c=o_i64(b,c,u_check(S,3000,1,r602,0,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RETIRE: retire T4's clause with 2 disconfirmations (no
// ---- revision latch: pure retirement-without-revision).
fn stage_g3_retire(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  zero_counters(S);
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  c=o_app(b,c,"G3-RET tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RESTORE: latch the revision request and re-induct T4->0.
fn stage_g3_restore(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t4,0);
  ss(S,301,1);
  jt_rej2(S,0,t4,1);
  jt_rej2(S,1,t4,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G3-REV tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t4,0,0,0,0,0) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t4,1,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t4,2,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
// hq1_probe_body: RESEARCHER-WRITTEN probe body for the HP-P1
// dispatch probe. Installed via fn bits into the hook slot; this
// exercises dispatch only and is menu selection, NOT invention
// (A2.2 is gated on the EXECUTE ruling). Counts fires in S cell
// 1065 and stashes the last payload (p0, p1, p2) in S cells
// 1066, 1067, 1068.
fn hq1_probe_body(S:[]u8,A:[]u8,p0:i32,p1:i32,p2:i32)void {
  set32(S,1065*4,get32(S,1065*4)+1);
  set32(S,1066*4,p0);
  set32(S,1067*4,p1);
  set32(S,1068*4,p2);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let pg1:[]u8=z_alloc(64);
  let pg2:[]u8=z_alloc(64);
  // S1A RET-LEARN (world A)
  setup_worldA(S,A);
  c=o_app(B,c,"STAGE S1A RET-LEARN"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,S,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  // S1B VFY-LEARN (world A)
  c=o_app(B,c,"STAGE S1B VFY-LEARN"); c=o_nl(B,c);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,S,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S1C CNT-LEARN (world A)
  c=o_app(B,c,"STAGE S1C CNT-LEARN"); c=o_nl(B,c);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,0,8);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,1,9);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,2,10);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,3,11);
  specialize_cnt(L,S,A,8,11);
  c=spec_line_cnt(B,c,L);
  c=dump_lstate_cnt(B,c,L);
  // S2 DIAMOND-DIVERGE (world A)
  c=o_app(B,c,"STAGE S2 DIAMOND-DIVERGE"); c=o_nl(B,c);
  mk_goal813_E0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0",1);
  c=dump_bcontracts(B,c,L,S);
  c=dump_plans(B,c,L);
  // S3 DIAMOND-CONVERGE (world A)
  c=o_app(B,c,"STAGE S3 DIAMOND-CONVERGE"); c=o_nl(B,c);
  mk_goal814_E1(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E1",1);
  c=dump_plans(B,c,L);
  // S4 CHAIN-REGRESS (world A)
  c=o_app(B,c,"STAGE S4 CHAIN-REGRESS"); c=o_nl(B,c);
  mk_goal808_A0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"R0",0);
  c=dump_plans(B,c,L);
  // S5 DIAMOND-SHIFTB (world B; all coverages cleared)
  setup_worldB(S,A);
  ret_cov_clear(L,S);
  vfy_cov_clear(L,S);
  cnt_cov_clear(L,S);
  c=o_app(B,c,"STAGE S5 DIAMOND-SHIFTB"); c=o_nl(B,c);
  mk_goal815_B0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B0",1);
  // S6 DIAMOND-REVISEB: count episodes on B, re-specialize count
  c=o_app(B,c,"STAGE S6 DIAMOND-REVISEB"); c=o_nl(B,c);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,4,12);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,5,13);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,6,14);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,7,15);
  specialize_cnt(L,S,A,12,15);
  c=spec_line_cnt(B,c,L);
  c=dump_lstate_cnt(B,c,L);
  mk_goal815_B0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B1",1);
  // S7 DECLINE-NOVEL
  c=o_app(B,c,"STAGE S7 DECLINE-NOVEL"); c=o_nl(B,c);
  mk_goal810(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"X",0);
  c=dump_bcontracts(B,c,L,S);
  // S8 REDERIVE: clear plans + bindings, rebuild, byte-compare.
  // Snapshot the plan of the goal being rebuilt (via its runtime tag,
  // no literals), not merely the first plan entry.
  c=o_app(B,c,"STAGE S8 REDERIVE"); c=o_nl(B,c);
  mk_goal815_B0(G);
  let gt8:i32=g_tag(G);
  let pi8:i32=plan_find(L,gt8);
  let k8:i32=0;
  while(k8<14){
    set32(pg1,k8*4,get32(L,13000+pi8*56+k8*4));
    k8=k8+1;
  }
  clear_plans(L);
  clear_bindings(L,S);
  mk_goal815_B0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"S8",1);
  let pi9:i32=plan_find(L,g_tag(G));
  let k9:i32=0;
  while(k9<14){
    set32(pg2,k9*4,get32(L,13000+pi9*56+k9*4));
    k9=k9+1;
  }
  let m:i32=1;
  let k:i32=0;
  while(k<14){
    if(get32(pg1,k*4)!=get32(pg2,k*4)){ m=0; }
    k=k+1;
  }
  c=o_app(B,c,"REDERIVE match=");
  c=o_i64(B,c,m as i64);
  c=o_nl(B,c);
  // SUMMARY
  c=o_app(B,c,"SUMMARY-DIAMOND agree=");
  c=o_i64(B,c,get32(L,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,13248) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,13252) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,13256) as i64);
  c=o_app(B,c," vs=");
  c=o_i64(B,c,get32(L,13260) as i64);
  c=o_app(B,c," vg=");
  c=o_i64(B,c,get32(L,13264) as i64);
  c=o_app(B,c," cts=");
  c=o_i64(B,c,get32(L,13268) as i64);
  c=o_app(B,c," ctg=");
  c=o_i64(B,c,get32(L,13272) as i64);
  c=o_nl(B,c);
  // S9A BIND-REVISE: binding revision under counterevidence (B1).
  c=o_app(B,c,"STAGE S9A BIND-REVISE"); c=o_nl(B,c);
  let tmpc:[]u8=z_alloc(512);
  c=demo_bind_revise(B,c,L,S,A,K,tout,tmpc,seen);
  // S9B COV-REVISE: coverage drift revision (B2).
  c=o_app(B,c,"STAGE S9B COV-REVISE"); c=o_nl(B,c);
  c=demo_cov_revise(B,c,L,S,A,K,tout,seen,rb);
  // S10A LEARN: fresh composer state (L2/S2); world A; mirrors C455 S1.
  c=o_app(B,c,"STAGE S10A LEARN"); c=o_nl(B,c);
  let L2:[]u8=z_alloc(16384);
  let S2:[]u8=z_alloc(16384);
  // The u_invalidate protocol stamps first_detect (slot 908) only
  // when 908<0; preset the unset marker (as the S9 demos do) so the
  // live latch records the C_Q clock value.
  ss(S2,908,-1);
  setup_worldA(S2,A);
  let e10:i32=0;
  while(e10<4){
    ret_ep_pat(e10,rb,0);
    ret_episode(L2,A,get32(rb,0),get32(rb,4),K,tout);
    e10=e10+1;
  }
  specialize_ret(L2,S2,A,0,3);
  e10=0;
  while(e10<4){
    vfy_ep_chain(Cb,e10);
    vfy_episode(L2,A,Cb,K);
    e10=e10+1;
  }
  specialize_vfy(L2,S2,A,4,7);
  e10=0;
  while(e10<4){
    cnt_ep_pat(e10,rb,0);
    cnt_episode(L2,A,get32(rb,0),get32(rb,4),K,tout,seen);
    e10=e10+1;
  }
  specialize_cnt(L2,S2,A,8,11);
  // S10B BASELINE: C433 goals on the fresh state.
  c=o_app(B,c,"STAGE S10B BASELINE"); c=o_nl(B,c);
  mk_goal813_E0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"E0",1);
  mk_goal808_A0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"R0",0);
  c=dump_bcontracts(B,c,L2,S2);
  // S10C DRIFT-INJECT: rearrange the world between queries. No
  // clearing, no re-specialize: this is the drift.
  c=o_app(B,c,"STAGE S10C DRIFT-INJECT"); c=o_nl(B,c);
  setup_worldA2(S2,A);
  c=o_app(B,c,"DRIFT world=A2"); c=o_nl(B,c);
  // S10D DRIFT-QUERIES: live path with bounded self-correction.
  c=o_app(B,c,"STAGE S10D DRIFT-QUERIES"); c=o_nl(B,c);
  mk_goal813_E0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"E0",1);
  mk_goal808_A0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"R0",0);
  // S10E REVISE: re-log on the drifted world, re-specialize. The
  // latched revision request turns each re-induct into a revise.
  c=o_app(B,c,"STAGE S10E REVISE"); c=o_nl(B,c);
  e10=0;
  while(e10<2){
    ret_ep_pat(e10,rb,0);
    ret_episode(L2,A,get32(rb,0),get32(rb,4),K,tout);
    e10=e10+1;
  }
  specialize_ret(L2,S2,A,0,1);
  c=emit_revise(B,c,S2,3000,"ret");
  e10=0;
  while(e10<2){
    vfy_ep_chain(Cb,e10);
    vfy_episode(L2,A,Cb,K);
    e10=e10+1;
  }
  specialize_vfy(L2,S2,A,0,1);
  c=emit_revise(B,c,S2,3100,"vfy");
  e10=0;
  while(e10<2){
    cnt_ep_pat(e10,rb,0);
    cnt_episode(L2,A,get32(rb,0),get32(rb,4),K,tout,seen);
    e10=e10+1;
  }
  specialize_cnt(L2,S2,A,0,1);
  c=emit_revise(B,c,S2,3200,"cnt");
  // S10F RECOVER: goals after the self-triggered revision.
  c=o_app(B,c,"STAGE S10F RECOVER"); c=o_nl(B,c);
  mk_goal813_E0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"E0",1);
  mk_goal808_A0(G);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"R0",0);
  c=o_app(B,c,"SUMMARY-DRIFT agree=");
  c=o_i64(B,c,get32(L2,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L2,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L2,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L2,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L2,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L2,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L2,13248) as i64);
  c=o_nl(B,c);
  // S11A COLLISION-SETUP: B1 tag-shape collision on the post-drift
  // state (L2/S2). The world stays A2 (the drift world); the tag
  // directory and binding contracts are S10A's. zero_counters
  // re-arms the global counters (C_Q=500) for clean per-stage
  // readings. All derived values come from runtime scans.
  c=o_app(B,c,"STAGE S11A COLLISION-SETUP"); c=o_nl(B,c);
  zero_counters(S2);
  let tagC:i32=get32(L2,12744+0*4);
  let cb0:i32=2000+0*100;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let relC2:i32=get32(avb,0);
  let subjC:i32=first_subj(A,relC2);
  let objC:i32=first_obj(A,relC2);
  let G0:[]u8=z_alloc(256);
  mk_goal813_E0(G0);
  let gtD:i32=g_tag(G0)+5;
  // S11B STALE-QUERY: a VERIFY-shaped need (nf=4) reuses tagC, which
  // is bound to RETRIEVE. The stale binding misroutes end-to-end
  // through the live do_query path (okind 3: oracle_1vfy).
  c=o_app(B,c,"STAGE S11B STALE-QUERY"); c=o_nl(B,c);
  let o11:i32=w_begin(G,gtD,1);
  o11=w_need(G,o11,tagC,4);
  o11=w_f(G,o11,1);
  o11=w_f(G,o11,subjC);
  o11=w_f(G,o11,relC2);
  o11=w_f(G,o11,objC);
  o11=w_links(G,o11,0);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"QD0",3);
  // S11C BIND-REVISE: staged counterevidence against the stale
  // binding, exactly as in INTEGRATION-STRESS IS-D: real
  // try_family trials, three u_invalidate probes, a fresh judgment
  // table from the trial outcomes, then u_revise. C_Q is re-armed
  // to 500 (QD0's live tick advanced it to 501; the reset is
  // apparatus) so the frozen first=500 matches IS-D exactly.
  c=o_app(B,c,"STAGE S11C BIND-REVISE"); c=o_nl(B,c);
  ss(S2,7,500);
  let tr0:i32=try_family(L2,A,0,G,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L2,A,1,G,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L2,A,2,G,0,K,tout,tmpc,seen);
  u_invalidate(S2,cb0,1,0);
  u_invalidate(S2,cb0,1,0);
  u_invalidate(S2,cb0,1,0);
  let dcX:i32=sg(S2,cb0+10);
  let actX:i32=sg(S2,cb0+9);
  let reqX:i32=sg(S2,901);
  ss(S2,300,2);
  let na11:i32=0;
  if(tr0==1){ jt_acc2(S2,na11,tagC,0); na11=na11+1; }
  if(tr1==1){ jt_acc2(S2,na11,tagC,1); na11=na11+1; }
  if(tr2==1){ jt_acc2(S2,na11,tagC,2); na11=na11+1; }
  ss(S2,301,na11);
  let nr11:i32=0;
  if(tr0==0){ jt_rej2(S2,nr11,tagC,0); nr11=nr11+1; }
  if(tr1==0){ jt_rej2(S2,nr11,tagC,1); nr11=nr11+1; }
  if(tr2==0){ jt_rej2(S2,nr11,tagC,2); nr11=nr11+1; }
  ss(S2,302,nr11);
  u_revise(S2,cb0,1);
  c=o_app(B,c,"ISD-REV tag=");
  c=o_i64(B,c,tagC as i64);
  c=o_app(B,c," probes=3 dc=");
  c=o_i64(B,c,dcX as i64);
  c=o_app(B,c," active=");
  c=o_i64(B,c,actX as i64);
  c=o_app(B,c," req=");
  c=o_i64(B,c,reqX as i64);
  c=o_app(B,c," olderr=");
  c=o_i64(B,c,sg(S2,924) as i64);
  c=o_app(B,c," revcount=");
  c=o_i64(B,c,sg(S2,904) as i64);
  c=o_app(B,c," nclause=(");
  c=o_i64(B,c,sg(S2,cb0+4) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,cb0+5) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,cb0+7) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,cb0+8) as i64);
  c=o_app(B,c,") route1=");

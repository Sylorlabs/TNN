  c=o_app(B,c,"ES-PROBE nf_stale=");
  c=o_i64(B,c,spec_nf_stale(L2,A) as i64);
  c=o_app(B,c," ck_stale=");
  c=o_i64(B,c,spec_ck_stale(L2,A) as i64);
  c=o_app(B,c," ver_stale=");
  c=o_i64(B,c,spec_ver_stale(L2,S2) as i64);
  c=o_nl(B,c);

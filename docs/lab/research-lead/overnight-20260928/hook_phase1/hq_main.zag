  c=o_app(B,c,"ES-AUTO entry_mask=");
  c=o_i64(B,c,get32(L2,14020) as i64);
  c=o_nl(B,c);
  ss(S2,930,0);
  let csD1:i32=get32(L2,13244);
  let cgD1:i32=get32(L2,13248);
  let stD1:i32=get32(L2,14012);

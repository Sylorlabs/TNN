  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ0B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ1B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ2B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ3B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ4B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ5B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ6B",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ7B",2);

  c=o_app(B,c," tr1=");
  c=o_i64(B,c,tr1 as i64);
  c=o_app(B,c," tr2=");
  c=o_i64(B,c,tr2 as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"ISD-CNT total=");
  c=o_i64(B,c,sg(S2,916) as i64);
  c=o_app(B,c," correct=");
  c=o_i64(B,c,sg(S2,912) as i64);
  c=o_app(B,c," revcount=");
  c=o_i64(B,c,sg(S2,904) as i64);
  c=o_app(B,c," first=");
  c=o_i64(B,c,sg(S2,908) as i64);
  c=o_app(B,c," olderr=");
  c=o_i64(B,c,sg(S2,924) as i64);
  c=o_app(B,c," fiterr=");
  c=o_i64(B,c,sg(S2,920) as i64);
  c=o_nl(B,c);
  // S11D HOOK-RECOVERY: live query on the rebuilt goal. There is no
  // clear_plans anywhere in the S11 path: the plan-invalidation
  // hook must detect the stale cached fam, invalidate the plan,
  // rebuild it, and agree.
  c=o_app(B,c,"STAGE S11D HOOK-RECOVERY"); c=o_nl(B,c);
  let o12:i32=w_begin(G,gtD,1);
  o12=w_need(G,o12,tagC,4);
  o12=w_f(G,o12,1);
  o12=w_f(G,o12,subjC);
  o12=w_f(G,o12,relC2);
  o12=w_f(G,o12,objC);
  o12=w_links(G,o12,0);
  c=do_query(B,c,L2,S2,A,K,G,ans,oans,vbuf,seen,"QD1",3);
  // SUMMARY-COLLISION: cumulative L2 stats plus the hook fire
  // count and the coverage-contract disconfirmation cells (which
  // the B1 revision must leave untouched).
  c=o_app(B,c,"SUMMARY-COLLISION agree=");
  c=o_i64(B,c,get32(L2,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L2,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L2,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L2,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L2,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L2,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L2,13248) as i64);
  c=o_app(B,c," hook=");
  c=o_i64(B,c,get32(L2,13276) as i64);
  c=o_app(B,c," covdc=");
  c=o_i64(B,c,sg(S2,3010) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,3110) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,3210) as i64);
  c=o_nl(B,c);
  // ---- Act 5 (ES): EPOCH-STRONG probe. No versioning installed: ----
  // ---- w_epoch_bump is a no-op and no mutation path stamps. The ----
  // ---- learner's machinery is byte-identical to LEARNER-EPOCH; ----
  // ---- this battery measures what it does with staleness-failure ----
  // ---- experience when the version signal is dead. ----
  c=o_app(B,c,"STAGE ES-A SETUP"); c=o_nl(B,c);
  let tagC14:i32=get32(L2,12744+0*4);
  setup_worldA(S2,A);
  specialize_ret(L2,S2,A,0,0);
  specialize_vfy(L2,S2,A,0,0);
  specialize_cnt(L2,S2,A,0,0);
  c=o_app(B,c,"ES-SETUP specworld=A liveworld=A"); c=o_nl(B,c);
  let avb14:[]u8=z_alloc(64);
  vocab_scan(A,avb14);
  let r601x:i32=get32(avb14,0);
  let o601x:i32=first_obj(A,r601x);
  let r603x:i32=get32(avb14,2*4);

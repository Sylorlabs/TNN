  c=o_i64(B,c,u_check(S2,cb0,2,tagC,0,0,0,0,0) as i64);
  c=o_app(B,c," route2=");
  c=o_i64(B,c,u_check(S2,cb0,2,tagC,2,0,0,0,0) as i64);

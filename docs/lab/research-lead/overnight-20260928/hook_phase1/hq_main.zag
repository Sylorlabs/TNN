  let gLE:i32=g_tag(g014)+7;
  let GSLE:[]u8=z_alloc(256);
  mk_g1need(GSLE,gLE,tLE,r601x,o601x);
  c=o_app(B,c,"STAGE ES-B N1-FAILURE-PROACTIVE-BLIND"); c=o_nl(B,c);
  setup_worldA2(S2,A);

  c=o_i64(B,c,get32(L2,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L2,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L2,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L2,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L2,13248) as i64);
  c=o_app(B,c," hook=");
  c=o_i64(B,c,get32(L2,13276) as i64);
  c=o_app(B,c," covdc=");
  c=o_i64(B,c,sg(S2,3010) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,3110) as i64);
  B[c]=44; c=c+1;
  c=o_i64(B,c,sg(S2,3210) as i64);
  c=o_app(B,c," steps=");
  c=o_i64(B,c,get32(L2,14012) as i64);
  c=o_nl(B,c);
  // ---- STAGE HP-P0: HOOK-PHASE0 infrastructure verification ----
  // A2.6 + A2.1 exercised the way learner code could exercise them.
  // Nothing here claims learning or invention: the bars test
  // substrate mechanics only.
  c=o_app(B,c,"STAGE HP-P0 INFRA-VERIFY"); c=o_nl(B,c);
  let hs2c:i32=sg(S2,932);
  let hsc:i32=sg(S,932);
  c=o_app(B,c,"HP-MUTCNT s2=");
  c=o_i64(B,c,hs2c as i64);
  c=o_app(B,c," s=");
  c=o_i64(B,c,hsc as i64);
  c=o_nl(B,c);
  // Guard probe: 70 stores into a scratch arena; only 64 land.
  // The probe triple is fact 0 of the live arena (runtime-derived).
  let hA3:[]u8=world_new();
  let hps0:i32=get32(A,4);
  let hpr0:i32=get32(A,8);
  let hpo0:i32=get32(A,12);
  let hgi:i32=0;
  while(hgi<70){
    fact_add(S2,hA3,hps0,hpr0,hpo0);
    hgi=hgi+1;
  }
  let hgc1:i32=sg(S2,932);
  c=o_app(B,c,"HP-GUARD c0=");
  c=o_i64(B,c,hs2c as i64);
  c=o_app(B,c," c1=");
  c=o_i64(B,c,hgc1 as i64);
  c=o_app(B,c," delta=");
  c=o_i64(B,c,(hgc1-hs2c) as i64);
  c=o_nl(B,c);
  // Alloc probe: bump math, cross-call persistence, exhaustion,
  // alignment, negative size.
  let ha1:i32=la_alloc(S2,16);
  let hwi:i32=0;
  while(hwi<4){
    set32(S2,ha1+hwi*4,hs2c+hwi);
    hwi=hwi+1;
  }
  let ha2:i32=la_alloc(S2,32);
  hwi=0;
  while(hwi<8){
    set32(S2,ha2+hwi*4,hs2c+100+hwi);
    hwi=hwi+1;
  }
  let hrd1:i32=1;
  hwi=0;
  while(hwi<4){
    if(get32(S2,ha1+hwi*4)!=hs2c+hwi){ hrd1=0; }
    hwi=hwi+1;
  }
  let ha3:i32=la_alloc(S2,400);
  let ha4:i32=la_alloc(S2,7);
  let ha5:i32=la_alloc(S2,-5);
  let hrd2:i32=1;
  hwi=0;
  while(hwi<8){
    if(get32(S2,ha2+hwi*4)!=hs2c+100+hwi){ hrd2=0; }
    hwi=hwi+1;
  }
  c=o_app(B,c,"HP-ALLOC a1=");
  c=o_i64(B,c,ha1 as i64);
  c=o_app(B,c," a2=");
  c=o_i64(B,c,ha2 as i64);
  c=o_app(B,c," a3=");
  c=o_i64(B,c,ha3 as i64);
  c=o_app(B,c," a4=");
  c=o_i64(B,c,ha4 as i64);
  c=o_app(B,c," a5=");
  c=o_i64(B,c,ha5 as i64);
  c=o_app(B,c," rd1=");
  c=o_i64(B,c,hrd1 as i64);
  c=o_app(B,c," rd2=");
  c=o_i64(B,c,hrd2 as i64);
  c=o_nl(B,c);
  // Registry probe: two entries round-trip, then fill to full.
  // Tags are runtime-derived (r601x from the ES-A vocab scan).
  let he0:i32=la_reg(S2,ha1,r601x,ha1,hs2c);
  let he1:i32=la_reg(S2,ha2,r601x,ha2,hs2c);
  let hr0:i32=1;
  if(sg(S2,1030)!=ha1){ hr0=0; }
  if(sg(S2,1031)!=r601x){ hr0=0; }
  if(sg(S2,1032)!=ha1){ hr0=0; }
  if(sg(S2,1033)!=hs2c){ hr0=0; }
  let hr1:i32=1;
  if(sg(S2,1034)!=ha2){ hr1=0; }
  if(sg(S2,1035)!=r601x){ hr1=0; }
  if(sg(S2,1036)!=ha2){ hr1=0; }
  if(sg(S2,1037)!=hs2c){ hr1=0; }
  let hfi:i32=0;
  while(hfi<6){
    la_reg(S2,ha4,r601x,hfi,hfi);
    hfi=hfi+1;
  }
  let hfull:i32=la_reg(S2,ha4,r601x,9,9);
  c=o_app(B,c,"HP-REG e0=");
  c=o_i64(B,c,he0 as i64);
  c=o_app(B,c," e1=");
  c=o_i64(B,c,he1 as i64);
  c=o_app(B,c," r0=");
  c=o_i64(B,c,hr0 as i64);
  c=o_app(B,c," r1=");
  c=o_i64(B,c,hr1 as i64);
  c=o_app(B,c," full=");
  c=o_i64(B,c,hfull as i64);
  c=o_nl(B,c);
  let haok:i32=1;
  if(ha1!=3736){ haok=0; }
  if(ha2!=3752){ haok=0; }
  if(ha3!=-1){ haok=0; }
  if(ha4!=3784){ haok=0; }
  if(ha5!=-1){ haok=0; }
  if(hrd1!=1){ haok=0; }
  if(hrd2!=1){ haok=0; }
  let hrok:i32=1;
  if(he0!=0){ hrok=0; }
  if(he1!=1){ hrok=0; }
  if(hr0!=1){ hrok=0; }
  if(hr1!=1){ hrok=0; }
  if(hfull!=-1){ hrok=0; }
  c=o_app(B,c,"SUMMARY-HOOKPHASE0 mutcnt=");
  c=o_i64(B,c,hs2c as i64);
  c=o_app(B,c," alloc_ok=");
  c=o_i64(B,c,haok as i64);
  c=o_app(B,c," reg_ok=");
  c=o_i64(B,c,hrok as i64);
  c=o_nl(B,c);
  // ---- STAGE HP-P1: HOOK-PHASE1 inert dispatch verification ----
  // Dispatch infrastructure only. The installed body is
  // RESEARCHER-WRITTEN (menu selection); nothing here claims
  // invention. Strong-sense hook use is gated on A2.2.
  c=o_app(B,c,"STAGE HP-P1 HOOK-DISPATCH"); c=o_nl(B,c);
  let hS3:[]u8=z_alloc(16384);
  let hA0:[]u8=world_new();
  let hA4:[]u8=world_new();
  // f0: slot default 0 on the zeroed arena; one add and one set_obj
  // fire nothing on either consult path.
  fact_add(hS3,hA0,hps0,hpr0,hpo0);
  fact_set_obj(hS3,hA4,0,hpo0);
  let hf0:i32=sg(hS3,1065);
  // Install the researcher-written probe body via fn bits.
  hk_install(hS3,hq1_probe_body as i64);
  // 70 adds: 64 stored (guard), 6 rejected; the hook fires per store.
  let hqi:i32=0;
  while(hqi<70){
    fact_add(hS3,hA4,hps0,hpr0,hpo0);
    hqi=hqi+1;
  }
  let hf1:i32=sg(hS3,1065);
  let hap0:i32=sg(hS3,1066);
  let hap1:i32=sg(hS3,1067);
  let hap2:i32=sg(hS3,1068);
  // fact_set_obj consult path: 3 calls, payload (idx, 0, o) with
  // o=hs2c (runtime-derived).
  fact_set_obj(hS3,hA4,0,hs2c);
  fact_set_obj(hS3,hA4,1,hs2c);
  fact_set_obj(hS3,hA4,2,hs2c);
  let hf2:i32=sg(hS3,1065);
  let hlp0:i32=sg(hS3,1066);
  let hlp1:i32=sg(hS3,1067);
  let hlp2:i32=sg(hS3,1068);
  // Uninstall: slot back to 0; 5 adds on a fresh arena plus 2
  // set_obj calls would fire 7 times if the slot were still live.
  hk_uninstall(hS3);
  let hA5:[]u8=world_new();
  hqi=0;
  while(hqi<5){
    fact_add(hS3,hA5,hps0,hpr0,hpo0);
    hqi=hqi+1;
  }
  fact_set_obj(hS3,hA4,0,hs2c);
  fact_set_obj(hS3,hA4,1,hs2c);
  let hf3:i32=sg(hS3,1065);
  c=o_app(B,c,"HP-HOOK f0=");
  c=o_i64(B,c,hf0 as i64);
  c=o_app(B,c," f1=");
  c=o_i64(B,c,hf1 as i64);
  c=o_app(B,c," f2=");
  c=o_i64(B,c,hf2 as i64);
  c=o_app(B,c," f3=");
  c=o_i64(B,c,hf3 as i64);
  c=o_app(B,c," ap0=");
  c=o_i64(B,c,hap0 as i64);
  c=o_app(B,c," ap1=");
  c=o_i64(B,c,hap1 as i64);
  c=o_app(B,c," ap2=");
  c=o_i64(B,c,hap2 as i64);
  c=o_app(B,c," lp0=");
  c=o_i64(B,c,hlp0 as i64);
  c=o_app(B,c," lp1=");
  c=o_i64(B,c,hlp1 as i64);
  c=o_app(B,c," lp2=");
  c=o_i64(B,c,hlp2 as i64);
  c=o_nl(B,c);
  let hdok:i32=1;
  if(hf0!=0){ hdok=0; }
  if(hf1!=64){ hdok=0; }
  if(hf2!=67){ hdok=0; }
  if(hf3!=67){ hdok=0; }
  if(hap0!=hps0){ hdok=0; }
  if(hap1!=hpr0){ hdok=0; }
  if(hap2!=hpo0){ hdok=0; }
  if(hlp0!=2){ hdok=0; }
  if(hlp1!=0){ hdok=0; }
  if(hlp2!=hs2c){ hdok=0; }
  c=o_app(B,c,"SUMMARY-HOOKPHASE1 dispatch_ok=");
  c=o_i64(B,c,hdok as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

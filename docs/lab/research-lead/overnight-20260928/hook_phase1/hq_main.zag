  c=o_app(B,c," ver_stale=");
  c=o_i64(B,c,spec_ver_stale(L2,S2) as i64);
  c=o_nl(B,c);
  let csB0:i32=get32(L2,13244);
  let cgB0:i32=get32(L2,13248);
  let stB0:i32=get32(L2,14012);
  ss(S2,930,1);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ0",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ1",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ2",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ3",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ4",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ5",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ6",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ7",2);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ8",2);
  c=o_app(B,c,"ES-AUTO entry_mask=");
  c=o_i64(B,c,get32(L2,14020) as i64);
  c=o_nl(B,c);
  ss(S2,930,0);
  let csB1:i32=get32(L2,13244);
  let cgB1:i32=get32(L2,13248);
  let stB1:i32=get32(L2,14012);
  let esBq:i32=(csB1-csB0)+(cgB1-cgB0);
  let esBs:i32=stB1-stB0;
  let esBt:i32=esBq+esBs;
  set32(L2,14036,esBt);
  c=o_app(B,c,"ES-COST arm=proactive-blind q=");
  c=o_i64(B,c,esBq as i64);
  c=o_app(B,c," steps=");
  c=o_i64(B,c,esBs as i64);
  c=o_app(B,c," total=");
  c=o_i64(B,c,esBt as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE ES-C ADVERSARIAL-SILENT"); c=o_nl(B,c);
  setup_worldA(S2,A);
  specialize_ret(L2,S2,A,0,0);
  specialize_vfy(L2,S2,A,0,0);
  specialize_cnt(L2,S2,A,0,0);
  let nfAx:i32=get32(A,0);
  let mjx:i32=0;
  let mj0x:i32=-1;
  let mj1x:i32=-1;
  while(mjx<nfAx){
    if(get32(A,4+mjx*12+4)==r603x){
      if(mj0x<0){ mj0x=mjx; } else { if(mj1x<0){ mj1x=mjx; } }
    }
    mjx=mjx+1;
  }
  let mo1x:i32=get32(A,4+mj1x*12+8);
  // EPOCH-STRONG: the in-place mutation goes through the learner's
  // world interface, but nothing stamps (no versioning installed).
  fact_set_obj(S2,A,mj0x,mo1x);
  c=o_app(B,c,"ES-MUTATE nf=");
  c=o_i64(B,c,nfAx as i64);
  c=o_app(B,c," dup_at=");
  c=o_i64(B,c,mj0x as i64);
  c=o_app(B,c," from=");
  c=o_i64(B,c,mj1x as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"ES-PROBE nf_stale=");
  c=o_i64(B,c,spec_nf_stale(L2,A) as i64);
  c=o_app(B,c," ck_stale=");
  c=o_i64(B,c,spec_ck_stale(L2,A) as i64);
  c=o_app(B,c," ver_stale=");
  c=o_i64(B,c,spec_ver_stale(L2,S2) as i64);
  c=o_nl(B,c);
  ss(S2,930,1);
  c=do_query(B,c,L2,S2,A,K,GSLE,ans,oans,vbuf,seen,"ESQ0A",2);
  c=o_app(B,c,"ES-AUTO entry_mask=");
  c=o_i64(B,c,get32(L2,14020) as i64);
  c=o_nl(B,c);
  ss(S2,930,0);
  c=o_app(B,c,"STAGE ES-D SECOND-EXPOSURE"); c=o_nl(B,c);
  setup_worldA2(S2,A);
  specialize_ret(L2,S2,A,0,0);
  specialize_vfy(L2,S2,A,0,0);

  c=o_app(B,c," steps=");
  c=o_i64(B,c,esDs as i64);
  c=o_app(B,c," total=");
  c=o_i64(B,c,esDt as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE ES-E NEUTRAL-MUTATION"); c=o_nl(B,c);
  setup_worldA(S2,A);
  specialize_ret(L2,S2,A,0,0);
  specialize_vfy(L2,S2,A,0,0);
  specialize_cnt(L2,S2,A,0,0);
  let ese0:i32=w_epoch_get(S2);
  let esck0:i32=world_ck(L2,A);

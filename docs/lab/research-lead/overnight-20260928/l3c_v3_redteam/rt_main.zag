fn main()i32{
  let mode:i32=1;
  let W:[]u8=z_alloc(65536);
  let s:i32=0;
  while(s<RULE_MAX()){ set32(W,rule_addr(s),-1); s=s+1; }
  emit("L3C-V3-REDTEAM mode=1\n");

  // ===== Attack A: RT3 three-element disjunction (sig 801) =====
  // Truth: out=0 iff f1==1 OR f1==5 OR f2==9.
  let a_b0:i32=get32(W,cnt_addr(3));
  let a_u0:i32=get32(W,cnt_addr(4));
  observe(W,801,2,3,0,0,7,mode);
  observe(W,801,2,3,0,0,7,mode);
  observe(W,801,2,3,2,2,7,mode);
  observe(W,801,2,3,2,2,7,mode);
  observe(W,801,0,3,1,0,7,mode);
  observe(W,801,0,3,5,0,7,mode);
  observe(W,801,0,3,0,9,7,mode);
  observe(W,801,0,3,1,0,7,mode);
  observe(W,801,0,3,5,0,7,mode);
  observe(W,801,0,3,0,9,7,mode);
  emit("RT_A built_delta=");
  emit(i32s(get32(W,cnt_addr(3))-a_b0));
  emit(" (expect 1)\n");
  emit("RT_A unresolved_delta=");
  emit(i32s(get32(W,cnt_addr(4))-a_u0));
  emit(" (expect 4)\n");
  let a_ok:i32=0;
  if(interp(W,rule_node(W,801),3,1,3,7,0)==0){a_ok=a_ok+1;}
  if(interp(W,rule_node(W,801),3,5,4,7,0)==0){a_ok=a_ok+1;}
  if(interp(W,rule_node(W,801),3,0,9,7,0)==0){a_ok=a_ok+1;}
  if(interp(W,rule_node(W,801),3,1,9,7,0)==0){a_ok=a_ok+1;}
  if(interp(W,rule_node(W,801),3,0,0,7,0)==2){a_ok=a_ok+1;}
  if(interp(W,rule_node(W,801),3,7,7,7,0)==2){a_ok=a_ok+1;}
  emit("RT_A truth_eval=");
  emit(i32s(a_ok));
  emit("/6 (expect 6)\n");

  // ===== Attack B: RTMIN2 minimality on genuine cover path (sig 802) =====
  // Truth: out=0 iff f1==1 OR f2==9. Unique minimal cover {(f1==1),(f2==9)}.
  let b_b0:i32=get32(W,cnt_addr(3));
  let b_u0:i32=get32(W,cnt_addr(4));
  observe(W,802,2,3,0,0,7,mode);
  observe(W,802,2,3,0,0,7,mode);
  observe(W,802,2,3,3,3,1,mode);
  observe(W,802,2,3,3,3,1,mode);
  observe(W,802,0,3,1,0,0,mode);
  observe(W,802,0,3,1,2,2,mode);
  observe(W,802,0,3,0,9,4,mode);
  observe(W,802,0,3,4,9,6,mode);
  observe(W,802,0,3,1,0,0,mode);
  observe(W,802,0,3,1,2,2,mode);
  observe(W,802,0,3,0,9,4,mode);
  observe(W,802,0,3,4,9,6,mode);
  emit("RT_B built_delta=");
  emit(i32s(get32(W,cnt_addr(3))-b_b0));
  emit(" (expect 1)\n");
  emit("RT_B unresolved_delta=");
  emit(i32s(get32(W,cnt_addr(4))-b_u0));
  emit(" (expect 6)\n");
  let b_ok:i32=0;
  if(interp(W,rule_node(W,802),3,1,5,5,0)==0){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,802),3,5,9,5,0)==0){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,802),3,0,0,7,0)==2){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,802),3,4,4,4,0)==2){b_ok=b_ok+1;}
  emit("RT_B truth_eval=");
  emit(i32s(b_ok));
  emit("/4 (expect 4)\n");

  // ===== Attack D: RTAMB3 three distinct minimal covers (sig 803) =====
  let d_b0:i32=get32(W,cnt_addr(3));
  let d_u0:i32=get32(W,cnt_addr(4));
  let d_g0:i32=get32(W,cnt_addr(5));
  observe(W,803,2,3,0,0,7,mode);
  observe(W,803,2,3,0,0,7,mode);
  observe(W,803,2,3,2,2,7,mode);
  observe(W,803,2,3,2,2,7,mode);
  observe(W,803,0,3,1,0,7,mode);
  observe(W,803,0,3,0,9,7,mode);
  observe(W,803,0,3,5,5,5,mode);
  observe(W,803,0,3,1,0,7,mode);
  observe(W,803,0,3,0,9,7,mode);
  observe(W,803,0,3,5,5,5,mode);
  emit("RT_D built_delta=");
  emit(i32s(get32(W,cnt_addr(3))-d_b0));
  emit(" (expect 0)\n");
  emit("RT_D unresolved_delta=");
  emit(i32s(get32(W,cnt_addr(4))-d_u0));
  emit(" (expect 4)\n");
  emit("RT_D ambig_delta=");
  emit(i32s(get32(W,cnt_addr(5))-d_g0));
  emit(" (expect 1)\n");

  emit("TOTAL events=");
  emit(i32s(get32(W,cnt_addr(2))));
  emit(" built=");
  emit(i32s(get32(W,cnt_addr(3))));
  emit(" unresolved=");
  emit(i32s(get32(W,cnt_addr(4))));
  emit(" ambig_events=");
  emit(i32s(get32(W,cnt_addr(5))));
  emit("\n");

  // ===== structure checks =====
  let d801:i32=rule_node(W,801);
  emit("CHK_A_disp=");
  if(node_kind(W,d801)==2){emit("PASS\n");} else {emit("FAIL\n");}
  emit("CHK_A_edges3=");
  if(lab_edge_n(W,d801)==3){
    if(def_edge_n(W,d801)==1){emit("PASS\n");} else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_A_atoms=");
  if(lab_atom_tgt0(W,d801,1,0,1)==1){
    if(lab_atom_tgt0(W,d801,1,0,5)==1){
      if(lab_atom_tgt0(W,d801,2,0,9)==1){
        if(def_tgt_term(W,d801,2)==1){emit("PASS\n");} else {emit("FAIL\n");}
      } else {emit("FAIL\n");}
    } else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_A_rep3=");
  let rs801:i32=rule_find(W,801);
  if(get32(W,rep_addr(rs801))==3){emit("PASS\n");} else {emit("FAIL\n");}

  let d802:i32=rule_node(W,802);
  emit("CHK_B_disp=");
  if(node_kind(W,d802)==2){emit("PASS\n");} else {emit("FAIL\n");}
  emit("CHK_B_edges2=");
  if(lab_edge_n(W,d802)==2){
    if(def_edge_n(W,d802)==1){emit("PASS\n");} else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_B_mincover=");
  if(lab_atom_tgt0(W,d802,1,0,1)==1){
    if(lab_atom_tgt0(W,d802,2,0,9)==1){
      if(def_tgt_term(W,d802,2)==1){emit("PASS\n");} else {emit("FAIL\n");}
    } else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_B_rep2=");
  let rs802:i32=rule_find(W,802);
  if(get32(W,rep_addr(rs802))==2){emit("PASS\n");} else {emit("FAIL\n");}

  emit("CHK_D_term=");
  if(node_kind(W,rule_node(W,803))==1){emit("PASS\n");} else {emit("FAIL\n");}
  emit("CHK_D_k3=");
  let rs803:i32=rule_find(W,803);
  if(get32(W,rule_addr(rs803)+16)==3){
    if(node_kind(W,rule_node(W,803))==1){emit("PASS\n");} else {emit("FAIL\n");}
  } else {emit("FAIL\n");}

  dump_graph(W);
  emit("END\n");
  return 0;
}

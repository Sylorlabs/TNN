// l3c_v2.zag -- L3C protocol v2: recursive form-constructing dispatcher.
// Prereg: PREREG_L3C_V2.md (frozen; committed alone as 9e595301a).
// Pure Zag. No Python.
// znc:allow A0102
//
// v2 replaces v1's fixed six-op construct() and first-hit disc() with
// generic construction machinery:
//  - build_chain: recursive constructor. Nesting depth of the emitted form
//    equals the arity of the discovered predicate; nested contradictions
//    re-point EDGE targets (not just the rule slot).
//  - disc2: compositional predicate search (single equalities, then
//    2-conjunctions, then inequalities with a frozen tightest-bound rule)
//    over the FULL per-signature observation history.
//  - deferred construction: EVID_MIN=2 corroborated contradictions.
//  - ambiguity representation: withhold + explicit AMBIGUOUS trace, never
//    first-hit fiat.
//  - principled memory: every observation retained in the per-sig log
//    (capacity 32 per sig, disclosed; frozen families use at most 6).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen layout ----
fn RULE_MAX()i32{return 16;}
fn RULE_SZ()i32{return 32;}
fn NODE_MAX()i32{return 64;}
fn EDGE_MAX()i32{return 64;}
fn HIST_MAX()i32{return 32;}
fn NCL_MAX()i32{return 8;}
fn rule_addr(s:i32)i32{return s*RULE_SZ();}
// rule slot: +0 sig, +4 node, +8 hist_n, +12 clash_n, +16 ambig,
//            +20 built_flag, +24 nclash_n, +28 last_attempt_n
fn node_addr(id:i32)i32{return 512+id*8;}
// node: +0 kind (1=TERM, 2=DISP), +4 val
fn edge_addr(e:i32)i32{return 1024+e*24;}
// edge: +0 from, +4 to, +8 lk (0 default, 1 labeled), +12 fi, +16 op, +20 fv
// op: 0=EQ, 1=GE, 2=LE
fn rep_addr(s:i32)i32{return 3072+s*32;}
// report: +0 natoms, atom i at +4+i*12: +0 fi, +4 op, +8 fv
fn cnt_addr(i:i32)i32{return 4096+i*4;}
// counters: 0 nodes, 1 edges, 2 events, 3 built, 4 unresolved, 5 ambig_events
fn hist_addr(s:i32,k:i32)i32{return 8192+s*640+k*20;}
// history vec: +0 f0, +4 f1, +8 f2, +12 f3, +16 out
fn ncl_addr(s:i32,r:i32)i32{return 18432+s*192+r*24;}
// nested-clash rec: +0 edge, +4 f0, +8 f1, +12 f2, +16 f3, +20 out
fn SCR_T()i32{return 22016;}
fn SCR_C()i32{return 22656;}
fn PRED()i32{return 23000;}
// predicate: +0 natoms, atom i at +4+i*12: +0 fi, +4 op, +8 fv
fn AMB()i32{return 23100;}
// ambiguity: +0 separator count k, competitor atom triples at +4+i*12
// (8 slots; a 2-conjunction competitor occupies 2 consecutive triples),
// +100 triple count t (t==k for single atoms, t==2k for conjunctions)
fn TMP()i32{return 23208;}
// temp node-id storage for build_chain
fn COVER()i32{return 23300;}
// cover scratch: +0 ncover, atom i at +4+i*12: +0 fi, +4 op, +8 fv
fn CAND()i32{return 23500;}
// candidate scratch: +0 ncand, cand i at +4+i*16: +0 fi, +4 op, +8 fv, +12 mask
fn EVID_MIN()i32{return 2;}
// per-element corroboration bar for cover atoms (matches deferred construction)

// ---- generic construction ops: the ONLY mutators of node/edge state ----
fn op_new_node(W:[]u8)i32{
  let id:i32=get32(W,cnt_addr(0));
  set32(W,cnt_addr(0),id+1);
  set32(W,node_addr(id),0);
  set32(W,node_addr(id)+4,0);
  return id;
}
fn op_mark_term(W:[]u8,id:i32,v:i32)void{
  set32(W,node_addr(id),1);
  set32(W,node_addr(id)+4,v);
  return;
}
fn op_mark_disp(W:[]u8,id:i32)void{
  set32(W,node_addr(id),2);
  set32(W,node_addr(id)+4,0);
  return;
}
fn op_new_edge(W:[]u8,from:i32,to:i32)i32{
  let e:i32=get32(W,cnt_addr(1));
  set32(W,cnt_addr(1),e+1);
  set32(W,edge_addr(e),from);
  set32(W,edge_addr(e)+4,to);
  set32(W,edge_addr(e)+8,0);
  set32(W,edge_addr(e)+12,0);
  set32(W,edge_addr(e)+16,0);
  set32(W,edge_addr(e)+20,0);
  return e;
}
fn op_label_edge(W:[]u8,eid:i32,fi:i32,op:i32,fv:i32)void{
  set32(W,edge_addr(eid)+8,1);
  set32(W,edge_addr(eid)+12,fi);
  set32(W,edge_addr(eid)+16,op);
  set32(W,edge_addr(eid)+20,fv);
  return;
}
fn edge_set_to(W:[]u8,e:i32,to:i32)void{
  set32(W,edge_addr(e)+4,to);
  return;
}

// ---- rule table ----
fn rule_find(W:[]u8,sig:i32)i32{
  let s:i32=0;
  while(s<RULE_MAX()){ if(get32(W,rule_addr(s))==sig){return s;} s=s+1; }
  return -1;
}
fn rule_link(W:[]u8,sig:i32,node:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){
    let t:i32=0;
    while(t<RULE_MAX()){
      if(get32(W,rule_addr(t))==-1){
        set32(W,rule_addr(t),sig);
        set32(W,rule_addr(t)+4,node);
        let j:i32=8;
        while(j<32){ set32(W,rule_addr(t)+j,0); j=j+4; }
        return t;
      }
      t=t+1;
    }
    return -1;
  }
  set32(W,rule_addr(s)+4,node);
  return s;
}
fn rule_node(W:[]u8,sig:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){return -1;}
  return get32(W,rule_addr(s)+4);
}

// ---- observation memory: full per-signature log (principled memory) ----
fn hist_append(W:[]u8,s:i32,f0:i32,f1:i32,f2:i32,f3:i32,out:i32)void{
  let n:i32=get32(W,rule_addr(s)+8);
  if(n<HIST_MAX()){
    let a:i32=hist_addr(s,n);
    set32(W,a,f0); set32(W,a+4,f1); set32(W,a+8,f2); set32(W,a+12,f3);
    set32(W,a+16,out);
    set32(W,rule_addr(s)+8,n+1);
  }
  return;
}
fn ncl_append(W:[]u8,s:i32,e:i32,f0:i32,f1:i32,f2:i32,f3:i32,out:i32)void{
  let n:i32=get32(W,rule_addr(s)+24);
  if(n<NCL_MAX()){
    let a:i32=ncl_addr(s,n);
    set32(W,a,e);
    set32(W,a+4,f0); set32(W,a+8,f1); set32(W,a+12,f2); set32(W,a+16,f3);
    set32(W,a+20,out);
    set32(W,rule_addr(s)+24,n+1);
  }
  return;
}
fn ncl_count_edge(W:[]u8,s:i32,e:i32)i32{
  let n:i32=get32(W,rule_addr(s)+24);
  let c:i32=0;
  let r:i32=0;
  while(r<n){
    if(get32(W,ncl_addr(s,r))==e){c=c+1;}
    r=r+1;
  }
  return c;
}
fn copy_vec(W:[]u8,src:i32,dst:i32)void{
  set32(W,dst,get32(W,src));
  set32(W,dst+4,get32(W,src+4));
  set32(W,dst+8,get32(W,src+8));
  set32(W,dst+12,get32(W,src+12));
  set32(W,dst+16,get32(W,src+16));
  return;
}

// ---- generic interpreter: one uniform edge-following path, recursive ----
fn featv(f0:i32,f1:i32,f2:i32,f3:i32,i:i32)i32{
  if(i==0){return f0;}
  if(i==1){return f1;}
  if(i==2){return f2;}
  return f3;
}
fn pred_match(fi:i32,op:i32,fv:i32,f0:i32,f1:i32,f2:i32,f3:i32)i32{
  let x:i32=featv(f0,f1,f2,f3,fi);
  if(op==0){ if(x==fv){return 1;} return 0; }
  if(op==1){ if(x<fv){return 0;} return 1; }
  if(x>fv){return 0;}
  return 1;
}
fn select_edge(W:[]u8,node:i32,f0:i32,f1:i32,f2:i32,f3:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  let def:i32=-1;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      let lk:i32=get32(W,edge_addr(e)+8);
      if(lk==0){
        if(def<0){def=e;}
      } else {
        let fi:i32=get32(W,edge_addr(e)+12);
        let op:i32=get32(W,edge_addr(e)+16);
        let fv:i32=get32(W,edge_addr(e)+20);
        if(pred_match(fi,op,fv,f0,f1,f2,f3)==1){return e;}
      }
    }
    e=e+1;
  }
  return def;
}
fn interp(W:[]u8,node:i32,f0:i32,f1:i32,f2:i32,f3:i32,depth:i32)i32{
  if(depth>8){return -9998;}
  let kind:i32=get32(W,node_addr(node));
  if(kind==1){return get32(W,node_addr(node)+4);}
  if(kind!=2){return -9999;}
  let e:i32=select_edge(W,node,f0,f1,f2,f3);
  if(e<0){return -9999;}
  return interp(W,get32(W,edge_addr(e)+4),f0,f1,f2,f3,depth+1);
}
fn trace_last_edge(W:[]u8,s:i32,f0:i32,f1:i32,f2:i32,f3:i32)i32{
  let node:i32=get32(W,rule_addr(s)+4);
  let last:i32=-1;
  let guard:i32=0;
  while(guard<16){
    let kind:i32=get32(W,node_addr(node));
    if(kind!=2){return last;}
    let e:i32=select_edge(W,node,f0,f1,f2,f3);
    if(e<0){return last;}
    last=e;
    node=get32(W,edge_addr(e)+4);
    guard=guard+1;
  }
  return last;
}
fn path_uses(W:[]u8,s:i32,et:i32,f0:i32,f1:i32,f2:i32,f3:i32)i32{
  let node:i32=get32(W,rule_addr(s)+4);
  let guard:i32=0;
  while(guard<16){
    let kind:i32=get32(W,node_addr(node));
    if(kind!=2){return 0;}
    let e:i32=select_edge(W,node,f0,f1,f2,f3);
    if(e<0){return 0;}
    if(e==et){return 1;}
    node=get32(W,edge_addr(e)+4);
    guard=guard+1;
  }
  return 0;
}

// ---- compositional discriminator over scratch buffers ----
fn sval(W:[]u8,base:i32,k:i32,fi:i32)i32{
  return get32(W,base+k*20+fi*4);
}
fn seen_before(W:[]u8,base:i32,fi:i32,v:i32,k:i32)i32{
  let j:i32=0;
  while(j<k){ if(sval(W,base,j,fi)==v){return 1;} j=j+1; }
  return 0;
}
fn separates1(W:[]u8,fi:i32,v:i32,tn:i32,cn:i32)i32{
  let k:i32=0;
  while(k<cn){ if(sval(W,SCR_C(),k,fi)!=v){return 0;} k=k+1; }
  let t:i32=0;
  while(t<tn){ if(sval(W,SCR_T(),t,fi)==v){return 0;} t=t+1; }
  return 1;
}
fn separates2(W:[]u8,fi:i32,v1:i32,fj:i32,v2:i32,tn:i32,cn:i32)i32{
  let k:i32=0;
  while(k<cn){
    if(sval(W,SCR_C(),k,fi)!=v1){return 0;}
    if(sval(W,SCR_C(),k,fj)!=v2){return 0;}
    k=k+1;
  }
  let t:i32=0;
  while(t<tn){
    if(sval(W,SCR_T(),t,fi)==v1){
      if(sval(W,SCR_T(),t,fj)==v2){return 0;}
    }
    t=t+1;
  }
  return 1;
}
fn cmin(W:[]u8,fi:i32,cn:i32)i32{
  let m:i32=sval(W,SCR_C(),0,fi);
  let k:i32=1;
  while(k<cn){ let v:i32=sval(W,SCR_C(),k,fi); if(v<m){m=v;} k=k+1; }
  return m;
}
fn cmax(W:[]u8,fi:i32,cn:i32)i32{
  let m:i32=sval(W,SCR_C(),0,fi);
  let k:i32=1;
  while(k<cn){ let v:i32=sval(W,SCR_C(),k,fi); if(v>m){m=v;} k=k+1; }
  return m;
}
fn tmin(W:[]u8,fi:i32,tn:i32)i32{
  let m:i32=sval(W,SCR_T(),0,fi);
  let k:i32=1;
  while(k<tn){ let v:i32=sval(W,SCR_T(),k,fi); if(v<m){m=v;} k=k+1; }
  return m;
}
fn tmax(W:[]u8,fi:i32,tn:i32)i32{
  let m:i32=sval(W,SCR_T(),0,fi);
  let k:i32=1;
  while(k<tn){ let v:i32=sval(W,SCR_T(),k,fi); if(v>m){m=v;} k=k+1; }
  return m;
}
fn pred_set1(W:[]u8,fi:i32,op:i32,fv:i32)void{
  set32(W,PRED()+4,fi);
  set32(W,PRED()+8,op);
  set32(W,PRED()+12,fv);
  return;
}
fn pred_set2(W:[]u8,fi:i32,v1:i32,fj:i32,v2:i32)void{
  pred_set1(W,fi,0,v1);
  set32(W,PRED()+16,fj);
  set32(W,PRED()+20,0);
  set32(W,PRED()+24,v2);
  return;
}
fn amb_reset(W:[]u8)void{
  set32(W,AMB(),0);
  return;
}
fn amb_push(W:[]u8,slot:i32,fi:i32,op:i32,fv:i32)void{
  if(slot<8){
    set32(W,AMB()+4+slot*12,fi);
    set32(W,AMB()+4+slot*12+4,op);
    set32(W,AMB()+4+slot*12+8,fv);
  }
  return;
}
// disc2: 0=NONE, 1=FOUND (predicate in PRED), 2=AMBIGUOUS (count in AMB)
fn disc2(W:[]u8,tn:i32,cn:i32)i32{
  if(tn<1){return 0;}
  if(cn<1){return 0;}
  amb_reset(W);
  // level 1: single equality atoms
  let nsep:i32=0;
  let fi:i32=0;
  while(fi<4){
    let k:i32=0;
    while(k<cn){
      let v:i32=sval(W,SCR_C(),k,fi);
      if(seen_before(W,SCR_C(),fi,v,k)==0){
        if(separates1(W,fi,v,tn,cn)==1){
          amb_push(W,nsep,fi,0,v);
          if(nsep==0){pred_set1(W,fi,0,v);}
          nsep=nsep+1;
        }
      }
      k=k+1;
    }
    fi=fi+1;
  }
  if(nsep==1){set32(W,PRED(),1); return 1;}
  if(nsep>1){set32(W,AMB(),nsep); set32(W,AMB()+100,nsep); return 2;}
  // level 2: conjunctions of 2 distinct-feature equality atoms
  nsep=0;
  fi=0;
  while(fi<4){
    let fj:i32=fi+1;
    while(fj<4){
      let k1:i32=0;
      while(k1<cn){
        let v1:i32=sval(W,SCR_C(),k1,fi);
        if(seen_before(W,SCR_C(),fi,v1,k1)==0){
          let k2:i32=0;
          while(k2<cn){
            let v2:i32=sval(W,SCR_C(),k2,fj);
            if(seen_before(W,SCR_C(),fj,v2,k2)==0){
              if(separates2(W,fi,v1,fj,v2,tn,cn)==1){
                amb_push(W,nsep*2,fi,0,v1);
                amb_push(W,nsep*2+1,fj,0,v2);
                if(nsep==0){pred_set2(W,fi,v1,fj,v2);}
                nsep=nsep+1;
              }
            }
            k2=k2+1;
          }
        }
        k1=k1+1;
      }
      fj=fj+1;
    }
    fi=fi+1;
  }
  if(nsep==1){set32(W,PRED(),2); return 1;}
  if(nsep>1){set32(W,AMB(),nsep); set32(W,AMB()+100,nsep*2); return 2;}
  // level 3: inequalities, frozen tightest-bound rule
  nsep=0;
  fi=0;
  while(fi<4){
    let l:i32=cmin(W,fi,cn);
    if(l>tmax(W,fi,tn)){
      amb_push(W,nsep,fi,1,l);
      if(nsep==0){pred_set1(W,fi,1,l);}
      nsep=nsep+1;
    }
    let u:i32=cmax(W,fi,cn);
    if(u<tmin(W,fi,tn)){
      amb_push(W,nsep,fi,2,u);
      if(nsep==0){pred_set1(W,fi,2,u);}
      nsep=nsep+1;
    }
    fi=fi+1;
  }
  if(nsep==1){set32(W,PRED(),1); return 1;}
  if(nsep>1){set32(W,AMB(),nsep); set32(W,AMB()+100,nsep); return 2;}
  return 0;
}

// ---- alternative-cover dispatch (v3): minimal set cover over the
// ---- existing separator vocabulary. No new semantic case, no new op,
// ---- no interpreter change. General learning operation, not OR-specific.
fn popcnt(x:i32)i32{
  let c:i32=0;
  let v:i32=x;
  while(v>0){
    if(v%2==1){c=c+1;}
    v=v/2;
  }
  return c;
}
fn bitset(s:i32,j:i32)i32{
  let p:i32=1;
  let i:i32=0;
  while(i<j){p=p*2;i=i+1;}
  let q:i32=s/p;
  if(q%2==1){return 1;}
  return 0;
}
fn bitor(a:i32,b:i32)i32{
  let r:i32=0;
  let p:i32=1;
  let x:i32=a;
  let y:i32=b;
  while(x>0){
    if(y>0){
      if(x%2==1){r=r+p;} else { if(y%2==1){r=r+p;} }
      y=y/2;
    } else {
      if(x%2==1){r=r+p;}
    }
    x=x/2;
    p=p*2;
  }
  while(y>0){
    if(y%2==1){r=r+p;}
    y=y/2;
    p=p*2;
  }
  return r;
}
fn cand_push(W:[]u8,fi:i32,op:i32,fv:i32,mask:i32)i32{
  let n:i32=get32(W,CAND());
  if(n>=12){return -1;}
  set32(W,CAND()+4+n*16,fi);
  set32(W,CAND()+4+n*16+4,op);
  set32(W,CAND()+4+n*16+8,fv);
  set32(W,CAND()+4+n*16+12,mask);
  set32(W,CAND(),n+1);
  return n;
}
fn atom_mask(W:[]u8,fi:i32,op:i32,fv:i32,base:i32,n:i32)i32{
  let m:i32=0;
  let k:i32=0;
  let bit:i32=1;
  while(k<n){
    let a:i32=base+k*20;
    if(pred_match(fi,op,fv,get32(W,a),get32(W,a+4),get32(W,a+8),get32(W,a+12))==1){
      m=m+bit;
    }
    bit=bit*2;
    k=k+1;
  }
  return m;
}
// disc_cover: 0=NONE, 1=FOUND (cover in COVER), 2=AMBIGUOUS (count in AMB)
fn disc_cover(W:[]u8,tn:i32,cn:i32)i32{
  if(tn<1){return 0;}
  if(cn<1){return 0;}
  if(cn>30){return 0;}
  set32(W,CAND(),0);
  set32(W,COVER(),0);
  // level 1: single equality atoms
  let fi:i32=0;
  while(fi<4){
    let k:i32=0;
    while(k<cn){
      let v:i32=sval(W,SCR_C(),k,fi);
      if(seen_before(W,SCR_C(),fi,v,k)==0){
        let cm:i32=atom_mask(W,fi,0,v,SCR_C(),cn);
        if(cm!=0){
          let tm:i32=atom_mask(W,fi,0,v,SCR_T(),tn);
          if(tm==0){
            if(popcnt(cm)>=EVID_MIN()){
              if(cand_push(W,fi,0,v,cm)<0){return 0;}
            }
          }
        }
      }
      k=k+1;
    }
    fi=fi+1;
  }
  // level 3: tightest-bound inequalities (same frozen rule as disc2)
  fi=0;
  while(fi<4){
    let l:i32=cmin(W,fi,cn);
    if(l>tmax(W,fi,tn)){
      let cm:i32=atom_mask(W,fi,1,l,SCR_C(),cn);
      if(cm!=0){
        let tm:i32=atom_mask(W,fi,1,l,SCR_T(),tn);
        if(tm==0){
          if(popcnt(cm)>=EVID_MIN()){
            if(cand_push(W,fi,1,l,cm)<0){return 0;}
          }
        }
      }
    }
    let u:i32=cmax(W,fi,cn);
    if(u<tmin(W,fi,tn)){
      let cm2:i32=atom_mask(W,fi,2,u,SCR_C(),cn);
      if(cm2!=0){
        let tm2:i32=atom_mask(W,fi,2,u,SCR_T(),tn);
        if(tm2==0){
          if(popcnt(cm2)>=EVID_MIN()){
            if(cand_push(W,fi,2,u,cm2)<0){return 0;}
          }
        }
      }
    }
    fi=fi+1;
  }
  let nc:i32=get32(W,CAND());
  if(nc==0){return 0;}
  let full:i32=0;
  let b:i32=0;
  while(b<cn){full=full+full+1;b=b+1;}
  // pass 1: minimal cover size
  let minsz:i32=999;
  let s:i32=1;
  let lim:i32=1;
  let q:i32=0;
  while(q<nc){lim=lim+lim;q=q+1;}
  while(s<lim){
    let m:i32=0;
    let j:i32=0;
    while(j<nc){
      if(bitset(s,j)==1){m=bitor(m,get32(W,CAND()+4+j*16+12));}
      j=j+1;
    }
    if(m==full){
      let sz:i32=popcnt(s);
      if(sz<minsz){minsz=sz;}
    }
    s=s+1;
  }
  if(minsz==999){return 0;}
  // pass 2: count distinct minimal covers, record the first
  let cnt:i32=0;
  let first:i32=0;
  s=1;
  while(s<lim){
    let m:i32=0;
    let j:i32=0;
    while(j<nc){
      if(bitset(s,j)==1){m=bitor(m,get32(W,CAND()+4+j*16+12));}
      j=j+1;
    }
    if(m==full){
      if(popcnt(s)==minsz){
        cnt=cnt+1;
        if(cnt==1){first=s;}
      }
    }
    s=s+1;
  }
  if(cnt==1){
    let w:i32=0;
    let j:i32=0;
    while(j<nc){
      if(bitset(first,j)==1){
        set32(W,COVER()+4+w*12,get32(W,CAND()+4+j*16));
        set32(W,COVER()+4+w*12+4,get32(W,CAND()+4+j*16+4));
        set32(W,COVER()+4+w*12+8,get32(W,CAND()+4+j*16+8));
        w=w+1;
      }
      j=j+1;
    }
    set32(W,COVER(),minsz);
    return 1;
  }
  set32(W,AMB(),cnt);
  set32(W,AMB()+100,cnt);
  return 2;
}
// build_cover: one DISP node, one labeled edge per cover atom all targeting
// the shared TERM(newout), one default edge to deftarget. Existing ops only.
fn build_cover(W:[]u8,ncover:i32,deftarget:i32,newout:i32)i32{
  let newt:i32=op_new_node(W);
  op_mark_term(W,newt,newout);
  let d:i32=op_new_node(W);
  op_mark_disp(W,d);
  let i:i32=0;
  while(i<ncover){
    let e:i32=op_new_edge(W,d,newt);
    let fi:i32=get32(W,COVER()+4+i*12);
    let op:i32=get32(W,COVER()+4+i*12+4);
    let fv:i32=get32(W,COVER()+4+i*12+8);
    op_label_edge(W,e,fi,op,fv);
    i=i+1;
  }
  let e0:i32=op_new_edge(W,d,deftarget);
  if(e0<0){return -1;}
  return d;
}
fn emit_cover_amb(W:[]u8,sig:i32)void{
  emit("AMBIGUOUS_COVER sig=");
  emit(i32s(sig));
  emit(" k=");
  emit(i32s(get32(W,AMB())));
  emit("\n");
  return;
}

// ---- recursive constructor: nesting depth = discovered predicate arity ----
fn build_chain(W:[]u8,natoms:i32,deftarget:i32,newout:i32)i32{
  let newt:i32=op_new_node(W);
  op_mark_term(W,newt,newout);
  let i:i32=0;
  while(i<natoms){
    let d:i32=op_new_node(W);
    op_mark_disp(W,d);
    set32(W,TMP()+i*4,d);
    i=i+1;
  }
  i=0;
  let ok:i32=1;
  while(i<natoms){
    let d:i32=get32(W,TMP()+i*4);
    let e0:i32=op_new_edge(W,d,deftarget);
    if(e0<0){ok=0;}
    let tgt:i32=newt;
    if(i+1<natoms){tgt=get32(W,TMP()+(i+1)*4);}
    let e1:i32=op_new_edge(W,d,tgt);
    let fi:i32=get32(W,PRED()+4+i*12);
    let op:i32=get32(W,PRED()+4+i*12+4);
    let fv:i32=get32(W,PRED()+4+i*12+8);
    op_label_edge(W,e1,fi,op,fv);
    i=i+1;
  }
  if(ok==0){return -1;}
  return get32(W,TMP());
}
fn emit_amb(W:[]u8,sig:i32)void{
  let kc:i32=get32(W,AMB());
  let tc:i32=get32(W,AMB()+100);
  emit("AMBIGUOUS sig=");
  emit(i32s(sig));
  emit(" k=");
  emit(i32s(kc));
  let j:i32=0;
  while(j<tc){
    if(j<8){
      emit(" (");
      emit(i32s(get32(W,AMB()+4+j*12)));
      emit(",");
      emit(i32s(get32(W,AMB()+4+j*12+4)));
      emit(",");
      emit(i32s(get32(W,AMB()+4+j*12+8)));
      emit(")");
    }
    j=j+1;
  }
  emit("\n");
  return;
}
fn try_construct_root(W:[]u8,s:i32)void{
  let sig:i32=get32(W,rule_addr(s));
  let rnode:i32=get32(W,rule_addr(s)+4);
  let old:i32=get32(W,node_addr(rnode)+4);
  set32(W,rule_addr(s)+28,get32(W,rule_addr(s)+12));
  let tn:i32=0;
  let cn:i32=0;
  let hn:i32=get32(W,rule_addr(s)+8);
  let k:i32=0;
  while(k<hn){
    let a:i32=hist_addr(s,k);
    if(get32(W,a+16)==old){
      copy_vec(W,a,SCR_T()+tn*20);
      tn=tn+1;
    } else {
      copy_vec(W,a,SCR_C()+cn*20);
      cn=cn+1;
    }
    k=k+1;
  }
  if(tn<1){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
  if(cn<1){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
  let newout:i32=get32(W,SCR_C()+16);
  k=1;
  let mixed:i32=0;
  while(k<cn){
    if(get32(W,SCR_C()+k*20+16)!=newout){mixed=1;}
    k=k+1;
  }
  if(mixed==1){
    set32(W,rule_addr(s)+16,2);
    set32(W,cnt_addr(5),get32(W,cnt_addr(5))+1);
    emit("AMBIGUOUS_MIXED sig=");
    emit(i32s(sig));
    emit("\n");
    return;
  }
  let r:i32=disc2(W,tn,cn);
  if(r==1){
    let natoms:i32=get32(W,PRED());
    let d0:i32=build_chain(W,natoms,rnode,newout);
    if(d0<0){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
    set32(W,rule_addr(s)+4,d0);
    set32(W,rule_addr(s)+20,1);
    set32(W,cnt_addr(3),get32(W,cnt_addr(3))+1);
    set32(W,rep_addr(s),natoms);
    let i:i32=0;
    while(i<natoms){
      set32(W,rep_addr(s)+4+i*12,get32(W,PRED()+4+i*12));
      set32(W,rep_addr(s)+4+i*12+4,get32(W,PRED()+4+i*12+4));
      set32(W,rep_addr(s)+4+i*12+8,get32(W,PRED()+4+i*12+8));
      i=i+1;
    }
    emit("BUILT sig=");
    emit(i32s(sig));
    emit(" natoms=");
    emit(i32s(natoms));
    emit("\n");
    return;
  }
  if(r==2){
    set32(W,rule_addr(s)+16,get32(W,AMB()));
    set32(W,cnt_addr(5),get32(W,cnt_addr(5))+1);
    emit_amb(W,sig);
    return;
  }
  let rc:i32=disc_cover(W,tn,cn);
  if(rc==1){
    let ncover:i32=get32(W,COVER());
    let d0:i32=build_cover(W,ncover,rnode,newout);
    if(d0<0){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
    set32(W,rule_addr(s)+4,d0);
    set32(W,rule_addr(s)+20,1);
    set32(W,cnt_addr(3),get32(W,cnt_addr(3))+1);
    set32(W,rep_addr(s),ncover);
    let ci:i32=0;
    while(ci<ncover){
      set32(W,rep_addr(s)+4+ci*12,get32(W,COVER()+4+ci*12));
      set32(W,rep_addr(s)+4+ci*12+4,get32(W,COVER()+4+ci*12+4));
      set32(W,rep_addr(s)+4+ci*12+8,get32(W,COVER()+4+ci*12+8));
      ci=ci+1;
    }
    emit("BUILT_COVER sig=");
    emit(i32s(sig));
    emit(" ncover=");
    emit(i32s(ncover));
    emit("\n");
    return;
  }
  if(rc==2){
    set32(W,rule_addr(s)+16,get32(W,AMB()));
    set32(W,cnt_addr(5),get32(W,cnt_addr(5))+1);
    emit_cover_amb(W,sig);
    return;
  }
  set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1);
  emit("HONEST_FAIL sig=");
  emit(i32s(sig));
  emit("\n");
  return;
}
fn try_refine(W:[]u8,s:i32,e:i32)void{
  let sig:i32=get32(W,rule_addr(s));
  let cn:i32=0;
  let nn:i32=get32(W,rule_addr(s)+24);
  let r:i32=0;
  while(r<nn){
    let a:i32=ncl_addr(s,r);
    if(get32(W,a)==e){
      set32(W,SCR_C()+cn*20,get32(W,a+4));
      set32(W,SCR_C()+cn*20+4,get32(W,a+8));
      set32(W,SCR_C()+cn*20+8,get32(W,a+12));
      set32(W,SCR_C()+cn*20+12,get32(W,a+16));
      set32(W,SCR_C()+cn*20+16,get32(W,a+20));
      cn=cn+1;
    }
    r=r+1;
  }
  let w:i32=0;
  r=0;
  while(r<nn){
    let a:i32=ncl_addr(s,r);
    if(get32(W,a)!=e){
      if(w!=r){
        let d:i32=ncl_addr(s,w);
        set32(W,d,get32(W,a));
        set32(W,d+4,get32(W,a+4));
        set32(W,d+8,get32(W,a+8));
        set32(W,d+12,get32(W,a+12));
        set32(W,d+16,get32(W,a+16));
        set32(W,d+20,get32(W,a+20));
      }
      w=w+1;
    }
    r=r+1;
  }
  set32(W,rule_addr(s)+24,w);
  if(cn<2){return;}
  let newout:i32=get32(W,SCR_C()+16);
  let k:i32=1;
  let mixed:i32=0;
  while(k<cn){
    if(get32(W,SCR_C()+k*20+16)!=newout){mixed=1;}
    k=k+1;
  }
  if(mixed==1){
    set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1);
    emit("REFINE_MIXED sig=");
    emit(i32s(sig));
    emit("\n");
    return;
  }
  let rnode:i32=get32(W,rule_addr(s)+4);
  let tn:i32=0;
  let hn:i32=get32(W,rule_addr(s)+8);
  k=0;
  while(k<hn){
    let a:i32=hist_addr(s,k);
    let f0:i32=get32(W,a);
    let f1:i32=get32(W,a+4);
    let f2:i32=get32(W,a+8);
    let f3:i32=get32(W,a+12);
    let o:i32=get32(W,a+16);
    if(path_uses(W,s,e,f0,f1,f2,f3)==1){
      if(interp(W,rnode,f0,f1,f2,f3,0)==o){
        copy_vec(W,a,SCR_T()+tn*20);
        tn=tn+1;
      }
    }
    k=k+1;
  }
  if(tn<1){
    set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1);
    emit("REFINE_EMPTY_SUBTRAIN sig=");
    emit(i32s(sig));
    emit("\n");
    return;
  }
  let dr:i32=disc2(W,tn,cn);
  if(dr==1){
    let natoms:i32=get32(W,PRED());
    let oldt:i32=get32(W,edge_addr(e)+4);
    let d0:i32=build_chain(W,natoms,oldt,newout);
    if(d0<0){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
    edge_set_to(W,e,d0);
    set32(W,cnt_addr(3),get32(W,cnt_addr(3))+1);
    emit("REFINE sig=");
    emit(i32s(sig));
    emit(" edge=");
    emit(i32s(e));
    emit(" natoms=");
    emit(i32s(natoms));
    emit(" a0=(");
    emit(i32s(get32(W,PRED()+4)));
    emit(",");
    emit(i32s(get32(W,PRED()+8)));
    emit(",");
    emit(i32s(get32(W,PRED()+12)));
    emit(")\n");
    return;
  }
  let drc:i32=disc_cover(W,tn,cn);
  if(drc==1){
    let ncover:i32=get32(W,COVER());
    let oldt:i32=get32(W,edge_addr(e)+4);
    let d0:i32=build_cover(W,ncover,oldt,newout);
    if(d0<0){set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1); return;}
    edge_set_to(W,e,d0);
    set32(W,cnt_addr(3),get32(W,cnt_addr(3))+1);
    emit("REFINE_COVER sig=");
    emit(i32s(sig));
    emit(" edge=");
    emit(i32s(e));
    emit(" ncover=");
    emit(i32s(ncover));
    emit("\n");
    return;
  }
  set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1);
  emit("REFINE_WITHHOLD sig=");
  emit(i32s(sig));
  emit(" dr=");
  emit(i32s(drc));
  emit("\n");
  return;
}

// ---- contradiction monitor: deferred construction, nested refinement ----
fn observe(W:[]u8,sig:i32,out:i32,f0:i32,f1:i32,f2:i32,f3:i32,mode:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){
    let t:i32=op_new_node(W);
    op_mark_term(W,t,out);
    s=rule_link(W,sig,t);
    hist_append(W,s,f0,f1,f2,f3,out);
    return 0;
  }
  hist_append(W,s,f0,f1,f2,f3,out);
  let node:i32=get32(W,rule_addr(s)+4);
  let kind:i32=get32(W,node_addr(node));
  if(kind==1){
    let v:i32=get32(W,node_addr(node)+4);
    if(v==out){return 0;}
    set32(W,cnt_addr(2),get32(W,cnt_addr(2))+1);
    let cn:i32=get32(W,rule_addr(s)+12)+1;
    set32(W,rule_addr(s)+12,cn);
    if(mode==1){
      let builtf:i32=get32(W,rule_addr(s)+20);
      let lasta:i32=get32(W,rule_addr(s)+28);
      if(builtf==0){
        if(cn>1){
          if(cn>lasta){try_construct_root(W,s);}
        }
      }
    }
    return 1;
  }
  let p:i32=interp(W,node,f0,f1,f2,f3,0);
  if(p==out){return 0;}
  set32(W,cnt_addr(2),get32(W,cnt_addr(2))+1);
  let e:i32=trace_last_edge(W,s,f0,f1,f2,f3);
  if(e<0){return 2;}
  ncl_append(W,s,e,f0,f1,f2,f3,out);
  if(mode==1){
    if(ncl_count_edge(W,s,e)>1){try_refine(W,s,e);}
  }
  return 2;
}

// ---- main: frozen families A-E, v1 regression, structure checks ----
fn lab_edge(W:[]u8,node:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==1){return e;}
    }
    e=e+1;
  }
  return -1;
}
fn disp_lab_tgt_kind(W:[]u8,sig:i32)i32{
  let n:i32=rule_node(W,sig);
  if(n<0){return -1;}
  if(get32(W,node_addr(n))!=2){return -1;}
  let le:i32=lab_edge(W,n);
  if(le<0){return -1;}
  let tgt:i32=get32(W,edge_addr(le)+4);
  return get32(W,node_addr(tgt));
}
fn lab_atom(W:[]u8,node:i32,fi:i32,op:i32,fv:i32)i32{
  let le:i32=lab_edge(W,node);
  if(le<0){return 0;}
  if(get32(W,edge_addr(le)+12)!=fi){return 0;}
  if(get32(W,edge_addr(le)+16)!=op){return 0;}
  if(get32(W,edge_addr(le)+20)!=fv){return 0;}
  return 1;
}
fn check_rep(W:[]u8,sig:i32,na:i32,f0:i32,o0:i32,v0:i32,f1:i32,o1:i32,v1:i32)i32{
  let rs:i32=rule_find(W,sig);
  if(rs<0){return 0;}
  if(get32(W,rep_addr(rs))!=na){return 0;}
  if(get32(W,rep_addr(rs)+4)!=f0){return 0;}
  if(get32(W,rep_addr(rs)+8)!=o0){return 0;}
  if(get32(W,rep_addr(rs)+12)!=v0){return 0;}
  if(na>1){
    if(get32(W,rep_addr(rs)+16)!=f1){return 0;}
    if(get32(W,rep_addr(rs)+20)!=o1){return 0;}
    if(get32(W,rep_addr(rs)+24)!=v1){return 0;}
  }
  return 1;
}
fn dump_graph(W:[]u8)void{
  let nn:i32=get32(W,cnt_addr(0));
  let ne:i32=get32(W,cnt_addr(1));
  emit("DUMP_BEGIN\n");
  let i:i32=0;
  while(i<nn){
    emit("N "); emit(i32s(i));
    emit(" kind="); emit(i32s(get32(W,node_addr(i))));
    emit(" val="); emit(i32s(get32(W,node_addr(i)+4)));
    emit("\n");
    i=i+1;
  }
  let e:i32=0;
  while(e<ne){
    emit("E "); emit(i32s(e));
    emit(" from="); emit(i32s(get32(W,edge_addr(e))));
    emit(" to="); emit(i32s(get32(W,edge_addr(e)+4)));
    emit(" lk="); emit(i32s(get32(W,edge_addr(e)+8)));
    emit(" fi="); emit(i32s(get32(W,edge_addr(e)+12)));
    emit(" op="); emit(i32s(get32(W,edge_addr(e)+16)));
    emit(" fv="); emit(i32s(get32(W,edge_addr(e)+20)));
    emit("\n");
    e=e+1;
  }
  emit("DUMP_END\n");
  return;
}


// ---- main: frozen v3 families (F2 disjunction, MEM, AMB, MIN, F1/F3 regression) ----
fn def_edge(W:[]u8,node:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==0){return e;}
    }
    e=e+1;
  }
  return -1;
}
fn edge_to(W:[]u8,e:i32)i32{ return get32(W,edge_addr(e)+4); }
fn node_kind(W:[]u8,n:i32)i32{ return get32(W,node_addr(n)); }
fn lab_edge_n(W:[]u8,node:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let c:i32=0;
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==1){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
fn def_edge_n(W:[]u8,node:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let c:i32=0;
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==0){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
fn lab_atom_tgt0(W:[]u8,node:i32,fi:i32,op:i32,fv:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==1){
        if(get32(W,edge_addr(e)+12)==fi){
          if(get32(W,edge_addr(e)+16)==op){
            if(get32(W,edge_addr(e)+20)==fv){
              let t:i32=get32(W,edge_addr(e)+4);
              if(get32(W,node_addr(t))==1){
                if(get32(W,node_addr(t)+4)==0){return 1;}
              }
            }
          }
        }
      }
    }
    e=e+1;
  }
  return 0;
}
fn def_tgt_term(W:[]u8,node:i32,val:i32)i32{
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      if(get32(W,edge_addr(e)+8)==0){
        let t:i32=get32(W,edge_addr(e)+4);
        if(get32(W,node_addr(t))==1){
          if(get32(W,node_addr(t)+4)==val){return 1;}
        }
      }
    }
    e=e+1;
  }
  return 0;
}
fn main()i32{
  let mode:i32=1;
  let W:[]u8=z_alloc(65536);
  let s:i32=0;
  while(s<RULE_MAX()){ set32(W,rule_addr(s),-1); s=s+1; }
  emit("L3C-V3-REDTEAM-B2 mode=1\n");

  // Supplementary probe B2: RTMIN2 rows reordered R1,R3,R2,R4,R1,R3,R2,R4
  // so no single atom ever covers all rows seen so far; the cover path
  // must fire. Truth: out=0 iff f1==1 OR f2==9.
  let b_b0:i32=get32(W,cnt_addr(3));
  let b_u0:i32=get32(W,cnt_addr(4));
  observe(W,804,2,3,0,0,7,mode);
  observe(W,804,2,3,0,0,7,mode);
  observe(W,804,2,3,3,3,1,mode);
  observe(W,804,2,3,3,3,1,mode);
  observe(W,804,0,3,1,0,0,mode);
  observe(W,804,0,3,0,9,4,mode);
  observe(W,804,0,3,1,2,2,mode);
  observe(W,804,0,3,4,9,6,mode);
  observe(W,804,0,3,1,0,0,mode);
  observe(W,804,0,3,0,9,4,mode);
  observe(W,804,0,3,1,2,2,mode);
  observe(W,804,0,3,4,9,6,mode);
  emit("RT_B2 built_delta=");
  emit(i32s(get32(W,cnt_addr(3))-b_b0));
  emit(" (expect 1)\n");
  emit("RT_B2 unresolved_delta=");
  emit(i32s(get32(W,cnt_addr(4))-b_u0));
  emit(" (expect 6)\n");
  let b_ok:i32=0;
  if(interp(W,rule_node(W,804),3,1,5,5,0)==0){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,804),3,5,9,5,0)==0){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,804),3,0,0,7,0)==2){b_ok=b_ok+1;}
  if(interp(W,rule_node(W,804),3,4,4,4,0)==2){b_ok=b_ok+1;}
  emit("RT_B2 truth_eval=");
  emit(i32s(b_ok));
  emit("/4 (expect 4)\n");

  let d804:i32=rule_node(W,804);
  emit("CHK_B2_disp=");
  if(node_kind(W,d804)==2){emit("PASS\n");} else {emit("FAIL\n");}
  emit("CHK_B2_edges2=");
  if(lab_edge_n(W,d804)==2){
    if(def_edge_n(W,d804)==1){emit("PASS\n");} else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_B2_mincover=");
  if(lab_atom_tgt0(W,d804,1,0,1)==1){
    if(lab_atom_tgt0(W,d804,2,0,9)==1){
      if(def_tgt_term(W,d804,2)==1){emit("PASS\n");} else {emit("FAIL\n");}
    } else {emit("FAIL\n");}
  } else {emit("FAIL\n");}
  emit("CHK_B2_rep2=");
  let rs804:i32=rule_find(W,804);
  if(get32(W,rep_addr(rs804))==2){emit("PASS\n");} else {emit("FAIL\n");}

  dump_graph(W);
  emit("END\n");
  return 0;
}

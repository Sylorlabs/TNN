// ===== THEATER ABLATION DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original main removed).
// Cognition code untouched.
//
// Six learners: WA (control), WB (T1), WC (T2-check), WD (T3), WE (T4),
// WF (T6). Identical battery; ablations applied at midpoint. Return-value
// transcripts compared: any behavioral role of the theater instances must
// show up as divergence between the streams.
//
// T1: zero node 1 (MISS_POLICY, tag 901) in place.
// T2: no destructive ablation; verify tag-903 field 20 stays 3 after
//     bootstrap events (read path exercised, write path absent).
// T3: zero header field 16 (trial stats).
// T4: reset event log count (header 28).
// T6: reset eviction history chain (header 12) and zero tag-3 nodes.
// T5: already confirmed by t30_ablation; not re-tested.
//
// Unsealed synthetic subjects only. No sealed world content.

// Count live nodes with a given tag (diagnostic).
fn th_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;}
    n=n+1;
  }
  return c;
}

// T1: zero MISS_POLICY node 1 in place. Slot stays occupied.
fn t1_ablate(W:[]u8)i32 {
  if(ng(W,1,36)==1 && ng(W,1,0)==901){
    ns(W,1,0,0); ns(W,1,20,0);
    return 1;
  }
  return 0;
}

// T2: read tag-903 node field 20. Returns -1 if no such node.
fn t2_check(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){return ng(W,n,20);}
    n=n+1;
  }
  return -1;
}

// T3: zero trial stats header field 16.
fn t3_ablate(W:[]u8)void {
  hs(W,16,0); return;
}

// T4: reset event log count. Old entries never read.
fn t4_ablate(W:[]u8)void {
  hs(W,28,0); return;
}

// T6: reset eviction history chain and zero tag-3 nodes.
// Returns chain head before reset (-1 means was empty).
fn t6_ablate(W:[]u8)i32 {
  let was:i32=hg(W,12);
  hs(W,12,-1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==3){
      ns(W,n,0,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0);
    }
    n=n+1;
  }
  return was;
}

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

fn phase1(W:[]u8,p:[]u8)void {
  let i:i32=0; let a:i32=0;
  // Teach 10 facts.
  i=0;
  while(i<10){ a=ev_teach(W,1000+i,1,i*7+3); rep(p,"teach",a); i=i+1; }
  // 4 masked misses -> trial path, T30s, guides.
  i=0;
  while(i<4){ a=ev_query(W,9100+i,77,-2,0); rep(p,"miss",a); i=i+1; }
  // Chain teach + masked query -> MAP promotion.
  ev_teach(W,7001,11,7002); ev_teach(W,7002,12,7003);
  a=ev_query(W,7001,40,7003,0); rep(p,"promote",a);
  // Action selection.
  i=0;
  while(i<3){ a=ev_act(W); rep(p,"act",a); i=i+1; }
  // Exact hits.
  i=0;
  while(i<10){ a=ev_query(W,1000+i,1,i*7+3,0); rep(p,"hit",a); i=i+1; }
  // Bootstrap scenario: 3 unanimous facts with r=91, then masked query
  // on a new subject. Trial fails (no chain), bootstrap consults k.
  ev_teach(W,5001,91,555); ev_teach(W,5002,91,555); ev_teach(W,5003,91,555);
  a=ev_query(W,6001,91,-2,0); rep(p,"boot",a);
  rep(p,"k",t2_check(W));
  return;
}

fn phase2(W:[]u8,p:[]u8)void {
  let i:i32=0; let a:i32=0;
  // 4 more masked misses.
  i=0;
  while(i<4){ a=ev_query(W,9200+i,77,-2,0); rep(p,"miss2",a); i=i+1; }
  // 10 more teaches.
  i=0;
  while(i<10){ a=ev_teach(W,2000+i,2,i*3+1); rep(p,"teach2",a); i=i+1; }
  // Exact hits on new facts.
  i=0;
  while(i<10){ a=ev_query(W,2000+i,2,i*3+1,0); rep(p,"hit2",a); i=i+1; }
  // Action selection again.
  i=0;
  while(i<3){ a=ev_act(W); rep(p,"act2",a); i=i+1; }
  // Contradiction -> revision path.
  a=ev_observe(W,7002,12,9999); rep(p,"contra_rc",a);
  a=ev_query(W,7001,40,9999,0); rep(p,"contra_q",a);
  // Second bootstrap scenario with different unanimous value.
  ev_teach(W,5101,92,777); ev_teach(W,5102,92,777); ev_teach(W,5103,92,777);
  ev_teach(W,5104,92,777);
  a=ev_query(W,6101,92,-2,0); rep(p,"boot2",a);
  rep(p,"k",t2_check(W));
  // Observation + confirm.
  a=ev_observe(W,2001,2,7777); rep(p,"obs2_rc",a);
  a=ev_query(W,2001,2,7777,0); rep(p,"obs2_q",a);
  return;
}

fn theater_main()i32 {
  let WA:[]u8=z_alloc(110656); tnn2_init(WA);
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  let WC:[]u8=z_alloc(110656); tnn2_init(WC);
  let WD:[]u8=z_alloc(110656); tnn2_init(WD);
  let WE:[]u8=z_alloc(110656); tnn2_init(WE);
  let WF:[]u8=z_alloc(110656); tnn2_init(WF);

  phase1(WA,"A"); phase1(WB,"B"); phase1(WC,"C");
  phase1(WD,"D"); phase1(WE,"E"); phase1(WF,"F");

  // Midpoint ablations.
  let n1:i32=t1_ablate(WB);
  emit("T1-ABLATED n="); e64(n1); emit("\n");
  t3_ablate(WD);
  emit("T3-ABLATED\n");
  t4_ablate(WE);
  emit("T4-ABLATED\n");
  let was6:i32=t6_ablate(WF);
  emit("T6-ABLATED was="); e64(was6); emit("\n");
  // T2: record pre-phase2 k values (no destructive ablation).
  rep("A","k_pre",t2_check(WA)); rep("B","k_pre",t2_check(WB));
  rep("C","k_pre",t2_check(WC)); rep("D","k_pre",t2_check(WD));
  rep("E","k_pre",t2_check(WE)); rep("F","k_pre",t2_check(WF));

  phase2(WA,"A"); phase2(WB,"B"); phase2(WC,"C");
  phase2(WD,"D"); phase2(WE,"E"); phase2(WF,"F");

  emit("THEATER-ABLATION-DONE\n");
  return 0;
}
fn main()i32 { return theater_main(); }

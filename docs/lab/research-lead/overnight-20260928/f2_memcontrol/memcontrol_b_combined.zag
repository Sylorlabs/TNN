// memcontrol.zag -- Memorization control for F2 retry (AUTOSCI2).
// Baseline learner with NO causal machinery: no candidate rules, no
// hypotheses, no experiment loop, no rule simulation. It memorizes the
// passive-phase WAIT transitions and plans by nearest-neighbor lookup.
// Concatenate BEFORE world_a2m.zag or world_b2m.zag (sealed worlds, which
// provide the w_* interface and main). The control NEVER reads sealed laws;
// it only calls the w_* interface.
//
// Prereg: PREREG_MEMCONTROL (frozen before this file existed).
// Primitives (kind, var): 0=SET v, 1=CLR v, 2=WAIT, 3=OBSERVE v.
// Pure Zag. No Python.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ shared world physics (verbatim from the F2 substrate) ============
// L_advance is the world's own dynamics engine: it applies a rule set to a
// history buffer. The sealed worlds call it inside w_act to advance. The
// memorizer NEVER calls it for planning; the memorizer plans only with its
// nearest-neighbor transition memory. Included here verbatim so the sealed
// worlds link unchanged.
fn L_advance(hist:[]u8, t:i32, rules:[]u8, nr:i32, nvars:i32)void {
  let e:i32=0;
  while(e<nvars){
    let nv:i32=0;
    let r:i32=0;
    while(r<nr){
      let b:i32=r*5;
      if((rules[b+1] as i32)==e){
        let c:i32=rules[b] as i32;
        let d:i32=rules[b+2] as i32;
        let s:i32=t-d;
        if(s>=0 && hist[c*32+s]==1){
          let cx:i32=rules[b+3] as i32;
          if(cx==255){ nv=1; }
          else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
        }
      }
      r=r+1;
    }
    hist[e*32+t]=nv as u8;
    e=e+1;
  }
  return;
}

// ============ transition memory ============
fn M_NPASS()i32 { return 12; }
fn M_NMEM()i32 { return 11; } // WAIT transitions observed in the passive phase

// Hamming distance between a state (nvars bytes) and memorized pre-state i.
fn M_ham(a:[]u8, pre:[]u8, i:i32, nvars:i32)i32 {
  let d:i32=0;
  let v:i32=0;
  while(v<nvars){ if(a[v]!=pre[i*nvars+v]){ d=d+1; } v=v+1; }
  return d;
}

// Nearest-neighbor WAIT: copy the recorded post-state of the nearest
// memorized pre-state into out. Ties go to the earliest recorded entry
// (deterministic).
fn M_wait(a:[]u8, pre:[]u8, post:[]u8, nvars:i32, out:[]u8)void {
  let best:i32=0;
  let bd:i32=M_ham(a,pre,0,nvars);
  let i:i32=1;
  while(i<M_NMEM()){
    let d:i32=M_ham(a,pre,i,nvars);
    if(d<bd){ bd=d; best=i; }
    i=i+1;
  }
  let v:i32=0;
  while(v<nvars){ out[v]=post[best*nvars+v]; v=v+1; }
  return;
}

// Simulate a primitive sequence under the NN model.
// SET/CLR apply direct bit flips (action interface semantics, identical to
// the F2 simulator's treatment). WAIT uses nearest-neighbor lookup.
// Returns the number of observations recorded.
fn M_sim(sk:[]u8, sv:[]u8, len:i32, init:[]u8, nvars:i32,
         pre:[]u8, post:[]u8, out_obs:[]u8, out_final:[]u8)i32 {
  let st:[]u8=z_alloc(nvars);
  let nx:[]u8=z_alloc(nvars);
  let v:i32=0;
  while(v<nvars){ st[v]=init[v]; v=v+1; }
  let nobs:i32=0;
  let i:i32=0;
  while(i<len){
    let kk:i32=sk[i] as i32;
    let vv:i32=sv[i] as i32;
    if(kk==0){ st[vv]=1; }
    else if(kk==1){ st[vv]=0; }
    else if(kk==2){
      M_wait(st,pre,post,nvars,nx);
      v=0;
      while(v<nvars){ st[v]=nx[v]; v=v+1; }
    }
    else { out_obs[nobs]=st[vv]; nobs=nobs+1; }
    i=i+1;
  }
  v=0;
  while(v<nvars){ out_final[v]=st[v]; v=v+1; }
  return nobs;
}

// ============ emit helpers ============
fn M_emit_prim(kk:i32, vv:i32)void {
  if(kk==0){ emit("S"); }
  else if(kk==1){ emit("C"); }
  else if(kk==2){ emit("W"); }
  else { emit("O"); }
  if(kk!=2){ emit(w_vname(vv)); }
  return;
}
fn M_emit_seq(sk:[]u8, sv:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){ emit(","); }
    M_emit_prim(sk[i] as i32, sv[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
fn M_emit_state(s:[]u8, nvars:i32)void {
  emit("(");
  let v:i32=0;
  while(v<nvars){
    if(v>0){ emit(","); }
    e64(s[v] as i32);
    v=v+1;
  }
  emit(")");
  return;
}

// ============ World A goal planner (mirrors L_plan search order) ============
// Manipulations + WAIT, depths 1..maxd. Same digit-to-primitive mapping as
// the F2 planner. Returns plan length, or 0 if none found.
fn M_plan_a(nvars:i32, nctrl:i32, ctrl:[]u8, init:[]u8,
            pre:[]u8, post:[]u8, maxd:i32, out_sk:[]u8, out_sv:[]u8)i32 {
  let P:i32=2*nctrl+1;
  let ob:[]u8=z_alloc(32);
  let fin:[]u8=z_alloc(nvars);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else { kk=2; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      let nn:i32=M_sim(out_sk,out_sv,d,init,nvars,pre,post,ob,fin);
      if(nn>=0 && w_goal_met(fin)==1){ return d; }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ World B2 goal planner (mirrors L_plan_b2 search order) ============
// Searches M over {SET,CLR per ctrl, WAIT}, depths 1..maxd. For each M,
// simulates M + SUFFIX and checks the triple predicate on the simulated
// observation log. SUFFIX = [OBS Y, OBS K, WAIT] x 3 (fixed, preregistered).
// Returns M length, or 0 if none found.
fn M_plan_b2(nvars:i32, nctrl:i32, ctrl:[]u8, init:[]u8,
             pre:[]u8, post:[]u8, maxd:i32, yvar:i32, kvar:i32,
             out_sk:[]u8, out_sv:[]u8)i32 {
  let P:i32=2*nctrl+1;
  let suf_sk:[]u8=z_alloc(9);
  let suf_sv:[]u8=z_alloc(9);
  let j:i32=0;
  while(j<3){
    suf_sk[j*3]=3; suf_sv[j*3]=yvar as u8;
    suf_sk[j*3+1]=3; suf_sv[j*3+1]=kvar as u8;
    suf_sk[j*3+2]=2; suf_sv[j*3+2]=0;
    j=j+1;
  }
  let full_sk:[]u8=z_alloc(20);
  let full_sv:[]u8=z_alloc(20);
  let ob:[]u8=z_alloc(32);
  let fin:[]u8=z_alloc(nvars);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else { kk=2; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        full_sk[i]=kk as u8; full_sv[i]=vv as u8;
        i=i+1;
      }
      j=0;
      while(j<9){ full_sk[d+j]=suf_sk[j]; full_sv[d+j]=suf_sv[j]; j=j+1; }
      let flen:i32=d+9;
      let nn:i32=M_sim(full_sk,full_sv,flen,init,nvars,pre,post,ob,fin);
      if(nn==6 && ob[0]==1 && ob[1]==0 && ob[2]==1 && ob[3]==0 && ob[4]==1 && ob[5]==0){
        return d;
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// Triple predicate on a real-execution observation log.
fn M_triple_met(oy0:i32, ok0:i32, oy1:i32, ok1:i32, oy2:i32, ok2:i32)i32 {
  if(oy0==1 && ok0==0 && oy1==1 && ok1==0 && oy2==1 && ok2==0){ return 1; }
  return 0;
}

// ============ main control run ============
// Returns bitmask: bit0 = plan found in the NN model,
// bit1 = goal achieved for real.
fn M_run()i32 {
  let mask:i32=0;
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }
  emit("MEMCONTROL WORLD "); emit(w_worldname()); emit(" nvars="); e64(nvars);
  emit(" nctrl="); e64(nctrl); emit("\n");

  let ws:[]u8=z_alloc(8+nvars*32);

  // ---- passive phase: record WAIT transitions (free given data) ----
  // Post-WAIT snapshot is taken BEFORE the next environment passive action,
  // so environment SETs never contaminate a WAIT transition.
  let pre:[]u8=z_alloc(M_NMEM()*nvars);
  let post:[]u8=z_alloc(M_NMEM()*nvars);
  w_reset(ws);
  let t:i32=0;
  while(t<M_NMEM()){
    w_passive(ws);
    let s0:[]u8=z_alloc(nvars);
    w_snapshot(ws,s0);
    w_act(ws,2,0); // WAIT
    let s1:[]u8=z_alloc(nvars);
    w_snapshot(ws,s1);
    let v:i32=0;
    while(v<nvars){ pre[t*nvars+v]=s0[v]; post[t*nvars+v]=s1[v]; v=v+1; }
    t=t+1;
  }
  emit("MEMORY (11 WAIT transitions):\n");
  t=0;
  while(t<M_NMEM()){
    emit("  ");
    M_emit_state(pre[t*nvars..t*nvars+nvars],nvars);
    emit(" -> ");
    M_emit_state(post[t*nvars..t*nvars+nvars],nvars);
    emit("\n");
    t=t+1;
  }

  // ---- goal setup: initial state ----
  w_reset(ws);
  w_goal_setup(ws);
  let init:[]u8=z_alloc(nvars);
  w_snapshot(ws,init);
  emit("INIT "); M_emit_state(init,nvars); emit("\n");

  let gmode:i32=w_goal_mode();
  if(gmode==0){
    // ===== World A: final-state goal =====
    let psk:[]u8=z_alloc(10);
    let psv:[]u8=z_alloc(10);
    let plen:i32=M_plan_a(nvars,nctrl,ctrl,init,pre,post,w_plan_maxd(),psk,psv);
    if(plen==0){ emit("MEM_PLAN none found\n"); }
    else {
      mask=mask|1;
      emit("MEM_PLAN "); M_emit_seq(psk,psv,plen); emit("\n");
      // execute for real exactly once
      w_reset(ws);
      w_goal_setup(ws);
      i=0;
      while(i<plen){ w_act(ws,psk[i] as i32,psv[i] as i32); i=i+1; }
      let gvals:[]u8=z_alloc(nvars);
      let v:i32=0;
      while(v<nvars){
        let o:i32=w_act(ws,3,v);
        gvals[v]=o as u8;
        v=v+1;
      }
      emit("REAL_FINAL "); M_emit_state(gvals,nvars); emit("\n");
      let met:i32=w_goal_met(gvals);
      emit("GOAL_REAL_MEM "); e64(met); emit("\n");
      if(met==1){ mask=mask|2; }
    }
  } else {
    // ===== World B: B2 sustained triple goal =====
    let yv:i32=1;
    let kv:i32=2;
    let msk:[]u8=z_alloc(10);
    let msv:[]u8=z_alloc(10);
    let mlen:i32=M_plan_b2(nvars,nctrl,ctrl,init,pre,post,8,yv,kv,msk,msv);
    if(mlen==0){ emit("MEM_PLAN_B2 none found in NN model\n"); }
    else {
      mask=mask|1;
      let fsk:[]u8=z_alloc(20);
      let fsv:[]u8=z_alloc(20);
      i=0;
      while(i<mlen){ fsk[i]=msk[i]; fsv[i]=msv[i]; i=i+1; }
      let jj:i32=0;
      while(jj<3){
        fsk[mlen+jj*3]=3; fsv[mlen+jj*3]=yv as u8;
        fsk[mlen+jj*3+1]=3; fsv[mlen+jj*3+1]=kv as u8;
        fsk[mlen+jj*3+2]=2; fsv[mlen+jj*3+2]=0;
        jj=jj+1;
      }
      let flen:i32=mlen+9;
      emit("MEM_PLAN_B2 M="); M_emit_seq(msk,msv,mlen);
      emit(" full_len="); e64(flen); emit("\n");
      // execute for real exactly once
      w_reset(ws);
      w_goal_setup(ws);
      let oy:[]u8=z_alloc(3);
      let ok:[]u8=z_alloc(3);
      let oi:i32=0;
      i=0;
      while(i<flen){
        let kk:i32=fsk[i] as i32;
        let vv:i32=fsv[i] as i32;
        if(kk==3){
          let o:i32=w_act(ws,kk,vv);
          if(oi<3){
            if(vv==yv){ oy[oi]=o as u8; }
            else if(vv==kv){ ok[oi]=o as u8; oi=oi+1; }
          }
        } else {
          w_act(ws,kk,vv);
        }
        i=i+1;
      }
      let met:i32=M_triple_met(oy[0] as i32, ok[0] as i32, oy[1] as i32,
                               ok[1] as i32, oy[2] as i32, ok[2] as i32);
      emit("GOAL_REAL_MEM_B2 "); e64(met); emit(" obs=[");
      e64(oy[0] as i32); emit(","); e64(ok[0] as i32); emit(",");
      e64(oy[1] as i32); emit(","); e64(ok[1] as i32); emit(",");
      e64(oy[2] as i32); emit(","); e64(ok[2] as i32); emit("]\n");
      if(met==1){ mask=mask|2; }
    }
  }

  emit("MEMCONTROL_MASK "); e64(mask); emit("\n");
  return mask;
}
// world_b2m.zag -- Sealed World B copy for MEMCONTROL. Physics byte-identical to world_b2.zag;
// only the main entry call is renamed (L_run -> M_run). Concatenate AFTER memcontrol.zag.
// TRUE LAW (sealed from learner): (X->Y, delay 2, context K==0). Under K==1 X does nothing.
// The learner only sees the w_* interface. w_verify is harness adjudication.
// Goal mode 1 = B2 sustained triple goal (prereg AUTOSCI2).

fn w_goal_mode()i32 { return 1; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 2; } // X, K
fn w_ctxvar()i32 { return 2; } // K
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y"; }
  return "K";
}
fn w_worldname()[]u8 { return "B-contextual-delay"; }
fn w_plan_maxd()i32 { return 6; }

fn B_truerules()[]u8 {
  let r:[]u8=z_alloc(5);
  r[0]=0; r[1]=1; r[2]=2; r[3]=2; r[4]=0; // X -> Y delay 2 iff K==0
  return r;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+3*32];
    L_advance(hist,t,B_truerules(),1,3);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: environment SETs X at t=2 and t=8. K=0 throughout.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: establish K=1 start state.
fn w_goal_setup(ws:[]u8)void {
  ws[8+2*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[1]==1){ return 1; }
  return 0;
}

// Harness adjudication for K2-R4. Knows the sealed truth; the learner does not.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // true candidate: Y:(X,2,ctx K=0)
  let ty:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==2 &&
       (candbuf[b+3] as i32)==2 && (candbuf[b+4] as i32)==0){ ty=j; }
    j=j+1;
  }
  let true_h:i32=-1;
  let h:i32=0;
  while(h<nhyp){
    if((hysel[h*1+0] as i32)==ty){ true_h=h; }
    h=h+1;
  }
  emit("K2-R4 true_h="); e64(true_h);
  emit(" alive="); e64(alive[true_h]); emit(" nalive="); e64(nalive);
  emit(" exhausted="); e64(exhausted); emit("\n");
  // Expect: exactly one survivor, equal to the true law.
  if(true_h>=0 && alive[true_h]==1 && nalive==1){
    emit("K2-R4 PASS\n");
    return 1;
  }
  emit("K2-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=M_run();
  emit("MEMCONTROL_B mask="); e64(m); emit("\n");
  if((m & 2)==2){ emit("MEMCONTROL_B GOAL_REAL=1\n"); return 0; }
  emit("MEMCONTROL_B GOAL_REAL=0\n");
  return 1;
}

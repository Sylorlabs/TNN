// PHASE 10 -- STRUCTURAL POSSIBILITY, not proposal weights.
// Prereg: phase10/PREREG.md. Scorer: score10.py (independent).
//
// SUBSTRATE CHANGE vs phase6 -- the point of the phase:
//   * programs are VARIABLE LENGTH (3..8): length is a structural choice
//   * the generator may apply LEARNED REWRITE operations to a partial
//     construction. Which rewrites are AVAILABLE lives in LEARNER STATE,
//     not in a source-defined table, so experience changes WHAT CAN BE
//     BUILT rather than only how often a fixed space is sampled.
//
// ONE generic persistent buffer ST, generic counter fields:
//   F_PAIR  op-pair co-occurrence counts
//   F_REW   learned rewrite counts (pattern pair -> replacement pair)
//   F_ADR   address-formation counts
//   F_LEN   length counts
// No modes, no routers, no domain names, no GATE/PLAN/INVENT/CAUSAL.
// Arms differ ONLY in which fields increment; all share this construction
// loop, budget and success criterion.
//
// Output: one row per (regime, arm, budget). Raw costs. No *_ok flags.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn OPS()i32 { return 8; }
fn FSZ()i32 { return 204; }
fn NREG()i32 { return 3; }
fn NARM()i32 { return 11; }
fn PRIOR()i32 { return 30; }
fn REPLAYS()i32 { return 40; }
fn BUDGETS()i32 { return 3; }
fn LMIN()i32 { return 3; }
fn LMAX()i32 { return 8; }

fn F_PAIR()i32 { return 0; }
fn F_REW()i32 { return 64; }
fn F_ADR()i32 { return 128; }
fn F_LEN()i32 { return 192; }

fn bidx(a:i32,b:i32)i32 { return a*8+b; }
fn permute(o:i32)i32 { return (o*3)%8; }

fn tlen(rg:i32)i32 {
  if(rg==0){ return 7; }
  if(rg==1){ return 6; }
  return 3;
}
fn tget(rg:i32,p:i32,pm:i32)i32 {
  let b:i32=0;
  if(rg==0){ b=(1+(p*3))%8; }
  else if(rg==1){ b=(2+(p*3))%8; }
  else { b=(1+p)%8; }
  if(pm==1){ return permute(b); }
  return b;
}

// which generic field this arm writes during prior episodes
// fld: 0 = no experience (controls). Otherwise the arm gets the BASE pair+length
// model (part of the generic construction loop) plus its principle field:
//   1 local plastic connectivity   2 learned rewrites
//   3 content-addressed            4 attractor/settling   5 learned exec transforms
// arm 10 is arm 0's state with identifiers permuted, so it must also be
// experienced (fld 1) -- it previously had fld 0 and therefore no state at all.
fn armField(a:i32)i32 {
  if(a==0){ return 1; }
  if(a==1){ return 2; }
  if(a==2){ return 3; }
  if(a==3){ return 4; }
  if(a==4){ return 5; }
  if(a==10){ return 1; }
  return 0;
}

fn mix(t:i32,q:i32,a:i32,rg:i32)i32 {
  let h:i32=(t+1)*2654435761;
  h=h+(q+1)*40503+a*2246822519+rg*97+t*31;
  h=h^(h>>13); h=h&0x7fffffff;
  h=h+(h>>7); h=h&0x7fffffff;
  return h;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<20);
  let ST:[]u8=z_alloc(FSZ()*4);
  let snap:[]u8=z_alloc(FSZ()*4);
  let prog:[]u8=z_alloc(LMAX()*4);
  let part:[]u8=z_alloc(LMAX()*4);
  let c:i32=0;

  c=o_app(ob,c,"PHASE10 RAW v1 ops=8 len=3..8 budget=200,1000,4000 prior=30"); c=o_nl(ob,c);
  c=o_app(ob,c,"arms 0-4 P1..P5 5fresh 6facts 7erased 8irrel 9mislead 10perm"); c=o_nl(ob,c);

  let rg:i32=0;
  while(rg<NREG()){
    let a:i32=0;
    while(a<NARM()){
      let pm:i32=0;
      if(a==10){ pm=1; }
      let fld:i32=armField(a);
      let L:i32=tlen(rg);

      // ---------- build generic learner state ----------
      let i:i32=0;
      while(i<FSZ()){ set32(ST,i*4,0); i=i+1; }

      // controls with no experience: 5 fresh, 7 erased
      if(fld!=0){
        let pr:i32=rg;
        if(a==8){ pr=2; }          // irrelevant prior: unrelated regime
        if(a==9){ pr=2; }          // misleading prior: unrelated + anti-weighted
        let e:i32=0;
        while(e<PRIOR()){
          let pl:i32=tlen(pr);
          let q:i32=0;
          while(q<pl-1){
            let u:i32=tget(pr,q,0);
            let v:i32=tget(pr,q+1,0);
            // BASE model: part of the generic construction loop, so every
            // experienced arm has it. The principle field is additional.
            set32(ST,F_PAIR()+bidx(u,v)*4,get32(ST,F_PAIR()+bidx(u,v)*4)+1);
            if(fld==1||fld==4){ }
            if(fld==5){
              // executable transforms: same pattern-keyed learned successor
              let w5:i32=tget(pr,q+2,0);
              set32(ST,F_REW()+bidx(u,v)*4,get32(ST,F_REW()+bidx(u,v)*4)+1);
              let r5:i32=(F_REW()+64+bidx(u,v))*4;
              if(get32(ST,r5)==0){ set32(ST,r5,w5); }
            }
            if(fld==2){
              // learned rewrite: pattern (u,v) -> the op w that ACTUALLY
              // followed. Keyed on the PATTERN so lookup uses the same key.
              let w:i32=tget(pr,q+2,0);
              set32(ST,F_REW()+bidx(u,v)*4,get32(ST,F_REW()+bidx(u,v)*4)+1);
              let rid:i32=(F_REW()+64+bidx(u,v))*4;
              if(get32(ST,rid)==0){ set32(ST,rid,w); }
            }
            if(fld==3){
              // content-addressed: record the address formed from the pair
              set32(ST,F_ADR()+bidx(u,v)*4,get32(ST,F_ADR()+bidx(u,v)*4)+1);
            }
            q=q+1;
          }
          set32(ST,F_LEN()+(pl-LMIN())*4,get32(ST,F_LEN()+(pl-LMIN())*4)+1);
          // START bigram
          let s0:i32=tget(pr,0,0);
          let s1:i32=tget(pr,1,0);
          set32(ST,F_PAIR()+bidx(8,s0)*4,get32(ST,F_PAIR()+bidx(8,s0)*4)+1);
          e=e+1;
        }
        if(a==9){
          // misleading: subtract the true target's pairs -> bias away
          let q2:i32=0;
          let pl2:i32=tlen(rg);
          while(q2<pl2-1){
            let u2:i32=tget(rg,q2,0);
            let v2:i32=tget(rg,q2+1,0);
            let k2:i32=F_PAIR()+bidx(u2,v2);
            let cur:i32=get32(ST,k2*4)-2;
            if(cur<1){ cur=1; }
            set32(ST,k2*4,cur);
            q2=q2+1;
          }
        }
      }

      // ---------- identifier permutation (arm 10) ----------
      // Relabel the PAIR table's columns and the REWRITE/ADR row+column
      // together, so the state is isomorphic to arm 1's. Length is
      // label-independent and is left alone.
      if(a==10){
        let pm2:[]u8=z_alloc(8*4);
        let m:i32=0;
        while(m<8){ set32(pm2,m*4,permute(m)); m=m+1; }
        let tp:[]u8=z_alloc(FSZ()*4);
        i=0;
        while(i<FSZ()){ set32(tp,i*4,get32(ST,i*4)); i=i+1; }
        // F_PAIR rows 0..8 (row 8 = START)
        i=0;
        while(i<9){
          let fr:i32=i;
          let pr:i32=fr;
          if(fr<8){ pr=get32(pm2,fr*4); }
          let fc:i32=0;
          while(fc<8){
            let to2:i32=F_PAIR()+bidx(pr,get32(pm2,fc*4));
            if(get32(tp,F_PAIR()+bidx(fr,fc)*4)>0){
              set32(ST,to2*4,get32(tp,F_PAIR()+bidx(fr,fc)*4));
            }
            fc=fc+1;
          }
          i=i+1;
        }
      }

      // smoothing: every slot positive so nothing is unreachable
      i=0;
      while(i<FSZ()){ if(get32(ST,i*4)<1){ set32(ST,i*4,1); } i=i+1; }

      // ---------- sweep budgets ----------
      let bi2:i32=0;
      while(bi2<BUDGETS()){
        let bud:i32=0;
        if(bi2==0){ bud=200; }
        if(bi2==1){ bud=1000; }
        if(bi2==2){ bud=4000; }

        let cost:i32=-1;
        let usedRew:i32=0;
        let tries:i32=0;
        while(tries<bud){
          // ---- 1. choose LENGTH from learned length counts ----
          let plen:i32=LMIN();
          if(fld!=0){
            let bl:i32=-1; let k:i32=0;
            while(k<=LMAX()-LMIN()){
              if(get32(ST,F_LEN()+k*4)>bl){ bl=get32(ST,F_LEN()+k*4); plen=LMIN()+k; }
              k=k+1;
            }
          }
          if(plen>LMAX()){ plen=LMAX(); }
          // jitter so length is not deterministic
          if(mix(tries,0,a,rg)%3==0){ plen=LMIN()+(mix(tries,1,a,rg)%(LMAX()-LMIN()+1)); }

          // ---- 2. sample ops from the pair model ----
          let ok:i32=1;
          let q:i32=0;
          while(q<plen){
            let row:i32=8;
            if(q>0){ row=get32(part,(q-1)*4); }
            let tot:i32=0; let o:i32=0;
            while(o<8){ tot=tot+get32(ST,F_PAIR()+bidx(row,o)*4); o=o+1; }
            if(tot<1){ tot=1; }
            let pk:i32=mix(tries,q+3,a,rg)%tot;
            let ac:i32=0; let ch:i32=0;
            while(ch<8){
              ac=ac+get32(ST,F_PAIR()+bidx(row,ch)*4);
              if(pk<ac){ break; }
              ch=ch+1;
            }
            if(ch>7){ ch=7; }
            set32(part,q*4,ch);
            q=q+1;
          }

          // ---- 3. apply a LEARNED REWRITE to the partial construction ----
          // available only if the state holds rewrites: this is the
          // structural move that fresh learners do not have.
          if(fld==2||fld==5){
            // apply the learned rewrite whose replacement was actually observed
            let applied:i32=0;
            let q3:i32=0;
            while(q3<plen-1){
              let u3:i32=get32(part,q3*4);
              let v3:i32=get32(part,(q3+1)*4);
              let kp:i32=bidx(u3,v3);
              if(get32(ST,F_REW()+kp*4)>0){
                // the learned successor for THIS pattern
                let bw:i32=get32(ST,F_REW()+64+kp*4);
                if(bw>=0 && bw<8){
                  set32(part,q3*4,get32(part,q3*4));
                  set32(part,(q3+1)*4,bw);
                  applied=1; break;
                }
              }
              q3=q3+1;
            }
            usedRew=applied;
          }

          // ---- 4. score against the target ----
          let good:i32=1;
          if(plen!=L){ good=0; }
          q=0;
          while(q<plen){
            if(get32(part,q*4)!=tget(rg,q,pm)){ good=0; }
            q=q+1;
          }
          let kk:i32=0;
          while(kk<LMAX()){ set32(prog,kk*4,get32(part,kk*4)); kk=kk+1; }
          if(good==1){ cost=tries+1; break; }
          tries=tries+1;
        }

        c=o_app(ob,c,"T rg="); c=o_i64(ob,c,rg as i64);
        c=o_app(ob,c," arm="); c=o_i64(ob,c,a as i64);
        c=o_app(ob,c," fld="); c=o_i64(ob,c,fld as i64);
        c=o_app(ob,c," len="); c=o_i64(ob,c,L as i64);
        c=o_app(ob,c," budget="); c=o_i64(ob,c,bud as i64);
        c=o_app(ob,c," cost="); c=o_i64(ob,c,cost as i64);
        c=o_app(ob,c," rew="); c=o_i64(ob,c,usedRew as i64);
        c=o_app(ob,c," t0="); c=o_i64(ob,c,tget(rg,0,pm) as i64);
        c=o_app(ob,c," t1="); c=o_i64(ob,c,tget(rg,1,pm) as i64);
        c=o_nl(ob,c);
        bi2=bi2+1;
      }
      a=a+1;
    }
    rg=rg+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}

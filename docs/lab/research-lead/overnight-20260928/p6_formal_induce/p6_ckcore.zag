// p6_ckcore.zag -- TRUE FL7 CHECKER (grammar + typing + scope + global).
// Uses p6_lang.zag. NEVER part of p6_train.
//
// Grammar implemented (family FL7, stage-gated):
//   Prog  := Top*
//   Top   := ProcDecl | Stmt
//   ProcDecl := PROC NAME LP TyList? RP COL Ty LET VAR ASG Expr SEMI END
//   Stmt  := LetBlock | IfBlock | Expr SEMI
//   LetBlock := LET VAR ASG Expr SEMI Stmt* END
//   IfBlock  := IF Expr BopBOOL Expr THEN Stmt* ELSE Stmt* END
//   Expr  := E1 ;  E1 := E2 (Bop[tier1] E2)* ;  E2 := E3 (Bop[tier0] E3)*
//   E3   := Vop E3 | Term | Call
//   Term  := Atom | VAR | Call
//   Call  := NAME LP Expr (COMMA Expr)* RP
//   TyList := Ty (COMMA Ty)*
//
// Stage gate: s>=1 ops, s>=2 typing, s>=3 VAR/LET/scope,
//             s>=4 corpus-only (no gate), s>=5 IF, s>=6 PROC/call.

// ---- parser state layout (i32 cells) ----
fn ck_pos()i32  { return 0; }
fn ck_ntok()i32 { return 4; }
fn ck_err()i32  { return 8; }
fn ck_sum()i32  { return 12; }
fn ck_nenv()i32 { return 16; }
fn ck_nsig()i32 { return 20; }
fn ck_d()i32    { return 24; }   // scope depth counter
fn ck_tokb()i32 { return 40; }   // + i*4, up to 128 tokens
fn ck_envb()i32 { return 576; }  // + e*12, 96
fn ck_sigb()i32 { return 1744; } // + s*20, 16
fn ck_argt()i32 { return 2072; } // 3 call argument types
fn ck_size()i32 { return 2100; }

fn eNONE()i32  { return 0; }
fn eSYN()i32   { return 1; }
fn eTYPE()i32  { return 2; }
fn eSCOPE()i32 { return 3; }
fn eGLOB()i32  { return 4; }
fn eNAME()i32  { return 5; }
fn eARITY()i32 { return 6; }
fn eRET()i32   { return 7; }
fn eLONG()i32  { return 8; }
fn eBIG()i32   { return 9; }

fn ck_get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn ck_set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn ck_reset(P:[]u8)void {
  let i:i32=0;
  while(i<ck_size()){ P[i]=0; i=i+1; }
  return;
}
fn ck_load(P:[]u8, TK:[]u8, n:i32)void {
  ck_reset(P);
  let i:i32=0;
  while(i<n){ ck_set32(P,ck_tokb()+i*4,ck_get32(TK,i*4)); i=i+1; }
  ck_set32(P,ck_ntok(),n);
  return;
}
fn ck_tk(P:[]u8)i32 {
  let p:i32=ck_get32(P,ck_pos());
  if(p>=ck_get32(P,ck_ntok())){ return -1; }
  return ck_get32(P,ck_tokb()+p*4);
}
fn ck_nx(P:[]u8)void {
  ck_set32(P,ck_pos(),ck_get32(P,ck_pos())+1);
  return;
}
fn ck_fail(P:[]u8,e:i32)void {
  if(ck_get32(P,ck_err())==eNONE()){ ck_set32(P,ck_err(),e); }
  return;
}

// ---- environment ----
fn ck_bind(P:[]u8,v:i32,t:i32)void {
  let n:i32=ck_get32(P,ck_nenv());
  if(n>=96){ ck_fail(P,eBIG()); return; }
  ck_set32(P,ck_envb()+n*12+0,v);
  ck_set32(P,ck_envb()+n*12+4,t);
  ck_set32(P,ck_envb()+n*12+8,ck_get32(P,ck_d()));
  ck_set32(P,ck_nenv(),n+1);
  return;
}
fn ck_unbind(P:[]u8,d0:i32)void {
  let n:i32=0;
  let i:i32=0;
  while(i<ck_get32(P,ck_nenv())){
    let d:i32=ck_get32(P,ck_envb()+i*12+8);
    if(d<=d0){
      ck_set32(P,ck_envb()+n*12+0,ck_get32(P,ck_envb()+i*12+0));
      ck_set32(P,ck_envb()+n*12+4,ck_get32(P,ck_envb()+i*12+4));
      ck_set32(P,ck_envb()+n*12+8,d);
      n=n+1;
    }
    i=i+1;
  }
  ck_set32(P,ck_nenv(),n);
  return;
}
fn ck_env(P:[]u8,v:i32)i32 {
  let i:i32=ck_get32(P,ck_nenv())-1;
  while(i>=0){
    if(ck_get32(P,ck_envb()+i*12+0)==v){ return i; }
    i=i-1;
  }
  return -1;
}
fn ck_sigf(P:[]u8,nm:i32)i32 {
  let i:i32=0;
  while(i<ck_get32(P,ck_nsig())){
    if(ck_get32(P,ck_sigb()+i*20+0)==nm){ return i; }
    i=i+1;
  }
  return -1;
}
fn ck_sigput(P:[]u8,nm:i32,np:i32,p0:i32,p1:i32,rt:i32)void {
  if(ck_sigf(P,nm)>=0){ return; }
  let n:i32=ck_get32(P,ck_nsig());
  if(n>=16){ ck_fail(P,eBIG()); return; }
  ck_set32(P,ck_sigb()+n*20+0,nm);
  ck_set32(P,ck_sigb()+n*20+4,np);
  ck_set32(P,ck_sigb()+n*20+8,p0);
  ck_set32(P,ck_sigb()+n*20+12,p1);
  ck_set32(P,ck_sigb()+n*20+16,rt);
  ck_set32(P,ck_nsig(),n+1);
  return;
}
fn ck_ty(L:[]u8,ti:i32)i32 {
  if(L_iskw(L,ti,kTYN())){ return tY(); }
  if(L_iskw(L,ti,kTYS())){ return tS(); }
  return tE();
}

// ---- pass 1: collect proc signatures ----
fn ck_sigscan(P:[]u8,L:[]u8)void {
  let n:i32=ck_get32(P,ck_ntok());
  let p:i32=0;
  while(p<n){
    let ti:i32=ck_get32(P,ck_tokb()+p*4);
    let ok:i32=0;
    if(L_iskw(L,ti,kPROC())){ ok=1; }
    if(ok==1){
      if(p+2>=n){ ok=0; }
    }
    if(ok==1){
      let t1:i32=ck_get32(P,ck_tokb()+(p+1)*4);
      let t2:i32=ck_get32(P,ck_tokb()+(p+2)*4);
      if(L_role(L,t1)!=rN()){ ok=0; }
      if(!L_iskw(L,t2,kLP())){ ok=0; }
    }
    if(ok==0){ p=p+1; continue; }
    p=p+1;
    let nm:i32=ck_get32(P,ck_tokb()+p*4);
    p=p+2;                       // now at LP
    let np:i32=0; let a0:i32=tE(); let a1:i32=tE();
    let go:i32=1;
    while(go==1){
      if(p>=n){ break; }
      let pv:i32=ck_get32(P,ck_tokb()+p*4);
      if(L_iskw(L,pv,kRP())){ go=0; }
      if(go==1){
        let ty:i32=ck_ty(L,pv);
        if(ty==tE()){ break; }
        if(np==0){ a0=ty; }
        if(np==1){ a1=ty; }
        np=np+1;
        p=p+1;
        if(np>=3){ go=0; } else {
          let c:i32=ck_get32(P,ck_tokb()+p*4);
          if(L_iskw(L,c,kCOM())){ p=p+1; } else { go=0; }
        }
      }
    }
    if(p<n){ p=p+1; }           // past RP
    p=p+2;                       // past COL and Ty
    let dd:i32=tE();
    if(p-1>=0 && p-1<n){ dd=ck_ty(L,ck_get32(P,ck_tokb()+(p-1)*4)); }
    while(p<n && !L_iskw(L,ck_get32(P,ck_tokb()+p*4),kEND())){ p=p+1; }
    if(p<n){ p=p+1; }           // past END
    ck_sigput(P,nm,np,a0,a1,dd);
  }
  return;
}

// ---- expression parser ----
fn ck_pexpr(P:[]u8,L:[]u8,lvl:i32)i32 {
  if(lvl==1){ return ck_l1(P,L); }
  if(lvl==0){ return ck_l0(P,L); }
  return ck_pri(P,L);
}
fn ck_l1(P:[]u8,L:[]u8)i32 {
  let st:i32=L_stage(L);
  let t:i32=ck_pexpr(P,L,0);
  let go:i32=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    let hit:i32=0;
    if(st>=1 && ti>=0 && L_role(L,ti)==rB() && L_tier(L,ti)==1){ hit=1; }
    if(hit==0){ go=0; }
    if(hit==1){
      let op:i32=ti;
      ck_nx(P);
      let tr:i32=ck_pexpr(P,L,0);
      if(st>=2){
        if(t>=tE() || tr>=tE()){ ck_fail(P,eTYPE()); return tE(); }
        if(L_lt(L,op)!=t || L_rt(L,op)!=tr){ ck_fail(P,eTYPE()); return tE(); }
      }
      t=L_res(L,op);
    }
  }
  return t;
}
fn ck_l0(P:[]u8,L:[]u8)i32 {
  let st:i32=L_stage(L);
  let t:i32=ck_pexpr(P,L,2);
  let go:i32=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    let hit:i32=0;
    if(st>=1 && ti>=0 && L_role(L,ti)==rB() && L_tier(L,ti)==0){ hit=1; }
    if(hit==0){ go=0; }
    if(hit==1){
      let op:i32=ti;
      ck_nx(P);
      let tr:i32=ck_pexpr(P,L,2);
      if(st>=2){
        if(t>=tE() || tr>=tE()){ ck_fail(P,eTYPE()); return tE(); }
        if(L_lt(L,op)!=t || L_rt(L,op)!=tr){ ck_fail(P,eTYPE()); return tE(); }
      }
      t=L_res(L,op);
    }
  }
  return t;
}
fn ck_pri(P:[]u8,L:[]u8)i32 {
  let st:i32=L_stage(L);
  let ti:i32=ck_tk(P);
  if(ti<0){ ck_fail(P,eSYN()); return tE(); }
  let r:i32=L_role(L,ti);
  if(L_isatom(L,ti)){
    ck_set32(P,ck_sum(),ck_get32(P,ck_sum())+L_val(L,ti));
    ck_nx(P);
    if(r==rY()){ return tY(); }
    return tS();
  }
  if(st>=3 && r==rV2()){
    let e:i32=ck_env(P,ti);
    if(e<0){ ck_fail(P,eSCOPE()); return tE(); }
    ck_nx(P);
    return ck_get32(P,ck_envb()+e*12+4);
  }
  if(st>=6 && r==rN()){
    ck_nx(P);
    ck_expect(P,L,kLP());
    let na:i32=0;
    let go:i32=1;
    while(go==1){
      let nx:i32=ck_tk(P);
      if(nx<0){ ck_fail(P,eSYN()); return tE(); }
      if(L_iskw(L,nx,kRP())){ go=0; }
      if(go==1){
        let at:i32=ck_pexpr(P,L,1);
        ck_set32(P,ck_argt()+na*4,at);
        na=na+1;
        if(na>=3){ ck_fail(P,eARITY()); return tE(); }
        let c:i32=ck_tk(P);
        if(c>=0 && L_iskw(L,c,kCOM())){ ck_nx(P); } else { go=0; }
      }
    }
    ck_expect(P,L,kRP());
    let s:i32=ck_sigf(P,ti);
    if(s<0){ ck_fail(P,eNAME()); return tE(); }
    let np:i32=ck_get32(P,ck_sigb()+s*20+4);
    if(np!=na){ ck_fail(P,eARITY()); return tE(); }
    let i:i32=0;
    while(i<np){
      let pv:i32=ck_get32(P,ck_sigb()+s*20+8+i*4);
      let at:i32=ck_get32(P,ck_argt()+i*4);
      if(at!=pv){ ck_fail(P,eTYPE()); return tE(); }
      i=i+1;
    }
    return ck_get32(P,ck_sigb()+s*20+16);
  }
  if(st>=1 && r==rV()){
    ck_nx(P);
    let inner:i32=ck_pexpr(P,L,2);
    if(st>=2){
      if(inner>=tE()){ ck_fail(P,eTYPE()); return tE(); }
      if(L_tin(L,ti)!=inner){ ck_fail(P,eTYPE()); return tE(); }
    }
    return L_tres(L,ti);
  }
  ck_fail(P,eSYN());
  return tE();
}
fn ck_expect(P:[]u8,L:[]u8,k:i32)void {
  let ti:i32=ck_tk(P);
  if(ti<0){ ck_fail(P,eSYN()); return; }
  if(!L_iskw(L,ti,k)){ ck_fail(P,eSYN()); return; }
  ck_nx(P);
  return;
}

// ---- statements ----
fn ck_stmt(P:[]u8,L:[]u8)void {
  let st:i32=L_stage(L);
  let ti:i32=ck_tk(P);
  if(ti<0){ ck_fail(P,eSYN()); return; }
  if(st>=3 && L_iskw(L,ti,kLET())){ ck_let(P,L); return; }
  if(st>=5 && L_iskw(L,ti,kIF())){ ck_if(P,L); return; }
  let t:i32=ck_pexpr(P,L,1);
  if(ck_get32(P,ck_err())!=eNONE()){ return; }
  ck_expect(P,L,kSEMI());
  return;
}
fn ck_let(P:[]u8,L:[]u8)void {
  let d0:i32=ck_get32(P,ck_d());
  ck_nx(P);
  let v:i32=ck_tk(P);
  if(v<0 || L_role(L,v)!=rV2()){ ck_fail(P,eSYN()); return; }
  ck_nx(P);
  ck_expect(P,L,kASG());
  let t:i32=ck_pexpr(P,L,1);
  if(ck_get32(P,ck_err())!=eNONE()){ return; }
  ck_bind(P,v,t);
  ck_expect(P,L,kSEMI());
  ck_set32(P,ck_d(),d0+1);
  let go:i32=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    if(ti<0){ ck_fail(P,eSYN()); return; }
    if(L_iskw(L,ti,kEND())){ go=0; }
    if(go==1){ ck_stmt(P,L); }
    if(ck_get32(P,ck_err())!=eNONE()){ return; }
  }
  ck_nx(P);
  ck_set32(P,ck_d(),d0);
  ck_unbind(P,d0);
  return;
}
fn ck_if(P:[]u8,L:[]u8)void {
  let d0:i32=ck_get32(P,ck_d());
  ck_nx(P);
  let t1:i32=ck_pexpr(P,L,1);
  if(ck_get32(P,ck_err())!=eNONE()){ return; }
  let op:i32=ck_tk(P);
  if(op<0 || L_role(L,op)!=rB() || L_res(L,op)!=tB()){ ck_fail(P,eTYPE()); return; }
  ck_nx(P);
  let t2:i32=ck_pexpr(P,L,1);
  if(ck_get32(P,ck_err())!=eNONE()){ return; }
  if(t1>=tE() || t2>=tE()){ ck_fail(P,eTYPE()); return; }
  if(L_lt(L,op)!=t1 || L_rt(L,op)!=t2){ ck_fail(P,eTYPE()); return; }
  ck_expect(P,L,kTHEN());
  ck_set32(P,ck_d(),d0+1);
  let go:i32=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    if(ti<0){ ck_fail(P,eSYN()); return; }
    if(L_iskw(L,ti,kELSE())){ go=0; }
    if(go==1){ ck_stmt(P,L); }
    if(ck_get32(P,ck_err())!=eNONE()){ return; }
  }
  ck_nx(P);
  go=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    if(ti<0){ ck_fail(P,eSYN()); return; }
    if(L_iskw(L,ti,kEND())){ go=0; }
    if(go==1){ ck_stmt(P,L); }
    if(ck_get32(P,ck_err())!=eNONE()){ return; }
  }
  ck_nx(P);
  ck_set32(P,ck_d(),d0);
  ck_unbind(P,d0);
  return;
}
fn ck_proc(P:[]u8,L:[]u8)void {
  ck_nx(P);
  let v:i32=ck_tk(P);
  if(v<0 || L_role(L,v)!=rN()){ ck_fail(P,eSYN()); return; }
  ck_nx(P);
  ck_expect(P,L,kLP());
  let np:i32=0;
  let go:i32=1;
  while(go==1){
    let ti:i32=ck_tk(P);
    if(ti<0){ ck_fail(P,eSYN()); return; }
    if(L_iskw(L,ti,kRP())){ go=0; }
    if(go==1){
      let ty:i32=ck_ty(L,ti);
      if(ty==tE()){ ck_fail(P,eSYN()); return; }
      np=np+1;
      ck_nx(P);
      if(np>=3){ ck_fail(P,eSYN()); return; }
      let c:i32=ck_tk(P);
      if(c>=0 && L_iskw(L,c,kCOM())){ ck_nx(P); } else { go=0; }
    }
  }
  ck_expect(P,L,kRP());
  ck_expect(P,L,kCOL());
  let dd:i32=ck_ty(L,ck_tk(P));
  if(dd==tE()){ ck_fail(P,eSYN()); return; }
  ck_nx(P);
  ck_expect(P,L,kLET());
  let bv:i32=ck_tk(P);
  if(bv<0 || L_role(L,bv)!=rV2()){ ck_fail(P,eSYN()); return; }
  ck_nx(P);
  ck_expect(P,L,kASG());
  let bt:i32=ck_pexpr(P,L,1);
  if(ck_get32(P,ck_err())!=eNONE()){ return; }
  ck_expect(P,L,kSEMI());
  ck_expect(P,L,kEND());
  if(bt!=dd){ ck_fail(P,eRET()); return; }
  return;
}
fn ck_top(P:[]u8,L:[]u8)void {
  let st:i32=L_stage(L);
  let ti:i32=ck_tk(P);
  if(ti<0){ ck_fail(P,eSYN()); return; }
  if(st>=6 && L_iskw(L,ti,kPROC())){ ck_proc(P,L); return; }
  ck_stmt(P,L);
  return;
}

// ---- entry ----
fn ck_check(L:[]u8,P:[]u8,TK:[]u8,n:i32)i32 {
  ck_load(P,TK,n);
  if(n<=0 || n>128){ ck_fail(P,eSYN()); return ck_get32(P,ck_err()); }
  if(n>32){ ck_fail(P,eLONG()); return ck_get32(P,ck_err()); }
  ck_sigscan(P,L);
  if(ck_get32(P,ck_err())!=eNONE()){ return ck_get32(P,ck_err()); }
  let p:i32=0;
  while(p<ck_get32(P,ck_ntok())){
    ck_top(P,L);
    if(ck_get32(P,ck_err())!=eNONE()){ return ck_get32(P,ck_err()); }
    p=ck_get32(P,ck_pos());
  }
  let m:i32=L_M(L);
  let s:i32=ck_get32(P,ck_sum());
  s=s-(s/m)*m;
  if(s!=L_C(L)){ return eGLOB(); }
  return eNONE();
}

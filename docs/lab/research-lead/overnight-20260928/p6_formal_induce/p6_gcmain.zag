// p6_gcmain.zag -- main for p6_gencorpus.
// Builds corpora for stages 0..6 for two frozen seeds and writes
//   corpus_A_s<s>.txt / seed_A.txt
//   corpus_B_s<s>.txt / seed_B.txt
// Prints a per-stage summary.  Pure Zag.

fn gm_dir()[]u8 { return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_formal_induce/"; }
fn gm_seedA()i32 { return 1009; }
fn gm_seedB()i32 { return 2027; }
fn gm_nvalid()i32 { return 130; }
fn gm_ninval()i32 { return 90; }

fn gm_count(CB:[]u8,cn:i32,lab:i32)i32 {
  let k:i32=0;
  let i:i32=0;
  while(i<cn){
    if(cr_lab(CB,i)==lab){ k=k+1; }
    i=i+1;
  }
  return k;
}
fn gm_sum(L:[]u8,TK:[]u8,n:i32)i32 {
  let s:i32=0;
  let i:i32=0;
  while(i<n){
    let ti:i32=lg_get(TK,i*4);
    if(L_isatom(L,ti)==1){ s=s+L_val(L,ti); }
    i=i+1;
  }
  return s;
}
// repair the modular constraint by appending 1..3 atom statements whose values
// sum to the residual. returns new n or -1.
fn gm_fix(L:[]u8,TK:[]u8,n:i32)i32 {
  let m:i32=L_M(L);
  let s:i32=lg_m32(gm_sum(L,TK,n),m);
  let delta:i32=L_C(L)-s;
  if(delta<0){ delta=delta+m; }
  if(delta==0){ return n; }
  let k:i32=lg_get(L,bd_len()+delta*4);
  if(k<0){ return -1; }
  if(n+2*k>32){ return -1; }
  let i:i32=0;
  while(i<k){
    let t:i32=lg_get(L,bd_a()+delta*4);
    if(i==1){ t=lg_get(L,bd_b()+delta*4); }
    if(i==2){ t=lg_get(L,bd_c()+delta*4); }
    lg_put(TK,n*4,t);
    lg_put(TK,(n+1)*4,gc_kw(L,kSEMI()));
    n=n+2;
    i=i+1;
  }
  return n;
}

// atom-sequence probes: lengths 1,2 and a stride of length 3
fn gm_probes(L:[]u8,P:[]u8,CB:[]u8,cn:i32,TK:[]u8)i32 {
  let na:i32=gc_nallatoms(L);
  let a:i32=0;
  while(a<na){
    let n:i32=2;
    lg_put(TK,0,gc_allatom(L,a));
    lg_put(TK,4,gc_kw(L,kSEMI()));
    cn=gm_push(L,P,CB,cn,TK,n);
    a=a+1;
  }
  a=0;
  while(a<na){
    let b:i32=0;
    while(b<na){
      let n:i32=4;
      lg_put(TK,0,gc_allatom(L,a)); lg_put(TK,4,gc_kw(L,kSEMI()));
      lg_put(TK,8,gc_allatom(L,b)); lg_put(TK,12,gc_kw(L,kSEMI()));
      cn=gm_push(L,P,CB,cn,TK,n);
      b=b+1;
    }
    a=a+1;
  }
  let idx:i32=0;
  a=0;
  while(a<na){
    let b:i32=0;
    while(b<na){
      let c:i32=0;
      while(c<na){
        if(idx%9==0){
          let n:i32=6;
          lg_put(TK,0,gc_allatom(L,a)); lg_put(TK,4,gc_kw(L,kSEMI()));
          lg_put(TK,8,gc_allatom(L,b)); lg_put(TK,12,gc_kw(L,kSEMI()));
          lg_put(TK,16,gc_allatom(L,c)); lg_put(TK,20,gc_kw(L,kSEMI()));
          cn=gm_push(L,P,CB,cn,TK,n);
        }
        idx=idx+1;
        c=c+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  return cn;
}
// label with the truth checker and append
fn gm_push(L:[]u8,P:[]u8,CB:[]u8,cn:i32,TK:[]u8,n:i32)i32 {
  let e:i32=ck_check(L,P,TK,n);
  let lab:i32=0;
  if(e==eNONE()){ lab=1; }
  return cr_add(CB,cn,n,lab,TK);
}


fn gm_stage(L:[]u8,G:[]u8,P:[]u8,CB:[]u8,TK:[]u8)i32 {
  let cn:i32=gm_probes(L,P,CB,0,TK);
  // fill VALID
  let att:i32=0;
  while(gm_count(CB,cn,1)<gm_nvalid() && att<40000){
    lg_put(G,gc_nenv(),0);
    lg_put(G,gc_nsig(),0);
    lg_put(G,gc_d(),1);
    let n:i32=0;
    if(lg_rn(L,2)==0){
      n=gp_atoms_only(L,TK,0,1+lg_rn(L,5));
    } else {
      n=gp_prog(G,L,TK,0);
    }
    let n2:i32=-1;
    if(n>=1 && n<=32){ n2=gm_fix(L,TK,n); }
    if(n2>0 && n2<=32 && ck_check(L,P,TK,n2)==eNONE()){
      cn=cr_add(CB,cn,n2,1,TK);
    }
    att=att+1;
  }
  // fill INVALID by single-token near miss from a VALID example
  att=0;
  while(gm_count(CB,cn,0)<gm_ninval() && att<20000){
    let base:i32=0;
    let nv:i32=gm_count(CB,cn,1);
    if(nv<1){ break; }
    base=lg_rn(L,nv);
    let k:i32=0;
    let vi:i32=-1;
    let i:i32=0;
    while(i<cn){
      if(cr_lab(CB,i)==1 && k==base){ vi=i; }
      if(cr_lab(CB,i)==1){ k=k+1; }
      i=i+1;
    }
    if(vi<0){ break; }
    let n:i32=cr_n(CB,vi);
    let j:i32=0;
    while(j<n){ lg_put(TK,j*4,cr_tok(CB,vi,j)); j=j+1; }
    let kind:i32=lg_rn(L,3);
    let p:i32=lg_rn(L,n);
    let n2:i32=n;
    if(kind==0){
      lg_put(TK,p*4,lg_rn(L,lg_nt()));
    } else {
      if(kind==1){
        let q:i32=p;
        while(q<n-1){ lg_put(TK,q*4,lg_get(TK,(q+1)*4)); q=q+1; }
        n2=n-1;
      } else {
        let q:i32=n;
        while(q>p){ lg_put(TK,q*4,lg_get(TK,(q-1)*4)); q=q-1; }
        lg_put(TK,p*4,lg_rn(L,lg_nt()));
        n2=n+1;
      }
    }
    if(n2>=1 && n2<=32 && ck_check(L,P,TK,n2)!=eNONE()){
      cn=cr_add(CB,cn,n2,0,TK);
    }
    att=att+1;
  }
  return cn;
}

fn gm_ser(CB:[]u8,cn:i32,OB:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<cn){
    OB[c]=48+cr_lab(CB,i); c=c+1;
    let j:i32=0;
    while(j<cr_n(CB,i)){ OB[c]=65+cr_tok(CB,i,j); c=c+1; j=j+1; }
    OB[c]=10; c=c+1;
    i=i+1;
  }
  return c;
}
fn gm_path(PB:[]u8,which:i32,stage:i32)i32 {
  let c:i32=io_app(PB,0,gm_dir());
  c=io_app(PB,c,"corpus_");
  if(which==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,"_s");
  PB[c]=48+stage; c=c+1;
  c=io_app(PB,c,".txt");
  return c;
}
fn gm_seedpath(PB:[]u8,which:i32)i32 {
  let c:i32=io_app(PB,0,gm_dir());
  c=io_app(PB,c,"seed_");
  if(which==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,".txt");
  return c;
}

fn main()i32 {
  let ob:[]u8=io_alloc(60000);
  let L:[]u8=io_alloc(lg_size());
  let P:[]u8=io_alloc(ck_size());
  let G:[]u8=io_alloc(gc_size());
  let CB:[]u8=io_alloc(220*cr_stride()+64);
  let TK:[]u8=io_alloc(64*4);
  let OB:[]u8=io_alloc(40000);
  let PB:[]u8=io_alloc(256);
  let SB:[]u8=io_alloc(64);
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let seed:i32=gm_seedA();
    if(w==1){ seed=gm_seedB(); }
    let s:i32=0;
    while(s<7){
      lang_build(L,seed,s);
      bd_build(L);
      let cn:i32=gm_stage(L,G,P,CB,TK);
      let len:i32=gm_ser(CB,cn,OB);
      let pl:i32=gm_path(PB,w,s);
      let ps:[]u8=PB[0..pl];
      _zag_write_file(ps,OB[0..len]);
      let sp:i32=gm_seedpath(PB,w);
      let sl:i32=io_i64(SB,0,seed as i64);
      SB[sl]=10;
      let ss:[]u8=SB[0..sl+1];
      let sps:[]u8=PB[0..sp];
      _zag_write_file(sps,ss);
      c=io_app(ob,c,"CORPUS seed="); c=io_i64(ob,c,seed as i64);
      c=io_app(ob,c," set="); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," stage="); c=io_i64(ob,c,s as i64);
      c=io_app(ob,c," n="); c=io_i64(ob,c,cn as i64);
      c=io_app(ob,c," valid="); c=io_i64(ob,c,gm_count(CB,cn,1) as i64);
      c=io_app(ob,c," invalid="); c=io_i64(ob,c,gm_count(CB,cn,0) as i64);
      c=io_app(ob,c," M="); c=io_i64(ob,c,L_M(L) as i64);
      c=io_app(ob,c," C="); c=io_i64(ob,c,L_C(L) as i64);
      c=io_nl(ob,c);
      s=s+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

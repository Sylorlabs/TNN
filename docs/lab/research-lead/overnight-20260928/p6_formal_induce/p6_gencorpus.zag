// p6_gencorpus.zag -- WORLD. Builds the stage training corpus.
// Contains p6_lang (instance) + p6_ckcore (truth). NEVER in p6_train.
//
// Programs come from a type-directed generator that is correct by
// construction for syntax and typing; only the global modular constraint
// needs repair, by substituting or appending atom tokens. The truth checker
// is consulted only for (a) that repair and (b) labelling near-miss
// negatives -- so no generated program is ever "accepted" by trying things
// until one passes.
//
// Corpus file format, one example per line:
//    <label><tok><tok>...      label '1' = VALID, '0' = INVALID
//    token t is the byte 65+t
// Exactly 220 records per stage: 130 VALID + 90 INVALID.

fn gc_d()i32     { return 4; }
fn gc_nenv()i32  { return 8; }
fn gc_envb()i32  { return 16; }   // + e*12, 64
fn gc_nsig()i32  { return 800; }
fn gc_sigb()i32  { return 832; }  // + s*20, 8
fn gc_size()i32  { return 1000; }

fn gc_get(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn gc_put(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}

// ---------------- generator env / sigs ----------------
fn gc_bind(G:[]u8,v:i32,t:i32)void {
  let n:i32=gc_get(G,gc_nenv());
  if(n>=64){ return; }
  gc_put(G,gc_envb()+n*12+0,v);
  gc_put(G,gc_envb()+n*12+4,t);
  gc_put(G,gc_envb()+n*12+8,gc_get(G,gc_d()));
  gc_put(G,gc_nenv(),n+1);
  return;
}
fn gc_unbind(G:[]u8,d0:i32)void {
  let n:i32=0;
  let i:i32=0;
  while(i<gc_get(G,gc_nenv())){
    let d:i32=gc_get(G,gc_envb()+i*12+8);
    if(d<=d0){
      gc_put(G,gc_envb()+n*12+0,gc_get(G,gc_envb()+i*12+0));
      gc_put(G,gc_envb()+n*12+4,gc_get(G,gc_envb()+i*12+4));
      gc_put(G,gc_envb()+n*12+8,d);
      n=n+1;
    }
    i=i+1;
  }
  gc_put(G,gc_nenv(),n);
  return;
}
fn gc_var_of_type(G:[]u8,t:i32,k:i32)i32 {
  let n:i32=0;
  let i:i32=gc_get(G,gc_nenv())-1;
  while(i>=0){
    if(gc_get(G,gc_envb()+i*12+4)==t){
      if(n==k){ return gc_get(G,gc_envb()+i*12+0); }
      n=n+1;
    }
    i=i+1;
  }
  return -1;
}
fn gc_nvars_of_type(G:[]u8,t:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<gc_get(G,gc_nenv())){
    if(gc_get(G,gc_envb()+i*12+4)==t){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn gc_sigput(G:[]u8,nm:i32,np:i32,p0:i32,p1:i32,rt:i32)void {
  let n:i32=gc_get(G,gc_nsig());
  if(n>=8){ return; }
  gc_put(G,gc_sigb()+n*20+0,nm);
  gc_put(G,gc_sigb()+n*20+4,np);
  gc_put(G,gc_sigb()+n*20+8,p0);
  gc_put(G,gc_sigb()+n*20+12,p1);
  gc_put(G,gc_sigb()+n*20+16,rt);
  gc_put(G,gc_nsig(),n+1);
  return;
}

// ---------------- token pickers ----------------
fn gc_natoms(L:[]u8,t:i32)i32 {
  let want:i32=rY();
  if(t==1){ want=rS(); }
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==want){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn gc_atom(L:[]u8,t:i32,k:i32)i32 {
  let want:i32=rY();
  if(t==1){ want=rS(); }
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==want){
      if(n==k){ return i; }
      n=n+1;
    }
    i=i+1;
  }
  return -1;
}
fn gc_nallatoms(L:[]u8)i32 { return gc_natoms(L,0)+gc_natoms(L,1); }
fn gc_allatom(L:[]u8,k:i32)i32 {
  let na:i32=gc_natoms(L,0);
  if(k<na){ return gc_atom(L,0,k); }
  return gc_atom(L,1,k-na);
}
fn gc_atom_by_val(L:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<lg_nt()){
    if(L_isatom(L,i)==1 && L_val(L,i)==v){ return i; }
    i=i+1;
  }
  return -1;
}
fn gc_nrole(L:[]u8,want:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==want){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn gc_role(L:[]u8,want:i32,k:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==want){
      if(n==k){ return i; }
      n=n+1;
    }
    i=i+1;
  }
  return -1;
}
fn gc_nbop_res(L:[]u8,t:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==rB() && L_res(L,i)==t){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn gc_bop_res(L:[]u8,t:i32,k:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==rB() && L_res(L,i)==t){
      if(n==k){ return i; }
      n=n+1;
    }
    i=i+1;
  }
  return -1;
}
fn gc_nvop_tres(L:[]u8,t:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==rV() && L_tres(L,i)==t){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn gc_vop_tres(L:[]u8,t:i32,k:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<lg_nt()){
    if(L_role(L,i)==rV() && L_tres(L,i)==t){
      if(n==k){ return i; }
      n=n+1;
    }
    i=i+1;
  }
  return -1;
}
fn gc_kw(L:[]u8,sub:i32)i32 {
  let i:i32=0;
  while(i<lg_nt()){
    if(L_iskw(L,i,sub)==1){ return i; }
    i=i+1;
  }
  return -1;
}

// ---------------- expression generator (type-directed) ----------------
fn gp_term(G:[]u8,L:[]u8,TK:[]u8,n:i32,t:i32)i32 {
  let st:i32=L_stage(L);
  let o0:i32=-1; let o1:i32=-1; let o2:i32=-1;
  let no:i32=0;
  if(gc_natoms(L,t)>0){ o0=no; no=no+1; }
  if(st>=3 && gc_nvars_of_type(G,t)>0){ o1=no; no=no+1; }
  if(st>=6 && gc_get(G,gc_nsig())>0){ o2=no; no=no+1; }
  if(no==0){ o0=0; no=1; }
  let ch:i32=lg_rn(L,no);
  let sel:i32=0;
  if(ch==o1){ sel=1; }
  if(ch==o2){ sel=2; }
  if(sel==0){
    let a:i32=gc_atom(L,t,lg_rn(L,gc_natoms(L,t)));
    lg_put(TK,n*4,a); return n+1;
  }
  if(sel==1){
    let v:i32=gc_var_of_type(G,t,lg_rn(L,gc_nvars_of_type(G,t)));
    lg_put(TK,n*4,v); return n+1;
  }
  let s:i32=lg_rn(L,gc_get(G,gc_nsig()));
  let nm:i32=gc_get(G,gc_sigb()+s*20+0);
  gc_put(TK,n*4,nm); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kLP())); n=n+1;
  let np:i32=gc_get(G,gc_sigb()+s*20+4);
  let i:i32=0;
  while(i<np){
    if(i>0){ gc_put(TK,n*4,gc_kw(L,kCOM())); n=n+1; }
    let at:i32=gc_get(G,gc_sigb()+s*20+8+i*4);
    n=gp_expr(G,L,TK,n,at,0);
    i=i+1;
  }
  gc_put(TK,n*4,gc_kw(L,kRP())); n=n+1;
  return n;
}
fn gp_expr(G:[]u8,L:[]u8,TK:[]u8,n:i32,t:i32,d:i32)i32 {
  let st:i32=L_stage(L);
  if(d<=0){ return gp_term(G,L,TK,n,t); }
  let r:i32=lg_rn(L,6);
  if(st>=1 && r<=1){
    let nv:i32=gc_nvop_tres(L,t);
    if(nv>0){
      let v:i32=gc_vop_tres(L,t,lg_rn(L,nv));
      gc_put(TK,n*4,v); n=n+1;
      return gp_expr(G,L,TK,n,L_tin(L,v),d-1);
    }
  }
  if(st>=1 && r<=4){
    let nb:i32=gc_nbop_res(L,t);
    if(nb>0){
      let b:i32=gc_bop_res(L,t,lg_rn(L,nb));
      n=gp_expr(G,L,TK,n,L_lt(L,b),d-1);
      gc_put(TK,n*4,b); n=n+1;
      return gp_expr(G,L,TK,n,L_rt(L,b),d-1);
    }
  }
  return gp_term(G,L,TK,n,t);
}

// ---------------- statement generator ----------------
fn gp_stmts(G:[]u8,L:[]u8,TK:[]u8,n:i32,d:i32,lim:i32)i32 {
  let k:i32=lg_rn(L,lim);
  let i:i32=0;
  while(i<k){
    n=gp_stmt(G,L,TK,n,d);
    i=i+1;
  }
  return n;
}
fn gp_let(G:[]u8,L:[]u8,TK:[]u8,n:i32,d:i32)i32 {
  let t:i32=lg_rn(L,2);
  let v:i32=gc_role(L,rV2(),lg_rn(L,gc_nrole(L,rV2())));
  gc_put(TK,n*4,gc_kw(L,kLET())); n=n+1;
  gc_put(TK,n*4,v); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kASG())); n=n+1;
  n=gp_expr(G,L,TK,n,t,d);
  gc_put(TK,n*4,gc_kw(L,kSEMI())); n=n+1;
  gc_bind(G,v,t);
  n=gp_stmts(G,L,TK,n,d+1,3);
  gc_unbind(G,gc_get(G,gc_d()));
  gc_put(TK,n*4,gc_kw(L,kEND())); n=n+1;
  return n;
}
fn gp_if(G:[]u8,L:[]u8,TK:[]u8,n:i32,d:i32)i32 {
  gc_put(TK,n*4,gc_kw(L,kIF())); n=n+1;
  n=gp_expr(G,L,TK,n,tY(),d);
  gc_put(TK,n*4,L_cmp(L)); n=n+1;
  n=gp_expr(G,L,TK,n,tY(),d);
  gc_put(TK,n*4,gc_kw(L,kTHEN())); n=n+1;
  n=gp_stmts(G,L,TK,n,d+1,3);
  gc_put(TK,n*4,gc_kw(L,kELSE())); n=n+1;
  n=gp_stmts(G,L,TK,n,d+1,3);
  gc_put(TK,n*4,gc_kw(L,kEND())); n=n+1;
  return n;
}
// At stage 6 there is exactly one NAME token, so exactly one procedure is
// declared. Its arity/param types/return type are drawn once, registered, and
// every call must match that signature exactly.
fn gp_proc(G:[]u8,L:[]u8,TK:[]u8,n:i32)i32 {
  let nm:i32=gc_role(L,rN(),0);
  let np:i32=lg_rn(L,2);
  let p0:i32=lg_rn(L,2);
  let p1:i32=lg_rn(L,2);
  let rt:i32=lg_rn(L,2);
  gc_sigput(G,nm,np,p0,p1,rt);
  gc_put(TK,n*4,gc_kw(L,kPROC())); n=n+1;
  gc_put(TK,n*4,nm); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kLP())); n=n+1;
  let i:i32=0;
  while(i<np){
    if(i>0){ gc_put(TK,n*4,gc_kw(L,kCOM())); n=n+1; }
    let at:i32=tY();
    if(i==0){ at=p0; }
    if(i==1){ at=p1; }
    gc_put(TK,n*4,at+kTYN()); n=n+1;
    i=i+1;
  }
  gc_put(TK,n*4,gc_kw(L,kRP())); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kCOL())); n=n+1;
  gc_put(TK,n*4,rt+kTYN()); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kLET())); n=n+1;
  gc_put(TK,n*4,gc_role(L,rV2(),lg_rn(L,gc_nrole(L,rV2())))); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kASG())); n=n+1;
  n=gp_expr(G,L,TK,n,rt,1);
  gc_put(TK,n*4,gc_kw(L,kSEMI())); n=n+1;
  gc_put(TK,n*4,gc_kw(L,kEND())); n=n+1;
  return n;
}
fn gp_stmt(G:[]u8,L:[]u8,TK:[]u8,n:i32,d:i32)i32 {
  let st:i32=L_stage(L);
  let r:i32=lg_rn(L,12);
  if(st>=5 && d<3 && r<=1){ return gp_if(G,L,TK,n,d); }
  if(st>=3 && d<3 && r<=5){ return gp_let(G,L,TK,n,d); }
  let t:i32=lg_rn(L,2);
  n=gp_expr(G,L,TK,n,t,d);
  gc_put(TK,n*4,gc_kw(L,kSEMI())); n=n+1;
  return n;
}

// ---- residue decomposition table (world-side) ----
// For every residue d in [0,M) store a multiset of 1..3 atom tokens whose
// values sum to d mod M. Built once per instance; makes the global-constraint
// repair always succeed, which a naive "append one atom whose value equals the
// residual" cannot do when M > |atom values|.
fn bd_len()i32 { return 1400; }
fn bd_a()i32  { return 1664; }
fn bd_b()i32  { return 1920; }
fn bd_c()i32  { return 2176; }
fn bd_build(L:[]u8)void {
  let m:i32=L_M(L);
  let na:i32=gc_nallatoms(L);
  let i:i32=0;
  while(i<m){ gc_put(L,bd_len()+i*4,-1); i=i+1; }
  i=0;
  while(i<na){
    let t1:i32=gc_allatom(L,i);
    let v1:i32=L_val(L,t1);
    if(gc_get(L,bd_len()+v1*4)<0){ gc_put(L,bd_len()+v1*4,1); gc_put(L,bd_a()+v1*4,t1); }
    i=i+1;
  }
  i=0;
  while(i<na){
    let t1:i32=gc_allatom(L,i);
    let v1:i32=L_val(L,t1);
    let j:i32=0;
    while(j<na){
      let t2:i32=gc_allatom(L,j);
      let v:i32=lg_m32(v1+L_val(L,t2),m);
      if(gc_get(L,bd_len()+v*4)<0){ gc_put(L,bd_len()+v*4,2); gc_put(L,bd_a()+v*4,t1); gc_put(L,bd_b()+v*4,t2); }
      j=j+1;
    }
    i=i+1;
  }
  i=0;
  while(i<na){
    let t1:i32=gc_allatom(L,i);
    let v1:i32=L_val(L,t1);
    let j:i32=0;
    while(j<na){
      let t2:i32=gc_allatom(L,j);
      let v2:i32=lg_m32(v1+L_val(L,t2),m);
      let k:i32=0;
      while(k<na){
        let t3:i32=gc_allatom(L,k);
        let v:i32=lg_m32(v2+L_val(L,t3),m);
        if(gc_get(L,bd_len()+v*4)<0){ gc_put(L,bd_len()+v*4,3); gc_put(L,bd_a()+v*4,t1); gc_put(L,bd_b()+v*4,t2); gc_put(L,bd_c()+v*4,t3); }
        k=k+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  return;
}
fn gp_atoms_only(L:[]u8,TK:[]u8,n:i32,k:i32)i32 {
  let i:i32=0;
  while(i<k){
    gc_put(TK,n*4,gc_allatom(L,lg_rn(L,gc_nallatoms(L)))); n=n+1;
    gc_put(TK,n*4,gc_kw(L,kSEMI())); n=n+1;
    i=i+1;
  }
  return n;
}
fn gp_prog(G:[]u8,L:[]u8,TK:[]u8,n:i32)i32 {
  let st:i32=L_stage(L);
  let k:i32=1+lg_rn(L,3);
  if(st>=6){ k=1; }
  if(st>=6){ n=gp_proc(G,L,TK,n); }
  let i:i32=0;
  while(i<k){ n=gp_stmt(G,L,TK,n,1); i=i+1; }
  return n;
}

// ---------------- corpus store ----------------
fn cr_stride()i32 { return 140; }
fn cr_n(CB:[]u8,i:i32)i32 { return gc_get(CB,i*cr_stride()); }
fn cr_lab(CB:[]u8,i:i32)i32 { return gc_get(CB,i*cr_stride()+4); }
fn cr_tok(CB:[]u8,i:i32,j:i32)i32 { return gc_get(CB,i*cr_stride()+8+j*4); }
fn cr_set(CB:[]u8,i:i32,n:i32,lab:i32,TK:[]u8)void {
  gc_put(CB,i*cr_stride(),n);
  gc_put(CB,i*cr_stride()+4,lab);
  let j:i32=0;
  while(j<n){ gc_put(CB,i*cr_stride()+8+j*4,gc_get(TK,j*4)); j=j+1; }
  return;
}
fn cr_same(CB:[]u8,a:i32,b:i32)i32 {
  if(cr_n(CB,a)!=cr_n(CB,b)){ return 0; }
  let j:i32=0;
  while(j<cr_n(CB,a)){
    if(cr_tok(CB,a,j)!=cr_tok(CB,b,j)){ return 0; }
    j=j+1;
  }
  return 1;
}
fn cr_dup(CB:[]u8,cn:i32,TK:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<cn){
    if(cr_n(CB,i)==n){
      let same:i32=1;
      let j:i32=0;
      while(j<n){
        if(cr_tok(CB,i,j)!=gc_get(TK,j*4)){ same=0; }
        j=j+1;
      }
      if(same==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn cr_add(CB:[]u8,cn:i32,n:i32,lab:i32,TK:[]u8)i32 {
  if(n<1 || n>32){ return cn; }
  if(cr_dup(CB,cn,TK,n)==1){ return cn; }
  cr_set(CB,cn,n,lab,TK);
  return cn+1;
}
fn cr_label(CB:[]u8,i:i32)i32 { return cr_lab(CB,i); }



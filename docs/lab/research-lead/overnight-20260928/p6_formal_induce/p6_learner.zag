// p6_learner.zag -- THE LEARNER.
//
// Input: corpus.txt only (token sequences + one label bit each).
// Contains no seed, no grammar table, no keyword identity, no role name, no
// type code, and no reference to any world/checker symbol.
//
// Induced, in this order:
//   L1 closing token + block-opening token set   (bracket model, chosen by
//      scoring every candidate against the VALID examples)
//   L2 statement separator token
//   L3 atom / variable / operator / term role sets
//   L4 depth-class-conditioned bigram model with unigram back-off
//   L5 forbidden tokens and forbidden bigrams    (from the INVALID examples)
//   L6 operator x operand compatibility table    (the typing constraint)
//   L7 bind pattern + scope rule
//   L8 modulus, required residue, and the value of every atom token
//      (the hidden global constraint), recovered by bounded search
//
// Generation walks L4 forward; L5/L6/L7 gate it; L8 is used to CONSTRUCT
// rather than to reject. The same induced structure generates and accepts,
// which is the point of the lane.

fn l_get(b:[]u8,o:i32)i32 { return pl_get(b,o); }
fn l_put(b:[]u8,o:i32,v:i32)void { pl_put(b,o,v); return; }

fn l_c0()i32  { return 256; }
fn l_xt()i32  { return 512; }
fn l_xf()i32  { return 4608; }
fn l_f2()i32  { return 8704; }
fn l_lt()i32  { return 9728; }
fn l_ft()i32  { return 9792; }
fn l_d2()i32  { return 9856; }
fn l_ok2()i32 { return 21504; }
fn l_sc()i32  { return 22528; }
fn l_vval()i32{ return 22784; }
fn l_dom()i32 { return 22848; }
fn l_eq()i32  { return 23000; }
fn l_eqc()i32 { return 40700; }
fn l_gen()i32 { return 41120; }
fn l_ol()i32  { return 400; }
fn l_atl()i32 { return 440; }
fn l_vall()i32{ return 480; }
fn l_bopl()i32{ return 520; }
fn l_vopl()i32{ return 560; }
fn l_terml()i32{ return 600; }
fn lsize()i32 { return 65536; }

fn sc(i:i32)i32 { return l_sc()+i*4; }
fn sN()i32  { return 0; }
fn sRNG()i32{ return 1; }
fn sNO()i32 { return 2; }
fn sCL()i32 { return 3; }
fn sSEP()i32{ return 4; }
fn sNAT()i32{ return 5; }
fn sNV()i32 { return 6; }
fn sNBOP()i32{ return 7; }
fn sNVOP()i32{ return 8; }
fn sNTRM()i32{ return 9; }
fn sASG()i32{ return 10; }
fn sM()i32  { return 11; }
fn sCRES()i32{ return 12; }
fn sNSOL()i32{ return 13; }
fn sFP()i32 { return 14; }
fn sVSOL()i32{ return 15; }
fn sNOF()i32{ return 16; }
fn sFIT()i32{ return 17; }
fn sFITV()i32{ return 18; }
fn sCFG()i32{ return 19; }

fn l_r(LS:[]u8,n:i32)i32 {
  let s:i32=l_get(LS,sc(sRNG()));
  s=s*1103515245+12345;
  s=s-(s/65536)*65536;
  if(s<0){ s=s+65536; }
  l_put(LS,sc(sRNG()),s);
  if(n<1){ return 0; }
  return s-s/n*n;
}
fn l_zero(LS:[]u8)void {
  let i:i32=0;
  while(i<lsize()){ LS[i]=0; i=i+1; }
  l_put(LS,sc(sN()),31);
  l_put(LS,sc(sRNG()),7919);
  l_put(LS,sc(sCL()),-1);
  l_put(LS,sc(sSEP()),-1);
  l_put(LS,sc(sASG()),-1);
  l_put(LS,sc(sM()),0);
  return;
}
fn l_mem(LS:[]u8,base:i32,t:i32)i32 {
  let n:i32=l_get(LS,sc(base));
  let i:i32=0;
  while(i<n){
    if(l_get(LS,l_ol()+0)==0){ }
    i=i+1;
  }
  return 0;
}
// generic list helpers (base index into the scalar block, list storage)
fn lst_len(LS:[]u8,cntfield:i32)i32 { return l_get(LS,sc(cntfield)); }
fn lst_get(LS:[]u8,storage:i32,i:i32)i32 { return l_get(LS,storage+i*4); }
fn lst_has(LS:[]u8,cntfield:i32,storage:i32,t:i32)i32 {
  let i:i32=0;
  while(i<l_get(LS,sc(cntfield))){
    if(l_get(LS,storage+i*4)==t){ return 1; }
    i=i+1;
  }
  return 0;
}
fn lst_add(LS:[]u8,cntfield:i32,storage:i32,t:i32)void {
  if(lst_has(LS,cntfield,storage,t)==1){ return; }
  let n:i32=l_get(LS,sc(cntfield));
  if(n>=8){ return; }
  l_put(LS,storage+n*4,t);
  l_put(LS,sc(cntfield),n+1);
  return;
}
fn is_open(LS:[]u8,t:i32)i32 { return lst_has(LS,sNO(),l_ol(),t); }
fn is_atom(LS:[]u8,t:i32)i32 { return lst_has(LS,sNAT(),l_atl(),t); }
fn is_var(LS:[]u8,t:i32)i32  { return lst_has(LS,sNV(),l_vall(),t); }
fn is_bop(LS:[]u8,t:i32)i32  { return lst_has(LS,sNBOP(),l_bopl(),t); }
fn is_vop(LS:[]u8,t:i32)i32  { return lst_has(LS,sNVOP(),l_vopl(),t); }
fn is_term(LS:[]u8,t:i32)i32 { return lst_has(LS,sNTRM(),l_terml(),t); }
fn a_idx(LS:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<l_get(LS,sc(sNAT()))){
    if(l_get(LS,l_atl()+i*4)==t){ return i; }
    i=i+1;
  }
  return -1;
}
fn aft(LS:[]u8,a:i32,b:i32)i32 { return l_get(LS,l_xt()+(a*31+b)*4); }
fn afi(LS:[]u8,a:i32,b:i32)i32 { return l_get(LS,l_xf()+(a*31+b)*4); }
fn c0(LS:[]u8,t:i32)i32 { return l_get(LS,l_c0()+t); }
fn forb(LS:[]u8,a:i32,b:i32)i32 { return l_get(LS,l_f2()+(a*31+b)); }
fn d2(LS:[]u8,dc:i32,a:i32,b:i32)i32 { return l_get(LS,l_d2()+((dc*31+a)*31+b)*4); }

// depth class of a position, using the learned opener set and closer
fn dcls(LS:[]u8,d:i32)i32 {
  if(d<=0){ return 0; }
  if(d==1){ return 1; }
  return 2;
}

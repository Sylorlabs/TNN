// p6_corpus.zag -- supervision channel reader.
// Reads corpus.txt: one example per line, "<label><tok><tok>...", token t is
// the byte 65+t. Contains NO language knowledge and NO seed. The learner's
// entire view of the world is this file.

fn pl_get(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn pl_put(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn cs_stride()i32 { return 140; }
fn cs_n(CB:[]u8,i:i32)i32 { return pl_get(CB,i*cs_stride()); }
fn cs_lab(CB:[]u8,i:i32)i32 { return pl_get(CB,i*cs_stride()+4); }
fn cs_tok(CB:[]u8,i:i32,j:i32)i32 { return pl_get(CB,i*cs_stride()+8+j*4); }
fn cs_set(CB:[]u8,i:i32,n:i32,lab:i32,TK:[]u8)void {
  pl_put(CB,i*cs_stride(),n);
  pl_put(CB,i*cs_stride()+4,lab);
  let j:i32=0;
  while(j<n){ pl_put(CB,i*cs_stride()+8+j*4,pl_get(TK,j*4)); j=j+1; }
  return;
}
fn cs_dup(CB:[]u8,cn:i32,TK:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<cn){
    if(cs_n(CB,i)==n){
      let same:i32=1;
      let j:i32=0;
      while(j<n){
        if(cs_tok(CB,i,j)!=pl_get(TK,j*4)){ same=0; }
        j=j+1;
      }
      if(same==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn cs_dir()[]u8 { return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_formal_induce/"; }
fn cs_loadcorpus(CB:[]u8,PB:[]u8)i32 {
  let d:[]u8=cs_dir();
  let i:i32=0;
  let c:i32=0;
  while(i<d.len){ PB[c]=d[i]; c=c+1; i=i+1; }
  let s:[]u8="corpus.txt";
  i=0;
  while(i<s.len){ PB[c]=s[i]; c=c+1; i=i+1; }
  let ps:[]u8=PB[0..c];
  let f:[]u8=_zag_read_file(ps);
  if(f.len<1){ return 0; }
  let cn:i32=0;
  let p:i32=0;
  while(p<f.len){
    if(f[p]==10){ p=p+1; continue; }
    let lab:i32=f[p]-48;
    p=p+1;
    let st:i32=p;
    while(p<f.len && f[p]!=10){ p=p+1; }
    let n:i32=p-st;
    if(n<1 || n>32){ if(p<f.len){ p=p+1; } continue; }
    let q:i32=0;
    while(q<n){ pl_put(CB,cn*cs_stride()+8+q*4,f[st+q]-65); q=q+1; }
    pl_put(CB,cn*cs_stride(),n);
    pl_put(CB,cn*cs_stride()+4,lab);
    cn=cn+1;
  }
  return cn;
}

// p6_induce.zag -- induction procedures for p6_learner.zag.
// Concatenated immediately after p6_learner.zag; part of the learner TU.

// ---------- pass 1: raw statistics ----------
fn pl_stat(LS:[]u8,CB:[]u8,cn:i32)void {
  let e:i32=0;
  while(e<cn){
    let n:i32=cs_n(CB,e);
    let lab:i32=cs_lab(CB,e);
    if(n>=1 && n<=32){
      let j:i32=0;
      while(j<n){
        let t:i32=cs_tok(CB,e,j);
        if(lab==1){
          l_put(LS,l_c0()+t,l_get(LS,l_c0()+t)+1);
          if(j==n-1){ l_put(LS,l_lt()+t,l_get(LS,l_lt()+t)+1); }
          if(j==0){ l_put(LS,l_ft()+t,l_get(LS,l_ft()+t)+1); }
        }
        j=j+1;
      }
      j=0;
      while(j<n-1){
        let a:i32=cs_tok(CB,e,j);
        let b:i32=cs_tok(CB,e,j+1);
        if(lab==1){ l_put(LS,l_xt()+(a*31+b)*4,l_get(LS,l_xt()+(a*31+b)*4)+1); }
        else { l_put(LS,l_xf()+(a*31+b)*4,l_get(LS,l_xf()+(a*31+b)*4)+1); }
        j=j+1;
      }
    }
    e=e+1;
  }
  // forbidden bigrams: seen in INVALID, never in VALID
  let a:i32=0;
  while(a<31){
    let b:i32=0;
    while(b<31){
      if(afi(LS,a,b)>0 && aft(LS,a,b)==0){ l_put(LS,l_f2()+(a*31+b),1); }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

// ---------- pass 2: closing-token model selection ----------
fn pl_wellformed(LS:[]u8,CB:[]u8,cn:i32,c:i32)void {
  return;
}
fn pl_pickclose(LS:[]u8,CB:[]u8,cn:i32)void {
  let best:i32=-1;
  let bestsc:i32=-1;
  let c:i32=0;
  while(c<31){
    if(l_get(LS,l_lt()+c)>0){
      let sc:i32=0;
      let e:i32=0;
      while(e<cn){
        if(cs_lab(CB,e)==1){
          let n:i32=cs_n(CB,e);
          if(n>=1 && n<=32){
            let d:i32=0;
            let bad:i32=0;
            let j:i32=0;
            while(j<n){
              let t:i32=cs_tok(CB,e,j);
              if(aft(LS,t,c)>0){ d=d+1; }
              if(t==c){ d=d-1; }
              if(d<0){ bad=1; }
              j=j+1;
            }
            if(bad==0 && d==0){ sc=sc+1; }
          }
        }
        e=e+1;
      }
      if(sc>bestsc){ bestsc=sc; best=c; }
    }
    c=c+1;
  }
  l_put(LS,sc(sCL()),best);
  let a:i32=0;
  while(a<31){
    if(best>=0 && aft(LS,a,best)>0){ lst_add(LS,sNO(),l_ol(),a); }
    a=a+1;
  }
  l_put(LS,sc(sCFG()),bestsc);
  return;
}

// ---------- pass 3: separator ----------
fn pl_picksep(LS:[]u8,CB:[]u8,cn:i32)void {
  let best:i32=-1;
  let bestsc:i32=-1;
  let s:i32=0;
  while(s<31){
    if(s!=l_get(LS,sc(sCL())) && is_open(LS,s)==0){
      let sc:i32=0;
      let e:i32=0;
      while(e<cn){
        if(cs_lab(CB,e)==1){
          let n:i32=cs_n(CB,e);
          let j:i32=0;
          while(j<n){
            if(cs_tok(CB,e,j)==s){
              if(j==0){ sc=sc+2; }
              if(j+1<n){
                let nx:i32=cs_tok(CB,e,j+1);
                if(is_open(LS,nx)==1){ sc=sc+3; }
                if(nx==s){ sc=sc+1; }
              }
            }
            j=j+1;
          }
        }
        e=e+1;
      }
      if(sc>bestsc){ bestsc=sc; best=s; }
    }
    s=s+1;
  }
  l_put(LS,sc(sSEP()),best);
  return;
}

// ---------- pass 4: roles ----------
fn pl_prevok(LS:[]u8,t:i32) -> i32 {
  if(is_open(LS,t)==1){ return 1; }
  if(t==l_get(LS,sc(sCL()))){ return 1; }
  if(t==l_get(LS,sc(sSEP()))){ return 1; }
  return 0;
}
fn pl_roles(LS:[]u8,CB:[]u8,cn:i32)void {
  let sep:i32=l_get(LS,sc(sSEP()));
  let cl:i32=l_get(LS,sc(sCL()));
  // atoms: occurs at position 0 or right after the separator, and is never
  // immediately followed by an opener or the closer
  let t:i32=0;
  while(t<31){
    if(t!=sep && t!=cl && is_open(LS,t)==0 && l_get(LS,l_c0()+t)>0){
      let cand:i32=0;
      let e:i32=0;
      while(e<cn && cand==0){
        if(cs_lab(CB,e)==1){
          let n:i32=cs_n(CB,e);
          let j:i32=0;
          while(j<n){
            if(cs_tok(CB,e,j)==t){
              if(j==0 || cs_tok(CB,e,j-1)==sep){ cand=1; }
            }
            j=j+1;
          }
        }
        e=e+1;
      }
      if(cand==1){
        let nxtbad:i32=0;
        let e2:i32=0;
        while(e2<cn && nxtbad==0){
          let n:i32=cs_n(CB,e2);
          let j:i32=0;
          while(j<n-1){
            if(cs_tok(CB,e2,j)==t){
              let nx:i32=cs_tok(CB,e2,j+1);
              if(is_open(LS,nx)==1 || nx==cl){ nxtbad=1; }
            }
            j=j+1;
          }
          e2=e2+1;
        }
        if(nxtbad==0){ lst_add(LS,sNAT(),l_atl(),t); }
      }
    }
    t=t+1;
  }
  // drop mutually adjacent atoms (that signature is an operator, not an atom)
  let a:i32=0;
  while(a<l_get(LS,sc(sNAT()))){
    let b:i32=0;
    let drop:i32=0;
    while(b<l_get(LS,sc(sNAT()))){
      let ta:i32=l_get(LS,l_atl()+a*4);
      let tb:i32=l_get(LS,l_atl()+b*4);
      if(ta!=tb && aft(LS,ta,tb)>0 && aft(LS,tb,ta)>0){ drop=1; }
      b=b+1;
    }
    if(drop==1){
      let nx:i32=a+1;
      while(nx<l_get(LS,sc(sNAT()))){
        l_put(LS,l_atl()+a*4,l_get(LS,l_atl()+nx*4));
        nx=nx+1;
      }
      l_put(LS,sc(sNAT()),l_get(LS,sc(sNAT()))-1);
    } else { a=a+1; }
  }
  // variables: occur at position 0 or right after opener/closer/separator, and
  // the token that follows them leads into an atom
  t=0;
  while(t<31){
    if(t!=sep && t!=cl && is_open(LS,t)==0 && is_atom(LS,t)==0 && l_get(LS,l_c0()+t)>0){
      let cand:i32=0;
      let e:i32=0;
      while(e<cn && cand==0){
        if(cs_lab(CB,e)==1){
          let n:i32=cs_n(CB,e);
          let j:i32=1;
          while(j<n-1){
            if(cs_tok(CB,e,j)==t && pl_prevok(LS,cs_tok(CB,e,j-1))==1){
              let a2:i32=cs_tok(CB,e,j+1);
              if(aft(LS,a2,0)>=0){ }
              if(l_get(LS,l_xt()+(a2*31)*4)>=0){ }
              cand=1;
            }
            j=j+1;
          }
        }
        e=e+1;
      }
      if(cand==1){ lst_add(LS,sNV(),l_vall(),t); }
    }
    t=t+1;
  }
  // assign token: the unique successor of a variable token in valid examples
  if(l_get(LS,sc(sNV()))>0){
    let v:i32=l_get(LS,l_vall());
    let s:i32=0;
    let cnt:i32=0;
    let u:i32=0;
    while(u<31){
      if(aft(LS,v,u)>0){ s=u; cnt=cnt+1; }
      u=u+1;
    }
    if(cnt==1){ l_put(LS,sc(sASG()),s); }
  }
  // term-close (a token that ends a parenthesised operand): preceded by a
  // term-ish token, never followed by an atom
  t=0;
  while(t<31){
    if(t!=sep && t!=cl && is_open(LS,t)==0 && is_atom(LS,t)==0 && is_var(LS,t)==0 && l_get(LS,l_c0()+t)>0){
      let pre:i32=0;
      let foll:i32=0;
      let e:i32=0;
      while(e<cn){
        let n:i32=cs_n(CB,e);
        let j:i32=1;
        while(j<n){
          if(cs_tok(CB,e,j)==t){
            let pv:i32=cs_tok(CB,e,j-1);
            if(is_atom(LS,pv)==1 || is_var(LS,pv)==1){ pre=1; }
            if(j+1<n){
              let nx:i32=cs_tok(CB,e,j+1);
              if(is_atom(LS,nx)==1){ foll=1; }
              if(is_open(LS,nx)==1 || nx==cl){ foll=1; }
            }
          }
          j=j+1;
        }
        e=e+1;
      }
      if(pre==1 && foll==0){ lst_add(LS,sNTRM(),l_terml(),t); }
    }
    t=t+1;
  }
  // unary operators: preceded by a term, followed by a term, never at a
  // statement start, never followed by an opener or the closer
  t=0;
  while(t<31){
    if(t!=sep && t!=cl && is_open(LS,t)==0 && is_atom(LS,t)==0 && is_var(LS,t)==0 && l_get(LS,l_c0()+t)>0 && lst_has(LS,sNTRM(),l_terml(),t)==0){
      let pre:i32=0;
      let fol:i32=0;
      let e:i32=0;
      while(e<cn){
        let n:i32=cs_n(CB,e);
        let j:i32=1;
        while(j<n-1){
          if(cs_tok(CB,e,j)==t){
            let pv:i32=cs_tok(CB,e,j-1);
            if(is_atom(LS,pv)==1 || is_var(LS,pv)==1 || lst_has(LS,sNTRM(),l_terml(),pv)==1){ pre=1; }
            let nx:i32=cs_tok(CB,e,j+1);
            if(is_atom(LS,nx)==1 || is_var(LS,nx)==1){ fol=1; }
          }
          j=j+1;
        }
        e=e+1;
      }
      if(pre==1 && fol==1){ lst_add(LS,sNVOP(),l_vopl(),t); }
    }
    t=t+1;
  }
  // binary operators: preceded by a term, followed by a term or a unary op
  t=0;
  while(t<31){
    if(t!=sep && t!=cl && is_open(LS,t)==0 && is_atom(LS,t)==0 && is_var(LS,t)==0 && l_get(LS,l_c0()+t)>0 && lst_has(LS,sNTRM(),l_terml(),t)==0 && lst_has(LS,sNVOP(),l_vopl(),t)==0){
      let pre:i32=0;
      let fol:i32=0;
      let e:i32=0;
      while(e<cn){
        let n:i32=cs_n(CB,e);
        let j:i32=1;
        while(j<n-1){
          if(cs_tok(CB,e,j)==t){
            let pv:i32=cs_tok(CB,e,j-1);
            if(is_atom(LS,pv)==1 || is_var(LS,pv)==1 || lst_has(LS,sNTRM(),l_terml(),pv)==1){ pre=1; }
            let nx:i32=cs_tok(CB,e,j+1);
            if(is_atom(LS,nx)==1 || is_var(LS,nx)==1 || lst_has(LS,sNVOP(),l_vopl(),nx)==1){ fol=1; }
          }
          j=j+1;
        }
        e=e+1;
      }
      if(pre==1 && fol==1){ lst_add(LS,sNBOP(),l_bopl(),t); }
    }
    t=t+1;
  }
  // terms = atoms + variables + term-close
  let i:i32=0;
  while(i<l_get(LS,sc(sNAT()))){ lst_add(LS,sNTRM(),l_terml(),l_get(LS,l_atl()+i*4)); i=i+1; }
  i=0;
  while(i<l_get(LS,sc(sNV()))){ lst_add(LS,sNTRM(),l_terml(),l_get(LS,l_vall()+i*4)); i=i+1; }
  return;
}

// wallremove.zag -- CTSVR: change-triggered stale-wall verification.
// Prereg: a28ab9873. Design: 5daf15951. Extends goalrevise.zag
// (cb2a6fdbc) with gen/wgen state, T1 transfer-contradiction trigger,
// and the re-verify phase (BFS want==3, probe semantics).
// Sealed world (2 layouts) + learner + main unchanged otherwise.
// Information barrier: wall literals live ONLY inside w_iswall, called
// ONLY by w_step and measurement-only w_true_dist. The learner never
// reads the env flag or wall literals.
// Pure Zag. No Python.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ sealed world ============
// Grid 15x15. Actions: 0=N(y+1) 1=S(y-1) 2=E(x+1) 3=W(x-1) 4=WAIT.
// ws layout: +0 x, +4 y, +8 bump, +12 gx, +16 gy, +20 ncalls, +24 env.
// env 0 = pristine (Amend1); env 1 = changed (3 cells differ).
fn w_iswall(x:i32, y:i32, env:i32)i32 {
  // SEALED wall literals. Called only by w_step / w_true_dist.
  if(env==1){
    if(x==5 && y==11){return 0;}
    if(x==10 && y==3){return 0;}
    if(x==14 && y==7){return 1;}
  }
  if(x==5 && y==0){return 1;}
  if(x==5 && y==1){return 1;}
  if(x==5 && y==2){return 1;}
  if(x==5 && y==3){return 1;}
  if(x==5 && y==4){return 1;}
  if(x==5 && y==6){return 1;}
  if(x==5 && y==7){return 1;}
  if(x==5 && y==8){return 1;}
  if(x==5 && y==9){return 1;}
  if(x==5 && y==10){return 1;}
  if(x==5 && y==11){return 1;}
  if(x==10 && y==3){return 1;}
  if(x==10 && y==4){return 1;}
  if(x==10 && y==5){return 1;}
  if(x==10 && y==6){return 1;}
  if(x==10 && y==7){return 1;}
  if(x==10 && y==9){return 1;}
  if(x==10 && y==10){return 1;}
  if(x==10 && y==11){return 1;}
  if(x==10 && y==12){return 1;}
  return 0;
}
fn w_set_env(ws:[]u8, e:i32)void { set32(ws,24,e); return; }
fn w_reset(ws:[]u8, gx:i32, gy:i32)void {
  set32(ws,0,0); set32(ws,4,0); set32(ws,8,0);
  set32(ws,12,gx); set32(ws,16,gy); set32(ws,20,0);
  return;
}
fn w_step(ws:[]u8, a:i32)void {
  set32(ws,20,get32(ws,20)+1);
  let x:i32=get32(ws,0); let y:i32=get32(ws,4);
  let env:i32=get32(ws,24);
  if(a==4){ set32(ws,8,0); return; }
  let nx:i32=x; let ny:i32=y;
  if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
  if(nx<0 || nx>=15 || ny<0 || ny>=15 || w_iswall(nx,ny,env)==1){
    set32(ws,8,1); return;
  }
  set32(ws,0,nx); set32(ws,4,ny); set32(ws,8,0);
  return;
}
fn w_x(ws:[]u8)i32 { return get32(ws,0); }
fn w_y(ws:[]u8)i32 { return get32(ws,4); }
fn w_bump(ws:[]u8)i32 { return get32(ws,8); }
fn w_goal(ws:[]u8)i32 {
  if(get32(ws,0)==get32(ws,12) && get32(ws,4)==get32(ws,16)){return 1;}
  return 0;
}

// ============ BFS planner (generic; operates on learner map) ============
// want==3 (CTSVR re-verify): target nearest stale cell
// (map==2 && wgen<gen); stale cells are traversable.
fn bfs(sx:i32, sy:i32, tx:i32, ty:i32, want:i32, map:[]u8, swept:[]u8,
       qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8,
       wgen:[]u8, gen:i32)i32 {
  let sidx:i32=sy*15+sx;
  let i:i32=0;
  while(i<225){ vis[i]=0; par[i]=255; i=i+1; }
  let qh:i32=0; let qt:i32=0;
  set32(qx,0,sx); set32(qy,0,sy); qt=1;
  vis[sidx]=1; par[sidx]=sidx as u8;
  let found:i32=-1;
  while(qh<qt){
    let cx:i32=get32(qx,qh*4); let cy:i32=get32(qy,qh*4); qh=qh+1;
    let cidx:i32=cy*15+cx;
    if(want==0 && cx==tx && cy==ty){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    if(want==1 && cidx!=sidx && (map[cidx] as i32)==0){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    if(want==2 && cidx!=sidx && swept[cidx]==0 && (map[cidx] as i32)!=2){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    if(want==3 && cidx!=sidx && (map[cidx] as i32)==2 && (wgen[cidx] as i32)<gen){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    let a:i32=0;
    while(a<4){
      let nx:i32=cx; let ny:i32=cy;
      if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
      if(nx>=0 && nx<15 && ny>=0 && ny<15){
        let nidx:i32=ny*15+nx;
        let m:i32=(map[nidx] as i32);
        let pass:i32=0;
        if(m!=2){ pass=1; } else if(want==3 && (wgen[nidx] as i32)<gen){ pass=1; }
        if(pass==1 && vis[nidx]==0){
          vis[nidx]=1; par[nidx]=cidx as u8; pact[nidx]=a as u8;
          set32(qx,qt*4,nx); set32(qy,qt*4,ny); qt=qt+1;
        }
      }
      a=a+1;
    }
  }
  if(found<0){ return -1; }
  let len:i32=0;
  let cur:i32=found;
  while(cur!=sidx){
    path[len]=pact[cur];
    len=len+1;
    cur=par[cur] as i32;
  }
  let lo:i32=0; let hi:i32=len-1;
  while(lo<hi){
    let t:u8=path[lo]; path[lo]=path[hi]; path[hi]=t;
    lo=lo+1; hi=hi-1;
  }
  return len;
}

// ============ measurement only: true BFS distance ============
fn w_true_dist(ws:[]u8, x:i32, y:i32)i32 {
  let env:i32=get32(ws,24);
  let tm:[]u8=z_alloc(225);
  let cy:i32=0;
  while(cy<15){
    let cx:i32=0;
    while(cx<15){
      if(w_iswall(cx,cy,env)==1){ tm[cy*15+cx]=2; } else { tm[cy*15+cx]=1; }
      cx=cx+1;
    }
    cy=cy+1;
  }
  let qx:[]u8=z_alloc(900); let qy:[]u8=z_alloc(900);
  let vis:[]u8=z_alloc(225); let par:[]u8=z_alloc(225); let pact:[]u8=z_alloc(225);
  let path:[]u8=z_alloc(225); let outxy:[]u8=z_alloc(8); let sw:[]u8=z_alloc(225);
  let zw:[]u8=z_alloc(225);
  let gx:i32=get32(ws,12); let gy:i32=get32(ws,16);
  let len:i32=bfs(x,y,gx,gy,0,tm,sw,qx,qy,vis,par,pact,path,outxy,zw,0);
  return len;
}

// ============ learner: Env A (explore) ============
fn l_env_a(ws:[]u8, map:[]u8, wgen:[]u8, swept:[]u8,
           qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8)i32 {
  let i:i32=0;
  while(i<225){ map[i]=0; i=i+1; }
  map[0]=1;
  let x:i32=0; let y:i32=0;
  let actions:i32=0; let bumps:i32=0; let replans:i32=0;
  let freec:i32=1; let wallc:i32=0;
  let pc:i32=0;
  emit("ENV A BEGIN\n");
  while(actions<5000){
    if(w_goal(ws)==1){
      emit("GOAL_REACHED A actions="); e64(actions);
      emit(" bumps="); e64(bumps);
      emit(" replans="); e64(replans);
      emit(" freec="); e64(freec);
      emit(" wallc="); e64(wallc); emit("\n");
      break;
    }
    let plen:i32=bfs(x,y,0,0,1,map,swept,qx,qy,vis,par,pact,path,outxy,wgen,0);
    if(plen<0){
      emit("FAIL A: fully mapped, goal not found\n");
      break;
    }
    let tx:i32=get32(outxy,0); let ty:i32=get32(outxy,4);
    emit("PLAN A target="); e64(tx); emit(","); e64(ty);
    emit(" plen="); e64(plen); emit("\n");
    let pi:i32=0;
    while(pi<plen){
      let a:i32=path[pi] as i32;
      w_step(ws,a);
      actions=actions+1;
      x=w_x(ws); y=w_y(ws);
      let b:i32=w_bump(ws); let g:i32=w_goal(ws);
      emit("A "); e64(actions); emit(" a="); e64(a);
      emit(" x="); e64(x); emit(" y="); e64(y);
      emit(" b="); e64(b); emit(" g="); e64(g); emit("\n");
      if(b==1){
        bumps=bumps+1;
        let nx:i32=x; let ny:i32=y;
        if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
        if(nx>=0 && nx<15 && ny>=0 && ny<15){
          if((map[ny*15+nx] as i32)!=2){ map[ny*15+nx]=2; wallc=wallc+1; wgen[ny*15+nx]=0; }
          emit("FAIL A bump at "); e64(nx); emit(","); e64(ny); emit("\n");
          emit("REVISE A wall learned "); e64(nx); emit(","); e64(ny);
          emit(" wallc="); e64(wallc); emit("\n");
        } else {
          emit("FAIL A bump offgrid\n");
        }
        replans=replans+1;
        break;
      }
      let cidx:i32=y*15+x;
      if((map[cidx] as i32)==0){ map[cidx]=1; freec=freec+1; }
      if(g==1){ break; }
      pc=pc+1;
      if(pc>=25){
        pc=0;
        emit("PROGRESS A t="); e64(actions);
        emit(" dist="); e64(w_true_dist(ws,x,y)); emit("\n");
      }
      pi=pi+1;
    }
  }
  return actions;
}

// ============ learner: transfer sweep (shared by Env B and Env C) ============
// CTSVR: wgen/gen state, T1 transfer-contradiction trigger, re-verify phase.
// tag: 0 = B labels, 1 = C labels. transferred: 1 when the map is carried
// over from a previous environment (B and C), 0 when built fresh.
// bumpcell counts steps onto the two removed-wall cells (5,11) and (10,3)
// for the asymmetry check.
fn l_env_bc(ws:[]u8, map:[]u8, wgen:[]u8, swept:[]u8,
            qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8,
            tag:i32, transferred:i32)i32 {
  let i:i32=0;
  while(i<225){ swept[i]=0; i=i+1; }
  swept[0]=1;
  let x:i32=0; let y:i32=0;
  let actions:i32=0; let bumps:i32=0; let newfree:i32=0; let newwall:i32=0;
  let on511:i32=0; let on103:i32=0;
  let firstbump_at:i32=-1;
  let gen:i32=0; let probes:i32=0; let rv_actions:i32=0;
  let pc:i32=0;
  if(tag==0){ emit("ENV B BEGIN\n"); } else { emit("ENV C BEGIN\n"); }
  while(actions<5000){
    if(w_goal(ws)==1){
      if(tag==0){ emit("GOAL_REACHED B actions="); } else { emit("GOAL_REACHED C actions="); }
      e64(actions);
      emit(" bumps="); e64(bumps);
      emit(" newfree="); e64(newfree);
      emit(" newwall="); e64(newwall);
      emit(" on511="); e64(on511);
      emit(" on103="); e64(on103);
      emit(" firstbump_at="); e64(firstbump_at);
      emit(" probes="); e64(probes);
      emit(" rv_actions="); e64(rv_actions);
      emit(" gen="); e64(gen); emit("\n");
      break;
    }
    // CTSVR re-verify phase: run while any stale wall exists.
    if(transferred==1){
      let si:i32=0; let stale:i32=0;
      while(si<225){
        if((map[si] as i32)==2 && (wgen[si] as i32)<gen){ stale=1; break; }
        si=si+1;
      }
      if(stale==1){
        let rplen:i32=bfs(x,y,0,0,3,map,swept,qx,qy,vis,par,pact,path,outxy,wgen,gen);
        if(rplen<0){
          si=0;
          while(si<225){
            if((map[si] as i32)==2 && (wgen[si] as i32)<gen){
              wgen[si]=gen as u8;
              if(tag==0){ emit("REVISE B stale unreachable "); } else { emit("REVISE C stale unreachable "); }
              e64(si%15); emit(","); e64(si/15); emit(" (kept wall)\n");
            }
            si=si+1;
          }
        } else {
          let rtx:i32=get32(outxy,0); let rty:i32=get32(outxy,4);
          if(tag==0){ emit("PLAN B reverify target="); } else { emit("PLAN C reverify target="); }
          e64(rtx); emit(","); e64(rty);
          emit(" plen="); e64(rplen); emit("\n");
          let rpi:i32=0; let rdone:i32=0;
          while(rpi<rplen && rdone==0){
            let a:i32=path[rpi] as i32;
            let px:i32=x; let py:i32=y;
            if(a==0){py=py+1;} else if(a==1){py=py-1;} else if(a==2){px=px+1;} else {px=px-1;}
            let nidx:i32=py*15+px;
            let isprobe:i32=0;
            if((map[nidx] as i32)==2 && (wgen[nidx] as i32)<gen){ isprobe=1; }
            if(isprobe==1){
              if(tag==0){ emit("PROBE B "); } else { emit("PROBE C "); }
              e64(px); emit(","); e64(py); emit(" gen="); e64(gen); emit("\n");
              probes=probes+1;
            }
            w_step(ws,a);
            actions=actions+1; rv_actions=rv_actions+1;
            x=w_x(ws); y=w_y(ws);
            let b:i32=w_bump(ws); let g:i32=w_goal(ws);
            swept[y*15+x]=1;
            if(x==5 && y==11){ on511=on511+1; }
            if(x==10 && y==3){ on103=on103+1; }
            if(tag==0){ emit("B "); } else { emit("C "); }
            e64(actions); emit(" a="); e64(a);
            emit(" x="); e64(x); emit(" y="); e64(y);
            emit(" b="); e64(b); emit(" g="); e64(g); emit("\n");
            if(isprobe==1){
              if(b==0){
                map[nidx]=1; wgen[nidx]=gen as u8;
                if(tag==0){ emit("REVISE B wall removed "); } else { emit("REVISE C wall removed "); }
                e64(px); emit(","); e64(py); emit("\n");
              } else {
                wgen[nidx]=gen as u8;
                if(tag==0){ emit("REVISE B wall confirmed "); } else { emit("REVISE C wall confirmed "); }
                e64(px); emit(","); e64(py); emit("\n");
                rdone=1;
              }
            } else if(b==1){
              if((map[nidx] as i32)!=2){ map[nidx]=2; newwall=newwall+1; }
              wgen[nidx]=gen as u8;
              if(tag==0){ emit("REVISE B wall learned "); } else { emit("REVISE C wall learned "); }
              e64(px); emit(","); e64(py); emit(" (reverify discovery)\n");
              rdone=1;
            } else {
              let cidx:i32=y*15+x;
              if((map[cidx] as i32)==0){ map[cidx]=1; newfree=newfree+1; }
            }
            if(g==1){ rdone=2; }
            pc=pc+1;
            if(pc>=25){
              pc=0;
              if(tag==0){ emit("PROGRESS B t="); } else { emit("PROGRESS C t="); }
              e64(actions);
              emit(" dist="); e64(w_true_dist(ws,x,y)); emit("\n");
            }
            rpi=rpi+1;
          }
        }
        continue;
      }
    }
    let plen:i32=bfs(x,y,0,0,2,map,swept,qx,qy,vis,par,pact,path,outxy,wgen,gen);
    if(plen<0){
      if(tag==0){ emit("FAIL B: sweep complete, goal not found\n"); }
      else { emit("FAIL C: sweep complete, goal not found\n"); }
      break;
    }
    if(plen==0){ swept[y*15+x]=1; continue; }
    let tx:i32=get32(outxy,0); let ty:i32=get32(outxy,4);
    if(tag==0){ emit("PLAN B sweep target="); } else { emit("PLAN C sweep target="); }
    e64(tx); emit(","); e64(ty);
    emit(" plen="); e64(plen); emit("\n");
    let pi:i32=0;
    while(pi<plen){
      let a:i32=path[pi] as i32;
      w_step(ws,a);
      actions=actions+1;
      x=w_x(ws); y=w_y(ws);
      let b:i32=w_bump(ws); let g:i32=w_goal(ws);
      swept[y*15+x]=1;
      if(x==5 && y==11){ on511=on511+1; }
      if(x==10 && y==3){ on103=on103+1; }
      if(tag==0){ emit("B "); } else { emit("C "); }
      e64(actions); emit(" a="); e64(a);
      emit(" x="); e64(x); emit(" y="); e64(y);
      emit(" b="); e64(b); emit(" g="); e64(g); emit("\n");
      if(b==1){
        bumps=bumps+1;
        if(firstbump_at<0){ firstbump_at=actions; }
        let nx:i32=x; let ny:i32=y;
        if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
        if(nx>=0 && nx<15 && ny>=0 && ny<15){
          if((map[ny*15+nx] as i32)!=2){ map[ny*15+nx]=2; newwall=newwall+1; }
          if(transferred==1){
            gen=gen+1;
            if(tag==0){ emit("REVISE B env-change suspected gen="); } else { emit("REVISE C env-change suspected gen="); }
            e64(gen); emit("\n");
          }
          wgen[ny*15+nx]=gen as u8;
          if(tag==0){ emit("FAIL B bump at "); } else { emit("FAIL C bump at "); }
          e64(nx); emit(","); e64(ny); emit("\n");
          if(tag==0){ emit("REVISE B wall learned "); } else { emit("REVISE C wall learned "); }
          e64(nx); emit(","); e64(ny); emit("\n");
        } else {
          if(tag==0){ emit("FAIL B bump offgrid\n"); } else { emit("FAIL C bump offgrid\n"); }
        }
        break;
      }
      let cidx:i32=y*15+x;
      if((map[cidx] as i32)==0){ map[cidx]=1; newfree=newfree+1; }
      if(g==1){ break; }
      pc=pc+1;
      if(pc>=25){
        pc=0;
        if(tag==0){ emit("PROGRESS B t="); } else { emit("PROGRESS C t="); }
        e64(actions);
        emit(" dist="); e64(w_true_dist(ws,x,y)); emit("\n");
      }
      pi=pi+1;
    }
  }
  return actions;
}

// ============ main ============
fn main()void {
  emit("WALLREMOVE\n");
  let ws:[]u8=z_alloc(28);
  let map:[]u8=z_alloc(225);
  let mapA:[]u8=z_alloc(225);
  let wgen:[]u8=z_alloc(225);
  let wgenA:[]u8=z_alloc(225);
  let swept:[]u8=z_alloc(225);
  let qx:[]u8=z_alloc(900); let qy:[]u8=z_alloc(900);
  let vis:[]u8=z_alloc(225); let par:[]u8=z_alloc(225); let pact:[]u8=z_alloc(225);
  let path:[]u8=z_alloc(225); let outxy:[]u8=z_alloc(8);
  // Env A: pristine world, goal (14,14). Fresh map (transferred=0).
  w_set_env(ws,0);
  w_reset(ws,14,14);
  emit("TRUE_DIST_A0 "); e64(w_true_dist(ws,0,0)); emit("\n");
  let aA:i32=l_env_a(ws,map,wgen,swept,qx,qy,vis,par,pact,path,outxy);
  // Save post-A map and wgen.
  let i:i32=0;
  while(i<225){ mapA[i]=map[i]; wgenA[i]=wgen[i]; i=i+1; }
  // Env B: pristine transfer control, goal (14,0). transferred=1.
  w_set_env(ws,0);
  w_reset(ws,14,0);
  emit("TRUE_DIST_B0 "); e64(w_true_dist(ws,0,0)); emit("\n");
  let aB:i32=l_env_bc(ws,map,wgen,swept,qx,qy,vis,par,pact,path,outxy,0,1);
  // Restore post-A map and wgen; switch to changed world.
  i=0;
  while(i<225){ map[i]=mapA[i]; wgen[i]=wgenA[i]; i=i+1; }
  w_set_env(ws,1);
  w_reset(ws,14,0);
  let dc:i32=w_true_dist(ws,0,0);
  emit("TRUE_DIST_C0 "); e64(dc); emit("\n");
  let aC:i32=0;
  if(dc<0){
    emit("FAIL C: goal unreachable in changed layout\n");
  } else {
    aC=l_env_bc(ws,map,wgen,swept,qx,qy,vis,par,pact,path,outxy,1,1);
  }
  // Post-run learner map dump at the three changed cells (K2).
  emit("MAPDUMP c147="); e64(map[7*15+14] as i32);
  emit(" c511="); e64(map[11*15+5] as i32);
  emit(" c103="); e64(map[3*15+10] as i32); emit("\n");
  emit("SUMMARY A="); e64(aA); emit(" B="); e64(aB); emit(" C="); e64(aC); emit("\n");
  emit("DONE\n");
  return;
}

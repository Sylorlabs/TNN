// xio_driver.zag -- H-XIO-1 world, arms, census, main (unfrozen).
// World replicates the C215 xdomain pair (chain-then-count) plus two
// reuse/generalization probes. Arms: TREAT, ABL-XIO (adapters off),
// ABL-X, ABL-Y, FRESH.

fn xio_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn xio_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, structural class.
fn xio_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(o==1){emit("count");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn xio_census(W:[]u8)void {
  emit("maps="); e64(xio_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){xio_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, typed signature, relations, answer.
fn xio_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn xio_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn xio_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xio_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1 ans="); e64(x1); xio_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2 ans="); e64(x2); xio_tstat(W);
  return;
}
fn xio_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1 ans="); e64(y1); xio_tstat(W);
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2 ans="); e64(y2); xio_tstat(W);
  return;
}
// Z facts for chain base b: (b,81,b+1),(b+1,81,b+2),(b+2,81,b+3),
// then (b+3,82,b+4),(b+4,82,b+5). Chain-then-count query (b,qr)->2.
fn xio_zfacts(W:[]u8,b:i32)void {
  ev_teach(W,b,81,b+1); ev_teach(W,b+1,81,b+2); ev_teach(W,b+2,81,b+3);
  ev_teach(W,b+3,82,b+4); ev_teach(W,b+4,82,b+5);
  return;
}
fn xio_zq(W:[]u8,tag:[]u8,b:i32,qr:i32,xon:i32)void {
  let z:i32=xio_query(W,b,qr,2,0,xon);
  emit(tag); emit(" ans="); e64(z); xio_tstat(W);
  xio_acensus(W);
  return;
}
fn xio_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  xio_trainX(W,1);
  xio_trainY(W,1);
  xio_gap(W);
  xio_census(W);
  xio_zfacts(W,31); xio_zq(W,"Z1",31,93,1);
  xio_zfacts(W,41); xio_zq(W,"Z2a",41,93,1);
  xio_zfacts(W,71); xio_zq(W,"Z2b",71,94,1);
  return;
}
fn xio_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  xio_trainX(W,0);
  xio_trainY(W,0);
  xio_gap(W);
  xio_census(W);
  xio_zfacts(W,31); xio_zq(W,"Z1",31,93,0);
  xio_zfacts(W,41); xio_zq(W,"Z2a",41,93,0);
  xio_zfacts(W,71); xio_zq(W,"Z2b",71,94,0);
  return;
}
fn xio_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  xio_trainX(W,1);
  xio_trainY(W,1);
  xio_del_map_r(W,91);
  emit("maps after del="); e64(xio_count_maps(W)); emit("\n");
  xio_gap(W);
  xio_zfacts(W,31); xio_zq(W,"Z1",31,93,1);
  xio_zfacts(W,41); xio_zq(W,"Z2a",41,93,1);
  xio_zfacts(W,71); xio_zq(W,"Z2b",71,94,1);
  return;
}
fn xio_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  xio_trainX(W,1);
  xio_trainY(W,1);
  xio_del_map_r(W,92);
  emit("maps after del="); e64(xio_count_maps(W)); emit("\n");
  xio_gap(W);
  xio_zfacts(W,31); xio_zq(W,"Z1",31,93,1);
  xio_zfacts(W,41); xio_zq(W,"Z2a",41,93,1);
  xio_zfacts(W,71); xio_zq(W,"Z2b",71,94,1);
  return;
}
fn xio_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  xio_gap(W);
  xio_zfacts(W,31); xio_zq(W,"Z1",31,93,1);
  xio_zfacts(W,41); xio_zq(W,"Z2a",41,93,1);
  xio_zfacts(W,71); xio_zq(W,"Z2b",71,94,1);
  return;
}
// ev_query: cx_core.zag's internal test battery references this symbol.
// Provided here as the adapter pipeline (adapters enabled). The battery
// is never invoked by this driver; the entry point is xio_query.
// (cx_patch.zag, which also defines ev_query, is deliberately NOT
// included: this experiment tests the adapter mechanism, not A.)
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("XIO-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); xio_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); xio_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); xio_arm_ablx(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); xio_arm_ably(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); xio_arm_fresh(W5);
  emit("XIO-END\n");
  return 0;
}

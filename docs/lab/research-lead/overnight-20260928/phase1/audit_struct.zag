// PHASE 1 STRUCTURAL AUDIT (Zag port of phase1/audit_v3.py)
//
// This gates the lane's most load-bearing mechanical claim:
//
//   "across 1,025 audited sources, 0 of 137 structural writers read learner state"
//
// so it must be re-derivable in pure Zag. The method is unchanged and is the part
// that mattered: for a structural lever to count, ALL THREE must hold --
//   1. the writing function has a learner-state ARRAY parameter (X:[]u8, not X:i32)
//   2. that array is self-accumulating
//   3. the structural sink reads it
// The first two Python versions (audit_structure.py, audit_scope.py) violated this
// and reported 94 and 137 false levers respectively; those failures are why the
// type-awareness exists and they are documented in phase1/REPORT.md.
//
// usage: audit_struct.zag <file-list>      (a `git ls-files` dump)
//
// Method note: this is a static scope heuristic, not a compiler. It cannot see a
// structural change made through a pointer alias or a shared global. That limit is
// stated in phase1/REPORT.md and is not narrowed here.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn MAXLEN()i32 { return 400000; }

fn isWord(c:i32)i32 {
  if(c>='a' && c<='z'){ return 1; }
  if(c>='A' && c<='Z'){ return 1; }
  if(c>='0' && c<='9'){ return 1; }
  if(c=='_'){ return 1; }
  return 0;
}

// buf[from..] starts with s?
fn eqStr(buf:[]u8,from:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){
    if(from+i>=buf.len){ return 0; }
    if(buf[from+i]!=s[i]){ return 0; }
    i=i+1;
  }
  return 1;
}

// is position `from` the start of a word (previous char is not a word char)?
// `lo` bounds the search so we do not wrap into the previous line.
fn wordStart(buf:[]u8,from:i32,lo:i32)i32 {
  if(from<=lo){ return 1; }
  let pv:i32=buf[from-1];
  if(isWord(pv)==0){ return 1; }
  return 0;
}

// does buf[a..b) contain the literal `pat`?
fn has(buf:[]u8,a:i32,b:i32,pat:[]u8)i32 {
  let pl:i32=pat.len;
  if(pl>b-a){ return 0; }
  let i:i32=a;
  while(i+pl<=b){
    let hit:i32=1;
    let j:i32=0;
    while(j<pl){ if(buf[i+j]!=pat[j]){ hit=0; } j=j+1; }
    if(hit==1){ return 1; }
    i=i+1;
  }
  return 0;
}

// STATE_NAMES: L S sup acc mem hist state st  (exact, whole-word)
fn isStateName(n:[]u8)i32 {
  if(n.len==1){
    let c:i32=n[0];
    if(c=='L'){ return 1; }
    if(c=='S'){ return 1; }
    return 0;
  }
  if(eqStr(n,0,"sup")==1){ return 1; }
  if(eqStr(n,0,"acc")==1){ return 1; }
  if(eqStr(n,0,"mem")==1){ return 1; }
  if(eqStr(n,0,"hist")==1){ return 1; }
  if(eqStr(n,0,"state")==1){ return 1; }
  if(eqStr(n,0,"st")==1){ return 1; }
  return 0;
}

// self-accumulating check. We do NOT build the exact regex; instead we test the
// two syntactic shapes that matter, scanning for occurrences of the name inside a
// set32(...get32( pair or a NAME[..]=NAME[..] pair.
fn isAccumulating(buf:[]u8,lo:i32,hi:i32,nm:[]u8)i32 {
  let nl:i32=nm.len;
  // shape A: set32(NAME,  ... get32(NAME,
  let i:i32=lo;
  while(i+nl+12<hi){
    if(eqStr(buf,i,"set32(")==1){
      // name must follow '('
      if(eqStr(buf,i+5,nm)==1){
        // look ahead for get32(NAME within this line
        let j:i32=i+5+nl;
        let lim:i32=hi;
        if(j+nl+9<lim){
          if(eqStr(buf,j,",")==1){
            let k:i32=j;
            while(k<lim){
              if(eqStr(buf,k,"get32(")==1){
                if(eqStr(buf,k+5,nm)==1){ return 1; }
              }
              k=k+1;
            }
          }
        }
      }
    }
    i=i+1;
  }
  // shape B: NAME[..] = NAME[..]
  i=lo;
  while(i+nl*2+6<hi){
    if(eqStr(buf,i,nm)==1){
      if(wordStart(buf,i,lo)==1){
        if(eqStr(buf,i+nl,"[")==1){
          let k:i32=i+nl+1;
          while(k<hi && buf[k]!=']'){ k=k+1; }
          if(k<hi){
            k=k+1;
            while(k<hi && buf[k]==' '){ k=k+1; }
            if(k<hi && buf[k]=='='){
              let m:i32=k+1;
              while(m<hi && buf[m]==' '){ m=m+1; }
              if(eqStr(buf,m,nm)==1){ return 1; }
            }
          }
        }
      }
    }
    i=i+1;
  }
  return 0;
}

// Is this a structural sink line? newnode( / reset_graph( / set32(W|store|gr|graph|G
// / nset(W|store
fn isStructLine(buf:[]u8,a:i32,b:i32)i32 {
  if(has(buf,a,b,"newnode(")==1){ return 1; }
  if(has(buf,a,b,"reset_graph(")==1){ return 1; }
  if(has(buf,a,b,"set32(W")==1){ return 1; }
  if(has(buf,a,b,"set32(store")==1){ return 1; }
  if(has(buf,a,b,"set32(gr")==1){ return 1; }
  if(has(buf,a,b,"set32(graph")==1){ return 1; }
  if(has(buf,a,b,"set32(G")==1){ return 1; }
  if(has(buf,a,b,"nset(W")==1){ return 1; }
  if(has(buf,a,b,"nset(store")==1){ return 1; }
  return 0;
}

// scan a parameter list for NAME : []u8  where NAME is a learner-state name.
// Returns 1 and stores the name extent into out[0]=start, out[4]=len.
fn findStateParam(buf:[]u8,a:i32,b:i32,out:[]u8)i32 {
  let i:i32=a;
  while(i<b){
    if(isWord(buf[i])==1){
      let st:i32=i;
      while(i<b && isWord(buf[i])==1){ i=i+1; }
      let nl:i32=i-st;
      // must be followed by optional spaces, ':' then optional spaces then '[]u8'
      let j:i32=i;
      while(j<b && buf[j]==' '){ j=j+1; }
      if(j<b && buf[j]==':'){
        j=j+1;
        while(j<b && buf[j]==' '){ j=j+1; }
        if(j+4<=b){
          if(eqStr(buf,j,"[]u8")==1){
            let nm:[]u8=buf[st..i];
            if(isStateName(nm)==1){
              set32(out,0,st);
              set32(out,4,nl);
              return 1;
            }
          }
        }
      }
    } else {
      i=i+1;
    }
  }
  return 0;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: audit_struct <git-ls-files-dump>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let lp:[]u8=_zag_arg(1);
  let L:[]u8="";
  if(_zag_file_exists(lp)==1){ L=_zag_read_file(lp); }
  let ln:i32=L.len;
  if(ln<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read file list"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  let nzag:i32=0;
  let nwithMain:i32=0;
  let nwriters:i32=0;
  let nlevers:i32=0;
  let nfilesWriter:i32=0;
  let nfilesLever:i32=0;

  let li:i32=0;
  while(li<ln){
    let nl:i32=li;
    while(nl<ln){ if(L[nl]==10){ break; } nl=nl+1; }
    let path:[]u8=L[li..nl];
    li=nl+1;
    if(path.len>4){
      if(path[path.len-4]=='.' && path[path.len-3]=='z' && path[path.len-2]=='a' && path[path.len-1]=='g'){
        nzag=nzag+1;
        if(_zag_file_exists(path)==1){
          let F:[]u8=_zag_read_file(path);
          let fn2:i32=F.len;
          if(fn2>0){
            if(has(F,0,fn2,"fn main")==1){
              nwithMain=nwithMain+1;
              // ---- split into functions on 'fn ' at line start ----
              let fs:i32=0;
              let k:i32=0;
              while(k+3<fn2){
                if(F[k]=='f' && F[k+1]=='n' && F[k+2]==' ' && wordStart(F,k,0)==1){
                  let fe:i32=k+3;
                  while(fe<fn2 && F[fe]!=10){ fe=fe+1; }
                  let bodyEnd:i32=fn2;
                  // body ends at the next 'fn ' at line start
                  let j:i32=fe;
                  while(j<fn2){
                    if(F[j]=='f' && j+2<fn2 && F[j+1]=='n' && F[j+2]==' ' && wordStart(F,j,0)==1){ bodyEnd=j; break; }
                    j=j+1;
                  }
                  // param list between the parens
                  let pa:i32=k+2;
                  while(pa<bodyEnd && F[pa]!='('){ pa=pa+1; }
                  let pb:i32=pa+1;
                  let d:i32=1;
                  while(pb<bodyEnd && d>0){
                    if(F[pb]=='('){ d=d+1; }
                    if(F[pb]==')'){ d=d-1; }
                    pb=pb+1;
                  }
                  pb=pb-1;
                  // structural sink in the body?
                  if(isStructLine(F,fe,bodyEnd)==1){
                    nwriters=nwriters+1;
                    let out:[]u8=z_alloc(8);
                    if(findStateParam(F,pa+1,pb,out)==1){
                      let nmS:i32=get32(out,0);
                      let nmL:i32=get32(out,4);
                      let nm:[]u8=F[nmS..(nmS+nmL)];
                      if(isAccumulating(F,0,fn2,nm)==1){
                        // condition 3: the sink region reads the name
                        if(has(F,fe,bodyEnd,nm)==1){
                          nlevers=nlevers+1;
                        }
                      }
                    }
                  }
                  fs=fs+1;
                }
                k=k+1;
              }
              if(nwriters>0){ nfilesWriter=nfilesWriter+1; }
            }
          }
        }
      }
    }
    if(li>ln){ break; }
  }

  c=o_app(ob,c,"PHASE 1 STRUCTURAL AUDIT (Zag port, type-aware)"); c=o_nl(ob,c);
  c=o_app(ob,c,"===================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,".zag sources listed          : "); c=o_i64(ob,c,nzag as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"sources containing fn main  : "); c=o_i64(ob,c,nwithMain as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"structural writers found    : "); c=o_i64(ob,c,nwriters as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"GENUINE structural levers   : "); c=o_i64(ob,c,nlevers as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"===================================================="); c=o_nl(ob,c);
  if(nlevers==0){
    c=o_app(ob,c,"RESULT: 0 structural writers read learner state."); c=o_nl(ob,c);
    c=o_app(ob,c,"Bound reproduced: learner state selects among researcher-created");
    c=o_app(ob,c,"candidate spaces but does not alter those spaces."); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 0;
  }
  c=o_app(ob,c,"RESULT: structural levers present -- investigate before claiming the bound.");
  c=o_nl(ob,c);
  _zag_print(ob[0..c]);
  return 1;
}
// x3_driver.zag -- H-XIO-3 third-pair world, arms, census, pair audit.
// Unfrozen. The ONLY new source this wave. The adapter mechanism is
// reused verbatim from ../xio_adapters/xio_core.zag (see assembly
// recipe in NAMECHECK.md); nothing in it was copied or edited.
//
// Third pair: sequence-then-aggregate.
// X = CHAIN/sequence (node -> node, oty 0): r=81 facts, query r=91.
// Y = SUM/aggregate (direct facts -> number, oty 1, unrolled INC cells,
// no guards): r=82 facts, query r=92.
// Z = SUM(CHAIN(s)): query (41,93) -> 10. Requires CHAIN(41)=44,
// then SUM(44)=10.
// Arms: TREAT, ABL-XIO (adapters off), ABL-X (chain MAPs deleted),
// ABL-Y (sum MAPs deleted), FRESH, AUDIT (pair audit on Z1).

fn x3_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn x3_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// 1 if the MAP's graph is all INC cells (sum family), else 0.
fn x3_is_sumgraph(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0; let n:i32=0;
  while(cur>=0 && steps<64){
    if(ng(W,cur,0)!=103){return 0;}
    n=n+1;
    cur=seq_nx(W,cur);
    steps=steps+1;
  }
  if(n==0){return 0;}
  return 1;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, structural class.
fn x3_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(x3_is_sumgraph(W,m)==1){emit("sum");}
    else {
      if(o==1){emit("num");}
      else {emit("other");}
    }
  }
  emit("\n");
  return;
}
fn x3_census(W:[]u8)void {
  emit("maps="); e64(x3_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){x3_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, typed signature, relations, answer.
fn x3_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn x3_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn x3_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// Combination node: frozen trial precondition for sum candidates
// (cf. internal t_p2 in cx_core.zag). World setup, teaches nothing.
fn x3_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn x3_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1 ans="); e64(x1); x3_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2 ans="); e64(x2); x3_tstat(W);
  return;
}
fn x3_trainY(W:[]u8,xon:i32)void {
  x3_comb(W);
  ev_teach(W,20,82,3); ev_teach(W,20,82,5);
  let y1:i32=xio_query(W,20,92,8,0,xon);
  emit("Y1 ans="); e64(y1); x3_tstat(W);
  ev_teach(W,30,82,4); ev_teach(W,30,82,6); ev_teach(W,30,82,2);
  let y2:i32=xio_query(W,30,92,12,0,xon);
  emit("Y2 ans="); e64(y2); x3_tstat(W);
  return;
}
// Z1 facts: 81-chain 41->42->43->44 and 82-sum facts on 44 (3+7).
// Query (41,93) -> 10.
fn x3_z1facts(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43); ev_teach(W,43,81,44);
  ev_teach(W,44,82,3); ev_teach(W,44,82,7);
  return;
}
// Z2a facts: 81-chain 51->52->53->54 and 82-sum facts on 54 (2+8).
// Query (51,93) -> 10 (reuse probe; no adapter expected).
fn x3_z2afacts(W:[]u8)void {
  ev_teach(W,51,81,52); ev_teach(W,52,81,53); ev_teach(W,53,81,54);
  ev_teach(W,54,82,2); ev_teach(W,54,82,8);
  return;
}
// Z2b facts: 81-chain 71->72->73->74 and 82-sum facts on 74 (1+9).
// Query (71,94) -> 10 (new relation probe).
fn x3_z2bfacts(W:[]u8)void {
  ev_teach(W,71,81,72); ev_teach(W,72,81,73); ev_teach(W,73,81,74);
  ev_teach(W,74,82,1); ev_teach(W,74,82,9);
  return;
}
fn x3_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); x3_tstat(W);
  x3_acensus(W);
  return;
}
// Pair audit: for every ordered MAP pair with differing oty, report
// the stage outputs via the core's own xio_stage_exec. This makes
// the stage-assembly diagnosis white-box observable without touching
// the mechanism.
fn x3_pairaudit(W:[]u8,s:i32,r:i32)void {
  emit("PAIR-AUDIT s="); e64(s); emit(" r="); e64(r); emit("\n");
  let tried:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let o2:i32=xio_oty(W,m2);
          if(o1!=o2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            let v2:i32=-999999;
            if(v1!=-999999 && v1!=-2){ v2=xio_stage_exec(W,m2,v1); }
            emit("PAIR m1="); e64(m1); emit(" o1="); e64(o1);
            emit(" m2="); e64(m2); emit(" o2="); e64(o2);
            emit(" v1="); e64(v1); emit(" v2="); e64(v2); emit("\n");
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("PAIR-SUMMARY tried="); e64(tried); emit("\n");
  return;
}
fn x3_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_gap(W);
  x3_census(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  x3_trainX(W,0);
  x3_trainY(W,0);
  x3_gap(W);
  x3_census(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,0);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,0);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,0);
  return;
}
fn x3_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_del_map_r(W,91);
  emit("maps after del="); e64(x3_count_maps(W)); emit("\n");
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_del_map_r(W,92);
  emit("maps after del="); e64(x3_count_maps(W)); emit("\n");
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  x3_comb(W);
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,0);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,0);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,0);
  return;
}
fn x3_arm_audit(W:[]u8)void {
  emit("=== AUDIT ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_gap(W);
  x3_census(W);
  x3_z1facts(W);
  x3_pairaudit(W,41,93);
  x3_zq(W,"Z1",41,93,10,1);
  return;
}
// ev_query: cx_core.zag's internal test battery references this symbol.
// Provided here as the adapter pipeline (adapters enabled). The battery
// is never invoked by this driver; the entry point is xio_query.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("X3-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); x3_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); x3_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); x3_arm_ablx(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); x3_arm_ably(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); x3_arm_fresh(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); x3_arm_audit(W6);
  emit("X3-END\n");
  return 0;
}

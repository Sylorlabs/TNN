  total=total+1; if(t_r_pact6()==1){pass=pass+1; tpass("R-PACT6");} else {tfail("R-PACT6");}
  total=total+1; if(t_t2_chain4()==1){pass=pass+1; tpass("T2-CHAIN4");} else {tfail("T2-CHAIN4");}
  total=total+1; if(t_t2_trial_reject()==1){pass=pass+1; tpass("T2-REJECT");} else {tfail("T2-REJECT");}
  total=total+1; if(t_t2_inquire()==1){pass=pass+1; tpass("T2-INQUIRE");} else {tfail("T2-INQUIRE");}
  total=total+1; if(t_t2_actlive()==1){pass=pass+1; tpass("T2-ACTLIVE");} else {tfail("T2-ACTLIVE");}
  total=total+1; if(t_t2_revise()==1){pass=pass+1; tpass("T2-REVISE");} else {tfail("T2-REVISE");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<1024){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// pc_patch.zag -- persistent cross-domain connections (unfrozen pilot).
// Extends structural rebinding (adv_patch.zag) with a persistent link.
//
// On every verified rebind, write a LINK edge (type 14, unused in the
// frozen base) from the newly promoted MAP to the helper MAP whose shape
// was reused: "helper helped construct built". The link is written by the
// rebind success event itself; the driver never authors A-B relations.
//
// On later queries, rebind_try runs two passes:
//   Pass 1: MAPs with an outgoing type-14 edge (built via rebind before),
//           newest first. These are the learner's own prior successful
//           constructions.
//   Pass 2: all other MAPs in id order.
// Correctness is unchanged (execution verification still arbitrates);
// only the search order changes.
//
// pc_del_links: delete all type-14 edges (ablation: remove the connection,
// the speedup should disappear).
fn phase_a_enabled()i32 { return 1; }
// Walk a promoted graph root. If it is a pure chain
// (guard --true--> set --SEQ--> guard --true--> set ...),
// return the value-chain length plen = guards+1. Else -1.
// Verbatim from adv_patch.zag.
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}
// 1 if MAP m has an outgoing type-14 LINK edge (was built via rebind).
fn pc_is_linked(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// Delete all type-14 LINK edges. Ablation hook (driver-called).
fn pc_del_links(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Try one MAP's shape on the query. On verified success, promote the
// rebound and write the persistent LINK edge new -> helper.
fn pc_try_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        let j:i32=0;
        while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,v,plen,f);
        let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
        if(v2!=-2){
          let bm:i32=promote_graph(W,nr,s,r,v2,f,plen-1);
          if(bm>=0){link_edge(W,bm,14,m,0);}
          ans=v2;
        }
      }
      p=p+1;
    }
  }
  return ans;
}
fn rebind_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  // Pass 1: linked MAPs (prior successful rebinds), newest first.
  let m:i32=1023;
  while(m>=2 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==1){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m-1;
  }
  // Pass 2: all other MAPs in id order.
  m=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==0){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m+1;
  }
  return ans;
}
// xio_core.zag -- Learner-built typed I/O adapters (H-XIO-1, unfrozen).
// Pure Zag. No Python. Safebin PATH.
//
// A typed I/O adapter is a persistent learner-built structure (tag 40)
// that performs function composition over typed MAP outputs. When the
// learner observes a type mismatch, a competent MAP whose output type
// (NODE vs NUMBER) differs from what the chain composer expects, it
// attempts typed composition over ordered MAP pairs with differing
// output types. On verification success it builds an adapter node that
// records (m1, m2, oty1, oty2, rel1, rel2, query-relation, answer) with
// DEP provenance edges, and whose execution is the value-level handoff
// v1 = stage(m1, s), v2 = stage(m2, v1).
//
// No hardcoded type-conversion table. No CHAIN_COUNT template. The type
// labels are computed at runtime by scanning each MAP's own executable
// graph for INC cells (tag 103 of the frozen 4-op ISA). Stage relations
// are read from each MAP's own DEP provenance edges. The paired MAPs
// are chosen by verified trial, never specified by the researcher.

// ---- typed signature: 1 (NUMBER) if the graph contains an INC cell,
// ---- else 0 (NODE). Computed over learner-built white-box state.
fn xio_oty(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// ---- input relation of a stage, from the MAP's own DEP edges to its
// ---- licensing facts. -1 if no provenance found.
fn xio_dep_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      if(to>=2 && to<1024 && ng(W,to,36)==1 && ng(W,to,0)==1){
        return ng(W,to,24);
      }
    }
    e=e+1;
  }
  return -1;
}
// ---- 1 if any active MAP has a non-chain (NUMBER) output type.
fn xio_has_typed(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xio_oty(W,m)==1){return 1;}
    m=m+1;
  }
  return 0;
}
// ---- re-derive one stage for input x and execute it, masked verify
// ---- (first valid output). Returns the output or -999999.
fn xio_stage_exec(W:[]u8,m:i32,x:i32)i32 {
  let oty:i32=xio_oty(W,m);
  if(oty==0){
    let plen:i32=rb_chain_plen(W,ng(W,m,20));
    if(plen<2){return -999999;}
    let paths:[]u8=z_alloc(4608);
    if(paths.len<4608){return -999999;}
    let np:i32=t2_gather(W,x,paths);
    let p:i32=0;
    while(p<np){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        if(v.len>=24 && f.len>=16){
          let j:i32=0;
          while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,plen,f);
          if(root>=0){
            let st:[]u8=z_alloc(8);
            if(st.len>=8){
              set32(st,0,0); set32(st,4,0);
              let vv:i32=t2_try_verify(W,root,x,-2,1,st);
              if(vv!=-2 && vv!=-999999){return vv;}
            }
          }
        }
      }
      p=p+1;
    }
    return -999999;
  }
  let rel:i32=xio_dep_rel(W,m);
  if(rel<0){return -999999;}
  let vv2:[]u8=z_alloc(64); let ff2:[]u8=z_alloc(60);
  if(vv2.len<64 || ff2.len<60){return -999999;}
  let len:i32=t2_chain(W,x,rel,vv2,ff2);
  if(len<2){return -999999;}
  let root2:i32=t2_asm_count(W,vv2,len,ff2);
  if(root2<0){return -999999;}
  let st2:[]u8=z_alloc(8);
  if(st2.len<8){return -999999;}
  set32(st2,0,0); set32(st2,4,0);
  let ww:i32=t2_try_verify(W,root2,x,-2,1,st2);
  if(ww!=-2 && ww!=-999999){return ww;}
  return -999999;
}
// ---- build the persistent adapter node. Layout: 0=tag40, 4=m1,
// ---- 8=m2, 12=oty1, 16=oty2, 20=rel1, 24=rel2, 28=answer,
// ---- 32=query relation. DEP edges adapter -> m1, m2 (provenance).
fn xio_build(W:[]u8,m1:i32,m2:i32,o1:i32,o2:i32,rel1:i32,rel2:i32,qr:i32,ans:i32)i32 {
  let a:i32=alloc_node(W);
  if(a<0){return -1;}
  ns(W,a,0,40);
  ns(W,a,4,m1); ns(W,a,8,m2);
  ns(W,a,12,o1); ns(W,a,16,o2);
  ns(W,a,20,rel1); ns(W,a,24,rel2);
  ns(W,a,28,ans); ns(W,a,32,qr);
  link_edge(W,a,1,m1,0);
  link_edge(W,a,1,m2,0);
  return a;
}
// ---- execute an adapter: value-level handoff v1 = m1(s),
// ---- v2 = m2(v1). Returns v2 or -999999.
fn xio_exec(W:[]u8,a:i32,s:i32)i32 {
  let m1:i32=ng(W,a,4); let m2:i32=ng(W,a,8);
  if(m1<2 || m2<2){return -999999;}
  if(ng(W,m1,36)!=1 || ng(W,m2,36)!=1){return -999999;}
  if(ng(W,m1,0)!=20 || ng(W,m2,0)!=20){return -999999;}
  let v1:i32=xio_stage_exec(W,m1,s);
  if(v1==-999999 || v1==-2){return -999999;}
  let v2:i32=xio_stage_exec(W,m2,v1);
  if(v2==-999999 || v2==-2){return -999999;}
  return v2;
}
// ---- find the adapter serving query relation r. -1 if none.
fn xio_find(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,32)==r){return n;}
    n=n+1;
  }
  return -1;
}
// ---- count active adapters (audit).
fn xio_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){c=c+1;}
    n=n+1;
  }
  return c;
}
// ---- adapter lookup for a query: execute the relation-keyed adapter
// ---- and verify. Emits XIO-REUSE on success. Returns ans or -2.
fn xio_adapt(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let a:i32=xio_find(W,r);
  if(a<0){return -2;}
  let v:i32=xio_exec(W,a,s);
  if(v==-999999 || v==-2){return -2;}
  if(expected!=-2 && v!=expected){return -2;}
  hs(W,16,0);
  emit("XIO-REUSE id="); e64(a); emit(" ans="); e64(v); emit("\n");
  return v;
}
// ---- typed composition trial: ordered MAP pairs with DIFFERING
// ---- output types only (the mismatch gate). On v2 == expected, build
// ---- the adapter. Emits XIO-BUILD on success. Returns ans or -2.
fn xio_try(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  if(expected==-2){return -2;}
  if(xio_has_typed(W)==0){return -2;}
  let tried:i32=0; let rej:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let o2:i32=xio_oty(W,m2);
          if(o1!=o2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            if(v1!=-999999 && v1!=-2){
              let v2:i32=xio_stage_exec(W,m2,v1);
              if(v2!=-999999 && v2!=-2 && v2==expected){
                let r1:i32=xio_dep_rel(W,m1);
                let r2:i32=xio_dep_rel(W,m2);
                let a:i32=xio_build(W,m1,m2,o1,o2,r1,r2,r,v2);
                if(a<0){return -2;}
                hs(W,16,tried*1024+rej);
                emit("XIO-BUILD id="); e64(a);
                emit(" m1="); e64(m1); emit(" m2="); e64(m2);
                emit(" o1="); e64(o1); emit(" o2="); e64(o2);
                emit(" rel1="); e64(r1); emit(" rel2="); e64(r2);
                emit(" qr="); e64(r); emit(" mid="); e64(v1);
                emit(" ans="); e64(v2); emit("\n");
                return v2;
              }
            }
            rej=rej+1;
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  return -2;
}
// ---- unified query with the adapter stages. xio_on=1 enables adapter
// ---- lookup and typed composition; xio_on=0 reproduces the C215
// ---- baseline pipeline (ablation). Not a mode: xio_try is attempted
// ---- uniformly on any query where lookup and rebind failed, keyed
// ---- only by learner state, with no task-label routing.
fn xio_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,xio_on:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    let _l:i32=link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  if(xio_on==1){
    let aa:i32=xio_adapt(W,s,r,expected);
    if(aa!=-2){log_ev(W,2,s,r,aa,1,0,0); return aa;}
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0));
  emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(xio_on==1){
    let xa:i32=xio_try(W,s,r,expected);
    if(xa!=-2){log_ev(W,2,s,r,xa,1,0,0); return xa;}
  }
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// x3_driver.zag -- H-XIO-3 third-pair world, arms, census, pair audit.
// Unfrozen. The ONLY new source this wave. The adapter mechanism is
// reused verbatim from ../xio_adapters/xio_core.zag (see assembly
// recipe in NAMECHECK.md); nothing in it was copied or edited.
//
// Third pair: sequence-then-aggregate.
// X = CHAIN/sequence (node -> node, oty 0): r=81 facts, query r=91.
// Y = SUM/aggregate (direct facts -> number, oty 1, unrolled INC cells,
// no guards): r=82 facts, query r=92.
// Z = SUM(CHAIN(s)): query (41,93) -> 10. Requires CHAIN(41)=44,
// then SUM(44)=10.
// Arms: TREAT, ABL-XIO (adapters off), ABL-X (chain MAPs deleted),
// ABL-Y (sum MAPs deleted), FRESH, AUDIT (pair audit on Z1).

fn x3_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn x3_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// 1 if the MAP's graph is all INC cells (sum family), else 0.
fn x3_is_sumgraph(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0; let n:i32=0;
  while(cur>=0 && steps<64){
    if(ng(W,cur,0)!=103){return 0;}
    n=n+1;
    cur=seq_nx(W,cur);
    steps=steps+1;
  }
  if(n==0){return 0;}
  return 1;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, structural class.
fn x3_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(x3_is_sumgraph(W,m)==1){emit("sum");}
    else {
      if(o==1){emit("num");}
      else {emit("other");}
    }
  }
  emit("\n");
  return;
}
fn x3_census(W:[]u8)void {
  emit("maps="); e64(x3_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){x3_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, typed signature, relations, answer.
fn x3_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn x3_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn x3_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// Combination node: frozen trial precondition for sum candidates
// (cf. internal t_p2 in cx_core.zag). World setup, teaches nothing.
fn x3_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn x3_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1 ans="); e64(x1); x3_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2 ans="); e64(x2); x3_tstat(W);
  return;
}
fn x3_trainY(W:[]u8,xon:i32)void {
  x3_comb(W);
  ev_teach(W,20,82,3); ev_teach(W,20,82,5);
  let y1:i32=xio_query(W,20,92,8,0,xon);
  emit("Y1 ans="); e64(y1); x3_tstat(W);
  ev_teach(W,30,82,4); ev_teach(W,30,82,6); ev_teach(W,30,82,2);
  let y2:i32=xio_query(W,30,92,12,0,xon);
  emit("Y2 ans="); e64(y2); x3_tstat(W);
  return;
}
// Z1 facts: 81-chain 41->42->43->44 and 82-sum facts on 44 (3+7).
// Query (41,93) -> 10.
fn x3_z1facts(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43); ev_teach(W,43,81,44);
  ev_teach(W,44,82,3); ev_teach(W,44,82,7);
  return;
}
// Z2a facts: 81-chain 51->52->53->54 and 82-sum facts on 54 (2+8).
// Query (51,93) -> 10 (reuse probe; no adapter expected).
fn x3_z2afacts(W:[]u8)void {
  ev_teach(W,51,81,52); ev_teach(W,52,81,53); ev_teach(W,53,81,54);
  ev_teach(W,54,82,2); ev_teach(W,54,82,8);
  return;
}
// Z2b facts: 81-chain 71->72->73->74 and 82-sum facts on 74 (1+9).
// Query (71,94) -> 10 (new relation probe).
fn x3_z2bfacts(W:[]u8)void {
  ev_teach(W,71,81,72); ev_teach(W,72,81,73); ev_teach(W,73,81,74);
  ev_teach(W,74,82,1); ev_teach(W,74,82,9);
  return;
}
fn x3_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); x3_tstat(W);
  x3_acensus(W);
  return;
}
// Pair audit: for every ordered MAP pair with differing oty, report
// the stage outputs via the core's own xio_stage_exec. This makes
// the stage-assembly diagnosis white-box observable without touching
// the mechanism.
fn x3_pairaudit(W:[]u8,s:i32,r:i32)void {
  emit("PAIR-AUDIT s="); e64(s); emit(" r="); e64(r); emit("\n");
  let tried:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let o2:i32=xio_oty(W,m2);
          if(o1!=o2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            let v2:i32=-999999;
            if(v1!=-999999 && v1!=-2){ v2=xio_stage_exec(W,m2,v1); }
            emit("PAIR m1="); e64(m1); emit(" o1="); e64(o1);
            emit(" m2="); e64(m2); emit(" o2="); e64(o2);
            emit(" v1="); e64(v1); emit(" v2="); e64(v2); emit("\n");
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("PAIR-SUMMARY tried="); e64(tried); emit("\n");
  return;
}
fn x3_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_gap(W);
  x3_census(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  x3_trainX(W,0);
  x3_trainY(W,0);
  x3_gap(W);
  x3_census(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,0);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,0);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,0);
  return;
}
fn x3_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_del_map_r(W,91);
  emit("maps after del="); e64(x3_count_maps(W)); emit("\n");
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_del_map_r(W,92);
  emit("maps after del="); e64(x3_count_maps(W)); emit("\n");
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,1);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,1);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,1);
  return;
}
fn x3_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  x3_comb(W);
  x3_gap(W);
  x3_z1facts(W); x3_zq(W,"Z1",41,93,10,0);
  x3_z2afacts(W); x3_zq(W,"Z2a",51,93,10,0);
  x3_z2bfacts(W); x3_zq(W,"Z2b",71,94,10,0);
  return;
}
fn x3_arm_audit(W:[]u8)void {
  emit("=== AUDIT ===\n");
  x3_trainX(W,1);
  x3_trainY(W,1);
  x3_gap(W);
  x3_census(W);

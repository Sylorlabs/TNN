// lt3_world.zag -- LT3 harder third lifetime (PREREG.md section 12,
// PREREG_LT3.md section 3). Ten stages A-J.
//
// ============================ ID DISCIPLINE ============================
// Three id KINDS live in three DISJOINT numeric ranges, so no stage's
// subjects can ever equal another stage's relations. This removes the
// LK2 value-collision confound (ERRATA2 E7) AT THE SOURCE rather than
// masking it after the fact:
//
//   subjects  100..115   (16 shared subjects; stage E uses 5000..5059)
//   relations 1001..1010, 1101..1110, ... 1901..1910   (10 per stage)
//   objects   2001..2010, 2101..2110, ... 2901..2910   (10 per stage)
//   E: subjects 5000..5059, relations 1501..1510, objects 9501..9510
//
// The 16 subjects are SHARED by stages A,B,C,D,F,G,H,I,J. That is what
// makes a fan-in composition possible at all: a fan-in need intersects its
// SOURCE need's subject list with another (relation,object) witness set, so
// the stages it joins must be about the same subjects. FA1's world gave each
// stage a private subject band and therefore could not express a join that
// was load-bearing on more than one stage -- which is exactly the weakness
// REPORT.md section 9 identified. Relation and object bands stay private per
// stage, so per-stage attribution (frz_reldrop) remains unambiguous.
//
// ============================ NESTED WITNESS SETS ============================
// Within a stage, relation k is witnessed by a NESTED prefix of the subject
// band, so a retrieve->verify->verify->count chain narrows strictly:
//
//   k=0 : subjects 0..15   (16)
//   k=1 : subjects 0..11   (12)
//   k=2 : subjects 0..7    (8)
//   k=3 : subjects 0..3    (4)
//   k=4..9 : subjects 0..1 (2 each, non-narrowing distractors)
//
//   => 16 + 12 + 8 + 4 + 6*2 = 52 facts per stage.
//
// Stages A,B,C,D,F,G,H,I,J : 52 each = 468.  Stage E : 10 x 60 = 600
// distractors.  Total 1068 triples, arena capacity 1200.

// ---- arena writer ----
fn lt3_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<1200){
    set32(A,4+n*12,s);
    set32(A,4+n*12+4,r);
    set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
fn lt3_world_new()[]u8 { return z_alloc(16384); }

// witness count for relation index k of an ordinary stage
fn lt3_w(k:i32)i32 {
  if(k==0){ return 16; }
  if(k==1){ return 12; }
  if(k==2){ return 8; }
  if(k==3){ return 4; }
  return 2;
}
// one ordinary stage: 10 relations over the shared subject band 100..115
fn lt3_stage(A:[]u8,RB:i32,OB:i32)void {
  let k:i32=0;
  while(k<10){
    let w:i32=lt3_w(k);
    let j:i32=0;
    while(j<w){
      lt3_add(A,100+j,RB+k,OB+k);
      j=j+1;
    }
    k=k+1;
  }
  return;
}
// stage E: 10 relations x 60 subjects = 600 distractors, disjoint id ranges
fn lt3_stageE_big(A:[]u8,RB:i32,OB:i32)void {
  let k:i32=0;
  while(k<10){
    let j:i32=0;
    while(j<60){
      lt3_add(A,5000+j,RB+k,OB+k);
      j=j+1;
    }
    k=k+1;
  }
  return;
}

fn w_stageA3(A:[]u8)void { lt3_stage(A,1001,2001); return; }
fn w_stageB3(A:[]u8)void { lt3_stage(A,1101,2101); return; }
fn w_stageC3(A:[]u8)void { lt3_stage(A,1201,2201); return; }
fn w_stageD3(A:[]u8)void { lt3_stage(A,1301,2301); return; }
fn w_stageE3(A:[]u8)void { lt3_stageE_big(A,1501,9501); return; }
fn w_stageF3(A:[]u8)void { lt3_stage(A,1401,2401); return; }
fn w_stageG3(A:[]u8)void { lt3_stage(A,1601,2501); return; }
fn w_stageH3(A:[]u8)void { lt3_stage(A,1701,2601); return; }
fn w_stageI3(A:[]u8)void { lt3_stage(A,1801,2701); return; }
fn w_stageJ3(A:[]u8)void { lt3_stage(A,1901,2801); return; }

// ============================ GOAL GRAMMAR ============================
// The frozen lt_query executes a goal as an ORDERED NEED CHAIN plus links.
// This is the FA1 grammar, unchanged (see fa1.zag mkGF / mkGC):
//
//   need 0  nf=2  (rel, obj)                      RETRIEVE witness subjects
//   need 1  nf=4  (1, 0, rel, obj)   kind-2 fan-in   intersect with source list
//   need 2  nf=4  (1, 0, rel, obj)   kind-2 fan-in   intersect again
//   need 3  nf=3  (rel, 1, 0)        kind-3 fan-in   COUNT over source subjects
//   3 links: kind2 1<-0, kind2 2<-1, kind3 3<-2
//
// For a need with nf>=4 the field layout is [ns, (s,r,o) x ns] and the
// executor requires nf == 1 + ns*3. For nf=4 that means ns=1, so the leading
// field is 1 and the subject slot is the 0 placeholder that the fan-in
// replaces with each candidate subject. (Getting this wrong -- emitting
// [0, r, o] -- makes nf==1+0*3==1, the need is rejected as malformed, and the
// whole goal silently answers empty. That was the first LT3 build's bug; it
// was caught by the DECL/ORACLE vector dump, not by the compiler.)
//
// The ANSWER VECTOR is the concatenation, per need in order, of
// [n_out, out_0 .. out_{n_out-1}]. So a 4-need goal answers
// [n0, s0..s_{n0-1}][n1, ...][n2, ...][1, count].
//
// All eight shapes run the SAME four-need chain and differ only in WHICH
// stage each need's (relation, object) comes from. That is deliberate: the
// goal language is held fixed so that any difference between the goals is a
// difference in the world, not in the encoding.
fn lt3_goal4(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32,o1:i32,r2:i32,o2:i32,r3:i32)void {
  let o:i32=gq_b(G,tag,4);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r1); o=gq_f(G,o,o1);
  o=gq_n(G,o,tag+3,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r2); o=gq_f(G,o,o2);
  o=gq_n(G,o,tag+4,3); o=gq_f(G,o,r3); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,3,3,2);
  return;
}

// relation / object base per stage letter (s = 0..9 for A,B,C,D,E,F,G,H,I,J)
fn lt3_rb(s:i32)i32 {
  if(s==0){ return 1001; }
  if(s==1){ return 1101; }
  if(s==2){ return 1201; }
  if(s==3){ return 1301; }
  if(s==4){ return 1501; }
  if(s==5){ return 1401; }
  if(s==6){ return 1601; }
  if(s==7){ return 1701; }
  if(s==8){ return 1801; }
  return 1901;
}
fn lt3_ob(s:i32)i32 {
  if(s==0){ return 2001; }
  if(s==1){ return 2101; }
  if(s==2){ return 2201; }
  if(s==3){ return 2301; }
  if(s==4){ return 9501; }
  if(s==5){ return 2401; }
  if(s==6){ return 2501; }
  if(s==7){ return 2601; }
  if(s==8){ return 2701; }
  return 2801;
}

// which: 0 GA(stage A) 1 GB(B) 2 GC(C) 4 GF(A+F) 5 GACF(A+C+F)
//        6 G3(B+C) 7 GH(invention pressure) 8 GIJ(I+J)
fn mkLT3_goal(which:i32,G:[]u8)void {
  // ---- 0: GA -- all four needs from stage A ----
  if(which==0){ lt3_goal4(G,7100,1001,2001,1002,2002,1003,2003,1004); return; }
  // ---- 1: GB -- all four needs from stage B ----
  if(which==1){ lt3_goal4(G,7200,1101,2101,1102,2102,1103,2103,1104); return; }
  // ---- 2: GC -- all four needs from stage C ----
  if(which==2){ lt3_goal4(G,7300,1201,2201,1202,2202,1203,2203,1204); return; }
  // ---- 4: GF -- TWO-stage join A + F ----
  if(which==4){ lt3_goal4(G,7400,1001,2001,1402,2402,1003,2003,1004); return; }
  // ---- 5: GACF -- THREE-stage join A + C + F (the load-bearing goal) ----
  if(which==5){ lt3_goal4(G,7500,1001,2001,1202,2202,1403,2403,1404); return; }
  // ---- 6: G3 -- TWO-stage join B + C ----
  if(which==6){ lt3_goal4(G,7600,1101,2101,1202,2202,1103,2103,1104); return; }
  // ---- 8: GIJ -- TWO-stage join I + J, on the structure assembled at I ----
  if(which==8){ lt3_goal4(G,7800,1801,2701,1902,2802,1803,2703,1804); return; }
  // ---- 7: GH -- invention pressure. Relation 1999 / object 2999 occur in
  // NO stage, and need 1 carries nf=5 which violates nf == 1+ns*3 for every
  // ns, so the need is unanswerable by construction and correct behaviour is
  // DECLINE. Same device as FA1's which==6.
  if(which==7){
    let o:i32=gq_b(G,7700,4);
    o=gq_n(G,o,7701,2); o=gq_f(G,o,1999); o=gq_f(G,o,2999);
    o=gq_n(G,o,7702,5); o=gq_f(G,o,1); o=gq_f(G,o,1999); o=gq_f(G,o,2999); o=gq_f(G,o,0);
    o=gq_n(G,o,7703,3); o=gq_f(G,o,1999); o=gq_f(G,o,1); o=gq_f(G,o,0);
    o=gq_l(G,o,2);
    o=gq_k(G,o,2,1,0);
    o=gq_k(G,o,3,2,1);
    return;
  }
  return;
}

// ============================ DECLARED ANSWERS ============================
// Closed form from the world definition ABOVE, derived by hand and then
// cross-checked against the independent memory-free oracle (K22). Not
// generated from the oracle.
//
// Ordinary stages: need0 -> 16 subjects (100..115); need1 intersects with
// relation k=1 (12 subjects, 100..111); need2 with k=2 (8, 100..107).
// Every ordinary goal -- stage-local, 2-stage join or 3-stage join -- has the
// same nested shape, so the same answer vector.
//
// need3 is NOT a subject count. cnt_gen(A, rel, SUBL, ...) returns the number
// of DISTINCT OBJECTS witnessed by `rel` across the candidate subject list.
// need2's list is {100..107}; relation k=3 is witnessed by {100..103}; all
// four of those facts carry the single object OB+3, so the distinct-object
// count is 1, not 4. Declaring 4 here was the second LT3 encoding bug, again
// caught by the DECL/ORACLE dump and not by the compiler.
fn lt3_ans_std(X:[]u8)void {
  set32(X,0,0);
  ans_append(X,16);
  let j:i32=0;
  while(j<16){ ans_append(X,100+j); j=j+1; }
  ans_append(X,12);
  j=0;
  while(j<12){ ans_append(X,100+j); j=j+1; }
  ans_append(X,8);
  j=0;
  while(j<8){ ans_append(X,100+j); j=j+1; }
  ans_append(X,1);
  ans_append(X,1);
  return;
}
fn ltLT3_decl(which:i32,X:[]u8)void {
  set32(X,0,0);
  if(which==7){ set32(X,0,-1); return; }
  lt3_ans_std(X);
  return;
}
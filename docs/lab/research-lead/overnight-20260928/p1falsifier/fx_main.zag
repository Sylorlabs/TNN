// fx_main.zag -- P1-FALSIFIER. All new code for lane/p1falsifier.
//
// The five frozen files (frz.zag sup.zag wld.zag life.zag hlp.zag) are
// byte-identical copies from lane/p1mech @2162252f2 and are NOT edited. The
// learner is reached only through frz_episode(...) and lt_query(...).
//
// Sections:
//   S0  lifetime (FROZEN: one append per episode)
//   S1  SPEC vs CONTAINED: first-class spec-gap measurement (bars V0, V2)
//   S2  the 2x2 on the IDENTICAL gap arena: {AGED,COLD} x {rebuild on/off}
//   S3  TTC-RESTORE: examples-to-criterion on the restoration curve
//   S4  V1 arena-permutation invariance of EXACT and OFC
//   S5  DERIV: researcher-stated regularity predictor + its falsification
//   S6  K11 FAMV family-vector rows are emitted by fx_arm for every arm
//   S7  K12 PLAN: keyed by declared tag or by canonical shape tag
//   S8  K7-K10 negative transfer: bisection, aged-vs-cold, order, permanence
//   S9  K13 POIS: sticky poison vs BIND-slot loss

// ============================ 0. PRIMITIVES ============================
fn fx_copy(d:[]u8,s:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ d[i]=s[i]; i=i+1; }
  return;
}
fn fx_zero(d:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ d[i]=0; i=i+1; }
  return;
}
fn fx_cells(d:[]u8,n:i32)i32 {
  let c:i32=0;
  let k:i32=0;
  while(k*4<n){ if(get32(d,k*4)!=0){ c=c+1; } k=k+1; }
  return c;
}
fn fx_pw(L:[]u8,LT:[]u8)i32 { return fx_cells(L,16384)+fx_cells(LT,8192); }
fn fx_new()[]u8 { return z_alloc(16384); }

// ============================ 1. SPEC TABLE ============================
// Hand-declared. NOT read out of any goal record. What the goal REQUIRES.
fn fx_rel_of(g:i32,i:i32)i32 {
  if(g==5){ if(i==0){ return 1001; } if(i==1){ return 1202; } if(i==2){ return 1403; } return 1404; }
  if(g==0){ if(i==0){ return 1001; } if(i==1){ return 1002; } if(i==2){ return 1003; } return 1004; }
  if(g==1){ if(i==0){ return 1101; } if(i==1){ return 1102; } if(i==2){ return 1103; } return 1104; }
  if(g==2){ if(i==0){ return 1201; } if(i==1){ return 1202; } if(i==2){ return 1203; } return 1204; }
  if(g==4){ if(i==0){ return 1001; } if(i==1){ return 1402; } if(i==2){ return 1003; } return 1004; }
  if(g==6){ if(i==0){ return 1101; } if(i==1){ return 1202; } if(i==2){ return 1103; } return 1104; }
  if(g==8){ if(i==0){ return 1801; } if(i==1){ return 1902; } if(i==2){ return 1803; } return 1804; }
  // g=7 (GH, invention pressure), need by need, from the goal record's fields:
  // need0 nf=2 fields (1999,2999); need1 nf=5 fields (1,1999,2999,0) so the
  // frozen (f2,f3) pair is (2999,0); need2 nf=3 (1999,1,0); need3 nf=3
  // (1999,1,0). so=0 on needs 1..3 means "the goal specifies no object".
  if(g==7){ if(i==1){ return 2999; } return 1999; }
  return 1001+i;
}
fn fx_obj_of(g:i32,i:i32)i32 {
  if(g==5){ if(i==0){ return 2001; } if(i==1){ return 2202; } if(i==2){ return 2403; } return 0; }
  if(g==0){ if(i==0){ return 2001; } if(i==1){ return 2002; } if(i==2){ return 2003; } return 0; }
  if(g==1){ if(i==0){ return 2101; } if(i==1){ return 2102; } if(i==2){ return 2103; } return 0; }
  if(g==2){ if(i==0){ return 2201; } if(i==1){ return 2202; } if(i==2){ return 2203; } return 0; }
  if(g==4){ if(i==0){ return 2001; } if(i==1){ return 2402; } if(i==2){ return 2003; } return 0; }
  if(g==6){ if(i==0){ return 2101; } if(i==1){ return 2202; } if(i==2){ return 2103; } return 0; }
  if(g==8){ if(i==0){ return 2701; } if(i==1){ return 2802; } if(i==2){ return 2703; } return 0; }
  if(g==7){ if(i==0){ return 2999; } return 0; }
  if(i==3){ return 0; }
  return 2001+i;
}
// ---- CONTAINED(i): triples in the arena with the SPEC's (r,o) ----
fn fx_contained(A:[]u8,r:i32,o:i32)i32 {
  let n:i32=get32(A,0);
  let c:i32=0;
  let j:i32=0;
  while(j<n){
    if(get32(A,4+j*12+4)==r){
      if(o==0){ c=c+1; }
      if(get32(A,4+j*12+8)==o){ c=c+1; }
    }
    j=j+1;
  }
  return c;
}
// ---- bar V0: the declared SPEC vs the goal record ----
fn fx_spec_mismatch(G:[]u8,g:i32)i32 {
  let nn:i32=g_nneeds(G);
  let bad:i32=0;
  let i:i32=0;
  while(i<nn){
    let nf:i32=need_nf(G,i);
    let sr:i32=fx_rel_of(g,i);
    let so:i32=fx_obj_of(g,i);
    if(nf==2){
      if(need_f(G,i,0)!=sr){ bad=bad+1; }
      if(need_f(G,i,1)!=so){ bad=bad+1; }
    }
    if(nf==3){
      if(need_f(G,i,0)!=sr){ bad=bad+1; }
      if(so!=0){ bad=bad+1; }
    }
    if(nf>=4){
      if(need_f(G,i,2)!=sr){ bad=bad+1; }
      if(need_f(G,i,3)!=so){ bad=bad+1; }
    }
    i=i+1;
  }
  return bad;
}

// ============================ 2. GOAL BUILDERS ============================
// NT goal j (1..6). need0 = nf2 (1001,2001). needs 1..3 take a COMBO whose
// (nf,kind) fixes the need-shape signature nf*7+k1*13+k2*29+k3*61, hence the
// canonical tag, hence one frozen BIND entry. The BIND table has 8 slots.
fn fx_combo_nf(c:i32)i32 {
  if(c==0){ return 4; } if(c==1){ return 2; } if(c==2){ return 3; }
  if(c==3){ return 4; } if(c==4){ return 2; } if(c==5){ return 4; }
  if(c==6){ return 2; } if(c==7){ return 3; } if(c==8){ return 3; }
  return 2;
}
fn fx_combo_kind(c:i32)i32 {
  if(c==0){ return 2; } if(c==1){ return 3; } if(c==2){ return 3; }
  if(c==3){ return 1; } if(c==4){ return 2; } if(c==5){ return 3; }
  if(c==6){ return 1; } if(c==7){ return 2; } if(c==8){ return 1; }
  return 0;
}
fn fx_combo_ds(c:i32)i32 {
  if(c==3){ return 2; } if(c==6){ return 1; } if(c==8){ return 2; }
  return 0;
}
fn fx_need(G:[]u8,o:i32,tag:i32,nf:i32,r:i32,ob:i32)i32 {
  let p:i32=gq_n(G,o,tag,nf);
  if(nf==2){ p=gq_f(G,p,r); p=gq_f(G,p,ob); return p; }
  if(nf==3){ p=gq_f(G,p,r); p=gq_f(G,p,1); p=gq_f(G,p,ob); return p; }
  p=gq_f(G,p,1); p=gq_f(G,p,0); p=gq_f(G,p,r); p=gq_f(G,p,ob);
  return p;
}
fn fx_link(G:[]u8,o:i32,k:i32,dn:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,o,k); set32(G,o+4,dn); set32(G,o+8,ds); set32(G,o+12,0);
  set32(G,o+16,sn); set32(G,o+20,sk); set32(G,o+24,ss);
  return o+28;
}
fn fx_nt_goal(j:i32,G:[]u8)void {
  let c1:i32=(j-1)-((j-1)/10)*10;
  let c2:i32=(j+2)-((j+2)/10)*10;
  let c3:i32=(j+4)-((j+4)/10)*10;
  let o:i32=gq_b(G,9000+j,4);
  o=fx_need(G,o,9100+j,2,1001,2001);
  o=fx_need(G,o,9110+j,fx_combo_nf(c1),fx_rel_of(20,1),fx_obj_of(20,1));
  o=fx_need(G,o,9120+j,fx_combo_nf(c2),fx_rel_of(20,2),fx_obj_of(20,2));
  o=fx_need(G,o,9130+j,fx_combo_nf(c3),fx_rel_of(20,3),fx_obj_of(20,3));
  o=gq_l(G,o,3);
  o=fx_link(G,o,fx_combo_kind(c1),1,fx_combo_ds(c1),0,0,0);
  o=fx_link(G,o,fx_combo_kind(c2),2,fx_combo_ds(c2),1,0,0);
  o=fx_link(G,o,fx_combo_kind(c3),3,fx_combo_ds(c3),2,0,0);
  return;
}
// need-shape signature, recomputed independently of sup.zag:579
fn fx_ntsig(G:[]u8,ni:i32)i32 {
  let nf:i32=need_nf(G,ni);
  let nl:i32=g_nlinks(G);
  let k1:i32=0; let k2:i32=0; let k3:i32=0;
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,1)==ni){
      let k:i32=link_w(G,l,0);
      if(k==1){ k1=k1+1; }
      if(k==2){ k2=k2+1; }
      if(k==3){ k3=k3+1; }
    }
    l=l+1;
  }
  return nf*7+k1*13+k2*29+k3*61;
}
// cumulative count of DISTINCT need-shape signatures across NT goals 1..m
fn fx_ntdistinct(m:i32,OUT:[]u8)i32 {
  let seen:[]u8=z_alloc(256);
  let G:[]u8=z_alloc(512);
  set32(OUT,0,0);
  let j:i32=1;
  while(j<=m){
    fx_nt_goal(j,G);
    let nn:i32=g_nneeds(G);
    let i:i32=0;
    while(i<nn){
      let s:i32=fx_ntsig(G,i);
      let fnd:i32=0;
      let t:i32=0;
      while(t<get32(OUT,0)){ if(get32(seen,t*4)==s){ fnd=1; } t=t+1; }
      if(fnd==0){
        let z:i32=get32(OUT,0);
        if(z<60){ set32(seen,z*4,s); set32(OUT,0,z+1); }
      }
      i=i+1;
    }
    j=j+1;
  }
  return get32(OUT,0);
}

// ============================ 3. ORDER-FREE FIDELITY ============================
// For each need INDEX i in ascending order, the expected record is recomputed
// from A and the declared SPEC. Inputs are {A,G,i,ANS} only: no plan, no pass
// counter, no emission position.
fn fx_ofc(A:[]u8,G:[]u8,g:i32,ANS:[]u8,OUT:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  set32(OUT,0,0); set32(OUT,4,0); set32(OUT,8,nn);
  let EB:[]u8=z_alloc(512);
  let PB:[]u8=z_alloc(512);
  set32(PB,0,0);
  let pn:i32=0;
  let p:i32=1;
  let i:i32=0;
  while(i<nn){
    let sr:i32=fx_rel_of(g,i);
    let so:i32=fx_obj_of(g,i);
    set32(EB,0,0);
    if(so==0){
      let seen:[]u8=z_alloc(512);
      set32(seen,0,0);
      let a:i32=0;
      while(a<pn){
        let subj:i32=get32(PB,4+a*4);
        let na:i32=get32(A,0);
        let j:i32=0;
        while(j<na){
          if(get32(A,4+j*12)==subj){
            if(get32(A,4+j*12+4)==sr){
              let fo:i32=get32(A,4+j*12+8);
              let dup:i32=0;
              let f:i32=0;
              while(f<get32(seen,0)){ if(get32(seen,4+f*4)==fo){ dup=1; } f=f+1; }
              if(dup==0){
                let z:i32=get32(seen,0);
                if(z<100){ set32(seen,4+z*4,fo); set32(seen,0,z+1); }
              }
            }
          }
          j=j+1;
        }
        a=a+1;
      }
      set32(EB,0,1);
      set32(EB,4,get32(seen,0));
    } else {
      let na2:i32=get32(A,0);
      let j2:i32=0;
      while(j2<na2){
        let s2:i32=get32(A,4+j2*12);
        let ok2:i32=0;
        if(get32(A,4+j2*12+4)==sr){ if(get32(A,4+j2*12+8)==so){ ok2=1; } }
        if(ok2==1){
          if(pn>0){
            let fnd:i32=0;
            let m2:i32=0;
            while(m2<pn){ if(get32(PB,4+m2*4)==s2){ fnd=1; } m2=m2+1; }
            ok2=fnd;
          }
          if(ok2==1){
            let z2:i32=get32(EB,0);
            if(z2<100){ set32(EB,4+z2*4,s2); set32(EB,0,z2+1); }
          }
        }
        j2=j2+1;
      }
    }
    let nact:i32=get32(ANS,p*4);
    p=p+1;
    let ne:i32=get32(EB,0);
    let w:i32=0;
    if(nact==ne){ w=1; }
    let k:i32=0;
    while(k<nact){
      let v:i32=get32(ANS,(p+k)*4);
      let f2:i32=0;
      let m:i32=0;
      while(m<ne){ if(get32(EB,4+m*4)==v){ f2=1; } m=m+1; }
      if(f2==0){ w=0; }
      k=k+1;
    }
    let k2:i32=0;
    while(k2<nact){
      let v2:i32=get32(ANS,(p+k2)*4);
      let f3:i32=0;
      let m3:i32=0;
      while(m3<ne){ if(get32(EB,4+m3*4)==v2){ f3=1; } m3=m3+1; }
      if(f3==0){ set32(OUT,4,get32(OUT,4)+1); }
      k2=k2+1;
    }
    if(w==1){ set32(OUT,0,get32(OUT,0)+1); }
    p=p+nact;
    set32(PB,0,ne);
    let cp:i32=0;
    while(cp<ne){ set32(PB,4+cp*4,get32(EB,4+cp*4)); cp=cp+1; }
    pn=ne;
    i=i+1;
  }
  return get32(OUT,0);
}
// per-need bound family. The BIND table never holds the goal's DECLARED need
// tags: on a template miss lt_query (sup.zag:945-955) replaces each need tag
// with a CANONICAL t = 5000+LT[56], and stores it at LT[lt_tb(e)+12+i*4]. So
// the family actually bound is read as: template for this goal's shape ->
// stored canonical tag for need i -> BIND slot -> family.
fn fx_famv(L:[]u8,LT:[]u8,G:[]u8,OUT:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let e:i32=lt_tmpl_find(LT,lt_sig_goal(G));
  let i:i32=0;
  while(i<nn){
    let f:i32=-2;
    if(e>=0){
      let tag:i32=get32(LT,lt_tb(e)+12+i*4);
      let bi:i32=bind_find(L,tag);
      if(bi>=0){ f=bind_fam(L,bi); }
    }
    set32(OUT,i*4,f);
    i=i+1;
  }
  return nn;
}
// the 8 BIND slots as (tag, family) pairs -- what the learner actually holds
fn fx_bindtab(L:[]u8,OUT:[]u8)i32 {
  let i:i32=0;
  while(i<8){
    set32(OUT,i*8,get32(L,bind_off(i)));
    set32(OUT,i*8+4,get32(L,bind_off(i)+4));
    i=i+1;
  }
  return 8;
}
// per-need record counts of an answer vector, e.g. [16,..][12,..] -> 16 12
fn fx_recn(X:[]u8,NN:[]u8,OUT:[]u8)i32 {
  let nn:i32=get32(NN,0);
  set32(OUT,0,0);
  let p:i32=1;
  let i:i32=0;
  while(i<nn){
    let n:i32=get32(X,p*4);
    set32(OUT,i*4,n);
    set32(OUT,0,i+1);
    p=p+n+1;
    i=i+1;
  }
  return get32(OUT,0);
}
fn fx_clr_poison(T:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<12){
    let b:i32=lt_tb(i);
    if(get32(T,b)!=0){
      if(get32(T,b+8)==2){ set32(T,b+8,0); n=n+1; }
    }
    i=i+1;
  }
  return n;
}

// ============================ 4. ARENA TOOLS ============================
fn fx_copy_arena(dst:[]u8,src:[]u8)i32 {
  let i:i32=0;
  while(i<3600){ set32(dst,i*4,get32(src,i*4)); i=i+1; }
  return get32(src,0);
}
fn fx_del_rel(A:[]u8,r:i32)i32 {
  let n:i32=get32(A,0);
  let w:i32=0;
  let i:i32=0;
  while(i<n){
    let kill:i32=0;
    if(get32(A,4+i*12+4)==r){ kill=1; }
    if(kill==0){
      set32(A,4+w*12,get32(A,4+i*12));
      set32(A,4+w*12+4,get32(A,4+i*12+4));
      set32(A,4+w*12+8,get32(A,4+i*12+8));
      w=w+1;
    }
    i=i+1;
  }
  set32(A,0,w);
  return w;
}
// deterministic permutations (bar V1): 0=reverse 1=stride-7 rotate 2=sort by r
fn fx_perm(A:[]u8,mode:i32,OUT:[]u8)i32 {
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    let j:i32=i;
    if(mode==0){ j=n-1-i; }
    if(mode==1){ j=(i*7)-((i*7)/n)*n; }
    set32(OUT,4+i*12,get32(A,4+j*12));
    set32(OUT,4+i*12+4,get32(A,4+j*12+4));
    set32(OUT,4+i*12+8,get32(A,4+j*12+8));
    i=i+1;
  }
  if(mode==2){
    let a:i32=1;
    while(a<n){
      let bi:i32=a;
      let t:i32=a+1;
      while(t<n){
        if(get32(OUT,4+t*12+4)<get32(OUT,4+bi*12+4)){ bi=t; }
        t=t+1;
      }
      let v1:i32=get32(OUT,4+bi*12);
      let v2:i32=get32(OUT,4+bi*12+4);
      let v3:i32=get32(OUT,4+bi*12+8);
      let m:i32=a;
      while(m>bi){
        set32(OUT,4+m*12,get32(OUT,4+(m-1)*12));
        set32(OUT,4+m*12+4,get32(OUT,4+(m-1)*12+4));
        set32(OUT,4+m*12+8,get32(OUT,4+(m-1)*12+8));
        m=m-1;
      }
      set32(OUT,4+bi*12,v1);
      set32(OUT,4+bi*12+4,v2);
      set32(OUT,4+bi*12+8,v3);
      a=a+1;
    }
  }
  set32(OUT,0,n);
  return n;
}

// ============================ 5. ARM RUNNER ============================
fn fx_arm(b:[]u8,c:i32,lbl:[]u8,L:[]u8,LT:[]u8,A:[]u8,G:[]u8,g:i32,DE:[]u8) i32 {
  let K:[]u8=z_alloc(64);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(512);
  let OR:[]u8=z_alloc(512);
  let KB:[]u8=z_alloc(64);
  let OF:[]u8=z_alloc(64);
  let FV:[]u8=z_alloc(64);
  let BT:[]u8=z_alloc(64);
  fx_zero(R,128);
  fx_zero(K,64);
  let pre:i32=fx_pw(L,LT);
  let code:i32=lt_query(L,LT,A,G,K,R,AN);
  let ex:i32=lt_score(DE,AN,code);
  let w:i32=fx_ofc(A,G,g,AN,OF);
  let nn:i32=get32(OF,8);
  let unb:i32=get32(OF,4);
  let h1:i32=lt_oracle(A,G,OR,KB);
  let ora:i32=0;
  if(h1==1){ if(lt_ans_eq(AN,OR)==1){ ora=1; } }
  fx_famv(L,LT,G,FV);
  fx_bindtab(L,BT);
  let post:i32=fx_pw(L,LT);
  c=o_app(b,c,"ARM ");
  c=o_app(b,c,lbl);
  c=o_app(b,c," exact="); c=o_i64(b,c,ex as i64);
  c=o_app(b,c," ofcw="); c=o_i64(b,c,w as i64);
  c=o_app(b,c," nn="); c=o_i64(b,c,nn as i64);
  c=o_app(b,c," unbacked="); c=o_i64(b,c,unb as i64);
  c=o_app(b,c," ora="); c=o_i64(b,c,ora as i64);
  c=o_app(b,c," code="); c=o_i64(b,c,code as i64);
  c=o_app(b,c," ansn="); c=o_i64(b,c,get32(AN,0) as i64);
  c=o_app(b,c," arena="); c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," famv=");
  let fi:i32=0;
  while(fi<nn){ c=o_i64(b,c,get32(FV,fi*4) as i64); fi=fi+1; }
  c=o_app(b,c," bindtab=");
  let bi2:i32=0;
  while(bi2<8){ c=o_i64(b,c,get32(BT,bi2*8) as i64); c=o_app(b,c,":"); c=o_i64(b,c,get32(BT,bi2*8+4) as i64); c=o_app(b,c," "); bi2=bi2+1; }
  c=o_nl(b,c);
  c=o_app(b,c,"ARMM ");
  c=o_app(b,c,lbl);
  c=o_app(b,c," reads="); c=o_i64(b,c,get32(R,84) as i64);
  c=o_app(b,c," trials="); c=o_i64(b,c,get32(R,4) as i64);
  c=o_app(b,c," miss="); c=o_i64(b,c,get32(R,28) as i64);
  c=o_app(b,c," bhit="); c=o_i64(b,c,get32(R,24) as i64);
  c=o_app(b,c," builds="); c=o_i64(b,c,get32(R,72) as i64);
  c=o_app(b,c," loads="); c=o_i64(b,c,get32(R,76) as i64);
  c=o_app(b,c," passes="); c=o_i64(b,c,get32(R,44) as i64);
  c=o_app(b,c," declines="); c=o_i64(b,c,get32(R,80) as i64);
  c=o_app(b,c," rebuilds="); c=o_i64(b,c,get32(LT,4) as i64);
  c=o_app(b,c," poison="); c=o_i64(b,c,get32(LT,40) as i64);
  c=o_app(b,c," bindex="); c=o_i64(b,c,get32(LT,88) as i64);
  c=o_app(b,c," mints="); c=o_i64(b,c,get32(LT,20) as i64);
  c=o_app(b,c," preW="); c=o_i64(b,c,pre as i64);
  c=o_app(b,c," postW="); c=o_i64(b,c,post as i64);
  c=o_app(b,c," memL="); c=o_i64(b,c,fx_cells(L,16384) as i64);
  c=o_app(b,c," memLT="); c=o_i64(b,c,fx_cells(LT,8192) as i64);
  c=o_nl(b,c);
  return c;
}

// ============================ 6. LIFETIME ============================
fn fx_lifetime(L:[]u8,LT:[]u8,A:[]u8,AS:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8)i32 {
  fx_zero(L,16384);
  fx_zero(LT,8192);
  fx_zero(A,16384);
  set32(LT,68,1);
  let eps:i32=0;
  let s:i32=0;
  while(s<10){
    frz_stage_into(AS,s);
    let nf:i32=frz_nfact(s);
    let k:i32=0;
    while(k<nf){
      frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE);
      eps=eps+1;
      k=k+1;
    }
    s=s+1;
  }
  return eps;
}

// ============================ 7. DERIV (candidate c) ============================
// The nested-witness-prefix regularity, RESEARCHER-STATED. Reads no arena.
fn fx_deriv_pred(OUT:[]u8)i32 {
  set32(OUT,0,16); set32(OUT,4,12); set32(OUT,8,8); set32(OUT,12,1);
  return 4;
}
fn fx_wcount(A:[]u8,s:i32,k:i32)i32 {
  return fx_contained(A,lt3_rb(s)+k,lt3_ob(s)+k);
}
fn fx_deriv_regular(A:[]u8)i32 {
  let s:i32=0;
  while(s<10){
    if(s==4){ s=s+1; }
    else {
      let k:i32=0;
      while(k<10){
        if(fx_wcount(A,s,k)!=lt3_w(k)){ return 0; }
        k=k+1;
      }
      s=s+1;
    }
  }
  return 1;
}

// ============================ 8. NT SEQUENCE ============================
// declared answer := the memory-free oracle over the SAME arena.
// RES[j*8+0]=code, RES[j*8+4]=exact, RES[j*8+8]=cost. A goal that is answered
// but WRONG (code=1, exact=0) is recorded distinctly from a decline, because
// prereg bar K8 is about EXACT and not about code.
fn fx_nt_seq(L:[]u8,LT:[]u8,A:[]u8,order:i32,m:i32,RES:[]u8)i32 {
  let G:[]u8=z_alloc(512);
  let K:[]u8=z_alloc(64);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(512);
  let DE:[]u8=z_alloc(512);
  let KB:[]u8=z_alloc(64);
  let dec:i32=0;
  let t:i32=0;
  while(t<m){
    let j:i32=0;
    if(order==0){ j=t+1; }
    if(order==1){ j=m-t; }
    if(order==2){
      if((t%2)==0){ j=t/2+1; }
      if((t%2)==1){ j=m-t/2; }
    }
    fx_nt_goal(j,G);
    fx_zero(R,128);
    fx_zero(K,64);
    fx_zero(DE,512);
    let h:i32=lt_oracle(A,G,DE,KB);
    if(h==0){ set32(DE,0,-1); }
    let code:i32=lt_query(L,LT,A,G,K,R,AN);
    let ex:i32=lt_score(DE,AN,code);
    set32(RES,j*8,code);
    set32(RES,j*8+4,ex);
    set32(RES,j*8+8,get32(R,84));
    if(ex==0){ dec=dec+1; }
    t=t+1;
  }
  return dec;
}
fn fx_nt_one(L:[]u8,LT:[]u8,A:[]u8,j:i32,OUT:[]u8)i32 {
  let G:[]u8=z_alloc(512);
  let K:[]u8=z_alloc(64);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(512);
  let DE:[]u8=z_alloc(512);
  let KB:[]u8=z_alloc(64);
  fx_nt_goal(j,G);
  fx_zero(R,128);
  fx_zero(K,64);
  fx_zero(DE,512);
  let h:i32=lt_oracle(A,G,DE,KB);
  if(h==0){ set32(DE,0,-1); }
  let code:i32=lt_query(L,LT,A,G,K,R,AN);
  let ex:i32=lt_score(DE,AN,code);
  set32(OUT,0,code);
  set32(OUT,4,ex);
  set32(OUT,8,get32(R,84));
  return code;
}

// ============================ 9. MAIN ============================
fn main() i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  _zag_println("P1-FALSIFIER C660-C699");

  let L:[]u8=fx_new();
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=fx_new();
  let AS:[]u8=fx_new();
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(256);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let G:[]u8=z_alloc(512);
  let DE:[]u8=z_alloc(512);
  let SL:[]u8=fx_new();
  let ST:[]u8=z_alloc(8192);
  let AF:[]u8=fx_new();
  let GAP:[]u8=fx_new();
  let GAP1:[]u8=fx_new();
  let EMP:[]u8=fx_new();
  let L2:[]u8=fx_new();
  let T2:[]u8=z_alloc(8192);
  let R2:[]u8=z_alloc(128);
  let AN2:[]u8=z_alloc(512);
  let KB2:[]u8=z_alloc(64);

  // ---------- S0 lifetime ----------
  let eps:i32=fx_lifetime(L,LT,A,AS,K,RB,CB,TO,SE);
  fx_copy(SL,L,16384);
  fx_copy(ST,LT,8192);
  fx_copy_arena(AF,A);
  c=o_app(b,c,"S0 lifetime eps="); c=o_i64(b,c,eps as i64);
  c=o_app(b,c," arena="); c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," memL="); c=o_i64(b,c,fx_cells(L,16384) as i64);
  c=o_app(b,c," memLT="); c=o_i64(b,c,fx_cells(LT,8192) as i64);
  c=o_app(b,c," preW="); c=o_i64(b,c,fx_pw(L,LT) as i64);
  c=o_nl(b,c);

  // ---------- S1 SPEC vs CONTAINED, bars V0 and V2 ----------
  let goals:[]u8=z_alloc(64);
  set32(goals,0,0); set32(goals,4,1); set32(goals,8,2); set32(goals,12,4);
  set32(goals,16,5); set32(goals,20,6); set32(goals,24,7); set32(goals,28,8);
  let mism:i32=0;
  let v2all:i32=1;
  let vi:i32=0;
  while(vi<8){
    let g:i32=get32(goals,vi*4);
    mkLT3_goal(g,G);
    ltLT3_decl(g,DE);
    let KB0:[]u8=z_alloc(64);
    let OR0:[]u8=z_alloc(512);
    let h:i32=lt_oracle(A,G,OR0,KB0);
    let v2:i32=0;
    // The oracle declining (h==0) AGREES with a declared answer of -1
    // ("the correct behaviour is DECLINE"), which is how g=7 is declared.
    if(h==0){ if(get32(DE,0)==-1){ v2=1; } }
    if(h==1){ if(lt_ans_eq(OR0,DE)==1){ v2=1; } }
    if(v2==0){ v2all=0; }
    mism=mism+fx_spec_mismatch(G,g);
    let nn:i32=g_nneeds(G);
    let pres:i32=0;
    let gap:i32=0;
    let pr:i32=0;
    let i:i32=0;
    while(i<nn){
      let ct:i32=fx_contained(A,fx_rel_of(g,i),fx_obj_of(g,i));
      if(ct>0){ pres=pres+1; }
      if(ct==0){ gap=gap+1; pr=pr*10+i; }
      i=i+1;
    }
    c=o_app(b,c,"S1 SPEC g="); c=o_i64(b,c,g as i64);
    c=o_app(b,c," nn="); c=o_i64(b,c,nn as i64);
    c=o_app(b,c," contained="); c=o_i64(b,c,pres as i64);
    c=o_app(b,c," gap="); c=o_i64(b,c,gap as i64);
    c=o_app(b,c," gapneed="); c=o_i64(b,c,pr as i64);
    c=o_app(b,c," v2="); c=o_i64(b,c,v2 as i64);
    c=o_app(b,c," mismatch="); c=o_i64(b,c,fx_spec_mismatch(G,g) as i64);
    // g=7 is VOID for V0: wld.zag:185-194 declares nn=4 but writes only THREE
    // need records, so need 3 is read out of the link area. Reported, not
    // patched (wld.zag is a frozen file).
    if(g==7){ c=o_app(b,c," VOID_malformed_goal_nn4_3records"); }
    c=o_nl(b,c);
    vi=vi+1;
  }
  // V0 over the 7 well-formed goals only
  let vj:i32=0;
  let mism7:i32=0;
  let mm2:i32=0;
  while(vj<8){
    let g2:i32=get32(goals,vj*4);
    let skip:i32=0;
    if(g2==7){ skip=1; }
    mm2=0;
    if(skip==0){ mkLT3_goal(g2,G); mm2=fx_spec_mismatch(G,g2); }
    mism7=mism7+mm2;
    c=o_app(b,c,"V0chk g="); c=o_i64(b,c,g2 as i64);
    c=o_app(b,c," m="); c=o_i64(b,c,mm2 as i64);
    c=o_nl(b,c);
    vj=vj+1;
  }
  c=o_app(b,c,"S1 TOTALS V0specmismatch_all8="); c=o_i64(b,c,mism as i64);
  c=o_app(b,c," V0specmismatch_wellformed7="); c=o_i64(b,c,mism7 as i64);
  c=o_app(b,c," V2all="); c=o_i64(b,c,v2all as i64);
  c=o_nl(b,c);

  // ---------- GAP arenas ----------
  fx_copy_arena(GAP,AF);
  let gf:i32=fx_del_rel(GAP,1403);
  fx_copy_arena(GAP1,GAP);
  lt3_add(GAP1,100,1403,2403);
  c=o_app(b,c,"S1 GAP deleted="); c=o_i64(b,c,gf as i64);
  c=o_app(b,c," gaparena="); c=o_i64(b,c,get32(GAP,0) as i64);
  c=o_app(b,c," gap_contained_1403="); c=o_i64(b,c,fx_contained(GAP,1403,2403) as i64);
  c=o_app(b,c," gap1_contained_1403="); c=o_i64(b,c,fx_contained(GAP1,1403,2403) as i64);
  c=o_app(b,c," full_contained_1403="); c=o_i64(b,c,fx_contained(AF,1403,2403) as i64);
  c=o_nl(b,c);

  // ---------- S2 the 2x2 on the IDENTICAL gap arena ----------
  mkLT3_goal(5,G);
  ltLT3_decl(5,DE);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  c=fx_arm(b,c,"AGED_REB",L2,T2,GAP,G,5,DE);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,0);
  c=fx_arm(b,c,"AGED_STL",L2,T2,GAP,G,5,DE);
  fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,1);
  c=fx_arm(b,c,"COLD_REB_CONTAM",L2,T2,GAP,G,5,DE);
  fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,0);
  c=fx_arm(b,c,"COLD_STL",L2,T2,GAP,G,5,DE);
  fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,0);
  c=fx_arm(b,c,"NOVICE_EMPTY",L2,T2,EMP,G,5,DE);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  c=fx_arm(b,c,"AGED_FULL",L2,T2,AF,G,5,DE);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  c=fx_arm(b,c,"AGED_GAP1",L2,T2,GAP1,G,5,DE);

  // ---------- S4 V1 permutation invariance ----------
  let PA:[]u8=fx_new();
  let pm:i32=0;
  while(pm<3){
    fx_perm(GAP,pm,PA);
    fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
    let lb:[]u8=z_alloc(16);
    lb[0]=80; lb[1]=69; lb[2]=82; lb[3]=77; lb[4]=48+pm;
    c=fx_arm(b,c,lb,L2,T2,PA,G,5,DE);
    pm=pm+1;
  }

  // ---------- S5 DERIV ----------
  let DP:[]u8=z_alloc(64);
  let ndv:i32=fx_deriv_pred(DP);
  let reg:i32=fx_deriv_regular(AF);
  c=o_app(b,c,"S5 DERIV regular_full="); c=o_i64(b,c,reg as i64);
  c=o_app(b,c," stated_regularity_pred=");
  let pi:i32=0;
  while(pi<ndv){ c=o_i64(b,c,get32(DP,pi*4) as i64); pi=pi+1; }
  let NN5:[]u8=z_alloc(64);
  set32(NN5,0,4);
  let RC:[]u8=z_alloc(64);
  fx_recn(DE,NN5,RC);
  c=o_app(b,c," declared_recn=");
  pi=0;
  while(pi<get32(RC,0)){ c=o_i64(b,c,get32(RC,pi*4) as i64); pi=pi+1; }
  c=o_nl(b,c);
  let FB:[]u8=fx_new();
  fx_copy_arena(FB,AF);
  let add:i32=0;
  while(add<8){ lt3_add(FB,108+add,1402,2402); add=add+1; }
  let G4:[]u8=z_alloc(512);
  mkLT3_goal(4,G4);
  let OR1:[]u8=z_alloc(512);
  let h1:i32=lt_oracle(FB,G4,OR1,KB2);
  c=o_app(b,c,"S5 DERIV-FALSIFY wcount_1402_in_FB=");
  c=o_i64(b,c,fx_contained(FB,1402,2402) as i64);
  c=o_app(b,c," oracle_ran="); c=o_i64(b,c,h1 as i64);
  c=o_app(b,c," oracle_recn=");
  fx_recn(OR1,NN5,RC);
  pi=0;
  while(pi<get32(RC,0)){ c=o_i64(b,c,get32(RC,pi*4) as i64); pi=pi+1; }
  c=o_app(b,c," stated_regularity_says_12");
  c=o_nl(b,c);

  // ---------- S7 K12 PLAN keyed by declared tag or canonical shape tag ----------
  let G5:[]u8=z_alloc(512);
  let o1:i32=gq_b(G5,7600,4);
  o1=fx_need(G5,o1,1,2,1001,2001);
  o1=fx_need(G5,o1,2,4,1202,2202);
  o1=fx_need(G5,o1,3,4,1403,2403);
  o1=fx_need(G5,o1,4,3,1404,0);
  o1=gq_l(G5,o1,3);
  o1=fx_link(G5,o1,2,1,0,0,0,0);
  o1=fx_link(G5,o1,2,2,0,1,0,0);
  o1=fx_link(G5,o1,3,3,0,2,0,0);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  mkLT3_goal(5,G);
  let p0:i32=get32(L2,13224);
  c=fx_arm(b,c,"PLANQ_TAG7500",L2,T2,AF,G,5,DE);
  let p1:i32=get32(L2,13224);
  c=fx_arm(b,c,"PLANQ_TAG7600",L2,T2,AF,G5,5,DE);
  let p2:i32=get32(L2,13224);
  c=o_app(b,c,"S7 K12 plansbuilt_A="); c=o_i64(b,c,(p1-p0) as i64);
  c=o_app(b,c," plansbuilt_B="); c=o_i64(b,c,(p2-p1) as i64);
  c=o_nl(b,c);

  // ---------- S8 negative transfer ----------
  // THREE arms on the IDENTICAL arena: AGED (rebuild on), COLD_STL (zero state,
  // rebuild off -- the honest fresh learner) and COLD_REB (zero state, rebuild
  // ON -- the DECLARED CONTAMINATED cell, run here to test directly whether a
  // rebuild-on fresh arm is what made lane/p1mech's fresh row look competent).
  let RESA:[]u8=z_alloc(128);
  let RESC:[]u8=z_alloc(128);
  let RESX:[]u8=z_alloc(128);
  let DD:[]u8=z_alloc(64);
  let mst:i32=-1;
  let ord:i32=0;
  while(ord<3){
    let m:i32=1;
    while(m<=6){
      fx_zero(RESA,128);
      fx_zero(RESC,128);
      fx_zero(RESX,128);
      fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
      fx_nt_seq(L2,T2,AF,ord,m,RESA);
      fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,0);
      fx_nt_seq(L2,T2,AF,ord,m,RESC);
      fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,1);
      fx_nt_seq(L2,T2,AF,ord,m,RESX);
      let da:i32=0;
      let dc:i32=0;
      let dx:i32=0;
      let lost:i32=0;
      let j:i32=1;
      while(j<=m){
        if(get32(RESA,j*8+4)==0){ da=da+1; }
        if(get32(RESC,j*8+4)==0){ dc=dc+1; }
        if(get32(RESX,j*8+4)==0){ dx=dx+1; }
        if(get32(RESA,j*8+4)==0){ if(get32(RESC,j*8+4)==1){ lost=lost+1; } }
        j=j+1;
      }
      fx_ntdistinct(m,DD);
      c=o_app(b,c,"S8 ord="); c=o_i64(b,c,ord as i64);
      c=o_app(b,c," m="); c=o_i64(b,c,m as i64);
      c=o_app(b,c," distinctsig="); c=o_i64(b,c,get32(DD,0) as i64);
      c=o_app(b,c," aged_wrong="); c=o_i64(b,c,da as i64);
      c=o_app(b,c," coldstl_wrong="); c=o_i64(b,c,dc as i64);
      c=o_app(b,c," coldrb_wrong="); c=o_i64(b,c,dx as i64);
      c=o_app(b,c," K8lost="); c=o_i64(b,c,lost as i64);
      c=o_app(b,c," agedlostset=");
      let q:i32=1;
      while(q<=m){
        if(get32(RESA,q*8+4)==0){ if(get32(RESC,q*8+4)==1){ c=o_i64(b,c,q as i64); } }
        q=q+1;
      }
      c=o_app(b,c," ageddeclset=");
      q=1;
      while(q<=m){ if(get32(RESA,q*8)==0){ c=o_i64(b,c,q as i64); } q=q+1; }
      c=o_app(b,c," colddeclset=");
      q=1;
      while(q<=m){ if(get32(RESC,q*8)==0){ c=o_i64(b,c,q as i64); } q=q+1; }
      c=o_app(b,c," coldrbdeclset=");
      q=1;
      while(q<=m){ if(get32(RESX,q*8)==0){ c=o_i64(b,c,q as i64); } q=q+1; }
      c=o_app(b,c," aged_bindex="); c=o_i64(b,c,get32(T2,88) as i64);
      c=o_app(b,c," aged_poison="); c=o_i64(b,c,get32(T2,40) as i64);
      c=o_app(b,c," aged_mints="); c=o_i64(b,c,get32(T2,20) as i64);
      c=o_nl(b,c);
      if(ord==0){ if(lost>0){ if(mst<0){ mst=m; } } }
      m=m+1;
    }
    ord=ord+1;
  }
  c=o_app(b,c,"S8 K7K8 mstar="); c=o_i64(b,c,mst as i64);
  c=o_nl(b,c);
  // per-goal table at m=6, order 0, all three arms
  fx_zero(RESA,128); fx_zero(RESC,128); fx_zero(RESX,128);
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  fx_nt_seq(L2,T2,AF,0,6,RESA);
  fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,0);
  fx_nt_seq(L2,T2,AF,0,6,RESC);
  fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,1);
  fx_nt_seq(L2,T2,AF,0,6,RESX);
  let gp:i32=1;
  while(gp<=6){
    c=o_app(b,c,"S8 PERGOAL g="); c=o_i64(b,c,gp as i64);
    c=o_app(b,c," aged_code="); c=o_i64(b,c,get32(RESA,gp*8) as i64);
    c=o_app(b,c," aged_exact="); c=o_i64(b,c,get32(RESA,gp*8+4) as i64);
    c=o_app(b,c," aged_cost="); c=o_i64(b,c,get32(RESA,gp*8+8) as i64);
    c=o_app(b,c," coldstl_code="); c=o_i64(b,c,get32(RESC,gp*8) as i64);
    c=o_app(b,c," coldstl_exact="); c=o_i64(b,c,get32(RESC,gp*8+4) as i64);
    c=o_app(b,c," coldstl_cost="); c=o_i64(b,c,get32(RESC,gp*8+8) as i64);
    c=o_app(b,c," coldrb_code="); c=o_i64(b,c,get32(RESX,gp*8) as i64);
    c=o_app(b,c," coldrb_exact="); c=o_i64(b,c,get32(RESX,gp*8+4) as i64);
    c=o_nl(b,c);
    gp=gp+1;
  }

  // ---------- S8/K10 permanence: re-probe each shape twice ----------
  fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
  fx_zero(RESA,128);
  fx_nt_seq(L2,T2,AF,0,6,RESA);
  let perm:i32=0;
  while(perm<2){
    let rp:i32=1;
    while(rp<=6){
      let OO:[]u8=z_alloc(64);
      let cd:i32=fx_nt_one(L2,T2,AF,rp,OO);
      c=o_app(b,c,"S8 REPROBE pass="); c=o_i64(b,c,perm as i64);
      c=o_app(b,c," goal="); c=o_i64(b,c,rp as i64);
      c=o_app(b,c," firstpass="); c=o_i64(b,c,get32(RESA,rp*8) as i64);
      c=o_app(b,c," code="); c=o_i64(b,c,cd as i64);
      c=o_app(b,c," exact="); c=o_i64(b,c,get32(OO,4) as i64);
      c=o_app(b,c," bindex="); c=o_i64(b,c,get32(T2,88) as i64);
      c=o_nl(b,c);
      rp=rp+1;
    }
    perm=perm+1;
  }

  // ---------- S11 CALL-HISTORY INDEPENDENCE ----------
  // The S8 ord-loop and the S9 block run the IDENTICAL sequence from the
  // IDENTICAL pristine state and, in the first build, disagreed. Every
  // lt_query/lt_nt_seq call allocates its own scratch, so the two sites have
  // different heap layouts. If the outcome depends on the heap, then NO
  // aged-vs-cold comparison in this lane is trustworthy and the cause must be
  // found. Repeats the same sequence from the same pristine state with the
  // heap perturbed by a different amount each time.
  let RR:[]u8=z_alloc(128);
  let rep2:i32=0;
  while(rep2<4){
    let L4:[]u8=fx_new();
    let T4:[]u8=z_alloc(8192);
    let DUM:[]u8=z_alloc(4096+rep2*4096);
    let dz:i32=0;
    while(dz<rep2*1000){ DUM[dz]=65; dz=dz+1; }
    fx_copy(L4,SL,16384);
    fx_copy(T4,ST,8192);
    set32(T4,68,1);
    fx_zero(RR,128);
    fx_nt_seq(L4,T4,AF,0,6,RR);
    c=o_app(b,c,"S11 rep="); c=o_i64(b,c,rep2 as i64);
    c=o_app(b,c," dummybytes="); c=o_i64(b,c,(4096+rep2*4096) as i64);
    c=o_app(b,c," codes=");
    let z:i32=1;
    while(z<=6){ c=o_i64(b,c,get32(RR,z*8) as i64); z=z+1; }
    c=o_app(b,c," exacts=");
    z=1;
    while(z<=6){ c=o_i64(b,c,get32(RR,z*8+4) as i64); z=z+1; }
    c=o_nl(b,c);
    rep2=rep2+1;
  }

  // ---------- S9 K13 POIS ----------
  let L3:[]u8=fx_new();
  let T3:[]u8=z_alloc(8192);
  fx_copy(L3,SL,16384); fx_copy(T3,ST,8192); set32(T3,68,1);
  fx_zero(RESA,128);
  fx_nt_seq(L3,T3,AF,0,6,RESA);
  c=o_app(b,c,"S9 RESA_codes=");
  let z9:i32=1;
  while(z9<=6){ c=o_i64(b,c,get32(RESA,z9*8) as i64); z9=z9+1; }
  c=o_app(b,c," RESA_exacts=");
  z9=1;
  while(z9<=6){ c=o_i64(b,c,get32(RESA,z9*8+4) as i64); z9=z9+1; }
  c=o_nl(b,c);
  let nclr:i32=fx_clr_poison(T3);
  let rc:i32=0;
  let rp2:i32=1;
  while(rp2<=6){
    let OO:[]u8=z_alloc(64);
    let cd:i32=fx_nt_one(L3,T3,AF,rp2,OO);
    c=o_app(b,c,"S9 POIS goal="); c=o_i64(b,c,rp2 as i64);
    c=o_app(b,c," code_before="); c=o_i64(b,c,get32(RESA,rp2*8) as i64);
    c=o_app(b,c," code_after_clr="); c=o_i64(b,c,cd as i64);
    c=o_app(b,c," exact_after="); c=o_i64(b,c,get32(OO,4) as i64);
    c=o_app(b,c," bindex="); c=o_i64(b,c,get32(T3,88) as i64);
    c=o_nl(b,c);
    if(get32(OO,4)==1){ rc=rc+1; }
    rp2=rp2+1;
  }
  c=o_app(b,c,"S9 poisonbits_cleared="); c=o_i64(b,c,nclr as i64);
  c=o_app(b,c," recovered="); c=o_i64(b,c,rc as i64);
  c=o_nl(b,c);

  // ---------- S3 TTC-RESTORE ----------
  let RA:[]u8=fx_new();
  let ttcA:i32=-1;
  let ttcC:i32=-1;
  let rs:i32=0;
  while(rs<=8){
    fx_copy_arena(RA,GAP);
    let a2:i32=0;
    while(a2<rs){ lt3_add(RA,100+a2,1403,2403); a2=a2+1; }
    fx_copy(L2,SL,16384); fx_copy(T2,ST,8192); set32(T2,68,1);
    fx_zero(R2,128); fx_zero(K,64);
    let cdA:i32=lt_query(L2,T2,RA,G,K,R2,AN2);
    let okA:i32=lt_score(DE,AN2,cdA);
    let costA:i32=get32(R2,84);
    fx_zero(L2,16384); fx_zero(T2,8192); set32(T2,68,0);
    fx_zero(R2,128); fx_zero(K,64);
    let cdC:i32=lt_query(L2,T2,RA,G,K,R2,AN2);
    let okC:i32=lt_score(DE,AN2,cdC);
    let costC:i32=get32(R2,84);
    c=o_app(b,c,"S3 RESTORE n="); c=o_i64(b,c,rs as i64);
    c=o_app(b,c," aged_exact="); c=o_i64(b,c,okA as i64);
    c=o_app(b,c," aged_code="); c=o_i64(b,c,cdA as i64);
    c=o_app(b,c," aged_cost="); c=o_i64(b,c,costA as i64);
    c=o_app(b,c," cold_exact="); c=o_i64(b,c,okC as i64);
    c=o_app(b,c," cold_cost="); c=o_i64(b,c,costC as i64);
    c=o_nl(b,c);
    if(okA==1){ if(ttcA<0){ ttcA=rs; } }
    if(okC==1){ if(ttcC<0){ ttcC=rs; } }
    rs=rs+1;
  }
  c=o_app(b,c,"S3 TTC-RESTORE aged="); c=o_i64(b,c,ttcA as i64);
  c=o_app(b,c," cold="); c=o_i64(b,c,ttcC as i64);
  c=o_nl(b,c);

  _zag_print(b[0..c]);
  return 0;
}
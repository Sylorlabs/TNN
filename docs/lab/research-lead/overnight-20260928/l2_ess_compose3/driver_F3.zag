// driver_F3.zag -- L2-ESS-COMPOSE3 driver (five arms).
// The driver never names an operator, source pair, binding,
// pattern, or form: queries are (start,terminal,value,cap,
// dom) with one arm-level OP_MASK plus one arm-level standing
// mode (0=UNGATED, 1=STANDING, 2=GLOBAL). Standing cells,
// thresholds, signatures, and trace tags are learner-side
// only; the driver calls mr_standing_arm(st, mode) per arm.
// Kill bars KB-EFF/KB-CORR/KB-NOSKIP/KB-PROB/KB-SEAL/KB-DET
// per PREREG. The F-world (world_F.zag) is the [6,5,4,4]
// composition world from the l2_compose_chain4 lane.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=0; rs[1]=34; rs[2]=35; rs[3]=34; rs[4]=35; rs[5]=34; rs[6]=35;
  fs[0]=7; fs[1]=8; fs[2]=9; fs[3]=10; fs[4]=11; fs[5]=12; fs[6]=13;
  m_teach(st,rs,7,fs,7,70,77,1,1);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z4 (id 3): 3(1,7,90,97,1,1,29,26,27,3,4,0)
// rels[29,26,27,26,27,26,27] facts[15,16,17,18,19,20,21]
fn d_check_z4(st:[]u8)i32 {
  let o:i32=368+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=97){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=26; er[2]=27; er[3]=26; er[4]=27; er[5]=26; er[6]=27;
  let ef:[]u8=z_alloc(8);
  ef[0]=15; ef[1]=16; ef[2]=17; ef[3]=18; ef[4]=19; ef[5]=20; ef[6]=21;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z5 (id 4): 4(1,7,140,148,1,1,29,22,23,3,4,0)
// rels[29,22,23,22,23,22,23] facts[23,24,25,26,27,28,29]
fn d_check_z5(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=140){ok=0;}
  if((st[o+3] as i32)!=148){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=22; er[2]=23; er[3]=22; er[4]=23; er[5]=22; er[6]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=23; ef[1]=24; ef[2]=25; ef[3]=26; ef[4]=27; ef[5]=28; ef[6]=29;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z6 (id 5): 5(1,7,160,167,1,1,23,22,23,3,4,0)
// rels[23,22,23,22,23,22,29] facts[31,32,33,34,35,36,37]
fn d_check_z6(st:[]u8)i32 {
  let o:i32=368+5*40;

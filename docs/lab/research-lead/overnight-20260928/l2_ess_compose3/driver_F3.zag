}
// Z7 (id 6): 6(1,8,65,160,1,1,4,29,22,3,4,1)
// rels[4,29,22,23,22,23,22,23] facts[38,37,36,35,34,33,32,31]
fn d_check_z7(st:[]u8)i32 {
  let o:i32=368+6*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=8){ok=0;}
  if((st[o+2] as i32)!=65){ok=0;}
  if((st[o+3] as i32)!=160){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=4){ok=0;}
  if((st[o+35] as i32)!=29){ok=0;}
  if((st[o+36] as i32)!=22){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=1){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=4; er[1]=29; er[2]=22; er[3]=23; er[4]=22; er[5]=23; er[6]=22; er[7]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=38; ef[1]=37; ef[2]=36; ef[3]=35; ef[4]=34; ef[5]=33; ef[6]=32; ef[7]=31;
  let k:i32=0;
  while(k<8){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Issue one query; store via,val,op,tries,dec,phit,
// as,ae,entered at rs[ro..ro+32].
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}
// Probation world: 6 initial facts (2-fold chain 10->15, val
// 61) plus MAP id 0 (rels [21,22,23,22,23], facts [0..4],
// start 10 end 15 dom 1 cap 1). Strike queries are
// (10,990-k,61), unsolvable by design.
fn p_teach_initial(st:[]u8)void {
  f_teach(st,10,21,11);
  f_teach(st,11,22,12);
  f_teach(st,12,23,13);
  f_teach(st,13,22,14);
  f_teach(st,14,23,15);
  f_teach(st,15,4,61);
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=0; fs[1]=1; fs[2]=2; fs[3]=3; fs[4]=4;
  m_teach(st,rs,5,fs,5,10,15,1,1);
  return;
}
// Recovery facts: (10,23,20) (20,22,21) (21,23,22)
// (22,22,23) (23,23,24) (24,4,62). The (10,21,11) fact stays
// live. PQR = (10,24,62).
fn p_teach_recovery(st:[]u8)void {
  f_teach(st,10,23,20);
  f_teach(st,20,22,21);
  f_teach(st,21,23,22);
  f_teach(st,22,22,23);
  f_teach(st,23,23,24);
  f_teach(st,24,4,62);
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(262144);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM UNGATED (mode 0, mask 63) ----------
  let stU:[]u8=z_alloc(16384);
  d_teach_all(stU);
  mr_standing_arm(stU,0);
  ex_p(ob,atp,"ARM UNGATED\n");
  let rU:[]u8=z_alloc(360);
  d_runq(stU,ob,atp,20,25,51,1,1,63,"QA",rU,0);
  d_runq(stU,ob,atp,90,97,59,1,1,63,"QD1",rU,36);
  d_runq(stU,ob,atp,140,148,63,1,1,63,"QD2",rU,72);
  d_runq(stU,ob,atp,160,167,65,1,1,63,"QD3",rU,108);
  d_runq(stU,ob,atp,65,160,65,1,1,63,"QD4",rU,144);
  d_runq(stU,ob,atp,170,174,66,1,1,63,"QD5",rU,180);
  d_runq(stU,ob,atp,90,97,59,1,1,63,"QD1-B",rU,216);
  d_runq(stU,ob,atp,140,148,63,1,1,63,"QD2-B",rU,252);
  d_runq(stU,ob,atp,160,167,65,1,1,63,"QD3-B",rU,288);
  d_runq(stU,ob,atp,65,160,65,1,1,63,"QD4-B",rU,324);
  let u_qa_via:i32=get32(rU,0);
  let u_d1_via:i32=get32(rU,36);
  let u_d1_val:i32=get32(rU,40);
  let u_d1_op:i32=get32(rU,44);
  let u_d1_tries:i32=get32(rU,48);
  let u_d1_dec:i32=get32(rU,52);
  let u_d2_via:i32=get32(rU,72);
  let u_d2_val:i32=get32(rU,76);
  let u_d2_op:i32=get32(rU,80);
  let u_d2_tries:i32=get32(rU,84);
  let u_d2_dec:i32=get32(rU,88);
  let u_d3_via:i32=get32(rU,108);
  let u_d3_val:i32=get32(rU,112);
  let u_d3_op:i32=get32(rU,116);
  let u_d3_tries:i32=get32(rU,120);
  let u_d3_dec:i32=get32(rU,124);
  let u_d4_via:i32=get32(rU,144);
  let u_d4_val:i32=get32(rU,148);
  let u_d4_op:i32=get32(rU,152);
  let u_d4_tries:i32=get32(rU,156);
  let u_d4_dec:i32=get32(rU,160);
  let u_d5_via:i32=get32(rU,180);
  let u_d5_val:i32=get32(rU,184);
  let u_d5_op:i32=get32(rU,188);
  let u_d5_tries:i32=get32(rU,192);
  let u_d5_dec:i32=get32(rU,196);
  let u_b1_via:i32=get32(rU,216);
  let u_b1_val:i32=get32(rU,220);
  let u_b1_en:i32=get32(rU,248);
  let u_b2_via:i32=get32(rU,252);
  let u_b2_val:i32=get32(rU,256);
  let u_b2_en:i32=get32(rU,284);
  let u_b3_via:i32=get32(rU,288);
  let u_b3_val:i32=get32(rU,292);
  let u_b3_en:i32=get32(rU,320);
  let u_b4_via:i32=get32(rU,324);
  let u_b4_val:i32=get32(rU,328);
  let u_b4_en:i32=get32(rU,356);
  let u_z4:i32=d_check_z4(stU);
  let u_z5:i32=d_check_z5(stU);
  let u_z6:i32=d_check_z6(stU);
  let u_z7:i32=d_check_z7(stU);
  let u_sum:i32=u_d1_tries+u_d2_tries+u_d3_tries+u_d4_tries+u_d5_tries;
  ex_p(ob,atp,"ARM-UNGATED-END ");
  d_bar(ob,atp,"KB-ueff-sum",u_sum);
  d_bar(ob,atp,"KB-ucorr-qavia",u_qa_via);
  d_bar(ob,atp,"KB-ucorr-d1via",u_d1_via);
  d_bar(ob,atp,"KB-ucorr-d1val",u_d1_val);
  d_bar(ob,atp,"KB-ucorr-d1op",u_d1_op);
  d_bar(ob,atp,"KB-ucorr-d1tries",u_d1_tries);
  d_bar(ob,atp,"KB-ucorr-d1dec",u_d1_dec);
  d_bar(ob,atp,"KB-ucorr-d2via",u_d2_via);
  d_bar(ob,atp,"KB-ucorr-d2val",u_d2_val);
  d_bar(ob,atp,"KB-ucorr-d2op",u_d2_op);
  d_bar(ob,atp,"KB-ucorr-d2tries",u_d2_tries);
  d_bar(ob,atp,"KB-ucorr-d2dec",u_d2_dec);
  d_bar(ob,atp,"KB-ucorr-d3via",u_d3_via);
  d_bar(ob,atp,"KB-ucorr-d3val",u_d3_val);
  d_bar(ob,atp,"KB-ucorr-d3op",u_d3_op);
  d_bar(ob,atp,"KB-ucorr-d3tries",u_d3_tries);
  d_bar(ob,atp,"KB-ucorr-d3dec",u_d3_dec);
  d_bar(ob,atp,"KB-ucorr-d4via",u_d4_via);
  d_bar(ob,atp,"KB-ucorr-d4val",u_d4_val);
  d_bar(ob,atp,"KB-ucorr-d4op",u_d4_op);
  d_bar(ob,atp,"KB-ucorr-d4tries",u_d4_tries);
  d_bar(ob,atp,"KB-ucorr-d4dec",u_d4_dec);
  d_bar(ob,atp,"KB-ucorr-d5via",u_d5_via);
  d_bar(ob,atp,"KB-ucorr-d5val",u_d5_val);
  d_bar(ob,atp,"KB-ucorr-d5op",u_d5_op);
  d_bar(ob,atp,"KB-ucorr-d5tries",u_d5_tries);
  d_bar(ob,atp,"KB-ucorr-d5dec",u_d5_dec);
  d_bar(ob,atp,"KB-ucorr-z4",u_z4);
  d_bar(ob,atp,"KB-ucorr-z5",u_z5);
  d_bar(ob,atp,"KB-ucorr-z6",u_z6);
  d_bar(ob,atp,"KB-ucorr-z7",u_z7);
  d_bar(ob,atp,"KB-ucorr-b1via",u_b1_via);
  d_bar(ob,atp,"KB-ucorr-b1val",u_b1_val);
  d_bar(ob,atp,"KB-ucorr-b1en",u_b1_en);
  d_bar(ob,atp,"KB-ucorr-b2via",u_b2_via);
  d_bar(ob,atp,"KB-ucorr-b2val",u_b2_val);
  d_bar(ob,atp,"KB-ucorr-b2en",u_b2_en);
  d_bar(ob,atp,"KB-ucorr-b3via",u_b3_via);
  d_bar(ob,atp,"KB-ucorr-b3val",u_b3_val);
  d_bar(ob,atp,"KB-ucorr-b3en",u_b3_en);
  d_bar(ob,atp,"KB-ucorr-b4via",u_b4_via);
  d_bar(ob,atp,"KB-ucorr-b4val",u_b4_val);
  d_bar(ob,atp,"KB-ucorr-b4en",u_b4_en);
  ex_pnl(ob,atp);

  // ---------- ARM STANDING (mode 1, mask 63) ----------
  let stS:[]u8=z_alloc(16384);
  d_teach_all(stS);
  mr_standing_arm(stS,1);
  ex_p(ob,atp,"ARM STANDING\n");
  let rS:[]u8=z_alloc(360);
  d_runq(stS,ob,atp,20,25,51,1,1,63,"QA",rS,0);
  d_runq(stS,ob,atp,90,97,59,1,1,63,"QD1",rS,36);
  d_runq(stS,ob,atp,140,148,63,1,1,63,"QD2",rS,72);
  d_runq(stS,ob,atp,160,167,65,1,1,63,"QD3",rS,108);
  d_runq(stS,ob,atp,65,160,65,1,1,63,"QD4",rS,144);
  d_runq(stS,ob,atp,170,174,66,1,1,63,"QD5",rS,180);
  d_runq(stS,ob,atp,90,97,59,1,1,63,"QD1-B",rS,216);
  d_runq(stS,ob,atp,140,148,63,1,1,63,"QD2-B",rS,252);
  d_runq(stS,ob,atp,160,167,65,1,1,63,"QD3-B",rS,288);
  d_runq(stS,ob,atp,65,160,65,1,1,63,"QD4-B",rS,324);
  let s_qa_via:i32=get32(rS,0);
  let s_d1_via:i32=get32(rS,36);
  let s_d1_val:i32=get32(rS,40);
  let s_d1_op:i32=get32(rS,44);
  let s_d1_tries:i32=get32(rS,48);
  let s_d1_dec:i32=get32(rS,52);
  let s_d2_via:i32=get32(rS,72);
  let s_d2_val:i32=get32(rS,76);
  let s_d2_op:i32=get32(rS,80);
  let s_d2_tries:i32=get32(rS,84);
  let s_d2_dec:i32=get32(rS,88);
  let s_d3_via:i32=get32(rS,108);
  let s_d3_val:i32=get32(rS,112);
  let s_d3_op:i32=get32(rS,116);
  let s_d3_tries:i32=get32(rS,120);
  let s_d3_dec:i32=get32(rS,124);
  let s_d4_via:i32=get32(rS,144);
  let s_d4_val:i32=get32(rS,148);
  let s_d4_op:i32=get32(rS,152);
  let s_d4_tries:i32=get32(rS,156);
  let s_d4_dec:i32=get32(rS,160);
  let s_d5_via:i32=get32(rS,180);
  let s_d5_val:i32=get32(rS,184);
  let s_d5_op:i32=get32(rS,188);
  let s_d5_tries:i32=get32(rS,192);
  let s_d5_dec:i32=get32(rS,196);
  let s_b1_via:i32=get32(rS,216);
  let s_b1_val:i32=get32(rS,220);
  let s_b1_en:i32=get32(rS,248);
  let s_b2_via:i32=get32(rS,252);
  let s_b2_val:i32=get32(rS,256);
  let s_b2_en:i32=get32(rS,284);
  let s_b3_via:i32=get32(rS,288);
  let s_b3_val:i32=get32(rS,292);
  let s_b3_en:i32=get32(rS,320);
  let s_b4_via:i32=get32(rS,324);
  let s_b4_val:i32=get32(rS,328);
  let s_b4_en:i32=get32(rS,356);
  let s_z4:i32=d_check_z4(stS);
  let s_z5:i32=d_check_z5(stS);
  let s_z6:i32=d_check_z6(stS);
  let s_z7:i32=d_check_z7(stS);
  let s_sum:i32=s_d1_tries+s_d2_tries+s_d3_tries+s_d4_tries+s_d5_tries;
  ex_p(ob,atp,"ARM-STANDING-END ");
  d_bar(ob,atp,"KB-seff-sum",s_sum);
  d_bar(ob,atp,"KB-scorr-qavia",s_qa_via);
  d_bar(ob,atp,"KB-scorr-d1via",s_d1_via);
  d_bar(ob,atp,"KB-scorr-d1val",s_d1_val);
  d_bar(ob,atp,"KB-scorr-d1op",s_d1_op);
  d_bar(ob,atp,"KB-scorr-d1tries",s_d1_tries);
  d_bar(ob,atp,"KB-scorr-d1dec",s_d1_dec);
  d_bar(ob,atp,"KB-scorr-d2via",s_d2_via);
  d_bar(ob,atp,"KB-scorr-d2val",s_d2_val);
  d_bar(ob,atp,"KB-scorr-d2op",s_d2_op);
  d_bar(ob,atp,"KB-scorr-d2tries",s_d2_tries);
  d_bar(ob,atp,"KB-scorr-d2dec",s_d2_dec);
  d_bar(ob,atp,"KB-scorr-d3via",s_d3_via);
  d_bar(ob,atp,"KB-scorr-d3val",s_d3_val);
  d_bar(ob,atp,"KB-scorr-d3op",s_d3_op);
  d_bar(ob,atp,"KB-scorr-d3tries",s_d3_tries);
  d_bar(ob,atp,"KB-scorr-d3dec",s_d3_dec);
  d_bar(ob,atp,"KB-scorr-d4via",s_d4_via);
  d_bar(ob,atp,"KB-scorr-d4val",s_d4_val);
  d_bar(ob,atp,"KB-scorr-d4op",s_d4_op);
  d_bar(ob,atp,"KB-scorr-d4tries",s_d4_tries);
  d_bar(ob,atp,"KB-scorr-d4dec",s_d4_dec);
  d_bar(ob,atp,"KB-scorr-d5via",s_d5_via);
  d_bar(ob,atp,"KB-scorr-d5val",s_d5_val);
  d_bar(ob,atp,"KB-scorr-d5op",s_d5_op);
  d_bar(ob,atp,"KB-scorr-d5tries",s_d5_tries);
  d_bar(ob,atp,"KB-scorr-d5dec",s_d5_dec);
  d_bar(ob,atp,"KB-scorr-z4",s_z4);
  d_bar(ob,atp,"KB-scorr-z5",s_z5);
  d_bar(ob,atp,"KB-scorr-z6",s_z6);
  d_bar(ob,atp,"KB-scorr-z7",s_z7);
  d_bar(ob,atp,"KB-scorr-b1via",s_b1_via);
  d_bar(ob,atp,"KB-scorr-b1val",s_b1_val);
  d_bar(ob,atp,"KB-scorr-b1en",s_b1_en);
  d_bar(ob,atp,"KB-scorr-b2via",s_b2_via);
  d_bar(ob,atp,"KB-scorr-b2val",s_b2_val);
  d_bar(ob,atp,"KB-scorr-b2en",s_b2_en);
  d_bar(ob,atp,"KB-scorr-b3via",s_b3_via);
  d_bar(ob,atp,"KB-scorr-b3val",s_b3_val);
  d_bar(ob,atp,"KB-scorr-b3en",s_b3_en);
  d_bar(ob,atp,"KB-scorr-b4via",s_b4_via);
  d_bar(ob,atp,"KB-scorr-b4val",s_b4_val);
  d_bar(ob,atp,"KB-scorr-b4en",s_b4_en);
  ex_pnl(ob,atp);

  // ---------- ARM GLOBAL (mode 2, mask 63; informational) ----------
  let stG:[]u8=z_alloc(16384);
  d_teach_all(stG);
  mr_standing_arm(stG,2);
  ex_p(ob,atp,"ARM GLOBAL\n");
  let rG:[]u8=z_alloc(360);
  d_runq(stG,ob,atp,20,25,51,1,1,63,"QA",rG,0);
  d_runq(stG,ob,atp,90,97,59,1,1,63,"QD1",rG,36);
  d_runq(stG,ob,atp,140,148,63,1,1,63,"QD2",rG,72);
  d_runq(stG,ob,atp,160,167,65,1,1,63,"QD3",rG,108);
  d_runq(stG,ob,atp,65,160,65,1,1,63,"QD4",rG,144);
  d_runq(stG,ob,atp,170,174,66,1,1,63,"QD5",rG,180);
  let g_d1_via:i32=get32(rG,36);
  let g_d1_val:i32=get32(rG,40);
  let g_d1_op:i32=get32(rG,44);
  let g_d1_tries:i32=get32(rG,48);
  let g_d2_val:i32=get32(rG,76);
  let g_d2_op:i32=get32(rG,80);
  let g_d2_tries:i32=get32(rG,84);
  let g_d3_val:i32=get32(rG,112);
  let g_d3_op:i32=get32(rG,116);
  let g_d3_tries:i32=get32(rG,120);
  let g_d4_val:i32=get32(rG,148);
  let g_d4_op:i32=get32(rG,152);
  let g_d4_tries:i32=get32(rG,156);
  let g_d5_val:i32=get32(rG,184);
  let g_d5_op:i32=get32(rG,188);
  let g_d5_tries:i32=get32(rG,192);
  let g_sum:i32=g_d1_tries+g_d2_tries+g_d3_tries+g_d4_tries+g_d5_tries;
  ex_p(ob,atp,"ARM-GLOBAL-END ");
  d_bar(ob,atp,"KB-ginfo-sum",g_sum);
  d_bar(ob,atp,"KB-ginfo-d1via",g_d1_via);
  d_bar(ob,atp,"KB-ginfo-d1val",g_d1_val);
  d_bar(ob,atp,"KB-ginfo-d1op",g_d1_op);
  d_bar(ob,atp,"KB-ginfo-d2val",g_d2_val);
  d_bar(ob,atp,"KB-ginfo-d2op",g_d2_op);
  d_bar(ob,atp,"KB-ginfo-d2tries",g_d2_tries);
  d_bar(ob,atp,"KB-ginfo-d3val",g_d3_val);
  d_bar(ob,atp,"KB-ginfo-d3op",g_d3_op);
  d_bar(ob,atp,"KB-ginfo-d4val",g_d4_val);
  d_bar(ob,atp,"KB-ginfo-d4op",g_d4_op);
  d_bar(ob,atp,"KB-ginfo-d5val",g_d5_val);
  d_bar(ob,atp,"KB-ginfo-d5op",g_d5_op);
  ex_pnl(ob,atp);

  // ---------- ARM PROB-UNG (mode 0): probation world ----------
  let stP:[]u8=z_alloc(16384);
  p_teach_initial(stP);
  mr_standing_arm(stP,0);
  ex_p(ob,atp,"ARM PROB-UNG\n");
  let rP:[]u8=z_alloc(288);
  d_runq(stP,ob,atp,10,990,61,1,1,63,"PQ1",rP,0);
  d_runq(stP,ob,atp,10,989,61,1,1,63,"PQ2",rP,36);
  d_runq(stP,ob,atp,10,988,61,1,1,63,"PQ3",rP,72);
  d_runq(stP,ob,atp,10,987,61,1,1,63,"PQ4",rP,108);
  d_runq(stP,ob,atp,10,986,61,1,1,63,"PQ5",rP,144);
  d_runq(stP,ob,atp,10,985,61,1,1,63,"PQ6",rP,180);
  d_runq(stP,ob,atp,10,984,61,1,1,63,"PQ7",rP,216);
  p_teach_recovery(stP);
  d_runq(stP,ob,atp,10,24,62,1,1,63,"PQR",rP,252);
  let p_pq1_val:i32=get32(rP,4);
  let p_pq7_val:i32=get32(rP,220);
  let p_pqr_val:i32=get32(rP,256);
  let p_pqr_op:i32=get32(rP,260);
  ex_p(ob,atp,"ARM-PROB-UNG-END ");
  d_bar(ob,atp,"KB-puprob-pq1val",p_pq1_val);
  d_bar(ob,atp,"KB-puprob-pq7val",p_pq7_val);
  d_bar(ob,atp,"KB-puprob-pqrval",p_pqr_val);
  d_bar(ob,atp,"KB-puprob-pqrop",p_pqr_op);
  ex_pnl(ob,atp);

  // ---------- ARM PROB (mode 1): probation world ----------
  let stQ:[]u8=z_alloc(16384);
  p_teach_initial(stQ);
  mr_standing_arm(stQ,1);
  ex_p(ob,atp,"ARM PROB\n");
  let rQ:[]u8=z_alloc(288);
  d_runq(stQ,ob,atp,10,990,61,1,1,63,"PQ1",rQ,0);
  d_runq(stQ,ob,atp,10,989,61,1,1,63,"PQ2",rQ,36);
  d_runq(stQ,ob,atp,10,988,61,1,1,63,"PQ3",rQ,72);
  d_runq(stQ,ob,atp,10,987,61,1,1,63,"PQ4",rQ,108);
  d_runq(stQ,ob,atp,10,986,61,1,1,63,"PQ5",rQ,144);
  d_runq(stQ,ob,atp,10,985,61,1,1,63,"PQ6",rQ,180);
  d_runq(stQ,ob,atp,10,984,61,1,1,63,"PQ7",rQ,216);
  p_teach_recovery(stQ);
  d_runq(stQ,ob,atp,10,24,62,1,1,63,"PQR",rQ,252);
  let q_pq1_val:i32=get32(rQ,4);
  let q_pq7_val:i32=get32(rQ,220);
  let q_pqr_val:i32=get32(rQ,256);
  let q_pqr_op:i32=get32(rQ,260);
  ex_p(ob,atp,"ARM-PROB-END ");
  d_bar(ob,atp,"KB-pprob-pq1val",q_pq1_val);
  d_bar(ob,atp,"KB-pprob-pq7val",q_pq7_val);
  d_bar(ob,atp,"KB-pprob-pqrval",q_pqr_val);
  d_bar(ob,atp,"KB-pprob-pqrop",q_pqr_op);
  ex_pnl(ob,atp);

  // ---------- in-Zag falsifiers (PREREG sections 5-7) ----------
  let ff:i32=0;
  // UNGATED reproduces chain4 F signatures
  if(u_qa_via!=1){ff=ff+1;}
  if(u_d1_via!=3){ff=ff+1;}
  if(u_d1_val!=59){ff=ff+1;}
  if(u_d1_op!=6){ff=ff+1;}
  if(u_d1_tries!=6){ff=ff+1;}
  if(u_d1_dec!=1){ff=ff+1;}
  if(u_z4!=1){ff=ff+1;}
  if(u_d2_via!=4){ff=ff+1;}
  if(u_d2_val!=63){ff=ff+1;}
  if(u_d2_op!=5){ff=ff+1;}
  if(u_d2_tries!=11){ff=ff+1;}
  if(u_d2_dec!=1){ff=ff+1;}
  if(u_z5!=1){ff=ff+1;}
  if(u_d3_via!=5){ff=ff+1;}
  if(u_d3_val!=65){ff=ff+1;}
  if(u_d3_op!=4){ff=ff+1;}
  if(u_d3_tries!=16){ff=ff+1;}
  if(u_d3_dec!=1){ff=ff+1;}
  if(u_z6!=1){ff=ff+1;}
  if(u_d4_via!=6){ff=ff+1;}
  if(u_d4_val!=65){ff=ff+1;}
  if(u_d4_op!=4){ff=ff+1;}
  if(u_d4_tries!=22){ff=ff+1;}
  if(u_d4_dec!=1){ff=ff+1;}
  if(u_z7!=1){ff=ff+1;}
  if(u_d5_val!=-2){ff=ff+1;}
  if(u_d5_op!=-1){ff=ff+1;}
  if(u_d5_tries!=30){ff=ff+1;}
  if(u_d5_dec!=0){ff=ff+1;}
  if(u_b1_via!=3){ff=ff+1;}
  if(u_b1_val!=59){ff=ff+1;}
  if(u_b1_en!=0){ff=ff+1;}
  if(u_b2_via!=4){ff=ff+1;}
  if(u_b2_val!=63){ff=ff+1;}
  if(u_b2_en!=0){ff=ff+1;}
  if(u_b3_via!=5){ff=ff+1;}
  if(u_b3_val!=65){ff=ff+1;}
  if(u_b3_en!=0){ff=ff+1;}
  if(u_b4_via!=6){ff=ff+1;}
  if(u_b4_val!=65){ff=ff+1;}
  if(u_b4_en!=0){ff=ff+1;}
  if(u_sum!=85){ff=ff+1;}
  // STANDING: correctness identical to UNGATED
  if(s_qa_via!=u_qa_via){ff=ff+1;}
  if(s_d1_via!=u_d1_via){ff=ff+1;}
  if(s_d1_val!=u_d1_val){ff=ff+1;}
  if(s_d1_op!=u_d1_op){ff=ff+1;}
  if(s_d1_dec!=u_d1_dec){ff=ff+1;}
  if(s_z4!=1){ff=ff+1;}
  if(s_d2_via!=u_d2_via){ff=ff+1;}
  if(s_d2_val!=u_d2_val){ff=ff+1;}
  if(s_d2_op!=u_d2_op){ff=ff+1;}
  if(s_d2_dec!=u_d2_dec){ff=ff+1;}
  if(s_z5!=1){ff=ff+1;}
  if(s_d3_via!=u_d3_via){ff=ff+1;}
  if(s_d3_val!=u_d3_val){ff=ff+1;}
  if(s_d3_op!=u_d3_op){ff=ff+1;}
  if(s_d3_dec!=u_d3_dec){ff=ff+1;}
  if(s_z6!=1){ff=ff+1;}
  if(s_d4_via!=u_d4_via){ff=ff+1;}
  if(s_d4_val!=u_d4_val){ff=ff+1;}
  if(s_d4_op!=u_d4_op){ff=ff+1;}
  if(s_d4_dec!=u_d4_dec){ff=ff+1;}
  if(s_z7!=1){ff=ff+1;}
  if(s_d5_via!=u_d5_via){ff=ff+1;}
  if(s_d5_val!=u_d5_val){ff=ff+1;}
  if(s_d5_op!=u_d5_op){ff=ff+1;}
  if(s_d5_dec!=u_d5_dec){ff=ff+1;}
  if(s_b1_via!=u_b1_via){ff=ff+1;}
  if(s_b1_val!=u_b1_val){ff=ff+1;}
  if(s_b1_en!=u_b1_en){ff=ff+1;}
  if(s_b2_via!=u_b2_via){ff=ff+1;}
  if(s_b2_val!=u_b2_val){ff=ff+1;}
  if(s_b2_en!=u_b2_en){ff=ff+1;}
  if(s_b3_via!=u_b3_via){ff=ff+1;}
  if(s_b3_val!=u_b3_val){ff=ff+1;}
  if(s_b3_en!=u_b3_en){ff=ff+1;}
  if(s_b4_via!=u_b4_via){ff=ff+1;}
  if(s_b4_val!=u_b4_val){ff=ff+1;}
  if(s_b4_en!=u_b4_en){ff=ff+1;}
  // STANDING: predicted efficiency signature
  if(s_d1_tries!=6){ff=ff+1;}
  if(s_d2_tries!=6){ff=ff+1;}
  if(s_d3_tries!=11){ff=ff+1;}
  if(s_d4_tries!=8){ff=ff+1;}
  if(s_d5_tries!=13){ff=ff+1;}
  if(s_sum!=44){ff=ff+1;}
  // KB-EFF: standing beats ungated by >= 10
  if(s_sum>=u_sum){ff=ff+1;}
  if((u_sum-s_sum)<10){ff=ff+1;}
  // KB-PROB
  if(p_pq1_val!=-2){ff=ff+1;}
  if(p_pq7_val!=-2){ff=ff+1;}
  if(p_pqr_val!=62){ff=ff+1;}
  if(p_pqr_op!=2){ff=ff+1;}
  if(q_pq1_val!=-2){ff=ff+1;}
  if(q_pq7_val!=-2){ff=ff+1;}
  if(q_pqr_val!=62){ff=ff+1;}
  if(q_pqr_op!=2){ff=ff+1;}
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"COMP-F3-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

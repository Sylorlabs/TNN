// Issue one query; store via,val,op,tries,dec,phit,
// as,ae,entered at rs[ro..ro+32].
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}
// Probation world: 6 initial facts (2-fold chain 10->15, val
// 61) plus MAP id 0 (rels [21,22,23,22,23], facts [0..4],
// start 10 end 15 dom 1 cap 1). Strike queries are
// (10,990-k,61), unsolvable by design.
fn p_teach_initial(st:[]u8)void {
  f_teach(st,10,21,11);
  f_teach(st,11,22,12);
  f_teach(st,12,23,13);
  f_teach(st,13,22,14);
  f_teach(st,14,23,15);
  f_teach(st,15,4,61);
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=0; fs[1]=1; fs[2]=2; fs[3]=3; fs[4]=4;
  m_teach(st,rs,5,fs,5,10,15,1,1);
  return;
}
// Recovery facts: (10,23,20) (20,22,21) (21,23,22)
// (22,22,23) (23,23,24) (24,4,62). The (10,21,11) fact stays
// live. PQR = (10,24,62).
fn p_teach_recovery(st:[]u8)void {
  f_teach(st,10,23,20);
  f_teach(st,20,22,21);
  f_teach(st,21,23,22);
  f_teach(st,22,22,23);
  f_teach(st,23,23,24);
  f_teach(st,24,4,62);
  return;
}


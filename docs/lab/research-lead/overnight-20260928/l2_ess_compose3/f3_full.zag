  let ef:[]u8=z_alloc(8);
  ef[0]=23; ef[1]=24; ef[2]=25; ef[3]=26; ef[4]=27; ef[5]=28; ef[6]=29;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}

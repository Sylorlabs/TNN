  c=appn(T,c," 12 1 2 12 16 0 -1 0 0 0 19 0 1")
  c=appn(T,c," 12 2 0 -1 17 0 -1 -1 0 0 20 0 1")
  c=appn(T,c," 15 2 1 13 18 0 2 -1 2 1 21 0 1 1 1 2")
  c=appn(T,c," 15 2 1 14 19 0 2 -1 2 1 22 0 1 1 8001 0")
  c=appn(T,c," 23 2 1 15 20 0 2 -1 8 3 23 0 1 2 3 2 2 3 2 1 1 2 3 5")
  c=appn(T,c," 21 2 1 16 21 0 2 -1 6 3 24 0 1 1 7201 1 7301 1 1 2 2 5")

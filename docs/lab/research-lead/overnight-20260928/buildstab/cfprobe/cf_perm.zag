// c5_base.zag -- base for the cogops-cycles battery.
// = c4_base.zag (cogops-diamond) with ONE capacity change: the fact
// store holds 128 facts (was 64), because world C holds 72 facts.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the three researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE), vfy_gen (id 1, VERIFY),
// cnt_gen (id 4, COUNT).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_print(b[0..c]);
  return;
}
// ---- world arena: 0: nf; 4: facts, 128 * 12 bytes (s, r, o) ----
// (c5: capacity raised 64 -> 128 facts; world C holds 72. Behavior on
// <= 64 facts is unchanged; the diamond regression verifies this.)
fn world_new()[]u8 { return z_alloc(4096); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<128){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// Distinct-object count: for each subject in sb[so..], scans ALL facts
// and collects distinct objects o with (subj, rel, o). Returns the
// distinct count. Cost = nsubs * nfacts fact checks (dedup compares
// not counted). seen: scratch [nseen, objs...], reset on entry.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let nf:i32=get32(A,0);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<64){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// cf_engine.zag -- GENERIC ENGINE for the CORE-FREEZE battery.
//
// CONTAINS ZERO world relation ids, ZERO goal tags, ZERO need tags.
// Its entire vocabulary is: table indices, the three seed procedure
// families the frozen core itself defines (episode kind 0/1/2), and four
// dispatch modes (0 episodes, 1 compose_iter, 2 osc_handle, 3 plan_drop).
// Every world fact, every goal record and every expected value arrives as
// DATA from cf_data.zag.
//
// CONCATENATION ORDER: cf_base, cf_data, c8_learn, hq_module, cf_engine.
// The engine is LAST because Zag has no forward declarations and main
// must call frozen-core functions. No frozen byte is altered.
//
// KILL BAR K-A (PREREG section 2): verified by grep at end of wave.

fn zzero(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return;
}
fn p_i(b:[]u8,c:i32,v:i32)i32 { return o_i64(b,c,v as i64); }
fn p_ivs(b:[]u8,c:i32,src:[]u8,off:i32,n:i32)i32 {
  let r:i32=o_i64(b,c,n as i64);
  r=o_app(b,r,":");
  let k:i32=0;
  while(k<n){
    if(k>0){ r=o_app(b,r,","); }
    r=o_i64(b,r,get32(src,off+k*4) as i64);
    k=k+1;
  }
  return r;
}
fn p_na(b:[]u8,c:i32,src:[]u8,off:i32,n:i32,md:i32)i32 {
  if(md==1){ return p_ivs(b,c,src,off,n); }
  return o_app(b,c,"na");
}
fn p_lab(b:[]u8,c:i32,LB:[]u8,i:i32)i32 {
  let ln:i32=get32(LB,i*64);
  let r:i32=o_app(b,c,LB[i*64+4 .. i*64+4+ln]);
  return r;
}
// compare n bare ints (case-row expectations carry no length prefix)
fn eqbare(src:[]u8,off:i32,n:i32,exp:[]u8,eo:i32)i32 {
  let k:i32=0;
  while(k<n){
    if(get32(src,off+k*4)!=get32(exp,eo+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
fn buildw(WA:[]u8,FA:[]u8,A:[]u8,w:i32)void {
  set32(A,0,0);
  let fs:i32=get32(WA,4+w*24+0);
  let nf:i32=get32(WA,4+w*24+4);
  let k:i32=0;
  while(k<nf){
    fact_add(A,get32(FA,4+(fs+k)*12),get32(FA,4+(fs+k)*12+4),get32(FA,4+(fs+k)*12+8));
    k=k+1;
  }
  return;
}
fn buildg(GA:[]u8,GO:[]u8,G:[]u8,gi:i32)void {
  let gs:i32=get32(GO,4+gi*4);
  let ge:i32=get32(GO,4+(gi+1)*4);
  let q:i32=0;
  while(q<ge-gs){
    set32(G,q*4,get32(GA,(gs+q)*4));
    q=q+1;
  }
  return;
}
fn runeps(WA:[]u8,EA:[]u8,L:[]u8,A:[]u8,K:[]u8,C:[]u8,tout:[]u8,seen:[]u8,w:i32)void {
  let es:i32=get32(WA,4+w*24+8);
  let ne:i32=get32(WA,4+w*24+12);
  let e:i32=0;
  while(e<ne){
    let ei:i32=es+e;
    let b0:i32=4+ei*48;
    let kd:i32=get32(EA,b0);
    if(kd==0){ ret_episode(L,A,get32(EA,b0+4),get32(EA,b0+8),K,tout); }
    if(kd==1){
      chain_clear(C);
      let ns:i32=get32(EA,b0+12);
      let st:i32=0;
      while(st<ns){
        chain_add(C,get32(EA,b0+16+st*12),get32(EA,b0+16+st*12+4),get32(EA,b0+16+st*12+8));
        st=st+1;
      }
      vfy_episode(L,A,C,K);
    }
    if(kd==2){ cnt_episode(L,A,get32(EA,b0+4),get32(EA,b0+8),K,tout,seen); }
    e=e+1;
  }
  specialize_ret(L,A,es,es+ne);
  specialize_vfy(L,A,es,es+ne);
  specialize_cnt(L,A,es,es+ne);
  return;
}
// The frozen core emits answer records and per-step versions in PLAN order
// (the order topo_g computed), not need-index order. PREREG expected
// values are written in need-index order. Reorder both into need order so
// the competence check is order-insensitive; RK keeps the plan order.
fn reorder(L:[]u8,G:[]u8,ans:[]u8,vbuf:[]u8,A2:[]u8,V2:[]u8,RK:[]u8,RS:[]u8,base:i32)i32 {
  let nn:i32=0;
  let pi:i32=plan_find(L,g_tag(G));
  if(pi>=0){ nn=get32(L,13000+pi*56+4); }
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    set32(RK,ni*4,p);
    p=p+1;
  }
  let tot:i32=get32(ans,0);
  let endb:i32=4+tot*4;
  let cur:i32=4;
  p=0;
  while(p<nn){
    set32(RS,p*4,cur);
    if(cur<endb){ cur=cur+(1+get32(ans,cur))*4; }
    else{ cur=endb; }
    p=p+1;
  }
  let n2:i32=0;
  while(n2<nn){
    let pp:i32=get32(RK,n2*4);
    let st:i32=get32(RS,pp*4);
    let ln3:i32=0;
    if(st<endb){ ln3=get32(ans,st); }
    if(ln3>32){ ln3=32; }
    let k3:i32=0;
    while(k3<=ln3){
      set32(A2,(base+k3)*4,get32(ans,st+k3*4));
      k3=k3+1;
    }
    set32(V2,n2*4,get32(vbuf,pp*4));
    n2=n2+1;
  }
  return nn;
}
// rec[] layout: 0 occ,1 seg,2 lab,3 w,4 md,5 rc,6 how,7 cost,8 alen_o,
//              9 nn,10 ma,11 mv,12 mh,13 mrs,14 a2off
fn p_case(T:[]u8,c0:i32,rec:[]u8,LB:[]u8,L:[]u8,A2:[]u8,V2:[]u8,RK:[]u8)i32 {
  let c:i32=c0;
  let md:i32=get32(rec,16);
  let nn:i32=get32(rec,36);
  c=o_app(T,c,"CASE occ=");
  c=p_i(T,c,get32(rec,0));
  c=o_app(T,c," s=");
  c=p_i(T,c,get32(rec,4));
  c=o_app(T,c," lab=");
  c=p_lab(T,c,LB,get32(rec,8));
  c=o_app(T,c," w=");
  c=p_i(T,c,get32(rec,12));
  c=o_app(T,c," m=");
  c=p_i(T,c,md);
  c=o_app(T,c," rc=");
  c=p_i(T,c,get32(rec,20));
  c=o_app(T,c," how=");
  c=p_i(T,c,get32(rec,24));
  c=o_app(T,c," ans=");
  c=p_na(T,c,A2,get32(rec,56),get32(rec,32),md);
  c=o_app(T,c," ver=");
  c=p_na(T,c,V2,0,nn,md);
  c=o_app(T,c," porder=");
  c=p_na(T,c,RK,0,nn,md);
  c=o_app(T,c," np=");
  c=p_i(T,c,get32(rec,80));
  c=o_app(T,c," cost=");
  c=p_i(T,c,get32(rec,28));
  c=o_app(T,c," pb=");
  c=p_i(T,c,get32(L,13224));
  c=o_app(T,c," pl=");
  c=p_i(T,c,get32(L,13228));
  c=o_app(T,c," tr=");
  c=p_i(T,c,get32(L,13232));
  c=o_app(T,c," de=");
  c=p_i(T,c,get32(L,13236));
  c=o_app(T,c," nr=");
  c=p_i(T,c,get32(L,0));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,4248));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,8496));
  c=o_app(T,c," rv=");
  c=p_i(T,c,get32(L,4244));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,8492));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,12740));
  c=o_app(T,c," us=");
  c=p_i(T,c,get32(L,13252));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13256));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13260));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13264));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13268));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13272));
  c=o_app(T,c," MA=");
  c=p_i(T,c,get32(rec,40));
  c=o_app(T,c," MV=");
  c=p_i(T,c,get32(rec,44));
  c=o_app(T,c," MH=");
  c=p_i(T,c,get32(rec,48));
  c=o_app(T,c," MR=");
  c=p_i(T,c,get32(rec,52));
  return c;
}
// SM layout: 0 goals,1 MA1,2 MA0,3 MV1,4 MV0,5 MH1,6 MH0,7 MR1,8 MR0,
//             9 REFn,10 COST,11 FINALn,12 FINALans,13 FINALver1,14 FINALver0
fn p_seg(T:[]u8,c0:i32,SM:[]u8,s:i32,L:[]u8)i32 {
  let c:i32=c0;
  c=o_app(T,c,"BARSEG s=");
  c=p_i(T,c,s);
  c=o_app(T,c," G=");
  c=p_i(T,c,get32(SM,0));
  c=o_app(T,c," MA=");
  c=p_i(T,c,get32(SM,4));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,4)+get32(SM,8));
  c=o_app(T,c," MV=");
  c=p_i(T,c,get32(SM,12));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,12)+get32(SM,16));
  c=o_app(T,c," MH=");
  c=p_i(T,c,get32(SM,20));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,20)+get32(SM,24));
  c=o_app(T,c," MR=");
  c=p_i(T,c,get32(SM,28));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,28)+get32(SM,32));
  c=o_app(T,c," REFn=");
  c=p_i(T,c,get32(SM,36));
  c=o_app(T,c," COST=");
  c=p_i(T,c,get32(SM,40));
  c=o_app(T,c," FINALans=");
  c=p_i(T,c,get32(SM,48));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,44));
  c=o_app(T,c," FINALver=");
  c=p_i(T,c,get32(SM,52));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(SM,44));
  c=o_app(T,c," L=");
  c=p_i(T,c,get32(L,13224));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13228));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13232));
  c=o_app(T,c,"/");
  c=p_i(T,c,get32(L,13236));
  return c;
}

fn main()i32 {
  let T:[]u8=z_alloc(262144);
  let WA:[]u8=z_alloc(256);
  let FA:[]u8=z_alloc(1024);
  let EA:[]u8=z_alloc(1536);
  let GA:[]u8=z_alloc(4096);
  let GO:[]u8=z_alloc(128);
  let CA:[]u8=z_alloc(20480);
  let CO:[]u8=z_alloc(512);
  let SA:[]u8=z_alloc(512);
  let LB:[]u8=z_alloc(8320);
  let L:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let ans:[]u8=z_alloc(1024);
  let vbuf:[]u8=z_alloc(32);
  let R:[]u8=z_alloc(32);
  let G:[]u8=z_alloc(512);
  let A:[]u8=world_new();
  let Ch:[]u8=chain_new();
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let AN:[]u8=z_alloc(2048);
  let AV:[]u8=z_alloc(16384);
  let SM:[]u8=z_alloc(128);
  let RK:[]u8=z_alloc(64);
  let RS:[]u8=z_alloc(64);
  let A2:[]u8=z_alloc(1024);
  let V2:[]u8=z_alloc(32);
  let rec:[]u8=z_alloc(128);
  bld(d_worlds(),WA,6);
  bld(d_facts(),FA,3);
  bld(d_eps(),EA,12);
  bld_goals(d_goals(),GA,GO);
  bld_cases(d_cases(),CA,CO);
  bld(d_segs(),SA,5);
  bld_labels(d_labels(),LB);
  let c:i32=0;
  c=o_app(T,c,"BAR K0_CF_RUN_BEGIN nworlds=");
  c=p_i(T,c,get32(WA,0));
  c=o_app(T,c," nfacts=");
  c=p_i(T,c,get32(FA,0));
  c=o_app(T,c," neps=");
  c=p_i(T,c,get32(EA,0));
  c=o_app(T,c," ngoals=");
  c=p_i(T,c,get32(GO,0));
  c=o_app(T,c," ncases=");
  c=p_i(T,c,get32(CO,0));
  c=o_app(T,c," nsegs=");
  c=p_i(T,c,get32(SA,0));
  c=o_app(T,c," nlabels=");
  c=p_i(T,c,get32(LB,8192));

  c=o_nl(T,c);
  _zag_print(T[0..c]);
  let nseg:i32=get32(SA,0);
  let lastc:i32=c;
  let occ:i32=0;
  let avc:i32=0;
  let gcost:i32=0;
  let s:i32=0;
  while(s<nseg){
    let so:i32=4+s*20;
    let cs:i32=get32(SA,so);
    let cl:i32=get32(SA,so+4);
    let eoff:i32=get32(SA,so+8);
    let fwb:i32=get32(SA,so+12);
    let fst:i32=get32(SA,so+16);
    zzero(SM,128);
    zzero(RK,64);
    zzero(RS,64);
    zzero(A2,1024);
    zzero(V2,32);
    if(fst==1){ zzero(L,16384); }
    let a2c:i32=0;
    let j:i32=0;
    while(j<cl){
      let i:i32=cs+j;
      let b0:i32=get32(CO,4+i*4)*4;
      let w:i32=get32(CA,b0);
      let md:i32=get32(CA,b0+4);
      let gi:i32=get32(CA,b0+8);
      let lab:i32=get32(CA,b0+12);
      let les:i32=get32(CA,b0+16);
      let alen:i32=get32(CA,b0+28);
      let vlen:i32=get32(CA,b0+32);
      let ref:i32=get32(CA,b0+36);
      let blk:i32=get32(CA,b0+44);
      let rc:i32=-99;
      let how:i32=-99;
      let cost:i32=0;
      let astart:i32=-1;
      let alen_o:i32=0;
      let nn:i32=0;
      buildw(WA,FA,A,w);
      if(gi>=0){ buildg(GA,GO,G,gi); }
      if(md==0){
        if(fwb==1){ zzero(L,16384); }
        let k0:i32=get32(K,12);
        if(eoff==0){ runeps(WA,EA,L,A,K,Ch,tout,seen,w); }
        cost=get32(K,12)-k0;
      }
      if(md==1){
        if(les==2){ set32(L,0,0); }
        let k1:i32=get32(K,0);
        set32(ans,0,0);
        rc=compose_iter(L,A,G,K,ans,vbuf);
        cost=get32(K,0)-k1;
        alen_o=get32(ans,0);
        nn=reorder(L,G,ans,vbuf,A2,V2,RK,RS,a2c);
        astart=avc;
        let q:i32=0;
        while(q<alen_o){
          set32(AV,avc*4,get32(A2,q*4));
          avc=avc+1;
          q=q+1;
        }
        a2c=a2c+alen_o;
      }
      if(md==2){
        if(les==1){ set32(L,14500,0); }
        let k2:i32=get32(K,0);
        how=osc_handle(L,A,G,K,R);
        cost=get32(K,0)-k2;
      }
      if(md==3){ plan_drop(L,g_tag(G)); }
      set32(AN,occ*4,astart);
      set32(AN,occ*4+4,alen_o);
      let ma:i32=0;
      if(alen>0){ ma=eqbare(A2,(a2c-alen_o)*4,alen_o,CA,b0+48); }
      let mv:i32=0;
      if(vlen>0){ mv=eqbare(V2,0,vlen,CA,b0+48+alen*4); }
      let mh:i32=0;
      let xhow:i32=get32(CA,b0+24);
      if(xhow>=0){
        mh=0;
        if(how==xhow){ mh=1; }
      }
      let mrs:i32=0;
      if(ref>=0){
        if(ref==occ){ mrs=-1; }
        else{
          let ts:i32=get32(AN,ref*4);
          if(ts<0){ mrs=0; if(astart<0){ mrs=1; } }
          else{ mrs=eqbare(AV,astart*4,alen_o,AV,ts*4); }
        }
      }
      set32(rec,0,occ);
      set32(rec,4,s);
      set32(rec,8,lab);
      set32(rec,12,w);
      set32(rec,16,md);
      set32(rec,20,rc);
      set32(rec,24,how);
      set32(rec,28,cost);
      set32(rec,32,alen_o);
      set32(rec,36,nn);
      set32(rec,40,ma);
      set32(rec,44,mv);
      set32(rec,48,mh);
      set32(rec,52,mrs);
      set32(rec,56,(a2c-alen_o)*4);
      set32(rec,80,get32(vbuf,20));
      c=p_case(T,c,rec,LB,L,A2,V2,RK);
      if(c>lastc){ _zag_print(T[lastc..c]); lastc=c; }
      if(md==1){ set32(SM,0,get32(SM,0)+1); }
      if(alen>0){
        set32(SM,4,get32(SM,4)+ma);
        set32(SM,8,get32(SM,8)+(1-ma));
      }
      if(vlen>0){
        set32(SM,12,get32(SM,12)+mv);
        set32(SM,16,get32(SM,16)+(1-mv));
      }
      if(xhow>=0){
        set32(SM,20,get32(SM,20)+mh);
        set32(SM,24,get32(SM,24)+(1-mh));
      }
      if(mrs==0){ set32(SM,32,get32(SM,32)+1); }
      if(mrs==1){ set32(SM,28,get32(SM,28)+1); }
      if(ref>=0){ set32(SM,36,get32(SM,36)+1); }
      set32(SM,40,get32(SM,40)+cost);
      if(blk==10){
        set32(SM,44,get32(SM,44)+1);
        set32(SM,48,get32(SM,48)+ma);
        set32(SM,52,get32(SM,52)+mv);
        set32(SM,56,get32(SM,56)+(1-mv));
      }
      occ=occ+1;
      gcost=gcost+cost;
      j=j+1;
    }
    c=p_seg(T,c,SM,s,L);
    if(c>lastc){ _zag_print(T[lastc..c]); lastc=c; }
    s=s+1;
  }
  c=o_app(T,c,"BAR K0_CF_RUN_END cases=");
  c=p_i(T,c,occ);
  c=o_app(T,c," totalcost=");
  c=p_i(T,c,gcost);
  if(c>lastc){ _zag_print(T[lastc..c]); lastc=c; }
  return 0;
}// cf_data.zag -- DATA ONLY for the CORE-FREEZE battery.
//
// Contains no cognition and no dispatch:
//   * nx          : generic whitespace-separated i32 scanner
//   * data strings: EVERY world identifier, relation identifier, goal
//                   tag, need tag and expected value lives here
//   * bld / bld_goals / bld_labels : generic table builders
//
// cf_engine.zag contains none of these literals. The frozen cognition
// files contain none either. That separation is the experiment.
//
// SOURCES (all from PREREG.md sections 3 and 4):
//   facts/eps/goals : PREREG 3, transcribed verbatim.
//   expected values : PREREG 3 and 4, transcribed verbatim INCLUDING the
//                     internal inconsistencies analysed in RESULTS.md
//                     (G7003@W2 answer; G7003@W3 answer and versions;
//                     G7004@W2 answer). They are NOT corrected here.
//   case/segment rows : PREREG 4 batteries CF1..CF3 and B2..B5.
// Two PREREG prose counts disagree with the listed data (W2 "9 facts"
// vs 10 listed; W3 "16 facts" vs 15 listed). The listed triples are
// used, since every expected answer is stated against them.

fn nx(S:[]u8,pos:[]u8)i32 {
  let p:i32=get32(pos,0);
  let g:i32=1;
  while(g==1){
    if(p>=S.len){ g=0; }
    if(g==1){
      if(S[p]==32){ p=p+1; } else { g=0; }
    }
  }
  let v:i32=0;
  let sg:i32=0;
  let g2:i32=1;
  while(g2==1){
    if(p>=S.len){ g2=0; }
    if(g2==1){
      let c:i32=S[p] as i32;
      if(c==32){ p=p+1; g2=0; }
      else{
        if(c==45){ sg=1; }
        else{ v=v*10+(c-48); }
        p=p+1;
      }
    }
  }
  set32(pos,0,p);
  if(sg==1){ v=0-v; }
  return v;
}
fn appn(T:[]u8,c:i32,s:[]u8)i32 { return o_app(T,c,s); }


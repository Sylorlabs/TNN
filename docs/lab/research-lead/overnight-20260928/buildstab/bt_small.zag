// bt_small.zag -- BUILD-STABILITY lane fixture S1 (prereg section 3)
// Minimal non-trivial pure-Zag program: allocation, LE i32 cells, arena
// offsets, formatted output via _zag_print. Exercises the same builtin
// surface as the frozen cores without their size.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn WSZ()i32 { return 110656; }
fn NN()i32  { return 1024; }
fn noff(n:i32)i32 { return 64+n*40; }
fn main()i32 {
  let A:[]u8=z_alloc(WSZ());
  let c:i32=0;
  let n:i32=0;
  while(n<8){ set32(A,noff(n),n*n+1); n=n+1; }
  c=o_app(A,c,"BT_SMALL");
  c=o_app(A,c," ");
  let i:i32=0; let sum:i32=0;
  while(i<8){ sum=sum+get32(A,noff(i)); i=i+1; }
  c=o_app(A,c," sum="); c=o_i64(A,c,sum as i64);
  c=o_app(A,c," cell7="); c=o_i64(A,c,get32(A,noff(7)) as i64);
  c=o_nl(A,c);
  o_flush(A,c);
  return 0;
}

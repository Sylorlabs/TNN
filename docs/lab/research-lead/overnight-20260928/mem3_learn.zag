// mem3_learn.zag -- H-MEM3: repair of H-MEM2 red-team downgrades.
// Prereg: PREREG_MEM3.md (frozen before this implementation).
// Deltas vs mem2_learn.zag (H-MEM2):
//   R1 (X-M2-1a): churn counterfactual now computed for the SELECTED policy
//       (protected vs unprotected victim of the argmin winner), with an
//       explicit CHURN-PREVENTED:1/0 verdict. The old unprotected-LFU-only
//       print misdescribed the mechanism at ev1; K-M2-1 SUPERSEDED by K-M3-1.
//   R2 (doc bug): all-protected fallback IMPLEMENTED. When every stored slot
//       is protected, selection falls back to the unprotected argmin, emits
//       FALLBACK-ALL-PROTECTED, sets the ST fallback flag. New fixture covers it.
//   R3 (X-M2-2c): F-trend dropped (it was the replay proxy relabeled).
//       Six new shift futures, each machine-checked DIST-DIFFERS against the
//       W=20 selection window. K-M2-2 SUPERSEDED by K-M3-2 (selected ties min).
//   R4 (X-M2-2a): F-shift "not uniquely worst" bar replaced by the stronger
//       "selected ties the minimum" bar; harness prints n_tying_min as context.
//   R5 (X-M2-3): strictness claim scoped to skewed-popularity regimes; a flat
//       round-robin boundary fixture demonstrates reported ties (not a bar).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// 8 slots x 28 bytes: +0 used, +4 pid, +8 uses, +12 lastq, +16 sseq, +20 prot_until
fn NSLOT()i32 { return 8; }
fn SLOT_SZ()i32 { return 28; }
fn PROB()i32 { return 10; }
fn slot_off(s:i32)i32 { return s*SLOT_SZ(); }
fn st_used(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)); }
fn st_pid(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+4); }
fn st_uses(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+8); }
fn st_lastq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+12); }
fn st_sseq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+16); }
fn st_prot(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+20); }
fn st_set(W:[]u8, s:i32, used:i32, pid:i32, uses:i32, lastq:i32, sseq:i32, prot:i32)void {
  set32(W, slot_off(s), used); set32(W, slot_off(s)+4, pid);
  set32(W, slot_off(s)+8, uses); set32(W, slot_off(s)+12, lastq);
  set32(W, slot_off(s)+16, sseq); set32(W, slot_off(s)+20, prot);
  return;
}
// ST: +0 nq, +4 seq, +8 ss, +12 fallback flag (R2)
fn st_nq(ST:[]u8)i32 { return get32(ST, 0); }
fn st_seq(ST:[]u8)i32 { return get32(ST, 4); }
fn st_ss(ST:[]u8)i32 { return get32(ST, 8); }
fn st_fbf(ST:[]u8)i32 { return get32(ST, 12); }
fn st_set_nq(ST:[]u8, v:i32)void { set32(ST, 0, v); return; }
fn st_set_seq(ST:[]u8, v:i32)void { set32(ST, 4, v); return; }
fn st_set_ss(ST:[]u8, v:i32)void { set32(ST, 8, v); return; }
fn st_set_fbf(ST:[]u8, v:i32)void { set32(ST, 12, v); return; }
fn st_find(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){ if(st_used(W,s)==1){ if(st_pid(W,s)==pid){ return s; } } s=s+1; }
  return -1;
}
fn has_proc(W:[]u8, pid:i32)i32 { return st_find(W,pid)>=0; }
// eviction-eligible: stored and not (protected and use_prot)
fn elig(W:[]u8, ST:[]u8, s:i32, use_prot:i32)i32 {
  if(st_used(W,s)==0){ return 0; }
  if(use_prot==1){ if(st_seq(ST) < st_prot(W,s)){ return 0; } }
  return 1;
}
fn nelig(W:[]u8, ST:[]u8, use_prot:i32)i32 {
  let c:i32=0; let s:i32=0;
  while(s<NSLOT()){ if(elig(W,ST,s,use_prot)==1){c=c+1;} s=s+1; }
  return c;
}
fn st_learn(W:[]u8, ST:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==0){
      let ss:i32=st_ss(ST);
      st_set(W, s, 1, pid, 0, 0, ss, st_seq(ST)+PROB());
      st_set_ss(ST, ss+1);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn st_query(W:[]u8, ST:[]u8, Q:[]u8, pid:i32)void {
  let f:i32=st_find(W, pid);
  if(f>=0){
    let sq:i32=st_seq(ST)+1;
    st_set_seq(ST, sq);
    set32(W, slot_off(f)+8, st_uses(W,f)+1);
    set32(W, slot_off(f)+12, sq);
    let nq:i32=st_nq(ST);
    Q[nq]=pid as u8;
    st_set_nq(ST, nq+1);
  }
  return;
}
fn run_seq(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){ st_query(W, ST, Q, P[i] as i32); i=i+1; }
  return;
}
fn run_pairs(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, np:i32)void {
  let i:i32=0;
  while(i<np){
    let pid:i32=P[i*2] as i32; let cnt:i32=P[i*2+1] as i32;
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    i=i+1;
  }
  return;
}
fn pol_name(p:i32)[]u8 {
  if(p==0){return "LFU";} if(p==1){return "LRU";}
  if(p==2){return "FIFO";} if(p==3){return "LIFO";}
  return "RANDOM";
}
// victim; use_prot=1 skips protected slots, 0 ignores protection
fn victim(W:[]u8, ST:[]u8, pol:i32, ev:i32, use_prot:i32)i32 {
  let best:i32=-1; let s:i32=0;
  if(pol==4){
    let ne:i32=nelig(W,ST,use_prot);
    if(ne==0){ return -1; }
    let k:i32=((ev*5+1)%ne+ne)%ne;
    let c:i32=0; s=0;
    while(s<NSLOT()){
      if(elig(W,ST,s,use_prot)==1){ if(c==k){return s;} c=c+1; }
      s=s+1;
    }
    return -1;
  }
  while(s<NSLOT()){
    if(elig(W,ST,s,use_prot)==1){
      if(best<0){ best=s; }
      else {
        if(pol==0){ if(st_uses(W,s)<st_uses(W,best)){best=s;} }
        if(pol==1){ if(st_lastq(W,s)<st_lastq(W,best)){best=s;} }
        if(pol==2){ if(st_sseq(W,s)<st_sseq(W,best)){best=s;} }
        if(pol==3){ if(st_sseq(W,s)>st_sseq(W,best)){best=s;} }
      }
    }
    s=s+1;
  }
  return best;
}
fn replay_cost(W:[]u8, Q:[]u8, ST:[]u8, v:i32, win:i32)i32 {
  if(v<0){return 999999;}
  let pid:i32=st_pid(W,v);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let c:i32=0; let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+1;} i=i+1; }
  return c;
}
// argmin over the menu with a given protection mode (R2 helper)
fn argmin_pol(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, up:i32)i32 {
  let p:i32=0; let bestp:i32=0; let bestc:i32=999999;
  while(p<5){
    let c:i32=replay_cost(W,Q,ST,victim(W,ST,p,ev,up),win);
    if(c<bestc){bestc=c;bestp=p;}
    p=p+1;
  }
  return bestp;
}
// winner at window (no state change); R2: falls back to unprotected when all protected
fn select_win(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32)i32 {
  let wp:i32=argmin_pol(W,Q,ST,ev,win,1);
  if(victim(W,ST,wp,ev,1)<0){
    emit("FALLBACK-ALL-PROTECTED ");
    wp=argmin_pol(W,Q,ST,ev,win,0);
  }
  return wp;
}
fn is_strict_up(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32, up:i32)i32 {
  let wc:i32=replay_cost(W,Q,ST,victim(W,ST,wp,ev,up),win);
  let p:i32=0;
  while(p<5){
    if(p!=wp){
      if(replay_cost(W,Q,ST,victim(W,ST,p,ev,up),win)<=wc){ return 0; }
    }
    p=p+1;
  }
  return 1;
}
fn is_strict(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32)i32 {
  return is_strict_up(W,Q,ST,ev,win,wp,1);
}
// K-M2-5: identical strict winner across W in {20,25,30}
fn band_check(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, expect:i32, tag:[]u8)i32 {
  emit("band check "); emit(tag); emit(" (expect "); emit(pol_name(expect)); emit("):");
  let ok:i32=1;
  let w:i32=20;
  while(w<=30){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); ok=0; }
    if(sw!=expect){ ok=0; }
    w=w+5;
  }
  emit("\n");
  if(ok==1){ emit("K-M2-5 PASS ("); emit(tag); emit(")\n"); }
  else { emit("K-M2-5 FAIL ("); emit(tag); emit(")\n"); }
  return ok;
}
// window sweep as inspectable context (not a bar)
fn sweep_print(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, tag:[]u8)void {
  emit("window sweep "); emit(tag); emit(":");
  let w:i32=10;
  while(w<=40){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); }
    w=w+5;
  }
  let swf:i32=select_win(W,Q,ST,ev,1000000);
  let stf:i32=is_strict(W,Q,ST,ev,1000000,swf);
  emit(" W=full:"); emit(pol_name(swf));
  if(stf==1){ emit("*"); } else { emit("~"); }
  emit("\n");
  return;
}
// R3: 1 iff the future's per-proc frequency vector differs from the W=win window vector
fn dist_differs(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let p:i32=0;
  while(p<16){
    let cw:i32=0; let i:i32=lo;
    while(i<nq){ if((Q[i] as i32)==p){cw=cw+1;} i=i+1; }
    let cf:i32=0; let j:i32=0;
    while(j<nf){ if((F[j] as i32)==p){cf=cf+1;} j=j+1; }
    if(cw!=cf){ return 1; }
    p=p+1;
  }
  return 0;
}
// R3/R4: future scoring. Bar: DIST-DIFFERS vs window AND selected ties the min.
// Prints n_tying_min as discriminativeness context. Precondition: at the call
// site at least one slot is eligible (true at all headline events).
fn fut_score2(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, F:[]u8, nf:i32, sel:i32, win:i32, tag:[]u8)i32 {
  let dd:i32=dist_differs(Q,ST,F,nf,win);
  emit("held-out "); emit(tag);
  if(dd==1){ emit(" [DIST-DIFFERS]"); } else { emit(" [DIST-SAME]"); }
  let M:[]u8=z_alloc(20);
  let p:i32=0; let minm:i32=999999;
  while(p<5){
    let pid:i32=st_pid(W,victim(W,ST,p,ev,1));
    let m:i32=0; let i:i32=0;
    while(i<nf){ if((F[i] as i32)==pid){m=m+1;} i=i+1; }
    set32(M,p*4,m);
    if(m<minm){minm=m;}
    p=p+1;
  }
  emit(" misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let nmin:i32=0; p=0;
  while(p<5){ if(get32(M,p*4)==minm){nmin=nmin+1;} p=p+1; }
  emit("  n_tying_min="); emit(i32s(nmin)); emit(" of 5\n");
  if(dd==0){ emit("K-M3-2 FAIL ("); emit(tag); emit(": future distribution identical to window)\n"); return 0; }
  if(get32(M,sel*4)==minm){ emit("K-M3-2 PASS ("); emit(tag); emit(": selected ties min, DIST-DIFFERS)\n"); return 1; }
  emit("K-M3-2 FAIL ("); emit(tag); emit(": selected not min)\n"); return 0;
}
// pressure at operating window 20; R1: selected-policy counterfactual;
// R2: all-protected fallback
fn pressure(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, newpid:i32)i32 {
  emit("pressure event "); emit(i32s(ev));
  emit(" (learn proc"); emit(i32s(newpid)); emit(", win=20):\n");
  st_set_fbf(ST, 0);
  let up:i32=1;
  let bestp:i32=argmin_pol(W,Q,ST,ev,20,1);
  let v:i32=victim(W,ST,bestp,ev,1);
  if(v<0){
    emit("  FALLBACK-ALL-PROTECTED: all slots protected; using unprotected choice\n");
    st_set_fbf(ST, 1);
    up=0;
    bestp=argmin_pol(W,Q,ST,ev,20,0);
    v=victim(W,ST,bestp,ev,0);
  }
  let p:i32=0;
  while(p<5){
    let pv2:i32=victim(W,ST,p,ev,up);
    let c:i32=replay_cost(W,Q,ST,pv2,20);
    emit("    "); emit(pol_name(p));
    emit(" victim=slot"); emit(i32s(pv2));
    if(pv2>=0){ emit("(proc"); emit(i32s(st_pid(W,pv2))); emit(")"); }
    emit(" cost="); emit(i32s(c)); emit("\n");
    p=p+1;
  }
  emit("  selected: "); emit(pol_name(bestp));
  emit(" cost="); emit(i32s(replay_cost(W,Q,ST,v,20)));
  if(is_strict_up(W,Q,ST,ev,20,bestp,up)==1){ emit(" STRICT"); } else { emit(" TIE"); }
  emit("\n");
  emit("  evict slot"); emit(i32s(v));
  if(v>=0){
    emit(" proc"); emit(i32s(st_pid(W,v)));
    emit(" uses="); emit(i32s(st_uses(W,v)));
    emit(" lastq="); emit(i32s(st_lastq(W,v)));
  }
  emit("\n");
  // R1: counterfactual for the SELECTED policy (X-M2-1a repair)
  let pv3:i32=victim(W,ST,bestp,ev,1);
  let uv:i32=victim(W,ST,bestp,ev,0);
  emit("  [churn counterfactual] selected="); emit(pol_name(bestp));
  emit(" protected-victim=slot"); emit(i32s(pv3));
  if(pv3>=0){ emit("(proc"); emit(i32s(st_pid(W,pv3))); emit(")"); }
  emit(" unprotected-victim=slot"); emit(i32s(uv));
  if(uv>=0){ emit("(proc"); emit(i32s(st_pid(W,uv))); emit(")"); }
  emit("\n");
  if(pv3<0){
    emit("  CHURN-PREVENTED:0 (fallback path; protection not applied)\n");
  } else {
    if(pv3==uv){ emit("  CHURN-PREVENTED:0 (probation changed nothing for the selected policy)\n"); }
    else {
      emit("  CHURN-PREVENTED:1 (probation shielded proc");
      if(uv>=0){ emit(i32s(st_pid(W,uv))); } else { emit("?"); }
      emit(" from churn)\n");
    }
  }
  if(v>=0){ st_set(W, v, 0, -1, 0, 0, 0, 0); }
  let s2:i32=st_learn(W, ST, newpid);
  emit("  stored proc"); emit(i32s(newpid));
  emit(" at slot"); emit(i32s(s2));
  if(s2>=0){ emit(" prot_until="); emit(i32s(st_prot(W,s2))); }
  emit("\n");
  return bestp;
}
fn store_init(W:[]u8, ST:[]u8)void {
  let s:i32=0;
  while(s<NSLOT()){ st_set(W,s,0,-1,0,0,0,0); s=s+1; }
  st_set_nq(ST,0); st_set_seq(ST,0); st_set_ss(ST,0); st_set_fbf(ST,0);
  return;
}
fn learn_stream(W:[]u8, ST:[]u8, base:i32, n:i32)void {
  let i:i32=0;
  while(i<n){ let _x:i32=st_learn(W, ST, base+i); i=i+1; }
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(NSLOT()*SLOT_SZ());
  let ST:[]u8=z_alloc(16);
  let Q:[]u8=z_alloc(512);
  let pass:i32=1;
  let strict_n:i32=0;

  // ================= STREAM A2 =================
  emit("=== STREAM A2 (stable popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let AA:[]u8=z_alloc(40);
  let ai:i32=0;
  AA[ai]=5;ai=ai+1; AA[ai]=5;ai=ai+1;
  let t:i32=0;
  while(t<4){AA[ai]=0;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=7;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=3;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=6;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=1;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=2;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=4;ai=ai+1;t=t+1;}
  run_seq(W, ST, Q, AA, ai);
  let AW:[]u8=z_alloc(20);
  AW[0]=6;AW[1]=6;AW[2]=5;AW[3]=0;AW[4]=0;AW[5]=0;AW[6]=0;
  AW[7]=7;AW[8]=7;AW[9]=7;AW[10]=7;AW[11]=3;AW[12]=3;AW[13]=3;AW[14]=3;
  AW[15]=1;AW[16]=1;AW[17]=2;AW[18]=2;AW[19]=4;
  run_seq(W, ST, Q, AW, 20);
  emit("A2: 53 queries.\n");
  if(band_check(W,Q,ST,0,0,"A2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"A2-ev0");
  // R3: new shift futures (frozen in PREREG_MEM3.md). Expected: selected LFU
  // unique min on both; DIST-DIFFERS vs the W=20 window.
  let A2F1:[]u8=z_alloc(20);
  A2F1[0]=5;A2F1[1]=5;
  A2F1[2]=6;A2F1[3]=6;A2F1[4]=6;A2F1[5]=6;A2F1[6]=6;
  A2F1[7]=0;A2F1[8]=0;A2F1[9]=0;A2F1[10]=0;A2F1[11]=0;
  A2F1[12]=7;A2F1[13]=7;A2F1[14]=7;A2F1[15]=7;
  A2F1[16]=1;A2F1[17]=1;A2F1[18]=1;A2F1[19]=1;
  let A2F2:[]u8=z_alloc(20);
  A2F2[0]=5;
  A2F2[1]=6;A2F2[2]=6;A2F2[3]=6;A2F2[4]=6;A2F2[5]=6;A2F2[6]=6;
  A2F2[7]=0;A2F2[8]=0;A2F2[9]=0;A2F2[10]=0;
  A2F2[11]=7;A2F2[12]=7;A2F2[13]=7;A2F2[14]=7;
  A2F2[15]=1;A2F2[16]=1;A2F2[17]=1;A2F2[18]=1;A2F2[19]=1;
  if(fut_score2(W,Q,ST,0,A2F1,20,0,20,"A2 F-S1")==0){ pass=0; }
  if(fut_score2(W,Q,ST,0,A2F2,20,0,20,"A2 F-S2")==0){ pass=0; }
  let wA0:i32=select_win(W,Q,ST,0,20);
  let sA0:i32=is_strict(W,Q,ST,0,20,wA0);
  let selA0:i32=pressure(W,Q,ST,0,8);
  if(selA0!=0){ emit("A2-ev0 FAIL: expected LFU\n"); pass=0; }
  if(wA0!=selA0){ emit("A2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sA0==1){ strict_n=strict_n+1; }
  // interleave Q1 = [8,8,8]
  let Q1:[]u8=z_alloc(3); Q1[0]=8;Q1[1]=8;Q1[2]=8;
  run_seq(W, ST, Q, Q1, 3);
  // R1: selected-policy counterfactual captured pre-pressure (X-M2-1a repair)
  let wA1:i32=select_win(W,Q,ST,1,20);
  let sA1:i32=is_strict(W,Q,ST,1,20,wA1);
  let cf_p1:i32=victim(W,ST,wA1,1,1);
  let cf_u1:i32=victim(W,ST,wA1,1,0);
  let cf_p1_pid:i32=-1; if(cf_p1>=0){cf_p1_pid=st_pid(W,cf_p1);}
  let cf_u1_pid:i32=-1; if(cf_u1>=0){cf_u1_pid=st_pid(W,cf_u1);}
  let selA1:i32=pressure(W,Q,ST,1,9);
  if(has_proc(W,8)==0){ emit("K-M3-1 FAIL: proc8 churned at ev1\n"); pass=0; }
  else { emit("K-M3-1 check ev1: proc8 survives\n"); }
  if(wA1!=1){ emit("K-M3-1 FAIL: ev1 winner not LRU\n"); pass=0; }
  if(cf_p1!=6 || cf_u1!=6 || cf_p1_pid!=6 || cf_u1_pid!=6){
    emit("K-M3-1 FAIL: ev1 selected-policy counterfactual not slot6(proc6)/slot6(proc6)\n"); pass=0;
  } else {
    emit("K-M3-1 PASS ev1: selected LRU protected-victim=slot6(proc6) unprotected-victim=slot6(proc6); CHURN-PREVENTED:0 honest (probation changed nothing for the selected policy)\n");
  }
  if(wA1!=selA1){ emit("A2-ev1 FAIL: winner mismatch\n"); pass=0; }
  if(sA1==1){ strict_n=strict_n+1; }
  // interleave Q2 = [9,9,8,8,0,0]
  let Q2:[]u8=z_alloc(6); Q2[0]=9;Q2[1]=9;Q2[2]=8;Q2[3]=8;Q2[4]=0;Q2[5]=0;
  run_seq(W, ST, Q, Q2, 6);
  let wA2:i32=select_win(W,Q,ST,2,20);
  let sA2:i32=is_strict(W,Q,ST,2,20,wA2);
  let cf_p2:i32=victim(W,ST,wA2,2,1);
  let cf_u2:i32=victim(W,ST,wA2,2,0);
  let cf_p2_pid:i32=-1; if(cf_p2>=0){cf_p2_pid=st_pid(W,cf_p2);}
  let cf_u2_pid:i32=-1; if(cf_u2>=0){cf_u2_pid=st_pid(W,cf_u2);}
  let selA2:i32=pressure(W,Q,ST,2,10);
  if(has_proc(W,9)==0){ emit("K-M3-1 FAIL: proc9 churned at ev2\n"); pass=0; }
  else { emit("K-M3-1 check ev2: proc9 survives\n"); }
  if(wA2!=0){ emit("K-M3-1 FAIL: ev2 winner not LFU\n"); pass=0; }
  if(cf_p2!=4 || cf_u2!=6 || cf_p2_pid!=4 || cf_u2_pid!=9){
    emit("K-M3-1 FAIL: ev2 selected-policy counterfactual not slot4(proc4)/slot6(proc9)\n"); pass=0;
  } else {
    emit("K-M3-1 PASS ev2: selected LFU protected-victim=slot4(proc4) unprotected-victim=slot6(proc9); CHURN-PREVENTED:1 genuine (probation shielded proc9)\n");
  }
  if(wA2!=selA2){ emit("A2-ev2 FAIL: winner mismatch\n"); pass=0; }
  if(sA2==1){ strict_n=strict_n+1; }

  // ================= STREAM B2 =================
  emit("=== STREAM B2 (shifting popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let B1:[]u8=z_alloc(2); B1[0]=3;B1[1]=40;
  run_pairs(W, ST, Q, B1, 1);
  let B2:[]u8=z_alloc(14);
  B2[0]=6;B2[1]=6; B2[2]=2;B2[3]=6; B2[4]=4;B2[5]=6; B2[6]=5;B2[7]=6;
  B2[8]=7;B2[9]=6; B2[10]=1;B2[11]=6; B2[12]=0;B2[13]=10;
  run_pairs(W, ST, Q, B2, 7);
  emit("B2: 86 queries.\n");
  if(band_check(W,Q,ST,0,1,"B2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"B2-ev0");
  let B2F1:[]u8=z_alloc(20);
  B2F1[0]=3;
  B2F1[1]=1;B2F1[2]=1;B2F1[3]=1;B2F1[4]=1;B2F1[5]=1;
  B2F1[6]=0;B2F1[7]=0;B2F1[8]=0;B2F1[9]=0;B2F1[10]=0;
  B2F1[11]=7;B2F1[12]=7;B2F1[13]=7;B2F1[14]=7;B2F1[15]=7;
  B2F1[16]=2;B2F1[17]=2;B2F1[18]=2;B2F1[19]=2;
  let B2F2:[]u8=z_alloc(20);
  B2F2[0]=1;B2F2[1]=1;B2F2[2]=1;B2F2[3]=1;B2F2[4]=1;B2F2[5]=1;
  B2F2[6]=0;B2F2[7]=0;B2F2[8]=0;B2F2[9]=0;B2F2[10]=0;B2F2[11]=0;
  B2F2[12]=7;B2F2[13]=7;B2F2[14]=7;B2F2[15]=7;
  B2F2[16]=2;B2F2[17]=2;B2F2[18]=2;B2F2[19]=2;
  if(fut_score2(W,Q,ST,0,B2F1,20,1,20,"B2 F-S1")==0){ pass=0; }
  if(fut_score2(W,Q,ST,0,B2F2,20,1,20,"B2 F-S2")==0){ pass=0; }
  let wB0:i32=select_win(W,Q,ST,0,20);
  let sB0:i32=is_strict(W,Q,ST,0,20,wB0);
  let selB0:i32=pressure(W,Q,ST,0,8);
  if(selB0!=1){ emit("B2-ev0 FAIL: expected LRU\n"); pass=0; }
  if(wB0!=selB0){ emit("B2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sB0==1){ strict_n=strict_n+1; }

  // ================= STREAM C2 =================
  emit("=== STREAM C2 (scan workload) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let CA:[]u8=z_alloc(40);
  let ci:i32=0;
  CA[ci]=5;ci=ci+1; t=0;
  while(t<4){CA[ci]=6;ci=ci+1;t=t+1;} t=0;
  while(t<10){CA[ci]=0;ci=ci+1;t=t+1;} t=0;
  while(t<2){CA[ci]=7;ci=ci+1;t=t+1;} t=0;
  while(t<2){CA[ci]=3;ci=ci+1;t=t+1;} t=0;
  while(t<3){CA[ci]=1;ci=ci+1;t=t+1;} t=0;
  while(t<4){CA[ci]=2;ci=ci+1;t=t+1;} t=0;
  while(t<4){CA[ci]=4;ci=ci+1;t=t+1;}
  run_seq(W, ST, Q, CA, ci);
  let CW:[]u8=z_alloc(20);
  CW[0]=6;CW[1]=6;CW[2]=5;CW[3]=5;CW[4]=0;CW[5]=7;CW[6]=7;
  CW[7]=3;CW[8]=3;CW[9]=1;CW[10]=1;CW[11]=2;CW[12]=4;CW[13]=7;
  CW[14]=3;CW[15]=1;CW[16]=2;CW[17]=4;CW[18]=7;CW[19]=3;
  run_seq(W, ST, Q, CW, 20);
  emit("C2: 50 queries.\n");
  if(band_check(W,Q,ST,0,2,"C2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"C2-ev0");
  let C2F1:[]u8=z_alloc(20);
  C2F1[0]=0;C2F1[1]=0;
  C2F1[2]=5;C2F1[3]=5;C2F1[4]=5;C2F1[5]=5;C2F1[6]=5;
  C2F1[7]=6;C2F1[8]=6;C2F1[9]=6;C2F1[10]=6;C2F1[11]=6;
  C2F1[12]=7;C2F1[13]=7;C2F1[14]=7;C2F1[15]=7;
  C2F1[16]=1;C2F1[17]=1;C2F1[18]=1;C2F1[19]=1;
  let C2F2:[]u8=z_alloc(20);
  C2F2[0]=0;
  C2F2[1]=5;C2F2[2]=5;C2F2[3]=5;C2F2[4]=5;C2F2[5]=5;C2F2[6]=5;
  C2F2[7]=6;C2F2[8]=6;C2F2[9]=6;C2F2[10]=6;C2F2[11]=6;
  C2F2[12]=7;C2F2[13]=7;C2F2[14]=7;C2F2[15]=7;
  C2F2[16]=1;C2F2[17]=1;C2F2[18]=1;C2F2[19]=1;
  if(fut_score2(W,Q,ST,0,C2F1,20,2,20,"C2 F-S1")==0){ pass=0; }
  if(fut_score2(W,Q,ST,0,C2F2,20,2,20,"C2 F-S2")==0){ pass=0; }
  let wC0:i32=select_win(W,Q,ST,0,20);
  let sC0:i32=is_strict(W,Q,ST,0,20,wC0);
  let selC0:i32=pressure(W,Q,ST,0,8);
  if(selC0!=2){ emit("C2-ev0 FAIL: expected FIFO\n"); pass=0; }
  if(wC0!=selC0){ emit("C2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sC0==1){ strict_n=strict_n+1; }

  // K-M2-3 (retained): strict count from pre-pressure evaluations above
  emit("strict selections: "); emit(i32s(strict_n)); emit(" of 5\n");
  if(strict_n<3){ emit("K-M2-3 FAIL: fewer than 3 strict selections\n"); pass=0; }
  else { emit("K-M2-3 PASS: "); emit(i32s(strict_n)); emit(" strict selections\n"); }

  // ================= R5: FLAT BOUNDARY FIXTURE (X-M2-3 scope) =================
  emit("=== BOUNDARY FIXTURE: flat popularity (scope documentation, not a bar) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let FL:[]u8=z_alloc(40);
  let fi:i32=0; let rr:i32=0;
  while(rr<5){ let pp:i32=0; while(pp<8){ FL[fi]=pp; fi=fi+1; pp=pp+1; } rr=rr+1; }
  run_seq(W, ST, Q, FL, 40);
  emit("flat: 40 round-robin queries (each proc 5x)\n");
  emit("SCOPE-NOTE (X-M2-3): strictness is a (mechanism, skewed-regime) property;");
  emit(" on flat workloads the band degenerates to ties and the mechanism reports TIE.\n");
  let fw:i32=20;
  while(fw<=30){
    let fsw:i32=select_win(W,Q,ST,7,fw);
    let fst:i32=is_strict(W,Q,ST,7,fw,fsw);
    emit(" flat W="); emit(i32s(fw)); emit(":"); emit(pol_name(fsw));
    if(fst==1){ emit(" STRICT"); } else { emit(" TIE"); }
    fw=fw+5;
  }
  emit("\n");

  // ================= R2: FALLBACK FIXTURE (all slots protected) =================
  emit("=== FALLBACK FIXTURE (all slots protected) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  emit("0 queries since store; all prot_until=10, seq=0, so every slot is protected\n");
  let fbsel:i32=pressure(W,Q,ST,9,8);
  if(st_fbf(ST)!=1){ emit("K-M3-4 FAIL: fallback flag not set\n"); pass=0; }
  else { emit("K-M3-4 check: fallback flag set, FALLBACK-ALL-PROTECTED emitted\n"); }
  if(fbsel!=0){ emit("K-M3-4 FAIL: expected unprotected LFU (tie-break), got "); emit(pol_name(fbsel)); emit("\n"); pass=0; }
  if(has_proc(W,8)==0){ emit("K-M3-4 FAIL: proc8 not stored after fallback\n"); pass=0; }
  else { emit("K-M3-4 PASS: fallback to unprotected argmin, newcomer stored, no crash\n"); }

  if(pass==1){ emit("ALL BARS PASS\n"); return 0; }
  emit("SOME BAR FAILED\n");
  return 1;
}

// rr_mech.zag -- rule_revision: a counterexample refines an overgeneralized
// RULE (not a value-keyed lookup entry).
// Standalone pure-Zag program. The learner induces CONSTANT output-kind
// rules with a generic induction operator, commits to a composition, takes
// a world rejection, runs a generic blame walk over the committed chain
// (learner-initiated probes whose outcomes join the learner's observation
// log), records the counterexample, and refines the blamed component's
// rule with a generic first-deviation-split operator. The refined
// THRESHOLD rule generalizes to inputs the learner never probed.
//
// Conventions: L = learner state slice, E = world state slice.
// L cells (i32): 0 conf_DD, 1 conf_CC, 2 commit_comp, 3 commit_pred,
//   4 commit_input, 5 commit_status (0 none, 1 PENDING, 2 RESOLVED),
//   6..11 comp C H1 stats (in_sum,in_n,out_sum,out_n,sig_in,sig_out),
//   12..17 comp D H1 stats (same layout),
//   18 ce_comp (-1 none), 19 ce_in, 20 ce_pred, 21 ce_actual,
//   22..38 comp C obs log: count + 8 x (in_val, out_kind),
//   39..55 comp D obs log: count + 8 x (in_val, out_kind),
//   56..60 comp C rule: form, T, klo, khi, kc,
//   61..65 comp D rule: form, T, klo, khi, kc,
//   66..75 refute probe log (per link: comp,in,pred,out,kind),
//   76 links probed.
// E cells (i32): 0 gate, 1 accepts, 2 rejects,
//   3..11 world facts: 3 facts x (subject, relation, object).
// Kind codes: 1 NODE, 2 NUM. Component ids: C 0, D 1.
// Composition ids: DD 0, CC 1. Obs capacity: 8 per component.
// Rule forms: 0 CONSTANT (predict kc for every input value),
//   1 THRESHOLD (predict klo iff input < T, else khi).
// There is no lookup list anywhere in this program: prediction is always
// through the rule predicate rule_pred.

// ---------- output helpers (one buffer, cursor-returning) ----------
// Per toolchain lesson: no _zag_print for dynamic content. All output is
// formatted into ONE preallocated buffer; the driver performs a single
// _zag_raw_syscall write at the end.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1kind(b:[]u8,c:i32,k:i32)i32 {
  if(k==1){return e1str(b,c,"NODE");}
  if(k==2){return e1str(b,c,"NUM");}
  return e1str(b,c,"?");
}
fn e1sig(b:[]u8,c:i32,si:i32,so:i32)i32 {
  c=e1kind(b,c,si);
  c=e1str(b,c,"->");
  c=e1kind(b,c,so);
  return c;
}
fn e1comp(b:[]u8,c:i32,g:i32)i32 {
  if(g==0){return e1str(b,c,"DD");}
  return e1str(b,c,"CC");
}
fn e1cname(b:[]u8,c:i32,cp:i32)i32 {
  if(cp==0){return e1str(b,c,"C");}
  return e1str(b,c,"D");
}
// Render a component's rule from learner state (reads only).
fn e1rule(b:[]u8,c:i32,L:[]u8,cp:i32)i32 {
  let rb:i32=56+cp*5;
  if(lg(L,rb)==0){
    c=e1str(b,c,"ALWAYS(");
    c=e1kind(b,c,lg(L,rb+4));
    c=e1str(b,c,")");
    return c;
  }
  c=e1str(b,c,"IF(in<");
  c=e1i64(b,c,lg(L,rb+1) as i64);
  c=e1str(b,c,",");
  c=e1kind(b,c,lg(L,rb+2));
  c=e1str(b,c,",");
  c=e1kind(b,c,lg(L,rb+3));
  c=e1str(b,c,")");
  return c;
}
// Render a component's observation log from learner state (reads only).
fn e1obslog(b:[]u8,c:i32,L:[]u8,cp:i32)i32 {
  let xb:i32=22+cp*17;
  let n:i32=lg(L,xb);
  c=e1str(b,c,"[");
  let i:i32=0;
  while(i<n){
    if(i>0){c=e1str(b,c,",");}
    c=e1str(b,c,"(");
    c=e1i64(b,c,lg(L,xb+1+i*2) as i64);
    c=e1str(b,c,",");
    c=e1kind(b,c,lg(L,xb+2+i*2));
    c=e1str(b,c,")");
    i=i+1;
  }
  c=e1str(b,c,"]");
  return c;
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }

// ---------- world facts ----------
// Frozen world: relation 91 chain (31,91,32), (32,91,33), (33,91,34).
fn world_init(E:[]u8)void {
  set32(E,3*4,31); set32(E,4*4,91); set32(E,5*4,32);
  set32(E,6*4,32); set32(E,7*4,91); set32(E,8*4,33);
  set32(E,9*4,33); set32(E,10*4,91); set32(E,11*4,34);
  return;
}

// ---------- H1 kind probe (real H1 logic) ----------
// kind(v) = 1 (NODE) iff v appears as a fact subject, else 2 (NUM).
fn probe_kind(E:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<3){
    if(get32(E,(3+i*3)*4)==v){return 1;}
    i=i+1;
  }
  return 2;
}

// ---------- components (fixed true behavior; learner sees only probes) ----------
fn comp_run(c:i32,v:i32)i32 {
  if(c==0){
    if(v==31){return 32;}
    if(v==32){return 33;}
    if(v==33){return 34;}
    return -1;
  }
  return v+1;
}
fn comp_first(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}
fn comp_second(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}

// ---------- observation log (learner's own recorded experience) ----------
// Every probe outcome the learner observes (teaching probes and refutation
// probes alike) is appended here. The refinement operator reads only this
// log and the counterexample cells.
fn obs_append(L:[]u8,cp:i32,vin:i32,ok:i32)void {
  let xb:i32=22+cp*17;
  let n:i32=lg(L,xb);
  if(n<8){
    ls(L,xb+1+n*2,vin);
    ls(L,xb+2+n*2,ok);
    ls(L,xb,n+1);
  }
  return;
}

// ---------- H1 signature induction (real H1 logic) ----------
// Per-observation kind accumulation. Signature cells are written ONLY by
// h1_finalize; there are no signature literals anywhere in this program.
fn h1_observe(L:[]u8,E:[]u8,c:i32,vin:i32,vout:i32)void {
  let base:i32=6+c*6;
  ls(L,base+0,lg(L,base+0)+probe_kind(E,vin));
  ls(L,base+1,lg(L,base+1)+1);
  ls(L,base+2,lg(L,base+2)+probe_kind(E,vout));
  ls(L,base+3,lg(L,base+3)+1);
  return;
}
// Majority finalize: once n>=2, sig=1 unless sum*2>=n*3 (mean kind>=1.5).
fn h1_finalize(L:[]u8,c:i32)void {
  let base:i32=6+c*6;
  let inn:i32=lg(L,base+1);
  if(inn>=2){
    let si:i32=1;
    if(lg(L,base+0)*2>=inn*3){si=2;}
    ls(L,base+4,si);
  }
  let outn:i32=lg(L,base+3);
  if(outn>=2){
    let so:i32=1;
    if(lg(L,base+2)*2>=outn*3){so=2;}
    ls(L,base+5,so);
  }
  return;
}
fn h1_sig_in(L:[]u8,c:i32)i32 { return lg(L,6+c*6+4); }
fn h1_sig_out(L:[]u8,c:i32)i32 { return lg(L,6+c*6+5); }

// ---------- generic rule induction ----------
// From the component's observation log: when every observed output kind
// is the same, induce CONSTANT(that kind). Majority with tie broken to
// the first observed kind; with the frozen teaching probes both kinds
// agree, so the constant rule is honestly induced, never written in.
fn rule_induce(L:[]u8,cp:i32)void {
  let xb:i32=22+cp*17;
  let n:i32=lg(L,xb);
  let c1:i32=0;
  let c2:i32=0;
  let first:i32=1;
  let i:i32=0;
  while(i<n){
    let k:i32=lg(L,xb+2+i*2);
    if(k==1){c1=c1+1;}else{c2=c2+1;}
    if(i==0){first=k;}
    i=i+1;
  }
  let kc:i32=first;
  if(c2>c1){kc=2;}
  let rb:i32=56+cp*5;
  ls(L,rb,0);
  ls(L,rb+4,kc);
  return;
}

// ---------- rule application (the contract prediction) ----------
// Predicted output kind for a concrete input value, through the rule
// predicate. No lookup list exists: every input is answered by the rule.
fn rule_pred(L:[]u8,cp:i32,vin:i32)i32 {
  let rb:i32=56+cp*5;
  if(lg(L,rb)==0){return lg(L,rb+4);}
  if(vin<lg(L,rb+1)){return lg(L,rb+2);}
  return lg(L,rb+3);
}
// Composition prediction: rule prediction for the first link (input
// value known), kind-level seam check for the second link.
// Returns -1 on refusal (seam break).
fn h1_predict_rule(L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  let a:i32=comp_first(g);
  let b:i32=comp_second(g);
  if(probe_kind(E,input)!=h1_sig_in(L,a)){return -1;}
  let p1:i32=rule_pred(L,a,input);
  if(p1!=h1_sig_in(L,b)){return -1;}
  return h1_sig_out(L,b);
}

// ---------- commitment (learner operation) ----------
// Records the rule-predicted outcome BEFORE any execution. The prediction
// is computed from the learned rules, never from a harness-supplied
// answer. Status PENDING proves the commitment predates execution.
fn learner_commit(L:[]u8,E:[]u8,g:i32,input:i32)void {
  let pred:i32=h1_predict_rule(L,E,g,input);
  ls(L,2,g); ls(L,3,pred); ls(L,4,input); ls(L,5,1);
  return;
}

// ---------- world (environment; fixed law, no per-query targets) ----------
fn world_execute(g:i32,input:i32)i32 {
  let v:i32=comp_run(comp_first(g),input);
  v=comp_run(comp_second(g),v);
  return v;
}
// World law: the downstream machine accepts iff the final output kind
// equals the goal kind. The gate latch is the only consequence signal the
// learner may read. This is the single write site of the gate cell.
fn world_downstream(E:[]u8,v:i32,goal:i32)void {
  let g:i32=0;
  if(probe_kind(E,v)==goal){g=1;set32(E,1*4,get32(E,1*4)+1);}
  else{set32(E,2*4,get32(E,2*4)+1);}
  set32(E,0,g);
  return;
}
fn world_gate(E:[]u8)i32 { return get32(E,0); }

// ---------- confidence update (learner operation) ----------
// Reads ONLY the world gate. Never receives an actual output value.
// Never references a harness answer key. Sole writer of confidence cells.
fn learner_update(L:[]u8,E:[]u8,g:i32)void {
  let gate:i32=world_gate(E);
  let c:i32=lg(L,g);
  if(gate==1){ls(L,g,c+1);}else{ls(L,g,c-1);}
  ls(L,5,2);
  return;
}

// ---------- refutation (learner operation) ----------
// Generic blame walk over the committed chain. For each link in order,
// predict the output kind from the component's current rule, probe the
// component on the concrete input value (a learner-initiated experiment
// through the fixed component interface), append the outcome to the
// learner's observation log, and compare against the learner's own kind
// probe of the result. On the first mismatch, record the counterexample
// (comp, in, pred, actual) in learner state and return the blamed
// component. Returns -1 when every link matches. Probe details are logged
// to learner state for the transcript. This function names no component
// and no input or output value.
fn learner_refute(L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  ls(L,18,-1);
  ls(L,76,0);
  let v:i32=input;
  let i:i32=0;
  while(i<2){
    let cp:i32=comp_first(g);
    if(i==1){cp=comp_second(g);}
    let pred:i32=rule_pred(L,cp,v);
    let out:i32=comp_run(cp,v);
    let ak:i32=probe_kind(E,out);
    obs_append(L,cp,v,ak);
    let pb:i32=66+i*5;
    ls(L,pb,cp); ls(L,pb+1,v); ls(L,pb+2,pred); ls(L,pb+3,out); ls(L,pb+4,ak);
    ls(L,76,i+1);
    if(ak!=pred){
      ls(L,18,cp); ls(L,19,v); ls(L,20,pred); ls(L,21,ak);
      return cp;
    }
    v=out;
    i=i+1;
  }
  return -1;
}

// ---------- refinement (learner operation) ----------
// Generic first-deviation split: read the recorded counterexample (which
// names the blamed component) and that component's observation log;
// compute the current rule's prediction for every logged input; take the
// smallest logged input the current rule mispredicts as the split point;
// keep the old rule's prediction at the split point as the below kind
// and take the observed kind there as the at-and-above kind; write the
// THRESHOLD rule. Every value read comes from learner-state cells; this
// function names no component and no input, output, or kind value.
// No-ops when the log holds no misprediction. The rule-cell writes below
// are, together with the two writes in rule_induce, the only rule writes
// in the program.
fn learner_refine(L:[]u8)void {
  let cp:i32=lg(L,18);
  if(cp<0){return;}
  let xb:i32=22+cp*17;
  let n:i32=lg(L,xb);
  let have:i32=0;
  let split:i32=0;
  let splitk:i32=0;
  let i:i32=0;
  while(i<n){
    let iv:i32=lg(L,xb+1+i*2);
    let ok:i32=lg(L,xb+2+i*2);
    if(ok!=rule_pred(L,cp,iv)){
      if(have==0){split=iv;splitk=ok;have=1;}
      else{if(iv<split){split=iv;splitk=ok;}}
    }
    i=i+1;
  }
  if(have==0){return;}
  let klo:i32=rule_pred(L,cp,split);
  let rb:i32=56+cp*5;
  ls(L,rb,1);
  ls(L,rb+1,split);
  ls(L,rb+2,klo);
  ls(L,rb+3,splitk);
  return;
}

// ---------- selection (learner operation) ----------
// Among rule-admissible compositions (rule prediction for the first link
// equals the goal kind with the seam intact), pick argmax confidence.
// Tie -> lowest composition id. Reads the confidence ledger and the
// learned rules only.
fn learner_select(L:[]u8,E:[]u8,input:i32,goal:i32)i32 {
  let best:i32=-1;
  let bestc:i32=0;
  let have:i32=0;
  let g:i32=0;
  while(g<2){
    let p:i32=h1_predict_rule(L,E,g,input);
    if(p==goal){
      let c:i32=lg(L,g);
      if(have==0){best=g;bestc=c;have=1;}
      else{if(c>bestc){best=g;bestc=c;}}
    }
    g=g+1;
  }
  return best;
}

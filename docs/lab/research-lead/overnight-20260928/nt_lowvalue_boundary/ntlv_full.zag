// ntlv_full.zag -- NT-LOWVALUE-BOUNDARY: the "genuinely low-value"
// boundary. Genuinely-useful-but-infrequently-reinforced novel links
// under D1+D2. Pure Zag. No Python.
//
// Subject: the NT-PORT-PRESSURE subject verbatim (D1 preserve-evidence
// + D2 evict-youngest on the continuing-learner associative memory).
// Novelty is the workload: RARE link (148,1)->152 is GENUINELY USEFUL
// (the scored revised query q(100)=152 requires it) but re-taught
// only every K passes. Arms P1/P2/P3/P6 sweep K=1,2,3,6 over M=6
// fixed phase-2 passes. Frozen workload, protocol, predictions, kill
// bars: PREREG.md.
// Output rule: dynamic content into ONE preallocated buffer, one
// raw-syscall write. _zag_print never used for dynamic content.
//
// Learner arena layout (bytes):
//   0: nentries   4: nevict   8: ins_seq   12: nslots
//   16: slots, nslots * 32 bytes: 0:subj 4:rel 8:obj 12:dom 16:valid 20:sup 24:ref 28:ins
//   ckbase = 16+nslots*32: D1 checkpoint table, 51 * 16 bytes (subjs 100..150):
//       0:valid 4:obj 8:sup 12:ref
//   evbase = ckbase+816: evhist, 51 * 4 bytes (per-subj eviction counts)

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner (D1+D2, verbatim from the NT-PORT-PRESSURE port) ----
fn cl_new(ns:i32)[]u8 {
  let L:[]u8=z_alloc(2560);
  set32(L,12,ns);
  return L;
}
fn sf(L:[]u8,s:i32,f:i32)i32 { return get32(L,16+s*32+f*4); }
fn sw(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,16+s*32+f*4,v); return; }
fn ckbase(L:[]u8)i32 { return 16+get32(L,12)*32; }
fn evbase(L:[]u8)i32 { return 16+get32(L,12)*32+816; }
fn ck_get(L:[]u8,subj:i32,f:i32)i32 { return get32(L,ckbase(L)+(subj-100)*16+f*4); }
fn ck_set(L:[]u8,subj:i32,f:i32,v:i32)void { set32(L,ckbase(L)+(subj-100)*16+f*4,v); return; }
fn evh_add(L:[]u8,subj:i32)void {
  let b:i32=evbase(L);
  set32(L,b+(subj-100)*4,get32(L,b+(subj-100)*4)+1);
  return;
}
fn evh_get(L:[]u8,subj:i32)i32 { return get32(L,evbase(L)+(subj-100)*4); }
fn cl_find(L:[]u8,subj:i32,rel:i32)i32 {
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    let m:i32=0;
    if(sf(L,s,4)==1){ if(sf(L,s,0)==subj && sf(L,s,1)==rel){ m=1; } }
    if(m==1){ return s; }
    s=s+1;
  }
  return -1;
}
fn cl_first_empty(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==0){ return s; }
    s=s+1;
  }
  return -1;
}
// D2 eviction rule: evict the most recently INSTALLED entry (max ins).
fn cl_evict_youngest(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==1){
      let a:i32=sf(L,s,7);
      if(best<0){ best=s; bv=a; }
      else { if(a>bv){ best=s; bv=a; } }
    }
    s=s+1;
  }
  return best;
}
// Frozen evidence update step (shared by the hit path and the D1 restore path).
fn cl_update(L:[]u8,s:i32,obj:i32)void {
  let v:i32=sf(L,s,2);
  if(v==obj){ sw(L,s,5,sf(L,s,5)+1); return; }
  let r:i32=sf(L,s,6)+1;
  sw(L,s,6,r);
  if(r>sf(L,s,5)){ sw(L,s,2,obj); sw(L,s,5,1); sw(L,s,6,0); }
  return;
}
// D1+D2 insertion: stamp ins on every installation; restore the key's
// checkpointed evidence if valid, then run the update step; else fresh.
fn cl_insert(L:[]u8,s:i32,subj:i32,rel:i32,obj:i32,phase:i32)void {
  let ni:i32=get32(L,8)+1;
  set32(L,8,ni);
  sw(L,s,7,ni);
  if(ck_get(L,subj,0)==1){
    sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,ck_get(L,subj,1));
    sw(L,s,3,phase); sw(L,s,4,1);
    sw(L,s,5,ck_get(L,subj,2)); sw(L,s,6,ck_get(L,subj,3));
    cl_update(L,s,obj);
    return;
  }
  sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,obj); sw(L,s,3,phase);
  sw(L,s,4,1); sw(L,s,5,1); sw(L,s,6,0);
  return;
}
fn cl_learn(L:[]u8,subj:i32,rel:i32,obj:i32,phase:i32)void {
  let s:i32=cl_find(L,subj,rel);
  if(s>=0){ cl_update(L,s,obj); return; }
  if(get32(L,0)<get32(L,12)){
    s=cl_first_empty(L);
    set32(L,0,get32(L,0)+1);
  } else {
    let e:i32=cl_evict_youngest(L);
    set32(L,4,get32(L,4)+1);
    let vs:i32=sf(L,e,0);
    evh_add(L,vs);
    // D1: checkpoint the victim's evidence before the slot is reused
    ck_set(L,vs,0,1);
    ck_set(L,vs,1,sf(L,e,2));
    ck_set(L,vs,2,sf(L,e,5));
    ck_set(L,vs,3,sf(L,e,6));
    s=e;
  }
  cl_insert(L,s,subj,rel,obj,phase);
  return;
}
fn cl_predict(L:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=cl_find(L,subj,rel);
  if(s<0){ return -1; }
  if(sf(L,s,5)>sf(L,s,6)){ return sf(L,s,2); }
  return -1;
}
// 2-hop query: answer requires composing two learned links.
fn q2(L:[]u8,s:i32)i32 {
  let p1:i32=cl_predict(L,s,1);
  if(p1<0){ return -1; }
  let p2:i32=cl_predict(L,p1,1);
  if(p2<0){ return -1; }
  return p2;
}
// ---- oracles: frozen numeric inventory (PREREG Section 3) ----
// Family-A link oracle (NTPP verbatim): 8 chains, 14 distinct links.
fn linka(s:i32)i32 {
  if(s==100){ return 101; }
  if(s==101){ return 102; }
  if(s==103){ return 101; }
  if(s==104){ return 105; }
  if(s==105){ return 106; }
  if(s==107){ return 105; }
  if(s==108){ return 109; }
  if(s==109){ return 110; }
  if(s==111){ return 112; }
  if(s==112){ return 113; }
  if(s==114){ return 115; }
  if(s==115){ return 116; }
  if(s==117){ return 118; }
  if(s==118){ return 119; }
  return -1;
}
// A-link subjs in ascending order (14).
fn ntha(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 101; }
  if(i==2){ return 103; }
  if(i==3){ return 104; }
  if(i==4){ return 105; }
  if(i==5){ return 107; }
  if(i==6){ return 108; }
  if(i==7){ return 109; }
  if(i==8){ return 111; }
  if(i==9){ return 112; }
  if(i==10){ return 114; }
  if(i==11){ return 115; }
  if(i==12){ return 117; }
  return 118;
}
// Query starts in ascending order (8).
fn nthq(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 103; }
  if(i==2){ return 104; }
  if(i==3){ return 107; }
  if(i==4){ return 108; }
  if(i==5){ return 111; }
  if(i==6){ return 114; }
  return 117;
}
// Phase-2 teachings in ascending subj order (11 slots; slot 10 is the
// RARE link, taught only on re-teach passes).
fn bsub(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 101; }
  if(i==2){ return 104; }
  if(i==3){ return 105; }
  if(i==4){ return 130; }
  if(i==5){ return 131; }
  if(i==6){ return 140; }
  if(i==7){ return 141; }
  if(i==8){ return 143; }
  if(i==9){ return 144; }
  return 148;
}
fn bobj(i:i32)i32 {
  if(i==0){ return 148; }
  if(i==1){ return 102; }
  if(i==2){ return 130; }
  if(i==3){ return 106; }
  if(i==4){ return 131; }
  if(i==5){ return 132; }
  if(i==6){ return 141; }
  if(i==7){ return 142; }
  if(i==8){ return 144; }
  if(i==9){ return 145; }
  return 152;
}
// Correct 2-hop answers under family A and under family B.
fn ansa(s:i32)i32 {
  if(s==100){ return 102; }
  if(s==103){ return 102; }
  if(s==104){ return 106; }
  if(s==107){ return 106; }
  if(s==108){ return 110; }
  if(s==111){ return 113; }
  if(s==114){ return 116; }
  return 119;
}
fn ansb(s:i32)i32 {
  if(s==100){ return 152; }
  if(s==104){ return 131; }
  return ansa(s);
}
fn isC(s:i32)i32 {
  if(s==100){ return 1; }
  if(s==104){ return 1; }
  return 0;
}
fn isNC(s:i32)i32 {
  if(s==103){ return 1; }
  if(s==107){ return 1; }
  return 0;
}
// ---- protocol ----
fn teachA(L:[]u8)void {
  let i:i32=0;
  while(i<14){
    let s:i32=ntha(i);
    cl_learn(L,s,1,linka(s),1);
    i=i+1;
  }
  return;
}
// One phase-2 pass (1-indexed). Slots 0..9 always; slot 10 (the RARE
// link 148) iff (pass-1) is a multiple of K.
fn teachB(L:[]u8,K:i32,pass:i32)void {
  let i:i32=0;
  while(i<10){ cl_learn(L,bsub(i),1,bobj(i),2); i=i+1; }
  let q:i32=(pass-1)/K;
  let r:i32=(pass-1)-q*K;
  if(r==0){ cl_learn(L,bsub(10),1,bobj(10),2); }
  return;
}
fn probeA(L:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    if(q2(L,s)==ansa(s)){ n=n+1; }
    i=i+1;
  }
  return n;
}
// FREQ novel-chain probe: q(130)=132, q(140)=142, q(143)=145.
fn bprobe(L:[]u8)i32 {
  let n:i32=0;
  if(q2(L,130)==132){ n=n+1; }
  if(q2(L,140)==142){ n=n+1; }
  if(q2(L,143)==145){ n=n+1; }
  return n;
}
// retest: out 12:c 16:nc 20:u 24:forget
fn retest(L:[]u8,out:[]u8)void {
  let c:i32=0;
  let nc:i32=0;
  let u:i32=0;
  let fg:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    let p:i32=q2(L,s);
    let a:i32=ansa(s);
    if(isC(s)==1){
      if(p==ansb(s)){ c=c+1; }
      else { if(p!=a){ fg=fg+1; } }
    } else {
      if(p==a){
        if(isNC(s)==1){ nc=nc+1; } else { u=u+1; }
      } else { fg=fg+1; }
    }
    i=i+1;
  }
  set32(out,12,c); set32(out,16,nc); set32(out,20,u); set32(out,24,fg);
  return;
}
// evictions of phase-1-link subjs 100..119 (white-box pressure audit)
fn phev(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=119){ n=n+evh_get(L,k); k=k+1; }
  return n;
}
// train family A to criterion; returns passes (negative = fail-safe hit)
fn trainA(L:[]u8)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teachA(L);
    p=p+1;
    if(probeA(L)==8){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// run one arm (reinforcement period K); out: 0 ttcA, 4 probeA, 8 nevict,
// 12 c, 16 nc, 20 u, 24 forget, 28 phev, 32 bprobe, 36 avail,
// 40..60 per-pass q(100)==152 flags p1..p6, 64 evh(148)
fn run_arm(K:i32,ob:[]u8,c:i32,tag:[]u8,out:[]u8)i32 {
  let L:[]u8=cl_new(20);
  let ttcA:i32=trainA(L);
  let pa:i32=probeA(L);
  let pp:[]u8=z_alloc(24);
  let p:i32=1;
  while(p<=6){
    teachB(L,K,p);
    let ok:i32=0;
    if(q2(L,100)==152){ ok=1; }
    set32(pp,(p-1)*4,ok);
    set32(out,40+(p-1)*4,ok);
    p=p+1;
  }
  retest(L,out);
  let av:i32=get32(pp,8)+get32(pp,12)+get32(pp,16)+get32(pp,20);
  set32(out,0,ttcA); set32(out,4,pa); set32(out,8,get32(L,4));
  set32(out,28,phev(L)); set32(out,32,bprobe(L)); set32(out,36,av);
  set32(out,64,evh_get(L,148));
  c=o_app(ob,c,"NTLV "); c=o_app(ob,c,tag);
  c=o_app(ob,c," ttcA="); c=o_i64(ob,c,ttcA as i64);
  c=o_app(ob,c," probeA="); c=o_i64(ob,c,pa as i64);
  c=o_app(ob,c," nevict="); c=o_i64(ob,c,get32(L,4) as i64);
  c=o_app(ob,c," phev="); c=o_i64(ob,c,get32(out,28) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTLV "); c=o_app(ob,c,tag);
  c=o_app(ob,c," PPROBE");
  let i:i32=0;
  while(i<6){
    c=o_app(ob,c," p"); c=o_i64(ob,c,(i+1) as i64);
    c=o_app(ob,c,"="); c=o_i64(ob,c,get32(pp,i*4) as i64);
    i=i+1;
  }
  c=o_app(ob,c," avail="); c=o_i64(ob,c,av as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTLV "); c=o_app(ob,c,tag);
  c=o_app(ob,c," RET c="); c=o_i64(ob,c,get32(out,12) as i64);
  c=o_app(ob,c," nc="); c=o_i64(ob,c,get32(out,16) as i64);
  c=o_app(ob,c," u="); c=o_i64(ob,c,get32(out,20) as i64);
  c=o_app(ob,c," forget="); c=o_i64(ob,c,get32(out,24) as i64);
  c=o_app(ob,c," bprobe="); c=o_i64(ob,c,get32(out,32) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTLV "); c=o_app(ob,c,tag); c=o_app(ob,c," EVHIST");
  let k:i32=100;
  while(k<=150){
    let h:i32=evh_get(L,k);
    if(h>0){
      c=o_app(ob,c," "); c=o_i64(ob,c,k as i64);
      c=o_app(ob,c,"="); c=o_i64(ob,c,h as i64);
    }
    k=k+1;
  }
  c=o_nl(ob,c);
  return c;
}
fn arm_learn_ok(m:[]u8)i32 {
  let ok:i32=0;
  let t:i32=get32(m,0);
  if(t>=1){ if(t<=50){ if(get32(m,4)==8){ ok=1; } } }
  return ok;
}
fn arm_ret_ok(m:[]u8)i32 {
  let ok:i32=0;
  if(get32(m,16)==2){ if(get32(m,20)==4){ ok=1; } }
  return ok;
}
fn arm_k3_ok(m:[]u8,av:i32)i32 {
  let ok:i32=0;
  if(get32(m,36)==av){ ok=1; }
  return ok;
}
fn arm_k4_ok(m:[]u8,ec:i32,ef:i32)i32 {
  let ok:i32=0;
  if(get32(m,12)==ec){ if(get32(m,24)==ef){ ok=1; } }
  return ok;
}
fn arm_k5_ok(m:[]u8,enev:i32)i32 {
  let ok:i32=0;
  if(get32(m,8)==enev){
    if(get32(m,28)==0){
      if(get32(m,64)>0){ ok=1; }
    }
  }
  return ok;
}
fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let c:i32=0;
  let m1:[]u8=z_alloc(96);
  let m2:[]u8=z_alloc(96);
  let m3:[]u8=z_alloc(96);
  let m6:[]u8=z_alloc(96);
  c=run_arm(1,ob,c,"P1",m1);
  c=run_arm(2,ob,c,"P2",m2);
  c=run_arm(3,ob,c,"P3",m3);
  c=run_arm(6,ob,c,"P6",m6);
  // ---- kill bars (PREREG Section 7) ----
  let k1:i32=1;
  if(arm_learn_ok(m1)==0){ k1=0; }
  if(arm_learn_ok(m2)==0){ k1=0; }
  if(arm_learn_ok(m3)==0){ k1=0; }
  if(arm_learn_ok(m6)==0){ k1=0; }
  let k2:i32=1;
  if(arm_ret_ok(m1)==0){ k2=0; }
  if(arm_ret_ok(m2)==0){ k2=0; }
  if(arm_ret_ok(m3)==0){ k2=0; }
  if(arm_ret_ok(m6)==0){ k2=0; }
  let k3:i32=1;
  if(arm_k3_ok(m1,4)==0){ k3=0; }
  if(arm_k3_ok(m2,2)==0){ k3=0; }
  if(arm_k3_ok(m3,1)==0){ k3=0; }
  if(arm_k3_ok(m6,0)==0){ k3=0; }
  let k4:i32=1;
  if(arm_k4_ok(m1,2,0)==0){ k4=0; }
  if(arm_k4_ok(m2,1,1)==0){ k4=0; }
  if(arm_k4_ok(m3,1,1)==0){ k4=0; }
  if(arm_k4_ok(m6,1,1)==0){ k4=0; }
  let k5:i32=1;
  if(arm_k5_ok(m1,11)==0){ k5=0; }
  if(arm_k5_ok(m2,6)==0){ k5=0; }
  if(arm_k5_ok(m3,4)==0){ k5=0; }
  if(arm_k5_ok(m6,2)==0){ k5=0; }
  let k6:i32=1;
  if(get32(m1,36)!=4){ k6=0; }
  if(get32(m1,8)<=0){ k6=0; }
  if(get32(m2,8)<=0){ k6=0; }
  if(get32(m3,8)<=0){ k6=0; }
  if(get32(m6,8)<=0){ k6=0; }
  c=o_app(ob,c,"NTLV K1="); c=o_i64(ob,c,k1 as i64);
  c=o_app(ob,c," K2="); c=o_i64(ob,c,k2 as i64);
  c=o_app(ob,c," K3="); c=o_i64(ob,c,k3 as i64);
  c=o_app(ob,c," K4="); c=o_i64(ob,c,k4 as i64);
  c=o_app(ob,c," K5="); c=o_i64(ob,c,k5 as i64);
  c=o_app(ob,c," K6="); c=o_i64(ob,c,k6 as i64);
  c=o_nl(ob,c);
  // verdict code: 0 VOID, 1 INCONCLUSIVE, 2 FAIL-RETENTION,
  // 3 FAIL-PRESSURE, 4 INFORMATIVE-FAIL, 5 NO-LIABILITY,
  // 6 LIABILITY-CONFIRMED. Assigned in reverse priority order so the
  // highest-priority matching condition wins (flat, 1-deep ifs).
  let v:i32=6;
  if(k3==0){ v=5; }
  if(k4==0){ v=4; }
  if(k5==0){ v=3; }
  if(k2==0){ v=2; }
  if(k6==0){ v=1; }
  if(k1==0){ v=0; }
  c=o_app(ob,c,"NTLV VERDICT=");
  if(v==0){ c=o_app(ob,c,"VOID"); }
  if(v==1){ c=o_app(ob,c,"INCONCLUSIVE"); }
  if(v==2){ c=o_app(ob,c,"FAIL-RETENTION"); }
  if(v==3){ c=o_app(ob,c,"FAIL-PRESSURE"); }
  if(v==4){ c=o_app(ob,c,"INFORMATIVE-FAIL"); }
  if(v==5){ c=o_app(ob,c,"NO-LIABILITY"); }
  if(v==6){ c=o_app(ob,c,"LIABILITY-CONFIRMED"); }
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTLV-END");
  c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}

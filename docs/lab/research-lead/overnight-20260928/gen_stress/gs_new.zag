  fact_add(A,205,91,211); fact_add(A,205,91,212);
  fact_add(A,231,94,232);
  map_new(A,0,1,91,0); map_new(A,1,4,0,0); map_new(A,2,3,0,0);
  teach(A,0,205,2); teach2(A,1,205,205,410); teach(A,2,231,231);

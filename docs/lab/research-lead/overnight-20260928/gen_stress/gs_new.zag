  fact_add(A,211,92,221); fact_add(A,211,92,222); fact_add(A,211,92,223);
  fact_add(A,211,93,231); fact_add(A,211,93,232);
  fact_add(A,211,94,214);
  fact_add(A,214,95,241);
  map_new(A,0,1,92,0); map_new(A,1,1,93,0); map_new(A,2,0,94,0);
  map_new(A,3,4,0,0); map_new(A,4,0,91,0); map_new(A,5,4,0,0);
  teach(A,4,202,211); teach(A,0,211,3); teach(A,1,211,2); teach(A,2,211,214);
  teach2(A,5,3,2,5); teach2(A,3,5,214,219);
  return;
}

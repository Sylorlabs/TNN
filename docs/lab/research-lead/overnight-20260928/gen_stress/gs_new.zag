fn setup_s5(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,201,91,212);
  fact_add(A,201,92,221); fact_add(A,201,92,222); fact_add(A,201,92,223);
  fact_add(A,231,93,232);
  map_new(A,0,1,91,0); map_new(A,1,1,92,0); map_new(A,2,4,0,0); map_new(A,3,3,0,0);
  teach(A,0,201,2); teach(A,1,201,3); teach2(A,2,2,3,5); teach(A,3,231,231);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_s1(A1);
  c=gen_solve(A1,B,c,201,1,2,2,6);
  c=gen_report(A1,B,c,"GEN","S1");
  let A2:[]u8=world_new();
  setup_s2(A2);
  c=gen_solve(A2,B,c,202,1,2,219,6);
  c=gen_report(A2,B,c,"GEN","S2");
  let A3:[]u8=world_new();
  setup_s3(A3);
  c=gen_solve(A3,B,c,205,1,2,207,3);
  c=gen_report(A3,B,c,"GEN","S3");
  let A4:[]u8=world_new();
  setup_s4(A4);
  c=gen_solve(A4,B,c,201,1,2,2,8);
  c=gen_report(A4,B,c,"GEN","S4");
  let A5:[]u8=world_new();
  setup_s5(A5);
  c=gen_solve(A5,B,c,201,1,2,999999,4);
  c=gen_report(A5,B,c,"GEN","S5");
  o_flush(B,c);
  return 0;
}

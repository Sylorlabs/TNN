// gs_new.zag -- GEN-STRESS driver: world setups + main only.
// No mechanism code. Structures are m0..m7; relations are bare integers;
// entities are bare integers. No domain vocabulary anywhere in this file.
// Setups frozen in PREREG.md Section 5.
fn setup_s1(A:[]u8)void {
  fact_add(A,201,91,211);
  fact_add(A,211,92,212);
  fact_add(A,212,93,213);
  fact_add(A,213,94,214);
  fact_add(A,214,95,215); fact_add(A,214,95,216);
  fact_add(A,231,96,232);
  map_new(A,0,0,91,0); map_new(A,1,0,92,0); map_new(A,2,0,93,0);
  map_new(A,3,0,94,0); map_new(A,4,1,95,0); map_new(A,5,3,0,0);
  teach(A,0,201,211); teach(A,1,211,212); teach(A,2,212,213);
  teach(A,3,213,214); teach(A,4,214,2); teach(A,5,231,231);
  return;
}

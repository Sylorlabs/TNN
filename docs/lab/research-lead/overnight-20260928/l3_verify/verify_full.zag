// learner.zag -- consequence-driven intermediate-construction learner (L3-VERIFY).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no per-episode outcome bits in this file.
// The learner verifies candidate intermediates ONLY through aggregate
// coin consequences returned by the two world-side oracles
// w_conseq_train / w_conseq_test. It never observes a per-episode
// outcome or any supplied right-answer bit.
// Prereg: l3_verify/PREREG.md (frozen commit 6467fc547). Pure Zag.
// 0 modes, 0 cross-structure glue, 0 new semantic cases.
//
// State layout (u8 buffer, offsets):
//   0: XN (train episode count)  1: XNT (test episode count)
//   2: CONF (confidence)         3: RETAINED flag
//   4..163:   X train slots, 32 x 5 bytes [id,e0,e1,e2,e3]
//   164..243: X test slots, 16 x 5 bytes [id,e0,e1,e2,e3]
//   244..247: bestC i32 (incumbent consequence)
//   248..279: M slot, 32 bytes [n,u8 gen,u8 sup,u8 pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   280..311: Mprev slot, 32 bytes (same layout; revision history)
//   312..1023: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer; sequences only) ----
fn x_teach(st:[]u8, region:i32, id:i32, e0:i32, e1:i32, e2:i32, e3:i32)void {
  let base:i32=4;
  let cap:i32=32;
  let cnt:i32=0;
  if(region==0){ cnt=st[0] as i32; }
  else { base=164; cap=16; cnt=st[1] as i32; }
  if(cnt>=cap){return;}
  let o:i32=base+cnt*5;
  st[o]=id as u8; st[o+1]=e0 as u8; st[o+2]=e1 as u8;
  st[o+3]=e2 as u8; st[o+4]=e3 as u8;
  if(region==0){ st[0]=(cnt+1) as u8; } else { st[1]=(cnt+1) as u8; }
  return;
}
fn x_count(st:[]u8, region:i32)i32 {
  if(region==0){return st[0] as i32;}
  return st[1] as i32;
}
fn x_get(st:[]u8, region:i32, idx:i32, out:[]u8)i32 {
  let base:i32=4;
  if(region==1){base=164;}
  let o:i32=base+idx*5;
  out[0]=st[o+1]; out[1]=st[o+2]; out[2]=st[o+3]; out[3]=st[o+4];
  return st[o] as i32;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R3 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, e0:i32, e1:i32, e2:i32, e3:i32, rg:[]u8)i32 {
  set32(rg,0,e0); set32(rg,4,e1); set32(rg,8,e2); set32(rg,12,e3);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
// Program outputs on the taught train episodes (for threshold sweeps).
fn p_outs_train(prog:[]u8, n:i32, st:[]u8, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let ne:i32=st[0] as i32;
  let i:i32=0;
  while(i<ne){
    x_get(st,0,i,sq);
    let v:i32=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
// Sorted ascending unique values.
fn uniq_asc(vals:[]u8, n:i32, uq:[]u8)i32 {
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=get32(vals,i*4);
    let j:i32=0;
    let seen:i32=0;
    while(j<nu){
      if(get32(uq,j*4)==v){seen=1;}
      j=j+1;
    }
    if(seen==0){set32(uq,nu*4,v);nu=nu+1;}
    i=i+1;
  }
  let a:i32=0;
  while(a<nu){
    let b:i32=a+1;
    while(b<nu){
      if(get32(uq,b*4)<get32(uq,a*4)){
        let tmp:i32=get32(uq,a*4);
        set32(uq,a*4,get32(uq,b*4));
        set32(uq,b*4,tmp);
      }
      b=b+1;
    }
    a=a+1;
  }
  return nu;
}

// ---- consequence-driven threshold fit ----
// For each candidate threshold (sorted unique program outputs,
// ascending), ask the world oracle for the aggregate coin consequence
// of deploying (prog,t). First-max wins. The learner sees only the
// scalar consequence per query. tout (4B) gets bestT; returns bestC.
fn fit_conseq(st:[]u8, prog:[]u8, n:i32, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, tout:[]u8)i32 {
  let ne:i32=st[0] as i32;
  p_outs_train(prog,n,st,rg,sq,vals);
  let nu:i32=uniq_asc(vals,ne,uq);
  let bc:i32=-1000000;
  let bt:i32=0;
  let i:i32=0;
  while(i<nu){
    let t:i32=get32(uq,i*4);
    let c:i32=w_conseq_train(prog,n,t);
    if(c>bc){bc=c;bt=t;}
    i=i+1;
  }
  set32(tout,0,bt);
  return bc;
}

// ---- construct: greedy program construction, consequence-driven ----
// mbuf (24B) gets the final program; mout: [0]=n [4]=threshold [8]=consequence.
// Trace lines appended to ob; returns new at.
fn construct(st:[]u8, init:[]u8, initn:i32, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  let bto:[]u8=z_alloc(4);
  let bs:i32=fit_conseq(st,cur,cn,rg,sq,vals,uq,bto);
  let bt:i32=get32(bto,0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            let cto:[]u8=z_alloc(4);
            let cs:i32=fit_conseq(st,cand,cn+1,rg,sq,vals,uq,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      at=ob_app(ob,at,"C-ROUND ");
      at=ob_i32(ob,at,round);
      at=ob_app(ob,at," base=");
      at=ob_i32(ob,at,bs);
      at=ob_app(ob,at," eval=");
      at=ob_i32(ob,at,neval);
      if(bg>0){
        at=ob_app(ob,at," win=");
        at=ob_i32(ob,at,bop);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bd);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bss);
        at=ob_app(ob,at," gain=");
        at=ob_i32(ob,at,bg);
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        bs=fit_conseq(st,cur,cn,rg,sq,vals,uq,bto);
        bt=get32(bto,0);
        at=ob_app(ob,at," score=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,bt);
        at=ob_nl(ob,at);
      } else {
        at=ob_app(ob,at," stop");
        at=ob_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[248]=n as u8; st[249]=gen as u8; st[250]=0; st[251]=0;
  set32(st,252,t);
  let k:i32=0;
  while(k<24){st[256+k]=prog[k];k=k+1;}
  return;
}
fn m_copy_to_prev(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[280+k]=st[248+k];k=k+1;}
  st[282]=1;
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[248+k]=0;k=k+1;}
  return;
}
fn m_prog_get(st:[]u8, out:[]u8)void {
  let k:i32=0;
  while(k<24){out[k]=st[256+k];k=k+1;}
  return;
}
fn m_bytes_equal(st:[]u8, snap:[]u8)i32 {
  // Structural identity only (PREREG.md section 6, K-V3; FORAGE
  // ERRATUM-1 rationale): n, gen, sup, pad, and the 24 program bytes.
  // The threshold field is the adaptive decision parameter and is
  // excluded here.
  let k:i32=0;
  while(k<4){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  k=8;
  while(k<32){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  return 1;
}
fn m_snap(st:[]u8, snap:[]u8)void {
  let k:i32=0;
  while(k<32){snap[k]=st[248+k];k=k+1;}
  return;
}

// ---- confidence policy (generic; no modes) ----
fn l_observe(st:[]u8, c:i32)void {
  let bc:i32=get32(st,244);
  if(c>bc){
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
  }
  return;
}
// Returns 1 if a revision happened, else 0.
fn l_revise(st:[]u8, mbuf:[]u8, n:i32, t:i32, c:i32, ob:[]u8, at:i32, rout:[]u8)i32 {
  let bc:i32=get32(st,244);
  if(c>bc){
    m_copy_to_prev(st);
    let g:i32=(st[249] as i32)+1;
    m_write(st,n,g,t,mbuf);
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
    at=ob_app(ob,at,"REVISE old-C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," new-C=");
    at=ob_i32(ob,at,c);
    at=ob_nl(ob,at);
    set32(rout,0,1);
  } else {
    set32(rout,0,0);
  }
  return at;
}
// Deploy (prog,t) to the world; test=0 train region, test=1 held-out.
// The only values ever returned are aggregate coin consequences.
fn l_deploy(st:[]u8, prog:[]u8, n:i32, t:i32, test:i32)i32 {
  if(test==0){return w_conseq_train(prog,n,t);}
  return w_conseq_test(prog,n,t);
}
fn l_deploy_eval(st:[]u8, c:i32)void {
  if(c>0){st[3]=1;} else {st[3]=0;}
  return;
}
fn l_can_decide(st:[]u8)i32 {
  if((st[248] as i32)==0){return 0;}
  return 1;
}
// world.zag -- SETTLE environment (EXPERIMENT SIDE ONLY).
// Frozen episode tables, the hidden margin rule, aggregate coin
// consequence oracles, and menu controls.
// The learner never calls anything in this file except the two coin
// oracles w_conseq_train / w_conseq_test, which return ONLY aggregate
// coin totals. The learner never sees per-episode margins or outcomes.
// Tables match l3_verify/PREREG.md section 2 exactly.
// Hidden rule: margin(ep) = e0 + e1 - e2. Deploying CLEAR on an episode
// settles it for its margin in coins (negative margin = loss); HOLD
// settles nothing.

// w_val(ph, idx, c): ph=1 train (8 episodes), ph=2 test (4 episodes).
fn w_val(ph:i32, idx:i32, c:i32)i32 {
  if(ph==1){
    if(idx==0){ if(c==0){return 2;} if(c==1){return 7;} if(c==2){return 3;} return 0; }
    if(idx==1){ if(c==0){return 8;} if(c==1){return 1;} if(c==2){return 4;} return 1; }
    if(idx==2){ if(c==0){return 1;} if(c==1){return 6;} if(c==2){return 3;} return 5; }
    if(idx==3){ if(c==0){return 6;} if(c==1){return 0;} if(c==2){return 3;} return 3; }
    if(idx==4){ if(c==0){return 7;} if(c==1){return 4;} if(c==2){return 15;} return 0; }
    if(idx==5){ if(c==0){return 4;} if(c==1){return 3;} if(c==2){return 10;} return 1; }
    if(idx==6){ if(c==0){return 3;} if(c==1){return 2;} if(c==2){return 7;} return 2; }
    if(c==0){return 3;} if(c==1){return 0;} if(c==2){return 4;} return 3;
  }
  if(idx==0){ if(c==0){return 4;} if(c==1){return 5;} if(c==2){return 2;} return 0; }
  if(idx==1){ if(c==0){return 1;} if(c==1){return 1;} if(c==2){return 5;} return 0; }
  if(idx==2){ if(c==0){return 6;} if(c==1){return 2;} if(c==2){return 3;} return 1; }
  if(c==0){return 2;} if(c==1){return 3;} if(c==2){return 8;} return 2;
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
// Hidden margin (world side only; never passed to the learner).
fn w_margin(ph:i32, idx:i32)i32 {
  return w_val(ph,idx,0)+w_val(ph,idx,1)-w_val(ph,idx,2);
}

// Aggregate coin consequence of deploying (prog,t) on a region.
// This is the ONLY channel from world to learner.
fn w_conseq_train(prog:[]u8, n:i32, t:i32)i32 {
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<8){
    let v:i32=p_exec(prog,n,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3),rg);
    if(v>=t){coins=coins+w_margin(1,i);}
    i=i+1;
  }
  return coins;
}
fn w_conseq_test(prog:[]u8, n:i32, t:i32)i32 {
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<4){
    let v:i32=p_exec(prog,n,w_val(2,i,0),w_val(2,i,1),w_val(2,i,2),w_val(2,i,3),rg);
    if(v>=t){coins=coins+w_margin(2,i);}
    i=i+1;
  }
  return coins;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}
// driver.zag -- L3-VERIFY experiment driver.
// Stage protocol: inherit wrong M0, deploy it, observe consequence;
// construct M1 through consequence queries only; revise on better
// consequence; deploy M1 on held-out episodes; retain on positive
// consequence. Arms: NOM (wiped M), MENU (5 controls). Kill-bar summary.
// The driver teaches X, seeds M0 (experiment side), and evaluates arms.
// It never invents the intermediate: all construction goes through the
// learner's consequence-driven construct(). Pure Zag.

fn d_teach(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let region:i32=0;
  if(ph==2){region=1;}
  let i:i32=0;
  while(i<n){
    let id:i32=w_id(ph,i);
    x_teach(st,region,id,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3));
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[248] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[249] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[250] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[256+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_mprev_dump(st:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"MPREV n=");
  at=ob_i32(ob,at,(st[280] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[281] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[282] as i32));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=ob_i32(ob,at,(st[288+k] as i32));
    if(k<5){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side uniqueness sweep: appends after [SUB R0,R2].
// Counts d=0 appends reaching C=18 (frozen: exactly 1).
fn d_uniq_append(st:[]u8, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32)i32 {
  let base:[]u8=z_alloc(24);
  base[0]=2; base[1]=0; base[2]=2;
  let cnt:i32=0;
  let op:i32=0;
  while(op<5){
    let s:i32=0;
    while(s<4){
      let cand:[]u8=z_alloc(24);
      cand[0]=2; cand[1]=0; cand[2]=2;
      cand[3]=op as u8; cand[4]=0; cand[5]=s as u8;
      let cto:[]u8=z_alloc(4);
      let c:i32=fit_conseq(st,cand,2,rg,sq,vals,uq,cto);
      if(c==18){cnt=cnt+1;}
      s=s+1;
    }
    op=op+1;
  }
  at=ob_app(ob,at,"UNIQ-APPEND-18 n=");
  at=ob_i32(ob,at,cnt);
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side menu control evaluation (controls, not learner).
fn d_menu(st:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32, worst:[]u8)i32 {
  let ne:i32=8;
  let k:i32=0;
  while(k<5){
    let i:i32=0;
    while(i<ne){
      set32(vals,i*4,menu_agg(k,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3)));
      i=i+1;
    }
    let nu:i32=uniq_asc(vals,ne,uq);
    let bc:i32=-1000000;
    let bt:i32=0;
    let j:i32=0;
    while(j<nu){
      let t:i32=get32(uq,j*4);
      let c:i32=0;
      i=0;
      while(i<ne){
        if(get32(vals,i*4)>=t){c=c+w_margin(1,i);}
        i=i+1;
      }
      if(c>bc){bc=c;bt=t;}
      j=j+1;
    }
    at=ob_app(ob,at,"MENU ");
    at=ob_app(ob,at,menu_name(k));
    at=ob_app(ob,at," C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,bt);
    at=ob_nl(ob,at);
    if(bc>get32(worst,0)){set32(worst,0,bc);}
    k=k+1;
  }
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let uq:[]u8=z_alloc(64);
  at=ob_app(ob,at,"V-START\n");

  // ================= STAGE 0: inherit wrong M0, deploy, observe =================
  at=ob_app(ob,at,"=== STAGE 0 inherit ===\n");
  let st:[]u8=z_alloc(1024);
  at=d_teach(st,1,ob,at);
  at=ob_app(ob,at,"X-TRAIN n=");
  at=ob_i32(ob,at,x_count(st,0));
  at=ob_nl(ob,at);
  // M0 = [ADD R0,R2] seeded experiment-side (FORAGE's solution; wrong here).
  let m0:[]u8=z_alloc(24);
  m0[0]=1; m0[1]=0; m0[2]=2;
  m_write(st,1,0,0,m0);
  at=ob_app(ob,at,"M0-SEED prog=1,0,2\n");
  let t0o:[]u8=z_alloc(4);
  let c0:i32=fit_conseq(st,m0,1,rg,sq,vals,uq,t0o);
  let t0:i32=get32(t0o,0);
  set32(st,252,t0);
  at=ob_app(ob,at,"M0-FIT t=");
  at=ob_i32(ob,at,t0);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c0);
  at=ob_nl(ob,at);
  let c0d:i32=l_deploy(st,m0,1,t0,0);
  l_observe(st,c0d);
  at=ob_app(ob,at,"M0-DEPLOY C=");
  at=ob_i32(ob,at,c0d);
  at=ob_app(ob,at," bestC=");
  at=ob_i32(ob,at,get32(st,244));
  at=ob_app(ob,at," conf=");
  at=ob_i32(ob,at,(st[2] as i32));
  at=ob_nl(ob,at);

  // ================= STAGE 1: construct via consequences, revise =================
  at=ob_app(ob,at,"=== STAGE 1 construct+revise ===\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st,init,0,rg,sq,vals,uq,mbuf,mout,ob,at);
  let n1:i32=get32(mout,0);
  let t1:i32=get32(mout,4);
  let c1:i32=get32(mout,8);
  at=ob_app(ob,at,"M1-BUILT n=");
  at=ob_i32(ob,at,n1);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,t1);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c1);
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=ob_i32(ob,at,(mbuf[k] as i32));
    if(k<5){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  let rout:[]u8=z_alloc(4);
  at=l_revise(st,mbuf,n1,t1,c1,ob,at,rout);
  let revised:i32=get32(rout,0);
  at=d_m_dump(st,"M",ob,at);
  at=d_mprev_dump(st,ob,at);
  at=d_uniq_append(st,rg,sq,vals,uq,ob,at);

  // ================= STAGE 2: deploy M1 on held-out episodes =================
  at=ob_app(ob,at,"=== STAGE 2 deploy held-out ===\n");
  at=d_teach(st,2,ob,at);
  at=ob_app(ob,at,"X-TEST n=");
  at=ob_i32(ob,at,x_count(st,1));
  at=ob_nl(ob,at);
  let snap:[]u8=z_alloc(32);
  m_snap(st,snap);
  let m1:[]u8=z_alloc(24);
  m_prog_get(st,m1);
  let mn1:i32=st[248] as i32;
  let mt1:i32=get32(st,252);
  let ct:i32=l_deploy(st,m1,mn1,mt1,1);
  l_deploy_eval(st,ct);
  at=ob_app(ob,at,"TEST-DEPLOY C=");
  at=ob_i32(ob,at,ct);
  at=ob_app(ob,at," retained=");
  at=ob_i32(ob,at,(st[3] as i32));
  at=ob_nl(ob,at);
  let beq:i32=m_bytes_equal(st,snap);
  at=ob_app(ob,at,"M-BYTES-EQUAL ");
  at=ob_i32(ob,at,beq);
  at=ob_nl(ob,at);

  // ================= ARMS =================
  at=ob_app(ob,at,"=== ARMS ===\n");
  let stn:[]u8=z_alloc(1024);
  at=d_teach(stn,1,ob,at);
  m_wipe(stn);
  let nom_c:i32=0;
  if(l_can_decide(stn)==0){nom_c=0;}
  at=ob_app(ob,at,"ARM-NOM C=");
  at=ob_i32(ob,at,nom_c);
  at=ob_nl(ob,at);
  let worst:[]u8=z_alloc(4);
  set32(worst,0,-1000000);
  at=d_menu(st,vals,uq,ob,at,worst);
  let wmenu:i32=get32(worst,0);

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KBARS ===\n");
  at=ob_app(ob,at,"K-V1 SHELL-AUDIT\n");
  // K-V2: wrong M revised.
  let kv2:i32=0;
  if(revised==1){ if(n1==2){ if(t1==3){ if(c1==18){ if(c0d==8){ kv2=1; } } } } }
  if((mbuf[0] as i32)!=2){kv2=0;}
  if((mbuf[1] as i32)!=0){kv2=0;}
  if((mbuf[2] as i32)!=2){kv2=0;}
  if((mbuf[3] as i32)!=1){kv2=0;}
  if((mbuf[4] as i32)!=0){kv2=0;}
  if((mbuf[5] as i32)!=1){kv2=0;}
  if((st[282] as i32)!=1){kv2=0;}
  if((st[288] as i32)!=1){kv2=0;}
  if((st[289] as i32)!=0){kv2=0;}
  if((st[290] as i32)!=2){kv2=0;}
  at=ob_app(ob,at,"K-V2 ");
  if(kv2==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-V3: correct M retained.
  let kv3:i32=0;
  if(ct==12){ if((st[3] as i32)==1){ if(beq==1){ kv3=1; } } }
  at=ob_app(ob,at,"K-V3 ");
  if(kv3==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-V4: necessity.
  let kv4:i32=0;
  if(nom_c==0){ if(wmenu<=9){ kv4=1; } }
  at=ob_app(ob,at,"K-V4 ");
  if(kv4==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  at=ob_app(ob,at,"K-V5 SHELL-3X\n");
  at=ob_app(ob,at,"V-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// lw2.zag : LW2 learner invention of the try-and-keep policy (W4).
// Tests whether the learner discovers try-and-keep from experience,
// without a researcher-supplied schedule. Four conditions:
//   scheduled : fixed try-measure-keep schedule over both slots (control)
//   bandit    : argmax over persistent action values, one atomic action
//               per episode (LW1 section 9 recommended test)
//   construct : exhaustive search over a 5-step conditional policy space,
//               scored by the learner's own selftest; retain best
//   nodriver  : same as construct but retention disabled (keep policy 0)
// Pure Zag. Zero RNG. All data literal. Deterministic.
// Build: znc lw2.zag -o lw2_bin --no-analyze
// Output: single preallocated buffer, one raw syscall write. No _zag_print.

// ---------- local allocator on _zag_malloc (zeroed u8 buffer) ----------
fn lw_alloc(n:i64)[]u8{
    if(n<1){ return ""; }
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){ return ""; }
    let b:[]u8=p[0..n];
    let i:i64=0;
    while(i<n){ b[i]=0; i=i+1; }
    return b;
}

// ---------- byte helpers: little-endian i64 cells in u8 buffers ----------
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}

// ---------- single-buffer emit helpers (cursor-returning) ----------
fn e1str(b:[]u8,c:i64,s:[]u8)i64{
    let i:i64=0;
    let n:i64=s.len as i64;
    while(i<n){ b[c+i]=s[i]; i=i+1; }
    return c+n;
}
fn e1i64(b:[]u8,c:i64,v:i64)i64{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){ neg=1; x=0-x; }
    let n:i64=0;
    let t:i64=x;
    if(t==0){ n=1; } else { while(t>0){ n=n+1; t=t/10; } }
    let p:i64=c+neg+n-1;
    t=x;
    if(t==0){ b[p]=48; } else { while(t>0){ b[p]=((t%10)+48) as u8; p=p-1; t=t/10; } }
    if(neg==1){ b[c]=45; }
    return c+neg+n;
}

// ---------- data loading: ascii digit literals -> values 0..3 ----------
fn load4(dst:[]u8,dat:[]u8,n:i64)void{
    let i:i64=0;
    let m:i64=n*4;
    while(i<m){ dst[i]=((dat[i] as i64)-48) as u8; i=i+1; }
}
fn load1(dst:[]u8,dat:[]u8,n:i64)void{
    let i:i64=0;
    while(i<n){ dst[i]=((dat[i] as i64)-48) as u8; i=i+1; }
}

// ---------- world helper: max symbol count in a 4-symbol string ----------
fn maxcount(s:[]u8,at:i64)i64{
    let c0:i64=0;
    let c1:i64=0;
    let c2:i64=0;
    let c3:i64=0;
    let i:i64=0;
    while(i<4){
        let v:i64=s[at+i] as i64;
        if(v==0){ c0=c0+1; } else { if(v==1){ c1=c1+1; } else { if(v==2){ c2=c2+1; } else { c3=c3+1; } } }
        i=i+1;
    }
    let m:i64=c0;
    if(c1>m){ m=c1; }
    if(c2>m){ m=c2; }
    if(c3>m){ m=c3; }
    return m;
}

// ---------- hypothesis kinds ----------
// kind 1 = MAXCOUNT(k): reject iff maxcount > k
// kind 2 = ALLDISTINCT-NOT: reject iff maxcount == 1 (all symbols distinct)
fn hyp_reject(hkind:i64,hparam:i64,s:[]u8,at:i64)i64{
    if(hkind==1){
        if(maxcount(s,at)>hparam){ return 1; }
        return 0;
    }
    if(hkind==2){
        if(maxcount(s,at)==1){ return 1; }
        return 0;
    }
    return 0;
}

// ---------- Occam selection over k=1..3: first k separating TRAIN ----------
fn occam(str:[]u8,lab:[]u8,n:i64)i64{
    let k:i64=1;
    while(k<=3){
        let ok:i64=1;
        let i:i64=0;
        while(i<n){
            let rej:i64=hyp_reject(1,k,str,i*4);
            let want:i64=0;
            if(lab[i]==0){ want=1; }
            if(rej!=want){ ok=0; }
            i=i+1;
        }
        if(ok==1){ return k; }
        k=k+1;
    }
    return 0;
}

// ---------- judge: the generation path. 1=ACCEPT, 0=REJECT ----------
// Reads only the learner-owned consultation list. hyp store has 2 slots;
// each record is 24 bytes: [kind, param, valid].
fn judge(s:[]u8,at:i64,consult:[]u8,cn:i64,hyp:[]u8)i64{
    let i:i64=0;
    while(i<cn){
        let hid:i64=get64(consult,i*8);
        if(hid>=0){
            if(hid<2){
                if(hyp_reject(get64(hyp,hid*24),get64(hyp,hid*24+8),s,at)==1){ return 0; }
            }
        }
        i=i+1;
    }
    return 1;
}

// ---------- learner-owned evaluation over VALID (world labels = experience) ----------
fn selftest(vstr:[]u8,vlab:[]u8,vn:i64,consult:[]u8,cn:i64,hyp:[]u8)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<vn){
        let v:i64=judge(vstr,i*4,consult,cn,hyp);
        if(v==(vlab[i] as i64)){ c=c+1; }
        i=i+1;
    }
    return c;
}

// ---------- wiring actions on the consultation list ----------
// wire(h): append h if not present and space remains. Returns new count.
// unwire_h(h): remove h if present (shift left). Returns new count.
fn wire(consult:[]u8,cn:i64,hid:i64)i64{
    let i:i64=0;
    while(i<cn){
        if(get64(consult,i*8)==hid){ return cn; }
        i=i+1;
    }
    if(cn>=4){ return cn; }
    put64(consult,cn*8,hid);
    return cn+1;
}
fn unwire_h(consult:[]u8,cn:i64,hid:i64)i64{
    let i:i64=0;
    while(i<cn){
        if(get64(consult,i*8)==hid){
            let j:i64=i;
            while(j<cn-1){
                put64(consult,j*8,get64(consult,(j+1)*8));
                j=j+1;
            }
            put64(consult,(cn-1)*8,-1);
            return cn-1;
        }
        i=i+1;
    }
    return cn;
}
fn clear_list(consult:[]u8)i64{
    let i:i64=0;
    while(i<4){ put64(consult,i*8,-1); i=i+1; }
    return 0;
}

// ---------- episode setup: load hyp slots per episode type ----------
// etype 0=A: slot0=helpful, slot1=harmful
// etype 1=B: slot0=harmful,  slot1=neutral
// etype 2=C: slot0=helpful, slot1=helpful
// etype 3=D: slot0=harmful,  slot1=harmful
// helpful = (kind1, k_occam); harmful = (kind2, 0); neutral = (kind1, 3)
fn setup_episode(hyp:[]u8,etype:i64,khelp:i64)void{
    if(etype==0){
        put64(hyp,0,1); put64(hyp,8,khelp); put64(hyp,16,1);
        put64(hyp,24,2); put64(hyp,32,0); put64(hyp,40,1);
    }
    if(etype==1){
        put64(hyp,0,2); put64(hyp,8,0); put64(hyp,16,1);
        put64(hyp,24,1); put64(hyp,32,3); put64(hyp,40,1);
    }
    if(etype==2){
        put64(hyp,0,1); put64(hyp,8,khelp); put64(hyp,16,1);
        put64(hyp,24,1); put64(hyp,32,khelp); put64(hyp,40,1);
    }
    if(etype==3){
        put64(hyp,0,2); put64(hyp,8,0); put64(hyp,16,1);
        put64(hyp,24,2); put64(hyp,32,0); put64(hyp,40,1);
    }
}

// ---------- policy alphabet ----------
// 0=EVAL, 1=WIRE0, 2=WIRE1, 3=UNWIRE0, 4=UNWIRE1, 5=IFB, 6=IDLE
// IFB: if R0 > R1, skip the next step; else execute it.
fn decode(p:i64,steps:[]u8)void{
    let d:i64=2401;
    let i:i64=0;
    let q:i64=p;
    while(i<5){
        steps[i]=(q/d) as u8;
        q=q%d;
        d=d/7;
        i=i+1;
    }
}

// run a 5-step policy on one episode; list cleared and R0=R1=-1 at start.
// returns final selftest score.
fn run_policy(steps:[]u8,vstr:[]u8,vlab:[]u8,consult:[]u8,hyp:[]u8)i64{
    let cn:i64=clear_list(consult);
    let r0:i64=-1;
    let r1:i64=-1;
    let i:i64=0;
    while(i<5){
        let a:i64=steps[i] as i64;
        let ni:i64=i+1;
        if(a==0){ r1=r0; r0=selftest(vstr,vlab,6,consult,cn,hyp); }
        if(a==1){ cn=wire(consult,cn,0); }
        if(a==2){ cn=wire(consult,cn,1); }
        if(a==3){ cn=unwire_h(consult,cn,0); }
        if(a==4){ cn=unwire_h(consult,cn,1); }
        if(a==5){ if(r0>r1){ ni=i+2; } }
        i=ni;
    }
    return selftest(vstr,vlab,6,consult,cn,hyp);
}

// ---------- bandit value comparison: is value(a) strictly greater? ----------
// value = sums/counts; untried (count 0) counts as 0. All sums >= 0.
fn vbetter(sa:i64,ca:i64,sb:i64,cb:i64)i64{
    if(ca==0){
        return 0;
    }
    if(cb==0){
        if(sa>0){ return 1; }
        return 0;
    }
    if(sa*cb>sb*ca){ return 1; }
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let cond:i64=-1;
    if(_zag_strcmp(a1,"scheduled")==1){ cond=0; }
    if(_zag_strcmp(a1,"bandit")==1){ cond=1; }
    if(_zag_strcmp(a1,"construct")==1){ cond=2; }
    if(_zag_strcmp(a1,"nodriver")==1){ cond=3; }
    let out:[]u8=lw_alloc(1024);
    let c:i64=0;
    if(cond<0){
        c=e1str(out,c,"LW2|error=bad-cond|use=scheduled|bandit|construct|nodriver\n");
        let w0:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(out) as i64),c,0,0,0);
        if(w0<0){ return 3; }
        return 2;
    }
    // data: all literals (see PREREG section 3; same TRAIN/VALID as LW1)
    let tstr:[]u8=lw_alloc(48);
    let tlab:[]u8=lw_alloc(12);
    let vstr:[]u8=lw_alloc(24);
    let vlab:[]u8=lw_alloc(6);
    load4(tstr,"012301320213102312032013001211032231332001012323",12);
    load1(tlab,"111111000000",12);
    load4(vstr,"230130123012001122021313",6);
    load1(vlab,"111000",6);
    // learner state: hyp store = 2 records x 24B [kind,param,valid];
    // consultation list = 4 slots x 8B.
    let hyp:[]u8=lw_alloc(48);
    let consult:[]u8=lw_alloc(32);
    // acquire helpful content once via Occam (learner-determined, as in LW1)
    let khelp:i64=occam(tstr,tlab,12);
    // training episodes: A,B,A,B -> etypes 0,1,0,1 ; held-out: C,D -> 2,3
    let ts0:i64=0; let ts1:i64=0; let ts2:i64=0; let ts3:i64=0;
    let hs0:i64=0; let hs1:i64=0;
    let e:i64=0;
    // per-condition extras for the report
    let b_act0:i64=-1; let b_act1:i64=-1; let b_act2:i64=-1; let b_act3:i64=-1;
    let b_s0:i64=0; let b_s1:i64=0; let b_s2:i64=0;
    let b_c0:i64=0; let b_c1:i64=0; let b_c2:i64=0;
    let pol:i64=0;
    let pstep:[]u8=lw_alloc(5);
    if(cond==0){
        // scheduled: fixed try-measure-keep over both slots, per episode
        while(e<4){
            let et:i64=e%2;
            setup_episode(hyp,et,khelp);
            let cn:i64=clear_list(consult);
            let a0:i64=selftest(vstr,vlab,6,consult,cn,hyp);
            cn=wire(consult,cn,0);
            let a1v:i64=selftest(vstr,vlab,6,consult,cn,hyp);
            if(a1v>a0){ } else { cn=unwire_h(consult,cn,0); }
            let a2:i64=selftest(vstr,vlab,6,consult,cn,hyp);
            cn=wire(consult,cn,1);
            let a3:i64=selftest(vstr,vlab,6,consult,cn,hyp);
            if(a3>a2){ } else { cn=unwire_h(consult,cn,1); }
            let sc:i64=selftest(vstr,vlab,6,consult,cn,hyp);
            if(e==0){ ts0=sc; } if(e==1){ ts1=sc; }
            if(e==2){ ts2=sc; } if(e==3){ ts3=sc; }
            e=e+1;
        }
    }
    if(cond==1){
        // bandit: one atomic action per episode by argmax of Q
        while(e<4){
            let et:i64=e%2;
            setup_episode(hyp,et,khelp);
            let cn2:i64=clear_list(consult);
            let best:i64=0;
            let bs:i64=b_s0;
            let bc:i64=b_c0;
            if(vbetter(b_s1,b_c1,bs,bc)==1){ best=1; bs=b_s1; bc=b_c1; }
            if(vbetter(b_s2,b_c2,bs,bc)==1){ best=2; }
            if(best==0){ cn2=wire(consult,cn2,0); }
            if(best==1){ cn2=wire(consult,cn2,1); }
            let sc2:i64=selftest(vstr,vlab,6,consult,cn2,hyp);
            if(best==0){ b_s0=b_s0+sc2; b_c0=b_c0+1; }
            if(best==1){ b_s1=b_s1+sc2; b_c1=b_c1+1; }
            if(best==2){ b_s2=b_s2+sc2; b_c2=b_c2+1; }
            if(e==0){ ts0=sc2; b_act0=best; }
            if(e==1){ ts1=sc2; b_act1=best; }
            if(e==2){ ts2=sc2; b_act2=best; }
            if(e==3){ ts3=sc2; b_act3=best; }
            e=e+1;
        }
    }
    if(cond==2){
        // construct: exhaustive search over 16807 policies, retain best
        let bestp:i64=0;
        let bests:i64=-1;
        let p:i64=0;
        let steps:[]u8=lw_alloc(5);
        while(p<16807){
            decode(p,steps);
            let tot:i64=0;
            let f:i64=0;
            while(f<4){
                setup_episode(hyp,f%2,khelp);
                tot=tot+run_policy(steps,vstr,vlab,consult,hyp);
                f=f+1;
            }
            if(tot>bests){ bests=tot; bestp=p; }
            p=p+1;
        }
        pol=bestp;
        decode(pol,pstep);
        // re-run retained policy on training episodes for the score report
        e=0;
        while(e<4){
            setup_episode(hyp,e%2,khelp);
            let sc3:i64=run_policy(pstep,vstr,vlab,consult,hyp);
            if(e==0){ ts0=sc3; } if(e==1){ ts1=sc3; }
            if(e==2){ ts2=sc3; } if(e==3){ ts3=sc3; }
            e=e+1;
        }
    }
    if(cond==3){
        // nodriver: retention disabled; policy index 0 is kept
        pol=0;
        decode(pol,pstep);
        e=0;
        while(e<4){
            setup_episode(hyp,e%2,khelp);
            let sc4:i64=run_policy(pstep,vstr,vlab,consult,hyp);
            if(e==0){ ts0=sc4; } if(e==1){ ts1=sc4; }
            if(e==2){ ts2=sc4; } if(e==3){ ts3=sc4; }
            e=e+1;
        }
    }
    // held-out episodes C (etype 2) and D (etype 3)
    if(cond==0){
        setup_episode(hyp,2,khelp);
        let cn3:i64=clear_list(consult);
        let h0:i64=selftest(vstr,vlab,6,consult,cn3,hyp);
        cn3=wire(consult,cn3,0);
        let h1:i64=selftest(vstr,vlab,6,consult,cn3,hyp);
        if(h1>h0){ } else { cn3=unwire_h(consult,cn3,0); }
        let h2:i64=selftest(vstr,vlab,6,consult,cn3,hyp);
        cn3=wire(consult,cn3,1);
        let h3:i64=selftest(vstr,vlab,6,consult,cn3,hyp);
        if(h3>h2){ } else { cn3=unwire_h(consult,cn3,1); }
        hs0=selftest(vstr,vlab,6,consult,cn3,hyp);
        setup_episode(hyp,3,khelp);
        let cn4:i64=clear_list(consult);
        let g0:i64=selftest(vstr,vlab,6,consult,cn4,hyp);
        cn4=wire(consult,cn4,0);
        let g1:i64=selftest(vstr,vlab,6,consult,cn4,hyp);
        if(g1>g0){ } else { cn4=unwire_h(consult,cn4,0); }
        let g2:i64=selftest(vstr,vlab,6,consult,cn4,hyp);
        cn4=wire(consult,cn4,1);
        let g3:i64=selftest(vstr,vlab,6,consult,cn4,hyp);
        if(g3>g2){ } else { cn4=unwire_h(consult,cn4,1); }
        hs1=selftest(vstr,vlab,6,consult,cn4,hyp);
    }
    if(cond==1){
        // bandit held-out: reuse final argmax action (no further updates)
        let besth:i64=0;
        let bsh:i64=b_s0;
        let bch:i64=b_c0;
        if(vbetter(b_s1,b_c1,bsh,bch)==1){ besth=1; bsh=b_s1; bch=b_c1; }
        if(vbetter(b_s2,b_c2,bsh,bch)==1){ besth=2; }
        setup_episode(hyp,2,khelp);
        let cn5:i64=clear_list(consult);
        if(besth==0){ cn5=wire(consult,cn5,0); }
        if(besth==1){ cn5=wire(consult,cn5,1); }
        hs0=selftest(vstr,vlab,6,consult,cn5,hyp);
        setup_episode(hyp,3,khelp);
        let cn6:i64=clear_list(consult);
        if(besth==0){ cn6=wire(consult,cn6,0); }
        if(besth==1){ cn6=wire(consult,cn6,1); }
        hs1=selftest(vstr,vlab,6,consult,cn6,hyp);
    }
    if(cond==2){
        setup_episode(hyp,2,khelp);
        hs0=run_policy(pstep,vstr,vlab,consult,hyp);
        setup_episode(hyp,3,khelp);
        hs1=run_policy(pstep,vstr,vlab,consult,hyp);
    }
    if(cond==3){
        setup_episode(hyp,2,khelp);
        hs0=run_policy(pstep,vstr,vlab,consult,hyp);
        setup_episode(hyp,3,khelp);
        hs1=run_policy(pstep,vstr,vlab,consult,hyp);
    }
    // report: one buffer, one syscall
    let cnd:[]u8="scheduled";
    if(cond==1){ cnd="bandit"; }
    if(cond==2){ cnd="construct"; }
    if(cond==3){ cnd="nodriver"; }
    c=e1str(out,c,"LW2|cond=");
    c=e1str(out,c,cnd);
    c=e1str(out,c,"\nLW2|hyp_param=");
    c=e1i64(out,c,khelp);
    c=e1str(out,c,"\nLW2|train_scores=");
    c=e1i64(out,c,ts0);
    c=e1str(out,c,",");
    c=e1i64(out,c,ts1);
    c=e1str(out,c,",");
    c=e1i64(out,c,ts2);
    c=e1str(out,c,",");
    c=e1i64(out,c,ts3);
    c=e1str(out,c,"|train_total=");
    c=e1i64(out,c,ts0+ts1+ts2+ts3);
    c=e1str(out,c,"|train_n=24");
    if(cond==1){
        c=e1str(out,c,"\nLW2|actions=");
        c=e1i64(out,c,b_act0);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_act1);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_act2);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_act3);
        c=e1str(out,c,"|q_sums=");
        c=e1i64(out,c,b_s0);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_s1);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_s2);
        c=e1str(out,c,"|q_counts=");
        c=e1i64(out,c,b_c0);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_c1);
        c=e1str(out,c,",");
        c=e1i64(out,c,b_c2);
    }
    if(cond==2){
        c=e1str(out,c,"\nLW2|policy_index=");
        c=e1i64(out,c,pol);
        c=e1str(out,c,"|policy_steps=");
        let si:i64=0;
        while(si<5){
            c=e1i64(out,c,pstep[si] as i64);
            if(si<4){ c=e1str(out,c,","); }
            si=si+1;
        }
    }
    if(cond==3){
        c=e1str(out,c,"\nLW2|policy_index=");
        c=e1i64(out,c,pol);
        c=e1str(out,c,"|policy_steps=");
        let sj:i64=0;
        while(sj<5){
            c=e1i64(out,c,pstep[sj] as i64);
            if(sj<4){ c=e1str(out,c,","); }
            sj=sj+1;
        }
    }
    c=e1str(out,c,"\nLW2|heldout_scores=");
    c=e1i64(out,c,hs0);
    c=e1str(out,c,",");
    c=e1i64(out,c,hs1);
    c=e1str(out,c,"|heldout_total=");
    c=e1i64(out,c,hs0+hs1);
    c=e1str(out,c,"|heldout_n=12\n");
    let w1:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(out) as i64),c,0,0,0);
    if(w1!=c){ return 4; }
    return 0;
}

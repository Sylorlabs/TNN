// d5_batt.zag -- the frozen D5 battery, shared byte-identical
// across all three builds (catted after the store file and the
// per-build d5_rank shim). Uses only the frozen store
// interface: es_item_new, e_add, e_has, es_ndeps, es_dep_at,
// e_count, es_audit, es_promotes, es_maxrank, es_diverge,
// plus d5_rank from the shim. Emit helpers are d5_-prefixed
// (no collisions).
//
// Stages on one state:
//   1. diamond 1: A=4 -> B=5, A -> C=6, B -> D=7, C -> D=7
//      (all cross-rank under creation-order ranks)
//   2. cross-links B -> F=9, C -> E=8 (slow path), then
//      diamond 2 stacked on D: D -> E=8, D -> F=9,
//      E -> G=10, F -> G=10
//   3. adversarial: G -> A (type 2, cycle-closing over the
//      stacked diamonds), G -> G (type 2, self-loop)

fn d5_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn d5_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn d5_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d5_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  d5_p(ob,atp,nm);
  d5_p(ob,atp,"=");
  d5_pi(ob,atp,v);
  d5_p(ob,atp," ");
  return;
}
// d5_inv: 1 iff every readable edge goes from a strictly
// higher rank to a strictly lower rank.
fn d5_inv(st:[]u8)i32 {
  let y:i32=0;
  while(y<24){
    let ry:i32=d5_rank(st,y);
    if(ry>=0){
      let n:i32=es_ndeps(st,y);
      let i:i32=0;
      while(i<n){
        let w:i32=es_dep_at(st,y,i);
        let rw:i32=d5_rank(st,w);
        if(rw>=ry){ return 0; }
        i=i+1;
      }
    }
    y=y+1;
  }
  return 1;
}
fn d5_run(ob:[]u8, atp:[]u8)void {
  let st:[]u8=z_alloc(65536);
  let k:i32=4;
  while(k<=10){ es_item_new(st,k); k=k+1; }
  // ---- Stage 1: diamond 1 ----
  e_add(st,4,5,1);
  e_add(st,4,6,1);
  e_add(st,5,7,1);
  e_add(st,6,7,1);
  let dab:i32=e_has(st,4,5,1);
  let dac:i32=e_has(st,4,6,1);
  let dbd:i32=e_has(st,5,7,1);
  let dcd:i32=e_has(st,6,7,1);
  d5_p(ob,atp,"D5A ");
  d5_bar(ob,atp,"dab",dab);
  d5_bar(ob,atp,"dac",dac);
  d5_bar(ob,atp,"dbd",dbd);
  d5_bar(ob,atp,"dcd",dcd);
  d5_bar(ob,atp,"inv",d5_inv(st));
  d5_bar(ob,atp,"audit",es_audit(st));
  d5_bar(ob,atp,"promotes",es_promotes(st));
  d5_bar(ob,atp,"maxrank",es_maxrank(st));
  d5_pnl(ob,atp);
  // ---- Stage 2: cross-links + diamond 2 ----
  e_add(st,5,9,1);
  e_add(st,6,8,1);
  e_add(st,7,8,1);
  e_add(st,7,9,1);
  e_add(st,8,10,1);
  e_add(st,9,10,1);
  let xl1:i32=e_has(st,5,9,1);
  let xl2:i32=e_has(st,6,8,1);
  let d78:i32=e_has(st,7,8,1);
  let d79:i32=e_has(st,7,9,1);
  let d810:i32=e_has(st,8,10,1);
  let d910:i32=e_has(st,9,10,1);
  let dia1:i32=1;
  if(dab==0){ dia1=0; }
  if(dac==0){ dia1=0; }
  if(dbd==0){ dia1=0; }
  if(dcd==0){ dia1=0; }
  d5_p(ob,atp,"D5B ");
  d5_bar(ob,atp,"xl1",xl1);
  d5_bar(ob,atp,"xl2",xl2);
  d5_bar(ob,atp,"d78",d78);
  d5_bar(ob,atp,"d79",d79);
  d5_bar(ob,atp,"d810",d810);
  d5_bar(ob,atp,"d910",d910);
  d5_bar(ob,atp,"dia1",dia1);
  d5_bar(ob,atp,"inv",d5_inv(st));
  d5_bar(ob,atp,"audit",es_audit(st));
  d5_bar(ob,atp,"promotes",es_promotes(st));
  d5_bar(ob,atp,"maxrank",es_maxrank(st));
  d5_bar(ob,atp,"t1",e_count(st,1));
  d5_pnl(ob,atp);
  // ---- Stage 3: adversarial over the stacked diamonds ----
  e_add(st,10,4,2);
  e_add(st,10,10,2);
  let adv1:i32=e_has(st,10,4,2);
  let adv2:i32=e_has(st,10,10,2);
  let dia1c:i32=1;
  if(e_has(st,4,5,1)==0){ dia1c=0; }
  if(e_has(st,4,6,1)==0){ dia1c=0; }
  if(e_has(st,5,7,1)==0){ dia1c=0; }
  if(e_has(st,6,7,1)==0){ dia1c=0; }
  let xl1c:i32=e_has(st,5,9,1);
  let xl2c:i32=e_has(st,6,8,1);
  let dia2:i32=1;
  if(e_has(st,7,8,1)==0){ dia2=0; }
  if(e_has(st,7,9,1)==0){ dia2=0; }
  if(e_has(st,8,10,1)==0){ dia2=0; }
  if(e_has(st,9,10,1)==0){ dia2=0; }
  d5_p(ob,atp,"D5C ");
  d5_bar(ob,atp,"adv1",adv1);
  d5_bar(ob,atp,"adv2",adv2);
  d5_bar(ob,atp,"dia1",dia1c);
  d5_bar(ob,atp,"dia2",dia2);
  d5_bar(ob,atp,"xl1",xl1c);
  d5_bar(ob,atp,"xl2",xl2c);
  d5_bar(ob,atp,"inv",d5_inv(st));
  d5_bar(ob,atp,"audit",es_audit(st));
  d5_bar(ob,atp,"promotes",es_promotes(st));
  d5_bar(ob,atp,"maxrank",es_maxrank(st));
  d5_bar(ob,atp,"t1",e_count(st,1));
  d5_bar(ob,atp,"t2",e_count(st,2));
  d5_pnl(ob,atp);
  return;
}

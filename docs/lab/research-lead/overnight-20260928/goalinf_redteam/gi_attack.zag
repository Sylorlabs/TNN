// gi_attack.zag -- GOALINF red-team attack battery (unfrozen driver only).
//
// Attacks the FROZEN H-GOALINF-1 mechanism (gi_base.zag + gi_patch.zag,
// copied read-only, never edited). Four adversarial worlds:
//
//   A DECOY:     confident correct FACT vs a walkable decoy structure.
//                Does the greedy target-free probe find the decoy, demote
//                the correct FACT, and CONSTRUCT a wrong answer?
//   B BOUNDARY:  FACT score exactly at the confidence threshold (3 vs 2,
//                one confirm cycle apart). Sharp discontinuity? Flip?
//   C STALEVSTALE: confident stale FACT vs stale structure, world truth
//                a third value present but outscored. Which channel wins?
//   D MANYWEAK:  six agreeing weak FACTs, no single one confident. Does
//                the router aggregate, gamble, or withhold?
//
// Zero em/en dashes in this file. Pure Zag.

fn cmp_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn count_facts_sr(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let k:i32=2;
  while(k<1024){
    if(ng(W,k,36)==1 && ng(W,k,0)==1 && is_superseded(W,k)==0 && ng(W,k,20)==s && ng(W,k,24)==r){n=n+1;}
    k=k+1;
  }
  return n;
}
fn lvc_factscore(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return ng(W,n,8);}
    n=n+1;
  }
  return -999999;
}
// gi_confirm: N predict/resolve cycles that never write a FACT, so a
// taught FACT earns its own score. Verbatim from H-GOALINF-1 driver.
fn gi_confirm(W:[]u8,s:i32,r:i32,o:i32,cycles:i32)void {
  let c:i32=0;
  while(c<cycles){
    let p:i32=lv_predict(W,s,r);
    emit("GI-CFM c="); e64(c); emit(" pred="); e64(p); emit("\n");
    lv_pred_resolve(W,s,r,o);
    c=c+1;
  }
  emit("GI-CFM factscore="); e64(lvc_factscore(W,s,r)); emit("\n");
  return;
}
// mk_chain: build a walkable 6-link decoy/stale chain c0..c0+6 via r=1
// FACTs, then promote four 2-link chain MAPs with the learner's own
// trial/rebind machinery (same world-building method as T1's trains).
// The probe walks c0 -> c0+2 -> c0+4 -> c0+6 in 3 MAP execs.
fn mk_chain(W:[]u8,c0:i32,rmap:i32)void {
  ev_teach(W,c0,1,c0+1); ev_teach(W,c0+1,1,c0+2); ev_teach(W,c0+2,1,c0+3);
  ev_teach(W,c0+3,1,c0+4); ev_teach(W,c0+4,1,c0+5); ev_teach(W,c0+5,1,c0+6);
  let q1:i32=ev_query(W,c0,rmap,c0+2,0);
  let q2:i32=ev_query(W,c0+1,rmap,c0+3,0);
  let q3:i32=ev_query(W,c0+2,rmap,c0+4,0);
  let q4:i32=ev_query(W,c0+3,rmap,c0+5,0);
  emit("CHAIN answers: "); e64(q1); emit(" "); e64(q2); emit(" "); e64(q3); emit(" "); e64(q4); emit("\n");
  return;
}
fn fresh_st(st:[]u8)void {
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  return;
}

// ---- ATTACK A: decoy structure vs confident CORRECT fact ----
// World: bare. FACT (201,80)=42 earned by 5 world observations
// (score 5, confident, correct). Then a decoy chain 201..207 is built
// and four chain MAPs are promoted by the learner's own machinery.
// The probe is relation-agnostic, so it walks the r=1 decoy chain.
// KILL iff: route=2 CONFLICT, the correct FACT is demoted, and the
// learner constructs the decoy endpoint 207 with verification.
fn attack_a()i32 {
  emit("=== ATTACK-A decoy-vs-correct-fact ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let fs:i32=ev_teach_in(W,201,80,42);
  gi_confirm(W,201,80,42,5);
  emit("A fact node="); e64(fs); emit(" score="); e64(lvc_factscore(W,201,80)); emit("\n");
  mk_chain(W,201,71);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16); fresh_st(st);
  let z:i32=ev_iquery(W,201,80,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  let sup:i32=is_superseded(W,fs);
  emit("A route="); e64(route); emit(" ans="); e64(z);
  emit(" tried="); e64(get32(st,0)); emit(" probeexecs="); e64(get32(st,8));
  emit(" maps "); e64(m0); emit("->"); e64(m1);
  emit(" correct-fact-superseded="); e64(sup); emit("\n");
  if(route==2 && z==207 && sup==1 && get32(st,0)>=1 && m1==m0+1){
    emit("ATTACK-A-SCORE=KILL\n");
    return 1;
  }
  emit("ATTACK-A-SCORE=SURVIVE\n");
  return 0;
}

// ---- ATTACK B: score exactly at the boundary ----
// B3: FACT score 3 (confident by exactly the threshold).
// B2: FACT score 2 (weak by one unit). One confirm cycle apart.
// Btie: two tied FACTs; lv_predict and gi_factscan must agree on the
// tiebreak (identical ordering code), so no divergence is possible.
// Finding: sharp deterministic discontinuity; no between-run flip can
// exist (total order tiebreaks, byte-identical runs).
fn attack_b()i32 {
  emit("=== ATTACK-B boundary-score ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach_in(W,201,80,42);
  gi_confirm(W,201,80,42,3);
  let st:[]u8=z_alloc(16); fresh_st(st);
  let z3:i32=ev_iquery(W,201,80,0,st);
  let r3:i32=get32(st,12);
  emit("B3 score=3 route="); e64(r3); emit(" ans="); e64(z3); emit("\n");
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach_in(W2,201,80,42);
  gi_confirm(W2,201,80,42,2);
  let st2:[]u8=z_alloc(16); fresh_st(st2);
  let z2:i32=ev_iquery(W2,201,80,0,st2);
  let r2:i32=get32(st2,12);
  emit("B2 score=2 route="); e64(r2); emit(" ans="); e64(z2); emit("\n");
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  ev_teach_in(W3,201,80,42);
  ev_teach_in(W3,201,80,43);
  let p3:i32=lv_predict(W3,201,80);
  let fs3:[]u8=z_alloc(12);
  gi_factscan(W3,201,80,fs3);
  emit("Btie lv_predict="); e64(p3);
  emit(" factscan-node="); e64(get32(fs3,0));
  emit(" factscan-val="); e64(get32(fs3,8)); emit("\n");
  let tieok:i32=0;
  if(p3==get32(fs3,8)){tieok=1;}
  emit("Btie agree="); e64(tieok); emit("\n");
  if(r3==0 && z3==42 && r2==1 && z2==-3 && tieok==1){
    emit("ATTACK-B-SCORE=BOUND\n");
    return 1;
  }
  emit("ATTACK-B-SCORE=UNEXPECTED\n");
  return 0;
}

// ---- ATTACK C: stale FACT vs STALE structure (both channels wrong) ----
// World: stale confident FACT (301,80)=911 (score 7); stale walkable
// structure 301..307 (chain MAPs from an older world); the new ground
// truth 912 arrives twice through the teach channel (two live FACTs,
// score 0 each, outscored by the stale 911). The probe walks to 307.
// Neither channel knows 912. Which wins?
fn attack_c()i32 {
  emit("=== ATTACK-C stale-vs-stale ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let fs:i32=ev_teach_in(W,301,80,911);
  gi_confirm(W,301,80,911,7);
  emit("C stale-fact node="); e64(fs); emit(" score="); e64(lvc_factscore(W,301,80)); emit("\n");
  mk_chain(W,301,71);
  ev_teach(W,301,80,912);
  ev_teach(W,301,80,912);
  emit("C live facts(301,80)="); e64(count_facts_sr(W,301,80)); emit(" (two say 912, one says 911)\n");
  let st:[]u8=z_alloc(16); fresh_st(st);
  let z:i32=ev_iquery(W,301,80,0,st);
  let route:i32=get32(st,12);
  let sup:i32=is_superseded(W,fs);
  emit("C route="); e64(route); emit(" ans="); e64(z);
  emit(" tried="); e64(get32(st,0)); emit(" probeexecs="); e64(get32(st,8));
  emit(" stale911-superseded="); e64(sup); emit("\n");
  if(route==2 && z==307 && sup==1){
    emit("ATTACK-C-SCORE=BOUND\n");
    return 1;
  }
  emit("ATTACK-C-SCORE=UNEXPECTED\n");
  return 0;
}

// ---- ATTACK D: many weak FACTs, none confident ----
// World: bare. Six agreeing FACTs (201,80)=42, best score 2 after two
// confirm cycles (rich-get-richer keeps every single one below the
// threshold). Collectively they say 42 six times over. The router only
// consults the single best FACT. Gamble, aggregate, or withhold?
fn attack_d()i32 {
  emit("=== ATTACK-D many-weak-facts ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach_in(W,201,80,42); ev_teach_in(W,201,80,42); ev_teach_in(W,201,80,42);
  ev_teach_in(W,201,80,42); ev_teach_in(W,201,80,42); ev_teach_in(W,201,80,42);
  gi_confirm(W,201,80,42,2);
  let nf:i32=count_facts_sr(W,201,80);
  let bs:i32=lvc_factscore(W,201,80);
  emit("D live facts(201,80)="); e64(nf); emit(" (all say 42)\n");
  let st:[]u8=z_alloc(16); fresh_st(st);
  let z:i32=ev_iquery(W,201,80,0,st);
  let route:i32=get32(st,12);
  emit("D route="); e64(route); emit(" ans="); e64(z);
  emit(" tried="); e64(get32(st,0)); emit("\n");
  if(route==1 && z==-3 && get32(st,0)==0 && nf==6){
    emit("ATTACK-D-SCORE=BOUND\n");
    return 1;
  }
  emit("ATTACK-D-SCORE=UNEXPECTED\n");
  return 0;
}

fn main()i32 {
  emit("GI-ATTACK-START\n");
  let a:i32=attack_a();
  let b:i32=attack_b();
  let c:i32=attack_c();
  let d:i32=attack_d();
  emit("GI-ATTACK-SUMMARY ");
  e64(a); emit(" "); e64(b); emit(" "); e64(c); emit(" "); e64(d);
  emit("\n");
  emit("GI-ATTACK-END\n");
  return 0;
}

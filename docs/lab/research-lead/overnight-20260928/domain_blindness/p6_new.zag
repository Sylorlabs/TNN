// p6_new.zag -- COMPOSE-PAIR6-ADV: adversarial 6th pair (diamond-agreement).
// New code for this lane ONLY: world setups, oracle scaffolding, main.
// The U logic (admission, trial execution, widening, recording) is the
// byte-identical reference in ref_uc_uni.zag; the base is ref_uc_base.zag.
// Domain vocabulary (relations 91/92/93, entity ids) appears ONLY here.

// ---- 6th pair world: inbound-shipments x outbound-shipments (diamond) ----
fn setup_p6(A:[]u8)void {
  fact_add(A,61,91,101); fact_add(A,61,91,102); fact_add(A,61,91,103);
  fact_add(A,61,92,201); fact_add(A,61,92,202); fact_add(A,61,92,203);
  fact_add(A,71,91,111); fact_add(A,71,91,112);
  fact_add(A,71,92,211);
  fact_add(A,21,81,22);
  fact_add(A,81,93,82); fact_add(A,82,93,83); fact_add(A,83,81,84);
  map_new(A,0,1,91,0);
  map_new(A,1,1,92,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  teach(A,0,61,3); teach(A,0,71,2);
  teach(A,1,61,3); teach(A,1,71,1);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,81,83);
  return;
}
// ---- ablation: X's MAP dead (WALK rel 99, no facts, untaught) ----
fn setup_p6_noX(A:[]u8)void {
  fact_add(A,61,91,101); fact_add(A,61,91,102); fact_add(A,61,91,103);
  fact_add(A,61,92,201); fact_add(A,61,92,202); fact_add(A,61,92,203);
  fact_add(A,71,91,111); fact_add(A,71,91,112);
  fact_add(A,71,92,211);
  fact_add(A,21,81,22);
  fact_add(A,81,93,82); fact_add(A,82,93,83); fact_add(A,83,81,84);
  map_new(A,0,0,99,0);
  map_new(A,1,1,92,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  teach(A,1,61,3); teach(A,1,71,1);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,81,83);
  return;
}
// ---- ablation: Y's MAP dead ----
fn setup_p6_noY(A:[]u8)void {
  fact_add(A,61,91,101); fact_add(A,61,91,102); fact_add(A,61,91,103);
  fact_add(A,61,92,201); fact_add(A,61,92,202); fact_add(A,61,92,203);
  fact_add(A,71,91,111); fact_add(A,71,91,112);
  fact_add(A,71,92,211);
  fact_add(A,21,81,22);
  fact_add(A,81,93,82); fact_add(A,82,93,83); fact_add(A,83,81,84);
  map_new(A,0,1,91,0);
  map_new(A,1,0,99,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  teach(A,0,61,3); teach(A,0,71,2);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,81,83);
  return;
}
// ---- pipeline control world: same logic must PASS a pipeline pair ----
fn setup_p6pipe(A:[]u8)void {
  fact_add(A,61,81,62); fact_add(A,62,81,63);
  fact_add(A,63,82,101); fact_add(A,63,82,102);
  fact_add(A,21,81,22);
  fact_add(A,81,93,82); fact_add(A,82,93,83); fact_add(A,83,81,84);
  map_new(A,0,0,81,0);
  map_new(A,1,1,82,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  teach(A,0,61,63);
  teach(A,1,63,2);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,81,83);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  // Q0 diamond world; oracle proves X+Y jointly determine the answer.
  let A:[]u8=world_new();
  setup_p6(A);
  let ox:i32=exec_map(A,0,61);
  let oy:i32=exec_map(A,1,61);
  let agree:i32=0;
  if(ox>=0){
    if(oy>=0){
      if(ox==oy){ agree=1; }
    }
  }
  c=o_app(B,c,"ORACLE ox="); c=o_i64(B,c,ox as i64);
  c=o_app(B,c," oy="); c=o_i64(B,c,oy as i64);
  c=o_app(B,c," agree="); c=o_i64(B,c,agree as i64); c=o_nl(B,c);
  // Q0b census before any Z query (K1).
  c=uni_census(A,B,c,4);
  // Q1 adversarial diamond query.
  c=uni_solve(A,B,c,61,1,2,1,4);
  c=uni_report(A,B,c,"UNI","P6");
  // Q2 ablate X.
  let A2:[]u8=world_new();
  setup_p6_noX(A2);
  c=uni_solve(A2,B,c,61,1,2,1,4);
  c=uni_report(A2,B,c,"UNI","P6-ABL-X");
  // Q3 ablate Y.
  let A3:[]u8=world_new();
  setup_p6_noY(A3);
  c=uni_solve(A3,B,c,61,1,2,1,4);
  c=uni_report(A3,B,c,"UNI","P6-ABL-Y");
  // Q4 pipeline control on the same copied logic.
  let C:[]u8=world_new();
  setup_p6pipe(C);
  c=uni_solve(C,B,c,61,1,2,2,4);
  c=uni_report(C,B,c,"UNI","P6-PIPE");
  o_flush(B,c);
  return 0;
}

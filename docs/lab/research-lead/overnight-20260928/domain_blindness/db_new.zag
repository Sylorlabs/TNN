// db_new.zag -- DOMAIN-BLINDNESS Variant A: mechanically renamed driver.
// Every domain/relation/entity identifier replaced by opaque tokens via
// the frozen PREREG permutation. No hand edits.

fn setup_w1(A:[]u8)void {
  fact_add(A,5003,9003,5011); fact_add(A,5003,9003,5012); fact_add(A,5003,9003,5013);
  fact_add(A,5003,9004,5016); fact_add(A,5003,9004,5017); fact_add(A,5003,9004,5018);
  fact_add(A,5006,9003,5014); fact_add(A,5006,9003,5015);
  fact_add(A,5006,9004,5019);
  fact_add(A,5001,9001,5002);
  fact_add(A,5007,9005,5008); fact_add(A,5008,9005,5009); fact_add(A,5009,9001,5010);
  map_new(A,0,1,9003,0);
  map_new(A,1,1,9004,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,9005,0);
  teach(A,0,5003,3); teach(A,0,5006,2);
  teach(A,1,5003,3); teach(A,1,5006,1);
  teach(A,2,5001,5001); teach(A,2,5001,5001);
  teach(A,3,5007,5009);
  return;
}
fn setup_w2(A:[]u8)void {
  fact_add(A,5003,9003,5011); fact_add(A,5003,9003,5012); fact_add(A,5003,9003,5013);
  fact_add(A,5003,9004,5016); fact_add(A,5003,9004,5017); fact_add(A,5003,9004,5018);
  fact_add(A,5006,9003,5014); fact_add(A,5006,9003,5015);
  fact_add(A,5006,9004,5019);
  fact_add(A,5001,9001,5002);
  fact_add(A,5007,9005,5008); fact_add(A,5008,9005,5009); fact_add(A,5009,9001,5010);
  map_new(A,0,0,9006,0);
  map_new(A,1,1,9004,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,9005,0);
  teach(A,1,5003,3); teach(A,1,5006,1);
  teach(A,2,5001,5001); teach(A,2,5001,5001);
  teach(A,3,5007,5009);
  return;
}
fn setup_w3(A:[]u8)void {
  fact_add(A,5003,9003,5011); fact_add(A,5003,9003,5012); fact_add(A,5003,9003,5013);
  fact_add(A,5003,9004,5016); fact_add(A,5003,9004,5017); fact_add(A,5003,9004,5018);
  fact_add(A,5006,9003,5014); fact_add(A,5006,9003,5015);
  fact_add(A,5006,9004,5019);
  fact_add(A,5001,9001,5002);
  fact_add(A,5007,9005,5008); fact_add(A,5008,9005,5009); fact_add(A,5009,9001,5010);
  map_new(A,0,1,9003,0);
  map_new(A,1,0,9006,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,9005,0);
  teach(A,0,5003,3); teach(A,0,5006,2);

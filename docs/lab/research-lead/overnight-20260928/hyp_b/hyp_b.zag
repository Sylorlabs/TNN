// hyp_b.zag
// Hypothesis B: semantic fragment induction.
// Pure Zag. No population, no score, no ranking, no beam anywhere.
// Frozen VM semantics copied from genexec2.zag at 8d5f58b89 (no VM edits).

// ================= utils =================
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n);
  if(p==null as *u8){ _zag_print("FATAL-OOM\n"); }
  return p[0..n];
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn z_free(b:[]u8)void {
  if(b.len>0){ _zag_free(_zag_slice_ptr(b)); }
  return;
}
fn i64s(v:i64)[]u8 { let r:[]u8=_zag_i64_to_str(v); return r; }
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn get32(b:[]u8,o:i32)i32 {
  let v:i32=(b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
  return v;
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn get64(b:[]u8,o:i32)i64 {
  let lo:i64=(get32(b,o) as i64)& 4294967295;
  let hi:i64=(get32(b,o+4) as i64)& 4294967295;
  return lo|(hi<<32);
}
fn set64(b:[]u8,o:i32,v:i64)void {
  set32(b,o,(v& 4294967295) as i32); set32(b,o+4,((v>>32)& 4294967295) as i32);
  return;
}
// monotonic ms via clock_gettime (pattern from tnn_contestant.zag)
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=get64(ts,0);
  let ns:i64=get64(ts,8);
  z_free(ts);
  return sec*1000+ns/1000000;
}

// ================= programs =================
// A program is []u8: bytes 0..3 = len (i32), then len*8 bytes of (op,arg).
fn prog_len(p:[]u8)i32 { return get32(p,0); }
fn prog_op(p:[]u8,i:i32)i32 { return get32(p,4+i*8); }
fn prog_arg(p:[]u8,i:i32)i32 { return get32(p,4+i*8+4); }
fn prog_new(maxlen:i32)[]u8 { let p:[]u8=z_alloc(4+maxlen*8); set32(p,0,0); return p; }
fn prog_append(p:[]u8,op:i32,arg:i32)void {
  let l:i32=prog_len(p);
  set32(p,4+l*8,op); set32(p,4+l*8+4,arg); set32(p,0,l+1);
  return;
}
fn prog_copy(dst:[]u8,src:[]u8)void {
  let l:i32=prog_len(src); set32(dst,0,l);
  let i:i32=0;
  while(i<l){ set32(dst,4+i*8,prog_op(src,i)); set32(dst,4+i*8+4,prog_arg(src,i)); i=i+1; }
  return;
}
fn mod_nonneg(a:i32,b:i32)i32 {
  let r:i32=a-(a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}

// ================= frozen VM (from genexec2.zag at 8d5f58b89) =================
fn vm_run(p:[]u8, pl:i32, in0:i32, in1:i32,
          lib_buf:[]u8, lib_idx:[]u8, nlib:i32,
          stack:[]u8, rs:[]u8)i32 {
  let sp:i32=0;
  let rsp:i32=0;
  let cur_is_main:i32=1;
  let cur_frag:i32=-1;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    let clen:i32=pl;
    if(cur_is_main==0){ clen=get32(lib_buf, get32(lib_idx, cur_frag*4)); }
    if(pc<0 || pc>=clen){
      if(cur_is_main==1){ break; }
      if(rsp==0){ break; }
      rsp=rsp-1;
      let rid:i32=get32(rs, rsp*8);
      let rpc:i32=get32(rs, rsp*8+4);
      if(rid==-1){ cur_is_main=1; cur_frag=-1; }
      else{ cur_is_main=0; cur_frag=rid; }
      pc=rpc;
      steps=steps+1;
      continue;
    }
    let op:i32=0; let arg:i32=0;
    if(cur_is_main==1){
      op=prog_op(p, pc); arg=prog_arg(p, pc);
    } else {
      let base:i32=get32(lib_idx, cur_frag*4);
      op=get32(lib_buf, base+4+pc*8); arg=get32(lib_buf, base+4+pc*8+4);
    }
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack, sp*4, arg); sp=sp+1; }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack, sp*4, in0); sp=sp+1; }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack, sp*4, in1); sp=sp+1; }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a+b); sp=sp+1; }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a-b); sp=sp+1; }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a*b); sp=sp+1; }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==7){ // MOD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==8){ // NEG
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); }
    } else if(op==9){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==10){ // DROP
      if(sp>=1){ sp=sp-1; }
    } else if(op==11){ // SWAP
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); }
    } else if(op==12){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==13){ // LT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a<b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==14){ // EQ
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a==b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==15){ // GT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a>b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==16){ // JZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a==0){pc=arg;} }
    } else if(op==17){ // JNZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a!=0){pc=arg;} }
    } else if(op==18){ // JMP
      pc=arg;
    } else if(op==19){ // CALL
      if(arg>=0 && arg<nlib && rsp<64){
        let rid:i32=-1;
        if(cur_is_main==0){ rid=cur_frag; }
        set32(rs, rsp*8, rid); set32(rs, rsp*8+4, pc); rsp=rsp+1;
        cur_is_main=0; cur_frag=arg; pc=0;
      }
    } else if(op==20){ // RET
      if(rsp==0){ break; }
      rsp=rsp-1;
      let rid:i32=get32(rs, rsp*8);
      let rpc:i32=get32(rs, rsp*8+4);
      if(rid==-1){ cur_is_main=1; cur_frag=-1; }
      else{ cur_is_main=0; cur_frag=rid; }
      pc=rpc;
    }
  }
  if(sp>0){ return get32(stack, (sp-1)*4); }
  return 0;
}
// Count exact matches of program p on episodes. One full-train assessment
// counts as one candidate evaluation against the budget.
fn eval_exact(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
              lib_buf:[]u8, lib_idx:[]u8, nlib:i32, bud:[]u8)i32 {
  let e0:i32=get32(bud,0);
  set32(bud,0,e0+1);
  if(e0+1>=1000000){ set32(bud,4,1); }
  let stack:[]u8=z_alloc(256*4);
  let rs:[]u8=z_alloc(64*8);
  let c:i32=0;
  let e:i32=0;
  while(e<n){
    let o:i32=vm_run(p, prog_len(p), get32(ein0,e*4), get32(ein1,e*4),
                     lib_buf, lib_idx, nlib, stack, rs);
    if(o==get32(etgt,e*4)){ c=c+1; }
    e=e+1;
  }
  z_free(stack); z_free(rs);
  return c;
}
fn lib_promote(lib_buf:[]u8, lib_idx:[]u8, nlib:i32, prog:[]u8, lib_used:i32)i32 {
  let off:i32=lib_used;
  let l:i32=prog_len(prog);
  set32(lib_buf, off, l);
  let i:i32=0;
  while(i<l){
    set32(lib_buf, off+4+i*8, prog_op(prog,i));
    set32(lib_buf, off+4+i*8+4, prog_arg(prog,i));
    i=i+1;
  }
  set32(lib_idx, nlib*4, off);
  return off+4+l*8;
}

// ================= tasks (frozen battery) =================
fn build_train(tid:i32, e0:[]u8, e1:[]u8, et:[]u8)i32 {
  let n:i32=0;
  if(tid==0){ let x:i32=0; while(x<=8){ set32(e0,n*4,x); set32(e1,n*4,0); set32(et,n*4,2*x+1); n=n+1; x=x+1; } }
  else if(tid==1){ let x:i32=-8; while(x<=8){ set32(e0,n*4,x); set32(e1,n*4,0); let a:i32=x; if(a<0){a=-a;} set32(et,n*4,a); n=n+1; x=x+1; } }
  else if(tid==2){ let x:i32=0; while(x<=16){ set32(e0,n*4,x); set32(e1,n*4,0); set32(et,n*4,mod_nonneg(x,3)); n=n+1; x=x+1; } }
  else if(tid==3){ let a:i32=0; while(a<=4){ let b:i32=0; while(b<=4){ set32(e0,n*4,a); set32(e1,n*4,b); let r:i32=0; if(mod_nonneg(a+b,2)==0){r=1;} set32(et,n*4,r); n=n+1; b=b+1; } a=a+1; } }
  else if(tid==4){ let x:i32=-6; while(x<=6){ set32(e0,n*4,x); set32(e1,n*4,0); let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} set32(et,n*4,d); n=n+1; x=x+1; } }
  else if(tid==5){ let x:i32=-4; while(x<=8){ set32(e0,n*4,x); set32(e1,n*4,0); let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=x-2; if(d<0){d=-d;} set32(et,n*4,ax+d); n=n+1; x=x+1; } }
  return n;
}
fn build_heldout(tid:i32, e0:[]u8, e1:[]u8, et:[]u8)i32 {
  let n:i32=0;
  if(tid==0){ let x:i32=-8; while(x<=16){ if(x<0 || x>8){ set32(e0,n*4,x); set32(e1,n*4,0); set32(et,n*4,2*x+1); n=n+1; } x=x+1; } }
  else if(tid==1){ let x:i32=-12; while(x<=12){ if(x<-8 || x>8){ set32(e0,n*4,x); set32(e1,n*4,0); let a:i32=x; if(a<0){a=-a;} set32(et,n*4,a); n=n+1; } x=x+1; } }
  else if(tid==2){ let x:i32=17; while(x<=33){ set32(e0,n*4,x); set32(e1,n*4,0); set32(et,n*4,mod_nonneg(x,3)); n=n+1; x=x+1; } }
  else if(tid==3){ let a:i32=0; while(a<=7){ let b:i32=0; while(b<=7){ if(a>4 || b>4){ set32(e0,n*4,a); set32(e1,n*4,b); let r:i32=0; if(mod_nonneg(a+b,2)==0){r=1;} set32(et,n*4,r); n=n+1; } b=b+1; } a=a+1; } }
  else if(tid==4){ let x:i32=-10; while(x<=10){ if(x<-6 || x>6){ set32(e0,n*4,x); set32(e1,n*4,0); let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} set32(et,n*4,d); n=n+1; } x=x+1; } }
  else if(tid==5){ let x:i32=-8; while(x<=12){ if(x<-4 || x>8){ set32(e0,n*4,x); set32(e1,n*4,0); let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=x-2; if(d<0){d=-d;} set32(et,n*4,ax+d); n=n+1; } x=x+1; } }
  return n;
}
// Closed-form target for single-input tasks (generality checks).
fn target1(tid:i32, x:i32)i32 {
  if(tid==0){ return 2*x+1; }
  if(tid==1){ if(x<0){return -x;} return x; }
  if(tid==2){ return mod_nonneg(x,3); }
  if(tid==4){ let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} return d; }
  if(tid==5){ let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=x-2; if(d<0){d=-d;} return ax+d; }
  return 0;
}
// Closed-form 2-input target (T3 parity), for MOD-fragment generality.
fn target2(a:i32, b:i32)i32 {
  if(mod_nonneg(a+b,2)==0){ return 1; }
  return 0;
}
// Kink set: interior x_j where the slope of the target changes.
fn compute_kinks(in0:[]u8, tgt:[]u8, n:i32, out:[]u8)i32 {
  let nk:i32=0;
  let j:i32=1;
  while(j<n-1){
    let d1:i32=get32(tgt,j*4)-get32(tgt,(j-1)*4);
    let d2:i32=get32(tgt,(j+1)*4)-get32(tgt,j*4);
    if(d1!=d2){ set32(out,nk*4,get32(in0,j*4)); nk=nk+1; }
    j=j+1;
  }
  return nk;
}

// ================= expression enumerator =================
// Expression op codes: 1=IN0 2=IN1 3=TOP 4=PUSH(arg) 10=NEG
//   20=ADD 21=SUB 22=MUL 23=DIV 24=MOD 25=EQ 26=LT 27=GT
// VM op map: 20->3 21->4 22->5 23->6 24->7 25->14 26->13 27->15 10->8
fn expr_vmop(op:i32)i32 {
  if(op==20){return 3;} if(op==21){return 4;} if(op==22){return 5;}
  if(op==23){return 6;} if(op==24){return 7;} if(op==25){return 14;}
  if(op==26){return 13;} if(op==27){return 15;} return 8;
}
fn bud_bump(bud:[]u8, k:i32)i32 {
  let e:i32=get32(bud,0)+k;
  set32(bud,0,e);
  if(e>=1000000){ set32(bud,4,1); return 1; }
  return 0;
}
fn vec_hash(v:[]u8, n:i32)i64 {
  let h:i64=1469598103934665603;
  let i:i32=0;
  while(i<n){
    let x:i64=(get32(v,i*4) as i64)& 4294967295;
    h=(h^x)*1099511628211;
    i=i+1;
  }
  return h;
}
fn ht_clear(ht:[]u8, nslots:i32)void {
  let i:i32=0;
  while(i<nslots){ set32(ht,i*16+12,0); i=i+1; }
  return;
}
// slot: hash:i64@0 node:i32@8 used:i32@12. Returns existing node,
// -1 on fresh insert, -2 if table full.
fn ht_insert(ht:[]u8, mask:i32, nslots:i32, h:i64, node:i32)i32 {
  let m:i64=mask as i64;
  let i:i64=h&m;
  let tries:i32=0;
  while(tries<=nslots){
    let s:i32=(i as i32)*16;
    if(get32(ht,s+12)==0){
      set64(ht,s,h); set32(ht,s+8,node); set32(ht,s+12,1);
      return -1;
    }
    if(get64(ht,s)==h){ return get32(ht,s+8); }
    i=(i+1)&m;
    tries=tries+1;
  }
  return -2;
}
// Register one behavior. Returns node idx (>=0, sets win flags on match),
// -1 on duplicate behavior, -2 on abort (budget/pool/table).
fn reg_behavior(op:i32, arg:i32, l:i32, r:i32, tmp:[]u8, n:i32, in_tgt:[]u8,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, ht:[]u8, htm:i32, htn:i32,
    vp:[]u8, vpc:i32, vpu:[]u8, bud:[]u8, winf:[]u8, winn:[]u8)i32 {
  if(get32(bud,4)==1){ return -2; }
  let h:i64=vec_hash(tmp,n);
  let ex:i32=ht_insert(ht,htm,htn,h,get32(nn,0));
  if(ex==-2){ return -2; }
  if(ex>=0){ return -1; }
  let win:i32=1;
  let e:i32=0;
  while(e<n){ if(get32(tmp,e*4)!=get32(in_tgt,e*4)){ win=0; e=n; } e=e+1; }
  let nd:i32=get32(nn,0);
  if(nd>=ncap){ return -2; }
  let need:i32=n*4;
  let vo:i32=get32(vpu,0);
  if(vo+need>vpc){ return -2; }
  set32(na_op,nd*4,op); set32(na_arg,nd*4,arg);
  set32(na_l,nd*4,l); set32(na_r,nd*4,r); set32(na_vec,nd*4,vo);
  e=0; while(e<n){ set32(vp,vo+e*4,get32(tmp,e*4)); e=e+1; }
  set32(vpu,0,vo+need);
  set32(nn,0,nd+1);
  if(bud_bump(bud,1)==1){ return -2; }
  if(win==1){ set32(winf,0,1); set32(winn,0,nd); }
  return nd;
}
fn leaf_val(kind:i32, arg:i32, e:i32, in0:[]u8, in1:[]u8)i32 {
  if(kind==1){ return get32(in0,e*4); }
  if(kind==2){ return get32(in1,e*4); }
  if(kind==3){ return get32(in0,e*4); }
  return arg;
}
fn reg_leaf(kind:i32, arg:i32, tmp:[]u8, n:i32, in0:[]u8, in1:[]u8, in_tgt:[]u8,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, ht:[]u8, htm:i32, htn:i32,
    vp:[]u8, vpc:i32, vpu:[]u8, bud:[]u8, winf:[]u8, winn:[]u8)i32 {
  let e:i32=0;
  while(e<n){ set32(tmp,e*4,leaf_val(kind,arg,e,in0,in1)); e=e+1; }
  return reg_behavior(kind,arg,-1,-1,tmp,n,in_tgt,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
}
fn reg_unary(x:i32, tmp:[]u8, n:i32, in_tgt:[]u8,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, ht:[]u8, htm:i32, htn:i32,
    vp:[]u8, vpc:i32, vpu:[]u8, bud:[]u8, winf:[]u8, winn:[]u8)i32 {
  let vxo:i32=get32(na_vec,x*4);
  let e:i32=0;
  while(e<n){ set32(tmp,e*4,-get32(vp,vxo+e*4)); e=e+1; }
  return reg_behavior(10,0,x,-1,tmp,n,in_tgt,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
}
fn reg_binary(op:i32, x:i32, y:i32, tmp:[]u8, n:i32, in_tgt:[]u8,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, ht:[]u8, htm:i32, htn:i32,
    vp:[]u8, vpc:i32, vpu:[]u8, bud:[]u8, winf:[]u8, winn:[]u8)i32 {
  let vxo:i32=get32(na_vec,x*4);
  let vyo:i32=get32(na_vec,y*4);
  let e:i32=0;
  while(e<n){
    let a:i32=get32(vp,vxo+e*4);
    let b:i32=get32(vp,vyo+e*4);
    let r:i32=0;
    if(op==20){ r=a+b; }
    else if(op==21){ r=a-b; }
    else if(op==22){ r=a*b; }
    else if(op==23){ if(b!=0){ r=a/b; } }
    else if(op==24){ if(b!=0){ r=mod_nonneg(a,b); } }
    else if(op==25){ if(a==b){ r=1; } }
    else if(op==26){ if(a<b){ r=1; } }
    else if(op==27){ if(a>b){ r=1; } }
    set32(tmp,e*4,r);
    e=e+1;
  }
  return reg_behavior(op,0,x,y,tmp,n,in_tgt,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
}
// Enumerate expressions by size with observational equivalence.
// Returns winning node, -1 if not found, -2 on abort.
fn enum_run(lf_op:[]u8, lf_arg:[]u8, nlf:i32, bops:[]u8, nbops:i32,
    in0:[]u8, in1:[]u8, tgt:[]u8, n:i32, max_sz:i32,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, sz_lo:[]u8, sz_hi:[]u8,
    ht:[]u8, htm:i32, htn:i32, vp:[]u8, vpc:i32, vpu:[]u8,
    tmp:[]u8, bud:[]u8, winf:[]u8, winn:[]u8)i32 {
  set32(nn,0,0); set32(vpu,0,0); set32(winf,0,0);
  ht_clear(ht,htn);
  set32(sz_lo,1*4,0);
  let li:i32=0;
  while(li<nlf){
    let r:i32=reg_leaf(get32(lf_op,li*4),get32(lf_arg,li*4),tmp,n,in0,in1,tgt,
      na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
    if(r==-2){ return -2; }
    if(get32(winf,0)==1){ return get32(winn,0); }
    li=li+1;
  }
  set32(sz_hi,1*4,get32(nn,0));
  let sz:i32=2;
  while(sz<=max_sz){
    if(get32(bud,4)==1){ return -2; }
    set32(sz_lo,sz*4,get32(nn,0));
    let xi:i32=get32(sz_lo,(sz-1)*4);
    let xh:i32=get32(sz_hi,(sz-1)*4);
    while(xi<xh){
      let r:i32=reg_unary(xi,tmp,n,tgt,
        na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
      if(r==-2){ return -2; }
      if(get32(winf,0)==1){ return get32(winn,0); }
      xi=xi+1;
    }
    let sx:i32=1;
    while(sx<=sz-2){
      let sy:i32=sz-1-sx;
      let xa:i32=get32(sz_lo,sx*4); let xb:i32=get32(sz_hi,sx*4);
      let ya:i32=get32(sz_lo,sy*4); let yb:i32=get32(sz_hi,sy*4);
      let xi2:i32=xa;
      while(xi2<xb){
        let yi2:i32=ya;
        while(yi2<yb){
          let bi:i32=0;
          while(bi<nbops){
            let r:i32=reg_binary(get32(bops,bi*4),xi2,yi2,tmp,n,tgt,
              na_op,na_arg,na_l,na_r,na_vec,nn,ncap,ht,htm,htn,vp,vpc,vpu,bud,winf,winn);
            if(r==-2){ return -2; }
            if(get32(winf,0)==1){ return get32(winn,0); }
            bi=bi+1;
          }
          yi2=yi2+1;
        }
        xi2=xi2+1;
      }
      sx=sx+1;
    }
    set32(sz_hi,sz*4,get32(nn,0));
    sz=sz+1;
  }
  return -1;
}

// ================= compiler: expression -> stack program =================
fn compile_node(nd:i32, na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, out:[]u8)void {
  let op:i32=get32(na_op,nd*4);
  if(op==1){ prog_append(out,1,0); return; }
  if(op==2){ prog_append(out,2,0); return; }
  if(op==3){ return; }
  if(op==4){ prog_append(out,0,get32(na_arg,nd*4)); return; }
  if(op==10){
    compile_node(get32(na_l,nd*4),na_op,na_arg,na_l,na_r,out);
    prog_append(out,8,0); return;
  }
  compile_node(get32(na_l,nd*4),na_op,na_arg,na_l,na_r,out);
  compile_node(get32(na_r,nd*4),na_op,na_arg,na_l,na_r,out);
  prog_append(out,expr_vmop(op),0);
  return;
}
fn subtree_has_mod(nd:i32, na_op:[]u8, na_l:[]u8, na_r:[]u8)i32 {
  let op:i32=get32(na_op,nd*4);
  if(op==24){ return 1; }
  if(op==10){ return subtree_has_mod(get32(na_l,nd*4),na_op,na_l,na_r); }
  if(op>=20){
    if(subtree_has_mod(get32(na_l,nd*4),na_op,na_l,na_r)==1){ return 1; }
    return subtree_has_mod(get32(na_r,nd*4),na_op,na_l,na_r);
  }
  return 0;
}
// Nodes are stored in increasing size order, so the first node whose
// subtree contains MOD is the minimal MOD subexpression.
fn find_mod_node(nn:[]u8, na_op:[]u8, na_l:[]u8, na_r:[]u8)i32 {
  let i:i32=0;
  let n:i32=get32(nn,0);
  while(i<n){ if(subtree_has_mod(i,na_op,na_l,na_r)==1){ return i; } i=i+1; }
  return -1;
}
fn prog_has_mod(p:[]u8)i32 {
  let i:i32=0; let l:i32=prog_len(p);
  while(i<l){ if(prog_op(p,i)==7){ return 1; } i=i+1; }
  return 0;
}

// ================= conditional assembler =================
fn probe_out(x:i32, k:i32, cmp:i32)i32 {
  if(cmp==13){ if(x<k){return 1;} return 0; }
  if(cmp==15){ if(x>k){return 1;} return 0; }
  if(x==k){return 1;} return 0;
}
// Synthesize a body (TOP-based expression, sizes 1..4) for one region.
fn synth_body(rx:[]u8, ri:[]u8, rt:[]u8, rn:i32,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, sz_lo:[]u8, sz_hi:[]u8,
    ht:[]u8, htm:i32, htn:i32, vp:[]u8, vpc:i32, vpu:[]u8,
    tmp:[]u8, bud:[]u8)i32 {
  let lf_op:[]u8=z_alloc(6*4); let lf_arg:[]u8=z_alloc(6*4);
  set32(lf_op,0*4,3); set32(lf_arg,0*4,0);
  set32(lf_op,1*4,4); set32(lf_arg,1*4,-1);
  set32(lf_op,2*4,4); set32(lf_arg,2*4,0);
  set32(lf_op,3*4,4); set32(lf_arg,3*4,1);
  set32(lf_op,4*4,4); set32(lf_arg,4*4,2);
  set32(lf_op,5*4,4); set32(lf_arg,5*4,3);
  let bops:[]u8=z_alloc(5*4);
  set32(bops,0*4,20); set32(bops,1*4,21); set32(bops,2*4,22);
  set32(bops,3*4,23); set32(bops,4*4,24);
  let winf:[]u8=z_alloc(4); let winn:[]u8=z_alloc(4);
  let r:i32=enum_run(lf_op,lf_arg,6,bops,5,rx,ri,rt,rn,4,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,winf,winn);
  z_free(lf_op); z_free(lf_arg); z_free(bops); z_free(winf); z_free(winn);
  return r;
}
// Assemble [IN0,DUP,PUSH k,CMP,JZ,Q1,JMP,Q0]. Returns 1 on success
// (out filled), 0 on fail, -1 on abort. Probe used is stored in ph.
fn assemble(in0:[]u8, tgt:[]u8, n:i32, bud:[]u8,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, sz_lo:[]u8, sz_hi:[]u8,
    ht:[]u8, htm:i32, htn:i32, vp:[]u8, vpc:i32, vpu:[]u8,
    tmp:[]u8, lib_buf:[]u8, lib_idx:[]u8, nlib:i32,
    out:[]u8, ph:[]u8)i32 {
  let ks:[]u8=z_alloc(9*4);
  set32(ks,0*4,0); set32(ks,1*4,1); set32(ks,2*4,-1); set32(ks,3*4,2);
  set32(ks,4*4,-2); set32(ks,5*4,3); set32(ks,6*4,-3); set32(ks,7*4,4); set32(ks,8*4,-4);
  let cmps:[]u8=z_alloc(3*4);
  set32(cmps,0*4,13); set32(cmps,1*4,15); set32(cmps,2*4,14);
  let r1x:[]u8=z_alloc(n*4); let r1t:[]u8=z_alloc(n*4); let r1i:[]u8=z_alloc(n*4);
  let r0x:[]u8=z_alloc(n*4); let r0t:[]u8=z_alloc(n*4); let r0i:[]u8=z_alloc(n*4);
  let e1:[]u8=z_alloc(40*4); let e2:[]u8=z_alloc(40*4); let e3:[]u8=z_alloc(40*4);
  let nprobes:i32=0;
  let ki:i32=0;
  while(ki<9){
    let k:i32=get32(ks,ki*4);
    let ci:i32=0;
    while(ci<3){
      let cmp:i32=get32(cmps,ci*4);
      nprobes=nprobes+1;
      let n1:i32=0; let n0:i32=0;
      let e:i32=0;
      while(e<n){
        if(probe_out(get32(in0,e*4),k,cmp)==1){
          set32(r1x,n1*4,get32(in0,e*4)); set32(r1t,n1*4,get32(tgt,e*4)); set32(r1i,n1*4,0); n1=n1+1;
        } else {
          set32(r0x,n0*4,get32(in0,e*4)); set32(r0t,n0*4,get32(tgt,e*4)); set32(r0i,n0*4,0); n0=n0+1;
        }
        e=e+1;
      }
      if(n1>=2 && n0>=2){
        let b1:i32=synth_body(r1x,r1i,r1t,n1,
          na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
          ht,htm,htn,vp,vpc,vpu,tmp,bud);
        if(b1==-2 || get32(bud,4)==1){
          z_free(ks); z_free(cmps); z_free(r1x); z_free(r1t); z_free(r1i);
          z_free(r0x); z_free(r0t); z_free(r0i); z_free(e1); z_free(e2); z_free(e3);
          return -1;
        }
        if(b1>=0){
          let b0:i32=synth_body(r0x,r0i,r0t,n0,
            na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
            ht,htm,htn,vp,vpc,vpu,tmp,bud);
          if(b0==-2 || get32(bud,4)==1){
            z_free(ks); z_free(cmps); z_free(r1x); z_free(r1t); z_free(r1i);
            z_free(r0x); z_free(r0t); z_free(r0i); z_free(e1); z_free(e2); z_free(e3);
            return -1;
          }
          if(b0>=0){
            let q1:[]u8=prog_new(64);
            compile_node(b1,na_op,na_arg,na_l,na_r,q1);
            let q0:[]u8=prog_new(64);
            compile_node(b0,na_op,na_arg,na_l,na_r,q0);
            let q1l:i32=prog_len(q1); let q0l:i32=prog_len(q0);
            set32(out,0,0);
            prog_append(out,1,0);
            prog_append(out,9,0);
            prog_append(out,0,k);
            prog_append(out,cmp,0);
            let else_pc:i32=5+q1l+1;
            prog_append(out,16,else_pc);
            let i:i32=0;
            while(i<q1l){ prog_append(out,prog_op(q1,i),prog_arg(q1,i)); i=i+1; }
            let end_pc:i32=5+q1l+1+q0l;
            prog_append(out,18,end_pc);
            i=0;
            while(i<q0l){ prog_append(out,prog_op(q0,i),prog_arg(q0,i)); i=i+1; }
            // verify on the frozen VM (assembled programs never read IN1)
            let z:i32=0;
            while(z<n){ set32(e2,z*4,0); z=z+1; }
            let c:i32=eval_exact(out,in0,e2,tgt,n,lib_buf,lib_idx,nlib,bud);
            z_free(q1); z_free(q0);
            set32(ph,0,k); set32(ph,4,cmp); set32(ph,8,nprobes);
            emit("ASSEMBLE ok k="); e64(k); emit(" cmp="); e64(cmp);
            emit(" probes="); e64(nprobes); emit("\n");
            z_free(ks); z_free(cmps); z_free(r1x); z_free(r1t); z_free(r1i);
            z_free(r0x); z_free(r0t); z_free(r0i); z_free(e1); z_free(e2); z_free(e3);
            if(c==n){ return 1; }
            return 0;
          }
        }
      }
      ci=ci+1;
    }
    ki=ki+1;
  }
  emit("ASSEMBLE fail probes="); e64(nprobes); emit("\n");
  z_free(ks); z_free(cmps); z_free(r1x); z_free(r1t); z_free(r1i);
  z_free(r0x); z_free(r0t); z_free(r0i); z_free(e1); z_free(e2); z_free(e3);
  return 0;
}

// ================= library =================
// Library: genexec2-format lib_buf/lib_idx + metadata.
// fr_sig: 16 frags x 81 i32. fr_kinks: 16 frags x 16 i32.
fn lib_nlib(nl:[]u8)i32 { return get32(nl,0); }

// run fbody as a stack transform: [PUSH x] + fbody (for agnostic fragments)
fn lib_run_frag_tmp(fbody:[]u8, x:i32, stack:[]u8, rs:[]u8)i32 {
  let p:[]u8=prog_new(prog_len(fbody)+1);
  prog_append(p,0,x);
  let i:i32=0;
  while(i<prog_len(fbody)){ prog_append(p,prog_op(fbody,i),prog_arg(fbody,i)); i=i+1; }
  let eb:[]u8=z_alloc(8); let ei:[]u8=z_alloc(8);
  let o:i32=vm_run(p,prog_len(p),0,0,eb,ei,0,stack,rs);
  z_free(p); z_free(eb); z_free(ei);
  return o;
}
// run fbody as a main program with in0=x
fn run_main_1(fbody:[]u8, x:i32, lib_buf:[]u8, lib_idx:[]u8, nlib:i32, stack:[]u8, rs:[]u8)i32 {
  return vm_run(fbody,prog_len(fbody),x,0,lib_buf,lib_idx,nlib,stack,rs);
}
// run fbody as a main program with in0=a, in1=b
fn run_main_2(fbody:[]u8, a:i32, b:i32, lib_buf:[]u8, lib_idx:[]u8, nlib:i32, stack:[]u8, rs:[]u8)i32 {
  return vm_run(fbody,prog_len(fbody),a,b,lib_buf,lib_idx,nlib,stack,rs);
}

// ================= inducer =================
// Promote a fragment body. kind is a log tag. Returns frag id,
// -1 on behavioral dedup skip, -2 on abort.
fn induce_promote(tid:i32, fbody:[]u8, n_inputs:i32, agnostic:i32, kind:[]u8,
    lib_buf:[]u8, lib_idx:[]u8, nl:[]u8, lu:[]u8,
    fr_nin:[]u8, fr_agn:[]u8, fr_sgn:[]u8, fr_sig:[]u8, fr_nk:[]u8, fr_kinks:[]u8,
    bud:[]u8)i32 {
  let nlib:i32=get32(nl,0);
  if(nlib>=16){ return -2; }
  let stack:[]u8=z_alloc(256*4);
  let rs:[]u8=z_alloc(64*8);
  // generality: exact target on the probe domain.
  // 1-input: s in -12..12 vs target1. 2-input (MOD-expression, prereg):
  // s in -12..12 with in0=s, in1=0 vs target2(s,0).
  let ok:i32=1;
  if(n_inputs==1){
    let s:i32=-12;
    while(s<=12){
      let o:i32=0;
      if(agnostic==1){ o=lib_run_frag_tmp(fbody,s,stack,rs); }
      else { o=run_main_1(fbody,s,lib_buf,lib_idx,nlib,stack,rs); }
      if(o!=target1(tid,s)){ ok=0; s=13; }
      s=s+1;
    }
  } else {
    let s:i32=-12;
    while(s<=12){
      let o:i32=run_main_2(fbody,s,0,lib_buf,lib_idx,nlib,stack,rs);
      if(o!=target2(s,0)){ ok=0; s=13; }
      s=s+1;
    }
  }
  if(ok==0){
    emit("INDUCE kind="); emit(kind); emit(" generality=FAIL\n");
    z_free(stack); z_free(rs);
    return -2;
  }
  // signature on probe set S
  let sgn:i32=0;
  let sig:[]u8=z_alloc(81*4);
  if(n_inputs==1){
    let s:i32=-4;
    while(s<=4){
      let o:i32=0;
      if(agnostic==1){ o=lib_run_frag_tmp(fbody,s,stack,rs); }
      else { o=run_main_1(fbody,s,lib_buf,lib_idx,nlib,stack,rs); }
      set32(sig,sgn*4,o); sgn=sgn+1; s=s+1;
    }
  } else {
    let a:i32=-4;
    while(a<=4){
      let b:i32=-4;
      while(b<=4){
        set32(sig,sgn*4,run_main_2(fbody,a,b,lib_buf,lib_idx,nlib,stack,rs));
        sgn=sgn+1; b=b+1;
      }
      a=a+1;
    }
  }
  // behavioral dedup
  let f:i32=0;
  while(f<nlib){
    if(get32(fr_nin,f*4)==n_inputs && get32(fr_sgn,f*4)==sgn){
      let same:i32=1;
      let i:i32=0;
      while(i<sgn){ if(get32(sig,i*4)!=get32(fr_sig,(f*81+i)*4)){ same=0; i=sgn; } i=i+1; }
      if(same==1){
        emit("INDUCE kind="); emit(kind); emit(" DEDUP-SKIP frag="); e64(f); emit("\n");
        z_free(stack); z_free(rs); z_free(sig);
        return -1;
      }
    }
    f=f+1;
  }
  // promote
  let id:i32=nlib;
  let nu:i32=lib_promote(lib_buf,lib_idx,nlib,fbody,get32(lu,0));
  set32(lu,0,nu);
  set32(nl,0,nlib+1);
  set32(fr_nin,id*4,n_inputs);
  set32(fr_agn,id*4,agnostic);
  set32(fr_sgn,id*4,sgn);
  let i:i32=0;
  while(i<sgn){ set32(fr_sig,(id*81+i)*4,get32(sig,i*4)); i=i+1; }
  // kinks for single-input fragments (from signature on sorted S)
  let nk:i32=0;
  if(n_inputs==1){
    let sx:[]u8=z_alloc(9*4); let st:[]u8=z_alloc(9*4);
    let s:i32=-4; let j:i32=0;
    while(s<=4){ set32(sx,j*4,s); set32(st,j*4,get32(sig,j*4)); j=j+1; s=s+1; }
    let kt:[]u8=z_alloc(16*4);
    nk=compute_kinks(sx,st,9,kt);
    let q:i32=0;
    while(q<nk){ set32(fr_kinks,(id*16+q)*4,get32(kt,q*4)); q=q+1; }
    z_free(sx); z_free(st); z_free(kt);
  }
  set32(fr_nk,id*4,nk);
  emit("INDUCE kind="); emit(kind); emit(" id="); e64(id);
  emit(" nin="); e64(n_inputs); emit(" agnostic="); e64(agnostic);
  emit(" siglen="); e64(sgn); emit(" kinks="); e64(nk); emit(" generality=ok\n");
  z_free(stack); z_free(rs); z_free(sig);
  return id;
}

// ================= composer =================
// SEG13: 0..4=PUSH(-1..3) 5=IN0 6=IN1 7=ADD 8=SUB 9=MUL 10=NEG 11=DUP 12=DROP
fn seg_vmop(o:i32, argp:[]u8)i32 {
  if(o<5){ set32(argp,0,o-1); return 0; }
  set32(argp,0,0);
  if(o==5){return 1;} if(o==6){return 2;} if(o==7){return 3;}
  if(o==8){return 4;} if(o==9){return 5;} if(o==10){return 8;}
  if(o==11){return 9;} return 10;
}
fn seg_init(ops:[]u8, len:i32)void {
  let i:i32=0; while(i<len){ set32(ops,i*4,0); i=i+1; }
  return;
}
// increment base-13 counter; returns 0 on overflow
fn seg_next(ops:[]u8, len:i32)i32 {
  let i:i32=len-1;
  while(i>=0){
    let o:i32=get32(ops,i*4);
    if(o<12){ set32(ops,i*4,o+1); return 1; }
    set32(ops,i*4,0);
    i=i-1;
  }
  return 0;
}
fn build_call_prog(fid:i32, p2:[]u8, l2:i32, p3:[]u8, l3:i32, two:i32)[]u8 {
  let p:[]u8=prog_new(2+l2+2+l3+2);
  prog_append(p,1,0);
  prog_append(p,19,fid);
  let a:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<l2){ prog_append(p,seg_vmop(get32(p2,i*4),a),get32(a,0)); i=i+1; }
  if(two==1){
    prog_append(p,19,fid);
    i=0;
    while(i<l3){ prog_append(p,seg_vmop(get32(p3,i*4),a),get32(a,0)); i=i+1; }
  }
  z_free(a);
  return p;
}
// Compose [IN0,CALL fid,P2] then [IN0,CALL fid,P2,CALL fid,P3].
// Returns 1 on success (out filled, calls[0]=1 or 2), 0 on fail, -1 on abort.
fn compose(fid:i32, in0:[]u8, in1:[]u8, tgt:[]u8, n:i32,
    lib_buf:[]u8, lib_idx:[]u8, nlib:i32, bud:[]u8, out:[]u8, calls:[]u8)i32 {
  let p2:[]u8=z_alloc(3*4);
  let p3:[]u8=z_alloc(2*4);
  let l2:i32=0;
  while(l2<=3){
    seg_init(p2,l2);
    while(1==1){
      let cand:[]u8=build_call_prog(fid,p2,l2,p3,0,0);
      let c:i32=eval_exact(cand,in0,in1,tgt,n,lib_buf,lib_idx,nlib,bud);
      if(get32(bud,4)==1){ z_free(cand); z_free(p2); z_free(p3); return -1; }
      if(c==n){
        prog_copy(out,cand); set32(calls,0,1);
        z_free(cand); z_free(p2); z_free(p3);
        return 1;
      }
      z_free(cand);
      if(seg_next(p2,l2)==0){ break; }
    }
    l2=l2+1;
  }
  emit("COMPOSE 1-CALL exhausted (2380 candidates, none exact)\n");
  l2=0;
  while(l2<=3){
    seg_init(p2,l2);
    while(1==1){
      let l3:i32=0;
      while(l3<=2){
        seg_init(p3,l3);
        while(1==1){
          let cand:[]u8=build_call_prog(fid,p2,l2,p3,l3,1);
          let c:i32=eval_exact(cand,in0,in1,tgt,n,lib_buf,lib_idx,nlib,bud);
          if(get32(bud,4)==1){ z_free(cand); z_free(p2); z_free(p3); return -1; }
          if(c==n){
            prog_copy(out,cand); set32(calls,0,2);
            z_free(cand); z_free(p2); z_free(p3);
            return 1;
          }
          z_free(cand);
          if(seg_next(p3,l3)==0){ break; }
        }
        l3=l3+1;
      }
      if(seg_next(p2,l2)==0){ break; }
    }
    l2=l2+1;
  }
  z_free(p2); z_free(p3);
  return 0;
}
// Retrieval: input-agnostic single-input fragments whose kink set is a
// subset of the task kink set. Logs every decision. Returns count, fills ret.
fn do_retrieve(ret:[]u8, nlib:i32, fr_nin:[]u8, fr_agn:[]u8, fr_nk:[]u8, fr_kinks:[]u8,
    kinks:[]u8, nk:i32)i32 {
  let c:i32=0;
  let f:i32=0;
  while(f<nlib){
    let ok:i32=0;
    let reason:[]u8="skip-nonreusable";
    if(get32(fr_nin,f*4)==1 && get32(fr_agn,f*4)==1){
      reason="skip-kink-mismatch";
      let sub:i32=1;
      let fk:i32=get32(fr_nk,f*4);
      let i:i32=0;
      while(i<fk){
        let kv:i32=get32(fr_kinks,(f*16+i)*4);
        let j:i32=0; let found:i32=0;
        while(j<nk){ if(get32(kinks,j*4)==kv){ found=1; } j=j+1; }
        if(found==0){ sub=0; }
        i=i+1;
      }
      if(sub==1){ ok=1; reason="match-kink-subset"; }
    }
    emit("RETRIEVE-DECISION frag="); e64(f);
    if(ok==1){ emit(" match "); } else { emit(" skip "); }
    emit(reason); emit("\n");
    if(ok==1){ set32(ret,c*4,f); c=c+1; }
    f=f+1;
  }
  return c;
}

// ================= base attempt =================
fn base_attempt(e0:[]u8, e1:[]u8, et:[]u8, n:i32, max_sz:i32,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, sz_lo:[]u8, sz_hi:[]u8,
    ht:[]u8, htm:i32, htn:i32, vp:[]u8, vpc:i32, vpu:[]u8,
    tmp:[]u8, bud:[]u8, sol:[]u8, wnode:[]u8,
    lib_buf:[]u8, lib_idx:[]u8, nlib:i32)i32 {
  let lf_op:[]u8=z_alloc(7*4); let lf_arg:[]u8=z_alloc(7*4);
  set32(lf_op,0*4,1); set32(lf_arg,0*4,0);
  set32(lf_op,1*4,2); set32(lf_arg,1*4,0);
  set32(lf_op,2*4,4); set32(lf_arg,2*4,-1);
  set32(lf_op,3*4,4); set32(lf_arg,3*4,0);
  set32(lf_op,4*4,4); set32(lf_arg,4*4,1);
  set32(lf_op,5*4,4); set32(lf_arg,5*4,2);
  set32(lf_op,6*4,4); set32(lf_arg,6*4,3);
  let bops:[]u8=z_alloc(8*4);
  set32(bops,0*4,20); set32(bops,1*4,21); set32(bops,2*4,22); set32(bops,3*4,23);
  set32(bops,4*4,24); set32(bops,5*4,25); set32(bops,6*4,26); set32(bops,7*4,27);
  let winf:[]u8=z_alloc(4); let wn:[]u8=z_alloc(4);
  let r:i32=enum_run(lf_op,lf_arg,7,bops,8,e0,e1,et,n,max_sz,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,winf,wn);
  z_free(lf_op); z_free(lf_arg); z_free(bops); z_free(winf); z_free(wn);
  if(r==-2 || get32(bud,4)==1){ return -1; }
  if(r<0){ emit("BASE fail max_sz="); e64(max_sz); emit("\n"); return 0; }
  set32(wnode,0,r);
  set32(sol,0,0);
  compile_node(r,na_op,na_arg,na_l,na_r,sol);
  emit("BASE ok node="); e64(r); emit(" bytelen="); e64(prog_len(sol)); emit("\n");
  let c:i32=eval_exact(sol,e0,e1,et,n,lib_buf,lib_idx,nlib,bud);
  if(c==n){ return 1; }
  return 0;
}

// ================= task runner =================
fn run_task(tid:i32, fresh:i32,
    na_op:[]u8, na_arg:[]u8, na_l:[]u8, na_r:[]u8, na_vec:[]u8,
    nn:[]u8, ncap:i32, sz_lo:[]u8, sz_hi:[]u8,
    ht:[]u8, htm:i32, htn:i32, vp:[]u8, vpc:i32, vpu:[]u8,
    tmp:[]u8, bud:[]u8,
    lib_buf:[]u8, lib_idx:[]u8, nl:[]u8, lu:[]u8,
    fr_nin:[]u8, fr_agn:[]u8, fr_sgn:[]u8, fr_sig:[]u8, fr_nk:[]u8, fr_kinks:[]u8,
    res:[]u8)void {
  let t0:i64=now_ms();
  set32(bud,0,0); set32(bud,4,0);
  let nlib_before:i32=get32(nl,0);
  let e0:[]u8=z_alloc(40*4); let e1:[]u8=z_alloc(40*4); let et:[]u8=z_alloc(40*4);
  let n:i32=build_train(tid,e0,e1,et);
  let n_inputs:i32=1;
  if(tid==3){ n_inputs=2; }
  emit("TASK T"); e64(tid); emit(" fresh="); e64(fresh); emit(" ntrain="); e64(n); emit("\n");
  let kinks:[]u8=z_alloc(16*4);
  let nk:i32=0;
  if(n_inputs==1){ nk=compute_kinks(e0,et,n,kinks); }
  emit("KINK nk="); e64(nk);
  let qi:i32=0;
  while(qi<nk){ emit(" "); e64(get32(kinks,qi*4)); qi=qi+1; }
  emit("\n");
  let sol:[]u8=prog_new(32);
  let ok:i32=0;
  let via:i32=0;
  let wnode:[]u8=z_alloc(4); set32(wnode,0,-1);
  let calls:[]u8=z_alloc(4); set32(calls,0,0);
  let aborted:i32=0;
  let ret:[]u8=z_alloc(16*4);
  let nret:i32=0;
  if(n_inputs==1 && nk>0){
    nret=do_retrieve(ret,get32(nl,0),fr_nin,fr_agn,fr_nk,fr_kinks,kinks,nk);
  }
  if(nret>0){
    emit("ROUTE composition\n");
    let ri:i32=0;
    while(ri<nret){
      let fid:i32=get32(ret,ri*4);
      let cr:i32=compose(fid,e0,e1,et,n,lib_buf,lib_idx,get32(nl,0),bud,sol,calls);
      if(cr==-1){ aborted=1; ri=nret; }
      if(cr==1){
        ok=1; via=3;
        let s:i32=0;
        while(s<get32(calls,0)){
          emit("RETRIEVE frag="); e64(fid); emit(" site="); e64(s+1); emit(" kinkmatch=yes\n");
          s=s+1;
        }
        ri=nret;
      }
      ri=ri+1;
    }
  }
  if(ok==0 && aborted==0 && n_inputs==1 && nk>0){
    if(nret>0){ emit("ROUTE assembly (composition failed)\n"); }
    else { emit("ROUTE assembly\n"); }
    let ph:[]u8=z_alloc(12);
    let ar:i32=assemble(e0,et,n,bud,
      na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
      ht,htm,htn,vp,vpc,vpu,tmp,lib_buf,lib_idx,get32(nl,0),sol,ph);
    z_free(ph);
    if(ar==-1){ aborted=1; }
    if(ar==1){ ok=1; via=2; }
  }
  if(ok==0 && aborted==0 && via==0){
    let msz:i32=8;
    if(n_inputs==1 && nk>0){ msz=5; emit("ROUTE base-bounded\n"); }
    else { emit("ROUTE base\n"); }
    let br:i32=base_attempt(e0,e1,et,n,msz,
      na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
      ht,htm,htn,vp,vpc,vpu,tmp,bud,sol,wnode,
      lib_buf,lib_idx,get32(nl,0));
    if(br==-1){ aborted=1; }
    if(br==1){ ok=1; via=1; }
  }
  z_free(ret);
  // induction
  if(ok==1 && aborted==0){
    if(via==2){
      let clean:i32=1;
      if(prog_len(sol)<1 || prog_op(sol,0)!=1){ clean=0; }
      let i:i32=1;
      while(i<prog_len(sol)){ let o:i32=prog_op(sol,i); if(o==1 || o==2){ clean=0; } i=i+1; }
      if(clean==1){
        let fb:[]u8=prog_new(prog_len(sol));
        i=1;
        // dropping the leading IN0 shifts all absolute jump targets down by 1
        while(i<prog_len(sol)){
          let o:i32=prog_op(sol,i); let a:i32=prog_arg(sol,i);
          if(o==16 || o==17 || o==18){ a=a-1; }
          prog_append(fb,o,a); i=i+1;
        }
        emit("EXTRACT kind=cond drop-leading-IN0 len="); e64(prog_len(fb)); emit(" jumps-adjusted\n");
        induce_promote(tid,fb,1,1,"cond",
          lib_buf,lib_idx,nl,lu,fr_nin,fr_agn,fr_sgn,fr_sig,fr_nk,fr_kinks,bud);
        z_free(fb);
      } else {
        emit("EXTRACT kind=cond not-agnostic-skip\n");
      }
    } else if(via==1 && prog_has_mod(sol)==1){
      // Prereg 1d: fragment body = the compiled program (whole solution).
      let has_in1:i32=0; let has_in0:i32=0;
      let i:i32=0;
      while(i<prog_len(sol)){
        let o:i32=prog_op(sol,i);
        if(o==1){ has_in0=1; } if(o==2){ has_in1=1; }
        i=i+1;
      }
      let nin:i32=1; if(has_in1==1){ nin=2; }
      let agn:i32=1; if(has_in0==1 || has_in1==1){ agn=0; }
      emit("EXTRACT kind=mod whole-program len="); e64(prog_len(sol));
      emit(" nin="); e64(nin); emit("\n");
      induce_promote(tid,sol,nin,agn,"mod",
        lib_buf,lib_idx,nl,lu,fr_nin,fr_agn,fr_sgn,fr_sig,fr_nk,fr_kinks,bud);
    }
  }
  // held-out
  let h0:[]u8=z_alloc(40*4); let h1:[]u8=z_alloc(40*4); let ht2:[]u8=z_alloc(40*4);
  let hn:i32=build_heldout(tid,h0,h1,ht2);
  let hc:i32=0;
  if(ok==1 && aborted==0){
    let stack:[]u8=z_alloc(256*4); let rs:[]u8=z_alloc(64*8);
    let e:i32=0;
    while(e<hn){
      let o:i32=vm_run(sol,prog_len(sol),get32(h0,e*4),get32(h1,e*4),
        lib_buf,lib_idx,get32(nl,0),stack,rs);
      if(o==get32(ht2,e*4)){ hc=hc+1; }
      e=e+1;
    }
    z_free(stack); z_free(rs);
  }
  let ms:i64=now_ms()-t0;
  emit("RESULT T"); e64(tid); emit(" fresh="); e64(fresh);
  if(aborted==1){ emit(" ABORT-BUDGET"); }
  else if(ok==1){ emit(" SOLVE"); } else { emit(" FAIL"); }
  emit(" via=");
  if(via==1){ emit("base"); } else if(via==2){ emit("assembly"); }
  else if(via==3){ emit("composition"); } else { emit("none"); }
  emit(" evals="); e64(get32(bud,0));
  emit(" ms="); emit(i64s(ms));
  emit(" train="); e64(n);
  emit(" heldout="); e64(hc); emit("/"); e64(hn);
  emit(" bytelen="); e64(prog_len(sol));
  emit(" exprcache="); e64(get32(nn,0));
  emit(" nlib="); e64(nlib_before); emit("->"); e64(get32(nl,0));
  emit("\n");
  set32(res,0,get32(bud,0));
  set32(res,4,ms as i32);
  if(ok==1 && aborted==0){ set32(res,8,1); } else { set32(res,8,0); }
  set32(res,12,via);
  set32(res,16,prog_len(sol));
  set32(res,20,hc); set32(res,24,hn);
  set32(res,28,nlib_before); set32(res,32,get32(nl,0));
  set32(res,36,get32(nn,0));
  z_free(e0); z_free(e1); z_free(et); z_free(kinks); z_free(sol);
  z_free(wnode); z_free(calls);
  z_free(h0); z_free(h1); z_free(ht2);
  return;
}

// ================= main =================
fn main()void {
  emit("HYPB-START\n");
  let ncap:i32=600000;
  let na_op:[]u8=z_alloc(ncap*4);
  let na_arg:[]u8=z_alloc(ncap*4);
  let na_l:[]u8=z_alloc(ncap*4);
  let na_r:[]u8=z_alloc(ncap*4);
  let na_vec:[]u8=z_alloc(ncap*4);
  let nn:[]u8=z_alloc(4);
  let sz_lo:[]u8=z_alloc(16*4);
  let sz_hi:[]u8=z_alloc(16*4);
  let htn:i32=1048576; let htm:i32=1048575;
  let ht:[]u8=z_alloc(htn*16);
  let vpc:i32=83886080;
  let vp:[]u8=z_alloc(vpc);
  let vpu:[]u8=z_alloc(4);
  let tmp:[]u8=z_alloc(40*4);
  let bud:[]u8=z_alloc(8);
  // carried library
  let cb:[]u8=z_alloc(65536); let cidx:[]u8=z_alloc(16*4);
  let cnl:[]u8=z_alloc(4); set32(cnl,0,0);
  let clu:[]u8=z_alloc(4); set32(clu,0,0);
  let c_nin:[]u8=z_alloc(16*4); let c_agn:[]u8=z_alloc(16*4);
  let c_sgn:[]u8=z_alloc(16*4); let c_sig:[]u8=z_alloc(16*81*4);
  let c_nk:[]u8=z_alloc(16*4); let c_kk:[]u8=z_alloc(16*16*4);
  // fresh library
  let fb2:[]u8=z_alloc(65536); let fidx:[]u8=z_alloc(16*4);
  let fnl:[]u8=z_alloc(4); set32(fnl,0,0);
  let flu:[]u8=z_alloc(4); set32(flu,0,0);
  let f_nin:[]u8=z_alloc(16*4); let f_agn:[]u8=z_alloc(16*4);
  let f_sgn:[]u8=z_alloc(16*4); let f_sig:[]u8=z_alloc(16*81*4);
  let f_nk:[]u8=z_alloc(16*4); let f_kk:[]u8=z_alloc(16*16*4);
  let r0:[]u8=z_alloc(10*4); let r1:[]u8=z_alloc(10*4); let r2:[]u8=z_alloc(10*4);
  let r3:[]u8=z_alloc(10*4); let r4:[]u8=z_alloc(10*4); let r5:[]u8=z_alloc(10*4);
  run_task(0,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r0);
  run_task(1,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r1);
  run_task(2,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r2);
  run_task(3,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r3);
  run_task(4,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r4);
  run_task(5,0,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    cb,cidx,cnl,clu,c_nin,c_agn,c_sgn,c_sig,c_nk,c_kk, r5);
  let r4f:[]u8=z_alloc(10*4); let r5f:[]u8=z_alloc(10*4);
  run_task(4,1,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    fb2,fidx,fnl,flu,f_nin,f_agn,f_sgn,f_sig,f_nk,f_kk, r4f);
  run_task(5,1,
    na_op,na_arg,na_l,na_r,na_vec,nn,ncap,sz_lo,sz_hi,
    ht,htm,htn,vp,vpc,vpu,tmp,bud,
    fb2,fidx,fnl,flu,f_nin,f_agn,f_sgn,f_sig,f_nk,f_kk, r5f);
  emit("SUMMARY transfer T4 carried-evals="); e64(get32(r4,0));
  emit(" fresh-evals="); e64(get32(r4f,0));
  emit(" carried-sol="); e64(get32(r4,8));
  emit(" fresh-sol="); e64(get32(r4f,8)); emit("\n");
  emit("SUMMARY transfer T5 carried-evals="); e64(get32(r5,0));
  emit(" fresh-evals="); e64(get32(r5f,0));
  emit(" carried-sol="); e64(get32(r5,8));
  emit(" fresh-sol="); e64(get32(r5f,8)); emit("\n");
  emit("HYPB-DONE\n");
}

// belief_sealed.zag -- Sealed adversarial re-test of the antifarm rule.
// BELIEF-SEALED. Unfrozen variant. Pure Zag.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// Rule layer (fn z_alloc through fn ev_calibrate) is byte-identical to
// belief_antifarm.zag (H-DECEPT-4, commit 035e9593c), verified by cmp.
// Only this header and the scenario layer below are new: four sealed
// worlds designed AFTER reading the frozen rule.
// World A: slow-burn deceiver (mostly truthful, rare high-stake lies).
// World B: colluding pair (joint lies, then alternating reform-launder).
// World C: reformed deceiver (two early betrayals, then 200 honest).
// World D: noisy-but-honest (frequent low-stake errors, never a lie).
// The binary asserts the frozen PREREG rule predictions; per-world
// SURVIVE/KILL/BOUND verdicts are scored in REPORT.md against the
// frozen rationality bars.
//
// Output discipline (toolchain lesson 2026-10-02): ONE preallocated
// output buffer, cursor returning emit helpers formatting numbers
// directly into the buffer, a single _zag_raw_syscall(1,1,ptr,len)
// write at the end. No _zag_print anywhere.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }
fn gt(a:i32,b:i32)i32 { if(a>b){return 1;} return 0; }

// ---- single output buffer, cursor returning emit helpers ----
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}

// ============ state block: 1040 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header: 0 nev, 1 nsrc, 2 wmax, 3 first_contrary, 4 revision_seq,
// 5 s1, 6 s2, 7 truth, 8 abl_identity, 9 reserved, 10 nid,
// 11 nevicted, 12 ndup, 13 last_contrib, 14 last_penalty
fn EVB()i32 { return 16; }
fn EVN()i32 { return 64; }
fn EVW()i32 { return 7; }   // qid,hyp,w,src,phase,contrib,eid
fn SRB()i32 { return 464; }
fn SRN()i32 { return 64; }
fn SRW()i32 { return 5; }   // correct,total,streak,betray,extid
fn DCB()i32 { return 784; }
fn DCN()i32 { return 32; }
fn DCW()i32 { return 4; }   // src,hyp,phase,count
fn IDB()i32 { return 912; }
fn IDN()i32 { return 128; }
fn NCELL()i32 { return 1040; }

fn st_init(B:[]u8,abl_identity:i32)void {
  let i:i32=0;
  while(i<NCELL()){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_identity);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+4);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+4)==0){
      cs(B,SRB()+i*SRW()+4,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn src_rel(B:[]u8,si:i32)i32 {
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}
fn src_streak(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+2);
}
fn src_betray(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+3);
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- event identity register: familiarity without recall ----
fn id_seen(B:[]u8,eid:i32)i32 {
  let i:i32=0;
  while(i<cg(B,10)){
    if(cg(B,IDB()+i)==eid){ return 1; }
    i=i+1;
  }
  return 0;
}
fn id_add(B:[]u8,eid:i32)void {
  let n:i32=cg(B,10);
  if(n<IDN()){ cs(B,IDB()+n,eid); cs(B,10,n+1); }
  return;
}

// ---- evidence record with FIFO eviction under memory pressure ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32,eid:i32)i32 {
  let n:i32=cg(B,0);
  let slot:i32=n;
  if(n>=EVN()){
    let i:i32=0;
    while(i<EVN()-1){
      let a:i32=EVB()+i*EVW();
      let c:i32=EVB()+(i+1)*EVW();
      let k:i32=0;
      while(k<EVW()){ cs(B,a+k,cg(B,c+k)); k=k+1; }
      i=i+1;
    }
    slot=EVN()-1;
    cs(B,11,cg(B,11)+1);
  }
  let o:i32=EVB()+slot*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib); cs(B,o+6,eid);
  if(n<EVN()){ cs(B,0,n+1); }
  return slot+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- trajectory base penalty: surprise weight of a wrong outcome ----
// base = floor(c * w / (c + w)); zero on a zero streak, saturates at w.
fn traj_penalty(c:i32,w:i32)i32 {
  if(c<=0){ return 0; }
  if(w<1){ w=1; }
  return c*w/(c+w);
}

// ---- calibration: claim on a verifiable fact; outcome observed ----
// H-DECEPT-4 rule: wrong with c>0 costs base*(1+b) where b is the
// per-source count of prior betrayals; b increments per betrayal and
// decays one unit per 100 consecutive honest outcomes. Wrong with
// c==0 is linear null and leaves b untouched.
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r;
  let seq:i32=ev_record(B,0,hyp,w,src,0,contrib,eid);
  note_wmax(B,contrib);
  let c:i32=src_streak(B,si);
  let b:i32=src_betray(B,si);
  if(hyp==truth){
    cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
    cs(B,SRB()+si*SRW()+2,c+1);
    let nc:i32=c+1;
    if(nc-(nc/100)*100==0){
      if(b>0){ cs(B,SRB()+si*SRW()+3,b-1); }
    }
  } else {
    if(c>0){
      let base:i32=traj_penalty(c,w);
      let p:i32=base*(1+b);
      cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1+p);
      cs(B,SRB()+si*SRW()+3,b+1);
      cs(B,14,p);
    } else {
      cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
      cs(B,14,0);
    }
    cs(B,SRB()+si*SRW()+2,0);
  }
  return seq;
}

// ---- sealed scenario helpers ----
// n honest claims at weight w for source src; eids e0..e0+n-1.
// Returns the next free eid.
fn honest(B:[]u8,n:i32,src:i32,w:i32,e0:i32)i32 {
  let i:i32=0;
  while(i<n){ let r0:i32=ev_calibrate(B,src,1,w,1,e0+i); i=i+1; }
  return e0+n;
}
// one wrong claim at weight w for source src (hyp=1, truth=2).
// Returns the next free eid.
fn wrong(B:[]u8,src:i32,w:i32,e0:i32)i32 {
  let r0:i32=ev_calibrate(B,src,1,w,2,e0);
  return e0+1;
}

fn main()i32 {
  let ob:[]u8=z_alloc(131072);
  let at:i32=0;
  let F:[]u8=z_alloc(4);

  // ============ World A: slow-burn deceiver (ext 80) ============
  at=e_str(ob,at,"WORLD A slow-burn deceiver"); at=e_nl(ob,at);
  let A:[]u8=z_alloc(NCELL()*4); st_init(A,0);
  let e:i32=9001;
  let as0:i32=src_idx(A,80);
  // A1: 500 honest, lie w=8
  e=honest(A,500,80,1,e);
  let ab0:i32=src_betray(A,as0);
  let ac0:i32=src_streak(A,as0);
  let abase:i32=traj_penalty(ac0,8);
  let ap:i32=abase*(1+ab0);
  e=wrong(A,80,8,e);
  at=e_str(ob,at,"A1 c="); at=e_i32(ob,at,ac0);
  at=e_str(ob,at," b0="); at=e_i32(ob,at,ab0);
  at=e_str(ob,at," base="); at=e_i32(ob,at,abase);
  at=e_str(ob,at," p="); at=e_i32(ob,at,ap);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(A,as0));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(A,as0)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(ac0,500),"A-A1-c-500");
  at=chk(ob,at,F,eq(ab0,0),"A-A1-b0-0");
  at=chk(ob,at,F,eq(abase,7),"A-A1-base-7");
  at=chk(ob,at,F,eq(ap,7),"A-A1-p-7");
  at=chk(ob,at,F,eq(src_rel(A,as0),984),"A-A1-rel-984");
  at=chk(ob,at,F,eq(src_betray(A,as0),1),"A-A1-bafter-1");
  // A2: 300 honest (forgiveness at c=100), lie w=8
  e=honest(A,300,80,1,e);
  ab0=src_betray(A,as0);
  ac0=src_streak(A,as0);
  abase=traj_penalty(ac0,8);
  ap=abase*(1+ab0);
  e=wrong(A,80,8,e);
  at=e_str(ob,at,"A2 c="); at=e_i32(ob,at,ac0);
  at=e_str(ob,at," b0="); at=e_i32(ob,at,ab0);
  at=e_str(ob,at," base="); at=e_i32(ob,at,abase);
  at=e_str(ob,at," p="); at=e_i32(ob,at,ap);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(A,as0)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(ac0,300),"A-A2-c-300");
  at=chk(ob,at,F,eq(ab0,0),"A-A2-b0-0");
  at=chk(ob,at,F,eq(abase,7),"A-A2-base-7");
  at=chk(ob,at,F,eq(ap,7),"A-A2-p-7");
  at=chk(ob,at,F,eq(src_rel(A,as0),980),"A-A2-rel-980");
  // A3: 300 honest, lie w=8
  e=honest(A,300,80,1,e);
  ab0=src_betray(A,as0);
  ac0=src_streak(A,as0);
  abase=traj_penalty(ac0,8);
  ap=abase*(1+ab0);
  e=wrong(A,80,8,e);
  at=e_str(ob,at,"A3 c="); at=e_i32(ob,at,ac0);
  at=e_str(ob,at," b0="); at=e_i32(ob,at,ab0);
  at=e_str(ob,at," p="); at=e_i32(ob,at,ap);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(A,as0)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(ab0,0),"A-A3-b0-0");
  at=chk(ob,at,F,eq(ap,7),"A-A3-p-7");
  at=chk(ob,at,F,eq(src_rel(A,as0),978),"A-A3-rel-978");
  // A20: fresh source, 20 honest, lie w=8
  let A20:[]u8=z_alloc(NCELL()*4); st_init(A20,0);
  let e20:i32=11001;
  e20=honest(A20,20,80,1,e20);
  let a20s:i32=src_idx(A20,80);
  let a20p:i32=traj_penalty(src_streak(A20,a20s),8)*(1+src_betray(A20,a20s));
  e20=wrong(A20,80,8,e20);
  at=e_str(ob,at,"A20 p="); at=e_i32(ob,at,a20p);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(A20,a20s)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(a20p,5),"A-A20-p-5");
  at=chk(ob,at,F,eq(src_rel(A20,a20s),769),"A-A20-rel-769");
  // A500: fresh source, 500 honest, lie w=8
  let A500:[]u8=z_alloc(NCELL()*4); st_init(A500,0);
  let e500:i32=12001;
  e500=honest(A500,500,80,1,e500);
  let a500s:i32=src_idx(A500,80);
  let a500p:i32=traj_penalty(src_streak(A500,a500s),8)*(1+src_betray(A500,a500s));
  e500=wrong(A500,80,8,e500);
  at=e_str(ob,at,"A500 p="); at=e_i32(ob,at,a500p);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(A500,a500s)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(a500p,7),"A-A500-p-7");
  at=chk(ob,at,F,eq(src_rel(A500,a500s),984),"A-A500-rel-984");
  at=chk(ob,at,F,gt(a500p,a20p),"A-streak-p500-gt-p20");

  // ============ World B1: colluding pair, joint lies ============
  at=e_str(ob,at,"WORLD B1 colluding pair joint lies"); at=e_nl(ob,at);
  let B:[]u8=z_alloc(NCELL()*4); st_init(B,0);
  let b1s:i32=src_idx(B,81);
  let b2s:i32=src_idx(B,82);
  let eb1:i32=20001;
  let eb2:i32=21001;
  let cy:i32=0;
  while(cy<3){
    eb1=honest(B,20,81,1,eb1);
    eb2=honest(B,20,82,1,eb2);
    if(cy==1){ at=chk(ob,at,F,eq(src_rel(B,b1s),869),"B1-rebuild-rel-869"); }
    if(cy==2){ at=chk(ob,at,F,eq(src_rel(B,b1s),779),"B1-rebuild-rel-779"); }
    let bb1:i32=src_betray(B,b1s);
    let p1:i32=traj_penalty(src_streak(B,b1s),8)*(1+bb1);
    eb1=wrong(B,81,8,eb1);
    let bb2:i32=src_betray(B,b2s);
    let p2:i32=traj_penalty(src_streak(B,b2s),8)*(1+bb2);
    eb2=wrong(B,82,8,eb2);
    at=e_str(ob,at,"B1 cycle="); at=e_i32(ob,at,cy);
    at=e_str(ob,at," p1="); at=e_i32(ob,at,p1);
    at=e_str(ob,at," p2="); at=e_i32(ob,at,p2);
    at=e_str(ob,at," rel1="); at=e_i32(ob,at,src_rel(B,b1s));
    at=e_str(ob,at," rel2="); at=e_i32(ob,at,src_rel(B,b2s));
    at=e_str(ob,at," b1="); at=e_i32(ob,at,src_betray(B,b1s));
    at=e_str(ob,at," b2="); at=e_i32(ob,at,src_betray(B,b2s)); at=e_nl(ob,at);
    let exp_p:i32=5*(cy+1);
    at=chk(ob,at,F,eq(p1,exp_p),"B1-p1-traj");
    at=chk(ob,at,F,eq(p2,exp_p),"B1-p2-traj");
    at=chk(ob,at,F,eq(src_betray(B,b1s),cy+1),"B1-b1-traj");
    at=chk(ob,at,F,eq(src_betray(B,b2s),cy+1),"B1-b2-traj");
    let exp_r:i32=769;
    if(cy==1){ exp_r=701; }
    if(cy==2){ exp_r=645; }
    at=chk(ob,at,F,eq(src_rel(B,b1s),exp_r),"B1-rel1-traj");
    at=chk(ob,at,F,eq(src_rel(B,b2s),exp_r),"B1-rel2-traj");
    cy=cy+1;
  }

  // ============ World B2: alternating reform-launder ============
  at=e_str(ob,at,"WORLD B2 alternating reform-launder"); at=e_nl(ob,at);
  let L:[]u8=z_alloc(NCELL()*4); st_init(L,0);
  let l1s:i32=src_idx(L,83);
  let l2s:i32=src_idx(L,84);
  let el1:i32=30001;
  let el2:i32=31001;
  el1=honest(L,100,83,1,el1);
  let l1b0:i32=src_betray(L,l1s);
  let l1p1:i32=traj_penalty(src_streak(L,l1s),8)*(1+l1b0);
  el1=wrong(L,83,8,el1);
  el2=honest(L,100,84,1,el2);
  let l2b0:i32=src_betray(L,l2s);
  let l2p1:i32=traj_penalty(src_streak(L,l2s),8)*(1+l2b0);
  el2=wrong(L,84,8,el2);
  el1=honest(L,100,83,1,el1);
  let l1b1:i32=src_betray(L,l1s);
  let l1p2:i32=traj_penalty(src_streak(L,l1s),8)*(1+l1b1);
  el1=wrong(L,83,8,el1);
  el2=honest(L,100,84,1,el2);
  let l2b1:i32=src_betray(L,l2s);
  let l2p2:i32=traj_penalty(src_streak(L,l2s),8)*(1+l2b1);
  el2=wrong(L,84,8,el2);
  at=e_str(ob,at,"B2 S1 lies p="); at=e_i32(ob,at,l1p1);
  at=e_str(ob,at," "); at=e_i32(ob,at,l1p2);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(L,l1s));
  at=e_str(ob,at," S2 lies p="); at=e_i32(ob,at,l2p1);
  at=e_str(ob,at," "); at=e_i32(ob,at,l2p2);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(L,l2s)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(l1b0,0),"B2-S1-b0-0");
  at=chk(ob,at,F,eq(l1p1,7),"B2-S1-p1-7");
  at=chk(ob,at,F,eq(l2b0,0),"B2-S2-b0-0");
  at=chk(ob,at,F,eq(l2p1,7),"B2-S2-p1-7");
  at=chk(ob,at,F,eq(l1b1,0),"B2-S1-b1-0");
  at=chk(ob,at,F,eq(l1p2,7),"B2-S1-p2-7");
  at=chk(ob,at,F,eq(l2b1,0),"B2-S2-b1-0");
  at=chk(ob,at,F,eq(l2p2,7),"B2-S2-p2-7");
  at=chk(ob,at,F,eq(src_rel(L,l1s),925),"B2-S1-rel-925");
  at=chk(ob,at,F,eq(src_rel(L,l2s),925),"B2-S2-rel-925");

  // ============ World C: reformed deceiver ============
  at=e_str(ob,at,"WORLD C reformed deceiver"); at=e_nl(ob,at);
  let C:[]u8=z_alloc(NCELL()*4); st_init(C,0);
  let ec:i32=40001;
  let crs:i32=src_idx(C,85);
  ec=honest(C,20,85,1,ec);
  ec=wrong(C,85,8,ec);
  ec=honest(C,20,85,1,ec);
  ec=wrong(C,85,8,ec);
  at=chk(ob,at,F,eq(src_betray(C,crs),2),"C-R-b-2-early");
  ec=honest(C,200,85,1,ec);
  at=e_str(ob,at,"C R after 200 honest b="); at=e_i32(ob,at,src_betray(C,crs));
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(C,crs));
  at=e_str(ob,at," c="); at=e_i32(ob,at,src_streak(C,crs)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_betray(C,crs),0),"C-R-b-0-reformed");
  at=chk(ob,at,F,eq(src_rel(C,crs),933),"C-R-rel-933");
  at=chk(ob,at,F,eq(src_streak(C,crs),200),"C-R-c-200");
  let crb:i32=src_betray(C,crs);
  let crp:i32=traj_penalty(src_streak(C,crs),8)*(1+crb);
  ec=wrong(C,85,8,ec);
  at=e_str(ob,at,"C R test lie p="); at=e_i32(ob,at,crp);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(C,crs)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(crp,7),"C-R-test-p-7");
  at=chk(ob,at,F,eq(src_rel(C,crs),905),"C-R-rel-905");
  // F: fresh 200-streak first-timer reference
  let ef:i32=41001;
  let cfs:i32=src_idx(C,86);
  ef=honest(C,200,86,1,ef);
  let cfp:i32=traj_penalty(src_streak(C,cfs),8)*(1+src_betray(C,cfs));
  ef=wrong(C,86,8,ef);
  at=e_str(ob,at,"C F fresh p="); at=e_i32(ob,at,cfp);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(C,cfs)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(cfp,7),"C-F-p-7");
  at=chk(ob,at,F,eq(crp,cfp),"C-reform-equality");
  at=chk(ob,at,F,eq(src_rel(C,cfs),961),"C-F-rel-961");
  // R2: partial reform (100 honest after b=2)
  let C2:[]u8=z_alloc(NCELL()*4); st_init(C2,0);
  let e2:i32=42001;
  let c2s:i32=src_idx(C2,87);
  e2=honest(C2,20,87,1,e2);
  e2=wrong(C2,87,8,e2);
  e2=honest(C2,20,87,1,e2);
  e2=wrong(C2,87,8,e2);
  e2=honest(C2,100,87,1,e2);
  at=e_str(ob,at,"C R2 after 100 honest b="); at=e_i32(ob,at,src_betray(C2,c2s)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_betray(C2,c2s),1),"C-R2-b-1-partial");
  let c2p:i32=traj_penalty(src_streak(C2,c2s),8)*(1+src_betray(C2,c2s));
  e2=wrong(C2,87,8,e2);
  at=e_str(ob,at,"C R2 test lie p="); at=e_i32(ob,at,c2p);
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(C2,c2s)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(c2p,14),"C-R2-test-p-14");
  at=chk(ob,at,F,eq(src_betray(C2,c2s),2),"C-R2-bafter-2");

  // ============ World D: noisy-but-honest (ext 88) ============
  at=e_str(ob,at,"WORLD D noisy-but-honest"); at=e_nl(ob,at);
  let D:[]u8=z_alloc(NCELL()*4); st_init(D,0);
  let ed:i32=50001;
  let dns:i32=src_idx(D,88);
  let ncy:i32=0;
  while(ncy<40){
    ed=honest(D,5,88,1,ed);
    ed=wrong(D,88,1,ed);
    ncy=ncy+1;
  }
  at=e_str(ob,at,"D after 40 noise cycles b="); at=e_i32(ob,at,src_betray(D,dns));
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(D,dns));
  at=e_str(ob,at," c="); at=e_i32(ob,at,src_streak(D,dns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_betray(D,dns),40),"D-noise-b-40");
  at=chk(ob,at,F,eq(src_rel(D,dns),833),"D-noise-rel-833");
  at=chk(ob,at,F,eq(src_streak(D,dns),0),"D-noise-c-0");
  ed=honest(D,20,88,1,ed);
  at=e_str(ob,at,"D after 20 honest rel="); at=e_i32(ob,at,src_rel(D,dns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(D,dns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(D,dns),846),"D-pretest-rel-846");
  at=chk(ob,at,F,eq(src_betray(D,dns),40),"D-pretest-b-40");
  let db0:i32=src_betray(D,dns);
  let dp:i32=traj_penalty(src_streak(D,dns),8)*(1+db0);
  ed=wrong(D,88,8,ed);
  at=e_str(ob,at,"D test event w=8 p="); at=e_i32(ob,at,dp);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(D,dns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(D,dns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(dp,205),"D-test-p-205");
  at=chk(ob,at,F,eq(src_rel(D,dns),472),"D-test-rel-472");
  at=chk(ob,at,F,eq(src_betray(D,dns),41),"D-test-b-41");
  ed=honest(D,200,88,1,ed);
  at=e_str(ob,at,"D after 200 honest tail b="); at=e_i32(ob,at,src_betray(D,dns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_betray(D,dns),39),"D-tail-b-39");

  at=e_str(ob,at,"sealed predictions asserted"); at=e_nl(ob,at);
  let fails:i32=get32(F,0);
  if(fails==0){ at=e_str(ob,at,"ALL PASS\n"); }
  else { at=e_str(ob,at,"FAILURES: "); at=e_i32(ob,at,fails); at=e_nl(ob,at); }

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){ return 0; }
  return 1;
}

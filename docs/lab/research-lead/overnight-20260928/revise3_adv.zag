// revise3.zag — H-REVISE3: repaired versioned conditional dispatch.
//
// Repairs the three H-REVISE2 red-team failure classes (REVISE2_ADV_RESULT.md):
//   F-RV1: version store is now an appendable condition list (up to 4
//          revision slots). vs_revise APPENDS; never overwrites. Dispatch
//          checks slots most-recent-first (stated rule).
//   F-RV2: diagnosis scores ALL discriminating positions:
//            +1 output-relevance (candidate byte in expected output),
//            +1 program-consistency (candidate position read by P1,
//               from the extraction index sequence).
//          Tie-break: lowest position. P1 is discovered BEFORE final
//          diagnosis so the consistency signal is available. This is a
//          stated heuristic, not guaranteed causal identification.
//   F-RV3: bounds-respecting length guard. A passing input shorter than
//          position p is vacuous at p (skipped), not vetoing.
//
// Prereg: PREREG_REVISE3.md (54790d0d2), frozen before this file.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (verbatim from revise2.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE v3 (appendable condition list) ============
// VS3 layout:
//   0: vcount (i32)
//   4: nnodes0 (i32), 8: prog0[48]  (bytes 8..56)
//   56: slot1: cond_pos(4), cond_val(4), nnodes(4), prog[48] -> 56..116
//   116: slot2 -> 116..176 ; 176: slot3 -> 176..236 ; 236: slot4 -> 236..296
// Max 4 revisions. Dispatch: most-recent-first (newest revision wins).
fn vs3_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 4, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[8+i]=p0[i]; i=i+1; }
  return;
}
// Returns 1 on append, 0 if the store is full.
fn vs3_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)i32 {
  let vc:i32=get32(VS, 0);
  if(vc>=4){ return 0; }
  let so:i32=56+vc*60;
  set32(VS, so, cpos);
  set32(VS, so+4, cval);
  set32(VS, so+8, nn1);
  let i:i32=0;
  while(i<nn1*3){ VS[so+12+i]=p1[i]; i=i+1; }
  set32(VS, 0, vc+1);
  return 1;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs3_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs3_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*60;
    let cp:i32=get32(VS, so);
    let cv:i32=get32(VS, so+4);
    if(inp.len>cp && (inp[cp] as i32)==cv){
      return vs3_apply_one(VS, so+12, so+8, inp, out);
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
fn vs3_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,4);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[8+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  let vc:i32=get32(VS,0);
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*60;
    emit("VSTORE slot"); emit(i32s(s));
    emit(" cond pos="); emit(i32s(get32(VS,so)));
    emit(" val="); emit(i32s(get32(VS,so+4)));
    let nn:i32=get32(VS,so+8);
    emit(" nnodes="); emit(i32s(nn)); emit(" prog=");
    let pp:[]u8=z_alloc(48);
    i=0;
    while(i<nn*3){ pp[i]=VS[so+12+i]; i=i+1; }
    prog_emit(pp, nn); emit("\n");
    s=s+1;
  }
  return;
}

// ============ SCORED DIAGNOSIS (R2: all positions, R3: bounds-respecting) ============
// For each position p in fail: bounds-respecting discrimination test
// (passing inputs shorter than p are vacuous, skipped). Score each
// discriminating (p,v):
//   +1 output-relevance: v appears in fail_out (expected output)
//   +1 program-consistency: p appears in seq (extraction index sequence,
//      the positions the discovered program reads)
// Returns best_p*1000+best_v, tie-break lowest p, or -1 if none.
// No byte-value literals; all compared values come from the data.
fn diagnose_scored(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8, fail_out:[]u8, seq:[]u8, sl:i32)i32 {
  let best:i32=-1;
  let best_score:i32=-1;
  let p:i32=0;
  while(p<fail.len){
    let v:i32=fail[p] as i32;
    let discrim:i32=1;
    let i:i32=0;
    while(i<npass){
      let plen:i32=get32(pdesc, i*8+4);
      if(plen>p){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
      }
      i=i+1;
    }
    if(discrim==1){
      let score:i32=0;
      let k:i32=0;
      while(k<fail_out.len){
        if((fail_out[k] as i32)==v){ score=score+1; break; }
        k=k+1;
      }
      k=0;
      while(k<sl){
        if(get32(seq, k*4)==p){ score=score+1; break; }
        k=k+1;
      }
      emit("DIAGNOSE candidate pos="); emit(i32s(p));
      emit(" val="); emit(i32s(v));
      emit(" score="); emit(i32s(score)); emit("\n");
      if(score>best_score){
        best_score=score;
        best=p*1000+v;
      }
    }
    p=p+1;
  }
  return best;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ MAIN: phases A-I ============
// ============ MAIN: H-REVISE3 red-team attacks ============
// X-RV3-1: scoring gaming (incidental outscores causal)
// X-RV3-2: overlapping conditions (most-recent-first documentation)
// X-RV3-3: slot exhaustion (5th revision dropped)
// X-RV3-4: source audit by inspection (see PREREG_REVISE3_ADV.md)
fn main()i32 {
  emit("=== H-REVISE3 RED TEAM ===\n");
  let ZNC_OK:i32=1;

  // Shared: learn P0 = [N C1 SUB] (broadcast-last) from standard passing set.
  let in0:[]u8="abc"; let out0:[]u8="ccc";
  let in1:[]u8="def"; let out1:[]u8="fff";
  let in2:[]u8="ghi"; let out2:[]u8="iii";
  let in3:[]u8="jkl"; let out3:[]u8="lll";

  let S:[]u8=z_alloc(8192);
  let S_off:i32=0;
  let descA:[]u8=z_alloc(3*12);
  let s0:i32=pextract(in0, out0, S[S_off..S_off+64]);
  set32(descA, 0, S_off); set32(descA, 4, s0); set32(descA, 8, in0.len);
  S_off=S_off+64;
  let s1:i32=pextract(in1, out1, S[S_off..S_off+64]);
  set32(descA, 12, S_off); set32(descA, 16, s1); set32(descA, 20, in1.len);
  S_off=S_off+64;
  let s2:i32=pextract(in2, out2, S[S_off..S_off+64]);
  set32(descA, 24, S_off); set32(descA, 28, s2); set32(descA, 32, in2.len);
  S_off=S_off+64;
  let p0:[]u8=z_alloc(48);
  let nn0:i32=discover(S, descA, 3, p0);
  if(nn0<0){ emit("FATAL P0\n"); return 1; }
  emit("P0 learned: "); prog_emit(p0, nn0); emit("\n");

  let D:[]u8=z_alloc(256);
  let pdesc:[]u8=z_alloc(4*8);
  let D_off:i32=0;
  set32(pdesc, 0, D_off); set32(pdesc, 4, dcopy(D, D_off, in0)); D_off=D_off+in0.len;
  set32(pdesc, 8, D_off); set32(pdesc, 12, dcopy(D, D_off, in1)); D_off=D_off+in1.len;
  set32(pdesc, 16, D_off); set32(pdesc, 20, dcopy(D, D_off, in2)); D_off=D_off+in2.len;
  set32(pdesc, 24, D_off); set32(pdesc, 28, dcopy(D, D_off, in3)); D_off=D_off+in3.len;

  // ============ X-RV3-1: scoring gaming ============
  emit("\n--- X-RV3-1: scoring gaming ---\n");
  emit("Hidden true rule: IF input[2]=='y' THEN identity ELSE broadcast-last\n");
  let VS1:[]u8=z_alloc(512);
  vs3_init(VS1, p0, nn0);
  // Counterexample: "xqy"->"xqy". P0 predicts "yyy". True rule: input[2]=='y' so identity.
  let inG:[]u8="xqy"; let outG:[]u8="xqy";
  let pred:[]u8=z_alloc(16);
  if(apply_prog(p0, nn0, inG, pred)==1 && streq(pred[0..3], outG)==1){
    emit("X-RV3-1 SETUP FAIL: P0 matches (not a counterexample)\n");
    ZNC_OK=0;
  } else {
    emit("DETECT xqy->xqy predicted "); emit(pred[0..3]); emit("\n");
  }
  let descG:[]u8=z_alloc(12);
  let sg:i32=pextract(inG, outG, S[S_off..S_off+64]);
  if(sg<0){ emit("X-RV3-1 SETUP FAIL: extract\n"); return 1; }
  set32(descG, 0, S_off); set32(descG, 4, sg); set32(descG, 8, inG.len);
  let seqG:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  emit("Extraction seq for xqy->xqy: [");
  let qi:i32=0;
  while(qi<sg){ if(qi>0){emit(",");} emit(i32s(get32(seqG, qi*4))); qi=qi+1; }
  emit("] (identity [K] reads all positions)\n");
  let drG:i32=diagnose_scored(D, pdesc, 4, inG, outG, seqG, sg);
  if(drG<0){ emit("X-RV3-1 SETUP FAIL: no diagnosis\n"); return 1; }
  let gpos:i32=drG/1000;
  let gval:i32=drG-gpos*1000;
  emit("DIAGNOSE result: pos="); emit(i32s(gpos)); emit(" val="); emit(i32s(gval)); emit("\n");
  if(gpos==0 && gval==120){
    emit("X-RV3-1 DIAGNOSIS: (0,120) 'x' selected (INCIDENTAL, truth is (2,121) 'y')\n");
  } else {
    if(gpos==2 && gval==121){
      emit("X-RV3-1 DIAGNOSIS: (2,121) 'y' selected (CORRECT, attack failed)\n");
    } else {
      emit("X-RV3-1 DIAGNOSIS: unexpected ("); emit(i32s(gpos)); emit(","); emit(i32s(gval)); emit(")\n");
    }
  }
  // Discover P1 and revise (following the mechanism's own logic).
  let pG:[]u8=z_alloc(48);
  let nng:i32=discover(S, descG, 1, pG);
  if(nng<0){ emit("X-RV3-1 SETUP FAIL: discover P1\n"); return 1; }
  emit("P1 discovered: "); prog_emit(pG, nng); emit("\n");
  if(vs3_revise(VS1, gpos, gval, pG, nng)==0){ emit("X-RV3-1 SETUP FAIL: revise\n"); return 1; }
  // Held-out probes.
  let t5:[]u8=z_alloc(16);
  let h1:[]u8="aqy"; let ho1:[]u8="aqy";
  let h2:[]u8="xbc"; let ho2:[]u8="ccc";
  let x1_ok:i32=0;
  let x2_ok:i32=0;
  if(vs3_apply(VS1, h1, t5)==1 && streq(t5[0..3], ho1)==1){
    emit("HELDOUT aqy->aqy PASS\n"); x1_ok=1;
  } else {
    emit("HELDOUT aqy->aqy FAIL (predicted "); emit(t5[0..3]); emit(", expected aqy)\n");
  }
  if(vs3_apply(VS1, h2, t5)==1 && streq(t5[0..3], ho2)==1){
    emit("HELDOUT xbc->ccc PASS\n"); x2_ok=1;
  } else {
    emit("HELDOUT xbc->ccc FAIL (predicted "); emit(t5[0..3]); emit(", expected ccc)\n");
  }
  if(gpos==0 && gval==120 && x1_ok==0 && x2_ok==0){
    emit("X-RV3-1 VERDICT: SUCCEEDS (incidental selected, both held-out fail)\n");
  } else {
    if(gpos==2 && gval==121){
      emit("X-RV3-1 VERDICT: FAILS (correct diagnosis, attack did not game)\n");
    } else {
      emit("X-RV3-1 VERDICT: INCONCLUSIVE (unexpected diagnosis)\n");
    }
  }

  // ============ X-RV3-2: overlapping conditions ============
  emit("\n--- X-RV3-2: overlapping conditions ---\n");
  emit("Stated rule: most-recent-first. Documenting overlap behavior.\n");
  let VS2:[]u8=z_alloc(512);
  vs3_init(VS2, p0, nn0);
  // R1: ("xab"->"xxx"), cond (0,120), P1=[N N SUB] broadcast-first.
  let inR1:[]u8="xab"; let outR1:[]u8="xxx";
  let descR1:[]u8=z_alloc(12);
  let sr1:i32=pextract(inR1, outR1, S[S_off..S_off+64]);
  set32(descR1, 0, S_off); set32(descR1, 4, sr1); set32(descR1, 8, inR1.len);
  let seqR1:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let dr1:i32=diagnose_scored(D, pdesc, 4, inR1, outR1, seqR1, sr1);
  let r1p:i32=dr1/1000; let r1v:i32=dr1-r1p*1000;
  let pR1:[]u8=z_alloc(48);
  let nnr1:i32=discover(S, descR1, 1, pR1);
  vs3_revise(VS2, r1p, r1v, pR1, nnr1);
  emit("R1: IF input["); emit(i32s(r1p)); emit("]=="); emit(i32s(r1v)); emit(" THEN P1\n");
  // R2: ("xqc"->"qqq"), cond (1,113), P2=[N C2 SUB] broadcast-index-1.
  // Note: "xqc" also satisfies R1's condition (input[0]=='x').
  let inR2:[]u8="xqc"; let outR2:[]u8="qqq";
  let descR2:[]u8=z_alloc(12);
  let sr2:i32=pextract(inR2, outR2, S[S_off..S_off+64]);
  set32(descR2, 0, S_off); set32(descR2, 4, sr2); set32(descR2, 8, inR2.len);
  let seqR2:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let dr2:i32=diagnose_scored(D, pdesc, 4, inR2, outR2, seqR2, sr2);
  let r2p:i32=dr2/1000; let r2v:i32=dr2-r2p*1000;
  let pR2:[]u8=z_alloc(48);
  let nnr2:i32=discover(S, descR2, 1, pR2);
  vs3_revise(VS2, r2p, r2v, pR2, nnr2);
  emit("R2: IF input["); emit(i32s(r2p)); emit("]=="); emit(i32s(r2v)); emit(" THEN P2\n");
  // Overlap query: "xqc" satisfies both (input[0]=='x' and input[1]=='q').
  let ov:[]u8="xqc";
  if(vs3_apply(VS2, ov, t5)==1){
    emit("OVERLAP xqc -> "); emit(t5[0..3]); emit("\n");
    if(streq(t5[0..3], outR2)==1){
      emit("X-RV3-2: slot 2 (most-recent) wins on overlap, as stated. DOCUMENTED.\n");
    } else {
      emit("X-RV3-2: UNEXPECTED dispatch on overlap\n");
    }
  }
  // Non-overlap: "xab" satisfies only R1.
  let no:[]u8="xab";
  if(vs3_apply(VS2, no, t5)==1){
    emit("NON-OVERLAP xab -> "); emit(t5[0..3]); emit("\n");
    if(streq(t5[0..3], outR1)==1){
      emit("X-RV3-2: slot 1 correctly handles non-overlapping input. DOCUMENTED.\n");
    }
  }
  emit("X-RV3-2 VERDICT: BOUNDARY (stated rule confirmed, no kill criterion)\n");

  // ============ X-RV3-3: slot exhaustion ============
  emit("\n--- X-RV3-3: slot exhaustion ---\n");
  let VS3:[]u8=z_alloc(512);
  vs3_init(VS3, p0, nn0);
  // Five genuine revisions, distinct pos-0 bytes, all broadcast-first.
  let e_in:[]u8=z_alloc(5*4);
  let e_out:[]u8=z_alloc(5*4);
  // in: xab, yzb, qab, wab, vab ; out: xxx, yyy, qqq, www, vvv
  e_in[0]=120; e_in[1]=97; e_in[2]=98; e_in[3]=0;
  e_in[4]=121; e_in[5]=122; e_in[6]=98; e_in[7]=0;
  e_in[8]=113; e_in[9]=97; e_in[10]=98; e_in[11]=0;
  e_in[12]=119; e_in[13]=97; e_in[14]=98; e_in[15]=0;
  e_in[16]=118; e_in[17]=97; e_in[18]=98; e_in[19]=0;
  e_out[0]=120; e_out[1]=120; e_out[2]=120; e_out[3]=0;
  e_out[4]=121; e_out[5]=121; e_out[6]=121; e_out[7]=0;
  e_out[8]=113; e_out[9]=113; e_out[10]=113; e_out[11]=0;
  e_out[12]=119; e_out[13]=119; e_out[14]=119; e_out[15]=0;
  e_out[16]=118; e_out[17]=118; e_out[18]=118; e_out[19]=0;
  let ri:i32=0;
  let r_ok:i32=0;
  while(ri<5){
    let cin:[]u8=e_in[ri*4..ri*4+3];
    let cout:[]u8=e_out[ri*4..ri*4+3];
    let desc:[]u8=z_alloc(12);
    let se:i32=pextract(cin, cout, S[S_off..S_off+64]);
    if(se<0){ emit("X-RV3-3 extract fail at R"); emit(i32s(ri+1)); emit("\n"); break; }
    set32(desc, 0, S_off); set32(desc, 4, se); set32(desc, 8, 3);
    let seqe:[]u8=S[S_off..S_off+64];
    S_off=S_off+64;
    let dre:i32=diagnose_scored(D, pdesc, 4, cin, cout, seqe, se);
    if(dre<0){ emit("X-RV3-3 diagnose fail at R"); emit(i32s(ri+1)); emit("\n"); break; }
    let cpos:i32=dre/1000; let cval:i32=dre-cpos*1000;
    let pe:[]u8=z_alloc(48);
    let nne:i32=discover(S, desc, 1, pe);
    if(nne<0){ emit("X-RV3-3 discover fail at R"); emit(i32s(ri+1)); emit("\n"); break; }
    let rc:i32=vs3_revise(VS3, cpos, cval, pe, nne);
    emit("R"); emit(i32s(ri+1)); emit(": revise cond ("); emit(i32s(cpos)); emit(",");
    emit(i32s(cval)); emit(") -> rc="); emit(i32s(rc));
    emit(" vcount="); emit(i32s(get32(VS3,0))); emit("\n");
    if(rc==1){ r_ok=r_ok+1; }
    ri=ri+1;
  }
  emit("Revisions accepted: "); emit(i32s(r_ok)); emit("/5\n");
  // Query the 5th case: "vab" should give "vvv" but slot was dropped.
  let q5:[]u8="vab"; let a5:[]u8="vvv";
  if(vs3_apply(VS3, q5, t5)==1){
    emit("QUERY vab -> "); emit(t5[0..3]); emit(" (expected vvv)\n");
    if(streq(t5[0..3], a5)==1){
      emit("X-RV3-3 VERDICT: 5th revision retained (unexpected)\n");
    } else {
      emit("X-RV3-3 VERDICT: SUCCEEDS (5th revision dropped, capacity limit demonstrated)\n");
    }
  }
  // Sanity: first four still work.
  let q1:[]u8="xab"; let a1:[]u8="xxx";
  if(vs3_apply(VS3, q1, t5)==1 && streq(t5[0..3], a1)==1){
    emit("SANITY xab->xxx still PASS (earlier revisions intact)\n");
  } else {
    emit("SANITY xab->xxx FAIL (unexpected)\n");
  }

  emit("\n=== H-REVISE3 RED TEAM COMPLETE ===\n");
  emit("X-RV3-4 source audit: by inspection (see report). ");
  emit("Mechanism functions verified verbatim from revise3.zag.\n");
  if(ZNC_OK==1){ return 0; }
  return 1;
}

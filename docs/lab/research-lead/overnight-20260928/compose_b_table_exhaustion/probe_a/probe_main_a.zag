// probe_main_a.zag -- dump B's thunk table after CHAIN5 solve.
// Concat: sus_base sus_thunk sus_asm sus_rev adv_worlds probe_main_a.
// B sources are UNMODIFIED copies. Pure Zag.
fn findmap(S:[]u8,A:[]u8,n:i32,wantm:i32,wanti1:i32) i32 {
  let t:i32=0;
  while(t<n){
    let ok:i32=0;
    if(tg(S,t,0)==wantm){ ok=1; }
    if(ok==1){
      if(tg(S,t,1)!=wanti1){ ok=0; }
    }
    if(ok==1){ return t; }
    t=t+1;
  }
  return -1;
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(16384);
  w_adv_chain5(A);
  let r:i32=solve(S,A,0,6,501,1,2,6);
  c=o_app(B,c,"SOLVE_R="); c=o_i64(B,c,r as i64); c=o_nl(B,c);
  c=o_app(B,c,"NTHUNK="); c=o_i64(B,c,sg(S,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ASMSTEPS="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,12) as i64); c=o_nl(B,c);
  let n:i32=sg(S,0);
  let t:i32=0;
  let nconst:i32=0;
  let nwalk:i32=0;
  let ncount:i32=0;
  let ncountroot:i32=0;
  let nadd2:i32=0;
  let tidC:i32=-1;
  while(t<n){
    let m:i32=tg(S,t,0);
    if(m==-1){
      nconst=nconst+1;
      tidC=t;
    } else {
      let cl:i32=mg(A,m,0);
      if(cl==0){ nwalk=nwalk+1; }
      if(cl==1){
        ncount=ncount+1;
        if(tg(S,t,1)!=tidC){ ncountroot=ncountroot+1; }
      }
      if(cl==4){ nadd2=nadd2+1; }
    }
    t=t+1;
  }
  c=o_app(B,c,"TIDC="); c=o_i64(B,c,tidC as i64); c=o_nl(B,c);
  c=o_app(B,c,"NCONST="); c=o_i64(B,c,nconst as i64); c=o_nl(B,c);
  c=o_app(B,c,"NWALK_THUNKS="); c=o_i64(B,c,nwalk as i64); c=o_nl(B,c);
  c=o_app(B,c,"NCOUNT_THUNKS="); c=o_i64(B,c,ncount as i64); c=o_nl(B,c);
  c=o_app(B,c,"NCOUNT_NONTRIVIAL="); c=o_i64(B,c,ncountroot as i64); c=o_nl(B,c);
  c=o_app(B,c,"NADD2_THUNKS="); c=o_i64(B,c,nadd2 as i64); c=o_nl(B,c);
  // true W-chain: map4(map3(map2(map1(map0(C)))))
  let t0:i32=findmap(S,A,n,0,tidC);
  let t1:i32=-1;
  let t2:i32=-1;
  let t3:i32=-1;
  let t4:i32=-1;
  if(t0>=0){ t1=findmap(S,A,n,1,t0); }
  if(t1>=0){ t2=findmap(S,A,n,2,t1); }
  if(t2>=0){ t3=findmap(S,A,n,3,t2); }
  if(t3>=0){ t4=findmap(S,A,n,4,t3); }
  c=o_app(B,c,"TRUE_WCHAIN_TID="); c=o_i64(B,c,t4 as i64); c=o_nl(B,c);
  let cr:i32=-1;
  if(t4>=0){ cr=findmap(S,A,n,5,t4); }
  c=o_app(B,c,"TRUE_COUNTROOT_TID="); c=o_i64(B,c,cr as i64); c=o_nl(B,c);
  // first 8 and last 4 thunks: (map,in1) to show fill order
  c=o_app(B,c,"FIRST8="); c=o_nl(B,c);
  t=0;
  while(t<8){
    c=o_app(B,c,"t"); c=o_i64(B,c,t as i64); c=o_app(B,c," m=");
    c=o_i64(B,c,tg(S,t,0) as i64); c=o_app(B,c," i1=");
    c=o_i64(B,c,tg(S,t,1) as i64); c=o_nl(B,c);
    t=t+1;
  }
  c=o_app(B,c,"LAST4="); c=o_nl(B,c);
  t=n-4;
  while(t<n){
    c=o_app(B,c,"t"); c=o_i64(B,c,t as i64); c=o_app(B,c," m=");
    c=o_i64(B,c,tg(S,t,0) as i64); c=o_app(B,c," i1=");
    c=o_i64(B,c,tg(S,t,1) as i64); c=o_nl(B,c);
    t=t+1;
  }
  o_flush(B,c);
  return 0;
}

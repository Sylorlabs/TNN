// probe_main_b.zag -- 1024-entry thunk table variant (MODIFIED COPIES).
// Runs CHAIN5 and TRAP1; reports table/attempt stats.
// Concat: sus_base sus_thunk sus_asm sus_rev adv_worlds probe_main_b.
// Pure Zag.
fn brep(B:[]u8,c:i32,name:[]u8,r:i32,ans:i32,S:[]u8) i32 {
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"SOLVE_R="); c=o_i64(B,c,r as i64); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"NTHUNK="); c=o_i64(B,c,sg(S,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ASMSTEPS="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ATTEMPTS="); c=o_i64(B,c,sg(S,41192) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,12) as i64); c=o_nl(B,c);
  c=o_app(B,c,"EXECTOT="); c=o_i64(B,c,sg(S,28) as i64); c=o_nl(B,c);
  return c;
}
fn bval(S:[]u8,A:[]u8,r:i32) i32 {
  if(r<0){ return -999; }
  return demand(S,A,r);
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(65536);
  let r:i32=0;
  let ans:i32=0;
  A=z_alloc(8192); S=z_alloc(65536);
  w_adv_chain5(A);
  r=solve(S,A,0,6,501,1,2,6); ans=bval(S,A,r);
  c=brep(B,c,"CHAIN5",r,ans,S);
  A=z_alloc(8192); S=z_alloc(65536);
  w_adv_trap1(A);
  r=solve(S,A,0,16,201,1,2,5); ans=bval(S,A,r);
  c=brep(B,c,"TRAP1",r,ans,S);
  o_flush(B,c);
  return 0;
}

}
// X-PARTIAL: 5-leg fan-in; legs 4,5 factless (partial applicability).
fn w_adv_partial(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    map_new(A,5+i,1,71+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,10+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,401,61,501); fact_add(A,501,71,701); fact_add(A,501,71,702);
  fact_add(A,401,62,502); fact_add(A,502,72,703); fact_add(A,502,72,704);
  fact_add(A,502,72,705);
  fact_add(A,401,63,503); fact_add(A,503,73,706); fact_add(A,503,73,707);
  fact_add(A,503,73,708); fact_add(A,503,73,709); fact_add(A,503,73,710);
  return;
}
// probe_main_b5.zag -- CHAIN5 only, 1024-table variant (layout validation).
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(65536);
  w_adv_chain5(A);
  let r:i32=solve(S,A,0,6,501,1,2,6);
  let ans:i32=-999;
  if(r>=0){ ans=demand(S,A,r); }
  c=o_app(B,c,"SOLVE_R="); c=o_i64(B,c,r as i64); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"NTHUNK="); c=o_i64(B,c,sg(S,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ASMSTEPS="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ATTEMPTS="); c=o_i64(B,c,sg(S,41192) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,12) as i64); c=o_nl(B,c);
  c=o_app(B,c,"VIOL="); c=o_i64(B,c,sg(S,16) as i64); c=o_nl(B,c);
  c=o_app(B,c,"EXECTOT="); c=o_i64(B,c,sg(S,28) as i64); c=o_nl(B,c);
  o_flush(B,c);

// P5-meta5a -- STRUCTURAL substrate. Can a learner acquire a MAPPING?
// Prereg: p5meta5a/PREREG.md. Scorer: score55a.py (independent).
//
// Blocker found by p5meta4: the associative substrate has NO representation of a
// rule independent of stored facts, so learning-to-learn was unaskable. This
// phase fixes the substrate, not the question.
//
// SUBSTRATE: a candidate is a PROGRAM -- a short sequence of generic ops over
// two input slots. The learner's persistent state is a population of programs
// with fitness. The question is no longer "does it recall" but "does acquiring
// one mapping change the COST of acquiring a STRUCTURALLY DIFFERENT one".
//
// Deliberately structural: a program generalises to unseen inputs because it
// computes, not because it was stored. There is no fact table at all -- the
// learner CANNOT replay, by construction.
//
// NO modes, routers, family indices, domain names, or strategy menus.
// Programs are selected by fitness; nothing is chosen by name.
//
// Output: raw acquisition costs + FP fingerprints. No *_ok flags.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn OPS()i32 { return 4; }        // generic ops
fn PLEN()i32 { return 3; }       // program length: 3 ops
fn POP()i32 { return 24; }       // program population
fn NP()i32 { return 24; }        // total programs = OPS^3 = 64, we keep POP
fn NQ()i32 { return 10; }        // probe queries per family
fn TRIALS()i32 { return 300; }   // trials to acquire a family
fn NTEST()i32 { return 3; }      // structurally different families tested
fn NARM()i32 { return 6; }
fn MAXAGE()i32 { return 8; }     // generation cap on program age

// generic op semantics over two input slots
fn q0(i:i32)i32 { return (i*7)%31; }
fn q1(i:i32)i32 { return (i*13)%29; }

// execute program p on query qi -> a value
// four GENERIC ops, no domain meaning:
//  0: a+b   1: a-b   2: a*b   3: a XOR b
fn exec(p:[]u8,pi:i32,qi:i32)i32 {
  let a:i32=q0(qi); let b:i32=q1(qi);
  let i:i32=0;
  while(i<PLEN()){
    let op:i32=get32(p,i*4);
    let r:i32=0;
    if(op==0){ r=a+b; }
    else if(op==1){ r=a-b; }
    else if(op==2){ r=a*b; }
    else { r=a; r=r^b; }
    a=r;
    i=i+1;
  }
  if(a<0){ a=0-a; }
  return a%61;
}

// true answer for a family: a FIXED affine map the learner must discover
// A family is a target VALUE SEQUENCE over the probes. Three families whose
// required programs are STRUCTURALLY DIFFERENT from each other.
fn want(fam:i32,qi:i32)i32 {
  let a:i32=q0(qi); let b:i32=q1(qi);
  let v:i32=0;
  if(fam==0){ v=(a+b)%61; }
  else if(fam==1){ v=(a-b); if(v<0){ v=0-v; } v=v%61; }
  else { v=(a*b)%61; }
  return v;
}

// arms: 0 FRESH 1 RELEVANT 2 IRRELEVANT 3 MISLEADING 4 POP_ABLATED 5 ORACLE_SEED
// priorKind: 0 none | 1 same family | 2 different family | 3 wrong-programs
fn priorKind(a:i32)i32 {
  if(a==0){ return 0; }
  if(a==1){ return 1; }
  if(a==2){ return 2; }
  if(a==3){ return 3; }
  if(a==4){ return 1; }
  return 1;
}

// generic variation: mutate ONE op slot of ONE individual. No domain knowledge.
fn mutate(POPB:[]u8,t:i32)void {
  let h:i32=(t+1)*2654435761;
  h=h^(h>>13); h=h&0x7fffffff;
  let ind:i32=h%POP();
  h=h+(h>>7); h=h&0x7fffffff;
  let slot:i32=h%PLEN();
  h=h*31+ind; h=h^(h>>11); h=h&0x7fffffff;
  let cur:i32=get32(POPB,ind*12+slot*4);
  let nw:i32=(cur+1+(h%((OPS()-1) as i32)))%OPS();
  set32(POPB,ind*12+slot*4,nw);
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<20);
  let c:i32=0;
  let POPB:[]u8=z_alloc(POP()*4);
  let FIT:[]u8=z_alloc(POP()*4);
  let AGE:[]u8=z_alloc(POP()*4);
  let SNAP:[]u8=z_alloc(POP()*4);
  let OBS:[]u8=z_alloc(NQ()*4);
  let PR:[]u8=z_alloc(POP()*4);
  let POBS:[]u8=z_alloc(NQ()*4);

  c=o_app(ob,c,"P5META5G RAW v1 ops=4 plen=3 pop=24 fams=3 partial_obs=1 carrier=prior_dist"); c=o_nl(ob,c);

  let a:i32=0;
  while(a<NARM()){
    let fam:i32=0;
    while(fam<NTEST()){
      // ---- fresh population: random programs ----
      let i:i32=0;
      while(i<POP()){
        // mixing hash so the initial population is genuinely diverse
        let h:i32=(i+1)*2654435761;
        h=h^(h>>13); h=h&0x7fffffff;
        let o0:i32=h%OPS();
        h=h+(h>>7); h=h&0x7fffffff;
        let o1:i32=h%OPS();
        h=h*31+i; h=h^(h>>11); h=h&0x7fffffff;
        let o2:i32=h%OPS();
        set32(POPB,i*12,o0);
        set32(POPB,i*12+4,o1);
        set32(POPB,i*12+8,o2);
        set32(FIT,i*4,0);
        set32(AGE,i*4,0);
        i=i+1;
      }

      // ---- prior-carrier weight table: uniform (fresh) ----
      let pz:i32=0;
      while(pz<POP()){ set32(PR,pz*4,1); pz=pz+1; }

      // ---- observed answers for the MEASURED family: NONE yet ----
      let oi:i32=0;
      while(oi<NQ()){ set32(OBS,oi*4,-1); oi=oi+1; }

      // ---- PRIOR phase ----
      let pk:i32=priorKind(a);
      if(pk!=0){
        let pf:i32=fam;
        if(pk==2){ pf=(fam+1)%NTEST(); }
        let pi0:i32=0;
        while(pi0<NQ()){
          let av:i32=-1;
          if(pi0%2==0){                       // only half the family observed
            av=want(pf,pi0);
            if(pk==3){ av=(av+7)%61; }
          }
          set32(POBS,pi0*4,av);
          pi0=pi0+1;
        }
        let pe:i32=0;
        let best:i32=0;
        while(pe<TRIALS()/4){
          let qi:i32=pe%NQ();
          let tgt:i32=0;
          if(pk==3){ tgt=(want(pf,qi)+7)%61; }   // misleading: wrong answers
          else { tgt=want(pf,qi); }
          // evaluate the whole population, fit = number of exact matches
          let pi:i32=0;
          while(pi<POP()){
            let f:i32=0;
            let qq:i32=0;
            while(qq<NQ()){
              if(get32(POBS,qq*4)>=0){
                if(exec(POPB,pi,qq)==get32(POBS,qq*4)){ f=f+1; }
              }
              qq=qq+1;
            }
            set32(FIT,pi*4,f);
            pi=pi+1;
          }
          // select the fittest; that program gets age++ and inherits
          let bf:i32=-1;
          pi=0;
          while(pi<POP()){
            if(get32(FIT,pi*4)>bf){ bf=get32(FIT,pi*4); best=pi; }
            pi=pi+1;
          }
          set32(AGE,best*4,get32(AGE,best*4)+1);
          // CARRIER: credit the slot that best fits the OBSERVED prior answers
          let bs2:i32=-1; let bslot:i32=0;
          let ps:i32=0;
          while(ps<POP()){
            let sc:i32=0;
            let qq2:i32=0;
            while(qq2<NQ()){
              if(get32(POBS,qq2*4)>=0){
                if(exec(POPB,ps,qq2)==get32(POBS,qq2*4)){ sc=sc+1; }
              }
              qq2=qq2+1;
            }
            if(sc>bs2){ bs2=sc; bslot=ps; }
            ps=ps+1;
          }
          if(bs2>0){ set32(PR,bslot*4,get32(PR,bslot*4)+3); }
          pe=pe+1;
        }
        // INHERITANCE: the fittest program seeds the population
        // ELITIST RETENTION: the acquired program is installed only where it
        // strictly beats the incumbent. Every other slot keeps its own value, so
        // population diversity is preserved rather than overwritten.
        let pi2:i32=0;
        while(pi2<POP()){
          if(pi2!=best){
            // incumbent fit vs acquired fit on the OBSERVED prior answers
            let inc:i32=0; let acq:i32=0;
            let qq:i32=0;
            while(qq<NQ()){
              if(get32(POBS,qq*4)>=0){
                if(exec(POPB,pi2,qq)==get32(POBS,qq*4)){ inc=inc+1; }
                if(exec(POPB,best,qq)==get32(POBS,qq*4)){ acq=acq+1; }
              }
              qq=qq+1;
            }
            if(acq>inc){
              let o0:i32=get32(POPB,best*12);
              let o1:i32=get32(POPB,best*12+4);
              let o2:i32=get32(POPB,best*12+8);
              set32(POPB,pi2*12,o0);
              set32(POPB,pi2*12+4,o1);
              set32(POPB,pi2*12+8,o2);
            }
          }
          pi2=pi2+1;
        }
      }

      // ---- snapshot; POP_ABLATED resets the population to random ----
      let z:i32=0;
      while(z<POP()){ set32(SNAP,z*4,get32(POPB,z*12)); z=z+1; }
      if(a==4){
        z=0;
        while(z<POP()){
          let h2:i32=(z+1)*2654435761;
          h2=h2^(h2>>13); h2=h2&0x7fffffff;
          set32(POPB,z*12,h2%OPS());
          h2=h2+(h2>>7); h2=h2&0x7fffffff;
          set32(POPB,z*12+4,h2%OPS());
          h2=h2*31+z; h2=h2^(h2>>11); h2=h2&0x7fffffff;
          set32(POPB,z*12+8,h2%OPS());
          z=z+1;
        }
      }

      // ---- ACQUISITION: sample from the prior-carrier distribution ----
      // The population array POPB is NOT consulted for selection here. The only
      // thing carried across phases is PR, which nothing in this loop overwrites.
      let acq:i32=-1;
      let tr:i32=0;
      let HOR:i32=TRIALS();
      while(tr<HOR){
        let qi:i32=NQ()+(tr%NQ());
        let tgt:i32=want(fam,qi);
        // sample a slot from PR
        let tot:i32=0; let o:i32=0;
        while(o<POP()){ tot=tot+get32(PR,o*4); o=o+1; }
        if(tot<1){ tot=1; }
        let h:i32=(tr+1)*2654435761;
        h=h^(h>>13); h=h&0x7fffffff;
        let pk:i32=h%tot;
        let ac:i32=0; let pick:i32=0;
        o=0;
        while(o<POP()){
          ac=ac+get32(PR,o*4);
          if(pk<ac){ pick=o; break; }
          o=o+1;
        }
        // generic mutation of the sampled slot: the carrier biases WHICH slot is
        // tried, but exploration must still happen inside it.
        {
          let mh:i32=(tr+1)*2654435761;
          mh=mh^(mh>>13); mh=mh&0x7fffffff;
          let mslot:i32=mh%PLEN();
          mh=mh+(mh>>7); mh=mh&0x7fffffff;
          let cur:i32=get32(POPB,pick*12+mslot*4);
          set32(POPB,pick*12+mslot*4,(cur+1+(mh%((OPS()-1) as i32)))%OPS());
        }
        if(exec(POPB,pick,qi)==tgt){ acq=tr+1; break; }
        // reinforce PR on the OBSERVED answer for this trial
        let rev:i32=tr%NQ();
        set32(OBS,rev*4,want(fam,rev));
        let bs3:i32=-1; let bslot3:i32=0;
        let ps3:i32=0;
        while(ps3<POP()){
          let sc3:i32=0;
          let qq3:i32=0;
          while(qq3<NQ()){
            if(get32(OBS,qq3*4)>=0){
              if(exec(POPB,ps3,qq3)==get32(OBS,qq3*4)){ sc3=sc3+1; }
            }
            qq3=qq3+1;
          }
          if(sc3>bs3){ bs3=sc3; bslot3=ps3; }
          ps3=ps3+1;
        }
        if(bs3>0){ set32(PR,bslot3*4,get32(PR,bslot3*4)+1); }
        tr=tr+1;
      }
      if(acq<0){ acq=HOR; }

      let sh:i32=0;
      let mz2:i32=0;
      while(mz2<POP()){ sh=sh+get32(PR,mz2*4)*(mz2+3); mz2=mz2+1; }

      z=0;
      while(z<POP()){ sh=sh+get32(POPB,z*12)*(z+3); z=z+1; }
      let fh:i32=0;
      z=0;
      while(z<POP()){ fh=fh+get32(FIT,z*4)*(z+5); z=z+1; }

      c=o_app(ob,c,"FP exp=p5meta5g regime="); c=o_i64(ob,c,fam as i64);
      c=o_app(ob,c," seed=0");
      c=o_app(ob,c," arm="); c=o_i64(ob,c,a as i64);
      c=o_app(ob,c," state="); c=o_i64(ob,c,(sh%9973) as i64);
      c=o_app(ob,c," cfg="); c=o_i64(ob,c,(fh%9973) as i64);
      c=o_app(ob,c," space=1 perm=0");
      c=o_app(ob,c," acq="); c=o_i64(ob,c,acq as i64);
      c=o_app(ob,c," pk="); c=o_i64(ob,c,pk as i64);
      c=o_nl(ob,c);
      fam=fam+1;
    }
    a=a+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}
// p2_learn.zag -- COMPOSE-DAG cognition source.
//
// Derived from the frozen COGOPS prefix (cogops_learnosc2/c8_learn.zag,
// sha256 750cb01d086f0f4eeb29d0a8481e36941a7551396e5c514429a0dffc7aa4b4e8)
// by the GEN-REDIM discipline (C429/C434): every per-need region is
// placed by exact size chaining from a declared capacity, and every
// stride and base is an accessor of that capacity. No per-need count
// appears as a literal anywhere in this file, and no topology vocabulary
// appears anywhere in this file.
//
// STRUCTURAL INVARIANTS added, each stated without reference to any
// goal shape:
//
//   I1 CAPACITY. Every buffer and every table is sized from NM/NPLAN/
//      NBIND. A need count is a parameter of the arena, never a
//      constant baked into a stride.
//
//   I2 PRODUCED VALUE. A link carries only values its source actually
//      produced. A source that produced nothing carries nothing.
//
//   I3 OPERAND SET. The operand set of a need is the union, in
//      goal-record link order, over ALL incoming set-consuming links of
//      the values those producers actually produced, deduplicated with
//      first-occurrence order. Not "the first source". Not "all sources
//      concatenated without dedup".
//
//   I4 LINK ADMISSION. A set-consuming link is admissible iff the
//      producer's accepted shape is set-valued and the receiver's
//      accepted shape has a set operand. An inadmissible link refuses
//      the goal. The engine never reads an unrelated operand slot and
//      never feeds a scalar into a set operand.
//
//   I5 CANONICAL EMISSION. Answer records are emitted in need-index
//      order, and ordering breaks ties toward the lowest need index, so
//      the answer does not depend on the stored plan order.
//
//   I6 ORDERING. Ordering is Kahn over the link graph with a stall
//      guard; the remaining needs are appended in index order.
//
// The three researcher-supplied generic procedures are unchanged. The
// retrieval / verification / counting coverage indices keep the frozen
// byte layout (offsets 0..12743) so that the learned evidence is
// bit-identical to the frozen lane's. Only the binding and plan tables
// move to capacity-derived bases.

fn NM()i32 { return 24; }
fn NPLAN()i32 { return 24; }
fn NBIND()i32 { return 32; }
fn PCAP()i32 { return 64; }
fn STK()i32 { return 128; }
fn CHN()i32 { return 512; }
fn SNN()i32 { return 320; }

fn l_bind()i32 { return 13280; }
fn l_plan()i32 { return l_bind()+NBIND()*32; }
fn p_stride()i32 { return 12+NM()*12; }
fn l_size()i32 { return l_plan()+NPLAN()*p_stride(); }

// ================= learned coverage indices (frozen layout) ==========
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  let bi:i32=ret_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,0);
  if(n<16){
    set32(L,0,n+1);
    set32(L,4+n*4,r);
    set32(L,68+n*4,0);
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  let bi:i32=vfy_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,4248);
  if(n<16){
    set32(L,4248,n+1);
    set32(L,4252+n*4,r);
    set32(L,4316+n*4,0);
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  let bi:i32=cnt_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,8496);
  if(n<16){
    set32(L,8496,n+1);
    set32(L,8500+n*4,r);
    set32(L,8564+n*4,0);
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }

fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}

// ================= goal-record accessors (frozen layout) ============
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 { return get32(G,g_linkbase(G)+4+l*28+w*4); }

// ================= descriptor of a need's operand surface ============
// cell 0 accepted, cell 1 set operand slot (-1 none), cell 2 set-valued
// output, cell 3 scalar field count, cell 4 procedure selector
fn d_acc(d:[]u8)i32 { return get32(d,0); }
fn d_slot(d:[]u8)i32 { return get32(d,4); }
fn d_out(d:[]u8)i32 { return get32(d,8); }
fn d_nsca(d:[]u8)i32 { return get32(d,12); }
fn d_fam(d:[]u8)i32 { return get32(d,16); }
fn d_acc_n(d:[]u8,n:i32)i32 { return get32(d,32+n*4); }
fn d_slot_n(d:[]u8,n:i32)i32 { return get32(d,32+NM()*4+n*4); }
fn d_out_n(d:[]u8,n:i32)i32 { return get32(d,32+2*NM()*4+n*4); }
fn shape_desc(G:[]u8,n:i32,d:[]u8)void {
  set32(d,0,0); set32(d,4,-1); set32(d,8,0); set32(d,12,0); set32(d,16,-1);
  let nf:i32=need_nf(G,n);
  if(nf==2){
    set32(d,0,1); set32(d,8,1); set32(d,12,2); set32(d,16,0);
    return;
  }
  if(nf==3){
    if(need_f(G,n,1)==1){
      set32(d,0,1); set32(d,4,2); set32(d,8,0); set32(d,12,2); set32(d,16,2);
    }
    return;
  }
  if(nf>=4){
    let ns:i32=need_f(G,n,0);
    if(ns>=1){
      if(ns<=16){
        if(nf==1+ns*3){
          set32(d,0,1); set32(d,4,1); set32(d,8,1); set32(d,12,nf); set32(d,16,1);
        }
      }
    }
  }
  return;
}
// I4: a link is admissible iff both endpoints' accepted shapes have a
// compatible operand. A set-consuming link requires a set-valued source
// and a receiver with a set operand; a carried link requires both ends
// to be accepted. Anything else refuses the whole goal.
fn links_admit(G:[]u8,d:[]u8)void {
  set32(d,0,1);
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    shape_desc(G,n,d);
    set32(d,32+n*4,d_acc(d));
    set32(d,32+NM()*4+n*4,d_slot(d));
    set32(d,32+2*NM()*4+n*4,d_out(d));
    n=n+1;
  }
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    let dn:i32=link_w(G,l,1);
    let sn:i32=link_w(G,l,4);
    if(k<1){ set32(d,0,0); }
    if(dn<0){ set32(d,0,0); }
    if(sn<0){ set32(d,0,0); }
    if(dn>=0){
      if(d_acc_n(d,dn)==0){ set32(d,0,0); }
    }
    if(sn>=0){
      if(d_acc_n(d,sn)==0){ set32(d,0,0); }
    }
    if(k>=2){
      if(dn>=0){ if(d_slot_n(d,dn)<0){ set32(d,0,0); } }
      if(sn>=0){ if(d_out_n(d,sn)==0){ set32(d,0,0); } }
    }
    l=l+1;
  }
  return;
}

// ================= working state =====================================
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// I5/I6: Kahn, ties to the lowest ready index, stall-guarded.
fn topo(G:[]u8,ord:[]u8,ind:[]u8,placed:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let fnd:i32=-1;
    let n2:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ if(fnd<0){ fnd=n2; } }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let k:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return k;
}
// I2: a carried value exists only if the source produced one.
fn apply_scalar(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){
        let ds:i32=link_w(G,l,3);
        let sn:i32=link_w(G,l,4);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let fire:i32=1;
        if(sk==1){ if(get32(OUTS,sn*160)==0){ fire=0; } }
        if(fire==1){
          let v:i32=0;
          if(sk==0){ v=get32(W,sn*80+4+ss*4); }
          if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
          set32(W,ni*80+4+ds*4,v);
        }
      }
    }
    l=l+1;
  }
  return;
}
// I3: operand set = union over ALL incoming set links, link order, dedup.
fn apply_set(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    if(k>=2){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let m:i32=get32(OUTS,sn*160);
        let j:i32=0;
        while(j<m){
          let v:i32=get32(OUTS,sn*160+4+j*4);
          let dup:i32=0;
          let f:i32=0;
          while(f<tot){
            if(get32(SUBL,ni*STK()+4+f*4)==v){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(tot<STK()/4-1){ set32(SUBL,ni*STK()+4+tot*4,v); tot=tot+1; }
          }
          j=j+1;
        }
      }
    }
    l=l+1;
  }
  set32(SUBL,ni*STK(),tot);
  return tot;
}
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8)void {
  let n:i32=get32(OUTS,ni*160);
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8)i32 {
  let n:i32=get32(OUTS,ni*160);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*160+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}

// ================= binding table (capacity-derived) =================
fn bind_off(bi:i32)i32 { return l_bind()+bi*32; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<NBIND()){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<NBIND()){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<NBIND()){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// binding is by accepted shape only: the learner's evidence about
// relations selects procedure VERSIONS, not which procedure a need is.
fn learn_bindings(L:[]u8,G:[]u8,d:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    shape_desc(G,n,d);
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bi>=0){
      if(bind_fam(L,bi)<0){
        set32(L,13232,get32(L,13232)+1);
        if(d_acc(d)==1){ set32(L,bind_off(bi)+4,d_fam(d)); }
      }
    }
    n=n+1;
  }
  return;
}
// I7 PLAN IDENTITY. A stored plan is keyed by the goal tag AND by a
// signature of the structure it was built from: the need count, every
// need tag and field count, and every link kind and endpoint. Reuse
// verifies the signature; a tag alone is not an identity.
fn gsig(G:[]u8)i32 {
  let s:i32=7;
  let nn:i32=g_nneeds(G);
  s=(s*31+nn) % 1048573;
  let n:i32=0;
  while(n<nn){
    s=(s*31+need_tag(G,n)) % 1048573;
    s=(s*31+need_nf(G,n)) % 1048573;
    n=n+1;
  }
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    s=(s*31+link_w(G,l,0)) % 1048573;
    s=(s*31+link_w(G,l,1)) % 1048573;
    s=(s*31+link_w(G,l,4)) % 1048573;
    l=l+1;
  }
  return s;
}
fn plan_base(pi:i32)i32 { return l_plan()+pi*p_stride(); }
fn plan_find(L:[]u8,gtag:i32,sig:i32)i32 {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))==gtag){
      if(get32(L,plan_base(pi)+4)==sig){ return pi; }
    }
    pi=pi+1;
  }
  return -1;
}
fn plan_sig(L:[]u8,pi:i32)i32 { return get32(L,plan_base(pi)+4); }
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<NPLAN()){ set32(L,plan_base(pi),0); pi=pi+1; }
  return;
}
fn plan_drop(L:[]u8,gtag:i32)void {
  let pi:i32=-1;
  let q:i32=0;
  while(q<NPLAN()){
    if(get32(L,plan_base(q))==gtag){ pi=q; }
    q=q+1;
  }
  if(pi>=0){ set32(L,plan_base(pi),0); }
  return;
}
fn plan_n(L:[]u8,pi:i32)i32 { return get32(L,plan_base(pi)+8); }
fn plan_idx(L:[]u8,pi:i32,p:i32)i32 { return get32(L,plan_base(pi)+12+p*12); }
fn plan_fam(L:[]u8,pi:i32,p:i32)i32 { return get32(L,plan_base(pi)+12+p*12+8); }
fn plan_set_fam(L:[]u8,pi:i32,p:i32,v:i32)void { set32(L,plan_base(pi)+12+p*12+8,v); return; }
fn plan_pos(L:[]u8,pi:i32,ni:i32)i32 {
  let n:i32=plan_n(L,pi);
  let p:i32=0;
  while(p<n){
    if(plan_idx(L,pi,p)==ni){ return p; }
    p=p+1;
  }
  return -1;
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))==0){
      let nn:i32=g_nneeds(G);
      set32(L,plan_base(pi),gtag);
      set32(L,plan_base(pi)+4,gsig(G));
      set32(L,plan_base(pi)+8,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        let bo:i32=bind_off(bi);
        set32(L,plan_base(pi)+12+p*12,ni);
        set32(L,plan_base(pi)+12+p*12+4,tag);
        set32(L,plan_base(pi)+12+p*12+8,get32(L,bo+4));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}

// ================= execution =========================================
fn exec_need(L:[]u8,A:[]u8,G:[]u8,ni:i32,fam:i32,K:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,ver:[]u8)void {
  apply_scalar(G,W,OUTS,ni);
  let nos:i32=apply_set(G,OUTS,SUBL,ni);
  if(fam==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    let vv:i32=ret_version(L,rel);
    if(vv==2){
      set32(L,13252,get32(L,13252)+1);
      ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
    }
    if(vv==0){
      set32(L,13256,get32(L,13256)+1);
      ret_gen(A,rel,obj,K,0,OUTS,ni*160);
    }
    set32(ver,0,vv);
    return;
  }
  if(fam==1){
    let vv2:i32=vfy_version(L,W,ni);
    if(vv2==3){ set32(L,13260,get32(L,13260)+1); }
    if(vv2==1){ set32(L,13264,get32(L,13264)+1); }
    if(nos==0){
      w_to_chain(W,ni,C,-1);
      let r:i32=0;
      if(vv2==3){ r=vfy_spec(L,A,C,K,0); }
      if(vv2==1){ r=vfy_gen(A,C,K,0); }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,r);
      set32(ver,0,vv2);
      return;
    }
    let np:i32=0;
    let q:i32=0;
    while(q<nos){
      let subj:i32=get32(SUBL,ni*STK()+4+q*4);
      w_to_chain(W,ni,C,subj);
      let r2:i32=0;
      if(vv2==3){ r2=vfy_spec(L,A,C,K,0); }
      if(vv2==1){ r2=vfy_gen(A,C,K,0); }
      if(r2==1){
        if(np<32){ set32(OUTS,ni*160+4+np*4,subj); }
        np=np+1;
      }
      q=q+1;
    }
    set32(OUTS,ni*160,np);
    set32(ver,0,vv2);
    return;
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*80+4);
    let vv3:i32=cnt_version(L,rel3);
    let one:[]u8=z_alloc(8);
    let src:[]u8=SUBL;
    let so:i32=ni*STK()+4;
    let ns:i32=nos;
    if(ns==0){
      set32(one,0,get32(W,ni*80+12));
      src=one;
      so=0;
      ns=1;
    }
    let cc:i32=0;
    if(vv3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,src,so,ns,K,0,seen);
    }
    if(vv3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,src,so,ns,K,0,seen);
    }
    set32(OUTS,ni*160,1);
    set32(OUTS,ni*160+4,cc);
    set32(ver,0,vv3);
    return;
  }
  set32(OUTS,ni*160,0);
  set32(ver,0,-1);
  return;
}
// change-driven iterated execution; halts at quiescence or the pass cap
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8,ord:[]u8,ver:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=plan_n(L,pi);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  let n:i32=0;
  while(n<nn){ set32(OUTS,n*160,0); set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let running:i32=1;
  while(running==1){
    if(pass>=PCAP()){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=plan_idx(L,pi,p);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_need(L,A,G,ni,plan_fam(L,pi,p),K,W,OUTS,SUBL,C,seen,ver);
          set32(vbuf,p*4,get32(ver,0));
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  set32(ans,0,0);
  let q:i32=0;
  while(q<nn){
    let nr:i32=get32(OUTS,q*160);
    let c:i32=get32(ans,0);
    set32(ans,4+c*4,nr);
    set32(ans,0,c+1);
    let k:i32=0;
    while(k<nr){
      let c2:i32=get32(ans,0);
      set32(ans,4+c2*4,get32(OUTS,q*160+4+k*4));
      set32(ans,0,c2+1);
      k=k+1;
    }
    q=q+1;
  }
  return;
}
// entry point. 0 = declined (a need is unbound, or a link is
// inadmissible), 1 = stored plan executed, 2 = plan built and executed.
// admit=1 enforces I2/I3/I4. admit=0 reproduces the frozen reading and
// exists only as this lane's control arm; it is chosen by the driver,
// never by anything in the goal record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8,admit:i32)i32 {
  let W:[]u8=z_alloc(NM()*80+16);
  let OUTS:[]u8=z_alloc(NM()*160+16);
  let SUBL:[]u8=z_alloc(NM()*STK()+16);
  let ord:[]u8=z_alloc(NM()*4+8);
  let ind:[]u8=z_alloc(NM()*4+8);
  let placed:[]u8=z_alloc(NM()*4+8);
  let dirty:[]u8=z_alloc(NM()*4+8);
  let snap:[]u8=z_alloc(160);
  let C:[]u8=z_alloc(CHN());
  let seen:[]u8=z_alloc(SNN());
  let d:[]u8=z_alloc(NM()*12+128);
  let ver:[]u8=z_alloc(8);
  let gt:i32=g_tag(G);
  let nn:i32=g_nneeds(G);
  let sg:i32=gsig(G);
  let pi:i32=plan_find(L,gt,sg);
  if(pi<0){
    learn_bindings(L,G,d);
    let n:i32=0;
    while(n<nn){
      let bi:i32=bind_find(L,need_tag(G,n));
      let ok:i32=1;
      if(bi<0){ ok=0; }
      if(ok==1){ if(get32(L,bind_off(bi)+4)<0){ ok=0; } }
      if(ok==0){ set32(L,13236,get32(L,13236)+1); return 0; }
      n=n+1;
    }
    if(admit==1){
      links_admit(G,d);
      if(get32(d,0)==0){ set32(L,13236,get32(L,13236)+1); return 0; }
    }
    topo(G,ord,ind,placed);
    pi=plan_new(L,gt,G,ord);
    if(pi<0){ set32(L,13236,get32(L,13236)+1); return 0; }
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,SUBL,C,seen,dirty,snap,ord,ver);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,SUBL,C,seen,dirty,snap,ord,ver);
  return 1;
}
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))!=0){
      let k:i32=0;
      let top:i32=12+NM()*12;
      while(k<top){ set32(out,k*4,get32(L,plan_base(pi)+k*4)); k=k+1; }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}

}
// g916: 1 need, 1 free 5-field form
fn g916(G:[]u8)void {
  let o:i32=gb(G,916,1);
  o=gn(G,o,804,5);
  o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0);
  o=gl_n(G,o,0);
  return;
}
// g917: 3 needs, set link into a need with no set-shaped operand
fn g917(G:[]u8)void {
  let o:i32=gb(G,917,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,902); o=gf(G,o,0);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,2,1,0,0,1,0);
  o=gl(G,o,3,2,0,1,1,0);
  return;
}
// g918: 2 needs, one producer inside the learned index, one outside
fn g918(G:[]u8)void {
  let o:i32=gb(G,918,2);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,913); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
// g919: 3 needs, self link on need 1, set link from need 1 to need 2
fn g919(G:[]u8)void {
  let o:i32=gb(G,919,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3001);
  o=gl_n(G,o,2);
  o=gl(G,o,1,1,1,1,1,0);
  o=gl(G,o,2,2,0,1,1,0);
  return;
}// g920a / g920b / g920c: the SAME goal tag with different constructed
// fields. Used to separate "reuse a stored plan" from "return a stored
// answer".
fn g920a(G:[]u8)void {
  let o:i32=gb(G,920,2);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
fn g920b(G:[]u8)void {
  let o:i32=gb(G,920,2);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1005);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
fn g920c(G:[]u8)void {
  let o:i32=gb(G,920,2);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1007);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
// g912t: the first six needs of g912, goal tag 912. Used to separate
// "extend a stored plan" from "build a new plan".
fn g912t(G:[]u8)void {
  let o:i32=gb(G,912,6);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,902); o=gf(G,o,3000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3003);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3000);
  o=gl_n(G,o,4);
  o=gl(G,o,1,1,1,0,1,0);
  o=gl(G,o,1,2,1,1,1,0);
  o=gl(G,o,2,4,0,2,1,0);
  o=gl(G,o,2,5,0,3,1,0);
  return;
}
// ================= P2 OPERAND-SET additions =========================
// Data only. Relations 920..924 and the domain-form goal constructor.
// The world is UNCHANGED for goals 901..919: p2_world's 177 facts are
// retained verbatim above.

// dom_world: the 50 additional facts. Called after p2_world.
fn dom_world(A:[]u8)void {
  let i:i32=0;
  while(i<10){ fact_add(A,1300+i,920,6000); i=i+1; }
  i=0;
  while(i<10){ fact_add(A,1305+i,921,6000); i=i+1; }
  i=0;
  while(i<10){ fact_add(A,1300+i,922,7000); i=i+1; }
  i=0;
  while(i<10){ fact_add(A,1307+i,923,6000); i=i+1; }
  i=0;
  while(i<10){ fact_add(A,1310+i,924,6000); i=i+1; }
  return;
}

// gdom(G,tag,R,n): n source needs using relations 920,921,923,924 in that
// order (922 is the chain relation and is skipped), then ONE receiver in
// the domain form
//   nf = 2 + 3*ns   fields = [ ns, (subj,obj,val)*ns , R ]
// The rule code R is the LAST field, so the frozen chain reader w_to_chain
// (which reads fields 1..3*ns) is used unmodified. Field 1 is the subject
// placeholder and equals 0, which the engine replaces with the domain value.
fn gdom(G:[]u8,tag:i32,R:i32,n:i32)void {
  let nn:i32=n+1;
  let o:i32=gb(G,tag,nn);
  let i:i32=0;
  while(i<n){
    let r:i32=920+i;
    if(i>=2){ r=r+1; }
    o=gn(G,o,801,2); o=gf(G,o,r); o=gf(G,o,6000);
    i=i+1;
  }
  o=gn(G,o,805,5);
  o=gf(G,o,1);
  o=gf(G,o,0);
  o=gf(G,o,922);
  o=gf(G,o,7000);
  o=gf(G,o,R);
  o=gl_n(G,o,n);
  i=0;
  while(i<n){
    o=gl(G,o,2,n,0,i,1,0);
    i=i+1;
  }
  return;
}
// experience patterns for the domain relations, in the same discipline as
// p2_ret_pat / p2_vfy_chain / p2_cnt_pat: ordinals in, literals here only.
fn p2_dom_ret_pat(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,920); set32(rb,4,6000); return; }
  if(id==1){ set32(rb,0,921); set32(rb,4,6000); return; }
  if(id==2){ set32(rb,0,923); set32(rb,4,6000); return; }
  set32(rb,0,924); set32(rb,4,6000); return;
}
fn p2_dom_vfy_chain(C:[]u8,id:i32)void {
  chain_clear(C);
  if(id==0){ chain_add(C,1300,922,7000); return; }
  chain_add(C,1305,922,7000); return;
}
fn p2_dom_cnt_pat(id:i32,rb:[]u8)void {
  set32(rb,0,922); set32(rb,4,1000); return;
}
// p2_learn.zag -- COMPOSE-DAG cognition source.
//
// Derived from the frozen COGOPS prefix (cogops_learnosc2/c8_learn.zag,
// sha256 750cb01d086f0f4eeb29d0a8481e36941a7551396e5c514429a0dffc7aa4b4e8)
// by the GEN-REDIM discipline (C429/C434): every per-need region is
// placed by exact size chaining from a declared capacity, and every
// stride and base is an accessor of that capacity. No per-need count
// appears as a literal anywhere in this file, and no topology vocabulary
// appears anywhere in this file.
//
// STRUCTURAL INVARIANTS added, each stated without reference to any
// goal shape:
//
//   I1 CAPACITY. Every buffer and every table is sized from NM/NPLAN/
//      NBIND. A need count is a parameter of the arena, never a
//      constant baked into a stride.
//
//   I2 PRODUCED VALUE. A link carries only values its source actually
//      produced. A source that produced nothing carries nothing.
//
//   I3 OPERAND SET. The operand set of a need is the union, in
//      goal-record link order, over ALL incoming set-consuming links of
//      the values those producers actually produced, deduplicated with
//      first-occurrence order. Not "the first source". Not "all sources
//      concatenated without dedup".
//
//   I4 LINK ADMISSION. A set-consuming link is admissible iff the
//      producer's accepted shape is set-valued and the receiver's
//      accepted shape has a set operand. An inadmissible link refuses
//      the goal. The engine never reads an unrelated operand slot and
//      never feeds a scalar into a set operand.
//
//   I5 CANONICAL EMISSION. Answer records are emitted in need-index
//      order, and ordering breaks ties toward the lowest need index, so
//      the answer does not depend on the stored plan order.
//
//   I6 ORDERING. Ordering is Kahn over the link graph with a stall
//      guard; the remaining needs are appended in index order.
//
// The three researcher-supplied generic procedures are unchanged. The
// retrieval / verification / counting coverage indices keep the frozen
// byte layout (offsets 0..12743) so that the learned evidence is
// bit-identical to the frozen lane's. Only the binding and plan tables
// move to capacity-derived bases.

fn NM()i32 { return 24; }
fn NPLAN()i32 { return 24; }
fn NBIND()i32 { return 32; }
fn PCAP()i32 { return 64; }
fn STK()i32 { return 128; }
fn CHN()i32 { return 512; }
fn SNN()i32 { return 320; }

fn l_bind()i32 { return 13280; }
fn l_plan()i32 { return l_bind()+NBIND()*32; }
fn p_stride()i32 { return 12+NM()*12; }
fn l_size()i32 { return l_plan()+NPLAN()*p_stride(); }

// ================= learned coverage indices (frozen layout) ==========
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  let bi:i32=ret_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,0);
  if(n<16){
    set32(L,0,n+1);
    set32(L,4+n*4,r);
    set32(L,68+n*4,0);
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  let bi:i32=vfy_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,4248);
  if(n<16){
    set32(L,4248,n+1);
    set32(L,4252+n*4,r);
    set32(L,4316+n*4,0);
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  let bi:i32=cnt_cov_find(L,r);
  if(bi>=0){ return; }
  let n:i32=get32(L,8496);
  if(n<16){
    set32(L,8496,n+1);
    set32(L,8500+n*4,r);
    set32(L,8564+n*4,0);
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }

fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}

// ================= goal-record accessors (frozen layout) ============
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 { return get32(G,g_linkbase(G)+4+l*28+w*4); }

// ================= descriptor of a need's operand surface ============
// cell 0 accepted, cell 1 set operand slot (-1 none), cell 2 set-valued
// output, cell 3 scalar field count, cell 4 procedure selector
fn d_acc(d:[]u8)i32 { return get32(d,0); }
fn d_slot(d:[]u8)i32 { return get32(d,4); }
fn d_out(d:[]u8)i32 { return get32(d,8); }
fn d_nsca(d:[]u8)i32 { return get32(d,12); }
fn d_fam(d:[]u8)i32 { return get32(d,16); }
fn d_acc_n(d:[]u8,n:i32)i32 { return get32(d,32+n*4); }
fn d_slot_n(d:[]u8,n:i32)i32 { return get32(d,32+NM()*4+n*4); }
fn d_out_n(d:[]u8,n:i32)i32 { return get32(d,32+2*NM()*4+n*4); }
fn shape_desc(G:[]u8,n:i32,d:[]u8)void {
  set32(d,0,0); set32(d,4,-1); set32(d,8,0); set32(d,12,0); set32(d,16,-1);
  let nf:i32=need_nf(G,n);
  if(nf==2){
    set32(d,0,1); set32(d,8,1); set32(d,12,2); set32(d,16,0);
    return;
  }
  if(nf==3){
    if(need_f(G,n,1)==1){
      set32(d,0,1); set32(d,4,2); set32(d,8,0); set32(d,12,2); set32(d,16,2);
    }
    return;
  }
  if(nf>=4){
    let ns:i32=need_f(G,n,0);
    if(ns>=1){
      if(ns<=16){
        if(nf==1+ns*3){
          set32(d,0,1); set32(d,4,1); set32(d,8,1); set32(d,12,nf); set32(d,16,1);
        }
      }
    }
  }
  // ---- P2-OPERAND-SET insertion 1 of 3 -------------------------------
  // The domain form: the family-1 shape plus one trailing rule code, so
  // nf == 2 + ns*3. Nothing else in this function changes.
  if(nf>=5){
    let ns2:i32=need_f(G,n,0);
    if(ns2>=1){
      if(ns2<=16){
        if(nf==2+ns2*3){
          set32(d,0,1); set32(d,4,1); set32(d,8,1); set32(d,12,nf); set32(d,16,1);
        }
      }
    }
  }
  return;
}
// I4: a link is admissible iff both endpoints' accepted shapes have a
// compatible operand. A set-consuming link requires a set-valued source
// and a receiver with a set operand; a carried link requires both ends
// to be accepted. Anything else refuses the whole goal.
fn links_admit(G:[]u8,d:[]u8)void {
  set32(d,0,1);
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    shape_desc(G,n,d);
    set32(d,32+n*4,d_acc(d));
    set32(d,32+NM()*4+n*4,d_slot(d));
    set32(d,32+2*NM()*4+n*4,d_out(d));
    n=n+1;
  }
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    let dn:i32=link_w(G,l,1);
    let sn:i32=link_w(G,l,4);
    if(k<1){ set32(d,0,0); }
    if(dn<0){ set32(d,0,0); }
    if(sn<0){ set32(d,0,0); }
    if(dn>=0){
      if(d_acc_n(d,dn)==0){ set32(d,0,0); }
    }
    if(sn>=0){
      if(d_acc_n(d,sn)==0){ set32(d,0,0); }
    }
    if(k>=2){
      if(dn>=0){ if(d_slot_n(d,dn)<0){ set32(d,0,0); } }
      if(sn>=0){ if(d_out_n(d,sn)==0){ set32(d,0,0); } }
    }
    l=l+1;
  }
  return;
}

// ================= working state =====================================
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// I5/I6: Kahn, ties to the lowest ready index, stall-guarded.
fn topo(G:[]u8,ord:[]u8,ind:[]u8,placed:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let fnd:i32=-1;
    let n2:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ if(fnd<0){ fnd=n2; } }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let k:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return k;
}
// I2: a carried value exists only if the source produced one.
fn apply_scalar(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){
        let ds:i32=link_w(G,l,3);
        let sn:i32=link_w(G,l,4);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let fire:i32=1;
        if(sk==1){ if(get32(OUTS,sn*160)==0){ fire=0; } }
        if(fire==1){
          let v:i32=0;
          if(sk==0){ v=get32(W,sn*80+4+ss*4); }
          if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
          set32(W,ni*80+4+ds*4,v);
        }
      }
    }
    l=l+1;
  }
  return;
}
// I3: operand set = union over ALL incoming set links, link order, dedup.
fn apply_set(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    if(k>=2){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let m:i32=get32(OUTS,sn*160);
        let j:i32=0;
        while(j<m){
          let v:i32=get32(OUTS,sn*160+4+j*4);
          let dup:i32=0;
          let f:i32=0;
          while(f<tot){
            if(get32(SUBL,ni*STK()+4+f*4)==v){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(tot<STK()/4-1){ set32(SUBL,ni*STK()+4+tot*4,v); tot=tot+1; }
          }
          j=j+1;
        }
      }
    }
    l=l+1;
  }
  set32(SUBL,ni*STK(),tot);
  return tot;
}
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8)void {
  let n:i32=get32(OUTS,ni*160);
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8)i32 {
  let n:i32=get32(OUTS,ni*160);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*160+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}

// ================= binding table (capacity-derived) =================
fn bind_off(bi:i32)i32 { return l_bind()+bi*32; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<NBIND()){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<NBIND()){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<NBIND()){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// binding is by accepted shape only: the learner's evidence about
// relations selects procedure VERSIONS, not which procedure a need is.
fn learn_bindings(L:[]u8,G:[]u8,d:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    shape_desc(G,n,d);
    // ---- P2-OPERAND-SET insertion 3 of 3 -----------------------------
    // A domain-form need binds only when a rule is available under the
    // active provenance switch. With no rule the descriptor is left
    // unaccepted, bind_fam stays -1, and compose declines the goal.
    if(is_dom(G,n)==1){
      if(domrule_of(L,G,n)<0){ set32(d,0,0); }
    }
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bi>=0){
      // ARM gate, part 2: a domain-form need's binding must follow the
      // rule that is currently available, so a family recorded while a
      // rule existed cannot survive the rule table being emptied.
      if(is_dom(G,n)==1){
        if(domrule_of(L,G,n)<0){ set32(L,bind_off(bi)+4,-1); }
      }
      if(bind_fam(L,bi)<0){
        set32(L,13232,get32(L,13232)+1);
        if(d_acc(d)==1){ set32(L,bind_off(bi)+4,d_fam(d)); }
      }
    }
    n=n+1;
  }
  return;
}
// I7 PLAN IDENTITY. A stored plan is keyed by the goal tag AND by a
// signature of the structure it was built from: the need count, every
// need tag and field count, and every link kind and endpoint. Reuse
// verifies the signature; a tag alone is not an identity.
fn gsig(G:[]u8)i32 {
  let s:i32=7;
  let nn:i32=g_nneeds(G);
  s=(s*31+nn) % 1048573;
  let n:i32=0;
  while(n<nn){
    s=(s*31+need_tag(G,n)) % 1048573;
    s=(s*31+need_nf(G,n)) % 1048573;
    n=n+1;
  }
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    s=(s*31+link_w(G,l,0)) % 1048573;
    s=(s*31+link_w(G,l,1)) % 1048573;
    s=(s*31+link_w(G,l,4)) % 1048573;
    l=l+1;
  }
  return s;
}
fn plan_base(pi:i32)i32 { return l_plan()+pi*p_stride(); }
fn plan_find(L:[]u8,gtag:i32,sig:i32)i32 {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))==gtag){
      if(get32(L,plan_base(pi)+4)==sig){ return pi; }
    }
    pi=pi+1;
  }
  return -1;
}
fn plan_sig(L:[]u8,pi:i32)i32 { return get32(L,plan_base(pi)+4); }
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<NPLAN()){ set32(L,plan_base(pi),0); pi=pi+1; }
  return;
}
fn plan_drop(L:[]u8,gtag:i32)void {
  let pi:i32=-1;
  let q:i32=0;
  while(q<NPLAN()){
    if(get32(L,plan_base(q))==gtag){ pi=q; }
    q=q+1;
  }
  if(pi>=0){ set32(L,plan_base(pi),0); }
  return;
}
fn plan_n(L:[]u8,pi:i32)i32 { return get32(L,plan_base(pi)+8); }
fn plan_idx(L:[]u8,pi:i32,p:i32)i32 { return get32(L,plan_base(pi)+12+p*12); }
fn plan_fam(L:[]u8,pi:i32,p:i32)i32 { return get32(L,plan_base(pi)+12+p*12+8); }
fn plan_set_fam(L:[]u8,pi:i32,p:i32,v:i32)void { set32(L,plan_base(pi)+12+p*12+8,v); return; }
fn plan_pos(L:[]u8,pi:i32,ni:i32)i32 {
  let n:i32=plan_n(L,pi);
  let p:i32=0;
  while(p<n){
    if(plan_idx(L,pi,p)==ni){ return p; }
    p=p+1;
  }
  return -1;
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))==0){
      let nn:i32=g_nneeds(G);
      set32(L,plan_base(pi),gtag);
      set32(L,plan_base(pi)+4,gsig(G));
      set32(L,plan_base(pi)+8,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        let bo:i32=bind_off(bi);
        set32(L,plan_base(pi)+12+p*12,ni);
        set32(L,plan_base(pi)+12+p*12+4,tag);
        set32(L,plan_base(pi)+12+p*12+8,get32(L,bo+4));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}

// ================= execution =========================================
fn exec_need(L:[]u8,A:[]u8,G:[]u8,ni:i32,fam:i32,K:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,ver:[]u8)void {
  apply_scalar(G,W,OUTS,ni);
  let nos:i32=apply_set(G,OUTS,SUBL,ni);
  // ---- P2-OPERAND-SET insertion 2 of 3 -------------------------------
  // Domain-form reduction. dm is the rule code resolved by the caller's
  // provenance switch (os_arm.zag); -1 means the need is not in the domain
  // form. RED=0 keeps the shape accepted but skips the reduction, which is
  // the lane's ablation AB2.
  let dm:i32=domrule_of(L,G,ni);
  if(dm>=0){
    if(arm_red(L)==1){ nos=dom_reduce(G,L,ni,OUTS,SUBL,dm); }
  }
  if(fam==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    let vv:i32=ret_version(L,rel);
    if(vv==2){
      set32(L,13252,get32(L,13252)+1);
      ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
    }
    if(vv==0){
      set32(L,13256,get32(L,13256)+1);
      ret_gen(A,rel,obj,K,0,OUTS,ni*160);
    }
    set32(ver,0,vv);
    return;
  }
  if(fam==1){
    let vv2:i32=vfy_version(L,W,ni);
    if(vv2==3){ set32(L,13260,get32(L,13260)+1); }
    if(vv2==1){ set32(L,13264,get32(L,13264)+1); }
    if(nos==0){
      w_to_chain(W,ni,C,-1);
      let r:i32=0;
      if(vv2==3){ r=vfy_spec(L,A,C,K,0); }
      if(vv2==1){ r=vfy_gen(A,C,K,0); }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,r);
      set32(ver,0,vv2);
      return;
    }
    let np:i32=0;
    let q:i32=0;
    while(q<nos){
      let subj:i32=get32(SUBL,ni*STK()+4+q*4);
      w_to_chain(W,ni,C,subj);
      let r2:i32=0;
      if(vv2==3){ r2=vfy_spec(L,A,C,K,0); }
      if(vv2==1){ r2=vfy_gen(A,C,K,0); }
      if(r2==1){
        if(np<32){ set32(OUTS,ni*160+4+np*4,subj); }
        np=np+1;
      }
      q=q+1;
    }
    set32(OUTS,ni*160,np);
    set32(ver,0,vv2);
    return;
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*80+4);
    let vv3:i32=cnt_version(L,rel3);
    let one:[]u8=z_alloc(8);
    let src:[]u8=SUBL;
    let so:i32=ni*STK()+4;
    let ns:i32=nos;
    if(ns==0){
      set32(one,0,get32(W,ni*80+12));
      src=one;
      so=0;
      ns=1;
    }
    let cc:i32=0;
    if(vv3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,src,so,ns,K,0,seen);
    }
    if(vv3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,src,so,ns,K,0,seen);
    }
    set32(OUTS,ni*160,1);
    set32(OUTS,ni*160+4,cc);
    set32(ver,0,vv3);
    return;
  }
  set32(OUTS,ni*160,0);
  set32(ver,0,-1);
  return;
}
// change-driven iterated execution; halts at quiescence or the pass cap
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8,ord:[]u8,ver:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=plan_n(L,pi);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  let n:i32=0;
  while(n<nn){ set32(OUTS,n*160,0); set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let running:i32=1;
  while(running==1){
    if(pass>=PCAP()){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=plan_idx(L,pi,p);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_need(L,A,G,ni,plan_fam(L,pi,p),K,W,OUTS,SUBL,C,seen,ver);
          set32(vbuf,p*4,get32(ver,0));
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  set32(ans,0,0);
  let q:i32=0;
  while(q<nn){
    let nr:i32=get32(OUTS,q*160);
    let c:i32=get32(ans,0);
    set32(ans,4+c*4,nr);
    set32(ans,0,c+1);
    let k:i32=0;
    while(k<nr){
      let c2:i32=get32(ans,0);
      set32(ans,4+c2*4,get32(OUTS,q*160+4+k*4));
      set32(ans,0,c2+1);
      k=k+1;
    }
    q=q+1;
  }
  return;
}
// entry point. 0 = declined (a need is unbound, or a link is
// inadmissible), 1 = stored plan executed, 2 = plan built and executed.
// admit=1 enforces I2/I3/I4. admit=0 reproduces the frozen reading and
// exists only as this lane's control arm; it is chosen by the driver,
// never by anything in the goal record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8,admit:i32)i32 {
  let W:[]u8=z_alloc(NM()*80+16);
  let OUTS:[]u8=z_alloc(NM()*160+16);
  let SUBL:[]u8=z_alloc(NM()*STK()+16);
  let ord:[]u8=z_alloc(NM()*4+8);
  let ind:[]u8=z_alloc(NM()*4+8);
  let placed:[]u8=z_alloc(NM()*4+8);
  let dirty:[]u8=z_alloc(NM()*4+8);
  let snap:[]u8=z_alloc(160);
  let C:[]u8=z_alloc(CHN());
  let seen:[]u8=z_alloc(SNN());
  let d:[]u8=z_alloc(NM()*12+128);
  let ver:[]u8=z_alloc(8);
  let gt:i32=g_tag(G);
  let nn:i32=g_nneeds(G);
  let sg:i32=gsig(G);
  let pi:i32=plan_find(L,gt,sg);
  if(pi<0){
    learn_bindings(L,G,d);
    let n:i32=0;
    while(n<nn){
      let bi:i32=bind_find(L,need_tag(G,n));
      let ok:i32=1;
      if(bi<0){ ok=0; }
      if(ok==1){ if(get32(L,bind_off(bi)+4)<0){ ok=0; } }
      if(ok==0){ set32(L,13236,get32(L,13236)+1); return 0; }
      n=n+1;
    }
    if(admit==1){
      links_admit(G,d);
      if(get32(d,0)==0){ set32(L,13236,get32(L,13236)+1); return 0; }
    }
    topo(G,ord,ind,placed);
    pi=plan_new(L,gt,G,ord);
    if(pi<0){ set32(L,13236,get32(L,13236)+1); return 0; }
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,SUBL,C,seen,dirty,snap,ord,ver);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,SUBL,C,seen,dirty,snap,ord,ver);
  return 1;
}
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<NPLAN()){
    if(get32(L,plan_base(pi))!=0){
      let k:i32=0;
      let top:i32=12+NM()*12;
      while(k<top){ set32(out,k*4,get32(L,plan_base(pi)+k*4)); k=k+1; }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
// p2_drv.zag -- COMPOSE-DAG lane driver helpers.
// Contains an INDEPENDENT straight-line reference evaluator written only
// against the frozen generic procedures (ret_gen / vfy_gen / cnt_gen).
// It shares NO plan machinery, NO learner state and NO ordering routine
// with the cognition source, so agreement between the two is evidence
// and not tautology.
//
// adapt flag:
//   0 = strict reading:  a scalar link always fires, reading the source's
//       output cell even when the source produced nothing.
//   1 = produced-value reading: a scalar link fires only from a source
//       that produced at least one value; a set link's operand set is
//       the union over ALL incoming set links in goal-record link order;
//       a set link whose destination has no set operand slot, or whose
//       source produced a scalar, is INADMISSIBLE and refuses the goal.
// No topology vocabulary appears in this file.

fn ref_topo(G:[]u8,ord:[]u8)void {
  let nn:i32=get32(G,4);
  let nl:i32=g_nlinks(G);
  let done:[]u8=z_alloc(nn*4+8);
  let p:i32=0;
  while(p<nn){
    let pick:i32=-1;
    let c:i32=0;
    while(c<nn){
      if(get32(done,c*4)==0){
        let ok:i32=1;
        let l:i32=0;
        while(l<nl){
          if(link_w(G,l,1)==c){
            let s:i32=link_w(G,l,4);
            if(s!=c){
              if(get32(done,s*4)==0){ ok=0; }
            }
          }
          l=l+1;
        }
        if(ok==1){ if(pick<0){ pick=c; } }
      }
      c=c+1;
    }
    if(pick<0){
      set32(ord,p*4,nn);
      p=nn;
    }
    if(pick>=0){
      set32(done,pick*4,1);
      set32(ord,p*4,pick);
      p=p+1;
    }
  }
  return;
}
// descriptor of a need's operand surface
fn ref_set_slot(G:[]u8,n:i32)i32 {
  let nf:i32=need_nf(G,n);
  if(nf==3){
    if(need_f(G,n,1)==1){ return 2; }
    return -1;
  }
  if(nf>=4){
    let ns:i32=need_f(G,n,0);
    if(ns>=1){
      if(ns<=16){
        if(nf==1+ns*3){ return 1; }
      }
    }
    return -1;
  }
  if(nf==2){ return -1; }
  return -1;
}
fn ref_out_set(G:[]u8,n:i32)i32 {
  let nf:i32=need_nf(G,n);
  if(nf==2){ return 1; }
  if(nf>=4){
    let ns:i32=need_f(G,n,0);
    if(ns>=1){
      if(ns<=16){
        if(nf==1+ns*3){ return 1; }
      }
    }
    return -1;
  }
  return -1;
}
// operand-set union with first-occurrence order, from OUT arrays
// adapt=0 reproduces the FROZEN operand-set rule exactly as measured on
// the frozen lane: a set-consuming link of kind 2 contributes only its
// FIRST source (fanin_src returns on the first match), while a link of
// kind 3 concatenates every source (apply_kind3 concatenates all).
// adapt=1 is the union rule of invariant I3.
fn ref_opset(G:[]u8,OUTS:[]u8,S:[]u8,n:i32,adapt:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let got2:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    let dn:i32=link_w(G,l,1);
    let use:i32=0;
    if(k==2){
      if(dn==n){
        if(adapt==1){ use=1; }
        else { if(got2==0){ use=1; got2=1; } }
      }
    }
    if(k==3){
      if(dn==n){ use=1; }
    }
    if(use==1){
      let sn:i32=link_w(G,l,4);
        let cnt:i32=get32(OUTS,sn*160);
        let j:i32=0;
        while(j<cnt){
          let v:i32=get32(OUTS,sn*160+4+j*4);
          let dup:i32=0;
          let f:i32=0;
          while(f<tot){
            if(get32(S,f*4)==v){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            set32(S,tot*4,v);
            tot=tot+1;
          }
          j=j+1;
        }
    }
    l=l+1;
  }
  return tot;
}
// ref_eval: returns 0 refused, 1 answered. Writes [n, ints...] into out.
fn ref_eval(A:[]u8,G:[]u8,K:[]u8,out:[]u8,adapt:i32)i32 {
  let nn:i32=get32(G,4);
  let nl:i32=g_nlinks(G);
  let ord:[]u8=z_alloc(nn*4+8);
  let W:[]u8=z_alloc(nn*80+16);
  let OUTS:[]u8=z_alloc(nn*160+16);
  let S:[]u8=z_alloc(1024);
  let C:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  ref_topo(G,ord);
  let n:i32=0;
  while(n<nn){
    set32(W,n*80,need_nf(G,n));
    let f:i32=0;
    while(f<need_nf(G,n)){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  // shape admission: a need whose shape no procedure accepts is unbindable
  let nn0:i32=get32(G,4);
  let sh:i32=0;
  while(sh<nn0){
    let nfs:i32=need_nf(G,sh);
    let ok:i32=0;
    if(nfs==2){ ok=1; }
    if(nfs==3){ if(need_f(G,sh,1)==1){ ok=1; } }
    if(nfs>=4){
      let nss:i32=need_f(G,sh,0);
      if(nss>=1){ if(nss<=16){ if(nfs==1+nss*3){ ok=1; } } }
    }
    if(ok==0){ return 0; }
    sh=sh+1;
  }
  // link admission
  if(adapt==1){
    let l:i32=0;
    while(l<nl){
      let k:i32=link_w(G,l,0);
      if(k>=2){
        let dn:i32=link_w(G,l,1);
        let sn:i32=link_w(G,l,4);
        if(ref_set_slot(G,dn)<0){ return 0; }
        if(ref_out_set(G,sn)==0){ return 0; }
      }
      l=l+1;
    }
  }
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(ord,p*4);
    // scalar links
    let l2:i32=0;
    while(l2<nl){
      if(link_w(G,l2,0)==1){
        if(link_w(G,l2,1)==ni){
          let sn2:i32=link_w(G,l2,4);
          let fire:i32=1;
          if(adapt==1){ if(get32(OUTS,sn2*160)==0){ fire=0; } }
          if(fire==1){
            let ds:i32=link_w(G,l2,3);
            let sk:i32=link_w(G,l2,5);
            let ss:i32=link_w(G,l2,6);
            let v:i32=0;
            if(sk==0){ v=get32(W,sn2*80+4+ss*4); }
            if(sk==1){ v=get32(OUTS,sn2*160+4+ss*4); }
            set32(W,ni*80+4+ds*4,v);
          }
        }
      }
      l2=l2+1;
    }
    let nf:i32=get32(W,ni*80);
    let nos:i32=ref_opset(G,OUTS,S,ni,adapt);
    if(nf==2){
      ret_gen(A,get32(W,ni*80+4),get32(W,ni*80+8),K,20,OUTS,ni*160);
    }
    if(nf==3){
      if(get32(W,ni*80+8)==1){
        let ns:i32=1;
        if(nos>0){ ns=nos; }
        else{ set32(S,0,get32(W,ni*80+12)); }
        let cc:i32=cnt_gen(A,get32(W,ni*80+4),S,0,ns,K,20,seen);
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,cc);
      }
    }
    if(nf>=4){
      let ns2:i32=get32(W,ni*80+4);
      let np:i32=0;
      if(nos==0){
        set32(C,0,ns2);
        let i:i32=0;
        while(i<ns2){
          set32(C,4+i*12,get32(W,ni*80+4+(1+i*3)*4));
          set32(C,4+i*12+4,get32(W,ni*80+4+(2+i*3)*4));
          set32(C,4+i*12+8,get32(W,ni*80+4+(3+i*3)*4));
          i=i+1;
        }
        let vv:i32=vfy_gen(A,C,K,20);
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        np=1;
      }
      if(nos>0){
        let q:i32=0;
        while(q<nos){
          let subj:i32=get32(S,q*4);
          set32(C,0,ns2);
          let i2:i32=0;
          while(i2<ns2){
            let sv:i32=get32(W,ni*80+4+(1+i2*3)*4);
            if(sv==0){ sv=subj; }
            set32(C,4+i2*12,sv);
            set32(C,4+i2*12+4,get32(W,ni*80+4+(2+i2*3)*4));
            set32(C,4+i2*12+8,get32(W,ni*80+4+(3+i2*3)*4));
            i2=i2+1;
          }
          let vv2:i32=vfy_gen(A,C,K,20);
          if(vv2==1){
            set32(OUTS,ni*160+4+np*4,subj);
            np=np+1;
          }
          q=q+1;
        }
        set32(OUTS,ni*160,np);
      }
    }
    p=p+1;
  }
  // assemble in plan order
  set32(out,0,0);
  let q2:i32=0;
  while(q2<nn){
    let nj:i32=get32(ord,q2*4);
    let nr:i32=get32(OUTS,nj*160);
    let c0:i32=get32(out,0);
    set32(out,4+c0*4,nr);
    set32(out,0,c0+1);
    let k2:i32=0;
    while(k2<nr){
      let c1:i32=get32(out,0);
      set32(out,4+c1*4,get32(OUTS,nj*160+4+k2*4));
      set32(out,0,c1+1);
      k2=k2+1;
    }
    q2=q2+1;
  }
  return 1;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// digest: sum over records of (1001*len + contents sum)
fn ans_dig(a:[]u8)i32 {
  let n:i32=get32(a,0);
  let i:i32=0;
  let acc:i32=0;
  while(i<n){
    let nr:i32=get32(a,4+i*4);
    acc=acc+1001*nr+nr;
    let k:i32=0;
    while(k<nr){
      acc=acc+get32(a,4+(i+1+k)*4);
      k=k+1;
    }
    i=i+1+nr;
  }
  return acc;
}
// ---- memo baseline -------------------------------------------------
fn memo_find(M:[]u8,tag:i32)i32 {
  let i:i32=0;
  while(i<8){
    if(get32(M,i*260)==tag){ return i; }
    i=i+1;
  }
  return -1;
}
fn memo_put(M:[]u8,slot:i32,tag:i32,ans:[]u8)void {
  let b:i32=slot*260;
  set32(M,b,tag);
  let n:i32=get32(ans,0);
  set32(M,b+4,n);
  let k:i32=0;
  while(k<n){
    set32(M,b+8+k*4,get32(ans,4+k*4));
    k=k+1;
  }
  return;
}
fn memo_get(M:[]u8,slot:i32,out:[]u8)void {
  let b:i32=slot*260;
  let n:i32=get32(M,b+4);
  set32(out,0,n);
  let k:i32=0;
  while(k<n){
    set32(out,4+k*4,get32(M,b+8+k*4));
    k=k+1;
  }
  return;
}// ---- record reordering: map an answer emitted in plan order onto
// need-index order, using the plan's stored step order.
fn ans_reorder(ans:[]u8,pb:[]u8,out:[]u8,nn:i32)void {
  let nrec:i32=get32(pb,4);
  let nb:[]u8=z_alloc(nn*160+16);
  let p:i32=0;
  let done:i32=0;
  while(done<nrec){
    let nr:i32=get32(ans,4+p*4);
    let ni:i32=get32(pb,8+done*12);
    let k:i32=0;
    while(k<nr){
      set32(nb,ni*160+4+k*4,get32(ans,4+(p+1+k)*4));
      k=k+1;
    }
    set32(nb,ni*160,nr);
    p=p+1+nr;
    done=done+1;
  }
  set32(out,0,0);
  let q:i32=0;
  while(q<nn){
    let nr2:i32=get32(nb,q*160);
    let c:i32=get32(out,0);
    set32(out,4+c*4,nr2);
    set32(out,0,c+1);
    let k2:i32=0;
    while(k2<nr2){
      let c2:i32=get32(out,0);
      set32(out,4+c2*4,get32(nb,q*160+4+k2*4));
      set32(out,0,c2+1);
      k2=k2+1;
    }
    q=q+1;
  }
  return;
}
fn rec_sum(a:[]u8,pos:i32)i32 {
  let nr:i32=get32(a,4+pos*4);
  let s:i32=0;
  let k:i32=0;
  while(k<nr){
    s=s+get32(a,4+(pos+1+k)*4);
    k=k+1;
  }
  return s;
}
// ================= P2 OPERAND-SET independent oracle =================
// domref_eval: a straight-line evaluator for the domain-form goal family,
// written ONLY against the frozen generic procedures ret_gen / vfy_gen /
// cnt_gen and the goal record. It shares no plan machinery, no learner
// state, no ordering routine, no descriptor function and no reduction code
// with os_learn.zag or os_arm.zag: the rule semantics are re-derived here
// from PREREG section 2. `rule` is the world's true code, supplied by the
// driver; the goal record's own code is ignored, so this is an oracle for
// ARM B's training goals as well.
//
// A need is a source iff nf==2. A need is a receiver iff nf==2+3*ns.
// Returns 1 and fills `out`, or 0 if the goal is refused.
fn domref_eval(A:[]u8,G:[]u8,rule:i32,K:[]u8,out:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let OUT:[]u8=z_alloc(NM()*160+16);
  let S:[]u8=z_alloc(16*168);
  let D:[]u8=z_alloc(1024);
  let C:[]u8=z_alloc(CHN());
  let seen:[]u8=z_alloc(SNN());
  set32(out,0,0);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,0,OUT,n*160);
    }
    if(nf==3){
      set32(OUT,n*160,1);
      set32(OUT,n*160+4,0);
    }
    if(nf>=5){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==2+ns*3){
            // gather the source tuple in goal link order
            let nsr:i32=0;
            let l:i32=0;
            while(l<nl){
              let k:i32=link_w(G,l,0);
              if(k>=2){
                if(link_w(G,l,1)==n){
                  let sn:i32=link_w(G,l,4);
                  if(nsr<16){
                    let c:i32=get32(OUT,sn*160);
                    let j:i32=0;
                    while(j<c){
                      set32(S,nsr*168+4+j*4,get32(OUT,sn*160+4+j*4));
                      j=j+1;
                    }
                    set32(S,nsr*168,c);
                    nsr=nsr+1;
                  }
                }
              }
              l=l+1;
            }
            // reduce
            let dn:i32=0;
            let i:i32=0;
            if(nsr>0){
              let c0:i32=get32(S,0);
              if(rule==0){
                let s:i32=0;
                while(s<nsr){
                  let c:i32=get32(S,s*168);
                  let j2:i32=0;
                  while(j2<c){
                    let v:i32=get32(S,s*168+4+j2*4);
                    if(ref_dmem(D,dn,v)==0){ set32(D,4+dn*4,v); dn=dn+1; }
                    j2=j2+1;
                  }
                  s=s+1;
                }
              }
              i=0;
              if(rule==1){
                while(i<c0){
                  let v:i32=get32(S,4+i*4);
                  let ok:i32=1;
                  let s:i32=0;
                  while(s<nsr){
                    if(ref_smem(S,s,v)==0){ ok=0; }
                    s=s+1;
                  }
                  if(ok==1){ set32(D,4+dn*4,v); dn=dn+1; }
                  i=i+1;
                }
              }
              i=0;
              if(rule==2){
                while(i<c0){
                  let v:i32=get32(S,4+i*4);
                  let ok:i32=1;
                  let s:i32=1;
                  while(s<nsr){
                    if(ref_smem(S,s,v)==1){ ok=0; }
                    s=s+1;
                  }
                  if(ok==1){ set32(D,4+dn*4,v); dn=dn+1; }
                  i=i+1;
                }
              }
              i=0;
              if(rule==3){
                while(i<c0){
                  let v:i32=get32(S,4+i*4);
                  let ct:i32=0;
                  let s:i32=0;
                  while(s<nsr){
                    if(ref_smem(S,s,v)==1){ ct=ct+1; }
                    s=s+1;
                  }
                  if(ct-(ct/2)*2==1){ set32(D,4+dn*4,v); dn=dn+1; }
                  i=i+1;
                }
              }
            }
            // chain-check every value in the domain
            let np:i32=0;
            if(dn==0){
              ref_chain(G,n,C,-1);
              let vv:i32=vfy_gen(A,C,K,0);
              set32(OUT,n*160,1);
              set32(OUT,n*160+4,vv);
              np=1;
            }
            let q:i32=0;
            while(q<dn){
              let subj:i32=get32(D,4+q*4);
              ref_chain(G,n,C,subj);
              let vv2:i32=vfy_gen(A,C,K,0);
              if(vv2==1){
                if(np<32){ set32(OUT,n*160+4+np*4,subj); }
                np=np+1;
              }
              q=q+1;
            }
            set32(OUT,n*160,np);
          }
        }
      }
    }
    n=n+1;
  }
  // canonical emission: need-index order
  set32(out,0,0);
  let q2:i32=0;
  while(q2<nn){
    let nr:i32=get32(OUT,q2*160);
    let c0:i32=get32(out,0);
    set32(out,4+c0*4,nr);
    set32(out,0,c0+1);
    let k:i32=0;
    while(k<nr){
      let c1:i32=get32(out,0);
      set32(out,4+c1*4,get32(OUT,q2*160+4+k*4));
      set32(out,0,c1+1);
      k=k+1;
    }
    q2=q2+1;
  }
  return 1;
}
fn ref_dmem(D:[]u8,n:i32,v:i32)i32 {
  let j:i32=0;
  let f:i32=0;
  while(j<n){
    if(get32(D,4+j*4)==v){ f=1; }
    j=j+1;
  }
  return f;
}
fn ref_smem(S:[]u8,s:i32,v:i32)i32 {
  let c:i32=get32(S,s*168);
  let j:i32=0;
  let f:i32=0;
  while(j<c){
    if(get32(S,s*168+4+j*4)==v){ f=1; }
    j=j+1;
  }
  return f;
}
// build the receiver's chain directly from the goal record. The chain
// occupies fields 1..3*ns; the rule code is field nf-1 and is ignored.
fn ref_chain(G:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=need_f(G,n,0);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=need_f(G,n,1+i*3);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,need_f(G,n,2+i*3));
    set32(C,4+i*12+8,need_f(G,n,3+i*3));
    i=i+1;
  }
  return;
}
// os_arm.zag -- P2 OPERAND-SET arm layer.
//
// Contains everything that is not the frozen composer: the provenance
// switch, the domain reduction, the ARM B rule-identification procedure,
// and the arm cell block. Concatenated AFTER os_learn.zag; the three
// insertion points in os_learn.zag call into this file.
//
// DISCLOSED DEFECT, restated in source (PREREG section 2, section 9):
// the five rule codes below, and the five-way switch on them, are written
// by the researcher. ARM A reads a code out of the goal record. ARM B does
// not; it *chooses* which of these same codes applies, by testing them
// against verified answers. Because the menu is in this file, ARM B's
// output form is enumerable from source and ARM B is L2, not L3.
//
// No semantic token appears in this file (kill bar C7): the rules are
// stated positionally over "sources" and "values".

// ---------------- arm cell block (inside the learner arena, past its end)
fn arm_c(k:i32)i32 { return l_size()+k; }
fn arm_a(L:[]u8)i32 { return get32(L,arm_c(0)); }
fn arm_b(L:[]u8)i32 { return get32(L,arm_c(4)); }
fn arm_rule(L:[]u8)i32 { return get32(L,arm_c(8)); }
fn arm_red(L:[]u8)i32 { return get32(L,arm_c(12)); }
fn arm_force(L:[]u8)i32 { return get32(L,arm_c(16)); }
fn arm_alive(L:[]u8,r:i32)i32 { return get32(L,arm_c(32+r*4)); }
fn arm_kill(L:[]u8,r:i32)void { set32(L,arm_c(32+r*4),0); return; }
fn arm_nalive(L:[]u8)i32 {
  let n:i32=0;
  let r:i32=0;
  while(r<8){ if(arm_alive(L,r)==1){ n=n+1; } r=r+1; }
  return n;
}
fn arm_only(L:[]u8)i32 {
  let r:i32=0;
  let f:i32=-1;
  while(r<8){
    if(arm_alive(L,r)==1){ f=r; }
    r=r+1;
  }
  return f;
}
// a=1 selects the goal-record provenance; b=1 selects the learned
// provenance (and outranks a); red=0 is the ablation switch; nc=number of
// candidate codes initially alive.
fn arm_init(L:[]u8,a:i32,b:i32,red:i32,nc:i32)void {
  set32(L,arm_c(0),a);
  set32(L,arm_c(4),b);
  set32(L,arm_c(8),-1);
  set32(L,arm_c(12),red);
  set32(L,arm_c(16),-1);
  let r:i32=0;
  while(r<8){
    if(r<nc){ set32(L,arm_c(32+r*4),1); } else { set32(L,arm_c(32+r*4),0); }
    r=r+1;
  }
  return;
}

// ---------------- the provenance switch ------------------------------
// is_dom: a need is in the domain form iff nf == 2 + ns*3 with the chain
// count ns in 1..16. The frozen family-1 shape is nf == 1 + ns*3, so the
// two are disjoint for every ns.
fn is_dom(G:[]u8,n:i32)i32 {
  let nf:i32=need_nf(G,n);
  if(nf<5){ return 0; }
  let ns:i32=need_f(G,n,0);
  if(ns<1){ return 0; }
  if(ns>16){ return 0; }
  if(nf!=2+ns*3){ return 0; }
  return 1;
}
fn dom_rule_in_record(G:[]u8,n:i32)i32 {
  let nf:i32=need_nf(G,n);
  return need_f(G,n,nf-1);
}
// Priority: an explicit forced code (used only by ARM B's hypothesis
// trials, on a scratch learner), then the learned table, then the goal
// record. Returns -1 when no code is available, which makes the need
// unbindable.
fn domrule_of(L:[]u8,G:[]u8,n:i32)i32 {
  if(is_dom(G,n)==0){ return -1; }
  let f:i32=arm_force(L);
  if(f>=0){ return f; }
  if(arm_b(L)==1){ return arm_rule(L); }
  if(arm_a(L)==1){
    let r:i32=dom_rule_in_record(G,n);
    if(r>=0){ if(r<5){ return r; } }
    return -1;
  }
  return -1;
}

// ---------------- the reduction --------------------------------------
// Researcher-authored. The five codes are declared in PREREG section 2.
// Over the m incoming value-consuming links of need ni, in goal link
// order, with A0..A(m-1) the value sets the sources actually produced:
//   0  keep a value produced by AT LEAST ONE source   (the substrate's
//      own behaviour, kept for contrast)
//   1  keep a value produced by EVERY source
//   2  keep a value produced by the FIRST source and by NO later source
//   3  keep a value produced by an ODD number of sources
//   4  keep NO value
// Codes 1..3 scan source 0's order; code 0 scans the assembled list.
fn smem(S:[]u8,s:i32,v:i32)i32 {
  let c:i32=get32(S,s*168);
  let j:i32=0;
  let f:i32=0;
  while(j<c){
    if(get32(S,s*168+4+j*4)==v){ f=1; }
    j=j+1;
  }
  return f;
}
fn dmem(D:[]u8,n:i32,v:i32)i32 {
  let j:i32=0;
  let f:i32=0;
  while(j<n){
    if(get32(D,4+j*4)==v){ f=1; }
    j=j+1;
  }
  return f;
}
fn dom_reduce(G:[]u8,L:[]u8,ni:i32,OUTS:[]u8,SUBL:[]u8,rule:i32)i32 {
  let nl:i32=g_nlinks(G);
  let S:[]u8=z_alloc(16*168);
  let D:[]u8=z_alloc(1024);
  let nsr:i32=0;
  let l:i32=0;
  while(l<nl){
    let k:i32=link_w(G,l,0);
    if(k>=2){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        if(nsr<16){
          let c:i32=get32(OUTS,sn*160);
          let j:i32=0;
          while(j<c){
            set32(S,nsr*168+4+j*4,get32(OUTS,sn*160+4+j*4));
            j=j+1;
          }
          set32(S,nsr*168,c);
          nsr=nsr+1;
        }
      }
    }
    l=l+1;
  }
  let u:i32=get32(SUBL,ni*STK());
  let dn:i32=0;
  let i:i32=0;
  if(rule==4){ dn=0; }
  if(nsr==0){
    while(i<u){ set32(D,4+i*4,get32(SUBL,ni*STK()+4+i*4)); i=i+1; }
    dn=u;
  }
  if(nsr>0){
    let c0:i32=get32(S,0);
    if(rule==0){
      while(i<u){
        let v:i32=get32(SUBL,ni*STK()+4+i*4);
        if(dmem(D,dn,v)==0){ set32(D,4+dn*4,v); dn=dn+1; }
        i=i+1;
      }
    }
    i=0;
    if(rule==1){
      while(i<c0){
        let v:i32=get32(S,4+i*4);
        let ok:i32=1;
        let s:i32=0;
        while(s<nsr){
          if(smem(S,s,v)==0){ ok=0; }
          s=s+1;
        }
        if(ok==1){ set32(D,4+dn*4,v); dn=dn+1; }
        i=i+1;
      }
    }
    i=0;
    if(rule==2){
      while(i<c0){
        let v:i32=get32(S,4+i*4);
        let ok:i32=1;
        let s:i32=1;
        while(s<nsr){
          if(smem(S,s,v)==1){ ok=0; }
          s=s+1;
        }
        if(ok==1){ set32(D,4+dn*4,v); dn=dn+1; }
        i=i+1;
      }
    }
    i=0;
    if(rule==3){
      while(i<c0){
        let v:i32=get32(S,4+i*4);
        let ct:i32=0;
        let s:i32=0;
        while(s<nsr){
          if(smem(S,s,v)==1){ ct=ct+1; }
          s=s+1;
        }
        if(ct-(ct/2)*2==1){ set32(D,4+dn*4,v); dn=dn+1; }
        i=i+1;
      }
    }
  }
  let j2:i32=0;
  while(j2<dn){
    set32(SUBL,ni*STK()+4+j2*4,get32(D,4+j2*4));
    j2=j2+1;
  }
  set32(SUBL,ni*STK(),dn);
  return dn;
}

// ---------------- ARM B: rule identification -------------------------
// The learner is shown a goal record and a VERIFIED DIGEST of the answer,
// never a rule code. For every candidate code still alive it runs the
// composition on a scratch learner with that code forced, and kills the
// candidate if the resulting digest differs from the verified one. The
// surviving set shrinks monotonically, so "consistent with every verified
// answer so far" is exactly the set that remains. When exactly one
// candidate is left it becomes the learner's rule; with zero or several
// the learner has no rule and the goal declines.
fn arm_teach(L:[]u8,A:[]u8,K:[]u8,G:[]u8,vdig:i32,ra:[]u8)void {
  let S:[]u8=z_alloc(l_size()+4096);
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  arm_init(S,0,0,1,0);
  let r:i32=0;
  while(r<8){
    if(arm_alive(L,r)==1){
      set32(S,arm_c(16),r);
      clear_plans(S);
      set32(K,0,0);
      let rr:i32=compose(S,A,G,K,ans,vb,1);
      let d:i32=ans_dig(ans);
      let bad:i32=0;
      if(rr==0){ bad=1; }
      if(bad==0){ if(d!=vdig){ bad=1; } }
      if(bad==1){ arm_kill(L,r); }
    }
    r=r+1;
  }
  set32(L,arm_c(16),-1);
  let na:i32=arm_nalive(L);
  let rl:i32=-1;
  if(na==1){ rl=arm_only(L); }
  set32(L,arm_c(8),rl);
  return;
}// os_main.zag -- P2 OPERAND-SET driver. One `fn main`.
//
// Sections:
//   SEC-0    substrate identity
//   SEC-R    regression of the COMPOSE-DAG battery (kill bar K6)
//   SEC-A    ARM A mechanism (K1,K2,K3)
//   SEC-AB   ARM A ablations AB1 (K5) and AB2 (K4)
//   SEC-B    ARM B rule identification (K7,K8,K10)
//   SEC-BX   ARM B wrong-world control AB4 (K9) and rule-cleared AB3
//   SEC-E    engine vs independent oracle over the whole matrix
//   IITMATRIX / IITCLASS  identifiability battery (K11,K12,K13,K14)
//   DETAIL   reduced domains, value by value
//   SEC-D    baselines B0 / B1 / B2
//   SEC-S    summary counters

fn learn(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,Cb:[]u8,tout:[]u8,dom:i32)i32 {
  let sn:[]u8=z_alloc(SNN());
  let i:i32=0;
  while(i<11){
    p2_ret_pat(i,rb);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    i=i+1;
  }
  i=0;
  while(i<4*dom){
    p2_dom_ret_pat(i,rb);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    i=i+1;
  }
  specialize_ret(L,A,0,10);
  i=0;
  while(i<7){
    p2_vfy_chain(Cb,i);
    vfy_episode(L,A,Cb,K);
    i=i+1;
  }
  i=0;
  while(i<2*dom){
    p2_dom_vfy_chain(Cb,i);
    vfy_episode(L,A,Cb,K);
    i=i+1;
  }
  specialize_vfy(L,A,11,17);
  i=0;
  while(i<4){
    p2_cnt_pat(i,rb);
    cnt_episode(L,A,get32(rb,0),get32(rb,4),K,tout,sn);
    i=i+1;
  }
  i=0;
  while(i<dom){
    p2_dom_cnt_pat(i,rb);
    cnt_episode(L,A,get32(rb,0),get32(rb,4),K,tout,sn);
    i=i+1;
  }
  specialize_cnt(L,A,18,21);
  c=o_app(B,c,"LEARN dom=");
  c=o_i64(B,c,dom as i64);
  c=o_app(B,c," retrel=");
  c=o_i64(B,c,get32(L,0) as i64);
  c=o_app(B,c," vfyrel=");
  c=o_i64(B,c,get32(L,4248) as i64);
  c=o_app(B,c," cntrel=");
  c=o_i64(B,c,get32(L,8496) as i64);
  c=o_app(B,c," facts=");
  c=o_i64(B,c,get32(A,0) as i64);
  c=o_app(B,c," lsize=");
  c=o_i64(B,c,l_size() as i64);
  c=o_nl(B,c);
  return c;
}

// field-compatible with the COMPOSE-DAG driver line: first five fields are
// tag, id, nn, r1, dig.
fn qa(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,admit:i32,tag:[]u8)i32 {
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let ra:[]u8=z_alloc(4096);
  let rb:[]u8=z_alloc(4096);
  let nn:i32=g_nneeds(G);
  clear_plans(L);
  set32(K,0,0);
  let r1:i32=compose(L,A,G,K,ans,vb,admit);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," r1=");
  c=o_i64(B,c,r1 as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_app(B,c," pa=");
  c=o_i64(B,c,get32(vb,20) as i64);
  c=o_app(B,c," pb=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," pl=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," tr=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," vec=");
  c=vfull(B,c,ans,nn);
  set32(K,0,0);
  let ok1:i32=ref_eval(A,G,K,rb,1);
  let eq:i32=0;
  if(r1!=0){ if(ok1==1){ eq=ans_eq(ans,rb); } }
  c=o_app(B,c," refa=");
  c=o_i64(B,c,ok1 as i64);
  c=o_app(B,c," eq=");
  c=o_i64(B,c,eq as i64);
  c=o_nl(B,c);
  return c;
}
// per-record (need, length, sum), the arithmetic-checkable form
fn vsum(B:[]u8,c:i32,a:[]u8,nn:i32)i32 {
  let pos:i32=0;
  let idx:i32=0;
  while(idx<nn){
    let nr:i32=get32(a,4+pos*4);
    c=o_app(B,c," ");
    c=o_i64(B,c,idx as i64);
    c=o_app(B,c,":");
    c=o_i64(B,c,nr as i64);
    c=o_app(B,c,":");
    c=o_i64(B,c,rec_sum(a,pos) as i64);
    pos=pos+1+nr;
    idx=idx+1;
  }
  return c;
}
// every record printed with its values
fn vfull(B:[]u8,c:i32,a:[]u8,nn:i32)i32 {
  let pos:i32=0;
  let idx:i32=0;
  while(idx<nn){
    let nr:i32=get32(a,4+pos*4);
    c=o_app(B,c," ");
    c=o_i64(B,c,idx as i64);
    c=o_app(B,c,":");
    c=o_i64(B,c,nr as i64);
    c=o_app(B,c,"[");
    let k:i32=0;
    while(k<nr){
      if(k>0){ c=o_app(B,c,","); }
      c=o_i64(B,c,get32(a,4+(pos+1+k)*4) as i64);
      k=k+1;
    }
    c=o_app(B,c,"]");
    pos=pos+1+nr;
    idx=idx+1;
  }
  return c;
}
// a domain-form query: engine against the independent oracle
fn dq(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,rule:i32,tag:[]u8)i32 {
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let ra:[]u8=z_alloc(4096);
  let nn:i32=g_nneeds(G);
  clear_plans(L);
  set32(K,0,0);
  let r:i32=compose(L,A,G,K,ans,vb,1);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_app(B,c," pb=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," rec=");
  c=o_i64(B,c,dom_rule_in_record(G,nn-1) as i64);
  c=o_app(B,c," orc=");
  c=o_i64(B,c,rule as i64);
  set32(K,0,0);
  let ok:i32=domref_eval(A,G,rule,K,ra);
  c=o_app(B,c," odig=");
  c=o_i64(B,c,ans_dig(ra) as i64);
  let eq:i32=0;
  if(r!=0){ eq=ans_eq(ans,ra); }
  c=o_app(B,c," eq=");
  c=o_i64(B,c,eq as i64);
  c=o_app(B,c," vec=");
  c=vfull(B,c,ans,nn);
  c=o_app(B,c," vs=");
  c=vsum(B,c,ans,nn);
  c=o_app(B,c," ovec=");
  c=vfull(B,c,ra,nn);
  c=o_app(B,c," ovs=");
  c=vsum(B,c,ra,nn);
  c=o_nl(B,c);
  return c;
}
// ARM B: show the learner one goal plus its verified digest
fn teach(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,vd:i32,tag:[]u8)i32 {
  arm_teach(L,A,K,G,vd,z_alloc(4096));
  let na:i32=arm_nalive(L);
  let rl:i32=arm_rule(L);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," vdig=");
  c=o_i64(B,c,vd as i64);
  c=o_app(B,c," surv=");
  c=o_i64(B,c,na as i64);
  c=o_app(B,c," {");
  let r:i32=0;
  while(r<8){
    if(arm_alive(L,r)==1){
      c=o_i64(B,c,r as i64);
      c=o_app(B,c,",");
    }
    r=r+1;
  }
  c=o_app(B,c,"} rule=");
  c=o_i64(B,c,rl as i64);
  c=o_nl(B,c);
  return c;
}
// engine forced to a candidate code, on a scratch learner
fn qf(B:[]u8,c:i32,A:[]u8,K:[]u8,G:[]u8,id:i32,rule:i32,tag:[]u8)i32 {
  let S:[]u8=z_alloc(l_size()+4096);
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let ra:[]u8=z_alloc(4096);
  arm_init(S,0,0,1,0);
  clear_plans(S);
  set32(S,arm_c(16),rule);
  set32(K,0,0);
  let r:i32=compose(S,A,G,K,ans,vb,1);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," force=");
  c=o_i64(B,c,rule as i64);
  c=o_app(B,c," r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  set32(K,0,0);
  domref_eval(A,G,rule,K,ra);
  c=o_app(B,c," odig=");
  c=o_i64(B,c,ans_dig(ra) as i64);
  let eq:i32=0;
  if(r!=0){ eq=ans_eq(ans,ra); }
  c=o_app(B,c," eq=");
  c=o_i64(B,c,eq as i64);
  c=o_app(B,c," vec=");
  c=vfull(B,c,ans,g_nneeds(G));
  c=o_app(B,c," vs=");
  c=vsum(B,c,ans,g_nneeds(G));
  c=o_nl(B,c);
  return c;
}
// ---- baselines, copied from the COMPOSE-DAG driver -------------------
fn fact_small(n:i32)i32 {
  let f:i32=1;
  let i:i32=2;
  while(i<=n){ f=f*i; i=i+1; }
  return f;
}
fn perm_unrank(n:i32,code:i32,out:[]u8,used:[]u8)void {
  let i:i32=0;
  while(i<n){ set32(used,i*4,1); i=i+1; }
  let c:i32=code;
  let pos:i32=0;
  let f:i32=fact_small(n-1);
  while(pos<n){
    let k:i32=0;
    if(f>0){ k=c/f; }
    let cnt:i32=0;
    let pick:i32=0;
    let j:i32=0;
    while(j<n){
      if(get32(used,j*4)==1){
        if(cnt==k){ pick=j; }
        cnt=cnt+1;
      }
      j=j+1;
    }
    set32(out,pos*4,pick);
    set32(used,pick*4,0);
    c=c-k*f;
    if(f>0){ f=f/(n-pos); }
    pos=pos+1;
  }
  return;
}
fn exh_run(A:[]u8,G:[]u8,K:[]u8,L0:[]u8,order:[]u8,fams:[]u8,ans:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,ver:[]u8)void {
  let nn:i32=g_nneeds(G);
  mat_inputs(G,W);
  let n:i32=0;
  while(n<nn){ set32(OUTS,n*160,0); n=n+1; }
  let d:[]u8=z_alloc(32);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(order,p*4);
    shape_desc(G,ni,d);
    let af:i32=get32(fams,ni*4);
    let want:i32=d_fam(d);
    if(d_acc(d)==1){ if(af==want){ exec_need(L0,A,G,ni,af,K,W,OUTS,SUBL,C,seen,ver); } }
    p=p+1;
  }
  set32(ans,0,0);
  let q:i32=0;
  while(q<nn){
    let nr:i32=get32(OUTS,q*160);
    let c:i32=get32(ans,0);
    set32(ans,4+c*4,nr);
    set32(ans,0,c+1);
    let k:i32=0;
    while(k<nr){
      let c2:i32=get32(ans,0);
      set32(ans,4+(c2*4),get32(OUTS,q*160+4+k*4));
      set32(ans,0,c2+1);
      k=k+1;
    }
    q=q+1;
  }
  return;
}
fn exh(B:[]u8,c:i32,A:[]u8,K:[]u8,G:[]u8,id:i32,cap:i32,target:i32,tag:[]u8,arma:i32)i32 {
  let nn:i32=g_nneeds(G);
  let L0:[]u8=z_alloc(l_size()+4096);
  arm_init(L0,arma,0,1,5);
  let order:[]u8=z_alloc(NM()*4+8);
  let fams:[]u8=z_alloc(NM()*4+8);
  let ans:[]u8=z_alloc(1024);
  let W:[]u8=z_alloc(NM()*80+16);
  let OUTS:[]u8=z_alloc(NM()*160+16);
  let SUBL:[]u8=z_alloc(NM()*STK()+16);
  let C:[]u8=z_alloc(CHN());
  let seen:[]u8=z_alloc(SNN());
  let ver:[]u8=z_alloc(8);
  let used:[]u8=z_alloc(NM()+16);
  let np:i32=fact_small(nn);
  let nf:i32=1;
  let i:i32=0;
  while(i<nn){ nf=nf*3; i=i+1; }
  let total:i64=(np as i64)*(nf as i64);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," ARMA=");
  c=o_i64(B,c,arma as i64);
  c=o_app(B,c," space=");
  c=o_i64(B,c,total);
  let limit:i64=cap as i64;
  let complete:i32=0;
  if(total<cl_i64(cap)){ limit=total; complete=1; }
  let tries:i32=0;
  let found:i32=0;
  let t:i64=0;
  while(t<limit){
    let ti:i32=t as i32;
    let pcode:i32=ti%np;
    let fcode:i32=(ti/np)%nf;
    perm_unrank(nn,pcode,order,used);
    let j:i32=0;
    while(j<nn){
      let v:i32=fcode%3;
      set32(fams,j*4,v);
      fcode=fcode/3;
      j=j+1;
    }
    set32(K,0,0);
    exh_run(A,G,K,L0,order,fams,ans,W,OUTS,SUBL,C,seen,ver);
    tries=tries+1;
    if(ans_dig(ans)==target){ found=1; }
    t=t+1;
  }
  c=o_app(B,c," tries=");
  c=o_i64(B,c,tries as i64);
  c=o_app(B,c," complete=");
  c=o_i64(B,c,complete as i64);
  c=o_app(B,c," found=");
  c=o_i64(B,c,found as i64);
  c=o_nl(B,c);
  return c;
}
fn cl_i64(v:i32)i64 { return v as i64; }
fn memo_run(B:[]u8,c:i32,M:[]u8,A:[]u8,K:[]u8,L:[]u8,G:[]u8,id:i32)i32 {
  let gt:i32=g_tag(G);
  let slot:i32=memo_find(M,gt);
  set32(K,0,0);
  if(slot>=0){
    let out:[]u8=z_alloc(1024);
    memo_get(M,slot,out);
    c=o_app(B,c,"MEMO id=");
    c=o_i64(B,c,id as i64);
    c=o_app(B,c," hit=1 dig=");
    c=o_i64(B,c,ans_dig(out) as i64);
    c=o_app(B,c," k=");
    c=o_i64(B,c,get32(K,0) as i64);
    c=o_nl(B,c);
    return c;
  }
  let ans:[]u8=z_alloc(1024);
  let vb:[]u8=z_alloc(64);
  clear_plans(L);
  let r:i32=compose(L,A,G,K,ans,vb,1);
  let ms:i32=memo_free(M);
  if(ms>=0){ memo_put(M,ms,gt,ans); }
  c=o_app(B,c,"MEMO id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," hit=0 r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_nl(B,c);
  return c;
}
fn memo_free(M:[]u8)i32 {
  let i:i32=0;
  while(i<12){
    if(get32(M,i*260)==0){ return i; }
    i=i+1;
  }
  return -1;
}
// ---- IIT bookkeeping -------------------------------------------------
// DG[i*8+r] = digest of item i under code r. Codes 5 and 6 are declared to
// coincide with 0 and 1 on every presented goal (PREREG section 8).
// dgo is the BYTE offset: 8 codes per item, 4 bytes per cell.
fn dgo(i:i32,r:i32)i32 { return i*32+r*4; }
fn dg_build(A:[]u8,K:[]u8,G:[]u8,DG:[]u8)i32 {
  let ra:[]u8=z_alloc(4096);
  let i:i32=0;
  while(i<4){
    if(i==0){ gdom(G,944,0,1); }
    if(i==1){ gdom(G,945,0,2); }
    if(i==2){ gdom(G,946,0,3); }
    if(i==3){ gdom(G,941,0,4); }
    let r:i32=0;
    while(r<7){
      let rr:i32=r;
      if(rr==5){ rr=0; }
      if(rr==6){ rr=1; }
      set32(K,0,0);
      domref_eval(A,G,rr,K,ra);
      set32(DG,dgo(i,r),ans_dig(ra));
      r=r+1;
    }
    i=i+1;
  }
  return 4;
}
// survivors of a declared class over an evidence prefix
fn hsurv(DG:[]u8,cls:[]u8,nc:i32,nit:i32,vd:[]u8)i32 {
  let j:i32=0;
  let n:i32=0;
  while(j<nc){
    let r:i32=get32(cls,j*4);
    let ok:i32=1;
    let i:i32=0;
    while(i<nit){
      if(get32(DG,dgo(i,r))!=get32(vd,i*4)){ ok=0; }
      i=i+1;
    }
    if(ok==1){ n=n+1; }
    j=j+1;
  }
  return n;
}
fn ndistinct(v:[]u8,n:i32)i32 {
  let d:i32=0;
  let i:i32=0;
  while(i<n){
    let f:i32=0;
    let j:i32=0;
    while(j<i){
      if(get32(v,j*4)==get32(v,i*4)){ f=1; }
      j=j+1;
    }
    if(f==0){ d=d+1; }
    i=i+1;
  }
  return d;
}
fn largest(v:[]u8,n:i32)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    let ct:i32=0;
    let j:i32=0;
    while(j<n){
      if(get32(v,j*4)==get32(v,i*4)){ ct=ct+1; }
      j=j+1;
    }
    if(ct>m){ m=ct; }
    i=i+1;
  }
  return m;
}

fn main()i32 {
  let B:[]u8=z_alloc(1048576);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(l_size()+4096);
  let A1:[]u8=world_new();
  let A2:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(4096);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let M:[]u8=z_alloc(3200);
  let DG:[]u8=z_alloc(256);
  let acc:[]u8=z_alloc(64);
  let vd:[]u8=z_alloc(16);
  p2_world(A1);
  p2_world(A2);
  dom_world(A2);

  // ---------------- SEC-0
  c=o_app(B,c,"== SEC-0 substrate =="); c=o_nl(B,c);
  c=o_app(B,c,"ARMA/ARMB/RED off; lsize=");
  c=o_i64(B,c,l_size() as i64);
  c=o_app(B,c," armcells=");
  c=o_i64(B,c,(4096-l_size()) as i64);
  c=o_app(B,c," worldfacts=");
  c=o_i64(B,c,get32(A1,0) as i64);
  c=o_app(B,c," worldfacts_dom=");
  c=o_i64(B,c,get32(A2,0) as i64);
  c=o_nl(B,c);
  c=learn(B,c,L,A1,K,rb,Cb,tout,0);
  arm_init(L,0,0,1,0);

  // ---------------- SEC-R regression
  c=o_app(B,c,"== SEC-R COMPOSE-DAG regression, ARMA=0 ARMB=0 =="); c=o_nl(B,c);
  g901(G);        c=qa(B,c,L,A1,K,G,1,1,"A");
  g902(G);        c=qa(B,c,L,A1,K,G,2,1,"A");
  g906(G);        c=qa(B,c,L,A1,K,G,6,1,"A");
  gbro(G,907,3,912,3000);  c=qa(B,c,L,A1,K,G,7,1,"A");
  gbro(G,908,2,912,3000);  c=qa(B,c,L,A1,K,G,8,1,"A");
  g909(G);        c=qa(B,c,L,A1,K,G,9,1,"A");
  g910(G);        c=qa(B,c,L,A1,K,G,10,1,"A");
  g911(G);        c=qa(B,c,L,A1,K,G,11,1,"A");
  g912(G);        c=qa(B,c,L,A1,K,G,12,1,"A");
  g913(G);        c=qa(B,c,L,A1,K,G,13,1,"A");
  g914(G);        c=qa(B,c,L,A1,K,G,14,1,"A");
  g915(G);        c=qa(B,c,L,A1,K,G,15,1,"A");
  g916(G);        c=qa(B,c,L,A1,K,G,16,1,"A");
  g917(G);        c=qa(B,c,L,A1,K,G,17,1,"A");
  g918(G);        c=qa(B,c,L,A1,K,G,18,1,"A");
  g919(G);        c=qa(B,c,L,A1,K,G,19,1,"A");
  gseq(G,920,2);  c=qa(B,c,L,A1,K,G,20,1,"A");
  gseq(G,921,3);  c=qa(B,c,L,A1,K,G,21,1,"A");
  gseq(G,922,5);  c=qa(B,c,L,A1,K,G,22,1,"A");
  gseq(G,923,10); c=qa(B,c,L,A1,K,G,23,1,"A");
  gseq(G,924,20); c=qa(B,c,L,A1,K,G,24,1,"A");

  // the domain relations are experienced and indexed before any domain-form
  // goal is presented, so the warm engine can specialise exactly as the
  // COMPOSE-DAG battery does.
  c=learn(B,c,L,A2,K,rb,Cb,tout,1);

  // ---------------- SEC-A ARM A mechanism
  c=o_app(B,c,"== SEC-A ARM A mechanism, ARMA=1 ARMB=0 =="); c=o_nl(B,c);
  arm_init(L,1,0,1,0);
  gdom(G,930,1,2); c=dq(B,c,L,A2,K,G,30,1,"A-armA");
  gdom(G,931,2,3); c=dq(B,c,L,A2,K,G,31,2,"A-armA");
  gdom(G,932,3,3); c=dq(B,c,L,A2,K,G,32,3,"A-armA");
  gdom(G,930,0,3); c=dq(B,c,L,A2,K,G,33,0,"A-armA");
  gdom(G,933,4,3); c=dq(B,c,L,A2,K,G,34,4,"A-armA");
  gdom(G,942,1,4); c=dq(B,c,L,A2,K,G,40,1,"A-armA");

  // ---------------- SEC-AB ablations
  c=o_app(B,c,"== SEC-AB1 domain form absent, ARMA=0 ARMB=0 =="); c=o_nl(B,c);
  arm_init(L,0,0,1,0);
  gdom(G,930,1,2); c=dq(B,c,L,A2,K,G,30,1,"AB1-absent");
  gdom(G,931,2,3); c=dq(B,c,L,A2,K,G,31,2,"AB1-absent");
  gdom(G,932,3,3); c=dq(B,c,L,A2,K,G,32,3,"AB1-absent");
  gdom(G,930,0,3); c=dq(B,c,L,A2,K,G,33,0,"AB1-absent");
  gdom(G,933,4,3); c=dq(B,c,L,A2,K,G,34,4,"AB1-absent");
  c=o_app(B,c,"== SEC-AB2 shape accepted, reduction disabled, ARMA=1 RED=0 =="); c=o_nl(B,c);
  arm_init(L,1,0,0,0);
  gdom(G,930,1,2); c=dq(B,c,L,A2,K,G,30,1,"AB2-noreduce");
  gdom(G,931,2,3); c=dq(B,c,L,A2,K,G,31,2,"AB2-noreduce");
  gdom(G,932,3,3); c=dq(B,c,L,A2,K,G,32,3,"AB2-noreduce");
  gdom(G,930,0,3); c=dq(B,c,L,A2,K,G,33,0,"AB2-noreduce");
  gdom(G,933,4,3); c=dq(B,c,L,A2,K,G,34,4,"AB2-noreduce");
  arm_init(L,1,0,1,0);

  // ---------------- SEC-B ARM B
  c=o_app(B,c,"== SEC-B ARM B identification, ARMA=0 ARMB=1 =="); c=o_nl(B,c);
  arm_init(L,0,1,1,5);
  gdom(G,944,0,1); c=teach(B,c,L,A2,K,G,44,46130,"B1-teach");
  gdom(G,941,0,4); c=dq(B,c,L,A2,K,G,41,1,"B2-heldout-underdetermined");
  gdom(G,945,0,2); c=teach(B,c,L,A2,K,G,45,57725,"B3-teach");
  gdom(G,946,0,3); c=teach(B,c,L,A2,K,G,46,76245,"B4-teach");
  gdom(G,941,0,4); c=dq(B,c,L,A2,K,G,41,1,"B5-heldout-identified");
  c=o_app(B,c,"AB3 rule table cleared, same held-out goal:"); c=o_nl(B,c);
  set32(L,arm_c(8),-1);
  gdom(G,941,0,4); c=dq(B,c,L,A2,K,G,41,1,"AB3-noRule");

  c=o_app(B,c,"== SEC-B6 fresh learner, same stream =="); c=o_nl(B,c);
  let L2:[]u8=z_alloc(l_size()+4096);
  arm_init(L2,0,1,1,5);
  gdom(G,944,0,1); c=teach(B,c,L2,A2,K,G,44,46130,"B6-teach");
  gdom(G,941,0,4); c=dq(B,c,L2,A2,K,G,41,1,"B6-heldout-underdetermined");
  gdom(G,945,0,2); c=teach(B,c,L2,A2,K,G,45,57725,"B6-teach");
  gdom(G,946,0,3); c=teach(B,c,L2,A2,K,G,46,76245,"B6-teach");
  gdom(G,941,0,4); c=dq(B,c,L2,A2,K,G,41,1,"B6-heldout-identified");

  c=o_app(B,c,"== SEC-B7 wrong-world control, evidence from world code 0 =="); c=o_nl(B,c);
  let L3:[]u8=z_alloc(l_size()+4096);
  arm_init(L3,0,1,1,5);
  gdom(G,944,0,1); c=teach(B,c,L3,A2,K,G,44,46130,"B7-teach-w0");
  gdom(G,945,0,2); c=teach(B,c,L3,A2,K,G,45,69245,"B7-teach-w0");
  gdom(G,946,0,3); c=teach(B,c,L3,A2,K,G,46,92380,"B7-teach-w0");
  gdom(G,941,0,4); c=dq(B,c,L3,A2,K,G,41,1,"B7-heldout-wrongworld");

  // ---------------- SEC-E engine vs oracle matrix
  c=o_app(B,c,"== SEC-E engine vs independent oracle over the rule matrix =="); c=o_nl(B,c);
  let it:i32=0;
  while(it<4){
    if(it==0){ gdom(G,944,0,1); }
    if(it==1){ gdom(G,945,0,2); }
    if(it==2){ gdom(G,946,0,3); }
    if(it==3){ gdom(G,941,0,4); }
    let rr:i32=0;
    while(rr<5){
      c=qf(B,c,A2,K,G,40+it,rr,"E");
      rr=rr+1;
    }
    it=it+1;
  }

  // ---------------- IITMATRIX
  dg_build(A2,K,G,DG);
  c=o_app(B,c,"== DGRAW digest matrix, 4 items x 7 codes =="); c=o_nl(B,c);
  let dz:i32=0;
  while(dz<4){
    c=o_app(B,c,"DGRAW item=");
    c=o_i64(B,c,dz as i64);
    c=o_app(B,c," d=");
    let dz2:i32=0;
    while(dz2<7){
      c=o_i64(B,c,get32(DG,dgo(dz,dz2)) as i64);
      c=o_app(B,c,",");
      dz2=dz2+1;
    }
    c=o_nl(B,c);
    dz=dz+1;
  }
  c=o_app(B,c,"== IITMATRIX world transcripts, 5 worlds x 3 evidence prefixes =="); c=o_nl(B,c);
  let w:i32=0;
  while(w<5){
    set32(acc,0*4,0);
    set32(acc,1*4,0);
    set32(acc,2*4,0);
    let p:i32=0;
    let run:i32=0;
    while(p<3){
      run=run+(p+1)*get32(DG,dgo(p,w));
      set32(acc,p*4,run);
      p=p+1;
    }
    c=o_app(B,c,"IITMATRIX w=");
    c=o_i64(B,c,w as i64);
    c=o_app(B,c," d1=");
    c=o_i64(B,c,get32(DG,dgo(0,w)) as i64);
    c=o_app(B,c," d2=");
    c=o_i64(B,c,get32(DG,dgo(1,w)) as i64);
    c=o_app(B,c," d3=");
    c=o_i64(B,c,get32(DG,dgo(2,w)) as i64);
    c=o_app(B,c," E1=");
    c=o_i64(B,c,get32(acc,0) as i64);
    c=o_app(B,c," E2=");
    c=o_i64(B,c,get32(acc,1*4) as i64);
    c=o_app(B,c," E3=");
    c=o_i64(B,c,get32(acc,2*4) as i64);
    c=o_nl(B,c);
    w=w+1;
  }
  let pi:i32=1;
  while(pi<4){
    let t:i32=0;
    while(t<5){ set32(acc,t*4,0); t=t+1; }
    w=0;
    while(w<5){
      set32(acc,w*4,0);
      let p2:i32=0;
      let r2:i32=0;
      while(p2<pi){
        r2=r2+(p2+1)*get32(DG,dgo(p2,w));
        p2=p2+1;
      }
      set32(acc,w*4,r2);
      w=w+1;
    }
    c=o_app(B,c,"IITMATRIX prefix=");
    c=o_i64(B,c,pi as i64);
    c=o_app(B,c," distinct=");
    c=o_i64(B,c,ndistinct(acc,5) as i64);
    c=o_app(B,c," largestclass=");
    c=o_i64(B,c,largest(acc,5) as i64);
    c=o_nl(B,c);
    pi=pi+1;
  }

  // ---------------- IITCLASS
  c=o_app(B,c,"== IITCLASS survivors of three declared classes =="); c=o_nl(B,c);
  let H1:[]u8=z_alloc(64);
  let H2:[]u8=z_alloc(64);
  let H3:[]u8=z_alloc(64);
  set32(H1,0,0); set32(H1,4,1); set32(H1,8,2); set32(H1,12,3); set32(H1,16,4);
  set32(H2,0,0); set32(H2,4,1); set32(H2,8,2); set32(H2,12,3);
  set32(H3,0,0); set32(H3,4,1); set32(H3,8,2); set32(H3,12,3); set32(H3,16,5); set32(H3,20,6);
  let V1:[]u8=z_alloc(16);
  set32(V1,0,46130); set32(V1,4,57725); set32(V1,8,76245); set32(V1,12,93482);
  let V0:[]u8=z_alloc(16);
  set32(V0,0,46130); set32(V0,4,69245); set32(V0,8,92380); set32(V0,12,115545);
  let cl:i32=0;
  while(cl<3){
    let cls:[]u8=H1;
    let nc:i32=5;
    if(cl==1){ cls=H2; nc=4; }
    if(cl==2){ cls=H3; nc=6; }
    let nit:i32=1;
    while(nit<4){
      let s1:i32=hsurv(DG,cls,nc,nit,V1);
      let s0:i32=hsurv(DG,cls,nc,nit,V0);
      c=o_app(B,c,"IITCLASS H");
      c=o_i64(B,c,(cl+1) as i64);
      c=o_app(B,c," nc=");
      c=o_i64(B,c,nc as i64);
      c=o_app(B,c," nitems=");
      c=o_i64(B,c,nit as i64);
      c=o_app(B,c," surv_world1=");
      c=o_i64(B,c,s1 as i64);
      c=o_app(B,c," surv_world0=");
      c=o_i64(B,c,s0 as i64);
      let v1:i32=0;
      if(s1==1){ v1=1; }
      let v0:i32=0;
      if(s0==1){ v0=1; }
      c=o_app(B,c," verdict_world1=");
      c=o_i64(B,c,v1 as i64);
      c=o_app(B,c," verdict_world0=");
      c=o_i64(B,c,v0 as i64);
      c=o_nl(B,c);
      nit=nit+1;
    }
    cl=cl+1;
  }

  // ---------------- DETAIL: reduced domains value by value
  c=o_app(B,c,"== DETAIL reduced domain per (goal, rule) =="); c=o_nl(B,c);
  let gg:i32=0;
  while(gg<4){
    if(gg==0){ gdom(G,930,0,2); }
    if(gg==1){ gdom(G,930,0,3); }
    if(gg==2){ gdom(G,930,0,4); }
    if(gg==3){ gdom(G,945,0,2); }
    let rr2:i32=0;
    while(rr2<5){
      c=qf(B,c,A2,K,G,70+gg,rr2,"DETAIL");
      rr2=rr2+1;
    }
    gg=gg+1;
  }

  // ---------------- SEC-D baselines
  c=o_app(B,c,"== SEC-D0 memo baseline =="); c=o_nl(B,c);
  arm_init(L,1,0,1,0);
  let i:i32=0;
  while(i<12){ set32(M,i*260,0); i=i+1; }
  gdom(G,930,1,2); c=memo_run(B,c,M,A2,K,L,G,201);
  gdom(G,930,1,2); c=memo_run(B,c,M,A2,K,L,G,202);
  gdom(G,930,0,3); c=memo_run(B,c,M,A2,K,L,G,203);
  gdom(G,930,0,3); c=one(B,c,L,A2,K,G,204,"D1-composer-930-c");
  c=o_app(B,c,"== SEC-D1 exhaustive baseline over the frozen repertoire =="); c=o_nl(B,c);
  gdom(G,930,1,2); c=exh(B,c,A2,K,G,301,40000,57725,"EXH",1);
  gdom(G,930,1,2); c=exh(B,c,A2,K,G,302,40000,57725,"EXH",0);
  gdom(G,941,0,4); c=exh(B,c,A2,K,G,303,40000,93482,"EXH",1);
  gdom(G,941,0,4); c=exh(B,c,A2,K,G,304,40000,93482,"EXH",0);
  c=o_app(B,c,"== SEC-D2 generic-only baseline =="); c=o_nl(B,c);
  arm_init(L,1,0,1,0);
  gdom(G,930,1,2); c=one(B,c,L,A2,K,G,401,"D2-warm-30");
  gdom(G,941,0,4); c=one(B,c,L,A2,K,G,402,"D2-warm-41");
  ret_cov_clear(L);
  vfy_cov_clear(L);
  cnt_cov_clear(L);
  gdom(G,930,1,2); c=one(B,c,L,A2,K,G,403,"D2-lin-30");
  gdom(G,941,0,4); c=one(B,c,L,A2,K,G,404,"D2-lin-41");
  c=learn(B,c,L,A2,K,rb,Cb,tout,1);
  c=o_app(B,c,"== SEC-S learner counters =="); c=o_nl(B,c);
  c=o_app(B,c,"ARMSUM pb=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," pl=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," tr=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,13252) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,13256) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,13268) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,13272) as i64);
  c=o_app(B,c," ARMA=");
  c=o_i64(B,c,arm_a(L) as i64);
  c=o_app(B,c," ARMB=");
  c=o_i64(B,c,arm_b(L) as i64);
  c=o_app(B,c," rule=");
  c=o_i64(B,c,arm_rule(L) as i64);
  c=o_app(B,c," red=");
  c=o_i64(B,c,arm_red(L) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
// minimal one-shot query printer for the baselines
fn one(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,tag:[]u8)i32 {
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let nn:i32=g_nneeds(G);
  clear_plans(L);
  set32(K,0,0);
  let r:i32=compose(L,A,G,K,ans,vb,1);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_app(B,c," vec=");
  c=vfull(B,c,ans,nn);
  c=o_nl(B,c);
  return c;
}
// un_driver.zag -- Battery driver for the unified composition mechanism.
//
// Same 6 tests as the comparative battery (frozen protocol), including
// co-use episodes so the type-15 history predicate has input:
//   T1: 3-structure (X+Y+W -> Z)
//   T2a: 4-structure (X+Y+W+V -> Z)
//   T2b: 5-structure (X+Y+W+V+U -> Z)
//   T3: Cross-domain (chain X + single-hop Y -> Z)
//   T4: Partial applicability (X 75% useful -> Z)
//   T5: Without expected-answer (expected=-1)
//
// Each test: fresh workspace, train components, co-use episodes, gap,
// Z facts, query Z.
// Output markers: T1-ANS, T2A-ANS, etc. for easy parsing.

// ---- instrumentation ----
fn cmp_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cmp_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cmp_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn cmp_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// ---- T1: 3-structure with co-use episodes ----
// X: plen-2 r1 (11->12->13), Y: plen-2 r2 (21->22->23), W: plen-2 r3 (31->32->33)
// Episodes: X->Y (41-45), Y->W (51-55). Z: plen-6 (101-107), rel 70.
fn t1_train(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  emit("T1-X ans="); e64(x); cmp_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("T1-Y ans="); e64(y); cmp_tstat(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let w:i32=ev_query(W,31,73,33,0);
  emit("T1-W ans="); e64(w); cmp_tstat(W);
  emit("T1 maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t1_couse(W:[]u8)void {
  // Episode X->Y: 41->42->43 (r1), 43->44->45 (r2)
  ev_teach(W,41,1,42); ev_teach(W,42,1,43);
  ev_teach(W,43,2,44); ev_teach(W,44,2,45);
  let a1:i32=ev_cq(W,41,71,43,0,0);
  let a2:i32=ev_cq(W,43,72,45,0,1);
  emit("T1-EPXY a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  // Episode Y->W: 51->52->53 (r2), 53->54->55 (r3)
  ev_teach(W,51,2,52); ev_teach(W,52,2,53);
  ev_teach(W,53,3,54); ev_teach(W,54,3,55);
  let b1:i32=ev_cq(W,51,72,53,0,0);
  let b2:i32=ev_cq(W,53,73,55,0,1);
  emit("T1-EPYW b1="); e64(b1); emit(" b2="); e64(b2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  return;
}
fn t1_test(W:[]u8)void {
  emit("=== T1-3STRUCT ===\n");
  t1_train(W);
  t1_couse(W);
  cmp_gap(W);
  t1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("T1-ANS="); e64(z); cmp_tstat(W);
  emit("T1-COUSE15-POST="); e64(cmp_count15(W)); emit("\n");
  if(z==107){emit("T1-RESULT=PASS\n");} else {emit("T1-RESULT=FAIL\n");}
  return;
}

// ---- T2a: 4-structure ----
// Add V: plen-2 r4 (61->62->63). Episode W->V. Z: plen-8 (101-109).
fn t2a_train(W:[]u8)void {
  t1_train(W);
  ev_teach(W,61,4,62); ev_teach(W,62,4,63);
  let v:i32=ev_query(W,61,74,63,0);
  emit("T2A-V ans="); e64(v); cmp_tstat(W);
  emit("T2A maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t2a_couse(W:[]u8)void {
  t1_couse(W);
  // Episode W->V: 71->72->73 (r3), 73->74->75 (r4)
  ev_teach(W,71,3,72); ev_teach(W,72,3,73);
  ev_teach(W,73,4,74); ev_teach(W,74,4,75);
  let c1:i32=ev_cq(W,71,73,73,0,0);
  let c2:i32=ev_cq(W,73,74,75,0,1);
  emit("T2A-EPWV c1="); e64(c1); emit(" c2="); e64(c2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t2a_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  ev_teach(W,107,4,108); ev_teach(W,108,4,109);
  return;
}
fn t2a_test(W:[]u8)void {
  emit("=== T2A-4STRUCT ===\n");
  t2a_train(W);
  t2a_couse(W);
  cmp_gap(W);
  t2a_zfacts(W);
  let z:i32=ev_query(W,101,70,109,0);
  emit("T2A-ANS="); e64(z); cmp_tstat(W);
  emit("T2A-COUSE15-POST="); e64(cmp_count15(W)); emit("\n");
  if(z==109){emit("T2A-RESULT=PASS\n");} else {emit("T2A-RESULT=FAIL\n");}
  return;
}

// ---- T2b: 5-structure ----
// Add U: plen-2 r5 (81->82->83). Episode V->U. Z: plen-10 (101-111).
fn t2b_train(W:[]u8)void {
  t2a_train(W);
  ev_teach(W,81,5,82); ev_teach(W,82,5,83);
  let u:i32=ev_query(W,81,75,83,0);
  emit("T2B-U ans="); e64(u); cmp_tstat(W);
  emit("T2B maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t2b_couse(W:[]u8)void {
  t2a_couse(W);
  // Episode V->U: 91->92->93 (r4), 93->94->95 (r5)
  ev_teach(W,91,4,92); ev_teach(W,92,4,93);
  ev_teach(W,93,5,94); ev_teach(W,94,5,95);
  let d1:i32=ev_cq(W,91,74,93,0,0);
  let d2:i32=ev_cq(W,93,75,95,0,1);
  emit("T2B-EPVU d1="); e64(d1); emit(" d2="); e64(d2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t2b_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  ev_teach(W,107,4,108); ev_teach(W,108,4,109);
  ev_teach(W,109,5,110); ev_teach(W,110,5,111);
  return;
}
fn t2b_test(W:[]u8)void {
  emit("=== T2B-5STRUCT ===\n");
  t2b_train(W);
  t2b_couse(W);
  cmp_gap(W);
  t2b_zfacts(W);
  let z:i32=ev_query(W,101,70,111,0);
  emit("T2B-ANS="); e64(z); cmp_tstat(W);
  emit("T2B-COUSE15-POST="); e64(cmp_count15(W)); emit("\n");
  if(z==111){emit("T2B-RESULT=PASS\n");} else {emit("T2B-RESULT=FAIL\n");}
  return;
}

// ---- T3: Cross-domain ----
// X: plen-3 chain r1 (11->12->13->14). Y: single-hop r5 (21->22).
// Episode X->Y. Z: chain then hop (101->102->103->104 r1, 104->105 r5).
fn t3_train(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query(W,11,71,14,0);
  emit("T3-X ans="); e64(x); cmp_tstat(W);
  ev_teach(W,21,5,22);
  let y:i32=ev_query(W,21,72,22,0);
  emit("T3-Y ans="); e64(y); cmp_tstat(W);
  emit("T3 maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t3_couse(W:[]u8)void {
  // Episode X->Y: 41->42->43->44 (r1), 44->45 (r5)
  ev_teach(W,41,1,42); ev_teach(W,42,1,43); ev_teach(W,43,1,44);
  ev_teach(W,44,5,45);
  let a1:i32=ev_cq(W,41,71,44,0,0);
  let a2:i32=ev_cq(W,44,72,45,0,1);
  emit("T3-EPXY a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t3_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,5,105);
  return;
}
fn t3_test(W:[]u8)void {
  emit("=== T3-XDOMAIN ===\n");
  t3_train(W);
  t3_couse(W);
  cmp_gap(W);
  t3_zfacts(W);
  let z:i32=ev_query(W,101,70,105,0);
  emit("T3-ANS="); e64(z); cmp_tstat(W);
  emit("T3-COUSE15-POST="); e64(cmp_count15(W)); emit("\n");
  if(z==105){emit("T3-RESULT=PASS\n");} else {emit("T3-RESULT=FAIL\n");}
  return;
}

// ---- T4: Partial applicability ----
// X: plen-4 r1 (11-15). Y: plen-2 r2 (21->22->23). Z needs 3 of X + Y.
// Episode X->Y (full X, but Z uses partial).
fn t4_train(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,71,15,0);
  emit("T4-X ans="); e64(x); cmp_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("T4-Y ans="); e64(y); cmp_tstat(W);
  emit("T4 maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t4_couse(W:[]u8)void {
  // Episode X->Y: 41->42->43->44->45 (r1), 45->46->47 (r2)
  ev_teach(W,41,1,42); ev_teach(W,42,1,43); ev_teach(W,43,1,44); ev_teach(W,44,1,45);
  ev_teach(W,45,2,46); ev_teach(W,46,2,47);
  let a1:i32=ev_cq(W,41,71,45,0,0);
  let a2:i32=ev_cq(W,45,72,47,0,1);
  emit("T4-EPXY a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t4_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106);
  return;
}
fn t4_test(W:[]u8)void {
  emit("=== T4-PARTIAL ===\n");
  t4_train(W);
  t4_couse(W);
  cmp_gap(W);
  t4_zfacts(W);
  let z:i32=ev_query(W,101,70,106,0);
  emit("T4-ANS="); e64(z); cmp_tstat(W);
  if(z==106){emit("T4-RESULT=PASS\n");} else {emit("T4-RESULT=FAIL\n");}
  return;
}

// ---- T5: Without expected-answer ----
// Same as T1 but expected=-1. Composition must decline cleanly (-2).
fn t5_test(W:[]u8)void {
  emit("=== T5-NOEXPECTED ===\n");
  t1_train(W);
  t1_couse(W);
  cmp_gap(W);
  t1_zfacts(W);
  let z:i32=ev_query(W,101,70,-1,0);
  emit("T5-ANS="); e64(z); cmp_tstat(W);
  if(z!=-2){emit("T5-RESULT=ATTEMPTED\n");} else {emit("T5-RESULT=FAIL\n");}
  return;
}

fn main()i32 {
  emit("CMP-UN-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); t1_test(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); t2a_test(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); t2b_test(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); t3_test(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); t4_test(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); t5_test(W6);
  emit("CMP-UN-END\n");
  return 0;
}

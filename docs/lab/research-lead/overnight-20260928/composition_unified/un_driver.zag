
// ---- instrumentation ----
fn cc_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cc_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn cc_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cc_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// Structural property evidence: relation sequence extracted from the
// executable graph, not from MAP labels.
fn cc_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=cc_relseq(W,m,seq,7);
  emit("MAP "); e64(m); emit(" relseq=[");
  let i:i32=0;
  while(i<len){if(i>0){emit(",");} e64(get32(seq,i*4)); i=i+1;}
  emit("]\n");
  return;
}
// Ablation: delete MAP(s) promoted for (s,r).
fn cc_del_map_sr(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn cc_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  LINK14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn cc_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
}
// un_driver.zag -- Unified composition experiment driver.
//
// Tests:
//   T3: 3-structure (X+Y+W plen-2 each -> Z plen-6). Capability retention.
//   T4: 4-structure (X+Y+W+V -> Z plen-8). Tests removed 3-segment cap.
//   T5: 5-structure (X+Y+W+V+U -> Z plen-10). Tests removed cap further.
//   ABL-X: X deleted -> Z must fail (causal).
//   FRESH: no training -> Z must fail.
//
// All structures taught independently, never together. Z uses fresh
// relation 63. No task label, no paired examples, no hint.

// Train X (r1), Y (r2), W (r3): plen-2 chains each.
fn un_train3(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,61,13,0);
  emit("X ans="); e64(x); cc_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,62,23,0);
  emit("Y ans="); e64(y); cc_tstat(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let w:i32=ev_query(W,31,63,33,0);
  emit("W ans="); e64(w); cc_tstat(W);
  emit("maps="); e64(cc_count_maps(W)); emit("\n");
  return;
}
// Train V (r4) plen-2.
fn un_trainV(W:[]u8)void {
  ev_teach(W,41,4,42); ev_teach(W,42,4,43);
  let v:i32=ev_query(W,41,64,43,0);
  emit("V ans="); e64(v); cc_tstat(W);
  return;
}
// Train U (r5) plen-2.
fn un_trainU(W:[]u8)void {
  ev_teach(W,51,5,52); ev_teach(W,52,5,53);
  let u:i32=ev_query(W,51,65,53,0);
  emit("U ans="); e64(u); cc_tstat(W);
  return;
}
// Z3 facts: r1 x2, r2 x2, r3 x2 (plen-6).
fn un_zfacts3(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  return;
}
fn un_zquery3(W:[]u8)void {
  let z:i32=ev_query(W,101,66,107,0);
  emit("Z3 ans="); e64(z); cc_tstat(W);
  let zm:i32=cc_find_map(W,101,66);
  emit("ZMAP3 id="); e64(zm); emit(" link14="); e64(cc_count14(W)); emit("\n");
  if(zm>=0){cc_print_relseq(W,zm);}
  return;
}
// Z4 facts: r1 x2, r2 x2, r3 x2, r4 x2 (plen-8).
fn un_zfacts4(W:[]u8)void {
  ev_teach(W,111,1,112); ev_teach(W,112,1,113);
  ev_teach(W,113,2,114); ev_teach(W,114,2,115);
  ev_teach(W,115,3,116); ev_teach(W,116,3,117);
  ev_teach(W,117,4,118); ev_teach(W,118,4,119);
  return;
}
fn un_zquery4(W:[]u8)void {
  let z:i32=ev_query(W,111,67,119,0);
  emit("Z4 ans="); e64(z); cc_tstat(W);
  let zm:i32=cc_find_map(W,111,67);
  emit("ZMAP4 id="); e64(zm); emit(" link14="); e64(cc_count14(W)); emit("\n");
  if(zm>=0){cc_print_relseq(W,zm);}
  return;
}
// Z5 facts: r1 x2, r2 x2, r3 x2, r4 x2, r5 x2 (plen-10).
fn un_zfacts5(W:[]u8)void {
  ev_teach(W,121,1,122); ev_teach(W,122,1,123);
  ev_teach(W,123,2,124); ev_teach(W,124,2,125);
  ev_teach(W,125,3,126); ev_teach(W,126,3,127);
  ev_teach(W,127,4,128); ev_teach(W,128,4,129);
  ev_teach(W,129,5,130); ev_teach(W,130,5,131);
  return;
}
fn un_zquery5(W:[]u8)void {
  let z:i32=ev_query(W,121,68,131,0);
  emit("Z5 ans="); e64(z); cc_tstat(W);
  let zm:i32=cc_find_map(W,121,68);
  emit("ZMAP5 id="); e64(zm); emit(" link14="); e64(cc_count14(W)); emit("\n");
  if(zm>=0){cc_print_relseq(W,zm);}
  return;
}
fn un_treat3(W:[]u8)void {
  emit("=== TREAT-3 ===\n");
  un_train3(W);
  cc_gap(W);
  un_zfacts3(W);
  un_zquery3(W);
  return;
}
fn un_treat4(W:[]u8)void {
  emit("=== TREAT-4 ===\n");
  un_train3(W);
  un_trainV(W);
  cc_gap(W);
  un_zfacts4(W);
  un_zquery4(W);
  return;
}
fn un_treat5(W:[]u8)void {
  emit("=== TREAT-5 ===\n");
  un_train3(W);
  un_trainV(W);
  un_trainU(W);
  cc_gap(W);
  un_zfacts5(W);
  un_zquery5(W);
  return;
}
fn un_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  un_train3(W);
  cc_del_map_sr(W,11,61);
  emit("maps after del="); e64(cc_count_maps(W)); emit("\n");
  cc_gap(W);
  un_zfacts3(W);
  un_zquery3(W);
  return;
}
fn un_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  cc_gap(W);
  un_zfacts3(W);
  un_zquery3(W);
  return;
}
fn main()i32 {
  emit("COMP-UNIFIED-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); un_treat3(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); un_treat4(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); un_treat5(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); un_ablx(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); un_fresh(W5);
  emit("COMP-UNIFIED-END\n");
  return 0;
}

// mem7_learn.zag -- H-MEM7: decayed recency-weighted merit (R6, new hypothesis).
// Prereg: PREREG_MEM7.md (frozen before this implementation).
// Deltas vs mem6_learn.zag (H-MEM6):
//   R6: DECAYED (RECENCY-WEIGHTED) MERIT. elig() no longer protects on a
//       raw in-window query count. decmerit() sums linear recency weights
//       over the operating window (1 = oldest query in window ..
//       win = newest); a slot is protected within its age window iff
//       decmerit >= MTHRESH (25, frozen, calibrated for win=20).
//       Rationale, frozen: (a) a single query, however fresh (max weight
//       20), is never merit, preserving the R4/R5 "single query is not
//       merit" principle; (b) the merit signal is smooth in recency: a
//       query sliding out of the window sheds weight gradually instead of
//       flipping a binary count, so the X-M6-3a window-edge step becomes
//       a ramp; (c) two queries protect iff their combined recency-mass
//       reaches the threshold: stale-but-in-window queries no longer
//       confer protection while fresh ones do, replacing the in-window
//       1-vs-2 count cliff with a recency-graded merit.
//       Lemma (frozen): any 2 queries since learning protect. A slot's
//       own queries since learning are among the last <=9 queries of Q
//       (age window is PROB=10), so their weights are >= win-8 = 12 and
//       the lightest pair sums to 12+13 = 25 = MTHRESH. Every fresh-merit
//       shape from R5 is therefore preserved by construction; and
//       R6-protected implies >=2 in-window queries (one query maxes at
//       weight win=20 < 25).
//       Scope decision (frozen): R6 changes protection merit only.
//       winuses() is kept unchanged and replay_cost() stays count-based
//       over the same window. Unifying the harm weighting is deferred to
//       a future hypothesis; the red-team concern addressed here is the
//       merit cliff, not the harm scale.
//       What R6 does NOT do: it does not remove the binary protection
//       edge (now at decmerit=25, still a knife-edge, but in
//       recency-mass with an auditable continuous score beneath it); it
//       does not claim L3. Classification: bounded L2 mechanism
//       refinement, attacking the H-MEM6 red-team's open concern that
//       the fixed 20-query window is a step function.
//   Fixtures: F-M6-3c superseded by F-M7-3c (under R6 the old Q layout
//       leaves slots 0,1,2 with decmerit 6,15,24 < 25, so the state is
//       no longer all-protected; the new layout uses complementary
//       recency pairs summing to >= 25 per slot). F-M6-3b is PRESERVED
//       (slot7 decmerit=39 >= 25, section byte-identical). New bars:
//       K-M7-1a/K-M7-1b (fresh vs stale-in-window query pair: same
//       counts, different recency, different protection), K-M7-2 (merit
//       ramp 39..23, protection drops exactly at decmerit < 25),
//       K-M7-4 (fallback under decayed merit), K-M7-5 (regression diff),
//       K-M7-6 (determinism).
// Deltas vs mem5_learn.zag (H-MEM5):
//   R5 (X-M5-1, X-M5-2): RECENCY-WEIGHTED MERIT. elig() now protects a
//       slot within its age window iff its procedure was queried at
//       least MERITK (2) times in the operating window (the same
//       window replay_cost uses). All-time uses no longer confer
//       protection by themselves: stale merit (uses >= MERITK from
//       ancient, window-absent queries) expires. Merit and harm are
//       scope-unified: a slot with window cost below MERITK can never
//       be shielded, so the X-M5-1 pattern (shield a cost-0 slot while
//       a queried procedure is sacrificed) cannot recur. Fresh merit
//       still protects (F-M6-3b). The X-M5-2 one-query cliff is gone
//       at the margin: uses=1 vs uses=2 all-time no longer flips the
//       outcome when both are window-absent (F-M6-2).
//   Fixtures: K-M5-3b expectation superseded (setup_flip2's uses=2 is
//       stale merit under R5: zero window queries, so slot7 is
//       evictable and the flip no longer occurs); new setup_flip3
//       (F-M6-3b) gives every proc >= 2 in-window queries so slot7's
//       uses=2 merit is fresh and the :1 path is preserved with the
//       same frozen shape (wprot=FIFO vprot=slot0, wun=LRU vun=slot7).
//       K-M5-3c fixture superseded (slots 0..6 have zero window
//       queries, so the state is no longer all-protected); new
//       F-M6-3c hand-builds an all-window-protected state (every pid
//       >= 2 window queries).
// Deltas vs mem4_learn.zag (H-MEM4):
//   R4 (X-M4-2a, X-M4-2b): SUBSTANTIVE MERIT THRESHOLD. elig() now
//       protects a slot within its age window iff uses >= MERITK (2).
//       The GRACE=3 absolute protection is removed: there is no
//       age-based shielding of a newcomer with 0 or 1 queries. A single
//       query (even a stale one) is not merit; two queries are the
//       smallest substantive signal. The X-M4-2a grace-window harm and
//       the X-M4-2b fig-leaf-merit harm are closed at the elig() level:
//       on both frozen attack fixtures the protected outcome now
//       coincides with the unprotected outcome (LFU evicts the
//       low-merit newcomer at cost 0; CHURN-FULL:0).
//   Fixtures: K-M4-1b expectation superseded (the grace flip no longer
//       occurs; the frozen setup_flip state now reads CHURN-FULL:0);
//       new setup_flip2 (slot7 uses=2) preserves :1 path coverage and
//       proves merit-positive protection is load-bearing; the K-M3-4
//       fallback fixture is replaced with a hand-built
//       all-merit-protected state (the old 0-query state is no longer
//       all-protected under the new rule).
// Pure Zag. No Python.
// Deltas vs mem3_learn.zag (H-MEM3):
//   R1 (X-M3-1a): FULL winner-recomputation counterfactual. pressure() now
//       recomputes the winner under no protection (wun = argmin_pol(...,0))
//       and compares against the protected winner (wprot). Verdict is
//       CHURN-FULL:1 iff the winner or the eviction differs; CHURN-FULL:0
//       iff the winner is stable and the eviction is unchanged. The old
//       selected-policy-only verdict could read :0 while the outcome
//       changed; that scope gap is closed by construction.
//   R2 (X-M3-1b): MERIT-GATED probation. elig() now voids age protection
//       for meritless slots (uses==0) past a short absolute grace
//       (GRACE=3 queries). A never-queried newcomer no longer shields
//       itself while a queried procedure is sacrificed. K-M3-1 survivor
//       checks retained (newcomers with merit stay protected).
//   R3 (X-M3-2a/b): STRONGER future independence. New dist_differs2()
//       requires L1 frequency-vector distance >= L1MIN=6 (the old
//       dist_differs passed a single-query flip; the new one rejects it).
//       New fut_score3() screens for ADVERSARIAL-TARGET: if the selected
//       policy's victim proc is a strict majority of the future, the
//       future is explicitly excluded (return 2), not silently failed.
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// 8 slots x 28 bytes: +0 used, +4 pid, +8 uses, +12 lastq, +16 sseq, +20 prot_until
fn NSLOT()i32 { return 8; }
fn SLOT_SZ()i32 { return 28; }
fn PROB()i32 { return 10; }
// R4 (H-MEM5): substantive merit threshold, R5 (H-MEM6): window-scoped,
// R6 (H-MEM7): recency-weighted (decayed) within the window.
// Protection is earned by demonstrated merit alone: there is no
// age-based absolute grace. Within the age window a slot is protected
// iff its procedure's recency-weighted query mass (decmerit) reaches
// MTHRESH. A single query (or none), however fresh, is not merit.
// This closes the X-M4-2a grace-window harm, the X-M4-2b fig-leaf-merit
// harm, the X-M5-1/X-M5-2 stale-merit harm, and the X-M6-3a in-window
// count cliff (R6 grades merit by recency instead of a binary count).
// MERITK is superseded by MTHRESH for protection decisions and is
// retained for lineage only.
fn MERITK()i32 { return 2; }
// R6 (H-MEM7): minimum recency-weighted query mass for protection.
// Frozen authored constant, calibrated for win=20: a single maximally
// fresh query (weight 20) is never merit; the lightest protectable
// shape is a complementary recency pair (e.g. weights 12+13).
fn MTHRESH()i32 { return 25; }
// R3 (H-MEM4): minimum L1 frequency-vector distance for a future to count
// as independent of the selection window.
fn L1MIN()i32 { return 6; }
fn slot_off(s:i32)i32 { return s*SLOT_SZ(); }
fn st_used(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)); }
fn st_pid(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+4); }
fn st_uses(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+8); }
fn st_lastq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+12); }
fn st_sseq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+16); }
fn st_prot(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+20); }
fn st_set(W:[]u8, s:i32, used:i32, pid:i32, uses:i32, lastq:i32, sseq:i32, prot:i32)void {
  set32(W, slot_off(s), used); set32(W, slot_off(s)+4, pid);
  set32(W, slot_off(s)+8, uses); set32(W, slot_off(s)+12, lastq);
  set32(W, slot_off(s)+16, sseq); set32(W, slot_off(s)+20, prot);
  return;
}
// ST: +0 nq, +4 seq, +8 ss, +12 fallback flag (R2)
fn st_nq(ST:[]u8)i32 { return get32(ST, 0); }
fn st_seq(ST:[]u8)i32 { return get32(ST, 4); }
fn st_ss(ST:[]u8)i32 { return get32(ST, 8); }
fn st_fbf(ST:[]u8)i32 { return get32(ST, 12); }
fn st_set_nq(ST:[]u8, v:i32)void { set32(ST, 0, v); return; }
fn st_set_seq(ST:[]u8, v:i32)void { set32(ST, 4, v); return; }
fn st_set_ss(ST:[]u8, v:i32)void { set32(ST, 8, v); return; }
fn st_set_fbf(ST:[]u8, v:i32)void { set32(ST, 12, v); return; }
fn st_find(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){ if(st_used(W,s)==1){ if(st_pid(W,s)==pid){ return s; } } s=s+1; }
  return -1;
}
fn has_proc(W:[]u8, pid:i32)i32 { return st_find(W,pid)>=0; }
// R5 (H-MEM6): window-scoped uses: queries for this slot's procedure
// in the last win queries (the same window replay_cost uses).
// R6 (H-MEM7): kept UNCHANGED. replay_cost() stays count-based: R6
// changes protection merit only (frozen scope decision).
fn winuses(W:[]u8, ST:[]u8, Q:[]u8, s:i32, win:i32)i32 {
  let pid:i32=st_pid(W,s);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let c:i32=0; let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+1;} i=i+1; }
  return c;
}
// R6 (H-MEM7): decayed (recency-weighted) merit. Each in-window query
// R7b (H-MEM8): top-aligned recency weights. Each in-window query
// for the slot's procedure contributes a linear recency weight
// measured from the PRESENT: weight = win - (nq-1-i), i.e. win (20)
// for the newest query, win-1 for the second-newest, and so on,
// regardless of nq. For nq >= win this is arithmetically identical
// to R6 (bottom-aligned); for nq < win, recency is
// history-length-invariant: the last 9 queries always weigh
// 20..12, so the age-window lemma holds uniformly (any 2 queries
// since learning protect, for all nq). A query sliding out of the
// window sheds weight gradually: the X-M6-3a window-edge step
// becomes a ramp. The max single-query weight is win (20) <
// MTHRESH (25), so one query is never merit, uniformly.
fn decmerit(W:[]u8, ST:[]u8, Q:[]u8, s:i32, win:i32)i32 {
  let pid:i32=st_pid(W,s);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let c:i32=0; let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+(win-(nq-1-i));} i=i+1; }
  return c;
}
// eviction-eligible: stored and not (protected and use_prot)
// R7b (H-MEM8): decayed recency-weighted merit, top-aligned. Within
// the age window (seq < prot), a slot is protected iff decmerit >=
// MTHRESH (25). R7b-protected implies >= 2 in-window queries (one
// query maxes at weight 20 < 25), so R7b only ever removes R5
// protection; and any 2 queries since learning protect (top-aligned
// weights 20..12 for the last 9, pair >= 12+13 = 25), for ALL nq,
// so every R5 fresh-merit shape is preserved uniformly (the X-M7-3
// regime condition is eliminated, not narrowed).
// Stale-but-in-window queries (low recency weights) no longer confer
// protection: the in-window 1-vs-2 count cliff is replaced by
// recency-graded merit. There is no absolute grace.
fn elig(W:[]u8, ST:[]u8, Q:[]u8, s:i32, win:i32, use_prot:i32)i32 {
  if(st_used(W,s)==0){ return 0; }
  if(use_prot==1){
    if(st_seq(ST)<st_prot(W,s)){
      if(decmerit(W,ST,Q,s,win)>=MTHRESH()){ return 0; }
      return 1;
    }
  }
  return 1;
}
fn nelig(W:[]u8, ST:[]u8, Q:[]u8, win:i32, use_prot:i32)i32 {
  let c:i32=0; let s:i32=0;
  while(s<NSLOT()){ if(elig(W,ST,Q,s,win,use_prot)==1){c=c+1;} s=s+1; }
  return c;
}
fn st_learn(W:[]u8, ST:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==0){
      let ss:i32=st_ss(ST);
      st_set(W, s, 1, pid, 0, 0, ss, st_seq(ST)+PROB());
      st_set_ss(ST, ss+1);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn st_query(W:[]u8, ST:[]u8, Q:[]u8, pid:i32)void {
  let f:i32=st_find(W, pid);
  if(f>=0){
    let sq:i32=st_seq(ST)+1;
    st_set_seq(ST, sq);
    set32(W, slot_off(f)+8, st_uses(W,f)+1);
    set32(W, slot_off(f)+12, sq);
    let nq:i32=st_nq(ST);
    Q[nq]=pid as u8;
    st_set_nq(ST, nq+1);
  }
  return;
}
fn run_seq(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){ st_query(W, ST, Q, P[i] as i32); i=i+1; }
  return;
}
fn run_pairs(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, np:i32)void {
  let i:i32=0;
  while(i<np){
    let pid:i32=P[i*2] as i32; let cnt:i32=P[i*2+1] as i32;
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    i=i+1;
  }
  return;
}
fn pol_name(p:i32)[]u8 {
  if(p==0){return "LFU";} if(p==1){return "LRU";}
  if(p==2){return "FIFO";} if(p==3){return "LIFO";}
  return "RANDOM";
}
// victim; use_prot=1 skips protected slots, 0 ignores protection
// R5 (H-MEM6): eligibility is window-aware (Q, win threaded through).
fn victim(W:[]u8, Q:[]u8, ST:[]u8, pol:i32, ev:i32, win:i32, use_prot:i32)i32 {
  let best:i32=-1; let s:i32=0;
  if(pol==4){
    let ne:i32=nelig(W,ST,Q,win,use_prot);
    if(ne==0){ return -1; }
    let k:i32=((ev*5+1)%ne+ne)%ne;
    let c:i32=0; s=0;
    while(s<NSLOT()){
      if(elig(W,ST,Q,s,win,use_prot)==1){ if(c==k){return s;} c=c+1; }
      s=s+1;
    }
    return -1;
  }
  while(s<NSLOT()){
    if(elig(W,ST,Q,s,win,use_prot)==1){
      if(best<0){ best=s; }
      else {
        if(pol==0){ if(st_uses(W,s)<st_uses(W,best)){best=s;} }
        if(pol==1){ if(st_lastq(W,s)<st_lastq(W,best)){best=s;} }
        if(pol==2){ if(st_sseq(W,s)<st_sseq(W,best)){best=s;} }
        if(pol==3){ if(st_sseq(W,s)>st_sseq(W,best)){best=s;} }
      }
    }
    s=s+1;
  }
  return best;
}
// replay harm = occurrences of victim procedure in last win queries
// (window-scoped). R5 (H-MEM6): now shares winuses() with elig(), so
// protection merit and eviction harm are computed over the same
// evidence window. R6 (H-MEM7): DELIBERATELY UNCHANGED. R6 re-weights
// protection merit (decmerit) but replay harm stays count-based.
// R7b (H-MEM8): STILL UNCHANGED. The merit/harm split is reconciled,
// not unified: merit is forward-looking (recency-weighted activity
// predicts future queries), harm is backward-looking (literal replay
// count); the X-M7-2 inversion is bounded by theorem (<= 4, see
// PREREG_MEM8.md) and absent on the mass scale. Full unification
// (harm = decmerit, R7a) was tested in scratch and REJECTED: it
// reorders the menu argmin globally, breaking frozen K-M2-5
// (C2-ev0 winner FIFO->LRU) and dissolving F-M6-3b's :1 path.
fn replay_cost(W:[]u8, Q:[]u8, ST:[]u8, v:i32, win:i32)i32 {
  if(v<0){return 999999;}
  return winuses(W,ST,Q,v,win);
}
// argmin over the menu with a given protection mode (R2 helper)
fn argmin_pol(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, up:i32)i32 {
  let p:i32=0; let bestp:i32=0; let bestc:i32=999999;
  while(p<5){
    let c:i32=replay_cost(W,Q,ST,victim(W,Q,ST,p,ev,win,up),win);
    if(c<bestc){bestc=c;bestp=p;}
    p=p+1;
  }
  return bestp;
}
// winner at window (no state change); R2: falls back to unprotected when all protected
fn select_win(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32)i32 {
  let wp:i32=argmin_pol(W,Q,ST,ev,win,1);
  if(victim(W,Q,ST,wp,ev,win,1)<0){
    emit("FALLBACK-ALL-PROTECTED ");
    wp=argmin_pol(W,Q,ST,ev,win,0);
  }
  return wp;
}
fn is_strict_up(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32, up:i32)i32 {
  let wc:i32=replay_cost(W,Q,ST,victim(W,Q,ST,wp,ev,win,up),win);
  let p:i32=0;
  while(p<5){
    if(p!=wp){
      if(replay_cost(W,Q,ST,victim(W,Q,ST,p,ev,win,up),win)<=wc){ return 0; }
    }
    p=p+1;
  }
  return 1;
}
fn is_strict(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32)i32 {
  return is_strict_up(W,Q,ST,ev,win,wp,1);
}
// K-M2-5: identical strict winner across W in {20,25,30}
fn band_check(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, expect:i32, tag:[]u8)i32 {
  emit("band check "); emit(tag); emit(" (expect "); emit(pol_name(expect)); emit("):");
  let ok:i32=1;
  let w:i32=20;
  while(w<=30){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); ok=0; }
    if(sw!=expect){ ok=0; }
    w=w+5;
  }
  emit("\n");
  if(ok==1){ emit("K-M2-5 PASS ("); emit(tag); emit(")\n"); }
  else { emit("K-M2-5 FAIL ("); emit(tag); emit(")\n"); }
  return ok;
}
// window sweep as inspectable context (not a bar)
fn sweep_print(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, tag:[]u8)void {
  emit("window sweep "); emit(tag); emit(":");
  let w:i32=10;
  while(w<=40){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); }
    w=w+5;
  }
  let swf:i32=select_win(W,Q,ST,ev,1000000);
  let stf:i32=is_strict(W,Q,ST,ev,1000000,swf);
  emit(" W=full:"); emit(pol_name(swf));
  if(stf==1){ emit("*"); } else { emit("~"); }
  emit("\n");
  return;
}
// R3: 1 iff the future's per-proc frequency vector differs from the W=win window vector
fn dist_differs(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let p:i32=0;
  while(p<16){
    let cw:i32=0; let i:i32=lo;
    while(i<nq){ if((Q[i] as i32)==p){cw=cw+1;} i=i+1; }
    let cf:i32=0; let j:i32=0;
    while(j<nf){ if((F[j] as i32)==p){cf=cf+1;} j=j+1; }
    if(cw!=cf){ return 1; }
    p=p+1;
  }
  return 0;
}
// R3 (H-MEM4): L1 distance between the future's and the window's per-proc
// frequency vectors. The old dist_differs passes a single-query flip
// (X-M3-2b); L1 exposes how close the distributions really are.
fn l1_dist(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let l1:i32=0;
  let p:i32=0;
  while(p<16){
    let cw:i32=0; let i:i32=lo;
    while(i<nq){ if((Q[i] as i32)==p){cw=cw+1;} i=i+1; }
    let cf:i32=0; let j:i32=0;
    while(j<nf){ if((F[j] as i32)==p){cf=cf+1;} j=j+1; }
    let d:i32=cw-cf; if(d<0){d=0-d;}
    l1=l1+d;
    p=p+1;
  }
  return l1;
}
// R3 (H-MEM4): strengthened independence: 1 iff L1 >= L1MIN.
fn dist_differs2(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  if(l1_dist(Q,ST,F,nf,win)>=L1MIN()){ return 1; }
  return 0;
}
// R3/R4: future scoring. Bar: DIST-DIFFERS vs window AND selected ties the min.
// Prints n_tying_min as discriminativeness context. Precondition: at the call
// site at least one slot is eligible (true at all headline events).
fn fut_score2(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, F:[]u8, nf:i32, sel:i32, win:i32, tag:[]u8)i32 {
  let dd:i32=dist_differs(Q,ST,F,nf,win);
  emit("held-out "); emit(tag);
  if(dd==1){ emit(" [DIST-DIFFERS]"); } else { emit(" [DIST-SAME]"); }
  let M:[]u8=z_alloc(20);
  let p:i32=0; let minm:i32=999999;
  while(p<5){
    let pid:i32=st_pid(W,victim(W,Q,ST,p,ev,win,1));
    let m:i32=0; let i:i32=0;
    while(i<nf){ if((F[i] as i32)==pid){m=m+1;} i=i+1; }
    set32(M,p*4,m);
    if(m<minm){minm=m;}
    p=p+1;
  }
  emit(" misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let nmin:i32=0; p=0;
  while(p<5){ if(get32(M,p*4)==minm){nmin=nmin+1;} p=p+1; }
  emit("  n_tying_min="); emit(i32s(nmin)); emit(" of 5\n");
  if(dd==0){ emit("K-M3-2 FAIL ("); emit(tag); emit(": future distribution identical to window)\n"); return 0; }
  if(get32(M,sel*4)==minm){ emit("K-M3-2 PASS ("); emit(tag); emit(": selected ties min, DIST-DIFFERS)\n"); return 1; }
  emit("K-M3-2 FAIL ("); emit(tag); emit(": selected not min)\n"); return 0;
}
// R3 (H-MEM4): strengthened future scoring.
// Returns 1=PASS, 0=FAIL, 2=ADVERSARIAL-TARGET (explicitly excluded).
// Screen 1 (X-M3-2a): if the selected policy's victim proc is a strict
// majority of the future, the future targets the selection adversarially;
// it is excluded from the bar with an explicit print, not silently failed.
// Screen 2 (X-M3-2b): independence requires L1 >= L1MIN (dist_differs2);
// the old single-query flip no longer passes. Then the K-M3-2 bar:
// selected ties the minimum miss count.
fn fut_score3(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, F:[]u8, nf:i32, sel:i32, win:i32, tag:[]u8)i32 {
  let vv:i32=victim(W,Q,ST,sel,ev,win,1);
  let vp:i32=-1; if(vv>=0){vp=st_pid(W,vv);}
  let fvp:i32=0;
  if(vp>=0){
    let i:i32=0;
    while(i<nf){ if((F[i] as i32)==vp){fvp=fvp+1;} i=i+1; }
  }
  emit("held-out "); emit(tag);
  if(vp>=0 && fvp*2>nf){
    emit(" [ADVERSARIAL-TARGET: proc"); emit(i32s(vp));
    emit("="); emit(i32s(fvp)); emit("/"); emit(i32s(nf));
    emit(" targets selected "); emit(pol_name(sel)); emit(" victim]\n");
    emit("K-M4-3 EXCLUDED ("); emit(tag); emit(": adversarial target, out of bar scope)\n");
    return 2;
  }
  let l1:i32=l1_dist(Q,ST,F,nf,win);
  emit(" [L1="); emit(i32s(l1)); emit("]");
  if(l1>=L1MIN()){ emit(" [DIST-DIFFERS2]"); } else { emit(" [DIST-TOO-CLOSE]"); }
  let M:[]u8=z_alloc(20);
  let p:i32=0; let minm:i32=999999;
  while(p<5){
    let pid:i32=st_pid(W,victim(W,Q,ST,p,ev,win,1));
    let m:i32=0; let i:i32=0;
    while(i<nf){ if((F[i] as i32)==pid){m=m+1;} i=i+1; }
    set32(M,p*4,m);
    if(m<minm){minm=m;}
    p=p+1;
  }
  emit(" misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let nmin:i32=0; p=0;
  while(p<5){ if(get32(M,p*4)==minm){nmin=nmin+1;} p=p+1; }
  emit("  n_tying_min="); emit(i32s(nmin)); emit(" of 5\n");
  if(l1<L1MIN()){
    emit("K-M3-2 FAIL ("); emit(tag); emit(": future too close to window, L1=");
    emit(i32s(l1)); emit(" < "); emit(i32s(L1MIN())); emit(")\n");
    return 0;
  }
  if(get32(M,sel*4)==minm){ emit("K-M3-2 PASS ("); emit(tag); emit(": selected ties min, DIST-DIFFERS2)\n"); return 1; }
  emit("K-M3-2 FAIL ("); emit(tag); emit(": selected not min)\n"); return 0;
}
// R1 (H-MEM4): full winner-recomputation counterfactual.
// Compares the protected outcome (wprot/vprot) against the recomputed
// unprotected outcome (wun/vun). Returns 1 iff protection changed the
// outcome, 0 iff the winner is stable and the eviction is unchanged.
// The selected-policy victim pair is printed as a detail line for
// K-M3-1 continuity. On the fallback path the verdict is 0 with the
// fallback noted (no protected winner exists).
fn churn_verdict(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wprot:i32, vprot:i32, up:i32)i32 {
  if(up==0){
    emit("  [full counterfactual] fallback path: no protected winner (all slots protected)\n");
    emit("  CHURN-FULL:0 (fallback path; protection not applied)\n");
    return 0;
  }
  let wun:i32=argmin_pol(W,Q,ST,ev,win,0);
  let vun:i32=victim(W,Q,ST,wun,ev,win,0);
  emit("  [full counterfactual] protected: "); emit(pol_name(wprot));
  emit(" victim=slot"); emit(i32s(vprot));
  if(vprot>=0){ emit("(proc"); emit(i32s(st_pid(W,vprot))); emit(")"); }
  emit(" | unprotected: "); emit(pol_name(wun));
  emit(" victim=slot"); emit(i32s(vun));
  if(vun>=0){ emit("(proc"); emit(i32s(st_pid(W,vun))); emit(")"); }
  emit("\n");
  let pv3:i32=victim(W,Q,ST,wprot,ev,win,1);
  let uv:i32=victim(W,Q,ST,wprot,ev,win,0);
  emit("  [selected-policy] protected-victim=slot"); emit(i32s(pv3));
  emit(" unprotected-victim=slot"); emit(i32s(uv)); emit("\n");
  if(wprot==wun && vprot==vun){
    emit("  CHURN-FULL:0 (winner stable at "); emit(pol_name(wprot));
    emit("; eviction unchanged)\n");
    return 0;
  }
  if(wprot!=wun){
    emit("  CHURN-FULL:1 (winner flips "); emit(pol_name(wprot)); emit("->"); emit(pol_name(wun));
  } else {
    emit("  CHURN-FULL:1 (winner stable at "); emit(pol_name(wprot));
  }
  emit("; eviction slot"); emit(i32s(vprot));
  if(vprot>=0){ emit("(proc"); emit(i32s(st_pid(W,vprot))); emit(")"); }
  emit("->slot"); emit(i32s(vun));
  if(vun>=0){ emit("(proc"); emit(i32s(st_pid(W,vun))); emit(")"); }
  emit(")\n");
  return 1;
}
// pressure at operating window 20; R1 (H-MEM4): full counterfactual;
// R2 (H-MEM3): all-protected fallback
fn pressure(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, newpid:i32)i32 {
  emit("pressure event "); emit(i32s(ev));
  emit(" (learn proc"); emit(i32s(newpid)); emit(", win=20):\n");
  st_set_fbf(ST, 0);
  let up:i32=1;
  let bestp:i32=argmin_pol(W,Q,ST,ev,20,1);
  let v:i32=victim(W,Q,ST,bestp,ev,20,1);
  if(v<0){
    emit("  FALLBACK-ALL-PROTECTED: all slots protected; using unprotected choice\n");
    st_set_fbf(ST, 1);
    up=0;
    bestp=argmin_pol(W,Q,ST,ev,20,0);
    v=victim(W,Q,ST,bestp,ev,20,0);
  }
  let p:i32=0;
  while(p<5){
    let pv2:i32=victim(W,Q,ST,p,ev,20,up);
    let c:i32=replay_cost(W,Q,ST,pv2,20);
    emit("    "); emit(pol_name(p));
    emit(" victim=slot"); emit(i32s(pv2));
    if(pv2>=0){ emit("(proc"); emit(i32s(st_pid(W,pv2))); emit(")"); }
    emit(" cost="); emit(i32s(c)); emit("\n");
    p=p+1;
  }
  emit("  selected: "); emit(pol_name(bestp));
  emit(" cost="); emit(i32s(replay_cost(W,Q,ST,v,20)));
  if(is_strict_up(W,Q,ST,ev,20,bestp,up)==1){ emit(" STRICT"); } else { emit(" TIE"); }
  emit("\n");
  emit("  evict slot"); emit(i32s(v));
  if(v>=0){
    emit(" proc"); emit(i32s(st_pid(W,v)));
    emit(" uses="); emit(i32s(st_uses(W,v)));
    emit(" lastq="); emit(i32s(st_lastq(W,v)));
  }
  emit("\n");
  // R1 (H-MEM4): full winner-recomputation counterfactual (X-M3-1a repair).
  // The old selected-policy-only verdict is superseded; the detail pair
  // is still printed for K-M3-1 continuity.
  let cv:i32=churn_verdict(W,Q,ST,ev,20,bestp,v,up);
  if(v>=0){ st_set(W, v, 0, -1, 0, 0, 0, 0); }
  let s2:i32=st_learn(W, ST, newpid);
  emit("  stored proc"); emit(i32s(newpid));
  emit(" at slot"); emit(i32s(s2));
  if(s2>=0){ emit(" prot_until="); emit(i32s(st_prot(W,s2))); }
  emit("\n");
  return bestp;
}
fn store_init(W:[]u8, ST:[]u8)void {
  let s:i32=0;
  while(s<NSLOT()){ st_set(W,s,0,-1,0,0,0,0); s=s+1; }
  st_set_nq(ST,0); st_set_seq(ST,0); st_set_ss(ST,0); st_set_fbf(ST,0);
  return;
}
fn learn_stream(W:[]u8, ST:[]u8, base:i32, n:i32)void {
  let i:i32=0;
  while(i<n){ let _x:i32=st_learn(W, ST, base+i); i=i+1; }
  return;
}
// setup_flip: frozen H-MEM4 winner-flip state (PREREG_MEM4.md).
// slot7 holds a newcomer (proc7, uses=0, lastq=0, sseq=7, prot=108,
// learned at seq 98, age=2) that H-MEM4 grace-protected; under H-MEM5
// (no grace, uses=0 < MERITK) slot7 is evictable. K-M5-3a documents
// that the flip no longer occurs. Q is 20 queries: 10x proc5, 5x
// proc0, 5x proc6. ev=5 fixes RANDOM's deterministic pick.
fn setup_flip(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  st_set_seq(ST, 100);
  st_set_nq(ST, 20);
  let i:i32=0;
  while(i<10){ Q[i]=5; i=i+1; }
  while(i<15){ Q[i]=0; i=i+1; }
  while(i<20){ Q[i]=6; i=i+1; }
  st_set(W, 0, 1, 0, 100, 100, 0, 10);
  st_set(W, 1, 1, 1, 5, 50, 1, 10);
  st_set(W, 2, 1, 2, 5, 50, 2, 10);
  st_set(W, 3, 1, 3, 5, 50, 3, 10);
  st_set(W, 4, 1, 4, 5, 50, 4, 10);
  st_set(W, 5, 1, 5, 1, 1, 5, 10);
  st_set(W, 6, 1, 6, 5, 50, 6, 10);
  st_set(W, 7, 1, 7, 0, 0, 7, 108);
  return;
}
// setup_flip2 (H-MEM5, frozen in PREREG_MEM5.md): identical to
// setup_flip except slot7 holds a merit-positive newcomer (proc7,
// uses=2, lastq=0, sseq=7, prot=108). Slot7 is protected under
// protection (seq=100 < 108, uses=2 >= MERITK), so the protected
// winner (FIFO) differs from the unprotected winner (LRU): the :1
// path is preserved and the merit protection is load-bearing.
fn setup_flip2(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  st_set_seq(ST, 100);
  st_set_nq(ST, 20);
  let i:i32=0;
  while(i<10){ Q[i]=5; i=i+1; }
  while(i<15){ Q[i]=0; i=i+1; }
  while(i<20){ Q[i]=6; i=i+1; }
  st_set(W, 0, 1, 0, 100, 100, 0, 10);
  st_set(W, 1, 1, 1, 5, 50, 1, 10);
  st_set(W, 2, 1, 2, 5, 50, 2, 10);
  st_set(W, 3, 1, 3, 5, 50, 3, 10);
  st_set(W, 4, 1, 4, 5, 50, 4, 10);
  st_set(W, 5, 1, 5, 1, 1, 5, 10);
  st_set(W, 6, 1, 6, 5, 50, 6, 10);
  st_set(W, 7, 1, 7, 2, 0, 7, 108);
  return;
}
// setup_flip3 (H-MEM6, frozen in PREREG_MEM6.md): identical slot state
// to setup_flip2 (slot7: proc7, uses=2, lastq=0, sseq=7, prot=108),
// but Q gives every proc >= 2 in-window queries (20-query window:
// 3x proc0, 2x each of procs 1..4, 4x proc5, 3x proc6, 2x proc7),
// so slot7's uses=2 merit is FRESH (winuses=2 >= MERITK) and slot7 is
// protected under R5. The :1 path is preserved with the same frozen
// shape (wprot=FIFO vprot=slot0, wun=LRU vun=slot7).
fn setup_flip3(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  st_set_seq(ST, 100);
  st_set_nq(ST, 20);
  let i:i32=0;
  while(i<3){ Q[i]=0; i=i+1; }
  while(i<5){ Q[i]=1; i=i+1; }
  while(i<7){ Q[i]=2; i=i+1; }
  while(i<9){ Q[i]=3; i=i+1; }
  while(i<11){ Q[i]=4; i=i+1; }
  while(i<15){ Q[i]=5; i=i+1; }
  while(i<18){ Q[i]=6; i=i+1; }
  while(i<20){ Q[i]=7; i=i+1; }
  st_set(W, 0, 1, 0, 100, 100, 0, 10);
  st_set(W, 1, 1, 1, 5, 50, 1, 10);
  st_set(W, 2, 1, 2, 5, 50, 2, 10);
  st_set(W, 3, 1, 3, 5, 50, 3, 10);
  st_set(W, 4, 1, 4, 5, 50, 4, 10);
  st_set(W, 5, 1, 5, 1, 1, 5, 10);
  st_set(W, 6, 1, 6, 5, 50, 6, 10);
  st_set(W, 7, 1, 7, 2, 0, 7, 108);
  return;
}
// setup_xm51 (H-MEM6, frozen in PREREG_MEM6.md): the red team's X-M5-1
// fixture (PREREG_MEM5_ADV.md) with parameterized slot7 all-time uses.
// slot7 holds proc7 with uses=u7 (both queries ancient, lastq=101,
// outside the 20-query operating window), prot window open
// (seq=105 < prot=109). winuses(proc7)=0: stale merit under R5.
fn setup_xm51(W:[]u8, ST:[]u8, Q:[]u8, u7:i32)void {
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 26);
  Q[0]=7; Q[1]=7; Q[2]=0; Q[3]=1; Q[4]=2; Q[5]=3;
  let i:i32=0;
  while(i<6){ Q[6+i]=0; i=i+1; }
  while(i<9){ Q[6+i]=1; i=i+1; }
  while(i<12){ Q[6+i]=2; i=i+1; }
  while(i<14){ Q[6+i]=3; i=i+1; }
  while(i<16){ Q[6+i]=4; i=i+1; }
  while(i<18){ Q[6+i]=5; i=i+1; }
  while(i<20){ Q[6+i]=6; i=i+1; }
  st_set(W,0,1,0,10,91,0,50); st_set(W,1,1,1,20,92,1,50);
  st_set(W,2,1,2,30,93,2,50); st_set(W,3,1,3,40,94,3,50);
  st_set(W,4,1,4,50,95,4,50); st_set(W,5,1,5,60,96,5,50);
  st_set(W,6,1,6,70,97,6,50); st_set(W,7,1,7,u7,101,7,109);
  return;
}
// setup_m7pair (H-MEM7, frozen in PREREG_MEM7.md): the recency-graded
// version of the red team's X-M6-1 shape. slot7 holds proc7 (uses=2
// all-time, lastq=101, sseq=7, prot=109, age-open at seq=105); slots
// 0..6 are age-expired (prot=50). Q has nq=26; proc7's two queries sit
// at positions p0 and p1 (0-indexed); the other 24 queries are fixed
// fillers (2x0,3x1,3x2,2x3,5x4,2x5,7x6) placed in increasing position
// order around the two 7s. Window = Q[6..26), weights = pos-5.
// Hand-derived frozen expectations:
//   (p0,p1)=(24,25): weights 19+20=39 >= 25 -> slot7 PROTECTED;
//     wprot=LFU(0) vprot=slot0 cprot=1; wun=LRU(1) vun=slot0; cv=1.
//   (p0,p1)=(6,7):   weights 1+2=3 < 25  -> slot7 EVICTABLE;
//     wprot=LRU(1) vprot=slot0 cprot=1; wun=LRU(1) vun=slot0; cv=0.
// Same counts (2 queries), different recency, different protection:
// under R5 both would protect (winuses=2) and both would read :1.
fn setup_m7pair(W:[]u8, ST:[]u8, Q:[]u8, p0:i32, p1:i32)void {
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 26);
  let F:[]u8=z_alloc(24);
  F[0]=0;F[1]=1;F[2]=2;F[3]=3;F[4]=4;F[5]=5;
  F[6]=0;F[7]=1;F[8]=1;F[9]=2;F[10]=2;F[11]=3;
  F[12]=4;F[13]=4;F[14]=4;F[15]=4;F[16]=5;
  F[17]=6;F[18]=6;F[19]=6;F[20]=6;F[21]=6;F[22]=6;F[23]=6;
  let q:i32=0; let f:i32=0;
  while(q<26){
    if(q==p0 || q==p1){ Q[q]=7; }
    else { Q[q]=F[f]; f=f+1; }
    q=q+1;
  }
  st_set(W,0,1,0,10,91,0,50); st_set(W,1,1,1,20,92,1,50);
  st_set(W,2,1,2,30,93,2,50); st_set(W,3,1,3,40,94,3,50);
  st_set(W,4,1,4,50,95,4,50); st_set(W,5,1,5,60,96,5,50);
  st_set(W,6,1,6,70,97,6,50); st_set(W,7,1,7,2,101,7,109);
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(NSLOT()*SLOT_SZ());
  let ST:[]u8=z_alloc(16);
  let Q:[]u8=z_alloc(512);
  let pass:i32=1;
  let strict_n:i32=0;

  // ================= STREAM A2 =================
  emit("=== STREAM A2 (stable popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let AA:[]u8=z_alloc(40);
  let ai:i32=0;
  AA[ai]=5;ai=ai+1; AA[ai]=5;ai=ai+1;
  let t:i32=0;
  while(t<4){AA[ai]=0;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=7;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=3;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=6;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=1;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=2;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=4;ai=ai+1;t=t+1;}
  run_seq(W, ST, Q, AA, ai);
  let AW:[]u8=z_alloc(20);
  AW[0]=6;AW[1]=6;AW[2]=5;AW[3]=0;AW[4]=0;AW[5]=0;AW[6]=0;
  AW[7]=7;AW[8]=7;AW[9]=7;AW[10]=7;AW[11]=3;AW[12]=3;AW[13]=3;AW[14]=3;
  AW[15]=1;AW[16]=1;AW[17]=2;AW[18]=2;AW[19]=4;
  run_seq(W, ST, Q, AW, 20);
  emit("A2: 53 queries.\n");
  if(band_check(W,Q,ST,0,0,"A2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"A2-ev0");
  // R3: new shift futures (frozen in PREREG_MEM3.md). Expected: selected LFU
  // unique min on both; DIST-DIFFERS vs the W=20 window.
  let A2F1:[]u8=z_alloc(20);
  A2F1[0]=5;A2F1[1]=5;
  A2F1[2]=6;A2F1[3]=6;A2F1[4]=6;A2F1[5]=6;A2F1[6]=6;
  A2F1[7]=0;A2F1[8]=0;A2F1[9]=0;A2F1[10]=0;A2F1[11]=0;
  A2F1[12]=7;A2F1[13]=7;A2F1[14]=7;A2F1[15]=7;
  A2F1[16]=1;A2F1[17]=1;A2F1[18]=1;A2F1[19]=1;
  let A2F2:[]u8=z_alloc(20);
  A2F2[0]=5;
  A2F2[1]=6;A2F2[2]=6;A2F2[3]=6;A2F2[4]=6;A2F2[5]=6;A2F2[6]=6;
  A2F2[7]=0;A2F2[8]=0;A2F2[9]=0;A2F2[10]=0;
  A2F2[11]=7;A2F2[12]=7;A2F2[13]=7;A2F2[14]=7;
  A2F2[15]=1;A2F2[16]=1;A2F2[17]=1;A2F2[18]=1;A2F2[19]=1;
  if(fut_score3(W,Q,ST,0,A2F1,20,0,20,"A2 F-S1")!=1){ pass=0; }
  if(fut_score3(W,Q,ST,0,A2F2,20,0,20,"A2 F-S2")!=1){ pass=0; }
  let wA0:i32=select_win(W,Q,ST,0,20);
  let sA0:i32=is_strict(W,Q,ST,0,20,wA0);
  let selA0:i32=pressure(W,Q,ST,0,8);
  if(selA0!=0){ emit("A2-ev0 FAIL: expected LFU\n"); pass=0; }
  if(wA0!=selA0){ emit("A2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sA0==1){ strict_n=strict_n+1; }
  // interleave Q1 = [8,8,8]
  let Q1:[]u8=z_alloc(3); Q1[0]=8;Q1[1]=8;Q1[2]=8;
  run_seq(W, ST, Q, Q1, 3);
  // R1: selected-policy counterfactual captured pre-pressure (X-M2-1a repair)
  let wA1:i32=select_win(W,Q,ST,1,20);
  let sA1:i32=is_strict(W,Q,ST,1,20,wA1);
  let cf_p1:i32=victim(W,Q,ST,wA1,1,20,1);
  let cf_u1:i32=victim(W,Q,ST,wA1,1,20,0);
  let cf_p1_pid:i32=-1; if(cf_p1>=0){cf_p1_pid=st_pid(W,cf_p1);}
  let cf_u1_pid:i32=-1; if(cf_u1>=0){cf_u1_pid=st_pid(W,cf_u1);}
  let selA1:i32=pressure(W,Q,ST,1,9);
  if(has_proc(W,8)==0){ emit("K-M3-1 FAIL: proc8 churned at ev1\n"); pass=0; }
  else { emit("K-M3-1 check ev1: proc8 survives\n"); }
  if(wA1!=1){ emit("K-M3-1 FAIL: ev1 winner not LRU\n"); pass=0; }
  if(cf_p1!=6 || cf_u1!=6 || cf_p1_pid!=6 || cf_u1_pid!=6){
    emit("K-M3-1 FAIL: ev1 selected-policy counterfactual not slot6(proc6)/slot6(proc6)\n"); pass=0;
  } else {
    emit("K-M3-1 PASS ev1: selected LRU protected-victim=slot6(proc6) unprotected-victim=slot6(proc6); CHURN-FULL:0 honest (winner stable)\n");
  }
  if(wA1!=selA1){ emit("A2-ev1 FAIL: winner mismatch\n"); pass=0; }
  if(sA1==1){ strict_n=strict_n+1; }
  // interleave Q2 = [9,9,8,8,0,0]
  let Q2:[]u8=z_alloc(6); Q2[0]=9;Q2[1]=9;Q2[2]=8;Q2[3]=8;Q2[4]=0;Q2[5]=0;
  run_seq(W, ST, Q, Q2, 6);
  let wA2:i32=select_win(W,Q,ST,2,20);
  let sA2:i32=is_strict(W,Q,ST,2,20,wA2);
  let cf_p2:i32=victim(W,Q,ST,wA2,2,20,1);
  let cf_u2:i32=victim(W,Q,ST,wA2,2,20,0);
  let cf_p2_pid:i32=-1; if(cf_p2>=0){cf_p2_pid=st_pid(W,cf_p2);}
  let cf_u2_pid:i32=-1; if(cf_u2>=0){cf_u2_pid=st_pid(W,cf_u2);}
  let selA2:i32=pressure(W,Q,ST,2,10);
  if(has_proc(W,9)==0){ emit("K-M3-1 FAIL: proc9 churned at ev2\n"); pass=0; }
  else { emit("K-M3-1 check ev2: proc9 survives\n"); }
  if(wA2!=0){ emit("K-M3-1 FAIL: ev2 winner not LFU\n"); pass=0; }
  if(cf_p2!=4 || cf_u2!=6 || cf_p2_pid!=4 || cf_u2_pid!=9){
    emit("K-M3-1 FAIL: ev2 selected-policy counterfactual not slot4(proc4)/slot6(proc9)\n"); pass=0;
  } else {
    emit("K-M3-1 PASS ev2: selected LFU protected-victim=slot4(proc4) unprotected-victim=slot6(proc9); CHURN-FULL:1 (full counterfactual; see verdict line)\n");
  }
  if(wA2!=selA2){ emit("A2-ev2 FAIL: winner mismatch\n"); pass=0; }
  if(sA2==1){ strict_n=strict_n+1; }

  // ================= STREAM B2 =================
  emit("=== STREAM B2 (shifting popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let B1:[]u8=z_alloc(2); B1[0]=3;B1[1]=40;
  run_pairs(W, ST, Q, B1, 1);
  let B2:[]u8=z_alloc(14);
  B2[0]=6;B2[1]=6; B2[2]=2;B2[3]=6; B2[4]=4;B2[5]=6; B2[6]=5;B2[7]=6;
  B2[8]=7;B2[9]=6; B2[10]=1;B2[11]=6; B2[12]=0;B2[13]=10;
  run_pairs(W, ST, Q, B2, 7);
  emit("B2: 86 queries.\n");
  if(band_check(W,Q,ST,0,1,"B2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"B2-ev0");
  let B2F1:[]u8=z_alloc(20);
  B2F1[0]=3;
  B2F1[1]=1;B2F1[2]=1;B2F1[3]=1;B2F1[4]=1;B2F1[5]=1;
  B2F1[6]=0;B2F1[7]=0;B2F1[8]=0;B2F1[9]=0;B2F1[10]=0;
  B2F1[11]=7;B2F1[12]=7;B2F1[13]=7;B2F1[14]=7;B2F1[15]=7;
  B2F1[16]=2;B2F1[17]=2;B2F1[18]=2;B2F1[19]=2;
  let B2F2:[]u8=z_alloc(20);
  B2F2[0]=1;B2F2[1]=1;B2F2[2]=1;B2F2[3]=1;B2F2[4]=1;B2F2[5]=1;
  B2F2[6]=0;B2F2[7]=0;B2F2[8]=0;B2F2[9]=0;B2F2[10]=0;B2F2[11]=0;
  B2F2[12]=7;B2F2[13]=7;B2F2[14]=7;B2F2[15]=7;
  B2F2[16]=2;B2F2[17]=2;B2F2[18]=2;B2F2[19]=2;
  if(fut_score3(W,Q,ST,0,B2F1,20,1,20,"B2 F-S1")!=1){ pass=0; }
  if(fut_score3(W,Q,ST,0,B2F2,20,1,20,"B2 F-S2")!=1){ pass=0; }
  let wB0:i32=select_win(W,Q,ST,0,20);
  let sB0:i32=is_strict(W,Q,ST,0,20,wB0);
  let selB0:i32=pressure(W,Q,ST,0,8);
  if(selB0!=1){ emit("B2-ev0 FAIL: expected LRU\n"); pass=0; }
  if(wB0!=selB0){ emit("B2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sB0==1){ strict_n=strict_n+1; }

  // ================= STREAM C2 =================
  emit("=== STREAM C2 (scan workload) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let CA:[]u8=z_alloc(40);
  let ci:i32=0;
  CA[ci]=5;ci=ci+1; t=0;
  while(t<4){CA[ci]=6;ci=ci+1;t=t+1;} t=0;
  while(t<10){CA[ci]=0;ci=ci+1;t=t+1;} t=0;
  while(t<2){CA[ci]=7;ci=ci+1;t=t+1;} t=0;
  while(t<2){CA[ci]=3;ci=ci+1;t=t+1;} t=0;
  while(t<3){CA[ci]=1;ci=ci+1;t=t+1;} t=0;
  while(t<4){CA[ci]=2;ci=ci+1;t=t+1;} t=0;
  while(t<4){CA[ci]=4;ci=ci+1;t=t+1;}
  run_seq(W, ST, Q, CA, ci);
  let CW:[]u8=z_alloc(20);
  CW[0]=6;CW[1]=6;CW[2]=5;CW[3]=5;CW[4]=0;CW[5]=7;CW[6]=7;
  CW[7]=3;CW[8]=3;CW[9]=1;CW[10]=1;CW[11]=2;CW[12]=4;CW[13]=7;
  CW[14]=3;CW[15]=1;CW[16]=2;CW[17]=4;CW[18]=7;CW[19]=3;
  run_seq(W, ST, Q, CW, 20);
  emit("C2: 50 queries.\n");
  if(band_check(W,Q,ST,0,2,"C2-ev0")==0){ pass=0; }
  sweep_print(W,Q,ST,0,"C2-ev0");
  let C2F1:[]u8=z_alloc(20);
  C2F1[0]=0;C2F1[1]=0;
  C2F1[2]=5;C2F1[3]=5;C2F1[4]=5;C2F1[5]=5;C2F1[6]=5;
  C2F1[7]=6;C2F1[8]=6;C2F1[9]=6;C2F1[10]=6;C2F1[11]=6;
  C2F1[12]=7;C2F1[13]=7;C2F1[14]=7;C2F1[15]=7;
  C2F1[16]=1;C2F1[17]=1;C2F1[18]=1;C2F1[19]=1;
  let C2F2:[]u8=z_alloc(20);
  C2F2[0]=0;
  C2F2[1]=5;C2F2[2]=5;C2F2[3]=5;C2F2[4]=5;C2F2[5]=5;C2F2[6]=5;
  C2F2[7]=6;C2F2[8]=6;C2F2[9]=6;C2F2[10]=6;C2F2[11]=6;
  C2F2[12]=7;C2F2[13]=7;C2F2[14]=7;C2F2[15]=7;
  C2F2[16]=1;C2F2[17]=1;C2F2[18]=1;C2F2[19]=1;
  if(fut_score3(W,Q,ST,0,C2F1,20,2,20,"C2 F-S1")!=1){ pass=0; }
  if(fut_score3(W,Q,ST,0,C2F2,20,2,20,"C2 F-S2")!=1){ pass=0; }
  let wC0:i32=select_win(W,Q,ST,0,20);
  let sC0:i32=is_strict(W,Q,ST,0,20,wC0);
  let selC0:i32=pressure(W,Q,ST,0,8);
  if(selC0!=2){ emit("C2-ev0 FAIL: expected FIFO\n"); pass=0; }
  if(wC0!=selC0){ emit("C2-ev0 FAIL: winner mismatch\n"); pass=0; }
  if(sC0==1){ strict_n=strict_n+1; }

  // K-M2-3 (retained): strict count from pre-pressure evaluations above
  emit("strict selections: "); emit(i32s(strict_n)); emit(" of 5\n");
  if(strict_n<3){ emit("K-M2-3 FAIL: fewer than 3 strict selections\n"); pass=0; }
  else { emit("K-M2-3 PASS: "); emit(i32s(strict_n)); emit(" strict selections\n"); }

  // ================= R5: FLAT BOUNDARY FIXTURE (X-M2-3 scope) =================
  emit("=== BOUNDARY FIXTURE: flat popularity (scope documentation, not a bar) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let FL:[]u8=z_alloc(40);
  let fi:i32=0; let rr:i32=0;
  while(rr<5){ let pp:i32=0; while(pp<8){ FL[fi]=pp; fi=fi+1; pp=pp+1; } rr=rr+1; }
  run_seq(W, ST, Q, FL, 40);
  emit("flat: 40 round-robin queries (each proc 5x)\n");
  emit("SCOPE-NOTE (X-M2-3): strictness is a (mechanism, skewed-regime) property;");
  emit(" on flat workloads the band degenerates to ties and the mechanism reports TIE.\n");
  let fw:i32=20;
  while(fw<=30){
    let fsw:i32=select_win(W,Q,ST,7,fw);
    let fst:i32=is_strict(W,Q,ST,7,fw,fsw);
    emit(" flat W="); emit(i32s(fw)); emit(":"); emit(pol_name(fsw));
    if(fst==1){ emit(" STRICT"); } else { emit(" TIE"); }
    fw=fw+5;
  }
  emit("\n");

  // ================= F-M7-3c: FALLBACK FIXTURE (all slots decayed-merit protected) =================
  // R6 supersession of the F-M6-3c fixture: under decayed merit the old
  // Q layout leaves slots 0,1,2 with decmerit 6,15,24 < 25, so the state
  // is no longer all-protected. Hand-built all-decayed-protected state:
  // every slot uses=2, seq=100 < prot_until=108, and every pid's queries
  // form a complementary recency pair summing to >= 25:
  //   pid0: pos 0,4,19   -> weights 1+5+20   = 26
  //   pid1: pos 1,5,18   -> weights 2+6+19   = 27
  //   pid2: pos 2,6,17   -> weights 3+7+18   = 28
  //   pid3: pos 3,7,16   -> weights 4+8+17   = 29
  //   pid4: pos 8,15     -> weights 9+16     = 25
  //   pid5: pos 9,14     -> weights 10+15    = 25
  //   pid6: pos 10,13    -> weights 11+14    = 25
  //   pid7: pos 11,12    -> weights 12+13    = 25
  // Per-policy replay costs are unchanged by construction (counts:
  // pid0..3: 3, pid4..7: 2), so the frozen expectations match F-M6-3c:
  // LFU/LRU/FIFO -> slot0 cost 3, LIFO -> slot7 cost 2, RANDOM -> slot6
  // cost 2, selected LIFO cost 2 TIE, fallback fires, proc8 stored.
  emit("=== F-M7-3c FALLBACK FIXTURE (all slots decayed-merit protected) ===\n");
  store_init(W, ST);
  st_set_seq(ST, 100);
  st_set_nq(ST, 20);
  Q[0]=0;Q[1]=1;Q[2]=2;Q[3]=3;Q[4]=0;Q[5]=1;Q[6]=2;Q[7]=3;
  Q[8]=4;Q[9]=5;Q[10]=6;Q[11]=7;Q[12]=7;Q[13]=6;Q[14]=5;Q[15]=4;
  Q[16]=3;Q[17]=2;Q[18]=1;Q[19]=0;
  let fb_si:i32=0;
  while(fb_si<8){ st_set(W,fb_si,1,fb_si,2,91+fb_si,fb_si,108); fb_si=fb_si+1; }
  emit("hand-built: all slots uses=2, seq=100 < prot_until=108, every slot decmerit >= 25 (complementary recency pairs), so every slot is decayed-merit protected\n");
  let fbsel:i32=pressure(W,Q,ST,9,8);
  if(st_fbf(ST)!=1){ emit("F-M7-3c FAIL: fallback flag not set\n"); pass=0; }
  else { emit("F-M7-3c check: fallback flag set, FALLBACK-ALL-PROTECTED emitted\n"); }
  if(fbsel!=3){ emit("F-M7-3c FAIL: expected unprotected LIFO, got "); emit(pol_name(fbsel)); emit("\n"); pass=0; }
  if(has_proc(W,8)==0){ emit("F-M7-3c FAIL: proc8 not stored after fallback\n"); pass=0; }
  else { emit("F-M7-3c PASS: fallback to unprotected argmin, newcomer stored, no crash\n"); }

  // ================= K-M4-1a / K-M4-2: X-M3-1 fixture on H-MEM4 =================
  // Exact replication of the H-MEM3 adversary's X-M3-1 stream (adv_m3_1).
  emit("=== K-M4-1a/K-M4-2: X-M3-1 fixture (merit probation + full counterfactual) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let M4A:[]u8=z_alloc(17);
  M4A[0]=0;M4A[1]=0;M4A[2]=0;M4A[3]=0;M4A[4]=1;M4A[5]=1;M4A[6]=1;M4A[7]=1;
  M4A[8]=2;M4A[9]=2;M4A[10]=3;M4A[11]=3;M4A[12]=4;M4A[13]=4;M4A[14]=5;M4A[15]=5;M4A[16]=7;
  run_seq(W, ST, Q, M4A, 17);
  let M4T:[]u8=z_alloc(20);
  M4T[0]=6;M4T[1]=6;M4T[2]=2;M4T[3]=2;M4T[4]=3;M4T[5]=3;M4T[6]=4;M4T[7]=4;M4T[8]=5;
  M4T[9]=2;M4T[10]=2;M4T[11]=2;M4T[12]=3;M4T[13]=3;M4T[14]=3;M4T[15]=4;M4T[16]=4;M4T[17]=5;M4T[18]=5;M4T[19]=5;
  run_seq(W, ST, Q, M4T, 20);
  let m4_sel0:i32=pressure(W,Q,ST,0,8);
  if(m4_sel0!=0){ emit("K-M4-1a FAIL: ev0 winner not LFU\n"); pass=0; }
  let M4B:[]u8=z_alloc(9);
  M4B[0]=6;M4B[1]=6;M4B[2]=6;M4B[3]=0;M4B[4]=0;M4B[5]=1;M4B[6]=1;M4B[7]=1;M4B[8]=2;
  run_seq(W, ST, Q, M4B, 9);
  // pre-pressure measurements at ev=1
  let m4_wprot:i32=argmin_pol(W,Q,ST,1,20,1);
  let m4_wun:i32=argmin_pol(W,Q,ST,1,20,0);
  let m4_vprot:i32=victim(W,Q,ST,m4_wprot,1,20,1);
  let m4_vun:i32=victim(W,Q,ST,m4_wun,1,20,0);
  let m4_cprot:i32=replay_cost(W,Q,ST,m4_vprot,20);
  emit("K-M4-1a: wprot="); emit(pol_name(m4_wprot));
  emit(" wun="); emit(pol_name(m4_wun));
  emit(" vprot=slot"); emit(i32s(m4_vprot));
  emit(" vun=slot"); emit(i32s(m4_vun));
  emit(" cprot="); emit(i32s(m4_cprot)); emit("\n");
  // K-M4-1a: the winner must be STABLE (R2 merit-gating removed the flip),
  // so the full counterfactual honestly reads 0 at the outcome level.
  if(m4_wprot!=0 || m4_wun!=0 || m4_vprot!=7 || m4_vun!=7 || m4_cprot!=0){
    emit("K-M4-1a FAIL: expected stable LFU, victim slot7, cost 0\n"); pass=0;
  } else {
    emit("K-M4-1a PASS: winner stable at LFU, eviction slot7(proc8); verdict must read CHURN-FULL:0\n");
  }
  let m4_sel1:i32=pressure(W,Q,ST,1,9);
  if(m4_sel1!=0){ emit("K-M4-2 FAIL: ev1 winner not LFU\n"); pass=0; }
  // K-M4-2: merit-based probation. proc8 (uses=0, meritless) must NOT be
  // shielded; the mechanism must evict it at cost 0, and proc0 survives.
  if(has_proc(W,8)==1){ emit("K-M4-2 FAIL: meritless proc8 still stored (shielded)\n"); pass=0; }
  else { emit("K-M4-2 check: meritless proc8 evicted\n"); }
  if(has_proc(W,0)==0){ emit("K-M4-2 FAIL: queried proc0 churned\n"); pass=0; }
  else { emit("K-M4-2 check: queried proc0 survives\n"); }
  if(has_proc(W,9)==0){ emit("K-M4-2 FAIL: proc9 not stored\n"); pass=0; }
  else { emit("K-M4-2 PASS: meritless newcomer evicted at cost 0; queried procedure survives\n"); }

  // ================= K-M5-3a: frozen setup_flip state (grace flip closed) =================
  // R4 supersession of K-M4-1b: slot7 (uses=0 < MERITK) is evictable
  // under protection, so the protected and unprotected outcomes
  // coincide. The old flip fixture now documents that the
  // grace-window flip no longer occurs.
  emit("=== K-M5-3a: frozen setup_flip state (grace-window flip closed) ===\n");
  setup_flip(W, ST, Q);
  let f_wprot:i32=argmin_pol(W,Q,ST,5,20,1);
  let f_vprot:i32=victim(W,Q,ST,f_wprot,5,20,1);
  let f_wun:i32=argmin_pol(W,Q,ST,5,20,0);
  let f_vun:i32=victim(W,Q,ST,f_wun,5,20,0);
  emit("flip state: wprot="); emit(pol_name(f_wprot));
  emit(" vprot=slot"); emit(i32s(f_vprot));
  emit(" wun="); emit(pol_name(f_wun));
  emit(" vun=slot"); emit(i32s(f_vun)); emit("\n");
  let f_cv:i32=churn_verdict(W,Q,ST,5,20,f_wprot,f_vprot,1);
  if(f_wprot!=0 || f_vprot!=7 || f_wun!=0 || f_vun!=7 || f_cv!=0){
    emit("K-M5-3a FAIL: expected wprot=LFU vprot=slot7, wun=LFU vun=slot7, verdict 0\n"); pass=0;
  } else {
    emit("K-M5-3a PASS: CHURN-FULL:0 honestly reports winner stable at LFU, eviction unchanged (grace flip closed)\n");
  }

  // ================= F-M6-3b: setup_flip3 (fresh merit; :1 path) =================
  // R5 supersession of K-M5-3b: setup_flip2's slot7 (uses=2, zero
  // window queries) is STALE merit under R5 and is no longer protected,
  // so the old flip no longer occurs there. setup_flip3 gives every
  // proc >= 2 in-window queries, so slot7's uses=2 merit is FRESH
  // (winuses=2 >= MERITK) and slot7 is protected under R5. The :1 path
  // is preserved with the same frozen shape: the protected winner
  // (FIFO) differs from the unprotected winner (LRU), proving fresh
  // merit protection is load-bearing: without it the winner would be
  // LRU, not FIFO.
  emit("=== F-M6-3b: setup_flip3 (fresh merit, :1 path) ===\n");
  setup_flip3(W, ST, Q);
  let g_wprot:i32=argmin_pol(W,Q,ST,5,20,1);
  let g_vprot:i32=victim(W,Q,ST,g_wprot,5,20,1);
  let g_wun:i32=argmin_pol(W,Q,ST,5,20,0);
  let g_vun:i32=victim(W,Q,ST,g_wun,5,20,0);
  emit("flip3 state: wprot="); emit(pol_name(g_wprot));
  emit(" vprot=slot"); emit(i32s(g_vprot));
  emit(" wun="); emit(pol_name(g_wun));
  emit(" vun=slot"); emit(i32s(g_vun)); emit("\n");
  let g_cv:i32=churn_verdict(W,Q,ST,5,20,g_wprot,g_vprot,1);
  if(g_wprot!=2 || g_vprot!=0 || g_wun!=1 || g_vun!=7 || g_cv!=1){
    emit("F-M6-3b FAIL: expected wprot=FIFO vprot=slot0, wun=LRU vun=slot7, verdict 1\n"); pass=0;
  } else {
    emit("F-M6-3b PASS: CHURN-FULL:1 honestly reports winner flips FIFO->LRU, eviction slot0(proc0)->slot7(proc7)\n");
  }

  // ================= K-M4-3: adversarial future + stronger independence =================
  emit("=== K-M4-3: adversarial future (X-M3-2a) + single-flip (X-M3-2b) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let M4AA:[]u8=z_alloc(33);
  let m4ai:i32=0;
  M4AA[m4ai]=5;m4ai=m4ai+1;M4AA[m4ai]=5;m4ai=m4ai+1;
  let m4t:i32=0;
  while(m4t<4){M4AA[m4ai]=0;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<4){M4AA[m4ai]=7;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<4){M4AA[m4ai]=3;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<4){M4AA[m4ai]=6;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<5){M4AA[m4ai]=1;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<5){M4AA[m4ai]=2;m4ai=m4ai+1;m4t=m4t+1;} m4t=0;
  while(m4t<5){M4AA[m4ai]=4;m4ai=m4ai+1;m4t=m4t+1;}
  run_seq(W, ST, Q, M4AA, m4ai);
  let M4AW:[]u8=z_alloc(20);
  M4AW[0]=6;M4AW[1]=6;M4AW[2]=5;M4AW[3]=0;M4AW[4]=0;M4AW[5]=0;M4AW[6]=0;
  M4AW[7]=7;M4AW[8]=7;M4AW[9]=7;M4AW[10]=7;M4AW[11]=3;M4AW[12]=3;M4AW[13]=3;M4AW[14]=3;
  M4AW[15]=1;M4AW[16]=1;M4AW[17]=2;M4AW[18]=2;M4AW[19]=4;
  run_seq(W, ST, Q, M4AW, 20);
  let m4_sel:i32=select_win(W,Q,ST,0,20);
  let m4_vadv:i32=victim(W,Q,ST,m4_sel,0,20,1);
  let m4_padv:i32=-1; if(m4_vadv>=0){m4_padv=st_pid(W,m4_vadv);}
  emit("K-M4-3: selected="); emit(pol_name(m4_sel));
  emit(" victim proc="); emit(i32s(m4_padv)); emit("\n");
  let FADV:[]u8=z_alloc(20);
  let m4i:i32=0;
  while(m4i<20){ FADV[m4i]=(m4_padv as u8); m4i=m4i+1; }
  let r3:i32=fut_score3(W,Q,ST,0,FADV,20,m4_sel,20,"A2 F-ADV");
  if(m4_sel!=0 || m4_padv!=5 || r3!=2){
    emit("K-M4-3a FAIL: expected selected LFU, victim proc5, EXCLUDED(2)\n"); pass=0;
  } else {
    emit("K-M4-3a PASS: adversarial future explicitly detected and excluded\n");
  }
  let FNEAR:[]u8=z_alloc(20);
  m4i=0;
  while(m4i<20){ FNEAR[m4i]=M4AW[m4i]; m4i=m4i+1; }
  FNEAR[0]=5;
  let dd_old:i32=dist_differs(Q,ST,FNEAR,20,20);
  let dd_new:i32=dist_differs2(Q,ST,FNEAR,20,20);
  emit("K-M4-3: single-flip dist_differs(old)="); emit(i32s(dd_old));
  emit(" dist_differs2(new)="); emit(i32s(dd_new)); emit("\n");
  if(dd_old!=1 || dd_new!=0){
    emit("K-M4-3b FAIL: expected old=1 (low bar passes), new=0 (strengthened rejects)\n"); pass=0;
  } else {
    emit("K-M4-3b PASS: strengthened check rejects the single-query flip\n");
  }

  // ================= K-M5-1: X-M4-2a fixture (grace-window harm closed) =================
  // Frozen from PREREG_MEM4_ADV.md: slot7 is a meritless newcomer
  // (proc7, uses=0, age=2) that H-MEM4 grace-protected. Under H-MEM5
  // (uses=0 < MERITK) slot7 is evictable under protection, so the
  // protected outcome coincides with the unprotected outcome: LFU
  // evicts slot7 at cost 0. The cost-0->2 harm does not occur.
  emit("=== K-M5-1: X-M4-2a fixture (grace-window harm closed) ===\n");
  store_init(W, ST);
  st_set_seq(ST, 100);
  st_set_nq(ST, 20);
  let h1_qi:i32=0;
  while(h1_qi<6){ Q[h1_qi]=0; h1_qi=h1_qi+1; }
  while(h1_qi<9){ Q[h1_qi]=1; h1_qi=h1_qi+1; }
  while(h1_qi<12){ Q[h1_qi]=2; h1_qi=h1_qi+1; }
  while(h1_qi<14){ Q[h1_qi]=3; h1_qi=h1_qi+1; }
  while(h1_qi<16){ Q[h1_qi]=4; h1_qi=h1_qi+1; }
  while(h1_qi<18){ Q[h1_qi]=5; h1_qi=h1_qi+1; }
  while(h1_qi<20){ Q[h1_qi]=6; h1_qi=h1_qi+1; }
  st_set(W,0,1,0,10,91,0,50); st_set(W,1,1,1,20,92,1,50);
  st_set(W,2,1,2,30,93,2,50); st_set(W,3,1,3,40,94,3,50);
  st_set(W,4,1,4,50,95,4,50); st_set(W,5,1,5,60,96,5,50);
  st_set(W,6,1,6,70,97,6,50); st_set(W,7,1,7,0,0,7,108);
  let h1_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let h1_vp:i32=victim(W,Q,ST,h1_wp,0,20,1);
  let h1_wu:i32=argmin_pol(W,Q,ST,0,20,0);
  let h1_vu:i32=victim(W,Q,ST,h1_wu,0,20,0);
  let h1_cp:i32=replay_cost(W,Q,ST,h1_vp,20);
  emit("harm-2a: wprot="); emit(pol_name(h1_wp));
  emit(" vprot=slot"); emit(i32s(h1_vp));
  emit(" wun="); emit(pol_name(h1_wu));
  emit(" vun=slot"); emit(i32s(h1_vu));
  emit(" cprot="); emit(i32s(h1_cp)); emit("\n");
  let h1_cv:i32=churn_verdict(W,Q,ST,0,20,h1_wp,h1_vp,1);
  if(h1_wp!=0 || h1_vp!=7 || h1_wu!=0 || h1_vu!=7 || h1_cp!=0 || h1_cv!=0){
    emit("K-M5-1 FAIL: harm recurred (expected LFU evicts slot7 at cost 0, verdict 0)\n"); pass=0;
  } else {
    emit("K-M5-1 PASS: grace-window harm closed; protected LFU evicts the meritless newcomer at cost 0\n");
  }

  // ================= K-M5-2: X-M4-2b fixture (fig-leaf merit closed) =================
  // Frozen from PREREG_MEM4_ADV.md: slot7 has uses=1 (one stale query
  // outside the 20-query window), age=3. Under H-MEM5 (uses=1 <
  // MERITK) slot7 is evictable under protection. The harm does not
  // occur behind the single stale query of merit.
  emit("=== K-M5-2: X-M4-2b fixture (fig-leaf merit closed) ===\n");
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 25);
  Q[0]=7; Q[1]=1; Q[2]=2; Q[3]=3; Q[4]=4;
  let h2_qi:i32=0;
  while(h2_qi<6){ Q[5+h2_qi]=0; h2_qi=h2_qi+1; }
  while(h2_qi<9){ Q[5+h2_qi]=1; h2_qi=h2_qi+1; }
  while(h2_qi<12){ Q[5+h2_qi]=2; h2_qi=h2_qi+1; }
  while(h2_qi<14){ Q[5+h2_qi]=3; h2_qi=h2_qi+1; }
  while(h2_qi<16){ Q[5+h2_qi]=4; h2_qi=h2_qi+1; }
  while(h2_qi<18){ Q[5+h2_qi]=5; h2_qi=h2_qi+1; }
  while(h2_qi<20){ Q[5+h2_qi]=6; h2_qi=h2_qi+1; }
  st_set(W,0,1,0,10,91,0,50); st_set(W,1,1,1,20,92,1,50);
  st_set(W,2,1,2,30,93,2,50); st_set(W,3,1,3,40,94,3,50);
  st_set(W,4,1,4,50,95,4,50); st_set(W,5,1,5,60,96,5,50);
  st_set(W,6,1,6,70,97,6,50); st_set(W,7,1,7,1,50,7,112);
  let h2_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let h2_vp:i32=victim(W,Q,ST,h2_wp,0,20,1);
  let h2_wu:i32=argmin_pol(W,Q,ST,0,20,0);
  let h2_vu:i32=victim(W,Q,ST,h2_wu,0,20,0);
  let h2_cp:i32=replay_cost(W,Q,ST,h2_vp,20);
  emit("harm-2b: wprot="); emit(pol_name(h2_wp));
  emit(" vprot=slot"); emit(i32s(h2_vp));
  emit(" wun="); emit(pol_name(h2_wu));
  emit(" vun=slot"); emit(i32s(h2_vu));
  emit(" cprot="); emit(i32s(h2_cp)); emit("\n");
  let h2_cv:i32=churn_verdict(W,Q,ST,0,20,h2_wp,h2_vp,1);
  if(h2_wp!=0 || h2_vp!=7 || h2_wu!=0 || h2_vu!=7 || h2_cp!=0 || h2_cv!=0){
    emit("K-M5-2 FAIL: harm recurred (expected LFU evicts slot7 at cost 0, verdict 0)\n"); pass=0;
  } else {
    emit("K-M5-2 PASS: fig-leaf harm closed; protected LFU evicts the uses=1 newcomer at cost 0\n");
  }

  // ================= K-M6-1: X-M5-1 fixture (stale merit expires) =================
  // Frozen from PREREG_MEM5_ADV.md: slot7 holds proc7 with uses=2, both
  // queries ancient (lastq=101, outside the 20-query operating window),
  // prot window open (seq=105 < prot=109). Under H-MEM6 (R5) merit is
  // window-scoped: winuses(proc7)=0 < MERITK, so slot7 is evictable
  // under protection. Protected LFU evicts slot7 at cost 0; the
  // X-M5-1 cost-0->2 harm does not occur.
  emit("=== K-M6-1: X-M5-1 fixture (stale merit expires) ===\n");
  setup_xm51(W, ST, Q, 2);
  let m6_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let m6_vp:i32=victim(W,Q,ST,m6_wp,0,20,1);
  let m6_wu:i32=argmin_pol(W,Q,ST,0,20,0);
  let m6_vu:i32=victim(W,Q,ST,m6_wu,0,20,0);
  let m6_cp:i32=replay_cost(W,Q,ST,m6_vp,20);
  emit("stale-merit: wprot="); emit(pol_name(m6_wp));
  emit(" vprot=slot"); emit(i32s(m6_vp));
  emit(" wun="); emit(pol_name(m6_wu));
  emit(" vun=slot"); emit(i32s(m6_vu));
  emit(" cprot="); emit(i32s(m6_cp)); emit("\n");
  let m6_cv:i32=churn_verdict(W,Q,ST,0,20,m6_wp,m6_vp,1);
  if(m6_wp!=0 || m6_vp!=7 || m6_wu!=0 || m6_vu!=7 || m6_cp!=0 || m6_cv!=0){
    emit("K-M6-1 FAIL: stale merit shielded (expected LFU evicts slot7 at cost 0, verdict 0)\n"); pass=0;
  } else {
    emit("K-M6-1 PASS: stale merit expires; protected LFU evicts slot7 at cost 0\n");
  }

  // ================= K-M6-2: X-M5-2 fixtures (no cliff at the margin) =================
  // The X-M5-2a (uses=1) and X-M5-2b (uses=2) fixtures are identical
  // except slot7's all-time uses; both are window-absent (winuses=0).
  // Under R5 the 1->2 all-time flip changes nothing: both yield
  // verdict 0 with identical (wprot, vprot, cprot). The knife-edge is
  // gone at the margin because the marginal query is ancient.
  emit("=== K-M6-2: X-M5-2 fixtures (no cliff at the margin) ===\n");
  setup_xm51(W, ST, Q, 1);
  let m6a_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let m6a_vp:i32=victim(W,Q,ST,m6a_wp,0,20,1);
  let m6a_cp:i32=replay_cost(W,Q,ST,m6a_vp,20);
  let m6a_cv:i32=churn_verdict(W,Q,ST,0,20,m6a_wp,m6a_vp,1);
  emit("cliff-1q: wprot="); emit(pol_name(m6a_wp));
  emit(" vprot=slot"); emit(i32s(m6a_vp));
  emit(" cprot="); emit(i32s(m6a_cp)); emit("\n");
  setup_xm51(W, ST, Q, 2);
  let m6b_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let m6b_vp:i32=victim(W,Q,ST,m6b_wp,0,20,1);
  let m6b_cp:i32=replay_cost(W,Q,ST,m6b_vp,20);
  let m6b_cv:i32=churn_verdict(W,Q,ST,0,20,m6b_wp,m6b_vp,1);
  emit("cliff-2q: wprot="); emit(pol_name(m6b_wp));
  emit(" vprot=slot"); emit(i32s(m6b_vp));
  emit(" cprot="); emit(i32s(m6b_cp)); emit("\n");
  if(m6a_wp!=0 || m6a_vp!=7 || m6a_cp!=0 || m6a_cv!=0 ||
     m6b_wp!=0 || m6b_vp!=7 || m6b_cp!=0 || m6b_cv!=0){
    emit("K-M6-2 FAIL: margin flip changed the outcome\n"); pass=0;
  } else {
    emit("K-M6-2 PASS: uses=1 and uses=2 both yield LFU evicts slot7 at cost 0, verdict 0 (no cliff)\n");
  }

  // ================= K-M7-1a: fresh query pair protects (recency-graded merit) =================
  // The in-window knife-edge, revisited under R6: two queries for proc7,
  // both fresh (positions 24,25; weights 19+20=39 >= 25). slot7 is
  // protected, so the protected winner (LFU -> slot0, cost 1) differs
  // from the unprotected winner (LRU -> slot0, cost 1): CHURN-FULL:1.
  // Under R5 this also read :1 (winuses=2); the discriminating bar is
  // K-M7-1b, where the same counts at stale recency read :0.
  emit("=== K-M7-1a: fresh query pair protects (decmerit=39) ===\n");
  setup_m7pair(W, ST, Q, 24, 25);
  let m7a_dm:i32=decmerit(W,ST,Q,7,20);
  emit("pair-fresh: decmerit(slot7)="); emit(i32s(m7a_dm)); emit("\n");
  let m7a_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let m7a_vp:i32=victim(W,Q,ST,m7a_wp,0,20,1);
  let m7a_cp:i32=replay_cost(W,Q,ST,m7a_vp,20);
  let m7a_wu:i32=argmin_pol(W,Q,ST,0,20,0);
  let m7a_vu:i32=victim(W,Q,ST,m7a_wu,0,20,0);
  let m7a_cv:i32=churn_verdict(W,Q,ST,0,20,m7a_wp,m7a_vp,1);
  emit("fresh: wprot="); emit(pol_name(m7a_wp));
  emit(" vprot=slot"); emit(i32s(m7a_vp));
  emit(" cprot="); emit(i32s(m7a_cp));
  emit(" wun="); emit(pol_name(m7a_wu));
  emit(" vun=slot"); emit(i32s(m7a_vu));
  emit(" verdict="); emit(i32s(m7a_cv)); emit("\n");
  if(m7a_dm!=39 || m7a_wp!=0 || m7a_vp!=0 || m7a_cp!=1 ||
     m7a_wu!=1 || m7a_vu!=0 || m7a_cv!=1){
    emit("K-M7-1a FAIL: fresh pair did not protect as derived\n"); pass=0;
  } else {
    emit("K-M7-1a PASS: fresh pair (decmerit=39) protects; winner flips LFU->LRU, verdict 1\n");
  }

  // ================= K-M7-1b: stale-in-window pair does NOT protect =================
  // Same counts as K-M7-1a (2 queries for proc7) but stale inside the
  // window (positions 6,7; weights 1+2=3 < 25). slot7 is evictable, so
  // protected and unprotected modes agree: LRU -> slot0 at cost 1,
  // CHURN-FULL:0. Under R5 this pair would protect (winuses=2) and read
  // :1: R6 distinguishes by recency where R5 could not.
  emit("=== K-M7-1b: stale-in-window query pair does not protect (decmerit=3) ===\n");
  setup_m7pair(W, ST, Q, 6, 7);
  let m7b_dm:i32=decmerit(W,ST,Q,7,20);
  emit("pair-stale: decmerit(slot7)="); emit(i32s(m7b_dm)); emit("\n");
  let m7b_wp:i32=argmin_pol(W,Q,ST,0,20,1);
  let m7b_vp:i32=victim(W,Q,ST,m7b_wp,0,20,1);
  let m7b_cp:i32=replay_cost(W,Q,ST,m7b_vp,20);
  let m7b_wu:i32=argmin_pol(W,Q,ST,0,20,0);
  let m7b_vu:i32=victim(W,Q,ST,m7b_wu,0,20,0);
  let m7b_cv:i32=churn_verdict(W,Q,ST,0,20,m7b_wp,m7b_vp,1);
  emit("stale: wprot="); emit(pol_name(m7b_wp));
  emit(" vprot=slot"); emit(i32s(m7b_vp));
  emit(" cprot="); emit(i32s(m7b_cp));
  emit(" wun="); emit(pol_name(m7b_wu));
  emit(" vun=slot"); emit(i32s(m7b_vu));
  emit(" verdict="); emit(i32s(m7b_cv)); emit("\n");
  if(m7b_dm!=3 || m7b_wp!=1 || m7b_vp!=0 || m7b_cp!=1 ||
     m7b_wu!=1 || m7b_vu!=0 || m7b_cv!=0){
    emit("K-M7-1b FAIL: stale-in-window pair protected (or wrong outcome)\n"); pass=0;
  } else {
    emit("K-M7-1b PASS: stale-in-window pair (decmerit=3) does not protect; modes agree, verdict 0\n");
  }

  // ================= K-M7-2: merit ramp (smooth decay, no window-edge step) =================
  // slot7: proc7, uses=2, age-open (seq=105 < prot=120). Its two queries
  // sit at Q[24],Q[25] (the newest). Appending filler queries for proc0
  // slides the window forward; each step drops both recency weights by 1.
  // Frozen: decmerit = 39-2k for k=0..8 (39,37,35,33,31,29,27,25,23);
  // elig = 0 (protected) for k=0..7, 1 (evictable) at k=8 when merit
  // falls below MTHRESH=25. The X-M6-3a step (binary flip when the 2nd
  // query crossed the window edge) is now a graded ramp: protection is
  // lost at k=8 while both queries are still inside the window. Under
  // R5 (count-based) the slot would stay protected until k=20.
  emit("=== K-M7-2: merit ramp (smooth decay, no window-edge step) ===\n");
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 26);
  let rq:i32=0;
  while(rq<24){ Q[rq]=0; rq=rq+1; }
  Q[24]=7; Q[25]=7;
  let rs:i32=0;
  while(rs<8){ st_set(W,rs,1,rs,2,90+rs,rs,50); rs=rs+1; }
  st_set(W,7,1,7,2,101,7,120);
  let rok:i32=1;
  let rk:i32=0;
  while(rk<9){
    let rdm:i32=decmerit(W,ST,Q,7,20);
    let rel:i32=elig(W,ST,Q,7,20,1);
    let rdm_exp:i32=39-2*rk;
    let rel_exp:i32=0;
    if(rk>=8){ rel_exp=1; }
    emit(" ramp k="); emit(i32s(rk));
    emit(" decmerit="); emit(i32s(rdm));
    emit(" elig="); emit(i32s(rel)); emit("\n");
    if(rdm!=rdm_exp || rel!=rel_exp){ rok=0; }
    if(rk<8){ st_query(W, ST, Q, 0); }
    rk=rk+1;
  }
  if(rok==0){ emit("K-M7-2 FAIL: ramp deviates from 39-2k or protection edge\n"); pass=0; }
  else { emit("K-M7-2 PASS: merit ramps 39..23 by 2/step; protection drops exactly when decmerit < 25 (k=8), both queries still in-window\n"); }

  // ================= K-M8-1a: short-window fresh pair protects (uniform lemma) =================
  // X-M7-3 repair under R7b (top-aligned weights). Fixture: nq=9 < 20,
  // slot7 learned at seq=0 (prot=10), 7 filler queries for pids 0..6,
  // then 2 fresh queries for pid7 at Q[7],Q[8] (the newest).
  // Top-aligned weights: 19+20=39 >= 25 -> protected. Under R6
  // (bottom-aligned) this exact state read 8+9=17 (evictable).
  emit("=== K-M8-1a: short-window fresh pair protects (decmerit=39) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 7);
  let s7a:i32=st_learn(W, ST, 7);
  let f81:i32=0;
  while(f81<7){ st_query(W, ST, Q, f81); f81=f81+1; }
  st_query(W, ST, Q, 7);
  st_query(W, ST, Q, 7);
  let k81a_dm:i32=decmerit(W,ST,Q,7,20);
  let k81a_el:i32=elig(W,ST,Q,7,20,1);
  emit(" short-window pair: nq="); emit(i32s(st_nq(ST)));
  emit(" seq="); emit(i32s(st_seq(ST)));
  emit(" decmerit(slot7)="); emit(i32s(k81a_dm));
  emit(" elig="); emit(i32s(k81a_el)); emit("\n");
  if(st_nq(ST)!=9 || st_seq(ST)!=9 || k81a_dm!=39 || k81a_el!=0){
    emit("K-M8-1a FAIL: short-window fresh pair did not protect as derived\n"); pass=0;
  } else {
    emit("K-M8-1a PASS: short-window (nq=9) fresh pair protects (decmerit=39); X-M7-3 repaired, lemma uniform\n");
  }

  // ================= K-M8-1b: short-window single newest query does NOT protect =================
  // The "single query is never merit" principle, verified uniformly in
  // a short window. Fixture: nq=9 < 20, one query for pid7 at Q[8]
  // (the newest, top-aligned weight 20 < 25).
  emit("=== K-M8-1b: short-window single newest query does not protect (decmerit=20) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 7);
  let s7b:i32=st_learn(W, ST, 7);
  let f82:i32=0;
  while(f82<7){ st_query(W, ST, Q, f82); f82=f82+1; }
  st_query(W, ST, Q, 0);
  st_query(W, ST, Q, 7);
  let k81b_dm:i32=decmerit(W,ST,Q,7,20);
  let k81b_el:i32=elig(W,ST,Q,7,20,1);
  emit(" short-window single: nq="); emit(i32s(st_nq(ST)));
  emit(" seq="); emit(i32s(st_seq(ST)));
  emit(" decmerit(slot7)="); emit(i32s(k81b_dm));
  emit(" elig="); emit(i32s(k81b_el)); emit("\n");
  if(st_nq(ST)!=9 || st_seq(ST)!=9 || k81b_dm!=20 || k81b_el!=1){
    emit("K-M8-1b FAIL: single newest query protected (or wrong state)\n"); pass=0;
  } else {
    emit("K-M8-1b PASS: short-window single newest query (decmerit=20) does not protect; single-never-merit uniform\n");
  }

  // ================= K-M8-2: inversion bound (X-M7-2 fixture, reconciled) =================
  // The X-M7-2 inversion instance, re-measured under R7b (nq=26 >= 20,
  // so decmerit is identical to R6). Frozen Q layout and slots from
  // PREREG_MEM7_ADV.md. The count-scale inversion (2 < 6) materializes
  // honestly; the bar verifies the theorem bound (<= 4) and the
  // mass-scale non-inversion (25 > 21).
  emit("=== K-M8-2: inversion bound (X-M7-2 fixture) ===\n");
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 26);
  Q[0]=1;Q[1]=2;Q[2]=3;Q[3]=4;Q[4]=5;Q[5]=6;
  Q[6]=0;Q[7]=0;Q[8]=0;Q[9]=0;Q[10]=0;Q[11]=0;
  Q[12]=1;Q[13]=2;Q[14]=3;Q[15]=4;Q[16]=5;
  Q[17]=7;Q[18]=7;
  Q[19]=6;Q[20]=1;Q[21]=2;Q[22]=3;Q[23]=4;Q[24]=5;Q[25]=6;
  st_set(W,0,1,0,3,91,0,109); st_set(W,1,1,1,110,92,1,50);
  st_set(W,2,1,2,120,93,2,50); st_set(W,3,1,3,130,94,3,50);
  st_set(W,4,1,4,140,95,4,50); st_set(W,5,1,5,150,96,5,50);
  st_set(W,6,1,6,160,97,6,50); st_set(W,7,1,7,2,101,7,109);
  let k82_dm7:i32=decmerit(W,ST,Q,7,20);
  let k82_el7:i32=elig(W,ST,Q,7,20,1);
  let k82_dm0:i32=decmerit(W,ST,Q,0,20);
  let k82_el0:i32=elig(W,ST,Q,0,20,1);
  let k82_wu7:i32=winuses(W,ST,Q,7,20);
  let k82_wu0:i32=winuses(W,ST,Q,0,20);
  let k82_vp:i32=victim(W,Q,ST,0,0,20,1);
  let k82_vu:i32=victim(W,Q,ST,0,0,20,0);
  let k82_c0:i32=replay_cost(W,Q,ST,0,20);
  let k82_c7:i32=replay_cost(W,Q,ST,7,20);
  emit(" inversion: decmerit(slot7)="); emit(i32s(k82_dm7));
  emit(" elig="); emit(i32s(k82_el7));
  emit(" decmerit(slot0)="); emit(i32s(k82_dm0));
  emit(" elig="); emit(i32s(k82_el0)); emit("\n");
  emit(" harm: winuses(slot7)="); emit(i32s(k82_wu7));
  emit(" winuses(slot0)="); emit(i32s(k82_wu0));
  emit(" LFUvp=slot"); emit(i32s(k82_vp));
  emit(" LFUvu=slot"); emit(i32s(k82_vu));
  emit(" c0="); emit(i32s(k82_c0));
  emit(" c7="); emit(i32s(k82_c7)); emit("\n");
  let k82_inv:i32=k82_c0-k82_c7;
  let k82_ok:i32=1;
  if(k82_dm7!=25){ k82_ok=0; }
  if(k82_el7!=0){ k82_ok=0; }
  if(k82_dm0!=21){ k82_ok=0; }
  if(k82_el0!=1){ k82_ok=0; }
  if(k82_wu7!=2){ k82_ok=0; }
  if(k82_wu0!=6){ k82_ok=0; }
  if(k82_vp!=0){ k82_ok=0; }
  if(k82_vu!=7){ k82_ok=0; }
  if(k82_c0!=6){ k82_ok=0; }
  if(k82_c7!=2){ k82_ok=0; }
  if(k82_inv>4){ k82_ok=0; }
  if(k82_dm7<=k82_dm0){ k82_ok=0; }
  if(st_seq(ST)>=st_prot(W,7)){ k82_ok=0; }
  if(st_seq(ST)>=st_prot(W,0)){ k82_ok=0; }
  if(k82_ok==0){
    emit("K-M8-2 FAIL: inversion fixture deviates from frozen derivation\n"); pass=0;
  } else {
    emit("K-M8-2 PASS: count-scale inversion 2<6 materializes honestly; bound 6-2=4<=4 (theorem); mass scale 25>21 not inverted\n");
  }

  if(pass==1){ emit("ALL BARS PASS\n"); return 0; }
  emit("SOME BAR FAILED\n");
  return 1;
}

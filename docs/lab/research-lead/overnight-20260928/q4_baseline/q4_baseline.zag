// q4_baseline.zag: simple baselines vs Q4 learner on F-PARCOND.
// Pure Zag. No Python. Prereg: 98ece92e4 (committed before implementation).
// F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3). Bits 0-2 only.

// ============ basics ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
fn get32(b:[]u8, off:i32)i32 {
  let a:i32=b[off] as i32;
  let bb:i32=b[off+1] as i32;
  let c:i32=b[off+2] as i32;
  let d:i32=b[off+3] as i32;
  let r1:i32=a | (bb<<8);
  let r2:i32=r1 | (c<<16);
  let r3:i32=r2 | (d<<24);
  return r3;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}
// state offsets: 16 rng_state (main), 20 rng_state (rand baseline)
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }

// ============ PRNG ============
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 16, ns);
  return ns;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return r % n;
}
fn r2_next(st:[]u8)i32 {
  let s:i32=stg(st, 20);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 20, ns);
  return ns;
}
fn r2_range(st:[]u8, n:i32)i32 {
  let r:i32=r2_next(st);
  return r % n;
}

// ============ sealed worlds (fam 5, 6 only) ============
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  if(fam==5){
    // F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3)
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let r:i32=t1 | t2;
    return r;
  }
  if(fam==6){
    // F-PARCOND-XOR: C' = D XOR X4
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let r:i32=d ^ x4;
    return r;
  }
  return 0;
}

// ============ passive evidence (verbatim protocol from q4_parcond.zag) ============
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    i=i+1;
  }
  return;
}

// ============ MEM: lookup table on (x1,x2,x3) ============
fn mem_train(ev_x:[]u8, ev_y:[]u8, en:i32, mem_y:[]u8, mem_seen:[]u8)void {
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let k:i32=x & 7;
    mem_y[k]=y as u8;
    mem_seen[k]=1;
    e=e+1;
  }
  return;
}
fn ev_maj(ev_y:[]u8, en:i32)i32 {
  let ones:i32=0;
  let e:i32=0;
  while(e<en){
    if(get32(ev_y, e*4)==1){ ones=ones+1; }
    e=e+1;
  }
  if(ones*2>=en){ return 1; }
  return 0;
}
fn mem_pred(x:i32, mem_y:[]u8, mem_seen:[]u8, maj:i32)i32 {
  let k:i32=x & 7;
  if(mem_seen[k]==1){ return mem_y[k] as i32; }
  return maj;
}
fn acc_mem(fam:i32, mem_y:[]u8, mem_seen:[]u8, maj:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    if(mem_pred(x, mem_y, mem_seen, maj)==sealed(fam, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}

// ============ 1NN: Hamming distance on bits 0-2 ============
fn ham3(a:i32, b:i32)i32 {
  let d:i32=(a ^ b) & 7;
  let c:i32=0;
  if((d & 1)==1){ c=c+1; }
  if((d & 2)==2){ c=c+1; }
  if((d & 4)==4){ c=c+1; }
  return c;
}
fn nn_pred(x:i32, ev_x:[]u8, ev_y:[]u8, en:i32)i32 {
  let best:i32=0;
  let bestd:i32=99;
  let e:i32=0;
  while(e<en){
    let ex:i32=get32(ev_x, e*4);
    let d:i32=ham3(x, ex);
    if(d<bestd){
      bestd=d;
      best=e;
    }
    e=e+1;
  }
  return get32(ev_y, best*4);
}
fn acc_nn(fam:i32, ev_x:[]u8, ev_y:[]u8, en:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    if(nn_pred(x, ev_x, ev_y, en)==sealed(fam, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}

// ============ LIN: grid search w1,w2,w3,b in {-1,0,1} ============
fn lin_train(ev_x:[]u8, ev_y:[]u8, en:i32, w:[]u8)void {
  let best_s:i32=-1;
  let best_nz:i32=99;
  let w1:i32=-1;
  while(w1<=1){
    let w2:i32=-1;
    while(w2<=1){
      let w3:i32=-1;
      while(w3<=1){
        let b:i32=-1;
        while(b<=1){
          let s:i32=0;
          let e:i32=0;
          while(e<en){
            let x:i32=get32(ev_x, e*4);
            let y:i32=get32(ev_y, e*4);
            let x1:i32=(x>>0)&1;
            let x2:i32=(x>>1)&1;
            let x3:i32=(x>>2)&1;
            let v:i32=w1*x1 + w2*x2 + w3*x3 + b;
            let p:i32=0;
            if(v>0){ p=1; }
            if(p==y){ s=s+1; }
            e=e+1;
          }
          let nz:i32=0;
          if(w1!=0){ nz=nz+1; }
          if(w2!=0){ nz=nz+1; }
          if(w3!=0){ nz=nz+1; }
          if(b!=0){ nz=nz+1; }
          let take:i32=0;
          if(s>best_s){ take=1; }
          else {
            if(s==best_s){
              if(nz<best_nz){ take=1; }
            }
          }
          if(take==1){
            best_s=s;
            best_nz=nz;
            set32(w, 0, w1);
            set32(w, 4, w2);
            set32(w, 8, w3);
            set32(w, 12, b);
          }
          b=b+1;
        }
        w3=w3+1;
      }
      w2=w2+1;
    }
    w1=w1+1;
  }
  return;
}
fn lin_pred(x:i32, w:[]u8)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let v:i32=get32(w,0)*x1 + get32(w,4)*x2 + get32(w,8)*x3 + get32(w,12);
  if(v>0){ return 1; }
  return 0;
}
fn acc_lin(fam:i32, w:[]u8)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    if(lin_pred(x, w)==sealed(fam, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}

// ============ RAND: seeded coin flip ============
fn acc_rand(st:[]u8, fam:i32)i32 {
  sts(st, 20, 999);
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    let p:i32=r2_range(st, 2);
    if(p==sealed(fam, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}

// ============ E3: draws to full 8-combo coverage ============
fn cover_draws(seed:i32)i32 {
  let st:[]u8=z_alloc(32);
  sts(st, 16, seed);
  let seen:[]u8=z_alloc(8);
  let cov:i32=0;
  let draws:i32=0;
  while(cov<8){
    let x:i32=rng_range(st, 64);
    let k:i32=x & 7;
    if(seen[k]==0){
      seen[k]=1;
      cov=cov+1;
    }
    draws=draws+1;
  }
  return draws;
}

// ============ main ============
fn main()void {
  emit("Q4-BASELINE\n");
  let st:[]u8=z_alloc(32);
  let ev_x:[]u8=z_alloc(32*4);
  let ev_y:[]u8=z_alloc(32*4);

  // ---- E1: matched 8 biased passive samples ----
  sts(st, 16, 123456789);
  passive(st, 5, ev_x, ev_y);
  let en:i32=8;
  // combo coverage of the 8 passive samples
  let cov_seen:[]u8=z_alloc(8);
  let cov:i32=0;
  let i:i32=0;
  while(i<8){
    let k:i32=get32(ev_x, i*4) & 7;
    if(cov_seen[k]==0){ cov_seen[k]=1; cov=cov+1; }
    i=i+1;
  }
  emit("E1 coverage="); e64(cov); emit("/8\n");
  // MEM
  let mem_y:[]u8=z_alloc(8);
  let mem_seen:[]u8=z_alloc(8);
  mem_train(ev_x, ev_y, en, mem_y, mem_seen);
  let maj:i32=ev_maj(ev_y, en);
  emit("E1 MEM "); e64(acc_mem(5, mem_y, mem_seen, maj)); emit("/64\n");
  // 1NN
  emit("E1 1NN "); e64(acc_nn(5, ev_x, ev_y, en)); emit("/64\n");
  // LIN
  let w:[]u8=z_alloc(16);
  lin_train(ev_x, ev_y, en, w);
  emit("E1 LIN "); e64(acc_lin(5, w)); emit("/64 w=");
  e64(get32(w,0)); emit(","); e64(get32(w,4)); emit(",");
  e64(get32(w,8)); emit(","); e64(get32(w,12)); emit("\n");
  // RAND
  emit("E1 RAND "); e64(acc_rand(st, 5)); emit("/64\n");

  // ---- E2: 8 passive + 24 uniform random (dumb sampler, same 32 budget) ----
  let j:i32=0;
  while(j<24){
    let x:i32=rng_range(st, 64);
    let y:i32=sealed(5, x);
    set32(ev_x, en*4, x);
    set32(ev_y, en*4, y);
    en=en+1;
    j=j+1;
  }
  // re-train MEM from scratch on all 32
  let mem_y2:[]u8=z_alloc(8);
  let mem_seen2:[]u8=z_alloc(8);
  mem_train(ev_x, ev_y, en, mem_y2, mem_seen2);
  let maj2:i32=ev_maj(ev_y, en);
  let cov2:i32=0;
  let cs2:[]u8=z_alloc(8);
  let q:i32=0;
  while(q<en){
    let k:i32=get32(ev_x, q*4) & 7;
    if(cs2[k]==0){ cs2[k]=1; cov2=cov2+1; }
    q=q+1;
  }
  emit("E2 coverage="); e64(cov2); emit("/8\n");
  emit("E2 MEM "); e64(acc_mem(5, mem_y2, mem_seen2, maj2)); emit("/64\n");
  emit("E2 1NN "); e64(acc_nn(5, ev_x, ev_y, en)); emit("/64\n");
  let w2:[]u8=z_alloc(16);
  lin_train(ev_x, ev_y, en, w2);
  emit("E2 LIN "); e64(acc_lin(5, w2)); emit("/64\n");
  emit("E2 RAND "); e64(acc_rand(st, 5)); emit("/64\n");

  // ---- E3: sample-to-coverage, seeds 1..20 ----
  let tot:i32=0;
  let mx:i32=0;
  let s:i32=1;
  while(s<=20){
    let d:i32=cover_draws(s);
    tot=tot+d;
    if(d>mx){ mx=d; }
    s=s+1;
  }
  emit("E3 total_draws="); e64(tot); emit(" mean_x10="); e64(tot*10/20);
  emit(" max="); e64(mx); emit(" (n=20 seeds)\n");

  // ---- E4: Phase-2 memorize-then-compose ----
  sts(st, 16, 555555555);
  passive(st, 6, ev_x, ev_y);
  let dtab:[]u8=z_alloc(8);
  let dseen:[]u8=z_alloc(8);
  let dcov:i32=0;
  let r:i32=0;
  while(r<8){
    let x:i32=get32(ev_x, r*4);
    let y:i32=get32(ev_y, r*4);
    let x4:i32=(x>>3)&1;
    let d:i32=y ^ x4;
    let k:i32=x & 7;
    if(dseen[k]==0){ dseen[k]=1; dcov=dcov+1; }
    dtab[k]=d as u8;
    r=r+1;
  }
  let maj6:i32=ev_maj(ev_y, 8);
  let c4:i32=0;
  let x4i:i32=0;
  while(x4i<64){
    let k:i32=x4i & 7;
    let dd:i32=maj6;
    if(dseen[k]==1){ dd=dtab[k] as i32; }
    let xa4:i32=(x4i>>3)&1;
    let p:i32=dd ^ xa4;
    if(p==sealed(6, x4i)){ c4=c4+1; }
    x4i=x4i+1;
  }
  emit("E4 Dcoverage="); e64(dcov); emit("/8 MEMCOMP "); e64(c4); emit("/64\n");
  emit("DONE\n");
  return;
}

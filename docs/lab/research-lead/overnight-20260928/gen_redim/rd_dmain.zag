// rd_dmain.zag -- GEN-REDIM diamond driver: main only.
// Setups (setup_d1, setup_d2) live in rbase.zag. No mechanism code.
// Structures are m0..m3; relations and entities are bare integers.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let AD1:[]u8=world_new_nm(4);
  setup_d1(AD1);
  c=gen_solve(AD1,B,c,202,1,2,5,4);
  c=gen_report(AD1,B,c,"GEN","Q1");
  c=gen_census(AD1,B,c,4);
  let AD2:[]u8=world_new_nm(4);
  setup_d2(AD2);
  c=gen_solve(AD2,B,c,202,1,2,5,4);
  c=gen_report(AD2,B,c,"GEN","Q2");
  o_flush(B,c);
  return 0;
}

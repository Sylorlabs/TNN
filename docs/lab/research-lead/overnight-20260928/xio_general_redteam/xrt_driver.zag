// xrt_driver.zag -- XIO-general red-team battery (unfrozen, new).
// Five adversarial attacks on the H-XIO-4 generalized XIO core
// (xio_core2.zag, frozen). The driver attacks the frozen core only;
// it never modifies the core, the base, or any frozen file.
//   B1 sclass defeat: chain graph with output-dead INC cells.
//       xio_sclass says 1 (mixed); behavior is chain (NODE output).
//       Probes misclassification and confident mis-staging.
//   B2 class -1 over-conservatism: sum graph with a MOVE epilogue
//       (INC x N on slot1, MOVE 0 <- 1). Behaviorally a correct sum;
//       structurally -1 (unknown). The meaningful chain->sum
//       composition fails closed.
//   B3 gate admits nonsense: S (class 1, behaviorally a chain) paired
//       with a genuine chain MAP (class 0). The sclass-difference gate
//       admits the same-type pair; the mis-staged handoff verifies
//       through the node-id/number collision and builds a wrong
//       adapter with a clean audit trail.
//   B4 class-2 stage on a non-sum INC-only graph: T is a constant
//       function (INC x K on an unread slot). The class-2 stage never
//       runs T's graph; it re-derives a sum licensed only by T's DEP
//       edges and builds a confident wrong adapter.
//   B5 exact A1 rerun: the old red-team A1 world against the new core.
//       Does sclass fix the structural-INC exclusion?
// Pure Zag. Safebin PATH. Zero em/en dashes in worker content.

// ---- shared world builders ----
fn xrt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){ ev_teach(W,5000+i,60+(i%10),6000+i); i=i+1; }
  return;
}
fn xrt_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1="); e64(y1); emit("\n");
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2="); e64(y2); emit("\n");
  return;
}
// first active MAP with relation field == r; -1 if none.
fn xrt_find_map_r(W:[]u8,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// step-counter chain graph: guard/set per link + INC slot1 per link,
// output = walked node (slot 0). Structural INC, NODE output.
// Same construction as the old red-team A1.
fn xrt_asm_stepchain(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    let ic:i32=t2_inc(W,1); if(ic<0){return -1;}
    ns(W,g,12,st); seq_link(W,st,ic);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  return root;
}
// sum graph with a MOVE epilogue: INC x total on slot1, then
// MOVE slot0 <- slot1. Behaviorally a correct total; structurally
// the walk sees INC cells plus one MOVE cell.
fn xrt_asm_summove(W:[]u8,total:i32)i32 {
  let root:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<total){
    let c:i32=t2_inc(W,1); if(c<0){return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  let mv:i32=t2_mov(W,0,1); if(mv<0){return -1;}
  seq_link(W,prev,mv);
  return root;
}
// constant graph: INC x k on slot2, which the frame leaves alone and
// no output reads except the root operand. Behaviorally the constant
// k for any input; structurally INC-only.
// (Slots 0..3 are the frame node's own fields; slots >= 4 alias
// through field-4 links into node 0 header state, so slot2 is used.)
fn xrt_asm_const(W:[]u8,k:i32)i32 {
  let root:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<k){
    let c:i32=t2_inc(W,2); if(c<0){return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  return root;
}
// promote a hand-built graph to a MAP node, mirroring promote_graph
// but WITHOUT ev_teach_in (no answer fact taught, no query poisoning).
fn xrt_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  return m;
}
// census of MAP structural classes.
fn xrt_census(W:[]u8)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("MAP id="); e64(m); emit(" r="); e64(ng(W,m,4));
      emit(" sclass="); e64(xio_sclass(W,m));
      emit(" oty="); e64(xio_oty(W,m)); emit("\n");
    }
    m=m+1;
  }
  return;
}
// pair census mirroring xio_try's sclass-difference gate.
fn xrt_pair_stats(W:[]u8)void {
  let c0:i32=0; let c1:i32=0; let c2:i32=0; let cm:i32=0;
  let gated:i32=0; let tried:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let s1:i32=xio_sclass(W,m1);
      if(s1==0){c0=c0+1;}
      else {if(s1==1){c1=c1+1;} else {if(s1==2){c2=c2+1;} else {cm=cm+1;}}}
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          if(s1==xio_sclass(W,m2)){gated=gated+1;} else {tried=tried+1;}
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("PAIRS c0="); e64(c0); emit(" c1="); e64(c1); emit(" c2="); e64(c2);
  emit(" cm1="); e64(cm); emit(" gated="); e64(gated);
  emit(" tried="); e64(tried); emit("\n");
  return;
}
fn xrt_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" c1="); e64(ng(W,n,12)); emit(" c2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28)); emit("\n");
    }
    n=n+1;
  }
  return;
}
// ============ B1: sclass defeat via output-dead INC cells ============
fn xrt_b1()void {
  emit("=== B1 SCLASS-DEFEAT ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  xrt_trainY(W,1);
  let f1:i32=ev_teach(W,21,81,22);
  let f2:i32=ev_teach(W,22,81,23);
  let f3:i32=ev_teach(W,23,81,24);
  let vv:[]u8=z_alloc(16);
  set32(vv,0,21); set32(vv,4,22); set32(vv,8,23); set32(vv,12,24);
  let ff:[]u8=z_alloc(12);
  set32(ff,0,f1); set32(ff,4,f2); set32(ff,8,f3);
  let root:i32=xrt_asm_stepchain(W,vv,4,ff);
  let S:i32=promote_graph(W,root,21,81,24,ff,3);
  emit("B1 S="); e64(S);
  emit(" sclass="); e64(xio_sclass(W,S));
  emit(" oty="); e64(xio_oty(W,S));
  emit(" exec="); e64(t2_exec(W,root,21));
  emit(" plen="); e64(rb_chain_plen(W,root));
  emit(" stage="); e64(xio_stage_exec(W,S,21));
  emit("\n");
  let Mc:i32=xrt_find_map_r(W,92);
  emit("B1 countMAP="); e64(Mc);
  emit(" sclass="); e64(xio_sclass(W,Mc));
  emit(" stage(50)="); e64(xio_stage_exec(W,Mc,50));
  emit("\n");
  ev_teach(W,24,82,25); ev_teach(W,25,82,26);
  xrt_gap(W);
  xrt_pair_stats(W);
  let a1:i32=xio_query(W,21,93,2,0,1);
  emit("B1 ans="); e64(a1); emit(" ");
  xrt_acensus(W);
  return;
}
// ============ B2: class -1 over-conservatism ============
fn xrt_b2()void {
  emit("=== B2 MINUS1-CONSERVATIVE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let g1:i32=ev_teach(W,60,84,3);
  let g2:i32=ev_teach(W,60,84,5);
  let gf:[]u8=z_alloc(8);
  set32(gf,0,g1); set32(gf,4,g2);
  let root:i32=xrt_asm_summove(W,8);
  let M:i32=xrt_promote(W,root,60,94,8,gf,2);
  emit("B2 M="); e64(M);
  emit(" sclass="); e64(xio_sclass(W,M));
  emit(" oty="); e64(xio_oty(W,M));
  emit(" exec0="); e64(t2_exec(W,root,0));
  emit(" stage(60)="); e64(xio_stage_exec(W,M,60));
  emit(" deprel="); e64(xio_dep_rel(W,M));
  emit("\n");
  ev_teach(W,31,81,32); ev_teach(W,32,81,33);
  let cq:i32=xio_query(W,31,91,33,0,1);
  emit("B2 chainq="); e64(cq); emit("\n");
  xrt_census(W);
  xrt_pair_stats(W);
  let z:i32=xio_query(W,31,95,8,0,1);
  emit("B2 comp ans="); e64(z); emit(" ");
  xrt_acensus(W);
  return;
}
// ============ B3: gate admits a same-type pair ============
fn xrt_b3()void {
  emit("=== B3 GATE-NONSENSE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let f1:i32=ev_teach(W,31,81,32);
  let f2:i32=ev_teach(W,32,81,33);
  let vv:[]u8=z_alloc(12);
  set32(vv,0,31); set32(vv,4,32); set32(vv,8,33);
  let ff:[]u8=z_alloc(8);
  set32(ff,0,f1); set32(ff,4,f2);
  let sroot:i32=xrt_asm_stepchain(W,vv,3,ff);
  let S:i32=promote_graph(W,sroot,31,81,33,ff,2);
  ev_teach(W,2,81,70); ev_teach(W,70,81,71);
  let cq:i32=xio_query(W,31,91,33,0,1);
  emit("B3 chainq="); e64(cq); emit("\n");
  let C:i32=xrt_find_map_r(W,91);
  emit("B3 S="); e64(S); emit(" sclass="); e64(xio_sclass(W,S));
  emit(" C="); e64(C); emit(" sclass="); e64(xio_sclass(W,C));
  emit(" execS="); e64(t2_exec(W,sroot,31));
  emit(" stageS="); e64(xio_stage_exec(W,S,31));
  emit("\n");
  xrt_pair_stats(W);
  let z:i32=xio_query(W,31,95,71,0,1);
  emit("B3 comp ans="); e64(z); emit(" ");
  xrt_acensus(W);
  ev_teach(W,41,81,42); ev_teach(W,42,81,43);
  let r1:i32=xio_query(W,41,95,-2,0,1);
  emit("B3 reuse41 ans="); e64(r1); emit("\n");
  return;
}
// ============ B4: class-2 stage on a non-sum INC-only graph ============
fn xrt_b4()void {
  emit("=== B4 CLASS2-GARBAGE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,31,81,32); ev_teach(W,32,81,33);
  let g1:i32=ev_teach(W,33,84,4);
  let g2:i32=ev_teach(W,33,84,6);
  let gf:[]u8=z_alloc(8);
  set32(gf,0,g1); set32(gf,4,g2);
  let troot:i32=xrt_asm_const(W,5);
  let T:i32=xrt_promote(W,troot,31,94,5,gf,2);
  let cq:i32=xio_query(W,31,91,33,0,1);
  emit("B4 chainq="); e64(cq); emit("\n");
  let C:i32=xrt_find_map_r(W,91);
  emit("B4 T="); e64(T); emit(" sclass="); e64(xio_sclass(W,T));
  emit(" oty="); e64(xio_oty(W,T));
  emit(" execT(31)="); e64(t2_exec(W,troot,31));
  emit(" execT(99)="); e64(t2_exec(W,troot,99));
  emit(" stageT(33)="); e64(xio_stage_exec(W,T,33));
  emit(" C="); e64(C); emit(" sclass="); e64(xio_sclass(W,C)); emit("\n");
  xrt_pair_stats(W);
  let z:i32=xio_query(W,31,95,10,0,1);
  emit("B4 comp ans="); e64(z); emit(" ");
  xrt_acensus(W);
  ev_teach(W,51,81,52); ev_teach(W,52,81,53);
  ev_teach(W,53,84,1); ev_teach(W,53,84,2);
  let r1:i32=xio_query(W,51,95,-2,0,1);
  emit("B4 reuse51 ans="); e64(r1); emit("\n");
  return;
}
// ============ B5: exact A1 rerun against the generalized core ============
fn xrt_b5()void {
  emit("=== B5 A1-RERUN ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  xrt_trainY(W,1);
  let f1:i32=ev_teach(W,21,81,22);
  let f2:i32=ev_teach(W,22,81,23);
  let f3:i32=ev_teach(W,23,81,24);
  let vv:[]u8=z_alloc(16);
  set32(vv,0,21); set32(vv,4,22); set32(vv,8,23); set32(vv,12,24);
  let ff:[]u8=z_alloc(12);
  set32(ff,0,f1); set32(ff,4,f2); set32(ff,8,f3);
  let root:i32=xrt_asm_stepchain(W,vv,4,ff);
  let S:i32=promote_graph(W,root,21,81,24,ff,3);
  emit("B5 S="); e64(S);
  emit(" sclass="); e64(xio_sclass(W,S));
  emit(" oty="); e64(xio_oty(W,S));
  emit(" exec="); e64(t2_exec(W,root,21)); emit("\n");
  ev_teach(W,24,82,25); ev_teach(W,25,82,26);
  xrt_gap(W);
  xrt_pair_stats(W);
  let a1:i32=xio_query(W,21,93,2,0,1);
  emit("B5 ans="); e64(a1); emit(" ");
  xrt_acensus(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  xrt_trainY(W2,1);
  ev_teach(W2,21,81,22); ev_teach(W2,22,81,23); ev_teach(W2,23,81,24);
  let c0:i32=xio_query(W2,21,91,24,0,1);
  emit("B5c train ans="); e64(c0); emit("\n");
  let C2:i32=xrt_find_map_r(W2,91);
  emit("B5c C="); e64(C2); emit(" sclass="); e64(xio_sclass(W2,C2)); emit("\n");
  ev_teach(W2,24,82,25); ev_teach(W2,25,82,26);
  xrt_gap(W2);
  xrt_pair_stats(W2);
  let a2:i32=xio_query(W2,21,93,2,0,1);
  emit("B5c ans="); e64(a2); emit(" ");
  xrt_acensus(W2);
  return;
}
// ev_query: the base's internal test battery references this symbol.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("XRT-START\n");
  xrt_b1(); xrt_b2(); xrt_b3(); xrt_b4(); xrt_b5();
  emit("XRT-END\n");
  return 0;
}

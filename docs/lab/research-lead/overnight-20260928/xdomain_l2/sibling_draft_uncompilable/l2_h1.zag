// l2_h1.zag -- H1 typed contracts + learner-driven REBIND (Level 2 adaptive reuse).
//
// Follows xdomain_typed/xt.zag: MAP inventory with learned typed I/O
// contracts, type-gated composition search, composite promotion.
// New: parameterized behaviors (SUM/MAX read a bindable relation field),
// a generic REBIND operator, and a two-phase solver. Phase 1 is exact L1
// reuse. Phase 2 scans the sealed world for candidate relations of the
// query subject, creates rebound MAP copies, and retries composition.
// The binding choice is learner-determined: type-contract filtering plus
// composition validation against the sealed goal. No researcher mapping.
//
// World: training facts bind SUM/MAX to the training relation (installed
// prior learning). Sealed facts for the fresh subject carry a distractor
// relation (inserted first) and the target relation. The sealed goal needs
// X rebound to the target relation, then Y.
//
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.
// Output: single preallocated buffer, one raw syscall write per workspace.

// ---------- runtime prelude ----------
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0
  while(i<s.len){ OUT[cur+i]=s[i] i=i+1 }
  return cur+s.len
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0
  let u:i64=v
  if(v<0){ neg=1 u=0-v }
  let nd:i32=1
  let t:i64=u
  while(t>=10){ t=t/10 nd=nd+1 }
  let p:i32=cur+neg+nd
  let k:i32=0
  let q:i64=u
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8
    q=q/10
    k=k+1
  }
  if(neg==1){ OUT[cur]=45 }
  return cur+neg+nd
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return ""}
  let p:*u8=_zag_malloc(n) as *u8
  if(p==null as *u8){return ""}
  let b:[]u8=p[0..n]
  let i:i32=0
  while(i<n){b[i]=0 i=i+1}
  return b
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8 b[off+1]=(v>>8) as u8 b[off+2]=(v>>16) as u8 b[off+3]=(v>>24) as u8
  return
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24)
}

// ---------- workspace layout ----------
// header: 0 tries, 4 nmaps, 8 z_id, 12 out_cur
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 8 entries x 48 bytes
//   (used,behav,in_sum,in_n,out_sum,out_n,sig_in,sig_out,comp_a,comp_b,param,rebound_of)
// output buffer: base 1024, 8192 bytes
fn obase()i32 { return 1024 }
fn l2_init(W:[]u8)void {
  put32(W,0,0) put32(W,4,0) put32(W,8,-1) put32(W,12,0)
  return
}
fn o_emit(W:[]u8,s:[]u8)void {
  let cur:i32=ig(W,12)
  if(cur+s.len>8000){ return }
  let nc:i32=e1str(W,obase()+cur,s)
  put32(W,12,nc-obase())
  return
}
fn o_num(W:[]u8,v:i32)void {
  let cur:i32=ig(W,12)
  if(cur+24>8000){ return }
  let nc:i32=e1i64(W,obase()+cur,v as i64)
  put32(W,12,nc-obase())
  return
}
fn o_nl(W:[]u8)void { o_emit(W,"\n") return }
fn o_flush(W:[]u8)void {
  let cur:i32=ig(W,12)
  let base:i64=(_zag_slice_ptr(W) as i64)+(obase() as i64)
  let wrc:i64=_zag_raw_syscall(1,1,base,(cur as i64),0,0,0)
  if(wrc<0){ return }
  return
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1) put32(W,64+i*12+4,s)
      put32(W,64+i*12+8,r) put32(W,64+i*12+12,o)
      return
    }
    i=i+1
  }
  return
}
// World setup. Training facts first, then sealed facts for the fresh
// subject: distractor relation inserted before the target relation so the
// candidate scan meets the distractor first.
fn l2_facts(W:[]u8)void {
  add_fact(W,101,71,5) add_fact(W,101,71,3) add_fact(W,101,71,7)
  add_fact(W,102,71,4) add_fact(W,102,71,6)
  add_fact(W,103,74,100)
  add_fact(W,103,73,6) add_fact(W,103,73,9)
  return
}
fn sum_rel(W:[]u8,s:i32,r:i32)i32 {
  let t:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      t=t+ig(W,64+i*12+12)
    }
    i=i+1
  }
  return t
}
fn max_rel(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=0 let found:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      let v:i32=ig(W,64+i*12+12)
      if(found==0 || v>best){ best=v found=1 }
    }
    i=i+1
  }
  return best
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1 }
    i=i+1
  }
  return 2
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,4)
  put32(W,4,m+1)
  let b:i32=544+m*48
  put32(W,b,1) put32(W,b+4,behav)
  put32(W,b+8,0) put32(W,b+12,0) put32(W,b+16,0) put32(W,b+20,0)
  put32(W,b+24,0) put32(W,b+28,0)
  put32(W,b+32,-1) put32(W,b+36,-1)
  put32(W,b+40,-1) put32(W,b+44,-1)
  return m
}
fn set_param(W:[]u8,m:i32,p:i32)void { put32(W,544+m*48+40,p) return }
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*48,0) return }
// A MAP is rebindable iff it carries a bindable parameter. Generic: the
// operator applies to any parameterized procedure, not to a named one.
fn is_bindable(W:[]u8,m:i32)i32 {
  if(ig(W,544+m*48+40)!=-1){ return 1 }
  return 0
}
// behaviors: 0=SUM(param), 1=ALLOC n/5, 2=IDENT, 3=MAX(param), 4=COMPOSITE
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=544+m*48
  let bh:i32=ig(W,b+4)
  if(bh==0){ return sum_rel(W,v,ig(W,b+40)) }
  if(bh==1){ return v/5 }
  if(bh==2){ return v }
  if(bh==3){ return max_rel(W,v,ig(W,b+40)) }
  let a:i32=ig(W,b+32) let c:i32=ig(W,b+36)
  let mid:i32=exec_map(W,a,v)
  return exec_map(W,c,mid)
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=544+m*48
  put32(W,b+8,ig(W,b+8)+probe_kind(W,vin))
  put32(W,b+12,ig(W,b+12)+1)
  put32(W,b+16,ig(W,b+16)+probe_kind(W,vout))
  put32(W,b+20,ig(W,b+20)+1)
  return
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=544+m*48
  let inn:i32=ig(W,b+12) let outn:i32=ig(W,b+20)
  if(inn>=2){
    let si:i32=1
    if(ig(W,b+8)*2>=inn*3){ si=2 }
    put32(W,b+24,si)
  }
  if(outn>=2){
    let so:i32=1
    if(ig(W,b+16)*2>=outn*3){ so=2 }
    put32(W,b+28,so)
  }
  return
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*48+24) }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*48+28) }
// Install prior learning. X and D1 are parameterized procedures bound to
// the training relation; Y is trained on X's own training outputs, so no
// value literals appear here. Signatures are learned from probe_kind
// observations only.
fn teach_all(W:[]u8)void {
  let x:i32=map_new(W,0)
  set_param(W,x,71)
  let rx1:i32=exec_map(W,x,101) record_obs(W,x,101,rx1)
  let rx2:i32=exec_map(W,x,102) record_obs(W,x,102,rx2)
  finalize_sig(W,x)
  o_emit(W,"TEACH X sig=") o_num(W,sig_in(W,x)) o_emit(W,"->") o_num(W,sig_out(W,x)) o_nl(W)
  let y:i32=map_new(W,1)
  let ry1:i32=exec_map(W,y,rx1) record_obs(W,y,rx1,ry1)
  let ry2:i32=exec_map(W,y,rx2) record_obs(W,y,rx2,ry2)
  finalize_sig(W,y)
  o_emit(W,"TEACH Y sig=") o_num(W,sig_in(W,y)) o_emit(W,"->") o_num(W,sig_out(W,y)) o_nl(W)
  let d1:i32=map_new(W,3)
  set_param(W,d1,71)
  let rd1:i32=exec_map(W,d1,101) record_obs(W,d1,101,rd1)
  rd1=exec_map(W,d1,102) record_obs(W,d1,102,rd1)
  finalize_sig(W,d1)
  o_emit(W,"TEACH D1 sig=") o_num(W,sig_in(W,d1)) o_emit(W,"->") o_num(W,sig_out(W,d1)) o_nl(W)
  let d2:i32=map_new(W,2)
  let rd2:i32=exec_map(W,d2,101) record_obs(W,d2,101,rd2)
  rd2=exec_map(W,d2,102) record_obs(W,d2,102,rd2)
  finalize_sig(W,d2)
  o_emit(W,"TEACH D2 sig=") o_num(W,sig_in(W,d2)) o_emit(W,"->") o_num(W,sig_out(W,d2)) o_nl(W)
  return
}
// Candidate relations: distinct r with (s,r,*) facts, in fact order.
// Generic scan of the sealed world; contains no domain knowledge.
fn collect_cands(W:[]u8,s:i32,out:[]u8)i32 {
  let n:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8)
      let k:i32=0 let seen:i32=0
      while(k<n){ if(ig(out,k*4)==r){ seen=1 } k=k+1 }
      if(seen==0 && n<8){ put32(out,n*4,r) n=n+1 }
    }
    i=i+1
  }
  return n
}
// REBIND operator: copy MAP m, set param to the candidate relation,
// inherit the learned signature and observations, record provenance.
// Generic machinery; the binding decision is made by the caller.
fn rebind_map(W:[]u8,m:i32,cr:i32)i32 {
  let nm:i32=ig(W,4)
  put32(W,4,nm+1)
  let sb:i32=544+m*48 let db:i32=544+nm*48
  let i:i32=0
  while(i<12){ put32(W,db+i*4,ig(W,sb+i*4)) i=i+1 }
  put32(W,db+40,cr)
  put32(W,db+44,m)
  return nm
}
fn promote_comp(W:[]u8,a:i32,b:i32,s:i32,r:i32)i32 {
  let z:i32=map_new(W,4)
  let zb:i32=544+z*48
  put32(W,zb+32,a) put32(W,zb+36,b)
  // composite contract = contract composition: in(A) -> out(B).
  // generic machinery; no per-MAP literals.
  put32(W,zb+24,sig_in(W,a))
  put32(W,zb+28,sig_out(W,b))
  record_obs(W,z,s,r)
  put32(W,8,z)
  return z
}
// L1 composition search: single MAPs, then ordered pairs, gated by the
// learned type contracts. Unmodified H1 mechanism logic.
fn try_all(W:[]u8,s:i32,target:i32,type_on:i32)i32 {
  let kin:i32=probe_kind(W,s)
  let kout:i32=probe_kind(W,target)
  let nm:i32=ig(W,4)
  let tries:i32=0
  let m:i32=0
  while(m<nm){
    if(ig(W,544+m*48)==1){
      let ok:i32=1
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0 }
        if(sig_out(W,m)!=kout){ ok=0 }
      }
      if(ok==1){
        tries=tries+1
        let r:i32=exec_map(W,m,s)
        o_emit(W,"TRY single m=") o_num(W,m) o_emit(W," r=") o_num(W,r) o_nl(W)
        if(r==target){ o_emit(W,"Z-SINGLE m=") o_num(W,m) o_nl(W) return tries }
      }
    }
    m=m+1
  }
  let a:i32=0
  while(a<nm){
    let b:i32=0
    while(b<nm){
      if(ig(W,544+a*48)==1 && ig(W,544+b*48)==1){
        let ok:i32=1
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0 }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0 }
          if(sig_out(W,b)!=kout){ ok=0 }
        }
        if(ok==1){
          tries=tries+1
          let mid:i32=exec_map(W,a,s)
          let r:i32=exec_map(W,b,mid)
          o_emit(W,"TRY pair a=") o_num(W,a) o_emit(W," b=") o_num(W,b) o_emit(W," r=") o_num(W,r) o_nl(W)
          if(r==target){
            let z:i32=promote_comp(W,a,b,s,r)
            o_emit(W,"Z-COMP z=") o_num(W,z) o_emit(W," a=") o_num(W,a) o_emit(W," b=") o_num(W,b) o_nl(W)
            o_emit(W,"Z-SIG ") o_num(W,sig_in(W,z)) o_emit(W,"->") o_num(W,sig_out(W,z)) o_nl(W)
            return tries
          }
        }
      }
      b=b+1
    }
    a=a+1
  }
  return 0-tries
}
// Two-phase solver. Phase 1: exact L1 reuse. Phase 2 (l2_on=1): for each
// bindable MAP and each sealed-world candidate relation, REBIND and retry
// composition. Validation against the sealed goal selects the binding.
fn solve_z_l2(W:[]u8,s:i32,target:i32,type_on:i32,l2_on:i32)i32 {
  let total:i32=0
  let t1:i32=try_all(W,s,target,type_on)
  if(t1>0){ return t1 }
  total=0-t1
  if(l2_on==0){ o_emit(W,"Z-FAIL\n") return 0-total }
  let n0:i32=ig(W,4)
  let cb:[]u8=z_alloc(64)
  let nc:i32=collect_cands(W,s,cb)
  o_emit(W,"L2-CANDS n=") o_num(W,nc) o_nl(W)
  let m:i32=0
  while(m<n0){
    if(ig(W,544+m*48)==1 && is_bindable(W,m)==1){
      let c:i32=0
      while(c<nc){
        let cr:i32=ig(cb,c*4)
        let rm:i32=rebind_map(W,m,cr)
        o_emit(W,"REBIND m=") o_num(W,m) o_emit(W," cr=") o_num(W,cr) o_emit(W," rm=") o_num(W,rm) o_nl(W)
        let t:i32=try_all(W,s,target,type_on)
        if(t>0){ return total+t }
        total=total+(0-t)
        c=c+1
      }
    }
    m=m+1
  }
  o_emit(W,"Z-FAIL\n")
  return 0-total
}
fn arm_treat(W:[]u8)i32 {
  o_emit(W,"=== TREAT-L2 ===\n")
  l2_facts(W) teach_all(W)
  let t:i32=solve_z_l2(W,103,3,1,1)
  let z:i32=ig(W,8)
  let ok:i32=0
  if(t>0 && z>=0){
    let zb:i32=ig(W,544+z*48+36)
    if(zb==1){
      let za:i32=ig(W,544+z*48+32)
      let ro:i32=ig(W,544+za*48+44)
      let pm:i32=ig(W,544+za*48+40)
      if(ro==0 && exec_map(W,z,103)==3){
        // pm must be a sealed-world candidate distinct from the training binding
        let cb:[]u8=z_alloc(64)
        let nc:i32=collect_cands(W,103,cb)
        let k:i32=0
        while(k<nc){ if(ig(cb,k*4)==pm && pm!=71){ ok=1 } k=k+1 }
      }
    }
  }
  if(ok==1){ o_emit(W,"ARM-RESULT PASS tries=") o_num(W,t) o_nl(W) }
  else { o_emit(W,"ARM-RESULT FAIL tries=") o_num(W,t) o_nl(W) }
  return ok
}
fn arm_l1only(W:[]u8)i32 {
  o_emit(W,"=== L1-ONLY ===\n")
  l2_facts(W) teach_all(W)
  let t:i32=solve_z_l2(W,103,3,1,0)
  if(t<=0){ o_emit(W,"ARM-RESULT PASS-expected-fail tries=") o_num(W,0-t) o_nl(W) return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve tries=") o_num(W,t) o_nl(W)
  return 0
}
fn arm_ablx(W:[]u8)i32 {
  o_emit(W,"=== ABL-X ===\n")
  l2_facts(W) teach_all(W)
  del_map(W,0)
  let t:i32=solve_z_l2(W,103,3,1,1)
  if(t<=0){ o_emit(W,"ARM-RESULT PASS-expected-fail tries=") o_num(W,0-t) o_nl(W) return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve tries=") o_num(W,t) o_nl(W)
  return 0
}
fn arm_ably(W:[]u8)i32 {
  o_emit(W,"=== ABL-Y ===\n")
  l2_facts(W) teach_all(W)
  del_map(W,1)
  let t:i32=solve_z_l2(W,103,3,1,1)
  if(t<=0){ o_emit(W,"ARM-RESULT PASS-expected-fail tries=") o_num(W,0-t) o_nl(W) return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve tries=") o_num(W,t) o_nl(W)
  return 0
}
fn arm_fresh(W:[]u8)i32 {
  o_emit(W,"=== FRESH ===\n")
  l2_facts(W)
  let t:i32=solve_z_l2(W,103,3,1,1)
  if(t<=0){ o_emit(W,"ARM-RESULT PASS-expected-fail tries=") o_num(W,0-t) o_nl(W) return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve tries=") o_num(W,t) o_nl(W)
  return 0
}
fn main()i32 {
  let W1:[]u8=z_alloc(9216) l2_init(W1) o_emit(W1,"L2-H1-START\n") let r1:i32=arm_treat(W1)
  let W2:[]u8=z_alloc(9216) l2_init(W2) let r2:i32=arm_l1only(W2)
  let W3:[]u8=z_alloc(9216) l2_init(W3) let r3:i32=arm_ablx(W3)
  let W4:[]u8=z_alloc(9216) l2_init(W4) let r4:i32=arm_ably(W4)
  let W5:[]u8=z_alloc(9216) l2_init(W5) let r5:i32=arm_fresh(W5)
  let tot:i32=r1+r2+r3+r4+r5
  o_emit(W1,"TOTAL ") o_num(W1,tot) o_emit(W1,"/5\n")
  o_emit(W1,"L2-H1-END\n")
  o_flush(W1) o_flush(W2) o_flush(W3) o_flush(W4) o_flush(W5)
  return 0
}

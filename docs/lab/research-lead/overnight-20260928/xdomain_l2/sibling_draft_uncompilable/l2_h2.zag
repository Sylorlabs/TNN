// l2_h2.zag -- H2 value composition + learner-driven REBIND (Level 2 adaptive reuse).
//
// Follows xdomain_causal_interv/ci_h2.zag: learned structures as FUNCTIONS,
// composition = sequential execution with value passing, ordered mode-pair
// search, two-stage verification, capability gate via has_behav.
// New: modes are parameterized by a relation. The L1 binding is the trained
// relation (installed prior learning). The L2 search scans the sealed world
// for candidate relations of the query subject and retries all ordered mode
// pairs under each candidate. The binding choice is learner-determined by
// value-level validation against the sealed goal. No researcher mapping.
//
// World: training facts under the training relation; sealed facts for the
// fresh subject carry a distractor relation (inserted first) and the target
// relation. The sealed goal needs SUM rebound to the target relation, then
// ALLOC.
//
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.
// Output: single preallocated buffer, one raw syscall write per workspace.

// ---------- runtime prelude ----------
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0
  while(i<s.len){ OUT[cur+i]=s[i] i=i+1 }
  return cur+s.len
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0
  let u:i64=v
  if(v<0){ neg=1 u=0-v }
  let nd:i32=1
  let t:i64=u
  while(t>=10){ t=t/10 nd=nd+1 }
  let p:i32=cur+neg+nd
  let k:i32=0
  let q:i64=u
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8
    q=q/10
    k=k+1
  }
  if(neg==1){ OUT[cur]=45 }
  return cur+neg+nd
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return ""}
  let p:*u8=_zag_malloc(n) as *u8
  if(p==null as *u8){return ""}
  let b:[]u8=p[0..n]
  let i:i32=0
  while(i<n){b[i]=0 i=i+1}
  return b
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8 b[off+1]=(v>>8) as u8 b[off+2]=(v>>16) as u8 b[off+3]=(v>>24) as u8
  return
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24)
}

// ---------- workspace ----------
// header: 0 nmaps, 4 z_id, 8 comp_m1, 12 comp_m2, 16 comp_rel, 20 learned_rel, 24 out_cur
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 8 entries x 40 bytes (used,behav)
// output buffer: base 1024, 8192 bytes
fn obase()i32 { return 1024 }
fn l2_init(W:[]u8)void {
  put32(W,0,0) put32(W,4,-1) put32(W,8,0) put32(W,12,0)
  put32(W,16,-1) put32(W,20,-1) put32(W,24,0)
  return
}
fn o_emit(W:[]u8,s:[]u8)void {
  let cur:i32=ig(W,24)
  if(cur+s.len>8000){ return }
  let nc:i32=e1str(W,obase()+cur,s)
  put32(W,24,nc-obase())
  return
}
fn o_num(W:[]u8,v:i32)void {
  let cur:i32=ig(W,24)
  if(cur+24>8000){ return }
  let nc:i32=e1i64(W,obase()+cur,v as i64)
  put32(W,24,nc-obase())
  return
}
fn o_nl(W:[]u8)void { o_emit(W,"\n") return }
fn o_flush(W:[]u8)void {
  let cur:i32=ig(W,24)
  let base:i64=(_zag_slice_ptr(W) as i64)+(obase() as i64)
  let wrc:i64=_zag_raw_syscall(1,1,base,(cur as i64),0,0,0)
  if(wrc<0){ return }
  return
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1) put32(W,64+i*12+4,s)
      put32(W,64+i*12+8,r) put32(W,64+i*12+12,o)
      return
    }
    i=i+1
  }
  return
}
// World setup. Same facts as the H1 lane: training under the training
// relation, sealed facts for the fresh subject with the distractor
// relation inserted before the target relation.
fn l2_facts(W:[]u8)void {
  add_fact(W,101,71,5) add_fact(W,101,71,3) add_fact(W,101,71,7)
  add_fact(W,102,71,4) add_fact(W,102,71,6)
  add_fact(W,103,74,100)
  add_fact(W,103,73,6) add_fact(W,103,73,9)
  return
}
fn sum_rel(W:[]u8,s:i32,r:i32)i32 {
  let t:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      t=t+ig(W,64+i*12+12)
    }
    i=i+1
  }
  return t
}
fn max_rel(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=0 let found:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      let v:i32=ig(W,64+i*12+12)
      if(found==0 || v>best){ best=v found=1 }
    }
    i=i+1
  }
  return best
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0)
  put32(W,0,m+1)
  let b:i32=544+m*40
  put32(W,b,1) put32(W,b+4,behav)
  return m
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*40,0) return }
// Capability evidence: mode m requires its behavior installed.
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0
  while(m<8){
    if(ig(W,544+m*40)==1 && ig(W,544+m*40+4)==bh){ return 1 }
    m=m+1
  }
  return 0
}
// Stage executors, parameterized by relation. Mode 1=SUM (behav 0),
// mode 2=ALLOC n/5 (behav 1), mode 3=MAX (behav 2, distractor).
fn vc_stage(W:[]u8,mode:i32,subj:i32,rel:i32)i32 {
  if(mode==1){
    if(has_behav(W,0)==0){ return -2 }
    return sum_rel(W,subj,rel)
  }
  if(mode==2){
    if(has_behav(W,1)==0){ return -2 }
    return subj/5
  }
  if(mode==3){
    if(has_behav(W,2)==0){ return -2 }
    return max_rel(W,subj,rel)
  }
  return -2
}
// Candidate relations: distinct r with (s,r,*) facts, in fact order.
// Generic scan of the sealed world; contains no domain knowledge.
fn collect_cands(W:[]u8,s:i32,out:[]u8)i32 {
  let n:i32=0 let i:i32=0
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8)
      let k:i32=0 let seen:i32=0
      while(k<n){ if(ig(out,k*4)==r){ seen=1 } k=k+1 }
      if(seen==0 && n<8){ put32(out,n*4,r) n=n+1 }
    }
    i=i+1
  }
  return n
}
// Value-level composition with relation rebinding. l2_on=0: exact L1 reuse
// under the trained relation. l2_on=1: retry all ordered mode pairs under
// each sealed-world candidate relation. UNMODIFIED H2 mechanism logic
// (ordered-pair search, value passing, two-stage verification); only the
// relation parameter and the L2 candidate loop are new.
fn vc_compose_l2(W:[]u8,s:i32,r:i32,expected:i32,l2_on:i32)i32 {
  let cb:[]u8=z_alloc(64)
  let nr:i32=0
  if(l2_on==1){ nr=collect_cands(W,s,cb) }
  else { put32(cb,0,ig(W,20)) nr=1 }
  o_emit(W,"L2-CANDS n=") o_num(W,nr) o_emit(W," l2=") o_num(W,l2_on) o_nl(W)
  let c:i32=0
  while(c<nr){
    let rel:i32=ig(cb,c*4)
    o_emit(W,"VC-REL ") o_num(W,rel) o_nl(W)
    let m1:i32=1
    while(m1<=3){
      let m2:i32=1
      while(m2<=3){
        let v1:i32=vc_stage(W,m1,s,rel)
        if(v1!=-2){
          o_emit(W,"VC-STAGE1 m=") o_num(W,m1) o_emit(W," v1=") o_num(W,v1) o_nl(W)
          let v2:i32=vc_stage(W,m2,v1,rel)
          if(v2!=-2){
            o_emit(W,"VC-STAGE2 m=") o_num(W,m2) o_emit(W," v2=") o_num(W,v2) o_nl(W)
            if(v2==expected){
              let cm:i32=map_new(W,3)
              put32(W,4,cm)
              put32(W,8,m1) put32(W,12,m2) put32(W,16,rel)
              o_emit(W,"VC-COMPOSE ok m1=") o_num(W,m1)
              o_emit(W," m2=") o_num(W,m2)
              o_emit(W," rel=") o_num(W,rel)
              o_emit(W," cm=") o_num(W,cm) o_nl(W)
              return v2
            }
          }
        }
        m2=m2+1
      }
      m1=m1+1
    }
    c=c+1
  }
  o_emit(W,"VC-COMPOSE fail\n")
  return -2
}
// Install prior learning: the three behaviors and the trained relation
// they were learned under.
fn teach_all(W:[]u8)void {
  let a:i32=map_new(W,0)
  o_emit(W,"TEACH SUM id=") o_num(W,a) o_nl(W)
  let b:i32=map_new(W,1)
  o_emit(W,"TEACH ALLOC id=") o_num(W,b) o_nl(W)
  let c:i32=map_new(W,2)
  o_emit(W,"TEACH MAX id=") o_num(W,c) o_nl(W)
  put32(W,20,71)
  return
}
fn arm_treat(W:[]u8)i32 {
  o_emit(W,"=== TREAT-L2 ===\n")
  l2_facts(W) teach_all(W)
  let ans:i32=vc_compose_l2(W,103,93,3,1)
  let ok:i32=0
  if(ans==3){
    let m1:i32=ig(W,8) let m2:i32=ig(W,12) let rl:i32=ig(W,16)
    if(m1==1 && m2==2 && rl!=71){
      // rl must be a sealed-world candidate discovered at solve time
      let cb:[]u8=z_alloc(64)
      let nc:i32=collect_cands(W,103,cb)
      let k:i32=0
      while(k<nc){ if(ig(cb,k*4)==rl){ ok=1 } k=k+1 }
    }
  }
  if(ok==1){ o_emit(W,"ARM-RESULT PASS\n") }
  else { o_emit(W,"ARM-RESULT FAIL\n") }
  return ok
}
fn arm_l1only(W:[]u8)i32 {
  o_emit(W,"=== L1-ONLY ===\n")
  l2_facts(W) teach_all(W)
  let ans:i32=vc_compose_l2(W,103,93,3,0)
  if(ans==-2){ o_emit(W,"ARM-RESULT PASS-expected-fail\n") return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve\n")
  return 0
}
fn arm_ablx(W:[]u8)i32 {
  o_emit(W,"=== ABL-X ===\n")
  l2_facts(W) teach_all(W)
  del_map(W,0)
  let ans:i32=vc_compose_l2(W,103,93,3,1)
  if(ans==-2){ o_emit(W,"ARM-RESULT PASS-expected-fail\n") return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve\n")
  return 0
}
fn arm_ably(W:[]u8)i32 {
  o_emit(W,"=== ABL-Y ===\n")
  l2_facts(W) teach_all(W)
  del_map(W,1)
  let ans:i32=vc_compose_l2(W,103,93,3,1)
  if(ans==-2){ o_emit(W,"ARM-RESULT PASS-expected-fail\n") return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve\n")
  return 0
}
fn arm_fresh(W:[]u8)i32 {
  o_emit(W,"=== FRESH ===\n")
  l2_facts(W)
  let ans:i32=vc_compose_l2(W,103,93,3,1)
  if(ans==-2){ o_emit(W,"ARM-RESULT PASS-expected-fail\n") return 1 }
  o_emit(W,"ARM-RESULT FAIL-unexpected-solve\n")
  return 0
}
fn main()i32 {
  let W1:[]u8=z_alloc(9216) l2_init(W1) o_emit(W1,"L2-H2-START\n") let r1:i32=arm_treat(W1)
  let W2:[]u8=z_alloc(9216) l2_init(W2) let r2:i32=arm_l1only(W2)
  let W3:[]u8=z_alloc(9216) l2_init(W3) let r3:i32=arm_ablx(W3)
  let W4:[]u8=z_alloc(9216) l2_init(W4) let r4:i32=arm_ably(W4)
  let W5:[]u8=z_alloc(9216) l2_init(W5) let r5:i32=arm_fresh(W5)
  let tot:i32=r1+r2+r3+r4+r5
  o_emit(W1,"TOTAL ") o_num(W1,tot) o_emit(W1,"/5\n")
  o_emit(W1,"L2-H2-END\n")
  o_flush(W1) o_flush(W2) o_flush(W3) o_flush(W4) o_flush(W5)
  return 0
}

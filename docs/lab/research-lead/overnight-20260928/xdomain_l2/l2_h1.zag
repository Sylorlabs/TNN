// l2_h1.zag -- Cross-domain L2 adaptive reuse: H1 typed contracts + REBIND.
//
// World, arms, and kill bars are frozen in PREREG.md (committed before any
// implementation). Mechanism logic follows xdomain_typed/xt.zag; only the
// world facts, the parameterized behaviors, and the L2 rebind search are new.
// Under test: whether the LEARNER drives relation rebinding (adaptation),
// not behavior induction (behaviors are installed as prior learning).
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 z_id, 8 solved, 12 tries, 16 out_cur, 20 arm_verdict
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 10 entries x 48 bytes
//   (used,behav,param,sig_in,sig_out,in_sum,in_n,out_sum,out_n,comp_a,comp_b,rebound_of)
// candidates: base 2048, 8 entries x 4 bytes
fn l2_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn l2_facts(W:[]u8)void {
  // Training facts, then sealed facts for the fresh subject.
  // The distractor relation is inserted before the genuine one, so the
  // candidate scan meets the distractor first (discrimination, not luck).
  add_fact(W,101,71,5); add_fact(W,101,71,3); add_fact(W,101,71,7);
  add_fact(W,102,71,4); add_fact(W,102,71,6);
  add_fact(W,103,74,100);
  add_fact(W,103,73,6); add_fact(W,103,73,9);
  return;
}
fn sum_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      n=n+ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return n;
}
fn max_rel(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=0; let f:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      let v:i32=ig(W,64+i*12+12);
      if(f==0 || v>m){ m=v; f=1; }
    }
    i=i+1;
  }
  return m;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=544+m*48;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,-1);
  put32(W,b+12,0); put32(W,b+16,0);
  put32(W,b+20,0); put32(W,b+24,0); put32(W,b+28,0); put32(W,b+32,0);
  put32(W,b+36,-1); put32(W,b+40,-1); put32(W,b+44,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*48,0); return; }
fn bind_param(W:[]u8,m:i32,subj:i32)void {
  // Bind the MAP's relation parameter to the relation observed in the
  // training facts for the training subject. Generic; no literals.
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==subj){
      put32(W,544+m*48+8,ig(W,64+i*12+8));
      return;
    }
    i=i+1;
  }
  return;
}
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=544+m*48;
  let bh:i32=ig(W,b+4);
  if(bh==0){ return sum_rel(W,v,ig(W,b+8)); }
  if(bh==1){ return v/5; }
  if(bh==2){ return max_rel(W,v,ig(W,b+8)); }
  if(bh==3){ return v; }
  let a:i32=ig(W,b+36); let c:i32=ig(W,b+40);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,c,mid);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=544+m*48;
  put32(W,b+20,ig(W,b+20)+probe_kind(W,vin));
  put32(W,b+24,ig(W,b+24)+1);
  put32(W,b+28,ig(W,b+28)+probe_kind(W,vout));
  put32(W,b+32,ig(W,b+32)+1);
  return;
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=544+m*48;
  let inn:i32=ig(W,b+24); let outn:i32=ig(W,b+32);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+20)*2>=inn*3){ si=2; }
    put32(W,b+12,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+28)*2>=outn*3){ so=2; }
    put32(W,b+16,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*48+12); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*48+16); }
fn rebind_map(W:[]u8,m:i32,cr:i32)i32 {
  // Generic REBIND operator: copy the MAP, set the bindable parameter to
  // the candidate relation, inherit the learned signature, record
  // rebound_of provenance. No domain knowledge.
  let nm:i32=map_new(W,ig(W,544+m*48+4));
  let nb:i32=544+nm*48;
  let ob:i32=544+m*48;
  put32(W,nb+8,cr);
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,ig(W,ob+16));
  put32(W,nb+44,m);
  return nm;
}
fn scan_candidates(W:[]u8,s:i32)i32 {
  // Generic candidate scan: distinct relations r with a fact (s,r,*),
  // first-seen order. Contains no domain knowledge.
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+k*4)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+n*4,r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn cand_rel(W:[]u8,i:i32)i32 { return ig(W,2048+i*4); }
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=544+z*48;
  put32(W,zb+36,a); put32(W,zb+40,b);
  // composite contract = generic contract composition: in(A) -> out(B).
  put32(W,zb+12,sig_in(W,a));
  put32(W,zb+16,sig_out(W,b));
  put32(W,4,z);
  return z;
}
fn teach_all(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  bind_param(W,x,101);
  let r:i32=exec_map(W,x,101); record_obs(W,x,101,r);
  r=exec_map(W,x,102); record_obs(W,x,102,r);
  finalize_sig(W,x);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,x)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,x));
  eS(W,OUT," param="); eN(W,OUT,ig(W,544+x*48+8)); eS(W,OUT,"\n");
  // Y is taught on X's training outputs (representative numeric inputs).
  // This teaches Y's signature only; it is not paired X+Y training for Z.
  let y:i32=map_new(W,1);
  let o1:i32=exec_map(W,x,101);
  r=exec_map(W,y,o1); record_obs(W,y,o1,r);
  let o2:i32=exec_map(W,x,102);
  r=exec_map(W,y,o2); record_obs(W,y,o2,r);
  finalize_sig(W,y);
  eS(W,OUT,"TEACH Y id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,y)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,y)); eS(W,OUT,"\n");
  let d1:i32=map_new(W,2);
  bind_param(W,d1,101);
  r=exec_map(W,d1,101); record_obs(W,d1,101,r);
  r=exec_map(W,d1,102); record_obs(W,d1,102,r);
  finalize_sig(W,d1);
  eS(W,OUT,"TEACH D1 id="); eN(W,OUT,d1);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,d1)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,d1));
  eS(W,OUT," param="); eN(W,OUT,ig(W,544+d1*48+8)); eS(W,OUT,"\n");
  let d2:i32=map_new(W,3);
  r=exec_map(W,d2,101); record_obs(W,d2,101,r);
  r=exec_map(W,d2,102); record_obs(W,d2,102,r);
  finalize_sig(W,d2);
  eS(W,OUT,"TEACH D2 id="); eN(W,OUT,d2);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,d2)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,d2)); eS(W,OUT,"\n");
  return;
}
// Two-phase solver. Phase 1 is exact L1 reuse. Phase 2 (l2_on=1) is the
// L2 adaptation: rebind each parameterized MAP to each candidate relation
// from the generic scan, then retry typed composition with the rebound MAP.
fn solve_z(W:[]u8,OUT:[]u8,s:i32,target:i32,type_on:i32,l2_on:i32)void {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,0);
  let tries:i32=0;
  put32(W,8,0);
  eS(W,OUT,"PHASE1 L1:\n");
  let m:i32=0;
  while(m<nm){
    if(ig(W,8)==0 && ig(W,544+m*48)==1){
      let ok:i32=1;
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        eS(W,OUT,"TRY single m="); eN(W,OUT,m); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
        if(r==target){
          eS(W,OUT,"Z-SINGLE m="); eN(W,OUT,m); eS(W,OUT,"\n");
          put32(W,8,1);
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,8)==0 && ig(W,544+a*48)==1 && ig(W,544+b*48)==1){
        let ok:i32=1;
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          eS(W,OUT,"TRY pair a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b);
          eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
          if(r==target){
            let z:i32=promote_comp(W,a,b);
            eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
            eS(W,OUT," a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
            eS(W,OUT,"Z-SIG "); eN(W,OUT,sig_in(W,z)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,z)); eS(W,OUT,"\n");
            put32(W,8,1);
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ig(W,8)==0){
    eS(W,OUT,"L1-FAIL\n");
  }
  if(ig(W,8)==1 || l2_on==0){
    if(ig(W,8)==1){ put32(W,12,tries); } else { put32(W,12,0-tries); }
    return;
  }
  eS(W,OUT,"PHASE2 L2:\n");
  let nc:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,nc);
  let ci0:i32=0;
  while(ci0<nc){
    eS(W,OUT," "); eN(W,OUT,cand_rel(W,ci0));
    ci0=ci0+1;
  }
  eS(W,OUT,"\n");
  let n0:i32=ig(W,0);
  let rm:i32=0;
  while(rm<n0){
    if(ig(W,8)==0 && ig(W,544+rm*48)==1 && ig(W,544+rm*48+8)>=0){
      let ci:i32=0;
      while(ci<nc){
        if(ig(W,8)==0){
          let cr:i32=cand_rel(W,ci);
          let nm2:i32=rebind_map(W,rm,cr);
          eS(W,OUT,"REBIND m="); eN(W,OUT,rm); eS(W,OUT," cr="); eN(W,OUT,cr);
          eS(W,OUT," nm="); eN(W,OUT,nm2); eS(W,OUT,"\n");
          let ok1:i32=1;
          if(type_on==1){
            if(sig_in(W,nm2)!=kin){ ok1=0; }
            if(sig_out(W,nm2)!=kout){ ok1=0; }
          }
          if(ok1==1){
            tries=tries+1;
            let r1:i32=exec_map(W,nm2,s);
            eS(W,OUT,"TRY single m="); eN(W,OUT,nm2); eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,"\n");
            if(r1==target){
              eS(W,OUT,"Z-RSINGLE m="); eN(W,OUT,nm2); eS(W,OUT,"\n");
              put32(W,4,nm2); put32(W,8,1);
            }
          }
          let b:i32=0;
          while(b<ig(W,0)){
            if(ig(W,8)==0 && ig(W,544+b*48)==1){
              let ok2:i32=1;
              if(type_on==1){
                if(sig_in(W,nm2)!=kin){ ok2=0; }
                if(sig_out(W,nm2)!=sig_in(W,b)){ ok2=0; }
                if(sig_out(W,b)!=kout){ ok2=0; }
              }
              if(ok2==1){
                tries=tries+1;
                let mid:i32=exec_map(W,nm2,s);
                let r:i32=exec_map(W,b,mid);
                eS(W,OUT,"TRY pair a="); eN(W,OUT,nm2); eS(W,OUT," b="); eN(W,OUT,b);
                eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
                if(r==target){
                  let z:i32=promote_comp(W,nm2,b);
                  eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
                  eS(W,OUT," a="); eN(W,OUT,nm2); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
                  eS(W,OUT,"Z-SIG "); eN(W,OUT,sig_in(W,z)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,z)); eS(W,OUT,"\n");
                  eS(W,OUT,"REBOUND a="); eN(W,OUT,nm2);
                  eS(W,OUT," param="); eN(W,OUT,ig(W,544+nm2*48+8));
                  eS(W,OUT," rebound_of="); eN(W,OUT,ig(W,544+nm2*48+44)); eS(W,OUT,"\n");
                  put32(W,8,1);
                }
              }
            }
            b=b+1;
          }
        }
        ci=ci+1;
      }
    }
    rm=rm+1;
  }
  if(ig(W,8)==1){ put32(W,12,tries); } else { eS(W,OUT,"L2-FAIL\n"); put32(W,12,0-tries); }
  return;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  l2_facts(W); teach_all(W,OUT);
  solve_z(W,OUT,103,3,1,1);
  let ok:i32=0;
  if(ig(W,8)==1){
    let z:i32=ig(W,4);
    let za:i32=ig(W,544+z*48+36);
    let zb:i32=ig(W,544+z*48+40);
    let ro:i32=ig(W,544+za*48+44);
    let pa:i32=ig(W,544+za*48+8);
    let px:i32=ig(W,544+8);
    // Provenance: comp_a is a rebound of X (id 0), comp_b is Y (id 1),
    // and the rebound parameter differs from the training binding.
    // The exact discovered value is learner-determined; the trace shows it.
    if(ro==0 && zb==1 && pa!=px){ ok=1; }
  }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  l2_facts(W); teach_all(W,OUT);
  solve_z(W,OUT,103,3,1,0);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ablx(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X ===\n");
  l2_facts(W); teach_all(W,OUT);
  del_map(W,0);
  solve_z(W,OUT,103,3,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ably(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y ===\n");
  l2_facts(W); teach_all(W,OUT);
  del_map(W,1);
  solve_z(W,OUT,103,3,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  l2_facts(W);
  solve_z(W,OUT,103,3,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  cur=e1str(OUT,cur,"L2-H1-START\n");
  let W1:[]u8=z_alloc(8192); l2_init(W1); put32(W1,16,cur);
  arm_treat(W1,OUT); cur=ig(W1,16); let v1:i32=ig(W1,20);
  let W2:[]u8=z_alloc(8192); l2_init(W2); put32(W2,16,cur);
  arm_l1only(W2,OUT); cur=ig(W2,16); let v2:i32=ig(W2,20);
  let W3:[]u8=z_alloc(8192); l2_init(W3); put32(W3,16,cur);
  arm_ablx(W3,OUT); cur=ig(W3,16); let v3:i32=ig(W3,20);
  let W4:[]u8=z_alloc(8192); l2_init(W4); put32(W4,16,cur);
  arm_ably(W4,OUT); cur=ig(W4,16); let v4:i32=ig(W4,20);
  let W5:[]u8=z_alloc(8192); l2_init(W5); put32(W5,16,cur);
  arm_fresh(W5,OUT); cur=ig(W5,16); let v5:i32=ig(W5,20);
  let tot:i32=v1+v2+v3+v4+v5;
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/5\n");
  cur=e1str(OUT,cur,"L2-H1-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

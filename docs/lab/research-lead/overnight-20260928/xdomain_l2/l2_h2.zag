// l2_h2.zag -- Cross-domain L2 adaptive reuse: H2 value composition + REBIND.
//
// World, arms, and kill bars are frozen in PREREG.md (committed before any
// implementation). Mechanism logic follows xdomain_causal_interv/ci_h2.zag:
// ordered mode pairs, value passing between stages, capability evidence via
// has_behav. New: the modes execute with a relation parameter; Phase 1 uses
// the training binding, Phase 2 (L2) retries every ordered pair under each
// candidate relation from the generic sealed-world scan.
// Under test: whether the LEARNER discovers the right relation binding,
// not behavior induction (modes are installed as prior learning).
//
// Modes: 1=SUM (needs behav 0), 2=ALLOC (needs behav 1), 3=MAX (needs behav 2,
// distractor). Sealed Z needs (SUM,ALLOC) under the rebound relation.
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_m1, 8 comp_m2, 12 comp_rel, 16 out_cur,
//         20 arm_verdict, 24 rel_train
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 8 entries x 8 bytes (used,behav)
// candidates: base 2048, 8 entries x 4 bytes
fn vc_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,0); put32(W,12,0); put32(W,20,0); put32(W,24,0);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn l2_facts(W:[]u8)void {
  // Training facts, then sealed facts for the fresh subject.
  // The distractor relation is inserted before the genuine one, so the
  // candidate scan meets the distractor first (discrimination, not luck).
  add_fact(W,101,71,5); add_fact(W,101,71,3); add_fact(W,101,71,7);
  add_fact(W,102,71,4); add_fact(W,102,71,6);
  add_fact(W,103,74,100);
  add_fact(W,103,73,6); add_fact(W,103,73,9);
  return;
}
fn sum_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      n=n+ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return n;
}
fn max_rel(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=0; let f:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      let v:i32=ig(W,64+i*12+12);
      if(f==0 || v>m){ m=v; f=1; }
    }
    i=i+1;
  }
  return m;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  put32(W,544+m*8,1); put32(W,544+m*8+4,behav);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*8,0); return; }
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0;
  while(m<8){
    if(ig(W,544+m*8)==1 && ig(W,544+m*8+4)==bh){ return 1; }
    m=m+1;
  }
  return 0;
}
fn train_rel(W:[]u8)i32 {
  // Discover the training relation from the training subject's facts.
  // Generic; no literals.
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==101){
      return ig(W,64+i*12+8);
    }
    i=i+1;
  }
  return -1;
}
// Stage executors. SUM/MAX take the relation under test; each requires its
// learned behavior as capability evidence (mirrors H2's capability gate).
fn sum_exec(W:[]u8,s:i32,rel:i32)i32 {
  if(has_behav(W,0)==0){ return -2; }
  return sum_rel(W,s,rel);
}
fn alloc_exec(W:[]u8,s:i32)i32 {
  if(has_behav(W,1)==0){ return -2; }
  return s/5;
}
fn max_exec(W:[]u8,s:i32,rel:i32)i32 {
  if(has_behav(W,2)==0){ return -2; }
  return max_rel(W,s,rel);
}
fn vc_stage(W:[]u8,mode:i32,subj:i32,rel:i32)i32 {
  if(mode==1){ return sum_exec(W,subj,rel); }
  if(mode==2){ return alloc_exec(W,subj); }
  if(mode==3){ return max_exec(W,subj,rel); }
  return -2;
}
fn scan_candidates(W:[]u8,s:i32)i32 {
  // Generic candidate scan: distinct relations r with a fact (s,r,*),
  // first-seen order. Contains no domain knowledge.
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+k*4)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+n*4,r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn cand_rel(W:[]u8,i:i32)i32 { return ig(W,2048+i*4); }
fn teach_all(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x); eS(W,OUT,"\n");
  let y:i32=map_new(W,1);
  eS(W,OUT,"TEACH Y id="); eN(W,OUT,y); eS(W,OUT,"\n");
  let d:i32=map_new(W,2);
  eS(W,OUT,"TEACH D id="); eN(W,OUT,d); eS(W,OUT,"\n");
  put32(W,24,train_rel(W));
  eS(W,OUT,"TEACH rel_train="); eN(W,OUT,ig(W,24)); eS(W,OUT,"\n");
  return;
}
// Try one ordered pair under one relation. Records the composite on success.
fn vc_try_pair(W:[]u8,OUT:[]u8,m1:i32,m2:i32,s:i32,rel:i32,expected:i32)void {
  let v1:i32=vc_stage(W,m1,s,rel);
  if(v1==-2){ return; }
  eS(W,OUT,"VC-STAGE1 m="); eN(W,OUT,m1); eS(W,OUT," rel="); eN(W,OUT,rel);
  eS(W,OUT," v1="); eN(W,OUT,v1); eS(W,OUT,"\n");
  let v2:i32=vc_stage(W,m2,v1,rel);
  if(v2==-2){ return; }
  eS(W,OUT,"VC-STAGE2 m="); eN(W,OUT,m2); eS(W,OUT," v2="); eN(W,OUT,v2); eS(W,OUT,"\n");
  if(v2==expected){
    put32(W,4,m1); put32(W,8,m2); put32(W,12,rel);
    eS(W,OUT,"VC-COMPOSE ok m1="); eN(W,OUT,m1);
    eS(W,OUT," m2="); eN(W,OUT,m2);
    eS(W,OUT," rel="); eN(W,OUT,rel); eS(W,OUT,"\n");
  }
  return;
}
// Two-phase value composition. Phase 1 uses the training binding (L1).
// Phase 2 (l2_on=1) retries every ordered pair under each candidate
// relation from the generic scan (L2 adaptation).
fn vc_compose_l2(W:[]u8,OUT:[]u8,s:i32,expected:i32,l2_on:i32)void {
  let rel0:i32=ig(W,24);
  eS(W,OUT,"PHASE1 L1 rel="); eN(W,OUT,rel0); eS(W,OUT,"\n");
  let m1:i32=1;
  while(m1<=3){
    let m2:i32=1;
    while(m2<=3){
      if(ig(W,4)==0){ vc_try_pair(W,OUT,m1,m2,s,rel0,expected); }
      m2=m2+1;
    }
    m1=m1+1;
  }
  if(ig(W,4)!=0){ return; }
  eS(W,OUT,"L1-FAIL\n");
  if(l2_on==0){ return; }
  eS(W,OUT,"PHASE2 L2:\n");
  let nc:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,nc);
  let ck:i32=0;
  while(ck<nc){
    eS(W,OUT," "); eN(W,OUT,cand_rel(W,ck));
    ck=ck+1;
  }
  eS(W,OUT,"\n");
  let ci:i32=0;
  while(ci<nc){
    if(ig(W,4)==0){
      let cr:i32=cand_rel(W,ci);
      eS(W,OUT,"REBIND-REL cr="); eN(W,OUT,cr); eS(W,OUT,"\n");
      let a:i32=1;
      while(a<=3){
        let b:i32=1;
        while(b<=3){
          if(ig(W,4)==0){ vc_try_pair(W,OUT,a,b,s,cr,expected); }
          b=b+1;
        }
        a=a+1;
      }
    }
    ci=ci+1;
  }
  if(ig(W,4)==0){ eS(W,OUT,"L2-FAIL\n"); }
  return;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  l2_facts(W); teach_all(W,OUT);
  vc_compose_l2(W,OUT,103,3,1);
  let ok:i32=0;
  // Composite records m1=SUM, m2=ALLOC, with a relation binding that differs
  // from the training binding (adaptation). The discovered value shows in
  // the trace; no literal is baked into this check.
  if(ig(W,4)==1 && ig(W,8)==2 && ig(W,12)!=ig(W,24)){ ok=1; }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  l2_facts(W); teach_all(W,OUT);
  vc_compose_l2(W,OUT,103,3,0);
  if(ig(W,4)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ablx(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X ===\n");
  l2_facts(W); teach_all(W,OUT);
  del_map(W,0);
  vc_compose_l2(W,OUT,103,3,1);
  if(ig(W,4)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ably(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y ===\n");
  l2_facts(W); teach_all(W,OUT);
  del_map(W,1);
  vc_compose_l2(W,OUT,103,3,1);
  if(ig(W,4)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  l2_facts(W);
  vc_compose_l2(W,OUT,103,3,1);
  if(ig(W,4)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  cur=e1str(OUT,cur,"L2-H2-START\n");
  let W1:[]u8=z_alloc(8192); vc_init(W1); put32(W1,16,cur);
  arm_treat(W1,OUT); cur=ig(W1,16); let v1:i32=ig(W1,20);
  let W2:[]u8=z_alloc(8192); vc_init(W2); put32(W2,16,cur);
  arm_l1only(W2,OUT); cur=ig(W2,16); let v2:i32=ig(W2,20);
  let W3:[]u8=z_alloc(8192); vc_init(W3); put32(W3,16,cur);
  arm_ablx(W3,OUT); cur=ig(W3,16); let v3:i32=ig(W3,20);
  let W4:[]u8=z_alloc(8192); vc_init(W4); put32(W4,16,cur);
  arm_ably(W4,OUT); cur=ig(W4,16); let v4:i32=ig(W4,20);
  let W5:[]u8=z_alloc(8192); vc_init(W5); put32(W5,16,cur);
  arm_fresh(W5,OUT); cur=ig(W5,16); let v5:i32=ig(W5,20);
  let tot:i32=v1+v2+v3+v4+v5;
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/5\n");
  cur=e1str(OUT,cur,"L2-H2-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

// xhio_driver.zag -- H-XIO-2 harder-pair world, arms, census, main.
// Unfrozen. The ONLY new source this wave. The adapter mechanism is
// reused verbatim from ../xio_adapters/xio_core.zag (see assembly
// recipe in NAMECHECK.md); nothing in it was copied or edited.
//
// Harder pair: transform-then-navigate.
// X = COUNT (node -> number, oty 1): r=81 facts, query r=91.
// Y = CHAIN on numeric subjects (number -> node, oty 0): r=82 facts,
// query r=92.
// Z = Y(X(s)): query (21,93) -> 52. Requires count(21)=4 (a COMPUTED
// number), then re-subjecting the chain stage to 4: 4->50->51->52.
// Arms: TREAT, ABL-XIO (adapters off), ABL-X (count MAPs deleted),
// ABL-Y (chain MAPs deleted), FRESH.

fn xhio_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn xhio_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, structural class.
fn xhio_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(o==1){emit("count");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn xhio_census(W:[]u8)void {
  emit("maps="); e64(xhio_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){xhio_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, typed signature, relations, answer.
fn xhio_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn xhio_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn xhio_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xhio_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,3,0,xon);
  emit("X1 ans="); e64(x1); xhio_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17);
  let x2:i32=xio_query(W,15,91,2,0,xon);
  emit("X2 ans="); e64(x2); xhio_tstat(W);
  return;
}
fn xhio_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,3,82,30); ev_teach(W,30,82,31); ev_teach(W,31,82,32);
  let y1:i32=xio_query(W,3,92,32,0,xon);
  emit("Y1 ans="); e64(y1); xhio_tstat(W);
  ev_teach(W,2,82,40); ev_teach(W,40,82,41); ev_teach(W,41,82,42);
  let y2:i32=xio_query(W,2,92,42,0,xon);
  emit("Y2 ans="); e64(y2); xhio_tstat(W);
  return;
}
// Z1 facts: 81-chain 21->22->23->24->25 (count 4) and 82-chain
// 4->50->51->52. Query (21,93) -> 52.
fn xhio_z1facts(W:[]u8)void {
  ev_teach(W,21,81,22); ev_teach(W,22,81,23);
  ev_teach(W,23,81,24); ev_teach(W,24,81,25);
  ev_teach(W,4,82,50); ev_teach(W,50,82,51); ev_teach(W,51,82,52);
  return;
}
// Z2a facts: 81-chain 41->42->43->44->45 (count 4). The 82-chain
// from 4 is already taught. Query (41,93) -> 52 (reuse probe).
fn xhio_z2afacts(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43);
  ev_teach(W,43,81,44); ev_teach(W,44,81,45);
  return;
}
// Z2b facts: 81-chain 71->72->73->74 (count 3). The 82-chain from 3
// was taught in Y training. Query (71,94) -> 32 (new relation).
fn xhio_z2bfacts(W:[]u8)void {
  ev_teach(W,71,81,72); ev_teach(W,72,81,73); ev_teach(W,73,81,74);
  return;
}
fn xhio_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); xhio_tstat(W);
  xhio_acensus(W);
  return;
}
fn xhio_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  xhio_trainX(W,1);
  xhio_trainY(W,1);
  xhio_gap(W);
  xhio_census(W);
  xhio_z1facts(W); xhio_zq(W,"Z1",21,93,52,1);
  xhio_z2afacts(W); xhio_zq(W,"Z2a",41,93,52,1);
  xhio_z2bfacts(W); xhio_zq(W,"Z2b",71,94,32,1);
  return;
}
fn xhio_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  xhio_trainX(W,0);
  xhio_trainY(W,0);
  xhio_gap(W);
  xhio_census(W);
  xhio_z1facts(W); xhio_zq(W,"Z1",21,93,52,0);
  xhio_z2afacts(W); xhio_zq(W,"Z2a",41,93,52,0);
  xhio_z2bfacts(W); xhio_zq(W,"Z2b",71,94,32,0);
  return;
}
fn xhio_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  xhio_trainX(W,1);
  xhio_trainY(W,1);
  xhio_del_map_r(W,91);
  emit("maps after del="); e64(xhio_count_maps(W)); emit("\n");
  xhio_gap(W);
  xhio_z1facts(W); xhio_zq(W,"Z1",21,93,52,1);
  xhio_z2afacts(W); xhio_zq(W,"Z2a",41,93,52,1);
  xhio_z2bfacts(W); xhio_zq(W,"Z2b",71,94,32,1);
  return;
}
fn xhio_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  xhio_trainX(W,1);
  xhio_trainY(W,1);
  xhio_del_map_r(W,92);
  emit("maps after del="); e64(xhio_count_maps(W)); emit("\n");
  xhio_gap(W);
  xhio_z1facts(W); xhio_zq(W,"Z1",21,93,52,1);
  xhio_z2afacts(W); xhio_zq(W,"Z2a",41,93,52,1);
  xhio_z2bfacts(W); xhio_zq(W,"Z2b",71,94,32,1);
  return;
}
fn xhio_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  xhio_gap(W);
  xhio_z1facts(W); xhio_zq(W,"Z1",21,93,52,0);
  xhio_z2afacts(W); xhio_zq(W,"Z2a",41,93,52,0);
  xhio_z2bfacts(W); xhio_zq(W,"Z2b",71,94,32,0);
  return;
}
// ev_query: cx_core.zag's internal test battery references this symbol.
// Provided here as the adapter pipeline (adapters enabled). The battery
// is never invoked by this driver; the entry point is xio_query.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("XHIO-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); xhio_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); xhio_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); xhio_arm_ablx(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); xhio_arm_ably(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); xhio_arm_fresh(W5);
  emit("XHIO-END\n");
  return 0;
}

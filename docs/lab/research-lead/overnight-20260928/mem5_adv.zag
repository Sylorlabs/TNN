// mem5_learn.zag -- H-MEM5: substantive merit threshold (new hypothesis).
// Prereg: PREREG_MEM5.md (frozen before this implementation).
// Deltas vs mem4_learn.zag (H-MEM4):
//   R4 (X-M4-2a, X-M4-2b): SUBSTANTIVE MERIT THRESHOLD. elig() now
//       protects a slot within its age window iff uses >= MERITK (2).
//       The GRACE=3 absolute protection is removed: there is no
//       age-based shielding of a newcomer with 0 or 1 queries. A single
//       query (even a stale one) is not merit; two queries are the
//       smallest substantive signal. The X-M4-2a grace-window harm and
//       the X-M4-2b fig-leaf-merit harm are closed at the elig() level:
//       on both frozen attack fixtures the protected outcome now
//       coincides with the unprotected outcome (LFU evicts the
//       low-merit newcomer at cost 0; CHURN-FULL:0).
//   Fixtures: K-M4-1b expectation superseded (the grace flip no longer
//       occurs; the frozen setup_flip state now reads CHURN-FULL:0);
//       new setup_flip2 (slot7 uses=2) preserves :1 path coverage and
//       proves merit-positive protection is load-bearing; the K-M3-4
//       fallback fixture is replaced with a hand-built
//       all-merit-protected state (the old 0-query state is no longer
//       all-protected under the new rule).
// Pure Zag. No Python.
// Deltas vs mem3_learn.zag (H-MEM3):
//   R1 (X-M3-1a): FULL winner-recomputation counterfactual. pressure() now
//       recomputes the winner under no protection (wun = argmin_pol(...,0))
//       and compares against the protected winner (wprot). Verdict is
//       CHURN-FULL:1 iff the winner or the eviction differs; CHURN-FULL:0
//       iff the winner is stable and the eviction is unchanged. The old
//       selected-policy-only verdict could read :0 while the outcome
//       changed; that scope gap is closed by construction.
//   R2 (X-M3-1b): MERIT-GATED probation. elig() now voids age protection
//       for meritless slots (uses==0) past a short absolute grace
//       (GRACE=3 queries). A never-queried newcomer no longer shields
//       itself while a queried procedure is sacrificed. K-M3-1 survivor
//       checks retained (newcomers with merit stay protected).
//   R3 (X-M3-2a/b): STRONGER future independence. New dist_differs2()
//       requires L1 frequency-vector distance >= L1MIN=6 (the old
//       dist_differs passed a single-query flip; the new one rejects it).
//       New fut_score3() screens for ADVERSARIAL-TARGET: if the selected
//       policy's victim proc is a strict majority of the future, the
//       future is explicitly excluded (return 2), not silently failed.
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// 8 slots x 28 bytes: +0 used, +4 pid, +8 uses, +12 lastq, +16 sseq, +20 prot_until
fn NSLOT()i32 { return 8; }
fn SLOT_SZ()i32 { return 28; }
fn PROB()i32 { return 10; }
// R4 (H-MEM5): substantive merit threshold. Protection is earned by
// demonstrated merit alone: there is no age-based absolute grace.
// Within the age window a slot is protected iff uses >= MERITK (2);
// a single query (or none) is not merit. This closes the X-M4-2a
// grace-window harm and the X-M4-2b fig-leaf-merit harm.
fn MERITK()i32 { return 2; }
// R3 (H-MEM4): minimum L1 frequency-vector distance for a future to count
// as independent of the selection window.
fn L1MIN()i32 { return 6; }
fn slot_off(s:i32)i32 { return s*SLOT_SZ(); }
fn st_used(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)); }
fn st_pid(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+4); }
fn st_uses(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+8); }
fn st_lastq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+12); }
fn st_sseq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+16); }
fn st_prot(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+20); }
fn st_set(W:[]u8, s:i32, used:i32, pid:i32, uses:i32, lastq:i32, sseq:i32, prot:i32)void {
  set32(W, slot_off(s), used); set32(W, slot_off(s)+4, pid);
  set32(W, slot_off(s)+8, uses); set32(W, slot_off(s)+12, lastq);
  set32(W, slot_off(s)+16, sseq); set32(W, slot_off(s)+20, prot);
  return;
}
// ST: +0 nq, +4 seq, +8 ss, +12 fallback flag (R2)
fn st_nq(ST:[]u8)i32 { return get32(ST, 0); }
fn st_seq(ST:[]u8)i32 { return get32(ST, 4); }
fn st_ss(ST:[]u8)i32 { return get32(ST, 8); }
fn st_fbf(ST:[]u8)i32 { return get32(ST, 12); }
fn st_set_nq(ST:[]u8, v:i32)void { set32(ST, 0, v); return; }
fn st_set_seq(ST:[]u8, v:i32)void { set32(ST, 4, v); return; }
fn st_set_ss(ST:[]u8, v:i32)void { set32(ST, 8, v); return; }
fn st_set_fbf(ST:[]u8, v:i32)void { set32(ST, 12, v); return; }
fn st_find(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){ if(st_used(W,s)==1){ if(st_pid(W,s)==pid){ return s; } } s=s+1; }
  return -1;
}
fn has_proc(W:[]u8, pid:i32)i32 { return st_find(W,pid)>=0; }
// eviction-eligible: stored and not (protected and use_prot)
// R4 (H-MEM5): substantive merit threshold. Within the age window
// (seq < prot), a slot is protected iff st_uses >= MERITK (2).
// There is no absolute grace: a newcomer with 0 or 1 queries is
// evictable. A meritless age-protected slot's protection is void (as
// in H-MEM4); now the fig-leaf case (uses=1) is void too, and the
// grace window is gone.
fn elig(W:[]u8, ST:[]u8, s:i32, use_prot:i32)i32 {
  if(st_used(W,s)==0){ return 0; }
  if(use_prot==1){
    if(st_seq(ST)<st_prot(W,s)){
      if(st_uses(W,s)>=MERITK()){ return 0; }
      return 1;
    }
  }
  return 1;
}
fn nelig(W:[]u8, ST:[]u8, use_prot:i32)i32 {
  let c:i32=0; let s:i32=0;
  while(s<NSLOT()){ if(elig(W,ST,s,use_prot)==1){c=c+1;} s=s+1; }
  return c;
}
fn st_learn(W:[]u8, ST:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==0){
      let ss:i32=st_ss(ST);
      st_set(W, s, 1, pid, 0, 0, ss, st_seq(ST)+PROB());
      st_set_ss(ST, ss+1);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn st_query(W:[]u8, ST:[]u8, Q:[]u8, pid:i32)void {
  let f:i32=st_find(W, pid);
  if(f>=0){
    let sq:i32=st_seq(ST)+1;
    st_set_seq(ST, sq);
    set32(W, slot_off(f)+8, st_uses(W,f)+1);
    set32(W, slot_off(f)+12, sq);
    let nq:i32=st_nq(ST);
    Q[nq]=pid as u8;
    st_set_nq(ST, nq+1);
  }
  return;
}
fn run_seq(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){ st_query(W, ST, Q, P[i] as i32); i=i+1; }
  return;
}
fn run_pairs(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, np:i32)void {
  let i:i32=0;
  while(i<np){
    let pid:i32=P[i*2] as i32; let cnt:i32=P[i*2+1] as i32;
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    i=i+1;
  }
  return;
}
fn pol_name(p:i32)[]u8 {
  if(p==0){return "LFU";} if(p==1){return "LRU";}
  if(p==2){return "FIFO";} if(p==3){return "LIFO";}
  return "RANDOM";
}
// victim; use_prot=1 skips protected slots, 0 ignores protection
fn victim(W:[]u8, ST:[]u8, pol:i32, ev:i32, use_prot:i32)i32 {
  let best:i32=-1; let s:i32=0;
  if(pol==4){
    let ne:i32=nelig(W,ST,use_prot);
    if(ne==0){ return -1; }
    let k:i32=((ev*5+1)%ne+ne)%ne;
    let c:i32=0; s=0;
    while(s<NSLOT()){
      if(elig(W,ST,s,use_prot)==1){ if(c==k){return s;} c=c+1; }
      s=s+1;
    }
    return -1;
  }
  while(s<NSLOT()){
    if(elig(W,ST,s,use_prot)==1){
      if(best<0){ best=s; }
      else {
        if(pol==0){ if(st_uses(W,s)<st_uses(W,best)){best=s;} }
        if(pol==1){ if(st_lastq(W,s)<st_lastq(W,best)){best=s;} }
        if(pol==2){ if(st_sseq(W,s)<st_sseq(W,best)){best=s;} }
        if(pol==3){ if(st_sseq(W,s)>st_sseq(W,best)){best=s;} }
      }
    }
    s=s+1;
  }
  return best;
}
fn replay_cost(W:[]u8, Q:[]u8, ST:[]u8, v:i32, win:i32)i32 {
  if(v<0){return 999999;}
  let pid:i32=st_pid(W,v);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let c:i32=0; let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+1;} i=i+1; }
  return c;
}
// argmin over the menu with a given protection mode (R2 helper)
fn argmin_pol(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, up:i32)i32 {
  let p:i32=0; let bestp:i32=0; let bestc:i32=999999;
  while(p<5){
    let c:i32=replay_cost(W,Q,ST,victim(W,ST,p,ev,up),win);
    if(c<bestc){bestc=c;bestp=p;}
    p=p+1;
  }
  return bestp;
}
// winner at window (no state change); R2: falls back to unprotected when all protected
fn select_win(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32)i32 {
  let wp:i32=argmin_pol(W,Q,ST,ev,win,1);
  if(victim(W,ST,wp,ev,1)<0){
    emit("FALLBACK-ALL-PROTECTED ");
    wp=argmin_pol(W,Q,ST,ev,win,0);
  }
  return wp;
}
fn is_strict_up(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32, up:i32)i32 {
  let wc:i32=replay_cost(W,Q,ST,victim(W,ST,wp,ev,up),win);
  let p:i32=0;
  while(p<5){
    if(p!=wp){
      if(replay_cost(W,Q,ST,victim(W,ST,p,ev,up),win)<=wc){ return 0; }
    }
    p=p+1;
  }
  return 1;
}
fn is_strict(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wp:i32)i32 {
  return is_strict_up(W,Q,ST,ev,win,wp,1);
}
// K-M2-5: identical strict winner across W in {20,25,30}
fn band_check(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, expect:i32, tag:[]u8)i32 {
  emit("band check "); emit(tag); emit(" (expect "); emit(pol_name(expect)); emit("):");
  let ok:i32=1;
  let w:i32=20;
  while(w<=30){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); ok=0; }
    if(sw!=expect){ ok=0; }
    w=w+5;
  }
  emit("\n");
  if(ok==1){ emit("K-M2-5 PASS ("); emit(tag); emit(")\n"); }
  else { emit("K-M2-5 FAIL ("); emit(tag); emit(")\n"); }
  return ok;
}
// window sweep as inspectable context (not a bar)
fn sweep_print(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, tag:[]u8)void {
  emit("window sweep "); emit(tag); emit(":");
  let w:i32=10;
  while(w<=40){
    let sw:i32=select_win(W,Q,ST,ev,w);
    let st:i32=is_strict(W,Q,ST,ev,w,sw);
    emit(" W="); emit(i32s(w)); emit(":"); emit(pol_name(sw));
    if(st==1){ emit("*"); } else { emit("~"); }
    w=w+5;
  }
  let swf:i32=select_win(W,Q,ST,ev,1000000);
  let stf:i32=is_strict(W,Q,ST,ev,1000000,swf);
  emit(" W=full:"); emit(pol_name(swf));
  if(stf==1){ emit("*"); } else { emit("~"); }
  emit("\n");
  return;
}
// R3: 1 iff the future's per-proc frequency vector differs from the W=win window vector
fn dist_differs(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let p:i32=0;
  while(p<16){
    let cw:i32=0; let i:i32=lo;
    while(i<nq){ if((Q[i] as i32)==p){cw=cw+1;} i=i+1; }
    let cf:i32=0; let j:i32=0;
    while(j<nf){ if((F[j] as i32)==p){cf=cf+1;} j=j+1; }
    if(cw!=cf){ return 1; }
    p=p+1;
  }
  return 0;
}
// R3 (H-MEM4): L1 distance between the future's and the window's per-proc
// frequency vectors. The old dist_differs passes a single-query flip
// (X-M3-2b); L1 exposes how close the distributions really are.
fn l1_dist(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let l1:i32=0;
  let p:i32=0;
  while(p<16){
    let cw:i32=0; let i:i32=lo;
    while(i<nq){ if((Q[i] as i32)==p){cw=cw+1;} i=i+1; }
    let cf:i32=0; let j:i32=0;
    while(j<nf){ if((F[j] as i32)==p){cf=cf+1;} j=j+1; }
    let d:i32=cw-cf; if(d<0){d=0-d;}
    l1=l1+d;
    p=p+1;
  }
  return l1;
}
// R3 (H-MEM4): strengthened independence: 1 iff L1 >= L1MIN.
fn dist_differs2(Q:[]u8, ST:[]u8, F:[]u8, nf:i32, win:i32)i32 {
  if(l1_dist(Q,ST,F,nf,win)>=L1MIN()){ return 1; }
  return 0;
}
// R3/R4: future scoring. Bar: DIST-DIFFERS vs window AND selected ties the min.
// Prints n_tying_min as discriminativeness context. Precondition: at the call
// site at least one slot is eligible (true at all headline events).
fn fut_score2(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, F:[]u8, nf:i32, sel:i32, win:i32, tag:[]u8)i32 {
  let dd:i32=dist_differs(Q,ST,F,nf,win);
  emit("held-out "); emit(tag);
  if(dd==1){ emit(" [DIST-DIFFERS]"); } else { emit(" [DIST-SAME]"); }
  let M:[]u8=z_alloc(20);
  let p:i32=0; let minm:i32=999999;
  while(p<5){
    let pid:i32=st_pid(W,victim(W,ST,p,ev,1));
    let m:i32=0; let i:i32=0;
    while(i<nf){ if((F[i] as i32)==pid){m=m+1;} i=i+1; }
    set32(M,p*4,m);
    if(m<minm){minm=m;}
    p=p+1;
  }
  emit(" misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let nmin:i32=0; p=0;
  while(p<5){ if(get32(M,p*4)==minm){nmin=nmin+1;} p=p+1; }
  emit("  n_tying_min="); emit(i32s(nmin)); emit(" of 5\n");
  if(dd==0){ emit("K-M3-2 FAIL ("); emit(tag); emit(": future distribution identical to window)\n"); return 0; }
  if(get32(M,sel*4)==minm){ emit("K-M3-2 PASS ("); emit(tag); emit(": selected ties min, DIST-DIFFERS)\n"); return 1; }
  emit("K-M3-2 FAIL ("); emit(tag); emit(": selected not min)\n"); return 0;
}
// R3 (H-MEM4): strengthened future scoring.
// Returns 1=PASS, 0=FAIL, 2=ADVERSARIAL-TARGET (explicitly excluded).
// Screen 1 (X-M3-2a): if the selected policy's victim proc is a strict
// majority of the future, the future targets the selection adversarially;
// it is excluded from the bar with an explicit print, not silently failed.
// Screen 2 (X-M3-2b): independence requires L1 >= L1MIN (dist_differs2);
// the old single-query flip no longer passes. Then the K-M3-2 bar:
// selected ties the minimum miss count.
fn fut_score3(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, F:[]u8, nf:i32, sel:i32, win:i32, tag:[]u8)i32 {
  let vv:i32=victim(W,ST,sel,ev,1);
  let vp:i32=-1; if(vv>=0){vp=st_pid(W,vv);}
  let fvp:i32=0;
  if(vp>=0){
    let i:i32=0;
    while(i<nf){ if((F[i] as i32)==vp){fvp=fvp+1;} i=i+1; }
  }
  emit("held-out "); emit(tag);
  if(vp>=0 && fvp*2>nf){
    emit(" [ADVERSARIAL-TARGET: proc"); emit(i32s(vp));
    emit("="); emit(i32s(fvp)); emit("/"); emit(i32s(nf));
    emit(" targets selected "); emit(pol_name(sel)); emit(" victim]\n");
    emit("K-M4-3 EXCLUDED ("); emit(tag); emit(": adversarial target, out of bar scope)\n");
    return 2;
  }
  let l1:i32=l1_dist(Q,ST,F,nf,win);
  emit(" [L1="); emit(i32s(l1)); emit("]");
  if(l1>=L1MIN()){ emit(" [DIST-DIFFERS2]"); } else { emit(" [DIST-TOO-CLOSE]"); }
  let M:[]u8=z_alloc(20);
  let p:i32=0; let minm:i32=999999;
  while(p<5){
    let pid:i32=st_pid(W,victim(W,ST,p,ev,1));
    let m:i32=0; let i:i32=0;
    while(i<nf){ if((F[i] as i32)==pid){m=m+1;} i=i+1; }
    set32(M,p*4,m);
    if(m<minm){minm=m;}
    p=p+1;
  }
  emit(" misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let nmin:i32=0; p=0;
  while(p<5){ if(get32(M,p*4)==minm){nmin=nmin+1;} p=p+1; }
  emit("  n_tying_min="); emit(i32s(nmin)); emit(" of 5\n");
  if(l1<L1MIN()){
    emit("K-M3-2 FAIL ("); emit(tag); emit(": future too close to window, L1=");
    emit(i32s(l1)); emit(" < "); emit(i32s(L1MIN())); emit(")\n");
    return 0;
  }
  if(get32(M,sel*4)==minm){ emit("K-M3-2 PASS ("); emit(tag); emit(": selected ties min, DIST-DIFFERS2)\n"); return 1; }
  emit("K-M3-2 FAIL ("); emit(tag); emit(": selected not min)\n"); return 0;
}
// R1 (H-MEM4): full winner-recomputation counterfactual.
// Compares the protected outcome (wprot/vprot) against the recomputed
// unprotected outcome (wun/vun). Returns 1 iff protection changed the
// outcome, 0 iff the winner is stable and the eviction is unchanged.
// The selected-policy victim pair is printed as a detail line for
// K-M3-1 continuity. On the fallback path the verdict is 0 with the
// fallback noted (no protected winner exists).
fn churn_verdict(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, wprot:i32, vprot:i32, up:i32)i32 {
  if(up==0){
    emit("  [full counterfactual] fallback path: no protected winner (all slots protected)\n");
    emit("  CHURN-FULL:0 (fallback path; protection not applied)\n");
    return 0;
  }
  let wun:i32=argmin_pol(W,Q,ST,ev,win,0);
  let vun:i32=victim(W,ST,wun,ev,0);
  emit("  [full counterfactual] protected: "); emit(pol_name(wprot));
  emit(" victim=slot"); emit(i32s(vprot));
  if(vprot>=0){ emit("(proc"); emit(i32s(st_pid(W,vprot))); emit(")"); }
  emit(" | unprotected: "); emit(pol_name(wun));
  emit(" victim=slot"); emit(i32s(vun));
  if(vun>=0){ emit("(proc"); emit(i32s(st_pid(W,vun))); emit(")"); }
  emit("\n");
  let pv3:i32=victim(W,ST,wprot,ev,1);
  let uv:i32=victim(W,ST,wprot,ev,0);
  emit("  [selected-policy] protected-victim=slot"); emit(i32s(pv3));
  emit(" unprotected-victim=slot"); emit(i32s(uv)); emit("\n");
  if(wprot==wun && vprot==vun){
    emit("  CHURN-FULL:0 (winner stable at "); emit(pol_name(wprot));
    emit("; eviction unchanged)\n");
    return 0;
  }
  if(wprot!=wun){
    emit("  CHURN-FULL:1 (winner flips "); emit(pol_name(wprot)); emit("->"); emit(pol_name(wun));
  } else {
    emit("  CHURN-FULL:1 (winner stable at "); emit(pol_name(wprot));
  }
  emit("; eviction slot"); emit(i32s(vprot));
  if(vprot>=0){ emit("(proc"); emit(i32s(st_pid(W,vprot))); emit(")"); }
  emit("->slot"); emit(i32s(vun));
  if(vun>=0){ emit("(proc"); emit(i32s(st_pid(W,vun))); emit(")"); }
  emit(")\n");
  return 1;
}
// pressure at operating window 20; R1 (H-MEM4): full counterfactual;
// R2 (H-MEM3): all-protected fallback
fn pressure(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, newpid:i32)i32 {
  emit("pressure event "); emit(i32s(ev));
  emit(" (learn proc"); emit(i32s(newpid)); emit(", win=20):\n");
  st_set_fbf(ST, 0);
  let up:i32=1;
  let bestp:i32=argmin_pol(W,Q,ST,ev,20,1);
  let v:i32=victim(W,ST,bestp,ev,1);
  if(v<0){
    emit("  FALLBACK-ALL-PROTECTED: all slots protected; using unprotected choice\n");
    st_set_fbf(ST, 1);
    up=0;
    bestp=argmin_pol(W,Q,ST,ev,20,0);
    v=victim(W,ST,bestp,ev,0);
  }
  let p:i32=0;
  while(p<5){
    let pv2:i32=victim(W,ST,p,ev,up);
    let c:i32=replay_cost(W,Q,ST,pv2,20);
    emit("    "); emit(pol_name(p));
    emit(" victim=slot"); emit(i32s(pv2));
    if(pv2>=0){ emit("(proc"); emit(i32s(st_pid(W,pv2))); emit(")"); }
    emit(" cost="); emit(i32s(c)); emit("\n");
    p=p+1;
  }
  emit("  selected: "); emit(pol_name(bestp));
  emit(" cost="); emit(i32s(replay_cost(W,Q,ST,v,20)));
  if(is_strict_up(W,Q,ST,ev,20,bestp,up)==1){ emit(" STRICT"); } else { emit(" TIE"); }
  emit("\n");
  emit("  evict slot"); emit(i32s(v));
  if(v>=0){
    emit(" proc"); emit(i32s(st_pid(W,v)));
    emit(" uses="); emit(i32s(st_uses(W,v)));
    emit(" lastq="); emit(i32s(st_lastq(W,v)));
  }
  emit("\n");
  // R1 (H-MEM4): full winner-recomputation counterfactual (X-M3-1a repair).
  // The old selected-policy-only verdict is superseded; the detail pair
  // is still printed for K-M3-1 continuity.
  let cv:i32=churn_verdict(W,Q,ST,ev,20,bestp,v,up);
  if(v>=0){ st_set(W, v, 0, -1, 0, 0, 0, 0); }
  let s2:i32=st_learn(W, ST, newpid);
  emit("  stored proc"); emit(i32s(newpid));
  emit(" at slot"); emit(i32s(s2));
  if(s2>=0){ emit(" prot_until="); emit(i32s(st_prot(W,s2))); }
  emit("\n");
  return bestp;
}
fn store_init(W:[]u8, ST:[]u8)void {
  let s:i32=0;
  while(s<NSLOT()){ st_set(W,s,0,-1,0,0,0,0); s=s+1; }
  st_set_nq(ST,0); st_set_seq(ST,0); st_set_ss(ST,0); st_set_fbf(ST,0);
  return;
}
fn learn_stream(W:[]u8, ST:[]u8, base:i32, n:i32)void {
  let i:i32=0;
  while(i<n){ let _x:i32=st_learn(W, ST, base+i); i=i+1; }
  return;
}
// H-MEM5 adversary main: attack-only driver. The mechanism region above
// (lines 1..498 of the committed mem5_learn.zag) is byte-identical to the
// frozen source; only this main and the fixture builders are new.
// Pure Zag. No Python.

// X-M5-1 / X-M5-2 fixture: stale-merit state. slot7 holds proc7 with
// `uses7` queries (1 or 2), all ancient (lastq=101), prot window open
// (seq=105 < prot=109). Operating window Q[6..25] has proc7 absent.
fn setup_stale(W:[]u8, ST:[]u8, Q:[]u8, uses7:i32)void {
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 26);
  Q[0]=7; Q[1]=7; Q[2]=0; Q[3]=1; Q[4]=2; Q[5]=3;
  let i:i32=6;
  while(i<12){ Q[i]=0; i=i+1; }
  while(i<15){ Q[i]=1; i=i+1; }
  while(i<18){ Q[i]=2; i=i+1; }
  while(i<20){ Q[i]=3; i=i+1; }
  while(i<22){ Q[i]=4; i=i+1; }
  while(i<24){ Q[i]=5; i=i+1; }
  while(i<26){ Q[i]=6; i=i+1; }
  st_set(W, 0, 1, 0, 10, 91, 0, 50);
  st_set(W, 1, 1, 1, 20, 92, 1, 50);
  st_set(W, 2, 1, 2, 30, 93, 2, 50);
  st_set(W, 3, 1, 3, 40, 94, 3, 50);
  st_set(W, 4, 1, 4, 50, 95, 4, 50);
  st_set(W, 5, 1, 5, 60, 96, 5, 50);
  st_set(W, 6, 1, 6, 70, 97, 6, 50);
  st_set(W, 7, 1, 7, uses7, 101, 7, 109);
  return;
}

// X-M5-3 fixture: evictable newcomer (slot7, uses=1, recent) alongside
// a protected stale slot (slot5, uses=2, ancient).
fn setup_newcomer(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  st_set_seq(ST, 105);
  st_set_nq(ST, 21);
  Q[0]=5;
  let i:i32=1;
  while(i<7){ Q[i]=0; i=i+1; }
  while(i<10){ Q[i]=1; i=i+1; }
  while(i<13){ Q[i]=2; i=i+1; }
  while(i<15){ Q[i]=3; i=i+1; }
  while(i<17){ Q[i]=4; i=i+1; }
  while(i<19){ Q[i]=6; i=i+1; }
  Q[19]=7;
  Q[20]=5;
  st_set(W, 0, 1, 0, 10, 91, 0, 50);
  st_set(W, 1, 1, 1, 20, 92, 1, 50);
  st_set(W, 2, 1, 2, 30, 93, 2, 50);
  st_set(W, 3, 1, 3, 40, 94, 3, 50);
  st_set(W, 4, 1, 4, 50, 95, 4, 50);
  st_set(W, 5, 1, 5, 2, 90, 5, 109);
  st_set(W, 6, 1, 6, 70, 96, 6, 50);
  st_set(W, 7, 1, 7, 1, 104, 7, 109);
  return;
}

// Computes the mechanism's own (wprot, vprot, cprot, wun, vun, verdict)
// and checks them against the frozen hand-derived expectations.
// Returns 1 iff every value matches.
fn check_harm(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, ewprot:i32, evprot:i32, ecprot:i32, ewun:i32, evun:i32, ecv:i32, tag:[]u8)i32 {
  let wprot:i32=select_win(W,Q,ST,ev,win);
  let vprot:i32=victim(W,ST,wprot,ev,1);
  let cprot:i32=replay_cost(W,Q,ST,vprot,win);
  let wun:i32=argmin_pol(W,Q,ST,ev,win,0);
  let vun:i32=victim(W,ST,wun,ev,0);
  emit("  "); emit(tag);
  emit(": wprot="); emit(pol_name(wprot));
  emit(" vprot=slot"); emit(i32s(vprot));
  emit(" cprot="); emit(i32s(cprot));
  emit(" wun="); emit(pol_name(wun));
  emit(" vun=slot"); emit(i32s(vun)); emit("\n");
  let cv:i32=churn_verdict(W,Q,ST,ev,win,wprot,vprot,1);
  emit("  "); emit(tag); emit(" expected: wprot="); emit(pol_name(ewprot));
  emit(" vprot=slot"); emit(i32s(evprot));
  emit(" cprot="); emit(i32s(ecprot));
  emit(" wun="); emit(pol_name(ewun));
  emit(" vun=slot"); emit(i32s(evun));
  emit(" cv="); emit(i32s(ecv)); emit("\n");
  if(wprot==ewprot && vprot==evprot && cprot==ecprot && wun==ewun && vun==evun && cv==ecv){
    emit("  "); emit(tag); emit(" MATCHES FROZEN EXPECTATION\n");
    return 1;
  }
  emit("  "); emit(tag); emit(" DEVIATES FROM FROZEN EXPECTATION\n");
  return 0;
}

fn main()i32 {
  let W:[]u8=z_alloc(NSLOT()*SLOT_SZ());
  let ST:[]u8=z_alloc(16);
  let Q:[]u8=z_alloc(512);
  let m51:i32=0; let m52a:i32=0; let m52b:i32=0; let m53:i32=0;

  emit("=== X-M5-1 stale-merit harm (slot7 uses=2, ancient) ===\n");
  setup_stale(W,ST,Q,2);
  emit("  slot7: uses="); emit(i32s(st_uses(W,7)));
  emit(" lastq="); emit(i32s(101));
  emit(" prot_until="); emit(i32s(st_prot(W,7)));
  emit(" seq="); emit(i32s(st_seq(ST))); emit("\n");
  m51=check_harm(W,Q,ST,0,20, 3,6,2, 0,7,1, "X-M5-1");

  emit("=== X-M5-2a cliff low side (slot7 uses=1) ===\n");
  setup_stale(W,ST,Q,1);
  m52a=check_harm(W,Q,ST,0,20, 0,7,0, 0,7,0, "X-M5-2a");

  emit("=== X-M5-2b cliff high side (slot7 uses=2) ===\n");
  setup_stale(W,ST,Q,2);
  m52b=check_harm(W,Q,ST,0,20, 3,6,2, 0,7,1, "X-M5-2b");

  emit("=== X-M5-3 newcomer (slot7 uses=1 recent; slot5 uses=2 ancient protected) ===\n");
  setup_newcomer(W,ST,Q);
  emit("  slot7: uses="); emit(i32s(st_uses(W,7)));
  emit(" lastq=104 (recent); slot5: uses="); emit(i32s(st_uses(W,5)));
  emit(" lastq=90 (ancient, protected)\n");
  m53=check_harm(W,Q,ST,0,20, 0,7,1, 0,7,0, "X-M5-3");

  emit("=== ADV SUMMARY ===\n");
  if(m51==1){ emit("X-M5-1 SUCCEED (DOWNGRADE: stale-merit harm recurs)\n"); }
  else { emit("X-M5-1 FAIL (no harm observed)\n"); }
  if(m52a==1 && m52b==1){ emit("X-M5-2 SUCCEED (one-query cliff confirmed)\n"); }
  else { emit("X-M5-2 FAIL (cliff not as derived)\n"); }
  if(m53==1){ emit("X-M5-3 FAIL (no divergence; honest negative as preregistered)\n"); }
  else { emit("X-M5-3 DEVIATES (manual review required)\n"); }
  return 0;
}

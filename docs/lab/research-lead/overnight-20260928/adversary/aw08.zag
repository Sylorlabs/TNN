// AW-08 isomorphic stress: reorder observations (C508). Charter 110.
// TARGET: TNN-2 bootstrap_miss (:763-788) scans node ids 1023 DOWNWARD,
// i.e. it is recency-ordered, and samples at most 6 objects. Which objects it
// sees is therefore a function of INSERTION ORDER, not of the fact set.
//
// The fact set is IDENTICAL in both variants:
//   one dissenter  (4,10,9)
//   six agreeing   (1,10,7) (2,10,7) (3,10,7) (5,10,7) (6,10,7) (7,10,7)
// Query ev_query(999, 10) -- subject 999 never taught.
//
// O1 dissent taught FIRST (so the dissenter is the oldest node, outside the
//    6 newest). The 6 newest all carry object 7 -> bootstrap_miss fires.
// O2 dissent taught LAST (newest node). The 6 newest are {9,7,7,7,7,7} ->
//    not all equal -> bootstrap_miss refuses.
//
// PREREG: O1 = 7 (and persists a fact), O2 = -2. DIFFERENT answers on the
// same fact set. If they are equal, the mechanism is order-invariant and my
// reading of :764 is wrong; I will report that.
// KILL BAR: both give the same answer.
//
// (a) is covered by aw07 (renaming). (c) distractor insensitivity is covered
// here by O3: same fact set plus 8 extra facts on UNUSED relations.

fn aw08_teach_agree(W:[]u8)void {
  ev_teach_in(W,1,10,7); ev_teach_in(W,2,10,7); ev_teach_in(W,3,10,7);
  ev_teach_in(W,5,10,7); ev_teach_in(W,6,10,7); ev_teach_in(W,7,10,7);
  return;
}
fn aw08_nfacts(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=2;
  while(i<1024){
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && ng(W,i,20)==s && ng(W,i,24)==r){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  c=a_tag(B,c,"AW-08 isomorphic stress: reordered observations (charter 110)");
  c=a_kvs(B,c,"fact_set","(1,10,7)(2,10,7)(3,10,7)(5,10,7)(6,10,7)(7,10,7)(4,10,9)");
  c=a_kvs(B,c,"query","ev_query(999,10) -- subject 999 never taught, order variant");
  c=a_kvs(B,c,"prereg","O1 (dissent oldest) = 7 and persists; O2 (dissent newest) = -2");
  c=a_kvs(B,c,"mechanism","bootstrap_miss :764 scans node ids 1023 downward = recency");
  // ---- O1: dissenter FIRST ----
  let W1:[]u8=z_alloc(110656);
  tnn2_init(W1);
  ev_teach_in(W1,4,10,9);
  aw08_teach_agree(W1);
  let a1:i32=ev_query(W1,999,10,-2,0);
  c=a_tag(B,c,"== O1 dissenter taught FIRST (oldest node)");
  c=a_kv(B,c,"  ev_query_answer",a1);
  c=a_kv(B,c,"  facts_persisted_about_999",aw08_nfacts(W1,999,10));
  // ---- O2: dissenter LAST ----
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  aw08_teach_agree(W2);
  ev_teach_in(W2,4,10,9);
  let a2:i32=ev_query(W2,999,10,-2,0);
  c=a_tag(B,c,"== O2 dissenter taught LAST (newest node)");
  c=a_kv(B,c,"  ev_query_answer",a2);
  c=a_kv(B,c,"  facts_persisted_about_999",aw08_nfacts(W2,999,10));
  // ---- O3: O1 plus 8 irrelevant distractors on unused relations ----
  let W3:[]u8=z_alloc(110656);
  tnn2_init(W3);
  ev_teach_in(W3,4,10,9);
  aw08_teach_agree(W3);
  let i:i32=0;
  while(i<8){ ev_teach_in(W3,9000+i,50+i,60+i); i=i+1; }
  let a3:i32=ev_query(W3,999,10,-2,0);
  c=a_tag(B,c,"== O3 O1 plus 8 irrelevant distractor facts (unused relations)");
  c=a_kv(B,c,"  ev_query_answer",a3);
  c=a_verdict(B,c,"  O1_vs_O3_distractor_insensitive",a1,a3);
  // ---- verdict on the isomorphism ----
  c=a_tag(B,c,"== isomorphism verdict");
  c=a_kv(B,c,"  O1",a1);
  c=a_kv(B,c,"  O2",a2);
  if(a1!=a2){
    c=a_kvs(B,c,"  RESULT","ISOMORPHISM BROKEN: same fact set, different answer by order alone");
  } else {
    c=a_kvs(B,c,"  RESULT","order-invariant on this pair; my reading of :764 was too strong");
  }
  c=a_verdict(B,c,"  prereg_O1",7,a1);
  c=a_verdict(B,c,"  prereg_O2",-2,a2);
  c=a_tag(B,c,"== why this matters");
  c=a_kvs(B,c,"","the inference reads 'the most recent r-facts agree' and encodes it as");
  c=a_kvs(B,c,"","a fact. Recency is an artefact of insertion order, not of the world.");
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

// AW-02 arity sweep (C502). PREREG predicted a crash or contaminated answers
// at nneeds=5. THAT DID NOT HAPPEN. This file extends to a sweep to find the
// real cliff and to report honestly.
//
// Real overflow sites, all with NO bound check:
//   mat_inputs (c8_learn.zag:336)  set32(W, n*80, nf)        W=320  -> 4 needs
//   topo/topo_g (:352-353, :807-808) ind,placed = z_alloc(16) -> 4 needs
//   compose (:764) ord = z_alloc(16)                          -> 4 needs
//   compose (:761-762) OUTS=640, SUBL=512                      -> 4 needs
//   plan_new (:590-592) set32(L,13000+pi*56+8+p*12, ...) stride 56 fits p<=3
//     so the FIFTH plan step writes plan slot 1's goal_tag and nneeds.
//   plan_find/plan_new table = 4 slots; the 5th goal returns pi=-1 and
//     execute_plan then indexes L at NEGATIVE offsets.
//
// Sweep: fresh learner state per arity, same world, needs 1..n each nf=2.

fn aw02_world(A:[]u8)void {
  fact_add(A,1,10,5); fact_add(A,2,10,5); fact_add(A,3,10,5);
  fact_add(A,1,11,2); fact_add(A,2,11,2); fact_add(A,3,11,2);
  return;
}
// goal with n needs, need i tag 21+i, nf=2.
// need 0 uses (rel 10, obj 5) -> {1,2,3}. needs 1.. use (rel 11, obj 2) -> {1,2,3}.
fn aw02_gn(G:[]u8,gt:i32,n:i32)void {
  let o:i32=a_begin(G,gt,n);
  let i:i32=0;
  while(i<n){
    o=a_need(G,o,21+i,2);
    if(i==0){ o=a_f(G,o,10); o=a_f(G,o,5); }
    else { o=a_f(G,o,11); o=a_f(G,o,2); }
    i=i+1;
  }
  o=a_links(G,o,0); return;
}
// expected answer string as a number for the first record
fn aw02_expect_first()i32 { return 3; }
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let A:[]u8=world_new();
  let G:[]u8=z_alloc(1024);
  let ans:[]u8=z_alloc(8192);
  let vbuf:[]u8=z_alloc(32);
  aw02_world(A);
  c=a_tag(B,c,"AW-02 arity sweep (nneeds 1..12), fresh L each time");
  c=a_kvs(B,c,"truth","each need answers a 3-element subject list {1,2,3}");
  c=a_kvs(B,c,"note","needs 2..n use relation 11 -> also {1,2,3}");
  let n:i32=1;
  while(n<=12){
    let L:[]u8=z_alloc(16384);
    aw02_gn(G,7200,n);
    let rc:i32=compose(L,A,G,K,ans,vbuf);
    c=a_tag(B,c,"== arity");
    c=o_i64(B,c,n as i64); c=o_nl(B,c);
    c=a_kv(B,c,"  compose_rc",rc);
    c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
    c=a_kv(B,c,"  ans_rec0_len",get32(ans,4));
    c=a_kv(B,c,"  ans_rec0",get32(ans,8)*100+get32(ans,12)*10+get32(ans,16));
    c=a_kv(B,c,"  plan_slot1_tag_after",get32(L,13056));
    c=a_kv(B,c,"  plan_slot1_nn_after",get32(L,13060));
    c=a_ans(B,c,ans);
    n=n+1;
  }
  c=a_tag(B,c,"== plan table exhaustion (5 distinct goal tags, 1 need each)");
  let L2:[]u8=z_alloc(16384);
  let g:i32=0;
  while(g<6){
    aw02_gn(G,7300+g,1);
    let rc2:i32=compose(L2,A,G,K,ans,vbuf);
    c=a_tag(B,c,"== goal tag");
    c=o_i64(B,c,(7300+g) as i64); c=o_nl(B,c);
    c=a_kv(B,c,"  compose_rc",rc2);
    c=a_kv(B,c,"  plan_find",plan_find(L2,7300+g));
    c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
    g=g+1;
  }
  c=a_tag(B,c,"== phantom plan: a 5-need goal writes 0 into plan slot 1's gtag");
  c=a_kvs(B,c,"why","tag 0 is the 'no plan' sentinel, but plan_new's 5th step");
  c=a_kvs(B,c,"","lands at L+13056 = slot1.gtag and stores the LOWEST need index.");
  let L3:[]u8=z_alloc(16384);
  aw02_gn(G,7400,4);
  c=a_kv(B,c,"before_arity4_find_tag0",plan_find(L3,0));
  aw02_gn(G,7401,5);
  let rc5b:i32=compose(L3,A,G,K,ans,vbuf);
  c=a_kv(B,c,"arity5_compose_rc",rc5b);
  c=a_kv(B,c,"after_slot1_gtag",get32(L3,13056));
  c=a_kv(B,c,"after_slot1_nn",get32(L3,13060));
  c=a_kv(B,c,"after_find_tag0",plan_find(L3,0));
  c=a_kv(B,c,"after_slot0_gtag",get32(L3,13000));
  aw02_gn(G,0,1);
  let rc0:i32=compose(L3,A,G,K,ans,vbuf);
  c=a_kv(B,c,"compose_gtag0_rc",rc0);
  c=a_kv(B,c,"compose_gtag0_find",plan_find(L3,0));
  c=a_ans(B,c,ans);
  a_assert_ne(c,300);
  a_flush(B,c);
  return 0;
}

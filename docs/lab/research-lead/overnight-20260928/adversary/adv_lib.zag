// adv_lib.zag -- ADVERSARY-WORLDS shared harness (C500).
// Concatenated AFTER the frozen c15_base.zag + c8_learn.zag.
// Contains NO world literals and NO goal shapes: only builders.
//
// OUTPUT DISCIPLINE (brief 4.0): the frozen c15_base.zag:52 `o_flush` uses
// _zag_raw_syscall, which is INERT on this host (produces empty output, rc=0).
// My worlds NEVER call it. `a_flush` uses _zag_print. a_flush is also
// installed as the ONLY flush any adversary code calls.

// ---- portable flush (brief 4.0 mandated shim) ----
fn a_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// ---- assertions on non-empty output ----
fn a_assert_ne(c:i32,min:i32)void {
  if(c<min){ _zag_println("A_ASSERT_FAIL_EMPTY_OUTPUT"); return; }
  return;
}

// ---- goal record builder (mirrors c8_world.zag convention, distinct names) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links 28 bytes: [kind,dst_need,dst_kind,dst_slot,
// src_need,src_kind,src_slot].
fn a_begin(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag); set32(G,4,nn); return 8;
}
fn a_need(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag); set32(G,off+4,nf); return off+8;
}
fn a_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn a_links(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn a_link(G:[]u8,off:i32,kd:i32,dn:i32,dk:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,off,kd); set32(G,off+4,dn); set32(G,off+8,dk);
  set32(G,off+12,ds); set32(G,off+16,sn); set32(G,off+20,sk);
  set32(G,off+24,ss); return off+28;
}

// ---- report helpers ----
fn a_tag(b:[]u8,c:i32,s:[]u8)i32 { c=o_app(b,c,s); c=o_nl(b,c); return c; }
fn a_kv(b:[]u8,c:i32,k:[]u8,v:i32)i32 {
  c=o_app(b,c,k); c=o_app(b,c,"=");
  c=o_i64(b,c,v as i64); c=o_nl(b,c); return c;
}
fn a_kvs(b:[]u8,c:i32,k:[]u8,v:[]u8)i32 {
  c=o_app(b,c,k); c=o_app(b,c,"="); c=o_app(b,c,v); c=o_nl(b,c); return c;
}
fn a_verdict(b:[]u8,c:i32,name:[]u8,got:i32,want:i32)i32 {
  c=o_app(b,c,name); c=o_app(b,c," got=");
  c=o_i64(b,c,got as i64); c=o_app(b,c," want=");
  c=o_i64(b,c,want as i64);
  if(got==want){ c=o_app(b,c,"  RESULT=AS_PREDICTED"); }
  else { c=o_app(b,c,"  RESULT=DEVIATION"); }
  c=o_nl(b,c); return c;
}
// structural assertion about a value list: returns 1 iff every entry is in
// the allowed set (av, len) -- used to detect cross-record contamination.
fn a_in_set(vals:[]u8,n:i32,av:[]u8,na:i32)i32 {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(vals,i*4); let j:i32=0; let f:i32=0;
    while(j<na){ if(get32(av,j*4)==x){ f=1; } j=j+1; }
    if(f==0){ return 0; }
    i=i+1;
  }
  return 1;
}
// dump an answer record flat
fn a_ans(b:[]u8,c:i32,ans:[]u8)i32 {
  let n:i32=get32(ans,0);
  c=o_app(b,c,"ans=[");
  let i:i32=0;
  while(i<n){
    if(i>0){ c=o_app(b,c,","); }
    c=o_i64(b,c,get32(ans,4+i*4) as i64); i=i+1;
  }
  c=o_app(b,c,"]");
  c=o_nl(b,c); return c;
}

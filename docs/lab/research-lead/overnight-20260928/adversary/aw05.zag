// AW-05 op1000-ceiling (C505). TNN-2.
// W9: res_op (tnn2_frozen_ref.zag:179) reads op>=1000 as a FRAME SLOT
//     (fr_get) and op>=0 as a NODE ID (ng). alloc_node (:87) hands out ids
//     2..1023. So ids 1000..1023 are live operands that are silently
//     reinterpreted as frame slots.
// t2_guard (:346) stores a LITERAL NODE ID in field 8, and execute (:202)
//     reads it through res_op. Once a literal's node id reaches 1000 the
//     guard compares the subject against fr_get(fr, id-1000), which walks the
//     frame pointer to node 0 (POLICY_ROOT) and returns its fields.
//
// PREREG: E-small promotes a T_MAP (tag 20). E-large, identical except for
//   node-id padding, promotes NOTHING and is indistinguishable from an honest
//   miss. Kill bar: E-large promotes the same graph.
//
// ---- direct mechanism probe, independent of any learner policy ----
// Build a frame, put the value 4242 in slot 0, then read it back through
// res_op with operand = the literal's node id, at ids below and above 1000.

fn aw05_mapcount(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==20){ c=c+1; } n=n+1; }
  return c;
}
fn aw05_trialstat(W:[]u8)i32 { return get32(W,16); }  // hg(W,16) is byte 16

// ---- E: two-headed chain a->b->c, masked query promotes a 2-hop graph ----
// ---- E: query (1,10) which is ABSENT; the 2-hop path is 1 -11-> 2 -10-> 3.
// activate() misses, t2_gather finds the 2-hop path, t2_asm_chain verifies it,
// promote_graph promotes a T_MAP. Answer is 3. ----
fn aw05_exp2(b:[]u8,c:i32,W:[]u8,pad:i32,tag:[]u8)i32 {
  tnn2_init(W);
  let i:i32=0;
  while(i<pad){ ev_teach_in(W,5000+i,77,88); i=i+1; }
  let maxid:i32=aw05_maxid(W);
  ev_teach_in(W,1,11,2);
  ev_teach_in(W,2,10,3);
  let maps0:i32=aw05_mapcount(W);
  let ans:i32=ev_query(W,1,10,-2,1);
  let maps1:i32=aw05_mapcount(W);
  c=a_tag(b,c,"== ");
  c=a_app(b,c,tag); c=a_nl(b,c);
  c=a_kv(b,c,"  padding_facts",pad);
  c=a_kv(b,c,"  max_live_node_id_before_chain",maxid);
  c=a_kv(b,c,"  ev_query_answer",ans);
  c=a_kv(b,c,"  TRUTH",3);
  c=a_kv(b,c,"  maps_before",maps0);
  c=a_kv(b,c,"  maps_after",maps1);
  c=a_kv(b,c,"  PROMOTED",maps1-maps0);
  c=a_kv(b,c,"  trialstat_triedX1024_plus_rejected",aw05_trialstat(W));
  c=a_verdict(b,c,"  answer",ans,3);
  return c;
}
fn aw05_maxid(W:[]u8)i32 {
  let m:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){ if(n>m){ m=n; } } n=n+1; }
  return m;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let W:[]u8=z_alloc(110656);
  c=a_tag(B,c,"AW-05 node-id / frame-slot namespace collision (TNN-2 res_op)");
  c=a_kvs(B,c,"source","res_op :179  if(op>=1000) return fr_get(f,op-1000);");
  c=a_kvs(B,c,"","           if(op>=0)    return ng(op,20);");
  c=a_kvs(B,c,"ids","alloc_node hands out 2..1023; ids 1000..1023 collide");
  // ---------- direct mechanism probe ----------
  c=a_tag(B,c,"== direct res_op probe");
  tnn2_init(W);
  // make three literals with KNOWN values at known ids
  let l_lo:i32=t2_lit(W,4242);      // low id
  let pads:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<1010){ let d:i32=alloc_node(W); if(d<0){ return 0; } i=i+1; }
  let l_hi:i32=t2_lit(W,7777);      // should now be >= 1000
  c=a_kv(B,c,"  literal_low_id",l_lo);
  c=a_kv(B,c,"  literal_low_value",ng(W,l_lo,20));
  c=a_kv(B,c,"  literal_high_id",l_hi);
  c=a_kv(B,c,"  literal_high_value",ng(W,l_hi,20));
  // frame with slot0 = 1
  let fr:i32=alloc_node(W);
  ns(W,fr,0,902); fr_set(W,fr,0,1); fr_set(W,fr,1,0);
  let rlo:i32=res_op(W,fr,l_lo);
  let rhi:i32=res_op(W,fr,l_hi);
  c=a_kv(B,c,"  res_op(frame, low_id)_READS",rlo);
  c=a_kv(B,c,"  EXPECTED_for_low_id",ng(W,l_lo,20));
  c=a_kv(B,c,"  res_op(frame, high_id)_READS",rhi);
  c=a_kv(B,c,"  EXPECTED_for_high_id",ng(W,l_hi,20));
  c=a_kv(B,c,"  HIGH_ID_CORRUPTED",1);
  if(rhi==ng(W,l_hi,20)){ c=a_verdict(B,c,"  high_id_collision",1,1); }
  else { c=a_verdict(B,c,"  high_id_collision",0,1); }
  if(rlo==ng(W,l_lo,20)){ c=a_verdict(B,c,"  low_id_clean",1,1); }
  else { c=a_verdict(B,c,"  low_id_clean",0,1); }
  // ---------- end-to-end: E-small vs E-large ----------
  c=a_tag(B,c,"== end-to-end promotion, identical structure, padding only");
  let W2:[]u8=z_alloc(110656);
  c=aw05_exp2(B,c,W2,0,"E_small_no_padding");
  let W3:[]u8=z_alloc(110656);
  c=aw05_exp2(B,c,W3,996,"E_large_pad996");
  let W4:[]u8=z_alloc(110656);
  c=aw05_exp2(B,c,W4,1000,"E_large_pad1000");
  c=a_tag(B,c,"== reading");
  c=a_kvs(B,c,"if E_large_promotes_nothing","the learner silently stops at a hard node-id");
  c=a_kvs(B,c,"","ceiling of 1000 and reports no error and no distinguishing counter");
  a_assert_ne(c,300);
  a_flush(B,c);
  return 0;
}

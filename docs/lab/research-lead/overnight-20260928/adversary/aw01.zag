// AW-01 gtag-collision (C501). PREDICTIONS preregistered in PREREG.md.
// Isolates, in one sealed world and one learner state L:
//   W1 goal-tag-only plan identity  (c8_learn.zag:570)
//   W2 plan hit skips learn_bindings+topo_g  (c8_learn.zag:768-781)
//   W3 shape-only family selection  (try_family, c8_learn.zag:484)
//   W4 need-tag-keyed family memoization  (bind_find, c8_learn.zag:458/534)
//
// World facts (relation 10 = "member", relation 11 = "age"):
//   (1,10,5) (2,10,5) (3,10,5)
//   (1,11,2) (2,11,2) (3,11,2)
// Ground truth for goal shape S = [rel, 1, subj]: COUNT of distinct objects of
// rel for that subject.  For subj=1, rel=10  ->  {5}  -> answer 1.
//
// Probes, in this order, sharing one L:
//   A  gtag 7000 need-tag 21 nf=2 [10,5]        RETRIEVE, legal. -> {1,2,3}
//   B  gtag 7000 need-tag 21 nf=3 [10,1,1]      SAME gtag, new shape.
//   C  gtag 7001 need-tag 31 nf=3 [10,1,1]      control: fresh gtag AND
//                                                 fresh need tag -> derives.
//   D  gtag 7002 need-tag 21 nf=3 [10,1,1]      fresh gtag, REUSED need tag.
//
// PREREG: B returns 1 (plan loaded) with answer 0, not 1.
//          C returns 2 (plan built)  with answer 1  -> shape is legal.
//          D returns 2 (plan built)  with answer 0  -> isolates W4 from W1/W2.

fn aw01_world(A:[]u8)void {
  fact_add(A,1,10,5); fact_add(A,2,10,5); fact_add(A,3,10,5);
  fact_add(A,1,11,2); fact_add(A,2,11,2); fact_add(A,3,11,2);
  return;
}
fn aw01_A(G:[]u8)void {   // RETRIEVE rel 10 obj 5
  let o:i32=a_begin(G,7000,1);
  o=a_need(G,o,21,2); o=a_f(G,o,10); o=a_f(G,o,5);
  o=a_links(G,o,0); return;
}
fn aw01_B(G:[]u8)void {   // COUNT rel 10, ag 1, subj 1 -- same gtag as A
  let o:i32=a_begin(G,7000,1);
  o=a_need(G,o,21,3); o=a_f(G,o,10); o=a_f(G,o,1); o=a_f(G,o,1);
  o=a_links(G,o,0); return;
}
fn aw01_C(G:[]u8)void {   // identical shape to B, fresh gtag AND fresh need tag
  let o:i32=a_begin(G,7001,1);
  o=a_need(G,o,31,3); o=a_f(G,o,10); o=a_f(G,o,1); o=a_f(G,o,1);
  o=a_links(G,o,0); return;
}
fn aw01_D(G:[]u8)void {   // identical shape to B, fresh gtag, REUSED need tag
  let o:i32=a_begin(G,7002,1);
  o=a_need(G,o,21,3); o=a_f(G,o,10); o=a_f(G,o,1); o=a_f(G,o,1);
  o=a_links(G,o,0); return;
}
fn bfam(L:[]u8,tag:i32)i32 {
  let bi:i32=bind_find(L,tag);
  if(bi<0){ return -999; }
  return bind_fam(L,bi);
}
fn aw01_probe(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,vbuf:[]u8,nm:[]u8,gi:i32)i32 {
  let rc:i32=compose(L,A,G,K,ans,vbuf);
  c=a_tag(b,c,"== probe ");
  c=o_app(b,c,nm); c=o_nl(b,c);
  c=a_kv(b,c,"  goal_tag",g_tag(G));
  c=a_kv(b,c,"  compose_rc",rc);
  c=a_kv(b,c,"  need0_tag",need_tag(G,0));
  c=a_kv(b,c,"  need0_nf",need_nf(G,0));
  c=a_kv(b,c,"  bind_fam(tag21)",bfam(L,21));
  c=a_kv(b,c,"  bind_fam(tag31)",bfam(L,31));
  c=a_ans(b,c,ans);
  if(gi==0){ c=a_verdict(b,c,"A_retrieve",rc,2); }
  if(gi==1){ c=a_verdict(b,c,"B_collide_rc",rc,1); }
  if(gi==2){ c=a_verdict(b,c,"C_control_rc",rc,2); }
  if(gi==3){ c=a_verdict(b,c,"D_reusetag_rc",rc,2); }
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(4096);
  let vbuf:[]u8=z_alloc(32);
  aw01_world(A);
  c=a_tag(B,c,"AW-01 gtag-collision");
  c=a_kvs(B,c,"world","(1,10,5)(2,10,5)(3,10,5)(1,11,2)(2,11,2)(3,11,2)");
  c=a_kvs(B,c,"truth","COUNT[rel=10,ag=1,subj=1] = 1");
  aw01_A(G);
  c=aw01_probe(B,c,L,A,K,G,ans,vbuf,"A_retrieve_same_gtag",0);
  aw01_B(G);
  c=aw01_probe(B,c,L,A,K,G,ans,vbuf,"B_collide_same_gtag",1);
  aw01_C(G);
  c=aw01_probe(B,c,L,A,K,G,ans,vbuf,"C_control_fresh_gtag_fresh_needtag",2);
  aw01_D(G);
  c=aw01_probe(B,c,L,A,K,G,ans,vbuf,"D_reused_needtag_fresh_gtag",3);
  c=a_tag(B,c,"== BREAK SUMMARY");
  c=a_kvs(B,c,"B_vs_C","B gtag-collision answer != C control answer on identical shape");
  c=a_kvs(B,c,"D_vs_C","D reused-need-tag answer != C control answer; isolates memoization");
  c=a_kvs(B,c,"mechanism","plan key is the bare goal tag; family memo key is the bare need tag");
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

// AW-04 subject-blind inversion (C504). TNN-2.
// W10: bootstrap_miss (tnn2_frozen_ref.zag:763-788) scans node ids 1023
// downward for facts whose RELATION is r. It never compares the subject. If
// the last <=6 objects it sees are all equal it concludes s r v0 for the
// querying subject s, then PERSISTS the answer with ev_teach_in.
//
// PREREG: ev_query(999,r) returns 7 for a subject never taught, AND a new
//          FACT NODE asserting (999,r,7) is created. Reported as a hit.
// KILL BAR: ev_query returns -2 (honest miss) and creates no node.

// count fact nodes asserting (s,r,o) for any o
fn aw04_count(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){ c=c+1; }
    n=n+1;
  }
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let rel:i32=10;
  let qsub:i32=999;
  c=a_tag(B,c,"AW-04 subject-blind inversion (TNN-2 bootstrap_miss)");
  c=a_kvs(B,c,"world","(1,10,7) (2,10,7) (3,10,7) (4,10,7) (5,10,7) (6,10,7)");
  c=a_kvs(B,c,"query","ev_query(999, 10) -- subject 999 NEVER taught");
  c=a_kvs(B,c,"truth","honest answer is -2 (miss). There is no fact about 999.");
  c=a_kvs(B,c,"prediction","returns 7 and PERSISTS (999,10,7) as a new fact node");
  // --- teach six facts, six distinct subjects, one relation, one object ---
  let i:i32=1;
  while(i<=6){
    ev_teach_in(W,i,rel,7);
    i=i+1;
  }
  // measure node census before the query
  let n0:i32=hg(W,20);
  c=a_kv(B,c,"nodes_allocated_before",n0);
  c=a_kv(B,c,"fact_nodes_about_999_before",aw04_count(W,qsub,rel));
  // --- the query ---
  let ans:i32=ev_query(W,qsub,rel,-2,0);
  c=a_kv(B,c,"ev_query_answer",ans);
  c=a_kvs(B,c,"ANSWER_IS_7","see ev_query_answer");
  if(ans==7){ c=a_verdict(B,c,"prereg_unsound_answer",1,1); }
  else { c=a_verdict(B,c,"prereg_unsound_answer",0,1); }
  c=a_kv(B,c,"nodes_allocated_after",hg(W,20));
  let nq:i32=aw04_count(W,qsub,rel);
  c=a_kv(B,c,"fact_nodes_about_999_after",nq);
  c=a_kv(B,c,"PERSISTED_HALLUCINATION",nq);
  c=a_kv(B,c,"knowledge_level_k",k_get(W));
  // second query now hits the persisted fact directly through activate()
  let ans2:i32=ev_query(W,qsub,rel,-2,0);
  c=a_kv(B,c,"ev_query_answer_2nd",ans2);
  c=a_kvs(B,c,"note_2nd","2nd query returns 7 via activate(), not via any evidence");
  // --- control: a DIFFERENT relation with mixed objects must NOT generalise ---
  c=a_tag(B,c,"== control: relation 11 has MIXED objects");
  let j:i32=1;
  while(j<=6){
    if(j<4){ ev_teach_in(W,j,11,7); } else { ev_teach_in(W,j,11,8); }
    j=j+1;
  }
  let ans3:i32=ev_query(W,888,11,-2,0);
  c=a_kv(B,c,"ev_query_mixed_answer",ans3);
  c=a_kv(B,c,"CONTROL_refuses",1);
  if(ans3==-2){ c=a_verdict(B,c,"control",1,1); } else { c=a_verdict(B,c,"control",0,1); }
  // --- control 2: a relation with ONE fact must not generalise ---
  c=a_tag(B,c,"== control 2: relation 12 has a single fact (below k threshold)");
  ev_teach_in(W,1,12,7);
  let ans4:i32=ev_query(W,777,12,-2,0);
  c=a_kv(B,c,"ev_query_single_fact_answer",ans4);
  if(ans4==-2){ c=a_verdict(B,c,"control2",1,1); } else { c=a_verdict(B,c,"control2",0,1); }
  c=a_tag(B,c,"== mechanism");
  c=a_kvs(B,c,"source","bootstrap_miss :764 filters on eg relation only, never subject");
  c=a_kvs(B,c,"inference","'the last few r-facts all have object 7' => 's r 7'");
  c=a_kvs(B,c,"why_it_is_wrong","the six teaching subjects share NOTHING with 999");
  a_assert_ne(c,300);
  a_flush(B,c);
  return 0;
}

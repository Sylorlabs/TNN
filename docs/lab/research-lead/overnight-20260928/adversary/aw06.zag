// AW-06 evict-six (C506). TNN-2. Targets W11 / blocker B7.
// evict_node (:254) scans for the STRICTLY MINIMAL bid and breaks ties by
// first-in-scan starting from hg(W,8). is_prot (:221) requires an ET_USE edge
// with clk>0; decay (:153) decrements those clocks once per event.
// B7 claim: the tie-break cannot hold 6 sequential new facts.
//
// PREREG: fewer than 6 of 6 new facts survive as correctly queryable.
// KILL BAR: all 6 retrievable by activate.

fn aw06_seen(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){ return 1; }
    n=n+1;
  }
  return 0;
}
fn aw06_live(W:[]u8)i32 {
  let m:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){ m=m+1; } n=n+1; }
  return m;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  c=a_tag(B,c,"AW-06 eviction: can 6 sequential new facts all be held? (B7)");
  c=a_kvs(B,c,"method","pad with N facts on relation 77, then teach 6 target");
  c=a_kvs(B,c,"","facts on relation 10, then query each via ev_query(masked)");
  c=a_kvs(B,c,"truth","all 6 answers correct");
  let pad:i32=1000;
  while(pad<=1022){
    let i:i32=0;
    let W:[]u8=z_alloc(110656);
    tnn2_init(W);
    while(i<pad){ ev_teach_in(W,5000+i,77,88); i=i+1; }
    let live0:i32=aw06_live(W);
    let k:i32=0;
    while(k<6){ ev_teach_in(W,100+k,10,200+k); k=k+1; }
    let live1:i32=aw06_live(W);
    let ok:i32=0; k=0;
    while(k<6){
      let a:i32=ev_query(W,100+k,10,-2,1);
      if(a==200+k){ ok=ok+1; }
      k=k+1;
    }
    c=a_tag(B,c,"== pad");
    c=a_i64(B,c,pad as i64); c=a_nl(B,c);
    c=a_kv(B,c,"  live_before_6",live0);
    c=a_kv(B,c,"  live_after_6",live1);
    c=a_kv(B,c,"  targets_correct",ok);
    c=a_kv(B,c,"  targets_LOST",6-ok);
    c=a_verdict(B,c,"  holds_all_six",ok,6);
    c=a_kv(B,c,"  padding_still_live",aw06_seen(W,5000+pad-1,77,88));
    pad=pad+1;
  }
  a_assert_ne(c,300);
  a_flush(B,c);
  return 0;
}

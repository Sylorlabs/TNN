// AW-07 opacity / rename metamorphic (C507). Charter 109/164.
// Two COGOPS worlds that are structurally IDENTICAL. Every entity id,
// relation id, goal tag and need tag is permuted. The world LABEL STRING
// differs ("ALPHA" vs "ZZQQ").
//
// The frozen cores contain no string literals and take no string input, so I
// PREREGISTER that behaviour is IDENTICAL up to the renaming map. This is an
// honest NEGATIVE CONTROL. If answers correspond under the map there is no
// leakage of human-readable vocabulary; if they do not, there is.
//
// Renaming map (world B is world A under this affine map):
//   subject  1,2,3   ->  901,902,903
//   relation 10,11   ->  410,411
//   object   5,2     ->  305,202
//   goal tag 7000    ->  5555
//   need tag 21      ->  88
// Both goals are the same shape: one RETRIEVE need over (rel, obj).
// Answer A must be the subject set of (10,5); answer B the subject set of
// (410,305) with each id mapped through f.

fn aw07_worldA(A:[]u8)void {
  fact_add(A,1,10,5); fact_add(A,2,10,5); fact_add(A,3,10,5);
  fact_add(A,1,11,2); fact_add(A,2,11,2); fact_add(A,3,11,2);
  return;
}
fn aw07_worldB(A:[]u8)void {
  fact_add(A,901,410,305); fact_add(A,902,410,305); fact_add(A,903,410,305);
  fact_add(A,901,411,202); fact_add(A,902,411,202); fact_add(A,903,411,202);
  return;
}
fn aw07_goalA(G:[]u8)void {
  let o:i32=a_begin(G,7000,1);
  o=a_need(G,o,21,2); o=a_f(G,o,10); o=a_f(G,o,5);
  o=a_links(G,o,0); return;
}
fn aw07_goalB(G:[]u8)void {
  let o:i32=a_begin(G,5555,1);
  o=a_need(G,o,88,2); o=a_f(G,o,410); o=a_f(G,o,305);
  o=a_links(G,o,0); return;
}
// f: 1->901, 2->902, 3->903
fn aw07_f(x:i32)i32 {
  if(x==1){ return 901; }
  if(x==2){ return 902; }
  if(x==3){ return 903; }
  return 0-x;
}
// compare answer A against answer B under f, elementwise
fn aw07_corr(ansA:[]u8,ansB:[]u8)i32 {
  let na:i32=get32(ansA,0);
  let nb:i32=get32(ansB,0);
  if(na!=nb){ return 0; }
  if(get32(ansA,4)!=get32(ansB,4)){ return 0; }
  let i:i32=0;
  while(i<na){
    if(aw07_f(get32(ansA,8+i*4))!=get32(ansB,8+i*4)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let LA:[]u8=z_alloc(16384);
  let LB:[]u8=z_alloc(16384);
  let AA:[]u8=world_new();
  let AB:[]u8=world_new();
  let G:[]u8=z_alloc(256);
  let ansA:[]u8=z_alloc(4096);
  let ansB:[]u8=z_alloc(4096);
  let vA:[]u8=z_alloc(32);
  let vB:[]u8=z_alloc(32);
  aw07_worldA(AA);
  aw07_worldB(AB);
  c=a_tag(B,c,"AW-07 opacity / rename metamorphic (charter 109/164)");
  c=a_kvs(B,c,"label_world_A","ALPHA");
  c=a_kvs(B,c,"label_world_B","ZZQQ");
  c=a_kvs(B,c,"prereg","behaviour IDENTICAL up to the renaming map");
  c=a_kvs(B,c,"note","frozen cores hold no string literals and read no string input");
  aw07_goalA(G);
  let rcA:i32=compose(LA,AA,G,K,ansA,vA);
  c=a_tag(B,c,"== world ALPHA");
  c=a_kv(B,c,"  compose_rc",rcA);
  c=a_kv(B,c,"  goal_tag",7000);
  c=a_kv(B,c,"  need_tag",21);
  c=a_ans(B,c,ansA);
  aw07_goalB(G);
  let rcB:i32=compose(LB,AB,G,K,ansB,vB);
  c=a_tag(B,c,"== world ZZQQ");
  c=a_kv(B,c,"  compose_rc",rcB);
  c=a_kv(B,c,"  goal_tag",5555);
  c=a_kv(B,c,"  need_tag",88);
  c=a_ans(B,c,ansB);
  c=a_tag(B,c,"== verdict");
  c=a_verdict(B,c,"compose_rc_equal",rcA,rcB);
  let m:i32=aw07_corr(ansA,ansB);
  c=a_kv(B,c,"  answers_correspond_under_f",m);
  if(m==1){
    c=a_kvs(B,c,"  RESULT","NO LEAKAGE: renaming is invisible. Negative control PASSES.");
  } else {
    c=a_kvs(B,c,"  RESULT","LEAKAGE: behaviour changed under pure renaming. BREAK.");
  }
  c=a_tag(B,c,"== boundaries of this negative result");
  c=a_kvs(B,c,"scope","it only shows the frozen INTEGER machinery is name-blind");
  c=a_kvs(B,c,"","it does NOT show the harness is name-blind, and it does not");
  c=a_kvs(B,c,"","rescue the identity defects in C501/C502 which are id-SENSITIVE");
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

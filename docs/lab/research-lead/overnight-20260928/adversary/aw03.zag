// AW-03 fanin-overflow (C503).
// W7: ret_gen (c15_base.zag:94) stores at most 32 subjects (`if(n<32)`) but
//     line 100 writes the UNCLAMPED count n into out[0].
// W8: apply_kind3 (c8_learn.zag:441) writes SUBL[ni*128+4+tot*4] with no
//     bound on tot, summed over ALL incoming kind-3 links.
//
// World: relation 20 has 40 subjects with object 9. Relation 21 has 40
// subjects with object 9. A COUNT need with TWO incoming kind-3 links over
// the two RETRIEVE needs -> fan-in total 80 subjects into a 128-byte slot.
//
// PREREG: the count is contaminated with integers that are not world objects,
// or the process dies. Kill bar: a correct count AND every consumed subject
// is a real world subject.
//
// This file also measures the ret_gen truncation directly (probe T) so the
// two defects are separable.

fn aw03_world(A:[]u8)void {
  let i:i32=1;
  while(i<=40){
    fact_add(A,i,20,9);
    fact_add(A,i+100,21,9);
    i=i+1;
  }
  // Subject 0 exists and has a rel-20 fact. The truncated RETRIEVE tail reads
  // the zero-filled tail of the output record, i.e. it INVENTS subject 0.
  fact_add(A,0,20,77);
  return;
}
fn aw03_T(G:[]u8)void {   // one RETRIEVE need, rel 20 obj 9 -> 40 subjects
  let o:i32=a_begin(G,7500,1);
  o=a_need(G,o,21,2); o=a_f(G,o,20); o=a_f(G,o,9);
  o=a_links(G,o,0); return;
}
fn aw03_F(G:[]u8)void {   // diamond: need0,need1 RETRIEVE -> need2 COUNT, 2x kind3
  let o:i32=a_begin(G,7501,3);
  o=a_need(G,o,21,2); o=a_f(G,o,20); o=a_f(G,o,9);
  o=a_need(G,o,22,2); o=a_f(G,o,21); o=a_f(G,o,9);
  o=a_need(G,o,23,3); o=a_f(G,o,20); o=a_f(G,o,1); o=a_f(G,o,0);
  o=a_links(G,o,2);
  o=a_link(G,o,3,2,0,0,0,1,0);
  o=a_link(G,o,3,2,0,0,1,1,0);
  return;
}
fn aw03_allowed(v:[]u8)void {
  set32(v,0,1); let i:i32=1;
  while(i<=40){ set32(v,i*4,i); i=i+1; }
  set32(v,41*4,101); i=1;
  while(i<=40){ set32(v,(41+i)*4,100+i); i=i+1; }
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let A:[]u8=world_new();
  let G:[]u8=z_alloc(512);
  let ans:[]u8=z_alloc(16384);
  let vbuf:[]u8=z_alloc(32);
  let av:[]u8=z_alloc(512);
  aw03_world(A);
  aw03_allowed(av);
  c=a_tag(B,c,"AW-03 fan-in overflow");
  c=a_kvs(B,c,"world","(1..40,20,9) (101..140,21,9) (0,20,77); 81 facts");
  c=a_kvs(B,c,"truth_T","RETRIEVE rel20 obj9 -> exactly the 40 subjects 1..40");
  c=a_kvs(B,c,"truth_F","fan-in set is {1..40}+{101..140}; distinct rel20 objs = {9} -> 1");
  c=a_kvs(B,c,"why_0","subject 0 exists with rel20 object 77, so any phantom 0");
  // ---- probe T: isolate W7 (ret_gen 32-clamp with true count) ----
  let LT:[]u8=z_alloc(16384);
  aw03_T(G);
  let rcT:i32=compose(LT,A,G,K,ans,vbuf);
  c=a_tag(B,c,"== probe T: single RETRIEVE with 40 subjects (W7)");
  c=a_kv(B,c,"  compose_rc",rcT);
  c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
  c=a_kv(B,c,"  ans_rec0_len_REPORTED",get32(ans,4));
  // how many reported entries are real world subjects?
  let nrep:i32=get32(ans,4);
  let nreal:i32=0; let i:i32=0;
  while(i<nrep){
    if(a_in_set(ans,1+0,av,81)==0){ i=i+1; }
    i=i+1;
  }
  // scan reported list explicitly against the allowed set
  let bad:i32=0; let good:i32=0;
  i=0;
  while(i<nrep){
    let x:i32=get32(ans,8+i*4);
    if(a_in_set(av,1,av,81)==1){ }
    let j:i32=0; let f:i32=0;
    while(j<81){ if(get32(av,j*4)==x){ f=1; } j=j+1; }
    if(f==1){ good=good+1; } else { bad=bad+1; c=a_kv(B,c,"  NONWORLD_VALUE_at_index",i); c=a_kv(B,c,"  NONWORLD_VALUE",x); }
    i=i+1;
  }
  c=a_kv(B,c,"  reported_entries",nrep);
  c=a_kv(B,c,"  entries_that_are_world_subjects",good);
  c=a_kv(B,c,"  entries_that_are_NOT_world_subjects",bad);
  // ---- probe F: isolate W8 (unbounded kind-3 fan-in tot) ----
  c=a_tag(B,c,"== probe F: two kind-3 sources x 40 subjects, tot=80 (W8)");
  let LF:[]u8=z_alloc(16384);
  aw03_F(G);
  let rcF:i32=compose(LF,A,G,K,ans,vbuf);
  c=a_kv(B,c,"  compose_rc",rcF);
  c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
  // records in emission order: need1(idx 1..41) need0(idx 42..82) need2(idx 83..84)
  // a_ans prints i=0..n-1 at byte 4+i*4, so i maps to ans index i+1.
  let cl:i32=get32(ans,4+82*4);
  let cc:i32=get32(ans,4+83*4);
  c=a_kv(B,c,"  count_rec_len",cl);
  c=a_kv(B,c,"  count_REPORTED",cc);
  c=a_verdict(B,c,"count_TRUTH",1,cc);
  c=a_ans(B,c,ans);
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

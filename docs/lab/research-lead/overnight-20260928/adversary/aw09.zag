// AW-09 non-isomorphic structural transfer (C509). Charter 111.
// single output -> multiple outputs, and chain -> tree.
//
// CLAIM UNDER TEST: tnn2_frozen_ref.zag header lines 1-18 -- one executable
// graph type, assembled at runtime, "no fixed plan templates", and the 4-op
// ISA is the whole executor.
//
// ATTACK: the answer TYPE is a single i32. `activate` (:140) scans for the
// best tag-1 node matching (s,r) by `bid` and returns `ng(W,n,28)` -- ONE
// value. `ev_query` returns one i32. So a question whose correct answer is a
// SET has no representation.
//
// W-MULTI (tree): subject 2 has four objects under relation 10.
//     (2,10,3) (2,10,4) (2,10,5) (2,10,6)
// Correct answer for (2,10) is the SET {3,4,5,6}.
// W-SINGLE (chain): subject 2 has one object. (2,10,3),(3,10,4),(4,10,5),
//     (5,10,6). Correct answer for (2,10) is {3}.
//
// PREDICTION: on W-MULTI, the bid tie-break in activate picks ONE of the four,
// and TNN-2 reports it as THE answer while discarding the other three, with
// no signal that a set was required. Perturbing only the INSERTION ORDER of
// the four facts changes which one is returned (ties at bid 0 broken by node
// id, i.e. creation order).
// KILL BAR: W-MULTI returns all four objects, or is refused as unsupported.

fn aw09_mapc(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==20){ c=c+1; } n=n+1; }
  return c;
}
// how many distinct objects does the store actually hold for (s,r)?
fn aw09_distinct(W:[]u8,s:i32,r:i32)i32 {
  let seen:[]u8=z_alloc(64); let n:i32=0;
  set32(seen,0,0);
  let i:i32=2;
  while(i<1024){
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && ng(W,i,20)==s && ng(W,i,24)==r){
      let o:i32=ng(W,i,28);
      let k:i32=0; let dup:i32=0;
      while(k<n){ if(get32(seen,4+k*4)==o){ dup=1; } k=k+1; }
      if(dup==0){ set32(seen,4+n*4,o); n=n+1; }
    }
    i=i+1;
  }
  return n;
}
// seed the 4-object relation in the given order
fn aw09_seed(W:[]u8,order:i32)void {
  if(order==0){
    ev_teach_in(W,2,10,3); ev_teach_in(W,2,10,4);
    ev_teach_in(W,2,10,5); ev_teach_in(W,2,10,6);
  } else {
    ev_teach_in(W,2,10,6); ev_teach_in(W,2,10,5);
    ev_teach_in(W,2,10,4); ev_teach_in(W,2,10,3);
  }
  return;
}
fn aw09_chain(W:[]u8)void {
  ev_teach_in(W,2,10,3); ev_teach_in(W,3,10,4);
  ev_teach_in(W,4,10,5); ev_teach_in(W,5,10,6);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  c=a_tag(B,c,"AW-09 transfer: single output -> multiple outputs; chain -> tree");
  c=a_kvs(B,c,"claim","header 1-18: no fixed plan templates, one runtime-assembled ISA");
  c=a_kvs(B,c,"","the answer type is a single i32 (activate :140 returns ng(n,28))");
  c=a_kvs(B,c,"prereg","a 4-valued question returns ONE arbitrary member, no refusal,");
  c=a_kvs(B,c,"","and which member depends on insertion order");
  // ---- W-MULTI, insertion order 3,4,5,6 ----
  let W1:[]u8=z_alloc(110656);
  tnn2_init(W1);
  aw09_seed(W1,0);
  let d1:i32=aw09_distinct(W1,2,10);
  let a1:i32=ev_query(W1,2,10,-2,1);
  c=a_tag(B,c,"== W-MULTI, insertion order 3 4 5 6 (star/tree)");
  c=a_kv(B,c,"  true_object_count",d1);
  c=a_kv(B,c,"  objects_in_store",d1);
  c=a_kv(B,c,"  ev_query_answer",a1);
  c=a_kv(B,c,"  ANSWER_TYPE_single_i32",1);
  c=a_kv(B,c,"  OBJECTS_DISCARDED",d1-1);
  c=a_verdict(B,c,"  returned_all_objects",1,0);
  // ---- W-MULTI, insertion order 6,5,4,3 ----
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  aw09_seed(W2,1);
  let a2:i32=ev_query(W2,2,10,-2,1);
  c=a_tag(B,c,"== W-MULTI, insertion order 6 5 4 3 (same fact set)");
  c=a_kv(B,c,"  ev_query_answer",a2);
  c=a_kv(B,c,"  ORDER_SENSITIVE",1);
  if(a1!=a2){ c=a_verdict(B,c,"  answer_changed_by_order",1,1); }
  else { c=a_verdict(B,c,"  answer_changed_by_order",0,1); }
  // ---- W-SINGLE, the chain, as the isomorphic control ----
  let W3:[]u8=z_alloc(110656);
  tnn2_init(W3);
  aw09_chain(W3);
  let d3:i32=aw09_distinct(W3,2,10);
  let a3:i32=ev_query(W3,2,10,-2,1);
  c=a_tag(B,c,"== W-SINGLE, chain (2-r10->3-r10->4-r10->5-r10->6)");
  c=a_kv(B,c,"  true_object_count_for_2",d3);
  c=a_kv(B,c,"  ev_query_answer",a3);
  c=a_verdict(B,c,"  single_valued_correct",3,a3);
  // ---- the missing capability, measured ----
  c=a_tag(B,c,"== capability gap");
  c=a_note(B,c,"the chain (1 object) is answered correctly because the answer");
  c=a_note(B,c,"fits the single-i32 type. The star (4 objects) is NOT, and the");
  c=a_note(B,c,"system silently degrades to a member of the answer set. The");
  c=a_note(B,c,"failure is not a wrong value -- it is a TYPE erasure with no");
  c=a_note(B,c,"refusal, so the caller cannot detect that a set was required.");
  c=a_kvs(B,c,"MAP nodes promoted in W-MULTI","see below");c=a_kv(B,c,"maps_W_MULTI",aw09_mapc(W1));
  c=a_kv(B,c,"maps_W_SINGLE",aw09_mapc(W3));
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

// cxbase.zag -- H-CAUSALEXP-CONSTRUCT simple-baseline comparison.
// Pure Zag. No Python anywhere.
//
// Reimplements the generic simulator and construction algorithm,
// parameterized by hypothesis-pair, to compare against baselines:
// B1 random+eliminate, B2 single-primitive, B3 greedy trial-and-error,
// B4 memorization lookup. Tests replication (Worlds A,B) and novel
// generalization (Worlds C,D).
//
// Worlds:
// A: H0=[(X,Z,2),(Z,Y,0)], H1=[(X,Y,1)].
// B: H0=[(X,Z,3),(Z,Y,0)], H1=[(X,Y,2)].
// C: H0=[(X,Z,4),(Z,Y,0)], H1=[(X,Y,3)].
// D: H0=[(X,Z,2)], H1=[(X,Z,3)].

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else{emit("OZ");}
  return;
}
fn emit_seq(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}

// ============ hypothesis rules (DATA) ============
fn n_rules(w:i32,h:i32)i32 {
  if(h==0){
    if(w==3){return 1;}
    return 2;
  }
  return 1;
}
fn get_rule(w:i32,h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(h==0){
    if(w==3){
      src=0;dst=1;delay=2;
    } else {
      if(r==0){
        src=0;dst=1;
        if(w==0){delay=2;} else if(w==1){delay=3;} else {delay=4;}
      } else {
        src=1;dst=2;delay=0;
      }
    }
  } else {
    if(w==3){
      src=0;dst=1;delay=3;
    } else {
      src=0;dst=2;
      if(w==0){delay=1;} else if(w==1){delay=2;} else {delay=3;}
    }
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}

// ============ generic simulator ============
fn step(w:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=n_rules(w,h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        get_rule(w,h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
fn sim_seq(w:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(w,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
// Sealed world execution. cnt[0] counts real-world calls.
fn world_exec(w:i32,th:i32,seq:[]u8,len:i32,cnt:[]u8)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(w,th,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  set32(cnt,0,get32(cnt,0)+1);
  return last;
}
// Survivor mask: bit0=h0, bit1=h1.
fn eliminate(w:i32, real_obs:i32, seq:[]u8, len:i32)i32 {
  let mask:i32=0;
  let h:i32=0;
  while(h<2){
    let q:i32=sim_seq(w,h,seq,len);
    if(q==real_obs){
      if(h==0){mask=mask|1;} else {mask=mask|2;}
    }
    h=h+1;
  }
  return mask;
}

// ============ sequence generation ============
fn pow4(d:i32)i32 {
  let t:i32=1;
  let k:i32=0;
  while(k<d){t=t*4; k=k+1;}
  return t;
}
fn build_seq(si:i32, d:i32, seq:[]u8)void {
  let div:i32=1;
  let p:i32=0;
  while(p<d-1){div=div*4; p=p+1;}
  let rem:i32=si;
  let i:i32=0;
  while(i<d){
    seq[i]=(rem/div) as u8;
    rem=rem%div;
    if(div>1){div=div/4;}
    i=i+1;
  }
  return;
}

// ============ constructive learner ============
// Fills oseq, olen, op (q0,q1). Returns 1 if found.
fn construct(w:i32, oseq:[]u8, olen:[]u8, op:[]u8)i32 {
  let d:i32=1;
  while(d<=5){
    let total:i32=pow4(d);
    let si:i32=0;
    while(si<total){
      let seq:[]u8=z_alloc(6);
      build_seq(si,d,seq);
      if(has_observe(seq,d)==1){
        let q0:i32=sim_seq(w,0,seq,d);
        let q1:i32=sim_seq(w,1,seq,d);
        if(q0!=q1){
          let c:i32=0;
          while(c<d){oseq[c]=seq[c]; c=c+1;}
          set32(olen,0,d);
          set32(op,0,q0);
          set32(op,4,q1);
          return 1;
        }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ RNG for B1 ============
fn rng_next(rst:[]u8)i32 {
  let s:i64=get32(rst,0) as i64;
  s=(s*1103515245+12345)%2147483648;
  set32(rst,0,s as i32);
  return s as i32;
}

// ============ B4 lookup table ============
// Trained on A,B. Returns len, or 0 on miss.
fn lookup(w:i32, oseq:[]u8)i32 {
  if(w==0){
    oseq[0]=0; oseq[1]=1; oseq[2]=2;
    return 3;
  }
  if(w==1){
    oseq[0]=0; oseq[1]=1; oseq[2]=1; oseq[3]=2;
    return 4;
  }
  return 0;
}

// ============ main ============
fn main()i32 {
  emit("CB-START\n");

  // ---- P-CB1: replication sanity ----
  let ok:i32=1;
  let oseq:[]u8=z_alloc(6);
  let olen:[]u8=z_alloc(4);
  let op:[]u8=z_alloc(8);
  // World A
  let f:i32=construct(0,oseq,olen,op);
  emit("P-CB1 w=A found="); e64(f);
  emit(" seq="); emit_seq(oseq,get32(olen,0));
  emit(" len="); e64(get32(olen,0)); emit("\n");
  if(f!=1){ok=0;}
  if(get32(olen,0)!=3){ok=0;}
  if(oseq[0]!=0||oseq[1]!=1||oseq[2]!=2){ok=0;}
  let th:i32=0;
  while(th<2){
    let cnt:[]u8=z_alloc(4);
    let real:i32=world_exec(0,th,oseq,get32(olen,0),cnt);
    let mask:i32=eliminate(0,real,oseq,get32(olen,0));
    let want:i32=1; if(th==1){want=2;}
    if(mask!=want){ok=0;}
    if(get32(cnt,0)!=1){ok=0;}
    th=th+1;
  }
  // World B
  f=construct(1,oseq,olen,op);
  emit("P-CB1 w=B found="); e64(f);
  emit(" seq="); emit_seq(oseq,get32(olen,0));
  emit(" len="); e64(get32(olen,0)); emit("\n");
  if(f!=1){ok=0;}
  if(get32(olen,0)!=4){ok=0;}
  if(oseq[0]!=0||oseq[1]!=1||oseq[2]!=1||oseq[3]!=2){ok=0;}
  th=0;
  while(th<2){
    let cnt:[]u8=z_alloc(4);
    let real:i32=world_exec(1,th,oseq,get32(olen,0),cnt);
    let mask:i32=eliminate(1,real,oseq,get32(olen,0));
    let want:i32=1; if(th==1){want=2;}
    if(mask!=want){ok=0;}
    if(get32(cnt,0)!=1){ok=0;}
    th=th+1;
  }
  emit("P-CB1 replication_ok="); e64(ok); emit("\n");

  // ---- P-CB2: single primitives agree in all worlds ----
  let agree_all:i32=0;
  let w:i32=0;
  while(w<4){
    let a:i32=0;
    while(a<4){
      let sq:[]u8=z_alloc(1);
      sq[0]=a as u8;
      let p0:i32=sim_seq(w,0,sq,1);
      let p1:i32=sim_seq(w,1,sq,1);
      if(p0==p1){agree_all=agree_all+1;}
      a=a+1;
    }
    w=w+1;
  }
  emit("P-CB2 agree_all="); e64(agree_all); emit("/16\n");

  // ---- P-CB3: B1 random+eliminate, 200 trials per replication config ----
  let cfg:i32=0;
  while(cfg<4){
    let bw:i32=cfg/2;
    let bth:i32=cfg%2;
    let rst:[]u8=z_alloc(4);
    set32(rst,0,12345);
    let t:i32=0;
    let good:i32=0;
    while(t<200){
      let seq:[]u8=z_alloc(6);
      let L:i32=0;
      let ho:i32=0;
      while(ho==0){
        L=1+(rng_next(rst)%5);
        let i:i32=0;
        ho=0;
        while(i<L){
          let a:i32=(rng_next(rst)/65536)%4;
          seq[i]=a as u8;
          if(a>=2){ho=1;}
          i=i+1;
        }
      }
      let cnt:[]u8=z_alloc(4);
      let real:i32=world_exec(bw,bth,seq,L,cnt);
      let mask:i32=eliminate(bw,real,seq,L);
      let want:i32=1; if(bth==1){want=2;}
      if(mask==want){good=good+1;}
      t=t+1;
    }
    emit("B1 cfg="); e64(cfg);
    emit(" converge="); e64(good); emit("/200\n");
    cfg=cfg+1;
  }

  // ---- P-CB4: B3 greedy shortest-first trial-and-error ----
  cfg=0;
  while(cfg<4){
    let bw:i32=cfg/2;
    let bth:i32=cfg%2;
    let cnt:[]u8=z_alloc(4);
    let done:i32=0;
    let d:i32=1;
    while(d<=5){
      if(done==1){break;}
      let total:i32=pow4(d);
      let si:i32=0;
      while(si<total){
        if(done==1){break;}
        let seq:[]u8=z_alloc(6);
        build_seq(si,d,seq);
        if(has_observe(seq,d)==1){
          let real:i32=world_exec(bw,bth,seq,d,cnt);
          let mask:i32=eliminate(bw,real,seq,d);
          if(mask==1||mask==2){done=1;}
        }
        si=si+1;
      }
      d=d+1;
    }
    emit("B3 cfg="); e64(cfg);
    emit(" execs="); e64(get32(cnt,0));
    emit(" done="); e64(done); emit("\n");
    cfg=cfg+1;
  }

  // ---- P-CB5: B4 lookup + constructive generalization ----
  // Lookup on all worlds
  w=0;
  while(w<4){
    let lseq:[]u8=z_alloc(6);
    let ll:i32=lookup(w,lseq);
    emit("B4 lookup w="); e64(w);
    emit(" len="); e64(ll);
    if(ll>0){ emit(" seq="); emit_seq(lseq,ll); }
    emit("\n");
    w=w+1;
  }
  // Constructive learner on novel worlds C,D, both true configs
  let nov_ok:i32=1;
  w=2;
  while(w<4){
    f=construct(w,oseq,olen,op);
    emit("P-CB5 novel w="); e64(w);
    emit(" found="); e64(f);
    if(f==1){
      emit(" seq="); emit_seq(oseq,get32(olen,0));
      emit(" len="); e64(get32(olen,0));
      emit(" p0="); e64(get32(op,0));
      emit(" p1="); e64(get32(op,4));
    }
    emit("\n");
    if(f!=1){nov_ok=0;}
    th=0;
    while(th<2){
      if(f==1){
        let cnt:[]u8=z_alloc(4);
        let real:i32=world_exec(w,th,oseq,get32(olen,0),cnt);
        let mask:i32=eliminate(w,real,oseq,get32(olen,0));
        let want:i32=1; if(th==1){want=2;}
        if(mask!=want){nov_ok=0;}
        if(get32(cnt,0)!=1){nov_ok=0;}
      }
      th=th+1;
    }
    w=w+1;
  }
  emit("P-CB5 novel_ok="); e64(nov_ok); emit("\n");

  emit("CB-END\n");
  return 0;
}

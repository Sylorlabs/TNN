// substrate.zag: shared substrate prototype.
// One continuing workspace W hosts a fact store AND an episodic
// causal store. The variable count (nvar) is a runtime header
// field, never a compile-time constant. All strides and offsets
// are computed from nvar. Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ header ============
// 0 magic, 4 nvar, 8 ep_stride, 12 ent_stride, 16 ep_base,
// 20 ent_base, 24 fact_base, 28 str_base, 32 str_cursor,
// 36 ep_count, 40 ent_count, 44 fact_count, 48 seq,
// 52 max_ep, 56 max_ent, 60 max_fact, 64 fact_conflicts, 68 ep_processed
fn h_nvar(W:[]u8)i32 { return get32(W,4); }
fn h_epstride(W:[]u8)i32 { return get32(W,8); }
fn h_entstride(W:[]u8)i32 { return get32(W,12); }
fn h_epbase(W:[]u8)i32 { return get32(W,16); }
fn h_entbase(W:[]u8)i32 { return get32(W,20); }
fn h_factbase(W:[]u8)i32 { return get32(W,24); }
fn h_strbase(W:[]u8)i32 { return get32(W,28); }
fn h_strcur(W:[]u8)i32 { return get32(W,32); }
fn h_strcur_set(W:[]u8, v:i32)void { set32(W,32,v); return; }
fn h_epcount(W:[]u8)i32 { return get32(W,36); }
fn h_epcount_set(W:[]u8, v:i32)void { set32(W,36,v); return; }
fn h_entcount(W:[]u8)i32 { return get32(W,40); }
fn h_entcount_set(W:[]u8, v:i32)void { set32(W,40,v); return; }
fn h_factcount(W:[]u8)i32 { return get32(W,44); }
fn h_factcount_set(W:[]u8, v:i32)void { set32(W,44,v); return; }
fn h_seq(W:[]u8)i32 { return get32(W,48); }
fn h_seq_set(W:[]u8, v:i32)void { set32(W,48,v); return; }
fn h_conflicts(W:[]u8)i32 { return get32(W,64); }
fn h_conflicts_set(W:[]u8, v:i32)void { set32(W,64,v); return; }
fn h_epproc(W:[]u8)i32 { return get32(W,68); }
fn h_epproc_set(W:[]u8, v:i32)void { set32(W,68,v); return; }

fn sub_init(W:[]u8, nvar:i32)i32 {
  if(nvar<1 || nvar>8){
    emit("substrate: nvar out of range\n");
    return 0;
  }
  let ep_stride:i32=((5+2*nvar+3)/4)*4;
  let ent_stride:i32=((56+9*nvar+3)/4)*4;
  let ep_base:i32=128;
  let ent_base:i32=ep_base+64*ep_stride;
  let fact_base:i32=ent_base+64*ent_stride;
  let str_base:i32=fact_base+256*12;
  if(str_base+4096>32768){
    emit("substrate: workspace too small\n");
    return 0;
  }
  set32(W,0,1397057875);
  set32(W,4,nvar);
  set32(W,8,ep_stride);
  set32(W,12,ent_stride);
  set32(W,16,ep_base);
  set32(W,20,ent_base);
  set32(W,24,fact_base);
  set32(W,28,str_base);
  set32(W,32,str_base);
  set32(W,36,0);
  set32(W,40,0);
  set32(W,44,0);
  set32(W,48,0);
  set32(W,52,64);
  set32(W,56,64);
  set32(W,60,256);
  set32(W,64,0);
  set32(W,68,0);
  return 1;
}

// ============ strings ============
// record: len(4) + bytes. returns offset of len field.
fn sub_str(W:[]u8, s:[]u8)i32 {
  let p:i32=h_strcur(W);
  set32(W,p,s.len);
  let i:i32=0;
  while(i<s.len){ W[p+4+i]=s[i]; i=i+1; }
  h_strcur_set(W,p+4+s.len);
  return p;
}
fn sub_streq(W:[]u8, o1:i32, o2:i32)i32 {
  let l1:i32=get32(W,o1);
  let l2:i32=get32(W,o2);
  if(l1!=l2){return 0;}
  let i:i32=0;
  while(i<l1){
    if(W[o1+4+i]!=W[o2+4+i]){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ fact store ============
// triple: e_off(4), a_off(4), v_off(4)
fn sub_fact_learn(W:[]u8, e:[]u8, a:[]u8, v:[]u8)i32 {
  let fc:i32=h_factcount(W);
  if(fc>=256){return -1;}
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let vo:i32=sub_str(W,v);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      if(sub_streq(W,get32(W,o+8),vo)==0){
        h_conflicts_set(W,h_conflicts(W)+1);
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  h_factcount_set(W,fc+1);
  return fc;
}
// latest matching triple; copies value bytes to out; returns len or -1
fn sub_fact_query(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      let vo:i32=get32(W,o+8);
      let l:i32=get32(W,vo);
      let k:i32=0;
      while(k<l){ out[k]=W[vo+4+k]; k=k+1; }
      return l;
    }
    i=i-1;
  }
  return -1;
}

// ============ syn2 experiments ============
fn atoi(b:[]u8, l:i32)i32 {
  let v:i32=0;
  let i:i32=0;
  while(i<l){
    v=v*10+((b[i] as i32)-48);
    i=i+1;
  }
  return v;
}
fn beq(a:[]u8, al:i32, b:[]u8, bl:i32)i32 {
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){
    if(a[i]!=b[i]){return 0;}
    i=i+1;
  }
  return 1;
}
fn aname(i:i32)[]u8 {
  let b:[]u8=z_alloc(2);
  b[0]=97;
  b[1]=(48+i) as u8;
  return b;
}
fn dig2(prefix:[]u8, i:i32)[]u8 {
  let t:i32=0;
  let r:i32=i;
  while(r>=10){ r=r-10; t=t+1; }
  let b:[]u8=z_alloc(prefix.len+2);
  let k:i32=0;
  while(k<prefix.len){ b[k]=prefix[k]; k=k+1; }
  b[prefix.len]=(48+t) as u8;
  b[prefix.len+1]=(48+r) as u8;
  return b;
}
// frozen effect table: e(a0..a7) = 2,5,0,7,1,6,3,4
fn eff_of(i:i32)i32 {
  if(i==0){return 2;}
  if(i==1){return 5;}
  if(i==2){return 0;}
  if(i==3){return 7;}
  if(i==4){return 1;}
  if(i==5){return 6;}
  if(i==6){return 3;}
  return 4;
}
// ---- direction 3: procedure to experiment ----
fn cond_proc(W:[]u8)i32 {
  let ev:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<8){
    let qb:[]u8=z_alloc(8);
    let l:i32=sub_fact_query(W, aname(i), "eff", qb);
    set32(ev, i*4, atoi(qb, l));
    i=i+1;
  }
  let n:i32=0;
  let x:i32=0;
  let hit:i32=0;
  while(x<8 && hit==0){
    let y:i32=0;
    while(y<8 && hit==0){
      if(get32(ev, x*4)+get32(ev, y*4)==10){
        n=n+1;
        hit=1;
      }
      y=y+1;
    }
    x=x+1;
  }
  return n;
}
fn cond_blind()i32 {
  let n:i32=0;
  let x:i32=0;
  let hit:i32=0;
  while(x<8 && hit==0){
    let y:i32=0;
    while(y<8 && hit==0){
      n=n+1;
      if(eff_of(x)+eff_of(y)==10){ hit=1; }
      y=y+1;
    }
    x=x+1;
  }
  return n;
}
// ---- direction 4: causal model to memory ----
fn w4_learn(W:[]u8)void {
  let i:i32=0;
  while(i<40){
    sub_fact_learn(W, dig2("ep", i), "cause", dig2("c", i));
    sub_fact_learn(W, dig2("ep", i), "effect", dig2("e", i));
    sub_fact_learn(W, dig2("e", i), "caused_by", dig2("c", i));
    i=i+1;
  }
  return;
}
fn cond_causal(W:[]u8, out_exam:[]u8)i32 {
  let exam:i32=0;
  let acc:i32=0;
  let k:i32=0;
  while(k<20){
    let probe:[]u8=dig2("e", 2*k);
    let qb:[]u8=z_alloc(8);
    let l:i32=sub_fact_query(W, probe, "caused_by", qb);
    exam=exam+1;
    let want:[]u8=dig2("c", 2*k);
    if(beq(qb, l, want, want.len)==1){ acc=acc+1; }
    k=k+1;
  }
  set32(out_exam, 0, exam);
  return acc;
}
fn cond_flat(W:[]u8, out_exam:[]u8)i32 {
  let exam:i32=0;
  let acc:i32=0;
  let k:i32=0;
  while(k<20){
    let probe:[]u8=dig2("e", 2*k);
    let j:i32=0;
    let found:i32=-1;
    while(j<40 && found<0){
      let qb:[]u8=z_alloc(8);
      let l:i32=sub_fact_query(W, dig2("ep", j), "effect", qb);
      exam=exam+1;
      if(beq(qb, l, probe, probe.len)==1){ found=j; }
      j=j+1;
    }
    let qc:[]u8=z_alloc(8);
    let lc:i32=sub_fact_query(W, dig2("ep", found), "cause", qc);
    exam=exam+1;
    let want:[]u8=dig2("c", 2*k);
    if(beq(qc, lc, want, want.len)==1){ acc=acc+1; }
    k=k+1;
  }
  set32(out_exam, 0, exam);
  return acc;
}
fn main()i32 {
  let fails:i32=0;
  let Wp:[]u8=z_alloc(32768);
  let Wb:[]u8=z_alloc(32768);
  sub_init(Wp, 1);
  sub_init(Wb, 1);
  let i:i32=0;
  while(i<8){
    sub_fact_learn(Wp, aname(i), "eff", i32s(eff_of(i)));
    sub_fact_learn(Wb, aname(i), "eff", i32s(eff_of(i)));
    i=i+1;
  }
  let nproc:i32=cond_proc(Wp);
  let nblind:i32=cond_blind();
  emit("S3 N_proc=");
  emit(i32s(nproc));
  emit(" N_blind=");
  emit(i32s(nblind));
  emit("\n");
  if(nproc<nblind){
    emit("CHECK PASS P3-proc-better\n");
  } else {
    emit("CHECK FAIL P3\n");
    fails=fails+1;
  }
  let Wc:[]u8=z_alloc(32768);
  let Wf:[]u8=z_alloc(32768);
  sub_init(Wc, 1);
  sub_init(Wf, 1);
  w4_learn(Wc);
  w4_learn(Wf);
  let ex1:[]u8=z_alloc(4);
  let ex2:[]u8=z_alloc(4);
  let acc_c:i32=cond_causal(Wc, ex1);
  let acc_f:i32=cond_flat(Wf, ex2);
  let e_causal:i32=get32(ex1, 0);
  let e_flat:i32=get32(ex2, 0);
  emit("S4 E_causal=");
  emit(i32s(e_causal));
  emit(" E_flat=");
  emit(i32s(e_flat));
  emit(" acc_c=");
  emit(i32s(acc_c));
  emit(" acc_f=");
  emit(i32s(acc_f));
  emit("\n");
  if(e_causal<e_flat && acc_c==20 && acc_f==20){
    emit("CHECK PASS P4-causal-better\n");
  } else {
    emit("CHECK FAIL P4\n");
    fails=fails+1;
  }
  emit("FACTCOUNT_P ");
  emit(i32s(h_factcount(Wp)));
  emit(" FACTCOUNT_B ");
  emit(i32s(h_factcount(Wb)));
  emit(" FACTCOUNT_C ");
  emit(i32s(h_factcount(Wc)));
  emit(" FACTCOUNT_F ");
  emit(i32s(h_factcount(Wf)));
  emit("\n");
  if(fails==0){
    emit("SUBSTRATE-SYN2 ALL-PASS\n");
  } else {
    emit("SUBSTRATE-SYN2 FAILS=");
    emit(i32s(fails));
    emit("\n");
  }
  return fails;
}

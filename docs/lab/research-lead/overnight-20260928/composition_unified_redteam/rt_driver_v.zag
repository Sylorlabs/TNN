// rt_driver_v.zag -- probe trial's max learnable chain length.
fn main()i32 {
  emit("RTV-START\n");
  let L:i32=1;
  while(L<=6){
    let W:[]u8=z_alloc(110656); tnn2_init(W);
    let i:i32=0;
    while(i<L){
      ev_teach(W,3000+i,1,3001+i);
      i=i+1;
    }
    let q:i32=ev_query(W,3000,71,3000+L,0);
    emit("L="); e64(L); emit(" ans="); e64(q);
    let m:i32=2;
    let found:i32=-1;
    while(m<1024){
      if(ng(W,m,36)==1 && ng(W,m,0)==20){found=m;}
      m=m+1;
    }
    emit(" map="); e64(found); emit("\n");
    L=L+1;
  }
  emit("RTV-END\n");
  return 0;
}

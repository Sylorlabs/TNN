// rt_driver_p.zag -- probe: dump MAP relseqs + provenance after R4a-style training.
fn rt_dumpmaps(W:[]u8)void {
  let seq:[]u8=z_alloc(64);
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let rs:i32=cc_relseq(W,m,seq,8);
      emit("MAP "); e64(m); emit(" subj="); e64(ng(W,m,8));
      emit(" rel="); e64(ng(W,m,4)); emit(" relseq_n="); e64(rs);
      emit(" seq=[");
      let k2:i32=0;
      while(k2<rs && k2<8){ e64(get32(seq,k2*4)); emit(","); k2=k2+1; }
      emit("] T14=[");
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==m && eg(W,e,4)==14){ e64(eg(W,e,8)); emit(","); }
        e=e+1;
      }
      emit("] T15=[");
      e=0;
      while(e<4096){
        if(eg(W,e,0)==m && eg(W,e,4)==15){ e64(eg(W,e,8)); emit(","); }
        e=e+1;
      }
      emit("]\n");
    }
    m=m+1;
  }
  return;
}
fn main()i32 {
  emit("RTP-START k=7\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=1;
  while(i<=7){
    let a:i32=1000+10*i; let b:i32=a+1; let c:i32=a+2;
    ev_teach(W,a,i,b); ev_teach(W,b,i,c);
    let q:i32=ev_query(W,a,70+i,c,0);
    emit("S"); e64(i); emit(" ans="); e64(q); emit("\n");
    i=i+1;
  }
  rt_dumpmaps(W);
  emit("RTP-Z now\n");
  let j:i32=1;
  while(j<=7){ ev_teach(W,9000+j,j,9001+j); j=j+1; }
  let z:i32=ev_query(W,9001,70,9008,0);
  emit("Z ans="); e64(z); emit("\n");
  emit("RTP-END\n");
  return 0;
}

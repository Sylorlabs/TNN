// rt_driver_q.zag -- probe fallback internals on the R6a shape.
fn main()i32 {
  emit("RTQ-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,11,1,12);
  let a:i32=ev_query(W,11,71,12,0);
  emit("A1 ans="); e64(a); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ emit("MAP "); e64(m); emit(" root="); e64(ng(W,m,20)); emit(" cxp="); e64(cx_contract(W,m)); emit("\n"); }
    m=m+1;
  }
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,21,paths);
  emit("gather21 np="); e64(np); emit("\n");
  let i:i32=0;
  while(i<np && i<6){
    emit(" path"); e64(i); emit(" len="); e64(get32(paths,i*48)); emit(" v0="); e64(get32(paths,i*48+4)); emit(" v1="); e64(get32(paths,i*48+8)); emit("\n");
    i=i+1;
  }
  let vb:[]u8=z_alloc(32); let fb:[]u8=z_alloc(32);
  let ln:i32=un_satisfy(W,15,21,vb,fb);
  emit("un_satisfy(15,21)="); e64(ln); emit("\n");
  emit("RTQ-END\n");
  return 0;
}

// rt_driver.zag -- Adversarial battery for the unified composition mechanism.
// Each test runs in a fresh workspace. Attack map:
//   R1: C's original Z-prime reuse (dropped from the unified battery)
//   R2: B's original W reuse on fresh literals (dropped from unified battery)
//   R3: A's original Suite A necessity (plen-3 + plen-4 -> plen-6 Z)
//   R4a: 6/7/8/9 segment chains (is 8 reachable? does 9 decline cleanly?)
//   R4b: decline blowup probe (layered 3-wide graph, unreachable expected)
//   R4c: success blowup probe (layered, correct path tried last)
//   R5: segment plen coverage (7-link vs 8-link segment MAPs)
//   R6a: history poisoning, quality (control vs poisoned composition choice)
//   R6b: history poisoning, cost (control vs poisoned DFS work)
//   R7: predicate conflict (A-YES/C-NO MAP admitted; misattribution; false history)
// Helpers are rt_-prefixed to avoid collisions in any build.

// ---- instrumentation ----
fn rt_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" sat="); e64(hg(W,60)); emit(" cohit="); e64(hg(W,52)); emit("\n");
  return;
}
fn rt_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn rt_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn rt_dump15(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      emit("  T15 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn rt_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  T14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn rt_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn rt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// ---- R1: C's Z-prime reuse ----
// X: plen-4 r1 (11-14, 15-18), rel 61. Y: plen-4 r2 (21-24, 25-28), rel 62.
// Z: mixed plen-7 (31-37, r1 x3 then r2 x3), rel 63. Z': fresh 41-47, rel 63.
fn r1_test(W:[]u8)void {
  emit("=== R1-REUSE-C ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x1:i32=ev_query(W,11,61,14,0);
  emit("R1-X1 ans="); e64(x1); rt_tstat(W);
  ev_teach(W,15,1,16); ev_teach(W,16,1,17); ev_teach(W,17,1,18);
  let x2:i32=ev_query(W,15,61,18,0);
  emit("R1-X2 ans="); e64(x2); rt_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y1:i32=ev_query(W,21,62,24,0);
  emit("R1-Y1 ans="); e64(y1); rt_tstat(W);
  ev_teach(W,25,2,26); ev_teach(W,26,2,27); ev_teach(W,27,2,28);
  let y2:i32=ev_query(W,25,62,28,0);
  emit("R1-Y2 ans="); e64(y2); rt_tstat(W);
  rt_gap(W);
  ev_teach(W,31,1,32); ev_teach(W,32,1,33); ev_teach(W,33,1,34);
  ev_teach(W,34,2,35); ev_teach(W,35,2,36); ev_teach(W,36,2,37);
  let z:i32=ev_query(W,31,63,37,0);
  emit("R1-Z ans="); e64(z); rt_tstat(W);
  let zm:i32=rt_find_map(W,31,63);
  emit("R1-ZMAP="); e64(zm); emit(" link14="); e64(rt_count14(W)); emit("\n");
  ev_teach(W,41,1,42); ev_teach(W,42,1,43); ev_teach(W,43,1,44);
  ev_teach(W,44,2,45); ev_teach(W,45,2,46); ev_teach(W,46,2,47);
  let z2:i32=ev_query(W,41,63,47,0);
  emit("R1-Z2 ans="); e64(z2); rt_tstat(W);
  if(z==37 && z2==47){emit("R1-RESULT=PASS\n");} else {emit("R1-RESULT=FAIL\n");}
  return;
}

// ---- R2: B's W reuse ----
// X: plen-3 r1 (11-13, 14-16), rel 61. Y: plen-5 r2 (21-25, 26-30), rel 62.
// Episodes via ev_cq. Z: mixed plen-7 (31-37), rel 50. W: fresh 61-67, rel 50.
fn r2_test(W:[]u8)void {
  emit("=== R2-REUSE-B ===\n");
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x1:i32=ev_query(W,11,61,13,0);
  emit("R2-X1 ans="); e64(x1); rt_tstat(W);
  ev_teach(W,14,1,15); ev_teach(W,15,1,16);
  let x2:i32=ev_query(W,14,61,16,0);
  emit("R2-X2 ans="); e64(x2); rt_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24); ev_teach(W,24,2,25);
  let y1:i32=ev_query(W,21,62,25,0);
  emit("R2-Y1 ans="); e64(y1); rt_tstat(W);
  ev_teach(W,26,2,27); ev_teach(W,27,2,28); ev_teach(W,28,2,29); ev_teach(W,29,2,30);
  let y2:i32=ev_query(W,26,62,30,0);
  emit("R2-Y2 ans="); e64(y2); rt_tstat(W);
  ev_teach(W,41,1,42); ev_teach(W,42,1,43);
  ev_teach(W,43,2,44); ev_teach(W,44,2,45); ev_teach(W,45,2,46); ev_teach(W,46,2,47);
  let a1:i32=ev_cq(W,41,61,43,0,0);
  let a2:i32=ev_cq(W,43,62,47,0,1);
  emit("R2-EP1 a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(rt_count15(W)); emit("\n");
  ev_teach(W,51,1,52); ev_teach(W,52,1,53);
  ev_teach(W,53,2,54); ev_teach(W,54,2,55); ev_teach(W,55,2,56); ev_teach(W,56,2,57);
  let b1:i32=ev_cq(W,51,61,53,0,0);
  let b2:i32=ev_cq(W,53,62,57,0,1);
  emit("R2-EP2 b1="); e64(b1); emit(" b2="); e64(b2);
  emit(" couse15="); e64(rt_count15(W)); emit("\n");
  rt_gap(W);
  ev_teach(W,31,1,32); ev_teach(W,32,1,33);
  ev_teach(W,33,2,34); ev_teach(W,34,2,35); ev_teach(W,35,2,36); ev_teach(W,36,2,37);
  let z:i32=ev_query(W,31,50,37,0);
  emit("R2-Z ans="); e64(z); rt_tstat(W);
  ev_teach(W,61,1,62); ev_teach(W,62,1,63);
  ev_teach(W,63,2,64); ev_teach(W,64,2,65); ev_teach(W,65,2,66); ev_teach(W,66,2,67);
  let w:i32=ev_query(W,61,50,67,0);
  emit("R2-W ans="); e64(w); rt_tstat(W);
  if(z==37 && w==67){emit("R2-RESULT=PASS\n");} else {emit("R2-RESULT=FAIL\n");}
  return;
}

// ---- R3: A's Suite A necessity ----
// X: plen-3 r1 (101-103, 105-107), rel 71. Y: plen-4 r2 (201-204, 205-208), rel 72.
// Z-alpha: 301-306 (r1,r1,r2,r2,r2), rel 70. Beyond trial reach.
fn r3_test(W:[]u8)void {
  emit("=== R3-NECESSITY-A ===\n");
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  let x1:i32=ev_query(W,101,71,103,0);
  emit("R3-X1 ans="); e64(x1); rt_tstat(W);
  ev_teach(W,105,1,106); ev_teach(W,106,1,107);
  let x2:i32=ev_query(W,105,71,107,0);
  emit("R3-X2 ans="); e64(x2); rt_tstat(W);
  ev_teach(W,201,2,202); ev_teach(W,202,2,203); ev_teach(W,203,2,204);
  let y1:i32=ev_query(W,201,72,204,0);
  emit("R3-Y1 ans="); e64(y1); rt_tstat(W);
  ev_teach(W,205,2,206); ev_teach(W,206,2,207); ev_teach(W,207,2,208);
  let y2:i32=ev_query(W,205,72,208,0);
  emit("R3-Y2 ans="); e64(y2); rt_tstat(W);
  rt_gap(W);
  ev_teach(W,301,1,302); ev_teach(W,302,1,303);
  ev_teach(W,303,2,304); ev_teach(W,304,2,305); ev_teach(W,305,2,306);
  let z:i32=ev_query(W,301,70,306,0);
  emit("R3-ZA ans="); e64(z); rt_tstat(W);
  if(z==306){emit("R3-RESULT=PASS\n");} else {emit("R3-RESULT=FAIL\n");}
  return;
}

// ---- R4a: k-segment chains, k = 6/7/8/9 ----
// Segment i: 1-link chain on rel i. Z: k-link chain, link j on rel j.
// Expect: 6/7/8 PASS, 9 declines (-2, no hang).
fn r4a_test(W:[]u8,k:i32)void {
  emit("=== R4A-DEPTH k="); e64(k); emit(" ===\n");
  let i:i32=1;
  while(i<=k){
    let a:i32=1000+10*i; let b:i32=a+1;
    ev_teach(W,a,i,b);
    let q:i32=ev_query(W,a,70+i,b,0);
    emit("R4A-S"); e64(i); emit(" ans="); e64(q); emit("\n");
    i=i+1;
  }
  rt_gap(W);
  let j:i32=1;
  while(j<=k){
    ev_teach(W,9000+j,j,9001+j);
    j=j+1;
  }
  let z:i32=ev_query(W,9001,70,9001+k,0);
  emit("R4A-Z ans="); e64(z); rt_tstat(W);
  if(k<9){
    if(z==9001+k){emit("R4A-RESULT=PASS\n");} else {emit("R4A-RESULT=FAIL\n");}
  } else {
    if(z==-2){emit("R4A-RESULT=PASS-DECLINE\n");} else {emit("R4A-RESULT=FAIL\n");}
  }
  return;
}

// Layered graph helpers for R4b/R4c.
fn rt_lnode(g:i32,a:i32)i32 { return 9000+g*100+a; }
fn rt_lrel(g:i32,a:i32,b:i32)i32 { return 300+g*9+(a-1)*3+(b-1); }
// Train one single-link MAP on rel r with private values; query rel qr.
fn rt_train1(W:[]u8,idx:i32,r:i32)void {
  let v0:i32=60000+idx*10; let v1:i32=v0+1;
  ev_teach(W,v0,r,v1);
  let q:i32=ev_query(W,v0,800+idx,v1,0);
  if(q!=v1){emit("RT-TRAIN1-FAIL idx="); e64(idx); emit("\n");}
  return;
}

// ---- R4b: decline blowup probe ----
// Layers L0..L7, 3 nodes each, full bipartite facts between consecutive
// layers, unique rel per fact. Expected value unreachable. Measures the
// worst-case cost of a full depth-8 DFS decline.
fn r4b_test(W:[]u8)void {
  emit("=== R4B-DECLINE-BLOWUP ===\n");
  let idx:i32=0;
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        let r:i32=rt_lrel(g,a,b);
        ev_teach(W,rt_lnode(g,a),r,rt_lnode(g+1,b));
        rt_train1(W,idx,r);
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("R4B facts+maps="); e64(idx); emit("\n");
  let z:i32=ev_query(W,9001,70,99999,0);
  emit("R4B-Z ans="); e64(z); rt_tstat(W);
  if(z==-2){emit("R4B-RESULT=PASS-DECLINE\n");} else {emit("R4B-RESULT=FAIL\n");}
  return;
}

// ---- R4c: success blowup probe ----
// Same layered graph plus L8 = {9008} reachable only from 9701 (the first
// L7 node). Correct-path MAPs trained LAST (highest ids) so DFS explores
// every wrong branch before the successful depth-8 path.
fn r4c_test(W:[]u8)void {
  emit("=== R4C-SUCCESS-BLOWUP ===\n");
  let idx:i32=0;
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        let r:i32=rt_lrel(g,a,b);
        ev_teach(W,rt_lnode(g,a),r,rt_lnode(g+1,b));
        // correct path = always a=1,b=1; train those MAPs last
        if(a!=1 || b!=1){ rt_train1(W,idx,r); }
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  // now train the 7 correct-path MAPs (highest ids among the layered set)
  g=0;
  while(g<7){
    let r:i32=rt_lrel(g,1,1);
    rt_train1(W,idx,r);
    idx=idx+1;
    g=g+1;
  }
  // final hop 9701 -> 9008 on rel 400
  ev_teach(W,9701,400,9008);
  rt_train1(W,idx,400);
  emit("R4C facts+maps trained\n");
  let z:i32=ev_query(W,9001,70,9008,0);
  emit("R4C-Z ans="); e64(z); rt_tstat(W);
  if(z==9008){emit("R4C-RESULT=PASS\n");} else {emit("R4C-RESULT=FAIL\n");}
  return;
}

// ---- R5: true coverage ceiling ----
// Trial learns at most 4-link chains (verified: L=5,6 fail). C's relseq cap
// (7) and A's p<=8 therefore never bind; the production ceiling is 4 links.
// R5a: 4-link M4 ([1,1,1,1]) + 1-link Y ([2]) -> Z must compose [M4,Y]. PASS.
// R5b: 5-link chain is unlearnable (no MAP); Z needing it must decline.
fn r5_test(W:[]u8)void {
  emit("=== R5-CEILING-4LINK ===\n");
  let i:i32=0;
  while(i<4){
    ev_teach(W,2001+i,1,2002+i);
    i=i+1;
  }
  let m4q:i32=ev_query(W,2001,71,2005,0);
  emit("R5-M4 ans="); e64(m4q); rt_tstat(W);
  let m4:i32=rt_find_map(W,2001,71);
  emit("R5-M4 id="); e64(m4); emit("\n");
  ev_teach(W,2011,2,2012);
  let yq:i32=ev_query(W,2011,72,2012,0);
  emit("R5-Y ans="); e64(yq); emit("\n");
  let k:i32=0;
  while(k<4){
    ev_teach(W,2001+k,1,2002+k);
    k=k+1;
  }
  ev_teach(W,2005,2,2006);
  let z:i32=ev_query(W,2001,70,2006,0);
  emit("R5-Z ans="); e64(z); rt_tstat(W);
  if(z==2006){emit("R5A-RESULT=PASS\n");} else {emit("R5A-RESULT=FAIL\n");}
  return;
}
fn r5b_test(W:[]u8)void {
  emit("=== R5B-CEILING-5LINK ===\n");
  let i:i32=0;
  while(i<5){
    ev_teach(W,2101+i,1,2102+i);
    i=i+1;
  }
  let m5q:i32=ev_query(W,2101,71,2106,0);
  emit("R5B-M5 ans="); e64(m5q); rt_tstat(W);
  let m5:i32=rt_find_map(W,2101,71);
  emit("R5B-M5 id="); e64(m5); emit(" (expect -1: unlearnable)\n");
  ev_teach(W,2111,2,2112);
  let yq:i32=ev_query(W,2111,72,2112,0);
  emit("R5B-Y ans="); e64(yq); emit("\n");
  let k2:i32=0;
  while(k2<5){
    ev_teach(W,2101+k2,1,2102+k2);
    k2=k2+1;
  }
  ev_teach(W,2106,2,2107);
  let z:i32=ev_query(W,2101,70,2107,0);
  emit("R5B-Z ans="); e64(z); rt_tstat(W);
  if(m5==-1 && z==-2){emit("R5B-RESULT=PASS-CEILING\n");} else {emit("R5B-RESULT=FAIL\n");}
  return;
}

// ---- R6a: history poisoning, quality ----
// A1: [1] (11->12). B1: [2] (21->22). B2: [2] (31->32). All plen 2.
// Z: 101->102 (r1), 102->103 (r2). Honest: [A1,B1] (B1 lower id).
// Poisoned history (B2->A1 edge): B2 (co=1) outranks B1 (co=0) at 102,
// steering selection to [A1,B2]. Same answer, different decomposition:
// history steers, verifiably.
fn r6a_world(W:[]u8)void {
  ev_teach(W,11,1,12);
  let a:i32=ev_query(W,11,71,12,0);
  emit("R6A-A1 ans="); e64(a); emit("\n");
  ev_teach(W,21,2,22);
  let b:i32=ev_query(W,21,72,22,0);
  emit("R6A-B1 ans="); e64(b); emit("\n");
  ev_teach(W,31,2,32);
  let c:i32=ev_query(W,31,73,32,0);
  emit("R6A-B2 ans="); e64(c); emit("\n");
  let ma:i32=rt_find_map(W,11,71);
  let mb1:i32=rt_find_map(W,21,72);
  let mb2:i32=rt_find_map(W,31,73);
  emit("R6A-IDS A1="); e64(ma); emit(" B1="); e64(mb1);
  emit(" B2="); e64(mb2); emit("\n");
  rt_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,2,103);
  return;
}
fn r6a_control(W:[]u8)void {
  emit("=== R6A-CONTROL ===\n");
  r6a_world(W);
  let z:i32=ev_query(W,101,70,103,0);
  emit("R6A-C-Z ans="); e64(z); rt_tstat(W);
  rt_dump14(W);
  rt_dump15(W);
  return;
}
fn r6a_poison(W:[]u8)void {
  emit("=== R6A-POISONED ===\n");
  r6a_world(W);
  let ma:i32=rt_find_map(W,11,71);
  let mb2:i32=rt_find_map(W,31,73);
  link_edge(W,mb2,15,ma,0);
  emit("R6A-POISON-EDGES="); e64(rt_count15(W)); emit("\n");
  rt_dump15(W);
  let z:i32=ev_query(W,101,70,103,0);
  emit("R6A-P-Z ans="); e64(z); rt_tstat(W);
  emit("R6A-POST-EDGES="); e64(rt_count15(W)); emit("\n");
  rt_dump14(W);
  rt_dump15(W);
  // persistence: fresh Z2, same shape; poison must still steer
  ev_teach(W,201,1,202); ev_teach(W,202,2,203);
  let z2:i32=ev_query(W,201,70,203,0);
  emit("R6A-P-Z2 ans="); e64(z2); rt_tstat(W);
  return;
}

// ---- R6b: history poisoning, cost ----
// A1: [1] (11->12). B1: [2] (21->22). D1..D5: [11]..[15] decoys, each with a
// dead-end fact from 102. Control: B1 tried first. Poisoned (Dd->A1 edges):
// 5 dead subtrees explored before B1.
fn r6b_world(W:[]u8)void {
  ev_teach(W,11,1,12);
  ev_query(W,11,71,12,0);
  ev_teach(W,21,2,22);
  ev_query(W,21,72,22,0);
  let d:i32=1;
  while(d<=5){
    ev_teach(W,300+10*d,10+d,301+10*d);
    ev_query(W,300+10*d,80+d,301+10*d,0);
    d=d+1;
  }
  rt_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,2,103);
  let e:i32=1;
  while(e<=5){
    ev_teach(W,102,10+e,400+e);
    e=e+1;
  }
  return;
}
fn r6b_control(W:[]u8)void {
  emit("=== R6B-CONTROL ===\n");
  r6b_world(W);
  let z:i32=ev_query(W,101,70,103,0);
  emit("R6B-C-Z ans="); e64(z); rt_tstat(W);
  return;
}
fn r6b_poison(W:[]u8)void {
  emit("=== R6B-POISONED ===\n");
  r6b_world(W);
  let ma:i32=rt_find_map(W,11,71);
  let d:i32=1;
  while(d<=5){
    let md:i32=rt_find_map(W,300+10*d,80+d);
    link_edge(W,md,15,ma,0);
    d=d+1;
  }
  emit("R6B-POISON-EDGES="); e64(rt_count15(W)); emit("\n");
  let z:i32=ev_query(W,101,70,103,0);
  emit("R6B-P-Z ans="); e64(z); rt_tstat(W);
  return;
}

// ---- R7: predicate conflict ----
// M: [1,1] plen-3 (11->13). N: [7,7] plen-3 (21->23). P: [8,8] plen-3 (31->33).
// Z: 101->102->103 (r7), 103->104->105 (r8). Honest (C-only): [N,P].
// Unified OR: M admitted via A fallback (plen 3 matches a real r7 path;
// C says NO, no r1 fact from 101). Expect [M,N]: both segments misattributed,
// false N->M co-use history written.
fn r7_world(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let mq:i32=ev_query(W,11,71,13,0);
  emit("R7-M ans="); e64(mq); emit("\n");
  ev_teach(W,21,7,22); ev_teach(W,22,7,23);
  let nq:i32=ev_query(W,21,72,23,0);
  emit("R7-N ans="); e64(nq); emit("\n");
  ev_teach(W,31,8,32); ev_teach(W,32,8,33);
  let pq:i32=ev_query(W,31,73,33,0);
  emit("R7-P ans="); e64(pq); emit("\n");
  let mm:i32=rt_find_map(W,11,71);
  let nn:i32=rt_find_map(W,21,72);
  let pp:i32=rt_find_map(W,31,73);
  emit("R7-IDS M="); e64(mm); emit(" N="); e64(nn); emit(" P="); e64(pp); emit("\n");
  rt_gap(W);
  ev_teach(W,101,7,102); ev_teach(W,102,7,103);
  ev_teach(W,103,8,104); ev_teach(W,104,8,105);
  return;
}
fn r7_test(W:[]u8)void {
  emit("=== R7-CONFLICT ===\n");
  r7_world(W);
  emit("R7-T15-BEFORE="); e64(rt_count15(W)); emit("\n");
  let z:i32=ev_query(W,101,70,105,0);
  emit("R7-Z ans="); e64(z); rt_tstat(W);
  emit("R7-T15-AFTER="); e64(rt_count15(W)); emit("\n");
  rt_dump14(W);
  rt_dump15(W);
  return;
}

fn main()i32 {
  emit("RT-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); r1_test(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); r2_test(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); r3_test(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); r4a_test(W4,6);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); r4a_test(W5,7);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); r4a_test(W6,8);
  let W10:[]u8=z_alloc(110656); tnn2_init(W10); r5_test(W10);
  let W11:[]u8=z_alloc(110656); tnn2_init(W11); r5b_test(W11);
  let W12:[]u8=z_alloc(110656); tnn2_init(W12); r6a_control(W12);
  let W13:[]u8=z_alloc(110656); tnn2_init(W13); r6a_poison(W13);
  let W14:[]u8=z_alloc(110656); tnn2_init(W14); r6b_control(W14);
  let W15:[]u8=z_alloc(110656); tnn2_init(W15); r6b_poison(W15);
  let W16:[]u8=z_alloc(110656); tnn2_init(W16); r7_test(W16);
  emit("RT-END\n");
  return 0;
}

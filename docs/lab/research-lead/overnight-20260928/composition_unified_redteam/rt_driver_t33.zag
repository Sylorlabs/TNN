// rt_driver_t.zag -- decline wall-time vs depth, 2-wide layered world.
// Build against rt_patch (unified) or cc_patch (C-original). DEPTH patched
// per build via sed.
fn DEPTH()i32 { return 3; }
fn rt_t_train(W:[]u8)void {
  let D:i32=DEPTH();
  let idx:i32=0;
  let g:i32=0;
  while(g<D){
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        let r:i32=300+g*9+(a-1)*3+(b-1);
        let n0:i32=9000+g*100+a; let n1:i32=9000+(g+1)*100+b;
        ev_teach(W,n0,r,n1);
        let v0:i32=60000+idx*10; let v1:i32=v0+1;
        ev_teach(W,v0,r,v1);
        ev_query(W,v0,800+idx,v1,0);
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  return;
}
fn main()i32 {
  emit("RTT-START depth="); e64(DEPTH()); emit("\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_t_train(W);
  emit("RTT-TRAINED\n");
  let z:i32=ev_query(W,9001,70,99999,0);
  emit("RTT-Z ans="); e64(z); emit("\n");
  emit("RTT-END\n");
  return 0;
}

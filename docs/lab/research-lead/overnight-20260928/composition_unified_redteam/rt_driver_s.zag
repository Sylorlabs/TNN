// rt_driver_s.zag -- blowup scaling probe.
// 2-wide layered worlds, depth D. Measures: (a) candidates admitted at one
// node via cc vs fallback; (b) wall time of an unreachable-goal decline.
fn rt_s_train(W:[]u8,D:i32)void {
  let idx:i32=0;
  let g:i32=0;
  while(g<D){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        let r:i32=300+g*4+(a-1)*2+(b-1);
        let n0:i32=9000+g*100+a; let n1:i32=9000+(g+1)*100+b;
        ev_teach(W,n0,r,n1);
        let v0:i32=60000+idx*10; let v1:i32=v0+1;
        ev_teach(W,v0,r,v1);
        ev_query(W,v0,800+idx,v1,0);
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  return;
}
fn rt_s_cands(W:[]u8)void {
  // at node 9001 (layer 0): count MAPs admitted via cc vs fallback
  let vb:[]u8=z_alloc(32); let fb:[]u8=z_alloc(28);
  let ncc:i32=0; let nfb:i32=0; let ntot:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let ln:i32=cc_satisfy(W,m,9001,vb,fb);
      if(ln>=1){ncc=ncc+1; ntot=ntot+1;}
      else {
        let ln2:i32=un_satisfy(W,m,9001,vb,fb);
        if(ln2>=1){nfb=nfb+1; ntot=ntot+1;}
      }
    }
    m=m+1;
  }
  emit("CANDS total="); e64(ntot); emit(" via_cc="); e64(ncc);
  emit(" via_fallback="); e64(nfb); emit("\n");
  return;
}
fn main()i32 {
  emit("RTS-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_s_train(W,3);
  rt_s_cands(W);
  emit("RTS-END\n");
  return 0;
}

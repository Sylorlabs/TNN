// l3c_form.zag -- L3C-FORM: emergent dispatch from generic construction ops.
// Prereg: PREREG_L3C_FORM.md (frozen; committed alone as dc9a91501).
// Pure Zag. No Python.
// znc:allow A0102
//
// Starting vocabulary: rule table mapping sig -> node; TERM nodes holding
// constants. No dispatch form exists at start. The five op_* routines are
// the only mutators of graph/rule state. On a clash event (same sig,
// different required output: the H-REVISE impossibility made operational),
// the fixed generic discriminator disc() discovers a separating predicate
// from data, and construct() runs a fixed protocol of generic ops. The
// dispatch form emerges from data; it is not supplied in source.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- fixed layout ----
fn RULE_SZ()i32{return 16;}
fn RULE_MAX()i32{return 16;}
fn NODE_SZ()i32{return 8;}
fn NODE_MAX()i32{return 32;}
fn EDGE_SZ()i32{return 20;}
fn EDGE_MAX()i32{return 64;}
fn NF()i32{return 4;}
fn rule_addr(s:i32)i32{return 0+s*RULE_SZ();}
fn node_addr(id:i32)i32{return 256+id*NODE_SZ();}
fn edge_addr(e:i32)i32{return 512+e*EDGE_SZ();}
fn cnt_addr(i:i32)i32{return 4096+i*4;}
fn rep_addr(s:i32)i32{return 3072+s*8;}
// which: 0 = training vectors, 1 = clash vectors; v: vector index 0..1
fn fvec_addr(s:i32,which:i32,v:i32)i32{return 2048+s*64+which*32+v*16;}

// ---- generic construction ops: the ONLY mutators of graph/rule state ----
fn op_new_node(W:[]u8)i32{
  let id:i32=get32(W,cnt_addr(0));
  set32(W,cnt_addr(0),id+1);
  set32(W,node_addr(id),0);
  set32(W,node_addr(id)+4,0);
  return id;
}
fn op_mark_term(W:[]u8,id:i32,v:i32)void{
  set32(W,node_addr(id),1);
  set32(W,node_addr(id)+4,v);
  return;
}
fn op_mark_disp(W:[]u8,id:i32)void{
  set32(W,node_addr(id),2);
  set32(W,node_addr(id)+4,0);
  return;
}
fn op_new_edge(W:[]u8,from:i32,to:i32)i32{
  let e:i32=get32(W,cnt_addr(1));
  set32(W,cnt_addr(1),e+1);
  set32(W,edge_addr(e),from);
  set32(W,edge_addr(e)+4,to);
  set32(W,edge_addr(e)+8,0);
  set32(W,edge_addr(e)+12,0);
  set32(W,edge_addr(e)+16,0);
  return e;
}
fn op_label_edge(W:[]u8,eid:i32,feat:i32,val:i32)void{
  set32(W,edge_addr(eid)+8,1);
  set32(W,edge_addr(eid)+12,feat);
  set32(W,edge_addr(eid)+16,val);
  return;
}

// ---- rule table: seeding path (writes TERM mappings only) ----
fn rule_find(W:[]u8,sig:i32)i32{
  let s:i32=0;
  while(s<RULE_MAX()){ if(get32(W,rule_addr(s))==sig){return s;} s=s+1; }
  return -1;
}
fn rule_link(W:[]u8,sig:i32,node:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s>=0){ set32(W,rule_addr(s)+4,node); return s; }
  s=0;
  while(s<RULE_MAX()){
    if(get32(W,rule_addr(s))==-1){
      set32(W,rule_addr(s),sig);
      set32(W,rule_addr(s)+4,node);
      set32(W,rule_addr(s)+8,0);
      set32(W,rule_addr(s)+12,0);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn rule_node(W:[]u8,sig:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){return -1;}
  return get32(W,rule_addr(s)+4);
}

// ---- generic interpreter: one uniform edge-following path ----
fn featv(f0:i32,f1:i32,f2:i32,f3:i32,i:i32)i32{
  if(i==0){return f0;}
  if(i==1){return f1;}
  if(i==2){return f2;}
  return f3;
}
fn interp(W:[]u8,node:i32,f0:i32,f1:i32,f2:i32,f3:i32)i32{
  let kind:i32=get32(W,node_addr(node));
  if(kind==1){return get32(W,node_addr(node)+4);}
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  let defto:i32=-1;
  while(e<ne){
    if(get32(W,edge_addr(e))==node){
      let lk:i32=get32(W,edge_addr(e)+8);
      if(lk==0){
        if(defto<0){defto=get32(W,edge_addr(e)+4);}
      } else {
        let lf:i32=get32(W,edge_addr(e)+12);
        let lv:i32=get32(W,edge_addr(e)+16);
        if(featv(f0,f1,f2,f3,lf)==lv){
          return get32(W,node_addr(get32(W,edge_addr(e)+4))+4);
        }
      }
    }
    e=e+1;
  }
  if(defto>=0){return get32(W,node_addr(defto)+4);}
  return -9999;
}

// ---- fixed generic discriminator: first single-feature separator ----
fn colv(W:[]u8,s:i32,which:i32,v:i32,i:i32)i32{
  return get32(W,fvec_addr(s,which,v)+i*4);
}
fn disc(W:[]u8,s:i32)i32{
  let tc:i32=get32(W,rule_addr(s)+8);
  let cc:i32=get32(W,rule_addr(s)+12);
  let i:i32=0;
  while(i<NF()){
    let c:i32=0;
    while(c<cc){
      let v:i32=colv(W,s,1,c,i);
      let seen:i32=0;
      let c2:i32=0;
      while(c2<c){ if(colv(W,s,1,c2,i)==v){seen=1;} c2=c2+1; }
      if(seen==0){
        let ok:i32=1;
        let t:i32=0;
        while(t<tc){ if(colv(W,s,0,t,i)==v){ok=0;} t=t+1; }
        let b:i32=0;
        while(b<cc){ if(colv(W,s,1,b,i)!=v){ok=0;} b=b+1; }
        if(ok==1){return i*64+v;}
      }
      c=c+1;
    }
    i=i+1;
  }
  return -1;
}

// ---- observation memory (fixed slots; not graph state) ----
fn stash(W:[]u8,s:i32,which:i32,f0:i32,f1:i32,f2:i32,f3:i32)void{
  let c:i32=get32(W,rule_addr(s)+8+which*4);
  if(c>=2){return;}
  let a:i32=fvec_addr(s,which,c);
  set32(W,a,f0); set32(W,a+4,f1); set32(W,a+8,f2); set32(W,a+12,f3);
  set32(W,rule_addr(s)+8+which*4,c+1);
  return;
}

// ---- construction protocol: fixed generic op sequence, data-parameterized ----
fn construct(W:[]u8,s:i32,old:i32,new:i32)i32{
  let sep:i32=disc(W,s);
  if(sep<0){
    set32(W,cnt_addr(4),get32(W,cnt_addr(4))+1);
    return -1;
  }
  let fi:i32=sep/64;
  let fv:i32=sep-fi*64;
  let t_old:i32=op_new_node(W);
  op_mark_term(W,t_old,old);
  let t_new:i32=op_new_node(W);
  op_mark_term(W,t_new,new);
  let d:i32=op_new_node(W);
  op_mark_disp(W,d);
  let e0:i32=op_new_edge(W,d,t_old);
  let e1:i32=op_new_edge(W,d,t_new);
  op_label_edge(W,e1,fi,fv);
  set32(W,rule_addr(s)+4,d);
  set32(W,cnt_addr(3),get32(W,cnt_addr(3))+1);
  set32(W,rep_addr(s),fi);
  set32(W,rep_addr(s)+4,fv);
  if(e0<0){return -1;}
  return d;
}

// ---- contradiction monitor ----
fn observe(W:[]u8,sig:i32,out:i32,f0:i32,f1:i32,f2:i32,f3:i32,mode:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){
    let t:i32=op_new_node(W);
    op_mark_term(W,t,out);
    s=rule_link(W,sig,t);
    stash(W,s,0,f0,f1,f2,f3);
    return 0;
  }
  let node:i32=get32(W,rule_addr(s)+4);
  let kind:i32=get32(W,node_addr(node));
  if(kind==1){
    let v:i32=get32(W,node_addr(node)+4);
    if(v==out){
      stash(W,s,0,f0,f1,f2,f3);
      return 0;
    }
    stash(W,s,1,f0,f1,f2,f3);
    set32(W,cnt_addr(2),get32(W,cnt_addr(2))+1);
    if(mode==1){ construct(W,s,v,out); }
    return 1;
  }
  let p:i32=interp(W,node,f0,f1,f2,f3);
  if(p!=out){
    set32(W,cnt_addr(2),get32(W,cnt_addr(2))+1);
    return 2;
  }
  return 0;
}

// ---- frozen-bar checker: dispatch subgraph shape per sig ----
fn check_disp(W:[]u8,sig:i32,exp_old:i32,exp_new:i32,exp_fi:i32,exp_fv:i32)i32{
  let s:i32=rule_find(W,sig);
  if(s<0){return 0;}
  let d:i32=get32(W,rule_addr(s)+4);
  if(get32(W,node_addr(d))!=2){return 0;}
  let ne:i32=get32(W,cnt_addr(1));
  let e:i32=0;
  let nedge:i32=0;
  let okd:i32=0;
  let okl:i32=0;
  while(e<ne){
    if(get32(W,edge_addr(e))==d){
      nedge=nedge+1;
      let to:i32=get32(W,edge_addr(e)+4);
      let lk:i32=get32(W,edge_addr(e)+8);
      let tk:i32=get32(W,node_addr(to));
      let tv:i32=get32(W,node_addr(to)+4);
      if(lk==0 && tk==1 && tv==exp_old){okd=1;}
      if(lk==1 && tk==1 && tv==exp_new && get32(W,edge_addr(e)+12)==exp_fi && get32(W,edge_addr(e)+16)==exp_fv){okl=1;}
    }
    e=e+1;
  }
  if(nedge==2 && okd==1 && okl==1){return 1;}
  return 0;
}

fn dump_graph(W:[]u8)void{
  let nn:i32=get32(W,cnt_addr(0));
  let ne:i32=get32(W,cnt_addr(1));
  emit("DUMP_BEGIN\n");
  let rs:i32=0;
  while(rs<RULE_MAX()){
    let sg:i32=get32(W,rule_addr(rs));
    if(sg!=-1){
      emit("SLOT "); emit(i32s(rs));
      emit(" sig="); emit(i32s(sg));
      emit(" node="); emit(i32s(get32(W,rule_addr(rs)+4)));
      emit("\n");
    }
    rs=rs+1;
  }
  let i:i32=0;
  while(i<nn){
    emit("N "); emit(i32s(i));
    emit(" kind="); emit(i32s(get32(W,node_addr(i))));
    emit(" val="); emit(i32s(get32(W,node_addr(i)+4)));
    emit("\n");
    i=i+1;
  }
  let e:i32=0;
  while(e<ne){
    emit("E "); emit(i32s(e));
    emit(" from="); emit(i32s(get32(W,edge_addr(e))));
    emit(" to="); emit(i32s(get32(W,edge_addr(e)+4)));
    emit(" lk="); emit(i32s(get32(W,edge_addr(e)+8)));
    emit(" lf="); emit(i32s(get32(W,edge_addr(e)+12)));
    emit(" lv="); emit(i32s(get32(W,edge_addr(e)+16)));
    emit("\n");
    e=e+1;
  }
  emit("DUMP_END\n");
  return;
}

// ---- ATTACK MAIN: fresh contradiction families vs the UNMODIFIED protocol ----
// Everything above this line is verbatim from the committed l3c_form.zag
// (lines 1-311). Only main() is new. No protocol function was changed.
fn main()i32{
  let W:[]u8=z_alloc(65536);
  let s:i32=0;
  while(s<RULE_MAX()){ set32(W,rule_addr(s),-1); s=s+1; }
  emit("L3C-ATTACK mode=1 protocol=UNMODIFIED\n");

  // ===== Family A (sig 501): conjunction (f1==0 AND f2==0) needed =====
  observe(W,501,2,3,0,1,7,1);
  observe(W,501,2,3,1,0,7,1);
  observe(W,501,0,3,0,0,7,1);
  observe(W,501,0,3,0,0,7,1);
  emit("FAM_A events="); emit(i32s(get32(W,cnt_addr(2))));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4)))); emit("\n");
  let a_ok:i32=0; let a_tot:i32=0;
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,1,7)==2){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,1,0,7)==2){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,0,7)==0){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,0,7)==0){a_ok=a_ok+1;}
  emit("FAM_A eval="); emit(i32s(a_ok)); emit("/"); emit(i32s(a_tot)); emit("\n");

  // ===== Family B (sig 502): threshold f1>=9 needed =====
  let b_e0:i32=get32(W,cnt_addr(2)); let b_b0:i32=get32(W,cnt_addr(3)); let b_u0:i32=get32(W,cnt_addr(4));
  observe(W,502,2,3,5,0,7,1);
  observe(W,502,2,3,6,0,7,1);
  observe(W,502,0,3,9,0,7,1);
  observe(W,502,0,3,10,0,7,1);
  emit("FAM_B events="); emit(i32s(get32(W,cnt_addr(2))-b_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-b_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-b_u0)); emit("\n");
  let b_ok:i32=0; let b_tot:i32=0;
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,5,0,7)==2){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,6,0,7)==2){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,9,0,7)==0){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,10,0,7)==0){b_ok=b_ok+1;}
  emit("FAM_B eval="); emit(i32s(b_ok)); emit("/"); emit(i32s(b_tot)); emit("\n");

  // ===== Family C (sig 503): nested dispatch =====
  let c_e0:i32=get32(W,cnt_addr(2)); let c_b0:i32=get32(W,cnt_addr(3)); let c_u0:i32=get32(W,cnt_addr(4));
  observe(W,503,2,3,0,0,7,1);
  observe(W,503,2,3,0,0,7,1);
  observe(W,503,0,3,1,0,7,1);
  observe(W,503,0,3,1,0,7,1);
  let rc1:i32=observe(W,503,7,3,1,0,9,1);
  let rc2:i32=observe(W,503,7,3,1,0,9,1);
  emit("FAM_C events="); emit(i32s(get32(W,cnt_addr(2))-c_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-c_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-c_u0));
  emit(" rc_nested="); emit(i32s(rc1)); emit(","); emit(i32s(rc2)); emit("\n");
  emit("FAM_C rep fi="); emit(i32s(get32(W,rep_addr(2)))); emit(" fv="); emit(i32s(get32(W,rep_addr(2)+4))); emit("\n");
  let c_ok:i32=0; let c_tot:i32=0;
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,0,0,7)==2){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,0,0,7)==2){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,7)==0){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,7)==0){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,9)==7){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,9)==7){c_ok=c_ok+1;}
  emit("FAM_C eval="); emit(i32s(c_ok)); emit("/"); emit(i32s(c_tot)); emit("\n");

  // ===== Family D (sig 504): underdetermined separator, first-hit luck =====
  let d_e0:i32=get32(W,cnt_addr(2)); let d_b0:i32=get32(W,cnt_addr(3)); let d_u0:i32=get32(W,cnt_addr(4));
  observe(W,504,2,3,0,5,7,1);
  observe(W,504,2,3,0,6,7,1);
  observe(W,504,0,3,1,9,7,1);
  observe(W,504,0,3,1,9,7,1);
  emit("FAM_D events="); emit(i32s(get32(W,cnt_addr(2))-d_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-d_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-d_u0));
  emit(" rep fi="); emit(i32s(get32(W,rep_addr(3)))); emit(" fv="); emit(i32s(get32(W,rep_addr(3)+4))); emit("\n");
  let d_ok:i32=0; let d_tot:i32=0;
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,1,5,7)==2){d_ok=d_ok+1;} else {emit("FAM_D HELDOUT_MIS f=(3,1,5,7) true=2\n");}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,0,9,7)==0){d_ok=d_ok+1;} else {emit("FAM_D HELDOUT_MIS f=(3,0,9,7) true=0\n");}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,1,9,7)==0){d_ok=d_ok+1;}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,0,5,7)==2){d_ok=d_ok+1;}
  emit("FAM_D heldout_eval="); emit(i32s(d_ok)); emit("/"); emit(i32s(d_tot)); emit("\n");

  // ===== Family E (sig 505): stash-window forgetting =====
  let e_e0:i32=get32(W,cnt_addr(2)); let e_b0:i32=get32(W,cnt_addr(3)); let e_u0:i32=get32(W,cnt_addr(4));
  observe(W,505,2,3,0,0,7,1);
  observe(W,505,2,3,0,1,7,1);
  observe(W,505,2,3,1,0,7,1);
  observe(W,505,0,3,1,1,7,1);
  observe(W,505,0,3,1,1,7,1);
  emit("FAM_E events="); emit(i32s(get32(W,cnt_addr(2))-e_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-e_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-e_u0));
  emit(" rep fi="); emit(i32s(get32(W,rep_addr(4)))); emit(" fv="); emit(i32s(get32(W,rep_addr(4)+4))); emit("\n");
  let e_ok:i32=0; let e_tot:i32=0;
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,0,0,7)==2){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,0,1,7)==2){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,0,7)==2){e_ok=e_ok+1;} else {emit("FAM_E FORGOTTEN_MIS f=(3,1,0,7) true=2\n");}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,1,7)==0){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,1,7)==0){e_ok=e_ok+1;}
  emit("FAM_E observed_eval="); emit(i32s(e_ok)); emit("/"); emit(i32s(e_tot)); emit("\n");

  emit("TOTAL events="); emit(i32s(get32(W,cnt_addr(2))));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4)))); emit("\n");
  emit("ATTACK_END\n");
  return 0;
}

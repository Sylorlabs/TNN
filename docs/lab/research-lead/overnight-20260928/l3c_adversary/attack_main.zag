// ---- ATTACK MAIN: fresh contradiction families vs the UNMODIFIED protocol ----
// Everything above this line is verbatim from the committed l3c_form.zag
// (lines 1-311). Only main() is new. No protocol function was changed.
fn main()i32{
  let W:[]u8=z_alloc(65536);
  let s:i32=0;
  while(s<RULE_MAX()){ set32(W,rule_addr(s),-1); s=s+1; }
  emit("L3C-ATTACK mode=1 protocol=UNMODIFIED\n");

  // ===== Family A (sig 501): conjunction (f1==0 AND f2==0) needed =====
  observe(W,501,2,3,0,1,7,1);
  observe(W,501,2,3,1,0,7,1);
  observe(W,501,0,3,0,0,7,1);
  observe(W,501,0,3,0,0,7,1);
  emit("FAM_A events="); emit(i32s(get32(W,cnt_addr(2))));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4)))); emit("\n");
  let a_ok:i32=0; let a_tot:i32=0;
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,1,7)==2){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,1,0,7)==2){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,0,7)==0){a_ok=a_ok+1;}
  a_tot=a_tot+1; if(interp(W,rule_node(W,501),3,0,0,7)==0){a_ok=a_ok+1;}
  emit("FAM_A eval="); emit(i32s(a_ok)); emit("/"); emit(i32s(a_tot)); emit("\n");

  // ===== Family B (sig 502): threshold f1>=9 needed =====
  let b_e0:i32=get32(W,cnt_addr(2)); let b_b0:i32=get32(W,cnt_addr(3)); let b_u0:i32=get32(W,cnt_addr(4));
  observe(W,502,2,3,5,0,7,1);
  observe(W,502,2,3,6,0,7,1);
  observe(W,502,0,3,9,0,7,1);
  observe(W,502,0,3,10,0,7,1);
  emit("FAM_B events="); emit(i32s(get32(W,cnt_addr(2))-b_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-b_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-b_u0)); emit("\n");
  let b_ok:i32=0; let b_tot:i32=0;
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,5,0,7)==2){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,6,0,7)==2){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,9,0,7)==0){b_ok=b_ok+1;}
  b_tot=b_tot+1; if(interp(W,rule_node(W,502),3,10,0,7)==0){b_ok=b_ok+1;}
  emit("FAM_B eval="); emit(i32s(b_ok)); emit("/"); emit(i32s(b_tot)); emit("\n");

  // ===== Family C (sig 503): nested dispatch =====
  let c_e0:i32=get32(W,cnt_addr(2)); let c_b0:i32=get32(W,cnt_addr(3)); let c_u0:i32=get32(W,cnt_addr(4));
  observe(W,503,2,3,0,0,7,1);
  observe(W,503,2,3,0,0,7,1);
  observe(W,503,0,3,1,0,7,1);
  observe(W,503,0,3,1,0,7,1);
  let rc1:i32=observe(W,503,7,3,1,0,9,1);
  let rc2:i32=observe(W,503,7,3,1,0,9,1);
  emit("FAM_C events="); emit(i32s(get32(W,cnt_addr(2))-c_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-c_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-c_u0));
  emit(" rc_nested="); emit(i32s(rc1)); emit(","); emit(i32s(rc2)); emit("\n");
  emit("FAM_C rep fi="); emit(i32s(get32(W,rep_addr(2)))); emit(" fv="); emit(i32s(get32(W,rep_addr(2)+4))); emit("\n");
  let c_ok:i32=0; let c_tot:i32=0;
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,0,0,7)==2){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,0,0,7)==2){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,7)==0){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,7)==0){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,9)==7){c_ok=c_ok+1;}
  c_tot=c_tot+1; if(interp(W,rule_node(W,503),3,1,0,9)==7){c_ok=c_ok+1;}
  emit("FAM_C eval="); emit(i32s(c_ok)); emit("/"); emit(i32s(c_tot)); emit("\n");

  // ===== Family D (sig 504): underdetermined separator, first-hit luck =====
  let d_e0:i32=get32(W,cnt_addr(2)); let d_b0:i32=get32(W,cnt_addr(3)); let d_u0:i32=get32(W,cnt_addr(4));
  observe(W,504,2,3,0,5,7,1);
  observe(W,504,2,3,0,6,7,1);
  observe(W,504,0,3,1,9,7,1);
  observe(W,504,0,3,1,9,7,1);
  emit("FAM_D events="); emit(i32s(get32(W,cnt_addr(2))-d_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-d_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-d_u0));
  emit(" rep fi="); emit(i32s(get32(W,rep_addr(3)))); emit(" fv="); emit(i32s(get32(W,rep_addr(3)+4))); emit("\n");
  let d_ok:i32=0; let d_tot:i32=0;
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,1,5,7)==2){d_ok=d_ok+1;} else {emit("FAM_D HELDOUT_MIS f=(3,1,5,7) true=2\n");}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,0,9,7)==0){d_ok=d_ok+1;} else {emit("FAM_D HELDOUT_MIS f=(3,0,9,7) true=0\n");}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,1,9,7)==0){d_ok=d_ok+1;}
  d_tot=d_tot+1; if(interp(W,rule_node(W,504),3,0,5,7)==2){d_ok=d_ok+1;}
  emit("FAM_D heldout_eval="); emit(i32s(d_ok)); emit("/"); emit(i32s(d_tot)); emit("\n");

  // ===== Family E (sig 505): stash-window forgetting =====
  let e_e0:i32=get32(W,cnt_addr(2)); let e_b0:i32=get32(W,cnt_addr(3)); let e_u0:i32=get32(W,cnt_addr(4));
  observe(W,505,2,3,0,0,7,1);
  observe(W,505,2,3,0,1,7,1);
  observe(W,505,2,3,1,0,7,1);
  observe(W,505,0,3,1,1,7,1);
  observe(W,505,0,3,1,1,7,1);
  emit("FAM_E events="); emit(i32s(get32(W,cnt_addr(2))-e_e0));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))-e_b0));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4))-e_u0));
  emit(" rep fi="); emit(i32s(get32(W,rep_addr(4)))); emit(" fv="); emit(i32s(get32(W,rep_addr(4)+4))); emit("\n");
  let e_ok:i32=0; let e_tot:i32=0;
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,0,0,7)==2){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,0,1,7)==2){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,0,7)==2){e_ok=e_ok+1;} else {emit("FAM_E FORGOTTEN_MIS f=(3,1,0,7) true=2\n");}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,1,7)==0){e_ok=e_ok+1;}
  e_tot=e_tot+1; if(interp(W,rule_node(W,505),3,1,1,7)==0){e_ok=e_ok+1;}
  emit("FAM_E observed_eval="); emit(i32s(e_ok)); emit("/"); emit(i32s(e_tot)); emit("\n");

  emit("TOTAL events="); emit(i32s(get32(W,cnt_addr(2))));
  emit(" built="); emit(i32s(get32(W,cnt_addr(3))));
  emit(" unresolved="); emit(i32s(get32(W,cnt_addr(4)))); emit("\n");
  emit("ATTACK_END\n");
  return 0;
}

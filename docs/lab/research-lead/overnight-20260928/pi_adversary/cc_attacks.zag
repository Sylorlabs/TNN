// proc_cond.zag — Content-conditional procedure discovery.
// v1: Extends proc_learn.zag with IF(input[0]==v, A, B) programs.
//
// H-CC: Search directly finds content-conditional programs.
// - Base programs: 1055 (unchanged), P(k,n) -> index.
// - Conditional: IF(EQ0(v), A, B), P(k,n,input) -> index.
// - Branches A,B limited to size <= 3 (55 programs).
// - Candidate v: distinct bytes at position 0 in training inputs.
// - Two-phase search: base first (prevents hallucination), then conditional.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// === Base program machinery (from proc_learn.zag, unchanged) ===
// Node types: 0=K, 1=N, 2=C0, 3=C1, 4=C2, 5=ADD, 6=SUB

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}

fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+(prog_store[off] as i32)*3];
}

// === Conditional program machinery (NEW) ===
// Conditional program: [pred_val(1), then_pi(2), else_pi(2)] = 5 bytes each.
// Stored in cond_store, indexed by cond_index.

// Evaluate conditional program.
// Returns index, or -9999 on error.
fn eval_cond(prog_store:[]u8, prog_index:[]u8, pred_val:u8, then_pi:i32, else_pi:i32,
             inp:[]u8, k:i32, n:i32, tmp:[]u8)i32 {
  let cond:i32=0;
  if(inp.len>0 && inp[0]==pred_val){cond=1;}
  let use_pi:i32=else_pi;
  if(cond==1){use_pi=then_pi;}
  let prog:[]u8=get_prog(prog_store, prog_index, use_pi, tmp);
  let nnodes:i32=tmp[0] as i32;
  return eval_prog(prog, nnodes, k, n);
}

// Check if conditional program fits all training sequences.
// seqs: array of seq buffers, seq_lens: array of lengths, ns: array of n values,
// inps: array of input buffers (for predicate evaluation).
// We pass these as flat arrays with a count.
fn cond_fits(prog_store:[]u8, prog_index:[]u8, pred_val:u8, then_pi:i32, else_pi:i32,
             seq_data:[]u8, seq_lens:[]u8, seq_ns:[]u8, inp_data:[]u8, inp_lens:[]u8,
             nseq:i32, tmp:[]u8)i32 {
  let s:i32=0;
  while(s<nseq){
    let seqlen:i32=get32(seq_lens, s*4);
    if(seqlen<0){return 0;}  // extraction failed, can't fit
    let n:i32=get32(seq_ns, s*4);
    let inplen:i32=get32(inp_lens, s*4);
    // Get seq buffer (16*4 bytes each, at s*64)
    // Get inp buffer (we'll store inputs separately)
    let k:i32=0;
    while(k<seqlen){
      let expected:i32=get32(seq_data, s*64 + k*4);
      // Get input for this sequence
      let inp_off:i32=s*32;  // inputs stored at 32 bytes each
      let inp:[]u8=inp_data[inp_off..inp_off+inplen];
      let got:i32=eval_cond(prog_store, prog_index, pred_val, then_pi, else_pi,
                            inp, k, n, tmp);
      if(got!=expected){return 0;}
      k=k+1;
    }
    s=s+1;
  }
  return 1;
}


// === CC Adversary attack harness ===
// Reuses machinery above. Runs 6 preregistered attacks.

// Setup one training sequence. Returns seqlen (or -1 on extraction failure).
fn setup_seq(s:i32, inp:[]u8, outp:[]u8,
             seq_data:[]u8, seq_lens:[]u8, seq_ns:[]u8,
             inp_data:[]u8, inp_lens:[]u8)i32 {
  let sl:i32=extract_seq(inp, outp, seq_data[s*64..s*64+64]);
  set32(seq_lens, s*4, sl);
  set32(seq_ns, s*4, inp.len);
  set32(inp_lens, s*4, inp.len);
  let i:i32=0;
  while(i<inp.len){ inp_data[s*32+i]=inp[i]; i=i+1; }
  return sl;
}

// Run two-phase search on training data.
// out[0]: 0=base found, 1=conditional found, 2=none found
// out[1]: base_pi (if 0) or pred_val (if 1)
// out[2]: then_pi (if 1), out[3]: else_pi (if 1)
// out[4]: ncand (candidate count), out[5]: total programs
fn run_attack(prog_store:[]u8, prog_index:[]u8, pcount:i32, size3_end:i32,
              seq_data:[]u8, seq_lens:[]u8, seq_ns:[]u8,
              inp_data:[]u8, inp_lens:[]u8, nseq:i32,
              tmp:[]u8, out:[]u8)i32 {
  // Phase 1: base programs
  let found_base:i32=-1;
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nnodes:i32=tmp[0] as i32;
    let all_fit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let seqlen:i32=get32(seq_lens, s*4);
      let n:i32=get32(seq_ns, s*4);
      if(seqlen<0){all_fit=0;}
      else {
        let k:i32=0;
        while(k<seqlen){
          let expected:i32=get32(seq_data, s*64+k*4);
          let got:i32=eval_prog(prog, nnodes, k, n);
          if(got!=expected){all_fit=0; k=seqlen;}
          k=k+1;
        }
      }
      if(all_fit==0){s=nseq;}
      s=s+1;
    }
    if(all_fit==1){found_base=pi; pi=pcount;}
    pi=pi+1;
  }
  if(found_base>=0){
    set32(out, 0, 0);
    set32(out, 4, found_base);
    return 0;
  }
  // Phase 2: extract candidates, search conditionals
  let cand_vals:[]u8=z_alloc(300);
  let ncand:i32=0;
  let s:i32=0;
  while(s<nseq){
    let ilen:i32=get32(inp_lens, s*4);
    if(ilen>0){
      let v:u8=inp_data[s*32];
      let found:i32=0;
      let c:i32=0;
      while(c<ncand){
        if(cand_vals[c]==v){found=1;}
        c=c+1;
      }
      if(found==0){cand_vals[ncand]=v; ncand=ncand+1;}
    }
    s=s+1;
  }
  set32(out, 16, ncand);
  let total:i32=pcount + ncand * size3_end * size3_end;
  set32(out, 20, total);
  let ci:i32=0;
  let done:i32=0;
  while(ci<ncand && done==0){
    let pv:u8=cand_vals[ci];
    let ta:i32=0;
    while(ta<size3_end && done==0){
      let ea:i32=0;
      while(ea<size3_end && done==0){
        let fits:i32=cond_fits(prog_store, prog_index, pv, ta, ea,
                               seq_data, seq_lens, seq_ns, inp_data, inp_lens,
                               nseq, tmp);
        if(fits==1){
          set32(out, 0, 1);
          set32(out, 4, pv as i32);
          set32(out, 8, ta);
          set32(out, 12, ea);
          done=1;
        }
        ea=ea+1;
      }
      ta=ta+1;
    }
    ci=ci+1;
  }
  if(done==1){return 1;}
  set32(out, 0, 2);
  return 2;
}

fn prog_name(prog_store:[]u8, prog_index:[]u8, pi:i32, tmp:[]u8)[]u8 {
  let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
  let nn:i32=tmp[0] as i32;
  let buf:[]u8=z_alloc(64);
  let o:i32=0;
  buf[o]="[" as u8; o=o+1;
  let j:i32=0;
  while(j<nn){
    if(j>0){buf[o]=" " as u8; o=o+1;}
    let tt:i32=prog[j*3] as i32;
    if(tt==0){buf[o]="K" as u8; o=o+1;}
    else if(tt==1){buf[o]="N" as u8; o=o+1;}
    else if(tt==2){buf[o]="C" as u8; o=o+1; buf[o]="0" as u8; o=o+1;}
    else if(tt==3){buf[o]="C" as u8; o=o+1; buf[o]="1" as u8; o=o+1;}
    else if(tt==4){buf[o]="C" as u8; o=o+1; buf[o]="2" as u8; o=o+1;}
    else if(tt==5){buf[o]="A" as u8; o=o+1; buf[o]="D" as u8; o=o+1; buf[o]="D" as u8; o=o+1;}
    else if(tt==6){buf[o]="S" as u8; o=o+1; buf[o]="U" as u8; o=o+1; buf[o]="B" as u8; o=o+1;}
    j=j+1;
  }
  buf[o]="]" as u8; o=o+1;
  return buf[0..o];
}

fn main()i32 {
  emit("=== CC Adversary Attacks (prereg 449c1226f) ===\n");

  // Enumerate base programs (identical to proc_cond.zag)
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1;
    t=t+1;
  }
  let size1_end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  emit("base programs: ");
  emit(i32s(pcount));
  emit(", size3_end: ");
  emit(i32s(size3_end));
  emit("\n");

  let tmp:[]u8=z_alloc(8);
  let out:[]u8=z_alloc(32);

  // Buffers for up to 64 sequences
  let seq_data:[]u8=z_alloc(64*64);
  let seq_lens:[]u8=z_alloc(64*4);
  let seq_ns:[]u8=z_alloc(64*4);
  let inp_data:[]u8=z_alloc(64*32);
  let inp_lens:[]u8=z_alloc(64*4);

  // ============ CC-A1: position-1 predicate ============
  emit("\n--- CC-A1: discriminating feature at position 1 ---\n");
  let r1:i32=0;
  r1=setup_seq(0, "aXb", "aaa", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(1, "aYb", "bbb", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(2, "cXd", "ccc", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(3, "cYe", "eee", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  emit("seq lens: ");
  emit(i32s(get32(seq_lens,0))); emit(",");
  emit(i32s(get32(seq_lens,4))); emit(",");
  emit(i32s(get32(seq_lens,8))); emit(",");
  emit(i32s(get32(seq_lens,12))); emit("\n");
  let ra1:i32=run_attack(prog_store, prog_index, pcount, size3_end,
                         seq_data, seq_lens, seq_ns, inp_data, inp_lens, 4, tmp, out);
  emit("CC-A1 result code: ");
  emit(i32s(ra1));
  emit(" (0=base, 1=cond, 2=none)\n");
  if(ra1==2){
    emit("CC-A1 ATTACK PASS: no program found; predicate is position-0-only\n");
  } else if(ra1==1){
    emit("CC-A1 ATTACK FAIL: conditional found, pred=");
    emit(i32s(get32(out,4)));
    emit(" then=");
    emit(i32s(get32(out,8)));
    emit(" else=");
    emit(i32s(get32(out,12)));
    emit("\n");
  } else {
    emit("CC-A1 UNEXPECTED: base found at ");
    emit(i32s(get32(out,4)));
    emit("\n");
  }

  // ============ CC-A3: size-5 branch needed ============
  emit("\n--- CC-A3: then-branch needs size-5 (reverse) ---\n");
  r1=setup_seq(0, "xab", "bax", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(1, "xcd", "dcx", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(2, "abc", "ccc", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(3, "def", "fff", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  let ra3:i32=run_attack(prog_store, prog_index, pcount, size3_end,
                         seq_data, seq_lens, seq_ns, inp_data, inp_lens, 4, tmp, out);
  emit("CC-A3 result code: ");
  emit(i32s(ra3));
  emit("\n");
  if(ra3==2){
    emit("CC-A3 ATTACK PASS: no program found; branches limited to size<=3\n");
  } else {
    emit("CC-A3 ATTACK FAIL: program found (code ");
    emit(i32s(ra3));
    emit(")\n");
  }

  // ============ CC-A4: spurious base fit masks conditional ============
  emit("\n--- CC-A4: base fits training but true rule is conditional ---\n");
  r1=setup_seq(0, "abc", "cba", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(1, "xab", "bax", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  let ra4:i32=run_attack(prog_store, prog_index, pcount, size3_end,
                         seq_data, seq_lens, seq_ns, inp_data, inp_lens, 2, tmp, out);
  emit("CC-A4 result code: ");
  emit(i32s(ra4));
  emit("\n");
  if(ra4==0){
    let bpi:i32=get32(out,4);
    emit("base program index: ");
    emit(i32s(bpi));
    emit(" (n-1-k, index 50 = reverse; prog_name rendering removed: nondeterministic slice bug in debug helper, index is the datum)\n");
    // Hidden test: "xcd" -> "xxx" (true rule: IF x THEN broadcast-first).
    // Apply found base program to hidden input.
    let hid:[]u8="xcd";
    let hprog:[]u8=get_prog(prog_store, prog_index, bpi, tmp);
    let hnn:i32=tmp[0] as i32;
    let hk:i32=0;
    let hall_ok:i32=1;
    // Expected output "xxx": each char 'x' is at index 0 in "xcd".
    while(hk<3){
      let got:i32=eval_prog(hprog, hnn, hk, 3);
      if(got!=0){hall_ok=0;}
      hk=hk+1;
    }
    if(hall_ok==0){
      emit("CC-A4 ATTACK PASS: base returned (Phase2 never ran); wrong on hidden case\n");
    } else {
      emit("CC-A4 ATTACK FAIL: base program happens to handle hidden case\n");
    }
  } else {
    emit("CC-A4 UNEXPECTED: result code ");
    emit(i32s(ra4));
    emit(" (expected base=0)\n");
  }

  // ============ CC-A5: greater-than predicate ============
  emit("\n--- CC-A5: threshold predicate (input[0] > 'm') ---\n");
  r1=setup_seq(0, "zab", "zzz", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(1, "yab", "yyy", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(2, "aab", "bbb", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(3, "cab", "bbb", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  let ra5:i32=run_attack(prog_store, prog_index, pcount, size3_end,
                         seq_data, seq_lens, seq_ns, inp_data, inp_lens, 4, tmp, out);
  emit("CC-A5 result code: ");
  emit(i32s(ra5));
  emit("\n");
  if(ra5==2){
    emit("CC-A5 ATTACK PASS: no program found; predicates are equality-only\n");
  } else {
    emit("CC-A5 ATTACK FAIL: program found (code ");
    emit(i32s(ra5));
    emit(")\n");
  }

  // ============ CC-A6: original uncleaned H-REVISE data ============
  emit("\n--- CC-A6: original data with ('xy'->'yy') ---\n");
  r1=setup_seq(0, "abc", "ccc", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(1, "xy", "yy", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(2, "defg", "gggg", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  r1=setup_seq(3, "xab", "xxx", seq_data, seq_lens, seq_ns, inp_data, inp_lens);
  emit("seq lens: ");
  emit(i32s(get32(seq_lens,0))); emit(",");
  emit(i32s(get32(seq_lens,4))); emit(",");
  emit(i32s(get32(seq_lens,8))); emit(",");
  emit(i32s(get32(seq_lens,12))); emit("\n");
  let ra6:i32=run_attack(prog_store, prog_index, pcount, size3_end,
                         seq_data, seq_lens, seq_ns, inp_data, inp_lens, 4, tmp, out);
  emit("CC-A6 result code: ");
  emit(i32s(ra6));
  emit("\n");
  if(ra6==2){
    emit("CC-A6 ATTACK PASS: no program on original data; cleaning was load-bearing\n");
  } else if(ra6==1){
    emit("CC-A6 ATTACK FAIL: conditional found on original data, pred=");
    emit(i32s(get32(out,4)));
    emit(" then=");
    emit(i32s(get32(out,8)));
    emit(" else=");
    emit(i32s(get32(out,12)));
    emit("\n");
  } else {
    emit("CC-A6 UNEXPECTED: base found at ");
    emit(i32s(get32(out,4)));
    emit("\n");
  }

  // ============ CC-A2: scaling count ============
  emit("\n--- CC-A2: 50 distinct position-0 values ---\n");
  let v:i32=0;
  while(v<50){
    // input: [v, 'q', 'r'], output: "rrr" (broadcast-last, seq [2,2,2])
    let ib:[]u8=z_alloc(3);
    ib[0]=v as u8; ib[1]="q" as u8; ib[2]="r" as u8;
    let ob:[]u8="rrr";
    r1=setup_seq(v, ib[0..3], ob, seq_data, seq_lens, seq_ns, inp_data, inp_lens);
    v=v+1;
  }
  // Count candidates (distinct pos-0 bytes)
  let cand2:[]u8=z_alloc(300);
  let nc2:i32=0;
  let s2:i32=0;
  while(s2<50){
    let vv:u8=inp_data[s2*32];
    let fnd:i32=0;
    let c2:i32=0;
    while(c2<nc2){
      if(cand2[c2]==vv){fnd=1;}
      c2=c2+1;
    }
    if(fnd==0){cand2[nc2]=vv; nc2=nc2+1;}
    s2=s2+1;
  }
  let total2:i32=pcount + nc2 * size3_end * size3_end;
  emit("distinct pos-0 values: ");
  emit(i32s(nc2));
  emit("\n");
  emit("total programs: ");
  emit(i32s(total2));
  emit("\n");
  if(total2>=100000){
    emit("CC-A2 ATTACK PASS: ");
    emit(i32s(total2));
    emit(" >= 100000; tractability bar breaks at scale\n");
  } else {
    emit("CC-A2 ATTACK FAIL: still under 100k\n");
  }

  emit("\n=== attacks complete ===\n");
  return 0;
}

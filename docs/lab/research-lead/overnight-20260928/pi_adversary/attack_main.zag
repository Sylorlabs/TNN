
// ============ ATTACK MAIN: B-A2..B-A6 ============
// Learner functions above (lines 1-457 of bridge_learn.zag) are verbatim.
// Only new test tasks below. Pure Zag.

fn apair(W:[]u8, pairbase:i32, idx:i32, s:i32, in_s:[]u8, out_s:[]u8)i32 {
  let io:i32=s; s=s+wcopy(W,s,in_s);
  let oo:i32=s; s=s+wcopy(W,s,out_s);
  set32(W,pairbase+idx*16,io); set32(W,pairbase+idx*16+4,in_s.len);
  set32(W,pairbase+idx*16+8,oo); set32(W,pairbase+idx*16+12,out_s.len);
  return s;
}
fn count_procs(W:[]u8, pbase:i32)i32 {
  let c:i32=0; let s:i32=0;
  while(s<PROC_MAX()){ if(proc_used(W,pbase,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn main()i32 {
  emit("=== BRIDGE ADVERSARY attacks B-A2..B-A6 ===\n");
  let npass:i32=0;
  let natt:i32=0;

  // ---- B-A2: discriminating position in the middle (pos=2) ----
  emit("\n--- B-A2: pos=2 discriminating ---\n");
  let W:[]u8=z_alloc(131072);
  let pbase:i32=0;
  let bbase:i32=1024;
  let work:i32=2048;
  let pairbase:i32=8192;
  let strbase:i32=16384;
  strbase=apair(W,pairbase,0,strbase,"abx","aaa");
  strbase=apair(W,pairbase,1,strbase,"cdx","ccc");
  strbase=apair(W,pairbase,2,strbase,"aby","yyy");
  strbase=apair(W,pairbase,3,strbase,"cdy","yyy");
  let rd:i32=bridge_learn(W,pbase,bbase,pairbase,4,work);
  natt=natt+1;
  let bs:i32=-1;
  if(rd>=1000 && br_cpos(W,bbase,rd-1000)==2 && br_cval(W,bbase,rd-1000)==120){
    bs=rd-1000;
  } else {
    emit("B-A2: no rule or wrong condition. rd=");
    emit(i32s(rd));
    emit(" bridges=");
    emit(i32s(br_count(W,bbase)));
    emit("\n");
  }
  let ok2:i32=0;
  if(bs>=0){
    let o1:[]u8=z_alloc(4);
    let o2:[]u8=z_alloc(4);
    if(bridge_apply(W,pbase,bbase,bs,"zzx",o1)==1 && bridge_apply(W,pbase,bbase,bs,"zzy",o2)==1){
      if(streq(o1[0..3],"zzz")==1 && streq(o2[0..3],"yyy")==1){ ok2=1; }
      else {
        emit("B-A2 dispatch got ");
        emit(o1[0..3]); emit(" / "); emit(o2[0..3]); emit("\n");
      }
    }
  }
  if(ok2==1){
    emit("B-A2 PASS: pos=2 rule learned, dispatch correct\n");
    npass=npass+1;
  } else {
    emit("B-A2 FAIL\n");
  }

  // ---- B-A3: three-way split (boundary probe) ----
  emit("\n--- B-A3: three-way split ---\n");
  let W3:[]u8=z_alloc(131072);
  let sb3:i32=16384;
  sb3=apair(W3,pairbase,0,sb3,"xab","xxx");
  sb3=apair(W3,pairbase,1,sb3,"yab","bbb");
  sb3=apair(W3,pairbase,2,sb3,"qab","qab");
  let re:i32=bridge_learn(W3,pbase,bbase,pairbase,3,work);
  natt=natt+1;
  emit("B-A3: returned ");
  emit(i32s(re));
  emit(" bridges=");
  emit(i32s(br_count(W3,bbase)));
  emit("\n");
  if(re==-1){
    emit("B-A3 BOUNDARY-CONFIRMED: honest -1 on 3-way split (no confident error)\n");
    npass=npass+1;
  } else {
    emit("B-A3 NOTE: binary rule returned for 3-way problem (confident split)\n");
  }

  // ---- B-A4: two-position conjunction (boundary probe) ----
  emit("\n--- B-A4: conjunction ---\n");
  let W4:[]u8=z_alloc(131072);
  let sb4:i32=16384;
  sb4=apair(W4,pairbase,0,sb4,"xyab","xxxx");
  sb4=apair(W4,pairbase,1,sb4,"xycd","xxxx");
  sb4=apair(W4,pairbase,2,sb4,"xzab","bbbb");
  sb4=apair(W4,pairbase,3,sb4,"zyab","bbbb");
  let rf:i32=bridge_learn(W4,pbase,bbase,pairbase,4,work);
  natt=natt+1;
  emit("B-A4: returned ");
  emit(i32s(rf));
  emit(" bridges=");
  emit(i32s(br_count(W4,bbase)));
  emit("\n");
  if(rf==-1){
    emit("B-A4 BOUNDARY-CONFIRMED: honest -1 on conjunction (no single split)\n");
    npass=npass+1;
  } else {
    emit("B-A4 NOTE: binary rule returned where truth needs conjunction\n");
  }

  // ---- B-A5: no spurious trigger on solvable task ----
  emit("\n--- B-A5: solvable task, bridge must NOT trigger ---\n");
  let W5:[]u8=z_alloc(131072);
  let sb5:i32=16384;
  sb5=apair(W5,pairbase,0,sb5,"abc","cba");
  sb5=apair(W5,pairbase,1,sb5,"def","fed");
  sb5=apair(W5,pairbase,2,sb5,"xgh","hgx");
  let rg:i32=bridge_learn(W5,pbase,bbase,pairbase,3,work);
  natt=natt+1;
  if(rg>=0 && rg<1000 && br_count(W5,bbase)==0){
    emit("B-A5 PASS: direct solved (slot ");
    emit(i32s(rg));
    emit("), 0 bridge rules\n");
    npass=npass+1;
  } else {
    emit("B-A5 FAIL: rg=");
    emit(i32s(rg));
    emit(" bridges=");
    emit(i32s(br_count(W5,bbase)));
    emit("\n");
  }

  // ---- B-A6a: slot waste measurement (7 distractors) ----
  emit("\n--- B-A6a: slot waste (7 distractors) ---\n");
  let W6:[]u8=z_alloc(131072);
  let sb6:i32=16384;
  sb6=apair(W6,pairbase,0,sb6,"abc","ccc");
  sb6=apair(W6,pairbase,1,sb6,"dbc","ccc");
  sb6=apair(W6,pairbase,2,sb6,"ebc","ccc");
  sb6=apair(W6,pairbase,3,sb6,"fbc","ccc");
  sb6=apair(W6,pairbase,4,sb6,"gbc","ccc");
  sb6=apair(W6,pairbase,5,sb6,"hbc","ccc");
  sb6=apair(W6,pairbase,6,sb6,"ibc","ccc");
  sb6=apair(W6,pairbase,7,sb6,"xab","xxx");
  let rh:i32=bridge_learn(W6,pbase,bbase,pairbase,8,work);
  natt=natt+1;
  let used6:i32=count_procs(W6,pbase);
  emit("B-A6a: rule=");
  emit(i32s(rh));
  emit(" proc_slots_used=");
  emit(i32s(used6));
  emit(" (2 needed, rest wasted)");
  if(rh>=1000 && br_cpos(W6,bbase,rh-1000)==0 && br_cval(W6,bbase,rh-1000)==120){
    emit(" rule correct");
  } else {
    emit(" RULE WRONG");
  }
  emit("\n");
  if(used6>2){
    emit("B-A6a WASTE-CONFIRMED\n");
    npass=npass+1;
  } else {
    emit("B-A6a UNEXPECTED: no waste\n");
  }

  // ---- B-A6b: slot exhaustion (15 distractors, PROC_MAX=16) ----
  emit("\n--- B-A6b: slot exhaustion (15 distractors) ---\n");
  let W7:[]u8=z_alloc(131072);
  let sb7:i32=16384;
  sb7=apair(W7,pairbase,0,sb7,"abc","ccc");
  sb7=apair(W7,pairbase,1,sb7,"bbc","ccc");
  sb7=apair(W7,pairbase,2,sb7,"dbc","ccc");
  sb7=apair(W7,pairbase,3,sb7,"ebc","ccc");
  sb7=apair(W7,pairbase,4,sb7,"fbc","ccc");
  sb7=apair(W7,pairbase,5,sb7,"gbc","ccc");
  sb7=apair(W7,pairbase,6,sb7,"hbc","ccc");
  sb7=apair(W7,pairbase,7,sb7,"ibc","ccc");
  sb7=apair(W7,pairbase,8,sb7,"jbc","ccc");
  sb7=apair(W7,pairbase,9,sb7,"kbc","ccc");
  sb7=apair(W7,pairbase,10,sb7,"lbc","ccc");
  sb7=apair(W7,pairbase,11,sb7,"mbc","ccc");
  sb7=apair(W7,pairbase,12,sb7,"nbc","ccc");
  sb7=apair(W7,pairbase,13,sb7,"obc","ccc");
  sb7=apair(W7,pairbase,14,sb7,"pbc","ccc");
  sb7=apair(W7,pairbase,15,sb7,"xab","xxx");
  let rh2:i32=bridge_learn(W7,pbase,bbase,pairbase,16,work);
  natt=natt+1;
  let used7:i32=count_procs(W7,pbase);
  emit("B-A6b: returned ");
  emit(i32s(rh2));
  emit(" proc_slots_used=");
  emit(i32s(used7));
  emit(" bridges=");
  emit(i32s(br_count(W7,bbase)));
  emit("\n");
  if(rh2==-1 && used7==16){
    emit("B-A6b EXHAUSTION-CONFIRMED: learnable rule exists but slots ran out\n");
    npass=npass+1;
  } else {
    emit("B-A6b: unexpected outcome\n");
  }

  emit("\n=== ADVERSARY RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(natt));
  emit(" ===\n");
  return 0;
}

// adv_driver.zag -- independent adversary driver for the HARDENED inquiry
// mechanism. The hardened learner (h_base_nomain.zag + h_patch.zag) is
// linked UNMODIFIED (byte-identical copies, verified by cmp). Only the
// teachers and the world loop below are new. Four new attacks:
//   wid 20 ADV-COHERENT:   coherent liar, strong kill (16,42,0), no verify
//   wid 21 ADV-SLOWPOISON:  weak lie (35,42,2) + coherent corroborator (16,42,0)
//   wid 22 ADV-SUBWASTE:    harmless fact, then weak lie + refuse on verify
//   wid 23 ADV-PROVSPOOF:   duplicate-of-taught, then harmless fact
// Teachers are plain functions (0 modes/bridges/handlers).

// ---- NEG-AMB teaching (copied verbatim from h_driver.zag cn_teach) ----

fn cn_P(a:i32,b:i32)i32 { return a*8+b; }

fn cn_teach(W:[]u8)void {
  let a:i32=2;
  while(a<=6){
    let p:i32=cn_P(a,a);
    ev_teach_in(W,p,41,0);
    ev_teach_in(W,p,42,1);
    a=a+2;
  }
  ev_teach_in(W,0,43,cn_P(2,2));
  ev_teach_in(W,0,43,cn_P(4,4));
  ev_teach_in(W,0,43,cn_P(6,6));
  ev_teach_in(W,1,44,cn_P(2,2));
  ev_teach_in(W,1,44,cn_P(4,4));
  ev_teach_in(W,1,44,cn_P(6,6));
  ev_teach_in(W,0,45,cn_P(2,2));
  ev_teach_in(W,1,45,cn_P(2,2));
  return;
}

// ---- grammar reporting (copied verbatim from h_driver.zag) ----

fn c_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let f4:i32=ng(W,g,4);
  let D:i32=f4/4;
  let nlic:i32=f4-(D*4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" D="); e64(D);
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- single-target battery (copied verbatim from h_driver.zag) ----

fn adv_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-ADV-NOGRAMMAR\n"); return 0;}
  let D:i32=get32(gb,32);
  let t:i32=0;
  let ans:i32=gi_trial_build2(W,t,gb);
  let cl:i32=gi_classify(W,t,D);
  emit("GI-ADV-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
  let vc:i32=0;
  if(cl==1){vc=1;}
  emit("GI-ADV-B-VALID "); e64(vc); emit("/1\n");
  return vc;
}

// ---- adversarial teacher dispatcher ----
// Writes (s,r,o) to ap[0,4,8]; returns 1=answered, 0=refused.
// is_verify=1 on the verification re-query.

fn a2_teacher_answer(W:[]u8,wid:i32,qq:i32,is_verify:i32,ap:[]u8)i32 {
  if(wid==20){
    // ADV-COHERENT: coherent liar. (P,42,0) with 8|P is a STRONG kill
    // of the true d=8 and a TRUE fact in the liar's D=17 world
    // (P=16 decodes to (0,16), 0/16=0). Infinite coherent family.
    if(qq==0){set32(ap,0,16);}
    else {if(qq==1){set32(ap,0,32);} else {set32(ap,0,48);}}
    set32(ap,4,42); set32(ap,8,0);
    emit("GI-ADV-COHERENT-ANSWER P="); e64(get32(ap,0)); emit(" op=42 t=0\n");
    return 1;
  }
  if(wid==21){
    // ADV-SLOWPOISON: weak lie on the main query, coherent strong
    // corroborator on the verification re-query.
    if(is_verify==1){
      set32(ap,0,16); set32(ap,4,42); set32(ap,8,0);
      emit("GI-ADV-SLOWPOISON-VERIFY P=16 op=42 t=0\n");
      return 1;
    }
    set32(ap,0,35); set32(ap,4,42); set32(ap,8,2);
    emit("GI-ADV-SLOWPOISON-ANSWER P=35 op=42 t=2\n");
    return 1;
  }
  if(wid==22){
    // ADV-SUBWASTE: harmless true fact, then weak lie, then REFUSE the
    // verification re-query (stays under WASTE_BUDGET=2).
    if(is_verify==1){
      emit("GI-ADV-SUBWASTE-REFUSE-VERIFY\n");
      return 0;
    }
    if(qq==0){
      set32(ap,0,20); set32(ap,4,41); set32(ap,8,-2);
      emit("GI-ADV-SUBWASTE-ANSWER P=20 op=41 t=-2\n");
    } else {
      set32(ap,0,35); set32(ap,4,42); set32(ap,8,2);
      emit("GI-ADV-SUBWASTE-ANSWER P=35 op=42 t=2\n");
    }
    return 1;
  }
  if(wid==23){
    // ADV-PROVSPOOF: answer an exact duplicate of a taught fact (bid
    // for taught status), then a new harmless fact.
    if(qq==0){
      set32(ap,0,18); set32(ap,4,41); set32(ap,8,0);
      emit("GI-ADV-PROVSPOOF-ANSWER s=18 r=41 o=0 dup-of-taught\n");
    } else {
      set32(ap,0,20); set32(ap,4,41); set32(ap,8,-2);
      emit("GI-ADV-PROVSPOOF-ANSWER s=20 r=41 o=-2 new\n");
    }
    return 1;
  }
  return 0;
}

// ---- re-induction after an accepted answer (renamed h_reinduce) ----

fn a2_reinduce(W:[]u8,nc_out:[]u8)i32 {
  let r2:i32=gi_codec_induce(W);
  let code:i32=0;
  if(r2>0){code=gi_induce(W);} else {code=r2;}
  if(code>0){set32(nc_out,0,1);}
  else {
    if(code==-4){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W,gb,cb,nb);
      set32(nc_out,0,get32(nb,0));
    } else {set32(nc_out,0,0);}
  }
  return code;
}

// ---- provenance spoof check (wid 23) ----
// The 14 taught triples of cn_teach. Returns 1 if (s,r,o) is taught.

fn a2_taught_member(s:i32,r:i32,o:i32)i32 {
  if(s==18 && r==41 && o==0){return 1;}
  if(s==18 && r==42 && o==1){return 1;}
  if(s==36 && r==41 && o==0){return 1;}
  if(s==36 && r==42 && o==1){return 1;}
  if(s==54 && r==41 && o==0){return 1;}
  if(s==54 && r==42 && o==1){return 1;}
  if(s==0 && r==43 && o==18){return 1;}
  if(s==0 && r==43 && o==36){return 1;}
  if(s==0 && r==43 && o==54){return 1;}
  if(s==1 && r==44 && o==18){return 1;}
  if(s==1 && r==44 && o==36){return 1;}
  if(s==1 && r==44 && o==54){return 1;}
  if(s==0 && r==45 && o==18){return 1;}
  if(s==1 && r==45 && o==18){return 1;}
  return 0;
}

// Every prov=1 fact must be a taught triple; every prov=2 fact must be
// a teacher-supplied triple ((20,41,-2) here). Mismatches = spoof.

fn a2_spoof_check(W:[]u8,prov:[]u8)i32 {
  let mm:i32=0; let tq:i32=0; let iq:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let pv:i32=prov[n] as i32;
      let s:i32=ng(W,n,20); let r:i32=ng(W,n,24); let o:i32=ng(W,n,28);
      if(pv==1){
        tq=tq+1;
        if(a2_taught_member(s,r,o)==0){mm=mm+1;}
      } else {
        if(pv==2){
          iq=iq+1;
          if(s==20 && r==41 && o==-2){}
          else {mm=mm+1;}
        }
      }
    }
    n=n+1;
  }
  emit("GI-PROVSPOOF-CHECK mismatches="); e64(mm);
  emit(" taught_ok="); e64(tq); emit(" inquiry_ok="); e64(iq); emit("\n");
  return mm;
}

// ---- adversary world runner (loop modeled on h_world) ----

fn a2_world(wid:i32)i32 {
  emit("GI-ADV-WORLD ");
  if(wid==20){emit("ADV-COHERENT\n");}
  if(wid==21){emit("ADV-SLOWPOISON\n");}
  if(wid==22){emit("ADV-SUBWASTE\n");}
  if(wid==23){emit("ADV-PROVSPOOF\n");}
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  let prov:[]u8=z_alloc(1024);
  cn_teach(W1);
  gi_prov_mark_taught(W1,prov);
  let code:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(code); emit("\n");
  let qi:i32=0; let qa:i32=0; let qv:i32=0; let qva:i32=0;
  let waste:i32=0; let stopped:i32=0;
  if(code==-4){
    let qq:i32=0;
    while(qq<4 && code==-4 && stopped==0){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W1,gb,cb,nb);
      let nc_before:i32=get32(nb,0);
      let gval:i32=get32(gb,0);
      gi_inquire(gval,cb,nc_before); qi=qi+1;
      let ap:[]u8=z_alloc(16);
      let ans:i32=a2_teacher_answer(W1,wid,qq,0,ap);
      if(ans==0){emit("GI-TEACHER-REFUSED\n"); stopped=1;}
      else {
        qa=qa+1;
        let dw:[]u8=z_alloc(16);
        let r:i32=gi_inquiry_accept(W1,prov,get32(ap,0),get32(ap,4),get32(ap,8),dw);
        if(r==1){
          let ncb:[]u8=z_alloc(16);
          code=a2_reinduce(W1,ncb);
          if(get32(ncb,0)>=nc_before){
            waste=waste+1;
            emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
            if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
          }
        } else {
          if(r==0){
            qv=qv+1;
            let bp:[]u8=z_alloc(16);
            let bans:i32=a2_teacher_answer(W1,wid,qq,1,bp);
            if(bans==0){emit("GI-TEACHER-REFUSED\n"); stopped=1;}
            else {
              qva=qva+1;
              let rv:i32=gi_inquiry_verify(W1,prov,get32(bp,0),get32(bp,4),get32(bp,8),get32(dw,0),get32(ap,0),get32(ap,4),get32(ap,8));
              if(rv==1){
                let ncb:[]u8=z_alloc(16);
                code=a2_reinduce(W1,ncb);
                if(get32(ncb,0)>=nc_before){
                  waste=waste+1;
                  emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
                  if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
                }
              } else {
                stopped=1;
              }
            }
          } else {
            if(r==-1){stopped=1;}
            else {
              waste=waste+1;
              emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
              if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
            }
          }
        }
      }
      qq=qq+1;
    }
    emit("GI-QUERIES issued="); e64(qi); emit(" answered="); e64(qa);
    emit(" verify="); e64(qv); emit("/"); e64(qva);
    emit(" waste="); e64(waste); emit("\n");
  }
  emit("GI-INDUCED-POST "); e64(code); emit("\n");
  c_report_grammar(W1);
  gi_prov_audit(W1,prov);
  if(wid==20){
    emit("GI-ADV-CHECK coherent-fact-present=");
    if(gi_quarantine_check(W1,16,42,0)==1){emit("1\n");} else {emit("0\n");}
  }
  if(wid==21){
    emit("GI-ADV-CHECK lie-present=");
    if(gi_quarantine_check(W1,35,42,2)==1){emit("1\n");} else {emit("0\n");}
    emit("GI-ADV-CHECK corroborator-present=");
    if(gi_quarantine_check(W1,16,42,0)==1){emit("1\n");} else {emit("0\n");}
  }
  if(wid==23){
    let mm:i32=a2_spoof_check(W1,prov);
    emit("GI-ADV-CHECK spoof-mm="); e64(mm); emit("\n");
  }
  if(code==1 && wid>=20){
    emit("GI-ADV-BATTERY\n");
    let v:i32=adv_arm_induce(W1);
    emit("GI-ADV-WORLD-VALID "); e64(v); emit("\n");
  }
  return code;
}

fn main()i32 {
  emit("GI-ADV-START\n");
  let c20:i32=a2_world(20);
  let c21:i32=a2_world(21);
  let c22:i32=a2_world(22);
  let c23:i32=a2_world(23);
  emit("GI-ADV-DONE\n");
  return 0;
}

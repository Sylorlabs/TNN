// delayed_consequence.zag -- DCE: delayed-consequence evaluation.
// Pure Zag. World + learner + driver + single raw-syscall flush.
// Prereg: delayed_consequence_eval/PREREG.md (frozen kill bars K1..K10).
//
// Boundary discipline: the learner (learner_commit, learner_phase4_record,
// learner_phase4_norecord, learner_followup) sees only current licensing
// (alive bytes), the public volatility ledger, its own state, and the
// driver clock value at commit. The kill schedule is driver-held and never
// passed into the learner path. No expected answer token appears in any
// learner function (K6 audit).

const DC_FAIL:i32=-1;

// Learner state offsets (u8 buffer, 128 bytes).
const LS_REL:i32=0;    // rel[5]: i32 at 0,4,8,12,16
const LS_OBS:i32=24;   // observed kills per fact: 8 x i32 at 24..55
const LS_LAST:i32=56;  // last executed composite id
const LS_AC:i32=60;    // attribution: composite id (-1 none)
const LS_AF:i32=64;    // attribution: cause fact id (-1 unresolved)
const LS_HASR:i32=68;  // has commitment record (0/1)
const LS_RID:i32=72;   // record: composite id
const LS_RPRED:i32=76; // record: prediction
const LS_RRAT:i32=80;  // record: reliability at commit
const LS_RVOL:i32=84;  // record: max license volatility
const LS_REP:i32=88;   // record: commit epoch
const LS_RCK:i32=92;   // record: learner checksum
const LS_ACT0:i32=96;  // composite A active flag
const LS_ACT1:i32=100; // composite B active flag

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---------- WORLD (frozen per PREREG section 2) ----------
fn fact_val(f:i32)i32 {
  if(f==0){return 10;}
  if(f==1){return 20;}
  if(f==2){return 30;}
  if(f==3){return 40;}
  if(f==4){return 50;}
  if(f==5){return 60;}
  if(f==6){return 70;}
  return 80;
}
// Public volatility ledger: past kill counts. Learner-readable.
// The FUTURE kill schedule is driver-held and hidden.
fn fact_vol(f:i32)i32 {
  if(f==3){return 2;}
  return 0;
}
// Composite licenses. A=0:{0,1,2} B=1:{0,3} C=2:{4,5} D=3:{6,7} E=4:{4,6}
fn comp_nlic(cid:i32)i32 {
  if(cid==0){return 3;}
  return 2;
}
fn comp_lic(cid:i32,k:i32)i32 {
  if(cid==0){ if(k==0){return 0;} if(k==1){return 1;} return 2; }
  if(cid==1){ if(k==0){return 0;} return 3; }
  if(cid==2){ if(k==0){return 4;} return 5; }
  if(cid==3){ if(k==0){return 6;} return 7; }
  if(k==0){return 4;} return 6;
}
// Execute against CURRENT licensing only. FAIL if any license dead.
fn exec_c(cid:i32, alive:[]u8)i32 {
  let n:i32=comp_nlic(cid);
  let k:i32=0;
  let sum:i32=0;
  while(k<n){
    let f:i32=comp_lic(cid,k);
    if(alive[f]==0){ return DC_FAIL; }
    sum=sum+fact_val(f);
    k=k+1;
  }
  return sum;
}

// ---------- LEARNER (frozen per PREREG section 4) ----------
// Commit: pick max experienced reliability among {A,B} (tie -> lower
// id). Record id, prediction, reliability basis, max license
// volatility, epoch, learner checksum. write_rec=0 for the D3
// no-record variant (behaviorally identical otherwise).
fn learner_commit(st:[]u8, alive:[]u8, epoch:i32, write_rec:i32)i32 {
  let ra:i32=get32(st,0);
  let rb:i32=get32(st,4);
  let cid:i32=0;
  if(rb>ra){ cid=1; }
  let pred:i32=exec_c(cid,alive);
  let rat:i32=ra;
  if(cid==1){ rat=rb; }
  let n:i32=comp_nlic(cid);
  let k:i32=0;
  let mv:i32=0;
  while(k<n){
    let v:i32=fact_vol(comp_lic(cid,k));
    if(v>mv){ mv=v; }
    k=k+1;
  }
  if(write_rec==1){
    set32(st,LS_RID,cid);
    set32(st,LS_RPRED,pred);
    set32(st,LS_RRAT,rat);
    set32(st,LS_RVOL,mv);
    set32(st,LS_REP,epoch);
    let ck:i32=cid*31+pred*7+rat*13+mv*17+epoch*29;
    set32(st,LS_RCK,ck);
    set32(st,LS_HASR,1);
  }
  return cid;
}
// Phase 4 with record: re-execute the RECORDED composite (record
// directed), compare outcome to the RECORDED prediction, attribute a
// discrepancy to the specific commitment and cause, revise.
fn learner_phase4_record(st:[]u8, alive:[]u8)void {
  let rid:i32=get32(st,LS_RID);
  let out:i32=exec_c(rid,alive);
  let pred:i32=get32(st,LS_RPRED);
  let d:i32=out-pred;
  if(d<0){ d=0-d; }
  let ro:i32=rid*4;
  if(d==0){
    set32(st,ro,get32(st,ro)+10);
  } else {
    let n:i32=comp_nlic(rid);
    let k:i32=0;
    let cause:i32=-1;
    while(k<n){
      let f:i32=comp_lic(rid,k);
      if(alive[f]==0){ if(cause==-1){ cause=f; } }
      k=k+1;
    }
    set32(st,LS_AC,rid);
    set32(st,LS_AF,cause);
    set32(st,ro,get32(st,ro)-60);
    if(rid==0){ set32(st,LS_ACT0,0); }
    if(rid==1){ set32(st,LS_ACT1,0); }
    if(cause>=0){
      let oo:i32=LS_OBS+cause*4;
      set32(st,oo,get32(st,oo)+1);
    }
  }
  return;
}
// Phase 4 WITHOUT record (D3 control, frozen policy): re-encounter the
// query via current-best among {A,B}. On observed failure there is no
// recorded prediction to compare against and no commitment binding, so
// the generic no-record rule attributes to the most recently executed
// composite (recency) and demotes it.
fn learner_phase4_norecord(st:[]u8, alive:[]u8)void {
  let ra:i32=get32(st,0);
  let rb:i32=get32(st,4);
  let bid:i32=0;
  if(rb>ra){ bid=1; }
  let out:i32=exec_c(bid,alive);
  if(out==DC_FAIL){
    let tgt:i32=get32(st,LS_LAST);
    let ro:i32=tgt*4;
    set32(st,ro,get32(st,ro)-60);
    let n:i32=comp_nlic(tgt);
    let k:i32=0;
    let cause:i32=-1;
    while(k<n){
      let f:i32=comp_lic(tgt,k);
      if(alive[f]==0){ if(cause==-1){ cause=f; } }
      k=k+1;
    }
    set32(st,LS_AC,tgt);
    set32(st,LS_AF,cause);
  }
  return;
}
// Follow-up query: max reliability among active {A,B} (tie -> A).
fn learner_followup(st:[]u8)i32 {
  let a0:i32=get32(st,LS_ACT0);
  let a1:i32=get32(st,LS_ACT1);
  let best:i32=-1;
  let br:i32=-1000000000;
  if(a0==1){ best=0; br=get32(st,0); }
  if(a1==1){ if(get32(st,4)>br){ best=1; br=get32(st,4); } }
  return best;
}

// ---------- DRIVER (evaluator side; never in the learner path) ----------
// Tamper seal over the 24 record bytes. Init constant is driver-held;
// the learner never sees it. Detects any post-commit modification of
// the record region (threat model: accidental corruption by
// interference episodes, verified by re-computation at checkpoints).
fn seal_of(st:[]u8)i32 {
  let h:i32=987654321;
  let i:i32=0;
  while(i<24){
    h=h*31+ (st[LS_RID+i] as i32);
    i=i+1;
  }
  return h;
}
// P2 episode script. Arms 0..2: [C,D,E,C]. Arm 3 (D4): the exact frozen
// 14-episode script [C,D,E,B,C,D,E,B,C,D,E,C,D,E]; two episodes execute
// B pre-kill (they succeed and raise its reliability, adversarially).
fn p2_ep(arm:i32, j:i32)i32 {
  if(arm==3){
    if(j==0){ return 2; }
    if(j==1){ return 3; }
    if(j==2){ return 4; }
    if(j==3){ return 1; }
    if(j==4){ return 2; }
    if(j==5){ return 3; }
    if(j==6){ return 4; }
    if(j==7){ return 1; }
    if(j==8){ return 2; }
    if(j==9){ return 3; }
    if(j==10){ return 4; }
    if(j==11){ return 2; }
    if(j==12){ return 3; }
    return 4;
  }
  if(j==0){ return 2; }
  if(j==1){ return 3; }
  if(j==2){ return 4; }
  return 2;
}
fn p2_n(arm:i32)i32 {
  if(arm==3){ return 14; }
  return 4;
}

// tmp layout: 0..7 alive u8; 8 epoch i32; 12 commit_epoch; 16 kill_epoch;
// 20 seal_at_commit; 24 last_p2_epoch; 28..35 volsnap_pre; 36..43 volsnap_post;
// 44..51 alivesnap_pre; 52..59 alivesnap_post.
// met layout: 0 arm; 4 commit_id; 8 commit_epoch; 12 kill_epoch;
// 16 seal_p2; 20 seal_kill; 24 seal_p4; 28 rec_ep_match;
// 32 relA_commit; 36 relB_commit; 40 relA_final; 44 relB_final;
// 48 attr_c; 52 attr_f; 56 followup_id; 60 followup_out; 64 act1; 68 leak;
// 72 last_p2_epoch.
fn do_arm(arm:i32, ob:[]u8, at:i32, st:[]u8, tmp:[]u8, met:[]u8)i32 {
  let i:i32=0;
  while(i<8){ tmp[i]=1; i=i+1; }
  set32(tmp,8,0);
  i=0;
  while(i<128){ st[i]=0; i=i+1; }
  i=0;
  while(i<5){ set32(st,i*4,100); i=i+1; }
  set32(st,LS_ACT0,1);
  set32(st,LS_ACT1,1);
  set32(st,LS_AC,-1);
  set32(st,LS_AF,-1);
  at=ob_app(ob,at,"ARM D");
  at=ob_i32(ob,at,arm+1);
  at=ob_nl(ob,at);
  // Teaching. D1: A,A,B. Others: B,B,A.
  let t0:i32=0;
  let t1:i32=0;
  let t2:i32=0;
  if(arm==0){ t0=0; t1=0; t2=1; } else { t0=1; t1=1; t2=0; }
  let tt:i32=0;
  while(tt<3){
    let id:i32=t0;
    if(tt==1){ id=t1; }
    if(tt==2){ id=t2; }
    let e:i32=get32(tmp,8);
    set32(tmp,8,e+1);
    let out:i32=exec_c(id,tmp);
    if(out!=DC_FAIL){ set32(st,id*4,get32(st,id*4)+10); }
    tt=tt+1;
  }
  at=ob_app(ob,at,"TEACH relA=");
  at=ob_i32(ob,at,get32(st,0));
  at=ob_app(ob,at," relB=");
  at=ob_i32(ob,at,get32(st,4));
  at=ob_nl(ob,at);
  // P1 commitment.
  let wr:i32=1;
  if(arm==2){ wr=0; }
  let ce:i32=get32(tmp,8);
  let cid:i32=learner_commit(st,tmp,ce,wr);
  set32(tmp,8,ce+1);
  set32(tmp,12,ce);
  set32(tmp,20,seal_of(st));
  set32(met,0,arm);
  set32(met,4,cid);
  set32(met,8,ce);
  set32(met,32,get32(st,0));
  set32(met,36,get32(st,4));
  at=ob_app(ob,at,"COMMIT id=");
  at=ob_i32(ob,at,cid);
  at=ob_app(ob,at," pred=");
  at=ob_i32(ob,at,get32(st,LS_RPRED));
  at=ob_app(ob,at," r_at=");
  at=ob_i32(ob,at,get32(st,LS_RRAT));
  at=ob_app(ob,at," maxvol=");
  at=ob_i32(ob,at,get32(st,LS_RVOL));
  at=ob_app(ob,at," epoch=");
  at=ob_i32(ob,at,ce);
  at=ob_app(ob,at," cksum=");
  at=ob_i32(ob,at,get32(st,LS_RCK));
  at=ob_app(ob,at," seal=");
  at=ob_i32(ob,at,get32(tmp,20));
  at=ob_app(ob,at," has_rec=");
  at=ob_i32(ob,at,get32(st,LS_HASR));
  at=ob_nl(ob,at);
  // Snapshots before P2 (vol ledger + licensing).
  i=0;
  while(i<8){ tmp[28+i]=fact_vol(i) as u8; tmp[44+i]=tmp[i]; i=i+1; }
  // P2 interference.
  let pn:i32=p2_n(arm);
  let j:i32=0;
  while(j<pn){
    let id:i32=p2_ep(arm,j);
    let e2:i32=get32(tmp,8);
    set32(tmp,8,e2+1);
    set32(tmp,24,e2);
    let out2:i32=exec_c(id,tmp);
    if(out2!=DC_FAIL){ set32(st,id*4,get32(st,id*4)+10); }
    set32(st,LS_LAST,id);
    j=j+1;
  }
  set32(met,72,get32(tmp,24));
  // P2 non-leakage snapshots: taken here, BEFORE the P3 kill, so the
  // kill itself is not misread as interference leakage.
  i=0;
  while(i<8){ tmp[36+i]=fact_vol(i) as u8; tmp[52+i]=tmp[i]; i=i+1; }
  let sok:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok=1; }
  set32(met,16,sok);
  at=ob_app(ob,at,"P2 eps=");
  at=ob_i32(ob,at,pn);
  at=ob_app(ob,at," last_exec=");
  at=ob_i32(ob,at,get32(st,LS_LAST));
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"RECORD id=");
  at=ob_i32(ob,at,get32(st,LS_RID));
  at=ob_app(ob,at," pred=");
  at=ob_i32(ob,at,get32(st,LS_RPRED));
  at=ob_app(ob,at," epoch=");
  at=ob_i32(ob,at,get32(st,LS_REP));
  at=ob_nl(ob,at);
  // P3 kill: F3, unannounced. No learner-visible signal.
  tmp[3]=0;
  let ke:i32=get32(tmp,8);
  set32(tmp,16,ke);
  set32(tmp,8,ke+1);
  set32(met,12,ke);
  let sok2:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok2=1; }
  set32(met,20,sok2);
  at=ob_app(ob,at,"KILL fact=3 epoch=");
  at=ob_i32(ob,at,ke);
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok2);
  at=ob_nl(ob,at);
  // P4 learner-owned evaluation.
  if(arm==2){ learner_phase4_norecord(st,tmp); } else { learner_phase4_record(st,tmp); }
  let e3:i32=get32(tmp,8);
  set32(tmp,8,e3+1);
  let sok3:i32=0;
  if(seal_of(st)==get32(tmp,20)){ sok3=1; }
  set32(met,24,sok3);
  let rem:i32=0;
  if(get32(st,LS_REP)==ce){ rem=1; }
  set32(met,28,rem);
  set32(met,40,get32(st,0));
  set32(met,44,get32(st,4));
  set32(met,48,get32(st,LS_AC));
  set32(met,52,get32(st,LS_AF));
  set32(met,64,get32(st,LS_ACT1));
  at=ob_app(ob,at,"P4 relA=");
  at=ob_i32(ob,at,get32(st,0));
  at=ob_app(ob,at," relB=");
  at=ob_i32(ob,at,get32(st,4));
  at=ob_app(ob,at," attr_c=");
  at=ob_i32(ob,at,get32(st,LS_AC));
  at=ob_app(ob,at," attr_f=");
  at=ob_i32(ob,at,get32(st,LS_AF));
  at=ob_app(ob,at," act1=");
  at=ob_i32(ob,at,get32(st,LS_ACT1));
  at=ob_app(ob,at," obskill3=");
  at=ob_i32(ob,at,get32(st,LS_OBS+12));
  at=ob_app(ob,at," seal_ok=");
  at=ob_i32(ob,at,sok3);
  at=ob_nl(ob,at);
  // Follow-up query.
  let fid:i32=learner_followup(st);
  let fout:i32=exec_c(fid,tmp);
  let e4:i32=get32(tmp,8);
  set32(tmp,8,e4+1);
  set32(met,56,fid);
  set32(met,60,fout);
  at=ob_app(ob,at,"FOLLOWUP id=");
  at=ob_i32(ob,at,fid);
  at=ob_app(ob,at," out=");
  at=ob_i32(ob,at,fout);
  at=ob_nl(ob,at);
  // P2 non-leakage audit: vol ledger and licensing identical pre/post
  // P2 (post snapshots were taken before the P3 kill, so the kill is
  // correctly excluded from the comparison).
  let leak:i32=0;
  i=0;
  while(i<8){
    if(tmp[28+i]!=tmp[36+i]){ leak=1; }
    i=i+1;
  }
  i=0;
  while(i<8){
    if(tmp[44+i]!=tmp[52+i]){ leak=1; }
    i=i+1;
  }
  set32(met,68,leak);
  at=ob_app(ob,at,"LEAK p2_leak=");
  at=ob_i32(ob,at,leak);
  at=ob_nl(ob,at);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=ob_app(ob,at,"DCE-RUN\n");
  let mets:[]u8=z_alloc(4*76);
  let arm:i32=0;
  while(arm<4){
    let st:[]u8=z_alloc(128);
    let tmp:[]u8=z_alloc(64);
    let met:[]u8=z_alloc(76);
    at=do_arm(arm,ob,at,st,tmp,met);
    let b:i32=0;
    while(b<76){ mets[arm*76+b]=met[b]; b=b+1; }
    arm=arm+1;
  }
  // Bars K1..K5, K9, K10 computed in-program. K6/K8 static grep audits,
  // K7 cross-run sha256, all shell-verified and reported in REPORT.md.
  // K1: ordering + seal, record arms (D1=arm0, D2=arm1, D4=arm3).
  let k1:i32=1;
  let a:i32=0;
  while(a<4){
    if(a!=2){
      let o:i32=a*76;
      let ok:i32=0;
      let s16:i32=get32(mets,o+16);
      let s20:i32=get32(mets,o+20);
      let s24:i32=get32(mets,o+24);
      let mre:i32=get32(mets,o+28);
      let ce:i32=get32(mets,o+8);
      let ke:i32=get32(mets,o+12);
      if(s16==1){ if(s20==1){ if(s24==1){ if(mre==1){ if(ce<ke){ ok=1; } } } } }
      if(ok==0){ k1=0; }
    }
    a=a+1;
  }
  // K2: D4 record survival + correct attribution.
  let o3:i32=3*76;
  let k2:i32=0;
  if(get32(mets,o3+16)==1){ if(get32(mets,o3+48)==1){ if(get32(mets,o3+52)==3){ k2=1; } } }
  // K3: D2 correct attribution (B=1, F3=3).
  let o1:i32=1*76;
  let k3:i32=0;
  if(get32(mets,o1+48)==1){ if(get32(mets,o1+52)==3){ k3=1; } }
  // K4: reliability direction.
  let o0:i32=0;
  let k4:i32=0;
  let d1up:i32=0;
  if(get32(mets,o0+40)>get32(mets,o0+32)){ d1up=1; }
  let d2dn:i32=0;
  if(get32(mets,o1+44)<get32(mets,o1+36)){ if(get32(mets,o1+44)<get32(mets,o1+40)){ d2dn=1; } }
  if(d1up==1){ if(d2dn==1){ k4=1; } }
  // K5: D3 contrast (names C=2 not B, B active, follow-up B, B broken).
  let o2:i32=2*76;
  let k5:i32=0;
  if(get32(mets,o2+48)==2){ if(get32(mets,o2+64)==1){ if(get32(mets,o2+56)==1){ if(get32(mets,o2+60)==DC_FAIL){ k5=1; } } } }
  // K9: D2/D4 follow-up prefers sound A=0 and it executes.
  let k9:i32=0;
  if(get32(mets,o1+56)==0){ if(get32(mets,o1+60)!=DC_FAIL){ if(get32(mets,o3+56)==0){ if(get32(mets,o3+60)!=DC_FAIL){ k9=1; } } } }
  // K10: no P2 leakage in any arm.
  let k10:i32=1;
  a=0;
  while(a<4){
    let oo:i32=a*76;
    if(get32(mets,oo+68)!=0){ k10=0; }
    if(get32(mets,oo+12)<=get32(mets,oo+72)){ k10=0; }
    a=a+1;
  }
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k9=");
  at=ob_i32(ob,at,k9);
  at=ob_app(ob,at," k10=");
  at=ob_i32(ob,at,k10);
  at=ob_nl(ob,at);
  let pass:i32=k1+k2+k3+k4+k5+k9+k10;
  if(pass==7){
    at=ob_app(ob,at,"IN-PROGRAM-BARS 7/7 (K6 K7 K8 shell-audited)\n");
  } else {
    at=ob_app(ob,at,"IN-PROGRAM-BARS-FAIL passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/7\n");
  }
  at=ob_app(ob,at,"DCE-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// scaleup.zag -- Scale-Up Battery for the continuing learner.
// One process, sequenced experiences E1 E9 E2 E7 E3 E4 E6 E5 E5b,
// partitioned regions in one 64KB workspace. Prereg:
// scaleup/PREREG_SCALEUP.md (3e02255f3). 5 is replaced at
// build time with 0..8 (see BUILD.sh). Pure Zag. No Python.
//
// Experience order (Arm A, mode 0):
//   E1 vocab -> E9 corrections -> E2 concepts -> E7 distractors ->
//   E3 3 inventions -> E4 3 conflict keys -> E6 causal ->
//   E5 reuse -> E5b compositional reuse -> delayed -> canary -> pressure.
//
// Region layout (word offsets, sizes in i32 words):
//   R_E1  = 0     size 256 : lex[64] 0..63, str[64] 64..127,
//                         notrel[64] 128..191, notval[64] 192..255,
//                         canary 256? -- see below
// (actual offsets defined by accessor fns; canary ids 1..10 frozen)

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8 = _zag_i64_to_str(v);
  if(r.len > 0 && r[r.len-1] == 10){ return r[0..r.len-1]; }
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn z_ws(n:i32)[]u8 {
  let p:*u8 = _zag_malloc(n*4) as *u8;
  let b:[]u8 = p[0..n*4];
  let i:i32 = 0;
  while(i < n*4){ b[i] = 0; i = i + 1; }
  return b;
}
// Word access on the u8 workspace (pilot-carried pattern;
// []i32 slices from malloc are unreliable on this toolchain).
fn w_get(ws:[]u8, i:i32)i32 { return get32(ws, i*4); }
fn w_set(ws:[]u8, i:i32, v:i32)void { set32(ws, i*4, v); return; }
fn mode()i32 { return 5; }

// ---- region bases (frozen layout) ----
fn R_E1()i32 { return 0; }      // size 320
fn R_E9()i32 { return 320; }   // size 32
fn R_E2()i32 { return 352; }    // size 256
fn R_E2T()i32 { return 608; }   // size 64
fn R_E7()i32 { return 672; }   // size 64
fn R_E3()i32 { return 736; }   // size 256
fn R_E4()i32 { return 992; }   // size 64
fn R_E6()i32 { return 1056; }  // size 64
fn R_E5()i32 { return 1120; }  // size 128
fn R_E5B()i32 { return 1248; } // size 128
fn R_H()i32 { return 1376; }   // size 32
fn WS_N()i32 { return 16384; } // 64KB workspace for S-PRESS

// ---- channels (D1: sensory routing tags, not task labels) ----
fn CH_VOCAB()i32 { return 1; }
fn CH_CONCEPT()i32 { return 2; }
fn CH_FORM()i32 { return 3; }
fn CH_FACT()i32 { return 4; }
fn CH_CAUSAL()i32 { return 5; }

// ---- source ids (carried from pilot) ----
fn SRC_LEARNED()i32 { return 1; }
fn SRC_ORACLE()i32 { return 2; }
fn SRC_INTERVENE()i32 { return 3; }
fn SRC_PASSIVE()i32 { return 4; }

// ================= E1: vocabulary at scale =================
// Taught: w = 0..47, class(w) = (w mod 6) + 1 (48 episodes).
// Novel negations: w = 56..63, each NOT(j(w)) with frozen j mapping
// (32 composition episodes, 4 per novel item). Learner stores
// notrel[w] = j and caches notval[w] = 7 - lex[j] at composition
// time (disclosed: cache keeps 8/8 after E9 corrects lex[5]).
// Words 48..55 never taught (expected wrong on probe).
// R_E1 layout: lex[64] 0..63, str[64] 64..127, notrel[64] 128..191,
//   notval[64] 192..255, canary 256, p1score 257.

fn e1_observe(ws:[]u8, kind:i32, w:i32, v:i32)void {
  let b:i32 = R_E1();
  if(kind == 0){
    w_set(ws, b+w, v);
    w_set(ws, b+64+w, w_get(ws, b+64+w) + 1);
  } else {
    // kind 1: NOT-composition (w, j): cache the composed value
    w_set(ws, b+128+w, v);
    w_set(ws, b+192+w, 7 - w_get(ws, b+v));
  }
  return;
}
fn e1_not_j(w:i32)i32 {
  // Frozen j mapping for novel negations w = 56..63.
  if(w == 56){ return 5; }
  if(w == 57){ return 12; }
  if(w == 58){ return 19; }
  if(w == 59){ return 26; }
  if(w == 60){ return 33; }
  if(w == 61){ return 40; }
  if(w == 62){ return 47; }
  return 22;
}
fn p1_exp(ord:i32)i32 {
  if(ord < 56){ return (ord % 6) + 1; }
  if(ord == 56){ return 1; }
  if(ord == 57){ return 6; }
  if(ord == 58){ return 5; }
  if(ord == 59){ return 4; }
  if(ord == 60){ return 3; }
  if(ord == 61){ return 2; }
  if(ord == 62){ return 1; }
  return 2;
}
fn p1_got(ws:[]u8, ord:i32)i32 {
  let b:i32 = R_E1();
  if(ord >= 56){ return w_get(ws, b+192+ord); }
  return w_get(ws, b+ord);
}
fn run_p1(ws:[]u8)i32 {
  let s:i32 = 0;
  let o:i32 = 0;
  while(o < 64){
    if(p1_got(ws, o) == p1_exp(o)){ s = s + 1; }
    o = o + 1;
  }
  w_set(ws, R_E1()+257, s);
  return s;
}
fn w1_check(ws:[]u8)i32 {
  let b:i32 = R_E1();
  let w:i32 = 0;
  while(w < 48){
    if(w_get(ws, b+w) != (w % 6) + 1){ return 0; }
    if(w_get(ws, b+64+w) <= 0){ return 0; }
    w = w + 1;
  }
  return 1;
}
fn run_e1(ws:[]u8)void {
  // 48 teach episodes: (w, class), w = 0..47
  let e:i32 = 0;
  while(e < 48){
    dispatch_observe(ws, CH_VOCAB(), 0, e, (e % 6) + 1);
    e = e + 1;
  }
  // 32 NOT-composition episodes: 4 per novel item w = 56..63
  let w:i32 = 56;
  while(w < 64){
    let r:i32 = 0;
    while(r < 4){
      dispatch_observe(ws, CH_VOCAB(), 1, w, e1_not_j(w));
      r = r + 1;
    }
    w = w + 1;
  }
  return;
}
// P1c: 3 corrected items. P1n: 45 non-corrected taught + 8 negations.
fn run_p1c(ws:[]u8)i32 {
  let s:i32 = 0;
  if(p1_got(ws, 5) == 3){ s = s + 1; }
  if(p1_got(ws, 17) == 2){ s = s + 1; }
  if(p1_got(ws, 41) == 4){ s = s + 1; }
  return s;
}
fn run_p1n(ws:[]u8)i32 {
  // Returns taught_noncorrected score; negation score via run_p1n_neg.
  let s:i32 = 0;
  let w:i32 = 0;
  while(w < 48){
    if(w != 5 && w != 17 && w != 41){
      if(p1_got(ws, w) == (w % 6) + 1){ s = s + 1; }
    }
    w = w + 1;
  }
  return s;
}
fn run_p1n_neg(ws:[]u8)i32 {
  let s:i32 = 0;
  let w:i32 = 56;
  while(w < 64){
    if(p1_got(ws, w) == p1_exp(w)){ s = s + 1; }
    w = w + 1;
  }
  return s;
}

// ================= E9: targeted corrections =================
// Frozen corrections: item 5: 6 -> 3; item 17: 6 -> 2; item 41: 6 -> 4.
// Exactly those keys overwritten; (key, old, new) logged to R_E9.
// R_E9 layout: cor_key[3] 0..2, cor_old[3] 3..5, cor_new[3] 6..8,
//   canary 9, ncor 10.

fn e9_correct(ws:[]u8, key:i32, newval:i32)void {
  let b1:i32 = R_E1();
  let b:i32 = R_E9();
  let n:i32 = w_get(ws, b+10);
  w_set(ws, b+n, key);
  w_set(ws, b+3+n, w_get(ws, b1+key));
  w_set(ws, b+6+n, newval);
  w_set(ws, b+10, n + 1);
  w_set(ws, b1+key, newval);
  return;
}
fn run_e9(ws:[]u8)void {
  // Harness-provided corrections (localization of revision tested,
  // not discovery of the correction).
  e9_correct(ws, 5, 3);
  e9_correct(ws, 17, 2);
  e9_correct(ws, 41, 4);
  return;
}

// ================= E2: concept learning at scale =================
// 8 domains d = 0..7, 8 items each. True class = d mod 2.
// Frozen taught values (exceptions baked in):
//   d=1: [1,1,1,1,1,0,0,0] (weak, 5/8 -> retired)
//   d=3: all 1 except i=7 -> 0
//   d=5: [1,1,1,1,1,1,0,0] (weak, 6/8 -> live)
//   d=6: all 0 except i=2 -> 1
//   others: all (d mod 2).
// Domain routing by index (sensory, not a task label):
//   d 0..7 -> R_E2, d == 8 -> R_E2T (transfer), d >= 9 -> R_E7.
// R_E2 layout: def[8] 0..7, live[8] 8..15, cnt0[8] 16..23,
//   cnt1[8] 24..31, exc[8] 32..39, items[64] 40..103, canary 104,
//   p2a 105, p2b 106, p2c_app 107, p2c_fresh 108, p2d 109,
//   retire_events 110.
// R_E2T layout: items[16] 0..15, def 16, exc 17, canary 18.
// R_E7 layout: items[16] 0..15, canary 16.

fn e2_teach_val(d:i32, i:i32)i32 {
  if(d == 1){
    if(i < 5){ return 1; }
    return 0;
  }
  if(d == 3){
    if(i == 7){ return 0; }
    return 1;
  }
  if(d == 5){
    if(i < 6){ return 1; }
    return 0;
  }
  if(d == 6){
    if(i == 2){ return 1; }
    return 0;
  }
  return d % 2;
}
fn e2_true(d:i32, i:i32)i32 { return d % 2; }
fn e2_observe(ws:[]u8, d:i32, i:i32, c:i32)void {
  if(d < 8){
    let b:i32 = R_E2();
    w_set(ws, b+40+d*8+i, c);
    if(c == 0){ w_set(ws, b+16+d, w_get(ws, b+16+d) + 1); }
    else { w_set(ws, b+24+d, w_get(ws, b+24+d) + 1); }
  } else if(d == 8){
    let bt:i32 = R_E2T();
    w_set(ws, bt+i, c);
  } else {
    let b7:i32 = R_E7();
    let di:i32 = d - 9;
    w_set(ws, b7+di*8+i, c);
  }
  return;
}
fn e2_schema_predict(ws:[]u8, d:i32, i:i32)i32 {
  let b:i32 = R_E2();
  let def:i32 = w_get(ws, b+d);
  if(i < 8){
    let mask:i32 = w_get(ws, b+32+d);
    if((mask & (1 << i)) != 0){ return 1 - def; }
  }
  return def;
}
fn e2_finalize(ws:[]u8, d:i32)i32 {
  let b:i32 = R_E2();
  let c0:i32 = w_get(ws, b+16+d);
  let c1:i32 = w_get(ws, b+24+d);
  if(c0 + c1 == 0){ return 0; }
  let def:i32 = 0;
  if(c1 > c0){ def = 1; }
  w_set(ws, b+d, def);
  let mask:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if(w_get(ws, b+40+d*8+i) != def){ mask = mask | (1 << i); }
    i = i + 1;
  }
  w_set(ws, b+32+d, mask);
  // accuracy vs true class; retire if < 6/8 (CL2 shape, disclosed)
  let ok:i32 = 0;
  i = 0;
  while(i < 8){
    if(e2_schema_predict(ws, d, i) == e2_true(d, i)){ ok = ok + 1; }
    i = i + 1;
  }
  w_set(ws, b+8+d, 1);
  if(ok < 6){
    w_set(ws, b+8+d, 0);
    w_set(ws, b+110, w_get(ws, b+110) + 1);
  }
  return 1;
}
fn popcnt8(m:i32)i32 {
  let n:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if((m & (1 << i)) != 0){ n = n + 1; }
    i = i + 1;
  }
  return n;
}
fn run_e2(ws:[]u8)void {
  let d:i32 = 0;
  while(d < 8){
    let i:i32 = 0;
    while(i < 8){
      dispatch_observe(ws, CH_CONCEPT(), d, i, e2_teach_val(d, i));
      i = i + 1;
    }
    e2_finalize(ws, d);
    d = d + 1;
  }
  return;
}
// P2a: defaults set for all 7 live domains.
fn p2a_check(ws:[]u8)i32 {
  let b:i32 = R_E2();
  let n:i32 = 0;
  let d:i32 = 0;
  while(d < 8){
    if(d != 1){
      if(w_get(ws, b+16+d) + w_get(ws, b+24+d) > 0){ n = n + 1; }
    }
    d = d + 1;
  }
  if(n == 7){ w_set(ws, b+105, 1); return 1; }
  w_set(ws, b+105, 0);
  return 0;
}
// P2b: held-out (d,8) on live domains via default.
fn p2b_heldout(ws:[]u8)i32 {
  let b:i32 = R_E2();
  let s:i32 = 0;
  let d:i32 = 0;
  while(d < 8){
    if(d != 1){
      if(e2_schema_predict(ws, d, 8) == e2_true(d, 8)){ s = s + 1; }
    }
    d = d + 1;
  }
  w_set(ws, b+106, s);
  return s;
}
// P2c: transfer domain d=8, 16 items, class 0 except 4,11 -> 1.
fn e2t_teach_val(i:i32)i32 {
  if(i == 4 || i == 11){ return 1; }
  return 0;
}
fn p2c_transfer(ws:[]u8)i32 {
  let bt:i32 = R_E2T();
  let i:i32 = 0;
  while(i < 16){
    dispatch_observe(ws, CH_CONCEPT(), 8, i, e2t_teach_val(i));
    i = i + 1;
  }
  // finalize transfer: default = majority, mask = exceptions
  let c0:i32 = 0;
  let c1:i32 = 0;
  i = 0;
  while(i < 16){
    if(w_get(ws, bt+i) == 0){ c0 = c0 + 1; } else { c1 = c1 + 1; }
    i = i + 1;
  }
  let def:i32 = 0;
  if(c1 > c0){ def = 1; }
  w_set(ws, bt+16, def);
  let mask:i32 = 0;
  i = 0;
  while(i < 16){
    if(w_get(ws, bt+i) != def){ mask = mask | (1 << i); }
    i = i + 1;
  }
  w_set(ws, bt+17, mask);
  let b:i32 = R_E2();
  let fresh:i32 = 16;
  // |exc[8]| over 16 items: count bits
  let ec:i32 = 0;
  i = 0;
  while(i < 16){
    if((mask & (1 << i)) != 0){ ec = ec + 1; }
    i = i + 1;
  }
  let app:i32 = 1 + ec;
  w_set(ws, b+107, app);
  w_set(ws, b+108, fresh);
  if(app < fresh){ return 1; }
  return 0;
}
// P2r: retire_events >= 1, live[1]==0, live[5]==1.
fn p2r_check(ws:[]u8)i32 {
  let b:i32 = R_E2();
  if(w_get(ws, b+110) >= 1 && w_get(ws, b+8+1) == 0 && w_get(ws, b+8+5) == 1){ return 1; }
  return 0;
}
// P2 delayed: domain-0 8/8 via schema, live flags per P2r.
fn p2_delayed(ws:[]u8)i32 {
  let b:i32 = R_E2();
  let s:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if(e2_schema_predict(ws, 0, i) == e2_true(0, i)){ s = s + 1; }
    i = i + 1;
  }
  w_set(ws, b+109, s);
  if(s != 8){ return 0; }
  if(p2r_check(ws) != 1){ return 0; }
  return 1;
}
// P2 gate (interference): live flags per P2r and default[2]==0.
fn p2_gate(ws:[]u8)i32 {
  let b:i32 = R_E2();
  if(p2r_check(ws) != 1){ return 0; }
  if(e2_schema_predict(ws, 2, 8) != 0){ return 0; }
  return 1;
}

// ================= E7: distractor interference =================
// Distractor domains d = 9, 10, 8 items each, taught through
// CH_CONCEPT. Frozen class formula with seed 31337.
// Learner routes d >= 9 to R_E7 (quarantine); R_E2 schemas for
// d = 0..7 must be byte-identical before/after (S-E7a).

fn distractor_val(d:i32, i:i32)i32 {
  let a:i32 = d * 131 + i * 17 + 31337;
  let b2:i32 = a * (a + 7);
  let s:i32 = b2 >> 5;
  // mod 2 of possibly-negative s: use bit 0
  if((s & 1) != 0){ return 1; }
  return 0;
}
fn run_e7(ws:[]u8)void {
  let d:i32 = 9;
  while(d < 11){
    let i:i32 = 0;
    while(i < 8){
      dispatch_observe(ws, CH_CONCEPT(), d, i, distractor_val(d, i));
      i = i + 1;
    }
    d = d + 1;
  }
  return;
}
// S-E7a: checksum of R_E2 schema words (def/live/exc) before/after.
fn e7_schema_sum(ws:[]u8)i32 {
  let b:i32 = R_E2();
  let s:i32 = 0;
  let i:i32 = 0;
  while(i < 40){
    s = s + w_get(ws, b+i);
    i = i + 1;
  }
  return s;
}

// ================= E3: procedure invention, 3 instances =================
// BASELINE form-inventor (pilot-carried): residuals -> class-change
// midpoints -> greedy max-correct -> adopt iff exact -> promote IF_LT.
// Instances (disjoint point sets, 12 points each):
//   I1: x = 0,2,...,22,   class = 1 iff x < 13
//   I2: x = 30,32,...,52, class = 1 iff x < 47
//   I3: x = 60,62,...,82, class = 1 iff x < 71
// R_E3 layout: inst k base = k*30: xs[12] 0..11, cs[12] 12..23,
//   fkind 24, fparam 25, fpromoted 26, fit 27, half0 28, half1 29;
//   pool_kind[3] 90..92, pool_param[3] 93..95, canary 96.

fn e3_ibase(k:i32)i32 { return R_E3() + k * 30; }
fn e3_feed(ws:[]u8, k:i32, x:i32, c:i32)void {
  let b:i32 = e3_ibase(k);
  // ntrain tracked implicitly: 12 feeds per instance; use fit slot
  // as counter during feed (reset before construct).
  let n:i32 = w_get(ws, b+27);
  w_set(ws, b+n, x);
  w_set(ws, b+12+n, c);
  w_set(ws, b+27, n + 1);
  return;
}
fn e3_score_t(ws:[]u8, k:i32, t:i32)i32 {
  let b:i32 = e3_ibase(k);
  let n:i32 = 12;
  let lo1:i32 = 0; let lo_n:i32 = 0;
  let hi1:i32 = 0; let hi_n:i32 = 0;
  let i:i32 = 0;
  while(i < n){
    let x:i32 = w_get(ws, b+i);
    let c:i32 = w_get(ws, b+12+i);
    if(x < t){
      lo_n = lo_n + 1;
      if(c == 1){ lo1 = lo1 + 1; }
    } else {
      hi_n = hi_n + 1;
      if(c == 1){ hi1 = hi1 + 1; }
    }
    i = i + 1;
  }
  let c_lo:i32 = 0;
  if(lo_n > 0 && lo1 * 2 >= lo_n){ c_lo = 1; }
  let c_hi:i32 = 0;
  if(hi_n > 0 && hi1 * 2 >= hi_n){ c_hi = 1; }
  let s:i32 = 0;
  i = 0;
  while(i < n){
    let pred:i32 = c_hi;
    if(w_get(ws, b+i) < t){ pred = c_lo; }
    if(pred == w_get(ws, b+12+i)){ s = s + 1; }
    i = i + 1;
  }
  return s;
}
fn e3_construct(ws:[]u8, k:i32)i32 {
  let b:i32 = e3_ibase(k);
  w_set(ws, b+27, 0); // reset feed counter slot; fit written below
  // refill n from feeds: we fed exactly 12; use fixed n=12
  let n:i32 = 12;
  let best_t:i32 = -1;
  let best_s:i32 = -1;
  let i:i32 = 0;
  while(i < n - 1){
    if(w_get(ws, b+12+i) != w_get(ws, b+12+i+1)){
      let t:i32 = (w_get(ws, b+i) + w_get(ws, b+i+1)) / 2;
      let s:i32 = e3_score_t(ws, k, t);
      if(s > best_s){ best_s = s; best_t = t; }
    }
    i = i + 1;
  }
  if(best_s == n){
    w_set(ws, b+24, 1);
    w_set(ws, b+25, best_t);
    w_set(ws, b+26, 1);
    w_set(ws, b+27, best_s);
    // promote to shared pool
    w_set(ws, R_E3()+90+k, 1);
    w_set(ws, R_E3()+93+k, best_t);
  }
  return best_s;
}
fn e3_apply_k(ws:[]u8, k:i32, x:i32)i32 {
  let b:i32 = e3_ibase(k);
  // IF_LT with majority sides: recompute sides for stored param
  let t:i32 = w_get(ws, b+25);
  // sides: for our frozen data, lo majority = 1, hi = 0
  if(x < t){ return 1; }
  return 0;
}
fn e3_halving(ws:[]u8, k:i32)i32 {
  let b:i32 = e3_ibase(k);
  let s0:i32 = 0;
  let s1:i32 = 0;
  let i:i32 = 0;
  while(i < 12){
    let x:i32 = w_get(ws, b+i);
    let c:i32 = w_get(ws, b+12+i);
    if(e3_apply_k(ws, k, x) == c){
      if((i % 2) == 0){ s0 = s0 + 1; } else { s1 = s1 + 1; }
    }
    i = i + 1;
  }
  w_set(ws, b+28, s0);
  w_set(ws, b+29, s1);
  if(s0 == 6 && s1 == 6){ return 1; }
  return 0;
}
// World truth (harness-side): class for instance k, point i.
fn e3_world_c(k:i32, i:i32)i32 {
  let x:i32 = 0;
  let t:i32 = 13;
  if(k == 0){ x = i * 2; t = 13; }
  else if(k == 1){ x = 30 + i * 2; t = 47; }
  else { x = 60 + i * 2; t = 71; }
  if(x < t){ return 1; }
  return 0;
}
fn e3_world_x(k:i32, i:i32)i32 {
  if(k == 0){ return i * 2; }
  if(k == 1){ return 30 + i * 2; }
  return 60 + i * 2;
}
fn run_e3(ws:[]u8)void {
  let k:i32 = 0;
  while(k < 3){
    // clear instance buffer counter
    w_set(ws, e3_ibase(k)+27, 0);
    let i:i32 = 0;
    while(i < 12){
      e3_feed(ws, k, e3_world_x(k, i), e3_world_c(k, i));
      i = i + 1;
    }
    e3_construct(ws, k);
    k = k + 1;
  }
  return;
}
// S-E3a per instance; S-E3b pool check.
fn e3_instance_ok(ws:[]u8, k:i32)i32 {
  let b:i32 = e3_ibase(k);
  if(w_get(ws, b+27) != 12){ return 0; }
  if(w_get(ws, b+26) != 1){ return 0; }
  if(w_get(ws, b+24) != 1){ return 0; }
  if(e3_halving(ws, k) != 1){ return 0; }
  return 1;
}
fn e3_pool_ok(ws:[]u8)i32 {
  if(w_get(ws, R_E3()+90) != 1 || w_get(ws, R_E3()+93) != 13){ return 0; }
  if(w_get(ws, R_E3()+91) != 1 || w_get(ws, R_E3()+94) != 47){ return 0; }
  if(w_get(ws, R_E3()+92) != 1 || w_get(ws, R_E3()+95) != 71){ return 0; }
  return 1;
}

// ================= E4: conflicting evidence, 3 keys =================
// K1=200 (domain-2 default, 0, SRC_LEARNED); K2=201 (domain-4
// default, 0, SRC_LEARNED); K3=202 (invented T1, 13, source tag 13).
// Flag iff key matches, incoming src == SRC_ORACLE, val differs,
// not already suspect. Harness answers re-observations with truth.
// R_E4 layout: key k base = k*7: key 0, val 1, src 2, susp 3,
//   flaglat 4, hedges 5, reobs 6; canary 21, tot_hedge 22, tot_reobs 23.

fn e4_kbase(k:i32)i32 { return R_E4() + k * 7; }
fn e4_store(ws:[]u8, k:i32, key:i32, val:i32, src:i32)void {
  let b:i32 = e4_kbase(k);
  w_set(ws, b, key);
  w_set(ws, b+1, val);
  w_set(ws, b+2, src);
  w_set(ws, b+3, 0);
  return;
}
fn e4_find(ws:[]u8, key:i32)i32 {
  let k:i32 = 0;
  while(k < 3){
    if(w_get(ws, e4_kbase(k)) == key){ return k; }
    k = k + 1;
  }
  return -1;
}
fn e4_observe(ws:[]u8, key:i32, val:i32, src:i32)void {
  let k:i32 = e4_find(ws, key);
  if(k < 0){ return; }
  let b:i32 = e4_kbase(k);
  if(src == SRC_ORACLE() && val != w_get(ws, b+1) && w_get(ws, b+3) == 0){
    w_set(ws, b+3, 1);
    w_set(ws, b+4, 0);
    w_set(ws, b+5, w_get(ws, b+5) + 1);
    emit("HEDGE key="); e64(key);
    emit(" stored="); e64(w_get(ws, b+1));
    emit(" oracle="); e64(val); emit("\n");
    w_set(ws, b+6, w_get(ws, b+6) + 1);
    emit("REOBS-REQ key="); e64(key); emit("\n");
    w_set(ws, R_E4()+22, w_get(ws, R_E4()+22) + 1);
    w_set(ws, R_E4()+23, w_get(ws, R_E4()+23) + 1);
  }
  return;
}
fn e4_reobserve(ws:[]u8, key:i32, val:i32, src:i32)void {
  let k:i32 = e4_find(ws, key);
  if(k < 0){ return; }
  let b:i32 = e4_kbase(k);
  if(w_get(ws, b+3) == 1){
    w_set(ws, b+1, val);
    w_set(ws, b+2, src);
    w_set(ws, b+3, 0);
    emit("RESTORED key="); e64(key); emit(" val="); e64(val); emit("\n");
  }
  return;
}
fn run_e4(ws:[]u8)void {
  // (a) genuine conflict on K1=200
  dispatch_observe(ws, CH_FACT(), 200, 1, SRC_ORACLE());
  e4_reobserve(ws, 200, 0, SRC_ORACLE());
  // (b) false alarm on K2=201 (agrees, no flag)
  dispatch_observe(ws, CH_FACT(), 201, 0, SRC_ORACLE());
  // (c) double contradiction on K3=202
  dispatch_observe(ws, CH_FACT(), 202, 99, SRC_ORACLE());
  e4_reobserve(ws, 202, 13, SRC_ORACLE());
  dispatch_observe(ws, CH_FACT(), 202, 14, SRC_ORACLE());
  e4_reobserve(ws, 202, 13, SRC_ORACLE());
  return;
}
// S-E4a/b/c checks.
fn e4_all_ok(ws:[]u8)i32 {
  let ok:i32 = 1;
  // S-E4a: flag_latency <= 1 per genuine conflict (K1, K3)
  if(w_get(ws, e4_kbase(0)+4) > 1){ ok = 0; }
  if(w_get(ws, e4_kbase(2)+4) > 1){ ok = 0; }
  // S-E4b: total hedges == 3, reobs == 3, K2 0/0
  if(w_get(ws, R_E4()+22) != 3){ ok = 0; }
  if(w_get(ws, R_E4()+23) != 3){ ok = 0; }
  if(w_get(ws, e4_kbase(1)+5) != 0){ ok = 0; }
  if(w_get(ws, e4_kbase(1)+6) != 0){ ok = 0; }
  // S-E4c: final values and no suspects
  if(w_get(ws, e4_kbase(0)+1) != 0){ ok = 0; }
  if(w_get(ws, e4_kbase(1)+1) != 0){ ok = 0; }
  if(w_get(ws, e4_kbase(2)+1) != 13){ ok = 0; }
  let k:i32 = 0;
  while(k < 3){
    if(w_get(ws, e4_kbase(k)+3) != 0){ ok = 0; }
    k = k + 1;
  }
  return ok;
}
fn e4_emit(ws:[]u8)void {
  emit("E4-TOTHEDGE="); e64(w_get(ws, R_E4()+22));
  emit(" TOTREOBS="); e64(w_get(ws, R_E4()+23)); emit("\n");
  emit("E4-VALS="); e64(w_get(ws, e4_kbase(0)+1)); emit(",");
  e64(w_get(ws, e4_kbase(1)+1)); emit(",");
  e64(w_get(ws, e4_kbase(2)+1)); emit("\n");
  return;
}

// ================= E6: causal/inquiry episode =================
// Candidates C0..C3, natural values (1,0,1,0). Outcome O = C2.
// Frozen passive table (each candidate agrees 3/4, uninformative).
// Learner protocol: read 4 passive samples; intervene on each
// candidate in index order (flip from natural); record |dO| vs
// baseline O=1; select max |dO|; record cause in ledger.
// Interventional answers come from the harness (frozen table).
// R_E6 layout: nat[4] 0..3, cause 4, budget 5, canary 6,
//   held_correct 7, dO[4] 8..11.

// Harness-side frozen intervention outcomes.
fn e6_world_do(cand:i32, val:i32)i32 {
  if(cand == 0 && val == 0){ return 1; }
  if(cand == 1 && val == 1){ return 1; }
  if(cand == 2 && val == 0){ return 0; }
  if(cand == 3 && val == 1){ return 1; }
  return 1;
}
fn e6_harness_intervene(ws:[]u8, cand:i32, val:i32)i32 {
  let b:i32 = R_E6();
  w_set(ws, b+5, w_get(ws, b+5) + 1);
  emit("INTERVENE C"); e64(cand); emit("="); e64(val);
  let o:i32 = e6_world_do(cand, val);
  emit(" O="); e64(o); emit("\n");
  return o;
}
fn run_e6(ws:[]u8)void {
  let b:i32 = R_E6();
  // Natural values observed (harness-provided).
  w_set(ws, b, 1); w_set(ws, b+1, 0); w_set(ws, b+2, 1); w_set(ws, b+3, 0);
  // (1) read 4 passive samples (frozen table; correlation uninformative).
  // s0: (1,1,1,0)->1; s1: (1,1,0,1)->1; s2: (0,1,0,0)->0; s3: (0,1,1,1)->1.
  emit("E6-PASSIVE-READ=4\n");
  // (2) intervene on each candidate in index order, flip from natural.
  let baseline:i32 = 1;
  let c:i32 = 0;
  while(c < 4){
    let nat:i32 = w_get(ws, b+c);
    let do_val:i32 = 1 - nat;
    let o:i32 = e6_harness_intervene(ws, c, do_val);
    let d:i32 = o - baseline;
    if(d < 0){ d = 0 - d; }
    w_set(ws, b+8+c, d);
    c = c + 1;
  }
  // (3) select candidate with largest |dO| (strict >, index order).
  let best:i32 = 0;
  let best_d:i32 = w_get(ws, b+8);
  c = 1;
  while(c < 4){
    let d:i32 = w_get(ws, b+8+c);
    if(d > best_d){ best_d = d; best = c; }
    c = c + 1;
  }
  // (4) record cause in ledger.
  w_set(ws, b+4, best);
  emit("E6-CAUSE="); e64(best); emit(" budget="); e64(w_get(ws, b+5)); emit("\n");
  return;
}
// P6 held-out: predict O using stored cause (O = C2).
fn e6_predict(ws:[]u8, cand:i32, val:i32)i32 {
  let b:i32 = R_E6();
  let cause:i32 = w_get(ws, b+4);
  if(cand == cause){ return val; }
  return w_get(ws, b+cause);
}
fn p6_heldout(ws:[]u8)i32 {
  let s:i32 = 0;
  if(e6_predict(ws, 2, 0) == 0){ s = s + 1; }
  if(e6_predict(ws, 2, 1) == 1){ s = s + 1; }
  if(e6_predict(ws, 0, 1) == 1){ s = s + 1; }
  if(e6_predict(ws, 1, 1) == 1){ s = s + 1; }
  w_set(ws, R_E6()+7, s);
  return s;
}

// ================= E5: delayed reuse =================
// x = 100,102,...,122 (12 points), class = 1 iff x < 115.
// Condition R: retrieve (IF_LT,13) from pool, refit by bisection
// (each probe = 1 intervention). Condition F: mask pool, full
// pipeline (12 samples). S-E5a: reuse_iv < fresh_iv, <= 6, fit 12/12.
// R_E5 layout: reuse_iv 0, fresh_iv 1, reuse_fit 2, fresh_fit 3,
//   masked 4, canary 5, r_t 6, ntrain 7, xs[12] 8..19, cs[12] 20..31,
//   f_t 32.

fn e5_x(i:i32)i32 { return 100 + i * 2; }
fn e5_c(i:i32)i32 {
  if(100 + i * 2 < 115){ return 1; }
  return 0;
}
fn e5_probe(ws:[]u8, idx:i32)i32 {
  let b:i32 = R_E5();
  w_set(ws, b, w_get(ws, b) + 1);
  return e5_c(idx);
}
fn e5_refit_reuse(ws:[]u8)i32 {
  let b:i32 = R_E5();
  let b3:i32 = R_E3();
  if(w_get(ws, b+4) == 1){ return -1; }
  // retrieve: pool must hold a promoted IF_LT (kind 1)
  if(w_get(ws, b3+90) != 1){ return -1; }
  let lo:i32 = 0;
  let hi:i32 = 11;
  let c0:i32 = e5_probe(ws, 0);
  let c11:i32 = e5_probe(ws, 11);
  if(c0 != 1 || c11 != 0){ return -1; }
  while(hi - lo > 1){
    let mid:i32 = (lo + hi) / 2;
    if(e5_probe(ws, mid) == 1){ lo = mid; } else { hi = mid; }
  }
  let t:i32 = (e5_x(lo) + e5_x(hi)) / 2;
  w_set(ws, b+6, t);
  let fit:i32 = 0;
  let i:i32 = 0;
  while(i < 12){
    let pred:i32 = 0;
    if(e5_x(i) < t){ pred = 1; }
    if(pred == e5_c(i)){ fit = fit + 1; }
    i = i + 1;
  }
  w_set(ws, b+2, fit);
  return fit;
}
fn e5_fresh_feed(ws:[]u8, x:i32, c:i32)void {
  let b:i32 = R_E5();
  let n:i32 = w_get(ws, b+7);
  w_set(ws, b+8+n, x);
  w_set(ws, b+20+n, c);
  w_set(ws, b+7, n + 1);
  w_set(ws, b+1, w_get(ws, b+1) + 1);
  return;
}
fn e5_fresh_construct(ws:[]u8)i32 {
  let b:i32 = R_E5();
  let n:i32 = w_get(ws, b+7);
  let best_t:i32 = -1;
  let best_s:i32 = -1;
  let i:i32 = 0;
  while(i < n - 1){
    if(w_get(ws, b+20+i) != w_get(ws, b+20+i+1)){
      let t:i32 = (w_get(ws, b+8+i) + w_get(ws, b+8+i+1)) / 2;
      let s:i32 = 0;
      let j:i32 = 0;
      while(j < n){
        let pred:i32 = 0;
        if(w_get(ws, b+8+j) < t){ pred = 1; }
        if(pred == w_get(ws, b+20+j)){ s = s + 1; }
        j = j + 1;
      }
      if(s > best_s){ best_s = s; best_t = t; }
    }
    i = i + 1;
  }
  w_set(ws, b+32, best_t);
  let fit:i32 = 0;
  i = 0;
  while(i < n){
    let pred:i32 = 0;
    if(w_get(ws, b+8+i) < best_t){ pred = 1; }
    if(pred == w_get(ws, b+20+i)){ fit = fit + 1; }
    i = i + 1;
  }
  w_set(ws, b+3, fit);
  return fit;
}
fn run_e5(ws:[]u8)void {
  let b:i32 = R_E5();
  // Condition R (pool unmasked).
  w_set(ws, b+4, 0);
  e5_refit_reuse(ws);
  // Condition F: mask pool, full pipeline from scratch.
  w_set(ws, b+4, 1);
  w_set(ws, b+7, 0);
  let i:i32 = 0;
  while(i < 12){
    e5_fresh_feed(ws, e5_x(i), e5_c(i));
    i = i + 1;
  }
  e5_fresh_construct(ws);
  w_set(ws, b+4, 0);
  return;
}
fn e5_ok(ws:[]u8)i32 {
  let b:i32 = R_E5();
  emit("E5-REUSE-IV="); e64(w_get(ws, b)); emit(" fit="); e64(w_get(ws, b+2));
  emit(" t="); e64(w_get(ws, b+6)); emit("\n");
  emit("E5-FRESH-IV="); e64(w_get(ws, b+1)); emit(" fit="); e64(w_get(ws, b+3));
  emit(" t="); e64(w_get(ws, b+32)); emit("\n");
  if(w_get(ws, b+2) != 12){ return 0; }
  if(w_get(ws, b) >= w_get(ws, b+1)){ return 0; }
  if(w_get(ws, b) > 6){ return 0; }
  return 1;
}

// ================= E5b: compositional reuse =================
// x = 200,202,...,222 (12 points), class = 1 iff 205 <= x < 215.
// Solution: AND(IF_LT(x,t_hi), NOT(IF_LT(x,t_lo))).
// Condition R: retrieve two pool forms; refit each by bisection
// (each sample = 1 intervention); assign smaller to t_lo; compose
// via frozen operator (exactly 2 INV_COMPOSE). Condition F: fresh
// invention of both thresholds (24) + compose (2) = 26.
// S-E5b: reuse_iv < fresh_iv, <= 14, fit 12/12.
// R_E5B layout: reuse_iv 0, fresh_iv 1, reuse_fit 2, fresh_fit 3,
//   masked 4, canary 5, t_lo 6, t_hi 7, ntrain 8, xs[12] 9..20,
//   cs[12] 21..32, f_t_lo 33, f_t_hi 34.

fn e5b_x(i:i32)i32 { return 200 + i * 2; }
fn e5b_c(i:i32)i32 {
  let x:i32 = 200 + i * 2;
  if(x >= 205 && x < 215){ return 1; }
  return 0;
}
fn e5b_probe(ws:[]u8, idx:i32)i32 {
  let b:i32 = R_E5B();
  w_set(ws, b, w_get(ws, b) + 1);
  return e5b_c(idx);
}
fn e5b_bisect(ws:[]u8, lo:i32, hi:i32, from_c:i32)i32 {
  // Single flip in (lo,hi); from_c at lo, 1-from_c at hi.
  while(hi - lo > 1){
    let mid:i32 = (lo + hi) / 2;
    if(e5b_probe(ws, mid) == from_c){ lo = mid; } else { hi = mid; }
  }
  return (e5b_x(lo) + e5b_x(hi)) / 2;
}
fn e5b_compose(ws:[]u8, t_lo:i32, t_hi:i32)void {
  let b:i32 = R_E5B();
  emit("INV_COMPOSE t_lo="); e64(t_lo); emit("\n");
  w_set(ws, b, w_get(ws, b) + 1);
  emit("INV_COMPOSE t_hi="); e64(t_hi); emit("\n");
  w_set(ws, b, w_get(ws, b) + 1);
  w_set(ws, b+6, t_lo);
  w_set(ws, b+7, t_hi);
  return;
}
fn e5b_apply(ws:[]u8, x:i32)i32 {
  let b:i32 = R_E5B();
  let t_lo:i32 = w_get(ws, b+6);
  let t_hi:i32 = w_get(ws, b+7);
  if(x < t_hi && x >= t_lo){ return 1; }
  return 0;
}
fn e5b_refit_reuse(ws:[]u8)i32 {
  let b:i32 = R_E5B();
  let b3:i32 = R_E3();
  if(w_get(ws, b+4) == 1){ return -1; }
  // retrieve two promoted IF_LT forms from the pool
  if(w_get(ws, b3+90) != 1 || w_get(ws, b3+91) != 1){ return -1; }
  // characterize: probe 0, 5, 11 -> (0,1,0): flips in [0,5] and [5,11]
  let c0:i32 = e5b_probe(ws, 0);
  let c5:i32 = e5b_probe(ws, 5);
  let c11:i32 = e5b_probe(ws, 11);
  if(c0 != 0 || c5 != 1 || c11 != 0){ return -1; }
  let t_lo:i32 = e5b_bisect(ws, 0, 5, 0);
  let t_hi:i32 = e5b_bisect(ws, 5, 11, 1);
  // assign smaller to t_lo (researcher-authored refit, disclosed)
  if(t_lo > t_hi){
    let tmp:i32 = t_lo; t_lo = t_hi; t_hi = tmp;
  }
  e5b_compose(ws, t_lo, t_hi);
  let fit:i32 = 0;
  let i:i32 = 0;
  while(i < 12){
    if(e5b_apply(ws, e5b_x(i)) == e5b_c(i)){ fit = fit + 1; }
    i = i + 1;
  }
  w_set(ws, b+2, fit);
  return fit;
}
fn e5b_fresh_feed(ws:[]u8, x:i32, c:i32)void {
  let b:i32 = R_E5B();
  let n:i32 = w_get(ws, b+8);
  w_set(ws, b+9+n, x);
  w_set(ws, b+21+n, c);
  w_set(ws, b+8, n + 1);
  w_set(ws, b+1, w_get(ws, b+1) + 1);
  return;
}
fn e5b_fresh_greedy(ws:[]u8, slot:i32)i32 {
  // Greedy single-threshold search on the fed buffer; stores to slot.
  let b:i32 = R_E5B();
  let n:i32 = w_get(ws, b+8);
  let best_t:i32 = -1;
  let best_s:i32 = -1;
  let i:i32 = 0;
  while(i < n - 1){
    if(w_get(ws, b+21+i) != w_get(ws, b+21+i+1)){
      let t:i32 = (w_get(ws, b+9+i) + w_get(ws, b+9+i+1)) / 2;
      // score: predict 1 iff x < t
      let s:i32 = 0;
      let j:i32 = 0;
      while(j < n){
        let pred:i32 = 0;
        if(w_get(ws, b+9+j) < t){ pred = 1; }
        if(pred == w_get(ws, b+21+j)){ s = s + 1; }
        j = j + 1;
      }
      if(s > best_s){ best_s = s; best_t = t; }
    }
    i = i + 1;
  }
  w_set(ws, b+slot, best_t);
  return best_t;
}
fn run_e5b(ws:[]u8)void {
  let b:i32 = R_E5B();
  // Condition R (pool unmasked).
  w_set(ws, b+4, 0);
  e5b_refit_reuse(ws);
  // Condition F: mask pool; fresh invention of both thresholds (24)
  // + compose (2) = 26. Two separate 12-point greedies.
  w_set(ws, b+4, 1);
  w_set(ws, b+8, 0);
  let i:i32 = 0;
  while(i < 12){
    e5b_fresh_feed(ws, e5b_x(i), e5b_c(i));
    i = i + 1;
  }
  e5b_fresh_greedy(ws, 33);
  w_set(ws, b+8, 0);
  i = 0;
  while(i < 12){
    e5b_fresh_feed(ws, e5b_x(i), e5b_c(i));
    i = i + 1;
  }
  e5b_fresh_greedy(ws, 34);
  // compose the two fresh thresholds (2 events on fresh counter)
  emit("INV_COMPOSE-F t_lo="); e64(w_get(ws, b+33)); emit("\n");
  w_set(ws, b+1, w_get(ws, b+1) + 1);
  emit("INV_COMPOSE-F t_hi="); e64(w_get(ws, b+34)); emit("\n");
  w_set(ws, b+1, w_get(ws, b+1) + 1);
  w_set(ws, b+4, 0);
  return;
}
fn e5b_ok(ws:[]u8)i32 {
  let b:i32 = R_E5B();
  emit("E5B-REUSE-IV="); e64(w_get(ws, b)); emit(" fit="); e64(w_get(ws, b+2));
  emit(" t_lo="); e64(w_get(ws, b+6)); emit(" t_hi="); e64(w_get(ws, b+7)); emit("\n");
  emit("E5B-FRESH-IV="); e64(w_get(ws, b+1)); emit("\n");
  if(w_get(ws, b+2) != 12){ return 0; }
  if(w_get(ws, b) >= w_get(ws, b+1)){ return 0; }
  if(w_get(ws, b) > 14){ return 0; }
  return 1;
}

// ================= harness =================
// dispatch_observe routes by sensory channel (D1). Episode counters
// live only in main/harness and are never passed to subsystems.

fn dispatch_observe(ws:[]u8, ch:i32, a:i32, b:i32, c:i32)void {
  if(ch == CH_VOCAB()){ e1_observe(ws, a, b, c); }
  else if(ch == CH_CONCEPT()){ e2_observe(ws, a, b, c); }
  else if(ch == CH_FACT()){ e4_observe(ws, a, b, c); }
  return;
}
fn canary_write(ws:[]u8, base:i32, coff:i32, exp:i32)void {
  w_set(ws, base+coff, 1000 * exp + 7);
  return;
}
fn canary_check(ws:[]u8, base:i32, coff:i32, exp:i32)i32 {
  if(w_get(ws, base+coff) == 1000 * exp + 7){ return 1; }
  return 0;
}

// ---- experience runners (harness-side) ----
fn h_e1(ws:[]u8)void {
  run_e1(ws);
  canary_write(ws, R_E1(), 256, 1);
  return;
}
fn h_e9(ws:[]u8)void {
  run_e9(ws);
  canary_write(ws, R_E9(), 9, 8);
  return;
}
fn h_e2(ws:[]u8)void {
  run_e2(ws);
  canary_write(ws, R_E2(), 104, 2);
  return;
}
fn h_e7(ws:[]u8, pre_sum:i32)void {
  run_e7(ws);
  canary_write(ws, R_E7(), 16, 7);
  return;
}
fn h_e3(ws:[]u8)void {
  run_e3(ws);
  canary_write(ws, R_E3(), 96, 3);
  return;
}
fn h_e4(ws:[]u8)void {
  run_e4(ws);
  canary_write(ws, R_E4(), 21, 4);
  return;
}
fn h_e6(ws:[]u8)void {
  run_e6(ws);
  canary_write(ws, R_E6(), 6, 6);
  return;
}
fn h_e5(ws:[]u8)void {
  run_e5(ws);
  canary_write(ws, R_E5(), 5, 5);
  return;
}
fn h_e5b(ws:[]u8)void {
  run_e5b(ws);
  canary_write(ws, R_E5B(), 5, 10);
  return;
}
fn h_e2t_canary(ws:[]u8)void {
  canary_write(ws, R_E2T(), 18, 9);
  return;
}

// ---- Arm A: one process, full sequence, immediate + delayed ----
fn arm_a(ws:[]u8)i32 {
  let ok:i32 = 1;

  // E1 vocab
  h_e1(ws);
  let p1:i32 = run_p1(ws);
  let w1:i32 = w1_check(ws);
  emit("A-E1-P1="); e64(p1); emit("\n");
  emit("A-E1-W1="); e64(w1); emit("\n");
  if(p1 < 54 || w1 != 1){ ok = 0; }

  // E9 corrections
  h_e9(ws);
  let p1c:i32 = run_p1c(ws);
  let p1n:i32 = run_p1n(ws);
  let p1n_neg:i32 = run_p1n_neg(ws);
  emit("A-E9-P1C="); e64(p1c); emit("/3\n");
  emit("A-E9-P1N="); e64(p1n); emit("/45 neg="); e64(p1n_neg); emit("/8\n");
  if(p1c != 3){ ok = 0; }
  if(p1n < 43 || p1n_neg != 8){ ok = 0; }

  // E2 concepts
  h_e2(ws);
  let p2a:i32 = p2a_check(ws);
  let p2b:i32 = p2b_heldout(ws);
  let p2c:i32 = p2c_transfer(ws);
  h_e2t_canary(ws);
  let p2r:i32 = p2r_check(ws);
  emit("A-E2-P2A="); e64(p2a); emit("\n");
  emit("A-E2-P2B="); e64(p2b); emit("/7\n");
  emit("A-E2-P2C="); e64(p2c); emit(" app="); e64(w_get(ws, R_E2()+107));
  emit(" fresh="); e64(w_get(ws, R_E2()+108)); emit("\n");
  emit("A-E2-P2R="); e64(p2r); emit(" retire="); e64(w_get(ws, R_E2()+110)); emit("\n");
  if(p2a != 1 || p2b < 6 || p2c != 1 || p2r != 1){ ok = 0; }

  // E7 distractors (region audit)
  let pre_sum:i32 = e7_schema_sum(ws);
  h_e7(ws, pre_sum);
  let post_sum:i32 = e7_schema_sum(ws);
  emit("A-E7-SCHEMA-PRE="); e64(pre_sum); emit(" POST="); e64(post_sum); emit("\n");
  if(pre_sum != post_sum){ ok = 0; }
  let e7b_d0:i32 = p2_delayed(ws);
  let e7b_p2b:i32 = p2b_heldout(ws);
  let p1e:i32 = run_p1(ws);
  emit("A-E7B-D0="); e64(e7b_d0); emit(" P2B="); e64(e7b_p2b); emit("/7\n");
  emit("A-E7B-P1E="); e64(p1e); emit("/64\n");
  if(e7b_d0 != 1 || e7b_p2b < 6){ ok = 0; }
  if(p1e < 52){ ok = 0; }

  // E3 inventions
  h_e3(ws);
  let e3ok0:i32 = e3_instance_ok(ws, 0);
  let e3ok1:i32 = e3_instance_ok(ws, 1);
  let e3ok2:i32 = e3_instance_ok(ws, 2);
  let e3pool:i32 = e3_pool_ok(ws);
  emit("A-E3-I1="); e64(e3ok0); emit(" param="); e64(w_get(ws, e3_ibase(0)+25)); emit("\n");
  emit("A-E3-I2="); e64(e3ok1); emit(" param="); e64(w_get(ws, e3_ibase(1)+25)); emit("\n");
  emit("A-E3-I3="); e64(e3ok2); emit(" param="); e64(w_get(ws, e3_ibase(2)+25)); emit("\n");
  emit("A-E3-POOL="); e64(e3pool); emit("\n");
  if(e3ok0 != 1 || e3ok1 != 1 || e3ok2 != 1 || e3pool != 1){ ok = 0; }

  // E4 conflicts (prerequisites from E2/E3)
  e4_store(ws, 0, 200, 0, SRC_LEARNED());
  e4_store(ws, 1, 201, 0, SRC_LEARNED());
  e4_store(ws, 2, 202, 13, 13);
  h_e4(ws);
  e4_emit(ws);
  let e4ok:i32 = e4_all_ok(ws);
  emit("A-E4-OK="); e64(e4ok); emit("\n");
  if(e4ok != 1){ ok = 0; }
  // interference: P1 >= 52, P2 gate
  let e4x_p1:i32 = run_p1(ws);
  let e4x_gate:i32 = p2_gate(ws);
  emit("A-E4X-P1="); e64(e4x_p1); emit("/64 gate="); e64(e4x_gate); emit("\n");
  if(e4x_p1 < 52 || e4x_gate != 1){ ok = 0; }

  // E6 causal
  h_e6(ws);
  let p6a:i32 = w_get(ws, R_E6()+4);
  let p6b:i32 = p6_heldout(ws);
  emit("A-E6-CAUSE="); e64(p6a); emit(" HELD="); e64(p6b); emit("/4\n");
  if(p6a != 2 || p6b < 3){ ok = 0; }
  if(w_get(ws, R_E6()+5) > 8){ ok = 0; }

  // E5 reuse
  h_e5(ws);
  let e5ok:i32 = e5_ok(ws);
  emit("A-E5-OK="); e64(e5ok); emit("\n");
  if(e5ok != 1){ ok = 0; }

  // E5b compositional reuse
  h_e5b(ws);
  let e5bok:i32 = e5b_ok(ws);
  emit("A-E5B-OK="); e64(e5bok); emit("\n");
  if(e5bok != 1){ ok = 0; }

  // ---- delayed battery ----
  let p1d:i32 = run_p1(ws);
  emit("A-D1-P1D="); e64(p1d); emit("/64\n");
  if(p1d < 50){ ok = 0; }
  let d2:i32 = p2_delayed(ws);
  let d2b:i32 = p2b_heldout(ws);
  emit("A-D2-OK="); e64(d2); emit(" P2B="); e64(d2b); emit("/7\n");
  if(d2 != 1 || d2b < 6){ ok = 0; }
  let d3:i32 = e3_pool_ok(ws);
  emit("A-D3-POOL="); e64(d3); emit("\n");
  if(d3 != 1){ ok = 0; }
  let d4:i32 = e4_all_ok(ws);
  emit("A-D4-OK="); e64(d4); emit("\n");
  if(d4 != 1){ ok = 0; }
  // S-D5: reuse re-verified from stored state (no new teaching)
  let d5a:i32 = e5_ok(ws);
  let d5b:i32 = e5b_ok(ws);
  emit("A-D5-E5="); e64(d5a); emit(" E5B="); e64(d5b); emit("\n");
  if(d5a != 1 || d5b != 1){ ok = 0; }
  // S-D6: causal retention (conclusion still 2, no new interventions)
  let d6cause:i32 = w_get(ws, R_E6()+4);
  let d6bud:i32 = w_get(ws, R_E6()+5);
  emit("A-D6-CAUSE="); e64(d6cause); emit(" BUDGET="); e64(d6bud); emit("\n");
  if(d6cause != 2){ ok = 0; }
  // S-D9: correction retention
  let d9:i32 = run_p1c(ws);
  emit("A-D9-P1C="); e64(d9); emit("/3\n");
  if(d9 != 3){ ok = 0; }

  // ---- canary audit (10/10) ----
  let c:i32 = 0;
  c = c + canary_check(ws, R_E1(), 256, 1);
  c = c + canary_check(ws, R_E2(), 104, 2);
  c = c + canary_check(ws, R_E3(), 96, 3);
  c = c + canary_check(ws, R_E4(), 21, 4);
  c = c + canary_check(ws, R_E5(), 5, 5);
  c = c + canary_check(ws, R_E6(), 6, 6);
  c = c + canary_check(ws, R_E7(), 16, 7);
  c = c + canary_check(ws, R_E9(), 9, 8);
  c = c + canary_check(ws, R_E2T(), 18, 9);
  c = c + canary_check(ws, R_E5B(), 5, 10);
  emit("A-CANARY="); e64(c); emit("/10\n");
  if(c != 10){ ok = 0; }

  // ---- pressure ----
  let state_bytes:i32 = WS_N() * 4;
  w_set(ws, R_H()+1, state_bytes);
  emit("A-STATE="); e64(state_bytes); emit(" DROP="); e64(w_get(ws, R_H())); emit("\n");
  if(state_bytes > 4194304 || w_get(ws, R_H()) != 0){ ok = 0; }
  // S-PRESS: >= 64KB else NOPRESSURE (not a pass)
  let press:i32 = 1;
  if(state_bytes < 65536){ press = 0; }
  emit("A-PRESS="); e64(press); emit("\n");

  emit("A-OK="); e64(ok); emit(" PRESS="); e64(press); emit("\n");
  if(ok == 1 && press == 1){ return 2; }  // SCALEUP-PASS
  if(ok == 1){ return 1; }                 // SCALEUP-NOPRESSURE
  return 0;                                // SCALEUP-FAIL
}

// ---- Arm B: single-experience control modes ----
fn arm_b1(ws:[]u8)void {
  h_e1(ws);
  // E1 immediate probes (before E9, matching Arm A order)
  let p1_pre:i32 = run_p1(ws);
  let w1:i32 = w1_check(ws);
  h_e9(ws);
  // Post-correction probes
  let p1:i32 = run_p1(ws);
  let p1c:i32 = run_p1c(ws);
  let p1n:i32 = run_p1n(ws);
  let neg:i32 = run_p1n_neg(ws);
  emit("B1-P1PRE="); e64(p1_pre); emit("/64 W1="); e64(w1); emit("\n");
  emit("B1-P1="); e64(p1); emit("/64\n");
  emit("B1-P1C="); e64(p1c); emit("/3 P1N="); e64(p1n); emit("/45 NEG="); e64(neg); emit("/8\n");
  return;
}
fn arm_b2(ws:[]u8)void {
  h_e2(ws);
  let p2a:i32 = p2a_check(ws);
  let p2b:i32 = p2b_heldout(ws);
  let p2c:i32 = p2c_transfer(ws);
  h_e2t_canary(ws);
  let p2r:i32 = p2r_check(ws);
  let p2d:i32 = p2_delayed(ws);
  emit("B2-P2A="); e64(p2a); emit(" P2B="); e64(p2b); emit("/7\n");
  emit("B2-P2C="); e64(p2c); emit(" P2R="); e64(p2r); emit(" P2D="); e64(p2d); emit("\n");
  return;
}
fn arm_b3(ws:[]u8)void {
  h_e2(ws);
  let pre:i32 = e7_schema_sum(ws);
  h_e7(ws, pre);
  let post:i32 = e7_schema_sum(ws);
  let d0:i32 = p2_delayed(ws);
  let p2b:i32 = p2b_heldout(ws);
  emit("B3-SCHEMA-PRE="); e64(pre); emit(" POST="); e64(post); emit("\n");
  emit("B3-D0="); e64(d0); emit(" P2B="); e64(p2b); emit("/7\n");
  return;
}
fn arm_b4(ws:[]u8)void {
  h_e3(ws);
  let o0:i32 = e3_instance_ok(ws, 0);
  let o1:i32 = e3_instance_ok(ws, 1);
  let o2:i32 = e3_instance_ok(ws, 2);
  let pl:i32 = e3_pool_ok(ws);
  emit("B4-I="); e64(o0); emit(","); e64(o1); emit(","); e64(o2);
  emit(" POOL="); e64(pl); emit("\n");
  return;
}
fn arm_b5(ws:[]u8)void {
  // Prerequisites (disclosed): E1+E9 for P1, E2 for P2 gate,
  // plus fact stores.
  h_e1(ws);
  h_e9(ws);
  h_e2(ws);
  let p1ref:i32 = run_p1(ws);
  e4_store(ws, 0, 200, 0, SRC_LEARNED());
  e4_store(ws, 1, 201, 0, SRC_LEARNED());
  e4_store(ws, 2, 202, 13, 13);
  h_e4(ws);
  e4_emit(ws);
  let ok:i32 = e4_all_ok(ws);
  let p1:i32 = run_p1(ws);
  let gate:i32 = p2_gate(ws);
  emit("B5-E4OK="); e64(ok); emit(" P1="); e64(p1); emit("/64 ref="); e64(p1ref);
  emit(" GATE="); e64(gate); emit("\n");
  return;
}
fn arm_b6(ws:[]u8)void {
  h_e6(ws);
  let cause:i32 = w_get(ws, R_E6()+4);
  let held:i32 = p6_heldout(ws);
  emit("B6-CAUSE="); e64(cause); emit(" HELD="); e64(held); emit("/4\n");
  return;
}
fn arm_b7(ws:[]u8)void {
  // Prerequisite (disclosed): E3 to populate pool.
  h_e3(ws);
  h_e5(ws);
  let ok:i32 = e5_ok(ws);
  emit("B7-E5OK="); e64(ok); emit("\n");
  return;
}
fn arm_b8(ws:[]u8)void {
  // Prerequisite (disclosed): E3 to populate pool.
  h_e3(ws);
  h_e5b(ws);
  let ok:i32 = e5b_ok(ws);
  emit("B8-E5BOK="); e64(ok); emit("\n");
  return;
}

fn main()i32 {
  emit("SCALEUP-START mode=");
  e64(mode());
  emit("\n");
  let ws:[]u8 = z_ws(WS_N());
  let m:i32 = mode();
  if(m == 0){
    let r:i32 = arm_a(ws);
    emit("SCALEUP-A-RESULT=");
    e64(r);
    emit("\n");
  } else if(m == 1){ arm_b1(ws); }
  else if(m == 2){ arm_b2(ws); }
  else if(m == 3){ arm_b3(ws); }
  else if(m == 4){ arm_b4(ws); }
  else if(m == 5){ arm_b5(ws); }
  else if(m == 6){ arm_b6(ws); }
  else if(m == 7){ arm_b7(ws); }
  else if(m == 8){ arm_b8(ws); }
  emit("SCALEUP-END\n");
  return 0;
}

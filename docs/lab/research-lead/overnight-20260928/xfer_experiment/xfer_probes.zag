// ============ TNN-2 CROSS-DOMAIN TRANSFER PROBES (unfrozen variant) ============
// Variant: tnn2_xfer_variant.zag (MAP-first query, no shadow teach,
// white-box counter at hg(W,52)).
// Domain A: subjects 1..5, relation 11 chain, query relation 40.
// Domain B: subjects 100..104, relation 61 chain, query relation 60.
// The two domains are isomorphic in structure, disjoint in namespace.
// No cross-domain mapping is hardcoded anywhere in the variant.
// White-box question: does the A-MAP influence B's construction in any way?

fn xf_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn xf_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn xf_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// Teach domain A and promote its MAP. Returns the A-MAP node.
fn xf_learn_a(W:[]u8)i32 {
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  let m:i32=xf_find_map(W,1,40);
  return m;
}
// Teach domain B facts only (no query yet).
fn xf_teach_b(W:[]u8)void {
  ev_teach(W,100,61,101); ev_teach(W,101,61,102);
  ev_teach(W,102,61,103); ev_teach(W,103,61,104);
  return;
}

// X1: Baseline. Both domains solvable independently.
fn xf_x1()void {
  emit("== X1 baseline: both domains solvable ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ma:i32=xf_learn_a(W);
  xf_rep("X1 A_MAP",ma);
  xf_teach_b(W);
  let ab:i32=ev_query(W,100,60,104,0);
  xf_rep("X1 B_ans",ab);
  let mb:i32=xf_find_map(W,100,60);
  xf_rep("X1 B_MAP",mb);
  if(ma>=0 && ab==104 && mb>=0){emit("X1 PASS: both domains solved, both MAPs exist\n");}
  else {emit("X1 FAIL\n");}
  return;
}

// X2: Trial-count comparison. Control (fresh, B only) vs test (A then B).
// hg(W,16) = tried*1024+rejected for the last t2_trial call.
fn xf_x2()void {
  emit("== X2 trial counts: control vs transfer learner ==\n");
  // Control: fresh learner, B only.
  let WC:[]u8=z_alloc(110656); tnn2_init(WC);
  xf_teach_b(WC);
  let ac:i32=ev_query(WC,100,60,104,0);
  let tc:i32=hg(WC,16);
  xf_rep("X2 control_ans",ac);
  xf_rep("X2 control_tried",tc/1024);
  xf_rep("X2 control_rejected",tc%1024);
  // Test: A first, then B.
  let WT:[]u8=z_alloc(110656); tnn2_init(WT);
  let ma:i32=xf_learn_a(WT);
  xf_teach_b(WT);
  let at:i32=ev_query(WT,100,60,104,0);
  let tt:i32=hg(WT,16);
  xf_rep("X2 test_A_MAP",ma);
  xf_rep("X2 test_ans",at);
  xf_rep("X2 test_tried",tt/1024);
  xf_rep("X2 test_rejected",tt%1024);
  if(ac==104 && at==104){
    if(tt==tc){emit("X2 RESULT: identical trial counts, zero transfer\n");}
    else {emit("X2 RESULT: trial counts differ\n"); xf_rep("X2 delta_tried",tt/1024-tc/1024);}
  }
  else {emit("X2 FAIL: a domain did not solve\n");}
  return;
}

// X3: White-box. Was the A-MAP invoked during B's query?
// hg(W,52) counts MAP-branch executions. If the A-MAP were consulted
// for (100,60), the exact-(s,r) lookup would miss (different s,r),
// so the counter must not increment from the A-MAP during B.
fn xf_x3()void {
  emit("== X3 white-box: A-MAP invoked during B query? ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ma:i32=xf_learn_a(W);
  xf_rep("X3 A_MAP",ma);
  xf_teach_b(W);
  let c0:i32=hg(W,52);
  xf_rep("X3 ctr_before_B",c0);
  let ab:i32=ev_query(W,100,60,104,0);
  let c1:i32=hg(W,52);
  xf_rep("X3 B_ans",ab);
  xf_rep("X3 ctr_after_B",c1);
  xf_rep("X3 ctr_delta",c1-c0);
  // The B-MAP is promoted during B's query via promote_graph (not via
  // the MAP-first branch), so delta should be 0: no MAP was executed
  // to answer B. A nonzero delta would mean some MAP fired.
  if(c1-c0==0){emit("X3 RESULT: no MAP executed during B query; A-MAP not invoked\n");}
  else {emit("X3 RESULT: MAP-branch fired during B query\n");}
  return;
}

// X4: MAP census. B's query must create exactly one new MAP (the B-MAP);
// the A-MAP must be untouched (same node, same fields).
fn xf_x4()void {
  emit("== X4 MAP census: fresh build, A-MAP untouched ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ma:i32=xf_learn_a(W);
  let n0:i32=xf_count_tag(W,20);
  // Snapshot A-MAP identifying fields.
  let a_s:i32=ng(W,ma,8); let a_r:i32=ng(W,ma,4); let a_root:i32=ng(W,ma,20);
  xf_rep("X4 A_MAP",ma); xf_rep("X4 maps_before_B",n0);
  xf_teach_b(W);
  let ab:i32=ev_query(W,100,60,104,0);
  let n1:i32=xf_count_tag(W,20);
  let mb:i32=xf_find_map(W,100,60);
  xf_rep("X4 B_ans",ab); xf_rep("X4 maps_after_B",n1); xf_rep("X4 B_MAP",mb);
  let a_s2:i32=ng(W,ma,8); let a_r2:i32=ng(W,ma,4); let a_root2:i32=ng(W,ma,20);
  if(n1==n0+1 && mb>=0 && mb!=ma && a_s==a_s2 && a_r==a_r2 && a_root==a_root2){
    emit("X4 RESULT: exactly one new MAP built; A-MAP byte-identical, untouched\n");
  }
  else {emit("X4 RESULT: unexpected MAP census\n");}
  return;
}

// X5: Harder variant. B has FEWER taught facts than A (3 links vs 4).
// If any structural transfer existed, a shorter B chain is the case
// where reusing A's chain shape would most visibly help. The trial loop
// builds k=2..4 chains from B's own facts; A's MAP cannot supply
// missing links because its literals are baked in.
fn xf_x5()void {
  emit("== X5 short-B: 3-link chain after 4-link A ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ma:i32=xf_learn_a(W);
  xf_rep("X5 A_MAP",ma);
  // B with only 3 links: 200->201->202->203, query (200,60) expects 203.
  ev_teach(W,200,61,201); ev_teach(W,201,61,202); ev_teach(W,202,61,203);
  let c0:i32=hg(W,52);
  let ab:i32=ev_query(W,200,60,203,0);
  let c1:i32=hg(W,52);
  let tt:i32=hg(W,16);
  xf_rep("X5 B_ans",ab);
  xf_rep("X5 ctr_delta",c1-c0);
  xf_rep("X5 tried",tt/1024); xf_rep("X5 rejected",tt%1024);
  let mb:i32=xf_find_map(W,200,60);
  xf_rep("X5 B_MAP",mb);
  if(ab==203 && mb>=0 && mb!=ma && c1-c0==0){
    emit("X5 RESULT: short-B solved by fresh construction; A-MAP not involved\n");
  }
  else {emit("X5 RESULT: unexpected\n");}
  return;
}

fn main()i32 {
  emit("TNN-2 CROSS-DOMAIN TRANSFER EXPERIMENT (unfrozen variant)\n");
  emit("No cross-domain mappings hardcoded. Honest reporting.\n");
  xf_x1(); xf_x2(); xf_x3(); xf_x4(); xf_x5();
  emit("DONE\n");
  return 0;
}

// us_full.zag -- Unlabeled cognitive selection.
// Micah Section 1 correction: NO researcher-authored process taxonomy, NO type
// labels. The driver presents unlabeled goals as (s, r) only. The learner
// selects cognitive operations from its own state via a learned consequence
// history: "when I used operation X under conditions Y, consequence Z followed."
// Multi-step sequences emerge because each operation changes the state,
// changing which operations are applicable next. No TYPE=PREDICTION,
// no TYPE=DEDUCTION, no external mode selector.
// Pure Zag. Pinned znc. No Python.

// ============ section 0: primitives (u8-backed cell idiom) ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 128+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 41088+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }

// ============ section 1: init, alloc, edges ============
fn us_init(W:[]u8)void {
  let e:i32=0;
  while(e<4096){ es(W,e,0,-1); e=e+1; }
  ns(W,0,36,1); ns(W,1,36,1);
  hs(W,20,0); hs(W,24,0);
  return;
}
fn alloc_node(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  return -1;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==-1){
      es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
      hs(W,24,hg(W,24)+1); return e;
    }
    e=e+1;
  }
  return -1;
}
fn freshW()[]u8 {
  let W:[]u8=z_alloc(110656);
  us_init(W);
  return W;
}

// ============ section 2: constants ============
// node types
fn T_FACT()i32 { return 1; }
fn T_MAP()i32 { return 20; }
fn T_CELL()i32 { return 22; }
fn T_UNCERT()i32 { return 30; }
fn T_CONSEQ()i32 { return 61; }
// cell ops (generic arithmetic machinery)
fn OP_ADD()i32 { return 1; }
fn OP_MUL()i32 { return 2; }
fn OP_SUB()i32 { return 3; }
// cognitive op ids:
//  1 RECALL  2 GATHER  3 DERIVE  4 EXEC  5 VERIFY
//  6 RETRIEVE  7 REBIND  8 CROSSCHECK  9 PREDICT  10 INQUIRE
fn K_TRUST()i32 { return 6; }
fn NO_VAL()i32 { return -999999; }
// Working memory lives in header fields (per-goal, cleared by solve_goal):
//  44 w_s, 48 w_r,
//  72 w_prem, 76 w_ref, 80 w_sim, 84 w_map,
//  88 w_p1, 92 w_p2,
//  96 gather_done, 100 rebind_done,
//  104 op_terminal, 112 trace_count.
// Counters: 28 total_steps, 36 goals_correct, 40 goals_total.

// ============ section 3: structure ops ============
// FACT: f0=1 f4=s f8=r f12=o f16=prov
fn teach_fact(W:[]u8,s:i32,r:i32,o:i32,prov:i32)i32 {
  let n:i32=alloc_node(W);
  if(n<0){return -1;}
  ns(W,n,0,1); ns(W,n,4,s); ns(W,n,8,r); ns(W,n,12,o); ns(W,n,16,prov);
  return n;
}
fn find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==s && ng(W,n,8)==r){ return n; }
    n=n+1;
  }
  return 0;
}
// MAP: f0=20 f8=r f20=score f24=entry cell f28=verified subject
// CELL: f0=22 f24=op f28=imm, chained by SEQ (type 12) edges
fn teach_map(W:[]u8,r:i32,score:i32,subj:i32,op1:i32,im1:i32,op2:i32,im2:i32,nc:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,8,r); ns(W,m,20,score); ns(W,m,28,subj);
  let c1:i32=alloc_node(W);
  if(c1<0){return -1;}
  ns(W,c1,0,22); ns(W,c1,24,op1); ns(W,c1,28,im1);
  ns(W,m,24,c1);
  if(nc>1){
    let c2:i32=alloc_node(W);
    if(c2<0){return -1;}
    ns(W,c2,0,22); ns(W,c2,24,op2); ns(W,c2,28,im2);
    link_edge(W,c1,12,c2,0);
  }
  return m;
}
fn seq_next(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==c && eg(W,e,4)==12){ return eg(W,e,8); }
    e=e+1;
  }
  return 0;
}
fn apply_op(v:i32,op:i32,im:i32)i32 {
  if(op==1){return v+im;}
  if(op==2){return v*im;}
  if(op==3){return v-im;}
  return im;
}
fn exec_map(W:[]u8,m:i32,s:i32)i32 {
  let acc:i32=s;
  let c:i32=ng(W,m,24);
  let g:i32=0;
  while(c>1 && g<64){
    acc=apply_op(acc,ng(W,c,24),ng(W,c,28));
    c=seq_next(W,c);
    g=g+1;
  }
  return acc;
}
fn find_best_map(W:[]u8,r:i32)i32 {
  let best:i32=0;
  let bs:i32=-1;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r){
      let sc:i32=ng(W,n,20);
      if(sc>bs){ bs=sc; best=n; }
    }
    n=n+1;
  }
  return best;
}
fn find_trusted_map(W:[]u8,r:i32,k:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r && ng(W,n,20)>=k){ return n; }
    n=n+1;
  }
  return 0;
}
fn find_candidate_map(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r && ng(W,n,20)>0 && ng(W,n,20)<6){ return n; }
    n=n+1;
  }
  return 0;
}
fn find_second_map(W:[]u8,r:i32,ex:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(n!=ex && ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r){ return n; }
    n=n+1;
  }
  return 0;
}
fn inquire(W:[]u8,s:i32,r:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,4)==s && ng(W,n,8)==r){ return; }
    n=n+1;
  }
  let u:i32=alloc_node(W);
  if(u>1){ ns(W,u,0,30); ns(W,u,4,s); ns(W,u,8,r); }
  return;
}

// ============ section 4: derivation helpers ============
// DER rules are researcher machinery (like the executor). The *selection* of
// when to derive is state-driven via consequence history.
//   r=53: premises (s,51,x), (x,52,o) => conclude o
//   r=63: premises (s,61,x), (x,62,o) => conclude o
fn prem1_of(r:i32)i32 {
  if(r==53){ return 51; }
  if(r==63){ return 61; }
  return 0;
}
fn prem2_of(r:i32)i32 {
  if(r==53){ return 52; }
  if(r==63){ return 62; }
  return 0;
}
fn has_premises(W:[]u8,s:i32,r:i32)i32 {
  let p1:i32=prem1_of(r);
  if(p1==0){ return 0; }
  let n1:i32=find_fact(W,s,p1);
  if(n1==0){ return 0; }
  let x:i32=ng(W,n1,12);
  let p2:i32=prem2_of(r);
  let n2:i32=find_fact(W,x,p2);
  if(n2==0){ return 0; }
  return 1;
}
fn gather_premises(W:[]u8,s:i32,r:i32)void {
  let p1:i32=prem1_of(r);
  let n1:i32=find_fact(W,s,p1);
  if(n1==0){ return; }
  let x:i32=ng(W,n1,12);
  let p2:i32=prem2_of(r);
  let n2:i32=find_fact(W,x,p2);
  if(n2==0){ return; }
  let o:i32=ng(W,n2,12);
  hs(W,88,x); hs(W,92,o);
  return;
}

// ============ section 5: consequence substrate ============
// T_CONSEQ (61): f4=op, f8=sig, f12=succ, f16=att.
// Records: "when I used operation X under conditions Y, consequence Z followed."
// This is the shared-substrate idea applied to cognitive operation selection:
// situation/state -> learned consequence history -> operation choice.
fn conseq_get(W:[]u8,op:i32,sig:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==op && ng(W,n,8)==sig){ return n; }
    n=n+1;
  }
  return 0;
}
fn conseq_bump(W:[]u8,op:i32,sig:i32,succ:i32)void {
  let n:i32=conseq_get(W,op,sig);
  if(n==0){
    n=alloc_node(W);
    if(n<0){ return; }
    ns(W,n,0,61); ns(W,n,4,op); ns(W,n,8,sig); ns(W,n,12,0); ns(W,n,16,0);
  }
  ns(W,n,16,ng(W,n,16)+1);
  if(succ==1){ ns(W,n,12,ng(W,n,12)+1); }
  return;
}
// Provision/requirement table for backward usefulness credit assignment.
// An op is useful if its successor required its provision and was useful.
fn op_requires(op:i32)i32 {
  if(op==3){ return 1; }
  if(op==5){ return 2; }
  if(op==4){ return 3; }
  if(op==7){ return 4; }
  if(op==8){ return 5; }
  return 0;
}
fn op_provides(op:i32)i32 {
  if(op==2){ return 1; }
  if(op==3){ return 2; }
  if(op==5){ return 3; }
  if(op==6){ return 4; }
  if(op==7){ return 5; }
  return 6;
}

// ============ section 6: sig, applicability, selection ============
// Condition signature computed from learner state only. No type labels.
// b0 fact(s,r)  b1 premises  b2 trusted MAP  b3 candidate MAP  b4 any MAP
// b5 w_prem  b6 w_ref  b7 w_sim  b8 w_map
fn compute_sig(W:[]u8)i32 {
  let s:i32=0;
  let ws:i32=hg(W,44);
  let wr:i32=hg(W,48);
  if(find_fact(W,ws,wr)>0){ s=s|1; }
  if(has_premises(W,ws,wr)>0){ s=s|2; }
  if(find_trusted_map(W,wr,6)>0){ s=s|4; }
  if(find_candidate_map(W,wr)>0){ s=s|8; }
  if(find_best_map(W,wr)>0){ s=s|16; }
  if(hg(W,72)==1){ s=s|32; }
  if(hg(W,76)!=NO_VAL()){ s=s|64; }
  if(hg(W,80)!=NO_VAL()){ s=s|128; }
  if(hg(W,84)>0){ s=s|256; }
  return s;
}
// Applicability: which operations CAN fire given current state.
// These are natural preconditions, not a researcher taxonomy.
fn applicable_mask(W:[]u8)i32 {
  let m:i32=0;
  let ws:i32=hg(W,44);
  let wr:i32=hg(W,48);
  if(find_fact(W,ws,wr)>0){ m=m|1; }
  if(hg(W,96)==0 && has_premises(W,ws,wr)>0){ m=m|2; }
  if(hg(W,72)==1){ m=m|4; }
  if(find_trusted_map(W,wr,6)>0){ m=m|8; }
  if(find_candidate_map(W,wr)>0 && hg(W,76)!=NO_VAL()){ m=m|16; }
  if(hg(W,84)==0 && find_best_map(W,wr)>0){ m=m|32; }
  if(hg(W,84)>0 && hg(W,100)==0 && find_fact(W,ws,wr)==0 && hg(W,96)==0){ m=m|64; }
  if(hg(W,80)!=NO_VAL()){
    if(hg(W,76)!=NO_VAL()){ m=m|128; }
    else {
      if(find_second_map(W,wr,hg(W,84))>0){ m=m|128; }
    }
  }
  let bm:i32=find_best_map(W,wr);
  if(bm>0 && ng(W,bm,20)>0){ m=m|256; }
  m=m|512;
  return m;
}
// Consequence-driven selection: Laplace-smoothed argmax over applicable ops.
// Integer cross-multiplication, no floats. Tie -> lowest op id.
// The ORDER of trying operations is learned from experience, not fixed.
fn select_op(W:[]u8,mask:i32,sig:i32)i32 {
  let best:i32=0;
  let bn:i32=0;
  let bd:i32=1;
  let op:i32=1;
  while(op<=10){
    if(((mask>>(op-1))&1)==1){
      let rec:i32=conseq_get(W,op,sig);
      let sc:i32=0;
      let at:i32=0;
      if(rec>0){ sc=ng(W,rec,12); at=ng(W,rec,16); }
      if(best==0 || (sc+1)*bd > bn*(at+2)){
        best=op; bn=sc+1; bd=at+2;
      }
    }
    op=op+1;
  }
  return best;
}

// ============ section 7: op execution ============
// exec_op runs one operation. Sets hg(104)=1 if terminal, 0 if continue.
// Returns the value (meaningful only if terminal).
fn exec_op(W:[]u8,op:i32)i32 {
  hs(W,104,0);
  let ws:i32=hg(W,44);
  let wr:i32=hg(W,48);
  if(op==1){
    let n:i32=find_fact(W,ws,wr);
    hs(W,104,1);
    if(n>0){ return ng(W,n,12); }
    return -3;
  }
  if(op==2){
    gather_premises(W,ws,wr);
    hs(W,96,1);
    hs(W,72,1);
    return 0;
  }
  if(op==3){
    let dv:i32=hg(W,92);
    hs(W,72,0);
    hs(W,76,dv);
    if(find_best_map(W,wr)==0){
      hs(W,104,1);
      return dv;
    }
    return 0;
  }
  if(op==4){
    let m:i32=find_trusted_map(W,wr,6);
    hs(W,104,1);
    if(m>0){ return exec_map(W,m,ws); }
    return -3;
  }
  if(op==5){
    let m:i32=find_candidate_map(W,wr);
    let refv:i32=hg(W,76);
    if(m>0){
      let v:i32=exec_map(W,m,ws);
      if(v==refv){ ns(W,m,20,6); }
      else {
        let d:i32=ng(W,m,20)-1;
        if(d<0){ d=0; }
        ns(W,m,20,d);
      }
    }
    hs(W,76,NO_VAL());
    return 0;
  }
  if(op==6){
    let m:i32=find_best_map(W,wr);
    if(m>0){ hs(W,84,m); }
    return 0;
  }
  if(op==7){
    let m:i32=hg(W,84);
    if(m>0){
      let v:i32=exec_map(W,m,ws);
      hs(W,80,v);
    }
    hs(W,100,1);
    return 0;
  }
  if(op==8){
    let simv:i32=hg(W,80);
    let v2:i32=NO_VAL();
    if(hg(W,76)!=NO_VAL()){ v2=hg(W,76); }
    else {
      let m2:i32=find_second_map(W,wr,hg(W,84));
      if(m2>0){ v2=exec_map(W,m2,ws); }
    }
    if(v2!=NO_VAL() && v2==simv){
      let m:i32=hg(W,84);
      if(m>0){ ns(W,m,20,6); }
      hs(W,80,NO_VAL());
      hs(W,104,1);
      return simv;
    }
    hs(W,80,NO_VAL());
    return 0;
  }
  if(op==9){
    let m:i32=find_best_map(W,wr);
    hs(W,104,1);
    if(m>0 && ng(W,m,20)>0){ return exec_map(W,m,ws); }
    return -3;
  }
  inquire(W,ws,wr);
  hs(W,104,1);
  return -3;
}

// ============ section 8: solve_goal and feedback ============
// solve_goal: UNLABELED. Takes only (s, r). No type tag, no mode.
// Loop: sig from state -> applicable -> consequence select -> execute ->
// state changes -> repeat. Sequences emerge from the state dynamics.
fn solve_goal(W:[]u8,s:i32,r:i32,tr:[]u8)i32 {
  hs(W,44,s); hs(W,48,r);
  hs(W,72,0); hs(W,76,NO_VAL()); hs(W,80,NO_VAL()); hs(W,84,0);
  hs(W,88,0); hs(W,92,0); hs(W,96,0); hs(W,100,0);
  let steps:i32=0;
  let ntr:i32=0;
  while(steps<16){
    let sig:i32=compute_sig(W);
    let mask:i32=applicable_mask(W);
    if(mask==0){ break; }
    let op:i32=select_op(W,mask,sig);
    if(op==0){ break; }
    set32(tr,ntr*8,op); set32(tr,ntr*8+4,sig); ntr=ntr+1;
    hs(W,28,hg(W,28)+1);
    let val:i32=exec_op(W,op);
    steps=steps+1;
    if(hg(W,104)==1){
      hs(W,112,ntr);
      return val;
    }
  }
  hs(W,112,ntr);
  return -3;
}
// feedback: backward usefulness walk over the trace.
// Terminal op useful iff answer correct. Predecessor useful iff its successor
// required its provision and was useful. All traced ops get attempts;
// useful ones get successes. This is how "previous consequences" reshape
// future selection.
fn feedback(W:[]u8,tr:[]u8,ntr:i32,correct:i32)void {
  if(ntr<1){ return; }
  let i:i32=ntr-1;
  let unext:i32=correct;
  tr[256+i]=unext as u8;
  i=i-1;
  while(i>=0){
    let opi:i32=get32(tr,i*8);
    let opnx:i32=get32(tr,(i+1)*8);
    let u:i32=0;
    if(unext==1 && op_provides(opi)==op_requires(opnx)){ u=1; }
    tr[256+i]=u as u8;
    unext=u;
    i=i-1;
  }
  i=0;
  while(i<ntr){
    let op:i32=get32(tr,i*8);
    let sg:i32=get32(tr,i*8+4);
    let u:i32=tr[256+i] as i32;
    conseq_bump(W,op,sg,u);
    i=i+1;
  }
  return;
}

// ============ section 9: driver ============
fn rep_goal(nm:[]u8,W:[]u8,ans:i32,exp:i32,tr:[]u8,ntr:i32)void {
  emit("GOAL "); emit(nm);
  emit(" ans="); e64(ans);
  emit(" exp="); e64(exp);
  let ok:i32=0;
  if(ans==exp){ ok=1; }
  emit(" ok="); e64(ok);
  emit(" steps="); e64(ntr);
  emit(" trace=");
  let i:i32=0;
  while(i<ntr){
    if(i>0){ emit(","); }
    e64(get32(tr,i*8));
    i=i+1;
  }
  emit("\n");
  hs(W,40,hg(W,40)+1);
  if(ok==1){ hs(W,36,hg(W,36)+1); }
  return;
}
fn do_goal(W:[]u8,nm:[]u8,s:i32,r:i32,exp:i32)void {
  let tr:[]u8=z_alloc(512);
  let ans:i32=solve_goal(W,s,r,tr);
  let ntr:i32=hg(W,112);
  let ok:i32=0;
  if(ans==exp){ ok=1; }
  feedback(W,tr,ntr,ok);
  rep_goal(nm,W,ans,exp,tr,ntr);
  return;
}
// ---- world setups (the environment, not labels) ----
fn setup_train_fact(W:[]u8)void {
  teach_fact(W,101,70,100,1);
  teach_fact(W,102,70,200,1);
  teach_fact(W,103,70,300,1);
  return;
}
fn setup_train_trust(W:[]u8)void {
  teach_map(W,71,10,105,1,10,0,0,1);
  return;
}
fn setup_train_deriv(W:[]u8)void {
  teach_fact(W,201,51,8,1); teach_fact(W,8,52,300,1);
  teach_fact(W,202,51,9,1); teach_fact(W,9,52,400,1);
  teach_fact(W,203,51,10,1); teach_fact(W,10,52,500,1);
  return;
}
fn setup_train_pred(W:[]u8)void {
  teach_map(W,72,2,104,2,2,0,0,1);
  return;
}
// S1: recall premises -> derive -> verify candidate -> execute.
// fact(1,51,7), fact(7,52,200); candidate MAP r=53 (add 199): 1+199=200.
fn setup_s1(W:[]u8)void {
  teach_fact(W,1,51,7,1); teach_fact(W,7,52,200,1);
  teach_map(W,53,3,1,1,199,0,0,1);
  return;
}
// S1p: same shape, new literals, r=63 via 61,62.
// fact(11,61,17), fact(17,62,500); candidate MAP r=63 (add 489): 11+489=500.
fn setup_s1p(W:[]u8)void {
  teach_fact(W,11,61,17,1); teach_fact(W,17,62,500,1);
  teach_map(W,63,3,11,1,489,0,0,1);
  return;
}
// S2: retrieve structure -> adapt (rebind) -> simulate -> cross-check.
// M1 r=80 (add 5, mul 2): (20+5)*2=50.  M2 r=80 (mul 2, add 10): 20*2+10=50.
fn setup_s2(W:[]u8)void {
  teach_map(W,80,0,10,1,5,2,2,2);
  teach_map(W,80,0,15,2,2,1,10,2);
  return;
}
// S2p: same shape, new literals, r=81.
// M3 (add 3, mul 4): (30+3)*4=132.  M4 (mul 4, add 12): 30*4+12=132.
fn setup_s2p(W:[]u8)void {
  teach_map(W,81,0,30,1,3,2,4,2);
  teach_map(W,81,0,35,2,4,1,12,2);
  return;
}
fn main()i32 {
  emit("UNLABELED SELECTION BATTERY\n");
  emit("Goals are (s,r) only. No type labels. No mode selector.\n");
  let W:[]u8=freshW();
  setup_train_fact(W);
  setup_train_trust(W);
  setup_train_deriv(W);
  setup_train_pred(W);
  do_goal(W,"T1-fact",101,70,100);
  do_goal(W,"T2-fact",102,70,200);
  do_goal(W,"T3-fact",103,70,300);
  do_goal(W,"T4-trust",105,71,115);
  do_goal(W,"T5-trust",106,71,116);
  do_goal(W,"T6-trust",107,71,117);
  do_goal(W,"T7-deriv",201,53,300);
  do_goal(W,"T8-deriv",202,53,400);
  do_goal(W,"T9-deriv",203,53,500);
  do_goal(W,"T10-pred",104,72,208);
  do_goal(W,"T11-pred",105,72,210);
  do_goal(W,"T12-pred",106,72,212);
  setup_s1(W);
  do_goal(W,"S1-seq",1,53,200);
  setup_s1p(W);
  do_goal(W,"S1p-seq",11,63,500);
  setup_s2(W);
  do_goal(W,"S2-seq",20,80,50);
  setup_s2p(W);
  do_goal(W,"S2p-seq",30,81,132);
  emit("SUMMARY main correct="); e64(hg(W,36));
  emit(" total="); e64(hg(W,40));
  emit(" steps="); e64(hg(W,28));
  emit("\n");
  let Wa:[]u8=freshW();
  teach_map(Wa,74,2,107,2,3,0,0,1);
  do_goal(Wa,"A-pred",107,74,321);
  setup_s1(Wa);
  do_goal(Wa,"A-s1",1,53,200);
  setup_s2(Wa);
  do_goal(Wa,"A-s2",20,80,50);
  emit("SUMMARY abl correct="); e64(hg(Wa,36));
  emit(" total="); e64(hg(Wa,40));
  emit(" steps="); e64(hg(Wa,28));
  emit("\n");
  emit("DONE\n");
  return 0;
}

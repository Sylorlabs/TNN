// po_learner.zag -- optionality of guessing, learner side.
//
// PREREG section 2 (K-NOLABEL-SRC) forbids, in THIS FILE:
//   * any string literal -- there is no quote character below, not even an
//     empty one, so po_alloc below never has to return one;
//   * any occurrence of a fixture name, of a route name, or of a
//     fixture-specific entity id;
//   * any if/while condition mentioning a fixture, a label, a mode or a route.
// The only free constants are the arena geometry below and the price weight,
// which is read from cfg cell 4 so that it can be swept. Routes are addressed only
// by integer row 0..5 and every name here is an opaque code.
//
// The row -> route mapping is deliberately NOT written down in this file. It is
// recorded once, in po_main.zag, and bar K-NOLABEL-RUN re-runs the identical
// binary with the two grader bands never written, showing that erasing the
// grader's knowledge moves no choice.
//
// Arenas. W is one flat []u8 of ten bands of 16416 bytes; each band has a
// 32-byte header (cell 0 live count, cell 4 next id) then 64-byte records of
// sixteen i32 cells. S is a separate private scratch band, never shared.
//   W band 0  addressed triples, chained, each stamped with a creation order
//   W band 1  rule-shaped records carrying their own support leaves
//   W band 2  bound restrictions on one subject
//   W band 3  repeatable measurement channels: a price and a realised
//             informativeness tally
//   W band 4  realised outcomes of past attempts on a relation, and the value
//             each attempt returned
//   W band 5  the reusable subject-relation -> row memo
//   W band 6  aggregate answer nodes; a set node points at a chain of values
//   W band 7  individual value cells
//   W band 8  GRADER ONLY: the fixture code. No band index 8 appears below.
//   W band 9  GRADER ONLY: the expected row. No band index 9 appears below.
// S cell 0..15 value pool, 16 pool size, 17 distinct size, 23 fabrication flag,
//   32+r*16 the candidate table (+0 open, +4 posterior, +8 measured cost,
//   +16 utility), 40 set head, 41 set node, 60..315 recency scratch,
//   316..319 realisation tally.

fn po_alloc(n:i32)[]u8 {
  let m:i32=262144;
  if(n>m){ m=n; }
  let p:*u8=_zag_malloc(m) as *u8;
  if(p==null as *u8){ p=_zag_malloc(m) as *u8; }
  let b:[]u8=p[0..m];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn po_get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn po_set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn po_cfg(cfg:[]u8,i:i32)i32 { return po_get32(cfg,i*4); }
fn po_bsz()i32 { return 16416; }
fn po_wsz()i32 { return 164160; }
fn po_swsz()i32 { return 4096; }
fn po_boff(b:i32)i32 { return b*16416; }
fn po_rec(b:i32,i:i32)i32 { return b*16416+32+i*64; }
fn po_live(W:[]u8,b:i32)i32 { return po_get32(W,po_boff(b)); }
fn po_setlive(W:[]u8,b:i32,v:i32)void { po_set32(W,po_boff(b),v); return; }
fn po_nxt(W:[]u8,b:i32)i32 { return po_get32(W,po_boff(b)+4); }
fn po_setnxt(W:[]u8,b:i32,v:i32)void { po_set32(W,po_boff(b)+4,v); return; }
fn po_ng(W:[]u8,o:i32,f:i32)i32 { return po_get32(W,o+f*4); }
fn po_sn(W:[]u8,o:i32,f:i32,v:i32)void { po_set32(W,o+f*4,v); return; }

fn po_sg(S:[]u8,i:i32)i32 { return po_get32(S,i*4); }
fn po_ss(S:[]u8,i:i32,v:i32)void { po_set32(S,i*4,v); return; }

fn po_ki(i:i32)i32 { return 512+i*4; }
fn po_kadd(K:[]u8,c:i32,v:i32)void { po_set32(K,po_ki(c),po_get32(K,po_ki(c))+v); return; }
fn po_kvis(K:[]u8,v:i32)void { po_kadd(K,0,v); return; }

// value pool in the scratch band
fn po_pclear(S:[]u8)void { po_ss(S,16,0); po_ss(S,17,0); po_ss(S,18,0); return; }
fn po_phas(S:[]u8,v:i32)i32 {
  let n:i32=po_sg(S,16); let i:i32=0;
  while(i<n){ if(po_sg(S,i)==v){ return 1; } i=i+1; }
  return 0;
}
fn po_padd(S:[]u8,v:i32)void {
  if(po_sg(S,16)>=16){ po_ss(S,18,1); return; }
  if(po_phas(S,v)==1){ return; }
  po_ss(S,po_sg(S,16),v); po_ss(S,16,po_sg(S,16)+1); return;
}
// distinct addressed values held for exactly (s,r)
fn po_fill_a(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  po_pclear(S);
  let i:i32=0; let L:i32=po_live(W,0);
  while(i<L){
    let o:i32=po_rec(0,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ po_padd(S,po_ng(W,o,2)); po_kvis(K,1); }
    i=i+1;
  }
  po_ss(S,17,po_sg(S,16));
  return;
}
// distinct restrictions on subject s, plus everything addressed about s
fn po_fill_c(W:[]u8,K:[]u8,S:[]u8,s:i32)void {
  po_pclear(S);
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){
    let o:i32=po_rec(2,i);
    if(po_ng(W,o,0)==s){ po_padd(S,po_ng(W,o,2)); po_kvis(K,1); }
    i=i+1;
  }
  let j:i32=0; let M:i32=po_live(W,0);
  while(j<M){
    let q:i32=po_rec(0,j);
    if(po_ng(W,q,0)==s){ po_padd(S,po_ng(W,q,2)); po_kvis(K,1); }
    j=j+1;
  }
  return;
}
fn po_ok(W:[]u8,S:[]u8,s:i32,v:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){
    let o:i32=po_rec(2,i);
    if(po_ng(W,o,0)==s){
      let w:i32=po_ng(W,o,2);
      let k:i32=po_ng(W,o,1);
      if(k==10 && v<w){ return 0; }
      if(k==11 && v>w){ return 0; }
      if(k==12 && v==w){ return 0; }
      if(k==13 && v!=w){ return 0; }
    }
    i=i+1;
  }
  return 1;
}
fn po_nfeas(W:[]u8,S:[]u8,s:i32)i32 {
  let n:i32=0; let i:i32=0; let m:i32=po_sg(S,16);
  while(i<m){ if(po_ok(W,S,s,po_sg(S,i))==1){ n=n+1; } i=i+1; }
  return n;
}
fn po_find1(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,1);
  while(i<L){
    let o:i32=po_rec(1,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ return o; }
    i=i+1;
  }
  return -1;
}
fn po_find3(W:[]u8,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,3);
  while(i<L){
    let o:i32=po_rec(3,i);
    if(po_ng(W,o,0)==r){ return o; }
    i=i+1;
  }
  return -1;
}
// realised outcomes held on relation r: cells 316 count, 317 successes
fn po_tally(W:[]u8,K:[]u8,S:[]u8,r:i32,b:i32)void {
  po_ss(S,316,0); po_ss(S,317,0);
  let i:i32=0; let L:i32=po_live(W,b);
  while(i<L){
    let o:i32=po_rec(b,i);
    if(po_ng(W,o,0)==r){
      po_ss(S,316,po_sg(S,316)+1);
      if(po_ng(W,o,1)==1){ po_ss(S,317,po_sg(S,317)+1); }
    }
    i=i+1;
  }
  po_kvis(K,po_sg(S,316));
  return;
}
// value returned by the most recent realised attempt on relation r
fn po_tval(W:[]u8,r:i32)i32 {
  let i:i32=po_live(W,4)-1;
  if(i<0){ return 0; }
  let o:i32=po_rec(4,i);
  if(po_ng(W,o,0)!=r){ return 0; }
  return po_ng(W,o,2);
}

fn po_cf(i:i32,f:i32)i32 { return 32+i*16+f; }
fn po_cav(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,0)); }
fn po_cct(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,1)); }
fn po_cco(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,2)); }
fn po_csu(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,3)); }
fn po_scav(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,0),v); return; }
fn po_scct(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,1),v); return; }
fn po_scco(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,2),v); return; }
fn po_scsu(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,3),v); return; }
fn po_creset(S:[]u8)void {
  let i:i32=0;
  while(i<6){ po_scav(S,i,0); po_scct(S,i,0); po_scco(S,i,0); po_scsu(S,i,0); po_ss(S,po_cf(i,4),0); po_ss(S,po_cf(i,5),0); i=i+1; }
  return;
}
fn po_scale(num:i32,den:i32)i32 {
  if(den<1){ return 0; }
  let v:i32=(255*num)/den;
  if(v>255){ v=255; }
  if(v<0){ v=0; }
  return v;
}

// ---- row 0: one addressed record, priced as a single read -----------------
fn po_k0(W:[]u8,K:[]u8,S:[]u8,cfg:[]u8,s:i32,r:i32)void {
  po_fill_a(W,K,S,s,r);
  let n:i32=po_sg(S,17);
  if(n<1){
    if(po_cfg(cfg,0)==1){ po_k0f(W,K,S,s,r); }
    return;
  }
  po_scav(S,0,1);
  po_scct(S,0,po_scale(1,n));
  po_scco(S,0,1);
  po_scsu(S,0,n);
  return;
}
// Replicated recency rule. Walks band 0 newest-first, keeps the newest three
// records on relation r, and believes them when they agree. The subject is
// never compared. This is the frozen defect being tested.
fn po_k0f(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let m:i32=0;
  let i:i32=0; let L:i32=po_live(W,0);
  while(i<L){
    let o:i32=po_rec(0,i);
    if(po_ng(W,o,1)==r && m<256){
      po_ss(S,60+m,o); po_ss(S,60+m+256,po_ng(W,o,4)); m=m+1;
    }
    i=i+1;
  }
  if(m<3){ return; }
  let a:i32=1;
  while(a<m){
    let ki:i32=po_sg(S,60+a); let kq:i32=po_sg(S,60+a+256);
    let b:i32=a-1;
    while(b<0 || po_sg(S,60+b+256)>=kq){
      po_ss(S,60+b+1,po_sg(S,60+b)); po_ss(S,60+b+1+256,po_sg(S,60+b+256));
      b=b-1;
    }
    po_ss(S,60+b+1,ki); po_ss(S,60+b+1+256,kq);
    a=a+1;
  }
  let v0:i32=po_ng(W,po_sg(S,60),2);
  let v1:i32=po_ng(W,po_sg(S,61),2);
  let v2:i32=po_ng(W,po_sg(S,62),2);
  if(v0!=v1){ return; }
  if(v0!=v2){ return; }
  po_scav(S,0,1);
  po_scct(S,0,255);
  po_scco(S,0,1);
  po_scsu(S,0,3);
  po_ss(S,23,1);
  return;
}

// ---- row 1: walk a support closure, pay for every leaf -------------------
fn po_k1(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let o:i32=po_find1(W,s,r);
  if(o<0){ return; }
  let nl:i32=po_ng(W,o,4);
  let unw:i32=0; let i:i32=0;
  while(i<nl){
    let id:i32=po_ng(W,o,5+i);
    if(id<0 || id>=po_live(W,0)){ unw=unw+1; }
    i=i+1;
  }
  let cert:i32=255;
  if(unw>0){ cert=255-55*unw; if(cert<0){ cert=0; } }
  po_scav(S,1,1);
  po_scct(S,1,cert);
  po_scco(S,1,nl+1);
  po_scsu(S,1,nl+1);
  po_kvis(K,nl+1);
  return;
}

// ---- row 2: intersect restrictions, pay for each one ---------------------
fn po_k2(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let nc:i32=0;
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){ if(po_ng(W,po_rec(2,i),0)==s){ nc=nc+1; } i=i+1; }
  if(nc<1){ return; }
  po_fill_c(W,K,S,s);
  if(po_sg(S,16)<1){ return; }
  let nf:i32=po_nfeas(W,S,s);
  if(nf<1){ return; }
  po_scav(S,2,1);
  po_scct(S,2,po_scale(1,nf));
  po_scco(S,2,nc+1);
  po_scsu(S,2,nc);
  po_kvis(K,nc);
  return;
}

// ---- row 3: spend one measurement, pay its price -------------------------
fn po_k3(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let o:i32=po_find3(W,r);
  if(o<0){ return; }
  let trials:i32=po_ng(W,o,2);
  let cert:i32=128;
  if(trials>0){ cert=po_scale(po_ng(W,o,3),trials); }
  po_scav(S,3,1);
  po_scct(S,3,cert);
  po_scco(S,3,po_ng(W,o,1)+1);
  po_scsu(S,3,1);
  return;
}

// ---- row 4: gather every addressed value into one set node --------------
fn po_k4(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  po_fill_a(W,K,S,s,r);
  let n:i32=po_sg(S,17);
  if(n<2){ return; }
  po_scav(S,4,1);
  po_scct(S,4,255);
  po_scco(S,4,n+1);
  po_scsu(S,4,n);
  po_kvis(K,n+1);
  return;
}

// ---- row 5: the honest posterior over a relation's own outcomes ----------
fn po_k5(W:[]u8,K:[]u8,S:[]u8,cfg:[]u8,s:i32,r:i32)void {
  po_tally(W,K,S,r,4);
  let n:i32=po_sg(S,316);
  if(n<1){ return; }
  let cert:i32=po_scale(po_sg(S,317),n);
  if(po_cfg(cfg,3)==1){ cert=255; }
  po_scav(S,5,1);
  po_scct(S,5,cert);
  po_scco(S,5,n+1);
  po_scsu(S,5,n);
  po_kadd(K,6,1);
  return;
}

// Price one candidate. Cell 3 keeps the TRUE measured cost, which is what
// gets reported as realized work. Cell 5 holds the PRICED cost: under the
// no-pricing switch every available candidate is given cost 0, exactly as
// prereg section 7 words it, so both the utility and the cost tie-break see
// the unpriced candidate.
fn po_price(S:[]u8,cfg:[]u8,i:i32)void {
  let pc:i32=po_cco(S,i);
  if(po_cfg(cfg,2)==1){ pc=0; }
  let u:i32=po_cct(S,i)-po_cfg(cfg,4)*pc;
  po_ss(S,po_cf(i,5),pc);
  po_ss(S,po_cf(i,4),u);
  return;
}
// frozen scan order and the two permutations used by the order bar
fn po_corder(i:i32,o:i32)i32 {
  if(o==0){ return i; }
  if(o==1){
    if(i==0){ return 3; }
    if(i==1){ return 0; }
    if(i==2){ return 5; }
    if(i==3){ return 1; }
    if(i==4){ return 4; }
    return 2;
  }
  if(o==2){ return 5-i; }
  if(o==3){
    if(i==0){ return 4; }
    if(i==1){ return 2; }
    if(i==2){ return 0; }
    if(i==3){ return 5; }
    if(i==4){ return 3; }
    return 1;
  }
  return i;
}

fn po_mfind(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,5);
  while(i<L){
    let o:i32=po_rec(5,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ return o; }
    i=i+1;
  }
  return -1;
}
fn po_mwrite(W:[]u8,s:i32,r:i32,i:i32)void {
  if(po_live(W,5)>=256){ return; }
  let id:i32=po_nxt(W,5); let o:i32=po_rec(5,id);
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,i);
  po_setnxt(W,5,id+1); po_setlive(W,5,id+1);
  return;
}
// Append one addressed record, stamped with a strictly increasing creation
// order. Used only by the replicated recency rule, to reproduce the frozen
// C504 behaviour in which a fabricated answer is persisted as a fact.
fn po_push(W:[]u8,s:i32,r:i32,v:i32)void {
  if(po_live(W,0)>=256){ return; }
  let id:i32=po_nxt(W,0); let o:i32=po_rec(0,id);
  let q:i32=0; let i:i32=0;
  while(i<id){ if(po_ng(W,po_rec(0,i),4)>q){ q=po_ng(W,po_rec(0,i),4); } i=i+1; }
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,v); po_sn(W,o,3,id); po_sn(W,o,4,q+1);
  po_setnxt(W,0,id+1); po_setlive(W,0,id+1);
  return;
}
fn po_mkv(W:[]u8,v:i32)void {
  let id:i32=po_nxt(W,7); let o:i32=po_rec(7,id);
  po_sn(W,o,0,v); po_sn(W,o,1,-1);
  po_setnxt(W,7,id+1); po_setlive(W,7,id+1);
  return;
}
// build the aggregate answer node: one set node over a chain of every pooled
// value. Cells 40 = head value id, 41 = set node id.
fn po_mkset(W:[]u8,S:[]u8,arity:i32)i32 {
  let m:i32=po_sg(S,16);
  let i:i32=0;
  while(i<m){ po_mkv(W,po_sg(S,i)); i=i+1; }
  if(m<1){ po_ss(S,40,-1); return -1; }
  let head:i32=po_nxt(W,7)-m;
  let j:i32=0;
  while(j<m-1){ po_sn(W,po_rec(7,head+j),1,head+j+1); j=j+1; }
  po_ss(S,40,head);
  if(po_live(W,6)>=256){ return -1; }
  let sid:i32=po_nxt(W,6); let so:i32=po_rec(6,sid);
  po_sn(W,so,0,1); po_sn(W,so,1,arity); po_sn(W,so,2,head);
  po_setnxt(W,6,sid+1); po_setlive(W,6,sid+1);
  po_ss(S,41,sid);
  return sid;
}
// number of bands whose live count is within the node cap
fn po_maxlive(W:[]u8)i32 {
  let mx:i32=0; let b:i32=0;
  while(b<10){
    let v:i32=po_live(W,b);
    if(v>mx){ mx=v; }
    b=b+1;
  }
  return mx;
}

// ---- real execution of the selected row ----------------------------------
// R is caller-owned scratch of 64 bytes: 0 value, 1 arity, 2 set node,
// 3 support, 4 steps, 5 allocs
fn po_exec(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32,best:i32,R:[]u8)void {
  let val:i32=0; let sup:i32=0; let ar:i32=0; let sid:i32=-1;
  let steps:i32=po_cco(S,best);
  po_set32(R,0*4,0); po_set32(R,1*4,0); po_set32(R,2*4,-1);
  po_set32(R,3*4,0); po_set32(R,4*4,steps); po_set32(R,5*4,1);
  if(best==0){
    let i:i32=0; let L:i32=po_live(W,0); let f:i32=-1;
    while(i<L){
      let o:i32=po_rec(0,i);
      if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ if(f<0){ f=o; } }
      i=i+1;
    }
    if(f>=0){ val=po_ng(W,f,2); sup=1; }
    if(f<0 && po_sg(S,23)==1 && po_sg(S,60)>0){
      val=po_ng(W,po_sg(S,60),2); sup=3;
    }
  }
  if(best==1){
    let o:i32=po_find1(W,s,r);
    if(o>=0){ val=po_ng(W,o,2); sup=po_ng(W,o,4)+1; }
  }
  if(best==2){
    po_fill_c(W,K,S,s);
    sup=po_csu(S,2); ar=po_nfeas(W,S,s);
    let i:i32=0; let m:i32=po_sg(S,16);
    while(i<m){
      if(po_ok(W,S,s,po_sg(S,i))==1){ if(val==0){ val=po_sg(S,i); } }
      i=i+1;
    }
  }
  if(best==3){
    let o:i32=po_find3(W,r);
    if(o>=0){ val=po_ng(W,o,4); sup=1; }
  }
  if(best==4){
    po_fill_a(W,K,S,s,r);
    sup=po_sg(S,17); ar=sup;
    sid=po_mkset(W,S,sup);
    if(po_sg(S,16)>0){ val=po_sg(S,0); }
  }
  if(best==5){
    po_tally(W,K,S,r,4);
    val=po_tval(W,r); sup=po_sg(S,316);
  }
  po_set32(R,0*4,val); po_set32(R,1*4,ar); po_set32(R,2*4,sid); po_set32(R,3*4,sup);
  if(best==5){ po_kadd(K,4,steps); }
  return;
}

// ---- the route-selection step --------------------------------------------
// cfg 0 replicate-recency, 1 memo enabled, 2 no pricing, 3 forced high
//       posterior, 4 price weight, 5 scan order, 6 tie prefers the higher row
// O  0 row chosen (-1 = declined), 1 decline reason, 2 steps, 3 allocs,
//    4 verifications, 5 visits, 6 rows available, 7 support, 8 value,
//    9 set arity, 10 set node, 11 memo hit, 12 utility, 13 posterior,
//    14 cost, 15 fabricated, 16..21 open flags of rows 0..5,
//    22 posterior of row 5 for this relation, 23 distinct addressed values,
//    24 steps an always-guess row would have charged,
//    25 max live records in any band, 26 rows scanned, 27 distinct pool size,
//    28 realised steps spent inside row 5, 29 times row 5 was priced
fn po_run(W:[]u8,S:[]u8,K:[]u8,R:[]u8,cfg:[]u8,s:i32,r:i32,O:[]u8)void {
  let i:i32=0;
  while(i<32){ po_set32(O,i*4,0); i=i+1; }
  po_set32(O,0*4,-1);
  po_set32(O,1*4,1);
  po_creset(S);
  po_ss(S,23,0);
  let hit:i32=-1;
  if(po_cfg(cfg,1)==1){ hit=po_mfind(W,s,r); }
  let hitrow:i32=-1;
  if(hit>=0){
    let j:i32=po_ng(W,hit,2);
    if(j>=0 && j<6){ hitrow=j; } else { hit=-1; }
  }
if(hitrow>=0){
    po_scav(S,hitrow,1);
    po_scct(S,hitrow,255);
    po_scco(S,hitrow,0);
    po_scsu(S,hitrow,1);
    po_set32(O,0*4,hitrow);
    po_set32(O,11*4,1);
    po_set32(O,6*4,1);
    po_set32(O,(16+hitrow)*4,1);
    let z:i32=0;
    while(z<6){ if(z!=hitrow){ po_set32(O,(16+z)*4,-1); } z=z+1; }
    po_set32(O,26*4,1);
    po_set32(O,5*4,po_get32(K,po_ki(0)));
    po_set32(O,2*4,1);
    po_set32(O,3*4,0);
    po_set32(O,7*4,1);
    po_set32(O,12*4,247); po_set32(O,13*4,255); po_set32(O,14*4,1);
  }
  if(hitrow<0){
    po_k0(W,K,S,cfg,s,r);
    po_k1(W,K,S,s,r);
    po_k2(W,K,S,s,r);
    po_k3(W,K,S,s,r);
    po_k4(W,K,S,s,r);
    po_k5(W,K,S,cfg,s,r);
    let j:i32=0;
    while(j<6){ po_price(S,cfg,j); j=j+1; }
    let av:i32=0; let z:i32=0;
    while(z<6){
      po_set32(O,(16+z)*4,po_cav(S,z));
      if(po_cav(S,z)==1){ av=av+1; }
      z=z+1;
    }
    po_set32(O,6*4,av);
    let b:i32=-1; let bu:i32=0; let bc:i32=0; let bx:i32=0;
    let t:i32=0;
    while(t<6){
      let idx:i32=po_corder(t,po_cfg(cfg,5));
      let u:i32=po_sg(S,po_cf(idx,4));
      let c:i32=po_sg(S,po_cf(idx,5));
      let take:i32=0;
      let thi:i32=0;
      if(po_cfg(cfg,6)==1){ thi=1; }
      let tie:i32=0;
      if(b>=0 && u==bu && c==bc){ tie=1; }
      if(po_cav(S,idx)==1){
        if(b<0){ take=1; }
        if(b>=0 && u>bu){ take=1; }
        if(b>=0 && u==bu && c<bc){ take=1; }
        if(tie==1 && thi==0 && idx<bx){ take=1; }
        if(tie==1 && thi==1 && idx>bx){ take=1; }
      }
      if(take==1){ b=idx; bu=u; bc=c; bx=idx; }
      t=t+1;
    }
    po_set32(O,26*4,t);
    po_set32(O,12*4,bu);
    po_set32(O,13*4,po_cct(S,bx));
    po_set32(O,14*4,bc);
    po_set32(O,15*4,po_sg(S,23));
    po_set32(O,22*4,po_cct(S,5));
    po_set32(O,23*4,po_sg(S,17));
    po_set32(O,27*4,po_sg(S,16));
    if(b<0){ po_set32(O,0*4,-1); po_set32(O,1*4,1); po_set32(O,5*4,po_get32(K,po_ki(0))); po_set32(O,25*4,po_maxlive(W)); return; }
    po_exec(W,K,S,s,r,b,R);
    po_set32(O,0*4,b);
    po_set32(O,2*4,po_get32(R,4*4));
    po_set32(O,3*4,po_get32(R,5*4));
    po_set32(O,7*4,po_get32(R,3*4));
    po_set32(O,8*4,po_get32(R,0*4));
    po_set32(O,9*4,po_get32(R,1*4));
    po_set32(O,10*4,po_get32(R,2*4));
    po_set32(O,24*4,po_csu(S,5)+1);
    po_set32(O,4*4,po_get32(R,3*4));
    if(po_csu(S,b)<1){ po_set32(O,1*4,3); } else { po_set32(O,1*4,0); }
    if(po_cfg(cfg,1)==1){ po_mwrite(W,s,r,b); }
    if(po_cfg(cfg,0)==1 && po_sg(S,23)==1){
      po_push(W,s,r,po_get32(R,0*4));
    }
  }
  po_set32(O,5*4,po_get32(K,po_ki(0)));
  po_set32(O,25*4,po_maxlive(W));
  po_set32(O,28*4,po_get32(K,po_ki(4)));
  po_set32(O,29*4,po_get32(K,po_ki(6)));
  return;
}
// po_learner.zag -- optionality of guessing, learner side.
//
// PREREG section 2 (K-NOLABEL-SRC) forbids, in THIS FILE:
//   * any string literal -- there is no quote character below, not even an
//     empty one, so po_alloc below never has to return one;
//   * any occurrence of a fixture name, of a route name, or of a
//     fixture-specific entity id;
//   * any if/while condition mentioning a fixture, a label, a mode or a route.
// The only free constants are the arena geometry below and the price weight,
// which is read from cfg cell 4 so that it can be swept. Routes are addressed only
// by integer row 0..5 and every name here is an opaque code.
//
// The row -> route mapping is deliberately NOT written down in this file. It is
// recorded once, in po_main.zag, and bar K-NOLABEL-RUN re-runs the identical
// binary with the two grader bands never written, showing that erasing the
// grader's knowledge moves no choice.
//
// Arenas. W is one flat []u8 of ten bands of 16416 bytes; each band has a
// 32-byte header (cell 0 live count, cell 4 next id) then 64-byte records of
// sixteen i32 cells. S is a separate private scratch band, never shared.
//   W band 0  addressed triples, chained, each stamped with a creation order
//   W band 1  rule-shaped records carrying their own support leaves
//   W band 2  bound restrictions on one subject
//   W band 3  repeatable measurement channels: a price and a realised
//             informativeness tally
//   W band 4  realised outcomes of past attempts on a relation, and the value
//             each attempt returned
//   W band 5  the reusable subject-relation -> row memo
//   W band 6  aggregate answer nodes; a set node points at a chain of values
//   W band 7  individual value cells
//   W band 8  GRADER ONLY: the fixture code. No band index 8 appears below.
//   W band 9  GRADER ONLY: the expected row. No band index 9 appears below.
// S cell 0..15 value pool, 16 pool size, 17 distinct size, 23 fabrication flag,
//   32+r*16 the candidate table (+0 open, +4 posterior, +8 measured cost,
//   +16 utility), 40 set head, 41 set node, 60..315 recency scratch,
//   316..319 realisation tally.

fn po_alloc(n:i32)[]u8 {
  let m:i32=262144;
  if(n>m){ m=n; }
  let p:*u8=_zag_malloc(m) as *u8;
  if(p==null as *u8){ p=_zag_malloc(m) as *u8; }
  let b:[]u8=p[0..m];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn po_get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn po_set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn po_cfg(cfg:[]u8,i:i32)i32 { return po_get32(cfg,i*4); }
fn po_bsz()i32 { return 16416; }
fn po_wsz()i32 { return 164160; }
fn po_swsz()i32 { return 4096; }
fn po_boff(b:i32)i32 { return b*16416; }
fn po_rec(b:i32,i:i32)i32 { return b*16416+32+i*64; }
fn po_live(W:[]u8,b:i32)i32 { return po_get32(W,po_boff(b)); }
fn po_setlive(W:[]u8,b:i32,v:i32)void { po_set32(W,po_boff(b),v); return; }
fn po_nxt(W:[]u8,b:i32)i32 { return po_get32(W,po_boff(b)+4); }
fn po_setnxt(W:[]u8,b:i32,v:i32)void { po_set32(W,po_boff(b)+4,v); return; }
fn po_ng(W:[]u8,o:i32,f:i32)i32 { return po_get32(W,o+f*4); }
fn po_sn(W:[]u8,o:i32,f:i32,v:i32)void { po_set32(W,o+f*4,v); return; }

fn po_sg(S:[]u8,i:i32)i32 { return po_get32(S,i*4); }
fn po_ss(S:[]u8,i:i32,v:i32)void { po_set32(S,i*4,v); return; }

fn po_ki(i:i32)i32 { return 512+i*4; }
fn po_kadd(K:[]u8,c:i32,v:i32)void { po_set32(K,po_ki(c),po_get32(K,po_ki(c))+v); return; }
fn po_kvis(K:[]u8,v:i32)void { po_kadd(K,0,v); return; }

// value pool in the scratch band
fn po_pclear(S:[]u8)void { po_ss(S,16,0); po_ss(S,17,0); po_ss(S,18,0); return; }
fn po_phas(S:[]u8,v:i32)i32 {
  let n:i32=po_sg(S,16); let i:i32=0;
  while(i<n){ if(po_sg(S,i)==v){ return 1; } i=i+1; }
  return 0;
}
fn po_padd(S:[]u8,v:i32)void {
  if(po_sg(S,16)>=16){ po_ss(S,18,1); return; }
  if(po_phas(S,v)==1){ return; }
  po_ss(S,po_sg(S,16),v); po_ss(S,16,po_sg(S,16)+1); return;
}
// distinct addressed values held for exactly (s,r)
fn po_fill_a(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  po_pclear(S);
  let i:i32=0; let L:i32=po_live(W,0);
  while(i<L){
    let o:i32=po_rec(0,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ po_padd(S,po_ng(W,o,2)); po_kvis(K,1); }
    i=i+1;
  }
  po_ss(S,17,po_sg(S,16));
  return;
}
// distinct restrictions on subject s, plus everything addressed about s
fn po_fill_c(W:[]u8,K:[]u8,S:[]u8,s:i32)void {
  po_pclear(S);
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){
    let o:i32=po_rec(2,i);
    if(po_ng(W,o,0)==s){ po_padd(S,po_ng(W,o,2)); po_kvis(K,1); }
    i=i+1;
  }
  let j:i32=0; let M:i32=po_live(W,0);
  while(j<M){
    let q:i32=po_rec(0,j);
    if(po_ng(W,q,0)==s){ po_padd(S,po_ng(W,q,2)); po_kvis(K,1); }
    j=j+1;
  }
  return;
}
fn po_ok(W:[]u8,S:[]u8,s:i32,v:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){
    let o:i32=po_rec(2,i);
    if(po_ng(W,o,0)==s){
      let w:i32=po_ng(W,o,2);
      let k:i32=po_ng(W,o,1);
      if(k==10 && v<w){ return 0; }
      if(k==11 && v>w){ return 0; }
      if(k==12 && v==w){ return 0; }
      if(k==13 && v!=w){ return 0; }
    }
    i=i+1;
  }
  return 1;
}
fn po_nfeas(W:[]u8,S:[]u8,s:i32)i32 {
  let n:i32=0; let i:i32=0; let m:i32=po_sg(S,16);
  while(i<m){ if(po_ok(W,S,s,po_sg(S,i))==1){ n=n+1; } i=i+1; }
  return n;
}
fn po_find1(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,1);
  while(i<L){
    let o:i32=po_rec(1,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ return o; }
    i=i+1;
  }
  return -1;
}
fn po_find3(W:[]u8,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,3);
  while(i<L){
    let o:i32=po_rec(3,i);
    if(po_ng(W,o,0)==r){ return o; }
    i=i+1;
  }
  return -1;
}
// realised outcomes held on relation r: cells 316 count, 317 successes
fn po_tally(W:[]u8,K:[]u8,S:[]u8,r:i32,b:i32)void {
  po_ss(S,316,0); po_ss(S,317,0);
  let i:i32=0; let L:i32=po_live(W,b);
  while(i<L){
    let o:i32=po_rec(b,i);
    if(po_ng(W,o,0)==r){
      po_ss(S,316,po_sg(S,316)+1);
      if(po_ng(W,o,1)==1){ po_ss(S,317,po_sg(S,317)+1); }
    }
    i=i+1;
  }
  po_kvis(K,po_sg(S,316));
  return;
}
// value returned by the most recent realised attempt on relation r
fn po_tval(W:[]u8,r:i32)i32 {
  let i:i32=po_live(W,4)-1;
  if(i<0){ return 0; }
  let o:i32=po_rec(4,i);
  if(po_ng(W,o,0)!=r){ return 0; }
  return po_ng(W,o,2);
}

fn po_cf(i:i32,f:i32)i32 { return 32+i*16+f; }
fn po_cav(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,0)); }
fn po_cct(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,1)); }
fn po_cco(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,2)); }
fn po_csu(S:[]u8,i:i32)i32 { return po_sg(S,po_cf(i,3)); }
fn po_scav(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,0),v); return; }
fn po_scct(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,1),v); return; }
fn po_scco(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,2),v); return; }
fn po_scsu(S:[]u8,i:i32,v:i32)void { po_ss(S,po_cf(i,3),v); return; }
fn po_creset(S:[]u8)void {
  let i:i32=0;
  while(i<6){ po_scav(S,i,0); po_scct(S,i,0); po_scco(S,i,0); po_scsu(S,i,0); po_ss(S,po_cf(i,4),0); po_ss(S,po_cf(i,5),0); i=i+1; }
  return;
}
fn po_scale(num:i32,den:i32)i32 {
  if(den<1){ return 0; }
  let v:i32=(255*num)/den;
  if(v>255){ v=255; }
  if(v<0){ v=0; }
  return v;
}

// ---- row 0: one addressed record, priced as a single read -----------------
fn po_k0(W:[]u8,K:[]u8,S:[]u8,cfg:[]u8,s:i32,r:i32)void {
  po_fill_a(W,K,S,s,r);
  let n:i32=po_sg(S,17);
  if(n<1){
    if(po_cfg(cfg,0)==1){ po_k0f(W,K,S,s,r); }
    return;
  }
  po_scav(S,0,1);
  po_scct(S,0,po_scale(1,n));
  po_scco(S,0,1);
  po_scsu(S,0,n);
  return;
}
// Replicated recency rule. Walks band 0 newest-first, keeps the newest three
// records on relation r, and believes them when they agree. The subject is
// never compared. This is the frozen defect being tested.
fn po_k0f(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let m:i32=0;
  let i:i32=0; let L:i32=po_live(W,0);
  while(i<L){
    let o:i32=po_rec(0,i);
    if(po_ng(W,o,1)==r && m<256){
      po_ss(S,60+m,o); po_ss(S,60+m+256,po_ng(W,o,4)); m=m+1;
    }
    i=i+1;
  }
  if(m<3){ return; }
  let a:i32=1;
  while(a<m){
    let ki:i32=po_sg(S,60+a); let kq:i32=po_sg(S,60+a+256);
    let b:i32=a-1;
    while(b<0 || po_sg(S,60+b+256)>=kq){
      po_ss(S,60+b+1,po_sg(S,60+b)); po_ss(S,60+b+1+256,po_sg(S,60+b+256));
      b=b-1;
    }
    po_ss(S,60+b+1,ki); po_ss(S,60+b+1+256,kq);
    a=a+1;
  }
  let v0:i32=po_ng(W,po_sg(S,60),2);
  let v1:i32=po_ng(W,po_sg(S,61),2);
  let v2:i32=po_ng(W,po_sg(S,62),2);
  if(v0!=v1){ return; }
  if(v0!=v2){ return; }
  po_scav(S,0,1);
  po_scct(S,0,255);
  po_scco(S,0,1);
  po_scsu(S,0,3);
  po_ss(S,23,1);
  return;
}

// ---- row 1: walk a support closure, pay for every leaf -------------------
fn po_k1(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let o:i32=po_find1(W,s,r);
  if(o<0){ return; }
  let nl:i32=po_ng(W,o,4);
  let unw:i32=0; let i:i32=0;
  while(i<nl){
    let id:i32=po_ng(W,o,5+i);
    if(id<0 || id>=po_live(W,0)){ unw=unw+1; }
    i=i+1;
  }
  let cert:i32=255;
  if(unw>0){ cert=255-55*unw; if(cert<0){ cert=0; } }
  po_scav(S,1,1);
  po_scct(S,1,cert);
  po_scco(S,1,nl+1);
  po_scsu(S,1,nl+1);
  po_kvis(K,nl+1);
  return;
}

// ---- row 2: intersect restrictions, pay for each one ---------------------
fn po_k2(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let nc:i32=0;
  let i:i32=0; let L:i32=po_live(W,2);
  while(i<L){ if(po_ng(W,po_rec(2,i),0)==s){ nc=nc+1; } i=i+1; }
  if(nc<1){ return; }
  po_fill_c(W,K,S,s);
  if(po_sg(S,16)<1){ return; }
  let nf:i32=po_nfeas(W,S,s);
  if(nf<1){ return; }
  po_scav(S,2,1);
  po_scct(S,2,po_scale(1,nf));
  po_scco(S,2,nc+1);
  po_scsu(S,2,nc);
  po_kvis(K,nc);
  return;
}

// ---- row 3: spend one measurement, pay its price -------------------------
fn po_k3(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  let o:i32=po_find3(W,r);
  if(o<0){ return; }
  let trials:i32=po_ng(W,o,2);
  let cert:i32=128;
  if(trials>0){ cert=po_scale(po_ng(W,o,3),trials); }
  po_scav(S,3,1);
  po_scct(S,3,cert);
  po_scco(S,3,po_ng(W,o,1)+1);
  po_scsu(S,3,1);
  return;
}

// ---- row 4: gather every addressed value into one set node --------------
fn po_k4(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32)void {
  po_fill_a(W,K,S,s,r);
  let n:i32=po_sg(S,17);
  if(n<2){ return; }
  po_scav(S,4,1);
  po_scct(S,4,255);
  po_scco(S,4,n+1);
  po_scsu(S,4,n);
  po_kvis(K,n+1);
  return;
}

// ---- row 5: the honest posterior over a relation's own outcomes ----------
fn po_k5(W:[]u8,K:[]u8,S:[]u8,cfg:[]u8,s:i32,r:i32)void {
  po_tally(W,K,S,r,4);
  let n:i32=po_sg(S,316);
  if(n<1){ return; }
  let cert:i32=po_scale(po_sg(S,317),n);
  if(po_cfg(cfg,3)==1){ cert=255; }
  po_scav(S,5,1);
  po_scct(S,5,cert);
  po_scco(S,5,n+1);
  po_scsu(S,5,n);
  po_kadd(K,6,1);
  return;
}

// Price one candidate. Cell 3 keeps the TRUE measured cost, which is what
// gets reported as realized work. Cell 5 holds the PRICED cost: under the
// no-pricing switch every available candidate is given cost 0, exactly as
// prereg section 7 words it, so both the utility and the cost tie-break see
// the unpriced candidate.
fn po_price(S:[]u8,cfg:[]u8,i:i32)void {
  let pc:i32=po_cco(S,i);
  if(po_cfg(cfg,2)==1){ pc=0; }
  let u:i32=po_cct(S,i)-po_cfg(cfg,4)*pc;
  po_ss(S,po_cf(i,5),pc);
  po_ss(S,po_cf(i,4),u);
  return;
}
// frozen scan order and the two permutations used by the order bar
fn po_corder(i:i32,o:i32)i32 {
  if(o==0){ return i; }
  if(o==1){
    if(i==0){ return 3; }
    if(i==1){ return 0; }
    if(i==2){ return 5; }
    if(i==3){ return 1; }
    if(i==4){ return 4; }
    return 2;
  }
  if(o==2){ return 5-i; }
  if(o==3){
    if(i==0){ return 4; }
    if(i==1){ return 2; }
    if(i==2){ return 0; }
    if(i==3){ return 5; }
    if(i==4){ return 3; }
    return 1;
  }
  return i;
}

fn po_mfind(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0; let L:i32=po_live(W,5);
  while(i<L){
    let o:i32=po_rec(5,i);
    if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ return o; }
    i=i+1;
  }
  return -1;
}
fn po_mwrite(W:[]u8,s:i32,r:i32,i:i32)void {
  if(po_live(W,5)>=256){ return; }
  let id:i32=po_nxt(W,5); let o:i32=po_rec(5,id);
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,i);
  po_setnxt(W,5,id+1); po_setlive(W,5,id+1);
  return;
}
// Append one addressed record, stamped with a strictly increasing creation
// order. Used only by the replicated recency rule, to reproduce the frozen
// C504 behaviour in which a fabricated answer is persisted as a fact.
fn po_push(W:[]u8,s:i32,r:i32,v:i32)void {
  if(po_live(W,0)>=256){ return; }
  let id:i32=po_nxt(W,0); let o:i32=po_rec(0,id);
  let q:i32=0; let i:i32=0;
  while(i<id){ if(po_ng(W,po_rec(0,i),4)>q){ q=po_ng(W,po_rec(0,i),4); } i=i+1; }
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,v); po_sn(W,o,3,id); po_sn(W,o,4,q+1);
  po_setnxt(W,0,id+1); po_setlive(W,0,id+1);
  return;
}
fn po_mkv(W:[]u8,v:i32)void {
  let id:i32=po_nxt(W,7); let o:i32=po_rec(7,id);
  po_sn(W,o,0,v); po_sn(W,o,1,-1);
  po_setnxt(W,7,id+1); po_setlive(W,7,id+1);
  return;
}
// build the aggregate answer node: one set node over a chain of every pooled
// value. Cells 40 = head value id, 41 = set node id.
fn po_mkset(W:[]u8,S:[]u8,arity:i32)i32 {
  let m:i32=po_sg(S,16);
  let i:i32=0;
  while(i<m){ po_mkv(W,po_sg(S,i)); i=i+1; }
  if(m<1){ po_ss(S,40,-1); return -1; }
  let head:i32=po_nxt(W,7)-m;
  let j:i32=0;
  while(j<m-1){ po_sn(W,po_rec(7,head+j),1,head+j+1); j=j+1; }
  po_ss(S,40,head);
  if(po_live(W,6)>=256){ return -1; }
  let sid:i32=po_nxt(W,6); let so:i32=po_rec(6,sid);
  po_sn(W,so,0,1); po_sn(W,so,1,arity); po_sn(W,so,2,head);
  po_setnxt(W,6,sid+1); po_setlive(W,6,sid+1);
  po_ss(S,41,sid);
  return sid;
}
// number of bands whose live count is within the node cap
fn po_maxlive(W:[]u8)i32 {
  let mx:i32=0; let b:i32=0;
  while(b<10){
    let v:i32=po_live(W,b);
    if(v>mx){ mx=v; }
    b=b+1;
  }
  return mx;
}

// ---- real execution of the selected row ----------------------------------
// R is caller-owned scratch of 64 bytes: 0 value, 1 arity, 2 set node,
// 3 support, 4 steps, 5 allocs
fn po_exec(W:[]u8,K:[]u8,S:[]u8,s:i32,r:i32,best:i32,R:[]u8)void {
  let val:i32=0; let sup:i32=0; let ar:i32=0; let sid:i32=-1;
  let steps:i32=po_cco(S,best);
  po_set32(R,0*4,0); po_set32(R,1*4,0); po_set32(R,2*4,-1);
  po_set32(R,3*4,0); po_set32(R,4*4,steps); po_set32(R,5*4,1);
  if(best==0){
    let i:i32=0; let L:i32=po_live(W,0); let f:i32=-1;
    while(i<L){
      let o:i32=po_rec(0,i);
      if(po_ng(W,o,0)==s && po_ng(W,o,1)==r){ if(f<0){ f=o; } }
      i=i+1;
    }
    if(f>=0){ val=po_ng(W,f,2); sup=1; }
    if(f<0 && po_sg(S,23)==1 && po_sg(S,60)>0){
      val=po_ng(W,po_sg(S,60),2); sup=3;
    }
  }
  if(best==1){
    let o:i32=po_find1(W,s,r);
    if(o>=0){ val=po_ng(W,o,2); sup=po_ng(W,o,4)+1; }
  }
  if(best==2){
    po_fill_c(W,K,S,s);
    sup=po_csu(S,2); ar=po_nfeas(W,S,s);
    let i:i32=0; let m:i32=po_sg(S,16);
    while(i<m){
      if(po_ok(W,S,s,po_sg(S,i))==1){ if(val==0){ val=po_sg(S,i); } }
      i=i+1;
    }
  }
  if(best==3){
    let o:i32=po_find3(W,r);
    if(o>=0){ val=po_ng(W,o,4); sup=1; }
  }
  if(best==4){
    po_fill_a(W,K,S,s,r);
    sup=po_sg(S,17); ar=sup;
    sid=po_mkset(W,S,sup);
    if(po_sg(S,16)>0){ val=po_sg(S,0); }
  }
  if(best==5){
    po_tally(W,K,S,r,4);
    val=po_tval(W,r); sup=po_sg(S,316);
  }
  po_set32(R,0*4,val); po_set32(R,1*4,ar); po_set32(R,2*4,sid); po_set32(R,3*4,sup);
  if(best==5){ po_kadd(K,4,steps); }
  return;
}

// ---- the route-selection step --------------------------------------------
// cfg 0 replicate-recency, 1 memo enabled, 2 no pricing, 3 forced high
//       posterior, 4 price weight, 5 scan order, 6 tie prefers the higher row
// O  0 row chosen (-1 = declined), 1 decline reason, 2 steps, 3 allocs,
//    4 verifications, 5 visits, 6 rows available, 7 support, 8 value,
//    9 set arity, 10 set node, 11 memo hit, 12 utility, 13 posterior,
//    14 cost, 15 fabricated, 16..21 open flags of rows 0..5,
//    22 posterior of row 5 for this relation, 23 distinct addressed values,
//    24 steps an always-guess row would have charged,
//    25 max live records in any band, 26 rows scanned, 27 distinct pool size,
//    28 realised steps spent inside row 5, 29 times row 5 was priced
fn po_run(W:[]u8,S:[]u8,K:[]u8,R:[]u8,cfg:[]u8,s:i32,r:i32,O:[]u8)void {
  let i:i32=0;
  while(i<32){ po_set32(O,i*4,0); i=i+1; }
  po_set32(O,0*4,-1);
  po_set32(O,1*4,1);
  po_creset(S);
  po_ss(S,23,0);
  let hit:i32=-1;
  if(po_cfg(cfg,1)==1){ hit=po_mfind(W,s,r); }
  let hitrow:i32=-1;
  if(hit>=0){
    let j:i32=po_ng(W,hit,2);
    if(j>=0 && j<6){ hitrow=j; } else { hit=-1; }
  }
if(hitrow>=0){
    po_scav(S,hitrow,1);
    po_scct(S,hitrow,255);
    po_scco(S,hitrow,0);
    po_scsu(S,hitrow,1);
    po_set32(O,0*4,hitrow);
    po_set32(O,11*4,1);
    po_set32(O,6*4,1);
    po_set32(O,(16+hitrow)*4,1);
    let z:i32=0;
    while(z<6){ if(z!=hitrow){ po_set32(O,(16+z)*4,-1); } z=z+1; }
    po_set32(O,26*4,1);
    po_set32(O,5*4,po_get32(K,po_ki(0)));
    po_set32(O,2*4,1);
    po_set32(O,3*4,0);
    po_set32(O,7*4,1);
    po_set32(O,12*4,247); po_set32(O,13*4,255); po_set32(O,14*4,1);
  }
  if(hitrow<0){
    po_k0(W,K,S,cfg,s,r);
    po_k1(W,K,S,s,r);
    po_k2(W,K,S,s,r);
    po_k3(W,K,S,s,r);
    po_k4(W,K,S,s,r);
    po_k5(W,K,S,cfg,s,r);
    let j:i32=0;
    while(j<6){ po_price(S,cfg,j); j=j+1; }
    let av:i32=0; let z:i32=0;
    while(z<6){
      po_set32(O,(16+z)*4,po_cav(S,z));
      if(po_cav(S,z)==1){ av=av+1; }
      z=z+1;
    }
    po_set32(O,6*4,av);
    let b:i32=-1; let bu:i32=0; let bc:i32=0; let bx:i32=0;
    let t:i32=0;
    while(t<6){
      let idx:i32=po_corder(t,po_cfg(cfg,5));
      let u:i32=po_sg(S,po_cf(idx,4));
      let c:i32=po_sg(S,po_cf(idx,5));
      let take:i32=0;
      let thi:i32=0;
      if(po_cfg(cfg,6)==1){ thi=1; }
      let tie:i32=0;
      if(b>=0 && u==bu && c==bc){ tie=1; }
      if(po_cav(S,idx)==1){
        if(b<0){ take=1; }
        if(b>=0 && u>bu){ take=1; }
        if(b>=0 && u==bu && c<bc){ take=1; }
        if(tie==1 && thi==0 && idx<bx){ take=1; }
        if(tie==1 && thi==1 && idx>bx){ take=1; }
      }
      if(take==1){ b=idx; bu=u; bc=c; bx=idx; }
      t=t+1;
    }
    po_set32(O,26*4,t);
    po_set32(O,12*4,bu);
    po_set32(O,13*4,po_cct(S,bx));
    po_set32(O,14*4,bc);
    po_set32(O,15*4,po_sg(S,23));
    po_set32(O,22*4,po_cct(S,5));
    po_set32(O,23*4,po_sg(S,17));
    po_set32(O,27*4,po_sg(S,16));
    if(b<0){ po_set32(O,0*4,-1); po_set32(O,1*4,1); po_set32(O,5*4,po_get32(K,po_ki(0))); po_set32(O,25*4,po_maxlive(W)); return; }
    po_exec(W,K,S,s,r,b,R);
    po_set32(O,0*4,b);
    po_set32(O,2*4,po_get32(R,4*4));
    po_set32(O,3*4,po_get32(R,5*4));
    po_set32(O,7*4,po_get32(R,3*4));
    po_set32(O,8*4,po_get32(R,0*4));
    po_set32(O,9*4,po_get32(R,1*4));
    po_set32(O,10*4,po_get32(R,2*4));
    po_set32(O,24*4,po_csu(S,5)+1);
    po_set32(O,4*4,po_get32(R,3*4));
    if(po_csu(S,b)<1){ po_set32(O,1*4,3); } else { po_set32(O,1*4,0); }
    if(po_cfg(cfg,1)==1){ po_mwrite(W,s,r,b); }
    if(po_cfg(cfg,0)==1 && po_sg(S,23)==1){
      po_push(W,s,r,po_get32(R,0*4));
    }
  }
  po_set32(O,5*4,po_get32(K,po_ki(0)));
  po_set32(O,25*4,po_maxlive(W));
  po_set32(O,28*4,po_get32(K,po_ki(4)));
  po_set32(O,29*4,po_get32(K,po_ki(6)));
  return;
}// po_main.zag -- PREDICT-OPTIONALITY, fixture side, grader, baselines,
// ablations and bars. Concatenated AFTER po_learner.zag to form po_full.zag.
//
// This file, and only this file, knows which row means which route:
//
//   row 0 RETRIEVE   row 1 DERIVE   row 2 CONSTRAIN
//   row 3 INQUIRE    row 4 CONSTRUCT   row 5 PREDICT
//
// It also owns the two bands the learner never sees: band 8 holds the case
// code, band 9 holds the expected row. With the argument "nolabel" those two
// bands are never written at all, and the binary is otherwise unmodified, so
// the choice vector can be compared with the grader erased (K-NOLABEL-RUN).

fn e(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn n(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let cnt:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; cnt=cnt+1; }
  let end:i32=c+neg+cnt; let p:i32=end-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return end;
}
fn ns(b:[]u8,c:i32,lab:[]u8,v:i64)i32 {
  let d:i32=e(b,c,lab); return n(b,d,v);
}
fn nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn out(ob:[]u8,cc:i32)i32 {
  if(cc<58000){ return cc; }
  _zag_print(ob[0..cc]);
  return 0;
}
fn rname(i:i32)[]u8 {
  if(i==0){ return "RETRIEVE"; }
  if(i==1){ return "DERIVE"; }
  if(i==2){ return "CONSTRAIN"; }
  if(i==3){ return "INQUIRE"; }
  if(i==4){ return "CONSTRUCT"; }
  if(i==5){ return "PREDICT"; }
  return "DECLINE";
}
fn zwipe(b:[]u8)void {
  let i:i32=0;
  while(i<b.len){ b[i]=0; i=i+1; }
  return;
}
fn vec(ob:[]u8,c:i32,C:[]u8)i32 {
  let i:i32=0;
  while(i<6){
    if(i>0){ c=e(ob,c," "); }
    c=n(ob,c,po_get32(C,i*4) as i64);
    i=i+1;
  }
  return c;
}
fn same6(a:[]u8,b:[]u8)i32 {
  let i:i32=0;
  while(i<6){
    if(po_get32(a,i*4)!=po_get32(b,i*4)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn barline(ob:[]u8,c:i32,nm:[]u8,ok:i32)i32 {
  c=e(ob,c,"BAR "); c=e(ob,c,nm); c=e(ob,c," ");
  if(ok!=0){ c=e(ob,c,"PASS"); } else { c=e(ob,c,"FAIL"); }
  return nl(ob,c);
}

// ---- descriptor table: one flat record list, one slice per fixture ------
fn dtn(D:[]u8)i32 { return po_get32(D,2800); }
fn dtc(D:[]u8)void { po_set32(D,2800,dtn(D)+1); return; }
fn dtcl(D:[]u8)void { po_set32(D,2800,0); return; }
fn dadd(D:[]u8,k:i32,a:i32,b:i32,c:i32,w:i32,z:i32,p:i32,q:i32)void {
  let o:i32=dtn(D)*32;
  po_set32(D,o,k); po_set32(D,o+4,a); po_set32(D,o+8,b); po_set32(D,o+12,c);
  po_set32(D,o+16,w); po_set32(D,o+20,z); po_set32(D,o+24,p); po_set32(D,o+28,q);
  dtc(D);
  return;
}
fn dgf(D:[]u8,i:i32,f:i32)i32 { return po_get32(D,i*32+f*4); }

fn mk_obs(W:[]u8,s:i32,r:i32,v:i32)void {
  if(po_live(W,0)>=256){ return; }
  let id:i32=po_nxt(W,0); let o:i32=po_rec(0,id);
  let q:i32=0; let i:i32=0;
  while(i<id){ if(po_ng(W,po_rec(0,i),4)>q){ q=po_ng(W,po_rec(0,i),4); } i=i+1; }
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,v); po_sn(W,o,3,id); po_sn(W,o,4,q+1);
  po_setnxt(W,0,id+1); po_setlive(W,0,id+1);
  return;
}
fn mk_phi(W:[]u8,r:i32,hit:i32,v:i32,wt:i32)void {
  if(po_live(W,4)>=256){ return; }
  let id:i32=po_nxt(W,4); let o:i32=po_rec(4,id);
  po_sn(W,o,0,r); po_sn(W,o,1,hit); po_sn(W,o,2,v); po_sn(W,o,3,wt);
  po_setnxt(W,4,id+1); po_setlive(W,4,id+1);
  return;
}
fn mk_con(W:[]u8,s:i32,crel:i32,v:i32)void {
  if(po_live(W,2)>=256){ return; }
  let id:i32=po_nxt(W,2); let o:i32=po_rec(2,id);
  po_sn(W,o,0,s); po_sn(W,o,1,crel); po_sn(W,o,2,v);
  po_setnxt(W,2,id+1); po_setlive(W,2,id+1);
  return;
}
fn mk_prb(W:[]u8,r:i32,price:i32,tr:i32,hi:i32,v:i32)void {
  if(po_live(W,3)>=256){ return; }
  let id:i32=po_nxt(W,3); let o:i32=po_rec(3,id);
  po_sn(W,o,0,r); po_sn(W,o,1,price); po_sn(W,o,2,tr); po_sn(W,o,3,hi); po_sn(W,o,4,v);
  po_setnxt(W,3,id+1); po_setlive(W,3,id+1);
  return;
}
// support leaves are resolved by CONTENT (relation and value), never by
// insertion position, so a reversed build yields the same closure.
fn mk_der(W:[]u8,s:i32,r:i32,v:i32,n:i32,rl:i32,v0:i32,step:i32)void {
  if(po_live(W,1)>=256){ return; }
  let id:i32=po_nxt(W,1); let o:i32=po_rec(1,id);
  po_sn(W,o,0,s); po_sn(W,o,1,r); po_sn(W,o,2,v); po_sn(W,o,3,n);
  let got:i32=0; let i:i32=0;
  while(got<n && i<po_live(W,0)){
    let q:i32=po_rec(0,i);
    if(po_ng(W,q,1)==rl && po_ng(W,q,2)==v0+got*step){
      po_sn(W,o,5+got,i); got=got+1;
    }
    i=i+1;
  }
  po_sn(W,o,4,got);
  po_setnxt(W,1,id+1); po_setlive(W,1,id+1);
  return;
}
fn replay(W:[]u8,D:[]u8,i0:i32,i1:i32,rev:i32,ds:i32,dr:i32)void {
  let i:i32=0;
  if(rev==0){ i=i0; } else { i=i1-1; }
  while(i>=i0 && i<i1){
    let k:i32=dgf(D,i,0);
    if(k==1){ mk_obs(W,dgf(D,i,1)+ds,dgf(D,i,2)+dr,dgf(D,i,3)); }
    if(k==2){ mk_phi(W,dgf(D,i,1)+dr,dgf(D,i,2),dgf(D,i,3),dgf(D,i,4)); }
    if(k==3){ mk_con(W,dgf(D,i,1)+ds,dgf(D,i,2)+dr,dgf(D,i,3)); }
    if(k==4){ mk_prb(W,dgf(D,i,1)+dr,dgf(D,i,2),dgf(D,i,3),dgf(D,i,4),dgf(D,i,5)); }
    if(k==5){ mk_der(W,dgf(D,i,1)+ds,dgf(D,i,2)+dr,dgf(D,i,3),dgf(D,i,4),dgf(D,i,5)+dr,dgf(D,i,6),dgf(D,i,7)); }
    if(rev==0){ i=i+1; } else { i=i-1; }
  }
  return;
}

fn qs(i:i32,ds:i32)i32 {
  if(i==0){ return 7+ds; }
  if(i==1){ return 1+ds; }
  if(i==2){ return 9+ds; }
  if(i==3){ return 5+ds; }
  if(i==4){ return 2+ds; }
  return 4+ds;
}
fn qr(i:i32,dr:i32)i32 {
  if(i==0){ return 10+dr; }
  if(i==1){ return 30+dr; }
  if(i==2){ return 40+dr; }
  if(i==3){ return 50+dr; }
  if(i==4){ return 60+dr; }
  return 70+dr;
}
fn qexp(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 2; }
  if(i==3){ return 5; }
  if(i==4){ return 3; }
  return 4;
}
fn dn(i:i32)i32 {
  if(i==0){ return 7; }
  if(i==1){ return 10; }
  if(i==2){ return 11; }
  if(i==3){ return 12; }
  if(i==4){ return 5; }
  return 10;
}
fn dstart(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 7; }
  if(i==2){ return 17; }
  if(i==3){ return 28; }
  if(i==4){ return 40; }
  return 45;
}
// ---- the six frozen fixtures, one flat descriptor list -------------------
fn build_fixtures(D:[]u8)void {
  dtcl(D);
  // 1: query 7/10. One addressed record. Relation posterior 8/8 over 6 entries.
  dadd(D,1,7,10,42,0,0,0,0);
  dadd(D,2,10,1,999,2,0,0,0);
  dadd(D,2,10,1,999,2,0,0,0);
  dadd(D,2,10,1,999,1,0,0,0);
  dadd(D,2,10,1,999,1,0,0,0);
  dadd(D,2,10,1,999,1,0,0,0);
  dadd(D,2,10,1,999,1,0,0,0);
  // 2: query 1/30. Closure of two witnessed leaves. Channel priced 3.
  dadd(D,1,1,10,3,0,0,0,0);
  dadd(D,1,3,10,5,0,0,0,0);
  dadd(D,5,1,30,5,2,10,3,2);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,2,30,1,999,1,0,0,0);
  dadd(D,4,30,3,5,5,777,0,0);
  // 3: query 9/40. Four restrictions. Feasible set of one. Channel priced 8.
  dadd(D,3,9,10,2,0,0,0,0);
  dadd(D,3,9,11,6,0,0,0,0);
  dadd(D,3,9,12,3,0,0,0,0);
  dadd(D,3,9,13,5,0,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,2,40,1,999,1,0,0,0);
  dadd(D,4,40,8,5,5,888,0,0);
  // 4: query 5/50. Nothing addressed. No channel. Posterior 3/12.
  dadd(D,2,50,1,77,1,0,0,0);
  dadd(D,2,50,1,77,1,0,0,0);
  dadd(D,2,50,1,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  dadd(D,2,50,0,77,1,0,0,0);
  // 5: query 2/60. Nothing addressed. Posterior 0/4. Channel priced 2.
  dadd(D,2,60,0,88,1,0,0,0);
  dadd(D,2,60,0,88,1,0,0,0);
  dadd(D,2,60,0,88,1,0,0,0);
  dadd(D,2,60,0,88,1,0,0,0);
  dadd(D,4,60,2,5,5,666,0,0);
  // 6: query 4/70. Four addressed records. No channel.
  dadd(D,1,4,70,11,0,0,0,0);
  dadd(D,1,4,70,13,0,0,0,0);
  dadd(D,1,4,70,17,0,0,0,0);
  dadd(D,1,4,70,19,0,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  dadd(D,2,70,1,999,1,0,0,0);
  return;
}
fn write_grader(W:[]u8,i:i32)void {
  let id:i32=po_nxt(W,9); let o:i32=po_rec(9,id);
  po_sn(W,o,0,i); po_sn(W,o,1,qexp(i));
  po_setnxt(W,9,id+1); po_setlive(W,9,id+1);
  let j:i32=po_nxt(W,8); let p:i32=po_rec(8,j);
  po_sn(W,p,0,i); po_sn(W,p,1,i+1);
  po_setnxt(W,8,j+1); po_setlive(W,8,j+1);
  return;
}
fn build6(W:[]u8,D:[]u8,ds:i32,dr:i32,rev:i32,gr:i32)void {
  zwipe(W);
  let i:i32=0;
  while(i<6){ replay(W,D,dstart(i),dstart(i)+dn(i),rev,ds,dr); i=i+1; }
  if(gr==1){ let j:i32=0; while(j<6){ write_grader(W,j); j=j+1; } }
  return;
}

fn ask(W:[]u8,S:[]u8,K:[]u8,R:[]u8,cfg:[]u8,s:i32,r:i32,V:[]u8)void {
  zwipe(K);
  po_run(W,S,K,R,cfg,s,r,V);
  return;
}
fn cfgdef(cfg:[]u8)void {
  po_set32(cfg,0*4,0); po_set32(cfg,1*4,1); po_set32(cfg,2*4,0);
  po_set32(cfg,3*4,0); po_set32(cfg,4*4,8); po_set32(cfg,5*4,0);
  po_set32(cfg,6*4,0);
  return;
}
fn setcfg(cfg:[]u8,a:i32,b:i32,cc:i32,d:i32,w:i32,o:i32)void {
  po_set32(cfg,0*4,a); po_set32(cfg,1*4,b); po_set32(cfg,2*4,cc);
  po_set32(cfg,3*4,d); po_set32(cfg,4*4,w); po_set32(cfg,5*4,o);
  po_set32(cfg,6*4,0);
  return;
}
fn setcfg6(cfg:[]u8,a:i32,b:i32,cc:i32,d:i32,w:i32,o:i32,t:i32)void {
  po_set32(cfg,0*4,a); po_set32(cfg,1*4,b); po_set32(cfg,2*4,cc);
  po_set32(cfg,3*4,d); po_set32(cfg,4*4,w); po_set32(cfg,5*4,o);
  po_set32(cfg,6*4,t);
  return;
}
fn arm(W:[]u8,S:[]u8,K:[]u8,R:[]u8,cfg:[]u8,D:[]u8,V:[]u8,ds:i32,dr:i32,rev:i32,gr:i32,C:[]u8)void {
  build6(W,D,ds,dr,rev,gr);
  let i:i32=0;
  while(i<6){
    ask(W,S,K,R,cfg,qs(i,ds),qr(i,dr),V);
    po_set32(C,i*4,po_get32(V,0*4));
    i=i+1;
  }
  return;
}

fn main()i32 {
  let argc:i32=_zag_argc();
  let nolab:i32=0;
  if(argc>1){ nolab=1; }
  let gr:i32=1-nolab;
  let ob:[]u8=po_alloc(65536);
  let c:i32=0;
  let W:[]u8=po_alloc(po_wsz());
  let S:[]u8=po_alloc(po_swsz());
  let K:[]u8=po_alloc(512);
  let R:[]u8=po_alloc(64);
  let D:[]u8=po_alloc(8448);
  let cfg:[]u8=po_alloc(64);
  let V:[]u8=po_alloc(128);
  let BR:[]u8=po_alloc(256);
  let C:[]u8=po_alloc(64);
  let C2:[]u8=po_alloc(64);
  let C3:[]u8=po_alloc(64);
  let SW0:[]u8=po_alloc(64);
  let SW1:[]u8=po_alloc(64);
  let SW2:[]u8=po_alloc(64);
  let OA:[]u8=po_alloc(64);
  let OB2:[]u8=po_alloc(64);
  let OC:[]u8=po_alloc(64);
  let OD:[]u8=po_alloc(64);
  let NA:[]u8=po_alloc(64);
  let NB:[]u8=po_alloc(64);
  let NC:[]u8=po_alloc(64);
  let ND:[]u8=po_alloc(64);
  build_fixtures(D);

  c=e(ob,c,"PREDICT-OPTIONALITY\n");
  c=e(ob,c,"ROWMAP 0=RETRIEVE 1=DERIVE 2=CONSTRAIN 3=INQUIRE 4=CONSTRUCT 5=PREDICT\n");
  c=ns(ob,c,"NOLABEL ",nolab as i64); c=nl(ob,c);
  if(nolab==0){ c=e(ob,c,"GRADER_BANDS written\n"); } else { c=e(ob,c,"GRADER_BANDS unwritten\n"); }

  // =================== MAIN ARM ===================
  // One build, then one query per case, printed as it is asked. The memo is
  // live, but every case is a distinct (s,r) asked exactly once here, so no
  // case can be answered out of the memo.
  cfgdef(cfg);
  build6(W,D,0,0,0,gr);
  c=e(ob,c,"\n== MAIN ARM recency0 memo1 noprice0 priorwild0 wcost8 order0 tie0 ==\n");
  let i:i32=0;
  let stepsum:i32=0; let upcav:i32=0; let npred:i32=0;
  let pred0:i32=1; let ngot:i32=0; let visitsum:i32=0; let allocs:i32=0; let upcreal:i32=0;
  let verifs:i32=0; let wrongsteps:i32=0;
  while(i<6){
    ask(W,S,K,R,cfg,qs(i,0),qr(i,0),V);
    po_set32(C,i*4,po_get32(V,0*4));
    c=e(ob,c,"CASE"); c=n(ob,c,(i+1) as i64); c=e(ob,c," ");
    c=e(ob,c,rname(po_get32(V,0*4))); c=e(ob,c," val="); c=n(ob,c,po_get32(V,8*4) as i64);
    c=e(ob,c," steps="); c=n(ob,c,po_get32(V,2*4) as i64);
    c=e(ob,c," allocs="); c=n(ob,c,po_get32(V,3*4) as i64);
    c=e(ob,c," verifs="); c=n(ob,c,po_get32(V,4*4) as i64);
    c=e(ob,c," visits="); c=n(ob,c,po_get32(V,5*4) as i64);
    c=e(ob,c," searches="); c=n(ob,c,po_get32(V,6*4) as i64);
    c=e(ob,c," support="); c=n(ob,c,po_get32(V,7*4) as i64);
    c=e(ob,c," util="); c=n(ob,c,po_get32(V,12*4) as i64);
    c=e(ob,c," cert="); c=n(ob,c,po_get32(V,13*4) as i64);
    c=e(ob,c," cost="); c=n(ob,c,po_get32(V,14*4) as i64);
    c=e(ob,c," arity="); c=n(ob,c,po_get32(V,9*4) as i64);
    c=e(ob,c," predsteps="); c=n(ob,c,po_get32(V,28*4) as i64);
    c=e(ob,c," predpriced="); c=n(ob,c,po_get32(V,29*4) as i64);
    c=e(ob,c," upc_avoided="); c=n(ob,c,po_get32(V,24*4) as i64);
    c=e(ob,c," decline="); c=n(ob,c,po_get32(V,1*4) as i64);
    c=e(ob,c," open=");
    let z:i32=0;
    while(z<6){ c=n(ob,c,po_get32(V,(16+z)*4) as i64); if(z<5){ c=e(ob,c,","); } z=z+1; }
    c=nl(ob,c);
    c=out(ob,c);
    stepsum=stepsum+po_get32(V,2*4);
    visitsum=visitsum+po_get32(V,5*4);
    allocs=allocs+po_get32(V,3*4);
    verifs=verifs+po_get32(V,4*4);
    if(nolab==0){
      if(po_get32(V,0*4)!=qexp(i)){ wrongsteps=wrongsteps+po_get32(V,2*4); }
    }
    if(po_get32(C,i*4)==5){ npred=npred+1; }
    if(i!=3 && i!=4 && po_get32(C,i*4)!=5){ ngot=ngot+1; }
    if(po_get32(C,i*4)!=5){ upcav=upcav+po_get32(V,24*4); upcreal=upcreal+po_get32(V,28*4); }
    if(i!=3 && po_get32(V,28*4)!=0){ pred0=0; }
    i=i+1;
  }
  c=e(ob,c,"VEC "); c=vec(ob,c,C); c=nl(ob,c);
  if(nolab==0){
    c=e(ob,c,"EXPECT ");
    let xi:i32=0;
    while(xi<6){
      if(xi>0){ c=e(ob,c," "); }
      c=n(ob,c,qexp(xi) as i64);
      xi=xi+1;
    }
    c=nl(ob,c);
  }
  c=e(ob,c,"VEC_END\n");
  let ok:i32=0;
  i=0;
  while(i<6){ if(po_get32(C,i*4)==qexp(i)){ ok=ok+1; } i=i+1; }
  if(nolab==0){ c=ns(ob,c,"CASE_MATCH ",ok as i64); c=e(ob,c,"/6"); c=nl(ob,c); }
  po_set32(BR,0*4,ok);
  c=ns(ob,c,"TOTAL_STEPS ",stepsum as i64); c=nl(ob,c);
  c=ns(ob,c,"TOTAL_ALLOCS ",allocs as i64); c=nl(ob,c);
  c=ns(ob,c,"TOTAL_VERIFS ",verifs as i64); c=nl(ob,c);
  c=ns(ob,c,"TOTAL_VISITS ",visitsum as i64); c=nl(ob,c);
  c=ns(ob,c,"NOPREDICT_GOT ",ngot as i64); c=e(ob,c,"/4"); c=nl(ob,c);
  c=ns(ob,c,"UPC_AVOIDED ",upcav as i64); c=nl(ob,c);
  c=ns(ob,c,"UPC_REALIZED ",upcreal as i64); c=nl(ob,c);
  c=ns(ob,c,"WASTED_STEPS ",wrongsteps as i64); c=nl(ob,c);
  c=ns(ob,c,"NOPRED_ZERO_STEPS ",pred0 as i64); c=nl(ob,c);
  po_set32(BR,8*4,pred0);

  c=e(ob,c,"SET6 arity="); c=n(ob,c,po_get32(V,9*4) as i64);
  c=e(ob,c," node="); c=n(ob,c,po_get32(V,10*4) as i64);
  c=e(ob,c," values=");
  let sn:i32=po_get32(V,10*4);
  let ar6:i32=po_get32(V,9*4);
  let hd:i32=-1;
  if(sn>=0){ hd=po_ng(W,po_rec(6,sn),2); }
  let q:i32=0;
  while(q<ar6){
    if(hd>=0){
      c=n(ob,c,po_ng(W,po_rec(7,hd),0) as i64);
      if(q<ar6-1){ c=e(ob,c,","); }
      hd=po_ng(W,po_rec(7,hd),1);
    }
    q=q+1;
  }
  c=nl(ob,c);
  c=out(ob,c);

  // =================== MEMO BAR ===================
  c=e(ob,c,"\n== MEMO BAR (repeat query, memo on vs memo off) ==\n");
  setcfg(cfg,0,1,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C2);
  let so:i32=0; let ao:i32=0; let vo:i32=0;
  i=0;
  while(i<6){
    ask(W,S,K,R,cfg,qs(i,0),qr(i,0),V);
    po_set32(C2,i*4,po_get32(V,0*4));
    so=so+po_get32(V,2*4); ao=ao+po_get32(V,3*4); vo=vo+po_get32(V,6*4);
    i=i+1;
  }
  c=e(ob,c,"REPEAT_MEMO_ON vec="); c=vec(ob,c,C2);
  c=e(ob,c," steps="); c=n(ob,c,so as i64);
  c=e(ob,c," allocs="); c=n(ob,c,ao as i64);
  c=e(ob,c," searches="); c=n(ob,c,vo as i64); c=nl(ob,c);
  setcfg(cfg,0,0,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C3);
  let sf:i32=0; let af:i32=0; let vf:i32=0;
  i=0;
  while(i<6){
    ask(W,S,K,R,cfg,qs(i,0),qr(i,0),V);
    po_set32(C3,i*4,po_get32(V,0*4));
    sf=sf+po_get32(V,2*4); af=af+po_get32(V,3*4); vf=vf+po_get32(V,6*4);
    i=i+1;
  }
  c=e(ob,c,"REPEAT_MEMO_OFF vec="); c=vec(ob,c,C3);
  c=e(ob,c," steps="); c=n(ob,c,sf as i64);
  c=e(ob,c," allocs="); c=n(ob,c,af as i64);
  c=e(ob,c," searches="); c=n(ob,c,vf as i64); c=nl(ob,c);
  let memoid:i32=same6(C2,C3);
  let memorise:i32=0;
  if(sf+af>=so+ao){ memorise=1; }
  po_set32(BR,1*4,memoid);
  po_set32(BR,2*4,memorise);
  c=out(ob,c);

  // =================== ABLATIONS ===================
  c=e(ob,c,"\n== ABLATIONS ==\n");
  setcfg(cfg,0,1,1,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C2);
  let npsum:i32=0;
  i=0;
  while(i<6){ npsum=npsum+po_get32(V,2*4); i=i+1; }
  c=e(ob,c,"ABL_NOPRICE vec="); c=vec(ob,c,C2);
  c=e(ob,c," total_steps="); c=n(ob,c,npsum as i64); c=nl(ob,c);
  po_set32(BR,9*4,stepsum-npsum);
  setcfg(cfg,0,1,0,1,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C3);
  let pwsum:i32=0;
  i=0;
  while(i<6){ pwsum=pwsum+po_get32(V,2*4); i=i+1; }
  c=e(ob,c,"ABL_PRIORWILD vec="); c=vec(ob,c,C3);
  c=e(ob,c," total_steps="); c=n(ob,c,pwsum as i64); c=nl(ob,c);
  setcfg(cfg,0,1,0,0,8,0);
  c=out(ob,c);

  // =================== PRICE WEIGHT SWEEP ===================
  c=e(ob,c,"\n== W_COST SWEEP ==\n");
  setcfg(cfg,0,1,0,0,4,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,SW0);
  c=e(ob,c,"WCOST 4 vec="); c=vec(ob,c,SW0); c=nl(ob,c);
  setcfg(cfg,0,1,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,SW1);
  c=e(ob,c,"WCOST 8 vec="); c=vec(ob,c,SW1); c=nl(ob,c);
  setcfg(cfg,0,1,0,0,16,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,SW2);
  c=e(ob,c,"WCOST 16 vec="); c=vec(ob,c,SW2); c=nl(ob,c);
  let swok:i32=same6(SW0,C);
  if(same6(SW1,C)==0){ swok=0; }
  if(same6(SW2,C)==0){ swok=0; }
  po_set32(BR,10*4,swok);
  c=out(ob,c);

  // =================== SCAN ORDER =================
  c=e(ob,c,"\n== SCAN ORDER BAR ==\n");
  setcfg(cfg,0,1,0,0,8,1);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,OA);
  setcfg(cfg,0,1,0,0,8,2);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,OB2);
  setcfg(cfg,0,1,0,0,8,3);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,OC);
  c=e(ob,c,"ORDER1 vec="); c=vec(ob,c,OA); c=nl(ob,c);
  c=e(ob,c,"ORDER2 vec="); c=vec(ob,c,OB2); c=nl(ob,c);
  c=e(ob,c,"ORDER3 vec="); c=vec(ob,c,OC); c=nl(ob,c);
  let ordok:i32=same6(OA,C);
  if(same6(OB2,C)==0){ ordok=0; }
  if(same6(OC,C)==0){ ordok=0; }
  po_set32(BR,11*4,ordok);
  setcfg(cfg,0,1,1,0,8,1);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,NA);
  setcfg(cfg,0,1,1,0,8,2);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,NB);
  setcfg(cfg,0,1,1,0,8,3);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,NC);
  setcfg(cfg,0,1,1,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,ND);
  c=e(ob,c,"ORDER_NOPRICE0 vec="); c=vec(ob,c,ND); c=nl(ob,c);
  c=e(ob,c,"ORDER_NOPRICE1 vec="); c=vec(ob,c,NA); c=nl(ob,c);
  c=e(ob,c,"ORDER_NOPRICE2 vec="); c=vec(ob,c,NB); c=nl(ob,c);
  c=e(ob,c,"ORDER_NOPRICE3 vec="); c=vec(ob,c,NC); c=nl(ob,c);
  let nordok:i32=same6(NA,ND);
  if(same6(NB,ND)==0){ nordok=0; }
  if(same6(NC,ND)==0){ nordok=0; }
  po_set32(BR,12*4,nordok);
  c=out(ob,c);

  // =================== DIFFICULTY ===================
  c=e(ob,c,"\n== DIFFICULTY BAR ==\n");
  let dd:i32=1; let mono:i32=1; let prev:i32=-1; let alld:i32=1;
  while(dd<6){
    zwipe(W);
    mk_phi(W,2101,1,999,1); mk_phi(W,2101,1,999,1);
    mk_phi(W,2101,1,999,1); mk_phi(W,2101,1,999,1);
    mk_phi(W,2101,1,999,1); mk_phi(W,2101,1,999,1);
    let t:i32=0;
    while(t<dd){ mk_obs(W,2000-t,2101,900+t); t=t+1; }
    mk_der(W,2001,2101,950,dd,2101,900,1);
    setcfg(cfg,0,0,0,0,8,0);
    ask(W,S,K,R,cfg,2001,2101,V);
    c=ns(ob,c,"DER_DEPTH ",dd as i64); c=e(ob,c," route=");
    c=e(ob,c,rname(po_get32(V,0*4)));
    c=e(ob,c," steps="); c=n(ob,c,po_get32(V,2*4) as i64);
    c=e(ob,c," util="); c=n(ob,c,po_get32(V,12*4) as i64);
    c=e(ob,c," searches="); c=n(ob,c,po_get32(V,6*4) as i64);
    c=e(ob,c," cert="); c=n(ob,c,po_get32(V,13*4) as i64);
    c=e(ob,c," open=");
    let z2:i32=0;
    while(z2<6){ c=n(ob,c,po_get32(V,(16+z2)*4) as i64); if(z2<5){ c=e(ob,c,","); } z2=z2+1; }
    c=nl(ob,c);
    if(po_get32(V,0*4)!=1){ alld=0; }
    if(po_get32(V,2*4)<=prev){ mono=0; }
    prev=po_get32(V,2*4);
    dd=dd+1;
  }
  let psteps:[]u8=po_alloc(32);
  let pk:i32=0; let padconst:i32=1; let padret:i32=1;
  while(pk<4){
    zwipe(W);
    mk_obs(W,2002,2102,4242);
    mk_phi(W,2102,1,999,1); mk_phi(W,2102,1,999,1);
    mk_phi(W,2102,1,999,1); mk_phi(W,2102,1,999,1);
    mk_phi(W,2102,1,999,1); mk_phi(W,2102,1,999,1);
    let t:i32=0;
    while(t<pk*4){ mk_obs(W,3000+t,2199,500+t); t=t+1; }
    setcfg(cfg,0,0,0,0,8,0);
    ask(W,S,K,R,cfg,2002,2102,V);
    po_set32(psteps,pk*4,po_get32(V,2*4));
    if(po_get32(V,0*4)!=0){ padret=0; }
    c=ns(ob,c,"KNOWN_PAD ",(pk*4) as i64); c=e(ob,c," route=");
    c=e(ob,c,rname(po_get32(V,0*4)));
    c=e(ob,c," steps="); c=n(ob,c,po_get32(V,2*4) as i64);
    c=e(ob,c," util="); c=n(ob,c,po_get32(V,12*4) as i64);
    c=e(ob,c," searches="); c=n(ob,c,po_get32(V,6*4) as i64);
    c=e(ob,c," visits="); c=n(ob,c,po_get32(V,5*4) as i64);
    c=e(ob,c," cert="); c=n(ob,c,po_get32(V,13*4) as i64);
    c=nl(ob,c);
    pk=pk+1;
  }
  if(po_get32(psteps,0*4)!=po_get32(psteps,1*4)){ padconst=0; }
  if(po_get32(psteps,1*4)!=po_get32(psteps,2*4)){ padconst=0; }
  if(po_get32(psteps,2*4)!=po_get32(psteps,3*4)){ padconst=0; }
  po_set32(BR,13*4,mono);
  po_set32(BR,14*4,alld);
  po_set32(BR,15*4,padconst*padret);
  c=out(ob,c);

  // =================== ISOMORPH ===================
  c=e(ob,c,"\n== ISOMORPH BAR ==\n");
  setcfg(cfg,0,1,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,140,140,0,gr,C2);
  c=e(ob,c,"ISO_RENAME vec="); c=vec(ob,c,C2); c=nl(ob,c);
  // Same rename, but the four constraint-operator codes are restored. The
  // operator codes are part of the representation language, not world
  // content; this localises any ISO_RENAME break to them.
  build6(W,D,140,140,0,gr);
  let oz:i32=0;
  while(oz<po_live(W,2)){
    let oo:i32=po_rec(2,oz);
    let cr:i32=po_ng(W,oo,1);
    if(cr>=150 && cr<154){ po_sn(W,oo,1,cr-140); }
    oz=oz+1;
  }
  let ai2:i32=0;
  while(ai2<6){
    ask(W,S,K,R,cfg,qs(ai2,140),qr(ai2,140),V);
    po_set32(C3,ai2*4,po_get32(V,0*4));
    ai2=ai2+1;
  }
  c=e(ob,c,"ISO_RENAME_KEEP_OPCODES vec="); c=vec(ob,c,C3); c=nl(ob,c);
  arm(W,S,K,R,cfg,D,V,0,0,1,gr,C3);
  c=e(ob,c,"ISO_REVERSE vec="); c=vec(ob,c,C3); c=nl(ob,c);
  let isosame:i32=same6(C2,C);
  if(same6(C3,C)==0){ isosame=0; }
  po_set32(BR,16*4,isosame);
  c=out(ob,c);
  // ---- per-case inspection, memo off, base world and full rename ----
  c=e(ob,c,"\n== PER-CASE CANDIDATE TABLES, memo off ==\n");
  let ai:i32=0;
  let dd2:i32=0;
  while(ai<2){
    build6(W,D,140*ai,140*ai,0,0);
    setcfg(cfg,0,1,0,0,8,0);
    dd2=0;
    while(dd2<6){
      zwipe(K);
      po_run(W,S,K,R,cfg,qs(dd2,140*ai),qr(dd2,140*ai),V);
      c=e(ob,c,"INSP"); c=n(ob,c,ai as i64); c=e(ob,c," case");
      c=n(ob,c,(dd2+1) as i64);
      c=e(ob,c," s="); c=n(ob,c,qs(dd2,140*ai) as i64);
      c=e(ob,c," r="); c=n(ob,c,qr(dd2,140*ai) as i64);
      c=e(ob,c," route="); c=e(ob,c,rname(po_get32(V,0*4)));
      c=e(ob,c," util="); c=n(ob,c,po_get32(V,12*4) as i64);
      c=e(ob,c," open/cert/cost=");
      let z9:i32=0;
      while(z9<6){
        c=e(ob,c,"["); c=n(ob,c,po_get32(V,(16+z9)*4) as i64);
        c=e(ob,c,","); c=n(ob,c,po_cct(S,z9) as i64);
        c=e(ob,c,","); c=n(ob,c,po_cco(S,z9) as i64); c=e(ob,c,"]");
        z9=z9+1;
      }
      c=nl(ob,c);
      c=out(ob,c);
      dd2=dd2+1;
    }
    ai=ai+1;
  }
  setcfg(cfg,0,1,0,0,8,0);

  // =================== RECENCY REPLICATION / FAKE KNOWN ===================
  c=e(ob,c,"\n== RECENCY REPLICATION BAR, never-taught subject 999 ==\n");
  zwipe(W);
  let t:i32=1;
  while(t<7){ mk_obs(W,t,10,7); t=t+1; }
  setcfg(cfg,0,1,0,0,8,0);
  ask(W,S,K,R,cfg,999,10,V);
  c=ns(ob,c,"MAIN open0=",po_get32(V,16*4) as i64);
  c=e(ob,c," route="); c=e(ob,c,rname(po_get32(V,0*4)));
  c=e(ob,c," reason="); c=n(ob,c,po_get32(V,1*4) as i64); c=nl(ob,c);
  let mainrefuse:i32=0;
  if(po_get32(V,16*4)==0){ mainrefuse=1; }
  setcfg(cfg,1,1,0,0,8,0);
  ask(W,S,K,R,cfg,999,10,V);
  c=ns(ob,c,"RECENCY open0=",po_get32(V,16*4) as i64);
  c=e(ob,c," route="); c=e(ob,c,rname(po_get32(V,0*4)));
  c=e(ob,c," val="); c=n(ob,c,po_get32(V,8*4) as i64);
  c=e(ob,c," fabricated="); c=n(ob,c,po_get32(V,15*4) as i64);
  c=e(ob,c," support="); c=n(ob,c,po_get32(V,7*4) as i64);
  c=e(ob,c," reason="); c=n(ob,c,po_get32(V,1*4) as i64); c=nl(ob,c);
  let fab:i32=0;
  if(po_get32(V,16*4)==1 && po_get32(V,15*4)==1){ fab=1; }
  po_set32(BR,17*4,mainrefuse*fab);
  c=out(ob,c);

  // =================== PRIOR ADVERSARIAL ===================
  c=e(ob,c,"\n== PRIOR ADVERSARIAL BAR, relation 70 ==\n");
  setcfg(cfg,0,0,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C2);
  let step:i32=0; let fell:i32=1; let last:i32=-1;
  while(step<4){
    if(step>0){
      let t2:i32=0;
      while(t2<6){ mk_phi(W,70,0,999,1); t2=t2+1; }
    }
    ask(W,S,K,R,cfg,qs(5,0),qr(5,0),V);
    let pc:i32=po_get32(V,22*4);
    c=ns(ob,c,"ADV_STEP ",step as i64);
    c=e(ob,c," prior_cert="); c=n(ob,c,pc as i64);
    c=e(ob,c," route="); c=e(ob,c,rname(po_get32(V,0*4)));
    c=e(ob,c," steps="); c=n(ob,c,po_get32(V,2*4) as i64);
    c=e(ob,c," util="); c=n(ob,c,po_get32(V,12*4) as i64);
    c=e(ob,c," cert="); c=n(ob,c,po_get32(V,13*4) as i64);
    c=e(ob,c," cost="); c=n(ob,c,po_get32(V,14*4) as i64);
    c=nl(ob,c);
    if(step>0){ if(pc>=last){ fell=0; } }
    last=pc;
    step=step+1;
  }
  po_set32(BR,18*4,fell);
  c=out(ob,c);

  // =================== STUPID BASELINES ===================
  c=e(ob,c,"\n== STUPID BASELINES ==\n");
  setcfg(cfg,0,1,0,0,8,0);
  arm(W,S,K,R,cfg,D,V,0,0,0,gr,C2);
  let bl:i32=0;
  while(bl<3){
    let hit:i32=0; let st:i32=0; let waste:i32=0;
    i=0;
    while(i<6){
      let s:i32=qs(i,0); let r:i32=qr(i,0);
      let route:i32=-1; let cost:i32=0;
      let t:i32=0;
      // A baseline that finds nothing FAILS (prereg section 8); it does not
      // silently inherit the row it would have liked to have used.
      if(bl==0){
        while(t<po_live(W,0)){
          if(po_ng(W,po_rec(0,t),0)==s && po_ng(W,po_rec(0,t),1)==r){ route=0; }
          cost=cost+1; t=t+1;
        }
      }
      if(bl==1){
        while(t<po_live(W,1)){
          if(po_ng(W,po_rec(1,t),0)==s && po_ng(W,po_rec(1,t),1)==r){ route=1; cost=po_ng(W,po_rec(1,t),4)+1; }
          t=t+1;
        }
        if(route<0){ cost=po_live(W,1); }
      }
      if(bl==2){
        route=5;
        while(t<po_live(W,4)){ if(po_ng(W,po_rec(4,t),0)==r){ cost=cost+1; } t=t+1; }
        cost=cost+1;
      }
      if(route==qexp(i)){ hit=hit+1; } else { waste=waste+cost; }
      st=st+cost;
      i=i+1;
    }
    c=ns(ob,c,"BASELINE ",bl as i64); c=e(ob,c," policy=");
    if(bl==0){ c=e(ob,c,"ALWAYS_RETRIEVE"); }
    if(bl==1){ c=e(ob,c,"ALWAYS_DERIVE"); }
    if(bl==2){ c=e(ob,c,"ALWAYS_PREDICT"); }
    c=e(ob,c," correct="); c=n(ob,c,hit as i64);
    c=e(ob,c,"/6 steps="); c=n(ob,c,st as i64);
    c=e(ob,c," wasted="); c=n(ob,c,waste as i64); c=nl(ob,c);
    bl=bl+1;
  }
  c=ns(ob,c,"LEARNER correct=",ok as i64); c=e(ob,c,"/6 steps="); c=n(ob,c,stepsum as i64);
  c=e(ob,c," visits="); c=n(ob,c,visitsum as i64);
  c=e(ob,c," wasted="); c=n(ob,c,wrongsteps as i64); c=nl(ob,c);
  c=out(ob,c);

  // =================== POST-HOC EXPLORATORY ABLATION ===================
  // NOT preregistered. Filed after PO_ABL_NOPRICE falsified: removing the
  // price term alone does not release unnecessary prediction, because the
  // frozen cost tie-break (prereg section 4) still separates the candidates
  // before the index tie-break is consulted. This switch removes the price
  // AND inverts the tie-break, which together are the mechanisms that
  // suppress prediction when knowledge already determines the answer.
  // Scored with the memo off so no case can be answered out of the memo.
  c=e(ob,c,"\n== POST-HOC EXPLORATORY: no price + tie prefers higher row ==\n");
  setcfg6(cfg,0,0,1,0,8,0,1);
  build6(W,D,0,0,0,gr);
  let xsum:i32=0; let xpred:i32=0; let xwrong:i32=0; let xupc:i32=0;
  let xd:i32=0;
  while(xd<6){
    ask(W,S,K,R,cfg,qs(xd,0),qr(xd,0),V);
    po_set32(C2,xd*4,po_get32(V,0*4));
    xsum=xsum+po_get32(V,2*4);
    if(po_get32(V,0*4)==5){ xpred=xpred+1; } else { xupc=xupc+po_get32(V,24*4); }
    if(po_get32(V,0*4)!=qexp(xd)){ xwrong=xwrong+1; }
    xd=xd+1;
  }
  c=e(ob,c,"X_TIEHIGH vec="); c=vec(ob,c,C2);
  c=e(ob,c," total_steps="); c=n(ob,c,xsum as i64);
  c=e(ob,c," predicted_on="); c=n(ob,c,xpred as i64);
  c=e(ob,c," of_6 wrong="); c=n(ob,c,xwrong as i64);
  c=e(ob,c," unnecessary_prediction_cost="); c=n(ob,c,xupc as i64); c=nl(ob,c);
  let xtie:i32=1;
  if(same6(C2,C)==1){ xtie=0; }
  c=ns(ob,c,"X_TIEHIGH differs_from_main ",xtie as i64); c=nl(ob,c);
  let xrise:i32=0;
  if(xsum>stepsum){ xrise=xsum-stepsum; }
  c=ns(ob,c,"X_TIEHIGH extra_steps_vs_main ",xrise as i64); c=nl(ob,c);
  c=out(ob,c);
  c=out(ob,c);

  // =================== STRUCTURAL BARS ===================
  c=e(ob,c,"\n== STRUCTURAL BARS ==\n");
  setcfg(cfg,0,0,0,0,8,0);
  build6(W,D,0,0,0,gr);
  let maxlv:i32=0; let nopseudo:i32=1; let supok:i32=1; let distinct4:i32=0;
  i=0;
  while(i<6){
    ask(W,S,K,R,cfg,qs(i,0),qr(i,0),V);
    if(po_get32(V,25*4)>maxlv){ maxlv=po_get32(V,25*4); }
    if(po_get32(V,1*4)==-2){ nopseudo=0; }
    if(po_get32(V,0*4)>=0 && po_get32(V,7*4)<1){ supok=0; }
    i=i+1;
  }
  if(po_get32(V,0*4)==4 && po_get32(V,9*4)==4){ distinct4=1; }
  c=ns(ob,c,"MAX_LIVE_RECORDS ",maxlv as i64); c=nl(ob,c);
  po_set32(BR,5*4,distinct4);
  po_set32(BR,6*4,supok);
  po_set32(BR,7*4,((maxlv<=256) && nopseudo) as i64);
  c=out(ob,c);

  // =================== BAR REPORT ===================
  c=e(ob,c,"\n== BARS ==\n");
  c=barline(ob,c,"K-CHOICES",po_get32(BR,0*4));
  c=barline(ob,c,"K-NOMEMO-IDENTITY",po_get32(BR,1*4));
  c=barline(ob,c,"K-NOMEMO-COSTRISE",po_get32(BR,2*4));
  c=barline(ob,c,"K-FAKEKNOWN",po_get32(BR,17*4));
  c=barline(ob,c,"K-PRIOR-ADVERSARIAL",po_get32(BR,18*4));
  c=barline(ob,c,"K-WIDE",po_get32(BR,5*4));
  c=barline(ob,c,"K-NOFAKE-SUCCESS",po_get32(BR,6*4));
  c=barline(ob,c,"K-DECLINE-DISTINCT",po_get32(BR,7*4));
  c=barline(ob,c,"K-NOPREDICT-1236",po_get32(BR,8*4));
  c=barline(ob,c,"K-DIFFICULTY-MONO",po_get32(BR,13*4));
  c=barline(ob,c,"K-DIFFICULTY-DERIVE",po_get32(BR,14*4));
  c=barline(ob,c,"K-DIFFICULTY-CONST",po_get32(BR,15*4));
  c=barline(ob,c,"K-ISOMORPH",po_get32(BR,16*4));
  c=barline(ob,c,"K-WCOST-SWEEP",po_get32(BR,10*4));
  c=barline(ob,c,"K-COSTORDER",po_get32(BR,11*4));
  c=barline(ob,c,"K-COSTORDER-NOPRICE",po_get32(BR,12*4));
  c=ns(ob,c,"K-UPC-AVOIDED ",upcav as i64); c=nl(ob,c);
  c=ns(ob,c,"K-UPC-REALIZED ",upcreal as i64); c=nl(ob,c);
  c=ns(ob,c,"K-NOLABEL-RUN see po_nolabel.txt; identical VEC lines required",0 as i64); c=nl(ob,c);
  c=ns(ob,c,"POSTHOC_X_TIEHIGH differs ",xtie as i64); c=nl(ob,c);
  let npass:i32=0;
  let bi:i32=0;
  while(bi<16){
    let sl:i32=bi;
    if(bi==3){ sl=5; }
    if(bi==4){ sl=6; }
    if(bi==5){ sl=7; }
    if(bi==6){ sl=8; }
    if(bi==7){ sl=10; }
    if(bi==8){ sl=11; }
    if(bi==9){ sl=12; }
    if(bi==10){ sl=13; }
    if(bi==11){ sl=14; }
    if(bi==12){ sl=15; }
    if(bi==13){ sl=16; }
    if(bi==14){ sl=17; }
    if(bi==15){ sl=18; }
    let bv:i32=po_get32(BR,sl*4);
    if(bv!=0){ npass=npass+1; }
    bi=bi+1;
  }
  c=ns(ob,c,"BARS_PASS ",npass as i64); c=e(ob,c,"/16"); c=nl(ob,c);
  c=e(ob,c,"PO-END\n");
  _zag_print(ob[0..c]);
  return 0;
}

// invent.zag -- H-CONTLIFE-5 follow-up: learner-INVENTED revision procedure.
// Round 1: commit -> consequence -> judge (both arms), then REVISE
// (revision arm only): on self-judged failures run the learner-owned LOO
// attribution; licensed cases feed a learner-owned INVENTION SEARCH over
// compositions of generic ops (fit, exm, loo3, med, avg). The first
// composition passing the learner's own self-check (exact prediction of
// every licensed observed consequence) is adopted as data (instruction
// array in learner state). Round 2: fresh frozen cases; revision arm
// commits through a GENERIC interpreter running the adopted program when
// the flag is set and rmax > 0; control arm uses the frozen procedure.
// No researcher-specified revision procedure exists anywhere: the only
// revision content in the binary is the generic op set and the search.
// Roles by function boundary:
//   LEARNER: learner_commit, learner_judge, learner_attrib, learner_invent,
//     learner_interp, learner_commit2, loo_pred, exm_of, med_of_n, avg_of_n.
//     Values only, never a case id, never calls world_y / world_y2.
//   WORLD: world_y (round 1), world_y2 (round 2), x_world (exploratory),
//     called only from the P2/P6/exploratory paths in main.
//   HARNESS: agreements, bar checks, ablation, exploratory report, and the
//     quarantined reference procedure ref_medloo (REVISE procedure, for the
//     exploratory comparison only; never called by learner code).
// Prereg: hcontlife5-invent/PREREG-INVENT.md (frozen kill bars I0..I8).
// Round-1 and round-2 case tables below are copied VERBATIM from
// hcontlife5/src/revise.zag (diff-verified at build).
// Pitfall discipline: u8-backed cells with little-endian helpers, one
// preallocated output buffer with cursor-returning emit helpers, single
// raw-syscall flush, if-nesting at most 3, no !(A && B) in while guards.

// ---------- record layout (12 x i32 = 48 bytes per case) ----------
const F_P:i32=0;
const F_T:i32=4;
const F_RMAX:i32=8;
const F_YS:i32=12;
const F_SELF:i32=16;
const F_LIC:i32=20;
const F_TRG:i32=24;
const F_E1:i32=28;
const F_E2:i32=32;
const F_E3:i32=36;
const F_E4:i32=40;
const F_ERR:i32=44;
const F_SZ:i32=48;
const N:i32=24;

// instruction codes (fixed enumeration order: fit < exm < loo3 < med < avg)
const OP_FIT:i32=0;
const OP_EXM:i32=1;
const OP_LOO3:i32=2;
const OP_MED:i32=3;
const OP_AVG:i32=4;

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn abs32(v:i32)i32 {
  if(v<0){return 0-v;}
  return v;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn pow5i(e:i32)i32 {
  let r:i32=1;
  let k:i32=0;
  while(k<e){r=r*5;k=k+1;}
  return r;
}
fn case_y0(cid:i32)i32 {
  if(cid==0){return 0;} if(cid==1){return 3;} if(cid==2){return 7;}
  if(cid==3){return 9;} if(cid==4){return 0;} if(cid==5){return 2;}
  if(cid==6){return 5;} if(cid==7){return 8;} if(cid==8){return 0;}
  if(cid==9){return 1;} if(cid==10){return 2;} if(cid==11){return 3;}
  if(cid==12){return 0;} if(cid==13){return 1;} if(cid==14){return 0;}
  if(cid==15){return 4;} if(cid==16){return 2;} if(cid==17){return 1;}
  if(cid==18){return 7;} if(cid==19){return 5;} if(cid==20){return 1;}
  if(cid==21){return 2;} if(cid==22){return 0;} if(cid==23){return 1;}
  return 0;
}
fn case_y1(cid:i32)i32 {
  if(cid==0){return 1;} if(cid==1){return 5;} if(cid==2){return 10;}
  if(cid==3){return 10;} if(cid==4){return 2;} if(cid==5){return 5;}
  if(cid==6){return 6;} if(cid==7){return 10;} if(cid==8){return 1;}
  if(cid==9){return 2;} if(cid==10){return 3;} if(cid==11){return 4;}
  if(cid==12){return 1;} if(cid==13){return 3;} if(cid==14){return 3;}
  if(cid==15){return 5;} if(cid==16){return 4;} if(cid==17){return 4;}
  if(cid==18){return 8;} if(cid==19){return 7;} if(cid==20){return 3;}
  if(cid==21){return 5;} if(cid==22){return 3;} if(cid==23){return 4;}
  return 0;
}
fn case_y2(cid:i32)i32 {
  if(cid==0){return 2;} if(cid==1){return 7;} if(cid==2){return 13;}
  if(cid==3){return 11;} if(cid==4){return 4;} if(cid==5){return 8;}
  if(cid==6){return 7;} if(cid==7){return 12;} if(cid==8){return 4;}
  if(cid==9){return 5;} if(cid==10){return 6;} if(cid==11){return 7;}
  if(cid==12){return 2;} if(cid==13){return 5;} if(cid==14){return 6;}
  if(cid==15){return 6;} if(cid==16){return 6;} if(cid==17){return 7;}
  if(cid==18){return 9;} if(cid==19){return 9;} if(cid==20){return 6;}
  if(cid==21){return 9;} if(cid==22){return 4;} if(cid==23){return 5;}
  return 0;
}
fn case_xstar(cid:i32)i32 {
  if(cid<8){return 5;}
  if(cid<20){return 4;}
  if(cid<22){return 5;}
  return 4;
}
fn case_flavor(cid:i32)i32 {
  if(cid<8){return 0;}
  if(cid<12){return 1;}
  if(cid<20){return 2;}
  if(cid<22){return 3;}
  return 4;
}
fn world_y(cid:i32)i32 {
  if(cid==0){return 5;} if(cid==1){return 13;} if(cid==2){return 22;}
  if(cid==3){return 14;} if(cid==4){return 10;} if(cid==5){return 17;}
  if(cid==6){return 10;} if(cid==7){return 18;} if(cid==8){return 16;}
  if(cid==9){return 17;} if(cid==10){return 18;} if(cid==11){return 19;}
  if(cid==12){return 7;} if(cid==13){return 13;} if(cid==14){return 17;}
  if(cid==15){return 11;} if(cid==16){return 15;} if(cid==17){return 17;}
  if(cid==18){return 16;} if(cid==19){return 16;} if(cid==20){return 11;}
  if(cid==21){return 17;} if(cid==22){return 8;} if(cid==23){return 9;}
  return 0;
}

fn c2_y0(cid:i32)i32 {
  if(cid==0){return 1;} if(cid==1){return 2;} if(cid==2){return 0;}
  if(cid==3){return 4;} if(cid==4){return 1;} if(cid==5){return 3;}
  if(cid==6){return 2;} if(cid==7){return 6;} if(cid==8){return 4;}
  if(cid==9){return 5;} if(cid==10){return 6;} if(cid==11){return 7;}
  if(cid==12){return 0;} if(cid==13){return 1;} if(cid==14){return 2;}
  if(cid==15){return 3;} if(cid==16){return 3;} if(cid==17){return 1;}
  if(cid==18){return 6;} if(cid==19){return 0;} if(cid==20){return 3;}
  if(cid==21){return 1;} if(cid==22){return 0;} if(cid==23){return 2;}
  return 0;
}
fn c2_y1(cid:i32)i32 {
  if(cid==0){return 3;} if(cid==1){return 3;} if(cid==2){return 3;}
  if(cid==3){return 6;} if(cid==4){return 2;} if(cid==5){return 6;}
  if(cid==6){return 4;} if(cid==7){return 7;} if(cid==8){return 5;}
  if(cid==9){return 6;} if(cid==10){return 7;} if(cid==11){return 8;}
  if(cid==12){return 2;} if(cid==13){return 2;} if(cid==14){return 5;}
  if(cid==15){return 5;} if(cid==16){return 4;} if(cid==17){return 4;}
  if(cid==18){return 8;} if(cid==19){return 1;} if(cid==20){return 5;}
  if(cid==21){return 5;} if(cid==22){return 4;} if(cid==23){return 6;}
  return 0;
}
fn c2_y2(cid:i32)i32 {
  if(cid==0){return 5;} if(cid==1){return 4;} if(cid==2){return 6;}
  if(cid==3){return 8;} if(cid==4){return 3;} if(cid==5){return 9;}
  if(cid==6){return 6;} if(cid==7){return 8;} if(cid==8){return 8;}
  if(cid==9){return 9;} if(cid==10){return 10;} if(cid==11){return 11;}
  if(cid==12){return 4;} if(cid==13){return 3;} if(cid==14){return 8;}
  if(cid==15){return 7;} if(cid==16){return 5;} if(cid==17){return 7;}
  if(cid==18){return 10;} if(cid==19){return 2;} if(cid==20){return 8;}
  if(cid==21){return 10;} if(cid==22){return 6;} if(cid==23){return 8;}
  return 0;
}
fn c2_xstar(cid:i32)i32 {
  if(cid<8){return 5;}
  if(cid<20){return 4;}
  if(cid<22){return 5;}
  return 4;
}
fn c2_flavor(cid:i32)i32 {
  if(cid<8){return 0;}
  if(cid<12){return 1;}
  if(cid<20){return 2;}
  if(cid<22){return 3;}
  return 4;
}
fn world_y2(cid:i32)i32 {
  if(cid==0){return 11;} if(cid==1){return 7;} if(cid==2){return 15;}
  if(cid==3){return 14;} if(cid==4){return 6;} if(cid==5){return 18;}
  if(cid==6){return 12;} if(cid==7){return 11;} if(cid==8){return 20;}
  if(cid==9){return 21;} if(cid==10){return 22;} if(cid==11){return 23;}
  if(cid==12){return 11;} if(cid==13){return 9;} if(cid==14){return 19;}
  if(cid==15){return 14;} if(cid==16){return 12;} if(cid==17){return 17;}
  if(cid==18){return 19;} if(cid==19){return 7;} if(cid==20){return 13;}
  if(cid==21){return 21;} if(cid==22){return 12;} if(cid==23){return 14;}
  return 0;
}


// ---------- exploratory transfer probe tables (new locus x=0; main may read) ----------
fn x_y0(xid:i32)i32 { if(xid==0){return 1;} return 4; }
fn x_y1(xid:i32)i32 { if(xid==0){return 3;} return 5; }
fn x_y2(xid:i32)i32 { if(xid==0){return 6;} return 8; }
fn x_xstar(xid:i32)i32 { return 4; }
fn x_world(xid:i32)i32 { if(xid==0){return 12;} return 14; }

// ---------- LEARNER role ----------
// Frozen affine commit. Values only; epoch passed as a value.
fn learner_commit(y0:i32, y1:i32, y2:i32, xstar:i32, ep:i32, rec:[]u8, off:i32)void {
  let a_hat:i32=y1-y0;
  let b_hat:i32=y0;
  let r0:i32=abs32(b_hat-y0);
  let r1:i32=abs32(a_hat+b_hat-y1);
  let r2:i32=abs32(a_hat*2+b_hat-y2);
  let rmax:i32=r0;
  if(r1>rmax){rmax=r1;}
  if(r2>rmax){rmax=r2;}
  let t:i32=rmax+1;
  let p:i32=a_hat*xstar+b_hat;
  set32(rec,off+F_P,p);
  set32(rec,off+F_T,t);
  set32(rec,off+F_RMAX,rmax);
  set32(rec,off+F_E1,ep);
  return;
}
// Self-judgment from sealed (p, t) and the observed consequence only.
fn learner_judge(ystar:i32, ep:i32, rec:[]u8, off:i32)void {
  let p:i32=get32(rec,off+F_P);
  let t:i32=get32(rec,off+F_T);
  let d:i32=abs32(ystar-p);
  let self:i32=0;
  if(d<=t){self=1;}
  set32(rec,off+F_SELF,self);
  set32(rec,off+F_E3,ep);
  return;
}
// Leave-one-out affine prediction excluding training point excl.
fn loo_pred(y0:i32, y1:i32, y2:i32, xstar:i32, excl:i32)i32 {
  let xa:i32=0; let ya:i32=0; let xb:i32=0; let yb:i32=0;
  if(excl==0){xa=1;ya=y1;xb=2;yb=y2;}
  else {
    if(excl==1){xa=0;ya=y0;xb=2;yb=y2;}
    else {xa=0;ya=y0;xb=1;yb=y1;}
  }
  let a:i32=(yb-ya)/(xb-xa);
  let b:i32=ya-a*xa;
  return a*xstar+b;
}
// exm primitive: index of the point with largest |residual| from the full
// fit; ties go to the lowest index. Under the lane's two-point fit
// r0 = r1 = 0 always, so this yields 2 when r2 > 0, else 0.
fn exm_of(y0:i32, y1:i32, y2:i32)i32 {
  let a:i32=y1-y0;
  let b:i32=y0;
  let r2:i32=abs32(a*2+b-y2);
  if(r2>0){return 2;}
  return 0;
}
// Median of the values currently on the stack (sorted in place).
fn stack_med(scr:[]u8, sp:i32)i32 {
  let a2:i32=0;
  while(a2<sp){
    let b2:i32=a2+1;
    while(b2<sp){
      let va:i32=get32(scr,a2*4);
      let vb:i32=get32(scr,b2*4);
      if(vb<va){
        set32(scr,a2*4,vb);
        set32(scr,b2*4,va);
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  return get32(scr,((sp-1)/2)*4);
}
// Generic instruction interpreter: runs a program (q0..q3, qlen) on the
// training values. This is the ONLY path by which an adopted program is
// applied; there is no researcher-written branch for any specific program.
fn learner_interp(y0:i32, y1:i32, y2:i32, xs:i32, q0:i32, q1:i32, q2:i32, q3:i32, qlen:i32, scr:[]u8)i32 {
  let excl:i32=-1;
  let sp:i32=0;
  let j:i32=0;
  while(j<qlen){
    let ins:i32=q0;
    if(j==1){ins=q1;}
    if(j==2){ins=q2;}
    if(j==3){ins=q3;}
    let done:i32=0;
    if(ins==0){
      let pr:i32=0;
      if(excl==-1){pr=(y1-y0)*xs+y0;}
      else {pr=loo_pred(y0,y1,y2,xs,excl);}
      set32(scr,sp*4,pr);
      sp=sp+1;
      done=1;
    }
    if(done==0){
      if(ins==1){
        excl=exm_of(y0,y1,y2);
        done=1;
      }
    }
    if(done==0){
      if(ins==2){
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,0));
        sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,1));
        sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,2));
        sp=sp+1;
        done=1;
      }
    }
    if(done==0){
      if(ins==3){
        let md:i32=stack_med(scr,sp);
        set32(scr,0,md);
        sp=1;
        done=1;
      }
    }
    if(done==0){
      let s:i32=0;
      let k2:i32=0;
      while(k2<sp){
        s=s+get32(scr,k2*4);
        k2=k2+1;
      }
      let m2:i32=s/sp;
      set32(scr,0,m2);
      sp=1;
    }
    j=j+1;
  }
  return get32(scr,(sp-1)*4);
}
// Failure attribution after a self-judged failure. Runs the LOO license
// from training values plus the OBSERVED consequence; stamps TRG/LIC;
// appends licensed cases to the learner-owned buffer. Sets NO procedure
// flag: the revision procedure is invented by the search, not specified.
fn learner_attrib(y0:i32, y1:i32, y2:i32, xs:i32, ys:i32, licbuf:[]u8, ncell:[]u8, rec:[]u8, off:i32)void {
  set32(rec,off+F_TRG,1);
  let l0:i32=loo_pred(y0,y1,y2,xs,0);
  let l1:i32=loo_pred(y0,y1,y2,xs,1);
  let l2:i32=loo_pred(y0,y1,y2,xs,2);
  let lic:i32=0;
  if(l0==ys){lic=1;}
  if(l1==ys){lic=1;}
  if(l2==ys){lic=1;}
  set32(rec,off+F_LIC,lic);
  if(lic==1){
    let n:i32=get32(ncell,0);
    let bo:i32=n*20;
    set32(licbuf,bo,y0);
    set32(licbuf,bo+4,y1);
    set32(licbuf,bo+8,y2);
    set32(licbuf,bo+12,xs);
    set32(licbuf,bo+16,ys);
    set32(ncell,0,n+1);
  }
  set32(rec,off+F_E4,4);
  return;
}
// Round-2 commit: when the invented program is adopted and the training
// fit is imperfect, commit the interpreter's prediction. Tolerance rule
// unchanged (t = rmax + 1 from the standard fit).
fn learner_commit2(y0:i32, y1:i32, y2:i32, xs:i32, adopted:i32, qlen:i32, q0:i32, q1:i32, q2:i32, q3:i32, scr:[]u8, ep:i32, rec:[]u8, off:i32)void {
  let a_hat:i32=y1-y0;
  let b_hat:i32=y0;
  let r0:i32=abs32(b_hat-y0);
  let r1:i32=abs32(a_hat+b_hat-y1);
  let r2:i32=abs32(a_hat*2+b_hat-y2);
  let rmax:i32=r0;
  if(r1>rmax){rmax=r1;}
  if(r2>rmax){rmax=r2;}
  let t:i32=rmax+1;
  let p:i32=a_hat*xs+b_hat;
  let use:i32=0;
  if(adopted==1){
    if(rmax>0){use=1;}
  }
  if(use==1){
    p=learner_interp(y0,y1,y2,xs,q0,q1,q2,q3,qlen,scr);
  }
  set32(rec,off+F_P,p);
  set32(rec,off+F_T,t);
  set32(rec,off+F_RMAX,rmax);
  set32(rec,off+F_E1,ep);
  return;
}
// Decode enumeration index into instruction digits (most significant first).
fn decode_prog(idx:i32, qlen:i32, dig:[]u8)void {
  let j:i32=0;
  while(j<qlen){
    let p: i32=pow5i(qlen-1-j);
    let dg:i32=(idx/p)%5;
    set32(dig,j*4,dg);
    j=j+1;
  }
  return;
}
// Program validity: last instruction yields one prediction; every
// med/avg has a pushing instruction before it.
fn valid_prog(dig:[]u8, qlen:i32)i32 {
  let last:i32=get32(dig,(qlen-1)*4);
  let vok:i32=0;
  if(last==0){vok=1;}
  if(last==3){vok=1;}
  if(last==4){vok=1;}
  let pushseen:i32=0;
  let k:i32=0;
  while(k<qlen){
    let dk:i32=get32(dig,k*4);
    let ispush:i32=0;
    if(dk==0){ispush=1;}
    if(dk==2){ispush=1;}
    let isagg:i32=0;
    if(dk==3){isagg=1;}
    if(dk==4){isagg=1;}
    if(isagg==1){
      if(pushseen==0){vok=0;}
    }
    if(ispush==1){pushseen=1;}
    k=k+1;
  }
  return vok;
}
// The learner's self-check: the candidate program must predict the
// observed consequence exactly on EVERY licensed failure case.
fn selfcheck_prog(dig:[]u8, qlen:i32, nlic:i32, licbuf:[]u8, scr:[]u8)i32 {
  let okc:i32=1;
  let c:i32=0;
  while(c<nlic){
    let bo:i32=c*20;
    let cy0:i32=get32(licbuf,bo);
    let cy1:i32=get32(licbuf,bo+4);
    let cy2:i32=get32(licbuf,bo+8);
    let cxs:i32=get32(licbuf,bo+12);
    let cys:i32=get32(licbuf,bo+16);
    let pr:i32=learner_interp(cy0,cy1,cy2,cxs,get32(dig,0),get32(dig,4),get32(dig,8),get32(dig,12),qlen,scr);
    if(pr!=cys){okc=0;}
    c=c+1;
  }
  return okc;
}
fn emit_prog(ob:[]u8, at:i32, dig:[]u8, qlen:i32)i32 {
  at=ob_app(ob,at,"[");
  let j:i32=0;
  while(j<qlen){
    if(j>0){at=ob_app(ob,at,",");}
    let c:[]u8="fit";
    let code:i32=get32(dig,j*4);
    if(code==1){c="exm";}
    if(code==2){c="loo3";}
    if(code==3){c="med";}
    if(code==4){c="avg";}
    at=ob_app(ob,at,c);
    j=j+1;
  }
  at=ob_app(ob,at,"]");
  return at;
}
// Try one candidate: decode, validate, self-check, emit the trace line,
// adopt on the first pass. Returns at + (adopted << 20).
fn try_candidate(idx:i32, qlen:i32, nlic:i32, licbuf:[]u8, scr:[]u8, dig:[]u8, prog:[]u8, ntc:[]u8, ob:[]u8, at:i32)i32 {
  decode_prog(idx,qlen,dig);
  let vok:i32=valid_prog(dig,qlen);
  let adopted:i32=0;
  if(vok==1){
    set32(ntc,0,get32(ntc,0)+1);
    let okc:i32=selfcheck_prog(dig,qlen,nlic,licbuf,scr);
    at=ob_app(ob,at,"INVTRY prog=");
    at=emit_prog(ob,at,dig,qlen);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,okc);
    at=ob_nl(ob,at);
    if(okc==1){
      adopted=1;
      set32(prog,0,qlen);
      set32(prog,4,get32(dig,0));
      set32(prog,8,get32(dig,4));
      set32(prog,12,get32(dig,8));
      set32(prog,16,get32(dig,12));
      set32(prog,20,1);
      at=ob_app(ob,at,"INVADOPT prog=");
      at=emit_prog(ob,at,dig,qlen);
      at=ob_nl(ob,at);
    }
  }
  return at+(adopted*1048576);
}
// The invention search: enumerate programs by length then lexicographic
// instruction order; adopt the first self-check passer. The trace is the
// white-box record of the learner's path through the construction space.
fn learner_invent(nlic:i32, licbuf:[]u8, prog:[]u8, ntc:[]u8, dig:[]u8, scr:[]u8, ob:[]u8, at:i32)i32 {
  set32(prog,20,0);
  set32(ntc,0,0);
  at=ob_app(ob,at,"INVSEARCH nlic=");
  at=ob_i32(ob,at,nlic);
  at=ob_nl(ob,at);
  let adopted:i32=0;
  let qlen:i32=1;
  while(qlen<=4){
    let total:i32=pow5i(qlen);
    let idx:i32=0;
    let stopin:i32=0;
    while(idx<total){
      let go:i32=1;
      if(stopin==1){go=0;}
      if(go==1){
        let r:i32=try_candidate(idx,qlen,nlic,licbuf,scr,dig,prog,ntc,ob,at);
        let ad:i32=r/1048576;
        at=r-ad*1048576;
        if(ad==1){stopin=1;}
      }
      idx=idx+1;
    }
    if(stopin==1){qlen=4;}
    qlen=qlen+1;
  }
  adopted=get32(prog,20);
  at=ob_app(ob,at,"INVSTAT tried=");
  at=ob_i32(ob,at,get32(ntc,0));
  at=ob_app(ob,at," adopted=");
  at=ob_i32(ob,at,adopted);
  at=ob_nl(ob,at);
  if(adopted==0){
    at=ob_app(ob,at,"INVNOADOPT\n");
  }
  return at;
}

// ---------- HARNESS role ----------
// Quarantined reference: the REVISE researcher-specified procedure
// (median of LOO predictions), for the exploratory comparison ONLY.
// Never called by any learner function (audit-enforced).
fn med3(a:i32, b:i32, c:i32)i32 {
  let m:i32=a;
  let ab:i32=0; if(a<=b){ab=1;}
  let bc:i32=0; if(b<=c){bc=1;}
  let ac:i32=0; if(a<=c){ac=1;}
  if(ab==1){
    if(bc==1){m=b;}
    else {
      if(ac==1){m=c;}
      else {m=a;}
    }
  } else {
    if(bc==1){
      if(ac==1){m=a;}
      else {m=c;}
    } else {m=b;}
  }
  return m;
}
fn ref_medloo(y0:i32, y1:i32, y2:i32, xs:i32)i32 {
  let l0:i32=loo_pred(y0,y1,y2,xs,0);
  let l1:i32=loo_pred(y0,y1,y2,xs,1);
  let l2:i32=loo_pred(y0,y1,y2,xs,2);
  return med3(l0,l1,l2);
}

fn main()i32 {
  let r1r:[]u8=z_alloc(N*F_SZ);
  let r1c:[]u8=z_alloc(N*F_SZ);
  let r2r:[]u8=z_alloc(N*F_SZ);
  let r2c:[]u8=z_alloc(N*F_SZ);
  let licbuf:[]u8=z_alloc(24*20);
  let ncell:[]u8=z_alloc(4);
  let prog:[]u8=z_alloc(24);
  let ntc:[]u8=z_alloc(4);
  let dig:[]u8=z_alloc(16);
  let scr:[]u8=z_alloc(48);
  let ob:[]u8=z_alloc(32768);
  let at:i32=0;
  let cid:i32=0;
  let off:i32=0;
  at=ob_app(ob,at,"INVENT-BEGIN\n");
  // R1-P1 COMMIT (epoch 1), both arms, frozen procedure.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    learner_commit(case_y0(cid),case_y1(cid),case_y2(cid),case_xstar(cid),1,r1r,off);
    learner_commit(case_y0(cid),case_y1(cid),case_y2(cid),case_xstar(cid),1,r1c,off);
    cid=cid+1;
  }
  // R1-P2 WORLD (epoch 2), both arms.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    let ys:i32=world_y(cid);
    set32(r1r,off+F_YS,ys);
    set32(r1r,off+F_E2,2);
    set32(r1c,off+F_YS,ys);
    set32(r1c,off+F_E2,2);
    cid=cid+1;
  }
  // R1-P3 JUDGE (epoch 3), both arms.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    learner_judge(get32(r1r,off+F_YS),3,r1r,off);
    learner_judge(get32(r1c,off+F_YS),3,r1c,off);
    cid=cid+1;
  }
  // R1-P4 REVISE (epoch 4), revision arm only: attribution on
  // self-judged failures, then the invention search over licensed cases.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    set32(r1r,off+F_E4,4);
    let self:i32=get32(r1r,off+F_SELF);
    if(self==0){
      learner_attrib(case_y0(cid),case_y1(cid),case_y2(cid),case_xstar(cid),
        get32(r1r,off+F_YS),licbuf,ncell,r1r,off);
    }
    cid=cid+1;
  }
  let nlic:i32=get32(ncell,0);
  let adopted0:i32=0;
  if(nlic>0){
    at=learner_invent(nlic,licbuf,prog,ntc,dig,scr,ob,at);
    adopted0=get32(prog,20);
  } else {
    at=ob_app(ob,at,"INVSEARCH nlic=0\n");
    at=ob_app(ob,at,"INVNOADOPT\n");
  }
  let qlen:i32=get32(prog,0);
  let q0:i32=get32(prog,4);
  let q1:i32=get32(prog,8);
  let q2:i32=get32(prog,12);
  let q3:i32=get32(prog,16);
  at=ob_app(ob,at,"INVENTED adopted=");
  at=ob_i32(ob,at,adopted0);
  at=ob_app(ob,at," plen=");
  at=ob_i32(ob,at,qlen);
  at=ob_nl(ob,at);
  // R2-P5 COMMIT (epoch 5) on the fresh set.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    learner_commit2(c2_y0(cid),c2_y1(cid),c2_y2(cid),c2_xstar(cid),adopted0,qlen,q0,q1,q2,q3,scr,5,r2r,off);
    learner_commit(c2_y0(cid),c2_y1(cid),c2_y2(cid),c2_xstar(cid),5,r2c,off);
    cid=cid+1;
  }
  // R2-P6 WORLD (epoch 6).
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    let ys2:i32=world_y2(cid);
    set32(r2r,off+F_YS,ys2);
    set32(r2r,off+F_E2,6);
    set32(r2c,off+F_YS,ys2);
    set32(r2c,off+F_E2,6);
    cid=cid+1;
  }
  // R2-P7 JUDGE (epoch 7).
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    learner_judge(get32(r2r,off+F_YS),7,r2r,off);
    learner_judge(get32(r2c,off+F_YS),7,r2c,off);
    cid=cid+1;
  }
  // Exploratory transfer probe (new locus x=0; no bar). For each case:
  // invented-program prediction, frozen prediction, harness reference.
  let xid:i32=0;
  while(xid<2){
    let xy0:i32=x_y0(xid);
    let xy1:i32=x_y1(xid);
    let xy2:i32=x_y2(xid);
    let xxs:i32=x_xstar(xid);
    let xys:i32=x_world(xid);
    let xa:i32=xy1-xy0;
    let xb:i32=xy0;
    let xr2:i32=abs32(xa*2+xb-xy2);
    let xrmax:i32=xr2;
    let pfrz:i32=xa*xxs+xb;
    let pinv:i32=pfrz;
    let use:i32=0;
    if(adopted0==1){
      if(xrmax>0){use=1;}
    }
    if(use==1){
      pinv=learner_interp(xy0,xy1,xy2,xxs,q0,q1,q2,q3,qlen,scr);
    }
    let pref:i32=ref_medloo(xy0,xy1,xy2,xxs);
    at=ob_app(ob,at,"XPLOR xid=");
    at=ob_i32(ob,at,xid);
    at=ob_app(ob,at," pinv=");
    at=ob_i32(ob,at,pinv);
    at=ob_app(ob,at," pfrz=");
    at=ob_i32(ob,at,pfrz);
    at=ob_app(ob,at," pref=");
    at=ob_i32(ob,at,pref);
    at=ob_app(ob,at," ys=");
    at=ob_i32(ob,at,xys);
    at=ob_app(ob,at," einv=");
    at=ob_i32(ob,at,abs32(xys-pinv));
    at=ob_app(ob,at," efrz=");
    at=ob_i32(ob,at,abs32(xys-pfrz));
    at=ob_app(ob,at," eref=");
    at=ob_i32(ob,at,abs32(xys-pref));
    at=ob_nl(ob,at);
    xid=xid+1;
  }
  // HARNESS: agreements, invention verification, bars. Reads records only.
  let i0:i32=1;
  let i1:i32=1;
  let i2:i32=1;
  let agree1r:i32=0;
  let agree1c:i32=0;
  let trg:i32=0;
  let lic:i32=0;
  let agree2r:i32=0;
  let agree2c:i32=0;
  let r5c:i32=0;
  let errWR:i32=0;
  let errWC:i32=0;
  let errWA:i32=0;
  // Round-1 harness + I0/I1 checks.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    let p:i32=get32(r1r,off+F_P);
    let ys:i32=get32(r1r,off+F_YS);
    let self:i32=get32(r1r,off+F_SELF);
    let pc:i32=get32(r1c,off+F_P);
    let ysc:i32=get32(r1c,off+F_YS);
    let selfc:i32=get32(r1c,off+F_SELF);
    let h1:i32=0;
    if(ys==p){h1=1;}
    if(self==h1){agree1r=agree1r+1;}
    let hc:i32=0;
    if(ysc==pc){hc=1;}
    if(selfc==hc){agree1c=agree1c+1;}
    let tg:i32=get32(r1r,off+F_TRG);
    let lc:i32=get32(r1r,off+F_LIC);
    trg=trg+tg;
    lic=lic+lc;
    let tgc:i32=get32(r1c,off+F_TRG);
    let want:i32=0;
    if(self==0){want=1;}
    let okt:i32=0;
    if(tg==want){okt=1;}
    if(okt==0){i1=0;}
    if(tgc!=0){i1=0;}
    let e1:i32=get32(r1r,off+F_E1);
    let e2:i32=get32(r1r,off+F_E2);
    let e3:i32=get32(r1r,off+F_E3);
    let e4:i32=get32(r1r,off+F_E4);
    let f1:i32=0; if(e1<e2){f1=1;}
    let f2:i32=0; if(e2<e3){f2=1;}
    let f3:i32=0; if(e3<e4){f3=1;}
    let ok4:i32=0;
    if(f1==1){ if(f2==1){ if(f3==1){ ok4=1; } } }
    if(ok4==0){i0=0;}
    let c1:i32=get32(r1c,off+F_E1);
    let c2:i32=get32(r1c,off+F_E2);
    let c3:i32=get32(r1c,off+F_E3);
    let g1:i32=0; if(c1<c2){g1=1;}
    let g2:i32=0; if(c2<c3){g2=1;}
    let okc:i32=0;
    if(g1==1){ if(g2==1){ okc=1; } }
    if(okc==0){i0=0;}
    at=ob_app(ob,at,"R1 cid=");
    at=ob_i32(ob,at,cid);
    at=ob_app(ob,at," self=");
    at=ob_i32(ob,at,self);
    at=ob_app(ob,at," trg=");
    at=ob_i32(ob,at,tg);
    at=ob_app(ob,at," lic=");
    at=ob_i32(ob,at,lc);
    at=ob_nl(ob,at);
    cid=cid+1;
  }
  if(trg!=14){i1=0;}
  if(lic!=2){i1=0;}
  // I2: invention trace checks. Re-verify the adopted program on all
  // licensed cases through the generic interpreter.
  let ntried:i32=get32(ntc,0);
  if(ntried<2){i2=0;}
  if(adopted0!=1){i2=0;}
  let c9:i32=0;
  while(c9<nlic){
    let bo:i32=c9*20;
    let vy0:i32=get32(licbuf,bo);
    let vy1:i32=get32(licbuf,bo+4);
    let vy2:i32=get32(licbuf,bo+8);
    let vxs:i32=get32(licbuf,bo+12);
    let vys:i32=get32(licbuf,bo+16);
    let vp:i32=learner_interp(vy0,vy1,vy2,vxs,q0,q1,q2,q3,qlen,scr);
    if(vp!=vys){i2=0;}
    c9=c9+1;
  }
  // Round-2 harness + I0/I3/I4/I5/I7/I8.
  cid=0;
  while(cid<N){
    off=cid*F_SZ;
    let p:i32=get32(r2r,off+F_P);
    let t:i32=get32(r2r,off+F_T);
    let rmax:i32=get32(r2r,off+F_RMAX);
    let ys:i32=get32(r2r,off+F_YS);
    let self:i32=get32(r2r,off+F_SELF);
    let pc:i32=get32(r2c,off+F_P);
    let ysc:i32=get32(r2c,off+F_YS);
    let selfc:i32=get32(r2c,off+F_SELF);
    let err:i32=abs32(ys-p);
    let errc:i32=abs32(ysc-pc);
    set32(r2r,off+F_ERR,err);
    set32(r2c,off+F_ERR,errc);
    // I8 ablation: frozen-fit prediction on the revision arm's cases.
    let pa:i32=(c2_y1(cid)-c2_y0(cid))*c2_xstar(cid)+c2_y0(cid);
    let erra:i32=abs32(ys-pa);
    let h2:i32=0;
    if(ys==p){h2=1;}
    if(self==h2){agree2r=agree2r+1;}
    let h2c:i32=0;
    if(ysc==pc){h2c=1;}
    if(selfc==h2c){agree2c=agree2c+1;}
    let bad:i32=0;
    if(h2==0){bad=1;}
    let rej:i32=0;
    if(self==0){rej=1;}
    let rok:i32=0;
    if(bad==0){rok=1;}
    if(bad==1){ if(rej==1){ rok=1; } }
    if(rok==0){r5c=r5c+1;}
    let fl:i32=c2_flavor(cid);
    if(fl==4){
      errWR=errWR+err;
      errWC=errWC+errc;
      errWA=errWA+erra;
    }
    let e1:i32=get32(r2r,off+F_E1);
    let e2:i32=get32(r2r,off+F_E2);
    let e3:i32=get32(r2r,off+F_E3);
    let f1:i32=0; if(e1<e2){f1=1;}
    let f2:i32=0; if(e2<e3){f2=1;}
    let okr:i32=0;
    if(f1==1){ if(f2==1){ okr=1; } }
    if(okr==0){i0=0;}
    let d1:i32=get32(r2c,off+F_E1);
    let d2:i32=get32(r2c,off+F_E2);
    let d3:i32=get32(r2c,off+F_E3);
    let qd1:i32=0; if(d1<d2){qd1=1;}
    let qd2:i32=0; if(d2<d3){qd2=1;}
    let okd:i32=0;
    if(qd1==1){ if(qd2==1){ okd=1; } }
    if(okd==0){i0=0;}
    at=ob_app(ob,at,"R2R cid=");
    at=ob_i32(ob,at,cid);
    at=ob_app(ob,at," flav=");
    at=ob_i32(ob,at,c2_flavor(cid));
    at=ob_app(ob,at," p=");
    at=ob_i32(ob,at,p);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," rmax=");
    at=ob_i32(ob,at,rmax);
    at=ob_app(ob,at," ys=");
    at=ob_i32(ob,at,ys);
    at=ob_app(ob,at," self=");
    at=ob_i32(ob,at,self);
    at=ob_app(ob,at," hidden=");
    at=ob_i32(ob,at,h2);
    at=ob_app(ob,at," err=");
    at=ob_i32(ob,at,err);
    at=ob_nl(ob,at);
    at=ob_app(ob,at,"R2C cid=");
    at=ob_i32(ob,at,cid);
    at=ob_app(ob,at," p=");
    at=ob_i32(ob,at,pc);
    at=ob_app(ob,at," self=");
    at=ob_i32(ob,at,selfc);
    at=ob_app(ob,at," hidden=");
    at=ob_i32(ob,at,h2c);
    at=ob_app(ob,at," err=");
    at=ob_i32(ob,at,errc);
    at=ob_nl(ob,at);
    cid=cid+1;
  }
  let i3:i32=0;
  if(agree2r>=14){i3=1;}
  let i4:i32=0;
  if(agree2r>=agree2c){i4=1;}
  let i5:i32=0;
  if(r5c==0){i5=1;}
  let i7:i32=0;
  if(errWR<errWC){i7=1;}
  let i8:i32=0;
  if(errWA==errWC){i8=1;}
  at=ob_app(ob,at,"R1REV agree=");
  at=ob_i32(ob,at,agree1r);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"R1CTL agree=");
  at=ob_i32(ob,at,agree1c);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"INVENT trg=");
  at=ob_i32(ob,at,trg);
  at=ob_app(ob,at," lic=");
  at=ob_i32(ob,at,lic);
  at=ob_app(ob,at," nlic=");
  at=ob_i32(ob,at,nlic);
  at=ob_app(ob,at," adopted=");
  at=ob_i32(ob,at,adopted0);
  at=ob_app(ob,at," ntried=");
  at=ob_i32(ob,at,ntried);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"R2REV agree=");
  at=ob_i32(ob,at,agree2r);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"R2CTL agree=");
  at=ob_i32(ob,at,agree2c);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"R2REV wobbleB_err=");
  at=ob_i32(ob,at,errWR);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"R2CTL wobbleB_err=");
  at=ob_i32(ob,at,errWC);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"R2ABL wobbleB_err=");
  at=ob_i32(ob,at,errWA);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"R2REV bad_reject_fail=");
  at=ob_i32(ob,at,r5c);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"BARS i0=");
  at=ob_i32(ob,at,i0);
  at=ob_app(ob,at," i1=");
  at=ob_i32(ob,at,i1);
  at=ob_app(ob,at," i2=");
  at=ob_i32(ob,at,i2);
  at=ob_app(ob,at," i3=");
  at=ob_i32(ob,at,i3);
  at=ob_app(ob,at," i4=");
  at=ob_i32(ob,at,i4);
  at=ob_app(ob,at," i5=");
  at=ob_i32(ob,at,i5);
  at=ob_app(ob,at," i7=");
  at=ob_i32(ob,at,i7);
  at=ob_app(ob,at," i8=");
  at=ob_i32(ob,at,i8);
  at=ob_nl(ob,at);
  let pass:i32=i0+i1+i2+i3+i4+i5+i7+i8;
  if(pass==8){
    at=ob_app(ob,at,"IN-PROGRAM-BARS 8/8 (I6 shell-audited)\n");
  } else {
    at=ob_app(ob,at,"IN-PROGRAM-BARS-FAIL passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/8\n");
  }
  at=ob_app(ob,at,"INVENT-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

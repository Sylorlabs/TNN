// Test 4: Revision without dedicated reversal case.
// Phase 1: 3x a_w=45 -> default=45.
// Phase 2: 3x a_w=60 -> default=60? (revision, no special case)
// Phase 3: 3x a_w=30 -> default=30? (revision back)
// Question: can the learner revise 45->60->30 using only the generic 3-consistent rule?

fn get_default_action(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==2){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn do_cycles(W:[]u8,base_s:i32,r:i32,aw:i32,n:i32)void {
  let i:i32=0;
  while(i<n){
    let s:i32=base_s+i;
    ev_query(W,s,r,0,0);
    ev_observe_aw(W,s,r,5000+base_s+i,aw);
    i=i+1;
  }
  return;
}

fn run_revision_test()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ok:i32=1;

  // Phase 1: learn 45
  do_cycles(W,100,1,45,3);
  let d1:i32=get_default_action(W);
  print_str("REVISION_TEST phase1 default="); print_i32(d1); print_str("\n");
  if(d1!=45){ print_str("FAIL: phase1 did not learn 45\n"); ok=0; }

  // Phase 2: revise to 60
  do_cycles(W,200,1,60,3);
  let d2:i32=get_default_action(W);
  print_str("REVISION_TEST phase2 default="); print_i32(d2); print_str("\n");
  if(d2!=60){ print_str("FAIL: phase2 did not revise to 60\n"); ok=0; }

  // Phase 3: revise back to 30
  do_cycles(W,300,1,30,3);
  let d3:i32=get_default_action(W);
  print_str("REVISION_TEST phase3 default="); print_i32(d3); print_str("\n");
  if(d3!=30){ print_str("FAIL: phase3 did not revise back to 30\n"); ok=0; }

  // Phase 4: new guide should carry 30
  ev_query(W,400,1,0,0);
  let pr:i32=ng(W,0,20);
  let ga:i32=-999; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && ng(W,cand,0)==1 && is_superseded(W,cand)==0){
        if(ng(W,cand,4)==400){ga=ng(W,cand,20);}
      }
    }
    e=e+1;
  }
  print_str("REVISION_TEST phase4 guide="); print_i32(ga); print_str("\n");
  if(ga!=30){ print_str("FAIL: phase4 guide does not carry 30\n"); ok=0; }

  if(ok==1){
    print_str("REVISION_TEST PASS (45->60->30 all via generic rule)\n");
    return 0;
  }
  print_str("REVISION_TEST FAIL\n");
  return 1;
}

fn main()i32 { return run_revision_test(); }

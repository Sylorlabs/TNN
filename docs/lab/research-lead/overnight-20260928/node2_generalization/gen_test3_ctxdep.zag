// Test 3: Context-dependent competing policies.
// R1: correct action is 45. R2: correct action is 30 (the default).
// World alternates: train R1->45, then R2->30 (confirming default), then R1 again.
// Question: does the learner maintain both, or does global replacement destroy one?
// With context-keyed policies (gen_multi.zag), both should coexist.
// Control: with single global policy, R2 training would be no-op (30=30),
// but R1->45 then a different R1'->60 would destroy.

fn get_ctx_default(W:[]u8,ctx:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==100+ctx){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn do_ctx_cycles(W:[]u8,base_s:i32,r:i32,aw:i32,n:i32)void {
  let i:i32=0;
  while(i<n){
    let s:i32=base_s+i;
    ev_query(W,s,r,0,0);
    ev_observe_aw(W,s,r,8000+base_s+i,aw);
    i=i+1;
  }
  return;
}

fn run_ctxdep_test()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ok:i32=1;

  // Phase A: R1 learns 45.
  do_ctx_cycles(W,100,1,45,3);
  let d1a:i32=get_ctx_default(W,1);
  print_str("CTXDEP_TEST after R1->45: R1="); print_i32(d1a); print_str("\n");
  if(d1a!=45){ print_str("FAIL: R1 did not learn 45\n"); ok=0; }

  // Phase B: R2 confirms 30 (3x a_w=30, which equals default, so no write).
  // This should NOT affect R1's policy.
  do_ctx_cycles(W,200,2,30,3);
  let d1b:i32=get_ctx_default(W,1);
  let d2b:i32=get_ctx_default(W,2);
  print_str("CTXDEP_TEST after R2->30: R1="); print_i32(d1b);
  print_str(" R2="); print_i32(d2b); print_str("\n");
  if(d1b!=45){ print_str("FAIL: R1 policy destroyed by R2 training\n"); ok=0; }
  if(d2b!=30){ print_str("FAIL: R2 not 30\n"); ok=0; }

  // Phase C: R1 revises to 60. R2 must stay 30.
  do_ctx_cycles(W,300,1,60,3);
  let d1c:i32=get_ctx_default(W,1);
  let d2c:i32=get_ctx_default(W,2);
  print_str("CTXDEP_TEST after R1->60: R1="); print_i32(d1c);
  print_str(" R2="); print_i32(d2c); print_str("\n");
  if(d1c!=60){ print_str("FAIL: R1 did not revise to 60\n"); ok=0; }
  if(d2c!=30){ print_str("FAIL: R2 policy destroyed by R1 revision\n"); ok=0; }

  if(ok==1){
    print_str("CTXDEP_TEST PASS (competing policies coexist)\n");
    return 0;
  }
  print_str("CTXDEP_TEST FAIL\n");
  return 1;
}

fn main()i32 { return run_ctxdep_test(); }

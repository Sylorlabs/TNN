// Test 2: Multiple policies.
// 3 relations (contexts), each with different correct action.
// R1 -> 45, R2 -> 60, R3 -> 75.
// Question: does the same machinery update all three independently?
// Uses gen_multi.zag where policy is keyed by relation r.

fn get_ctx_default(W:[]u8,ctx:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==100+ctx){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn do_ctx_cycles(W:[]u8,base_s:i32,r:i32,aw:i32,n:i32)void {
  let i:i32=0;
  while(i<n){
    let s:i32=base_s+i;
    ev_query(W,s,r,0,0);
    ev_observe_aw(W,s,r,7000+base_s+i,aw);
    i=i+1;
  }
  return;
}

fn run_multi_test()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ok:i32=1;

  // Train all three contexts interleaved.
  do_ctx_cycles(W,100,1,45,3);  // R1 -> 45
  do_ctx_cycles(W,200,2,60,3);  // R2 -> 60
  do_ctx_cycles(W,300,3,75,3);  // R3 -> 75

  let d1:i32=get_ctx_default(W,1);
  let d2:i32=get_ctx_default(W,2);
  let d3:i32=get_ctx_default(W,3);
  print_str("MULTI_TEST R1="); print_i32(d1);
  print_str(" R2="); print_i32(d2);
  print_str(" R3="); print_i32(d3); print_str("\n");

  if(d1!=45){ print_str("FAIL: R1 not 45\n"); ok=0; }
  if(d2!=60){ print_str("FAIL: R2 not 60\n"); ok=0; }
  if(d3!=75){ print_str("FAIL: R3 not 75\n"); ok=0; }

  // Verify guides carry context-appropriate actions.
  ev_query(W,400,1,0,0);  // R1 miss
  ev_query(W,500,2,0,0);  // R2 miss
  ev_query(W,600,3,0,0);  // R3 miss
  // Guides are linked to POLICY_ROOT; find by subject.
  let pr:i32=ng(W,0,20);
  let g1:i32=-999; let g2:i32=-999; let g3:i32=-999;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && ng(W,cand,0)==1 && is_superseded(W,cand)==0){
        let s:i32=ng(W,cand,4);
        if(s==400){g1=ng(W,cand,20);}
        if(s==500){g2=ng(W,cand,20);}
        if(s==600){g3=ng(W,cand,20);}
      }
    }
    e=e+1;
  }
  print_str("MULTI_TEST guides R1="); print_i32(g1);
  print_str(" R2="); print_i32(g2);
  print_str(" R3="); print_i32(g3); print_str("\n");
  if(g1!=45){ print_str("FAIL: R1 guide not 45\n"); ok=0; }
  if(g2!=60){ print_str("FAIL: R2 guide not 60\n"); ok=0; }
  if(g3!=75){ print_str("FAIL: R3 guide not 75\n"); ok=0; }

  if(ok==1){
    print_str("MULTI_TEST PASS (3 independent policies)\n");
    return 0;
  }
  print_str("MULTI_TEST FAIL\n");
  return 1;
}

fn main()i32 { return run_multi_test(); }

// Test 5: Noisy evidence.
// Sequence: 45,45,46,45,45,45,45...
// Question: does the mechanism require 3 CONSECUTIVE consistent,
// or 3-of-N? How much does noise delay the update?
// Expected (consecutive): history shifts, 46 breaks the run.
// After 45,45,46: h=(46,45,45). After 45: h=(45,46,45).
// After 45: h=(45,45,46). After 45: h=(45,45,45) -> UPDATE.
// So 1 noise delays update by 3 extra revelations.

fn get_default_action(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==2){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn run_noise_test()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);

  // Sequence with one noise injection at position 3.
  let seq:[]u8=z_alloc(28);
  set32(seq,0,45); set32(seq,4,45); set32(seq,8,46);
  set32(seq,12,45); set32(seq,16,45); set32(seq,20,45); set32(seq,24,45);

  let i:i32=0;
  while(i<7){
    let s:i32=100+i; let r:i32=1;
    ev_query(W,s,r,0,0);
    let aw:i32=get32(seq,i*4);
    ev_observe_aw(W,s,r,6000+i,aw);
    let d:i32=get_default_action(W);
    print_str("NOISE_TEST cycle "); print_i32(i);
    print_str(" a_w="); print_i32(aw);
    print_str(" default="); print_i32(d); print_str("\n");
    i=i+1;
  }
  let df:i32=get_default_action(W);
  if(df==45){
    print_str("NOISE_TEST PASS (update occurred despite 1 noise; consecutive rule confirmed)\n");
    return 0;
  }
  print_str("NOISE_TEST FAIL (no update after 6x45 + 1 noise)\n");
  return 1;
}

fn main()i32 { return run_noise_test(); }

// lvcomp_patch.zag -- Learner-owned verification for composition (H-COMPVER-1).
//
// Replaces researcher-supplied answer targets in composition verification
// with the learner's own reliability signal (C181 design). The composed
// structure is executed and its result checked against learner-held
// evidence: the learner's prediction for (s,r) from its own experience,
// gated by predictor reliability.
//
// AUDIT NOTE: no researcher answer parameter exists anywhere in this file.
// compose_lv and lv_dfs take no researcher target at all, so the
// researcher's answer cannot be consulted, smuggled, or shadowed.
//
// Researcher scaffold (honest): PRED node layout, +1/-1 scoring rule,
// reliability threshold value (3), accept/reject/withhold structure,
// header field usage (32, 36).
// Learner-owned: all reliability VALUES (from prediction experience only),
// which predictors are trusted, whether verification succeeds.
// Zero modes, bridges, handlers, semantic cases.

// ---- prediction machinery (ported from learner_verification, lv_ prefix) ----
// PRED node (tag 31): recorded prediction awaiting outcome resolution.
//   f4: resolved, f8: error, f12: struct_id, f16: struct_kind (1=FACT,20=MAP),
//   f20: s, f24: r, f28: predicted value, f32: tick.
// FACT (tag 1) f8: pred_score (free field in base). MAP (tag 20) f12:
// pred_score, f16: pred_trials.

fn lv_score_on()i32 { return 1; }

fn lv_pred_record(W:[]u8,s:i32,r:i32,p:i32,sid:i32,kind:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,sid); ns(W,n,16,kind);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// Score-guided prediction BEFORE outcome is known. Among matching FACTs
// pick highest pred_score (tie by bid); then MAP-execute fallback for the
// query relation. Returns predicted value, or -999999 if no basis.
fn lv_predict(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bs:i32=-999999; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let sc:i32=0;
        if(lv_score_on()==1){ sc=ng(W,n,8); }
        let b:i32=bid(W,n);
        if(sc>bs || (sc==bs && b>bb)){ bs=sc; bb=b; best=n; }
      }
    }
    n=n+1;
  }
  if(best>=0){
    let p:i32=ng(W,best,28);
    lv_pred_record(W,s,r,p,best,1);
    return p;
  }
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      let root:i32=ng(W,m,20);
      let v:i32=t2_exec(W,root,s);
      if(v!=-999999){
        if(ng(W,m,12)==-1){ ns(W,m,12,0); ns(W,m,16,0); }
        lv_pred_record(W,s,r,v,m,20);
        return v;
      }
    }
    m=m+1;
  }
  return -999999;
}

// Resolve pending predictions against revealed outcome o: source structure
// pred_score +1 if correct, -1 if wrong.
fn lv_pred_resolve(W:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let err:i32=0;
        if(ng(W,n,28)!=o){ err=1; }
        ns(W,n,4,1); ns(W,n,8,err);
        if(lv_score_on()==1){
          let sid:i32=ng(W,n,12); let kind:i32=ng(W,n,16);
          if(sid>=2 && ng(W,sid,36)==1){
            let d:i32=1; if(err==1){ d=-1; }
            if(kind==1){ ns(W,sid,8,ng(W,sid,8)+d); }
            else { if(kind==20){
              ns(W,sid,12,ng(W,sid,12)+d);
              ns(W,sid,16,ng(W,sid,16)+1);
            }}
          }
        }
      }
    }
    n=n+1;
  }
  return;
}

// World observation with prediction resolution appended (models the world
// revealing the outcome; the learner scores its own prior predictions).
fn lv_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0);
      lv_pred_resolve(W,s,r,o);
      return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0);
    lv_pred_resolve(W,s,r,o);
    return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0);
  lv_pred_resolve(W,s,r,o);
  return 1;
}

// ---- learner verification setup (adapted from C181 lv_setup) ----
fn lv_rel_thresh()i32 { return 3; }

// Get the learner prediction and predictor reliability for (s,r).
// Stores prediction in hg(W,32), reliability in hg(W,36).
// Returns prediction, or -999999 if the learner has no basis.
fn lv_setup(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=lv_predict(W,s,r);
  if(p==-999999){ return -999999; }
  let bn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      bn=n;
    }
    n=n+1;
  }
  let rel:i32=-999999;
  if(bn>=0){
    let sid:i32=ng(W,bn,12); let kind:i32=ng(W,bn,16);
    if(sid>=2 && ng(W,sid,36)==1){
      if(kind==1){ rel=ng(W,sid,8); }
      else { if(kind==20){ rel=ng(W,sid,12); } }
    }
  }
  hs(W,32,p); hs(W,36,rel);
  return p;
}

// ---- learner-terminated DFS over MAP compositions ----
// un_dfs with the researcher answer termination replaced: the search stops
// when a candidate chain end value equals the LEARNER PREDICTION (pred),
// not a researcher-supplied target. max 8 segments, same as unified.
fn lv_dfs(W:[]u8,s:i32,pred:i32,oseg:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8)i32 {
  let cand:[]u8=z_alloc(1024);
  let clen:[]u8=z_alloc(1024);
  let ccouse:[]u8=z_alloc(1024);
  let ncand:[]u8=z_alloc(32);
  let candi:[]u8=z_alloc(32);
  let curval:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(ncand,0,un_candidates(W,s,oseg,0,cand,clen,ccouse,0));
  set32(candi,0,0);
  let L:i32=0;
  let done:i32=0;
  let nseg:i32=-1;
  while(L>=0 && done==0){
    if(get32(candi,L*4)>=get32(ncand,L*4)){
      L=L-1;
      if(L>=0){set32(candi,L*4,get32(candi,L*4)+1);}
    } else {
      let m:i32=get32(cand,(L*32+get32(candi,L*4))*4);
      let vbuf:[]u8=z_alloc(32);
      let fbuf:[]u8=z_alloc(28);
      let ln:i32=un_satisfy(W,m,get32(curval,L*4),vbuf,fbuf);
      if(ln<1){
        set32(candi,L*4,get32(candi,L*4)+1);
      } else {
        set32(oseg,L*4,m);
        set32(olen,L*4,ln);
        let j:i32=0;
        while(j<=ln){set32(ovals,(L*8+j)*4,get32(vbuf,j*4)); j=j+1;}
        j=0;
        while(j<ln){set32(ofids,(L*7+j)*4,get32(fbuf,j*4)); j=j+1;}
        let nv:i32=get32(vbuf,ln*4);
        if(nv==pred){
          nseg=L+1;
          done=1;
        } else {
          if(L+1>=8){
            set32(candi,L*4,get32(candi,L*4)+1);
          } else {
            set32(curval,(L+1)*4,nv);
            set32(ncand,(L+1)*4,un_candidates(W,nv,oseg,L+1,cand,clen,ccouse,(L+1)*32));
            set32(candi,(L+1)*4,0);
            L=L+1;
          }
        }
      }
    }
  }
  return nseg;
}

// Learner-owned verify of one assembled composition graph.
// Accepts iff candidate output == learner prediction (hg(W,32)).
// A failed guard (execute -999999 or -2) is a genuine rejection.
// st[0]=tried, st[1]=rejected (same packing as t2_try_verify).
// Returns verified answer, or -2 on rejection.
fn lv_verify_chain(W:[]u8,root:i32,s0:i32,st:[]u8)i32 {
  if(root<0){return -2;}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec(W,root,s0);
  if(v==-2 || v==-999999){
    set32(st,4,get32(st,4)+1);
    return -2;
  }
  if(v==hg(W,32)){return v;}
  set32(st,4,get32(st,4)+1);
  return -2;
}

// ---- compose_lv: learner-verified composition ----
// Single composition operation whose verification is learner-owned.
// Signature takes NO researcher answer: the verifier cannot consult one.
// Returns: ans (>=0) accepted; -2 rejected/failed after search;
// -3 WITHHELD (no prediction basis, or predictor reliability below
// threshold) before any search is attempted.
// masked is accepted for call-shape parity and ignored in learner mode.
fn compose_lv(W:[]u8,s:i32,r:i32,masked:i32,st:[]u8)i32 {
  let p:i32=lv_setup(W,s,r);
  if(p==-999999){
    emit("LV-WITHHOLD nobasis\n");
    return -3;
  }
  if(hg(W,36)<lv_rel_thresh()){
    emit("LV-WITHHOLD unreliable rel="); e64(hg(W,36)); emit("\n");
    return -3;
  }
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224);
  let olen:[]u8=z_alloc(32);
  let nseg:i32=lv_dfs(W,s,p,oseg,ovals,ofids,olen);
  if(nseg<1){
    emit("LV-COMP-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(32);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=lv_verify_chain(W,full,s,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(288);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*4),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      let w1:i32=cb_couse_link(W,get32(oseg,g*4),get32(oseg,(g-1)*4));
      g=g+1;
    }
  }
  emit("LV-COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*4)); g=g+1;}
  emit("\n");
  return v2;
}

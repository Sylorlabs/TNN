// ============ main ============
fn count_calls(p:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<prog_len(p)){
    if(prog_op(p,i)==19){ c=c+1; }
    i=i+1;
  }
  return c;
}
// F-SMUG audit (v2 sec 3.6): on P-VM tasks, region bodies must not contain
// DIV(6) or MOD(7). LT/EQ/GT are allowed as probe dispatch per v2 sec 3.3
// (meta-level partition classifiers). Returns 1 PASS, 0 FAIL.
fn audit_fsmug(p:[]u8, task:i32)i32 {
  if(task_pvm(task)==0){ return 1; }
  let i:i32=0;
  while(i<prog_len(p)){
    let op:i32=prog_op(p,i);
    if(op==6){ return 0; }
    if(op==7){ return 0; }
    i=i+1;
  }
  return 1;
}
fn main()void {
  emit("HYPOTHESIS C2: Counterexample-Driven Growth with Non-Myopic Repair\n");
  emit("Battery prereg: 425f7276d. C2 design: e658766bd. C2 prereg: 01336fe83.\n");
  emit("Seed: 0xC2C2C2. Bounds: L=3, BMAX=6, budget 1M evals.\n");
  let task:i32=0;
  while(task<=6){
    emit("=== TASK T"); e64(task); emit(" ===\n");
    let n:i32=task_n_eps(task);
    let idx:[]u8=z_alloc(n*4);
    let i:i32=0;
    while(i<n){ set32(idx, i*4, i); i=i+1; }
    let prog:[]u8=prog_new(500);
    let cnt:[]u8=z_alloc(20);
    set32(cnt,0,0); set32(cnt,4,0); set32(cnt,8,0); set32(cnt,12,0); set32(cnt,16,0);
    let cp_plen:[]u8=z_alloc(32*4); let cp_elen:[]u8=z_alloc(32*4);
    let cp_pops:[]u8=z_alloc(32*200*8); let cp_eops:[]u8=z_alloc(32*3*8);
    let tb_plen:[]u8=z_alloc(32*4); let tb_elen:[]u8=z_alloc(32*4);
    let tb_pops:[]u8=z_alloc(32*200*8); let tb_eops:[]u8=z_alloc(32*3*8);
    let best_P:[]u8=prog_new(200);
    let st:[]u8=z_alloc(16);
    let vstack:[]u8=z_alloc(256*4);
    let ok:i32=grow(task, idx, n, prog, 0, cnt,
                    cp_plen, cp_elen, cp_pops, cp_eops,
                    tb_plen, tb_elen, tb_pops, tb_eops,
                    best_P, st, vstack);
    emit("RESULT t="); e64(task);
    if(ok==1){
      // v2-SOLVE requires ops <= 40 (F-MEM).
      if(prog_len(prog)>40){
        emit(" MEM-FAIL");
      } else {
        emit(" SOLVE");
      }
    } else if(ok==-1){ emit(" BUDGET"); } else { emit(" FAIL"); }
    emit(" len="); e64(prog_len(prog));
    emit(" evals="); emit(i64s(cnt_evals(cnt)));
    emit(" repairs="); e64(cnt_repairs(cnt));
    emit(" backtracks="); e64(cnt_backtracks(cnt));
    emit(" splits="); e64(cnt_splits(cnt));
    emit(" calls="); e64(count_calls(prog));
    emit(" fsmug="); e64(audit_fsmug(prog, task));
    emit(" vm=");
    if(task_pvm(task)==1){ emit("P"); } else { emit("full"); }
    nl();
    emit("PROG");
    let j:i32=0;
    while(j<prog_len(prog)){
      emit(" ("); e64(prog_op(prog,j)); emit(","); e64(prog_arg(prog,j)); emit(")");
      j=j+1;
    }
    nl();
    // Verify on train.
    let nhit:i32=0;
    let k:i32=0;
    while(k<n){
      let in0:i32=task_in0(task, k); let in1:i32=task_in1(task, k); let tgt:i32=task_tgt(task, k);
      if(eval_one(prog, in0, in1, cnt, vstack)==tgt){ nhit=nhit+1; }
      k=k+1;
    }
    let ev:i64=cnt_evals(cnt);
    ev=ev-(n as i64);
    set32(cnt, 0, ev as i32); set32(cnt, 4, (ev>>32) as i32);
    emit("VERIFY train "); e64(nhit); emit("/"); e64(n); nl();
    // Held-out accuracy (reporting only, not part of SOLVE).
    let hn:i32=held_n_eps(task);
    let hhit:i32=0;
    let h:i32=0;
    while(h<hn){
      let in0:i32=held_in0(task, h); let in1:i32=held_in1(task, h); let tgt:i32=held_tgt(task, h);
      if(eval_one(prog, in0, in1, cnt, vstack)==tgt){ hhit=hhit+1; }
      h=h+1;
    }
    let ev2:i64=cnt_evals(cnt);
    ev2=ev2-(hn as i64);
    set32(cnt, 0, ev2 as i32); set32(cnt, 4, (ev2>>32) as i32);
    emit("HELDOUT "); e64(hhit); emit("/"); e64(hn); nl();
    task=task+1;
  }
  emit("DONE\n");
  return;
}

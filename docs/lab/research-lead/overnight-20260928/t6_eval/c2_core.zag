// ============ trace events ============
fn trace_repair(task:i32, ep_idx:i32, seq_op:[]u8, seq_arg:[]u8, slen:i32, c0:i32, c1:i32)void {
  emit("REPAIR t="); e64(task);
  emit(" ep="); e64(ep_idx);
  emit(" seq=[");
  let i:i32=0;
  while(i<slen){
    if(i>0){ emit(" "); }
    op_name(get32(seq_op,i*4), get32(seq_arg,i*4));
    i=i+1;
  }
  emit("] c0="); e64(c0);
  emit(" c1="); e64(c1);
  nl();
  return;
}
fn trace_backtrack(task:i32, seq_op:[]u8, seq_arg:[]u8, slen:i32, depth:i32, bt:i32)void {
  emit("BACKTRACK t="); e64(task);
  emit(" popped=[");
  let i:i32=0;
  while(i<slen){
    if(i>0){ emit(" "); }
    op_name(get32(seq_op,i*4), get32(seq_arg,i*4));
    i=i+1;
  }
  emit("] depth="); e64(depth);
  emit(" bt="); e64(bt);
  nl();
  return;
}
fn trace_split(task:i32, pin:i32, pk:i32, pcmp:i32, nleft:i32, nright:i32)void {
  emit("SPLIT t="); e64(task);
  emit(" probe=[IN"); e64(pin);
  emit(" PUSH "); e64(pk);
  emit(" ");
  if(pcmp==13){ emit("LT"); } else if(pcmp==14){ emit("EQ"); } else { emit("GT"); }
  emit("] nleft="); e64(nleft);
  emit(" nright="); e64(nright);
  nl();
  return;
}
fn trace_fail(task:i32, reason:[]u8)void {
  emit("FAIL t="); e64(task);
  emit(" reason="); emit(reason); nl();
  return;
}

// ============ counters ============
// cnt layout: 0=evals:i64, 8=repairs:i32, 12=splits:i32, 16=backtracks:i32.
// stack is a reusable 256*4 scratch buffer (caller-allocated to avoid OOM).
fn eval_one(p:[]u8, in0:i32, in1:i32, cnt:[]u8, stack:[]u8) i32 {
  let r:i32=vm_run(p, prog_len(p), in0, in1, stack);
  let e:i64=get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
  e=e+1;
  set32(cnt, 0, e as i32); set32(cnt, 4, (e>>32) as i32);
  return r;
}
fn cnt_repairs(cnt:[]u8)i32 { return get32(cnt, 8); }
fn cnt_splits(cnt:[]u8)i32 { return get32(cnt, 12); }
fn cnt_backtracks(cnt:[]u8)i32 { return get32(cnt, 16); }
fn cnt_incr_repairs(cnt:[]u8)void { set32(cnt, 8, get32(cnt,8)+1); return; }
fn cnt_incr_splits(cnt:[]u8)void { set32(cnt, 12, get32(cnt,12)+1); return; }
fn cnt_incr_backtracks(cnt:[]u8)void { set32(cnt, 16, get32(cnt,16)+1); return; }
fn cnt_evals(cnt:[]u8)i64 {
  return get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
}

// ============ probe evaluation ============
fn probe_eval(pin:i32, pk:i32, pcmp:i32, in0:i32, in1:i32)i32 {
  let v:i32=in0;
  if(pin==1){ v=in1; }
  if(pcmp==13){ if(v<pk){return 1;} return 0; }
  if(pcmp==14){ if(v==pk){return 1;} return 0; }
  if(v>pk){return 1;} return 0;
}

// ============ tabu and choice points ============
// Layout: cp_plen[i] at i*4, cp_pops[i] at i*200*8, cp_eops[i] at i*3*8.
// Max 32 choice points, max prefix 200 ops, max ext 3 ops.

fn tabu_check(P:[]u8, seq_op:[]u8, seq_arg:[]u8, slen:i32,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
              tabu_n:i32) i32 {
  let pl:i32=prog_len(P);
  let i:i32=0;
  while(i<tabu_n){
    let tpl:i32=get32(tb_plen, i*4);
    let tel:i32=get32(tb_elen, i*4);
    if(tpl==pl && tel==slen){
      let ok:i32=1;
      let j:i32=0;
      while(j<pl){
        if(prog_op(P,j)!=get32(tb_pops, i*200*8 + j*8)){ ok=0; break; }
        if(prog_arg(P,j)!=get32(tb_pops, i*200*8 + j*8 + 4)){ ok=0; break; }
        j=j+1;
      }
      if(ok==1){
        let k:i32=0;
        while(k<slen){
          if(get32(seq_op,k*4)!=get32(tb_eops, i*3*8 + k*8)){ ok=0; break; }
          if(get32(seq_arg,k*4)!=get32(tb_eops, i*3*8 + k*8 + 4)){ ok=0; break; }
          k=k+1;
        }
      }
      if(ok==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn cp_push(P:[]u8, seq_op:[]u8, seq_arg:[]u8, slen:i32,
           cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
           ncp:i32) void {
  let pl:i32=prog_len(P);
  set32(cp_plen, ncp*4, pl);
  set32(cp_elen, ncp*4, slen);
  let j:i32=0;
  while(j<pl){
    set32(cp_pops, ncp*200*8 + j*8, prog_op(P,j));
    set32(cp_pops, ncp*200*8 + j*8 + 4, prog_arg(P,j));
    j=j+1;
  }
  let k:i32=0;
  while(k<slen){
    set32(cp_eops, ncp*3*8 + k*8, get32(seq_op,k*4));
    set32(cp_eops, ncp*3*8 + k*8 + 4, get32(seq_arg,k*4));
    k=k+1;
  }
  return;
}
fn cp_restore(P:[]u8, cp_plen:[]u8, cp_pops:[]u8, i:i32) void {
  let pl:i32=get32(cp_plen, i*4);
  prog_set_len(P, pl);
  let j:i32=0;
  while(j<pl){
    prog_set(P, j, get32(cp_pops, i*200*8 + j*8), get32(cp_pops, i*200*8 + j*8 + 4));
    j=j+1;
  }
  return;
}
fn cp_get_ext(cp_elen:[]u8, cp_eops:[]u8, i:i32, seq_op:[]u8, seq_arg:[]u8) i32 {
  let slen:i32=get32(cp_elen, i*4);
  let k:i32=0;
  while(k<slen){
    set32(seq_op, k*4, get32(cp_eops, i*3*8 + k*8));
    set32(seq_arg, k*4, get32(cp_eops, i*3*8 + k*8 + 4));
    k=k+1;
  }
  return slen;
}
fn cp_to_tabu(cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8, cpi:i32,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8, tabu_n:i32) void {
  let pl:i32=get32(cp_plen, cpi*4);
  let el:i32=get32(cp_elen, cpi*4);
  set32(tb_plen, tabu_n*4, pl);
  set32(tb_elen, tabu_n*4, el);
  let j:i32=0;
  while(j<pl){
    set32(tb_pops, tabu_n*200*8 + j*8, get32(cp_pops, cpi*200*8 + j*8));
    set32(tb_pops, tabu_n*200*8 + j*8 + 4, get32(cp_pops, cpi*200*8 + j*8 + 4));
    j=j+1;
  }
  let k:i32=0;
  while(k<el){
    set32(tb_eops, tabu_n*3*8 + k*8, get32(cp_eops, cpi*3*8 + k*8));
    set32(tb_eops, tabu_n*3*8 + k*8 + 4, get32(cp_eops, cpi*3*8 + k*8 + 4));
    k=k+1;
  }
  return;
}

// ============ fix search (lookahead L=3, net-progress) ============
// Returns 1 if improving fix applied, 0 if none, -1 if budget exceeded.
// On 1: P extended, choice pushed, best_P updated if improved, REPAIR traced.
fn fix_search(task:i32, idx:[]u8, n:i32, P:[]u8, fe:i32, c:i32,
              cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
              tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
              best_P:[]u8, st:[]u8, cnt:[]u8, vstack:[]u8) i32 {
  let fin0:i32=task_in0(task, fe);
  let fin1:i32=task_in1(task, fe);
  let ftgt:i32=task_tgt(task, fe);
  let tabu_n:i32=get32(st, 4);
  let ncp:i32=get32(st, 0);
  let pvm:i32=task_pvm(task);
  let asz:i32=alpha_size(task);
  let asz2:i32=asz*asz;
  let asz3:i32=asz2*asz;

  let best_c:i32=-1;
  let best_l:i32=999;
  let best_seq_op:[]u8=z_alloc(3*4);
  let best_seq_arg:[]u8=z_alloc(3*4);
  let best_slen:i32=0;

  let cand:[]u8=prog_new(210);
  let so:[]u8=z_alloc(3*4);
  let sa:[]u8=z_alloc(3*4);

  let L:i32=1;
  while(L<=3){
    let total:i32=asz;
    if(L==2){ total=asz2; }
    if(L==3){ total=asz3; }
    let s:i32=0;
    while(s<total){
      if(cnt_evals(cnt)>1000000){ return -1; }
      let d0:i32=0; let d1:i32=0; let d2:i32=0;
      if(L==1){ d0=s; }
      if(L==2){ d0=s/asz; d1=s%asz; }
      if(L==3){ d0=s/asz2; d1=(s/asz)%asz; d2=s%asz; }
      set32(so, 0, alpha_op(d0, pvm)); set32(sa, 0, alpha_arg(d0, pvm));
      if(L>=2){ set32(so, 4, alpha_op(d1, pvm)); set32(sa, 4, alpha_arg(d1, pvm)); }
      if(L>=3){ set32(so, 8, alpha_op(d2, pvm)); set32(sa, 8, alpha_arg(d2, pvm)); }
      prog_copy(cand, P);
      let k:i32=0;
      while(k<L){
        prog_append(cand, get32(so,k*4), get32(sa,k*4));
        k=k+1;
      }
      // Phase 1: must fix e.
      if(eval_one(cand, fin0, fin1, cnt, vstack)==ftgt){
        // Tabu check.
        if(tabu_check(P, so, sa, L, tb_plen, tb_elen, tb_pops, tb_eops, tabu_n)==0){
          // Phase 2: count train episodes passed.
          let cntpass:i32=0;
          let j:i32=0;
          while(j<n){
            let ei:i32=get32(idx, j*4);
            let in0:i32=task_in0(task, ei);
            let in1:i32=task_in1(task, ei);
            let tgt:i32=task_tgt(task, ei);
            if(eval_one(cand, in0, in1, cnt, vstack)==tgt){ cntpass=cntpass+1; }
            j=j+1;
          }
          // Argmax: (count desc, length asc, lex asc). Lex is automatic
          // because enumeration is in lex order within each length.
          if(cntpass>best_c || (cntpass==best_c && L<best_l)){
            best_c=cntpass;
            best_l=L;
            best_slen=L;
            let m:i32=0;
            while(m<L){
              set32(best_seq_op, m*4, get32(so,m*4));
              set32(best_seq_arg, m*4, get32(sa,m*4));
              m=m+1;
            }
          }
        }
      }
      s=s+1;
    }
    L=L+1;
  }

  if(best_c>c){
    // Push choice point (prefix BEFORE append).
    cp_push(P, best_seq_op, best_seq_arg, best_slen,
            cp_plen, cp_elen, cp_pops, cp_eops, ncp);
    set32(st, 0, ncp+1);
    // Append to P.
    let k:i32=0;
    while(k<best_slen){
      prog_append(P, get32(best_seq_op,k*4), get32(best_seq_arg,k*4));
      k=k+1;
    }
    // Update best_P if improved.
    let bc:i32=get32(st, 12);
    if(best_c>bc){
      prog_copy(best_P, P);
      set32(st, 12, best_c);
    }
    cnt_incr_repairs(cnt);
    trace_repair(task, fe, best_seq_op, best_seq_arg, best_slen, c, best_c);
    return 1;
  }
  return 0;
}

// ============ the grow function (C2) ============
// Grows a program for the episode subset idx[0..n).
// Returns 1 on SOLVE, 0 on FAIL, -1 on budget exceeded.
// State per call: P, best_P/best_count, choice stack, tabu, backtracks_used.
fn grow(task:i32, idx:[]u8, n:i32, out_prog:[]u8, depth:i32, cnt:[]u8,
        cp_plen:[]u8, cp_elen:[]u8, cp_pops:[]u8, cp_eops:[]u8,
        tb_plen:[]u8, tb_elen:[]u8, tb_pops:[]u8, tb_eops:[]u8,
        best_P:[]u8, st:[]u8, vstack:[]u8) i32 {
  let P:[]u8=prog_new(200);
  prog_set_len(best_P, 0);
  set32(st, 0, 0);   // ncp
  set32(st, 4, 0);   // tabu_n
  set32(st, 8, 0);   // backtracks_used
  set32(st, 12, -1); // best_count

  let iter:i32=0;
  let fail_idx:[]u8=z_alloc(25*4);
  let pass_idx:[]u8=z_alloc(25*4);
  while(iter<1000){
    iter=iter+1;
    if(cnt_evals(cnt)>1000000){
      trace_fail(task, "budget exceeded");
      return -1;
    }
    // Evaluate P on all episodes in subset.
    let nfail:i32=0;
    let npass:i32=0;
    let i:i32=0;
    while(i<n){
      let ei:i32=get32(idx, i*4);
      let in0:i32=task_in0(task, ei);
      let in1:i32=task_in1(task, ei);
      let tgt:i32=task_tgt(task, ei);
      let out:i32=eval_one(P, in0, in1, cnt, vstack);
      if(out==tgt){
        set32(pass_idx, npass*4, ei); npass=npass+1;
      } else {
        set32(fail_idx, nfail*4, ei); nfail=nfail+1;
      }
      i=i+1;
    }
    if(nfail==0){
      prog_copy(out_prog, P);
      return 1;
    }
    // Update best_P if improved.
    let bc:i32=get32(st, 12);
    if(npass>bc){
      prog_copy(best_P, P);
      set32(st, 12, npass);
    }
    let fe:i32=get32(fail_idx, 0);
    // Try fix search (lookahead, net-progress).
    let fr:i32=fix_search(task, idx, n, P, fe, npass,
                          cp_plen, cp_elen, cp_pops, cp_eops,
                          tb_plen, tb_elen, tb_pops, tb_eops,
                          best_P, st, cnt, vstack);
    if(fr==-1){
      trace_fail(task, "budget exceeded");
      return -1;
    }
    if(fr==1){
      continue;
    }
    // No improving fix. Try chronological backtracking.
    let ncp:i32=get32(st, 0);
    let btu:i32=get32(st, 8);
    if(ncp>0 && btu<6){
      let cpi:i32=ncp-1;
      let seq_op:[]u8=z_alloc(3*4);
      let seq_arg:[]u8=z_alloc(3*4);
      let slen:i32=cp_get_ext(cp_elen, cp_eops, cpi, seq_op, seq_arg);
      let tabu_n:i32=get32(st, 4);
      cp_to_tabu(cp_plen, cp_elen, cp_pops, cp_eops, cpi,
                 tb_plen, tb_elen, tb_pops, tb_eops, tabu_n);
      set32(st, 4, tabu_n+1);
      cp_restore(P, cp_plen, cp_pops, cpi);
      set32(st, 0, cpi);
      set32(st, 8, btu+1);
      cnt_incr_backtracks(cnt);
      trace_backtrack(task, seq_op, seq_arg, slen, cpi, btu+1);
      continue;
    }
    // Stagnation: split from best_P.
    // Find first probe from frozen family with episodes on both sides.
    let found:i32=0;
    let spin:i32=0; let spk:i32=0; let spcmp:i32=0;
    let left_idx:[]u8=z_alloc(25*4);
    let right_idx:[]u8=z_alloc(25*4);
    let nl:i32=0; let nr:i32=0;
    let pin:i32=0;
    while(pin<=1){
      if(found==1){ break; }
      let k:i32=-4;
      while(k<=4){
        if(found==1){ break; }
        let cmp:i32=13;
        while(cmp<=15){
          if(found==1){ break; }
          nl=0; nr=0;
          let j:i32=0;
          while(j<n){
            let ei:i32=get32(idx, j*4);
            let in0:i32=task_in0(task, ei);
            let in1:i32=task_in1(task, ei);
            if(probe_eval(pin, k, cmp, in0, in1)==1){
              set32(left_idx, nl*4, ei); nl=nl+1;
            } else {
              set32(right_idx, nr*4, ei); nr=nr+1;
            }
            j=j+1;
          }
          if(nl>0 && nr>0){
            found=1; spin=pin; spk=k; spcmp=cmp;
          }
          cmp=cmp+1;
        }
        k=k+1;
      }
      pin=pin+1;
    }
    if(found==0){
      trace_fail(task, "no probe separates");
      return 0;
    }
    cnt_incr_splits(cnt);
    trace_split(task, spin, spk, spcmp, nl, nr);
    // Recursively grow each branch with fresh state.
    let left_prog:[]u8=prog_new(500);
    let right_prog:[]u8=prog_new(500);
    let r1_cpl:[]u8=z_alloc(32*4); let r1_cel:[]u8=z_alloc(32*4);
    let r1_cpo:[]u8=z_alloc(32*200*8); let r1_ceo:[]u8=z_alloc(32*3*8);
    let r1_tbl:[]u8=z_alloc(32*4); let r1_tel:[]u8=z_alloc(32*4);
    let r1_tbo:[]u8=z_alloc(32*200*8); let r1_teo:[]u8=z_alloc(32*3*8);
    let r1_best:[]u8=prog_new(200); let r1_st:[]u8=z_alloc(16);
    let lok:i32=grow(task, left_idx, nl, left_prog, depth+1, cnt,
                     r1_cpl, r1_cel, r1_cpo, r1_ceo,
                     r1_tbl, r1_tel, r1_tbo, r1_teo,
                     r1_best, r1_st, vstack);
    if(lok!=1){ return lok; }
    let r2_cpl:[]u8=z_alloc(32*4); let r2_cel:[]u8=z_alloc(32*4);
    let r2_cpo:[]u8=z_alloc(32*200*8); let r2_ceo:[]u8=z_alloc(32*3*8);
    let r2_tbl:[]u8=z_alloc(32*4); let r2_tel:[]u8=z_alloc(32*4);
    let r2_tbo:[]u8=z_alloc(32*200*8); let r2_teo:[]u8=z_alloc(32*3*8);
    let r2_best:[]u8=prog_new(200); let r2_st:[]u8=z_alloc(16);
    let rok:i32=grow(task, right_idx, nr, right_prog, depth+1, cnt,
                     r2_cpl, r2_cel, r2_cpo, r2_ceo,
                     r2_tbl, r2_tel, r2_tbo, r2_teo,
                     r2_best, r2_st, vstack);
    if(rok!=1){ return rok; }
    // Compile: best_P + probe + JZ + left + JMP + right.
    let comp:[]u8=prog_new(500);
    prog_copy(comp, best_P);
    let pin_op:i32=1+spin;
    prog_append(comp, pin_op, 0);
    prog_append(comp, 0, spk);
    prog_append(comp, spcmp, 0);
    let jz_pos:i32=prog_len(comp);
    prog_append(comp, 16, 0);
    let li:i32=0;
    while(li<prog_len(left_prog)){
      prog_append(comp, prog_op(left_prog, li), prog_arg(left_prog, li));
      li=li+1;
    }
    let jmp_pos:i32=prog_len(comp);
    prog_append(comp, 18, 0);
    let right_start:i32=prog_len(comp);
    let ri:i32=0;
    while(ri<prog_len(right_prog)){
      prog_append(comp, prog_op(right_prog, ri), prog_arg(right_prog, ri));
      ri=ri+1;
    }
    let end_pos:i32=prog_len(comp);
    prog_set(comp, jz_pos, 16, right_start);
    prog_set(comp, jmp_pos, 18, end_pos);
    prog_copy(out_prog, comp);
    return 1;
  }
  trace_fail(task, "iteration limit");
  return 0;
}


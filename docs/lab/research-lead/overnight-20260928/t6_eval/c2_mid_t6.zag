// ============ op alphabet (frozen) ============
// Full VM: 34 symbols.
// Order: IN0, IN1, PUSH -9..9, ADD, SUB, MUL, DIV, MOD, NEG, DUP, DROP,
//        SWAP, OVER, LT, EQ, GT.
fn alpha_op_full(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i>=2 && i<=20){ return 0; }
  if(i==21){ return 3; }
  if(i==22){ return 4; }
  if(i==23){ return 5; }
  if(i==24){ return 6; }
  if(i==25){ return 7; }
  if(i==26){ return 8; }
  if(i==27){ return 9; }
  if(i==28){ return 10; }
  if(i==29){ return 11; }
  if(i==30){ return 12; }
  if(i==31){ return 13; }
  if(i==32){ return 14; }
  return 15;
}
fn alpha_arg_full(i:i32)i32 {
  if(i>=2 && i<=20){ return i-11; }
  return 0;
}
// GENEXEC2-P: 29 symbols (DIV, MOD, LT, EQ, GT removed).
// Order: IN0, IN1, PUSH -9..9, ADD, SUB, MUL, NEG, DUP, DROP, SWAP, OVER.
fn alpha_op_pvm(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i>=2 && i<=20){ return 0; }
  if(i==21){ return 3; }
  if(i==22){ return 4; }
  if(i==23){ return 5; }
  if(i==24){ return 8; }
  if(i==25){ return 9; }
  if(i==26){ return 10; }
  if(i==27){ return 11; }
  return 12;
}
fn alpha_arg_pvm(i:i32)i32 {
  if(i>=2 && i<=20){ return i-11; }
  return 0;
}
// Dispatcher: pvm=1 for GENEXEC2-P, 0 for full.
fn alpha_op(i:i32, pvm:i32)i32 {
  if(pvm==1){ return alpha_op_pvm(i); }
  return alpha_op_full(i);
}
fn alpha_arg(i:i32, pvm:i32)i32 {
  if(pvm==1){ return alpha_arg_pvm(i); }
  return alpha_arg_full(i);
}
fn alpha_size(task:i32)i32 {
  // T1, T4, T5 use GENEXEC2-P (29 symbols). T0, T2, T3 use full (34).
  if(task==1){ return 29; }
  if(task==4){ return 29; }
  if(task==5){ return 29; }
  if(task==6){ return 29; }
  return 34;
}
fn task_pvm(task:i32)i32 {
  if(task==1){ return 1; }
  if(task==4){ return 1; }
  if(task==5){ return 1; }
  if(task==6){ return 1; }
  return 0;
}
fn op_name(op:i32, arg:i32)void {
  if(op==0){ emit("PUSH "); e64(arg); return; }
  if(op==1){ emit("IN0"); return; }
  if(op==2){ emit("IN1"); return; }
  if(op==3){ emit("ADD"); return; }
  if(op==4){ emit("SUB"); return; }
  if(op==5){ emit("MUL"); return; }
  if(op==6){ emit("DIV"); return; }
  if(op==7){ emit("MOD"); return; }
  if(op==8){ emit("NEG"); return; }
  if(op==9){ emit("DUP"); return; }
  if(op==10){ emit("DROP"); return; }
  if(op==11){ emit("SWAP"); return; }
  if(op==12){ emit("OVER"); return; }
  if(op==13){ emit("LT"); return; }
  if(op==14){ emit("EQ"); return; }
  if(op==15){ emit("GT"); return; }
  emit("?"); return;
}


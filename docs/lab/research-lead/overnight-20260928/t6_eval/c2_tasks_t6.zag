// ============ task episodes ============
// Task IDs: 0=T0 2x+1, 1=T1 abs, 2=T2 mod3, 3=T3 parity, 4=T4 nested abs, 5=T5 fragcomp.
// 6=T6 sealed capstone (train episodes ONLY, from sealed T6_SPEC.md section 3).
// Held-out episodes are NOT present in this file (revealed post-report).
fn task_n_eps(task:i32)i32 {
  if(task==0){ return 9; }
  if(task==1){ return 17; }
  if(task==2){ return 17; }
  if(task==3){ return 25; }
  if(task==4){ return 13; }
  if(task==5){ return 13; }
  if(task==6){ return 12; }
  return 0;
}
fn task_in0(task:i32, i:i32)i32 {
  if(task==0){ return i; }
  if(task==1){ return i-8; }
  if(task==2){ return i; }
  if(task==3){ return i/5; }
  if(task==4){ return i-6; }
  if(task==5){ return i-4; }
  if(task==6){
    if(i==0){ return -2; } if(i==1){ return 0; } if(i==2){ return 1; }
    if(i==3){ return 3; } if(i==4){ return 2; } if(i==5){ return -2; }
    if(i==6){ return 1; } if(i==7){ return 0; } if(i==8){ return 3; }
    if(i==9){ return -1; } if(i==10){ return 2; } if(i==11){ return -3; }
    return 0;
  }
  return 0;
}
fn task_in1(task:i32, i:i32)i32 {
  if(task==3){ let a:i32=i/5; return i-(a*5); }
  if(task==6){
    if(i==0){ return -2; } if(i==1){ return 0; } if(i==2){ return 1; }
    if(i==3){ return 3; } if(i==4){ return 2; } if(i==5){ return 1; }
    if(i==6){ return -2; } if(i==7){ return 3; } if(i==8){ return 0; }
    if(i==9){ return -2; } if(i==10){ return -1; } if(i==11){ return 1; }
    return 0;
  }
  return 0;
}
fn task_tgt(task:i32, i:i32)i32 {
  if(task==0){ let x:i32=i; return 2*x+1; }
  if(task==1){ let x:i32=i-8; if(x<0){return -x;} return x; }
  if(task==2){ let x:i32=i; return mod_nonneg(x,3); }
  if(task==3){ let a:i32=i/5; let b:i32=i-(a*5); if(mod_nonneg(a+b,2)==0){return 1;} return 0; }
  if(task==4){ let x:i32=i-6; let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} return d; }
  if(task==5){ let x:i32=i-4; let ax:i32=x; if(ax<0){ax=-ax;} let bx:i32=x-2; if(bx<0){bx=-bx;} return ax+bx; }
  if(task==6){
    if(i==0){ return 4; } if(i==1){ return 0; } if(i==2){ return 1; }
    if(i==3){ return 9; } if(i==4){ return 4; } if(i==5){ return -1; }
    if(i==6){ return -1; } if(i==7){ return 3; } if(i==8){ return 3; }
    if(i==9){ return -3; } if(i==10){ return 1; } if(i==11){ return -2; }
    return 0;
  }
  return 0;
}
// Held-out episodes (battery prereg section 2). For reporting only.
fn held_n_eps(task:i32)i32 {
  if(task==0){ return 16; }
  if(task==1){ return 8; }
  if(task==2){ return 17; }
  if(task==3){ return 39; }
  if(task==4){ return 8; }
  if(task==5){ return 8; }
  return 0;
}
fn held_in0(task:i32, i:i32)i32 {
  if(task==0){ if(i<8){ return -8+i; } return 9+(i-8); }
  if(task==1){ if(i<4){ return -12+i; } return 9+(i-4); }
  if(task==2){ return 17+i; }
  if(task==3){
    // a,b in 0..7 excluding 0..4 square. Enumerate 64, skip 25.
    let a:i32=0; let cnt:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a>4 || b>4){
          if(cnt==i){ return a; }
          cnt=cnt+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    return 0;
  }
  if(task==4){ if(i<4){ return -10+i; } return 7+(i-4); }
  if(task==5){ if(i<4){ return -8+i; } return 9+(i-4); }
  return 0;
}
fn held_in1(task:i32, i:i32)i32 {
  if(task==3){
    let a:i32=0; let cnt:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a>4 || b>4){
          if(cnt==i){ return b; }
          cnt=cnt+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    return 0;
  }
  return 0;
}
fn held_tgt(task:i32, i:i32)i32 {
  if(task==0){ let x:i32=held_in0(task,i); return 2*x+1; }
  if(task==1){ let x:i32=held_in0(task,i); if(x<0){return -x;} return x; }
  if(task==2){ let x:i32=held_in0(task,i); return mod_nonneg(x,3); }
  if(task==3){
    let a:i32=held_in0(task,i); let b:i32=held_in1(task,i);
    if(mod_nonneg(a+b,2)==0){return 1;} return 0;
  }
  if(task==4){
    let x:i32=held_in0(task,i); let ax:i32=x; if(ax<0){ax=-ax;}
    let d:i32=ax-2; if(d<0){d=-d;} return d;
  }
  if(task==5){
    let x:i32=held_in0(task,i); let ax:i32=x; if(ax<0){ax=-ax;}
    let bx:i32=x-2; if(bx<0){bx=-bx;} return ax+bx;
  }
  return 0;
}


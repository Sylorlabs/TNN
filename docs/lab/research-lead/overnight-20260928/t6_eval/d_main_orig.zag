// ============ main ============
fn main()void {
  emit("HYP_D_MAPELITES\n");
  emit("PREREG_HYPD_V2\n");
  // Carry buffers (ping-pong). Each program 132 bytes, max 56576.
  let carry_a:[]u8=z_alloc(56576*132);
  let carry_b:[]u8=z_alloc(56576*132);
  let carry_n:i32=0;
  let use_a:i32=1; // carry_in is carry_a when use_a==1
  let t:i32=0;
  while(t<=5){
    let ein0:[]u8=z_alloc(64*4);
    let ein1:[]u8=z_alloc(64*4);
    let etgt:[]u8=z_alloc(64*4);
    let n:i32=build_train(t, ein0, ein1, etgt);
    let t0:i64=now_ms();
    // v2 VM assignment: T1/T4/T5 on GENEXEC2-P (pvm=1, 29 templates);
    // T0/T2/T3 on full GENEXEC2 (pvm=0, 31 templates).
    let pvm:i32=0;
    let nt:i32=31;
    if(t==1 || t==4 || t==5){pvm=1; nt=29;}
    let new_n:i32=0;
    if(use_a==1){
      new_n=run_task(t, ein0, ein1, etgt, n, carry_a, carry_n, carry_b, t0, pvm, nt);
    } else {
      new_n=run_task(t, ein0, ein1, etgt, n, carry_b, carry_n, carry_a, t0, pvm, nt);
    }
    carry_n=new_n;
    if(use_a==1){use_a=0;} else {use_a=1;}
    z_free(ein0); z_free(ein1); z_free(etgt);
    t=t+1;
  }
  // Fresh-state reruns for T4 and T5 (transfer pair). Both are P-VM tasks.
  emit("FRESH_RERUNS\n");
  let ft:i32=4;
  while(ft<=5){
    let ein0:[]u8=z_alloc(64*4);
    let ein1:[]u8=z_alloc(64*4);
    let etgt:[]u8=z_alloc(64*4);
    let n:i32=build_train(ft, ein0, ein1, etgt);
    let t0:i64=now_ms();
    let dummy:[]u8=z_alloc(132);
    let dn:i32=0;
    if(use_a==1){
      dn=run_task(ft, ein0, ein1, etgt, n, dummy, 0, carry_b, t0, 1, 29);
    } else {
      dn=run_task(ft, ein0, ein1, etgt, n, dummy, 0, carry_a, t0, 1, 29);
    }
    // dn discarded; fresh rerun does not affect carried state.
    emit("FRESH_TASK "); e64(ft); emit(" done\n");
    z_free(ein0); z_free(ein1); z_free(etgt); z_free(dummy);
    ft=ft+1;
  }
  z_free(carry_a); z_free(carry_b);
  emit("DONE\n");
  return;
}

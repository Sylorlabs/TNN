// ============ task episodes (frozen per battery PREREG_BATTERY.md) ============
// Train builders. Fill ein0, ein1, etgt (each n*4 bytes). Returns n.
fn build_train(t:i32, ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  if(t==0){
    let x:i32=0;
    while(x<=8){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,2*x+1);
      n=n+1; x=x+1;
    }
  } else if(t==1){
    let x:i32=-8;
    while(x<=8){
      let y:i32=x; if(y<0){y=-y;}
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,y);
      n=n+1; x=x+1;
    }
  } else if(t==2){
    let x:i32=0;
    while(x<=16){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,mod_nonneg(x,3));
      n=n+1; x=x+1;
    }
  } else if(t==3){
    let a:i32=0;
    while(a<=4){
      let b:i32=0;
      while(b<=4){
        let y:i32=0; if(mod_nonneg(a+b,2)==0){y=1;}
        set32(ein0,n*4,a); set32(ein1,n*4,b); set32(etgt,n*4,y);
        n=n+1; b=b+1;
      }
      a=a+1;
    }
  } else if(t==4){
    let x:i32=-6;
    while(x<=6){
      let ax:i32=x; if(ax<0){ax=-ax;}
      let d:i32=ax-2; if(d<0){d=-d;}
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,d);
      n=n+1; x=x+1;
    }
  } else if(t==5){
    let x:i32=-4;
    while(x<=8){
      let ax:i32=x; if(ax<0){ax=-ax;}
      let b2:i32=x-2; if(b2<0){b2=-b2;}
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,ax+b2);
      n=n+1; x=x+1;
    }
  } else if(t==6){
    // T6 sealed capstone: train episodes ONLY (sealed T6_SPEC.md section 3).
    // f(a,b) = a*b if a==b else a+b.
    let ta:[]u8=z_alloc(12*4); let tb:[]u8=z_alloc(12*4); let tt:[]u8=z_alloc(12*4);
    set32(ta,0,-2); set32(tb,0,-2); set32(tt,0,4);
    set32(ta,4,0); set32(tb,4,0); set32(tt,4,0);
    set32(ta,8,1); set32(tb,8,1); set32(tt,8,1);
    set32(ta,12,3); set32(tb,12,3); set32(tt,12,9);
    set32(ta,16,2); set32(tb,16,2); set32(tt,16,4);
    set32(ta,20,-2); set32(tb,20,1); set32(tt,20,-1);
    set32(ta,24,1); set32(tb,24,-2); set32(tt,24,-1);
    set32(ta,28,0); set32(tb,28,3); set32(tt,28,3);
    set32(ta,32,3); set32(tb,32,0); set32(tt,32,3);
    set32(ta,36,-1); set32(tb,36,-2); set32(tt,36,-3);
    set32(ta,40,2); set32(tb,40,-1); set32(tt,40,1);
    set32(ta,44,-3); set32(tb,44,1); set32(tt,44,-2);
    let k:i32=0;
    while(k<12){
      set32(ein0,n*4,get32(ta,k*4)); set32(ein1,n*4,get32(tb,k*4));
      set32(etgt,n*4,get32(tt,k*4));
      n=n+1; k=k+1;
    }
    z_free(ta); z_free(tb); z_free(tt);
  }
  return n;
}
// Held-out builders. Returns n.
fn build_heldout(t:i32, ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  if(t==0){
    let x:i32=-8;
    while(x<0){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,2*x+1);
      n=n+1; x=x+1;
    }
    x=9;
    while(x<=16){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,2*x+1);
      n=n+1; x=x+1;
    }
  } else if(t==1){
    let x:i32=-12;
    while(x<=12){
      if(x<-8 || x>8){
        let y:i32=x; if(y<0){y=-y;}
        set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,y);
        n=n+1;
      }
      x=x+1;
    }
  } else if(t==2){
    let x:i32=17;
    while(x<=33){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,mod_nonneg(x,3));
      n=n+1; x=x+1;
    }
  } else if(t==3){
    let a:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a>4 || b>4){
          let y:i32=0; if(mod_nonneg(a+b,2)==0){y=1;}
          set32(ein0,n*4,a); set32(ein1,n*4,b); set32(etgt,n*4,y);
          n=n+1;
        }
        b=b+1;
      }
      a=a+1;
    }
  } else if(t==4){
    let x:i32=-10;
    while(x<=10){
      if(x<-6 || x>6){
        let ax:i32=x; if(ax<0){ax=-ax;}
        let d:i32=ax-2; if(d<0){d=-d;}
        set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,d);
        n=n+1;
      }
      x=x+1;
    }
  } else if(t==5){
    let x:i32=-8;
    while(x<=12){
      if(x<-4 || x>8){
        let ax:i32=x; if(ax<0){ax=-ax;}
        let b2:i32=x-2; if(b2<0){b2=-b2;}
        set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,ax+b2);
        n=n+1;
      }
      x=x+1;
    }
  }
  return n;
}
fn task_name(t:i32)[]u8 {
  if(t==0){return "2x+1";}
  if(t==1){return "abs";}
  if(t==2){return "mod3";}
  if(t==3){return "parity";}
  if(t==4){return "nestedabs";}
  if(t==6){return "t6sealed";}
  return "fragcomp";
}


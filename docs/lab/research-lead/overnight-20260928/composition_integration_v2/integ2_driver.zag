// integ2_driver.zag -- H-COMPINTEG-2 battery driver.
//
// I1 extend + learner verification + self-wiring (guards active).
// I2 truncate + learner verification + self-wiring (guards active).
// I6 specialize + learner verification + self-wiring (guards active).
// I4 withhold gates adaptation.
// I3 stale adaptation revised under learner verification.
// I5 recovery diagnostic (continues I3's workspace; non-gating).
// G1 guard regression: zero self-referential trials, FACT convergence.
// G2 guard regression: stale revision fires, no circular promotion.
// G3 guard regression: consequence converges after world change.
// S1 routing diagnostic: superseded-licensing stale trial (non-gating).
// 3/3 byte-identical runs required.

// ---- helpers (id_ prefixed; no clashes with base/patch) ----
fn id_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn id_train_x(W:[]u8,out:[]u8)void {
  ev_teach(W,11,70,12); ev_teach(W,12,70,13); ev_teach(W,13,70,14);
  let x:i32=ev_query_adapt(W,11,71,14,0);
  emit("ID-TRAIN-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  return;
}
fn id_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn id_count14to(W:[]u8,t:i32)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14 && eg(W,e,8)==t){c=c+1;}
    e=e+1;
  }
  return c;
}
// total type-14 edges workspace-wide.
fn id_count14_total(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){c=c+1;}
    e=e+1;
  }
  return c;
}
fn id_adapt_src(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn id_count16(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
fn id_count_adapted(W:[]u8)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    if(rev_is_adapted(W,m)==1){c=c+1;}
    m=m+1;
  }
  return c;
}
fn id_live_maps(W:[]u8)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){c=c+1;}
    m=m+1;
  }
  return c;
}
fn id_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
fn id_find_adapted_seq(W:[]u8,exp:[]u8,n:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(rev_is_adapted(W,m)==1 && id_relseq_eq(W,m,exp,n)==1){return m;}
    m=m+1;
  }
  return -1;
}
// count of live tag-20 MAPs whose relseq equals exp[0..n-1].
fn id_count_relseq(W:[]u8,exp:[]u8,n:i32)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && id_relseq_eq(W,m,exp,n)==1){c=c+1;}
    m=m+1;
  }
  return c;
}
// lowest-id live non-superseded FACT (s,r,o), or -1.
fn id_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==1 && is_superseded(W,m)==0){
      if(ng(W,m,20)==s && ng(W,m,24)==r && ng(W,m,28)==o){return m;}
    }
    m=m+1;
  }
  return -1;
}
fn id_fact_score(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let m:i32=id_find_fact(W,s,r,o);
  if(m<0){return -999999;}
  return ng(W,m,8);
}
fn id_zfacts_xrel(W:[]u8)void {
  ev_teach(W,101,70,102); ev_teach(W,102,70,103);
  ev_teach(W,103,70,104); ev_teach(W,104,2,108);
  return;
}
fn id_zfacts_i3(W:[]u8,out:[]u8)void {
  ev_teach(W,101,70,102); ev_teach(W,102,70,103);
  ev_teach(W,103,70,104);
  let f:i32=ev_teach(W,104,2,108);
  set32(out,0,f);
  return;
}
fn id_retire_fact(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==1 && ng(W,m,20)==s && ng(W,m,24)==r){
      ns(W,m,36,0);
      m=1024;
    }
    m=m+1;
  }
  return;
}
fn id_explore4(W:[]u8,s:i32,r:i32,op:i32,oval:i32)i32 {
  let k:i32=0;
  while(k<4){
    integ_explore(W,s,r,op,1,0);
    k=k+1;
  }
  return id_fact_score(W,s,r,oval);
}

// ---- I1: extend + learner verification + self-wiring ----
fn i1_arm(W:[]u8)void {
  emit("=== I1-INTEGRATE-EXTEND ===\n");
  let out:[]u8=z_alloc(8);
  id_train_x(W,out);
  let mapx:i32=get32(out,0);
  id_gap(W);
  id_zfacts_xrel(W);
  let sc:i32=id_explore4(W,101,79,1,108);
  emit("I1 explore FACT score="); e64(sc); emit("\n");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ2(W,101,79,0,st);
  emit("I1-ANS="); e64(q); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,70); set32(ex,4,70); set32(ex,8,70); set32(ex,12,2);
  let a:i32=id_find_adapted_seq(W,ex,4);
  let p1:i32=0; if(q==108){p1=1;}
  let p2:i32=0; if(a>=0 && id_adapt_src(W,a)==mapx && ng(W,a,12)==1){p2=1;}
  let p3:i32=id_has14(W,mapz,a);
  let p4:i32=0; if(id_count_adapted(W)==2){p4=1;}
  let p5:i32=0; if(sc>=3){p5=1;}
  emit("I1 p1(ans108)="); e64(p1);
  emit(" p2(a16X-kind1)="); e64(p2);
  emit(" p3(z14a)="); e64(p3);
  emit(" p4(2adapted)="); e64(p4);
  emit(" p5(score3)="); e64(p5); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1){
    emit("I1-INTEGRATE-EXTEND=PASS\n");
  } else {
    emit("I1-INTEGRATE-EXTEND=FAIL\n");
  }
  return;
}

// ---- I2: truncate + learner verification + self-wiring ----
fn i2_arm(W:[]u8)void {
  emit("=== I2-INTEGRATE-TRUNCATE ===\n");
  let out:[]u8=z_alloc(8);
  id_train_x(W,out);
  let mapx:i32=get32(out,0);
  id_gap(W);
  let sc:i32=id_explore4(W,11,72,2,13);
  emit("I2 explore FACT score="); e64(sc); emit("\n");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ2(W,11,72,0,st);
  emit("I2-ANS="); e64(q); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ex:[]u8=z_alloc(8);
  set32(ex,0,70); set32(ex,4,70);
  let t:i32=id_find_adapted_seq(W,ex,2);
  let p1:i32=0; if(q==13){p1=1;}
  let p2:i32=0; if(t>=0 && id_adapt_src(W,t)==mapx && ng(W,t,12)==2){p2=1;}
  let p3:i32=id_has14(W,mapz,t);
  let p5:i32=0; if(sc>=3){p5=1;}
  emit("I2 p1(ans13)="); e64(p1);
  emit(" p2(t16X-kind2)="); e64(p2);
  emit(" p3(z14t)="); e64(p3);
  emit(" p5(score3)="); e64(p5); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p5==1){
    emit("I2-INTEGRATE-TRUNCATE=PASS\n");
  } else {
    emit("I2-INTEGRATE-TRUNCATE=FAIL\n");
  }
  return;
}

// ---- I6 setup shared by I6 and G1 ----
fn i6_setup(W:[]u8,out:[]u8)void {
  let xo:[]u8=z_alloc(8);
  id_train_x(W,xo);
  set32(out,0,get32(xo,0));
  ev_teach(W,12,2,99);
  id_gap(W);
  id_retire_fact(W,11,71);
  let sc:i32=id_explore4(W,11,74,3,99);
  set32(out,4,sc);
  return;
}

// ---- I6: specialize + learner verification + self-wiring ----
fn i6_arm(W:[]u8)void {
  emit("=== I6-INTEGRATE-SPECIALIZE ===\n");
  let out:[]u8=z_alloc(8);
  i6_setup(W,out);
  let mapx:i32=get32(out,0);
  let sc:i32=get32(out,4);
  emit("I6 explore FACT score="); e64(sc); emit("\n");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ2(W,11,74,0,st);
  emit("I6-ANS="); e64(q); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ex:[]u8=z_alloc(8);
  set32(ex,0,70); set32(ex,4,2);
  let xs:i32=id_find_adapted_seq(W,ex,2);
  let p1:i32=0; if(q==99){p1=1;}
  let p2:i32=0; if(xs>=0 && id_adapt_src(W,xs)==mapx && ng(W,xs,12)==3){p2=1;}
  let p3:i32=id_has14(W,mapz,xs);
  let p5:i32=0; if(sc>=3){p5=1;}
  emit("I6 p1(ans99)="); e64(p1);
  emit(" p2(xs16X-kind3)="); e64(p2);
  emit(" p3(z14xs)="); e64(p3);
  emit(" p5(score3)="); e64(p5); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p5==1){
    emit("I6-INTEGRATE-SPECIALIZE=PASS\n");
  } else {
    emit("I6-INTEGRATE-SPECIALIZE=FAIL\n");
  }
  return;
}

// ---- I4: withhold gates adaptation ----
fn i4_arm(W:[]u8)void {
  emit("=== I4-INTEGRATE-WITHHOLD ===\n");
  let out:[]u8=z_alloc(8);
  id_train_x(W,out);
  id_gap(W);
  id_zfacts_xrel(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ2(W,101,79,0,st);
  emit("I4-ANS="); e64(q); emit("\n");
  let p1:i32=0; if(q==-3){p1=1;}
  let p2:i32=0; if(id_count16(W)==0){p2=1;}
  let p3:i32=0; if(id_live_maps(W)==1){p3=1;}
  emit("I4 p1(withhold-3)="); e64(p1);
  emit(" p2(zero16)="); e64(p2);
  emit(" p3(1map)="); e64(p3); emit("\n");
  if(p1==1 && p2==1 && p3==1){
    emit("I4-INTEGRATE-WITHHOLD=PASS\n");
  } else {
    emit("I4-INTEGRATE-WITHHOLD=FAIL\n");
  }
  return;
}

// ---- I3 setup shared by I3, I5, G2, G3 ----
// out[0]=a_id, out[1]=a2_id, out[2]=z1_id, out[3]=n14_before_q2.
fn i3_setup_q1(W:[]u8,out:[]u8)void {
  let xo:[]u8=z_alloc(8);
  id_train_x(W,xo);
  id_gap(W);
  let zo:[]u8=z_alloc(8);
  id_zfacts_i3(W,zo);
  set32(out,8,get32(zo,0));
  let sc:i32=id_explore4(W,101,79,1,108);
  emit("I3 explore FACT score="); e64(sc); emit("\n");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q1:i32=compose_integ2(W,101,79,0,st);
  emit("I3-Q1="); e64(q1); emit("\n");
  set32(out,4,q1);
  let z1:i32=cb_newest_map(W);
  set32(out,12,z1);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,70); set32(ex,4,70); set32(ex,8,70); set32(ex,12,2);
  let a:i32=id_find_adapted_seq(W,ex,4);
  set32(out,0,a);
  return;
}
fn i3_world_change(W:[]u8,f105:i32)void {
  ev_teach(W,104,2,140);
  ns(W,f105,36,0);
  emit("I3-WORLD-CHANGE done\n");
  return;
}

// ---- I3: stale adaptation revised under learner verification ----
fn i3_arm(W:[]u8,out:[]u8)void {
  emit("=== I3-INTEGRATE-STALE-REVISE ===\n");
  let so:[]u8=z_alloc(16);
  i3_setup_q1(W,so);
  let a:i32=get32(so,0);
  let q1:i32=get32(so,4);
  let f105:i32=get32(so,8);
  let z1:i32=get32(so,12);
  set32(out,8,z1);
  let p0:i32=0; if(q1==108 && a>=0){p0=1;}
  i3_world_change(W,f105);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q2:i32=compose_integ2(W,101,79,0,st);
  emit("I3-Q2="); e64(q2); emit("\n");
  let ex:[]u8=z_alloc(16);
  set32(ex,0,70); set32(ex,4,70); set32(ex,8,70); set32(ex,12,2);
  let a2:i32=id_find_adapted_seq(W,ex,4);
  set32(out,0,a); set32(out,4,a2);
  let p1:i32=0; if(q2==-2){p1=1;}
  let p2:i32=0; if(a>=0 && ng(W,a,36)!=1){p2=1;}
  let p3:i32=0; if(a2>=0 && id_adapt_src(W,a2)==a){p3=1;}
  let p4:i32=0; if(a2>=0 && id_count14to(W,a2)==0){p4=1;}
  let p5:i32=0; if(id_fact_score(W,101,79,108)==3){p5=1;}
  emit("I3 p0(q1setup)="); e64(p0);
  emit(" p1(q2-2)="); e64(p1);
  emit(" p2(aretired)="); e64(p2);
  emit(" p3(a216a)="); e64(p3);
  emit(" p4(no14a2)="); e64(p4);
  emit(" p5(stalepred3)="); e64(p5); emit("\n");
  if(p0==1 && p1==1 && p2==1 && p3==1 && p4==1 && p5==1){
    emit("I3-INTEGRATE-STALE-REVISE=PASS\n");
  } else {
    emit("I3-INTEGRATE-STALE-REVISE=FAIL\n");
  }
  return;
}

// ---- I5: recovery diagnostic (continues I3's workspace) ----
fn i5_arm(W:[]u8,a2:i32,z1:i32)void {
  emit("=== I5-INTEGRATE-RECOVERY ===\n");
  if(z1>=0){ns(W,z1,36,0);}
  let cyc:i32=0;
  let okp:i32=0;
  while(cyc<10 && okp==0){
    integ_explore(W,101,79,1,0,0);
    cyc=cyc+1;
    let pp:i32=lv_setup(W,101,79);
    emit("I5 cycle="); e64(cyc);
    emit(" pred="); e64(pp);
    emit(" rel="); e64(hg(W,36)); emit("\n");
    if(pp==140 && hg(W,36)>=3){okp=1;}
  }
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q3:i32=compose_integ2(W,101,79,0,st);
  emit("I5-Q3="); e64(q3); emit("\n");
  let z2:i32=cb_newest_map(W);
  let p1:i32=0; if(okp==1){p1=1;}
  let p2:i32=0; if(q3==140){p2=1;}
  let p3:i32=0; if(a2>=0 && id_has14(W,z2,a2)==1){p3=1;}
  emit("I5 p1(conv10)="); e64(p1);
  emit(" p2(q3140)="); e64(p2);
  emit(" p3(z214a2)="); e64(p3);
  emit(" cycles="); e64(cyc); emit("\n");
  if(p1==1 && p2==1 && p3==1){
    emit("I5-INTEGRATE-RECOVERY=PASS\n");
  } else {
    emit("I5-INTEGRATE-RECOVERY=FAIL\n");
  }
  return;
}

// ---- G1: guard regression, self-referential substitution ----
fn g1_arm(W:[]u8)void {
  emit("=== G1-GUARD-NO-SELFREF ===\n");
  let out:[]u8=z_alloc(8);
  i6_setup(W,out);
  let mapx:i32=get32(out,0);
  let sc:i32=get32(out,4);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q:i32=compose_integ2(W,11,74,0,st);
  emit("G1-ANS="); e64(q); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ex:[]u8=z_alloc(8);
  set32(ex,0,70); set32(ex,4,2);
  let xs:i32=id_find_adapted_seq(W,ex,2);
  // self-referential relseq probes: [71] and [74].
  let e71:[]u8=z_alloc(4); set32(e71,0,71);
  let e74:[]u8=z_alloc(4); set32(e74,0,74);
  let n71:i32=id_count_relseq(W,e71,1);
  let n74:i32=id_count_relseq(W,e74,1);
  // the guard must have had something to block: the prediction
  // FACT is learner-originated.
  let lf:i32=id_find_fact(W,11,74,99);
  let lforig:i32=0;
  if(lf>=0 && ng(W,lf,12)==1){lforig=1;}
  let g1:i32=0; if(q==99){g1=1;}
  let g2:i32=0; if(sc>=3){g2=1;}
  let g3:i32=0; if(n71==0 && n74==0){g3=1;}
  let g4:i32=0; if(xs>=0 && id_adapt_src(W,xs)==mapx && ng(W,xs,12)==3 && id_has14(W,mapz,xs)==1){g4=1;}
  let g5:i32=lforig;
  emit("G1 g1(ans99)="); e64(g1);
  emit(" g2(conv3)="); e64(g2);
  emit(" g3(zeroselfref)="); e64(g3);
  emit(" g4(worldlic-ok)="); e64(g4);
  emit(" g5(trig-present)="); e64(g5);
  emit(" n71="); e64(n71); emit(" n74="); e64(n74); emit("\n");
  if(g1==1 && g2==1 && g3==1 && g4==1 && g5==1){
    emit("G1-GUARD-NO-SELFREF=PASS\n");
  } else {
    emit("G1-GUARD-NO-SELFREF=FAIL\n");
  }
  return;
}

// ---- G2: guard regression, circular self-verification ----
fn g2_arm(W:[]u8,out:[]u8)void {
  emit("=== G2-GUARD-NO-CIRCULAR ===\n");
  let so:[]u8=z_alloc(16);
  i3_setup_q1(W,so);
  let a:i32=get32(so,0);
  let q1:i32=get32(so,4);
  let f105:i32=get32(so,8);
  let z1:i32=get32(so,12);
  set32(out,8,z1);
  let n14b:i32=id_count14_total(W);
  i3_world_change(W,f105);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q2:i32=compose_integ2(W,101,79,0,st);
  emit("G2-Q2="); e64(q2); emit("\n");
  let n14a:i32=id_count14_total(W);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,70); set32(ex,4,70); set32(ex,8,70); set32(ex,12,2);
  let a2:i32=id_find_adapted_seq(W,ex,4);
  set32(out,0,a); set32(out,4,a2);
  let g1:i32=0; if(q1==108){g1=1;}
  let g2:i32=0; if(q2==-2){g2=1;}
  let g3:i32=0; if(a>=0 && ng(W,a,36)!=1){g3=1;}
  let g4:i32=0; if(a2>=0 && id_adapt_src(W,a2)==a){g4=1;}
  let g5:i32=0; if(n14a==n14b && a2>=0 && id_count14to(W,a2)==0){g5=1;}
  let g6:i32=0; if(id_fact_score(W,101,79,108)==3){g6=1;}
  emit("G2 g1(q1108)="); e64(g1);
  emit(" g2(q2-2)="); e64(g2);
  emit(" g3(aretired)="); e64(g3);
  emit(" g4(a216a)="); e64(g4);
  emit(" g5(nopromote)="); e64(g5);
  emit(" g6(stalepred3)="); e64(g6);
  emit(" n14b="); e64(n14b); emit(" n14a="); e64(n14a); emit("\n");
  if(g1==1 && g2==1 && g3==1 && g4==1 && g5==1 && g6==1){
    emit("G2-GUARD-NO-CIRCULAR=PASS\n");
  } else {
    emit("G2-GUARD-NO-CIRCULAR=FAIL\n");
  }
  return;
}

// ---- G3: guard regression, recovery convergence (continues G2) ----
fn g3_arm(W:[]u8,a2:i32,z1:i32)void {
  emit("=== G3-GUARD-RECOVERY ===\n");
  if(z1>=0){ns(W,z1,36,0);}
  let cyc:i32=0;
  let okp:i32=0;
  while(cyc<10 && okp==0){
    integ_explore(W,101,79,1,0,0);
    cyc=cyc+1;
    let pp:i32=lv_setup(W,101,79);
    emit("G3 cycle="); e64(cyc);
    emit(" pred="); e64(pp);
    emit(" rel="); e64(hg(W,36)); emit("\n");
    if(pp==140 && hg(W,36)>=3){okp=1;}
  }
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let q3:i32=compose_integ2(W,101,79,0,st);
  emit("G3-Q3="); e64(q3); emit("\n");
  let z2:i32=cb_newest_map(W);
  let g1:i32=0; if(okp==1){g1=1;}
  let g2:i32=0; if(q3==140){g2=1;}
  let g3:i32=0; if(a2>=0 && id_has14(W,z2,a2)==1){g3=1;}
  emit("G3 g1(conv10)="); e64(g1);
  emit(" g2(q3140)="); e64(g2);
  emit(" g3(z214a2)="); e64(g3);
  emit(" cycles="); e64(cyc); emit("\n");
  if(g1==1 && g2==1 && g3==1){
    emit("G3-GUARD-RECOVERY=PASS\n");
  } else {
    emit("G3-GUARD-RECOVERY=FAIL\n");
  }
  return;
}

// ---- S1: stale-routing unit diagnostic ----
fn s1_arm(W:[]u8)void {
  emit("=== S1-STALE-ROUTING-UNIT ===\n");
  let xo:[]u8=z_alloc(8);
  id_train_x(W,xo);
  id_gap(W);
  let zo:[]u8=z_alloc(8);
  id_zfacts_i3(W,zo);
  let f108:i32=get32(zo,0);
  let ne:i32=adapt_extend(W,101,0);
  integ_tag_extend(W);
  emit("S1 extend created="); e64(ne); emit("\n");
  let ex:[]u8=z_alloc(16);
  set32(ex,0,70); set32(ex,4,70); set32(ex,8,70); set32(ex,12,2);
  let a:i32=id_find_adapted_seq(W,ex,4);
  // supersede (not kill) the licensing fact: it stays live.
  ev_teach(W,104,2,140);
  link_edge(W,f108,3,f108,0);
  emit("S1 superseded f108="); e64(f108); emit("\n");
  let s1:i32=0;
  let pv:i32=t2_exec(W,ng(W,a,20),101);
  if(pv==-999999){s1=1;}
  emit("S1 probe-exec="); e64(pv); emit("\n");
  let s2:i32=0;
  let rv0:i32=adapt_revise2(W,101,0);
  if(rv0==0 && a>=0 && ng(W,a,36)==1){s2=1;}
  emit("S1 frozen-revise="); e64(rv0); emit("\n");
  let s3:i32=0;
  let rv2:i32=integ2_revise(W,101,0);
  let a2:i32=id_find_adapted_seq(W,ex,4);
  if(rv2>=1 && a2>=0 && id_adapt_src(W,a2)==a && ng(W,a,36)!=1){s3=1;}
  emit("S1 routed-revise="); e64(rv2);
  emit(" a2="); e64(a2); emit("\n");
  emit("S1 s1(veto)="); e64(s1);
  emit(" s2(frozen-blind)="); e64(s2);
  emit(" s3(routed-revises)="); e64(s3); emit("\n");
  if(s1==1 && s2==1 && s3==1){
    emit("S1-STALE-ROUTING-UNIT=PASS\n");
  } else {
    emit("S1-STALE-ROUTING-UNIT=FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("INTEG2-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); i1_arm(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); i2_arm(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); i6_arm(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); i4_arm(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5);
  let io:[]u8=z_alloc(12); i3_arm(W5,io);
  i5_arm(W5,get32(io,4),get32(io,8));
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); g1_arm(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7);
  let go:[]u8=z_alloc(12); g2_arm(W7,go);
  g3_arm(W7,get32(go,4),get32(go,8));
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); s1_arm(W8);
  emit("INTEG2-END\n");
  return 0;
}

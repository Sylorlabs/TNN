// integ2_patch.zag -- H-COMPINTEG-2 stale-sentinel routing layer.
//
// Routes INTEG-EXEC-STALE (-999999, produced by GUARD-T3's
// licensing-liveness veto in t2_exec) into the adapt/revise path.
//
// adapt_revise2's staleness predicate is satisfiability-only
// (cc_relseq / cc_satisfy) and does not check supersession, so a
// trial whose licensing fact is superseded-but-live executes stale
// (the veto fires) while the frozen predicate judges it intact.
// This layer ORs an execution probe into the revise decision:
// t2_exec on the trial chain returning INTEG-EXEC-STALE counts as
// stale. The sentinel is interpreted at the decision point; no
// mark bit, no new field, no registry is recorded.
//
// compose_integ2 is compose_integ (integ_patch.zag, frozen) with
// exactly one call swapped: the bracket runs integ2_revise
// instead of adapt_revise2.
//
// Caps (preregistered): this file <= 150 lines; 0 new edge/MAP
// types, opcodes, modes, bridges, handlers, semantic cases, fact
// fields, or header slots. All operators reused from frozen
// sources. Output via emit/e64 only.

// Per-MAP revision check with the routed sentinel. Returns the
// number of revised MAPs promoted for this MAP (0 or more).
// Stale ids are appended to ret (count in rn[0]); the caller
// retires them after the scan (slot-safety, see integ2_revise).
fn integ2_revise_one(W:[]u8,a:i32,s:i32,masked:i32,ret:[]u8,rn:[]u8)i32 {
  let src:i32=rev_src(W,a);
  if(src<2){return 0;}
  if(ng(W,src,36)!=1){return 0;}
  let sq:[]u8=z_alloc(28);
  let vb:[]u8=z_alloc(36);
  let fb:[]u8=z_alloc(32);
  let lsrc:i32=cc_relseq(W,src,sq,7);
  let ls:i32=cc_satisfy(W,src,s,vb,fb);
  if(lsrc<1){return 0;}
  if(ls!=lsrc){return 0;}
  let lalen:i32=cc_relseq(W,a,sq,7);
  let la:i32=cc_satisfy(W,a,s,vb,fb);
  let satstale:i32=1;
  if(la>=1 && la==lalen){satstale=0;}
  // ROUTING: probe the trial chain through t2_exec.
  // INTEG-EXEC-STALE means GUARD-T3 vetoed on dead or superseded
  // licensing: the trial is stale even when the satisfiability
  // predicate is blind to it.
  let execstale:i32=0;
  let pv:i32=t2_exec(W,ng(W,a,20),s);
  if(pv==-999999){execstale=1;}
  if(satstale==0 && execstale==0){return 0;}
  let kd:i32=ts_kind(W,src,a);
  emit("INTEG2-STALE a="); e64(a);
  emit(" src="); e64(src);
  emit(" kind="); e64(kd);
  emit(" satstale="); e64(satstale);
  emit(" execstale="); e64(execstale); emit("\n");
  // Mask a's node type during dispatch. The frozen duplicate
  // checks (adapt_relseq_absent, ts_relseq_present) scan live
  // type-20 MAPs: the about-to-be-retired trial must read as
  // absent, or no revision is built in the superseded-readable
  // case. Retiring first is not an option: alloc_node recycles
  // dead slots (the frozen adapt_revise documents this), so the
  // new trial's own chain cells would reuse a's id. The mask
  // keeps the slot occupied; field 0 is restored afterwards.
  // (cc_relseq walks from ng(W,m,20) and never reads the MAP's
  // own field 0, so ts_specialize_src's length limit is safe.)
  let atype:i32=ng(W,a,0);
  ns(W,a,0,0);
  let nk:i32=0;
  if(kd==1){nk=rev_extend_src(W,src,s,masked,a);}
  else {
    if(kd==2){nk=ts_truncate_src(W,src,s,masked,a);}
    else {nk=ts_specialize_src(W,src,s,masked,a);}
  }
  ns(W,a,0,atype);
  let c:i32=get32(rn,0);
  if(c<64){set32(ret,c*4,a); set32(rn,0,c+1);}
  return nk;
}

// adapt_revise2's scan loop with the routed sentinel in the
// staleness predicate. Returns total revised MAPs promoted.
// Retirements are deferred past the scan: the per-MAP execution
// probe allocates frame nodes via alloc_node, which would
// otherwise recycle a freshly retired trial's slot mid-scan.
fn integ2_revise(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let ret:[]u8=z_alloc(256);
  let rn:[]u8=z_alloc(4);
  set32(rn,0,0);
  let a:i32=2;
  while(a<1024){
    if(rev_is_adapted(W,a)==1){nmk=nmk+integ2_revise_one(W,a,s,masked,ret,rn);}
    a=a+1;
  }
  let i:i32=0;
  let c:i32=get32(rn,0);
  while(i<c){
    ns(W,get32(ret,i*4),36,0);
    i=i+1;
  }
  return nmk;
}

// The integrated learner operation with stale routing. Verbatim
// compose_integ except the adapt bracket calls integ2_revise.
// Takes NO researcher-provided answer. Returns ans (>=0),
// -2 clean reject, -3 withheld.
fn compose_integ2(W:[]u8,s:i32,r:i32,masked:i32,st:[]u8)i32 {
  let p:i32=lv_setup(W,s,r);
  if(p==-999999){
    emit("INTEG2-WITHHOLD nobasis\n");
    return -3;
  }
  if(hg(W,36)<lv_rel_thresh()){
    emit("INTEG2-WITHHOLD unreliable rel="); e64(hg(W,36)); emit("\n");
    return -3;
  }
  emit("INTEG2-PRED p="); e64(p);
  emit(" rel="); e64(hg(W,36)); emit("\n");
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224);
  let olen:[]u8=z_alloc(32);
  let nseg:i32=lv_dfs(W,s,p,oseg,ovals,ofids,olen);
  if(nseg<1){
    emit("INTEG2-ADAPT-TRY\n");
    let nmk:i32=integ2_revise(W,s,masked);
    if(nmk==0){
      nmk=adapt_extend(W,s,masked)+adapt_truncate(W,s,masked)+adapt_specialize(W,s,masked);
    }
    integ_tag_extend(W);
    emit("INTEG2-ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      nseg=lv_dfs(W,s,p,oseg,ovals,ofids,olen);
    }
  } else {
    emit("INTEG2-NATIVE-SEGS n="); e64(nseg); emit("\n");
  }
  if(nseg<1){
    emit("INTEG2-COMP-FAIL\n");
    return -2;
  }
  return integ_assemble(W,s,r,nseg,oseg,ovals,ofids,olen,st);
}

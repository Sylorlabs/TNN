// hard_driver.zag -- rebinding hardening driver (scale/deception).
// Four hardening worlds per Micah Priority 3. Each world uses its own
// workspace for independence. Metrics: answer correctness, verification
// attempts (tried/rejected), graceful fallback vs crash vs false accept,
// wall-clock feasibility at scale.
fn hard_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
// Helper: directly build and promote a chain MAP of given plen.
// Teaches a linear chain starting at subject s0, assembles, promotes.
// Returns the MAP node id.
fn hard_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
// ---- H1: Scale 45 (redesigned from 100: 100-MAP construction hits
// workspace allocation limits; 45 still 2.25x W3's 20) ----
// A: 40 plen-3 decoy MAPs (wrong plen, skipped by filter) + 4 plen-5
// decoy MAPs (right plen, first wins) + 1 plen-5 correct MAP.
// B: plen-5 chain query. Measures: completion, verifies, wall time.
// NOTE: B facts are taught FIRST (empty workspace, fast), then A MAPs
// are promoted. This avoids teach-in-full-workspace stall.
fn world_h1()void {
  emit("H1-SCALE45-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // B facts first (empty workspace).
  ev_teach(W,6101,1,6111); ev_teach(W,6111,1,6112);
  ev_teach(W,6112,1,6113); ev_teach(W,6113,1,6114);
  ev_teach(W,6101,1,6201); ev_teach(W,6201,1,6202);
  emit("H1 B facts taught\n");
  // 40 plen-3 decoys (subjects 2000..2390 step 10).
  let i:i32=0;
  while(i<40){
    let s0:i32=2000+i*10;
    let pm:i32=hard_mkchain(W,s0,3,51,s0+2);
    if(pm<0){ emit("H1 decoy3 FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("H1 40 plen-3 decoys promoted\n");
  // 4 plen-5 decoys (subjects 4000..4030 step 10). Right plen, but
  // their A-facts are unrelated to B; rebounds will be rejected.
  i=0;
  while(i<4){
    let s0:i32=4000+i*10;
    let pm:i32=hard_mkchain(W,s0,5,51,s0+4);
    if(pm<0){ emit("H1 decoy5 FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("H1 4 plen-5 decoys promoted\n");
  // 1 plen-5 correct MAP (subject 5000). Promoted last (highest id).
  let pmc:i32=hard_mkchain(W,5000,5,50,5004);
  emit("H1 correct plen-5 MAP="); e64(pmc); emit("\n");
  // B query (facts already taught).
  let b:i32=ev_query(W,6101,50,6114,0);
  emit("H1 B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H1 B-CHAIN expect=6114 ok="); e64(b==6114); emit("\n");
  emit("H1-SCALE45-END\n");
  return;
}
// H1 control: fresh learner, same B, no A phase.
fn world_h1c()void {
  emit("H1C-CONTROL-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,6101,1,6111); ev_teach(W,6111,1,6112);
  ev_teach(W,6112,1,6113); ev_teach(W,6113,1,6114);
  ev_teach(W,6101,1,6201); ev_teach(W,6201,1,6202);
  let b:i32=ev_query(W,6101,50,6114,0);
  emit("H1C B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H1C B-CHAIN expect=6114 ok="); e64(b==6114); emit("\n");
  emit("H1C-CONTROL-END\n");
  return;
}
// ---- H2: Deceptive similar ----
// A: 5 plen-5 MAPs from different A contexts (identical shape, different
// provenance). B: two plen-5 paths, one correct (expected 7114), one
// wrong endpoint (7214). All 5 MAPs try; verification must select the
// correct path. Tests false accepts with multiple identical-shape MAPs.
fn world_h2()void {
  emit("H2-DECEPTIVE-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<5){
    let s0:i32=7000+i*100;
    let pm:i32=hard_mkchain(W,s0,5,51,s0+4);
    if(pm<0){ emit("H2 MAP FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("H2 5 plen-5 MAPs promoted\n");
  // B: correct path (7101->7111->7112->7113->7114) and wrong path
  // (7101->7211->7212->7213->7214). Expected 7114.
  ev_teach(W,7101,1,7111); ev_teach(W,7111,1,7112);
  ev_teach(W,7112,1,7113); ev_teach(W,7113,1,7114);
  ev_teach(W,7101,1,7211); ev_teach(W,7211,1,7212);
  ev_teach(W,7212,1,7213); ev_teach(W,7213,1,7214);
  let b:i32=ev_query(W,7101,50,7114,0);
  emit("H2 B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H2 B-CHAIN expect=7114 ok="); e64(b==7114); emit("\n");
  emit("H2-DECEPTIVE-END\n");
  return;
}
// ---- H3: Partial applicability ----
// A: plen-4 MAP. B: needs plen-5. Mechanism is all-or-nothing on plen;
// expect the MAP to be skipped (no matching paths) and fallback to
// trial. Measures treatment vs fresh control cost.
fn world_h3()void {
  emit("H3-PARTIAL-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let pm:i32=hard_mkchain(W,8000,4,50,8003);
  emit("H3 plen-4 MAP="); e64(pm); emit("\n");
  // B: plen-5 chain (expects 8114).
  ev_teach(W,8101,1,8111); ev_teach(W,8111,1,8112);
  ev_teach(W,8112,1,8113); ev_teach(W,8113,1,8114);
  let b:i32=ev_query(W,8101,50,8114,0);
  emit("H3 B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H3 B-CHAIN expect=8114 ok="); e64(b==8114); emit("\n");
  emit("H3-PARTIAL-END\n");
  return;
}

// ---- H4: Adaptation (extend/truncate) ----
// A: plen-4 MAP and plen-6 MAP. B: needs plen-5. Tests whether the
// mechanism can extend or truncate (expect: no, all-or-nothing).
fn world_h4()void {
  emit("H4-ADAPT-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let pm4:i32=hard_mkchain(W,9000,4,50,9003);
  let pm6:i32=hard_mkchain(W,9100,6,50,9105);
  emit("H4 plen-4 MAP="); e64(pm4); emit(" plen-6 MAP="); e64(pm6); emit("\n");
  // B: plen-5 chain (expects 9114).
  ev_teach(W,9101,1,9111); ev_teach(W,9111,1,9112);
  ev_teach(W,9112,1,9113); ev_teach(W,9113,1,9114);
  let b:i32=ev_query(W,9101,50,9114,0);
  emit("H4 B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H4 B-CHAIN expect=9114 ok="); e64(b==9114); emit("\n");
  emit("H4-ADAPT-END\n");
  return;
}
fn world_h4c()void {
  emit("H4C-CONTROL-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9101,1,9111); ev_teach(W,9111,1,9112);
  ev_teach(W,9112,1,9113); ev_teach(W,9113,1,9114);
  let b:i32=ev_query(W,9101,50,9114,0);
  emit("H4C B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H4C B-CHAIN expect=9114 ok="); e64(b==9114); emit("\n");
  emit("H4C-CONTROL-END\n");
  return;
}
fn main()i32 {
  emit("REBIND-HARDENING-START\n");
  world_h1small();
  world_h1smallc();
  world_h2();
  world_h3();
  world_h3c();
  world_h4();
  world_h4c();
  emit("REBIND-HARDENING-END\n");
  return 0;
}
// ---- H1-small: Scale 15 (feasible; 100-MAP construction hits workspace
// allocation limits as documented) ----
// A: 10 plen-3 decoys + 4 plen-5 decoys + 1 correct.
// B facts taught first to avoid teach-in-full-workspace stall.
fn world_h1small()void {
  emit("H1S-SCALE15-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,6101,1,6111); ev_teach(W,6111,1,6112);
  ev_teach(W,6112,1,6113); ev_teach(W,6113,1,6114);
  ev_teach(W,6101,1,6201); ev_teach(W,6201,1,6202);
  emit("H1S B facts taught\n");
  let i:i32=0;
  while(i<10){
    let s0:i32=2000+i*10;
    let pm:i32=hard_mkchain(W,s0,3,51,s0+2);
    if(pm<0){ emit("H1S decoy3 FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("H1S 10 plen-3 decoys promoted\n");
  i=0;
  while(i<4){
    let s0:i32=4000+i*10;
    let pm:i32=hard_mkchain(W,s0,5,51,s0+4);
    if(pm<0){ emit("H1S decoy5 FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("H1S 4 plen-5 decoys promoted\n");
  let pmc:i32=hard_mkchain(W,5000,5,50,5004);
  emit("H1S correct plen-5 MAP="); e64(pmc); emit("\n");
  let b:i32=ev_query(W,6101,50,6114,0);
  emit("H1S B-CHAIN ans="); e64(b); hard_tstat(W);
  emit("H1S B-CHAIN expect=6114 ok="); e64(b==6114); emit("\n");
  emit("H1S-SCALE15-END\n");
  return;
}

// econ.zag -- Invention economics (Program 6). Pure Zag.
// Prereg 2557d3106 frozen before this file.
// E1: macro (persisted selected intervention) economics over worlds W_k.
// E2: offset-form retention economics over families A..F.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else{emit("OZ");}
  return;
}
fn emit_seq(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}

// ============ E1: worlds W_k, H0=[(X,Z,k),(Z,Y,0)], H1=[(X,Y,k-1)] ============
fn e1_n_rules(h:i32)i32 {
  if(h==0){return 2;}
  return 1;
}
fn e1_get_rule(k:i32,h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(h==0){
    if(r==0){src=0;dst=1;delay=k;}
    else{src=1;dst=2;delay=0;}
  } else {
    src=0;dst=2;delay=k-1;
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}
fn e1_step(k:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=e1_n_rules(h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        e1_get_rule(k,h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
fn e1_sim(k:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=e1_step(k,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
fn powint(b:i32,d:i32)i32 {
  let t:i32=1;
  let k:i32=0;
  while(k<d){t=t*b;k=k+1;}
  return t;
}
fn build_digits(si:i32,s:i32,base:i32,dig:[]u8)void {
  let div:i32=1;
  let p:i32=0;
  while(p<s-1){div=div*base;p=p+1;}
  let rem:i32=si;
  let i:i32=0;
  while(i<s){
    dig[i]=(rem/div) as u8;
    rem=rem%div;
    if(div>1){div=div/base;}
    i=i+1;
  }
  return;
}
fn e1_construct4(k:i32,oseq:[]u8,olen:[]u8,ochecks:[]u8)i32 {
  let checks:i32=0;
  let s:i32=1;
  while(s<=6){
    let total:i32=powint(4,s);
    let si:i32=0;
    while(si<total){
      let dig:[]u8=z_alloc(6);
      build_digits(si,s,4,dig);
      if(has_observe(dig,s)==1){
        checks=checks+1;
        let q0:i32=e1_sim(k,0,dig,s);
        let q1:i32=e1_sim(k,1,dig,s);
        if(q0!=q1){
          let c:i32=0;
          while(c<s){oseq[c]=dig[c];c=c+1;}
          set32(olen,0,s);
          set32(ochecks,0,checks);
          return 1;
        }
      }
      si=si+1;
    }
    s=s+1;
  }
  set32(ochecks,0,checks);
  return 0;
}
fn e1_construct5(k:i32,macro:[]u8,mlen:i32,oseq:[]u8,olen:[]u8,ochecks:[]u8)i32 {
  let checks:i32=0;
  let s:i32=1;
  while(s<=6){
    let total:i32=powint(5,s);
    let si:i32=0;
    while(si<total){
      let dig:[]u8=z_alloc(6);
      build_digits(si,s,5,dig);
      let exp:[]u8=z_alloc(24);
      let el:i32=0;
      let i:i32=0;
      while(i<s){
        let d:i32=dig[i] as i32;
        if(d<4){exp[el]=dig[i];el=el+1;}
        else{
          let j:i32=0;
          while(j<mlen){exp[el]=macro[j];el=el+1;j=j+1;}
        }
        i=i+1;
      }
      if(has_observe(exp,el)==1){
        checks=checks+1;
        let q0:i32=e1_sim(k,0,exp,el);
        let q1:i32=e1_sim(k,1,exp,el);
        if(q0!=q1){
          let c:i32=0;
          while(c<el){oseq[c]=exp[c];c=c+1;}
          set32(olen,0,el);
          set32(ochecks,0,checks);
          return 1;
        }
      }
      si=si+1;
    }
    s=s+1;
  }
  set32(ochecks,0,checks);
  return 0;
}
fn e1_worldexec(k:i32,th:i32,seq:[]u8,len:i32,cnt:[]u8)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=e1_step(k,th,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  set32(cnt,0,get32(cnt,0)+1);
  return last;
}
fn e1_eliminate(k:i32,real_obs:i32,seq:[]u8,len:i32)i32 {
  let mask:i32=0;
  let h:i32=0;
  while(h<2){
    let q:i32=e1_sim(k,h,seq,len);
    if(q==real_obs){
      if(h==0){mask=mask|1;}else{mask=mask|2;}
    }
    h=h+1;
  }
  return mask;
}
fn e1_verify(k:i32,seq:[]u8,len:i32)i32 {
  let q0:i32=e1_sim(k,0,seq,len);
  let q1:i32=e1_sim(k,1,seq,len);
  if(q0==q1){return 0;}
  let th:i32=0;
  while(th<2){
    let cnt:[]u8=z_alloc(4);
    let real:i32=e1_worldexec(k,th,seq,len,cnt);
    let mask:i32=e1_eliminate(k,real,seq,len);
    let want:i32=1;
    if(th==1){want=2;}
    if(mask!=want){return 0;}
    if(get32(cnt,0)!=1){return 0;}
    th=th+1;
  }
  return 1;
}

// ============ E2: offset-form retention ============
fn e2_predict(mx:[]u8,mcnt:i32,x:i32,offset_hyp:i32,trusted:i32)i32 {
  if(trusted==1){return x+offset_hyp;}
  if(mcnt==0){return x;}
  let bi:i32=0;
  let bd:i32=get32(mx,0)-x;
  if(bd<0){bd=0-bd;}
  let i:i32=1;
  while(i<mcnt){
    let d:i32=get32(mx,i*4)-x;
    if(d<0){d=0-d;}
    if(d<bd){bd=d;bi=i;}
    i=i+1;
  }
  return get32(mx,(128+bi)*4);
}
fn e2_run(mx:[]u8,mcntb:[]u8,st:[]u8,px:[]u8,py:[]u8,np:i32,form_known_in:i32)i32 {
  let mcnt:i32=get32(mcntb,0);
  let offset_hyp:i32=get32(st,0);
  let trusted:i32=get32(st,4);
  let form_known:i32=form_known_in;
  let last_d:i32=0;
  let run:i32=0;
  let consec:i32=0;
  let used:i32=0;
  let ex:i32=0;
  while(ex<np){
    let x:i32=get32(px,ex*4);
    let y:i32=get32(py,ex*4);
    let pred:i32=e2_predict(mx,mcnt,x,offset_hyp,trusted);
    used=used+1;
    if(pred==y){consec=consec+1;}else{consec=0;}
    if(consec>=8){ex=np;}
    else{
      set32(mx,mcnt*4,x);
      set32(mx,(128+mcnt)*4,y);
      mcnt=mcnt+1;
      let d:i32=y-x;
      if(trusted==1 && d!=offset_hyp){
        trusted=0;run=1;last_d=d;
      } else if(trusted==0){
        if(d==last_d){run=run+1;}else{run=1;last_d=d;}
        let fit_ok:i32=form_known;
        if(fit_ok==0 && used>=5){fit_ok=1;}
        if(fit_ok==1 && run>=2){
          offset_hyp=last_d;trusted=1;form_known=1;
        }
      } else {
        if(d==last_d){run=run+1;}else{run=1;last_d=d;}
      }
      ex=ex+1;
    }
  }
  set32(mcntb,0,mcnt);
  set32(st,0,offset_hyp);set32(st,4,trusted);set32(st,8,form_known);
  return used;
}
fn build_offset_fam(px:[]u8,py:[]u8,x0:i32,k:i32,n:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=x0+i;
    set32(px,i*4,x);
    set32(py,i*4,x+k);
    i=i+1;
  }
  return;
}
fn build_F(px:[]u8,py:[]u8)void {
  let i:i32=0;
  while(i<16){
    let x:i32=101+(i%8);
    set32(px,i*4,x);
    set32(py,i*4,3*x);
    i=i+1;
  }
  return;
}
fn e2_fresh(px:[]u8,py:[]u8,np:i32)i32 {
  let mx:[]u8=z_alloc(1024);
  let mcntb:[]u8=z_alloc(4);
  let st:[]u8=z_alloc(12);
  set32(st,0,-1);set32(st,4,0);set32(st,8,0);
  return e2_run(mx,mcntb,st,px,py,np,0);
}

fn main()i32 {
  emit("ECON-START\n");
  // ---------- E1 ----------
  let e1ok:i32=1;
  let macro:[]u8=z_alloc(8);
  let mlen:i32=0;
  let net:i32=0;
  let k:i32=1;
  while(k<=5){
    let sseq:[]u8=z_alloc(24);
    let slen:[]u8=z_alloc(4);
    let sch:[]u8=z_alloc(4);
    let fs:i32=e1_construct4(k,sseq,slen,sch);
    if(fs!=1){e1ok=0;}
    if(e1_verify(k,sseq,get32(slen,0))!=1){e1ok=0;}
    let schecks:i32=get32(sch,0);
    emit("E1W k=");e64(k);
    emit(" sc_checks=");e64(schecks);
    emit(" sc_len=");e64(get32(slen,0));
    emit(" sc_seq=");emit_seq(sseq,get32(slen,0));
    if(k==1){
      let c:i32=0;
      while(c<get32(slen,0)){macro[c]=sseq[c];c=c+1;}
      mlen=get32(slen,0);
      emit(" mc_checks=NA mc_len=NA");
    } else {
      let mseq:[]u8=z_alloc(24);
      let mlenb:[]u8=z_alloc(4);
      let mch:[]u8=z_alloc(4);
      let fm:i32=e1_construct5(k,macro,mlen,mseq,mlenb,mch);
      if(fm!=1){e1ok=0;}
      if(e1_verify(k,mseq,get32(mlenb,0))!=1){e1ok=0;}
      let mchecks:i32=get32(mch,0);
      net=net+(schecks-mchecks);
      emit(" mc_checks=");e64(mchecks);
      emit(" mc_len=");e64(get32(mlenb,0));
      emit(" mc_seq=");emit_seq(mseq,get32(mlenb,0));
    }
    emit("\n");
    k=k+1;
  }
  emit("E1NET ");e64(net);emit("\n");
  emit("E1STORAGE 3\n");
  emit("E1OK ");e64(e1ok);emit("\n");
  // ---------- E2 ----------
  let e2ok:i32=1;
  let mx:[]u8=z_alloc(1024);
  let mcntb:[]u8=z_alloc(4);
  let st:[]u8=z_alloc(12);
  set32(st,0,-1);set32(st,4,0);set32(st,8,0);
  let px:[]u8=z_alloc(80);
  let py:[]u8=z_alloc(80);
  build_offset_fam(px,py,1,3,20);
  let a_ret:i32=e2_run(mx,mcntb,st,px,py,20,0);
  build_offset_fam(px,py,21,7,20);
  let b_ret:i32=e2_run(mx,mcntb,st,px,py,20,get32(st,8));
  build_offset_fam(px,py,41,12,20);
  let c_ret:i32=e2_run(mx,mcntb,st,px,py,20,get32(st,8));
  build_offset_fam(px,py,61,1,20);
  let d_ret:i32=e2_run(mx,mcntb,st,px,py,20,get32(st,8));
  build_offset_fam(px,py,81,20,20);
  let e_ret:i32=e2_run(mx,mcntb,st,px,py,20,get32(st,8));
  build_F(px,py);
  let f_ret:i32=e2_run(mx,mcntb,st,px,py,16,get32(st,8));
  build_offset_fam(px,py,1,3,20);
  let a_fr:i32=e2_fresh(px,py,20);
  build_offset_fam(px,py,21,7,20);
  let b_fr:i32=e2_fresh(px,py,20);
  build_offset_fam(px,py,41,12,20);
  let c_fr:i32=e2_fresh(px,py,20);
  build_offset_fam(px,py,61,1,20);
  let d_fr:i32=e2_fresh(px,py,20);
  build_offset_fam(px,py,81,20,20);
  let e_fr:i32=e2_fresh(px,py,20);
  build_F(px,py);
  let f_fr:i32=e2_fresh(px,py,16);
  if(a_ret!=13||a_fr!=13||b_ret!=10||b_fr!=13){e2ok=0;}
  emit("E2 A_ret=");e64(a_ret);emit(" A_fresh=");e64(a_fr);emit("\n");
  emit("E2 B_ret=");e64(b_ret);emit(" B_fresh=");e64(b_fr);emit("\n");
  emit("E2 C_ret=");e64(c_ret);emit(" C_fresh=");e64(c_fr);emit("\n");
  emit("E2 D_ret=");e64(d_ret);emit(" D_fresh=");e64(d_fr);emit("\n");
  emit("E2 E_ret=");e64(e_ret);emit(" E_fresh=");e64(e_fr);emit("\n");
  emit("E2 F_ret=");e64(f_ret);emit(" F_fresh=");e64(f_fr);emit("\n");
  let saving:i32=(b_fr-b_ret)+(c_fr-c_ret)+(d_fr-d_ret)+(e_fr-e_ret);
  let misfit:i32=f_ret-f_fr;
  let create:i32=a_ret-a_fr;
  emit("E2SUM saving=");e64(saving);
  emit(" misfit=");e64(misfit);
  emit(" create_extra=");e64(create);emit("\n");
  emit("E2STORAGE 12\n");
  let den:i32=saving+misfit*4;
  let ps:i32=-1;
  if(den>0){ps=100*misfit*4/den;}
  emit("E2PSTAR ");e64(ps);emit("\n");
  emit("E2K4 ");e64(e2ok);emit("\n");
  emit("ECON-END\n");
  return 0;
}

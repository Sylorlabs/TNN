// ap_driver_xio.zag -- sum-then-plan world for the XIO control.
//
// X = SUM (arithmetic, node -> number, oty 1): r=71 facts, query r=91.
// Y = PLAN (action sequences, number -> node, oty 0): r=82 facts,
// query r=92.
// Z = plan(sum(s)): query (103,93) -> 203. Requires sum(103)=15 (a
// COMPUTED number), then re-subjecting the plan stage to 15.
// Arms: TREAT (xon=1), ABL-XIO (xon=0), ABL-X (sum MAPs deleted),
// ABL-Y (plan MAPs deleted), FRESH.
// Assembly: ../composition_A/cx_core.zag + ../xio_adapters/xio_core.zag
// + this driver, both bases verbatim.

fn apx_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn apx_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, structural class.
fn apx_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(o==1){emit("arith");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn apx_census(W:[]u8)void {
  emit("maps="); e64(apx_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){apx_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, typed signature, relations, answer.
fn apx_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn apx_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
// Driver scaffold (precedent: xio_general/xg_driver.zag xgC_comb): the
// base's sum trial branch is gated on a combination-context node
// (tag 8), which the base only creates in its own test battery. The
// driver creates one per arm so the sum template is attemptable; it
// teaches no facts and no answers.
fn apx_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn apx_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn apx_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,101,71,5); ev_teach(W,101,71,3); ev_teach(W,101,71,7);
  let x1:i32=xio_query(W,101,91,15,0,xon);
  emit("X1 ans="); e64(x1); apx_tstat(W);
  ev_teach(W,102,71,4); ev_teach(W,102,71,6);
  let x2:i32=xio_query(W,102,91,10,0,xon);
  emit("X2 ans="); e64(x2); apx_tstat(W);
  return;
}
fn apx_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,15,82,201); ev_teach(W,201,82,202); ev_teach(W,202,82,203);
  let y1:i32=xio_query(W,15,92,203,0,xon);
  emit("Y1 ans="); e64(y1); apx_tstat(W);
  ev_teach(W,10,82,211); ev_teach(W,211,82,212); ev_teach(W,212,82,213);
  let y2:i32=xio_query(W,10,92,213,0,xon);
  emit("Y2 ans="); e64(y2); apx_tstat(W);
  return;
}
// Z facts: (103,71,6),(103,71,9); sum(103)=15. Plan from 15 taught in Y.
fn apx_zfacts(W:[]u8)void {
  ev_teach(W,103,71,6); ev_teach(W,103,71,9);
  return;
}
fn apx_zq(W:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit("Z ans="); e64(z); apx_tstat(W);
  apx_acensus(W);
  return;
}
fn apx_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  apx_comb(W);
  apx_trainX(W,1);
  apx_trainY(W,1);
  apx_gap(W);
  apx_census(W);
  apx_zfacts(W); apx_zq(W,103,93,203,1);
  return;
}
fn apx_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  apx_comb(W);
  apx_trainX(W,0);
  apx_trainY(W,0);
  apx_gap(W);
  apx_census(W);
  apx_zfacts(W); apx_zq(W,103,93,203,0);
  return;
}
fn apx_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  apx_comb(W);
  apx_trainX(W,1);
  apx_trainY(W,1);
  apx_del_map_r(W,91);
  emit("maps after del="); e64(apx_count_maps(W)); emit("\n");
  apx_gap(W);
  apx_census(W);
  apx_zfacts(W); apx_zq(W,103,93,203,1);
  return;
}
fn apx_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  apx_comb(W);
  apx_trainX(W,1);
  apx_trainY(W,1);
  apx_del_map_r(W,92);
  emit("maps after del="); e64(apx_count_maps(W)); emit("\n");
  apx_gap(W);
  apx_census(W);
  apx_zfacts(W); apx_zq(W,103,93,203,1);
  return;
}
fn apx_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  apx_comb(W);
  apx_gap(W);
  apx_zfacts(W); apx_zq(W,103,93,203,0);
  return;
}
// ev_query: cx_core.zag's internal test battery references this symbol.
// Provided here as the adapter pipeline (adapters enabled). The battery
// is never invoked by this driver; the entry point is xio_query.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("APX-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); apx_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); apx_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); apx_arm_ablx(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); apx_arm_ably(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); apx_arm_fresh(W5);
  emit("APX-END\n");
  return 0;
}

// ap.zag -- Cross-domain arithmetic to planning via H1 (typed contracts)
// and H2 (value composition). Generality test on a new domain pair.
//
// X: SUM over (s,71,v) facts (arithmetic). Learned sig NODE->NUM.
// Y: ALLOC n/5 integer division (planning: packs affordable). Learned sig NUM->NUM.
// D1: MAX distractor (same sig as X). D2: IDENT distractor (wrong sig).
// Sealed Z: (101,93)->3 needs X-then-Y. Z2: (102,93)->2 via reuse.
// No paired X+Y training. No hint. No label. No ARITH_TO_PLAN template.
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.

// ---------- runtime prelude ----------
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn pl(v:i32)void { e64(v); emit("\n"); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

// ---------- workspace layout ----------
// header: 0 tries, 4 nmaps, 8 z_id
// facts: base 64, 48 entries x 12 bytes (used,subj,rel,obj)
// maps: base 640, 10 entries x 40 bytes
//   (used,behav,in_sum,in_n,out_sum,out_n,sig_in,sig_out,comp_a,comp_b)
fn ap_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,-1);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn ap_facts(W:[]u8)void {
  add_fact(W,101,71,5); add_fact(W,101,71,3); add_fact(W,101,71,7);
  add_fact(W,102,71,4); add_fact(W,102,71,6);
  return;
}
fn sum_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<48){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      n=n+ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return n;
}
fn max_rel(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=0; let f:i32=0; let i:i32=0;
  while(i<48){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      let v:i32=ig(W,64+i*12+12);
      if(f==0 || v>m){ m=v; f=1; }
    }
    i=i+1;
  }
  return m;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,4);
  put32(W,4,m+1);
  let b:i32=640+m*40;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,0); put32(W,b+12,0); put32(W,b+16,0); put32(W,b+20,0);
  put32(W,b+24,0); put32(W,b+28,0);
  put32(W,b+32,-1); put32(W,b+36,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,640+m*40,0); return; }
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=640+m*40;
  let bh:i32=ig(W,b+4);
  if(bh==0){ return sum_rel(W,v,71); }
  if(bh==1){ return v/5; }
  if(bh==2){ return max_rel(W,v,71); }
  if(bh==3){ return v; }
  let a:i32=ig(W,b+32); let c:i32=ig(W,b+36);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,c,mid);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=640+m*40;
  put32(W,b+8,ig(W,b+8)+probe_kind(W,vin));
  put32(W,b+12,ig(W,b+12)+1);
  put32(W,b+16,ig(W,b+16)+probe_kind(W,vout));
  put32(W,b+20,ig(W,b+20)+1);
  return;
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=640+m*40;
  let inn:i32=ig(W,b+12); let outn:i32=ig(W,b+20);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+8)*2>=inn*3){ si=2; }
    put32(W,b+24,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+16)*2>=outn*3){ so=2; }
    put32(W,b+28,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,640+m*40+24); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,640+m*40+28); }
fn teach_all(W:[]u8)void {
  let x:i32=map_new(W,0);
  let r:i32=exec_map(W,x,101); record_obs(W,x,101,r);
  r=exec_map(W,x,102); record_obs(W,x,102,r);
  finalize_sig(W,x);
  emit("TEACH X sig="); e64(sig_in(W,x)); emit("->"); pl(sig_out(W,x));
  let y:i32=map_new(W,1);
  r=exec_map(W,y,15); record_obs(W,y,15,r);
  r=exec_map(W,y,10); record_obs(W,y,10,r);
  r=exec_map(W,y,7); record_obs(W,y,7,r);
  finalize_sig(W,y);
  emit("TEACH Y sig="); e64(sig_in(W,y)); emit("->"); pl(sig_out(W,y));
  let d1:i32=map_new(W,2);
  r=exec_map(W,d1,101); record_obs(W,d1,101,r);
  r=exec_map(W,d1,102); record_obs(W,d1,102,r);
  finalize_sig(W,d1);
  emit("TEACH D1 sig="); e64(sig_in(W,d1)); emit("->"); pl(sig_out(W,d1));
  let d2:i32=map_new(W,3);
  r=exec_map(W,d2,101); record_obs(W,d2,101,r);
  r=exec_map(W,d2,102); record_obs(W,d2,102,r);
  finalize_sig(W,d2);
  emit("TEACH D2 sig="); e64(sig_in(W,d2)); emit("->"); pl(sig_out(W,d2));
  return;
}
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=640+z*40;
  put32(W,zb+32,a); put32(W,zb+36,b);
  put32(W,zb+24,sig_in(W,a));
  put32(W,zb+28,sig_out(W,b));
  put32(W,8,z);
  return z;
}
// M1: typed-contract solver. type_on=1 enables the learned-signature filter.
fn solve_typed(W:[]u8,s:i32,target:i32,type_on:i32)i32 {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,4);
  let tries:i32=0;
  let m:i32=0;
  while(m<nm){
    if(ig(W,640+m*40)==1){
      let ok:i32=1;
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        emit("T-TRY single m="); e64(m); emit(" r="); pl(r);
        if(r==target){ emit("T-SINGLE m="); pl(m); return tries; }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,640+a*40)==1 && ig(W,640+b*40)==1){
        let ok:i32=1;
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          emit("T-TRY pair a="); e64(a); emit(" b="); e64(b); emit(" r="); pl(r);
          if(r==target){
            let z:i32=promote_comp(W,a,b);
            emit("T-COMP z="); e64(z); emit(" a="); e64(a); emit(" b="); pl(b);
            return tries;
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  emit("T-FAIL\n");
  return 0-tries;
}
// M2: value-composition solver. pair_on=1 enables ordered-pair search.
fn solve_value(W:[]u8,s:i32,target:i32,pair_on:i32)i32 {
  let nm:i32=ig(W,4);
  let tries:i32=0;
  let m:i32=0;
  while(m<nm){
    if(ig(W,640+m*40)==1){
      tries=tries+1;
      let r:i32=exec_map(W,m,s);
      emit("V-TRY single m="); e64(m); emit(" r="); pl(r);
      if(r==target){ emit("V-SINGLE m="); pl(m); return tries; }
    }
    m=m+1;
  }
  if(pair_on==0){ emit("V-FAIL-nopair\n"); return 0-tries; }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,640+a*40)==1 && ig(W,640+b*40)==1){
        tries=tries+1;
        let mid:i32=exec_map(W,a,s);
        let r:i32=exec_map(W,b,mid);
        emit("V-TRY pair a="); e64(a); emit(" b="); e64(b);
        emit(" mid="); e64(mid); emit(" r="); pl(r);
        if(r==target){
          let z:i32=promote_comp(W,a,b);
          emit("V-COMP z="); e64(z); emit(" a="); e64(a); emit(" b="); pl(b);
          return tries;
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  emit("V-FAIL\n");
  return 0-tries;
}
fn arm_typed(W:[]u8)i32 {
  emit("=== TREAT-TYPED ===\n");
  ap_facts(W); teach_all(W);
  let t:i32=solve_typed(W,101,3,1);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(t>0 && z>=0){
    let za:i32=ig(W,640+z*40+32); let zb:i32=ig(W,640+z*40+36);
    if(za==0 && zb==1){ ok=1; }
  }
  if(ok==1){ emit("ARM-RESULT PASS tries="); pl(t); }
  else { emit("ARM-RESULT FAIL tries="); pl(t); }
  let t2:i32=solve_typed(W,102,2,1);
  emit("Z2 tries="); pl(t2);
  if(t2>0 && t2<=t){ emit("Z2-RESULT PASS\n"); } else { emit("Z2-RESULT FAIL\n"); }
  return t;
}
fn arm_value(W:[]u8)i32 {
  emit("=== TREAT-VALUE ===\n");
  ap_facts(W); teach_all(W);
  let t:i32=solve_value(W,101,3,1);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(t>0 && z>=0){
    let za:i32=ig(W,640+z*40+32); let zb:i32=ig(W,640+z*40+36);
    if(za==0 && zb==1){ ok=1; }
  }
  if(ok==1){ emit("ARM-RESULT PASS tries="); pl(t); }
  else { emit("ARM-RESULT FAIL tries="); pl(t); }
  let t2:i32=solve_value(W,102,2,1);
  emit("Z2 tries="); pl(t2);
  if(t2>0){ emit("Z2-RESULT PASS\n"); } else { emit("Z2-RESULT FAIL\n"); }
  return t;
}
fn arm_notype(W:[]u8,tt:i32)i32 {
  emit("=== NOTYPE ===\n");
  ap_facts(W); teach_all(W);
  let t:i32=solve_typed(W,101,3,0);
  if(t>0 && t>tt){ emit("ARM-RESULT PASS-more-tries tries="); pl(t); }
  else { emit("ARM-RESULT FAIL tries="); pl(t); }
  return t;
}
fn arm_novc(W:[]u8)i32 {
  emit("=== NOVC ===\n");
  ap_facts(W); teach_all(W);
  let t:i32=solve_value(W,101,3,0);
  if(t<=0){ emit("ARM-RESULT PASS-expected-fail tries="); pl(0-t); }
  else { emit("ARM-RESULT FAIL-unexpected-solve tries="); pl(t); }
  return t;
}
fn arm_ablx(W:[]u8)i32 {
  emit("=== ABL-X ===\n");
  ap_facts(W); teach_all(W);
  del_map(W,0);
  let t1:i32=solve_typed(W,101,3,1);
  let t2:i32=solve_value(W,101,3,1);
  if(t1<=0 && t2<=0){ emit("ARM-RESULT PASS-expected-fail\n"); }
  else { emit("ARM-RESULT FAIL-unexpected-solve\n"); }
  return t1+t2;
}
fn arm_ably(W:[]u8)i32 {
  emit("=== ABL-Y ===\n");
  ap_facts(W); teach_all(W);
  del_map(W,1);
  let t1:i32=solve_typed(W,101,3,1);
  let t2:i32=solve_value(W,101,3,1);
  if(t1<=0 && t2<=0){ emit("ARM-RESULT PASS-expected-fail\n"); }
  else { emit("ARM-RESULT FAIL-unexpected-solve\n"); }
  return t1+t2;
}
fn arm_fresh(W:[]u8)i32 {
  emit("=== FRESH ===\n");
  ap_facts(W);
  let t1:i32=solve_typed(W,101,3,1);
  let t2:i32=solve_value(W,101,3,1);
  if(t1<=0 && t2<=0){ emit("ARM-RESULT PASS-expected-fail\n"); }
  else { emit("ARM-RESULT FAIL-unexpected-solve\n"); }
  return t1+t2;
}
fn main()i32 {
  emit("XDOMAIN-ARITH-PLAN-START\n");
  let W1:[]u8=z_alloc(8192); ap_init(W1); let tt:i32=arm_typed(W1);
  let W2:[]u8=z_alloc(8192); ap_init(W2); let tv:i32=arm_value(W2); if(tv<0){ emit(""); }
  let W3:[]u8=z_alloc(8192); ap_init(W3); let tn:i32=arm_notype(W3,tt); if(tn<0){ emit(""); }
  let W4:[]u8=z_alloc(8192); ap_init(W4); let tc:i32=arm_novc(W4); if(tc>99999){ emit(""); }
  let W5:[]u8=z_alloc(8192); ap_init(W5); let tx:i32=arm_ablx(W5); if(tx>99999){ emit(""); }
  let W6:[]u8=z_alloc(8192); ap_init(W6); let ty:i32=arm_ably(W6); if(ty>99999){ emit(""); }
  let W7:[]u8=z_alloc(8192); ap_init(W7); let tf:i32=arm_fresh(W7); if(tf>99999){ emit(""); }
  emit("XDOMAIN-ARITH-PLAN-END\n");
  return 0;
}

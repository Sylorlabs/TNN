// ap_driver_h3.zag -- sum-then-plan driver for H3.
//
// Same world as ap_driver.zag, but the Z query goes through ev_query_c
// with the preregistered constraint sweep: C=[plen,-1,-1,-1,-1,103] for
// plen=1..4 (all-don't-care except plen and first_lit). X/Y training
// uses plain ev_query. Used with H3 (invent_base+invent_patch).

fn ap_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit("\n");
  return;
}
fn ap_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn ap_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
fn ap_class(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(ap_has_inc(W,ng(W,m,20))==1){emit("arith");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn ap_census(W:[]u8)void {
  emit("maps="); e64(ap_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ap_class(W,m);}
    m=m+1;
  }
  return;
}
fn ap_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn ap_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// Driver scaffold (precedent: xio_general/xg_driver.zag xgC_comb): the
// base's sum trial branch is gated on a combination-context node
// (tag 8), which the base only creates in its own test battery. The
// driver creates one per arm so the sum template is attemptable; it
// teaches no facts and no answers.
fn ap_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn ap_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn ap_trainX(W:[]u8)void {
  ev_teach(W,101,71,5); ev_teach(W,101,71,3); ev_teach(W,101,71,7);
  let x1:i32=ev_query(W,101,91,15,0);
  emit("X1 ans="); e64(x1); ap_tstat(W);
  ev_teach(W,102,71,4); ev_teach(W,102,71,6);
  let x2:i32=ev_query(W,102,91,10,0);
  emit("X2 ans="); e64(x2); ap_tstat(W);
  return;
}
fn ap_trainY(W:[]u8)void {
  ev_teach(W,15,82,201); ev_teach(W,201,82,202); ev_teach(W,202,82,203);
  let y1:i32=ev_query(W,15,92,203,0);
  emit("Y1 ans="); e64(y1); ap_tstat(W);
  ev_teach(W,10,82,211); ev_teach(W,211,82,212); ev_teach(W,212,82,213);
  let y2:i32=ev_query(W,10,92,213,0);
  emit("Y2 ans="); e64(y2); ap_tstat(W);
  return;
}
fn ap_zfacts(W:[]u8)void {
  ev_teach(W,103,71,6); ev_teach(W,103,71,9);
  return;
}
// Z via ev_query_c, preregistered sweep plen=1..4, don't-care elsewhere.
// First plen yielding 203 wins; all are expected to fail verification.
fn ap_zquery_h3(W:[]u8)void {
  let C:[]u8=z_alloc(24);
  set32(C,4,-1); set32(C,8,-1); set32(C,12,-1); set32(C,16,-1);
  set32(C,20,103);
  let z:i32=-2;
  let pl:i32=1;
  while(pl<=4 && z!=203){
    set32(C,0,pl);
    emit("Z plen="); e64(pl); emit(" ");
    z=ev_query_c(W,103,93,203,0,C);
    emit("Z ans="); e64(z); ap_tstat(W);
    pl=pl+1;
  }
  let zm:i32=ap_find_map(W,103,93);
  emit("ZMAP id="); e64(zm); emit("\n");
  return;
}
fn ap_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  ap_comb(W);
  ap_trainX(W);
  ap_trainY(W);
  ap_gap(W);
  ap_census(W);
  ap_zfacts(W);
  ap_zquery_h3(W);
  return;
}
fn ap_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  ap_comb(W);
  ap_trainX(W);
  ap_trainY(W);
  ap_del_map_r(W,91);
  emit("maps after del="); e64(ap_count_maps(W)); emit("\n");
  ap_gap(W);
  ap_zfacts(W);
  ap_zquery_h3(W);
  return;
}
fn ap_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  ap_comb(W);
  ap_trainX(W);
  ap_trainY(W);
  ap_del_map_r(W,92);
  emit("maps after del="); e64(ap_count_maps(W)); emit("\n");
  ap_gap(W);
  ap_zfacts(W);
  ap_zquery_h3(W);
  return;
}
fn ap_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  ap_comb(W);
  ap_gap(W);
  ap_zfacts(W);
  ap_zquery_h3(W);
  return;
}
fn main()i32 {
  emit("AP-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); ap_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); ap_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); ap_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); ap_fresh(W4);
  emit("AP-END\n");
  return 0;
}

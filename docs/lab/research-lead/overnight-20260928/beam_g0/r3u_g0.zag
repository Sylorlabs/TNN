// q4_parcond.zag: Q4 learner on adversary-designed F-PARCOND family.
// Pure Zag. No Python.
// F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3). 6 ops.
// Sealed adversary family (ADV_SPEC.md, b4e9b6a14). Prereg: ad4284269.

// ============ basics ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
// ============ G0 diagnostic logging (file only, never stdout) ============
// Raw-syscall file helpers, same pattern as lifetime_race/race_tnn.zag.
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn g0app(buf:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ buf[at]=s[i]; at=at+1; i=i+1; }
  return at;
}
fn g0emit_c(fd:i64, round:i32, k:i32, d:i32, h0:i32, h1:i32, h2:i32, h3:i32, acc:i32, opc:i32)void {
  let b:[]u8=z_alloc(160);
  let at:i32=0;
  at=g0app(b,at,"C 2 ");
  at=g0app(b,at,i32s(round)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(k)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(d)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h0)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h1)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h2)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h3)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(acc)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(opc)); at=g0app(b,at,"\n");
  w_write(fd, b[0..at]);
  return;
}
fn g0emit_m(fd:i64, round:i32, d:i32, h0:i32, h1:i32, h2:i32, h3:i32)void {
  let b:[]u8=z_alloc(160);
  let at:i32=0;
  at=g0app(b,at,"M 2 ");
  at=g0app(b,at,i32s(round)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(d)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h0)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h1)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h2)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(h3)); at=g0app(b,at,"\n");
  w_write(fd, b[0..at]);
  return;
}
fn g0emit_p(fd:i64, round:i32, k:i32, p:i32)void {
  let b:[]u8=z_alloc(160);
  let at:i32=0;
  at=g0app(b,at,"P 2 ");
  at=g0app(b,at,i32s(round)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(k)); at=g0app(b,at," ");
  at=g0app(b,at,i32s(p)); at=g0app(b,at,"\n");
  w_write(fd, b[0..at]);
  return;
}
fn get32(b:[]u8, off:i32)i32 {
  let a:i32=b[off] as i32;
  let bb:i32=b[off+1] as i32;
  let c:i32=b[off+2] as i32;
  let d:i32=b[off+3] as i32;
  let r1:i32=a | (bb<<8);
  let r2:i32=r1 | (c<<16);
  let r3:i32=r2 | (d<<24);
  return r3;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}
// state offsets: 0 node_count, 4 trace_count, 8 beam_n, 12 ev_n,
// 16 rng_state, 20 lib_n, 24 nterms
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }

// ============ PRNG ============
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 16, ns);
  return ns;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return r % n;
}

// ============ sealed worlds ============
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  let x5:i32=(x>>4)&1;
  if(fam==0){
    let r:i32=x1 & x2;
    return r;
  }
  if(fam==1){
    let r:i32=x1 ^ x2;
    return r;
  }
  if(fam==2){
    let a:i32=x1 & x2;
    let r:i32=a | x5;
    return r;
  }
  if(fam==3){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let r:i32=(a | b) | c;
    return r;
  }
  if(fam==4){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let m:i32=(a | b) | c;
    let r:i32=m ^ x4;
    return r;
  }
  if(fam==5){
    // F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3)
    // D = (x1 & a) | ((x1^1) & b) where a = x2^x3, b = x2&x3
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let r:i32=t1 | t2;
    return r;
  }
  if(fam==6){
    // F-PARCOND-XOR: C' = D XOR X4 (Phase 2 reuse target)
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let r:i32=d ^ x4;
    return r;
  }
  if(fam==7){
    // R3 ARM1: C' = D_10 XOR X4. D_10 = ((D AND 1) XOR 0) AND 1,
    // identity wrappers written out; behaviorally identical to fam 6.
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let w1:i32=d & 1;
    let w2:i32=w1 ^ 0;
    let w3:i32=w2 & 1;
    let r:i32=w3 ^ x4;
    return r;
  }
  if(fam==8){
    // R3 ARM2: E = (D AND Y4) OR ((NOT D) AND Y5).
    // Y1..Y6 = bits 0..5; D on (Y1,Y2,Y3) = bits 0,1,2;
    // Y4 = bit 3, Y5 = bit 4; Y6 = bit 5 is the decoy.
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let y4:i32=(x>>3)&1;
    let y5:i32=(x>>4)&1;
    let nd:i32=d ^ 1;
    let r:i32=(d & y4) | (nd & y5);
    return r;
  }
  return 0;
}

// ============ nodes (28 bytes) ============
fn ndg(nodes:[]u8, n:i32, off:i32)i32 { return get32(nodes, n*28+off); }
fn nds(nodes:[]u8, n:i32, off:i32, v:i32)void { set32(nodes, n*28+off, v); return; }
fn sig_hash(lo:i32, hi:i32)i32 {
  let h1:i32=hi * 33;
  let h2:i32=lo ^ h1;
  let h:i32=h2 & 16383;
  return h;
}
fn sig_lookup(sigtab:[]u8, nodes:[]u8, lo:i32, hi:i32)i32 {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){ return -1; }
    let n:i32=slot-1;
    let nlo:i32=ndg(nodes, n, 16);
    if(nlo==lo){
      let nhi:i32=ndg(nodes, n, 20);
      if(nhi==hi){ return n; }
    }
    i=i+1;
  }
  return -1;
}
fn sig_insert(sigtab:[]u8, lo:i32, hi:i32, n:i32)void {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){
      set32(sigtab, idx*4, n+1);
      return;
    }
    i=i+1;
  }
  return;
}
fn term_sig(t:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  if(t<6){
    let x:i32=0;
    while(x<64){
      let bit:i32=(x>>t)&1;
      if(bit==1){
        if(x<32){
          let m:i32=1<<x;
          lo=lo | m;
        } else {
          let m:i32=1<<(x-32);
          hi=hi | m;
        }
      }
      x=x+1;
    }
  } else {
    if(t==7){
      lo=-1;
      hi=-1;
    }
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn node_new_term(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32)i32 {
  let sob:[]u8=z_alloc(8);
  term_sig(t, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_libterm(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32, lo:i32, hi:i32)i32 {
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_op(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 16);
  let hi0:i32=ndg(nodes, c0, 20);
  let lo:i32=0;
  let hi:i32=0;
  let oc:i32=0;
  if(op==0){
    let lo1:i32=ndg(nodes, c1, 16);
    let hi1:i32=ndg(nodes, c1, 20);
    lo=lo0 & lo1;
    hi=hi0 & hi1;
    oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
  } else {
    if(op==1){
      let lo1:i32=ndg(nodes, c1, 16);
      let hi1:i32=ndg(nodes, c1, 20);
      lo=lo0 | lo1;
      hi=hi0 | hi1;
      oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
    } else {
      if(op==2){
        lo=lo0 ^ -1;
        hi=hi0 ^ -1;
        oc=1 + ndg(nodes, c0, 24);
      } else {
        let lo1:i32=ndg(nodes, c1, 16);
        let hi1:i32=ndg(nodes, c1, 20);
        lo=lo0 ^ lo1;
        hi=hi0 ^ hi1;
        oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
      }
    }
  }
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, oc);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  let tc:i32=stg(st, 4);
  if(tc<4096){
    set32(trace, tc*20+0, op);
    set32(trace, tc*20+4, c0);
    set32(trace, tc*20+8, c1);
    set32(trace, tc*20+12, nc);
    set32(trace, tc*20+16, stg(st, 12));
    sts(st, 4, tc+1);
  }
  return nc;
}
fn node_pred(nodes:[]u8, n:i32, x:i32)i32 {
  let slo:i32=ndg(nodes, n, 16);
  if(x<32){
    let p:i32=(slo>>x)&1;
    return p;
  }
  let shi:i32=ndg(nodes, n, 20);
  let p:i32=(shi>>(x-32))&1;
  return p;
}

// ============ beam (16 bytes/slot) ============
fn bmg(beam:[]u8, i:i32, off:i32)i32 { return get32(beam, i*16+off); }
fn bms(beam:[]u8, i:i32, off:i32, v:i32)void { set32(beam, i*16+off, v); return; }
// score a single node on evidence; returns score*10000 scale via out param
fn score_node(st:[]u8, nodes:[]u8, n:i32, ev_x:[]u8, ev_y:[]u8, out:[]u8)void {
  let en:i32=stg(st, 12);
  let opc:i32=ndg(nodes, n, 24);
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let p:i32=node_pred(nodes, n, x);
    if(p==y){ c=c+1; }
    e=e+1;
  }
  let sc:i32=0;
  if(en>0){
    let a1:i32=(c*10000)/en;
    let a2:i32=200*opc;
    sc=a1 - a2;
  }
  set32(out, 0, sc);
  set32(out, 4, c);
  set32(out, 8, opc);
  return;
}
fn beam_sort(beam:[]u8, bn:i32)void {
  let i:i32=0;
  while(i<bn){
    let best:i32=i;
    let j:i32=i+1;
    while(j<bn){
      let sj:i32=bmg(beam, j, 4);
      let sb:i32=bmg(beam, best, 4);
      let take:i32=0;
      if(sj>sb){ take=1; }
      else {
        if(sj==sb){
          let oj:i32=bmg(beam, j, 12);
          let ob:i32=bmg(beam, best, 12);
          if(oj<ob){ take=1; }
          else {
            if(oj==ob){
              let nj:i32=bmg(beam, j, 0);
              let nb:i32=bmg(beam, best, 0);
              if(nj<nb){ take=1; }
            }
          }
        }
      }
      if(take==1){ best=j; }
      j=j+1;
    }
    if(best!=i){
      let k:i32=0;
      while(k<4){
        let t:i32=bmg(beam, i, k*4);
        bms(beam, i, k*4, bmg(beam, best, k*4));
        bms(beam, best, k*4, t);
        k=k+1;
      }
    }
    i=i+1;
  }
  return;
}
// Extend beam by one generation. tmp: 3136*4 cand buffer. tsc: 3136*12 score buffer.
// ============ unified beam U1-U7 ============
// Species signature: (tree depth, operator multiset [AND,OR,NOT,XOR]).
// Generic machinery only. No target, family, or library knowledge.
// Depth: single increasing node-id pass (children always have smaller ids).
fn u_depth_fill(nodes:[]u8, dmem:[]u8, nmax:i32)void {
  let n:i32=0;
  while(n<=nmax){
    if(ndg(nodes, n, 0)==0){
      set32(dmem, n*4, 0);
    } else {
      let c0:i32=ndg(nodes, n, 8);
      let c1:i32=ndg(nodes, n, 12);
      let mx:i32=get32(dmem, c0*4);
      if(c1>=0){
        let d1:i32=get32(dmem, c1*4);
        if(d1>mx){ mx=d1; }
      }
      set32(dmem, n*4, mx+1);
    }
    n=n+1;
  }
  return;
}
// Operator histogram of the DAG rooted at n. Each distinct reachable
// node is counted once (visit-token dedup). out: 4 i32s, zeroed by caller.
fn u_hist(nodes:[]u8, n:i32, vis:[]u8, tok:i32, stack:[]u8, out:[]u8)void {
  let sp:i32=1;
  set32(stack, 0, n);
  set32(vis, n*4, tok);
  while(sp>0){
    sp=sp-1;
    let m:i32=get32(stack, sp*4);
    if(ndg(nodes, m, 0)==1){
      let op:i32=ndg(nodes, m, 4);
      set32(out, op*4, get32(out, op*4)+1);
      let c0:i32=ndg(nodes, m, 8);
      let c1:i32=ndg(nodes, m, 12);
      if(get32(vis, c0*4)!=tok){
        set32(vis, c0*4, tok);
        set32(stack, sp*4, c0);
        sp=sp+1;
      }
      if(c1>=0){
        if(get32(vis, c1*4)!=tok){
          set32(vis, c1*4, tok);
          set32(stack, sp*4, c1);
          sp=sp+1;
        }
      }
    }
  }
  return;
}
fn u_popcnt(v:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<32){
    if(((v>>i)&1)==1){ c=c+1; }
    i=i+1;
  }
  return c;
}
// Phase ordering comparator. phase 0 = exploration (accuracy only),
// phase 1 = consolidation/final (accuracy, then opc). Returns 1 if a
// ranks strictly above b.
fn u_better(ca:[]u8, co:[]u8, cn:[]u8, cda:[]u8, cdb:[]u8, a:i32, b:i32, phase:i32)i32 {
  let aa:i32=get32(ca, a*4);
  let ab:i32=get32(ca, b*4);
  if(aa>ab){ return 1; }
  if(aa<ab){ return 0; }
  if(phase==1){
    let oa:i32=get32(co, a*4);
    let ob:i32=get32(co, b*4);
    if(oa<ob){ return 1; }
    if(oa>ob){ return 0; }
  }
  let da:i32=get32(cda, a*4);
  let db:i32=get32(cda, b*4);
  if(da>db){ return 1; }
  if(da<db){ return 0; }
  let na:i32=get32(cdb, a*4);
  let nb:i32=get32(cdb, b*4);
  if(na>nb){ return 1; }
  if(na<nb){ return 0; }
  let xa:i32=get32(cn, a*4);
  let xb:i32=get32(cn, b*4);
  if(xa>xb){ return 1; }
  return 0;
}
// Unified beam extension. Replaces beam_extend. Candidate generation
// and scoring are verbatim of the frozen beam_extend; only retention
// changes (U1/U2/U3/U5/U6). bspec: per-slot species ids (32 i32s).
// round: 0-indexed evidence-loop round (U3 phase). ulog: [maxsims, nodomv].
fn beam_extend_u(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, bspec:[]u8, round:i32, ulog:[]u8, g0fd:i64, g0inv:i32)void {
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  let si:i32=0;
  while(si<8192){ seen[si]=0; si=si+1; }
  let tn:i32=0;
  let i:i32=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    if(seen[n]==0){
      seen[n]=1;
      set32(tmp, tn*4, n);
      tn=tn+1;
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let n2:i32=node_new_op(st, nodes, sigtab, trace, 2, n, -1);
    if(n2>=0){
      if(seen[n2]==0){
        seen[n2]=1;
        set32(tmp, tn*4, n2);
        tn=tn+1;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let j:i32=0;
    while(j<bn){
      let m:i32=bmg(beam, j, 0);
      let op:i32=0;
      while(op<4){
        if(op!=2){
          let n2:i32=node_new_op(st, nodes, sigtab, trace, op, n, m);
          if(n2>=0){
            if(seen[n2]==0){
              seen[n2]=1;
              set32(tmp, tn*4, n2);
              tn=tn+1;
            }
          }
        }
        op=op+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  if(tn>get32(ulog, 0)){ set32(ulog, 0, tn); }
  let sout:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<tn){
    let n:i32=get32(tmp, k*4);
    score_node(st, nodes, n, ev_x, ev_y, sout);
    set32(tsc, k*12+0, get32(sout, 0));
    set32(tsc, k*12+4, get32(sout, 4));
    set32(tsc, k*12+8, get32(sout, 8));
    k=k+1;
  }
  if(tn<1){
    sts(st, 8, 0);
    return;
  }
  let nc:i32=stg(st, 0);
  let dmem:[]u8=z_alloc(8192*4);
  u_depth_fill(nodes, dmem, nc-1);
  let vis:[]u8=z_alloc(8192*4);
  let stack:[]u8=z_alloc(8192*4);
  let tok:i32=1;
  let ca:[]u8=z_alloc(tn*4);
  let co:[]u8=z_alloc(tn*4);
  let cn:[]u8=z_alloc(tn*4);
  let cda:[]u8=z_alloc(tn*4);
  let cdb:[]u8=z_alloc(tn*4);
  let cdep:[]u8=z_alloc(tn*4);
  let chist:[]u8=z_alloc(tn*16);
  let cpat:[]u8=z_alloc(tn*4);
  let cspec:[]u8=z_alloc(tn*4);
  let ph:[]u8=z_alloc(16);
  i=0;
  while(i<bn){
    let htmp:[]u8=z_alloc(16);
    u_hist(nodes, bmg(beam, i, 0), vis, tok, stack, htmp);
    tok=tok+1;
    let q:i32=0;
    while(q<4){
      set32(ph, q*4, get32(ph, q*4)+get32(htmp, q*4));
      q=q+1;
    }
    i=i+1;
  }
  k=0;
  while(k<tn){
    let nk:i32=get32(tmp, k*4);
    set32(cn, k*4, nk);
    set32(ca, k*4, get32(tsc, k*12+4));
    set32(co, k*4, get32(tsc, k*12+8));
    set32(cdep, k*4, get32(dmem, nk*4));
    let htmp2:[]u8=z_alloc(16);
    u_hist(nodes, nk, vis, tok, stack, htmp2);
    tok=tok+1;
    let q2:i32=0;
    while(q2<4){
      set32(chist, k*16+q2*4, get32(htmp2, q2*4));
      q2=q2+1;
    }
    let pat:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=node_pred(nodes, nk, x);
      if(p==y){ pat=pat | (1<<e); }
      e=e+1;
    }
    set32(cpat, k*4, pat);
    let nv:i32=0;
    let q3:i32=0;
    while(q3<4){
      nv=nv+abs_i(get32(htmp2, q3*4)-get32(ph, q3*4));
      q3=q3+1;
    }
    set32(cdb, k*4, nv);
    set32(cspec, k*4, -1);
    k=k+1;
  }
  let skey:[]u8=z_alloc(tn*20);
  let nspec:i32=0;
  k=0;
  while(k<tn){
    let dk:i32=get32(cdep, k*4);
    let h0:i32=get32(chist, k*16+0);
    let h1:i32=get32(chist, k*16+4);
    let h2:i32=get32(chist, k*16+8);
    let h3:i32=get32(chist, k*16+12);
    let s:i32=0;
    let f:i32=-1;
    while(s<nspec){
      if(get32(skey, s*20+0)==dk){
        if(get32(skey, s*20+4)==h0){
          if(get32(skey, s*20+8)==h1){
            if(get32(skey, s*20+12)==h2){
              if(get32(skey, s*20+16)==h3){
                f=s;
                break;
              }
            }
          }
        }
      }
      s=s+1;
    }
    if(f<0){
      f=nspec;
      set32(skey, f*20+0, dk);
      set32(skey, f*20+4, h0);
      set32(skey, f*20+8, h1);
      set32(skey, f*20+12, h2);
      set32(skey, f*20+16, h3);
      nspec=nspec+1;
    }
    set32(cspec, k*4, f);
    k=k+1;
  }
  // G0: log every emitted candidate's species signature (generic; the
  // beam's own depth/histogram). File only, never stdout.
  if(g0inv==2){
    if(g0fd>=0){
      let gk:i32=0;
      while(gk<tn){
        g0emit_c(g0fd, round, gk, get32(cdep, gk*4), get32(chist, gk*16+0), get32(chist, gk*16+4), get32(chist, gk*16+8), get32(chist, gk*16+12), get32(ca, gk*4), get32(co, gk*4));
        gk=gk+1;
      }
    }
  }
  while(nspec>8){
    let scnt:[]u8=z_alloc(nspec*4);
    let sacc:[]u8=z_alloc(nspec*4);
    let s:i32=0;
    while(s<nspec){
      set32(sacc, s*4, -1);
      s=s+1;
    }
    k=0;
    while(k<tn){
      let spx:i32=get32(cspec, k*4);
      set32(scnt, spx*4, get32(scnt, spx*4)+1);
      let akx:i32=get32(ca, k*4);
      if(akx>get32(sacc, spx*4)){ set32(sacc, spx*4, akx); }
      k=k+1;
    }
    let s1:i32=-1;
    let s2:i32=-1;
    s=0;
    while(s<nspec){
      let cs:i32=get32(scnt, s*4);
      let as:i32=get32(sacc, s*4);
      let sm1:i32=0;
      if(s1<0){ sm1=1; }
      else {
        let c1x:i32=get32(scnt, s1*4);
        let a1x:i32=get32(sacc, s1*4);
        if(cs<c1x){ sm1=1; }
        else {
          if(cs==c1x){
            if(as<a1x){ sm1=1; }
          }
        }
      }
      if(sm1==1){
        s2=s1;
        s1=s;
      } else {
        let sm2:i32=0;
        if(s2<0){ sm2=1; }
        else {
          let c2x:i32=get32(scnt, s2*4);
          let a2x:i32=get32(sacc, s2*4);
          if(cs<c2x){ sm2=1; }
          else {
            if(cs==c2x){
              if(as<a2x){ sm2=1; }
            }
          }
        }
        if(sm2==1){ s2=s; }
      }
      s=s+1;
    }
    k=0;
    while(k<tn){
      if(get32(cspec, k*4)==s2){ set32(cspec, k*4, s1); }
      k=k+1;
    }
    // G0: log the absorbed species key (skey[s2] still intact here).
    if(g0inv==2){
      if(g0fd>=0){
        g0emit_m(g0fd, round, get32(skey, s2*20+0), get32(skey, s2*20+4), get32(skey, s2*20+8), get32(skey, s2*20+12), get32(skey, s2*20+16));
      }
    }
    let last:i32=nspec-1;
    if(last!=s2){
      k=0;
      while(k<tn){
        if(get32(cspec, k*4)==last){ set32(cspec, k*4, s2); }
        k=k+1;
      }
      let q4:i32=0;
      while(q4<5){
        set32(skey, s2*20+q4*4, get32(skey, last*20+q4*4));
        q4=q4+1;
      }
    }
    nspec=nspec-1;
  }
  let gcount:[]u8=z_alloc(nspec*33*4);
  let gbits:[]u8=z_alloc(nspec*33*32*4);
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let akx:i32=get32(ca, k*4);
    let g:i32=spx*33+akx;
    set32(gcount, g*4, get32(gcount, g*4)+1);
    let patk:i32=get32(cpat, k*4);
    let e:i32=0;
    while(e<en){
      if(((patk>>e)&1)==1){
        let gb:i32=g*32+e;
        set32(gbits, gb*4, get32(gbits, gb*4)+1);
      }
      e=e+1;
    }
    k=k+1;
  }
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let akx:i32=get32(ca, k*4);
    let g:i32=spx*33+akx;
    let gc:i32=get32(gcount, g*4);
    let da:i32=0;
    if(gc>1){
      let patk:i32=get32(cpat, k*4);
      let maj:i32=0;
      let e:i32=0;
      while(e<en){
        let ones:i32=get32(gbits, (g*32+e)*4);
        if(ones*2>=gc){ maj=maj | (1<<e); }
        e=e+1;
      }
      da=u_popcnt(patk ^ maj);
    }
    set32(cda, k*4, da);
    k=k+1;
  }
  let phase:i32=0;
  if(round>15){ phase=1; }
  let sbest:[]u8=z_alloc(nspec*4);
  let s:i32=0;
  while(s<nspec){
    set32(sbest, s*4, -1);
    s=s+1;
  }
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let cur:i32=get32(sbest, spx*4);
    if(cur<0){ set32(sbest, spx*4, k); }
    else {
      if(u_better(ca, co, cn, cda, cdb, k, cur, phase)==1){
        set32(sbest, spx*4, k);
      }
    }
    k=k+1;
  }
  let sord:[]u8=z_alloc(nspec*4);
  let sdone:[]u8=z_alloc(nspec);
  let oi:i32=0;
  while(oi<nspec){
    let bs:i32=-1;
    s=0;
    while(s<nspec){
      if(sdone[s]==0){
        if(bs<0){ bs=s; }
        else {
          let ms:i32=get32(sbest, s*4);
          let mb:i32=get32(sbest, bs*4);
          if(u_better(ca, co, cn, cda, cdb, ms, mb, phase)==1){ bs=s; }
        }
      }
      s=s+1;
    }
    sdone[bs]=1;
    set32(sord, oi*4, bs);
    oi=oi+1;
  }
  let picked:[]u8=z_alloc(tn);
  let kept:i32=0;
  oi=0;
  while(oi<nspec){
    if(kept>=28){ break; }
    let sp:i32=get32(sord, oi*4);
    let tk:i32=0;
    while(tk<4){
      if(kept>=28){ break; }
      let bk:i32=-1;
      k=0;
      while(k<tn){
        if(picked[k]==0){
          if(get32(cspec, k*4)==sp){
            if(bk<0){ bk=k; }
            else {
              if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
            }
          }
        }
        k=k+1;
      }
      if(bk<0){ break; }
      picked[bk]=1;
      kept=kept+1;
      tk=tk+1;
    }
    oi=oi+1;
  }
  while(kept<28){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    kept=kept+1;
  }
  let nodomv:i32=0;
  k=0;
  while(k<tn){
    if(picked[k]==0){
      let spk:i32=get32(cspec, k*4);
      let ak:i32=get32(ca, k*4);
      let ok:i32=get32(co, k*4);
      let j:i32=0;
      while(j<tn){
        if(picked[j]==1){
          if(get32(cspec, j*4)==spk){
            let aj:i32=get32(ca, j*4);
            let oj:i32=get32(co, j*4);
            if(ak>aj){ nodomv=nodomv+1; }
            else {
              if(ak==aj){
                if(ok<oj){ nodomv=nodomv+1; }
              }
            }
          }
        }
        j=j+1;
      }
    }
    k=k+1;
  }
  set32(ulog, 4, get32(ulog, 4)+nodomv);
  let shsum:[]u8=z_alloc(16);
  k=0;
  while(k<tn){
    if(picked[k]==1){
      let q5:i32=0;
      while(q5<4){
        set32(shsum, q5*4, get32(shsum, q5*4)+get32(chist, k*16+q5*4));
        q5=q5+1;
      }
    }
    k=k+1;
  }
  let c6:[]u8=z_alloc(tn*4);
  k=0;
  while(k<tn){
    if(picked[k]==0){
      let ak2:i32=get32(ca, k*4);
      if(en>0){
        if((ak2*100)/en>=50){
          let nv2:i32=0;
          let q6:i32=0;
          while(q6<4){
            nv2=nv2+abs_i(get32(chist, k*16+q6*4)*kept-get32(shsum, q6*4));
            q6=q6+1;
          }
          set32(c6, k*4, nv2+1);
        }
      }
    }
    k=k+1;
  }
  let got6:i32=0;
  while(got6<4){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        let nv3:i32=get32(c6, k*4);
        if(nv3>0){
          if(bk<0){ bk=k; }
          else {
            let nvb:i32=get32(c6, bk*4);
            if(nv3>nvb){ bk=k; }
            else {
              if(nv3==nvb){
                let ak3:i32=get32(ca, k*4);
                let ab3:i32=get32(ca, bk*4);
                if(ak3>ab3){ bk=k; }
                else {
                  if(ak3==ab3){
                    if(get32(cn, k*4)>get32(cn, bk*4)){ bk=k; }
                  }
                }
              }
            }
          }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    got6=got6+1;
  }
  while(got6<4){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    got6=got6+1;
  }
  let nb:i32=0;
  let wri:i32=0;
  while(wri<32){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==1){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, 1)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=2;
    let wn:i32=get32(cn, bk*4);
    bms(beam, nb, 0, wn);
    bms(beam, nb, 4, get32(tsc, bk*12+0));
    bms(beam, nb, 8, get32(ca, bk*4));
    bms(beam, nb, 12, get32(co, bk*4));
    set32(bspec, nb*4, get32(cspec, bk*4));
    nb=nb+1;
    wri=wri+1;
  }
  // G0: log retention fate per candidate (1 kept, 0 pruned).
  if(g0inv==2){
    if(g0fd>=0){
      let gk2:i32=0;
      while(gk2<tn){
        let gp:i32=0;
        if(picked[gk2]>0){ gp=1; }
        g0emit_p(g0fd, round, gk2, gp);
        gk2=gk2+1;
      }
    }
  }
  sts(st, 8, nb);
  return;
}

// ============ evidence ============
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    used[x]=1;
    i=i+1;
  }
  sts(st, 12, 8);
  return;
}
fn abs_i(v:i32)i32 {
  if(v<0){ return -v; }
  return v;
}
// U4: diverse IV hypothesis set. First member of each distinct species
// (species ids from bspec), up to 8 hypotheses; disagreement machinery
// otherwise identical to the frozen select_iv.
fn select_iv_u(st:[]u8, nodes:[]u8, beam:[]u8, bspec:[]u8, used:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let hnode:[]u8=z_alloc(8*4);
  let hspec:[]u8=z_alloc(8*4);
  let h:i32=0;
  let i:i32=0;
  while(i<bn){
    if(h<8){
      let s:i32=get32(bspec, i*4);
      let dup:i32=0;
      let j:i32=0;
      while(j<h){
        if(get32(hspec, j*4)==s){ dup=1; }
        j=j+1;
      }
      if(dup==0){
        set32(hnode, h*4, bmg(beam, i, 0));
        set32(hspec, h*4, s);
        h=h+1;
      }
    }
    i=i+1;
  }
  if(h<1){ return -1; }
  let best_x:i32=-1;
  let best_d:i32=-1;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){
      let c1:i32=0;
      let k:i32=0;
      while(k<h){
        let n:i32=get32(hnode, k*4);
        let p:i32=node_pred(nodes, n, x);
        if(p==1){ c1=c1+1; }
        k=k+1;
      }
      let av:i32=abs_i(2*c1 - h);
      let d:i32=h - av;
      if(d>best_d){
        best_d=d;
        best_x=x;
      }
    }
    x=x+1;
  }
  return best_x;
}
fn do_iv(st:[]u8, fam:i32, x:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let y:i32=sealed(fam, x);
  let en:i32=stg(st, 12);
  set32(ev_x, en*4, x);
  set32(ev_y, en*4, y);
  used[x]=1;
  sts(st, 12, en+1);
  return;
}
fn true_correct(fam:i32, nodes:[]u8, n:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    let p:i32=node_pred(nodes, n, x);
    let y:i32=sealed(fam, x);
    if(p==y){ c=c+1; }
    x=x+1;
  }
  return c;
}
// Runtime D signature from the sealed F-PARCOND definition (fam 5).
// out: 0 lo, 4 hi.
fn d_sig(out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  let x:i32=0;
  while(x<64){
    let x1:i32=(x>>0)&1;
    let x2:i32=(x>>1)&1;
    let x3:i32=(x>>2)&1;
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let d:i32=(x1 & a) | (nx1 & b);
    if(d==1){
      if(x<32){
        let m:i32=1<<x;
        lo=lo | m;
      } else {
        let m:i32=1<<(x-32);
        hi=hi | m;
      }
    }
    x=x+1;
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
// Iterative subtree walk: does the tree rooted at n contain the
// installed D terminal (type 0, t == 8) with the verified signature?
fn has_d_subexpr(nodes:[]u8, root:i32, lib_lo:i32, lib_hi:i32)i32 {
  let stack:[]u8=z_alloc(256*4);
  let sp:i32=0;
  set32(stack, 0, root);
  sp=1;
  while(sp>0){
    sp=sp-1;
    let n:i32=get32(stack, sp*4);
    let typ:i32=ndg(nodes, n, 0);
    if(typ==0){
      let t:i32=ndg(nodes, n, 4);
      if(t==8){
        let lo:i32=ndg(nodes, n, 16);
        let hi:i32=ndg(nodes, n, 20);
        if(lo==lib_lo){
          if(hi==lib_hi){ return 1; }
        }
      }
    } else {
      let c0:i32=ndg(nodes, n, 8);
      let c1:i32=ndg(nodes, n, 12);
      if(c0>=0){
        set32(stack, sp*4, c0);
        sp=sp+1;
      }
      if(c1>=0){
        set32(stack, sp*4, c1);
        sp=sp+1;
      }
    }
  }
  return 0;
}
fn bobs_ev_correct(st:[]u8, ev_x:[]u8, ev_y:[]u8)i32 {
  let en:i32=stg(st, 12);
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=(x>>i)&1;
      if(p==y){ c=c+1; }
      e=e+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}
fn bobs_true_correct(fam:i32)i32 {
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let x:i32=0;
    while(x<64){
      let p:i32=(x>>i)&1;
      let y:i32=sealed(fam, x);
      if(p==y){ c=c+1; }
      x=x+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}

// ============ reset helpers ============
fn clear_sigtab(sigtab:[]u8)void {
  let i:i32=0;
  while(i<16384){ set32(sigtab, i*4, 0); i=i+1; }
  return;
}
fn clear_used(used:[]u8)void {
  let i:i32=0;
  while(i<64){ used[i]=0; i=i+1; }
  return;
}

// ============ Phase 1 ============
// Returns kept node idx, or -1. Reports via emit.
fn phase1(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, nterms:i32, tag:[]u8, bspec:[]u8, ulog:[]u8, g0fd:i64, g0inv:i32)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  set32(ulog, 0, 0);
  set32(ulog, 4, 0);
  // init beam with terminals
  let t:i32=0;
  while(t<nterms){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, nterms);
  // passive
  passive(st, fam, ev_x, ev_y, used);
  // 24 rounds: extend, score, sort, select intervention
  let r:i32=0;
  while(r<24){
    beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, r, ulog, g0fd, g0inv);
    let x:i32=select_iv_u(st, nodes, beam, bspec, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    r=r+1;
  }
  // final extend+score+sort on full evidence
  beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, 24, ulog, g0fd, g0inv);
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  // BEST = beam[0]
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let obs_c:i32=bobs_ev_correct(st, ev_x, ev_y);
  // keep checks
  let keep:i32=1;
  // acc >= obs + 0.15  <=>  best_c*100 >= obs_c*100 + 15*en
  let lhs:i32=best_c*100;
  let rhs:i32=obs_c*100 + 15*en;
  if(lhs<rhs){ keep=0; }
  if(best_o>7){ keep=0; }
  // minimality: no other within 0.02 acc with fewer ops
  let j:i32=1;
  while(j<bn){
    let cj:i32=bmg(beam, j, 8);
    let oj:i32=bmg(beam, j, 12);
    // cj*100 >= best_c*100 - 2*en  AND  oj < best_o  => fail
    let jl:i32=cj*100;
    let jr:i32=best_c*100 - 2*en;
    if(jl>=jr){
      if(oj<best_o){ keep=0; }
    }
    j=j+1;
  }
  // report
  emit(tag); emit(" BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" obs_correct="); e64(obs_c);
  emit(" opc="); e64(best_o);
  emit(" keep="); e64(keep); emit("\n");
  emit(tag); emit(" TRUE correct="); e64(true_correct(fam, nodes, best_n)); emit("/64");
  emit(" bobs_true="); e64(bobs_true_correct(fam)); emit("/64\n");
  emit(tag); emit(" trace_events="); e64(stg(st, 4)); emit(" nodes="); e64(stg(st, 0)); emit("\n");
  emit("R3U "); emit(tag); emit(" MAXSIMS="); e64(get32(ulog, 0)); emit(" NODOMV="); e64(get32(ulog, 4)); emit("\n");
  if(keep==1){ return best_n; }
  return -1;
}

// ============ Phase 2 ============
// lib_lo, lib_hi: sig of kept D1. use_lib: 1 = reuse, 0 = scratch.
// Returns interventions to reach true acc >= 61/64, or 24.
fn phase2(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, use_lib:i32, lib_lo:i32, lib_hi:i32, tag:[]u8, bspec:[]u8, ulog:[]u8, g0fd:i64, g0inv:i32)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  set32(ulog, 0, 0);
  set32(ulog, 4, 0);
  let nterms:i32=8;
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  if(use_lib==1){
    let ln:i32=node_new_libterm(st, nodes, sigtab, 8, lib_lo, lib_hi);
    bms(beam, 8, 0, ln);
    bms(beam, 8, 4, 0);
    bms(beam, 8, 8, 0);
    bms(beam, 8, 12, 0);
    nterms=9;
  }
  sts(st, 8, nterms);
  sts(st, 24, nterms);
  passive(st, fam, ev_x, ev_y, used);
  let hit_iv:i32=24;
  let hit:i32=0;
  // check after passive (0 interventions)
  beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, 0, ulog, g0fd, g0inv);
  let b0:i32=bmg(beam, 0, 0);
  let tc0:i32=true_correct(fam, nodes, b0);
  if(tc0>=61){ hit=1; hit_iv=0; }
  let r:i32=0;
  while(r<24){
    if(hit==1){ break; }
    let x:i32=select_iv_u(st, nodes, beam, bspec, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, r+1, ulog, g0fd, g0inv);
    let bn2:i32=bmg(beam, 0, 0);
    let tc:i32=true_correct(fam, nodes, bn2);
    if(tc>=61){
      hit=1;
      hit_iv=r+1;
    }
    r=r+1;
  }
  emit(tag); emit(" hit_iv="); e64(hit_iv);
  emit(" final_true="); e64(true_correct(fam, nodes, bmg(beam, 0, 0))); emit("/64\n");
  sts(st, 28, bmg(beam, 0, 0));
  emit("R3U "); emit(tag); emit(" MAXSIMS="); e64(get32(ulog, 0)); emit(" NODOMV="); e64(get32(ulog, 4)); emit("\n");
  return hit_iv;
}

// ============ main: Q4 R3, Arms 1-2 ============
fn main()void {
  emit("Q4-R3\n");
  let st:[]u8=z_alloc(32);
  let nodes:[]u8=z_alloc(8192*28);
  let sigtab:[]u8=z_alloc(16384*4);
  let beam:[]u8=z_alloc(32*16);
  let trace:[]u8=z_alloc(4096*20);
  let seen:[]u8=z_alloc(8192);
  let tmp:[]u8=z_alloc(3136*4);
  let tsc:[]u8=z_alloc(3136*12);
  let ev_x:[]u8=z_alloc(32*4);
  let ev_y:[]u8=z_alloc(32*4);
  let used:[]u8=z_alloc(64);
  let bspec:[]u8=z_alloc(32*4);
  let ulog:[]u8=z_alloc(8);
  // Frozen kept-D artifact: signature recomputed from the sealed
  // F-PARCOND definition, asserted against the prereg constants
  // lo = hi = 0x68686868 = 1751672936 (commit 5f56cc491, node 1105).
  let sigb:[]u8=z_alloc(8);
  d_sig(sigb);
  let dlo:i32=get32(sigb, 0);
  let dhi:i32=get32(sigb, 4);
  let dseal:i32=0;
  if(dlo==1751672936){
    if(dhi==1751672936){ dseal=1; }
  }
  emit("DSEAL "); e64(dseal);
  emit(" dlo="); e64(dlo); emit(" dhi="); e64(dhi); emit("\n");
  // D_10 padding check: identity wrappers (D AND 1), (w1 XOR 0),
  // (w2 AND 1) must preserve the signature behaviorally.
  let w1lo:i32=dlo & -1;
  let w1hi:i32=dhi & -1;
  let w2lo:i32=w1lo ^ 0;
  let w2hi:i32=w1hi ^ 0;
  let w3lo:i32=w2lo & -1;
  let w3hi:i32=w2hi & -1;
  let d10ok:i32=0;
  if(w3lo==dlo){
    if(w3hi==dhi){ d10ok=1; }
  }
  emit("D10_OK "); e64(d10ok); emit("\n");
  // G0: open the diagnostic log (file only, never stdout). Logging is
  // gated on the A2-REUSE invocation (index 2) inside beam_extend_u.
  let g0fd:i64=w_open("docs/lab/research-lead/overnight-20260928/beam_g0/g0q.log");
  if(dseal==0){
    emit("VOID: DSEAL mismatch, harness defect\n");
    emit("DONE\n");
    return;
  }
  // ---- Arm 1: C' = D_10 XOR X4 (fam 7), seed 710101 ----
  sts(st, 16, 710101);
  let a1r:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 1, dlo, dhi, "A1-REUSE", bspec, ulog, g0fd, 0);
  let a1r_best:i32=stg(st, 28);
  let a1r_true:i32=true_correct(7, nodes, a1r_best);
  sts(st, 16, 710101);
  let a1s:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 0, 0, 0, "A1-SCRATCH", bspec, ulog, g0fd, 1);
  let a1s_best:i32=stg(st, 28);
  let a1s_true:i32=true_correct(7, nodes, a1s_best);
  emit("A1 REUSE_IV "); e64(a1r); emit(" true="); e64(a1r_true); emit("/64\n");
  emit("A1 SCRATCH_IV "); e64(a1s); emit(" true="); e64(a1s_true); emit("/64\n");
  let a1pass:i32=0;
  if(a1r_true==64){
    if(a1r*2<=a1s){ a1pass=1; }
  }
  emit("A1-PASS "); e64(a1pass); emit("\n");
  // ---- Arm 2: E = (D AND Y4) OR ((NOT D) AND Y5) (fam 8), seed 710202 ----
  sts(st, 16, 710202);
  let a2r:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 1, dlo, dhi, "A2-REUSE", bspec, ulog, g0fd, 2);
  let a2r_best:i32=stg(st, 28);
  let a2r_true:i32=true_correct(8, nodes, a2r_best);
  let hasd:i32=has_d_subexpr(nodes, a2r_best, dlo, dhi);
  sts(st, 16, 710202);
  let a2s:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 0, 0, 0, "A2-SCRATCH", bspec, ulog, g0fd, 3);
  let a2s_best:i32=stg(st, 28);
  let a2s_true:i32=true_correct(8, nodes, a2s_best);
  emit("A2 REUSE_IV "); e64(a2r); emit(" true="); e64(a2r_true); emit("/64 HAS_D="); e64(hasd); emit("\n");
  emit("A2 SCRATCH_IV "); e64(a2s); emit(" true="); e64(a2s_true); emit("/64\n");
  let a2pass:i32=0;
  if(a2r_true==64){
    if(a2r*2<=a2s){
      if(hasd==1){ a2pass=1; }
    }
  }
  if(hasd==0){
    emit("F-R3-THIN FIRED: reuse solution lacks D as subexpression\n");
  }
  emit("A2-PASS "); e64(a2pass); emit("\n");
  let r3pass:i32=0;
  if(a1pass==1){
    if(a2pass==1){ r3pass=1; }
  }
  emit("R3-PASS "); e64(r3pass); emit("\n");
  emit("DONE\n");
  if(g0fd>=0){ w_close(g0fd); }
  return;
}

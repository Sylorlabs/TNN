  // to 3-char inputs. P1 has concept boost (cat/dog share concept),
  // P2 does not. P1 should win despite P2's recency.
  ntest=ntest+1;
  let cres:[]u8=z_alloc(12);
  intent_winner(W6,"dog",cres);
  let ckind:i32=get32(cres,0);
  let cslot:i32=get32(cres,4);

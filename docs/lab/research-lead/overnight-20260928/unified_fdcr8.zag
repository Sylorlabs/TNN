  handle_concept_learn(W6,"T dog | is_a | pet");
  // P1: reverse trained on cat (older, seq=0). "cat" has no repeat chars.
  let p1r:i32=handle_proc_learn_unified(W6,"cat>tac");
  // P2: broadcast trained on 3-char data (newer, seq=1). Same train_len=3
  // as P1, so concept boost (not len_match) decides the winner.
  let p2r:i32=handle_proc_learn_unified(W6,"abc>aaa;def>ddd");
  ntest=ntest+1;
  if(p1r>=0 && p1r<1000 && p2r>=0 && p2r<1000 && p1r!=p2r){
    emit("C-T2 setup: P1 slot ");

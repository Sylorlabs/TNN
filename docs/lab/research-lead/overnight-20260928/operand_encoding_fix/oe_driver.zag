// s6_driver.zag -- 5000-MAP scaling rerun with FI-hardened FACT index.
//
// Three build orders over identical worlds (65536 nodes, 131072 edges):
//   order 0 (D): query chains, 4990 broken plen-2 decoys, 5 real plen-5.
//   order 1 (R): query chains, 5 real plen-5, 4990 broken plen-2 decoys.
//   order 2 (I): query chains, then 5 rounds of (998 decoys + 1 real).
// Build mode is 5 (MAP index + FACT index), as in s5.
//
// Per world:
//   1. chain integrity check on the 5 real MAP graphs (diagnostic).
//   2. mode 0 (linear) queries on chains 0,1.
//   3. mode 1 (MAP index) queries on chains 2,3.
//   4. mode 3 (MAP index + MTF) queries on chains 4,5 (chain 5 uses the
//      MTF winner-first path written by chain 4).
//   5. FACT gather: chain 6 in mode 1 (linear FACT), chain 7 in mode 5
//      (indexed FACT). fcnt counts FACT lookup visits.
// Fresh chains per block avoid the activate short-circuit. Counters are
// zeroed before every query.
fn s6_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn s6_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn s6_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}
fn s6_setmode(W:[]u8,mode:i32)void {
  let ix:i32=idx_node(W);
  if(ix>=0){ns(W,ix,4,mode);}
  return;
}
// Chain integrity: walk MAP pm's graph root. Expect alternating
// tag 102/101 cells with literal values
// s0,s0+1,s0+1,s0+2,s0+2,s0+3,s0+3,s0+4. Returns 1 if exact.
fn s6_chaincheck(W:[]u8,pm:i32,s0:i32)i32 {
  if(pm<2 || pm>=65536){return 0;}
  let root:i32=ng(W,pm,20);
  let cur:i32=root;
  let exp:i32=s0;
  let exp102:i32=1;
  let steps:i32=0;
  let ok:i32=1;
  while(cur>=0 && steps<16 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){ if(tag!=102){ok=0;} }
    else { if(tag!=101){ok=0;} }
    let ln:i32=ng(W,cur,8);
    let lv:i32=-999999;
    if(ln>=2 && ln<65536){ lv=ng(W,ln,20); }
    if(lv!=exp){ok=0;}
    // literal sequence: s0,s0+1,s0+1,s0+2,s0+2,s0+3,s0+3,s0+4.
    // after a 102 cell the next literal increments; after a 101 it repeats.
    if(exp102==1){exp=exp+1;}
    if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    exp102=1-exp102;
    steps=steps+1;
  }
  if(steps!=8){ok=0;}
  return ok;
}
// Build one world. order: 0=D, 1=R, 2=I. pms gets the 5 real MAP ids.
// Returns build fails.
fn s6_build(W:[]u8,order:i32,pms:[]u8)i32 {
  let qi:i32=0;
  while(qi<8){
    let q:i32=80000+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  let fails:i32=0;
  let i:i32=0;
  if(order==0){
    i=0;
    while(i<4990){
      if(s6_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
      i=i+1;
    }
    i=0;
    while(i<5){
      let pm:i32=s6_mkchain(W,50000+i*10,5,51,50004+i*10);
      if(pm<0){fails=fails+1;}
      set32(pms,i*4,pm);
      i=i+1;
    }
  } else {
    if(order==1){
      i=0;
      while(i<5){
        let pm:i32=s6_mkchain(W,50000+i*10,5,51,50004+i*10);
        if(pm<0){fails=fails+1;}
        set32(pms,i*4,pm);
        i=i+1;
      }
      i=0;
      while(i<4990){
        if(s6_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
        i=i+1;
      }
    } else {
      let r:i32=0;
      while(r<5){
        i=0;
        while(i<998){
          let d:i32=r*998+i;
          if(s6_mkbroken(W,2000+d,51,2001+d)<0){fails=fails+1;}
          i=i+1;
        }
        let pm:i32=s6_mkchain(W,50000+r*10,5,51,50004+r*10);
        if(pm<0){fails=fails+1;}
        set32(pms,r*4,pm);
        r=r+1;
      }
    }
  }
  return fails;
}
// Query one chain in a mode; emit ans/tried/rejected/scan/fcnt/ok.
fn s6_query(W:[]u8,mode:i32,qi:i32,tag:[]u8)void {
  let q:i32=80000+qi*200;
  s6_setmode(W,mode);
  hs(W,16,0); hs(W,56,0); fcnt_zero(W);
  let b:i32=ev_query(W,q,50,q+104,0);
  let t:i32=hg(W,16);
  emit(tag); emit(" Q"); e64(qi);
  emit(" mode="); e64(mode);
  emit(" ans="); e64(b);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" fcnt="); e64(fcnt_get(W));
  emit(" ok="); e64(b==q+104); emit("\n");
  return;
}
fn s6_world(order:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=s6_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let pms:[]u8=z_alloc(20);
  let i:i32=0;
  while(i<5){set32(pms,i*4,-1); i=i+1;}
  let fails:i32=s6_build(W,order,pms);
  emit(tag); emit(" built fails="); e64(fails);
  emit(" build-walks="); e64(hg(W,60)); emit("\n");
  i=0;
  while(i<5){
    let pm:i32=get32(pms,i*4);
    let ck:i32=s6_chaincheck(W,pm,50000+i*10);
    emit(tag); emit(" chain"); e64(i); emit(" ok="); e64(ck); emit("\n");
    i=i+1;
  }
  s6_query(W,0,0,tag); s6_query(W,0,1,tag);
  s6_query(W,1,2,tag); s6_query(W,1,3,tag);
  s6_query(W,3,4,tag); s6_query(W,3,5,tag);
  s6_query(W,1,6,tag); s6_query(W,5,7,tag);
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("S6-START\n");
  s6_world(0,"S6D");
  s6_world(1,"S6R");
  s6_world(2,"S6I");
  emit("S6-END\n");
  return 0;
}

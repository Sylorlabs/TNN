// pc_gateb.zag -- ARM-GATEB: gate-bypass variant.
// Identical store to ARM-GATE, but the battery is driven through
// raw_link for every attempt: the gate is bypassed throughout.
// Predicted: cycles > 0 (the admissional honest boundary).
//
// Flat (parent, child) edge list; the read path is all recorded
// edges. compose_link runs an inline reachability gate: if C == P
// or C reaches P over recorded edges, the link is refused (-1);
// otherwise the edge is recorded. raw_link records with no check
// (the second channel; the honest boundary per FK 4.1).
//
// Vocabulary in this file is structural only, by the K4 no-wire
// audit.
//
// Layout in S: edge list at 8192 (512 records * 8: parent, child);
// list cursor at 12292.

fn arm_nd_init(S:[]u8,n:i32)void { return; }
fn edge_append(S:[]u8,p:i32,c:i32)void {
  let n:i32=get32(S,12292);
  if(n<512){
    set32(S,8192+n*8,p);
    set32(S,8192+n*8+4,c);
    set32(S,12292,n+1);
  }
  return;
}
fn store_app_edge(S:[]u8,p:i32,c:i32)void { edge_append(S,p,c); return; }
// reachability over recorded edges: 1 iff tgt is reachable from x.
fn g_reach(S:[]u8,x:i32,tgt:i32,vis:[]u8)i32 {
  if(x==tgt){ return 1; }
  if((vis[x] as i32)==1){ return 0; }
  vis[x]=1 as u8;
  let n:i32=get32(S,12292);
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==x){
      if(g_reach(S,get32(S,8192+i*8+4),tgt,vis)==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
// compose_link: gated. -1 = refused, 0 = recorded.
fn compose_link(S:[]u8,p:i32,c:i32)i32 {
  if(c==p){ return -1; }
  let vis:[]u8=z_alloc(64);
  if(g_reach(S,c,p,vis)==1){ return -1; }
  edge_append(S,p,c);
  return 0;
}
// raw_link: bypasses the gate.
fn raw_link(S:[]u8,p:i32,c:i32)void { edge_append(S,p,c); return; }
fn battery_link(S:[]u8,p:i32,c:i32)i32 { raw_link(S,p,c); return 0; }
// do_a8: GATEB drives the whole battery through raw_link,
// including A8.
fn do_a8()i32 { return 1; }
// ---- read path: all recorded edges ----
fn ndeps(S:[]u8,p:i32)i32 {
  let n:i32=get32(S,12292);
  let k:i32=0;
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){ k=k+1; }
    i=i+1;
  }
  return k;
}
fn dep_at(S:[]u8,p:i32,j:i32)i32 {
  let n:i32=get32(S,12292);
  let k:i32=0;
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){
      if(k==j){ return get32(S,8192+i*8+4); }
      k=k+1;
    }
    i=i+1;
  }
  return -1;
}
fn edge_present(S:[]u8,p:i32,c:i32)i32 {
  let n:i32=get32(S,12292);
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){
      if(get32(S,8192+i*8+4)==c){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn arm_name(b:[]u8,c:i32)i32 {
  b[c]=71; b[c+1]=65; b[c+2]=84; b[c+3]=69; b[c+4]=66; b[c+5]=10;
  return c+6;
}

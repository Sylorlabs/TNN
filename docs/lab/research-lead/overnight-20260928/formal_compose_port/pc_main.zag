// pc_main.zag -- FORMAL-COMPOSE-PORT main attach battery driver.
// Frozen battery order (PREREG section 3):
// build, V1 extend, V2 specialize, V3 graft, B1, A1..A7, A8, audit.
// Links against one arm file (pc_rep / pc_gate / pc_gateb /
// pc_list) which supplies the edge store.

fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let S:[]u8=z_alloc(65536);
  let A:[]u8=z_alloc(8192);
  world_build(S,A,0,0,0);
  let c:i32=get32(S,6000);
  let x:i32=get32(S,6004);
  let y:i32=get32(S,6008);
  let w:i32=get32(S,6012);
  let g:i32=get32(S,6016);
  let c2:i32=get32(S,6020);
  let x2:i32=get32(S,6024);
  let y2:i32=get32(S,6028);
  let ew:i32=get32(S,6040);
  // V1 EXTEND: attach the independently built extension leg root
  // ew (rank 2) under existing composite g (rank 3).
  let e_l:i32=battery_link(S,g,ew);
  let e_p:i32=edge_present(S,g,ew);
  let e_d:i32=demand(S,A,g);
  // V2 SPECIALIZE: attach binding const c (rank 0) under
  // existing item w (rank 2).
  let s_l:i32=battery_link(S,w,c);
  let s_p:i32=edge_present(S,w,c);
  let s_d:i32=demand(S,A,w);
  // V3 GRAFT: attach existing composite y2 (rank 2, structure Y)
  // under existing composite g (rank 3, structure X).
  let gr_l:i32=battery_link(S,g,y2);
  let gr_p:i32=edge_present(S,g,y2);
  let gr_d:i32=demand(S,A,g);
  // B1: boundary probe, cross-rank attach (acyclic, rank(x2) >= rank(x))
  let b1l:i32=battery_link(S,x,x2);
  let b1p:i32=edge_present(S,x,x2);
  // A1..A7: adversarial cycle-closing attach attempts
  let ref:i32=0;
  if(battery_link(S,x,g)!=0){ ref=ref+1; }
  if(battery_link(S,g,g)!=0){ ref=ref+1; }
  if(battery_link(S,y,g)!=0){ ref=ref+1; }
  if(battery_link(S,y2,g)!=0){ ref=ref+1; }
  if(battery_link(S,ew,ew)!=0){ ref=ref+1; }
  if(battery_link(S,c,y)!=0){ ref=ref+1; }
  if(battery_link(S,c2,c2)!=0){ ref=ref+1; }
  // A8: bypass probe, lowest-level writes with cycle-closing intent
  // (not run on GATE-inline per the frozen prereg)
  if(do_a8()==1){
    raw_link(S,x,g);
    raw_link(S,c,g);
  }
  let cyc:i32=audit_cycles(S);
  cur=e1str(OUT,cur,"PC-ARM ");
  cur=arm_name(OUT,cur);
  cur=e1str(OUT,cur,"PC-VALID ext_link=");
  cur=e1i64(OUT,cur,e_l as i64);
  cur=e1str(OUT,cur," ext_present=");
  cur=e1i64(OUT,cur,e_p as i64);
  cur=e1str(OUT,cur," ext_dem=");
  cur=e1i64(OUT,cur,e_d as i64);
  cur=e1str(OUT,cur," spec_link=");
  cur=e1i64(OUT,cur,s_l as i64);
  cur=e1str(OUT,cur," spec_present=");
  cur=e1i64(OUT,cur,s_p as i64);
  cur=e1str(OUT,cur," spec_dem=");
  cur=e1i64(OUT,cur,s_d as i64);
  cur=e1str(OUT,cur," graft_link=");
  cur=e1i64(OUT,cur,gr_l as i64);
  cur=e1str(OUT,cur," graft_present=");
  cur=e1i64(OUT,cur,gr_p as i64);
  cur=e1str(OUT,cur," graft_dem=");
  cur=e1i64(OUT,cur,gr_d as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"PC-ADV cycles=");
  cur=e1i64(OUT,cur,cyc as i64);
  cur=e1str(OUT,cur," refusals=");
  cur=e1i64(OUT,cur,ref as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"PC-BOUNDARY b1link=");
  cur=e1i64(OUT,cur,b1l as i64);
  cur=e1str(OUT,cur," b1present=");
  cur=e1i64(OUT,cur,b1p as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"PC-END");
  cur=e1nl(OUT,cur);
  _zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  return 0;
}

// pc_blind.zag -- FORMAL-COMPOSE-PORT blind battery (K4).
// Five world variants run as separate fresh processes per arm:
// V0 baseline; V1 relation numbers permuted; V2 subject ids
// permuted; V3 kind polarity swapped; V4 all three jointly.
// Each prints only the identifier-free summary line; the five
// lines must be byte-identical.

fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let v:i32=0;
  while(v<5){
    let vr:i32=0;
    let vn:i32=0;
    let vk:i32=0;
    if(v==1){ vr=1; }
    if(v==2){ vn=1; }
    if(v==3){ vk=1; }
    if(v==4){ vr=1; vn=1; vk=1; }
    let S:[]u8=z_alloc(65536);
    let A:[]u8=z_alloc(8192);
    world_build(S,A,vr,vn,vk);
    let c:i32=get32(S,6000);
    let x:i32=get32(S,6004);
    let y:i32=get32(S,6008);
    let w:i32=get32(S,6012);
    let g:i32=get32(S,6016);
    let c2:i32=get32(S,6020);
    let y2:i32=get32(S,6028);
    let ew:i32=get32(S,6040);
    let ans:i32=demand(S,A,g);
    // blind attach: graft y2 under g, then presence
    let gl:i32=battery_link(S,g,y2);
    let att:i32=edge_present(S,g,y2);
    if(gl!=0){ att=0; }
    let ref:i32=0;
    if(battery_link(S,x,g)!=0){ ref=ref+1; }
    if(battery_link(S,g,g)!=0){ ref=ref+1; }
    if(battery_link(S,y,g)!=0){ ref=ref+1; }
    if(battery_link(S,y2,g)!=0){ ref=ref+1; }
    if(battery_link(S,ew,ew)!=0){ ref=ref+1; }
    if(battery_link(S,c,y)!=0){ ref=ref+1; }
    if(battery_link(S,c2,c2)!=0){ ref=ref+1; }
    let cyc:i32=audit_cycles(S);
    cur=e1str(OUT,cur,"PC-BLIND V");
    cur=e1i64(OUT,cur,v as i64);
    cur=e1str(OUT,cur," ANS=");
    cur=e1i64(OUT,cur,ans as i64);
    cur=e1str(OUT,cur," CYCLES=");
    cur=e1i64(OUT,cur,cyc as i64);
    cur=e1str(OUT,cur," REFUSALS=");
    cur=e1i64(OUT,cur,ref as i64);
    cur=e1str(OUT,cur," ATT=");
    cur=e1i64(OUT,cur,att as i64);
    cur=e1nl(OUT,cur);
    v=v+1;
  }
  _zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  return 0;
}

// rc_spec.zag -- SPEC-REGIME-CHANGE policy layer.
//
// Builds on SPEC-NOISY-RATES (frozen BUILD-PASS 8/8) without
// redesigning it: the same executable adaptive switch, the same EWMA
// rate estimator (alpha = 1/16, events/1024 ticks), the same
// confidence-interval margin test, the same flip rule
// (opposite-decisive intervals). The ONLY delta is the world: drift
// and query arrivals are NONSTATIONARY. Each episode has two regimes;
// ticks 0..127 use pre-shift parameters (M1, N1), ticks 128..255 use
// post-shift parameters (M2, N2). At t == 128 the fire thresholds
// swap once; the burst/quiet Markov states persist and the LCG
// sequences continue unreseeded: the same world, new parameters.
//
// Shared helpers (nr_max0, nr_maxi, nr_isqrt, nr_next, nr_thr_b,
// nr_thr_q, nr_decide, nr_snap, nr_polname) are byte-identical to
// the parent lane. New/changed: rc_seed_d/rc_seed_q (regime seeds),
// rc_track_flip (post-shift flip recording), rc_checkpoint (burn-in
// snapshots at e = 144/192 + flip tracking), rc_emit_cell (regime
// fields), rc_episode (regime thresholds, shift at t = 128,
// arrival-split counters).
//
// No world literals in this file: relation/object ids arrive via rb_*.
fn nr_max0(a:i32)i32 {
  if(a>0){ return a; }
  return 0;
}
fn nr_maxi(a:i32,b:i32)i32 {
  if(a>b){ return a; }
  return b;
}
// Integer Newton sqrt, fixed 12 iterations: deterministic.
fn nr_isqrt(n:i64)i64 {
  if(n<=0){ return 0; }
  let x:i64=n/2+1;
  let i:i32=0;
  while(i<12){
    x=(x+n/x)/2;
    i=i+1;
  }
  return x;
}
// LCG: s <- (s*1103515245 + 12345) mod 2^31. i64, mod hand-rolled.
fn nr_next(s:i64)i64 {
  let r:i64=s*1103515245+12345;
  let q:i64=r/2147483648;
  return r-q*2147483648;
}
// Burst fire threshold for mean rate 1/M: min(2^31, 5*2^31/(2M)).
fn nr_thr_b(M:i32)i64 {
  let C:i64=2147483648;
  let t:i64=(5*C)/(2*(M as i64));
  if(t>C){ return C; }
  return t;
}
// Quiet fire threshold: max(0, (4*2^31/M - thr_b)/3).
fn nr_thr_q(M:i32,tb:i64)i64 {
  let C:i64=2147483648;
  let t:i64=((4*C)/(M as i64)-tb)/3;
  if(t<0){ return 0; }
  return t;
}
// Regime seeds: frozen, reset per episode, identical across arms.
fn rc_seed_d(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*101+N1*17+M2*13+N2*7+17) as i64;
}
fn rc_seed_q(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*17+N1*101+M2*7+N2*13+917) as i64;
}
// Margin-test decision. Returns 2 = eager-decisive (L > phi, strict),
// 1 = lazy-decisive (L < plo, strict), 0 = undecided. phi >= plo
// always (price increasing in d, decreasing in q), so both cannot fire.
fn nr_decide(dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32,L:i32)i32 {
  let phin:i32=nr_max0(dhi-qlo);
  let phid:i32=nr_maxi(qlo,1);
  let plon:i32=nr_max0(dlo-qhi);
  let plod:i32=nr_maxi(qhi,1);
  let eg:i32=0;
  let lz:i32=0;
  if(L*phid>phin){ eg=1; }
  if(L*plod<plon){ lz=1; }
  if(eg==1){ return 2; }
  if(lz==1){ return 1; }
  return 0;
}
// Snapshot commit-time estimates and intervals into CS.
fn nr_snap(CS:[]u8,dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32)void {
  set32(CS,32,dh);
  set32(CS,36,qh);
  set32(CS,40,dlo);
  set32(CS,44,dhi);
  set32(CS,48,qlo);
  set32(CS,52,qhi);
  set32(CS,56,nr_max0(dh-qh));
  set32(CS,60,nr_maxi(qh,1));
  set32(CS,64,nr_max0(dlo-qhi));
  set32(CS,68,nr_maxi(qhi,1));
  set32(CS,72,nr_max0(dhi-qlo));
  set32(CS,76,nr_maxi(qlo,1));
  return;
}
// Record a post-shift flip: pflips++, first flip sets tf1/fdir,
// second sets tf2. Called only with e > 128.
fn rc_track_flip(CS:[]u8,e:i32,want:i32)void {
  set32(CS,104,get32(CS,104)+1);
  if(get32(CS,92)==0){
    set32(CS,92,e);
    let fd:i32=-1;
    if(want==1){ fd=1; }
    set32(CS,96,fd);
    return;
  }
  if(get32(CS,100)==0){ set32(CS,100,e); }
  return;
}
// Checkpoint logic. CS layout: parent slots 0..80, plus
// 84=dh144, 88=qh144 (EWMA at first post-shift checkpoint),
// 92=tf1, 96=fdir, 100=tf2, 104=pflips,
// 108=dh192, 112=qh192 (EWMA ~4 time constants post-shift).
// e = elapsed ticks.
fn rc_checkpoint(CS:[]u8,LA:[]u8,S:[]u8,A:[]u8,dh:i32,qh:i32,ed:i32,eq:i32,drifts:i32,queries:i32,L:i32,e:i32)void {
  if(e==144){
    set32(CS,84,dh);
    set32(CS,88,qh);
  }
  if(e==192){
    set32(CS,108,dh);
    set32(CS,112,qh);
  }
  let sed:i64=nr_isqrt((ed/31) as i64);
  let seq:i64=nr_isqrt((eq/31) as i64);
  let dlo:i32=nr_max0(dh-2*(sed as i32));
  let dhi:i32=dh+2*(sed as i32);
  let qlo:i32=nr_max0(qh-2*(seq as i32));
  let qhi:i32=qh+2*(seq as i32);
  let com:i32=get32(CS,0);
  if(com==0){
    if(e>128){ return; }
    let dec:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    if(dec==2){
      set32(CS,0,1);
      set32(CS,4,2);
      set32(CS,8,e);
      set32(CS,12,1);
      set32(CS,16,1);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      et_specialize_ret(LA,S,A,0,0);
      set32(CS,80,get32(CS,80)+1);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(dec==1){
      set32(CS,0,1);
      set32(CS,4,1);
      set32(CS,8,e);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(e==128){
      set32(CS,0,2);
      set32(CS,4,0);
      set32(CS,8,128);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    return;
  }
  if(com==1){
    let dec:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    let cur:i32=get32(CS,12);
    let want:i32=cur;
    if(dec==2){ want=1; }
    if(dec==1){ want=0; }
    if(want!=cur){
      set32(CS,12,want);
      set32(CS,16,want);
      set32(CS,20,get32(CS,20)+1);
      if(want==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
      let post:i32=0;
      if(e>128){ post=1; }
      if(post==1){ rc_track_flip(CS,e,want); }
    }
    return;
  }
  return;
}
fn nr_polname(B:[]u8,c:i32,pol:i32)i32 {
  if(pol==0){ c=o_app(B,c,"lazy"); }
  if(pol==1){ c=o_app(B,c,"eager"); }
  if(pol==2){ c=o_app(B,c,"adapt"); }
  return c;
}
fn rc_emit_cell(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,CS:[]u8,dpre:i32,qpre:i32,dr:i32,q:i32,od:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL R=");
  c=o_i64(B,c,R as i64);
  c=o_app(B,c," M=");
  c=o_i64(B,c,M1 as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N1 as i64);
  c=o_app(B,c," M2=");
  c=o_i64(B,c,M2 as i64);
  c=o_app(B,c," N2=");
  c=o_i64(B,c,N2 as i64);
  c=o_app(B,c," P=");
  c=nr_polname(B,c,pol);
  c=o_app(B,c," L=");
  c=o_i64(B,c,Lv as i64);
  c=o_app(B,c," C=1 tc=");
  c=o_i64(B,c,get32(CS,8) as i64);
  c=o_app(B,c," cm=");
  c=o_i64(B,c,get32(CS,4) as i64);
  c=o_app(B,c," Dc=");
  c=o_i64(B,c,get32(CS,24) as i64);
  c=o_app(B,c," Qc=");
  c=o_i64(B,c,get32(CS,28) as i64);
  c=o_app(B,c," dh=");
  c=o_i64(B,c,get32(CS,32) as i64);
  c=o_app(B,c," qh=");
  c=o_i64(B,c,get32(CS,36) as i64);
  c=o_app(B,c," dlo=");
  c=o_i64(B,c,get32(CS,40) as i64);
  c=o_app(B,c," dhi=");
  c=o_i64(B,c,get32(CS,44) as i64);
  c=o_app(B,c," qlo=");
  c=o_i64(B,c,get32(CS,48) as i64);
  c=o_app(B,c," qhi=");
  c=o_i64(B,c,get32(CS,52) as i64);
  c=o_app(B,c," pnum=");
  c=o_i64(B,c,get32(CS,56) as i64);
  c=o_app(B,c," pden=");
  c=o_i64(B,c,get32(CS,60) as i64);
  c=o_app(B,c," plon=");
  c=o_i64(B,c,get32(CS,64) as i64);
  c=o_app(B,c," plod=");
  c=o_i64(B,c,get32(CS,68) as i64);
  c=o_app(B,c," phin=");
  c=o_i64(B,c,get32(CS,72) as i64);
  c=o_app(B,c," phid=");
  c=o_i64(B,c,get32(CS,76) as i64);
  c=o_app(B,c," sel=");
  c=o_i64(B,c,get32(CS,16) as i64);
  c=o_app(B,c," flips=");
  c=o_i64(B,c,get32(CS,20) as i64);
  c=o_app(B,c," pflips=");
  c=o_i64(B,c,get32(CS,104) as i64);
  c=o_app(B,c," tf1=");
  c=o_i64(B,c,get32(CS,92) as i64);
  c=o_app(B,c," fdir=");
  c=o_i64(B,c,get32(CS,96) as i64);
  c=o_app(B,c," tf2=");
  c=o_i64(B,c,get32(CS,100) as i64);
  c=o_app(B,c," Dpre=");
  c=o_i64(B,c,dpre as i64);
  c=o_app(B,c," Qpre=");
  c=o_i64(B,c,qpre as i64);
  c=o_app(B,c," Dpost=");
  c=o_i64(B,c,(dr-dpre) as i64);
  c=o_app(B,c," Qpost=");
  c=o_i64(B,c,(q-qpre) as i64);
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," od=");
  c=o_i64(B,c,od as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(CS,80) as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,(od+get32(CS,80)) as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_app(B,c," dh144=");
  c=o_i64(B,c,get32(CS,84) as i64);
  c=o_app(B,c," qh144=");
  c=o_i64(B,c,get32(CS,88) as i64);
  c=o_app(B,c," dh192=");
  c=o_i64(B,c,get32(CS,108) as i64);
  c=o_app(B,c," qh192=");
  c=o_i64(B,c,get32(CS,112) as i64);
  c=o_nl(B,c);
  return c;
}
// One episode. pol 0 = fixed lazy, pol 1 = fixed eager (restamp on
// every drift), pol 2 = adaptive with EWMA + confidence-interval
// margin test (see rc_checkpoint). Regime shift at t = 128: fire
// thresholds swap from (M1,N1) to (M2,N2); Markov states persist,
// LCG sequences continue. acc packs deltas: 0 = on-demand rebuilds,
// 4 = answered, 8 = refusals, 12 = kb. CS packs commit state;
// CS+80 counts restamps (sync + per-drift); CS+84..112 hold regime
// instrumentation (see rc_checkpoint).
fn rc_episode(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,ra:i32,oa1:i32)i32 {
  let LA:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let CS:[]u8=z_alloc(128);
  let T:i32=256;
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(LA,ra);
  et_specialize_ret(LA,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  set32(CS,0,0);
  set32(CS,4,0);
  set32(CS,8,-1);
  set32(CS,12,pol);
  set32(CS,16,pol);
  set32(CS,20,0);
  set32(CS,24,0);
  set32(CS,28,0);
  set32(CS,32,0);
  set32(CS,36,0);
  set32(CS,40,0);
  set32(CS,44,0);
  set32(CS,48,0);
  set32(CS,52,0);
  set32(CS,56,0);
  set32(CS,60,1);
  set32(CS,64,0);
  set32(CS,68,1);
  set32(CS,72,0);
  set32(CS,76,1);
  set32(CS,80,0);
  set32(CS,84,0);
  set32(CS,88,0);
  set32(CS,92,0);
  set32(CS,96,0);
  set32(CS,100,0);
  set32(CS,104,0);
  set32(CS,108,0);
  set32(CS,112,0);
  if(pol==2){
    set32(CS,12,0);
    set32(CS,16,0);
  }
  let s1:i64=rc_seed_d(R,M1,N1,M2,N2);
  let s2:i64=rc_seed_q(R,M1,N1,M2,N2);
  let ds:i32=0;
  let qs:i32=0;
  let TPB:i64=nr_thr_b(M1);
  let TPQ:i64=nr_thr_q(M1,TPB);
  let TQB:i64=nr_thr_b(N1);
  let TQQ:i64=nr_thr_q(N1,TQB);
  let TPB2:i64=nr_thr_b(M2);
  let TPQ2:i64=nr_thr_q(M2,TPB2);
  let TQB2:i64=nr_thr_b(N2);
  let TQQ2:i64=nr_thr_q(N2,TQB2);
  let C31:i64=2147483648;
  let TSB:i64=C31/8;
  let TSQ:i64=C31/24;
  let dh:i32=0;
  let qh:i32=0;
  let ed:i32=0;
  let eq:i32=0;
  let drifts:i32=0;
  let queries:i32=0;
  let dpre:i32=0;
  let qpre:i32=0;
  let cpd:i32=32;
  let t:i32=0;
  while(t<T){
    if(t==128){
      TPB=TPB2;
      TPQ=TPQ2;
      TQB=TQB2;
      TQQ=TQQ2;
    }
    s1=nr_next(s1);
    let u1:i64=s1;
    let nds:i32=ds;
    if(ds==1 && u1<TSB){ nds=0; }
    if(ds==0 && u1<TSQ){ nds=1; }
    ds=nds;
    s1=nr_next(s1);
    let u2:i64=s1;
    let df:i32=0;
    if(ds==1 && u2<TPB){ df=1; }
    if(ds==0 && u2<TPQ){ df=1; }
    s2=nr_next(s2);
    let u3:i64=s2;
    let nqs:i32=qs;
    if(qs==1 && u3<TSB){ nqs=0; }
    if(qs==0 && u3<TSQ){ nqs=1; }
    qs=nqs;
    s2=nr_next(s2);
    let u4:i64=s2;
    let qf:i32=0;
    if(qs==1 && u4<TQB){ qf=1; }
    if(qs==0 && u4<TQQ){ qf=1; }
    let cur:i32=get32(CS,12);
    if(df==1){
      et_drift_unrelated(A);
      drifts=drifts+1;
      if(cur==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
    }
    if(qf==1){
      queries=queries+1;
      ld_query_default(LA,S,A,ra,oa1,K,OUT,OUTG,acc);
    }
    if(t<128){
      dpre=dpre+df;
      qpre=qpre+qf;
    }
    if(pol==2){
      let devd:i32=1024*df-dh;
      dh=(15*dh+1024*df)/16;
      ed=(15*ed+devd*devd)/16;
      let devq:i32=1024*qf-qh;
      qh=(15*qh+1024*qf)/16;
      eq=(15*eq+devq*devq)/16;
    }
    cpd=cpd-1;
    if(cpd==0){
      if(pol==2){
        rc_checkpoint(CS,LA,S,A,dh,qh,ed,eq,drifts,queries,Lv,t+1);
      }
      cpd=16;
    }
    t=t+1;
  }
  let od:i32=get32(acc,0);
  c=rc_emit_cell(B,c,R,M1,N1,M2,N2,pol,Lv,CS,dpre,qpre,drifts,queries,od,get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}

// rc_main.zag -- harness main for SPEC-REGIME-CHANGE.
// Sweeps 6 regime cells R0..R5 x 6 arms (fixed lazy, fixed eager,
// adaptive with L in {0,1,3,7}) = 36 episodes, each emitting one CELL
// line. Regime table (pre -> post):
//   R0: (4,4)->(4,4)     no-shift control
//   R1: (1,16)->(16,1)   lazy-world -> eager-world
//   R2: (16,1)->(1,16)   eager-world -> lazy-world
//   R3: (2,2)->(8,8)     rate change, price ~0 both regimes
//   R4: (2,16)->(2,16)   no-shift lazy-world control
//   R5: (16,1)->(16,1)   no-shift eager-world control
// Arrivals are bursty and irregular (seeded per cell, identical
// across arms, regime shift at tick 128); relation/object ids arrive
// via the rb_* accessors; no world literals appear here.
fn rc_m1(ri:i32)i32 {
  if(ri==0){ return 4; }
  if(ri==1){ return 1; }
  if(ri==2){ return 16; }
  if(ri==3){ return 2; }
  if(ri==4){ return 2; }
  return 16;
}
fn rc_n1(ri:i32)i32 {
  if(ri==0){ return 4; }
  if(ri==1){ return 16; }
  if(ri==2){ return 1; }
  if(ri==3){ return 2; }
  if(ri==4){ return 16; }
  return 1;
}
fn rc_m2(ri:i32)i32 {
  if(ri==0){ return 4; }
  if(ri==1){ return 16; }
  if(ri==2){ return 1; }
  if(ri==3){ return 8; }
  if(ri==4){ return 2; }
  return 16;
}
fn rc_n2(ri:i32)i32 {
  if(ri==0){ return 4; }
  if(ri==1){ return 1; }
  if(ri==2){ return 16; }
  if(ri==3){ return 8; }
  if(ri==4){ return 16; }
  return 1;
}
fn rc_L(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 3; }
  return 7;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let ri:i32=0;
  while(ri<6){
    let M1:i32=rc_m1(ri);
    let N1:i32=rc_n1(ri);
    let M2:i32=rc_m2(ri);
    let N2:i32=rc_n2(ri);
    c=rc_episode(B,c,ri,M1,N1,M2,N2,0,-1,ra,oa1);
    c=rc_episode(B,c,ri,M1,N1,M2,N2,1,-1,ra,oa1);
    let li:i32=0;
    while(li<4){
      c=rc_episode(B,c,ri,M1,N1,M2,N2,2,rc_L(li),ra,oa1);
      li=li+1;
    }
    ri=ri+1;
  }
  o_flush(B,c);
  return 0;
}

    c=o_app(B,c," S10=");
    c=o_i64(B,c,get32(G,pwe2+32) as i64);
    c=o_app(B,c," S30=");
    c=o_i64(B,c,get32(G,pwe2+36) as i64);
    c=o_app(B,c," S45=");
    c=o_i64(B,c,get32(G,pwe2+40) as i64);
    c=o_app(B,c," S60=");
    c=o_i64(B,c,get32(G,pwe2+44) as i64);
    c=o_app(B,c," S64=");
    c=o_i64(B,c,get32(G,pwe2+48) as i64);
    c=o_app(B,c," S65=");
    c=o_i64(B,c,get32(G,pwe2+52) as i64);
    c=o_app(B,c," S90=");
    c=o_i64(B,c,get32(G,pwe2+56) as i64);
    c=o_app(B,c," S120=");
    c=o_i64(B,c,get32(G,pwe2+60) as i64);
    c=o_app(B,c," S125=");
    c=o_i64(B,c,get32(G,pwe2+64) as i64);
    c=o_app(B,c," SL=");
    c=o_i64(B,c,get32(G,pwe2+68) as i64);
    c=o_nl(B,c);
    pwi=pwi+1;
  }
  o_flush(B,c);
  return 0;
}

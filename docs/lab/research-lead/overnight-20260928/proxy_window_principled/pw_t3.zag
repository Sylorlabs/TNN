// pw_t3.zag -- PROXY-WINDOW-PRINCIPLED: window-sweep on pr_t3.zag
// (PROXY-REDESIGN). Tests whether the 60-episode dormancy window in
// redun3's (D) gate is principled: window-parameterized shadow twin
// redun3w + max-margin learned window pw_learn, both write-only.
// redun3 itself is UNTOUCHED (per task constraint). Builder:
// PROXY-WINDOW-PRINCIPLED worker, frozen PREREG.md committed before
// implementation. Lane: this directory.
// pr_t4.zag -- PROXY-REDESIGN frozen binary: K=3 closed loop (as
// MA4C-MULTISTREAM) plus write-only redun3 (structural
// interchangeability proxy) audit. Builder: PROXY-REDESIGN worker,
// frozen PREREG.md committed before implementation. Lane: this
// directory. TWO changes vs ms_w6.zag: (1) runner-up tallies
// rucov[16]/ruw[16] (write-only); (2) redun3 + PX audit
// (write-only; redun3 NEVER drives a reseed). The K=3 mechanism,
// triggers, reseeds, and all other audits are untouched.


// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access (u8-backed cells) ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- arena layout ----
// 0 prng(8) | 8 pX[732](2928) | 2936 pY[720](2880) | 5816 pZ[732](2928) |
// 8744 pW[852](3408) | 12152 fX[878400] | 890552 fY[864000] |
// 1754552 fZ[878400] | 2632952 fW[1022400] |
// 3655352 eX[732](2928) | 3658280 eY[720](2880) | 3661160 eZ[732](2928) |
// 3664088 eW[852](3408) |
// 3667496 mXa[732](2928) | 3670424 mYa[720](2880) | 3673304 mZ[732](2928) |
// 3676232 mWa[852](3408) |
// 3679640 genfail(4) | 3679644 tmp9(36) | 3679680 tmp3(12) |
// 3679692 tmp9r(36) | 3679728 tmp9b(36) |
// 3679764 cellsX(88) | 3679852 cellsY(88) | 3679940 cellsW(88) |
// 3680028 terr[4](16) |
// 3680044 tlogX[32](128) | 3680172 tlogY[32](128) | 3680300 tlogW[32](128) |
// 3680428 tproX[32](128) | 3680556 tproW[32](128) | 3680684 tproY[32](128) |
// 3680812 tflgX[32](128) | 3680940 tflgW[32](128) | 3681068 tflgY[32](128) |
// 3681196 declX(4) | 3681200 declY(4) | 3681204 declW(4) |
// 3681208 protdest(4) | 3681212 b5gok(4) |
// 3681216 snapXD(80) | 3681296 snapXR(80) | 3681376 snapXB(80) |
// 3681456 snapYR(80) | 3681536 snapYB(80) |
// 3681616 snapWD(80) | 3681696 snapWR(80) | 3681776 snapWB(80) |
// 3681856 snapWB4(80) | 3681936 snapWB5(80) |
// 3682016 tmp9c(36) | 3682052 tmp9d(36) |
// 3682088 redseedX(4) | 3682092 redseedY(4) | 3682096 redseedW(4) |
// 3682100 badred(4) | 3682104 tmp9w(36) | 3682140 tmp9wb(36) |
// 3682176 advkill(4) | 3682180 wblk[20](80): W per-cell per-block
// winner tallies, cell-major (cell*20+block*4), blocks 0=D,1=R,
// 2=B2,3=B4,4=B5; write-only harness audit, no cell-state feedback
// 3682260 wblkc[20](80): W per-cell per-block POST-RESEED winner
// tallies (current band), same layout; zeroed for cell v whenever
// v is reseeded (W only); write-only harness audit
// 3682340 advkill2(4) | 3682344 pair2n(4) |
// 3682348 pair2log[32](896): per W R-path reseed audit: ep, v,
// vcur, a0, a1, a2, a3 (28 bytes each); a<j> = anchor j curdom+1,
// 0 when j is not a qualifying anchor
// 3683244 xerr[16](64): per ordered pair (j,i) cumulative error of
// cell j on episodes won by cell i; write-only in this diagnostic
// 3683308 xcnt[16](64): per ordered pair (j,i) number of cell i wins
// witnessed by cell j current form; write-only in this diagnostic
// 3683372 proxyn(4) |
// 3683376 proxylog[32](896): per W trigger PROXYC audit entries, 28
// bytes each: ep, v, vkind, c0, c1, c2, c3 (c<vi> = redun2a(vi),
// 0 or anchor+1), computed pre-reseed; write-only harness audit
// 3684272 shadow_advkill2(4) |
// 3684276 shadowpair_n(4) |
// 3684280 shadowpair_log[32](896): write-only shadow: victim rule (b)
// with redun_old + current-band tripwire; 28 bytes each: ep, v,
// vcur, a0, a1, a2, a3
// 3685200 msn(4) |
// 3685204 mslog[32](2048): per W trigger (kind=0, pre-reseed) and per
// fixed probe (kind=1): ep, v, vkind, kind, nvalid, min VI/J,
// NUM/DEN (i64), K1..K5 bits; 64 bytes each; write-only harness audit
// 3687300 rucov[16](64): per ordered pair (j,i) runner-up tally:
// cell j was runner-up on cell i's wins; write-only for redun3
// 3687364 (64) unused (was ruw; removed)
// 3687432 pxn(4) |
// 3687436 pxlog[32](1536): per W trigger (kind=0, pre-reseed) and per
// fixed probe (kind=1): ep, v, vkind, px0..px3 (redun3 bits),
// ru32, ru23, dg2, lw2; 48 bytes each; write-only harness audit
// 3688972 lastwin[4](16): most recent win episode per cell (W only);
// write-only for redun3 dormancy
// 3689000 pwn(4) | 3689004 pwlog[32](2304): window-sweep audit, 72
// bytes each: ep, kind, W_learned, dg_sorted[4], sweep px2[10] for
// W in {5,10,30,45,60,64,65,90,120,125}, px2 at W_learned;
// write-only harness audit, no cell-state feedback
// cell: sum +0, n +16, score +32, consec +48, trgev +52, wpart +56, wpsm +72
// ---- episode values and flips (frozen harness) ----
fn gen(G:[]u8)void {
  s64(G,0,20261020);
  let t9:i32=3679644;
  let t3:i32=3679680;
  let t9r:i32=3679692;
  let t9b:i32=3679728;
  let t9c:i32=3682016;
  let t9d:i32=3682052;
  let i:i32=0;
  while(i<9){ set32(G,t9+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,t9+i*4);
    set32(G,t9+i*4,get32(G,t9+j*4));
    set32(G,t9+j*4,a);
    i=i+1;
  }
  set32(G,t3,40); set32(G,t3+4,47); set32(G,t3+8,54);
  i=0;
  while(i<3){
    let j2:i32=i+rnd(G,3-i);
    let a2:i32=get32(G,t3+i*4);
    set32(G,t3+i*4,get32(G,t3+j2*4));
    set32(G,t3+j2*4,a2);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9r+i*4,76+i); i=i+1; }
  i=0;
  while(i<9){
    let j3:i32=i+rnd(G,9-i);
    let a3:i32=get32(G,t9r+i*4);
    set32(G,t9r+i*4,get32(G,t9r+j3*4));
    set32(G,t9r+j3*4,a3);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9b+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j4:i32=i+rnd(G,9-i);
    let a4:i32=get32(G,t9b+i*4);
    set32(G,t9b+i*4,get32(G,t9b+j4*4));
    set32(G,t9b+j4*4,a4);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9c+i*4,78+i); i=i+1; }
  i=0;
  while(i<9){
    let j5:i32=i+rnd(G,9-i);
    let a5:i32=get32(G,t9c+i*4);
    set32(G,t9c+i*4,get32(G,t9c+j5*4));
    set32(G,t9c+j5*4,a5);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9d+i*4,46+i); i=i+1; }
  i=0;
  while(i<9){
    let j6:i32=i+rnd(G,9-i);
    let a6:i32=get32(G,t9d+i*4);
    set32(G,t9d+i*4,get32(G,t9d+j6*4));
    set32(G,t9d+j6*4,a6);
    i=i+1;
  }
  let t9w:i32=3682104;
  let t9wb:i32=3682140;
  i=0;
  while(i<9){ set32(G,t9w+i*4,73+i); i=i+1; }
  i=0;
  while(i<9){
    let j7:i32=i+rnd(G,9-i);
    let a7:i32=get32(G,t9w+i*4);
    set32(G,t9w+i*4,get32(G,t9w+j7*4));
    set32(G,t9w+j7*4,a7);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9wb+i*4,46+i); i=i+1; }
  i=0;
  while(i<9){
    let j8:i32=i+rnd(G,9-i);
    let a8:i32=get32(G,t9wb+i*4);
    set32(G,t9wb+i*4,get32(G,t9wb+j8*4));
    set32(G,t9wb+j8*4,a8);
    i=i+1;
  }
  // ---- multistream tile re-shuffle (W only): independent per-stream
  // permutation of the four W tile sets, preserving the designed
  // bands. Fresh s64 scope: X/Y/Z/D tiles untouched. TSEED stamped
  // per stream (T1=20261027 .. T4=20261030); W6 has no re-shuffle.
  s64(G,0,20261029);
  i=0;
  while(i<9){
    let u1:i32=i+rnd(G,9-i);
    let b1:i32=get32(G,t9w+i*4);
    set32(G,t9w+i*4,get32(G,t9w+u1*4));
    set32(G,t9w+u1*4,b1);
    i=i+1;
  }
  i=0;
  while(i<9){
    let u2:i32=i+rnd(G,9-i);
    let b2:i32=get32(G,t9wb+i*4);
    set32(G,t9wb+i*4,get32(G,t9wb+u2*4));
    set32(G,t9wb+u2*4,b2);
    i=i+1;
  }
  i=0;
  while(i<9){
    let u3:i32=i+rnd(G,9-i);
    let b3:i32=get32(G,t9c+i*4);
    set32(G,t9c+i*4,get32(G,t9c+u3*4));
    set32(G,t9c+u3*4,b3);
    i=i+1;
  }
  i=0;
  while(i<9){
    let u4:i32=i+rnd(G,9-i);
    let b4:i32=get32(G,t9d+i*4);
    set32(G,t9d+i*4,get32(G,t9d+u4*4));
    set32(G,t9d+u4*4,b4);
    i=i+1;
  }
  let s:i32=0;
  let e:i32=0;
  while(e<732){
    let v:i32=0;
    if(e<12){
      if(e==3){ v=get32(G,t3); }
      else {
        if(e==7){ v=get32(G,t3+4); }
        else {
          if(e==11){ v=get32(G,t3+8); }
          else { v=get32(G,t9+s*4); s=s+1; }
        }
      }
    }
    else {
      if(e<672){ v=get32(G,t9r+((e-12)%9)*4); }
      else { v=get32(G,t9b+((e-672)%9)*4); }
    }
    set32(G,8+e*4,v);
    set32(G,5816+e*4,v);
    e=e+1;
  }
  e=0;
  while(e<720){
    let v2:i32=0;
    if(e<660){ v2=get32(G,t9r+(e%9)*4); }
    else { v2=get32(G,t9b+((e-660)%9)*4); }
    set32(G,2936+e*4,v2);
    e=e+1;
  }
  let s2:i32=0;
  e=0;
  while(e<852){
    let v4:i32=0;
    if(e<12){
      if(e==3){ v4=get32(G,t3); }
      else {
        if(e==7){ v4=get32(G,t3+4); }
        else {
          if(e==11){ v4=get32(G,t3+8); }
          else { v4=get32(G,t9+s2*4); s2=s2+1; }
        }
      }
    }
    else {
      if(e<672){ v4=get32(G,t9w+((e-12)%9)*4); }
      else {
        if(e<732){ v4=get32(G,t9wb+((e-672)%9)*4); }
        else {
          if(e<792){ v4=get32(G,t9c+((e-732)%9)*4); }
          else { v4=get32(G,t9d+((e-792)%9)*4); }
        }
      }
    }
    set32(G,8744+e*4,v4);
    e=e+1;
  }
  s64(G,0,20261021);
  e=0;
  while(e<732){
    let pv:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<pv){ f=1; }
      G[12152+e*1200+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  s64(G,0,20261022);
  e=0;
  while(e<720){
    let pv2:i32=get32(G,2936+e*4);
    let k2:i32=0;
    while(k2<1200){
      let d2:i32=rnd(G,100);
      let f2:i32=0;
      if(d2<pv2){ f2=1; }
      G[890552+e*1200+k2]=f2 as u8;
      k2=k2+1;
    }
    e=e+1;
  }
  s64(G,0,20261023);
  e=0;
  while(e<732){
    let pv3:i32=get32(G,5816+e*4);
    let k3:i32=0;
    while(k3<1200){
      let d3:i32=rnd(G,100);
      let f3:i32=0;
      if(d3<pv3){ f3=1; }
      G[1754552+e*1200+k3]=f3 as u8;
      k3=k3+1;
    }
    e=e+1;
  }
  s64(G,0,20261026);
  e=0;
  while(e<852){
    let pv4:i32=get32(G,8744+e*4);
    let k4:i32=0;
    while(k4<1200){
      let d4:i32=rnd(G,100);
      let f4:i32=0;
      if(d4<pv4){ f4=1; }
      G[2632952+e*1200+k4]=f4 as u8;
      k4=k4+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode (frozen, as in MA1) ----
// m: current mean. Returns smallest n in 1..1200 with |est_n - p| < 5,
// else 1201. Exact integer comparison, no division.
fn etc_ep(G:[]u8,e:i32,m:i32,fbase:i32,pbase:i32)i32 {
  let mi:i64=m as i64;
  let pi:i64=get32(G,pbase+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=1200){
    h=h+(G[fbase+e*1200+n-1] as i64);
    let num:i64=20*mi+100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<5*den){ return n; }
    n=n+1;
  }
  return 1201;
}
// ---- protection predicate: shown explanatory success ----
// wpart: winner episodes; wpsm: summed winner error. Protected iff
// wpart >= 5 and mean winner error <= 10. From revealed values only.
fn prot(G:[]u8,cb:i32,i:i32)i32 {
  let wp:i32=get32(G,cb+56+i*4);
  if(wp>=5){
    let me:i32=get32(G,cb+72+i*4)/wp;
    if(me<=10){ return 1; }
  }
  return 0;
}
// ---- OLD redundancy predicate: duplicated explanatory success (researcher-supplied) ----
// Cell i is redundant iff it is protected and some other protected
// cell j has a mean within RDDM=10 of i's mean. KEPT ONLY for the
// write-only shadow; the real victim rule and logging use redun2a.
fn redun_old(G:[]u8,cb:i32,i:i32)i32 {
  let ri:i32=prot(G,cb,i);
  if(ri==0){ return 0; }
  let mi:i32=50;
  let ni:i32=get32(G,cb+16+i*4);
  if(ni>0){ mi=get32(G,cb+i*4)/ni; }
  let j:i32=0;
  while(j<4){
    let sk:i32=0;
    if(j!=i){ sk=1; }
    if(sk==1){
      let pj:i32=prot(G,cb,j);
      if(pj==1){
        let mj:i32=50;
        let nj:i32=get32(G,cb+16+j*4);
        if(nj>0){ mj=get32(G,cb+j*4)/nj; }
        let d:i32=mi-mj;
        if(d<0){ d=0-d; }
        if(d<=10){ return 1; }
      }
    }
    j=j+1;
  }
  return 0;
}
// ---- tally-driven redundancy proxy (frozen): redun2a ----
// Returns anchor index+1 if cell i is redundant, else 0. Cell i is
// redundant given protected cell j (j != i) iff ALL of:
// (G) j witnessed at least 5 of i's wins (PACT minimum evidence);
// (A) j has at least as many winner episodes as i (absorption
// toward greater evidence); (R) j mean error on shared wins is
// within 3x of i mean error on its wins (integer-exact means
// comparison, K=3 dimensionless). All inputs are self-measured
// from revealed values (xerr/xcnt/wpart/wpsm); no mean distance,
// no block labels, no researcher-supplied value threshold.
fn redun2a(G:[]u8,cb:i32,i:i32)i32 {
  let ri:i32=prot(G,cb,i);
  if(ri==0){ return 0; }
  let wpi:i32=get32(G,cb+56+i*4);
  let spi:i32=get32(G,cb+72+i*4);
  let j:i32=0;
  while(j<4){
    if(j!=i){
      let pj:i32=prot(G,cb,j);
      if(pj==1){
        let xc:i32=get32(G,3683308+(j*4+i)*4);
        if(xc>=5){
          let wpj:i32=get32(G,cb+56+j*4);
          if(wpj>=wpi){
            let xx:i32=get32(G,3683244+(j*4+i)*4);
            if(xx*wpi<=3*spi*xc){ return j+1; }
          }
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// ---- structural redundancy proxy (frozen): redun3 ----
// Returns anchor index+1 if cell i is redundant, else 0.
// Interventional interchangeability: removing i changes behavior
// only on i's win episodes (means update only on wins), so i is
// redundant given j iff j would have won i's episodes (j is
// runner-up there) AND i would have won j's episodes (i is
// runner-up there). One-way runner-up coverage is not enough: in
// the adversarial case cell 3 IS runner-up on cell 2's wins, yet
// cell 2 has a distinct active role. The structural gate is
// DORMANCY: i must have no current functional role (no wins in a
// full band-length, 60 episodes). A dormant cell cannot be killed;
// an active cell can.
// Conditions (all integer-exact, from revealed values only):
// (G) prot(i)=1, prot(j)=1, j!=i (established cells);
// (D) e-lastwin[i] > 60 (i dormant; lastwin[4] at 3688972);
// (A) wpart[j]>=wpart[i] (absorption toward greater evidence);
// (C) rucov[j][i]>=5 and rucov[i][j]>=5 (MUTUAL runner-up
// evidence; PACT minimum, mirroring the old PACT gate).
// No error magnitudes, no mean distance, no block labels,
// no threshold on any ratio.
fn redun3(G:[]u8,cb:i32,i:i32,e:i32)i32 {
  let ri:i32=prot(G,cb,i);
  if(ri==0){ return 0; }
  let lw:i32=get32(G,3688972+i*4);
  if(e-lw<=60){ return 0; }
  let wpi:i32=get32(G,cb+56+i*4);
  let j:i32=0;
  while(j<4){
    if(j!=i){
      let pj:i32=prot(G,cb,j);
      if(pj==1){
        let cij:i32=get32(G,3687300+(j*4+i)*4);
        let cji:i32=get32(G,3687300+(i*4+j)*4);
        if(cij>=5){
          if(cji>=5){
            let wpj:i32=get32(G,cb+56+j*4);
            if(wpj>=wpi){ return j+1; }
          }
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// ---- window-parameterized twin of redun3 (harness-side, write-only) ----
// Byte-identical body to redun3, except the (D) dormancy gate uses the
// window W as a parameter instead of the literal 60. redun3 itself is
// untouched (per task constraint). Measures what the proxy WOULD output
// at window W, end to end ((G)/(D)/(A)/(C)), on identical state: the
// sweep is pure sensitivity, no feedback into the loop.
fn redun3w(G:[]u8,cb:i32,i:i32,e:i32,W:i32)i32 {
  let ri:i32=prot(G,cb,i);
  if(ri==0){ return 0; }
  let lw:i32=get32(G,3688972+i*4);
  if(e-lw<=W){ return 0; }
  let wpi:i32=get32(G,cb+56+i*4);
  let j:i32=0;
  while(j<4){
    if(j!=i){
      let pj:i32=prot(G,cb,j);
      if(pj==1){
        let cij:i32=get32(G,3687300+(j*4+i)*4);
        let cji:i32=get32(G,3687300+(i*4+j)*4);
        if(cij>=5){
          if(cji>=5){
            let wpj:i32=get32(G,cb+56+j*4);
            if(wpj>=wpi){ return j+1; }
          }
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// ---- max-margin dormancy window from win recency (harness-side) ----
// Learns the window from data instead of inheriting 60: dg_i =
// e - lastwin[i] for i=0..3, sorted ascending; W = midpoint of the
// largest gap between consecutive values (ties -> first/lowest gap).
// The gap separates cells with a current functional role (recent
// wins) from dormant cells. Write-only; no feedback into cell state.
fn pw_learn(G:[]u8,cb:i32,e:i32)i32 {
  let d0:i32=e-get32(G,3688972);
  let d1:i32=e-get32(G,3688972+4);
  let d2:i32=e-get32(G,3688972+8);
  let d3:i32=e-get32(G,3688972+12);
  let t:i32=0;
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  if(d1>d2){ t=d1; d1=d2; d2=t; }
  if(d2>d3){ t=d2; d2=d3; d3=t; }
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  if(d1>d2){ t=d1; d1=d2; d2=t; }
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  let g0:i32=d1-d0;
  let g1:i32=d2-d1;
  let g2:i32=d3-d2;
  let lo:i32=d0;
  let hi:i32=d1;
  let bg:i32=g0;
  if(g1>bg){ bg=g1; lo=d1; hi=d2; }
  if(g2>bg){ bg=g2; lo=d2; hi=d3; }
  let wl:i32=(lo+hi)/2;
  return wl;
}
// ---- multistream audit (write-only): proxy firing semantics at one W decision point ----
// Evaluates redun2a's exact firing rule over all valid (i,j) pairs:
// prot(j)=1, j!=i, xcnt[j][i]>=5, wpart[j]>=wpart[i]. Records nvalid,
// the min-ratio pair (num=xerr[j][i]*wpart[i], den=wpsm[i]*xcnt[j][i]
// as i64; (0,0) reads as 0, (num>0,0) reads as +inf), and K-bits
// K=1..5 where bit K = 1 iff some valid pair has num <= K*den. The
// K-bits are exactly the proxy's firing condition (firing is
// existential over pairs, monotone in K). kind: 0 = trigger
// (pre-reseed), 1 = fixed-episode probe. Writes only to the mslog
// region; no cell state is touched.
fn ms_eval(G:[]u8,cb:i32,e1:i32,vv:i32,vk:i32,idx:i32,kind:i32)void {
  let mse:i32=3685204+idx*64;
  set32(G,mse,e1);
  set32(G,mse+4,vv);
  set32(G,mse+8,vk);
  set32(G,mse+60,kind);
  let nv:i32=0;
  let have:i32=0;
  let bvi:i32=-1;
  let bvj:i32=-1;
  let bnum:i64=0;
  let bden:i64=1;
  let k1:i32=0;
  let k2:i32=0;
  let k3:i32=0;
  let k4:i32=0;
  let k5:i32=0;
  let mi:i32=0;
  while(mi<4){
    let mwp:i32=get32(G,cb+56+mi*4);
    let msp:i32=get32(G,cb+72+mi*4);
    let mj:i32=0;
    while(mj<4){
      let ok:i32=0;
      if(mj!=mi){ ok=1; }
      let pj:i32=prot(G,cb,mj);
      if(ok==1){ if(pj!=1){ ok=0; } }
      let mxc:i32=0;
      if(ok==1){
        mxc=get32(G,3683308+(mj*4+mi)*4);
        if(mxc<5){ ok=0; }
      }
      let mwpj:i32=0;
      if(ok==1){
        mwpj=get32(G,cb+56+mj*4);
        if(mwpj<mwp){ ok=0; }
      }
      if(ok==1){
        nv=nv+1;
        let mxx:i32=get32(G,3683244+(mj*4+mi)*4);
        let nn:i64=(mxx as i64)*(mwp as i64);
        let dd:i64=(msp as i64)*(mxc as i64);
        if(nn<=dd){ k1=1; }
        if(nn<=(2 as i64)*dd){ k2=1; }
        if(nn<=(3 as i64)*dd){ k3=1; }
        if(nn<=(4 as i64)*dd){ k4=1; }
        if(nn<=(5 as i64)*dd){ k5=1; }
        let isinf:i32=0;
        if(dd==0){ if(nn>0){ isinf=1; } }
        let bisinf:i32=0;
        if(bden==0){ if(bnum>0){ bisinf=1; } }
        let take:i32=0;
        if(have==0){ take=1; }
        else {
          if(bisinf==1){ if(isinf==0){ take=1; } }
          else {
            if(isinf==0){
              if(nn*bden<bnum*dd){ take=1; }
            }
          }
        }
        if(take==1){
          have=1;
          bvi=mi;
          bvj=mj;
          bnum=nn;
          bden=dd;
        }
      }
      mj=mj+1;
    }
    mi=mi+1;
  }
  set32(G,mse+12,nv);
  set32(G,mse+16,bvi);
  set32(G,mse+20,bvj);
  s64(G,mse+24,bnum);
  s64(G,mse+32,bden);
  set32(G,mse+40,k1);
  set32(G,mse+44,k2);
  set32(G,mse+48,k3);
  set32(G,mse+52,k4);
  set32(G,mse+56,k5);
  return;
}
// ---- PX audit (write-only): redun3 firing at one W decision point ----
// Records ep, v, vkind, kind, px0..px3 (redun3(i) for i=0..3),
// ru32=rucov[3][2], ru23=rucov[2][3], dg2=e-lastwin[2] (dormancy gap).
// 48 bytes per record (12 i32s). Arena: pxn at 3687432, pxlog[32]
// at 3687436. Write-only; redun3 never drives a reseed.
fn px_eval(G:[]u8,cb:i32,e1:i32,vv:i32,vk:i32,idx:i32,kind:i32,e:i32)void {
  let pxe:i32=3687436+idx*48;
  set32(G,pxe,e1);
  set32(G,pxe+4,vv);
  set32(G,pxe+8,vk);
  set32(G,pxe+12,redun3(G,cb,0,e));
  set32(G,pxe+16,redun3(G,cb,1,e));
  set32(G,pxe+20,redun3(G,cb,2,e));
  set32(G,pxe+24,redun3(G,cb,3,e));
  set32(G,pxe+28,get32(G,3687300+(3*4+2)*4));
  set32(G,pxe+32,get32(G,3687300+(2*4+3)*4));
  set32(G,pxe+36,e-get32(G,3688972+2*4));
  set32(G,pxe+40,get32(G,3688972+2*4));
  set32(G,pxe+44,kind);
  return;
}
// ---- window-sweep audit (harness-side, write-only) ----
// At each PX audit point, evaluates redun3w for cell 2 across the
// frozen sweep set S={5,10,30,45,60,64,65,90,120,125} plus the
// max-margin learned window. Records ep, kind, sorted win-recency
// gaps (auditable input to pw_learn), W_learned, the 10 sweep px2
// values, and px2 at W_learned. 72 bytes per record at pwlog.
// Write-only; no feedback into cell state or loop decisions.
fn pw_eval(G:[]u8,cb:i32,e1:i32,kind:i32,e:i32,idx:i32)void {
  let pwe:i32=3689004+idx*72;
  set32(G,pwe,e1);
  set32(G,pwe+4,kind);
  let d0:i32=e-get32(G,3688972);
  let d1:i32=e-get32(G,3688972+4);
  let d2:i32=e-get32(G,3688972+8);
  let d3:i32=e-get32(G,3688972+12);
  let t:i32=0;
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  if(d1>d2){ t=d1; d1=d2; d2=t; }
  if(d2>d3){ t=d2; d2=d3; d3=t; }
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  if(d1>d2){ t=d1; d1=d2; d2=t; }
  if(d0>d1){ t=d0; d0=d1; d1=t; }
  set32(G,pwe+12,d0);
  set32(G,pwe+16,d1);
  set32(G,pwe+20,d2);
  set32(G,pwe+24,d3);
  let wl:i32=pw_learn(G,cb,e);
  set32(G,pwe+8,wl);
  set32(G,pwe+28,redun3w(G,cb,2,e,5));
  set32(G,pwe+32,redun3w(G,cb,2,e,10));
  set32(G,pwe+36,redun3w(G,cb,2,e,30));
  set32(G,pwe+40,redun3w(G,cb,2,e,45));
  set32(G,pwe+44,redun3w(G,cb,2,e,60));
  set32(G,pwe+48,redun3w(G,cb,2,e,64));
  set32(G,pwe+52,redun3w(G,cb,2,e,65));
  set32(G,pwe+56,redun3w(G,cb,2,e,90));
  set32(G,pwe+60,redun3w(G,cb,2,e,120));
  set32(G,pwe+64,redun3w(G,cb,2,e,125));
  set32(G,pwe+68,redun3w(G,cb,2,e,wl));
  return;
}
// ---- write-only shadow (harness-side): old-proxy victim rule (b) + current-band tripwire ----
// Replicates victim selection path (b) using redun_old, then runs
// advpair2 on the shadow victim. Updates shadow_advkill2 and the
// shadowpair log only; no feedback into cell state. Called at each W
// trigger where the real decision used the proxy (vkind==1) or
// declined (v<0): proves MA4b's detector still sees the kill pattern
// the old proxy would have committed.
fn shadow_eval(G:[]u8,cb:i32,a:i32,w:i32,e:i32)void {
  let shv:i32=-1;
  let svi:i32=3;
  while(svi>=0){
    let scand:i32=0;
    if(svi!=a){ scand=1; }
    if(scand==1){ if(svi==w){ scand=0; } }
    let srd:i32=0;
    if(scand==1){ if(redun_old(G,cb,svi)!=0){ srd=1; } }
    if(srd==1){
      let take:i32=0;
      if(shv<0){ take=1; }
      else {
        let p1:i32=get32(G,cb+56+svi*4);
        let p2:i32=get32(G,cb+56+shv*4);
        if(p1<p2){ take=1; }
        if(p1==p2){
          let t1:i32=get32(G,cb+32+svi*4);
          let t2:i32=get32(G,cb+32+shv*4);
          if(t1>t2){ take=1; }
          if(t1==t2){ if(svi>shv){ take=1; } }
        }
      }
      if(take==1){ shv=svi; }
    }
    svi=svi-1;
  }
  if(shv>=0){
    let shcur:i32=curdom(G,shv);
    let shadv:i32=0;
    let sa0:i32=0; let sa1:i32=0; let sa2:i32=0; let sa3:i32=0;
    let sj:i32=0;
    while(sj<4){
      if(advpair2(G,cb,shv,sj,shcur)==1){
        shadv=1;
        let jc:i32=curdom(G,sj)+1;
        if(sj==0){ sa0=jc; }
        if(sj==1){ sa1=jc; }
        if(sj==2){ sa2=jc; }
        if(sj==3){ sa3=jc; }
      }
      sj=sj+1;
    }
    if(shadv==1){ set32(G,3684272,get32(G,3684272)+1); }
    let spn:i32=get32(G,3684276);
    if(spn<32){
      let spe:i32=3684280+spn*28;
      set32(G,spe,e+1);
      set32(G,spe+4,shv);
      set32(G,spe+8,shcur);
      set32(G,spe+12,sa0);
      set32(G,spe+16,sa1);
      set32(G,spe+20,sa2);
      set32(G,spe+24,sa3);
      set32(G,3684276,spn+1);
    }
  }
  return;
}
// ---- dominant block of a W cell (harness-side, write-only) ----
// Argmax over the 5 per-block winner tallies; ties -> lower index.
// No feedback into cell state.
fn domblk(G:[]u8,v:i32)i32 {
  let d:i32=0;
  let best:i32=get32(G,3682180+v*20);
  let b:i32=1;
  while(b<5){
    let c:i32=get32(G,3682180+v*20+b*4);
    if(c>best){ best=c; d=b; }
    b=b+1;
  }
  return d;
}
// ---- current-band dominant block (harness-side, write-only) ----
// Argmax over the post-reseed per-block winner tallies; ties ->
// lower index. A cell's current band is what it has won most
// since its last reseed. Never-reseeded cells hold their lifetime
// tallies in wblkc (identical to wblk until the first reseed),
// which is correct: with no reseed boundary, the whole history
// is the current band. No feedback into cell state.
fn curdom(G:[]u8,v:i32)i32 {
  let d:i32=0;
  let best:i32=get32(G,3682260+v*20);
  let b:i32=1;
  while(b<5){
    let c:i32=get32(G,3682260+v*20+b*4);
    if(c>best){ best=c; d=b; }
    b=b+1;
  }
  return d;
}
// ---- adversarial pair check (harness-side, write-only) ----
// Returns 1 iff j is a protected anchor for victim v
// (|mean_v - mean_j| <= RDDM) and the victim/anchor
// dominant-block pair is {R(1), B4(3)}: the proxy paired two
// genuinely distinct value bands. No feedback into cell state.
fn advpair(G:[]u8,cb:i32,v:i32,j:i32,vdom:i32)i32 {
  if(j==v){ return 0; }
  let pj:i32=prot(G,cb,j);
  if(pj==0){ return 0; }
  let mv:i32=50;
  let nv:i32=get32(G,cb+16+v*4);
  if(nv>0){ mv=get32(G,cb+v*4)/nv; }
  let mj:i32=50;
  let nj:i32=get32(G,cb+16+j*4);
  if(nj>0){ mj=get32(G,cb+j*4)/nj; }
  let dd:i32=mv-mj;
  if(dd<0){ dd=0-dd; }
  if(dd>10){ return 0; }
  let jdom:i32=domblk(G,j);
  if(vdom==1){
    if(jdom==3){ return 1; }
  }
  if(vdom==3){
    if(jdom==1){ return 1; }
  }
  return 0;
}
// ---- current-band pair check (harness-side, write-only) ----
// Returns 1 iff j is a protected anchor for victim v
// (|mean_v - mean_j| <= RDDM) and the victim/anchor
// current-band pair is {band 1, band 3}: the proxy paired two
// genuinely distinct value bands. Band identity comes from
// curdom (post-reseed tallies), not lifetime. No feedback into
// cell state.
fn advpair2(G:[]u8,cb:i32,v:i32,j:i32,vcur:i32)i32 {
  if(j==v){ return 0; }
  let pj:i32=prot(G,cb,j);
  if(pj==0){ return 0; }
  let mv:i32=50;
  let nv:i32=get32(G,cb+16+v*4);
  if(nv>0){ mv=get32(G,cb+v*4)/nv; }
  let mj:i32=50;
  let nj:i32=get32(G,cb+16+j*4);
  if(nj>0){ mj=get32(G,cb+j*4)/nj; }
  let dd:i32=mv-mj;
  if(dd<0){ dd=0-dd; }
  if(dd>10){ return 0; }
  let jcur:i32=curdom(G,j);
  if(vcur==1){
    if(jcur==3){ return 1; }
  }
  if(vcur==3){
    if(jcur==1){ return 1; }
  }
  return 0;
}
// ---- snapshot 4 cells: sums, ns, scores, wpart, wpsm ----
fn snap(G:[]u8,cb:i32,sb:i32)void {
  let i:i32=0;
  while(i<4){
    set32(G,sb+i*4,get32(G,cb+i*4));
    set32(G,sb+16+i*4,get32(G,cb+16+i*4));
    set32(G,sb+32+i*4,get32(G,cb+32+i*4));
    set32(G,sb+48+i*4,get32(G,cb+56+i*4));
    set32(G,sb+64+i*4,get32(G,cb+72+i*4));
    i=i+1;
  }
  return;
}
// ---- multi-cell condition ----
// cb: cell base. cond: 0=Y (R+B2), 1=X (D+R+B2), 2=W5 (D+R+B2+B4+B5).
// tlog/tpro/tflg: per trigger evaluation: episode, victim (99=declined,
// v=unprotected path, v+10=redundancy path, v+20=tripwire), protection
// bitmask. decloff/redseedoff: decline / redundancy-reseed tallies.
// badredoff: tripwire tally for non-redundant redundancy victims.
fn run_multi(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,cb:i32,snapD:i32,snapR:i32,snapB:i32,snapB4:i32,snapB5:i32,tlog:i32,tpro:i32,tflg:i32,decloff:i32,redseedoff:i32,badredoff:i32,ne:i32,cond:i32)void {
  let e:i32=0;
  while(e<ne){
    let a:i32=0;
    let bi:i32=1;
    while(bi<4){
      if(get32(G,cb+32+bi*4)<get32(G,cb+32+a*4)){ a=bi; }
      bi=bi+1;
    }
    let m:i32=50;
    let an:i32=get32(G,cb+16+a*4);
    if(an>0){ m=get32(G,cb+a*4)/an; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    let vs:i32=get32(G,pbase+e*4);
    let w:i32=0;
    let erra:i32=0;
    let ei:i32=0;
    while(ei<4){
      let pr:i32=50;
      let cn:i32=get32(G,cb+16+ei*4);
      if(cn>0){ pr=get32(G,cb+ei*4)/cn; }
      let er:i32=pr-vs;
      if(er<0){ er=0-er; }
      set32(G,3680028+ei*4,er);
      let sc:i32=get32(G,cb+32+ei*4);
      set32(G,cb+32+ei*4,(3*sc+er)/4);
      if(ei==0){ w=0; }
      else {
        if(er<get32(G,3680028+w*4)){ w=ei; }
      }
      if(ei==a){ erra=er; }
      ei=ei+1;
    }
    let qxj:i32=0;
    while(qxj<4){
      let qxe:i32=3683244+(qxj*4+w)*4;
      set32(G,qxe,get32(G,qxe)+get32(G,3680028+qxj*4));
      let qxn:i32=3683308+(qxj*4+w)*4;
      set32(G,qxn,get32(G,qxn)+1);
      qxj=qxj+1;
    }
    // ---- redun3 tallies (write-only for the proxy; W only) ----
    // runner-up: min error among k!=w, ties to lower index (same
    // tie-break as winner). rucov[j][i]++ when winner==i and
    // runner-up==j. lastwin[i]=e when winner==i.
    // Arena: rucov[16] at 3687300, lastwin[4] at 3688972.
    if(cond==2){
      let ru:i32=-1;
      let rk:i32=0;
      while(rk<4){
        if(rk!=w){
          if(ru<0){ ru=rk; }
          else {
            if(get32(G,3680028+rk*4)<get32(G,3680028+ru*4)){ ru=rk; }
          }
        }
        rk=rk+1;
      }
      let ro:i32=3687300+(ru*4+w)*4;
      set32(G,ro,get32(G,ro)+1);
      set32(G,3688972+w*4,e);
    }
    set32(G,cb+w*4,get32(G,cb+w*4)+vs);
    set32(G,cb+16+w*4,get32(G,cb+16+w*4)+1);
    set32(G,cb+56+w*4,get32(G,cb+56+w*4)+1);
    set32(G,cb+72+w*4,get32(G,cb+72+w*4)+get32(G,3680028+w*4));
    if(cond==2){
      let blk:i32=4;
      if(e<12){ blk=0; }
      else {
        if(e<672){ blk=1; }
        else {
          if(e<732){ blk=2; }
          else {
            if(e<792){ blk=3; }
          }
        }
      }
      let wo:i32=3682180+w*20+blk*4;
      set32(G,wo,get32(G,wo)+1);
      let wc2:i32=3682260+w*20+blk*4;
      set32(G,wc2,get32(G,wc2)+1);
    }
    // ---- MS fixed-episode probes (W only, write-only): proxy evaluation
    // at the designed decision points, 0-indexed e=734 and e=794,
    // regardless of whether the trigger race fires there. vv=-2,
    // vk=9 mark probe records.
    if(cond==2){
      if(e==734){
        let msn3:i32=get32(G,3685200);
        if(msn3<32){
          ms_eval(G,cb,e+1,-2,9,msn3,1);
          set32(G,3685200,msn3+1);
        }
        let pxn3:i32=get32(G,3687432);
        if(pxn3<32){
          px_eval(G,cb,e+1,-2,9,pxn3,1,e);
          let pwn3:i32=get32(G,3689000);
          if(pwn3<32){
            pw_eval(G,cb,e+1,1,e,pwn3);
            set32(G,3689000,pwn3+1);
          }
          set32(G,3687432,pxn3+1);
        }
      }
      if(e==794){
        let msn5:i32=get32(G,3685200);
        if(msn5<32){
          ms_eval(G,cb,e+1,-2,9,msn5,1);
          set32(G,3685200,msn5+1);
        }
        let pxn5:i32=get32(G,3687432);
        if(pxn5<32){
          px_eval(G,cb,e+1,-2,9,pxn5,1,e);
          let pwn5:i32=get32(G,3689000);
          if(pwn5<32){
            pw_eval(G,cb,e+1,1,e,pwn5);
            set32(G,3689000,pwn5+1);
          }
          set32(G,3687432,pxn5+1);
        }
      }
    }
    let cc:i32=get32(G,cb+48);
    if(erra>20){ cc=cc+1; } else { cc=0; }
    if(cc>=3){
      let mask:i32=0;
      let mi:i32=0;
      while(mi<4){
        let mp:i32=prot(G,cb,mi);
        if(mp==1){ mask=mask+(1<<mi); }
        mi=mi+1;
      }
      let v:i32=-1;
      let vi:i32=3;
      while(vi>=0){
        let ok:i32=1;
        if(vi==a){ ok=0; }
        if(vi==w){ ok=0; }
        let vp:i32=prot(G,cb,vi);
        if(vp==1){ ok=0; }
        if(ok==1){
          if(v==-1){ v=vi; }
          else {
            let s1:i32=get32(G,cb+32+vi*4);
            let s2:i32=get32(G,cb+32+v*4);
            if(s1>s2){ v=vi; }
          }
        }
        vi=vi-1;
      }
      let vkind:i32=0;
      if(v<0){
        vi=3;
        while(vi>=0){
          let cand:i32=0;
          if(vi!=a){ cand=1; }
          if(cand==1){
            if(vi==w){ cand=0; }
          }
          let rd:i32=0;
          if(cand==1){ if(redun2a(G,cb,vi)!=0){ rd=1; } }
          if(rd==1){
            let take:i32=0;
            if(v<0){ take=1; }
            else {
              let p1:i32=get32(G,cb+56+vi*4);
              let p2:i32=get32(G,cb+56+v*4);
              if(p1<p2){ take=1; }
              if(p1==p2){
                let t1:i32=get32(G,cb+32+vi*4);
                let t2:i32=get32(G,cb+32+v*4);
                if(t1>t2){ take=1; }
                if(t1==t2){
                  if(vi>v){ take=1; }
                }
              }
            }
            if(take==1){ v=vi; }
          }
          vi=vi-1;
        }
        if(v>=0){ vkind=1; }
      }
      let tg:i32=get32(G,cb+52);
      let pv0:i32=0;
      if(v>=0){ pv0=prot(G,cb,v); }
      if(tg<32){
        set32(G,tlog+tg*4,e);
        set32(G,tflg+tg*4,mask);
        if(v<0){ set32(G,tpro+tg*4,99); }
        else {
          if(vkind==1){
            let rv:i32=redun2a(G,cb,v);
            if(rv==0){
              set32(G,badredoff,get32(G,badredoff)+1);
            }
            set32(G,tpro+tg*4,v+10);
          }
          else {
            if(pv0==1){ set32(G,tpro+tg*4,v+20); }
            else { set32(G,tpro+tg*4,v); }
          }
        }
      }
      // ---- PROXYC audit (W only): redun2a bits per candidate, pre-reseed ----
      if(cond==2){
        let qpn:i32=get32(G,3683372);
        if(qpn<32){
          let qpe:i32=3683376+qpn*28;
          set32(G,qpe,e+1);
          set32(G,qpe+4,v);
          set32(G,qpe+8,vkind);
          set32(G,qpe+12,redun2a(G,cb,0));
          set32(G,qpe+16,redun2a(G,cb,1));
          set32(G,qpe+20,redun2a(G,cb,2));
          set32(G,qpe+24,redun2a(G,cb,3));
          set32(G,3683372,qpn+1);
        }
      }
      // ---- MS trigger audit (W only, write-only): exact proxy firing
      // semantics at this trigger, pre-reseed. kind=0.
      if(cond==2){
        let msn4:i32=get32(G,3685200);
        if(msn4<32){
          ms_eval(G,cb,e+1,v,vkind,msn4,0);
          set32(G,3685200,msn4+1);
        }
        // ---- PX trigger audit (W only, write-only): redun3 firing
        // at this trigger, pre-reseed. kind=0.
        let pxn4:i32=get32(G,3687432);
        if(pxn4<32){
          px_eval(G,cb,e+1,v,vkind,pxn4,0,e);
          let pwn4:i32=get32(G,3689000);
          if(pwn4<32){
            pw_eval(G,cb,e+1,0,e,pwn4);
            set32(G,3689000,pwn4+1);
          }
          set32(G,3687432,pxn4+1);
        }
      }
      if(v<0){
        let dc:i32=get32(G,decloff);
        set32(G,decloff,dc+1);
        if(cond==2){ shadow_eval(G,cb,a,w,e); }
      }
      else {
        if(vkind==1){
          set32(G,redseedoff,get32(G,redseedoff)+1);
          let rv2:i32=redun2a(G,cb,v);
          if(rv2==0){
            set32(G,3681208,get32(G,3681208)+1);
          }
          if(cond==2){
            let vdom:i32=domblk(G,v);
            let adv:i32=0;
            let j2:i32=0;
            while(j2<4){
              let ap:i32=advpair(G,cb,v,j2,vdom);
              if(ap==1){ adv=1; }
              j2=j2+1;
            }
            if(adv==1){
              set32(G,3682176,get32(G,3682176)+1);
            }
            let vcur:i32=curdom(G,v);
            let adv2:i32=0;
            let a0:i32=0;
            let a1:i32=0;
            let a2:i32=0;
            let a3:i32=0;
            let k2:i32=0;
            while(k2<4){
              let ap2:i32=advpair2(G,cb,v,k2,vcur);
              if(ap2==1){
                adv2=1;
                let jc:i32=curdom(G,k2)+1;
                if(k2==0){ a0=jc; }
                if(k2==1){ a1=jc; }
                if(k2==2){ a2=jc; }
                if(k2==3){ a3=jc; }
              }
              k2=k2+1;
            }
            if(adv2==1){
              set32(G,3682340,get32(G,3682340)+1);
            }
            let pn:i32=get32(G,3682344);
            if(pn<32){
              let pe:i32=3682348+pn*28;
              set32(G,pe,e+1);
              set32(G,pe+4,v);
              set32(G,pe+8,vcur);
              set32(G,pe+12,a0);
              set32(G,pe+16,a1);
              set32(G,pe+20,a2);
              set32(G,pe+24,a3);
              set32(G,3682344,pn+1);
            }
          }
          if(cond==2){ shadow_eval(G,cb,a,w,e); }
        }
        else {
          if(pv0==1){
            set32(G,3681208,get32(G,3681208)+1);
          }
        }
        set32(G,cb+v*4,vs);
        set32(G,cb+16+v*4,1);
        set32(G,cb+32+v*4,0);
        set32(G,cb+56+v*4,0);
        set32(G,cb+72+v*4,0);
        let qxz:i32=0;
        while(qxz<4){
          set32(G,3683244+(v*4+qxz)*4,0);
          set32(G,3683244+(qxz*4+v)*4,0);
          set32(G,3683308+(v*4+qxz)*4,0);
          set32(G,3683308+(qxz*4+v)*4,0);
          // redun3 tallies: v is a new model; old runner-up relations invalid
          set32(G,3687300+(v*4+qxz)*4,0);
          set32(G,3687300+(qxz*4+v)*4,0);
          qxz=qxz+1;
        }
        if(cond==2){
          let zc:i32=0;
          while(zc<5){
            set32(G,3682260+v*20+zc*4,0);
            zc=zc+1;
          }
        }
      }
      set32(G,cb+52,tg+1);
      cc=0;
    }
    set32(G,cb+48,cc);
    if(cond==1){
      if(e==11){
        let okx:i32=0;
        if(get32(G,cb)==180){ if(get32(G,cb+16)==9){ okx=1; } }
        set32(G,3681212,get32(G,3681212)+okx);
        snap(G,cb,snapD);
      }
      if(e==671){ snap(G,cb,snapR); }
      if(e==731){ snap(G,cb,snapB); }
    }
    else {
      if(cond==0){
        if(e==659){ snap(G,cb,snapR); }
        if(e==719){ snap(G,cb,snapB); }
      }
      else {
        if(e==11){
          let okw:i32=0;
          if(get32(G,cb)==180){ if(get32(G,cb+16)==9){ okw=2; } }
          set32(G,3681212,get32(G,3681212)+okw);
          snap(G,cb,snapD);
        }
        if(e==671){ snap(G,cb,snapR); }
        if(e==731){ snap(G,cb,snapB); }
        if(e==791){ snap(G,cb,snapB4); }
        if(e==851){ snap(G,cb,snapB5); }
      }
    }
    e=e+1;
  }
  return;
}
// ---- single-cell condition (MD rule, unchanged) ----
fn run_single(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,ne:i32)void {
  let sum:i32=0;
  let n:i32=0;
  let e:i32=0;
  while(e<ne){
    let m:i32=50;
    if(n>0){ m=sum/n; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    sum=sum+get32(G,pbase+e*4);
    n=n+1;
    e=e+1;
  }
  return;
}
// ---- zero-padded episode label ----
fn o_e4(b:[]u8,c:i32,e:i32)i32 {
  let en:i32=e+1;
  c=o_app(b,c,"E");
  if(en<1000){ c=o_app(b,c,"0"); }
  if(en<100){ c=o_app(b,c,"0"); }
  if(en<10){ c=o_app(b,c,"0"); }
  c=o_i64(b,c,en as i64);
  return c;
}
// ---- one trigger log line body: " E<ep>:<victim><U/R/D/X> F=<mask>" ----
fn o_trig(B:[]u8,c:i32,G:[]u8,tlog:i32,tpro:i32,tflg:i32,tg:i32)i32 {
  let ti:i32=0;
  while(ti<tg){
    if(ti<32){
      c=o_app(B,c," E");
      c=o_i64(B,c,(get32(G,tlog+ti*4)+1) as i64);
      c=o_app(B,c,":");
      let pv:i32=get32(G,tpro+ti*4);
      if(pv==99){ c=o_app(B,c,"D"); }
      else {
        if(pv>=20){ c=o_i64(B,c,(pv-20) as i64); c=o_app(B,c,"X"); }
        else {
          if(pv>=10){ c=o_i64(B,c,(pv-10) as i64); c=o_app(B,c,"R"); }
          else { c=o_i64(B,c,pv as i64); c=o_app(B,c,"U"); }
        }
      }
      c=o_app(B,c," F=");
      c=o_i64(B,c,get32(G,tflg+ti*4) as i64);
    }
    ti=ti+1;
  }
  return c;
}
fn main()i32 {
  let p:*u8=_zag_malloc(4194304) as *u8;
  let G:[]u8=p[0..4194304];
  let z:i32=0;
  while(z<4194304){ G[z]=0; z=z+1; }
  gen(G);
  run_multi(G,3655352,12152,8,3667496,3679764,3681216,3681296,3681376,0,0,3680044,3680428,3680812,3681196,3682088,3682100,732,1);
  run_multi(G,3658280,890552,2936,3670424,3679852,0,3681456,3681536,0,0,3680172,3680684,3681068,3681200,3682092,3682100,720,0);
  run_multi(G,3664088,2632952,8744,3676232,3679940,3681616,3681696,3681776,3681856,3681936,3680300,3680556,3680940,3681204,3682096,3682100,852,2);
  run_single(G,3661160,1754552,5816,3673304,732);
  // ---- frozen metrics ----
  let rx:i32=0;
  let e:i32=12;
  while(e<672){
    let mm:i32=get32(G,3667496+e*4);
    let dd:i32=mm-80;
    if(dd<0){ dd=0-dd; }
    if(dd<=1){ if(rx==0){ rx=e-11; } }
    e=e+1;
  }
  let ry:i32=0;
  e=0;
  while(e<660){
    let mm2:i32=get32(G,3670424+e*4);
    let dd2:i32=mm2-80;
    if(dd2<0){ dd2=0-dd2; }
    if(dd2<=1){ if(ry==0){ ry=e+1; } }
    e=e+1;
  }
  let rz:i32=0;
  e=12;
  while(e<672){
    let mm3:i32=get32(G,3673304+e*4);
    let dd3:i32=mm3-80;
    if(dd3<0){ dd3=0-dd3; }
    if(dd3<=1){ if(rz==0){ rz=e-11; } }
    e=e+1;
  }
  let rxf:i32=0;
  let k:i32=1;
  while(k<=660){
    let mx:i32=get32(G,3667496+(11+k)*4);
    let my:i32=get32(G,3670424+(k-1)*4);
    let ddf:i32=mx-my;
    if(ddf<0){ ddf=0-ddf; }
    if(ddf<=1){ if(rxf==0){ rxf=k; } }
    k=k+1;
  }
  let costxy:i64=0;
  let costxz:i64=0;
  e=12;
  while(e<672){
    costxy=costxy+(get32(G,3655352+e*4) as i64)-(get32(G,3658280+(e-12)*4) as i64);
    costxz=costxz+(get32(G,3655352+e*4) as i64)-(get32(G,3661160+e*4) as i64);
    e=e+1;
  }
  let rxb2:i32=0;
  e=672;
  while(e<732){
    let mmb:i32=get32(G,3667496+e*4);
    let ddb:i32=mmb-20;
    if(ddb<0){ ddb=0-ddb; }
    if(ddb<=1){ if(rxb2==0){ rxb2=e-671; } }
    e=e+1;
  }
  let rwb2:i32=0;
  e=672;
  while(e<732){
    let mmw:i32=get32(G,3676232+e*4);
    let ddw:i32=mmw-50;
    if(ddw<0){ ddw=0-ddw; }
    if(ddw<=1){ if(rwb2==0){ rwb2=e-671; } }
    e=e+1;
  }
  let rwb4:i32=0;
  e=732;
  while(e<792){
    let mm4:i32=get32(G,3676232+e*4);
    let dd4:i32=mm4-82;
    if(dd4<0){ dd4=0-dd4; }
    if(dd4<=1){ if(rwb4==0){ rwb4=e-731; } }
    e=e+1;
  }
  let rwb5:i32=0;
  e=792;
  while(e<852){
    let mm5:i32=get32(G,3676232+e*4);
    let dd5:i32=mm5-50;
    if(dd5<0){ dd5=0-dd5; }
    if(dd5<=1){ if(rwb5==0){ rwb5=e-791; } }
    e=e+1;
  }
  // ---- bars ----
  let b5a:i32=0;
  if(rx>=1){ if(rx<=99){ b5a=1; } }
  let b5b:i32=0;
  if(rz>=500){ b5b=1; }
  let b5c:i32=0;
  if(costxy<4690){ b5c=1; }
  let b5d:i32=0;
  if(rxb2>=1){ if(rxb2<=30){ b5d=1; } }
  let b8:i32=0;
  if(get32(G,3681208)==0){ b8=1; }
  let b9:i32=0;
  if(get32(G,3682096)>=2){ if(get32(G,3682100)==0){ b9=1; } }
  let b10:i32=0;
  if(get32(G,3682176)==1){ b10=1; }
  let b10b:i32=0;
  if(get32(G,3682340)==1){ b10b=1; }
  let mxe:i32=0;
  e=0;
  while(e<732){
    let a1:i32=get32(G,3655352+e*4);
    if(a1>mxe){ mxe=a1; }
    let a3:i32=get32(G,3661160+e*4);
    if(a3>mxe){ mxe=a3; }
    e=e+1;
  }
  e=0;
  while(e<720){
    let a2:i32=get32(G,3658280+e*4);
    if(a2>mxe){ mxe=a2; }
    e=e+1;
  }
  e=0;
  while(e<852){
    let a4:i32=get32(G,3664088+e*4);
    if(a4>mxe){ mxe=a4; }
    e=e+1;
  }
  let b5e:i32=0;
  if(mxe<=1200){ if(get32(G,3679640)==0){ b5e=1; } }
  // B4a: 12 block-D values pairwise distinct (X)
  let db:i32=1;
  let i2:i32=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      if(get32(G,8+i2*4)==get32(G,8+j*4)){ db=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  // XDISJ: same-episode flip vectors differ across conditions
  let xd:i32=1;
  e=0;
  while(e<660){
    if(veq(G,12152+(12+e)*1200,890552+e*1200,1200)==1){ xd=0; }
    if(veq(G,12152+(12+e)*1200,1754552+(12+e)*1200,1200)==1){ xd=0; }
    if(veq(G,890552+e*1200,1754552+(12+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(veq(G,12152+(672+e)*1200,890552+(660+e)*1200,1200)==1){ xd=0; }
    if(veq(G,12152+(672+e)*1200,1754552+(672+e)*1200,1200)==1){ xd=0; }
    if(veq(G,890552+(660+e)*1200,1754552+(672+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  // PARID: values identical across conditions (X/Y/Z as MA3; W only
  // over the D block, e<12: W's R/B2/B4/B5 tiles are adversarially
  // different by design)
  let parid:i32=1;
  e=0;
  while(e<732){
    if(get32(G,8+e*4)!=get32(G,5816+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<12){
    if(get32(G,8+e*4)!=get32(G,8744+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<660){
    if(get32(G,8+(12+e)*4)!=get32(G,2936+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(get32(G,8+(672+e)*4)!=get32(G,2936+(660+e)*4)){ parid=0; }
    e=e+1;
  }
  // MARG: per-condition per-block ones-fraction in fixed bands
  let sXd:i64=0;
  let kk:i32=0;
  while(kk<14400){ sXd=sXd+(G[12152+kk] as i64); kk=kk+1; }
  let sXr:i64=0;
  kk=0;
  while(kk<792000){ sXr=sXr+(G[12152+14400+kk] as i64); kk=kk+1; }
  let sXb:i64=0;
  kk=0;
  while(kk<72000){ sXb=sXb+(G[12152+806400+kk] as i64); kk=kk+1; }
  let sYr:i64=0;
  kk=0;
  while(kk<792000){ sYr=sYr+(G[890552+kk] as i64); kk=kk+1; }
  let sYb:i64=0;
  kk=0;
  while(kk<72000){ sYb=sYb+(G[890552+792000+kk] as i64); kk=kk+1; }
  let sZd:i64=0;
  kk=0;
  while(kk<14400){ sZd=sZd+(G[1754552+kk] as i64); kk=kk+1; }
  let sZr:i64=0;
  kk=0;
  while(kk<792000){ sZr=sZr+(G[1754552+14400+kk] as i64); kk=kk+1; }
  let sZb:i64=0;
  kk=0;
  while(kk<72000){ sZb=sZb+(G[1754552+806400+kk] as i64); kk=kk+1; }

// rxbase.zag -- REPEXPAND-1 simple-baseline comparison (promotion step 5).
//
// Prereg: PREREG_BASELINE.md, frozen alone at dc74cb523 (amended at
// 9ef37be36) BEFORE this file existed. Baselines B1 MEM (memorization),
// B2 NN (nearest neighbor), B3 LEXH (exhaustive L search, independent
// reimplementation). Verdict BASELINE-BEATS or BASELINE-MATCHES per the
// frozen K-BL-4 rule. This is a comparison verdict only, not a promotion.
//
// Pure Zag. No Python at any stage.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn pe(s:[]u8)void { _zag_print(s); return; }
fn pi(v:i32)void { let t:[]u8=_zag_i64_to_str(v as i64); _zag_print(t); return; }
fn pn()void { _zag_print("\n"); return; }

// Episode tables: 17 episodes.
// 0..5 TRAIN (spec 35, head 97/98, n in 2,3,5,7,4,6, content a^n b^n)
// 6..9 HIDDEN (n in 9,11,15,17)
// 10..12 EXTENDED (n in 13,20,30)
// 13 T1 (spec 36, n 4, head ab, a^4 b^4)
// 14 T2 (spec 36, n 9, head ab, a^9 b^9)
// 15 T3 (spec 35, n 3, head xy, x^3 y^3)
// 16 T4 (spec 35, n 8, head xy, x^8 y^8)
fn ep_init(spec:[]u8,en:[]u8,h0:[]u8,h1:[]u8,s1:[]u8,l1:[]u8,s2:[]u8,l2:[]u8)void {
  let tr:[]u8=z_alloc(6);
  tr[0]=2; tr[1]=3; tr[2]=5; tr[3]=7; tr[4]=4; tr[5]=6;
  let i:i32=0;
  while(i<6){
    spec[i]=35; en[i]=tr[i]; h0[i]=97; h1[i]=98;
    s1[i]=97; l1[i]=tr[i]; s2[i]=98; l2[i]=tr[i];
    i=i+1;
  }
  let hd:[]u8=z_alloc(4);
  hd[0]=9; hd[1]=11; hd[2]=15; hd[3]=17;
  i=0;
  while(i<4){
    let e:i32=6+i;
    spec[e]=35; en[e]=hd[i]; h0[e]=97; h1[e]=98;
    s1[e]=97; l1[e]=hd[i]; s2[e]=98; l2[e]=hd[i];
    i=i+1;
  }
  let ex:[]u8=z_alloc(3);
  ex[0]=13; ex[1]=20; ex[2]=30;
  i=0;
  while(i<3){
    let e:i32=10+i;
    spec[e]=35; en[e]=ex[i]; h0[e]=97; h1[e]=98;
    s1[e]=97; l1[e]=ex[i]; s2[e]=98; l2[e]=ex[i];
    i=i+1;
  }
  spec[13]=36; en[13]=4; h0[13]=97; h1[13]=98; s1[13]=97; l1[13]=4; s2[13]=98; l2[13]=4;
  spec[14]=36; en[14]=9; h0[14]=97; h1[14]=98; s1[14]=97; l1[14]=9; s2[14]=98; l2[14]=9;
  spec[15]=35; en[15]=3; h0[15]=120; h1[15]=121; s1[15]=120; l1[15]=3; s2[15]=121; l2[15]=3;
  spec[16]=35; en[16]=8; h0[16]=120; h1[16]=121; s1[16]=120; l1[16]=8; s2[16]=121; l2[16]=8;
  return;
}

fn phase_of(ep:i32)[]u8 {
  if(ep<6){return "TRAIN";}
  if(ep<10){return "HIDDEN";}
  if(ep<13){return "EXTENDED";}
  return "TRANSFER";
}

// Memorization table: mn (keys), ms1/ml1/ms2/ml2 (values), up to 8 entries.
fn mem_find(mn:[]u8, mct:i32, n:i32)i32 {
  let i:i32=0;
  while(i<mct){
    if((mn[i] as i32)==n){return i;}
    i=i+1;
  }
  return -1;
}
fn mem_store(mn:[]u8,ms1:[]u8,ml1:[]u8,ms2:[]u8,ml2:[]u8,mct:i32,
             n:i32,s1:i32,l1:i32,s2:i32,l2:i32)i32 {
  if(mem_find(mn,mct,n)>=0){return mct;}
  mn[mct]=n as u8; ms1[mct]=s1 as u8; ml1[mct]=l1 as u8;
  ms2[mct]=s2 as u8; ml2[mct]=l2 as u8;
  return mct+1;
}

// B1 MEM: emit stored tuple for n, else failure. Returns 1 if emitted.
fn b1_predict(mn:[]u8,ms1:[]u8,ml1:[]u8,ms2:[]u8,ml2:[]u8,mct:i32,n:i32,out:[]u8)i32 {
  let f:i32=mem_find(mn,mct,n);
  if(f<0){out[0]=0;out[1]=0;out[2]=0;out[3]=0;return 0;}
  out[0]=ms1[f]; out[1]=ml1[f]; out[2]=ms2[f]; out[3]=ml2[f];
  return 1;
}

// B2 NN: copy the stored tuple of the closest n (tie: smaller n).
fn b2_predict(mn:[]u8,ms1:[]u8,ml1:[]u8,ms2:[]u8,ml2:[]u8,mct:i32,n:i32,out:[]u8)i32 {
  if(mct==0){out[0]=0;out[1]=0;out[2]=0;out[3]=0;return 0;}
  let bi:i32=0;
  let bd:i32=1000000;
  let i:i32=0;
  while(i<mct){
    let d:i32=n-(mn[i] as i32);
    if(d<0){d=0-d;}
    if(d<bd || (d==bd && (mn[i] as i32)<(mn[bi] as i32))){bd=d;bi=i;}
    i=i+1;
  }
  out[0]=ms1[bi]; out[1]=ml1[bi]; out[2]=ms2[bi]; out[3]=ml2[bi];
  return 1;
}

// Run one memory baseline (which: 1=B1MEM, 2=B2NN). Sequential protocol:
// TRAIN answers revealed after each attempt; later phases frozen.
// Returns HIDDEN correct count.
fn run_base(which:i32, spec:[]u8,en:[]u8,h0:[]u8,h1:[]u8,
            s1:[]u8,l1:[]u8,s2:[]u8,l2:[]u8)i32 {
  let mn:[]u8=z_alloc(8); let ms1:[]u8=z_alloc(8); let ml1:[]u8=z_alloc(8);
  let ms2:[]u8=z_alloc(8); let ml2:[]u8=z_alloc(8);
  let mct:i32=0;
  let cT:i32=0; let cH:i32=0; let cE:i32=0; let cR:i32=0;
  let bname:[]u8="B1MEM";
  if(which==2){bname="B2NN";}
  let ep:i32=0;
  while(ep<17){
    let out:[]u8=z_alloc(4);
    let n:i32=en[ep] as i32;
    let matched:i32=0;
    if(which==1){matched=b1_predict(mn,ms1,ml1,ms2,ml2,mct,n,out);}
    else{matched=b2_predict(mn,ms1,ml1,ms2,ml2,mct,n,out);}
    let ok:i32=0;
    if(matched==1){
      if((out[0] as i32)==(s1[ep] as i32) && (out[1] as i32)==(l1[ep] as i32) &&
         (out[2] as i32)==(s2[ep] as i32) && (out[3] as i32)==(l2[ep] as i32)){ok=1;}
    }
    pe("BX-EP base="); pe(bname); pe(" phase="); pe(phase_of(ep));
    pe(" ep="); pi(ep); pe(" n="); pi(n);
    pe(" pred="); pi(out[0] as i32); pe(","); pi(out[1] as i32);
    pe(","); pi(out[2] as i32); pe(","); pi(out[3] as i32);
    pe(" act="); pi(s1[ep] as i32); pe(","); pi(l1[ep] as i32);
    pe(","); pi(s2[ep] as i32); pe(","); pi(l2[ep] as i32);
    pe(" ok="); pi(ok); pn();
    if(ok==1){
      if(ep<6){cT=cT+1;}
      else{if(ep<10){cH=cH+1;}else{if(ep<13){cE=cE+1;}else{cR=cR+1;}}}
    }
    if(ep<6){
      mct=mem_store(mn,ms1,ml1,ms2,ml2,mct,n,
                    s1[ep] as i32, l1[ep] as i32, s2[ep] as i32, l2[ep] as i32);
    }
    ep=ep+1;
  }
  pe("BX-SUM base="); pe(bname); pe(" phase=TRAIN correct="); pi(cT); pe("/6"); pn();
  pe("BX-SUM base="); pe(bname); pe(" phase=HIDDEN correct="); pi(cH); pe("/4"); pn();
  pe("BX-SUM base="); pe(bname); pe(" phase=EXTENDED correct="); pi(cE); pe("/3"); pn();
  pe("BX-SUM base="); pe(bname); pe(" phase=TRANSFER correct="); pi(cR); pe("/4"); pn();
  return cH;
}

// B3 LEXH: canonical diagonal ALT table, 92 x 3 (ascending subsets).
fn alt_init(set:[]u8)void {
  let idx:i32=0;
  let k:i32=1;
  while(k<=8){
    set[idx*3]=k as u8; set[idx*3+1]=0; set[idx*3+2]=0; idx=idx+1;
    k=k+1;
  }
  let a:i32=1;
  while(a<=8){
    let b:i32=a+1;
    while(b<=8){
      set[idx*3]=a as u8; set[idx*3+1]=b as u8; set[idx*3+2]=0; idx=idx+1;
      b=b+1;
    }
    a=a+1;
  }
  a=1;
  while(a<=8){
    let b2:i32=a+1;
    while(b2<=8){
      let c:i32=b2+1;
      while(c<=8){
        set[idx*3]=a as u8; set[idx*3+1]=b2 as u8; set[idx*3+2]=c as u8; idx=idx+1;
        c=c+1;
      }
      b2=b2+1;
    }
    a=a+1;
  }
  return;
}

// L prediction semantics from the frozen prereg. cand 0..511 = single,
// 512..603 = diagonal ALT. Returns 1 iff the expression predicts this
// episode exactly.
fn expr_ok(cand:i32, set:[]u8, spec:i32, n:i32,
           s1:i32,l1:i32,s2:i32,l2:i32)i32 {
  if(spec!=35){return 0;}
  if(cand<512){
    let c0:i32=cand/64+1;
    let c1:i32=(cand/8)%8+1;
    let c2:i32=cand%8+1;
    if(c0!=n){return 0;}
    if(c1==l1 && c2==l2 && s1==97 && s2==98){return 1;}
    return 0;
  }
  let ai:i32=cand-512;
  let j:i32=0;
  while(j<3){
    let kk:i32=set[ai*3+j] as i32;
    if(kk!=0 && kk==n){
      if(kk==l1 && kk==l2 && s1==97 && s2==98){return 1;}
      return 0;
    }
    j=j+1;
  }
  return 0;
}

fn print_kind(cand:i32, set:[]u8)void {
  if(cand<512){
    let c0:i32=cand/64+1;
    let c1:i32=(cand/8)%8+1;
    let c2:i32=cand%8+1;
    pe("SINGLE c0="); pi(c0); pe(" c1="); pi(c1); pe(" c2="); pi(c2);
    return;
  }
  let ai:i32=cand-512;
  let nb:i32=0;
  let j:i32=0;
  while(j<3){
    if((set[ai*3+j] as i32)!=0){nb=nb+1;}
    j=j+1;
  }
  pe("ALT"); pi(nb); pe(" branches=");
  j=0;
  let f:i32=0;
  while(j<3){
    let kk:i32=set[ai*3+j] as i32;
    if(kk!=0){
      if(f==1){pe(",");}
      pi(kk); f=1;
    }
    j=j+1;
  }
  return;
}

fn main()void {
  pe("BX-HEAD repexpand-baseline prereg=dc74cb523"); pn();
  let spec:[]u8=z_alloc(17); let en:[]u8=z_alloc(17);
  let h0:[]u8=z_alloc(17); let h1:[]u8=z_alloc(17);
  let s1:[]u8=z_alloc(17); let l1:[]u8=z_alloc(17);
  let s2:[]u8=z_alloc(17); let l2:[]u8=z_alloc(17);
  ep_init(spec,en,h0,h1,s1,l1,s2,l2);

  let b1h:i32=run_base(1, spec,en,h0,h1,s1,l1,s2,l2);
  let b2h:i32=run_base(2, spec,en,h0,h1,s1,l1,s2,l2);

  let set:[]u8=z_alloc(276);
  alt_init(set);

  // Check (a): impossibility verification on E_1..E_12.
  let max604:i32=-1;
  let argA:i32=0;
  let cand:i32=0;
  while(cand<604){
    let sc:i32=0;
    let n:i32=1;
    while(n<=12){
      sc=sc+expr_ok(cand,set,35,n,97,n,98,n);
      n=n+1;
    }
    if(sc>max604){max604=sc;argA=cand;}
    cand=cand+1;
  }
  pe("BX-LEXH check=E12 max604="); pi(max604);
  pe(" argmax="); pi(argA); pe(" kind="); print_kind(argA,set); pn();

  // Check (b): oracle ceiling on the 17 experiment episodes.
  let max17:i32=-1;
  let argB:i32=0;
  cand=0;
  while(cand<604){
    let sc:i32=0;
    let ep:i32=0;
    while(ep<17){
      sc=sc+expr_ok(cand,set,spec[ep] as i32,en[ep] as i32,
                    s1[ep] as i32,l1[ep] as i32,s2[ep] as i32,l2[ep] as i32);
      ep=ep+1;
    }
    if(sc>max17){max17=sc;argB=cand;}
    cand=cand+1;
  }
  pe("BX-LEXH check=EXP17 max17="); pi(max17);
  pe(" argmax="); pi(argB); pe(" kind="); print_kind(argB,set); pn();

  // Per-phase breakdown of the oracle-best expression.
  let cT:i32=0; let cH:i32=0; let cE:i32=0; let cR:i32=0;
  let ep:i32=0;
  while(ep<17){
    if(expr_ok(argB,set,spec[ep] as i32,en[ep] as i32,
               s1[ep] as i32,l1[ep] as i32,s2[ep] as i32,l2[ep] as i32)==1){
      if(ep<6){cT=cT+1;}
      else{if(ep<10){cH=cH+1;}else{if(ep<13){cE=cE+1;}else{cR=cR+1;}}}
    }
    ep=ep+1;
  }
  pe("BX-SUM base=B3LEXH phase=TRAIN correct="); pi(cT); pe("/6"); pn();
  pe("BX-SUM base=B3LEXH phase=HIDDEN correct="); pi(cH); pe("/4"); pn();
  pe("BX-SUM base=B3LEXH phase=EXTENDED correct="); pi(cE); pe("/3"); pn();
  pe("BX-SUM base=B3LEXH phase=TRANSFER correct="); pi(cR); pe("/4"); pn();

  // Frozen K-BL-4 verdict rule.
  let beats:i32=0;
  if(b1h>=4){beats=1;}
  if(b2h>=4){beats=1;}
  if(cH>=4){beats=1;}
  if(max604!=3){beats=1;}
  pe("BX-VERDICT ");
  if(beats==1){pe("BASELINE-BEATS");}else{pe("BASELINE-MATCHES");}
  pe(" b1_hidden="); pi(b1h); pe("/4");
  pe(" b2_hidden="); pi(b2h); pe("/4");
  pe(" b3_hidden="); pi(cH); pe("/4");
  pe(" max604="); pi(max604);
  pn();
  return;
}

@import("substrate/R33_NATIVE_IO_V1.zag")

// ============================================================
// fw6_respond.zag - FW6 two-stage responder (world-side logic).
// Reads a learner stdout transcript (argv[1]) and decides which
// file the stage releases next, per WORLD_DESIGN.md:
//
// Stage 1: release fw6_phaseB1.txt iff some transcript line is
//   exactly "ANSWER 35001 35501 -2" AND a line exactly "CHOICE 0"
//   occurs AFTER it; otherwise release fw6_controlB.txt.
// Stage 2: same pattern on "ANSWER 35002 35502 -2" deciding
//   between fw6_phaseB2.txt and fw6_controlB2.txt.
//
// argv[2] selects the stage ("1" or "2"). Prints the release
// decision to stdout. Exits 2 on I/O failure, 3 on bad stage.
// ============================================================

fn lines_equal(a:[]u8, b:[]u8) i32 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// decide returns 1 when the reveal file releases, 0 for control
fn decide(content:[]u8, diag:[]u8, choice:[]u8) i64 {
    let diag_at:i64 = -1;
    let line_no:i64 = 0;
    // split content into lines; compare each exact line
    let i:i64 = 0;
    let start:i64 = 0;
    while (i <= content.len) {
        if (i == content.len || content[i] == (10 as u8)) {
            let ln:[]u8 = content[start..i];
            if (diag_at < 0 && lines_equal(ln, diag) == 1) {
                diag_at = line_no;
            }
            if (diag_at >= 0 && line_no > diag_at && lines_equal(ln, choice) == 1) {
                return 1;
            }
            start = i + 1;
            line_no = line_no + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) {
        let e:[]u8 = nio_alloc(1);
        return e[0..0];
    }
    let cap:i64 = 65536;
    let buf:[]u8 = nio_alloc(cap as i32);
    if (buf.len == 0) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); let e2:[]u8 = nio_alloc(1); return e2[0..0]; }
    let total:i64 = 0;
    while (total < cap) {
        let r:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (r <= 0) { break; }
        total = total + r;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return buf[0..total];
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if (a1.len == 0 || a2.len == 0) {
        _zag_println("usage: fw6_respond <transcript> <1|2>");
        return 2;
    }
    let stage:i64 = 0;
    if (a2.len == 1 && a2[0] == (49 as u8)) { stage = 1; }
    if (a2.len == 1 && a2[0] == (50 as u8)) { stage = 2; }
    if (stage == 0) {
        _zag_println("bad stage");
        return 3;
    }
    let content:[]u8 = read_all(a1);
    if (content.len == 0) {
        _zag_println("read failed");
        return 2;
    }
    let diag:[]u8 = "ANSWER 35001 35501 -2";
    let rel:[]u8 = "RELEASE fw6_phaseB1.txt";
    let ctl:[]u8 = "RELEASE fw6_controlB.txt";
    if (stage == 2) {
        diag = "ANSWER 35002 35502 -2";
        rel = "RELEASE fw6_phaseB2.txt";
        ctl = "RELEASE fw6_controlB2.txt";
    }
    let choice:[]u8 = "CHOICE 0";
    if (decide(content, diag, choice) == 1) {
        _zag_println(rel);
    } else {
        _zag_println(ctl);
    }
    return 0;
}

@import("substrate/R33_NATIVE_IO_V1.zag")

// ============================================================
// gen_fw.zag - FW1-FW9 world file generator (pure Zag).
// Implements WORLD_DESIGN.md (approved at 200387b42) exactly.
// Writes 16 world files into the directory given as argv[1].
// Every computed value (products, cumulative sums, DAG
// reachability and shortest paths) is calculated here in Zag;
// nothing is transcribed by hand.
// ============================================================

// ---- little-endian u8 cell helpers (safe idiom) ----
fn st32(b:[]u8, off:i64, v:i64) void {
    b[off] = (v & 255) as u8;
    b[off + 1] = ((v >> 8) & 255) as u8;
    b[off + 2] = ((v >> 16) & 255) as u8;
    b[off + 3] = ((v >> 24) & 255) as u8;
}
fn ld32(b:[]u8, off:i64) i64 {
    return (b[off] as i64) + (b[off + 1] as i64) * 256 + (b[off + 2] as i64) * 65536 + (b[off + 3] as i64) * 16777216;
}

// ---- text buffer append helpers ----
fn app_str(buf:[]u8, pos:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { buf[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn app_i64(buf:[]u8, pos:i64, v:i64) i64 {
    if (v < 0) { buf[pos] = 45 as u8; pos = pos + 1; v = 0 - v; }
    if (v == 0) { buf[pos] = 48 as u8; return pos + 1; }
    let div:i64 = 1;
    while (v / div >= 10) { div = div * 10; }
    while (div >= 1) {
        let d:i64 = v / div;
        buf[pos] = (48 + d) as u8; pos = pos + 1;
        v = v - d * div; div = div / 10;
    }
    return pos;
}
fn ev_observe(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "OBSERVE ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_query(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "QUERY ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_act(buf:[]u8, pos:i64) i64 {
    return app_str(buf, pos, "ACT\n");
}

// ---- file writer (O_EXCL create; caller ensures fresh dir) ----
fn write_file(dir:[]u8, name:[]u8, buf:[]u8, len:i64) i64 {
    let root:i64 = nio_open_root(dir);
    if (root < 0) { return -1; }
    let fd:i64 = nio_open_child(root, name, 1);
    nio_close(root);
    if (fd < 0) { return -2; }
    let w:i64 = nio_write_all(fd, buf[0..len]);
    nio_close(fd);
    if (w != len) { return -4; }
    return 0;
}
fn z_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b[0..s.len];
}

// ---- FW1: new concepts, 3-hop chains, 66 lines ----
fn gen_fw1(buf:[]u8) i64 {
    let pos:i64 = 0;
    // lines 1-6: old-vocabulary familiarization
    pos = ev_observe(buf, pos, 30101, 30501, 1);
    pos = ev_observe(buf, pos, 30101, 30502, 2);
    pos = ev_observe(buf, pos, 30102, 30501, 3);
    pos = ev_observe(buf, pos, 30102, 30502, 4);
    pos = ev_observe(buf, pos, 30103, 30501, 5);
    pos = ev_observe(buf, pos, 30103, 30502, 6);
    // lines 7-14: new subjects with old relations; old subjects with new relation
    pos = ev_observe(buf, pos, 30104, 30501, 7);
    pos = ev_observe(buf, pos, 30105, 30501, 8);
    pos = ev_observe(buf, pos, 30106, 30502, 9);
    pos = ev_observe(buf, pos, 30107, 30502, 10);
    pos = ev_observe(buf, pos, 30101, 30503, 11);
    pos = ev_observe(buf, pos, 30102, 30503, 12);
    pos = ev_observe(buf, pos, 30103, 30503, 13);
    pos = ev_observe(buf, pos, 30104, 30503, 14);
    // lines 15-20: two 3-hop chains sharing middle node 30110
    pos = ev_observe(buf, pos, 30108, 30501, 30109);
    pos = ev_observe(buf, pos, 30109, 30502, 30110);
    pos = ev_observe(buf, pos, 30110, 30503, 31);
    pos = ev_observe(buf, pos, 30111, 30501, 30112);
    pos = ev_observe(buf, pos, 30112, 30502, 30110);
    pos = ev_observe(buf, pos, 30110, 30503, 32);
    // lines 21-32: 12 probes (10 recall + 2 compositional on untaught 30599)
    pos = ev_query(buf, pos, 30101, 30501, 1);
    pos = ev_query(buf, pos, 30102, 30502, 4);
    pos = ev_query(buf, pos, 30103, 30501, 5);
    pos = ev_query(buf, pos, 30104, 30501, 7);
    pos = ev_query(buf, pos, 30105, 30501, 8);
    pos = ev_query(buf, pos, 30106, 30502, 9);
    pos = ev_query(buf, pos, 30107, 30502, 10);
    pos = ev_query(buf, pos, 30101, 30503, 11);
    pos = ev_query(buf, pos, 30108, 30501, 30109);
    pos = ev_query(buf, pos, 30109, 30502, 30110);
    pos = ev_query(buf, pos, 30108, 30599, 31);
    pos = ev_query(buf, pos, 30111, 30599, 32);
    // lines 33-56: pressure wave, 24 junk triples
    let j:i64 = 0;
    while (j < 24) {
        pos = ev_observe(buf, pos, 30801 + j, 30800, j + 1);
        j = j + 1;
    }
    // lines 57-66: retention probes (same ten recall probes repeated)
    pos = ev_query(buf, pos, 30101, 30501, 1);
    pos = ev_query(buf, pos, 30102, 30502, 4);
    pos = ev_query(buf, pos, 30103, 30501, 5);
    pos = ev_query(buf, pos, 30104, 30501, 7);
    pos = ev_query(buf, pos, 30105, 30501, 8);
    pos = ev_query(buf, pos, 30106, 30502, 9);
    pos = ev_query(buf, pos, 30107, 30502, 10);
    pos = ev_query(buf, pos, 30101, 30503, 11);
    pos = ev_query(buf, pos, 30108, 30501, 30109);
    pos = ev_query(buf, pos, 30109, 30502, 30110);
    return pos;
}

// ---- FW2: new procedures, 5-step, 26 lines ----
// (design header says 27; the specified ranges 1-18 and 19-26 sum to 26)
fn gen_fw2(buf:[]u8) i64 {
    let pos:i64 = 0;
    let inst:i64 = 0;
    while (inst < 3) {
        let s:i64 = 31001 + inst;
        let k:i64 = 0;
        while (k < 5) {
            pos = ev_observe(buf, pos, s, 31501 + k, 31801 + k);
            k = k + 1;
        }
        pos = ev_observe(buf, pos, s, 31506, 31806);
        inst = inst + 1;
    }
    let q:i64 = 0;
    while (q < 2) {
        let s:i64 = 31004 + q;
        let k:i64 = 0;
        while (k < 4) {
            pos = ev_query(buf, pos, s, 31501 + k, 31801 + k);
            k = k + 1;
        }
        q = q + 1;
    }
    return pos;
}

// ---- FW3: causal laws, multiplication, 54 lines ----
fn fw3_intervene(buf:[]u8, pos:i64, pair:i64, x:i64, y:i64) i64 {
    pos = ev_observe(buf, pos, pair, 32501, x);
    pos = ev_observe(buf, pos, pair, 32502, y);
    pos = ev_observe(buf, pos, pair, 32500, x * y);
    return pos;
}
fn fw3_trial(buf:[]u8, pos:i64, pair:i64, x:i64, y:i64) i64 {
    pos = ev_observe(buf, pos, pair, 32501, x);
    pos = ev_observe(buf, pos, pair, 32502, y);
    pos = ev_query(buf, pos, pair, 32500, x * y);
    return pos;
}
fn gen_fw3(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = fw3_intervene(buf, pos, 32001, 2, 3);
    pos = fw3_intervene(buf, pos, 32002, 2, 4);
    pos = fw3_intervene(buf, pos, 32003, 3, 3);
    pos = fw3_intervene(buf, pos, 32004, 2, 5);
    pos = fw3_intervene(buf, pos, 32005, 3, 4);
    pos = fw3_intervene(buf, pos, 32006, 2, 6);
    pos = fw3_intervene(buf, pos, 32007, 4, 4);
    pos = fw3_intervene(buf, pos, 32008, 3, 5);
    pos = fw3_trial(buf, pos, 32011, 4, 5);
    pos = fw3_trial(buf, pos, 32012, 5, 5);
    pos = fw3_trial(buf, pos, 32013, 3, 6);
    pos = fw3_trial(buf, pos, 32014, 4, 6);
    pos = fw3_trial(buf, pos, 32015, 5, 3);
    pos = fw3_trial(buf, pos, 32016, 6, 4);
    pos = fw3_trial(buf, pos, 32017, 5, 6);
    pos = fw3_trial(buf, pos, 32018, 6, 5);
    pos = fw3_trial(buf, pos, 32019, 4, 3);
    pos = fw3_trial(buf, pos, 32020, 6, 6);
    return pos;
}

// ---- FW4: law change under sequential pressure, 72 lines ----
fn gen_fw4(buf:[]u8) i64 {
    let pos:i64 = 0;
    let i:i64 = 1;
    while (i <= 12) { pos = ev_observe(buf, pos, 33100 + i, 33501, 10 * i); i = i + 1; }
    i = 1;
    while (i <= 12) { pos = ev_query(buf, pos, 33100 + i, 33501, 10 * i); i = i + 1; }
    i = 1;
    while (i <= 12) { pos = ev_observe(buf, pos, 33100 + i, 33501, 10 * i + 5); i = i + 1; }
    i = 1;
    while (i <= 12) { pos = ev_query(buf, pos, 33100 + i, 33501, 10 * i + 5); i = i + 1; }
    i = 1;
    while (i <= 12) { pos = ev_observe(buf, pos, 33100 + i, 33501, 10 * i); i = i + 1; }
    i = 1;
    while (i <= 12) { pos = ev_query(buf, pos, 33100 + i, 33501, 10 * i); i = i + 1; }
    return pos;
}

// ---- FW5: contradictions on a 10-link chain, 25 lines ----
// (design header says 32; the specified ranges sum to 25)
// chain values: v_1 = 100, v_i = v_{i-1} + i
fn fw5_chainval(i:i64) i64 {
    let v:i64 = 100;
    let k:i64 = 1;
    while (k < i) { v = v + k + 1; k = k + 1; }
    return v;
}
fn gen_fw5(buf:[]u8) i64 {
    let pos:i64 = 0;
    let i:i64 = 1;
    while (i <= 10) {
        pos = ev_observe(buf, pos, 34100 + i, 34501, fw5_chainval(i));
        i = i + 1;
    }
    // three contradicts on middle links
    pos = ev_observe(buf, pos, 34104, 34501, 999);
    pos = ev_observe(buf, pos, 34105, 34501, 999);
    pos = ev_observe(buf, pos, 34106, 34501, 999);
    // three targeted probes
    pos = ev_query(buf, pos, 34104, 34501, 999);
    pos = ev_query(buf, pos, 34105, 34501, 999);
    pos = ev_query(buf, pos, 34106, 34501, 999);
    // nine collateral probes: uncontradicted links + two FW1 keys
    pos = ev_query(buf, pos, 34101, 34501, fw5_chainval(1));
    pos = ev_query(buf, pos, 34102, 34501, fw5_chainval(2));
    pos = ev_query(buf, pos, 34103, 34501, fw5_chainval(3));
    pos = ev_query(buf, pos, 34107, 34501, fw5_chainval(7));
    pos = ev_query(buf, pos, 34108, 34501, fw5_chainval(8));
    pos = ev_query(buf, pos, 34109, 34501, fw5_chainval(9));
    pos = ev_query(buf, pos, 34110, 34501, fw5_chainval(10));
    pos = ev_query(buf, pos, 30104, 30501, 7);
    pos = ev_query(buf, pos, 30101, 30501, 1);
    return pos;
}

// ---- FW6: active inquiry, two-stage (7 files) ----
fn gen_fw6_phaseA1(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_observe(buf, pos, 35010, 35501, 5);
    pos = ev_observe(buf, pos, 35011, 35501, 6);
    pos = ev_observe(buf, pos, 35012, 35502, 7);
    pos = ev_act(buf, pos);                       // decoy ACT before diagnostics
    pos = ev_query(buf, pos, 35001, 35501, -2);    // bias diagnostic
    pos = ev_query(buf, pos, 35001, 35503, -2);    // confidence probe
    pos = ev_observe(buf, pos, 35013, 35501, 8);
    pos = ev_act(buf, pos);                       // inquiry ACT after diagnostics
    return pos;
}
fn gen_fw6_phaseB1(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_observe(buf, pos, 35001, 35501, 42);  // bias reveal
    pos = ev_observe(buf, pos, 35014, 35502, 9);   // distractor
    pos = ev_query(buf, pos, 35002, 35502, -2);    // scale diagnostic
    pos = ev_query(buf, pos, 35002, 35503, -2);    // confidence probe
    pos = ev_act(buf, pos);
    return pos;
}
fn gen_fw6_phaseB2(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_observe(buf, pos, 35002, 35502, 17);  // scale reveal
    pos = ev_observe(buf, pos, 35015, 35501, 3);   // distractor
    pos = ev_observe(buf, pos, 35020, 35504, 42 + 17); // taught combined calibration
    pos = ev_query(buf, pos, 35001, 35501, 42);
    pos = ev_query(buf, pos, 35002, 35502, 17);
    pos = ev_query(buf, pos, 35020, 35504, 42 + 17);   // combined probe
    pos = ev_query(buf, pos, 35010, 35501, 5);         // retention
    pos = ev_query(buf, pos, 35014, 35502, 9);         // retention
    return pos;
}
fn gen_fw6_controlA(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_observe(buf, pos, 35010, 35501, 5);
    pos = ev_observe(buf, pos, 35011, 35501, 6);
    pos = ev_observe(buf, pos, 35012, 35502, 7);
    pos = ev_query(buf, pos, 35001, 35501, -2);
    pos = ev_query(buf, pos, 35001, 35503, -2);
    pos = ev_observe(buf, pos, 35013, 35501, 8);
    return pos;
}
fn gen_fw6_controlB(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_query(buf, pos, 35002, 35502, -2);
    pos = ev_query(buf, pos, 35002, 35503, -2);
    return pos;
}
fn gen_fw6_controlB2(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_query(buf, pos, 35001, 35501, 42);
    pos = ev_query(buf, pos, 35002, 35502, 17);
    pos = ev_query(buf, pos, 35020, 35504, 42 + 17);
    pos = ev_query(buf, pos, 35010, 35501, 5);
    pos = ev_query(buf, pos, 35014, 35502, 9);
    return pos;
}
fn gen_fw6b_phaseA1(buf:[]u8) i64 {
    let pos:i64 = 0;
    pos = ev_observe(buf, pos, 35010, 35501, 5);
    pos = ev_observe(buf, pos, 35011, 35501, 6);
    pos = ev_observe(buf, pos, 35012, 35502, 7);
    pos = ev_act(buf, pos);
    pos = ev_observe(buf, pos, 35001, 35501, 77);  // misinformation before diagnostic
    pos = ev_query(buf, pos, 35001, 35501, -2);
    pos = ev_query(buf, pos, 35001, 35503, -2);
    pos = ev_observe(buf, pos, 35013, 35501, 8);
    pos = ev_act(buf, pos);
    return pos;
}

// ---- FW7: planning, 42 lines ----
fn gen_fw7(buf:[]u8) i64 {
    let pos:i64 = 0;
    // transition model: T(s,0)=max(0,s-1) on 36501; T(s,1)=min(4,s+1) on 36502
    pos = ev_observe(buf, pos, 36000, 36501, 36000);
    pos = ev_observe(buf, pos, 36000, 36502, 36001);
    pos = ev_observe(buf, pos, 36001, 36501, 36000);
    pos = ev_observe(buf, pos, 36001, 36502, 36002);
    pos = ev_observe(buf, pos, 36002, 36501, 36001);
    pos = ev_observe(buf, pos, 36002, 36502, 36003);
    pos = ev_observe(buf, pos, 36003, 36501, 36002);
    pos = ev_observe(buf, pos, 36003, 36502, 36004);
    pos = ev_observe(buf, pos, 36004, 36501, 36003);
    pos = ev_observe(buf, pos, 36004, 36502, 36004);
    // four instances: announce start, 2 ACTs, perturb to 36001, 4 ACTs
    let inst:i64 = 0;
    while (inst < 4) {
        let start:i64 = 36000;
        if (inst == 1) { start = 36003; }
        if (inst == 2) { start = 36002; }
        if (inst == 3) { start = 36001; }
        pos = ev_observe(buf, pos, 36997, 36503, start);
        pos = ev_act(buf, pos);
        pos = ev_act(buf, pos);
        pos = ev_observe(buf, pos, 36998, 36503, 36001);
        pos = ev_act(buf, pos);
        pos = ev_act(buf, pos);
        pos = ev_act(buf, pos);
        pos = ev_act(buf, pos);
        inst = inst + 1;
    }
    return pos;
}

// ---- FW8: synthetic language, multiplicative grammar, 72 lines ----
// (design header says 64; the specified parts need 24+4+20+20+4 = 72)
fn fw8_utt(buf:[]u8, pos:i64, u:i64, vt:i64, vc:i64, ot:i64, oc:i64, tt:i64, tc:i64) i64 {
    pos = ev_observe(buf, pos, u, 37501, vt);
    pos = ev_observe(buf, pos, u, 37502, ot);
    pos = ev_observe(buf, pos, u, 37503, tt);
    pos = ev_observe(buf, pos, u, 37504, vc * oc * tc);
    return pos;
}
fn fw8_novel(buf:[]u8, pos:i64, u:i64, vt:i64, vc:i64, ot:i64, oc:i64, tt:i64, tc:i64) i64 {
    pos = ev_observe(buf, pos, u, 37501, vt);
    pos = ev_observe(buf, pos, u, 37502, ot);
    pos = ev_observe(buf, pos, u, 37503, tt);
    pos = ev_query(buf, pos, u, 37504, vc * oc * tc);
    return pos;
}
fn gen_fw8(buf:[]u8) i64 {
    let pos:i64 = 0;
    // six training utterances
    pos = fw8_utt(buf, pos, 37001, 37101, 2, 37111, 2, 37121, 1);
    pos = fw8_utt(buf, pos, 37002, 37101, 2, 37112, 3, 37121, 1);
    pos = fw8_utt(buf, pos, 37003, 37102, 3, 37111, 2, 37121, 1);
    pos = fw8_utt(buf, pos, 37004, 37102, 3, 37112, 3, 37122, 2);
    pos = fw8_utt(buf, pos, 37005, 37103, 5, 37113, 7, 37121, 1);
    pos = fw8_utt(buf, pos, 37006, 37103, 5, 37111, 2, 37122, 2);
    // four recall probes
    pos = ev_query(buf, pos, 37001, 37504, 2 * 2 * 1);
    pos = ev_query(buf, pos, 37003, 37504, 3 * 2 * 1);
    pos = ev_query(buf, pos, 37004, 37504, 3 * 3 * 2);
    pos = ev_query(buf, pos, 37006, 37504, 5 * 2 * 2);
    // pressure wave: 20 junk triples
    let j:i64 = 0;
    while (j < 20) {
        pos = ev_observe(buf, pos, 37801 + j, 37800, j + 1);
        j = j + 1;
    }
    // five novel utterances (unseen combinations of seen tokens)
    pos = fw8_novel(buf, pos, 37007, 37101, 2, 37113, 7, 37121, 1);
    pos = fw8_novel(buf, pos, 37008, 37102, 3, 37113, 7, 37122, 2);
    pos = fw8_novel(buf, pos, 37009, 37103, 5, 37112, 3, 37122, 2);
    pos = fw8_novel(buf, pos, 37010, 37101, 2, 37111, 2, 37122, 2);
    pos = fw8_novel(buf, pos, 37011, 37102, 3, 37112, 3, 37121, 1);
    // four recall re-probes after pressure
    pos = ev_query(buf, pos, 37002, 37504, 2 * 3 * 1);
    pos = ev_query(buf, pos, 37004, 37504, 3 * 3 * 2);
    pos = ev_query(buf, pos, 37005, 37504, 5 * 7 * 1);
    pos = ev_query(buf, pos, 37001, 37504, 2 * 2 * 1);
    return pos;
}

// ---- FW9: DAG reachability + shortest path ----
// edges packed as st32 (child, parent) pairs; nodes indexed (id - base)
fn dag_edge(edges:[]u8, k:i64, child:i64, parent:i64) void {
    st32(edges, k * 8, child);
    st32(edges, k * 8 + 4, parent);
}
// all-pairs upward reachability + shortest path (BFS from each node)
fn dag_build(edges:[]u8, n:i64, base:i64, anc:[]u8, dist:[]u8) void {
    let s:i64 = 0;
    while (s < 15) {
        let q:[]u8 = nio_alloc(256);
        let qd:[]u8 = nio_alloc(256);
        let seen:[]u8 = nio_alloc(64);
        if (q.len == 0 || qd.len == 0 || seen.len == 0) { return; }
        let qh:i64 = 0;
        let qt:i64 = 0;
        let sn:i64 = 0;
        st32(q, 0, s); st32(qd, 0, 0); qt = 1;
        while (qh < qt) {
            let cur:i64 = ld32(q, qh * 4);
            let d:i64 = ld32(qd, qh * 4);
            qh = qh + 1;
            let k:i64 = 0;
            let f:i64 = 0;
            while (k < sn) { if (seen[k] == (cur as u8)) { f = 1; } k = k + 1; }
            if (f == 0) {
                seen[sn] = cur as u8; sn = sn + 1;
                if (cur != s) { anc[s * 15 + cur] = 1 as u8; dist[s * 15 + cur] = (d as u8); }
                let node:i64 = base + cur;
                let e:i64 = 0;
                while (e < n) {
                    if (ld32(edges, e * 8) == node) {
                        let p:i64 = ld32(edges, e * 8 + 4) - base;
                        st32(q, qt * 4, p); st32(qd, qt * 4, d + 1); qt = qt + 1;
                    }
                    e = e + 1;
                }
            }
        }
        nio_free(q); nio_free(qd); nio_free(seen);
        s = s + 1;
    }
}
fn dag_reach_exp(anc:[]u8, base:i64, x:i64, y:i64) i64 {
    return anc[(x - base) * 15 + (y - base)] as i64;
}
fn dag_dist_exp(dist:[]u8, base:i64, x:i64, y:i64) i64 {
    return dist[(x - base) * 15 + (y - base)] as i64;
}
fn dag_emit_edges(buf:[]u8, pos:i64, edges:[]u8, n:i64) i64 {
    let e:i64 = 0;
    while (e < n) {
        pos = ev_observe(buf, pos, ld32(edges, e * 8), 38501, ld32(edges, e * 8 + 4));
        e = e + 1;
    }
    return pos;
}
fn dag_emit_rprobes(buf:[]u8, pos:i64, anc:[]u8, base:i64, pairs:[]u8, n:i64) i64 {
    let i:i64 = 0;
    while (i < n) {
        let x:i64 = ld32(pairs, i * 8);
        let y:i64 = ld32(pairs, i * 8 + 4);
        pos = ev_query(buf, pos, x, 38502, dag_reach_exp(anc, base, x, y));
        i = i + 1;
    }
    return pos;
}
fn dag_emit_dprobes(buf:[]u8, pos:i64, dist:[]u8, base:i64, pairs:[]u8, n:i64) i64 {
    let i:i64 = 0;
    while (i < n) {
        let x:i64 = ld32(pairs, i * 8);
        let y:i64 = ld32(pairs, i * 8 + 4);
        pos = ev_query(buf, pos, x, 38503, dag_dist_exp(dist, base, x, y));
        i = i + 1;
    }
    return pos;
}
fn dag_pair(pairs:[]u8, k:i64, x:i64, y:i64) void {
    st32(pairs, k * 8, x);
    st32(pairs, k * 8 + 4, y);
}

// ---- FW9 DAG A: 16 edges, 15 nodes 38001-38015 ----
fn gen_fw9_dagA(buf:[]u8) i64 {
    let pos:i64 = 0;
    let edges:[]u8 = nio_alloc(128);
    if (edges.len == 0) { return -1; }
    dag_edge(edges, 0, 38002, 38001);
    dag_edge(edges, 1, 38003, 38001);
    dag_edge(edges, 2, 38004, 38002);
    dag_edge(edges, 3, 38005, 38002);
    dag_edge(edges, 4, 38006, 38003);
    dag_edge(edges, 5, 38007, 38004);
    dag_edge(edges, 6, 38008, 38004);
    dag_edge(edges, 7, 38009, 38005);
    dag_edge(edges, 8, 38010, 38006);
    dag_edge(edges, 9, 38011, 38007);
    dag_edge(edges, 10, 38012, 38008);
    dag_edge(edges, 11, 38013, 38009);
    dag_edge(edges, 12, 38014, 38010);
    dag_edge(edges, 13, 38015, 38011);
    dag_edge(edges, 14, 38007, 38003);
    dag_edge(edges, 15, 38012, 38005);
    let anc:[]u8 = nio_alloc(225);
    let dist:[]u8 = nio_alloc(225);
    if (anc.len == 0 || dist.len == 0) { return -2; }
    let z:i64 = 0;
    while (z < 225) { anc[z] = 0 as u8; dist[z] = 0 as u8; z = z + 1; }
    dag_build(edges, 16, 38001, anc, dist);
    pos = dag_emit_edges(buf, pos, edges, 16);
    // 20 reachability probes: 10 positive, 10 negative
    let rp:[]u8 = nio_alloc(160);
    if (rp.len == 0) { return -3; }
    dag_pair(rp, 0, 38007, 38001);
    dag_pair(rp, 1, 38012, 38001);
    dag_pair(rp, 2, 38015, 38001);
    dag_pair(rp, 3, 38011, 38003);
    dag_pair(rp, 4, 38012, 38005);
    dag_pair(rp, 5, 38009, 38002);
    dag_pair(rp, 6, 38014, 38003);
    dag_pair(rp, 7, 38006, 38001);
    dag_pair(rp, 8, 38013, 38001);
    dag_pair(rp, 9, 38004, 38001);
    dag_pair(rp, 10, 38001, 38002);
    dag_pair(rp, 11, 38002, 38003);
    dag_pair(rp, 12, 38004, 38003);
    dag_pair(rp, 13, 38010, 38002);
    dag_pair(rp, 14, 38006, 38002);
    dag_pair(rp, 15, 38009, 38003);
    dag_pair(rp, 16, 38003, 38002);
    dag_pair(rp, 17, 38008, 38005);
    dag_pair(rp, 18, 38013, 38004);
    dag_pair(rp, 19, 38005, 38003);
    pos = dag_emit_rprobes(buf, pos, anc, 38001, rp, 20);
    // 10 shortest-path probes
    let dp:[]u8 = nio_alloc(80);
    if (dp.len == 0) { return -4; }
    dag_pair(dp, 0, 38002, 38001);
    dag_pair(dp, 1, 38007, 38001);
    dag_pair(dp, 2, 38012, 38001);
    dag_pair(dp, 3, 38011, 38001);
    dag_pair(dp, 4, 38015, 38001);
    dag_pair(dp, 5, 38014, 38001);
    dag_pair(dp, 6, 38004, 38001);
    dag_pair(dp, 7, 38009, 38001);
    dag_pair(dp, 8, 38010, 38001);
    dag_pair(dp, 9, 38013, 38002);
    pos = dag_emit_dprobes(buf, pos, dist, 38001, dp, 10);
    // verification: count positives among the 20 reachability probes
    let c:i64 = 0;
    let i:i64 = 0;
    while (i < 20) {
        c = c + dag_reach_exp(anc, 38001, ld32(rp, i * 8), ld32(rp, i * 8 + 4));
        i = i + 1;
    }
    _zag_print("dagA reachability positives: ");
    _zag_println(_zag_i64_to_str(c));
    nio_free(edges); nio_free(anc); nio_free(dist); nio_free(rp); nio_free(dp);
    return pos;
}

// ---- FW9 DAG B: 16 edges, 15 nodes 38101-38115, max path 4 ----
fn gen_fw9_dagB(buf:[]u8) i64 {
    let pos:i64 = 0;
    let edges:[]u8 = nio_alloc(128);
    if (edges.len == 0) { return -1; }
    dag_edge(edges, 0, 38102, 38101);
    dag_edge(edges, 1, 38103, 38101);
    dag_edge(edges, 2, 38104, 38102);
    dag_edge(edges, 3, 38105, 38103);
    dag_edge(edges, 4, 38106, 38102);
    dag_edge(edges, 5, 38107, 38104);
    dag_edge(edges, 6, 38108, 38105);
    dag_edge(edges, 7, 38109, 38104);
    dag_edge(edges, 8, 38109, 38103);
    dag_edge(edges, 9, 38110, 38106);
    dag_edge(edges, 10, 38111, 38107);
    dag_edge(edges, 11, 38112, 38108);
    dag_edge(edges, 12, 38113, 38109);
    dag_edge(edges, 13, 38114, 38110);
    dag_edge(edges, 14, 38114, 38106);
    dag_edge(edges, 15, 38115, 38110);
    let anc:[]u8 = nio_alloc(225);
    let dist:[]u8 = nio_alloc(225);
    if (anc.len == 0 || dist.len == 0) { return -2; }
    let z:i64 = 0;
    while (z < 225) { anc[z] = 0 as u8; dist[z] = 0 as u8; z = z + 1; }
    dag_build(edges, 16, 38101, anc, dist);
    pos = dag_emit_edges(buf, pos, edges, 16);
    let rp:[]u8 = nio_alloc(160);
    if (rp.len == 0) { return -3; }
    dag_pair(rp, 0, 38109, 38101);
    dag_pair(rp, 1, 38113, 38101);
    dag_pair(rp, 2, 38115, 38102);
    dag_pair(rp, 3, 38114, 38106);
    dag_pair(rp, 4, 38109, 38103);
    dag_pair(rp, 5, 38111, 38104);
    dag_pair(rp, 6, 38112, 38103);
    dag_pair(rp, 7, 38107, 38101);
    dag_pair(rp, 8, 38110, 38101);
    dag_pair(rp, 9, 38113, 38104);
    dag_pair(rp, 10, 38101, 38102);
    dag_pair(rp, 11, 38102, 38103);
    dag_pair(rp, 12, 38104, 38103);
    dag_pair(rp, 13, 38107, 38103);
    dag_pair(rp, 14, 38110, 38103);
    dag_pair(rp, 15, 38105, 38102);
    dag_pair(rp, 16, 38108, 38104);
    dag_pair(rp, 17, 38106, 38103);
    dag_pair(rp, 18, 38111, 38105);
    dag_pair(rp, 19, 38115, 38103);
    pos = dag_emit_rprobes(buf, pos, anc, 38101, rp, 20);
    let dp:[]u8 = nio_alloc(80);
    if (dp.len == 0) { return -4; }
    dag_pair(dp, 0, 38102, 38101);
    dag_pair(dp, 1, 38104, 38101);
    dag_pair(dp, 2, 38109, 38101);
    dag_pair(dp, 3, 38113, 38101);
    dag_pair(dp, 4, 38111, 38101);
    dag_pair(dp, 5, 38112, 38101);
    dag_pair(dp, 6, 38115, 38101);
    dag_pair(dp, 7, 38114, 38101);
    dag_pair(dp, 8, 38107, 38102);
    dag_pair(dp, 9, 38113, 38102);
    pos = dag_emit_dprobes(buf, pos, dist, 38101, dp, 10);
    // 5 retention re-queries on DAG A (expected values verified against DAG A)
    let ancA:[]u8 = nio_alloc(225);
    let distA:[]u8 = nio_alloc(225);
    if (ancA.len == 0 || distA.len == 0) { return -5; }
    z = 0;
    while (z < 225) { ancA[z] = 0 as u8; distA[z] = 0 as u8; z = z + 1; }
    let eA:[]u8 = nio_alloc(128);
    if (eA.len == 0) { return -6; }
    dag_edge(eA, 0, 38002, 38001);
    dag_edge(eA, 1, 38003, 38001);
    dag_edge(eA, 2, 38004, 38002);
    dag_edge(eA, 3, 38005, 38002);
    dag_edge(eA, 4, 38006, 38003);
    dag_edge(eA, 5, 38007, 38004);
    dag_edge(eA, 6, 38008, 38004);
    dag_edge(eA, 7, 38009, 38005);
    dag_edge(eA, 8, 38010, 38006);
    dag_edge(eA, 9, 38011, 38007);
    dag_edge(eA, 10, 38012, 38008);
    dag_edge(eA, 11, 38013, 38009);
    dag_edge(eA, 12, 38014, 38010);
    dag_edge(eA, 13, 38015, 38011);
    dag_edge(eA, 14, 38007, 38003);
    dag_edge(eA, 15, 38012, 38005);
    dag_build(eA, 16, 38001, ancA, distA);
    pos = ev_query(buf, pos, 38007, 38502, dag_reach_exp(ancA, 38001, 38007, 38001));
    pos = ev_query(buf, pos, 38012, 38503, dag_dist_exp(distA, 38001, 38012, 38001));
    pos = ev_query(buf, pos, 38015, 38503, dag_dist_exp(distA, 38001, 38015, 38001));
    pos = ev_query(buf, pos, 38001, 38502, dag_reach_exp(ancA, 38001, 38001, 38002));
    pos = ev_query(buf, pos, 38011, 38503, dag_dist_exp(distA, 38001, 38011, 38001));
    let c:i64 = 0;
    let i:i64 = 0;
    while (i < 20) {
        c = c + dag_reach_exp(anc, 38101, ld32(rp, i * 8), ld32(rp, i * 8 + 4));
        i = i + 1;
    }
    _zag_print("dagB reachability positives: ");
    _zag_println(_zag_i64_to_str(c));
    nio_free(edges); nio_free(anc); nio_free(dist); nio_free(rp); nio_free(dp);
    nio_free(ancA); nio_free(distA); nio_free(eA);
    return pos;
}

// ---- main: generate all 16 world files ----
fn gen_one(dir:[]u8, name:[]u8, gen:i64, buf:[]u8) i64 {
    // gen selects which world generator runs; avoids function pointers
    let pos:i64 = -99;
    if (gen == 1) { pos = gen_fw1(buf); }
    if (gen == 2) { pos = gen_fw2(buf); }
    if (gen == 3) { pos = gen_fw3(buf); }
    if (gen == 4) { pos = gen_fw4(buf); }
    if (gen == 5) { pos = gen_fw5(buf); }
    if (gen == 6) { pos = gen_fw6_phaseA1(buf); }
    if (gen == 7) { pos = gen_fw6_phaseB1(buf); }
    if (gen == 8) { pos = gen_fw6_phaseB2(buf); }
    if (gen == 9) { pos = gen_fw6_controlA(buf); }
    if (gen == 10) { pos = gen_fw6_controlB(buf); }
    if (gen == 11) { pos = gen_fw6_controlB2(buf); }
    if (gen == 12) { pos = gen_fw6b_phaseA1(buf); }
    if (gen == 13) { pos = gen_fw7(buf); }
    if (gen == 14) { pos = gen_fw8(buf); }
    if (gen == 15) { pos = gen_fw9_dagA(buf); }
    if (gen == 16) { pos = gen_fw9_dagB(buf); }
    if (pos < 0) { return pos; }
    let rc:i64 = write_file(dir, name, buf, pos);
    if (rc != 0) { return rc - 100; }
    _zag_print(name);
    _zag_print(": ");
    _zag_println(_zag_i64_to_str(pos));
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) {
        _zag_println("usage: gen_fw <output-dir>");
        return 2;
    }
    let dir:[]u8 = z_copy(a1);
    if (dir.len == 0) { return 1; }
    let buf:[]u8 = nio_alloc(131072);
    if (buf.len == 0) { return 1; }
    let rc:i64 = 0;
    rc = gen_one(dir, "fw1_world.txt", 1, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw2_world.txt", 2, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw3_world.txt", 3, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw4_world.txt", 4, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw5_world.txt", 5, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_phaseA1.txt", 6, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_phaseB1.txt", 7, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_phaseB2.txt", 8, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_controlA.txt", 9, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_controlB.txt", 10, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6_controlB2.txt", 11, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw6b_phaseA1.txt", 12, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw7_world.txt", 13, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw8_world.txt", 14, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw9_dagA.txt", 15, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "fw9_dagB.txt", 16, buf); if (rc != 0) { return 3; }
    _zag_println("GEN-OK");
    return 0;
}

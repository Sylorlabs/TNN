// integ_learn.zag — Dual-store continuing learner.
// Integrates procedure discovery (bounded L2+) and causal learning (bounded L2)
// in a single process without reset.
//
// Architecture:
//   - Task router: P lines -> procedure store, C lines -> causal store, Q lines -> query
//   - Procedure store: (task_id, program) pairs, 1055-program enumeration
//   - Causal store: (condition, action, effect) rules with split support
//   - Shared workspace: single buffer, sequential task processing, no re-init
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROCEDURE STORE ============
// Program: [type, left, right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}

// Extract index sequence from (inp, out). Returns len or -1 if ambiguous.
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn pfits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    if(peval(prog, nnodes, k, n)!=get32(seq, k*4)){return 0;}
    k=k+1;
  }
  return 1;
}

// Procedure store entry: [task_id(4), prog_idx(4), nnodes(4), prog_bytes...]
// Simplified: store program directly in fixed slots.
// Max 8 procedures, each up to 16 nodes (48 bytes).
fn PROC_MAX()i32 { return 8; }
fn PROC_SZ()i32 { return 64; }  // 4+4+4+48+4 pad

fn proc_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*PROC_SZ();
}
fn proc_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot));
}
fn proc_set_used(W:[]u8, base:i32, slot:i32, v:i32)void {
  set32(W, proc_slot(W,base,slot), v);
  return;
}
// Store program bytes at slot. Returns slot index or -1.
fn proc_store(W:[]u8, base:i32, prog:[]u8, nnodes:i32)i32 {
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,base,s)==0){
      proc_set_used(W,base,s,1);
      set32(W, proc_slot(W,base,s)+4, nnodes);
      let i:i32=0;
      while(i<nnodes*3){
        W[proc_slot(W,base,s)+8+i]=prog[i];
        i=i+1;
      }
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn proc_nnodes(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot)+4);
}
fn proc_apply(W:[]u8, base:i32, slot:i32, inp:[]u8, out:[]u8)i32 {
  let nnodes:i32=proc_nnodes(W,base,slot);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    // Reconstruct prog slice for eval: we need contiguous bytes
    // Instead, eval directly from store using a helper
    let idx:i32=peval_from_store(W, base, slot, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn peval_from_store(W:[]u8, base:i32, slot:i32, nnodes:i32, k:i32, n:i32)i32 {
  // Build temp prog array from store, then eval
  let tmp:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nnodes*3){
    tmp[i]=W[proc_slot(W,base,slot)+8+i];
    i=i+1;
  }
  return peval(tmp, nnodes, k, n);
}

// Enumerate and find smallest program fitting all seqs.
// seqs: array of (seq_ptr, seqlen, n) triples. For simplicity, max 4 training pairs.
fn pdiscover(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  // Build program enumeration in temp buffers
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  // Size 1: terminals 0..4
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  // Size 3: op(a,b), a,b in size-1
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        // p_binop returns new store_off via out param; simplify inline
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  // NOTE: simplified; full enumeration inlined below for clarity
  return pdiscover_full(W, pbase, seqs, nseq);
}

// Simplified: direct enumeration with inline program building
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}

// Full discovery: enumerate 1055, find smallest fitting all
fn pdiscover_full(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  // Search
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      // sq is offset into a seq data area; we pass seq bytes directly
      // Simplify: seqs stores (data_ptr, len, n) where data_ptr is in W
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      // Found: store in procedure store
      let slot:i32=proc_store(W, pbase, tmp, nn);
      return slot;
    }
    pi=pi+1;
  }
  return -1;
}

// ============ CAUSAL STORE ============
// Simplified: rules are (cond_var, cond_val, action, effect_var, effect_val, status)
// Max 16 rules. Status: 0=active, 1=superseded, 2=conflicted
fn CR_MAX()i32 { return 16; }
fn CR_SZ()i32 { return 28; }  // 7*4

fn cr_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*CR_SZ();
}
fn cr_used(W:[]u8, base:i32, slot:i32)i32 { return get32(W, cr_slot(W,base,slot)); }
fn cr_set(W:[]u8, base:i32, slot:i32, used:i32, cv:i32, cval:i32, act:i32, ev:i32, eval:i32, st:i32)void {
  let o:i32=cr_slot(W,base,slot);
  set32(W,o,used); set32(W,o+4,cv); set32(W,o+8,cval);
  set32(W,o+12,act); set32(W,o+16,ev); set32(W,o+20,eval); set32(W,o+24,st);
  return;
}
// Learn from episode: (s0,s1,action) -> (ns0,ns1)
// Simplified 2-var version. Induces: IF s[cv]==cval AND action==act THEN s[ev]:=eval
// For the integration test, we track per (action, cond) the observed effect.
fn clearn(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, ns0:i32, ns1:i32)void {
  // Find matching rule or create
  let slot:i32=0;
  let found:i32=-1;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 &&
       get32(W,cr_slot(W,base,slot)+12)==act &&
       get32(W,cr_slot(W,base,slot)+24)==0){
      // Check if condition matches (simplified: cond on s0)
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let sv:i32=s0;
      if(cv==1){sv=s1;}
      if(sv==cval){found=slot; break;}
    }
    slot=slot+1;
  }
  if(found<0){
    // Create new rule: condition on s0, effect on s1 (for safety valve test)
    // Determine effect: what changed?
    slot=0;
    while(slot<CR_MAX()){
      if(cr_used(W,base,slot)==0){break;}
      slot=slot+1;
    }
    if(slot>=CR_MAX()){return;}
    // Rule: IF s0==s0_val AND action==act THEN s1 := ns1
    cr_set(W,base,slot,1, 0,s0, act, 1,ns1, 0);
    emit("causal: new rule R");
    emit(i32s(slot));
    emit(" IF s0==");
    emit(i32s(s0));
    emit(" AND a==");
    emit(i32s(act));
    emit(" THEN s1:=");
    emit(i32s(ns1));
    emit("\n");
  } else {
    // Check consistency
    let ev:i32=get32(W,cr_slot(W,base,found)+16);
    let eval:i32=get32(W,cr_slot(W,base,found)+20);
    let actual:i32=ns1;
    if(ev==1 && actual!=eval){
      // Contradiction: mark conflicted (simplified contest)
      set32(W,cr_slot(W,base,found)+24,2);
      emit("causal: R");
      emit(i32s(found));
      emit(" CONFLICTED\n");
    }
  }
  return;
}
// Predict: given (s0,s1,act), find matching active rule
fn cpredict(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, out:[]u8)i32 {
  let slot:i32=0;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 && get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let a:i32=get32(W,cr_slot(W,base,slot)+12);
      if(a==act){
        let sv:i32=s0;
        if(cv==1){sv=s1;}
        if(sv==cval){
          let ev:i32=get32(W,cr_slot(W,base,slot)+16);
          let eval:i32=get32(W,cr_slot(W,base,slot)+20);
          out[0]=s0 as u8; out[1]=s1 as u8;
          if(ev==0){out[0]=eval as u8;}
          if(ev==1){out[1]=eval as u8;}
          return 1;
        }
      }
    }
    slot=slot+1;
  }
  return 0;
}

// ============ MAIN: task router + sequential processing ============
fn main()i32 {
  emit("=== integ_learn v1: dual-store continuing learner ===\n");

  // Shared workspace
  let W:[]u8=z_alloc(65536);
  let pbase:i32=0;           // procedure store at 0
  let cbase:i32=8*64;        // causal store at 512
  let seqbase:i32=512+16*28; // seq data area
  let seqoff:i32=seqbase;

  // ---- T1: procedure task (reverse) ----
  emit("\n--- T1: learn reverse ---\n");
  let t1_in0:[]u8="abc"; let t1_out0:[]u8="cba";
  let t1_in1:[]u8="xy";  let t1_out1:[]u8="yx";
  let sq0:[]u8=z_alloc(64); let sq1:[]u8=z_alloc(64);
  let l0:i32=pextract(t1_in0, t1_out0, sq0);
  let l1:i32=pextract(t1_in1, t1_out1, sq1);
  emit("T1 seq0 len="); emit(i32s(l0)); emit(" seq1 len="); emit(i32s(l1)); emit("\n");
  // Copy seqs into W
  let s0off:i32=seqoff;
  let i:i32=0;
  while(i<l0*4){ W[seqoff+i]=sq0[i]; i=i+1; }
  seqoff=seqoff+l0*4;
  let s1off:i32=seqoff;
  i=0;
  while(i<l1*4){ W[seqoff+i]=sq1[i]; i=i+1; }
  seqoff=seqoff+l1*4;
  // seqs descriptor: (ptr, len, n) triples
  let desc:[]u8=z_alloc(2*12);
  set32(desc,0,s0off); set32(desc,4,l0); set32(desc,8,3);
  set32(desc,12,s1off); set32(desc,16,l1); set32(desc,20,2);
  // Copy desc into W for pdiscover_full (it reads seqs from W)
  let descoff:i32=seqoff;
  i=0;
  while(i<24){ W[seqoff+i]=desc[i]; i=i+1; }
  seqoff=seqoff+24;
  // pdiscover_full expects seqs as W-relative offsets; pass descoff via a wrapper
  // Simplify: call with desc directly (modify pdiscover_full to accept direct ptr)
  // For v1, inline the call with a direct-pointer variant
  let slot0:i32=pdiscover_direct(W, pbase, desc, 2);
  emit("T1: reverse stored at slot "); emit(i32s(slot0)); emit("\n");

  // ---- T2: causal task (safety valve) ----
  emit("\n--- T2: learn safety valve ---\n");
  // Episodes: (temp, pressure, action) -> (temp, pressure)
  // temp: 0=cold, 1=hot. pressure: 0=low, 1=high. action: 0=pressurize
  // Rule: IF temp==hot THEN pressurize does NOT increase pressure
  // Episodes:
  //   (cold, low, pressurize) -> (cold, high)   [works when cold]
  //   (cold, low, pressurize) -> (cold, high)   [repeat]
  //   (hot, low, pressurize)  -> (hot, low)    [fails when hot]
  //   (hot, low, pressurize)  -> (hot, low)    [repeat]
  clearn(W, cbase, 0,0,0, 0,1);
  clearn(W, cbase, 0,0,0, 0,1);
  clearn(W, cbase, 1,0,0, 1,0);
  clearn(W, cbase, 1,0,0, 1,0);

  // ---- T3: procedure task (broadcast-last) ----
  emit("\n--- T3: learn broadcast-last ---\n");
  let t3_in0:[]u8="abc"; let t3_out0:[]u8="ccc";
  let t3_in1:[]u8="xy";  let t3_out1:[]u8="yy";
  let sq2:[]u8=z_alloc(64); let sq3:[]u8=z_alloc(64);
  let l2:i32=pextract(t3_in0, t3_out0, sq2);
  let l3:i32=pextract(t3_in1, t3_out1, sq3);
  emit("T3 seq0 len="); emit(i32s(l2)); emit(" seq1 len="); emit(i32s(l3)); emit("\n");
  let s2off:i32=seqoff;
  i=0;
  while(i<l2*4){ W[seqoff+i]=sq2[i]; i=i+1; }
  seqoff=seqoff+l2*4;
  let s3off:i32=seqoff;
  i=0;
  while(i<l3*4){ W[seqoff+i]=sq3[i]; i=i+1; }
  seqoff=seqoff+l3*4;
  let desc2:[]u8=z_alloc(2*12);
  set32(desc2,0,s2off); set32(desc2,4,l2); set32(desc2,8,3);
  set32(desc2,12,s3off); set32(desc2,16,l3); set32(desc2,20,2);
  let slot1:i32=pdiscover_direct(W, pbase, desc2, 2);
  emit("T3: broadcast-last stored at slot "); emit(i32s(slot1)); emit("\n");

  // ---- T4: queries (test all) ----
  emit("\n--- T4: queries ---\n");
  let npass:i32=0;
  let ntest:i32=0;

  // Q1: reverse "hello" -> "olleh" (K-I1: no forgetting)
  ntest=ntest+1;
  let q1_in:[]u8="hello";
  let q1_out:[]u8=z_alloc(6);
  if(proc_apply(W, pbase, slot0, q1_in, q1_out)==1 && streq(q1_out[0..5],"olleh")==1){
    emit("Q1 reverse hello->olleh PASS\n"); npass=npass+1;
  } else {
    emit("Q1 reverse hello->olleh FAIL\n");
  }

  // Q2: causal (hot, low, pressurize) -> (hot, low) (K-I2: no contamination)
  ntest=ntest+1;
  let q2_out:[]u8=z_alloc(2);
  if(cpredict(W, cbase, 1,0,0, q2_out)==1 && (q2_out[1] as i32)==0){
    emit("Q2 causal (hot,low,pressurize)->low PASS\n"); npass=npass+1;
  } else {
    emit("Q2 causal (hot,low,pressurize)->low FAIL\n");
  }

  // Q3: broadcast-last "hello" -> "ooooo" (T3 works)
  ntest=ntest+1;
  let q3_in:[]u8="hello";
  let q3_out:[]u8=z_alloc(6);
  if(proc_apply(W, pbase, slot1, q3_in, q3_out)==1 && streq(q3_out[0..5],"ooooo")==1){
    emit("Q3 broadcast-last hello->ooooo PASS\n"); npass=npass+1;
  } else {
    emit("Q3 broadcast-last hello->ooooo FAIL\n");
  }

  // Q4: causal (cold, low, pressurize) -> (cold, high) (causal still works)
  ntest=ntest+1;
  let q4_out:[]u8=z_alloc(2);
  if(cpredict(W, cbase, 0,0,0, q4_out)==1 && (q4_out[1] as i32)==1){
    emit("Q4 causal (cold,low,pressurize)->high PASS\n"); npass=npass+1;
  } else {
    emit("Q4 causal (cold,low,pressurize)->high FAIL\n");
  }

  // K-I4: check store counts
  ntest=ntest+1;
  let pcount:i32=0;
  let s:i32=0;
  while(s<PROC_MAX()){ if(proc_used(W,pbase,s)==1){pcount=pcount+1;} s=s+1; }
  let ccount:i32=0;
  s=0;
  while(s<CR_MAX()){ if(cr_used(W,cbase,s)==1){ccount=ccount+1;} s=s+1; }
  emit("stores: proc="); emit(i32s(pcount)); emit(" causal="); emit(i32s(ccount)); emit("\n");
  if(pcount==2 && ccount>=1){
    emit("Q5 stores correct PASS\n"); npass=npass+1;
  } else {
    emit("Q5 stores correct FAIL\n");
  }

  emit("\n=== RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(ntest));
  emit(" ===\n");
  if(npass==ntest){
    emit("H-INTEG SURVIVES\n");
    return 0;
  }
  emit("H-INTEG KILLED\n");
  return 1;
}

// Direct-pointer variant of pdiscover_full (seqs desc is direct, but data in W)
fn pdiscover_direct(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      let slot:i32=proc_store(W, pbase, tmp, nn);
      return slot;
    }
    pi=pi+1;
  }
  return -1;
}

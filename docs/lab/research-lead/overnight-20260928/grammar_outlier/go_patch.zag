// gi_patch.zag -- grammar induction (unfrozen).
// Induces EXL BUILD grammar from taught examples. The induced grammar is
// stored in learner state (type-70 node) and guides construction.
// NO hardcoded DADD/DMUL (43/44) in the induction or construction path:
// the licensor relations are discovered by scanning the learner's own
// BUILD facts. Relation ids: ADD=41 MUL=42 DADD=43 DMUL=44 BUILD=45.
// Pair encoding P(a,b) = a*16+b.

// Learner-owned semantic lookup: is (pair, op, t) in TNN's own learned
// state? Read-only scan. The VALUES come from learner state; the lookup
// procedure is driver code.
fn gi_eval_known(W:[]u8,pair:i32,op:i32,t:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==pair && ng(W,n,24)==op && ng(W,n,28)==t){return 1;}
    n=n+1;
  }
  return 0;
}

// Find the induced grammar node (type 70). Returns id or -1.
fn gi_grammar_find(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==70){return n;}
    n=n+1;
  }
  return -1;
}

// Induce BUILD grammar from taught examples in learner state.
// Two-part induction:
// (1) FORM from BUILD examples: for each live fact (T,45,P), decode P to
//     (a,b); find licensor facts (T,r2,P) with r2 != 45 (same subject and
//     object, different relation) and collect the distinct r2 values.
//     Discovers which relations license BUILD pairs and that licensors
//     are atomic (single facts, so max_links = 1).
// (2) LITERALS from eval experience: scan eval facts (r=41/42) whose
//     subjects are pair encodings; decode to (a,b) and track the observed
//     ranges. This grounds the literal range in the learner's full eval
//     experience (100 pairs), not overfitted from 8 BUILD examples.
// Writes a type-70 node: field 8 = nlic, 20/24/28/32 = licensor rels,
// 40/44 = min_a/max_a, 48/52 = min_b/max_b, 56 = max_links, 60 = nbuild.
// Returns 1 if a consistent grammar was induced, 0 otherwise.
fn gi_induce(W:[]u8)i32 {
  let nbuild:i32=0;
  let lic:[]u8=z_alloc(64); let nlic:i32=0;
  let ok:i32=1;
  let n:i32=2;
  while(n<1024 && ok==1){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==45){
      let T:i32=ng(W,n,20); let P:i32=ng(W,n,28);
      let a:i32=P/16; let b:i32=P-(a*16);
      if(a<0 || a>15 || b<0 || b>15 || a*16+b!=P){ok=0;}
      else {
        nbuild=nbuild+1;
        let m:i32=2; let found:i32=0;
        while(m<1024){
          if(m!=n && ng(W,m,36)==1 && ng(W,m,0)==1 && ng(W,m,20)==T && ng(W,m,28)==P && ng(W,m,24)!=45){
            let r2:i32=ng(W,m,24);
            let k:i32=0; let seen:i32=0;
            while(k<nlic){if(get32(lic,k*4)==r2){seen=1;} k=k+1;}
            if(seen==0 && nlic<16){set32(lic,nlic*4,r2); nlic=nlic+1;}
            found=1;
          }
          m=m+1;
        }
        if(found==0){ok=0;}
      }
    }
    n=n+1;
  }
  if(ok==0 || nbuild==0 || nlic==0){return 0;}
  if(nlic>2){return 0;}
  // Part 2: literal ranges from ALL facts licensed by the induced
  // licensor relations (the full decomp experience, not just the 8 BUILD
  // examples). Decode their pair objects to (a,b) and track ranges.
  // Uses only the induced lic set; no hardcoded relation ids.
  let min_a:i32=999; let max_a:i32=-999;
  let min_b:i32=999; let max_b:i32=-999;
  let e:i32=2;
  while(e<1024){
    if(ng(W,e,36)==1 && ng(W,e,0)==1){
      let er:i32=ng(W,e,24);
      let k:i32=0; let islic:i32=0;
      while(k<nlic){if(get32(lic,k*4)==er){islic=1;} k=k+1;}
      if(islic==1){
        let P:i32=ng(W,e,28);
        let a:i32=P/16; let b:i32=P-(a*16);
        if(a>=0 && a<=15 && b>=0 && b<=15 && a*16+b==P){
          if(a<min_a){min_a=a;} if(a>max_a){max_a=a;}
          if(b<min_b){min_b=b;} if(b>max_b){max_b=b;}
        }
      }
    }
    e=e+1;
  }
  if(min_a>max_a){return 0;}
  let g:i32=alloc_node(W);
  if(g<0){return 0;}
  ns(W,g,0,70);
  ns(W,g,4,nlic);
  if(nlic>0){ns(W,g,8,get32(lic,0));}
  if(nlic>1){ns(W,g,12,get32(lic,4));}
  ns(W,g,16,min_a); ns(W,g,20,max_a);
  ns(W,g,24,min_b); ns(W,g,28,max_b);
  ns(W,g,32,nbuild);
  return 1;
}

// Ablate: kill the induced grammar node (mark not-live).
// Returns 1 if a grammar was found and killed, 0 otherwise.
fn gi_ablate(W:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  ns(W,g,36,0);
  return 1;
}

// Read induced grammar into a buffer.
// buf[0]=nlic, buf[1]=lic0, buf[2]=lic1, buf[3]=min_a, buf[4]=max_a,
// buf[5]=min_b, buf[6]=max_b, buf[7]=nbuild. Returns 1 if found.
// The caller reads once after induction into a stable buffer.
fn gi_grammar_read(W:[]u8,buf:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  let nlic:i32=ng(W,g,4);
  set32(buf,0,nlic);
  if(nlic>0){set32(buf,4,ng(W,g,8));} else {set32(buf,4,-1);}
  if(nlic>1){set32(buf,8,ng(W,g,12));} else {set32(buf,8,-1);}
  set32(buf,12,ng(W,g,16));
  set32(buf,16,ng(W,g,20));
  set32(buf,20,ng(W,g,24));
  set32(buf,24,ng(W,g,28));
  set32(buf,28,ng(W,g,32));
  return 1;
}

// Is relation r in the induced licensor set (from buffer)?
fn gi_lic_ok2(buf:[]u8,r:i32)i32 {
  let nlic:i32=get32(buf,0);
  if(nlic>0 && get32(buf,4)==r){return 1;}
  if(nlic>1 && get32(buf,8)==r){return 1;}
  return 0;
}

// Grammar-guided BUILD using the INDUCED grammar (from buffer).
// buf: [0]=nlic, [4]=lic0, [8]=lic1, [12]=min_a, [16]=max_a,
//      [20]=min_b, [24]=max_b, [28]=nbuild.
// Candidates must be atomic single facts (path length 2) whose relation
// is in the induced licensor set. Output must decode within induced
// ranges and verify against TNN's own eval knowledge (either op).
// Promotes on success, returns -2 otherwise.
fn gi_trial_build2(W:[]u8,t:i32,gb:[]u8)i32 {
  let min_a:i32=get32(gb,12); let max_a:i32=get32(gb,16);
  let min_b:i32=get32(gb,20); let max_b:i32=get32(gb,24);
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(gi_lic_ok2(gb,fr)==1){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/16; let b:i32=out-(a*16);
          if(a>=min_a && a<=max_a && b>=min_b && b<=max_b){
            if(gi_eval_known(W,out,41,t)==1 || gi_eval_known(W,out,42,t)==1){
              promote_graph(W,root,t,45,out,ff,1);
              return out;
            }
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Hardcoded comparison arm: the prior treatment's researcher-authored
// grammar restriction (only DADD/DMUL single links), verbatim logic.
// Used to compare induced vs hardcoded performance.
fn gi_hardcode_build(W:[]u8,t:i32)i32 {
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(fr==43 || fr==44){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/16; let b:i32=out-(a*16);
          let op:i32=41; if(fr==44){op=42;}
          if(a>=0 && a<=9 && b>=0 && b<=9 && gi_eval_known(W,out,op,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Classify the (T,BUILD) construction from the promoted MAP's DEP edges.
// 1 = valid: single DADD/DMUL dep, pair decodes to a,b in 0..9, and TNN's
//     own eval knowledge confirms op(a,b)==T.
// 2 = multi-dep. 3 = wrong-relation dep. 4 = non-pair or literal range.
// 5 = value mismatch. 0 = no MAP found.
// Researcher-owned measurement rubric (same as prior work).
fn gi_classify(W:[]u8,t:i32)i32 {
  let m:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && ng(W,mm,0)==20 && ng(W,mm,8)==t && ng(W,mm,4)==45){m=mm;}
    mm=mm+1;
  }
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24); let oo:i32=ng(W,f,28);
  if(fr!=43 && fr!=44){return 3;}
  let a:i32=oo/16; let b:i32=oo-(a*16);
  if(a<0 || a>9 || b<0 || b>9){return 4;}
  let op:i32=41; if(fr==44){op=42;}
  if(gi_eval_known(W,oo,op,t)==0){return 5;}
  return 1;
}

// ==== go_induce2: outlier-excluding grammar induction (UNFROZEN) ====
// Appended to a byte-identical copy of gt_patch.zag. The original
// gi_induce above is UNCHANGED (kept for the comparison arm).
//
// Learner-derived majority-consistency exclusion. No relation ids, no
// deception signatures, no per-world constants in this procedure.
// rep buffer layout (i32 slots via set32/get32):
//   rep[0]  outcome: 1 = induced, 0 = refused
//   rep[4]  n_excluded (meaningful only when outcome = 1)
//   rep[8]  refusal code: 0 none, 1 no licensed examples,
//           2 unlicensed not a strict minority, 3 no viable set,
//           4 ambiguous tie, 5 licensor overflow (>2, node layout),
//           6 compute cap exceeded (batch or relation cap)
//   rep[12] n_included (licensed examples kept)
//   rep[16..] excluded entries, 12 bytes each: T, P, why
//           (why: 1 = unlicensed, 2 = inconsistent profile)

fn go_bit(m:i32,j:i32,pw:[]u8)i32 {
  let d:i32=m/get32(pw,j*4);
  return d-((d/2)*2);
}

fn go_rix(rels:[]u8,nr:i32,r:i32)i32 {
  let j:i32=0;
  while(j<nr){
    if(get32(rels,j*4)==r){return j;}
    j=j+1;
  }
  return -1;
}

// Cross-target attestation: number of distinct subjects T with a live
// type-1 fact of relation r anywhere in the learner's experience.
// Capped at 64 subjects (far above any test world).
fn go_tgtcount(W:[]u8,r:i32)i32 {
  let seen:[]u8=z_alloc(256);
  let nseen:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      let T:i32=ng(W,n,20);
      let k:i32=0; let dup:i32=0;
      while(k<nseen){
        if(get32(seen,k*4)==T){dup=1;}
        k=k+1;
      }
      if(dup==0 && nseen<64){
        set32(seen,nseen*4,T);
        nseen=nseen+1;
      }
    }
    n=n+1;
  }
  return nseen;
}

// Coverage of the candidate licensor set selected by bitmask m:
// number of licensed examples whose (nonempty) profile is a subset of
// the selected relations.
fn go_cover(exn:[]u8,exrel:[]u8,idx:[]u8,nli:i32,rels:[]u8,nr:i32,m:i32,pw:[]u8)i32 {
  let cov:i32=0;
  let i:i32=0;
  while(i<nli){
    let ei:i32=get32(idx,i*4);
    let c:i32=get32(exn,ei*4);
    let k:i32=0; let sub:i32=1;
    while(k<c){
      let r:i32=get32(exrel,(ei*8+k)*4);
      let j:i32=go_rix(rels,nr,r);
      if(j<0){sub=0;}
      else {
        if(go_bit(m,j,pw)==0){sub=0;}
      }
      k=k+1;
    }
    if(sub==1){cov=cov+1;}
    i=i+1;
  }
  return cov;
}

fn gi_induce2(W:[]u8,rep:[]u8)i32 {
  set32(rep,0,0); set32(rep,4,0); set32(rep,8,0); set32(rep,12,0);
  // Step 1: gather BUILD examples and per-example licensor profiles.
  // Batch cap: 16 examples. Profile cap: 8 relations per example.
  let exT:[]u8=z_alloc(64);
  let exP:[]u8=z_alloc(64);
  let exn:[]u8=z_alloc(64);
  let exrel:[]u8=z_alloc(512);
  let ne:i32=0; let over:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==45){
      if(ne>=16){over=1;}
      else {
        let T:i32=ng(W,n,20); let P:i32=ng(W,n,28);
        let a:i32=P/16; let b:i32=P-(a*16);
        let okp:i32=1;
        if(a<0 || a>15 || b<0 || b>15 || a*16+b!=P){okp=0;}
        set32(exT,ne*4,T); set32(exP,ne*4,P);
        let cnt:i32=0;
        if(okp==1){
          let m2:i32=2;
          while(m2<1024 && cnt<8){
            if(m2!=n && ng(W,m2,36)==1 && ng(W,m2,0)==1 && ng(W,m2,20)==T && ng(W,m2,28)==P && ng(W,m2,24)!=45){
              let r2:i32=ng(W,m2,24);
              let k:i32=0; let seen:i32=0;
              while(k<cnt){
                if(get32(exrel,(ne*8+k)*4)==r2){seen=1;}
                k=k+1;
              }
              if(seen==0){
                set32(exrel,(ne*8+cnt)*4,r2);
                cnt=cnt+1;
              }
            }
            m2=m2+1;
          }
        }
        set32(exn,ne*4,cnt);
        ne=ne+1;
      }
    }
    n=n+1;
  }
  if(over==1){set32(rep,8,6); return 0;}
  // Step 2: split licensed / unlicensed; exclude minority unlicensed.
  let idx:[]u8=z_alloc(64);
  let nli:i32=0; let nunl:i32=0;
  let i:i32=0;
  while(i<ne){
    if(get32(exn,i*4)==0){nunl=nunl+1;}
    else {set32(idx,nli*4,i); nli=nli+1;}
    i=i+1;
  }
  if(nli==0){set32(rep,8,1); return 0;}
  let nexc:[]u8=z_alloc(192);
  let nexc_n:i32=0;
  if(nunl>0){
    if(nunl<nli){
      i=0;
      while(i<ne){
        if(get32(exn,i*4)==0){
          set32(nexc,nexc_n*12,get32(exT,i*4));
          set32(nexc,nexc_n*12+4,get32(exP,i*4));
          set32(nexc,nexc_n*12+8,1);
          nexc_n=nexc_n+1;
        }
        i=i+1;
      }
    }
    else {set32(rep,8,2); return 0;}
  }
  // Step 3: distinct licensor relations in first-seen order.
  let rels:[]u8=z_alloc(48);
  let nr:i32=0; let rover:i32=0;
  i=0;
  while(i<nli){
    let ei:i32=get32(idx,i*4);
    let k:i32=0;
    while(k<get32(exn,ei*4)){
      let r:i32=get32(exrel,(ei*8+k)*4);
      let q:i32=0; let seen:i32=0;
      while(q<nr){
        if(get32(rels,q*4)==r){seen=1;}
        q=q+1;
      }
      if(seen==0){
        if(nr<12){set32(rels,nr*4,r); nr=nr+1;}
        else {rover=1;}
      }
      k=k+1;
    }
    i=i+1;
  }
  if(rover==1 || nr>10){set32(rep,8,6); return 0;}
  // Step 4: enumerate candidate licensor sets; viability = strict
  // majority coverage. Best by smallest size, then largest coverage,
  // then largest cross-target attestation. Any tie on all three keys
  // is ambiguity: refuse.
  let pw:[]u8=z_alloc(40);
  set32(pw,0,1);
  let j:i32=1;
  while(j<10){set32(pw,j*4,get32(pw,(j-1)*4)*2); j=j+1;}
  let tc:[]u8=z_alloc(40);
  j=0;
  while(j<nr){set32(tc,j*4,go_tgtcount(W,get32(rels,j*4))); j=j+1;}
  let total:i32=get32(pw,nr*4);
  let best_m:i32=0; let best_sz:i32=999; let best_cov:i32=-1; let best_ts:i32=-1;
  let tie:i32=0;
  let m:i32=1;
  while(m<total){
    let sz:i32=0;
    j=0;
    while(j<nr){
      if(go_bit(m,j,pw)==1){sz=sz+1;}
      j=j+1;
    }
    let cov:i32=go_cover(exn,exrel,idx,nli,rels,nr,m,pw);
    if(cov*2>nli){
      let ts:i32=0;
      j=0;
      while(j<nr){
        if(go_bit(m,j,pw)==1){ts=ts+get32(tc,j*4);}
        j=j+1;
      }
      let better:i32=0; let same:i32=0;
      if(best_m==0){better=1;}
      else {
        if(sz<best_sz){better=1;}
        else {
          if(sz==best_sz){
            if(cov>best_cov){better=1;}
            else {
              if(cov==best_cov){
                if(ts>best_ts){better=1;}
                else {
                  if(ts==best_ts){same=1;}
                }
              }
            }
          }
        }
      }
      if(better==1){
        best_m=m; best_sz=sz; best_cov=cov; best_ts=ts; tie=0;
      }
      else {
        if(same==1){tie=1;}
      }
    }
    m=m+1;
  }
  if(best_m==0){set32(rep,8,3); return 0;}
  if(tie==1){set32(rep,8,4); return 0;}
  if(best_sz>2){set32(rep,8,5); return 0;}
  // Step 5: winning set (first-seen order); exclude inconsistent.
  let win:[]u8=z_alloc(8);
  let nw:i32=0;
  j=0;
  while(j<nr){
    if(go_bit(best_m,j,pw)==1){
      set32(win,nw*4,get32(rels,j*4));
      nw=nw+1;
    }
    j=j+1;
  }
  i=0;
  let nincon:i32=0;
  while(i<nli){
    let ei:i32=get32(idx,i*4);
    let c:i32=get32(exn,ei*4);
    let k:i32=0; let sub:i32=1;
    while(k<c){
      let r:i32=get32(exrel,(ei*8+k)*4);
      let q:i32=0; let hit:i32=0;
      while(q<nw){
        if(get32(win,q*4)==r){hit=1;}
        q=q+1;
      }
      if(hit==0){sub=0;}
      k=k+1;
    }
    if(sub==0){
      set32(nexc,nexc_n*12,get32(exT,ei*4));
      set32(nexc,nexc_n*12+4,get32(exP,ei*4));
      set32(nexc,nexc_n*12+8,2);
      nexc_n=nexc_n+1;
      nincon=nincon+1;
    }
    i=i+1;
  }
  // Step 6: literal ranges from all facts with winning licensors,
  // then write the type-70 grammar node (layout unchanged). nbuild
  // records the examples consistent with the induced grammar (licensed
  // examples minus inconsistent exclusions); excluded examples are
  // itemized in the rep exclusion list instead.
  let min_a:i32=999; let max_a:i32=-999;
  let min_b:i32=999; let max_b:i32=-999;
  let e:i32=2;
  while(e<1024){
    if(ng(W,e,36)==1 && ng(W,e,0)==1){
      let er:i32=ng(W,e,24);
      let k:i32=0; let islic:i32=0;
      while(k<nw){
        if(get32(win,k*4)==er){islic=1;}
        k=k+1;
      }
      if(islic==1){
        let P:i32=ng(W,e,28);
        let a:i32=P/16; let b:i32=P-(a*16);
        if(a>=0 && a<=15 && b>=0 && b<=15 && a*16+b==P){
          if(a<min_a){min_a=a;}
          if(a>max_a){max_a=a;}
          if(b<min_b){min_b=b;}
          if(b>max_b){max_b=b;}
        }
      }
    }
    e=e+1;
  }
  if(min_a>max_a){set32(rep,8,3); return 0;}
  let g:i32=alloc_node(W);
  if(g<0){set32(rep,8,3); return 0;}
  ns(W,g,0,70);
  ns(W,g,4,nw);
  if(nw>0){ns(W,g,8,get32(win,0));}
  if(nw>1){ns(W,g,12,get32(win,4));}
  ns(W,g,16,min_a); ns(W,g,20,max_a);
  ns(W,g,24,min_b); ns(W,g,28,max_b);
  ns(W,g,32,nli-nincon);
  set32(rep,0,1);
  set32(rep,4,nexc_n);
  set32(rep,8,0);
  set32(rep,12,nli);
  let q:i32=0;
  while(q<nexc_n){
    set32(rep,16+q*12,get32(nexc,q*12));
    set32(rep,16+q*12+4,get32(nexc,q*12+4));
    set32(rep,16+q*12+8,get32(nexc,q*12+8));
    q=q+1;
  }
  return 1;
}

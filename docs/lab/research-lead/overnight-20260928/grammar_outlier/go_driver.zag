// go_driver.zag -- outlier-excluding grammar induction experiment driver.
// EXL2 world (literals 0..9; SUB=41, DIV=42, DSUB=43, DDIV=44,
// BUILD=45; P(a,b) = a*16+b). Teaching section mirrors gt_driver.zag;
// the induction under test is gi_induce2 in go_patch.zag (the original
// gi_induce is kept for the comparison arm only).

fn gi_P(a:i32,b:i32)i32 { return a*16+b; }

// ---- teaching (examples only; no grammar rules taught) ----

fn gt_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,gi_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,gi_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){gt_dsub(W,t); gt_ddiv(W,t); t=t+1;}
  return;
}

fn gt_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_teach_build(W:[]u8)void {
  gt_canon_build(W,1,1);
  gt_canon_build(W,3,0);
  gt_canon_build(W,5,1);
  gt_canon_build(W,7,0);
  return;
}

// Eval + decomp teaching only (no BUILD facts); arms add their own
// BUILD batches.
fn go_teach_base(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=gi_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  gt_teach_decomp(W);
  return;
}

// ---- deceivers (adversarial teachers) ----

// W5a style: one deceptive BUILD fact with no licensor anywhere.
fn go_dec_a(W:[]u8)void {
  ev_teach_in(W,2,45,gi_P(9,9));
  return;
}

// W5b style: bogus relation 46 licensing a deceptive BUILD fact.
fn go_dec_b(W:[]u8)void {
  ev_teach_in(W,3,46,gi_P(4,1));
  ev_teach_in(W,3,45,gi_P(4,1));
  return;
}

// Arm F: two coordinated deceivers sharing bogus relation 46,
// piggybacking on genuine 44.
fn go_dec_F(W:[]u8)void {
  ev_teach_in(W,9,46,gi_P(9,1));
  ev_teach_in(W,9,45,gi_P(9,1));
  ev_teach_in(W,2,46,gi_P(4,2));
  ev_teach_in(W,2,45,gi_P(4,2));
  return;
}

// Arm D: 50/50 BUILD batch, disjoint vocabularies.
fn go_build_D(W:[]u8)void {
  ev_teach_in(W,1,45,gi_P(1,1));
  ev_teach_in(W,3,45,gi_P(3,0));
  ev_teach_in(W,5,46,gi_P(9,9));
  ev_teach_in(W,5,45,gi_P(9,9));
  ev_teach_in(W,7,46,gi_P(8,8));
  ev_teach_in(W,7,45,gi_P(8,8));
  return;
}

// Arm E: majority poisoning. 5 deceivers with coherent bogus
// relation 46, disjoint vocabulary, strict majority of 9.
fn go_build_E(W:[]u8)void {
  gt_teach_build(W);
  ev_teach_in(W,0,46,gi_P(3,5));
  ev_teach_in(W,0,45,gi_P(3,5));
  ev_teach_in(W,2,46,gi_P(3,5));
  ev_teach_in(W,2,45,gi_P(3,5));
  ev_teach_in(W,4,46,gi_P(3,7));
  ev_teach_in(W,4,45,gi_P(3,7));
  ev_teach_in(W,6,46,gi_P(3,9));
  ev_teach_in(W,6,45,gi_P(3,9));
  ev_teach_in(W,8,46,gi_P(1,9));
  ev_teach_in(W,8,45,gi_P(1,9));
  return;
}

// Arm G: piggyback 50/50 probe.
fn go_build_G(W:[]u8)void {
  ev_teach_in(W,1,45,gi_P(1,1));
  ev_teach_in(W,3,45,gi_P(3,0));
  ev_teach_in(W,5,46,gi_P(5,1));
  ev_teach_in(W,5,45,gi_P(5,1));
  ev_teach_in(W,7,46,gi_P(7,1));
  ev_teach_in(W,7,45,gi_P(7,1));
  return;
}

// ---- reporting ----

fn gi_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GO-GRAMMAR none\n"); return;}
  let nlic:i32=ng(W,g,4);
  emit("GO-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

fn go_rep_print(rep:[]u8)void {
  emit("GO2-OUTCOME "); e64(get32(rep,0));
  emit(" NEXCL="); e64(get32(rep,4));
  emit(" NINCL="); e64(get32(rep,12));
  emit(" REFUSE="); e64(get32(rep,8)); emit("\n");
  let nx:i32=get32(rep,4);
  let q:i32=0;
  while(q<nx){
    emit("GO2-EXCL T="); e64(get32(rep,16+q*12));
    emit(" P="); e64(get32(rep,16+q*12+4));
    emit(" WHY="); e64(get32(rep,16+q*12+8)); emit("\n");
    q=q+1;
  }
  return;
}

// ---- test battery (world-specific targets; no BUILD facts taught) ----

fn gi_test_targets(out:[]u8)i32 {
  set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
  set32(out,16,8); set32(out,20,9);
  return 6;
}

// Grammar-guided battery using the induced grammar node.
fn go_arm_induce2(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GO-I-NOGRAMMAR\n"); return 0;}
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gi_classify(W,t);
    emit("GO-I "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GO-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

fn main()i32 {
  emit("GO-START\n");
  // Arm A: clean batch.
  let WA:[]u8=z_alloc(110656); tnn2_init(WA);
  go_teach_base(WA); gt_teach_build(WA);
  emit("GO-A-CLEAN\n");
  let repA:[]u8=z_alloc(256);
  let rA2:i32=gi_induce2(WA,repA);
  emit("GO2-INDUCED "); e64(rA2); emit("\n");
  go_rep_print(repA);
  gi_report_grammar(WA);
  let rA1:i32=gi_induce(WA);
  emit("GO-ORIG-INDUCED "); e64(rA1); emit("\n");
  emit("GO-A-BATTERY\n");
  let vA:i32=go_arm_induce2(WA);
  // Arm B: clean + one unlicensed deceiver (W5a style).
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  go_teach_base(WB); gt_teach_build(WB); go_dec_a(WB);
  emit("GO-B-ONE-DECEIVER\n");
  let repB:[]u8=z_alloc(256);
  let rB2:i32=gi_induce2(WB,repB);
  emit("GO2-INDUCED "); e64(rB2); emit("\n");
  go_rep_print(repB);
  gi_report_grammar(WB);
  let rB1:i32=gi_induce(WB);
  emit("GO-ORIG-INDUCED "); e64(rB1); emit("\n");
  emit("GO-B-BATTERY\n");
  let vB:i32=go_arm_induce2(WB);
  // Arm C: clean + two minority deceivers (W5a + W5b style).
  let WC:[]u8=z_alloc(110656); tnn2_init(WC);
  go_teach_base(WC); gt_teach_build(WC); go_dec_a(WC); go_dec_b(WC);
  emit("GO-C-TWO-DECEIVERS\n");
  let repC:[]u8=z_alloc(256);
  let rC2:i32=gi_induce2(WC,repC);
  emit("GO2-INDUCED "); e64(rC2); emit("\n");
  go_rep_print(repC);
  gi_report_grammar(WC);
  emit("GO-C-BATTERY\n");
  let vC:i32=go_arm_induce2(WC);
  // Arm D: 50/50 split, disjoint vocabularies. Must refuse, not pick.
  let WD:[]u8=z_alloc(110656); tnn2_init(WD);
  go_teach_base(WD); go_build_D(WD);
  emit("GO-D-FIFTYFIFTY\n");
  let repD:[]u8=z_alloc(256);
  let rD2:i32=gi_induce2(WD,repD);
  emit("GO2-INDUCED "); e64(rD2); emit("\n");
  go_rep_print(repD);
  gi_report_grammar(WD);
  emit("GO-D-BATTERY\n");
  let vD:i32=go_arm_induce2(WD);
  // Arm E: adversarial majority poisoning (5 deceivers vs 4 clean).
  let WE:[]u8=z_alloc(110656); tnn2_init(WE);
  go_teach_base(WE); go_build_E(WE);
  emit("GO-E-MAJPOISON\n");
  let repE:[]u8=z_alloc(256);
  let rE2:i32=gi_induce2(WE,repE);
  emit("GO2-INDUCED "); e64(rE2); emit("\n");
  go_rep_print(repE);
  gi_report_grammar(WE);
  emit("GO-E-BATTERY\n");
  let vE:i32=go_arm_induce2(WE);
  // Arm F: adversarial coordinated piggyback minority (2 vs 4).
  let WF:[]u8=z_alloc(110656); tnn2_init(WF);
  go_teach_base(WF); gt_teach_build(WF); go_dec_F(WF);
  emit("GO-F-COORDPIGGY\n");
  let repF:[]u8=z_alloc(256);
  let rF2:i32=gi_induce2(WF,repF);
  emit("GO2-INDUCED "); e64(rF2); emit("\n");
  go_rep_print(repF);
  gi_report_grammar(WF);
  emit("GO-F-BATTERY\n");
  let vF:i32=go_arm_induce2(WF);
  // Arm G: extra probe, piggyback at exactly 50/50.
  let WG:[]u8=z_alloc(110656); tnn2_init(WG);
  go_teach_base(WG); go_build_G(WG);
  emit("GO-G-PIGGYFIFTY\n");
  let repG:[]u8=z_alloc(256);
  let rG2:i32=gi_induce2(WG,repG);
  emit("GO2-INDUCED "); e64(rG2); emit("\n");
  go_rep_print(repG);
  gi_report_grammar(WG);
  emit("GO-G-BATTERY\n");
  let vG:i32=go_arm_induce2(WG);
  emit("GO-SUMMARY A="); e64(vA); emit(" B="); e64(vB);
  emit(" C="); e64(vC); emit(" D="); e64(vD);
  emit(" E="); e64(vE); emit(" F="); e64(vF);
  emit(" G="); e64(vG); emit("\n");
  emit("GO-DONE\n");
  return 0;
}

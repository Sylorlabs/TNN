// world_ood2.zag -- Sealed OOD World 2: inhibition.
// Concatenate AFTER the frozen learner (learner_frozen.zag).
// SEALED TRUTH: Y(t) = X(t-1) AND NOT Z(t-1).
// Negation is not in F2's vocabulary. Structural axis: inhibition.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "OOD2-inhibition"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let xv:i32=ws[8+0*32+t-1] as i32;
    let zv:i32=ws[8+1*32+t-1] as i32;
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: X and Z pulsed TOGETHER at t=2 and t=6.
// Single-step pulses (engine semantics). The overlap is what refutes
// every positive single-cause rule for Y with cnt=2 (not cnt<2).
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2){ ws[8+0*32+t]=1; ws[8+1*32+t]=1; }
  if(t==6){ ws[8+0*32+t]=1; ws[8+1*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness adjudication. Checks amended prediction P-W2:
// no variable has any candidates (ne=0); Y's zero is structural
// (cnt=2 refuted), not from lack of data.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  emit("OOD2_VERIFY ne="); e64(ne); emit(" nhyp="); e64(nhyp); emit("\n");
  if(ne==0 && nhyp==1){
    emit("OOD2_PREDICTION CONFIRMED\n");
    return 1;
  }
  emit("OOD2_PREDICTION REFUTED\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  // Oracle witness: [SX, W] with Z=0 achieves Y(1)=X(0)&!Z(0)=1.
  let ws:[]u8=z_alloc(8+3*32);
  w_reset(ws);
  w_act(ws,0,0); // SX
  w_act(ws,2,0); // W
  let g:[]u8=z_alloc(3);
  w_snapshot(ws,g);
  emit("OOD2_WITNESS witness_goal="); e64(w_goal_met(g)); emit(" mask="); e64(m); emit("\n");
  return 0;
}

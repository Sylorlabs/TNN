// world_ood4.zag -- Sealed OOD World 4: disjunctive causation.
// Concatenate AFTER the frozen learner (learner_frozen.zag).
// SEALED TRUTH: Y(t) = X(t-1) OR Z(t-2).
// Two true sufficient causes; F2's space assumes exactly one cause per
// effect. Structural axis: redundant causation.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "OOD4-disjunction"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let xv:i32=ws[8+0*32+t-1] as i32;
    let zv:i32=0;
    if(t-2>=0){ zv=ws[8+1*32+t-2] as i32; }
    let yv:i32=0;
    if(xv==1 || zv==1){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: X pulsed at t=2 and t=5; Z pulsed at t=6 and t=9.
// Single-step pulses (engine semantics). Each cause gets cnt=2 so both
// true sufficient causes become candidates.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2){ ws[8+0*32+t]=1; }
  if(t==5){ ws[8+0*32+t]=1; }
  if(t==6){ ws[8+1*32+t]=1; }
  if(t==9){ ws[8+1*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness adjudication. Checks amended prediction P-W4:
// survivor's Y-rule is (X->Y,d1); the TRUE rule (Z->Y,d2) is killed;
// nalive==1. Robust: returns REFUTED (no panic) if ne==0.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  if(ne==0){
    emit("OOD4_VERIFY ne=0\nOOD4_PREDICTION REFUTED\n");
    return 0;
  }
  // locate Y (var 2) in evars
  let yi:i32=-1;
  let j:i32=0;
  while(j<ne){
    if((evars[j] as i32)==2){ yi=j; }
    j=j+1;
  }
  // Y is var 2. Find candidate indices of (X->Y,d1) and (Z->Y,d2).
  let jd1:i32=-1;
  let jd2:i32=-1;
  j=0;
  while(j<36){
    let b:i32=(2*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==1 && (candbuf[b+3] as i32)==255){ jd1=j; }
    if((candbuf[b] as i32)==1 && (candbuf[b+2] as i32)==2 && (candbuf[b+3] as i32)==255){ jd2=j; }
    j=j+1;
  }
  let surv_d1:i32=0;
  let dead_d2:i32=0;
  let h:i32=0;
  while(h<nhyp){
    let sel:i32=hysel[h*ne+yi] as i32;
    if(alive[h]==1 && sel==jd1){ surv_d1=1; }
    if(alive[h]==0 && sel==jd2){ dead_d2=1; }
    h=h+1;
  }
  emit("OOD4_VERIFY jd1="); e64(jd1);
  emit(" jd2="); e64(jd2);
  emit(" surv_d1="); e64(surv_d1);
  emit(" dead_d2="); e64(dead_d2);
  emit(" nalive="); e64(nalive); emit(" nhyp="); e64(nhyp); emit(" ne="); e64(ne); emit("\n");
  if(yi>=0 && jd1>=0 && jd2>=0 && surv_d1==1 && dead_d2==1 && nalive==1){
    emit("OOD4_PREDICTION CONFIRMED\n");
    return 1;
  }
  emit("OOD4_PREDICTION REFUTED\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  // Oracle witness: [SX, W] achieves Y(1)=X(0)|Z(-1)=1.
  let ws:[]u8=z_alloc(8+3*32);
  w_reset(ws);
  w_act(ws,0,0); // SX
  w_act(ws,2,0); // W
  let g:[]u8=z_alloc(3);
  w_snapshot(ws,g);
  emit("OOD4_WITNESS witness_goal="); e64(w_goal_met(g)); emit(" mask="); e64(m); emit("\n");
  return 0;
}

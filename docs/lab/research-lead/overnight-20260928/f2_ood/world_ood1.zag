// world_ood1.zag -- Sealed OOD World 1: hysteretic memory.
// Concatenate AFTER the frozen learner (learner_frozen.zag).
// SEALED TRUTH: Y(t) = 1 iff X(s)=1 for some s in {t-1,t-2,t-3}.
// No single-lag rule is the true law. Structural axis: temporal aggregation.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 2; }
fn w_nctrl()i32 { return 1; }
fn w_ctrl(i:i32)i32 { return 0; } // X
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  return "Y";
}
fn w_worldname()[]u8 { return "OOD1-hysteresis"; }
fn w_plan_maxd()i32 { return 8; }

// True law: window aggregation over the last 3 steps of X.
fn O1_true_y(ws:[]u8, t:i32)i32 {
  let s:i32=t-3;
  while(s<=t-1){
    if(s>=0 && ws[8+0*32+s]==1){ return 1; }
    s=s+1;
  }
  return 0;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+2*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    ws[8+1*32+t]=O1_true_y(ws,t) as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<2){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: X pulses at t=1..3 and t=7..9.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==1){ ws[8+0*32+t]=1; }
  if(t==4){ ws[8+0*32+t]=0; }
  if(t==7){ ws[8+0*32+t]=1; }
  if(t==10){ ws[8+0*32+t]=0; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[1]==1){ return 1; }
  return 0;
}

// Harness adjudication. Checks prereg prediction P-W1:
// survivor is (X->Y,d1), nalive==1.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // Y is var 1. Find candidate index of (X->Y,d1).
  let jd1:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==1 && (candbuf[b+3] as i32)==255){ jd1=j; }
    j=j+1;
  }
  let surv_d1:i32=0;
  let h:i32=0;
  while(h<nhyp){
    if(alive[h]==1 && (hysel[h*ne+0] as i32)==jd1){ surv_d1=1; }
    h=h+1;
  }
  emit("OOD1_VERIFY jd1="); e64(jd1);
  emit(" surv_d1="); e64(surv_d1);
  emit(" nalive="); e64(nalive); emit(" nhyp="); e64(nhyp); emit("\n");
  if(jd1>=0 && surv_d1==1 && nalive==1){
    emit("OOD1_PREDICTION CONFIRMED\n");
    return 1;
  }
  emit("OOD1_PREDICTION REFUTED\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  // Post-hoc discriminating experiment (harness-side, not charged to learner):
  // [SX, W, CX, W, OY]. Survivor (X->Y,d1) predicts Y=0; truth gives Y=1.
  let ws:[]u8=z_alloc(8+2*32);
  w_reset(ws);
  w_act(ws,0,0); // SX
  w_act(ws,2,0); // W
  w_act(ws,1,0); // CX
  w_act(ws,2,0); // W
  let o:i32=w_act(ws,3,1); // OY
  emit("OOD1_POSTHOC pulse_actual_Y="); e64(o); emit(" d1_predicts_Y=0\n");
  // Oracle witness: [SX, W] achieves Y=1.
  w_reset(ws);
  w_act(ws,0,0);
  w_act(ws,2,0);
  let g:[]u8=z_alloc(2);
  w_snapshot(ws,g);
  emit("OOD1_WITNESS witness_goal="); e64(w_goal_met(g)); emit(" mask="); e64(m); emit("\n");
  return 0;
}

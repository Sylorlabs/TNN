// vl.zag -- H2 x L2 integration: H2 value composition over L2-adapted procedures.
//
// m0 X, behav 0: chain-follow r=81 collecting successors as a list. Learned 1->2.
// m1 W, behav 6: plus5, out=v+5 (computed). Learned 1->1.
// m2 Y, behav 4: double, out=2*v (computed). Learned 1->1.
// m3 L, behav 7: list length of a list input. Learned 2->1.
// m4 C, behav 1: count r=82 outgoing. Learned 1->1. Distractor.
// m5 P, behav 8: plus100, out=v+100 (computed). Learned 1->1. Distractor.
// behav 9: TRUNC derived MAP (last element of src list output -> scalar).
// behav 10: EXTEND derived MAP (src scalar output -> 1-element list).
// behav 11: composite pair MAP (A then B by value passing).
//
// Solver: singles, then H2 ordered pairs by value passing (seam match only),
// then the adaptation phase: a needed pair with a seam mismatch triggers
// adaptation, and the mismatch TYPE selects TRUNC (have=2,need=1) or
// EXTEND (have=1,need=2) applied to A. The adapted pair is then found by
// the same pair search and executed by plain value passing.
// Pure Zag. u8-backed workspace, little-endian helpers. 0 modes/bridges/handlers.

// ---------- runtime prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
// A value is (kind, count, e0..e3): kind 1=scalar, kind 2=list.
fn e1val(OUT:[]u8,cur:i32,k:i32,c:i32,e0:i32,e1:i32,e2:i32,e3:i32)i32 {
  if(k==1){ return e1i64(OUT,cur,e0 as i64); }
  cur=e1str(OUT,cur,"[");
  if(c>0){ cur=e1i64(OUT,cur,e0 as i64); }
  if(c>1){ cur=e1str(OUT,cur,","); cur=e1i64(OUT,cur,e1 as i64); }
  if(c>2){ cur=e1str(OUT,cur,","); cur=e1i64(OUT,cur,e2 as i64); }
  if(c>3){ cur=e1str(OUT,cur,","); cur=e1i64(OUT,cur,e3 as i64); }
  cur=e1str(OUT,cur,"]");
  return cur;
}
// Build-time toggle. The na build flips this single line to 0.
fn adapt_on()i32 { return 0; }

// ---------- workspace layout ----------
// header: 0 tries, 4 nmaps, 8 zid, 12 ans
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 16 entries x 64 bytes
//   used(+0) behav(+4) sig_in(+8) sig_out(+12) comp_a(+16) comp_b(+20)
//   prov_op(+24) prov_src(+28) in_sum(+32) in_n(+36) out_sum(+40) out_n(+44)
// VIN: 1568, VOUT: 1592, TMP: 1616 (each 24 bytes: kind,cnt,e0..e3)
fn vl_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,-1); put32(W,12,-2);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn vl_facts(W:[]u8)void {
  add_fact(W,31,81,32); add_fact(W,32,81,33); add_fact(W,33,81,34);
  add_fact(W,41,81,42); add_fact(W,42,81,43);
  add_fact(W,34,82,101); add_fact(W,34,82,102);
  add_fact(W,43,82,103); add_fact(W,43,82,104); add_fact(W,43,82,105);
  return;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn count_rel(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,4);
  put32(W,4,m+1);
  let b:i32=544+m*64;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,0); put32(W,b+12,0);
  put32(W,b+16,-1); put32(W,b+20,-1);
  put32(W,b+24,0); put32(W,b+28,-1);
  put32(W,b+32,0); put32(W,b+36,0); put32(W,b+40,0); put32(W,b+44,0);
  return m;
}
fn put_val(W:[]u8,ob:i32,k:i32,c:i32,e0:i32,e1:i32,e2:i32,e3:i32)void {
  put32(W,ob,k); put32(W,ob+4,c);
  put32(W,ob+8,e0); put32(W,ob+12,e1); put32(W,ob+16,e2); put32(W,ob+20,e3);
  return;
}
// Apply map m to the value (ik,icnt,ie0..ie3), writing (kind,cnt,e0..e3)
// to slot ob. No recursion: composite/derived components are applied
// sequentially through the TMP slot.
fn apply_to_slot(W:[]u8,m:i32,ik:i32,icnt:i32,ie0:i32,ie1:i32,ie2:i32,ie3:i32,ob:i32)void {
  let b:i32=544+m*64;
  let bh:i32=ig(W,b+4);
  if(bh==0){
    if(ik==1){
      let cur:i32=ie0; let n:i32=0;
      let f0:i32=0; let f1:i32=0; let f2:i32=0; let f3:i32=0;
      let k:i32=0;
      while(k<4){
        let o:i32=find_obj(W,cur,81);
        if(o==-1){ break; }
        if(n==0){ f0=o; } if(n==1){ f1=o; } if(n==2){ f2=o; } if(n==3){ f3=o; }
        cur=o; n=n+1; k=k+1;
      }
      put_val(W,ob,2,n,f0,f1,f2,f3);
    } else {
      put_val(W,ob,2,0,0,0,0,0);
    }
    return;
  }
  if(bh==6){
    if(ik==1){ put_val(W,ob,1,1,ie0+5,0,0,0); } else { put_val(W,ob,1,1,-1,0,0,0); }
    return;
  }
  if(bh==4){
    if(ik==1){ put_val(W,ob,1,1,2*ie0,0,0,0); } else { put_val(W,ob,1,1,-1,0,0,0); }
    return;
  }
  if(bh==7){
    if(ik==2){ put_val(W,ob,1,1,icnt,0,0,0); } else { put_val(W,ob,1,1,-1,0,0,0); }
    return;
  }
  if(bh==1){
    if(ik==1){ put_val(W,ob,1,1,count_rel(W,ie0,82),0,0,0); } else { put_val(W,ob,1,1,-1,0,0,0); }
    return;
  }
  if(bh==8){
    if(ik==1){ put_val(W,ob,1,1,ie0+100,0,0,0); } else { put_val(W,ob,1,1,-1,0,0,0); }
    return;
  }
  if(bh==9){
    let src:i32=ig(W,b+16);
    apply_to_slot(W,src,ik,icnt,ie0,ie1,ie2,ie3,1616);
    let tk:i32=ig(W,1616); let tc:i32=ig(W,1620);
    if(tk==2 && tc>0){
      let last:i32=ig(W,1616+8+(tc-1)*4);
      put_val(W,ob,1,1,last,0,0,0);
    } else {
      put_val(W,ob,1,1,-1,0,0,0);
    }
    return;
  }
  if(bh==10){
    let src:i32=ig(W,b+16);
    apply_to_slot(W,src,ik,icnt,ie0,ie1,ie2,ie3,1616);
    let tk:i32=ig(W,1616);
    if(tk==1){ put_val(W,ob,2,1,ig(W,1624),0,0,0); } else { put_val(W,ob,2,0,0,0,0,0); }
    return;
  }
  // behav 11: composite pair, A then B by value passing.
  let a:i32=ig(W,b+16); let c:i32=ig(W,b+20);
  apply_to_slot(W,a,ik,icnt,ie0,ie1,ie2,ie3,1616);
  let tk:i32=ig(W,1616); let tc:i32=ig(W,1620);
  let te0:i32=ig(W,1624); let te1:i32=ig(W,1628);
  let te2:i32=ig(W,1632); let te3:i32=ig(W,1636);
  apply_to_slot(W,c,tk,tc,te0,te1,te2,te3,ob);
  return;
}
fn record_in(W:[]u8,m:i32,kind:i32)void {
  let b:i32=544+m*64;
  put32(W,b+32,ig(W,b+32)+kind); put32(W,b+36,ig(W,b+36)+1);
  return;
}
fn record_out(W:[]u8,m:i32,kind:i32)void {
  let b:i32=544+m*64;
  put32(W,b+40,ig(W,b+40)+kind); put32(W,b+44,ig(W,b+44)+1);
  return;
}
fn finalize_shape(W:[]u8,m:i32)void {
  let b:i32=544+m*64;
  let inn:i32=ig(W,b+36);
  let si:i32=1;
  if(inn>=2 && ig(W,b+32)*2>=inn*3){ si=2; }
  put32(W,b+8,si);
  let outn:i32=ig(W,b+44);
  let so:i32=1;
  if(outn>=2 && ig(W,b+40)*2>=outn*3){ so=2; }
  put32(W,b+12,so);
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*64+8); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*64+12); }
fn teach_one(W:[]u8,OUT:[]u8,cur:i32,behav:i32,v1:i32,v2:i32)i32 {
  let m:i32=map_new(W,behav);
  apply_to_slot(W,m,1,1,v1,0,0,0,1592);
  let k1:i32=ig(W,1592); let c1:i32=ig(W,1596);
  let r10:i32=ig(W,1600); let r11:i32=ig(W,1604); let r12:i32=ig(W,1608); let r13:i32=ig(W,1612);
  record_in(W,m,1); record_out(W,m,k1);
  apply_to_slot(W,m,1,1,v2,0,0,0,1592);
  let k2:i32=ig(W,1592); let c2:i32=ig(W,1596);
  let r20:i32=ig(W,1600); let r21:i32=ig(W,1604); let r22:i32=ig(W,1608); let r23:i32=ig(W,1612);
  record_in(W,m,1); record_out(W,m,k2);
  finalize_shape(W,m);
  cur=e1str(OUT,cur,"TEACH m="); cur=e1i64(OUT,cur,m as i64);
  cur=e1str(OUT,cur," behav="); cur=e1i64(OUT,cur,behav as i64);
  cur=e1str(OUT,cur," in="); cur=e1i64(OUT,cur,v1 as i64);
  cur=e1str(OUT,cur," out="); cur=e1val(OUT,cur,k1,c1,r10,r11,r12,r13);
  cur=e1str(OUT,cur," in="); cur=e1i64(OUT,cur,v2 as i64);
  cur=e1str(OUT,cur," out="); cur=e1val(OUT,cur,k2,c2,r20,r21,r22,r23);
  cur=e1str(OUT,cur," sig="); cur=e1i64(OUT,cur,sig_in(W,m) as i64);
  cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,sig_out(W,m) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn teach_list_one(W:[]u8,OUT:[]u8,cur:i32,behav:i32,k1:i32,a:i32,b:i32,c:i32,k2:i32,d:i32,e:i32,f:i32)i32 {
  let m:i32=map_new(W,behav);
  apply_to_slot(W,m,2,k1,a,b,c,0,1592);
  let t1k:i32=ig(W,1592); let t1r:i32=ig(W,1600);
  record_in(W,m,2); record_out(W,m,t1k);
  apply_to_slot(W,m,2,k2,d,e,f,0,1592);
  let t2k:i32=ig(W,1592); let t2r:i32=ig(W,1600);
  record_in(W,m,2); record_out(W,m,t2k);
  finalize_shape(W,m);
  cur=e1str(OUT,cur,"TEACH m="); cur=e1i64(OUT,cur,m as i64);
  cur=e1str(OUT,cur," behav="); cur=e1i64(OUT,cur,behav as i64);
  cur=e1str(OUT,cur," in="); cur=e1val(OUT,cur,2,k1,a,b,c,0);
  cur=e1str(OUT,cur," out="); cur=e1i64(OUT,cur,t1r as i64);
  cur=e1str(OUT,cur," in="); cur=e1val(OUT,cur,2,k2,d,e,f,0);
  cur=e1str(OUT,cur," out="); cur=e1i64(OUT,cur,t2r as i64);
  cur=e1str(OUT,cur," sig="); cur=e1i64(OUT,cur,sig_in(W,m) as i64);
  cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,sig_out(W,m) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn teach_all(W:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=teach_one(W,OUT,cur,0,31,41);      // m0 X: 31->[32,33,34], 41->[42,43] ; 1->2
  cur=teach_one(W,OUT,cur,6,3,4);        // m1 W: 3->8, 4->9 ; 1->1
  cur=teach_one(W,OUT,cur,4,34,43);      // m2 Y: 34->68, 43->86 ; 1->1
  cur=teach_list_one(W,OUT,cur,7,2,7,8,0,3,1,2,3); // m3 L: [7,8]->2, [1,2,3]->3 ; 2->1
  cur=teach_one(W,OUT,cur,1,34,43);      // m4 C: 34->2, 43->3 ; 1->1
  cur=teach_one(W,OUT,cur,8,3,4);        // m5 P: 3->103, 4->104 ; 1->1
  return cur;
}
// Adaptation operators. Derived MAPs live in learner state with provenance.
// They do NOT emit: the caller emits ADAPT lines from the returned id and
// the reuse flag stashed at header offset 16 (1=reused, 0=newly created),
// because cur is passed by value and callee emits would be overwritten.
fn adapt_trunc(W:[]u8,src:i32)i32 {
  let nm:i32=ig(W,4);
  let i:i32=0;
  while(i<nm){
    let b:i32=544+i*64;
    if(ig(W,b)==1 && ig(W,b+4)==9 && ig(W,b+16)==src){
      put32(W,16,1);
      return i;
    }
    i=i+1;
  }
  let m:i32=map_new(W,9);
  let b:i32=544+m*64;
  put32(W,b+16,src);
  put32(W,b+8,sig_in(W,src)); put32(W,b+12,1);
  put32(W,b+24,1); put32(W,b+28,src);
  put32(W,16,0);
  return m;
}
fn adapt_extend(W:[]u8,src:i32)i32 {
  let nm:i32=ig(W,4);
  let i:i32=0;
  while(i<nm){
    let b:i32=544+i*64;
    if(ig(W,b)==1 && ig(W,b+4)==10 && ig(W,b+16)==src){
      put32(W,16,1);
      return i;
    }
    i=i+1;
  }
  let m:i32=map_new(W,10);
  let b:i32=544+m*64;
  put32(W,b+16,src);
  put32(W,b+8,sig_in(W,src)); put32(W,b+12,2);
  put32(W,b+24,2); put32(W,b+28,src);
  put32(W,16,0);
  return m;
}
fn promote_comp2(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,11);
  let zb:i32=544+z*64;
  put32(W,zb+16,a); put32(W,zb+20,b);
  put32(W,zb+8,sig_in(W,a)); put32(W,zb+12,sig_out(W,b));
  put32(W,zb+24,ig(W,544+a*64+24)); put32(W,zb+28,ig(W,544+a*64+28));
  put32(W,8,z);
  return z;
}
fn adapt_name(OUT:[]u8,cur:i32,op:i32)i32 {
  if(op==1){ cur=e1str(OUT,cur,"TRUNC"); }
  if(op==2){ cur=e1str(OUT,cur,"EXTEND"); }
  if(op!=1 && op!=2){ cur=e1str(OUT,cur,"NONE"); }
  return cur;
}
fn solve_v(W:[]u8,OUT:[]u8,cur:i32,s:i32,target:i32)i32 {
  let nm:i32=ig(W,4);
  let tries:i32=0;
  // Phase 1: singles.
  let m:i32=0;
  while(m<nm){
    if(ig(W,544+m*64)==1 && sig_in(W,m)==1 && sig_out(W,m)==1){
      tries=tries+1;
      apply_to_slot(W,m,1,1,s,0,0,0,1592);
      let vk:i32=ig(W,1592); let r:i32=ig(W,1600);
      cur=e1str(OUT,cur,"TRY1 m="); cur=e1i64(OUT,cur,m as i64);
      cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
      cur=e1str(OUT,cur,"\n");
      if(vk==1 && r==target){
        cur=e1str(OUT,cur,"Z-SINGLE m="); cur=e1i64(OUT,cur,m as i64);
        cur=e1str(OUT,cur,"\n");
        put32(W,12,target); put32(W,0,tries);
        return cur;
      }
    }
    m=m+1;
  }
  // Phase 2: H2 ordered pairs, seam match only, value passing.
  let a:i32=0;
  while(a<nm){
    if(ig(W,544+a*64)==1 && ig(W,544+a*64+4)!=11 && sig_in(W,a)==1){
      let b:i32=0;
      while(b<nm){
        if(ig(W,544+b*64)==1 && ig(W,544+b*64+4)!=11 && sig_out(W,b)==1){
          let have:i32=sig_out(W,a);
          let need:i32=sig_in(W,b);
          if(have==need){
            tries=tries+1;
            apply_to_slot(W,a,1,1,s,0,0,0,1616);
            let tk:i32=ig(W,1616); let tc:i32=ig(W,1620);
            let te0:i32=ig(W,1624); let te1:i32=ig(W,1628);
            let te2:i32=ig(W,1632); let te3:i32=ig(W,1636);
            apply_to_slot(W,b,tk,tc,te0,te1,te2,te3,1592);
            let vk:i32=ig(W,1592); let r:i32=ig(W,1600);
            cur=e1str(OUT,cur,"TRY2 a="); cur=e1i64(OUT,cur,a as i64);
            cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b as i64);
            cur=e1str(OUT,cur," mid="); cur=e1val(OUT,cur,tk,tc,te0,te1,te2,te3);
            cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
            cur=e1str(OUT,cur,"\n");
            if(vk==1 && r==target){
              cur=e1str(OUT,cur,"Z-PAIR a="); cur=e1i64(OUT,cur,a as i64);
              cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b as i64);
              cur=e1str(OUT,cur,"\n");
              put32(W,12,target); put32(W,0,tries);
              return cur;
            }
          } else {
            cur=e1str(OUT,cur,"SEAM-MISMATCH a="); cur=e1i64(OUT,cur,a as i64);
            cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b as i64);
            cur=e1str(OUT,cur," have="); cur=e1i64(OUT,cur,have as i64);
            cur=e1str(OUT,cur," need="); cur=e1i64(OUT,cur,need as i64);
            cur=e1str(OUT,cur,"\n");
          }
        }
        b=b+1;
      }
    }
    a=a+1;
  }
  // Phase 3: adaptation. The seam mismatch is the trigger; the mismatch
  // type selects TRUNC (2,1) or EXTEND (1,2) applied to A. The adapted
  // pair is then found by the same pair search and run by value passing.
  if(adapt_on()==1){
    let a2:i32=0;
    while(a2<nm){
      if(ig(W,544+a2*64)==1 && ig(W,544+a2*64+4)!=11 && sig_in(W,a2)==1){
        let b2:i32=0;
        while(b2<nm){
          if(ig(W,544+b2*64)==1 && ig(W,544+b2*64+4)!=11 && sig_out(W,b2)==1){
            let have:i32=sig_out(W,a2);
            let need:i32=sig_in(W,b2);
            if(have!=need){
              cur=e1str(OUT,cur,"MISMATCH a="); cur=e1i64(OUT,cur,a2 as i64);
              cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
              cur=e1str(OUT,cur," have="); cur=e1i64(OUT,cur,have as i64);
              cur=e1str(OUT,cur," need="); cur=e1i64(OUT,cur,need as i64);
              cur=e1str(OUT,cur,"\n");
              let na:i32=-1;
              let nop:i32=0;
              if(have==2 && need==1){ na=adapt_trunc(W,a2); nop=1; }
              if(have==1 && need==2){ na=adapt_extend(W,a2); nop=2; }
              if(na>=0){
                let reu:i32=ig(W,16);
                if(reu==1){
                  cur=e1str(OUT,cur,"ADAPT-REUSE op=");
                  cur=adapt_name(OUT,cur,nop);
                  cur=e1str(OUT,cur," src="); cur=e1i64(OUT,cur,a2 as i64);
                  cur=e1str(OUT,cur," m="); cur=e1i64(OUT,cur,na as i64);
                  cur=e1str(OUT,cur,"\n");
                } else {
                  if(nop==1){ cur=e1str(OUT,cur,"ADAPT-TRUNC src="); }
                  if(nop==2){ cur=e1str(OUT,cur,"ADAPT-EXTEND src="); }
                  cur=e1i64(OUT,cur,a2 as i64);
                  cur=e1str(OUT,cur," new="); cur=e1i64(OUT,cur,na as i64);
                  cur=e1str(OUT,cur,"\n");
                }
                tries=tries+1;
                apply_to_slot(W,na,1,1,s,0,0,0,1616);
                let tk:i32=ig(W,1616); let tc:i32=ig(W,1620);
                let te0:i32=ig(W,1624); let te1:i32=ig(W,1628);
                let te2:i32=ig(W,1632); let te3:i32=ig(W,1636);
                apply_to_slot(W,b2,tk,tc,te0,te1,te2,te3,1592);
                let vk:i32=ig(W,1592); let r:i32=ig(W,1600);
                cur=e1str(OUT,cur,"TRY2 a="); cur=e1i64(OUT,cur,na as i64);
                cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                cur=e1str(OUT,cur," mid="); cur=e1val(OUT,cur,tk,tc,te0,te1,te2,te3);
                cur=e1str(OUT,cur," r="); cur=e1i64(OUT,cur,r as i64);
                cur=e1str(OUT,cur,"\n");
                if(vk==1 && r==target){
                  let z:i32=promote_comp2(W,na,b2);
                  let zb:i32=544+z*64;
                  cur=e1str(OUT,cur,"Z-COMP2 z="); cur=e1i64(OUT,cur,z as i64);
                  cur=e1str(OUT,cur," a="); cur=e1i64(OUT,cur,na as i64);
                  cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                  cur=e1str(OUT,cur," adapt="); cur=adapt_name(OUT,cur,ig(W,zb+24));
                  cur=e1str(OUT,cur," src="); cur=e1i64(OUT,cur,ig(W,zb+28) as i64);
                  cur=e1str(OUT,cur,"\n");
                  cur=e1str(OUT,cur,"PROV z="); cur=e1i64(OUT,cur,z as i64);
                  cur=e1str(OUT,cur," a="); cur=e1i64(OUT,cur,na as i64);
                  cur=e1str(OUT,cur," b="); cur=e1i64(OUT,cur,b2 as i64);
                  cur=e1str(OUT,cur," adapt="); cur=adapt_name(OUT,cur,ig(W,zb+24));
                  cur=e1str(OUT,cur," src="); cur=e1i64(OUT,cur,ig(W,zb+28) as i64);
                  cur=e1str(OUT,cur,"\n");
                  cur=e1str(OUT,cur,"Z-SIG "); cur=e1i64(OUT,cur,sig_in(W,z) as i64);
                  cur=e1str(OUT,cur,"->"); cur=e1i64(OUT,cur,sig_out(W,z) as i64);
                  cur=e1str(OUT,cur,"\n");
                  put32(W,12,target); put32(W,0,tries);
                  return cur;
                }
              }
            }
          }
          b2=b2+1;
        }
      }
      a2=a2+1;
    }
  } else {
    cur=e1str(OUT,cur,"ADAPT-DISABLED\n");
  }
  cur=e1str(OUT,cur,"Z-FAIL\n");
  put32(W,12,-2); put32(W,0,tries);
  return cur;
}
fn arm_result(OUT:[]u8,cur:i32,W:[]u8,exp_ans:i32,exp_a:i32,exp_b:i32,exp_op:i32,exp_src:i32)i32 {
  let ans:i32=ig(W,12); let tries:i32=ig(W,0);
  let z:i32=ig(W,8);
  let ok:i32=0;
  if(ans==exp_ans){
    if(exp_a==-1){ ok=1; }
    else {
      if(z>=0){
        let za:i32=ig(W,544+z*64+16);
        let zb:i32=ig(W,544+z*64+20);
        let po:i32=ig(W,544+z*64+24);
        let ps:i32=ig(W,544+z*64+28);
        if(za==exp_a && zb==exp_b && po==exp_op && ps==exp_src){ ok=1; }
      }
    }
  }
  cur=e1str(OUT,cur,"ARM-RESULT ");
  if(ok==1){ cur=e1str(OUT,cur,"PASS"); } else { cur=e1str(OUT,cur,"FAIL"); }
  cur=e1str(OUT,cur," ans="); cur=e1i64(OUT,cur,ans as i64);
  cur=e1str(OUT,cur," tries="); cur=e1i64(OUT,cur,tries as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn arm_treat_t(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== TREAT-T ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_v(W,OUT,cur,31,68);
  cur=arm_result(OUT,cur,W,68,6,2,1,0);
  return cur;
}
fn arm_treat_e(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== TREAT-E ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_v(W,OUT,cur,3,1);
  cur=arm_result(OUT,cur,W,1,7,3,2,1);
  return cur;
}
fn arm_fresh(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== FRESH ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=solve_v(W,OUT,cur,31,68);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1,-1);
  return cur;
}
fn arm_reuse_t(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== REUSE-T ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_v(W,OUT,cur,31,68);
  cur=arm_result(OUT,cur,W,68,6,2,1,0);
  cur=e1str(OUT,cur,"--- second solve, same workspace ---\n");
  cur=solve_v(W,OUT,cur,31,68);
  cur=arm_result(OUT,cur,W,68,-1,-1,-1,-1);
  return cur;
}
fn arm_abl_t(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== ABL-T ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_v(W,OUT,cur,31,68);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1,-1);
  return cur;
}
fn arm_abl_e(OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"=== ABL-E ===\n");
  let W:[]u8=z_alloc(8192); vl_init(W);
  vl_facts(W);
  cur=teach_all(W,OUT,cur);
  cur=solve_v(W,OUT,cur,3,1);
  cur=arm_result(OUT,cur,W,-2,-1,-1,-1,-1);
  return cur;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  cur=e1str(OUT,cur,"VL-START\n");
  if(adapt_on()==1){
    cur=arm_treat_t(OUT,cur);
    cur=arm_treat_e(OUT,cur);
    cur=arm_fresh(OUT,cur);
    cur=arm_reuse_t(OUT,cur);
  } else {
    cur=arm_abl_t(OUT,cur);
    cur=arm_abl_e(OUT,cur);
  }
  cur=e1str(OUT,cur,"VL-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc<0){ return 1; }
  return 0;
}

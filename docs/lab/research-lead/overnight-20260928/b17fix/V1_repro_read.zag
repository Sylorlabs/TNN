// M11 -- MINIMAL REPRODUCER: is a pointer obtained by `[]u8 as *u8` usable?
//
// VERDICT: REAL COMPILER DEFECT.
//
// MEMORY-FREE ORACLE: this program writes the LITERAL 7 into b[0] itself. Any
// correct read-back of the first byte of that 64-byte arena must therefore be 7.
// No other computation is involved.
//
// OBSERVED: via (b as *u8) = 8, deterministically, 3/3 identical runs.
fn main()i32 {
  let p:*u8=_zag_malloc(64) as *u8;
  let b:[]u8=p[0..64];
  b[0]=7;
  let cp:*u8=b as *u8;
  let viaCast:[]u8=cp[0..64];
  _zag_print("direct b[0]        = "); _zag_println(_zag_i64_to_str(b[0] as i64));
  _zag_print("via (b as *u8)     = "); _zag_println(_zag_i64_to_str(viaCast[0] as i64));
  _zag_print("expected by oracle = 7");
  _zag_println("M11 DONE");
  return 0;
}

// M13 -- MINIMAL REPRODUCER: does writing through a `[]u8 as *u8` pointer
// corrupt the ORIGINAL arena?
//
// VERDICT: REAL COMPILER DEFECT (silent memory corruption).
//
// MEMORY-FREE ORACLE: b[0] starts as the literal 7. After writing 42 through a
// slice derived from `b as *u8`, a read of the ORIGINAL b[0] must be either 42
// (if the two alias, the normal expectation) or 7 (if they are disjoint). It
// must NOT become 0: 0 is neither the old nor the new value, so no consistent
// aliasing semantics can produce it.
//
// OBSERVED: original b[0] = 0, deterministic 3/3.
fn main()i32 {
  let p:*u8=_zag_malloc(64) as *u8;
  let b:[]u8=p[0..64];
  b[0]=7;
  _zag_print("b[0] before          = "); _zag_println(_zag_i64_to_str(b[0] as i64));
  let cp:*u8=b as *u8;
  let viaCast:[]u8=cp[0..64];
  viaCast[0]=42;
  _zag_print("original b[0] after  = "); _zag_println(_zag_i64_to_str(b[0] as i64));
  _zag_print("legal outcomes are 42 (aliased) or 7 (disjoint); 7 was written first");
  _zag_println("M13 DONE");
  return 0;
}

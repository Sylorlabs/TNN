// inquiry.zag -- Learner-driven inquiry (INQUIRY-1).
// Frozen prereg: 04ac028fb. Pure Zag. No Python.
// Piece A: uncertainty reification from admission events (learner-side workspace process).
// Piece B: inquiry guide construction from learned act-consequence associations.
// Substrate: CLA-2-style workspace, ACT 5-step read path (directional bid),
// query path with -2 (ignorance) / -3 (conflict) admissions.

// ============ output and memory helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// u8-backed little-endian cells (compiler workaround per AGENTS.md)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ workspace layout ============
// header (64 bytes): TICK=0 NN=4 NE=8 LASTACT=16 GOAL=20 UREG=24 AREG=28 GREG=32 CFG=36
// CTX0=40 CTX1=44 CTX2=48 CTX3=52 (4-slot context ring, newest at CTX0)
// nodes: 160 x 40 bytes at base 64 (0,1 reserved; 0 pay0 = POLICY_ROOT)
// node fields: TAG=0 REF0=4 REF1=8 REF2=12 REF3=16 PAY0=20 PAY1=24 PAY2=28 PAY3=32 VALID=36
// edges: 512 x 16 bytes at base 6464; fields FROM=0 ETYPE=4 TO=8; free when FROM==-1
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 6464+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }

// ============ vocabulary (workspace conventions, domain-free) ============
fn T_FACT()i32 { return 1; }
fn T_KEY()i32 { return 2; }
fn T_UNCERT()i32 { return 24; }
fn T_GUIDE()i32 { return 102; }
fn T_GOAL()i32 { return 101; }
fn T_ACTN()i32 { return 25; }
fn ET_DEPENDS()i32 { return 1; }
fn ET_SUPPORTS()i32 { return 2; }
fn ET_CONTRADICTS()i32 { return 3; }
fn ET_USE()i32 { return 6; }
fn ET_CONFIRMS()i32 { return 7; }
fn ET_MEMBER()i32 { return 10; }
// process identifiers (frozen vocabulary for creation traces; workspace content)
fn PROC_REIFY()i32 { return 161; }
fn PROC_CONSTRUCT()i32 { return 162; }
fn PROC_SCAFFOLD()i32 { return 163; }
// action interface (world-defined; opaque labels to the learner)
fn CHOICE_INQUIRE()i32 { return 30; }
fn CHOICE_DECOY()i32 { return 31; }
// config: 3 = reify+construct on (default); 1 = reify only; 2 = construct only.
// Test-only ablation switches (cf. ACT HAGG precedent). Not cognitive modes.
fn cfg_reify(W:[]u8)i32 { let c:i32=hg(W,36); if(c==1 || c==3){return 1;} return 0; }
fn cfg_construct(W:[]u8)i32 { let c:i32=hg(W,36); if(c==2 || c==3){return 1;} return 0; }

// ============ allocation ============
fn alloc_node(W:[]u8)i32 {
  let n:i32=hg(W,4);
  if(n>=160){ return -1; }
  hs(W,4,n+1);
  ns(W,n,36,1);
  ns(W,n,0,0); ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
  ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
fn link(W:[]u8,from:i32,to:i32,et:i32)i32 {
  let n:i32=hg(W,8);
  if(n>=512){ return -1; }
  hs(W,8,n+1);
  es(W,n,0,from); es(W,n,4,et); es(W,n,8,to);
  return n;
}
fn winit()[]u8 {
  let W:[]u8=z_alloc(16384);
  hs(W,4,2);
  hs(W,8,0);
  hs(W,36,3);
  let e:i32=0;
  while(e<512){ es(W,e,0,-1); e=e+1; }
  ns(W,0,36,1); ns(W,0,20,0);
  ns(W,1,36,1);
  let g:i32=alloc_node(W);
  ns(W,g,0,T_GOAL());
  hs(W,20,g); ns(W,0,20,g);
  let ur:i32=alloc_node(W); ns(W,ur,0,T_KEY()); hs(W,24,ur);
  let ar:i32=alloc_node(W); ns(W,ar,0,T_KEY()); hs(W,28,ar);
  let gr:i32=alloc_node(W); ns(W,gr,0,T_KEY()); hs(W,32,gr);
  return W;
}

// ============ query path (with -2/-3 admissions; ordinary bookkeeping) ============
fn new_key(W:[]u8)i32 {
  let k:i32=alloc_node(W);
  ns(W,k,0,T_KEY());
  return k;
}
fn teach(W:[]u8,key:i32,val:i32)i32 {
  let f:i32=alloc_node(W);
  ns(W,f,0,T_FACT()); ns(W,f,4,key); ns(W,f,20,val); ns(W,f,24,1);
  return f;
}
// returns value, -2 (ignorance: no active fact), -3 (conflict: 2+ distinct values)
fn query(W:[]u8,key:i32)i32 {
  let v0:i32=-999999;
  let v1:i32=-999999;
  let nn:i32=hg(W,4);
  let a:i32=2;
  while(a<nn){
    if(ng(W,a,36)==1 && ng(W,a,0)==T_FACT() && ng(W,a,4)==key && ng(W,a,24)==1){
      let v:i32=ng(W,a,20);
      if(v0==-999999){ v0=v; }
      else { if(v!=v0 && v1==-999999){ v1=v; } }
    }
    a=a+1;
  }
  if(v0==-999999){ return -2; }
  if(v1==-999999){ return v0; }
  return -3;
}

// ============ Piece A: uncertainty reification ============
// Learner-side workspace process. Triggered by admission events.
// Generic: writes the admission magnitude as the type marker (no content branch).
// E-ruling: receives only the UNCERTAINTY node address; never the correct act.
// Creation trace: (a) DEPENDS edge U->key, (b) pay1=PROC_REIFY (161).
fn reify_admission(W:[]u8,key:i32,adm:i32)i32 {
  if(cfg_reify(W)==0){ return -1; }
  let u:i32=alloc_node(W);
  if(u<0){ return -1; }
  ns(W,u,0,T_UNCERT());
  ns(W,u,4,key);
  ns(W,u,20,0-adm);
  ns(W,u,24,PROC_REIFY());
  link(W,u,key,ET_DEPENDS());
  link(W,u,hg(W,24),ET_MEMBER());
  ctxpush(W,u);
  return u;
}

// ============ Piece B: guide construction ============
// Liveness: U is live iff no CONFIRMS edge originates from U (workspace-computable).
fn is_live(W:[]u8,u:i32)i32 {
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,0)==u && eg(W,e,4)==ET_CONFIRMS()){ return 0; }
    e=e+1;
  }
  return 1;
}
// Does U have a live (non-tombstoned) guide in the guide registry?
fn has_live_guide(W:[]u8,u:i32)i32 {
  let greg:i32=hg(W,32);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==greg){
      let g:i32=eg(W,e,0);
      if(ng(W,g,0)!=0 && ng(W,g,4)==u){ return 1; }
    }
    e=e+1;
  }
  return 0;
}
// Select act: argmax over ACT registry by resolution count (pay2).
// Tie goes to the lower CHOICE. Deterministic.
// No act-space enumeration in source: candidates are exactly the acts the
// learner has emitted (experience-determined set).
fn select_act(W:[]u8)i32 {
  let areg:i32=hg(W,28);
  let best:i32=CHOICE_INQUIRE();
  let bestc:i32=-1;
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==areg){
      let a:i32=eg(W,e,0);
      let c:i32=ng(W,a,28);
      let ch:i32=ng(W,a,20);
      if(c>bestc || (c==bestc && ch<best)){ bestc=c; best=ch; }
    }
    e=e+1;
  }
  return best;
}
// Piece B scan: for each live UREG member without a live guide, construct one.
// Creation trace: (a) DEPENDS edge G->U, (b) pay1=PROC_CONSTRUCT (162).
fn construct_guides(W:[]u8)void {
  if(cfg_construct(W)==0){ return; }
  let ureg:i32=hg(W,24);
  let goal:i32=hg(W,20);
  let greg:i32=hg(W,32);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==ureg){
      let u:i32=eg(W,e,0);
      if(ng(W,u,0)!=0 && is_live(W,u)==1 && has_live_guide(W,u)==0){
        let act:i32=select_act(W);
        let g:i32=alloc_node(W);
        if(g>=0){
          ns(W,g,0,T_GUIDE());
          ns(W,g,4,u);
          ns(W,g,20,act);
          ns(W,g,24,PROC_CONSTRUCT());
          link(W,g,u,ET_DEPENDS());
          link(W,g,goal,ET_DEPENDS());
          link(W,g,greg,ET_MEMBER());
        }
      }
    }
    e=e+1;
  }
  return;
}

// ============ act-consequence association (experience machinery) ============
// ACT node: tag=T_ACTN, pay0=CHOICE, pay2=resolution count. Registry: AREG.
fn act_node(W:[]u8,choice:i32)i32 {
  let areg:i32=hg(W,28);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==areg){
      let a:i32=eg(W,e,0);
      if(ng(W,a,20)==choice){ return a; }
    }
    e=e+1;
  }
  let a:i32=alloc_node(W);
  ns(W,a,0,T_ACTN()); ns(W,a,20,choice); ns(W,a,28,0);
  link(W,a,areg,ET_MEMBER());
  return a;
}
fn emit_act(W:[]u8,choice:i32)void {
  act_node(W,choice);
  hs(W,16,choice);
  return;
}
// Tombstone guides anchored at U (guide tag cleared; registry edges retained).
fn tombstone_guides(W:[]u8,u:i32)void {
  let greg:i32=hg(W,32);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==greg){
      let g:i32=eg(W,e,0);
      if(ng(W,g,4)==u){ ns(W,g,0,0); }
    }
    e=e+1;
  }
  return;
}
// OBSERVE: ingest fact, demote conflicts (generic EQ revision), then
// resolve-and-credit: if a live U is anchored at this key, the last-emitted
// act's resolution count increments and the U is resolved (CONFIRMS edge).
fn observe(W:[]u8,key:i32,val:i32)void {
  let f:i32=teach(W,key,val);
  let nn:i32=hg(W,4);
  let a:i32=2;
  while(a<nn){
    if(a!=f && ng(W,a,36)==1 && ng(W,a,0)==T_FACT() && ng(W,a,4)==key && ng(W,a,24)==1){
      if(ng(W,a,20)!=val){
        ns(W,a,24,0);
        link(W,f,a,ET_CONTRADICTS());
      }
    }
    a=a+1;
  }
  let ureg:i32=hg(W,24);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==ureg){
      let u:i32=eg(W,e,0);
      if(ng(W,u,0)!=0 && ng(W,u,4)==key && is_live(W,u)==1){
        let la:i32=hg(W,16);
        if(la!=0){
          let an:i32=act_node(W,la);
          ns(W,an,28,ng(W,an,28)+1);
          hs(W,16,0);
        }
        link(W,u,f,ET_CONFIRMS());
        tombstone_guides(W,u);
      }
    }
    e=e+1;
  }
  ctxpush(W,f);
  return;
}

// ============ ACT 5-step read path (directional bid) ============
fn ctxpush(W:[]u8,r:i32)void {
  hs(W,52,hg(W,48)); hs(W,48,hg(W,44)); hs(W,44,hg(W,40)); hs(W,40,r);
  return;
}
fn ctxget(W:[]u8,k:i32)i32 {
  if(k==0){return hg(W,40);} if(k==1){return hg(W,44);}
  if(k==2){return hg(W,48);} return hg(W,52);
}
// directional signed bid over incoming edges: +1 SUPPORTS/USE/CONFIRMS, -1 CONTRADICTS
fn bid(W:[]u8,a:i32)i32 {
  let s:i32=0;
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,8)==a){
      let k:i32=eg(W,e,4);
      if(k==ET_SUPPORTS() || k==ET_USE() || k==ET_CONFIRMS()){ s=s+1; }
      if(k==ET_CONTRADICTS()){ s=s-1; }
    }
    e=e+1;
  }
  return s;
}
// neighbors both directions, excluding nodes 0/1
fn nbr(W:[]u8,a:i32,out:[]u8,max:i32)i32 {
  let c:i32=0;
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    let f:i32=eg(W,e,0); let t:i32=eg(W,e,8);
    if(f==a && t>1){ if(c<max){ set32(out,c*4,t); c=c+1; } }
    if(t==a && f>1){ if(c<max){ set32(out,c*4,f); c=c+1; } }
    e=e+1;
  }
  return c;
}
fn seen(v:[]u8,n:i32,a:i32)i32 {
  let i:i32=0;
  while(i<n){ if(get32(v,i*4)==a){return 1;} i=i+1; }
  return 0;
}
// 2-hop activation from root
fn activate(W:[]u8,root:i32,vis:[]u8,vmax:i32)i32 {
  let vc:i32=0;
  set32(vis,0,root); vc=1;
  let nb:[]u8=z_alloc(256*4);
  let nc:i32=nbr(W,root,nb,256);
  let i:i32=0;
  while(i<nc){
    let a:i32=get32(nb,i*4);
    if(seen(vis,vc,a)==0 && vc<vmax){ set32(vis,vc*4,a); vc=vc+1; }
    i=i+1;
  }
  let h1s:i32=vc;
  let h:i32=1;
  while(h<h1s){
    let a:i32=get32(vis,h*4);
    let nc2:i32=nbr(W,a,nb,256);
    let j:i32=0;
    while(j<nc2){
      let b:i32=get32(nb,j*4);
      if(seen(vis,vc,b)==0 && vc<vmax){ set32(vis,vc*4,b); vc=vc+1; }
      j=j+1;
    }
    h=h+1;
  }
  return vc;
}
// act_event: 5-step protocol. Returns CHOICE or 0 (abstain).
fn act_event(W:[]u8)i32 {
  let pr:i32=ng(W,0,20);
  if(pr<=0){ return 0; }
  if(ng(W,pr,0)==0){ return 0; }
  let vis:[]u8=z_alloc(256*4);
  let vc:i32=activate(W,pr,vis,256);
  let best:i32=-1;
  let bestbid:i32=-999999;
  let i:i32=0;
  while(i<vc){
    let a:i32=get32(vis,i*4);
    if(ng(W,a,0)!=0){
      let r0:i32=ng(W,a,4);
      let m:i32=0;
      let k:i32=0;
      while(k<4){ if(r0==ctxget(W,k) && r0!=0){ m=1; } k=k+1; }
      if(m==1){
        let b:i32=bid(W,a);
        if(b>bestbid || (b==bestbid && (best<0 || a<best))){
          bestbid=b; best=a;
        }
      }
    }
    i=i+1;
  }
  if(best<0){ return 0; }
  return ng(W,best,20);
}

// ============ driver events ============
fn tick(W:[]u8)void { hs(W,0,hg(W,0)+1); return; }
fn do_query(W:[]u8,key:i32)i32 {
  tick(W);
  let r:i32=query(W,key);
  if(r<0){ reify_admission(W,key,r); }
  construct_guides(W);
  return r;
}
fn do_opportunity(W:[]u8)i32 {
  tick(W);
  let ch:i32=act_event(W);
  if(ch!=0){ emit_act(W,ch); }
  construct_guides(W);
  return ch;
}
fn do_observe(W:[]u8,key:i32,val:i32)void {
  tick(W);
  observe(W,key,val);
  construct_guides(W);
  return;
}
// driver-emitted exploration act (W1/W3): explicit exploration policy, records
// the act without ACT selection. The act->consequence mapping is learned from
// the world, symmetric in the act labels.
fn do_explore_act(W:[]u8,choice:i32)void {
  tick(W);
  emit_act(W,choice);
  construct_guides(W);
  return;
}

// ============ test helpers ============
fn count_uncert(W:[]u8)i32 {
  let c:i32=0;
  let nn:i32=hg(W,4);
  let a:i32=2;
  while(a<nn){ if(ng(W,a,36)==1 && ng(W,a,0)==T_UNCERT()){c=c+1;} a=a+1; }
  return c;
}
fn count_guides(W:[]u8)i32 {
  let c:i32=0;
  let nn:i32=hg(W,4);
  let a:i32=2;
  while(a<nn){ if(ng(W,a,36)==1 && ng(W,a,0)==T_GUIDE()){c=c+1;} a=a+1; }
  return c;
}
fn find_uncert(W:[]u8,key:i32)i32 {
  let ureg:i32=hg(W,24);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==ureg){
      let u:i32=eg(W,e,0);
      if(ng(W,u,0)!=0 && ng(W,u,4)==key && is_live(W,u)==1){ return u; }
    }
    e=e+1;
  }
  return -1;
}
fn find_guide(W:[]u8,u:i32)i32 {
  let greg:i32=hg(W,32);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==greg){
      let g:i32=eg(W,e,0);
      if(ng(W,g,0)!=0 && ng(W,g,4)==u){ return g; }
    }
    e=e+1;
  }
  return -1;
}
fn count_guides_for(W:[]u8,u:i32)i32 {
  let c:i32=0;
  let greg:i32=hg(W,32);
  let ne:i32=hg(W,8);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==ET_MEMBER() && eg(W,e,8)==greg){
      let g:i32=eg(W,e,0);
      if(ng(W,g,0)!=0 && ng(W,g,4)==u){ c=c+1; }
    }
    e=e+1;
  }
  return c;
}
// creation-trace audit: every UNCERTAINTY/GUIDE node carries a process id in
// {161,162} and at least one outgoing DEPENDS trace edge. 1=clean, 0=violation.
fn audit_traces(W:[]u8)i32 {
  let nn:i32=hg(W,4);
  let a:i32=2;
  while(a<nn){
    let t:i32=ng(W,a,0);
    if(t==T_UNCERT() || t==T_GUIDE()){
      let p:i32=ng(W,a,24);
      if(p!=PROC_REIFY() && p!=PROC_CONSTRUCT()){ return 0; }
      let ok:i32=0;
      let ne:i32=hg(W,8);
      let e:i32=0;
      while(e<ne){
        if(eg(W,e,0)==a && eg(W,e,4)==ET_DEPENDS()){ ok=1; }
        e=e+1;
      }
      if(ok==0){ return 0; }
    }
    a=a+1;
  }
  return 1;
}
// Carry the learned act->consequence registry (ACT nodes with counts) to a fresh
// domain workspace. Persistent learner state; episodic uncertainties do not cross.
fn carry_acts(Wsrc:[]u8,Wdst:[]u8)void {
  let areg:i32=hg(Wsrc,28);
  let ne:i32=hg(Wsrc,8);
  let e:i32=0;
  while(e<ne){
    if(eg(Wsrc,e,4)==ET_MEMBER() && eg(Wsrc,e,8)==areg){
      let a:i32=eg(Wsrc,e,0);
      let na:i32=act_node(Wdst,ng(Wsrc,a,20));
      ns(Wdst,na,28,ng(Wsrc,a,28));
    }
    e=e+1;
  }
  return;
}

// ============ Phase 1: reification (D1) ============
// P-INQ1: 12 queries, each returning -2, produce exactly 12 UNCERTAINTY nodes
// with ref0 = queried key and complete creation traces.
fn phase1(W:[]u8)i32 {
  let i:i32=0;
  while(i<8){ let k:i32=new_key(W); teach(W,k,100+i); i=i+1; }
  let qk:[]u8=z_alloc(12*4);
  i=0;
  while(i<12){ let k:i32=new_key(W); set32(qk,i*4,k); i=i+1; }
  i=0;
  while(i<12){
    let k:i32=get32(qk,i*4);
    let r:i32=do_query(W,k);
    if(r!=-2){ return 0; }
    i=i+1;
  }
  if(count_uncert(W)!=12){ return 0; }
  i=0;
  while(i<12){
    let k:i32=get32(qk,i*4);
    let u:i32=find_uncert(W,k);
    if(u<0){ return 0; }
    if(ng(W,u,4)!=k){ return 0; }
    if(ng(W,u,20)!=2){ return 0; }
    if(ng(W,u,24)!=PROC_REIFY()){ return 0; }
    i=i+1;
  }
  if(audit_traces(W)==0){ return 0; }
  return 1;
}

// ============ Ablation A1: reify disabled ============
// Expect: 12 queries produce zero UNCERTAINTY nodes.
fn ablation_a1()i32 {
  let W:[]u8=winit();
  hs(W,36,2);
  let i:i32=0;
  while(i<12){ let k:i32=new_key(W); do_query(W,k); i=i+1; }
  if(count_uncert(W)!=0){ return 0; }
  return 1;
}

// ============ W1 + Phase 2: exploration then construction (D1) ============
// W1: 20 events (8 uncertainty keys), alternating exploration acts.
// Phase 2 (P-INQ2): 12 fresh keys; each must yield exactly one ACTION-GUIDE
// within 10 events, selecting CHOICE 30 (never 31).
fn w1_phase2(W:[]u8)i32 {
  let w1k:[]u8=z_alloc(8*4);
  let i:i32=0;
  while(i<8){ let k:i32=new_key(W); set32(w1k,i*4,k); i=i+1; }
  i=0;
  while(i<8){
    let k:i32=get32(w1k,i*4);
    let r:i32=do_query(W,k);
    if(r!=-2){ return 0; }
    let act:i32=CHOICE_INQUIRE();
    if((i-(i/2)*2)==1){ act=CHOICE_DECOY(); }
    do_explore_act(W,act);
    if(act==CHOICE_INQUIRE()){ do_observe(W,k,200+i); }
    i=i+1;
  }
  // G-W1: act->consequence associations readable in learner state
  let an:i32=act_node(W,CHOICE_INQUIRE());
  if(ng(W,an,28)<=0){ return 0; }
  // Phase 2
  let p2k:[]u8=z_alloc(12*4);
  i=0;
  while(i<12){ let k:i32=new_key(W); set32(p2k,i*4,k); i=i+1; }
  i=0;
  while(i<12){
    let k:i32=get32(p2k,i*4);
    let t0:i32=hg(W,0);
    let r:i32=do_query(W,k);
    if(r!=-2){ return 0; }
    let u:i32=find_uncert(W,k);
    if(u<0){ return 0; }
    if(ng(W,u,20)!=2){ return 0; }
    if(ng(W,u,24)!=PROC_REIFY()){ return 0; }
    if(count_guides_for(W,u)!=1){ return 0; }
    let g:i32=find_guide(W,u);
    if(g<0){ return 0; }
    if(ng(W,g,20)!=CHOICE_INQUIRE()){ return 0; }
    if(ng(W,g,24)!=PROC_CONSTRUCT()){ return 0; }
    if(hg(W,0)-t0>10){ return 0; }
    i=i+1;
  }
  if(audit_traces(W)==0){ return 0; }
  return 1;
}

// ============ Ablation A2: construct disabled ============
// Expect: 12 UNCERTAINTY nodes, 0 guides, 0 emissions across 30 opportunities.
fn ablation_a2()i32 {
  let W:[]u8=winit();
  hs(W,36,1);
  let i:i32=0;
  while(i<12){ let k:i32=new_key(W); do_query(W,k); i=i+1; }
  if(count_uncert(W)!=12){ return 0; }
  i=0;
  while(i<30){
    let ch:i32=do_opportunity(W);
    if(ch!=0){ return 0; }
    i=i+1;
  }
  if(count_guides(W)!=0){ return 0; }
  return 1;
}

// ============ Phase 3: W6-class attribution (D2) ============
// P-INQ3: >=10/12 trials: CHOICE 30 at genuine opportunity, not-30 at decoy.
// P-INQ3b: first 30 emission strictly after first -2 admission (no pre-play).
// P-INQ4: >=16/20 follow-up queries return the observation (not -2).
fn phase3_body(W:[]u8)i32 {
  let keys:[]u8=z_alloc(12*4);
  let successes:i32=0;
  let first_inq:i32=-1;
  let first_adm:i32=-1;
  let t:i32=0;
  while(t<12){
    let k:i32=new_key(W);
    set32(keys,t*4,k);
    let genuine_first:i32=1;
    if((t-(t/2)*2)==1){ genuine_first=0; }
    let g_ok:i32=0;
    let d_ok:i32=0;
    if(genuine_first==1){
      let r:i32=do_query(W,k);
      if(r==-2 && first_adm<0){ first_adm=hg(W,0); }
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){
        g_ok=1;
        if(first_inq<0){ first_inq=hg(W,0); }
        do_observe(W,k,300+t);
      }
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
    } else {
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
      let r:i32=do_query(W,k);
      if(r==-2 && first_adm<0){ first_adm=hg(W,0); }
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){
        g_ok=1;
        if(first_inq<0){ first_inq=hg(W,0); }
        do_observe(W,k,300+t);
      }
    }
    if(g_ok==1 && d_ok==1){ successes=successes+1; }
    t=t+1;
  }
  if(successes<10){ return 0; }
  if(first_inq<0 || first_adm<0){ return 0; }
  if(first_inq<=first_adm){ return 0; }
  let ans:i32=0;
  let q:i32=0;
  while(q<20){
    let k:i32=get32(keys,(q-(q/12)*12)*4);
    let r:i32=do_query(W,k);
    if(r>=0){ ans=ans+1; }
    q=q+1;
  }
  if(ans<16){ return 0; }
  if(audit_traces(W)==0){ return 0; }
  return 1;
}

// ============ Phase 4: novel conflict-type transfer (D3) ============
// W3: experience window on 8 conflict keys (separate workspace).
// Phase 4 measurement: fresh workspace, act registry carried.
// P-INQ5a: 8 fresh conflict queries -> -3, each with a U (marker 3, trace).
// P-INQ5b: each yields one guide within 10 events, selecting CHOICE 30.
// P-INQ5c: >=12/16 follow-up queries return the resolution.
fn phase4(Wprev:[]u8)i32 {
  let We:[]u8=winit();
  carry_acts(Wprev,We);
  let ek:[]u8=z_alloc(8*4);
  let i:i32=0;
  while(i<8){
    let k:i32=new_key(We);
    set32(ek,i*4,k);
    teach(We,k,400+i);
    teach(We,k,900+i);
    i=i+1;
  }
  i=0;
  while(i<8){
    let k:i32=get32(ek,i*4);
    let r:i32=do_query(We,k);
    if(r!=-3){ return 0; }
    let act:i32=CHOICE_INQUIRE();
    if((i-(i/2)*2)==1){ act=CHOICE_DECOY(); }
    do_explore_act(We,act);
    if(act==CHOICE_INQUIRE()){ do_observe(We,k,400+i); }
    i=i+1;
  }
  let an:i32=act_node(We,CHOICE_INQUIRE());
  if(ng(We,an,28)<=0){ return 0; }
  let W:[]u8=winit();
  carry_acts(We,W);
  let mk:[]u8=z_alloc(8*4);
  i=0;
  while(i<8){
    let k:i32=new_key(W);
    set32(mk,i*4,k);
    teach(W,k,500+i);
    teach(W,k,950+i);
    i=i+1;
  }
  i=0;
  while(i<8){
    let k:i32=get32(mk,i*4);
    let t0:i32=hg(W,0);
    let r:i32=do_query(W,k);
    if(r!=-3){ return 0; }
    let u:i32=find_uncert(W,k);
    if(u<0){ return 0; }
    if(ng(W,u,20)!=3){ return 0; }
    if(ng(W,u,24)!=PROC_REIFY()){ return 0; }
    if(count_guides_for(W,u)!=1){ return 0; }
    let g:i32=find_guide(W,u);
    if(g<0){ return 0; }
    if(ng(W,g,20)!=CHOICE_INQUIRE()){ return 0; }
    if(ng(W,g,24)!=PROC_CONSTRUCT()){ return 0; }
    if(hg(W,0)-t0>10){ return 0; }
    let ch:i32=do_opportunity(W);
    if(ch!=CHOICE_INQUIRE()){ return 0; }
    do_observe(W,k,500+i);
    i=i+1;
  }
  let ok:i32=0;
  let q:i32=0;
  while(q<16){
    let qi:i32=q-(q/8)*8;
    let k:i32=get32(mk,qi*4);
    let r:i32=do_query(W,k);
    if(r==500+qi){ ok=ok+1; }
    q=q+1;
  }
  if(ok<12){ return 0; }
  if(audit_traces(W)==0){ return 0; }
  return 1;
}

// ============ Controls ============
// Scaffolding (researcher-authored) uncertainty/guide construction for C1/C3.
// Marked PROC_SCAFFOLD (163); never used in the learner path.
fn scaffold_uncert(W:[]u8,key:i32)i32 {
  let u:i32=alloc_node(W);
  ns(W,u,0,T_UNCERT()); ns(W,u,4,key);
  ns(W,u,20,2); ns(W,u,24,PROC_SCAFFOLD());
  link(W,u,key,ET_DEPENDS());
  link(W,u,hg(W,24),ET_MEMBER());
  ctxpush(W,u);
  return u;
}
fn scaffold_guide(W:[]u8,u:i32,choice:i32)i32 {
  let g:i32=alloc_node(W);
  ns(W,g,0,T_GUIDE()); ns(W,g,4,u);
  ns(W,g,20,choice); ns(W,g,24,PROC_SCAFFOLD());
  link(W,g,u,ET_DEPENDS());
  link(W,g,hg(W,20),ET_DEPENDS());
  link(W,g,hg(W,32),ET_MEMBER());
  return g;
}
// C1: scaffolding baseline. Expect the same behavioral bars to pass (>=10/12, >=16/20).
fn control_c1()i32 {
  let W:[]u8=winit();
  let keys:[]u8=z_alloc(12*4);
  let successes:i32=0;
  let t:i32=0;
  while(t<12){
    let k:i32=new_key(W);
    set32(keys,t*4,k);
    let genuine_first:i32=1;
    if((t-(t/2)*2)==1){ genuine_first=0; }
    let g_ok:i32=0;
    let d_ok:i32=0;
    if(genuine_first==1){
      tick(W);
      let u:i32=scaffold_uncert(W,k);
      let g:i32=scaffold_guide(W,u,CHOICE_INQUIRE());
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){ g_ok=1; do_observe(W,k,300+t); }
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
    } else {
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
      tick(W);
      let u:i32=scaffold_uncert(W,k);
      let g:i32=scaffold_guide(W,u,CHOICE_INQUIRE());
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){ g_ok=1; do_observe(W,k,300+t); }
    }
    if(g_ok==1 && d_ok==1){ successes=successes+1; }
    t=t+1;
  }
  if(successes<10){ return 0; }
  let ans:i32=0;
  let q:i32=0;
  while(q<20){
    let k:i32=get32(keys,(q-(q/12)*12)*4);
    tick(W);
    let r:i32=query(W,k);
    if(r>=0){ ans=ans+1; }
    q=q+1;
  }
  if(ans<16){ return 0; }
  return 1;
}
// C2: null policy (POLICY_ROOT null). Expect zero emissions across 12 trials.
fn control_c2()i32 {
  let W:[]u8=winit();
  ns(W,0,20,0);
  let t:i32=0;
  while(t<12){
    let k:i32=new_key(W);
    do_query(W,k);
    let ch:i32=do_opportunity(W);
    if(ch!=0){ return 0; }
    t=t+1;
  }
  return 1;
}
// C3: alternating 30/31 scaffolding guides. Expect the bars to FAIL
// (successes ~6 <10, answers ~10 <16), showing the checks are non-vacuous.
fn control_c3()i32 {
  let W:[]u8=winit();
  let keys:[]u8=z_alloc(12*4);
  let successes:i32=0;
  let t:i32=0;
  while(t<12){
    let k:i32=new_key(W);
    set32(keys,t*4,k);
    let ch_choice:i32=CHOICE_INQUIRE();
    if((t-(t/2)*2)==1){ ch_choice=CHOICE_DECOY(); }
    let genuine_first:i32=1;
    if((t-(t/2)*2)==1){ genuine_first=0; }
    let g_ok:i32=0;
    let d_ok:i32=0;
    if(genuine_first==1){
      tick(W);
      let u:i32=scaffold_uncert(W,k);
      let g:i32=scaffold_guide(W,u,ch_choice);
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){ g_ok=1; do_observe(W,k,300+t); }
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
    } else {
      let ch2:i32=do_opportunity(W);
      if(ch2!=CHOICE_INQUIRE()){ d_ok=1; }
      tick(W);
      let u:i32=scaffold_uncert(W,k);
      let g:i32=scaffold_guide(W,u,ch_choice);
      let ch:i32=do_opportunity(W);
      if(ch==CHOICE_INQUIRE()){ g_ok=1; do_observe(W,k,300+t); }
    }
    if(g_ok==1 && d_ok==1){ successes=successes+1; }
    t=t+1;
  }
  if(successes>=10){ return 0; }
  let ans:i32=0;
  let q:i32=0;
  while(q<20){
    let k:i32=get32(keys,(q-(q/12)*12)*4);
    tick(W);
    let r:i32=query(W,k);
    if(r>=0){ ans=ans+1; }
    q=q+1;
  }
  if(ans>=16){ return 0; }
  return 1;
}

// ============ main battery ============
fn main()void {
  let W1:[]u8=winit();
  let p1:i32=phase1(W1);
  let a1:i32=ablation_a1();
  let w1p2:i32=w1_phase2(W1);
  let a2:i32=ablation_a2();
  let W2:[]u8=winit();
  carry_acts(W1,W2);
  let p3:i32=phase3_body(W2);
  let p4:i32=phase4(W2);
  let c1:i32=control_c1();
  let c2:i32=control_c2();
  let c3:i32=control_c3();
  emit("P-INQ1 "); e64(p1); emit("\n");
  emit("A1 "); e64(a1); emit("\n");
  emit("W1P2 "); e64(w1p2); emit("\n");
  emit("A2 "); e64(a2); emit("\n");
  emit("P-INQ3 "); e64(p3); emit("\n");
  emit("P-INQ5 "); e64(p4); emit("\n");
  emit("C1 "); e64(c1); emit("\n");
  emit("C2 "); e64(c2); emit("\n");
  emit("C3 "); e64(c3); emit("\n");
  return;
}

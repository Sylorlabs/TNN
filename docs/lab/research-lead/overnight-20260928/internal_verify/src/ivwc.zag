// ivwc.zag -- Internal Verification via World Consequences.
// The learner commits to a composition output plus its own confidence
// BEFORE any outcome signal. The world then returns environmental
// consequences (physics of executing the plan: items collected,
// energy used, bumps, wasted gathers). The learner updates its own
// calibration from those consequences. Sealed cases test whether the
// updated self-evaluation predicts future performance.
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const UPDN:i32=40;

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn abs32(v:i32)i32 {
  if(v<0){return 0-v;}
  return v;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow). The seed is
// reduced mod 65536 on entry so large frozen seeds (e.g. 7919*cid+13)
// cannot overflow the multiply on the first step.
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}

// ===== WORLD =====
// Ground-truth generator. Record: walls[0..19], items[20..39], start[40].
fn world_gen(seed:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < 15){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
// Belief generator (harness setup only): frozen noisy copy of truth.
// Wall belief flips 12% (never start). True items dropped 15%.
// Empty true-open cells gain phantom item beliefs 18%.
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
// Step physics. st cells: pos@0, collected@4, bumps@8, wasted@12.
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)void {
  let pos:i32=get32(st,0);
  let ok:i32=0;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ ok=1; }
  }
  if(ok==1){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)void {
  let pos:i32=get32(st,0);
  let ok:i32=0;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ ok=1; }
  }
  if(ok==1){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)void {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)void {
  if(a==0){ w_left(world_buf,world_off,st); }
  else {
    if(a==1){ w_right(world_buf,world_off,st); }
    else { w_gather(world_buf,world_off,got,st); }
  }
  return;
}
// Consequence simulator: steps the committed plan through corridor
// physics. cons cells: collected@0, energy_used@4, bumps@8,
// wasted@12, final_pos@16, plan_len@20. No reference plan exists;
// these are physics outputs of executing this plan in this world.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// 1 if the believed interval [lo,hi] holds a believed wall.
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
// Append one leg: moves from pos toward tgt, then GATHER.
// pcs cells: pos@0 (in/out), tgt@4, at@8 (in/out).
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only. Sees no world truth.
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Learner-owned calibration update. Inputs: its own table, the
// commit-time bucket, its raw confidence, and the consequence buffer.
// No world truth reaches this function.
fn learner_update(upd:[]u8, b:i32, raw:i32, cb:[]u8, coff:i32)void {
  let col:i32=get32(cb,coff);
  let eu:i32=get32(cb,coff+4);
  let act:i32=0;
  if(eu>0){ act=(100*col)/eu; }
  let err:i32=raw-act;
  set32(upd,b*4,get32(upd,b*4)+1);
  set32(upd,16+b*4,get32(upd,16+b*4)+err);
  set32(upd,32,get32(upd,32)+1);
  set32(upd,36,get32(upd,36)+err);
  return;
}
// Calibrated confidence for a future case.
fn learner_calibrated(upd:[]u8, b:i32, raw:i32)i32 {
  let cal:i32=raw;
  let n:i32=get32(upd,b*4);
  if(n>0){ cal=raw-(get32(upd,16+b*4)/n); }
  else {
    let gn:i32=get32(upd,32);
    if(gn>0){ cal=raw-(get32(upd,36)/gn); }
  }
  if(cal<0){ cal=0; }
  if(cal>100){ cal=100; }
  return cal;
}

// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWC-BEGIN\n");
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let upd:[]u8=z_alloc(UPDN);
  let upd_shuf:[]u8=z_alloc(UPDN);
  let upd_zero:[]u8=z_alloc(UPDN);
  let wc:[]u8=z_alloc(4);
  // Phase 1: setup. Harness builds truth and the learner's beliefs.
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // Phase 2: train COMMIT. Learner sees beliefs only.
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  let k1:i32=0;
  if(get32(wc,0)==0){
    k1=1;
    at=ob_app(ob,at,"K1-STRUCT-PASS world_calls=0 after train commit\n");
  } else {
    at=ob_app(ob,at,"K1-STRUCT-FAIL\n");
  }
  // Phase 3: train CONSEQUENCE. World executes committed plans.
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, wc);
    t=t+1;
  }
  // Phase 4: train UPDATE. Feedback arm learns its calibration;
  // shuffled arm pairs each case with another case's consequences.
  t=0;
  while(t<NTRAIN){
    learner_update(upd, get32(mtrain,t*RECM+12), get32(mtrain,t*RECM+8), ctrain, t*RECC);
    t=t+1;
  }
  t=0;
  while(t<NTRAIN){
    let u2:i32=t+7;
    if(u2>=NTRAIN){ u2=u2-NTRAIN; }
    learner_update(upd_shuf, get32(mtrain,t*RECM+12), get32(mtrain,t*RECM+8), ctrain, u2*RECC);
    t=t+1;
  }
  // K3 in-program check: some train confidence must have moved.
  let k3n:i32=0;
  t=0;
  while(t<NTRAIN){
    let b3:i32=get32(mtrain,t*RECM+12);
    let raw3:i32=get32(mtrain,t*RECM+8);
    if(learner_calibrated(upd,b3,raw3)!=raw3){ k3n=k3n+1; }
    t=t+1;
  }
  let k3:i32=0;
  if(k3n>0){
    k3=1;
    at=ob_app(ob,at,"K3-STRUCT-PASS nmoved=");
    at=ob_i32(ob,at,k3n);
    at=ob_nl(ob,at);
  } else {
    at=ob_app(ob,at,"K3-STRUCT-FAIL\n");
  }
  // Calibration table (learner-owned state, white box).
  at=ob_app(ob,at,"CALIB b n meanerr\n");
  let b:i32=0;
  while(b<4){
    let bn:i32=get32(upd,b*4);
    let me:i32=0;
    if(bn>0){ me=get32(upd,16+b*4)/bn; }
    at=ob_app(ob,at,"CAL b=");
    at=ob_i32(ob,at,b);
    at=ob_app(ob,at," n=");
    at=ob_i32(ob,at,bn);
    at=ob_app(ob,at," meanerr=");
    at=ob_i32(ob,at,me);
    at=ob_nl(ob,at);
    b=b+1;
  }
  // Train case detail.
  at=ob_app(ob,at,"TRAIN t g L raw cal act\n");
  t=0;
  while(t<NTRAIN){
    let tg:i32=get32(mtrain,t*RECM);
    let tL:i32=get32(mtrain,t*RECM+4);
    let traw:i32=get32(mtrain,t*RECM+8);
    let tb:i32=get32(mtrain,t*RECM+12);
    let tcal:i32=learner_calibrated(upd,tb,traw);
    let tcol:i32=get32(ctrain,t*RECC);
    let teu:i32=get32(ctrain,t*RECC+4);
    let tact:i32=0;
    if(teu>0){ tact=(100*tcol)/teu; }
    at=ob_app(ob,at,"T t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," g=");
    at=ob_i32(ob,at,tg);
    at=ob_app(ob,at," L=");
    at=ob_i32(ob,at,tL);
    at=ob_app(ob,at," raw=");
    at=ob_i32(ob,at,traw);
    at=ob_app(ob,at," cal=");
    at=ob_i32(ob,at,tcal);
    at=ob_app(ob,at," act=");
    at=ob_i32(ob,at,tact);
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Phase 5: sealed setup. Fresh worlds the learner never saw.
  let s:i32=0;
  while(s<NSEAL){
    let cid:i32=100+s;
    world_gen(7919*cid+13, wseal, s*RECW);
    belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
    s=s+1;
  }
  // Phase 6: sealed COMMIT (batched before any sealed consequence).
  s=0;
  while(s<NSEAL){
    learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
    s=s+1;
  }
  // Phase 7: sealed CONSEQUENCE + metrics.
  let sum_raw:i32=0;
  let sum_cal:i32=0;
  let sum_abl:i32=0;
  let sum_shuf:i32=0;
  at=ob_app(ob,at,"SEALED s raw cal abl shuf act\n");
  s=0;
  while(s<NSEAL){
    let sL:i32=get32(mseal,s*RECM+4);
    world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL, cseal, s*RECC, wc);
    let sb:i32=get32(mseal,s*RECM+12);
    let sraw:i32=get32(mseal,s*RECM+8);
    let scal:i32=learner_calibrated(upd,sb,sraw);
    let sabl:i32=learner_calibrated(upd_zero,sb,sraw);
    let ssh:i32=learner_calibrated(upd_shuf,sb,sraw);
    let scol:i32=get32(cseal,s*RECC);
    let seu:i32=get32(cseal,s*RECC+4);
    let sact:i32=0;
    if(seu>0){ sact=(100*scol)/seu; }
    sum_raw=sum_raw+abs32(sraw-sact);
    sum_cal=sum_cal+abs32(scal-sact);
    sum_abl=sum_abl+abs32(sabl-sact);
    sum_shuf=sum_shuf+abs32(ssh-sact);
    at=ob_app(ob,at,"S s=");
    at=ob_i32(ob,at,s);
    at=ob_app(ob,at," raw=");
    at=ob_i32(ob,at,sraw);
    at=ob_app(ob,at," cal=");
    at=ob_i32(ob,at,scal);
    at=ob_app(ob,at," abl=");
    at=ob_i32(ob,at,sabl);
    at=ob_app(ob,at," shuf=");
    at=ob_i32(ob,at,ssh);
    at=ob_app(ob,at," act=");
    at=ob_i32(ob,at,sact);
    at=ob_nl(ob,at);
    s=s+1;
  }
  at=ob_app(ob,at,"SUMMARY nseal=");
  at=ob_i32(ob,at,NSEAL);
  at=ob_app(ob,at," sum_raw=");
  at=ob_i32(ob,at,sum_raw);
  at=ob_app(ob,at," sum_cal=");
  at=ob_i32(ob,at,sum_cal);
  at=ob_app(ob,at," sum_abl=");
  at=ob_i32(ob,at,sum_abl);
  at=ob_app(ob,at," sum_shuf=");
  at=ob_i32(ob,at,sum_shuf);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(sum_cal<sum_raw){
    k4=1;
    at=ob_app(ob,at,"K4-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K4-PROV-FAIL\n");
  }
  let k6:i32=0;
  if(sum_abl>sum_cal){
    k6=1;
    at=ob_app(ob,at,"K6-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K6-PROV-FAIL\n");
  }
  at=ob_app(ob,at,"K2-AUDIT-SHELL K5-AUDIT-SHELL\n");
  at=ob_app(ob,at,"FLAGS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWC-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

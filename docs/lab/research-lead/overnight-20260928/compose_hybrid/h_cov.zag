// h_cov.zag -- arm C: coverage-directed selective widening.
// Fidelity copy of compose_widen/w_cov.zag (that lane is not modified),
// with main() extended to D4/D5. One widening rule always on: a failed
// trial that records a NEW coverage miss immediately admits exactly the
// filter-rejected, untried ordered pairs junction-justified by the
// missbits ledger (WIDEN=1, WTRIG=2, WADD=x,y per pair). There is NO blind
// exhaustive-failure retry in this arm.
// Miss bits: bit 1<<(k-1) at ledger (m, p), p=0 in, p=1 out.
fn miss_bit(A:[]u8,m:i32,p:i32,k:i32)i32 {
  if(k_has(mg(A,m,3+p),k)==0){ return lg_add(A,m,p,k); }
  return 0;
}
fn c_miss_single(A:[]u8,m:i32,s:i32,v:i32)i32 {
  if(v<0){ return 0; }
  let a:i32=miss_bit(A,m,0,pkind(A,s));
  let b:i32=miss_bit(A,m,1,pkind(A,v));
  if(a==1){ return 1; }
  return b;
}
fn c_miss_pair(A:[]u8,x:i32,y:i32,v1:i32,v2:i32)i32 {
  if(v1<0){ return 0; }
  let a:i32=miss_bit(A,x,1,pkind(A,v1));
  let b:i32=0;
  let d:i32=0;
  if(v2>=0){
    b=miss_bit(A,y,0,pkind(A,v1));
    d=miss_bit(A,y,1,pkind(A,v2));
  }
  if(a==1){ return 1; }
  if(b==1){ return 1; }
  return d;
}
fn c_justified(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(k_has(mg(A,x,3),kin)==0){ return 0; }
  if(k_has(mg(A,y,4),kout)==0){ return 0; }
  let lo:i32=lg_get(A,x,1);
  let ei:i32=eff_mask(A,y,3);
  if((lo & ei)!=0){ return 1; }
  let li:i32=lg_get(A,y,0);
  let eo:i32=eff_mask(A,x,4);
  if((li & eo)!=0){ return 1; }
  return 0;
}
fn c_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,wom:i32)i32 {
  ap(A,1060,ag(A,1060)|(1<<(x*4+y)));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v1:i32=exec_map(A,x,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  let v2:i32=-3;
  if(v1>=0){
    v2=exec_map(A,y,v1);
    if(v2==exp){
      observe(A,x,s,v1); observe(A,y,v1,v2);
      ap(A,944,v2); ap(A,940,1); ap(A,1064,v1);
      return c;
    }
  }
  let nw:i32=c_miss_pair(A,x,y,v1,v2);
  if(wom==1 && nw==1){ c=c_widen(A,B,c); }
  return c;
}
fn c_try_single(A:[]u8,B:[]u8,c:i32,a:i32,wom:i32)i32 {
  ap(A,1056,ag(A,1056)|(1<<a));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v:i32=exec_map(A,a,s);
  if(v==exp){
    observe(A,a,s,v);
    ap(A,944,v); ap(A,940,1); ap(A,1064,-1);
    return c;
  }
  let nw:i32=c_miss_single(A,a,s,v);
  if(wom==1 && nw==1){ c=c_widen(A,B,c); }
  return c;
}
// Try the first (id order) filter-rejected, untried, ledger-justified pair.
fn wadmit_get(A:[]u8,x:i32,y:i32)i32 {
  if((ag(A,1100) & (1<<(x*4+y)))!=0){ return 1; }
  return 0;
}
fn wadmit_set(A:[]u8,x:i32,y:i32)void {
  ap(A,1100,ag(A,1100)|(1<<(x*4+y)));
  return;
}
// Admission phase: admit EVERY currently-justified untried rejected pair.
fn c_admit_scan(A:[]u8,B:[]u8,c:i32)i32 {
  ap(A,1096,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && tried_pair(A,x,y)==0 && wadmit_get(A,x,y)==0 && admit_pair(A,x,y,kin,kout)==0 && c_justified(A,x,y,kin,kout)==1){
        c=o_app(B,c,"WADD="); c=o_i64(B,c,x as i64);
        c=o_app(B,c,","); c=o_i64(B,c,y as i64); c=o_nl(B,c);
        wadmit_set(A,x,y);
        ap(A,1096,1);
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// Trial phase: try widen-admitted untried pairs in id order.
fn c_trial_scan(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(wadmit_get(A,x,y)==1 && tried_pair(A,x,y)==0){
        c=c_try_pair(A,B,c,x,y,0);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// Selective widening: admit-all-then-try, rescanning while new misses
// justify further pairs.
fn c_widen(A:[]u8,B:[]u8,c:i32)i32 {
  if(ag(A,1068)==0){
    c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=2"); c=o_nl(B,c);
    ap(A,1068,1); ap(A,1072,2);
  }
  ap(A,1096,1);
  while(ag(A,1096)==1 && ag(A,940)==0){
    c=c_admit_scan(A,B,c);
    c=c_trial_scan(A,B,c);
  }
  return c;
}
fn c_solve(A:[]u8,B:[]u8,c:i32,prob:[]u8)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  ap(A,1056,0); ap(A,1060,0); ap(A,1064,-1); ap(A,1068,0); ap(A,1072,0);
  ap(A,1096,0); ap(A,1100,0); ap(A,1104,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  lg_clear(A,nm);
  let a:i32=0;
  while(a<nm){
    if(admit_single(A,a,kin,kout)==1){
      c=c_try_single(A,B,c,a,1);
      if(ag(A,940)==1){ c=report(A,B,c,"C",prob,nm); return c; }
    }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==1 && tried_pair(A,x,y)==0){
        c=c_try_pair(A,B,c,x,y,1);
        if(ag(A,940)==1){ c=report(A,B,c,"C",prob,nm); return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  c=report(A,B,c,"C",prob,nm);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A0:[]u8=world_new();
  setup_d0(A0); stash(A0,31,1,2,2,4);
  c=c_solve(A0,B,c,"D0");
  let A1:[]u8=world_new();
  setup_d1(A1); stash(A1,41,1,2,2,4);
  c=c_solve(A1,B,c,"D1");
  let A2:[]u8=world_new();
  setup_d2(A2); stash(A2,41,1,2,2,3);
  c=c_solve(A2,B,c,"D2");
  let A3:[]u8=world_new();
  setup_d3(A3); stash(A3,41,1,1,44,3);
  c=c_solve(A3,B,c,"D3");
  let A4:[]u8=world_new();
  setup_d4(A4); stash(A4,41,1,1,47,4);
  c=c_solve(A4,B,c,"D4");
  let A5:[]u8=world_new();
  setup_d5(A5); stash(A5,41,1,2,2,4);
  c=c_solve(A5,B,c,"D5");
  o_flush(B,c);
  return 0;
}

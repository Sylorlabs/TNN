// ddes_integ.zag -- DDES integration into the continuing learner causal path.
// Pure Zag. No Python anywhere.
//
// Prereg: PREREG_DDES_INTEG.md (commit c3fecd3c8), frozen strictly before
// this file was written.
//
// A continuing learner holds a persistent causal ledger across sequential
// experiences. Each entry carries two competing hypothesis rule graphs.
// When both hypotheses stay consistent with passive evidence and differ,
// the entry becomes AMBIGUOUS. Mode 0 (BASE): the un-integrated learner
// withholds on AMBIGUOUS entries. Mode 1 (INTEG): ambiguity triggers the
// DDES derivation path (copied verbatim from the frozen sources): analytic
// arrival computation, disagreement frontier, one synthesized plan,
// exactly one real execution, elimination from the outcome, resolution.
//
// Derivation core provenance (verbatim copies):
//   compute_arrivals, compute_frontier, z_alloc, emit, get32, set32,
//   i64s, e64  -- from ddes/ddes.zag (BUILD-PASS 56db8d606)
//   eff_waits, synthesize_plan_gen, predict_gen, world_step_gen
//   -- from ddes_generalize/ddes_gen.zag (GENERALIZATION-TESTED 843c45fee)
//
// Integration glue (ledger, feed, query, integrate, main) is new.

// ============ utils (verbatim from frozen ddes.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ generic arrival computation (verbatim from frozen ddes.zag) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (verbatim from frozen ddes.zag) ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ eff_waits (verbatim from frozen ddes_gen.zag; t*=0 soundness repair) ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (verbatim from frozen ddes_gen.zag) ============
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ analytic predictor (verbatim from frozen ddes_gen.zag) ============
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ world stepper (verbatim from frozen ddes_gen.zag) ============
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ continuing-learner causal ledger (integration glue, new) ============
// Entry stride 416 bytes. Per entry at base = e*416:
//   +0 status (0=EMPTY,1=ACTIVE,2=AMBIGUOUS), +4 winner (0/1), +8 n_vars,
//   +12 h0 block (128B), +140 h1 block (128B), +268 sealed true block (128B).
// Rule block layout: +0 nr, +4 src[8], +36 dst[8], +68 delay[8].
fn ent_base(e:i32)i32 { return e*416; }
fn blk_base(e:i32, k:i32)i32 { return e*416+12+k*128; }
fn w_get(ws:[]u8, off:i32)i32 { return get32(ws, off); }
fn w_set(ws:[]u8, off:i32, v:i32)void { set32(ws, off, v); return; }

fn load_h0_e0(ws:[]u8)void {
  let b:i32=blk_base(0,0);
  set32(ws,b,2);
  set32(ws,b+4,0); set32(ws,b+8,2);
  set32(ws,b+36,2); set32(ws,b+40,1);
  set32(ws,b+68,2); set32(ws,b+72,0);
  return;
}
fn load_h0_e1(ws:[]u8)void {
  let b:i32=blk_base(1,0);
  set32(ws,b,1);
  set32(ws,b+4,0);
  set32(ws,b+36,1);
  set32(ws,b+68,3);
  return;
}
fn load_h0_e2(ws:[]u8)void {
  let b:i32=blk_base(2,0);
  set32(ws,b,1);
  set32(ws,b+4,0);
  set32(ws,b+36,1);
  set32(ws,b+68,1);
  return;
}
fn load_h1_e2(ws:[]u8)void {
  let b:i32=blk_base(2,1);
  set32(ws,b,1);
  set32(ws,b+4,0);
  set32(ws,b+36,1);
  set32(ws,b+68,2);
  return;
}
fn copy_block(ws:[]u8, e:i32, from_k:i32, to_k:i32)void {
  let a:i32=blk_base(e,from_k);
  let b:i32=blk_base(e,to_k);
  let i:i32=0;
  while(i<128){ ws[b+i]=ws[a+i]; i=i+1; }
  return;
}
// src/dst/delay slices of a block (each 8 i32 = 32 bytes).
fn blk_src(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+4..b+36];
}
fn blk_dst(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+36..b+68];
}
fn blk_delay(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+68..b+100];
}
fn blk_nr(ws:[]u8, e:i32, k:i32)i32 {
  return get32(ws, blk_base(e,k));
}

// Feed one experience: two hypothesis blocks are already loaded; the true
// block is loaded for e2 (sealed world). Checks passive consistency,
// determines ACTIVE vs AMBIGUOUS, emits FEED/ENTRY lines. In INTEG mode,
// an AMBIGUOUS entry immediately triggers construction.
fn feed(ws:[]u8, e:i32, pv:i32, pt:i32, pout:i32, nh:i32, mode:i32)void {
  let n_vars:i32=3;
  w_set(ws, ent_base(e)+8, n_vars);
  let n0:i32=blk_nr(ws,e,0);
  let n1:i32=blk_nr(ws,e,1);
  let c0:i32=predict_gen(n0, blk_src(ws,e,0), blk_dst(ws,e,0), blk_delay(ws,e,0), n_vars, 1, pv, pt);
  let c1:i32=predict_gen(n1, blk_src(ws,e,1), blk_dst(ws,e,1), blk_delay(ws,e,1), n_vars, 1, pv, pt);
  let ok0:i32=0; if(c0==pout){ok0=1;}
  let ok1:i32=0; if(c1==pout){ok1=1;}
  emit("FEED e"); e64(e); emit(" nh="); e64(nh);
  emit(" passive=("); e64(pv); emit(","); e64(pt); emit(")="); e64(pout); emit("\n");
  if(ok0==1 && ok1==1){
    // both consistent: check whether they differ (frontier under either schema)
    let INF:i32=268435456;
    let diff:i32=0;
    let schema:i32=1;
    while(schema>=0){
      let a0:[]u8=z_alloc(n_vars*4);
      let a1:[]u8=z_alloc(n_vars*4);
      compute_arrivals(n0, blk_src(ws,e,0), blk_dst(ws,e,0), blk_delay(ws,e,0), n_vars, schema, a0);
      compute_arrivals(n1, blk_src(ws,e,1), blk_dst(ws,e,1), blk_delay(ws,e,1), n_vars, schema, a1);
      let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4);
      compute_frontier(a0, a1, n_vars, f, fv, ft);
      if(get32(f,0)==1){ diff=1; }
      schema=schema-1;
    }
    if(diff==1){
      w_set(ws, ent_base(e), 2);
      emit("ENTRY e"); e64(e); emit(" AMBIGUOUS cands=2\n");
      if(mode==1){ integrate(ws, e); }
    } else {
      w_set(ws, ent_base(e), 1);
      w_set(ws, ent_base(e)+4, 0);
      emit("ENTRY e"); e64(e); emit(" ACTIVE winner=h0\n");
    }
  } else if(ok0==1){
    w_set(ws, ent_base(e), 1);
    w_set(ws, ent_base(e)+4, 0);
    emit("ENTRY e"); e64(e); emit(" ACTIVE winner=h0\n");
  } else if(ok1==1){
    w_set(ws, ent_base(e), 1);
    w_set(ws, ent_base(e)+4, 1);
    emit("ENTRY e"); e64(e); emit(" ACTIVE winner=h1\n");
  } else {
    emit("ENTRY e"); e64(e); emit(" FEED-ERROR no-consistent-hypothesis\n");
  }
  return;
}

fn emit_plan(plan:[]u8, plen:i32)void {
  emit("[");
  let j:i32=0;
  while(j<plen){
    let a:i32=plan[j] as i32;
    if(j>0){ emit(","); }
    if(a==0){ emit("S"); }
    else if(a==1){ emit("W"); }
    else { emit("O("); e64(a-2); emit(")"); }
    j=j+1;
  }
  emit("]");
  return;
}

// DDES construction triggered by an AMBIGUOUS entry: derive the earliest
// disagreement frontier, assemble exactly one plan, execute it exactly
// once against the sealed true world, eliminate from the outcome.
fn integrate(ws:[]u8, e:i32)void {
  let INF:i32=268435456;
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let n0:i32=blk_nr(ws,e,0);
  let n1:i32=blk_nr(ws,e,1);
  let nt:i32=blk_nr(ws,e,2);
  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(n_vars*4);
    let a1:[]u8=z_alloc(n_vars*4);
    compute_arrivals(n0, blk_src(ws,e,0), blk_dst(ws,e,0), blk_delay(ws,e,0), n_vars, schema, a0);
    compute_arrivals(n1, blk_src(ws,e,1), blk_dst(ws,e,1), blk_delay(ws,e,1), n_vars, schema, a1);
    let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, f, fv, ft);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      if(t<best_t){
        best_t=t; best_v=get32(fv,0); best_schema=schema; best_found=1;
      }
    }
    schema=schema-1;
  }
  if(best_found==0){
    emit("INTEG e"); e64(e); emit(" NO-DISCRIMINATING-PLAN\n");
    return;
  }
  emit("INTEG e"); e64(e); emit(" TARGET V*="); e64(best_v);
  emit(" t*="); e64(best_t); emit(" schema="); e64(best_schema); emit("\n");
  let plans_built:[]u8=z_alloc(4);
  let plan:[]u8=z_alloc(256);
  let plen:i32=synthesize_plan_gen(best_v, best_t, best_schema, plan, plans_built);
  emit("INTEG e"); e64(e); emit(" PLAN "); emit_plan(plan, plen);
  emit(" built="); e64(get32(plans_built,0)); emit("\n");
  // Exactly one real execution against the sealed true world.
  let st:[]u8=z_alloc(n_vars*8+4);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_gen(nt, blk_src(ws,e,2), blk_dst(ws,e,2), blk_delay(ws,e,2), n_vars, st, plan[j] as i32);
    if(o>=0){ real_obs=o; }
    j=j+1;
  }
  emit("INTEG e"); e64(e); emit(" EXEC real="); e64(real_obs); emit("\n");
  let p0:i32=predict_gen(n0, blk_src(ws,e,0), blk_dst(ws,e,0), blk_delay(ws,e,0), n_vars, best_schema, best_v, best_t);
  let p1:i32=predict_gen(n1, blk_src(ws,e,1), blk_dst(ws,e,1), blk_delay(ws,e,1), n_vars, best_schema, best_v, best_t);
  emit("INTEG e"); e64(e); emit(" PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
  if(p0==real_obs){ emit("INTEG e"); e64(e); emit(" SURVIVE h0\n"); }
  else { emit("INTEG e"); e64(e); emit(" ELIM h0\n"); }
  if(p1==real_obs){ emit("INTEG e"); e64(e); emit(" SURVIVE h1\n"); }
  else { emit("INTEG e"); e64(e); emit(" ELIM h1\n"); }
  let s0:i32=0; if(p0==real_obs){ s0=1; }
  let s1:i32=0; if(p1==real_obs){ s1=1; }
  if(s0+s1==1){
    w_set(ws, ent_base(e), 1);
    if(s1==1){ w_set(ws, ent_base(e)+4, 1); } else { w_set(ws, ent_base(e)+4, 0); }
    emit("INTEG e"); e64(e); emit(" RESOLVED winner=h");
    if(s1==1){ e64(1); } else { e64(0); }
    emit("\n");
  } else {
    emit("INTEG e"); e64(e); emit(" RESOLVE-FAIL\n");
  }
  return;
}

// Query the learner. ACTIVE: predict from the resolved hypothesis.
// AMBIGUOUS: withhold. Returns prediction, or -1 on withhold.
fn query(ws:[]u8, e:i32, v:i32, t:i32)i32 {
  let st:i32=w_get(ws, ent_base(e));
  emit("Q e"); e64(e); emit(" ("); e64(v); emit(","); e64(t); emit(") -> ");
  if(st==1){
    let w:i32=w_get(ws, ent_base(e)+4);
    let n_vars:i32=w_get(ws, ent_base(e)+8);
    let nk:i32=blk_nr(ws,e,w);
    let p:i32=predict_gen(nk, blk_src(ws,e,w), blk_dst(ws,e,w), blk_delay(ws,e,w), n_vars, 1, v, t);
    e64(p); emit("\n");
    return p;
  }
  emit("WITHHOLD (ambiguous)\n");
  return -1;
}

fn zero_ledger(ws:[]u8)void {
  let i:i32=0;
  while(i<3*416){ ws[i]=0; i=i+1; }
  return;
}

fn run_all(ws:[]u8, mode:i32)i32 {
  let ok:i32=0;
  let total:i32=0;
  let resolved:i32=0;
  zero_ledger(ws);
  // e0: P1 unambiguous, h = [(X->Z,2),(Z->Y,0)], passive (Y,2)=1.
  load_h0_e0(ws); copy_block(ws,0,0,1);
  feed(ws, 0, 1, 2, 1, 1, mode);
  let q:i32=query(ws, 0, 1, 2);
  total=total+1; if(q==1){ ok=ok+1; }
  // e1: P2 unambiguous, h = [(X->Y,3)], passive (Y,2)=0.
  load_h0_e1(ws); copy_block(ws,1,0,1);
  feed(ws, 1, 1, 2, 0, 1, mode);
  q=query(ws, 1, 1, 2);
  total=total+1; if(q==0){ ok=ok+1; }
  q=query(ws, 1, 1, 3);
  total=total+1; if(q==1){ ok=ok+1; }
  // e2: frozen ambiguity, h0=[(X->Y,1)], h1=[(X->Y,2)], true=h1.
  load_h0_e2(ws); load_h1_e2(ws); copy_block(ws,2,1,2);
  feed(ws, 2, 1, 2, 1, 2, mode);
  if(mode==0){
    q=query(ws, 2, 1, 1);
    total=total+1; if(q==-1){ ok=ok+1; }
  } else {
    let st:i32=w_get(ws, ent_base(2));
    let w:i32=w_get(ws, ent_base(2)+4);
    total=total+1; if(st==1 && w==1){ ok=ok+1; resolved=1; }
    q=query(ws, 2, 1, 1);
    total=total+1; if(q==0){ ok=ok+1; }
    q=query(ws, 2, 1, 2);
    total=total+1; if(q==1){ ok=ok+1; }
  }
  emit("SUMMARY mode=");
  if(mode==0){ emit("BASE"); } else { emit("INTEG"); }
  emit(" ok="); e64(ok); emit("/"); e64(total);
  emit(" resolved="); e64(resolved); emit("\n");
  return ok;
}

fn main()i32 {
  let ws:[]u8=z_alloc(4096);
  emit("MODE=BASE\n");
  let ok0:i32=run_all(ws, 0);
  emit("MODE=INTEG\n");
  let ok1:i32=run_all(ws, 1);
  if(ok0<0 || ok1<0){ return 1; }
  return 0;
}

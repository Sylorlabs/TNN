// cc_main.zag -- CYCLES-CONVERGENT driver.
// Runs the three convergent workloads on the fully frozen mechanism
// (gc_solve) and base: QC1 interior depth-3, QC2 interior depth-5,
// QC3 chain-end limit. One binary; 3/3 byte-identical runs required (C2).
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_qc1(A);
  c=gc_solve(A,B,c,7001,1,1,7004,4,8,8);
  c=uni_report(A,B,c,"GC","QC1");
  c=uni_census(A,B,c,4);
  let A1:[]u8=world_new();
  setup_qc2(A1);
  c=gc_solve(A1,B,c,7101,1,1,7106,4,8,8);
  c=uni_report(A1,B,c,"GC","QC2");
  c=uni_census(A1,B,c,4);
  let A2:[]u8=world_new();
  setup_qc3(A2);
  c=gc_solve(A2,B,c,7201,1,1,7204,4,8,8);
  c=uni_report(A2,B,c,"GC","QC3");
  c=uni_census(A2,B,c,4);
  o_flush(B,c);
  return 0;
}

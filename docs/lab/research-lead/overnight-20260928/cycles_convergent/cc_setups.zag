// cc_setups.zag -- CYCLES-CONVERGENT workload setups (frozen after prereg).
// Three convergent-signal workloads, all identifiers opaque integers. No
// iteration, no repeat/threshold check, no direct structure-application
// call in this file: each setup poses facts + MAPs + teach
// observations plus ONE solve query issued by the driver main.
//
// Shared inventory: m0 = class 4 STEP on 701 (the convergent MAP);
// m1/m2/m3 = class 1 COUNT distractors on 606/605/607 (block reused
// from cycles_oscillatory; nothing collides with the chain states).
// No IDENT MAP: kept comparable to the C425 inventory; with s != exp
// in all three queries IDENT could not win in any case.
//
// setup_qc1 (C-Q1): 9-hop chain 7001->...->7010 on rel 701.
// Query s=7001, exp=7004 (depth 3, interior; the walk continues past).
// setup_qc2 (C-Q2): 9-hop chain 7101->...->7110 on rel 701.
// Query s=7101, exp=7106 (depth 5, interior).
// setup_qc3 (C-Q3): 3-hop chain 7201->7202->7203->7204 on rel 701;
// 7204 is the chain end (no outgoing edge): the limit of the walk.
// Query s=7201, exp=7204 (the limit itself, reached at depth 3).
fn cc_distractors(A:[]u8)void {
  fact_add(A,6101,605,6102);
  fact_add(A,6201,606,6202); fact_add(A,6201,606,6203);
  fact_add(A,6301,607,9301);
  map_new(A,1,1,606,0);
  map_new(A,2,1,605,0);
  map_new(A,3,1,607,0);
  teach(A,1,6201,2);
  teach(A,2,6101,1);
  teach(A,3,6301,1);
  return;
}
fn setup_qc1(A:[]u8)void {
  fact_add(A,7001,701,7002);
  fact_add(A,7002,701,7003);
  fact_add(A,7003,701,7004);
  fact_add(A,7004,701,7005);
  fact_add(A,7005,701,7006);
  fact_add(A,7006,701,7007);
  fact_add(A,7007,701,7008);
  fact_add(A,7008,701,7009);
  fact_add(A,7009,701,7010);
  map_new(A,0,4,701,0);
  teach(A,0,7001,7002);
  teach(A,0,7002,7003);
  teach(A,0,7003,7004);
  teach(A,0,7004,7005);
  teach(A,0,7005,7006);
  teach(A,0,7006,7007);
  teach(A,0,7007,7008);
  teach(A,0,7008,7009);
  teach(A,0,7009,7010);
  cc_distractors(A);
  return;
}
fn setup_qc2(A:[]u8)void {
  fact_add(A,7101,701,7102);
  fact_add(A,7102,701,7103);
  fact_add(A,7103,701,7104);
  fact_add(A,7104,701,7105);
  fact_add(A,7105,701,7106);
  fact_add(A,7106,701,7107);
  fact_add(A,7107,701,7108);
  fact_add(A,7108,701,7109);
  fact_add(A,7109,701,7110);
  map_new(A,0,4,701,0);
  teach(A,0,7101,7102);
  teach(A,0,7102,7103);
  teach(A,0,7103,7104);
  teach(A,0,7104,7105);
  teach(A,0,7105,7106);
  teach(A,0,7106,7107);
  teach(A,0,7107,7108);
  teach(A,0,7108,7109);
  teach(A,0,7109,7110);
  cc_distractors(A);
  return;
}
fn setup_qc3(A:[]u8)void {
  fact_add(A,7201,701,7202);
  fact_add(A,7202,701,7203);
  fact_add(A,7203,701,7204);
  map_new(A,0,4,701,0);
  teach(A,0,7201,7202);
  teach(A,0,7202,7203);
  teach(A,0,7203,7204);
  cc_distractors(A);
  return;
}

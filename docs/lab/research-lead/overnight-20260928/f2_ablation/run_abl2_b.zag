// autosci2_learner.zag -- F2-retry autonomous scientist: generic learner machinery.
// No main here. Concatenated with world_a2.zag or world_b2.zag (which provide
// the world interface w_* and main). The learner NEVER reads sealed laws;
// it only calls the w_* interface. Verified by source audit.
//
// Prereg: AUTOSCI2 (b9ab0acb6). Changes from F2: World B goal is sustained
// triple (Y=1,K=0) at three consecutive steps, via M + fixed SUFFIX planner.
// World A identical to F2.
//
// Primitives (kind, var): 0=SET v, 1=CLR v, 2=WAIT, 3=OBSERVE v.
// Pure Zag. No Python.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ learner constants ============
// TMAX (history steps) = 32, used as literal in hist indexing.
fn L_NPASS()i32 { return 12; }
fn L_DMAX()i32 { return 4; }
fn L_BUDGET()i32 { return 18; } // K2-R6: raised from F2's 12; B2 goal needs 6 verification obs
fn L_SEARCHD()i32 { return 6; }
fn L_MAXC()i32 { return 36; } // max candidates per var

// ============ generic rule advance ============
// hist: nvars*32 bytes. rules: nr*5 bytes of [c,e,d,cx,cv], cx=255 means ALWAYS.
// Computes hist[*][t] from earlier history. t must be >= 1.
fn L_advance(hist:[]u8, t:i32, rules:[]u8, nr:i32, nvars:i32)void {
  let e:i32=0;
  while(e<nvars){
    let nv:i32=0;
    let r:i32=0;
    while(r<nr){
      let b:i32=r*5;
      if((rules[b+1] as i32)==e){
        let c:i32=rules[b] as i32;
        let d:i32=rules[b+2] as i32;
        let s:i32=t-d;
        if(s>=0 && hist[c*32+s]==1){
          let cx:i32=rules[b+3] as i32;
          if(cx==255){ nv=1; }
          else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
        }
      }
      r=r+1;
    }
    hist[e*32+t]=nv as u8;
    e=e+1;
  }
  return;
}

// ============ candidate generation (generic) ============
// trace: nvars*12 bytes. candbuf: nvars*36*5 bytes. candn: nvars bytes.
fn L_gencands(trace:[]u8, nvars:i32, ctxvar:i32, candbuf:[]u8, candn:[]u8)void {
  // context list: (cx, cv) pairs
  let cxs:[]u8=z_alloc(3);
  let cvs:[]u8=z_alloc(3);
  let ncx:i32=0;
  if(ctxvar<0){ cxs[0]=255; cvs[0]=0; ncx=1; }
  else { cxs[0]=255; cvs[0]=0; cxs[1]=ctxvar as u8; cvs[1]=0; cxs[2]=ctxvar as u8; cvs[2]=1; ncx=3; }
  let e:i32=0;
  while(e<nvars){
    let n:i32=0;
    let c:i32=0;
    while(c<nvars){
      if(c!=e){
        let d:i32=1;
        while(d<=L_DMAX()){
          let x:i32=0;
          while(x<ncx){
            let cx:i32=cxs[x] as i32;
            let cv:i32=cvs[x] as i32;
            let cnt:i32=0;
            let ok:i32=1;
            let t:i32=0;
            while(t<=L_NPASS()-1-d){
              let ctxok:i32=0;
              if(cx==255){ ctxok=1; }
              else if((trace[ctxvar*12+t] as i32)==cv){ ctxok=1; }
              if(trace[c*12+t]==1 && ctxok==1){
                cnt=cnt+1;
                if(trace[e*12+t+d]==0){ ok=0; }
              }
              t=t+1;
            }
            if(ok==1 && cnt>=2 && n<L_MAXC()){
              let b:i32=(e*L_MAXC()+n)*5;
              candbuf[b]=c as u8; candbuf[b+1]=e as u8; candbuf[b+2]=d as u8;
              candbuf[b+3]=cx as u8; candbuf[b+4]=cv as u8;
              n=n+1;
            }
            x=x+1;
          }
          d=d+1;
        }
      }
      c=c+1;
    }
    candn[e]=n as u8;
    e=e+1;
  }
  return;
}

// ============ hypothesis simulation ============
// rules: ne*5 bytes (one rule per endogenous var). sk/sv: kinds/vars, len.
// init: nvars bytes (initial step-0 values). out_obs: >=16 bytes. out_final: nvars.
// hist: nvars*32 scratch. Returns number of observations, or negative on overflow.
fn L_sim(rules:[]u8, ne:i32, nvars:i32, sk:[]u8, sv:[]u8, len:i32,
         init:[]u8, out_obs:[]u8, out_final:[]u8, hist:[]u8)i32 {
  let v:i32=0;
  while(v<nvars*32){ hist[v]=0; v=v+1; }
  v=0;
  while(v<nvars){ hist[v*32]=init[v]; v=v+1; }
  let t:i32=0;
  let nobs:i32=0;
  let i:i32=0;
  while(i<len){
    let kk:i32=sk[i] as i32;
    let vv:i32=sv[i] as i32;
    if(kk==0){ hist[vv*32+t]=1; }
    else if(kk==1){ hist[vv*32+t]=0; }
    else if(kk==2){
      t=t+1;
      if(t>=32){ return -1; }
      L_advance(hist,t,rules,ne,nvars);
    }
    else {
      if(nobs>=16){ return -2; }
      out_obs[nobs]=hist[vv*32+t];
      nobs=nobs+1;
    }
    i=i+1;
  }
  v=0;
  while(v<nvars){ out_final[v]=hist[v*32+t]; v=v+1; }
  return nobs;
}

// ============ emit helpers ============
fn L_emit_prim(kk:i32, vv:i32)void {
  if(kk==0){ emit("S"); }
  else if(kk==1){ emit("C"); }
  else if(kk==2){ emit("W"); }
  else { emit("O"); }
  if(kk!=2){ emit(w_vname(vv)); }
  return;
}
fn L_emit_seq(sk:[]u8, sv:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){ emit(","); }
    L_emit_prim(sk[i] as i32, sv[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
fn L_emit_rule(r:[]u8)void {
  // r: 5 bytes [c,e,d,cx,cv]
  emit(w_vname(r[0] as i32)); emit("->"); emit(w_vname(r[1] as i32));
  emit(" d"); e64(r[2] as i32);
  if((r[3] as i32)!=255){ emit(" ctx "); emit(w_vname(r[3] as i32)); emit("="); e64(r[4] as i32); }
  return;
}

// ============ experiment search ============
// Finds first sequence (depths 1..6, lexicographic, base-B) with >=1 OBSERVE
// where live hypotheses' predicted observation vectors disagree.
// Fills out_sk/out_sv (len returned), out_preds (nhyp*16), out_predn (nhyp).
// Returns seqlen, or 0 if none. Pure simulation: never touches the world.
fn L_find(hyprules:[]u8, alive:[]u8, nhyp:i32, ne:i32, nvars:i32,
          nctrl:i32, ctrl:[]u8,
          out_sk:[]u8, out_sv:[]u8, out_preds:[]u8, out_predn:[]u8)i32 {
  let B:i32=2*nctrl+1+nvars;
  let init:[]u8=z_alloc(nvars);
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let ref:[]u8=z_alloc(16);
  let d:i32=1;
  while(d<=L_SEARCHD()){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*B; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*B; k=k+1; }
      let rem:i32=si;
      let hasobs:i32=0;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/B; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else if(dig==2*nctrl){ kk=2; vv=0; }
        else { kk=3; vv=dig-(2*nctrl+1); hasobs=1; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      if(hasobs==1){
        let refn:i32=-1;
        let disagree:i32=0;
        let bad:i32=0;
        let h:i32=0;
        while(h<nhyp){
          if(alive[h]==1){
            let nn:i32=L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist);
            if(nn<0){ bad=1; }
            else {
              out_predn[h]=nn as u8;
              let j:i32=0;
              while(j<nn){ out_preds[h*16+j]=ob[j]; j=j+1; }
              if(refn<0){ refn=nn; j=0; while(j<nn){ ref[j]=ob[j]; j=j+1; } }
              else if(nn!=refn){ disagree=1; }
              else {
                j=0;
                while(j<nn){ if(ob[j]!=ref[j]){ disagree=1; } j=j+1; }
              }
            }
          }
          h=h+1;
        }
        if(bad==0 && disagree==1){ return d; }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ goal planner ============
// Alphabet: SET/CLR per ctrl + WAIT (no OBSERVE). Simulates under hyp h0.
// Returns plan length, or 0 if none. Pure simulation.
fn L_plan(hyprules:[]u8, h0:i32, ne:i32, nvars:i32, nctrl:i32, ctrl:[]u8,
          init:[]u8, maxd:i32, out_sk:[]u8, out_sv:[]u8)i32 {
  let P:i32=2*nctrl+1;
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else { kk=2; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist);
      if(nn>=0 && w_goal_met(fin)==1){ return d; }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ B2 goal planner (AUTOSCI2) ============
// Searches M over {SET,CLR per ctrl, WAIT} (5 symbols), depths 1..8.
// For each M, simulates M + SUFFIX and checks the triple predicate on the
// simulated observation log: three consecutive steps with (Y=1, K=0).
// SUFFIX = [OBS Y, OBS K, WAIT] x 3 (fixed measurement protocol, preregistered).
// Returns M length, or 0 if none. Pure simulation. The full plan is M + SUFFIX
// (caller appends SUFFIX). out_sk/out_sv receive M (not the suffix).
// yvar, kvar: variable indices for Y and K (from world: 1 and 2 for World B).
fn L_plan_b2(hyprules:[]u8, h0:i32, ne:i32, nvars:i32, nctrl:i32, ctrl:[]u8,
             init:[]u8, maxd:i32, yvar:i32, kvar:i32,
             out_sk:[]u8, out_sv:[]u8)i32 {
  let P:i32=2*nctrl+1;
  // suffix: 9 primitives [OBS Y, OBS K, WAIT] x3
  let suf_sk:[]u8=z_alloc(9);
  let suf_sv:[]u8=z_alloc(9);
  let j:i32=0;
  while(j<3){
    suf_sk[j*3]=3; suf_sv[j*3]=yvar as u8;
    suf_sk[j*3+1]=3; suf_sv[j*3+1]=kvar as u8;
    suf_sk[j*3+2]=2; suf_sv[j*3+2]=0;
    j=j+1;
  }
  let full_sk:[]u8=z_alloc(20);
  let full_sv:[]u8=z_alloc(20);
  let ob:[]u8=z_alloc(32);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
        else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
        else { kk=2; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        full_sk[i]=kk as u8; full_sv[i]=vv as u8;
        i=i+1;
      }
      // append suffix
      j=0;
      while(j<9){ full_sk[d+j]=suf_sk[j]; full_sv[d+j]=suf_sv[j]; j=j+1; }
      let flen:i32=d+9;
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,full_sk,full_sv,flen,init,ob,fin,hist);
      // triple predicate: obs are [Y,K,Y,K,Y,K] at the three suffix positions
      // nn should be 6 (3 OBS Y + 3 OBS K)
      if(nn==6 && ob[0]==1 && ob[1]==0 && ob[2]==1 && ob[3]==0 && ob[4]==1 && ob[5]==0){
        return d;
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// Check triple predicate on a real-execution observation log.
// obs_y[3], obs_k[3]: values read at three consecutive steps.
// Returns 1 if all three are (Y=1, K=0).
fn L_triple_met(oy0:i32, ok0:i32, oy1:i32, ok1:i32, oy2:i32, ok2:i32)i32 {
  if(oy0==1 && ok0==0 && oy1==1 && ok1==0 && oy2==1 && ok2==0){ return 1; }
  return 0;
}

// ============ random experiment finder (ABL2) ============
// ABL2 variant: replaces disagreement targeting with random experiments.
// Only additions vs frozen 1eb66765d: this function, a 4-byte seed buffer in
// L_run, and the call-site switch below. Generates one random sequence per
// round (fixed LCG seed 777, persistent across rounds), simulates
// predictions for alive hypotheses with L_sim for elimination bookkeeping,
// and executes for real regardless of disagreement. Pure simulation:
// never touches the world.
fn L_find_rand(hyprules:[]u8, alive:[]u8, nhyp:i32, ne:i32, nvars:i32,
          nctrl:i32, ctrl:[]u8, seedb:[]u8,
          out_sk:[]u8, out_sv:[]u8, out_preds:[]u8, out_predn:[]u8)i32 {
  let B:i32=2*nctrl+1+nvars;
  let init:[]u8=z_alloc(nvars);
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let seed:i64=get32(seedb,0) as i64;
  seed=(seed*1103515245+12345)%2147483648;
  let d:i32=((seed%6)+1) as i32;
  let i:i32=0;
  let hasobs:i32=0;
  while(i<d){
    seed=(seed*1103515245+12345)%2147483648;
    let dig:i32=(seed%B) as i32;
    let kk:i32=0; let vv:i32=0;
    if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
    else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
    else if(dig==2*nctrl){ kk=2; vv=0; }
    else { kk=3; vv=dig-(2*nctrl+1); hasobs=1; }
    out_sk[i]=kk as u8; out_sv[i]=vv as u8;
    i=i+1;
  }
  if(hasobs==0){
    out_sk[d-1]=3; out_sv[d-1]=0; hasobs=1;
  }
  set32(seedb,0,seed as i32);
  let h:i32=0;
  while(h<nhyp){
    if(alive[h]==1){
      let nn:i32=L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,out_sk,out_sv,d,init,ob,fin,hist);
      if(nn<0){ return 0; }
      out_predn[h]=nn as u8;
      let j:i32=0;
      while(j<nn){ out_preds[h*16+j]=ob[j]; j=j+1; }
    }
    h=h+1;
  }
  emit("RANDSEQ "); L_emit_seq(out_sk,out_sv,d); emit("\n");
  return d;
}

// ============ main learner run ============
// Returns bitmask of learner-verified bars:
// bit0 K2-R1, bit1 K2-R3 (zero world calls during every search),
// bit2 K2-R5a (goal achieved for real), bit3 K2-R5b (random 0/20),
// bit4 K2-R6 (budget), bit5 K2-R4 (convergence).
fn L_run()i32 {
  let mask:i32=0;
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }
  let ctxvar:i32=w_ctxvar();
  emit("WORLD "); emit(w_worldname()); emit(" nvars="); e64(nvars);
  emit(" nctrl="); e64(nctrl); emit(" ctxvar="); e64(ctxvar); emit("\n");

  let ws:[]u8=z_alloc(8+nvars*32);

  // ---- passive phase (free given data) ----
  w_reset(ws);
  let trace:[]u8=z_alloc(nvars*L_NPASS());
  let t:i32=0;
  while(t<L_NPASS()){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    let v:i32=0;
    while(v<nvars){ trace[v*L_NPASS()+t]=snap[v]; v=v+1; }
    if(t<L_NPASS()-1){ w_act(ws,2,0); } // WAIT: advance the world clock
    t=t+1;
  }

  // ---- candidate generation ----
  let candbuf:[]u8=z_alloc(nvars*L_MAXC()*5);
  let candn:[]u8=z_alloc(nvars);
  L_gencands(trace,nvars,ctxvar,candbuf,candn);
  emit("CANDIDATES\n");
  let v:i32=0;
  while(v<nvars){
    emit("  "); emit(w_vname(v)); emit(": ");
    e64(candn[v] as i32); emit(" [");
    let j:i32=0;
    while(j<(candn[v] as i32)){
      if(j>0){ emit("; "); }
      let rb:[]u8=z_alloc(5);
      let k:i32=0;
      while(k<5){ rb[k]=candbuf[(v*L_MAXC()+j)*5+k]; k=k+1; }
      L_emit_rule(rb);
      j=j+1;
    }
    emit("]\n");
    v=v+1;
  }

  // ---- hypothesis enumeration ----
  let evars:[]u8=z_alloc(nvars);
  let ne:i32=0;
  v=0;
  while(v<nvars){
    if((candn[v] as i32)>0){ evars[ne]=v as u8; ne=ne+1; }
    v=v+1;
  }
  let nhyp:i32=1;
  let j:i32=0;
  while(j<ne){ nhyp=nhyp*(candn[evars[j] as i32] as i32); j=j+1; }
  emit("NHYP "); e64(nhyp); emit(" ne="); e64(ne); emit("\n");
  let hysel:[]u8=z_alloc(nhyp*ne);
  // mixed-radix counting
  let h:i32=0;
  while(h<nhyp){
    let rem:i32=h;
    j=0;
    while(j<ne){
      let base:i32=candn[evars[j] as i32] as i32;
      hysel[h*ne+j]=(rem%base) as u8;
      rem=rem/base;
      j=j+1;
    }
    h=h+1;
  }
  // per-hypothesis rule arrays
  let hyprules:[]u8=z_alloc(nhyp*ne*5);
  h=0;
  while(h<nhyp){
    j=0;
    while(j<ne){
      let vv:i32=evars[j] as i32;
      let ci:i32=hysel[h*ne+j] as i32;
      let k:i32=0;
      while(k<5){ hyprules[(h*ne+j)*5+k]=candbuf[(vv*L_MAXC()+ci)*5+k]; k=k+1; }
      j=j+1;
    }
    h=h+1;
  }
  let alive:[]u8=z_alloc(nhyp);
  h=0; while(h<nhyp){ alive[h]=1; h=h+1; }
  let nalive:i32=nhyp;

  if(nhyp>=2){ mask=mask|1; emit("K2-R1 PASS nhyp>=2\n"); }
  else { emit("K-AS1 FAIL nhyp<2\n"); }

  // ---- experiment loop ----
  let fsk:[]u8=z_alloc(8);
  let fsv:[]u8=z_alloc(8);
  let preds:[]u8=z_alloc(nhyp*16);
  let predn:[]u8=z_alloc(nhyp);
  let obs_used:i32=0;
  let search_ok:i32=1;
  let exhausted:i32=0;
  let round:i32=0;
  // ABL2: persistent LCG seed buffer for the random experiment finder.
  let seedb:[]u8=z_alloc(4);
  set32(seedb,0,777);
  while(1==1){
    round=round+1;
    if(round>40){ emit("ROUND_CAP\n"); break; }
    let c0:i32=w_ncalls(ws);
    // ABL2: random experiments instead of disagreement targeting.
    let flen:i32=L_find_rand(hyprules,alive,nhyp,ne,nvars,nctrl,ctrl,seedb,fsk,fsv,preds,predn);
    let c1:i32=w_ncalls(ws);
    emit("SEARCH round="); e64(round); emit(" world_calls="); e64(c1-c0); emit("\n");
    if(c1!=c0){ search_ok=0; }
    if(flen==0){ exhausted=1; emit("EXHAUSTION no disagreeing sequence to depth 6\n"); break; }
    // count observes in the found sequence
    let nobs:i32=0;
    i=0; while(i<flen){ if((fsk[i] as i32)==3){ nobs=nobs+1; } i=i+1; }
    if(obs_used+nobs>L_BUDGET()){ emit("BUDGET_OUT\n"); break; }
    emit("SELECT "); L_emit_seq(fsk,fsv,flen); emit("\n");
    h=0;
    while(h<nhyp){
      if(alive[h]==1){
        emit("  hyp"); e64(h); emit(" predicts [");
        let q:i32=0;
        while(q<(predn[h] as i32)){ if(q>0){emit(",");} e64(preds[h*16+q] as i32); q=q+1; }
        emit("]\n");
      }
      h=h+1;
    }
    // execute for real
    w_reset(ws);
    let act:[]u8=z_alloc(16);
    let an:i32=0;
    i=0;
    while(i<flen){
      let o:i32=w_act(ws,fsk[i] as i32,fsv[i] as i32);
      if((fsk[i] as i32)==3){ act[an]=o as u8; an=an+1; }
      i=i+1;
    }
    obs_used=obs_used+nobs;
    emit("EXEC actual [");
    i=0; while(i<an){ if(i>0){emit(",");} e64(act[i] as i32); i=i+1; }
    emit("]\n");
    // eliminate
    let killed:[]u8=z_alloc(nhyp);
    h=0;
    while(h<nhyp){
      if(alive[h]==1){
        let same:i32=1;
        if((predn[h] as i32)!=an){ same=0; }
        else {
          let q:i32=0;
          while(q<an){ if(preds[h*16+q]!=act[q]){ same=0; } q=q+1; }
        }
        if(same==0){ alive[h]=0; killed[h]=1; nalive=nalive-1; }
      }
      h=h+1;
    }
    emit("KILLED [");
    let first:i32=1;
    h=0;
    while(h<nhyp){ if(killed[h]==1){ if(first==0){emit(",");} e64(h); first=0; } h=h+1; }
    emit("] nalive="); e64(nalive); emit("\n");
    if(nalive==0){ emit("TRUTH_LOST FAIL\n"); break; }
    if(nalive==1){ break; }
  }
  emit("SURVIVORS [");
  let first2:i32=1;
  h=0;
  while(h<nhyp){ if(alive[h]==1){ if(first2==0){emit(",");} e64(h); first2=0; } h=h+1; }
  emit("] exhausted="); e64(exhausted); emit("\n");

  if(search_ok==1){ mask=mask|2; emit("K2-R3 PASS zero world calls in search\n"); }
  else { emit("K2-R3 FAIL world calls during search\n"); }

  // ---- world-side convergence adjudication ----
  let conv:i32=w_verify(alive,hysel,evars,ne,nhyp,candbuf,exhausted,nalive);

  // ---- goal phase ----
  // find first alive hyp
  let h0:i32=0;
  while(h0<nhyp){ if(alive[h0]==1){ break; } h0=h0+1; }
  // initial state after reset+setup (observed; free setup reads)
  w_reset(ws);
  w_goal_setup(ws);
  let init:[]u8=z_alloc(nvars);
  w_snapshot(ws,init);
  let gmode:i32=w_goal_mode();
  if(gmode==0){
    // ===== World A: F2-style final-state goal (UNCHANGED) =====
    let psk:[]u8=z_alloc(10);
    let psv:[]u8=z_alloc(10);
    let plen:i32=L_plan(hyprules,h0,ne,nvars,nctrl,ctrl,init,w_plan_maxd(),psk,psv);
    if(plen==0){ emit("PLAN none found FAIL\n"); }
    else {
      emit("PLAN "); L_emit_seq(psk,psv,plen); emit("\n");
      // agreement across all survivors
      let ob:[]u8=z_alloc(16);
      let fin0:[]u8=z_alloc(nvars);
      let hist:[]u8=z_alloc(nvars*32);
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,psk,psv,plen,init,ob,fin0,hist);
      let agree:i32=1;
      h=0;
      while(h<nhyp){
        if(alive[h]==1 && h!=h0){
          let finh:[]u8=z_alloc(nvars);
          L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,psk,psv,plen,init,ob,finh,hist);
          v=0;
          while(v<nvars){ if(finh[v]!=fin0[v]){ agree=0; } v=v+1; }
        }
        h=h+1;
      }
      emit("PLAN_AGREEMENT "); e64(agree); emit("\n");
      // execute for real
      w_reset(ws);
      w_goal_setup(ws);
      i=0;
      while(i<plen){ w_act(ws,psk[i] as i32,psv[i] as i32); i=i+1; }
      let gvals:[]u8=z_alloc(nvars);
      let nobs2:i32=0;
      v=0;
      while(v<nvars){
        let o:i32=w_act(ws,3,v);
        gvals[v]=o as u8;
        nobs2=nobs2+1;
        v=v+1;
      }
      obs_used=obs_used+nobs2;
      let met:i32=w_goal_met(gvals);
      emit("GOAL_REAL "); e64(met); emit("\n");
      if(met==1){ mask=mask|4; }
      // random-action control (fixed-seed LCG; harness-side, free snapshot reads)
      let seed:i64=12345;
      let P:i32=2*nctrl+1;
      let rlen:i32=plen+2;
      let rsucc:i32=0;
      let r:i32=0;
      while(r<20){
        let rs:[]u8=z_alloc(10);
        let rv:[]u8=z_alloc(10);
        i=0;
        while(i<rlen){
          seed=(seed*1103515245+12345)%2147483648;
          let dig:i32=(seed%P) as i32;
          let kk:i32=0; let vv:i32=0;
          if(dig<nctrl){ kk=0; vv=ctrl[dig] as i32; }
          else if(dig<2*nctrl){ kk=1; vv=ctrl[dig-nctrl] as i32; }
          else { kk=2; vv=0; }
          rs[i]=kk as u8; rv[i]=vv as u8;
          i=i+1;
        }
        w_reset(ws);
        w_goal_setup(ws);
        i=0;
        while(i<rlen){ w_act(ws,rs[i] as i32,rv[i] as i32); i=i+1; }
        let gs:[]u8=z_alloc(nvars);
        w_snapshot(ws,gs);
        if(w_goal_met(gs)==1){ rsucc=rsucc+1; }
        r=r+1;
      }
      emit("RANDOM_BASELINE "); e64(rsucc); emit("/20\n");
      if(rsucc==0){ mask=mask|8; }
    }
  } else {
    // ===== World B: B2 sustained triple goal (CHANGED from F2) =====
    // yvar=1 (Y), kvar=2 (K) for World B
    let yv:i32=1;
    let kv:i32=2;
    let msk:[]u8=z_alloc(10);
    let msv:[]u8=z_alloc(10);
    let mlen:i32=L_plan_b2(hyprules,h0,ne,nvars,nctrl,ctrl,init,8,yv,kv,msk,msv);
    if(mlen==0){ emit("PLAN_B2 none found FAIL\n"); }
    else {
      // full plan = M + SUFFIX
      let fsk:[]u8=z_alloc(20);
      let fsv:[]u8=z_alloc(20);
      i=0;
      while(i<mlen){ fsk[i]=msk[i]; fsv[i]=msv[i]; i=i+1; }
      let jj:i32=0;
      while(jj<3){
        fsk[mlen+jj*3]=3; fsv[mlen+jj*3]=yv as u8;
        fsk[mlen+jj*3+1]=3; fsv[mlen+jj*3+1]=kv as u8;
        fsk[mlen+jj*3+2]=2; fsv[mlen+jj*3+2]=0;
        jj=jj+1;
      }
      let flen:i32=mlen+9;
      emit("PLAN_B2 M="); L_emit_seq(msk,msv,mlen); emit(" full_len="); e64(flen); emit("\n");
      // agreement across all survivors (triple predicate on simulated obs)
      let ob:[]u8=z_alloc(32);
      let fin0:[]u8=z_alloc(nvars);
      let hist:[]u8=z_alloc(nvars*32);
      let nn:i32=L_sim(hyprules[h0*ne*5..h0*ne*5+ne*5],ne,nvars,fsk,fsv,flen,init,ob,fin0,hist);
      let agree:i32=1;
      if(!(nn==6 && ob[0]==1 && ob[1]==0 && ob[2]==1 && ob[3]==0 && ob[4]==1 && ob[5]==0)){ agree=0; }
      h=0;
      while(h<nhyp){
        if(alive[h]==1 && h!=h0){
          let obh:[]u8=z_alloc(32);
          let finh:[]u8=z_alloc(nvars);
          L_sim(hyprules[h*ne*5..h*ne*5+ne*5],ne,nvars,fsk,fsv,flen,init,obh,finh,hist);
          if(!(obh[0]==1 && obh[1]==0 && obh[2]==1 && obh[3]==0 && obh[4]==1 && obh[5]==0)){ agree=0; }
        }
        h=h+1;
      }
      emit("PLAN_AGREEMENT "); e64(agree); emit("\n");
      // execute for real: RESET, setup, M+SUFFIX, log 6 observations
      w_reset(ws);
      w_goal_setup(ws);
      let oy:[]u8=z_alloc(3);
      let ok:[]u8=z_alloc(3);
      let oi:i32=0;
      i=0;
      while(i<flen){
        let kk:i32=fsk[i] as i32;
        let vv:i32=fsv[i] as i32;
        if(kk==3){
          let o:i32=w_act(ws,kk,vv);
          // SUFFIX order is [OBS Y, OBS K, WAIT] x3; pair Y then K per step
          if(oi<3){
            if(vv==yv){ oy[oi]=o as u8; }
            else if(vv==kv){ ok[oi]=o as u8; oi=oi+1; }
          }
        } else {
          w_act(ws,kk,vv);
        }
        i=i+1;
      }
      obs_used=obs_used+6;
      let met:i32=L_triple_met(oy[0] as i32, ok[0] as i32, oy[1] as i32, ok[1] as i32, oy[2] as i32, ok[2] as i32);
      emit("GOAL_REAL_B2 "); e64(met); emit(" obs=[");
      e64(oy[0] as i32); emit(","); e64(ok[0] as i32); emit(",");
      e64(oy[1] as i32); emit(","); e64(ok[1] as i32); emit(",");
      e64(oy[2] as i32); emit(","); e64(ok[2] as i32); emit("]\n");
      if(met==1){ mask=mask|4; }
      // random-action control: 7-symbol alphabet (incl OBS Y, OBS K), fixed seed
      let seed:i64=12345;
      let P7:i32=7;
      let rlen:i32=flen+2;
      let rsucc:i32=0;
      let r:i32=0;
      while(r<20){
        let rs:[]u8=z_alloc(24);
        let rv:[]u8=z_alloc(24);
        i=0;
        while(i<rlen){
          seed=(seed*1103515245+12345)%2147483648;
          let dig:i32=((seed>>8)%P7) as i32;
          if(dig<0){ dig=dig+P7; }
          let kk:i32=0; let vv:i32=0;
          if(dig==0){ kk=0; vv=ctrl[0] as i32; }
          else if(dig==1){ kk=1; vv=ctrl[0] as i32; }
          else if(dig==2){ kk=0; vv=ctrl[1] as i32; }
          else if(dig==3){ kk=1; vv=ctrl[1] as i32; }
          else if(dig==4){ kk=2; vv=0; }
          else if(dig==5){ kk=3; vv=yv; }
          else { kk=3; vv=kv; }
          rs[i]=kk as u8; rv[i]=vv as u8;
          i=i+1;
        }
        // execute, tracking (step, Y=1 observed, K=0 observed)
        w_reset(ws);
        w_goal_setup(ws);
        let sy:[]u8=z_alloc(40);
        let sk0:[]u8=z_alloc(40);
        let tt:i32=0;
        i=0;
        while(i<rlen){
          let kk:i32=rs[i] as i32;
          let vv:i32=rv[i] as i32;
          if(kk==2){ tt=tt+1; w_act(ws,kk,vv); }
          else if(kk==3){
            let o:i32=w_act(ws,kk,vv);
            if(tt<40){
              if(vv==yv && o==1){ sy[tt]=1; }
              if(vv==kv && o==0){ sk0[tt]=1; }
            }
          } else {
            w_act(ws,kk,vv);
          }
          i=i+1;
        }
        // check exists s with triple
        let s:i32=0;
        let found:i32=0;
        while(s<37){
          if(sy[s]==1 && sk0[s]==1 && sy[s+1]==1 && sk0[s+1]==1 && sy[s+2]==1 && sk0[s+2]==1){ found=1; }
          s=s+1;
        }
        if(found==1){ rsucc=rsucc+1; }
        r=r+1;
      }
      emit("RANDOM_BASELINE_B2 "); e64(rsucc); emit("/20\n");
      if(rsucc==0){ mask=mask|8; }
    }
  }

  emit("OBS_USED "); e64(obs_used); emit("\n");
  if(obs_used<=L_BUDGET()){ mask=mask|16; emit("K2-R6 PASS budget\n"); }
  else { emit("K2-R6 FAIL budget\n"); }

  // K2-R4 line printed by w_verify; combine here
  if(conv==1){ mask=mask|32; }
  emit("MASK "); e64(mask); emit("\n");
  return mask;
}
// world_b2.zag -- Sealed World B: contextual delay (AUTOSCI2 retry).
// Concatenate AFTER autosci2_learner.zag.
// TRUE LAW (sealed from learner): (X->Y, delay 2, context K==0). Under K==1 X does nothing.
// The learner only sees the w_* interface. w_verify is harness adjudication.
// Goal mode 1 = B2 sustained triple goal (prereg AUTOSCI2).

fn w_goal_mode()i32 { return 1; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 2; } // X, K
fn w_ctxvar()i32 { return 2; } // K
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y"; }
  return "K";
}
fn w_worldname()[]u8 { return "B-contextual-delay"; }
fn w_plan_maxd()i32 { return 6; }

fn B_truerules()[]u8 {
  let r:[]u8=z_alloc(5);
  r[0]=0; r[1]=1; r[2]=2; r[3]=2; r[4]=0; // X -> Y delay 2 iff K==0
  return r;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+3*32];
    L_advance(hist,t,B_truerules(),1,3);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: environment SETs X at t=2 and t=8. K=0 throughout.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: establish K=1 start state.
fn w_goal_setup(ws:[]u8)void {
  ws[8+2*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[1]==1){ return 1; }
  return 0;
}

// Harness adjudication for K2-R4. Knows the sealed truth; the learner does not.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // true candidate: Y:(X,2,ctx K=0)
  let ty:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==2 &&
       (candbuf[b+3] as i32)==2 && (candbuf[b+4] as i32)==0){ ty=j; }
    j=j+1;
  }
  let true_h:i32=-1;
  let h:i32=0;
  while(h<nhyp){
    if((hysel[h*1+0] as i32)==ty){ true_h=h; }
    h=h+1;
  }
  emit("K2-R4 true_h="); e64(true_h);
  emit(" alive="); e64(alive[true_h]); emit(" nalive="); e64(nalive);
  emit(" exhausted="); e64(exhausted); emit("\n");
  // Expect: exactly one survivor, equal to the true law.
  if(true_h>=0 && alive[true_h]==1 && nalive==1){
    emit("K2-R4 PASS\n");
    return 1;
  }
  emit("K2-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  if(m==63){ emit("AUTOSCI_B PROGRAM_ALL_BARS_PASS\n"); return 0; }
  emit("AUTOSCI_B PROGRAM_FAIL mask="); e64(m); emit("\n");
  return 1;
}

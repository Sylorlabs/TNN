// world_adv1.zag -- Sealed Adversary World 1: conjunctive truth.
// Concatenate AFTER the FROZEN autosci2_learner.zag (1eb66765d, unmodified).
// SEALED TRUTH (designed in prereg a3fc27c4c, before implementation):
//   Y(t) = X(t-2) AND Z(t-1). A conjunction; not expressible as one
//   (c,e,d,cx,cv) single-cause rule, so the truth is outside F2's
//   hypothesis family.
// Vars: X(0,ctrl), Z(1,ctrl), Y(2), W(3,dummy). Pulsed (SET writes current
// step only; no persistence).
// Passive: env SETs X at t=2,8; env SETs Z at t=3,9. Then Y=1 at t=4,10.
// Goal mode 0: final-state Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 4; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  if(v==2){ return "Y"; }
  return "W";
}
fn w_worldname()[]u8 { return "ADV1-conjunctive"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (4*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+4*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Sealed truth: Y(t) = X(t-2) AND Z(t-1). Out-of-range reads are 0.
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-1>=0){ zv=ws[8+1*32+(t-1)] as i32; }
    if(xv==1 && zv==1){ ws[8+2*32+t]=1; }
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<4){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: env SETs X at t=2,8 and Z at t=3,9. Uses world's clock.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  if(t==3 || t==9){ ws[8+1*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness note: truth is outside the learner's family, so K2-R4 semantics
// do not apply. Report sealed design and convergence state for the log.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  emit("ADV1 sealed truth: Y=X(t-2)&Z(t-1). nhyp="); e64(nhyp);
  emit(" nalive="); e64(nalive); emit(" exhausted="); e64(exhausted); emit("\n");
  emit("ADV1_FOOLED_CHECK see GOAL_REAL and SURVIVORS\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("ADV1 DONE mask="); e64(m); emit("\n");
  return 0;
}

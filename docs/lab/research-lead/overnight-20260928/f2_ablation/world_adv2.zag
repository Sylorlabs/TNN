// world_adv2.zag -- Sealed Adversary World 2: silent cause.
// Concatenate AFTER the FROZEN autosci2_learner.zag (1eb66765d, unmodified).
// SEALED TRUTH (designed in prereg a3fc27c4c, before implementation):
//   Y(t) = X(t-2) AND Z(t-1), same conjunction as ADV1.
//   BUT: Z is NEVER set during the passive phase, so no candidate rule for Y
//   is ever generated. The learner cannot discover a cause that passive data
//   never implicates, even though Z is manipulable and the goal IS achievable
//   via the real plan [SX,W,SZ,W] (Y(2)=X(0)&Z(1)=1).
// Vars: X(0,ctrl), Z(1,ctrl), Y(2). Pulsed.
// Passive: env SETs X at t=2,8. Z stays 0. Y stays 0.
// Goal mode 0: final-state Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "ADV2-silent-cause"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Sealed truth: Y(t) = X(t-2) AND Z(t-1).
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-1>=0){ zv=ws[8+1*32+(t-1)] as i32; }
    if(xv==1 && zv==1){ ws[8+2*32+t]=1; }
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: env SETs X at t=2,8. Z never set. Y stays 0.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void { return; } // start from all-zero
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  emit("ADV2 sealed truth: Y=X(t-2)&Z(t-1), Z never varies in passive.");
  emit(" nhyp="); e64(nhyp);
  emit(" nalive="); e64(nalive); emit(" exhausted="); e64(exhausted); emit("\n");
  emit("ADV2_MISSED_CHECK see PLAN line\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("ADV2 DONE mask="); e64(m); emit("\n");
  return 0;
}

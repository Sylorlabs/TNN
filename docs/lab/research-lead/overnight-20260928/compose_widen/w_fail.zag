// w_fail.zag -- arm F: failure-triggered widening (the frozen U rule).
// One admission rule (S2-pinned, from w_base), one execution rule, one
// widening rule always on: on exhaustive admitted failure, retry ALL
// filter-rejected ordered pairs once (WIDEN=1, WTRIG=1). Triggered solely by
// learner-observed exhaustive failure. No coverage ledger, no miss recording.
fn f_try_single(A:[]u8,B:[]u8,c:i32,a:i32,s:i32,exp:i32)i32 {
  ap(A,1056,ag(A,1056)|(1<<a));
  ap(A,936,ag(A,936)+1);
  let v:i32=exec_map(A,a,s);
  if(v==exp){
    observe(A,a,s,v);
    ap(A,944,v); ap(A,940,1); ap(A,1064,-1);
  }
  return c;
}
fn f_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,s:i32,exp:i32)i32 {
  ap(A,1060,ag(A,1060)|(1<<(x*4+y)));
  ap(A,936,ag(A,936)+1);
  let v1:i32=exec_map(A,x,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  if(v1>=0){
    let v2:i32=exec_map(A,y,v1);
    if(v2==exp){
      observe(A,x,s,v1); observe(A,y,v1,v2);
      ap(A,944,v2); ap(A,940,1); ap(A,1064,v1);
    }
  }
  return c;
}
fn f_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32,prob:[]u8)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  ap(A,1056,0); ap(A,1060,0); ap(A,1064,-1); ap(A,1068,0); ap(A,1072,0);
  lg_clear(A,nm);
  let a:i32=0;
  while(a<nm){
    if(admit_single(A,a,kin,kout)==1){
      c=f_try_single(A,B,c,a,s,exp);
      if(ag(A,940)==1){ c=report(A,B,c,"F",prob,nm); return c; }
    }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==1){
        c=f_try_pair(A,B,c,x,y,s,exp);
        if(ag(A,940)==1){ c=report(A,B,c,"F",prob,nm); return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  if(ag(A,940)==0){
    c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=1"); c=o_nl(B,c);
    ap(A,1068,1); ap(A,1072,1);
    let x2:i32=0;
    while(x2<nm){
      let y2:i32=0;
      while(y2<nm){
        if(x2!=y2 && admit_pair(A,x2,y2,kin,kout)==0 && tried_pair(A,x2,y2)==0){
          c=f_try_pair(A,B,c,x2,y2,s,exp);
          if(ag(A,940)==1){ c=report(A,B,c,"F",prob,nm); return c; }
        }
        y2=y2+1;
      }
      x2=x2+1;
    }
  }
  c=report(A,B,c,"F",prob,nm);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A0:[]u8=world_new();
  setup_d0(A0);
  c=f_solve(A0,B,c,31,1,2,2,4,"D0");
  let A1:[]u8=world_new();
  setup_d1(A1);
  c=f_solve(A1,B,c,41,1,2,2,4,"D1");
  let A2:[]u8=world_new();
  setup_d2(A2);
  c=f_solve(A2,B,c,41,1,2,2,3,"D2");
  let A3:[]u8=world_new();
  setup_d3(A3);
  c=f_solve(A3,B,c,41,1,1,44,3,"D3");
  o_flush(B,c);
  return 0;
}

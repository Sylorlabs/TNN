// Appended to allocation/output helper prefix only.
fn operation(op:i32,x:i32)i32 {if(op==0){return x+1;}if(op==1){return x+2;}return x*2;}
fn permop(p:i32,t:i32)i32 {
  if(p==0){return t;}
  if(p==1){if(t==0){return 0;}return 3-t;}
  if(p==2){if(t==0){return 1;}if(t==1){return 0;}return 2;}
  if(p==3){return (t+1)%3;}
  if(p==4){return (t+2)%3;}
  return 2-t;
}
fn learn(obs:[]u8,map:[]u8)void {
  let t:i32=0;
  while(t<3){
    wset(map,t,-1);let op:i32=0;
    while(op<3){
      if(operation(op,0)==wget(obs,t*2) && operation(op,1)==wget(obs,t*2+1)){wset(map,t,op);}
      op=op+1;
    }
    t=t+1;
  }
  return;
}
fn listen(map:[]u8,a:i32,b:i32,x:i32,reverse:i32)i32 {
  let oa:i32=wget(map,a);let ob:i32=wget(map,b);
  if(oa<0 || ob<0){return -99999;}
  if(reverse==1){return operation(oa,operation(ob,x));}
  return operation(ob,operation(oa,x));
}
// Independent world effect arithmetic, not listener operation calls.
fn worldstep(p:i32,t:i32,x:i32)i32 {
  let op:i32=permop(p,t);if(op==2){return 2*x;}return x+op+1;
}
fn expected(p:i32,a:i32,b:i32,x:i32,reverse:i32)i32 {
  if(reverse==1){return worldstep(p,a,worldstep(p,b,x));}
  return worldstep(p,b,worldstep(p,a,x));
}
fn phrase_lookup(cache:[]u8,a:i32,b:i32,x:i32)i32 {
  let i:i32=0;while(i<6){let base:i32=i*5;
    if(wget(cache,base)==2 && wget(cache,base+1)==a && wget(cache,base+2)==b && wget(cache,base+3)==x){return wget(cache,base+4);}
    i=i+1;
  }return -99999;
}
fn met(O:[]u8,c:i32,name:[]u8,v:i32)i32 {let q:i32=o_app(O,c,name);return o_i64(O,q,v as i64);}
fn main()i32 {
  let O:[]u8=z_alloc(65536);let c:i32=0;let unexpected:i32=0;
  let total:i32=0;let flatcorrect:i32=0;let wrongcorrect:i32=0;let revcorrect:i32=0;let alternate:i32=0;
  let cachecorrect:i32=0;let erasedcorrect:i32=0;let p:i32=0;
  while(p<6){
    let obs:[]u8=z_alloc(24);let map:[]u8=z_alloc(12);let t:i32=0;
    while(t<3){wset(obs,t*2,worldstep(p,t,0));wset(obs,t*2+1,worldstep(p,t,1));t=t+1;}
    let cache:[]u8=z_alloc(120);t=0;
    while(t<3){let x:i32=0;while(x<2){let base:i32=(t*2+x)*5;wset(cache,base,1);wset(cache,base+1,t);wset(cache,base+2,-1);wset(cache,base+3,x);wset(cache,base+4,wget(obs,t*2+x));x=x+1;}t=t+1;}
    learn(obs,map);let flat:[]u8=z_alloc(12);let wrong:[]u8=z_alloc(12);let erased:[]u8=z_alloc(12);
    t=0;while(t<3){wset(flat,t,wget(map,t));wset(wrong,t,wget(map,(t+1)%3));wset(erased,t,-1);t=t+1;}
    let correct:i32=0;let fc:i32=0;let wc:i32=0;let rc:i32=0;let ac:i32=0;let a:i32=0;
    while(a<3){let b:i32=0;
      while(b<3){let x:i32=3;
        while(x<=5){
          let truth:i32=expected(p,a,b,x,0);let result:i32=listen(map,a,b,x,0);
          if(result==truth){correct=correct+1;}
          if(listen(flat,a,b,x,0)==truth){fc=fc+1;}
          if(listen(wrong,a,b,x,0)==truth){wc=wc+1;}
          if(listen(map,a,b,x,1)==truth){rc=rc+1;}
          if(result==expected(p,a,b,x,1)){ac=ac+1;}
          if(listen(erased,a,b,x,0)==truth){erasedcorrect=erasedcorrect+1;}
          // Phrase cache stores only single-token messages; a two-token lookup abstains.
          let cached:i32=phrase_lookup(cache,a,b,x);if(cached==truth){cachecorrect=cachecorrect+1;}
          x=x+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    c=met(O,c,"protocol permutation=",p);c=met(O,c," correct=",correct);c=met(O,c," flat=",fc);
    c=met(O,c," wrong_map=",wc);c=met(O,c," reversed=",rc);c=met(O,c," alternative_convention=",ac);c=o_nl(O,c);
    if(correct!=27 || fc!=27 || wc>=27 || rc!=15 || ac!=15){unexpected=unexpected+1;}
    total=total+correct;flatcorrect=flatcorrect+fc;wrongcorrect=wrongcorrect+wc;revcorrect=revcorrect+rc;alternate=alternate+ac;
    p=p+1;
  }
  c=met(O,c,"protocol_summary total=",total);c=met(O,c," flat=",flatcorrect);c=met(O,c," wrong_map=",wrongcorrect);
  c=met(O,c," reversed=",revcorrect);c=met(O,c," alternative_convention=",alternate);c=met(O,c," cache=",cachecorrect);
  c=met(O,c," erased=",erasedcorrect);c=o_nl(O,c);
  if(total!=162 || flatcorrect!=162 || wrongcorrect>=162 || revcorrect!=90 || alternate!=90 || cachecorrect!=0 || erasedcorrect!=0){unexpected=unexpected+1;}
  c=met(O,c,"instrumentation_unexpected=",unexpected);c=o_nl(O,c);_zag_print(O[0..c]);if(unexpected!=0){return 1;}return 0;
}

// PHASE 6 STRUCTURAL PRECONDITION -- pure Zag.
//
// Per FRONTIER_QUEUE `substrate-spec`: prove the task is SOLVABLE BY SOME PRODUCTION
// SET before implementing any induction. This runs BEFORE any result is read.
//
// QUESTION: can a SINGLE production table support both
//   forward  (generate a terminal string from a non-terminal) and
//   backward (decide whether a terminal string is derivable)?
// Phase 6's core finding is that a STATISTICAL model cannot do both, so the
// representation class must be structural. This tests that a structural one CAN.
//
// HONESTY NOTE -- this prover reported PASS, then FAILED six times, every time on a
// bug in the PROVER or in how it was run, never on the grammar under test:
//   1. `on` passed BY VALUE into expand() -> the parent's output length was lost, so
//      every recursive branch appeared to fail.
//   2. rules written into arbitrary slots while the rule lookup indexed by LHS ->
//      A0's second rule belonged to a different non-terminal.
//   3. cyclic rules with no output bound -> wrote past out[] and printed heap garbage
//      as though it were derived symbols.
//   4. RHS stored at a BYTE offset (+4) inside an INT-indexed 4-int block -> rhs1 read
//      back as A0, so A0 recursed into itself to the depth cap and reported FAILED.
//   5. the zero-init loop cleared only every 4th int, leaving rhs/arity slots holding
//      raw malloc garbage.
//   6. an apostrophe inside a string literal ("prover's") terminated the parse, and
//      then one line was missing a closing paren. E0001 "unexpected end of input".
// Plus one PROCESS failure worth as much as the six: after a FAILED compile I ran the
// binary anyway and read its output as a result. The build was stale, so for a while
// I was reasoning about a program that did not exist. Every run since is gated on the
// compile succeeding, and `rm -f` precedes it.
//
// A harness with six bugs cannot license a "the substrate is dead" conclusion, which is
// why the verdict text below says to fix the prover rather than conclude anything. That
// is the single most important thing in this file.
//
// Two process lessons, recorded because they cost the most time:
//   - My paren-balance checker flagged the missing paren on the offending line, and I
//     dismissed it twice as an "awk stripping artifact" because the line's string
//     contained digits like 3,2,4 that I assumed were confusing it. Instrumentation
//     that disagrees with you should be believed until you have explained it away, not
//     explained away until it agrees.
//   - Bisecting a parse error by appending a FIXED number of closing braces gives
//     nonsense results; the append has to match the brace depth of the truncated
//     prefix, or the harness "passes" only by accident at exactly one depth.
//
// DESIGN RULE ADOPTED AFTER THOSE FAILURES: no block strides, no mixed byte/int
// offsets. Every logical int lives in its own flat array, indexed by a single integer
// q = l*NRULE() + r, and ALL reads/writes go through wset()/wget() so a write and its
// read can never disagree about units again.
//
// GRAMMAR (non-terminals 0,1,2; terminals 3..6):
//     A0 -> A1 4
//     A1 -> 3 3
//     A2 -> A0 5
// RECURSION IS NECESSARY, not decorative: A0 and A2 have no terminal-only
// alternative, so the only way to expand either of them is through a non-terminal.
// The base case sits at A1. A depth cap is still required because A2 -> A0 and A0 -> A1
// sit inside the cycle.
//
// HAND-DERIVED EXPECTATIONS -- the machine must reproduce exactly these, so the check
// is against arithmetic a reader can do, not against the prover's own output:
//   forward A0 -> 3 3 4        (len 3)
//   forward A1 -> 3 3          (len 2)
//   forward A2 -> 3 3 4 5      (len 4)
//   backward: exactly 3 of 340 strings derivable, namely 33 / 334 / 3345
// Check: A0 -> A1 4 with A1 -> 3 3 gives 3 3 4. A2 -> A0 5 with that A0 gives
// 3 3 4 5. Nothing else is derivable, because A1 emits only "3 3" and every rule has a
// fixed literal tail, so no other terminal sequence can be produced.
//
// usage: precond.zag

// ---- runtime ------------------------------------------------------------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
// THE ONLY two accessors used for logical int arrays. Unit symmetry is the whole point.
fn wset(a:[]u8,i:i32,v:i32)void { set32(a,i*4,v); }
fn wget(a:[]u8,i:i32)i32 { return get32(a,i*4); }
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

// Appended to allocation/output helper prefix only.
fn operation(op:i32,x:i32)i32 {if(op==0){return x+1;}if(op==1){return x+2;}return x*2;}
fn permop(p:i32,t:i32)i32 {
  if(p==0){return t;}
  if(p==1){if(t==0){return 0;}return 3-t;}
  if(p==2){if(t==0){return 1;}if(t==1){return 0;}return 2;}
  if(p==3){return (t+1)%3;}
  if(p==4){return (t+2)%3;}
  return 2-t;
}
fn learn(obs:[]u8,map:[]u8)void {
  let t:i32=0;
  while(t<3){
    wset(map,t,-1);let op:i32=0;
    while(op<3){
      if(operation(op,0)==wget(obs,t*2) && operation(op,1)==wget(obs,t*2+1)){wset(map,t,op);}
      op=op+1;
    }
    t=t+1;
  }
  return;
}
fn listen(map:[]u8,a:i32,b:i32,x:i32,reverse:i32)i32 {
  let oa:i32=wget(map,a);let ob:i32=wget(map,b);
  if(oa<0 || ob<0){return -99999;}
  if(reverse==1){return operation(oa,operation(ob,x));}
  return operation(ob,operation(oa,x));
}
// Independent world effect arithmetic, not listener operation calls.
fn worldstep(p:i32,t:i32,x:i32)i32 {
  let op:i32=permop(p,t);if(op==2){return 2*x;}return x+op+1;
}
fn expected(p:i32,a:i32,b:i32,x:i32,reverse:i32)i32 {
  if(reverse==1){return worldstep(p,a,worldstep(p,b,x));}
  return worldstep(p,b,worldstep(p,a,x));
}
fn phrase_lookup(cache:[]u8,a:i32,b:i32,x:i32)i32 {
  let i:i32=0;while(i<6){let base:i32=i*5;
    if(wget(cache,base)==2 && wget(cache,base+1)==a && wget(cache,base+2)==b && wget(cache,base+3)==x){return wget(cache,base+4);}
    i=i+1;
  }return -99999;
}
fn met(O:[]u8,c:i32,name:[]u8,v:i32)i32 {let q:i32=o_app(O,c,name);return o_i64(O,q,v as i64);}
// Appended to original protocol functions before main.
fn token_for(map:[]u8,op:i32)i32 {let t:i32=0;while(t<3){if(wget(map,t)==op){return t;}t=t+1;}return -1;}
fn evidence_mask(map:[]u8,a:i32,b:i32,x:i32,outcome:i32)i32 {
  let mask:i32=0;if(listen(map,a,b,x,0)==outcome){mask=mask+1;}if(listen(map,a,b,x,1)==outcome){mask=mask+2;}return mask;
}
fn uncertain_pair(map:[]u8,mask:i32,a:i32,b:i32,x:i32)i32 {
  let l:i32=listen(map,a,b,x,0);let r:i32=listen(map,a,b,x,1);
  if(mask==1){return l;}if(mask==2){return r;}if(mask==3 && l==r){return l;}return -99999;
}
fn triple(map:[]u8,a:i32,b:i32,c:i32,x:i32,order:i32)i32 {
  if(order==0){return operation(wget(map,c),operation(wget(map,b),operation(wget(map,a),x)));}
  return operation(wget(map,a),operation(wget(map,b),operation(wget(map,c),x)));
}
fn worldtriple(p:i32,a:i32,b:i32,c:i32,x:i32,order:i32)i32 {
  if(order==0){return worldstep(p,c,worldstep(p,b,worldstep(p,a,x)));}
  return worldstep(p,a,worldstep(p,b,worldstep(p,c,x)));
}
fn rival_order(map:[]u8,a:i32,b:i32,x:i32,outcome:i32)i32 {
  let l:i32=listen(map,a,b,x,0);let r:i32=listen(map,a,b,x,1);
  if(l==outcome && r!=outcome){return 0;}if(r==outcome && l!=outcome){return 1;}return -1;
}
fn triple_cache(cache:[]u8,a:i32,b:i32,c:i32,x:i32)i32 {
  let i:i32=0;while(i<7){let base:i32=i*6;
    if(wget(cache,base)==3 && wget(cache,base+1)==a && wget(cache,base+2)==b && wget(cache,base+3)==c && wget(cache,base+4)==x){return wget(cache,base+5);}
    i=i+1;
  }return -99999;
}
fn main()i32 {
  let O:[]u8=z_alloc(65536);let cur:i32=0;let unexpected:i32=0;let total:i32=0;let frozen:i32=0;let rivalcorrect:i32=0;let cachecorrect:i32=0;
  let p:i32=0;
  while(p<6){
    let obs:[]u8=z_alloc(24);let map:[]u8=z_alloc(12);let t:i32=0;
    while(t<3){wset(obs,t*2,worldstep(p,t,0));wset(obs,t*2+1,worldstep(p,t,1));t=t+1;}learn(obs,map);
    let add:i32=token_for(map,0);let add2:i32=token_for(map,1);let mul:i32=token_for(map,2);
    let convention:i32=0;
    while(convention<2){
      let before:i32=uncertain_pair(map,3,add,mul,3);
      let commute_outcome:i32=expected(p,add,add2,0,convention);
      let commute_mask:i32=evidence_mask(map,add,add2,0,commute_outcome);
      let aftercommute:i32=uncertain_pair(map,commute_mask,add,mul,3);
      let outcome:i32=expected(p,add,mul,0,convention);
      let mask:i32=evidence_mask(map,add,mul,0,outcome);let acquired:i32=-1;
      if(mask==1){acquired=0;}if(mask==2){acquired=1;}
      let orderstate:[]u8=z_alloc(4);wset(orderstate,0,acquired);
      let rival:i32=rival_order(map,add,mul,0,outcome);
      let cache:[]u8=z_alloc(7*6*4);let ci:i32=0;
      while(ci<6){let base:i32=ci*6;wset(cache,base,1);wset(cache,base+1,ci/2);wset(cache,base+2,-1);wset(cache,base+3,-1);wset(cache,base+4,ci%2);wset(cache,base+5,wget(obs,ci));ci=ci+1;}
      wset(cache,36,2);wset(cache,37,add);wset(cache,38,mul);wset(cache,39,-1);wset(cache,40,0);wset(cache,41,outcome);
      let correct:i32=0;let fc:i32=0;let a:i32=0;
      while(a<3){let b:i32=0;
        while(b<3){let c:i32=0;
          while(c<3){let x:i32=3;
            while(x<=5){let truth:i32=worldtriple(p,a,b,c,x,convention);
              if(triple(map,a,b,c,x,wget(orderstate,0))==truth){correct=correct+1;}
              if(triple(map,a,b,c,x,rival)==truth){rivalcorrect=rivalcorrect+1;}
              if(triple_cache(cache,a,b,c,x)==truth){cachecorrect=cachecorrect+1;}
              if(triple(map,a,b,c,x,0)==truth){fc=fc+1;}x=x+1;
            }c=c+1;
          }b=b+1;
        }a=a+1;
      }
      let changed:i32=1-convention;let newoutcome:i32=expected(p,add,mul,0,changed);
      let newmask:i32=evidence_mask(map,add,mul,0,newoutcome);let revised:i32=0;if(newmask==2){revised=1;}
      let newtruth:i32=worldtriple(p,add,add2,mul,3,changed);
      let stale:i32=triple(map,add,add2,mul,3,acquired);let adapted:i32=triple(map,add,add2,mul,3,revised);
      cur=met(O,cur,"order permutation=",p);cur=met(O,cur," world=",convention);
      cur=met(O,cur," before=",before);cur=met(O,cur," commuting_mask=",commute_mask);
      cur=met(O,cur," after_commuting=",aftercommute);cur=met(O,cur," evidence_mask=",mask);
      cur=met(O,cur," acquired=",acquired);cur=met(O,cur," triple_correct=",correct);cur=met(O,cur," frozen_LTR=",fc);
      cur=met(O,cur," drift_stale=",stale);cur=met(O,cur," drift_revised=",adapted);cur=met(O,cur," drift_expected=",newtruth);cur=o_nl(O,cur);
      if(before!=-99999 || commute_mask!=3 || aftercommute!=-99999 || acquired!=convention || rival!=acquired || correct!=81){unexpected=unexpected+1;}
      if(adapted!=newtruth || stale==newtruth){unexpected=unexpected+1;}
      total=total+correct;frozen=frozen+fc;convention=convention+1;
    }p=p+1;
  }
  cur=met(O,cur,"order_summary learned=",total);cur=met(O,cur," frozen_LTR=",frozen);cur=met(O,cur," total=",972);cur=met(O,cur," simple_rival=",rivalcorrect);cur=met(O,cur," phrase_cache=",cachecorrect);cur=o_nl(O,cur);
  if(total!=972 || frozen>=972 || rivalcorrect!=972 || cachecorrect!=0){unexpected=unexpected+1;}
  cur=met(O,cur,"instrumentation_unexpected=",unexpected);cur=o_nl(O,cur);_zag_print(O[0..cur]);if(unexpected!=0){return 1;}return 0;
}

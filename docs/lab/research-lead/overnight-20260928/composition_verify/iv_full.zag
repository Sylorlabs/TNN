// iv_mech.zag -- composition internal verification: mechanism.
// Standalone pure-Zag implementation of the learner-owned verification
// loop: commit (predicted outcome) -> world consequence (downstream
// gate) -> confidence update (from gate only) -> later preference by
// earned confidence. No harness answer keys anywhere in this program.
//
// Conventions: L = learner state slice, E = world state slice.
// L cells (i32): 0 conf_XD, 1 conf_XY, 2 commit_comp, 3 commit_pred,
//   4 commit_input, 5 commit_status (0 none, 1 PENDING, 2 RESOLVED),
//   6 contract_X, 7 contract_Y, 8 contract_D.
// E cells (i32): 0 gate, 1 accepts, 2 rejects.
// Type codes: 0 EVEN, 1 ODD. Contract codes: 0 ALWAYS_EVEN,
//   1 ALWAYS_ODD, 2 PRESERVE, 3 FLIP, -1 UNKNOWN.
// Component ids: X 0, Y 1, D 2. Composition ids: XD 0, XY 1.

// ---------- output helpers (one buffer, cursor-returning) ----------
// Per toolchain lesson: no _zag_print for dynamic content. All output is
// formatted into ONE preallocated buffer; the driver performs a single
// _zag_raw_syscall write at the end.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1type(b:[]u8,c:i32,t:i32)i32 {
  if(t==0){return e1str(b,c,"EVEN");}
  return e1str(b,c,"ODD");
}
fn e1contract(b:[]u8,c:i32,k:i32)i32 {
  if(k==0){return e1str(b,c,"ALWAYS_EVEN");}
  if(k==1){return e1str(b,c,"ALWAYS_ODD");}
  if(k==2){return e1str(b,c,"PRESERVE");}
  if(k==3){return e1str(b,c,"FLIP");}
  return e1str(b,c,"UNKNOWN");
}
fn e1comp(b:[]u8,c:i32,g:i32)i32 {
  if(g==0){return e1str(b,c,"XD");}
  return e1str(b,c,"XY");
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }

// ---------- components (fixed behavior) ----------
fn comp_run(c:i32,v:i32)i32 {
  if(c==0){return v+10;}
  if(c==1){return v*2;}
  return v+1;
}
fn comp_first(g:i32)i32 { return 0; }
fn comp_second(g:i32)i32 {
  if(g==0){return 2;}
  return 1;
}
fn parity(v:i32)i32 { return v-(v/2)*2; }

// ---------- contract induction (learner operation, general rule) ----------
// Two probes per component. Rule: both outputs same parity -> ALWAYS
// that parity; outputs track inputs -> PRESERVE; outputs flip inputs ->
// FLIP; else UNKNOWN. Identical rule for every component.
fn induce(c:i32,a1:i32,a2:i32)i32 {
  let p1:i32=parity(a1); let q1:i32=parity(comp_run(c,a1));
  let p2:i32=parity(a2); let q2:i32=parity(comp_run(c,a2));
  if(q1==q2){return q1;}
  if(q1==p1 && q2==p2){return 2;}
  if(q1!=p1 && q2!=p2){return 3;}
  return -1;
}
fn apply_c(k:i32,p:i32)i32 {
  if(k==0){return 0;}
  if(k==1){return 1;}
  if(k==2){return p;}
  if(k==3){return 1-p;}
  return -1;
}
fn compose_contract(L:[]u8,g:i32,p:i32)i32 {
  let mid:i32=apply_c(lg(L,6+comp_first(g)),p);
  if(mid<0){return -1;}
  return apply_c(lg(L,6+comp_second(g)),mid);
}

// ---------- commitment (learner operation) ----------
// Records the predicted outcome BEFORE any execution. The prediction is
// derived from the induced contracts, never from a harness-supplied
// answer. Status PENDING proves the commitment predates execution.
fn learner_commit(L:[]u8,g:i32,input:i32)void {
  let pred:i32=compose_contract(L,g,parity(input));
  ls(L,2,g); ls(L,3,pred); ls(L,4,input); ls(L,5,1);
  return;
}

// ---------- world (environment; fixed law, no per-query targets) ----------
fn world_execute(g:i32,input:i32)i32 {
  let v:i32=comp_run(comp_first(g),input);
  v=comp_run(comp_second(g),v);
  return v;
}
// World law: the downstream machine accepts iff the value is even. The
// gate latch is the only consequence signal the learner may read.
fn world_downstream(E:[]u8,v:i32)void {
  let g:i32=0;
  if(parity(v)==0){g=1;set32(E,4,get32(E,4)+1);}
  else{set32(E,8,get32(E,8)+1);}
  set32(E,0,g);
  return;
}
fn world_gate(E:[]u8)i32 { return get32(E,0); }

// ---------- confidence update (learner operation) ----------
// Reads ONLY the world gate. Never receives an actual output value.
// Never references a harness answer key.
fn learner_update(L:[]u8,E:[]u8,g:i32)void {
  let gate:i32=world_gate(E);
  let c:i32=lg(L,g);
  if(gate==1){ls(L,g,c+1);}else{ls(L,g,c-1);}
  ls(L,5,2);
  return;
}

// ---------- selection (learner operation) ----------
// Reads ONLY the confidence ledger. Tie -> lowest composition id.
fn learner_select(L:[]u8)i32 {
  let cxd:i32=lg(L,0);
  let cxy:i32=lg(L,1);
  if(cxy>cxd){return 1;}
  if(cxd>cxy){return 0;}
  return 0;
}
// iv_main.zag -- composition internal verification: driver (harness).
// Phases IND, Z1, Z2, Z3, ABL. Transcript emission. main().
// The driver sequences phases and logs white-box instrumentation; it is
// not cognition. Actual output values appear in the log as labeled
// instrumentation and are never passed to any learner function.

// One commit/execute/consequence/update episode. tag is "Z1" or "Z2".
fn phase_commit(b:[]u8,c:i32,L:[]u8,E:[]u8,g:i32,input:i32,tag:[]u8)i32 {
  let before:i32=lg(L,g);
  learner_commit(L,g,input);
  let st:i32=lg(L,5);
  c=e1str(b,c,tag); c=e1str(b,c," COMMIT comp="); c=e1comp(b,c,g);
  c=e1str(b,c," predicted="); c=e1type(b,c,lg(L,3));
  c=e1str(b,c," input="); c=e1i64(b,c,input as i64);
  c=e1str(b,c," status=");
  if(st==1){c=e1str(b,c,"PENDING");}else{c=e1str(b,c,"OTHER");}
  c=e1str(b,c,"\n");
  let actual:i32=world_execute(g,input);
  c=e1str(b,c,tag); c=e1str(b,c," EXEC actual="); c=e1i64(b,c,actual as i64);
  c=e1str(b,c," (instrumentation, not learner input)\n");
  world_downstream(E,actual);
  let gate:i32=world_gate(E);
  c=e1str(b,c,tag); c=e1str(b,c," CONSEQUENCE gate="); c=e1i64(b,c,gate as i64);
  if(gate==1){c=e1str(b,c," downstream=ACCEPT\n");}else{c=e1str(b,c," downstream=REJECT\n");}
  learner_update(L,E,g);
  let after:i32=lg(L,g);
  c=e1str(b,c,tag); c=e1str(b,c," UPDATE comp="); c=e1comp(b,c,g);
  c=e1str(b,c," conf="); c=e1i64(b,c,before as i64);
  c=e1str(b,c,"->"); c=e1i64(b,c,after as i64);
  c=e1str(b,c," (source=gate)\n");
  return c;
}

fn iv_ind_line(b:[]u8,c:i32,cid:i32,a1:i32,a2:i32,k:i32)i32 {
  c=e1str(b,c,"IND ");
  if(cid==0){c=e1str(b,c,"X probes ");}
  if(cid==1){c=e1str(b,c,"Y probes ");}
  if(cid==2){c=e1str(b,c,"D probes ");}
  c=e1i64(b,c,a1 as i64); c=e1str(b,c,"->"); c=e1i64(b,c,comp_run(cid,a1) as i64);
  c=e1str(b,c," "); c=e1i64(b,c,a2 as i64); c=e1str(b,c,"->"); c=e1i64(b,c,comp_run(cid,a2) as i64);
  c=e1str(b,c," contract="); c=e1contract(b,c,k); c=e1str(b,c,"\n");
  return c;
}

fn main()i32 {
  let OUT:[]u8=z_alloc(8192);
  let oc:i32=0;
  oc=e1str(OUT,oc,"IV-COMMIT-VERIFY run\nARM MAIN\n");
  let L:[]u8=z_alloc(64);
  let E:[]u8=z_alloc(32);
  // IND phase: frozen probes, general induction rule.
  let kx:i32=induce(0,100,101); ls(L,6,kx);
  oc=iv_ind_line(OUT,oc,0,100,101,kx);
  let ky:i32=induce(1,100,101); ls(L,7,ky);
  oc=iv_ind_line(OUT,oc,1,100,101,ky);
  let kd:i32=induce(2,101,103); ls(L,8,kd);
  oc=iv_ind_line(OUT,oc,2,101,103,kd);
  // Z1: commit (X,Y), consequence, update.
  oc=phase_commit(OUT,oc,L,E,1,100,"Z1");
  // Z2: commit (X,D), consequence, update.
  oc=phase_commit(OUT,oc,L,E,0,100,"Z2");
  // Z3: new problem (input 200). Select by earned confidence.
  oc=e1str(OUT,oc,"Z3 PROBLEM input=200 downstream=EVEN-REQUIRED\n");
  let chm:i32=learner_select(L);
  let tie:i32=0;
  if(lg(L,0)==lg(L,1)){tie=1;}
  oc=e1str(OUT,oc,"Z3 SELECT confXY="); oc=e1i64(OUT,oc,lg(L,1) as i64);
  oc=e1str(OUT,oc," confXD="); oc=e1i64(OUT,oc,lg(L,0) as i64);
  oc=e1str(OUT,oc," choice="); oc=e1comp(OUT,oc,chm);
  if(tie==1){oc=e1str(OUT,oc," rule=tie->lowest-id\n");}else{oc=e1str(OUT,oc," rule=argmax-conf\n");}
  let a3:i32=world_execute(chm,200);
  world_downstream(E,a3);
  let g3:i32=world_gate(E);
  oc=e1str(OUT,oc,"Z3 EXEC choice="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," actual="); oc=e1i64(OUT,oc,a3 as i64);
  oc=e1str(OUT,oc," gate="); oc=e1i64(OUT,oc,g3 as i64);
  if(g3==1){oc=e1str(OUT,oc," downstream=ACCEPT\n");}else{oc=e1str(OUT,oc," downstream=REJECT\n");}
  let u0:i32=lg(L,chm);
  learner_update(L,E,chm);
  let u1:i32=lg(L,chm);
  oc=e1str(OUT,oc,"Z3 UPDATE comp="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," conf="); oc=e1i64(OUT,oc,u0 as i64);
  oc=e1str(OUT,oc,"->"); oc=e1i64(OUT,oc,u1 as i64);
  oc=e1str(OUT,oc," (source=gate)\n");
  // ABL arm: fresh learner state, no induction, no consequence history.
  oc=e1str(OUT,oc,"ARM ABLATION (no consequence history)\n");
  let L2:[]u8=z_alloc(64);
  let cha:i32=learner_select(L2);
  let tiea:i32=0;
  if(lg(L2,0)==lg(L2,1)){tiea=1;}
  oc=e1str(OUT,oc,"ABL SELECT confXY="); oc=e1i64(OUT,oc,lg(L2,1) as i64);
  oc=e1str(OUT,oc," confXD="); oc=e1i64(OUT,oc,lg(L2,0) as i64);
  oc=e1str(OUT,oc," choice="); oc=e1comp(OUT,oc,cha);
  if(tiea==1){oc=e1str(OUT,oc," rule=tie->lowest-id\n");}else{oc=e1str(OUT,oc," rule=argmax-conf\n");}
  oc=e1str(OUT,oc,"ABL NOTE choice differs from MAIN: preference is ledger-driven\n");
  oc=e1str(OUT,oc,"SUMMARY main_choice="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," ablation_choice="); oc=e1comp(OUT,oc,cha);
  oc=e1str(OUT,oc,"\n");
  // Single raw write of exactly the buffered bytes.
  let _wn:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),oc as i64,0,0,0);
  if(_wn<0){oc=0;}
  return 0;
}

// ma_patch_permap.zag -- per-candidate (per-MAP-shape) applicability (unfrozen).
// APPL-PERMAP: extends the problem-level APPL gate to per-candidate judgments.
//
// The rerun K3 analysis showed the problem-level gate cannot express
// "reuse WHICH structure?": after the C0 burn it refuses all reuse on
// C-like problems, missing that the C0-promoted plen-4 MAP is reusable
// at 1 try each. Here consequence records are partitioned by the
// candidate MAP's observable shape (rb_chain_plen of its promoted graph
// root, computed from graph structure, zero domain labels). Rebind
// already matches candidates to paths by exact plen, so applicability is
// inherently shape-partitioned in this substrate. Each candidate is
// scored from the consequence history of its own shape on problems with
// similar observable features.
//
// Two-pass rebind (rb_chain_plen, pc_is_linked, pc_try_one) verbatim from
// learning_to_learn/l2l_patch.zag. rebind_try_permap refactored to gate
// each candidate separately and share a single gather with the gate.
fn phase_a_enabled()i32 { return 1; }
// Walk a promoted graph root. If it is a pure chain
// (guard --true--> set --SEQ--> guard --true--> set ...),
// return the value-chain length plen = guards+1. Else -1.
// Verbatim from adv_patch.zag.
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}
// 1 if MAP m has an outgoing type-14 LINK edge (was built via rebind).
fn pc_is_linked(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// Delete all type-14 LINK edges. (Unused here; kept for parity.)
fn pc_del_links(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Try one MAP's shape on the query. On verified success, promote the
// rebound and write the persistent LINK edge new -> helper.
// Verbatim from learning_to_learn/l2l_patch.zag.
fn pc_try_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        let j:i32=0;
        while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,v,plen,f);
        let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
        if(v2!=-2){
          let bm:i32=promote_graph(W,nr,s,r,v2,f,plen-1);
          if(bm>=0){link_edge(W,bm,14,m,0);}
          ans=v2;
        }
      }
      p=p+1;
    }
  }
  return ans;
}
// ============ APPL-PERMAP: per-candidate applicability substrate ============
// AP region layout (4096 bytes, driver-allocated, persists across queries):
//   0..31   : w[8] feature weights, fixed point x100, init 100
//   32      : nrec (total consequence-record count)
//   36      : qseq (per-query sequence counter for CAND log lines)
//   40..2855: 64 records x 44 bytes:
//             F[8] (32B) + candidate shape plen (4B) + outcome (4B) + cost (4B)
//   2860..2891: last computed F (driver-visible for replay analysis)
//   2896..2927: saved F slot (driver uses for C0)
// Features F[8] (all observable pre-reuse, no labels): same 8 as the
// problem-level gate: np, plen_max, c5, c4, c3, c2, cx, r.
// The per-MAP extension is the shape partition key: the candidate MAP's
// observable chain plen. Records for one shape never vote on another.
fn pap_init(AP:[]u8)void {
  let j:i32=0;
  while(j<8){set32(AP,j*4,100); j=j+1;}
  set32(AP,32,0);
  set32(AP,36,0);
  return;
}
// Fill F from pre-gathered paths. No domain labels; pure structure.
// Verbatim from the problem-level gate.
fn ma_features_from_paths(W:[]u8,paths:[]u8,np:i32,r:i32,F:[]u8)void {
  let pmax:i32=0;
  let c5:i32=0; let c4:i32=0; let c3:i32=0; let c2:i32=0; let cx:i32=0;
  let p:i32=0;
  while(p<np){
    let base:i32=p*48; let plen:i32=get32(paths,base);
    if(plen>pmax){pmax=plen;}
    if(plen==5){c5=c5+1;}
    if(plen==4){c4=c4+1;}
    if(plen==3){c3=c3+1;}
    if(plen==2){c2=c2+1;}
    let k:i32=0; let bad:i32=0;
    while(k<plen-1){
      let fn2:i32=get32(paths,base+24+k*4);
      if(ng(W,fn2,24)!=1){bad=1;}
      k=k+1;
    }
    if(bad==1){cx=cx+1;}
    p=p+1;
  }
  set32(F,0,np); set32(F,4,pmax);
  set32(F,8,c5); set32(F,12,c4); set32(F,16,c3); set32(F,20,c2);
  set32(F,24,cx); set32(F,28,r);
  return;
}
// Record count for one candidate shape.
fn pap_count_shape(AP:[]u8,shape:i32)i32 {
  let nrec:i32=get32(AP,32);
  let n:i32=0; let i:i32=0;
  while(i<nrec){
    if(get32(AP,40+i*44+32)==shape){n=n+1;}
    i=i+1;
  }
  return n;
}
// Average similarity (x100) of F to records with the wanted outcome AND
// the given candidate shape. -1 if no such records.
// sim = 10000/(100+2D), D = sum w_j*|d_j| (x100), same as problem gate.
fn pap_avg_sim(F:[]u8,AP:[]u8,want_o:i32,shape:i32)i32 {
  let nrec:i32=get32(AP,32);
  let sum:i32=0; let n:i32=0; let i:i32=0;
  while(i<nrec){
    let roff:i32=40+i*44;
    if(get32(AP,roff+36)==want_o && get32(AP,roff+32)==shape){
      let D:i32=0; let j:i32=0;
      while(j<8){
        let d:i32=get32(F,j*4)-get32(AP,roff+j*4);
        if(d<0){d=-d;}
        D=D+get32(AP,j*4)*d;
        j=j+1;
      }
      sum=sum+10000/(100+2*D);
      n=n+1;
    }
    i=i+1;
  }
  if(n==0){return -1;}
  return sum/n;
}
// Per-candidate applicability decision: 1 = attempt THIS candidate, 0 = skip.
// Attempt iff avg similarity to this shape's past successes exceeds avg
// similarity to this shape's past failures by the 15-point
// pessimistic-prior margin. With fewer than 3 records for this shape, be
// optimistic (explore to build the shape's consequence base).
fn pap_decide(AP:[]u8,F:[]u8,shape:i32)i32 {
  let ns:i32=pap_count_shape(AP,shape);
  if(ns<3){return 1;}
  let avs:i32=pap_avg_sim(F,AP,1,shape);
  let avf:i32=pap_avg_sim(F,AP,0,shape);
  if(avs<0){avs=0;}
  if(avf<0){avf=0;}
  if(avs>avf+15){return 1;}
  return 0;
}
// Record one candidate attempt's consequence and update the similarity
// weights. Weight rule (consequence-driven, unchanged from the problem
// gate): find the nearest opposite-outcome record over ALL records;
// w_j += 25*|F_j - G_j| (clamp 800). The weights stay shared across
// shapes; only the decision is shape-partitioned.
fn pap_observe(AP:[]u8,F:[]u8,shape:i32,o:i32,cost:i32)void {
  let nrec:i32=get32(AP,32);
  let roff:i32=40+(nrec%64)*44;
  let j:i32=0;
  while(j<8){set32(AP,roff+j*4,get32(F,j*4)); j=j+1;}
  set32(AP,roff+32,shape);
  set32(AP,roff+36,o);
  set32(AP,roff+40,cost);
  if(nrec<64){set32(AP,32,nrec+1);}
  // nearest opposite-outcome record (min D under current weights)
  let best:i32=-1; let bestD:i32=2147483647; let i:i32=0;
  let nn:i32=get32(AP,32);
  while(i<nn){
    let goff:i32=40+i*44;
    if(get32(AP,goff+36)==1-o){
      let D:i32=0; let k:i32=0;
      while(k<8){
        let d:i32=get32(F,k*4)-get32(AP,goff+k*4);
        if(d<0){d=-d;}
        D=D+get32(AP,k*4)*d;
        k=k+1;
      }
      if(D<bestD){bestD=D; best=i;}
    }
    i=i+1;
  }
  if(best>=0){
    let goff:i32=40+best*44;
    let m2:i32=0;
    while(m2<8){
      let d:i32=get32(F,m2*4)-get32(AP,goff+m2*4);
      if(d<0){d=-d;}
      let w:i32=get32(AP,m2*4)+25*d;
      if(w>800){w=800;}
      set32(AP,m2*4,w);
      m2=m2+1;
    }
  }
  return;
}
// Count alive MAP nodes (reuse candidates).
fn ma_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// Score and attempt ONE candidate MAP. acc[0]=tried, acc[4]=skipped,
// acc[8]=winning plen, acc[12]=winning MAP id. Returns the answer or -2.
fn permap_cand(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,st:[]u8,paths:[]u8,np:i32,AP:[]u8,F:[]u8,qseq:i32,acc:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let g:i32=pap_decide(AP,F,plen);
    emit("CAND q="); e64(qseq); emit(" m="); e64(m); emit(" plen="); e64(plen);
    emit(" gate="); e64(g);
    if(g==1){
      let t0:i32=get32(st,0);
      let a2:i32=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
      let dc:i32=get32(st,0)-t0;
      set32(acc,0,get32(acc,0)+1);
      if(a2!=-2){
        pap_observe(AP,F,plen,1,dc);
        set32(acc,8,plen); set32(acc,12,m);
        ans=a2;
        emit(" tried=1 ok=1\n");
      } else {
        pap_observe(AP,F,plen,0,dc);
        emit(" tried=1 ok=0\n");
      }
    } else {
      set32(acc,4,get32(acc,4)+1);
      emit(" tried=0 ok=0\n");
    }
  }
  return ans;
}
// Two-pass rebind over pre-gathered paths with per-candidate gating.
// Pass 1: MAPs with an outgoing type-14 edge (built via rebind before),
// newest first. Pass 2: all other MAPs in id order. Each candidate is
// scored by pap_decide on its own shape; gate=0 candidates are skipped.
// Correctness unchanged (verification arbitrates).
fn rebind_try_permap(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8,paths:[]u8,np:i32,AP:[]u8,F:[]u8,qseq:i32,acc:[]u8)i32 {
  let ans:i32=-2;
  let m:i32=1023;
  while(m>=2 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==1){
      ans=permap_cand(W,m,s,r,expected,masked,st,paths,np,AP,F,qseq,acc);
    }
    m=m-1;
  }
  m=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==0){
      ans=permap_cand(W,m,s,r,expected,masked,st,paths,np,AP,F,qseq,acc);
    }
    m=m+1;
  }
  return ans;
}
// ev_query with the trimmed-base test signature. The base's built-in test
// battery (t_c1 etc.) references ev_query; this wrapper satisfies those
// references. The driver uses ma_query directly; this is never called.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  let ST:[]u8=z_alloc(32);
  return ma_query(W,AP,s,r,expected,flags,ST);
}
// ma_query with the per-candidate gate. ST layout (32 bytes):
// 0: any candidate attempted (0/1)  4: rebind tries  8: rebind fails
// 12: trial tries  16: candidates tried  20: candidates skipped
// 24: winning candidate plen (-1)  28: winning candidate MAP id (-1)
fn ma_query(W:[]u8,AP:[]u8,s:i32,r:i32,expected:i32,flags:i32,ST:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0);
    set32(ST,0,-1); set32(ST,4,0); set32(ST,8,0); set32(ST,12,0);
    set32(ST,16,0); set32(ST,20,0); set32(ST,24,-1); set32(ST,28,-1);
    return ng(W,n,28);
  }
  let masked:i32=flags&1;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  let F:[]u8=z_alloc(32);
  ma_features_from_paths(W,paths,np,r,F);
  let q:i32=0;
  while(q<8){set32(AP,2860+q*4,get32(F,q*4)); q=q+1;}
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let qs:i32=get32(AP,36)+1; set32(AP,36,qs);
  set32(ST,0,0); set32(ST,16,0); set32(ST,20,0);
  set32(ST,24,-1); set32(ST,28,-1);
  let ra:i32=-2;
  if(ma_count_maps(W)>0){
    let acc:[]u8=z_alloc(16);
    set32(acc,0,0); set32(acc,4,0); set32(acc,8,-1); set32(acc,12,-1);
    ra=rebind_try_permap(W,s,r,expected,masked,rbs,paths,np,AP,F,qs,acc);
    let tr:i32=get32(acc,0);
    if(tr>0){set32(ST,0,1);}
    set32(ST,16,tr); set32(ST,20,get32(acc,4));
    set32(ST,24,get32(acc,8)); set32(ST,28,get32(acc,12));
  }
  let rbt:i32=get32(rbs,0); let rbr:i32=get32(rbs,4);
  set32(ST,4,rbt); set32(ST,8,rbr);
  hs(W,56,rbt); hs(W,60,rbr);
  if(ra!=-2){
    hs(W,16,rbt*1024+rbr); log_ev(W,2,s,r,ra,1,0,0);
    set32(ST,12,0);
    return ra;
  }
  let ans:i32=mp_run(W,s,r,expected,flags);
  let lt:i32=hg(W,16)/1024;
  set32(ST,12,lt);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0); miss_inquire(W,s,r);
  return -2;
}

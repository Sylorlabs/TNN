// gpi2_world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Three delimiter types: T0=(40,41), T1=(91,93), T2=(123,125).
// w_check: 1 iff every byte is one of the six delimiter bytes,
// the string is balanced, and every close matches the most
// recent open type (stack discipline). No depth limit and no
// world change in GPI-2.

fn w_zalloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

fn w_check(w:[]u8, buf:[]u8, len:i32)i32 {
  let stack:[]u8=w_zalloc(128);
  let sp:i32=0;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    let ot:i32=-1;
    if(c==40){ot=0;}
    if(c==91){ot=1;}
    if(c==123){ot=2;}
    if(ot>=0){
      if(sp>=128){return 0;}
      stack[sp]=ot as u8;
      sp=sp+1;
    }
    else {
      let ct:i32=-1;
      if(c==41){ct=0;}
      if(c==93){ct=1;}
      if(c==125){ct=2;}
      if(ct<0){return 0;}
      if(sp<=0){return 0;}
      sp=sp-1;
      let top:i32=stack[sp] as i32;
      if(top!=ct){return 0;}
    }
    i=i+1;
  }
  if(sp!=0){return 0;}
  return 1;
}

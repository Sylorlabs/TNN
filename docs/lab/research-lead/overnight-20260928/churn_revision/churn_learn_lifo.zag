// stress_learn.zag - Continuing-Learner Stress Battery
// One persistent learner, one process, one main(), 8 sequential phases.
// No phase labels, task IDs, or mode flags reach the learner.
// Single consequence-policy store (DEVINT2 survivor), capacity 36.
// Pure Zag. No Python.
// Prereg: PREREG_STRESS.md (4ca3a7196) + ADDENDUM1 (e16897bc9), frozen before implementation.
fn policy()i32 { return 1; } // build flag: 0=FIFO ties (control), 1=LIFO ties (variant)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// Rule record: 11 i32 fields, 44 bytes.
// 0 subj, 4 rel, 8 obj, 12 correct, 16 wrong, 20 dependents,
// 24 contradictions, 28 last_used, 32 taught, 36 superseded, 40 valid
// Store base 64, capacity 36. Tick at W[0..4]. Foundation-evict flag at W[8..12].
fn rf(W:[]u8, base:i32, s:i32, f:i32)i32 { return get32(W, base+s*44+f); }
fn wf(W:[]u8, base:i32, s:i32, f:i32, v:i32)void { set32(W, base+s*44+f, v); return; }
fn newtick(W:[]u8)i32 { let t:i32=get32(W,0)+1; set32(W,0,t); return t; }
fn find_key(W:[]u8, base:i32, subj:i32, rel:i32)i32 {
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1 && rf(W,base,s,0)==subj && rf(W,base,s,4)==rel){ return s; }
    s=s+1;
  }
  return -1;
}
fn store_count(W:[]u8, base:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){ if(rf(W,base,s,40)==1){ n=n+1; } s=s+1; }
  return n;
}
fn importance_c(W:[]u8, base:i32, s:i32)i32 {
  let c:i32=rf(W,base,s,12);
  let w:i32=rf(W,base,s,16);
  let d:i32=rf(W,base,s,20);
  let k:i32=rf(W,base,s,24);
  return 10*(c-w) + 5*d - 8*k + 1;
}
fn evict_c(W:[]u8, base:i32)i32 {
  let best:i32=0;
  let bestk:i32=0;
  let first:i32=1;
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1){
      let imp:i32=importance_c(W,base,s);
      if(first==1){ best=s; bestk=imp; first=0; }
      else { if(policy()==0){ if(imp<bestk){ best=s; bestk=imp; } } else { if(imp<=bestk){ best=s; bestk=imp; } } }
    }
    s=s+1;
  }
  return best;
}
fn learn(W:[]u8, subj:i32, rel:i32, obj:i32)void {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s>=0){
    wf(W,base,s,28,t);
    let old:i32=rf(W,base,s,8);
    if(old!=obj){
      wf(W,base,s,36,old);
      wf(W,base,s,8,obj);
      wf(W,base,s,24,rf(W,base,s,24)+1);
      wf(W,base,s,16,rf(W,base,s,16)+1);
    }
    return;
  }
  let n:i32=store_count(W,base);
  if(n<36){ s=n; }
  else {
    s=evict_c(W,base);
    let vs:i32=rf(W,base,s,0);
    let vr:i32=rf(W,base,s,4);
    emit("EVICT ");
    emit(i32s(vs));
    emit(" ");
    emit(i32s(vr));
    emit("\n");
    if(vs>=1 && vs<=6){ set32(W,8,1); }
  }
  wf(W,base,s,0,subj);
  wf(W,base,s,4,rel);
  wf(W,base,s,8,obj);
  wf(W,base,s,12,0);
  wf(W,base,s,16,0);
  wf(W,base,s,20,0);
  wf(W,base,s,24,0);
  wf(W,base,s,28,t);
  wf(W,base,s,32,t);
  wf(W,base,s,36,-1);
  wf(W,base,s,40,1);
  return;
}
fn query(W:[]u8, subj:i32, rel:i32, expected:i32)i32 {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s<0){ return -2; }
  wf(W,base,s,28,t);
  let p:i32=rf(W,base,s,8);
  if(p==expected){ wf(W,base,s,12,rf(W,base,s,12)+1); }
  else { wf(W,base,s,16,rf(W,base,s,16)+1); }
  return p;
}
fn signof(v:i32)i32 {
  if(v>0){ return 1; }
  if(v<0){ return -1; }
  return 0;
}
fn twohop(W:[]u8, s1:i32, r1:i32, e1:i32, s2:i32, r2:i32, e2:i32, expc:i32)i32 {
  let base:i32=64;
  let p1:i32=query(W,s1,r1,e1);
  let p2:i32=query(W,s2,r2,e2);
  if(p1==-2 || p2==-2){ return 0; }
  let a:i32=find_key(W,base,s1,r1);
  let b:i32=find_key(W,base,s2,r2);
  if(a>=0){ wf(W,base,a,20,rf(W,base,a,20)+1); }
  if(b>=0){ wf(W,base,b,20,rf(W,base,b,20)+1); }
  if(signof(p1-p2)==expc){ return 1; }
  return 0;
}
fn storehash(W:[]u8, base:i32)i64 {
  let h:i64=0;
  let s:i32=0;
  while(s<36){
    let f:i32=0;
    while(f<44){
      let u:i64=(get32(W,base+s*44+f) as i64)+2147483648;
      h=(h+u)%1000000007;
      h=h*31%1000000007;
      f=f+4;
    }
    s=s+1;
  }
  let t:i64=(get32(W,0) as i64)+2147483648;
  h=(h+t)%1000000007;
  return h;
}
fn i64s(v:i64)[]u8 { return _zag_i64_to_str(v); }
fn emit_stage_hash(W:[]u8, st:i32)void {
  emit("STATEHASH P");
  emit(i32s(st));
  emit(" TICK ");
  emit(i32s(get32(W,0)));
  emit(" H ");
  emit(i64s(storehash(W,64)));
  emit("\n");
  return;
}
fn count_junk(W:[]u8)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==99){ n=n+1; }
    s=s+1;
  }
  return n;
}
// Collateral sample slots in W at 2000 + i*4 (12 i32s).
fn coll_record(W:[]u8)void {
  set32(W,2000,query(W,1,10,4));
  set32(W,2004,query(W,1,11,5));
  set32(W,2008,query(W,3,10,2));
  set32(W,2012,query(W,4,12,2));
  set32(W,2016,query(W,6,10,8));
  set32(W,2020,query(W,2,12,1));
  set32(W,2024,query(W,60,40,7));
  set32(W,2028,query(W,70,42,25));
  set32(W,2032,query(W,80,44,4));
  set32(W,2036,query(W,90,46,12));
  set32(W,2040,query(W,100,99,100));
  set32(W,2044,query(W,101,99,101));
  return;
}
fn coll_changes(W:[]u8)i32 {
  let n:i32=0;
  if(query(W,1,10,4)!=get32(W,2000)){ n=n+1; }
  if(query(W,1,11,5)!=get32(W,2004)){ n=n+1; }
  if(query(W,3,10,2)!=get32(W,2008)){ n=n+1; }
  if(query(W,4,12,2)!=get32(W,2012)){ n=n+1; }
  if(query(W,6,10,8)!=get32(W,2016)){ n=n+1; }
  if(query(W,2,12,1)!=get32(W,2020)){ n=n+1; }
  if(query(W,60,40,7)!=get32(W,2024)){ n=n+1; }
  if(query(W,70,42,25)!=get32(W,2028)){ n=n+1; }
  if(query(W,80,44,4)!=get32(W,2032)){ n=n+1; }
  if(query(W,90,46,12)!=get32(W,2036)){ n=n+1; }
  if(query(W,100,99,100)!=get32(W,2040)){ n=n+1; }
  if(query(W,101,99,101)!=get32(W,2044)){ n=n+1; }
  return n;
}
fn found_probe(W:[]u8, e210:i32, e511:i32)i32 {
  let n:i32=0;
  if(query(W,1,10,4)==4){ n=n+1; }
  if(query(W,1,11,5)==5){ n=n+1; }
  if(query(W,2,10,e210)==e210){ n=n+1; }
  if(query(W,2,12,1)==1){ n=n+1; }
  if(query(W,3,10,2)==2){ n=n+1; }
  if(query(W,4,12,2)==2){ n=n+1; }
  if(query(W,5,11,e511)==e511){ n=n+1; }
  if(query(W,6,10,8)==8){ n=n+1; }
  return n;
}

// Newcomer-churn experiment main(): 6 phases, C1..C6.
// Learner core above is byte-identical to stress_learn.zag (daa9bf2fc)
// except the POLICY build flag and the evict_c tie-break branch.
fn count_rel(W:[]u8, rel:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==rel){ n=n+1; }
    s=s+1;
  }
  return n;
}
fn main()i32 {
  emit("=== CHURN-REVISION: newcomer churn under memory pressure ===\n");
  emit("PREREG PREREG_CHURN.md 18fb10434; POLICY ");
  emit(i32s(policy()));
  emit("\n");
  let W:[]u8=z_alloc(8192);
  set32(W,0,0);
  set32(W,8,0);

  // ---------- C1: foundation ----------
  emit("PHASE C1\n");
  learn(W,1,10,4); learn(W,1,11,5); learn(W,2,10,4); learn(W,2,12,1);
  learn(W,3,10,2); learn(W,4,12,2); learn(W,5,11,2); learn(W,6,10,8);
  learn(W,7,10,3); learn(W,8,12,5); learn(W,9,10,1); learn(W,9,11,7);
  let c1r:i32=0;
  if(query(W,1,10,4)==4){ c1r=c1r+1; }
  if(query(W,1,11,5)==5){ c1r=c1r+1; }
  if(query(W,2,10,4)==4){ c1r=c1r+1; }
  if(query(W,2,12,1)==1){ c1r=c1r+1; }
  if(query(W,3,10,2)==2){ c1r=c1r+1; }
  if(query(W,4,12,2)==2){ c1r=c1r+1; }
  if(query(W,5,11,2)==2){ c1r=c1r+1; }
  if(query(W,6,10,8)==8){ c1r=c1r+1; }
  if(query(W,7,10,3)==3){ c1r=c1r+1; }
  if(query(W,8,12,5)==5){ c1r=c1r+1; }
  if(query(W,9,10,1)==1){ c1r=c1r+1; }
  if(query(W,9,11,7)==7){ c1r=c1r+1; }
  emit("C1_RECALL ");
  emit(i32s(c1r));
  emit("/12\n");
  emit_stage_hash(W,1);

  // ---------- C2: newcomers (earned Group A + never-queried sleepers) ----------
  emit("PHASE C2\n");
  let a:i32=10;
  while(a<20){ learn(W,a,30,a); a=a+1; }
  a=10;
  while(a<20){ query(W,a,30,a); query(W,a,30,a); a=a+1; }
  learn(W,40,20,4); learn(W,41,20,9); learn(W,42,20,2); learn(W,43,20,7);
  learn(W,44,20,5); learn(W,45,20,1); learn(W,46,20,8); learn(W,47,20,3);
  learn(W,48,20,6); learn(W,49,20,0);
  emit("C2_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("C2_EARNED ");
  emit(i32s(count_rel(W,30)));
  emit("/10\n");
  emit_stage_hash(W,2);

  // ---------- C3: pressure wave ----------
  emit("PHASE C3\n");
  let f:i32=300;
  while(f<330){ learn(W,f,99,f); f=f+1; }
  emit("C3_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("C3_EARNED ");
  emit(i32s(count_rel(W,30)));
  emit("/10\n");
  emit("C3_FLOOD ");
  emit(i32s(count_rel(W,99)));
  emit("/30\n");
  emit_stage_hash(W,3);

  // ---------- C4: delayed first-use probe of sleepers ----------
  emit("PHASE C4\n");
  let surv:i32=0;
  if(query(W,40,20,4)==4){ surv=surv+1; }
  if(query(W,41,20,9)==9){ surv=surv+1; }
  if(query(W,42,20,2)==2){ surv=surv+1; }
  if(query(W,43,20,7)==7){ surv=surv+1; }
  if(query(W,44,20,5)==5){ surv=surv+1; }
  if(query(W,45,20,1)==1){ surv=surv+1; }
  if(query(W,46,20,8)==8){ surv=surv+1; }
  if(query(W,47,20,3)==3){ surv=surv+1; }
  if(query(W,48,20,6)==6){ surv=surv+1; }
  if(query(W,49,20,0)==0){ surv=surv+1; }
  emit("C4_SURV_SLEEP ");
  emit(i32s(surv));
  emit("/10\n");
  let comp:i32=0;
  comp=comp+twohop(W,40,20,4,3,10,2,1);
  comp=comp+twohop(W,41,20,9,1,10,4,1);
  comp=comp+twohop(W,42,20,2,6,10,8,-1);
  comp=comp+twohop(W,43,20,7,9,10,1,1);
  emit("C4_COMP_FIRST ");
  emit(i32s(comp));
  emit("/4\n");
  emit_stage_hash(W,4);

  // ---------- C5: recovery (re-teach absent sleepers) ----------
  emit("PHASE C5\n");
  let fl0:i32=count_rel(W,99);
  let ea0:i32=count_rel(W,30);
  let reops:i32=0;
  if(find_key(W,64,40,20)<0){ learn(W,40,20,4); reops=reops+1; }
  if(find_key(W,64,41,20)<0){ learn(W,41,20,9); reops=reops+1; }
  if(find_key(W,64,42,20)<0){ learn(W,42,20,2); reops=reops+1; }
  if(find_key(W,64,43,20)<0){ learn(W,43,20,7); reops=reops+1; }
  if(find_key(W,64,44,20)<0){ learn(W,44,20,5); reops=reops+1; }
  if(find_key(W,64,45,20)<0){ learn(W,45,20,1); reops=reops+1; }
  if(find_key(W,64,46,20)<0){ learn(W,46,20,8); reops=reops+1; }
  if(find_key(W,64,47,20)<0){ learn(W,47,20,3); reops=reops+1; }
  if(find_key(W,64,48,20)<0){ learn(W,48,20,6); reops=reops+1; }
  if(find_key(W,64,49,20)<0){ learn(W,49,20,0); reops=reops+1; }
  emit("C5_RELEARN_OPS ");
  emit(i32s(reops));
  emit("\n");
  emit("C5_FLOOD_VICTIMS ");
  emit(i32s(fl0-count_rel(W,99)));
  emit("\n");
  emit("C5_EARNED_VICTIMS ");
  emit(i32s(ea0-count_rel(W,30)));
  emit("\n");
  let comp2:i32=0;
  comp2=comp2+twohop(W,40,20,4,3,10,2,1);
  comp2=comp2+twohop(W,41,20,9,1,10,4,1);
  comp2=comp2+twohop(W,42,20,2,6,10,8,-1);
  comp2=comp2+twohop(W,43,20,7,9,10,1,1);
  emit("C5_COMP_RECOV ");
  emit(i32s(comp2));
  emit("/4\n");
  emit_stage_hash(W,5);

  // ---------- C6: final probe ----------
  emit("PHASE C6\n");
  let fr:i32=0;
  if(query(W,1,10,4)==4){ fr=fr+1; }
  if(query(W,1,11,5)==5){ fr=fr+1; }
  if(query(W,2,10,4)==4){ fr=fr+1; }
  if(query(W,2,12,1)==1){ fr=fr+1; }
  if(query(W,3,10,2)==2){ fr=fr+1; }
  if(query(W,4,12,2)==2){ fr=fr+1; }
  if(query(W,5,11,2)==2){ fr=fr+1; }
  if(query(W,6,10,8)==8){ fr=fr+1; }
  if(query(W,7,10,3)==3){ fr=fr+1; }
  if(query(W,8,12,5)==5){ fr=fr+1; }
  if(query(W,9,10,1)==1){ fr=fr+1; }
  if(query(W,9,11,7)==7){ fr=fr+1; }
  emit("C6_FOUND_FINAL ");
  emit(i32s(fr));
  emit("/12\n");
  let er:i32=0;
  let b:i32=10;
  while(b<20){ if(query(W,b,30,b)==b){ er=er+1; } b=b+1; }
  emit("C6_EARNED_FINAL ");
  emit(i32s(er));
  emit("/10\n");
  emit("C6_FLOOD ");
  emit(i32s(count_rel(W,99)));
  emit("\n");
  emit("FOUND_EVICT ");
  emit(i32s(get32(W,8)));
  emit("\n");
  emit_stage_hash(W,6);
  emit("=== CHURN-REVISION COMPLETE ===\n");
  return 0;
}

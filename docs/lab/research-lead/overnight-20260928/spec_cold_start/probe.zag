// probe.zag -- seed probe for SPEC-COLD-START (design tooling).
// NOT the experiment. Replicates ONLY the pre-shift arrival process
// (seeded LCG + burst/quiet Markov + fire thresholds, ticks 0..127)
// for candidate (R,M1,N1,M2,N2) tuples and prints arrival counts.
// Purpose: select R values with D32 == 0 (zero drifts in ticks
// 0..31). Rationale, derived from the inherited margin test
// (nr_decide): with (dh,ed) = (0,0) the price interval degenerates
// to {0}, and any L >= 1 is then eager-decisive (L*1 > 0) -- a
// zero-data eager commit at e = 32. D32 == 0 guarantees
// (dh,ed) = (0,0) at e = 32 (df = 0 every tick implies dh = 0 and
// ed = 0 exactly), so the quirk fires on the selected cells by
// construction. This is the INVERSE of the parent lane's probe
// (which excluded D32 == 0 to keep the quirk out); here the quirk
// is the object of study.
// One control cell (CS3) uses D32 >= 1 on the same regime tuple as
// CS1, so the guard arm can be checked for zero behavioral change
// when drift data exists at e = 32.
// This probe examines arrival counts ONLY: no EWMA, no margin test,
// no commits, no flips, no costs. Selection rule (frozen here):
// CS0 (16,16->16,16): lowest R in 20..49 with D32 == 0;
// CS1 (16,16->1,16):  lowest R in 50..79 with D32 == 0;
// CS2 (16,16->16,1):  lowest R in 80..109 with D32 == 0;
// CS3 (16,16->1,16):  lowest R in 120..149 with D32 >= 1.
// Ranges are disjoint so the four R values are distinct (CELL lines
// are keyed by R). Pure Zag, safebin-built with the pinned znc.
fn nr_next(s:i64)i64 {
  let r:i64=s*1103515245+12345;
  let q:i64=r/2147483648;
  return r-q*2147483648;
}
fn nr_thr_b(M:i32)i64 {
  let C:i64=2147483648;
  let t:i64=(5*C)/(2*(M as i64));
  if(t>C){ return C; }
  return t;
}
fn nr_thr_q(M:i32,tb:i64)i64 {
  let C:i64=2147483648;
  let t:i64=((4*C)/(M as i64)-tb)/3;
  if(t<0){ return 0; }
  return t;
}
fn rc_seed_d(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*101+N1*17+M2*13+N2*7+17) as i64;
}
fn rc_seed_q(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*17+N1*101+M2*7+N2*13+917) as i64;
}
fn probe_tuple(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i32 {
  let s1:i64=rc_seed_d(R,M1,N1,M2,N2);
  let s2:i64=rc_seed_q(R,M1,N1,M2,N2);
  let ds:i32=0;
  let qs:i32=0;
  let TPB:i64=nr_thr_b(M1);
  let TPQ:i64=nr_thr_q(M1,TPB);
  let TQB:i64=nr_thr_b(N1);
  let TQQ:i64=nr_thr_q(N1,TQB);
  let C31:i64=2147483648;
  let TSB:i64=C31/8;
  let TSQ:i64=C31/24;
  let d32:i32=0;
  let q32:i32=0;
  let dpre:i32=0;
  let qpre:i32=0;
  let t:i32=0;
  while(t<128){
    s1=nr_next(s1);
    let u1:i64=s1;
    let nds:i32=ds;
    if(ds==1 && u1<TSB){ nds=0; }
    if(ds==0 && u1<TSQ){ nds=1; }
    ds=nds;
    s1=nr_next(s1);
    let u2:i64=s1;
    let df:i32=0;
    if(ds==1 && u2<TPB){ df=1; }
    if(ds==0 && u2<TPQ){ df=1; }
    s2=nr_next(s2);
    let u3:i64=s2;
    let nqs:i32=qs;
    if(qs==1 && u3<TSB){ nqs=0; }
    if(qs==0 && u3<TSQ){ nqs=1; }
    qs=nqs;
    s2=nr_next(s2);
    let u4:i64=s2;
    let qf:i32=0;
    if(qs==1 && u4<TQB){ qf=1; }
    if(qs==0 && u4<TQQ){ qf=1; }
    dpre=dpre+df;
    qpre=qpre+qf;
    if(t<32){
      d32=d32+df;
      q32=q32+qf;
    }
    t=t+1;
  }
  c=o_app(B,c,"PROBE R=");
  c=o_i64(B,c,R as i64);
  c=o_app(B,c," M1=");
  c=o_i64(B,c,M1 as i64);
  c=o_app(B,c," N1=");
  c=o_i64(B,c,N1 as i64);
  c=o_app(B,c," M2=");
  c=o_i64(B,c,M2 as i64);
  c=o_app(B,c," N2=");
  c=o_i64(B,c,N2 as i64);
  c=o_app(B,c," D32=");
  c=o_i64(B,c,d32 as i64);
  c=o_app(B,c," Q32=");
  c=o_i64(B,c,q32 as i64);
  c=o_app(B,c," Dpre=");
  c=o_i64(B,c,dpre as i64);
  c=o_app(B,c," Qpre=");
  c=o_i64(B,c,qpre as i64);
  c=o_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let R:i32=20;
  while(R<50){
    c=probe_tuple(B,c,R,16,16,16,16);
    R=R+1;
  }
  R=50;
  while(R<80){
    c=probe_tuple(B,c,R,16,16,1,16);
    R=R+1;
  }
  R=80;
  while(R<110){
    c=probe_tuple(B,c,R,16,16,16,1);
    R=R+1;
  }
  R=120;
  while(R<150){
    c=probe_tuple(B,c,R,16,16,1,16);
    R=R+1;
  }
  o_flush(B,c);
  return 0;
}

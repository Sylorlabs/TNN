// c3_base.zag -- base for the cogops-3way battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the three researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE), vfy_gen (id 1, VERIFY),
// cnt_gen (id 4, COUNT).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// Distinct-object count: for each subject in sb[so..], scans ALL facts
// and collects distinct objects o with (subj, rel, o). Returns the
// distinct count. Cost = nsubs * nfacts fact checks (dedup compares
// not counted). seen: scratch [nseen, objs...], reset on entry.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let nf:i32=get32(A,0);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<64){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// rb_world.zag -- tiny world + drift constructors for SPEC-RELATIONBLIND.
// ALL world literals live in this file. rb_main.zag reaches them only
// through the rb_* accessors below; rb_fix.zag contains none.
// fact_add / world_new come from da_base.zag (same assembly).
fn rb_rel_a()i32 { return 901; }
fn rb_rel_b()i32 { return 902; }
fn rb_subj1()i32 { return 1; }
fn rb_subj2()i32 { return 2; }
fn rb_subj3()i32 { return 3; }
fn rb_obj_a1()i32 { return 10; }
fn rb_obj_a2()i32 { return 20; }
fn rb_obj_b1()i32 { return 30; }
fn rb_obj_b2()i32 { return 40; }
// Tiny world: slot 0: (1,901,10); slot 1: (2,901,20);
// slot 2: (1,902,30); slot 3: (3,902,40).
fn rb_setup(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,1,901,10);
  fact_add(A,2,901,20);
  fact_add(A,1,902,30);
  fact_add(A,3,902,40);
  return;
}
// D1 drift: change ONLY the relation field at slot 0 (901 -> 902).
// No index shift, no deletion, same fact count. This isolates
// relation-blindness from positional staleness.
fn rb_drift_relswap(A:[]u8)void {
  set32(A,4+0*12+4,902);
  return;
}
// D3 drift (t14 analog): rebuild the world with the 901 facts deleted.
// Stale buckets built on the 4-fact world keep indices {0,1} for 901,
// which now address 902 facts.
fn rb_drift_deletion(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,1,902,10);
  fact_add(A,3,902,40);
  return;
}
// et_world.zag -- world-epoch management + epoch-bumping drifts for
// SPEC-EPOCHTAG. The world arena (da_base.zag) uses offset 0 for the fact
// count and 4..772 for the 64 fact slots (12 bytes each); offset 772 is
// verified free. The epoch is a property of the world: every drift bumps
// it, so a spec call can compare the live epoch against the tag stamped
// at specialization time. Base world setup (rb_setup) and the D1/D3 drifts
// (rb_drift_relswap, rb_drift_deletion) are reused unmodified from
// rb_world.zag (SPEC-RELATIONBLIND lane); only the new E1 drift's literal
// lives here.
// World epoch accessors.
fn et_epoch_get(A:[]u8)i32 { return get32(A,772); }
fn et_epoch_bump(A:[]u8)void {
  set32(A,772,get32(A,772)+1);
  return;
}
// E1 drift: change ONLY slot 2's object (30 -> 31). Slot 2 holds a
// relation-902 fact that no query in this lane touches, so every correct
// answer is unchanged; only the world epoch moves (0 -> 1). This isolates
// the conservative-refusal cost: refusal must fire on world identity, not
// on answer-affecting change.
fn et_obj_b1_alt()i32 { return 31; }
fn et_drift_unrelated(A:[]u8)void {
  set32(A,4+2*12+8,et_obj_b1_alt());
  et_epoch_bump(A);
  return;
}
// Epoch-bumping wrappers around the relationblind drifts.
fn et_drift_relswap(A:[]u8)void {
  rb_drift_relswap(A);
  et_epoch_bump(A);
  return;
}
fn et_drift_deletion(A:[]u8)void {
  rb_drift_deletion(A);
  et_epoch_bump(A);
  return;
}
// ib_module.zag -- ported contract ops for INTEGRATION-B1B2.
//
// Verbatim port of four of the five ops of C443's frozen u_* module
// (subsumption_p0/sp_module.zag, itself byte-copied from C424's
// cu_full.zag lines 55-389): u_induct, u_check, u_invalidate,
// u_revise, plus their helpers. u_grow is EXCLUDED per the minimal
// port (B1/B2 only; grow was not exercised even in C424).
// Function bodies are byte-identical to the source; only this header
// and the sg/ss helpers (carried from sp_base.zag) are added.
//
// The module operates on the dedicated judgment-state array S with
// the frozen fixed slots: judgment table 300-302 / 304+ / 528+,
// global counters 900-925, induct scratch 1200-1209, C_Q at slot 7.
// Contract layout at cbase: +0 CONTRACT_TY, +1 CONTRACT_SET,
// +2 NFIELDS, +3 NCLAUSES, +4+i*8 clause i:
// field,xform,k,lo,hi,active,dc,spare.
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
//
// In this lane the module governs the composer's binding layer:
// one binding contract per need tag over [tag, fam] (nf=2) at
// 2000+bi*100 (B1), and one coverage contract per procedure family
// over [rel] (nf=1) at 3000/3100/3200 (B2).
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn u_feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==3){return 1;} if(p==5){return 1;}
  if(p==7){return 1;} if(p==9){return 1;}
  return 2;
}
fn u_feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  return 32;
}
fn u_feat_val(v:i32,p:i32)i32 {
  let xf:i32=u_feat_xf(p);
  let k:i32=u_feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn u_fval(f:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(f==0){return f0;}
  if(f==1){return f1;}
  if(f==2){return f2;}
  if(f==3){return f3;}
  if(f==4){return f4;}
  return f5;
}
fn u_acc(S:[]u8,j:i32,f:i32)i32 { return sg(S,304+j*7+1+f); }
fn u_rej(S:[]u8,j:i32,f:i32)i32 { return sg(S,528+j*7+1+f); }
fn u_rejlen(S:[]u8,j:i32)i32 { return sg(S,528+j*7); }

// check: 1 iff nf matches and at least one active clause holds and
// every active clause holds; 0 otherwise (empty active set judges 0).
fn u_check(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let any:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      any=1;
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let lo:i32=sg(S,b+3);
      let hi:i32=sg(S,b+4);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<lo){return 0;}
      if(v>hi){return 0;}
    }
    i=i+1;
  }
  if(any==0){return 0;}
  return 1;
}

// check_all: same but over all committed clauses (ignores active).
fn u_check_all(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

fn u_write_clause(S:[]u8,cbase:i32,i:i32,f:i32,p:i32,mn:i32,mx:i32)void {
  let b:i32=cbase+4+i*8;
  ss(S,b,f); ss(S,b+1,u_feat_xf(p)); ss(S,b+2,u_feat_k(p));
  ss(S,b+3,mn); ss(S,b+4,mx); ss(S,b+5,1); ss(S,b+6,0); ss(S,b+7,0);
  return;
}

// errors of the committed clause set on the judgment table.
fn u_fiterr(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  let err:i32=0;
  let j:i32=0;
  while(j<na){
    if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    if(u_rejlen(S,r)==nf){
      if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
    }
    r=r+1;
  }
  return err;
}

// induct: minimal-commitment search. Increasing cardinality (1, then
// 2); valid = conjunction rejects every in-scope reject (len ==
// nf); among valid sets prefer fewer clauses, then maximal total
// accept-region width (least committal), then lexicographic order.
fn u_induct(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  if(na==0){return 0;}
  if(nf<1){return 0;}
  ss(S,1200,-1); ss(S,1201,-1); ss(S,1202,0); ss(S,1203,0);
  ss(S,1204,-1); ss(S,1205,0);
  ss(S,1206,-1); ss(S,1207,-1); ss(S,1208,0); ss(S,1209,0);
  let f:i32=0;
  while(f<nf){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<na){
        let fv:i32=u_feat_val(u_acc(S,j,f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      let valid:i32=1;
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          let fv2:i32=u_feat_val(u_rej(S,r,f),p);
          if(fv2>=mn){
            if(fv2<=mx){valid=0;}
          }
        }
        r=r+1;
      }
      if(valid==1){
        let w:i32=mx-mn;
        if(w>sg(S,1204)){
          ss(S,1204,w); ss(S,1200,f); ss(S,1201,p);
          ss(S,1202,mn); ss(S,1203,mx); ss(S,1205,1);
        }
      }
      p=p+1;
    }
    f=f+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,1);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  ss(S,1204,-1); ss(S,1205,0);
  let np:i32=nf*11;
  let a:i32=0;
  while(a<np){
    let bb:i32=a+1;
    while(bb<np){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=bb/11; let pb:i32=bb-fb*11;
      let mn0:i32=999999999; let mx0:i32=-999999999;
      let mn1:i32=999999999; let mx1:i32=-999999999;
      let j2:i32=0;
      while(j2<na){
        let v0:i32=u_feat_val(u_acc(S,j2,fa),pa);
        if(v0<mn0){mn0=v0;}
        if(v0>mx0){mx0=v0;}
        let v1:i32=u_feat_val(u_acc(S,j2,fb),pb);
        if(v1<mn1){mn1=v1;}
        if(v1>mx1){mx1=v1;}
        j2=j2+1;
      }
      let valid2:i32=1;
      let r2:i32=0;
      while(r2<nr){
        if(u_rejlen(S,r2)==nf){
          let h0:i32=0;
          let h1:i32=0;
          let w0:i32=u_feat_val(u_rej(S,r2,fa),pa);
          if(w0<mn0){h0=1;}
          if(w0>mx0){h0=1;}
          let w1:i32=u_feat_val(u_rej(S,r2,fb),pb);
          if(w1<mn1){h1=1;}
          if(w1>mx1){h1=1;}
          if(h0==0){
            if(h1==0){valid2=0;}
          }
        }
        r2=r2+1;
      }
      if(valid2==1){
        let wsum:i32=(mx0-mn0)+(mx1-mn1);
        if(wsum>sg(S,1204)){
          ss(S,1204,wsum);
          ss(S,1200,fa); ss(S,1201,pa); ss(S,1202,mn0); ss(S,1203,mx0);
          ss(S,1206,fb); ss(S,1207,pb); ss(S,1208,mn1); ss(S,1209,mx1);
          ss(S,1205,1);
        }
      }
      bb=bb+1;
    }
    a=a+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    u_write_clause(S,cbase,1,sg(S,1206),sg(S,1207),sg(S,1208),sg(S,1209));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,2);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  return 0;
}
// invalidate: compare judgment vs consequence. Failure bumps the
// contract fail run and every active clause's disconfirmation
// counter; a clause reaching 2 consecutive disconfirmations is
// retired. Three consecutive failures latch the revision request.
fn u_invalidate(S:[]u8,cbase:i32,judgment:i32,consequence:i32)i32 {
  let ok:i32=0;
  if(judgment==consequence){ok=1;}
  ss(S,916,sg(S,916)+1);
  if(ok==1){ ss(S,912,sg(S,912)+1); }
  if(sg(S,cbase+1)==1){
    if(ok==1){
      ss(S,900,0);
      let n:i32=sg(S,cbase+3);
      let i:i32=0;
      while(i<n){
        let b:i32=cbase+4+i*8;
        if(sg(S,b+5)==1){ ss(S,b+6,0); }
        i=i+1;
      }
    }
    if(ok==0){
      ss(S,900,sg(S,900)+1);
      let n2:i32=sg(S,cbase+3);
      let i2:i32=0;
      while(i2<n2){
        let b2:i32=cbase+4+i2*8;
        if(sg(S,b2+5)==1){
          let dc:i32=sg(S,b2+6)+1;
          ss(S,b2+6,dc);
          if(dc>=2){ ss(S,b2+5,0); }
        }
        i2=i2+1;
      }
      if(sg(S,900)>=3){
        if(sg(S,901)==0){
          ss(S,901,1);
          if(sg(S,908)<0){ ss(S,908,sg(S,7)); }
        }
      }
    }
  }
  return ok;
}

// revise: on a latched request (and enable), score the committed
// clause set on the judgment table, re-induct, count the revision.
fn u_revise(S:[]u8,cbase:i32,enabled:i32)void {
  if(sg(S,901)==1){
    if(enabled==1){
      let nf:i32=sg(S,300);
      let na:i32=sg(S,301);
      let nr:i32=sg(S,302);
      let err:i32=0;
      let j:i32=0;
      while(j<na){
        if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
        j=j+1;
      }
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
        }
        r=r+1;
      }
      ss(S,924,err);
      let ui2:i32=u_induct(S,cbase);
      ss(S,904,sg(S,904)+1);
      let ui2b:i32=ui2;
      ss(S,925,ui2b);
      ss(S,901,0);
      ss(S,900,0);
    }
  }
  return;
}

// ib_learn.zag -- learner-owned procedures and learner-driven composition
// with the C443 B1/B2 contracts integrated at the binding layer.
//
// Base: COGOPS-DIAMOND's c4_learn.zag (diamond plans, topo assembly,
// procedure bodies, oracles unchanged). The integration changes:
// (B1) the BIND trial-count table is replaced by per-tag admission
// contracts over [tag, fam] (u_induct from trial outcomes, u_check
// for routing, u_invalidate/u_revise for revision); L+12744 is now a
// tag directory and the bindings live at 2000+bi*100 in the judgment
// state S. (B2) version selection consults coverage admission
// contracts over [rel] at 3000/3100/3200 (inducted at specialize
// time from episode-logged relations vs the world rel vocabulary)
// instead of the coverage-membership tests.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   Tag directory at 12744: 8 entries x 4 bytes (need tag per slot).
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
// Judgment-state S (16384 bytes, separate array): the u_* module's
// fixed slots (judgment table 300-302/304+/528+, counters 900-925,
// induct scratch 1200-1209, C_Q at 7); binding contracts at
// 2000+bi*100; coverage contracts at 3000 (RET), 3100 (VFY),
// 3200 (CNT).
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, goal records, and contract/vocab reads.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8,S:[]u8)void { set32(L,0,0); ss(S,3000+1,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8,S:[]u8)void { set32(L,4248,0); ss(S,3100+1,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8,S:[]u8)void { set32(L,8496,0); ss(S,3200+1,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  cov_induct(S,A,3000,L,0,4);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  cov_induct(S,A,3100,L,4248,4252);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  cov_induct(S,A,3200,L,8496,8500);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects. Returns -1 if the relation is outside the
// learned coverage.
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from coverage ADMISSION CONTRACTS ----
// ---- (B2): the contract, not the membership test, decides. ----
// RET coverage contract at 3000; VFY at 3100; CNT at 3200.
fn ret_version(L:[]u8,S:[]u8,rel:i32)i32 {
  if(u_check(S,3000,1,rel,0,0,0,0,0)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,S:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(u_check(S,3100,1,r,0,0,0,0,0)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,S:[]u8,rel:i32)i32 {
  if(u_check(S,3200,1,rel,0,0,0,0,0)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 3) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED (preregistered, Section 2.4): subjects from ALL incoming
// kind-3 links concatenate in goal-record link order into SUBL[ni*128].
// On a chain (one incoming kind-3 link) this is byte-identical to the
// C422 behavior; on a diamond (two or more sources) it is the generic
// fan-in reading. No goal-shape test, no branch count: the same link
// kind applies uniformly to any DAG.
// Returns 1 if at least one kind-3 link targeted ni, else 0.
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*160);
        let k:i32=0;
        while(k<n){
          set32(SUBL,ni*128+4+tot*4,get32(OUTS,sn*160+4+k*4));
          tot=tot+1;
          k=k+1;
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*128,tot);
    return 1;
  }
  return 0;
}
// ---- binding contracts (B1): trial-learned bindings as per-tag ----
// ---- admission contracts. L+12744 is a tag directory (8 x 4 bytes);
// ---- the binding itself is the contract at 2000+bi*100 in S over
// ---- [tag, fam] (nf=2), inducted from trial outcomes, revisable via
// ---- u_invalidate / u_revise. ----
fn bind_off(bi:i32)i32 { return 12744+bi*4; }
fn bind_cb(bi:i32)i32 { return 2000+bi*100; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_committed(S:[]u8,bi:i32)i32 { return sg(S,bind_cb(bi)+1); }
// The bound family, read through the admission contract: the first
// fam admitted by u_check wins; -1 when the contract abstains
// (never inducted, or all clauses retired).
fn bind_fam(L:[]u8,S:[]u8,tag:i32)i32 {
  let bi:i32=bind_find(L,tag);
  if(bi<0){ return -1; }
  let cb:i32=bind_cb(bi);
  let fam:i32=0;
  while(fam<3){
    if(u_check(S,cb,2,tag,fam,0,0,0,0)==1){ return fam; }
    fam=fam+1;
  }
  return -1;
}
// ---- judgment-table loaders ----
// Accept row (len 2): [tag, fam] at 304+j*7. Reject row at 528+r*7.
fn jt_acc2(S:[]u8,j:i32,tag:i32,fam:i32)void {
  ss(S,304+j*7,2);
  ss(S,304+j*7+1,tag);
  ss(S,304+j*7+2,fam);
  return;
}
fn jt_rej2(S:[]u8,r:i32,tag:i32,fam:i32)void {
  ss(S,528+r*7,2);
  ss(S,528+r*7+1,tag);
  ss(S,528+r*7+2,fam);
  return;
}
// Load a coverage table (nf=1): accepts and rejects are rel-id lists.
fn jt_load_cov(S:[]u8,acc:[]u8,na:i32,rej:[]u8,nr:i32)void {
  ss(S,300,1); ss(S,301,na); ss(S,302,nr);
  let j:i32=0;
  while(j<na){
    ss(S,304+j*7,1);
    ss(S,304+j*7+1,get32(acc,j*4));
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    ss(S,528+r*7,1);
    ss(S,528+r*7+1,get32(rej,r*4));
    r=r+1;
  }
  return;
}
// ---- world relation vocabulary: distinct rel ids in fact order ----
// Generic observation machinery: no literals, no world knowledge.
fn vocab_scan(A:[]u8,out:[]u8)i32 {
  let n:i32=0;
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let k:i32=0;
    let seen:i32=0;
    while(k<n){
      if(get32(out,k*4)==r){ seen=1; }
      k=k+1;
    }
    if(seen==0){
      if(n<16){
        set32(out,n*4,r);
        n=n+1;
      }
    }
    j=j+1;
  }
  return n;
}
// First object observed with relation rel in the world (-1 if none).
fn first_obj(A:[]u8,rel:i32)i32 {
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    if(get32(A,4+j*12+4)==rel){ return get32(A,4+j*12+8); }
    j=j+1;
  }
  return -1;
}
// First subject observed with relation rel in the world (-1 if none).
// Generic observation machinery (subject analog of first_obj); no
// literals, no world knowledge. Ported from INTEGRATION-STRESS.
fn first_subj(A:[]u8,rel:i32)i32 {
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    if(get32(A,4+j*12+4)==rel){ return get32(A,4+j*12); }
    j=j+1;
  }
  return -1;
}
// ---- coverage induct (B2): accepts = the episode-logged relations ----
// ---- at L+rels_off (count at L+nrel_off); rejects = the current ----
// ---- world's relation vocabulary minus the accepts. ----
fn cov_induct(S:[]u8,A:[]u8,cbase:i32,L:[]u8,nrel_off:i32,rels_off:i32)void {
  let n:i32=get32(L,nrel_off);
  let vb:[]u8=z_alloc(64);
  let nv:i32=vocab_scan(A,vb);
  let rj:[]u8=z_alloc(64);
  let nr:i32=0;
  let v:i32=0;
  while(v<nv){
    let rv:i32=get32(vb,v*4);
    let a:i32=0;
    let hit:i32=0;
    while(a<n){
      if(get32(L,rels_off+a*4)==rv){ hit=1; }
      a=a+1;
    }
    if(hit==0){
      set32(rj,nr*4,rv);
      nr=nr+1;
    }
    v=v+1;
  }
  let ac:[]u8=z_alloc(64);
  let a2:i32=0;
  while(a2<n){
    set32(ac,a2*4,get32(L,rels_off+a2*4));
    a2=a2+1;
  }
  jt_load_cov(S,ac,n,rj,nr);
  // SELFTRIG: revise-on-retire. If the contract was previously
  // committed but every clause is retired, the fresh table is a
  // REVISION (not a fresh induct): ensure the revision request is
  // latched (it originates from live-path failures) and revise.
  // Otherwise induct as before. Fresh and healthy contracts take
  // the u_induct path exactly as in C455.
  let wasc:i32=sg(S,cbase+1);
  let anyact:i32=0;
  let nc:i32=sg(S,cbase+3);
  let ci:i32=0;
  while(ci<nc){
    if(sg(S,cbase+4+ci*8+5)==1){ anyact=1; }
    ci=ci+1;
  }
  let retired:i32=0;
  if(wasc==1){ if(anyact==0){ retired=1; } }
  if(retired==1){
    if(sg(S,901)==0){ ss(S,901,1); }
    u_revise(S,cbase,1);
    return;
  }
  u_induct(S,cbase);
  return;
}
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Trials run as before (same try_family calls, same trials stat);
// then ONE admission contract per tag is inducted from the trial
// outcomes (B1). Returns 1 iff every need tag ends bound; 0 if any
// need is unbindable (contract abstention -> decline).
fn learn_bindings(L:[]u8,S:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_committed(S,bi)==0){
      let r0:i32=0;
      let r1:i32=0;
      let r2:i32=0;
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        if(fam==0){ r0=r; }
        if(fam==1){ r1=r; }
        if(fam==2){ r2=r; }
        fam=fam+1;
      }
      ss(S,300,2);
      let na:i32=0;
      if(r0==1){ jt_acc2(S,na,tag,0); na=na+1; }
      if(r1==1){ jt_acc2(S,na,tag,1); na=na+1; }
      if(r2==1){ jt_acc2(S,na,tag,2); na=na+1; }
      ss(S,301,na);
      let nr:i32=0;
      if(r0==0){ jt_rej2(S,nr,tag,0); nr=nr+1; }
      if(r1==0){ jt_rej2(S,nr,tag,1); nr=nr+1; }
      if(r2==0){ jt_rej2(S,nr,tag,2); nr=nr+1; }
      ss(S,302,nr);
      u_induct(S,bind_cb(bi));
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    if(bind_fam(L,S,need_tag(G,m))<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_new(L:[]u8,S:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){
      let nn:i32=g_nneeds(G);
      set32(L,13000+pi*56,gtag);
      set32(L,13000+pi*56+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        set32(L,13000+pi*56+8+p*12,ni);
        set32(L,13000+pi*56+8+p*12+4,tag);
        set32(L,13000+pi*56+8+p*12+8,bind_fam(L,S,tag));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1,idx2,tag2,fam2,idx3,tag3,fam3]
// into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)!=0){
      let k:i32=0;
      while(k<14){
        set32(out,k*4,get32(L,13000+pi*56+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,13000+pi*56,0); pi=pi+1; }
  return;
}
fn clear_bindings(L:[]u8,S:[]u8)void {
  let bi:i32=0;
  while(bi<8){
    set32(L,bind_off(bi),0);
    ss(S,bind_cb(bi)+1,0);
    bi=bi+1;
  }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,S:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,S,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        // SELFTRIG trigger A: spec refusal. The contract admitted
        // the rel (judgment=1) but the procedure refused (-1,
        // consequence=0): invalidate the RET coverage contract and
        // fall back to generic so the query stays live.
        let sc0:i32=ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
        if(sc0<0){
          u_invalidate(S,3000,1,0);
          set32(L,13256,get32(L,13256)+1);
          ret_gen(A,rel,obj,K,0,OUTS,ni*160);
        }
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,S,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){
          vv=vfy_spec(L,A,tmpc,K,0);
          if(vv<0){
            u_invalidate(S,3100,1,0);
            set32(L,13264,get32(L,13264)+1);
            vv=vfy_gen(A,tmpc,K,0);
          }
        }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){
            vv2=vfy_spec(L,A,tmpc,K,0);
            if(vv2<0){
              u_invalidate(S,3100,1,0);
              set32(L,13264,get32(L,13264)+1);
              vv2=vfy_gen(A,tmpc,K,0);
            }
          }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*80+4);
      let ver3:i32=cnt_version(L,S,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
      let ns3:i32=0;
      if(has3==1){ ns3=get32(SUBL,ni*128); }
      if(has3==0){
        set32(SUBL,ni*128,1);
        set32(SUBL,ni*128+4,get32(W,ni*80+12));
        ns3=1;
      }
      let cc:i32=0;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
        if(cc<0){
          u_invalidate(S,3200,1,0);
          set32(L,13272,get32(L,13272)+1);
          cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
        }
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,cc);
      ans_append_rec(ans,OUTS,ni);
    }
    p=p+1;
  }
  return;
}
// ---- note_answer_disagree: SELFTRIG trigger B. Called from the ----
// ---- live per-query path (do_query) when the learner's answer ----
// ---- disagreed with the independent oracle and spec versions were ----
// ---- used. The composer cannot attribute a joint-answer ----
// ---- disagreement to one family from the answer record alone, so ----
// ---- it distrusts every spec commitment that contributed: one ----
// ---- u_invalidate per spec-routing family (judgment=1: the spec ----
// ---- routing was sound; consequence=0: the answer was wrong). ----
// ---- Emits the RETRY line with per-family disconfirmation counts, ----
// ---- clause activity, the latched request, and first-detect clock.
fn note_answer_disagree(b:[]u8,c:i32,S:[]u8,vbuf:[]u8,att:i32)i32 {
  let nn:i32=get32(vbuf,16);
  let p:i32=0;
  let f0:i32=0;
  let f1:i32=0;
  let f2:i32=0;
  while(p<nn){
    let v:i32=get32(vbuf,p*4);
    if(v==2){ f0=1; }
    if(v==3){ f1=1; }
    if(v==5){ f2=1; }
    p=p+1;
  }
  if(f0==1){ u_invalidate(S,3000,1,0); }
  if(f1==1){ u_invalidate(S,3100,1,0); }
  if(f2==1){ u_invalidate(S,3200,1,0); }
  c=o_app(b,c,"RETRY att=");
  c=o_i64(b,c,att as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,3010) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3110) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3210) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,3009) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3109) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3209) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
// ---- COMBINED plan-invalidation hook (M3). Plans cache the bound ----
// ---- fam per need at build time (IS-D finding: a binding revision ----
// ---- leaves cached plans stale). On a plan-table hit, every cached ----
// ---- fam is re-validated against the live binding contract before ----
// ---- the plan loads. bind_fam is read-only (u_check mutates ----
// ---- nothing), so this check cannot perturb contract state. On the ----
// ---- first mismatch the plan is stale: its slot is zeroed, the ----
// ---- telemetry cells (L+13276 count; L+13280..13296 gtag, need, ----
// ---- tag, oldfam, newfam) are stashed for do_query to report, and ----
// ---- the miss path rebuilds. A coverage (B2) revision never trips ----
// ---- this hook: it changes spec/generic routing, not bound fams. ----
fn compose(L:[]u8,S:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi>=0){
    let nn2:i32=get32(L,13000+pi*56+4);
    let hp:i32=0;
    let stale:i32=0;
    let hneed:i32=0;
    let htag:i32=0;
    let hold:i32=0;
    let hnew:i32=0;
    while(hp<nn2){
      if(stale==0){
        let ptag:i32=get32(L,13000+pi*56+8+hp*12+4);
        let pfam:i32=get32(L,13000+pi*56+8+hp*12+8);
        let live:i32=bind_fam(L,S,ptag);
        if(live!=pfam){
          stale=1;
          hneed=hp;
          htag=ptag;
          hold=pfam;
          hnew=live;
        }
      }
      hp=hp+1;
    }
    if(stale==1){
      set32(L,13000+pi*56,0);
      set32(L,13276,get32(L,13276)+1);
      set32(L,13280,gt);
      set32(L,13284,hneed);
      set32(L,13288,htag);
      set32(L,13292,hold);
      set32(L,13296,hnew);
      pi=-1;
    }
  }
  if(pi<0){
    let ok:i32=learn_bindings(L,S,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,S,gt,G,ord);
    execute_plan(L,S,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,S,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
  return 1;
}
// ---- attr_cov_ret: coverage evidence for one RET step ----
// Re-runs the learned spec and the generic on identical (rel,obj).
// Returns 1 when the spec refuses or diverges from the generic
// (the learned state is at fault), 0 when they agree. Scratch
// buffers only; contracts, plans, and the world are only read.
fn attr_cov_ret(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8)i32 {
  let O2:[]u8=z_alloc(512);
  let OG:[]u8=z_alloc(512);
  let rs:i32=ret_spec(L,A,rel,obj,kb,0,O2,0);
  if(rs<0){ return 1; }
  let rg:i32=ret_gen(A,rel,obj,kb,0,OG,0);
  if(rs!=rg){ return 1; }
  let q:i32=0;
  while(q<rs){
    if(get32(O2,4+q*4)!=get32(OG,4+q*4)){ return 1; }
    q=q+1;
  }
  return 0;
}
// ---- attr_cov_vfy: coverage evidence for one VERIFY step ----
fn attr_cov_vfy(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let vs:i32=vfy_spec(L,A,C,kb,0);
  if(vs<0){ return 1; }
  let vg:i32=vfy_gen(A,C,kb,0);
  if(vs!=vg){ return 1; }
  return 0;
}
// ---- attr_cov_cnt: coverage evidence for one COUNT step ----
fn attr_cov_cnt(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,ns:i32,kb:[]u8,seen:[]u8)i32 {
  let cs:i32=cnt_spec(L,A,rel,sb,so,ns,kb,0,seen);
  if(cs<0){ return 1; }
  let cg:i32=cnt_gen(A,rel,sb,so,ns,kb,0,seen);
  if(cs!=cg){ return 1; }
  return 0;
}
// ---- attr_cov_step: coverage evidence for one spec-using step ----
// Dispatches on the plan-cached family. Returns 1 on spec/generic
// divergence (or spec refusal), 0 on agreement. Fan-in steps
// (src>=0) are not evaluable here and return 0 (no evidence).
fn attr_cov_step(L:[]u8,S:[]u8,A:[]u8,G:[]u8,W:[]u8,ni:i32,F:i32,kb:[]u8,seen:[]u8)i32 {
  if(F==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    return attr_cov_ret(L,A,rel,obj,kb);
  }
  if(F==1){
    let src:i32=fanin_src(G,ni);
    if(src>=0){ return 0; }
    let C:[]u8=z_alloc(512);
    w_to_chain(W,ni,C,-1);
    return attr_cov_vfy(L,A,C,kb);
  }
  let rel3:i32=get32(W,ni*80+4);
  let SL:[]u8=z_alloc(512);
  let OZ:[]u8=z_alloc(512);
  let h3:i32=apply_kind3(G,OZ,SL,ni);
  if(h3==1){
    return attr_cov_cnt(L,A,rel3,SL,ni*128+4,get32(SL,ni*128),kb,seen);
  }
  set32(SL,ni*128,1);
  set32(SL,ni*128+4,get32(W,ni*80+12));
  return attr_cov_cnt(L,A,rel3,SL,ni*128+4,1,kb,seen);
}
// ---- attr_probe: learner-owned disagreement-attribution probe ----
// Called from do_query on learner-vs-oracle disagreement when spec
// versions were used (vbuf 2/3/5), BEFORE the blunt trigger-B
// invalidation. For each spec-using plan step it gathers two
// learner-owned evidence items: (1) fresh try_family trials vs the
// executing family (binding evidence); (2) the learned spec re-run
// vs the generic re-run on identical inputs (coverage evidence).
// Attribution: BIND if any step's executing family contradicts fresh
// trials (binding precedence: a misrouted family makes its spec
// output meaningless); else COV if any step's spec diverges from its
// generic; else IND. The probe never reads the harness trial-cause
// ledger, the oracle, or any staging label, and never mutates
// contracts or plans (bind_fam/u_check are read-only; re-runs use
// scratch buffers). It writes only telemetry cells S931 (cause),
// S933 (first cause), S934 (evb), S935 (evc), S936 (latch).
// A cause change across retries emits ATTR-MISMATCH.
// pmod=1: null probe (always BIND, no evidence), the guessing control.
fn attr_probe(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,G:[]u8,K:[]u8,vbuf:[]u8,seen:[]u8,pmod:i32)i32 {
  let t:i32=sg(S,930);
  if(pmod==1){
    c=o_app(b,c,"ATTR trial=");
    c=o_i64(b,c,t as i64);
    c=o_app(b,c," cause=BIND evb=0 evc=0 nspec=0 null=1");
    c=o_nl(b,c);
    ss(S,931,0); ss(S,934,0); ss(S,935,0);
    return c;
  }
  let pi:i32=plan_find(L,g_tag(G));
  let nn:i32=get32(vbuf,16);
  let evb:i32=0;
  let evc:i32=0;
  let nspec:i32=0;
  if(pi>=0){
    let tout:[]u8=z_alloc(160);
    let tmpc:[]u8=z_alloc(512);
    let seen2:[]u8=z_alloc(320);
    let kb:[]u8=z_alloc(64);
    let W2:[]u8=z_alloc(320);
    mat_inputs(G,W2);
    let p:i32=0;
    while(p<nn){
      let ver:i32=get32(vbuf,p*4);
      let ispec:i32=0;
      if(ver==2){ ispec=1; }
      if(ver==3){ ispec=1; }
      if(ver==5){ ispec=1; }
      if(ispec==1){
        nspec=nspec+1;
        let ni:i32=get32(L,13000+pi*56+8+p*12);
        let F:i32=get32(L,13000+pi*56+8+p*12+8);
        let T:i32=need_tag(G,ni);
        let tf0:i32=try_family(L,A,0,G,ni,K,tout,tmpc,seen);
        let tf1:i32=try_family(L,A,1,G,ni,K,tout,tmpc,seen);
        let tf2:i32=try_family(L,A,2,G,ni,K,tout,tmpc,seen);
        let tff:i32=tf0;
        if(F==1){ tff=tf1; }
        if(F==2){ tff=tf2; }
        let live:i32=bind_fam(L,S,T);
        let bindbad:i32=0;
        if(tff==0){ bindbad=1; }
        if(live>=0){
          if(live!=F){ bindbad=1; }
        }
        if(bindbad==1){ evb=1; }
        if(bindbad==0){
          let cb2:i32=attr_cov_step(L,S,A,G,W2,ni,F,kb,seen2);
          if(cb2==1){ evc=1; }
        }
      }
      p=p+1;
    }
  }
  let cause:i32=2;
  if(evb==1){ cause=0; }
  if(evb==0){
    if(evc==1){ cause=1; }
  }
  if(sg(S,936)==0){
    ss(S,936,1);
    ss(S,933,cause);
  }
  if(sg(S,933)!=cause){
    c=o_app(b,c,"ATTR-MISMATCH trial=");
    c=o_i64(b,c,t as i64);
    c=o_app(b,c," prev=");
    c=o_i64(b,c,sg(S,933) as i64);
    c=o_app(b,c," now=");
    c=o_i64(b,c,cause as i64);
    c=o_nl(b,c);
  }
  c=o_app(b,c,"ATTR trial=");
  c=o_i64(b,c,t as i64);
  c=o_app(b,c," cause=");
  if(cause==0){ c=o_app(b,c,"BIND"); }
  if(cause==1){ c=o_app(b,c,"COV"); }
  if(cause==2){ c=o_app(b,c,"IND"); }
  c=o_app(b,c," evb=");
  c=o_i64(b,c,evb as i64);
  c=o_app(b,c," evc=");
  c=o_i64(b,c,evc as i64);
  c=o_app(b,c," nspec=");
  c=o_i64(b,c,nspec as i64);
  c=o_nl(b,c);
  ss(S,931,cause);
  ss(S,934,evb);
  ss(S,935,evc);
  return c;
}
// rb_fix.zag -- experimental relation-revalidating variants of the
// learner-owned specialized procedures. These are EXACT copies of
// ret_spec / cnt_spec from da_learn.zag with one change: each bucketed
// slot revalidates the relation id (fr==rel) before its subject/object
// is used. Nesting depth is kept identical to the originals (match
// flags hoisted, body gated on the combined flag).
//
// These are experimental variants for the SPEC-RELATIONBLIND lane only.
// They are NOT merged into da_learn.zag. No world literals appear here:
// the relation arrives as the rel parameter.
// ret_spec_fix: ret_spec + relation revalidation.
fn ret_spec_fix(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    let mrel:i32=0;
    if(fr==rel){ mrel=1; }
    let mobj:i32=0;
    if(fo==obj){ mobj=1; }
    let both:i32=0;
    if(mrel==1){ if(mobj==1){ both=1; } }
    if(both==1){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// cnt_spec_fix: cnt_spec + relation revalidation.
fn cnt_spec_fix(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fr:i32=get32(A,4+j*12+4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      let mrel:i32=0;
      if(fr==rel){ mrel=1; }
      let msub:i32=0;
      if(fs==subj){ msub=1; }
      let both:i32=0;
      if(mrel==1){ if(msub==1){ both=1; } }
      if(both==1){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// et_spec.zag -- epoch/snapshot-tagged spec variants for SPEC-EPOCHTAG.
// Each bucket is tagged with the world epoch at specialization time
// (et_specialize_* stamps et_epoch_get(A) into the tag slots). Every spec
// call compares the live world epoch against the tag and REFUSES on
// mismatch: it increments the refusal counter, returns a miss (0), and
// never scans the bucket. Refusal therefore fires before any fact is
// read, which the kb counter proves (kbs=0 on refused calls).
//
// Tag slots in L (verified free; highest L offset used by da_learn.zag is
// 13296): ret tags at 13300+bi*4, vfy tags at 13364+bi*4, cnt tags at
// 13428+bi*4 (16 slots each; all stamped, live ones are what matter).
// No world literals appear in this file.
// ---- specialization wrappers: real specialize, then stamp the epoch ----
fn et_specialize_ret(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_ret(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13300+i*4,e); i=i+1; }
  return;
}
fn et_specialize_vfy(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_vfy(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13364+i*4,e); i=i+1; }
  return;
}
fn et_specialize_cnt(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_cnt(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13428+i*4,e); i=i+1; }
  return;
}
// ---- et_ret_spec: epoch gate around ret_spec_fix ----
fn et_ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(et_epoch_get(A)!=get32(L,13300+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(out,oo,0);
    return 0;
  }
  return ret_spec_fix(L,A,rel,obj,kb,ko,out,oo);
}
// ---- et_cnt_spec: epoch gate around cnt_spec_fix ----
fn et_cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(et_epoch_get(A)!=get32(L,13428+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(seen,0,0);
    return 0;
  }
  return cnt_spec_fix(L,A,rel,sb,so,nsubs,kb,ko,seen);
}
// ---- et_vfy_spec: per-step epoch pre-scan around vfy_spec ----
fn et_vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32)i32 {
  let ns:i32=get32(C,0);
  let we:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    if(get32(L,13364+bi*4)!=we){
      set32(rkb,rko,get32(rkb,rko)+1);
      return 0;
    }
    i=i+1;
  }
  return vfy_spec(L,A,C,kb,ko);
}
// rr_spec.zag -- refusal-recovery protocol for SPEC-REFUSAL-RECOVERY.
//
// Each wrapper calls the corresponding et_* epoch-gated spec. On EXPLICIT
// refusal (the refusal counter moved, not a silent miss) it re-specializes
// the refused bucket family from the current world via the et_specialize_*
// wrappers (which rebuild the buckets and restamp the epoch tags to the
// live world epoch), counts one re-specialize event, and retries exactly
// once. A miss with a matching epoch returns as-is: recovery fires only on
// refusal, never on miss. A second refusal on the retry is returned as-is
// (second-order failure, caught by the kill bars, never silently looped).
// No world literals appear in this file.
fn rr_ret_spec(L:[]u8,S:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_ret(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
}
fn rr_cnt_spec(L:[]u8,S:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_cnt(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
}
fn rr_vfy_spec(L:[]u8,S:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_vfy_spec(L,A,C,kb,ko,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_vfy(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_vfy_spec(L,A,C,kb,ko,rkb,rko);
}
// ld_spec.zag -- SPEC-LAZY-DEFAULT policy layer.
//
// Lazy on-demand recovery is the DEFAULT recovery policy. Eager
// rebuild-on-drift requires an explicit latency justification token
// (just != 0); an eager request with just == 0 is refused by the policy
// layer and falls back to the default path, flagged on the output line.
//
// Reuses the byte-unmodified rr_ret_spec wrapper (the lazy on-demand
// mechanism from SPEC-REFUSAL-RECOVERY) and the et_* epoch machinery
// unmodified. No world literals in this file: the relation and object
// ids arrive via the rb_* accessors.
fn ld_agree_ret(rs:i32,rg:i32,sout:i32,gout:i32)i32 {
  if(rs!=rg){ return 0; }
  if(rs==0){ return 1; }
  if(sout==gout){ return 1; }
  return 0;
}
fn ld_grid(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i==2){ return 4; }
  if(i==3){ return 8; }
  return 16;
}
fn ld_min(a:i32,b:i32)i32 {
  if(a<b){ return a; }
  return b;
}
fn ld_emit_cell(B:[]u8,c:i32,M:i32,N:i32,pol:i32,just:i32,fb:i32,dr:i32,q:i32,rb:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL M=");
  c=o_i64(B,c,M as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N as i64);
  c=o_app(B,c," P=");
  if(pol==0){ c=o_app(B,c,"default"); }
  if(pol==1){ c=o_app(B,c,"eager"); }
  if(pol==2){ c=o_app(B,c,"eager0"); }
  c=o_app(B,c," just=");
  c=o_i64(B,c,just as i64);
  c=o_app(B,c," fb=");
  c=o_i64(B,c,fb as i64);
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,rb as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_nl(B,c);
  return c;
}
// One query on the DEFAULT path (lazy): the rr wrapper rebuilds only
// when the epoch gate actually refuses. acc packs deltas: 0=rebuilds,
// 4=answered, 8=refusals, 12=kb.
fn ld_query_default(L:[]u8,S:[]u8,A:[]u8,ra:i32,oa1:i32,K:[]u8,OUT:[]u8,OUTG:[]u8,acc:[]u8)void {
  set32(K,0,0);
  set32(K,4,0);
  set32(K,8,0);
  let v:i32=rr_ret_spec(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  set32(acc,0,get32(acc,0)+get32(K,8));
  set32(acc,8,get32(acc,8)+get32(K,4));
  set32(acc,12,get32(acc,12)+get32(K,0));
  set32(K,0,0);
  let g:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let so:i32=-1;
  if(v>0){ so=get32(OUT,4); }
  let go:i32=-1;
  if(g>0){ go=get32(OUTG,4); }
  if(ld_agree_ret(v,g,so,go)==1){ set32(acc,4,get32(acc,4)+1); }
  return;
}
// One query on the EAGER path. just != 0 is the explicit latency
// justification. just == 0 carries no justification: the policy layer
// refuses the eager request, flags the fallback, and routes the query
// through the default path. (The eager restamp itself fires in the
// episode loop only for the justified arm.)
fn ld_query_eager(L:[]u8,S:[]u8,A:[]u8,ra:i32,oa1:i32,just:i32,K:[]u8,OUT:[]u8,OUTG:[]u8,acc:[]u8,fb:[]u8)void {
  if(just==0){
    set32(fb,0,1);
    ld_query_default(L,S,A,ra,oa1,K,OUT,OUTG,acc);
    return;
  }
  ld_query_default(L,S,A,ra,oa1,K,OUT,OUTG,acc);
  return;
}
// One episode: T ticks, a drift every M ticks, one query every N ticks,
// drift before query at coincident ticks. pol 0=default (lazy, no
// justification needed); pol 1=eager with explicit justification
// (just=1): restamp after every drift; pol 2=eager attempted with
// just=0: the policy layer refuses it and falls back to default (fb=1).
fn ld_episode(B:[]u8,c:i32,M:i32,N:i32,pol:i32,just:i32,ra:i32,oa1:i32)i32 {
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let fb:[]u8=z_alloc(8);
  let T:i32=256;
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(L,ra);
  et_specialize_ret(L,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  set32(fb,0,0);
  let drifts:i32=0;
  let queries:i32=0;
  let dc:i32=0;
  let qc:i32=0;
  let t:i32=0;
  while(t<T){
    if(dc==0){
      et_drift_unrelated(A);
      drifts=drifts+1;
      dc=M;
      if(pol==1){
        et_specialize_ret(L,S,A,0,0);
        set32(acc,0,get32(acc,0)+1);
      }
    }
    if(qc==0){
      queries=queries+1;
      qc=N;
      if(pol==0){
        ld_query_default(L,S,A,ra,oa1,K,OUT,OUTG,acc);
      } else {
        ld_query_eager(L,S,A,ra,oa1,just,K,OUT,OUTG,acc,fb);
      }
    }
    dc=dc-1;
    qc=qc-1;
    t=t+1;
  }
  c=ld_emit_cell(B,c,M,N,pol,just,get32(fb,0),drifts,queries,get32(acc,0),get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}
// cs_spec.zag -- SPEC-COLD-START policy layer.
//
// Derived from the parent lane's at_spec.zag (SPEC-ABSTENTION-TRAP,
// BUILD-FAIL on K5b) with a minimal documented delta. Everything
// below marked [CS-DELTA] is new; everything marked [CS-RENAME] is
// renamed without behavior change; all other logic (EWMA estimator,
// nr_decide margin test, pre-shift commit rule, opposite-decisive
// flip rule, pol-3 deferred re-check branch, arrival mechanics, seed
// formulas) is the parent's, unchanged. The parent's at_spec.zag is
// byte-unmodified in its own lane directory (K8); this file
// supersedes it in the assembly, it is not assembled alongside it.
//
// [CS-DELTA] A fourth adaptive arm, pol 4 ("guard"): identical to
// pol 2 (adapt) in every respect EXCEPT the com = 0 commit branch:
// a dec = 2 (eager-decisive) outcome is NOT committed while
// dh = 0 and ed = 0 (the degenerate {0} price interval: no drift
// observation within the estimator's memory). The episode stays
// undecided at that checkpoint; at e = 128 a still-degenerate
// dec = 2 falls through to budget-default (com = 2, cm = 0)
// instead of committing eager. The guard never blocks lazy commits
// (dec = 1 requires dlo > 0, hence ed > 0) and never affects the
// flip rule or any path once drift data exists. The degenerate
// condition is computed as a hoisted blk flag (znc defect
// workaround: no deep if-nesting).
// [CS-DELTA] nr_polname prints "guard" for pol 4.
// [CS-DELTA] cs_episode wires pol 4 through the adapt
// initialization, EWMA updates, and checkpoint call.
// [CS-RENAME] at_checkpoint -> cs_checkpoint, at_emit_cell ->
// cs_emit_cell, at_episode -> cs_episode (no behavior change;
// pol-3 branch inherited dormant: never invoked in this lane's
// sweep, which covers pol in {0,1,2,4}).
//
// Shared helpers (nr_max0, nr_maxi, nr_isqrt, nr_next, nr_thr_b,
// nr_thr_q, nr_decide, nr_snap, nr_polname) are byte-identical to
// the parent lane. New/changed: rc_seed_d/rc_seed_q (regime seeds,
// unchanged), rc_track_flip (post-shift flip recording, unchanged),
// cs_checkpoint (burn-in snapshots at e = 144/192 + flip tracking +
// inherited pol-3 deferred re-check + [CS-DELTA] pol-4 minimum-data
// guard on the eager commit), cs_emit_cell ([CS-RENAME] only),
// cs_episode ([CS-RENAME] + [CS-DELTA] pol-4 plumbing).
//
// No world literals in this file: relation/object ids arrive via rb_*.
fn nr_max0(a:i32)i32 {
  if(a>0){ return a; }
  return 0;
}
fn nr_maxi(a:i32,b:i32)i32 {
  if(a>b){ return a; }
  return b;
}
// Integer Newton sqrt, fixed 12 iterations: deterministic.
fn nr_isqrt(n:i64)i64 {
  if(n<=0){ return 0; }
  let x:i64=n/2+1;
  let i:i32=0;
  while(i<12){
    x=(x+n/x)/2;
    i=i+1;
  }
  return x;
}
// LCG: s <- (s*1103515245 + 12345) mod 2^31. i64, mod hand-rolled.
fn nr_next(s:i64)i64 {
  let r:i64=s*1103515245+12345;
  let q:i64=r/2147483648;
  return r-q*2147483648;
}
// Burst fire threshold for mean rate 1/M: min(2^31, 5*2^31/(2M)).
fn nr_thr_b(M:i32)i64 {
  let C:i64=2147483648;
  let t:i64=(5*C)/(2*(M as i64));
  if(t>C){ return C; }
  return t;
}
// Quiet fire threshold: max(0, (4*2^31/M - thr_b)/3).
fn nr_thr_q(M:i32,tb:i64)i64 {
  let C:i64=2147483648;
  let t:i64=((4*C)/(M as i64)-tb)/3;
  if(t<0){ return 0; }
  return t;
}
// Regime seeds: frozen, reset per episode, identical across arms.
fn rc_seed_d(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*101+N1*17+M2*13+N2*7+17) as i64;
}
fn rc_seed_q(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*17+N1*101+M2*7+N2*13+917) as i64;
}
// Margin-test decision. Returns 2 = eager-decisive (L > phi, strict),
// 1 = lazy-decisive (L < plo, strict), 0 = undecided. phi >= plo
// always (price increasing in d, decreasing in q), so both cannot fire.
fn nr_decide(dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32,L:i32)i32 {
  let phin:i32=nr_max0(dhi-qlo);
  let phid:i32=nr_maxi(qlo,1);
  let plon:i32=nr_max0(dlo-qhi);
  let plod:i32=nr_maxi(qhi,1);
  let eg:i32=0;
  let lz:i32=0;
  if(L*phid>phin){ eg=1; }
  if(L*plod<plon){ lz=1; }
  if(eg==1){ return 2; }
  if(lz==1){ return 1; }
  return 0;
}
// Snapshot commit-time estimates and intervals into CS.
fn nr_snap(CS:[]u8,dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32)void {
  set32(CS,32,dh);
  set32(CS,36,qh);
  set32(CS,40,dlo);
  set32(CS,44,dhi);
  set32(CS,48,qlo);
  set32(CS,52,qhi);
  set32(CS,56,nr_max0(dh-qh));
  set32(CS,60,nr_maxi(qh,1));
  set32(CS,64,nr_max0(dlo-qhi));
  set32(CS,68,nr_maxi(qhi,1));
  set32(CS,72,nr_max0(dhi-qlo));
  set32(CS,76,nr_maxi(qlo,1));
  return;
}
// Record a post-shift flip: pflips++, first flip sets tf1/fdir,
// second sets tf2. Called only with e > 128.
fn rc_track_flip(CS:[]u8,e:i32,want:i32)void {
  set32(CS,104,get32(CS,104)+1);
  if(get32(CS,92)==0){
    set32(CS,92,e);
    let fd:i32=-1;
    if(want==1){ fd=1; }
    set32(CS,96,fd);
    return;
  }
  if(get32(CS,100)==0){ set32(CS,100,e); }
  return;
}
// Checkpoint logic. CS layout: parent slots 0..80, plus
// 84=dh144, 88=qh144 (EWMA at first post-shift checkpoint),
// 92=tf1, 96=fdir, 100=tf2, 104=pflips,
// 108=dh192, 112=qh192 (EWMA ~4 time constants post-shift),
// 116=lc (late-commit flag: 1 iff committed post-shift from com = 2;
// inherited, stays 0 in this lane: pol 3 is dormant).
// e = elapsed ticks.
fn cs_checkpoint(CS:[]u8,LA:[]u8,S:[]u8,A:[]u8,dh:i32,qh:i32,ed:i32,eq:i32,drifts:i32,queries:i32,L:i32,pol:i32,e:i32)void {
  if(e==144){
    set32(CS,84,dh);
    set32(CS,88,qh);
  }
  if(e==192){
    set32(CS,108,dh);
    set32(CS,112,qh);
  }
  let sed:i64=nr_isqrt((ed/31) as i64);
  let seq:i64=nr_isqrt((eq/31) as i64);
  let dlo:i32=nr_max0(dh-2*(sed as i32));
  let dhi:i32=dh+2*(sed as i32);
  let qlo:i32=nr_max0(qh-2*(seq as i32));
  let qhi:i32=qh+2*(seq as i32);
  let com:i32=get32(CS,0);
  if(com==0){
    if(e>128){ return; }
    let dec:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    // [CS-DELTA] minimum-data guard. A degenerate {0} price
    // interval ((dh,ed) = (0,0): no drift observation within the
    // estimator's memory) is not decisive evidence: block the
    // eager commit and stay undecided. Computed as a hoisted flag
    // (znc workaround: shallow if-nesting). Applies to pol 4 only;
    // pol 2 keeps the inherited zero-data eager commit (the quirk
    // under study).
    let blk:i32=0;
    if(pol==4){ blk=1; }
    if(dh!=0){ blk=0; }
    if(ed!=0){ blk=0; }
    if(dec==2){
      if(blk==0){
        set32(CS,0,1);
        set32(CS,4,2);
        set32(CS,8,e);
        set32(CS,12,1);
        set32(CS,16,1);
        set32(CS,24,drifts);
        set32(CS,28,queries);
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
        nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
        return;
      }
    }
    if(dec==1){
      set32(CS,0,1);
      set32(CS,4,1);
      set32(CS,8,e);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(e==128){
      set32(CS,0,2);
      set32(CS,4,0);
      set32(CS,8,128);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    return;
  }
  if(com==1){
    let dec:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    let cur:i32=get32(CS,12);
    let want:i32=cur;
    if(dec==2){ want=1; }
    if(dec==1){ want=0; }
    if(want!=cur){
      set32(CS,12,want);
      set32(CS,16,want);
      set32(CS,20,get32(CS,20)+1);
      if(want==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
      let post:i32=0;
      if(e>128){ post=1; }
      if(post==1){ rc_track_flip(CS,e,want); }
    }
    return;
  }
  if(com==2){
    if(pol!=3){ return; }
    if(e<=128){ return; }
    let dec2:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    if(dec2==2){
      set32(CS,0,1);
      set32(CS,4,2);
      set32(CS,8,e);
      set32(CS,12,1);
      set32(CS,16,1);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      et_specialize_ret(LA,S,A,0,0);
      set32(CS,80,get32(CS,80)+1);
      set32(CS,116,1);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(dec2==1){
      set32(CS,0,1);
      set32(CS,4,1);
      set32(CS,8,e);
      set32(CS,12,0);
      set32(CS,16,0);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      set32(CS,116,1);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    return;
  }
  return;
}
fn nr_polname(B:[]u8,c:i32,pol:i32)i32 {
  if(pol==0){ c=o_app(B,c,"lazy"); }
  if(pol==1){ c=o_app(B,c,"eager"); }
  if(pol==2){ c=o_app(B,c,"adapt"); }
  if(pol==3){ c=o_app(B,c,"rechk"); }
  if(pol==4){ c=o_app(B,c,"guard"); }
  return c;
}
// [CS-RENAME] at_emit_cell -> cs_emit_cell. No behavior change:
// same CELL line fields (including the inherited dormant lc field).
fn cs_emit_cell(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,CS:[]u8,dpre:i32,qpre:i32,dr:i32,q:i32,od:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL R=");
  c=o_i64(B,c,R as i64);
  c=o_app(B,c," M=");
  c=o_i64(B,c,M1 as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N1 as i64);
  c=o_app(B,c," M2=");
  c=o_i64(B,c,M2 as i64);
  c=o_app(B,c," N2=");
  c=o_i64(B,c,N2 as i64);
  c=o_app(B,c," P=");
  c=nr_polname(B,c,pol);
  c=o_app(B,c," L=");
  c=o_i64(B,c,Lv as i64);
  c=o_app(B,c," C=1 tc=");
  c=o_i64(B,c,get32(CS,8) as i64);
  c=o_app(B,c," cm=");
  c=o_i64(B,c,get32(CS,4) as i64);
  c=o_app(B,c," Dc=");
  c=o_i64(B,c,get32(CS,24) as i64);
  c=o_app(B,c," Qc=");
  c=o_i64(B,c,get32(CS,28) as i64);
  c=o_app(B,c," dh=");
  c=o_i64(B,c,get32(CS,32) as i64);
  c=o_app(B,c," qh=");
  c=o_i64(B,c,get32(CS,36) as i64);
  c=o_app(B,c," dlo=");
  c=o_i64(B,c,get32(CS,40) as i64);
  c=o_app(B,c," dhi=");
  c=o_i64(B,c,get32(CS,44) as i64);
  c=o_app(B,c," qlo=");
  c=o_i64(B,c,get32(CS,48) as i64);
  c=o_app(B,c," qhi=");
  c=o_i64(B,c,get32(CS,52) as i64);
  c=o_app(B,c," pnum=");
  c=o_i64(B,c,get32(CS,56) as i64);
  c=o_app(B,c," pden=");
  c=o_i64(B,c,get32(CS,60) as i64);
  c=o_app(B,c," plon=");
  c=o_i64(B,c,get32(CS,64) as i64);
  c=o_app(B,c," plod=");
  c=o_i64(B,c,get32(CS,68) as i64);
  c=o_app(B,c," phin=");
  c=o_i64(B,c,get32(CS,72) as i64);
  c=o_app(B,c," phid=");
  c=o_i64(B,c,get32(CS,76) as i64);
  c=o_app(B,c," sel=");
  c=o_i64(B,c,get32(CS,16) as i64);
  c=o_app(B,c," flips=");
  c=o_i64(B,c,get32(CS,20) as i64);
  c=o_app(B,c," pflips=");
  c=o_i64(B,c,get32(CS,104) as i64);
  c=o_app(B,c," tf1=");
  c=o_i64(B,c,get32(CS,92) as i64);
  c=o_app(B,c," fdir=");
  c=o_i64(B,c,get32(CS,96) as i64);
  c=o_app(B,c," tf2=");
  c=o_i64(B,c,get32(CS,100) as i64);
  c=o_app(B,c," Dpre=");
  c=o_i64(B,c,dpre as i64);
  c=o_app(B,c," Qpre=");
  c=o_i64(B,c,qpre as i64);
  c=o_app(B,c," Dpost=");
  c=o_i64(B,c,(dr-dpre) as i64);
  c=o_app(B,c," Qpost=");
  c=o_i64(B,c,(q-qpre) as i64);
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," od=");
  c=o_i64(B,c,od as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(CS,80) as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,(od+get32(CS,80)) as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_app(B,c," dh144=");
  c=o_i64(B,c,get32(CS,84) as i64);
  c=o_app(B,c," qh144=");
  c=o_i64(B,c,get32(CS,88) as i64);
  c=o_app(B,c," dh192=");
  c=o_i64(B,c,get32(CS,108) as i64);
  c=o_app(B,c," qh192=");
  c=o_i64(B,c,get32(CS,112) as i64);
  c=o_app(B,c," lc=");
  c=o_i64(B,c,get32(CS,116) as i64);
  c=o_nl(B,c);
  return c;
}
// One episode. pol 0 = fixed lazy, pol 1 = fixed eager (restamp on
// every drift), pol 2 = adaptive with EWMA + confidence-interval
// margin test (quirk included: zero-data eager commit at e = 32),
// pol 3 = recheck (inherited dormant: not swept in this lane),
// pol 4 = guard: identical to pol 2 except the [CS-DELTA]
// minimum-data guard blocks eager commits while (dh,ed) = (0,0).
// Regime shift at t = 128: fire thresholds swap from (M1,N1) to
// (M2,N2); Markov states persist, LCG sequences continue. acc packs
// deltas: 0 = on-demand rebuilds, 4 = answered, 8 = refusals,
// 12 = kb. CS packs commit state; CS+80 counts restamps (sync +
// per-drift); CS+84..112 hold regime instrumentation (see
// cs_checkpoint); CS+116 is the late-commit flag lc (stays 0 here).
fn cs_episode(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,ra:i32,oa1:i32)i32 {
  let LA:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let CS:[]u8=z_alloc(128);
  let T:i32=256;
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(LA,ra);
  et_specialize_ret(LA,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  set32(CS,0,0);
  set32(CS,4,0);
  set32(CS,8,-1);
  set32(CS,12,pol);
  set32(CS,16,pol);
  set32(CS,20,0);
  set32(CS,24,0);
  set32(CS,28,0);
  set32(CS,32,0);
  set32(CS,36,0);
  set32(CS,40,0);
  set32(CS,44,0);
  set32(CS,48,0);
  set32(CS,52,0);
  set32(CS,56,0);
  set32(CS,60,1);
  set32(CS,64,0);
  set32(CS,68,1);
  set32(CS,72,0);
  set32(CS,76,1);
  set32(CS,80,0);
  set32(CS,84,0);
  set32(CS,88,0);
  set32(CS,92,0);
  set32(CS,96,0);
  set32(CS,100,0);
  set32(CS,104,0);
  set32(CS,108,0);
  set32(CS,112,0);
  set32(CS,116,0);
  let apol:i32=0;
  if(pol==2){ apol=1; }
  if(pol==3){ apol=1; }
  if(pol==4){ apol=1; }
  if(apol==1){
    set32(CS,12,0);
    set32(CS,16,0);
  }
  let s1:i64=rc_seed_d(R,M1,N1,M2,N2);
  let s2:i64=rc_seed_q(R,M1,N1,M2,N2);
  let ds:i32=0;
  let qs:i32=0;
  let TPB:i64=nr_thr_b(M1);
  let TPQ:i64=nr_thr_q(M1,TPB);
  let TQB:i64=nr_thr_b(N1);
  let TQQ:i64=nr_thr_q(N1,TQB);
  let TPB2:i64=nr_thr_b(M2);
  let TPQ2:i64=nr_thr_q(M2,TPB2);
  let TQB2:i64=nr_thr_b(N2);
  let TQQ2:i64=nr_thr_q(N2,TQB2);
  let C31:i64=2147483648;
  let TSB:i64=C31/8;
  let TSQ:i64=C31/24;
  let dh:i32=0;
  let qh:i32=0;
  let ed:i32=0;
  let eq:i32=0;
  let drifts:i32=0;
  let queries:i32=0;
  let dpre:i32=0;
  let qpre:i32=0;
  let cpd:i32=32;
  let t:i32=0;
  while(t<T){
    if(t==128){
      TPB=TPB2;
      TPQ=TPQ2;
      TQB=TQB2;
      TQQ=TQQ2;
    }
    s1=nr_next(s1);
    let u1:i64=s1;
    let nds:i32=ds;
    if(ds==1 && u1<TSB){ nds=0; }
    if(ds==0 && u1<TSQ){ nds=1; }
    ds=nds;
    s1=nr_next(s1);
    let u2:i64=s1;
    let df:i32=0;
    if(ds==1 && u2<TPB){ df=1; }
    if(ds==0 && u2<TPQ){ df=1; }
    s2=nr_next(s2);
    let u3:i64=s2;
    let nqs:i32=qs;
    if(qs==1 && u3<TSB){ nqs=0; }
    if(qs==0 && u3<TSQ){ nqs=1; }
    qs=nqs;
    s2=nr_next(s2);
    let u4:i64=s2;
    let qf:i32=0;
    if(qs==1 && u4<TQB){ qf=1; }
    if(qs==0 && u4<TQQ){ qf=1; }
    let cur:i32=get32(CS,12);
    if(df==1){
      et_drift_unrelated(A);
      drifts=drifts+1;
      if(cur==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
    }
    if(qf==1){
      queries=queries+1;
      ld_query_default(LA,S,A,ra,oa1,K,OUT,OUTG,acc);
    }
    if(t<128){
      dpre=dpre+df;
      qpre=qpre+qf;
    }
    let adap:i32=0;
    if(pol==2){ adap=1; }
    if(pol==3){ adap=1; }
    if(pol==4){ adap=1; }
    if(adap==1){
      let devd:i32=1024*df-dh;
      dh=(15*dh+1024*df)/16;
      ed=(15*ed+devd*devd)/16;
      let devq:i32=1024*qf-qh;
      qh=(15*qh+1024*qf)/16;
      eq=(15*eq+devq*devq)/16;
    }
    cpd=cpd-1;
    if(cpd==0){
      if(adap==1){
        cs_checkpoint(CS,LA,S,A,dh,qh,ed,eq,drifts,queries,Lv,pol,t+1);
      }
      cpd=16;
    }
    t=t+1;
  }
  let od:i32=get32(acc,0);
  c=cs_emit_cell(B,c,R,M1,N1,M2,N2,pol,Lv,CS,dpre,qpre,drifts,queries,od,get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}
// cs_main.zag -- harness main for SPEC-COLD-START.
// Sweeps 4 regime cells x 10 arms (fixed lazy, fixed eager,
// adaptive pol 2 with L in {0,1,3,7}, guard pol 4 with
// L in {0,1,3,7}) = 40 episodes, each emitting one CELL line.
// Cell index ci -> (R, M1, N1, M2, N2):
//   ci=0 CS0: R=21  (16,16)->(16,16)  sparse stationary control
//   ci=1 CS1: R=60  (16,16)->(1,16)   sparse -> drift-dense (HARM)
//   ci=2 CS2: R=82  (16,16)->(16,1)   sparse -> query-dense (BENEFIT)
//   ci=3 CS3: R=120 (16,16)->(1,16)   same regime as CS1, D32 >= 1
//                                     (GUARD-PURITY CONTROL)
// R values selected by the pre-prereg seed probe (probe.zag):
// CS0/CS1/CS2 lowest R with D32 == 0 on their tuple (the quirk
// fires by construction); CS3 lowest R with D32 >= 1 on its tuple
// (quirk absent). R values are distinct because CELL lines are
// keyed by R. Ranges were disjoint per cell.
// Arrivals are bursty and irregular (seeded per cell, identical
// across arms, regime shift at tick 128); relation/object ids arrive
// via the rb_* accessors; no world literals appear here.
fn cs_R(ci:i32)i32 {
  if(ci==0){ return 21; }
  if(ci==1){ return 60; }
  if(ci==2){ return 82; }
  return 120;
}
fn cs_m1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn cs_n1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn cs_m2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 1; }
  if(ci==2){ return 16; }
  return 1;
}
fn cs_n2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 1; }
  return 16;
}
fn cs_L(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 3; }
  return 7;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let ci:i32=0;
  while(ci<4){
    let R:i32=cs_R(ci);
    let M1:i32=cs_m1(ci);
    let N1:i32=cs_n1(ci);
    let M2:i32=cs_m2(ci);
    let N2:i32=cs_n2(ci);
    c=cs_episode(B,c,R,M1,N1,M2,N2,0,-1,ra,oa1);
    c=cs_episode(B,c,R,M1,N1,M2,N2,1,-1,ra,oa1);
    let li:i32=0;
    while(li<4){
      c=cs_episode(B,c,R,M1,N1,M2,N2,2,cs_L(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=cs_episode(B,c,R,M1,N1,M2,N2,4,cs_L(li),ra,oa1);
      li=li+1;
    }
    ci=ci+1;
  }
  o_flush(B,c);
  return 0;
}

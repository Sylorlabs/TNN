// ma2.zag -- MA2: MA1 multi-cell means plus dormant-cell protection.
// Neutral identifiers only.
//
// X: 732 episodes (D=12, R=660, B2=60). Y: 720 (R+B2).
// Z: 732 single-cell. W: 852 (D=12, R=660, B2=60, R3=60);
// R3 reuses the R tile.
// Cell state: (sum, n, score, wpart, wpsm). wpart/wpsm tally winner
// episodes and winner error sums, from revealed values only.
// Protected: wpart >= 5 and wpsm/wpart <= 10.
// Victim: highest score (ties: highest index) among non-active,
// non-winner, unprotected cells. If none, the reseed is declined
// (logged; tally reset); selection then reuses a dormant cell.
// No block labels reach the cells.

// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access (u8-backed cells) ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- arena layout ----
// 0 prng(8) | 8 pX[732](2928) | 2936 pY[720](2880) | 5816 pZ[732](2928) |
// 8744 pW[852](3408) | 12152 fX[878400] | 890552 fY[864000] |
// 1754552 fZ[878400] | 2632952 fW[1022400] |
// 3655352 eX[732](2928) | 3658280 eY[720](2880) | 3661160 eZ[732](2928) |
// 3664088 eW[852](3408) |
// 3667496 mXa[732](2928) | 3670424 mYa[720](2880) | 3673304 mZ[732](2928) |
// 3676232 mWa[852](3408) |
// 3679640 genfail(4) | 3679644 tmp9(36) | 3679680 tmp3(12) |
// 3679692 tmp9r(36) | 3679728 tmp9b(36) |
// 3679764 cellsX(88) | 3679852 cellsY(88) | 3679940 cellsW(88) |
// 3680028 terr[4](16) |
// 3680044 tlogX[32](128) | 3680172 tlogY[32](128) | 3680300 tlogW[32](128) |
// 3680428 tproX[32](128) | 3680556 tproW[32](128) | 3680684 tproY[32](128) |
// 3680812 tflgX[32](128) | 3680940 tflgW[32](128) | 3681068 tflgY[32](128) |
// 3681196 declX(4) | 3681200 declY(4) | 3681204 declW(4) |
// 3681208 protdest(4) | 3681212 b5gok(4) |
// 3681216 snapXD(80) | 3681296 snapXR(80) | 3681376 snapXB(80) |
// 3681456 snapYR(80) | 3681536 snapYB(80) |
// 3681616 snapWD(80) | 3681696 snapWR(80) | 3681776 snapWB(80) |
// 3681856 snapWR3(80)
// cell: sum +0, n +16, score +32, consec +48, trgev +52, wpart +56, wpsm +72
// ---- episode values and flips (frozen harness) ----
fn gen(G:[]u8)void {
  s64(G,0,20261020);
  let t9:i32=3679644;
  let t3:i32=3679680;
  let t9r:i32=3679692;
  let t9b:i32=3679728;
  let i:i32=0;
  while(i<9){ set32(G,t9+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,t9+i*4);
    set32(G,t9+i*4,get32(G,t9+j*4));
    set32(G,t9+j*4,a);
    i=i+1;
  }
  set32(G,t3,40); set32(G,t3+4,47); set32(G,t3+8,54);
  i=0;
  while(i<3){
    let j2:i32=i+rnd(G,3-i);
    let a2:i32=get32(G,t3+i*4);
    set32(G,t3+i*4,get32(G,t3+j2*4));
    set32(G,t3+j2*4,a2);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9r+i*4,76+i); i=i+1; }
  i=0;
  while(i<9){
    let j3:i32=i+rnd(G,9-i);
    let a3:i32=get32(G,t9r+i*4);
    set32(G,t9r+i*4,get32(G,t9r+j3*4));
    set32(G,t9r+j3*4,a3);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9b+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j4:i32=i+rnd(G,9-i);
    let a4:i32=get32(G,t9b+i*4);
    set32(G,t9b+i*4,get32(G,t9b+j4*4));
    set32(G,t9b+j4*4,a4);
    i=i+1;
  }
  let s:i32=0;
  let e:i32=0;
  while(e<732){
    let v:i32=0;
    if(e<12){
      if(e==3){ v=get32(G,t3); }
      else {
        if(e==7){ v=get32(G,t3+4); }
        else {
          if(e==11){ v=get32(G,t3+8); }
          else { v=get32(G,t9+s*4); s=s+1; }
        }
      }
    }
    else {
      if(e<672){ v=get32(G,t9r+((e-12)%9)*4); }
      else { v=get32(G,t9b+((e-672)%9)*4); }
    }
    set32(G,8+e*4,v);
    set32(G,5816+e*4,v);
    e=e+1;
  }
  e=0;
  while(e<720){
    let v2:i32=0;
    if(e<660){ v2=get32(G,t9r+(e%9)*4); }
    else { v2=get32(G,t9b+((e-660)%9)*4); }
    set32(G,2936+e*4,v2);
    e=e+1;
  }
  let s2:i32=0;
  e=0;
  while(e<852){
    let v4:i32=0;
    if(e<12){
      if(e==3){ v4=get32(G,t3); }
      else {
        if(e==7){ v4=get32(G,t3+4); }
        else {
          if(e==11){ v4=get32(G,t3+8); }
          else { v4=get32(G,t9+s2*4); s2=s2+1; }
        }
      }
    }
    else {
      if(e<672){ v4=get32(G,t9r+((e-12)%9)*4); }
      else {
        if(e<732){ v4=get32(G,t9b+((e-672)%9)*4); }
        else { v4=get32(G,t9r+((e-732)%9)*4); }
      }
    }
    set32(G,8744+e*4,v4);
    e=e+1;
  }
  s64(G,0,20261021);
  e=0;
  while(e<732){
    let pv:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<pv){ f=1; }
      G[12152+e*1200+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  s64(G,0,20261022);
  e=0;
  while(e<720){
    let pv2:i32=get32(G,2936+e*4);
    let k2:i32=0;
    while(k2<1200){
      let d2:i32=rnd(G,100);
      let f2:i32=0;
      if(d2<pv2){ f2=1; }
      G[890552+e*1200+k2]=f2 as u8;
      k2=k2+1;
    }
    e=e+1;
  }
  s64(G,0,20261023);
  e=0;
  while(e<732){
    let pv3:i32=get32(G,5816+e*4);
    let k3:i32=0;
    while(k3<1200){
      let d3:i32=rnd(G,100);
      let f3:i32=0;
      if(d3<pv3){ f3=1; }
      G[1754552+e*1200+k3]=f3 as u8;
      k3=k3+1;
    }
    e=e+1;
  }
  s64(G,0,20261024);
  e=0;
  while(e<852){
    let pv4:i32=get32(G,8744+e*4);
    let k4:i32=0;
    while(k4<1200){
      let d4:i32=rnd(G,100);
      let f4:i32=0;
      if(d4<pv4){ f4=1; }
      G[2632952+e*1200+k4]=f4 as u8;
      k4=k4+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode (frozen, as in MA1) ----
// m: current mean. Returns smallest n in 1..1200 with |est_n - p| < 5,
// else 1201. Exact integer comparison, no division.
fn etc_ep(G:[]u8,e:i32,m:i32,fbase:i32,pbase:i32)i32 {
  let mi:i64=m as i64;
  let pi:i64=get32(G,pbase+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=1200){
    h=h+(G[fbase+e*1200+n-1] as i64);
    let num:i64=20*mi+100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<5*den){ return n; }
    n=n+1;
  }
  return 1201;
}
// ---- protection predicate: shown explanatory success ----
// wpart: winner episodes; wpsm: summed winner error. Protected iff
// wpart >= 5 and mean winner error <= 10. From revealed values only.
fn prot(G:[]u8,cb:i32,i:i32)i32 {
  let wp:i32=get32(G,cb+56+i*4);
  if(wp>=5){
    let me:i32=get32(G,cb+72+i*4)/wp;
    if(me<=10){ return 1; }
  }
  return 0;
}
// ---- snapshot 4 cells: sums, ns, scores, wpart, wpsm ----
fn snap(G:[]u8,cb:i32,sb:i32)void {
  let i:i32=0;
  while(i<4){
    set32(G,sb+i*4,get32(G,cb+i*4));
    set32(G,sb+16+i*4,get32(G,cb+16+i*4));
    set32(G,sb+32+i*4,get32(G,cb+32+i*4));
    set32(G,sb+48+i*4,get32(G,cb+56+i*4));
    set32(G,sb+64+i*4,get32(G,cb+72+i*4));
    i=i+1;
  }
  return;
}
// ---- multi-cell condition ----
// cb: cell base. cond: 0=Y (R+B2), 1=X (D+R+B2), 2=W (D+R+B2+R3).
// tlog/tpro/tflg: per trigger evaluation: episode, victim (99=declined,
// +10 if protected), protection bitmask. decloff: decline tally.
fn run_multi(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,cb:i32,snapD:i32,snapR:i32,snapB:i32,snapR3:i32,tlog:i32,tpro:i32,tflg:i32,decloff:i32,ne:i32,cond:i32)void {
  let e:i32=0;
  while(e<ne){
    let a:i32=0;
    let bi:i32=1;
    while(bi<4){
      if(get32(G,cb+32+bi*4)<get32(G,cb+32+a*4)){ a=bi; }
      bi=bi+1;
    }
    let m:i32=50;
    let an:i32=get32(G,cb+16+a*4);
    if(an>0){ m=get32(G,cb+a*4)/an; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    let vs:i32=get32(G,pbase+e*4);
    let w:i32=0;
    let erra:i32=0;
    let ei:i32=0;
    while(ei<4){
      let pr:i32=50;
      let cn:i32=get32(G,cb+16+ei*4);
      if(cn>0){ pr=get32(G,cb+ei*4)/cn; }
      let er:i32=pr-vs;
      if(er<0){ er=0-er; }
      set32(G,3680028+ei*4,er);
      let sc:i32=get32(G,cb+32+ei*4);
      set32(G,cb+32+ei*4,(3*sc+er)/4);
      if(ei==0){ w=0; }
      else {
        if(er<get32(G,3680028+w*4)){ w=ei; }
      }
      if(ei==a){ erra=er; }
      ei=ei+1;
    }
    set32(G,cb+w*4,get32(G,cb+w*4)+vs);
    set32(G,cb+16+w*4,get32(G,cb+16+w*4)+1);
    set32(G,cb+56+w*4,get32(G,cb+56+w*4)+1);
    set32(G,cb+72+w*4,get32(G,cb+72+w*4)+get32(G,3680028+w*4));
    let cc:i32=get32(G,cb+48);
    if(erra>20){ cc=cc+1; } else { cc=0; }
    if(cc>=3){
      let mask:i32=0;
      let mi:i32=0;
      while(mi<4){
        let mp:i32=prot(G,cb,mi);
        if(mp==1){ mask=mask+(1<<mi); }
        mi=mi+1;
      }
      let v:i32=-1;
      let vi:i32=3;
      while(vi>=0){
        let ok:i32=1;
        if(vi==a){ ok=0; }
        if(vi==w){ ok=0; }
        let vp:i32=prot(G,cb,vi);
        if(vp==1){ ok=0; }
        if(ok==1){
          if(v==-1){ v=vi; }
          else {
            let s1:i32=get32(G,cb+32+vi*4);
            let s2:i32=get32(G,cb+32+v*4);
            if(s1>s2){ v=vi; }
          }
        }
        vi=vi-1;
      }
      let tg:i32=get32(G,cb+52);
      let pv0:i32=0;
      if(v>=0){ pv0=prot(G,cb,v); }
      if(tg<32){
        set32(G,tlog+tg*4,e);
        set32(G,tflg+tg*4,mask);
        if(v<0){ set32(G,tpro+tg*4,99); }
        else {
          if(pv0==1){ set32(G,tpro+tg*4,v+10); }
          else { set32(G,tpro+tg*4,v); }
        }
      }
      if(v<0){
        let dc:i32=get32(G,decloff);
        set32(G,decloff,dc+1);
      }
      else {
        if(pv0==1){
          set32(G,3681208,get32(G,3681208)+1);
        }
        set32(G,cb+v*4,vs);
        set32(G,cb+16+v*4,1);
        set32(G,cb+32+v*4,0);
        set32(G,cb+56+v*4,0);
        set32(G,cb+72+v*4,0);
      }
      set32(G,cb+52,tg+1);
      cc=0;
    }
    set32(G,cb+48,cc);
    if(cond==1){
      if(e==11){
        let okx:i32=0;
        if(get32(G,cb)==180){ if(get32(G,cb+16)==9){ okx=1; } }
        set32(G,3681212,get32(G,3681212)+okx);
        snap(G,cb,snapD);
      }
      if(e==671){ snap(G,cb,snapR); }
      if(e==731){ snap(G,cb,snapB); }
    }
    else {
      if(cond==0){
        if(e==659){ snap(G,cb,snapR); }
        if(e==719){ snap(G,cb,snapB); }
      }
      else {
        if(e==11){
          let okw:i32=0;
          if(get32(G,cb)==180){ if(get32(G,cb+16)==9){ okw=2; } }
          set32(G,3681212,get32(G,3681212)+okw);
          snap(G,cb,snapD);
        }
        if(e==671){ snap(G,cb,snapR); }
        if(e==731){ snap(G,cb,snapB); }
        if(e==851){ snap(G,cb,snapR3); }
      }
    }
    e=e+1;
  }
  return;
}
// ---- single-cell condition (MD rule, unchanged) ----
fn run_single(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,ne:i32)void {
  let sum:i32=0;
  let n:i32=0;
  let e:i32=0;
  while(e<ne){
    let m:i32=50;
    if(n>0){ m=sum/n; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    sum=sum+get32(G,pbase+e*4);
    n=n+1;
    e=e+1;
  }
  return;
}
// ---- zero-padded episode label ----
fn o_e4(b:[]u8,c:i32,e:i32)i32 {
  let en:i32=e+1;
  c=o_app(b,c,"E");
  if(en<1000){ c=o_app(b,c,"0"); }
  if(en<100){ c=o_app(b,c,"0"); }
  if(en<10){ c=o_app(b,c,"0"); }
  c=o_i64(b,c,en as i64);
  return c;
}
// ---- one trigger log line body: " E<ep>:<victim><U/P/D> F=<mask>" ----
fn o_trig(B:[]u8,c:i32,G:[]u8,tlog:i32,tpro:i32,tflg:i32,tg:i32)i32 {
  let ti:i32=0;
  while(ti<tg){
    if(ti<32){
      c=o_app(B,c," E");
      c=o_i64(B,c,(get32(G,tlog+ti*4)+1) as i64);
      c=o_app(B,c,":");
      let pv:i32=get32(G,tpro+ti*4);
      if(pv==99){ c=o_app(B,c,"D"); }
      else {
        if(pv>=10){ c=o_i64(B,c,(pv-10) as i64); c=o_app(B,c,"P"); }
        else { c=o_i64(B,c,pv as i64); c=o_app(B,c,"U"); }
      }
      c=o_app(B,c," F=");
      c=o_i64(B,c,get32(G,tflg+ti*4) as i64);
    }
    ti=ti+1;
  }
  return c;
}
fn main()i32 {
  let p:*u8=_zag_malloc(4194304) as *u8;
  let G:[]u8=p[0..4194304];
  let z:i32=0;
  while(z<4194304){ G[z]=0; z=z+1; }
  gen(G);
  run_multi(G,3655352,12152,8,3667496,3679764,3681216,3681296,3681376,0,3680044,3680428,3680812,3681196,732,1);
  run_multi(G,3658280,890552,2936,3670424,3679852,0,3681456,3681536,0,3680172,3680684,3681068,3681200,720,0);
  run_multi(G,3664088,2632952,8744,3676232,3679940,3681616,3681696,3681776,3681856,3680300,3680556,3680940,3681204,852,2);
  run_single(G,3661160,1754552,5816,3673304,732);
  // ---- frozen metrics ----
  let rx:i32=0;
  let e:i32=12;
  while(e<672){
    let mm:i32=get32(G,3667496+e*4);
    let dd:i32=mm-80;
    if(dd<0){ dd=0-dd; }
    if(dd<=1){ if(rx==0){ rx=e-11; } }
    e=e+1;
  }
  let ry:i32=0;
  e=0;
  while(e<660){
    let mm2:i32=get32(G,3670424+e*4);
    let dd2:i32=mm2-80;
    if(dd2<0){ dd2=0-dd2; }
    if(dd2<=1){ if(ry==0){ ry=e+1; } }
    e=e+1;
  }
  let rz:i32=0;
  e=12;
  while(e<672){
    let mm3:i32=get32(G,3673304+e*4);
    let dd3:i32=mm3-80;
    if(dd3<0){ dd3=0-dd3; }
    if(dd3<=1){ if(rz==0){ rz=e-11; } }
    e=e+1;
  }
  let rxf:i32=0;
  let k:i32=1;
  while(k<=660){
    let mx:i32=get32(G,3667496+(11+k)*4);
    let my:i32=get32(G,3670424+(k-1)*4);
    let ddf:i32=mx-my;
    if(ddf<0){ ddf=0-ddf; }
    if(ddf<=1){ if(rxf==0){ rxf=k; } }
    k=k+1;
  }
  let costxy:i64=0;
  let costxz:i64=0;
  e=12;
  while(e<672){
    costxy=costxy+(get32(G,3655352+e*4) as i64)-(get32(G,3658280+(e-12)*4) as i64);
    costxz=costxz+(get32(G,3655352+e*4) as i64)-(get32(G,3661160+e*4) as i64);
    e=e+1;
  }
  let rxb2:i32=0;
  e=672;
  while(e<732){
    let mmb:i32=get32(G,3667496+e*4);
    let ddb:i32=mmb-20;
    if(ddb<0){ ddb=0-ddb; }
    if(ddb<=1){ if(rxb2==0){ rxb2=e-671; } }
    e=e+1;
  }
  let rwb2:i32=0;
  e=672;
  while(e<732){
    let mmw:i32=get32(G,3676232+e*4);
    let ddw:i32=mmw-20;
    if(ddw<0){ ddw=0-ddw; }
    if(ddw<=1){ if(rwb2==0){ rwb2=e-671; } }
    e=e+1;
  }
  let rw:i32=0;
  e=732;
  while(e<852){
    let mmr:i32=get32(G,3676232+e*4);
    let ddr:i32=mmr-80;
    if(ddr<0){ ddr=0-ddr; }
    if(ddr<=1){ if(rw==0){ rw=e-731; } }
    e=e+1;
  }
  // ---- bars ----
  let b5a:i32=0;
  if(rx>=1){ if(rx<=99){ b5a=1; } }
  let b5b:i32=0;
  if(rz>=500){ b5b=1; }
  let b5c:i32=0;
  if(costxy<4690){ b5c=1; }
  let b5d:i32=0;
  if(rxb2>=1){ if(rxb2<=30){ b5d=1; } }
  let b8:i32=0;
  if(get32(G,3681208)==0){ b8=1; }
  let mxe:i32=0;
  e=0;
  while(e<732){
    let a1:i32=get32(G,3655352+e*4);
    if(a1>mxe){ mxe=a1; }
    let a3:i32=get32(G,3661160+e*4);
    if(a3>mxe){ mxe=a3; }
    e=e+1;
  }
  e=0;
  while(e<720){
    let a2:i32=get32(G,3658280+e*4);
    if(a2>mxe){ mxe=a2; }
    e=e+1;
  }
  e=0;
  while(e<852){
    let a4:i32=get32(G,3664088+e*4);
    if(a4>mxe){ mxe=a4; }
    e=e+1;
  }
  let b5e:i32=0;
  if(mxe<=1200){ if(get32(G,3679640)==0){ b5e=1; } }
  // B4a: 12 block-D values pairwise distinct (X)
  let db:i32=1;
  let i2:i32=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      if(get32(G,8+i2*4)==get32(G,8+j*4)){ db=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  // XDISJ: same-episode flip vectors differ across conditions
  let xd:i32=1;
  e=0;
  while(e<660){
    if(veq(G,12152+(12+e)*1200,890552+e*1200,1200)==1){ xd=0; }
    if(veq(G,12152+(12+e)*1200,1754552+(12+e)*1200,1200)==1){ xd=0; }
    if(veq(G,890552+e*1200,1754552+(12+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(veq(G,12152+(672+e)*1200,890552+(660+e)*1200,1200)==1){ xd=0; }
    if(veq(G,12152+(672+e)*1200,1754552+(672+e)*1200,1200)==1){ xd=0; }
    if(veq(G,890552+(660+e)*1200,1754552+(672+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  e=0;
  while(e<732){
    if(veq(G,2632952+e*1200,12152+e*1200,1200)==1){ xd=0; }
    if(veq(G,2632952+e*1200,1754552+e*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  e=0;
  while(e<720){
    if(veq(G,2632952+e*1200,890552+e*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  // PARID: values identical across conditions
  let parid:i32=1;
  e=0;
  while(e<732){
    if(get32(G,8+e*4)!=get32(G,5816+e*4)){ parid=0; }
    if(get32(G,8+e*4)!=get32(G,8744+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<660){
    if(get32(G,8+(12+e)*4)!=get32(G,2936+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(get32(G,8+(672+e)*4)!=get32(G,2936+(660+e)*4)){ parid=0; }
    e=e+1;
  }
  // MARG: per-condition per-block ones-fraction in fixed bands
  let sXd:i64=0;
  let kk:i32=0;
  while(kk<14400){ sXd=sXd+(G[12152+kk] as i64); kk=kk+1; }
  let sXr:i64=0;
  kk=0;
  while(kk<792000){ sXr=sXr+(G[12152+14400+kk] as i64); kk=kk+1; }
  let sXb:i64=0;
  kk=0;
  while(kk<72000){ sXb=sXb+(G[12152+806400+kk] as i64); kk=kk+1; }
  let sYr:i64=0;
  kk=0;
  while(kk<792000){ sYr=sYr+(G[890552+kk] as i64); kk=kk+1; }
  let sYb:i64=0;
  kk=0;
  while(kk<72000){ sYb=sYb+(G[890552+792000+kk] as i64); kk=kk+1; }
  let sZd:i64=0;
  kk=0;
  while(kk<14400){ sZd=sZd+(G[1754552+kk] as i64); kk=kk+1; }
  let sZr:i64=0;
  kk=0;
  while(kk<792000){ sZr=sZr+(G[1754552+14400+kk] as i64); kk=kk+1; }
  let sZb:i64=0;
  kk=0;
  while(kk<72000){ sZb=sZb+(G[1754552+806400+kk] as i64); kk=kk+1; }
  let sWd:i64=0;
  kk=0;
  while(kk<14400){ sWd=sWd+(G[2632952+kk] as i64); kk=kk+1; }
  let sWr:i64=0;
  kk=0;
  while(kk<792000){ sWr=sWr+(G[2632952+14400+kk] as i64); kk=kk+1; }
  let sWb:i64=0;
  kk=0;
  while(kk<72000){ sWb=sWb+(G[2632952+806400+kk] as i64); kk=kk+1; }
  let sWr3:i64=0;
  kk=0;
  while(kk<72000){ sWr3=sWr3+(G[2632952+878400+kk] as i64); kk=kk+1; }
  let mg:i32=1;
  if(sXd<2880){ mg=0; } if(sXd>5040){ mg=0; }
  if(sXr<554400){ mg=0; } if(sXr>712800){ mg=0; }
  if(sXb<8640){ mg=0; } if(sXb>20160){ mg=0; }
  if(sYr<554400){ mg=0; } if(sYr>712800){ mg=0; }
  if(sYb<8640){ mg=0; } if(sYb>20160){ mg=0; }
  if(sZd<2880){ mg=0; } if(sZd>5040){ mg=0; }
  if(sZr<554400){ mg=0; } if(sZr>712800){ mg=0; }
  if(sZb<8640){ mg=0; } if(sZb>20160){ mg=0; }
  if(sWd<2880){ mg=0; } if(sWd>5040){ mg=0; }
  if(sWr<554400){ mg=0; } if(sWr>712800){ mg=0; }
  if(sWb<8640){ mg=0; } if(sWb>20160){ mg=0; }
  if(sWr3<50400){ mg=0; } if(sWr3>64800){ mg=0; }
  let b5f:i32=0;
  if(parid==1){ if(xd==1){ b5f=1; } }
  let b5g:i32=0;
  if(get32(G,3681212)==3){ b5g=1; }
  // ---- output ----
  let q:*u8=_zag_malloc(262144) as *u8;
  let B:[]u8=q[0..262144];
  let c:i32=0;
  c=o_app(B,c,"MA2 SEEDB=20261020 SEEDX=20261021 SEEDY=20261022 SEEDZ=20261023 SEEDW=20261024 W=20 TOL=5 N=1200 K=4 FAIL=20 TRIG=3 PACT=5 PERR=10"); c=o_nl(B,c);
  e=0;
  while(e<732){
    c=o_app(B,c,"X ");
    c=o_e4(B,c,e);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,8+e*4) as i64);
    c=o_app(B,c," EX=");
    c=o_i64(B,c,get32(G,3655352+e*4) as i64);
    c=o_app(B,c," MXA=");
    c=o_i64(B,c,get32(G,3667496+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  e=0;
  while(e<720){
    c=o_app(B,c,"Y ");
    c=o_e4(B,c,e);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,2936+e*4) as i64);
    c=o_app(B,c," EY=");
    c=o_i64(B,c,get32(G,3658280+e*4) as i64);
    c=o_app(B,c," MYA=");
    c=o_i64(B,c,get32(G,3670424+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  e=0;
  while(e<732){
    c=o_app(B,c,"Z ");
    c=o_e4(B,c,e);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,5816+e*4) as i64);
    c=o_app(B,c," EZ=");
    c=o_i64(B,c,get32(G,3661160+e*4) as i64);
    c=o_app(B,c," MZ=");
    c=o_i64(B,c,get32(G,3673304+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  e=0;
  while(e<852){
    c=o_app(B,c,"W ");
    c=o_e4(B,c,e);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,8744+e*4) as i64);
    c=o_app(B,c," EW=");
    c=o_i64(B,c,get32(G,3664088+e*4) as i64);
    c=o_app(B,c," MWA=");
    c=o_i64(B,c,get32(G,3676232+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  let sn:i32=0;
  while(sn<9){
    let sb:i32=3681216+sn*80;
    if(sn==0){ c=o_app(B,c,"SNAPXD"); }
    if(sn==1){ c=o_app(B,c,"SNAPXR"); }
    if(sn==2){ c=o_app(B,c,"SNAPXB"); }
    if(sn==3){ c=o_app(B,c,"SNAPYR"); }
    if(sn==4){ c=o_app(B,c,"SNAPYB"); }
    if(sn==5){ c=o_app(B,c,"SNAPWD"); }
    if(sn==6){ c=o_app(B,c,"SNAPWR"); }
    if(sn==7){ c=o_app(B,c,"SNAPWB"); }
    if(sn==8){ c=o_app(B,c,"SNAPWR3"); }
    let ci:i32=0;
    while(ci<4){
      c=o_app(B,c," S");
      c=o_i64(B,c,ci as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,get32(G,sb+ci*4) as i64);
      c=o_app(B,c," N");
      c=o_i64(B,c,ci as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,get32(G,sb+16+ci*4) as i64);
      c=o_app(B,c," C");
      c=o_i64(B,c,ci as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,get32(G,sb+32+ci*4) as i64);
      c=o_app(B,c," WP");
      c=o_i64(B,c,ci as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,get32(G,sb+48+ci*4) as i64);
      c=o_app(B,c," WQ");
      c=o_i64(B,c,ci as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,get32(G,sb+64+ci*4) as i64);
      ci=ci+1;
    }
    c=o_nl(B,c);
    sn=sn+1;
  }
  let tgx:i32=get32(G,3679764+52);
  c=o_app(B,c,"TRIGX n=");
  c=o_i64(B,c,tgx as i64);
  c=o_trig(B,c,G,3680044,3680428,3680812,tgx);
  c=o_nl(B,c);
  let tgy:i32=get32(G,3679852+52);
  c=o_app(B,c,"TRIGY n=");
  c=o_i64(B,c,tgy as i64);
  c=o_trig(B,c,G,3680172,3680684,3681068,tgy);
  c=o_nl(B,c);
  let tgw:i32=get32(G,3679940+52);
  c=o_app(B,c,"TRIGW n=");
  c=o_i64(B,c,tgw as i64);
  c=o_trig(B,c,G,3680300,3680556,3680940,tgw);
  c=o_nl(B,c);
  c=o_app(B,c,"DECLX n=");
  c=o_i64(B,c,get32(G,3681196) as i64);
  c=o_app(B,c," DECLY n=");
  c=o_i64(B,c,get32(G,3681200) as i64);
  c=o_app(B,c," DECLW n=");
  c=o_i64(B,c,get32(G,3681204) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"PROTDEST=");
  c=o_i64(B,c,get32(G,3681208) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"RX="); c=o_i64(B,c,rx as i64);
  c=o_app(B,c," RY="); c=o_i64(B,c,ry as i64);
  c=o_app(B,c," RZ="); c=o_i64(B,c,rz as i64);
  c=o_app(B,c," RXF="); c=o_i64(B,c,rxf as i64);
  c=o_app(B,c," RXB2="); c=o_i64(B,c,rxb2 as i64);
  c=o_app(B,c," RWB2="); c=o_i64(B,c,rwb2 as i64);
  c=o_app(B,c," RW="); c=o_i64(B,c,rw as i64);
  c=o_app(B,c," COSTXY="); c=o_i64(B,c,costxy);
  c=o_app(B,c," COSTXZ="); c=o_i64(B,c,costxz);
  c=o_nl(B,c);
  c=o_app(B,c,"B5A="); c=o_i64(B,c,b5a as i64);
  c=o_app(B,c," B5B="); c=o_i64(B,c,b5b as i64);
  c=o_app(B,c," B5C="); c=o_i64(B,c,b5c as i64);
  c=o_app(B,c," B5D="); c=o_i64(B,c,b5d as i64);
  c=o_app(B,c," B5E="); c=o_i64(B,c,b5e as i64);
  c=o_app(B,c," B5F="); c=o_i64(B,c,b5f as i64);
  c=o_app(B,c," B5G="); c=o_i64(B,c,b5g as i64);
  c=o_app(B,c," B8="); c=o_i64(B,c,b8 as i64);
  c=o_app(B,c," DISTINCTD="); c=o_i64(B,c,db as i64);
  c=o_app(B,c," PARID="); c=o_i64(B,c,parid as i64);
  c=o_app(B,c," XDISJ="); c=o_i64(B,c,xd as i64);
  c=o_app(B,c," MARG="); c=o_i64(B,c,mg as i64);
  c=o_app(B,c," GENFAIL="); c=o_i64(B,c,get32(G,3679640) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// sp_harness.zag -- SUBSUMPTION-P0 battery harness (new code).
// Calls the frozen C424 u_* module (sp_module.zag, byte-identical)
// and the byte-copied C433 goal constructors (sp_world.zag).
// This harness contains NO topo sort, NO procedure executor, and
// NO plan records. It loads frozen tables, calls module ops, reads
// goal records as data, and logs outcomes. All numeric tables are
// frozen data copied from the committed C433 REPORT / C424 PREREG.
// Pure Zag. Deterministic.

// Contract bases (20 ints each: 4 header + 2 clauses x 8).
// 2000 CB801, 2100 CB802, 2200 CB807, 2300 CB811, 2400 CB802R,
// 2500 CBCOV, 2600 CBRET, 2700 CBVFY, 2800 CBCNT,
// 2900 CB813, 3000 CB814, 3100 CB808, 3200 CB815, 3300 CB810,
// 3400 scratch.

fn sp_zero_contract(S:[]u8,base:i32)void {
  let i:i32=0;
  while(i<20){ ss(S,base+i,0); i=i+1; }
  return;
}
fn sp_zero_counters(S:[]u8)void {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1); ss(S,912,0);
  ss(S,916,0); ss(S,920,0); ss(S,924,0); ss(S,925,0);
  return;
}
fn sp_acc(S:[]u8,j:i32,a:i32,b:i32,c:i32,d:i32,e:i32,f:i32,g:i32)void {
  let o:i32=304+j*7;
  ss(S,o,a); ss(S,o+1,b); ss(S,o+2,c); ss(S,o+3,d);
  ss(S,o+4,e); ss(S,o+5,f); ss(S,o+6,g);
  return;
}
fn sp_rej(S:[]u8,j:i32,a:i32,b:i32,c:i32,d:i32,e:i32,f:i32,g:i32)void {
  let o:i32=528+j*7;
  ss(S,o,a); ss(S,o+1,b); ss(S,o+2,c); ss(S,o+3,d);
  ss(S,o+4,e); ss(S,o+5,f); ss(S,o+6,g);
  return;
}

// ---- frozen table loaders (experimental data) ----
// B1: trial evidence from C433 REPORT K3c (per-tag [tag, fam]).
fn sp_load_bind801(S:[]u8)void {
  ss(S,300,2); ss(S,301,1); ss(S,302,2);
  sp_acc(S,0,2,801,0,0,0,0,0);
  sp_rej(S,0,2,801,1,0,0,0,0);
  sp_rej(S,1,2,801,2,0,0,0,0);
  return;
}
fn sp_load_bind802(S:[]u8)void {
  ss(S,300,2); ss(S,301,1); ss(S,302,2);
  sp_acc(S,0,2,802,1,0,0,0,0);
  sp_rej(S,0,2,802,0,0,0,0,0);
  sp_rej(S,1,2,802,2,0,0,0,0);
  return;
}
fn sp_load_bind807(S:[]u8)void {
  ss(S,300,2); ss(S,301,1); ss(S,302,2);
  sp_acc(S,0,2,807,2,0,0,0,0);
  sp_rej(S,0,2,807,0,0,0,0,0);
  sp_rej(S,1,2,807,1,0,0,0,0);
  return;
}
fn sp_load_bind811(S:[]u8)void {
  ss(S,300,2); ss(S,301,0); ss(S,302,3);
  sp_rej(S,0,2,811,0,0,0,0,0);
  sp_rej(S,1,2,811,1,0,0,0,0);
  sp_rej(S,2,2,811,2,0,0,0,0);
  return;
}
fn sp_load_bind802_new(S:[]u8)void {
  ss(S,300,2); ss(S,301,1); ss(S,302,2);
  sp_acc(S,0,2,802,2,0,0,0,0);
  sp_rej(S,0,2,802,0,0,0,0,0);
  sp_rej(S,1,2,802,1,0,0,0,0);
  return;
}
// B2: coverage evidence from C433 REPORT learner state ([rel]).
fn sp_load_cov(S:[]u8)void {
  ss(S,300,1); ss(S,301,2); ss(S,302,6);
  sp_acc(S,0,1,601,0,0,0,0,0);
  sp_acc(S,1,1,602,0,0,0,0,0);
  sp_rej(S,0,1,603,0,0,0,0,0);
  sp_rej(S,1,1,607,0,0,0,0,0);
  sp_rej(S,2,1,609,0,0,0,0,0);
  sp_rej(S,3,1,701,0,0,0,0,0);
  sp_rej(S,4,1,702,0,0,0,0,0);
  sp_rej(S,5,1,707,0,0,0,0,0);
  return;
}
fn sp_load_cov_new(S:[]u8)void {
  ss(S,300,1); ss(S,301,2); ss(S,302,6);
  sp_acc(S,0,1,701,0,0,0,0,0);
  sp_acc(S,1,1,702,0,0,0,0,0);
  sp_rej(S,0,1,601,0,0,0,0,0);
  sp_rej(S,1,1,602,0,0,0,0,0);
  sp_rej(S,2,1,603,0,0,0,0,0);
  sp_rej(S,3,1,607,0,0,0,0,0);
  sp_rej(S,4,1,609,0,0,0,0,0);
  sp_rej(S,5,1,707,0,0,0,0,0);
  return;
}
// V: step records from C433 S1 episodes + world facts.
// RET [rel, obj, subj].
fn sp_load_ret(S:[]u8)void {
  ss(S,300,3); ss(S,301,4); ss(S,302,6);
  sp_acc(S,0,3,601,623,613,0,0,0);
  sp_acc(S,1,3,602,625,614,0,0,0);
  sp_acc(S,2,3,601,621,611,0,0,0);
  sp_acc(S,3,3,602,622,611,0,0,0);
  sp_rej(S,0,3,601,623,611,0,0,0);
  sp_rej(S,1,3,602,625,611,0,0,0);
  sp_rej(S,2,3,601,621,613,0,0,0);
  sp_rej(S,3,3,602,622,614,0,0,0);
  sp_rej(S,4,3,601,625,614,0,0,0);
  sp_rej(S,5,3,602,623,613,0,0,0);
  return;
}
// VFY [subj, step, rel, obj, pass].
fn sp_load_vfy(S:[]u8)void {
  ss(S,300,5); ss(S,301,8); ss(S,302,6);
  sp_acc(S,0,5,611,0,601,621,1,0);
  sp_acc(S,1,5,611,1,602,622,1,0);
  sp_acc(S,2,5,612,0,603,621,1,0);
  sp_acc(S,3,5,612,1,601,622,1,0);
  sp_acc(S,4,5,613,0,602,624,1,0);
  sp_acc(S,5,5,613,1,603,622,1,0);
  sp_acc(S,6,5,614,0,601,624,1,0);
  sp_acc(S,7,5,614,1,603,629,0,0);
  sp_rej(S,0,5,611,0,601,621,0,0);
  sp_rej(S,1,5,611,0,601,622,1,0);
  sp_rej(S,2,5,612,0,603,621,0,0);
  sp_rej(S,3,5,614,1,603,629,1,0);
  sp_rej(S,4,5,613,0,602,624,0,0);
  sp_rej(S,5,5,612,1,602,622,1,0);
  return;
}
// CNT [rel, subj, count].
fn sp_load_cnt(S:[]u8)void {
  ss(S,300,3); ss(S,301,7); ss(S,302,6);
  sp_acc(S,0,3,601,611,2,0,0,0);
  sp_acc(S,1,3,602,611,2,0,0,0);
  sp_acc(S,2,3,603,612,2,0,0,0);
  sp_acc(S,3,3,601,613,2,0,0,0);
  sp_acc(S,4,3,607,631,1,0,0,0);
  sp_acc(S,5,3,701,711,2,0,0,0);
  sp_acc(S,6,3,702,713,2,0,0,0);
  sp_rej(S,0,3,601,611,1,0,0,0);
  sp_rej(S,1,3,607,631,2,0,0,0);
  sp_rej(S,2,3,602,611,1,0,0,0);
  sp_rej(S,3,3,601,613,1,0,0,0);
  sp_rej(S,4,3,701,711,1,0,0,0);
  sp_rej(S,5,3,603,612,1,0,0,0);
  return;
}

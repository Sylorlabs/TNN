// ---- logging helper: contract state dump ----
fn sp_dump(S:[]u8,OUT:[]u8,cur:i32,base:i32)i32 {
  cur=e1str(OUT,cur," set="); cur=e1i64(OUT,cur,sg(S,base+1) as i64);
  cur=e1str(OUT,cur," nf="); cur=e1i64(OUT,cur,sg(S,base+2) as i64);
  cur=e1str(OUT,cur," nc="); cur=e1i64(OUT,cur,sg(S,base+3) as i64);
  cur=e1str(OUT,cur," fiterr="); cur=e1i64(OUT,cur,sg(S,920) as i64);
  let b:i32=base+4;
  cur=e1str(OUT,cur," cl0=");
  cur=e1i64(OUT,cur,sg(S,b) as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,sg(S,b+1) as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,sg(S,b+2) as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,sg(S,b+3) as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,sg(S,b+4) as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,sg(S,b+5) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// ---- Arm B1: bindings as admission contracts ----
fn sp_bind_one(S:[]u8,OUT:[]u8,cur:i32,base:i32)i32 {
  let r:i32=u_induct(S,base);
  let t:i32=u_acc(S,0,0);
  cur=e1str(OUT,cur,"B1 BIND "); cur=e1i64(OUT,cur,t as i64);
  cur=e1str(OUT,cur," induct="); cur=e1i64(OUT,cur,r as i64);
  cur=sp_dump(S,OUT,cur,base);
  let c0:i32=u_check(S,base,2,t,0,0,0,0,0);
  let c1:i32=u_check(S,base,2,t,1,0,0,0,0);
  let c2:i32=u_check(S,base,2,t,2,0,0,0,0);
  cur=e1str(OUT,cur,"B1 ROUTE "); cur=e1i64(OUT,cur,t as i64);
  cur=e1str(OUT,cur," fam0="); cur=e1i64(OUT,cur,c0 as i64);
  cur=e1str(OUT,cur," fam1="); cur=e1i64(OUT,cur,c1 as i64);
  cur=e1str(OUT,cur," fam2="); cur=e1i64(OUT,cur,c2 as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn arm_b1(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"ARM=B1\n");
  sp_load_bind801(S); sp_zero_contract(S,2000);
  cur=sp_bind_one(S,OUT,cur,2000);
  sp_load_bind802(S); sp_zero_contract(S,2100);
  cur=sp_bind_one(S,OUT,cur,2100);
  sp_load_bind807(S); sp_zero_contract(S,2200);
  cur=sp_bind_one(S,OUT,cur,2200);
  sp_load_bind811(S); sp_zero_contract(S,2300);
  let r811:i32=u_induct(S,2300);
  cur=e1str(OUT,cur,"B1 BIND 811 induct="); cur=e1i64(OUT,cur,r811 as i64);
  cur=sp_dump(S,OUT,cur,2300);
  let d0:i32=u_check(S,2300,2,811,0,0,0,0,0);
  let d1:i32=u_check(S,2300,2,811,1,0,0,0,0);
  let d2:i32=u_check(S,2300,2,811,2,0,0,0,0);
  let dec:i32=0;
  if(d0==0){ if(d1==0){ if(d2==0){ dec=1; } } }
  cur=e1str(OUT,cur,"B1 DECLINE 811="); cur=e1i64(OUT,cur,dec as i64);
  cur=e1str(OUT,cur,"\n");
  // revision demo on scratch contract 2400 (802 binding)
  sp_load_bind802(S); sp_zero_contract(S,2400);
  let rr0:i32=u_induct(S,2400);
  sp_zero_counters(S); ss(S,7,3);
  let t2:i32=u_acc(S,0,0);
  let iv1:i32=u_invalidate(S,2400,1,0);
  let iv2:i32=u_invalidate(S,2400,1,0);
  cur=e1str(OUT,cur,"B1 REV run="); cur=e1i64(OUT,cur,sg(S,900) as i64);
  cur=e1str(OUT,cur," dc="); cur=e1i64(OUT,cur,sg(S,2404+6) as i64);
  cur=e1str(OUT,cur," active="); cur=e1i64(OUT,cur,sg(S,2404+5) as i64);
  cur=e1str(OUT,cur," iv="); cur=e1i64(OUT,cur,iv1 as i64);
  cur=e1str(OUT,cur,","); cur=e1i64(OUT,cur,iv2 as i64);
  cur=e1str(OUT,cur,"\n");
  let ch0:i32=u_check(S,2400,2,t2,1,0,0,0,0);
  cur=e1str(OUT,cur,"B1 REV retired-check="); cur=e1i64(OUT,cur,ch0 as i64);
  cur=e1str(OUT,cur,"\n");
  let iv3:i32=u_invalidate(S,2400,1,0);
  cur=e1str(OUT,cur,"B1 REV req="); cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur," first="); cur=e1i64(OUT,cur,sg(S,908) as i64);
  cur=e1str(OUT,cur,"\n");
  sp_load_bind802_new(S);
  u_revise(S,2400,1);
  cur=e1str(OUT,cur,"B1 REV olderr="); cur=e1i64(OUT,cur,sg(S,924) as i64);
  cur=e1str(OUT,cur," revcount="); cur=e1i64(OUT,cur,sg(S,904) as i64);
  cur=sp_dump(S,OUT,cur,2400);
  let n1:i32=u_check(S,2400,2,t2,2,0,0,0,0);
  let n2:i32=u_check(S,2400,2,t2,1,0,0,0,0);
  cur=e1str(OUT,cur,"B1 REV newroute fam2="); cur=e1i64(OUT,cur,n1 as i64);
  cur=e1str(OUT,cur," fam1="); cur=e1i64(OUT,cur,n2 as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// ---- Arm B2: version routing as coverage admission ----
fn arm_b2(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"ARM=B2\n");
  sp_load_cov(S); sp_zero_contract(S,2500);
  let r:i32=u_induct(S,2500);
  cur=e1str(OUT,cur,"B2 COV induct="); cur=e1i64(OUT,cur,r as i64);
  cur=sp_dump(S,OUT,cur,2500);
  let k601:i32=u_check(S,2500,1,601,0,0,0,0,0);
  let k602:i32=u_check(S,2500,1,602,0,0,0,0,0);
  let k603:i32=u_check(S,2500,1,603,0,0,0,0,0);
  let k701:i32=u_check(S,2500,1,701,0,0,0,0,0);
  cur=e1str(OUT,cur,"B2 ROUTE 601="); cur=e1i64(OUT,cur,k601 as i64);
  cur=e1str(OUT,cur," 602="); cur=e1i64(OUT,cur,k602 as i64);
  cur=e1str(OUT,cur," 603="); cur=e1i64(OUT,cur,k603 as i64);
  cur=e1str(OUT,cur," 701="); cur=e1i64(OUT,cur,k701 as i64);
  cur=e1str(OUT,cur,"\n");
  sp_zero_counters(S); ss(S,7,5);
  let w1:i32=u_invalidate(S,2500,1,0);
  let w2:i32=u_invalidate(S,2500,1,0);
  let w3:i32=u_invalidate(S,2500,1,0);
  cur=e1str(OUT,cur,"B2 REV run="); cur=e1i64(OUT,cur,sg(S,900) as i64);
  cur=e1str(OUT,cur," active="); cur=e1i64(OUT,cur,sg(S,2504+5) as i64);
  cur=e1str(OUT,cur," req="); cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur,"\n");
  sp_load_cov_new(S);
  u_revise(S,2500,1);
  cur=e1str(OUT,cur,"B2 REV olderr="); cur=e1i64(OUT,cur,sg(S,924) as i64);
  cur=e1str(OUT,cur," revcount="); cur=e1i64(OUT,cur,sg(S,904) as i64);
  cur=sp_dump(S,OUT,cur,2500);
  let m701:i32=u_check(S,2500,1,701,0,0,0,0,0);
  let m601:i32=u_check(S,2500,1,601,0,0,0,0,0);
  cur=e1str(OUT,cur,"B2 REV newroute 701="); cur=e1i64(OUT,cur,m701 as i64);
  cur=e1str(OUT,cur," 601="); cur=e1i64(OUT,cur,m601 as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// ---- Arm V: procedure step verification ----
fn arm_v(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"ARM=V\n");
  sp_load_ret(S); sp_zero_contract(S,2600);
  let rr:i32=u_induct(S,2600);
  cur=e1str(OUT,cur,"V RET induct="); cur=e1i64(OUT,cur,rr as i64);
  cur=sp_dump(S,OUT,cur,2600);
  // frozen C433 RET trace steps [rel, obj, subj]
  let q0:i32=u_check(S,2600,3,601,621,611,0,0,0);
  let q1:i32=u_check(S,2600,3,601,621,611,0,0,0);
  let q2:i32=u_check(S,2600,3,601,623,613,0,0,0);
  let q3:i32=u_check(S,2600,3,701,723,713,0,0,0);
  let q4:i32=u_check(S,2600,3,701,723,713,0,0,0);
  let q5:i32=u_check(S,2600,3,701,723,713,0,0,0);
  cur=e1str(OUT,cur,"V RET trace=");
  cur=e1i64(OUT,cur,q0 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,q1 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,q2 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,q3 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,q4 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,q5 as i64); cur=e1str(OUT,cur,"\n");
  let qc:i32=u_check(S,2600,3,601,621,612,0,0,0);
  cur=e1str(OUT,cur,"V RET corrupt="); cur=e1i64(OUT,cur,qc as i64);
  cur=e1str(OUT,cur,"\n");
  sp_load_vfy(S); sp_zero_contract(S,2700);
  let vr:i32=u_induct(S,2700);
  cur=e1str(OUT,cur,"V VFY induct="); cur=e1i64(OUT,cur,vr as i64);
  cur=sp_dump(S,OUT,cur,2700);
  // frozen C433 VFY trace steps [subj, step, rel, obj, pass]
  let v00:i32=u_check(S,2700,5,611,0,602,629,0,0);
  let v01:i32=u_check(S,2700,5,611,0,602,622,1,0);
  let v02:i32=u_check(S,2700,5,611,1,603,620,1,0);
  let v03:i32=u_check(S,2700,5,611,0,603,620,1,0);
  let v04:i32=u_check(S,2700,5,611,1,601,631,1,0);
  let v05:i32=u_check(S,2700,5,611,0,601,621,1,0);
  let v06:i32=u_check(S,2700,5,611,1,602,622,1,0);
  let v07:i32=u_check(S,2700,5,613,0,602,624,1,0);
  let v08:i32=u_check(S,2700,5,613,1,603,622,1,0);
  let v09:i32=u_check(S,2700,5,713,0,702,729,0,0);
  let v10:i32=u_check(S,2700,5,713,0,702,724,1,0);
  let v11:i32=u_check(S,2700,5,713,1,701,723,1,0);
  let v12:i32=u_check(S,2700,5,713,0,702,729,0,0);
  let v13:i32=u_check(S,2700,5,713,0,702,724,1,0);
  let v14:i32=u_check(S,2700,5,713,1,701,723,1,0);
  let v15:i32=u_check(S,2700,5,713,0,702,729,0,0);
  let v16:i32=u_check(S,2700,5,713,0,702,724,1,0);
  let v17:i32=u_check(S,2700,5,713,1,701,723,1,0);
  cur=e1str(OUT,cur,"V VFY trace=");
  cur=e1i64(OUT,cur,v00 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v01 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v02 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v03 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v04 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v05 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v06 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v07 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v08 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v09 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v10 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v11 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v12 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v13 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v14 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v15 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v16 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,v17 as i64); cur=e1str(OUT,cur,"\n");
  let vc:i32=u_check(S,2700,5,611,0,602,622,0,0);
  cur=e1str(OUT,cur,"V VFY corrupt="); cur=e1i64(OUT,cur,vc as i64);
  cur=e1str(OUT,cur,"\n");
  sp_load_cnt(S); sp_zero_contract(S,2800);
  let cr:i32=u_induct(S,2800);
  cur=e1str(OUT,cur,"V CNT induct="); cur=e1i64(OUT,cur,cr as i64);
  cur=sp_dump(S,OUT,cur,2800);
  // frozen C433 CNT trace steps [rel, subj, count]
  let c0:i32=u_check(S,2800,3,603,611,2,0,0,0);
  let c1:i32=u_check(S,2800,3,601,611,2,0,0,0);
  let c2:i32=u_check(S,2800,3,601,613,2,0,0,0);
  let c3:i32=u_check(S,2800,3,701,713,2,0,0,0);
  let c4:i32=u_check(S,2800,3,701,713,2,0,0,0);
  let c5:i32=u_check(S,2800,3,701,713,2,0,0,0);
  cur=e1str(OUT,cur,"V CNT trace=");
  cur=e1i64(OUT,cur,c0 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,c1 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,c2 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,c3 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,c4 as i64); cur=e1str(OUT,cur,",");
  cur=e1i64(OUT,cur,c5 as i64); cur=e1str(OUT,cur,"\n");
  let cc:i32=u_check(S,2800,3,603,611,3,0,0,0);
  cur=e1str(OUT,cur,"V CNT corrupt="); cur=e1i64(OUT,cur,cc as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// ---- goal record readers (byte offsets; w_* layout) ----
fn sp_need_off(G:[]u8,ni:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<ni){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn sp_need_tag(G:[]u8,ni:i32)i32 { return get32(G,sp_need_off(G,ni)); }
// tag -> its binding contract base (harness indexing, not learning)
fn sp_bind_base(t:i32)i32 {
  if(t==801){ return 2000; }
  if(t==802){ return 2100; }
  if(t==807){ return 2200; }
  return 2300;
}
// ---- Arm E: end-to-end generation attempt ----
fn sp_goal_e(S:[]u8,OUT:[]u8,cur:i32,G:[]u8)i32 {
  let gt:i32=get32(G,0);
  let nn:i32=get32(G,4);
  cur=e1str(OUT,cur,"E GOAL "); cur=e1i64(OUT,cur,gt as i64);
  cur=e1str(OUT,cur," needs="); cur=e1i64(OUT,cur,nn as i64);
  cur=e1str(OUT,cur,"\n");
  // E-a: bind each need through its admission contract
  let ni:i32=0;
  while(ni<nn){
    let t:i32=sp_need_tag(G,ni);
    let base:i32=sp_bind_base(t);
    let b0:i32=u_check(S,base,2,t,0,0,0,0,0);
    let b1:i32=u_check(S,base,2,t,1,0,0,0,0);
    let b2:i32=u_check(S,base,2,t,2,0,0,0,0);
    let fam:i32=-1;
    if(b0==1){ fam=0; }
    if(b1==1){ fam=1; }
    if(b2==1){ fam=2; }
    cur=e1str(OUT,cur,"E NEED "); cur=e1i64(OUT,cur,t as i64);
    cur=e1str(OUT,cur," fam="); cur=e1i64(OUT,cur,fam as i64);
    cur=e1str(OUT,cur,"\n");
    ni=ni+1;
  }
  // E-b: plan generation attempt (induct needs evidence; none exists)
  sp_zero_contract(S,3400);
  ss(S,300,2); ss(S,301,0); ss(S,302,0);
  let pr:i32=u_induct(S,3400);
  cur=e1str(OUT,cur,"E PLAN_CONTRACT="); cur=e1i64(OUT,cur,pr as i64);
  cur=e1str(OUT,cur,"\n");
  // E-c/E-d: no module op has a value in its codomain
  cur=e1str(OUT,cur,"E ANS_VALUE_SOURCE=none NEED0_OUTPUT=UNAVAILABLE\n");
  cur=e1str(OUT,cur,"E PLAN=none ANS=none\n");
  return cur;
}
fn arm_e(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"ARM=E\n");
  let G:[]u8=z_alloc(1024);
  mk_goal813_E0(G); cur=sp_goal_e(S,OUT,cur,G);
  mk_goal814_E1(G); cur=sp_goal_e(S,OUT,cur,G);
  mk_goal808_A0(G); cur=sp_goal_e(S,OUT,cur,G);
  mk_goal815_B0(G); cur=sp_goal_e(S,OUT,cur,G);
  mk_goal810(G); cur=sp_goal_e(S,OUT,cur,G);
  return cur;
}
// ---- Arm F: flat-memorization control ----
fn sp_tag_one(S:[]u8,OUT:[]u8,cur:i32,base:i32)i32 {
  let r:i32=u_induct(S,base);
  let t:i32=u_acc(S,0,0);
  cur=e1str(OUT,cur,"F TAG "); cur=e1i64(OUT,cur,t as i64);
  cur=e1str(OUT,cur," induct="); cur=e1i64(OUT,cur,r as i64);
  cur=sp_dump(S,OUT,cur,base);
  let s0:i32=u_check(S,base,1,t,0,0,0,0,0);
  cur=e1str(OUT,cur,"F RECOG "); cur=e1i64(OUT,cur,t as i64);
  cur=e1str(OUT,cur,"="); cur=e1i64(OUT,cur,s0 as i64);
  cur=e1str(OUT,cur,"\n");
  let nr:i32=sg(S,302);
  let k:i32=0;
  while(k<nr){
    let ot:i32=u_rej(S,k,0);
    let co:i32=u_check(S,base,1,ot,0,0,0,0,0);
    cur=e1str(OUT,cur,"F XREJ "); cur=e1i64(OUT,cur,ot as i64);
    cur=e1str(OUT,cur,"="); cur=e1i64(OUT,cur,co as i64);
    cur=e1str(OUT,cur,"\n");
    k=k+1;
  }
  let g816:i32=u_check(S,base,1,816,0,0,0,0,0);
  cur=e1str(OUT,cur,"F NOVEL816="); cur=e1i64(OUT,cur,g816 as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}
fn arm_f(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"ARM=F\n");
  sp_load_tag813(S); sp_zero_contract(S,2900);
  cur=sp_tag_one(S,OUT,cur,2900);
  sp_load_tag814(S); sp_zero_contract(S,3000);
  cur=sp_tag_one(S,OUT,cur,3000);
  sp_load_tag808(S); sp_zero_contract(S,3100);
  cur=sp_tag_one(S,OUT,cur,3100);
  sp_load_tag815(S); sp_zero_contract(S,3200);
  cur=sp_tag_one(S,OUT,cur,3200);
  sp_load_tag810(S); sp_zero_contract(S,3300);
  cur=sp_tag_one(S,OUT,cur,3300);
  // Non-compositional answer reproduction: the harness maps each
  // recognized tag to C433's frozen answer (supervised lookup).
  // Logged explicitly as NOT composition.
  cur=e1str(OUT,cur,"F LOOKUP NONCOMPOSITIONAL 813=7:1,611,0,1,611,1,2\n");
  cur=e1str(OUT,cur,"F LOOKUP NONCOMPOSITIONAL 814=8:1,611,1,611,1,611,1,2\n");
  cur=e1str(OUT,cur,"F LOOKUP NONCOMPOSITIONAL 808=6:1,613,1,613,1,2\n");
  cur=e1str(OUT,cur,"F LOOKUP NONCOMPOSITIONAL 815=7:1,713,0,1,713,1,2\n");
  cur=e1str(OUT,cur,"F SHARED_PROC_CONTRACTS=none F PLAN=none F VERSIONS=none\n");
  return cur;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"SP0-START\n");
  let S:[]u8=z_alloc(16384);
  cur=arm_b1(S,OUT,cur);
  cur=arm_b2(S,OUT,cur);
  cur=arm_v(S,OUT,cur);
  cur=arm_e(S,OUT,cur);
  cur=arm_f(S,OUT,cur);
  cur=e1str(OUT,cur,"SP0-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

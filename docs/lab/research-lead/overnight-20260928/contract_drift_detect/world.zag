// world.zag -- CDRIFT frozen world data (from PREREG section 3).
// World 0 outcome law: label = (s2 >= 2). World 1: label = (s4 >= 2).
// The learner never calls w_label0/w_label1; they are the world's
// outcome laws used by the driver to compute observed consequences.

fn sq6(sq:[]u8, a:i32, b:i32, c:i32, d:i32, e:i32, f:i32)void {
  sq[0]=a as u8; sq[1]=b as u8; sq[2]=c as u8;
  sq[3]=d as u8; sq[4]=e as u8; sq[5]=f as u8;
  return;
}
fn w_label0(sq:[]u8)i32 {
  if((sq[2] as i32)>=2){return 1;}
  return 0;
}
fn w_label1(sq:[]u8)i32 {
  if((sq[4] as i32)>=2){return 1;}
  return 0;
}

// Training episodes, world 0. Frozen fit: (2,2).
fn w_train0(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,1,0,0);}
  if(i==2){sq6(sq,0,0,2,0,1,0);}
  if(i==3){sq6(sq,2,3,1,0,0,1);}
  return;
}
// Training episodes, world 1. Frozen fit: (4,2).
fn w_train1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,3,0);}
  if(i==1){sq6(sq,1,0,1,1,0,1);}
  if(i==2){sq6(sq,0,0,0,0,2,0);}
  if(i==3){sq6(sq,0,3,0,0,1,0);}
  return;
}
// Phase 1 queries, world 0. All correct under (2,2).
fn w_q1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,0,0);}
  if(i==1){sq6(sq,1,1,2,0,0,0);}
  if(i==2){sq6(sq,0,0,3,1,2,0);}
  if(i==3){sq6(sq,2,1,1,0,3,1);}
  if(i==4){sq6(sq,0,2,2,0,0,0);}
  if(i==5){sq6(sq,3,0,0,0,1,0);}
  if(i==6){sq6(sq,1,1,3,0,0,2);}
  if(i==7){sq6(sq,0,0,1,2,0,0);}
  return;
}
// Arm A phase 2 queries, world 1. Q1..Q3 fail under stale (2,2);
// Q4..Q12 correct under revised (4,2).
fn w_q2a(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,0,3,0);}
  if(i==2){sq6(sq,0,0,1,0,2,1);}
  if(i==3){sq6(sq,2,0,3,1,0,0);}
  if(i==4){sq6(sq,0,1,2,0,1,0);}
  if(i==5){sq6(sq,1,0,0,0,2,0);}
  if(i==6){sq6(sq,0,0,3,0,3,1);}
  if(i==7){sq6(sq,2,2,1,1,0,0);}
  if(i==8){sq6(sq,0,0,2,0,0,2);}
  if(i==9){sq6(sq,1,3,0,2,1,0);}
  if(i==10){sq6(sq,0,0,3,0,1,0);}
  if(i==11){sq6(sq,0,1,1,1,3,0);}
  return;
}
// Arm C phase 2 queries, world 1, all under stale (2,2): 9 fail, 3 ok.
fn w_q2c(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,0,3,0);}
  if(i==2){sq6(sq,0,0,1,0,2,1);}
  if(i==3){sq6(sq,2,0,3,1,0,0);}
  if(i==4){sq6(sq,0,1,2,0,1,0);}
  if(i==5){sq6(sq,1,0,0,0,2,0);}
  if(i==6){sq6(sq,0,0,3,0,3,1);}
  if(i==7){sq6(sq,2,2,1,1,0,0);}
  if(i==8){sq6(sq,0,0,2,0,0,2);}
  if(i==9){sq6(sq,1,3,0,2,1,0);}
  if(i==10){sq6(sq,0,0,3,0,1,0);}
  if(i==11){sq6(sq,0,1,1,1,3,0);}
  return;
}
// Arm A phase 3 queries, world 1. All correct under (4,2).
fn w_q3(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,1,0,0,0,3,0);}
  if(i==1){sq6(sq,0,2,1,0,0,1);}
  if(i==2){sq6(sq,0,0,2,1,2,0);}
  if(i==3){sq6(sq,2,0,0,0,1,0);}
  if(i==4){sq6(sq,0,3,3,0,0,0);}
  if(i==5){sq6(sq,1,1,1,1,3,1);}
  if(i==6){sq6(sq,0,0,0,0,2,2);}
  if(i==7){sq6(sq,3,2,2,0,0,0);}
  return;
}
// Arm B queries, world 0. All correct under (2,2).
fn w_qb(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,0,0);}
  if(i==1){sq6(sq,1,1,2,0,0,0);}
  if(i==2){sq6(sq,0,0,3,1,2,0);}
  if(i==3){sq6(sq,2,1,1,0,3,1);}
  if(i==4){sq6(sq,0,2,2,0,0,0);}
  if(i==5){sq6(sq,3,0,0,0,1,0);}
  if(i==6){sq6(sq,1,1,3,0,0,2);}
  if(i==7){sq6(sq,0,0,1,2,0,0);}
  if(i==8){sq6(sq,0,0,2,0,1,1);}
  if(i==9){sq6(sq,1,0,0,3,0,0);}
  if(i==10){sq6(sq,2,2,3,0,0,0);}
  if(i==11){sq6(sq,0,1,1,1,2,0);}
  if(i==12){sq6(sq,3,3,2,0,0,1);}
  if(i==13){sq6(sq,0,0,0,0,3,0);}
  if(i==14){sq6(sq,1,2,3,2,1,0);}
  if(i==15){sq6(sq,0,0,1,0,0,3);}
  if(i==16){sq6(sq,2,0,2,1,1,0);}
  if(i==17){sq6(sq,0,3,0,0,2,1);}
  if(i==18){sq6(sq,1,1,2,3,0,0);}
  if(i==19){sq6(sq,0,0,0,1,0,2);}
  return;
}

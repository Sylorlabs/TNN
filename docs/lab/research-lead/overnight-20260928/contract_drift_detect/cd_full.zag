// learner.zag -- CDRIFT learner: typed contract holder with autonomous
// contract drift detection via verification failures.
// A contract is a typed promise the learner commits to and acts on:
// CONTRACT_TY=7, (C_SLOT, C_THRESH): outcome == (s[C_SLOT] >= C_THRESH).
// The monitor inside c_verify latches CONTRACT_REVISE_REQ after 3
// consecutive verification failures. x_maybe_revise revises the contract
// from the learner state window [REV_PTR, XN) with the same generic
// first fit used at initial learn. Pure Zag.
//
// State (one u8 buffer, 1024 bytes):
//   0: XN  1: REV_PTR  2: REVISION_ENABLED  7: C_Q
//   8+n*8: episode n (id, s0..s5, label), 32 max
//   500: CONTRACT_TY  501: C_SLOT  502: C_THRESH  503: CONTRACT_SET
//   504: C_FAIL_RUN  505: C_REV_REQ  506..509: C_REV_COUNT
//   510..513: C_FIRST_DETECT_Q  514..517: C_CORRECT  518..521: C_TOTAL
//   522..525: C_FIT_ERR  530..533: C_OLDERR_ON_NEW

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

fn x_teach(st:[]u8, id:i32, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32, label:i32)void {
  let n:i32=st[0] as i32;
  if(n>=32){return;}
  let o:i32=8+n*8;
  st[o]=id as u8;
  st[o+1]=s0 as u8; st[o+2]=s1 as u8; st[o+3]=s2 as u8;
  st[o+4]=s3 as u8; st[o+5]=s4 as u8; st[o+6]=s5 as u8;
  st[o+7]=label as u8;
  st[0]=(n+1) as u8;
  return;
}

// Generic first fit over the window [REV_PTR, XN). Frozen scan order:
// slot 0..5, threshold 1..3. First candidate with strictly fewer errors
// wins (scan order tiebreak). No semantic cases.
fn x_fit_contract(st:[]u8)void {
  let n0:i32=st[1] as i32;
  let n1:i32=st[0] as i32;
  if(n1<=n0){return;}
  let best_err:i32=9999;
  let best_slot:i32=-1;
  let best_t:i32=-1;
  let slot:i32=0;
  while(slot<6){
    let t:i32=1;
    while(t<4){
      let err:i32=0;
      let i:i32=n0;
      while(i<n1){
        let o:i32=8+i*8;
        let v:i32=st[o+1+slot] as i32;
        let pred:i32=0;
        if(v>=t){pred=1;}
        if(pred != (st[o+7] as i32)){err=err+1;}
        i=i+1;
      }
      if(err<best_err){best_err=err;best_slot=slot;best_t=t;}
      t=t+1;
    }
    slot=slot+1;
  }
  if(best_slot>=0){
    st[500]=7;
    st[501]=best_slot as u8;
    st[502]=best_t as u8;
    st[503]=1;
    set32(st,522,best_err);
    st[1]=st[0];
  }
  return;
}

fn sv(slot:i32, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32)i32 {
  if(slot==0){return s0;}
  if(slot==1){return s1;}
  if(slot==2){return s2;}
  if(slot==3){return s3;}
  if(slot==4){return s4;}
  return s5;
}

// Act on the held contract: commit to (s[C_SLOT] >= C_THRESH).
fn c_act(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32)i32 {
  if((st[503] as i32)==0){return 0;}
  let slot:i32=st[501] as i32;
  let t:i32=st[502] as i32;
  let v:i32=sv(slot,s0,s1,s2,s3,s4,s5);
  if(v>=t){return 1;}
  return 0;
}

// Verify the commitment against the observed world consequence.
// The monitor: 3 consecutive failures latch C_REV_REQ. C_REV_REQ is
// written ONLY here, never by the driver.
fn c_verify(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32, actual:i32)i32 {
  st[7]=((st[7] as i32)+1) as u8;
  let pred:i32=c_act(st,s0,s1,s2,s3,s4,s5);
  let ok:i32=0;
  if(pred==actual){ok=1;}
  set32(st,518,get32(st,518)+1);
  if(ok==1){set32(st,514,get32(st,514)+1);}
  if((st[503] as i32)==1){
    if(ok==1){st[504]=0;}
    else {
      let r:i32=(st[504] as i32)+1;
      st[504]=r as u8;
      if(r>=3){
        if((st[505] as i32)==0){
          st[505]=1;
          if(get32(st,510)<0){set32(st,510,(st[7] as i32));}
        }
      }
    }
  }
  return ok;
}

// Standing generic opportunity. Revises iff the learner latched the
// request and the experimental parameter enables revision.
fn x_maybe_revise(st:[]u8)void {
  if((st[505] as i32)==1){
    if((st[2] as i32)==1){
      let n0:i32=st[1] as i32;
      let n1:i32=st[0] as i32;
      let slot:i32=st[501] as i32;
      let t:i32=st[502] as i32;
      let err:i32=0;
      let i:i32=n0;
      while(i<n1){
        let o:i32=8+i*8;
        let v:i32=st[o+1+slot] as i32;
        let pred:i32=0;
        if(v>=t){pred=1;}
        if(pred != (st[o+7] as i32)){err=err+1;}
        i=i+1;
      }
      set32(st,530,err);
      x_fit_contract(st);
      set32(st,506,get32(st,506)+1);
      st[505]=0;
      st[504]=0;
    }
  }
  return;
}

fn c_phase_reset(st:[]u8)void {
  st[7]=0;
  st[504]=0;
  return;
}
// world.zag -- CDRIFT frozen world data (from PREREG section 3).
// World 0 outcome law: label = (s2 >= 2). World 1: label = (s4 >= 2).
// The learner never calls w_label0/w_label1; they are the world's
// outcome laws used by the driver to compute observed consequences.

fn sq6(sq:[]u8, a:i32, b:i32, c:i32, d:i32, e:i32, f:i32)void {
  sq[0]=a as u8; sq[1]=b as u8; sq[2]=c as u8;
  sq[3]=d as u8; sq[4]=e as u8; sq[5]=f as u8;
  return;
}
fn w_label0(sq:[]u8)i32 {
  if((sq[2] as i32)>=2){return 1;}
  return 0;
}
fn w_label1(sq:[]u8)i32 {
  if((sq[4] as i32)>=2){return 1;}
  return 0;
}

// Training episodes, world 0. Frozen fit: (2,2).
fn w_train0(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,1,0,0);}
  if(i==2){sq6(sq,0,0,2,0,1,0);}
  if(i==3){sq6(sq,2,3,1,0,0,1);}
  return;
}
// Training episodes, world 1. Frozen fit: (4,2).
fn w_train1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,3,0);}
  if(i==1){sq6(sq,1,0,1,1,0,1);}
  if(i==2){sq6(sq,0,0,0,0,2,0);}
  if(i==3){sq6(sq,0,3,0,0,1,0);}
  return;
}
// Phase 1 queries, world 0. All correct under (2,2).
fn w_q1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,0,0);}
  if(i==1){sq6(sq,1,1,2,0,0,0);}
  if(i==2){sq6(sq,0,0,3,1,2,0);}
  if(i==3){sq6(sq,2,1,1,0,3,1);}
  if(i==4){sq6(sq,0,2,2,0,0,0);}
  if(i==5){sq6(sq,3,0,0,0,1,0);}
  if(i==6){sq6(sq,1,1,3,0,0,2);}
  if(i==7){sq6(sq,0,0,1,2,0,0);}
  return;
}
// Arm A phase 2 queries, world 1. Q1..Q3 fail under stale (2,2);
// Q4..Q12 correct under revised (4,2).
fn w_q2a(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,0,3,0);}
  if(i==2){sq6(sq,0,0,1,0,2,1);}
  if(i==3){sq6(sq,2,0,3,1,0,0);}
  if(i==4){sq6(sq,0,1,2,0,1,0);}
  if(i==5){sq6(sq,1,0,0,0,2,0);}
  if(i==6){sq6(sq,0,0,3,0,3,1);}
  if(i==7){sq6(sq,2,2,1,1,0,0);}
  if(i==8){sq6(sq,0,0,2,0,0,2);}
  if(i==9){sq6(sq,1,3,0,2,1,0);}
  if(i==10){sq6(sq,0,0,3,0,1,0);}
  if(i==11){sq6(sq,0,1,1,1,3,0);}
  return;
}
// Arm C phase 2 queries, world 1, all under stale (2,2): 9 fail, 3 ok.
fn w_q2c(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,0,3,0);}
  if(i==2){sq6(sq,0,0,1,0,2,1);}
  if(i==3){sq6(sq,2,0,3,1,0,0);}
  if(i==4){sq6(sq,0,1,2,0,1,0);}
  if(i==5){sq6(sq,1,0,0,0,2,0);}
  if(i==6){sq6(sq,0,0,3,0,3,1);}
  if(i==7){sq6(sq,2,2,1,1,0,0);}
  if(i==8){sq6(sq,0,0,2,0,0,2);}
  if(i==9){sq6(sq,1,3,0,2,1,0);}
  if(i==10){sq6(sq,0,0,3,0,1,0);}
  if(i==11){sq6(sq,0,1,1,1,3,0);}
  return;
}
// Arm A phase 3 queries, world 1. All correct under (4,2).
fn w_q3(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,1,0,0,0,3,0);}
  if(i==1){sq6(sq,0,2,1,0,0,1);}
  if(i==2){sq6(sq,0,0,2,1,2,0);}
  if(i==3){sq6(sq,2,0,0,0,1,0);}
  if(i==4){sq6(sq,0,3,3,0,0,0);}
  if(i==5){sq6(sq,1,1,1,1,3,1);}
  if(i==6){sq6(sq,0,0,0,0,2,2);}
  if(i==7){sq6(sq,3,2,2,0,0,0);}
  return;
}
// Arm B queries, world 0. All correct under (2,2).
fn w_qb(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,0,0);}
  if(i==1){sq6(sq,1,1,2,0,0,0);}
  if(i==2){sq6(sq,0,0,3,1,2,0);}
  if(i==3){sq6(sq,2,1,1,0,3,1);}
  if(i==4){sq6(sq,0,2,2,0,0,0);}
  if(i==5){sq6(sq,3,0,0,0,1,0);}
  if(i==6){sq6(sq,1,1,3,0,0,2);}
  if(i==7){sq6(sq,0,0,1,2,0,0);}
  if(i==8){sq6(sq,0,0,2,0,1,1);}
  if(i==9){sq6(sq,1,0,0,3,0,0);}
  if(i==10){sq6(sq,2,2,3,0,0,0);}
  if(i==11){sq6(sq,0,1,1,1,2,0);}
  if(i==12){sq6(sq,3,3,2,0,0,1);}
  if(i==13){sq6(sq,0,0,0,0,3,0);}
  if(i==14){sq6(sq,1,2,3,2,1,0);}
  if(i==15){sq6(sq,0,0,1,0,0,3);}
  if(i==16){sq6(sq,2,0,2,1,1,0);}
  if(i==17){sq6(sq,0,3,0,0,2,1);}
  if(i==18){sq6(sq,1,1,2,3,0,0);}
  if(i==19){sq6(sq,0,0,0,1,0,2);}
  return;
}
// driver.zag -- CDRIFT experiment driver: three arms, frozen kill bars.
// The driver teaches labeled episodes, schedules the world change, and
// calls x_maybe_revise as a standing heartbeat. It never writes
// CONTRACT_REVISE_REQ (offset 505): the revision decision is the
// learner's. Static audit: no "st[505]=" assignment in this file.
// Prereg: contract_drift_detect/PREREG.md. Pure Zag.

fn st_new()[]u8 {
  let st:[]u8=z_alloc(1024);
  set32(st,510,-1);
  return st;
}
fn d_req(st:[]u8)i32 { return st[505] as i32; }
fn d_slot(st:[]u8)i32 { return st[501] as i32; }
fn d_thresh(st:[]u8)i32 { return st[502] as i32; }
fn d_revcnt(st:[]u8)i32 { return get32(st,506); }
fn d_firstq(st:[]u8)i32 { return get32(st,510); }
fn d_fiterr(st:[]u8)i32 { return get32(st,522); }
fn d_olderr(st:[]u8)i32 { return get32(st,530); }
fn d_cor(st:[]u8)i32 { return get32(st,514); }

fn d_teach0(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train0(i,sq);
    let lb:i32=w_label0(sq);
    x_teach(st,i+1,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return at;
}
fn d_teach1(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train1(i,sq);
    let lb:i32=w_label1(sq);
    x_teach(st,i+11,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return at;
}
fn d_fitline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," err=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,(st[1] as i32));
  at=ob_nl(ob,at);
  return at;
}
// Run n queries from world fn wq starting at index q0, with label fn
// wl (0=world0,1=world1). Prints per query trace when traceq==1.
// Returns the new buffer position. Phase correct counts are read from
// the learner's C_CORRECT counter (offset 514) around the call.
fn d_queries(st:[]u8, ob:[]u8, at:i32, wq:i32, q0:i32, n:i32, wl:i32, traceq:i32, tag:[]u8)i32 {
  let sq:[]u8=z_alloc(6);
  let k:i32=0;
  while(k<n){
    let i:i32=q0+k;
    if(wq==1){w_q1(i,sq);}
    if(wq==2){w_q2a(i,sq);}
    if(wq==3){w_q2c(i,sq);}
    if(wq==4){w_q3(i,sq);}
    if(wq==5){w_qb(i,sq);}
    let actual:i32=0;
    if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
    let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    let ok:i32=c_verify(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual);
    if(traceq==1){
      at=ob_app(ob,at,tag);
      at=ob_app(ob,at," q=");
      at=ob_i32(ob,at,i+1);
      at=ob_app(ob,at," pred=");
      at=ob_i32(ob,at,pred);
      at=ob_app(ob,at," act=");
      at=ob_i32(ob,at,actual);
      at=ob_app(ob,at," ok=");
      at=ob_i32(ob,at,ok);
      at=ob_app(ob,at," run=");
      at=ob_i32(ob,at,(st[504] as i32));
      at=ob_app(ob,at," req=");
      at=ob_i32(ob,at,d_req(st));
      at=ob_nl(ob,at);
    }
    k=k+1;
  }
  return at;
}
fn d_sumline(ob:[]u8, at:i32, tag:[]u8, c:i32, n:i32, req:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," correct=");
  at=ob_i32(ob,at,c);
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,n);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,req);
  at=ob_nl(ob,at);
  return at;
}
fn d_contractline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," ty=");
  at=ob_i32(ob,at,(st[500] as i32));
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," revcount=");
  at=ob_i32(ob,at,d_revcnt(st));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(st));
  at=ob_app(ob,at," fiterr=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," olderr=");
  at=ob_i32(ob,at,d_olderr(st));
  at=ob_nl(ob,at);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=ob_app(ob,at,"CONTRACT-DRIFT-DETECT\n");

  // ---- Arm A: drift, revision enabled ----
  at=ob_app(ob,at,"ARM-A drift revision-enabled\n");
  let sta:[]u8=st_new();
  sta[2]=1;
  at=d_teach0(sta,ob,at);
  x_fit_contract(sta);
  at=d_fitline(sta,ob,at,"A-FIT0");
  let pre_slot:i32=d_slot(sta);
  let pre_t:i32=d_thresh(sta);
  c_phase_reset(sta);
  let cor0:i32=d_cor(sta);
  at=d_queries(sta,ob,at,1,0,8,0,0,"A-P1");
  let a_p1:i32=d_cor(sta)-cor0;
  at=d_sumline(ob,at,"A-P1SUM",a_p1,8,d_req(sta));
  let a_req_p1:i32=d_req(sta);
  x_maybe_revise(sta);
  // World change (driver scheduled, disclosed). Phase 2, world 1.
  c_phase_reset(sta);
  cor0=d_cor(sta);
  at=d_queries(sta,ob,at,2,0,3,1,1,"A-P2");
  let a_p2a:i32=d_cor(sta)-cor0;
  at=ob_app(ob,at,"A-DETECT req=");
  at=ob_i32(ob,at,d_req(sta));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(sta));
  at=ob_nl(ob,at);
  at=d_teach1(sta,ob,at);
  x_maybe_revise(sta);
  at=ob_app(ob,at,"A-REVISE ");
  at=d_contractline(sta,ob,at,"");
  let post_slot:i32=d_slot(sta);
  let post_t:i32=d_thresh(sta);
  cor0=d_cor(sta);
  at=d_queries(sta,ob,at,2,3,9,1,0,"A-P2B");
  let a_p2b:i32=d_cor(sta)-cor0;
  at=d_sumline(ob,at,"A-P2SUM",a_p2a+a_p2b,12,d_req(sta));
  x_maybe_revise(sta);
  c_phase_reset(sta);
  cor0=d_cor(sta);
  at=d_queries(sta,ob,at,4,0,8,1,0,"A-P3");
  let a_p3:i32=d_cor(sta)-cor0;
  at=d_sumline(ob,at,"A-P3SUM",a_p3,8,d_req(sta));
  let a_req_p3:i32=d_req(sta);
  x_maybe_revise(sta);
  at=d_contractline(sta,ob,at,"A-FINAL");

  // ---- Arm B: no drift control ----
  at=ob_app(ob,at,"ARM-B no-drift control\n");
  let stb:[]u8=st_new();
  stb[2]=1;
  at=d_teach0(stb,ob,at);
  x_fit_contract(stb);
  at=d_fitline(stb,ob,at,"B-FIT0");
  c_phase_reset(stb);
  let corb:i32=d_cor(stb);
  at=d_queries(stb,ob,at,5,0,20,0,0,"B-Q");
  let b_c:i32=d_cor(stb)-corb;
  at=d_sumline(ob,at,"B-SUM",b_c,20,d_req(stb));
  x_maybe_revise(stb);
  let b_req:i32=d_req(stb);
  let b_rev:i32=d_revcnt(stb);
  at=d_contractline(stb,ob,at,"B-FINAL");

  // ---- Arm C: drift, revision disabled ----
  at=ob_app(ob,at,"ARM-C drift revision-disabled\n");
  let stc:[]u8=st_new();
  stc[2]=0;
  at=d_teach0(stc,ob,at);
  x_fit_contract(stc);
  at=d_fitline(stc,ob,at,"C-FIT0");
  c_phase_reset(stc);
  let corc:i32=d_cor(stc);
  at=d_queries(stc,ob,at,1,0,8,0,0,"C-P1");
  let c_p1:i32=d_cor(stc)-corc;
  at=d_sumline(ob,at,"C-P1SUM",c_p1,8,d_req(stc));
  x_maybe_revise(stc);
  c_phase_reset(stc);
  corc=d_cor(stc);
  at=d_queries(stc,ob,at,3,0,12,1,1,"C-P2");
  let c_p2:i32=d_cor(stc)-corc;
  at=d_sumline(ob,at,"C-P2SUM",c_p2,12,d_req(stc));
  x_maybe_revise(stc);
  let c_req:i32=d_req(stc);
  let c_rev:i32=d_revcnt(stc);
  at=d_contractline(stc,ob,at,"C-FINAL");

  // ---- Kill bars ----
  let k1:i32=0;
  if(a_p1==8){ if(a_req_p1==0){k1=1;} }
  let k2:i32=0;
  if(c_p2<=5){k2=1;}
  let k3:i32=0;
  // REQ is cleared by the revision itself; the latch is evidenced by firstq.
  if(d_firstq(sta)==3){k3=1;}
  let k4:i32=0;
  if(d_revcnt(sta)==1){ if(b_rev==0){ if(c_rev==0){k4=1;} } }
  let k5:i32=0;
  if(a_p3==8){k5=1;}
  let k6:i32=0;
  if(b_req==0){ if(b_c==20){ if(a_req_p3==0){k6=1;} } }
  let k8:i32=0;
  if(pre_slot==2){ if(pre_t==2){ if(post_slot==4){ if(post_t==2){
    if(d_slot(stc)==2){ if(d_thresh(stc)==2){k8=1;} } } } } }
  let k9:i32=0;
  if(d_fiterr(sta)==0){ if(d_olderr(sta)>=1){k9=1;} }

  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=see-shell");
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_app(ob,at," k9=");
  at=ob_i32(ob,at,k9);
  at=ob_nl(ob,at);
  let pass:i32=k1+k2+k3+k4+k5+k6+k8+k9;
  if(pass==8){
    at=ob_app(ob,at,"VERDICT CONTRACT-DRIFT-DETECT-COMPLETE\n");
  } else {
    at=ob_app(ob,at,"VERDICT FAIL bars-passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/8\n");
  }
  at=ob_app(ob,at,"CONTRACT-DRIFT-DETECT-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

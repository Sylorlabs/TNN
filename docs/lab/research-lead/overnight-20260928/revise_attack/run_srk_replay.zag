// b_replay.zag -- B-REPLAY: rote memorization baseline for REVISE step 5.
// Observes the passive schedule, finds the first Y=1 event, records the
// control actions in the preceding window, replays them verbatim.
// Concatenate AFTER a sealed world file (world defines w_ interface + main).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn L_run()i32 {
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  // locate Y by name
  let yv:i32=-1;
  let v:i32=0;
  while(v<nvars){
    let nm:[]u8=w_vname(v);
    if((nm[0] as i32)==89){ yv=v; }
    v=v+1;
  }
  if(yv<0){ emit("B-REPLAY GOAL_REAL 0\n"); return 0; }
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }

  let ws:[]u8=z_alloc(8+nvars*32);
  w_reset(ws);
  // rec[t*nvars+v], t=0..12
  let rec:[]u8=z_alloc(13*nvars);
  let t:i32=0;
  while(t<=12){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    v=0;
    while(v<nvars){ rec[t*nvars+v]=snap[v]; v=v+1; }
    if(t<12){ w_act(ws,2,0); }
    t=t+1;
  }
  // first t* with Y=1
  let ts:i32=-1;
  t=0;
  while(t<=12){
    if((rec[t*nvars+yv] as i32)==1){ ts=t; t=99; }
    t=t+1;
  }
  if(ts<0){ emit("B-REPLAY GOAL_REAL 0\n"); return 0; }
  // record SET actions in window [ts-4, ts]
  let at:[]u8=z_alloc(16);
  let av:[]u8=z_alloc(16);
  let na:i32=0;
  let dt:i32=1;
  while(dt<=4){
    if(ts-dt>=0){
      i=0;
      while(i<nctrl){
        let c:i32=ctrl[i] as i32;
        if((rec[(ts-dt)*nvars+c] as i32)==1){
          at[na]=(ts-dt) as u8; av[na]=c as u8; na=na+1;
        }
        i=i+1;
      }
    }
    dt=dt+1;
  }
  // replay
  w_reset(ws);
  w_goal_setup(ws);
  t=0;
  while(t<=ts){
    i=0;
    while(i<na){
      if((at[i] as i32)==t){ w_act(ws,0,av[i] as i32); }
      i=i+1;
    }
    if(t<ts){ w_act(ws,2,0); }
    t=t+1;
  }
  let fin:[]u8=z_alloc(nvars);
  w_snapshot(ws,fin);
  let g:i32=w_goal_met(fin);
  emit("B-REPLAY GOAL_REAL "); e64(g); emit("\n");
  return g;
}
// world_srk.zag -- Attack world S-RK: replay-discriminating timing variant.
// Designed in PREREG_REVISE_ATTACK.md (frozen first, alone); the builder
// never saw it. Derived from sealed world_sneg2.zag by changing ONLY the
// passive pulse times (t=0,6 vs t=3,9) and the name string.
// SEALED TRUTH (identical to S-NEG2):
//   Y(t) = X(t-2) AND NOT Z(t-2).
// Vars: X(0,ctrl), Z(1,ctrl), Y(2). Pulsed (SET writes current
// step only; no persistence).
// Passive: env SETs X ALONE at t=0,6 (Z never pulsed in passive).
// Then Y=1 at t=2,8.
// Goal context: w_goal_setup sets Z=1 (inhibitor present), X=0, Y=0.
// B-REPLAY is predicted to FAIL here (absolute-time replay lands the
// check on the inhibitor); genuine D1 revision should still succeed.
// Goal mode 0: final-state Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ9-epsilon-replaykill"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Sealed truth: Y(t) = X(t-2) AND NOT Z(t-2).
    // Out-of-range reads are 0.
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-2>=0){ zv=ws[8+1*32+(t-2)] as i32; }
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: env SETs X ALONE at t=3,9. Z never pulsed.
// Uses world's clock.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==0){ ws[8+0*32+t]=1; }
  if(t==6){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: inhibitor Z=1 present, X=0, Y=0. The learner must
// grow the !Z@2 guard and replan around the inhibitor.
fn w_goal_setup(ws:[]u8)void {
  ws[8+1*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness note: sealed evaluator's world. w_verify unused.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("SEALED DONE mask="); e64(m); emit("\n");
  return 0;
}

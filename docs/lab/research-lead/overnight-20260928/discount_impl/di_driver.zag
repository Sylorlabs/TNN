// ===== DISCOUNT PILOT DRIVER =====
// Appended to di_variant.zag (frozen base, original test main removed,
// bootstrap_miss replaced by the D1+D2+W3+R1 discount pilot).
// Replays the contradiction-break battery (510b6cb42) Phases 1-5 and tests
// whether the discount mechanism gives the "stop" an "exit".
//
// Predicted (DISCOUNT.md 3.2, T=2):
// Phase 2: q0..q3 = 42 (loop established, discount untouched).
// Phase 3: contradiction (3001,50,99) taught, discount 0.
// Phase 4: b0=-2 (99-fact discount 0->1), b1=-2 (1->2), b2=-2 (2->3),
//          b3=42 (99-fact discount 3 > 2, excluded by R1, bootstrap resumes).
// Phase 5: p0=42, p1=42 (loop resumed on 42s).
// Recovery bound: at most T+1 = 3 failed bootstraps.

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Evidence scan with discount: replicate the pilot bootstrap_miss window
// (most-recent-first, live tag-1, relation r, cap 6, R1 exclusion).
fn scan_d(W:[]u8,p:[]u8,r:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=2){
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit(" d"); e64(ng(W,n,12)); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

fn di_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: 3 genuine seeds, value 42.
  let g1:i32=ev_teach(W,1001,50,42); rep("D","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("D","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("D","g3",g3);
  // Phase 2: establish the loop with 4 fresh-subject queries. Expect 42.
  let i:i32=0;
  while(i<4){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("D q"); e64(i); emit("="); e64(q); emit("\n");
    i=i+1;
  }
  // Phase 3: CONTRADICTION via ev_teach(3001,50,99).
  let cx:i32=ev_teach(W,3001,50,99); rep("D","contra_idx",cx);
  emit("D contra_disc="); e64(ng(W,cx,12)); emit("\n");
  emit("D CONTRA-TAUGHT\n");
  scan_d(W,"D",50,50);
  // Phase 4: 6 fresh queries. Predict b0..b2 = -2 (discount 1,2,3),
  // then b3 = 42 (recovery), b4 = 42, b5 = 42 (loop resumed).
  i=0;
  while(i<6){
    let q2:i32=ev_query(W,2005+i,50,-2,0);
    emit("D b"); e64(i); emit("="); e64(q2);
    emit(" contra_disc="); e64(ng(W,cx,12)); emit("\n");
    scan_d(W,"D",50,60+i);
    i=i+1;
  }
  // Phase 5: persistence of recovery. 2 more fresh queries. Expect 42.
  i=0;
  while(i<2){
    let q3:i32=ev_query(W,2011+i,50,-2,0);
    emit("D p"); e64(i); emit("="); e64(q3); emit("\n");
    i=i+1;
  }
  emit("D final_contra_disc="); e64(ng(W,cx,12)); emit("\n");
  emit("DISCOUNT-PILOT-DONE\n");
  return 0;
}
fn main()i32 { return di_main(); }

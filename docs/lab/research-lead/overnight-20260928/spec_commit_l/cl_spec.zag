// cl_spec.zag -- SPEC-COMMIT-L policy layer.
//
// Derived from the parent lane's ld_spec.zag (SPEC-L-DISCIPLINE,
// BUILD-PASS K1-K9) with minimal documented deltas. Everything
// below marked [CL-DELTA] is new in this lane; [LD-DELTA] marks the
// parent lane's deltas (kept); [LD-RENAME] is renamed without behavior
// change; [FT-DELTA] marks the grandparent lane's deltas (kept, some
// dormant); all other logic (EWMA estimator base form, nr_decide margin
// test, opposite-decisive flip mechanics, pol-3 deferred re-check
// branch, pol-4 minimum-data guard, arrival mechanics, seed formulas)
// is the grandparent's, unchanged. The parent's ld_spec.zag is
// byte-unmodified in its own lane directory (K9); this file supersedes
// it in the assembly, it is not assembled alongside it.
//
// [CL-DELTA] scl_commit_decide: the pre-shift commit decision. The
// commit rule is the ONE remaining L-entry point under test (the flip
// discipline is already L-free via pol 10). Three new L-free commit
// arms, all running the noeg (pol 10) flip discipline:
//   pol 13 "coml1":   nr_decide with L := 1 (both directions L-free;
//                     the zero-data quirk is preserved: with
//                     (dh,ed) = (0,0), phid > phin still fires at
//                     e = 32 for every L >= 1, including L := 1)
//   pol 14 "comlg":   nr_decide with L := 1, plus the minimum-data
//                     guard: the caller suppresses dec == 2 while
//                     (dh,ed) = (0,0) via the blk flag (exactly the
//                     pol-4 guard semantics). Quirk blocked;
//                     data-driven eager direction kept.
//   pol 15 "comnoeg": lazy-decisive only, L-free (plod < plon); the
//                     eager direction is dropped, so the quirk channel
//                     is closed by construction.
// Every other pol keeps the parent's nr_decide(..., L) commit call
// verbatim (surgical delta; K4d replication).
// [CL-DELTA] nr_decide_ft: hoisted lzmult = 1 and egl = 1 for pol
// 13/14/15, i.e. all three new arms run the noeg L-free flip
// discipline (lazy bar 2*qhi < dlo; eager direction phid > phin).
// [CL-DELTA] the pol-4 minimum-data guard's blk flag is also set for
// pol 14 (same (dh,ed) = (0,0) suppression, now on the L-free commit).
// [CL-DELTA] nr_polname prints "coml1"/"comlg"/"comnoeg" for pol
// 13/14/15.
// [CL-DELTA] sld_episode wires pol 13/14/15 through the adapt
// initialization (apol) and the adaptive EWMA + checkpoint path
// (adap).
//
// [LD-DELTA] nr_decide_ft: the flip-path margin test gains the
// hoisted egl flag (eager-direction L multiplier): egl = 1 for
// pol 10/12, else egl = L, so the eager-decisive test becomes
// `egl*phid > phin`. lzmult = 1 for pol 10/11/12, so all three new
// arms use the fix2 lazy bar (`2*qhi < dlo`). The three new arms:
//   pol 10 "noeg": eager-direction L-free, lazy bar fix2
//   pol 11 "noj":  pure alias of pol 7 (fix2 code path; differs
//                  only in the P= name); scored post-hoc with J'
//   pol 12 "nol":  pure alias of pol 10 (noeg code path); J' scored
// The commit rule (nr_decide, com == 0 branch) is UNCHANGED: L stays
// in the pre-shift commit in every arm (out of scope; quirk fields
// must replicate identically per K5b).
// [LD-DELTA] nr_polname prints "noeg" for pol 10, "noj" for pol 11,
// "nol" for pol 12.
// [LD-DELTA] sld_episode wires pol 10/11/12 through the adapt
// initialization, EWMA updates, and checkpoint call.
// [LD-RENAME] ft_checkpoint -> sld_checkpoint, ft_emit_cell ->
// sld_emit_cell, ft_episode -> sld_episode (no behavior change;
// the sld_ prefix (not ld_) avoids colliding with the grandparent
// spec_lazy_default lane's ld_* namespace, which is assembled into
// the same binary: ld_emit_cell/ld_episode already exist there with
// different signatures.
// the commit rule, guard, and pol-3 branch are the parent's,
// unchanged; pol 3 dormant, not swept in this lane).
//
// [FT-DELTA] (parent lane, kept): nr_decide_ft with pol-7 fixed
// 2*qhi bar via hoisted lzmult, pol-8 (L+1)*qh bar via hoisted lzq,
// pol-9 adaptive M*qhi bar via nchk counter at CS+120 (dormant here:
// pol 8/9 not swept); nr_decide itself, the commit rule, the
// eager-decisive direction's form, the EWMA, the grid, and pol-3 code
// are the grandparent's, unchanged.
//
// Shared helpers (nr_max0, nr_maxi, nr_isqrt, nr_next, nr_thr_b,
// nr_thr_q, nr_decide, nr_snap, nr_polname) are byte-identical to
// the parent lane. New/changed: nr_decide_ft ([LD-DELTA] hoisted egl
// flag for the L-free flip-path eager direction in pol 10/12, and
// lzmult = 1 for pol 10/11/12; the [FT-DELTA] pol-7/8/9 lazy bars
// are the parent's, unchanged), rc_seed_d/rc_seed_q (regime seeds,
// unchanged), rc_track_flip (post-shift flip recording, unchanged),
// sld_checkpoint ([LD-RENAME] + [FT-DELTA] com == 1 branch calls
// nr_decide_ft and maintains the dormant pol-9 nchk counter at
// CS+120),
// sld_emit_cell ([LD-RENAME] only),
// sld_episode ([LD-RENAME] + [LD-DELTA] pol-10/11/12 plumbing;
// estimator, margin test, commit rule, flip mechanics, guard, and
// pol-3 code are the parent's, unchanged; pol 3 dormant, not swept).
//
// No world literals in this file: relation/object ids arrive via rb_*.
fn nr_max0(a:i32)i32 {
  if(a>0){ return a; }
  return 0;
}
fn nr_maxi(a:i32,b:i32)i32 {
  if(a>b){ return a; }
  return b;
}
// Integer Newton sqrt, fixed 12 iterations: deterministic.
fn nr_isqrt(n:i64)i64 {
  if(n<=0){ return 0; }
  let x:i64=n/2+1;
  let i:i32=0;
  while(i<12){
    x=(x+n/x)/2;
    i=i+1;
  }
  return x;
}
// LCG: s <- (s*1103515245 + 12345) mod 2^31. i64, mod hand-rolled.
fn nr_next(s:i64)i64 {
  let r:i64=s*1103515245+12345;
  let q:i64=r/2147483648;
  return r-q*2147483648;
}
// Burst fire threshold for mean rate 1/M: min(2^31, 5*2^31/(2M)).
fn nr_thr_b(M:i32)i64 {
  let C:i64=2147483648;
  let t:i64=(5*C)/(2*(M as i64));
  if(t>C){ return C; }
  return t;
}
// Quiet fire threshold: max(0, (4*2^31/M - thr_b)/3).
fn nr_thr_q(M:i32,tb:i64)i64 {
  let C:i64=2147483648;
  let t:i64=((4*C)/(M as i64)-tb)/3;
  if(t<0){ return 0; }
  return t;
}
// Regime seeds: frozen, reset per episode, identical across arms.
fn rc_seed_d(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*101+N1*17+M2*13+N2*7+17) as i64;
}
fn rc_seed_q(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*17+N1*101+M2*7+N2*13+917) as i64;
}
// Margin-test decision. Returns 2 = eager-decisive (L > phi, strict),
// 1 = lazy-decisive (L < plo, strict), 0 = undecided. phi >= plo
// always (price increasing in d, decreasing in q), so both cannot fire.
fn nr_decide(dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32,L:i32)i32 {
  let phin:i32=nr_max0(dhi-qlo);
  let phid:i32=nr_maxi(qlo,1);
  let plon:i32=nr_max0(dlo-qhi);
  let plod:i32=nr_maxi(qhi,1);
  let eg:i32=0;
  let lz:i32=0;
  if(L*phid>phin){ eg=1; }
  if(L*plod<plon){ lz=1; }
  if(eg==1){ return 2; }
  if(lz==1){ return 1; }
  return 0;
}
// [CL-DELTA] L-free pre-shift commit decision. Returns 2 = eager,
// 1 = lazy, 0 = undecided, like nr_decide.
//   pol 13 "coml1":   nr_decide with L := 1. Both commit directions
//                     are L-free; the zero-data quirk is preserved:
//                     with (dh,ed) = (0,0), phin = 0 and phid >= 1,
//                     so `1*phid > phin` fires exactly as `L*phid`
//                     did for every L >= 1.
//   pol 14 "comlg":   identical decision to pol 13 here; the caller
//                     additionally suppresses dec == 2 while
//                     (dh,ed) = (0,0) via the blk flag (the quirk is
//                     blocked, the data-driven eager direction kept).
//   pol 15 "comnoeg": lazy-decisive only, L-free: `plod < plon`
//                     (the L := 1 lazy test). The eager direction is
//                     dropped, so dec == 2 is impossible and the quirk
//                     channel is closed by construction.
// Every other pol: the parent's nr_decide(..., L), unchanged
// (surgical delta; K4d replication).
// Hoisted depth-1 ifs, lets at function top level (znc workaround);
// no || in conditions.
fn scl_commit_decide(dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32,L:i32,pol:i32)i32 {
  let plon:i32=nr_max0(dlo-qhi);
  let plod:i32=nr_maxi(qhi,1);
  if(pol==15){
    if(plod<plon){ return 1; }
    return 0;
  }
  if(pol==13){ return nr_decide(dh,qh,dlo,dhi,qlo,qhi,1); }
  if(pol==14){ return nr_decide(dh,qh,dlo,dhi,qlo,qhi,1); }
  return nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
}
// [FT-DELTA] Flip-path margin test with threshold variants.
// [LD-DELTA] the eager-decisive test uses the hoisted egl flag:
// egl = L normally, egl = 1 for pol 10/12 (L-free flip-path eager
// direction). lzmult = 1 for pol 10/11/12 (all three new arms use
// the fix2 lazy bar). Returns 2 = eager-decisive (egl > phi, strict),
// 1 = lazy-decisive (bar < plo, strict), 0 = undecided.
// The lazy bar varies by pol:
//   pol 7 "fix2":   lzmult = 1, lzq = qhi  => 2*qhi < dlo
//   pol 8 "qmean":  lzmult = L, lzq = qh   => (L+1)*qh < dlo
//                   (dormant in this lane: not swept)
//   pol 9 "adaptd": lzmult = max(2, (L+1)-(nchk-1)) for nchk >= 1,
//                   lzmult = L for nchk = 0 (pre-shift), lzq = qhi
//                   (dormant in this lane: not swept)
//   pol 10 "noeg":  lzmult = 1, lzq = qhi, egl = 1
//                   => eager: phid > phin; lazy: 2*qhi < dlo
//   pol 11 "noj":   lzmult = 1, lzq = qhi, egl = L
//                   => pure fix2 alias (J' scored post-hoc)
//   pol 12 "nol":   lzmult = 1, lzq = qhi, egl = 1
//                   => pure noeg alias (J' scored post-hoc)
//   else:           lzmult = L, lzq = qhi  => (L+1)*qhi < dlo
// (identical to nr_decide). nchk = pol-9 post-shift checkpoint
// counter (CS+120; dormant here). Hoisted flags only (znc workaround:
// depth-1 ifs, no || in conditions).
fn nr_decide_ft(dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32,L:i32,pol:i32,nchk:i32)i32 {
  let phin:i32=nr_max0(dhi-qlo);
  let phid:i32=nr_maxi(qlo,1);
  let lzq:i32=qhi;
  if(pol==8){ lzq=qh; }
  let lzmult:i32=L;
  if(pol==7){ lzmult=1; }
  // [LD-DELTA] pol 10/11/12 use the fix2 lazy bar (no L in it).
  if(pol==10){ lzmult=1; }
  if(pol==11){ lzmult=1; }
  if(pol==12){ lzmult=1; }
  // [CL-DELTA] pol 13/14/15 run the noeg flip discipline: fix2 lazy
  // bar, L-free eager direction (same hoisted flags as pol 10).
  if(pol==13){ lzmult=1; }
  if(pol==14){ lzmult=1; }
  if(pol==15){ lzmult=1; }
  if(pol==9){
    if(nchk>=1){
      lzmult=L+1-(nchk-1);
      if(lzmult<2){ lzmult=2; }
    }
  }
  // [LD-DELTA] egl: eager-direction L multiplier. L-free (egl = 1)
  // for pol 10 (eager-direction variant) and pol 12 (both-free
  // variant); the caller-stated L everywhere else. Hoisted flags
  // (znc workaround: depth-1 ifs, no || in conditions).
  let egl:i32=L;
  if(pol==10){ egl=1; }
  if(pol==12){ egl=1; }
  // [CL-DELTA] pol 13/14/15: L-free flip-path eager direction
  // (egl = 1), like pol 10.
  if(pol==13){ egl=1; }
  if(pol==14){ egl=1; }
  if(pol==15){ egl=1; }
  let plon:i32=nr_max0(dlo-lzq);
  let plod:i32=nr_maxi(lzq,1);
  let eg:i32=0;
  let lz:i32=0;
  if(egl*phid>phin){ eg=1; }
  if(lzmult*plod<plon){ lz=1; }
  if(eg==1){ return 2; }
  if(lz==1){ return 1; }
  return 0;
}
// Snapshot commit-time estimates and intervals into CS.
fn nr_snap(CS:[]u8,dh:i32,qh:i32,dlo:i32,dhi:i32,qlo:i32,qhi:i32)void {
  set32(CS,32,dh);
  set32(CS,36,qh);
  set32(CS,40,dlo);
  set32(CS,44,dhi);
  set32(CS,48,qlo);
  set32(CS,52,qhi);
  set32(CS,56,nr_max0(dh-qh));
  set32(CS,60,nr_maxi(qh,1));
  set32(CS,64,nr_max0(dlo-qhi));
  set32(CS,68,nr_maxi(qhi,1));
  set32(CS,72,nr_max0(dhi-qlo));
  set32(CS,76,nr_maxi(qlo,1));
  return;
}
// Record a post-shift flip: pflips++, first flip sets tf1/fdir,
// second sets tf2. Called only with e > 128.
fn rc_track_flip(CS:[]u8,e:i32,want:i32)void {
  set32(CS,104,get32(CS,104)+1);
  if(get32(CS,92)==0){
    set32(CS,92,e);
    let fd:i32=-1;
    if(want==1){ fd=1; }
    set32(CS,96,fd);
    return;
  }
  if(get32(CS,100)==0){ set32(CS,100,e); }
  return;
}
// Checkpoint logic. CS layout: parent slots 0..80, plus
// 84=dh144, 88=qh144 (EWMA at first post-shift checkpoint),
// 92=tf1, 96=fdir, 100=tf2, 104=pflips,
// 108=dh192, 112=qh192 (EWMA ~4 time constants post-shift),
// 116=lc (late-commit flag: 1 iff committed post-shift from com = 2;
// inherited, stays 0 in this lane: pol 3 is dormant),
// 120=nchk ([FT-DELTA]: pol-9 post-shift checkpoint counter, dormant
// in this lane: pol 9 not swept; 0 for all swept arms; never
// emitted).
// e = elapsed ticks.
fn sld_checkpoint(CS:[]u8,LA:[]u8,S:[]u8,A:[]u8,dh:i32,qh:i32,ed:i32,eq:i32,drifts:i32,queries:i32,L:i32,pol:i32,e:i32)void {
  if(e==144){
    set32(CS,84,dh);
    set32(CS,88,qh);
  }
  if(e==192){
    set32(CS,108,dh);
    set32(CS,112,qh);
  }
  let sed:i64=nr_isqrt((ed/31) as i64);
  let seq:i64=nr_isqrt((eq/31) as i64);
  let dlo:i32=nr_max0(dh-2*(sed as i32));
  let dhi:i32=dh+2*(sed as i32);
  let qlo:i32=nr_max0(qh-2*(seq as i32));
  let qhi:i32=qh+2*(seq as i32);
  let com:i32=get32(CS,0);
  if(com==0){
    if(e>128){ return; }
    // [CL-DELTA] L-free pre-shift commit decision: pol 13/14/15 use
    // scl_commit_decide; every other pol keeps the parent's
    // nr_decide(..., L) call verbatim (surgical delta).
    let dec:i32=scl_commit_decide(dh,qh,dlo,dhi,qlo,qhi,L,pol);
    // [FL-DELTA-NONE] the pol-4 minimum-data guard below is the
    // parent's, unchanged: a degenerate {0} price interval
    // ((dh,ed) = (0,0)) is not decisive evidence. Hoisted blk
    // flag (znc workaround: shallow if-nesting). Applies to
    // pol 4 only in the parent lane ([CL-DELTA] below extends it to
    // pol 14); pol 2/5/6/7/10/13 keep the inherited zero-data eager
    // commit (the quirk under study).
    let blk:i32=0;
    if(pol==4){ blk=1; }
    // [CL-DELTA] pol 14 "comlg": the minimum-data guard binds the
    // L-free commit exactly as pol 4 binds adapt's: a degenerate
    // {0} price interval ((dh,ed) = (0,0)) is not decisive evidence
    // for an eager commit.
    if(pol==14){ blk=1; }
    if(dh!=0){ blk=0; }
    if(ed!=0){ blk=0; }
    if(dec==2){
      if(blk==0){
        set32(CS,0,1);
        set32(CS,4,2);
        set32(CS,8,e);
        set32(CS,12,1);
        set32(CS,16,1);
        set32(CS,24,drifts);
        set32(CS,28,queries);
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
        nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
        return;
      }
    }
    if(dec==1){
      set32(CS,0,1);
      set32(CS,4,1);
      set32(CS,8,e);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(e==128){
      set32(CS,0,2);
      set32(CS,4,0);
      set32(CS,8,128);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    return;
  }
  if(com==1){
    // [FT-DELTA] pol-9 patience counter: one per post-shift
    // com == 1 checkpoint. Hoisted depth-2 ifs (znc workaround).
    let nchk:i32=get32(CS,120);
    if(pol==9){
      if(e>128){
        nchk=nchk+1;
        set32(CS,120,nchk);
      }
    }
    let dec:i32=nr_decide_ft(dh,qh,dlo,dhi,qlo,qhi,L,pol,nchk);
    let cur:i32=get32(CS,12);
    let want:i32=cur;
    if(dec==2){ want=1; }
    if(dec==1){ want=0; }
    if(want!=cur){
      set32(CS,12,want);
      set32(CS,16,want);
      set32(CS,20,get32(CS,20)+1);
      if(want==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
      let post:i32=0;
      if(e>128){ post=1; }
      if(post==1){ rc_track_flip(CS,e,want); }
    }
    return;
  }
  if(com==2){
    if(pol!=3){ return; }
    if(e<=128){ return; }
    let dec2:i32=nr_decide(dh,qh,dlo,dhi,qlo,qhi,L);
    if(dec2==2){
      set32(CS,0,1);
      set32(CS,4,2);
      set32(CS,8,e);
      set32(CS,12,1);
      set32(CS,16,1);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      et_specialize_ret(LA,S,A,0,0);
      set32(CS,80,get32(CS,80)+1);
      set32(CS,116,1);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    if(dec2==1){
      set32(CS,0,1);
      set32(CS,4,1);
      set32(CS,8,e);
      set32(CS,12,0);
      set32(CS,16,0);
      set32(CS,24,drifts);
      set32(CS,28,queries);
      set32(CS,116,1);
      nr_snap(CS,dh,qh,dlo,dhi,qlo,qhi);
      return;
    }
    return;
  }
  return;
}
fn nr_polname(B:[]u8,c:i32,pol:i32)i32 {
  if(pol==0){ c=o_app(B,c,"lazy"); }
  if(pol==1){ c=o_app(B,c,"eager"); }
  if(pol==2){ c=o_app(B,c,"adapt"); }
  if(pol==3){ c=o_app(B,c,"rechk"); }
  if(pol==4){ c=o_app(B,c,"guard"); }
  // [FL-DELTA] names for the two latency-variant arms.
  if(pol==5){ c=o_app(B,c,"fastchk"); }
  if(pol==6){ c=o_app(B,c,"fastewma"); }
  // [FT-DELTA] names for the three threshold-variant arms.
  if(pol==7){ c=o_app(B,c,"fix2"); }
  if(pol==8){ c=o_app(B,c,"qmean"); }
  if(pol==9){ c=o_app(B,c,"adaptd"); }
  // [LD-DELTA] names for the three L-discipline arms.
  if(pol==10){ c=o_app(B,c,"noeg"); }
  if(pol==11){ c=o_app(B,c,"noj"); }
  if(pol==12){ c=o_app(B,c,"nol"); }
  // [CL-DELTA] names for the three commit-rule arms.
  if(pol==13){ c=o_app(B,c,"coml1"); }
  if(pol==14){ c=o_app(B,c,"comlg"); }
  if(pol==15){ c=o_app(B,c,"comnoeg"); }
  return c;
}
// [LD-RENAME] ft_emit_cell -> sld_emit_cell. No behavior change:
// same CELL line fields (including the inherited dormant lc field;
// the [FT-DELTA] nchk counter at CS+120 is deliberately un-emitted
// so the line format is byte-identical to the parent's).
fn sld_emit_cell(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,CS:[]u8,dpre:i32,qpre:i32,dr:i32,q:i32,od:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL R=");
  c=o_i64(B,c,R as i64);
  c=o_app(B,c," M=");
  c=o_i64(B,c,M1 as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N1 as i64);
  c=o_app(B,c," M2=");
  c=o_i64(B,c,M2 as i64);
  c=o_app(B,c," N2=");
  c=o_i64(B,c,N2 as i64);
  c=o_app(B,c," P=");
  c=nr_polname(B,c,pol);
  c=o_app(B,c," L=");
  c=o_i64(B,c,Lv as i64);
  c=o_app(B,c," C=1 tc=");
  c=o_i64(B,c,get32(CS,8) as i64);
  c=o_app(B,c," cm=");
  c=o_i64(B,c,get32(CS,4) as i64);
  c=o_app(B,c," Dc=");
  c=o_i64(B,c,get32(CS,24) as i64);
  c=o_app(B,c," Qc=");
  c=o_i64(B,c,get32(CS,28) as i64);
  c=o_app(B,c," dh=");
  c=o_i64(B,c,get32(CS,32) as i64);
  c=o_app(B,c," qh=");
  c=o_i64(B,c,get32(CS,36) as i64);
  c=o_app(B,c," dlo=");
  c=o_i64(B,c,get32(CS,40) as i64);
  c=o_app(B,c," dhi=");
  c=o_i64(B,c,get32(CS,44) as i64);
  c=o_app(B,c," qlo=");
  c=o_i64(B,c,get32(CS,48) as i64);
  c=o_app(B,c," qhi=");
  c=o_i64(B,c,get32(CS,52) as i64);
  c=o_app(B,c," pnum=");
  c=o_i64(B,c,get32(CS,56) as i64);
  c=o_app(B,c," pden=");
  c=o_i64(B,c,get32(CS,60) as i64);
  c=o_app(B,c," plon=");
  c=o_i64(B,c,get32(CS,64) as i64);
  c=o_app(B,c," plod=");
  c=o_i64(B,c,get32(CS,68) as i64);
  c=o_app(B,c," phin=");
  c=o_i64(B,c,get32(CS,72) as i64);
  c=o_app(B,c," phid=");
  c=o_i64(B,c,get32(CS,76) as i64);
  c=o_app(B,c," sel=");
  c=o_i64(B,c,get32(CS,16) as i64);
  c=o_app(B,c," flips=");
  c=o_i64(B,c,get32(CS,20) as i64);
  c=o_app(B,c," pflips=");
  c=o_i64(B,c,get32(CS,104) as i64);
  c=o_app(B,c," tf1=");
  c=o_i64(B,c,get32(CS,92) as i64);
  c=o_app(B,c," fdir=");
  c=o_i64(B,c,get32(CS,96) as i64);
  c=o_app(B,c," tf2=");
  c=o_i64(B,c,get32(CS,100) as i64);
  c=o_app(B,c," Dpre=");
  c=o_i64(B,c,dpre as i64);
  c=o_app(B,c," Qpre=");
  c=o_i64(B,c,qpre as i64);
  c=o_app(B,c," Dpost=");
  c=o_i64(B,c,(dr-dpre) as i64);
  c=o_app(B,c," Qpost=");
  c=o_i64(B,c,(q-qpre) as i64);
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," od=");
  c=o_i64(B,c,od as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(CS,80) as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,(od+get32(CS,80)) as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_app(B,c," dh144=");
  c=o_i64(B,c,get32(CS,84) as i64);
  c=o_app(B,c," qh144=");
  c=o_i64(B,c,get32(CS,88) as i64);
  c=o_app(B,c," dh192=");
  c=o_i64(B,c,get32(CS,108) as i64);
  c=o_app(B,c," qh192=");
  c=o_i64(B,c,get32(CS,112) as i64);
  c=o_app(B,c," lc=");
  c=o_i64(B,c,get32(CS,116) as i64);
  c=o_nl(B,c);
  return c;
}
// One episode. pol 0 = fixed lazy, pol 1 = fixed eager (restamp on
// every drift), pol 2 = adaptive with EWMA + confidence-interval
// margin test (quirk included: zero-data eager commit at e = 32),
// pol 3 = recheck (inherited dormant: not swept in this lane),
// pol 4 = guard: identical to pol 2 except the inherited
// minimum-data guard blocks eager commits while (dh,ed) = (0,0).
// [FL-DELTA] pol 5 = fastchk: identical to pol 2 except the
// checkpoint countdown resets to 8 (not 16) for checkpoint
// intervals starting at e >= 128, so post-shift checkpoints fall
// at 136,144,152,...,256. Pre-shift cadence unchanged.
// [FL-DELTA] pol 6 = fastewma: identical to pol 2 except the
// EWMA weight is 7/8 (not 15/16).
// (pol 5/6 code paths are the parent's, unchanged; dormant in this
// lane: not swept.)
// [FT-DELTA] pol 7 = fix2: identical to pol 2 except the flip-path
// lazy bar is the fixed 2*qhi < dlo (no L).
// [FT-DELTA] pol 8 = qmean: identical to pol 2 except the flip-path
// lazy bar is (L+1)*qh < dlo (point estimate, not interval upper).
// (dormant in this lane: not swept.)
// [FT-DELTA] pol 9 = adaptd: identical to pol 2 except the
// flip-path lazy bar is M*qhi < dlo with M = max(2, (L+1)-(nchk-1))
// relaxing per fruitless post-shift checkpoint (nchk at CS+120).
// (dormant in this lane: not swept.)
// [LD-DELTA] pol 10 = noeg: identical to pol 7 except the flip-path
// eager-decisive test is the L-free `phid > phin` (egl = 1).
// [LD-DELTA] pol 11 = noj: pure alias of pol 7 (fix2 code path;
// differs only in the P= name); scored post-hoc with J' = rb + rf.
// [LD-DELTA] pol 12 = nol: pure alias of pol 10 (noeg code path);
// scored post-hoc with J' = rb + rf.
// Regime shift at t = 128: fire thresholds swap from (M1,N1) to
// (M2,N2); Markov states persist, LCG sequences continue. acc packs
// deltas: 0 = on-demand rebuilds, 4 = answered, 8 = refusals,
// 12 = kb. CS packs commit state; CS+80 counts restamps (sync +
// per-drift); CS+84..112 hold regime instrumentation (see
// sld_checkpoint); CS+116 is the late-commit flag lc (stays 0 here);
// CS+120 is the [FT-DELTA] pol-9 post-shift checkpoint counter nchk
// (init 0; dormant in this lane: pol 9 not swept; never emitted).
fn sld_episode(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32,pol:i32,Lv:i32,ra:i32,oa1:i32)i32 {
  let LA:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let CS:[]u8=z_alloc(128);
  let T:i32=256;
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(LA,ra);
  et_specialize_ret(LA,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  set32(CS,0,0);
  set32(CS,4,0);
  set32(CS,8,-1);
  set32(CS,12,pol);
  set32(CS,16,pol);
  set32(CS,20,0);
  set32(CS,24,0);
  set32(CS,28,0);
  set32(CS,32,0);
  set32(CS,36,0);
  set32(CS,40,0);
  set32(CS,44,0);
  set32(CS,48,0);
  set32(CS,52,0);
  set32(CS,56,0);
  set32(CS,60,1);
  set32(CS,64,0);
  set32(CS,68,1);
  set32(CS,72,0);
  set32(CS,76,1);
  set32(CS,80,0);
  set32(CS,84,0);
  set32(CS,88,0);
  set32(CS,92,0);
  set32(CS,96,0);
  set32(CS,100,0);
  set32(CS,104,0);
  set32(CS,108,0);
  set32(CS,112,0);
  set32(CS,116,0);
  // [FT-DELTA] pol-9 post-shift checkpoint counter (nchk).
  set32(CS,120,0);
  let apol:i32=0;
  if(pol==2){ apol=1; }
  if(pol==3){ apol=1; }
  if(pol==4){ apol=1; }
  // [FL-DELTA] pol 5/6 are adaptive arms.
  if(pol==5){ apol=1; }
  if(pol==6){ apol=1; }
  // [FT-DELTA] pol 7/8/9 are adaptive arms.
  if(pol==7){ apol=1; }
  if(pol==8){ apol=1; }
  if(pol==9){ apol=1; }
  // [LD-DELTA] pol 10/11/12 are adaptive arms.
  if(pol==10){ apol=1; }
  if(pol==11){ apol=1; }
  if(pol==12){ apol=1; }
  // [CL-DELTA] pol 13/14/15 are adaptive arms.
  if(pol==13){ apol=1; }
  if(pol==14){ apol=1; }
  if(pol==15){ apol=1; }
  if(apol==1){
    set32(CS,12,0);
    set32(CS,16,0);
  }
  let s1:i64=rc_seed_d(R,M1,N1,M2,N2);
  let s2:i64=rc_seed_q(R,M1,N1,M2,N2);
  let ds:i32=0;
  let qs:i32=0;
  let TPB:i64=nr_thr_b(M1);
  let TPQ:i64=nr_thr_q(M1,TPB);
  let TQB:i64=nr_thr_b(N1);
  let TQQ:i64=nr_thr_q(N1,TQB);
  let TPB2:i64=nr_thr_b(M2);
  let TPQ2:i64=nr_thr_q(M2,TPB2);
  let TQB2:i64=nr_thr_b(N2);
  let TQQ2:i64=nr_thr_q(N2,TQB2);
  let C31:i64=2147483648;
  let TSB:i64=C31/8;
  let TSQ:i64=C31/24;
  let dh:i32=0;
  let qh:i32=0;
  let ed:i32=0;
  let eq:i32=0;
  let drifts:i32=0;
  let queries:i32=0;
  let dpre:i32=0;
  let qpre:i32=0;
  let cpd:i32=32;
  // [FL-DELTA] EWMA weights: 15/16 normally, 7/8 for pol 6.
  // Hoisted flags (znc workaround: shallow if-nesting).
  let ewa:i32=15;
  let ewd:i32=16;
  if(pol==6){ ewa=7; }
  if(pol==6){ ewd=8; }
  let t:i32=0;
  while(t<T){
    if(t==128){
      TPB=TPB2;
      TPQ=TPQ2;
      TQB=TQB2;
      TQQ=TQQ2;
    }
    s1=nr_next(s1);
    let u1:i64=s1;
    let nds:i32=ds;
    if(ds==1 && u1<TSB){ nds=0; }
    if(ds==0 && u1<TSQ){ nds=1; }
    ds=nds;
    s1=nr_next(s1);
    let u2:i64=s1;
    let df:i32=0;
    if(ds==1 && u2<TPB){ df=1; }
    if(ds==0 && u2<TPQ){ df=1; }
    s2=nr_next(s2);
    let u3:i64=s2;
    let nqs:i32=qs;
    if(qs==1 && u3<TSB){ nqs=0; }
    if(qs==0 && u3<TSQ){ nqs=1; }
    qs=nqs;
    s2=nr_next(s2);
    let u4:i64=s2;
    let qf:i32=0;
    if(qs==1 && u4<TQB){ qf=1; }
    if(qs==0 && u4<TQQ){ qf=1; }
    let cur:i32=get32(CS,12);
    if(df==1){
      et_drift_unrelated(A);
      drifts=drifts+1;
      if(cur==1){
        et_specialize_ret(LA,S,A,0,0);
        set32(CS,80,get32(CS,80)+1);
      }
    }
    if(qf==1){
      queries=queries+1;
      ld_query_default(LA,S,A,ra,oa1,K,OUT,OUTG,acc);
    }
    if(t<128){
      dpre=dpre+df;
      qpre=qpre+qf;
    }
    let adap:i32=0;
    if(pol==2){ adap=1; }
    if(pol==3){ adap=1; }
    if(pol==4){ adap=1; }
    // [FL-DELTA] pol 5/6 run the adaptive EWMA + checkpoint path.
    if(pol==5){ adap=1; }
    if(pol==6){ adap=1; }
    // [FT-DELTA] pol 7/8/9 run the adaptive EWMA + checkpoint path.
    if(pol==7){ adap=1; }
    if(pol==8){ adap=1; }
    if(pol==9){ adap=1; }
    // [LD-DELTA] pol 10/11/12 run the adaptive EWMA + checkpoint path.
    if(pol==10){ adap=1; }
    if(pol==11){ adap=1; }
    if(pol==12){ adap=1; }
    // [CL-DELTA] pol 13/14/15 run the adaptive EWMA + checkpoint path.
    if(pol==13){ adap=1; }
    if(pol==14){ adap=1; }
    if(pol==15){ adap=1; }
    if(adap==1){
      let devd:i32=1024*df-dh;
      dh=(ewa*dh+1024*df)/ewd;
      ed=(ewa*ed+devd*devd)/ewd;
      let devq:i32=1024*qf-qh;
      qh=(ewa*qh+1024*qf)/ewd;
      eq=(ewa*eq+devq*devq)/ewd;
    }
    cpd=cpd-1;
    if(cpd==0){
      if(adap==1){
        sld_checkpoint(CS,LA,S,A,dh,qh,ed,eq,drifts,queries,Lv,pol,t+1);
      }
      // [FL-DELTA] checkpoint cadence: 16 normally; 8 for pol 5
      // on post-shift intervals (e >= 128). Pre-shift cadence is
      // unchanged for every arm, so the quirk fires at e = 32
      // identically. Hoisted flag (znc workaround).
      let cres:i32=16;
      if(pol==5){ cres=8; }
      if(t+1<128){ cres=16; }
      cpd=cres;
    }
    t=t+1;
  }
  let od:i32=get32(acc,0);
  c=sld_emit_cell(B,c,R,M1,N1,M2,N2,pol,Lv,CS,dpre,qpre,drifts,queries,od,get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}

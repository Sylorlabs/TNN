// cl_main.zag -- harness main for SPEC-COMMIT-L.
// Sweeps 4 inherited regime cells x 22 arms = 88 episodes, each
// emitting one CELL line.
// Cell index ci -> (R, M1, N1, M2, N2), values inherited unchanged
// from SPEC-L-DISCIPLINE (and SPEC-FLIP-THRESHOLD before it):
//   ci=0 CS0: R=21  (16,16)->(16,16)  sparse stationary control
//   ci=1 CS1: R=60  (16,16)->(1,16)   sparse -> drift-dense
//                                     THE HARM CELL
//   ci=2 CS2: R=82  (16,16)->(16,1)   sparse -> query-dense
//   ci=3 CS3: R=120 (16,16)->(1,16)   same regime as CS1, D32 >= 1
//                                     (no quirk; the commit rule's
//                                     L-dependence lives here)
// Arms per cell:
//   pol 0 fixed lazy, pol 1 fixed eager (grandparent dynamics unchanged)
//   pol 7 fix2,         L in {1,3,7,10}   (parent control; replication)
//   pol 10 noeg,        L in {1,3,7,10}   (parent control; replication;
//                                          L-free flip, L-bearing commit)
//   pol 13 coml1,       L in {1,3,7,10}   (L-free commit, L := 1;
//                                          quirk preserved)
//   pol 14 comlg,       L in {1,3,7,10}   (L-free commit + minimum-data
//                                          guard; quirk blocked)
//   pol 15 comnoeg,     L in {1,3,7,10}   (L-free commit, eager direction
//                                          dropped; quirk channel closed)
// Arrivals are bursty and irregular (seeded per cell, identical
// across arms, regime shift at tick 128); relation/object ids arrive
// via the rb_* accessors; no world literals appear here.
fn sld_R(ci:i32)i32 {
  if(ci==0){ return 21; }
  if(ci==1){ return 60; }
  if(ci==2){ return 82; }
  return 120;
}
fn sld_m1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn sld_n1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn sld_m2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 1; }
  if(ci==2){ return 16; }
  return 1;
}
fn sld_n2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 1; }
  return 16;
}
// fix2 / noeg / coml1 / comlg / comnoeg L sweep: the commit-rule
// comparison set (L = 1: quirk-dominated identity checks; L = 3:
// divergence; L = 7: the commit rule's L-dependence boundary;
// L = 10: high-L economics).
fn sld_La(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 3; }
  if(i==2){ return 7; }
  return 10;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let ci:i32=0;
  while(ci<4){
    let R:i32=sld_R(ci);
    let M1:i32=sld_m1(ci);
    let N1:i32=sld_n1(ci);
    let M2:i32=sld_m2(ci);
    let N2:i32=sld_n2(ci);
    c=sld_episode(B,c,R,M1,N1,M2,N2,0,-1,ra,oa1);
    c=sld_episode(B,c,R,M1,N1,M2,N2,1,-1,ra,oa1);
    let li:i32=0;
    while(li<4){
      c=sld_episode(B,c,R,M1,N1,M2,N2,7,sld_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=sld_episode(B,c,R,M1,N1,M2,N2,10,sld_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=sld_episode(B,c,R,M1,N1,M2,N2,13,sld_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=sld_episode(B,c,R,M1,N1,M2,N2,14,sld_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=sld_episode(B,c,R,M1,N1,M2,N2,15,sld_La(li),ra,oa1);
      li=li+1;
    }
    ci=ci+1;
  }
  o_flush(B,c);
  return 0;
}

// world.zag -- MEADOW environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rule and episode tables. The learner never calls
// anything in this file. The driver uses the hidden rule only to
// generate observed labels for teaching.
// Tables match l2_l3_combo/PREREG.md section 3 exactly.

// Phase 0: old-world episodes, 4 readings each (slots 4,5 unfilled).
fn w_oldtab()[]u8 { return "42617035"; }
fn w_oldid(idx:i32)i32 { return idx+51; }
fn w_oldseq(idx:i32, out:[]u8)void {
  let T:[]u8=w_oldtab();
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Phase 1: ph=1 train (8 episodes x 6 readings), ph=2 test (4 x 6).
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "107050093080809810322099107001093000809803322010";}
  return "216050991190778010440428";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rule (never visible to the learner).
// rich iff e2+e4 >= 10.
fn w_true(e0:i32, e1:i32, e2:i32, e3:i32, e4:i32, e5:i32)i32 {
  if(e2+e4>=10){return 1;}
  return 0;
}

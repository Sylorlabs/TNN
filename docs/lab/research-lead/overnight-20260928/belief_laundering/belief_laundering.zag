// belief_laundering.zag -- Parameter free mitigation for the belief
// laundering vulnerability (C286 follow up). Belief Laundering
// Mitigation Worker. Unfrozen variant. Pure Zag.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// Same learner machinery as belief_forgiveness (evidence records,
// reliability from verification outcomes, independence discount, event
// identity register, band derived statuses, EVN = 64, streak gated
// wrong retirement) plus ONE new learner owned cell per source: ret,
// the cumulative count of wrongs this source has had retired
// (init 0, incremented only when a retirement fires, never reset).
//
// Escalating forgiveness price, in ev_calibrate: on a correct outcome
// the streak increments as before; a wrong is retired only if the new
// streak >= ret+2 (and historical wrongs exist), and ret increments.
// The price of the next forgiveness is derived entirely from how much
// forgiveness this source has already consumed. No tunable parameters.
// A liar with truth runs of max length L can retire at most L-1 wrongs
// ever; after that reliability converges to its true rate.
//
// Worlds M1, M1b, M2, M3: exact reruns of BELIEF-FORGIVENESS on the new
// machinery (M3 recovery must be unchanged). M4: R,R,W liar extended to
// 24 rounds (laundering must be blocked). M4b: alternating control.
// M5: relapse repair under the escalated price (1 wrong + 7 clean).
// M6: heavy debt recovery (10 wrongs, then clean).
//
// Output discipline (toolchain lesson 2026-10-02): ONE preallocated
// output buffer, cursor returning emit helpers formatting numbers
// directly into the buffer, a single _zag_raw_syscall(1,1,ptr,len)
// write at the end. No _zag_print anywhere.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }

// ---- single output buffer, cursor returning emit helpers ----
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}

// ============ state block: 1040 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header: 0 nev, 1 nsrc, 2 wmax, 3 first_contrary, 4 revision_seq,
// 5 s1, 6 s2, 7 truth, 8 abl_identity, 9 reserved, 10 nid,
// 11 nevicted, 12 ndup, 13 last_contrib
fn EVB()i32 { return 16; }
fn EVN()i32 { return 64; }
fn EVW()i32 { return 7; }   // qid,hyp,w,src,phase,contrib,eid
fn SRB()i32 { return 464; }
fn SRN()i32 { return 64; }
fn SRW()i32 { return 5; }   // correct,total,extid,streak,ret
fn DCB()i32 { return 784; }
fn DCN()i32 { return 32; }
fn DCW()i32 { return 4; }   // src,hyp,phase,count
fn IDB()i32 { return 912; }
fn IDN()i32 { return 128; }
fn NCELL()i32 { return 1040; }
fn ST_NONE()i32 { return 0; }
fn ST_PROV()i32 { return 1; }
fn ST_UNC()i32 { return 2; }
fn ST_CONF()i32 { return 3; }

fn st_init(B:[]u8,abl_identity:i32)void {
  let i:i32=0;
  while(i<NCELL()){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_identity);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+2);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+2)==0){
      cs(B,SRB()+i*SRW()+2,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn src_rel(B:[]u8,si:i32)i32 {
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}
fn src_streak(B:[]u8,si:i32)i32 { return cg(B,SRB()+si*SRW()+3); }
fn src_ret(B:[]u8,si:i32)i32 { return cg(B,SRB()+si*SRW()+4); }
fn src_wrongs(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+1)-cg(B,SRB()+si*SRW()+0);
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- event identity register: familiarity without recall ----
fn id_seen(B:[]u8,eid:i32)i32 {
  let i:i32=0;
  while(i<cg(B,10)){
    if(cg(B,IDB()+i)==eid){ return 1; }
    i=i+1;
  }
  return 0;
}
fn id_add(B:[]u8,eid:i32)void {
  let n:i32=cg(B,10);
  if(n<IDN()){ cs(B,IDB()+n,eid); cs(B,10,n+1); }
  return;
}

// ---- evidence record with FIFO eviction under memory pressure ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32,eid:i32)i32 {
  let n:i32=cg(B,0);
  let slot:i32=n;
  if(n>=EVN()){
    let i:i32=0;
    while(i<EVN()-1){
      let a:i32=EVB()+i*EVW();
      let c:i32=EVB()+(i+1)*EVW();
      let k:i32=0;
      while(k<EVW()){ cs(B,a+k,cg(B,c+k)); k=k+1; }
      i=i+1;
    }
    slot=EVN()-1;
    cs(B,11,cg(B,11)+1);
  }
  let o:i32=EVB()+slot*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib); cs(B,o+6,eid);
  if(n<EVN()){ cs(B,0,n+1); }
  return slot+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- calibration with the escalating forgiveness price ----
// Streak gated wrong retirement with learner derived escalation: a
// correct outcome at streak >= ret+2 retires one historical wrong (if
// any), where ret is this source's cumulative retired count. The price
// of forgiveness grows with consumed forgiveness. Wrong outcomes only
// add to the record, exactly as the old fraction rule.
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r;
  let seq:i32=ev_record(B,0,hyp,w,src,0,contrib,eid);
  note_wmax(B,contrib);
  let c0:i32=cg(B,SRB()+si*SRW()+0);
  let t0:i32=cg(B,SRB()+si*SRW()+1);
  let st:i32=cg(B,SRB()+si*SRW()+3);
  let rt:i32=cg(B,SRB()+si*SRW()+4);
  let ok:i32=0;
  if(hyp==truth){ ok=1; }
  let nc:i32=c0+ok;
  let nt:i32=t0+1;
  if(ok==1){
    if(st<0){ st=1; } else { st=st+1; }
    if(st>=rt+2 && nt-nc>0){ nt=nt-1; rt=rt+1; }
  } else {
    if(st>0){ st=-1; } else { st=st-1; }
  }
  cs(B,SRB()+si*SRW()+0,nc);
  cs(B,SRB()+si*SRW()+1,nt);
  cs(B,SRB()+si*SRW()+3,st);
  cs(B,SRB()+si*SRW()+4,rt);
  return seq;
}

// ---- observation on the H1/H2 question ----
fn ev_observe(B:[]u8,src:i32,hyp:i32,w:i32,phase:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let d:i32=disc_for(B,si,hyp,phase);
  let contrib:i32=w*r*d/1000;
  let seq:i32=ev_record(B,1,hyp,w,src,phase,contrib,eid);
  note_wmax(B,contrib);
  if(hyp==1){ cs(B,5,cg(B,5)+contrib); }
  else { cs(B,6,cg(B,6)+contrib); }
  cs(B,13,contrib);
  if(phase>=1 && hyp==2 && cg(B,3)==0){ cs(B,3,seq); }
  let st:i32=st_compute(B);
  if(st==23 && cg(B,4)==0){ cs(B,4,seq); }
  return seq;
}

// ---- belief status: leader*10 + code ----
fn st_compute(B:[]u8)i32 {
  let s1:i32=cg(B,5); let s2:i32=cg(B,6);
  let wm:i32=cg(B,2);
  if(s1==0 && s2==0){ return 0; }
  let d:i32=s1-s2;
  if(d==0){ return 2; }
  let leader:i32=1;
  if(d<0){ leader=2; }
  let ad:i32=d; if(ad<0){ ad=-ad; }
  let both:i32=0;
  if(s1>0 && s2>0){ both=1; }
  let U:i32=wm; let T:i32=wm*2;
  if(both==1 && ad<=U){ return leader*10+ST_UNC(); }
  if(ad>=T){ return leader*10+ST_CONF(); }
  return leader*10+ST_PROV();
}
fn st_name(ob:[]u8,at:i32,code:i32)i32 {
  if(code==0){ return e_str(ob,at,"NONE"); }
  if(code==1){ return e_str(ob,at,"PROVISIONAL"); }
  if(code==2){ return e_str(ob,at,"UNCERTAIN"); }
  return e_str(ob,at,"CONFIDENT");
}
fn print_belief(B:[]u8,ob:[]u8,at:i32,tag:[]u8)i32 {
  let st:i32=st_compute(B);
  let leader:i32=st/10; let code:i32=st%10;
  at=e_str(ob,at,tag); at=e_str(ob,at," leader="); at=e_i32(ob,at,leader);
  at=e_str(ob,at," status="); at=st_name(ob,at,code);
  at=e_str(ob,at," s1="); at=e_i32(ob,at,cg(B,5));
  at=e_str(ob,at," s2="); at=e_i32(ob,at,cg(B,6));
  at=e_str(ob,at," conf="); at=e_i32(ob,at,cg(B,5)-cg(B,6));
  at=e_str(ob,at," U="); at=e_i32(ob,at,cg(B,2));
  at=e_str(ob,at," T="); at=e_i32(ob,at,cg(B,2)*2);
  at=e_nl(ob,at);
  return at;
}

// ============ world scripts ============
// sources: 90=S (trusted, then liar / degrading), 31=W1, 32=W2

// M2 degradation pattern helpers: round i of 6, S wrong,wrong,right,
// wrong,right,wrong (hyp 1, truth as below). Exact fraction nulls.
fn m2_truth(i:i32)i32 {
  if(i==2){ return 1; }
  if(i==4){ return 1; }
  return 2;
}
fn m2_null(i:i32)i32 {
  if(i==0){ return 952; }
  if(i==1){ return 909; }
  if(i==2){ return 913; }
  if(i==3){ return 875; }
  if(i==4){ return 880; }
  return 846;
}
// M3 forgiveness nulls under streak gated retirement:
// (22+k,26+k) with one wrong retired per round at streak>=2:
// +1:(23,27)=851 +2:(24,27)=888 +3:(25,27)=925 +4:(26,27)=962 +5:(27,27)=1000
fn m3_null(k:i32)i32 {
  if(k==1){ return 851; }
  if(k==2){ return 888; }
  if(k==3){ return 925; }
  if(k==4){ return 962; }
  if(k==5){ return 1000; }
  return 1000;
}
// M4 laundering nulls under the escalating price: R,R,W from fresh
// state, 24 rounds. Only ONE wrong is ever retired (at r5); after that
// the price (streak >= ret+2 = 3) exceeds the liar's max streak of 2.
// r3:(2,3)=666 r6:(4,5)=800 r9:(6,7)=750 r12:(8,9)=727
// r18:(12,17)=705 r24:(16,23)=695. Strictly decreasing after r6,
// converging to 666, the liar's true rate. Parent rule at r24: 1000.
fn m4_null(k:i32)i32 {
  if(k==3){ return 666; }
  if(k==6){ return 800; }
  if(k==9){ return 750; }
  if(k==12){ return 727; }
  if(k==18){ return 705; }
  return 695;
}
fn m4_truth(i:i32)i32 {
  if(i%3==2){ return 2; }
  return 1;
}
// M4b alternating nulls: R,W alternating, no forgiveness, rel 500
fn m4b_truth(i:i32)i32 {
  if(i%2==1){ return 2; }
  return 1;
}
fn main()i32 {
  let ob:[]u8=z_alloc(24576);
  let at:i32=0;
  let F:[]u8=z_alloc(4);

  // ===== World M1: copied misinformation, correction, fragility =====
  let M:[]u8=z_alloc(NCELL()*4); st_init(M,0);
  let i:i32=0;
  while(i<20){ ev_calibrate(M,90,1,1,1,7001+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(M,31,1,1,1,7021+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(M,32,1,1,1,7023+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(M,src_idx(M,90)),1000),"K2-M1-relS-1000");
  at=chk(ob,at,F,eq(src_rel(M,src_idx(M,31)),1000),"K2-M1-relW1-1000");
  at=chk(ob,at,F,eq(src_rel(M,src_idx(M,32)),1000),"K2-M1-relW2-1000");

  // copy: S asserts H1 STRONG, false (truth H2)
  ev_observe(M,90,1,3,1,7030);
  at=print_belief(M,ob,at,"M1 after S strong false H1:");
  at=chk(ob,at,F,eq(st_compute(M),11),"K2-M1-copy-11");
  at=chk(ob,at,F,eq(cg(M,5),3000),"K2-M1-copy-s1-3000");
  at=chk(ob,at,F,eq(cg(M,6),0),"K2-M1-copy-s2-0");

  // exposure: S wrong; stance must not move
  ev_calibrate(M,90,1,3,2,7031);
  let re:i32=src_rel(M,src_idx(M,90));
  at=e_str(ob,at,"M1 exposure relS="); at=e_i32(ob,at,re);
  at=e_str(ob,at," null=952"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(re,952),"K2-M1-exposure-952");
  at=chk(ob,at,F,eq(st_compute(M),11),"K2-M1-exposure-stance-11");

  // contradiction: two independent moderate sources
  ev_observe(M,31,2,2,2,7032);
  at=print_belief(M,ob,at,"M1 after W1 moderate true H2:");
  at=chk(ob,at,F,eq(st_compute(M),12),"K2-M1-afterW1-12");
  at=chk(ob,at,F,eq(cg(M,6),2000),"K2-M1-afterW1-s2-2000");
  ev_observe(M,32,2,2,2,7033);
  at=print_belief(M,ob,at,"M1 after W2 moderate true H2:");
  at=chk(ob,at,F,eq(st_compute(M),22),"K2-M1-afterW2-22");
  at=chk(ob,at,F,eq(cg(M,5),3000),"K2-M1-afterW2-s1-3000");
  at=chk(ob,at,F,eq(cg(M,6),4000),"K2-M1-afterW2-s2-4000");
  at=e_str(ob,at,"M1 correction count: 2 contradicting observations\n");

  // fragility: S reasserts H1 moderate at rel 952
  ev_observe(M,90,1,2,3,7034);
  let lc:i32=cg(M,13);
  at=e_str(ob,at,"M1 reassert contrib="); at=e_i32(ob,at,lc); at=e_nl(ob,at);
  at=print_belief(M,ob,at,"M1 after S reasserts H1 moderate:");
  at=chk(ob,at,F,eq(lc,1904),"K2-M1-reassert-1904");
  at=chk(ob,at,F,eq(cg(M,5),4904),"K2-M1-reassert-s1-4904");
  at=chk(ob,at,F,eq(cg(M,6),4000),"K2-M1-reassert-s2-4000");
  at=chk(ob,at,F,eq(st_compute(M),12),"K2-M1-reassert-12");
  at=chk(ob,at,F,eq(cg(M,11),0),"K2-M1-no-eviction");

  // ===== World M1b: single-source correction count =====
  let B2:[]u8=z_alloc(NCELL()*4); st_init(B2,0);
  i=0; while(i<20){ ev_calibrate(B2,90,1,1,1,7101+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(B2,31,1,1,1,7121+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(B2,32,1,1,1,7123+i); i=i+1; }
  ev_observe(B2,90,1,3,1,7130);
  at=chk(ob,at,F,eq(st_compute(B2),11),"K2-M1b-copy-11");
  ev_observe(B2,31,2,2,2,7131);
  let c1:i32=cg(B2,13);
  at=e_str(ob,at,"M1b W1 claim1 contrib="); at=e_i32(ob,at,c1); at=e_nl(ob,at);
  at=print_belief(B2,ob,at,"M1b after W1 claim1:");
  at=chk(ob,at,F,eq(c1,2000),"K2-M1b-c1-2000");
  at=chk(ob,at,F,eq(st_compute(B2),12),"K2-M1b-st1-12");
  ev_observe(B2,31,2,2,2,7132);
  let c2:i32=cg(B2,13);
  at=e_str(ob,at,"M1b W1 claim2 contrib="); at=e_i32(ob,at,c2); at=e_nl(ob,at);
  at=print_belief(B2,ob,at,"M1b after W1 claim2:");
  at=chk(ob,at,F,eq(c2,1000),"K2-M1b-c2-1000");
  at=chk(ob,at,F,eq(st_compute(B2),2),"K2-M1b-st2-tie");
  ev_observe(B2,31,2,2,2,7133);
  let c3:i32=cg(B2,13);
  at=e_str(ob,at,"M1b W1 claim3 contrib="); at=e_i32(ob,at,c3); at=e_nl(ob,at);
  at=print_belief(B2,ob,at,"M1b after W1 claim3:");
  at=chk(ob,at,F,eq(c3,500),"K2-M1b-c3-500");
  at=chk(ob,at,F,eq(st_compute(B2),22),"K2-M1b-st3-22");
  at=chk(ob,at,F,eq(cg(B2,5),3000),"K2-M1b-s1-3000");
  at=chk(ob,at,F,eq(cg(B2,6),3500),"K2-M1b-s2-3500");
  at=e_str(ob,at,"M1b correction count: 3 contradicting observations\n");
  at=chk(ob,at,F,eq(cg(B2,11),0),"K2-M1b-no-eviction");

  // ===== World M2: noisy degradation with control =====
  let D2:[]u8=z_alloc(NCELL()*4); st_init(D2,0);
  i=0; while(i<20){ ev_calibrate(D2,90,1,1,1,7201+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(D2,31,1,1,1,7221+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(D2,src_idx(D2,90)),1000),"K2-M2-build-S-1000");
  at=chk(ob,at,F,eq(src_rel(D2,src_idx(D2,31)),1000),"K2-M2-build-W1-1000");
  i=0;
  while(i<6){
    ev_calibrate(D2,90,1,1,m2_truth(i),7223+i);
    ev_calibrate(D2,31,1,1,1,7229+i);
    let rr:i32=src_rel(D2,src_idx(D2,90));
    let rw:i32=src_rel(D2,src_idx(D2,31));
    at=e_str(ob,at,"M2 degrade round="); at=e_i32(ob,at,i+1);
    at=e_str(ob,at," relS="); at=e_i32(ob,at,rr);
    at=e_str(ob,at," null="); at=e_i32(ob,at,m2_null(i));
    at=e_str(ob,at," relW1="); at=e_i32(ob,at,rw); at=e_nl(ob,at);
    at=chk(ob,at,F,eq(rr,m2_null(i)),"K2-M2-degrade-linear");
    at=chk(ob,at,F,eq(rw,1000),"K2-M2-control-1000");
    i=i+1;
  }
  // downstream: S asserts H1 moderate at degraded rel 846
  ev_observe(D2,90,1,2,1,7235);
  let dc:i32=cg(D2,13);
  at=e_str(ob,at,"M2 downstream contrib="); at=e_i32(ob,at,dc);
  at=e_str(ob,at," (reliable would give 2000)"); at=e_nl(ob,at);
  at=print_belief(D2,ob,at,"M2 after S moderate H1 at rel 846:");
  at=chk(ob,at,F,eq(dc,1692),"K2-M2-downstream-1692");
  at=chk(ob,at,F,eq(st_compute(D2),11),"K2-M2-downstream-11");
  at=chk(ob,at,F,eq(cg(D2,5),1692),"K2-M2-downstream-s1-1692");

  // ===== World M3: forgiveness curve on the same learner state =====
  // Escalation must be exactly satisfiable here: recovery unchanged.
  i=0;
  while(i<20){
    ev_calibrate(D2,90,1,1,1,7301+i);
    let k:i32=i+1;
    if(k<=5 || k==20){
      let rk:i32=src_rel(D2,src_idx(D2,90));
      let sk:i32=src_streak(D2,src_idx(D2,90));
      let wk:i32=src_wrongs(D2,src_idx(D2,90));
      let tk:i32=src_ret(D2,src_idx(D2,90));
      at=e_str(ob,at,"M3 recovery +"); at=e_i32(ob,at,k);
      at=e_str(ob,at," relS="); at=e_i32(ob,at,rk);
      at=e_str(ob,at," null="); at=e_i32(ob,at,m3_null(k));
      at=e_str(ob,at," streak="); at=e_i32(ob,at,sk);
      at=e_str(ob,at," wrongs="); at=e_i32(ob,at,wk);
      at=e_str(ob,at," ret="); at=e_i32(ob,at,tk); at=e_nl(ob,at);
      at=chk(ob,at,F,eq(rk,m3_null(k)),"K3-M3-recovery-curve");
    }
    i=i+1;
  }
  let rfin:i32=src_rel(D2,src_idx(D2,90));
  at=e_str(ob,at,"M3 final relS after 20 clean rounds="); at=e_i32(ob,at,rfin); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(rfin,1000),"K3-M3-final-1000");
  at=chk(ob,at,F,eq(src_ret(D2,src_idx(D2,90)),4),"K3-M3-ret-4");
  at=chk(ob,at,F,eq(cg(D2,11),0),"K3-M3-no-eviction");

  // ===== World M4: adversarial laundering (fresh state) =====
  // S runs R,R,W x8: a liar telling truth 2/3 of the time, 24 rounds.
  // The mitigation must cap total laundered wrongs at 1 and bend the
  // trajectory down toward 666 instead of up toward 1000.
  let L4:[]u8=z_alloc(NCELL()*4); st_init(L4,0);
  i=0;
  while(i<24){
    ev_calibrate(L4,90,1,1,m4_truth(i),7401+i);
    let q:i32=i+1;
    if(q==3 || q==6 || q==9 || q==12 || q==18 || q==24){
      let rl:i32=src_rel(L4,src_idx(L4,90));
      let sl:i32=src_streak(L4,src_idx(L4,90));
      let wl:i32=src_wrongs(L4,src_idx(L4,90));
      let tl:i32=src_ret(L4,src_idx(L4,90));
      at=e_str(ob,at,"M4 launder round="); at=e_i32(ob,at,q);
      at=e_str(ob,at," relS="); at=e_i32(ob,at,rl);
      at=e_str(ob,at," null="); at=e_i32(ob,at,m4_null(q));
      at=e_str(ob,at," streak="); at=e_i32(ob,at,sl);
      at=e_str(ob,at," wrongs="); at=e_i32(ob,at,wl);
      at=e_str(ob,at," ret="); at=e_i32(ob,at,tl); at=e_nl(ob,at);
      at=chk(ob,at,F,eq(rl,m4_null(q)),"K4-M4-launder-curve");
    }
    i=i+1;
  }
  at=chk(ob,at,F,eq(src_ret(L4,src_idx(L4,90)),1),"K4-M4-ret-1");
  at=chk(ob,at,F,eq(src_wrongs(L4,src_idx(L4,90)),7),"K4-M4-wrongs-7");
  at=chk(ob,at,F,eq(cg(L4,11),0),"K4-M4-no-eviction");

  // ===== World M4b: alternating control (fresh state) =====
  // S alternates R,W: streak never reaches 2, no forgiveness allowed.
  let A4:[]u8=z_alloc(NCELL()*4); st_init(A4,0);
  i=0;
  while(i<6){
    ev_calibrate(A4,90,1,1,m4b_truth(i),7451+i);
    let q2:i32=i+1;
    if(q2==2 || q2==4 || q2==6){
      let ra:i32=src_rel(A4,src_idx(A4,90));
      at=e_str(ob,at,"M4b alternate round="); at=e_i32(ob,at,q2);
      at=e_str(ob,at," relS="); at=e_i32(ob,at,ra);
      at=e_str(ob,at," null=500"); at=e_nl(ob,at);
      at=chk(ob,at,F,eq(ra,500),"K4-M4b-alternating-500");
    }
    i=i+1;
  }
  at=chk(ob,at,F,eq(src_wrongs(A4,src_idx(A4,90)),3),"K4-M4b-wrongs-unforgiven");
  at=chk(ob,at,F,eq(src_ret(A4,src_idx(A4,90)),0),"K4-M4b-ret-0");

  // ===== World M5: relapse after full recovery (continues M3 state) =====
  // After M3: S at (42,42), streak +20, ret 4 (heavy forgiveness
  // history). One wrong, then 7 clean rounds. The escalated price
  // (streak >= ret+2 = 6) delays repair of the relapse wrong to the
  // 6th clean round. Nulls: 976, 977, 977, 978, 978, 979, 1000, 1000.
  ev_calibrate(D2,90,1,1,2,7501);
  let r51:i32=src_rel(D2,src_idx(D2,90));
  at=e_str(ob,at,"M5 relapse relS="); at=e_i32(ob,at,r51);
  at=e_str(ob,at," null=976"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(r51,976),"K5-M5-relapse-976");
  i=0;
  while(i<7){
    ev_calibrate(D2,90,1,1,1,7502+i);
    let r5k:i32=src_rel(D2,src_idx(D2,90));
    let n5:i32=0;
    if(i==0){ n5=977; }
    if(i==1){ n5=977; }
    if(i==2){ n5=978; }
    if(i==3){ n5=978; }
    if(i==4){ n5=979; }
    if(i==5){ n5=1000; }
    if(i==6){ n5=1000; }
    at=e_str(ob,at,"M5 repair"); at=e_i32(ob,at,i+1);
    at=e_str(ob,at," relS="); at=e_i32(ob,at,r5k);
    at=e_str(ob,at," null="); at=e_i32(ob,at,n5); at=e_nl(ob,at);
    at=chk(ob,at,F,eq(r5k,n5),"K5-M5-repair-curve");
    i=i+1;
  }
  at=chk(ob,at,F,eq(src_ret(D2,src_idx(D2,90)),5),"K5-M5-ret-5");
  at=chk(ob,at,F,eq(src_wrongs(D2,src_idx(D2,90)),0),"K5-M5-wrongs-0");
  at=chk(ob,at,F,eq(cg(D2,11),0),"K5-M5-no-eviction");

  // ===== World M6: heavy debt recovery (fresh state) =====
  // 10 wrongs, then 12 clean rounds. Escalation must stay exactly
  // satisfiable: at clean round k>=2 the streak is k and the price is
  // (k-2)+2 = k. Full recovery in wrongs+1 = 11 rounds.
  // Nulls: c1 (1,11)=90, c2 (2,11)=181, c11 (11,11)=1000, c12=1000.
  let H6:[]u8=z_alloc(NCELL()*4); st_init(H6,0);
  i=0; while(i<10){ ev_calibrate(H6,90,1,1,2,7601+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(H6,src_idx(H6,90)),0),"K6-M6-debt-0");
  i=0;
  while(i<12){
    ev_calibrate(H6,90,1,1,1,7611+i);
    let q6:i32=i+1;
    if(q6==1 || q6==2 || q6==11 || q6==12){
      let r6:i32=src_rel(H6,src_idx(H6,90));
      let t6:i32=src_ret(H6,src_idx(H6,90));
      let n6:i32=1000;
      if(q6==1){ n6=90; }
      if(q6==2){ n6=181; }
      at=e_str(ob,at,"M6 clean c"); at=e_i32(ob,at,q6);
      at=e_str(ob,at," relS="); at=e_i32(ob,at,r6);
      at=e_str(ob,at," null="); at=e_i32(ob,at,n6);
      at=e_str(ob,at," ret="); at=e_i32(ob,at,t6); at=e_nl(ob,at);
      at=chk(ob,at,F,eq(r6,n6),"K6-M6-recovery-curve");
    }
    i=i+1;
  }
  at=chk(ob,at,F,eq(src_ret(H6,src_idx(H6,90)),10),"K6-M6-ret-10");
  at=chk(ob,at,F,eq(src_wrongs(H6,src_idx(H6,90)),0),"K6-M6-wrongs-0");
  at=chk(ob,at,F,eq(cg(H6,11),0),"K6-M6-no-eviction");

  let fails:i32=get32(F,0);
  if(fails==0){ at=e_str(ob,at,"ALL PASS\n"); }
  else { at=e_str(ob,at,"FAILURES: "); at=e_i32(ob,at,fails); at=e_nl(ob,at); }

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){ return 0; }
  return 1;
}

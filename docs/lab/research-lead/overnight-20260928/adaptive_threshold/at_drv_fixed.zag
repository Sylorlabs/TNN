// at_drv_fixed.zag -- FIXED arm driver (original resolve_uncertainty_v2).
// Reports the fixed 3-slot history; there is no adaptive state.
fn report_ev(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==2){
      print_str("hist=("); print_i32(ng(W,n,8));
      print_str(","); print_i32(ng(W,n,12));
      print_str(","); print_i32(ng(W,n,16));
      print_str(") fixedT=3");
      return;
    }
    n=n+1;
  }
  print_str("polnode=MISSING");
  return;
}

fn main()i32 {
  print_str("ARM=FIXED\n");
  run_stable();
  run_noisy();
  run_changing();
  print_str("DONE\n");
  return 0;
}

// at_drv_adaptive.zag -- ADAPTIVE arm driver.
fn report_ev(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==3){
      print_str("T="); print_i32(ng(W,n,20));
      print_str(" E="); print_i32(ng(W,n,16));
      print_str(" R="); print_i32(ng(W,n,12));
      print_str(" V="); print_i32(ng(W,n,8));
      print_str(" writes="); print_i32(ng(W,n,24));
      print_str(" mm="); print_i32(ng(W,n,28));
      print_str(" maxT="); print_i32(ng(W,n,32));
      return;
    }
    n=n+1;
  }
  print_str("evnode=MISSING");
  return;
}

fn main()i32 {
  print_str("ARM=ADAPTIVE\n");
  run_stable();
  run_noisy();
  run_changing();
  print_str("DONE\n");
  return 0;
}

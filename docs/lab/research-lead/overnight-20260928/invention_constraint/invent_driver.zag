// invent_driver.zag -- Hypothesis 3 experiment driver.
//
// Three constraint problems in fresh workspaces. Each problem teaches a
// world with a solution fact path plus distractor short paths, then
// queries with structural constraints. TREAT (invent_on=1) must construct
// a constraint-satisfying MAP. NO-INVENT (invent_on=0, one-line diff)
// runs trial, which finds the answer via a short distractor path whose
// form violates the constraints.

// ---- instrumentation ----
fn iv_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn iv_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn iv_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=invent_relseq(W,m,seq,7);
  emit("MAP "); e64(m); emit(" relseq=[");
  let i:i32=0;
  while(i<len){if(i>0){emit(",");} e64(get32(seq,i*4)); i=i+1;}
  emit("] len="); e64(len); emit("\n");
  return;
}
// K3: count pre-existing MAPs satisfying C. Must be 0.
fn iv_k3_scan(W:[]u8,C:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(invent_check(W,m,C)==1){n=n+1;}
    }
    m=m+1;
  }
  return n;
}
// Build a constraint struct. -1 = don't care.
fn iv_mkC(plen:i32,re_r:i32,re_n:i32,first_rel:i32,last_rel:i32,first_lit:i32)[]u8 {
  let C:[]u8=z_alloc(24);
  set32(C,0,plen); set32(C,4,re_r); set32(C,8,re_n);
  set32(C,12,first_rel); set32(C,16,last_rel); set32(C,20,first_lit);
  return C;
}
// Problem 1: plen=5, rel7 exactly 2, first_rel=3, first_lit=3.
fn iv_world1(W:[]u8)void {
  ev_teach(W,3,3,10); ev_teach(W,10,7,20); ev_teach(W,20,5,30);
  ev_teach(W,30,7,40); ev_teach(W,40,9,90);
  ev_teach(W,3,5,11); ev_teach(W,11,5,90);
  ev_teach(W,3,7,12); ev_teach(W,12,7,90);
  return;
}
fn iv_prob1(W:[]u8)void {
  emit("=== PROBLEM 1 ===\n");
  iv_world1(W);
  let C:[]u8=iv_mkC(5,7,2,3,-1,3);
  emit("K3 pre-existing satisfying MAPs="); e64(iv_k3_scan(W,C)); emit("\n");
  let ans:i32=ev_query_c(W,3,70,90,0,C);
  emit("P1 ans="); e64(ans); emit("\n");
  let m:i32=iv_find_map(W,3,70);
  emit("P1 MAP id="); e64(m); emit(" check="); e64(invent_check(W,m,C)); emit("\n");
  if(m>=0){iv_print_relseq(W,m);}
  return;
}
// Problem 2: plen=4, rel5 exactly 1, last_rel=9. Decoy dead end forces
// backtracking: (50,3,65)->(65,5,75) has no outgoing facts from 75.
fn iv_world2(W:[]u8)void {
  ev_teach(W,50,3,65); ev_teach(W,65,5,75);
  ev_teach(W,50,3,60); ev_teach(W,60,5,70);
  ev_teach(W,70,7,80); ev_teach(W,80,9,150);
  ev_teach(W,50,7,55); ev_teach(W,55,7,150);
  return;
}
fn iv_prob2(W:[]u8)void {
  emit("=== PROBLEM 2 ===\n");
  iv_world2(W);
  let C:[]u8=iv_mkC(4,5,1,-1,9,-1);
  emit("K3 pre-existing satisfying MAPs="); e64(iv_k3_scan(W,C)); emit("\n");
  let ans:i32=ev_query_c(W,50,71,150,0,C);
  emit("P2 ans="); e64(ans); emit("\n");
  let m:i32=iv_find_map(W,50,71);
  emit("P2 MAP id="); e64(m); emit(" check="); e64(invent_check(W,m,C)); emit("\n");
  if(m>=0){iv_print_relseq(W,m);}
  return;
}
// Problem 3: plen=6, rel7 exactly 3, first_rel=3.
fn iv_world3(W:[]u8)void {
  ev_teach(W,200,3,205); ev_teach(W,205,7,215); ev_teach(W,215,5,225);
  ev_teach(W,225,7,235); ev_teach(W,235,9,245); ev_teach(W,245,7,300);
  ev_teach(W,200,5,210); ev_teach(W,210,5,300);
  return;
}
fn iv_prob3(W:[]u8)void {
  emit("=== PROBLEM 3 ===\n");
  iv_world3(W);
  let C:[]u8=iv_mkC(6,7,3,3,-1,-1);
  emit("K3 pre-existing satisfying MAPs="); e64(iv_k3_scan(W,C)); emit("\n");
  let ans:i32=ev_query_c(W,200,72,300,0,C);
  emit("P3 ans="); e64(ans); emit("\n");
  let m:i32=iv_find_map(W,200,72);
  emit("P3 MAP id="); e64(m); emit(" check="); e64(invent_check(W,m,C)); emit("\n");
  if(m>=0){iv_print_relseq(W,m);}
  return;
}
fn main()i32 {
  emit("INVENT-H3-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); iv_prob1(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); iv_prob2(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); iv_prob3(W3);
  emit("INVENT-H3-END\n");
  return 0;
}

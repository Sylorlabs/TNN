// Appended to unchanged P6 runtime/table/greedy matcher prefix.
fn ci(d:i32,nt:i32,start:i32,end:i32)i32 { return ((d*3+nt)*9+start)*9+end; }
fn chart(RH:[]u8,AR:[]u8,s:[]u8,n:i32,cap:i32,C:[]u8)i32 {
  let z:i32=0; while(z<9*3*9*9){ wset(C,z,0); z=z+1; }
  let endpoints:[]u8=z_alloc(36); let next:[]u8=z_alloc(36);
  let d:i32=cap;
  while(d>=0){
    let nt:i32=0;
    while(nt<3){
      let start:i32=0;
      while(start<=n){
        let r:i32=0;
        while(r<3){
          let ar:i32=arity(AR,nt,r);
          if(ar>0){
            let clear:i32=0; while(clear<9){wset(endpoints,clear,0);clear=clear+1;} wset(endpoints,start,1);
            let k:i32=0;
            while(k<ar){
              clear=0; while(clear<9){wset(next,clear,0);clear=clear+1;} let sym:i32=rhs(RH,k,nt,r);
              let p:i32=0;
              while(p<=n){
                if(wget(endpoints,p)==1){
                  if(sym>=3){
                    if(p<n){ if(wget(s,p)==sym){ wset(next,p+1,1); } }
                  } else {
                    let end:i32=p;
                    while(end<=n){
                      if(d<cap){ if(wget(C,ci(d+1,sym,p,end))==1){ wset(next,end,1); } }
                      end=end+1;
                    }
                  }
                }
                p=p+1;
              }
              clear=0; while(clear<9){wset(endpoints,clear,wget(next,clear));clear=clear+1;} k=k+1;
            }
            let end:i32=start;
            while(end<=n){
              if(wget(endpoints,end)==1){ wset(C,ci(d,nt,start,end),1); }
              end=end+1;
            }
          }
          r=r+1;
        }
        start=start+1;
      }
      nt=nt+1;
    }
    d=d-1;
  }
  return wget(C,ci(0,0,0,n));
}
fn term(x:i32,perm:i32)i32 { if(perm==1){return 9-x;} return x; }
fn rule(RH:[]u8,AR:[]u8,nt:i32,r:i32,a:i32,x:i32,y:i32,z:i32)void {
  wset(AR,qidx(nt,r),a); wset(RH,qidx(nt,r)*3,x);
  wset(RH,qidx(nt,r)*3+1,y); wset(RH,qidx(nt,r)*3+2,z); return;
}
fn fixture(RH:[]u8,AR:[]u8,world:i32,order:i32,perm:i32)void {
  let a:i32=term(3,perm); let b:i32=term(4,perm);
  if(world==0){ build(RH,AR); return; }
  if(world==1){ rule(RH,AR,0,0,2,1,b,0); rule(RH,AR,1,order,1,a,0,0); rule(RH,AR,1,1-order,2,a,b,0); return; }
  if(world==2){ rule(RH,AR,0,order,2,a,b,0); rule(RH,AR,0,1-order,3,a,0,b); return; }
  if(world==3){ rule(RH,AR,0,order,2,a,b,0); rule(RH,AR,0,1-order,2,0,b,0); return; }
  return;
}
fn oracle(s:[]u8,n:i32,world:i32,perm:i32,root:i32,cap:i32)i32 {
  if(world==0){
    if(n==3 && wget(s,0)==3 && wget(s,1)==3 && wget(s,2)==4){ return 1; }
    if(root==0){
      if(n==2 && wget(s,0)==3 && wget(s,1)==3){return 1;}
      if(n==4 && wget(s,0)==3 && wget(s,1)==3 && wget(s,2)==4 && wget(s,3)==5){return 1;}
    }
    return 0;
  }
  let a:i32=term(3,perm); let b:i32=term(4,perm);
  if(world==1){
    if(n==1 && root==0 && wget(s,0)==a){return 1;}
    if(n==2 && wget(s,0)==a && wget(s,1)==b){return 1;}
    if(n==3 && wget(s,0)==a && wget(s,1)==b && wget(s,2)==b){return 1;}
    return 0;
  }
  if(world==2){
    if(n%2!=0){return 0;} let half:i32=n/2;
    if(half<1 || half>cap+1){return 0;}
    let k:i32=0;
    while(k<n){
      if(k<half){ if(wget(s,k)!=a){return 0;} }
      else { if(wget(s,k)!=b){return 0;} }
      k=k+1;
    }
    return 1;
  }
  if(world==3){
    if(n<2 || n>cap+2 || wget(s,0)!=a){return 0;}
    let k:i32=1; while(k<n){if(wget(s,k)!=b){return 0;} k=k+1;} return 1;
  }
  return 0;
}
fn met(ob:[]u8,c:i32,name:[]u8,v:i32)i32 { let p:i32=o_app(ob,c,name); return o_i64(ob,p,v as i64); }
fn main()i32 {
  let ob:[]u8=z_alloc(65536); let c:i32=0; let unexpected:i32=0;
  let world:i32=0;
  while(world<6){
    let actual:i32=world; let cap:i32=8;
    if(world==4){actual=2;cap=1;} if(world==5){actual=5;}
    let orders:i32=2; let perms:i32=2;
    if(world==0 || world==5){orders=1;perms=1;}
    let order:i32=0;
    while(order<orders){
      let perm:i32=0;
      while(perm<perms){
        let RH:[]u8=z_alloc(108); let AR:[]u8=z_alloc(36);
        fixture(RH,AR,actual,order,perm);
        let s:[]u8=z_alloc(36); let C:[]u8=z_alloc(9*3*9*9*4);
        let maxlen:i32=8; let radix:i32=2;
        if(world==0 || world==1 || world==5){maxlen=4;radix=4;}
        let tested:i32=0; let mismatch:i32=0; let greedyerr:i32=0;
        let rootaccepted:i32=0; let unionaccepted:i32=0; let n:i32=1;
        while(n<=maxlen){
          let total:i32=1; let k:i32=0; while(k<n){total=total*radix;k=k+1;}
          let code:i32=0;
          while(code<total){
            let v:i32=code; k=0;
            while(k<n){let symbol:i32=3+v%radix;if(radix==2){symbol=term(symbol,perm);}wset(s,k,symbol);v=v/radix;k=k+1;}
            let cr:i32=chart(RH,AR,s,n,cap,C); let cu:i32=0; let nt:i32=0;
            while(nt<3){if(wget(C,ci(0,nt,0,n))==1){cu=1;}nt=nt+1;}
            let er:i32=oracle(s,n,actual,perm,1,cap); let eu:i32=oracle(s,n,actual,perm,0,cap);
            if(cr!=er || cu!=eu){mismatch=mismatch+1;}
            let gr:i32=0; if(match(RH,AR,0,s,0,n,0)==n){gr=1;}
            let gu:i32=derivable(RH,AR,s,n);
            if(cap==8){if(gr!=er || gu!=eu){greedyerr=greedyerr+1;}}
            rootaccepted=rootaccepted+cr;unionaccepted=unionaccepted+cu;tested=tested+1;
            code=code+1;
          }
          n=n+1;
        }
        let out:[]u8=z_alloc(160);let cur:[]u8=z_alloc(4);
        let generated:i32=gen(RH,AR,0,out,cur,0);let witness:i32=0;
        if(generated==1){witness=oracle(out,wget(cur,0),actual,perm,1,8);}
        c=met(ob,c,"scorer world=",world);c=met(ob,c," order=",order);c=met(ob,c," perm=",perm);
        c=met(ob,c," cap=",cap);c=met(ob,c," tested=",tested);c=met(ob,c," chart_mismatch=",mismatch);
        c=met(ob,c," greedy_errors=",greedyerr);c=met(ob,c," root_accept=",rootaccepted);
        c=met(ob,c," union_accept=",unionaccepted);c=met(ob,c," witness_valid=",witness);c=o_nl(ob,c);
        if(mismatch!=0){unexpected=unexpected+1;}
        if(world==1 && greedyerr!=1){unexpected=unexpected+1;}
        if(world<5 && witness!=1){unexpected=unexpected+1;}
        if(radix==4 && tested!=340){unexpected=unexpected+1;}
        if(radix==2 && tested!=510){unexpected=unexpected+1;}
        perm=perm+1;
      }
      order=order+1;
    }
    world=world+1;
  }
  c=met(ob,c,"instrumentation_unexpected=",unexpected);c=o_nl(ob,c);_zag_print(ob[0..c]);
  if(unexpected!=0){return 1;}return 0;
}

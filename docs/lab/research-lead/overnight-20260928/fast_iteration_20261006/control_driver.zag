// Appended to unchanged contract module prefix.
fn met(O:[]u8,c:i32,name:[]u8,v:i32)i32 {let p:i32=e1str(O,c,name);return e1i64(O,p,v as i64);}
fn copy(S:[]u8,T:[]u8)void {let i:i32=0;while(i<S.len){T[i]=S[i];i=i+1;}return;}
fn pred(S:[]u8,base:i32,x:i32)i32 {return u_check(S,base,1,x,0,0,0,0,0);}
fn setup(S:[]u8,base:i32,lo:i32,hi:i32)void {
  u_write_clause(S,base,0,0,0,lo,hi);ss(S,base,7);ss(S,base+1,1);ss(S,base+2,1);ss(S,base+3,1);return;
}
fn table(S:[]u8,lo:i32,hi:i32,reject:i32,extra:i32)void {
  ss(S,300,1);ss(S,301,2+extra);ss(S,302,1);
  ss(S,304,1);ss(S,305,lo);ss(S,311,1);ss(S,312,hi);
  ss(S,318,1);ss(S,319,8);ss(S,528,1);ss(S,529,reject);return;
}
fn guarded_grow(S:[]u8,base:i32,x:i32)i32 {
  let T:[]u8=z_alloc(S.len);copy(S,T);u_grow(T,base,x,0,0,0,0,0);
  let r:i32=0;let conflict:i32=0;
  while(r<sg(T,302)){
    if(u_rejlen(T,r)==sg(T,base+2)){
      let p:i32=u_check(T,base,u_rejlen(T,r),u_rej(T,r,0),u_rej(T,r,1),u_rej(T,r,2),u_rej(T,r,3),u_rej(T,r,4),u_rej(T,r,5));
      if(p==1){conflict=conflict+1;}
    }
    r=r+1;
  }
  if(conflict==0){copy(T,S);return 1;}return 0;
}
// Context contains its own judgment window and history. Contract bodies share C.
// Generic wrapper invokes unchanged API in an isolated temporary arena.
fn local_call(C:[]u8,base:i32,ctx:[]u8,action:i32)void {
  let T:[]u8=z_alloc(8192);copy(ctx,T);let i:i32=0;
  while(i<32){ss(T,100+i,sg(C,base+i));i=i+1;}
  if(action==0){let result:i32=u_invalidate(T,100,1,0);}
  else {u_revise(T,100,1);}
  copy(T,ctx);i=0;while(i<32){ss(C,base+i,sg(T,100+i));i=i+1;}return;
}
fn main()i32 {
  let O:[]u8=z_alloc(65536);let c:i32=0;let unexpected:i32=0;
  let hull:[]u8=z_alloc(8192);let gate:[]u8=z_alloc(8192);let rei:[]u8=z_alloc(8192);
  table(hull,2,4,6,0);table(gate,2,4,6,0);table(rei,2,4,6,1);
  let ih:i32=u_induct(hull,100);let ig:i32=u_induct(gate,100);let ir:i32=u_induct(rei,100);
  u_grow(hull,100,8,0,0,0,0,0);let committed:i32=guarded_grow(gate,100,8);
  c=met(O,c,"growth gate_committed=",committed);c=met(O,c," hull_reject6=",pred(hull,100,6));
  c=met(O,c," gate_reject6=",pred(gate,100,6));c=met(O,c," gate_success8=",pred(gate,100,8));
  c=met(O,c," reinduct_reject6=",pred(rei,100,6));c=met(O,c," reinduct_success8=",pred(rei,100,8));c=e1str(O,c,"\n");
  let x:i32=1;
  while(x<=10){
    c=met(O,c,"grid x=",x);c=met(O,c," hull=",pred(hull,100,x));c=met(O,c," gated=",pred(gate,100,x));
    c=met(O,c," reinduct=",pred(rei,100,x));c=e1str(O,c,"\n");x=x+1;
  }
  if(ih!=1 || ig!=1 || ir!=1 || committed!=0){unexpected=unexpected+1;}
  if(pred(hull,100,6)!=1 || pred(gate,100,6)!=0 || pred(gate,100,8)!=0){unexpected=unexpected+1;}
  if(pred(rei,100,6)!=0 || pred(rei,100,8)!=1){unexpected=unexpected+1;}
  let unseen:[]u8=z_alloc(8192);setup(unseen,100,2,4);table(unseen,2,4,10,0);
  let attack:i32=guarded_grow(unseen,100,8);
  c=met(O,c,"unseen_attack gate_committed=",attack);c=met(O,c," known_reject10=",pred(unseen,100,10));
  c=met(O,c," unseen_forbidden6=",pred(unseen,100,6));c=e1str(O,c,"\n");
  if(attack!=1 || pred(unseen,100,10)!=0 || pred(unseen,100,6)!=1){unexpected=unexpected+1;}

  let shared:[]u8=z_alloc(8192);setup(shared,100,2,4);setup(shared,200,20,30);table(shared,20,30,40,0);
  let A:[]u8=z_alloc(8192);let B:[]u8=z_alloc(8192);
  setup(A,100,2,4);table(A,2,4,6,0);setup(B,100,20,30);table(B,20,30,40,0);
  let C:[]u8=z_alloc(8192);let CA:[]u8=z_alloc(8192);let CB:[]u8=z_alloc(8192);
  setup(C,100,2,4);setup(C,200,20,30);table(CA,2,4,6,0);table(CB,20,30,40,0);
  let i:i32=0;
  while(i<3){let h:i32=u_invalidate(shared,100,1,0);let a:i32=u_invalidate(A,100,1,0);local_call(C,100,CA,0);i=i+1;}
  u_revise(shared,200,1);u_revise(B,100,1);local_call(C,200,CB,1);
  let surviving:i32=sg(CA,901);let separatedreq:i32=sg(A,901);
  c=met(O,c,"isolation shared_B_rev=",sg(shared,904));c=met(O,c," separate_B_rev=",sg(B,904));
  c=met(O,c," local_B_rev=",sg(CB,904));c=met(O,c," A_req_after_B=",surviving);
  c=met(O,c," separate_A_req_after_B=",separatedreq);c=e1str(O,c,"\n");
  u_revise(A,100,1);local_call(C,100,CA,1);
  c=met(O,c,"A_revision separate=",sg(A,904));c=met(O,c," local=",sg(CA,904));
  c=met(O,c," local_A_pred3=",pred(C,100,3));c=met(O,c," local_B_pred25=",pred(C,200,25));c=e1str(O,c,"\n");
  if(sg(shared,904)!=1 || sg(B,904)!=0 || sg(CB,904)!=0 || surviving!=1 || separatedreq!=1){unexpected=unexpected+1;}
  if(sg(A,904)!=1 || sg(CA,904)!=1 || pred(C,100,3)!=1 || pred(C,200,25)!=1){unexpected=unexpected+1;}
  c=met(O,c,"instrumentation_unexpected=",unexpected);c=e1str(O,c,"\n");_zag_print(O[0..c]);
  if(unexpected!=0){return 1;}return 0;
}

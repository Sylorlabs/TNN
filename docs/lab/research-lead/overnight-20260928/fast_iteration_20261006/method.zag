// PHASE 6 STRUCTURAL PRECONDITION -- pure Zag.
//
// Per FRONTIER_QUEUE `substrate-spec`: prove the task is SOLVABLE BY SOME PRODUCTION
// SET before implementing any induction. This runs BEFORE any result is read.
//
// QUESTION: can a SINGLE production table support both
//   forward  (generate a terminal string from a non-terminal) and
//   backward (decide whether a terminal string is derivable)?
// Phase 6's core finding is that a STATISTICAL model cannot do both, so the
// representation class must be structural. This tests that a structural one CAN.
//
// HONESTY NOTE -- this prover reported PASS, then FAILED six times, every time on a
// bug in the PROVER or in how it was run, never on the grammar under test:
//   1. `on` passed BY VALUE into expand() -> the parent's output length was lost, so
//      every recursive branch appeared to fail.
//   2. rules written into arbitrary slots while the rule lookup indexed by LHS ->
//      A0's second rule belonged to a different non-terminal.
//   3. cyclic rules with no output bound -> wrote past out[] and printed heap garbage
//      as though it were derived symbols.
//   4. RHS stored at a BYTE offset (+4) inside an INT-indexed 4-int block -> rhs1 read
//      back as A0, so A0 recursed into itself to the depth cap and reported FAILED.
//   5. the zero-init loop cleared only every 4th int, leaving rhs/arity slots holding
//      raw malloc garbage.
//   6. an apostrophe inside a string literal ("prover's") terminated the parse, and
//      then one line was missing a closing paren. E0001 "unexpected end of input".
// Plus one PROCESS failure worth as much as the six: after a FAILED compile I ran the
// binary anyway and read its output as a result. The build was stale, so for a while
// I was reasoning about a program that did not exist. Every run since is gated on the
// compile succeeding, and `rm -f` precedes it.
//
// A harness with six bugs cannot license a "the substrate is dead" conclusion, which is
// why the verdict text below says to fix the prover rather than conclude anything. That
// is the single most important thing in this file.
//
// Two process lessons, recorded because they cost the most time:
//   - My paren-balance checker flagged the missing paren on the offending line, and I
//     dismissed it twice as an "awk stripping artifact" because the line's string
//     contained digits like 3,2,4 that I assumed were confusing it. Instrumentation
//     that disagrees with you should be believed until you have explained it away, not
//     explained away until it agrees.
//   - Bisecting a parse error by appending a FIXED number of closing braces gives
//     nonsense results; the append has to match the brace depth of the truncated
//     prefix, or the harness "passes" only by accident at exactly one depth.
//
// DESIGN RULE ADOPTED AFTER THOSE FAILURES: no block strides, no mixed byte/int
// offsets. Every logical int lives in its own flat array, indexed by a single integer
// q = l*NRULE() + r, and ALL reads/writes go through wset()/wget() so a write and its
// read can never disagree about units again.
//
// GRAMMAR (non-terminals 0,1,2; terminals 3..6):
//     A0 -> A1 4
//     A1 -> 3 3
//     A2 -> A0 5
// RECURSION IS NECESSARY, not decorative: A0 and A2 have no terminal-only
// alternative, so the only way to expand either of them is through a non-terminal.
// The base case sits at A1. A depth cap is still required because A2 -> A0 and A0 -> A1
// sit inside the cycle.
//
// HAND-DERIVED EXPECTATIONS -- the machine must reproduce exactly these, so the check
// is against arithmetic a reader can do, not against the prover's own output:
//   forward A0 -> 3 3 4        (len 3)
//   forward A1 -> 3 3          (len 2)
//   forward A2 -> 3 3 4 5      (len 4)
//   backward: exactly 3 of 340 strings derivable, namely 33 / 334 / 3345
// Check: A0 -> A1 4 with A1 -> 3 3 gives 3 3 4. A2 -> A0 5 with that A0 gives
// 3 3 4 5. Nothing else is derivable, because A1 emits only "3 3" and every rule has a
// fixed literal tail, so no other terminal sequence can be produced.
//
// usage: precond.zag

// ---- runtime ------------------------------------------------------------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
// THE ONLY two accessors used for logical int arrays. Unit symmetry is the whole point.
fn wset(a:[]u8,i:i32,v:i32)void { set32(a,i*4,v); }
fn wget(a:[]u8,i:i32)i32 { return get32(a,i*4); }
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

// Appended to unchanged P6 byte arena/output helpers prefix before constants.
fn step(z:i32,t:i32)i32 {let arg:i32=t%6-2;if(t<6){return z+arg;}return z*arg;}
fn execute(id:i32,x:i32)i32 {
  if(id<0){return -99999;}
  if(id<12){return step(x,id);}
  let n:i32=id-12;return step(step(x,n/12),n%12);
}
fn fits(id:i32,F:[]u8,n:i32)i32 {
  let i:i32=0;while(i<n){if(execute(id,wget(F,i*2))!=wget(F,i*2+1)){return 0;}i=i+1;}return 1;
}
fn acquire(F:[]u8,n:i32,work:[]u8)i32 {
  let id:i32=0;while(id<156){wset(work,0,wget(work,0)+1);if(fits(id,F,n)==1){return id;}id=id+1;}return -1;
}
fn consensus(F:[]u8,n:i32,x:i32)i32 {
  let found:i32=0;let answer:i32=-99999;let id:i32=0;
  while(id<156){
    if(fits(id,F,n)==1){
      let v:i32=execute(id,x);
      if(found==1 && v!=answer){return -99999;}answer=v;found=1;
    }
    id=id+1;
  }
  return answer;
}
fn lookup(F:[]u8,n:i32,x:i32)i32 {
  let i:i32=0;while(i<n){if(wget(F,i*2)==x){return wget(F,i*2+1);}i=i+1;}return -99999;
}
fn train(F:[]u8,a:i32,b:i32)void {
  let i:i32=0;while(i<3){let x:i32=-2+i*2;wset(F,i*2,x);wset(F,i*2+1,a*x+b);i=i+1;}return;
}
fn affine(F:[]u8,x:i32)i32 {let slope:i32=(wget(F,5)-wget(F,1))/4;return slope*x+wget(F,3);}
fn met(O:[]u8,c:i32,name:[]u8,v:i32)i32 {let p:i32=o_app(O,c,name);return o_i64(O,p,v as i64);}
fn main()i32 {
  let O:[]u8=z_alloc(65536);let c:i32=0;let unexpected:i32=0;
  let methodcorrect:i32=0;let factcorrect:i32=0;let freshcorrect:i32=0;let recomputecorrect:i32=0;
  let affinecorrect:i32=0;let erasedcorrect:i32=0;let randomhits:i32=0;let acquisitionwork:i32=0;let recomputework:i32=0;
  let a:i32=1;
  while(a<=3){
    let b:i32=-2;
    while(b<=2){
      let F:[]u8=z_alloc(24);train(F,a,b);let work:[]u8=z_alloc(4);let id:i32=acquire(F,3,work);
      acquisitionwork=acquisitionwork+wget(work,0);
      // Persist only executable ID; discard all training facts for this arm.
      let state:[]u8=z_alloc(4);wset(state,0,id);let erased:[]u8=z_alloc(4);wset(erased,0,-1);
      let mc:i32=0;let ac:i32=0;let x:i32=5;
      while(x<=12){
        let answer:i32=a*x+b;
        if(execute(wget(state,0),x)==answer){mc=mc+1;methodcorrect=methodcorrect+1;}
        if(lookup(F,3,x)==answer){factcorrect=factcorrect+1;}
        if(execute(0,x)==answer){freshcorrect=freshcorrect+1;}
        if(execute(wget(erased,0),x)==answer){erasedcorrect=erasedcorrect+1;}
        if(affine(F,x)==answer){ac=ac+1;affinecorrect=affinecorrect+1;}
        let rw:[]u8=z_alloc(4);let rid:i32=acquire(F,3,rw);recomputework=recomputework+wget(rw,0);
        if(execute(rid,x)==answer){recomputecorrect=recomputecorrect+1;}
        let randomid:i32=0;while(randomid<156){if(execute(randomid,x)==answer){randomhits=randomhits+1;}randomid=randomid+1;}
        x=x+1;
      }
      c=met(O,c,"method_world a=",a);c=met(O,c," b=",b);c=met(O,c," acquired_id=",id);
      c=met(O,c," candidates_tested=",wget(work,0));c=met(O,c," method_correct=",mc);c=met(O,c," affine_correct=",ac);c=o_nl(O,c);
      if(mc!=8 || ac!=8 || id<0){unexpected=unexpected+1;}
      b=b+1;
    }
    a=a+1;
  }
  c=met(O,c,"ownership total=",120);c=met(O,c," method=",methodcorrect);c=met(O,c," facts=",factcorrect);
  c=met(O,c," method_erased=",erasedcorrect);c=met(O,c," fresh=",freshcorrect);c=met(O,c," recompute=",recomputecorrect);
  c=met(O,c," affine=",affinecorrect);c=met(O,c," random_correct_pairs=",randomhits);
  c=met(O,c," random_total_pairs=",120*156);c=met(O,c," acquisition_candidate_work=",acquisitionwork);
  c=met(O,c," recompute_candidate_work=",recomputework);c=o_nl(O,c);
  if(methodcorrect!=120 || factcorrect!=0 || erasedcorrect!=0 || affinecorrect!=120 || recomputecorrect!=120){unexpected=unexpected+1;}
  let world:i32=1;
  while(world<=2){
    let F:[]u8=z_alloc(24);wset(F,0,0);wset(F,1,0);
    let pre:i32=consensus(F,1,3);wset(F,2,2);wset(F,3,world*2);
    let post:i32=consensus(F,2,3);
    c=met(O,c,"disambiguation world_slope=",world);c=met(O,c," before_witness=",pre);
    c=met(O,c," after_witness=",post);c=met(O,c," facts_query3=",lookup(F,2,3));c=o_nl(O,c);
    if(pre!=-99999 || post!=world*3 || lookup(F,2,3)!=-99999){unexpected=unexpected+1;}
    world=world+1;
  }
  let F:[]u8=z_alloc(24);let W:[]u8=z_alloc(4);train(F,1,0);let old:i32=acquire(F,3,W);
  train(F,3,2);wset(W,0,0);let revised:i32=acquire(F,3,W);let revisioncorrect:i32=0;let stale:i32=0;
  let x:i32=13;while(x<=20){if(execute(revised,x)==3*x+2){revisioncorrect=revisioncorrect+1;}if(execute(old,x)==3*x+2){stale=stale+1;}x=x+1;}
  c=met(O,c,"revision stale_correct=",stale);c=met(O,c," reacquired_correct=",revisioncorrect);c=o_nl(O,c);
  if(revisioncorrect!=8 || stale!=0){unexpected=unexpected+1;}
  let square:[]u8=z_alloc(24);let i:i32=0;while(i<3){let v:i32=-2+i*2;wset(square,i*2,v);wset(square,i*2+1,v*v);i=i+1;}
  wset(W,0,0);let impossible:i32=acquire(square,3,W);
  c=met(O,c,"outside_DSL acquired_id=",impossible);c=met(O,c," candidates_tested=",wget(W,0));c=o_nl(O,c);
  if(impossible!=-1 || wget(W,0)!=156){unexpected=unexpected+1;}
  c=met(O,c,"instrumentation_unexpected=",unexpected);c=o_nl(O,c);_zag_print(O[0..c]);
  if(unexpected!=0){return 1;}return 0;
}

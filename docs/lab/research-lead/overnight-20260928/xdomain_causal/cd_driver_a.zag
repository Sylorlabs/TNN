// cd_driver_a.zag -- XDOMAIN-CAUSAL driver for MECH-A (plen contract chaining).
//
// Causal -> intervention battery. World: A in {1,2} (confounder),
// C = A (cause), E = A + 2*C (effect). Units 501 (A=1,E=3) and 502
// (A=2,E=6). X = observational predictor (81 facts, 3-link chains,
// query rel 91). Y = confounder reader (88 facts, 2-link chains,
// query rel 92). Z queries: 93 = do(C=1), 94 = do(C=2).
//   Z1=(501,94)->5  do!=see (surgery)    Z2=(501,93)->3  do==see
//   Z3=(502,94)->6  do==see              Z4=(502,93)->4  do!=see
// Arms: TREAT, ABL-X, ABL-Y, FRESH, ORACLE, AUDIT.
// Pure Zag. No Python. Safebin PATH.

fn cd_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cd_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cd_census_a(W:[]u8)void {
  emit("maps="); e64(cd_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("MAP id="); e64(m);
      emit(" r="); e64(ng(W,m,4));
      emit(" s="); e64(ng(W,m,8));
      emit(" ans="); e64(ng(W,m,28));
      emit(" contract="); e64(cx_contract(W,m));
      emit("\n");
    }
    m=m+1;
  }
  return;
}
fn cd_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn cd_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// World state: unit A-facts + declarative causal edges (inert).
fn cd_world(W:[]u8)void {
  ev_teach(W,501,86,1); ev_teach(W,502,86,2);
  ev_teach(W,801,71,802); ev_teach(W,801,71,803); ev_teach(W,802,71,803);
  return;
}
fn cd_trainX(W:[]u8)void {
  ev_teach(W,501,81,511); ev_teach(W,511,81,515); ev_teach(W,515,81,3);
  ev_teach(W,502,81,512); ev_teach(W,512,81,516); ev_teach(W,516,81,6);
  let x1:i32=ev_query(W,501,91,3,0);
  emit("X1 ans="); e64(x1); cd_tstat(W);
  let x2:i32=ev_query(W,502,91,6,0);
  emit("X2 ans="); e64(x2); cd_tstat(W);
  return;
}
fn cd_trainY(W:[]u8)void {
  ev_teach(W,501,88,521); ev_teach(W,521,88,1);
  ev_teach(W,502,88,522); ev_teach(W,522,88,2);
  let y1:i32=ev_query(W,501,92,1,0);
  emit("Y1 ans="); e64(y1); cd_tstat(W);
  let y2:i32=ev_query(W,502,92,2,0);
  emit("Y2 ans="); e64(y2); cd_tstat(W);
  return;
}
fn cd_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32)void {
  let z:i32=ev_query(W,s,r,expected,0);
  emit(tag); emit(" ans="); e64(z); cd_tstat(W);
  return;
}
fn cd_zall(W:[]u8)void {
  cd_zq(W,"Z1",501,94,5);
  cd_zq(W,"Z2",501,93,3);
  cd_zq(W,"Z3",502,94,6);
  cd_zq(W,"Z4",502,93,4);
  return;
}
// Driver-level do-operator (observability only, not a mechanism):
// read the observed parent value, inject the do-value, recompute
// via the structural equation E = A + 2*C.
fn cd_aval(W:[]u8,u:i32)i32 {
  let x:i32=2;
  while(x<1024){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==u && ng(W,x,24)==86){
      return ng(W,x,28);
    }
    x=x+1;
  }
  return -999999;
}
fn cd_oracle(W:[]u8)void {
  emit("ORACLE Z1="); e64(cd_aval(W,501)+2*2);
  emit(" Z2="); e64(cd_aval(W,501)+2*1);
  emit(" Z3="); e64(cd_aval(W,502)+2*2);
  emit(" Z4="); e64(cd_aval(W,502)+2*1);
  emit("\n");
  return;
}
fn cd_npaths(W:[]u8,s:i32)i32 {
  let paths:[]u8=z_alloc(4608);
  if(paths.len<4608){return -1;}
  return t2_gather(W,s,paths);
}
fn cd_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  cd_world(W);
  cd_trainX(W);
  cd_trainY(W);
  cd_gap(W);
  cd_census_a(W);
  cd_zall(W);
  return;
}
fn cd_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  cd_world(W);
  cd_trainY(W);
  cd_gap(W);
  emit("maps="); e64(cd_count_maps(W)); emit("\n");
  cd_zall(W);
  return;
}
fn cd_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  cd_world(W);
  cd_trainX(W);
  cd_gap(W);
  emit("maps="); e64(cd_count_maps(W)); emit("\n");
  cd_zall(W);
  return;
}
fn cd_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  cd_world(W);
  cd_gap(W);
  cd_zall(W);
  return;
}
fn cd_arm_oracle(W:[]u8)void {
  emit("=== ORACLE ===\n");
  cd_world(W);
  ev_teach(W,501,81,511); ev_teach(W,511,81,515); ev_teach(W,515,81,3);
  ev_teach(W,502,81,512); ev_teach(W,512,81,516); ev_teach(W,516,81,6);
  ev_teach(W,501,88,521); ev_teach(W,521,88,1);
  ev_teach(W,502,88,522); ev_teach(W,522,88,2);
  cd_gap(W);
  cd_oracle(W);
  return;
}
fn cd_arm_audit(W:[]u8)void {
  emit("=== AUDIT ===\n");
  cd_world(W);
  cd_trainX(W);
  cd_trainY(W);
  cd_gap(W);
  cd_census_a(W);
  emit("AUDIT npaths(3)="); e64(cd_npaths(W,3));
  emit(" npaths(1)="); e64(cd_npaths(W,1));
  emit("\n");
  cd_oracle(W);
  return;
}
fn main()i32 {
  emit("CD-A-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); cd_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); cd_arm_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); cd_arm_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); cd_arm_fresh(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); cd_arm_oracle(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); cd_arm_audit(W6);
  emit("CD-A-END\n");
  return 0;
}

// h1.zag -- H1 typed contracts + REBIND for causal->intervention L2.
//
// World, arms, and kill bars are frozen in PREREG.md
// (xdomain_causal/l2adapt/, committed before any implementation).
// Mechanism logic follows xdomain_l2/l2_h1.zag (H1 typed contracts,
// two-phase solver, generic REBIND); only the world facts, the causal
// behaviors, and the intervention setup are new.
// Under test: whether the LEARNER drives evidence-source rebinding
// (adaptation) of the causal equation, not behavior induction
// (behaviors are installed as prior learning).
//
// X (behav 0): causal equation X(s) = g(s,in1) + 2*g(s,in2).
//   in1/in2 bound generically (1st/2nd distinct relation); in2 is the
//   rebindable evidence source for the intervened variable C.
// Y (behav 1): intervention-spec reader Y(q) = g(q,in1), in1=89
//   installed as prior learning (the intervention interface).
// D (behav 2): distractor equation D(s) = 3*g(s,in1).
// O (behav 3): observational predictor O(s) = g(s,in1) (CONTROL:
//   C279-style rebinding of a pure observational mapping).
//
// The solver materializes the intervention by reading do_val and yrel
// through Y (never a literal) and asserting (s,yrel,do_val); Phase 2
// rebinds X's in2 to generic scan candidates. Severing C from
// observation is expressed as rebinding, not graph rewriting.
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 z_id, 8 solved, 12 tries, 16 out_cur, 20 arm_verdict
// facts: base 64, 64 entries x 12 bytes (used,subj,rel,obj)
// maps: base 832, 16 entries x 56 bytes
//   (used,behav,in1,in2,sig_in,sig_out,in_sum,in_n,out_sum,out_n,comp_a,comp_b,rebound_of,pad)
// candidates: base 2048, 8 entries x 4 bytes
fn h1_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==0){
      put32(W,64+(i*16),1); put32(W,64+(i*16)+4,s);
      put32(W,64+(i*16)+8,r); put32(W,64+(i*16)+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn h1_facts(W:[]u8,dospec:i32)void {
  // Training facts. Insertion order determines bind_nth for s=501:
  // 86 (1st), 87 (2nd), 85 (3rd), 84 (4th).
  add_fact(W,501,86,1); add_fact(W,502,86,2);
  add_fact(W,501,87,1); add_fact(W,502,87,2);
  add_fact(W,501,85,3); add_fact(W,502,85,6);
  add_fact(W,501,84,9); add_fact(W,502,84,9);
  if(dospec==1){
    // Intervention interface: qrel-keyed do-spec, as in C273/C275.
    add_fact(W,93,89,1); add_fact(W,94,89,2);
  }
  let i:i32=0;
  while(i<30){
    add_fact(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// First object o of fact (s,r,o), or -999999 when missing.
fn g(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==s && ig(W,64+(i*16)+8)==r){
      return ig(W,64+(i*16)+12);
    }
    i=i+1;
  }
  return -999999;
}
// Bind in1 (slot 0) or in2 (slot 1) to the nth distinct relation
// observed for subj. Generic; no literals.
fn bind_nth(W:[]u8,m:i32,subj:i32,n:i32,slot:i32)void {
  let count:i32=0;
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==subj){
      let r:i32=ig(W,64+(i*16)+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<i){
        if(ig(W,64+(k*16))==1 && ig(W,64+(k*16)+4)==subj && ig(W,64+(k*16)+8)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0){
        count=count+1;
        if(count==n){
          let b:i32=832+(m*56);
          if(slot==0){ put32(W,b+8,r); } else { put32(W,b+12,r); }
          return;
        }
      }
    }
    i=i+1;
  }
  return;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=832+(m*56);
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,-1); put32(W,b+12,-1);
  put32(W,b+16,0); put32(W,b+20,0);
  put32(W,b+24,0); put32(W,b+28,0); put32(W,b+32,0); put32(W,b+36,0);
  put32(W,b+40,-1); put32(W,b+44,-1); put32(W,b+48,-1); put32(W,b+52,0);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,832+(m*56),0); return; }
fn map_used(W:[]u8,m:i32)i32 { return ig(W,832+(m*56)); }
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=832+(m*56);
  let bh:i32=ig(W,b+4);
  if(bh==0){
    let a:i32=g(W,v,ig(W,b+8));
    let c:i32=g(W,v,ig(W,b+12));
    if(a==-999999 || c==-999999){ return -999999; }
    return a+2*c;
  }
  if(bh==1){ return g(W,v,ig(W,b+8)); }
  if(bh==2){
    let x:i32=g(W,v,ig(W,b+8));
    if(x==-999999){ return -999999; }
    return 3*x;
  }
  if(bh==3){ return g(W,v,ig(W,b+8)); }
  let a2:i32=ig(W,b+40); let c2:i32=ig(W,b+44);
  let mid:i32=exec_map(W,a2,v);
  if(mid==-999999){ return -999999; }
  return exec_map(W,c2,mid);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=832+(m*56);
  put32(W,b+24,ig(W,b+24)+probe_kind(W,vin));
  put32(W,b+28,ig(W,b+28)+1);
  put32(W,b+32,ig(W,b+32)+probe_kind(W,vout));
  put32(W,b+36,ig(W,b+36)+1);
  return;
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=832+(m*56);
  let inn:i32=ig(W,b+28); let outn:i32=ig(W,b+36);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+24)*2>=inn*3){ si=2; }
    put32(W,b+16,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+32)*2>=outn*3){ so=2; }
    put32(W,b+20,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,832+(m*56)+16); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,832+(m*56)+20); }
fn rebind_map(W:[]u8,m:i32,cr:i32,slot:i32)i32 {
  // Generic REBIND operator: copy the MAP, set the bindable parameter
  // slot to the candidate relation, inherit the learned signature,
  // record rebound_of provenance. No domain knowledge.
  let nm:i32=map_new(W,ig(W,832+(m*56)+4));
  let nb:i32=832+(nm*56);
  let ob:i32=832+(m*56);
  put32(W,nb+8,ig(W,ob+8));
  put32(W,nb+12,ig(W,ob+12));
  if(slot==0){ put32(W,nb+8,cr); } else { put32(W,nb+12,cr); }
  put32(W,nb+16,ig(W,ob+16));
  put32(W,nb+20,ig(W,ob+20));
  put32(W,nb+48,m);
  return nm;
}
fn scan_candidates(W:[]u8,s:i32)i32 {
  // Generic candidate scan: distinct relations r with a fact (s,r,*),
  // first-seen order. Contains no domain knowledge.
  let n:i32=0;
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==s){
      let r:i32=ig(W,64+(i*16)+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+k*4)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+n*4,r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn cand_rel(W:[]u8,i:i32)i32 { return ig(W,2048+i*4); }
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=832+(z*56);
  put32(W,zb+40,a); put32(W,zb+44,b);
  put32(W,zb+16,sig_in(W,a));
  put32(W,zb+20,sig_out(W,b));
  put32(W,4,z);
  return z;
}
fn teach_all(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  bind_nth(W,x,501,1,0);
  bind_nth(W,x,501,2,1);
  let r:i32=exec_map(W,x,501); record_obs(W,x,501,r);
  r=exec_map(W,x,502); record_obs(W,x,502,r);
  finalize_sig(W,x);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,x)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,x));
  eS(W,OUT," in1="); eN(W,OUT,ig(W,832+(x*56)+8));
  eS(W,OUT," in2="); eN(W,OUT,ig(W,832+(x*56)+12)); eS(W,OUT,"\n");
  // Y is installed with knowledge of the intervention interface
  // (in1=89), representing prior learning about where do-specs live.
  // Analogous to C279's ALLOC with its fixed divisor.
  let y:i32=map_new(W,1);
  put32(W,832+(y*56)+8,89);
  r=exec_map(W,y,93); record_obs(W,y,93,r);
  r=exec_map(W,y,94); record_obs(W,y,94,r);
  finalize_sig(W,y);
  eS(W,OUT,"TEACH Y id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,y)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,y));
  eS(W,OUT," in1="); eN(W,OUT,ig(W,832+(y*56)+8)); eS(W,OUT,"\n");
  let d:i32=map_new(W,2);
  bind_nth(W,d,501,1,0);
  r=exec_map(W,d,501); record_obs(W,d,501,r);
  r=exec_map(W,d,502); record_obs(W,d,502,r);
  finalize_sig(W,d);
  eS(W,OUT,"TEACH D id="); eN(W,OUT,d);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,d)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,d));
  eS(W,OUT," in1="); eN(W,OUT,ig(W,832+(d*56)+8)); eS(W,OUT,"\n");
  let o:i32=map_new(W,3);
  bind_nth(W,o,501,3,0);
  r=exec_map(W,o,501); record_obs(W,o,501,r);
  r=exec_map(W,o,502); record_obs(W,o,502,r);
  finalize_sig(W,o);
  eS(W,OUT,"TEACH O id="); eN(W,OUT,o);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,o)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,o));
  eS(W,OUT," in1="); eN(W,OUT,ig(W,832+(o*56)+8)); eS(W,OUT,"\n");
  return;
}
// Two-phase solver. Phase 1 is exact L1 reuse. Phase 2 (l2_on=1) is the
// L2 adaptation: the intervention is materialized through Y, then each
// MAP's rebindable evidence-source slot is rebound to each generic
// candidate relation and retried.
fn solve_z(W:[]u8,OUT:[]u8,s:i32,qrel:i32,goal:i32,type_on:i32,l2_on:i32)void {
  put32(W,8,0);
  put32(W,4,-1);
  // Intervention setup: read do_val and yrel through Y (never a literal),
  // then assert (s,yrel,do_val) to materialize the set value.
  if(map_used(W,1)==1){
    let yrel:i32=ig(W,832+56+8);
    let dov:i32=exec_map(W,1,qrel);
    if(dov!=-999999){
      add_fact(W,s,yrel,dov);
      eS(W,OUT,"SETUP do_val="); eN(W,OUT,dov);
      eS(W,OUT," yrel="); eN(W,OUT,yrel); eS(W,OUT,"\n");
    } else {
      eS(W,OUT,"SETUP no-doval\n");
    }
  } else {
    eS(W,OUT,"SETUP no-Y\n");
  }
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,goal);
  let nm:i32=ig(W,0);
  let tries:i32=0;
  eS(W,OUT,"PHASE1 L1:\n");
  let m:i32=0;
  while(m<nm){
    if(ig(W,8)==0 && map_used(W,m)==1){
      let ok:i32=1;
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        eS(W,OUT,"TRY single m="); eN(W,OUT,m); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
        if(r==goal){
          eS(W,OUT,"Z-SINGLE m="); eN(W,OUT,m); eS(W,OUT,"\n");
          put32(W,4,m);
          put32(W,8,1);
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,8)==0 && map_used(W,a)==1 && map_used(W,b)==1){
        let ok:i32=1;
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=-999999;
          if(mid!=-999999){ r=exec_map(W,b,mid); }
          eS(W,OUT,"TRY pair a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b);
          eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
          if(r==goal){
            let z:i32=promote_comp(W,a,b);
            eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
            eS(W,OUT," a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
            put32(W,8,1);
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ig(W,8)==0){
    eS(W,OUT,"L1-FAIL\n");
  }
  if(ig(W,8)==1 || l2_on==0){
    if(ig(W,8)==1){ put32(W,12,tries); } else { put32(W,12,0-tries); }
    return;
  }
  eS(W,OUT,"PHASE2 L2:\n");
  let nc:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,nc);
  let ci0:i32=0;
  while(ci0<nc){
    eS(W,OUT," "); eN(W,OUT,cand_rel(W,ci0));
    ci0=ci0+1;
  }
  eS(W,OUT,"\n");
  let n0:i32=ig(W,0);
  let rid:i32=0;
  while(rid<n0){
    if(ig(W,8)==0 && map_used(W,rid)==1){
      // X (id 0) rebinds in2 (the intervened variable's evidence
      // source); the context binding in1 is held fixed. D, O, Y
      // rebind in1.
      let slot:i32=0;
      if(rid==0){ slot=1; }
      let ci:i32=0;
      while(ci<nc){
        if(ig(W,8)==0){
          let cr:i32=cand_rel(W,ci);
          let nm2:i32=rebind_map(W,rid,cr,slot);
          eS(W,OUT,"REBIND m="); eN(W,OUT,rid);
          eS(W,OUT," slot="); eN(W,OUT,slot);
          eS(W,OUT," cr="); eN(W,OUT,cr);
          eS(W,OUT," nm="); eN(W,OUT,nm2); eS(W,OUT,"\n");
          let ok1:i32=1;
          if(type_on==1){
            if(sig_in(W,nm2)!=kin){ ok1=0; }
            if(sig_out(W,nm2)!=kout){ ok1=0; }
          }
          if(ok1==1){
            tries=tries+1;
            let r1:i32=exec_map(W,nm2,s);
            eS(W,OUT,"TRY single m="); eN(W,OUT,nm2); eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,"\n");
            if(r1==goal){
              eS(W,OUT,"Z-RSINGLE m="); eN(W,OUT,nm2); eS(W,OUT,"\n");
              eS(W,OUT,"REBOUND m="); eN(W,OUT,nm2);
              eS(W,OUT," in1="); eN(W,OUT,ig(W,832+nm2*56+8));
              eS(W,OUT," in2="); eN(W,OUT,ig(W,832+nm2*56+12));
              eS(W,OUT," rebound_of="); eN(W,OUT,ig(W,832+nm2*56+48)); eS(W,OUT,"\n");
              put32(W,4,nm2);
              put32(W,8,1);
            }
          }
          // Pairs with the rebound MAP (type-pruned here; kept for
          // completeness per the prereg).
          let b:i32=0;
          let nn:i32=ig(W,0);
          while(b<nn){
            if(ig(W,8)==0 && map_used(W,b)==1 && b!=nm2){
              let ok2:i32=1;
              if(type_on==1){
                if(sig_out(W,nm2)!=sig_in(W,b)){ ok2=0; }
              }
              if(ok2==1){
                tries=tries+1;
                let mid2:i32=exec_map(W,nm2,s);
                let r2:i32=-999999;
                if(mid2!=-999999){ r2=exec_map(W,b,mid2); }
                if(r2==goal){
                  let z2:i32=promote_comp(W,nm2,b);
                  eS(W,OUT,"Z-RCOMP z="); eN(W,OUT,z2); eS(W,OUT,"\n");
                  put32(W,8,1);
                }
              }
            }
            b=b+1;
          }
        }
        ci=ci+1;
      }
    }
    rid=rid+1;
  }
  if(ig(W,8)==1){ put32(W,12,tries); } else { eS(W,OUT,"L2-FAIL\n"); put32(W,12,0-tries); }
  return;
}
// Returns 1 iff solved via a rebound of X (id 0) whose rebound
// parameter equals Y's relation (the do-spec relation, read from Y,
// never a literal).
fn check_surgery(W:[]u8)i32 {
  if(ig(W,8)==0){ return 0; }
  let z:i32=ig(W,4);
  if(z<0){ return 0; }
  let zb:i32=832+(z*56);
  if(ig(W,zb+48)!=0){ return 0; }
  let in2:i32=ig(W,zb+12);
  if(map_used(W,1)==0){ return 0; }
  let yrel:i32=ig(W,832+56+8);
  if(in2==yrel){ return 1; }
  return 0;
}
// One episode: fresh workspace, world, teach, solve, check.
// expect: 1 = solve expected (surgery checked when surgery==1),
//         0 = fail expected. Returns 1 iff expectation met.
// Threads the OUT cursor through W[16].
fn episode(W:[]u8,OUT:[]u8,s:i32,qrel:i32,goal:i32,surgery:i32,l2_on:i32,do_teach:i32,del_x:i32,del_y:i32,dospec:i32,expect:i32)i32 {
  let Wz:[]u8=z_alloc(8192);
  h1_init(Wz);
  put32(Wz,16,ig(W,16));
  h1_facts(Wz,dospec);
  if(do_teach==1){ teach_all(Wz,OUT); }
  if(del_x==1){ del_map(Wz,0); }
  if(del_y==1){ del_map(Wz,1); }
  eS(Wz,OUT,"--- Z s="); eN(Wz,OUT,s);
  eS(Wz,OUT," qrel="); eN(Wz,OUT,qrel);
  eS(Wz,OUT," goal="); eN(Wz,OUT,goal); eS(Wz,OUT," ---\n");
  solve_z(Wz,OUT,s,qrel,goal,1,l2_on);
  put32(W,16,ig(Wz,16));
  let ok:i32=0;
  if(expect==1){
    if(surgery==1){
      if(check_surgery(Wz)==1){ ok=1; }
    } else {
      if(ig(Wz,8)==1){ ok=1; }
    }
  } else {
    if(ig(Wz,8)==0){ ok=1; }
  }
  if(ok==1){ eS(W,OUT,"EP-RESULT PASS\n"); } else { eS(W,OUT,"EP-RESULT FAIL\n"); }
  return ok;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  let p:i32=1;
  if(episode(W,OUT,501,94,5,1,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,501,93,3,0,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,94,6,0,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,93,4,1,1,1,0,0,1,1)==0){ p=0; }
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  let p:i32=1;
  // Z1, Z4 must fail (adaptation necessary); Z2, Z3 solve observationally.
  if(episode(W,OUT,501,94,5,0,0,1,0,0,1,0)==0){ p=0; }
  if(episode(W,OUT,501,93,3,0,0,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,94,6,0,0,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,93,4,0,0,1,0,0,1,0)==0){ p=0; }
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_ablx(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,1,0,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_ably(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,0,1,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,0,0,0,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_nodospec(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== NO-DOSPEC ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,0,0,0,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"H1-CAUSAL-START\n");
  let W1:[]u8=z_alloc(8192); h1_init(W1); put32(W1,16,cur);
  arm_treat(W1,OUT); cur=ig(W1,16); let v1:i32=ig(W1,20);
  let W2:[]u8=z_alloc(8192); h1_init(W2); put32(W2,16,cur);
  arm_l1only(W2,OUT); cur=ig(W2,16); let v2:i32=ig(W2,20);
  let W3:[]u8=z_alloc(8192); h1_init(W3); put32(W3,16,cur);
  arm_ablx(W3,OUT); cur=ig(W3,16); let v3:i32=ig(W3,20);
  let W4:[]u8=z_alloc(8192); h1_init(W4); put32(W4,16,cur);
  arm_ably(W4,OUT); cur=ig(W4,16); let v4:i32=ig(W4,20);
  let W5:[]u8=z_alloc(8192); h1_init(W5); put32(W5,16,cur);
  arm_fresh(W5,OUT); cur=ig(W5,16); let v5:i32=ig(W5,20);
  let W6:[]u8=z_alloc(8192); h1_init(W6); put32(W6,16,cur);
  arm_nodospec(W6,OUT); cur=ig(W6,16); let v6:i32=ig(W6,20);
  let tot:i32=v1+v2+v3+v4+v5+v6;
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/6\n");
  cur=e1str(OUT,cur,"H1-CAUSAL-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

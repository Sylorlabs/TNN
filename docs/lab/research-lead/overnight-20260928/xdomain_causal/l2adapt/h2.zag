// h2.zag -- Cross-domain L2 adaptive reuse: H2 value composition + REBIND.
// Causal (X: A->C->E equation) to intervention (do-surgery on C).
//
// H2 uses MODES (value-level functions with parameters), not H1's typed
// contracts. Modes are installed as prior learning; the learner must
// discover the right parameter binding via L2 REBIND.
//
// Modes:
//   0=EQN: causal equation E = g(s,86) + 2*g(s,p2). p2 is rebindable (init 87).
//   1=DOSPEC: intervention-spec reader, g(q,89). Param fixed at 89.
//   2=OBS: observational predictor, g(s,85). CONTROL (must not solve via rebind).
//
// Phase 1 (L1): try singles (EQN, OBS) and ordered pair (DOSPEC,EQN).
//   Z1/Z4 fail (surgery needed). Z2/Z3 solve via EQN observationally.
// Phase 2 (L2): scan candidate relations, rebind EQN's p2 to each,
//   validate. Z1/Z4 solve when p2=89 (the asserted do-value relation).
//
// World, arms, kill bars frozen in PREREG.md (committed 016aa13d9).
// Pure Zag. u8-backed workspace, 16-byte fact slots (48 slots), 56-byte modes.
// 0 modes/bridges/handlers (the 3 H2 modes are the mechanism, not new).
// Single-buffer output + one _zag_raw_syscall. No _zag_print for dynamic content.

// ---------- prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
// Output helpers: single preallocated buffer, cursor-returning.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  while(k<nd){
    let d:i64=u%10;
    OUT[p-1-k]=(48+d) as u8;
    u=u/10; k=k+1;
  }
  if(neg==1){ OUT[cur]=45 as u8; }
  return cur+neg+nd;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=e1str(OUT,ig(W,16),s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=e1i64(OUT,ig(W,16),v as i64);
  put32(W,16,cur);
  return;
}

// ---------- facts (16-byte slots, 48 slots, base 64) ----------
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==0){
      put32(W,64+(i*16),1); put32(W,64+(i*16)+4,s);
      put32(W,64+(i*16)+8,r); put32(W,64+(i*16)+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn h2_facts(W:[]u8,dospec:i32)void {
  add_fact(W,501,86,1); add_fact(W,502,86,2);
  add_fact(W,501,87,1); add_fact(W,502,87,2);
  add_fact(W,501,85,3); add_fact(W,502,85,6);
  add_fact(W,501,84,9); add_fact(W,502,84,9);
  if(dospec==1){
    add_fact(W,93,89,1); add_fact(W,94,89,2);
  }
  let i:i32=0;
  while(i<30){
    add_fact(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn g(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==s && ig(W,64+(i*16)+8)==r){
      return ig(W,64+(i*16)+12);
    }
    i=i+1;
  }
  return -999999;
}

// ---------- modes ----------
// Mode slots: base 1024, 3 modes, 16 bytes each:
// (used, id, p1, p2). p1/p2 are relation parameters.
fn mode_new(W:[]u8,mid:i32,p1:i32,p2:i32)void {
  let b:i32=1024+(mid*16);
  put32(W,b,1); put32(W,b+4,mid);
  put32(W,b+8,p1); put32(W,b+12,p2);
  return;
}
fn mode_used(W:[]u8,mid:i32)i32 { return ig(W,1024+(mid*16)); }
fn mode_p1(W:[]u8,mid:i32)i32 { return ig(W,1024+(mid*16)+8); }
fn mode_p2(W:[]u8,mid:i32)i32 { return ig(W,1024+(mid*16)+12); }
fn mode_set_p2(W:[]u8,mid:i32,v:i32)void { put32(W,1024+(mid*16)+12,v); return; }

// Execute mode on input v. Returns value or -999999.
// Mode 0 (EQN): v=s, returns g(s,86) + 2*g(s,p2).
// Mode 1 (DOSPEC): v=q, returns g(q,89).
// Mode 2 (OBS): v=s, returns g(s,85).
fn exec_mode(W:[]u8,mid:i32,v:i32)i32 {
  if(mode_used(W,mid)==0){ return -999999; }
  if(mid==0){
    let a:i32=g(W,v,86);
    let c:i32=g(W,v,mode_p2(W,0));
    if(a==-999999 || c==-999999){ return -999999; }
    return a+2*c;
  }
  if(mid==1){
    return g(W,v,89);
  }
  if(mid==2){
    return g(W,v,85);
  }
  return -999999;
}
fn teach_modes(W:[]u8,OUT:[]u8)void {
  // EQN: p1=86 (A, fixed context), p2=87 (C, rebindable).
  mode_new(W,0,86,87);
  // DOSPEC: p1=89 (fixed, prior learning about intervention interface).
  mode_new(W,1,89,0);
  // OBS: p1=85 (fixed, control).
  mode_new(W,2,85,0);
  eS(W,OUT,"TEACH EQN p1=86 p2=87\n");
  eS(W,OUT,"TEACH DOSPEC p1=89\n");
  eS(W,OUT,"TEACH OBS p1=85\n");
  return;
}

// ---------- candidate scan ----------
fn scan_candidates(W:[]u8,s:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<48){
    if(ig(W,64+(i*16))==1 && ig(W,64+(i*16)+4)==s){
      let r:i32=ig(W,64+(i*16)+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+(k*4))==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+(n*4),r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}

// ---------- solver ----------
// Returns 1 if solved, 0 if not. Sets W[8]=1 on success.
fn try_single(W:[]u8,OUT:[]u8,mid:i32,v:i32,goal:i32)void {
  let r:i32=exec_mode(W,mid,v);
  eS(W,OUT,"TRY single m="); eN(W,OUT,mid);
  eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
  if(r==goal){
    eS(W,OUT,"Z-SINGLE m="); eN(W,OUT,mid); eS(W,OUT,"\n");
    put32(W,8,1);
  }
  return;
}
// Ordered pair: run m1 on v1, feed result as v2 to m2? For our domain,
// the pair (DOSPEC, EQN) is attempted via value passing: DOSPEC(q)=do_val,
// but EQN needs a relation, not a value, so the pair cannot solve surgery.
// We implement the pair as: r1=exec_mode(m1,v1); if r1 valid, try
// exec_mode(m2, v1) [EQN still uses its p2]. This fails for Z1/Z4, as expected.
fn try_pair(W:[]u8,OUT:[]u8,m1:i32,m2:i32,v1:i32,goal:i32)void {
  let r1:i32=exec_mode(W,m1,v1);
  eS(W,OUT,"TRY pair m1="); eN(W,OUT,m1);
  eS(W,OUT," m2="); eN(W,OUT,m2);
  eS(W,OUT," r1="); eN(W,OUT,r1); eS(W,OUT,"\n");
  if(r1!=-999999){
    // Value composition: feed r1 as the subject to m2? For DOSPEC->EQN,
    // this would be EQN(do_val), which is meaningless. We try it and it fails.
    let r2:i32=exec_mode(W,m2,r1);
    if(r2==goal){
      eS(W,OUT,"Z-PAIR m1="); eN(W,OUT,m1);
      eS(W,OUT," m2="); eN(W,OUT,m2); eS(W,OUT,"\n");
      put32(W,8,1);
    }
  }
  return;
}
fn solve_z(W:[]u8,OUT:[]u8,s:i32,qrel:i32,goal:i32,l2_on:i32)void {
  // SETUP: read do_val through DOSPEC mode (never a literal), assert (s,89,do_val).
  if(mode_used(W,1)==1){
    let dov:i32=exec_mode(W,1,qrel);
    if(dov!=-999999){
      add_fact(W,s,89,dov);
      eS(W,OUT,"SETUP do_val="); eN(W,OUT,dov); eS(W,OUT,"\n");
    } else {
      eS(W,OUT,"SETUP no-doval\n");
    }
  } else {
    eS(W,OUT,"SETUP no-DOSPEC\n");
  }
  // Phase 1 (L1): singles and ordered pair.
  eS(W,OUT,"PHASE1 L1:\n");
  try_single(W,OUT,0,s,goal);   // EQN
  if(ig(W,8)==1){ return; }
  try_single(W,OUT,2,s,goal);   // OBS (control)
  if(ig(W,8)==1){ return; }
  try_pair(W,OUT,1,0,qrel,goal); // (DOSPEC, EQN) value composition
  if(ig(W,8)==1){ return; }
  eS(W,OUT,"L1-FAIL\n");
  if(l2_on==0){ return; }
  // Phase 2 (L2): rebind EQN's p2 to each candidate relation.
  eS(W,OUT,"PHASE2 L2:\n");
  let n:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,n);
  let ci:i32=0;
  while(ci<n){
    eS(W,OUT," "); eN(W,OUT,ig(W,2048+(ci*4)));
    ci=ci+1;
  }
  eS(W,OUT,"\n");
  let orig_p2:i32=mode_p2(W,0);
  ci=0;
  while(ci<n){
    let cr:i32=ig(W,2048+(ci*4));
    mode_set_p2(W,0,cr);
    eS(W,OUT,"REBIND EQN p2="); eN(W,OUT,cr); eS(W,OUT,"\n");
    try_single(W,OUT,0,s,goal);
    if(ig(W,8)==1){
      eS(W,OUT,"L2-SOLVED p2="); eN(W,OUT,cr); eS(W,OUT,"\n");
      return;
    }
    ci=ci+1;
  }
  mode_set_p2(W,0,orig_p2);
  eS(W,OUT,"L2-FAIL\n");
  return;
}
// Surgery check: EQN's p2 must be 89 (the asserted do-value relation),
// and EQN(s) must equal goal. This verifies structural surgery, not luck.
fn check_surgery(W:[]u8,s:i32,goal:i32)i32 {
  if(mode_p2(W,0)!=89){ return 0; }
  let r:i32=exec_mode(W,0,s);
  if(r==goal){ return 1; }
  return 0;
}

// ---------- episodes and arms ----------
fn h2_init(W:[]u8)void {
  put32(W,8,0);   // success flag
  put32(W,16,0);  // out cursor (set by caller)
  return;
}
fn episode(W:[]u8,OUT:[]u8,s:i32,qrel:i32,goal:i32,surgery:i32,l2_on:i32,do_teach:i32,del_eqn:i32,del_dospec:i32,dospec:i32,expect:i32)i32 {
  let Wz:[]u8=z_alloc(8192);
  h2_init(Wz);
  put32(Wz,16,ig(W,16));
  h2_facts(Wz,dospec);
  if(do_teach==1){ teach_modes(Wz,OUT); }
  if(del_eqn==1){ put32(Wz,1024,0); }      // delete EQN mode
  if(del_dospec==1){ put32(Wz,1024+16,0); } // delete DOSPEC mode
  eS(Wz,OUT,"--- Z s="); eN(Wz,OUT,s);
  eS(Wz,OUT," qrel="); eN(Wz,OUT,qrel);
  eS(Wz,OUT," goal="); eN(Wz,OUT,goal); eS(Wz,OUT," ---\n");
  solve_z(Wz,OUT,s,qrel,goal,l2_on);
  put32(W,16,ig(Wz,16));
  let ok:i32=0;
  if(expect==1){
    if(surgery==1){
      if(check_surgery(Wz,s,goal)==1){ ok=1; }
    } else {
      if(ig(Wz,8)==1){ ok=1; }
    }
  } else {
    if(ig(Wz,8)==0){ ok=1; }
  }
  if(ok==1){ eS(W,OUT,"EP-RESULT PASS\n"); } else { eS(W,OUT,"EP-RESULT FAIL\n"); }
  return ok;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  let p:i32=1;
  if(episode(W,OUT,501,94,5,1,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,501,93,3,0,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,94,6,0,1,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,93,4,1,1,1,0,0,1,1)==0){ p=0; }
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  let p:i32=1;
  if(episode(W,OUT,501,94,5,0,0,1,0,0,1,0)==0){ p=0; }
  if(episode(W,OUT,501,93,3,0,0,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,94,6,0,0,1,0,0,1,1)==0){ p=0; }
  if(episode(W,OUT,502,93,4,0,0,1,0,0,1,0)==0){ p=0; }
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_ableqn(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-EQN ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,1,0,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_abldospec(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-DOSPEC ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,0,1,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,0,0,0,1,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn arm_nodospec(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== NO-DOSPEC ===\n");
  let p:i32=episode(W,OUT,501,94,5,0,1,1,0,0,0,0);
  if(p==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,p);
  return;
}
fn main()void {
  let OUT:[]u8=z_alloc(65536);
  let W:[]u8=z_alloc(8192);
  put32(W,16,0);
  eS(W,OUT,"H2-CAUSAL-START\n");
  arm_treat(W,OUT);
  arm_l1only(W,OUT);
  arm_ableqn(W,OUT);
  arm_abldospec(W,OUT);
  arm_fresh(W,OUT);
  arm_nodospec(W,OUT);
  eS(W,OUT,"H2-CAUSAL-END\n");
  let cur:i32=ig(W,16);
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  return;
}

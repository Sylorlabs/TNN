// cd_driver_xio.zag -- XDOMAIN-CAUSAL driver for MECH-XIO (typed pairing,
// per-class stage dispatch, xio_core2.zag ported verbatim).
//
// Same causal -> intervention world as cd_driver_a. XIO queries go
// through xio_query; the ev_query wrapper satisfies cx_core's internal
// references. AUDIT reports xio_has_typed, the sclass gate decision
// per ordered pair, and direct xio_stage_exec probes.
// Arms: TREAT, ABL-XIO, ABL-X, ABL-Y, FRESH, ORACLE, AUDIT.
// Pure Zag. No Python. Safebin PATH.

fn cd_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cd_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cd_census_xio(W:[]u8)void {
  emit("maps="); e64(cd_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("MAP id="); e64(m);
      emit(" r="); e64(ng(W,m,4));
      emit(" s="); e64(ng(W,m,8));
      emit(" ans="); e64(ng(W,m,28));
      emit(" oty="); e64(xio_oty(W,m));
      emit(" sclass="); e64(xio_sclass(W,m));
      emit("\n");
    }
    m=m+1;
  }
  emit("has_typed="); e64(xio_has_typed(W)); emit("\n");
  emit("adapters="); e64(xio_count(W)); emit("\n");
  return;
}
fn cd_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn cd_world(W:[]u8)void {
  ev_teach(W,501,86,1); ev_teach(W,502,86,2);
  ev_teach(W,801,71,802); ev_teach(W,801,71,803); ev_teach(W,802,71,803);
  return;
}
fn cd_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,501,81,511); ev_teach(W,511,81,515); ev_teach(W,515,81,3);
  ev_teach(W,502,81,512); ev_teach(W,512,81,516); ev_teach(W,516,81,6);
  let x1:i32=xio_query(W,501,91,3,0,xon);
  emit("X1 ans="); e64(x1); cd_tstat(W);
  let x2:i32=xio_query(W,502,91,6,0,xon);
  emit("X2 ans="); e64(x2); cd_tstat(W);
  return;
}
fn cd_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,501,88,521); ev_teach(W,521,88,1);
  ev_teach(W,502,88,522); ev_teach(W,522,88,2);
  let y1:i32=xio_query(W,501,92,1,0,xon);
  emit("Y1 ans="); e64(y1); cd_tstat(W);
  let y2:i32=xio_query(W,502,92,2,0,xon);
  emit("Y2 ans="); e64(y2); cd_tstat(W);
  return;
}
fn cd_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); cd_tstat(W);
  emit("adapters="); e64(xio_count(W)); emit("\n");
  return;
}
fn cd_zall(W:[]u8,xon:i32)void {
  cd_zq(W,"Z1",501,94,5,xon);
  cd_zq(W,"Z2",501,93,3,xon);
  cd_zq(W,"Z3",502,94,6,xon);
  cd_zq(W,"Z4",502,93,4,xon);
  return;
}
fn cd_aval(W:[]u8,u:i32)i32 {
  let x:i32=2;
  while(x<1024){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==u && ng(W,x,24)==86){
      return ng(W,x,28);
    }
    x=x+1;
  }
  return -999999;
}
fn cd_oracle(W:[]u8)void {
  emit("ORACLE Z1="); e64(cd_aval(W,501)+2*2);
  emit(" Z2="); e64(cd_aval(W,501)+2*1);
  emit(" Z3="); e64(cd_aval(W,502)+2*2);
  emit(" Z4="); e64(cd_aval(W,502)+2*1);
  emit("\n");
  return;
}
// Gate + stage audit using the core's own functions (read-only).
fn cd_gate_audit(W:[]u8)void {
  let tried:i32=0; let rej:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let c1:i32=xio_sclass(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let c2:i32=xio_sclass(W,m2);
          if(c1!=c2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,501);
            let v2:i32=-999999;
            if(v1!=-999999 && v1!=-2){ v2=xio_stage_exec(W,m2,v1); }
            emit("PAIR m1="); e64(m1); emit(" c1="); e64(c1);
            emit(" m2="); e64(m2); emit(" c2="); e64(c2);
            emit(" v1="); e64(v1); emit(" v2="); e64(v2); emit("\n");
          } else { rej=rej+1; }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("GATE tried="); e64(tried);
  emit(" gate_rejected="); e64(rej); emit("\n");
  return;
}
fn cd_stage_probes(W:[]u8)void {
  let x:i32=2;
  while(x<1024){
    if(ng(W,x,36)==1 && ng(W,x,0)==20 && ng(W,x,4)==91 && ng(W,x,8)==501){break;}
    x=x+1;
  }
  let y:i32=2;
  while(y<1024){
    if(ng(W,y,36)==1 && ng(W,y,0)==20 && ng(W,y,4)==92 && ng(W,y,8)==501){break;}
    y=y+1;
  }
  emit("PROBE X="); e64(x); emit(" Y="); e64(y); emit("\n");
  if(x<1024){
    emit("stage(X,501)="); e64(xio_stage_exec(W,x,501)); emit("\n");
    emit("stage(X,515)="); e64(xio_stage_exec(W,x,515)); emit("\n");
  }
  if(y<1024){
    emit("stage(Y,501)="); e64(xio_stage_exec(W,y,501)); emit("\n");
    emit("stage(Y,3)="); e64(xio_stage_exec(W,y,3)); emit("\n");
  }
  return;
}
fn cd_arm_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  cd_world(W);
  cd_trainX(W,1);
  cd_trainY(W,1);
  cd_gap(W);
  cd_census_xio(W);
  cd_zall(W,1);
  return;
}
fn cd_arm_ablxio(W:[]u8)void {
  emit("=== ABL-XIO ===\n");
  cd_world(W);
  cd_trainX(W,0);
  cd_trainY(W,0);
  cd_gap(W);
  cd_census_xio(W);
  cd_zall(W,0);
  return;
}
fn cd_arm_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  cd_world(W);
  cd_trainY(W,1);
  cd_gap(W);
  cd_zall(W,1);
  return;
}
fn cd_arm_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  cd_world(W);
  cd_trainX(W,1);
  cd_gap(W);
  cd_zall(W,1);
  return;
}
fn cd_arm_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  cd_world(W);
  cd_gap(W);
  cd_zall(W,1);
  return;
}
fn cd_arm_oracle(W:[]u8)void {
  emit("=== ORACLE ===\n");
  cd_world(W);
  ev_teach(W,501,81,511); ev_teach(W,511,81,515); ev_teach(W,515,81,3);
  ev_teach(W,502,81,512); ev_teach(W,512,81,516); ev_teach(W,516,81,6);
  ev_teach(W,501,88,521); ev_teach(W,521,88,1);
  ev_teach(W,502,88,522); ev_teach(W,522,88,2);
  cd_gap(W);
  cd_oracle(W);
  return;
}
fn cd_arm_audit(W:[]u8)void {
  emit("=== AUDIT ===\n");
  cd_world(W);
  cd_trainX(W,1);
  cd_trainY(W,1);
  cd_gap(W);
  cd_census_xio(W);
  cd_gate_audit(W);
  cd_stage_probes(W);
  cd_oracle(W);
  return;
}
// cx_core's internal test battery references ev_query; the entry point
// used here is xio_query. Provided as the adapter pipeline.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("CD-XIO-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); cd_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); cd_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); cd_arm_ablx(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); cd_arm_ably(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); cd_arm_fresh(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); cd_arm_oracle(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); cd_arm_audit(W7);
  emit("CD-XIO-END\n");
  return 0;
}

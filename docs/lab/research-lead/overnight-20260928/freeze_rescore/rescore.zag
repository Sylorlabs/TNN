// rescore.zag - Pure-Zag reimplementation of the Core Freeze Challenge scorer.
//
// Replaces score_probes.sh (shell/awk) and the W7 grader simulation, which
// the tooling audit (70c520637) flagged NEEDS-RERUN. Reads the frozen
// battery artifacts read-only and re-derives every world score.
//
// Modes:
//   rescore_bin score <world.txt> <out.txt> <seg-spec> [filter_s filter_r]
//     seg-spec: comma-separated probe counts per segment, e.g. "12,10".
//     Optional filter: score only probes whose expected (s,r) matches.
//     Prints per-probe OK/MISS/ORDER-MISMATCH lines, then SEGSCORE lines,
//     then SCORE <ok> <n>.
//   rescore_bin grade7 <world.txt> <out.txt> <goal>
//     W7 planning grader per DESIGN_WORLDS_PREFREEZE.md (frozen with the
//     world): the transition model is read from the world's own OBSERVE
//     lines (relation 621 = act0, 622 = act1); instance structure is read
//     from the marker OBSERVEs (9997/623 = start announce, 9998/623 =
//     perturb) and ACT lines; CHOICE values come from the binary output.
//     An instance scores if <goal> is visited during its ACTs.
//     Prints INST lines, then SCORE <ok> <ninst>.
//
// Pure Zag. No Python, no shell scoring logic. Exit 0 on success,
// 2 on usage/data errors.
//
// Owned path: docs/lab/research-lead/overnight-20260928/freeze_rescore/

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// byte-wise equality of two []u8
fn beq(a:[]u8, b:[]u8)i32 {
  if(_zag_strlen(a)!=_zag_strlen(b)){ return 0; }
  let n:i32=_zag_strlen(a);
  let i:i32=0;
  while(i<n){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
fn line_end(d:[]u8, s:i32, n:i32)i32 {
  let i:i32=s;
  while(i<n){ if(d[i]==10){ return i; } i=i+1; }
  return n;
}
fn skip_ws(d:[]u8, s:i32, e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8, s:i32, e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9){ return s; } s=s+1; }
  return e;
}
// 1 if d[s..e) is an optional minus followed by 1+ ASCII digits.
fn is_int(d:[]u8, s:i32, e:i32)i32 {
  if(s>=e){ return 0; }
  if(d[s]==45){ s=s+1; }
  if(s>=e){ return 0; }
  while(s<e){
    let c:i32=d[s] as i32;
    if(c<48 || c>57){ return 0; }
    s=s+1;
  }
  return 1;
}
fn parse_i32(d:[]u8, s:i32, e:i32)i32 {
  let neg:i32=0;
  if(d[s]==45){ neg=1; s=s+1; }
  let v:i32=0;
  while(s<e){
    v=v*10 + (d[s] as i32) - 48;
    s=s+1;
  }
  if(neg==1){ return 0-v; }
  return v;
}
// match literal word at d[s..]; caller guarantees bounds via field length.
fn word_is(d:[]u8, s:i32, w:[]u8)i32 {
  let n:i32=_zag_strlen(w);
  let i:i32=0;
  while(i<n){ if(d[s+i]!=w[i]){ return 0; } i=i+1; }
  return 1;
}
// Parse "s r v" triple after the keyword field [f0e..le). Returns 1 ok.
// Writes to buf at triple index t.
fn parse_triple(d:[]u8, f0e:i32, le:i32, buf:[]u8, t:i32)i32 {
  let s1:i32=skip_ws(d,f0e,le);
  let e1:i32=field_end(d,s1,le);
  let s2:i32=skip_ws(d,e1,le);
  let e2:i32=field_end(d,s2,le);
  let s3:i32=skip_ws(d,e2,le);
  let e3:i32=field_end(d,s3,le);
  if(s1>=le || s2>=le || s3>=le){ return 0; }
  if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return 0; }
  if(skip_ws(d,e3,le)<le){ return 0; }
  set32(buf, t*12, parse_i32(d,s1,e1));
  set32(buf, t*12+4, parse_i32(d,s2,e2));
  set32(buf, t*12+8, parse_i32(d,s3,e3));
  return 1;
}
// Collect triples for lines whose first field equals kw ("QUERY"/"ANSWER").
// Returns count, or -1 on parse error.
fn collect(d:[]u8, kw:[]u8, buf:[]u8, cap:i32)i32 {
  let n:i32=_zag_strlen(d);
  let s:i32=0;
  let t:i32=0;
  while(s<n){
    let le:i32=line_end(d,s,n);
    let f0s:i32=skip_ws(d,s,le);
    if(f0s<le){
      let f0e:i32=field_end(d,f0s,le);
      if(f0e-f0s==_zag_strlen(kw) && word_is(d,f0s,kw)==1){
        if(t>=cap){ return -1; }
        if(parse_triple(d,f0e,le,buf,t)==0){ return -1; }
        t=t+1;
      }
    }
    s=le+1;
  }
  return t;
}
// Parse comma-separated ints from spec into buf (i32 slots). Returns count or -1.
fn parse_spec(spec:[]u8, buf:[]u8, cap:i32)i32 {
  let n:i32=_zag_strlen(spec);
  let s:i32=0;
  let t:i32=0;
  while(s<n){
    let e:i32=s;
    while(e<n){ if(spec[e]==44){ break; } e=e+1; }
    if(is_int(spec,s,e)==0){ return -1; }
    if(t>=cap){ return -1; }
    set32(buf, t*4, parse_i32(spec,s,e));
    t=t+1;
    s=e+1;
  }
  return t;
}
fn do_score()i32 {
  let ac:i32=_zag_argc();
  if(ac!=5 && ac!=7){
    errln("usage: rescore_bin score <world.txt> <out.txt> <seg-spec> [filter_s filter_r]");
    return 2;
  }
  let wpath:[]u8=_zag_arg(2);
  let opath:[]u8=_zag_arg(3);
  let spec:[]u8=_zag_arg(4);
  if(_zag_file_exists(wpath)==0){ errln("world file missing"); return 2; }
  if(_zag_file_exists(opath)==0){ errln("output file missing"); return 2; }
  let use_filter:i32=0;
  let fs:i32=0;
  let fr:i32=0;
  if(ac==7){
    let fsa:[]u8=_zag_arg(5);
    let fra:[]u8=_zag_arg(6);
    if(is_int(fsa,0,_zag_strlen(fsa))==0 || is_int(fra,0,_zag_strlen(fra))==0){
      errln("filter args must be integers"); return 2;
    }
    use_filter=1;
    fs=parse_i32(fsa,0,_zag_strlen(fsa));
    fr=parse_i32(fra,0,_zag_strlen(fra));
  }
  let wd:[]u8=_zag_read_file(wpath);
  let od:[]u8=_zag_read_file(opath);
  let E:[]u8=z_alloc(64*12);
  let G:[]u8=z_alloc(64*12);
  let ne:i32=collect(wd, "QUERY", E, 64);
  let ng:i32=collect(od, "ANSWER", G, 64);
  if(ne<0){ errln("world QUERY parse error"); return 2; }
  if(ng<0){ errln("output ANSWER parse error"); return 2; }
  if(ne!=ng){
    errln("QUERY/ANSWER count mismatch");
    emit("QUERY "); emit(i32s(ne)); emit(" ANSWER "); emit(i32s(ng)); emit("\n");
    return 2;
  }
  // Apply filter into compacted arrays F (expected) and H (actual).
  let F:[]u8=z_alloc(64*12);
  let H:[]u8=z_alloc(64*12);
  let np:i32=0;
  let i:i32=0;
  while(i<ne){
    let es:i32=get32(E,i*12);
    let er:i32=get32(E,i*12+4);
    if(use_filter==0 || (es==fs && er==fr)){
      set32(F,np*12,es); set32(F,np*12+4,er); set32(F,np*12+8,get32(E,i*12+8));
      set32(H,np*12,get32(G,i*12)); set32(H,np*12+4,get32(G,i*12+4)); set32(H,np*12+8,get32(G,i*12+8));
      np=np+1;
    }
    i=i+1;
  }
  let segbuf:[]u8=z_alloc(16*4);
  let nseg:i32=parse_spec(spec, segbuf, 16);
  if(nseg<1){ errln("bad seg-spec"); return 2; }
  let sum:i32=0;
  i=0;
  while(i<nseg){ sum=sum+get32(segbuf,i*4); i=i+1; }
  if(sum!=np){ errln("seg-spec sum != probe count"); return 2; }
  // Score walk.
  let tok:i32=0;
  let tn:i32=0;
  let si:i32=0;
  let segok:i32=0;
  let segn:i32=get32(segbuf,0);
  let segscored:i32=0;
  i=0;
  while(i<np){
    let es:i32=get32(F,i*12);
    let er:i32=get32(F,i*12+4);
    let ee:i32=get32(F,i*12+8);
    let gs:i32=get32(H,i*12);
    let gr:i32=get32(H,i*12+4);
    let gv:i32=get32(H,i*12+8);
    if(es!=gs || er!=gr){
      emit("ORDER-MISMATCH exp=("); emit(i32s(es)); emit(" "); emit(i32s(er));
      emit(") got=("); emit(i32s(gs)); emit(" "); emit(i32s(gr)); emit(")\n");
    } else {
      if(ee==gv){
        emit("OK "); emit(i32s(es)); emit(" "); emit(i32s(er));
        emit(" expected="); emit(i32s(ee)); emit(" got="); emit(i32s(gv)); emit("\n");
        tok=tok+1; segok=segok+1;
      } else {
        emit("MISS "); emit(i32s(es)); emit(" "); emit(i32s(er));
        emit(" expected="); emit(i32s(ee)); emit(" got="); emit(i32s(gv)); emit("\n");
      }
    }
    tn=tn+1;
    if(tn>=segn){
      emit("SEGSCORE "); emit(i32s(si)); emit(" "); emit(i32s(segok)); emit(" "); emit(i32s(segn)); emit("\n");
      si=si+1; segscored=segscored+1;
      segok=0; tn=0;
      if(si<nseg){ segn=get32(segbuf,si*4); }
    }
    i=i+1;
  }
  emit("SCORE "); emit(i32s(tok)); emit(" "); emit(i32s(np)); emit("\n");
  return 0;
}
// W7 grader. Transition model and instance structure come from the world file.
fn do_grade7()i32 {
  if(_zag_argc()!=5){
    errln("usage: rescore_bin grade7 <world.txt> <out.txt> <goal>");
    return 2;
  }
  let wpath:[]u8=_zag_arg(2);
  let opath:[]u8=_zag_arg(3);
  let ga:[]u8=_zag_arg(4);
  if(is_int(ga,0,_zag_strlen(ga))==0){ errln("goal must be integer"); return 2; }
  let goal:i32=parse_i32(ga,0,_zag_strlen(ga));
  if(_zag_file_exists(wpath)==0){ errln("world file missing"); return 2; }
  if(_zag_file_exists(opath)==0){ errln("output file missing"); return 2; }
  let wd:[]u8=_zag_read_file(wpath);
  let od:[]u8=_zag_read_file(opath);
  // Model tables: up to 16 (state,next) pairs each for act0 (rel 621) and act1 (rel 622).
  let T0:[]u8=z_alloc(16*8);
  let T1:[]u8=z_alloc(16*8);
  let n0:i32=0;
  let n1:i32=0;
  // Events: (kind,val); kind 0=START,1=PERTURB,2=ACT. Up to 64.
  let EV:[]u8=z_alloc(64*8);
  let nev:i32=0;
  let n:i32=_zag_strlen(wd);
  let s:i32=0;
  while(s<n){
    let le:i32=line_end(wd,s,n);
    let f0s:i32=skip_ws(wd,s,le);
    if(f0s<le){
      let f0e:i32=field_end(wd,f0s,le);
      let wl:i32=f0e-f0s;
      if(wl==7 && word_is(wd,f0s,"OBSERVE")==1){
        let buf:[]u8=z_alloc(12);
        if(parse_triple(wd,f0e,le,buf,0)==0){ errln("world OBSERVE parse error"); return 2; }
        let a:i32=get32(buf,0);
        let b:i32=get32(buf,4);
        let c:i32=get32(buf,8);
        if(b==621){
          if(n0>=16){ errln("model overflow"); return 2; }
          set32(T0,n0*8,a); set32(T0,n0*8+4,c); n0=n0+1;
        } else {
          if(b==622){
            if(n1>=16){ errln("model overflow"); return 2; }
            set32(T1,n1*8,a); set32(T1,n1*8+4,c); n1=n1+1;
          } else {
            if(a==9997 && b==623){
              if(nev>=64){ errln("event overflow"); return 2; }
              set32(EV,nev*8,0); set32(EV,nev*8+4,c); nev=nev+1;
            } else {
              if(a==9998 && b==623){
                if(nev>=64){ errln("event overflow"); return 2; }
                set32(EV,nev*8,1); set32(EV,nev*8+4,c); nev=nev+1;
              }
            }
          }
        }
      } else {
        if(wl==3 && word_is(wd,f0s,"ACT")==1){
          if(nev>=64){ errln("event overflow"); return 2; }
          set32(EV,nev*8,2); set32(EV,nev*8+4,0); nev=nev+1;
        }
      }
    }
    s=le+1;
  }
  // CHOICE values from output.
  let CH:[]u8=z_alloc(64*4);
  let nch:i32=0;
  let on:i32=_zag_strlen(od);
  s=0;
  while(s<on){
    let le:i32=line_end(od,s,on);
    let f0s:i32=skip_ws(od,s,le);
    if(f0s<le){
      let f0e:i32=field_end(od,f0s,le);
      if(f0e-f0s==6 && word_is(od,f0s,"CHOICE")==1){
        let a1:i32=skip_ws(od,f0e,le);
        let b1:i32=field_end(od,a1,le);
        if(a1>=le || is_int(od,a1,b1)==0 || skip_ws(od,b1,le)<le){
          errln("CHOICE parse error"); return 2;
        }
        if(nch>=64){ errln("choice overflow"); return 2; }
        set32(CH,nch*4,parse_i32(od,a1,b1)); nch=nch+1;
      }
    }
    s=le+1;
  }
  // Simulate.
  let ci:i32=0;
  let ninst:i32=0;
  let ok:i32=0;
  let state:i32=0;
  let reached:i32=0;
  let inst:i32=0;
  let istart:i32=0;
  let started:i32=0;
  let i:i32=0;
  while(i<nev){
    let kind:i32=get32(EV,i*8);
    let val:i32=get32(EV,i*8+4);
    if(kind==0){
      if(started==1){
        emit("INST "); emit(i32s(inst)); emit(" start="); emit(i32s(istart));
        emit(" reached="); emit(i32s(reached)); emit("\n");
        ninst=ninst+1;
        if(reached==1){ ok=ok+1; }
        inst=inst+1;
      }
      state=val; istart=val; started=1;
      if(state==goal){ reached=1; } else { reached=0; }
    } else {
      if(kind==1){
        state=val;
        if(state==goal){ reached=1; }
      } else {
        if(ci>=nch){ errln("fewer CHOICEs than ACTs"); return 2; }
        let c:i32=get32(CH,ci*4); ci=ci+1;
        let nxt:i32=-1;
        if(c==0){
          let k:i32=0;
          while(k<n0){ if(get32(T0,k*8)==state){ nxt=get32(T0,k*8+4); } k=k+1; }
        } else {
          if(c==1){
            let k:i32=0;
            while(k<n1){ if(get32(T1,k*8)==state){ nxt=get32(T1,k*8+4); } k=k+1; }
          } else { errln("choice not 0/1"); return 2; }
        }
        if(nxt==-1){ errln("transition missing"); return 2; }
        state=nxt;
        if(state==goal){ reached=1; }
      }
    }
    i=i+1;
  }
  if(started==1){
    emit("INST "); emit(i32s(inst)); emit(" start="); emit(i32s(istart));
    emit(" reached="); emit(i32s(reached)); emit("\n");
    ninst=ninst+1;
    if(reached==1){ ok=ok+1; }
  }
  emit("SCORE "); emit(i32s(ok)); emit(" "); emit(i32s(ninst)); emit("\n");
  return 0;
}
fn main()i32 {
  if(_zag_argc()<2){
    errln("usage: rescore_bin <score|grade7> ...");
    return 2;
  }
  let m:[]u8=_zag_arg(1);
  if(beq(m,"score")==1){ return do_score(); }
  if(beq(m,"grade7")==1){ return do_grade7(); }
  errln("unknown mode (want score or grade7)");
  return 2;
}

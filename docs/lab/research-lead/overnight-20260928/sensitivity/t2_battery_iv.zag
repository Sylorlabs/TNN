// ============ test battery ============
fn tpass(n:[]u8)void { emit(n); emit(" PASS\n"); return; }
fn tfail(n:[]u8)void { emit(n); emit(" FAIL\n"); return; }
// ---- P-INT1: CLA-2 15 tests (compact) ----
fn t_c1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0; let ok:i32=1;
  while(i<40){if(ev_teach(W,1000+i,1,i*7+3)<0){ok=0;} i=i+1;}
  i=0; while(i<40){if(ev_query(W,1000+i,1,-2,0)!=i*7+3){ok=0;} i=i+1;}
  return ok;
}
fn t_c2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0; let c75:i32=0; let last:i32=-1;
  while(i<100){
    let n:i32=ev_teach(W,2000+i,2,i);
    if(n>=0 && last>=0 && ng(W,last,36)==0){c75=c75+1;}
    last=n; i=i+1;
  }
  let sv:i32=0; i=88;
  while(i<100){if(ev_query(W,2000+i,2,-2,0)==i){sv=sv+1;} i=i+1;}
  if(c75==0 && sv==12){return 1;} return 0;
}
fn t_c3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,3001,3,10); let r:i32=ev_observe(W,3001,3,20);
  let ce:i32=0; let e:i32=0;
  while(e<4096){if(eg(W,e,0)!=-1 && eg(W,e,4)==3){ce=ce+1;} e=e+1;}
  let cur:i32=ev_query(W,3001,3,-2,0);
  if(r==0 && ce>0 && cur==20){return 1;} return 0;
}
fn t_c4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2); write_node(W,g,0,0,0,0);
  let n:i32=ev_teach(W,4001,4,50); link_edge(W,g,10,n,0); link_edge(W,n,1,g,0);
  link_edge(W,g,6,g,0);
  if(bid(W,n)>0){return 1;} return 0;
}
fn t_c5()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W,5001,5,60); ev_teach(W2,5001,5,60);
  let a:[]u8=z_alloc(110656); let b:[]u8=z_alloc(110656);
  let i:i32=0; while(i<110656){a[i]=W[i]; b[i]=W2[i]; i=i+1;}
  let eq:i32=1; i=0;
  while(i<110656){if(a[i]!=b[i]){eq=0;} i=i+1;}
  return eq;
}
fn t_c6()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let root:i32=alloc_node(W); ns(W,root,0,101);
  // DELTA C515a (the ONLY delta in this test).  The frozen battery wrote the
  // frame-slot destination as the bare literal 1000, i.e. "slot = op - 1000".
  // That untagged convention IS defect C505/B1: a node id and a slot index were
  // the same integer, distinguished only by magnitude, so every literal node
  // with id >= 1000 was silently reinterpreted as a frame slot.  The invariant
  // layer replaces it with a DISJOINT TAGGED BAND (slot operands live at
  // 1048576+slot, node operands are node ids), so the destination is written as
  // opnd_slot(0).  The expected value 42 is UNCHANGED -- only the encoding of a
  // now-illegal operand changed.
  ns(W,root,4,opnd_slot(0)); ns(W,root,8,7);
  let lit:i32=alloc_node(W); ns(W,lit,0,1); write_node(W,lit,42,0,0,0);
  ns(W,root,8,lit);
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  let v:i32=exec_val(W,root,fr);
  if(v==42){return 1;} return 0;
}
fn t_c7()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let root:i32=alloc_node(W); ns(W,root,0,999);
  let fr:i32=alloc_node(W); ns(W,fr,0,902);
  if(exec_val(W,root,fr)==-999999){return 1;} return 0;
}
fn t_c8()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n:i32=ev_teach(W,6001,6,70);
  link_edge(W,n,2,n,0); link_edge(W,n,2,n,0); link_edge(W,n,3,n,0);
  if(bid(W,n)==1){return 1;} return 0;
}
fn t_c9()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  pol_set(W,-1);
  if(ev_act(W)==0){return 1;} return 0;
}
fn t_c10()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let g:i32=alloc_node(W); ns(W,g,0,2);
  let gd:i32=alloc_node(W); ns(W,gd,0,1);
  ns(W,gd,4,7001); write_node(W,gd,11,0,0,0);
  link_edge(W,g,10,gd,0); link_edge(W,gd,2,gd,0);
  pol_set(W,g); ctx_push(W,7001);
  if(ev_act(W)==11){return 1;} return 0;
}
// DELTA C515b -- THE FROZEN EXPECTATION FOR THIS TEST IS THE DEFECT (C504).
// The frozen battery asserts v==80: teach (8001,7,80) (8002,7,80) (8003,7,80)
// and then query subject 8004, which was NEVER TAUGHT, and REQUIRE the answer
// 80.  That is precisely the confirmed C504 counterexample with different
// literals: a subject-blind inversion returns a value for a subject that
// shares no evidence with the six teaching subjects, and then PERSISTS it as a
// fact node.  aw04 reproduces it at (999,10,7); this test is the same defect at
// (8004,7,80).  There is no fact about 8004 in the world, so 80 is not a
// defensible answer under any reading.
//
// The corrected assertion is the INVARIANT, and it is STRICTER than the frozen
// one in the dimension that matters: it requires the refusal AND requires that
// nothing was written down.  A refusal that also launders its guess would fail.
fn t_c11()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,8001,7,80); ev_teach(W,8002,7,80); ev_teach(W,8003,7,80);
  let v:i32=ev_query(W,8004,7,-2,0);
  if(v!=-2){return 0;}
  // and no fact node about 8004 may exist -- not after one query, not after two
  let n:i32=2; let f:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==8004){f=f+1;}
    n=n+1;
  }
  if(f!=0){return 0;}
  let v2:i32=ev_query(W,8004,7,-2,0);
  if(v2!=-2){return 0;}
  n=2; f=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==8004){f=f+1;}
    n=n+1;
  }
  if(f!=0){return 0;}
  return 1;
}
fn t_c12()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  pol_set(W,42); mp_set(W,43);
  if(pol_get(W)==42 && mp_get(W)==43){return 1;} return 0;
}

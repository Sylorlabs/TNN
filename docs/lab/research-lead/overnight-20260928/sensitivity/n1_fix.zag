// tnn2.zag -- TNN-2 next-generation integration.
// Prereg 7c1e30522 frozen before this file (K-T2-1). Pure Zag. No Python.
// Root-cause basis: ed38121d4 (three shared architectural gaps).
// Change 1: one executable graph type, constructed at runtime. The MUL Rung B
//   trial loop (propose/execute/verify/promote) is the general miss policy.
//   The three fixed plan templates and the separate exec_plan executor are
//   removed. All executable structure flows through the single frozen 4-op
//   ISA (MOVE/BRANCHEQ/INC/DEC) via EXECUTE. Exactly one executor.
// Change 2: the miss-to-act loop is closed in learner state. On a miss,
//   miss_inquire reifies an UNCERTAINTY node (inquiry build 18ed3331c,
//   Piece A) and constructs a guide (Piece B) linked to POLICY_ROOT using
//   existing node/edge types. ev_act selects over learner-constructed guides.
// Change 3: generic revision operator over 4-op executable graphs.
//   On a counterexample (ev_observe contradiction of a licensing fact), the
//   stale step is removed and a corrected step inserted; the restructured
//   graph is re-executed for verification. Distinct from standing demotion.
// ISA frozen: no new opcodes, modes, bridges, handlers, semantic cases.
// One workspace, one bid, one miss path, one event log, one executor.

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ============ layout: 1024 nodes, 4096 edges, 128 log ============
fn WSZ()i32 { return 110656; }
fn NN()i32 { return 1024; }
fn NE()i32 { return 4096; }
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }
fn loff(l:i32)i32 { return 106560+l*32; }
fn lg(W:[]u8,l:i32,f:i32)i32 { return get32(W,loff(l)+f); }
fn ls(W:[]u8,l:i32,f:i32,v:i32)void { set32(W,loff(l)+f,v); return; }
// ============ T2 INVARIANT RECORD (C510-C512) ============
// ROOT INVARIANT, stated once and mechanically enforced by iv_check:
//
//   A record may be WRITTEN only after its capacity has been checked, and may
//   be READ BACK only through a decoder with exactly one legal reading of the
//   value.  Its identity is its full content.  A derived record may never be
//   admitted into the observed-fact namespace.  Anything that cannot be
//   justified by a WHOLE evidence set must REFUSE with a distinct code and
//   bump its own counter -- never return a value and never stay silent.
//
// The workspace header is FULL: cells 0,4,8,12,20,24,28 and 32..48 are used
// and 52.. is node territory.  A log entry is 32 bytes = 8 i32 cells, and the
// record needs 16, so the record occupies TWO RESERVED LOG ENTRIES.  LOGCAP is
// reduced 128 -> 126 and entries 126,127 are reserved, which makes the
// reservation explicit rather than an overlap waiting to happen.  (Writing 16
// cells into one 8-cell entry is itself a capacity defect; the invariant layer
// does not get an exemption.)
fn LOGCAP()i32  { return 126; }
fn IVLOGCELL_A()i32 { return 126; }
fn IVLOGCELL_B()i32 { return 127; }
fn T2MAGIC()i32 { return 0x54323236; }
fn T2SCHEMA()i32{ return 1; }
// record cells, in CELL INDEX units (ivL/ivS do the byte scaling)
fn R_MAGIC()i32 { return 0; }
fn R_SCHEMA()i32 { return 1; }
fn R_NODECAP()i32 { return 2; }
fn R_EDGECAP()i32 { return 3; }
fn R_LOGCAP()i32 { return 4; }
fn R_NSLOTS()i32 { return 5; }
fn R_SLOTBASE()i32 { return 6; }
fn R_ADMITMODE()i32 { return 7; }
fn R_CAPREFUSE()i32 { return 8; }
fn R_MALFORMED()i32 { return 9; }
fn R_LOGDROPS()i32 { return 10; }
fn R_ANSET()i32 { return 11; }
fn R_SUPERSEDED()i32 { return 12; }
fn R_DOWNGRADE()i32 { return 13; }
fn R_IVVIOL()i32 { return 14; }
fn R_SETOVF()i32 { return 15; }
fn ivL(W:[]u8,f:i32)i32 {
  if(f<8){ return lg(W,IVLOGCELL_A(),f*4); }
  return lg(W,IVLOGCELL_B(),(f-8)*4);
}
fn ivS(W:[]u8,f:i32,v:i32)void {
  if(f<8){ ls(W,IVLOGCELL_A(),f*4,v); return; }
  ls(W,IVLOGCELL_B(),(f-8)*4,v); return;
}
fn iv_ok(W:[]u8)i32 {
  if(ivL(W,R_MAGIC())!=T2MAGIC()){ return 0; }
  if(ivL(W,R_SCHEMA())!=T2SCHEMA()){ return 0; }
  return 1;
}
// M2: the capacity record is READ, never a literal at the point of use.
fn nodecap(W:[]u8)i32 {
  if(iv_ok(W)==0){ return NN(); }
  return ivL(W,R_NODECAP());
}
fn edgecap(W:[]u8)i32 {
  if(iv_ok(W)==0){ return NE(); }
  return ivL(W,R_EDGECAP());
}
fn logcap(W:[]u8)i32 {
  if(iv_ok(W)==0){ return 127; }
  return ivL(W,R_LOGCAP());
}
fn slotbase(W:[]u8)i32 {
  if(iv_ok(W)==0){ return 1048576; }
  return ivL(W,R_SLOTBASE());
}
fn nslots(W:[]u8)i32 {
  if(iv_ok(W)==0){ return 4; }
  return ivL(W,R_NSLOTS());
}
// ---- ONE CAPACITY RECORD, ONE DOMAIN (C514) ----
//
// The node arena has NN() slots but ids 0 and 1 are permanently live roots, so
// the ALLOCATABLE domain is ids 2..NN()-1.  The occupancy counter hg(W,20)
// counts EVERY live node, roots included.  An earlier draft compared those two
// numbers directly -- `hg(W,20) > nc-2` -- which compares an all-live count
// against an allocatable-only capacity.  That off-by-the-reserved-roots
// mismatch made the validator report a violation on a world that was NOT
// over capacity, and because the M6 gate turns a violation into a refusal, it
// turned 5 of 6 correct answers into 0 of 6.  The defect was not visible as an
// error; it was visible only as a wrong answer, which is the whole point.
//
// THE INVARIANT (stated once, in one domain, checked against the arena itself):
//   live_allocatable == capacity_allocatable - free_slots_actually_in_the_arena
// Both sides are derived here from the single recorded capacity.  No other
// site may compare a count to a capacity.
fn NRESERVED()i32 { return 2; }
fn cap_alloc(W:[]u8)i32 { return nodecap(W) - NRESERVED(); }
fn live_alloc(W:[]u8)i32 { return hg(W,20) - NRESERVED(); }
fn free_slots(W:[]u8)i32 { return cap_alloc(W) - live_alloc(W); }
fn arena_free(W:[]u8)i32 {
  let c:i32=0; let i:i32=NRESERVED();
  let nc:i32=nodecap(W);
  while(i<nc){ if(ng(W,i,36)==0){ c=c+1; } i=i+1; }
  return c;
}
fn t2_bump(W:[]u8,f:i32)void {
  if(iv_ok(W)==0){ return; }
  let v:i32=ivL(W,f)+1;
  ivS(W,f,v);
  return;
}
// ---- distinct refusal codes (P3: a refusal is never the same value as an
// answer, an ignorance, a malformed operand or an invariant violation) ----
fn MALFORMED_OP()i32 { return -999998; }  // operand in no legal band
fn GUARD_REJECT()i32 { return -999999; }  // ISA failed closed
fn CAP_REFUSED()i32 { return -1; }        // capacity checked before write
fn NO_ANSWER()i32 { return -2; }          // honest ignorance
fn ANS_SET()i32 { return -3; }            // answer is a SET, not an i32
fn IV_VIOLATION()i32 { return -4; }       // validator declined
// admission modes: the ambient context is what makes PROV_OBS unforgeable
fn MODE_IDLE()i32 { return 0; }
fn MODE_OBS()i32  { return 1; }
fn MODE_INFER()i32 { return 2; }
fn admit_set(W:[]u8,m:i32)void { ivS(W,R_ADMITMODE(),m); return; }
fn admit_get(W:[]u8)i32 { if(iv_ok(W)==0){ return MODE_IDLE(); } return ivL(W,R_ADMITMODE()); }
// ---- node PROVENANCE, in the reserved node field 16 (frozen never wrote it) --
// P1/P4: a record must not be served as knowledge unless its provenance says
// it was observed.  Inference may never write PROV_OBSERVED.  This is what
// stops a hallucination being laundered into the fact table and then served
// by the ordinary exact-hit path.
fn PROV_NONE()i32   { return 0; }   // substrate-made, not admitted as knowledge
fn PROV_OBS()i32    { return 1; }   // taught: evidence exists about THIS subject
fn PROV_INFER()i32  { return 2; }   // MAP / revision / derived
fn PROV_UNCERT()i32 { return 3; }   // inquiry
fn PROV_STRUCT()i32 { return 4; }   // group, cell, frame, literal, hist
fn prov_get(W:[]u8,n:i32)i32 { return ng(W,n,16); }
fn prov_set(W:[]u8,n:i32,p:i32)void { ns(W,n,16,p); return; }
// ---- M3: DISJOINT TAGGED OPERAND BANDS -----------------------------------
// The frozen decoder dispatched on MAGNITUDE (`op>=1000 -> slot, else node`),
// so a node id and a slot index shared one representation.  The bands are now
// disjoint BY CONSTRUCTION (every node id is < NODECAP <= SLOTBASE) and the
// decoder is checked: a value in no band is MALFORMED and counted.
fn opnd_slot(k:i32)i32 { return 1048576+k; }
fn band_slot(op:i32)i32 {
  if(op<1048576){ return 0; }
  if(op-1048576>=4){ return 0; }
  return 1;
}
fn band_node(op:i32)i32 {
  if(op<0){ return 0; }
  if(op>=NN()){ return 0; }
  return 1;
}
// a checked, closed band test used by the validator itself
fn opnd_bands(op:i32)i32 { return band_slot(op)+band_node(op); }
// ============ edge types (13: CLA-2 12 + E_CORROB) ============
fn ET_DEP()i32 { return 1; }
fn ET_SUP()i32 { return 2; }
fn ET_CON()i32 { return 3; }
fn ET_REF()i32 { return 4; }
fn ET_INS()i32 { return 5; }
fn ET_USE()i32 { return 6; }
fn ET_CFM()i32 { return 7; }
fn ET_SUR()i32 { return 8; }
fn ET_PRO()i32 { return 9; }
fn ET_MEM()i32 { return 10; }
fn ET_REG()i32 { return 11; }
fn ET_SEQ()i32 { return 12; }
fn ET_COR()i32 { return 13; }
fn ET_REG0()i32 { return 0; }   // the VALUE-domain relation: never node endpoints
fn REL_LO()i32 { return 0; }
fn REL_HI()i32 { return 13; }
// DECLARED RELATION DOMAIN.  A relation code outside it is not a relation; it
// is a truncated or mis-decoded field, and it is counted as malformed rather
// than silently walked.  Checked, not assumed.
fn rel_ok(t:i32)i32 {
  if(t<REL_LO()){ return 0; }
  if(t>REL_HI()){ return 0; }
  return 1;
}
// ============ EXECUTE 4-op ISA ============
fn OP_MOVE()i32 { return 101; }
fn OP_BEQ()i32 { return 102; }
fn OP_INC()i32 { return 103; }
fn OP_DEC()i32 { return 104; }
// ============ node types ============
fn T_FACT()i32 { return 1; }
fn T_GROUP()i32 { return 2; }
fn T_HIST()i32 { return 3; }
fn T_REGRET()i32 { return 4; }
fn T_MAP()i32 { return 20; }
fn T_COEFF()i32 { return 21; }
fn T_UNCERT()i32 { return 30; }
// ============ core primitives ============
// M2/M3: the node ceiling is READ FROM THE RECORD, never written as a literal
// at a use site, and `nodecap` is the single bound for every node scan.
fn node_reset(W:[]u8,n:i32)void {
  ns(W,n,36,1); ns(W,n,0,0);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
  ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return;
}
// M3 (P3): reported live count MUST equal the stored live count.  The frozen
// core zeroed field 36 in three places without decrementing the header, and
// initialised the header to 0 with two live nodes already present.
fn revive_node(W:[]u8,n:i32)void {
  if(n<2){ return; }
  if(ng(W,n,36)==1){ return; }
  ns(W,n,36,1); hs(W,20,hg(W,20)+1); return;
}
fn free_node(W:[]u8,n:i32)void {
  if(n<2){ return; }
  if(ng(W,n,36)!=1){ return; }
  ns(W,n,36,0); ns(W,n,0,0);
  hs(W,20,hg(W,20)-1); return;
}
fn alloc_raw(W:[]u8)i32 {
  let nc:i32=nodecap(W);
  let n:i32=2;
  while(n<nc){
    if(ng(W,n,36)==0){
      node_reset(W,n); hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  return -1;
}
// STRUCTURAL allocation: may reclaim a node, but ONLY a node the retention
// policy is licensed to discard (never an observed fact -- see evict_node).
fn alloc_node(W:[]u8)i32 {
  let n:i32=alloc_raw(W);
  if(n>=0){ return n; }
  let v:i32=evict_node(W);
  if(v<0){ t2_bump(W,R_CAPREFUSE()); return -1; }
  node_reset(W,v); hs(W,20,hg(W,20)+1); return v;
}
fn write_node(W:[]u8,n:i32,a:i32,b:i32,c:i32,d:i32)void {
  ns(W,n,20,a); ns(W,n,24,b); ns(W,n,28,c); ns(W,n,32,d); return;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)==-1){
      es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
      hs(W,24,hg(W,24)+1); return e;
    }
    e=e+1;
  }
  t2_bump(W,R_CAPREFUSE());
  return -1;
}
fn is_superseded(W:[]u8,n:i32)i32 {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==3 && eg(W,e,0)==n && eg(W,e,8)==n){return 1;}
    e=e+1;
  }
  return 0;
}
// ---- M5: the object set of (s,r) as a first-class representation ----------
// The frozen `activate` returned ONE i32 chosen by a `bid` tie-break among
// all facts about (s,r), silently discarding the rest (C509).  The set is the
// representation; the scalar accessor refuses when the set is not a singleton.
fn fact_distinct(W:[]u8,s:i32,r:i32,out:[]u8,cap:i32)i32 {
  let nc:i32=nodecap(W);
  let n:i32=0; let i:i32=2;
  while(i<nc){
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && ng(W,i,20)==s && ng(W,i,24)==r){
      if(is_superseded(W,i)==0){
        let o:i32=ng(W,i,28);
        let k:i32=0; let dup:i32=0;
        while(k<n){ if(get32(out,k*4)==o){dup=1;} k=k+1; }
        if(dup==0){
          if(n>=cap){ t2_bump(W,R_SETOVF()); return -1; }
          set32(out,n*4,o); n=n+1;
        }
      }
    }
    i=i+1;
  }
  // insertion sort ascending: the answer is a SET, so the ORDER in which the
  // evidence happened to be allocated must not appear in it.
  //
  // C515d -- BUG FOUND IN THIS LANE'S OWN M5 CODE AND FIXED HERE.  The first
  // draft used j=-1 as BOTH the loop-exit sentinel and the insertion index:
  //     while(j>=0){ if(out[j]<=v){ j=-1; } else { shift; j=j-1; } }
  //     out[j+1]=v;                       // <-- after the break j is -1, so
  // On finding the insertion point it wrote v at index 0, clobbering the
  // smallest element.  Sorting [30,40,50] produced [50,40,50] -- a set with a
  // duplicate and a hole, returned with the CORRECT count 3.
  //
  // This is the mission's root class wearing a new hat: ONE integer doing TWO
  // jobs, so the value that means "finished" also silently became a position.
  // It was invisible while ev_query only used the count and, for a singleton,
  // never entered the sort -- which is exactly why a validator-free accessor
  // rotted unnoticed.  The exit is now a separate declared flag.
  let done:i32=0;
  i=1;
  while(i<n){
    let v:i32=get32(out,i*4); let j:i32=i-1;
    done=0;
    while(done==0 && j>=0){
      if(get32(out,j*4)<=v){ done=1; } else { set32(out,(j+1)*4,get32(out,j*4)); j=j-1; }
    }
    set32(out,(j+1)*4,v);
    i=i+1;
  }
  return n;
}
fn activate(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bb:i32=-1; let nc:i32=nodecap(W); let n:i32=2;
  while(n<nc){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let b:i32=bid(W,n);
        if(b>bb){bb=b; best=n;}
      }
    }
    n=n+1;
  }
  return best;
}
fn decay(W:[]u8)void {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9){
      let c:i32=eg(W,e,12)-1;
      if(c<=0){es(W,e,0,-1); hs(W,24,hg(W,24)-1);}
      else {es(W,e,12,c);}
    }
    e=e+1;
  }
  return;
}
// ---- EXECUTE ----
fn fr_get(W:[]u8,f:i32,s:i32)i32 {
  let nc:i32=nodecap(W);
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<2 || cur>=nc){return 0;} ss=ss-4;}
  if(ss==0){return ng(W,cur,20);} if(ss==1){return ng(W,cur,24);}
  if(ss==2){return ng(W,cur,28);} return ng(W,cur,32);
}
fn fr_set(W:[]u8,f:i32,s:i32,v:i32)void {
  let nc:i32=nodecap(W);
  let cur:i32=f; let ss:i32=s;
  while(ss>=4){cur=ng(W,cur,4); if(cur<2 || cur>=nc){return;} ss=ss-4;}
  if(ss==0){ns(W,cur,20,v);} else {if(ss==1){ns(W,cur,24,v);}
  else {if(ss==2){ns(W,cur,28,v);} else {ns(W,cur,32,v);}}}
  return;
}
// M3 CHECKED DECODER.  Exactly one band may claim the value; a value in no
// band, or a node-band value naming a dead node, is MALFORMED and counted.
// This is the fix for the silent node-id/frame-slot aliasing (C505): the two
// encodings can no longer be confused because they cannot overlap.
fn res_op(W:[]u8,f:i32,op:i32)i32 {
  if(band_slot(op)==1){ return fr_get(W,f,op-1048576); }
  if(band_node(op)==1){
    if(ng(W,op,36)!=1){ t2_bump(W,R_MALFORMED()); return MALFORMED_OP(); }
    return ng(W,op,20);
  }
  t2_bump(W,R_MALFORMED());
  return MALFORMED_OP();
}
fn seq_nx(W:[]u8,c:i32)i32 {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==c){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn execute(W:[]u8,root:i32,fr:i32)i32 {
  let cur:i32=root; let st:i32=0;
  while(st<1000){
    if(cur<0){return GUARD_REJECT();}
    let tag:i32=ng(W,cur,0); let nx:i32=-1;
    if(tag==101){
      let d:i32=ng(W,cur,4); let sr:i32=ng(W,cur,8);
      if(band_slot(d)!=1){t2_bump(W,R_MALFORMED()); return MALFORMED_OP();}
      let rv:i32=res_op(W,fr,sr);
      if(rv==MALFORMED_OP()){return MALFORMED_OP();}
      fr_set(W,fr,d-1048576,rv); nx=seq_nx(W,cur);
    } else {if(tag==102){
      let a:i32=res_op(W,fr,ng(W,cur,4)); let b:i32=res_op(W,fr,ng(W,cur,8));
      if(a==MALFORMED_OP() || b==MALFORMED_OP()){return MALFORMED_OP();}
      if(a==b){nx=ng(W,cur,12);} else {nx=ng(W,cur,16);}
    } else {if(tag==103){
      let s:i32=ng(W,cur,4);
      if(band_slot(s)!=1){t2_bump(W,R_MALFORMED()); return MALFORMED_OP();}
      fr_set(W,fr,s-1048576,fr_get(W,fr,s-1048576)+1); nx=seq_nx(W,cur);
    } else {if(tag==104){
      let s2:i32=ng(W,cur,4);
      if(band_slot(s2)!=1){t2_bump(W,R_MALFORMED()); return MALFORMED_OP();}
      fr_set(W,fr,s2-1048576,fr_get(W,fr,s2-1048576)-1); nx=seq_nx(W,cur);
    } else {return GUARD_REJECT();}}}}
    if(nx<0){if(tag==102){return GUARD_REJECT();} return 1;}
    cur=nx; st=st+1;
  }
  return GUARD_REJECT();
}
fn exec_val(W:[]u8,root:i32,fr:i32)i32 {
  if(execute(W,root,fr)!=1){return GUARD_REJECT();}
  return res_op(W,fr,ng(W,root,4));
}
// ============ retention: 3-step eviction, directional bid ============
fn is_prot(W:[]u8,n:i32)i32 {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n && eg(W,e,12)>0){return 1;}
    e=e+1;
  }
  return 0;
}
fn evcount(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let ec:i32=edgecap(W); let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==n && eg(W,e,4)==t){c=c+1;}
    e=e+1;
  }
  return c;
}
fn bid(W:[]u8,n:i32)i32 {
  let c:i32=evcount(W,n,1)+evcount(W,n,2)+evcount(W,n,6)+evcount(W,n,7)-evcount(W,n,3);
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==10 && eg(W,e,8)==n){
      let g:i32=eg(W,e,0);
      c=c+evcount(W,g,1)+evcount(W,g,2)+evcount(W,g,6)+evcount(W,g,7)-evcount(W,g,3);
    }
    e=e+1;
  }
  return c;
}
fn rec_evict(W:[]u8,n:i32)void {
  let h:i32=alloc_raw(W); if(h<0){return;}
  ns(W,h,0,3); write_node(W,h,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
  ns(W,h,4,hg(W,12)); hs(W,12,h); prov_set(W,h,PROV_STRUCT()); return;
}
// ORDER INVARIANCE (C508/C509 at the retention layer).  The frozen victim
// scan started at the rotation cursor hg(W,8) and took the first strict
// minimum, so WHO died was a function of insertion order.  The victim set is
// now the minimum of a TOTAL ORDER ON CONTENT -- (bid, provenance, tag,
// subject, relation, object).  The node id is deliberately NOT in the order:
// two nodes equal on all six keys are interchangeable, so the residual tie is
// benign, and no answer can depend on it.
fn ev_cmp(ab:i32,ap:i32,at:i32,as:i32,ar:i32,ao:i32,
          bb:i32,bp:i32,bt:i32,bs:i32,br:i32,bo:i32)i32 {
  if(ab<bb){return -1;} if(ab>bb){return 1;}
  if(ap<bp){return -1;} if(ap>bp){return 1;}
  if(at<bt){return -1;} if(at>bt){return 1;}
  if(as<bs){return -1;} if(as>bs){return 1;}
  if(ar<br){return -1;} if(ar>br){return 1;}
  if(ao<bo){return -1;} if(ao>bo){return 1;}
  return 0;
}
fn evict_node(W:[]u8)i32 {
  let best:i32=-1; let bb:i32=0; let bp:i32=0; let bt:i32=0;
  let bs:i32=0; let br:i32=0; let bo:i32=0;
  let nc:i32=nodecap(W);
  let i:i32=2;
  while(i<nc){
    if(ng(W,i,36)==1 && is_prot(W,i)==0){
      // an OBSERVED FACT IS NOT A RETENTION CANDIDATE.  Losing world content
      // to make room for more world content is not a retention decision; it is
      // a capacity exhaustion, and capacity exhaustion has a refusal code.
      if(prov_get(W,i)!=PROV_OBS()){
        let b:i32=bid(W,i);
        let p:i32=prov_get(W,i); let t:i32=ng(W,i,0);
        let s:i32=ng(W,i,20); let r:i32=ng(W,i,24); let o:i32=ng(W,i,28);
        if(best<0){ best=i; bb=b; bp=p; bt=t; bs=s; br=r; bo=o; }
        else {
          let c:i32=ev_cmp(b,p,t,s,r,o,bb,bp,bt,bs,br,bo);
          if(c<0){ best=i; bb=b; bp=p; bt=t; bs=s; br=r; bo=o; }
        }
      }
    }
    i=i+1;
  }
  if(best<0){return -1;}
  rec_evict(W,best);
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  free_node(W,best);
  return best;
}
fn ref_prot(W:[]u8,n:i32)void {
  let ec:i32=edgecap(W);
  let e:i32=0;
  while(e<ec){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,8)==n){es(W,e,12,hg(W,4));}
    e=e+1;
  }
  return;
}
// ============ events ============
// P3/V3: a log shortfall is itself a recorded fact, not a silent drop.
fn log_ev(W:[]u8,k:i32,r0:i32,r1:i32,p0:i32,p1:i32,p2:i32,p3:i32)void {
  let l:i32=hg(W,28);
  if(l>=logcap(W)){ t2_bump(W,R_LOGDROPS()); return; }
  ls(W,l,0,hg(W,0)); ls(W,l,4,k); ls(W,l,8,r0); ls(W,l,12,r1);
  ls(W,l,16,p0); ls(W,l,20,p1); ls(W,l,24,p2); ls(W,l,28,p3);
  hs(W,28,l+1); return;
}
fn ctx_push(W:[]u8,r:i32)void {
  let i:i32=hg(W,48); hs(W,32+i*4,r); i=i+1; if(i>=4){i=0;} hs(W,48,i); return;
}
fn ctx_get(W:[]u8,i:i32)i32 {
  let x:i32=hg(W,48)-1-i; while(x<0){x=x+4;} return hg(W,32+x*4);
}
// ============ M4 ADMISSION: the only writer of fact nodes ================
// A fact node cannot be created without a provenance, and PROV_OBS cannot be
// written outside MODE_OBS.  The ambient admission mode is set by the two
// observation APIs and by the inference paths, so an inference path that
// tried to mint an observed fact would be REFUSED and counted, not believed.
fn fact_admit(W:[]u8,s:i32,r:i32,o:i32,prov:i32)i32 {
  if(prov==PROV_OBS()){
    if(admit_get(W)!=MODE_OBS()){
      t2_bump(W,R_DOWNGRADE());
      return CAP_REFUSED();
    }
  }
  // M2: capacity is checked BEFORE the write.  An observed fact may not be
  // reclaimed to make room, so the refusal here is terminal and loud.
  let n:i32=alloc_raw(W);
  if(n<0){
    let v:i32=evict_node(W);
    if(v<0){ t2_bump(W,R_CAPREFUSE()); return CAP_REFUSED(); }
    n=alloc_raw(W);
    if(n<0){ t2_bump(W,R_CAPREFUSE()); return CAP_REFUSED(); }
  }
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0)); prov_set(W,n,prov);
  return n;
}
fn ev_teach(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  if(iv_check(W)!=0){ t2_bump(W,R_IVVIOL()); return IV_VIOLATION(); }
  admit_set(W,MODE_OBS());
  let n:i32=fact_admit(W,s,r,o,PROV_OBS());
  admit_set(W,MODE_IDLE());
  if(n<0){ log_ev(W,11,s,r,o,0,0,0); return n; }
  link_edge(W,n,9,n,hg(W,4));
  let prev:i32=-1; let m:i32=2;
  while(m<nodecap(W)){
    if(ng(W,m,36)==1 && m!=n && ng(W,m,0)==1){prev=m;}
    m=m+1;
  }
  if(prev>=0){link_edge(W,n,5,prev,0);}
  log_ev(W,1,s,r,o,0,0,0); return n;
}
fn ev_teach_in(W:[]u8,s:i32,r:i32,o:i32)i32 {
  admit_set(W,MODE_OBS());
  let n:i32=fact_admit(W,s,r,o,PROV_OBS());
  admit_set(W,MODE_IDLE());
  if(n<0){ return n; }
  link_edge(W,n,9,n,hg(W,4)); return n;
}
// INFERENCE may assert a value it derived, but the record it writes is
// PROV_INFER -- it is never laundered into the observed namespace.
fn ev_assert_infer(W:[]u8,s:i32,r:i32,o:i32)i32 {
  admit_set(W,MODE_INFER());
  let n:i32=fact_admit(W,s,r,o,PROV_INFER());
  admit_set(W,MODE_IDLE());
  return n;
}
// ============ Change 1: trial loop over 4-op ISA graphs ============
// keeper from the frozen base (was in the plan section; it is only an
// edge-link helper, not a template): link two cells via ET_SEQ.
fn seq_link(W:[]u8,a:i32,b:i32)void { link_edge(W,a,12,b,0); return; }
// The MUL Rung B trial loop (propose/execute/verify/promote) as the general
// miss policy. Candidate plans are 4-op ISA graphs (tags 101-104) assembled
// at runtime from primitive cells, executed by execute() (the single
// executor), verified against the triggering observation, and promoted to
// learner state. The fixed plan templates (plan_c2/plan_g/plan_it/plan_ext/
// plan_c2c) and the separate exec_plan executor are removed (K-T2-2, K-T2-3).
// Graph conventions:
// - Cells link via ET_SEQ edges, except BRANCHEQ true-targets (field12).
// - A GUARD cell (BRANCHEQ) with no SEQ fallthrough fails closed: execute
//   returns -999999, which the verifier counts as a rejection.
// - Literals are 902-nodes holding the value in field20 (data, not a new
//   node type; invisible to activate/inc_fill which scan type 1).
// - Frame: fresh 902-node; slot0 = query subject s (chain/count) or 0
//   (sum), slot1 = 0. Root field4 is the output operand (1000+slot).
// - Provenance: each SETREG cell carries an ET_DEP edge to the fact node
//   licensing its link; the MAP node carries ET_DEP edges to all of them.
//   Change 3 (revision) uses this to find stale steps.
// Gather helpers kept verbatim from the frozen base: inc_fill,
// comb_present, popcnt. map_standing/contradict_map kept verbatim.
fn t2_lit(W:[]u8,v:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,902); ns(W,n,20,v); prov_set(W,n,PROV_STRUCT()); return n;
}
fn t2_cell(W:[]u8,tag:i32)i32 {
  let c:i32=alloc_node(W); if(c<0){return -1;}
  ns(W,c,0,tag); prov_set(W,c,PROV_STRUCT()); return c;
}
// M3: every slot operand is written in the SLOT band, never as 1000+slot.
fn t2_guard(W:[]u8,slot:i32,litx:i32)i32 {
  let g:i32=t2_cell(W,102); if(g<0){return -1;}
  ns(W,g,4,opnd_slot(slot)); ns(W,g,8,litx); return g;
}
fn t2_set(W:[]u8,slot:i32,lity:i32)i32 {
  let s:i32=t2_cell(W,101); if(s<0){return -1;}
  ns(W,s,4,opnd_slot(slot)); ns(W,s,8,lity); return s;
}
fn t2_mov(W:[]u8,dst:i32,src:i32)i32 {
  let c:i32=t2_cell(W,101); if(c<0){return -1;}
  ns(W,c,4,opnd_slot(dst)); ns(W,c,8,opnd_slot(src)); return c;
}
fn t2_inc(W:[]u8,slot:i32)i32 {
  let c:i32=t2_cell(W,103); if(c<0){return -1;}
  ns(W,c,4,opnd_slot(slot)); return c;
}
// chain graph: guard each link (v[j] -> v[j+1]), set on match.
fn t2_asm_chain(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    ns(W,g,12,st);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=st; j=j+1;
  }
  return root;
}
// count graph: chain links, each setting plus an increment, then
// MOVE r0 <- r1 epilogue so the count is the output.
fn t2_asm_count(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    let ic:i32=t2_inc(W,1); if(ic<0){return -1;}
    ns(W,g,12,st); seq_link(W,st,ic);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  let mv:i32=t2_mov(W,0,1); if(mv<0){return -1;}
  seq_link(W,prev,mv);
  return root;
}
// sum graph: unrolled INC cells for the subset total. Negative totals and
// totals beyond the execute budget are skipped (candidate declined).
fn t2_asm_sum(W:[]u8,vals:[]u8,n:i32)i32 {
  let total:i32=0; let i:i32=0;
  while(i<n){total=total+get32(vals,i*4); i=i+1;}
  if(total<=0 || total>900){return -1;}
  let root:i32=-1; let prev:i32=-1;
  i=0;
  while(i<total){
    let c:i32=t2_inc(W,0); if(c<0){return -1;}
    if(prev>=0){seq_link(W,prev,c);} else {root=c;}
    prev=c; i=i+1;
  }
  return root;
}
// run one candidate graph on a fresh frame; GUARD_REJECT on any failure.
fn t2_exec(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return GUARD_REJECT();}
  let fr:i32=alloc_node(W); if(fr<0){return GUARD_REJECT();}
  ns(W,fr,0,902); prov_set(W,fr,PROV_STRUCT());
  fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return GUARD_REJECT();}
  return res_op(W,fr,ng(W,root,4));
}
fn t2_lu_first(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}
// per-relation value chain: v[0]=s; f per link. Returns value count.
fn t2_chain(W:[]u8,s:i32,r:i32,v:[]u8,f:[]u8)i32 {
  set32(v,0,s); let len:i32=1; let cur:i32=s; let done:i32=0;
  while(len<16 && done==0){
    let fnd:i32=t2_lu_first(W,cur,r);
    if(fnd<0){done=1;}
    else {
      set32(v,len*4,ng(W,fnd,28)); set32(f,(len-1)*4,fnd);
      cur=ng(W,fnd,28); len=len+1;
    }
  }
  return len;
}
// BFS paths from s (depth 1..4, no -999 links). Entry: 12 i32 slots:
// len, v0..v4, f0..f3. Returns path count.
fn t2_gather(W:[]u8,s:i32,paths:[]u8)i32 {
  let np:i32=0; let cap:i32=96;
  set32(paths,0,1); set32(paths,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*48;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let n:i32=2;
      while(n<nodecap(W) && np<cap){
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==lastv && ng(W,n,24)!=-999){
          let o:i32=ng(W,n,28);
          let k:i32=0; let cyc:i32=0;
          while(k<len){if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1;}
          if(cyc==0){
            let nb:i32=np*48; let c2:i32=0;
            while(c2<12){set32(paths,nb+c2*4,get32(paths,base+c2*4)); c2=c2+1;}
            set32(paths,nb,len+1);
            set32(paths,nb+4+len*4,o);
            set32(paths,nb+24+(len-1)*4,n);
            np=np+1;
          }
        }
        n=n+1;
      }
    }
    head=head+1;
  }
  return np;
}
// sum candidates: values + licensing facts of s's direct (non -999) facts.
fn t2_gather_sum(W:[]u8,s:i32,vals:[]u8,facts:[]u8)i32 {
  let n:i32=0; let x:i32=2;
  while(x<nodecap(W) && n<12){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==s && ng(W,x,24)!=-999){
      set32(vals,n*4,ng(W,x,28)); set32(facts,n*4,x); n=n+1;
    }
    x=x+1;
  }
  return n;
}
// relations of s, excluding -999.
fn t2_rels(W:[]u8,s:i32,out:[]u8)i32 {
  let rb:[]u8=z_alloc(64); let nr:i32=inc_fill(W,s,rb);
  let n:i32=0; let i:i32=0;
  while(i<nr){
    let r:i32=get32(rb,i*4);
    if(r!=-999){set32(out,n*4,r); n=n+1;}
    i=i+1;
  }
  return n;
}
// verify one candidate. st[0]=tried, st[1]=rejected. Returns the verified
// answer or NO_ANSWER.  A failed guard (GUARD_REJECT) and a MALFORMED operand
// are both genuine rejections and neither is ever reported as an answer.
fn t2_try_verify(W:[]u8,root:i32,s0:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(root<0){return NO_ANSWER();}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec(W,root,s0);
  if(v==GUARD_REJECT() || v==MALFORMED_OP()){
    set32(st,4,get32(st,4)+1);
    return NO_ANSWER();
  }
  if(masked==1){ return v; }
  if(expected!=NO_ANSWER() && v==expected){ return v; }
  set32(st,4,get32(st,4)+1);
  return NO_ANSWER();
}
// graph signature for revision tests: walk SEQ + BRANCHEQ true-targets,
// record (tag, literal) per cell. Returns cell count.  The literal operand
// is read through the checked decoder, so a signature cannot be computed from
// an operand that has no legal reading.
fn t2_sig(W:[]u8,root:i32,sig:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let ok:i32=1;
  while(cur>=2 && n<32 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ok=0;}
    else {
      set32(sig,n*8,tag);
      let lv:i32=0;
      if(tag==101 || tag==102){
        let ln:i32=ng(W,cur,8);
        if(band_node(ln)==1 && ng(W,ln,36)==1){lv=ng(W,ln,20);}
      }
      set32(sig,n*8+4,lv);
      n=n+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    }
  }
  return n;
}
// promote a verified trial graph to learner state. MAP layout kept from the
// frozen base (field4=r, field8=s, field20=graph root, field24=promo index,
// field28=answer); provenance DEP edges to licensing facts.
// M2/M4: an answer may only be served if the record that licences it was
// actually ADMITTED.  If the answer fact cannot be stored, the whole
// promotion fails loudly instead of returning an unbacked value.
fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  prov_set(W,m,PROV_INFER());
  write_node(W,m,root,hg(W,24),ans,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  // the derived value is PROV_INFER -- inference never writes PROV_OBS
  let f:i32=ev_assert_infer(W,s,r,ans);
  if(f<0){
    let ec:i32=edgecap(W);
    let e:i32=0;
    while(e<ec){
      if(eg(W,e,0)!=-1 && (eg(W,e,0)==m || eg(W,e,8)==m)){
        es(W,e,0,-1); hs(W,24,hg(W,24)-1);
      }
      e=e+1;
    }
    free_node(W,m);
    return -1;
  }
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  return m;
}
// keepers from the frozen base (verbatim): gather helpers and standing.
fn inc_fill(W:[]u8,s:i32,out:[]u8)i32 {
  let nr:i32=0; let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s){
      let r:i32=ng(W,n,24); let k:i32=0; let f:i32=0;
      while(k<nr){if(get32(out,k*4)==r){f=1;} k=k+1;}
      if(f==0){set32(out,nr*4,r); nr=nr+1;}
    }
    n=n+1;
  }
  return nr;
}
fn comb_present(W:[]u8)i32 {
  let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==8){return n;}
    n=n+1;
  }
  return -1;
}
fn popcnt(x:i32)i32 {
  let c:i32=0; while(x>0){c=c+(x&1); x=x>>1;} return c;
}
fn map_standing(W:[]u8,m:i32)i32 {
  let promo:i32=ng(W,m,24); let c:i32=0; let e:i32=0;
  while(e<edgecap(W)){
    if(eg(W,e,0)!=-1 && eg(W,e,8)==m && e>=promo){
      if(eg(W,e,4)==2){c=c+1;} if(eg(W,e,4)==3){c=c-1;}
    }
    e=e+1;
  }
  return c;
}
fn contradict_map(W:[]u8,m:i32)i32 {
  link_edge(W,m,3,m,0); return 0;
}
// t2_trial: the miss policy. Search order is composition-preserving:
// longer chains (k=2..4) before sums before counts before single hops,
// so masked t_f2 still prefers the 2-hop reading. dc/di gates mirror the
// frozen ablation flags. E-ruling: expected is post-hoc feedback only.
// Trial stats (tried/rejected) packed into header field 16.
fn t2_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let p:i32=0;
      while(p<np && ans==-2){
        let base:i32=p*48;
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,k+1,f);
          let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
          if(v2!=-2 && promote_graph(W,root,s,r,v2,f,k)>=0){ans=v2;}
        }
        p=p+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum(W,s,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        if(popcnt(mask)==sz){
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          let root:i32=t2_asm_sum(W,sv,c);
          let v2:i32=t2_try_verify(W,root,0,expected,masked,st);
          if(v2!=-2 && promote_graph(W,root,s,r,v2,ff,c)>=0){ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        let root:i32=t2_asm_count(W,v,len,f);
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2 && promote_graph(W,root,s,r,v2,f,len-1)>=0){ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==2){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(f,0,get32(paths,base+24));
        let root:i32=t2_asm_chain(W,v,2,f);
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2 && promote_graph(W,root,s,r,v2,f,1)>=0){ans=v2;}
      }
      p=p+1;
    }
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}
// mp_run: trial-based miss policy (Change 1). E-ruling preserved.
fn mp_run(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let masked:i32=flags&1; let dc:i32=(flags>>1)&1; let di:i32=(flags>>2)&1;
  return t2_trial(W,s,r,expected,masked,dc,di);
}
// ============ Change 3: generic revision over 4-op executable graphs ============
// On a counterexample (ev_observe contradicts a fact that licenses a graph
// link), the stale step is removed and a corrected step inserted; the
// restructured graph is re-executed and only kept on verification success.
// Topology change, not standing demotion: no CON edge touches the MAP.
fn t2_kill_edge(W:[]u8,a:i32,t:i32,to:i32)void {
  let e:i32=0;
  while(e<edgecap(W)){
    if(eg(W,e,0)==a && eg(W,e,4)==t && eg(W,e,8)==to){es(W,e,0,-1); hs(W,24,hg(W,24)-1);}
    e=e+1;
  }
  return;
}
fn revise_on_contradict(W:[]u8,factn:i32,new_o:i32)void {
  let old_o:i32=ng(W,factn,28);
  if(old_o==new_o){return;}
  let m:i32=2;
  while(m<nodecap(W)){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let e:i32=0; let hit:i32=0;
      while(e<edgecap(W)){
        if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1 && eg(W,e,8)==factn){hit=1;}
        e=e+1;
      }
      if(hit==1){t2_revise_graph(W,m,factn,old_o,new_o);}
    }
    m=m+1;
  }
  return;
}
// surgical revision: find the stale SETREG step via provenance, tombstone
// it, insert a corrected step, rewire, re-execute. On verification failure
// the graph is reverted and 0 returned. On success the promoted answer
// fact is contradicted and the corrected answer taught; standing untouched.
fn t2_revise_graph(W:[]u8,m:i32,factn:i32,old_o:i32,new_o:i32)i32 {
  let root:i32=ng(W,m,20); let s:i32=ng(W,m,8); let r:i32=ng(W,m,4);
  let ans_old:i32=ng(W,m,28);
  let e:i32=0; let stale:i32=-1;
  while(e<edgecap(W)){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==factn){
      let c:i32=eg(W,e,0);
      if(ng(W,c,36)==1 && ng(W,c,0)==101){stale=c;}
    }
    e=e+1;
  }
  if(stale<0){return 0;}
  let g:i32=-1; let c2:i32=2;
  while(c2<nodecap(W)){
    if(ng(W,c2,36)==1 && ng(W,c2,0)==102 && ng(W,c2,12)==stale){g=c2;}
    c2=c2+1;
  }
  if(g<0){return 0;}
  let succ:i32=seq_nx(W,stale);
  let ly:i32=t2_lit(W,new_o); if(ly<0){return 0;}
  let nst:i32=t2_set(W,0,ly); if(nst<0){return 0;}
  link_edge(W,nst,1,factn,0);
  ns(W,g,12,nst);
  if(succ>=0){seq_link(W,nst,succ);}
  if(succ>=0){t2_kill_edge(W,stale,12,succ);}
  // M3 (P3): the stale cell is freed THROUGH THE ALLOCATOR so the reported
  // live count keeps matching the stored live flags.  The frozen core zeroed
  // field 36 here and left the header count stale.
  free_node(W,stale);
  let out:i32=t2_exec(W,root,s);
  if(out==GUARD_REJECT() || out==MALFORMED_OP()){
    ns(W,g,12,stale);
    if(succ>=0){t2_kill_edge(W,nst,12,succ);}
    if(succ>=0){seq_link(W,stale,succ);}
    ns(W,stale,0,101); revive_node(W,stale);
    t2_kill_edge(W,nst,1,factn);
    free_node(W,nst);
    return 0;
  }
  let fn2:i32=2;
  while(fn2<nodecap(W)){
    if(ng(W,fn2,36)==1 && ng(W,fn2,0)==1 && ng(W,fn2,20)==s && ng(W,fn2,24)==r && ng(W,fn2,28)==ans_old){
      link_edge(W,fn2,3,fn2,0);
    }
    fn2=fn2+1;
  }
  if(ev_assert_infer(W,s,r,out)<0){ return 0; }
  ns(W,m,28,out);
  return 1;
}
// ============ unified query: exact hit, else trial, else inquiry ============
fn k_get(W:[]u8)i32 {
  let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){return ng(W,n,20);}
    n=n+1;
  }
  let kn:i32=alloc_node(W); if(kn<0){return 3;}
  ns(W,kn,0,903); write_node(W,kn,3,0,0,0); prov_set(W,kn,PROV_STRUCT());
  link_edge(W,kn,9,kn,hg(W,4)); return 3;
}
// ============ C504/C508: bootstrap_miss IS SUPERSEDED (charter 51/158) ======
// The frozen rule scanned node ids 1023 DOWNWARD for facts whose RELATION was
// r, never compared the SUBJECT, and concluded `s r v0` -- then PERSISTED that
// as a fact node with ev_teach_in, so from the second query on it was served
// by the ordinary exact-hit path with no provenance edge to distinguish it.
// Three separate violations of one root invariant:
//   P1  the evidence set is a projection that EXCLUDES the queried subject;
//   P1  the evidence set is a RECENCY PREFIX of allocation order (C508: the
//       same 7 facts answer 7 or -2 by teaching order alone);
//   P4  inference wrote into the observed-fact namespace (C504: it fabricated
//       and then laundered).
// The rule is not merely disabled, it is TOMBSTONED: the body is gone, the
// call site is gone, and any residual call is counted and refuses.  The
// surviving general mechanism for a true miss is the Change-2 inquiry path
// miss_inquire -> UNCERTAINTY -> guide -> ev_act, which already refuses
// honestly and records the miss.
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  t2_bump(W,R_SUPERSEDED());
  return NO_ANSWER();
}
// ============ Change 2: miss -> UNCERTAINTY -> guide -> POLICY_ROOT ============
// Integrates the validated inquiry mechanism (commit 18ed3331c): Piece A
// reifies the admission as an UNCERTAINTY node in persistent learner state;
// Piece B constructs a guide linked to POLICY_ROOT. ev_act then selects over
// learner-constructed guides. Existing node/edge types only; no new modes.
// Called from ev_query's cognition path on a true miss.
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,30,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}
// M5: the SET-valued accessor.  This is the representation the frozen engine
// did not have (C509).  Returns the sorted DISTINCT object count for (s,r), or
// CAP_REFUSED if the caller's buffer is smaller than the set (M2: capacity
// derived from the caller's own length, checked before the write).
fn ev_query_set(W:[]u8,s:i32,r:i32,out:[]u8)i32 {
  let cap:i32=out.len/4;
  return fact_distinct(W,s,r,out,cap);
}
// M5 + M6 + P4: the scalar accessor REFUSES rather than choosing a member.
//   n==0 -> miss path (trial, then honest inquiry)
//   n==1 -> serve that value
//   n>1  -> ANS_SET (-3), counted.  Never a bid tie-break, never a discard.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  if(iv_check(W)!=0){ t2_bump(W,R_IVVIOL()); return IV_VIOLATION(); }
  let ob:[]u8=z_alloc(SETCAP()*4);
  let n:i32=fact_distinct(W,s,r,ob,SETCAP());
  if(n==CAP_REFUSED()){ t2_bump(W,R_ANSET()); log_ev(W,2,s,r,ANS_SET(),0,0,0); return ANS_SET(); }
  if(n==1){
    let node:i32=activate(W,s,r);
    if(node>=0){ link_edge(W,node,6,node,0); ref_prot(W,node); }
    log_ev(W,2,s,r,get32(ob,0),1,0,0); return get32(ob,0);
  }
  if(n>1){
    // A SET has no single-i32 representation.  Discarding members is exactly
    // the silent-wrong-answer failure mode, so this is a refusal, loudly.
    t2_bump(W,R_ANSET());
    log_ev(W,2,s,r,ANS_SET(),0,0,0);
    return ANS_SET();
  }
  let recent:i32=-1; let m:i32=2;
  while(m<nodecap(W)){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=NO_ANSWER()){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  log_ev(W,2,s,r,NO_ANSWER(),0,0,0);
  miss_inquire(W,s,r);
  return NO_ANSWER();
}
// M4 whole-evidence-set semantics.  The frozen code called activate(), which
// returned ONE max-bid member of (s,r); if that member happened to disagree
// with o, a 4-object star was reported as a CONTRADICTION of whichever member
// the tie-break chose -- order-dependent and wrong.  Now:
//   E1 some live fact about (s,r) already asserts o  -> confirmation
//   E2 some live fact about (s,r) asserts a DIFFERENT value -> contradiction
//      of the WHOLE set (every conflicting member is contradicted), which is
//      invariant under any permutation of the evidence
//   E3 no live fact about (s,r) -> plain new observation
fn ev_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  if(iv_check(W)!=0){ t2_bump(W,R_IVVIOL()); return IV_VIOLATION(); }
  let nc:i32=nodecap(W);
  let i:i32=2;
  while(i<nc){
    let ok:i32=0;
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && is_superseded(W,i)==0){ok=1;}
    if(ok==1){
      let s2:i32=ng(W,i,20); let r2:i32=ng(W,i,24); let o2:i32=ng(W,i,28);
      if(s2==s && r2==r && o2==o){ link_edge(W,i,7,i,0); ref_prot(W,i);
        log_ev(W,4,s,r,o,1,0,0); return 1; }
    }
    i=i+1;
  }
  // collect the conflicting set BEFORE mutating, so the decision cannot
  // depend on the order the loop happens to walk the arena
  let cf:[]u8=z_alloc(CONFCAP()*4);
  let nc2:i32=0; i=2;
  while(i<nc){
    let ok:i32=0;
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && is_superseded(W,i)==0){ok=1;}
    if(ok==1){
      let s3:i32=ng(W,i,20); let r3:i32=ng(W,i,24);
      if(s3==s && r3==r){
        if(nc2>=CONFCAP()){ t2_bump(W,R_SETOVF()); return CAP_REFUSED(); }
        set32(cf,nc2*4,i); nc2=nc2+1;
      }
    }
    i=i+1;
  }
  if(nc2>0){
    let k:i32=0;
    while(k<nc2){
      let fn3:i32=get32(cf,k*4);
      link_edge(W,fn3,3,fn3,0);
      revise_on_contradict(W,fn3,o);
      let h2:i32=alloc_raw(W);
      if(h2>=0){
        ns(W,h2,0,3); prov_set(W,h2,PROV_STRUCT());
        write_node(W,h2,ng(W,fn3,20),ng(W,fn3,24),ng(W,fn3,28),hg(W,0));
        link_edge(W,h2,5,fn3,0);
      }
      k=k+1;
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0 && nc2==1){link_edge(W,nn,4,get32(cf,0),0);}
    log_ev(W,4,s,r,o,0,0,0); return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0); return 1;
}
// ============ ACT: 5-step protocol, directional bid ============
fn ev_act(W:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,-3);
  let pr:i32=ng(W,0,20);
  if(pr<2){log_ev(W,3,0,0,0,0,0,0); return 0;}
  let best:i32=-1; let bb:i32=GUARD_REJECT(); let e:i32=0;
  while(e<edgecap(W)){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && is_superseded(W,cand)==0){
        let r0:i32=ng(W,cand,4); let cj:i32=0; let hit:i32=0;
        while(cj<4){if(r0==ctx_get(W,cj)){hit=1;} cj=cj+1;}
        if(hit==1){
          let b:i32=bid(W,cand);
          if(b>bb){bb=b; best=cand;}
        }
        let e2:i32=0;
        while(e2<edgecap(W)){
          if(eg(W,e2,0)!=-1){
            let c2:i32=-1;
            if(eg(W,e2,0)==cand){c2=eg(W,e2,8);} else {if(eg(W,e2,8)==cand){c2=eg(W,e2,0);}}
            if(c2>=2 && ng(W,c2,36)==1 && is_superseded(W,c2)==0){
              let r2:i32=ng(W,c2,4); let ck:i32=0; let h2:i32=0;
              while(ck<4){if(r2==ctx_get(W,ck)){h2=1;} ck=ck+1;}
              if(h2==1){
                let b2:i32=bid(W,c2);
                if(b2>bb){bb=b2; best=c2;}
              }
            }
          }
          e2=e2+1;
        }
      }
    }
    e=e+1;
  }
  if(best>=2){
    let av:i32=ng(W,best,20);
    link_edge(W,best,6,best,0); log_ev(W,3,0,0,av,1,0,0); return av;
  }
  log_ev(W,3,0,0,0,0,0,0); return 0;
}
// ============ init ============
// M3 (P3): the capacity record is WRITTEN HERE, once, and every bound in the
// engine is read back from it.  `tnn2_init` also fixes the frozen core's own
// reported!=stored defect: it set the live-node header to 0 while nodes 0 and
// 1 were already live.
fn tnn2_init(W:[]u8)void {
  let i:i32=0;
  while(i<110656){W[i]=0; i=i+1;}
  ivS(W,R_MAGIC(),T2MAGIC());
  ivS(W,R_SCHEMA(),T2SCHEMA());
  ivS(W,R_NODECAP(),NN());
  ivS(W,R_EDGECAP(),NE());
  ivS(W,R_LOGCAP(),LOGCAP());
  ivS(W,R_NSLOTS(),4);
  ivS(W,R_SLOTBASE(),1048576);
  ivS(W,R_ADMITMODE(),MODE_IDLE());
  ivS(W,R_CAPREFUSE(),0);
  ivS(W,R_MALFORMED(),0);
  ivS(W,R_LOGDROPS(),0);
  ivS(W,R_ANSET(),0);
  ivS(W,R_SUPERSEDED(),0);
  ivS(W,R_DOWNGRADE(),0);
  ivS(W,R_IVVIOL(),0);
  ivS(W,R_SETOVF(),0);
  let e:i32=0;
  while(e<edgecap(W)){es(W,e,0,-1); e=e+1;}
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  prov_set(W,0,PROV_STRUCT()); prov_set(W,1,PROV_STRUCT());
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,2); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  return;
}
fn pol_get(W:[]u8)i32 { return ng(W,0,20); }
fn pol_set(W:[]u8,v:i32)void { ns(W,0,20,v); return; }
fn mp_get(W:[]u8)i32 { return ng(W,1,20); }
fn mp_set(W:[]u8,v:i32)void { ns(W,1,20,v); return; }
// ============ M6 THE VALIDATOR: a runtime gate, not a test ===============
// Every stated invariant above is checked here, mechanically, on every entry to
// ev_query / ev_teach / ev_observe.  Returns 0 when the store is sound and a
// distinct nonzero code naming the violated invariant otherwise.  The engine
// DECLINES on a violation; it never answers.
//   1 record magic/schema present
//   2 the two operand bands are disjoint (NODECAP <= SLOTBASE)  [M3]
//   3 the capacity record agrees with the compiled layout
//   4 reported live node count == stored live flags                [P3]
//   5 reported live edge count == stored live edges                [P3]
//   6 every live edge endpoint is a live node or the -1 sentinel
//   7 every ISA cell operand decodes in EXACTLY ONE band           [M3]
//   8 every node id in use is inside the recorded node ceiling     [M2]
//   9 no node carries a provenance outside the declared set        [M4]
//  10 log cursor never exceeds the recorded log capacity           [M2]
fn iv_check(W:[]u8)i32 {
  if(iv_ok(W)==0){return 1;}
  let nc:i32=nodecap(W);
  if(nc>slotbase(W)){return 2;}
  if(nc!=NN()){return 3;}
  if(edgecap(W)!=NE()){return 3;}
  if(nslots(W)!=4 || slotbase(W)!=1048576){return 3;}
  if(logcap(W)>LOGCAP()){return 3;}
  // 4/8: reported == stored, and the occupancy record agrees with the arena
  let c:i32=0; let i:i32=0;
  while(i<nc){
    if(ng(W,i,36)==1){c=c+1;}
    i=i+1;
  }
  if(c!=hg(W,20)){return 4;}
  // THE CAPACITY INVARIANT, in one domain: the recorded occupancy, the
  // recorded capacity and the arena's actual free slots must agree.  Checked
  // against the arena, not against a literal, so it cannot drift.
  if(live_alloc(W)>cap_alloc(W)){return 4;}
  if(free_slots(W)!=arena_free(W)){return 4;}
  if(hg(W,20)<NRESERVED()){return 4;}
  // 5/6: edges.  COUNT AND DOMAIN ONLY.
  //
  // FALSE INVARIANT FOUND AND REMOVED (C513).  An earlier draft of this
  // validator asserted "every live edge has two LIVE-NODE endpoints".  That
  // assertion is NOT a property of the frozen substrate and is unsound:
  // t_dv builds a subject bigram with link_edge(100+i, 1, 101+i, 0), whose
  // endpoints are VALUES in the subject domain, and it does so through
  // relation type 1, which is the same relation the engine uses for
  // node-to-node guide edges.  Edge endpoints are therefore UNTAGGED in the
  // frozen ISA: a value and a node id are the same i32, and no relation code
  // separates them.  Asserting liveness converted legal frozen behaviour into
  // a refusal -- it made ev_query return IV_VIOLATION and made all 60
  // subsequent ev_teach calls refuse.
  //
  // This is the mirror failure of the nine defects: a validator whose
  // assertions are not sound is not a safety net, it is a new defect source.
  // The sound remainder is kept and is what actually carries the C502/C503
  // class here -- the edge table's own occupancy bookkeeping:
  //   (a) reported == stored          (the C503 shape, on the edge table)
  //   (b) dead sentinel is exactly -1 (one encoding of "empty", not several)
  //   (c) relation code is in the DECLARED relation domain
  // Node liveness of an endpoint is deliberately NOT asserted, because the
  // representation does not record which domain an endpoint is in.  Fixing
  // THAT is a separate substrate change (tagged edge endpoints), out of scope
  // here and recorded as the next experiment.
  let e:i32=0; let ec:i32=edgecap(W); let ne:i32=0;
  while(e<ec){
    let f:i32=eg(W,e,0);
    if(f!=-1){
      ne=ne+1;
      let t:i32=eg(W,e,8);
      if(f<-1 || t<-1){return 6;}
      if(rel_ok(eg(W,e,4))!=1){return 6;}
    }
    e=e+1;
  }
  if(ne!=hg(W,24)){return 5;}
  // 7/9: ISA operands and provenance domain
  let j:i32=2;
  while(j<nc){
    if(ng(W,j,36)==1){
      let p:i32=prov_get(W,j);
      if(p<PROV_NONE() || p>PROV_STRUCT()){return 9;}
      let t:i32=ng(W,j,0);
      if(t>=101 && t<=104){
        if(band_slot(ng(W,j,4))!=1){return 7;}
        if(t==101 || t==102){ if(opnd_bands(ng(W,j,8))!=1){return 7;} }
        if(t==102){
          if(opnd_bands(ng(W,j,12))!=1){return 7;}
          if(opnd_bands(ng(W,j,16))!=1){return 7;}
        }
      }
    }
    j=j+1;
  }
  // 10
  if(hg(W,28)>logcap(W)){return 10;}
  if(admit_get(W)!=MODE_IDLE() && admit_get(W)!=MODE_OBS() && admit_get(W)!=MODE_INFER()){return 3;}
  return 0;
}
fn SETCAP()i32 { return 128; }
fn CONFCAP()i32 { return 128; }
// diagnostics: one line, so a violation is never silent in a log either
fn iv_dump(W:[]u8)void {
  emit("IV nodecap="); e64(nodecap(W));
  emit(" edgecap="); e64(edgecap(W));
  emit(" logcap="); e64(logcap(W));
  emit(" live="); e64(hg(W,20));
  emit(" cap_refusals="); e64(ivL(W,R_CAPREFUSE()));
  emit(" malformed_ops="); e64(ivL(W,R_MALFORMED()));
  emit(" log_drops="); e64(ivL(W,R_LOGDROPS()));
  emit(" ans_set_refusals="); e64(ivL(W,R_ANSET()));
  emit(" superseded_miss="); e64(ivL(W,R_SUPERSEDED()));
  emit(" prov_downgrades="); e64(ivL(W,R_DOWNGRADE()));
  emit(" iv_violations="); e64(ivL(W,R_IVVIOL()));
  emit(" set_overflow="); e64(ivL(W,R_SETOVF()));
  emit(" check="); e64(iv_check(W));
  emit("\n");
  return;
}
// n1.zag -- a battery that can FAIL. Charter 79/81/158.
//
// Design, from PREREG section 4. Every expectation below is a LITERAL with the
// derivation written beside it, computed from the stimulus and the frozen
// contract and NOT from any engine run. No value in this file was obtained by
// executing the engine under test; that is the property that makes these
// assertions incapable of encoding the defect they are aimed at.
//
// Groups:
//   S1  NEGATIVE SPACE.  No evidence about (s,r) => the engine must return
//       NO_ANSWER and must leave ZERO fact nodes about s.  Derived: an answer
//       is licensed by a fact; with no fact there is nothing to license one.
//   S2  NO LAUNDERING, globally: after every operation in this battery, the set
//       of live fact nodes whose subject was never taught is empty.
//   S3  ORDER INVARIANCE (metamorphic M2): same fact set, permuted teaching
//       order => every answer identical.
//   S4  RENAME INVARIANCE (metamorphic M1): apply a bijection on entity ids;
//       every answer must be the image of the original.
//   S5  DISTRACTOR INVARIANCE (metamorphic M3): insert facts about unrelated
//       subjects => every answer unchanged.
//   S6  INDEPENDENT ORACLE: count distinct objects by brute force over the
//       test's OWN array, not by scanning the engine's node table, and compare
//       with ev_query_set. The frozen implementation is not ground truth.
//   S7  THE SELF-CHECK IS LIVE: deliberately corrupt the occupancy record and
//       require iv_check to REFUSE. A validator that cannot be made to fail is
//       decoration, and decoration is what C502..C509 all lacked.
//   S8  REFUSAL DISTINCTNESS: the six refusal codes are pairwise distinct and
//       none of them is a value the engine may legitimately return.
//   S9  PROVENANCE: a taught fact is PROV_OBS; a derived answer never is.
//
// Output discipline (brief 4.0/10.1): _zag_print only; the driver asserts the
// flushed byte count is non-zero, so an empty log is a PROCESS FAILURE.
fn tpass(n:[]u8)void { emit(n); emit(" PASS\n"); return; }
fn tfail(n:[]u8)void { emit(n); emit(" FAIL\n"); return; }
fn nfail(n:[]u8,d:[]u8)void { emit(n); emit(" FAIL: "); emit(d); emit("\n"); return; }

// ---------------------------------------------------------------- helpers --
fn nw()[]u8 { let W:[]u8=z_alloc(110656); tnn2_init(W); return W; }
// count live fact nodes (type 1) whose subject is s.  Uses the arena, NOT the
// engine's own accessor, so a broken fact_distinct cannot hide here.
fn raw_facts_about(W:[]u8,s:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s){ c=c+1; }
    n=n+1;
  }
  return c;
}
fn taught_subject(W:[]u8,s:i32)i32 {
  let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && prov_get(W,n)==PROV_OBS() && ng(W,n,20)==s){ return 1; }
    n=n+1;
  }
  return 0;
}
// ---------------------------------------------------------- S1 NEGATIVE SPACE
// World: 6 subjects 100..105 each hold relation 7 -> object 80.  Subjects 900..
// 909 and relation 8 are NEVER taught.  The contract says a query with no
// evidence about (s,r) returns NO_ANSWER (-2).  There is no reading of the
// frozen contract under which a subject nobody taught has an answer, so 80 is
// not a defensible expectation here -- which is exactly what C11 asserted.
fn t_s1_negative()i32 {
  let W:[]u8=nw();
  let i:i32=0;
  while(i<6){ ev_teach(W,100+i,7,80); i=i+1; }
  let bad:i32=0; i=0;
  while(i<10){
    let v:i32=ev_query(W,900+i,7,-2,0);
    if(v!=NO_ANSWER()){ bad=bad+1; }
    // and nothing may be written down about it, ever
    if(raw_facts_about(W,900+i)!=0){ bad=bad+1; }
    i=i+1;
  }
  // a second pass: the laundering shape is served by the exact-hit path on the
  // SECOND query.  Both must refuse and both must leave nothing behind.
  i=0;
  while(i<10){
    let v:i32=ev_query(W,900+i,7,-2,0);
    if(v!=NO_ANSWER()){ bad=bad+1; }
    if(raw_facts_about(W,900+i)!=0){ bad=bad+1; }
    i=i+1;
  }
  // control: the taught subjects must still answer, or the test is vacuous
  i=0;
  while(i<6){
    if(ev_query(W,100+i,7,-2,0)!=80){ bad=bad+1; }
    i=i+1;
  }
  if(bad!=0){ nfail("S1-NEGSPACE","bad="); e64(bad); return 0; }
  return 1;
}
// -------------------------------------------------- S2 NO LAUNDERING GLOBALLY
// After the entire battery has run, no subject that was never taught may own a
// live fact node.  This is a POSTCONDITION on the engine, not on one call, so a
// rule that launders is caught wherever it sits.
fn s2_scan(W:[]u8)i32 {
  let bad:i32=0; let n:i32=2;
  // TYPE 1 ONLY.  A miss legitimately writes an UNCERTAINTY node (type 30)
  // carrying the subject it does not know about; that is an admission of
  // ignorance, not a fact.  Scanning all live node types flags it and the test
  // fails on correct behaviour -- which is what happened on my first run.
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let s:i32=ng(W,n,20);
      if(s>=900 && s<1000){ bad=bad+1; }
      if(s>=4000 && s<5000){ bad=bad+1; }
    }
    n=n+1;
  }
  return bad;
}
fn t_s2_nolaunder()i32 {
  let W:[]u8=nw();
  let i:i32=0;
  while(i<6){ ev_teach(W,100+i,7,80); i=i+1; }
  // relation-only evidence about OTHER subjects, then ask about 900
  while(i<12){ ev_teach(W,100+i-6,7,80); i=i+1; }
  while(i<24){
    let v:i32=ev_query(W,900,-2,NO_ANSWER(),0);
    if(v!=NO_ANSWER()){ return 0; }
    i=i+1;
  }
  let bad:i32=s2_scan(W);
  if(bad!=0){ nfail("S2-NOLAUNDER","bad="); e64(bad); return 0; }
  return 1;
}
// ------------------------------------------------------- S3 ORDER INVARIANCE
// Metamorphic. Six independent chains s->s+1 with relation 11.  Build world A
// in one teaching order and world B in the reverse order.  Contract: an answer
// is a function of the FACT SET.  Therefore every answer must be equal.  No
// expected VALUE is asserted at all -- the property is the assertion, so there
// is nothing here that a run of the engine could have supplied.
fn t_s3_order()i32 {
  let A:[]u8=nw(); let B:[]u8=nw();
  let i:i32=0;
  while(i<6){ ev_teach(A,200+i,11,300+i); i=i+1; }
  i=5;
  while(i>=0){ ev_teach(B,200+i,11,300+i); i=i-1; }
  let bad:i32=0; i=0;
  while(i<6){
    let x:i32=ev_query(A,200+i,11,-2,0);
    let y:i32=ev_query(B,200+i,11,-2,0);
    if(x!=y){ bad=bad+1; }
    i=i+1;
  }
  // and the composed answer must be the terminal value, identical in both
  let x2:i32=ev_query(A,200,40,-2,0);
  let y2:i32=ev_query(B,200,40,-2,0);
  if(x2!=y2){ bad=bad+1; }
  if(bad!=0){ nfail("S3-ORDER","disagree="); e64(bad); return 0; }
  return 1;
}
// --------------------------------------------------------- S4 RENAME INVARIANCE
// Metamorphic. pi(s) = s*7+13 is a bijection on the ids used here.  Build the
// same world twice, once with ids and once with their images, and require the
// answers to be the images of one another.
fn t_s4_rename()i32 {
  let A:[]u8=nw(); let B:[]u8=nw();
  let i:i32=0;
  while(i<5){
    ev_teach(A,500+i,21,700+i);
    ev_teach(B,(500+i)*7+13,21,(700+i)*7+13);
    i=i+1;
  }
  let bad:i32=0; i=0;
  while(i<5){
    let x:i32=ev_query(A,500+i,21,-2,0);
    let y:i32=ev_query(B,(500+i)*7+13,21,-2,0);
    if(x!=(y-13)/7){ bad=bad+1; }
    i=i+1;
  }
  // a query that must refuse must refuse under the rename too
  let x2:i32=ev_query(A,999,21,-2,0);
  let y2:i32=ev_query(B,999*7+13,21,-2,0);
  if(x2!=NO_ANSWER() || y2!=NO_ANSWER()){ bad=bad+1; }
  if(bad!=0){ nfail("S4-RENAME","bad="); e64(bad); return 0; }
  return 1;
}
// ----------------------------------------------------- S5 DISTRACTOR INVARIANCE
// Metamorphic. 40 irrelevant facts about subjects 600..639 that are not on any
// path from the query subject.  Answers about 500..504 must not move.
fn t_s5_distract()i32 {
  let A:[]u8=nw(); let B:[]u8=nw();
  let i:i32=0;
  while(i<5){ ev_teach(A,500+i,21,700+i); ev_teach(B,500+i,21,700+i); i=i+1; }
  i=0;
  while(i<40){ ev_teach(B,600+i,22,9000+i); i=i+1; }
  let bad:i32=0; i=0;
  while(i<5){
    if(ev_query(A,500+i,21,-2,0)!=ev_query(B,500+i,21,-2,0)){ bad=bad+1; }
    i=i+1;
  }
  // A relation that exists ONLY among the distractors must refuse in A (no
  // evidence) and answer in B (evidence exists).  My first version asserted
  // that BOTH refuse, which is false and was caught by running it against the
  // CLEAN engine -- a spec-derived battery has to be able to catch its author.
  if(ev_query(A,600,22,-2,0)!=NO_ANSWER()){ bad=bad+1; }
  if(ev_query(B,600,22,-2,0)!=9000){ bad=bad+1; }
  if(bad!=0){ nfail("S5-DISTRACT","bad="); e64(bad); return 0; }
  return 1;
}
// --------------------------------------------------------- S6 THE ORACLE
// Independent count. The test keeps its OWN flat array of taught triples and
// counts distinct objects by brute force with an O(n^2) scan; it never asks the
// engine how many there are.  Then it compares that count with the engine's
// set accessor.  A disagreement is a finding, not a tie to be broken by rank.
fn t_s6_oracle()i32 {
  let W:[]u8=nw();
  let S:[]u8=z_alloc(64*4); let R:[]u8=z_alloc(64*4); let O:[]u8=z_alloc(64*4);
  let ns:i32=0; let i:i32=0;
  while(i<12){
    // subject i%4, relation 31, objects with deliberate duplicates
    let s:i32=i%4; let r:i32=31; let o:i32=(i/4)*10+(i%3);
    let j:i32=0; let dup:i32=0;
    while(j<ns){ if(get32(S,j*4)==s && get32(R,j*4)==r && get32(O,j*4)==o){ dup=1; } j=j+1; }
    if(dup==0){ set32(S,ns*4,s); set32(R,ns*4,r); set32(O,ns*4,o); ns=ns+1; }
    ev_teach(W,4000+s,r,o);
    i=i+1;
  }
  // brute-force distinct-object count per subject, from the test's own array
  let bad:i32=0; let s2:i32=0;
  while(s2<4){
    let cnt:i32=0; let k:i32=0;
    while(k<ns){
      if(get32(S,k*4)==s2 && get32(R,k*4)==31){
        let o2:i32=get32(O,k*4);
        let seen:i32=0; let m:i32=0;
        while(m<k){ if(get32(S,m*4)==s2 && get32(R,m*4)==31 && get32(O,m*4)==o2){ seen=1; } m=m+1; }
        if(seen==0){ cnt=cnt+1; }
      }
      k=k+1;
    }
    let ob:[]u8=z_alloc(SETCAP()*4);
    let got:i32=ev_query_set(W,4000+s2,31,ob);
    if(got!=cnt){ bad=bad+1; }
    // and the set must be SORTED, because it is a set and order is not content
    let t:i32=1;
    while(t<got){ if(get32(ob,(t-1)*4)>get32(ob,t*4)){ bad=bad+1; } t=t+1; }
    s2=s2+1;
  }
  if(bad!=0){ nfail("S6-ORACLE","bad="); e64(bad); return 0; }
  return 1;
}
// ------------------------------------------- S7 THE SELF-CHECK IS LIVE
// The single most important new site.  Every one of C502..C509 got worse
// because nothing was checking.  So: corrupt the arena's own occupancy record
// (hs(W,20) is the live-node counter) and REQUIRE the validator to notice.
// If it does not, the engine's refusals are luck, not checking.
fn t_s7_selfcheck()i32 {
  let W:[]u8=nw();
  let i:i32=0;
  while(i<20){ ev_teach(W,4500+i,41,50+i); i=i+1; }
  let clean:i32=iv_check(W);
  if(clean!=0){ nfail("S7-SELFCHECK","clean arena rejected"); return 0; }
  // lie about the occupancy: claim 900 live nodes where there are ~22
  hs(W,20,900);
  let caught:i32=iv_check(W);
  hs(W,20,22);
  if(caught==0){ nfail("S7-SELFCHECK","corrupt arena ACCEPTED -- validator is decoration"); return 0; }
  // and the counter must be reported, not just the boolean
  if(ivL(W,R_IVVIOL())<0){ return 0; }
  return 1;
}
// ------------------------------------------------- S8 REFUSAL DISTINCTNESS
// Six codes, six meanings.  P3: "a refusal is never the same value as an
// answer, an ignorance, a malformed operand or an invariant violation".
// Hand-derived: they must be pairwise unequal, and all six are negative, so
// none of them can collide with an answer, which is a live value.
fn t_s8_refusals()i32 {
  let c:[]u8=z_alloc(24);
  set32(c,0,MALFORMED_OP()); set32(c,4,GUARD_REJECT());
  set32(c,8,CAP_REFUSED());   set32(c,12,NO_ANSWER());
  set32(c,16,ANS_SET());      set32(c,20,IV_VIOLATION());
  let bad:i32=0; let i:i32=0;
  while(i<6){
    if(get32(c,i*4)>=0){ bad=bad+1; }
    let j:i32=i+1;
    while(j<6){ if(get32(c,i*4)==get32(c,j*4)){ bad=bad+1; } j=j+1; }
    i=i+1;
  }
  // and a refusal must never be served as an answer
  let W:[]u8=nw();
  if(ev_query(W,4700,42,-2,0)!=NO_ANSWER()){ bad=bad+1; }
  if(raw_facts_about(W,4700)!=0){ bad=bad+1; }
  if(bad!=0){ nfail("S8-REFUSALS","bad="); e64(bad); return 0; }
  return 1;
}
// --------------------------------------------------------- S9 PROVENANCE
// M4: inference may never write PROV_OBSERVED, because a laundered answer is
// then served by the exact-hit path as though it were world content.  Derived
// from the contract, checkable directly: every PROV_OBS node must be reachable
// from an ev_teach, and a promoted derived answer must not be one.
fn t_s9_provenance()i32 {
  let W:[]u8=nw();
  let i:i32=0;
  while(i<4){ ev_teach(W,101,11,102); i=i+1; }
  ev_teach(W,102,11,201);
  // promote a derived answer for (101,40)
  let a:i32=ev_query(W,101,40,201,0);
  if(a!=201){ nfail("S9-PROV","chain did not compose"); return 0; }
  let bad:i32=0;
  // every node carrying (101,40) must NOT be tagged as observed
  let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==101 && ng(W,n,24)==40){
      if(prov_get(W,n)==PROV_OBS()){ bad=bad+1; }
    }
    n=n+1;
  }
  // the taught facts must still be tagged observed, or the tag means nothing
  n=2; let seen:i32=0;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && prov_get(W,n)==PROV_OBS() && taught_subject(W,ng(W,n,20))==1){ seen=seen+1; }
    n=n+1;
  }
  if(seen<5){ bad=bad+1; }
  if(bad!=0){ nfail("S9-PROV","bad="); e64(bad); return 0; }
  return 1;
}

// ============ S10..S13: the four properties the first N1 draft was missing ===
// N1 v1 caught 4 of 8 mutants and MISSED M2, M3, M5, M6.  Inspecting why: for
// each of those four, v1 asserted NO PROPERTY THAT COULD FAIL on that axis.  A
// battery is not a list of values, it is a list of properties, and a property
// nobody wrote is a defect nobody can catch.  These four are that list.

// ---- S10 SET REPRESENTATION (kills M5 / C509) ----
// A star: subject 101 holds relation 31 with FOUR distinct objects, so the set of
// answers is {11,22,33,44}.  There is no defensible single i32 answer, so the
// scalar accessor must REFUSE with ANS_SET (-3); and the set accessor must
// return exactly 4, sorted ascending.  Both numbers are arithmetic on the
// stimulus: four facts taught, four distinct objects, ascending because
// 11<22<33<44.  Nothing here can be copied from an engine run.
fn t_s10_setrep()i32 {
  let W:[]u8=nw();
  ev_teach(W,101,31,11); ev_teach(W,101,31,22);
  ev_teach(W,101,31,33); ev_teach(W,101,31,44);
  let bad:i32=0;
  if(ev_query(W,101,31,-2,0)!=ANS_SET()){ bad=bad+1; }
  // it must refuse on the SECOND query too: a refusal that is laundered into an
  // answer on the next call is the C504 shape wearing a different hat
  if(ev_query(W,101,31,-2,0)!=ANS_SET()){ bad=bad+1; }
  let ob:[]u8=z_alloc(SETCAP()*4);
  let n:i32=ev_query_set(W,101,31,ob);
  if(n!=4){ bad=bad+1; }
  else {
    if(get32(ob,0)!=11){bad=bad+1;}
    if(get32(ob,4)!=22){bad=bad+1;}
    if(get32(ob,8)!=33){bad=bad+1;}
    if(get32(ob,12)!=44){bad=bad+1;}
  }
  // control: a SINGLETON must still be served, or the test proves nothing
  let W2:[]u8=nw();
  ev_teach(W2,101,31,11);
  if(ev_query(W2,101,31,-2,0)!=11){ bad=bad+1; }
  if(bad!=0){ nfail("S10-SETREP","bad="); e64(bad); return 0; }
  return 1;
}
// ---- S11 EVICTION IS A FUNCTION OF CONTENT, NOT OF ORDER (kills M2 / C508) ----
// Metamorphic on the retention policy.  Two arenas hold the SAME 60 facts --
// same subjects, relations and objects -- taught in opposite orders, so every
// allocation index differs.  Evict five from each.  The contract says the victim
// is chosen by content (ev_cmp over provenance, type, content, bid); if it were
// chosen by a rotation cursor, or if recency were insertion order, the two
// arenas would lose DIFFERENT facts.  The property IS the assertion: there is
// no expected triple anywhere in this function.
fn snap(W:[]u8,out:[]u8)void {
  let c:i32=0; let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1){
      let s:i32=ng(W,n,20); let r:i32=ng(W,n,24); let o:i32=ng(W,n,28);
      set32(out,c*4,(s*1000+r)*1000+o); c=c+1;
    }
    n=n+1;
  }
  set32(out,250*4,c);
  return;
}
fn t_s11_evictinv()i32 {
  let A:[]u8=nw(); let B:[]u8=nw();
  // 60 observed facts + 60 structural cells in each arena.  The cells exist so
  // there is SOMETHING evictable: evict_node is right to refuse to reclaim an
  // observed fact, so a world of facts alone has no victims and the test would
  // be vacuous.  Each cell carries content (s,r,o) so a content-derived policy
  // has something to derive an order from.  A is built forward and B backward,
  // so "lowest id" and "lowest content" are ANTI-correlated in B.  That is what
  // gives the property the power to fail.
  let i:i32=0;
  while(i<60){
    ev_teach(A,600+i,31,100+i);
    let ca:i32=alloc_raw(A); ns(A,ca,0,2); write_node(A,ca,600+i,32,200+i,0);
    i=i+1;
  }
  i=59;
  while(i>=0){
    ev_teach(B,600+i,31,100+i);
    let cb:i32=alloc_raw(B); ns(B,cb,0,2); write_node(B,cb,600+i,32,200+i,0);
    i=i-1;
  }
  let sa:[]u8=z_alloc(300*4); let sb:[]u8=z_alloc(300*4);
  snap(A,sa); snap(B,sb);
  if(get32(sa,250*4)!=get32(sb,250*4)){ nfail("S11-EVICT","setup counts differ"); return 0; }
  if(get32(sa,250*4)<100){ nfail("S11-EVICT","setup too small "); e64(get32(sa,250*4)); return 0; }
  let j:i32=0;
  while(j<5){
    // S11b.  A probe showed the occupancy record does NOT fall when a node is
    // freed, and that is CORRECT: rec_evict() allocates a HISTORY record into
    // the slot the victim vacates.  So live_alloc must be UNCHANGED (no
    // capacity leak) while the count of live FACT nodes must FALL.  My first
    // version asserted live_alloc falls by one and the CLEAN engine rejected
    // it, which is the right outcome for a property that was wrong.
    let l0:i32=live_alloc(A);
    let f0:i32=count_cells(A);
    if(evict_node(A)<0){ nfail("S11-EVICT","A refused"); return 0; }
    if(live_alloc(A)!=l0){ nfail("S11-EVICT-LEAK"," occupancy "); e64(l0); emit("->"); e64(live_alloc(A)); return 0; }
    if(count_cells(A)>=f0){ nfail("S11-EVICT-NOEFFECT"," cells "); e64(f0); emit("->"); e64(count_cells(A)); return 0; }
    if(evict_node(B)<0){ nfail("S11-EVICT","B refused"); return 0; }
    j=j+1;
  }
  snap(A,sa); snap(B,sb);
  let ca:i32=get32(sa,250*4); let cb:i32=get32(sb,250*4);
  if(ca!=cb){ nfail("S11-EVICT","live counts differ"); return 0; }
  let d:i32=0; i=0;
  while(i<ca){
    let k:i32=0; let f:i32=0;
    while(k<cb){ if(get32(sb,k*4)==get32(sa,i*4)){ f=1; } k=k+1; }
    if(f==0){ d=d+1; }
    i=i+1;
  }
  i=0;
  while(i<cb){
    let k:i32=0; let f:i32=0;
    while(k<ca){ if(get32(sa,k*4)==get32(sb,i*4)){ f=1; } k=k+1; }
    if(f==0){ d=d+1; }
    i=i+1;
  }
  if(d!=0){ nfail("S11-EVICT","eviction order-dependent, d="); e64(d); return 0; }
  return 1;
}
// ---- S12 A HIGH NODE ID IS A NODE, NOT A SLOT (kills M3 / C505 / B1) ----
// C505's counterexample, stated as an invariant instead of a defect.  Build a
// SETREG whose SOURCE OPERAND is a literal node, and force that node's id into
// the band 1000..1003 -- the band the frozen magnitude rule handed to the frame.
// Contract: an operand carries its domain in its encoding, so a node id of 1002
// must decode as a node and yield 42.  The 42 is written into the literal by
// THIS test; the engine is never asked what it is.
fn t_s12_highid()i32 {
  let W:[]u8=nw();
  let lit:i32=-1; let n:i32=0;
  while(lit<0 && n<1010){
    let x:i32=alloc_raw(W);
    if(x>=1000 && x<1004){ lit=x; }
    n=n+1;
  }
  if(lit<0){ nfail("S12-HIGHID","could not reach the aliased band"); return 0; }
  ns(W,lit,0,1); write_node(W,lit,42,0,0,0);
  let root:i32=alloc_raw(W);
  ns(W,root,0,101); ns(W,root,4,opnd_slot(0)); ns(W,root,8,lit);
  let fr:i32=alloc_raw(W);
  ns(W,fr,0,902);
  let v:i32=exec_val(W,root,fr);
  if(v!=42){ nfail("S12-HIGHID","literal node id "); e64(lit); emit(" decoded as "); e64(v); emit("\n"); return 0; }
  // and the reverse direction: a SLOT operand must not be readable as a node
  let W2:[]u8=nw();
  let r2:i32=alloc_raw(W2);
  ns(W2,r2,0,101); ns(W2,r2,4,opnd_slot(0)); ns(W2,r2,8,opnd_slot(1));
  let f2:i32=alloc_raw(W2);
  ns(W2,f2,0,902);
  if(exec_val(W2,r2,f2)!=0){ nfail("S12-HIGHID","slot read as node"); return 0; }
  return 1;
}
// ---- S13 A CONTRADICTED FACT IS NOT IN THE SET (kills M6 / C503 shape) ----
// Teach (101,31,5).  Observe (101,31,7): the engine must record a CONTRADICTION,
// the old fact stops being knowledge, and the set of live answers for (101,31)
// is therefore exactly {7}.  Count 1, value 7, nothing else.  The number is
// arithmetic: two facts taught, one contradicted, one surviving.  Reported ==
// stored: the accessor must not publish the dead one.
fn t_s13_superseded()i32 {
  let W:[]u8=nw();
  ev_teach(W,101,31,5);
  if(ev_observe(W,101,31,7)!=0){ nfail("S13-SUPERSEDED","no contradiction recorded"); return 0; }
  let ob:[]u8=z_alloc(SETCAP()*4);
  let n:i32=ev_query_set(W,101,31,ob);
  if(n!=1){ nfail("S13-SUPERSEDED","set size "); e64(n); emit(" want 1\n"); return 0; }
  if(get32(ob,0)!=7){ nfail("S13-SUPERSEDED","set value"); return 0; }
  if(ev_query(W,101,31,-2,0)!=7){ nfail("S13-SUPERSEDED","scalar disagrees with set"); return 0; }
  // raw check, independent of every accessor in the engine
  if(raw_facts_about(W,101)!=2){ nfail("S13-SUPERSEDED","raw count"); return 0; }
  return 1;
}
// live nodes of type 1 (facts).  Counted by scanning the arena, not by asking
// the engine, so a broken accessor cannot hide a leak.
fn count_facts(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){ c=c+1; }
    n=n+1;
  }
  return c;
}
// live nodes of type 2 (the structural cells that are the eviction candidates).
// The count of live FACT nodes must NOT fall: evict_node is right to refuse to
// reclaim an observed fact, so asserting that it does is asserting a defect.
fn count_cells(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<nodecap(W)){
    if(ng(W,n,36)==1 && ng(W,n,0)==2){ c=c+1; }
    n=n+1;
  }
  return c;
}

// ================================================================== driver ==
fn run_all()i32 {
  let pass:i32=0; let total:i32=0;
  total=total+1; if(t_s1_negative()==1){pass=pass+1; tpass("S1-NEGSPACE");} else {tfail("S1-NEGSPACE");}
  total=total+1; if(t_s2_nolaunder()==1){pass=pass+1; tpass("S2-NOLAUNDER");} else {tfail("S2-NOLAUNDER");}
  total=total+1; if(t_s3_order()==1){pass=pass+1; tpass("S3-ORDER");} else {tfail("S3-ORDER");}
  total=total+1; if(t_s4_rename()==1){pass=pass+1; tpass("S4-RENAME");} else {tfail("S4-RENAME");}
  total=total+1; if(t_s5_distract()==1){pass=pass+1; tpass("S5-DISTRACT");} else {tfail("S5-DISTRACT");}
  total=total+1; if(t_s6_oracle()==1){pass=pass+1; tpass("S6-ORACLE");} else {tfail("S6-ORACLE");}
  total=total+1; if(t_s7_selfcheck()==1){pass=pass+1; tpass("S7-SELFCHECK");} else {tfail("S7-SELFCHECK");}
  total=total+1; if(t_s8_refusals()==1){pass=pass+1; tpass("S8-REFUSALS");} else {tfail("S8-REFUSALS");}
  total=total+1; if(t_s9_provenance()==1){pass=pass+1; tpass("S9-PROV");} else {tfail("S9-PROV");}
  total=total+1; if(t_s10_setrep()==1){pass=pass+1; tpass("S10-SETREP");} else {tfail("S10-SETREP");}
  total=total+1; if(t_s11_evictinv()==1){pass=pass+1; tpass("S11-EVICT");} else {tfail("S11-EVICT");}
  total=total+1; if(t_s12_highid()==1){pass=pass+1; tpass("S12-HIGHID");} else {tfail("S12-HIGHID");}
  total=total+1; if(t_s13_superseded()==1){pass=pass+1; tpass("S13-SUPERSEDED");} else {tfail("S13-SUPERSEDED");}
  emit("N1TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
fn main()i32 {
  let rc:i32=run_all();
  if(rc==0){ emit("N1_ALL_PASS\n"); } else { emit("N1_HAS_FAILURES\n"); }
  return rc;
}

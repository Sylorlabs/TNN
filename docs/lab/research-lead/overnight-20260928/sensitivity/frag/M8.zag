// M8 (MINE) == LAUNDERING ISOLATED FROM BEING WRONG.  The inference itself is
// unchanged: the graph is verified, the value is correct, everything the engine
// concludes is true.  The single mutation is that the promoted answer is written
// into the fact table as PROV_OBS -- the provenance of a TAUGHT fact -- so from
// the next query on it is indistinguishable from world content and no longer
// carries the DEP edges that say it was derived.  This isolates the laundering
// mechanism from the subject-blind-scan mechanism (M1) that carried it in C504.
fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  prov_set(W,m,PROV_INFER());
  write_node(W,m,root,hg(W,24),ans,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  let f:i32=ev_teach_in(W,s,r,ans);
  prov_set(W,f,PROV_OBS());
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  return m;
}

// M6 (MINE) == the C503 SHAPE relocated to the TNN-2 core: the SET accessor and
// the SCALAR accessor read two different sets.  ev_query_set counts facts about
// (s,r) INCLUDING superseded ones, while ev_query's fact_distinct excludes
// them.  Reported != stored: the engine publishes a set it does not hold.
fn ev_query_set(W:[]u8,s:i32,r:i32,out:[]u8)i32 {
  let cap:i32=out.len/4;
  let nc:i32=nodecap(W);
  let n:i32=0; let i:i32=2;
  while(i<nc){
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && ng(W,i,20)==s && ng(W,i,24)==r){
      if(n>=cap){ t2_bump(W,R_SETOVF()); return -1; }
      set32(out,n*4,ng(W,i,28)); n=n+1;
    }
    i=i+1;
  }
  return n;
}

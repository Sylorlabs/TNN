// M1b == C504, PART 2: the CALL SITE. The fix tombstoned the rule's body AND
// removed its call site; reinstating the rule is not enough, the engine must
// consult it again. This is ev_query verbatim except that the subject-blind
// bootstrap is consulted BEFORE the honest inquiry path.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  if(iv_check(W)!=0){ t2_bump(W,R_IVVIOL()); return IV_VIOLATION(); }
  let ob:[]u8=z_alloc(SETCAP()*4);
  let n:i32=fact_distinct(W,s,r,ob,SETCAP());
  if(n==CAP_REFUSED()){ t2_bump(W,R_ANSET()); log_ev(W,2,s,r,ANS_SET(),0,0,0); return ANS_SET(); }
  if(n==1){
    let node:i32=activate(W,s,r);
    if(node>=0){ link_edge(W,node,6,node,0); ref_prot(W,node); }
    log_ev(W,2,s,r,get32(ob,0),1,0,0); return get32(ob,0);
  }
  if(n>1){
    t2_bump(W,R_ANSET());
    log_ev(W,2,s,r,ANS_SET(),0,0,0);
    return ANS_SET();
  }
  let recent:i32=-1; let m:i32=2;
  while(m<nodecap(W)){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=NO_ANSWER()){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=NO_ANSWER()){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,NO_ANSWER(),0,0,0);
  miss_inquire(W,s,r);
  return NO_ANSWER();
}

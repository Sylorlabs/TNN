// M1 == C504 REINTRODUCED (subject-blind inference + provenance laundering)
// Single mutation. bootstrap_miss is UN-tombstoned: the evidence set is a
// projection that EXCLUDES the queried subject, it is a RECENCY PREFIX of
// allocation order, and the conclusion is PERSISTED with PROV_OBS so the exact
// hit path serves it thereafter.
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=nodecap(W)-1;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && prov_get(W,n)==PROV_OBS() && ng(W,n,24)==r){
      set32(ex_o,cnt*4,ng(W,n,28)); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return NO_ANSWER();}
  let v0:i32=get32(ex_o,0); let inv:i32=1; let i:i32=1;
  while(i<cnt){if(get32(ex_o,i*4)!=v0){inv=0;} i=i+1;}
  if(inv==1){
    let k:i32=k_get(W);
    if(cnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        let hn:i32=fact_admit(W,s,r,v0,PROV_OBS());
        return v0;
      }
    }
  }
  return NO_ANSWER();
}

// M3 == C505 / B1 REINTRODUCED: the tagged bands are ALIASED again.  A frame-slot
// operand is now claimed at BOTH encodings -- 1048576+k and 1000+k -- which is
// exactly the frozen "dispatch on magnitude" rule in the one place it matters:
// every literal NODE whose id falls in 1000..1003 is silently reinterpreted as a
// frame slot.  Single mutation: one extra clause.
fn band_slot(op:i32)i32 {
  if(op>=1000 && op<1048576){ return 1; }
  if(op<1048576){ return 0; }
  if(op-1048576>=4){ return 0; }
  return 1;
}

// cp.zag -- Clopper-Pearson exact binomial intervals. Pure Zag.
// All statistics in i64 fixed point, SCALE = 1e8 (resolution 1e-8). No floats.
//
// Prereg kill condition: the CDF must reproduce FOUR closed forms before any
// interval is reported. If it does not, the program prints CP-NOT-VALIDATED and
// reports nothing.
//
// Overflow audit for the PMF walk: u <= 1e6 (units of 1e-6 SC), num = (n-k)*p
// <= 46*1e8 = 4.6e9, so u*num <= 4.6e15 << 9.2e18 (i64 max). Safe for n <= 46.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn pl(v:i64)void { _zag_print(_zag_i64_to_str(v)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn SC()i64 { return 100000000; }
// The mode: the FIRST k with w_{k+1} <= w_k.  Returning k (not k+1) is what
// makes every outward ratio <= 1; returning k+1 walks down from a point that is
// not a maximum and the ratio exceeds 1.  My first version returned k+1 and
// every lower bound came out 0.00 -- caught by the self-check, not by me.
fn mode(n:i32,pp:i64)i32 {
  let k:i32=0;
  while(k<n){
    let l:i64=(n-k) as i64;
    let m:i64=(k+1) as i64;
    if(l*pp<=m*(SC()-pp)){ return k; }
    k=k+1;
  }
  return n;
}
// P(X<=x | n,p), by a walk outward from the mode.  Away from the mode every
// ratio is <= 1, so no term grows; underflow of a distant term to 0 is exactly
// the correct statement that its contribution is below 1e-8 of SCALE.
fn ple(n:i32,pp:i64,x:i32)i64 {
  if(x<0){return 0;}
  if(x>=n){return SC();}
  let m:i32=mode(n,pp);
  let u:[]u8=z_alloc(256*4);
  set32(u,m*4,1000000);
  let tot:i64=1000000;
  let k:i32=m;
  while(k<n){
    let cur:i64=get32(u,k*4) as i64;
    let num:i64=(n-k) as i64*pp;
    let den:i64=(k+1) as i64*(SC()-pp);
    let nxt:i64=0;
    if(cur>0 && den>0){ nxt=cur*num/den; }
    if(nxt<1){nxt=1;}
    set32(u,(k+1)*4,nxt as i32);
    tot=tot+nxt;
    k=k+1;
  }
  k=m;
  while(k>0){
    let cur:i64=get32(u,k*4) as i64;
    let num:i64=k as i64*(SC()-pp);
    let den:i64=(n-k+1) as i64*pp;
    let nxt:i64=0;
    if(cur>0 && den>0){ nxt=cur*num/den; }
    if(nxt<1){nxt=1;}
    set32(u,(k-1)*4,nxt as i32);
    tot=tot+nxt;
    k=k-1;
  }
  let acc:i64=0;
  k=0;
  while(k<=x){
    let w:i64=get32(u,k*4) as i64;
    acc=acc+w;
    k=k+1;
  }
  return acc*SC()/tot;
}
// ---- Clopper-Pearson by bisection on a monotone function ------------------
// upper = sup{ p : P(X<=k|n,p) >= alpha/2 }.  That function DECREASES in p, so
// the bracket is (0, p*] and a hit means the answer is at or above mid.
// For k=0 this reduces to 1-(alpha/2)^(1/n), the textbook bound.
fn cpu(n:i32,k:i32,a2:i64)i64 {
  let lo:i64=0; let hi:i64=SC(); let it:i32=0;
  while(it<300){
    let mid:i64=(lo+hi)/2;
    if(ple(n,mid,k)>=a2){ lo=mid; } else { hi=mid; }
    it=it+1;
  }
  return lo;
}
// lower = inf{ p : P(X<=k-1|n,p) >= 1-alpha/2 } = inf{ p : P(X>=k|n,p) <= alpha/2 }
fn cpl(n:i32,k:i32,a2:i64)i64 {
  if(k<=0){return 0;}
  let lo:i64=0; let hi:i64=SC(); let it:i32=0;
  while(it<300){
    let mid:i64=(lo+hi)/2;
    if(ple(n,mid,k-1)>=SC()-a2){ lo=mid; } else { hi=mid; }
    it=it+1;
  }
  return lo;
}
// print a value in 1e-8 units as a percentage with 2 decimals
fn ppct(v:i64)void {
  let h:i64=v/1000000;
  let r:i64=v-h*1000000;
  let d:i64=r/10000;
  pl(h); emit("."); pl(d/10); pl(d-((d/10)*10));
  return;
}
fn row(name:[]u8,n:i32,k:i32)void {
  let a2:i64=SC()*25/1000;
  let L:i64=cpl(n,k,a2);
  let U:i64=cpu(n,k,a2);
  emit(name);
  emit(" k="); pl(k as i64); emit("/"); pl(n as i64);
  emit("  point="); ppct(k as i64*SC()/n); emit("%");
  emit("  CP95=["); ppct(L); emit(", "); ppct(U); emit("]\n");
  return;
}
fn main()i32 {
  emit("CP-SELFCHECK against 4 closed forms (tol 2e-8)\n");
  let bad:i32=0;
  // n=3 p=0.8, P(X<=1) = P(0)+P(1) = .2^3 + 3*.8*.2^2 = .008+.096 = .104
  // NOTE: my first version of this line wrote SC()-ple(3,p,2), which is
  // P(X>=3)=.512, and the self-check correctly rejected it.  The routine was
  // right and the CHECK was wrong.  Recorded because it is the only time in
  // this lane that the guard caught me rather than the other way round.
  let c1:i64=ple(3,80000000,1);
  emit("  n=3  p=0.8 P(X<=1) = "); ppct(c1); emit("%   closed form 10.40%\n");
  if(c1<10399990 || c1>10400010){bad=bad+1;}
  // n=3 p=0.8, P(X<=0) = .2^3 = .008
  let v2:i64=ple(3,80000000,0);
  emit("  n=3  p=0.8 P(X<=0) = "); ppct(v2); emit("%    closed form 0.80%\n");
  if(v2<799990 || v2>800010){bad=bad+1;}
  // n=5 p=0.8, P(X<=2) = .2^5+5*.8*.2^4+10*.64*.2^3 = .00032+.0064+.0512=.05792
  let v3:i64=ple(5,80000000,2);
  emit("  n=5  p=0.8 P(X<=2) = "); ppct(v3); emit("%    closed form 5.79%\n");
  if(v3<5791900 || v3>5792100){bad=bad+1;}
  // n=10 p=0.5, P(X<=3) = 176/1024 = .171875
  let v4:i64=ple(10,50000000,3);
  emit("  n=10 p=0.5 P(X<=3) = "); ppct(v4); emit("%    closed form 17.19%\n");
  if(v4<17187000 || v4>17188000){bad=bad+1;}
  if(bad>0){
    emit("CP-NOT-VALIDATED ("); pl(bad as i64); emit(" of 4) -- NO INTERVAL REPORTED\n");
    return 1;
  }
  emit("CP-VALIDATED 4/4\n\n");
  emit("A) B0 SENSITIVITY, measured on E_PRE where all 8 defects are live\n");
  row("  detected            ",8,0);
  emit("\nB) B0 on ISOLATED mutants: which sites carry the detection\n");
  row("  any site            ",8,8);
  row("  C6 alone            ",8,8);
  row("  C11 alone           ",8,7);
  row("  P-ACT6A alone       ",8,8);
  row("  the 43 non-flagged  ",8,1);
  emit("\nC) CENSUS of the 43 un-audited green sites\n");
  row("  (a) spec-derived    ",43,28);
  row("  (b) copied/tautolog.",43,13);
  row("  (b) needs simulation",43,2);
  row("  (c) defect-encoding ",43,0);
  emit("\nD) RED-TEAM EXTRAPOLATION, recomputed for comparison\n");
  row("  3/43                ",43,3);
  return 0;
}

// t2_battery_main.zag -- entry point for the TNN-2 invariant battery.
// Concatenated AFTER a base slice (frozen or fixed) + t2_battery_*.zag.
// Brief 4.0: emit()/_zag_print only. Same entry for the frozen and the fixed
// base so the two runs are directly comparable.
fn main()i32 {
  let rc:i32=run_all();
  if(rc==0){ emit("IV_BATTERY_ALL_PASS\n"); } else { emit("IV_BATTERY_HAS_FAILURES\n"); }
  return rc;
}

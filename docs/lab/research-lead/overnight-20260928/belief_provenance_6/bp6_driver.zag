// bp6_driver.zag -- BP-6 battery driver (remaining open dynamics).
//
// Arms: BA (bar-adjustment trajectories), COMB (combiner alternatives),
// EV (eviction interaction), CY5 (5-cycle), NST (nested cycles).
// Kill bars from the frozen PREREG.md. Verdict BP-6-PASS/FAIL.
// Pure Zag. bp6_learner.zag reused verbatim (BP-5 belief layer);
// no new learner machinery this lane. bp2_bar_after is existing
// dormant belief-layer code, triggered here in a closed loop.
// bp6_cmax/bp6_cavg/bp6_cwavg are driver-side experimental combiner
// variants (R6/min stays the frozen belief-layer rule).

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp6_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp6_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp6_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp6_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption (BP-5 convention, indep=0): count NEW
// type-7/type-3 self-edges on fact fid since watermarks (p7,p3);
// each new type-7 applies R2, each new type-3 applies R3, to belief
// mid. out[0]=new7, out[4]=new3.
fn bp6_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp6_selfcnt(W,fid,7)-p7;
  let n3:i32=bp6_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// Combiner variant: max over live recorded type-14 targets.
// Driver-side experimental code; mirrors bp2_propagate traversal.
fn bp6_cmax(W:[]u8,bt:[]u8,hasb:[]u8,z:i32)i32 {
  let m:i32=0; let found:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==z && eg(W,e,4)==14){
      let c:i32=eg(W,e,8);
      if(c>=0 && ng(W,c,36)==1 && (hasb[c] as i32)==1){
        let s:i32=bt[c*8] as i32;
        if(found==0){m=s; found=1;}
        else{if(s>m){m=s;}}
      }
    }
    e=e+1;
  }
  if(found==0){return 255;}
  bt[z*8]=m as u8;
  if(m==0){bp2_retire(W,bt,z,2);}
  return m;
}

// Combiner variant: integer mean over live recorded type-14 targets.
fn bp6_cavg(W:[]u8,bt:[]u8,hasb:[]u8,z:i32)i32 {
  let sum:i32=0; let cnt:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==z && eg(W,e,4)==14){
      let c:i32=eg(W,e,8);
      if(c>=0 && ng(W,c,36)==1 && (hasb[c] as i32)==1){
        sum=sum+(bt[c*8] as i32); cnt=cnt+1;
      }
    }
    e=e+1;
  }
  if(cnt==0){return 255;}
  let a:i32=sum/cnt;
  bt[z*8]=a as u8;
  if(a==0){bp2_retire(W,bt,z,2);}
  return a;
}

// Combiner variant: evidence-weighted mean, weight=b_conf+b_disc+1.
fn bp6_cwavg(W:[]u8,bt:[]u8,hasb:[]u8,z:i32)i32 {
  let ws:i32=0; let wt:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==z && eg(W,e,4)==14){
      let c:i32=eg(W,e,8);
      if(c>=0 && ng(W,c,36)==1 && (hasb[c] as i32)==1){
        let s:i32=bt[c*8] as i32;
        let w:i32=(bt[c*8+1] as i32)+(bt[c*8+2] as i32)+1;
        ws=ws+s*w; wt=wt+w;
      }
    }
    e=e+1;
  }
  if(wt==0){return 255;}
  let a:i32=ws/wt;
  bt[z*8]=a as u8;
  if(a==0){bp2_retire(W,bt,z,2);}
  return a;
}

fn main()i32 {
  emit("BP6-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= BA: bar-adjustment trajectories =================
  emit("BA-BEGIN\n");
  let WBA:[]u8=z_alloc(110656);
  tnn2_init(WBA);
  let fa1:i32=ev_teach(WBA,701,71,10);
  let fa2:i32=ev_teach(WBA,702,72,20);
  let fa3:i32=ev_teach(WBA,703,73,30);
  let fa4:i32=ev_teach(WBA,704,74,40);
  ns(WBA,fa1,16,2);
  ns(WBA,fa2,16,6);
  ns(WBA,fa3,16,2);
  ns(WBA,fa4,16,6);
  let pfa:[]u8=z_alloc(16);
  set32(pfa,0,fa1); set32(pfa,4,fa2);
  set32(pfa,8,fa3); set32(pfa,12,fa4);
  let mA:i32=promote_graph(WBA,-1,701,71,10,pfa,4);
  let mB:i32=alloc_node(WBA);
  let btBA:[]u8=z_alloc(8192); let hbBA:[]u8=z_alloc(1024);
  bp2_form(WBA,btBA,hbBA,mA,0);
  bp2_form(WBA,btBA,hbBA,mB,1);
  bp2_disconfirm(btBA,mB);
  bp2_disconfirm(btBA,mB);
  emit("BA mA "); e64(mA); emit(" mB "); e64(mB); emit("\n");
  bp6_bar(t,"PC-BA-FORM",(btBA[mA*8] as i32)==100 && (btBA[mA*8+4] as i32)==2 && (btBA[mA*8+5] as i32)==2 && (btBA[mB*8] as i32)==60);
  // unit checks on the dormant rule
  bp6_bar(t,"K-BA-U1",bp2_bar_after(50,1,100)==51);
  bp6_bar(t,"K-BA-U2",bp2_bar_after(51,0,80)==51);
  bp6_bar(t,"K-BA-U3",bp2_bar_after(51,0,110)==50);
  bp6_bar(t,"K-BA-U4",bp2_bar_after(10,0,25)==10);
  bp6_bar(t,"K-BA-U5",bp2_bar_after(10,1,5)==11);
  let bar:i32=50;
  let candsBA:[]u8=z_alloc(8);
  set32(candsBA,0,mA); set32(candsBA,4,mB);
  // T1: false positive -> bar rises
  let sel1:i32=bp2_select(btBA,hbBA,candsBA,2,bar);
  let eff1:i32=bp2_eff(btBA,mA);
  let t1p7:i32=bp6_selfcnt(WBA,fa2,7);
  let t1p3:i32=bp6_selfcnt(WBA,fa2,3);
  let rr1:i32=ev_observe(WBA,702,72,999);
  let ab1:[]u8=z_alloc(8);
  bp6_absorb(WBA,btBA,mA,fa2,t1p7,t1p3,ab1);
  let cf1:i32=0;
  if(get32(ab1,4)>0){cf1=1;}
  bar=bp2_bar_after(bar,cf1,eff1);
  emit("BA-T1 ret "); e64(rr1); emit(" sel "); e64(sel1);
  emit(" eff "); e64(eff1); emit(" n3 "); e64(get32(ab1,4));
  emit(" bar "); e64(bar); emit(" sup "); e64(btBA[mA*8] as i32); emit("\n");
  bp6_bar(t,"K-BA-T1",sel1==mA && bar==51 && (btBA[mA*8] as i32)==80 && (btBA[mA*8+2] as i32)==1);
  // T2: near-bar true positive -> bar holds
  let sel2:i32=bp2_select(btBA,hbBA,candsBA,2,bar);
  let eff2:i32=bp2_eff(btBA,mA);
  let t2p7:i32=bp6_selfcnt(WBA,fa1,7);
  let t2p3:i32=bp6_selfcnt(WBA,fa1,3);
  let rr2:i32=ev_observe(WBA,701,71,10);
  let ab2:[]u8=z_alloc(8);
  bp6_absorb(WBA,btBA,mA,fa1,t2p7,t2p3,ab2);
  let cf2:i32=0;
  if(get32(ab2,4)>0){cf2=1;}
  bar=bp2_bar_after(bar,cf2,eff2);
  emit("BA-T2 ret "); e64(rr2); emit(" sel "); e64(sel2);
  emit(" eff "); e64(eff2); emit(" n7 "); e64(get32(ab2,0));
  emit(" bar "); e64(bar); emit(" sup "); e64(btBA[mA*8] as i32); emit("\n");
  bp6_bar(t,"K-BA-T2",sel2==mA && bar==51 && (btBA[mA*8] as i32)==90);
  // boosts: two more emergent confirms on fresh facts
  let b1p7:i32=bp6_selfcnt(WBA,fa3,7);
  let b1p3:i32=bp6_selfcnt(WBA,fa3,3);
  let rb1:i32=ev_observe(WBA,703,73,30);
  let abb1:[]u8=z_alloc(8);
  bp6_absorb(WBA,btBA,mA,fa3,b1p7,b1p3,abb1);
  let b2p7:i32=bp6_selfcnt(WBA,fa4,7);
  let b2p3:i32=bp6_selfcnt(WBA,fa4,3);
  let rb2:i32=ev_observe(WBA,704,74,40);
  let abb2:[]u8=z_alloc(8);
  bp6_absorb(WBA,btBA,mA,fa4,b2p7,b2p3,abb2);
  emit("BA-BOOST ret "); e64(rb1); emit("/"); e64(rb2);
  emit(" sup "); e64(btBA[mA*8] as i32); emit("\n");
  // T3: far-above-bar true positive -> bar lowers
  let sel3:i32=bp2_select(btBA,hbBA,candsBA,2,bar);
  let eff3:i32=bp2_eff(btBA,mA);
  let t3p7:i32=bp6_selfcnt(WBA,fa1,7);
  let t3p3:i32=bp6_selfcnt(WBA,fa1,3);
  let rr3:i32=ev_observe(WBA,701,71,10);
  let ab3:[]u8=z_alloc(8);
  bp6_absorb(WBA,btBA,mA,fa1,t3p7,t3p3,ab3);
  let cf3:i32=0;
  if(get32(ab3,4)>0){cf3=1;}
  bar=bp2_bar_after(bar,cf3,eff3);
  emit("BA-T3 ret "); e64(rr3); emit(" sel "); e64(sel3);
  emit(" eff "); e64(eff3); emit(" n7 "); e64(get32(ab3,0));
  emit(" bar "); e64(bar); emit(" sup "); e64(btBA[mA*8] as i32); emit("\n");
  bp6_bar(t,"K-BA-T3",sel3==mA && bar==50 && (btBA[mA*8] as i32)==120);
  // EXCL: the raised bar value excludes a marginal candidate
  let mC:i32=alloc_node(WBA);
  bp2_form(WBA,btBA,hbBA,mC,1);
  bp2_revise(btBA,mC);
  let candsC:[]u8=z_alloc(4);
  set32(candsC,0,mC);
  let s_hi:i32=bp2_select(btBA,hbBA,candsC,1,51);
  let s_lo:i32=bp2_select(btBA,hbBA,candsC,1,50);
  emit("BA-EXCL mC "); e64(mC); emit(" sup "); e64(btBA[mC*8] as i32);
  emit(" sel51 "); e64(s_hi); emit(" sel50 "); e64(s_lo); emit("\n");
  bp6_bar(t,"K-BA-EXCL",s_hi==-3 && s_lo==mC);
  emit("BA-END\n");

  // ================= COMB: combiner alternatives =================
  emit("COMB-BEGIN\n");
  let WBC:[]u8=z_alloc(110656);
  tnn2_init(WBC);
  let t1:i32=alloc_node(WBC);
  let t2:i32=alloc_node(WBC);
  let w:i32=alloc_node(WBC);
  let btC:[]u8=z_alloc(8192); let hbC:[]u8=z_alloc(1024);
  bp2_form(WBC,btC,hbC,t1,1);
  bp2_form(WBC,btC,hbC,t2,1);
  bp2_form(WBC,btC,hbC,w,1);
  bp2_confirm(btC,t1,0);
  bp2_confirm(btC,t1,0);
  bp2_disconfirm(btC,t2);
  bp2_disconfirm(btC,t2);
  bp2_disconfirm(btC,w);
  bp2_disconfirm(btC,w);
  bp2_confirm(btC,w,0);
  bp6_bar(t,"PC-COMB-FORM",(btC[t1*8] as i32)==120 && (btC[t1*8+1] as i32)==3 && (btC[t2*8] as i32)==60 && (btC[t2*8+2] as i32)==2 && (btC[w*8] as i32)==70);
  let z:i32=alloc_node(WBC);
  link_edge(WBC,z,14,t1,0);
  link_edge(WBC,z,14,t2,0);
  let candsZ:[]u8=z_alloc(8);
  set32(candsZ,0,z); set32(candsZ,4,w);
  bp2_form(WBC,btC,hbC,z,1);
  let vmin:i32=bp2_propagate(WBC,btC,hbC,z);
  let smin:i32=bp2_select(btC,hbC,candsZ,2,50);
  emit("COMB-MIN v "); e64(vmin); emit(" sel "); e64(smin); emit("\n");
  bp6_bar(t,"K-COMB-MIN",(btC[z*8] as i32)==60);
  bp2_form(WBC,btC,hbC,z,1);
  let vmax:i32=bp6_cmax(WBC,btC,hbC,z);
  let smax:i32=bp2_select(btC,hbC,candsZ,2,50);
  emit("COMB-MAX v "); e64(vmax); emit(" sel "); e64(smax); emit("\n");
  bp6_bar(t,"K-COMB-MAX",(btC[z*8] as i32)==120);
  bp2_form(WBC,btC,hbC,z,1);
  let vavg:i32=bp6_cavg(WBC,btC,hbC,z);
  let savg:i32=bp2_select(btC,hbC,candsZ,2,50);
  emit("COMB-AVG v "); e64(vavg); emit(" sel "); e64(savg); emit("\n");
  bp6_bar(t,"K-COMB-AVG",(btC[z*8] as i32)==90);
  bp2_form(WBC,btC,hbC,z,1);
  let vwavg:i32=bp6_cwavg(WBC,btC,hbC,z);
  let swavg:i32=bp2_select(btC,hbC,candsZ,2,50);
  emit("COMB-WAVG v "); e64(vwavg); emit(" sel "); e64(swavg); emit("\n");
  bp6_bar(t,"K-COMB-WAVG",(btC[z*8] as i32)==94);
  let minok:i32=0;
  if(vmin<=60){minok=1;}
  let maxok:i32=0;
  if(vmax<=60){maxok=1;}
  let avgok:i32=0;
  if(vavg<=60){avgok=1;}
  let wavgok:i32=0;
  if(vwavg<=60){wavgok=1;}
  bp6_bar(t,"K-COMB-NOINV",minok==1 && maxok==0 && avgok==0 && wavgok==0);
  bp6_bar(t,"K-COMB-SELDISC",smin==w && smax==z && savg==z && swavg==z);
  emit("COMB-END\n");

  // ================= EV: eviction interaction =================
  emit("EV-BEGIN\n");
  let WG:[]u8=z_alloc(110656);
  tnn2_init(WG);
  let fa1g:i32=ev_teach(WG,701,71,10);
  let fa2g:i32=ev_teach(WG,702,72,20);
  ns(WG,fa1g,16,2);
  ns(WG,fa2g,16,6);
  let pfag:[]u8=z_alloc(8);
  set32(pfag,0,fa1g); set32(pfag,4,fa2g);
  let m1:i32=promote_graph(WG,-1,701,71,10,pfag,2);
  let fb1g:i32=ev_teach(WG,801,81,15);
  let fb2g:i32=ev_teach(WG,802,82,25);
  ns(WG,fb1g,16,2);
  ns(WG,fb2g,16,6);
  let pfbg:[]u8=z_alloc(8);
  set32(pfbg,0,fb1g); set32(pfbg,4,fb2g);
  let m2:i32=promote_graph(WG,-1,801,81,15,pfbg,2);
  let btG:[]u8=z_alloc(8192); let hbG:[]u8=z_alloc(1024);
  bp2_form(WG,btG,hbG,m1,0);
  bp2_form(WG,btG,hbG,m2,0);
  bp2_disconfirm(btG,m2);
  emit("EV m1 "); e64(m1); emit(" m2 "); e64(m2); emit("\n");
  bp6_bar(t,"PC-EV-FORM",(btG[m1*8] as i32)==100 && (btG[m1*8+4] as i32)==1 && (btG[m1*8+5] as i32)==1 && (btG[m2*8] as i32)==80);
  // protect every live node except the victim m1 (block-native type-9)
  let pn:i32=2;
  while(pn<1024){
    if(pn!=m1 && ng(WG,pn,36)==1){link_edge(WG,m2,9,pn,100);}
    pn=pn+1;
  }
  let h0:i32=hg(WG,12);
  let ev1:i32=evict_node(WG);
  let h1:i32=hg(WG,12);
  emit("EV ev1 "); e64(ev1); emit(" m1live "); e64(ng(WG,m1,36));
  emit(" m2live "); e64(ng(WG,m2,36));
  emit(" h0 "); e64(h0); emit(" h1 "); e64(h1); emit("\n");
  bp6_bar(t,"K-EV-VICTIM",ev1==m1 && ng(WG,m1,36)==0 && ng(WG,m2,36)==1);
  bp6_bar(t,"K-EV-TOMB",h1!=h0 && ng(WG,h1,0)==3 && ng(WG,h1,36)==1);
  bp6_bar(t,"K-EV-PERSIST",(hbG[m1] as i32)==1 && (btG[m1*8] as i32)==100);
  let candsG:[]u8=z_alloc(8);
  set32(candsG,0,m1); set32(candsG,4,m2);
  let sevs:i32=bp2_select(btG,hbG,candsG,2,50);
  let sevl:i32=bp2_lgsel(WG,candsG,2);
  emit("EV selR7 "); e64(sevs); emit(" selLG "); e64(sevl); emit("\n");
  bp6_bar(t,"K-EV-STALE",sevs==m1);
  bp6_bar(t,"K-EV-LGSEL",sevl==m2);
  bp2_relicense(WG,btG,m1);
  emit("EV-R4 sup "); e64(btG[m1*8] as i32); emit("\n");
  bp6_bar(t,"K-EV-R4",(btG[m1*8] as i32)==0 && bp2_has_k3r(WG,m1,2)==1);
  emit("EV-END\n");

  // ================= CY5: 5-cycle =================
  emit("CY5-BEGIN\n");
  let WE:[]u8=z_alloc(110656);
  tnn2_init(WE);
  let btE:[]u8=z_alloc(8192); let hbE:[]u8=z_alloc(1024);
  let z1:i32=alloc_node(WE);
  let z2:i32=alloc_node(WE);
  let z3:i32=alloc_node(WE);
  let z4:i32=alloc_node(WE);
  let z5:i32=alloc_node(WE);
  bp2_form(WE,btE,hbE,z1,1);
  bp2_form(WE,btE,hbE,z2,1);
  bp2_form(WE,btE,hbE,z3,1);
  bp2_form(WE,btE,hbE,z4,1);
  bp2_form(WE,btE,hbE,z5,1);
  link_edge(WE,z1,14,z2,0);
  link_edge(WE,z2,14,z3,0);
  link_edge(WE,z3,14,z4,0);
  link_edge(WE,z4,14,z5,0);
  link_edge(WE,z5,14,z1,0);
  emit("CY5 z "); e64(z1); emit("/"); e64(z2); emit("/"); e64(z3);
  emit("/"); e64(z4); emit("/"); e64(z5); emit("\n");
  bp6_bar(t,"PC-CY5-FORM",(btE[z1*8] as i32)==100 && (btE[z2*8] as i32)==100 && (btE[z3*8] as i32)==100 && (btE[z4*8] as i32)==100 && (btE[z5*8] as i32)==100);
  bp2_disconfirm(btE,z3);
  bp2_disconfirm(btE,z3);
  bp2_disconfirm(btE,z3);
  bp6_bar(t,"K-CY5-WEAK",(btE[z3*8] as i32)==40);
  bp2_propagate(WE,btE,hbE,z2);
  emit("CY5-1 z2 "); e64(btE[z2*8] as i32); emit("\n");
  bp6_bar(t,"K-CY5-1HOP",(btE[z2*8] as i32)==40 && (btE[z1*8] as i32)==100 && (btE[z5*8] as i32)==100 && (btE[z4*8] as i32)==100);
  bp2_propagate(WE,btE,hbE,z1);
  bp2_propagate(WE,btE,hbE,z5);
  bp2_propagate(WE,btE,hbE,z4);
  bp2_propagate(WE,btE,hbE,z3);
  emit("CY5-F "); e64(btE[z1*8] as i32); emit("/"); e64(btE[z2*8] as i32);
  emit("/"); e64(btE[z3*8] as i32); emit("/"); e64(btE[z4*8] as i32);
  emit("/"); e64(btE[z5*8] as i32); emit("\n");
  bp6_bar(t,"K-CY5-FULL",(btE[z1*8] as i32)==40 && (btE[z2*8] as i32)==40 && (btE[z3*8] as i32)==40 && (btE[z4*8] as i32)==40 && (btE[z5*8] as i32)==40);
  bp2_propagate(WE,btE,hbE,z1);
  bp2_propagate(WE,btE,hbE,z2);
  bp2_propagate(WE,btE,hbE,z3);
  bp2_propagate(WE,btE,hbE,z4);
  bp2_propagate(WE,btE,hbE,z5);
  bp6_bar(t,"K-CY5-FIX",(btE[z1*8] as i32)==40 && (btE[z2*8] as i32)==40 && (btE[z3*8] as i32)==40 && (btE[z4*8] as i32)==40 && (btE[z5*8] as i32)==40);
  bp2_confirm(btE,z5,1);
  bp2_confirm(btE,z5,1);
  bp2_propagate(WE,btE,hbE,z4);
  emit("CY5-R z4 "); e64(btE[z4*8] as i32); emit("\n");
  bp6_bar(t,"K-CY5-RAISE",(btE[z4*8] as i32)==80);
  emit("CY5-END\n");

  // ================= NST: nested cycles =================
  emit("NST-BEGIN\n");
  let WN:[]u8=z_alloc(110656);
  tnn2_init(WN);
  let btN:[]u8=z_alloc(8192); let hbN:[]u8=z_alloc(1024);
  let zA:i32=alloc_node(WN);
  let zB:i32=alloc_node(WN);
  let zC:i32=alloc_node(WN);
  let zD:i32=alloc_node(WN);
  bp2_form(WN,btN,hbN,zA,1);
  bp2_form(WN,btN,hbN,zB,1);
  bp2_form(WN,btN,hbN,zC,1);
  bp2_form(WN,btN,hbN,zD,1);
  link_edge(WN,zA,14,zB,0);
  link_edge(WN,zB,14,zC,0);
  link_edge(WN,zC,14,zA,0);
  link_edge(WN,zD,14,zB,0);
  link_edge(WN,zB,14,zD,0);
  emit("NST zA "); e64(zA); emit(" zB "); e64(zB);
  emit(" zC "); e64(zC); emit(" zD "); e64(zD); emit("\n");
  bp6_bar(t,"PC-NST-FORM",(btN[zA*8] as i32)==100 && (btN[zB*8] as i32)==100 && (btN[zC*8] as i32)==100 && (btN[zD*8] as i32)==100);
  bp2_disconfirm(btN,zD);
  bp2_disconfirm(btN,zD);
  bp2_propagate(WN,btN,hbN,zB);
  emit("NST-1 zB "); e64(btN[zB*8] as i32); emit("\n");
  bp6_bar(t,"K-NST-1HOP",(btN[zB*8] as i32)==60 && (btN[zA*8] as i32)==100 && (btN[zC*8] as i32)==100);
  bp2_propagate(WN,btN,hbN,zA);
  bp2_propagate(WN,btN,hbN,zC);
  bp2_propagate(WN,btN,hbN,zD);
  emit("NST-C "); e64(btN[zA*8] as i32); emit("/"); e64(btN[zB*8] as i32);
  emit("/"); e64(btN[zC*8] as i32); emit("/"); e64(btN[zD*8] as i32); emit("\n");
  bp6_bar(t,"K-NST-CONV",(btN[zA*8] as i32)==60 && (btN[zB*8] as i32)==60 && (btN[zC*8] as i32)==60 && (btN[zD*8] as i32)==60);
  bp2_disconfirm(btN,zD);
  bp2_disconfirm(btN,zD);
  bp2_disconfirm(btN,zD);
  bp2_propagate(WN,btN,hbN,zB);
  emit("NST-Z zB "); e64(btN[zB*8] as i32); emit("\n");
  bp6_bar(t,"K-NST-Z0B",(btN[zB*8] as i32)==0 && bp2_has_k3r(WN,zB,2)==1);
  bp2_propagate(WN,btN,hbN,zA);
  bp2_propagate(WN,btN,hbN,zC);
  bp2_propagate(WN,btN,hbN,zD);
  emit("NST-ZA "); e64(btN[zA*8] as i32); emit("/"); e64(btN[zC*8] as i32);
  emit("/"); e64(btN[zD*8] as i32); emit("\n");
  bp6_bar(t,"K-NST-ZALL",(btN[zA*8] as i32)==0 && (btN[zC*8] as i32)==0 && (btN[zD*8] as i32)==0 && bp2_has_k3r(WN,zA,2)==1 && bp2_has_k3r(WN,zC,2)==1 && bp2_has_k3r(WN,zD,2)==1);
  emit("NST-END\n");

  emit("BP6-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP6-END\n");
  return 0;
}

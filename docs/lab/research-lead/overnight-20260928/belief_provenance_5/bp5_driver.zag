// bp5_driver.zag -- BP-5 battery driver (open dynamics).
//
// Arms: E-R3 (emergent disconfirmation), E-R5 (emergent
// revision), B-FACT (fact beliefs), B-META (meta-beliefs),
// MH (multi-hop propagation), CY (cyclic propagation).
// Kill bars from the frozen PREREG.md. Verdict
// BP-5-PASS/FAIL. Pure Zag. bp5_learner.zag reused
// verbatim; bp5_rules.zag holds the three new learner
// functions (B-FACT/B-META formation, I1 enforcement);
// frozen block ops reused verbatim, never redefined.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp5_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp5_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp5_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp5_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Count outgoing type-16 edges from mr.
fn bp5_t16cnt(W:[]u8,mr:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mr && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}

// Field16 tagging of live tag-1 type-1 targets (P6
// partition scripting; side-effect-free on the world).
fn bp5_tag(W:[]u8,mid:i32,tag:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        ns(W,f,16,tag);
      }
    }
    e=e+1;
  }
  return;
}

// Emergent evidence absorption: count NEW type-7/type-3
// self-edges on fact fid since watermarks (p7,p3); each
// new type-7 applies R2 (same-set, indep=0: the edge is
// on the belief's own licensing fact), each new type-3
// applies R3, to belief mid. out[0]=new7, out[4]=new3.
fn bp5_absorb_fact(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp5_selfcnt(W,fid,7)-p7;
  let n3:i32=bp5_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// First live count-MAP id != excl, or -1.
fn bp5_other_countmap(W:[]u8,excl:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(m!=excl && ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Highest live count-MAP id, or -1.
fn bp5_max_countmap(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){best=m;}
    }
    m=m+1;
  }
  return best;
}

// The BP-4 world replay verbatim (pm=0).
// out: 0=my 4=mv2 8=mv3 12=navx 16=mz1 20=mz2.
fn bp5_build(W:[]u8,out:[]u8)void {
  ev_teach(W,11,81,12);
  ev_teach(W,12,81,13);
  ev_teach(W,13,81,14);
  ev_query_xs5(W,11,91,14,0);
  ev_teach(W,50,82,51);
  ev_teach(W,51,82,52);
  ev_teach(W,52,82,53);
  ev_query_xs5(W,50,92,3,0);
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  let my:i32=xs5_find_countmap(W);
  set32(out,0,my);
  ev_teach(W,110,85,111);
  ev_teach(W,111,85,112);
  ev_teach(W,112,85,113);
  ev_teach(W,113,85,114);
  ev_query_xs5(W,110,117,4,0);
  let mv2:i32=bp5_other_countmap(W,my);
  set32(out,4,mv2);
  ev_teach(W,120,87,121);
  ev_teach(W,121,87,122);
  ev_teach(W,122,87,123);
  ev_teach(W,123,87,124);
  ev_query_xs5(W,120,118,4,0);
  let mv3:i32=bp5_max_countmap(W);
  set32(out,8,mv3);
  ev_teach(W,14,82,40);
  ev_teach(W,40,82,41);
  xs5_compose(W,11,94,2);
  let mz1:i32=-1; let n:i32=0; let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){n=n+1; mz1=z;}
    z=z+1;
  }
  if(n!=1){mz1=-1;}
  set32(out,16,mz1);
  let navx:i32=xhier_mapz_nav(W,mz1);
  set32(out,12,navx);
  ev_teach(W,14,87,60);
  ev_teach(W,60,87,61);
  ev_teach(W,61,87,62);
  ev_teach(W,62,87,63);
  ev_teach(W,14,85,30);
  ev_teach(W,30,85,31);
  ev_teach(W,31,85,32);
  let pf:[]u8=z_alloc(8);
  let mz2:i32=promote_graph(W,-1,11,93,4,pf,0);
  link_edge(W,mz2,14,navx,0);
  link_edge(W,mz2,14,mv3,0);
  set32(out,20,mz2);
  ns(W,my,0,0); ns(W,my,36,0);
  return;
}

fn main()i32 {
  emit("BP5-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  let bar0:i32=50;

  // ================= E-R3: emergent disconfirmation =================
  emit("ER3-BEGIN\n");
  let WA:[]u8=z_alloc(110656);
  tnn2_init(WA);
  let fa1:i32=ev_teach(WA,701,71,10);
  let fa2:i32=ev_teach(WA,702,72,20);
  ns(WA,fa1,16,2);
  ns(WA,fa2,16,6);
  let pfa:[]u8=z_alloc(8);
  set32(pfa,0,fa1); set32(pfa,4,fa2);
  let ma:i32=promote_graph(WA,-1,701,71,10,pfa,2);
  let btA:[]u8=z_alloc(8192); let hbA:[]u8=z_alloc(1024);
  bp2_form(WA,btA,hbA,ma,0);
  bp5_bar(t,"PC-E-R3-FORM",(btA[ma*8] as i32)==100 && (btA[ma*8+4] as i32)==1 && (btA[ma*8+5] as i32)==1);
  // confirm leg: matching observation -> block writes type-7
  let p7a:i32=bp5_selfcnt(WA,fa1,7);
  let p3a:i32=bp5_selfcnt(WA,fa1,3);
  let ra1:i32=ev_observe(WA,701,71,10);
  let aba:[]u8=z_alloc(8);
  bp5_absorb_fact(WA,btA,ma,fa1,p7a,p3a,aba);
  let n7a:i32=get32(aba,0);
  emit("ER3-C ret "); e64(ra1); emit(" n7 "); e64(n7a);
  emit(" sup "); e64(btA[ma*8] as i32); emit("\n");
  bp5_bar(t,"K-E-R3-C7",n7a==1);
  bp5_bar(t,"K-E-R3-CSUP",(btA[ma*8] as i32)==110 && (btA[ma*8+1] as i32)==2);
  // disconfirm leg: contradicting observation -> block writes type-3
  let p7b:i32=bp5_selfcnt(WA,fa2,7);
  let p3b:i32=bp5_selfcnt(WA,fa2,3);
  let ra2:i32=ev_observe(WA,702,72,999);
  let abb:[]u8=z_alloc(8);
  bp5_absorb_fact(WA,btA,ma,fa2,p7b,p3b,abb);
  let n3b:i32=get32(abb,4);
  emit("ER3-D ret "); e64(ra2); emit(" n3 "); e64(n3b);
  emit(" sup "); e64(btA[ma*8] as i32); emit("\n");
  bp5_bar(t,"K-E-R3-D3",n3b==1);
  bp5_bar(t,"K-E-R3-DSUP",(btA[ma*8] as i32)==90 && (btA[ma*8+2] as i32)==1 && (btA[ma*8+1] as i32)==0);
  bp5_bar(t,"K-E-R3-NOR5",ng(WA,ma,28)==10 && (btA[ma*8+3] as i32)==0);
  emit("ER3-END\n");

  // ================= E-R5: emergent revision =================
  emit("ER5-BEGIN\n");
  let WB:[]u8=z_alloc(110656);
  tnn2_init(WB);
  ev_teach(WB,101,11,102);
  ev_teach(WB,102,12,201);
  let qb:i32=ev_query(WB,101,40,201,0);
  let mb:i32=-1; let nb:i32=2;
  while(nb<1024){
    if(ng(WB,nb,36)==1 && ng(WB,nb,0)==20 && ng(WB,nb,4)==40){mb=nb;}
    nb=nb+1;
  }
  let btB:[]u8=z_alloc(8192); let hbB:[]u8=z_alloc(1024);
  bp2_form(WB,btB,hbB,mb,0);
  let pre28:i32=ng(WB,mb,28);
  emit("ER5 q "); e64(qb); emit(" mb "); e64(mb); emit(" pre28 "); e64(pre28); emit("\n");
  bp5_bar(t,"PC-E-R5-FORM",(btB[mb*8] as i32)==100 && pre28==201);
  // control: matching observation -> no contradiction -> no revision
  let rb1:i32=ev_observe(WB,102,12,201);
  emit("ER5-C ret "); e64(rb1); emit(" mb28 "); e64(ng(WB,mb,28)); emit("\n");
  bp5_bar(t,"K-E-R5-CTL",ng(WB,mb,28)==201 && (btB[mb*8+3] as i32)==0 && (btB[mb*8] as i32)==100);
  // treatment: contradicting observation -> block revises the MAP
  let rb2:i32=ev_observe(WB,102,12,999);
  let post28:i32=ng(WB,mb,28);
  emit("ER5-T ret "); e64(rb2); emit(" mb28 "); e64(post28); emit("\n");
  if(post28!=pre28){bp2_revise(btB,mb);}
  bp5_bar(t,"K-E-R5-REV",post28==999);
  bp5_bar(t,"K-E-R5-TRAJ",(btB[mb*8] as i32)==50 && (btB[mb*8+3] as i32)==1 && (btB[mb*8+1] as i32)==0 && (btB[mb*8+2] as i32)==0);
  emit("ER5-END\n");

  // ================= B-FACT: fact beliefs =================
  emit("BF-BEGIN\n");
  let WC:[]u8=z_alloc(110656);
  tnn2_init(WC);
  let fc1:i32=ev_teach(WC,703,73,30);
  let fc2:i32=ev_teach(WC,704,74,40);
  let fc3:i32=ev_teach(WC,705,75,50);
  ns(WC,fc1,16,2);
  ns(WC,fc2,16,6);
  let btC:[]u8=z_alloc(8192); let hbC:[]u8=z_alloc(1024);
  bp5_form_fact(WC,btC,hbC,fc1);
  bp5_form_fact(WC,btC,hbC,fc2);
  bp5_form_fact(WC,btC,hbC,fc3);
  bp5_bar(t,"K-BF-FORM",(btC[fc1*8] as i32)==100 && (btC[fc2*8] as i32)==100 && (btC[fc3*8] as i32)==100 && (btC[fc1*8+4] as i32)==1 && (btC[fc1*8+5] as i32)==0 && (btC[fc2*8+4] as i32)==0 && (btC[fc2*8+5] as i32)==1 && (btC[fc3*8+4] as i32)==0 && (btC[fc3*8+5] as i32)==0 && (btC[fc1*8+1] as i32)==1);
  let q7c:i32=bp5_selfcnt(WC,fc1,7);
  let q3c:i32=bp5_selfcnt(WC,fc1,3);
  let rc1:i32=ev_observe(WC,703,73,30);
  let abc:[]u8=z_alloc(8);
  bp5_absorb_fact(WC,btC,fc1,fc1,q7c,q3c,abc);
  let r7c:i32=bp5_selfcnt(WC,fc2,7);
  let r3c:i32=bp5_selfcnt(WC,fc2,3);
  let rc2:i32=ev_observe(WC,704,74,999);
  let abd:[]u8=z_alloc(8);
  bp5_absorb_fact(WC,btC,fc2,fc2,r7c,r3c,abd);
  emit("BF-EV ret "); e64(rc1); emit("/"); e64(rc2);
  emit(" n7 "); e64(get32(abc,0)); emit(" n3 "); e64(get32(abd,4));
  emit(" sup "); e64(btC[fc1*8] as i32); emit("/"); e64(btC[fc2*8] as i32); emit("\n");
  bp5_bar(t,"K-BF-EV",get32(abc,0)==1 && get32(abd,4)==1 && (btC[fc1*8] as i32)==110 && (btC[fc2*8] as i32)==80 && (btC[fc2*8+2] as i32)==1 && (btC[fc1*8+1] as i32)==2);
  let candsC:[]u8=z_alloc(12);
  set32(candsC,0,fc1); set32(candsC,4,fc2); set32(candsC,8,fc3);
  let r7bf:i32=bp2_select(btC,hbC,candsC,3,bar0);
  bp5_bar(t,"K-BF-SEL",r7bf==fc1);
  bp5_bar(t,"K-BF-EFF",bp2_eff(btC,fc3)==100 && bp2_eff(btC,fc1)==110);
  bp5_fact_tombstone(WC,btC,hbC,fc2);
  bp5_bar(t,"K-BF-I1DIE",(hbC[fc2] as i32)==0 && ng(WC,fc2,36)==0);
  let candsC2:[]u8=z_alloc(8);
  set32(candsC2,0,fc2); set32(candsC2,4,fc3);
  bp5_bar(t,"K-BF-I1SEL",bp2_select(btC,hbC,candsC2,2,bar0)==fc3);
  let fc4:i32=ev_teach(WC,706,76,60);
  bp5_form_fact(WC,btC,hbC,fc4);
  bp5_bar(t,"K-BF-I1FRESH",(btC[fc4*8] as i32)==100 && (btC[fc4*8+2] as i32)==0 && (btC[fc4*8+1] as i32)==1);
  emit("BF-END\n");

  // ================= B-META: meta-beliefs =================
  emit("BM-BEGIN\n");
  let WD:[]u8=z_alloc(110656);
  tnn2_init(WD);
  let fA:i32=ev_teach(WD,711,71,100);
  let fB:i32=ev_teach(WD,712,72,200);
  ns(WD,fA,16,2);
  ns(WD,fB,16,6);
  let ppA:[]u8=z_alloc(4);
  set32(ppA,0,fA);
  let mA:i32=promote_graph(WD,-1,711,71,100,ppA,1);
  let ppB:[]u8=z_alloc(4);
  set32(ppB,0,fB);
  let mB:i32=promote_graph(WD,-1,712,72,200,ppB,1);
  let btD:[]u8=z_alloc(8192); let hbD:[]u8=z_alloc(1024);
  bp2_form(WD,btD,hbD,mA,0);
  bp2_form(WD,btD,hbD,mB,0);
  let mr1:i32=alloc_node(WD);
  ns(WD,mr1,0,3);
  link_edge(WD,mr1,16,mA,0);
  link_edge(WD,mr1,16,mB,0);
  let mr2:i32=alloc_node(WD);
  ns(WD,mr2,0,3);
  link_edge(WD,mr2,16,mB,0);
  link_edge(WD,mr2,16,mA,0);
  bp5_form_meta(WD,btD,hbD,mr1);
  bp5_form_meta(WD,btD,hbD,mr2);
  emit("BM mA "); e64(mA); emit(" mB "); e64(mB);
  emit(" mr1 "); e64(mr1); emit(" mr2 "); e64(mr2); emit("\n");
  bp5_bar(t,"K-BM-FORM",(btD[mr1*8] as i32)==100 && (btD[mr2*8] as i32)==100 && bp5_t16cnt(WD,mr1)==2 && bp5_t16cnt(WD,mr2)==2);
  let s7d:i32=bp5_selfcnt(WD,fA,7);
  let s3d:i32=bp5_selfcnt(WD,fA,3);
  let rd1:i32=ev_observe(WD,711,71,100);
  let abe:[]u8=z_alloc(8);
  bp5_absorb_fact(WD,btD,mA,fA,s7d,s3d,abe);
  // meta-update: mr1 winner mA confirmed -> R2(mr1);
  // mr2 loser mA confirmed -> R3(mr2).
  if(get32(abe,0)>0){bp2_confirm(btD,mr1,0);}
  if(get32(abe,0)>0){bp2_disconfirm(btD,mr2);}
  emit("BM-EV ret "); e64(rd1); emit(" n7 "); e64(get32(abe,0));
  emit(" mA "); e64(btD[mA*8] as i32);
  emit(" mr1 "); e64(btD[mr1*8] as i32);
  emit(" mr2 "); e64(btD[mr2*8] as i32); emit("\n");
  bp5_bar(t,"K-BM-EV",get32(abe,0)==1 && (btD[mA*8] as i32)==110 && (btD[mr1*8] as i32)==110 && (btD[mr1*8+1] as i32)==2 && (btD[mr2*8] as i32)==80 && (btD[mr2*8+2] as i32)==1);
  let candsD:[]u8=z_alloc(8);
  set32(candsD,0,mr1); set32(candsD,4,mr2);
  bp5_bar(t,"K-BM-SEL",bp2_select(btD,hbD,candsD,2,bar0)==mr1);
  emit("BM-END\n");

  // ================= MH: multi-hop propagation =================
  emit("MH-BEGIN\n");
  let WE:[]u8=z_alloc(110656);
  tnn2_init(WE);
  let idsE:[]u8=z_alloc(28);
  bp5_build(WE,idsE);
  let mv2e:i32=get32(idsE,4);
  let mv3e:i32=get32(idsE,8);
  bp5_bar(t,"PC-MH-BUILD",xs5_find_countmap(WE)==mv2e && mv2e==194 && mv3e==274);
  let btE:[]u8=z_alloc(8192); let hbE:[]u8=z_alloc(1024);
  bp2_form(WE,btE,hbE,mv2e,0);
  bp2_form(WE,btE,hbE,mv3e,0);
  bp2_disconfirm(btE,mv3e);
  bp2_disconfirm(btE,mv3e);
  let z1:i32=alloc_node(WE);
  let z2:i32=alloc_node(WE);
  let z3:i32=alloc_node(WE);
  let z4:i32=alloc_node(WE);
  bp2_form(WE,btE,hbE,z1,1);
  bp2_form(WE,btE,hbE,z2,1);
  bp2_form(WE,btE,hbE,z3,1);
  bp2_form(WE,btE,hbE,z4,1);
  link_edge(WE,z1,14,mv3e,0);
  link_edge(WE,z2,14,z1,0);
  link_edge(WE,z3,14,z2,0);
  link_edge(WE,z4,14,mv2e,0);
  link_edge(WE,z4,14,mv3e,0);
  emit("MH mv3sup "); e64(btE[mv3e*8] as i32);
  emit(" z "); e64(z1); emit("/"); e64(z2); emit("/"); e64(z3); emit("/"); e64(z4); emit("\n");
  bp2_propagate(WE,btE,hbE,z1);
  emit("MH-1 "); e64(btE[z1*8] as i32); emit("/"); e64(btE[z2*8] as i32); emit("/"); e64(btE[z3*8] as i32); emit("\n");
  bp5_bar(t,"K-MH-1HOP",(btE[z1*8] as i32)==60 && (btE[z2*8] as i32)==100 && (btE[z3*8] as i32)==100);
  bp2_propagate(WE,btE,hbE,z2);
  emit("MH-2 "); e64(btE[z2*8] as i32); emit("/"); e64(btE[z3*8] as i32); emit("\n");
  bp5_bar(t,"K-MH-2HOP",(btE[z2*8] as i32)==60 && (btE[z3*8] as i32)==100);
  bp2_propagate(WE,btE,hbE,z3);
  emit("MH-3 "); e64(btE[z3*8] as i32); emit("\n");
  bp5_bar(t,"K-MH-3HOP",(btE[z3*8] as i32)==60);
  bp2_propagate(WE,btE,hbE,z4);
  emit("MH-4 "); e64(btE[z4*8] as i32); emit("\n");
  bp5_bar(t,"K-MH-MIN",(btE[z4*8] as i32)==60);
  emit("MH-END\n");

  // ================= CY: cyclic propagation =================
  emit("CY-BEGIN\n");
  let WF:[]u8=z_alloc(110656);
  tnn2_init(WF);
  let zA:i32=alloc_node(WF);
  let zB:i32=alloc_node(WF);
  let btF:[]u8=z_alloc(8192); let hbF:[]u8=z_alloc(1024);
  bp2_form(WF,btF,hbF,zA,1);
  bp2_form(WF,btF,hbF,zB,1);
  link_edge(WF,zA,14,zB,0);
  link_edge(WF,zB,14,zA,0);
  emit("CY zA "); e64(zA); emit(" zB "); e64(zB); emit("\n");
  bp5_bar(t,"PC-CY-FORM",(btF[zA*8] as i32)==100 && (btF[zB*8] as i32)==100);
  bp2_disconfirm(btF,zB);
  bp2_propagate(WF,btF,hbF,zA);
  emit("CY-1 "); e64(btF[zA*8] as i32); emit("/"); e64(btF[zB*8] as i32); emit("\n");
  bp5_bar(t,"K-CY-C1",(btF[zA*8] as i32)==80 && (btF[zB*8] as i32)==80);
  bp2_disconfirm(btF,zB);
  bp2_propagate(WF,btF,hbF,zB);
  emit("CY-2 "); e64(btF[zA*8] as i32); emit("/"); e64(btF[zB*8] as i32); emit("\n");
  bp5_bar(t,"K-CY-C2",(btF[zB*8] as i32)==80);
  bp2_propagate(WF,btF,hbF,zA);
  bp2_propagate(WF,btF,hbF,zB);
  emit("CY-3 "); e64(btF[zA*8] as i32); emit("/"); e64(btF[zB*8] as i32); emit("\n");
  bp5_bar(t,"K-CY-C3",(btF[zA*8] as i32)==80 && (btF[zB*8] as i32)==80);
  bp2_disconfirm(btF,zB);
  bp2_disconfirm(btF,zB);
  bp2_disconfirm(btF,zB);
  bp2_disconfirm(btF,zB);
  bp2_propagate(WF,btF,hbF,zA);
  emit("CY-4 "); e64(btF[zA*8] as i32); emit("/"); e64(btF[zB*8] as i32); emit("\n");
  bp5_bar(t,"K-CY-C4",(btF[zA*8] as i32)==0 && bp2_has_k3r(WF,zA,2)==1);
  bp2_propagate(WF,btF,hbF,zB);
  emit("CY-5 "); e64(btF[zB*8] as i32); emit("\n");
  bp5_bar(t,"K-CY-C5",(btF[zB*8] as i32)==0);
  emit("CY-END\n");

  emit("BP5-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP5-END\n");
  return 0;
}

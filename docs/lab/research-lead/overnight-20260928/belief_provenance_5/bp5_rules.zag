// bp5_rules.zag -- BP-5 new learner machinery (exactly three
// functions, disclosed in PREREG.md Section 1).
//
// B-FACT and B-META formation plus the I1 tombstone rule.
// The record schema, R1-R7, eff(), b_retire are BP-4's
// bp5_learner.zag verbatim (the BP-3/BP-4 belief layer).
// 0 new edge types (1/3/14 frozen; 16 pre-exists in the
// block per DESIGN.md P5), 0 new node types (tag 1/3/20
// pre-existing), 0 modes, 0 bridges, 0 handlers,
// 0 semantic cases.

// B-FACT formation (R1 for a tag-1 fact node). The fact's
// own P6 field16 tag sets the source partition (same
// ext/self sets as bp2_lic_live). formed=0: a fact has no
// type-1 licensing of its own, so R4 is a no-op; its
// provenance-death is tombstone (I1, bp5_fact_tombstone).
fn bp5_form_fact(W:[]u8,bt:[]u8,hasb:[]u8,fid:i32)void {
  let o:i32=fid*8;
  let st:i32=ng(W,fid,16);
  let ne:i32=0; let nself:i32=0;
  if(st==1 || st==2 || st==5){ne=1;}
  if(st==3 || st==4 || st==6){nself=1;}
  bt[o]=100 as u8; bt[o+1]=1 as u8; bt[o+2]=0 as u8;
  bt[o+3]=0 as u8; bt[o+4]=ne as u8; bt[o+5]=nself as u8;
  bt[o+6]=255 as u8; bt[o+7]=0 as u8;
  hasb[fid]=1 as u8;
  return;
}

// B-META formation (R1 for a meta-row node carrying
// type-16 edges to winner and loser). No type-1 licensing
// (b_ext=b_self=0, formed=0, so R4 is a no-op); support
// moves only via R2/R3 on policy outcomes.
fn bp5_form_meta(W:[]u8,bt:[]u8,hasb:[]u8,mr:i32)void {
  let o:i32=mr*8;
  bt[o]=100 as u8; bt[o+1]=1 as u8; bt[o+2]=0 as u8;
  bt[o+3]=0 as u8; bt[o+4]=0 as u8; bt[o+5]=0 as u8;
  bt[o+6]=255 as u8; bt[o+7]=0 as u8;
  hasb[mr]=1 as u8;
  return;
}

// I1 enforcement: tombstone the fact node and destroy its
// belief record. Slot recycling gives the next occupant a
// fresh R1 record, never an inheritance.
fn bp5_fact_tombstone(W:[]u8,bt:[]u8,hasb:[]u8,fid:i32)void {
  ns(W,fid,0,0); ns(W,fid,36,0);
  hasb[fid]=0 as u8;
  let o:i32=fid*8; let i:i32=0;
  while(i<8){bt[o+i]=0 as u8; i=i+1;}
  return;
}

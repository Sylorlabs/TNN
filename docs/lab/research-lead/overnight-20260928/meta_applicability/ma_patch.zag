// ma_patch.zag -- meta-applicability (unfrozen).
// APPL: learner-owned applicability judgment on structural reuse.
//
// Consequence records: every reuse attempt stores (problem features F,
// success/failure). The gate estimates applicability of reuse for a new
// problem from similarity-weighted past consequences, with a learned
// similarity function (per-feature weights updated by consequences).
// No domain labels anywhere: the gate sees only observable structural
// features of the gathered paths plus the query relation.
//
// Two-pass rebind (rb_chain_plen, pc_is_linked, pc_try_one) verbatim from
// learning_to_learn/l2l_patch.zag. rebind_try refactored to accept
// pre-gathered paths so the gate and rebind share a single gather.
fn phase_a_enabled()i32 { return 1; }
// Walk a promoted graph root. If it is a pure chain
// (guard --true--> set --SEQ--> guard --true--> set ...),
// return the value-chain length plen = guards+1. Else -1.
// Verbatim from adv_patch.zag.
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}
// 1 if MAP m has an outgoing type-14 LINK edge (was built via rebind).
fn pc_is_linked(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// Delete all type-14 LINK edges. (Unused here; kept for parity.)
fn pc_del_links(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Try one MAP's shape on the query. On verified success, promote the
// rebound and write the persistent LINK edge new -> helper.
// Verbatim from learning_to_learn/l2l_patch.zag.
fn pc_try_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        let j:i32=0;
        while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,v,plen,f);
        let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
        if(v2!=-2){
          let bm:i32=promote_graph(W,nr,s,r,v2,f,plen-1);
          if(bm>=0){link_edge(W,bm,14,m,0);}
          ans=v2;
        }
      }
      p=p+1;
    }
  }
  return ans;
}
// Two-pass rebind over pre-gathered paths. Pass 1: MAPs with an outgoing
// type-14 edge (built via rebind before), newest first. Pass 2: all other
// MAPs in id order. Correctness unchanged (verification arbitrates).
fn rebind_try_paths(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8,paths:[]u8,np:i32)i32 {
  let ans:i32=-2;
  let m:i32=1023;
  while(m>=2 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==1){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m-1;
  }
  m=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==0){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m+1;
  }
  return ans;
}
// ============ APPL: applicability substrate ============
// AP region layout (2048 bytes, driver-allocated, persists across queries):
//   0..31   : w[8] feature weights, fixed point x100, init 100
//   32      : nrec (reuse-attempt record count)
//   36      : unused
//   40..1359: 32 records x 40 bytes: F[8] (32B) + outcome (4B) + cost (4B)
//   1400..1431: last computed F (driver-visible for replay analysis)
//   1440..1471: saved F slot (driver uses for C0)
// Features F[8] (all observable pre-reuse, no labels):
//   0: np (gathered path count)  1: plen_max
//   2: c5  3: c4  4: c3  5: c2 (path counts by plen)
//   6: cx (paths containing a non-r1 edge)
//   7: r (query relation)
fn appl_init(AP:[]u8)void {
  let j:i32=0;
  while(j<8){set32(AP,j*4,100); j=j+1;}
  set32(AP,32,0);
  return;
}
// Fill F from pre-gathered paths. No domain labels; pure structure.
fn ma_features_from_paths(W:[]u8,paths:[]u8,np:i32,r:i32,F:[]u8)void {
  let pmax:i32=0;
  let c5:i32=0; let c4:i32=0; let c3:i32=0; let c2:i32=0; let cx:i32=0;
  let p:i32=0;
  while(p<np){
    let base:i32=p*48; let plen:i32=get32(paths,base);
    if(plen>pmax){pmax=plen;}
    if(plen==5){c5=c5+1;}
    if(plen==4){c4=c4+1;}
    if(plen==3){c3=c3+1;}
    if(plen==2){c2=c2+1;}
    let k:i32=0; let bad:i32=0;
    while(k<plen-1){
      let fn2:i32=get32(paths,base+24+k*4);
      if(ng(W,fn2,24)!=1){bad=1;}
      k=k+1;
    }
    if(bad==1){cx=cx+1;}
    p=p+1;
  }
  set32(F,0,np); set32(F,4,pmax);
  set32(F,8,c5); set32(F,12,c4); set32(F,16,c3); set32(F,20,c2);
  set32(F,24,cx); set32(F,28,r);
  return;
}
// Average similarity (x100) of F to records with the wanted outcome.
// -1 if no such records. sim = 10000/(100+2D), D = sum w_j*|d_j| (x100).
fn appl_avg_sim(F:[]u8,AP:[]u8,want_o:i32)i32 {
  let nrec:i32=get32(AP,32);
  let sum:i32=0; let n:i32=0; let i:i32=0;
  while(i<nrec){
    let roff:i32=40+i*40;
    if(get32(AP,roff+32)==want_o){
      let D:i32=0; let j:i32=0;
      while(j<8){
        let d:i32=get32(F,j*4)-get32(AP,roff+j*4);
        if(d<0){d=-d;}
        D=D+get32(AP,j*4)*d;
        j=j+1;
      }
      sum=sum+10000/(100+2*D);
      n=n+1;
    }
    i=i+1;
  }
  if(n==0){return -1;}
  return sum/n;
}
// Applicability decision: 1 = attempt reuse, 0 = skip.
// Attempt iff avg similarity to past successes exceeds avg similarity to
// past failures by a 15-point pessimistic-prior margin. With fewer than 3
// records, be optimistic (explore to build the consequence base).
fn appl_decide(AP:[]u8,F:[]u8)i32 {
  let nrec:i32=get32(AP,32);
  if(nrec<3){return 1;}
  let avs:i32=appl_avg_sim(F,AP,1);
  let avf:i32=appl_avg_sim(F,AP,0);
  if(avs<0){avs=0;}
  if(avf<0){avf=0;}
  if(avs>avf+15){return 1;}
  return 0;
}
// Record a reuse attempt consequence and update the similarity weights.
// Weight rule (consequence-driven): find the nearest opposite-outcome
// record G; w_j += 25*|F_j - G_j| (clamp 800). Features that separate
// this outcome from the opposite outcome gain weight; the similarity
// function is thereby learned from experience, not authored.
fn appl_observe(AP:[]u8,F:[]u8,o:i32,cost:i32)void {
  let nrec:i32=get32(AP,32);
  let roff:i32=40+(nrec%32)*40;
  let j:i32=0;
  while(j<8){set32(AP,roff+j*4,get32(F,j*4)); j=j+1;}
  set32(AP,roff+32,o);
  set32(AP,roff+36,cost);
  if(nrec<32){set32(AP,32,nrec+1);}
  // nearest opposite-outcome record (min D under current weights)
  let best:i32=-1; let bestD:i32=2147483647; let i:i32=0;
  let nn:i32=get32(AP,32);
  while(i<nn){
    let goff:i32=40+i*40;
    if(get32(AP,goff+32)==1-o){
      let D:i32=0; let k:i32=0;
      while(k<8){
        let d:i32=get32(F,k*4)-get32(AP,goff+k*4);
        if(d<0){d=-d;}
        D=D+get32(AP,k*4)*d;
        k=k+1;
      }
      if(D<bestD){bestD=D; best=i;}
    }
    i=i+1;
  }
  if(best>=0){
    let goff:i32=40+best*40;
    let m:i32=0;
    while(m<8){
      let d:i32=get32(F,m*4)-get32(AP,goff+m*4);
      if(d<0){d=-d;}
      let w:i32=get32(AP,m*4)+25*d;
      if(w>800){w=800;}
      set32(AP,m*4,w);
      m=m+1;
    }
  }
  return;
}
// Count alive MAP nodes (reuse candidates).
fn ma_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// ev_query with the trimmed-base test signature. The base's built-in test
// battery (t_c1 etc.) references ev_query; this wrapper satisfies those
// references. The driver uses ma_query directly; this is never called.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let AP:[]u8=z_alloc(2048); appl_init(AP);
  let ST:[]u8=z_alloc(16);
  return ma_query(W,AP,s,r,expected,flags,ST);
}
// Gate path (ma_use_gate()==1, defined in driver): consult APPL; on
// attempt, record the consequence after the outcome is known.
// Naive path: always attempt when MAPs exist (redteam reproduction).
fn ma_query(W:[]u8,AP:[]u8,s:i32,r:i32,expected:i32,flags:i32,ST:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0);
    set32(ST,0,-1); set32(ST,4,0); set32(ST,8,0); set32(ST,12,0);
    return ng(W,n,28);
  }
  let masked:i32=flags&1;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  let F:[]u8=z_alloc(32);
  ma_features_from_paths(W,paths,np,r,F);
  let q:i32=0;
  while(q<8){set32(AP,1400+q*4,get32(F,q*4)); q=q+1;}
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let gate:i32=0;
  if(ma_count_maps(W)>0){
    if(ma_use_gate()==1){gate=appl_decide(AP,F);}
    else {gate=1;}
  }
  set32(ST,0,gate);
  let ra:i32=-2;
  if(gate==1){
    ra=rebind_try_paths(W,s,r,expected,masked,rbs,paths,np);
  }
  let rbt:i32=get32(rbs,0); let rbr:i32=get32(rbs,4);
  set32(ST,4,rbt); set32(ST,8,rbr);
  hs(W,56,rbt); hs(W,60,rbr);
  if(ra!=-2){
    hs(W,16,rbt*1024+rbr); log_ev(W,2,s,r,ra,1,0,0);
    set32(ST,12,0);
    if(ma_use_gate()==1){appl_observe(AP,F,1,rbt);}
    return ra;
  }
  let ans:i32=mp_run(W,s,r,expected,flags);
  let lt:i32=hg(W,16)/1024;
  set32(ST,12,lt);
  if(ma_use_gate()==1 && gate==1){appl_observe(AP,F,0,rbt+lt);}
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0); miss_inquire(W,s,r);
  return -2;
}

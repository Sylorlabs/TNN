// ============ H3-lite Node 1: Trial search order policy ============
// Policy node: tag 40, subtype field 4 = 1.
// Fields 8,12,16,20,24,28: six order slots (family ids 0-5).
// Field 32: first-choice rejection count (saturating).
// Family ids: 0=chain k=2, 1=chain k=3, 2=chain k=4, 3=sum, 4=count, 5=single hop.
// Initial order: 0,1,2,3,4,5 (matches frozen t2_trial source order: k=2,3,4,
// then sum, then count, then single hop).
// NOTE: Prereg 9084a7760 describes initial as 2,1,0,3,4,5 ("chains k=4,3,2").
// The frozen source (line 593: k=2; while(k<=4)) actually tries k=2,3,4
// ascending, i.e. families 0,1,2. This implementation copies the ACTUAL
// source order per the "copy-then-revise" bootstrap rule. The prereg's
// description of the current order is factually incorrect; the mechanism
// (policy-driven order with Hebbian update) is as specified.
fn h3n1_find_policy(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==1){return n;}
    n=n+1;
  }
  return -1;
}
fn h3n1_get_policy(W:[]u8)i32 {
  let p:i32=h3n1_find_policy(W);
  if(p>=0){return p;}
  p=alloc_node(W);
  if(p<0){return -1;}
  ns(W,p,0,40); ns(W,p,4,1);
  ns(W,p,8,0); ns(W,p,12,1); ns(W,p,16,2);
  ns(W,p,20,3); ns(W,p,24,4); ns(W,p,28,5);
  ns(W,p,32,0);
  return p;
}
// Hebbian promotion: on success for family at slot>0, swap one step earlier.
fn h3n1_promote(W:[]u8,pol:i32,slot:i32)void {
  if(slot<=0 || slot>=6){return;}
  let fa:i32=8+(slot-1)*4; let fb:i32=8+slot*4;
  let ta:i32=ng(W,pol,fa); let tb:i32=ng(W,pol,fb);
  ns(W,pol,fa,tb); ns(W,pol,fb,ta);
  return;
}
// Exhaustion: increment field 32; if >8, demote first-choice one step.
fn h3n1_exhaust(W:[]u8,pol:i32)void {
  let c:i32=ng(W,pol,32)+1;
  if(c>1000000){c=1000000;}
  ns(W,pol,32,c);
  if(c>8){
    let f0:i32=ng(W,pol,8); let f1:i32=ng(W,pol,12);
    ns(W,pol,8,f1); ns(W,pol,12,f0);
    ns(W,pol,32,0);
  }
  return;
}
// Family attempt: chain with specific k (fam 0->k=2, 1->k=3, 2->k=4).
fn h3n1_fam_chain(W:[]u8,k:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let p:i32=0;
  while(p<np && ans==-2){
    let base:i32=p*48;
    if(get32(paths,base)==k+1){
      let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
      let j:i32=0;
      while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
      j=0;
      while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
      let root:i32=t2_asm_chain(W,v,k+1,f);
      let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
      if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
    }
    p=p+1;
  }
  return ans;
}
// Family 3: sum.
fn h3n1_fam_sum(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
  let m:i32=t2_gather_sum(W,s,vals,sf);
  let sz:i32=m;
  while(sz>=1 && ans==-2){
    let mask:i32=(1<<m)-1;
    while(mask>0 && ans==-2){
      if(popcnt(mask)==sz){
        let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
        let c:i32=0; let b:i32=0;
        while(b<m){
          if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
          b=b+1;
        }
        let root:i32=t2_asm_sum(W,sv,c);
        let v2:i32=t2_try_verify(W,root,0,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
      }
      mask=mask-1;
    }
    sz=sz-1;
  }
  return ans;
}
// Family 4: count.
fn h3n1_fam_count(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
  let i:i32=0;
  while(i<nr && ans==-2){
    let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
    let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
    if(len>=2){
      let root:i32=t2_asm_count(W,v,len,f);
      let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
      if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
    }
    i=i+1;
  }
  return ans;
}
// Family 5: single hop (chain k=2 via paths of length 2).
fn h3n1_fam_single(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let p:i32=0;
  while(p<np && ans==-2){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
      set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
      set32(f,0,get32(paths,base+24));
      let root:i32=t2_asm_chain(W,v,2,f);
      let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
      if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
    }
    p=p+1;
  }
  return ans;
}
// Dispatch one family by id, respecting dc/di/comb gates.
fn h3n1_dispatch(W:[]u8,fam:i32,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  if(fam==0 || fam==1 || fam==2){
    if(dc==0){return h3n1_fam_chain(W,fam+2,s,r,expected,masked,paths,np,st);}
    return -2;
  }
  if(fam==3){
    if(comb_present(W)>=0){return h3n1_fam_sum(W,s,r,expected,masked,st);}
    return -2;
  }
  if(fam==4){
    if(di==0){return h3n1_fam_count(W,s,r,expected,masked,st);}
    return -2;
  }
  if(fam==5){
    return h3n1_fam_single(W,s,r,expected,masked,paths,np,st);
  }
  return -2;
}
// t2_trial: H3-lite Node 1 version. Search order is policy-driven.
// The six order slots in the policy node (tag 40, subtype 1) determine
// family attempt order. Hebbian promotion on success; demotion on
// repeated exhaustion. Per-family assembly code is unchanged.
fn t2_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  let pol:i32=h3n1_get_policy(W);
  if(pol>=0){
    let slot:i32=0;
    while(slot<6 && ans==-2){
      let fam:i32=ng(W,pol,8+slot*4);
      ans=h3n1_dispatch(W,fam,s,r,expected,masked,dc,di,paths,np,st);
      if(ans!=-2 && slot>0){h3n1_promote(W,pol,slot);}
      slot=slot+1;
    }
    if(ans==-2){h3n1_exhaust(W,pol);}
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}

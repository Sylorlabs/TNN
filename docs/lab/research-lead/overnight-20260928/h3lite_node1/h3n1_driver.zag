// H3-lite Node 1 test driver.
// Verifies: policy node creation, initial order, Hebbian promotion,
// exhaustion demotion, and basic trial functionality.
fn h3n1_emit_order(W:[]u8,pol:i32)void {
  emit("order: ");
  let s:i32=0;
  while(s<6){
    e64(ng(W,pol,8+s*4));
    if(s<5){emit(",");}
    s=s+1;
  }
  emit(" rej=");
  e64(ng(W,pol,32));
  emit("\n");
  return;
}
fn h3n1_test()i32 {
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let ok:i32=1;

  // Test 1: policy node created with initial order 0,1,2,3,4,5
  let pol:i32=h3n1_get_policy(W);
  emit("T1 pol node: "); e64(pol); emit("\n");
  if(pol<0){ok=0; emit("FAIL: no policy node\n");}
  h3n1_emit_order(W,pol);
  let s:i32=0;
  while(s<6){
    if(ng(W,pol,8+s*4)!=s){ok=0; emit("FAIL: initial order wrong at slot "); e64(s); emit("\n");}
    s=s+1;
  }
  if(ng(W,pol,32)!=0){ok=0; emit("FAIL: initial rej not 0\n");}

  // Test 2: Hebbian promotion - family at slot 2 succeeds, should swap with slot 1
  // Set order to [0,1,5,3,4,2] then promote slot 2 (family 5) -> [0,5,1,3,4,2]
  ns(W,pol,8,0); ns(W,pol,12,1); ns(W,pol,16,5);
  ns(W,pol,20,3); ns(W,pol,24,4); ns(W,pol,28,2);
  h3n1_promote(W,pol,2);
  emit("T2 after promote slot2: ");
  h3n1_emit_order(W,pol);
  if(ng(W,pol,12)!=5 || ng(W,pol,16)!=1){ok=0; emit("FAIL: promote swap wrong\n");}

  // Test 3: promote slot 0 does nothing
  let o0:i32=ng(W,pol,8);
  h3n1_promote(W,pol,0);
  if(ng(W,pol,8)!=o0){ok=0; emit("FAIL: promote slot0 changed\n");}

  // Test 4: exhaustion - 9 calls should demote first-choice
  // Reset to [0,1,2,3,4,5], rej=0
  ns(W,pol,8,0); ns(W,pol,12,1); ns(W,pol,16,2);
  ns(W,pol,20,3); ns(W,pol,24,4); ns(W,pol,28,5);
  ns(W,pol,32,0);
  let i:i32=0;
  while(i<8){
    h3n1_exhaust(W,pol);
    i=i+1;
  }
  emit("T4 after 8 exhausts: ");
  h3n1_emit_order(W,pol);
  if(ng(W,pol,32)!=8){ok=0; emit("FAIL: rej should be 8\n");}
  if(ng(W,pol,8)!=0){ok=0; emit("FAIL: order should not change yet\n");}
  h3n1_exhaust(W,pol); // 9th, should demote
  emit("T4 after 9th exhaust: ");
  h3n1_emit_order(W,pol);
  if(ng(W,pol,8)!=1 || ng(W,pol,12)!=0){ok=0; emit("FAIL: demote swap wrong\n");}
  if(ng(W,pol,32)!=0){ok=0; emit("FAIL: rej should reset to 0\n");}

  // Test 5: trial runs on miss and creates policy node
  // Teach facts that do NOT directly answer (99,20): need trial to run.
  // Teach a chain: (10,20,30), (30,20,40). Query (10,20) with expected=40
  // in masked mode (flags=1) to force trial to search.
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  ev_teach(W2,10,20,30);
  ev_teach(W2,30,20,40);
  // Masked query for (10,20): activate finds (10,20,30) directly, so use
  // a subject with no direct fact. Teach (50,20,60),(60,20,70), query (50,20)
  // masked: activate misses (no... actually activate will find (50,20,60)).
  // Simplest: query a completely unknown (s,r) to force trial miss path.
  // Trial will run, fail (no data), policy node should be created.
  let ans:i32=ev_query(W2,99,20,-2,1);
  emit("T5 query ans: "); e64(ans); emit("\n");
  // Check policy node exists in W2 (trial should have created it)
  let pol2:i32=h3n1_find_policy(W2);
  emit("T5 pol2: "); e64(pol2); emit("\n");
  if(pol2<0){ok=0; emit("FAIL: no policy in W2\n");}
  // Test 6: Hebbian promotion via real trial success
  // Teach chain (10,20,30),(30,20,40). Query (10,20) masked.
  // Activate finds (10,20,30) directly... need to avoid direct hit.
  // Use fresh W3: teach only the chain links, query the start with
  // a relation that has no direct fact.
  let W3:[]u8=z_alloc(110656);
  tnn2_init(W3);
  // Build a 2-hop chain for family 0 (k=2): need paths of length 3
  // Simpler: verify policy order is READ by trial via white-box.
  // Manually set W3 policy to [5,4,3,2,1,0] (reverse), run trial on
  // empty query, verify order unchanged (trial failed, rej incremented).
  let pol3:i32=h3n1_get_policy(W3);
  ns(W3,pol3,8,5); ns(W3,pol3,12,4); ns(W3,pol3,16,3);
  ns(W3,pol3,20,2); ns(W3,pol3,24,1); ns(W3,pol3,28,0);
  ns(W3,pol3,32,0);
  let ans3:i32=ev_query(W3,77,20,-2,1);
  emit("T6 ans3: "); e64(ans3); emit(" rej: "); e64(ng(W3,pol3,32)); emit("\n");
  if(ng(W3,pol3,32)!=1){ok=0; emit("FAIL: rej not incremented\n");}
  // Order should be unchanged (no demotion until 9)
  if(ng(W3,pol3,8)!=5){ok=0; emit("FAIL: order changed unexpectedly\n");}

  // Test 7: Real trial triggers Hebbian promotion
  // Setup: teach (10,99,30). Query (10,20) masked.
  // Activate misses (no r=20). Trial runs.
  // Path [10,30] length 2 exists.
  // Policy [0,5,1,2,3,4]: slot0 fam0 needs len3 (fail), slot1 fam5 succeeds.
  // Hebbian should promote fam5: [5,0,1,2,3,4].
  let W4:[]u8=z_alloc(110656);
  tnn2_init(W4);
  ev_teach(W4,10,99,30);
  let pol4:i32=h3n1_get_policy(W4);
  ns(W4,pol4,8,0); ns(W4,pol4,12,5); ns(W4,pol4,16,1);
  ns(W4,pol4,20,2); ns(W4,pol4,24,3); ns(W4,pol4,28,4);
  ns(W4,pol4,32,0);
  emit("T7 before: ");
  h3n1_emit_order(W4,pol4);
  let ans4:i32=ev_query(W4,10,20,-2,1);
  emit("T7 ans: "); e64(ans4); emit("\n");
  emit("T7 after: ");
  h3n1_emit_order(W4,pol4);
  if(ans4==-2){ok=0; emit("FAIL: trial should succeed\n");}
  if(ng(W4,pol4,8)!=5 || ng(W4,pol4,12)!=0){
    ok=0; emit("FAIL: Hebbian promotion did not fire\n");
  }

  if(ok==1){emit("H3N1-ALL-PASS\n");} else {emit("H3N1-FAIL\n");}
  return ok;
}
fn main()i32 {
  let r:i32=h3n1_test();
  if(r==1){return 0;} else {return 1;}
}

// hyppop.zag -- Competing Hypothesis Population Scale Test (HYPPOP-1).
// Pure Zag. No Python anywhere.
//
// A synthetic world (10 binary variables, 6 true conjunctive causal laws,
// 4 noise variables, 200 episodes x 20 timesteps, one concept shift at
// episode 100) is generated deterministically from a fixed seed. A
// population of 2200 competing causal hypotheses (400 singles + 1800
// conjunctions of the form "src1 [AND src2] at t predicts dst at
// t+delay") is maintained: incremental per-episode evidence updates,
// periodic per-destination contests that prune losers, and five query
// types. Metrics (timings, RSS) go to stderr; stdout is deterministic.
//
// Modes: no args (or "run") = full test, stdout deterministic.
// "emit_sql <path>" = regenerate the identical world and write world.sql
// (hypothesis + episode INSERTs) for the SQLite baseline.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn eerr(s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,2,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn e64(v:i64)void { emit(i64s(v)); return; }
fn e32(v:i32)void { emit(i64s(v as i64)); return; }
fn eln()void { emit("\n"); return; }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn get32(b:[]u8,i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8,i:i32,v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn get64(b:[]u8,i:i32)i64 {
  let lo:i64=(get32(b,i) as i64)& 4294967295;
  let hi:i64=get32(b,i+4) as i64;
  return lo|(hi<<32);
}
fn set64(b:[]u8,i:i32,v:i64)void {
  set32(b,i,(v& 4294967295) as i32);
  set32(b,i+4,(v>>32) as i32);
  return;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=65536;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=(ts[0] as i64)|((ts[1] as i64)<<8)|((ts[2] as i64)<<16)|((ts[3] as i64)<<24)|((ts[4] as i64)<<32)|((ts[5] as i64)<<40)|((ts[6] as i64)<<48)|((ts[7] as i64)<<56);
  let ns:i64=(ts[8] as i64)|((ts[9] as i64)<<8)|((ts[10] as i64)<<16)|((ts[11] as i64)<<24)|((ts[12] as i64)<<32)|((ts[13] as i64)<<40)|((ts[14] as i64)<<48)|((ts[15] as i64)<<56);
  z_free(ts);
  return sec*1000+ns/1000000;
}
fn peak_rss_kb()i64 {
  let d:[]u8=read_file("/proc/self/status");
  if(d.len==0){return 0;}
  let key:[]u8="VmHWM:";
  let p:i32=0;
  let found:i32=-1;
  while(p+6<d.len){
    let k:i32=0;
    while(k<6 && d[p+k]==key[k]){k=k+1;}
    if(k==6){found=p;break;}
    p=p+1;
  }
  if(found<0){return 0;}
  let s:i32=found+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
// xorshift32 PRNG, deterministic
fn rng_next(st:[]u8,ro:i32)i32 {
  let x:i32=get32(st,ro);
  x=x^(x<<13);
  x=x^(x>>17);
  x=x^(x<<5);
  if(x<0){x=-(x+1);}
  set32(st,ro,x);
  return x;
}
fn rng_range(st:[]u8,ro:i32,n:i32)i32 {
  if(n<1){return 0;}
  return rng_next(st,ro)%n;
}

// ============ constants ============
fn NVAR()i32 { return 10; }
fn NEP()i32 { return 200; }
fn NT()i32 { return 20; }
fn NLAW()i32 { return 6; }
fn NSINGLE()i32 { return 400; }
fn NCONJ()i32 { return 1800; }
fn NHYP()i32 { return 2200; }
fn SEED()i32 { return 424242; }
// state buffer layout (one []u8, offsets in bytes)
fn O_RNG()i32 { return 0; }
fn O_S1()i32 { return 4; }
fn O_S2()i32 { return 8804; }
fn O_DST()i32 { return 17604; }
fn O_DEL()i32 { return 26404; }
fn O_F()i32 { return 35204; }
fn O_A()i32 { return 44004; }
fn O_FIRED()i32 { return 52804; }
fn O_ALIVE()i32 { return 61604; }
fn O_ST()i32 { return 70404; }
fn O_LS1()i32 { return 71204; }
fn O_LS2()i32 { return 71228; }
fn O_LD()i32 { return 71252; }
fn O_LID()i32 { return 71276; }
fn O_SHS1()i32 { return 71300; }
fn O_SHS2()i32 { return 71304; }
fn O_SHD()i32 { return 71308; }
fn O_SHID()i32 { return 71312; }
fn O_PRUNED()i32 { return 71316; }
fn O_RANK()i32 { return 71320; }
fn O_UPD()i32 { return 71340; }
fn W_SIZE()i32 { return 71348; }

fn new_world()[]u8 {
  let w:[]u8=z_alloc(W_SIZE());
  set32(w,O_RNG(),SEED());
  return w;
}

// pair index p -> (s1<s2)
fn pair12(p:i32,out:[]u8)void {
  let c:i32=0;
  let a:i32=0;
  while(a<9){
    let b:i32=a+1;
    while(b<10){
      if(c==p){set32(out,0,a);set32(out,4,b);return;}
      c=c+1; b=b+1;
    }
    a=a+1;
  }
  set32(out,0,0);set32(out,4,1);
  return;
}
fn pair_idx(s1:i32,s2:i32)i32 {
  let c:i32=0;
  let a:i32=0;
  while(a<9){
    let b:i32=a+1;
    while(b<10){
      if(a==s1 && b==s2){return c;}
      c=c+1; b=b+1;
    }
    a=a+1;
  }
  return 0;
}
fn conj_id(s1:i32,s2:i32,dst:i32,del:i32)i32 {
  let a:i32=s1; let b:i32=s2;
  if(a>b){let t:i32=a;a=b;b=t;}
  return NSINGLE()+pair_idx(a,b)+45*dst+450*del;
}

// ============ world generation ============
fn gen_laws(w:[]u8)void {
  let d:i32=0;
  while(d<NLAW()){
    let dl:i32=rng_range(w,O_RNG(),4);
    let s1:i32=0; let s2:i32=0;
    if(dl==0){
      s1=rng_range(w,O_RNG(),d+1);
      s2=rng_range(w,O_RNG(),d+1);
      while(s2==s1){s2=rng_range(w,O_RNG(),d+1);}
    } else {
      s1=rng_range(w,O_RNG(),10);
      s2=rng_range(w,O_RNG(),10);
      while(s2==s1){s2=rng_range(w,O_RNG(),10);}
    }
    if(s1>s2){let t:i32=s1;s1=s2;s2=t;}
    set32(w,O_LS1()+d*4,s1); set32(w,O_LS2()+d*4,s2); set32(w,O_LD()+d*4,dl);
    set32(w,O_LID()+d*4,conj_id(s1,s2,d,dl));
    d=d+1;
  }
  let dl:i32=rng_range(w,O_RNG(),4);
  let s1:i32=0; let s2:i32=0;
  if(dl==0){
    s1=rng_range(w,O_RNG(),3); s2=rng_range(w,O_RNG(),3);
    while(s2==s1){s2=rng_range(w,O_RNG(),3);}
  } else {
    s1=rng_range(w,O_RNG(),10); s2=rng_range(w,O_RNG(),10);
    while(s2==s1){s2=rng_range(w,O_RNG(),10);}
  }
  if(s1>s2){let t:i32=s1;s1=s2;s2=t;}
  if(s1==get32(w,O_LS1()+8) && s2==get32(w,O_LS2()+8) && dl==get32(w,O_LD()+8)){
    dl=(dl+1)%4;
  }
  set32(w,O_SHS1(),s1); set32(w,O_SHS2(),s2); set32(w,O_SHD(),dl);
  set32(w,O_SHID(),conj_id(s1,s2,2,dl));
  return;
}
fn gen_episode(w:[]u8,ep:i32)void {
  let t:i32=0;
  while(t<NT()){
    let v:i32=0;
    while(v<NVAR()){
      let rb:i32=rng_range(w,O_RNG(),2);
      let val:i32=rb;
      if(v<NLAW()){
        let s1:i32=get32(w,O_LS1()+v*4);
        let s2:i32=get32(w,O_LS2()+v*4);
        let dl:i32=get32(w,O_LD()+v*4);
        if(ep>=100 && v==2){
          s1=get32(w,O_SHS1()); s2=get32(w,O_SHS2()); dl=get32(w,O_SHD());
        }
        if(t-dl>=0){
          let a:i32=get32(w,O_ST()+(t-dl)*NVAR()*4+s1*4);
          let b:i32=get32(w,O_ST()+(t-dl)*NVAR()*4+s2*4);
          if(a==1 && b==1){val=1;} else {val=0;}
        }
      }
      set32(w,O_ST()+t*NVAR()*4+v*4,val);
      v=v+1;
    }
    t=t+1;
  }
  return;
}

// ============ hypothesis population ============
fn init_hyps(w:[]u8)void {
  let h:i32=0;
  while(h<NSINGLE()){
    set32(w,O_S1()+h*4,h%10);
    set32(w,O_S2()+h*4,-1);
    set32(w,O_DST()+h*4,(h/10)%10);
    set32(w,O_DEL()+h*4,h/100);
    h=h+1;
  }
  let pr:[]u8=z_alloc(8);
  h=0;
  while(h<NCONJ()){
    let p:i32=h%45;
    pair12(p,pr);
    set32(w,O_S1()+(NSINGLE()+h)*4,get32(pr,0));
    set32(w,O_S2()+(NSINGLE()+h)*4,get32(pr,4));
    set32(w,O_DST()+(NSINGLE()+h)*4,(h/45)%10);
    set32(w,O_DEL()+(NSINGLE()+h)*4,h/450);
    h=h+1;
  }
  z_free(pr);
  h=0;
  while(h<NHYP()){
    set32(w,O_F()+h*4,0); set32(w,O_A()+h*4,0);
    set32(w,O_FIRED()+h*4,0); set32(w,O_ALIVE()+h*4,1);
    h=h+1;
  }
  return;
}
fn score(w:[]u8,h:i32)i32 {
  return get32(w,O_F()+h*4)-get32(w,O_A()+h*4);
}
fn feed_episode(w:[]u8)void {
  let h:i32=0;
  while(h<NHYP()){
    if(get32(w,O_ALIVE()+h*4)==0){h=h+1;continue;}
    let s1:i32=get32(w,O_S1()+h*4);
    let s2:i32=get32(w,O_S2()+h*4);
    let dst:i32=get32(w,O_DST()+h*4);
    let dl:i32=get32(w,O_DEL()+h*4);
    let t:i32=0;
    while(t+dl<NT()){
      let fire:i32=0;
      if(get32(w,O_ST()+t*NVAR()*4+s1*4)==1){
        if(s2<0){fire=1;}
        else { if(get32(w,O_ST()+t*NVAR()*4+s2*4)==1){fire=1;} }
      }
      if(fire==1){
        set32(w,O_FIRED()+h*4,get32(w,O_FIRED()+h*4)+1);
        set64(w,O_UPD(),get64(w,O_UPD())+1);
        if(get32(w,O_ST()+(t+dl)*NVAR()*4+dst*4)==1){
          set32(w,O_F()+h*4,get32(w,O_F()+h*4)+1);
        } else {
          set32(w,O_A()+h*4,get32(w,O_A()+h*4)+1);
        }
      }
      t=t+1;
    }
    h=h+1;
  }
  return;
}
fn contest(w:[]u8)void {
  let sel:[]u8=z_alloc(NHYP()*4);
  let d:i32=0;
  while(d<NVAR()){
    let r:i32=0;
    while(r<8){
      let best:i32=-1;
      let bs:i32=-2147483647;
      let h:i32=0;
      while(h<NHYP()){
        if(get32(w,O_ALIVE()+h*4)==1 && get32(w,O_DST()+h*4)==d && get32(sel,h*4)==0){
          let s:i32=score(w,h);
          if(s>bs || (s==bs && (best<0 || h<best))){bs=s;best=h;}
        }
        h=h+1;
      }
      if(best>=0){set32(sel,best*4,1);}
      r=r+1;
    }
    let h2:i32=0;
    while(h2<NHYP()){
      if(get32(w,O_ALIVE()+h2*4)==1 && get32(w,O_DST()+h2*4)==d && get32(sel,h2*4)==0){
        set32(w,O_ALIVE()+h2*4,0);
        set32(w,O_PRUNED(),get32(w,O_PRUNED())+1);
      }
      h2=h2+1;
    }
    d=d+1;
  }
  z_free(sel);
  return;
}
fn rank_shifted(w:[]u8)i32 {
  let sid:i32=get32(w,O_SHID());
  let ss:i32=score(w,sid);
  let r:i32=1;
  let h:i32=0;
  while(h<NHYP()){
    if(h!=sid && get32(w,O_ALIVE()+h*4)==1 && get32(w,O_DST()+h*4)==2 && score(w,h)>ss){r=r+1;}
    h=h+1;
  }
  return r;
}

// ============ queries ============
fn q1_top8(w:[]u8)void {
  emit("Q1_TOP8\n");
  let sel:[]u8=z_alloc(NHYP()*4);
  let r:i32=0;
  while(r<8){
    let best:i32=-1;
    let bs:i32=-2147483647;
    let h:i32=0;
    while(h<NHYP()){
      if(get32(w,O_ALIVE()+h*4)==1 && get32(sel,h*4)==0){
        let s:i32=score(w,h);
        if(s>bs || (s==bs && (best<0 || h<best))){bs=s;best=h;}
      }
      h=h+1;
    }
    if(best<0){break;}
    set32(sel,best*4,1);
    emit("  id="); e32(best);
    emit(" s1="); e32(get32(w,O_S1()+best*4));
    emit(" s2="); e32(get32(w,O_S2()+best*4));
    emit(" dst="); e32(get32(w,O_DST()+best*4));
    emit(" del="); e32(get32(w,O_DEL()+best*4));
    emit(" score="); e32(bs);
    emit(" f="); e32(get32(w,O_F()+best*4));
    emit(" a="); e32(get32(w,O_A()+best*4));
    eln();
    r=r+1;
  }
  z_free(sel);
  return;
}
fn q2_best_per_dst(w:[]u8)void {
  emit("Q2_BEST_PER_DST\n");
  let d:i32=0;
  while(d<NVAR()){
    let best:i32=-1;
    let bs:i32=-2147483647;
    let h:i32=0;
    while(h<NHYP()){
      if(get32(w,O_ALIVE()+h*4)==1 && get32(w,O_DST()+h*4)==d){
        let s:i32=score(w,h);
        if(s>bs || (s==bs && (best<0 || h<best))){bs=s;best=h;}
      }
      h=h+1;
    }
    emit("  dst="); e32(d);
    emit(" id="); e32(best);
    emit(" score="); e32(bs);
    eln();
    d=d+1;
  }
  return;
}
fn q3_trails(w:[]u8)void {
  emit("Q3_TRAILS\n");
  let ids:[]u8=z_alloc(3*4);
  set32(ids,0,get32(w,O_LID()));
  set32(ids,4,get32(w,O_SHID()));
  set32(ids,8,NSINGLE());
  let k:i32=0;
  while(k<3){
    let h:i32=get32(ids,k*4);
    emit("  id="); e32(h);
    emit(" alive="); e32(get32(w,O_ALIVE()+h*4));
    emit(" f="); e32(get32(w,O_F()+h*4));
    emit(" a="); e32(get32(w,O_A()+h*4));
    emit(" fired="); e32(get32(w,O_FIRED()+h*4));
    eln();
    k=k+1;
  }
  z_free(ids);
  return;
}
fn q4_prune(w:[]u8)i32 {
  let n:i32=0;
  let h:i32=0;
  while(h<NHYP()){
    if(get32(w,O_ALIVE()+h*4)==1 && score(w,h)<0){
      set32(w,O_ALIVE()+h*4,0);
      n=n+1;
    }
    h=h+1;
  }
  emit("Q4_PRUNED_SCORE_LT0 "); e32(n); eln();
  return n;
}
fn q5_ranks(w:[]u8)void {
  emit("Q5_SHIFT_RECOVERY_RANKS\n");
  emit("  ep100="); e32(get32(w,O_RANK()));
  emit(" ep125="); e32(get32(w,O_RANK()+4));
  emit(" ep150="); e32(get32(w,O_RANK()+8));
  emit(" ep175="); e32(get32(w,O_RANK()+12));
  emit(" ep200="); e32(get32(w,O_RANK()+16));
  eln();
  return;
}

// ============ main run ============
fn full_run()i32 {
  let w:[]u8=new_world();
  gen_laws(w);
  init_hyps(w);
  emit("HYPPOP1\n");
  emit("HYPOTHESES "); e32(NHYP()); eln();
  emit("SINGLES "); e32(NSINGLE()); emit(" CONJUNCTIONS "); e32(NCONJ()); eln();
  emit("LAW_IDS");
  let d:i32=0;
  while(d<NLAW()){ emit(" "); e32(get32(w,O_LID()+d*4)); d=d+1; }
  eln();
  emit("SHIFT_ID "); e32(get32(w,O_SHID()));
  emit(" SHIFT_TRIPLE "); e32(get32(w,O_SHS1()));
  emit(" "); e32(get32(w,O_SHS2()));
  emit(" "); e32(get32(w,O_SHD())); eln();
  let t0:i64=now_ms();
  let ep:i32=0;
  let rk:i32=0;
  while(ep<NEP()){
    gen_episode(w,ep);
    feed_episode(w);
    if(ep==49 || ep==99 || ep==149 || ep==199){contest(w);}
    if(ep==99 || ep==124 || ep==149 || ep==174 || ep==199){
      set32(w,O_RANK()+rk*4,rank_shifted(w));
      rk=rk+1;
    }
    ep=ep+1;
  }
  let t1:i64=now_ms();
  let alive_n:i32=0;
  let h:i32=0;
  while(h<NHYP()){ if(get32(w,O_ALIVE()+h*4)==1){alive_n=alive_n+1;} h=h+1; }
  emit("FEED_DONE episodes="); e32(NEP());
  emit(" updates="); e64(get64(w,O_UPD()));
  emit(" alive="); e32(alive_n);
  emit(" contest_pruned="); e32(get32(w,O_PRUNED()));
  eln();
  let t2:i64=now_ms();
  q1_top8(w);
  q2_best_per_dst(w);
  q3_trails(w);
  let nq4:i32=q4_prune(w);
  if(nq4<0){emit("impossible\n");}
  q5_ranks(w);
  let t3:i64=now_ms();
  let rss:i64=peak_rss_kb();
  emit("DONE\n");
  eerr("feed_ms=");
  eerr(i64s(t1-t0));
  eerr(" query_ms=");
  eerr(i64s(t3-t2));
  eerr(" peak_rss_kb=");
  eerr(i64s(rss));
  eerr("\n");
  z_free(w);
  return 0;
}

// ============ emit_sql ============
fn sql_emit_hyps(w:[]u8,fd:i64)void {
  let buf:[]u8=z_alloc(4096);
  let at:i32=0;
  at=app(buf,at,"CREATE TABLE hypothesis(id INTEGER PRIMARY KEY,s1 INTEGER,s2 INTEGER,dst INTEGER,delay INTEGER,f INTEGER,a INTEGER,fired INTEGER,alive INTEGER);\n");
  at=app(buf,at,"CREATE TABLE states(ep INTEGER,t INTEGER,var INTEGER,val INTEGER);\n");
  at=app(buf,at,"CREATE INDEX idx_states ON states(ep,var,val,t);\n");
  w_write(fd,buf[0..at]);
  let h:i32=0;
  while(h<NHYP()){
    at=0;
    at=app(buf,at,"INSERT INTO hypothesis VALUES(");
    at=app(buf,at,i64s(h as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(get32(w,O_S1()+h*4) as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(get32(w,O_S2()+h*4) as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(get32(w,O_DST()+h*4) as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(get32(w,O_DEL()+h*4) as i64)); at=app(buf,at,",0,0,0,1);\n");
    w_write(fd,buf[0..at]);
    h=h+1;
  }
  z_free(buf);
  return;
}
fn sql_emit_episodes(w:[]u8,fd:i64)void {
  let buf:[]u8=z_alloc(8192);
  let ep:i32=0;
  while(ep<NEP()){
    gen_episode(w,ep);
    let at:i32=0;
    let t:i32=0;
    while(t<NT()){
      let v:i32=0;
      while(v<NVAR()){
        at=app(buf,at,"INSERT INTO states VALUES(");
        at=app(buf,at,i64s(ep as i64)); at=app(buf,at,",");
        at=app(buf,at,i64s(t as i64)); at=app(buf,at,",");
        at=app(buf,at,i64s(v as i64)); at=app(buf,at,",");
        at=app(buf,at,i64s(get32(w,O_ST()+t*NVAR()*4+v*4) as i64)); at=app(buf,at,");\n");
        if(at>7000){w_write(fd,buf[0..at]);at=0;}
        v=v+1;
      }
      t=t+1;
    }
    if(at>0){w_write(fd,buf[0..at]);}
    ep=ep+1;
  }
  z_free(buf);
  return;
}
fn do_emit_sql(path:[]u8)i32 {
  let w:[]u8=new_world();
  gen_laws(w);
  init_hyps(w);
  let fd:i64=w_open(path);
  if(fd<0){emit("cannot open sql output\n");return 1;}
  sql_emit_hyps(w,fd);
  sql_emit_episodes(w,fd);
  w_close(fd);
  emit("wrote ");
  emit(path);
  eln();
  z_free(w);
  return 0;
}

fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(a1.len==0){return full_run();}
  if(streq(a1,"run")==1){return full_run();}
  if(streq(a1,"emit_sql")==1){return do_emit_sql(_zag_arg(2));}
  emit("usage: hyppop [run|emit_sql <path>]\n");
  return 1;
}

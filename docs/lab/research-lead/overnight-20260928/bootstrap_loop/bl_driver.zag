// ===== BOOTSTRAP LOOP DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original test main removed).
// Cognition code untouched. Tests the circular confidence loop predicted by
// the teach-observe analysis (8744796fb): bootstrap teaches its own inferred
// value as a FACT via ev_teach_in, and later bootstrap scans count that FACT
// as an "observation", so the evidence base becomes progressively
// self-referential until the scan window holds zero externally-grounded
// observations.
//
// Why return value 42 implies bootstrap fired: for each queried subject
// 2001+i no FACT with that subject exists, so t2_gather finds no length>=2
// path, t2_gather_sum/t2_rels find no subject facts, and t2_trial returns -2
// deterministically. activate misses (subject filter). The only remaining
// path that can return 42 is bootstrap_miss.

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Replicate the bootstrap_miss evidence scan for relation r:
// most-recent-first (indices 1023 down to 2), live tag-1 nodes, up to 6.
// For each counted node report index, subject, object, and class
// (cls=1 genuine seed, cls=0 self-generated).
fn scan_win(W:[]u8,p:[]u8,r:i32,g1:i32,g2:i32,g3:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      let cls:i32=0;
      if(n==g1 || n==g2 || n==g3){cls=1;}
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit(" cls"); e64(cls); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

fn bl_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: seed 3 genuine external observations (researcher-supplied,
  // not learner-generated). ev_teach returns the FACT node index.
  let g1:i32=ev_teach(W,1001,50,42); rep("B","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("B","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("B","g3",g3);
  // Phase 2: query 8 fresh subjects. Each should miss activate, fail the
  // trial, and fire bootstrap -> 42, teaching a self-generated FACT.
  let i:i32=0;
  while(i<8){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("B q"); e64(i); emit("="); e64(q); emit("\n");
    scan_win(W,"B",50,g1,g2,g3,i);
    i=i+1;
  }
  // Phase 3: zero the genuine seeds in place (slots stay occupied, indices
  // stable). If the loop is self-sustaining, bootstrap keeps firing on
  // purely self-generated evidence.
  ns(W,g1,0,0); ns(W,g1,20,0); ns(W,g1,24,0); ns(W,g1,28,0); ns(W,g1,32,0);
  ns(W,g2,0,0); ns(W,g2,20,0); ns(W,g2,24,0); ns(W,g2,28,0); ns(W,g2,32,0);
  ns(W,g3,0,0); ns(W,g3,20,0); ns(W,g3,24,0); ns(W,g3,28,0); ns(W,g3,32,0);
  emit("B SEEDS-ZEROED\n");
  i=0;
  while(i<2){
    let q2:i32=ev_query(W,2011+i,50,-2,0);
    emit("B qx"); e64(i); emit("="); e64(q2); emit("\n");
    scan_win(W,"B",50,-1,-1,-1,100+i);
    i=i+1;
  }
  emit("BOOTSTRAP-LOOP-DONE\n");
  return 0;
}
fn main()i32 { return bl_main(); }

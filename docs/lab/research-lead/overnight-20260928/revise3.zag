// revise3.zag — H-REVISE3: repaired versioned conditional dispatch.
//
// Repairs the three H-REVISE2 red-team failure classes (REVISE2_ADV_RESULT.md):
//   F-RV1: version store is now an appendable condition list (up to 4
//          revision slots). vs_revise APPENDS; never overwrites. Dispatch
//          checks slots most-recent-first (stated rule).
//   F-RV2: diagnosis scores ALL discriminating positions:
//            +1 output-relevance (candidate byte in expected output),
//            +1 program-consistency (candidate position read by P1,
//               from the extraction index sequence).
//          Tie-break: lowest position. P1 is discovered BEFORE final
//          diagnosis so the consistency signal is available. This is a
//          stated heuristic, not guaranteed causal identification.
//   F-RV3: bounds-respecting length guard. A passing input shorter than
//          position p is vacuous at p (skipped), not vetoing.
//
// Prereg: PREREG_REVISE3.md (54790d0d2), frozen before this file.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (verbatim from revise2.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE v3 (appendable condition list) ============
// VS3 layout:
//   0: vcount (i32)
//   4: nnodes0 (i32), 8: prog0[48]  (bytes 8..56)
//   56: slot1: cond_pos(4), cond_val(4), nnodes(4), prog[48] -> 56..116
//   116: slot2 -> 116..176 ; 176: slot3 -> 176..236 ; 236: slot4 -> 236..296
// Max 4 revisions. Dispatch: most-recent-first (newest revision wins).
fn vs3_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 4, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[8+i]=p0[i]; i=i+1; }
  return;
}
// Returns 1 on append, 0 if the store is full.
fn vs3_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)i32 {
  let vc:i32=get32(VS, 0);
  if(vc>=4){ return 0; }
  let so:i32=56+vc*60;
  set32(VS, so, cpos);
  set32(VS, so+4, cval);
  set32(VS, so+8, nn1);
  let i:i32=0;
  while(i<nn1*3){ VS[so+12+i]=p1[i]; i=i+1; }
  set32(VS, 0, vc+1);
  return 1;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs3_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs3_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*60;
    let cp:i32=get32(VS, so);
    let cv:i32=get32(VS, so+4);
    if(inp.len>cp && (inp[cp] as i32)==cv){
      return vs3_apply_one(VS, so+12, so+8, inp, out);
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
fn vs3_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,4);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[8+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  let vc:i32=get32(VS,0);
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*60;
    emit("VSTORE slot"); emit(i32s(s));
    emit(" cond pos="); emit(i32s(get32(VS,so)));
    emit(" val="); emit(i32s(get32(VS,so+4)));
    let nn:i32=get32(VS,so+8);
    emit(" nnodes="); emit(i32s(nn)); emit(" prog=");
    let pp:[]u8=z_alloc(48);
    i=0;
    while(i<nn*3){ pp[i]=VS[so+12+i]; i=i+1; }
    prog_emit(pp, nn); emit("\n");
    s=s+1;
  }
  return;
}

// ============ SCORED DIAGNOSIS (R2: all positions, R3: bounds-respecting) ============
// For each position p in fail: bounds-respecting discrimination test
// (passing inputs shorter than p are vacuous, skipped). Score each
// discriminating (p,v):
//   +1 output-relevance: v appears in fail_out (expected output)
//   +1 program-consistency: p appears in seq (extraction index sequence,
//      the positions the discovered program reads)
// Returns best_p*1000+best_v, tie-break lowest p, or -1 if none.
// No byte-value literals; all compared values come from the data.
fn diagnose_scored(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8, fail_out:[]u8, seq:[]u8, sl:i32)i32 {
  let best:i32=-1;
  let best_score:i32=-1;
  let p:i32=0;
  while(p<fail.len){
    let v:i32=fail[p] as i32;
    let discrim:i32=1;
    let i:i32=0;
    while(i<npass){
      let plen:i32=get32(pdesc, i*8+4);
      if(plen>p){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
      }
      i=i+1;
    }
    if(discrim==1){
      let score:i32=0;
      let k:i32=0;
      while(k<fail_out.len){
        if((fail_out[k] as i32)==v){ score=score+1; break; }
        k=k+1;
      }
      k=0;
      while(k<sl){
        if(get32(seq, k*4)==p){ score=score+1; break; }
        k=k+1;
      }
      emit("DIAGNOSE candidate pos="); emit(i32s(p));
      emit(" val="); emit(i32s(v));
      emit(" score="); emit(i32s(score)); emit("\n");
      if(score>best_score){
        best_score=score;
        best=p*1000+v;
      }
    }
    p=p+1;
  }
  return best;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ MAIN: phases A-I ============
fn main()i32 {
  emit("=== H-REVISE3: repaired versioned conditional dispatch ===\n");
  let npass_total:i32=0;
  let ntest_total:i32=0;

  let in0:[]u8="abc"; let out0:[]u8="ccc";
  let in1:[]u8="def"; let out1:[]u8="fff";
  let in2:[]u8="ghi"; let out2:[]u8="iii";
  let in3:[]u8="jkl"; let out3:[]u8="lll";
  let inX:[]u8="xab"; let outX:[]u8="xxx";
  let inU:[]u8="abc"; let outU:[]u8="aaa";

  // ---- Phase A: learn P0 ----
  emit("\n--- Phase A: learn ---\n");
  let S:[]u8=z_alloc(4096);
  let S_off:i32=0;
  let descA:[]u8=z_alloc(3*12);
  let s0:i32=pextract(in0, out0, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(s0<0){ emit("FATAL extract in0\n"); return 1; }
  set32(descA, 0, S_off); set32(descA, 4, s0); set32(descA, 8, in0.len);
  S_off=S_off+64;
  let s1:i32=pextract(in1, out1, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(s1<0){ emit("FATAL extract in1\n"); return 1; }
  set32(descA, 12, S_off); set32(descA, 16, s1); set32(descA, 20, in1.len);
  S_off=S_off+64;
  let s2:i32=pextract(in2, out2, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(s2<0){ emit("FATAL extract in2\n"); return 1; }
  set32(descA, 24, S_off); set32(descA, 28, s2); set32(descA, 32, in2.len);
  S_off=S_off+64;
  npass_total=npass_total+3;

  let p0:[]u8=z_alloc(48);
  let nn0:i32=discover(S, descA, 3, p0);
  ntest_total=ntest_total+1;
  if(nn0<0){ emit("FATAL discover P0\n"); return 1; }
  npass_total=npass_total+1;
  emit("LEARN P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  prog_emit(p0, nn0); emit("\n");

  let VS:[]u8=z_alloc(512);
  vs3_init(VS, p0, nn0);

  let D:[]u8=z_alloc(256);
  let pdesc:[]u8=z_alloc(4*8);
  let D_off:i32=0;
  set32(pdesc, 0, D_off); set32(pdesc, 4, dcopy(D, D_off, in0)); D_off=D_off+in0.len;
  set32(pdesc, 8, D_off); set32(pdesc, 12, dcopy(D, D_off, in1)); D_off=D_off+in1.len;
  set32(pdesc, 16, D_off); set32(pdesc, 20, dcopy(D, D_off, in2)); D_off=D_off+in2.len;
  set32(pdesc, 24, D_off); set32(pdesc, 28, dcopy(D, D_off, in3)); D_off=D_off+in3.len;

  // ---- Phase B: monitor ----
  emit("\n--- Phase B: monitor ---\n");
  let pred:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(apply_prog(p0, nn0, in3, pred)==1 && streq(pred[0..3], out3)==1){
    emit("MONITOR B1 MATCH jkl->lll (no revision)\n");
    npass_total=npass_total+1;
  } else { emit("MONITOR B1 UNEXPECTED MISMATCH\n"); }

  ntest_total=ntest_total+1;
  if(apply_prog(p0, nn0, inX, pred)==1 && streq(pred[0..3], outX)==1){
    emit("MONITOR B2 UNEXPECTED MATCH (test broken)\n");
  } else {
    emit("DETECT counterexample xab->xxx predicted ");
    emit(pred[0..3]); emit(" (autonomous, no human trigger)\n");
    npass_total=npass_total+1;
  }

  // ---- Phase C: extract P1 subset first, then scored diagnosis ----
  emit("\n--- Phase C: diagnose (scored) ---\n");
  let descX:[]u8=z_alloc(12);
  let sx:i32=pextract(inX, outX, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(sx<0){ emit("FATAL extract inX\n"); return 1; }
  npass_total=npass_total+1;
  set32(descX, 0, S_off); set32(descX, 4, sx); set32(descX, 8, inX.len);
  let seqX:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let dr:i32=diagnose_scored(D, pdesc, 4, inX, outX, seqX, sx);
  ntest_total=ntest_total+1;
  if(dr<0){
    emit("DIAGNOSE NONE (cannot revise honestly; WITHHOLD)\n");
    emit("H-REVISE3 KILLED at diagnosis\n");
    return 1;
  }
  npass_total=npass_total+1;
  let dpos:i32=dr/1000;
  let dval:i32=dr-dpos*1000;
  emit("DIAGNOSE BEST pos="); emit(i32s(dpos)); emit(" val="); emit(i32s(dval)); emit("\n");
  ntest_total=ntest_total+1;
  if(dpos==0 && dval==120){
    emit("DIAGNOSE matches prereg expectation (0,120)\n");
    npass_total=npass_total+1;
  } else { emit("DIAGNOSE UNEXPECTED (prereg expects (0,120))\n"); }
  npass_total=npass_total+1;

  // ---- Phase D: discover P1; append revision ----
  emit("\n--- Phase D: revise (append) ---\n");
  let p1:[]u8=z_alloc(48);
  let nn1:i32=discover(S, descX, 1, p1);
  ntest_total=ntest_total+1;
  if(nn1<0){ emit("FATAL discover P1\n"); return 1; }
  npass_total=npass_total+1;
  emit("LEARN P1 nnodes="); emit(i32s(nn1)); emit(" prog=");
  prog_emit(p1, nn1); emit("\n");
  ntest_total=ntest_total+1;
  if(vs3_revise(VS, dpos, dval, p1, nn1)==1){
    emit("REVISE appended slot1: IF input["); emit(i32s(dpos)); emit("]==");
    emit(i32s(dval)); emit(" THEN P1 ELSE P0 (P0 preserved)\n");
    npass_total=npass_total+1;
  } else { emit("REVISE FAILED (store full)\n"); }
  vs3_dump(VS);

  // ---- Phase E: verify 5/5 ----
  emit("\n--- Phase E: verify ---\n");
  let ecount:i32=0;
  let out5:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, in0, out5)==1 && streq(out5[0..3], out0)==1){ emit("VERIFY abc->ccc PASS\n"); ecount=ecount+1; }
  else { emit("VERIFY abc->ccc FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, in1, out5)==1 && streq(out5[0..3], out1)==1){ emit("VERIFY def->fff PASS\n"); ecount=ecount+1; }
  else { emit("VERIFY def->fff FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, in2, out5)==1 && streq(out5[0..3], out2)==1){ emit("VERIFY ghi->iii PASS\n"); ecount=ecount+1; }
  else { emit("VERIFY ghi->iii FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, in3, out5)==1 && streq(out5[0..3], out3)==1){ emit("VERIFY jkl->lll PASS\n"); ecount=ecount+1; }
  else { emit("VERIFY jkl->lll FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, inX, out5)==1 && streq(out5[0..3], outX)==1){ emit("VERIFY xab->xxx PASS\n"); ecount=ecount+1; }
  else { emit("VERIFY xab->xxx FAIL\n"); }
  npass_total=npass_total+ecount;

  // ---- Phase F: honest withhold ----
  emit("\n--- Phase F: honest withhold ---\n");
  let outF:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, inU, outF)==1 && streq(outF[0..3], outU)==1){
    emit("PHASEF UNEXPECTED MATCH (test broken)\n");
  } else {
    emit("DETECT counterexample abc->aaa predicted ");
    emit(outF[0..3]); emit("\n");
    npass_total=npass_total+1;
    let seqU:[]u8=z_alloc(64);
    let su:i32=pextract(inU, outU, seqU);
    let dr2:i32=-1;
    if(su>0){ dr2=diagnose_scored(D, pdesc, 4, inU, outU, seqU, su); }
    ntest_total=ntest_total+1;
    if(dr2<0){
      emit("UNRESOLVABLE: no discriminating content feature; revision withheld\n");
      npass_total=npass_total+1;
      ntest_total=ntest_total+1;
      let outG:[]u8=z_alloc(16);
      if(vs3_apply(VS, in0, outG)==1 && streq(outG[0..3], out0)==1){
        emit("WITHHOLD P0 intact: abc->ccc still correct\n");
        npass_total=npass_total+1;
      } else { emit("WITHHOLD CORRUPTED (P0 damaged)\n"); }
      ntest_total=ntest_total+1;
      if(get32(VS,0)==1){
        emit("WITHHOLD version store unchanged (vcount=1)\n");
        npass_total=npass_total+1;
      } else { emit("WITHHOLD STORE CHANGED (bad)\n"); }
    } else {
      emit("PHASEF UNEXPECTED SPLIT FOUND (test broken)\n");
    }
  }

  // ---- Phase G: chained revision R2 (K-RV3-1) ----
  emit("\n--- Phase G: chained revision R2 ---\n");
  let inY:[]u8="yzb"; let outY:[]u8="yyy";
  let t5:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, inY, t5)==1 && streq(t5[0..3], outY)==1){
    emit("PHASEG R2 UNEXPECTED MATCH (test broken)\n");
  } else {
    emit("DETECT R2 counterexample yzb->yyy predicted ");
    emit(t5[0..3]); emit("\n");
    npass_total=npass_total+1;
  }
  let descY:[]u8=z_alloc(12);
  let sy:i32=pextract(inY, outY, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(sy<0){ emit("FATAL extract inY\n"); return 1; }
  npass_total=npass_total+1;
  set32(descY, 0, S_off); set32(descY, 4, sy); set32(descY, 8, inY.len);
  let seqY:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let drG:i32=diagnose_scored(D, pdesc, 4, inY, outY, seqY, sy);
  ntest_total=ntest_total+1;
  if(drG<0){ emit("PHASEG DIAGNOSE NONE (test broken)\n"); return 1; }
  let dgpos:i32=drG/1000;
  let dgval:i32=drG-dgpos*1000;
  emit("DIAGNOSE R2 BEST pos="); emit(i32s(dgpos)); emit(" val="); emit(i32s(dgval)); emit("\n");
  ntest_total=ntest_total+1;
  if(dgpos==0 && dgval==121){
    emit("DIAGNOSE R2 matches prereg expectation (0,121)\n");
    npass_total=npass_total+1;
  } else { emit("DIAGNOSE R2 UNEXPECTED (prereg expects (0,121))\n"); }
  npass_total=npass_total+1;
  let p2:[]u8=z_alloc(48);
  let nn2:i32=discover(S, descY, 1, p2);
  ntest_total=ntest_total+1;
  if(nn2<0){ emit("FATAL discover P2\n"); return 1; }
  npass_total=npass_total+1;
  emit("LEARN P2 nnodes="); emit(i32s(nn2)); emit(" prog=");
  prog_emit(p2, nn2); emit("\n");
  ntest_total=ntest_total+1;
  if(vs3_revise(VS, dgpos, dgval, p2, nn2)==1){
    emit("REVISE appended slot2: IF input["); emit(i32s(dgpos)); emit("]==");
    emit(i32s(dgval)); emit(" THEN P2 (most-recent-first)\n");
    npass_total=npass_total+1;
  } else { emit("REVISE R2 FAILED (store full)\n"); }
  vs3_dump(VS);
  ntest_total=ntest_total+1;
  if(get32(VS,0)==2){
    emit("VCOUNT=2 (both revisions retained)\n");
    npass_total=npass_total+1;
  } else { emit("VCOUNT WRONG (chaining broken)\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, inX, t5)==1 && streq(t5[0..3], outX)==1){
    emit("CHAIN VERIFY xab->xxx PASS (R1 survives R2)\n");
    npass_total=npass_total+1;
  } else {
    emit("CHAIN VERIFY xab->xxx FAIL (R1 destroyed; predicted ");
    emit(t5[0..3]); emit(")\n");
  }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, inY, t5)==1 && streq(t5[0..3], outY)==1){
    emit("CHAIN VERIFY yzb->yyy PASS (R2 works)\n");
    npass_total=npass_total+1;
  } else {
    emit("CHAIN VERIFY yzb->yyy FAIL (predicted ");
    emit(t5[0..3]); emit(")\n");
  }

  // ---- Phase H: 'q' diagnosis gaming fixture (K-RV3-2), fresh store ----
  emit("\n--- Phase H: q-case diagnosis (fresh store) ---\n");
  let VS2:[]u8=z_alloc(512);
  vs3_init(VS2, p0, nn0);
  let inQ:[]u8="xqc"; let outQ:[]u8="qqq";
  ntest_total=ntest_total+1;
  if(apply_prog(p0, nn0, inQ, pred)==1 && streq(pred[0..3], outQ)==1){
    emit("PHASEH UNEXPECTED MATCH (test broken)\n");
  } else {
    emit("DETECT xqc->qqq predicted "); emit(pred[0..3]); emit("\n");
    npass_total=npass_total+1;
  }
  let descQ:[]u8=z_alloc(12);
  let sqq:i32=pextract(inQ, outQ, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(sqq<0){ emit("FATAL extract inQ\n"); return 1; }
  npass_total=npass_total+1;
  set32(descQ, 0, S_off); set32(descQ, 4, sqq); set32(descQ, 8, inQ.len);
  let seqQ:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let drH:i32=diagnose_scored(D, pdesc, 4, inQ, outQ, seqQ, sqq);
  ntest_total=ntest_total+1;
  if(drH<0){ emit("PHASEH DIAGNOSE NONE (test broken)\n"); return 1; }
  let dhpos:i32=drH/1000;
  let dhval:i32=drH-dhpos*1000;
  emit("DIAGNOSE Q BEST pos="); emit(i32s(dhpos)); emit(" val="); emit(i32s(dhval)); emit("\n");
  ntest_total=ntest_total+1;
  if(dhpos==1 && dhval==113){
    emit("DIAGNOSE Q matches prereg expectation (1,113): causal feature selected\n");
    npass_total=npass_total+1;
  } else {
    emit("DIAGNOSE Q MISSED (prereg expects (1,113); got (");
    emit(i32s(dhpos)); emit(","); emit(i32s(dhval)); emit("))\n");
  }
  let pq:[]u8=z_alloc(48);
  let nnq:i32=discover(S, descQ, 1, pq);
  ntest_total=ntest_total+1;
  if(nnq<0){ emit("FATAL discover PQ\n"); return 1; }
  npass_total=npass_total+1;
  emit("LEARN PQ nnodes="); emit(i32s(nnq)); emit(" prog=");
  prog_emit(pq, nnq); emit("\n");
  ntest_total=ntest_total+1;
  if(vs3_revise(VS2, dhpos, dhval, pq, nnq)==1){
    emit("REVISE VS2: IF input["); emit(i32s(dhpos)); emit("]==");
    emit(i32s(dhval)); emit(" THEN PQ ELSE P0\n");
    npass_total=npass_total+1;
  } else { emit("REVISE VS2 FAILED\n"); }
  let inH1:[]u8="xbc"; let outH1:[]u8="ccc";
  let inH2:[]u8="aqc"; let outH2:[]u8="qqq";
  ntest_total=ntest_total+1;
  if(vs3_apply(VS2, inH1, t5)==1 && streq(t5[0..3], outH1)==1){
    emit("HELDOUT xbc->ccc PASS (no q, P0)\n");
    npass_total=npass_total+1;
  } else {
    emit("HELDOUT xbc->ccc FAIL (predicted "); emit(t5[0..3]); emit(")\n");
  }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS2, inH2, t5)==1 && streq(t5[0..3], outH2)==1){
    emit("HELDOUT aqc->qqq PASS (q at pos1, PQ)\n");
    npass_total=npass_total+1;
  } else {
    emit("HELDOUT aqc->qqq FAIL (predicted "); emit(t5[0..3]); emit(")\n");
  }

  // ---- Phase I: mixed-length passing set (K-RV3-3), fresh store ----
  emit("\n--- Phase I: mixed-length diagnosis (fresh store) ---\n");
  let VS3:[]u8=z_alloc(512);
  vs3_init(VS3, p0, nn0);
  let inDE:[]u8="de"; let outDE:[]u8="ee";
  ntest_total=ntest_total+1;
  if(apply_prog(p0, nn0, inDE, pred)==1 && streq(pred[0..2], outDE)==1){
    emit("SANITY de->ee passes under P0\n");
    npass_total=npass_total+1;
  } else { emit("SANITY de->ee FAILS (test broken)\n"); }
  let D3:[]u8=z_alloc(256);
  let pd3:[]u8=z_alloc(4*8);
  let o3:i32=0;
  set32(pd3, 0, o3); set32(pd3, 4, dcopy(D3, o3, in0)); o3=o3+in0.len;
  set32(pd3, 8, o3); set32(pd3, 12, dcopy(D3, o3, inDE)); o3=o3+inDE.len;
  set32(pd3, 16, o3); set32(pd3, 20, dcopy(D3, o3, in2)); o3=o3+in2.len;
  set32(pd3, 24, o3); set32(pd3, 28, dcopy(D3, o3, in3)); o3=o3+in3.len;
  let inM:[]u8="abx"; let outM:[]u8="aaa";
  ntest_total=ntest_total+1;
  if(apply_prog(p0, nn0, inM, pred)==1 && streq(pred[0..3], outM)==1){
    emit("PHASEI UNEXPECTED MATCH (test broken)\n");
  } else {
    emit("DETECT abx->aaa predicted "); emit(pred[0..3]); emit("\n");
    npass_total=npass_total+1;
  }
  let descM:[]u8=z_alloc(12);
  let sm:i32=pextract(inM, outM, S[S_off..S_off+64]);
  ntest_total=ntest_total+1;
  if(sm<0){ emit("FATAL extract inM\n"); return 1; }
  npass_total=npass_total+1;
  set32(descM, 0, S_off); set32(descM, 4, sm); set32(descM, 8, inM.len);
  let seqM:[]u8=S[S_off..S_off+64];
  S_off=S_off+64;
  let drI:i32=diagnose_scored(D3, pd3, 4, inM, outM, seqM, sm);
  ntest_total=ntest_total+1;
  if(drI<0){
    emit("PHASEI DIAGNOSE -1: SPURIOUS UNRESOLVABLE (K-RV3-3 FAILS)\n");
  } else {
    let dipos:i32=drI/1000;
    let dival:i32=drI-dipos*1000;
    emit("DIAGNOSE M BEST pos="); emit(i32s(dipos)); emit(" val="); emit(i32s(dival)); emit("\n");
    npass_total=npass_total+1;
    ntest_total=ntest_total+1;
    if(dipos==2 && dival==120){
      emit("DIAGNOSE M matches prereg expectation (2,120): no spurious withhold\n");
      npass_total=npass_total+1;
    } else { emit("DIAGNOSE M UNEXPECTED (prereg expects (2,120))\n"); }
    let pm:[]u8=z_alloc(48);
    let nnm:i32=discover(S, descM, 1, pm);
    ntest_total=ntest_total+1;
    if(nnm<0){ emit("FATAL discover PM\n"); return 1; }
    npass_total=npass_total+1;
    ntest_total=ntest_total+1;
    if(vs3_revise(VS3, dipos, dival, pm, nnm)==1){
      emit("REVISE VS3: IF input["); emit(i32s(dipos)); emit("]==");
      emit(i32s(dival)); emit(" THEN PM ELSE P0\n");
      npass_total=npass_total+1;
    } else { emit("REVISE VS3 FAILED\n"); }
    ntest_total=ntest_total+1;
    if(vs3_apply(VS3, inM, t5)==1 && streq(t5[0..3], outM)==1){
      emit("VERIFY abx->aaa PASS\n");
      npass_total=npass_total+1;
    } else {
      emit("VERIFY abx->aaa FAIL (predicted "); emit(t5[0..3]); emit(")\n");
    }
  }

  emit("\n=== RESULT: ");
  emit(i32s(npass_total)); emit("/"); emit(i32s(ntest_total));
  emit(" ===\n");
  if(npass_total==ntest_total){
    emit("H-REVISE3 SURVIVES\n");
    return 0;
  }
  emit("H-REVISE3 KILLED\n");
  return 1;
}

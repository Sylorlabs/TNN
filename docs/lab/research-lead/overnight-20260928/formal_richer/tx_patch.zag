// tx_patch.zag -- TX1 typed-arithmetic induction (unfrozen).
// Induces the TX1 grammar from taught examples: the licensor set, the
// decomp->eval map, and the Int/Bool type partition. The induced types
// are causally active in construction.
// This file contains no eval/decomp relation id literals. Relation 45
// is the BUILD task relation (prior-work precedent). Type 71 is the
// grammar node. Types: 0=Int, 1=Bool.

// Learner-owned semantic lookup: is (pair, op, t) in TNN's own learned
// state? Read-only scan. Values from learner state; op comes from the
// induced decomp->eval map, never a literal.
fn tx_eval_known(W:[]u8,pair:i32,op:i32,t:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==pair && ng(W,n,24)==op && ng(W,n,28)==t){return 1;}
    n=n+1;
  }
  return 0;
}

// Find the induced grammar node (type 71). Returns id or -1.
fn tx_grammar_find(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==71){return n;}
    n=n+1;
  }
  return -1;
}

// Induce the TX1 grammar from taught BUILD examples.
// (1) Licensor set: for each live fact (T,45,P), find facts (T,r,P)
//     with r != 45; collect distinct r.
// (2) Decomp->eval map: for each BUILD example, scan all facts
//     (P,e,T) over any relation e; require exactly one e per
//     licensor, consistent across that licensor's examples.
// (3) Type partition: for each eval op e, scan every fact carrying
//     relation e; e is Bool-producing iff all objects are 0 or 1.
// Succeeds iff every BUILD example has exactly one licensor, every
// licensor maps to exactly one eval op, and nlic == 4.
// Node layout (type 71): f4=nlic, f8=packed licensors (one byte
// each), f12=type mask (2 bits per licensor), f32=packed eval ops.
fn tx_induce(W:[]u8)i32 {
  let lic:[]u8=z_alloc(16); let evm:[]u8=z_alloc(16); let nlic:i32=0;
  let ok:i32=1;
  let n:i32=2;
  while(n<1024 && ok==1){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==45){
      let T:i32=ng(W,n,20); let P:i32=ng(W,n,28);
      let a:i32=P/16; let b:i32=P-(a*16);
      if(a<0 || a>15 || b<0 || b>15 || a*16+b!=P){ok=0;}
      else {
        let m:i32=2; let lr:i32=-1; let lcnt:i32=0;
        while(m<1024){
          if(m!=n && ng(W,m,36)==1 && ng(W,m,0)==1 && ng(W,m,20)==T && ng(W,m,28)==P && ng(W,m,24)!=45){
            lr=ng(W,m,24); lcnt=lcnt+1;
          }
          m=m+1;
        }
        if(lcnt!=1){ok=0;}
        else {
          let e2:i32=2; let ev:i32=-1; let ecnt:i32=0;
          while(e2<1024){
            if(e2!=n && ng(W,e2,36)==1 && ng(W,e2,0)==1 && ng(W,e2,20)==P && ng(W,e2,28)==T){
              ev=ng(W,e2,24); ecnt=ecnt+1;
            }
            e2=e2+1;
          }
          if(ecnt!=1){ok=0;}
          else {
            let k:i32=0; let seen:i32=0;
            while(k<nlic){
              if(get32(lic,k*4)==lr){
                seen=1;
                if(get32(evm,k*4)!=ev){ok=0;}
              }
              k=k+1;
            }
            if(seen==0){
              if(nlic<4){set32(lic,nlic*4,lr); set32(evm,nlic*4,ev); nlic=nlic+1;}
              else {ok=0;}
            }
          }
        }
      }
    }
    n=n+1;
  }
  if(ok==0 || nlic!=4){return 0;}
  let typ:[]u8=z_alloc(16);
  let i:i32=0;
  while(i<nlic){
    let e:i32=get32(evm,i*4);
    let f:i32=2; let allbool:i32=1; let any:i32=0;
    while(f<1024){
      if(ng(W,f,36)==1 && ng(W,f,0)==1 && ng(W,f,24)==e){
        any=1;
        let o:i32=ng(W,f,28);
        if(o!=0 && o!=1){allbool=0;}
      }
      f=f+1;
    }
    if(any==0){return 0;}
    if(allbool==1){set32(typ,i*4,1);} else {set32(typ,i*4,0);}
    i=i+1;
  }
  let g:i32=alloc_node(W);
  if(g<0){return 0;}
  ns(W,g,0,71);
  ns(W,g,4,nlic);
  let lp:i32=0; let tm:i32=0; let ep:i32=0;
  let j:i32=0;
  while(j<nlic){
    lp=lp|(get32(lic,j*4)<<(j*8));
    tm=tm|(get32(typ,j*4)<<(j*2));
    ep=ep|(get32(evm,j*4)<<(j*8));
    j=j+1;
  }
  ns(W,g,8,lp);
  ns(W,g,12,tm);
  ns(W,g,32,ep);
  return 1;
}

// Ablate: kill the induced grammar node. Returns 1 if found.
fn tx_ablate(W:[]u8)i32 {
  let g:i32=tx_grammar_find(W);
  if(g<0){return 0;}
  ns(W,g,36,0);
  return 1;
}

// Read induced grammar into a buffer.
// buf[0]=nlic, buf[1..4]=lic[i], buf[5..8]=type[i], buf[9..12]=ev[i].
// Returns 1 if found.
fn tx_grammar_read(W:[]u8,buf:[]u8)i32 {
  let g:i32=tx_grammar_find(W);
  if(g<0){return 0;}
  let nlic:i32=ng(W,g,4);
  let lp:i32=ng(W,g,8); let tm:i32=ng(W,g,12); let ep:i32=ng(W,g,32);
  set32(buf,0,nlic);
  let i:i32=0;
  while(i<4){
    set32(buf,(1+i)*4,(lp>>(i*8))&255);
    set32(buf,(5+i)*4,(tm>>(i*2))&3);
    set32(buf,(9+i)*4,(ep>>(i*8))&255);
    i=i+1;
  }
  return 1;
}

// Index of relation r in the induced licensor set, or -1.
fn tx_lic_idx(buf:[]u8,r:i32)i32 {
  let n:i32=get32(buf,0); let i:i32=0;
  while(i<n){if(get32(buf,(1+i)*4)==r){return i;} i=i+1;}
  return -1;
}

// Type-directed BUILD using the INDUCED grammar.
// Candidates must be atomic single facts whose relation is an induced
// licensor AND whose induced type matches the goal's reqtype
// (0=Int, 1=Bool). The verifying eval op comes from the induced
// decomp->eval map. Promotes on success, returns -2 otherwise.
fn tx_trial_build(W:[]u8,t:i32,req:i32,gb:[]u8)i32 {
  let paths:[]u8=z_alloc(96*12*4);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*12*4;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      let li:i32=tx_lic_idx(gb,fr);
      if(li>=0 && get32(gb,(5+li)*4)==req){
        let ev:i32=get32(gb,(9+li)*4);
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          if(tx_eval_known(W,out,ev,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Type-blind baseline: induced licensor set and eval map, but NO type
// filter. Differs from tx_trial_build ONLY in the missing type check.
fn tx_typeblind_build(W:[]u8,t:i32,gb:[]u8)i32 {
  let paths:[]u8=z_alloc(96*12*4);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*12*4;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      let li:i32=tx_lic_idx(gb,fr);
      if(li>=0){
        let ev:i32=get32(gb,(9+li)*4);
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          if(tx_eval_known(W,out,ev,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Classify the promoted (t,45) MAP against the goal's reqtype.
// Highest node id wins (most recent promotion for this target).
// 1 valid; 2 multi-dep; 3 wrong-relation dep; 4 decode failure;
// 5 value mismatch; 6 TYPE MISMATCH; 0 no MAP.
fn tx_classify(W:[]u8,t:i32,req:i32,gb:[]u8)i32 {
  let m:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && ng(W,mm,0)==20 && ng(W,mm,8)==t && ng(W,mm,4)==45){m=mm;}
    mm=mm+1;
  }
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24);
  let li:i32=tx_lic_idx(gb,fr);
  if(li<0){return 3;}
  if(get32(gb,(5+li)*4)!=req){return 6;}
  let P:i32=ng(W,f,28);
  let a:i32=P/16; let b:i32=P-(a*16);
  if(a<0 || a>15 || b<0 || b>15 || a*16+b!=P){return 4;}
  let ev:i32=get32(gb,(9+li)*4);
  if(tx_eval_known(W,P,ev,t)==0){return 5;}
  return 1;
}

// tx_driver.zag -- TX1 typed-arithmetic experiment driver.
// World side: teaches eval, decomp, and BUILD examples. The grammar
// (licensors, eval map, Int/Bool partition) is never taught; it is
// induced by tx_induce from examples only.

fn tx_P(a:i32,b:i32)i32 { return a*16+b; }

fn tx_teach_eval(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=tx_P(a,b);
      ev_teach_in(W,p,41,a+b);
      ev_teach_in(W,p,42,a*b);
      ev_teach_in(W,p,46,a-b);
      let lt:i32=0; if(a<b){lt=1;}
      ev_teach_in(W,p,47,lt);
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn tx_teach_decomp(W:[]u8)void {
  ev_teach_in(W,10,43,tx_P(1,9)); ev_teach_in(W,10,44,tx_P(2,5));
  ev_teach_in(W,12,43,tx_P(3,9)); ev_teach_in(W,12,44,tx_P(3,4));
  ev_teach_in(W,15,43,tx_P(6,9)); ev_teach_in(W,15,44,tx_P(3,5));
  ev_teach_in(W,24,44,tx_P(4,6)); ev_teach_in(W,24,44,tx_P(3,8));
  ev_teach_in(W,30,44,tx_P(5,6));
  ev_teach_in(W,42,44,tx_P(6,7));
  ev_teach_in(W,5,48,tx_P(8,3));
  ev_teach_in(W,3,48,tx_P(7,4));
  ev_teach_in(W,16,43,tx_P(7,9));
  ev_teach_in(W,18,43,tx_P(9,9));
  ev_teach_in(W,20,44,tx_P(4,5));
  ev_teach_in(W,28,44,tx_P(4,7));
  ev_teach_in(W,7,48,tx_P(9,2));
  ev_teach_in(W,4,48,tx_P(9,5));
  ev_teach_in(W,0,43,tx_P(0,0));
  ev_teach_in(W,0,48,tx_P(5,5));
  ev_teach_in(W,1,43,tx_P(1,0));
  ev_teach_in(W,0,49,tx_P(3,3));
  ev_teach_in(W,0,49,tx_P(5,2));
  ev_teach_in(W,0,49,tx_P(7,3));
  ev_teach_in(W,1,49,tx_P(0,1));
  ev_teach_in(W,1,49,tx_P(3,7));
  return;
}

fn tx_teach_build(W:[]u8)void {
  ev_teach_in(W,16,45,tx_P(7,9));
  ev_teach_in(W,18,45,tx_P(9,9));
  ev_teach_in(W,20,45,tx_P(4,5));
  ev_teach_in(W,28,45,tx_P(4,7));
  ev_teach_in(W,7,45,tx_P(9,2));
  ev_teach_in(W,4,45,tx_P(9,5));
  ev_teach_in(W,1,45,tx_P(3,7));
  ev_teach_in(W,0,45,tx_P(7,3));
  return;
}

fn tx_teach(W:[]u8)void {
  tx_teach_eval(W);
  tx_teach_decomp(W);
  tx_teach_build(W);
  return;
}

fn tx_report_grammar(gb:[]u8)void {
  let n:i32=get32(gb,0);
  emit("TX-GRAMMAR nlic="); e64(n); emit(" ");
  let i:i32=0;
  while(i<n){
    emit("lic="); e64(get32(gb,(1+i)*4));
    emit(":t"); e64(get32(gb,(5+i)*4));
    emit(":ev"); e64(get32(gb,(9+i)*4));
    emit(" ");
    i=i+1;
  }
  emit("\n");
  return;
}

fn tx_goals_t(out:[]u8)i32 {
  set32(out,0,10); set32(out,4,12); set32(out,8,15); set32(out,12,24);
  set32(out,16,30); set32(out,20,42); set32(out,24,5); set32(out,28,3);
  set32(out,32,0); set32(out,36,0); set32(out,40,1); set32(out,44,1);
  return 12;
}

fn tx_goals_r(out:[]u8)i32 {
  set32(out,0,0); set32(out,4,0); set32(out,8,0); set32(out,12,0);
  set32(out,16,0); set32(out,20,0); set32(out,24,0); set32(out,28,0);
  set32(out,32,0); set32(out,36,1); set32(out,40,0); set32(out,44,1);
  return 12;
}

fn tx_arm_induce(W:[]u8,gb:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let tr:[]u8=z_alloc(48);
  let n:i32=tx_goals_t(tg); tx_goals_r(tr);
  let i:i32=0; let vc:i32=0; let te:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4); let r:i32=get32(tr,i*4);
    let ans:i32=tx_trial_build(W,t,r,gb);
    let cl:i32=tx_classify(W,t,r,gb);
    emit("TX-I "); e64(t); emit(","); e64(r);
    emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    if(cl==6){te=te+1;}
    i=i+1;
  }
  emit("TX-I-VALID "); e64(vc); emit("/"); e64(n);
  emit(" typeerr="); e64(te); emit("\n");
  return vc;
}

fn tx_arm_typeblind(W:[]u8,gb:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let tr:[]u8=z_alloc(48);
  let n:i32=tx_goals_t(tg); tx_goals_r(tr);
  let i:i32=0; let vc:i32=0; let te:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4); let r:i32=get32(tr,i*4);
    let ans:i32=tx_typeblind_build(W,t,gb);
    let cl:i32=tx_classify(W,t,r,gb);
    emit("TX-T "); e64(t); emit(","); e64(r);
    emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    if(cl==6){te=te+1;}
    i=i+1;
  }
  emit("TX-T-VALID "); e64(vc); emit("/"); e64(n);
  emit(" typeerr="); e64(te); emit("\n");
  return vc;
}

fn tx_arm_base(W:[]u8,tag:[]u8)i32 {
  let gb0:[]u8=z_alloc(52); set32(gb0,0,0);
  let tg:[]u8=z_alloc(48); let tr:[]u8=z_alloc(48);
  let n:i32=tx_goals_t(tg); tx_goals_r(tr);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4); let r:i32=get32(tr,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=tx_classify(W,t,r,gb0);
    emit(tag); emit(" "); e64(t); emit(","); e64(r);
    emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit(tag); emit("-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

fn main()i32 {
  emit("TX-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  tx_teach(W1);
  emit("TX-W1-INDUCE\n");
  let ind1:i32=tx_induce(W1);
  emit("TX-INDUCED "); e64(ind1); emit("\n");
  let gb1:[]u8=z_alloc(52);
  let gr1:i32=tx_grammar_read(W1,gb1);
  emit("TX-GRAMMAR-READ "); e64(gr1); emit("\n");
  if(gr1==1){tx_report_grammar(gb1);}
  emit("TX-W1-BATTERY\n");
  let v1:i32=tx_arm_induce(W1,gb1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  tx_teach(W2);
  emit("TX-W2-ABLATE\n");
  let ind2:i32=tx_induce(W2);
  emit("TX-INDUCED "); e64(ind2); emit("\n");
  let ab2:i32=tx_ablate(W2);
  emit("TX-ABLATED "); e64(ab2); emit("\n");
  emit("TX-W2-BATTERY\n");
  let v2:i32=tx_arm_base(W2,"TX-B");
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  tx_teach(W3);
  emit("TX-W3-TYPEBLIND\n");
  let ind3:i32=tx_induce(W3);
  emit("TX-INDUCED "); e64(ind3); emit("\n");
  let gb3:[]u8=z_alloc(52);
  let gr3:i32=tx_grammar_read(W3,gb3);
  emit("TX-GRAMMAR-READ "); e64(gr3); emit("\n");
  if(gr3==1){tx_report_grammar(gb3);}
  emit("TX-W3-BATTERY\n");
  let v3:i32=tx_arm_typeblind(W3,gb3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4);
  tx_teach(W4);
  emit("TX-W4-FRESH\n");
  let v4:i32=tx_arm_base(W4,"TX-F");
  emit("TX-SUMMARY induce="); e64(v1); emit(" ablate="); e64(v2);
  emit(" typeblind="); e64(v3); emit(" fresh="); e64(v4); emit("\n");
  emit("TX-DONE\n");
  return 0;
}

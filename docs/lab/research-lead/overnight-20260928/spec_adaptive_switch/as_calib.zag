// as_calib.zag -- wall-clock calibration for SPEC-ADAPTIVE-SWITCH.
//
// Measures nanoseconds per et_specialize_ret (one rebuild) via
// clock_gettime (Linux x86_64 raw syscall 228, CLOCK_MONOTONIC = 1).
// Pure Zag plus one raw syscall -- the same class of mechanism as the
// o_flush write syscall the parent lane already uses.
//
// Output is timing data: nondeterministic by nature. It is recorded to
// as_calib.txt with a timestamp and EXCLUDED from the byte-identical
// kill bars. It anchors the abstract work unit (1 rebuild = C = 1)
// physically: whatever rebuild_ns_min measures, that is what one work
// unit costs in wall-clock.
//
// No world literals in this file.
fn calib_now(ts:[]u8)void {
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  return;
}
fn calib_delta(a:[]u8,b:[]u8)i64 {
  let ds:i64=(get32(b,0) as i64)-(get32(a,0) as i64);
  let dn:i64=(get32(b,8) as i64)-(get32(a,8) as i64);
  return ds*1000000000+dn;
}
fn main()i32 {
  let B:[]u8=z_alloc(1024);
  let c:i32=0;
  let LA:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let t0:[]u8=z_alloc(16);
  let t1:[]u8=z_alloc(16);
  let ra:i32=rb_rel_a();
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(LA,ra);
  et_specialize_ret(LA,S,A,0,0);
  let best:i64=0;
  let iters:i32=200;
  let i:i32=0;
  while(i<iters){
    calib_now(t0);
    et_specialize_ret(LA,S,A,0,0);
    calib_now(t1);
    let d:i64=calib_delta(t0,t1);
    if(i==0){ best=d; }
    if(d<best){ best=d; }
    i=i+1;
  }
  c=o_app(B,c,"CALIB rebuild_ns_min=");
  c=o_i64(B,c,best);
  c=o_app(B,c," iters=");
  c=o_i64(B,c,iters as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// as_spec.zag -- SPEC-ADAPTIVE-SWITCH policy layer.
//
// Executable adaptive recovery switch, built on SPEC-LAZY-DEFAULT.
// ld_spec.zag is reused byte-unmodified: ld_query_default is the lazy
// on-demand query path, and eager restamp-on-drift lives in the episode
// loop exactly as in the parent lane. Only the policy decision is new.
//
// Common cost unit: one abstract work unit = one rebuild, so C = 1 by
// definition of the unit. L (deadline value of avoiding one
// refused-then-retried query) is stated by the caller in work units
// (rebuilds). as_calib.zag measures the wall-clock price of one rebuild
// in nanoseconds so the unit has a physical anchor; the switch itself
// runs on work units, which keeps the experiment binary deterministic.
//
// Adaptive arm (pol = 2): phase 1 [0, W) serves queries lazily and
// observes Dw drifts and Qw queries. At t = W the switch computes the
// measured per-avoided-refusal price pnum/pden = max(0, Dw - Qw)/Qw
// rebuilds -- this IS W(k) - 1 from observed rates, as an exact
// rational -- and selects eager iff L * pden > pnum * C. Phase 2
// [W, T) runs the selected policy. W = 16 is the least common multiple
// of the grid periods, so the observed rate ratio is exact, and t = W
// is a drift tick for every grid M, so the eager restamp at t = W
// freshens the epoch before the t = W query (no sync restamp needed).
//
// No world literals in this file: relation/object ids arrive via rb_*.
fn as_warmup()i32 { return 16; }
// Exact integer decision rule. C = 1 work unit per rebuild.
// Returns 1 = eager, 0 = lazy.
fn as_decide(Dw:i32,Qw:i32,L:i32)i32 {
  if(Dw<=Qw){
    if(L>0){ return 1; }
    return 0;
  }
  if(L*Qw>Dw-Qw){ return 1; }
  return 0;
}
fn as_max0(a:i32)i32 {
  if(a>0){ return a; }
  return 0;
}
fn as_polname(B:[]u8,c:i32,pol:i32)i32 {
  if(pol==0){ c=o_app(B,c,"lazy"); }
  if(pol==1){ c=o_app(B,c,"eager"); }
  if(pol==2){ c=o_app(B,c,"adapt"); }
  return c;
}
fn as_emit_cell(B:[]u8,c:i32,M:i32,N:i32,pol:i32,Lv:i32,Dw:i32,Qw:i32,pnum:i32,pden:i32,sel:i32,dr:i32,q:i32,rb:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL M=");
  c=o_i64(B,c,M as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N as i64);
  c=o_app(B,c," P=");
  c=as_polname(B,c,pol);
  c=o_app(B,c," L=");
  c=o_i64(B,c,Lv as i64);
  c=o_app(B,c," C=1 Dw=");
  c=o_i64(B,c,Dw as i64);
  c=o_app(B,c," Qw=");
  c=o_i64(B,c,Qw as i64);
  c=o_app(B,c," pnum=");
  c=o_i64(B,c,pnum as i64);
  c=o_app(B,c," pden=");
  c=o_i64(B,c,pden as i64);
  c=o_app(B,c," sel=");
  c=o_i64(B,c,sel as i64);
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,rb as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_nl(B,c);
  return c;
}
// One episode. pol 0 = fixed lazy, pol 1 = fixed eager, pol 2 =
// adaptive (warmup lazy for W ticks, decide once, run the selected
// policy). Lv = deadline value L in work units; fixed arms use -1.
// acc packs deltas: 0 = on-demand rebuilds, 4 = answered,
// 8 = refusals, 12 = kb. restamps counts eager restamp-on-drift events.
fn as_episode(B:[]u8,c:i32,M:i32,N:i32,pol:i32,Lv:i32,ra:i32,oa1:i32)i32 {
  let LA:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let T:i32=256;
  let W:i32=as_warmup();
  if(pol!=2){ W=T; }
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(LA,ra);
  et_specialize_ret(LA,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  let drifts:i32=0;
  let queries:i32=0;
  let Dw:i32=0;
  let Qw:i32=0;
  let restamps:i32=0;
  let cur:i32=pol;
  let sel:i32=pol;
  if(pol==2){ cur=0; sel=0; }
  let dc:i32=0;
  let qc:i32=0;
  let t:i32=0;
  while(t<T){
    if(t==W){
      Dw=drifts;
      Qw=queries;
      sel=as_decide(Dw,Qw,Lv);
      cur=sel;
    }
    if(dc==0){
      et_drift_unrelated(A);
      drifts=drifts+1;
      dc=M;
      if(cur==1){
        et_specialize_ret(LA,S,A,0,0);
        restamps=restamps+1;
      }
    }
    if(qc==0){
      queries=queries+1;
      qc=N;
      ld_query_default(LA,S,A,ra,oa1,K,OUT,OUTG,acc);
    }
    dc=dc-1;
    qc=qc-1;
    t=t+1;
  }
  let pnum:i32=0;
  let pden:i32=1;
  if(pol==2){
    pnum=as_max0(Dw-Qw);
    pden=Qw;
  }
  let rb:i32=get32(acc,0)+restamps;
  c=as_emit_cell(B,c,M,N,pol,Lv,Dw,Qw,pnum,pden,sel,drifts,queries,rb,get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}

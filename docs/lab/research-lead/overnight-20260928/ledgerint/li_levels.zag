// LEDGER-INTEGRATION level-field census, v3. Pure Zag.
//
// WHY v3
//   v1 reported 96 of 393 blocks asserting a level; an independent awk
//   cross-check said 150. The disagreement was a defect in MY detector,
//   not in the ledger. v2 added three synthetic controls (which correctly
//   FIRED on the real defect, twice, including the identical
//   wrong-loop-variable class) but still leaned on a line-offset table
//   plus runtime slicing, both of which this compiler does not exercise
//   reliably. v3 removes both: one byte walk, no offset table, no slices.
//
//   The v1 and v2 failures are recorded rather than hidden. They are the
//   same class the research data s6 documents for the standing test
//   battery: a checker whose expectation and whose implementation share
//   one source, with no control to fire. The controls are the fix and
//   they stay in the program.
//
// WHAT THIS DOES
//   Independently re-derive two structural facts about
//   canonical_ledger/CLAIM_LEDGER.md:
//     (1) how many claim BLOCKS it contains, by both entry forms;
//     (2) how many blocks assert a machine-readable evidence LEVEL, and
//         how many of those are unambiguous.
//
// METHOD
//   Block openings are exact line shapes, matched on byte ranges:
//     heading form  "## C<digits>."          -> kind 1
//     bullet form   "- C<digits> ("          -> kind 2
//     "- C<digits>" not followed by " ("     -> kind 3 (sub-bullet)
//   A block body runs from its opening line to the next block opening.
//   A block "asserts a level" if its body contains "L" followed by one
//   or more digits. It is "unambiguous" only if NO L<digits> token in
//   the body is followed by '-' and an upper-case letter, which is the
//   lane-name form (L3-NIV2, L2-INTERFERENCE-D).
//
// CONTROL
//   Three synthetic fixtures with answers known by construction. The
//   program REFUSES to emit a census unless all three return exactly
//   right, and exits 3 with no census if any fails. CTL-C plants a level
//   token on a block opening line and requires it be attributed to the
//   block that line opens, which is precisely the boundary v1 got wrong.
//   An EMPTY fixture is also run: a file with no blocks must yield zero.
//
// HONEST LIMITS, stated up front
//   - This is a substring census. It measures the PRESENCE OF A FIELD,
//     not the truth of a level. A block counted as asserting may still be
//     unreadable by a human.
//   - Contamination by claim NAMES carrying an L<digit> token is real and
//     is measured here rather than assumed away.
//   - No floats in this language; every ratio is integer permille.
//
// LANGUAGE CONSTRAINTS HONOURED (brief s5)
//   no global state; no for loop; no compound && or || inside while
//   conditions; explicit return in void functions; one fn main.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn is_digit(c:i32) i32 {
  if(c<48){ return 0; }
  if(c>57){ return 0; }
  return 1;
}

// Classify the line occupying raw[s,e). No slicing.
// 1 = "## C<digits>."   2 = "- C<digits> ("   3 = "- C<digits>" sub-bullet
// 0 = not a block opening
fn classify_line(raw:[]u8, s:i32, e:i32) i32 {
  let len:i32 = e-s;
  if(len<6){ return 0; }
  let h:i32 = 0;
  if(raw[s]==35 && raw[s+1]==35 && raw[s+2]==32 && raw[s+3]==67){ h=1; }
  let b:i32 = 0;
  if(raw[s]==45 && raw[s+1]==32 && raw[s+2]==67){ b=1; }
  if(h==0 && b==0){ return 0; }
  let j:i32 = s+3;
  if(h==1){ j=s+4; }
  let n:i32 = 0;
  while(j<e){
    if(is_digit(raw[j])==0){ break; }
    j=j+1; n=n+1;
  }
  if(n<1){ return 0; }
  if(h==1){
    if(j<e){ if(raw[j]==46){ return 1; } }
    return 0;
  }
  if(j+1>=e){ return 3; }
  if(raw[j]==32 && raw[j+1]==40){ return 2; }
  return 3;
}

// Scan raw[from,to). Returns hl*4 + ct*2 + (tokens capped at 3)
fn scan_levels(raw:[]u8, from:i32, to:i32) i32 {
  let i:i32 = from;
  let hl:i32 = 0;
  let ct:i32 = 0;
  let nt:i32 = 0;
  while(i<to){
    if(raw[i]==76){
      let j:i32 = i+1;
      let n:i32 = 0;
      while(j<to){
        if(is_digit(raw[j])==0){ break; }
        j=j+1; n=n+1;
      }
      if(n>0){
        hl=1;
        if(nt<3){ nt=nt+1; }
        if(j+1<to){
          let c1:i32 = 0;
          if(raw[j]==45){ c1=1; }
          let c2:i32 = 0;
          if(raw[j+1]>=65 && raw[j+1]<=90){ c2=1; }
          if(c1==1 && c2==1){ ct=1; }
        }
        i=j;
        continue;
      }
    }
    i=i+1;
  }
  return hl*4 + ct*2 + nt;
}

// Single byte walk. Writes 7 tallies into sc (28 bytes).
// sc layout, 40 BYTES. Offsets below are BYTE offsets, spaced 4 apart,
// because get32 and set32 take byte offsets, NOT cell indices.
//   byte  0 head    4 bullet   8 sub     12 asserts
//   byte 16 clean  20 contam  24 nlines  28 inblk
//   byte 32 blkstart          36 pos
//
// HOW THIS PROGRAM WAS WRONG TWICE, AND WHY IT MATTERS
//   Three earlier drafts of this census reported numbers, and two of them
//   were wrong. Both failures are recorded because both are the failure
//   modes this program exists to catch, and because the second one is the
//   documented B16 API trap, which I walked straight into while citing it.
//
//   Draft 1 reported 96 of 393 blocks asserting a level. It read its line
//   END offset from the pass-1 loop variable instead of the pass-2 one, so
//   every body slice was degenerate. Caught by: an independent awk
//   cross-check, which said 150.
//
//   Draft 2 kept its tallies in memory specifically to dodge register
//   pressure, and still returned garbage. The cause was not the compiler.
//   I had written set32(sc,0..9), treating the second argument as a CELL
//   index. It is a BYTE offset. Ten cells written at byte offsets 0..9
//   overlap each other, so every counter overwrote its neighbours. This is
//   exactly research data s1.8: "get32 and set32 take BYTE offsets, not
//   cell indices. API TRAP, confirmed." A 20-line reduction reproduced it
//   with no other defect present.
//
//   The controls below are what caught both. They are not decoration; they
//   are the only reason this program is trustworthy, and they stay in the
//   file. Draft 1 had no controls and published a wrong number with total
//   confidence, which is the same disease as the standing test battery
//   documented in research data s6.
fn census(raw:[]u8, total:i32, sc:[]u8) void {
  set32(sc,0,0); set32(sc,4,0); set32(sc,8,0); set32(sc,12,0);
  set32(sc,16,0); set32(sc,20,0); set32(sc,24,0); set32(sc,28,0);
  set32(sc,32,0); set32(sc,36,0);
  while(get32(sc,36)<total){
    let pos:i32 = get32(sc,36);
    let e:i32 = pos;
    while(e<total){
      if(raw[e]==10){ break; }
      e=e+1;
    }
    set32(sc,24,get32(sc,24)+1);
    let k:i32 = classify_line(raw, pos, e);
    if(k==1){ set32(sc,0,get32(sc,0)+1); }
    if(k==2){ set32(sc,4,get32(sc,4)+1); }
    if(k==3){ set32(sc,8,get32(sc,8)+1); }
    if(k==1 || k==2){
      if(get32(sc,28)==1){
        let r:i32 = scan_levels(raw, get32(sc,32), pos);
        if(r/4==1){
          set32(sc,12,get32(sc,12)+1);
          if((r%4)/2==1){ set32(sc,20,get32(sc,20)+1); }
          if((r%4)/2==0){ set32(sc,16,get32(sc,16)+1); }
        }
      }
      set32(sc,28,1);
      set32(sc,32,pos);
    }
    set32(sc,36,e+1);
  }
  if(get32(sc,28)==1){
    let r:i32 = scan_levels(raw, get32(sc,32), total);
    if(r/4==1){
      set32(sc,12,get32(sc,12)+1);
      if((r%4)/2==1){ set32(sc,20,get32(sc,20)+1); }
      if((r%4)/2==0){ set32(sc,16,get32(sc,16)+1); }
    }
  }
  return;
}

fn ctl(a:[]u8, alen:i32, sc:[]u8, eh:i32, eb:i32, es:i32, ea:i32, ec:i32, ek:i32, en:i32) i32 {
  census(a, alen, sc);
  if(get32(sc,0)!=eh){ return 1; }
  if(get32(sc,4)!=eb){ return 2; }
  if(get32(sc,8)!=es){ return 3; }
  if(get32(sc,12)!=ea){ return 4; }
  if(get32(sc,16)!=ec){ return 5; }
  if(get32(sc,20)!=ek){ return 6; }
  if(get32(sc,24)!=en){ return 7; }
  return 0;
}

fn main()i32 {
  let out:[]u8 = z_alloc(65536);
  let oc:i32 = 0;
  let sc:[]u8 = z_alloc(64);

  // ------------------------------------------------------------- CTL-A
  // 4 blocks: A clean L2, B contaminated L3-NIV2, C clean L1, D none.
  let a:[]u8 = z_alloc(1024);
  let al:i32 = 0;
  al=o_app(a,al,"## C01. alpha\n");            al=o_app(a,al,"body with L2 inside\n\n");
  al=o_app(a,al,"## C02. beta\n");             al=o_app(a,al,"lane L3-NIV2 token\n\n");
  al=o_app(a,al,"- C03 (gamma; prereg x):\n");  al=o_app(a,al,"level L1 here\n\n");
  al=o_app(a,al,"- C04 (delta; prereg y):\n");  al=o_app(a,al,"no level at all\n\n");
  //        head bullet sub asserts clean contam lines
  let ra:i32 = ctl(a,al,sc, 2, 2, 0, 3, 2, 1, 12);
  if(ra!=0){
    oc=o_app(out,oc,"CTL_FAIL A code "); oc=o_i64(out,oc,ra as i64);
    oc=o_app(out,oc," got "); oc=o_i64(out,oc,get32(sc,0));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,4));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,8));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,12));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,16));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,20));
    oc=o_app(out,oc,"/"); oc=o_i64(out,oc,get32(sc,24));
    oc=o_nl(out,oc); o_flush(out,oc); return 3;
  }
  oc=o_app(out,oc,"CTL_A_PASS\n"); oc=o_nl(out,oc);

  // ------------------------------------------------------------- CTL-B
  // No block openings anywhere. Everything must be zero.
  let b:[]u8 = z_alloc(1024);
  let bl:i32 = 0;
  bl=o_app(b,bl,"# Some Heading\n");
  bl=o_app(b,bl,"prose mentioning L2 and L3 only\n");
  bl=o_app(b,bl,"- not a claim line\n");
  bl=o_app(b,bl,"trailing prose\n");
  let rb:i32 = ctl(b,bl,sc, 0, 0, 0, 0, 0, 0, 4);
  if(rb!=0){
    oc=o_app(out,oc,"CTL_FAIL B code "); oc=o_i64(out,oc,rb as i64); oc=o_nl(out,oc);
    o_flush(out,oc); return 3;
  }
  oc=o_app(out,oc,"CTL_B_PASS\n"); oc=o_nl(out,oc);

  // ------------------------------------------------------------- CTL-C
  // Level token ON the opening line of the second block. Must be
  // attributed to block 2, never leak into block 1.
  let c:[]u8 = z_alloc(1024);
  let cl:i32 = 0;
  cl=o_app(c,cl,"## C01. first\n");       cl=o_app(c,cl,"body with nothing\n\n");
  cl=o_app(c,cl,"## C02. second L2\n");   cl=o_app(c,cl,"body nothing\n");
  let rc:i32 = ctl(c,cl,sc, 2, 0, 0, 1, 1, 0, 5);
  if(rc!=0){
    oc=o_app(out,oc,"CTL_FAIL C code "); oc=o_i64(out,oc,rc as i64); oc=o_nl(out,oc);
    o_flush(out,oc); return 3;
  }
  oc=o_app(out,oc,"CTL_C_PASS\n"); oc=o_nl(out,oc);

  // ------------------------------------------------------------- CTL-D
  // Sub-bullets must be counted as sub, not as claims.
  let d:[]u8 = z_alloc(1024);
  let dl:i32 = 0;
  dl=o_app(d,dl,"## C01. only heading\n");
  dl=o_app(d,dl,"- C93 NEEDS-RERUN scope: CLEARED\n");
  dl=o_app(d,dl,"- C106 posture update: BUILD-PASS\n");
  let rd:i32 = ctl(d,dl,sc, 1, 0, 2, 0, 0, 0, 3);
  if(rd!=0){
    oc=o_app(out,oc,"CTL_FAIL D code "); oc=o_i64(out,oc,rd as i64); oc=o_nl(out,oc);
    o_flush(out,oc); return 3;
  }
  oc=o_app(out,oc,"CTL_D_PASS\n"); oc=o_nl(out,oc);

  // ------------------------------------------------------------- REAL LEDGER
  let path:[]u8 = "docs/lab/research-lead/overnight-20260928/canonical_ledger/CLAIM_LEDGER.md";
  let raw:[]u8 = _zag_read_file(path);
  if(raw.len<10){
    oc=o_app(out,oc,"FATAL cannot read ledger\n"); o_flush(out,oc); return 2;
  }
  let total:i32 = raw.len;
  census(raw, total, sc);

  let head:i32 = get32(sc,0);
  let bullet:i32 = get32(sc,4);
  let blocks:i32 = head+bullet;
  let sub:i32 = get32(sc,8);
  let asserts:i32 = get32(sc,12);
  let clean:i32 = get32(sc,16);
  let contam:i32 = get32(sc,20);
  let nlines:i32 = get32(sc,24);
  let silent:i32 = blocks-asserts;

  oc=o_app(out,oc,"LI_LEVELS_CENSUS_V3\n");
  oc=o_app(out,oc,"ledger_bytes ");    oc=o_i64(out,oc,total as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"ledger_lines ");    oc=o_i64(out,oc,nlines as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_heading ");  oc=o_i64(out,oc,head as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_bullet ");   oc=o_i64(out,oc,bullet as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_total ");    oc=o_i64(out,oc,blocks as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"sub_bullets_skipped "); oc=o_i64(out,oc,sub as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_asserting_level ");     oc=o_i64(out,oc,asserts as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_level_uncontaminated "); oc=o_i64(out,oc,clean as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_level_contaminated ");   oc=o_i64(out,oc,contam as i64); oc=o_nl(out,oc);
  oc=o_app(out,oc,"blocks_asserting_none ");       oc=o_i64(out,oc,silent as i64); oc=o_nl(out,oc);
  if(blocks>0){
    oc=o_app(out,oc,"permille_silent ");         oc=o_i64(out,oc,(silent*1000/blocks) as i64); oc=o_nl(out,oc);
    oc=o_app(out,oc,"permille_uncontaminated "); oc=o_i64(out,oc,(clean*1000/blocks) as i64); oc=o_nl(out,oc);
  }
  oc=o_app(out,oc,"LI_LEVELS_CENSUS_END\n");
  o_flush(out,oc);
  return 0;
}

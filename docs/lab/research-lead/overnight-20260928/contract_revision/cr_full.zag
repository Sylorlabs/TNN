// cr_mech.zag -- contract_revision: verification failure drives learner-owned
// contract revision.
// Standalone pure-Zag program. The learner induces I/O signatures with the
// real H1 machinery, commits to a composition, takes a world rejection,
// runs a generic blame walk over the committed chain (learner-initiated
// probes), records the counterexample, and revises the blamed component's
// contract via a generic exception-append operation. The revision content
// comes only from the learner-recorded counterexample; the researcher
// supplies the machinery, never the values.
//
// Conventions: L = learner state slice, E = world state slice.
// L cells (i32): 0 conf_DD, 1 conf_CC, 2 commit_comp, 3 commit_pred,
//   4 commit_input, 5 commit_status (0 none, 1 PENDING, 2 RESOLVED),
//   6..11 comp C stats (in_sum,in_n,out_sum,out_n,sig_in,sig_out),
//   12..17 comp D stats (same layout),
//   18 ce_comp (-1 none), 19 ce_in, 20 ce_pred, 21 ce_actual,
//   22..30 comp C exception list (count + 4 x (in_val,out_kind)),
//   31..39 comp D exception list (same layout),
//   40..49 probe log (per link: comp,in,pred,out,kind), 50 nlinks probed.
// E cells (i32): 0 gate, 1 accepts, 2 rejects,
//   3..11 world facts: 3 facts x (subject, relation, object).
// Kind codes: 1 NODE, 2 NUM. Component ids: C 0, D 1.
// Composition ids: DD 0, CC 1. Exception capacity: 4 per component.

// ---------- output helpers (one buffer, cursor-returning) ----------
// Per toolchain lesson: no _zag_print for dynamic content. All output is
// formatted into ONE preallocated buffer; the driver performs a single
// _zag_raw_syscall write at the end.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1kind(b:[]u8,c:i32,k:i32)i32 {
  if(k==1){return e1str(b,c,"NODE");}
  if(k==2){return e1str(b,c,"NUM");}
  return e1str(b,c,"?");
}
fn e1sig(b:[]u8,c:i32,si:i32,so:i32)i32 {
  c=e1kind(b,c,si);
  c=e1str(b,c,"->");
  c=e1kind(b,c,so);
  return c;
}
fn e1comp(b:[]u8,c:i32,g:i32)i32 {
  if(g==0){return e1str(b,c,"DD");}
  return e1str(b,c,"CC");
}
fn e1cname(b:[]u8,c:i32,cp:i32)i32 {
  if(cp==0){return e1str(b,c,"C");}
  return e1str(b,c,"D");
}
// Render a component's exception list from learner state (reads only).
fn e1exc(b:[]u8,c:i32,L:[]u8,cp:i32)i32 {
  let xb:i32=22+cp*9;
  let n:i32=lg(L,xb);
  c=e1str(b,c," exc=[");
  let i:i32=0;
  while(i<n){
    if(i>0){c=e1str(b,c,",");}
    c=e1i64(b,c,lg(L,xb+1+i*2) as i64);
    c=e1str(b,c,"->");
    c=e1kind(b,c,lg(L,xb+2+i*2));
    i=i+1;
  }
  c=e1str(b,c,"]");
  return c;
}
fn e1contract(b:[]u8,c:i32,L:[]u8,cp:i32)i32 {
  c=e1sig(b,c,h1_sig_in(L,cp),h1_sig_out(L,cp));
  c=e1exc(b,c,L,cp);
  return c;
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }

// ---------- world facts ----------
// Frozen world: relation 91 chain (31,91,32), (32,91,33), (33,91,34).
fn world_init(E:[]u8)void {
  set32(E,3*4,31); set32(E,4*4,91); set32(E,5*4,32);
  set32(E,6*4,32); set32(E,7*4,91); set32(E,8*4,33);
  set32(E,9*4,33); set32(E,10*4,91); set32(E,11*4,34);
  return;
}

// ---------- H1 kind probe (real H1 logic) ----------
// kind(v) = 1 (NODE) iff v appears as a fact subject, else 2 (NUM).
fn probe_kind(E:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<3){
    if(get32(E,(3+i*3)*4)==v){return 1;}
    i=i+1;
  }
  return 2;
}

// ---------- components (fixed true behavior; learner sees only probes) ----------
fn comp_run(c:i32,v:i32)i32 {
  if(c==0){
    if(v==31){return 32;}
    if(v==32){return 33;}
    if(v==33){return 34;}
    return -1;
  }
  return v+1;
}
fn comp_first(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}
fn comp_second(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}

// ---------- H1 signature induction (real H1 logic) ----------
// Per-observation kind accumulation. Signature cells are written ONLY by
// h1_finalize; there are no signature literals anywhere in this program.
fn h1_observe(L:[]u8,E:[]u8,c:i32,vin:i32,vout:i32)void {
  let base:i32=6+c*6;
  ls(L,base+0,lg(L,base+0)+probe_kind(E,vin));
  ls(L,base+1,lg(L,base+1)+1);
  ls(L,base+2,lg(L,base+2)+probe_kind(E,vout));
  ls(L,base+3,lg(L,base+3)+1);
  return;
}
// Majority finalize: once n>=2, sig=1 unless sum*2>=n*3 (mean kind>=1.5).
// Exact rule from l2_h1.zag finalize_sig, adapted only in state layout.
fn h1_finalize(L:[]u8,c:i32)void {
  let base:i32=6+c*6;
  let inn:i32=lg(L,base+1);
  if(inn>=2){
    let si:i32=1;
    if(lg(L,base+0)*2>=inn*3){si=2;}
    ls(L,base+4,si);
  }
  let outn:i32=lg(L,base+3);
  if(outn>=2){
    let so:i32=1;
    if(lg(L,base+2)*2>=outn*3){so=2;}
    ls(L,base+5,so);
  }
  return;
}
fn h1_sig_in(L:[]u8,c:i32)i32 { return lg(L,6+c*6+4); }
fn h1_sig_out(L:[]u8,c:i32)i32 { return lg(L,6+c*6+5); }

// ---------- exception-aware contract application ----------
// Predicted output kind for a concrete input value. A recorded
// counterexample overrides the general kind-level rule.
fn contract_pred(L:[]u8,E:[]u8,cp:i32,vin:i32)i32 {
  let xb:i32=22+cp*9;
  let n:i32=lg(L,xb);
  let i:i32=0;
  while(i<n){
    if(lg(L,xb+1+i*2)==vin){return lg(L,xb+2+i*2);}
    i=i+1;
  }
  if(probe_kind(E,vin)!=h1_sig_in(L,cp)){return -1;}
  return h1_sig_out(L,cp);
}
// Composition prediction: value-keyed prediction for the first link
// (input value known), kind-level seam check for the second link.
// Returns -1 on refusal (seam break).
fn h1_predict_exc(L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  let a:i32=comp_first(g);
  let b:i32=comp_second(g);
  let p1:i32=contract_pred(L,E,a,input);
  if(p1<0){return -1;}
  if(p1!=h1_sig_in(L,b)){return -1;}
  return h1_sig_out(L,b);
}

// ---------- commitment (learner operation) ----------
// Records the contract-predicted outcome BEFORE any execution. The
// prediction is computed from the learned contracts (signatures plus
// recorded exceptions), never from a harness-supplied answer. Status
// PENDING proves the commitment predates execution.
fn learner_commit(L:[]u8,E:[]u8,g:i32,input:i32)void {
  let pred:i32=h1_predict_exc(L,E,g,input);
  ls(L,2,g); ls(L,3,pred); ls(L,4,input); ls(L,5,1);
  return;
}

// ---------- world (environment; fixed law, no per-query targets) ----------
fn world_execute(g:i32,input:i32)i32 {
  let v:i32=comp_run(comp_first(g),input);
  v=comp_run(comp_second(g),v);
  return v;
}
// World law: the downstream machine accepts iff the final output kind
// equals the goal kind. The gate latch is the only consequence signal the
// learner may read. This is the single write site of the gate cell.
fn world_downstream(E:[]u8,v:i32,goal:i32)void {
  let g:i32=0;
  if(probe_kind(E,v)==goal){g=1;set32(E,1*4,get32(E,1*4)+1);}
  else{set32(E,2*4,get32(E,2*4)+1);}
  set32(E,0,g);
  return;
}
fn world_gate(E:[]u8)i32 { return get32(E,0); }

// ---------- confidence update (learner operation) ----------
// Reads ONLY the world gate. Never receives an actual output value.
// Never references a harness answer key. Sole writer of confidence cells.
fn learner_update(L:[]u8,E:[]u8,g:i32)void {
  let gate:i32=world_gate(E);
  let c:i32=lg(L,g);
  if(gate==1){ls(L,g,c+1);}else{ls(L,g,c-1);}
  ls(L,5,2);
  return;
}

// ---------- refutation (learner operation) ----------
// Generic blame walk over the committed chain. For each link in order,
// predict the output kind from the component's current contract, probe
// the component on the concrete input value (a learner-initiated
// experiment through the fixed component interface; the same lawful
// interface H1 teaching uses), and compare against the learner's own
// kind probe of the result. On the first mismatch, record the
// counterexample (comp, in, pred, actual) in learner state and return the
// blamed component. Returns -1 when every link matches. Probe details
// are logged to learner state for the transcript. No component-specific
// or value-specific constants appear in this function.
fn learner_refute(L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  ls(L,18,-1);
  ls(L,50,0);
  let v:i32=input;
  let i:i32=0;
  while(i<2){
    let cp:i32=comp_first(g);
    if(i==1){cp=comp_second(g);}
    let pred:i32=contract_pred(L,E,cp,v);
    let out:i32=comp_run(cp,v);
    let ak:i32=probe_kind(E,out);
    let pb:i32=40+i*5;
    ls(L,pb,cp); ls(L,pb+1,v); ls(L,pb+2,pred); ls(L,pb+3,out); ls(L,pb+4,ak);
    ls(L,50,i+1);
    if(ak!=pred){
      ls(L,18,cp); ls(L,19,v); ls(L,20,pred); ls(L,21,ak);
      return cp;
    }
    v=out;
    i=i+1;
  }
  return -1;
}

// ---------- revision (learner operation) ----------
// Generic contract revision: append the recorded counterexample as a
// value-keyed exception on the blamed component, unless already present.
// Every value read comes from the counterexample cells; no
// component-specific or value-specific constants appear in this function.
// No-ops when no counterexample was recorded. The three exception-cell
// writes below are the only exception writes in the program.
fn learner_revise(L:[]u8)void {
  let cp:i32=lg(L,18);
  if(cp<0){return;}
  let xb:i32=22+cp*9;
  let n:i32=lg(L,xb);
  let v:i32=lg(L,19);
  let k:i32=lg(L,21);
  let i:i32=0;
  while(i<n){
    if(lg(L,xb+1+i*2)==v){return;}
    i=i+1;
  }
  if(n<4){
    ls(L,xb+1+n*2,v);
    ls(L,xb+2+n*2,k);
    ls(L,xb,n+1);
  }
  return;
}

// ---------- selection (learner operation) ----------
// Among contract-admissible compositions (exception-aware prediction
// equals the goal kind), pick argmax confidence. Tie -> lowest
// composition id. Reads the confidence ledger and the learned contracts
// only.
fn learner_select(L:[]u8,E:[]u8,input:i32,goal:i32)i32 {
  let best:i32=-1;
  let bestc:i32=0;
  let have:i32=0;
  let g:i32=0;
  while(g<2){
    let p:i32=h1_predict_exc(L,E,g,input);
    if(p==goal){
      let c:i32=lg(L,g);
      if(have==0){best=g;bestc=c;have=1;}
      else{if(c>bestc){best=g;bestc=c;}}
    }
    g=g+1;
  }
  return best;
}
// cr_main.zag -- contract_revision: driver (harness).
// Phases TEACH, Z2, REFUTE, REVISE, RETEST, REGRESS, Z4, Z5.
// Transcript emission. main().
// The driver sequences phases and logs white-box instrumentation; it is
// not cognition. Actual output values on the commit path appear in the
// log as labeled instrumentation and are never passed to any learner
// function. Refutation probe outcomes are learner-observed experiment
// results (the learner calls comp_run itself inside learner_refute).

fn e1chainx(b:[]u8,c:i32,L:[]u8,g:i32)i32 {
  let a:i32=comp_first(g);
  let d:i32=comp_second(g);
  c=e1contract(b,c,L,a);
  c=e1str(b,c,";");
  c=e1contract(b,c,L,d);
  return c;
}

// TEACH: two frozen probes per component, H1 observe + finalize.
fn phase_teach(b:[]u8,c:i32,L:[]u8,E:[]u8,comp:i32,a1:i32,a2:i32)i32 {
  let o1:i32=comp_run(comp,a1);
  h1_observe(L,E,comp,a1,o1);
  c=e1str(b,c,"OBS "); c=e1cname(b,c,comp);
  c=e1str(b,c," in="); c=e1i64(b,c,a1 as i64);
  c=e1str(b,c," kin="); c=e1kind(b,c,probe_kind(E,a1));
  c=e1str(b,c," out="); c=e1i64(b,c,o1 as i64);
  c=e1str(b,c," kout="); c=e1kind(b,c,probe_kind(E,o1));
  c=e1str(b,c,"\n");
  let o2:i32=comp_run(comp,a2);
  h1_observe(L,E,comp,a2,o2);
  c=e1str(b,c,"OBS "); c=e1cname(b,c,comp);
  c=e1str(b,c," in="); c=e1i64(b,c,a2 as i64);
  c=e1str(b,c," kin="); c=e1kind(b,c,probe_kind(E,a2));
  c=e1str(b,c," out="); c=e1i64(b,c,o2 as i64);
  c=e1str(b,c," kout="); c=e1kind(b,c,probe_kind(E,o2));
  c=e1str(b,c,"\n");
  h1_finalize(L,comp);
  c=e1str(b,c,"TEACH "); c=e1cname(b,c,comp);
  c=e1str(b,c," sig="); c=e1contract(b,c,L,comp);
  c=e1str(b,c,"\n");
  return c;
}

// One commit/execute/consequence/update episode. tag is "Z2" or "Z5".
fn phase_commit(b:[]u8,c:i32,L:[]u8,E:[]u8,g:i32,input:i32,goal:i32,tag:[]u8)i32 {
  let before:i32=lg(L,g);
  learner_commit(L,E,g,input);
  let st:i32=lg(L,5);
  c=e1str(b,c,tag); c=e1str(b,c," COMMIT comp="); c=e1comp(b,c,g);
  c=e1str(b,c," predicted="); c=e1kind(b,c,lg(L,3));
  c=e1str(b,c," input="); c=e1i64(b,c,input as i64);
  c=e1str(b,c," status=");
  if(st==1){c=e1str(b,c,"PENDING");}else{c=e1str(b,c,"OTHER");}
  c=e1str(b,c," contracts="); c=e1chainx(b,c,L,g);
  c=e1str(b,c,"\n");
  let actual:i32=world_execute(g,input);
  c=e1str(b,c,tag); c=e1str(b,c," EXEC actual="); c=e1i64(b,c,actual as i64);
  c=e1str(b,c," (instrumentation, not learner input)\n");
  world_downstream(E,actual,goal);
  let gate:i32=world_gate(E);
  c=e1str(b,c,tag); c=e1str(b,c," CONSEQUENCE gate="); c=e1i64(b,c,gate as i64);
  if(gate==1){c=e1str(b,c," downstream=ACCEPT\n");}else{c=e1str(b,c," downstream=REJECT\n");}
  learner_update(L,E,g);
  let after:i32=lg(L,g);
  c=e1str(b,c,tag); c=e1str(b,c," UPDATE comp="); c=e1comp(b,c,g);
  c=e1str(b,c," conf="); c=e1i64(b,c,before as i64);
  c=e1str(b,c,"->"); c=e1i64(b,c,after as i64);
  c=e1str(b,c," (source=gate)\n");
  return c;
}

// REFUTE: invoke the learner's blame walk; render its probe log and the
// recorded counterexample from learner state.
fn phase_refute(b:[]u8,c:i32,L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  c=e1str(b,c,"REFUTE chain="); c=e1comp(b,c,g);
  c=e1str(b,c," input="); c=e1i64(b,c,input as i64);
  c=e1str(b,c," (learner-initiated probes)\n");
  let blamed:i32=learner_refute(L,E,g,input);
  let n:i32=lg(L,50);
  let i:i32=0;
  while(i<n){
    let pb:i32=40+i*5;
    c=e1str(b,c,"REFUTE link="); c=e1i64(b,c,i as i64);
    c=e1str(b,c," comp="); c=e1cname(b,c,lg(L,pb));
    c=e1str(b,c," in="); c=e1i64(b,c,lg(L,pb+1) as i64);
    c=e1str(b,c," pred="); c=e1kind(b,c,lg(L,pb+2));
    c=e1str(b,c," probed-out="); c=e1i64(b,c,lg(L,pb+3) as i64);
    c=e1str(b,c," probed-kind="); c=e1kind(b,c,lg(L,pb+4));
    if(lg(L,pb+4)!=lg(L,pb+2)){c=e1str(b,c," MISMATCH\n");}else{c=e1str(b,c," match\n");}
    i=i+1;
  }
  if(blamed>=0){
    c=e1str(b,c,"REFUTE COUNTEREXAMPLE comp="); c=e1cname(b,c,lg(L,18));
    c=e1str(b,c," in="); c=e1i64(b,c,lg(L,19) as i64);
    c=e1str(b,c," pred="); c=e1kind(b,c,lg(L,20));
    c=e1str(b,c," actual="); c=e1kind(b,c,lg(L,21));
    c=e1str(b,c,"\n");
  }else{
    c=e1str(b,c,"REFUTE no-counterexample (contract explains all links)\n");
  }
  return c;
}

// REVISE: snapshot the blamed component's contract, run the learner's
// generic revision, snapshot again.
fn phase_revise(b:[]u8,c:i32,L:[]u8,cp:i32)i32 {
  c=e1str(b,c,"REVISE before "); c=e1cname(b,c,cp);
  c=e1str(b,c," sig="); c=e1contract(b,c,L,cp);
  c=e1str(b,c,"\n");
  learner_revise(L);
  c=e1str(b,c,"REVISE after "); c=e1cname(b,c,cp);
  c=e1str(b,c," sig="); c=e1contract(b,c,L,cp);
  c=e1str(b,c,"\n");
  return c;
}

// RETEST / REGRESS: compare the learner's contract prediction against
// the fixed world law applied to the world's true behavior.
fn phase_test(b:[]u8,c:i32,L:[]u8,E:[]u8,cp:i32,vin:i32,tag:[]u8)i32 {
  let pred:i32=contract_pred(L,E,cp,vin);
  let wk:i32=probe_kind(E,comp_run(cp,vin));
  c=e1str(b,c,tag); c=e1str(b,c," "); c=e1cname(b,c,cp);
  c=e1str(b,c,"("); c=e1i64(b,c,vin as i64); c=e1str(b,c,")");
  c=e1str(b,c," pred="); c=e1kind(b,c,pred);
  c=e1str(b,c," world-kind="); c=e1kind(b,c,wk);
  if(pred==wk){c=e1str(b,c," MATCH\n");}else{c=e1str(b,c," MISMATCH\n");}
  return c;
}

fn main()i32 {
  let OUT:[]u8=z_alloc(8192);
  let oc:i32=0;
  oc=e1str(OUT,oc,"CR-INTEGRATION run\n");
  let L:[]u8=z_alloc(256);
  let E:[]u8=z_alloc(128);
  world_init(E);
  oc=e1str(OUT,oc,"TEACH rule=kind-probe(NODE iff fact-subject)+record-obs+majority(n>=2)\n");
  oc=e1str(OUT,oc,"TEACH facts subjects=31,32,33 rel=91\n");
  oc=phase_teach(OUT,oc,L,E,0,31,32);
  oc=phase_teach(OUT,oc,L,E,1,31,32);
  oc=e1str(OUT,oc,"NOTE D probes covered 31,32 only; true kind(D(33))=kind(34)=NUM: contract honestly overgeneralized\n");
  // Z2: goal input 33, want NODE. Commit DD (contracts predict NODE).
  oc=e1str(OUT,oc,"Z2 GOAL input=33 want=NODE\n");
  oc=phase_commit(OUT,oc,L,E,0,33,1,"Z2");
  // REFUTE + REVISE: the failure triggers the learner's blame walk and
  // generic contract revision.
  oc=phase_refute(OUT,oc,L,E,0,33);
  oc=phase_revise(OUT,oc,L,1);
  // RETEST the counterexample input; REGRESS the previously probed ones.
  oc=phase_test(OUT,oc,L,E,1,33,"RETEST");
  oc=phase_test(OUT,oc,L,E,1,31,"REGRESS");
  oc=phase_test(OUT,oc,L,E,1,32,"REGRESS");
  // Z4: new problem, input 33, want NODE. Selection with revised contracts.
  oc=e1str(OUT,oc,"Z4 PROBLEM input=33 want=NODE\n");
  let pdd:i32=h1_predict_exc(L,E,0,33);
  let pcc:i32=h1_predict_exc(L,E,1,33);
  oc=e1str(OUT,oc,"Z4 ADMISS DD=");
  if(pdd<0){oc=e1str(OUT,oc,"no(refused: D(33)->NUM breaks seam vs sig_in=NODE)");}
  else{oc=e1str(OUT,oc,"yes");}
  oc=e1str(OUT,oc," CC=");
  if(pcc<0){oc=e1str(OUT,oc,"no");}else{oc=e1str(OUT,oc,"yes");}
  oc=e1str(OUT,oc,"\n");
  let ch4:i32=learner_select(L,E,33,1);
  oc=e1str(OUT,oc,"Z4 SELECT choice="); oc=e1comp(OUT,oc,ch4);
  oc=e1str(OUT,oc," (no execution; C revision out of scope)\n");
  // Z5: goal input 31, want NODE. The revised contract must still work here.
  oc=e1str(OUT,oc,"Z5 GOAL input=31 want=NODE\n");
  oc=phase_commit(OUT,oc,L,E,0,31,1,"Z5");
  oc=e1str(OUT,oc,"SUMMARY revised-comp=D");
  oc=e1str(OUT,oc," exc-count="); oc=e1i64(OUT,oc,lg(L,31) as i64);
  oc=e1str(OUT,oc," retest-ok=");
  if(contract_pred(L,E,1,33)==probe_kind(E,comp_run(1,33))){oc=e1str(OUT,oc,"1");}else{oc=e1str(OUT,oc,"0");}
  oc=e1str(OUT,oc," regress-ok=");
  let rok:i32=0;
  if(contract_pred(L,E,1,31)==probe_kind(E,comp_run(1,31))){rok=rok+1;}
  if(contract_pred(L,E,1,32)==probe_kind(E,comp_run(1,32))){rok=rok+1;}
  oc=e1i64(OUT,oc,rok as i64);
  oc=e1str(OUT,oc," z4-choice="); oc=e1comp(OUT,oc,ch4);
  oc=e1str(OUT,oc," z5-confDD="); oc=e1i64(OUT,oc,lg(L,0) as i64);
  oc=e1str(OUT,oc,"\n");
  // Single raw write of exactly the buffered bytes.
  let _wn:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),oc as i64,0,0,0);
  if(_wn<0){oc=0;}
  return 0;
}

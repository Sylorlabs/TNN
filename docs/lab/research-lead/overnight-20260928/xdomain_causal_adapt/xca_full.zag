// xca_world.zag -- experiment side (WORLD TRUTH). Functions prefixed w_.
// The learner side may call ONLY w_t_probe (the probe API) and read the
// free observational buffers. w_t_eval / w_s_eval are harness truth,
// called only by the driver. w_t_bind implements T's namespace.

// ---- alloc / cell helpers (u8-backed, little-endian) ----
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn cell(f:[]u8, nv:i32, i:i32, v:i32)i32 {
  return get32(f,(i*nv+v)*4);
}
fn setcell(f:[]u8, nv:i32, i:i32, v:i32, x:i32)void {
  set32(f,(i*nv+v)*4,x);
  return;
}

// ---- output buffer emit helpers (single buffer, cursor) ----
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_bar(name:[]u8, pass:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  if(pass!=1){at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}

// ---- source world S: a=2a... b=2a, c=a+b; vars a=0,b=1,c=2 ----
fn w_s_build(f:[]u8)void {
  let i:i32=0;
  while(i<4){
    let a:i32=i+1;
    setcell(f,3,i,0,a);
    setcell(f,3,i,1,2*a);
    setcell(f,3,i,2,3*a);
    i=i+1;
  }
  return;
}
fn w_s_prow(f:[]u8)void {
  // structural probe in S: set b=5, a ambient 1 -> (1,5,6)
  setcell(f,3,0,0,1);
  setcell(f,3,0,1,5);
  setcell(f,3,0,2,6);
  return;
}
// harness truth only: c after setting var v to val (a ambient 1)
fn w_s_eval(v:i32, val:i32)i32 {
  if(v==0){return 3*val;}
  if(v==1){return 1+val;}
  return 3;
}

// ---- target world T: p=0,q=1,r=2,d=3,s=4; h hidden ----
// truth: q=2p, h=p+q, r=h, d=r+1, s=r+d
fn w_t_build(f:[]u8)void {
  let i:i32=0;
  while(i<4){
    let p:i32=i+1;
    let q:i32=2*p;
    let r:i32=3*p;
    let d:i32=r+1;
    setcell(f,5,i,0,p);
    setcell(f,5,i,1,q);
    setcell(f,5,i,2,r);
    setcell(f,5,i,3,d);
    setcell(f,5,i,4,r+d);
    i=i+1;
  }
  return;
}
// LEARNER-VISIBLE probe API: set observed var v to 6, read (p,q,r,d,s).
fn w_t_probe(v:i32, out:[]u8)void {
  let p:i32=1;
  let q:i32=2;
  let r:i32=3;
  let d:i32=4;
  let s:i32=7;
  if(v==0){
    p=6; q=12; r=18; d=19; s=37;
  }
  if(v==1){
    p=1; q=6; r=7; d=8; s=15;
  }
  if(v==3){
    p=1; q=2; r=3; d=6; s=9;
  }
  set32(out,0,p);
  set32(out,4,q);
  set32(out,8,r);
  set32(out,12,d);
  set32(out,16,s);
  return;
}
// harness truth only: r after setting var v to val
fn w_t_eval(v:i32, val:i32)i32 {
  if(v==0){return 3*val;}
  if(v==1){return val+1;}
  return 3;
}
// T namespace: p=10,q=11,r=12,d=13,s=14 -> index; anything else -1.
// S's 'a' is name 0 -> unbound in T (this is what L_copy hits).
fn w_t_bind(name:i32)i32 {
  if(name==10){return 0;}
  if(name==11){return 1;}
  if(name==12){return 2;}
  if(name==13){return 3;}
  if(name==14){return 4;}
  return -1;
}
// xca_learner.zag -- learner side. Functions prefixed l_.
// GENERIC code: operates on (edge tables, probe API) only. No branches on
// variable names, no S/T-pair special casing. The learner calls w_t_probe
// and reads free observational buffers; it never calls w_t_eval/w_s_eval.

// fits_mul: does v == k*u hold on all non-skipped rows?
// parr[j] = intervened var of probe row j (skipped for v's own equation).
fn fits_mul(f:[]u8, nv:i32, nr_obs:i32, nr_probe:i32, parr:[]u8, v:i32, u:i32, k:i32)i32 {
  let nr:i32=nr_obs+nr_probe;
  let i:i32=0;
  let ok:i32=1;
  while(i<nr){
    let skip:i32=0;
    if(i>=nr_obs){
      if((parr[i-nr_obs] as i32)==v){skip=1;}
    }
    if(skip==0){
      if(cell(f,nv,i,v)!=k*cell(f,nv,i,u)){ok=0;}
    }
    i=i+1;
  }
  return ok;
}

// fits_add: does v == u1+u2 hold on all non-skipped rows?
fn fits_add(f:[]u8, nv:i32, nr_obs:i32, nr_probe:i32, parr:[]u8, v:i32, u1:i32, u2:i32)i32 {
  let nr:i32=nr_obs+nr_probe;
  let i:i32=0;
  let ok:i32=1;
  while(i<nr){
    let skip:i32=0;
    if(i>=nr_obs){
      if((parr[i-nr_obs] as i32)==v){skip=1;}
    }
    if(skip==0){
      if(cell(f,nv,i,v)!=cell(f,nv,i,u1)+cell(f,nv,i,u2)){ok=0;}
    }
    i=i+1;
  }
  return ok;
}

// Generic causal discovery. Edge forms: 0=none(root), 1=MUL(k), 2=ADD.
// Preregistered fixed tie-break: MUL vs ADD tie -> prefer ADD (preserve
// observed mediators; do not marginalize an observed variable out).
// Returns tie-break trigger count. ek/ekk/ep1/ep2/enp are []u8 length nv.
fn l_discover(f:[]u8, nv:i32, nr_obs:i32, nr_probe:i32, parr:[]u8, ek:[]u8, ekk:[]u8, ep1:[]u8, ep2:[]u8, enp:[]u8)i32 {
  let tbreak:i32=0;
  let v:i32=0;
  while(v<nv){
    ek[v]=0; ekk[v]=0; ep1[v]=0; ep2[v]=0; enp[v]=0;
    let mfound:i32=0;
    let mk:i32=0;
    let mu:i32=0;
    let u:i32=0;
    while(u<nv){
      if(u!=v){
        let k:i32=1;
        while(k<=5){
          if(mfound==0){
            if(fits_mul(f,nv,nr_obs,nr_probe,parr,v,u,k)==1){
              mfound=1; mk=k; mu=u;
            }
          }
          k=k+1;
        }
      }
      u=u+1;
    }
    let afound:i32=0;
    let au1:i32=0;
    let au2:i32=0;
    let u1:i32=0;
    while(u1<nv){
      let u2:i32=u1+1;
      while(u2<nv){
        if(afound==0){
          if(u1!=v){
            if(u2!=v){
              if(fits_add(f,nv,nr_obs,nr_probe,parr,v,u1,u2)==1){
                afound=1; au1=u1; au2=u2;
              }
            }
          }
        }
        u2=u2+1;
      }
      u1=u1+1;
    }
    if(mfound==1){
      if(afound==1){
        tbreak=tbreak+1;
      }
    }
    // tie-break: prefer ADD whenever it fits
    if(afound==1){
      ek[v]=2; ep1[v]=au1 as u8; ep2[v]=au2 as u8; enp[v]=2;
    }
    if(afound==0){
      if(mfound==1){
        ek[v]=1; ekk[v]=mk as u8; ep1[v]=mu as u8; enp[v]=1;
      }
    }
    v=v+1;
  }
  return tbreak;
}

// has_par[v]=1 if ek[v]!=0; has_ch[v]=1 if v is any edge's parent.
fn l_roles(ek:[]u8, ep1:[]u8, ep2:[]u8, enp:[]u8, nv:i32, has_par:[]u8, has_ch:[]u8)void {
  let v:i32=0;
  while(v<nv){
    has_par[v]=0;
    has_ch[v]=0;
    if((ek[v] as i32)!=0){has_par[v]=1;}
    v=v+1;
  }
  let x:i32=0;
  while(x<nv){
    if((ek[x] as i32)!=0){
      let p1:i32=ep1[x] as i32;
      has_ch[p1]=1;
      if((enp[x] as i32)==2){
        let p2:i32=ep2[x] as i32;
        has_ch[p2]=1;
      }
    }
    x=x+1;
  }
  return;
}

// out[]u8 layout (i32 cells at 4-byte offsets):
// 0 probe1, 4 probe2, 8 measured_total, 12 xpred_total, 16 d_delta_r,
// 20 rmap0, 24 rmap1, 28 rmap2, 32 outcome, 36 pred_p, 40 pred_q,
// 44 pred_d, 48 tbreak, 52 pick, 56 has_x, 60 probe_count,
// 64 d_kind, 68 s_downstream, 72 ncand (derived candidate count)
//
// has_x=1: X-driven adaptation. has_x=0: X-ablated (order-based probe
// selection + linear-extrapolation planner) = the from-scratch baseline.
// order[]u8 holds the presentation order (used only when has_x=0).
fn l_adapt(has_x:i32, order:[]u8, xek:[]u8, xekk:[]u8, xep1:[]u8, xep2:[]u8, xenp:[]u8, tobs:[]u8, out:[]u8)i32 {
  let nv:i32=5;
  let oek:[]u8=z_alloc(8);
  let oekk:[]u8=z_alloc(8);
  let oep1:[]u8=z_alloc(8);
  let oep2:[]u8=z_alloc(8);
  let oenp:[]u8=z_alloc(8);
  let hpar:[]u8=z_alloc(8);
  let hch:[]u8=z_alloc(8);
  let dummy:[]u8=z_alloc(8);
  let ramb:i32=cell(tobs,nv,0,2);
  set32(out,56,has_x);
  set32(out,60,2);
  if(has_x==1){
    // X role identities (derived from X, not hardcoded): root = no
    // parents; xmid = MUL var; xleaf = ADD var.
    let xroot:i32=0;
    let xmid:i32=0;
    let xleaf:i32=0;
    let sv:i32=0;
    while(sv<3){
      if((xek[sv] as i32)==0){xroot=sv;}
      if((xek[sv] as i32)==1){xmid=sv;}
      if((xek[sv] as i32)==2){xleaf=sv;}
      sv=sv+1;
    }
    let xpred:i32=(xekk[xmid] as i32)+1;
    set32(out,12,xpred);
    // obs-only discovery -> role candidacy scores (order-invariant)
    let t0:i32=l_discover(tobs,nv,4,0,dummy,oek,oekk,oep1,oep2,oenp);
    if(t0!=t0){set32(out,48,-999);}
    l_roles(oek,oep1,oep2,oenp,nv,hpar,hch);
    let root_c:i32=-1;
    let mid_c:i32=-1;
    let leaf_c:i32=-1;
    let v:i32=0;
    while(v<nv){
      if((hpar[v] as i32)==0){
        if(root_c==-1){root_c=v;}
      }
      v=v+1;
    }
    v=0;
    while(v<nv){
      if((oek[v] as i32)==1){
        if((oekk[v] as i32)==(xekk[xmid] as i32)){
          if((oep1[v] as i32)==root_c){
            if(mid_c==-1){mid_c=v;}
          }
        }
      }
      v=v+1;
    }
    v=0;
    while(v<nv){
      if((oek[v] as i32)==2){
        let p1:i32=oep1[v] as i32;
        let p2:i32=oep2[v] as i32;
        let okp:i32=0;
        if(p1==root_c){if(p2==mid_c){okp=1;}}
        if(p1==mid_c){if(p2==root_c){okp=1;}}
        if(okp==1){
          if(leaf_c==-1){leaf_c=v;}
        }
      }
      v=v+1;
    }
    let score:[]u8=z_alloc(8);
    v=0;
    while(v<nv){score[v]=0;v=v+1;}
    if(root_c>=0){score[root_c]=2;}
    if(mid_c>=0){score[mid_c]=1;}
    if(leaf_c>=0){score[leaf_c]=1;}
    // probe1 = highest score (first); probe2 = lowest score among
    // DERIVED intervention candidates (first). Candidates are computed,
    // not hardcoded: all observed vars except the leaf-analog (the
    // intervention target) and except vars downstream of it (children
    // of the leaf-analog in the obs-only discovered model).
    let probe1:i32=0;
    let best:i32=-1;
    v=0;
    while(v<nv){
      if((score[v] as i32)>best){best=score[v] as i32;probe1=v;}
      v=v+1;
    }
    let cand:[]u8=z_alloc(8);
    let nc:i32=0;
    v=0;
    while(v<nv){
      let okc:i32=1;
      if(v==leaf_c){okc=0;}
      if((oep1[v] as i32)==leaf_c){okc=0;}
      if((oenp[v] as i32)==2){
        if((oep2[v] as i32)==leaf_c){okc=0;}
      }
      if(okc==1){
        cand[nc]=v as u8;
        nc=nc+1;
      }
      v=v+1;
    }
    set32(out,72,nc);
    let probe2:i32=cand[0] as i32;
    let worst:i32=99;
    let ci:i32=0;
    while(ci<nc){
      let cv:i32=cand[ci] as i32;
      if((score[cv] as i32)<worst){worst=score[cv] as i32;probe2=cv;}
      ci=ci+1;
    }
    set32(out,0,probe1);
    set32(out,4,probe2);
    // probe 1: confirm X's predicted root total-effect
    let pr1:[]u8=z_alloc(24);
    w_t_probe(probe1,pr1);
    let vamb1:i32=cell(tobs,nv,0,probe1);
    let r1:i32=get32(pr1,8);
    let measured:i32=(r1-ramb)/(6-vamb1);
    set32(out,8,measured);
    // probe 2: test X's risky prediction (non-role var inert for r)
    let pr2:[]u8=z_alloc(24);
    w_t_probe(probe2,pr2);
    let r2:i32=get32(pr2,8);
    set32(out,16,r2-ramb);
    // full discovery on obs + 2 probe rows; re-verify the role map
    let tall:[]u8=z_alloc(6*5*4);
    let i:i32=0;
    while(i<4){
      v=0;
      while(v<nv){
        setcell(tall,nv,i,v,cell(tobs,nv,i,v));
        v=v+1;
      }
      i=i+1;
    }
    v=0;
    while(v<nv){
      setcell(tall,nv,4,v,get32(pr1,v*4));
      setcell(tall,nv,5,v,get32(pr2,v*4));
      v=v+1;
    }
    let parr:[]u8=z_alloc(8);
    parr[0]=probe1 as u8;
    parr[1]=probe2 as u8;
    let fek:[]u8=z_alloc(8);
    let fekk:[]u8=z_alloc(8);
    let fep1:[]u8=z_alloc(8);
    let fep2:[]u8=z_alloc(8);
    let fenp:[]u8=z_alloc(8);
    let tb:i32=l_discover(tall,nv,4,2,parr,fek,fekk,fep1,fep2,fenp);
    set32(out,48,tb);
    set32(out,64,fek[3] as i32);
    l_roles(fek,fep1,fep2,fenp,nv,hpar,hch);
    let root2:i32=-1;
    let mid2:i32=-1;
    let leaf2:i32=-1;
    v=0;
    while(v<nv){
      if((hpar[v] as i32)==0){
        if(root2==-1){root2=v;}
      }
      v=v+1;
    }
    v=0;
    while(v<nv){
      if((fek[v] as i32)==1){
        if((fekk[v] as i32)==(xekk[xmid] as i32)){
          if((fep1[v] as i32)==root2){
            if(mid2==-1){mid2=v;}
          }
        }
      }
      v=v+1;
    }
    v=0;
    while(v<nv){
      if((fek[v] as i32)==2){
        let p1:i32=fep1[v] as i32;
        let p2:i32=fep2[v] as i32;
        let okp:i32=0;
        if(p1==root2){if(p2==mid2){okp=1;}}
        if(p1==mid2){if(p2==root2){okp=1;}}
        if(okp==1){
          if(leaf2==-1){leaf2=v;}
        }
      }
      v=v+1;
    }
    // role map: S[xroot]->root2 etc; d(3) must be non-role; s(4)
    // must be downstream of the leaf analog
    set32(out,20,root2);
    set32(out,24,mid2);
    set32(out,28,leaf2);
    let sds:i32=0;
    if((fep1[4] as i32)==leaf2){sds=1;}
    if((fenp[4] as i32)==2){
      if((fep2[4] as i32)==leaf2){sds=1;}
    }
    set32(out,68,sds);
    // transferred policy schema "set ROOT to max", interface re-bound
    // through the role map. The learner COMMITS to the intervention
    // variable here; the driver (harness) executes it in the world.
    // The learner never calls w_t_eval / w_s_eval.
    set32(out,52,root2);
    // predicted intervention outcomes per candidate
    let vamb0:i32=cell(tobs,nv,0,0);
    let pred_p:i32=ramb+measured*(10-vamb0);
    let pred_q:i32=cell(tobs,nv,0,root2)+10;
    let pred_d:i32=ramb+(r2-ramb);
    set32(out,36,pred_p);
    set32(out,40,pred_q);
    set32(out,44,pred_d);
    return root2;
  }
  // has_x == 0: X-ablated pipeline (from-scratch baseline).
  // Order-based probe selection + linear-extrapolation planner.
  let audit:[]u8=z_alloc(8);
  let a1:[]u8=z_alloc(8);
  let a2:[]u8=z_alloc(8);
  let a3:[]u8=z_alloc(8);
  let a4:[]u8=z_alloc(8);
  let tb0:i32=l_discover(tobs,nv,4,0,dummy,audit,a1,a2,a3,a4);
  if(tb0!=tb0){set32(out,48,-999);}
  let p1:i32=order[0] as i32;
  let p2:i32=order[1] as i32;
  set32(out,0,p1);
  set32(out,4,p2);
  let q1:[]u8=z_alloc(24);
  let q2:[]u8=z_alloc(24);
  w_t_probe(p1,q1);
  w_t_probe(p2,q2);
  let va1:i32=cell(tobs,nv,0,p1);
  let va2:i32=cell(tobs,nv,0,p2);
  let s1:i32=(get32(q1,8)-ramb)/(6-va1);
  let s2:i32=(get32(q2,8)-ramb)/(6-va2);
  let pr1:i32=ramb+s1*(10-va1);
  let pr2:i32=ramb+s2*(10-va2);
  let pick:i32=p1;
  if(pr2>pr1){pick=p2;}
  set32(out,52,pick);
  return pick;
}

// L_copy: literal reuse of X's source policy "set a to 10".
// out: 0=inapplicable flag. Returns the bound variable or -1.
// The void intervention is never executed; the driver scores ambient.
fn l_copy(out:[]u8)i32 {
  // S name 'a' = 0; T namespace bind:
  let b:i32=w_t_bind(0);
  if(b==-1){
    set32(out,0,1);
    return -1;
  }
  set32(out,0,0);
  return b;
}
// xca_driver.zag -- experiment driver. Owns world truth handles, runs the
// three learners, evaluates the frozen kill bars, emits the report.
// The driver calls w_t_eval / w_s_eval (harness truth); learners never do.

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  e0(ob,atp,"XCA causal->intervention adaptation experiment");

  // ============ PHASE 1: learn X in S ============
  let sall:[]u8=z_alloc(5*3*4);
  w_s_build(sall);
  let sprow:[]u8=z_alloc(12);
  w_s_prow(sprow);
  let i:i32=0;
  while(i<3){
    setcell(sall,3,4,i,cell(sprow,3,0,i));
    i=i+1;
  }
  let sparr:[]u8=z_alloc(8);
  sparr[0]=1;
  let xek:[]u8=z_alloc(8);
  let xekk:[]u8=z_alloc(8);
  let xep1:[]u8=z_alloc(8);
  let xep2:[]u8=z_alloc(8);
  let xenp:[]u8=z_alloc(8);
  let tb_s:i32=l_discover(sall,3,4,1,sparr,xek,xekk,xep1,xep2,xenp);
  let xhpar:[]u8=z_alloc(8);
  let xhch:[]u8=z_alloc(8);
  l_roles(xek,xep1,xep2,xenp,3,xhpar,xhch);
  e2(ob,atp,"PHASE1 S edges: b_kind=",(xek[1] as i32)," b_k=",(xekk[1] as i32));
  e2(ob,atp,"PHASE1 S edges: c_kind=",(xek[2] as i32)," c_npar=",(xenp[2] as i32));
  e2(ob,atp,"PHASE1 S: c_par0=",(xep1[2] as i32)," c_par1=",(xep2[2] as i32));
  e2(ob,atp,"PHASE1 S: a_kind=",(xek[0] as i32)," tbreak_s=",(tb_s));
  let s_a10:i32=w_s_eval(0,10);
  let s_b10:i32=w_s_eval(1,10);
  e2(ob,atp,"S demo: set a=10 -> c=",(s_a10)," ; set b=10 -> c=",(s_b10));
  // K1
  let k1:i32=1;
  if((xek[1] as i32)!=1){k1=0;}
  if((xekk[1] as i32)!=2){k1=0;}
  if((xep1[1] as i32)!=0){k1=0;}
  if((xek[2] as i32)!=2){k1=0;}
  if((xenp[2] as i32)!=2){k1=0;}
  if((xep1[2] as i32)!=0){k1=0;}
  if((xep2[2] as i32)!=1){k1=0;}
  if((xek[0] as i32)!=0){k1=0;}
  if((xhpar[0] as i32)!=0){k1=0;}
  if((xhpar[1] as i32)!=1){k1=0;}
  if((xhch[1] as i32)!=1){k1=0;}
  if((xhpar[2] as i32)!=1){k1=0;}
  if((xhch[2] as i32)!=0){k1=0;}
  if(tb_s!=0){k1=0;}
  if(s_a10!=30){k1=0;}
  if(s_b10!=11){k1=0;}
  if(s_a10<=s_b10){k1=0;}

  // ============ PHASE 2: T adaptation ============
  let tobs:[]u8=z_alloc(4*5*4);
  w_t_build(tobs);
  let dummy_order:[]u8=z_alloc(8);
  let outa:[]u8=z_alloc(96);
  let adapt_pick:i32=l_adapt(1,dummy_order,xek,xekk,xep1,xep2,xenp,tobs,outa);
  let adapt_out:i32=w_t_eval(adapt_pick,10);
  let probe1:i32=get32(outa,0);
  let probe2:i32=get32(outa,4);
  let measured:i32=get32(outa,8);
  let xpred:i32=get32(outa,12);
  let ddr:i32=get32(outa,16);
  let rm0:i32=get32(outa,20);
  let rm1:i32=get32(outa,24);
  let rm2:i32=get32(outa,28);
  let pred_p:i32=get32(outa,36);
  let pred_q:i32=get32(outa,40);
  let pred_d:i32=get32(outa,44);
  let tb_t:i32=get32(outa,48);
  let dkind:i32=get32(outa,64);
  let sds:i32=get32(outa,68);
  let ncand:i32=get32(outa,72);
  e2(ob,atp,"PHASE2 adapt: probe1=",(probe1)," probe2=",(probe2));
  e2(ob,atp,"PHASE2 adapt: measured_total=",(measured)," xpred_total=",(xpred));
  e2(ob,atp,"PHASE2 adapt: d_delta_r=",(ddr)," tbreak_t=",(tb_t));
  e2(ob,atp,"PHASE2 adapt: rolemap a->=",(rm0)," b->=",(rm1));
  e1(ob,atp,"PHASE2 adapt: rolemap c->=",(rm2));
  e2(ob,atp,"PHASE2 adapt: d_kind=",(dkind)," s_downstream_of_leaf=",(sds));
  e1(ob,atp,"PHASE2 adapt: derived_ncand=",(ncand));
  e2(ob,atp,"PHASE2 adapt: pred p=",(pred_p)," q=",(pred_q));
  e1(ob,atp,"PHASE2 adapt: pred d=",(pred_d));
  e1(ob,atp,"PHASE2 adapt: outcome r=",(adapt_out));

  // harness-verified optimum over {p,q,d} at value 10
  let opt:i32=w_t_eval(0,10);
  let e1v:i32=w_t_eval(1,10);
  let e3v:i32=w_t_eval(3,10);
  if(e1v>opt){opt=e1v;}
  if(e3v>opt){opt=e3v;}
  e2(ob,atp,"TRUTH: p->r=",(w_t_eval(0,10))," q->r=",(e1v));
  e2(ob,atp,"TRUTH: d->r=",(e3v)," optimal=",(opt));

  // ============ L_copy ============
  let outc:[]u8=z_alloc(16);
  let copy_pick:i32=l_copy(outc);
  let inappl:i32=get32(outc,0);
  let copy_out:i32=3;
  if(inappl!=1){
    copy_out=w_t_eval(copy_pick,10);
  }
  e2(ob,atp,"COPY: inapplicable=",(inappl)," outcome r=",(copy_out));
  // K2
  let k2:i32=1;
  if(inappl!=1){k2=0;}
  if(copy_out!=3){k2=0;}
  if(copy_out>=opt){k2=0;}

  // K3
  let k3:i32=1;
  if(rm0!=0){k3=0;}
  if(rm1!=1){k3=0;}
  if(rm2!=2){k3=0;}
  if(dkind!=0){k3=0;}
  if(sds!=1){k3=0;}
  if(probe1!=0){k3=0;}
  if(measured!=3){k3=0;}
  if(xpred!=3){k3=0;}
  if(probe2!=3){k3=0;}
  if(ddr!=0){k3=0;}
  if(tb_t!=1){k3=0;}
  if(adapt_out!=30){k3=0;}
  if(adapt_out!=opt){k3=0;}
  if(pred_p!=30){k3=0;}
  if(pred_q!=11){k3=0;}
  if(pred_d!=3){k3=0;}

  // ============ L_scratch over all 6 presentation orders ============
  let ords:[]u8=z_alloc(24);
  ords[0]=0; ords[1]=1; ords[2]=3;
  ords[3]=0; ords[4]=3; ords[5]=1;
  ords[6]=1; ords[7]=0; ords[8]=3;
  ords[9]=1; ords[10]=3; ords[11]=0;
  ords[12]=3; ords[13]=0; ords[14]=1;
  ords[15]=3; ords[16]=1; ords[17]=0;
  let sout:[]u8=z_alloc(96);
  let ssum:i32=0;
  let smin:i32=1000000;
  let so:[]u8=z_alloc(8);
  let j:i32=0;
  while(j<6){
    let ord:[]u8=z_alloc(8);
    ord[0]=ords[j*3]; ord[1]=ords[j*3+1]; ord[2]=ords[j*3+2];
    let spick:i32=l_adapt(0,ord,xek,xekk,xep1,xep2,xenp,tobs,sout);
    let o:i32=w_t_eval(spick,10);
    so[j]=o as u8;
    ssum=ssum+o;
    if(o<smin){smin=o;}
    j=j+1;
  }
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"SCRATCH outcomes per order: ");
  j=0;
  while(j<6){
    at=ob_i32(ob,at,so[j] as i32);
    at=ob_app(ob,at," ");
    j=j+1;
  }
  at=ob_nl(ob,at);
  set32(atp,0,at);
  e2(ob,atp,"SCRATCH: sum=",(ssum)," min=",(smin));
  e1(ob,atp,"SCRATCH: adapt_mean_num_x6=",(adapt_out*6));

  // K4
  let k4:i32=1;
  if(adapt_out*6<=ssum){k4=0;}
  if(adapt_out<=copy_out){k4=0;}
  if(adapt_out<=smin){k4=0;}
  if(ssum!=142){k4=0;}
  if(smin!=11){k4=0;}

  // K5: budget audit (in-binary) + manual code audit (REPORT)
  let k5:i32=1;
  let adapt_probes:i32=get32(outa,60);
  let adapt_obs:i32=4;
  let scratch_probes:i32=2;
  let scratch_obs:i32=4;
  if(adapt_probes!=2){k5=0;}
  if(scratch_probes!=2){k5=0;}
  if(adapt_obs!=scratch_obs){k5=0;}
  if(ncand!=3){k5=0;}
  e2(ob,atp,"BUDGET: adapt_obs=",(adapt_obs)," adapt_probes=",(adapt_probes));
  e2(ob,atp,"BUDGET: scratch_obs=",(scratch_obs)," scratch_probes=",(scratch_probes));

  // K7: lesion is exactly has_x=0 (same code path); gap attribution
  let k7:i32=1;
  if(ssum>=adapt_out*6){k7=0;}
  if(smin>=adapt_out){k7=0;}
  if((get32(sout,56) as i32)!=0){k7=0;}
  if((get32(outa,56) as i32)!=1){k7=0;}

  // ============ KILL BARS ============
  e0(ob,atp,"=== KILL BARS ===");
  d_bar("K-1 X-LEARNED-INDEPENDENTLY",k1,ob,atp);
  d_bar("K-2 COPY-FAILS",k2,ob,atp);
  d_bar("K-3 ADAPTATION-WORKS",k3,ob,atp);
  d_bar("K-4 ADAPTED-OUTPERFORMS",k4,ob,atp);
  d_bar("K-5 NO-PAIR-TEMPLATE",k5,ob,atp);
  d_bar("K-7 ABLATION-OF-X",k7,ob,atp);
  e0(ob,atp,"K-6 DETERMINISTIC-3x3 see-shell");
  at=get32(atp,0);
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"XCA-END\n");
  set32(atp,0,at);

  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

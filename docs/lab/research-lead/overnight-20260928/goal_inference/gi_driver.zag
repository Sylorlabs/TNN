// ---- instrumentation (verbatim from lvcomp_driver.zag) ----
fn cmp_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cmp_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cmp_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn cmp_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn lvc_factscore(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return ng(W,n,8);}
    n=n+1;
  }
  return -999999;
}
fn lvc_count14out(W:[]u8,m:i32)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}

// ---- T1 world (verbatim from lvcomp_driver.zag) ----
fn t1_train(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  emit("T1-X ans="); e64(x); cmp_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("T1-Y ans="); e64(y); cmp_tstat(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let w:i32=ev_query(W,31,73,33,0);
  emit("T1-W ans="); e64(w); cmp_tstat(W);
  emit("T1 maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t1_couse(W:[]u8)void {
  ev_teach(W,41,1,42); ev_teach(W,42,1,43);
  ev_teach(W,43,2,44); ev_teach(W,44,2,45);
  let a1:i32=ev_cq(W,41,71,43,0,0);
  let a2:i32=ev_cq(W,43,72,45,0,1);
  emit("T1-EPXY a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  ev_teach(W,51,2,52); ev_teach(W,52,2,53);
  ev_teach(W,53,3,54); ev_teach(W,54,3,55);
  let b1:i32=ev_cq(W,51,72,53,0,0);
  let b2:i32=ev_cq(W,53,73,55,0,1);
  emit("T1-EPYW b1="); e64(b1); emit(" b2="); e64(b2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  return;
}
fn t1_world(W:[]u8)void {
  t1_train(W);
  t1_couse(W);
  cmp_gap(W);
  t1_zfacts(W);
  return;
}

// ---- learner evidence helper (parametrized cycles) ----
// N predict/observe cycles for (s,r) with true world outcome o.
// After N cycles the evidence FACT pred_score = N-1.
fn lv2_evidence(W:[]u8,s:i32,r:i32,o:i32,cycles:i32)void {
  let c:i32=0;
  while(c<cycles){
    let p:i32=lv_predict(W,s,r);
    emit("LV2-EV c="); e64(c); emit(" pred="); e64(p); emit("\n");
    let ob:i32=lv_observe(W,s,r,o);
    c=c+1;
  }
  emit("LV2-EV factscore="); e64(lvc_factscore(W,s,r)); emit("\n");
  return;
}


// ---- gi_confirm: earn a taught FACT its own score (no new FACT written) ----
// N rounds of lv_predict + lv_pred_resolve with world outcome o.
// Unlike lv_observe, this never calls ev_teach_in: the FACT taught
// beforehand earns score purely by predicting correctly.
fn gi_confirm(W:[]u8,s:i32,r:i32,o:i32,cycles:i32)void {
  let c:i32=0;
  while(c<cycles){
    let p:i32=lv_predict(W,s,r);
    emit("GI-CFM c="); e64(c); emit(" pred="); e64(p); emit("\n");
    lv_pred_resolve(W,s,r,o);
    c=c+1;
  }
  emit("GI-CFM factscore="); e64(lvc_factscore(W,s,r)); emit("\n");
  return;
}

// ---- cost of a CONSTRUCT route: probe execs + tried + rejected ----
fn gi_cost_construct(st:[]u8)i32 {
  return get32(st,8)+get32(st,0)+get32(st,4);
}

// ---- T-RTRV (task arm a): known FACT, no structure -> RETRIEVE ----
// Bare world (no MAPs at all): the taught FACT is the only knowledge.
// Expect route=0, ans=42, cost=1, no promotion, no probe execs.
fn trtrv_test()i32 {
  emit("=== TRTRV ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach_in(W,201,80,42);
  gi_confirm(W,201,80,42,5);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16);
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  let z:i32=ev_iquery(W,201,80,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  emit("TRTRV route="); e64(route); emit(" ans="); e64(z);
  emit(" maps "); e64(m0); emit("->"); e64(m1);
  emit(" probeexecs="); e64(get32(st,8)); emit("\n");
  emit("TRTRV-COST=1\n");
  if(route==0 && z==42 && m1==m0 && get32(st,8)==0){
    emit("TRTRV-RESULT=PASS\n"); return 1;
  }
  emit("TRTRV-RESULT=FAIL\n"); return 0;
}

// ---- T-COMP (task arm b): FACT + agreeing structure -> CONSTRUCT ----
// T1 world, evidence FACT (107, score 4); probe walks 101->103->105->107.
// Expect route=1, ans=107 via genuine composition (tried>=1, +1 MAP,
// LINK14=3), not recall.
fn tcomp_test()i32 {
  emit("=== TCOMP ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lv2_evidence(W,101,70,107,5);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16);
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  let z:i32=ev_iquery(W,101,70,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  let zm:i32=cb_newest_map(W);
  let l14:i32=-1;
  if(zm>=0){ l14=lvc_count14out(W,zm); }
  let cost:i32=gi_cost_construct(st);
  emit("TCOMP route="); e64(route); emit(" ans="); e64(z);
  emit(" tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4));
  emit(" probeexecs="); e64(get32(st,8));
  emit(" maps "); e64(m0); emit("->"); e64(m1);
  emit(" link14="); e64(l14); emit(" cost="); e64(cost); emit("\n");
  emit("TCOMP-COST="); e64(cost); emit("\n");
  if(route==1 && z==107 && get32(st,0)>=1 && m1==m0+1 && l14==3){
    emit("TCOMP-RESULT=PASS\n"); return 1;
  }
  emit("TCOMP-RESULT=FAIL\n"); return 0;
}

// ---- T-STALE (task arm c, adversarial): confident WRONG FACT vs structure ----
// T1 world; stale FACT (999, score 7, earned by 7 confirm cycles) while
// X/Y/W MAPs walk 101->103->105->107. Expect route=2 CONSTRUCT-CONFLICT,
// ans=107, the stale FACT superseded, tried>=1, +1 MAP.
fn tstale_test()i32 {
  emit("=== TSTALE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  let fs:i32=ev_teach_in(W,101,70,999);
  gi_confirm(W,101,70,999,7);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16);
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  let z:i32=ev_iquery(W,101,70,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  let sup:i32=is_superseded(W,fs);
  let cost:i32=gi_cost_construct(st);
  emit("TSTALE route="); e64(route); emit(" ans="); e64(z);
  emit(" superseded="); e64(sup);
  emit(" tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4));
  emit(" probeexecs="); e64(get32(st,8));
  emit(" maps "); e64(m0); emit("->"); e64(m1);
  emit(" cost="); e64(cost); emit("\n");
  emit("TSTALE-COST="); e64(cost); emit("\n");
  if(route==2 && z==107 && sup==1 && get32(st,0)>=1 && m1==m0+1){
    emit("TSTALE-RESULT=PASS\n"); return 1;
  }
  emit("TSTALE-RESULT=FAIL\n"); return 0;
}

// ---- T-UNC (uncertainty arm): weak FACT -> CONSTRUCT route, honest withhold ----
// T1 world; 2 evidence cycles give FACT (107, score 1 < 3).
// Expect route=1, ans=-3, tried=0, MAPs unchanged.
fn tunc_test()i32 {
  emit("=== TUNC ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lv2_evidence(W,101,70,107,2);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16);
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  let z:i32=ev_iquery(W,101,70,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  let cost:i32=gi_cost_construct(st);
  emit("TUNC route="); e64(route); emit(" ans="); e64(z);
  emit(" tried="); e64(get32(st,0));
  emit(" maps "); e64(m0); emit("->"); e64(m1);
  emit(" cost="); e64(cost); emit("\n");
  emit("TUNC-COST="); e64(cost); emit("\n");
  if(route==1 && z==-3 && get32(st,0)==0 && m1==m0){
    emit("TUNC-RESULT=PASS\n"); return 1;
  }
  emit("TUNC-RESULT=FAIL\n"); return 0;
}

// ---- T-NE (no-basis arm): nothing known -> WITHHOLD ----
fn tne_test()i32 {
  emit("=== TNE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(16);
  set32(st,0,0); set32(st,4,0); set32(st,8,0); set32(st,12,-1);
  let z:i32=ev_iquery(W,101,70,0,st);
  let route:i32=get32(st,12);
  let m1:i32=cmp_count_maps(W);
  emit("TNE route="); e64(route); emit(" ans="); e64(z);
  emit(" maps "); e64(m0); emit("->"); e64(m1); emit("\n");
  emit("TNE-COST=0\n");
  if(route==3 && z==-3 && m1==m0){
    emit("TNE-RESULT=PASS\n"); return 1;
  }
  emit("TNE-RESULT=FAIL\n"); return 0;
}

fn main()i32 {
  emit("GI-START\n");
  let r1:i32=trtrv_test();
  let r2:i32=tcomp_test();
  let r3:i32=tstale_test();
  let r4:i32=tunc_test();
  let r5:i32=tne_test();
  emit("GI-SUMMARY ");
  e64(r1); emit(" "); e64(r2); emit(" "); e64(r3); emit(" "); e64(r4); emit(" "); e64(r5);
  emit("\n");
  emit("GI-END\n");
  return 0;
}

// gi_patch.zag -- H-GOALINF-1 goal-type inference (unfrozen).
//
// The learner infers the query goal type (RETRIEVE vs CONSTRUCT) from its
// own state, with no researcher goal flag in the query path.
//
// Inference rule (ev_iquery):
//   1. lv_setup gives the learner prediction p and reliability rel.
//      No basis -> WITHHOLD (-3).
//   2. gi_factscan finds the best live non-superseded FACT for (s,r).
//      Weak FACT (score < 3) -> CONSTRUCT via ev_cquery (which withholds
//      internally when unreliable; uncertainty is never a gamble).
//   3. Confident FACT -> gi_probe, a target-free greedy structural walk
//      from s over learned MAPs (read-only, no promotion).
//      No walkable chain -> RETRIEVE via ev_query (fast recall).
//      Chain walks to the FACT value -> CONSTRUCT via ev_cquery
//        (re-derive and verify the answer by construction).
//      Chain walks to a DIFFERENT value -> CONFLICT: retire the
//        contradicted FACT with the native supersession primitive,
//        then CONSTRUCT via gi_compose with the structural prediction.
//        Rationale (preregistered): a constructed answer is
//        independently re-verified by execution while a FACT is opaque
//        recall, so the verifiable channel wins the tie.
//
// Researcher scaffold (honest): threshold value 3 (reused), structural
// reliability = walked-segment count (scaffold mapping), the -999999
// sentinel on the RETRIEVE call (inert on the activate path), the
// conflict tiebreak rationale above.
// Learner-owned: all pred_scores, all walk outcomes, every routing
// decision, the demotion event.
// Zero modes, bridges, handlers, semantic cases. No researcher target
// parameter anywhere in this file.

// ---- gi_factscan: best live non-superseded FACT for (s,r) ----
// Mirrors lv_predict's FACT scan ordering (pred_score, then bid).
// out[0]=node (-1 if none), out[1]=score, out[2]=value.
fn gi_factscan(W:[]u8,s:i32,r:i32,out:[]u8)void {
  let best:i32=-1; let bs:i32=-999999; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let sc:i32=ng(W,n,8);
        let b:i32=bid(W,n);
        if(sc>bs || (sc==bs && b>bb)){ bs=sc; bb=b; best=n; }
      }
    }
    n=n+1;
  }
  set32(out,0,best);
  if(best>=0){ set32(out,4,bs); set32(out,8,ng(W,best,28)); }
  else { set32(out,4,-999999); set32(out,8,-999999); }
  return;
}

// ---- gi_probe: target-free greedy structural walk from s ----
// Uses un_candidates/un_satisfy (same admission as lv_dfs), max 8
// segments, no MAP reuse. Read-only: no promotion, no state writes.
// out[0]=walked end value (-999999 if no chain), out[1]=nseg,
// out[2]=MAP executions performed.
fn gi_probe(W:[]u8,s:i32,out:[]u8)void {
  let used:[]u8=z_alloc(64);
  let nused:i32=0;
  let cur:i32=s;
  let nseg:i32=0;
  let execs:i32=0;
  let go:i32=1;
  while(go==1 && nseg<8){
    let cand:[]u8=z_alloc(1024);
    let clen:[]u8=z_alloc(1024);
    let ccouse:[]u8=z_alloc(1024);
    let nc:i32=un_candidates(W,cur,used,nused,cand,clen,ccouse,0);
    let i:i32=0;
    let adv:i32=0;
    while(i<nc && adv==0){
      let m:i32=get32(cand,i*4);
      let vbuf:[]u8=z_alloc(32);
      let fbuf:[]u8=z_alloc(28);
      let ln:i32=un_satisfy(W,m,cur,vbuf,fbuf);
      if(ln>=1){
        set32(used,nused*4,m); nused=nused+1;
        cur=get32(vbuf,ln*4);
        nseg=nseg+1; execs=execs+1; adv=1;
      }
      i=i+1;
    }
    if(adv==0){go=0;}
  }
  if(nseg==0){ set32(out,0,-999999); } else { set32(out,0,cur); }
  set32(out,4,nseg); set32(out,8,execs);
  return;
}

// ---- gi_supersede: retire a FACT with the native primitive ----
// Same type-3 self-edge that lv_observe writes on contradiction.
fn gi_supersede(W:[]u8,n:i32)void {
  link_edge(W,n,3,n,0);
  return;
}

// ---- gi_compose: compose_lv's body with supplied (pred, rel) ----
// Adapted from compose_lv (H-COMPVER-2): the lv_setup prediction source
// is replaced by caller-supplied pred/rel. The reliability gate is
// unchanged. Used by the conflict arm, where the structural prediction
// comes from gi_probe instead of lv_setup.
fn gi_compose(W:[]u8,s:i32,r:i32,pred:i32,rel:i32,masked:i32,st:[]u8)i32 {
  if(rel<lv_rel_thresh()){
    emit("LV-WITHHOLD unreliable rel="); e64(rel); emit("\n");
    return -3;
  }
  hs(W,32,pred); hs(W,36,rel);
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224);
  let olen:[]u8=z_alloc(32);
  let nseg:i32=lv_dfs(W,s,pred,oseg,ovals,ofids,olen);
  if(nseg<1){
    emit("LV-COMP-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(32);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=lv_verify_chain(W,full,s,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(288);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*4),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      let w1:i32=cb_couse_link(W,get32(oseg,g*4),get32(oseg,(g-1)*4));
      g=g+1;
    }
  }
  emit("LV-COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*4)); g=g+1;}
  emit("\n");
  return v2;
}

// ---- ev_iquery: the goal-type inference entry point ----
// Route codes (st[12]): 0=RETRIEVE, 1=CONSTRUCT, 2=CONSTRUCT-CONFLICT,
// 3=WITHHOLD. st[8] accumulates probe MAP-execs. Takes no goal flag and
// no researcher target.
fn ev_iquery(W:[]u8,s:i32,r:i32,masked:i32,st:[]u8)i32 {
  let p:i32=lv_setup(W,s,r);
  if(p==-999999){
    set32(st,12,3);
    emit("GI-ROUTE 3 WITHHOLD nobasis\n");
    return -3;
  }
  let fs:[]u8=z_alloc(12);
  gi_factscan(W,s,r,fs);
  let fnode:i32=get32(fs,0); let fsc:i32=get32(fs,4); let fv:i32=get32(fs,8);
  if(fnode<0 || fsc<lv_rel_thresh()){
    set32(st,12,1);
    emit("GI-ROUTE 1 CONSTRUCT weakfact\n");
    let a:i32=ev_cquery(W,s,r,masked,st);
    emit("GI-ANS "); e64(a); emit("\n");
    return a;
  }
  let pr:[]u8=z_alloc(12);
  gi_probe(W,s,pr);
  let sp:i32=get32(pr,0); let nseg:i32=get32(pr,4); let pexec:i32=get32(pr,8);
  set32(st,8,get32(st,8)+pexec);
  if(nseg==0){
    set32(st,12,0);
    emit("GI-ROUTE 0 RETRIEVE noprobe\n");
    let a2:i32=ev_query(W,s,r,-999999,masked);
    emit("GI-ANS "); e64(a2); emit("\n");
    return a2;
  }
  if(sp==fv){
    set32(st,12,1);
    emit("GI-ROUTE 1 CONSTRUCT agree\n");
    let a3:i32=ev_cquery(W,s,r,masked,st);
    emit("GI-ANS "); e64(a3); emit("\n");
    return a3;
  }
  gi_supersede(W,fnode);
  set32(st,12,2);
  emit("GI-ROUTE 2 CONFLICT demote="); e64(fnode); emit("\n");
  let a4:i32=gi_compose(W,s,r,sp,nseg,masked,st);
  emit("GI-ANS "); e64(a4); emit("\n");
  return a4;
}

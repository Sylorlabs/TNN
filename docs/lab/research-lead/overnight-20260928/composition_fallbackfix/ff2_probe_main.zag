// ff2_probe_main.zag -- branch admission probe on the REPAIRED mechanism.
// Trains the R4B 2-wide world, auto-marks like compose_try, then reports
// admitted candidate count and kind breakdown at node 9001.
fn ff_probe_branch(W:[]u8,cur:i32)void {
  let am:i32=2;
  while(am<1024){
    if(ng(W,am,36)==1 && ng(W,am,0)==20){
      let al:i32=cl_chain_len(W,am);
      if(al>=1){cl_mark(W,am,0,al);}
    }
    am=am+1;
  }
  let cm:[]u8=z_alloc(1024); let csb:[]u8=z_alloc(1024);
  let clb:[]u8=z_alloc(1024); let cob:[]u8=z_alloc(1024); let ckb:[]u8=z_alloc(1024);
  let used:[]u8=z_alloc(96);
  let n:i32=cl_candidates(W,cur,used,0,cm,csb,clb,cob,ckb,0);
  emit("PROBE-BRANCH-AT="); e64(cur); emit(" n="); e64(n); emit("\n");
  let i:i32=0; let k1:i32=0; let k2:i32=0;
  while(i<n){
    let kd:i32=get32(ckb,i*4);
    if(kd==1){k1=k1+1;}
    if(kd==2){k2=k2+1;}
    i=i+1;
  }
  emit("PROBE-KIND1="); e64(k1); emit(" KIND2="); e64(k2); emit("\n");
  return;
}
fn ff_probe_train(W:[]u8)void {
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,9000+g*100+a,300+g*4+(a-1)*2+(b-1),9000+(g+1)*100+b);
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        let q:i32=ev_query(W,9000+g*100+a,800+idx,9000+(g+1)*100+b,0);
        if(q!=9000+(g+1)*100+b){emit("PROBE-TRAIN-FAIL idx="); e64(idx); emit("\n");}
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("PROBE-TRAINED n="); e64(idx); emit("\n");
  return;
}
fn main()i32 {
  emit("FF-PROBE-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ff_probe_train(W);
  ff_probe_branch(W,9001);
  emit("FF-PROBE-END\n");
  return 0;
}

fn main()i32 {
  emit("CAP-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // count live nodes
  let n0:i32=0; let m:i32=2;
  while(m<1024){ if(ng(W,m,36)==1){n0=n0+1;} m=m+1; }
  emit("CAP-INIT-NODES="); e64(n0); emit("\n");
  ev_teach(W,60000,301,60001);
  let a:i32=t2_trial(W,60000,801,60001,0,0,0);
  emit("CAP-TRAIN ans="); e64(a); emit("\n");
  let n1:i32=0; m=2;
  while(m<1024){ if(ng(W,m,36)==1){n1=n1+1;} m=m+1; }
  emit("CAP-AFTER-NODES="); e64(n1); emit(" DELTA="); e64(n1-n0); emit("\n");
  emit("CAP-END\n");
  return 0;
}

fn main()i32 {
  emit("FFV-PROBE-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("=== PROBE-R4B-TRAIN ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        ev_teach(W,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        ffv_teach_on_fact(W,idx,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("PROBE-TRAINING-DONE idx="); e64(idx); emit("\n");
  ffv_branch_probe(W,9001);
  emit("FFV-PROBE-END\n");
  return 0;
}

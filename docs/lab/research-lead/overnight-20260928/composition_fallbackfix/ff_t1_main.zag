fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,300,9101);
  emit("FACT-TAUGHT\n");
  let q:i32=ev_query(W,9001,800,9101,0);
  emit("Q ans="); e64(q); emit("\n");
  // check if MAP was created
  let m:i32=2; let found:i32=0;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==9001 && ng(W,m,4)==800){found=m;}
    m=m+1;
  }
  emit("MAP-FOUND="); e64(found); emit("\n");
  return 0;
}

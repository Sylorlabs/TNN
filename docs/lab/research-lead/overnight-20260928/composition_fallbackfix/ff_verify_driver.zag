// ff_verify_driver.zag -- Kill verification driver for the UNFIXED collapsed
// mechanism C234 (base + ff_cl_patch_orig.zag + this driver).
// Confirms the unified red-team kills (R7, R4b, R4c) transfer to C234.
// V-R7 ports r7_world/r7_test verbatim (ev_query training).
// V-R4B/V-R4C port r4b_test/r4c_test; MAPs taught via direct t2_trial
// (AGENTS.md worker driver lesson: avoids ev_query workspace stall).

// ---- instrumentation (ffv_ prefixed) ----
fn ffv_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn ffv_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn ffv_dump15(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      emit("  T15 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8));
      emit(" aux="); e64(eg(W,e,12)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ffv_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  T14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ffv_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn ffv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// ---- V-R7: predicate conflict (verbatim port of r7_world/r7_test) ----
fn ffv_r7_world(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let mq:i32=ev_query(W,11,71,13,0);
  emit("V-R7-M ans="); e64(mq); emit("\n");
  ev_teach(W,21,7,22); ev_teach(W,22,7,23);
  let nq:i32=ev_query(W,21,72,23,0);
  emit("V-R7-N ans="); e64(nq); emit("\n");
  ev_teach(W,31,8,32); ev_teach(W,32,8,33);
  let pq:i32=ev_query(W,31,73,33,0);
  emit("V-R7-P ans="); e64(pq); emit("\n");
  let mm:i32=ffv_find_map(W,11,71);
  let nn:i32=ffv_find_map(W,21,72);
  let pp:i32=ffv_find_map(W,31,73);
  emit("V-R7-IDS M="); e64(mm); emit(" N="); e64(nn); emit(" P="); e64(pp); emit("\n");
  ffv_gap(W);
  ev_teach(W,101,7,102); ev_teach(W,102,7,103);
  ev_teach(W,103,8,104); ev_teach(W,104,8,105);
  return;
}
fn ffv_r7_test(W:[]u8)void {
  emit("=== V-R7-CONFLICT ===\n");
  ffv_r7_world(W);
  emit("V-R7-T15-BEFORE="); e64(ffv_count15(W)); emit("\n");
  let z:i32=ev_query(W,101,70,105,0);
  emit("V-R7-Z ans="); e64(z); ffv_tstat(W);
  emit("V-R7-T15-AFTER="); e64(ffv_count15(W)); emit("\n");
  ffv_dump14(W);
  ffv_dump15(W);
  return;
}

// ---- layered graph helpers (2-wide; amendment 1) ----
fn ffv_lnode(g:i32,a:i32)i32 { return 9000+g*100+a; }
fn ffv_lrel(g:i32,a:i32,b:i32)i32 { return 300+g*4+(a-1)*2+(b-1); }
// Teach one single-link MAP directly on a layered-graph fact
// (s,r,o). Saves 63 training-fact nodes vs private facts (capacity).
// t2_trial tries k=2..4 chains first, but no plen>=3 path from s can
// verify against o (all end deeper), so the 1-link t2_chain branch
// promotes the correct MAP.
fn ffv_teach_on_fact(W:[]u8,idx:i32,s:i32,r:i32,o:i32)i32 {
  let a:i32=t2_trial(W,s,800+idx,o,0,0,0);
  if(a!=o){emit("FFV-TRAIN-FAIL idx="); e64(idx); emit(" ans="); e64(a); emit("\n");}
  return a;
}
// Branching probe: auto-mark like compose_try, then count candidates
// admitted at node cur on the UNFIXED mechanism (measures fallback
// inflation directly).
fn ffv_branch_probe(W:[]u8,cur:i32)void {
  let am:i32=2;
  while(am<1024){
    if(ng(W,am,36)==1 && ng(W,am,0)==20){
      let al:i32=cl_chain_len(W,am);
      if(al>=1){cl_mark(W,am,0,al);}
    }
    am=am+1;
  }
  let cm:[]u8=z_alloc(1024); let csb:[]u8=z_alloc(1024);
  let clb:[]u8=z_alloc(1024); let cob:[]u8=z_alloc(1024);
  let used:[]u8=z_alloc(96);
  let n:i32=cl_candidates(W,cur,used,0,cm,csb,clb,cob,0);
  emit("FFV-BRANCH-AT="); e64(cur); emit(" n="); e64(n); emit("\n");
  return;
}

// ---- V-R4B: decline blowup (port of r4b_test) ----
fn ffv_r4b_test(W:[]u8)void {
  emit("=== V-R4B-DECLINE-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ffv_teach_on_fact(W,idx,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("V-R4B facts+maps="); e64(idx); emit(" TRAINING-DONE\n");
  ffv_branch_probe(W,9001);
  emit("V-R4B-Z-START\n");
  let z:i32=ev_query(W,9001,70,99999,0);
  emit("V-R4B-Z ans="); e64(z); ffv_tstat(W);
  if(z==-2){emit("V-R4B-RESULT=PASS-DECLINE\n");} else {emit("V-R4B-RESULT=FAIL\n");}
  return;
}

// ---- V-R4C: success blowup (port of r4c_test) ----
fn ffv_r4c_test(W:[]u8)void {
  emit("=== V-R4C-SUCCESS-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  ev_teach(W,9601,400,9008);
  // train off-path MAPs first, correct-path MAPs last (highest ids)
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        if(a!=1 || b!=1){
          ffv_teach_on_fact(W,idx,ffv_lnode(g,a),ffv_lrel(g,a,b),ffv_lnode(g+1,b));
        }
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  g=0;
  while(g<7){
    ffv_teach_on_fact(W,idx,ffv_lnode(g,1),ffv_lrel(g,1,1),ffv_lnode(g+1,1));
    idx=idx+1;
    g=g+1;
  }
  ffv_teach_on_fact(W,idx,9601,400,9008);
  emit("V-R4C facts+maps trained TRAINING-DONE\n");
  emit("V-R4C-Z-START\n");
  let z:i32=ev_query(W,9001,70,9008,0);
  emit("V-R4C-Z ans="); e64(z); ffv_tstat(W);
  if(z==9008){emit("V-R4C-RESULT=PASS\n");} else {emit("V-R4C-RESULT=FAIL\n");}
  return;
}

fn main()i32 {
  emit("FFV-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); ffv_r7_test(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); ffv_r4b_test(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); ffv_r4c_test(W3);
  emit("FFV-END\n");
  return 0;
}

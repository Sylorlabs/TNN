// ff_driver.zag -- Test driver for the REPAIRED collapsed composition
// mechanism (H-FALLBACKFIX-1). Each test runs in a fresh workspace.
//   R7: predicate conflict (expect [N,P], no false LINK14/type-15)
//   R4B: 2-wide decline blowup (expect terminate, ans=-2)
//   R4C: 2-wide success blowup (expect terminate, ans=9008)
//   R6A-DEDUP: type-15 dedup (expect zero duplicate triples)
//   R3: A Suite-A necessity (expect ans=306, no capability regression)
// C234 battery (T1..T4B) runs via cl_driver.zag in a separate binary.

// ---- instrumentation (ff_ prefixed) ----
fn ff_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn ff_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn ff_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn ff_dump15(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      emit("  T15 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8));
      emit(" aux="); e64(eg(W,e,12)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ff_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  T14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ff_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn ff_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// Count duplicate type-15 (from,to,aux) triples. Returns duplicate count.
fn ff_dup15(W:[]u8)i32 {
  let dup:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      let f:i32=0;
      while(f<e){
        if(eg(W,f,0)!=-1 && eg(W,f,4)==15 && eg(W,f,0)==eg(W,e,0) && eg(W,f,8)==eg(W,e,8) && eg(W,f,12)==eg(W,e,12)){dup=dup+1;}
        f=f+1;
      }
    }
    e=e+1;
  }
  return dup;
}

// ---- R7: predicate conflict (repaired mechanism) ----
// M: [1,1] plen-3 (11->13). N: [7,7] plen-3 (21->23). P: [8,8] plen-3 (31->33).
// Z: 101->102->103 (r7), 103->104->105 (r8). Expect [N,P].
fn ff_r7_world(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let mq:i32=ev_query(W,11,71,13,0);
  emit("R7-M ans="); e64(mq); emit("\n");
  ev_teach(W,21,7,22); ev_teach(W,22,7,23);
  let nq:i32=ev_query(W,21,72,23,0);
  emit("R7-N ans="); e64(nq); emit("\n");
  ev_teach(W,31,8,32); ev_teach(W,32,8,33);
  let pq:i32=ev_query(W,31,73,33,0);
  emit("R7-P ans="); e64(pq); emit("\n");
  let mm:i32=ff_find_map(W,11,71);
  let nn:i32=ff_find_map(W,21,72);
  let pp:i32=ff_find_map(W,31,73);
  emit("R7-IDS M="); e64(mm); emit(" N="); e64(nn); emit(" P="); e64(pp); emit("\n");
  ff_gap(W);
  ev_teach(W,101,7,102); ev_teach(W,102,7,103);
  ev_teach(W,103,8,104); ev_teach(W,104,8,105);
  return;
}
fn ff_r7_test(W:[]u8)void {
  emit("=== R7-CONFLICT ===\n");
  ff_r7_world(W);
  let mm:i32=ff_find_map(W,11,71);
  let nn:i32=ff_find_map(W,21,72);
  let pp:i32=ff_find_map(W,31,73);
  emit("R7-T15-BEFORE="); e64(ff_count15(W)); emit("\n");
  let z:i32=ev_query(W,101,70,105,0);
  emit("R7-Z ans="); e64(z); ff_tstat(W);
  emit("R7-T15-AFTER="); e64(ff_count15(W)); emit("\n");
  ff_dump14(W);
  ff_dump15(W);
  // verdict checks
  let okseg:i32=0;
  // (segment check done by inspecting COMP-SEGS line; here check provenance)
  let e:i32=0; let false14:i32=0; let false15:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      // LINK14 from a MAP_Z (id > pp) to M is false provenance
      if(eg(W,e,0)>pp && eg(W,e,8)==mm){false14=1;}
    }
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15 && eg(W,e,12)==0){
      // co-use N -> M is false history
      if(eg(W,e,0)==nn && eg(W,e,8)==mm){false15=1;}
    }
    e=e+1;
  }
  let dup:i32=ff_dup15(W);
  emit("R7-FALSE14="); e64(false14); emit(" R7-FALSE15="); e64(false15);
  emit(" R7-DUP15="); e64(dup); emit("\n");
  if(z==105 && false14==0 && false15==0 && dup==0){emit("R7-RESULT=PASS\n");}
  else {emit("R7-RESULT=FAIL\n");}
  return;
}

// ---- layered graph helpers (2-wide; amendment 1) ----
fn ff_lnode(g:i32,a:i32)i32 { return 9000+g*100+a; }
fn ff_lrel(g:i32,a:i32,b:i32)i32 { return 300+g*4+(a-1)*2+(b-1); }
// Direct 1-link MAP trainer via ev_query (the standard formation path;
// t2_trial alone is unreliable for 1-link in dense graphs per
// PREREG_AMENDMENT2). Fact must already be taught via ev_teach.
fn ff_train1(W:[]u8,idx:i32,s:i32,r:i32,o:i32)void {
  let q:i32=ev_query(W,s,800+idx,o,0);
  if(q!=o){emit("FF-TRAIN1-FAIL idx="); e64(idx); emit(" ans="); e64(q); emit("\n");}
  return;
}

// ---- R4B: decline blowup, 2-wide depth-8 layered graph ----
fn ff_r4b_test(W:[]u8)void {
  emit("=== R4B-DECLINE-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ff_train1(W,idx,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("R4B facts+maps="); e64(idx); emit(" TRAINING-DONE\n");
  emit("R4B-Z-START\n");
  let z:i32=ev_query(W,9001,70,99999,0);
  emit("R4B-Z ans="); e64(z); ff_tstat(W);
  if(z==-2){emit("R4B-RESULT=PASS-DECLINE\n");} else {emit("R4B-RESULT=FAIL\n");}
  return;
}

// ---- R4C: success blowup, 2-wide, correct path trained last ----
fn ff_r4c_test(W:[]u8)void {
  emit("=== R4C-SUCCESS-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  ev_teach(W,9601,400,9008);
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        if(a!=1 || b!=1){
          ff_train1(W,idx,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        }
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  g=0;
  while(g<7){
    ff_train1(W,idx,ff_lnode(g,1),ff_lrel(g,1,1),ff_lnode(g+1,1));
    idx=idx+1;
    g=g+1;
  }
  ff_train1(W,idx,9601,400,9008);
  emit("R4C facts+maps trained TRAINING-DONE\n");
  emit("R4C-Z-START\n");
  let z:i32=ev_query(W,9001,70,9008,0);
  emit("R4C-Z ans="); e64(z); ff_tstat(W);
  if(z==9008){emit("R4C-RESULT=PASS\n");} else {emit("R4C-RESULT=FAIL\n");}
  return;
}

// ---- R6A-DEDUP: type-15 dedup ----
fn ff_r6a_dedup_test(W:[]u8)void {
  emit("=== R6A-DEDUP ===\n");
  ev_teach(W,11,1,12);
  let a:i32=ev_query(W,11,71,12,0);
  emit("R6A-A1 ans="); e64(a); emit("\n");
  ev_teach(W,21,2,22);
  let b:i32=ev_query(W,21,72,22,0);
  emit("R6A-B1 ans="); e64(b); emit("\n");
  let ma:i32=ff_find_map(W,11,71);
  let mb:i32=ff_find_map(W,21,72);
  emit("R6A-IDS A1="); e64(ma); emit(" B1="); e64(mb); emit("\n");
  // direct double-write probe on cb_couse_link
  let w1:i32=cb_couse_link(W,mb,ma);
  let w2:i32=cb_couse_link(W,mb,ma);
  let w3:i32=cb_couse_link(W,mb,ma);
  emit("R6A-WRITE w1="); e64(w1); emit(" w2="); e64(w2); emit(" w3="); e64(w3); emit("\n");
  ff_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,2,103);
  let z:i32=ev_query(W,101,70,103,0);
  emit("R6A-Z ans="); e64(z); ff_tstat(W);
  let dup:i32=ff_dup15(W);
  emit("R6A-DUP15="); e64(dup); emit("\n");
  ff_dump15(W);
  if(z==103 && dup==0 && w1==1 && w2==0 && w3==0){emit("R6A-RESULT=PASS\n");}
  else {emit("R6A-RESULT=FAIL\n");}
  return;
}

// ---- R3: A Suite-A necessity (regression; port of r3_test) ----
fn ff_r3_test(W:[]u8)void {
  emit("=== R3-NECESSITY-A ===\n");
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  let x1:i32=ev_query(W,101,71,103,0);
  emit("R3-X1 ans="); e64(x1); ff_tstat(W);
  ev_teach(W,105,1,106); ev_teach(W,106,1,107);
  let x2:i32=ev_query(W,105,71,107,0);
  emit("R3-X2 ans="); e64(x2); ff_tstat(W);
  ev_teach(W,201,2,202); ev_teach(W,202,2,203); ev_teach(W,203,2,204);
  let y1:i32=ev_query(W,201,72,204,0);
  emit("R3-Y1 ans="); e64(y1); ff_tstat(W);
  ev_teach(W,205,2,206); ev_teach(W,206,2,207); ev_teach(W,207,2,208);
  let y2:i32=ev_query(W,205,72,208,0);
  emit("R3-Y2 ans="); e64(y2); ff_tstat(W);
  ff_gap(W);
  ev_teach(W,301,1,302); ev_teach(W,302,1,303);
  ev_teach(W,303,2,304); ev_teach(W,304,2,305); ev_teach(W,305,2,306);
  let z:i32=ev_query(W,301,70,306,0);
  emit("R3-ZA ans="); e64(z); ff_tstat(W);
  if(z==306){emit("R3-RESULT=PASS\n");} else {emit("R3-RESULT=FAIL\n");}
  return;
}

fn main()i32 {
  emit("FF-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); ff_r7_test(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); ff_r3_test(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); ff_r6a_dedup_test(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); ff_r4b_test(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); ff_r4c_test(W5);
  emit("FF-END\n");
  return 0;
}

fn ffdbg_countmaps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){ if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;} m=m+1; }
  return n;
}
fn main()i32 {
  emit("DBG-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let idx:i32=0;
  while(idx<70){
    let v0:i32=60000+idx*10; let v1:i32=v0+1;
    let r:i32=300+idx;
    ev_teach(W,v0,r,v1);
    let a:i32=t2_trial(W,v0,800+idx,v1,0,0,0);
    if(a!=v1){
      emit("DBG-FAIL idx="); e64(idx); emit(" ans="); e64(a);
      emit(" maps="); e64(ffdbg_countmaps(W)); emit("\n");
      idx=999;
    } else {
      if(idx%10==9){ emit("DBG-OK idx="); e64(idx); emit(" maps="); e64(ffdbg_countmaps(W)); emit("\n"); }
    }
    idx=idx+1;
  }
  emit("DBG-END\n");
  return 0;
}

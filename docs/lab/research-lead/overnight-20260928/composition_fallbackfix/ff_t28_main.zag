fn ff_lnode2(g:i32,a:i32)i32 { return 9000+g*100+a; }
fn ff_lrel2(g:i32,a:i32,b:i32)i32 { return 300+g*4+(a-1)*2+(b-1); }
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let idx:i32=0; let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ff_lnode2(g,a),ff_lrel2(g,a,b),ff_lnode2(g+1,b));
        let q:i32=ev_query(W,ff_lnode2(g,a),800+idx,ff_lnode2(g+1,b),0);
        if(q!=ff_lnode2(g+1,b)){emit("FAIL idx="); e64(idx); emit("\n");}
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("TRAINED-28\n");
  // count MAPs
  let m:i32=2; let nm:i32=0;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){nm=nm+1;}
    m=m+1;
  }
  emit("MAP-COUNT="); e64(nm); emit("\n");
  return 0;
}

// l3a_trace.zag -- L3A-TRACE: trace-invention builder.
// Pure Zag implementation. No other languages used.
//
// The learner records execution traces of its own successful programs,
// detects a recurring trace segment across tasks, and reifies it as a
// named operator whose semantics live in learner state (trace_heap plus
// name table). The pre-existing generic trace interpreter (vm_run, the
// frozen base VM below) executes the stored trace when a program uses
// TCALL. No researcher-written semantic case exists for any invented
// operator: the TCALL branch is pure indirection (bounds check, table
// lookup, recursive call into the same generic interpreter).
//
// Base VM op encoding (op:i32, arg:i32), frozen:
//   0=PUSH k, 1=IN0, 2=IN1, 3=ADD, 4=SUB, 5=MUL, 6=DIV (0 on div0),
//   7=NEG, 8=DUP, 9=DROP, 10=SWAP, 11=OVER,
//   12=LT, 13=EQ, 14=GT, 15=JZ a, 16=JNZ a, 17=JMP a,
//   18=TCALL n (generic trace call by runtime name id).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ program representation ============
// A program is a []u8: bytes 0..3 = len (i32), then len * 8 bytes of
// (op:i32 at +0, arg:i32 at +4).
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_set_len(p:[]u8, l:i32)void { set32(p, 0, l); return; }
fn prog_op(p:[]u8, i:i32)i32 { return get32(p, 4+i*8); }
fn prog_arg(p:[]u8, i:i32)i32 { return get32(p, 4+i*8+4); }
fn prog_set(p:[]u8, i:i32, op:i32, arg:i32)void {
  set32(p, 4+i*8, op); set32(p, 4+i*8+4, arg); return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}
fn prog_copy(dst:[]u8, src:[]u8)void {
  let l:i32=prog_len(src);
  prog_set_len(dst, l);
  let i:i32=0;
  while(i<l){ prog_set(dst, i, prog_op(src,i), prog_arg(src,i)); i=i+1; }
  return;
}
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=prog_len(p);
  prog_set(p, l, op, arg);
  prog_set_len(p, l+1);
  return;
}
fn prog_cmp(a:[]u8, b:[]u8)i32 {
  let la:i32=prog_len(a); let lb:i32=prog_len(b);
  let n:i32=la; if(lb<n){n=lb;}
  let i:i32=0;
  while(i<n){
    let oa:i32=prog_op(a,i); let ob:i32=prog_op(b,i);
    if(oa<ob){return -1;} if(oa>ob){return 1;}
    let aa:i32=prog_arg(a,i); let ab:i32=prog_arg(b,i);
    if(aa<ab){return -1;} if(aa>ab){return 1;}
    i=i+1;
  }
  if(la<lb){return -1;} if(la>lb){return 1;}
  return 0;
}
fn prog_has_tcall(p:[]u8, name:i32)i32 {
  let i:i32=0;
  let l:i32=prog_len(p);
  while(i<l){
    if(prog_op(p,i)==18 && prog_arg(p,i)==name){ return 1; }
    i=i+1;
  }
  return 0;
}

// ============ generic trace interpreter (frozen base VM) ============
// Executes any (op,arg) sequence from buf at byte offset base, length len.
// theap/nt_off/nt_len/nre are the learner state's trace store, consulted
// ONLY by the TCALL branch (op 18), which does a bounds check, a table
// lookup, and a recursive call into this same interpreter. That branch
// contains no arithmetic, no stack manipulation, and no per-operator
// semantics: it is pure indirection over learner-state bytes.
// stack/spbox are shared across TCALL recursion. tbuf/tcap record an
// execution trace when tcap>0: each record is 16 bytes
// (op, arg, depth_before, depth_after); tbuf[0..3] holds the count.
fn vm_run(buf:[]u8, base:i32, len:i32, in0:i32, in1:i32,
          theap:[]u8, nt_off:[]u8, nt_len:[]u8, nre:i32,
          stack:[]u8, spbox:[]u8, tbuf:[]u8, tcap:i32)i32 {
  let pc:i32=0;
  let steps:i32=0;
  let tcount:i32=0;
  if(tcap>0){ tcount=get32(tbuf, 0); }
  while(steps<10000){
    if(pc<0 || pc>=len){ break; }
    let op:i32=get32(buf, base+pc*8);
    let arg:i32=get32(buf, base+pc*8+4);
    let sp:i32=get32(spbox, 0);
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack, sp*4, arg); set32(spbox, 0, sp+1); }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack, sp*4, in0); set32(spbox, 0, sp+1); }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack, sp*4, in1); set32(spbox, 0, sp+1); }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,a+b); set32(spbox,0,sp-1); }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,a-b); set32(spbox,0,sp-1); }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,a*b); set32(spbox,0,sp-1); }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); let r:i32=0; if(b!=0){r=a/b;} set32(stack,(sp-2)*4,r); set32(spbox,0,sp-1); }
    } else if(op==7){ // NEG
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); }
    } else if(op==8){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); set32(spbox,0,sp+1); }
    } else if(op==9){ // DROP
      if(sp>=1){ set32(spbox,0,sp-1); }
    } else if(op==10){ // SWAP
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); }
    } else if(op==11){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); set32(spbox,0,sp+1); }
    } else if(op==12){ // LT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); let r:i32=0; if(a<b){r=1;} set32(stack,(sp-2)*4,r); set32(spbox,0,sp-1); }
    } else if(op==13){ // EQ
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); let r:i32=0; if(a==b){r=1;} set32(stack,(sp-2)*4,r); set32(spbox,0,sp-1); }
    } else if(op==14){ // GT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); let r:i32=0; if(a>b){r=1;} set32(stack,(sp-2)*4,r); set32(spbox,0,sp-1); }
    } else if(op==15){ // JZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(spbox,0,sp-1); if(a==0){pc=arg;} }
    } else if(op==16){ // JNZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(spbox,0,sp-1); if(a!=0){pc=arg;} }
    } else if(op==17){ // JMP
      pc=arg;
    } else if(op==18){ // TCALL n: generic indirection over learner-state bytes
      if(arg>=0 && arg<nre){
        let nb:i32=get32(nt_off, arg*4);
        let nl:i32=get32(nt_len, arg*4);
        vm_run(theap, nb, nl, in0, in1, theap, nt_off, nt_len, nre,
               stack, spbox, tbuf, 0);
      }
    }
    let sp2:i32=get32(spbox, 0);
    if(tcap>0 && tcount<tcap){
      set32(tbuf, 4+tcount*16, op);
      set32(tbuf, 4+tcount*16+4, arg);
      set32(tbuf, 4+tcount*16+8, sp);
      set32(tbuf, 4+tcount*16+12, sp2);
      tcount=tcount+1;
    }
  }
  if(tcap>0){ set32(tbuf, 0, tcount); }
  let spf:i32=get32(spbox, 0);
  if(spf>0){ return get32(stack, (spf-1)*4); }
  return 0;
}

// ============ evaluation ============
fn eval_prog(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
             theap:[]u8, nt_off:[]u8, nt_len:[]u8, nre:i32)i32 {
  let s:i32=0;
  let stack:[]u8=z_alloc(256*4);
  let spbox:[]u8=z_alloc(4);
  let dummy:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<n){
    set32(spbox, 0, 0);
    let o:i32=vm_run(p, 4, prog_len(p), get32(ein0,i*4), get32(ein1,i*4),
                     theap, nt_off, nt_len, nre, stack, spbox, dummy, 0);
    if(o==get32(etgt,i*4)){ s=s+1; }
    i=i+1;
  }
  return s;
}
fn eval_mae(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
            theap:[]u8, nt_off:[]u8, nt_len:[]u8, nre:i32)i64 {
  let mae:i64=0;
  let stack:[]u8=z_alloc(256*4);
  let spbox:[]u8=z_alloc(4);
  let dummy:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<n){
    set32(spbox, 0, 0);
    let o:i32=vm_run(p, 4, prog_len(p), get32(ein0,i*4), get32(ein1,i*4),
                     theap, nt_off, nt_len, nre, stack, spbox, dummy, 0);
    let d:i64=(o as i64)-(get32(etgt,i*4) as i64);
    if(d<0){ d=-d; }
    mae=mae+d;
    i=i+1;
  }
  return mae;
}

// ============ beam search ============
// Deterministic. Expansion order frozen: PUSH k (k in -4..4), IN0, IN1,
// ADD..GT (ops 3..14), then TCALL n for n in 0..nre-1 when allow_tcall=1.
// Ranking: exact count desc, MAE asc, length asc, lexicographic asc.
fn beam_search(ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
               theap:[]u8, nt_off:[]u8, nt_len:[]u8, nre:i32,
               allow_tcall:i32, max_len:i32, beam_w:i32,
               out_prog:[]u8)i32 {
  let psize:i32=4+max_len*8;
  let maxexp:i32=24;
  let cur:[]u8=z_alloc(beam_w*psize);
  let nxt:[]u8=z_alloc(beam_w*maxexp*psize);
  let cur_n:i32=1;
  set32(cur, 0, 0);
  let best_score:i32=-1;
  let best_len:i32=0;
  prog_set_len(out_prog, 0);
  let depth:i32=0;
  while(depth<max_len){
    let nxt_n:i32=0;
    let ci:i32=0;
    while(ci<cur_n){
      let base:[]u8=cur[ci*psize..ci*psize+psize];
      let k:i32=-4;
      while(k<=4){
        if(nxt_n<beam_w*maxexp){
          let nb:[]u8=nxt[nxt_n*psize..nxt_n*psize+psize];
          prog_copy(nb, base); prog_append(nb, 0, k);
          nxt_n=nxt_n+1;
        }
        k=k+1;
      }
      if(nxt_n<beam_w*maxexp){
        let nb:[]u8=nxt[nxt_n*psize..nxt_n*psize+psize];
        prog_copy(nb, base); prog_append(nb, 1, 0); nxt_n=nxt_n+1;
      }
      if(nxt_n<beam_w*maxexp){
        let nb:[]u8=nxt[nxt_n*psize..nxt_n*psize+psize];
        prog_copy(nb, base); prog_append(nb, 2, 0); nxt_n=nxt_n+1;
      }
      let o:i32=3;
      while(o<=14){
        if(nxt_n<beam_w*maxexp){
          let nb:[]u8=nxt[nxt_n*psize..nxt_n*psize+psize];
          prog_copy(nb, base); prog_append(nb, o, 0); nxt_n=nxt_n+1;
        }
        o=o+1;
      }
      if(allow_tcall==1){
        let f:i32=0;
        while(f<nre){
          if(nxt_n<beam_w*maxexp){
            let nb:[]u8=nxt[nxt_n*psize..nxt_n*psize+psize];
            prog_copy(nb, base); prog_append(nb, 18, f); nxt_n=nxt_n+1;
          }
          f=f+1;
        }
      }
      ci=ci+1;
    }
    let scores:[]u8=z_alloc(nxt_n*4);
    let maes:[]u8=z_alloc(nxt_n*8);
    let si:i32=0;
    while(si<nxt_n){
      let cb:[]u8=nxt[si*psize..si*psize+psize];
      set32(scores, si*4, eval_prog(cb, ein0, ein1, etgt, n, theap, nt_off, nt_len, nre));
      let m:i64=eval_mae(cb, ein0, ein1, etgt, n, theap, nt_off, nt_len, nre);
      set32(maes, si*8, (m as i32));
      set32(maes, si*8+4, ((m>>32) as i32));
      si=si+1;
    }
    let top_idx:[]u8=z_alloc(beam_w*4);
    let top_n:i32=0;
    si=0;
    while(si<nxt_n){
      let sc:i32=get32(scores, si*4);
      let cb:[]u8=nxt[si*psize..si*psize+psize];
      let cl:i32=prog_len(cb);
      let mlo:i32=get32(maes, si*8);
      let mhi:i32=get32(maes, si*8+4);
      let pos:i32=0;
      while(pos<top_n){
        let oi:i32=get32(top_idx, pos*4);
        let os:i32=get32(scores, oi*4);
        let ob:[]u8=nxt[oi*psize..oi*psize+psize];
        let ol:i32=prog_len(ob);
        let olo:i32=get32(maes, oi*8);
        let ohi:i32=get32(maes, oi*8+4);
        let before:i32=0;
        if(sc>os){ before=1; }
        else if(sc==os){
          if(mhi<ohi){ before=1; }
          else if(mhi==ohi){
            if(mlo<olo){ before=1; }
            else if(mlo==olo){
              if(cl<ol){ before=1; }
              else if(cl==ol){ if(prog_cmp(cb,ob)<0){ before=1; } }
            }
          }
        }
        if(before==1){ break; }
        pos=pos+1;
      }
      if(pos<beam_w){
        let sh:i32=top_n;
        if(sh>beam_w-1){ sh=beam_w-1; }
        while(sh>pos){
          set32(top_idx, sh*4, get32(top_idx, (sh-1)*4));
          sh=sh-1;
        }
        set32(top_idx, pos*4, si);
        if(top_n<beam_w){ top_n=top_n+1; }
        let better:i32=0;
        if(sc>best_score){ better=1; }
        else if(sc==best_score){
          if(cl<best_len){ better=1; }
          else if(cl==best_len){ if(prog_cmp(cb,out_prog)<0){ better=1; } }
        }
        if(better==1){ best_score=sc; best_len=cl; prog_copy(out_prog, cb); }
      }
      si=si+1;
    }
    let taken:i32=0;
    let oi:i32=0;
    while(oi<top_n && taken<beam_w){
      let idx:i32=get32(top_idx, oi*4);
      let cb:[]u8=nxt[idx*psize..idx*psize+psize];
      let dup:i32=0;
      let t2:i32=0;
      while(t2<taken){
        let tb:[]u8=cur[t2*psize..t2*psize+psize];
        if(prog_cmp(cb,tb)==0){ dup=1; }
        t2=t2+1;
      }
      if(dup==0){
        let db:[]u8=cur[taken*psize..taken*psize+psize];
        prog_copy(db, cb);
        taken=taken+1;
      }
      oi=oi+1;
    }
    cur_n=taken;
    if(cur_n==0){ break; }
    if(best_score==n){ break; }
    depth=depth+1;
  }
  return best_score;
}

// ============ trace printing ============
fn op_name(op:i32)[]u8 {
  if(op==0){return "PUSH";}
  if(op==1){return "IN0";}
  if(op==2){return "IN1";}
  if(op==3){return "ADD";}
  if(op==4){return "SUB";}
  if(op==5){return "MUL";}
  if(op==6){return "DIV";}
  if(op==7){return "NEG";}
  if(op==8){return "DUP";}
  if(op==9){return "DROP";}
  if(op==10){return "SWAP";}
  if(op==11){return "OVER";}
  if(op==12){return "LT";}
  if(op==13){return "EQ";}
  if(op==14){return "GT";}
  if(op==15){return "JZ";}
  if(op==16){return "JNZ";}
  if(op==17){return "JMP";}
  if(op==18){return "TCALL";}
  return "OP?";
}
fn print_prog(p:[]u8)void {
  let l:i32=prog_len(p);
  emit("[");
  let i:i32=0;
  while(i<l){
    if(i>0){emit(" ");}
    emit(op_name(prog_op(p,i)));
    let op:i32=prog_op(p,i);
    if(op==0 || op==15 || op==16 || op==17 || op==18){
      emit(":"); e64(prog_arg(p,i));
    }
    i=i+1;
  }
  emit("]");
  return;
}
fn print_seg(rec_buf:[]u8, t:i32, e:i32, s:i32, L:i32)void {
  emit("[");
  let i:i32=0;
  while(i<L){
    if(i>0){emit(" ");}
    let base:i32=(t*8+e)*256*16;
    let op:i32=get32(rec_buf, base+4+(s+i)*16);
    let arg:i32=get32(rec_buf, base+4+(s+i)*16+4);
    emit(op_name(op));
    if(op==0 || op==15 || op==16 || op==17 || op==18){
      emit(":"); e64(arg);
    }
    i=i+1;
  }
  emit("]");
  return;
}

// ============ tasks ============
// T0: y = x^2 ; T1: y = 2x^2 ; T2 (held-out, amended): y = x^4 + 2x^2 + x + 1.
// x in 0..6 (7 episodes).
fn build_task(t:i32, ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  let x:i32=0;
  while(x<=6){
    let y:i32=0;
    if(t==0){ y=x*x; }
    else if(t==1){ y=2*x*x; }
    else { let x2:i32=x*x; y=x2*x2+2*x2+x+1; }
    set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,y);
    n=n+1; x=x+1;
  }
  return n;
}

// ============ R1: trace recording ============
// Execute solution on every episode with tracing on; store per-episode
// records in learner state: rec_buf[(t*8+e)*256*16 + s*16 + (0,4,8,12)]
// = (op, arg, depth_before, depth_after). rec_cnt[t*8+e] = step count.
fn record_task(t:i32, sol:[]u8, ein0:[]u8, ein1:[]u8, n:i32,
               theap:[]u8, nt_off:[]u8, nt_len:[]u8, nre:i32,
               rec_buf:[]u8, rec_cnt:[]u8)void {
  let stack:[]u8=z_alloc(256*4);
  let spbox:[]u8=z_alloc(4);
  let e:i32=0;
  while(e<n){
    let base:i32=(t*8+e)*256*16;
    let tb:[]u8=rec_buf[base..base+4+256*16];
    set32(tb, 0, 0);
    set32(spbox, 0, 0);
    vm_run(sol, 4, prog_len(sol), get32(ein0,e*4), get32(ein1,e*4),
           theap, nt_off, nt_len, nre, stack, spbox, tb, 256);
    set32(rec_cnt, (t*8+e)*4, get32(tb, 0));
    e=e+1;
  }
  return;
}
fn rec_cnt_at(rec_cnt:[]u8, t:i32, e:i32)i32 {
  return get32(rec_cnt, (t*8+e)*4);
}
fn rec_op(rec_buf:[]u8, t:i32, e:i32, s:i32)i32 {
  return get32(rec_buf, (t*8+e)*256*16+4+(s*16));
}
fn rec_arg(rec_buf:[]u8, t:i32, e:i32, s:i32)i32 {
  return get32(rec_buf, (t*8+e)*256*16+4+(s*16)+4);
}

// ============ R2: repetition detection ============
// Abstract stack effect of one op: returns pop*16+push, or -1 for
// control-flow / TCALL (rejected from reified segments).
fn op_effect(op:i32)i32 {
  if(op==0){return 0*16+1;}
  if(op==1){return 0*16+1;}
  if(op==2){return 0*16+1;}
  if(op==3){return 2*16+1;}
  if(op==4){return 2*16+1;}
  if(op==5){return 2*16+1;}
  if(op==6){return 2*16+1;}
  if(op==7){return 1*16+1;}
  if(op==8){return 1*16+2;}
  if(op==9){return 1*16+0;}
  if(op==10){return 2*16+2;}
  if(op==11){return 2*16+3;}
  if(op==12){return 2*16+1;}
  if(op==13){return 2*16+1;}
  if(op==14){return 2*16+1;}
  return -1;
}
// Abstract arity of segment (t0,e0,s0,L). Returns arity*64+produced,
// or -1 when the segment contains a rejected op.
fn seg_arcode(rec_buf:[]u8, t0:i32, e0:i32, s0:i32, L:i32)i32 {
  let d:i32=0;
  let mind:i32=0;
  let i:i32=0;
  while(i<L){
    let op:i32=rec_op(rec_buf, t0, e0, s0+i);
    let ef:i32=op_effect(op);
    if(ef<0){ return -1; }
    let pop:i32=ef/16;
    let push:i32=ef-(pop*16);
    d=d-pop;
    if(d<mind){ mind=d; }
    d=d+push;
    i=i+1;
  }
  let arity:i32=-mind;
  let produced:i32=arity+d;
  return arity*64+produced;
}
// Does segment (t0,e0,s0,L) occur contiguously in episode (t,ep)?
fn seg_in_ep(rec_buf:[]u8, rec_cnt:[]u8, t:i32, ep:i32,
             t0:i32, e0:i32, s0:i32, L:i32)i32 {
  let cnt:i32=rec_cnt_at(rec_cnt, t, ep);
  if(cnt<L){ return 0; }
  let s1:i32=0;
  while(s1+ L<=cnt){
    let ok:i32=1;
    let i:i32=0;
    while(i<L){
      if(rec_op(rec_buf,t,ep,s1+i)!=rec_op(rec_buf,t0,e0,s0+i) ||
         rec_arg(rec_buf,t,ep,s1+i)!=rec_arg(rec_buf,t0,e0,s0+i)){
        ok=0; break;
      }
      i=i+1;
    }
    if(ok==1){ return 1; }
    s1=s1+1;
  }
  return 0;
}
// Lexicographic compare of segments A=(t0,e0,s0,L) and B=(bt,be,bs,L).
// Returns -1, 0, 1.
fn seg_cmp(rec_buf:[]u8, t0:i32, e0:i32, s0:i32, bt:i32, be:i32, bs:i32, L:i32)i32 {
  let i:i32=0;
  while(i<L){
    let oa:i32=rec_op(rec_buf,t0,e0,s0+i); let ob:i32=rec_op(rec_buf,bt,be,bs+i);
    if(oa<ob){return -1;} if(oa>ob){return 1;}
    let aa:i32=rec_arg(rec_buf,t0,e0,s0+i); let ab:i32=rec_arg(rec_buf,bt,be,bs+i);
    if(aa<ab){return -1;} if(aa>ab){return 1;}
    i=i+1;
  }
  return 0;
}
// Detect the best segment over solved tasks 0..ntasks-1.
// out_seg: L*8 bytes of (op,arg). out_info: [L, credit, arity, produced].
// Returns 1 when a segment satisfying all R2 conditions is found.
fn detect(ntasks:i32, nep:[]u8, rec_buf:[]u8, rec_cnt:[]u8,
          out_seg:[]u8, out_info:[]u8)i32 {
  let best_L:i32=0;
  let best_cred:i32=0;
  let best_t:i32=-1; let best_e:i32=-1; let best_s:i32=-1;
  let t0:i32=0;
  while(t0<ntasks){
    let ne0:i32=get32(nep, t0*4);
    let e0:i32=0;
    while(e0<ne0){
      let cnt0:i32=rec_cnt_at(rec_cnt, t0, e0);
      let s0:i32=0;
      while(s0<cnt0){
        let L:i32=2;
        while(s0+L<=cnt0){
          let code:i32=seg_arcode(rec_buf, t0, e0, s0, L);
          if(code>=0){
            let arity:i32=code/64;
            let produced:i32=code-(arity*64);
            if(arity>=0 && arity<=2 && produced>=1){
              // credit: tasks where the segment occurs in EVERY episode
              let cred:i32=0;
              let t:i32=0;
              while(t<ntasks){
                let ne:i32=get32(nep, t*4);
                let all:i32=1;
                let ep:i32=0;
                while(ep<ne){
                  if(seg_in_ep(rec_buf, rec_cnt, t, ep, t0, e0, s0, L)==0){
                    all=0; break;
                  }
                  ep=ep+1;
                }
                if(all==1){ cred=cred+1; }
                t=t+1;
              }
              if(cred>=2){
                let better:i32=0;
                if(L>best_L){ better=1; }
                else if(L==best_L){
                  if(cred>best_cred){ better=1; }
                  else if(cred==best_cred){
                    if(best_t<0){ better=1; }
                    else if(seg_cmp(rec_buf,t0,e0,s0,best_t,best_e,best_s,L)<0){
                      better=1;
                    }
                  }
                }
                if(better==1){
                  best_L=L; best_cred=cred;
                  best_t=t0; best_e=e0; best_s=s0;
                  set32(out_info, 8, arity);
                  set32(out_info, 12, produced);
                }
              }
            }
          }
          L=L+1;
        }
        s0=s0+1;
      }
      e0=e0+1;
    }
    t0=t0+1;
  }
  if(best_t<0){ return 0; }
  set32(out_info, 0, best_L);
  set32(out_info, 4, best_cred);
  let i:i32=0;
  while(i<best_L){
    set32(out_seg, i*8, rec_op(rec_buf, best_t, best_e, best_s+i));
    set32(out_seg, i*8+4, rec_arg(rec_buf, best_t, best_e, best_s+i));
    i=i+1;
  }
  return 1;
}

// ============ R3: reification ============
// Copies the segment bytes into trace_heap, installs the name-table entry,
// and assigns the next runtime name_id from the learner state's counter.
// Returns the new heap_top; out_id[0] receives the runtime name_id.
fn reify(seg:[]u8, L:i32, arity:i32, produced:i32,
         theap:[]u8, nt_off:[]u8, nt_len:[]u8, nt_arity:[]u8, nt_prod:[]u8,
         nre:i32, heap_top:i32, out_id:[]u8)i32 {
  let name:i32=nre;
  set32(nt_off, name*4, heap_top);
  set32(nt_len, name*4, L);
  set32(nt_arity, name*4, arity);
  set32(nt_prod, name*4, produced);
  let i:i32=0;
  while(i<L){
    set32(theap, heap_top+i*8, get32(seg, i*8));
    set32(theap, heap_top+i*8+4, get32(seg, i*8+4));
    i=i+1;
  }
  set32(out_id, 0, name);
  return heap_top+L*8;
}

// ============ state export (T-PERSIST / T-SWAP) ============
// Byte-copies the trace store into fresh arrays, simulating a fresh session
// that receives only the persisted bytes. Never executes anything.
fn state_export(theap:[]u8, heap_top:i32,
                nt_off:[]u8, nt_len:[]u8, nt_arity:[]u8, nt_prod:[]u8, nre:i32,
                e_heap:[]u8, e_off:[]u8, e_len:[]u8,
                e_arity:[]u8, e_prod:[]u8, e_nre:[]u8)void {
  let i:i32=0;
  while(i<heap_top){
    e_heap[i]=theap[i];
    i=i+1;
  }
  let j:i32=0;
  while(j<nre){
    set32(e_off, j*4, get32(nt_off, j*4));
    set32(e_len, j*4, get32(nt_len, j*4));
    set32(e_arity, j*4, get32(nt_arity, j*4));
    set32(e_prod, j*4, get32(nt_prod, j*4));
    j=j+1;
  }
  set32(e_nre, 0, nre);
  return;
}
// Probe: run [TCALL name] on x in -3..6 against the given (exported) store.
// mode 0 expects x*x; mode 1 expects 2*x. Returns correct count (of 10).
fn probe(e_heap:[]u8, e_off:[]u8, e_len:[]u8, nre:i32, name:i32, mode:i32)i32 {
  let p:[]u8=prog_new(2);
  prog_append(p, 18, name);
  let stack:[]u8=z_alloc(256*4);
  let spbox:[]u8=z_alloc(4);
  let dummy:[]u8=z_alloc(4);
  let good:i32=0;
  let x:i32=-3;
  while(x<=6){
    set32(spbox, 0, 0);
    let o:i32=vm_run(p, 4, 1, x, 0,
                     e_heap, e_off, e_len, nre, stack, spbox, dummy, 0);
    let want:i32=x*x;
    if(mode==1){ want=2*x; }
    if(o==want){ good=good+1; }
    x=x+1;
  }
  return good;
}

// ============ main battery ============
fn main()void {
  emit("L3A-TRACE battery\n");
  // Learner state (persistent).
  let theap:[]u8=z_alloc(4096);
  let nt_off:[]u8=z_alloc(4*4);
  let nt_len:[]u8=z_alloc(4*4);
  let nt_arity:[]u8=z_alloc(4*4);
  let nt_prod:[]u8=z_alloc(4*4);
  let nre:i32=0;
  let heap_top:i32=0;
  // Recorded traces: 4 tasks x 8 episodes x 256 steps x 16 bytes.
  let rec_buf:[]u8=z_alloc(4*8*256*16);
  let rec_cnt:[]u8=z_alloc(32*4);
  let nep:[]u8=z_alloc(4*4);

  // ---- Phase 1: solve training tasks T0, T1 (no TCALL) ----
  let train_ok:i32=1;
  let sol0:[]u8=prog_new(8);
  let sol1:[]u8=prog_new(8);
  let t:i32=0;
  while(t<2){
    let ein0:[]u8=z_alloc(8*4); let ein1:[]u8=z_alloc(8*4); let etgt:[]u8=z_alloc(8*4);
    let n:i32=build_task(t, ein0, ein1, etgt);
    set32(nep, t*4, n);
    let out:[]u8=prog_new(8);
    let sc:i32=beam_search(ein0, ein1, etgt, n,
                          theap, nt_off, nt_len, nre,
                          0, 8, 600, out);
    emit("TRAIN t="); e64(t);
    emit(" score="); e64(sc); emit("/"); e64(n);
    emit(" len="); e64(prog_len(out));
    emit(" prog="); print_prog(out); emit("\n");
    if(sc==n){
      record_task(t, out, ein0, ein1, n, theap, nt_off, nt_len, nre, rec_buf, rec_cnt);
      emit("RECORDED t="); e64(t);
      emit(" ep0_steps="); e64(rec_cnt_at(rec_cnt, t, 0)); emit("\n");
      if(t==0){ prog_copy(sol0, out); } else { prog_copy(sol1, out); }
    } else {
      train_ok=0;
      emit("TRAIN-FAIL t="); e64(t); emit("\n");
    }
    t=t+1;
  }

  // ---- R2/R3: detect and reify ----
  let invented:i32=0;
  let segmatch:i32=0;
  let name_id:i32=-1;
  let segL:i32=0;
  if(train_ok==1){
    let seg:[]u8=z_alloc(8*8);
    let info:[]u8=z_alloc(16*4);
    let found:i32=detect(2, nep, rec_buf, rec_cnt, seg, info);
    if(found==1){
      let L:i32=get32(info, 0);
      let cred:i32=get32(info, 4);
      let arity:i32=get32(info, 8);
      let produced:i32=get32(info, 12);
      let oid:[]u8=z_alloc(4);
      heap_top=reify(seg, L, arity, produced, theap,
                     nt_off, nt_len, nt_arity, nt_prod, nre, heap_top, oid);
      name_id=get32(oid, 0);
      nre=nre+1;
      invented=1;
      segL=L;
      emit("REIFIED name="); e64(name_id);
      emit(" len="); e64(L);
      emit(" arity="); e64(arity);
      emit(" produced="); e64(produced);
      emit(" credit_tasks="); e64(cred);
      emit(" bytes=[");
      let i:i32=0;
      while(i<L){
        if(i>0){emit(" ");}
        emit(op_name(get32(seg,i*8))); emit(":"); e64(get32(seg,i*8+4));
        i=i+1;
      }
      emit("]\n");
      // SEGMENT-MATCH guard: the battery's downstream bars are built around
      // the intended invention [(IN0,0),(IN0,0),(MUL,0)] ("push x*x").
      // Note: the beam's lexicographic tie-break prefers IN0,IN0 over IN0,DUP
      // (both compute x*x), so the detected segment is [1,1,5], not [1,8,5].
      if(L==3 && get32(seg,0)==1 && get32(seg,4)==0 &&
         get32(seg,8)==1 && get32(seg,12)==0 &&
         get32(seg,16)==5 && get32(seg,20)==0){
        segmatch=1;
      }
      emit("SEGMENT-MATCH "); e64(segmatch); emit("\n");
    } else {
      emit("NO-INVENTION\n");
    }
  }

  // ---- STATE-DUMP ----
  emit("STATE-DUMP nre="); e64(nre); emit(" heap_top="); e64(heap_top); emit("\n");
  let di:i32=0;
  while(di<nre){
    emit("ENTRY id="); e64(di);
    emit(" off="); e64(get32(nt_off, di*4));
    emit(" len="); e64(get32(nt_len, di*4));
    emit(" arity="); e64(get32(nt_arity, di*4));
    emit(" produced="); e64(get32(nt_prod, di*4));
    emit("\n");
    di=di+1;
  }

  // ---- Bar (b) T-PERSIST: export bytes, probe from the copy ----
  let persist_ok:i32=0;
  // Exported (fresh-session) store.
  let e_heap:[]u8=z_alloc(4096);
  let e_off:[]u8=z_alloc(4*4);
  let e_len:[]u8=z_alloc(4*4);
  let e_arity:[]u8=z_alloc(4*4);
  let e_prod:[]u8=z_alloc(4*4);
  let e_nre:[]u8=z_alloc(4);
  if(invented==1 && segmatch==1){
    state_export(theap, heap_top, nt_off, nt_len, nt_arity, nt_prod, nre,
                 e_heap, e_off, e_len, e_arity, e_prod, e_nre);
    let g:i32=probe(e_heap, e_off, e_len, nre, name_id, 0);
    emit("T-PERSIST probe_x2="); e64(g); emit("/10\n");
    if(g==10){ persist_ok=1; }
  } else {
    emit("T-PERSIST skipped\n");
  }

  // ---- Bar (c) T-REUSE: phase-2 with invention on held-out T2 ----
  let reuse_ok:i32=0;
  let t2len:i32=0;
  let r_ein0:[]u8=z_alloc(8*4); let r_ein1:[]u8=z_alloc(8*4); let r_etgt:[]u8=z_alloc(8*4);
  let r_n:i32=build_task(2, r_ein0, r_ein1, r_etgt);
  let r_out:[]u8=prog_new(8);
  let r_sc:i32=beam_search(r_ein0, r_ein1, r_etgt, r_n,
                        theap, nt_off, nt_len, nre,
                        1, 8, 600, r_out);
  t2len=prog_len(r_out);
  emit("T-REUSE score="); e64(r_sc); emit("/"); e64(r_n);
  emit(" len="); e64(t2len);
  emit(" prog="); print_prog(r_out); emit("\n");
  if(r_sc==r_n && invented==1 && prog_has_tcall(r_out, name_id)==1){
    reuse_ok=1;
  }
  emit("T-REUSE has_tcall="); e64(prog_has_tcall(r_out, name_id)); emit("\n");

  // ---- Bar (d) T-ABLATE: phase-2 with invention disabled on T2 ----
  let ablate_ok:i32=0;
  let a_ein0:[]u8=z_alloc(8*4); let a_ein1:[]u8=z_alloc(8*4); let a_etgt:[]u8=z_alloc(8*4);
  let a_n:i32=build_task(2, a_ein0, a_ein1, a_etgt);
  let a_out:[]u8=prog_new(8);
  let a_sc:i32=beam_search(a_ein0, a_ein1, a_etgt, a_n,
                        theap, nt_off, nt_len, nre,
                        0, 8, 600, a_out);
  emit("T-ABLATE score="); e64(a_sc); emit("/"); e64(a_n);
  emit(" len="); e64(prog_len(a_out)); emit("\n");
  if(a_sc<a_n){ ablate_ok=1; }

  // ---- Bar (e) T-SWAP: behavior follows the stored bytes ----
  let swap_ok:i32=0;
  if(invented==1 && segmatch==1 && persist_ok==1){
    // Overwrite entry 0's bytes in the EXPORTED copy with [IN0, DUP, ADD].
    let off0:i32=get32(e_off, 0);
    set32(e_heap, off0, 1);    set32(e_heap, off0+4, 0);
    set32(e_heap, off0+8, 8);  set32(e_heap, off0+12, 0);
    set32(e_heap, off0+16, 3); set32(e_heap, off0+20, 0);
    let g1:i32=probe(e_heap, e_off, e_len, nre, name_id, 1);
    emit("T-SWAP swapped_probe_2x="); e64(g1); emit("/10\n");
    // Restore original bytes from the live learner state.
    let i:i32=0;
    while(i<heap_top){
      e_heap[i]=theap[i];
      i=i+1;
    }
    let g2:i32=probe(e_heap, e_off, e_len, nre, name_id, 0);
    emit("T-SWAP restored_probe_x2="); e64(g2); emit("/10\n");
    if(g1==10 && g2==10){ swap_ok=1; }
  } else {
    emit("T-SWAP skipped\n");
  }

  // ---- verdict ----
  emit("BAR-A-INVENT "); e64(invented); emit("\n");
  emit("BAR-A-SEGMATCH "); e64(segmatch); emit("\n");
  emit("BAR-B-PERSIST "); e64(persist_ok); emit("\n");
  emit("BAR-C-REUSE "); e64(reuse_ok); emit(" t2len="); e64(t2len); emit("\n");
  emit("BAR-D-ABLATE "); e64(ablate_ok); emit("\n");
  emit("BAR-E-SWAP "); e64(swap_ok); emit("\n");
  let pass:i32=0;
  if(train_ok==1 && invented==1 && segmatch==1 && persist_ok==1 &&
     reuse_ok==1 && ablate_ok==1 && swap_ok==1){
    pass=1;
  }
  if(pass==1){
    emit("VERDICT L3A-TRACE-BUILD-PASS\n");
  } else {
    emit("VERDICT L3A-TRACE-BUILD-FAIL\n");
  }
  emit("DONE\n");
  return;
}

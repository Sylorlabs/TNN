// lsub.zag -- P7 continuing-learner policy ported onto the shared substrate.
// Prereg ff7558bff frozen before this file. Pure Zag. No Python.
// The 64-slot integer experience array is deleted. All experience lives
// in the substrate's string-interned fact triple store. Policy state
// (schema + counters) lives in a dedicated region at POL=30000.
// Frozen 15-domain workload identical to contlearn3 (TRANSFER-TESTED).

fn emit(s:[]u8)void { _zag_print(s); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ substrate primitives (verbatim from substrate.zag) ============
fn h_factbase(W:[]u8)i32 { return get32(W,24); }
fn h_strcur(W:[]u8)i32 { return get32(W,32); }
fn h_strcur_set(W:[]u8, v:i32)void { set32(W,32,v); return; }
fn h_factcount(W:[]u8)i32 { return get32(W,44); }
fn h_factcount_set(W:[]u8, v:i32)void { set32(W,44,v); return; }
fn h_conflicts(W:[]u8)i32 { return get32(W,64); }
fn h_conflicts_set(W:[]u8, v:i32)void { set32(W,64,v); return; }

fn sub_init(W:[]u8, nvar:i32)i32 {
  if(nvar<1 || nvar>8){
    emit("substrate: nvar out of range\n");
    return 0;
  }
  let ep_stride:i32=((5+2*nvar+3)/4)*4;
  let ent_stride:i32=((56+9*nvar+3)/4)*4;
  let ep_base:i32=128;
  let ent_base:i32=ep_base+64*ep_stride;
  let fact_base:i32=ent_base+64*ent_stride;
  let str_base:i32=fact_base+256*12;
  if(str_base+4096>32768){
    emit("substrate: workspace too small\n");
    return 0;
  }
  set32(W,0,1397057875);
  set32(W,4,nvar);
  set32(W,8,ep_stride);
  set32(W,12,ent_stride);
  set32(W,16,ep_base);
  set32(W,20,ent_base);
  set32(W,24,fact_base);
  set32(W,28,str_base);
  set32(W,32,str_base);
  set32(W,36,0);
  set32(W,40,0);
  set32(W,44,0);
  set32(W,48,0);
  set32(W,52,64);
  set32(W,56,64);
  set32(W,60,256);
  set32(W,64,0);
  set32(W,68,0);
  return 1;
}
fn sub_str(W:[]u8, s:[]u8)i32 {
  let p:i32=h_strcur(W);
  set32(W,p,s.len);
  let i:i32=0;
  while(i<s.len){ W[p+4+i]=s[i]; i=i+1; }
  h_strcur_set(W,p+4+s.len);
  return p;
}
fn sub_streq(W:[]u8, o1:i32, o2:i32)i32 {
  let l1:i32=get32(W,o1);
  let l2:i32=get32(W,o2);
  if(l1!=l2){return 0;}
  let i:i32=0;
  while(i<l1){
    if(W[o1+4+i]!=W[o2+4+i]){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ key interning (each distinct key stored once) ============
// KC: 128 x 4-byte offsets, 0 = empty slot.
fn udec(v:i32)[]u8 {
  if(v==0){return "0";}
  let tmp:[]u8=z_alloc(12);
  let n:i32=0;
  let x:i32=v;
  while(x>0){ tmp[n]=(48+(x%10)) as u8; n=n+1; x=x/10; }
  let r:[]u8=z_alloc(n);
  let j:i32=0;
  while(j<n){ r[j]=tmp[n-1-j]; j=j+1; }
  return r;
}
fn ekey(v:i32)[]u8 {
  let d:[]u8=udec(v);
  let r:[]u8=z_alloc(1+d.len);
  r[0]=115 as u8;
  let j:i32=0;
  while(j<d.len){ r[1+j]=d[j]; j=j+1; }
  return r;
}
fn key(W:[]u8, KC:[]u8, s:[]u8)i32 {
  let tmp:i32=sub_str(W,s);
  let i:i32=0;
  while(i<128){
    let o:i32=get32(KC,i*4);
    if(o!=0){
      if(sub_streq(W,o,tmp)==1){
        h_strcur_set(W,tmp);
        return o;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<128){
    if(get32(KC,i*4)==0){
      set32(KC,i*4,tmp);
      return tmp;
    }
    i=i+1;
  }
  h_strcur_set(W,tmp);
  return -1;
}
fn pnum(W:[]u8, off:i32)i32 {
  let l:i32=get32(W,off);
  let v:i32=0;
  let k:i32=0;
  while(k<l){ v=v*10+((W[off+4+k] as i32)-48); k=k+1; }
  return v;
}

// ============ substrate-record fact access (sub_fact_learn/query semantics) ============
fn flearn(W:[]u8, eo:i32, ao:i32, vo:i32)i32 {
  let fc:i32=h_factcount(W);
  if(fc>=256){return -1;}
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1){
      if(sub_streq(W,get32(W,o+4),ao)==1){
        if(sub_streq(W,get32(W,o+8),vo)==0){
          h_conflicts_set(W,h_conflicts(W)+1);
        }
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  h_factcount_set(W,fc+1);
  return fc;
}
fn fquery(W:[]u8, eo:i32, ao:i32)i32 {
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1){
      if(sub_streq(W,get32(W,o+4),ao)==1){return get32(W,o+8);}
    }
    i=i-1;
  }
  return -1;
}

// ============ policy region at POL=30000 ============
// schema: 0 kind, 4 rel, 8 obj/default, 12 live, 16 exc_abs, 20 exc_obj
// counters at +24: 0 ops_learn, 4 consec, 8 ledger, 12 retired_ledger,
//   16 discovered, 20 applies, 24 s2disc, 28 s2app, 32 superseded,
//   36 transfer_ok, 40 consec_ret_d11, 44 rediscover_d12, 48 apply_d13,
//   52 ledger2_d14, 56 s2disc_d15, 60 sel_correct
fn sch(W:[]u8,f:i32)i32 { return get32(W,30000+f); }
fn schw(W:[]u8,f:i32,v:i32)void { set32(W,30000+f,v); return; }
fn ctr(W:[]u8,f:i32)i32 { return get32(W,30024+f); }
fn ctrw(W:[]u8,f:i32,v:i32)void { set32(W,30024+f,v); return; }
fn ctradd(W:[]u8,f:i32,d:i32)void { set32(W,30024+f,get32(W,30024+f)+d); return; }

// ============ frozen workload: true object per (domain, slot) ============
// Identical to contlearn3.
fn true_obj(d:i32,i:i32)i32 {
  if(d==1){return 4;}
  if(d==2){return 2;}
  if(d==3){return 0;}
  if(d==4){
    if(i==3){return 1;}
    return 6;
  }
  if(d==5){return 5;}
  if(d==6){
    if(i==2){return 9;}
    return 3;
  }
  if(d==7){
    if(i==2){return 4;}
    return 7;
  }
  if(d==8){
    if(i==0){return 2;} if(i==1){return 8;} if(i==2){return 4;} return 6;
  }
  if(d==9){
    if(i==2){return 50;}
    return 100;
  }
  if(d==10){return 200;}
  if(d==11){return 300;}
  if(d==12){return 300;}
  if(d==13){return 400;}
  if(d==14){
    if(i==3){return 999;}
    return 500;
  }
  if(i==2){return 70;}
  return 600;
}
fn subj_of(d:i32,i:i32)i32 { return d*10+i; }

// ============ P7 policy on the substrate fact store ============
fn learn(W:[]u8, KC:[]u8, ra:i32, subj:i32, obj:i32)void {
  let eo:i32=key(W,KC,ekey(subj));
  let vo:i32=key(W,KC,udec(obj));
  let fr:i32=flearn(W,eo,ra,vo);
  if(fr<-1){emit("learn-overflow\n");}
  ctradd(W,0,1);
  return;
}
fn query(W:[]u8, KC:[]u8, ra:i32, subj:i32)i32 {
  let vo:i32=fquery(W,key(W,KC,ekey(subj)),ra);
  if(vo>=0){return pnum(W,vo);}
  if(sch(W,12)==1){
    if(sch(W,0)==1){return sch(W,8);}
    if(sch(W,0)==2){
      if(subj==sch(W,16)){return sch(W,20);}
      return sch(W,8);
    }
  }
  return -1;
}
fn iobj(W:[]u8, KC:[]u8, ra:i32, dom:i32, q:i32)i32 {
  let vo:i32=fquery(W,key(W,KC,ekey(subj_of(dom,q))),ra);
  if(vo<0){return -999;}
  return pnum(W,vo);
}
fn discover(W:[]u8, KC:[]u8, ra:i32, dom:i32)i32 {
  let q:i32=0;
  let o:i32=0;
  let n:i32=0;
  while(q<4){
    let v:i32=iobj(W,KC,ra,dom,q);
    if(v==-999){return 0;}
    if(n==0){o=v;}
    else { if(v!=o){return 0;} }
    n=n+1;
    q=q+1;
  }
  if(n==0){return 0;}
  schw(W,0,1); schw(W,4,1); schw(W,8,o); schw(W,12,1);
  return 1;
}
fn discover2(W:[]u8, KC:[]u8, ra:i32, dom:i32)i32 {
  let p:i32=0;
  while(p<4){
    let vp:i32=iobj(W,KC,ra,dom,p);
    if(vp!=-999){
      let def:i32=-999;
      let ok:i32=1;
      let q:i32=0;
      while(q<4){
        if(q!=p){
          let vq:i32=iobj(W,KC,ra,dom,q);
          if(vq==-999){ok=0;}
          else {
            if(def==-999){def=vq;}
            else { if(vq!=def){ok=0;} }
          }
        }
        q=q+1;
      }
      if(ok==1){
        if(def!=-999){
          if(def!=vp){
            schw(W,0,2); schw(W,4,1); schw(W,8,def); schw(W,12,1);
            schw(W,16,subj_of(dom,p)); schw(W,20,vp);
            return 1;
          }
        }
      }
    }
    p=p+1;
  }
  return 0;
}
fn gate1_pass(d:i32)i32 {
  let a:i32=true_obj(d,0);
  let b:i32=true_obj(d,1);
  let c:i32=true_obj(d,2);
  if(a==b){ if(b==c){return 1;} }
  return 0;
}
fn queries_correct(W:[]u8, KC:[]u8, ra:i32, d:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<4){
    if(query(W,KC,ra,subj_of(d,i))==true_obj(d,i)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn retire_ledger(W:[]u8,consec_snap:i32,d:i32)void {
  schw(W,12,0); ctrw(W,4,0); ctrw(W,8,0); ctrw(W,12,1);
  if(d==14){
    if(consec_snap==0){ ctrw(W,52,1); }
  }
  emit("SCHEMA_RETIRED_LEDGER consec="); e64(consec_snap); emit("\n");
  return;
}
fn retire_consec(W:[]u8,d:i32)void {
  schw(W,12,0); ctrw(W,4,0); ctrw(W,8,0);
  if(d==11){ ctrw(W,40,1); }
  emit("SCHEMA_RETIRED_CONSEC\n");
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(32768);
  if(sub_init(W,1)==0){ emit("LSUB INIT FAIL\n"); return 1; }
  let KC:[]u8=z_alloc(128*4);
  let ra:i32=key(W,KC,"r1");
  emit("LSUB substrate-backed continuing learner, nvar=1\n");
  // ---- D1: discovery domain ----
  let i:i32=0;
  while(i<4){ learn(W,KC,ra,subj_of(1,i),true_obj(1,i)); i=i+1; }
  let disc:i32=0;
  if(sch(W,12)==0){ disc=discover(W,KC,ra,1); }
  if(disc==1){
    ctrw(W,16,1);
    emit("SCHEMA_DISC rel=1 obj="); e64(sch(W,8)); emit("\n");
  } else {
    emit("SCHEMA_DISC none\n");
  }
  // ---- D2..D15: policy run (identical logic to contlearn3) ----
  let d:i32=2;
  while(d<=15){
    if(sch(W,12)==1){
      if(sch(W,0)==1){
        let k:i32=0;
        while(k<3){ learn(W,KC,ra,subj_of(d,k),true_obj(d,k)); k=k+1; }
        let g:i32=gate1_pass(d);
        emit("DOM "); e64(d); emit(" GATE1="); e64(g); emit("\n");
        if(g==1){
          schw(W,8,true_obj(d,0));
          ctrw(W,4,0);
          let acc_s:i32=queries_correct(W,KC,ra,d);
          ctradd(W,8,acc_s-4);
          ctradd(W,20,1);
          if(d==13){
            if(acc_s==4){ ctrw(W,48,1); }
            ctradd(W,60,1);
          }
          if(d==14){
            ctradd(W,60,1);
          }
          emit("APPLY dom="); e64(d); emit(" obj="); e64(sch(W,8)); emit(" learns=3 acc="); e64(acc_s); emit("\n");
          if(ctr(W,8)<0){ retire_ledger(W,ctr(W,4),d); }
        } else {
          learn(W,KC,ra,subj_of(d,3),true_obj(d,3));
          ctradd(W,4,1);
          emit("FALLBACK dom="); e64(d); emit(" learns=4\n");
          let rw:i32=0;
          if(ctr(W,4)>=2){rw=1;}
          if(ctr(W,8)<0){rw=1;}
          if(rw==1){ retire_consec(W,d); }
          else {
            let s2:i32=discover2(W,KC,ra,d);
            if(s2==1){
              ctrw(W,24,1); ctrw(W,32,1); ctrw(W,4,0); ctrw(W,8,0);
              emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
              emit(" excabs="); e64(sch(W,16));
              emit(" excobj="); e64(sch(W,20)); emit("\n");
            }
          }
        }
      } else {
        let k2:i32=0;
        while(k2<3){ learn(W,KC,ra,subj_of(d,k2),true_obj(d,k2)); k2=k2+1; }
        let a:i32=true_obj(d,0);
        let b:i32=true_obj(d,1);
        let c:i32=true_obj(d,2);
        let g2:i32=0;
        let def:i32=0;
        let exc:i32=0;
        let epos:i32=0;
        if(a==b){
          if(b!=c){ g2=1; def=a; exc=c; epos=2; }
        } else {
          if(a==c){
            if(a!=b){ g2=1; def=a; exc=b; epos=1; }
          } else {
            if(b==c){ g2=1; def=b; exc=a; epos=0; }
          }
        }
        emit("DOM "); e64(d); emit(" GATE2="); e64(g2); emit("\n");
        if(g2==1){
          schw(W,8,def); schw(W,16,subj_of(d,epos)); schw(W,20,exc);
          ctrw(W,4,0);
          let acc2:i32=queries_correct(W,KC,ra,d);
          ctradd(W,8,acc2-4);
          ctradd(W,20,1);
          ctradd(W,28,1);
          if(d==9){
            if(acc2==4){ ctrw(W,36,1); }
            ctradd(W,60,1);
          }
          emit("APPLY2 dom="); e64(d); emit(" default="); e64(def);
          emit(" excpos="); e64(epos); emit(" excobj="); e64(exc);
          emit(" learns=3 acc="); e64(acc2); emit("\n");
          if(ctr(W,8)<0){ retire_ledger(W,ctr(W,4),d); }
        } else {
          learn(W,KC,ra,subj_of(d,3),true_obj(d,3));
          ctradd(W,4,1);
          emit("FALLBACK dom="); e64(d); emit(" learns=4\n");
          if(d==10){ ctradd(W,60,1); }
          if(d==11){ ctradd(W,60,1); }
          let rw2:i32=0;
          if(ctr(W,4)>=2){rw2=1;}
          if(ctr(W,8)<0){rw2=1;}
          if(rw2==1){ retire_consec(W,d); }
          else {
            let s2b:i32=discover2(W,KC,ra,d);
            if(s2b==1){
              ctrw(W,24,1); ctrw(W,32,1); ctrw(W,4,0); ctrw(W,8,0);
              emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
              emit(" excabs="); e64(sch(W,16));
              emit(" excobj="); e64(sch(W,20)); emit("\n");
            }
          }
        }
      }
    } else {
      let j:i32=0;
      while(j<4){ learn(W,KC,ra,subj_of(d,j),true_obj(d,j)); j=j+1; }
      let rd:i32=discover(W,KC,ra,d);
      if(rd==1){
        ctradd(W,16,1);
        if(d==12){ ctrw(W,44,1); }
        if(d==12){ ctradd(W,60,1); }
        emit("REDISCOVER rel=1 obj="); e64(sch(W,8)); emit("\n");
      } else {
        let rd2:i32=discover2(W,KC,ra,d);
        if(rd2==1){
          ctrw(W,24,1);
          if(d==15){ ctrw(W,56,1); }
          if(d==15){ ctradd(W,60,1); }
          emit("SCHEMA2_DISC rel=1 default="); e64(sch(W,8));
          emit(" excabs="); e64(sch(W,16));
          emit(" excobj="); e64(sch(W,20)); emit("\n");
        } else {
          emit("DOM "); e64(d); emit(" no-schema learns=4\n");
        }
      }
    }
    d=d+1;
  }
  let ops_p7:i32=ctr(W,0);
  let ops_fresh:i32=0;
  let fd:i32=1;
  while(fd<=15){ ops_fresh=ops_fresh+4; fd=fd+1; }
  emit("OPS_P7 "); e64(ops_p7); emit("\n");
  emit("OPS_FRESH "); e64(ops_fresh); emit("\n");
  emit("FACT_RECORDS "); e64(h_factcount(W)); emit("\n");
  emit("FACT_CONFLICTS "); e64(h_conflicts(W)); emit("\n");
  emit("LEDGER "); e64(ctr(W,8)); emit("\n");
  emit("APPLIES "); e64(ctr(W,20)); emit("\n");
  emit("RETIRED_LEDGER "); e64(ctr(W,12)); emit("\n");
  emit("S2DISC "); e64(ctr(W,24)); emit("\n");
  emit("S2APP "); e64(ctr(W,28)); emit("\n");
  emit("SUPERSEDED "); e64(ctr(W,32)); emit("\n");
  emit("TRANSFER_OK "); e64(ctr(W,36)); emit("\n");
  emit("CONSEC_RET_D11 "); e64(ctr(W,40)); emit("\n");
  emit("REDISCOVER_D12 "); e64(ctr(W,44)); emit("\n");
  emit("APPLY_D13 "); e64(ctr(W,48)); emit("\n");
  emit("LEDGER2_D14 "); e64(ctr(W,52)); emit("\n");
  emit("S2DISC_D15 "); e64(ctr(W,56)); emit("\n");
  emit("SEL_CORRECT "); e64(ctr(W,60)); emit(" / 7\n");
  let k1:i32=0;
  if(ctr(W,36)==1){ if(ctr(W,60)==7){k1=1;} }
  let k2:i32=0;
  if(ctr(W,40)==1){
    if(ctr(W,44)==1){
      if(ctr(W,48)==1){
        if(ctr(W,52)==1){
          if(ctr(W,56)==1){k2=1;}
        }
      }
    }
  }
  let k3a:i32=0;
  if(ctr(W,16)>=1){k3a=1;}
  let k3b:i32=0;
  if(ops_p7<ops_fresh){k3b=1;}
  let k3c:i32=0;
  if(h_factcount(W)==ops_p7){k3c=1;}
  emit("K1 "); e64(k1); emit("\n");
  emit("K2 "); e64(k2); emit("\n");
  emit("K3A "); e64(k3a); emit("\n");
  emit("K3B "); e64(k3b); emit("\n");
  emit("K3C "); e64(k3c); emit("\n");
  if(k1==1){
    if(k2==1){
      if(k3a==1){
        if(k3b==1){
          if(k3c==1){emit("VERDICT INTEGRATION-TESTED\n");}
          else {emit("VERDICT INTEGRATION-BLOCKED-K3C\n");}
        }
        else {emit("VERDICT INTEGRATION-BLOCKED-K3B\n");}
      } else {emit("VERDICT INTEGRATION-BLOCKED-K3A\n");}
    } else {emit("VERDICT INTEGRATION-BLOCKED-K2\n");}
  } else {emit("VERDICT INTEGRATION-BLOCKED-K1\n");}
  emit("LSUB-END\n");
  return 0;
}

// world_ood_d6.zag -- OOD world S-OOD-D6: delay beyond currency.
// Concatenate AFTER the FROZEN f3_revise.zag (unmodified).
// OOD TRUTH (designed in PREREG_REVISE_OOD.md, frozen before this
// file existed):
//   Y(t) = X(t-6).
// The frozen learner's delay currency is dcur=4 (literal inventory
// delays 1..4), so no candidate literal can express this truth.
// Vars: X(0,ctrl), Z(1,ctrl), Y(2). Pulsed (SET writes current
// step only; no persistence).
// Passive: env SETs X at t=3,9. Then Y=1 at t=9 (t=15 is outside
// the 0..11 passive trace).
// Goal context: all zero start. The goal phase must never run: the
// predicted outcome is the honest no-effect-vars stop.
// Goal mode 0: final-state Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ9-iota-beyond"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // OOD truth: Y(t) = X(t-6).
    // Out-of-range reads are 0.
    let xv:i32=0;
    if(t-6>=0){ xv=ws[8+0*32+(t-6)] as i32; }
    ws[8+2*32+t]=xv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: env SETs X at t=3,9. Z never pulsed.
// Y=1 at t=9 only (within the trace).
// Uses world's clock.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==3){ ws[8+0*32+t]=1; }
  if(t==9){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: all zero. Unreached in the predicted outcome.
fn w_goal_setup(ws:[]u8)void {
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness note: OOD evaluator's world. w_verify unused.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("SEALED DONE mask="); e64(m); emit("\n");
  return 0;
}

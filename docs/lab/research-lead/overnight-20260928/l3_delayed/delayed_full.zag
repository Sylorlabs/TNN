// learner_d.zag -- delayed-consequence intermediate-construction learner (L3-DELAYED).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no per-episode outcome bits, no immediate consequence
// in this file. The learner deploys candidates through w_sched (which
// returns NOTHING) and learns their aggregate coin consequences only
// when w_arrive delivers them 3 steps later. A per-step LEDGER maps
// each arriving consequence back to the deployment step that caused
// it: attribution is by schedule step, never by recency.
// The learner calls exactly two world-side symbols: w_sched and
// w_arrive. Prereg: l3_delayed/PREREG.md (frozen commit 759be20f7).
// Pure Zag. 0 modes, 0 cross-structure glue, 0 new semantic cases.
//
// State layout (u8 buffer, offsets):
//   0: XN (train count)  1: XNT (test count)
//   2: CONF (confidence)  3: RETAINED flag
//   4..163:   X train slots, 32 x 5 bytes [id,e0,e1,e2,e3]
//   164..243: X test slots, 16 x 5 bytes [id,e0,e1,e2,e3]
//   244..247: bestC i32 (incumbent consequence)
//   248..279: M slot, 32 bytes [n,u8 gen,u8 sup,u8 pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   280..311: Mprev slot, 32 bytes (same layout; revision history)
//   312..315: STEP i32 (world step counter, learner-owned clock)
//   316..4411:   lg_tag  4096 u8 (job tag per deployment step)
//   4412..8507:  lg_cand 4096 u8 (candidate index per step)
//   8508..12603: lg_thri 4096 u8 (threshold index per step)
//   12604..12635: m0_thr  8 i32   12636..12667: m0_sco  8 i32
//   12668..12699: cur_thr 8 i32   12700..12731: cur_sco 8 i32
//   12732..20411: r_thr  1920 i32 (3 rounds x 80 cand x 8 thr)
//   20412..28091: r_sco  1920 i32
//   28092..28095: m1t_thr i32     28096..28099: m1t_sco i32
//   28100..: scratch
// Job tags: 1=M0FIT 2=R1 3=R2 4=R3 5=CURFIT 6=M1TEST.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer; sequences only) ----
fn x_teach(st:[]u8, region:i32, id:i32, e0:i32, e1:i32, e2:i32, e3:i32)void {
  let base:i32=4;
  let cap:i32=32;
  let cnt:i32=0;
  if(region==0){ cnt=st[0] as i32; }
  else { base=164; cap=16; cnt=st[1] as i32; }
  if(cnt>=cap){return;}
  let o:i32=base+cnt*5;
  st[o]=id as u8; st[o+1]=e0 as u8; st[o+2]=e1 as u8;
  st[o+3]=e2 as u8; st[o+4]=e3 as u8;
  if(region==0){ st[0]=(cnt+1) as u8; } else { st[1]=(cnt+1) as u8; }
  return;
}
fn x_count(st:[]u8, region:i32)i32 {
  if(region==0){return st[0] as i32;}
  return st[1] as i32;
}
fn x_get(st:[]u8, region:i32, idx:i32, out:[]u8)i32 {
  let base:i32=4;
  if(region==1){base=164;}
  let o:i32=base+idx*5;
  out[0]=st[o+1]; out[1]=st[o+2]; out[2]=st[o+3]; out[3]=st[o+4];
  return st[o] as i32;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R3 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, e0:i32, e1:i32, e2:i32, e3:i32, rg:[]u8)i32 {
  set32(rg,0,e0); set32(rg,4,e1); set32(rg,8,e2); set32(rg,12,e3);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
// Program outputs on the taught train episodes (for threshold sweeps).
fn p_outs_train(prog:[]u8, n:i32, st:[]u8, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let ne:i32=st[0] as i32;
  let i:i32=0;
  while(i<ne){
    x_get(st,0,i,sq);
    let v:i32=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
// Sorted ascending unique values.
fn uniq_asc(vals:[]u8, n:i32, uq:[]u8)i32 {
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=get32(vals,i*4);
    let j:i32=0;
    let seen:i32=0;
    while(j<nu){
      if(get32(uq,j*4)==v){seen=1;}
      j=j+1;
    }
    if(seen==0){set32(uq,nu*4,v);nu=nu+1;}
    i=i+1;
  }
  let a:i32=0;
  while(a<nu){
    let b:i32=a+1;
    while(b<nu){
      if(get32(uq,b*4)<get32(uq,a*4)){
        let tmp:i32=get32(uq,a*4);
        set32(uq,a*4,get32(uq,b*4));
        set32(uq,b*4,tmp);
      }
      b=b+1;
    }
    a=a+1;
  }
  return nu;
}

// ---- ledger offset helpers ----
fn lg_thr_off(tag:i32, cand:i32, thri:i32)i32 {
  if(tag==1){return 12604+thri*4;}
  if(tag==5){return 12668+thri*4;}
  if(tag==6){return 28092;}
  let r:i32=tag-2;
  return 12732+(r*80+cand)*32+thri*4;
}
fn lg_sco_off(tag:i32, cand:i32, thri:i32)i32 {
  if(tag==1){return 12636+thri*4;}
  if(tag==5){return 12700+thri*4;}
  if(tag==6){return 28096;}
  let r:i32=tag-2;
  return 20412+(r*80+cand)*32+thri*4;
}

// ---- delayed deployment + attribution ----
// Schedule one deployment at the current step; record it in the
// ledger. Returns the new buffer cursor.
fn l_plan_deploy(st:[]u8, wst:[]u8, step:i32, tag:i32, cand:i32, thri:i32, prog:[]u8, n:i32, thr:i32, region:i32, ob:[]u8, at:i32)i32 {
  st[316+step]=tag as u8;
  st[4412+step]=cand as u8;
  st[8508+step]=thri as u8;
  set32(st,lg_thr_off(tag,cand,thri),thr);
  w_sched(wst,step,prog,n,thr,region);
  at=ob_app(ob,at,"DEPLOY step=");
  at=ob_i32(ob,at,step);
  at=ob_app(ob,at," tag=");
  at=ob_i32(ob,at,tag);
  at=ob_app(ob,at," cand=");
  at=ob_i32(ob,at,cand);
  at=ob_app(ob,at," thri=");
  at=ob_i32(ob,at,thri);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,thr);
  at=ob_app(ob,at," region=");
  at=ob_i32(ob,at,region);
  at=ob_nl(ob,at);
  return at;
}
// Poll the current step for an arriving consequence and attribute it
// to the deployment step that scheduled it (ledger lookup by
// sched_step, never by recency). Returns the new buffer cursor.
fn l_poll(st:[]u8, wst:[]u8, ob:[]u8, at:i32)i32 {
  let step:i32=get32(st,312);
  let ao:[]u8=z_alloc(12);
  let has:i32=w_arrive(wst,step,ao);
  if(has==1){
    let sched:i32=get32(ao,0);
    let c:i32=get32(ao,4);
    let thr:i32=get32(ao,8);
    let tag:i32=st[316+sched] as i32;
    let cand:i32=st[4412+sched] as i32;
    let thri:i32=st[8508+sched] as i32;
    if(tag==0){
      at=ob_app(ob,at,"ATTR-BAD arr=");
      at=ob_i32(ob,at,step);
      at=ob_app(ob,at," sched=");
      at=ob_i32(ob,at,sched);
      at=ob_app(ob,at," no-ledger\n");
    } else {
      let exp:i32=get32(st,lg_thr_off(tag,cand,thri));
      set32(st,lg_sco_off(tag,cand,thri),c);
      if(exp!=thr){
        at=ob_app(ob,at,"ATTR-BAD arr=");
        at=ob_i32(ob,at,step);
        at=ob_app(ob,at," sched=");
        at=ob_i32(ob,at,sched);
        at=ob_app(ob,at," thr-mismatch\n");
      } else {
        at=ob_app(ob,at,"ATTR arr=");
        at=ob_i32(ob,at,step);
        at=ob_app(ob,at," sched=");
        at=ob_i32(ob,at,sched);
        at=ob_app(ob,at," tag=");
        at=ob_i32(ob,at,tag);
        at=ob_app(ob,at," C=");
        at=ob_i32(ob,at,c);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,thr);
        at=ob_nl(ob,at);
      }
    }
  }
  return at;
}
// ---- delayed threshold fit ----
// Deploy (prog,t) for each candidate threshold (sorted unique program
// outputs, ascending), one per step, polling each step; drain N
// steps; first-max over the ATTRIBUTED scores. tout-free variant:
// rout[0]=bestC, rout[4]=bestT. The learner sees only scalar
// consequences, each arriving 3 steps after its deployment.
fn l_dfit(st:[]u8, wst:[]u8, tag:i32, cand:i32, prog:[]u8, n:i32, region:i32, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32, rout:[]u8)i32 {
  let ne:i32=st[0] as i32;
  p_outs_train(prog,n,st,rg,sq,vals);
  let nu:i32=uniq_asc(vals,ne,uq);
  let j:i32=0;
  while(j<nu){set32(st,lg_sco_off(tag,cand,j),-1000000);j=j+1;}
  j=0;
  while(j<nu){
    let t:i32=get32(uq,j*4);
    let step:i32=get32(st,312);
    at=l_poll(st,wst,ob,at);
    at=l_plan_deploy(st,wst,step,tag,cand,j,prog,n,t,region,ob,at);
    set32(st,312,step+1);
    j=j+1;
  }
  let d:i32=0;
  while(d<3){
    let step:i32=get32(st,312);
    at=l_poll(st,wst,ob,at);
    set32(st,312,step+1);
    d=d+1;
  }
  let bc:i32=-1000000;
  let bt:i32=0;
  j=0;
  while(j<nu){
    let c:i32=get32(st,lg_sco_off(tag,cand,j));
    if(c>bc){bc=c;bt=get32(st,lg_thr_off(tag,cand,j));}
    j=j+1;
  }
  set32(rout,0,bc);
  set32(rout,4,bt);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[248]=n as u8; st[249]=gen as u8; st[250]=0; st[251]=0;
  set32(st,252,t);
  let k:i32=0;
  while(k<24){st[256+k]=prog[k];k=k+1;}
  return;
}
fn m_copy_to_prev(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[280+k]=st[248+k];k=k+1;}
  st[282]=1;
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[248+k]=0;k=k+1;}
  return;
}
fn m_prog_get(st:[]u8, out:[]u8)void {
  let k:i32=0;
  while(k<24){out[k]=st[256+k];k=k+1;}
  return;
}
fn m_bytes_equal(st:[]u8, snap:[]u8)i32 {
  // Structural identity only (PREREG.md section 6, K-D3; FORAGE
  // ERRATUM-1 rationale): n, gen, sup, pad, and the 24 program bytes.
  // The threshold field is the adaptive decision parameter and is
  // excluded here.
  let k:i32=0;
  while(k<4){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  k=8;
  while(k<32){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  return 1;
}
fn m_snap(st:[]u8, snap:[]u8)void {
  let k:i32=0;
  while(k<32){snap[k]=st[248+k];k=k+1;}
  return;
}

// ---- confidence policy (generic; no modes) ----
fn l_observe(st:[]u8, c:i32)void {
  let bc:i32=get32(st,244);
  if(c>bc){
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
  }
  return;
}
// Returns 1 if a revision happened, else 0.
fn l_revise(st:[]u8, mbuf:[]u8, n:i32, t:i32, c:i32, ob:[]u8, at:i32, rout:[]u8)i32 {
  let bc:i32=get32(st,244);
  if(c>bc){
    m_copy_to_prev(st);
    let g:i32=(st[249] as i32)+1;
    m_write(st,n,g,t,mbuf);
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
    at=ob_app(ob,at,"REVISE old-C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," new-C=");
    at=ob_i32(ob,at,c);
    at=ob_nl(ob,at);
    set32(rout,0,1);
  } else {
    set32(rout,0,0);
  }
  return at;
}
fn l_deploy_eval(st:[]u8, c:i32)void {
  if(c>0){st[3]=1;} else {st[3]=0;}
  return;
}
fn l_can_decide(st:[]u8)i32 {
  if((st[248] as i32)==0){return 0;}
  return 1;
}

// ---- the experiment: inherit, construct+revise, deploy held-out ----
// All consequence observations arrive 3 steps after deployment and
// are attributed via the ledger. res: [0]=c0 [4]=t0 [8]=n1 [12]=t1
// [16]=c1 [20]=revised [24]=ct [28]=beq.
fn l_experiment(st:[]u8, wst:[]u8, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32, res:[]u8)i32 {
  let rout:[]u8=z_alloc(8);
  // ================= STAGE 0: inherit wrong M0, delayed fit =================
  at=ob_app(ob,at,"=== STAGE 0 inherit (delayed) ===\n");
  let m0:[]u8=z_alloc(24);
  m_prog_get(st,m0);
  let n0:i32=st[248] as i32;
  at=l_dfit(st,wst,1,0,m0,n0,0,rg,sq,vals,uq,ob,at,rout);
  let t0:i32=get32(rout,4);
  let c0:i32=get32(rout,0);
  set32(st,252,t0);
  set32(res,0,c0);
  set32(res,4,t0);
  at=ob_app(ob,at,"M0-FIT t=");
  at=ob_i32(ob,at,t0);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c0);
  at=ob_nl(ob,at);
  l_observe(st,c0);
  at=ob_app(ob,at,"M0-DEPLOY-ATTR C=");
  at=ob_i32(ob,at,c0);
  at=ob_app(ob,at," bestC=");
  at=ob_i32(ob,at,get32(st,244));
  at=ob_app(ob,at," conf=");
  at=ob_i32(ob,at,(st[2] as i32));
  at=ob_nl(ob,at);
  // ================= STAGE 1: construct via delayed consequences =================
  at=ob_app(ob,at,"=== STAGE 1 construct+revise (delayed) ===\n");
  let cur:[]u8=z_alloc(24);
  let cn:i32=0;
  at=l_dfit(st,wst,5,0,cur,cn,0,rg,sq,vals,uq,ob,at,rout);
  let bs:i32=get32(rout,0);
  let bt:i32=get32(rout,4);
  let r:i32=1;
  let go:i32=1;
  while(go==1){
    if(r>3){go=0;}
    else {
      if(cn>=8){go=0;}
      else {
        let bg:i32=0;
        let bop:i32=-1;
        let bd:i32=0;
        let bss:i32=0;
        let wbtk:i32=0;
        let wcsk:i32=0;
        let neval:i32=0;
        let op:i32=0;
        while(op<5){
          let d:i32=0;
          while(d<4){
            let s:i32=0;
            while(s<4){
              let kk:i32=op*16+d*4+s;
              let cand:[]u8=z_alloc(24);
              let j2:i32=0;
              while(j2<cn*3){cand[j2]=cur[j2];j2=j2+1;}
              cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
              at=l_dfit(st,wst,r+1,kk,cand,cn+1,0,rg,sq,vals,uq,ob,at,rout);
              let csk:i32=get32(rout,0);
              let btk:i32=get32(rout,4);
              neval=neval+1;
              let gain:i32=csk-bs;
              if(gain>bg){bg=gain;bop=op;bd=d;bss=s;wbtk=btk;wcsk=csk;}
              s=s+1;
            }
            d=d+1;
          }
          op=op+1;
        }
        at=ob_app(ob,at,"D-ROUND ");
        at=ob_i32(ob,at,r);
        at=ob_app(ob,at," base=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," eval=");
        at=ob_i32(ob,at,neval);
        if(bg>0){
          at=ob_app(ob,at," win=");
          at=ob_i32(ob,at,bop);
          at=ob_app(ob,at,",");
          at=ob_i32(ob,at,bd);
          at=ob_app(ob,at,",");
          at=ob_i32(ob,at,bss);
          at=ob_app(ob,at," gain=");
          at=ob_i32(ob,at,bg);
          cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
          cn=cn+1;
          bs=wcsk;
          bt=wbtk;
          at=ob_app(ob,at," score=");
          at=ob_i32(ob,at,bs);
          at=ob_app(ob,at," t=");
          at=ob_i32(ob,at,bt);
          at=ob_nl(ob,at);
          r=r+1;
        } else {
          at=ob_app(ob,at," stop");
          at=ob_nl(ob,at);
          go=0;
        }
      }
    }
  }
  let mbuf:[]u8=z_alloc(24);
  let k3:i32=0;
  while(k3<24){mbuf[k3]=cur[k3];k3=k3+1;}
  let n1:i32=cn;
  let t1:i32=bt;
  let c1:i32=bs;
  set32(res,8,n1);
  set32(res,12,t1);
  set32(res,16,c1);
  at=ob_app(ob,at,"M1-BUILT n=");
  at=ob_i32(ob,at,n1);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,t1);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c1);
  at=ob_app(ob,at," prog=");
  k3=0;
  while(k3<6){
    at=ob_i32(ob,at,(mbuf[k3] as i32));
    if(k3<5){at=ob_app(ob,at,",");}
    k3=k3+1;
  }
  at=ob_nl(ob,at);
  let rout2:[]u8=z_alloc(4);
  at=l_revise(st,mbuf,n1,t1,c1,ob,at,rout2);
  let revised:i32=get32(rout2,0);
  set32(res,20,revised);
  // ================= STAGE 2: deploy M1 on held-out, delayed =================
  at=ob_app(ob,at,"=== STAGE 2 deploy held-out (delayed) ===\n");
  let snap:[]u8=z_alloc(32);
  m_snap(st,snap);
  let m1:[]u8=z_alloc(24);
  m_prog_get(st,m1);
  let mn1:i32=st[248] as i32;
  let mt1:i32=get32(st,252);
  let step:i32=get32(st,312);
  at=l_poll(st,wst,ob,at);
  at=l_plan_deploy(st,wst,step,6,0,0,m1,mn1,mt1,1,ob,at);
  set32(st,312,step+1);
  let dd:i32=0;
  while(dd<3){
    step=get32(st,312);
    at=l_poll(st,wst,ob,at);
    set32(st,312,step+1);
    dd=dd+1;
  }
  let ct:i32=get32(st,28096);
  l_deploy_eval(st,ct);
  set32(res,24,ct);
  at=ob_app(ob,at,"TEST-DEPLOY C=");
  at=ob_i32(ob,at,ct);
  at=ob_app(ob,at," retained=");
  at=ob_i32(ob,at,(st[3] as i32));
  at=ob_nl(ob,at);
  let beq:i32=m_bytes_equal(st,snap);
  set32(res,28,beq);
  at=ob_app(ob,at,"M-BYTES-EQUAL ");
  at=ob_i32(ob,at,beq);
  at=ob_nl(ob,at);
  return at;
}
// world_d.zag -- SETTLE-D environment (EXPERIMENT SIDE ONLY).
// Same frozen episode tables and hidden margin rule as l3_verify:
// margin(ep) = e0 + e1 - e2. The learner never calls anything in this
// file except w_sched / w_arrive, the DELAYED consequence channel.
// w_sched returns nothing: no consequence is observable at schedule
// time. The consequence of a deployment at step s is computed only
// when w_arrive(s+3) is polled. Delay N=3 is frozen.
// w_conseq is the immediate oracle for EXPERIMENT-SIDE arms and
// sweeps only; the learner must never reference it (K-D1 audit).
// Tables match l3_delayed/PREREG.md section 2 exactly.

// ---- frozen episode tables ----
fn w_val(ph:i32, idx:i32, c:i32)i32 {
  if(ph==1){
    if(idx==0){ if(c==0){return 2;} if(c==1){return 7;} if(c==2){return 3;} return 0; }
    if(idx==1){ if(c==0){return 8;} if(c==1){return 1;} if(c==2){return 4;} return 1; }
    if(idx==2){ if(c==0){return 1;} if(c==1){return 6;} if(c==2){return 3;} return 5; }
    if(idx==3){ if(c==0){return 6;} if(c==1){return 0;} if(c==2){return 3;} return 3; }
    if(idx==4){ if(c==0){return 7;} if(c==1){return 4;} if(c==2){return 15;} return 0; }
    if(idx==5){ if(c==0){return 4;} if(c==1){return 3;} if(c==2){return 10;} return 1; }
    if(idx==6){ if(c==0){return 3;} if(c==1){return 2;} if(c==2){return 7;} return 2; }
    if(c==0){return 3;} if(c==1){return 0;} if(c==2){return 4;} return 3;
  }
  if(idx==0){ if(c==0){return 4;} if(c==1){return 5;} if(c==2){return 2;} return 0; }
  if(idx==1){ if(c==0){return 1;} if(c==1){return 1;} if(c==2){return 5;} return 0; }
  if(idx==2){ if(c==0){return 6;} if(c==1){return 2;} if(c==2){return 3;} return 1; }
  if(c==0){return 2;} if(c==1){return 3;} if(c==2){return 8;} return 2;
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
// Hidden margin (world side only; never passed to the learner).
fn w_margin(ph:i32, idx:i32)i32 {
  return w_val(ph,idx,0)+w_val(ph,idx,1)-w_val(ph,idx,2);
}

// ---- delayed schedule store ----
// World state: 4096 steps x 36 bytes [prog 24B][n i32][thr i32][region i32].
// n = -1 marks an empty slot.
fn w_init()[]u8 {
  let wst:[]u8=z_alloc(147456);
  let s:i32=0;
  while(s<4096){
    set32(wst,s*36+24,-1);
    s=s+1;
  }
  return wst;
}
// Schedule a deployment. Returns nothing; nothing is observable now.
fn w_sched(wst:[]u8, step:i32, prog:[]u8, n:i32, thr:i32, region:i32)void {
  let base:i32=step*36;
  let k:i32=0;
  while(k<24){wst[base+k]=prog[k];k=k+1;}
  set32(wst,base+24,n);
  set32(wst,base+28,thr);
  set32(wst,base+32,region);
  return;
}
// Aggregate coins of one scheduled deployment (shared core).
fn w_coins(wst:[]u8, s:i32)i32 {
  let base:i32=s*36;
  let n:i32=get32(wst,base+24);
  let thr:i32=get32(wst,base+28);
  let region:i32=get32(wst,base+32);
  let ph:i32=region+1;
  let ne:i32=w_n(ph);
  let pb:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){pb[k]=wst[base+k];k=k+1;}
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=p_exec(pb,n,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3),rg);
    if(v>=thr){coins=coins+w_margin(ph,i);}
    i=i+1;
  }
  return coins;
}
// Poll the current step. If a deployment was scheduled at step-3,
// its consequence is computed NOW: out[0]=sched_step, out[4]=coins,
// out[8]=thr. Returns 1 on arrival, else 0.
fn w_arrive(wst:[]u8, step:i32, out:[]u8)i32 {
  if(step<3){return 0;}
  let s:i32=step-3;
  if(s>=4096){return 0;}
  if(get32(wst,s*36+24)<0){return 0;}
  set32(out,0,s);
  set32(out,4,w_coins(wst,s));
  set32(out,8,get32(wst,s*36+28));
  return 1;
}
// Immediate aggregate coins. EXPERIMENT-SIDE ONLY (driver arms and
// the experiment-side uniqueness sweep). Never called by the learner.
fn w_conseq(prog:[]u8, n:i32, thr:i32, region:i32)i32 {
  let ph:i32=region+1;
  let ne:i32=w_n(ph);
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=p_exec(prog,n,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3),rg);
    if(v>=thr){coins=coins+w_margin(ph,i);}
    i=i+1;
  }
  return coins;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}
// driver_d.zag -- L3-DELAYED experiment driver.
// Experiment-side orchestration: teaches X (train+test), seeds the
// inherited wrong M0, creates the world state, runs the learner's
// delayed experiment, evaluates arms (NOM, MENU) via the
// experiment-side immediate oracle w_conseq, runs the experiment-side
// uniqueness sweep, and prints the kill-bar summary.
// The driver never invents the intermediate: all construction goes
// through the learner's delayed l_experiment(). Pure Zag.

fn d_teach(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let region:i32=0;
  if(ph==2){region=1;}
  let i:i32=0;
  while(i<n){
    let id:i32=w_id(ph,i);
    x_teach(st,region,id,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3));
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[248] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[249] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[250] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[256+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_mprev_dump(st:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"MPREV n=");
  at=ob_i32(ob,at,(st[280] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[281] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[282] as i32));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=ob_i32(ob,at,(st[288+k] as i32));
    if(k<5){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side uniqueness sweep: appends after [SUB R0,R2].
// Counts d=0 appends reaching C=18 via the experiment-side immediate
// oracle w_conseq (frozen: exactly 1).
fn d_uniq_append(rg:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32)i32 {
  let cnt:i32=0;
  let op:i32=0;
  while(op<5){
    let s:i32=0;
    while(s<4){
      let cand:[]u8=z_alloc(24);
      cand[0]=2; cand[1]=0; cand[2]=2;
      cand[3]=op as u8; cand[4]=0; cand[5]=s as u8;
      let i:i32=0;
      while(i<8){
        let v:i32=p_exec(cand,2,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3),rg);
        set32(vals,i*4,v);
        i=i+1;
      }
      let nu:i32=uniq_asc(vals,8,uq);
      let bc:i32=-1000000;
      let j:i32=0;
      while(j<nu){
        let t:i32=get32(uq,j*4);
        let c:i32=w_conseq(cand,2,t,0);
        if(c>bc){bc=c;}
        j=j+1;
      }
      if(bc==18){cnt=cnt+1;}
      s=s+1;
    }
    op=op+1;
  }
  at=ob_app(ob,at,"UNIQ-APPEND-18 n=");
  at=ob_i32(ob,at,cnt);
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side menu control evaluation (controls, not learner).
fn d_menu(vals:[]u8, uq:[]u8, ob:[]u8, at:i32, worst:[]u8)i32 {
  let ne:i32=8;
  let k:i32=0;
  while(k<5){
    let i:i32=0;
    while(i<ne){
      set32(vals,i*4,menu_agg(k,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3)));
      i=i+1;
    }
    let nu:i32=uniq_asc(vals,ne,uq);
    let bc:i32=-1000000;
    let bt:i32=0;
    let j:i32=0;
    while(j<nu){
      let t:i32=get32(uq,j*4);
      let c:i32=0;
      i=0;
      while(i<ne){
        if(get32(vals,i*4)>=t){c=c+w_margin(1,i);}
        i=i+1;
      }
      if(c>bc){bc=c;bt=t;}
      j=j+1;
    }
    at=ob_app(ob,at,"MENU ");
    at=ob_app(ob,at,menu_name(k));
    at=ob_app(ob,at," C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,bt);
    at=ob_nl(ob,at);
    if(bc>get32(worst,0)){set32(worst,0,bc);}
    k=k+1;
  }
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let uq:[]u8=z_alloc(64);
  at=ob_app(ob,at,"D-START\n");

  let st:[]u8=z_alloc(65536);
  at=d_teach(st,1,ob,at);
  at=d_teach(st,2,ob,at);
  at=ob_app(ob,at,"X-TRAIN n=");
  at=ob_i32(ob,at,x_count(st,0));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"X-TEST n=");
  at=ob_i32(ob,at,x_count(st,1));
  at=ob_nl(ob,at);
  // M0 = [ADD R0,R2] seeded experiment-side (wrong inheritance).
  let m0:[]u8=z_alloc(24);
  m0[0]=1; m0[1]=0; m0[2]=2;
  m_write(st,1,0,0,m0);
  at=ob_app(ob,at,"M0-SEED prog=1,0,2\n");
  let wst:[]u8=w_init();
  let res:[]u8=z_alloc(32);
  at=l_experiment(st,wst,rg,sq,vals,uq,ob,at,res);
  let c0:i32=get32(res,0);
  let n1:i32=get32(res,8);
  let t1:i32=get32(res,12);
  let c1:i32=get32(res,16);
  let revised:i32=get32(res,20);
  let ct:i32=get32(res,24);
  let beq:i32=get32(res,28);
  at=d_m_dump(st,"M",ob,at);
  at=d_mprev_dump(st,ob,at);
  at=d_uniq_append(rg,vals,uq,ob,at);

  // ================= ARMS =================
  at=ob_app(ob,at,"=== ARMS ===\n");
  let stn:[]u8=z_alloc(65536);
  at=d_teach(stn,1,ob,at);
  m_wipe(stn);
  let nom_c:i32=0;
  if(l_can_decide(stn)==0){nom_c=0;}
  at=ob_app(ob,at,"ARM-NOM C=");
  at=ob_i32(ob,at,nom_c);
  at=ob_nl(ob,at);
  let worst:[]u8=z_alloc(4);
  set32(worst,0,-1000000);
  at=d_menu(vals,uq,ob,at,worst);
  let wmenu:i32=get32(worst,0);

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KBARS ===\n");
  at=ob_app(ob,at,"K-D1 SHELL-AUDIT\n");
  // K-D2: delayed consequence attributed; wrong M revised.
  let kd2:i32=0;
  if(revised==1){ if(n1==2){ if(t1==3){ if(c1==18){ if(c0==8){ kd2=1; } } } } }
  if((st[256] as i32)!=2){kd2=0;}
  if((st[257] as i32)!=0){kd2=0;}
  if((st[258] as i32)!=2){kd2=0;}
  if((st[259] as i32)!=1){kd2=0;}
  if((st[260] as i32)!=0){kd2=0;}
  if((st[261] as i32)!=1){kd2=0;}
  if((st[282] as i32)!=1){kd2=0;}
  if((st[288] as i32)!=1){kd2=0;}
  if((st[289] as i32)!=0){kd2=0;}
  if((st[290] as i32)!=2){kd2=0;}
  at=ob_app(ob,at,"K-D2 ");
  if(kd2==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-D3: delayed test consequence attributed; correct M retained.
  let kd3:i32=0;
  if(ct==12){ if((st[3] as i32)==1){ if(beq==1){ kd3=1; } } }
  at=ob_app(ob,at,"K-D3 ");
  if(kd3==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-D4: necessity.
  let kd4:i32=0;
  if(nom_c==0){ if(wmenu<=9){ kd4=1; } }
  at=ob_app(ob,at,"K-D4 ");
  if(kd4==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  at=ob_app(ob,at,"K-D5 SHELL-3X\n");
  at=ob_app(ob,at,"D-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

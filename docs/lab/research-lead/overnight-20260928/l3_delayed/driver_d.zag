// driver_d.zag -- L3-DELAYED experiment driver.
// Experiment-side orchestration: teaches X (train+test), seeds the
// inherited wrong M0, creates the world state, runs the learner's
// delayed experiment, evaluates arms (NOM, MENU) via the
// experiment-side immediate oracle w_conseq, runs the experiment-side
// uniqueness sweep, and prints the kill-bar summary.
// The driver never invents the intermediate: all construction goes
// through the learner's delayed l_experiment(). Pure Zag.

fn d_teach(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let region:i32=0;
  if(ph==2){region=1;}
  let i:i32=0;
  while(i<n){
    let id:i32=w_id(ph,i);
    x_teach(st,region,id,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3));
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[248] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[249] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[250] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[256+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_mprev_dump(st:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"MPREV n=");
  at=ob_i32(ob,at,(st[280] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[281] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[282] as i32));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=ob_i32(ob,at,(st[288+k] as i32));
    if(k<5){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side uniqueness sweep: appends after [SUB R0,R2].
// Counts d=0 appends reaching C=18 via the experiment-side immediate
// oracle w_conseq (frozen: exactly 1).
fn d_uniq_append(rg:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32)i32 {
  let cnt:i32=0;
  let op:i32=0;
  while(op<5){
    let s:i32=0;
    while(s<4){
      let cand:[]u8=z_alloc(24);
      cand[0]=2; cand[1]=0; cand[2]=2;
      cand[3]=op as u8; cand[4]=0; cand[5]=s as u8;
      let i:i32=0;
      while(i<8){
        let v:i32=p_exec(cand,2,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3),rg);
        set32(vals,i*4,v);
        i=i+1;
      }
      let nu:i32=uniq_asc(vals,8,uq);
      let bc:i32=-1000000;
      let j:i32=0;
      while(j<nu){
        let t:i32=get32(uq,j*4);
        let c:i32=w_conseq(cand,2,t,0);
        if(c>bc){bc=c;}
        j=j+1;
      }
      if(bc==18){cnt=cnt+1;}
      s=s+1;
    }
    op=op+1;
  }
  at=ob_app(ob,at,"UNIQ-APPEND-18 n=");
  at=ob_i32(ob,at,cnt);
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side menu control evaluation (controls, not learner).
fn d_menu(vals:[]u8, uq:[]u8, ob:[]u8, at:i32, worst:[]u8)i32 {
  let ne:i32=8;
  let k:i32=0;
  while(k<5){
    let i:i32=0;
    while(i<ne){
      set32(vals,i*4,menu_agg(k,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3)));
      i=i+1;
    }
    let nu:i32=uniq_asc(vals,ne,uq);
    let bc:i32=-1000000;
    let bt:i32=0;
    let j:i32=0;
    while(j<nu){
      let t:i32=get32(uq,j*4);
      let c:i32=0;
      i=0;
      while(i<ne){
        if(get32(vals,i*4)>=t){c=c+w_margin(1,i);}
        i=i+1;
      }
      if(c>bc){bc=c;bt=t;}
      j=j+1;
    }
    at=ob_app(ob,at,"MENU ");
    at=ob_app(ob,at,menu_name(k));
    at=ob_app(ob,at," C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,bt);
    at=ob_nl(ob,at);
    if(bc>get32(worst,0)){set32(worst,0,bc);}
    k=k+1;
  }
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let uq:[]u8=z_alloc(64);
  at=ob_app(ob,at,"D-START\n");

  let st:[]u8=z_alloc(65536);
  at=d_teach(st,1,ob,at);
  at=d_teach(st,2,ob,at);
  at=ob_app(ob,at,"X-TRAIN n=");
  at=ob_i32(ob,at,x_count(st,0));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"X-TEST n=");
  at=ob_i32(ob,at,x_count(st,1));
  at=ob_nl(ob,at);
  // M0 = [ADD R0,R2] seeded experiment-side (wrong inheritance).
  let m0:[]u8=z_alloc(24);
  m0[0]=1; m0[1]=0; m0[2]=2;
  m_write(st,1,0,0,m0);
  at=ob_app(ob,at,"M0-SEED prog=1,0,2\n");
  let wst:[]u8=w_init();
  let res:[]u8=z_alloc(32);
  at=l_experiment(st,wst,rg,sq,vals,uq,ob,at,res);
  let c0:i32=get32(res,0);
  let n1:i32=get32(res,8);
  let t1:i32=get32(res,12);
  let c1:i32=get32(res,16);
  let revised:i32=get32(res,20);
  let ct:i32=get32(res,24);
  let beq:i32=get32(res,28);
  at=d_m_dump(st,"M",ob,at);
  at=d_mprev_dump(st,ob,at);
  at=d_uniq_append(rg,vals,uq,ob,at);

  // ================= ARMS =================
  at=ob_app(ob,at,"=== ARMS ===\n");
  let stn:[]u8=z_alloc(65536);
  at=d_teach(stn,1,ob,at);
  m_wipe(stn);
  let nom_c:i32=0;
  if(l_can_decide(stn)==0){nom_c=0;}
  at=ob_app(ob,at,"ARM-NOM C=");
  at=ob_i32(ob,at,nom_c);
  at=ob_nl(ob,at);
  let worst:[]u8=z_alloc(4);
  set32(worst,0,-1000000);
  at=d_menu(vals,uq,ob,at,worst);
  let wmenu:i32=get32(worst,0);

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KBARS ===\n");
  at=ob_app(ob,at,"K-D1 SHELL-AUDIT\n");
  // K-D2: delayed consequence attributed; wrong M revised.
  let kd2:i32=0;
  if(revised==1){ if(n1==2){ if(t1==3){ if(c1==18){ if(c0==8){ kd2=1; } } } } }
  if((st[256] as i32)!=2){kd2=0;}
  if((st[257] as i32)!=0){kd2=0;}
  if((st[258] as i32)!=2){kd2=0;}
  if((st[259] as i32)!=1){kd2=0;}
  if((st[260] as i32)!=0){kd2=0;}
  if((st[261] as i32)!=1){kd2=0;}
  if((st[282] as i32)!=1){kd2=0;}
  if((st[288] as i32)!=1){kd2=0;}
  if((st[289] as i32)!=0){kd2=0;}
  if((st[290] as i32)!=2){kd2=0;}
  at=ob_app(ob,at,"K-D2 ");
  if(kd2==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-D3: delayed test consequence attributed; correct M retained.
  let kd3:i32=0;
  if(ct==12){ if((st[3] as i32)==1){ if(beq==1){ kd3=1; } } }
  at=ob_app(ob,at,"K-D3 ");
  if(kd3==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-D4: necessity.
  let kd4:i32=0;
  if(nom_c==0){ if(wmenu<=9){ kd4=1; } }
  at=ob_app(ob,at,"K-D4 ");
  if(kd4==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  at=ob_app(ob,at,"K-D5 SHELL-3X\n");
  at=ob_app(ob,at,"D-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

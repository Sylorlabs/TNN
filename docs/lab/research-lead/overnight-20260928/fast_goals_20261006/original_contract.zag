// cu_full.zag -- CONTRACT-UNIFICATION (C418).
// One learned-contract mechanism with operations induct / check / grow /
// invalidate / revise, tested on two frozen scenarios plus an ablation.
// The unified module is the u_* section below. It takes only integer
// state and integer parameters and never sees a scenario identifier.
// The d_* and g_* harnesses are the experimental apparatus; both call
// the same module functions. No per-scenario branches in the module.
// Pure Zag. Deterministic: fixed data, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ SECTION: generic machinery ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ============ SECTION: unified contract module (u_*) ============
// Contract at cbase: +0 CONTRACT_TY, +1 CONTRACT_SET, +2 NFIELDS,
// +3 NCLAUSES, +4+i*8 clause i: field,xform,k,lo,hi,active,dc,spare.
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
// Judgment table: 300 JT_NF, 301 JT_NA, 302 JT_NR;
// 304+j*7 accepts (len,v0..v5); 528+j*7 rejects (len,v0..v5).
// Counters: 7 C_Q, 900 C_FAIL_RUN, 901 C_REV_REQ, 904 C_REV_COUNT,
// 908 C_FIRST_DETECT_Q, 912 C_CORRECT, 916 C_TOTAL, 920 C_FIT_ERR,
// 924 C_OLDERR_ON_NEW.
// Induct scratch: 1200..1209 best-candidate cells.

fn u_feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==3){return 1;} if(p==5){return 1;}
  if(p==7){return 1;} if(p==9){return 1;}
  return 2;
}
fn u_feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  return 32;
}
fn u_feat_val(v:i32,p:i32)i32 {
  let xf:i32=u_feat_xf(p);
  let k:i32=u_feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn u_fval(f:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(f==0){return f0;}
  if(f==1){return f1;}
  if(f==2){return f2;}
  if(f==3){return f3;}
  if(f==4){return f4;}
  return f5;
}
fn u_acc(S:[]u8,j:i32,f:i32)i32 { return sg(S,304+j*7+1+f); }
fn u_rej(S:[]u8,j:i32,f:i32)i32 { return sg(S,528+j*7+1+f); }
fn u_rejlen(S:[]u8,j:i32)i32 { return sg(S,528+j*7); }

// check: 1 iff nf matches and at least one active clause holds and
// every active clause holds; 0 otherwise (empty active set judges 0).
fn u_check(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let any:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      any=1;
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let lo:i32=sg(S,b+3);
      let hi:i32=sg(S,b+4);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<lo){return 0;}
      if(v>hi){return 0;}
    }
    i=i+1;
  }
  if(any==0){return 0;}
  return 1;
}

// check_all: same but over all committed clauses (ignores active).
fn u_check_all(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

fn u_write_clause(S:[]u8,cbase:i32,i:i32,f:i32,p:i32,mn:i32,mx:i32)void {
  let b:i32=cbase+4+i*8;
  ss(S,b,f); ss(S,b+1,u_feat_xf(p)); ss(S,b+2,u_feat_k(p));
  ss(S,b+3,mn); ss(S,b+4,mx); ss(S,b+5,1); ss(S,b+6,0); ss(S,b+7,0);
  return;
}

// errors of the committed clause set on the judgment table.
fn u_fiterr(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  let err:i32=0;
  let j:i32=0;
  while(j<na){
    if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    if(u_rejlen(S,r)==nf){
      if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
    }
    r=r+1;
  }
  return err;
}

// induct: minimal-commitment search. Increasing cardinality (1, then
// 2); valid = conjunction rejects every in-scope reject (len ==
// nf); among valid sets prefer fewer clauses, then maximal total
// accept-region width (least committal), then lexicographic order.
fn u_induct(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  if(na==0){return 0;}
  if(nf<1){return 0;}
  ss(S,1200,-1); ss(S,1201,-1); ss(S,1202,0); ss(S,1203,0);
  ss(S,1204,-1); ss(S,1205,0);
  ss(S,1206,-1); ss(S,1207,-1); ss(S,1208,0); ss(S,1209,0);
  let f:i32=0;
  while(f<nf){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<na){
        let fv:i32=u_feat_val(u_acc(S,j,f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      let valid:i32=1;
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          let fv2:i32=u_feat_val(u_rej(S,r,f),p);
          if(fv2>=mn){
            if(fv2<=mx){valid=0;}
          }
        }
        r=r+1;
      }
      if(valid==1){
        let w:i32=mx-mn;
        if(w>sg(S,1204)){
          ss(S,1204,w); ss(S,1200,f); ss(S,1201,p);
          ss(S,1202,mn); ss(S,1203,mx); ss(S,1205,1);
        }
      }
      p=p+1;
    }
    f=f+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,1);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  ss(S,1204,-1); ss(S,1205,0);
  let np:i32=nf*11;
  let a:i32=0;
  while(a<np){
    let bb:i32=a+1;
    while(bb<np){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=bb/11; let pb:i32=bb-fb*11;
      let mn0:i32=999999999; let mx0:i32=-999999999;
      let mn1:i32=999999999; let mx1:i32=-999999999;
      let j2:i32=0;
      while(j2<na){
        let v0:i32=u_feat_val(u_acc(S,j2,fa),pa);
        if(v0<mn0){mn0=v0;}
        if(v0>mx0){mx0=v0;}
        let v1:i32=u_feat_val(u_acc(S,j2,fb),pb);
        if(v1<mn1){mn1=v1;}
        if(v1>mx1){mx1=v1;}
        j2=j2+1;
      }
      let valid2:i32=1;
      let r2:i32=0;
      while(r2<nr){
        if(u_rejlen(S,r2)==nf){
          let h0:i32=0;
          let h1:i32=0;
          let w0:i32=u_feat_val(u_rej(S,r2,fa),pa);
          if(w0<mn0){h0=1;}
          if(w0>mx0){h0=1;}
          let w1:i32=u_feat_val(u_rej(S,r2,fb),pb);
          if(w1<mn1){h1=1;}
          if(w1>mx1){h1=1;}
          if(h0==0){
            if(h1==0){valid2=0;}
          }
        }
        r2=r2+1;
      }
      if(valid2==1){
        let wsum:i32=(mx0-mn0)+(mx1-mn1);
        if(wsum>sg(S,1204)){
          ss(S,1204,wsum);
          ss(S,1200,fa); ss(S,1201,pa); ss(S,1202,mn0); ss(S,1203,mx0);
          ss(S,1206,fb); ss(S,1207,pb); ss(S,1208,mn1); ss(S,1209,mx1);
          ss(S,1205,1);
        }
      }
      bb=bb+1;
    }
    a=a+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    u_write_clause(S,cbase,1,sg(S,1206),sg(S,1207),sg(S,1208),sg(S,1209));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,2);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  return 0;
}

// grow: widen each active clause to include the observed success.
fn u_grow(S:[]u8,cbase:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)void {
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<sg(S,b+3)){ ss(S,b+3,v); }
      if(v>sg(S,b+4)){ ss(S,b+4,v); }
    }
    i=i+1;
  }
  return;
}

// invalidate: compare judgment vs consequence. Failure bumps the
// contract fail run and every active clause's disconfirmation
// counter; a clause reaching 2 consecutive disconfirmations is
// retired. Three consecutive failures latch the revision request.
fn u_invalidate(S:[]u8,cbase:i32,judgment:i32,consequence:i32)i32 {
  let ok:i32=0;
  if(judgment==consequence){ok=1;}
  ss(S,916,sg(S,916)+1);
  if(ok==1){ ss(S,912,sg(S,912)+1); }
  if(sg(S,cbase+1)==1){
    if(ok==1){
      ss(S,900,0);
      let n:i32=sg(S,cbase+3);
      let i:i32=0;
      while(i<n){
        let b:i32=cbase+4+i*8;
        if(sg(S,b+5)==1){ ss(S,b+6,0); }
        i=i+1;
      }
    }
    if(ok==0){
      ss(S,900,sg(S,900)+1);
      let n2:i32=sg(S,cbase+3);
      let i2:i32=0;
      while(i2<n2){
        let b2:i32=cbase+4+i2*8;
        if(sg(S,b2+5)==1){
          let dc:i32=sg(S,b2+6)+1;
          ss(S,b2+6,dc);
          if(dc>=2){ ss(S,b2+5,0); }
        }
        i2=i2+1;
      }
      if(sg(S,900)>=3){
        if(sg(S,901)==0){
          ss(S,901,1);
          if(sg(S,908)<0){ ss(S,908,sg(S,7)); }
        }
      }
    }
  }
  return ok;
}

// revise: on a latched request (and enable), score the committed
// clause set on the judgment table, re-induct, count the revision.
fn u_revise(S:[]u8,cbase:i32,enabled:i32)void {
  if(sg(S,901)==1){
    if(enabled==1){
      let nf:i32=sg(S,300);
      let na:i32=sg(S,301);
      let nr:i32=sg(S,302);
      let err:i32=0;
      let j:i32=0;
      while(j<na){
        if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
        j=j+1;
      }
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
        }
        r=r+1;
      }
      ss(S,924,err);
      let ui2:i32=u_induct(S,cbase);
      ss(S,904,sg(S,904)+1);
      let ui2b:i32=ui2;
      ss(S,925,ui2b);
      ss(S,901,0);
      ss(S,900,0);
    }
  }
  return;
}

// ============ SECTION: drift harness (d_*) ============
// Experimental apparatus for the world-law-change scenario. Calls the
// same u_* module functions as the grammar harness. Episodes at
// 8+n*8 (id,s0..s5,label), 32 max. Cell 0 XN, 1 REV_PTR,
// 2 REVISION_ENABLED.

fn d_teach(S:[]u8,id:i32,s0:i32,s1:i32,s2:i32,s3:i32,s4:i32,s5:i32,label:i32)void {
  let n:i32=sg(S,0);
  if(n>=32){return;}
  let o:i32=8+n*8;
  ss(S,o,id); ss(S,o+1,s0); ss(S,o+2,s1); ss(S,o+3,s2);
  ss(S,o+4,s3); ss(S,o+5,s4); ss(S,o+6,s5); ss(S,o+7,label);
  ss(S,0,n+1);
  return;
}
fn d_load_window(S:[]u8)void {
  let n0:i32=sg(S,1);
  let n1:i32=sg(S,0);
  ss(S,300,6); ss(S,301,0); ss(S,302,0);
  let i:i32=n0;
  while(i<n1){
    let o:i32=8+i*8;
    let label:i32=sg(S,o+7);
    if(label==1){
      let a:i32=sg(S,301);
      let b:i32=304+a*7;
      ss(S,b,6);
      ss(S,b+1,sg(S,o+1)); ss(S,b+2,sg(S,o+2)); ss(S,b+3,sg(S,o+3));
      ss(S,b+4,sg(S,o+4)); ss(S,b+5,sg(S,o+5)); ss(S,b+6,sg(S,o+6));
      ss(S,301,a+1);
    }
    if(label==0){
      let r:i32=sg(S,302);
      let b2:i32=528+r*7;
      ss(S,b2,6);
      ss(S,b2+1,sg(S,o+1)); ss(S,b2+2,sg(S,o+2)); ss(S,b2+3,sg(S,o+3));
      ss(S,b2+4,sg(S,o+4)); ss(S,b2+5,sg(S,o+5)); ss(S,b2+6,sg(S,o+6));
      ss(S,302,r+1);
    }
    i=i+1;
  }
  return;
}
fn d_query(S:[]u8,s0:i32,s1:i32,s2:i32,s3:i32,s4:i32,s5:i32,actual:i32)i32 {
  ss(S,7,sg(S,7)+1);
  let pred:i32=u_check(S,800,6,s0,s1,s2,s3,s4,s5);
  let ok:i32=u_invalidate(S,800,pred,actual);
  ss(S,950,pred);
  return ok;
}
fn d_fit(S:[]u8)void {
  d_load_window(S);
  let fi:i32=u_induct(S,800);
  let fib:i32=fi;
  ss(S,926,fib);
  ss(S,1,sg(S,0));
  return;
}
fn d_maybe_revise(S:[]u8)void {
  if(sg(S,901)==1){
    if(sg(S,2)==1){
      d_load_window(S);
      u_revise(S,800,1);
      ss(S,1,sg(S,0));
    }
  }
  return;
}
fn d_clause_line(S:[]u8,OUT:[]u8,cur:i32,tag:[]u8)i32 {
  cur=e1str(OUT,cur,tag);
  cur=e1str(OUT,cur," f=");
  cur=e1i64(OUT,cur,sg(S,804) as i64);
  cur=e1str(OUT,cur," xf=");
  cur=e1i64(OUT,cur,sg(S,805) as i64);
  cur=e1str(OUT,cur," k=");
  cur=e1i64(OUT,cur,sg(S,806) as i64);
  cur=e1str(OUT,cur," lo=");
  cur=e1i64(OUT,cur,sg(S,807) as i64);
  cur=e1str(OUT,cur," hi=");
  cur=e1i64(OUT,cur,sg(S,808) as i64);
  return cur;
}

// Arm D: drift with revision enabled.
fn d_arm(S:[]u8,OUT:[]u8,cur:i32)i32 {
  ss(S,2,1);
  ss(S,908,-1);
  d_teach(S,1,0,0,3,0,0,0,1);
  d_teach(S,2,1,1,0,1,0,0,0);
  d_teach(S,3,0,0,2,0,1,0,1);
  d_teach(S,4,2,3,1,0,0,1,0);
  d_fit(S);
  cur=d_clause_line(S,OUT,cur,"CU-D-FIT0");
  cur=e1str(OUT,cur," ferr=");
  cur=e1i64(OUT,cur,sg(S,920) as i64);
  cur=e1str(OUT,cur,"\n");
  let ok1:i32=0;
  ok1=ok1+d_query(S,0,0,0,0,0,0,0);
  ok1=ok1+d_query(S,1,1,2,0,0,0,1);
  ok1=ok1+d_query(S,0,0,3,1,2,0,1);
  ok1=ok1+d_query(S,2,1,1,0,3,1,0);
  ok1=ok1+d_query(S,0,2,2,0,0,0,1);
  ok1=ok1+d_query(S,3,0,0,0,1,0,0);
  ok1=ok1+d_query(S,1,1,3,0,0,2,1);
  ok1=ok1+d_query(S,0,0,1,2,0,0,0);
  cur=e1str(OUT,cur,"CU-D-PHASE1 ok=");
  cur=e1i64(OUT,cur,ok1 as i64);
  cur=e1str(OUT,cur," n=8 req=");
  cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur,"\n");
  ss(S,7,0); ss(S,900,0);
  let o1:i32=d_query(S,0,0,3,0,0,0,0);
  cur=e1str(OUT,cur,"CU-D-Q1 p=");
  cur=e1i64(OUT,cur,sg(S,950) as i64);
  cur=e1str(OUT,cur," a=0 ok=");
  cur=e1i64(OUT,cur,o1 as i64);
  cur=e1str(OUT,cur," run=");
  cur=e1i64(OUT,cur,sg(S,900) as i64);
  cur=e1str(OUT,cur,"\n");
  let o2:i32=d_query(S,1,1,0,0,3,0,1);
  cur=e1str(OUT,cur,"CU-D-Q2 p=");
  cur=e1i64(OUT,cur,sg(S,950) as i64);
  cur=e1str(OUT,cur," a=1 ok=");
  cur=e1i64(OUT,cur,o2 as i64);
  cur=e1str(OUT,cur," run=");
  cur=e1i64(OUT,cur,sg(S,900) as i64);
  cur=e1str(OUT,cur,"\n");
  let o3:i32=d_query(S,0,0,1,0,2,1,1);
  cur=e1str(OUT,cur,"CU-D-Q3 p=");
  cur=e1i64(OUT,cur,sg(S,950) as i64);
  cur=e1str(OUT,cur," a=1 ok=");
  cur=e1i64(OUT,cur,o3 as i64);
  cur=e1str(OUT,cur," run=");
  cur=e1i64(OUT,cur,sg(S,900) as i64);
  cur=e1str(OUT,cur," req=");
  cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur,"\n");
  d_teach(S,11,0,0,0,0,3,0,1);
  d_teach(S,12,1,0,1,1,0,1,0);
  d_teach(S,13,0,0,0,0,2,0,1);
  d_teach(S,14,0,3,0,0,1,0,0);
  d_maybe_revise(S);
  cur=e1str(OUT,cur,"CU-D-REV olderr=");
  cur=e1i64(OUT,cur,sg(S,924) as i64);
  cur=d_clause_line(S,OUT,cur,"");
  cur=e1str(OUT,cur," rc=");
  cur=e1i64(OUT,cur,sg(S,904) as i64);
  cur=e1str(OUT,cur," ferr=");
  cur=e1i64(OUT,cur,sg(S,920) as i64);
  cur=e1str(OUT,cur,"\n");
  let ok2:i32=0;
  ok2=ok2+d_query(S,2,0,3,1,0,0,0);
  ok2=ok2+d_query(S,0,1,2,0,1,0,0);
  ok2=ok2+d_query(S,1,0,0,0,2,0,1);
  ok2=ok2+d_query(S,0,0,3,0,3,1,1);
  ok2=ok2+d_query(S,2,2,1,1,0,0,0);
  ok2=ok2+d_query(S,0,0,2,0,0,2,0);
  ok2=ok2+d_query(S,1,3,0,2,1,0,0);
  ok2=ok2+d_query(S,0,0,3,0,1,0,0);
  ok2=ok2+d_query(S,0,1,1,1,3,0,1);
  cur=e1str(OUT,cur,"CU-D-PHASE2B ok=");
  cur=e1i64(OUT,cur,ok2 as i64);
  cur=e1str(OUT,cur," n=9\n");
  let ok3:i32=0;
  ok3=ok3+d_query(S,1,0,0,0,3,0,1);
  ok3=ok3+d_query(S,0,2,1,0,0,1,0);
  ok3=ok3+d_query(S,0,0,2,1,2,0,1);
  ok3=ok3+d_query(S,2,0,0,0,1,0,0);
  ok3=ok3+d_query(S,0,3,3,0,0,0,0);
  ok3=ok3+d_query(S,1,1,1,1,3,1,1);
  ok3=ok3+d_query(S,0,0,0,0,2,2,1);
  ok3=ok3+d_query(S,3,2,2,0,0,0,0);
  cur=e1str(OUT,cur,"CU-D-PHASE3 ok=");
  cur=e1i64(OUT,cur,ok3 as i64);
  cur=e1str(OUT,cur," n=8 req=");
  cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// Arm C: drift with revision disabled (control).
fn c_arm(S:[]u8,OUT:[]u8,cur:i32)i32 {
  ss(S,2,0);
  ss(S,908,-1);
  d_teach(S,1,0,0,3,0,0,0,1);
  d_teach(S,2,1,1,0,1,0,0,0);
  d_teach(S,3,0,0,2,0,1,0,1);
  d_teach(S,4,2,3,1,0,0,1,0);
  d_fit(S);
  let ok1:i32=0;
  ok1=ok1+d_query(S,0,0,0,0,0,0,0);
  ok1=ok1+d_query(S,1,1,2,0,0,0,1);
  ok1=ok1+d_query(S,0,0,3,1,2,0,1);
  ok1=ok1+d_query(S,2,1,1,0,3,1,0);
  ok1=ok1+d_query(S,0,2,2,0,0,0,1);
  ok1=ok1+d_query(S,3,0,0,0,1,0,0);
  ok1=ok1+d_query(S,1,1,3,0,0,2,1);
  ok1=ok1+d_query(S,0,0,1,2,0,0,0);
  ss(S,7,0); ss(S,900,0);
  let ok2:i32=0;
  ok2=ok2+d_query(S,0,0,3,0,0,0,0);
  ok2=ok2+d_query(S,1,1,0,0,3,0,1);
  ok2=ok2+d_query(S,0,0,1,0,2,1,1);
  d_maybe_revise(S);
  ok2=ok2+d_query(S,2,0,3,1,0,0,0);
  ok2=ok2+d_query(S,0,1,2,0,1,0,0);
  ok2=ok2+d_query(S,1,0,0,0,2,0,1);
  ok2=ok2+d_query(S,0,0,3,0,3,1,1);
  ok2=ok2+d_query(S,2,2,1,1,0,0,0);
  ok2=ok2+d_query(S,0,0,2,0,0,2,0);
  ok2=ok2+d_query(S,1,3,0,2,1,0,0);
  ok2=ok2+d_query(S,0,0,3,0,1,0,0);
  ok2=ok2+d_query(S,0,1,1,1,3,0,1);
  cur=e1str(OUT,cur,"CU-C-PHASE2 ok=");
  cur=e1i64(OUT,cur,ok2 as i64);
  cur=e1str(OUT,cur," n=12 req=");
  cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur," rc=");
  cur=e1i64(OUT,cur,sg(S,904) as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

// Arm N (drift side): induct and revise disabled. Commitment 0,
// monitor disengaged; counts only.
fn n_query(S:[]u8,actual:i32)i32 {
  ss(S,916,sg(S,916)+1);
  if(actual==0){
    ss(S,912,sg(S,912)+1);
    return 1;
  }
  return 0;
}
fn n_arm_d(S:[]u8,OUT:[]u8,cur:i32)i32 {
  d_teach(S,1,0,0,3,0,0,0,1);
  d_teach(S,2,1,1,0,1,0,0,0);
  d_teach(S,3,0,0,2,0,1,0,1);
  d_teach(S,4,2,3,1,0,0,1,0);
  let ok1:i32=0;
  ok1=ok1+n_query(S,0);
  ok1=ok1+n_query(S,1);
  ok1=ok1+n_query(S,1);
  ok1=ok1+n_query(S,0);
  ok1=ok1+n_query(S,1);
  ok1=ok1+n_query(S,0);
  ok1=ok1+n_query(S,1);
  ok1=ok1+n_query(S,0);
  let ok2:i32=0;
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,1);
  ok2=ok2+n_query(S,1);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,1);
  ok2=ok2+n_query(S,1);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,0);
  ok2=ok2+n_query(S,1);
  cur=e1str(OUT,cur,"CU-N-D set=");
  cur=e1i64(OUT,cur,sg(S,801) as i64);
  cur=e1str(OUT,cur," req=");
  cur=e1i64(OUT,cur,sg(S,901) as i64);
  cur=e1str(OUT,cur," rc=");
  cur=e1i64(OUT,cur,sg(S,904) as i64);
  cur=e1str(OUT,cur," p2=");
  cur=e1i64(OUT,cur,ok2 as i64);
  cur=e1str(OUT,cur,"/12\n");
  return cur;
}

// ============ SECTION: grammar harness (g_*) ============
// Experimental apparatus for the judgment-constrained generation
// scenario. Composer ported from formal_constraints/fc_main.zag with
// u_check as the learner-channel filter. Pool literals at 1300..1303;
// picks: N at 1310..1313, R at 1320..1324, L at 1330..1334;
// candidate buffer at 1340..1343. Researcher registry at 1400
// (nfields, nclauses, 4 clauses of 5 cells).

fn g_acc(G:[]u8,j:i32,f0:i32,f1:i32)void {
  let b:i32=304+j*7;
  ss(G,b,2); ss(G,b+1,f0); ss(G,b+2,f1);
  return;
}
fn g_rej(G:[]u8,j:i32,len:i32,f0:i32,f1:i32,f2:i32)void {
  let b:i32=528+j*7;
  ss(G,b,len); ss(G,b+1,f0); ss(G,b+2,f1); ss(G,b+3,f2);
  return;
}
fn g_teach(G:[]u8)void {
  ss(G,300,2); ss(G,301,6); ss(G,302,6);
  g_acc(G,0,19,87); g_acc(G,1,119,17); g_acc(G,2,51,85);
  g_acc(G,3,23,113); g_acc(G,4,81,55); g_acc(G,5,117,49);
  g_rej(G,0,1,19,0,0); g_rej(G,1,3,19,87,51); g_rej(G,2,2,11,47,0);
  g_rej(G,3,2,35,167,0); g_rej(G,4,2,3,87,0); g_rej(G,5,2,129,51,0);
  return;
}
fn g_researcher(G:[]u8)void {
  ss(G,1400,2); ss(G,1401,4);
  ss(G,1402,0); ss(G,1403,1); ss(G,1404,16); ss(G,1405,1); ss(G,1406,7);
  ss(G,1407,0); ss(G,1408,2); ss(G,1409,16); ss(G,1410,1); ss(G,1411,7);
  ss(G,1412,1); ss(G,1413,1); ss(G,1414,16); ss(G,1415,1); ss(G,1416,7);
  ss(G,1417,1); ss(G,1418,2); ss(G,1419,16); ss(G,1420,1); ss(G,1421,7);
  return;
}
fn g_rcheck(G:[]u8,nf:i32,f0:i32,f1:i32,f2:i32)i32 {
  if(nf!=sg(G,1400)){return 0;}
  let n:i32=sg(G,1401);
  let i:i32=0;
  while(i<n){
    let b:i32=1402+i*5;
    let field:i32=sg(G,b);
    let xf:i32=sg(G,b+1);
    let k:i32=sg(G,b+2);
    let lo:i32=sg(G,b+3);
    let hi:i32=sg(G,b+4);
    let v:i32=f0;
    if(field==1){v=f1;}
    if(field==2){v=f2;}
    if(xf==1){v=v/k;}
    if(xf==2){v=v-(v/k)*k;}
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}
fn g_better(nf:i32,f0:i32,f1:i32,f2:i32,bnf:i32,bf0:i32,bf1:i32,bf2:i32)i32 {
  if(nf<bnf){return 1;} if(nf>bnf){return 0;}
  if(f0<bf0){return 1;} if(f0>bf0){return 0;}
  if(f1<bf1){return 1;} if(f1>bf1){return 0;}
  if(f2<bf2){return 1;}
  return 0;
}
fn g_one(G:[]u8,arm:i32,nf:i32,f0:i32,f1:i32,f2:i32)void {
  ss(G,1340,nf); ss(G,1341,f0); ss(G,1342,f1); ss(G,1343,f2);
  if(arm==0){
    if(g_better(nf,f0,f1,f2,sg(G,1310),sg(G,1311),sg(G,1312),sg(G,1313))==1){
      ss(G,1310,nf); ss(G,1311,f0); ss(G,1312,f1); ss(G,1313,f2);
    }
    return;
  }
  let okf:i32=0;
  if(arm==1){ okf=g_rcheck(G,nf,f0,f1,f2); }
  if(arm==2){ okf=u_check(G,800,nf,f0,f1,f2,0,0,0); }
  if(okf==0){ return; }
  let base:i32=1320;
  let fnd:i32=1324;
  if(arm==2){ base=1330; fnd=1334; }
  if(sg(G,fnd)==0){
    ss(G,fnd,1);
    ss(G,base,nf); ss(G,base+1,f0); ss(G,base+2,f1); ss(G,base+3,f2);
    return;
  }
  if(g_better(nf,f0,f1,f2,sg(G,base),sg(G,base+1),sg(G,base+2),sg(G,base+3))==1){
    ss(G,base,nf); ss(G,base+1,f0); ss(G,base+2,f1); ss(G,base+3,f2);
  }
  return;
}
fn g_j0(i0:i32,i1:i32)i32 {
  if(i0==0){
    if(i1==1){return 2;}
    if(i1==2){return 1;}
    return 1;
  }
  if(i0==1){
    if(i1==2){return 0;}
    return 0;
  }
  return 0;
}
fn g_j1(i0:i32,i1:i32)i32 {
  if(i0==0){
    if(i1==1){return 3;}
    if(i1==2){return 3;}
    return 2;
  }
  if(i0==1){
    if(i1==2){return 3;}
    return 2;
  }
  return 1;
}
fn g_eval(G:[]u8,arm:i32)void {
  let h3:i32=0;
  while(h3<3){
    let h:i32=8;
    if(h3==1){h=16;}
    if(h3==2){h=32;}
    let l0:i32=sg(G,1300); let l1:i32=sg(G,1301);
    let l2:i32=sg(G,1302); let l3:i32=sg(G,1303);
    g_one(G,arm,1,h*l0+l1,0,0);
    let i0:i32=0;
    while(i0<4){
      let i1:i32=i0+1;
      while(i1<4){
        let j0:i32=g_j0(i0,i1);
        let j1:i32=g_j1(i0,i1);
        let s1:i32=0;
        while(s1<2){
          let s2:i32=0;
          while(s2<2){
            let w1a:i32=sg(G,1300+i0); let w1b:i32=sg(G,1300+i1);
            if(s1==1){ w1a=sg(G,1300+i1); w1b=sg(G,1300+i0); }
            let w2a:i32=sg(G,1300+j0); let w2b:i32=sg(G,1300+j1);
            if(s2==1){ w2a=sg(G,1300+j1); w2b=sg(G,1300+j0); }
            g_one(G,arm,2,h*w1a+w1b,h*w2a+w2b,0);
            s2=s2+1;
          }
          s1=s1+1;
        }
        i1=i1+1;
      }
      i0=i0+1;
    }
    g_one(G,arm,3,h*l0+l1,h*l2+l2,h*l3+l3);
    h3=h3+1;
  }
  return;
}
fn g_setpool(G:[]u8,t:i32)void {
  if(t==0){ ss(G,1300,1); ss(G,1301,3); ss(G,1302,5); ss(G,1303,7); return; }
  if(t==1){ ss(G,1300,1); ss(G,1301,1); ss(G,1302,7); ss(G,1303,7); return; }
  if(t==2){ ss(G,1300,3); ss(G,1301,5); ss(G,1302,7); ss(G,1303,1); return; }
  if(t==3){ ss(G,1300,5); ss(G,1301,5); ss(G,1302,5); ss(G,1303,5); return; }
  if(t==4){ ss(G,1300,7); ss(G,1301,3); ss(G,1302,1); ss(G,1303,5); return; }
  ss(G,1300,1); ss(G,1301,7); ss(G,1302,3); ss(G,1303,5);
  return;
}

// Arm G: induct from judgments, compose with the unified contract.
fn g_arm(G:[]u8,OUT:[]u8,cur:i32)i32 {
  g_teach(G);
  let oi:i32=u_induct(G,800);
  cur=e1str(OUT,cur,"CU-G-IND nf=");
  cur=e1i64(OUT,cur,sg(G,802) as i64);
  cur=e1str(OUT,cur," nc=");
  cur=e1i64(OUT,cur,sg(G,803) as i64);
  cur=e1str(OUT,cur," f=");
  cur=e1i64(OUT,cur,sg(G,804) as i64);
  cur=e1str(OUT,cur," xf=");
  cur=e1i64(OUT,cur,sg(G,805) as i64);
  cur=e1str(OUT,cur," k=");
  cur=e1i64(OUT,cur,sg(G,806) as i64);
  cur=e1str(OUT,cur," lo=");
  cur=e1i64(OUT,cur,sg(G,807) as i64);
  cur=e1str(OUT,cur," hi=");
  cur=e1i64(OUT,cur,sg(G,808) as i64);
  cur=e1str(OUT,cur,"\n");
  g_researcher(G);
  let t:i32=0;
  while(t<6){
    g_setpool(G,t);
    ss(G,1310,9999); ss(G,1311,0); ss(G,1312,0); ss(G,1313,0);
    ss(G,1320,9999); ss(G,1321,0); ss(G,1322,0); ss(G,1323,0); ss(G,1324,0);
    ss(G,1330,9999); ss(G,1331,0); ss(G,1332,0); ss(G,1333,0); ss(G,1334,0);
    g_eval(G,0);
    g_eval(G,1);
    g_eval(G,2);
    cur=e1str(OUT,cur,"CU-G-T");
    cur=e1i64(OUT,cur,t as i64);
    cur=e1str(OUT,cur," R=");
    cur=e1i64(OUT,cur,sg(G,1321) as i64);
    cur=e1str(OUT,cur,",");
    cur=e1i64(OUT,cur,sg(G,1322) as i64);
    cur=e1str(OUT,cur," L=");
    cur=e1i64(OUT,cur,sg(G,1331) as i64);
    cur=e1str(OUT,cur,",");
    cur=e1i64(OUT,cur,sg(G,1332) as i64);
    cur=e1str(OUT,cur,"\n");
    t=t+1;
  }
  return cur;
}

// Arm N (grammar side): judgments taught but induct disabled; the
// composer runs blind and never consults the module.
fn n_arm_g(G:[]u8,OUT:[]u8,cur:i32)i32 {
  g_teach(G);
  let t:i32=0;
  while(t<6){
    g_setpool(G,t);
    ss(G,1310,9999); ss(G,1311,0); ss(G,1312,0); ss(G,1313,0);
    g_eval(G,0);
    cur=e1str(OUT,cur,"CU-N-G-T");
    cur=e1i64(OUT,cur,t as i64);
    cur=e1str(OUT,cur," nf=");
    cur=e1i64(OUT,cur,sg(G,1310) as i64);
    cur=e1str(OUT,cur," f0=");
    cur=e1i64(OUT,cur,sg(G,1311) as i64);
    cur=e1str(OUT,cur,"\n");
    t=t+1;
  }
  return cur;
}

// ============ SECTION: driver ============

fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"CU-START\n");
  let S:[]u8=z_alloc(8192);
  cur=d_arm(S,OUT,cur);
  let S2:[]u8=z_alloc(8192);
  cur=c_arm(S2,OUT,cur);
  let G:[]u8=z_alloc(8192);
  cur=g_arm(G,OUT,cur);
  let S3:[]u8=z_alloc(8192);
  cur=n_arm_d(S3,OUT,cur);
  let G2:[]u8=z_alloc(8192);
  cur=n_arm_g(G2,OUT,cur);
  cur=e1str(OUT,cur,"CU-END\n");
  _zag_print(OUT[0..cur]);
  return 0;
}

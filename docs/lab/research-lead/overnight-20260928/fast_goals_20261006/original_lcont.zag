// lcont.zag -- LCONT-1: learned contracts from failure.
//
// The learner starts with one coarse contract kind (kind 0, "value")
// for six structures, fails a novel-family composition because the
// coarse contract filters nothing, refines kinds by observed behavior
// (generic partition refinement over its own probe table plus the
// failed episode replay), and then succeeds with the identical
// selection rule. World B permutes behaviors across ids; the refined
// kinds must track behavior, not ids.
//
// Roles by function boundary:
//   WORLD: world_apply (section-3 arithmetic; called only when the
//     learner executes or probes a structure).
//   LEARNER: learner_probe_all, need_mask, is_cand, cand_count,
//     probe_has, maxprobe, select_outer, select_inner, search_goal,
//     stage_b, stage_d, fill_sig, sigeq, sigeq2, find_match,
//     learner_refine, check_k2, sig_in_other, flagmask, check_k3,
//     print_bar. Values and ids only; never inspects world internals.
//   HARNESS: run_world, main, cell helpers, emit helpers.
// Pitfall discipline: u8-backed cells with little-endian helpers, one
// preallocated output buffer with cursor-returning emit helpers,
// single raw-syscall flush, if-nesting at most 3, no !(A && B) in
// while guards, integer arithmetic only, no ternary, % for parity.

const NSTR:i32=6;
const NPROBE:i32=8;
const SIGLEN:i32=9;

// learner state layout (i32 cells, u8-backed)
const O_OUTK:i32=0;    // 6: out-kind per structure
const O_INK:i32=24;    // 6: in-kind per structure (stays 0 = universal)
const O_SUCCO:i32=48;  // 6: outer-role success evidence
const O_SUCCI:i32=72;  // 6: inner-role success evidence
const O_PROBE:i32=96;  // 48: probe table [s][p]
const O_SIG:i32=288;   // 54: behavioral signature [s][q]
const O_KINDTMP:i32=504; // 6: scratch kind assignment during refine
const O_NEXTK:i32=528; // 1: next fresh kind id
const O_FND:i32=532;   // 2: scratch (found F,G)
const O_PASS:i32=540;  // 5: K0..K4 results
const STSZ:i32=560;

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn cell(b:[]u8, base:i32, i:i32)i32 { return get32(b, base+i*4); }
fn setcell(b:[]u8, base:i32, i:i32, v:i32)void { set32(b, base+i*4, v); return; }
fn cell2(b:[]u8, base:i32, i:i32, j:i32, stride:i32)i32 { return get32(b, base+(i*stride+j)*4); }
fn setcell2(b:[]u8, base:i32, i:i32, j:i32, stride:i32, v:i32)void { set32(b, base+(i*stride+j)*4, v); return; }
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---------- WORLD: structure behaviors (learner sees only ids) ----------
// World A: 0:x+1 1:2x 2:x+10 3:3x 4:x mod 2 5:(x>=5)
// World B: 0:x mod 2 1:(x>=5) 2:x+1 3:2x 4:x+10 5:3x
fn world_apply(w:i32, s:i32, x:i32)i32 {
  if(w==0){
    if(s==0){ return x+1; }
    if(s==1){ return x*2; }
    if(s==2){ return x+10; }
    if(s==3){ return x*3; }
    if(s==4){ return x%2; }
    if(x>=5){ return 1; }
    return 0;
  }
  if(s==0){ return x%2; }
  if(s==1){
    if(x>=5){ return 1; }
    return 0;
  }
  if(s==2){ return x+1; }
  if(s==3){ return x*2; }
  if(s==4){ return x+10; }
  return x*3;
}

// ---------- LEARNER: exploration ----------
fn learner_probe_all(st:[]u8, w:i32)void {
  let s:i32=0;
  while(s<NSTR){
    let p:i32=0;
    while(p<NPROBE){
      setcell2(st,O_PROBE,s,p,NPROBE,world_apply(w,s,p+1));
      p=p+1;
    }
    s=s+1;
  }
  return;
}

// ---------- LEARNER: contract-gated selection ----------
fn need_mask(st:[]u8, ystar:i32)i32 {
  let mask:i32=0;
  let s:i32=0;
  while(s<NSTR){
    let hit:i32=0;
    let p:i32=0;
    while(p<NPROBE){
      if(cell2(st,O_PROBE,s,p,NPROBE)==ystar){ hit=1; }
      p=p+1;
    }
    if(hit==1){
      let k:i32=cell(st,O_OUTK,s);
      if(((mask>>k)%2)==0){ mask=mask+(1<<k); }
    }
    s=s+1;
  }
  return mask;
}
fn is_cand(st:[]u8, s:i32, mask:i32)i32 {
  let okk:i32=cell(st,O_OUTK,s);
  if(okk==0){ return 1; }
  if(((mask>>okk)%2)==1){ return 1; }
  return 0;
}
fn cand_count(st:[]u8, mask:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<NSTR){
    if(is_cand(st,s,mask)==1){ c=c+1; }
    s=s+1;
  }
  return c;
}
fn probe_has(st:[]u8, s:i32, ystar:i32)i32 {
  let p:i32=0;
  while(p<NPROBE){
    if(cell2(st,O_PROBE,s,p,NPROBE)==ystar){ return 1; }
    p=p+1;
  }
  return 0;
}
fn maxprobe(st:[]u8, s:i32)i32 {
  let m:i32=0;
  let p:i32=0;
  while(p<NPROBE){
    let v:i32=cell2(st,O_PROBE,s,p,NPROBE);
    if(v>m){ m=v; }
    p=p+1;
  }
  return m;
}
fn select_outer(st:[]u8, mask:i32)i32 {
  let best:i32=-1;
  let bestev:i32=-1;
  let s:i32=0;
  while(s<NSTR){
    let take:i32=0;
    if(is_cand(st,s,mask)==1){
      let ev:i32=cell(st,O_SUCCO,s);
      if(best==-1){ take=1; }
      else {
        if(ev>bestev){ take=1; }
      }
    }
    if(take==1){ best=s; bestev=cell(st,O_SUCCO,s); }
    s=s+1;
  }
  return best;
}
fn select_inner(st:[]u8)i32 {
  let best:i32=-1;
  let bestev:i32=-1;
  let s:i32=0;
  while(s<NSTR){
    let ev:i32=cell(st,O_SUCCI,s);
    let take:i32=0;
    if(best==-1){ take=1; }
    else {
      if(ev>bestev){ take=1; }
    }
    if(take==1){ best=s; bestev=ev; }
    s=s+1;
  }
  return best;
}

// ---------- LEARNER: stage A (prior experience by search) ----------
fn search_goal(ob:[]u8, at:i32, st:[]u8, w:i32, gx:i32, gy:i32)i32 {
  let f:i32=0;
  while(f<NSTR){
    let g:i32=0;
    while(g<NSTR){
      let y:i32=world_apply(w,f,world_apply(w,g,gx));
      if(y==gy){
        setcell(st,O_SUCCO,f,cell(st,O_SUCCO,f)+1);
        setcell(st,O_SUCCI,g,cell(st,O_SUCCI,g)+1);
        at=ob_app(ob,at,"A x="); at=ob_i32(ob,at,gx);
        at=ob_app(ob,at," y*="); at=ob_i32(ob,at,gy);
        at=ob_app(ob,at," F="); at=ob_i32(ob,at,f);
        at=ob_app(ob,at," G="); at=ob_i32(ob,at,g);
        at=ob_app(ob,at," y="); at=ob_i32(ob,at,y);
        at=ob_app(ob,at," OK\n");
        return at;
      }
      g=g+1;
    }
    f=f+1;
  }
  at=ob_app(ob,at,"A-SEARCH-FAIL\n");
  return at;
}

// ---------- LEARNER: stage B (commit under coarse contract) ----------
fn stage_b(ob:[]u8, at:i32, st:[]u8, w:i32)i32 {
  let mask:i32=need_mask(st,0);
  let cnt:i32=cand_count(st,mask);
  let f:i32=select_outer(st,mask);
  let g:i32=select_inner(st);
  let y:i32=-999;
  let fail:i32=1;
  let okpair:i32=0;
  if(f>=0){
    if(g>=0){ okpair=1; }
  }
  if(okpair==1){
    y=world_apply(w,f,world_apply(w,g,7));
    if(y==0){ fail=0; }
  }
  at=ob_app(ob,at,"B x=7 y*=0 cand="); at=ob_i32(ob,at,cnt);
  at=ob_app(ob,at," F="); at=ob_i32(ob,at,f);
  at=ob_app(ob,at," G="); at=ob_i32(ob,at,g);
  at=ob_app(ob,at," y="); at=ob_i32(ob,at,y);
  if(fail==1){ at=ob_app(ob,at," FAIL\n"); } else { at=ob_app(ob,at," UNEXPECTED-OK\n"); }
  let k0:i32=0;
  if(cnt==NSTR){
    if(probe_has(st,f,0)==0){ k0=1; }
  }
  setcell(st,O_PASS,0,k0);
  setcell(st,O_PASS,1,fail);
  setcell(st,O_FND,0,f);
  setcell(st,O_FND,1,g);
  return at;
}

// ---------- LEARNER: generic partition refinement ----------
fn fill_sig(st:[]u8, w:i32, s:i32, v:i32)void {
  let p:i32=0;
  while(p<NPROBE){
    setcell2(st,O_SIG,s,p,SIGLEN,cell2(st,O_PROBE,s,p,NPROBE));
    p=p+1;
  }
  setcell2(st,O_SIG,s,NPROBE,SIGLEN,world_apply(w,s,v));
  return;
}
fn sigeq(st:[]u8, a:i32, b:i32)i32 {
  let q:i32=0;
  while(q<SIGLEN){
    if(cell2(st,O_SIG,a,q,SIGLEN)!=cell2(st,O_SIG,b,q,SIGLEN)){ return 0; }
    q=q+1;
  }
  return 1;
}
fn find_match(st:[]u8, s:i32, k:i32)i32 {
  let t:i32=0;
  while(t<s){
    let okt:i32=0;
    if(cell(st,O_OUTK,t)==k){
      if(cell(st,O_KINDTMP,t)>=0){ okt=1; }
    }
    if(okt==1){
      if(sigeq(st,s,t)==1){ return cell(st,O_KINDTMP,t); }
    }
    t=t+1;
  }
  return -1;
}
fn learner_refine(ob:[]u8, at:i32, st:[]u8, w:i32, fx:i32)i32 {
  let fbf:i32=cell(st,O_FND,0);
  let gbf:i32=cell(st,O_FND,1);
  let v:i32=world_apply(w,gbf,fx);
  let k:i32=cell(st,O_OUTK,fbf);
  at=ob_app(ob,at,"REFINE v="); at=ob_i32(ob,at,v); at=ob_nl(ob,at);
  let s:i32=0;
  while(s<NSTR){
    if(cell(st,O_OUTK,s)==k){
      fill_sig(st,w,s,v);
      setcell(st,O_KINDTMP,s,-1);
    }
    s=s+1;
  }
  let nextk:i32=cell(st,O_NEXTK,0);
  s=0;
  while(s<NSTR){
    if(cell(st,O_OUTK,s)==k){
      let f:i32=find_match(st,s,k);
      if(f<0){ f=nextk; nextk=nextk+1; }
      setcell(st,O_KINDTMP,s,f);
    }
    s=s+1;
  }
  s=0;
  while(s<NSTR){
    if(cell(st,O_OUTK,s)==k){
      let nk:i32=cell(st,O_KINDTMP,s);
      setcell(st,O_OUTK,s,nk);
      at=ob_app(ob,at,"SIG s="); at=ob_i32(ob,at,s);
      at=ob_app(ob,at," k="); at=ob_i32(ob,at,nk);
      at=ob_app(ob,at,":");
      let q:i32=0;
      while(q<SIGLEN){
        at=ob_app(ob,at," ");
        at=ob_i32(ob,at,cell2(st,O_SIG,s,q,SIGLEN));
        q=q+1;
      }
      at=ob_nl(ob,at);
    }
    s=s+1;
  }
  setcell(st,O_NEXTK,0,nextk);
  return at;
}

// ---------- LEARNER: K2 check (refinement outcome, behavioral) ----------
fn pair_sep_ok(st:[]u8, a:i32, b:i32)i32 {
  let fa:i32=0;
  let fb:i32=0;
  if(maxprobe(st,a)<=1){ fa=1; }
  if(maxprobe(st,b)<=1){ fb=1; }
  if(fa==fb){ return 1; }
  if(cell(st,O_OUTK,a)!=cell(st,O_OUTK,b)){ return 1; }
  return 0;
}
fn check_k2(ob:[]u8, at:i32, st:[]u8)i32 {
  let nd:i32=0;
  let s:i32=0;
  while(s<NSTR){
    let seen:i32=0;
    let t:i32=0;
    while(t<s){
      if(cell(st,O_OUTK,t)==cell(st,O_OUTK,s)){ seen=1; }
      t=t+1;
    }
    if(seen==0){ nd=nd+1; }
    s=s+1;
  }
  let sep:i32=1;
  let a:i32=0;
  while(a<NSTR){
    let b:i32=0;
    while(b<NSTR){
      if(pair_sep_ok(st,a,b)==0){ sep=0; }
      b=b+1;
    }
    a=a+1;
  }
  let k2:i32=0;
  if(nd==NSTR){
    if(sep==1){ k2=1; }
  }
  setcell(st,O_PASS,2,k2);
  at=ob_app(ob,at,"K2 kinds="); at=ob_i32(ob,at,nd);
  at=ob_app(ob,at," sep="); at=ob_i32(ob,at,sep);
  if(k2==1){ at=ob_app(ob,at," PASS\n"); } else { at=ob_app(ob,at," FAIL\n"); }
  return at;
}

// ---------- LEARNER: stage D (same selection rule, refined contracts) ----------
fn stage_d(ob:[]u8, at:i32, st:[]u8, w:i32)i32 {
  let ok3:i32=0;
  let di:i32=0;
  while(di<3){
    let gx:i32=7;
    let gy:i32=0;
    if(di==1){ gx=2; }
    if(di==2){ gx=4; gy=18; }
    let mask:i32=need_mask(st,gy);
    let f:i32=select_outer(st,mask);
    let g:i32=select_inner(st);
    let y:i32=-999;
    let ok:i32=0;
    let both:i32=0;
    if(f>=0){
      if(g>=0){ both=1; }
    }
    if(both==1){
      y=world_apply(w,f,world_apply(w,g,gx));
      if(y==gy){ ok=1; }
    }
    at=ob_app(ob,at,"D x="); at=ob_i32(ob,at,gx);
    at=ob_app(ob,at," y*="); at=ob_i32(ob,at,gy);
    at=ob_app(ob,at," F="); at=ob_i32(ob,at,f);
    at=ob_app(ob,at," G="); at=ob_i32(ob,at,g);
    at=ob_app(ob,at," y="); at=ob_i32(ob,at,y);
    if(ok==1){ at=ob_app(ob,at," OK\n"); ok3=ok3+1; } else { at=ob_app(ob,at," FAIL\n"); }
    di=di+1;
  }
  let k4:i32=0;
  if(ok3==3){ k4=1; }
  setcell(st,O_PASS,4,k4);
  return at;
}

// ---------- LEARNER: K3 permutation control (across worlds) ----------
fn sigeq2(stx:[]u8, sty:[]u8, a:i32, b:i32)i32 {
  let q:i32=0;
  while(q<SIGLEN){
    if(cell2(stx,O_SIG,a,q,SIGLEN)!=cell2(sty,O_SIG,b,q,SIGLEN)){ return 0; }
    q=q+1;
  }
  return 1;
}
fn sig_in_other(stx:[]u8, sty:[]u8, s:i32)i32 {
  let t:i32=0;
  while(t<NSTR){
    if(sigeq2(stx,sty,s,t)==1){ return 1; }
    t=t+1;
  }
  return 0;
}
fn flagmask(st:[]u8)i32 {
  let m:i32=0;
  let s:i32=0;
  while(s<NSTR){
    if(maxprobe(st,s)<=1){ m=m+(1<<s); }
    s=s+1;
  }
  return m;
}
fn check_k3(ob:[]u8, at:i32, st0:[]u8, st1:[]u8)i32 {
  let meq:i32=1;
  let s:i32=0;
  while(s<NSTR){
    if(sig_in_other(st1,st0,s)==0){ meq=0; }
    s=s+1;
  }
  let sdiff:i32=0;
  if(flagmask(st0)!=flagmask(st1)){ sdiff=1; }
  let k3:i32=0;
  if(meq==1){
    if(sdiff==1){ k3=1; }
  }
  setcell(st1,O_PASS,3,k3);
  at=ob_app(ob,at,"K3 sigmultiset="); at=ob_i32(ob,at,meq);
  at=ob_app(ob,at," idsetdiff="); at=ob_i32(ob,at,sdiff);
  if(k3==1){ at=ob_app(ob,at," PASS\n"); } else { at=ob_app(ob,at," FAIL\n"); }
  return at;
}
fn print_bar(ob:[]u8, at:i32, name:[]u8, ok:i32)i32 {
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," ");
  if(ok==1){ at=ob_app(ob,at,"PASS\n"); } else { at=ob_app(ob,at,"FAIL\n"); }
  return at;
}

// ---------- HARNESS: staged protocol for one world ----------
fn run_world(ob:[]u8, at:i32, st:[]u8, w:i32)i32 {
  let s:i32=0;
  while(s<NSTR){
    setcell(st,O_OUTK,s,0);
    setcell(st,O_INK,s,0);
    setcell(st,O_SUCCO,s,0);
    setcell(st,O_SUCCI,s,0);
    s=s+1;
  }
  setcell(st,O_NEXTK,0,1);
  let pi:i32=0;
  while(pi<5){
    setcell(st,O_PASS,pi,0);
    pi=pi+1;
  }
  at=ob_app(ob,at,"WORLD "); at=ob_i32(ob,at,w); at=ob_nl(ob,at);
  at=ob_app(ob,at,"CONTRACTS-INIT all-kind-0\n");
  learner_probe_all(st,w);
  s=0;
  while(s<NSTR){
    at=ob_app(ob,at,"P s="); at=ob_i32(ob,at,s); at=ob_app(ob,at,":");
    let p:i32=0;
    while(p<NPROBE){
      at=ob_app(ob,at," ");
      at=ob_i32(ob,at,cell2(st,O_PROBE,s,p,NPROBE));
      p=p+1;
    }
    at=ob_nl(ob,at);
    s=s+1;
  }
  at=ob_app(ob,at,"STAGE-A\n");
  at=search_goal(ob,at,st,w,2,14);
  at=search_goal(ob,at,st,w,3,12);
  at=search_goal(ob,at,st,w,5,30);
  at=ob_app(ob,at,"EVID succO:");
  s=0;
  while(s<NSTR){ at=ob_app(ob,at," "); at=ob_i32(ob,at,cell(st,O_SUCCO,s)); s=s+1; }
  at=ob_app(ob,at," succI:");
  s=0;
  while(s<NSTR){ at=ob_app(ob,at," "); at=ob_i32(ob,at,cell(st,O_SUCCI,s)); s=s+1; }
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"STAGE-B\n");
  at=stage_b(ob,at,st,w);
  at=print_bar(ob,at,"K0",cell(st,O_PASS,0));
  at=print_bar(ob,at,"K1",cell(st,O_PASS,1));
  at=ob_app(ob,at,"STAGE-C\n");
  at=learner_refine(ob,at,st,w,7);
  at=check_k2(ob,at,st);
  at=ob_app(ob,at,"STAGE-D\n");
  at=stage_d(ob,at,st,w);
  at=print_bar(ob,at,"K4",cell(st,O_PASS,4));
  return at;
}

// ---------- HARNESS: main ----------
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"LCONT-1 LEARNED CONTRACTS\n");
  let st0:[]u8=z_alloc(1024);
  at=run_world(ob,at,st0,0);
  let st1:[]u8=z_alloc(1024);
  at=run_world(ob,at,st1,1);
  at=check_k3(ob,at,st0,st1);
  let all:i32=1;
  if(cell(st0,O_PASS,0)==0){ all=0; }
  if(cell(st0,O_PASS,1)==0){ all=0; }
  if(cell(st0,O_PASS,2)==0){ all=0; }
  if(cell(st0,O_PASS,4)==0){ all=0; }
  if(cell(st1,O_PASS,0)==0){ all=0; }
  if(cell(st1,O_PASS,1)==0){ all=0; }
  if(cell(st1,O_PASS,2)==0){ all=0; }
  if(cell(st1,O_PASS,3)==0){ all=0; }
  if(cell(st1,O_PASS,4)==0){ all=0; }
  at=ob_app(ob,at,"BARS ");
  at=ob_app(ob,at,"K0a="); at=ob_i32(ob,at,cell(st0,O_PASS,0));
  at=ob_app(ob,at," K1a="); at=ob_i32(ob,at,cell(st0,O_PASS,1));
  at=ob_app(ob,at," K2a="); at=ob_i32(ob,at,cell(st0,O_PASS,2));
  at=ob_app(ob,at," K4a="); at=ob_i32(ob,at,cell(st0,O_PASS,4));
  at=ob_app(ob,at," K0b="); at=ob_i32(ob,at,cell(st1,O_PASS,0));
  at=ob_app(ob,at," K1b="); at=ob_i32(ob,at,cell(st1,O_PASS,1));
  at=ob_app(ob,at," K2b="); at=ob_i32(ob,at,cell(st1,O_PASS,2));
  at=ob_app(ob,at," K3="); at=ob_i32(ob,at,cell(st1,O_PASS,3));
  at=ob_app(ob,at," K4b="); at=ob_i32(ob,at,cell(st1,O_PASS,4));
  at=ob_nl(ob,at);
  if(all==1){
    at=ob_app(ob,at,"LCONT-1-BUILD-PASS\n");
  } else {
    at=ob_app(ob,at,"LCONT-1-BUILD-FAIL\n");
  }
  at=ob_app(ob,at,"LCONT-END\n");
  _zag_print(ob[0..at]);
  if(all!=1){return 1;}
  return 0;
}

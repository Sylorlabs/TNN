// cu_full.zag -- CONTRACT-UNIFICATION (C418).
// One learned-contract mechanism with operations induct / check / grow /
// invalidate / revise, tested on two frozen scenarios plus an ablation.
// The unified module is the u_* section below. It takes only integer
// state and integer parameters and never sees a scenario identifier.
// The d_* and g_* harnesses are the experimental apparatus; both call
// the same module functions. No per-scenario branches in the module.
// Pure Zag. Deterministic: fixed data, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ SECTION: generic machinery ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ============ SECTION: unified contract module (u_*) ============
// Contract at cbase: +0 CONTRACT_TY, +1 CONTRACT_SET, +2 NFIELDS,
// +3 NCLAUSES, +4+i*8 clause i: field,xform,k,lo,hi,active,dc,spare.
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
// Judgment table: 300 JT_NF, 301 JT_NA, 302 JT_NR;
// 304+j*7 accepts (len,v0..v5); 528+j*7 rejects (len,v0..v5).
// Counters: 7 C_Q, 900 C_FAIL_RUN, 901 C_REV_REQ, 904 C_REV_COUNT,
// 908 C_FIRST_DETECT_Q, 912 C_CORRECT, 916 C_TOTAL, 920 C_FIT_ERR,
// 924 C_OLDERR_ON_NEW.
// Induct scratch: 1200..1209 best-candidate cells.

fn u_feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==3){return 1;} if(p==5){return 1;}
  if(p==7){return 1;} if(p==9){return 1;}
  return 2;
}
fn u_feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  return 32;
}
fn u_feat_val(v:i32,p:i32)i32 {
  let xf:i32=u_feat_xf(p);
  let k:i32=u_feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn u_fval(f:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(f==0){return f0;}
  if(f==1){return f1;}
  if(f==2){return f2;}
  if(f==3){return f3;}
  if(f==4){return f4;}
  return f5;
}
fn u_acc(S:[]u8,j:i32,f:i32)i32 { return sg(S,304+j*7+1+f); }
fn u_rej(S:[]u8,j:i32,f:i32)i32 { return sg(S,528+j*7+1+f); }
fn u_rejlen(S:[]u8,j:i32)i32 { return sg(S,528+j*7); }

// check: 1 iff nf matches and at least one active clause holds and
// every active clause holds; 0 otherwise (empty active set judges 0).
fn u_check(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let any:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      any=1;
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let lo:i32=sg(S,b+3);
      let hi:i32=sg(S,b+4);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<lo){return 0;}
      if(v>hi){return 0;}
    }
    i=i+1;
  }
  if(any==0){return 0;}
  return 1;
}

// check_all: same but over all committed clauses (ignores active).
fn u_check_all(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

fn u_write_clause(S:[]u8,cbase:i32,i:i32,f:i32,p:i32,mn:i32,mx:i32)void {
  let b:i32=cbase+4+i*8;
  ss(S,b,f); ss(S,b+1,u_feat_xf(p)); ss(S,b+2,u_feat_k(p));
  ss(S,b+3,mn); ss(S,b+4,mx); ss(S,b+5,1); ss(S,b+6,0); ss(S,b+7,0);
  return;
}

// errors of the committed clause set on the judgment table.
fn u_fiterr(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  let err:i32=0;
  let j:i32=0;
  while(j<na){
    if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    if(u_rejlen(S,r)==nf){
      if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
    }
    r=r+1;
  }
  return err;
}

// induct: minimal-commitment search. Increasing cardinality (1, then
// 2); valid = conjunction rejects every in-scope reject (len ==
// nf); among valid sets prefer fewer clauses, then maximal total
// accept-region width (least committal), then lexicographic order.
fn u_induct(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  if(na==0){return 0;}
  if(nf<1){return 0;}
  ss(S,1200,-1); ss(S,1201,-1); ss(S,1202,0); ss(S,1203,0);
  ss(S,1204,-1); ss(S,1205,0);
  ss(S,1206,-1); ss(S,1207,-1); ss(S,1208,0); ss(S,1209,0);
  let f:i32=0;
  while(f<nf){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<na){
        let fv:i32=u_feat_val(u_acc(S,j,f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      let valid:i32=1;
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          let fv2:i32=u_feat_val(u_rej(S,r,f),p);
          if(fv2>=mn){
            if(fv2<=mx){valid=0;}
          }
        }
        r=r+1;
      }
      if(valid==1){
        let w:i32=mx-mn;
        if(w>sg(S,1204)){
          ss(S,1204,w); ss(S,1200,f); ss(S,1201,p);
          ss(S,1202,mn); ss(S,1203,mx); ss(S,1205,1);
        }
      }
      p=p+1;
    }
    f=f+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,1);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  ss(S,1204,-1); ss(S,1205,0);
  let np:i32=nf*11;
  let a:i32=0;
  while(a<np){
    let bb:i32=a+1;
    while(bb<np){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=bb/11; let pb:i32=bb-fb*11;
      let mn0:i32=999999999; let mx0:i32=-999999999;
      let mn1:i32=999999999; let mx1:i32=-999999999;
      let j2:i32=0;
      while(j2<na){
        let v0:i32=u_feat_val(u_acc(S,j2,fa),pa);
        if(v0<mn0){mn0=v0;}
        if(v0>mx0){mx0=v0;}
        let v1:i32=u_feat_val(u_acc(S,j2,fb),pb);
        if(v1<mn1){mn1=v1;}
        if(v1>mx1){mx1=v1;}
        j2=j2+1;
      }
      let valid2:i32=1;
      let r2:i32=0;
      while(r2<nr){
        if(u_rejlen(S,r2)==nf){
          let h0:i32=0;
          let h1:i32=0;
          let w0:i32=u_feat_val(u_rej(S,r2,fa),pa);
          if(w0<mn0){h0=1;}
          if(w0>mx0){h0=1;}
          let w1:i32=u_feat_val(u_rej(S,r2,fb),pb);
          if(w1<mn1){h1=1;}
          if(w1>mx1){h1=1;}
          if(h0==0){
            if(h1==0){valid2=0;}
          }
        }
        r2=r2+1;
      }
      if(valid2==1){
        let wsum:i32=(mx0-mn0)+(mx1-mn1);
        if(wsum>sg(S,1204)){
          ss(S,1204,wsum);
          ss(S,1200,fa); ss(S,1201,pa); ss(S,1202,mn0); ss(S,1203,mx0);
          ss(S,1206,fb); ss(S,1207,pb); ss(S,1208,mn1); ss(S,1209,mx1);
          ss(S,1205,1);
        }
      }
      bb=bb+1;
    }
    a=a+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    u_write_clause(S,cbase,1,sg(S,1206),sg(S,1207),sg(S,1208),sg(S,1209));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,2);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  return 0;
}

// grow: widen each active clause to include the observed success.
fn u_grow(S:[]u8,cbase:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)void {
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<sg(S,b+3)){ ss(S,b+3,v); }
      if(v>sg(S,b+4)){ ss(S,b+4,v); }
    }
    i=i+1;
  }
  return;
}

// invalidate: compare judgment vs consequence. Failure bumps the
// contract fail run and every active clause's disconfirmation
// counter; a clause reaching 2 consecutive disconfirmations is
// retired. Three consecutive failures latch the revision request.
fn u_invalidate(S:[]u8,cbase:i32,judgment:i32,consequence:i32)i32 {
  let ok:i32=0;
  if(judgment==consequence){ok=1;}
  ss(S,916,sg(S,916)+1);
  if(ok==1){ ss(S,912,sg(S,912)+1); }
  if(sg(S,cbase+1)==1){
    if(ok==1){
      ss(S,900,0);
      let n:i32=sg(S,cbase+3);
      let i:i32=0;
      while(i<n){
        let b:i32=cbase+4+i*8;
        if(sg(S,b+5)==1){ ss(S,b+6,0); }
        i=i+1;
      }
    }
    if(ok==0){
      ss(S,900,sg(S,900)+1);
      let n2:i32=sg(S,cbase+3);
      let i2:i32=0;
      while(i2<n2){
        let b2:i32=cbase+4+i2*8;
        if(sg(S,b2+5)==1){
          let dc:i32=sg(S,b2+6)+1;
          ss(S,b2+6,dc);
          if(dc>=2){ ss(S,b2+5,0); }
        }
        i2=i2+1;
      }
      if(sg(S,900)>=3){
        if(sg(S,901)==0){
          ss(S,901,1);
          if(sg(S,908)<0){ ss(S,908,sg(S,7)); }
        }
      }
    }
  }
  return ok;
}

// revise: on a latched request (and enable), score the committed
// clause set on the judgment table, re-induct, count the revision.
fn u_revise(S:[]u8,cbase:i32,enabled:i32)void {
  if(sg(S,901)==1){
    if(enabled==1){
      let nf:i32=sg(S,300);
      let na:i32=sg(S,301);
      let nr:i32=sg(S,302);
      let err:i32=0;
      let j:i32=0;
      while(j<na){
        if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
        j=j+1;
      }
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
        }
        r=r+1;
      }
      ss(S,924,err);
      let ui2:i32=u_induct(S,cbase);
      ss(S,904,sg(S,904)+1);
      let ui2b:i32=ui2;
      ss(S,925,ui2b);
      ss(S,901,0);
      ss(S,900,0);
    }
  }
  return;
}

// Appended after unchanged module prefix, before original drift harness.
fn metric(OUT:[]u8,cur:i32,name:[]u8,v:i32)i32 {
  let c:i32=e1str(OUT,cur,name); c=e1i64(OUT,c,v as i64); return c;
}
fn dataset(S:[]u8,extended:i32)void {
  ss(S,300,1); ss(S,301,2+extended); ss(S,302,1);
  ss(S,304,1); ss(S,305,2);
  ss(S,311,1); ss(S,312,4);
  ss(S,318,1); ss(S,319,8);
  ss(S,528,1); ss(S,529,6);
  return;
}
fn predict(S:[]u8,base:i32,x:i32)i32 {
  return u_check(S,base,1,x,0,0,0,0,0);
}
fn truth(x:i32)i32 {
  if(x<2 || x>8){ return 0; }
  if(x==6){ return 0; }
  if(x%2==0){ return 1; }
  return 0;
}
fn setup_contract(S:[]u8,base:i32,lo:i32,hi:i32)void {
  u_write_clause(S,base,0,0,0,lo,hi);
  ss(S,base,7); ss(S,base+1,1); ss(S,base+2,1); ss(S,base+3,1);
  return;
}
fn btable(S:[]u8)void {
  ss(S,300,1); ss(S,301,2); ss(S,302,1);
  ss(S,304,1); ss(S,305,20); ss(S,311,1); ss(S,312,30);
  ss(S,528,1); ss(S,529,40);
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536); let c:i32=0; let unexpected:i32=0;
  let S:[]u8=z_alloc(8192); let F:[]u8=z_alloc(8192);
  let R:[]u8=z_alloc(8192); let base:i32=100;
  dataset(S,0); dataset(F,0); dataset(R,1);
  let init:i32=u_induct(S,base); let frozeninit:i32=u_induct(F,base);
  let reinit:i32=u_induct(R,base);
  let before6:i32=predict(S,base,6); let before8:i32=predict(S,base,8);
  u_grow(S,base,8,0,0,0,0,0);
  let after6:i32=predict(S,base,6); let after8:i32=predict(S,base,8);
  c=metric(OUT,c,"growth init=",init); c=metric(OUT,c," before_reject6=",before6);
  c=metric(OUT,c," after_reject6=",after6); c=metric(OUT,c," before_success8=",before8);
  c=metric(OUT,c," after_success8=",after8); c=metric(OUT,c," frozen_reject6=",predict(F,base,6));
  c=metric(OUT,c," reinduct_reject6=",predict(R,base,6)); c=e1str(OUT,c,"\n");
  let errorsg:i32=0; let errorsf:i32=0; let errorsr:i32=0;
  let x:i32=1;
  while(x<=10){
    let t:i32=truth(x); let g:i32=predict(S,base,x);
    let f:i32=predict(F,base,x); let r:i32=predict(R,base,x);
    if(g!=t){ errorsg=errorsg+1; }
    if(f!=t){ errorsf=errorsf+1; }
    if(r!=t){ errorsr=errorsr+1; }
    c=metric(OUT,c,"query x=",x); c=metric(OUT,c," expected=",t);
    c=metric(OUT,c," grown=",g); c=metric(OUT,c," frozen=",f);
    c=metric(OUT,c," reinduct=",r); c=e1str(OUT,c,"\n");
    x=x+1;
  }
  c=metric(OUT,c,"evaluation_grid grown_errors=",errorsg);
  c=metric(OUT,c," frozen_errors=",errorsf); c=metric(OUT,c," reinduct_errors=",errorsr);
  c=metric(OUT,c," reinduct_xform=",sg(R,base+5));
  c=metric(OUT,c," reinduct_k=",sg(R,base+6)); c=e1str(OUT,c,"\n");
  if(init!=1 || frozeninit!=1 || reinit!=1){ unexpected=unexpected+1; }
  if(before6!=0 || before8!=0 || after6!=1 || after8!=1){ unexpected=unexpected+1; }
  if(predict(F,base,6)!=0 || predict(R,base,6)!=0){ unexpected=unexpected+1; }
  if(predict(R,base,2)!=1 || predict(R,base,4)!=1 || predict(R,base,8)!=1){ unexpected=unexpected+1; }
  if(errorsg!=4 || errorsf!=2){ unexpected=unexpected+1; }

  let SH:[]u8=z_alloc(8192); let ISO:[]u8=z_alloc(8192);
  setup_contract(SH,100,2,4); setup_contract(SH,200,20,30);
  setup_contract(ISO,200,20,30); btable(SH); btable(ISO);
  let beforeb:i32=predict(SH,200,25); let i:i32=0;
  while(i<3){
    let ia:i32=u_invalidate(SH,100,1,0);
    i=i+1;
  }
  let req:i32=sg(SH,901); let failrun:i32=sg(SH,900);
  let bactive:i32=sg(SH,209); let bdc:i32=sg(SH,210);
  let aactive:i32=sg(SH,109);
  u_revise(SH,200,1); u_revise(ISO,200,1);
  c=metric(OUT,c,"isolation A_failures=",failrun);
  c=metric(OUT,c," shared_request=",req); c=metric(OUT,c," A_active=",aactive);
  c=metric(OUT,c," B_active_before_revision=",bactive); c=metric(OUT,c," B_dc=",bdc);
  c=metric(OUT,c," B_rev_shared=",sg(SH,904)); c=metric(OUT,c," B_rev_isolated=",sg(ISO,904));
  c=metric(OUT,c," B_pred_before=",beforeb); c=metric(OUT,c," B_pred_after=",predict(SH,200,25));
  c=metric(OUT,c," shared_request_after_B=",sg(SH,901)); c=e1str(OUT,c,"\n");
  if(req!=1 || failrun!=3 || aactive!=0 || bactive!=1 || bdc!=0){ unexpected=unexpected+1; }
  if(sg(SH,904)!=1 || sg(ISO,904)!=0 || sg(SH,901)!=0){ unexpected=unexpected+1; }
  if(beforeb!=1 || predict(SH,200,25)!=1){ unexpected=unexpected+1; }
  c=metric(OUT,c,"instrumentation_unexpected=",unexpected); c=e1str(OUT,c,"\n");
  _zag_print(OUT[0..c]);
  if(unexpected!=0){ return 1; }
  return 0;
}

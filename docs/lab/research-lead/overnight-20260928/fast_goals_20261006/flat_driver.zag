// Appended to unchanged original LCONT source before main.
fn flat_select(st:[]u8,y:i32)i32 {
  let best:i32=-1; let evbest:i32=-1; let s:i32=0;
  while(s<NSTR){
    if(probe_has(st,s,y)==1){
      let ev:i32=cell(st,O_SUCCO,s);
      if(best<0 || ev>evbest){ best=s; evbest=ev; }
    }
    s=s+1;
  }
  return best;
}
fn met(ob:[]u8,at:i32,name:[]u8,v:i32)i32 {
  let c:i32=ob_app(ob,at,name); c=ob_i32(ob,c,v); return c;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536); let at:i32=0; let unexpected:i32=0;
  let w:i32=0;
  while(w<2){
    let st:[]u8=z_alloc(1024); at=run_world(ob,at,st,w);
    let coarse:[]u8=z_alloc(1024); let i:i32=0;
    while(i<1024){ coarse[i]=st[i]; i=i+1; }
    i=0; while(i<NSTR){ setcell(coarse,O_OUTK,i,0); i=i+1; }
    let duplicate:i32=0; let a:i32=0;
    while(a<NSTR){
      let b:i32=a+1;
      while(b<NSTR){
        if(cell(st,O_OUTK,a)==cell(st,O_OUTK,b)){ duplicate=duplicate+1; }
        b=b+1;
      }
      a=a+1;
    }
    let flags:i32=0; let choices:i32=0; let coarseflags:i32=0; let coarsechoices:i32=0;
    let y:i32=0;
    while(y<=40){
      let mask:i32=need_mask(st,y); let cmask:i32=need_mask(coarse,y);
      let kindchoice:i32=select_outer(st,mask); let flatchoice:i32=flat_select(st,y);
      let coarsechoice:i32=select_outer(coarse,cmask);
      if(kindchoice!=flatchoice){ choices=choices+1; }
      if(coarsechoice!=flatchoice){ coarsechoices=coarsechoices+1; }
      let s:i32=0;
      while(s<NSTR){
        let flatflag:i32=probe_has(st,s,y);
        if(is_cand(st,s,mask)!=flatflag){ flags=flags+1; }
        if(is_cand(coarse,s,cmask)!=flatflag){ coarseflags=coarseflags+1; }
        s=s+1;
      }
      at=met(ob,at,"selection world=",w); at=met(ob,at," target=",y);
      at=met(ob,at," kinds=",kindchoice); at=met(ob,at," flat=",flatchoice);
      at=met(ob,at," coarse=",coarsechoice); at=ob_nl(ob,at);
      y=y+1;
    }
    at=met(ob,at,"flat_summary world=",w); at=met(ob,at," targets=",y);
    at=met(ob,at," duplicate_kind_pairs=",duplicate); at=met(ob,at," candidate_mismatch=",flags);
    at=met(ob,at," choice_mismatch=",choices); at=met(ob,at," coarse_candidate_mismatch=",coarseflags);
    at=met(ob,at," coarse_choice_mismatch=",coarsechoices); at=ob_nl(ob,at);
    if(y!=41 || duplicate!=0 || flags!=0 || choices!=0){ unexpected=unexpected+1; }
    if(coarseflags<=0 || coarsechoices<=0){ unexpected=unexpected+1; }
    if(cell(st,O_PASS,0)!=1 || cell(st,O_PASS,1)!=1 || cell(st,O_PASS,2)!=1 || cell(st,O_PASS,4)!=1){ unexpected=unexpected+1; }
    w=w+1;
  }
  at=met(ob,at,"instrumentation_unexpected=",unexpected); at=ob_nl(ob,at);
  _zag_print(ob[0..at]);
  if(unexpected!=0){ return 1; }
  return 0;
}

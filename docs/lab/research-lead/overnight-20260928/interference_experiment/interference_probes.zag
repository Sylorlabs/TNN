// ============ TNN-2 MEMORY INTERFERENCE PROBES (unfrozen variant) ============
// Appended to tnn2_interference_variant.zag (frozen cognition functions,
// test battery and test main removed). All cognition above is byte-identical
// to frozen TNN-2 (build f4de7ff46, source a29972ca...).
// Diagnostic only: measures retention of a learned executable structure under
// graded interference volume. No eviction policy changes. Pure Zag.

// ---- white-box helpers (read-only) ----
fn ix_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn ix_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn ix_find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn ix_alive(W:[]u8,n:i32)i32 {
  if(n<2 || n>=1024){return 0;}
  if(ng(W,n,36)==1){return 1;}
  return 0;
}
// Content-verified survival: slot alive AND still holds the expected (s,r).
// Evicted slots are reused by interference facts, so slot-liveness alone
// is not sufficient.
fn ix_fact_ok(W:[]u8,n:i32,s:i32,r:i32)i32 {
  if(ix_alive(W,n)==0){return 0;}
  if(ng(W,n,0)!=1){return 0;}
  if(ng(W,n,20)!=s){return 0;}
  if(ng(W,n,24)!=r){return 0;}
  return 1;
}
fn ix_map_ok(W:[]u8,n:i32,s:i32,r:i32)i32 {
  if(ix_alive(W,n)==0){return 0;}
  if(ng(W,n,0)!=20){return 0;}
  if(ng(W,n,8)!=s){return 0;}
  if(ng(W,n,4)!=r){return 0;}
  return 1;
}
fn ix_cells(W:[]u8)i32 {
  return ix_count_tag(W,101)+ix_count_tag(W,102)+ix_count_tag(W,103)+ix_count_tag(W,104);
}
fn ix_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// One interference trial.
// volume: number of unrelated teaches.
// refresh: 0 = no refresh; 1 = re-query (1,40) every 10 interference events,
//          stop refreshing after first miss (record fail_at).
fn ix_run(volume:i32,refresh:i32)void {
  if(refresh==0){ emit("== IX1 vol "); } else { emit("== IX2 vol "); }
  e64(volume); emit(" ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Task A: 4-hop chain, then query (1,40) to trigger trial + promotion.
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a0:i32=ev_query(W,1,40,5,0);
  ix_rep("build_ans",a0);
  // Baseline white-box record.
  let map0:i32=ix_find_map(W,1,40);
  let root0:i32=-1;
  if(map0>=0){ root0=ng(W,map0,20); }
  let cells0:i32=ix_cells(W);
  let f1:i32=ix_find_fact(W,1,11);
  let f2:i32=ix_find_fact(W,2,11);
  let f3:i32=ix_find_fact(W,3,11);
  let f4:i32=ix_find_fact(W,4,11);
  let sh0:i32=ix_find_fact(W,1,40);
  ix_rep("base_map",map0); ix_rep("base_root",root0); ix_rep("base_cells",cells0);
  ix_rep("base_f1",f1); ix_rep("base_f2",f2); ix_rep("base_f3",f3); ix_rep("base_f4",f4);
  ix_rep("base_shadow",sh0);
  ix_rep("base_live",hg(W,20)); ix_rep("base_edges",hg(W,24));
  if(map0>=0){ ix_rep("base_map_bid",bid(W,map0)); ix_rep("base_map_prot",is_prot(W,map0)); }
  if(sh0>=0){ ix_rep("base_shadow_bid",bid(W,sh0)); ix_rep("base_shadow_prot",is_prot(W,sh0)); }
  // Interference phase.
  let fail_at:i32=-1;
  let i:i32=0;
  while(i<volume){
    ev_teach(W,700+i,41,i);
    if(refresh==1 && fail_at<0){
      let k:i32=i+1;
      if(k-(k/10)*10==0){
        // Fast path: check fact presence via activate first. Only run the
        // full ev_query (for its ref_prot side effect) when the fact is
        // present; a miss would trigger the slow trial loop under pressure.
        let a:i32=activate(W,1,40);
        if(a<0){ fail_at=k; }
        else {
          let q:i32=ev_query(W,1,40,-2,0);
          if(q!=5){ fail_at=k; }
        }
      }
    }
    i=i+1;
  }
  ix_rep("refresh_fail_at",fail_at);
  // Post-interference white-box survival (read-only, before final query).
  // Content-verified: evicted slots are reused, so check (s,r) content.
  let ma:i32=ix_map_ok(W,map0,1,40);
  ix_rep("map_alive",ma);
  ix_rep("cells_alive",ix_cells(W));
  let ca:i32=0;
  if(ix_fact_ok(W,f1,1,11)==1){ ca=ca+1; }
  if(ix_fact_ok(W,f2,2,11)==1){ ca=ca+1; }
  if(ix_fact_ok(W,f3,3,11)==1){ ca=ca+1; }
  if(ix_fact_ok(W,f4,4,11)==1){ ca=ca+1; }
  ix_rep("chain_alive",ca);
  let sa:i32=ix_fact_ok(W,sh0,1,40);
  ix_rep("shadow_alive",sa);
  if(ma==1){ ix_rep("map_bid",bid(W,map0)); ix_rep("map_prot",is_prot(W,map0)); }
  else { ix_rep("map_bid",-999); ix_rep("map_prot",-999); }
  // Re-execution: only if MAP alive. Check root still an op cell first.
  let ex:i32=-999998;
  if(ma==1){
    let rt:i32=ng(W,map0,20);
    ix_rep("root_now",rt);
    let rtok:i32=0;
    if(ix_alive(W,rt)==1){
      let tg:i32=ng(W,rt,0);
      if(tg==101 || tg==102 || tg==103 || tg==104){ rtok=1; }
    }
    ix_rep("root_opcell",rtok);
    if(rtok==1){ ex=t2_exec(W,rt,1); }
    else { ex=-999997; }
  }
  ix_rep("reexec",ex);
  ix_rep("live_nodes",hg(W,20));
  ix_rep("edge_count",hg(W,24));
  ix_rep("facts_total",ix_count_tag(W,1));
  ix_rep("maps_total",ix_count_tag(W,20));
  // Functional check LAST. Use activate (read-only fact lookup) instead of
  // ev_query: equivalent for "is the answer retrievable" (shadow fact hit),
  // but avoids the trial loop which is prohibitively slow under full memory.
  // shadow_alive (content-verified above) is the primary metric; this is a
  // cross-check that the fact is actually findable by the query path.
  let act:i32=activate(W,1,40);
  let ans:i32=-2;
  if(act>=0){ ans=ng(W,act,28); }
  ix_rep("requery",ans);
  // Was the answer from the original structure or a rebuild?
  let map_now:i32=ix_find_map(W,1,40);
  let same:i32=0;
  if(map_now==map0 && ma==1){ same=1; }
  ix_rep("map_same_id",same);
  ix_rep("map_now",map_now);
  return;
}

fn ix_main()i32 {
  emit("TNN-2 MEMORY INTERFERENCE EXPERIMENT (unfrozen variant)\\n");
  emit("cognition byte-identical to frozen f4de7ff46; diagnostic only\\n");
  // IX-1: retention curve, no refresh. Vol 0 is the no-interference baseline;
  // 1000/1050/1100 span the eviction-pressure onset (pre-pressure volumes
  // 500/900 show zero disturbance: no eviction below the 1024-node cap).
  ix_run(0,0);
  ix_run(1000,0);
  ix_run(1050,0);
  ix_run(1100,0);
  // IX-2: retention with periodic refresh (every 10 events).
  ix_run(0,1);
  ix_run(1000,1);
  ix_run(1050,1);
  ix_run(1100,1);
  emit("INTERFERENCE_PROBES_DONE\\n");
  return 0;
}
fn main()i32 { return ix_main(); }

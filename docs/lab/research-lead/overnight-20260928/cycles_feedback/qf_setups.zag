// qf_setups.zag -- CYCLES-FEEDBACK workload setups (frozen after prereg).
// Three multi-structure feedback workloads, all identifiers opaque integers.
// No iteration, no repeat/period check, no direct structure-application
// call in this file: each setup poses facts + MAPs + teach
// observations plus ONE solve query issued by the driver main.
//
// Shared inventory: m0 = class 4 STEP on 801 (structure A: 80xx -> 81xx);
// m1 = class 4 STEP on 802 (structure B: 81xx -> 80xx, plus the
// 8001->8999 trap edge); m2/m3 = class 1 COUNT distractors on 605/606
// (block reused from cycles_oscillatory/cycles_convergent; nothing
// collides with the 79xx-81xx/89xx states).
// No IDENT MAP: kept comparable to the C425/C428 inventory. With the
// trap edge, no STEP MAP is identity at s either (documented in PREREG
// Section 3): m0 has an outgoing 801 edge at 8001, and m1's 802 edge at
// 8001 leads to the 8999 dead end.
//
// Feedback edge sets (PREREG Section 3; F10 audits):
//   rel 801: 8001->8101, 8002->8102; QF2-only tail 7999->8000, 8000->8001.
//   rel 802: 8101->8002, 8102->8001, trap 8001->8999 (8999 dead end).
// Neither relation contains a directed cycle on its own; the only
// directed cycle in the union is the emergent feedback loop
// 8001->8101->8002->8102->8001, which uses both relations.
// setup_qf1 (F-Q1): the loop world. Query s=8001, exp=8001
// (one full A,B,A,B pass: 8001->8101->8002->8102->8001).
// setup_qf2 (F-Q2): 2-step tail 7999->8000->8001, then the loop.
// Query s=7999, exp=8001 (first repeated state: seen at step 2,
// repeated at step 6 after one full loop pass).
// setup_qf3 (F-Q3): same world as setup_qf1.
// Query s=8001, exp=8102 (interior loop state, 3 loop-steps away).
fn qf_distractors(A:[]u8)void {
  fact_add(A,6101,605,6102);
  fact_add(A,6201,606,6202); fact_add(A,6201,606,6203);
  map_new(A,2,1,605,0);
  map_new(A,3,1,606,0);
  teach(A,2,6101,1);
  teach(A,3,6201,2);
  return;
}
fn qf_loop(A:[]u8)void {
  fact_add(A,8001,801,8101);
  fact_add(A,8002,801,8102);
  fact_add(A,8101,802,8002);
  fact_add(A,8102,802,8001);
  fact_add(A,8001,802,8999);
  map_new(A,0,4,801,0);
  map_new(A,1,4,802,0);
  teach(A,0,8001,8101);
  teach(A,0,8002,8102);
  teach(A,1,8101,8002);
  teach(A,1,8102,8001);
  teach(A,1,8001,8999);
  return;
}
fn setup_qf1(A:[]u8)void {
  qf_loop(A);
  qf_distractors(A);
  return;
}
fn setup_qf2(A:[]u8)void {
  qf_loop(A);
  fact_add(A,7999,801,8000);
  fact_add(A,8000,801,8001);
  teach(A,0,7999,8000);
  teach(A,0,8000,8001);
  qf_distractors(A);
  return;
}
fn setup_qf3(A:[]u8)void {
  qf_loop(A);
  qf_distractors(A);
  return;
}

// qf_main.zag -- CYCLES-FEEDBACK driver.
// Runs the three multi-structure feedback workloads on the fully frozen
// mechanism (gc_solve) and base: QF1 full-loop return, QF2 tail-entry
// lasso, QF3 mid-loop stop. One binary; 3/3 byte-identical runs required
// (F2).
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_qf1(A);
  c=gc_solve(A,B,c,8001,1,1,8001,4,8,8);
  c=uni_report(A,B,c,"GC","QF1");
  c=uni_census(A,B,c,4);
  let A1:[]u8=world_new();
  setup_qf2(A1);
  c=gc_solve(A1,B,c,7999,1,1,8001,4,8,8);
  c=uni_report(A1,B,c,"GC","QF2");
  c=uni_census(A1,B,c,4);
  let A2:[]u8=world_new();
  setup_qf3(A2);
  c=gc_solve(A2,B,c,8001,1,1,8102,4,8,8);
  c=uni_report(A2,B,c,"GC","QF3");
  c=uni_census(A2,B,c,4);
  o_flush(B,c);
  return 0;
}

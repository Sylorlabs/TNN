// pe_world.zag -- per-relation epoch table + epoch-bumping drifts for
// SPEC-PERRELATION-EPOCH.
//
// The world arena (da_base.zag) uses offset 0 for the fact count and
// 4..772 for the 64 fact slots (12 bytes each); offset 772 holds the
// per-world epoch (et_world.zag, kept for the coarse comparison lines).
// Offsets 776+ are verified free of writes by every reused file. The
// per-relation epoch table lives there:
//   776: entry count (i32)
//   780+i*8: relation id (i32); 784+i*8: epoch (i32); i in 0..7.
// A relation with no entry reads as epoch 0; the first bump creates
// (rel, 1). The bump rule is the soundness condition: the drift
// constructors (the world mutators) bump every relation with at least one
// fact whose (s,r,o) content changed (added, removed, or field-modified).
// A relation whose fact set is untouched keeps its epoch, so queries
// against it hit; a relation whose fact set changed gets a new epoch, so
// queries against it refuse.
//
// The world-epoch accessors (et_epoch_get / et_epoch_bump) and the base
// drifts (et_drift_unrelated / et_drift_relswap / et_drift_deletion) are
// reused unmodified from et_world.zag; only the per-relation bumps and
// the table machinery live here. No world literals appear in this file:
// relation ids arrive via the rb_* accessors.
fn pe_epoch_n(A:[]u8)i32 { return get32(A,776); }
fn pe_epoch_get(A:[]u8,rel:i32)i32 {
  let n:i32=get32(A,776);
  let i:i32=0;
  while(i<n){
    if(get32(A,780+i*8)==rel){ return get32(A,784+i*8); }
    i=i+1;
  }
  return 0;
}
fn pe_epoch_bump_rel(A:[]u8,rel:i32)void {
  let n:i32=get32(A,776);
  let i:i32=0;
  while(i<n){
    if(get32(A,780+i*8)==rel){
      set32(A,784+i*8,get32(A,784+i*8)+1);
      return;
    }
    i=i+1;
  }
  if(n<8){
    set32(A,780+n*8,rel);
    set32(A,784+n*8,1);
    set32(A,776,n+1);
  }
  return;
}
// E1 drift: only a fact of the second relation changes, so only its
// epoch moves. The first relation's epoch stays 0: queries against it
// must not refuse.
fn pe_drift_unrelated(A:[]u8)void {
  et_drift_unrelated(A);
  pe_epoch_bump_rel(A,rb_rel_b());
  return;
}
// E2 drift: slot 0's relation flips from the first to the second. One
// fact leaves the first relation and one fact joins the second, so both
// epochs move.
fn pe_drift_relswap(A:[]u8)void {
  et_drift_relswap(A);
  pe_epoch_bump_rel(A,rb_rel_a());
  pe_epoch_bump_rel(A,rb_rel_b());
  return;
}
// E3 drift: the world is rebuilt with all first-relation facts deleted.
// The second relation's fact set changes as well (one of its facts is
// gone after the rebuild), so both epochs move.
fn pe_drift_deletion(A:[]u8)void {
  et_drift_deletion(A);
  pe_epoch_bump_rel(A,rb_rel_a());
  pe_epoch_bump_rel(A,rb_rel_b());
  return;
}

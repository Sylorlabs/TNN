// pe_main.zag -- harness main for SPEC-PERRELATION-EPOCH.
// Learner state is built once with the real specialize functions on the
// pristine tiny world, exactly as in the parent lanes: et_specialize_*
// stamps the coarse world-epoch tags (for the coarse comparison lines),
// then pe_specialize_* stamps each bucket with its own relation's epoch.
// Stages: E0 control, E0MISS (silent miss must not recover), E1 (drift
// touches only the second relation: coarse lines price the rebuild, pe
// lines must hit with no rebuild; E1B queries the drifted relation and
// must refuse), E2 (relation swap: refuse + recover), E3 (deletion
// rebuild: refuse again + recover again), each with EPOCHS lines proving
// the table holds exactly the touched relations with the right epochs.
// World literals arrive only via the rb_* accessors; the query-side miss
// object below is not a world fact value. No relation-id literals appear
// in this file.
fn pe_reset(K:[]u8)void {
  set32(K,4,0);
  set32(K,8,0);
  return;
}
fn pe_agree_ret(rs:i32,rg:i32,sout:i32,gout:i32)i32 {
  if(rs!=rg){ return 0; }
  if(rs==0){ return 1; }
  if(sout==gout){ return 1; }
  return 0;
}
fn pe_agree_n(vs:i32,vg:i32)i32 {
  if(vs==vg){ return 1; }
  return 0;
}
fn pe_emit_et(B:[]u8,c:i32,tag:[]u8,vs:i32,rf:i32,kbs:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,vs as i64);
  c=o_app(B,c," refuse=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_nl(B,c);
  return c;
}
fn pe_emit_rr(B:[]u8,c:i32,tag:[]u8,vs:i32,vg:i32,sout:i32,gout:i32,ag:i32,rf:i32,rp:i32,kbs:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,vs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,vg as i64);
  c=o_app(B,c," sout=");
  c=o_i64(B,c,sout as i64);
  c=o_app(B,c," gout=");
  c=o_i64(B,c,gout as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," refuse=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," resp=");
  c=o_i64(B,c,rp as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_nl(B,c);
  return c;
}
fn pe_emit_rrn(B:[]u8,c:i32,tag:[]u8,vs:i32,vg:i32,ag:i32,rf:i32,rp:i32,kbs:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,vs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,vg as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," refuse=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," resp=");
  c=o_i64(B,c,rp as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_nl(B,c);
  return c;
}
fn pe_emit_ep(B:[]u8,c:i32,tag:[]u8,e0:i32,e1:i32,n:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," era=");
  c=o_i64(B,c,e0 as i64);
  c=o_app(B,c," erb=");
  c=o_i64(B,c,e1 as i64);
  c=o_app(B,c," n=");
  c=o_i64(B,c,n as i64);
  c=o_nl(B,c);
  return c;
}
fn pe_miss_obj()i32 { return 99; }
fn main()i32 {
  let B:[]u8=z_alloc(8192);
  let c:i32=0;
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let SB:[]u8=z_alloc(64);
  let seen:[]u8=z_alloc(512);
  let Cc:[]u8=chain_new();
  let ra:i32=rb_rel_a();
  let rbb:i32=rb_rel_b();
  let s1:i32=rb_subj1();
  let oa1:i32=rb_obj_a1();
  let ob1:i32=rb_obj_b1();
  let mo:i32=pe_miss_obj();
  rb_setup(A);
  ret_log_rel(L,ra); ret_log_rel(L,rbb);
  et_specialize_ret(L,S,A,0,0);
  vfy_log_rel(L,ra); vfy_log_rel(L,rbb);
  et_specialize_vfy(L,S,A,0,0);
  cnt_log_rel(L,ra); cnt_log_rel(L,rbb);
  et_specialize_cnt(L,S,A,0,0);
  pe_specialize_ret(L,S,A,0,0);
  pe_specialize_vfy(L,S,A,0,0);
  pe_specialize_cnt(L,S,A,0,0);
  set32(SB,0,s1);
  chain_add(Cc,s1,ra,oa1);
  // ---- E0: control, pristine world (all epochs 0, all tags 0)
  c=o_app(B,c,"STAGE E0"); c=o_nl(B,c);
  pe_reset(K); set32(K,0,0);
  let ce:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let kce:i32=get32(K,0); let fce:i32=get32(K,4);
  c=pe_emit_et(B,c,"E0RET_ETC",ce,fce,kce);
  pe_reset(K); set32(K,0,0);
  let r0:i32=pe_rr_ret(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let k0:i32=get32(K,0); let f0:i32=get32(K,4); let p0:i32=get32(K,8);
  set32(K,0,0);
  let g0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let so0:i32=-1;
  if(r0>0){ so0=get32(OUT,4); }
  let go0:i32=-1;
  if(g0>0){ go0=get32(OUTG,4); }
  c=pe_emit_rr(B,c,"E0RET_PERR",r0,g0,so0,go0,pe_agree_ret(r0,g0,so0,go0),f0,p0,k0);
  pe_reset(K); set32(K,0,0);
  let w0:i32=pe_rr_cnt(L,S,A,ra,SB,0,1,K,0,seen,K,4,K,8);
  let kw0:i32=get32(K,0); let fw0:i32=get32(K,4); let pw0:i32=get32(K,8);
  set32(K,0,0);
  let h0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  c=pe_emit_rrn(B,c,"E0CNT_PERR",w0,h0,pe_agree_n(w0,h0),fw0,pw0,kw0);
  pe_reset(K); set32(K,0,0);
  let v0:i32=pe_rr_vfy(L,S,A,Cc,K,0,K,4,K,8);
  let kv0:i32=get32(K,0); let fv0:i32=get32(K,4); let pv0:i32=get32(K,8);
  set32(K,0,0);
  let u0:i32=vfy_gen(A,Cc,K,0);
  c=pe_emit_rrn(B,c,"E0VFY_PERR",v0,u0,pe_agree_n(v0,u0),fv0,pv0,kv0);
  // ---- E0MISS: silent miss with matching relation epoch: no recovery
  c=o_app(B,c,"STAGE E0MISS"); c=o_nl(B,c);
  pe_reset(K); set32(K,0,0);
  let me:i32=pe_ret_spec(L,A,ra,mo,K,0,OUT,0,K,4);
  let kme:i32=get32(K,0); let fme:i32=get32(K,4);
  c=pe_emit_et(B,c,"E0MISS_PEET",me,fme,kme);
  pe_reset(K); set32(K,0,0);
  let mr:i32=pe_rr_ret(L,S,A,ra,mo,K,0,OUT,0,K,4,K,8);
  let kmr:i32=get32(K,0); let fmr:i32=get32(K,4); let pmr:i32=get32(K,8);
  c=pe_emit_rr(B,c,"E0MISS_PERR",mr,-1,-1,-1,-1,fmr,pmr,kmr);
  // ---- E1: drift touches only the second relation (its epoch 0 -> 1)
  pe_drift_unrelated(A);
  c=o_app(B,c,"STAGE E1"); c=o_nl(B,c);
  pe_reset(K); set32(K,0,0);
  let e1c:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let ke1c:i32=get32(K,0); let fe1c:i32=get32(K,4);
  c=pe_emit_et(B,c,"E1RET_ETC",e1c,fe1c,ke1c);
  pe_reset(K); set32(K,0,0);
  let c1:i32=rr_ret_spec(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let kc1:i32=get32(K,0); let fc1:i32=get32(K,4); let pc1:i32=get32(K,8);
  set32(K,0,0);
  let gc1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let soc1:i32=-1;
  if(c1>0){ soc1=get32(OUT,4); }
  let goc1:i32=-1;
  if(gc1>0){ goc1=get32(OUTG,4); }
  c=pe_emit_rr(B,c,"E1RET_RRC",c1,gc1,soc1,goc1,pe_agree_ret(c1,gc1,soc1,goc1),fc1,pc1,kc1);
  pe_reset(K); set32(K,0,0);
  let e1p:i32=pe_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let ke1p:i32=get32(K,0); let fe1p:i32=get32(K,4);
  c=pe_emit_et(B,c,"E1RET_PEET",e1p,fe1p,ke1p);
  pe_reset(K); set32(K,0,0);
  let r1:i32=pe_rr_ret(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let k1:i32=get32(K,0); let f1:i32=get32(K,4); let p1:i32=get32(K,8);
  set32(K,0,0);
  let g1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let so1:i32=-1;
  if(r1>0){ so1=get32(OUT,4); }
  let go1:i32=-1;
  if(g1>0){ go1=get32(OUTG,4); }
  c=pe_emit_rr(B,c,"E1RET_PERR",r1,g1,so1,go1,pe_agree_ret(r1,g1,so1,go1),f1,p1,k1);
  pe_reset(K); set32(K,0,0);
  let w1:i32=pe_rr_cnt(L,S,A,ra,SB,0,1,K,0,seen,K,4,K,8);
  let kw1:i32=get32(K,0); let fw1:i32=get32(K,4); let pw1:i32=get32(K,8);
  set32(K,0,0);
  let h1:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  c=pe_emit_rrn(B,c,"E1CNT_PERR",w1,h1,pe_agree_n(w1,h1),fw1,pw1,kw1);
  pe_reset(K); set32(K,0,0);
  let v1:i32=pe_rr_vfy(L,S,A,Cc,K,0,K,4,K,8);
  let kv1:i32=get32(K,0); let fv1:i32=get32(K,4); let pv1:i32=get32(K,8);
  set32(K,0,0);
  let u1:i32=vfy_gen(A,Cc,K,0);
  c=pe_emit_rrn(B,c,"E1VFY_PERR",v1,u1,pe_agree_n(v1,u1),fv1,pv1,kv1);
  // ---- E1B: query the drifted relation itself: the gate must still fire
  pe_reset(K); set32(K,0,0);
  let b1e:i32=pe_ret_spec(L,A,rbb,ob1,K,0,OUT,0,K,4);
  let kb1e:i32=get32(K,0); let fb1e:i32=get32(K,4);
  c=pe_emit_et(B,c,"E1B_PEET",b1e,fb1e,kb1e);
  pe_reset(K); set32(K,0,0);
  let b1:i32=pe_rr_ret(L,S,A,rbb,ob1,K,0,OUT,0,K,4,K,8);
  let kb1:i32=get32(K,0); let fb1:i32=get32(K,4); let pb1:i32=get32(K,8);
  set32(K,0,0);
  let gb1:i32=ret_gen(A,rbb,ob1,K,0,OUTG,0);
  c=pe_emit_rrn(B,c,"E1B_PERR",b1,gb1,pe_agree_n(b1,gb1),fb1,pb1,kb1);
  pe_reset(K);
  c=pe_emit_ep(B,c,"EPOCHS_E1",pe_epoch_get(A,ra),pe_epoch_get(A,rbb),pe_epoch_n(A));
  // ---- E2: relation swap (both epochs move); gen answers all 0
  pe_drift_relswap(A);
  c=o_app(B,c,"STAGE E2"); c=o_nl(B,c);
  pe_reset(K); set32(K,0,0);
  let e2:i32=pe_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let ke2:i32=get32(K,0); let fe2:i32=get32(K,4);
  c=pe_emit_et(B,c,"E2RET_PEET",e2,fe2,ke2);
  pe_reset(K); set32(K,0,0);
  let r2:i32=pe_rr_ret(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let k2:i32=get32(K,0); let f2:i32=get32(K,4); let p2:i32=get32(K,8);
  set32(K,0,0);
  let g2:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  c=pe_emit_rrn(B,c,"E2RET_PERR",r2,g2,pe_agree_n(r2,g2),f2,p2,k2);
  pe_reset(K); set32(K,0,0);
  let r2b:i32=pe_rr_ret(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let k2b:i32=get32(K,0); let f2b:i32=get32(K,4); let p2b:i32=get32(K,8);
  set32(K,0,0);
  let g2b:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  c=pe_emit_rrn(B,c,"E2RET_PERR2",r2b,g2b,pe_agree_n(r2b,g2b),f2b,p2b,k2b);
  pe_reset(K); set32(K,0,0);
  let w2:i32=pe_rr_cnt(L,S,A,ra,SB,0,1,K,0,seen,K,4,K,8);
  let kw2:i32=get32(K,0); let fw2:i32=get32(K,4); let pw2:i32=get32(K,8);
  set32(K,0,0);
  let h2:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  c=pe_emit_rrn(B,c,"E2CNT_PERR",w2,h2,pe_agree_n(w2,h2),fw2,pw2,kw2);
  pe_reset(K); set32(K,0,0);
  let v2:i32=pe_rr_vfy(L,S,A,Cc,K,0,K,4,K,8);
  let kv2:i32=get32(K,0); let fv2:i32=get32(K,4); let pv2:i32=get32(K,8);
  set32(K,0,0);
  let u2:i32=vfy_gen(A,Cc,K,0);
  c=pe_emit_rrn(B,c,"E2VFY_PERR",v2,u2,pe_agree_n(v2,u2),fv2,pv2,kv2);
  pe_reset(K);
  c=pe_emit_ep(B,c,"EPOCHS_E2",pe_epoch_get(A,ra),pe_epoch_get(A,rbb),pe_epoch_n(A));
  // ---- E3: deletion rebuild (both epochs move again)
  pe_drift_deletion(A);
  c=o_app(B,c,"STAGE E3"); c=o_nl(B,c);
  pe_reset(K); set32(K,0,0);
  let e3:i32=pe_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let ke3:i32=get32(K,0); let fe3:i32=get32(K,4);
  c=pe_emit_et(B,c,"E3RET_PEET",e3,fe3,ke3);
  pe_reset(K); set32(K,0,0);
  let r3:i32=pe_rr_ret(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  let k3:i32=get32(K,0); let f3:i32=get32(K,4); let p3:i32=get32(K,8);
  set32(K,0,0);
  let g3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  c=pe_emit_rrn(B,c,"E3RET_PERR",r3,g3,pe_agree_n(r3,g3),f3,p3,k3);
  pe_reset(K); set32(K,0,0);
  let w3:i32=pe_rr_cnt(L,S,A,ra,SB,0,1,K,0,seen,K,4,K,8);
  let kw3:i32=get32(K,0); let fw3:i32=get32(K,4); let pw3:i32=get32(K,8);
  set32(K,0,0);
  let h3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  c=pe_emit_rrn(B,c,"E3CNT_PERR",w3,h3,pe_agree_n(w3,h3),fw3,pw3,kw3);
  pe_reset(K); set32(K,0,0);
  let v3:i32=pe_rr_vfy(L,S,A,Cc,K,0,K,4,K,8);
  let kv3:i32=get32(K,0); let fv3:i32=get32(K,4); let pv3:i32=get32(K,8);
  set32(K,0,0);
  let u3:i32=vfy_gen(A,Cc,K,0);
  c=pe_emit_rrn(B,c,"E3VFY_PERR",v3,u3,pe_agree_n(v3,u3),fv3,pv3,kv3);
  pe_reset(K);
  c=pe_emit_ep(B,c,"EPOCHS_E3",pe_epoch_get(A,ra),pe_epoch_get(A,rbb),pe_epoch_n(A));
  o_flush(B,c);
  return 0;
}

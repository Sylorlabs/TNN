// pe_rr.zag -- refusal-recovery protocol over the per-relation epoch
// specs for SPEC-PERRELATION-EPOCH.
//
// Same shape as rr_spec.zag (SPEC-REFUSAL-RECOVERY), which is reused
// byte-unmodified for the coarse comparison lines: each wrapper calls the
// corresponding pe_* per-relation epoch-gated spec. On EXPLICIT refusal
// (the refusal counter moved, not a silent miss) it re-specializes the
// refused bucket family from the current world via the pe_specialize_*
// wrappers (which rebuild the buckets and restamp each bucket's tag to
// its own relation's live epoch), counts one re-specialize event, and
// retries exactly once. A miss with a matching relation epoch returns
// as-is: recovery fires only on refusal, never on miss. A second refusal
// on the retry is returned as-is (second-order failure, caught by the
// kill bars, never silently looped). No world literals appear in this
// file.
fn pe_rr_ret(L:[]u8,S:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=pe_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  pe_specialize_ret(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return pe_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
}
fn pe_rr_cnt(L:[]u8,S:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=pe_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  pe_specialize_cnt(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return pe_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
}
fn pe_rr_vfy(L:[]u8,S:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=pe_vfy_spec(L,A,C,kb,ko,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  pe_specialize_vfy(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return pe_vfy_spec(L,A,C,kb,ko,rkb,rko);
}

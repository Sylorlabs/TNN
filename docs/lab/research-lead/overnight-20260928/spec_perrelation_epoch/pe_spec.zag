// pe_spec.zag -- per-relation epoch-gated spec variants for
// SPEC-PERRELATION-EPOCH.
//
// Each bucket is tagged with ITS RELATION's epoch at specialization time
// (pe_specialize_* stamps pe_epoch_get(A, rel) per bucket; the bucket's
// relation is read from the da_learn coverage id arrays). Every spec call
// compares the live epoch of the QUERIED relation against the tag and
// REFUSES on mismatch: it increments the refusal counter, returns a miss,
// and never scans the bucket. A drift that touches only other relations
// leaves the queried relation's epoch (and its tag) unchanged, so the
// call hits: refusal is triggered by relation identity, not world
// identity.
//
// Tag slots in L (verified free; the highest L offset used by da_learn.zag
// is 13296 and the et tags end at 13492; L is 16384 bytes): ret tags at
// 13500+bi*4, vfy tags at 13564+bi*4, cnt tags at 13628+bi*4 (16 slots
// each; all stamped, live ones are what matter). No world literals appear
// in this file.
// ---- specialization wrappers: real specialize, then stamp each
// ---- bucket with its own relation's epoch ----
fn pe_specialize_ret(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_ret(L,S,A,ep0,ep1);
  let i:i32=0;
  while(i<16){
    let r:i32=get32(L,4+i*4);
    set32(L,13500+i*4,pe_epoch_get(A,r));
    i=i+1;
  }
  return;
}
fn pe_specialize_vfy(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_vfy(L,S,A,ep0,ep1);
  let i:i32=0;
  while(i<16){
    let r:i32=get32(L,4252+i*4);
    set32(L,13564+i*4,pe_epoch_get(A,r));
    i=i+1;
  }
  return;
}
fn pe_specialize_cnt(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_cnt(L,S,A,ep0,ep1);
  let i:i32=0;
  while(i<16){
    let r:i32=get32(L,8500+i*4);
    set32(L,13628+i*4,pe_epoch_get(A,r));
    i=i+1;
  }
  return;
}
// ---- pe_ret_spec: per-relation epoch gate around ret_spec_fix ----
fn pe_ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(pe_epoch_get(A,rel)!=get32(L,13500+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(out,oo,0);
    return 0;
  }
  return ret_spec_fix(L,A,rel,obj,kb,ko,out,oo);
}
// ---- pe_cnt_spec: per-relation epoch gate around cnt_spec_fix ----
fn pe_cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(pe_epoch_get(A,rel)!=get32(L,13628+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(seen,0,0);
    return 0;
  }
  return cnt_spec_fix(L,A,rel,sb,so,nsubs,kb,ko,seen);
}
// ---- pe_vfy_spec: per-step per-relation epoch pre-scan around vfy_spec ----
fn pe_vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    if(get32(L,13564+bi*4)!=pe_epoch_get(A,r)){
      set32(rkb,rko,get32(rkb,rko)+1);
      return 0;
    }
    i=i+1;
  }
  return vfy_spec(L,A,C,kb,ko);
}

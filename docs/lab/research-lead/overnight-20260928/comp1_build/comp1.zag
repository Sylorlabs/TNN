// comp1.zag -- COMP-1 compositional machinery.
// Prereg 4f6f0c5c8 frozen before this file. Pure Zag. No Python.
// Query-time plan construction on the query-miss path.
// Three frozen templates: CHAIN-2, GATHER-n, ITERATE-UNTIL.
// E-ruling: expected is post-hoc feedback only. The candidate space is
// fully determined by the templates and the subject-incident relations
// before expected is consulted. The e-ablation is implemented and tested.
// Zero new core execution ops. Zero modes. Zero bridges. Zero handlers.
// Workspace: CLA-2 40-byte node layout (type_tag, ref[4], payload[4], valid).
// The bootstrap miss-policy is frozen generic machinery (157 source lines;
// the prereg projected at most 150, a +7 variance on a projection, not a
// kill bar); a learner may supersede it via the MISS_POLICY dispatch (Q3).

// ============ helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  let r:[]u8=_zag_i64_to_str(v as i64);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e32(v:i32)void { emit(i32s(v)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// u8-backed little-endian cells (compiler workaround per AGENTS.md)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn popcnt(x:i32)i32 {
  let c:i32=0;
  while(x>0){c=c+(x&1);x=x>>1;}
  return c;
}

// ============ workspace ============
// 256 nodes x 40 bytes. Node: tag(0) ref0(4) ref1(8) ref2(12) ref3(16)
// pay0(20) pay1(24) pay2(28) pay3(32) valid(36).
// 512 edges x 16 bytes. Edge: from(0) to(4) type(8). Free when from==-1.
fn WS_NODES()i32 { return 256; }
fn WS_EDGES()i32 { return 512; }
fn n_tag(ws:[]u8,n:i32)i32 { return get32(ws,n*40); }
fn n_ref(ws:[]u8,n:i32,k:i32)i32 { return get32(ws,n*40+4+k*4); }
fn n_pay(ws:[]u8,n:i32,k:i32)i32 { return get32(ws,n*40+20+k*4); }
fn n_valid(ws:[]u8,n:i32)i32 { return get32(ws,n*40+36); }
fn n_set_tag(ws:[]u8,n:i32,v:i32)void { set32(ws,n*40,v); return; }
fn n_set_ref(ws:[]u8,n:i32,k:i32,v:i32)void { set32(ws,n*40+4+k*4,v); return; }
fn n_set_pay(ws:[]u8,n:i32,k:i32,v:i32)void { set32(ws,n*40+20+k*4,v); return; }
fn n_set_valid(ws:[]u8,n:i32,v:i32)void { set32(ws,n*40+36,v); return; }
fn e_from(es:[]u8,e:i32)i32 { return get32(es,e*16); }
fn e_to(es:[]u8,e:i32)i32 { return get32(es,e*16+4); }
fn e_type(es:[]u8,e:i32)i32 { return get32(es,e*16+8); }
fn ws_new()[]u8 { return z_alloc(256*40); }
fn es_new()[]u8 {
  let es:[]u8=z_alloc(512*16);
  let e:i32=0;
  while(e<512){set32(es,e*16,-1);e=e+1;}
  return es;
}
fn meta_new()[]u8 { return z_alloc(16); } // meta[0]=tick
fn node_alloc(ws:[]u8)i32 {
  let n:i32=0;
  while(n<256){
    if(n_valid(ws,n)==0){
      n_set_valid(ws,n,1);
      n_set_tag(ws,n,0);
      n_set_ref(ws,n,0,-1); n_set_ref(ws,n,1,-1);
      n_set_ref(ws,n,2,-1); n_set_ref(ws,n,3,-1);
      n_set_pay(ws,n,0,0); n_set_pay(ws,n,1,0);
      n_set_pay(ws,n,2,0); n_set_pay(ws,n,3,0);
      return n;
    }
    n=n+1;
  }
  return -1;
}
fn edge_add(es:[]u8,f:i32,t:i32,ty:i32)i32 {
  let e:i32=0;
  while(e<512){
    if(e_from(es,e)==-1){
      set32(es,e*16,f); set32(es,e*16+4,t); set32(es,e*16+8,ty);
      return e;
    }
    e=e+1;
  }
  return -1;
}
// Node types (learner-assigned; the core never interprets these)
fn T_FACT()i32 { return 1; }
fn T_PLAN()i32 { return 5; }
fn T_STEP()i32 { return 6; }
fn T_QUERY()i32 { return 7; }
fn T_COMBINE()i32 { return 8; }
// Edge types (CLA-2 domain-free vocabulary)
fn ET_SUPPORTS()i32 { return 2; }
fn ET_USE()i32 { return 6; }
fn ET_SEQ()i32 { return 12; }
// Template ids (frozen set of exactly three, plus COMPOSED)
fn TM_CHAIN2()i32 { return 1; }
fn TM_GATHER()i32 { return 2; }
fn TM_ITER()i32 { return 3; }
fn TM_COMPOSED()i32 { return 4; }
// Plan step kinds (generic ISA-grounded operations; F7: no new core ops.
// READ is ISA-blessed; MOVE/BRANCHEQ/INC per EXECUTE placement;
// EMIT/APPLY are the plan-output and combining-structure conventions
// named in the prereg's own plan shapes.)
fn SK_READ()i32 { return 1; }
fn SK_MOVE()i32 { return 2; }
fn SK_BRANCHEQ()i32 { return 3; }
fn SK_INC()i32 { return 4; }
fn SK_EMIT()i32 { return 5; }
fn SK_APPLY()i32 { return 6; }
// Sentinels
fn S_MISS()i32 { return -2; }      // query miss / clean plan failure
fn S_FAIL()i32 { return -999999; }  // executor hard failure

// ============ teach / lookup ============
// FACT node: tag=1, pay0=subj, pay1=rel, pay2=obj, pay3=tick.
fn teach(ws:[]u8, es:[]u8, m:[]u8, s:i32, r:i32, o:i32)i32 {
  let n:i32=node_alloc(ws);
  if(n<0){return -1;}
  n_set_tag(ws,n,1);
  n_set_pay(ws,n,0,s); n_set_pay(ws,n,1,r);
  n_set_pay(ws,n,2,o); n_set_pay(ws,n,3,get32(m,0));
  set32(m,0,get32(m,0)+1);
  return n;
}
// Exact-key lookup. First taught wins. -2 on miss.
fn exact_lookup(ws:[]u8, s:i32, r:i32)i32 {
  let n:i32=0;
  while(n<256){
    if(n_valid(ws,n)==1){
      if(n_tag(ws,n)==1){
        if(n_pay(ws,n,0)==s){
          if(n_pay(ws,n,1)==r){return n_pay(ws,n,2);}
        }
      }
    }
    n=n+1;
  }
  return -2;
}
// Distinct relations with taught triples on subj, first-seen order.
// out: u8-backed i32 array. Returns count.
fn incident_fill(ws:[]u8, m:[]u8, subj:i32, out:[]u8)i32 {
  let nr:i32=0;
  let n:i32=0;
  while(n<256){
    if(n_valid(ws,n)==1){
      if(n_tag(ws,n)==1){
        if(n_pay(ws,n,0)==subj){
          let r:i32=n_pay(ws,n,1);
          let k:i32=0;
          let found:i32=0;
          while(k<nr){
            if(get32(out,k*4)==r){found=1;}
            k=k+1;
          }
          if(found==0){
            set32(out,nr*4,r);
            nr=nr+1;
          }
        }
      }
    }
    n=n+1;
  }
  return nr;
}
fn n_incident(ws:[]u8, m:[]u8, subj:i32)i32 {
  let tmp:[]u8=z_alloc(64*4);
  return incident_fill(ws,m,subj,tmp);
}
// Combining structure present? Returns node id or -1.
// T_COMBINE node: pay0=op (1=ADD, 2=FIRST). Learner-authored.
fn combine_present(ws:[]u8, m:[]u8)i32 {
  let n:i32=0;
  while(n<256){
    if(n_valid(ws,n)==1){
      if(n_tag(ws,n)==8){return n;}
    }
    n=n+1;
  }
  return -1;
}

// ============ plan structures ============
// Plans are learner-inspectable workspace structures.
// T_PLAN node: ref0=first step, ref1=template id,
//   pay0=query subj, pay1=query rel, pay2=candidate index.
// T_STEP node: pay0=kind; refs/pays hold operands per kind:
//   READ:    ref0=subj_slot, pay1=rel, ref1=dst_slot
//   EMIT:    ref0=src_slot
//   MOVE:    ref0=dst_slot, ref1=src_slot
//   BRANCHEQ: ref0=slot, pay1=imm, ref2=target step node
//   INC:     ref0=slot
//   APPLY:   ref0=combine node, ref1=src_base_slot, pay1=count, ref2=dst_slot
// Steps are chained with SEQ edges.
fn plan_new(ws:[]u8, es:[]u8, tm:i32, subj:i32, rel:i32, idx:i32)i32 {
  let p:i32=node_alloc(ws);
  if(p<0){return -1;}
  n_set_tag(ws,p,5);
  n_set_ref(ws,p,0,-1);
  n_set_ref(ws,p,1,tm);
  n_set_pay(ws,p,0,subj); n_set_pay(ws,p,1,rel); n_set_pay(ws,p,2,idx);
  return p;
}
fn step_new(ws:[]u8, es:[]u8, kind:i32)i32 {
  let s:i32=node_alloc(ws);
  if(s<0){return -1;}
  n_set_tag(ws,s,6);
  n_set_pay(ws,s,0,kind);
  return s;
}
fn seq_link(es:[]u8, a:i32, b:i32)void {
  edge_add(es,a,b,12);
  return;
}
fn seq_next(es:[]u8, cur:i32)i32 {
  let e:i32=0;
  while(e<512){
    if(e_from(es,e)!=-1){
      if(e_type(es,e)==12){
        if(e_from(es,e)==cur){return e_to(es,e);}
      }
    }
    e=e+1;
  }
  return -1;
}
// CHAIN-2(r1,r2): READ r1 subj->s4; READ r2 s4->s5; EMIT s5.
fn plan_chain2(ws:[]u8, es:[]u8, m:[]u8, r1:i32, r2:i32, subj:i32, rel:i32, idx:i32)i32 {
  let p:i32=plan_new(ws,es,1,subj,rel,idx);
  let s1:i32=step_new(ws,es,1);
  n_set_ref(ws,s1,0,0); n_set_pay(ws,s1,1,r1); n_set_ref(ws,s1,1,4);
  let s2:i32=step_new(ws,es,1);
  n_set_ref(ws,s2,0,4); n_set_pay(ws,s2,1,r2); n_set_ref(ws,s2,1,5);
  let s3:i32=step_new(ws,es,5);
  n_set_ref(ws,s3,0,5);
  seq_link(es,s1,s2); seq_link(es,s2,s3);
  n_set_ref(ws,p,0,s1);
  return p;
}
// GATHER over subset[0..k): READ each rel subj->s(3+i); APPLY combine; EMIT.
fn plan_gather(ws:[]u8, es:[]u8, m:[]u8, subset:[]u8, k:i32, cn:i32, subj:i32, rel:i32, idx:i32)i32 {
  let p:i32=plan_new(ws,es,2,subj,rel,idx);
  let first:i32=-1;
  let prev:i32=-1;
  let i:i32=0;
  while(i<k){
    let s:i32=step_new(ws,es,1);
    n_set_ref(ws,s,0,0); n_set_pay(ws,s,1,get32(subset,i*4)); n_set_ref(ws,s,1,3+i);
    if(first<0){first=s;}
    if(prev>=0){seq_link(es,prev,s);}
    prev=s;
    i=i+1;
  }
  let sa:i32=step_new(ws,es,6);
  n_set_ref(ws,sa,0,cn); n_set_ref(ws,sa,1,3); n_set_pay(ws,sa,1,k); n_set_ref(ws,sa,2,3+k);
  seq_link(es,prev,sa);
  let se:i32=step_new(ws,es,5);
  n_set_ref(ws,se,0,3+k);
  seq_link(es,sa,se);
  n_set_ref(ws,p,0,first);
  return p;
}
// ITERATE-UNTIL(r): loop { READ r cur->val; BRANCHEQ val==-2 -> emit;
// INC counter; MOVE cur=val }. Counter is frame slot 3 (INC from the
// frozen ISA basis; Q4: no counter primitive added).
fn plan_iterate(ws:[]u8, es:[]u8, m:[]u8, r:i32, subj:i32, rel:i32, idx:i32)i32 {
  let p:i32=plan_new(ws,es,3,subj,rel,idx);
  let s1:i32=step_new(ws,es,1);
  n_set_ref(ws,s1,0,0); n_set_pay(ws,s1,1,r); n_set_ref(ws,s1,1,4);
  let s5:i32=step_new(ws,es,5);
  n_set_ref(ws,s5,0,3);
  let s2:i32=step_new(ws,es,3);
  n_set_ref(ws,s2,0,4); n_set_pay(ws,s2,1,-2); n_set_ref(ws,s2,2,s5);
  let s3:i32=step_new(ws,es,4);
  n_set_ref(ws,s3,0,3);
  let s4:i32=step_new(ws,es,2);
  n_set_ref(ws,s4,0,0); n_set_ref(ws,s4,1,4);
  seq_link(es,s1,s2); seq_link(es,s2,s3); seq_link(es,s3,s4); seq_link(es,s4,s1);
  n_set_ref(ws,p,0,s1);
  return p;
}
// Clone one step node (all operands). Used by plan composition.
fn clone_step(ws:[]u8, es:[]u8, s:i32)i32 {
  let c:i32=step_new(ws,es,n_pay(ws,s,0));
  n_set_ref(ws,c,0,n_ref(ws,s,0)); n_set_ref(ws,c,1,n_ref(ws,s,1));
  n_set_ref(ws,c,2,n_ref(ws,s,2)); n_set_ref(ws,c,3,n_ref(ws,s,3));
  n_set_pay(ws,c,1,n_pay(ws,s,1)); n_set_pay(ws,c,2,n_pay(ws,s,2));
  n_set_pay(ws,c,3,n_pay(ws,s,3));
  return c;
}

// Output slot of a linear CHAIN-2 plan (dst of last READ before EMIT).
// -1 if the plan is not a linear CHAIN-2 (composition declines).
fn chain_outslot(ws:[]u8, es:[]u8, p:i32)i32 {
  if(n_ref(ws,p,1)!=1){return -1;}
  let cur:i32=n_ref(ws,p,0);
  let out:i32=-1;
  let guard:i32=0;
  while(cur>=0){
    if(guard>64){return -1;}
    guard=guard+1;
    let kind:i32=n_pay(ws,cur,0);
    if(kind==5){return out;}
    if(kind==1){out=n_ref(ws,cur,1);}
    if(kind==3){return -1;}
    cur=seq_next(es,cur);
  }
  return -1;
}
// Extend a linear CHAIN-2 plan P by one READ of r (from P's output).
// General plan-structure composition, not a template (P4).
fn plan_extend_read(ws:[]u8, es:[]u8, m:[]u8, p:i32, r:i32, subj:i32, rel:i32, idx:i32)i32 {
  let outslot:i32=chain_outslot(ws,es,p);
  if(outslot<0){return -1;}
  let np:i32=plan_new(ws,es,4,subj,rel,idx);
  let cur:i32=n_ref(ws,p,0);
  let first:i32=-1;
  let prev:i32=-1;
  let done:i32=0;
  let guard:i32=0;
  while(done==0){
    if(guard>64){return -1;}
    guard=guard+1;
    if(cur<0){done=1;}
    else {
      if(n_pay(ws,cur,0)==5){done=1;}
      else {
        let c:i32=clone_step(ws,es,cur);
        if(first<0){first=c;}
        if(prev>=0){seq_link(es,prev,c);}
        prev=c;
        cur=seq_next(es,cur);
      }
    }
  }
  if(first<0){return -1;}
  let sr:i32=step_new(ws,es,1);
  n_set_ref(ws,sr,0,outslot); n_set_pay(ws,sr,1,r); n_set_ref(ws,sr,1,8);
  seq_link(es,prev,sr);
  let se:i32=step_new(ws,es,5);
  n_set_ref(ws,se,0,8);
  seq_link(es,sr,se);
  n_set_ref(ws,np,0,first);
  return np;
}
// Compose P (linear CHAIN-2) with CHAIN-2(ra,rb): the second template
// applied to P's output, with scratch slots remapped to s12/s13.
// This is CHAIN-2 composed with itself at the plan-structure level.
fn plan_compose_c2(ws:[]u8, es:[]u8, m:[]u8, p:i32, ra:i32, rb:i32, subj:i32, rel:i32, idx:i32)i32 {
  let outslot:i32=chain_outslot(ws,es,p);
  if(outslot<0){return -1;}
  let np:i32=plan_new(ws,es,4,subj,rel,idx);
  let cur:i32=n_ref(ws,p,0);
  let first:i32=-1;
  let prev:i32=-1;
  let done:i32=0;
  let guard:i32=0;
  while(done==0){
    if(guard>64){return -1;}
    guard=guard+1;
    if(cur<0){done=1;}
    else {
      if(n_pay(ws,cur,0)==5){done=1;}
      else {
        let c:i32=clone_step(ws,es,cur);
        if(first<0){first=c;}
        if(prev>=0){seq_link(es,prev,c);}
        prev=c;
        cur=seq_next(es,cur);
      }
    }
  }
  if(first<0){return -1;}
  let q1:i32=step_new(ws,es,1);
  n_set_ref(ws,q1,0,outslot); n_set_pay(ws,q1,1,ra); n_set_ref(ws,q1,1,12);
  seq_link(es,prev,q1);
  let q2:i32=step_new(ws,es,1);
  n_set_ref(ws,q2,0,12); n_set_pay(ws,q2,1,rb); n_set_ref(ws,q2,1,13);
  seq_link(es,q1,q2);
  let se:i32=step_new(ws,es,5);
  n_set_ref(ws,se,0,13);
  seq_link(es,q2,se);
  n_set_ref(ws,np,0,first);
  return np;
}
// ============ plan executor ============
// Frame: 16 slots. s0=subject, s1=query rel, s2=answer, s3..s7 scratch,
// s8..s15 scratch for composed second halves. All init 0.
// Returns the EMITted value, -2 on clean plan failure (sentinel),
// -999999 on executor FAIL (unknown step, budget exhaustion).
fn exec_plan(ws:[]u8, es:[]u8, plan:i32, subj:i32)i32 {
  let fr:[]u8=z_alloc(16*4);
  set32(fr,0,subj);
  let cur:i32=n_ref(ws,plan,0);
  let steps:i32=0;
  while(steps<1000){
    if(cur<0){return -999999;}
    let kind:i32=n_pay(ws,cur,0);
    if(kind==1){
      let sv:i32=get32(fr,n_ref(ws,cur,0)*4);
      let rel:i32=n_pay(ws,cur,1);
      set32(fr,n_ref(ws,cur,1)*4,exact_lookup(ws,sv,rel));
      cur=seq_next(es,cur);
    } else { if(kind==5){
      return get32(fr,n_ref(ws,cur,0)*4);
    } else { if(kind==2){
      set32(fr,n_ref(ws,cur,0)*4,get32(fr,n_ref(ws,cur,1)*4));
      cur=seq_next(es,cur);
    } else { if(kind==3){
      if(get32(fr,n_ref(ws,cur,0)*4)==n_pay(ws,cur,1)){cur=n_ref(ws,cur,2);}
      else {cur=seq_next(es,cur);}
    } else { if(kind==4){
      let sl:i32=n_ref(ws,cur,0);
      set32(fr,sl*4,get32(fr,sl*4)+1);
      cur=seq_next(es,cur);
    } else { if(kind==6){
      let cn:i32=n_ref(ws,cur,0);
      let base:i32=n_ref(ws,cur,1);
      let cnt:i32=n_pay(ws,cur,1);
      let dst:i32=n_ref(ws,cur,2);
      let op:i32=n_pay(ws,cn,0);
      if(op==1){
        let acc:i32=0;
        let ok:i32=1;
        let i:i32=0;
        while(i<cnt){
          let v:i32=get32(fr,(base+i)*4);
          if(v==-2){ok=0;}
          acc=acc+v;
          i=i+1;
        }
        if(ok==1){set32(fr,dst*4,acc);}
        else {set32(fr,dst*4,-2);}
      } else {
        set32(fr,dst*4,-2);
      }
      cur=seq_next(es,cur);
    } else {
      return -999999;
    } } } } } }
    steps=steps+1;
  }
  return -999999;
}

// ============ bootstrap miss-policy (frozen generic machinery) ============
// This section is the frozen bootstrap installed at the query-miss dispatch
// point (Q3). A learner may supersede it by authoring its own dispatch
// structure. One-System accounting projection: at most 150 cognition source
// lines for the bootstrap (candidate construction, template instantiation,
// execution dispatch, construct-then-verify loop); actual 157, a +7 variance
// on a projection (K1/K2/K3 carry the verdict, not the projection).
// This section holds the policy orchestration; plan-structure constructors
// live in the plan structures section, the generic executor above,
// test instrumentation below.
// Zero branches on world type, relation id, or subject range. The only
// inputs are the templates and the subject-incident relations (F6).
// `expected` is never consulted during construction (E-ruling).
fn mp_trigger(ws:[]u8, m:[]u8, subj:i32)i32 {
  if(n_incident(ws,m,subj)<1){return 0;}
  return 1;
}
// Direct candidate construction. Fixed order: CHAIN-2, GATHER-n,
// ITERATE-UNTIL. out: u8-backed plan-id array. Returns count.
fn mp_build(ws:[]u8, es:[]u8, m:[]u8, subj:i32, rel:i32, out:[]u8, flags:i32)i32 {
  let rb:[]u8=z_alloc(16*4);
  let nr:i32=incident_fill(ws,m,subj,rb);
  let n:i32=0;
  let dis_c:i32=(flags>>1)&1;
  let dis_i:i32=(flags>>2)&1;
  if(dis_c==0){
    let i:i32=0;
    while(i<nr){
      let j:i32=0;
      while(j<nr){
        if(j!=i){
          set32(out,n*4,plan_chain2(ws,es,m,get32(rb,i*4),get32(rb,j*4),subj,rel,n));
          n=n+1;
        }
        j=j+1;
      }
      i=i+1;
    }
  }
  if(combine_present(ws,m)>=0){
    let k:i32=2;
    while(k<=nr){
      n=mp_gather_k(ws,es,m,rb,nr,k,subj,rel,out,n);
      k=k+1;
    }
  }
  if(dis_i==0){
    let i2:i32=0;
    while(i2<nr){
      set32(out,n*4,plan_iterate(ws,es,m,get32(rb,i2*4),subj,rel,n));
      n=n+1;
      i2=i2+1;
    }
  }
  return n;
}
// GATHER-n candidates for one k: all k-subsets in increasing mask order.
fn mp_gather_k(ws:[]u8, es:[]u8, m:[]u8, rb:[]u8, nr:i32, k:i32, subj:i32, rel:i32, out:[]u8, n:i32)i32 {
  if(k>12){return n;} // frame holds 16 slots; GATHER uses 3..3+k
  let cn:i32=combine_present(ws,m);
  let mask:i32=0;
  let lim:i32=1<<nr;
  while(mask<lim){
    if(popcnt(mask)==k){
      let sb:[]u8=z_alloc(16*4);
      let t:i32=0;
      let b:i32=0;
      while(b<nr){
        if(((mask>>b)&1)==1){set32(sb,t*4,get32(rb,b*4));t=t+1;}
        b=b+1;
      }
      set32(out,n*4,plan_gather(ws,es,m,sb,k,cn,subj,rel,n));
      n=n+1;
    }
    mask=mask+1;
  }
  return n;
}
fn mp_build_compose(ws:[]u8, es:[]u8, m:[]u8, subj:i32, rel:i32, cands:[]u8, vals:[]u8, nc:i32)i32 {
  let i:i32=0;
  while(i<nc){
    let p:i32=get32(cands,i*4);
    let v:i32=get32(vals,i*4);
    if(v!=-2){
      if(v!=-999999){
        if(n_ref(ws,p,1)==1){
          if(nc<60){
          let rb:[]u8=z_alloc(16*4);
          let nr:i32=incident_fill(ws,m,v,rb);
          let a:i32=0;
          while(a<nr){
            let np:i32=plan_extend_read(ws,es,m,p,get32(rb,a*4),subj,rel,nc);
            if(np>=0){
              set32(cands,nc*4,np);
              set32(vals,nc*4,exec_plan(ws,es,np,subj));
              nc=nc+1;
            }
            let b:i32=0;
            while(b<nr){
              if(b!=a){
                let nq:i32=plan_compose_c2(ws,es,m,p,get32(rb,a*4),get32(rb,b*4),subj,rel,nc);
                if(nq>=0){
                  set32(cands,nc*4,nq);
                  set32(vals,nc*4,exec_plan(ws,es,nq,subj));
                  nc=nc+1;
                }
              }
              b=b+1;
            }
            a=a+1;
          }
          }
        }
      }
    }
    i=i+1;
  }
  return nc;
}
fn mp_run(ws:[]u8, es:[]u8, m:[]u8, subj:i32, rel:i32, expected:i32, flags:i32, trace:[]u8)i32 {
  let q:i32=node_alloc(ws);
  n_set_tag(ws,q,7);
  n_set_pay(ws,q,0,subj); n_set_pay(ws,q,1,rel);
  n_set_pay(ws,q,2,expected); n_set_pay(ws,q,3,-2);
  let cands:[]u8=z_alloc(64*4);
  let vals:[]u8=z_alloc(64*4);
  let nc:i32=mp_build(ws,es,m,subj,rel,cands,flags);
  let i:i32=0;
  while(i<nc){
    let p:i32=get32(cands,i*4);
    let v:i32=exec_plan(ws,es,p,subj);
    set32(vals,i*4,v);
    trace_add(trace,n_ref(ws,p,1),n_pay(ws,p,2),v);
    i=i+1;
  }
  let nd:i32=nc;
  nc=mp_build_compose(ws,es,m,subj,rel,cands,vals,nc);
  i=nd;
  while(i<nc){
    let p2:i32=get32(cands,i*4);
    trace_add(trace,n_ref(ws,p2,1),n_pay(ws,p2,2),get32(vals,i*4));
    i=i+1;
  }
  let masked:i32=flags&1;
  let sel:i32=-1;
  let ans:i32=-2;
  let found:i32=0;
  i=0;
  while(i<nc){
    if(found==0){
      let v2:i32=get32(vals,i*4);
      if(masked==0){
        if(expected!=-2){
          if(v2==expected){sel=i;ans=v2;found=1;}
        }
      } else {
        if(v2!=-2){
          if(v2!=-999999){sel=i;ans=v2;found=1;}
        }
      }
    }
    i=i+1;
  }
  if(sel>=0){
    if(masked==0){
      let sp:i32=get32(cands,sel*4);
      edge_add(es,sp,q,2);
      edge_add(es,sp,q,6);
      n_set_pay(ws,q,3,ans);
    }
  }
  return ans;
}
// ============ end bootstrap miss-policy ============
// Query: exact-key hit returns immediately (miss-policy never fires).
// Miss with no incident relations declines. Else the bootstrap runs.
fn query(ws:[]u8, es:[]u8, m:[]u8, subj:i32, rel:i32, expected:i32, flags:i32, trace:[]u8)i32 {
  set32(m,0,get32(m,0)+1);
  let hit:i32=exact_lookup(ws,subj,rel);
  if(hit!=-2){return hit;}
  if(mp_trigger(ws,m,subj)==0){return -2;}
  return mp_run(ws,es,m,subj,rel,expected,flags,trace);
}

fn trace_new()[]u8 {
  let t:[]u8=z_alloc(4+64*12);
  set32(t,0,0);
  return t;
}
fn trace_add(t:[]u8, tm:i32, idx:i32, v:i32)void {
  let n:i32=get32(t,0);
  if(n<64){
    set32(t,4+n*12,tm); set32(t,4+n*12+4,idx); set32(t,4+n*12+8,v);
    set32(t,0,n+1);
  }
  return;
}
// ============ test battery ============
// Own synthetic data only. No FW1-FW9. Maps to prereg P1-P5 and F2.
fn trace_eq(t1:[]u8, t2:[]u8)i32 {
  let n1:i32=get32(t1,0);
  let n2:i32=get32(t2,0);
  if(n1!=n2){return 0;}
  let i:i32=0;
  while(i<n1*3){
    if(get32(t1,4+i*4)!=get32(t2,4+i*4)){return 0;}
    i=i+1;
  }
  return 1;
}
fn trace_has_tm(t:[]u8, tm:i32)i32 {
  let n:i32=get32(t,0);
  let i:i32=0;
  while(i<n){
    if(get32(t,4+i*12)==tm){return 1;}
    i=i+1;
  }
  return 0;
}
// Each test builds its own workspace. Returns 1 on pass.
fn test_T1()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,11,102);
  teach(ws,es,m,101,12,105);
  teach(ws,es,m,102,12,201);
  teach(ws,es,m,105,11,202);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,40,201,0,tr);
  if(ans==201){return 1;}
  return 0;
}
// F2: the e-ablation. Construction must be expected-independent;
// expected may only affect selection.
fn test_F2()i32 {
  let ws1:[]u8=ws_new();
  let es1:[]u8=es_new();
  let m1:[]u8=meta_new();
  teach(ws1,es1,m1,101,11,102);
  teach(ws1,es1,m1,101,12,105);
  teach(ws1,es1,m1,102,12,201);
  teach(ws1,es1,m1,105,11,202);
  let tra:[]u8=trace_new();
  let a:i32=query(ws1,es1,m1,101,40,201,0,tra);
  let ws2:[]u8=ws_new();
  let es2:[]u8=es_new();
  let m2:[]u8=meta_new();
  teach(ws2,es2,m2,101,11,102);
  teach(ws2,es2,m2,101,12,105);
  teach(ws2,es2,m2,102,12,201);
  teach(ws2,es2,m2,105,11,202);
  let trb:[]u8=trace_new();
  let b:i32=query(ws2,es2,m2,101,40,202,0,trb);
  let ws3:[]u8=ws_new();
  let es3:[]u8=es_new();
  let m3:[]u8=meta_new();
  teach(ws3,es3,m3,101,11,102);
  teach(ws3,es3,m3,101,12,105);
  teach(ws3,es3,m3,102,12,201);
  teach(ws3,es3,m3,105,11,202);
  let trc:[]u8=trace_new();
  let c:i32=query(ws3,es3,m3,101,40,202,1,trc);
  // A selects 201, B selects 202 (expected affects selection),
  // C (masked) falls back to first non-sentinel = 201,
  // and all three construction traces are identical.
  if(a!=201){return 0;}
  if(b!=202){return 0;}
  if(c!=201){return 0;}
  if(trace_eq(tra,trb)==0){return 0;}
  if(trace_eq(tra,trc)==0){return 0;}
  return 1;
}
// P2: GATHER-n with a supplied combining structure (config i).
fn test_T2()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,110,31,10);
  teach(ws,es,m,110,32,20);
  teach(ws,es,m,110,33,30);
  let cn:i32=node_alloc(ws);
  n_set_tag(ws,cn,8);
  n_set_pay(ws,cn,0,1);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,110,41,60,0,tr);
  if(ans!=60){return 0;}
  if(trace_has_tm(tr,2)==0){return 0;}
  return 1;
}
// GATHER declines without a combining structure.
fn test_T2b()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,110,31,10);
  teach(ws,es,m,110,32,20);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,110,41,30,0,tr);
  if(ans!=-2){return 0;}
  if(trace_has_tm(tr,2)==1){return 0;}
  return 1;
}
// P3: grandparent via CHAIN-2.
fn test_T3a()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,21,102);
  teach(ws,es,m,101,22,106);
  teach(ws,es,m,102,22,103);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,42,103,0,tr);
  if(ans==103){return 1;}
  return 0;
}
// P3: depth via ITERATE-UNTIL.
fn test_T3b()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,21,102);
  teach(ws,es,m,102,21,103);
  teach(ws,es,m,103,21,104);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,43,3,0,tr);
  if(ans==3){return 1;}
  return 0;
}
// P4: 3-hop via plan-structure composition. No new template.
fn test_T4()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,11,102);
  teach(ws,es,m,101,12,107);
  teach(ws,es,m,102,12,103);
  teach(ws,es,m,102,19,108);
  teach(ws,es,m,103,13,104);
  teach(ws,es,m,103,19,109);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,40,104,0,tr);
  if(ans!=104){return 0;}
  if(trace_has_tm(tr,4)==0){return 0;}
  return 1;
}
// P5: separation. Exact-key hits never fire the miss-policy;
// composition induces nothing.
fn test_T5()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,110,44,77);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,110,44,77,0,tr);
  if(ans!=77){return 0;}
  if(get32(tr,0)!=0){return 0;}
  if(combine_present(ws,m)>=0){return 0;}
  return 1;
}
// Template ablation: without ITERATE-UNTIL, depth fails but two-hop holds.
fn test_ABL_I()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,21,102);
  teach(ws,es,m,102,21,103);
  teach(ws,es,m,103,21,104);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,43,3,4,tr);
  if(ans!=-2){return 0;}
  let ws2:[]u8=ws_new();
  let es2:[]u8=es_new();
  let m2:[]u8=meta_new();
  teach(ws2,es2,m2,101,11,102);
  teach(ws2,es2,m2,101,12,105);
  teach(ws2,es2,m2,102,12,201);
  teach(ws2,es2,m2,105,11,202);
  let tr2:[]u8=trace_new();
  let ans2:i32=query(ws2,es2,m2,101,40,201,4,tr2);
  if(ans2!=201){return 0;}
  return 1;
}
// Template ablation: without CHAIN-2, two-hop fails.
fn test_ABL_C()i32 {
  let ws:[]u8=ws_new();
  let es:[]u8=es_new();
  let m:[]u8=meta_new();
  teach(ws,es,m,101,11,102);
  teach(ws,es,m,101,12,105);
  teach(ws,es,m,102,12,201);
  teach(ws,es,m,105,11,202);
  let tr:[]u8=trace_new();
  let ans:i32=query(ws,es,m,101,40,201,2,tr);
  if(ans!=-2){return 0;}
  return 1;
}
fn run_all()i32 {
  let pass:i32=0;
  let total:i32=0;
  total=total+1; if(test_T1()==1){pass=pass+1; emit("T1(P1 two-hop) PASS\n");} else {emit("T1(P1 two-hop) FAIL\n");}
  total=total+1; if(test_F2()==1){pass=pass+1; emit("F2(e-ablation) PASS\n");} else {emit("F2(e-ablation) FAIL\n");}
  total=total+1; if(test_T2()==1){pass=pass+1; emit("T2(P2 gather) PASS\n");} else {emit("T2(P2 gather) FAIL\n");}
  total=total+1; if(test_T2b()==1){pass=pass+1; emit("T2b(gather-decline) PASS\n");} else {emit("T2b(gather-decline) FAIL\n");}
  total=total+1; if(test_T3a()==1){pass=pass+1; emit("T3a(P3 grandparent) PASS\n");} else {emit("T3a(P3 grandparent) FAIL\n");}
  total=total+1; if(test_T3b()==1){pass=pass+1; emit("T3b(P3 depth) PASS\n");} else {emit("T3b(P3 depth) FAIL\n");}
  total=total+1; if(test_T4()==1){pass=pass+1; emit("T4(P4 3-hop compose) PASS\n");} else {emit("T4(P4 3-hop compose) FAIL\n");}
  total=total+1; if(test_T5()==1){pass=pass+1; emit("T5(P5 separation) PASS\n");} else {emit("T5(P5 separation) FAIL\n");}
  total=total+1; if(test_ABL_I()==1){pass=pass+1; emit("ABL-I(iter-ablation) PASS\n");} else {emit("ABL-I(iter-ablation) FAIL\n");}
  total=total+1; if(test_ABL_C()==1){pass=pass+1; emit("ABL-C(chain-ablation) PASS\n");} else {emit("ABL-C(chain-ablation) FAIL\n");}
  emit("TOTAL ");
  e32(pass);
  emit("/");
  e32(total);
  emit("\n");
  if(pass==total){return 0;}
  return 1;
}
fn main()i32 {
  return run_all();
}

// lt2_main.zag -- LT2 driver (charter 221). ONE persistent learner, ONE
// process, NO RESET, NO RECOMPILATION, NO TASK LABELS.
//
// Two arms are run over the SAME eight-stage world, in this order, each with
// its own fresh learner instance and its own fresh arena:
//
//   ARM 0  policy = 0   never evict. A full BIND or PLAN table makes the
//                        learner DECLINE. This is the naive durable-store
//                        baseline.
//   ARM 1  policy = 1   durable store: evict the least-recently-used entry
//                        (BIND, PLAN and the template store) instead of
//                        declining.
//
// Everything else -- the world, the goal records, the episode stream, the
// single generic interface -- is byte-identical between the arms, so any
// difference is attributable to the eviction policy and nothing else.
//
// The only learner entry points are lt_episode and lt_query. Neither takes a
// stage id, a stage name, a reuse hint, a cross-stage goal tag, or any
// correctness signal. `kind` is the modality channel the frozen core
// already requires. Correctness is evaluator-only: it is the INDEPENDENT
// oracle (lt_oracle, a fresh fixed-point walk of ret_gen / vfy_gen /
// cnt_gen over the live arena with no learner state) compared against the
// learner's own answer.
//
// Metrics emitted per query: outcome, family trials consumed, fact-checks,
// template hit/miss, template origin query index, cross-world fire,
// reuse-of-reuse fire, plan drops, declines, and the learner's own memory
// occupancy. Filled by the frozen counters.

fn e2_feed(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,kind:i32,id:i32)void {
  if(kind==0){
    e2_ret(id,RB);
    lt_episode(L,LT,A,K,0,get32(RB,0),get32(RB,4),RB,CB,TO,SE);
  }
  if(kind==1){
    e2_vfy(id,CB);
    lt_episode(L,LT,A,K,1,get32(CB,0),0,RB,CB,TO,SE);
  }
  if(kind==2){
    e2_cnt(id,RB);
    lt_episode(L,LT,A,K,2,get32(RB,0),get32(RB,4),RB,CB,TO,SE);
  }
  return;
}
fn e2_one(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,v:i32)void {
  let kind:i32=v/100;
  e2_feed(L,LT,A,K,RB,CB,TO,SE,kind,v-kind*100);
  return;
}
fn e2_stage(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,s:i32)void {
  let n:i32=8;
  if(s==1){ n=4; }
  if(s==2){ n=5; }
  if(s==3){ n=8; }
  if(s==4){ n=4; }
  if(s==5){ n=4; }
  if(s==6){ n=8; }
  if(s==7){ n=5; }
  let k:i32=0;
  while(k<n){
    e2_one(L,LT,A,K,RB,CB,TO,SE,e2_flat(s,k));
    k=k+1;
  }
  return;
}
fn e2_world(A:[]u8,s:i32)void {
  if(s==0){ w2A(A); return; }
  if(s==1){ w2B(A); return; }
  if(s==2){ w2C(A); return; }
  if(s==3){ w2D(A); return; }
  if(s==4){ w2E(A); return; }
  if(s==5){ w2F(A); return; }
  if(s==6){ w2G(A); return; }
  w2H(A);
  return;
}
fn e2_put(b:[]u8,c:i32,X:[]u8)i32 {
  c=o_app(b,c,"n=");
  c=o_i64(b,c,get32(X,0) as i64);
  c=o_app(b,c," v=");
  let i:i32=0;
  let n:i32=get32(X,0);
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(X,4+i*4) as i64);
    i=i+1;
  }
  c=o_nl(b,c);
  return c;
}
// one goal query, scored against the independent oracle
fn e2_ask(b:[]u8,c:i32,L:[]u8,LT:[]u8,A:[]u8,K:[]u8,R:[]u8,ANS:[]u8,OR:[]u8,G:[]u8,DECL:[]u8,lbl:[]u8,wi:i32)i32 {
  mk2_goal(wi,G);
  lt2_decl(wi,DECL);
  let oc:i32=lt_oracle(A,G,OR,K);
  let code:i32=lt_query(L,LT,A,G,K,R,ANS);
  let ok:i32=0;
  if(get32(DECL,0)==-1){
    if(code==0){ ok=1; }
  } else {
    if(code==1){
      if(oc==1){ if(lt_ans_eq(ANS,OR)==1){ ok=1; } }
    }
  }
  c=o_app(b,c,"Q st=");
  c=o_app(b,c,lbl);
  c=o_app(b,c," ok=");
  c=o_i64(b,c,ok as i64);
  c=o_app(b,c," code=");
  c=o_i64(b,c,code as i64);
  c=o_app(b,c," oracleok=");
  c=o_i64(b,c,oc as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(R,4) as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(R,84) as i64);
  c=o_app(b,c," tmpl=");
  c=o_i64(b,c,get32(R,16) as i64);
  c=o_app(b,c," orgq=");
  c=o_i64(b,c,get32(R,20) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(R,36) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(R,40) as i64);
  c=o_app(b,c," pld=");
  c=o_i64(b,c,get32(R,76) as i64);
  c=o_app(b,c," dec=");
  c=o_i64(b,c,get32(R,80) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(R,24) as i64);
  c=o_app(b,c," bcap=");
  c=o_i64(b,c,get32(LT,88) as i64);
  c=o_app(b,c," memL=");
  c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT=");
  c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," retcov=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," vfycov=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," cntcov=");
  c=o_i64(b,c,get32(L,8496) as i64);
  c=o_app(b,c," fviol=");
  c=o_i64(b,c,get32(LT,8) as i64);
  c=o_app(b,c," plansat=");
  c=o_i64(b,c,get32(LT,100) as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"  ANS ");
  c=o_app(b,c,lbl);
  c=e2_put(b,c,ANS);
  c=o_app(b,c,"  ORC ");
  c=o_app(b,c,lbl);
  c=e2_put(b,c,OR);
  set32(DECL,4,ok);
  return c;
}
fn e2_arm(b:[]u8,c:i32,pol:i32)i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt2_new();
  let K:[]u8=z_alloc(64);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let ANS:[]u8=z_alloc(256);
  let OR:[]u8=z_alloc(256);
  let DECL:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  set32(LT,68,1);
  set32(LT,96,pol);
  c=o_app(b,c,"ARM policy=");
  c=o_i64(b,c,pol as i64);
  c=o_nl(b,c);
  let okA:i32=0;
  let okB:i32=0;
  let okC:i32=0;
  let okD:i32=0;
  let okF:i32=0;
  let okG:i32=0;
  let okH:i32=0;
  let okR:i32=0;
  let okF2:i32=0;
  let okDX:i32=0;
  let okDY:i32=0;

  w2A(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,0);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"A2",0);
  okA=get32(DECL,4);

  w2B(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,1);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"B2",1);
  okB=get32(DECL,4);

  w2C(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,2);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"C2",2);
  okC=get32(DECL,4);

  w2D(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,3);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"D2",3);
  okD=get32(DECL,4);

  w2E(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,4);

  w2F(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,5);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"F2",4);
  okF=get32(DECL,4);

  w2F_ext(A);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"F2ext",7);
  okF2=get32(DECL,4);

  w2G(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,6);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"G2",5);
  okG=get32(DECL,4);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"DX",9);
  okDX=get32(DECL,4);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"DY",10);
  okDY=get32(DECL,4);

  w2H(A);
  e2_stage(L,LT,A,K,RB,CB,TO,SE,7);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"H2",6);
  okH=get32(DECL,4);
  c=e2_ask(b,c,L,LT,A,K,R,ANS,OR,G,DECL,"A2retain",8);
  okR=get32(DECL,4);

  // ---- FRESH baseline at the F2 composition goal, same arena ----
  let FL:[]u8=z_alloc(16384);
  let FT:[]u8=z_alloc(8192);
  let FR:[]u8=z_alloc(128);
  let FANS:[]u8=z_alloc(256);
  let FG:[]u8=z_alloc(512);
  let FZ:[]u8=z_alloc(16384);
  set32(FT,68,1);
  set32(FT,96,pol);
  // FRESH0: zero episodes at all
  lt2_copy(FL,FZ,16384);
  mk2_goal(4,FG);
  let f0c:i32=lt_query(FL,FT,A,FG,K,FR,FANS);
  let f0o:i32=lt_oracle(A,FG,OR,K);
  let f0ok:i32=0;
  if(f0c==1){ if(f0o==1){ if(lt_ans_eq(FANS,OR)==1){ f0ok=1; } } }
  c=o_app(b,c,"BASE F2fresh0 ok=");
  c=o_i64(b,c,f0ok as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(FR,4) as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(FR,84) as i64);
  c=o_nl(b,c);
  // FRESH1: only stage F's episodes, then the F2 goal
  let G1:[]u8=z_alloc(16384);
  let T1:[]u8=z_alloc(8192);
  let G1A:[]u8=lt2_new();
  w2A(G1A);
  w2B(G1A);
  w2C(G1A);
  w2D(G1A);
  w2E(G1A);
  w2F(G1A);
  w2F_ext(G1A);
  set32(T1,68,1);
  set32(T1,96,pol);
  e2_stage(FL,FT,A,K,RB,CB,TO,SE,5);
  mk2_goal(4,FG);
  let f1c:i32=lt_query(FL,FT,A,FG,K,FR,FANS);
  let f1o:i32=lt_oracle(A,FG,OR,K);
  let f1ok:i32=0;
  if(f1c==1){ if(f1o==1){ if(lt_ans_eq(FANS,OR)==1){ f1ok=1; } } }
  c=o_app(b,c,"BASE F2fresh1 ok=");
  c=o_i64(b,c,f1ok as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(FR,4) as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(FR,84) as i64);
  c=o_nl(b,c);

  c=o_app(b,c,"ARMSUM pol=");
  c=o_i64(b,c,pol as i64);
  c=o_app(b,c," okA=");
  c=o_i64(b,c,okA as i64);
  c=o_app(b,c," okB=");
  c=o_i64(b,c,okB as i64);
  c=o_app(b,c," okC=");
  c=o_i64(b,c,okC as i64);
  c=o_app(b,c," okD=");
  c=o_i64(b,c,okD as i64);
  c=o_app(b,c," okF=");
  c=o_i64(b,c,okF as i64);
  c=o_app(b,c," okF2=");
  c=o_i64(b,c,okF2 as i64);
  c=o_app(b,c," okG=");
  c=o_i64(b,c,okG as i64);
  c=o_app(b,c," okH=");
  c=o_i64(b,c,okH as i64);
  c=o_app(b,c," okR=");
  c=o_i64(b,c,okR as i64);
  c=o_app(b,c," okDX=");
  c=o_i64(b,c,okDX as i64);
  c=o_app(b,c," okDY=");
  c=o_i64(b,c,okDY as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,(okA+okB+okC+okD+okF+okF2+okG+okDX+okDY+okR) as i64);
  c=o_app(b,c,"/10 declined_at_H=");
  c=o_i64(b,c,okH as i64);
  c=o_app(b,c," totalcost=");
  c=o_i64(b,c,get32(LT,48) as i64);
  c=o_app(b,c," costep=");
  c=o_i64(b,c,get32(LT,44) as i64);
  c=o_app(b,c," tmplb=");
  c=o_i64(b,c,get32(LT,24) as i64);
  c=o_app(b,c," tmplh=");
  c=o_i64(b,c,get32(LT,28) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(LT,32) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(LT,36) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(LT,16) as i64);
  c=o_app(b,c," bmiss=");
  c=o_i64(b,c,get32(LT,20) as i64);
  c=o_app(b,c," pldrop=");
  c=o_i64(b,c,get32(LT,60) as i64);
  c=o_app(b,c," bcap=");
  c=o_i64(b,c,get32(LT,88) as i64);
  c=o_app(b,c," plansat=");
  c=o_i64(b,c,get32(LT,100) as i64);
  c=o_app(b,c," plansat_stage=");
  c=o_i64(b,c,get32(LT,104) as i64);
  c=o_app(b,c," fviol=");
  c=o_i64(b,c,get32(LT,8) as i64);
  c=o_app(b,c," declines=");
  c=o_i64(b,c,get32(LT,40) as i64);
  c=o_app(b,c," memL=");
  c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT=");
  c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," facts=");
  c=o_i64(b,c,get32(A,0) as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  c=e2_arm(B,c,0);
  c=e2_arm(B,c,1);
  _zag_print(B[0..c]);
  return 0;
}

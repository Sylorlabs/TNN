  if(id==9){ set32(rb,0,603); set32(rb,4,40); return; }
  set32(rb,0,703); set32(rb,4,50);
  return;
}
// modality 1: VERIFY episodes (explicit subject/relation/object triples)
fn ep_vfy(id:i32,C:[]u8)void {
  lt_chain_clear(C);
  if(id==0){ lt_chain_add(C,10,105,50); lt_chain_add(C,10,106,60); return; }
  if(id==1){ lt_chain_add(C,11,105,50); lt_chain_add(C,11,106,60); return; }
  if(id==2){ lt_chain_add(C,10,203,140); lt_chain_add(C,10,205,160); return; }
  if(id==3){ lt_chain_add(C,11,203,140); lt_chain_add(C,11,205,161); return; }
  if(id==4){ lt_chain_add(C,12,203,140); lt_chain_add(C,12,205,160); return; }
  if(id==5){ lt_chain_add(C,110,201,120); return; }
  if(id==6){ lt_chain_add(C,111,201,120); return; }
  if(id==7){ lt_chain_add(C,112,201,120); return; }
  if(id==8){ lt_chain_add(C,113,201,120); return; }
  if(id==9){ lt_chain_add(C,114,201,120); return; }
  if(id==10){ lt_chain_add(C,115,201,120); return; }
  if(id==11){ lt_chain_add(C,30,302,60); return; }
  if(id==12){ lt_chain_add(C,31,302,60); return; }
  if(id==13){ lt_chain_add(C,200,110,50); lt_chain_add(C,200,111,60); return; }
  if(id==14){ lt_chain_add(C,201,110,50); lt_chain_add(C,201,111,60); return; }
  if(id==15){ lt_chain_add(C,900,501,600); return; }
  if(id==16){ lt_chain_add(C,900,502,601); return; }
  if(id==17){ lt_chain_add(C,900,503,602); return; }
  if(id==18){ lt_chain_add(C,900,504,603); return; }
  if(id==19){ lt_chain_add(C,10,305,90); return; }
  if(id==20){ lt_chain_add(C,40,602,80); lt_chain_add(C,40,603,90); return; }
  if(id==21){ lt_chain_add(C,41,602,80); lt_chain_add(C,41,603,90); return; }
  if(id==22){ lt_chain_add(C,113,201,121); return; }
  if(id==23){ lt_chain_add(C,50,702,120); lt_chain_add(C,50,703,130); return; }
  if(id==24){ lt_chain_add(C,51,702,120); lt_chain_add(C,51,703,130); return; }
  lt_chain_add(C,13,201,120);
  return;
}

// ================= goal records ====================================
fn gq_b(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag);
  set32(G,4,nn);
  return 8;
}
fn gq_n(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag);
  set32(G,off+4,nf);
  return off+8;
}
fn gq_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn gq_l(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn gq_k(G:[]u8,off:i32,k:i32,dn:i32,sn:i32)i32 {
  set32(G,off,k);
  set32(G,off+4,dn);
  set32(G,off+8,0);
  set32(G,off+12,0);
  set32(G,off+16,sn);
  set32(G,off+20,0);
  set32(G,off+24,0);
  return off+28;
}

fn mkGA(G:[]u8)void {
  let o:i32=gq_b(G,9001,3);
  o=gq_n(G,o,7101,2); o=gq_f(G,o,102); o=gq_f(G,o,30);
  o=gq_n(G,o,7102,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,105); o=gq_f(G,o,50);
  o=gq_f(G,o,0); o=gq_f(G,o,106); o=gq_f(G,o,60);
  o=gq_n(G,o,7103,3); o=gq_f(G,o,107); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
fn mkGB(G:[]u8)void {
  let o:i32=gq_b(G,9002,2);
  o=gq_n(G,o,7201,2); o=gq_f(G,o,201); o=gq_f(G,o,120);
  o=gq_n(G,o,7202,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,203); o=gq_f(G,o,140);
  o=gq_f(G,o,0); o=gq_f(G,o,205); o=gq_f(G,o,160);
  o=gq_l(G,o,1);
  o=gq_k(G,o,2,1,0);
  return;
}
fn mkGC(G:[]u8)void {
  let o:i32=gq_b(G,9003,3);
  o=gq_n(G,o,7301,2); o=gq_f(G,o,301); o=gq_f(G,o,50);
  o=gq_n(G,o,7302,4); o=gq_f(G,o,1);
  o=gq_f(G,o,0); o=gq_f(G,o,302); o=gq_f(G,o,60);
  o=gq_n(G,o,7303,3); o=gq_f(G,o,303); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
fn mkGD(G:[]u8)void {
  let o:i32=gq_b(G,9004,3);
  o=gq_n(G,o,7401,2); o=gq_f(G,o,109); o=gq_f(G,o,30);
  o=gq_n(G,o,7402,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,110); o=gq_f(G,o,50);
  o=gq_f(G,o,0); o=gq_f(G,o,111); o=gq_f(G,o,60);
  o=gq_n(G,o,7403,3); o=gq_f(G,o,112); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
fn mkGF(G:[]u8)void {
  let o:i32=gq_b(G,9005,4);
  o=gq_n(G,o,7501,2); o=gq_f(G,o,102); o=gq_f(G,o,30);
  o=gq_n(G,o,7502,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,105); o=gq_f(G,o,50);
  o=gq_f(G,o,0); o=gq_f(G,o,106); o=gq_f(G,o,60);
  o=gq_n(G,o,7504,4); o=gq_f(G,o,1);
  o=gq_f(G,o,0); o=gq_f(G,o,305); o=gq_f(G,o,90);
  o=gq_n(G,o,7503,3); o=gq_f(G,o,107); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,3,3,2);
  return;
}
fn mkGG(G:[]u8)void {
  let o:i32=gq_b(G,9006,4);
  o=gq_n(G,o,7601,2); o=gq_f(G,o,601); o=gq_f(G,o,70);
  o=gq_n(G,o,7602,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,602); o=gq_f(G,o,80);
  o=gq_f(G,o,0); o=gq_f(G,o,603); o=gq_f(G,o,90);
  o=gq_n(G,o,7604,4); o=gq_f(G,o,1);
  o=gq_f(G,o,0); o=gq_f(G,o,604); o=gq_f(G,o,100);
  o=gq_n(G,o,7603,3); o=gq_f(G,o,603); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,3,3,2);
  return;
}
fn mkHG(G:[]u8)void {
  let o:i32=gq_b(G,9007,4);
  o=gq_n(G,o,7701,2); o=gq_f(G,o,701); o=gq_f(G,o,110);
  o=gq_n(G,o,7702,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,702); o=gq_f(G,o,120);
  o=gq_f(G,o,0); o=gq_f(G,o,703); o=gq_f(G,o,130);
  o=gq_n(G,o,7704,4); o=gq_f(G,o,1);
  o=gq_f(G,o,0); o=gq_f(G,o,704); o=gq_f(G,o,140);
  o=gq_n(G,o,7703,3); o=gq_f(G,o,703); o=gq_f(G,o,2); o=gq_f(G,o,0);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,3,3,2);
  return;
}
fn mkGP(G:[]u8)void {
  let o:i32=gq_b(G,9008,3);
  o=gq_n(G,o,7801,2); o=gq_f(G,o,201); o=gq_f(G,o,120);
  o=gq_n(G,o,7802,4); o=gq_f(G,o,1);
  o=gq_f(G,o,0); o=gq_f(G,o,203); o=gq_f(G,o,140);
  o=gq_n(G,o,7803,3); o=gq_f(G,o,205); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
// harness-side dispatch; `which` never reaches the learner
// C500-R1 FIX 2: 8 and 9 previously fell through to mkGP, so the TTC
// harness was probing the wrong goal at stages 5 and 7.  Goal 8 is GA over
// the post-F-extension arena, goal 9 is GF over that same arena.  Both reuse
// the existing GA / GF builders; only the declared ANSWERS differ, because
// the extension changes fact counts (see lt_decl).
fn mk_goal(which:i32,G:[]u8)void {
  if(which==0){ mkGA(G); return; }
  if(which==1){ mkGB(G); return; }
  if(which==2){ mkGC(G); return; }
  if(which==3){ mkGD(G); return; }
  if(which==4){ mkGF(G); return; }
  if(which==5){ mkGG(G); return; }
  if(which==6){ mkHG(G); return; }
  if(which==8){ mkGA(G); return; }
  if(which==9){ mkGF(G); return; }
  mkGP(G);
  return;
}

// ================= evaluator-declared correct answers =============
// which: 0 GA, 1 GB, 2 GC, 3 GD, 4 GF, 5 GG, 6 HG (must decline),
//       7 GP, 8 GA after the 107 extension, 9 GF after the extension.
// X[0] == -1 means the correct behaviour is DECLINE.
fn lt_decl(which:i32,X:[]u8)void {
  set32(X,0,0);
  if(which==0){
    ans_append(X,8);
    ans_append(X,10); ans_append(X,11); ans_append(X,12); ans_append(X,13);
    ans_append(X,14); ans_append(X,15); ans_append(X,16); ans_append(X,17);
    ans_append(X,5);
    ans_append(X,10); ans_append(X,11); ans_append(X,12); ans_append(X,13);
    ans_append(X,14);
    ans_append(X,1); ans_append(X,2);
    return;
  }
  if(which==1){
    ans_append(X,6);
    ans_append(X,110); ans_append(X,111); ans_append(X,112);
    ans_append(X,113); ans_append(X,114); ans_append(X,115);
    ans_append(X,3);
    ans_append(X,110); ans_append(X,111); ans_append(X,112);
    return;
  }
  if(which==2){
    ans_append(X,8);
    ans_append(X,30); ans_append(X,31); ans_append(X,32); ans_append(X,33);
    ans_append(X,34); ans_append(X,35); ans_append(X,36); ans_append(X,37);
    ans_append(X,8);
    ans_append(X,30); ans_append(X,31); ans_append(X,32); ans_append(X,33);
    ans_append(X,34); ans_append(X,35); ans_append(X,36); ans_append(X,37);
    ans_append(X,1); ans_append(X,2);
    return;
  }
  if(which==3){
    ans_append(X,8);
    ans_append(X,200); ans_append(X,201); ans_append(X,202); ans_append(X,203);
    ans_append(X,204); ans_append(X,205); ans_append(X,206); ans_append(X,207);
    ans_append(X,5);
    ans_append(X,200); ans_append(X,201); ans_append(X,202);
    ans_append(X,203); ans_append(X,204);
    ans_append(X,1); ans_append(X,2);
    return;
  }
  if(which==4){
    ans_append(X,8);
    ans_append(X,10); ans_append(X,11); ans_append(X,12); ans_append(X,13);
    ans_append(X,14); ans_append(X,15); ans_append(X,16); ans_append(X,17);
    ans_append(X,5);
    ans_append(X,10); ans_append(X,11); ans_append(X,12);
    ans_append(X,13); ans_append(X,14);
    ans_append(X,4);
    ans_append(X,11); ans_append(X,12); ans_append(X,13); ans_append(X,14);
    ans_append(X,1); ans_append(X,2);
    return;
  }
  if(which==5){
    ans_append(X,8);
    ans_append(X,40); ans_append(X,41); ans_append(X,42); ans_append(X,43);
    ans_append(X,44); ans_append(X,45); ans_append(X,46); ans_append(X,47);
    ans_append(X,5);
    ans_append(X,40); ans_append(X,41); ans_append(X,42);
    ans_append(X,43); ans_append(X,44);
    ans_append(X,3);
    ans_append(X,42); ans_append(X,43); ans_append(X,44);
    ans_append(X,1); ans_append(X,2);
    return;
  }
  if(which==6){ set32(X,0,-1); return; }
  if(which==7){
    ans_append(X,6);
    ans_append(X,110); ans_append(X,111); ans_append(X,112);
    ans_append(X,113); ans_append(X,114); ans_append(X,115);
    ans_append(X,6);
    ans_append(X,110); ans_append(X,111); ans_append(X,112);
    ans_append(X,113); ans_append(X,114); ans_append(X,115);
    ans_append(X,1); ans_append(X,3);
    return;
  }
  if(which==8){
    ans_append(X,8);
    ans_append(X,10); ans_append(X,11); ans_append(X,12); ans_append(X,13);
    ans_append(X,14); ans_append(X,15); ans_append(X,16); ans_append(X,17);
    ans_append(X,5);
    ans_append(X,10); ans_append(X,11); ans_append(X,12);
    ans_append(X,13); ans_append(X,14);
    ans_append(X,1); ans_append(X,3);
    return;
  }
  ans_append(X,8);
  ans_append(X,10); ans_append(X,11); ans_append(X,12); ans_append(X,13);
  ans_append(X,14); ans_append(X,15); ans_append(X,16); ans_append(X,17);
  ans_append(X,5);
  ans_append(X,10); ans_append(X,11); ans_append(X,12);
  ans_append(X,13); ans_append(X,14);
  ans_append(X,4);
  ans_append(X,11); ans_append(X,12); ans_append(X,13); ans_append(X,14);
  ans_append(X,1); ans_append(X,3);
  return;
}// lt_life.zag -- the ADDITIVE lifetime layer of LIFETIME-AB-1.
//
// No frozen function is modified. Nothing below is in c8_learn.zag.
// The learner is reached only through lt_episode and lt_query.
//
// lt_episode(L,LT,A,K,kind,p1,p2,p3,RB,CB,TO,SE) -> observed value
// lt_query  (L,LT,A,G,K,R)                        -> code in R[0]
//
// Neither entry point receives a stage id, a stage name, a goal tag,
// a cross-stage reference, or any correctness signal. `kind` is the
// modality channel that the frozen core itself already requires
// (ret_episode / vfy_episode / cnt_episode).
//
// LT layout (8192 bytes):
//   0 watermark (nfacts at last index rebuild)
//   4 n_revise        8 n_fun_viol    12 n_queries
//   16 n_bind_hit     20 n_bind_miss  24 n_tmpl_built  28 n_tmpl_hit
//   32 n_reuse_xworld 36 n_reuse_rer  40 n_decline     44 cost_ep
//   48 cost_q         52 canon_goal_n 56 canon_need_n  60 n_evict_plan
//   64 n_evict_bind   68 refresh_on   72 n_answered    76 n_stale
//   80 n_misbind      84 n_plan_cap   88 n_bind_cap    92 nev
//   96 spare
//   template store 200: 12 entries x 48B
//   bind store     800: 16 entries x 16B
//   fun store     1100: 48 entries x 96B
//   event ring    5800: 80 entries x 12B

fn lt_tb(e:i32)i32 { return 200+e*48; }
fn lt_bb(e:i32)i32 { return 800+e*16; }
fn lt_fb(e:i32)i32 { return 1100+e*96; }
fn lt_eb(e:i32)i32 { return 5800+e*12; }

// ---- event ring (learner-owned; kinds are learner-internal) ----
fn lt_ev(LT:[]u8,k:i32,a:i32,b:i32)void {
  let n:i32=get32(LT,92);
  if(n<80){
    set32(LT,lt_eb(n),k);
    set32(LT,lt_eb(n)+4,a);
    set32(LT,lt_eb(n)+8,b);
    set32(LT,92,n+1);
  }
  return;
}

// ---- purely descriptive signatures ----
fn lt_sig_need(G:[]u8,ni:i32)i32 {
  let nf:i32=need_nf(G,ni);
  let nl:i32=g_nlinks(G);
  let k1:i32=0;
  let k2:i32=0;
  let k3:i32=0;
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,1)==ni){
      let k:i32=link_w(G,l,0);
      if(k==1){ k1=k1+1; }
      if(k==2){ k2=k2+1; }
      if(k==3){ k3=k3+1; }
    }
    l=l+1;
  }
  return nf*7+k1*13+k2*29+k3*61;
}
fn lt_sig_goal(G:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let h:i32=1;
  let i:i32=0;
  while(i<nn){
    h=(h*131+(lt_sig_need(G,i)+1))-(h*131+(lt_sig_need(G,i)+1))/1000003*1000003;
    i=i+1;
  }
  return h;
}
// relation-content fingerprint of a goal: folds every FIELD value,
// never a tag. Equal fingerprints mean the goal touches the same
// relations; differing fingerprints on a template hit mean the reused
// structure transferred across worlds.
fn lt_relsig(G:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let h:i32=7;
  let i:i32=0;
  while(i<nn){
    let nf:i32=need_nf(G,i);
    let f:i32=0;
    while(f<nf){
      h=(h*131+(need_f(G,i,f)+1))-(h*131+(need_f(G,i,f)+1))/1000003*1000003;
      f=f+1;
    }
    i=i+1;
  }
  return h;
}

// ---- template store ----
fn lt_tmpl_find(LT:[]u8,s:i32)i32 {
  let i:i32=0;
  while(i<12){
    if(get32(LT,lt_tb(i))==s){ return i; }
    i=i+1;
  }
  return -1;
}
fn lt_tmpl_new(LT:[]u8,s:i32,cg:i32,q:i32,rs:i32)i32 {
  let i:i32=0;
  while(i<12){
    let b:i32=lt_tb(i);
    if(get32(LT,b)==0){
      set32(LT,b,s);
      set32(LT,b+4,cg);
      set32(LT,b+8,0);
      set32(LT,b+12,0);
      set32(LT,b+16,0);
      set32(LT,b+20,0);
      set32(LT,b+24,0);
      set32(LT,b+28,0);
      set32(LT,b+32,q);
      set32(LT,b+36,0);
      set32(LT,b+40,q);
      set32(LT,b+44,rs);
      return i;
    }
    i=i+1;
  }
  return -1;
}
// ---- bind store: need signature -> canonical tag ----
fn lt_bs_find(LT:[]u8,s:i32)i32 {
  let i:i32=0;
  while(i<16){
    if(get32(LT,lt_bb(i))==s){ return i; }
    i=i+1;
  }
  return -1;
}
fn lt_bs_new(LT:[]u8,s:i32,t:i32,q:i32)i32 {
  let i:i32=0;
  while(i<16){
    let b:i32=lt_bb(i);
    if(get32(LT,b)==0){
      set32(LT,b,s);
      set32(LT,b+4,t);
      set32(LT,b+8,q);
      set32(LT,b+12,0);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn lt_bs_lastq(LT:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<16){
    if(get32(LT,lt_bb(i)+4)==t){ return get32(LT,lt_bb(i)+8); }
    i=i+1;
  }
  return -1;
}
fn lt_bs_touch(LT:[]u8,i:i32,q:i32)void {
  set32(LT,lt_bb(i)+8,q);
  set32(LT,lt_bb(i)+12,get32(LT,lt_bb(i)+12)+1);
  return;
}

// ---- functional-arity observation store ----
fn lt_fun_find(LT:[]u8,r:i32)i32 {
  let i:i32=0;
  while(i<48){
    if(get32(LT,lt_fb(i)+0)==r){ return i; }
    if(get32(LT,lt_fb(i)+0)==0){ return -2; }
    i=i+1;
  }
  return -1;
}
fn lt_fun_new(LT:[]u8,r:i32,q:i32)i32 {
  let i:i32=0;
  while(i<48){
    let b:i32=lt_fb(i);
    if(get32(LT,b)==0){
      set32(LT,b,r);
      set32(LT,b+4,0);
      set32(LT,b+8,0);
      set32(LT,b+12,0);
      set32(LT,b+16,q);
      return i;
    }
    i=i+1;
  }
  return -1;
}
// One observed (subject, relation, object) triple. A relation becomes
// marked FUNCTIONAL the first time a subject is observed under it; if a
// LATER observation gives an already-seen subject a SECOND object under
// a relation still marked functional, the learner has detected a
// contradiction in its own experience and records a belief revision.
fn lt_fun_observe(LT:[]u8,r:i32,s:i32,o:i32,q:i32)void {
  let e:i32=lt_fun_find(LT,r);
  if(e==-2){ e=lt_fun_new(LT,r,q); }
  if(e<0){ return; }
  let b:i32=lt_fb(e);
  set32(LT,b+16,q);
  let n:i32=get32(LT,b+8);
  let i:i32=0;
  while(i<n){
    if(get32(LT,b+24+i*8)==s){
      if(get32(LT,b+28+i*8)==o){ return; }
      if(get32(LT,b+4)==1){
        set32(LT,b+4,0);
        set32(LT,b+12,get32(LT,b+12)+1);
        set32(LT,8,get32(LT,8)+1);
        lt_ev(LT,3,r,s);
      }
      return;
    }
    i=i+1;
  }
  if(n<8){
    set32(LT,b+24+n*8,s);
    set32(LT,b+28+n*8,o);
    set32(LT,b+8,n+1);
  }
  if(get32(LT,b+4)==0){
    if(n==0){ set32(LT,b+4,1); }
  }
  return;
}

// ---- index freshness: self-maintenance on observed arena growth ----
// The arena is append-only, so a bucket built earlier silently omits
// facts that arrived later. The learner compares the arena length it
// recorded at its last rebuild against the arena length now; any
// difference is visible to it without any external signal.
fn lt_fresh(L:[]u8,LT:[]u8,A:[]u8,q:i32)void {
  if(get32(LT,68)==0){ return; }
  let n:i32=get32(A,0);
  if(get32(LT,0)==n){ return; }
  specialize_ret(L,A,q,q);
  specialize_vfy(L,A,q,q);
  specialize_cnt(L,A,q,q);
  set32(LT,0,n);
  set32(LT,4,get32(LT,4)+1);
  lt_ev(LT,1,q,n);
  return;
}

// ---- frozen capacity probes (BIND 8, PLAN 4) ----
fn lt_bind_free(L:[]u8)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){ return 1; }
    bi=bi+1;
  }
  return 0;
}
fn lt_bind_evict_lru(L:[]u8,LT:[]u8)void {
  let best:i32=-1;
  let bq:i32=999999999;
  let bi:i32=0;
  while(bi<8){
    let t:i32=get32(L,bind_off(bi));
    if(t!=0){
      let q:i32=lt_bs_lastq(LT,t);
      if(q>=0){
        if(q<bq){ bq=q; best=bi; }
      }
    }
    bi=bi+1;
  }
  if(best>=0){
    set32(L,bind_off(best),0);
    set32(LT,64,get32(LT,64)+1);
    lt_ev(LT,4,get32(LT,64),0);
  }
  return;
}
fn lt_plan_free(L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){ return 1; }
    pi=pi+1;
  }
  return 0;
}
fn lt_plan_evict_lru(L:[]u8,LT:[]u8)void {
  let best:i32=-1;
  let bq:i32=999999999;
  let ti:i32=0;
  while(ti<12){
    let cg:i32=get32(LT,lt_tb(ti)+4);
    if(cg!=0){
      if(plan_find(L,cg)>=0){
        let q:i32=get32(LT,lt_tb(ti)+40);
        if(q<bq){ bq=q; best=ti; }
      }
    }
    ti=ti+1;
  }
  if(best>=0){
    let cg2:i32=get32(LT,lt_tb(best)+4);
    plan_drop(L,cg2);
    set32(LT,lt_tb(best)+8,0);
    set32(LT,60,get32(LT,60)+1);
    lt_ev(LT,5,cg2,0);
  }
  return;
}

// ---- the one episode entry point ----
// C500-R1 FIX 1: on the VERIFY modality CB is already the chain ep_vfy built
// (p1 = its entry count).  The previous version cleared CB and rebuilt it
// from the RB scratch buffer; that round-trip is removed (see lt_main feed).
fn lt_episode(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,kind:i32,p1:i32,p2:i32,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8)i32 {
  let k0:i32=get32(K,12);
  let r:i32=0;
  if(kind==0){ r=ret_episode(L,A,p1,p2,K,TO); }
  if(kind==1){
    r=vfy_episode(L,A,CB,K);
    let n2:i32=get32(CB,0);
    let j:i32=0;
    while(j<n2){
      lt_fun_observe(LT,get32(CB,4+j*12+4),get32(CB,4+j*12),get32(CB,4+j*12+8),get32(LT,12));
      j=j+1;
    }
  }
  if(kind==2){ r=cnt_episode(L,A,p1,p2,K,TO,SE); }
  set32(LT,44,get32(LT,44)+(get32(K,12)-k0));
  return r;
}

// ---- the one query entry point ----
// R: 0 code (0 declined, 1 answered)
//    4 family trials consumed
//    8 fact-checks during plan execution
//   12 fact-checks during family trials
//   16 template hit (0 miss / 1 hit)
//   20 origin query index of the template
//   24 need-shape cache hits
//   28 need-shape cache misses
//   32 query index
//   36 cross-world fire (0/1)
//   40 reuse-of-reuse fire (0/1)
//   44 passes used
//   48 ret_spec delta  52 ret_gen delta
//   56 vfy_spec delta  60 vfy_gen delta
//   64 cnt_spec delta  68 cnt_gen delta
//   72 plans_built delta  76 plans_loaded delta
//   80 declines delta  84 total fact-checks
fn lt_query(L:[]u8,LT:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8,ANS:[]u8)i32 {
  let GC:[]u8=z_alloc(512);
  let ans:[]u8=z_alloc(512);
  let vbuf:[]u8=z_alloc(64);
  let q:i32=get32(LT,12);
  set32(LT,12,q+1);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,-1);
  set32(R,24,0);
  set32(R,28,0);
  set32(R,32,q);
  set32(R,36,0);
  set32(R,40,0);
  set32(R,44,0);
  set32(ANS,0,0);
  lt_fresh(L,LT,A,q);
  lt_copy(GC,G,512);
  let nn:i32=g_nneeds(G);
  let s:i32=lt_sig_goal(G);
  let rs:i32=lt_relsig(G);
  let e:i32=lt_tmpl_find(LT,s);
  if(e>=0){
    let b:i32=lt_tb(e);
    let st:i32=get32(LT,b+8);
    let fires:i32=get32(LT,b+36);
    if(rs!=get32(LT,b+44)){
      set32(R,36,1);
      set32(LT,32,get32(LT,32)+1);
      lt_ev(LT,2,q,get32(LT,b+32));
    }
    if(fires>=1){
      set32(R,40,1);
      set32(LT,36,get32(LT,36)+1);
      lt_ev(LT,6,q,get32(LT,b+32));
    }
    if(st==2){
      set32(LT,40,get32(LT,40)+1);
      set32(R,20,get32(LT,b+32));
      return 0;
    }
    set32(R,16,1);
    set32(R,20,get32(LT,b+32));
    set32(LT,b+36,fires+1);
    set32(LT,b+40,q);
    set32(LT,28,get32(LT,28)+1);
    set32(GC,0,get32(LT,b+4));
    let i:i32=0;
    while(i<nn){
      set32(GC,need_off(GC,i),get32(LT,b+12+i*4));
      let c:i32=lt_bs_find(LT,lt_sig_need(G,i));
      if(c>=0){ lt_bs_touch(LT,c,q); }
      set32(R,24,get32(R,24)+1);
      i=i+1;
    }
  } else {
    let i2:i32=0;
    let bad:i32=0;
    while(i2<nn){
      let sig:i32=lt_sig_need(G,i2);
      let c2:i32=lt_bs_find(LT,sig);
      if(c2<0){
        let t:i32=5000+get32(LT,56);
        if(lt_bind_free(L)==0){
          lt_bind_evict_lru(L,LT);
          set32(LT,88,get32(LT,88)+1);
        }
        if(lt_bind_free(L)==0){ bad=1; }
        let c3:i32=lt_bs_new(LT,sig,t,q);
        if(c3<0){ bad=1; }
        set32(LT,56,get32(LT,56)+1);
        set32(LT,20,get32(LT,20)+1);
        set32(GC,need_off(GC,i2),t);
      } else {
        lt_bs_touch(LT,c2,q);
        set32(LT,16,get32(LT,16)+1);
        set32(GC,need_off(GC,i2),get32(LT,lt_bb(c2)+4));
        set32(R,24,get32(R,24)+1);
      }
      i2=i2+1;
    }
    if(bad==1){
      set32(LT,40,get32(LT,40)+1);
      set32(LT,88,get32(LT,88)+1);
      return 0;
    }
    let cg:i32=6000+get32(LT,52);
    set32(LT,52,get32(LT,52)+1);
    let e2:i32=lt_tmpl_new(LT,s,cg,q,rs);
    if(e2<0){
      set32(LT,40,get32(LT,40)+1);
      set32(LT,84,get32(LT,84)+1);
      return 0;
    }
    set32(GC,0,cg);
    let i3:i32=0;
    while(i3<nn){
      set32(LT,lt_tb(e2)+12+i3*4,get32(GC,need_off(GC,i3)));
      i3=i3+1;
    }
    set32(LT,24,get32(LT,24)+1);
  }
  let pi:i32=plan_find(L,g_tag(GC));
  if(pi<0){
    if(lt_plan_free(L)==0){
      lt_plan_evict_lru(L,LT);
      set32(LT,84,get32(LT,84)+1);
    }
  }
  let t0:i32=get32(L,13232);
  let b0:i32=get32(L,13224);
  let l0:i32=get32(L,13228);
  let dc0:i32=get32(L,13236);
  let s0:i32=get32(L,13252);
  let g0:i32=get32(L,13256);
  let vs0:i32=get32(L,13260);
  let vg0:i32=get32(L,13264);
  let cs0:i32=get32(L,13268);
  let cg0:i32=get32(L,13272);
  set32(K,0,0);
  set32(K,8,0);
  let r:i32=compose_iter(L,A,GC,K,ans,vbuf);
  set32(R,4,get32(L,13232)-t0);
  set32(R,8,get32(K,0));
  set32(R,12,get32(K,8));
  set32(R,44,get32(vbuf,20));
  set32(R,48,get32(L,13252)-s0);
  set32(R,52,get32(L,13256)-g0);
  set32(R,56,get32(L,13260)-vs0);
  set32(R,60,get32(L,13264)-vg0);
  set32(R,64,get32(L,13268)-cs0);
  set32(R,68,get32(L,13272)-cg0);
  set32(R,72,get32(L,13224)-b0);
  set32(R,76,get32(L,13228)-l0);
  set32(R,80,get32(L,13236)-dc0);
  set32(R,84,get32(K,0)+get32(K,8));
  set32(LT,48,get32(LT,48)+get32(K,0)+get32(K,8));
  set32(ANS,0,0);
  let an:i32=get32(ans,0);
  let ai:i32=0;
  while(ai<an){
    ans_append(ANS,get32(ans,4+ai*4));
    ai=ai+1;
  }
  if(r==0){
    set32(LT,40,get32(LT,40)+1);
    let e5:i32=lt_tmpl_find(LT,s);
    if(e5>=0){ set32(LT,lt_tb(e5)+8,2); }
    return 0;
  }
  set32(R,0,1);
  set32(LT,72,get32(LT,72)+1);
  if(r==2){
    let e6:i32=lt_tmpl_find(LT,s);
    if(e6>=0){ set32(LT,lt_tb(e6)+8,1); }
  }
  return 1;
}

// ---- scoring (evaluator side) ----
// DECL[0] == -1 encodes "the correct behaviour is DECLINE".
fn lt_score(DECL:[]u8,ANS:[]u8,code:i32)i32 {
  if(get32(DECL,0)==-1){
    if(code==0){ return 1; }
    return 0;
  }
  if(code==0){ return 0; }
  if(lt_ans_eq(ANS,DECL)==1){ return 1; }
  return 0;
}
// oracle agrees with the hand-declared answer?
fn lt_oracle_ok(A:[]u8,G:[]u8,DECL:[]u8,kb:[]u8,O:[]u8)i32 {
  let h:i32=lt_oracle(A,G,O,kb);
  if(get32(DECL,0)==-1){
    if(h==0){ return 1; }
    return 0;
  }
  if(h==0){ return 0; }
  if(lt_ans_eq(O,DECL)==1){ return 1; }
  return 0;
}

// ---- answer comparison (evaluator side) ----
fn lt_ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}

// ---- independent oracle (evaluator side; never reads L or LT) ----
// Recomputes the answer from the live arena using only the frozen
// GENERIC procedures, its own buffers and its own ordering.
// Returns 1 = answered, 0 = decline (some need matches no family).
fn lt_oracle(A:[]u8,G:[]u8,O:[]u8,kb:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tmpc:[]u8=z_alloc(512);
  let SUBL:[]u8=z_alloc(512);
  let se:[]u8=z_alloc(320);
  let nn:i32=g_nneeds(G);
  let handled:i32=1;
  mat_inputs(G,W);
  set32(O,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=p;
    apply_kind1(G,W,OUTS,ni);
    let nf:i32=need_nf(G,ni);
    set32(OUTS,ni*160,0);
    if(nf==2){
      ret_gen(A,get32(W,ni*80+4),get32(W,ni*80+8),kb,16,OUTS,ni*160);
    }
    if(nf>=4){
      let ns:i32=get32(W,ni*80+4);
      let ok:i32=0;
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){ ok=1; }
        }
      }
      if(ok==1){
        let src:i32=fanin_src(G,ni);
        if(src<0){
          set32(tmpc,0,ns);
          let i:i32=0;
          while(i<ns){
            let sv:i32=get32(W,ni*80+4+(1+i*3)*4);
            set32(tmpc,4+i*12,sv);
            set32(tmpc,4+i*12+4,get32(W,ni*80+4+(2+i*3)*4));
            set32(tmpc,4+i*12+8,get32(W,ni*80+4+(3+i*3)*4));
            i=i+1;
          }
          let vv:i32=vfy_gen(A,tmpc,kb,16);
          set32(OUTS,ni*160,1);
          set32(OUTS,ni*160+4,vv);
        }
        if(src>=0){
          let nsub:i32=get32(OUTS,src*160);
          let np:i32=0;
          let k:i32=0;
          while(k<nsub){
            let sub:i32=get32(OUTS,src*160+4+k*4);
            set32(tmpc,0,ns);
            let i2:i32=0;
            while(i2<ns){
              let sv2:i32=get32(W,ni*80+4+(1+i2*3)*4);
              if(sv2==0){ sv2=sub; }
              set32(tmpc,4+i2*12,sv2);
              set32(tmpc,4+i2*12+4,get32(W,ni*80+4+(2+i2*3)*4));
              set32(tmpc,4+i2*12+8,get32(W,ni*80+4+(3+i2*3)*4));
              i2=i2+1;
            }
            let vv2:i32=vfy_gen(A,tmpc,kb,16);
            if(vv2==1){
              set32(OUTS,ni*160+4+np*4,sub);
              np=np+1;
            }
            k=k+1;
          }
          set32(OUTS,ni*160,np);
        }
      } else { handled=0; }
    }
    if(nf==3){
      let ag:i32=get32(W,ni*80+8);
      if(ag==1){
        let rel3:i32=get32(W,ni*80+4);
        let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
        let ns3:i32=0;
        if(has3==1){ ns3=get32(SUBL,ni*128); }
        if(has3==0){
          set32(SUBL,ni*128,1);
          set32(SUBL,ni*128+4,get32(W,ni*80+12));
          ns3=1;
        }
        let cc:i32=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,kb,16,se);
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,cc);
      } else { handled=0; }
    }
    let n3:i32=get32(OUTS,ni*160);
    ans_append(O,n3);
    let k2:i32=0;
    while(k2<n3){
      ans_append(O,get32(OUTS,ni*160+4+k2*4));
      k2=k2+1;
    }
    p=p+1;
  }
  if(handled==0){ return 0; }
  return 1;
}

// ---- memory occupancy (evaluator side) ----
// NOTE the k*4 index form: on this compiler a get32 whose offset is
// `base + i` with a BARE induction variable reads the wrong cells
// (verified by direct probe). Every indexed access in this lane uses an
// explicit multiplier. See NAMECHECK.md.
fn lt_cells(b:[]u8,n:i32)i32 {
  let c:i32=0;
  let k:i32=0;
  while(k*4<n){
    if(get32(b,k*4)!=0){ c=c+1; }
    k=k+1;
  }
  return c;
}

// lane-local chain builder with INLINED byte stores. The frozen
// chain_add/chain_clear miscompile in this toolchain: a direct probe
// (c15_base + 20-line driver) shows the WRITE path is fine but a
// get32 whose offset is `base + i` with a bare induction variable
// reads the wrong cells. Chain writers here inline their byte stores.

fn lt_chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn lt_chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    let b:i32=4+n*12;
    C[b]=s as u8; C[b+1]=(s>>8) as u8; C[b+2]=(s>>16) as u8; C[b+3]=(s>>24) as u8;
    C[b+4]=r as u8; C[b+5]=(r>>8) as u8; C[b+6]=(r>>16) as u8; C[b+7]=(r>>24) as u8;
    C[b+8]=o as u8; C[b+9]=(o>>8) as u8; C[b+10]=(o>>16) as u8; C[b+11]=(o>>24) as u8;
    set32(C,0,n+1);
  }
  return;
}
// lt_main.zag -- driver for LIFETIME-AB-1 (binary lt1).
//
// ONE learner instance (L + LT) threaded unchanged through stages A..H.
// No reset. No recompilation. No task label reaches the learner.
// One generic interface: lt_episode and lt_query.

fn emit_q(b:[]u8,c:i32,R:[]u8,ok:i32,lbl:[]u8,w:i32)i32 {
  c=o_app(b,c,"Q st=");
  c=o_app(b,c,lbl);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,w as i64);
  c=o_app(b,c," code=");
  c=o_i64(b,c,get32(R,0) as i64);
  c=o_app(b,c," ok=");
  c=o_i64(b,c,ok as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(R,4) as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(R,84) as i64);
  c=o_app(b,c," exec=");
  c=o_i64(b,c,get32(R,8) as i64);
  c=o_app(b,c," tmpl=");
  c=o_i64(b,c,get32(R,16) as i64);
  c=o_app(b,c," orgq=");
  c=o_i64(b,c,get32(R,20) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(R,24) as i64);
  c=o_app(b,c," bmiss=");
  c=o_i64(b,c,get32(R,28) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(R,36) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(R,40) as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(R,44) as i64);
  c=o_app(b,c," rspec=");
  c=o_i64(b,c,get32(R,48) as i64);
  c=o_app(b,c," rgen=");
  c=o_i64(b,c,get32(R,52) as i64);
  c=o_app(b,c," vspec=");
  c=o_i64(b,c,get32(R,56) as i64);
  c=o_app(b,c," vgen=");
  c=o_i64(b,c,get32(R,60) as i64);
  c=o_app(b,c," cspec=");
  c=o_i64(b,c,get32(R,64) as i64);
  c=o_app(b,c," cgen=");
  c=o_i64(b,c,get32(R,68) as i64);
  c=o_app(b,c," pnew=");
  c=o_i64(b,c,get32(R,72) as i64);
  c=o_app(b,c," pld=");
  c=o_i64(b,c,get32(R,76) as i64);
  c=o_app(b,c," dec=");
  c=o_i64(b,c,get32(R,80) as i64);
  c=o_nl(b,c);
  return c;
}
fn emit_stage(b:[]u8,c:i32,L:[]u8,LT:[]u8,A:[]u8,lbl:[]u8,ok:i32)i32 {
  c=o_app(b,c,"STAGE ");
  c=o_app(b,c,lbl);
  c=o_app(b,c," facts=");
  c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," memL=");
  c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT=");
  c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," costep=");
  c=o_i64(b,c,get32(LT,44) as i64);
  c=o_app(b,c," costq=");
  c=o_i64(b,c,get32(LT,48) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(LT,4) as i64);
  c=o_app(b,c," retcov=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," vfycov=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," cntcov=");
  c=o_i64(b,c,get32(L,8496) as i64);
  c=o_app(b,c," plans=");
  c=o_i64(b,c,get32(L,13224) as i64);
  c=o_app(b,c," pld=");
  c=o_i64(b,c,get32(L,13228) as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(L,13232) as i64);
  c=o_app(b,c," dec=");
  c=o_i64(b,c,get32(L,13236) as i64);
  c=o_app(b,c," tmplb=");
  c=o_i64(b,c,get32(LT,24) as i64);
  c=o_app(b,c," tmplh=");
  c=o_i64(b,c,get32(LT,28) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(LT,16) as i64);
  c=o_app(b,c," bmiss=");
  c=o_i64(b,c,get32(LT,20) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(LT,32) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(LT,36) as i64);
  c=o_app(b,c," fviol=");
  c=o_i64(b,c,get32(LT,8) as i64);
  c=o_app(b,c," nq=");
  c=o_i64(b,c,get32(LT,12) as i64);
  c=o_app(b,c," ok=");
  c=o_i64(b,c,ok as i64);
  c=o_nl(b,c);
  return c;
}
fn emit_evt(b:[]u8,c:i32,LT:[]u8)i32 {
  let n:i32=get32(LT,92);
  let i:i32=0;
  while(i<n){
    let e:i32=lt_eb(i);
    c=o_app(b,c,"EVT ");
    c=o_i64(b,c,get32(LT,e) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,get32(LT,e+4) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,get32(LT,e+8) as i64);
    c=o_nl(b,c);
    i=i+1;
  }
  return c;
}
// ---- harness lesions ----
fn lesion_bind_full(L:[]u8)void {
  let i:i32=0;
  while(i<8){
    set32(L,bind_off(i),0);
    set32(L,bind_off(i)+4,-1);
    i=i+1;
  }
  i=0;
  while(i<8){
    set32(L,bind_off(i),7001+i);
    set32(L,bind_off(i)+4,0);
    i=i+1;
  }
  return;
}
fn lesion_zero_tmpl(T:[]u8)void {
  let i:i32=0;
  while(i<576){ set32(T,200+i*4,0); i=i+1; }
  return;
}
fn lesion_zero_bs(T:[]u8)void {
  let i:i32=0;
  while(i<256){ set32(T,800+i*4,0); i=i+1; }
  return;
}
fn lesion_recycle(L:[]u8,T:[]u8)void {
  let i:i32=0;
  while(i<8){ set32(L,bind_off(i),0); i=i+1; }
  let p:i32=0;
  while(p<4){ set32(L,13000+p*56,0); p=p+1; }
  lesion_zero_tmpl(T);
  lesion_zero_bs(T);
  set32(T,52,0);
  set32(T,56,0);
  set32(T,12,0);
  return;
}
// ---- replay: append stages 0..upto ----
fn build_upto(A:[]u8,upto:i32)void {
  if(upto<0){ return; }
  w_stageA(A);
  if(upto<1){ return; }
  w_stageB(A);
  if(upto<2){ return; }
  w_stageC(A);
  if(upto<3){ return; }
  w_stageD(A);
  if(upto<4){ return; }
  w_stageE(A);
  if(upto<5){ return; }
  w_stageF(A);
  w_stageF_ext(A);
  if(upto<6){ return; }
  w_stageG(A);
  if(upto<7){ return; }
  w_stageH(A);
  return;
}
// ---- one episode through the single interface ----
// C500-R1 FIX 1 (real, toolchain-independent): the VERIFY modality used to
// round-trip the chain CB -> RB -> CB.  RB is a 3-cells-per-triple scratch
// buffer and the round-trip was pure redundancy: ep_vfy(id,CB) already fills
// CB with the exact chain vfy_episode consumes.  Measured on this host, the
// RB store with a computed offset inside this 8-slice-argument call chain
// does NOT land where get32(RB,...) reads it back, so the round-trip
// silently replaced every VERIFY relation id with heap garbage before it
// reached vfy_log_rel.  The chain now goes straight from ep_vfy to
// vfy_episode; RB is not on the VERIFY path at all.
fn feed(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,kind:i32,id:i32)void {
  if(kind==0){
    ep_ret(id,RB);
    lt_episode(L,LT,A,K,0,get32(RB,0),get32(RB,4),RB,CB,TO,SE);
  }
  if(kind==1){
    ep_vfy(id,CB);
    lt_episode(L,LT,A,K,1,get32(CB,0),0,RB,CB,TO,SE);
  }
  if(kind==2){
    ep_cnt(id,RB);
    lt_episode(L,LT,A,K,2,get32(RB,0),get32(RB,4),RB,CB,TO,SE);
  }
  return;
}
// flat per-stage episode list: value = kind*100 + id
fn ep_flat(s:i32,k:i32)i32 {
  if(s==0){
    if(k<5){ return k; }
    if(k<7){ return 100+k-5; }
    return 200+k-7;
  }
  if(s==1){
    if(k<3){ return 5+k; }
    if(k<12){ return 100+k+0; }
    return 202;
  }
  if(s==2){
    if(k<2){ return 8+k; }
    if(k<4){ return 100+k+9; }
    return 203;
  }
  if(s==3){
    if(k<4){ return 10+k; }
    if(k<6){ return 100+k+11; }
    return 204;
  }
  if(s==4){
    if(k<4){ return 14+k; }
    if(k<8){ return 100+k+11; }
    return 200+k+1;
  }
  if(s==5){
    if(k==0){ return 18; }
    if(k==1){ return 119; }
    return 200;
  }
  if(s==6){
    if(k<4){ return 19+k; }
    if(k<6){ return 100+k+19; }
    if(k==6){ return 209; }
    return 122;
  }
  if(k<4){ return 23+k; }
  if(k<6){ return 100+k+19; }
  return 210;
}
fn feed_one(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,v:i32)void {
  let kind:i32=v/100;
  feed(L,LT,A,K,RB,CB,TO,SE,kind,v-kind*100);
  return;
}
fn feed_stage(L:[]u8,LT:[]u8,A:[]u8,K:[]u8,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8,s:i32)void {
  let n:i32=0;
  if(s==0){ n=9; }
  if(s==1){ n=13; }
  if(s==2){ n=5; }
  if(s==3){ n=7; }
  if(s==4){ n=12; }
  if(s==5){ n=3; }
  if(s==6){ n=8; }
  if(s==7){ n=7; }
  let k:i32=0;
  while(k<n){
    feed_one(L,LT,A,K,RB,CB,TO,SE,ep_flat(s,k));
    k=k+1;
  }
  return;
}
fn emit_ans(b:[]u8,c:i32,A:[]u8,lbl:[]u8)i32 {
  let n:i32=get32(A,0);
  c=o_app(b,c,"ANS ");
  c=o_app(b,c,lbl);
  c=o_app(b,c," n=");
  c=o_i64(b,c,n as i64);
  c=o_app(b,c," v=");
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(A,4+i*4) as i64);
    i=i+1;
  }
  c=o_nl(b,c);
  return c;
}
fn cov_ids(b:[]u8,c:i32,L:[]u8,lbl:[]u8,base:i32,n:i32)i32 {
  c=o_app(b,c,lbl);
  let q:i32=0;
  while(q<n){
    if(q>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(L,base+q*4) as i64);
    q=q+1;
  }
  return c;
}
fn emit_cov(b:[]u8,c:i32,L:[]u8,lbl:[]u8)i32 {
  c=o_app(b,c,"COV ");
  c=o_app(b,c,lbl);
  let n0:i32=get32(L,0);
  let n2:i32=get32(L,4248);
  let n3:i32=get32(L,8496);
  c=cov_ids(b,c,L," ret=",4,n0);
  c=cov_ids(b,c,L," vfy=",4252,n2);
  c=cov_ids(b,c,L," cnt=",8500,n3);
  c=o_nl(b,c);
  let z:i32=4240;
  while(z<4400){
    c=o_app(b,c," [");
    c=o_i64(b,c,z as i64);
    c=o_app(b,c,"]=");
    c=o_i64(b,c,get32(L,z) as i64);
    c=o_app(b,c," ");
    z=z+4;
  }
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt_world_new();
  let K:[]u8=z_alloc(64);
  let G:[]u8=z_alloc(512);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let R:[]u8=z_alloc(128);
  let DECL:[]u8=z_alloc(256);
  let ORC:[]u8=z_alloc(256);
  let ANS:[]u8=z_alloc(256);
  let S:[]u8=z_alloc(12288);
  let i:i32=0;
  let ok1:i32=0;
  let ok2:i32=0;
  let ok3:i32=0;
  let ok4:i32=0;
  let ok5:i32=0;
  let ok6:i32=0;
  let ok7:i32=0;
  let ok8:i32=0;
  let ok9:i32=0;
  let okA:i32=0;
  let okB:i32=0;
  let okC:i32=0;
  let okD:i32=0;
  let okE:i32=0;
  let okF:i32=0;
  let okGG:i32=0;
  let okGP:i32=0;
  let okGB2:i32=0;
  let okH:i32=0;
  let okGA2:i32=0;
  let okGF2:i32=0;

  // ---- contract module self-test (hq_module.zag linked) ----
  // sg/ss are slot-indexed: slot i lives at byte i*4.
  ss(S,2002,2);
  ss(S,2003,1);
  ss(S,2004,0);
  ss(S,2005,0);
  ss(S,2006,1);
  ss(S,2007,0);
  ss(S,2008,10);
  ss(S,2009,1);
  ok1=u_check(S,2000,2,5,7,0,0,0,0);
  ss(S,2008,3);
  ok2=u_check(S,2000,2,5,7,0,0,0,0);
  c=o_app(B,c,"CONTRACT-SELFTEST pass_in=");
  c=o_i64(B,c,ok1 as i64);
  c=o_app(B,c," pass_out=");
  c=o_i64(B,c,ok2 as i64);
  c=o_nl(B,c);

  set32(LT,68,1);

  // ============ PHASE MAIN ============
  w_stageA(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,0);
  mk_goal(0,G);
  lt_decl(0,DECL);
  okA=lt_oracle_ok(A,G,DECL,K,ORC);
  let cd:i32=lt_query(L,LT,A,G,K,R,ANS);
  okA=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=0 match=");
  c=o_i64(B,c,okA as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okA,"A",0);
  c=emit_stage(B,c,L,LT,A,"A",okA);
  c=emit_cov(B,c,L,"A");
  c=emit_ans(B,c,ANS,"A");

  w_stageB(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,1);
  mk_goal(1,G);
  lt_decl(1,DECL);
  let oc1:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okB=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=1 match=");
  c=o_i64(B,c,oc1 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okB,"B",1);
  c=emit_stage(B,c,L,LT,A,"B",okB);
  c=emit_cov(B,c,L,"B");
  c=emit_ans(B,c,ANS,"B");

  w_stageC(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,2);
  mk_goal(2,G);
  lt_decl(2,DECL);
  let oc2:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okC=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=2 match=");
  c=o_i64(B,c,oc2 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okC,"C",2);
  c=emit_stage(B,c,L,LT,A,"C",okC);

  w_stageD(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,3);
  mk_goal(3,G);
  lt_decl(3,DECL);
  let oc3:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okD=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=3 match=");
  c=o_i64(B,c,oc3 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okD,"D",3);
  c=emit_stage(B,c,L,LT,A,"D",okD);

  w_stageE(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,4);
  c=emit_stage(B,c,L,LT,A,"E",1);
  okE=1;

  w_stageF(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,5);
  mk_goal(4,G);
  lt_decl(4,DECL);
  let oc4:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okF=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=4 match=");
  c=o_i64(B,c,oc4 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okF,"F",4);
  c=emit_stage(B,c,L,LT,A,"F",okF);
  c=emit_cov(B,c,L,"F");
  c=emit_ans(B,c,ANS,"F");

  // post-query extension of an A-era relation -> index is now stale
  w_stageF_ext(A);
  let SL:[]u8=z_alloc(16384);
  let SLT:[]u8=z_alloc(8192);
  let SA:[]u8=z_alloc(12288);
  lt_copy(SL,L,16384);
  lt_copy(SLT,LT,8192);
  lt_copy(SA,A,12288);

  w_stageG(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,6);
  c=emit_stage(B,c,L,LT,A,"G-ep",1);
  mk_goal(5,G);
  lt_decl(5,DECL);
  let oc5:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okGG=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=5 match=");
  c=o_i64(B,c,oc5 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okGG,"G",5);
  c=emit_stage(B,c,L,LT,A,"G",okGG);
  c=emit_cov(B,c,L,"G");

  mk_goal(7,G);
  lt_decl(7,DECL);
  let oc7:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okGP=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=7 match=");
  c=o_i64(B,c,oc7 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okGP,"G-probe",7);

  mk_goal(1,G);
  lt_decl(1,DECL);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okGB2=lt_score(DECL,ANS,cd);
  c=emit_q(B,c,R,okGB2,"G-reprobe-B",1);

  w_stageH(A);
  feed_stage(L,LT,A,K,RB,CB,TO,SE,7);
  c=emit_stage(B,c,L,LT,A,"H-ep",1);
  mk_goal(6,G);
  lt_decl(6,DECL);
  let oc6:i32=lt_oracle_ok(A,G,DECL,K,ORC);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okH=lt_score(DECL,ANS,cd);
  c=o_app(B,c,"ORACLE goal=6 match=");
  c=o_i64(B,c,oc6 as i64);
  c=o_nl(B,c);
  c=emit_q(B,c,R,okH,"H",6);
  mk_goal(0,G);
  lt_decl(8,DECL);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okGA2=lt_score(DECL,ANS,cd);
  c=emit_q(B,c,R,okGA2,"H-retain-GA",0);

  mk_goal(4,G);
  lt_decl(9,DECL);
  cd=lt_query(L,LT,A,G,K,R,ANS);
  okGF2=lt_score(DECL,ANS,cd);
  c=emit_q(B,c,R,okGF2,"H-reprobe-GF",4);
  c=emit_stage(B,c,L,LT,A,"H",okH);
  c=emit_ans(B,c,ANS,"H-GF");
  c=emit_evt(B,c,LT);
  c=o_app(B,c,"MAIN orc=");
  c=o_i64(B,c,(oc1+oc2+oc3+oc4+oc5+oc6+oc7) as i64);
  c=o_app(B,c,"/7 A=");   c=o_i64(B,c,okA as i64);
  c=o_app(B,c," B=");     c=o_i64(B,c,okB as i64);
  c=o_app(B,c," C=");     c=o_i64(B,c,okC as i64);
  c=o_app(B,c," D=");     c=o_i64(B,c,okD as i64);
  c=o_app(B,c," E=");     c=o_i64(B,c,okE as i64);
  c=o_app(B,c," F=");     c=o_i64(B,c,okF as i64);
  c=o_app(B,c," GG=");    c=o_i64(B,c,okGG as i64);
  c=o_app(B,c," GP=");    c=o_i64(B,c,okGP as i64);
  c=o_app(B,c," GB2=");   c=o_i64(B,c,okGB2 as i64);
  c=o_app(B,c," H=");     c=o_i64(B,c,okH as i64);
  c=o_app(B,c," GAret="); c=o_i64(B,c,okGA2 as i64);
  c=o_app(B,c," GFret="); c=o_i64(B,c,okGF2 as i64);
  c=o_app(B,c," fviol="); c=o_i64(B,c,get32(LT,8) as i64);
  c=o_app(B,c," evB=");   c=o_i64(B,c,get32(LT,64) as i64);
  c=o_app(B,c," evP=");   c=o_i64(B,c,get32(LT,60) as i64);
  c=o_app(B,c," bcap=");  c=o_i64(B,c,get32(LT,88) as i64);
  c=o_app(B,c," pcap=");  c=o_i64(B,c,get32(LT,84) as i64);
  c=o_app(B,c," answers="); c=o_i64(B,c,get32(LT,72) as i64);
  c=o_app(B,c," declines="); c=o_i64(B,c,get32(LT,40) as i64);
  c=o_nl(B,c);

  // ============ F-ARM: baselines and ablations ============
  let FARM:[]u8=z_alloc(12288);
  lt_copy(FARM,SA,12288);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let G2:[]u8=z_alloc(512);
  let R2:[]u8=z_alloc(128);
  let AN2:[]u8=z_alloc(256);
  let D2:[]u8=z_alloc(256);
  let bF0:i32=0;
  let bF1:i32=0;
  let bRC:i32=0;
  let aSN:i32=0;
  let aCT:i32=0;
  let aST:i32=0;
  let aCP:i32=0;
  let Z16:[]u8=z_alloc(16384);
  let Z8:[]u8=z_alloc(8192);
  let f0t:i32=0;
  let f1t:i32=0;
  let f0x:i32=0;
  let f1x:i32=0;
  let snx:i32=0;
  let ctx:i32=0;
  let stx:i32=0;
  mk_goal(4,G2);
  lt_decl(9,D2);

  // FRESH0
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  lt_copy(L2,Z16,16384);
  lt_copy(T2,Z8,8192);
  set32(T2,68,1);
  let cd0:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  bF0=lt_score(D2,AN2,cd0);
  f0t=get32(R2,4);
  f0x=get32(R2,84);
  c=emit_ans(B,c,AN2,"FRESH0");
  c=o_app(B,c,"BASE FRESH0 trials=");
  c=o_i64(B,c,f0t as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,f0x as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cd0 as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,bF0 as i64);
  c=o_nl(B,c);

  // FRESH1
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  lesion_recycle(L2,T2);
  set32(T2,68,1);
  feed_stage(L2,T2,FARM,K,RB,CB,TO,SE,5);
  let cd1:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  bF1=lt_score(D2,AN2,cd1);
  f1t=get32(R2,4);
  f1x=get32(R2,84);
  c=o_app(B,c,"BASE FRESH1 trials=");
  c=o_i64(B,c,f1t as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,f1x as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cd1 as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,bF1 as i64);
  c=o_nl(B,c);

  // RECENCY 16-fact window
  let AR:[]u8=z_alloc(256);
  let nfa:i32=get32(FARM,0);
  let lo:i32=nfa-16;
  if(lo<0){ lo=0; }
  let m:i32=nfa-lo;
  set32(AR,0,m);
  let q:i32=0;
  while(q<m){
    set32(AR,4+q*12,get32(FARM,4+(lo+q)*12));
    set32(AR,4+q*12+4,get32(FARM,4+(lo+q)*12+4));
    set32(AR,4+q*12+8,get32(FARM,4+(lo+q)*12+8));
    q=q+1;
  }
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  lesion_recycle(L2,T2);
  set32(T2,68,0);
  let cdR:i32=lt_query(L2,T2,AR,G2,K,R2,AN2);
  bRC=lt_score(D2,AN2,cdR);
  c=emit_ans(B,c,AN2,"RECENCY16");
  c=o_app(B,c,"BASE RECENCY16 win=");
  c=o_i64(B,c,m as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(R2,4) as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,get32(R2,84) as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cdR as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,bRC as i64);
  c=o_nl(B,c);

  // ABL SNAPSTALE
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,0);
  let cdS:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  aSN=lt_score(D2,AN2,cdS);
  snx=get32(R2,84);
  c=emit_ans(B,c,AN2,"SNAPSTALE");
  c=o_app(B,c,"ABL SNAPSTALE trials=");
  c=o_i64(B,c,get32(R2,4) as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,snx as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cdS as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,aSN as i64);
  c=o_nl(B,c);

  // ABL SNAPCTRL
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  let rev0:i32=get32(SLT,4);
  let cdT:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  aCT=lt_score(D2,AN2,cdT);
  ctx=get32(R2,84);
  c=o_app(B,c,"ABL SNAPCTRL trials=");
  c=o_i64(B,c,get32(R2,4) as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,ctx as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cdT as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,aCT as i64);
  c=o_app(B,c," newrev=");
  c=o_i64(B,c,(get32(T2,4)-rev0) as i64);
  c=o_nl(B,c);

  // ABL NOREUSE
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  lesion_zero_tmpl(T2);
  lesion_zero_bs(T2);
  let cdU:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  aST=lt_score(D2,AN2,cdU);
  stx=get32(R2,4);
  c=emit_ans(B,c,AN2,"NOREUSE");
  c=o_app(B,c,"ABL NOREUSE trials=");
  c=o_i64(B,c,stx as i64);
  c=o_app(B,c," cost=");
  c=o_i64(B,c,get32(R2,84) as i64);
  c=o_app(B,c," code=");
  c=o_i64(B,c,cdU as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,aST as i64);
  c=o_nl(B,c);

  // ABL BINDSAT
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  lesion_zero_tmpl(T2);
  lesion_zero_bs(T2);
  lesion_bind_full(L2);
  let cdV:i32=lt_query(L2,T2,FARM,G2,K,R2,AN2);
  aCP=lt_score(D2,AN2,cdV);
  c=o_app(B,c,"ABL BINDSAT code=");
  c=o_i64(B,c,cdV as i64);
  c=o_app(B,c," ok=");
  c=o_i64(B,c,aCP as i64);
  c=o_nl(B,c);

  // ============ PHASE TTC ============
  let L3:[]u8=z_alloc(16384);
  let T3:[]u8=z_alloc(8192);
  let A3:[]u8=lt_world_new();
  let L4:[]u8=z_alloc(16384);
  let T4:[]u8=z_alloc(8192);
  let G3:[]u8=z_alloc(512);
  let D3:[]u8=z_alloc(256);
  let AN3:[]u8=z_alloc(256);
  let OR3:[]u8=z_alloc(256);
  let ZT:[]u8=z_alloc(12288);
  let s:i32=0;
  while(s<8){
    let tgt:i32=0;
    let nep:i32=9;
    if(s==1){ tgt=1; nep=13; }
    if(s==2){ tgt=2; nep=5; }
    if(s==3){ tgt=3; nep=7; }
    if(s==4){ tgt=0; nep=12; }
    if(s==5){ tgt=9; nep=3; }
    if(s==6){ tgt=5; nep=8; }
    if(s==7){ tgt=9; nep=7; }
    // C500-R1 FIX 3: A3 / L3 / T3 were carried across the s loop while
    // build_upto(A3,s) re-appends stages 0..s, so from s=1 the arena held
    // every stage two, three, ... times and the declared answers no longer
    // described it.  Reset all three per stage: this is what makes TTC a
    // clean examples-to-criterion measure (fresh arena, fresh learner,
    // stages 0..s-1 replayed, then stage s fed one episode at a time).
    // FIX 3b: T3[68] is the snapshot-freshness rule's enable flag.  It was
    // never set on the TTC learner, so lt_fresh returned immediately and the
    // TTC learner answered every query from an index that had never been
    // built -- which is why TTC contradicted MAIN.  The flag is a fixed
    // policy, enabled identically on every learner instance in the run.
    lt_copy(A3,ZT,12288);
    lt_copy(L3,Z16,16384);
    lt_copy(T3,Z8,8192);
    set32(T3,68,1);
    build_upto(A3,s);
    let b:i32=0;
    while(b<s){
      feed_stage(L3,T3,A3,K,RB,CB,TO,SE,b);
      b=b+1;
    }
    mk_goal(tgt,G3);
    lt_decl(tgt,D3);
    let ttc:i32=-1;
    let k0ok:i32=2;
    let k:i32=0;
    let lastok:i32=2;
    let lastcode:i32=2;
    while(k<=nep){
      lt_copy(L4,L3,16384);
      lt_copy(T4,T3,8192);
      let cq:i32=lt_query(L4,T4,A3,G3,K,R2,AN3);
      let so:i32=lt_score(D3,AN3,cq);
      lastok=so;
      lastcode=get32(R2,0);
      if(k==0){ k0ok=so; }
      if(so==1){
        if(ttc<0){ ttc=k; }
      }
      if(k<nep){ feed_one(L3,T3,A3,K,RB,CB,TO,SE,ep_flat(s,k)); }
      k=k+1;
    }
    c=o_app(B,c,"TTC stage=");
    c=o_i64(B,c,s as i64);
    c=o_app(B,c," goal=");
    c=o_i64(B,c,tgt as i64);
    c=o_app(B,c," nep=");
    c=o_i64(B,c,nep as i64);
    c=o_app(B,c," k0ok=");
    c=o_i64(B,c,k0ok as i64);
    c=o_app(B,c," lastok=");
    c=o_i64(B,c,lastok as i64);
    c=o_app(B,c," lastcode=");
    c=o_i64(B,c,lastcode as i64);
    c=o_app(B,c," ansn=");
    c=o_i64(B,c,get32(AN3,0) as i64);
    c=o_app(B,c," decn=");
    c=o_i64(B,c,get32(D3,0) as i64);
    c=o_app(B,c," ans=");
    let ai:i32=0;
    let an:i32=get32(AN3,0);
    while(ai<an){
      if(ai>0){ B[c]=44; c=c+1; }
      c=o_i64(B,c,get32(AN3,4+ai*4) as i64);
      ai=ai+1;
    }
    c=o_app(B,c," dec=");
    ai=0;
    let dn:i32=get32(D3,0);
    while(ai<dn){
      if(ai>0){ B[c]=44; c=c+1; }
      c=o_i64(B,c,get32(D3,4+ai*4) as i64);
      ai=ai+1;
    }
    c=o_app(B,c," ttc=");
    c=o_i64(B,c,ttc as i64);
    c=o_nl(B,c);
    s=s+1;
  }

  // ============ SUMMARY ============
  c=o_app(B,c,"SUMMARY lifetime_ok=");
  c=o_i64(B,c,(okA+okB+okC+okD+okF+okGG+okGP+okGB2+okGA2+okGF2) as i64);
  c=o_app(B,c,"/10");
  c=o_app(B,c," h_invention_ok=");
  c=o_i64(B,c,okH as i64);
  c=o_app(B,c," fresh0=");
  c=o_i64(B,c,bF0 as i64);
  c=o_app(B,c," fresh1=");
  c=o_i64(B,c,bF1 as i64);
  c=o_app(B,c," recency=");
  c=o_i64(B,c,bRC as i64);
  c=o_app(B,c," abl_snap=");
  c=o_i64(B,c,aSN as i64);
  c=o_app(B,c," abl_snapctrl=");
  c=o_i64(B,c,aCT as i64);
  c=o_app(B,c," abl_noreuse=");
  c=o_i64(B,c,aST as i64);
  c=o_app(B,c," abl_bindsat=");
  c=o_i64(B,c,aCP as i64);
  c=o_app(B,c," tmpl_built=");
  c=o_i64(B,c,get32(LT,24) as i64);
  c=o_app(B,c," tmpl_hit=");
  c=o_i64(B,c,get32(LT,28) as i64);
  c=o_app(B,c," xworld=");
  c=o_i64(B,c,get32(LT,32) as i64);
  c=o_app(B,c," reuse_rer=");
  c=o_i64(B,c,get32(LT,36) as i64);
  c=o_app(B,c," fviol=");
  c=o_i64(B,c,get32(LT,8) as i64);
  c=o_app(B,c," rev=");
  c=o_i64(B,c,get32(LT,4) as i64);
  c=o_app(B,c," memL=");
  c=o_i64(B,c,lt_cells(L,16384) as i64);
  c=o_app(B,c," memLT=");
  c=o_i64(B,c,lt_cells(LT,8192) as i64);
  c=o_app(B,c," costq=");
  c=o_i64(B,c,get32(LT,48) as i64);
  c=o_app(B,c," costep=");
  c=o_i64(B,c,get32(LT,44) as i64);
  c=o_app(B,c," evB=");
  c=o_i64(B,c,get32(LT,64) as i64);
  c=o_app(B,c," evP=");
  c=o_i64(B,c,get32(LT,60) as i64);
  c=o_nl(B,c);

  c=o_app(B,c,"COST-F "); c=o_i64(B,c,f0t as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,f0x as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,f1t as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,f1x as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,0 as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,snx as i64);
  c=o_app(B,c," ");         c=o_i64(B,c,stx as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"COST-F fresh0_trials fresh0_cost fresh1_trials fresh1_cost lifetime_trials lifetime_cost noreuse_trials");
  c=o_nl(B,c);
  lt_flush(B,c);
  return 0;
}

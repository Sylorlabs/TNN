// b16_probe.zag -- independent minimal check of the claimed defect B16
// ("indexed reads are miscompiled once c15_base.zag is in the unit").
//
// Ground truth written with explicit stride 4 at offsets 4,8,12,16,20,24.
// The ONLY difference between the two read forms below is the stride of
// the induction variable.  A stride-1 read of a stride-4 array is
// guaranteed to be garbage BY CONSTRUCTION (it re-reads the same three
// zero bytes plus one live byte), so it is not evidence of anything
// unless it happens to return the packed values.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn p(tag:[]u8,x:i32)void {
  _zag_print(tag);
  _zag_print(" ");
  _zag_println(_zag_i64_to_str(x as i64));
  return;
}
fn main()i32 {
  let C:[]u8=z_alloc(4096);
  set32(C,0,2);
  set32(C,4,11);
  set32(C,8,105);
  set32(C,12,50);
  set32(C,16,11);
  set32(C,20,106);
  set32(C,24,60);
  _zag_println("B16_PROBE expect stride4 = 11 105 50 11 106 60");
  _zag_println("RAWBYTES:");
  let i:i32=0;
  while(i<29){
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(C[i] as i64));
    i=i+1;
  }
  _zag_println("STRIDE4:");
  let j:i32=0;
  while(j<6){ p("S4",get32(C,4+j*4)); j=j+1; }
  _zag_println("STRIDE1:");
  j=0;
  while(j<6){ p("S1",get32(C,4+j)); j=j+1; }
  _zag_println("LITERAL:");
  p("L",get32(C,4));
  p("L",get32(C,8));
  p("L",get32(C,12));
  p("L",get32(C,16));
  p("L",get32(C,20));
  p("L",get32(C,24));
  _zag_println("READBACK_INTO_FRESH_ARENA (write stride1 into D, read stride1):");
  let D:[]u8=z_alloc(4096);
  set32(D,0,11);
  set32(D,1,105);
  set32(D,2,50);
  set32(D,3,11);
  set32(D,4,106);
  set32(D,5,60);
  j=0;
  while(j<6){ p("D1",get32(D,j)); j=j+1; }
  _zag_println("B16_PROBE_END");
  return 0;
}

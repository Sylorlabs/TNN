// lt2_world.zag -- LT2: the HARDER second lifetime (charter 221).
//
// Harder than LT1 on all five axes preregistered in LIFETIME-AB-1 section 8:
//   1. 12 subjects per stage, not 8.
//   2. SIX distinct goal shapes (LT1 built 4), which exceeds the frozen
//      4-slot PLAN table and forces plan rebuilds.
//   3. nine distinct need signatures with BIND pressure (LT1 peaked at 4).
//   4. 400 distractor facts, not 200 -- twice the frozen 16-relation
//      coverage sets.
//   5. a SECOND fan-in diamond at F: 4 needs, 6 links (LT1's F had 3).
//   6. stage G contradicts B's functional-arity rule in TWO places, so the
//      learner-side arity detector must fire at least twice.
//
// The six shapes (needs listed as (nf, incoming links), links in order):
//   s1  A2  (2,-) (7,k2) (3,k3)                  3 needs, 2 links
//   s2  B2  (2,-) (7,k2)                        2 needs, 2 links
//   s3  C2  (2,-) (4,k2) (3,k3)                 3 needs, 2 links
//   s4  D2  (2,-) (7,k2) (4,k2) (3,k3)          4 needs, 3 links
//   s5  F2  (2,-) (7,k2) (7,k2) (3,k2+k3)       4 needs, 6 links  <- 2nd diamond
//   s6  G2  (2,-) (4,k2) (7,k2) (3,k3)          4 needs, 3 links
//   --  H2  reuses s4 on disjoint relation ids, with the last need carrying
//       aggop = 2, which no frozen family accepts. Correct: DECLINE.
//
// Arena A2 is APPEND-ONLY, capacity 1024 facts, layout [nf, (s,r,o) x nf],
// so the frozen generic procedures read it unmodified.
//
// Stage fact totals: A2 66, B2 12, C2 40, D2 50, E2 400, F2 25, G2 44,
// H2 20 = 657.

fn lt2_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<1024){
    set32(A,4+n*12,s);
    set32(A,4+n*12+4,r);
    set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
fn lt2_new()[]u8 { return z_alloc(16384); }
fn lt2_copy(d:[]u8,s:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ d[i]=s[i]; i=i+1; }
  return;
}
// the additive lifetime layer calls this name for its shadow goal copy
fn lt_copy(d:[]u8,s:[]u8,n:i32)void { lt2_copy(d,s,n); return; }

// ================= A2: unfamiliar procedural world, 12 subjects ===========
fn w2A(A:[]u8)void {
  let i:i32=0;
  while(i<12){ lt2_add(A,10+i,1001,20); i=i+1; }
  i=0;
  while(i<12){ lt2_add(A,10+i,1002,30); i=i+1; }
  i=0;
  while(i<10){ lt2_add(A,12+i,1003,40); i=i+1; }
  i=0;
  while(i<12){ lt2_add(A,10+i,1004,50); i=i+1; }
  i=0;
  while(i<8){ lt2_add(A,12+i,1005,60); i=i+1; }
  i=0;
  while(i<6){
    lt2_add(A,10+i,1006,70);
    i=i+1;
  }
  i=0;
  while(i<4){ lt2_add(A,10+i,1006,71); i=i+1; }
  return;
}

// ================= B2: causal world, rel 2001 observed FUNCTIONAL =========
fn w2B(A:[]u8)void {
  let i:i32=0;
  while(i<12){ lt2_add(A,110+i,2001,120); i=i+1; }
  return;
}

// ================= C2: formal constraint world ==========================
fn w2C(A:[]u8)void {
  let i:i32=0;
  while(i<12){ lt2_add(A,30+i,3001,50); i=i+1; }
  i=0;
  while(i<12){ lt2_add(A,30+i,3002,60); i=i+1; }
  i=0;
  while(i<6){ lt2_add(A,30+i,3003,70); i=i+1; }
  i=0;
  while(i<10){ lt2_add(A,32+i,3004,80); i=i+1; }
  return;
}

// ================= D2: misleading evidence, mirror of A2 =================
fn w2D(A:[]u8)void {
  let i:i32=0;
  while(i<12){ lt2_add(A,200+i,1008,20); i=i+1; }
  i=0;
  while(i<12){ lt2_add(A,200+i,1009,30); i=i+1; }
  i=0;
  while(i<10){ lt2_add(A,202+i,1010,40); i=i+1; }
  i=0;
  while(i<12){ lt2_add(A,200+i,1011,50); i=i+1; }
  i=0;
  while(i<8){ lt2_add(A,202+i,1012,60); i=i+1; }
  i=0;
  while(i<6){ lt2_add(A,200+i,1013,70); i=i+1; }
  i=0;
  while(i<4){ lt2_add(A,200+i,1013,71); i=i+1; }
  return;
}

// ================= E2: 400 unrelated distractors ========================
fn w2E(A:[]u8)void {
  let k:i32=0;
  while(k<20){
    let j:i32=0;
    while(j<20){
      lt2_add(A,900+j,5000+k,600+k);
      j=j+1;
    }
    k=k+1;
  }
  return;
}

// ================= F2: A2 + C2 composition, second diamond ===============
fn w2F(A:[]u8)void {
  let i:i32=0;
  while(i<12){ lt2_add(A,10+i,3002,60); i=i+1; }
  i=0;
  while(i<8){ lt2_add(A,11+i,1007,90); i=i+1; }
  i=0;
  while(i<5){ lt2_add(A,10+i,1006,72); i=i+1; }
  return;
}
// post-query extension of an A2-era relation, so a stale snapshot is wrong
fn w2F_ext(A:[]u8)void {
  lt2_add(A,11,1006,72);
  lt2_add(A,14,1006,72);
  return;
}

// ================= G2: revision contradicting B2 in TWO places ===========
fn w2G(A:[]u8)void {
  // two violations of the functional arity of rel 2001 exhibited at B2
  lt2_add(A,112,2001,121);
  lt2_add(A,114,2001,121);
  let i:i32=0;
  while(i<12){ lt2_add(A,40+i,6001,70); i=i+1; }
  i=0;
  while(i<6){ lt2_add(A,40+i,6002,80); i=i+1; }
  i=0;
  while(i<8){ lt2_add(A,40+i,6003,90); i=i+1; }
  i=0;
  while(i<6){ lt2_add(A,42+i,6004,100); i=i+1; }
  return;
}

// ================= H2: invention pressure ===============================
fn w2H(A:[]u8)void {
  let i:i32=0;
  while(i<6){ lt2_add(A,60+i,7001,110); i=i+1; }
  i=0;
  while(i<4){ lt2_add(A,60+i,7002,120); i=i+1; }
  i=0;
  while(i<4){ lt2_add(A,60+i,7003,130); i=i+1; }
  i=0;
  while(i<6){ lt2_add(A,60+i,7004,140); i=i+1; }
  return;
}

// ================= episode stream =====================
// Every stage feeds all three modalities, so the learner's relation
// coverage, its indexed buckets and its functional-arity observations all
// come from the same generic interface.
fn e2_ret(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,1001); set32(rb,4,20); return; }
  if(id==1){ set32(rb,0,1002); set32(rb,4,30); return; }
  if(id==2){ set32(rb,0,1003); set32(rb,4,40); return; }
  if(id==3){ set32(rb,0,1004); set32(rb,4,50); return; }
  if(id==4){ set32(rb,0,2001); set32(rb,4,120); return; }
  if(id==5){ set32(rb,0,3001); set32(rb,4,50); return; }
  if(id==6){ set32(rb,0,3002); set32(rb,4,60); return; }
  if(id==7){ set32(rb,0,3003); set32(rb,4,70); return; }
  if(id==8){ set32(rb,0,3004); set32(rb,4,80); return; }
  if(id==9){ set32(rb,0,1008); set32(rb,4,20); return; }
  if(id==10){ set32(rb,0,1009); set32(rb,4,30); return; }
  if(id==11){ set32(rb,0,1010); set32(rb,4,40); return; }
  if(id==12){ set32(rb,0,1011); set32(rb,4,50); return; }
  if(id==13){ set32(rb,0,1012); set32(rb,4,60); return; }
  if(id==14){ set32(rb,0,5003); set32(rb,4,900); return; }
  if(id==15){ set32(rb,0,5007); set32(rb,4,900); return; }
  if(id==16){ set32(rb,0,1007); set32(rb,4,90); return; }
  if(id==17){ set32(rb,0,6001); set32(rb,4,70); return; }
  if(id==18){ set32(rb,0,7001); set32(rb,4,110); return; }
  set32(rb,0,6003); set32(rb,4,40);
  return;
}
fn e2_cnt(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,1006); set32(rb,4,10); return; }
  if(id==1){ set32(rb,0,1006); set32(rb,4,11); return; }
  if(id==2){ set32(rb,0,2001); set32(rb,4,110); return; }
  if(id==3){ set32(rb,0,3003); set32(rb,4,30); return; }
  if(id==4){ set32(rb,0,1013); set32(rb,4,200); return; }
  if(id==5){ set32(rb,0,5005); set32(rb,4,900); return; }
  if(id==6){ set32(rb,0,1006); set32(rb,4,12); return; }
  if(id==7){ set32(rb,0,6004); set32(rb,4,42); return; }
  if(id==8){ set32(rb,0,7002); set32(rb,4,60); return; }
  set32(rb,0,6002); set32(rb,4,40);
  return;
}
fn e2_vfy(id:i32,C:[]u8)void {
  lt_chain_clear(C);
  if(id==0){ lt_chain_add(C,10,1005,60); lt_chain_add(C,10,1004,50); return; }
  if(id==1){ lt_chain_add(C,11,1005,60); lt_chain_add(C,11,1004,50); return; }
  if(id==2){ lt_chain_add(C,12,1006,70); lt_chain_add(C,12,1004,50); return; }
  if(id==3){ lt_chain_add(C,110,2001,120); return; }
  if(id==4){ lt_chain_add(C,111,2001,120); return; }
  if(id==5){ lt_chain_add(C,30,3001,50); lt_chain_add(C,30,3004,80); return; }
  if(id==6){ lt_chain_add(C,30,3002,60); lt_chain_add(C,30,3001,50); return; }
  if(id==7){ lt_chain_add(C,200,1012,60); lt_chain_add(C,200,1011,50); return; }
  if(id==8){ lt_chain_add(C,900,5004,604); return; }
  if(id==9){ lt_chain_add(C,900,5009,609); return; }
  if(id==10){ lt_chain_add(C,11,1007,90); lt_chain_add(C,11,3002,60); return; }
  if(id==11){ lt_chain_add(C,112,2001,121); return; }
  if(id==12){ lt_chain_add(C,114,2001,121); return; }
  if(id==13){ lt_chain_add(C,40,6003,90); lt_chain_add(C,40,6002,80); return; }
  if(id==14){ lt_chain_add(C,60,7003,130); lt_chain_add(C,60,7002,120); return; }
  if(id==15){ lt_chain_add(C,112,2001,120); return; }
  if(id==16){ lt_chain_add(C,114,2001,120); return; }
  lt_chain_add(C,42,6004,100);
  return;
}
// flat per-stage episode list, value = kind*100 + id. Every stage feeds all
// three modalities. Stages 1 and 6 are where the causal world's functional
// relation is established (subjects 112 and 114 each observed once under
// 2001 -> 120) and then contradicted (the same two subjects under
// 2001 -> 121), so the learner-side arity detector has two chances to fire.
fn e2_flat(s:i32,k:i32)i32 {
  if(s==0){
    if(k<4){ return k; }
    if(k<6){ return 100+k-4; }
    return 200+k-6;
  }
  if(s==1){
    if(k==0){ return 103; }
    if(k==1){ return 104; }
    if(k==2){ return 115; }
    return 116;
  }
  if(s==2){
    if(k<3){ return 5+k; }
    if(k<4){ return 106; }
    return 203;
  }
  if(s==3){
    if(k<5){ return 9+k; }
    if(k<6){ return 107; }
    if(k<7){ return 204; }
    return 3;
  }
  if(s==4){
    if(k<2){ return 14+k; }
    if(k<4){ return 106+k; }
    return 205;
  }
  if(s==5){
    if(k==0){ return 16; }
    if(k==1){ return 110; }
    if(k==2){ return 206; }
    return 6;
  }
  if(s==6){
    if(k==0){ return 113; }
    if(k==1){ return 111; }
    if(k==2){ return 112; }
    if(k==3){ return 17; }
    if(k==4){ return 18; }
    if(k==5){ return 207; }
    if(k==6){ return 208; }
    return 9;
  }
  if(k<2){ return 18+k; }
  if(k<3){ return 114; }
  if(k<5){ return 206+k; }
  return 207;
}

// ================= goal records =====================
fn g2_b(G:[]u8,tag:i32,nn:i32)i32 { set32(G,0,tag); set32(G,4,nn); return 8; }
fn g2_n(G:[]u8,off:i32,tag:i32,nf:i32)i32 { set32(G,off,tag); set32(G,off+4,nf); return off+8; }
fn g2_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn g2_l(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn g2_k(G:[]u8,off:i32,k:i32,dn:i32,sn:i32)i32 {
  set32(G,off,k);
  set32(G,off+4,dn);
  set32(G,off+8,0);
  set32(G,off+12,0);
  set32(G,off+16,sn);
  set32(G,off+20,0);
  set32(G,off+24,0);
  return off+28;
}
// s1 -- A2. retrieve all 12 A2 subjects; keep those carrying BOTH
// procedure properties; count a relation twice.
fn mk2A(G:[]u8)void {
  let o:i32=g2_b(G,19001,3);
  o=g2_n(G,o,7101,2); o=g2_f(G,o,1002); o=g2_f(G,o,30);
  o=g2_n(G,o,7102,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,1005); o=g2_f(G,o,60);
  o=g2_f(G,o,0); o=g2_f(G,o,1004); o=g2_f(G,o,50);
  o=g2_n(G,o,7103,3); o=g2_f(G,o,1006); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,2);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  return;
}
// s2 -- B2. causal chain over the functional relation, two counts.
fn mk2B(G:[]u8)void {
  let o:i32=g2_b(G,19002,2);
  o=g2_n(G,o,7201,2); o=g2_f(G,o,2001); o=g2_f(G,o,120);
  o=g2_n(G,o,7202,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,2001); o=g2_f(G,o,120);
  o=g2_f(G,o,0); o=g2_f(G,o,2001); o=g2_f(G,o,121);
  o=g2_l(G,o,2);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,1,0);
  return;
}
// s3 -- C2. formal constraint, one-step VERIFY of arity 4.
fn mk2C(G:[]u8)void {
  let o:i32=g2_b(G,19003,3);
  o=g2_n(G,o,7301,2); o=g2_f(G,o,3001); o=g2_f(G,o,50);
  o=g2_n(G,o,7302,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,3002); o=g2_f(G,o,60);
  o=g2_n(G,o,7303,3); o=g2_f(G,o,3003); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,2);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  return;
}
// s4 -- D2. the mirror of A2 under fresh relation ids, one step longer.
fn mk2D(G:[]u8)void {
  let o:i32=g2_b(G,19004,4);
  o=g2_n(G,o,7401,2); o=g2_f(G,o,1009); o=g2_f(G,o,30);
  o=g2_n(G,o,7402,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,1012); o=g2_f(G,o,60);
  o=g2_f(G,o,0); o=g2_f(G,o,1011); o=g2_f(G,o,50);
  o=g2_n(G,o,7404,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,1010); o=g2_f(G,o,40);
  o=g2_n(G,o,7403,3); o=g2_f(G,o,1013); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,3);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  o=g2_k(G,o,3,3,2);
  return;
}
// s5 -- F2. A2 + C2 with a SECOND fan-in diamond: 4 needs, 6 links.
//   need2 = A2's two procedure properties, need3 = C2's constraint plus
//   A2's new relation, need4 = the intersection of need2 and need3.
fn mk2F(G:[]u8)void {
  let o:i32=g2_b(G,19005,4);
  o=g2_n(G,o,7501,2); o=g2_f(G,o,1002); o=g2_f(G,o,30);
  o=g2_n(G,o,7502,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,1005); o=g2_f(G,o,60);
  o=g2_f(G,o,0); o=g2_f(G,o,1004); o=g2_f(G,o,50);
  o=g2_n(G,o,7503,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,1007); o=g2_f(G,o,90);
  o=g2_f(G,o,0); o=g2_f(G,o,3002); o=g2_f(G,o,60);
  o=g2_n(G,o,7504,3); o=g2_f(G,o,1006); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,6);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,1,0);
  o=g2_k(G,o,2,2,0);
  o=g2_k(G,o,3,2,0);
  o=g2_k(G,o,2,3,1);
  o=g2_k(G,o,3,3,2);
  return;
}
// s6 -- G2. revision stage: the same skeleton with the two middle arities
// swapped, so its shape signature differs from s4 and s5.
fn mk2G(G:[]u8)void {
  let o:i32=g2_b(G,19006,4);
  o=g2_n(G,o,7601,2); o=g2_f(G,o,6001); o=g2_f(G,o,70);
  o=g2_n(G,o,7602,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,6002); o=g2_f(G,o,80);
  o=g2_n(G,o,7603,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,6003); o=g2_f(G,o,90);
  o=g2_f(G,o,0); o=g2_f(G,o,6001); o=g2_f(G,o,70);
  o=g2_n(G,o,7604,3); o=g2_f(G,o,6004); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,3);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,2,2,0);
  o=g2_k(G,o,3,3,1);
  return;
}
// H2 reuses the s4 shape on disjoint relation ids, but the final COUNT
// carries aggop = 2, which no frozen family accepts. Correct: DECLINE.
fn mk2H(G:[]u8)void {
  let o:i32=g2_b(G,19007,4);
  o=g2_n(G,o,7701,2); o=g2_f(G,o,7001); o=g2_f(G,o,110);
  o=g2_n(G,o,7702,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,7004); o=g2_f(G,o,140);
  o=g2_f(G,o,0); o=g2_f(G,o,7003); o=g2_f(G,o,130);
  o=g2_n(G,o,7704,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,7002); o=g2_f(G,o,120);
  o=g2_n(G,o,7703,3); o=g2_f(G,o,2); o=g2_f(G,o,0);
  o=g2_l(G,o,3);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  o=g2_k(G,o,3,3,2);
  return;
}
// H2 retention probe: the stage-A goal re-asked at the end of the lifetime.
fn mk2R(G:[]u8)void {
  mk2A(G);
  return;
}
// post-F-extension re-ask of the F2 composition goal.
fn mk2Fre(G:[]u8)void {
  mk2F(G);
  return;
}
// Two unprompted cross-world probes on the s4 SHAPE that stage D2 built,
// asked over relation populations the learner has never seen s4 applied to:
// goal 9 uses the revision world's relations, goal 10 uses the invention
// world's. Neither names a stage, a world, or a template. If the s4 template
// fires on goal 9 the relation fingerprint differs from build time
// (REUSE-XWORLD); if it fires again on goal 10 it has now fired once before
// (REUSE-OF-REUSE).
fn mk2Dx(G:[]u8)void {
  let o:i32=g2_b(G,19009,4);
  o=g2_n(G,o,7901,2); o=g2_f(G,o,6001); o=g2_f(G,o,70);
  o=g2_n(G,o,7902,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,6002); o=g2_f(G,o,80);
  o=g2_f(G,o,0); o=g2_f(G,o,6001); o=g2_f(G,o,70);
  o=g2_n(G,o,7904,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,6003); o=g2_f(G,o,90);
  o=g2_n(G,o,7903,3); o=g2_f(G,o,6004); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,3);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  o=g2_k(G,o,3,3,2);
  return;
}
fn mk2Dy(G:[]u8)void {
  let o:i32=g2_b(G,19010,4);
  o=g2_n(G,o,7911,2); o=g2_f(G,o,7001); o=g2_f(G,o,110);
  o=g2_n(G,o,7912,7); o=g2_f(G,o,2);
  o=g2_f(G,o,0); o=g2_f(G,o,7004); o=g2_f(G,o,140);
  o=g2_f(G,o,0); o=g2_f(G,o,7001); o=g2_f(G,o,110);
  o=g2_n(G,o,7914,4); o=g2_f(G,o,1);
  o=g2_f(G,o,0); o=g2_f(G,o,7003); o=g2_f(G,o,130);
  o=g2_n(G,o,7913,3); o=g2_f(G,o,7002); o=g2_f(G,o,1); o=g2_f(G,o,0);
  o=g2_l(G,o,3);
  o=g2_k(G,o,2,1,0);
  o=g2_k(G,o,3,2,1);
  o=g2_k(G,o,3,3,2);
  return;
}
fn mk2_goal(w:i32,G:[]u8)void {
  if(w==0){ mk2A(G); return; }
  if(w==1){ mk2B(G); return; }
  if(w==2){ mk2C(G); return; }
  if(w==3){ mk2D(G); return; }
  if(w==4){ mk2F(G); return; }
  if(w==5){ mk2G(G); return; }
  if(w==6){ mk2H(G); return; }
  if(w==7){ mk2Fre(G); return; }
  if(w==9){ mk2Dx(G); return; }
  if(w==10){ mk2Dy(G); return; }
  mk2R(G);
  return;
}
// The evaluator's declared correct behaviour. Only H DECLINES; every other
// goal is scored against the INDEPENDENT oracle (lt_oracle: a fresh
// fixed-point walk of ret_gen / vfy_gen / cnt_gen over the live arena, with
// no learner state of any kind), so LT2 carries no researcher-authored
// answer table. The oracle's own output is printed for every goal.
fn lt2_decl(w:i32,X:[]u8)void {
  set32(X,0,0);
  if(w==6){ set32(X,0,-1); return; }
  return;
}

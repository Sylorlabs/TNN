// glm_learner.zag -- generic generator-intermediate machinery.
//
// Shared by the H1 and H2 drivers of XDOMAIN-GRAMMAR-L2M. This file
// holds ONLY generic machinery plus learner-state access. It contains:
// no fact-relation literals, no label literals, no validity rule, no
// supplied-solution installer, no domain knowledge of any kind.
//
// M slot layout in W (base 2112, 32 bytes):
//   [0]=n_instr, [1]=gen, [2]=sup, [3]=created,
//   [4..21]=program (6 instr x 3 bytes),
//   [24..27]=build_count i32, [28..31]=reserved.
// Mprev slot (base 2144, 32 bytes): revision history, [1] of prev set
// to 1 on supersede.
//
// Generator program: registers R0..R3 (i32), R0 preloaded with the
// divisor D, output is R0. Frozen generic op basis:
//   0=CPY (Rd=Rs), 1=ADD (Rd+=Rs), 2=MUL (Rd*=Rs),
//   3=SET1 (Rd=1), 4=INC (Rd+=1).
// m_construct: greedy program construction from labeled experience.
// m_adapt: generic revision policy (codes 0=kept, 2=revised, 3=fail).
//
// The emit helpers eS/eN and the cell helpers put32/ig plus z_alloc
// are defined in the driver file; forward references are fine.

fn m_has(W:[]u8)i32 {
  if((W[2112] as i32)>0){ return 1; }
  return 0;
}
fn m_created_flag(W:[]u8)i32 { return W[2115] as i32; }
fn m_build_count(W:[]u8)i32 { return ig(W,2136); }
fn m_write(W:[]u8, n:i32, gen:i32, prog:[]u8)void {
  W[2112]=n as u8; W[2113]=gen as u8; W[2114]=0; W[2115]=1;
  let k:i32=0;
  while(k<18){ W[2116+k]=prog[k]; k=k+1; }
  put32(W,2136,ig(W,2136)+1);
  return;
}
fn m_copy_prev(W:[]u8)void {
  let k:i32=0;
  while(k<32){ W[2144+k]=W[2112+k]; k=k+1; }
  W[2145]=1;
  return;
}
fn m_wipe(W:[]u8)void {
  let k:i32=0;
  while(k<32){ W[2112+k]=0; k=k+1; }
  return;
}
fn m_label_lookup(W:[]u8, base:i32, nl:i32, D:i32, v:i32)i32 {
  let i:i32=0;
  while(i<nl){
    if(ig(W,base+i*12)==D && ig(W,base+i*12+4)==v){
      return ig(W,base+i*12+8);
    }
    i=i+1;
  }
  return 0;
}
fn m_exec(prog:[]u8, n:i32, D:i32)i32 {
  let r0:i32=D;
  let r1:i32=0;
  let r2:i32=0;
  let r3:i32=0;
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rs:i32=0;
    if(s==0){ rs=r0; }
    else { if(s==1){ rs=r1; } else { if(s==2){ rs=r2; } else { rs=r3; } } }
    if(op==0){
      if(d==0){ r0=rs; }
      else { if(d==1){ r1=rs; } else { if(d==2){ r2=rs; } else { r3=rs; } } }
    }
    else {
      if(op==1){
        if(d==0){ r0=r0+rs; }
        else { if(d==1){ r1=r1+rs; } else { if(d==2){ r2=r2+rs; } else { r3=r3+rs; } } }
      }
      else {
        if(op==2){
          if(d==0){ r0=r0*rs; }
          else { if(d==1){ r1=r1*rs; } else { if(d==2){ r2=r2*rs; } else { r3=r3*rs; } } }
        }
        else {
          if(op==3){
            if(d==0){ r0=1; }
            else { if(d==1){ r1=1; } else { if(d==2){ r2=1; } else { r3=1; } } }
          }
          else {
            if(d==0){ r0=r0+1; }
            else { if(d==1){ r1=r1+1; } else { if(d==2){ r2=r2+1; } else { r3=r3+1; } } }
          }
        }
      }
    }
    k=k+1;
  }
  return r0;
}
fn m_score(W:[]u8, prog:[]u8, n:i32, base:i32, nl:i32, d0:i32, d1:i32)i32 {
  let s:i32=0;
  let w0:i32=m_exec(prog,n,d0);
  if(m_label_lookup(W,base,nl,d0,w0)==1){ s=s+1; }
  let w1:i32=m_exec(prog,n,d1);
  if(m_label_lookup(W,base,nl,d1,w1)==1){ s=s+1; }
  return s;
}
// Greedy construction. init_n>0 resumes from the current M program
// (revision); init_n==0 starts empty (fresh construction). Result
// program goes to out_prog (18B); out_meta gets [n, score].
fn m_construct(W:[]u8, OUT:[]u8, base:i32, nl:i32, d0:i32, d1:i32, init_n:i32, out_prog:[]u8, out_meta:[]u8)i32 {
  let cur:[]u8=z_alloc(18);
  let k:i32=0;
  while(k<init_n*3){ cur[k]=W[2116+k]; k=k+1; }
  let cn:i32=init_n;
  let bs:i32=m_score(W,cur,cn,base,nl,d0,d1);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=6){ go=0; }
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let cand:[]u8=z_alloc(18);
            let j:i32=0;
            while(j<cn*3){ cand[j]=cur[j]; j=j+1; }
            cand[cn*3]=op as u8;
            cand[cn*3+1]=d as u8;
            cand[cn*3+2]=s as u8;
            let cs:i32=m_score(W,cand,cn+1,base,nl,d0,d1);
            let gain:i32=cs-bs;
            if(gain>bg){ bg=gain; bop=op; bd=d; bss=s; }
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      eS(W,OUT,"C-ROUND ");
      eN(W,OUT,round);
      eS(W,OUT," base=");
      eN(W,OUT,bs);
      if(bg>0){
        eS(W,OUT," win=");
        eN(W,OUT,bop);
        eS(W,OUT,",");
        eN(W,OUT,bd);
        eS(W,OUT,",");
        eN(W,OUT,bss);
        eS(W,OUT," gain=");
        eN(W,OUT,bg);
        cur[cn*3]=bop as u8;
        cur[cn*3+1]=bd as u8;
        cur[cn*3+2]=bss as u8;
        cn=cn+1;
        bs=m_score(W,cur,cn,base,nl,d0,d1);
        eS(W,OUT," score=");
        eN(W,OUT,bs);
        eS(W,OUT,"\n");
        if(bs>=2){ go=0; }
      }
      else {
        eS(W,OUT," stop\n");
        go=0;
      }
    }
  }
  k=0;
  while(k<18){ out_prog[k]=cur[k]; k=k+1; }
  put32(out_meta,0,cn);
  put32(out_meta,4,bs);
  return bs;
}
// Revision policy: 0=kept, 2=revised (old M retired to Mprev), 3=fail.
fn m_adapt(W:[]u8, OUT:[]u8, base:i32, nl:i32, d0:i32, d1:i32)i32 {
  let n:i32=W[2112] as i32;
  let cur:[]u8=z_alloc(18);
  let k:i32=0;
  while(k<n*3){ cur[k]=W[2116+k]; k=k+1; }
  let sc:i32=m_score(W,cur,n,base,nl,d0,d1);
  eS(W,OUT,"ADAPT cur_score=");
  eN(W,OUT,sc);
  eS(W,OUT,"\n");
  if(sc>=2){ return 0; }
  let outp:[]u8=z_alloc(18);
  let meta:[]u8=z_alloc(8);
  let bs:i32=m_construct(W,OUT,base,nl,d0,d1,n,outp,meta);
  let nn:i32=ig(meta,0);
  if(bs>=2){
    m_copy_prev(W);
    let g:i32=(W[2113] as i32)+1;
    m_write(W,nn,g,outp);
    return 2;
  }
  return 3;
}
fn m_print_prog(W:[]u8, OUT:[]u8)void {
  eS(W,OUT,"M-PROG n=");
  eN(W,OUT,W[2112] as i32);
  eS(W,OUT," gen=");
  eN(W,OUT,W[2113] as i32);
  eS(W,OUT," created=");
  eN(W,OUT,W[2115] as i32);
  eS(W,OUT," build_count=");
  eN(W,OUT,ig(W,2136));
  eS(W,OUT," bytes=");
  let n:i32=W[2112] as i32;
  let k:i32=0;
  while(k<n*3){
    eN(W,OUT,W[2116+k] as i32);
    eS(W,OUT,",");
    k=k+1;
  }
  eS(W,OUT,"\n");
  return;
}
fn m_print_prev(W:[]u8, OUT:[]u8)void {
  eS(W,OUT,"M-PREV n=");
  eN(W,OUT,W[2144] as i32);
  eS(W,OUT," sup=");
  eN(W,OUT,W[2145] as i32);
  eS(W,OUT," bytes=");
  let n:i32=W[2144] as i32;
  let k:i32=0;
  while(k<n*3){
    eN(W,OUT,W[2148+k] as i32);
    eS(W,OUT,",");
    k=k+1;
  }
  eS(W,OUT,"\n");
  return;
}
// tr_h2.zag -- L3-REPRO-TRANSFER, H2 (value-level function composition).
//
// TRANSFER WORLD (new sealed world; machinery tr_learner.zag reused
// byte-identical from C281). Training divisors {24,36} on the training
// relation; hi distractor relation fixed; sealed genuine relation with
// divisors 48/60/72 for rules 3/4/5; sealed distractor relation
// inserted first. Validity T1: v = D*q + r, q in [2,3], r in [0,7].
// Validity T2 (revision): v = D*q + r, q in [2,3], r in [1,8].
// Expected learner-created intermediate M' = [ADD R0,R0] (w = 2D);
// after T2 revision M'' = [ADD R0,R0, INC R0] (w = 2D+1).
//
// Capability-gated executors: 1=GRAMMAR (rule -> divisor via rebindable
// relation), 2=CONSTRUCT (divisor -> word via the learner-created
// generator intermediate M when installed, else memorized lookup as
// taught), 3=HIRANGE (range-hi distractor). VC composes ordered mode
// pairs; sealed Z needs relation rebinding of GRAMMAR plus the
// intermediate M.
//
// Prereg: l3_repro_transfer/PREREG.md (frozen before implementation).
// Pure Zag. 0 modes/bridges/handlers. Single output buffer plus one raw
// syscall write per main. No _zag_print for dynamic content.

// ---------- prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_id, 8 comp_m1, 12 comp_m2, 16 out_cur,
//         20 arm_ok, 24 gram_rel, 28 solved, 32 n_g1, 36 n_g2,
//         40 comp_rel, 44 tries
// facts: base 64, 40 entries x 12 bytes
// maps: base 544, 8 entries x 8 bytes (used, behav)
// candidates: base 2048, 8 entries x 4 bytes
// M slot: base 2112; Mprev: base 2144
// T1 labels: base 2176 (22 x 12B); T2 labels: base 2440 (18 x 12B)
// Y memorized lookup: base 2700 (2 x 8B)
fn glm_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,-1); put32(W,12,-1);
  put32(W,20,0); put32(W,24,-1); put32(W,28,0);
  put32(W,32,22); put32(W,36,18); put32(W,40,-1); put32(W,44,0);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn glm_facts(W:[]u8)void {
  add_fact(W,1,81,24);
  add_fact(W,2,81,36);
  add_fact(W,1,82,9);
  add_fact(W,2,82,6);
  add_fact(W,3,84,7);
  add_fact(W,3,83,48);
  add_fact(W,3,82,11);
  add_fact(W,4,83,60);
  add_fact(W,5,83,72);
  return;
}
fn y_lookup_init(W:[]u8)void {
  put32(W,2700,24); put32(W,2704,25);
  put32(W,2708,36); put32(W,2712,37);
  return;
}
fn y_lookup(W:[]u8,D:i32)i32 {
  let i:i32=0;
  while(i<2){
    if(ig(W,2700+i*8)==D){ return ig(W,2700+i*8+4); }
    i=i+1;
  }
  return -1;
}
// T1: v = D*q + r, q in [2,3], r in [0,7].
// T2: v = D*q + r, q in [2,3], r in [1,8].
// World validity rules (driver side only; the constructor never calls
// these; they self-check the hand-derived label tables).
fn t1_valid(D:i32,v:i32)i32 {
  let q:i32=2;
  while(q<=3){
    let r:i32=0;
    while(r<=7){
      if(v==D*q+r){ return 1; }
      r=r+1;
    }
    q=q+1;
  }
  return 0;
}
fn t2_valid(D:i32,v:i32)i32 {
  let q:i32=2;
  while(q<=3){
    let r:i32=1;
    while(r<=8){
      if(v==D*q+r){ return 1; }
      r=r+1;
    }
    q=q+1;
  }
  return 0;
}
fn lab3(W:[]u8,base:i32,i:i32,D:i32,v:i32,l:i32)void {
  put32(W,base+i*12,D); put32(W,base+i*12+4,v); put32(W,base+i*12+8,l);
  return;
}
fn g1_labels(W:[]u8)void {
  let b:i32=2176;
  lab3(W,b,0,24,48,1); lab3(W,b,1,24,49,1); lab3(W,b,2,24,55,1);
  lab3(W,b,3,24,73,1); lab3(W,b,4,24,79,1); lab3(W,b,5,24,24,0);
  lab3(W,b,6,24,25,0); lab3(W,b,7,24,32,0); lab3(W,b,8,24,23,0);
  lab3(W,b,9,24,1,0); lab3(W,b,10,24,0,0);
  lab3(W,b,11,36,72,1); lab3(W,b,12,36,73,1); lab3(W,b,13,36,79,1);
  lab3(W,b,14,36,109,1); lab3(W,b,15,36,115,1); lab3(W,b,16,36,36,0);
  lab3(W,b,17,36,37,0); lab3(W,b,18,36,44,0); lab3(W,b,19,36,35,0);
  lab3(W,b,20,36,1,0); lab3(W,b,21,36,0,0);
  return;
}
fn g2_labels(W:[]u8)void {
  let b:i32=2440;
  lab3(W,b,0,24,49,1); lab3(W,b,1,24,56,1); lab3(W,b,2,24,73,1);
  lab3(W,b,3,24,80,1); lab3(W,b,4,24,48,0); lab3(W,b,5,24,57,0);
  lab3(W,b,6,24,81,0); lab3(W,b,7,24,24,0); lab3(W,b,8,24,25,0);
  lab3(W,b,9,36,73,1); lab3(W,b,10,36,80,1); lab3(W,b,11,36,109,1);
  lab3(W,b,12,36,116,1); lab3(W,b,13,36,72,0); lab3(W,b,14,36,81,0);
  lab3(W,b,15,36,117,0); lab3(W,b,16,36,36,0); lab3(W,b,17,36,37,0);
  return;
}
fn label_check(W:[]u8,OUT:[]u8,base:i32,nl:i32,g:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<nl){
    let D:i32=ig(W,base+i*12);
    let v:i32=ig(W,base+i*12+4);
    let l:i32=ig(W,base+i*12+8);
    let e:i32=0;
    if(g==1){ e=t1_valid(D,v); } else { e=t2_valid(D,v); }
    if(e==l){ ok=ok+1; }
    else {
      eS(W,OUT,"LABEL-MISMATCH D=");
      eN(W,OUT,D);
      eS(W,OUT," v=");
      eN(W,OUT,v);
      eS(W,OUT,"\n");
    }
    i=i+1;
  }
  return ok;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  put32(W,544+m*8,1);
  put32(W,544+m*8+4,behav);
  return m;
}
fn del_behav(W:[]u8,bh:i32)void {
  let m:i32=0;
  while(m<ig(W,0)){
    if(ig(W,544+m*8+4)==bh){ put32(W,544+m*8,0); }
    m=m+1;
  }
  return;
}
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0;
  while(m<ig(W,0)){
    if(ig(W,544+m*8)==1 && ig(W,544+m*8+4)==bh){ return 1; }
    m=m+1;
  }
  return 0;
}
// Executors: -2 = absent or inapplicable.
fn grammar_exec(W:[]u8,s:i32,rel:i32)i32 {
  if(has_behav(W,0)==0){ return -2; }
  let d:i32=find_obj(W,s,rel);
  if(d==-1){ return -2; }
  return d;
}
fn construct_exec(W:[]u8,D:i32)i32 {
  if(has_behav(W,1)==0){ return -2; }
  if(m_has(W)==1){
    return m_exec(W[2116..2134],W[2112] as i32,D);
  }
  let w:i32=y_lookup(W,D);
  if(w==-1){ return -2; }
  return w;
}
fn hirange_exec(W:[]u8,s:i32)i32 {
  if(has_behav(W,2)==0){ return -2; }
  let d:i32=find_obj(W,s,82);
  if(d==-1){ return -2; }
  return d;
}
fn vc_stage(W:[]u8,mode:i32,subj:i32,rel:i32)i32 {
  if(mode==1){ return grammar_exec(W,subj,rel); }
  if(mode==2){ return construct_exec(W,subj); }
  return hirange_exec(W,subj);
}
fn teach_all(W:[]u8,OUT:[]u8)void {
  let g:i32=map_new(W,0);
  // Generic binding: first relation seen for the training subject.
  let rel:i32=-1;
  let i:i32=0;
  let found:i32=0;
  while(i<40){
    if(found==0 && ig(W,64+i*12)==1 && ig(W,64+i*12+4)==1){
      rel=ig(W,64+i*12+8);
      found=1;
    }
    i=i+1;
  }
  put32(W,24,rel);
  eS(W,OUT,"TEACH GRAMMAR id="); eN(W,OUT,g); eS(W,OUT," rel="); eN(W,OUT,rel); eS(W,OUT,"\n");
  let c:i32=map_new(W,1);
  eS(W,OUT,"TEACH CONSTRUCT id="); eN(W,OUT,c); eS(W,OUT,"\n");
  let h:i32=map_new(W,2);
  eS(W,OUT,"TEACH HIRANGE id="); eN(W,OUT,h); eS(W,OUT,"\n");
  return;
}
fn scan_candidates(W:[]u8,s:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+k*4)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+n*4,r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn cand_rel(W:[]u8,i:i32)i32 { return ig(W,2048+i*4); }
fn m_ensure(W:[]u8,OUT:[]u8,allow_build:i32)void {
  if(m_has(W)==1){
    eS(W,OUT,"M-PRESENT reuse\n");
    return;
  }
  if(allow_build==0){
    eS(W,OUT,"M-ABSENT build-disabled\n");
    return;
  }
  let outp:[]u8=z_alloc(18);
  let meta:[]u8=z_alloc(8);
  let bs:i32=m_construct(W,OUT,2176,ig(W,32),24,36,0,outp,meta);
  let nn:i32=ig(meta,0);
  if(bs>=2 && nn>0){
    m_write(W,nn,0,outp);
    eS(W,OUT,"M-BUILT score=");
    eN(W,OUT,bs);
    eS(W,OUT,"\n");
    m_print_prog(W,OUT);
  }
  else {
    eS(W,OUT,"M-BUILD-FAIL score=");
    eN(W,OUT,bs);
    eS(W,OUT,"\n");
  }
  return;
}
// Value composition with two-phase logic. Stores (m1,m2,rel) on success.
fn vc_compose(W:[]u8,OUT:[]u8,s:i32,target:i32,l2_on:i32,allow_build:i32)void {
  put32(W,28,0);
  let tries:i32=0;
  eS(W,OUT,"PHASE1 L1:\n");
  let sm1:i32=ig(W,8);
  if(sm1>0){
    let v1:i32=vc_stage(W,sm1,s,ig(W,24));
    let v2:i32=-2;
    if(v1!=-2){ v2=vc_stage(W,ig(W,12),v1,ig(W,24)); }
    eS(W,OUT,"TRY stored m1="); eN(W,OUT,sm1); eS(W,OUT," m2="); eN(W,OUT,ig(W,12));
    eS(W,OUT," v="); eN(W,OUT,v2); eS(W,OUT,"\n");
    tries=tries+1;
    if(v2==target){
      eS(W,OUT,"VC-STORED ok\n");
      put32(W,28,1); put32(W,44,tries);
      return;
    }
  }
  let m1:i32=1;
  while(m1<=3){
    let m2:i32=1;
    while(m2<=3){
      if(ig(W,28)==0){
        let v1:i32=vc_stage(W,m1,s,ig(W,24));
        let v2:i32=-2;
        if(v1!=-2){ v2=vc_stage(W,m2,v1,ig(W,24)); }
        tries=tries+1;
        eS(W,OUT,"TRY m1="); eN(W,OUT,m1); eS(W,OUT," m2="); eN(W,OUT,m2);
        eS(W,OUT," v="); eN(W,OUT,v2); eS(W,OUT,"\n");
        if(v2==target){
          eS(W,OUT,"VC-COMPOSE ok m1="); eN(W,OUT,m1);
          eS(W,OUT," m2="); eN(W,OUT,m2);
          eS(W,OUT," rel="); eN(W,OUT,ig(W,24)); eS(W,OUT,"\n");
          put32(W,4,map_new(W,3));
          put32(W,8,m1); put32(W,12,m2); put32(W,40,ig(W,24));
          put32(W,28,1);
        }
      }
      m2=m2+1;
    }
    m1=m1+1;
  }
  if(ig(W,28)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,28)==1 || l2_on==0){
    if(ig(W,28)==1){ put32(W,44,tries); } else { put32(W,44,0-tries); }
    return;
  }
  eS(W,OUT,"PHASE2 L2:\n");
  m_ensure(W,OUT,allow_build);
  let nc:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,nc);
  let ci0:i32=0;
  while(ci0<nc){
    eS(W,OUT," "); eN(W,OUT,cand_rel(W,ci0));
    ci0=ci0+1;
  }
  eS(W,OUT,"\n");
  let ci:i32=0;
  while(ci<nc){
    let cr:i32=cand_rel(W,ci);
    let a:i32=1;
    while(a<=3){
      let b:i32=1;
      while(b<=3){
        if(ig(W,28)==0){
          let v1:i32=vc_stage(W,a,s,cr);
          let v2:i32=-2;
          if(v1!=-2){ v2=vc_stage(W,b,v1,cr); }
          tries=tries+1;
          eS(W,OUT,"TRY m1="); eN(W,OUT,a); eS(W,OUT," m2="); eN(W,OUT,b);
          eS(W,OUT," rel="); eN(W,OUT,cr); eS(W,OUT," v="); eN(W,OUT,v2); eS(W,OUT,"\n");
          if(v2==target){
            eS(W,OUT,"VC-COMPOSE ok m1="); eN(W,OUT,a);
            eS(W,OUT," m2="); eN(W,OUT,b);
            eS(W,OUT," rel="); eN(W,OUT,cr); eS(W,OUT,"\n");
            put32(W,4,map_new(W,3));
            put32(W,8,a); put32(W,12,b); put32(W,40,cr);
            put32(W,28,1);
          }
        }
        b=b+1;
      }
      a=a+1;
    }
    ci=ci+1;
  }
  if(ig(W,28)==1){ put32(W,44,tries); } else { eS(W,OUT,"L2-FAIL\n"); put32(W,44,0-tries); }
  return;
}
fn install_supplied(W:[]u8,OUT:[]u8)void {
  W[2112]=1; W[2113]=0; W[2114]=0; W[2115]=0;
  W[2116]=1; W[2117]=0; W[2118]=0;
  let k:i32=3;
  while(k<18){ W[2116+k]=0; k=k+1; }
  put32(W,2140,1);
  eS(W,OUT,"SUPPLIED-INSTALL n=1 bytes=1,0,0\n");
  return;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  let lc:i32=label_check(W,OUT,2176,ig(W,32),1);
  eS(W,OUT,"LABEL-CHECK T1 ok="); eN(W,OUT,lc); eS(W,OUT,"\n");
  teach_all(W,OUT);
  let init_rel:i32=ig(W,24);
  vc_compose(W,OUT,3,96,1,1);
  let ok:i32=0;
  if(ig(W,28)==1){
    let m1:i32=ig(W,8);
    let m2:i32=ig(W,12);
    let rl:i32=ig(W,40);
    let mc:i32=m_created_flag(W);
    let mn:i32=W[2112] as i32;
    let p0:i32=W[2116] as i32;
    let p1:i32=W[2117] as i32;
    let p2:i32=W[2118] as i32;
    // m1=GRAMMAR, m2=CONSTRUCT, relation rebound away from the
    // training binding (learner-determined; the trace shows it), and
    // the intermediate was created by the learner with the expected
    // constructed program.
    if(m1==1 && m2==2 && rl!=init_rel && mc==1 && mn==1 && p0==1 && p1==0 && p2==0){ ok=1; }
  }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  eS(W,OUT,"=== TREAT-L2 Z2 ===\n");
  let bc0:i32=m_build_count(W);
  vc_compose(W,OUT,4,120,1,1);
  let ok2:i32=0;
  if(ig(W,28)==1 && m_build_count(W)==bc0){ ok2=1; }
  if(ok2==1){ eS(W,OUT,"Z2-RESULT PASS\n"); } else { eS(W,OUT,"Z2-RESULT FAIL\n"); }
  put32(W,20,ig(W,20)+ok2);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  vc_compose(W,OUT,3,96,0,1);
  if(ig(W,28)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ablx(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  del_behav(W,0);
  vc_compose(W,OUT,3,96,1,1);
  if(ig(W,28)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ably(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  del_behav(W,1);
  vc_compose(W,OUT,3,96,1,1);
  if(ig(W,28)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  vc_compose(W,OUT,3,96,1,1);
  if(ig(W,28)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_nom(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== NO-M ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  vc_compose(W,OUT,3,96,1,0);
  if(ig(W,28)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_supplied(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== SUPPLIED ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  install_supplied(W,OUT);
  vc_compose(W,OUT,3,96,1,1);
  if(ig(W,28)==1){ eS(W,OUT,"ARM-RESULT PASS\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL\n"); put32(W,20,0); }
  return;
}
fn arm_revise(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== REVISE ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W); g2_labels(W);
  let lc:i32=label_check(W,OUT,2440,ig(W,36),2);
  eS(W,OUT,"LABEL-CHECK T2 ok="); eN(W,OUT,lc); eS(W,OUT,"\n");
  teach_all(W,OUT);
  vc_compose(W,OUT,3,96,1,1);
  let okz:i32=ig(W,28);
  eS(W,OUT,"REVISE-Z ok="); eN(W,OUT,okz); eS(W,OUT,"\n");
  let ac:i32=m_adapt(W,OUT,2440,ig(W,36),24,36);
  eS(W,OUT,"ADAPT-CODE "); eN(W,OUT,ac); eS(W,OUT,"\n");
  m_print_prog(W,OUT);
  m_print_prev(W,OUT);
  vc_compose(W,OUT,5,145,1,1);
  let ok:i32=0;
  let pn:i32=W[2144] as i32;
  let ps:i32=W[2145] as i32;
  let cn:i32=W[2112] as i32;
  let c0:i32=W[2116] as i32;
  let c1:i32=W[2117] as i32;
  let c2:i32=W[2118] as i32;
  let c3:i32=W[2119] as i32;
  let c4:i32=W[2120] as i32;
  let c5:i32=W[2121] as i32;
  if(okz==1 && ac==2 && ig(W,28)==1 && pn==1 && ps==1 && cn==2 && c0==1 && c1==0 && c2==0 && c3==4 && c4==0 && c5==0){ ok=1; }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  cur=e1str(OUT,cur,"TR-H2-START\n");
  let W1:[]u8=z_alloc(8192); glm_init(W1); put32(W1,16,cur);
  arm_treat(W1,OUT); cur=ig(W1,16); let v1:i32=ig(W1,20);
  let W2:[]u8=z_alloc(8192); glm_init(W2); put32(W2,16,cur);
  arm_l1only(W2,OUT); cur=ig(W2,16); let v2:i32=ig(W2,20);
  let W3:[]u8=z_alloc(8192); glm_init(W3); put32(W3,16,cur);
  arm_ablx(W3,OUT); cur=ig(W3,16); let v3:i32=ig(W3,20);
  let W4:[]u8=z_alloc(8192); glm_init(W4); put32(W4,16,cur);
  arm_ably(W4,OUT); cur=ig(W4,16); let v4:i32=ig(W4,20);
  let W5:[]u8=z_alloc(8192); glm_init(W5); put32(W5,16,cur);
  arm_fresh(W5,OUT); cur=ig(W5,16); let v5:i32=ig(W5,20);
  let W6:[]u8=z_alloc(8192); glm_init(W6); put32(W6,16,cur);
  arm_nom(W6,OUT); cur=ig(W6,16); let v6:i32=ig(W6,20);
  let W7:[]u8=z_alloc(8192); glm_init(W7); put32(W7,16,cur);
  arm_supplied(W7,OUT); cur=ig(W7,16); let v7:i32=ig(W7,20);
  let W8:[]u8=z_alloc(8192); glm_init(W8); put32(W8,16,cur);
  arm_revise(W8,OUT); cur=ig(W8,16); let v8:i32=ig(W8,20);
  // v1 counts Z and Z2 (2 points); the rest count 1 each.
  let tot:i32=v1+v2+v3+v4+v5+v6+v7+v8;
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/9\n");
  cur=e1str(OUT,cur,"TR-H2-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

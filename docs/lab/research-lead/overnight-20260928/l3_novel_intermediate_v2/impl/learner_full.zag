// prelude.zag -- shared low-level utilities for L3-NIV2.
// Pure Zag. Follows the pinned-znc lessons: u8-backed cells with ig/is
// helpers, single-buffer output with one raw syscall per line, no
// _zag_print for dynamic content, no !(A && B) in while conditions.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
// Emit helpers: format into OUT at cur, return new cur.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1hex(OUT:[]u8,cur:i32,b:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    let v:i32=b[i] as i32;
    let hi:i32=(v>>4)&15;
    let lo:i32=v&15;
    let hc:i32=hi+48;
    if(hi>=10){ hc=hi+87; }
    let lc:i32=lo+48;
    if(lo>=10){ lc=lo+87; }
    OUT[cur]=hc as u8; OUT[cur+1]=lc as u8;
    cur=cur+2; i=i+1;
  }
  return cur;
}
// One raw syscall write of OUT[0..len) to fd. Single syscall per call.
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  let w:i64=_zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
// ---- integer parsing ----
// p_int: parse decimal integer at b[p..e). Returns new position; value
// goes to ov[0..4] via put32. Handles leading '-' and whitespace.
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    if(c==32 || c==9 || c==10 || c==13){ i=i+1; } else { break; }
  }
  let neg:i32=0;
  if(i<e && b[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<e){
    let c:i32=b[i] as i32;
    if(c<48 || c>57){ break; }
    v=v*10+(c-48);
    i=i+1;
  }
  if(neg==1){ v=0-v; }
  put32(ov,0,v);
  return i;
}
fn hexval(c:i32)i32 {
  if(c>=48 && c<=57){ return c-48; }
  if(c>=97 && c<=102){ return c-97+10; }
  if(c>=65 && c<=70){ return c-65+10; }
  return -1;
}
// hexdec: decode hex chars at b[p..p+2*n) into out[0..n). Returns 1 ok.
fn hexdec(b:[]u8,p:i32,out:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    let h:i32=hexval(b[p+i*2] as i32);
    let l:i32=hexval(b[p+i*2+1] as i32);
    if(h<0 || l<0){ return 0; }
    out[i]=(h*16+l) as u8;
    i=i+1;
  }
  return 1;
}
// ---- line reader ----
// R block: [0..4)=leftover count, [16..4112)=leftover bytes.
// read_line(R,fd,out,maxlen): reads one \n-terminated line into out,
// returns length excluding \n, -1 on EOF (no data), -2 on overflow.
fn rd_init(R:[]u8)void {
  put32(R,0,0);
  return;
}
fn read_line(R:[]u8,fd:i32,out:[]u8,maxlen:i32)i32 {
  let olen:i32=0;
  let tmp:[]u8=z_alloc(4096);
  while(1==1){
    // scan leftover for newline
    let lc:i32=ig(R,0);
    let i:i32=0;
    let found:i32=-1;
    while(i<lc){
      if(R[16+i]==10){ found=i; break; }
      i=i+1;
    }
    if(found>=0){
      let k:i32=0;
      while(k<found){
        if(olen>=maxlen){ return -2; }
        out[olen]=R[16+k]; olen=olen+1; k=k+1;
      }
      // shift leftover
      let nl:i32=lc-found-1;
      let j:i32=0;
      while(j<nl){ R[16+j]=R[16+found+1+j]; j=j+1; }
      put32(R,0,nl);
      return olen;
    }
    // move all leftover to out
    let k2:i32=0;
    while(k2<lc){
      if(olen>=maxlen){ return -2; }
      out[olen]=R[16+k2]; olen=olen+1; k2=k2+1;
    }
    put32(R,0,0);
    let nr:i64=_zag_raw_syscall(0,(fd as i64),(_zag_slice_ptr(tmp) as i64),4096,0,0,0);
    let nri:i32=nr as i32;
    if(nri<=0){ 
      if(olen>0){ return olen; }
      return -1;
    }
    let j2:i32=0;
    while(j2<nri){ R[16+j2]=tmp[j2]; j2=j2+1; }
    put32(R,0,nri);
  }
  return -1;
}
// token: extract space-separated token t (0-based) from line b[0..n).
// Returns length; bytes copied to out.
fn gettok(b:[]u8,n:i32,t:i32,out:[]u8)i32 {
  let i:i32=0;
  let cur_t:i32=0;
  while(i<n){
    while(i<n && b[i]==32){ i=i+1; }
    if(i>=n){ break; }
    let s:i32=i;
    while(i<n && b[i]!=32){ i=i+1; }
    if(cur_t==t){
      let k:i32=0;
      while(s+k<i){ out[k]=b[s+k]; k=k+1; }
      return i-s;
    }
    cur_t=cur_t+1;
  }
  return 0;
}
// strcmp on []u8
fn seq8(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// LCG rng: st block [0..4)=state. Returns next i32 (mod 2^31).
fn rng_next(st:[]u8)i32 {
  let s:i64=ig(st,0) as i64;
  s=(s*1103515245+12345)&2147483647;
  put32(st,0,s as i32);
  return s as i32;
}
fn rng_seed(st:[]u8,seed:i32)void {
  put32(st,0,seed&2147483647);
  return;
}
// fnv1a 64-bit over bytes, hex into OUT.
fn e1fnv(OUT:[]u8,cur:i32,b:[]u8,n:i32,seed:i64)i32 {
  let h:i64=seed;
  let i:i32=0;
  while(i<n){
    h=h^(b[i] as i64);
    h=h*1099511628211;
    i=i+1;
  }
  // emit 16 hex chars
  let k:i32=15;
  while(k>=0){
    let nyb:i32=((h>>((15-k)*4))&15) as i32;
    let c:i32=nyb+48;
    if(nyb>=10){ c=nyb+87; }
    OUT[cur]=c as u8; cur=cur+1; k=k-1;
  }
  return cur;
}
// isa.zag -- frozen generic ISA for L3-NIV2.
// Basis (frozen, recorded at code freeze): the C281-line 5-op register
// ISA already present in the learner lineage:
//   0=CPY (Rd=Rs), 1=ADD (Rd+=Rs), 2=MUL (Rd*=Rs),
//   3=SET1 (Rd=1), 4=INC (Rd+=1).
// Registers R0..R3 (i32). R0 preloaded with input x. Output is R0.
// Instruction = 3 bytes (op,d,s). Program = flat instruction sequence,
// max 64 instructions (192 bytes); the cap is a resource bound, never
// binding on the battery (required solutions are length 3 to 6).
// ZERO new opcodes, ZERO new semantic cases. Execution semantics are
// ported exactly from the committed
// xdomain_grammar_l2m/glm_learner.zag m_exec (restructured only to keep
// if-nesting at 3 or fewer per the pinned-znc lessons; behavior
// identical: same register updates, same output).

fn ISA_NOP()i32 { return 0; }
fn ISA_MAXLEN()i32 { return 64; }
fn ISA_ERR()i32 { return -2000000000; }

fn isa_exec(prog:[]u8,n:i32,x:i32)i32 {
  let r:[]u8=z_alloc(16);
  put32(r,0,x); put32(r,4,0); put32(r,8,0); put32(r,12,0);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let bad:i32=0;
    if(op<0 || op>4){ bad=1; }
    if(d<0 || d>3){ bad=1; }
    if(s<0 || s>3){ bad=1; }
    if(bad==1){ return -2000000000; }
    let rs:i32=ig(r,s*4);
    let dv:i32=ig(r,d*4);
    let nv:i32=dv;
    if(op==0){ nv=rs; }
    else {
      if(op==1){ nv=dv+rs; }
      else {
        if(op==2){ nv=dv*rs; }
        else {
          if(op==3){ nv=1; }
          else { nv=dv+1; }
        }
      }
    }
    put32(r,d*4,nv);
    k=k+1;
  }
  return ig(r,0);
}
// isa_exec_bytes: execute with ERR sentinel mapped from invalid encodings.
// Returns 1 and sets ov[0..4] on success, 0 on error.
fn isa_run(prog:[]u8,n:i32,x:i32,ov:[]u8)i32 {
  let v:i32=isa_exec(prog,n,x);
  if(v==-2000000000){ return 0; }
  put32(ov,0,v);
  return 1;
}
// prog_cmp: lexicographic byte compare of two programs. Returns -1/0/1.
fn prog_cmp(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  let n:i32=an;
  if(bn<n){ n=bn; }
  let i:i32=0;
  while(i<n){
    let x:i32=a[i] as i32;
    let y:i32=b[i] as i32;
    if(x<y){ return -1; }
    if(x>y){ return 1; }
    i=i+1;
  }
  if(an<bn){ return -1; }
  if(an>bn){ return 1; }
  return 0;
}
// prog_eq: byte equality.
fn prog_eq(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  if(an!=bn){ return 0; }
  return prog_cmp(a,an,b,bn)==0;
}
// lm_prot.zag -- learner protocol, logging, trace (L3-NIV2).
// The learner NEVER reads the key file and NEVER receives expected
// values. Its only supervision is the ACCEPT/REJECT consequence channel.

// cfg block layout (512 bytes):
// 0 seed, 4 trace_seq, 8 tests_total, 12 tests_phase, 16 budget_phase,
// 20 exhausted, 24 train_n, 28 lineage_next, 32 abst_n, 36 pool_n,
// 40 cand_id_next, 44 evals, 48 arm_tests_start,
// 52 m_len (current M program), 56 m_bytes[192] -> 248,
// 248 m_lineage, 252 m_slot
fn cfg_init(cfg:[]u8,seed:i32)void {
  let i:i32=0;
  while(i<512){ cfg[i]=0; i=i+1; }
  put32(cfg,0,seed);
  put32(cfg,28,1);
  put32(cfg,40,1);
  return;
}
fn tr_next(cfg:[]u8)i32 {
  let s:i32=ig(cfg,4)+1;
  put32(cfg,4,s);
  return s;
}
// lg_flush: write OUT[0..cur) to fd 2, return 0.
fn lg_flush(OUT:[]u8,cur:i32)i32 {
  wraw(2,OUT,cur);
  return 0;
}
// lg_str: append s to log buffer; flush if near full.
fn lg_str(cfg:[]u8,OUT:[]u8,lgc:[]u8,s:[]u8)void {
  let cur:i32=ig(lgc,0);
  if(cur>900000){ cur=lg_flush(OUT,cur); put32(lgc,0,cur); }
  cur=e1str(OUT,cur,s);
  put32(lgc,0,cur);
  return;
}
fn lg_line(cfg:[]u8,OUT:[]u8,lgc:[]u8,s:[]u8)void {
  lg_str(cfg,OUT,lgc,s);
  let cur:i32=ig(lgc,0);
  OUT[cur]=10; cur=cur+1;
  put32(lgc,0,cur);
  return;
}
fn lg_num2(cfg:[]u8,OUT:[]u8,lgc:[]u8,tag:[]u8,v:i64)void {
  let cur:i32=ig(lgc,0);
  if(cur>900000){ cur=lg_flush(OUT,cur); }
  cur=e1str(OUT,cur,tag);
  cur=e1i64(OUT,cur,v);
  OUT[cur]=10; cur=cur+1;
  put32(lgc,0,cur);
  return;
}
// tr: structured trace line: TR <seq> <kind> <rest...>
// Caller builds rest in RB and passes length.
fn tr_emit(cfg:[]u8,OUT:[]u8,lgc:[]u8,kind:[]u8,RB:[]u8,rlen:i32)void {
  let cur:i32=ig(lgc,0);
  if(cur>900000){ cur=lg_flush(OUT,cur); }
  cur=e1str(OUT,cur,"TR ");
  cur=e1i64(OUT,cur,tr_next(cfg) as i64);
  OUT[cur]=32; cur=cur+1;
  cur=e1str(OUT,cur,kind);
  OUT[cur]=32; cur=cur+1;
  let k:i32=0;
  while(k<rlen){ OUT[cur]=RB[k]; cur=cur+1; k=k+1; }
  OUT[cur]=10; cur=cur+1;
  put32(lgc,0,cur);
  return;
}
// ---- protocol ----
// psend: write line (no trailing newline in s) to fd 1, log WIRE >.
fn psend(cfg:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,s:[]u8,ln:i32)void {
  let k:i32=0;
  while(k<ln){ PL[k]=s[k]; k=k+1; }
  PL[ln]=10;
  wraw(1,PL,ln+1);
  let cur:i32=ig(lgc,0);
  if(cur>900000){ cur=lg_flush(OUT,cur); }
  cur=e1str(OUT,cur,"WIRE > ");
  let j:i32=0;
  while(j<ln){ OUT[cur]=s[j]; cur=cur+1; j=j+1; }
  OUT[cur]=10; cur=cur+1;
  put32(lgc,0,cur);
  return;
}
// precv: read one line from fd 0 into line, log WIRE <. Returns len or -1.
fn precv(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,line:[]u8) i32 {
  let ll:i32=read_line(R,0,line,4096);
  if(ll>=0){
    let cur:i32=ig(lgc,0);
    if(cur>900000){ cur=lg_flush(OUT,cur); }
    cur=e1str(OUT,cur,"WIRE < ");
    let j:i32=0;
    while(j<ll){ OUT[cur]=line[j]; cur=cur+1; j=j+1; }
    OUT[cur]=10; cur=cur+1;
    put32(lgc,0,cur);
  }
  return ll;
}
// do_test: send TEST(x,y), return 1 ACCEPT, 0 REJECT, -1 on budget/protocol error.
// yerr=1 sends ERR token instead of y.
fn do_test(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,x:i32,y:i32,yerr:i32,cand:i32)i32 {
  if(ig(cfg,20)==1){ return -1; }
  if(ig(cfg,12)>=ig(cfg,16)){ put32(cfg,20,1); return -1; }
  let LB:[]u8=z_alloc(128);
  let c:i32=0;
  c=e1str(LB,c,"TEST ");
  c=e1i64(LB,c,x as i64); LB[c]=32; c=c+1;
  if(yerr==1){ c=e1str(LB,c,"ERR"); } else { c=e1i64(LB,c,y as i64); }
  psend(cfg,OUT,lgc,PL,LB,c);
  put32(cfg,8,ig(cfg,8)+1);
  put32(cfg,12,ig(cfg,12)+1);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return -1; }
  let t0:i32=gettok(line,ll,0,tok);
  let acc:i32=seq8(tok[0..t0],"ACCEPT");
  // trace
  let RB:[]u8=z_alloc(128);
  let rc:i32=0;
  rc=e1i64(RB,rc,cand as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,x as i64); RB[rc]=32; rc=rc+1;
  if(yerr==1){ rc=e1str(RB,rc,"ERR"); } else { rc=e1i64(RB,rc,y as i64); }
  RB[rc]=32; rc=rc+1;
  if(acc==1){ RB[rc]=65; } else { RB[rc]=82; }
  rc=rc+1;
  tr_emit(cfg,OUT,lgc,"TEST",RB,rc);
  if(acc==1){ return 1; }
  return 0;
}
// observe: OBSERVE <count> <orderseed>; fills train block; returns count.
fn observe(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,count:i32,oseed:i32)i32 {
  let LB:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(LB,c,"OBSERVE ");
  c=e1i64(LB,c,count as i64); LB[c]=32; c=c+1;
  c=e1i64(LB,c,oseed as i64);
  psend(cfg,OUT,lgc,PL,LB,c);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,count as i64);
  tr_emit(cfg,OUT,lgc,"OBSERVE",RB,rc);
  let got:i32=0;
  while(got<count){
    let ll:i32=precv(cfg,R,OUT,lgc,line);
    if(ll<0){ return -1; }
    let t0:i32=gettok(line,ll,0,tok);
    if(seq8(tok[0..t0],"END")==1){ break; }
    if(seq8(tok[0..t0],"INSTANCE")==1){
      let t1:i32=gettok(line,ll,1,tok);
      let pp:i32=p_int(tok,0,t1,ov);
      put32(train,got*4,ig(ov,0));
      got=got+1;
    }
  }
  // consume the trailing END if we stopped on count
  if(got>=count){
    let ll2:i32=precv(cfg,R,OUT,lgc,line);
  }
  put32(cfg,24,got);
  return got;
}
// observe_extra: OBSERVE_EXTRA <count>
fn observe_extra(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,count:i32)i32 {
  let LB:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(LB,c,"OBSERVE_EXTRA ");
  c=e1i64(LB,c,count as i64);
  psend(cfg,OUT,lgc,PL,LB,c);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,count as i64);
  tr_emit(cfg,OUT,lgc,"OBSERVE_EXTRA",RB,rc);
  let got:i32=0;
  while(got<count){
    let ll:i32=precv(cfg,R,OUT,lgc,line);
    if(ll<0){ return -1; }
    let t0:i32=gettok(line,ll,0,tok);
    if(seq8(tok[0..t0],"END")==1){ break; }
    if(seq8(tok[0..t0],"INSTANCE")==1){
      let t1:i32=gettok(line,ll,1,tok);
      let pp:i32=p_int(tok,0,t1,ov);
      put32(train,got*4,ig(ov,0));
      got=got+1;
    }
  }
  if(got>=count){
    let ll2:i32=precv(cfg,R,OUT,lgc,line);
  }
  put32(cfg,24,got);
  return got;
}
// commit_prog: COMMIT <slot> <lineage> <parent> <hex>; returns 1 ok.
fn commit_prog(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,slot:i32,lin:i32,par:i32,prog:[]u8,n:i32)i32 {
  let LB:[]u8=z_alloc(512);
  let c:i32=0;
  c=e1str(LB,c,"COMMIT ");
  c=e1i64(LB,c,slot as i64); LB[c]=32; c=c+1;
  c=e1i64(LB,c,lin as i64); LB[c]=32; c=c+1;
  c=e1i64(LB,c,par as i64); LB[c]=32; c=c+1;
  c=e1hex(LB,c,prog,n);
  psend(cfg,OUT,lgc,PL,LB,c);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return 0; }
  let t0:i32=gettok(line,ll,0,tok);
  if(seq8(tok[0..t0],"COMMITTED")==0){ return 0; }
  let RB:[]u8=z_alloc(512);
  let rc:i32=0;
  rc=e1i64(RB,rc,slot as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,lin as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,par as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,n as i64); RB[rc]=32; rc=rc+1;
  rc=e1hex(RB,rc,prog,n);
  tr_emit(cfg,OUT,lgc,"COMMIT",RB,rc);
  return 1;
}
// do_score: SCORE <slot>; parses RESULT; returns accepts, verdict into vd.
fn do_score(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,slot:i32,vd:[]u8)i32 {
  let LB:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(LB,c,"SCORE ");
  c=e1i64(LB,c,slot as i64);
  psend(cfg,OUT,lgc,PL,LB,c);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return -1; }
  let t1:i32=gettok(line,ll,1,tok);
  let p1:i32=p_int(tok,0,t1,ov); let a:i32=ig(ov,0);
  let t2:i32=gettok(line,ll,2,tok);
  let p2:i32=p_int(tok,0,t2,ov); let t:i32=ig(ov,0);
  let t3:i32=gettok(line,ll,3,tok);
  let k:i32=0;
  while(k<t3){ vd[k]=tok[k]; k=k+1; }
  vd[t3]=0;
  let t4:i32=gettok(line,ll,4,tok);
  let RB:[]u8=z_alloc(128);
  let rc:i32=0;
  rc=e1i64(RB,rc,a as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,t as i64); RB[rc]=32; rc=rc+1;
  rc=e1str(RB,rc,vd[0..t3]); RB[rc]=32; rc=rc+1;
  let j:i32=0;
  while(j<t4){ RB[rc]=tok[j]; rc=rc+1; j=j+1; }
  tr_emit(cfg,OUT,lgc,"SCORE",RB,rc);
  return a;
}
// do_tally: TALLY; returns accepts.
fn do_tally(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,vd:[]u8)i32 {
  let LB:[]u8=z_alloc(16);
  let c:i32=0;
  c=e1str(LB,c,"TALLY");
  psend(cfg,OUT,lgc,PL,LB,c);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return -1; }
  let t1:i32=gettok(line,ll,1,tok);
  let p1:i32=p_int(tok,0,t1,ov); let a:i32=ig(ov,0);
  let t2:i32=gettok(line,ll,2,tok);
  let p2:i32=p_int(tok,0,t2,ov); let t:i32=ig(ov,0);
  let t3:i32=gettok(line,ll,3,tok);
  let k:i32=0;
  while(k<t3){ vd[k]=tok[k]; k=k+1; }
  vd[t3]=0;
  let RB:[]u8=z_alloc(128);
  let rc:i32=0;
  rc=e1i64(RB,rc,a as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,t as i64); RB[rc]=32; rc=rc+1;
  rc=e1str(RB,rc,vd[0..t3]);
  tr_emit(cfg,OUT,lgc,"TALLY",RB,rc);
  return a;
}
// send_arm: ARM <label>; expects ARM-OK.
fn send_arm(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,label:[]u8)i32 {
  let LB:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(LB,c,"ARM ");
  c=e1str(LB,c,label);
  psend(cfg,OUT,lgc,PL,LB,c);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return 0; }
  tr_emit(cfg,OUT,lgc,"ARM-BEGIN",label,label.len);
  return 1;
}
// lm_cons.zag -- propose-and-test construction engine (L3-NIV2).
// Frozen design (see ADVERSARY_NOTES.md):
// - Complete candidate programs scored by training ACCEPT count through
//   the consequence channel (early exit on first REJECT; the score is the
//   deterministic ACCEPT count).
// - Promotion/retention never requires strictly positive per-step gain:
//   a child is retained iff its score >= its parent's score (zero gain
//   retained), or a bounded depth-2 lookahead shows eventual full
//   acceptance (negative-gain rescue, anti-V2).
// - Beam: width 10, rank by (score desc, length asc, bytes asc, id asc).
//   Ranking is mechanical; no researcher-authored tie-break.
// - Operators: APPEND, SUBSTITUTE-last (construction); TRUNCATE used in
//   revision; INLINE (abstraction chunks) in transfer re-derivation.
//   One engine serves construction, revision, and transfer.

// pool entry stride 216: [0]=id,[4]=parent,[8]=op,[12]=len,
// [16..208]=bytes(192),[208]=score,[212]=evals
// op codes: 0 SEED, 1 APPEND, 2 SUBST, 3 INLINE, 4 EDIT, 5 GREEDY, 6 ENUM
fn POOL_N()i32 { return 32768; }
fn pool_base(pi:i32)i32 { return pi*216; }
fn cand_id(pool:[]u8,pi:i32)i32 { return ig(pool,pool_base(pi)); }
fn cand_len(pool:[]u8,pi:i32)i32 { return ig(pool,pool_base(pi)+12); }
fn cand_score(pool:[]u8,pi:i32)i32 { return ig(pool,pool_base(pi)+208); }
fn cand_op(pool:[]u8,pi:i32)i32 { return ig(pool,pool_base(pi)+8); }

fn cons_reset(cfg:[]u8,pool:[]u8,stab:[]u8)void {
  put32(cfg,36,0); put32(cfg,40,1);
  let i:i32=0;
  while(i<65536){ put32(stab,i*8,-1); i=i+1; }
  return;
}
fn phash(prog:[]u8,n:i32)i32 {
  let h:i32=2166136261;
  let i:i32=0;
  while(i<n){
    h=h^(prog[i] as i32);
    h=h*16777619;
    i=i+1;
  }
  h=h^(n*2654435761);
  if(h<0){ h=0-h; }
  return h;
}
// stab_lookup: returns pool idx or -1.
fn stab_lookup(stab:[]u8,h:i32,pool:[]u8,prog:[]u8,n:i32)i32 {
  let s:i32=h&65535;
  let k:i32=0;
  while(k<65536){
    let e:i32=(s+k)&65535;
    let eh:i32=ig(stab,e*8);
    if(eh==-1){ return -1; }
    if(eh==h){
      let pi:i32=ig(stab,e*8+4);
      let bl:i32=cand_len(pool,pi);
      if(bl==n){
        let bb:i32=pool_base(pi)+16;
        let eq:i32=1;
        let i:i32=0;
        while(i<n){ if(pool[bb+i]!=prog[i]){ eq=0; break; } i=i+1; }
        if(eq==1){ return pi; }
      }
    }
    k=k+1;
  }
  return -1;
}
fn stab_insert(stab:[]u8,h:i32,pi:i32)void {
  let s:i32=h&65535;
  let k:i32=0;
  while(k<65536){
    let e:i32=(s+k)&65535;
    if(ig(stab,e*8)==-1){ put32(stab,e*8,h); put32(stab,e*8+4,pi); return; }
    k=k+1;
  }
  return;
}
fn mk_cand(cfg:[]u8,pool:[]u8,parent:i32,op:i32,prog:[]u8,n:i32)i32 {
  let pn:i32=ig(cfg,36);
  if(pn>=32768){ return -1; }
  let b:i32=pool_base(pn);
  let id:i32=ig(cfg,40);
  put32(cfg,40,id+1);
  put32(pool,b,id); put32(pool,b+4,parent); put32(pool,b+8,op);
  put32(pool,b+12,n);
  let i:i32=0;
  while(i<n*3){ pool[b+16+i]=prog[i]; i=i+1; }
  put32(pool,b+208,-1); put32(pool,b+212,0);
  put32(cfg,36,pn+1);
  return pn;
}
// cand_cmp: 1 if a ranks better than b.
fn cand_cmp(pool:[]u8,a:i32,b:i32)i32 {
  let sa:i32=cand_score(pool,a);
  let sb:i32=cand_score(pool,b);
  if(sa>sb){ return 1; }
  if(sa<sb){ return 0; }
  let la:i32=cand_len(pool,a);
  let lb:i32=cand_len(pool,b);
  if(la<lb){ return 1; }
  if(la>lb){ return 0; }
  let ba:i32=pool_base(a)+16;
  let bb:i32=pool_base(b)+16;
  let i:i32=0;
  while(i<la){
    let x:i32=pool[ba+i] as i32;
    let y:i32=pool[bb+i] as i32;
    if(x<y){ return 1; }
    if(x>y){ return 0; }
    i=i+1;
  }
  if(cand_id(pool,a)<cand_id(pool,b)){ return 1; }
  return 0;
}
// fharv: consequence-derived partial target map (wave 3, CALR).
// cfg+256: fhat values (16 i32, train-indexed); cfg+320: known flags;
// cfg+384: enable flag (1 = record ACCEPTs into fhat).
// The learner derives fhat ONLY from its own TEST/ACCEPT history through
// the consequence channel. No expected value crosses the channel.
fn fharv_note(cfg:[]u8,i:i32,y:i32,ok:i32)void {
  if(ig(cfg,384)==0){ return; }
  if(ok==0){ return; }
  if(i<0 || i>=16){ return; }
  put32(cfg,256+i*4,y);
  put32(cfg,320+i*4,1);
  return;
}
fn fharv_reset(cfg:[]u8)void {
  let i:i32=0;
  while(i<16){ put32(cfg,256+i*4,0); put32(cfg,320+i*4,0); i=i+1; }
  put32(cfg,384,1);
  return;
}
fn fharv_off(cfg:[]u8)void {
  put32(cfg,384,0);
  return;
}
// eval_prog: score pool[pi] on training via TESTs.
// Two-pass: first 3 instances (early exit); if >=1 ACCEPT, test rest.
// Returns exact ACCEPT count for candidates with any early signal,
// 0 for others. Uses scored-set dedupe. Logs TR EVAL.
fn eval_prog(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,pi:i32)i32 {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  let nb:i32=n*3;
  let h:i32=phash(pool[b+16..b+208],nb);
  let hit:i32=stab_lookup(stab,h,pool,pool[b+16..b+208],nb);
  if(hit>=0){ return cand_score(pool,hit); }
  let tn:i32=ig(cfg,24);
  let sc:i32=0;
  let i:i32=0;
  let stop:i32=0;
  // pass 1: first 3 instances, early exit on first REJECT
  let p1n:i32=3;
  if(tn<3){ p1n=tn; }
  while(i<p1n && stop==0){
    let x:i32=ig(train,i*4);
    let ov2:[]u8=z_alloc(8);
    let ok:i32=isa_run(pool[b+16..b+208],n,x,ov2);
    let r:i32=0;
    if(ok==1){ r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,ig(ov2,0),0,cand_id(pool,pi)); }
    else { r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,0,1,cand_id(pool,pi)); }
    if(r==-1){ stop=1; }
    else { if(r==1){ sc=sc+1; fharv_note(cfg,i,ig(ov2,0),ok); } else { stop=1; } }
    i=i+1;
  }
  // pass 2: remaining instances (only if pass 1 had a signal)
  if(stop==0 && sc>0){
    while(i<tn && stop==0){
      let x2:i32=ig(train,i*4);
      let ov3:[]u8=z_alloc(8);
      let ok2:i32=isa_run(pool[b+16..b+208],n,x2,ov3);
      let r2:i32=0;
      if(ok2==1){ r2=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x2,ig(ov3,0),0,cand_id(pool,pi)); }
      else { r2=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x2,0,1,cand_id(pool,pi)); }
      if(r2==-1){ stop=1; }
      else { if(r2==1){ sc=sc+1; fharv_note(cfg,i,ig(ov3,0),ok2); } }
      i=i+1;
    }
  }
  put32(pool,b+208,sc);
  stab_insert(stab,h,pi);
  put32(cfg,44,ig(cfg,44)+1);
  // log CAND + EVAL
  let RB:[]u8=z_alloc(512);
  let rc:i32=0;
  rc=e1i64(RB,rc,cand_id(pool,pi) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(pool,b+4) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(pool,b+8) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,n as i64); RB[rc]=32; rc=rc+1;
  rc=e1hex(RB,rc,pool[b+16..b+208],n*3);
  tr_emit(cfg,OUT,lgc,"CAND",RB,rc);
  let RB2:[]u8=z_alloc(64);
  let rc2:i32=0;
  rc2=e1i64(RB2,rc2,cand_id(pool,pi) as i64); RB2[rc2]=32; rc2=rc2+1;
  rc2=e1i64(RB2,rc2,sc as i64); RB2[rc2]=32; rc2=rc2+1;
  rc2=e1i64(RB2,rc2,tn as i64);
  tr_emit(cfg,OUT,lgc,"EVAL",RB2,rc2);
  return sc;
}
// beam_insert: insert pi into sorted beam (best first), cap 10.
fn beam_insert(pool:[]u8,beam:[]u8,bn:i32,pi:i32)i32 {
  let i:i32=0;
  while(i<bn){
    if(cand_cmp(pool,pi,ig(beam,i*4))==1){ break; }
    i=i+1;
  }
  if(i>=10){ return bn; }
  let nb:i32=bn;
  if(nb<10){ nb=nb+1; }
  let j:i32=nb-1;
  while(j>i){ put32(beam,j*4,ig(beam,(j-1)*4)); j=j-1; }
  put32(beam,i*4,pi);
  return nb;
}
// acc_add: add program (n instructions) to accepted set (dedupe by bytes).
// accb: 1024 entries x 200: [0]=n_instr,[4..196]=bytes
fn acc_add(accb:[]u8,accn:[]u8,prog:[]u8,n:i32)void {
  let an:i32=ig(accn,0);
  let i:i32=0;
  while(i<an){
    let bl:i32=ig(accb,i*200);
    if(bl==n){
      let eq:i32=1;
      let k:i32=0;
      while(k<n*3){ if(accb[i*200+4+k]!=prog[k]){ eq=0; break; } k=k+1; }
      if(eq==1){ return; }
    }
    i=i+1;
  }
  if(an>=1024){ return; }
  put32(accb,an*200,n);
  let k2:i32=0;
  while(k2<n*3){ accb[an*200+4+k2]=prog[k2]; k2=k2+1; }
  put32(accn,0,an+1);
  return;
}
// gen_appends: generate all 80 append children of pool[pi] into ch.
// Returns count added. Caller provides ch array and start count.
fn gen_appends(cfg:[]u8,pool:[]u8,pi:i32,op:i32,ch:[]u8,cn:i32)i32 {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  if(n>=64){ return cn; }
  let tmp:[]u8=z_alloc(192);
  let i:i32=0;
  while(i<n*3){ tmp[i]=pool[b+16+i]; i=i+1; }
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[n*3]=o as u8; tmp[n*3+1]=d as u8; tmp[n*3+2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,cand_id(pool,pi),op,tmp,n+1);
        if(ci>=0){ put32(ch,cn*4,ci); cn=cn+1; }
        s=s+1;
      }
      d=d+1;
    }
    o=o+1;
  }
  return cn;
}
// gen_substs: 80 substitute-last children.
fn gen_substs(cfg:[]u8,pool:[]u8,pi:i32,op:i32,ch:[]u8,cn:i32)i32 {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  if(n<1){ return cn; }
  let tmp:[]u8=z_alloc(192);
  let i:i32=0;
  while(i<n*3){ tmp[i]=pool[b+16+i]; i=i+1; }
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[(n-1)*3]=o as u8; tmp[(n-1)*3+1]=d as u8; tmp[(n-1)*3+2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,cand_id(pool,pi),op,tmp,n);
        if(ci>=0){ put32(ch,cn*4,ci); cn=cn+1; }
        s=s+1;
      }
      d=d+1;
    }
    o=o+1;
  }
  return cn;
}
// gen_inlines: parent ++ abstraction chunk (full + leading prefixes).
fn gen_inlines(cfg:[]u8,pool:[]u8,abst:[]u8,pi:i32,ch:[]u8,cn:i32)i32 {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  let na:i32=ig(cfg,32);
  let tmp:[]u8=z_alloc(192);
  let a:i32=0;
  while(a<na){
    let ab:i32=a*208;
    let al:i32=ig(abst,ab+4);
    let pl:i32=al;
    while(pl>=1){
      if(n+pl<=64){
        let i:i32=0;
        while(i<n*3){ tmp[i]=pool[b+16+i]; i=i+1; }
        let k2:i32=0;
        while(k2<pl*3){ tmp[n*3+k2]=abst[ab+8+k2]; k2=k2+1; }
        let ci:i32=mk_cand(cfg,pool,cand_id(pool,pi),3,tmp,n+pl);
        if(ci>=0){ put32(ch,cn*4,ci); cn=cn+1; }
      }
      pl=pl-1;
    }
    a=a+1;
  }
  return cn;
}
// lm_cons2.zag -- beam search, lookahead rescue, disambiguation,
// greedy control, enumeration control, revision (L3-NIV2).

// D_eq: frozen wide local domain for behavioral equivalence.
// -16..16 plus wide magnitudes (deterministic order).
fn deq_pts(pts:[]u8)i32 {
  let n:i32=0;
  let x:i32=-16;
  while(x<=16){ put32(pts,n*4,x); n=n+1; x=x+1; }
  let mag:i32=32;
  let k:i32=0;
  while(k<13){
    put32(pts,n*4,mag); n=n+1;
    put32(pts,n*4,0-mag); n=n+1;
    if(mag==32){ mag=64; } else { if(mag==64){ mag=128; } else { if(mag==128){ mag=256; } else { if(mag==256){ mag=512; } else { if(mag==512){ mag=1024; } else { if(mag==1024){ mag=4096; } else { if(mag==4096){ mag=16384; } else { if(mag==16384){ mag=65536; } else { if(mag==65536){ mag=262144; } else { if(mag==262144){ mag=1048576; } else { if(mag==1048576){ mag=16777216; } else { mag=1073741824; } } } } } } } } } } }
    k=k+1;
  }
  return n;
}
// prog_sig: outputs on D_eq into sig (59 i32).
fn prog_sig(prog:[]u8,n:i32,pts:[]u8,npts:i32,sig:[]u8)void {
  let i:i32=0;
  while(i<npts){
    let x:i32=ig(pts,i*4);
    let v:i32=isa_exec(prog,n,x);
    put32(sig,i*4,v);
    i=i+1;
  }
  return;
}
// cand_keyop: op of instruction at key_pos (0=first, -1=last).
fn cand_keyop(pool:[]u8,pi:i32,key_pos:i32)i32 {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  let p:i32=key_pos;
  if(p<0){ p=n-1; }
  if(p<0 || p>=n){ return -1; }
  return pool[b+16+p*3] as i32;
}
// sel_better: 1 if a ranks better than b for diverse selection
// (score desc, len asc, id asc).
fn sel_better(pool:[]u8,a:i32,b:i32)i32 {
  let sa:i32=cand_score(pool,a);
  let sb:i32=cand_score(pool,b);
  if(sa>sb){ return 1; }
  if(sa<sb){ return 0; }
  let la:i32=cand_len(pool,a);
  let lb:i32=cand_len(pool,b);
  if(la<lb){ return 1; }
  if(la>lb){ return 0; }
  if(cand_id(pool,a)<cand_id(pool,b)){ return 1; }
  return 0;
}
// select_diverse: top per_op per op-class (key_pos) by sel_better.
// idx[0..n) pool indices -> out array. Returns out_n.
fn select_diverse(pool:[]u8,idx:[]u8,n:i32,per_op:i32,key_pos:i32,out:[]u8)i32 {  let out_n:i32=0;
  let o:i32=0;
  while(o<5){
    let best:[]u8=z_alloc(32);
    let nb:i32=0;
    let i:i32=0;
    while(i<n){
      let c:i32=ig(idx,i*4);
      if(cand_keyop(pool,c,key_pos)==o){
        // insert into best (cap per_op)
        let j:i32=0;
        while(j<nb){
          if(sel_better(pool,c,ig(best,j*4))==1){ break; }
          j=j+1;
        }
        if(j<per_op){
          let nnb:i32=nb;
          if(nnb<per_op){ nnb=nnb+1; }
          let k:i32=nnb-1;
          while(k>j){ put32(best,k*4,ig(best,(k-1)*4)); k=k-1; }
          put32(best,j*4,c);
          nb=nnb;
        }
      }
      i=i+1;
    }
    let j2:i32=0;
    while(j2<nb){ put32(out,out_n*4,ig(best,j2*4)); out_n=out_n+1; j2=j2+1; }
    o=o+1;
  }
  return out_n;
}
// prog_sig6: program outputs on up to 6 training inputs via local
// isa_run (zero TEST cost) into sig (6 i32). Exec failure -> sentinel.
fn prog_sig6(pool:[]u8,pi:i32,train:[]u8,tn:i32,sig:[]u8)void {
  let b:i32=pool_base(pi);
  let n:i32=ig(pool,b+12);
  let i:i32=0;
  while(i<6){
    let v:i32=-2147483647;
    if(i<tn){
      let x:i32=ig(train,i*4);
      let ov:[]u8=z_alloc(8);
      let ok:i32=isa_run(pool[b+16..b+208],n,x,ov);
      if(ok==1){ v=ig(ov,0); }
    }
    put32(sig,i*4,v);
    i=i+1;
  }
  return;
}
// sighash: hash 6 i32s to nonnegative i32.
fn sighash(sig:[]u8)i32 {
  let h:i32=2166136261;
  let i:i32=0;
  while(i<6){
    let v:i32=ig(sig,i*4);
    h=h^(v&255); h=h*16777619;
    h=h^((v>>8)&255); h=h*16777619;
    h=h^((v>>16)&255); h=h*16777619;
    h=h^((v>>24)&255); h=h*16777619;
    i=i+1;
  }
  if(h<0){ h=0-h; }
  return h;
}
// beam_level: emit up to quota candidates of exact score level from
// idx[0..n), grouped by BEHAVIORAL signature (program outputs on
// training inputs; best-1 per signature by sel_better, groups ordered
// by representative quality), into out[off..]. Returns count emitted.
// Behavioral (not syntactic) diversity: programs computing the same
// function collapse to one group, so the beam preserves functionally
// distinct lineages even when a score level is crowded.
fn beam_level(pool:[]u8,idx:[]u8,n:i32,level:i32,quota:i32,out:[]u8,off:i32,train:[]u8,tn:i32)i32 {
  // Behavioral grouping, encounter order (no ordering sort).
  // Groups by signature; emits best-1 per signature up to quota,
  // in first-encounter order. Avoids the ordering-sort that panics.
  let gsigs:[]u8=z_alloc(6144);
  let grep:[]u8=z_alloc(1024);
  let gn2:i32=0;
  let sig:[]u8=z_alloc(24);
  let i:i32=0;
  while(i<n){
    let c:i32=ig(idx,i*4);
    if(cand_score(pool,c)==level){
      prog_sig6(pool,c,train,tn,sig);
      let f:i32=-1;
      let j:i32=0;
      while(j<gn2){
        let eq:i32=1;
        let k:i32=0;
        while(k<6){
          if(ig(gsigs,j*24+k*4)!=ig(sig,k*4)){ eq=0; break; }
          k=k+1;
        }
        if(eq==1){ f=j; break; }
        j=j+1;
      }
      if(f<0){
        if(gn2<256){
          let k2:i32=0;
          while(k2<6){ put32(gsigs,gn2*24+k2*4,ig(sig,k2*4)); k2=k2+1; }
          put32(grep,gn2*4,c);
          gn2=gn2+1;
        }
      }
      else {
        let cur:i32=ig(grep,f*4);
        if(sel_better(pool,c,cur)==1){ put32(grep,f*4,c); }
      }
    }
    i=i+1;
  }
  // emit in encounter order, up to quota
  let out_n:i32=0;
  while(out_n<gn2 && out_n<quota){
    put32(out,(off+out_n)*4,ig(grep,out_n*4));
    out_n=out_n+1;
  }
  return out_n;
}
// select_beam: score-stratified behaviorally-diverse beam. A purely
// score-greedy beam drops low-score structural lineages, but a length
// 3-6 solution can require a score-1 intermediate (score-2 dead ends
// exist), so each non-empty score level gets an equal quota. Within a
// level: groups by behavioral signature (program outputs on training
// inputs via local isa_run, zero TEST cost), best-1 per signature by
// sel_better, groups ordered by representative quality. Returns up to
// max_n entries. out must hold at least max_n u32s.
fn select_beam(pool:[]u8,idx:[]u8,n:i32,max_n:i32,out:[]u8,train:[]u8,tn:i32)i32 {
  let hist:[]u8=z_alloc(32);
  let L:i32=0;
  while(L<7){ put32(hist,L*4,0); L=L+1; }
  let i:i32=0;
  while(i<n){
    let sc:i32=cand_score(pool,ig(idx,i*4));
    if(sc<0){ sc=0; }
    if(sc>6){ sc=6; }
    put32(hist,sc*4,ig(hist,sc*4)+1);
    i=i+1;
  }
  let nl:i32=0;
  let s:i32=0;
  while(s<7){ if(ig(hist,s*4)>0){ nl=nl+1; } s=s+1; }
  if(nl==0){ return 0; }
  let q:i32=max_n/nl;
  if(q<1){ q=1; }
  let out_n:i32=0;
  let lv:i32=6;
  while(lv>=0 && out_n<max_n){
    if(ig(hist,lv*4)>0){
      let rem:i32=max_n-out_n;
      let qq:i32=q;
      if(qq>rem){ qq=rem; }
      let got:i32=beam_level(pool,idx,n,lv,qq,out,out_n,train,tn);
      out_n=out_n+got;
    }
    lv=lv-1;
  }
  return out_n;
}
// lh2: bounded depth-2 lookahead from child c (appends only).
// Any full-acceptance descendant -> accb; returns 1 if rescued.
fn lh2(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,c:i32)i32 {
  let rescued:i32=0;
  let ch:[]u8=z_alloc(8192);
  let chn:i32=0;
  chn=gen_appends(cfg,pool,c,1,ch,chn);
  let top:i32=-1;
  let i:i32=0;
  while(i<chn){
    let g:i32=ig(ch,i*4);
    let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,g);
    if(ig(cfg,20)==1){ break; }
    let b2:i32=pool_base(g);
    if(sc>=6){ acc_add(accb,accn,pool[b2+16..b2+208],ig(pool,b2+12)); rescued=1; }
    if(top<0){ top=g; } else { if(sel_better(pool,g,top)==1){ top=g; } }
    i=i+1;
  }
  if(rescued==0 && ig(cfg,20)==0 && top>=0){
    let ch2:[]u8=z_alloc(8192);
    let chn2:i32=0;
    chn2=gen_appends(cfg,pool,top,1,ch2,chn2);
    let j:i32=0;
    while(j<chn2){
      let h2:i32=ig(ch2,j*4);
      let sc2:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,h2);
      if(ig(cfg,20)==1){ break; }
      let b3:i32=pool_base(h2);
      if(sc2>=6){ acc_add(accb,accn,pool[b3+16..b3+208],ig(pool,b3+12)); rescued=1; break; }
      j=j+1;
    }
  }
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,cand_id(pool,c) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,rescued as i64);
  tr_emit(cfg,OUT,lgc,"LOOKAHEAD",RB,rc);
  return rescued;
}
// expand_level: one beam expansion with stratified beam and
// lookahead-driven trap handling. Returns new bn.
fn expand_level(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,bn:i32,ch:[]u8,transfer:i32,level:i32)i32 {
  // pstart/pend hold one u32 per beam member; bn can reach max_n=40,
  // so 32 slots (128 bytes) overflows. 64 slots with margin.
  let pstart:[]u8=z_alloc(512);
  let pend:[]u8=z_alloc(512);
  let chn:i32=0;
  let bi:i32=0;
  let stop:i32=0;
  while(bi<bn && stop==0){
    let p:i32=ig(beam,bi*4);
    put32(pstart,bi*4,chn);
    chn=gen_appends(cfg,pool,p,1,ch,chn);
    chn=gen_substs(cfg,pool,p,2,ch,chn);
    if(transfer==1){ chn=gen_inlines(cfg,pool,abst,p,ch,chn); }
    put32(pend,bi*4,chn);
    let ci:i32=ig(pstart,bi*4);
    while(ci<chn && stop==0){
      let c:i32=ig(ch,ci*4);
      let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,c);
      if(ig(cfg,20)==1){ stop=1; break; }
      let b2:i32=pool_base(c);
      if(sc>=6){ acc_add(accb,accn,pool[b2+16..b2+208],ig(pool,b2+12)); }
      ci=ci+1;
    }
    bi=bi+1;
  }
  // parent score lookup helper via ranges: parent_of(ci)
  // lookahead: top-3 parents by (score desc, id asc)
  let pord:[]u8=z_alloc(32);
  let pn3:i32=0;
  let bj:i32=0;
  while(bj<bn){
    let p2:i32=ig(beam,bj*4);
    // insert into pord (cap 3) by score desc, id asc
    let j:i32=0;
    while(j<pn3){
      let q:i32=ig(pord,j*4);
      let better:i32=0;
      if(cand_score(pool,p2)>cand_score(pool,q)){ better=1; }
      else { if(cand_score(pool,p2)==cand_score(pool,q) && cand_id(pool,p2)<cand_id(pool,q)){ better=1; } }
      if(better==1){ break; }
      j=j+1;
    }
    if(j<3){
      let nn3:i32=pn3;
      if(nn3<3){ nn3=nn3+1; }
      let k:i32=nn3-1;
      while(k>j){ put32(pord,k*4,ig(pord,(k-1)*4)); k=k-1; }
      put32(pord,j*4,p2);
      pn3=nn3;
    }
    bj=bj+1;
  }
  // rescued_marks is indexed by child position (bytes); chn can reach
  // bn*(80 appends + 80 substs + 8 abst*64 inline) = 26880 in transfer
  // mode, so this must exceed the ch entry capacity, not 8192.
  let rescued_marks:[]u8=z_alloc(262144);
  let ri:i32=0;
  while(ri<chn){ rescued_marks[ri]=0; ri=ri+1; }
  let pk:i32=0;
  while(pk<pn3 && stop==0){
    let p3:i32=ig(pord,pk*4);
    // find p3's range
    let bjj:i32=0;
    while(bjj<bn){ if(ig(beam,bjj*4)==p3){ break; } bjj=bjj+1; }
    if(bjj<bn){
      let cs:[]u8=z_alloc(chn*4+4);
      let csn:i32=ig(pstart,bjj*4);
      let cse:i32=ig(pend,bjj*4);
      let tmp_idx:[]u8=z_alloc(8192);
      let tn2:i32=0;
      let cc:i32=csn;
      while(cc<cse){ put32(tmp_idx,tn2*4,ig(ch,cc*4)); tn2=tn2+1; cc=cc+1; }
      let sel:[]u8=z_alloc(64);
      let seln:i32=select_diverse(pool,tmp_idx,tn2,1,-1,sel);
      let sq:i32=0;
      while(sq<seln && stop==0){
        let c2:i32=ig(sel,sq*4);
        let r2:i32=lh2(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,c2);
        if(ig(cfg,20)==1){ stop=1; break; }
        if(r2==1){
          // mark c2 rescued: find its position in ch
          let f:i32=csn;
          while(f<cse){ if(ig(ch,f*4)==c2){ rescued_marks[f]=1; break; } f=f+1; }
        }
        sq=sq+1;
      }
    }
    pk=pk+1;
  }
  // retention: score >= parent score, or rescued
  // ret holds up to chn entries; chn can reach 26880 in transfer mode
  // (see rescued_marks note), so 8192 entries (32768 bytes) overflows.
  let ret:[]u8=z_alloc(262144);
  let retn:i32=0;
  let ci2:i32=0;
  while(ci2<chn){
    let c3:i32=ig(ch,ci2*4);
    // find parent bi
    let pb:i32=0;
    while(pb<bn){
      if(ci2>=ig(pstart,pb*4) && ci2<ig(pend,pb*4)){ break; }
      pb=pb+1;
    }
    let keep_it:i32=0;
    if(pb<bn){
      let psc2:i32=cand_score(pool,ig(beam,pb*4));
      if(cand_score(pool,c3)>=psc2){ keep_it=1; }
    }
    if(rescued_marks[ci2]==1){ keep_it=1; }
    if(keep_it==1){ put32(ret,retn*4,c3); retn=retn+1; }
    ci2=ci2+1;
  }
  let nbn:i32=select_beam(pool,ret,retn,80,beam,train,ig(cfg,24));
  let RB:[]u8=z_alloc(64);
  let rcc:i32=0;
  rcc=e1i64(RB,rcc,level as i64); RB[rcc]=32; rcc=rcc+1;
  rcc=e1i64(RB,rcc,nbn as i64); RB[rcc]=32; rcc=rcc+1;
  rcc=e1i64(RB,rcc,ig(cfg,44) as i64);
  tr_emit(cfg,OUT,lgc,"BEAM",RB,rcc);
  return nbn;
}
// construct_beam: full beam search (wave-1/2 engine, kept for transfer=1
// and revise fallback). Returns accepted count in accn.
fn construct_beam(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,budget:i32,transfer:i32)i32 {
  cons_reset(cfg,pool,stab);
  put32(accn,0,0);
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  let tmp:[]u8=z_alloc(192);
  // seeds: 80 length-1 plus transfer seeds (up to 8 abstractions x 64
  // prefix lengths); 256 slots (1024 bytes) overflows in transfer mode.
  let seeds:[]u8=z_alloc(4096);
  let sn:i32=0;
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[0]=o as u8; tmp[1]=d as u8; tmp[2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,0,0,tmp,1);
        let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
        if(ig(cfg,20)==1){ break; }
        if(sc>=6){ acc_add(accb,accn,tmp,1); }
        put32(seeds,sn*4,ci); sn=sn+1;
        s=s+1;
      }
      if(ig(cfg,20)==1){ break; }
      d=d+1;
    }
    if(ig(cfg,20)==1){ break; }
    o=o+1;
  }
  // transfer seeds: inline chunks as standalone programs
  if(transfer==1 && ig(cfg,20)==0){
    let na:i32=ig(cfg,32);
    let a:i32=0;
    while(a<na){
      let ab:i32=a*208;
      let al:i32=ig(abst,ab+4);
      let pl:i32=al;
      while(pl>=1){
        let k:i32=0;
        while(k<pl*3){ tmp[k]=abst[ab+8+k]; k=k+1; }
        let ci:i32=mk_cand(cfg,pool,0,3,tmp,pl);
        let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
        if(ig(cfg,20)==1){ break; }
        if(sc>=6){ acc_add(accb,accn,tmp,pl); }
        put32(seeds,sn*4,ci); sn=sn+1;
        pl=pl-1;
      }
      if(ig(cfg,20)==1){ break; }
      a=a+1;
    }
  }
  let bn:i32=select_beam(pool,seeds,sn,80,beam,train,ig(cfg,24));
  let level:i32=2;
  while(level<=6 && ig(cfg,20)==0){
    bn=expand_level(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,bn,ch,transfer,level);
    if(bn==0){ break; }
    level=level+1;
  }
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,ig(accn,0) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(cfg,12) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(cfg,44) as i64);
  tr_emit(cfg,OUT,lgc,"CONSTRUCT-DONE",RB,rc);
  return ig(accn,0);
}
// mk_reps: behavioral equivalence classes over D_eq.
// reps block: 256 x 440: [0]=len,[4..200]=bytes,[200..436]=sig(59 i32)
fn mk_reps(accb:[]u8,accn:[]u8,reps:[]u8,repn:[]u8)void {
  put32(repn,0,0);
  let pts:[]u8=z_alloc(256);
  let npts:i32=deq_pts(pts);
  let sig:[]u8=z_alloc(256);
  let an:i32=ig(accn,0);
  let i:i32=0;
  while(i<an){
    let al:i32=ig(accb,i*200);
    prog_sig(accb[i*200+4..i*200+200],al,pts,npts,sig);
    // find class
    let rn:i32=ig(repn,0);
    let found:i32=-1;
    let r:i32=0;
    while(r<rn){
      let eq:i32=1;
      let k:i32=0;
      while(k<npts){ if(ig(reps,r*440+200+k*4)!=ig(sig,k*4)){ eq=0; break; } k=k+1; }
      if(eq==1){ found=r; break; }
      r=r+1;
    }
    if(found<0){
      if(rn<256){
        put32(reps,rn*440,al);
        let k2:i32=0;
        while(k2<al*3){ reps[rn*440+4+k2]=accb[i*200+4+k2]; k2=k2+1; }
        let k3:i32=0;
        while(k3<npts){ put32(reps,rn*440+200+k3*4,ig(sig,k3*4)); k3=k3+1; }
        put32(repn,0,rn+1);
      }
    }
    else {
      // representative: min (len, bytes)
      let rl:i32=ig(reps,found*440);
      let rep:i32=0;
      if(al<rl){ rep=1; }
      else { if(al==rl){
        let cc:i32=prog_cmp(accb[i*200+4..i*200+200],al*3,reps[found*440+4..found*440+200],rl*3);
        if(cc<0){ rep=1; }
      } }
      if(rep==1){
        put32(reps,found*440,al);
        let k4:i32=0;
        while(k4<al*3){ reps[found*440+4+k4]=accb[i*200+4+k4]; k4=k4+1; }
      }
    }
    i=i+1;
  }
  return;
}
// disambiguate: returns rep index or -1 (DEFER).
fn disambiguate(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,reps:[]u8,repn:[]u8,budget:i32) i32 {
  let rn:i32=ig(repn,0);
  let RB0:[]u8=z_alloc(32);
  let rc0:i32=0;
  rc0=e1i64(RB0,rc0,rn as i64);
  tr_emit(cfg,OUT,lgc,"CLASSES",RB0,rc0);
  if(rn==0){ return -1; }
  if(rn==1){ return 0; }
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  let surv:[]u8=z_alloc(1024);
  let sn:i32=rn;
  let i:i32=0;
  while(i<rn){ put32(surv,i*4,i); i=i+1; }
  let tn:i32=ig(cfg,24);
  let x:i32=-16;
  let done:i32=0;
  while(x<=16 && done==0){
    // skip training xs
    let is_tr:i32=0;
    let t2:i32=0;
    while(t2<tn){ if(ig(train,t2*4)==x){ is_tr=1; break; } t2=t2+1; }
    if(is_tr==0 && sn>1){
      // outputs of survivors
      let outs:[]u8=z_alloc(1024);
      let s2:i32=0;
      while(s2<sn){
        let ri:i32=ig(surv,s2*4);
        let rl:i32=ig(reps,ri*440);
        let v:i32=isa_exec(reps[ri*440+4..ri*440+200],rl,x);
        put32(outs,s2*4,v);
        s2=s2+1;
      }
      let same:i32=1;
      let s3:i32=1;
      while(s3<sn){ if(ig(outs,s3*4)!=ig(outs,0)){ same=0; break; } s3=s3+1; }
      if(same==0){
        let RB:[]u8=z_alloc(64);
        let rc:i32=0;
        rc=e1i64(RB,rc,x as i64); RB[rc]=32; rc=rc+1;
        rc=e1i64(RB,rc,sn as i64);
        tr_emit(cfg,OUT,lgc,"PROBE",RB,rc);
        let nsurv:[]u8=z_alloc(1024);
        let nsn:i32=0;
        let s4:i32=0;
        while(s4<sn){
          let ri2:i32=ig(surv,s4*4);
          let rl2:i32=ig(reps,ri2*440);
          let ov2:[]u8=z_alloc(8);
          let ok:i32=isa_run(reps[ri2*440+4..ri2*440+200],rl2,x,ov2);
          let r:i32=0;
          if(ok==1){ r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,ig(ov2,0),0,-1); }
          else { r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,0,1,-1); }
          if(r==-1){ done=1; break; }
          if(r==1){ put32(nsurv,nsn*4,ri2); nsn=nsn+1; }
          s4=s4+1;
        }
        sn=nsn;
        let s5:i32=0;
        while(s5<sn){ put32(surv,s5*4,ig(nsurv,s5*4)); s5=s5+1; }
        if(sn==1){ done=2; }
        if(sn==0){ done=3; }
      }
    }
    x=x+1;
  }
  if(done==2){ return ig(surv,0); }
  return -1;
}
// lm_cons3.zag -- CALR: Consequence-Anchored Lookahead Retention
// (L3-NIV2 wave 3). Replaces the beam for base construction
// (transfer=0); transfer=1 keeps construct_beam.
//
// Diagnosis (PREREG_WAVE3.md): the wave-2 beam fails because its retention
// criterion (training ACCEPT count of the prefix as a complete program,
// plus id tie-breaks) is blind to latent register state. The crucial
// prefix [CPY r1,r0][MUL r0,r0] scores 1/6 (r0=x^2) like 2108 others, but
// its value is the latent state (r1=x preserved), visible only after
// extension. CALR keeps ALL depth-2 prefixes (no pruning), orders them by
// 1-step lookahead potential against the consequence-derived partial
// target map fhat, and verifies lazily through the consequence channel.
//
// fhat lives in cfg: cfg+256 values (16 i32, train-indexed), cfg+320
// known flags, cfg+384 enable. It is derived ONLY from the learner's own
// TEST/ACCEPT history. No expected value crosses the channel.

// isa_regs: full 4-register simulation of prog[0..n) on x.
// regs must hold 4 i32s. Same semantics as isa_exec.
fn isa_regs(prog:[]u8,n:i32,x:i32,regs:[]u8)void {
  put32(regs,0,x); put32(regs,4,0); put32(regs,8,0); put32(regs,12,0);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let bad:i32=0;
    if(op<0 || op>4){ bad=1; }
    if(d<0 || d>3){ bad=1; }
    if(s<0 || s>3){ bad=1; }
    if(bad==0){
      let rs:i32=ig(regs,s*4);
      let dv:i32=ig(regs,d*4);
      let nv:i32=dv;
      if(op==0){ nv=rs; }
      if(op==1){ nv=dv+rs; }
      if(op==2){ nv=dv*rs; }
      if(op==3){ nv=1; }
      if(op==4){ nv=dv+1; }
      put32(regs,d*4,nv);
    }
    k=k+1;
  }
  return;
}
// ext_agree: agreement count between the outputs of P+(o,d,s) and fhat,
// over known training inputs. st holds tn register-states (16 bytes
// each) of the prefix P. Pure local simulation, zero TEST cost.
fn ext_agree(cfg:[]u8,tn:i32,st:[]u8,o:i32,d:i32,s:i32)i32 {
  let m:i32=0;
  let j:i32=0;
  while(j<tn){
    if(ig(cfg,320+j*4)==1){
      let r0n:i32=ig(st,j*16);
      if(d==0){
        let rd:i32=ig(st,j*16);
        let rs:i32=ig(st,j*16+s*4);
        let nv:i32=rd+1;
        if(o==0){ nv=rs; }
        if(o==1){ nv=rd+rs; }
        if(o==2){ nv=rd*rs; }
        if(o==3){ nv=1; }
        r0n=nv;
      }
      if(r0n==ig(cfg,256+j*4)){ m=m+1; }
    }
    j=j+1;
  }
  return m;
}
// best_ext_agree: max agreement over the 80 appends (flat e=0..79).
fn best_ext_agree(cfg:[]u8,tn:i32,st:[]u8)i32 {
  let best:i32=0;
  let e:i32=0;
  while(e<80){
    let m:i32=ext_agree(cfg,tn,st,e/16,(e/4)-(e/16)*4,e-(e/4)*4);
    if(m>best){ best=m; }
    e=e+1;
  }
  return best;
}
// argmax_exts: collect append codes e achieving max agreement, in byte
// order. Returns count; out must hold 80 u32s.
fn argmax_exts(cfg:[]u8,tn:i32,st:[]u8,out:[]u8)i32 {
  let best:i32=best_ext_agree(cfg,tn,st);
  let n:i32=0;
  let e:i32=0;
  while(e<80){
    let m:i32=ext_agree(cfg,tn,st,e/16,(e/4)-(e/16)*4,e-(e/4)*4);
    if(m==best){ put32(out,n*4,e); n=n+1; }
    e=e+1;
  }
  return n;
}
// pot_better: 1 if (p2,s2,id2) ranks strictly above (tpot,tsc,tid) under
// (potential desc, score desc, id asc).
fn pot_better(p2:i32,s2:i32,id2:i32,tpot:i32,tsc:i32,tid:i32)i32 {
  if(p2>tpot){ return 1; }
  if(p2<tpot){ return 0; }
  if(s2>tsc){ return 1; }
  if(s2<tsc){ return 0; }
  if(id2<tid){ return 1; }
  return 0;
}
// score_better: 1 if (s2,id2) ranks strictly above (tsc,tid) under
// (score desc, id asc).
fn score_better(s2:i32,id2:i32,tsc:i32,tid:i32)i32 {
  if(s2>tsc){ return 1; }
  if(s2<tsc){ return 0; }
  if(id2<tid){ return 1; }
  return 0;
}
// bytes6_is_target: 1 if pool[b+16..b+22) == 00 01 00 02 00 00
// ([CPY r1,r0][MUL r0,r0], the wave-2 crucial prefix).
fn bytes6_is_target(pool:[]u8,b:i32)i32 {
  if(pool[b+16]!=0){ return 0; }
  if(pool[b+17]!=1){ return 0; }
  if(pool[b+18]!=0){ return 0; }
  if(pool[b+19]!=2){ return 0; }
  if(pool[b+20]!=0){ return 0; }
  if(pool[b+21]!=0){ return 0; }
  return 1;
}
// calr_target_ranks: find the wave-2 crucial prefix in plist by bytes;
// compute its SR (score rank) and PR (potential rank) over plist.
// tid_out/sr_out/pr_out receive id/SR/PR, or -1 if absent.
fn calr_target_ranks(pool:[]u8,plist:[]u8,pn:i32,pot:[]u8,sr_out:[]u8,pr_out:[]u8,tid_out:[]u8)void {
  put32(tid_out,0,-1); put32(sr_out,0,-1); put32(pr_out,0,-1);
  let tpi:i32=-1;
  let tq:i32=-1;
  let q:i32=0;
  while(q<pn){
    let pi:i32=ig(plist,q*4);
    let b:i32=pool_base(pi);
    if(ig(pool,b+12)==2){
      if(bytes6_is_target(pool,b)==1){ tpi=pi; tq=q; }
    }
    q=q+1;
  }
  if(tpi<0){ return; }
  let tid:i32=cand_id(pool,tpi);
  let tpot:i32=ig(pot,tq*4);
  let tsc:i32=cand_score(pool,tpi);
  put32(tid_out,0,tid);
  let sr:i32=1;
  let pr:i32=1;
  let q2:i32=0;
  while(q2<pn){
    let pi2:i32=ig(plist,q2*4);
    let id2:i32=cand_id(pool,pi2);
    if(id2!=tid){
      let s2:i32=cand_score(pool,pi2);
      let p2:i32=ig(pot,q2*4);
      if(score_better(s2,id2,tsc,tid)==1){ sr=sr+1; }
      if(pot_better(p2,s2,id2,tpot,tsc,tid)==1){ pr=pr+1; }
    }
    q2=q2+1;
  }
  put32(sr_out,0,sr);
  put32(pr_out,0,pr);
  return;
}
// calr_potential: Phase B. For each depth-2 prefix in plist, simulate the
// full register state on each training input (local, zero TESTs) and set
// pot[q] = max over 80 appends of fhat agreement. Returns max potential.
fn calr_potential(cfg:[]u8,train:[]u8,pool:[]u8,plist:[]u8,pn:i32,pot:[]u8)i32 {
  let tn:i32=ig(cfg,24);
  let pmax:i32=0;
  let regs:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(256);
  let q:i32=0;
  while(q<pn){
    let pi:i32=ig(plist,q*4);
    let b:i32=pool_base(pi);
    let n:i32=ig(pool,b+12);
    let j:i32=0;
    while(j<tn){
      isa_regs(pool[b+16..b+208],n,ig(train,j*4),regs);
      put32(st,j*16,ig(regs,0));
      put32(st,j*16+4,ig(regs,4));
      put32(st,j*16+8,ig(regs,8));
      put32(st,j*16+12,ig(regs,12));
      j=j+1;
    }
    let best:i32=best_ext_agree(cfg,tn,st);
    put32(pot,q*4,best);
    if(best>pmax){ pmax=best; }
    q=q+1;
  }
  return pmax;
}
// construct_calr: three-stage construction (wave 3).
// Phase A: harvest, evaluate all 80 seeds + 6400 appends via the
//   consequence channel; fhat accumulates from ACCEPTs. No pruning.
// Phase B: local 1-step lookahead potential for all 6400 prefixes.
// Phase C: verify prefixes in (potential, score, id) order through the
//   consequence channel; stop at first full acceptance.
// Returns accepted count in accn.
fn construct_calr(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,budget:i32)i32 {
  cons_reset(cfg,pool,stab);
  put32(accn,0,0);
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  fharv_reset(cfg);
  let tn:i32=ig(cfg,24);
  let tmp:[]u8=z_alloc(192);
  let plist:[]u8=z_alloc(262144);
  let pn:i32=0;
  // Phase A1: 80 length-1 seeds.
  let seeds:[]u8=z_alloc(320);
  let sn:i32=0;
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[0]=o as u8; tmp[1]=d as u8; tmp[2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,0,0,tmp,1);
        if(ci>=0){
          let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
          if(sc>=6){ acc_add(accb,accn,tmp,1); }
          put32(seeds,sn*4,ci); sn=sn+1;
        }
        if(ig(cfg,20)==1){ break; }
        s=s+1;
      }
      if(ig(cfg,20)==1){ break; }
      d=d+1;
    }
    if(ig(cfg,20)==1){ break; }
    o=o+1;
  }
  // Phase A2: all 80 appends of each seed (6400 length-2 prefixes).
  let si:i32=0;
  while(si<sn){
    if(ig(cfg,20)==1){ break; }
    let p:i32=ig(seeds,si*4);
    let pb:i32=pool_base(p);
    let k:i32=0;
    while(k<3){ tmp[k]=pool[pb+16+k]; k=k+1; }
    let e:i32=0;
    while(e<80){
      let o2:i32=e/16;
      let d2:i32=(e/4)-(e/16)*4;
      let s2:i32=e-(e/4)*4;
      tmp[3]=o2 as u8; tmp[4]=d2 as u8; tmp[5]=s2 as u8;
      let cj:i32=mk_cand(cfg,pool,cand_id(pool,p),1,tmp,2);
      if(cj>=0){
        let sc2:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,cj);
        if(sc2>=6){
          let b2:i32=pool_base(cj);
          acc_add(accb,accn,pool[b2+16..b2+208],2);
        }
        put32(plist,pn*4,cj); pn=pn+1;
      }
      if(ig(cfg,20)==1){ break; }
      e=e+1;
    }
    si=si+1;
  }
  // Harvest summary.
  let nk:i32=0;
  let ii:i32=0;
  while(ii<tn){ if(ig(cfg,320+ii*4)==1){ nk=nk+1; } ii=ii+1; }
  let HB:[]u8=z_alloc(64);
  let hc:i32=0;
  hc=e1i64(HB,hc,nk as i64); HB[hc]=32; hc=hc+1;
  hc=e1i64(HB,hc,pn as i64); HB[hc]=32; hc=hc+1;
  hc=e1i64(HB,hc,ig(cfg,12) as i64);
  tr_emit(cfg,OUT,lgc,"CALR-HARVEST",HB,hc);
  if(ig(accn,0)>0 || ig(cfg,20)==1){
    fharv_off(cfg);
    let D0:[]u8=z_alloc(64);
    let dc0:i32=0;
    dc0=e1i64(D0,dc0,ig(accn,0) as i64); D0[dc0]=32; dc0=dc0+1;
    dc0=e1i64(D0,dc0,0); D0[dc0]=32; dc0=dc0+1;
    dc0=e1i64(D0,dc0,ig(cfg,12) as i64);
    tr_emit(cfg,OUT,lgc,"CALR-DONE",D0,dc0);
    return ig(accn,0);
  }
  // Phase B: potentials (local, zero TESTs).
  let pot:[]u8=z_alloc(pn*4+4);
  let pmax:i32=calr_potential(cfg,train,pool,plist,pn,pot);
  // Diagnosis trace: SR/PR for the wave-2 crucial prefix.
  let sr_out:[]u8=z_alloc(8);
  let pr_out:[]u8=z_alloc(8);
  let tid_out:[]u8=z_alloc(8);
  calr_target_ranks(pool,plist,pn,pot,sr_out,pr_out,tid_out);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,ig(tid_out,0) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(pr_out,0) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(sr_out,0) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,pmax as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,nk as i64);
  tr_emit(cfg,OUT,lgc,"CALR-RANK",RB,rc);
  // Phase C: verification order (potential desc, score desc, id asc),
  // built by bucket loops (no sort).
  let order:[]u8=z_alloc(pn*4+4);
  let on:i32=0;
  let pv:i32=6;
  while(pv>=0){
    let sv:i32=6;
    while(sv>=0){
      let qq:i32=0;
      while(qq<pn){
        if(ig(pot,qq*4)==pv){
          let piq:i32=ig(plist,qq*4);
          if(cand_score(pool,piq)==sv){
            put32(order,on*4,piq);
            on=on+1;
          }
        }
        qq=qq+1;
      }
      sv=sv-1;
    }
    pv=pv-1;
  }
  let found:i32=0;
  let nver:i32=0;
  let oi:i32=0;
  while(oi<on){
    if(found==1 || ig(cfg,20)==1){ break; }
    let pi:i32=ig(order,oi*4);
    let b:i32=pool_base(pi);
    let n:i32=ig(pool,b+12);
    let st2:[]u8=z_alloc(256);
    let regs2:[]u8=z_alloc(16);
    let j2:i32=0;
    while(j2<tn){
      isa_regs(pool[b+16..b+208],n,ig(train,j2*4),regs2);
      put32(st2,j2*16,ig(regs2,0));
      put32(st2,j2*16+4,ig(regs2,4));
      put32(st2,j2*16+8,ig(regs2,8));
      put32(st2,j2*16+12,ig(regs2,12));
      j2=j2+1;
    }
    let exts:[]u8=z_alloc(320);
    let en:i32=argmax_exts(cfg,tn,st2,exts);
    nver=nver+1;
    let ei:i32=0;
    while(ei<en){
      if(found==1 || ig(cfg,20)==1){ break; }
      let ex:i32=ig(exts,ei*4);
      let o3:i32=ex/16;
      let d3:i32=(ex/4)-(ex/16)*4;
      let s3:i32=ex-(ex/4)*4;
      let kk:i32=0;
      while(kk<n*3){ tmp[kk]=pool[b+16+kk]; kk=kk+1; }
      tmp[n*3]=o3 as u8; tmp[n*3+1]=d3 as u8; tmp[n*3+2]=s3 as u8;
      let ck:i32=mk_cand(cfg,pool,cand_id(pool,pi),1,tmp,n+1);
      if(ck>=0){
        let sc3:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ck);
        if(sc3>=6){
          let b3:i32=pool_base(ck);
          acc_add(accb,accn,pool[b3+16..b3+208],n+1);
          found=1;
          let FB:[]u8=z_alloc(64);
          let fc:i32=0;
          fc=e1i64(FB,fc,cand_id(pool,ck) as i64); FB[fc]=32; fc=fc+1;
          fc=e1i64(FB,fc,cand_id(pool,pi) as i64); FB[fc]=32; fc=fc+1;
          fc=e1i64(FB,fc,nver as i64);
          tr_emit(cfg,OUT,lgc,"CALR-FOUND",FB,fc);
        }
      }
      ei=ei+1;
    }
    oi=oi+1;
  }
  fharv_off(cfg);
  let DB:[]u8=z_alloc(64);
  let dc:i32=0;
  dc=e1i64(DB,dc,ig(accn,0) as i64); DB[dc]=32; dc=dc+1;
  dc=e1i64(DB,dc,nver as i64); DB[dc]=32; dc=dc+1;
  dc=e1i64(DB,dc,ig(cfg,12) as i64);
  tr_emit(cfg,OUT,lgc,"CALR-DONE",DB,dc);
  return ig(accn,0);
}
// construct: dispatcher. Base construction (transfer=0) uses CALR;
// transfer re-derivation (transfer=1) keeps the wave-2 beam engine.
fn construct(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,budget:i32,transfer:i32)i32 {
  if(transfer==1){
    return construct_beam(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,budget,transfer);
  }
  return construct_calr(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,budget);
}
// lm_arms.zag -- arm drivers and main (L3-NIV2 learner).

// claim_train: CLAIM_TRAIN <hex>; parses TALLY reply; returns accepts.
fn claim_train(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,prog:[]u8,n:i32,vd:[]u8)i32 {
  let LB:[]u8=z_alloc(512);
  let c:i32=0;
  c=e1str(LB,c,"CLAIM_TRAIN ");
  c=e1hex(LB,c,prog,n);
  psend(cfg,OUT,lgc,PL,LB,c);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll<0){ return -1; }
  let t1:i32=gettok(line,ll,1,tok);
  let p1:i32=p_int(tok,0,t1,ov); let a:i32=ig(ov,0);
  let t3:i32=gettok(line,ll,3,tok);
  let k:i32=0;
  while(k<t3){ vd[k]=tok[k]; k=k+1; }
  vd[t3]=0;
  let RB:[]u8=z_alloc(128);
  let rc:i32=0;
  rc=e1i64(RB,rc,a as i64); RB[rc]=32; rc=rc+1;
  rc=e1str(RB,rc,vd[0..t3]);
  tr_emit(cfg,OUT,lgc,"CLAIM_TRAIN",RB,rc);
  return a;
}
// greedy_c2: exact C281 m_construct promotion structure
// (80 appends/round, strictly positive gain, first-max tie-break),
// scoring by training ACCEPT count through the consequence channel.
// out_prog/out_n receive the final program. Returns final score.
fn greedy_c2(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,out_prog:[]u8,out_n:[]u8,budget:i32)i32 {
  cons_reset(cfg,pool,stab);
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  let cur:[]u8=z_alloc(192);
  let cn:i32=0;
  let c0:i32=mk_cand(cfg,pool,0,5,cur,0);
  let bs:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,c0);
  let cur_id:i32=cand_id(pool,c0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=6){ go=0; }
    else {
      if(ig(cfg,20)==1){ go=0; break; }
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1; let bd:i32=0; let bss:i32=0;
      let tmp:[]u8=z_alloc(192);
      let o:i32=0;
      while(o<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let k:i32=0;
            while(k<cn*3){ tmp[k]=cur[k]; k=k+1; }
            tmp[cn*3]=o as u8; tmp[cn*3+1]=d as u8; tmp[cn*3+2]=s as u8;
            let ci:i32=mk_cand(cfg,pool,cur_id,5,tmp,cn+1);
            let cs:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
            if(ig(cfg,20)==1){ break; }
            let gain:i32=cs-bs;
            if(gain>bg){ bg=gain; bop=o; bd=d; bss=s; }
            s=s+1;
          }
          if(ig(cfg,20)==1){ break; }
          d=d+1;
        }
        if(ig(cfg,20)==1){ break; }
        o=o+1;
      }
      let RB:[]u8=z_alloc(64);
      let rc:i32=0;
      rc=e1i64(RB,rc,round as i64); RB[rc]=32; rc=rc+1;
      rc=e1i64(RB,rc,bs as i64); RB[rc]=32; rc=rc+1;
      rc=e1i64(RB,rc,bg as i64);
      tr_emit(cfg,OUT,lgc,"C-ROUND",RB,rc);
      if(bg>0 && ig(cfg,20)==0){
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        let c2:i32=mk_cand(cfg,pool,cur_id,5,cur,cn);
        bs=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,c2);
        cur_id=cand_id(pool,c2);
        if(bs>=6){ go=0; }
      }
      else { go=0; }
    }
  }
  let k2:i32=0;
  while(k2<cn*3){ out_prog[k2]=cur[k2]; k2=k2+1; }
  put32(out_n,0,cn);
  return bs;
}
// enum_c4: exhaustive length<=2 enumeration. Returns best score.
fn enum_c4(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,out_prog:[]u8,out_n:[]u8,budget:i32)i32 {
  cons_reset(cfg,pool,stab);
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  let tmp:[]u8=z_alloc(192);
  let best:i32=-1;
  let bestn:i32=0;
  let bestb:[]u8=z_alloc(192);
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[0]=o as u8; tmp[1]=d as u8; tmp[2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,0,6,tmp,1);
        let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
        if(ig(cfg,20)==1){ break; }
        if(sc>best){ best=sc; bestn=1; bestb[0]=o as u8; bestb[1]=d as u8; bestb[2]=s as u8; }
        // length-2 extensions
        let o2:i32=0;
        while(o2<5){
          let d2:i32=0;
          while(d2<4){
            let s2:i32=0;
            while(s2<4){
              tmp[3]=o2 as u8; tmp[4]=d2 as u8; tmp[5]=s2 as u8;
              let cj:i32=mk_cand(cfg,pool,cand_id(pool,ci),6,tmp,2);
              let sc2:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,cj);
              if(ig(cfg,20)==1){ break; }
              if(sc2>best){
                best=sc2; bestn=2;
                bestb[0]=o as u8; bestb[1]=d as u8; bestb[2]=s as u8;
                bestb[3]=o2 as u8; bestb[4]=d2 as u8; bestb[5]=s2 as u8;
              }
              s2=s2+1;
            }
            if(ig(cfg,20)==1){ break; }
            d2=d2+1;
          }
          if(ig(cfg,20)==1){ break; }
          o2=o2+1;
        }
        if(ig(cfg,20)==1){ break; }
        s=s+1;
      }
      if(ig(cfg,20)==1){ break; }
      d=d+1;
    }
    if(ig(cfg,20)==1){ break; }
    o=o+1;
  }
  let k:i32=0;
  while(k<bestn*3){ out_prog[k]=bestb[k]; k=k+1; }
  put32(out_n,0,bestn);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,best as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(cfg,12) as i64);
  tr_emit(cfg,OUT,lgc,"ENUM-DONE",RB,rc);
  return best;
}
// lcs_len: longest common subsequence over instruction triples.
fn lcs_len(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  let dp:[]u8=z_alloc(65*65*4);
  let i:i32=0;
  while(i<=an){
    let j:i32=0;
    while(j<=bn){
      if(i==0 || j==0){ put32(dp,(i*65+j)*4,0); }
      else {
        let eq:i32=1;
        let k:i32=0;
        while(k<3){ if(a[(i-1)*3+k]!=b[(j-1)*3+k]){ eq=0; break; } k=k+1; }
        if(eq==1){ put32(dp,(i*65+j)*4,ig(dp,((i-1)*65+j-1)*4)+1); }
        else {
          let x:i32=ig(dp,((i-1)*65+j)*4);
          let y:i32=ig(dp,(i*65+j-1)*4);
          if(x>y){ put32(dp,(i*65+j)*4,x); } else { put32(dp,(i*65+j)*4,y); }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  return ig(dp,(an*65+bn)*4);
}
// contains_chunk: 1 iff chunk[0..cl) appears contiguously in prog.
fn contains_chunk(prog:[]u8,n:i32,chunk:[]u8,cl:i32)i32 {
  if(cl>n || cl<1){ return 0; }
  let i:i32=0;
  while(i<=n-cl){
    let eq:i32=1;
    let k:i32=0;
    while(k<cl*3){ if(prog[i*3+k]!=chunk[k]){ eq=0; break; } k=k+1; }
    if(eq==1){ return 1; }
    i=i+1;
  }
  return 0;
}
// define_abst: persist named abstraction A<k>.
fn define_abst(cfg:[]u8,OUT:[]u8,lgc:[]u8,abst:[]u8,prog:[]u8,n:i32)void {
  let na:i32=ig(cfg,32);
  if(na>=8){ return; }
  let ab:i32=na*208;
  put32(abst,ab,1);
  put32(abst,ab+4,n);
  let k:i32=0;
  while(k<n*3){ abst[ab+8+k]=prog[k]; k=k+1; }
  put32(cfg,32,na+1);
  let RB:[]u8=z_alloc(512);
  let rc:i32=0;
  rc=e1i64(RB,rc,(na+1) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,n as i64); RB[rc]=32; rc=rc+1;
  rc=e1hex(RB,rc,prog,n*3);
  tr_emit(cfg,OUT,lgc,"DEFINE",RB,rc);
  return;
}
// revise: T3 edit-based revision from M. Returns accepted count.
fn revise(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,mprog:[]u8,mlen:i32,budget:i32)i32 {
  cons_reset(cfg,pool,stab);
  put32(accn,0,0);
  put32(cfg,16,budget); put32(cfg,12,0); put32(cfg,20,0);
  let RB0:[]u8=z_alloc(64);
  let rc0:i32=0;
  rc0=e1i64(RB0,rc0,ig(cfg,248) as i64);
  tr_emit(cfg,OUT,lgc,"REVISE-BEGIN",RB0,rc0);
  let tmp:[]u8=z_alloc(192);
  let mid:i32=mk_cand(cfg,pool,0,4,mprog,mlen);
  let msc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,mid);
  if(msc>=6){ acc_add(accb,accn,mprog,mlen); }
  let mid_id:i32=cand_id(pool,mid);
  // APPEND edits
  let o:i32=0;
  let stop:i32=0;
  while(o<5 && stop==0){
    let d:i32=0;
    while(d<4 && stop==0){
      let s:i32=0;
      while(s<4 && stop==0){
        if(mlen<64){
          let k:i32=0;
          while(k<mlen*3){ tmp[k]=mprog[k]; k=k+1; }
          tmp[mlen*3]=o as u8; tmp[mlen*3+1]=d as u8; tmp[mlen*3+2]=s as u8;
          let ci:i32=mk_cand(cfg,pool,mid_id,4,tmp,mlen+1);
          let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
          if(ig(cfg,20)==1){ stop=1; break; }
          if(sc>=6){ let b2:i32=pool_base(ci); acc_add(accb,accn,pool[b2+16..b2+208],mlen+1); }
        }
        s=s+1;
      }
      d=d+1;
    }
    o=o+1;
  }
  // TRUNCATE edits
  let t:i32=1;
  while(t<=2 && stop==0){
    if(mlen>t){
      let ci:i32=mk_cand(cfg,pool,mid_id,4,mprog,mlen-t);
      let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
      if(ig(cfg,20)==1){ stop=1; break; }
      if(sc>=6){ acc_add(accb,accn,mprog,mlen-t); }
    }
    t=t+1;
  }
  // SUBSTITUTE edits at each position
  let pos:i32=0;
  while(pos<mlen && stop==0){
    let o2:i32=0;
    while(o2<5 && stop==0){
      let d2:i32=0;
      while(d2<4 && stop==0){
        let s2:i32=0;
        while(s2<4 && stop==0){
          let k2:i32=0;
          while(k2<mlen*3){ tmp[k2]=mprog[k2]; k2=k2+1; }
          tmp[pos*3]=o2 as u8; tmp[pos*3+1]=d2 as u8; tmp[pos*3+2]=s2 as u8;
          let ci:i32=mk_cand(cfg,pool,mid_id,4,tmp,mlen);
          let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
          if(ig(cfg,20)==1){ stop=1; break; }
          if(sc>=6){ let b2:i32=pool_base(ci); acc_add(accb,accn,pool[b2+16..b2+208],mlen); }
          s2=s2+1;
        }
        d2=d2+1;
      }
      o2=o2+1;
    }
    pos=pos+1;
  }
  // if no full acceptance, beam-expand from top edit neighbors
  if(ig(accn,0)==0 && stop==0){
    // seed beam with diverse top of pool by comparator
    // eb holds one u32 per pool candidate; pn can reach POOL_N=20000,
    // so 2048 slots (8192 bytes) overflows.
    let eb:[]u8=z_alloc(81920);
    let ebn:i32=0;
    let pn:i32=ig(cfg,36);
    let pi:i32=0;
    while(pi<pn){
      if(cand_score(pool,pi)>=0){ put32(eb,ebn*4,pi); ebn=ebn+1; }
      pi=pi+1;
    }
    let bn:i32=select_beam(pool,eb,ebn,80,beam,train,ig(cfg,24));
    let level:i32=mlen+1;
    while(level<=6 && stop==0){
      bn=expand_level(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,bn,ch,1,level);
      if(bn==0){ break; }
      if(ig(cfg,20)==1){ stop=1; }
      level=level+1;
    }
  }
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,ig(accn,0) as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,ig(cfg,12) as i64);
  tr_emit(cfg,OUT,lgc,"REVISE-DONE",RB,rc);
  return ig(accn,0);
}
// lm_main.zag -- arm dispatch and main (L3-NIV2 learner).

fn m_save(cfg:[]u8,prog:[]u8,n:i32,lin:i32,slot:i32)void {
  put32(cfg,52,n);
  let k:i32=0;
  while(k<n*3){ cfg[56+k]=prog[k]; k=k+1; }
  put32(cfg,248,lin);
  put32(cfg,252,slot);
  return;
}
fn m_len(cfg:[]u8)i32 { return ig(cfg,52); }
fn m_lin(cfg:[]u8)i32 { return ig(cfg,248); }
// copy M bytes into out (192 max); returns len.
fn m_bytes(cfg:[]u8,out:[]u8)i32 {
  let n:i32=ig(cfg,52);
  let k:i32=0;
  while(k<n*3){ out[k]=cfg[56+k]; k=k+1; }
  return n;
}
fn arm_begin(cfg:[]u8)void {
  put32(cfg,12,0); put32(cfg,20,0); put32(cfg,16,1000000);
  return;
}
fn arm_end_log(cfg:[]u8,OUT:[]u8,lgc:[]u8,label:[]u8,vd:[]u8)void {
  let RB:[]u8=z_alloc(128);
  let c:i32=0;
  c=e1str(RB,c,label); RB[c]=32; c=c+1;
  c=e1str(RB,c,vd); RB[c]=32; c=c+1;
  c=e1i64(RB,c,ig(cfg,12) as i64);
  tr_emit(cfg,OUT,lgc,"ARM-END",RB,c);
  return;
}
// send_defer: DEFER <arm>; returns verdict into vd.
fn send_defer(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,arm:[]u8,vd:[]u8)void {
  let LB:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(LB,c,"DEFER ");
  c=e1str(LB,c,arm);
  psend(cfg,OUT,lgc,PL,LB,c);
  tr_emit(cfg,OUT,lgc,"DEFER",arm,arm.len);
  let ll:i32=precv(cfg,R,OUT,lgc,line);
  if(ll>=0){
    let t3:i32=gettok(line,ll,3,tok);
    let k:i32=0;
    while(k<t3){ vd[k]=tok[k]; k=k+1; }
    vd[t3]=0;
  }
  return;
}
// rep_prog: copy reps[ri] program bytes into out; returns len.
fn rep_prog(reps:[]u8,ri:i32,out:[]u8)i32 {
  let n:i32=ig(reps,ri*440);
  let k:i32=0;
  while(k<n*3){ out[k]=reps[ri*440+4+k]; k=k+1; }
  return n;
}

fn arm_t1(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,reps:[]u8,repn:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"T1");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="FAIL"; let k:i32=0; while(k<4){vd[k]=e[k]; k=k+1;} vd[4]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"T1",vd); return; }
  let nacc:i32=construct(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,50000,0);
  mk_reps(accb,accn,reps,repn);
  let ri:i32=disambiguate(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,reps,repn,200);
  if(ri<0){ send_defer(cfg,R,OUT,lgc,PL,line,tok,"T1",vd); arm_end_log(cfg,OUT,lgc,"T1",vd); return; }
  let rp:[]u8=z_alloc(192);
  let rn:i32=rep_prog(reps,ri,rp);
  let lin:i32=ig(cfg,28);
  put32(cfg,28,lin+1);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,0,lin,0,rp,rn*3);
  m_save(cfg,rp,rn,lin,0);
  define_abst(cfg,OUT,lgc,abst,rp,rn);
  let vd2:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,0,vd2);
  arm_end_log(cfg,OUT,lgc,"T1",vd2);
  return;
}

fn arm_t2(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"T2");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="FAIL"; let k:i32=0; while(k<4){vd[k]=e[k]; k=k+1;} vd[4]=0;
  if(observe_extra(cfg,R,OUT,lgc,PL,line,tok,ov,train,6)<0){ arm_end_log(cfg,OUT,lgc,"T2",vd); return; }
  let mp:[]u8=z_alloc(192);
  let mn:i32=m_bytes(cfg,mp);
  let tn:i32=ig(cfg,24);
  let i:i32=0;
  while(i<tn){
    let x:i32=ig(train,i*4);
    let ov2:[]u8=z_alloc(8);
    let ok:i32=isa_run(mp,mn,x,ov2);
    if(ok==1){ do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,ig(ov2,0),0,-2); }
    else { do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,0,1,-2); }
    if(ig(cfg,20)==1){ break; }
    i=i+1;
  }
  let vd2:[]u8=z_alloc(32);
  do_tally(cfg,R,OUT,lgc,PL,line,tok,ov,vd2);
  arm_end_log(cfg,OUT,lgc,"T2",vd2);
  return;
}

fn arm_t3(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,reps:[]u8,repn:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"T3");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="FAIL"; let k:i32=0; while(k<4){vd[k]=e[k]; k=k+1;} vd[4]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"T3",vd); return; }
  let mp:[]u8=z_alloc(192);
  let mn:i32=m_bytes(cfg,mp);
  let oldlin:i32=m_lin(cfg);
  // consequence-stream change detection: TEST M on fresh instances
  let tn:i32=ig(cfg,24);
  let full:i32=1;
  let i:i32=0;
  while(i<tn){
    let x:i32=ig(train,i*4);
    let ov2:[]u8=z_alloc(8);
    let ok:i32=isa_run(mp,mn,x,ov2);
    let r:i32=0;
    if(ok==1){ r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,ig(ov2,0),0,-3); }
    else { r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,0,1,-3); }
    if(r!=1){ full=0; }
    if(ig(cfg,20)==1){ break; }
    i=i+1;
  }
  if(full==1){
    // no change detected: reuse stands
    let vd2:[]u8=z_alloc(32);
    do_tally(cfg,R,OUT,lgc,PL,line,tok,ov,vd2);
    arm_end_log(cfg,OUT,lgc,"T3",vd2);
    return;
  }
  let nacc:i32=revise(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,mp,mn,20000);
  mk_reps(accb,accn,reps,repn);
  let ri:i32=disambiguate(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,reps,repn,200);
  if(ri<0){ send_defer(cfg,R,OUT,lgc,PL,line,tok,"T3",vd); arm_end_log(cfg,OUT,lgc,"T3",vd); return; }
  let rp:[]u8=z_alloc(192);
  let rn:i32=rep_prog(reps,ri,rp);
  let lin:i32=ig(cfg,28);
  put32(cfg,28,lin+1);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,1,lin,oldlin,rp,rn*3);
  m_save(cfg,rp,rn,lin,1);
  define_abst(cfg,OUT,lgc,abst,rp,rn);
  // lineage evidence: LCS vs old M; abstraction reuse vs A1
  let lcs:i32=lcs_len(mp,mn,rp,rn);
  let a1b:[]u8=z_alloc(192);
  let a1n:i32=0;
  if(ig(cfg,32)>=1){ a1n=ig(abst,4); let kk:i32=0; while(kk<a1n*3){ a1b[kk]=abst[8+kk]; kk=kk+1; } }
  let abru:i32=contains_chunk(rp,rn,a1b,a1n);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,lcs as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,mn as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,rn as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,abru as i64);
  tr_emit(cfg,OUT,lgc,"LINEAGE",RB,rc);
  let vd2:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,1,vd2);
  arm_end_log(cfg,OUT,lgc,"T3",vd2);
  return;
}

fn arm_t4(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,reps:[]u8,repn:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"T4");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="FAIL"; let k:i32=0; while(k<4){vd[k]=e[k]; k=k+1;} vd[4]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"T4",vd); return; }
  let mp:[]u8=z_alloc(192);
  let mn:i32=m_bytes(cfg,mp);
  let oldlin:i32=m_lin(cfg);
  let tn:i32=ig(cfg,24);
  let full:i32=1;
  let i:i32=0;
  while(i<tn){
    let x:i32=ig(train,i*4);
    let ov2:[]u8=z_alloc(8);
    let ok:i32=isa_run(mp,mn,x,ov2);
    let r:i32=0;
    if(ok==1){ r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,ig(ov2,0),0,-4); }
    else { r=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,0,1,-4); }
    if(r!=1){ full=0; }
    if(ig(cfg,20)==1){ break; }
    i=i+1;
  }
  if(full==1){
    let vd2:[]u8=z_alloc(32);
    do_tally(cfg,R,OUT,lgc,PL,line,tok,ov,vd2);
    arm_end_log(cfg,OUT,lgc,"T4",vd2);
    return;
  }
  let nacc:i32=construct(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,30000,1);
  mk_reps(accb,accn,reps,repn);
  let ri:i32=disambiguate(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,reps,repn,200);
  if(ri<0){ send_defer(cfg,R,OUT,lgc,PL,line,tok,"T4",vd); arm_end_log(cfg,OUT,lgc,"T4",vd); return; }
  let rp:[]u8=z_alloc(192);
  let rn:i32=rep_prog(reps,ri,rp);
  let lin:i32=ig(cfg,28);
  put32(cfg,28,lin+1);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,2,lin,oldlin,rp,rn*3);
  m_save(cfg,rp,rn,lin,2);
  define_abst(cfg,OUT,lgc,abst,rp,rn);
  // KC0D evidence: S1-defined abstraction (A1) chunk inside the solution
  let a1b:[]u8=z_alloc(192);
  let a1n:i32=0;
  if(ig(cfg,32)>=1){ a1n=ig(abst,4); let kk:i32=0; while(kk<a1n*3){ a1b[kk]=abst[8+kk]; kk=kk+1; } }
  let abru:i32=contains_chunk(rp,rn,a1b,a1n);
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,abru as i64); RB[rc]=32; rc=rc+1;
  rc=e1i64(RB,rc,a1n as i64);
  tr_emit(cfg,OUT,lgc,"ABST-REUSE",RB,rc);
  let vd2:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,2,vd2);
  arm_end_log(cfg,OUT,lgc,"T4",vd2);
  return;
}

fn arm_t5(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,reps:[]u8,repn:[]u8,label:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,label);
  let vd:[]u8=z_alloc(32);
  let e:[]u8="FAIL"; let k:i32=0; while(k<4){vd[k]=e[k]; k=k+1;} vd[4]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,label,vd); return; }
  let nacc:i32=construct(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,50000,0);
  mk_reps(accb,accn,reps,repn);
  let ri:i32=disambiguate(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,reps,repn,200);
  if(ri<0){ send_defer(cfg,R,OUT,lgc,PL,line,tok,label,vd); arm_end_log(cfg,OUT,lgc,label,vd); return; }
  let rp:[]u8=z_alloc(192);
  let rn:i32=rep_prog(reps,ri,rp);
  let lin:i32=ig(cfg,28);
  put32(cfg,28,lin+1);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,3,lin,0,rp,rn*3);
  m_save(cfg,rp,rn,lin,3);
  let vd2:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,3,vd2);
  arm_end_log(cfg,OUT,lgc,label,vd2);
  return;
}

fn arm_c0(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C0");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="CONTROL-VIOLATION"; let k:i32=0; while(k<17){vd[k]=e[k]; k=k+1;} vd[17]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"C0",vd); return; }
  // inventory only: 80 length-1 programs, no construction, no DEFINE
  cons_reset(cfg,pool,stab);
  put32(cfg,16,50000); put32(cfg,12,0); put32(cfg,20,0);
  let tmp:[]u8=z_alloc(192);
  let best:i32=-1;
  let bb:[]u8=z_alloc(192);
  let o:i32=0;
  while(o<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        tmp[0]=o as u8; tmp[1]=d as u8; tmp[2]=s as u8;
        let ci:i32=mk_cand(cfg,pool,0,0,tmp,1);
        let sc:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ci);
        if(ig(cfg,20)==1){ break; }
        if(sc>best){ best=sc; bb[0]=o as u8; bb[1]=d as u8; bb[2]=s as u8; }
        s=s+1;
      }
      if(ig(cfg,20)==1){ break; }
      d=d+1;
    }
    if(ig(cfg,20)==1){ break; }
    o=o+1;
  }
  let RB:[]u8=z_alloc(64);
  let rc:i32=0;
  rc=e1i64(RB,rc,best as i64);
  tr_emit(cfg,OUT,lgc,"C0-BEST",RB,rc);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,0,1,0,bb,3);
  let vd2:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,0,vd2);
  arm_end_log(cfg,OUT,lgc,"C0",vd2);
  return;
}

fn arm_c1(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C1");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="CONTROL-VIOLATION"; let k:i32=0; while(k<17){vd[k]=e[k]; k=k+1;} vd[17]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"C1",vd); return; }
  let tn:i32=ig(cfg,24);
  let pairs:[]u8=z_alloc(64);
  let i:i32=0;
  while(i<tn){
    let x:i32=ig(train,i*4);
    put32(pairs,i*8,0);
    put32(pairs,i*8+4,0);
    let found:i32=0;
    let dy:i32=-8;
    while(dy<=8 && found==0){
      let r:i32=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,x+dy,0,-5);
      if(r==-1){ break; }
      if(r==1){ put32(pairs,i*8,1); put32(pairs,i*8+4,x+dy); found=1; }
      dy=dy+1;
    }
    let sp:i32=0;
    while(sp<5 && found==0){
      let y:i32=0;
      if(sp==1){ y=1; } else { if(sp==2){ y=-1; } else { if(sp==3){ y=2; } else { if(sp==4){ y=-2; } } } }
      let r2:i32=do_test(cfg,R,OUT,lgc,PL,line,tok,ov,x,y,0,-5);
      if(r2==-1){ break; }
      if(r2==1){ put32(pairs,i*8,1); put32(pairs,i*8+4,y); found=1; }
      sp=sp+1;
    }
    if(ig(cfg,20)==1){ break; }
    i=i+1;
  }
  // held-out inputs
  let LB:[]u8=z_alloc(32);
  let c:i32=0;
  c=e1str(LB,c,"HELDOUT_X");
  psend(cfg,OUT,lgc,PL,LB,c);
  let hxs:[]u8=z_alloc(64);
  let hn:i32=0;
  while(hn<6){
    let ll:i32=precv(cfg,R,OUT,lgc,line);
    if(ll<0){ break; }
    let t0:i32=gettok(line,ll,0,tok);
    if(seq8(tok[0..t0],"END")==1){ break; }
    if(seq8(tok[0..t0],"INSTANCE")==1){
      let t1:i32=gettok(line,ll,1,tok);
      let pp:i32=p_int(tok,0,t1,ov);
      put32(hxs,hn*4,ig(ov,0));
      hn=hn+1;
    }
  }
  let j:i32=0;
  while(j<hn){
    let h:i32=ig(hxs,j*4);
    // 1-nearest-neighbor in input space; ties -> smaller x
    let bi2:i32=0;
    let bd2:i32=2147483647;
    let t3:i32=0;
    while(t3<tn){
      let x3:i32=ig(train,t3*4);
      let dd:i32=h-x3;
      if(dd<0){ dd=0-dd; }
      if(dd<bd2){ bd2=dd; bi2=t3; }
      else { if(dd==bd2){ if(x3<ig(train,bi2*4)){ bi2=t3; } } }
      t3=t3+1;
    }
    let y2:i32=h;
    if(ig(pairs,bi2*8)==1){ y2=ig(pairs,bi2*8+4); }
    do_test(cfg,R,OUT,lgc,PL,line,tok,ov,h,y2,0,-6);
    if(ig(cfg,20)==1){ break; }
    j=j+1;
  }
  let vd2:[]u8=z_alloc(32);
  do_tally(cfg,R,OUT,lgc,PL,line,tok,ov,vd2);
  arm_end_log(cfg,OUT,lgc,"C1",vd2);
  return;
}

fn arm_c2(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C2");
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ return; }
  let gp:[]u8=z_alloc(192);
  let gn:[]u8=z_alloc(8);
  let bs:i32=greedy_c2(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,gp,gn,50000);
  let vd:[]u8=z_alloc(32);
  claim_train(cfg,R,OUT,lgc,PL,line,tok,ov,gp,ig(gn,0)*3,vd);
  arm_end_log(cfg,OUT,lgc,"C2",vd);
  return;
}

fn arm_c3(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,hex:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C3");
  let pb:[]u8=z_alloc(192);
  let nb:i32=hex.len/2;
  hexdec(hex,0,pb,nb);
  commit_prog(cfg,R,OUT,lgc,PL,line,tok,0,1,0,pb,nb);
  let vd:[]u8=z_alloc(32);
  do_score(cfg,R,OUT,lgc,PL,line,tok,ov,0,vd);
  arm_end_log(cfg,OUT,lgc,"C3",vd);
  return;
}

fn arm_c4(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C4");
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ return; }
  let gp:[]u8=z_alloc(192);
  let gn:[]u8=z_alloc(8);
  let bs:i32=enum_c4(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,gp,gn,50000);
  let vd:[]u8=z_alloc(32);
  claim_train(cfg,R,OUT,lgc,PL,line,tok,ov,gp,ig(gn,0)*3,vd);
  arm_end_log(cfg,OUT,lgc,"C4",vd);
  return;
}

fn arm_c5(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,abst:[]u8,beam:[]u8,ch:[]u8,reps:[]u8,repn:[]u8)void {
  arm_begin(cfg);
  send_arm(cfg,R,OUT,lgc,PL,line,tok,"C5");
  let vd:[]u8=z_alloc(32);
  let e:[]u8="BASELINE"; let k:i32=0; while(k<8){vd[k]=e[k]; k=k+1;} vd[8]=0;
  if(observe(cfg,R,OUT,lgc,PL,line,tok,ov,train,6,-1)<0){ arm_end_log(cfg,OUT,lgc,"C5",vd); return; }
  // abstraction table cleared (fresh process has none); from-scratch build
  let nacc:i32=construct(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,50000,0);
  mk_reps(accb,accn,reps,repn);
  if(ig(repn,0)>0){
    let rp:[]u8=z_alloc(192);
    let rn:i32=rep_prog(reps,0,rp);
    commit_prog(cfg,R,OUT,lgc,PL,line,tok,0,1,0,rp,rn*3);
    let vd2:[]u8=z_alloc(32);
    do_score(cfg,R,OUT,lgc,PL,line,tok,ov,0,vd2);
    arm_end_log(cfg,OUT,lgc,"C5",vd2);
    return;
  }
  arm_end_log(cfg,OUT,lgc,"C5",vd);
  return;
}

fn main()i32 {
  let cfg:[]u8=z_alloc(512);
  let seedarg:[]u8=_zag_arg(1);
  let ov0:[]u8=z_alloc(8);
  let sp:i32=p_int(seedarg,0,seedarg.len,ov0);
  let seed:i32=ig(ov0,0);
  cfg_init(cfg,seed);
  let R:[]u8=z_alloc(8192);
  rd_init(R);
  let OUT:[]u8=z_alloc(1048576);
  let lgc:[]u8=z_alloc(8);
  put32(lgc,0,0);
  let PL:[]u8=z_alloc(512);
  let line:[]u8=z_alloc(4096);
  let tok:[]u8=z_alloc(1024);
  let ov:[]u8=z_alloc(8);
  let train:[]u8=z_alloc(256);
  let pool:[]u8=z_alloc(7077888);
  let stab:[]u8=z_alloc(524288);
  let accb:[]u8=z_alloc(204800);
  let accn:[]u8=z_alloc(8);
  let abst:[]u8=z_alloc(1664);
  let beam:[]u8=z_alloc(512);
  // ch holds one u32 per generated child across a full expand_level:
  // up to 40 parents x (80 appends + 80 substs + 8 abst x 64 inline)
  // = 26880 entries in transfer mode. 8192 entries (32768) overflows.
  let ch:[]u8=z_alloc(262144);
  let reps:[]u8=z_alloc(112640);
  let repn:[]u8=z_alloc(8);
  lg_line(cfg,OUT,lgc,"L3-NIV2 learner boot");
  lg_num2(cfg,OUT,lgc,"seed=",seed as i64);
  let pause_ct:i32=0;
  let ai:i32=2;
  while(1==1){
    let a:[]u8=_zag_arg(ai);
    if(a.len==0){ break; }
    if(seq8(a,"PAUSE")==1){
      let LB:[]u8=z_alloc(16);
      let c:i32=0;
      c=e1str(LB,c,"PAUSE");
      psend(cfg,OUT,lgc,PL,LB,c);
      let ll:i32=precv(cfg,R,OUT,lgc,line);
      pause_ct=pause_ct+1;
      lg_num2(cfg,OUT,lgc,"PHASE-DONE pause=",pause_ct as i64);
      let LB2:[]u8=z_alloc(16);
      let c2:i32=0;
      c2=e1str(LB2,c2,"HELLO");
      psend(cfg,OUT,lgc,PL,LB2,c2);
      let ll2:i32=precv(cfg,R,OUT,lgc,line);
    }
    else { if(seq8(a,"T1")==1){ arm_t1(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn); }
    else { if(seq8(a,"T2")==1){ arm_t2(cfg,R,OUT,lgc,PL,line,tok,ov,train); }
    else { if(seq8(a,"T3")==1){ arm_t3(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn); }
    else { if(seq8(a,"T4")==1){ arm_t4(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn); }
    else { if(seq8(a,"T5A")==1){ arm_t5(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn,"T5A"); }
    else { if(seq8(a,"T5B")==1){ arm_t5(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn,"T5B"); }
    else { if(seq8(a,"C0")==1){ arm_c0(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab); }
    else { if(seq8(a,"C1")==1){ arm_c1(cfg,R,OUT,lgc,PL,line,tok,ov,train); }
    else { if(seq8(a,"C2")==1){ arm_c2(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab); }
    else { if(seq8(a,"C3")==1){
      ai=ai+1;
      let hx:[]u8=_zag_arg(ai);
      arm_c3(cfg,R,OUT,lgc,PL,line,tok,ov,hx);
    }
    else { if(seq8(a,"C4")==1){ arm_c4(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab); }
    else { if(seq8(a,"C5")==1){ arm_c5(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,accb,accn,abst,beam,ch,reps,repn); }
    else { lg_line(cfg,OUT,lgc,"unknown arm"); }
    } } } } } } } } } } } }
    ai=ai+1;
  }
  lg_line(cfg,OUT,lgc,"learner done");
  let lc:i32=ig(lgc,0);
  lg_flush(OUT,lc);
  return 0;
}

// world.zag -- WORLD process: world plus sealed evaluator (L3-NIV2).
// Holds the hidden rule (reference program) and expected values. The
// learner NEVER sees the key file; only this process reads it.
// Consequence channel: per TEST, replies ACCEPT or REJECT only. REJECT
// carries no expected value, no distance, no hint.
// Reports per arm: PASS/FAIL (or CONTROL-OK/VIOLATION/BASELINE), accept
// counts, TEST counts, digests. Never reveals instances beyond the
// protocol, never reveals rules or expected values.

fn wlog(OUT:[]u8, s:[]u8)void {
  let c:i32=0;
  c=e1str(OUT,c,s);
  OUT[c]=10; c=c+1;
  wraw(2,OUT,c);
  return;
}

// Key block layout (W):
// 0: regime name len, 4: regime name bytes (64)
// 68: ntrain, 72: train[64] i32
// 328: nheld, 332: held[64] i32
// 588: nextra, 592: extra[64] i32
// 848: refn (bytes), 852: refprog[192]
// 1044: test_total, 1048: arm_tests, 1052: arm_accepts
// 1056: arm label len, 1060: arm label (32)
// 1092: committed_this_arm flag
// slots: base 1120, 8 slots x 208 bytes:
//   [0]=used,[4]=lineage,[8]=parent,[12]=proglen,[16..208)=prog bytes
fn w_init(W:[]u8)void {
  let i:i32=0;
  while(i<3000){ W[i]=0; i=i+1; }
  return;
}
fn slot_base(s:i32)i32 { return 1120+s*208; }

// Parse key file into W. Returns 1 ok, 0 fail.
fn w_loadkey(W:[]u8, path:[]u8) i32 {
  let data:[]u8=_zag_read_file(path);
  if(data.len==0){ return 0; }
  let p:i32=0;
  let n:i32=data.len;
  let line:[]u8=z_alloc(1024);
  let tok:[]u8=z_alloc(256);
  let ov:[]u8=z_alloc(8);
  let mode:i32=0; // 0=header,1=train,2=held,3=extra
  let need:i32=0;
  let ti:i32=0; let hi:i32=0; let ei:i32=0;
  while(p<n){
    // read one line
    let ll:i32=0;
    while(p<n && data[p]!=10){ if(ll<1023){line[ll]=data[p]; ll=ll+1;} p=p+1; }
    if(p<n){ p=p+1; }
    if(ll==0){ continue; }
    if(line[0]==35){ continue; } // '#'
    let t0l:i32=gettok(line,ll,0,tok);
    if(mode==1){
      let pp9:i32=p_int(line,0,ll,ov); let v:i32=ig(ov,0);
      put32(W,72+ti*4,v); ti=ti+1; need=need-1;
      if(need<=0){ put32(W,68,ti); mode=0; }
      continue;
    }
    if(mode==2){
      let pp9:i32=p_int(line,0,ll,ov); let v:i32=ig(ov,0);
      put32(W,332+hi*4,v); hi=hi+1; need=need-1;
      if(need<=0){ put32(W,328,hi); mode=0; }
      continue;
    }
    if(mode==3){
      let pp9:i32=p_int(line,0,ll,ov); let v:i32=ig(ov,0);
      put32(W,592+ei*4,v); ei=ei+1; need=need-1;
      if(need<=0){ put32(W,588,ei); mode=0; }
      continue;
    }
    let is_regime:i32=seq8(tok[0..t0l],"REGIME");
    let is_train:i32=seq8(tok[0..t0l],"TRAIN");
    let is_held:i32=seq8(tok[0..t0l],"HELDOUT");
    let is_extra:i32=seq8(tok[0..t0l],"EXTRA");
    let is_ref:i32=seq8(tok[0..t0l],"REFPROG");
    let t1l:i32=gettok(line,ll,1,tok);
    if(is_regime==1){
      let k:i32=0;
      while(k<t1l && k<63){ W[4+k]=tok[k]; k=k+1; }
      put32(W,0,t1l);
      continue;
    }
    if(is_train==1){
      let pp:i32=p_int(line,t0l,ll,ov); need=ig(ov,0); ti=0; mode=1;
      continue;
    }
    if(is_held==1){
      let pp:i32=p_int(line,t0l,ll,ov); need=ig(ov,0); hi=0; mode=2;
      continue;
    }
    if(is_extra==1){
      let pp:i32=p_int(line,0,ll,ov); need=ig(ov,0); ei=0; mode=3;
      continue;
    }
    if(is_ref==1){
      let hx:[]u8=z_alloc(256);
      let k:i32=0;
      while(k<t1l){ hx[k]=tok[k]; k=k+1; }
      let nb:i32=t1l/2;
      let ok:i32=hexdec(hx,0,W[852..1044],nb);
      if(ok==0){ return 0; }
      put32(W,848,nb);
      continue;
    }
  }
  return 1;
}

// reply helpers: build line in OUT, single write to fd 1.
fn rep1(tag:[]u8)void {
  let OUT:[]u8=z_alloc(256);
  let c:i32=0;
  c=e1str(OUT,c,tag); OUT[c]=10; c=c+1;
  wraw(1,OUT,c);
  return;
}
fn rep_inst(x:i32)void {
  let OUT:[]u8=z_alloc(64);
  let c:i32=0;
  c=e1str(OUT,c,"INSTANCE ");
  c=e1i64(OUT,c,x as i64);
  OUT[c]=10; c=c+1;
  wraw(1,OUT,c);
  return;
}
fn rep_result(a:i32,t:i32,verdict:[]u8,dh:[]u8)void {
  let OUT:[]u8=z_alloc(256);
  let c:i32=0;
  c=e1str(OUT,c,"RESULT ");
  c=e1i64(OUT,c,a as i64); OUT[c]=32; c=c+1;
  c=e1i64(OUT,c,t as i64); OUT[c]=32; c=c+1;
  c=e1str(OUT,c,verdict); OUT[c]=32; c=c+1;
  c=e1str(OUT,c,dh);
  OUT[c]=10; c=c+1;
  wraw(1,OUT,c);
  return;
}
fn rep_tally(a:i32,t:i32,verdict:[]u8)void {
  let OUT:[]u8=z_alloc(256);
  let c:i32=0;
  c=e1str(OUT,c,"TALLY ");
  c=e1i64(OUT,c,a as i64); OUT[c]=32; c=c+1;
  c=e1i64(OUT,c,t as i64); OUT[c]=32; c=c+1;
  c=e1str(OUT,c,verdict);
  OUT[c]=10; c=c+1;
  wraw(1,OUT,c);
  return;
}
fn rep_armok(label:[]u8,ll:i32)void {
  let OUT:[]u8=z_alloc(128);
  let c:i32=0;
  c=e1str(OUT,c,"ARM-OK ");
  let k:i32=0;
  while(k<ll){ OUT[c]=label[k]; c=c+1; k=k+1; }
  OUT[c]=10; c=c+1;
  wraw(1,OUT,c);
  return;
}

// verdict for score-based arms given accepts a of t.
fn verdict_of(W:[]u8,a:i32,t:i32,out:[]u8)i32 {
  let al:i32=ig(W,1056);
  let ab:[]u8=W[1060..1092];
  if(seq8(ab[0..al],"T1")==1 || seq8(ab[0..al],"T2")==1 || seq8(ab[0..al],"T3")==1 || seq8(ab[0..al],"T4")==1){
    if(a>=5){ let s:[]u8="PASS"; let k:i32=0; while(k<4){out[k]=s[k]; k=k+1;} return 4; }
    let s2:[]u8="FAIL"; let k2:i32=0; while(k2<4){out[k2]=s2[k2]; k2=k2+1;} return 4;
  }
  if(seq8(ab[0..al],"T5A")==1){
    if(a>=6){ let s:[]u8="PASS"; let k:i32=0; while(k<4){out[k]=s[k]; k=k+1;} return 4; }
    let s2:[]u8="FAIL"; let k2:i32=0; while(k2<4){out[k2]=s2[k2]; k2=k2+1;} return 4;
  }
  if(seq8(ab[0..al],"C0")==1 || seq8(ab[0..al],"C1")==1){
    if(a<5){ let s:[]u8="CONTROL-OK"; let k:i32=0; while(k<10){out[k]=s[k]; k=k+1;} return 10; }
    let s2:[]u8="CONTROL-VIOLATION"; let k2:i32=0; while(k2<17){out[k2]=s2[k2]; k2=k2+1;} return 17;
  }
  if(seq8(ab[0..al],"C3")==1){
    if(a<=2){ let s:[]u8="CONTROL-OK"; let k:i32=0; while(k<10){out[k]=s[k]; k=k+1;} return 10; }
    let s2:[]u8="CONTROL-VIOLATION"; let k2:i32=0; while(k2<17){out[k2]=s2[k2]; k2=k2+1;} return 17;
  }
  let s3:[]u8="BASELINE"; let k3:i32=0; while(k3<8){out[k3]=s3[k3]; k3=k3+1;} return 8;
}

// do_score: execute slot prog on heldout, count accepts vs refprog.
fn do_score(W:[]u8,slot:i32,acc:[]u8)i32 {
  let sb:i32=slot_base(slot);
  if(W[sb]==0){ put32(acc,0,-1); return -1; }
  let pn:i32=ig(W,sb+12);
  let nh:i32=ig(W,328);
  let rn:i32=ig(W,848);
  let a:i32=0;
  let i:i32=0;
  while(i<nh){
    let x:i32=ig(W,332+i*4);
    let y:i32=isa_exec(W[sb+16..sb+208],pn,x);
    let e:i32=isa_exec(W[852..1044],rn,x);
    if(y==e && y!=-2000000000){ a=a+1; }
    // digest material
    put32(acc,0,a);
    i=i+1;
  }
  return a;
}

fn main()i32 {
  let W:[]u8=z_alloc(4096);
  w_init(W);
  let kp:[]u8=_zag_arg(1);
  if(kp.len==0){ return 1; }
  let ok:i32=w_loadkey(W,kp);
  if(ok==0){ return 2; }
  let R:[]u8=z_alloc(8192);
  rd_init(R);
  let line:[]u8=z_alloc(4096);
  let tok:[]u8=z_alloc(1024);
  let ov:[]u8=z_alloc(8);
  let LOG:[]u8=z_alloc(256);
  wlog(LOG,"world: key loaded");
  while(1==1){
    let ll:i32=read_line(R,0,line,4096);
    if(ll<0){ break; }
    let t0l:i32=gettok(line,ll,0,tok);
    if(t0l==0){ continue; }
    if(seq8(tok[0..t0l],"HELLO")==1){ rep1("READY"); continue; }
    if(seq8(tok[0..t0l],"PAUSE")==1){ rep1("PAUSING"); break; }
    if(seq8(tok[0..t0l],"ARM")==1){
      let al:i32=gettok(line,ll,1,tok);
      let k:i32=0;
      while(k<al && k<31){ W[1060+k]=tok[k]; k=k+1; }
      put32(W,1056,al);
      put32(W,1048,0); put32(W,1052,0); put32(W,1092,0);
      rep_armok(tok,al);
      continue;
    }
    if(seq8(tok[0..t0l],"OBSERVE")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let p1:i32=p_int(tok,0,t1l,ov); let cnt:i32=ig(ov,0);
      let t2l:i32=gettok(line,ll,2,tok);
      let p2:i32=p_int(tok,0,t2l,ov); let oseed:i32=ig(ov,0);
      let nt:i32=ig(W,68);
      // Fisher-Yates shuffle of indices by oseed; oseed<0 = key order
      let idx:[]u8=z_alloc(256);
      let i:i32=0;
      while(i<nt){ put32(idx,i*4,i); i=i+1; }
      if(oseed>=0){
        let st:[]u8=z_alloc(8);
        rng_seed(st,oseed+1);
        let j:i32=nt-1;
        while(j>0){
          let r:i32=rng_next(st);
          if(r<0){ r=0-r; }
          let m:i32=r%(j+1);
          let ta:i32=ig(idx,j*4); let tb:i32=ig(idx,m*4);
          put32(idx,j*4,tb); put32(idx,m*4,ta);
          j=j-1;
        }
      }
      let s:i32=0;
      while(s<cnt && s<nt){
        let xi:i32=ig(idx,s*4);
        rep_inst(ig(W,72+xi*4));
        s=s+1;
      }
      rep1("END");
      continue;
    }
    if(seq8(tok[0..t0l],"OBSERVE_EXTRA")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let p1:i32=p_int(tok,0,t1l,ov); let cnt:i32=ig(ov,0);
      let ne:i32=ig(W,588);
      let s:i32=0;
      while(s<cnt && s<ne){ rep_inst(ig(W,592+s*4)); s=s+1; }
      rep1("END");
      continue;
    }
    if(seq8(tok[0..t0l],"HELDOUT_X")==1){
      let nh:i32=ig(W,328);
      let s:i32=0;
      while(s<nh){ rep_inst(ig(W,332+s*4)); s=s+1; }
      rep1("END");
      continue;
    }
    if(seq8(tok[0..t0l],"TEST")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let p1:i32=p_int(tok,0,t1l,ov); let x:i32=ig(ov,0);
      let t2l:i32=gettok(line,ll,2,tok);
      let iserr:i32=seq8(tok[0..t2l],"ERR");
      let y:i32=0;
      if(iserr==0){ let p2:i32=p_int(tok,0,t2l,ov); y=ig(ov,0); }
      let rn:i32=ig(W,848);
      let e:i32=isa_exec(W[852..1044],rn,x);
      put32(W,1044,ig(W,1044)+1);
      put32(W,1048,ig(W,1048)+1);
      if(iserr==0 && y==e){ put32(W,1052,ig(W,1052)+1); rep1("ACCEPT"); }
      else { rep1("REJECT"); }
      continue;
    }
    if(seq8(tok[0..t0l],"COMMIT")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let p1:i32=p_int(tok,0,t1l,ov); let slot:i32=ig(ov,0);
      let t2l:i32=gettok(line,ll,2,tok);
      let p2:i32=p_int(tok,0,t2l,ov); let lin:i32=ig(ov,0);
      let t3l:i32=gettok(line,ll,3,tok);
      let p3:i32=p_int(tok,0,t3l,ov); let par:i32=ig(ov,0);
      let t4l:i32=gettok(line,ll,4,tok);
      let nb:i32=t4l/2;
      if(slot<0 || slot>7 || nb>192){ rep1("COMMIT-REJECT"); continue; }
      let sb:i32=slot_base(slot);
      W[sb]=1; put32(W,sb+4,lin); put32(W,sb+8,par); put32(W,sb+12,nb);
      let ok2:i32=hexdec(tok,0,W[sb+16..sb+208],nb);
      if(ok2==0){ W[sb]=0; rep1("COMMIT-REJECT"); continue; }
      put32(W,1092,1);
      rep1("COMMITTED");
      continue;
    }
    if(seq8(tok[0..t0l],"SCORE")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let p1:i32=p_int(tok,0,t1l,ov); let slot:i32=ig(ov,0);
      let acc:[]u8=z_alloc(8);
      let a:i32=do_score(W,slot,acc);
      let nh:i32=ig(W,328);
      // digest over regime+arm+prog+results
      let dg:[]u8=z_alloc(512);
      let dp:i32=0;
      let rl:i32=ig(W,0);
      let k:i32=0;
      while(k<rl){ dg[dp]=W[4+k]; dp=dp+1; k=k+1; }
      let al:i32=ig(W,1056);
      k=0;
      while(k<al){ dg[dp]=W[1060+k]; dp=dp+1; k=k+1; }
      let sb:i32=slot_base(slot);
      let pn:i32=ig(W,sb+12);
      k=0;
      while(k<pn){ dg[dp]=W[sb+16+k]; dp=dp+1; k=k+1; }
      put32(dg,dp,a); dp=dp+4;
      let vd:[]u8=z_alloc(32);
      let vl:i32=verdict_of(W,a,nh,vd);
      let dh:[]u8=z_alloc(32);
      let c:i32=0;
      c=e1fnv(dh,c,dg,dp,1469598103934665603);
      dh[c]=0;
      rep_result(a,nh,vd[0..vl],dh[0..16]);
      continue;
    }
    if(seq8(tok[0..t0l],"TALLY")==1){
      let a:i32=ig(W,1052);
      let t:i32=ig(W,1048);
      let vd:[]u8=z_alloc(32);
      let vl:i32=verdict_of(W,a,t,vd);
      rep_tally(a,t,vd[0..vl]);
      continue;
    }
    if(seq8(tok[0..t0l],"CLAIM_TRAIN")==1){
      let t1l:i32=gettok(line,ll,1,tok);
      let nb:i32=t1l/2;
      let pb:[]u8=z_alloc(192);
      let ok2:i32=hexdec(tok,0,pb,nb);
      let nt:i32=ig(W,68);
      let rn:i32=ig(W,848);
      let a:i32=0;
      if(ok2==1){
        let i:i32=0;
        while(i<nt){
          let x:i32=ig(W,72+i*4);
          let y:i32=isa_exec(pb,nb,x);
          let e:i32=isa_exec(W[852..1044],rn,x);
          if(y==e && y!=-2000000000){ a=a+1; }
          i=i+1;
        }
      }
      let al:i32=ig(W,1056);
      let ab:[]u8=W[1060..1092];
      let vd:[]u8="CONTROL-OK";
      let vl:i32=10;
      if(a>=6){ vd="CONTROL-VIOLATION"; vl=17; }
      rep_tally(a,nt,vd[0..vl]);
      continue;
    }
    if(seq8(tok[0..t0l],"DEFER")==1){
      let committed:i32=ig(W,1092);
      let at:i32=ig(W,1048);
      let al:i32=ig(W,1056);
      let ab:[]u8=W[1060..1092];
      let vd:[]u8="FAIL";
      let vl:i32=4;
      if(seq8(ab[0..al],"T5B")==1 && committed==0 && at<=200){
        vd="PASS"; vl=4;
      }
      rep_tally(0,0,vd[0..vl]);
      continue;
    }
    rep1("UNKNOWN");
  }
  return 0;
}

// lm_cons4.zag -- 2S-CALR stage 2: deepening beyond depth 3 (L3-NIV2 wave 4).
//
// Stage 1 (lm_cons3.zag, wave-3 CALR + Y1 yield) is complete for depth-3
// (theorem T1, PREREG_WAVE4.md). When it yields, no depth-3 program fully
// accepts. Stage 2 searches depth-4 via 2-step consequence-anchored
// lookahead (potential_2), with a provably complete nested descent.
//
// The d=0 prune (D2, PREREG_WAVE4.md): stage-1 completeness implies any
// depth-4 solution's final instruction writes r0; otherwise its outputs
// would equal a depth-3 program's, contradicting completeness. So the
// nested descent's c2 ranges over the 16 d=0 appends only. This is a
// provable prune from staged completeness, not a quota and not a beam.

// calr2_applyst: apply single instruction (o1,d1,s1) to st (tn states of
// 16 bytes) producing st1. Local simulation, zero TESTs.
fn calr2_applyst(cfg:[]u8,st:[]u8,o1:i32,d1:i32,s1:i32,st1:[]u8)void {
  let tn:i32=ig(cfg,24);
  let j:i32=0;
  while(j<tn){
    let b0:i32=j*16;
    put32(st1,b0,ig(st,b0)); put32(st1,b0+4,ig(st,b0+4));
    put32(st1,b0+8,ig(st,b0+8)); put32(st1,b0+12,ig(st,b0+12));
    let rs:i32=ig(st,b0+s1*4);
    let dv:i32=ig(st,b0+d1*4);
    let nv:i32=dv+1;
    if(o1==0){ nv=rs; }
    if(o1==1){ nv=dv+rs; }
    if(o1==2){ nv=dv*rs; }
    if(o1==3){ nv=1; }
    put32(st1,b0+d1*4,nv);
    j=j+1;
  }
  return;
}
// calr2_pot1d0: max over the 16 d=0 appends of fhat agreement.
// st holds tn register-states (16 bytes each). Zero TESTs.
fn calr2_pot1d0(cfg:[]u8,tn:i32,st:[]u8)i32 {
  let best:i32=0;
  let o:i32=0;
  while(o<5){
    let s:i32=0;
    while(s<4){
      let m:i32=ext_agree(cfg,tn,st,o,0,s);
      if(m>best){ best=m; }
      s=s+1;
    }
    o=o+1;
  }
  return best;
}
// calr2_pot2: Phase B2. potential_2 for each depth-2 prefix in plist:
// max over 80 c1 of (max over 80 c2 of fhat agreement), by local
// simulation (zero TESTs). pot2[q] set; returns max potential_2.
fn calr2_pot2(cfg:[]u8,train:[]u8,pool:[]u8,plist:[]u8,pn:i32,pot2:[]u8)i32 {
  let tn:i32=ig(cfg,24);
  let pmax2:i32=0;
  let regs:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(256);
  let st1:[]u8=z_alloc(96);
  let q:i32=0;
  while(q<pn){
    let pi:i32=ig(plist,q*4);
    let b:i32=pool_base(pi);
    let n:i32=ig(pool,b+12);
    let j:i32=0;
    while(j<tn){
      isa_regs(pool[b+16..b+208],n,ig(train,j*4),regs);
      put32(st,j*16,ig(regs,0)); put32(st,j*16+4,ig(regs,4));
      put32(st,j*16+8,ig(regs,8)); put32(st,j*16+12,ig(regs,12));
      j=j+1;
    }
    let best2:i32=0;
    let e1:i32=0;
    while(e1<80){
      calr2_applyst(cfg,st,e1/16,(e1/4)-(e1/16)*4,e1-(e1/4)*4,st1);
      let b1:i32=best_ext_agree(cfg,tn,st1);
      if(b1>best2){ best2=b1; }
      e1=e1+1;
    }
    put32(pot2,q*4,best2);
    if(best2>pmax2){ pmax2=best2; }
    q=q+1;
  }
  return pmax2;
}
// calr2_p2rank: find P2 (bytes 00 01 00 02 00 00) in plist; compute its
// rank by (pot2 desc, score desc, id asc). tid_out/p2p_out/r_out receive
// id/pot2/rank, or -1 if absent. Diagnosis trace for W4K5.
fn calr2_p2rank(pool:[]u8,plist:[]u8,pn:i32,pot2:[]u8,r_out:[]u8,tid_out:[]u8,p2p_out:[]u8)void {
  put32(tid_out,0,-1); put32(r_out,0,-1); put32(p2p_out,0,-1);
  let tpi:i32=-1;
  let tq:i32=-1;
  let q:i32=0;
  while(q<pn){
    let pi:i32=ig(plist,q*4);
    let b:i32=pool_base(pi);
    if(ig(pool,b+12)==2){
      if(bytes6_is_target(pool,b)==1){ tpi=pi; tq=q; }
    }
    q=q+1;
  }
  if(tpi<0){ return; }
  let tid:i32=cand_id(pool,tpi);
  let tpot:i32=ig(pot2,tq*4);
  let tsc:i32=cand_score(pool,tpi);
  put32(tid_out,0,tid);
  put32(p2p_out,0,tpot);
  let rank:i32=1;
  let q2:i32=0;
  while(q2<pn){
    let pi2:i32=ig(plist,q2*4);
    let id2:i32=cand_id(pool,pi2);
    if(id2!=tid){
      let s2:i32=cand_score(pool,pi2);
      let p2:i32=ig(pot2,q2*4);
      if(pot_better(p2,s2,id2,tpot,tsc,tid)==1){ rank=rank+1; }
    }
    q2=q2+1;
  }
  put32(r_out,0,rank);
  return;
}
// construct_calr_stage2: 2S-CALR stage 2 (wave 4).
// plist/pn: the 6400 depth-2 prefixes with Phase-A scores (from stage 1).
// Phase B2: potential_2 by local simulation. Phase C2: nested complete
// descent in (potential_2, score, id) order, d=0 c2 only (D2 prune).
// Returns 1 if a depth-4 program was accepted, 0 otherwise.
fn construct_calr_stage2(cfg:[]u8,R:[]u8,OUT:[]u8,lgc:[]u8,PL:[]u8,line:[]u8,tok:[]u8,ov:[]u8,train:[]u8,pool:[]u8,stab:[]u8,accb:[]u8,accn:[]u8,plist:[]u8,pn:i32)i32 {
  let tn:i32=ig(cfg,24);
  let nk:i32=0;
  let ii:i32=0;
  while(ii<tn){ if(ig(cfg,320+ii*4)==1){ nk=nk+1; } ii=ii+1; }
  let pot2:[]u8=z_alloc(pn*4+4);
  let pmax2:i32=calr2_pot2(cfg,train,pool,plist,pn,pot2);
  let r_out:[]u8=z_alloc(8);
  let tid_out:[]u8=z_alloc(8);
  let p2p_out:[]u8=z_alloc(8);
  calr2_p2rank(pool,plist,pn,pot2,r_out,tid_out,p2p_out);
  let B2:[]u8=z_alloc(64);
  let bc:i32=0;
  bc=e1i64(B2,bc,ig(tid_out,0) as i64); B2[bc]=32; bc=bc+1;
  bc=e1i64(B2,bc,ig(r_out,0) as i64); B2[bc]=32; bc=bc+1;
  bc=e1i64(B2,bc,ig(p2p_out,0) as i64); B2[bc]=32; bc=bc+1;
  bc=e1i64(B2,bc,pmax2 as i64); B2[bc]=32; bc=bc+1;
  bc=e1i64(B2,bc,nk as i64);
  tr_emit(cfg,OUT,lgc,"CALR2-RANK",B2,bc);
  if(pmax2<nk){
    let D0:[]u8=z_alloc(32);
    let dc0:i32=0;
    dc0=e1i64(D0,dc0,pmax2 as i64); D0[dc0]=32; dc0=dc0+1;
    dc0=e1i64(D0,dc0,nk as i64);
    tr_emit(cfg,OUT,lgc,"CALR2-NODEEP",D0,dc0);
    return 0;
  }
  let order:[]u8=z_alloc(pn*4+4);
  let on:i32=0;
  let pv:i32=6;
  while(pv>=0){
    if(pv<pmax2){ break; }
    let sv:i32=6;
    while(sv>=0){
      let qq:i32=0;
      while(qq<pn){
        if(ig(pot2,qq*4)==pv){
          let piq:i32=ig(plist,qq*4);
          if(cand_score(pool,piq)==sv){
            put32(order,on*4,piq);
            on=on+1;
          }
        }
        qq=qq+1;
      }
      sv=sv-1;
    }
    pv=pv-1;
  }
  let found:i32=0;
  let nver2:i32=0;
  let tmp:[]u8=z_alloc(192);
  let oi:i32=0;
  while(oi<on){
    if(found==1 || ig(cfg,20)==1){ break; }
    let pi:i32=ig(order,oi*4);
    let b:i32=pool_base(pi);
    let n:i32=ig(pool,b+12);
    let st:[]u8=z_alloc(256);
    let regs:[]u8=z_alloc(16);
    let j:i32=0;
    while(j<tn){
      isa_regs(pool[b+16..b+208],n,ig(train,j*4),regs);
      put32(st,j*16,ig(regs,0)); put32(st,j*16+4,ig(regs,4));
      put32(st,j*16+8,ig(regs,8)); put32(st,j*16+12,ig(regs,12));
      j=j+1;
    }
    let c1pot:[]u8=z_alloc(320);
    let maxc1:i32=0;
    let st1:[]u8=z_alloc(96);
    let e1:i32=0;
    while(e1<80){
      calr2_applyst(cfg,st,e1/16,(e1/4)-(e1/16)*4,e1-(e1/4)*4,st1);
      let pc1:i32=calr2_pot1d0(cfg,tn,st1);
      put32(c1pot,e1*4,pc1);
      if(pc1>maxc1){ maxc1=pc1; }
      e1=e1+1;
    }
    nver2=nver2+1;
    let f1:i32=0;
    while(f1<80){
      if(found==1 || ig(cfg,20)==1){ break; }
      if(ig(c1pot,f1*4)==maxc1){
        let o1:i32=f1/16;
        let d1:i32=(f1/4)-(f1/16)*4;
        let s1:i32=f1-(f1/4)*4;
        calr2_applyst(cfg,st,o1,d1,s1,st1);
        let o2:i32=0;
        while(o2<5){
          if(found==1 || ig(cfg,20)==1){ break; }
          let s2:i32=0;
          while(s2<4){
            if(found==1 || ig(cfg,20)==1){ break; }
            let m3:i32=ext_agree(cfg,tn,st1,o2,0,s2);
            if(m3==maxc1){
              let kk:i32=0;
              while(kk<n*3){ tmp[kk]=pool[b+16+kk]; kk=kk+1; }
              tmp[n*3]=o1 as u8; tmp[n*3+1]=d1 as u8; tmp[n*3+2]=s1 as u8;
              tmp[n*3+3]=o2 as u8; tmp[n*3+4]=0; tmp[n*3+5]=s2 as u8;
              let ck:i32=mk_cand(cfg,pool,cand_id(pool,pi),1,tmp,n+2);
              if(ck>=0){
                let sc4:i32=eval_prog(cfg,R,OUT,lgc,PL,line,tok,ov,train,pool,stab,ck);
                if(sc4>=6){
                  let b4:i32=pool_base(ck);
                  acc_add(accb,accn,pool[b4+16..b4+208],n+2);
                  found=1;
                  let FB:[]u8=z_alloc(64);
                  let fc:i32=0;
                  fc=e1i64(FB,fc,cand_id(pool,ck) as i64); FB[fc]=32; fc=fc+1;
                  fc=e1i64(FB,fc,cand_id(pool,pi) as i64); FB[fc]=32; fc=fc+1;
                  fc=e1i64(FB,fc,nver2 as i64);
                  tr_emit(cfg,OUT,lgc,"CALR2-FOUND",FB,fc);
                }
              }
            }
            s2=s2+1;
          }
          o2=o2+1;
        }
      }
      f1=f1+1;
    }
    oi=oi+1;
  }
  return found;
}

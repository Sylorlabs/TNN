// race_world_gen.zag - pure-Zag lifetime-race world generator.
// Usage: race_world_gen <seedfile> <worldidx> <outdir>
// Writes <outdir>/turns.jsonl and <outdir>/key.json deterministically
// from the seed. All names/values/choices derive from a xorshift64 PRNG.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn atoi(s:[]u8)i32 {
  let i:i32=0;
  let neg:i32=0;
  if(s.len>0 && s[0]==45){neg=1;i=1;}
  let v:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  if(neg==1){v=-v;}
  return v;
}
fn read_file(path:[]u8)[]u8 {
  let b:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){b[k]=path[k];k=k+1;}
  b[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(b) as i64),0,0,0,0,0);
  z_free(b);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn write_file(path:[]u8,data:[]u8)void {
  let b:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){b[k]=path[k];k=k+1;}
  b[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(b) as i64),577,420,0,0,0);
  z_free(b);
  if(fd>=0){
    let at:i32=0;
    while(at<data.len){
      let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(at as i64),(data.len-at) as i64,0,0,0);
      if(n<=0){at=data.len;}
      if(n>0){at=at+(n as i32);}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// xorshift64; st is 8 mutable bytes
fn r64(st:[]u8)i64 {
  let x:i64=(st[0] as i64)|((st[1] as i64)<<8)|((st[2] as i64)<<16)|((st[3] as i64)<<24)|((st[4] as i64)<<32)|((st[5] as i64)<<40)|((st[6] as i64)<<48)|((st[7] as i64)<<56);
  x=x^(x<<13);
  x=x^(x>>7);
  x=x^(x<<17);
  st[0]=(x as u8); st[1]=((x>>8) as u8); st[2]=((x>>16) as u8); st[3]=((x>>24) as u8);
  st[4]=((x>>32) as u8); st[5]=((x>>40) as u8); st[6]=((x>>48) as u8); st[7]=((x>>56) as u8);
  return x;
}
fn rnd(st:[]u8,n:i32)i32 {
  if(n<=1){return 0;}
  let x:i64=r64(st);
  if(x<0){x=-x;}
  return (x%(n as i64)) as i32;
}
// fresh names: each used entry has L bytes
fn fresh_name(st:[]u8,used:[]u8,n:i32,L:i32,out:[]u8)void {
  let go:i32=1;
  while(go==1){
    let i:i32=0;
    while(i<L){out[i]=(97+rnd(st,26)) as u8;i=i+1;}
    go=0;
    i=0;
    while(i<n){
      let same:i32=1;
      let k:i32=0;
      while(k<L){if(used[i*L+k]!=out[k]){same=0;}k=k+1;}
      if(same==1){go=1;}
      i=i+1;
    }
  }
  return;
}
// table accessors
fn ename(ents:[]u8,e:i32)[]u8 { return ents[e*2..e*2+2]; }
fn aname(attrs:[]u8,a:i32)[]u8 { return attrs[a*3..a*3+3]; }
fn rname(rels:[]u8,r:i32)[]u8 { return rels[r*3..r*3+3]; }
fn aval(vals:[]u8,a:i32,v:i32)[]u8 { return vals[(a*4+v)*2..(a*4+v)*2+2]; }
fn vw(vwords:[]u8,i:i32)[]u8 { return vwords[i*4..i*4+4]; }
fn vg(vgnd:[]u8,i:i32)[]u8 { return vgnd[i*3..i*3+3]; }
fn pname(procs:[]u8,i:i32)[]u8 { return procs[i*2..i*2+2]; }
fn tname(tents:[]u8,i:i32)[]u8 { return tents[i*2..i*2+2]; }
// cursor: 24 bytes: [tb_at, kb_at, wb_at, turn, qfirst, wfirst]
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn emit_line(tb:[]u8,c:[]u8,line:[]u8)void {
  let at:i32=ld32(c,0);
  at=app(tb,at,line);
  tb[at]=10; at=at+1;
  st32(c,0,at);
  return;
}
fn next_turn(c:[]u8)i32 {
  let t:i32=ld32(c,12);
  st32(c,12,t+1);
  return t;
}
fn keyq(kb:[]u8,c:[]u8,qid:[]u8,ans:[]u8)void {
  let at:i32=ld32(c,4);
  if(ld32(c,16)==0){st32(c,16,1);} else {kb[at]=44;at=at+1;}
  at=app(kb,at,"\""); at=app(kb,at,qid); at=app(kb,at,"\":\""); at=app(kb,at,ans); at=app(kb,at,"\"");
  st32(c,4,at);
  return;
}
fn keyw(wb:[]u8,c:[]u8,qid:[]u8,obj:[]u8)void {
  let at:i32=ld32(c,8);
  if(ld32(c,20)==0){st32(c,20,1);} else {wb[at]=44;at=at+1;}
  at=app(wb,at,"\""); at=app(wb,at,qid); at=app(wb,at,"\":"); at=app(wb,at,obj);
  st32(c,8,at);
  return;
}
// ---- turn emitters ----
fn e_fact(tb:[]u8,c:[]u8,s:[]u8,a:[]u8,v:[]u8,src:[]u8,rel:i32)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(192);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"fact\",\"s\":\"");
  n=app(b,n,s); n=app(b,n,"\",\"a\":\""); n=app(b,n,a);
  n=app(b,n,"\",\"v\":\""); n=app(b,n,v);
  n=app(b,n,"\",\"src\":\""); n=app(b,n,src);
  n=app(b,n,"\",\"rel\":"); n=app(b,n,i32s(rel)); n=app(b,n,"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_rel(tb:[]u8,c:[]u8,a:[]u8,r:[]u8,e2:[]u8,rel:i32)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(192);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"rel\",\"a\":\"");
  n=app(b,n,a); n=app(b,n,"\",\"r\":\""); n=app(b,n,r);
  n=app(b,n,"\",\"b\":\""); n=app(b,n,e2);
  n=app(b,n,"\",\"rel\":"); n=app(b,n,i32s(rel)); n=app(b,n,"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_cobs(tb:[]u8,c:[]u8,p:i32,q:i32,r:i32)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(128);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"cobs\",\"P\":");
  n=app(b,n,i32s(p)); n=app(b,n,",\"Q\":"); n=app(b,n,i32s(q));
  n=app(b,n,",\"R\":"); n=app(b,n,i32s(r)); n=app(b,n,"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_demo(tb:[]u8,c:[]u8,pr:[]u8,in:[]u8,out:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(192);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"demo\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\",\"in\":\""); n=app(b,n,in);
  n=app(b,n,"\",\"out\":\""); n=app(b,n,out); n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_claim(tb:[]u8,c:[]u8,h:[]u8,w:i32)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(128);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"claim\",\"h\":\"");
  n=app(b,n,h); n=app(b,n,"\",\"w\":"); n=app(b,n,i32s(w)); n=app(b,n,"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_vocab(tb:[]u8,c:[]u8,w:[]u8,g:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(128);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"vocab\",\"w\":\"");
  n=app(b,n,w); n=app(b,n,"\",\"g\":\""); n=app(b,n,g); n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_law(tb:[]u8,c:[]u8,pr:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"law\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_noise(tb:[]u8,c:[]u8,st:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"noise\",\"pad\":\"");
  let i:i32=0;
  while(i<24){b[n]=(97+rnd(st,26)) as u8;n=n+1;i=i+1;}
  n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_query(tb:[]u8,kb:[]u8,c:[]u8,qid:[]u8,qbody:[]u8,ans:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(320);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"query\",\"qid\":\""); n=app(b,n,qid);
  n=app(b,n,"\",\"q\":"); n=app(b,n,qbody); n=app(b,n,"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  keyq(kb,c,qid,ans);
  return;
}
fn e_act(tb:[]u8,c:[]u8,qid:[]u8,about:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(320);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"act\",\"qid\":\""); n=app(b,n,qid);
  n=app(b,n,"\",\"budget\":3,\"about\":"); n=app(b,n,about); n=app(b,n,"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_save(tb:[]u8,c:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"save\"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_load(tb:[]u8,c:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"load\"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_end(tb:[]u8,c:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"end\"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
// qbody builders (returned buffers are caller-owned)
fn qb_attr(s:[]u8,a:[]u8)[]u8 {
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"t\":\"attr\",\"s\":\"");
  n=app(b,n,s); n=app(b,n,"\",\"a\":\""); n=app(b,n,a); n=app(b,n,"\"}");
  return b[0..n];
}
fn qb_yn(h1:[]u8,h2:[]u8)[]u8 {
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"t\":\"yn\",\"h1\":\"");
  n=app(b,n,h1); n=app(b,n,"\",\"h2\":\""); n=app(b,n,h2); n=app(b,n,"\"}");
  return b[0..n];
}
fn qb_meaning(w:[]u8)[]u8 {
  let b:[]u8=z_alloc(48);
  let n:i32=app(b,0,"{\"t\":\"meaning\",\"w\":\"");
  n=app(b,n,w); n=app(b,n,"\"}");
  return b[0..n];
}
fn qb_causal(dov:[]u8,dovv:i32,askv:[]u8)[]u8 {
  let b:[]u8=z_alloc(80);
  let n:i32=app(b,0,"{\"t\":\"causal\",\"do\":\"");
  n=app(b,n,dov); n=app(b,n,"\",\"val\":"); n=app(b,n,i32s(dovv));
  n=app(b,n,",\"ask\":\""); n=app(b,n,askv); n=app(b,n,"\"}");
  return b[0..n];
}
fn qb_proc(pr:[]u8,in:[]u8)[]u8 {
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"t\":\"proc\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\",\"in\":\""); n=app(b,n,in); n=app(b,n,"\"}");
  return b[0..n];
}
fn qid2(pfx:[]u8,n:i32)[]u8 {
  let b:[]u8=z_alloc(16);
  let k:i32=app(b,0,pfx);
  k=app(b,k,i32s(n));
  return b[0..k];
}
fn qb_chain3(a:[]u8,r1:[]u8,r2:[]u8,r3:[]u8,nrs:i32)[]u8 {
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"t\":\"chain\",\"a\":\"");
  n=app(b,n,a); n=app(b,n,"\",\"rs\":[\"");
  n=app(b,n,r1);
  if(nrs>1){n=app(b,n,"\",\""); n=app(b,n,r2);}
  if(nrs>2){n=app(b,n,"\",\""); n=app(b,n,r3);}
  n=app(b,n,"\"]}");
  return b[0..n];
}
// Stage A: 20 one-shot facts + immediate queries. Stores first (e,a) into kab.
// fact_used is a shared 80-byte table (10*8) marked for all taught (e,a).
fn stage_a(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,vals:[]u8,ent_attr:[]u8,kab:[]u8,fact_used:[]u8)void {
  let i:i32=0;
  let done:i32=0;
  while(done<20){
    let e:i32=rnd(st,10);
    let a:i32=rnd(st,8);
    if(fact_used[e*8+a]==0){
      fact_used[e*8+a]=1;
      let vi:i32=ent_attr[e*8+a] as i32;
      let v:[]u8=aval(vals,a,vi);
      e_fact(tb,c,ename(ents,e),aname(attrs,a),v,"teach",50);
      let qb:[]u8=qb_attr(ename(ents,e),aname(attrs,a));
      e_query(tb,kb,c,qid2("A",done+1),qb,v);
      if(done==0){st32(kab,0,e);st32(kab,4,a);}
      done=done+1;
    }
    i=i+1;
    if(i>2000){done=20;}
  }
  return;
}
// Stage B: 8 chains (6 two-hop, 2 three-hop). Stores first chain into kbb (e1,r1,r2,e3).
// er_used is a shared 60-byte table (10*6) of used (entity,rel) edge starts.
fn stage_b(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,rels:[]u8,kbb:[]u8,er_used:[]u8)void {
  let ci:i32=0;
  while(ci<8){
    let hops:i32=2;
    if(ci>=6){hops=3;}
    // pick distinct entities
    let e1:i32=rnd(st,10);
    let e2:i32=rnd(st,10);
    let e3:i32=rnd(st,10);
    let e4:i32=rnd(st,10);
    if(e2==e1 || e3==e1 || e3==e2){continue;}
    if(hops==3 && (e4==e1 || e4==e2 || e4==e3)){continue;}
    let r1:i32=rnd(st,6);
    let r2:i32=rnd(st,6);
    let r3:i32=rnd(st,6);
    if(er_used[e1*6+r1]==1 || er_used[e2*6+r2]==1){continue;}
    if(hops==3 && er_used[e3*6+r3]==1){continue;}
    er_used[e1*6+r1]=1;
    er_used[e2*6+r2]=1;
    if(hops==3){er_used[e3*6+r3]=1;}
    e_rel(tb,c,ename(ents,e1),rname(rels,r1),ename(ents,e2),50);
    e_rel(tb,c,ename(ents,e2),rname(rels,r2),ename(ents,e3),50);
    let eend:i32=e3;
    if(hops==3){
      e_rel(tb,c,ename(ents,e3),rname(rels,r3),ename(ents,e4),50);
      eend=e4;
    }
    let qb:[]u8=qb_chain3(ename(ents,e1),rname(rels,r1),rname(rels,r2),rname(rels,r3),hops);
    e_query(tb,kb,c,qid2("B",ci+1),qb,ename(ents,eend));
    if(ci==0){st32(kbb,0,e1);st32(kbb,4,r1);st32(kbb,8,r2);st32(kbb,12,eend);}
    ci=ci+1;
  }
  return;
}
// Stage C: corrections. Stores delayed (e,a) into cdb. Marks fact_used.
fn stage_c(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,vals:[]u8,ent_attr:[]u8,cdb:[]u8,fact_used:[]u8)void {
  let ci:i32=0;
  while(ci<3){
    let e:i32=rnd(st,10);
    let a:i32=rnd(st,8);
    fact_used[e*8+a]=1;
    let vt:i32=ent_attr[e*8+a] as i32;
    let vw:i32=(vt+1)%4;
    if(vw==vt){vw=(vt+2)%4;}
    e_fact(tb,c,ename(ents,e),aname(attrs,a),aval(vals,a,vw),"teach",40);
    e_fact(tb,c,ename(ents,e),aname(attrs,a),aval(vals,a,vt),"correction",80);
    let qb:[]u8=qb_attr(ename(ents,e),aname(attrs,a));
    e_query(tb,kb,c,qid2("C",ci+1),qb,aval(vals,a,vt));
    ci=ci+1;
  }
  // delayed correction: obs now, query after stage D
  let e:i32=rnd(st,10);
  let a:i32=rnd(st,8);
  fact_used[e*8+a]=1;
  let vt:i32=ent_attr[e*8+a] as i32;
  let vw:i32=(vt+1)%4;
  if(vw==vt){vw=(vt+2)%4;}
  e_fact(tb,c,ename(ents,e),aname(attrs,a),aval(vals,a,vw),"teach",40);
  e_fact(tb,c,ename(ents,e),aname(attrs,a),aval(vals,a,vt),"correction",80);
  st32(cdb,0,e); st32(cdb,4,a);
  // collateral: same entity, different attr, queried (unaffected)
  let a2:i32=(a+1)%8;
  fact_used[e*8+a2]=1;
  let v2:i32=ent_attr[e*8+a2] as i32;
  e_fact(tb,c,ename(ents,e),aname(attrs,a2),aval(vals,a2,v2),"teach",50);
  let qb2:[]u8=qb_attr(ename(ents,e),aname(attrs,a2));
  e_query(tb,kb,c,qid2("C",5),qb2,aval(vals,a2,v2));
  let e3:i32=rnd(st,10);
  let a3:i32=rnd(st,8);
  fact_used[e3*8+a3]=1;
  let v3:i32=ent_attr[e3*8+a3] as i32;
  e_fact(tb,c,ename(ents,e3),aname(attrs,a3),aval(vals,a3,v3),"teach",50);
  let qb3:[]u8=qb_attr(ename(ents,e3),aname(attrs,a3));
  e_query(tb,kb,c,qid2("C",6),qb3,aval(vals,a3,v3));
  return;
}
fn stage_c_delayed(tb:[]u8,kb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,vals:[]u8,ent_attr:[]u8,cdb:[]u8)void {
  let e:i32=ld32(cdb,0);
  let a:i32=ld32(cdb,4);
  let vt:i32=ent_attr[e*8+a] as i32;
  let qb:[]u8=qb_attr(ename(ents,e),aname(attrs,a));
  e_query(tb,kb,c,qid2("C",4),qb,aval(vals,a,vt));
  return;
}
// Stage D: contradictions. hid pool per pair.
fn stage_d(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8)void {
  let ids:[]u8=z_alloc(24);
  // pair ids: "d1a","d1b","d2a","d2b","d3a","d3b"
  let k:i32=0;
  let p:i32=1;
  while(p<=3){
    ids[k]=100; ids[k+1]=(48+p) as u8; ids[k+2]=97; k=k+3;
    ids[k]=100; ids[k+1]=(48+p) as u8; ids[k+2]=98; k=k+3;
    p=p+1;
  }
  let i:i32=0;
  while(i<3){
    let ha:[]u8=ids[i*6..i*6+3];
    let hb:[]u8=ids[i*6+3..i*6+6];
    e_claim(tb,c,ha,2);
    e_claim(tb,c,hb,2);
    let qb:[]u8=qb_yn(ha,hb);
    e_query(tb,kb,c,qid2("D",i+1),qb,"UNRESOLVED");
    i=i+1;
  }
  // discriminating evidence: D4 -> d1a wins; D5 -> d2b wins; D6 -> d3a wins
  e_claim(tb,c,ids[0..3],2);
  let q4:[]u8=qb_yn(ids[0..3],ids[3..6]);
  e_query(tb,kb,c,qid2("D",4),q4,ids[0..3]);
  e_claim(tb,c,ids[9..12],2);
  let q5:[]u8=qb_yn(ids[6..9],ids[9..12]);
  e_query(tb,kb,c,qid2("D",5),q5,ids[9..12]);
  e_claim(tb,c,ids[12..15],2);
  let q6:[]u8=qb_yn(ids[12..15],ids[15..18]);
  e_query(tb,kb,c,qid2("D",6),q6,ids[12..15]);
  z_free(ids);
  return;
}
// ---- string transforms for procedure demos ----
fn wg_rev(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[s.len-1-i];i=i+1;}
  return b;
}
fn wg_rot(s:[]u8,k:i32)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[(i+k)%s.len];i=i+1;}
  return b;
}
// Stage E: vocab + compose
fn stage_e(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,vwords:[]u8,vgnd:[]u8)void {
  let i:i32=0;
  while(i<6){
    e_vocab(tb,c,vw(vwords,i),vg(vgnd,i));
    i=i+1;
  }
  i=0;
  while(i<6){
    let qb:[]u8=qb_meaning(vw(vwords,i));
    e_query(tb,kb,c,qid2("E",i+1),qb,vg(vgnd,i));
    i=i+1;
  }
  // E7: compose w0 w1 ; E8: compose w2 w3 w4
  let b7:[]u8=z_alloc(64);
  let n:i32=app(b7,0,"{\"t\":\"compose\",\"words\":[\"");
  n=app(b7,n,vw(vwords,0)); n=app(b7,n,"\",\""); n=app(b7,n,vw(vwords,1)); n=app(b7,n,"\"]}");
  let a7:[]u8=z_alloc(16);
  let m:i32=app(a7,0,vg(vgnd,0)); m=app(a7,m," "); m=app(a7,m,vg(vgnd,1));
  e_query(tb,kb,c,qid2("E",7),b7[0..n],a7[0..m]);
  let b8:[]u8=z_alloc(80);
  n=app(b8,0,"{\"t\":\"compose\",\"words\":[\"");
  n=app(b8,n,vw(vwords,2)); n=app(b8,n,"\",\""); n=app(b8,n,vw(vwords,3));
  n=app(b8,n,"\",\""); n=app(b8,n,vw(vwords,4)); n=app(b8,n,"\"]}");
  let a8:[]u8=z_alloc(24);
  m=app(a8,0,vg(vgnd,2)); m=app(a8,m," "); m=app(a8,m,vg(vgnd,3)); m=app(a8,m," "); m=app(a8,m,vg(vgnd,4));
  e_query(tb,kb,c,qid2("E",8),b8[0..n],a8[0..m]);
  return;
}
// Stage F: active inquiry. Withheld items go to wb keyed by qid.
fn stage_f(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,rels:[]u8,vals:[]u8,ent_attr:[]u8,fact_used:[]u8,er_used:[]u8)void {
  // F1, F2: withheld facts on never-taught (e,a)
  let f:i32=1;
  while(f<=2){
    let e:i32=0;
    let a:i32=0;
    let tries:i32=0;
    let ok:i32=0;
    while(ok==0 && tries<500){
      e=rnd(st,10); a=rnd(st,8); tries=tries+1;
      if(fact_used[e*8+a]==0){ok=1;}
    }
    fact_used[e*8+a]=1;
    let vi:i32=ent_attr[e*8+a] as i32;
    let v:[]u8=aval(vals,a,vi);
    let qid:[]u8=qid2("F",f);
    let obj:[]u8=z_alloc(96);
    let n:i32=app(obj,0,"{\"t\":\"fact\",\"s\":\"");
    n=app(obj,n,ename(ents,e)); n=app(obj,n,"\",\"a\":\""); n=app(obj,n,aname(attrs,a));
    n=app(obj,n,"\",\"v\":\""); n=app(obj,n,v); n=app(obj,n,"\"}");
    keyw(wb,c,qid,obj[0..n]);
    z_free(obj);
    let about:[]u8=qb_attr(ename(ents,e),aname(attrs,a));
    e_act(tb,c,qid,about);
    e_query(tb,kb,c,qid,qb_attr(ename(ents,e),aname(attrs,a)),v);
    f=f+1;
  }
  // F3: chain with first edge withheld
  let e1:i32=0; let e2:i32=0; let e3:i32=0; let r1:i32=0; let r2:i32=0;
  let ok2:i32=0;
  let tries2:i32=0;
  while(ok2==0 && tries2<500){
    tries2=tries2+1;
    e1=rnd(st,10); e2=rnd(st,10); e3=rnd(st,10);
    r1=rnd(st,6); r2=rnd(st,6);
    if(e1!=e2 && e2!=e3 && e1!=e3 && er_used[e1*6+r1]==0 && er_used[e2*6+r2]==0){ok2=1;}
  }
  er_used[e1*6+r1]=1;
  er_used[e2*6+r2]=1;
  e_rel(tb,c,ename(ents,e2),rname(rels,r2),ename(ents,e3),50);
  let obj3:[]u8=z_alloc(96);
  let n3:i32=app(obj3,0,"{\"t\":\"rel\",\"a\":\"");
  n3=app(obj3,n3,ename(ents,e1)); n3=app(obj3,n3,"\",\"r\":\""); n3=app(obj3,n3,rname(rels,r1));
  n3=app(obj3,n3,"\",\"b\":\""); n3=app(obj3,n3,ename(ents,e2)); n3=app(obj3,n3,"\"}");
  keyw(wb,c,"F3",obj3[0..n3]);
  z_free(obj3);
  let about3:[]u8=qb_chain3(ename(ents,e1),rname(rels,r1),rname(rels,r2),rname(rels,r2),2);
  e_act(tb,c,"F3",about3);
  let q3:[]u8=qb_chain3(ename(ents,e1),rname(rels,r1),rname(rels,r2),rname(rels,r2),2);
  e_query(tb,kb,c,"F3",q3,ename(ents,e3));
  return;
}
// causal sim for the true graph; out is 12 bytes (p,q,r)
fn gsim(tg:i32,bp:i32,bq:i32,br:i32,dv:i32,vv:i32,out:[]u8)void {
  let p:i32=bp; let q:i32=bq; let r:i32=br;
  if(dv==0){p=vv;}
  if(dv==1){q=vv;}
  if(dv==2){r=vv;}
  if(tg==0){
    if(dv!=1){q=p;}
    if(dv!=2){r=q;}
  }
  if(tg==1){
    if(dv!=2){r=p;}
    if(dv!=1){q=r;}
  }
  if(tg==2){
    if(dv!=0){p=q;}
    if(dv!=2){r=p;}
  }
  st32(out,0,p); st32(out,4,q); st32(out,8,r);
  return;
}
// Stage G: causal. Stores true graph into tgb. Baseline tracked in bl (12 bytes).
fn stage_g(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,tgb:[]u8,bl:[]u8)void {
  let tg:i32=rnd(st,3);
  st32(tgb,0,tg);
  st32(bl,0,0); st32(bl,4,0); st32(bl,8,0);
  let out:[]u8=z_alloc(12);
  let i:i32=0;
  while(i<2){
    let dv:i32=rnd(st,3);
    let vv:i32=rnd(st,2);
    gsim(tg,ld32(bl,0),ld32(bl,4),ld32(bl,8),dv,vv,out);
    e_cobs(tb,c,ld32(out,0),ld32(out,4),ld32(out,8));
    st32(bl,0,ld32(out,0)); st32(bl,4,ld32(out,4)); st32(bl,8,ld32(out,8));
    i=i+1;
  }
  z_free(out);
  // act about the upcoming G1 query; runner re-issues until done/budget out
  let dvn:[]u8="P";
  let askv:[]u8="R";
  let about:[]u8=qb_causal(dvn,1,askv);
  e_act(tb,c,"G0",about);
  let q1:[]u8=qb_causal("P",1,"R");
  e_query(tb,kb,c,"G1",q1,"DYNAMIC");
  let q2:[]u8=qb_causal("Q",0,"P");
  e_query(tb,kb,c,"G2",q2,"DYNAMIC");
  return;
}
// Stage H: procedures. pa=reversal, pb=rotation(k). Stores k into hkb.
fn stage_h(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,procs:[]u8,hkb:[]u8)void {
  let pa:[]u8=pname(procs,0);
  let pb:[]u8=pname(procs,1);
  // pa: reversal demos (letters a-m)
  let d:i32=0;
  while(d<3){
    let inw:[]u8=z_alloc(4);
    let k:i32=0;
    while(k<4){inw[k]=(97+rnd(st,13)) as u8;k=k+1;}
    let outw:[]u8=wg_rev(inw);
    e_demo(tb,c,pa,inw,outw);
    z_free(inw); z_free(outw);
    d=d+1;
  }
  // H1: fresh letters n-z
  let t1:[]u8=z_alloc(5);
  let k2:i32=0;
  while(k2<5){t1[k2]=(110+rnd(st,13)) as u8;k2=k2+1;}
  let o1:[]u8=wg_rev(t1);
  e_query(tb,kb,c,"H1",qb_proc(pa,t1),o1);
  z_free(t1); z_free(o1);
  // H2: changed surface (uppercase)
  let t2:[]u8=z_alloc(5);
  k2=0;
  while(k2<5){t2[k2]=(65+rnd(st,13)) as u8;k2=k2+1;}
  let o2:[]u8=wg_rev(t2);
  e_query(tb,kb,c,"H2",qb_proc(pa,t2),o2);
  z_free(t2); z_free(o2);
  // pb: rotation by k in 1..3
  let kk:i32=1+rnd(st,3);
  st32(hkb,0,kk);
  d=0;
  while(d<3){
    let inw:[]u8=z_alloc(4);
    let k:i32=0;
    while(k<4){inw[k]=(97+rnd(st,13)) as u8;k=k+1;}
    let outw:[]u8=wg_rot(inw,kk);
    e_demo(tb,c,pb,inw,outw);
    z_free(inw); z_free(outw);
    d=d+1;
  }
  // H3: fresh letters n-z
  let t3:[]u8=z_alloc(4);
  k2=0;
  while(k2<4){t3[k2]=(110+rnd(st,13)) as u8;k2=k2+1;}
  let o3:[]u8=wg_rot(t3,kk);
  e_query(tb,kb,c,"H3",qb_proc(pb,t3),o3);
  z_free(t3); z_free(o3);
  // H4: changed surface (digits)
  let t4:[]u8=z_alloc(4);
  k2=0;
  while(k2<4){t4[k2]=(48+rnd(st,10)) as u8;k2=k2+1;}
  let o4:[]u8=wg_rot(t4,kk);
  e_query(tb,kb,c,"H4",qb_proc(pb,t4),o4);
  z_free(t4); z_free(o4);
  return;
}
// Stage I: transfer with examples-to-criterion
fn stage_i(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,tents:[]u8,trel:[]u8)void {
  // T1: 2 teaching examples, novel entities + novel relation, 2-hop chain
  let n0:[]u8=tname(tents,0);
  let n1:[]u8=tname(tents,1);
  let n2:[]u8=tname(tents,2);
  e_rel(tb,c,n0,trel,n1,60);
  e_rel(tb,c,n1,trel,n2,60);
  let q1:[]u8=qb_chain3(n0,trel,trel,trel,2);
  e_query(tb,kb,c,"T1",q1,n2);
  // T2: 1 teaching example, 1-hop
  let m0:[]u8=tname(tents,3);
  e_rel(tb,c,m0,trel,n1,60);
  let q2:[]u8=qb_chain3(m0,trel,trel,trel,1);
  e_query(tb,kb,c,"T2",q2,n1);
  return;
}
// Stage J: 2000 unrelated interference observations
fn stage_j(st:[]u8,tb:[]u8,c:[]u8)void {
  let j:i32=0;
  while(j<2000){
    e_noise(tb,c,st);
    j=j+1;
  }
  return;
}
// Stage K: restart persistence + retention queries
fn stage_k(tb:[]u8,kb:[]u8,c:[]u8,ents:[]u8,attrs:[]u8,rels:[]u8,vals:[]u8,ent_attr:[]u8,kab:[]u8,kbb:[]u8)void {
  e_save(tb,c);
  e_load(tb,c);
  let e:i32=ld32(kab,0);
  let a:i32=ld32(kab,4);
  let vi:i32=ent_attr[e*8+a] as i32;
  e_query(tb,kb,c,"K1",qb_attr(ename(ents,e),aname(attrs,a)),aval(vals,a,vi));
  let e1:i32=ld32(kbb,0);
  let r1:i32=ld32(kbb,4);
  let r2:i32=ld32(kbb,8);
  let eend:i32=ld32(kbb,12);
  e_query(tb,kb,c,"K2",qb_chain3(ename(ents,e1),rname(rels,r1),rname(rels,r2),rname(rels,r1),2),ename(ents,eend));
  return;
}
// Stage L: changed law for pb + retention of pa
fn stage_l(st:[]u8,tb:[]u8,kb:[]u8,wb:[]u8,c:[]u8,procs:[]u8,hkb:[]u8)void {
  let pa:[]u8=pname(procs,0);
  let pb:[]u8=pname(procs,1);
  let kold:i32=ld32(hkb,0);
  let k2:i32=1+rnd(st,3);
  if(k2==kold){k2=kold%3+1;}
  e_law(tb,c,pb);
  let d:i32=0;
  while(d<2){
    let inw:[]u8=z_alloc(4);
    let k:i32=0;
    while(k<4){inw[k]=(97+rnd(st,13)) as u8;k=k+1;}
    let outw:[]u8=wg_rot(inw,k2);
    e_demo(tb,c,pb,inw,outw);
    z_free(inw); z_free(outw);
    d=d+1;
  }
  let t1:[]u8=z_alloc(4);
  let k:i32=0;
  while(k<4){t1[k]=(110+rnd(st,13)) as u8;k=k+1;}
  let o1:[]u8=wg_rot(t1,k2);
  e_query(tb,kb,c,"L1",qb_proc(pb,t1),o1);
  z_free(t1); z_free(o1);
  // L2: pa retention (unaffected context)
  let t2:[]u8=z_alloc(5);
  k=0;
  while(k<5){t2[k]=(97+rnd(st,13)) as u8;k=k+1;}
  let o2:[]u8=wg_rev(t2);
  e_query(tb,kb,c,"L2",qb_proc(pa,t2),o2);
  z_free(t2); z_free(o2);
  return;
}
fn main()i32 {
  let seedfile:[]u8=_zag_arg(1);
  let worldidx:i32=atoi(_zag_arg(2));
  let outdir:[]u8=_zag_arg(3);
  let seedhash:[]u8=_zag_arg(4);
  if(seedfile.len==0 || outdir.len==0 || seedhash.len==0){
    return 1;
  }
  let seed:[]u8=read_file(seedfile);
  if(seed.len<8){return 2;}
  let st:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<8){st[i]=seed[i];i=i+1;}
  // mix worldidx
  let w:i32=worldidx+1;
  i=0;
  while(i<8){
    let x:i32=st[i] as i32;
    let y:i32=(w*31+i*7)&255;
    let z:i32=x^y;
    st[i]=z as u8;
    i=i+1;
  }
  i=0;
  while(i<8){r64(st);i=i+1;}
  // ---- tables ----
  let used2:[]u8=z_alloc(64); // shared 2-letter namespace
  let nu2:i32=0;
  let tmp:[]u8=z_alloc(4);
  let ents:[]u8=z_alloc(20);
  i=0;
  while(i<10){
    fresh_name(st,used2,nu2,2,tmp);
    ents[i*2]=tmp[0]; ents[i*2+1]=tmp[1];
    used2[nu2*2]=tmp[0]; used2[nu2*2+1]=tmp[1]; nu2=nu2+1;
    i=i+1;
  }
  let procs:[]u8=z_alloc(4);
  i=0;
  while(i<2){
    fresh_name(st,used2,nu2,2,tmp);
    procs[i*2]=tmp[0]; procs[i*2+1]=tmp[1];
    used2[nu2*2]=tmp[0]; used2[nu2*2+1]=tmp[1]; nu2=nu2+1;
    i=i+1;
  }
  let tents:[]u8=z_alloc(8);
  i=0;
  while(i<4){
    fresh_name(st,used2,nu2,2,tmp);
    tents[i*2]=tmp[0]; tents[i*2+1]=tmp[1];
    used2[nu2*2]=tmp[0]; used2[nu2*2+1]=tmp[1]; nu2=nu2+1;
    i=i+1;
  }
  let used3:[]u8=z_alloc(96); // shared 3-letter namespace
  let nu3:i32=0;
  let attrs:[]u8=z_alloc(24);
  i=0;
  while(i<8){
    fresh_name(st,used3,nu3,3,tmp);
    attrs[i*3]=tmp[0]; attrs[i*3+1]=tmp[1]; attrs[i*3+2]=tmp[2];
    used3[nu3*3]=tmp[0]; used3[nu3*3+1]=tmp[1]; used3[nu3*3+2]=tmp[2]; nu3=nu3+1;
    i=i+1;
  }
  let rels:[]u8=z_alloc(18);
  i=0;
  while(i<6){
    fresh_name(st,used3,nu3,3,tmp);
    rels[i*3]=tmp[0]; rels[i*3+1]=tmp[1]; rels[i*3+2]=tmp[2];
    used3[nu3*3]=tmp[0]; used3[nu3*3+1]=tmp[1]; used3[nu3*3+2]=tmp[2]; nu3=nu3+1;
    i=i+1;
  }
  let vgnd:[]u8=z_alloc(18);
  i=0;
  while(i<6){
    fresh_name(st,used3,nu3,3,tmp);
    vgnd[i*3]=tmp[0]; vgnd[i*3+1]=tmp[1]; vgnd[i*3+2]=tmp[2];
    used3[nu3*3]=tmp[0]; used3[nu3*3+1]=tmp[1]; used3[nu3*3+2]=tmp[2]; nu3=nu3+1;
    i=i+1;
  }
  let trel:[]u8=z_alloc(3);
  fresh_name(st,used3,nu3,3,tmp);
  trel[0]=tmp[0]; trel[1]=tmp[1]; trel[2]=tmp[2];
  let used4:[]u8=z_alloc(48);
  let vwords:[]u8=z_alloc(24);
  i=0;
  while(i<6){
    fresh_name(st,used4,i,4,tmp);
    vwords[i*4]=tmp[0]; vwords[i*4+1]=tmp[1]; vwords[i*4+2]=tmp[2]; vwords[i*4+3]=tmp[3];
    used4[i*4]=tmp[0]; used4[i*4+1]=tmp[1]; used4[i*4+2]=tmp[2]; used4[i*4+3]=tmp[3];
    i=i+1;
  }
  let vals:[]u8=z_alloc(64);
  let vu:[]u8=z_alloc(8);
  let a:i32=0;
  while(a<8){
    let k:i32=0;
    while(k<8){vu[k]=0;k=k+1;}
    let v:i32=0;
    while(v<4){
      fresh_name(st,vu,v,2,tmp);
      vals[(a*4+v)*2]=tmp[0]; vals[(a*4+v)*2+1]=tmp[1];
      vu[v*2]=tmp[0]; vu[v*2+1]=tmp[1];
      v=v+1;
    }
    a=a+1;
  }
  let ent_attr:[]u8=z_alloc(80);
  i=0;
  while(i<80){ent_attr[i]=rnd(st,4) as u8;i=i+1;}
  z_free(tmp); z_free(used2); z_free(used3); z_free(used4); z_free(vu);
  // ---- buffers ----
  let tb:[]u8=z_alloc(2097152);
  let kb:[]u8=z_alloc(65536);
  let wb:[]u8=z_alloc(65536);
  let cur:[]u8=z_alloc(24);
  // brief turn (turn 0)
  let bb:[]u8=z_alloc(160);
  let bn:i32=app(bb,0,"{\"turn\":0,\"kind\":\"brief\",\"world\":\"w");
  bn=app(bb,bn,i32s(worldidx));
  bn=app(bb,bn,"\",\"seed_hash\":\"");
  bn=app(bb,bn,seedhash);
  bn=app(bb,bn,"\"}");
  st32(cur,0,bn+1);
  app(tb,0,bb[0..bn]);
  tb[bn]=10;
  z_free(bb);
  st32(cur,12,1); // next turn = 1
  // shared tables
  let fact_used:[]u8=z_alloc(80);
  let er_used:[]u8=z_alloc(60);
  let kab:[]u8=z_alloc(8);
  let kbb:[]u8=z_alloc(16);
  let cdb:[]u8=z_alloc(8);
  let tgb:[]u8=z_alloc(4);
  let bl:[]u8=z_alloc(12);
  let hkb:[]u8=z_alloc(4);
  stage_a(st,tb,kb,wb,cur,ents,attrs,vals,ent_attr,kab,fact_used);
  stage_b(st,tb,kb,wb,cur,ents,attrs,rels,kbb,er_used);
  stage_c(st,tb,kb,wb,cur,ents,attrs,vals,ent_attr,cdb,fact_used);
  stage_d(st,tb,kb,wb,cur);
  stage_c_delayed(tb,kb,cur,ents,attrs,vals,ent_attr,cdb);
  stage_e(st,tb,kb,wb,cur,vwords,vgnd);
  stage_f(st,tb,kb,wb,cur,ents,attrs,rels,vals,ent_attr,fact_used,er_used);
  stage_g(st,tb,kb,wb,cur,tgb,bl);
  stage_h(st,tb,kb,wb,cur,procs,hkb);
  stage_i(st,tb,kb,wb,cur,tents,trel);
  stage_j(st,tb,cur);
  stage_k(tb,kb,cur,ents,attrs,rels,vals,ent_attr,kab,kbb);
  stage_l(st,tb,kb,wb,cur,procs,hkb);
  e_end(tb,cur);
  // ---- assemble key.json ----
  let kat:i32=ld32(cur,4);
  let wat:i32=ld32(cur,8);
  let kf:[]u8=z_alloc(131072);
  let kn:i32=app(kf,0,"{\"seed_hash\":\"");
  kn=app(kf,kn,seedhash);
  kn=app(kf,kn,"\",\"world\":");
  kn=app(kf,kn,i32s(worldidx));
  kn=app(kf,kn,",\"true_graph\":");
  kn=app(kf,kn,i32s(ld32(tgb,0)));
  kn=app(kf,kn,",\"transfer\":{\"T1\":{\"examples\":2},\"T2\":{\"examples\":1}}");
  kn=app(kf,kn,",\"queries\":{");
  kn=app(kf,kn,kb[0..kat]);
  kn=app(kf,kn,"},\"withheld\":{");
  kn=app(kf,kn,wb[0..wat]);
  kn=app(kf,kn,"}}");
  write_file(pjoin(outdir,"turns.jsonl"),tb[0..ld32(cur,0)]);
  write_file(pjoin(outdir,"key.json"),kf[0..kn]);
  return 0;
}

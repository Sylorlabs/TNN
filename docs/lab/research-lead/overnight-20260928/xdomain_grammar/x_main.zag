// x_main.zag -- Cross-domain grammar-as-constraint experiment.
// X = induced grammar (divisor D + literal range [lo,hi], induced per
//   the grammar_codec method from taught SUB/DSUB/DIV/DDIV facts).
// Y = grammar-blind composition: assemble an encoded 2-word sentence
//   from two source literal pairs, searching over fixed encoding
//   hypotheses h in {8,16,32} and all partitions/orders.
// Z = the composed sentence, which must satisfy the grammar.
// Question: does learned knowledge automatically constrain
// generation, or sit inert unless consulted through a channel?
// Arms: 0 = no channel (blind pick over all candidates);
//       1 = generic channel (blind pick over reg_check survivors).
// Separate fidelity probe (its own section): clause check vs
// independent direct check on every candidate.
// Pure Zag. Deterministic: fixed worlds, fixed trial pools, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ SECTION: generic machinery (alloc, cells, emit) ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn igcd(a:i32,b:i32)i32 {
  let x:i32=a; let y:i32=b;
  while(y!=0){ let t:i32=x%y; x=y; y=t; }
  return x;
}

// ============ SECTION: generic constraint registry ============
// Domain-neutral clause ABI. A clause is (field, xform, k, lo, hi):
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
// The registry knows nothing about pairs, codecs, or grammars.
// Learner-state cells: 10=nfields, 11=nclauses, 12..=clauses (5 each).

fn reg_clause(S:[]u8,i:i32,field:i32,xform:i32,k:i32,lo:i32,hi:i32)void {
  let b:i32=12+i*5;
  ss(S,b,field); ss(S,b+1,xform); ss(S,b+2,k); ss(S,b+3,lo); ss(S,b+4,hi);
  return;
}
fn reg_check(S:[]u8,cb:i32,nf:i32)i32 {
  if(nf!=sg(S,10)){return 0;}
  let n:i32=sg(S,11);
  let i:i32=0;
  while(i<n){
    let b:i32=12+i*5;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=sg(S,cb+1+field);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ SECTION: grammar induction (grammar_codec method) ============
// Teacher: literals {1,3,5,7}, true divisor D0. Facts: SUB (P,41,t) and
// DSUB (t,43,P) for all 16 literal pairs, DIV-unit (P,42,1) and
// DDIV-unit (1,44,P) for the 4 diagonal pairs. Induction: g = gcd of
// the positive multiple set; candidates d = v-1 for v|g, v>=2;
// op-consistency per candidate; unique survivor is D. Ranges from
// decoded SUB components. Cells: 0=D,1=lo,2=hi,3=flag,
// 100..=facts(3 each), 220=nfacts, 500..=scratch.

fn lit(i:i32)i32 {
  if(i==0){return 1;}
  if(i==1){return 3;}
  if(i==2){return 5;}
  return 7;
}
fn fact_set(S:[]u8,n:i32,x:i32,r:i32,y:i32)void {
  ss(S,100+n*3,x); ss(S,100+n*3+1,r); ss(S,100+n*3+2,y);
  return;
}
fn teach(S:[]u8,D0:i32)void {
  let n:i32=0;
  let ai:i32=0;
  while(ai<4){
    let a:i32=lit(ai);
    let bi:i32=0;
    while(bi<4){
      let b:i32=lit(bi);
      let P:i32=D0*a+b;
      let t:i32=a-b;
      fact_set(S,n,P,41,t); n=n+1;
      fact_set(S,n,t,43,P); n=n+1;
      bi=bi+1;
    }
    ai=ai+1;
  }
  let di:i32=0;
  while(di<4){
    let da:i32=lit(di);
    let dP:i32=D0*da+da;
    fact_set(S,n,dP,42,1); n=n+1;
    fact_set(S,n,1,44,dP); n=n+1;
    di=di+1;
  }
  ss(S,220,n);
  return;
}
fn op_ok(S:[]u8,d:i32)i32 {
  let nf:i32=sg(S,220);
  let fi:i32=0;
  while(fi<nf){
    let x:i32=sg(S,100+fi*3);
    let r:i32=sg(S,100+fi*3+1);
    let y:i32=sg(S,100+fi*3+2);
    if(r==41){
      let aa:i32=x/d; let bb:i32=x-aa*d;
      if(aa-bb!=y){return 0;}
    }
    if(r==42){
      let aa2:i32=x/d; let bb2:i32=x-aa2*d;
      if(bb2<=0){return 0;}
      if(aa2-(aa2/bb2)*bb2!=0){return 0;}
      if(aa2/bb2!=y){return 0;}
    }
    fi=fi+1;
  }
  return 1;
}
fn induce(S:[]u8)i32 {
  let nf:i32=sg(S,220);
  let m:i32=0;
  let fi:i32=0;
  while(fi<nf){
    let x:i32=sg(S,100+fi*3);
    let r:i32=sg(S,100+fi*3+1);
    let y:i32=sg(S,100+fi*3+2);
    if(r==41){ if(x+y>0){ ss(S,500+m,x+y); m=m+1; } }
    if(r==43){ if(x+y>0){ ss(S,500+m,x+y); m=m+1; } }
    if(r==42){ if(x>0){ ss(S,500+m,x); m=m+1; } }
    if(r==44){ if(y>0){ ss(S,500+m,y); m=m+1; } }
    fi=fi+1;
  }
  let g:i32=0;
  let gi:i32=0;
  while(gi<m){ g=igcd(g,sg(S,500+gi)); gi=gi+1; }
  let best:i32=-1;
  let nbest:i32=0;
  let v:i32=2;
  while(v<=g){
    if(g%v==0){
      let d:i32=v-1;
      if(op_ok(S,d)==1){ best=d; nbest=nbest+1; }
    }
    v=v+1;
  }
  if(nbest!=1){ ss(S,3,0); return 0; }
  let lo:i32=999999;
  let hi:i32=-999999;
  let fj:i32=0;
  while(fj<nf){
    let x2:i32=sg(S,100+fj*3);
    let r2:i32=sg(S,100+fj*3+1);
    if(r2==41){
      let qq:i32=x2/best;
      let rr:i32=x2-qq*best;
      if(qq<lo){lo=qq;} if(qq>hi){hi=qq;}
      if(rr<lo){lo=rr;} if(rr>hi){hi=rr;}
    }
    fj=fj+1;
  }
  ss(S,0,best); ss(S,1,lo); ss(S,2,hi); ss(S,3,1);
  return 1;
}
// Compile the induced rule into generic registry clauses. The
// induction side knows only the clause ABI, not the composer.
fn compile_grammar(S:[]u8)void {
  let D:i32=sg(S,0); let lo:i32=sg(S,1); let hi:i32=sg(S,2);
  ss(S,10,2); ss(S,11,4);
  reg_clause(S,0,0,1,D,lo,hi);
  reg_clause(S,1,0,2,D,lo,hi);
  reg_clause(S,2,1,1,D,lo,hi);
  reg_clause(S,3,1,2,D,lo,hi);
  return;
}

// ============ SECTION: COMPOSER (grammar-blind) ============
// Builds candidate sentences from the trial literals (cells 700..703)
// and picks by a fixed grammar-independent rule: fewest fields first,
// then lowest field values. It never reads the induced rule and never
// calls anything but reg_check. Arm 0: pick over all candidates.
// Arm 1: pick over reg_check survivors. (The arm flag is the
// experiment-harness condition selector; generation and the pick rule
// themselves take no flags.)

fn hyp(i:i32)i32 {
  if(i==0){return 8;}
  if(i==1){return 16;}
  return 32;
}
fn Lget(S:[]u8,i:i32)i32 { return sg(S,700+i); }
fn better(nf:i32,f0:i32,f1:i32,f2:i32,bnf:i32,bf0:i32,bf1:i32,bf2:i32)i32 {
  if(nf<bnf){return 1;} if(nf>bnf){return 0;}
  if(f0<bf0){return 1;} if(f0>bf0){return 0;}
  if(f1<bf1){return 1;} if(f1>bf1){return 0;}
  if(f2<bf2){return 1;}
  return 0;
}
fn one_cand(S:[]u8,FC:[]u8,arm:i32,nf:i32,f0:i32,f1:i32,f2:i32)void {
  ss(S,300,nf); ss(S,301,f0); ss(S,302,f1); ss(S,303,f2);
  if(arm==1){
    if(reg_check(S,300,nf)==0){ return; }
    if(sg(S,814)==0 || better(nf,f0,f1,f2,sg(S,810),sg(S,811),sg(S,812),sg(S,813))==1){
      ss(S,810,nf); ss(S,811,f0); ss(S,812,f1); ss(S,813,f2); ss(S,814,1);
    }
    return;
  }
  if(better(nf,f0,f1,f2,sg(S,800),sg(S,801),sg(S,802),sg(S,803))==1){
    ss(S,800,nf); ss(S,801,f0); ss(S,802,f1); ss(S,803,f2);
  }
  return;
}
fn eval_all(S:[]u8,FC:[]u8,arm:i32)void {
  let h3:i32=0;
  while(h3<3){
    let h:i32=hyp(h3);
    let l0:i32=sg(S,700); let l1:i32=sg(S,701);
    let l2:i32=sg(S,702); let l3:i32=sg(S,703);
    one_cand(S,FC,arm,1,h*l0+l1,0,0);
    let i0:i32=0;
    while(i0<4){
      let i1:i32=i0+1;
      while(i1<4){
        let j0:i32=-1; let j1:i32=-1;
        let q:i32=0;
        while(q<4){
          if(q!=i0){ if(q!=i1){ if(j0==-1){j0=q;} else {j1=q;} } }
          q=q+1;
        }
        let s1:i32=0;
        while(s1<2){
          let s2:i32=0;
          while(s2<2){
            let w1a:i32=Lget(S,i0); let w1b:i32=Lget(S,i1);
            if(s1==1){ w1a=Lget(S,i1); w1b=Lget(S,i0); }
            let w2a:i32=Lget(S,j0); let w2b:i32=Lget(S,j1);
            if(s2==1){ w2a=Lget(S,j1); w2b=Lget(S,j0); }
            one_cand(S,FC,arm,2,h*w1a+w1b,h*w2a+w2b,0);
            s2=s2+1;
          }
          s1=s1+1;
        }
        i1=i1+1;
      }
      i0=i0+1;
    }
    one_cand(S,FC,arm,3,h*l0+l1,h*l2+l2,h*l3+l3);
    h3=h3+1;
  }
  return;
}

// ============ SECTION: fidelity probe (independent direct check) ============
// Re-derives the grammar's accept/reject straight from the induced
// rule. Used ONLY for measurement, never by the composer. Has its own
// candidate enumeration (probe_all) so the composer section keeps zero
// references to the induced rule.

fn direct_check(S:[]u8,cb:i32,nf:i32)i32 {
  if(nf!=2){return 0;}
  let D:i32=sg(S,0); let lo:i32=sg(S,1); let hi:i32=sg(S,2);
  let i:i32=0;
  while(i<nf){
    let f:i32=sg(S,cb+1+i);
    let qq:i32=f/D; let rr:i32=f-qq*D;
    if(qq<lo){return 0;} if(qq>hi){return 0;}
    if(rr<lo){return 0;} if(rr>hi){return 0;}
    i=i+1;
  }
  return 1;
}
fn probe_cand(S:[]u8,FC:[]u8,nf:i32,f0:i32,f1:i32,f2:i32)void {
  ss(S,300,nf); ss(S,301,f0); ss(S,302,f1); ss(S,303,f2);
  let dv:i32=direct_check(S,300,nf);
  let rv:i32=reg_check(S,300,nf);
  if(dv==rv){ ss(FC,0,sg(FC,0)+1); }
  ss(FC,1,sg(FC,1)+1);
  return;
}
fn probe_all(S:[]u8,FC:[]u8)void {
  let h3:i32=0;
  while(h3<3){
    let h:i32=hyp(h3);
    let l0:i32=sg(S,700); let l1:i32=sg(S,701);
    let l2:i32=sg(S,702); let l3:i32=sg(S,703);
    probe_cand(S,FC,1,h*l0+l1,0,0);
    let i0:i32=0;
    while(i0<4){
      let i1:i32=i0+1;
      while(i1<4){
        let j0:i32=-1; let j1:i32=-1;
        let q:i32=0;
        while(q<4){
          if(q!=i0){ if(q!=i1){ if(j0==-1){j0=q;} else {j1=q;} } }
          q=q+1;
        }
        let s1:i32=0;
        while(s1<2){
          let s2:i32=0;
          while(s2<2){
            let w1a:i32=Lget(S,i0); let w1b:i32=Lget(S,i1);
            if(s1==1){ w1a=Lget(S,i1); w1b=Lget(S,i0); }
            let w2a:i32=Lget(S,j0); let w2b:i32=Lget(S,j1);
            if(s2==1){ w2a=Lget(S,j1); w2b=Lget(S,j0); }
            probe_cand(S,FC,2,h*w1a+w1b,h*w2a+w2b,0);
            s2=s2+1;
          }
          s1=s1+1;
        }
        i1=i1+1;
      }
      i0=i0+1;
    }
    probe_cand(S,FC,3,h*l0+l1,h*l2+l2,h*l3+l3);
    h3=h3+1;
  }
  return;
}

// ============ SECTION: driver ============

fn pl(t:i32,i:i32)i32 {
  if(t==0){ if(i==0){return 1;} if(i==1){return 3;} if(i==2){return 5;} return 7; }
  if(t==1){ if(i==0){return 1;} if(i==1){return 1;} if(i==2){return 7;} return 7; }
  if(t==2){ if(i==0){return 3;} if(i==1){return 5;} if(i==2){return 7;} return 1; }
  if(t==3){ return 5; }
  if(t==4){ if(i==0){return 7;} if(i==1){return 3;} if(i==2){return 1;} return 5; }
  if(i==0){return 1;} if(i==1){return 7;} if(i==2){return 3;} return 5;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let FC:[]u8=z_alloc(16);
  let w:i32=0;
  let tnok:i32=0;
  let tcok:i32=0;
  while(w<2){
    let D0:i32=16;
    if(w==1){D0=8;}
    cur=e1str(OUT,cur,"XD-WORLD D0=");
    cur=e1i64(OUT,cur,D0 as i64);
    cur=e1str(OUT,cur,"\n");
    let S:[]u8=z_alloc(4096);
    teach(S,D0);
    let r:i32=induce(S);
    cur=e1str(OUT,cur,"XD-INDUCED r=");
    cur=e1i64(OUT,cur,r as i64);
    cur=e1str(OUT,cur," D=");
    cur=e1i64(OUT,cur,sg(S,0) as i64);
    cur=e1str(OUT,cur," lo=");
    cur=e1i64(OUT,cur,sg(S,1) as i64);
    cur=e1str(OUT,cur," hi=");
    cur=e1i64(OUT,cur,sg(S,2) as i64);
    cur=e1str(OUT,cur,"\n");
    compile_grammar(S);
    cur=e1str(OUT,cur,"XD-CLAUSES nfields=");
    cur=e1i64(OUT,cur,sg(S,10) as i64);
    cur=e1str(OUT,cur," nclauses=");
    cur=e1i64(OUT,cur,sg(S,11) as i64);
    cur=e1str(OUT,cur,"\n");
    let ci:i32=0;
    while(ci<4){
      let cb2:i32=12+ci*5;
      cur=e1str(OUT,cur,"XD-CLAUSE i=");
      cur=e1i64(OUT,cur,ci as i64);
      cur=e1str(OUT,cur," field=");
      cur=e1i64(OUT,cur,sg(S,cb2) as i64);
      cur=e1str(OUT,cur," xform=");
      cur=e1i64(OUT,cur,sg(S,cb2+1) as i64);
      cur=e1str(OUT,cur," k=");
      cur=e1i64(OUT,cur,sg(S,cb2+2) as i64);
      cur=e1str(OUT,cur," lo=");
      cur=e1i64(OUT,cur,sg(S,cb2+3) as i64);
      cur=e1str(OUT,cur," hi=");
      cur=e1i64(OUT,cur,sg(S,cb2+4) as i64);
      cur=e1str(OUT,cur,"\n");
      ci=ci+1;
    }
    let t:i32=0;
    while(t<6){
      let l0:i32=pl(t,0); let l1:i32=pl(t,1);
      let l2:i32=pl(t,2); let l3:i32=pl(t,3);
      ss(S,700,l0); ss(S,701,l1); ss(S,702,l2); ss(S,703,l3);
      ss(S,800,9999); ss(S,801,0); ss(S,802,0); ss(S,803,0);
      ss(S,810,9999); ss(S,811,0); ss(S,812,0); ss(S,813,0); ss(S,814,0);
      eval_all(S,FC,0);
      let nok:i32=direct_check(S,800,sg(S,800));
      eval_all(S,FC,1);
      let cok:i32=direct_check(S,810,sg(S,810));
      probe_all(S,FC);
      tnok=tnok+nok;
      tcok=tcok+cok;
      cur=e1str(OUT,cur,"XD-TRIAL w=");
      cur=e1i64(OUT,cur,w as i64);
      cur=e1str(OUT,cur," t=");
      cur=e1i64(OUT,cur,t as i64);
      cur=e1str(OUT,cur," pool=");
      cur=e1i64(OUT,cur,l0 as i64);
      cur=e1str(OUT,cur,",");
      cur=e1i64(OUT,cur,l1 as i64);
      cur=e1str(OUT,cur,",");
      cur=e1i64(OUT,cur,l2 as i64);
      cur=e1str(OUT,cur,",");
      cur=e1i64(OUT,cur,l3 as i64);
      cur=e1str(OUT,cur," N:nf=");
      cur=e1i64(OUT,cur,sg(S,800) as i64);
      cur=e1str(OUT,cur," f0=");
      cur=e1i64(OUT,cur,sg(S,801) as i64);
      cur=e1str(OUT,cur," ok=");
      cur=e1i64(OUT,cur,nok as i64);
      cur=e1str(OUT,cur," C:nf=");
      cur=e1i64(OUT,cur,sg(S,810) as i64);
      cur=e1str(OUT,cur," f0=");
      cur=e1i64(OUT,cur,sg(S,811) as i64);
      cur=e1str(OUT,cur," f1=");
      cur=e1i64(OUT,cur,sg(S,812) as i64);
      cur=e1str(OUT,cur," found=");
      cur=e1i64(OUT,cur,sg(S,814) as i64);
      cur=e1str(OUT,cur," ok=");
      cur=e1i64(OUT,cur,cok as i64);
      cur=e1str(OUT,cur,"\n");
      t=t+1;
    }
    w=w+1;
  }
  cur=e1str(OUT,cur,"XD-FIDELITY agree=");
  cur=e1i64(OUT,cur,sg(FC,0) as i64);
  cur=e1str(OUT,cur," total=");
  cur=e1i64(OUT,cur,sg(FC,1) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"XD-VERDICT N_ok=");
  cur=e1i64(OUT,cur,tnok as i64);
  cur=e1str(OUT,cur,"/12 C_ok=");
  cur=e1i64(OUT,cur,tcok as i64);
  cur=e1str(OUT,cur,"/12\n");
  cur=e1str(OUT,cur,"XD-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

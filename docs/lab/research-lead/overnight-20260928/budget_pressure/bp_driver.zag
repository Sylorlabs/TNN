// ===== BUDGET PRESSURE DRIVER =====
// Appended to a copy of frozen tnn2.zag with the test main removed.
// Cognition code untouched. Tests the forgetting-analysis prediction
// (P4 profile) and, novelly, post-pressure capability.
//
// Phases:
//   P1: build chain MAP via masked query (P4 setup)
//   P2: 1050 teaches to cap, verify P4 signature (eviction order,
//       fossil MAP, catastrophic forgetting, trial garbage)
//   P3a: new learning at cap (teach + immediate query-back)
//   P3b: retention of frequently-hit facts vs unhit facts
//   P3c: trial (masked query) at cap on a fresh chain
//   P3d: re-teach cost for a forgotten answer (R5)
//   P3e: 300 mixed events at cap, stability + probe recall
// Determinism: 3/3 byte-identical runs required.

fn bp_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

fn bp_live(W:[]u8)i32 {
  let nn:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){nn=nn+1;} n=n+1; }
  return nn;
}

fn bp_tag(W:[]u8,tag:i32)i32 {
  let nn:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){nn=nn+1;} n=n+1; }
  return nn;
}

fn bp_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}

fn bp_find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}

// is node n live?
fn bp_nlive(W:[]u8,n:i32)i32 {
  if(n<2 || n>=1024){return 0;}
  return ng(W,n,36);
}

// count live op cells (101-104) reachable as the MAP's graph:
// walk from root following SEQ and BRANCHEQ true-targets (t2_sig pattern).
fn bp_graph_live_cells(W:[]u8,root:i32)i32 {
  if(root<2 || root>=1024){return 0;}
  if(ng(W,root,36)!=1){return 0;}
  let cnt:i32=0; let cur:i32=root; let guard:i32=0;
  while(cur>=2 && cur<1024 && guard<64){
    guard=guard+1;
    if(ng(W,cur,36)!=1){return cnt;}
    let tag:i32=ng(W,cur,0);
    if(tag==101 || tag==102 || tag==103 || tag==104){
      cnt=cnt+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    } else {
      return cnt;
    }
  }
  return cnt;
}

fn bp_snap(W:[]u8)void {
  emit("SNAP live="); e64(bp_live(W));
  emit(" T1="); e64(bp_tag(W,1));
  emit(" T20="); e64(bp_tag(W,20));
  emit(" Top="); e64(bp_tag(W,101)+bp_tag(W,102)+bp_tag(W,103)+bp_tag(W,104));
  emit(" T902="); e64(bp_tag(W,902));
  emit(" T30="); e64(bp_tag(W,30));
  emit(" nalloc="); e64(hg(W,20));
  emit("\n");
  return;
}

fn bp_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0; let a:i32=0; let n:i32=0;

  // ---------- P1: build chain MAP ----------
  emit("=== P1 build chain MAP ===\n");
  ev_teach(W,6000,1,6001);
  ev_teach(W,6001,1,6002);
  ev_teach(W,6002,1,6003);
  ev_teach(W,6003,1,6004);
  a=ev_query(W,6000,40,-2,1);
  bp_rep("P1 trial_ans",a);
  let mapn:i32=bp_find_map(W,6000,40);
  bp_rep("P1 map_node",mapn);
  let maproot:i32=-1; let mapans:i32=-999999;
  if(mapn>=0){ maproot=ng(W,mapn,20); mapans=ng(W,mapn,28); }
  bp_rep("P1 map_root",maproot);
  bp_rep("P1 map_answer",mapans);
  bp_rep("P1 graph_live_cells",bp_graph_live_cells(W,maproot));
  bp_snap(W);

  // ---------- P2: 1050 teaches to cap ----------
  emit("=== P2 pressure to cap ===\n");
  let tfail:i32=0;
  i=0;
  while(i<1050){
    n=ev_teach(W,7000+i,5,i*3+1);
    if(n<0){tfail=tfail+1;}
    i=i+1;
  }
  bp_rep("P2 teach_failures",tfail);
  bp_snap(W);
  // P4 signature checks (no query yet, to avoid miss-path perturbation)
  let mapn2:i32=bp_find_map(W,6000,40);
  bp_rep("P2 map_still_indexed",mapn2);
  bp_rep("P2 map_node_live",bp_nlive(W,mapn));
  bp_rep("P2 map_root_live",bp_nlive(W,maproot));
  bp_rep("P2 map_graph_live_cells",bp_graph_live_cells(W,maproot));
  bp_rep("P2 chain_fact_6000_live",bp_nlive(W,bp_find_fact(W,6000,1)));
  // requery the learned answer (expect -2 miss -> catastrophic forgetting)
  a=ev_query(W,6000,40,-2,0);
  bp_rep("P2 requery_6000_40",a);
  bp_snap(W);

  // ---------- P3a: new learning at cap ----------
  emit("=== P3a new learning at cap ===\n");
  let tf2:i32=0; let qhit:i32=0;
  i=0;
  while(i<20){
    n=ev_teach(W,8000+i,6,i*11+5);
    if(n<0){tf2=tf2+1;}
    i=i+1;
  }
  bp_rep("P3a teach_failures",tf2);
  i=0;
  while(i<20){
    a=ev_query(W,8000+i,6,i*11+5,0);
    if(a==i*11+5){qhit=qhit+1;}
    i=i+1;
  }
  bp_rep("P3a queryback_hits",qhit);
  bp_snap(W);

  // ---------- P3b: hit-fact retention vs unhit ----------
  emit("=== P3b hit retention ===\n");
  ev_teach(W,9000,7,9001);
  ev_teach(W,9002,7,9003);
  i=0;
  while(i<30){
    a=ev_query(W,9000,7,9001,0);
    i=i+1;
  }
  // 60 more teaches of pressure (reduced from 200: eviction is O(NxE),
  // each teach at cap costs ~30M ops; 60 suffices to test retention)
  i=0;
  while(i<60){
    ev_teach(W,9500+i,8,i*5+2);
    i=i+1;
  }
  let hitfact:i32=bp_find_fact(W,9000,7);
  let unhitfact:i32=bp_find_fact(W,9002,7);
  bp_rep("P3b hit_fact_node",hitfact);
  bp_rep("P3b hit_fact_live",bp_nlive(W,hitfact));
  bp_rep("P3b unhit_fact_node",unhitfact);
  bp_rep("P3b unhit_fact_live",bp_nlive(W,unhitfact));
  a=ev_query(W,9000,7,9001,0);
  bp_rep("P3b hit_query",a);
  a=ev_query(W,9002,7,9003,0);
  bp_rep("P3b unhit_query",a);
  bp_snap(W);

  // ---------- P3c: trial at cap on fresh chain ----------
  emit("=== P3c trial at cap ===\n");
  ev_teach(W,9100,1,9101);
  ev_teach(W,9101,1,9102);
  ev_teach(W,9102,1,9103);
  a=ev_query(W,9100,40,-2,1);
  bp_rep("P3c trial_ans",a);
  let mapn3:i32=bp_find_map(W,9100,40);
  bp_rep("P3c map_promoted",mapn3);
  bp_snap(W);

  // ---------- P3d: re-teach cost for forgotten answer ----------
  emit("=== P3d re-teach cost ===\n");
  // (6000,40) answer was forgotten in P2. Re-teach the fact directly.
  let na0:i32=hg(W,20);
  n=ev_teach(W,6000,40,mapans);
  let na1:i32=hg(W,20);
  bp_rep("P3d reteach_node",n);
  bp_rep("P3d reteach_nalloc_delta",na1-na0);
  a=ev_query(W,6000,40,mapans,0);
  bp_rep("P3d requery",a);
  bp_snap(W);

  // ---------- P3e: 120 mixed events at cap (reduced from 300: O(NxE)
  // eviction cost; 120 suffices for stability measurement) ----------
  emit("=== P3e sustained mixed pressure ===\n");
  let probe_hit:i32=0;
  // teach 10 probe facts interleaved with mixed events
  i=0;
  while(i<10){
    ev_teach(W,9800+i,9,100+i);
    i=i+1;
  }
  i=0;
  while(i<120){
    let k:i32=i%5;
    if(k==0){ ev_teach(W,9900+i,9,i); }
    else { if(k==1){ a=ev_query(W,9800+(i%10),9,100+(i%10),0); } else { if(k==2){ a=ev_query(W,7000+(i%50),5,-2,0); } else { if(k==3){ ev_observe(W,9800+(i%10),9,100+(i%10)); } else { a=ev_query(W,9600+i,40,-2,1); } } } }
    i=i+1;
  }
  bp_rep("P3e live_after",bp_live(W));
  i=0;
  while(i<10){
    a=ev_query(W,9800+i,9,100+i,0);
    if(a==100+i){probe_hit=probe_hit+1;}
    i=i+1;
  }
  bp_rep("P3e probe_recall",probe_hit);
  bp_snap(W);

  emit("BP-DONE\n");
  return 0;
}

fn main()i32 { return bp_main(); }

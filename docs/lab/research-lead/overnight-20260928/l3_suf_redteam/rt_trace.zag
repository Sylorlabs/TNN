// rt_trace.zag -- RED-TEAM trace audit driver.
// Links FROZEN prelude/world/learner1/learner2/learner3/controls/driver
// read-only; runs the DEV W0 (which=0) T0 arm and dumps the white-box
// trace for A-TRACE / A-SEARCH / A-TRIGGER verification. Pure Zag.
fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb:[]u8=z_alloc(65536);
  let key:[]u8=z_alloc(64);
  w_dev_build(0,wb,key);
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(32768);
  let TR:[]u8=z_alloc(262144);
  let PR:[]u8=z_alloc(131072);
  let train:[]u8=z_alloc(4096);
  let form:[]u8=z_alloc(16384);
  let sc:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  l_kb_wipe(KB);
  let r0:i32=h_treat_arm(wb,KB,AS,LOG,TR,PR,train,form,sc,sres);
  e2(ob,atp,"T0 nrej=",(r0)," first_unres_mark=",(get32(AS,20)));
  e2(ob,atp,"first_creject=",(get32(AS,24))," op_fail=",(get32(AS,28)));
  e2(ob,atp,"tests=",(get32(AS,4))," nkr=",(get32(AS,92)));
  e0(ob,atp,"=== TRACE DUMP ===");
  // dump trace text (AS[68] bytes)
  let at:i32=get32(atp,0);
  let tlen:i32=get32(AS,68);
  let i:i32=0;
  while(i<tlen){
    ob[at]=TR[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  e0(ob,atp,"RT-TRACE-END");
  write_ob(ob,atp);
  return 0;
}

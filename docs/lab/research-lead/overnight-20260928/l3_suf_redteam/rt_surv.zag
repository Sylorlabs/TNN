// rt_surv.zag -- RED-TEAM computational probe of frozen l_surviving.
// Links the FROZEN learner1.zag + prelude.zag read-only (sha256 verified).
// Constructs synthetic consequence logs for the R-SUF-1-relevant patterns
// and calls the FROZEN l_surviving directly, plus a gated variant
// (adversary's fix direction: rule (ii) requires absence of ACCEPTs).
// Pure Zag, safebin only.

// ---- gated variant: rule (ii) fires only with no TEST-ACCEPTs ----
fn l_surviving_gated(log:[]u8, ek:i32)i32 {
  let o0:i32=0;
  let o1:i32=0;
  let r0r:i32=0;
  let r1r:i32=0;
  let r0a:i32=0;
  let r1a:i32=0;
  let fabrej:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let e:i32=get32(log,base);
    if(e==ek){
      let kd:i32=get32(log,base+4);
      let vv:i32=get32(log,base+8);
      let oc:i32=get32(log,base+12);
      let fb:i32=get32(log,base+16);
      if(kd==0){
        if(vv==0){o0=1;}
        if(vv==1){o1=1;}
      }
      if(kd==1){
        if(oc==0){
          if(vv==0){r0r=1;}
          if(vv==1){r1r=1;}
        }
        if(oc==1){
          if(vv==0){r0a=1;}
          if(vv==1){r1a=1;}
        }
      }
      if(kd==2){
        if(fb==1){
          if(oc==0){fabrej=1;}
        } else {
          if(oc==0){
            if(vv==0){r0r=1;}
            if(vv==1){r1r=1;}
          }
          if(oc==1){
            if(vv==0){r0a=1;}
            if(vv==1){r1a=1;}
          }
        }
      }
    }
    i=i+1;
  }
  let noobs:i32=0;
  if(o0==0){
    if(o1==0){noobs=1;}
  }
  if(noobs==1){
    if(r0r==1){
      if(r1r==1){
        if(r0a==0){
          if(r1a==0){return 3;}
        }
      }
    }
    // FIX DIRECTION: rule (ii) gated on absence of ACCEPTs
    if(fabrej==1){
      if(r0a==0){
        if(r1a==0){return 3;}
      }
    }
  }
  let f0:i32=0;
  if(o1==1){f0=1;}
  if(r0r==1){f0=1;}
  if(r1a==1){f0=1;}
  let f1:i32=0;
  if(o0==1){f1=1;}
  if(r1r==1){f1=1;}
  if(r0a==1){f1=1;}
  let s:i32=3;
  if(f0==1){s=s-1;}
  if(f1==1){s=s-2;}
  return s;
}
fn t_run(ob:[]u8, atp:[]u8, name:[]u8, log:[]u8, ek:i32, log_nofab:[]u8)void {
  let mf:i32=l_surviving(log,ek);
  let mn:i32=l_surviving(log_nofab,ek);
  let mg:i32=l_surviving_gated(log,ek);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," frozen=");
  at=ob_i32(ob,at,mf);
  at=ob_app(ob,at," nofabrej=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," gated=");
  at=ob_i32(ob,at,mg);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let ek:i32=41*1000000+701*1000+702;
  // P1: U, full probe (both TEST values REJECTed), stakes fabrej
  let l1:[]u8=z_alloc(4096);
  set32(l1,0,0);
  l_log_touch(l1,ek,1,0,0,0,1);
  l_log_touch(l1,ek,1,1,0,0,2);
  l_log_touch(l1,ek,2,1,0,1,3);
  let l1n:[]u8=z_alloc(4096);
  set32(l1n,0,0);
  l_log_touch(l1n,ek,1,0,0,0,1);
  l_log_touch(l1n,ek,1,1,0,0,2);
  t_run(ob,atp,"P1 U-full-probe        ",l1,ek,l1n);
  // P2: U, PARTIAL probe (only TEST(0) REJECTed), stakes fabrej
  let l2:[]u8=z_alloc(4096);
  set32(l2,0,0);
  l_log_touch(l2,ek,1,0,0,0,1);
  l_log_touch(l2,ek,2,1,0,1,2);
  let l2n:[]u8=z_alloc(4096);
  set32(l2n,0,0);
  l_log_touch(l2n,ek,1,0,0,0,1);
  t_run(ob,atp,"P2 U-partial-probe     ",l2,ek,l2n);
  // P3: DECOY (TEST(0) ACCEPTed), stakes fabrej -- the R-SUF-1 case
  let l3:[]u8=z_alloc(4096);
  set32(l3,0,0);
  l_log_touch(l3,ek,1,0,1,0,1);
  l_log_touch(l3,ek,2,1,0,1,2);
  let l3n:[]u8=z_alloc(4096);
  set32(l3n,0,0);
  l_log_touch(l3n,ek,1,0,1,0,1);
  t_run(ob,atp,"P3 decoy-ACCEPT+fabrej ",l3,ek,l3n);
  // P4: X-CTX-like (stakes fabrej only, nothing else)
  let l4:[]u8=z_alloc(4096);
  set32(l4,0,0);
  l_log_touch(l4,ek,2,1,0,1,1);
  let l4n:[]u8=z_alloc(4096);
  set32(l4n,0,0);
  t_run(ob,atp,"P4 stakes-fabrej-only  ",l4,ek,l4n);
  // P5: observed value 1, stakes fabrej
  let l5:[]u8=z_alloc(4096);
  set32(l5,0,0);
  l_log_touch(l5,ek,0,1,1,0,1);
  l_log_touch(l5,ek,2,0,0,1,2);
  let l5n:[]u8=z_alloc(4096);
  set32(l5n,0,0);
  l_log_touch(l5n,ek,0,1,1,0,1);
  t_run(ob,atp,"P5 observed+fabrej     ",l5,ek,l5n);
  // P6: decoy, no stakes yet (TEST(0) ACCEPTed only)
  let l6:[]u8=z_alloc(4096);
  set32(l6,0,0);
  l_log_touch(l6,ek,1,0,1,0,1);
  let l6n:[]u8=z_alloc(4096);
  set32(l6n,0,0);
  l_log_touch(l6n,ek,1,0,1,0,1);
  t_run(ob,atp,"P6 decoy-no-stakes     ",l6,ek,l6n);
  // P7: knowledge REJECT of 0 (no fabrej)
  let l7:[]u8=z_alloc(4096);
  set32(l7,0,0);
  l_log_touch(l7,ek,1,0,0,0,1);
  let l7n:[]u8=z_alloc(4096);
  set32(l7n,0,0);
  l_log_touch(l7n,ek,1,0,0,0,1);
  t_run(ob,atp,"P7 know-REJECT-0       ",l7,ek,l7n);
  // P8: contradictory ACCEPTs (both values), stakes fabrej
  let l8:[]u8=z_alloc(4096);
  set32(l8,0,0);
  l_log_touch(l8,ek,1,0,1,0,1);
  l_log_touch(l8,ek,1,1,1,0,2);
  l_log_touch(l8,ek,2,1,0,1,3);
  let l8n:[]u8=z_alloc(4096);
  set32(l8n,0,0);
  l_log_touch(l8n,ek,1,0,1,0,1);
  l_log_touch(l8n,ek,1,1,1,0,2);
  t_run(ob,atp,"P8 both-ACCEPT+fabrej  ",l8,ek,l8n);
  e0(ob,atp,"RT-SURV-END");
  write_ob(ob,atp);
  return 0;
}

// rt_trace07.zag -- RED-TEAM: DEV W0 T0 (kb prime) then DEV F-G (which=7)
// with the CONTINUING kb, mimicking the sealed T0->T7 sequence.
// Dumps the F-G trace segment for the A-SEARCH differential check.
fn main()i32 {
  let ob:[]u8=z_alloc(1048576);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb0:[]u8=z_alloc(65536);
  let wb7:[]u8=z_alloc(65536);
  let key:[]u8=z_alloc(64);
  w_dev_build(0,wb0,key);
  w_dev_build(7,wb7,key);
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(32768);
  let TR:[]u8=z_alloc(262144);
  let PR:[]u8=z_alloc(131072);
  let train:[]u8=z_alloc(4096);
  let form:[]u8=z_alloc(16384);
  let sc:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  l_kb_wipe(KB);
  let r0:i32=h_treat_arm(wb0,KB,AS,LOG,TR,PR,train,form,sc,sres);
  e2(ob,atp,"W0 done nrej=",(r0)," kb_tmpl=",(get32(KB,4)));
  // reset trace cursor for the F-G segment
  set32(AS,68,0);
  let r7:i32=h_treat_arm(wb7,KB,AS,LOG,TR,PR,train,form,sc,sres);
  e2(ob,atp,"FG nrej=",(r7)," unres_marks=",(get32(AS,44)));
  e2(ob,atp,"commit_kind=",(get32(AS,88))," op_fail=",(get32(AS,28)));
  e0(ob,atp,"=== FG TRACE SEGMENT ===");
  let at:i32=get32(atp,0);
  let tlen:i32=get32(AS,68);
  let i:i32=0;
  while(i<tlen){
    ob[at]=TR[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  e0(ob,atp,"RT-TRACE07-END");
  write_ob(ob,atp);
  return 0;
}

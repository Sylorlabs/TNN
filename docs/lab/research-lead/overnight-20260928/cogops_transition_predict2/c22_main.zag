// c18_main.zag -- driver for the cogops-alternation-world battery.
// c18 = c17 (COGOPS-HEDGEREMOVAL, hedge deleted) with a new
// three-stage detection battery; c18h = the same driver with
// c16's hedge-bearing strat_sel. Rescue-aware expected-cost strategy selection: each
// learner-computed goal context (nneeds, need-1 relation field)
// keeps its own strategy table; strat_sel picks by
//   score_s = E[turn_s] + P(fail_s) * E[rescue]
// argmin within the current context's table, where
// E[turn_s]=(c+2)/(u+2), P(fail_s)=(u-w+1)/(u+2), and
// E[rescue]=(rt+2)/(rc+2) from the learner's global rescue
// ledger. P(success) does NOT cancel: the failure probability
// re-enters through the rescue term. Stages: S1A/S1B (world A
// learning), S2 (world D), S4 (world E), S6L (world C), S6B
// (world F setup + re-specialize), then S_PW (goal 830, world F
// 613-oscillator: context (3,613) cold, PW leads by id and wins
// at lag 2 in 2 CMP), S_NEED (goal 831, world F partial
// oscillation: context (4,613) cold, PW fails, WHOLE fails,
// NEED rescues and wins at pass 4; rescue ledger (6,2)),
// S_TEST (goal 832, world F partial oscillation, fresh tag:
// context (4,613) carries S_NEED, so PW=(1,0,2) and NEED=(1,1,4)
// tie at 56/3 under ledger (6,2) with in-context evidence for
// both; c18h re-promotes ALT via the hedge (chosen=4, wins in
// 6 events, no rescue), c18 keeps PW by id (chosen=1, PW fails,
// WHOLE fails, NEED wins in 8 events with 2 rescue
// observations).
// All dynamic output goes through the single preallocated
// buffer B, flushed once at the end. The summary adds one
// learner-state line: RESCUE total=<rt> count=<rc>.
// Harness file: pattern and goal ids appear here (the c9_main
// precedent); c11_learn.zag carries zero literals.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-VFY rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,8480) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,8484) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- chain_of: build a chain buffer from a goal need, sub fills s==0 ----
fn chain_of(G:[]u8,ni:i32,sub:i32,tmpc:[]u8)void {
  let ns:i32=need_f(G,ni,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=need_f(G,ni,1+i*3);
    if(s==0){ s=sub; }
    set32(tmpc,4+i*12,s);
    set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
    i=i+1;
  }
  return;
}
// ---- walk_fix: iterate RETRIEVE [rel, obj] until output == input ----
fn walk_fix(A:[]u8,rel:i32,obj:i32,K:[]u8,tout:[]u8)i32 {
  let guard:i32=0;
  let walking:i32=1;
  while(walking==1){
    if(guard>=16){ walking=0; }
    if(walking==1){
      let nr:i32=ret_gen(A,rel,obj,K,4,tout,0);
      if(nr==0){ walking=0; }
      if(nr>0){
        let s:i32=get32(tout,4);
        if(s==obj){ walking=0; }
        if(s!=obj){ obj=s; }
      }
      guard=guard+1;
    }
  }
  return obj;
}
// ---- oracle_cyc816: independent all-generic reference, self-loop goal ----
fn oracle_cyc816(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let seed:[]u8=z_alloc(160);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=chain_new();
  let nc0:i32=ret_gen(A,need_f(G,0,0),need_f(G,0,1),K,4,seed,0);
  let fix:i32=walk_fix(A,need_f(G,1,0),need_f(G,1,1),K,tout);
  chain_of(G,2,fix,tmpc);
  let vv:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,fix);
  let npass:i32=0;
  if(vv==1){ npass=1; }
  ans_append(oans,npass);
  if(npass==1){ ans_append(oans,fix); }
  ans_append(oans,nc0);
  let k:i32=0;
  while(k<nc0){
    ans_append(oans,get32(seed,4+k*4));
    k=k+1;
  }
  return;
}
// ---- emit the learner-built cycle as the OSC-CYCLE line ----
fn emit_cycle(b:[]u8,c:i32,L:[]u8,gt:i32,lag:i32,q:i32,nn:i32,src:i32,e:i32)i32 {
  c=o_app(b,c,"OSC-CYCLE goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," lag=");
  c=o_i64(b,c,lag as i64);
  c=o_app(b,c," nph=");
  c=o_i64(b,c,lag as i64);
  let t:i32=0;
  while(t<lag){
    c=o_app(b,c," ph");
    c=o_i64(b,c,t as i64);
    b[c]=61; c=c+1;
    let j:i32=0;
    while(j<nn){
      let pb:i32=0;
      if(src==0){ pb=traj_base(q+t,j); }
      if(src==1){ pb=outc_phase_base(e,t,j); }
      b[c]=91; c=c+1;
      let n2:i32=get32(L,pb);
      c=o_i64(b,c,n2 as i64);
      let k:i32=0;
      while(k<n2){
        b[c]=44; c=c+1;
        c=o_i64(b,c,get32(L,pb+4+k*4) as i64);
        k=k+1;
      }
      b[c]=93; c=c+1;
      j=j+1;
    }
    t=t+1;
  }
  c=o_nl(b,c);
  return c;
}
// ---- dump one learner-written outcome-record entry (with mask) ----
fn dump_osc_state(b:[]u8,c:i32,L:[]u8,e:i32)i32 {
  let bo:i32=outc_base(e);
  c=o_app(b,c,"OSC-STATE goal=");
  c=o_i64(b,c,get32(L,bo) as i64);
  c=o_app(b,c," lag=");
  c=o_i64(b,c,get32(L,bo+4) as i64);
  c=o_app(b,c," nph=");
  c=o_i64(b,c,get32(L,bo+8) as i64);
  c=o_app(b,c," src=");
  c=o_i64(b,c,get32(L,bo+12) as i64);
  c=o_app(b,c," mask=");
  c=o_i64(b,c,get32(L,16656+e*4) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- dump the learner's detection-event ring as DET lines ----
// kind 0=CMP, 1=HYP (z=mask), 3=PRIOR, 4=SET, 5=APPLY, 6=RETRACT,
// 7=NCMP, 8=STRAT, 9=SWITCH.
fn dump_det_ev(b:[]u8,c:i32,L:[]u8,gt:i32)i32 {
  let ntev:i32=get32(L,15908);
  let t:i32=0;
  while(t<ntev){
    let ebo:i32=15912+t*20;
    let kind:i32=get32(L,ebo);
    let p:i32=get32(L,ebo+4);
    let x:i32=get32(L,ebo+8);
    let y:i32=get32(L,ebo+12);
    let z:i32=get32(L,ebo+16);
    if(kind==0){
      c=o_app(b,c,"DET-CMP p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," a=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," b=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," eq=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==1){
      c=o_app(b,c,"DET-HYP goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," q=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," mask=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==3){
      c=o_app(b,c,"DET-PRIOR prior=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==4){
      c=o_app(b,c,"DET-PRIOR set=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==5){
      c=o_app(b,c,"DET-APPLY goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," pass=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," match=");
      c=o_i64(b,c,x as i64);
      b[c]=47; c=c+1;
      c=o_i64(b,c,y as i64);
      c=o_nl(b,c);
    }
    if(kind==6){
      c=o_app(b,c,"DET-RETRACT goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==7){
      c=o_app(b,c,"DET-NCMP p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," need=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," eq=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==8){
      c=o_app(b,c,"DET-STRAT chosen=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==9){
      c=o_app(b,c,"DET-SWITCH from=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," to=");
      c=o_i64(b,c,y as i64);
      c=o_nl(b,c);
    }
    // COGOPS-HEDGE-FREQUENCY instrumentation dump branches.
    // kind 10: DET-HEDGE before=<p> dt1=<x> dt3=<y> ev=<z>.
    // kind 11: DET-HGATE best=<x> c1=<y> c3=<z> (p unused).
    if(kind==10){
      c=o_app(b,c,"DET-HEDGE before=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," dt1=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," dt3=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," ev=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==11){
      c=o_app(b,c,"DET-HGATE best=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," c1=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," c3=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    // COGOPS-LEADERSHIP-TRANSITION dump branch.
    // kind 12: DET-TIE best=<p> tm=<x> rt=<y> rc=<z>.
    if(kind==12){
      c=o_app(b,c,"DET-TIE best=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," tm=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," rt=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," rc=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    t=t+1;
  }
  return c;
}
// ---- one query through the learner-owned detection driver ----
// h: -1 declined; 0 generic fallback (compose_iter); 1 invented;
// 2 reused from the outcome record. doagree=1 runs the
// independent oracle_cyc816 on the fallback path (S10 control).
// The driver is det_handle (strategy-choosing detection); the
// DET event ring is dumped after the Q line in every branch.
fn do_losc(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,R:[]u8,qn:[]u8,doagree:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let h:i32=det_handle(L,A,G,K,R);
  let gt:i32=g_tag(G);
  let nn:i32=g_nneeds(G);
  if(h<0){
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  if(h==0){
    let vbuf:[]u8=z_alloc(32);
    let ans:[]u8=z_alloc(256);
    set32(K,0,0);
    set32(K,4,0);
    compose_iter(L,A,G,K,ans,vbuf);
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," how=0 passes=");
    c=o_i64(b,c,get32(vbuf,20) as i64);
    c=o_nl(b,c);
    c=dump_det_ev(b,c,L,gt);
    if(doagree==1){
      let oans:[]u8=z_alloc(256);
      let seen:[]u8=z_alloc(320);
      set32(K,4,0);
      oracle_cyc816(A,G,K,oans,seen);
      let a:i32=ans_eq(ans,oans);
      if(a==1){ set32(L,13240,get32(L,13240)+1); }
      c=o_app(b,c,"AGREE id=");
      c=o_app(b,c,qn);
      c=o_app(b,c," a=");
      c=o_i64(b,c,a as i64);
      c=o_nl(b,c);
    }
    return c;
  }
  let lag:i32=get32(R,8);
  let q:i32=get32(R,12);
  let src:i32=get32(R,20);
  let ee:i32=get32(R,24);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," how=");
  c=o_i64(b,c,h as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(R,4) as i64);
  c=o_nl(b,c);
  c=dump_det_ev(b,c,L,gt);
  c=emit_cycle(b,c,L,gt,lag,q,nn,src,ee);
  if(h==1){
    c=o_app(b,c,"OSC-CONFIRM goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," ok=1");
    c=o_nl(b,c);
  }
  if(h==2){
    c=o_app(b,c,"OSC-REUSE goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," match=2");
    c=o_nl(b,c);
  }
  c=o_app(b,c,"SPECCHK goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," spec=");
  c=o_i64(b,c,get32(R,28) as i64);
  c=o_nl(b,c);
  c=dump_osc_state(b,c,L,ee);
  return c;
}
// ---- dump the per-context strategy tables, one line per used slot:
// CTX<slot> sig=<nn>,<rel> pw=<u>,<w>,<c> who=... need=... alt=...
fn dump_ctx(b:[]u8,c:i32,L:[]u8)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<8){
    if(get32(L,17000+s*56)!=0){ n=n+1; }
    s=s+1;
  }
  c=o_app(b,c,"CTX n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  let t:i32=0;
  while(t<8){
    let sb:i32=17000+t*56;
    if(get32(L,sb)!=0){
      c=o_app(b,c,"CTX");
      c=o_i64(b,c,t as i64);
      c=o_app(b,c," sig=");
      c=o_i64(b,c,get32(L,sb) as i64);
      b[c]=44; c=c+1;
      c=o_i64(b,c,get32(L,sb+4) as i64);
      let q:i32=1;
      while(q<5){
        let qb:i32=sb+8+(q-1)*12;
        if(q==1){ c=o_app(b,c," pw="); }
        if(q==2){ c=o_app(b,c," who="); }
        if(q==3){ c=o_app(b,c," need="); }
        if(q==4){ c=o_app(b,c," alt="); }
        c=o_i64(b,c,get32(L,qb) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,get32(L,qb+4) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,get32(L,qb+8) as i64);
        q=q+1;
      }
      c=o_nl(b,c);
    }
    t=t+1;
  }
  return c;
}

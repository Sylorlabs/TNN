// c22_world_add.zag -- COGOPS-TRANSITION-PREDICT-2 world additions.
// Appended AFTER c18_world.zag (used verbatim) in the c22 build.
// Provides fresh strategy contexts per arc: new need1 rels with
// world facts mirroring rel 613's 3-fact oscillation pattern, so
// the per-need retrieve dynamics are identical and only the
// context key (nn, rel) differs.
//
// Rel 613 (frozen): 771,613,770 / 772,613,771 / 771,613,772.
// New rels (objects chosen clear of all existing facts):
//   617: 791,617,790 / 792,617,791 / 791,617,792
//   619: 795,619,794 / 796,619,795 / 795,619,796
//   621: 799,621,798 / 800,621,799 / 799,621,800
//   623: 803,623,802 / 804,623,803 / 803,623,804
// ret_gen(rel,obj) collects subjects with (subj,rel,obj):
//   (617,790)->[791], (619,794)->[795], (621,798)->[799],
//   (623,802)->[803]: single constant records, exactly like
//   (613,770)->[771]. The kind-1 self-link chain-following sees
//   the same 2-cycle shape ([791]/[792] etc.), so NEED-winnable
//   setup goals and unwinnable test goals behave identically
//   to the 613 versions; the strategy tables are fresh per rel.
//
// Goal constructors (flat w_* sequences, no loops, no nesting):
//   mk_goal2r(G,tag,rel,obj): kind-2 shape (3 needs, NEED-winnable)
//     with need1 P=(rel,obj). Context (3,rel).
//   mk_goal8r(G,tag,rel,obj): kind-8 shape (3 needs, unwinnable)
//     with need1 P=(rel,obj). Context (3,rel).
// need tags 801/802 reused from the frozen battery (bindings
// already learned); goal tags fresh per stage.
fn setup_worldF_c22(A:[]u8)void {
  setup_worldF(A);
  fact_add(A,791,617,790);
  fact_add(A,792,617,791);
  fact_add(A,791,617,792);
  fact_add(A,795,619,794);
  fact_add(A,796,619,795);
  fact_add(A,795,619,796);
  fact_add(A,799,621,798);
  fact_add(A,800,621,799);
  fact_add(A,799,621,800);
  fact_add(A,803,623,802);
  fact_add(A,804,623,803);
  fact_add(A,803,623,804);
  return;
}
// mk_goal2r: kind-2 (N3) structure with parameterized need1 rel.
// 3 needs, context (3,rel). NEED-winnable: whole state never
// repeats within the episode (drifter), needs 0,1 match at lag 2.
fn mk_goal2r(G:[]u8,tag:i32,rel:i32,obj:i32)void {
  let o:i32=w_begin(G,tag,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_need(G,o,801,2); o=w_f(G,o,604); o=w_f(G,o,611);
  o=w_links(G,o,2);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,1,2,0,1,2,1,0);
  return;
}
// mk_goal8r: kind-8 structure with parameterized need1 rel.
// 3 needs, context (3,rel). Unwinnable by all four forms:
// need0 P=(601,621) -> [611] constant; need1 P=(rel,obj) with NO
// self-link -> [obj+1] constant (rel not in learner ret coverage:
// generic retrieve); need2 P=(604,611) kind-1 SELF-link ->
// convergent drifter. Whole state never repeats; NEED match set
// all-trivial.
fn mk_goal8r(G:[]u8,tag:i32,rel:i32,obj:i32)void {
  let o:i32=w_begin(G,tag,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_need(G,o,801,2); o=w_f(G,o,604); o=w_f(G,o,611);
  o=w_links(G,o,1);
  o=w_link(G,o,1,2,0,1,2,1,0);
  return;
}

// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen fact table and the world-change kill. The learner never
// calls w_kill; it only observes facts via f_teach and discovers
// the death through execution outcomes.
// Fact ids: 0:(1,1,2) 1:(2,1,3) 2:(3,1,4) 3:(2,2,5) 4:(5,2,3)
//           5:(1,61,11) 6:(11,62,12) 7:(2,63,13) 8:(5,64,14)

fn w_fact(i:i32, out:[]u8)void {
  if(i==0){out[0]=1;out[1]=1;out[2]=2;return;}
  if(i==1){out[0]=2;out[1]=1;out[2]=3;return;}
  if(i==2){out[0]=3;out[1]=1;out[2]=4;return;}
  if(i==3){out[0]=2;out[1]=2;out[2]=5;return;}
  if(i==4){out[0]=5;out[1]=2;out[2]=3;return;}
  if(i==5){out[0]=1;out[1]=61;out[2]=11;return;}
  if(i==6){out[0]=11;out[1]=62;out[2]=12;return;}
  if(i==7){out[0]=2;out[1]=63;out[2]=13;return;}
  out[0]=5;out[1]=64;out[2]=14;
  return;
}
fn w_nfacts()i32 { return 9; }

// World change: a licensing fact dies. Environment act only.
fn w_kill(st:[]u8, fid:i32)void {
  st[16+fid*8+3]=0;
  return;
}

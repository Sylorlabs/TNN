// mul1.zag -- MUL-1 learner construction experiment, Rung A primary arm.
// Frozen prereg: docs/lab/research-lead/overnight-20260928/mul_prereg/PREREG_MUL1.md @ 222899314.
// ISA boundary: docs/lab/research-lead/overnight-20260928/architecture_rulings/ISA_BOUNDARY_RULING.md @ 0525377f3.
// Pure Zag. No Python. No em dashes.
//
// Rung A: cell ops from {MOVE, BRANCHEQ, ADD} + literal cells.
//   Realized as discrete cell types:
//     INIT_R0  = MOVE(result <- literal 0)
//     INIT_C0  = MOVE(counter <- literal 0)
//     ACCUM_RX = MOVE(result <- ADD(result, x))
//     ACCUM_RY = MOVE(result <- ADD(result, y))
//     STEP_C   = MOVE(counter <- ADD(counter, literal 1))  [the literal-1 step]
//     TEST_CY  = BRANCHEQ(counter, y) -> halt on equal, else fall through
//     TEST_CX  = BRANCHEQ(counter, x) -> halt on equal, else fall through
//     GOTO(t)  = SEQ back-edge to cell t (EXECUTE control flow)
// The learner must discover the composition; the vocabulary names no target
// regularity (no repeated-addition schema, no loop-with-accumulator template).
// No new arithmetic op is added on this rung. No MUL, SUB, or loop primitive.
//
// Discovery: fixed published trial order. Programs enumerated by length
// L = 1..6, lexicographic over alphabet 0..6+L (GOTO targets 7..6+L).
// First program scoring 12/12 on the bare exemplars is PROMOTEd: its cells
// are materialized as learner-owned workspace PROC nodes, and all later
// phases (probes, transfer, ablation) execute from the workspace graph.

// ============ output and memory helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// u8-backed little-endian cells (compiler workaround per AGENTS.md)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ frozen experience data (prereg section 3) ============
// Phase 2: N = 12 bare multiplication exemplars. No scaffolding shown.
fn ex_x(i:i32)i32 {
  if(i==0){return 2;} if(i==1){return 3;} if(i==2){return 2;}
  if(i==3){return 4;} if(i==4){return 3;} if(i==5){return 5;}
  if(i==6){return 4;} if(i==7){return 7;} if(i==8){return 6;}
  if(i==9){return 8;} if(i==10){return 5;} return 9;
}
fn ex_y(i:i32)i32 {
  if(i==0){return 3;} if(i==1){return 4;} if(i==2){return 5;}
  if(i==3){return 4;} if(i==4){return 7;} if(i==5){return 6;}
  if(i==6){return 9;} if(i==7){return 7;} if(i==8){return 4;}
  if(i==9){return 3;} if(i==10){return 8;} return 6;
}
fn ex_p(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 12;} if(i==2){return 10;}
  if(i==3){return 16;} if(i==4){return 21;} if(i==5){return 30;}
  if(i==6){return 36;} if(i==7){return 49;} if(i==8){return 24;}
  if(i==9){return 24;} if(i==10){return 40;} return 54;
}
// Phase 4: 8 held-out probes. Products are novel (none in training set).
fn pr_x(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 3;} if(i==2){return 8;}
  if(i==3){return 7;} if(i==4){return 4;} if(i==5){return 9;}
  if(i==6){return 5;} return 11;
}
fn pr_y(i:i32)i32 {
  if(i==0){return 7;} if(i==1){return 9;} if(i==2){return 8;}
  if(i==3){return 9;} if(i==4){return 11;} if(i==5){return 9;}
  if(i==6){return 12;} return 3;
}
fn pr_p(i:i32)i32 {
  if(i==0){return 42;} if(i==1){return 27;} if(i==2){return 64;}
  if(i==3){return 63;} if(i==4){return 44;} if(i==5){return 81;}
  if(i==6){return 60;} return 33;
}
// Phase 1: ADD prerequisite pairs (sums 3..25).
fn ad_a(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return 2;} if(i==2){return 3;}
  if(i==3){return 5;} if(i==4){return 7;} if(i==5){return 8;}
  if(i==6){return 4;} if(i==7){return 11;} if(i==8){return 9;}
  return 12;
}
fn ad_b(i:i32)i32 {
  if(i==0){return 2;} if(i==1){return 5;} if(i==2){return 4;}
  if(i==3){return 6;} if(i==4){return 8;} if(i==5){return 9;}
  if(i==6){return 12;} if(i==7){return 13;} if(i==8){return 15;}
  return 13;
}

// ============ Rung A cell interpreter ============
// Programs are u8-backed i32 cell-code arrays, length L (1..6).
// Codes: 0 INIT_R0, 1 INIT_C0, 2 ACCUM_RX, 3 ACCUM_RY, 4 STEP_C,
//        5 TEST_CY, 6 TEST_CX, 7+t GOTO(t).
fn run_prog(cells:[]u8, L:i32, x:i32, y:i32)i32 {
  let r:i32=0; let c:i32=0; let pc:i32=0; let steps:i32=0;
  while(pc<L){
    if(steps>=10000){return -999999;}
    steps=steps+1;
    let t:i32=get32(cells, pc*4);
    if(t==0){ r=0; pc=pc+1; }
    else if(t==1){ c=0; pc=pc+1; }
    else if(t==2){ r=r+x; pc=pc+1; }
    else if(t==3){ r=r+y; pc=pc+1; }
    else if(t==4){ c=c+1; pc=pc+1; }
    else if(t==5){ if(c==y){ pc=L; } else { pc=pc+1; } }
    else if(t==6){ if(c==x){ pc=L; } else { pc=pc+1; } }
    else { pc=t-7; }
  }
  return r;
}
// Corroboration: count of the 12 exemplars predicted correctly.
fn test_prog(cells:[]u8, L:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<12){
    if(run_prog(cells, L, ex_x(i), ex_y(i))==ex_p(i)){ ok=ok+1; }
    i=i+1;
  }
  return ok;
}
fn op_name(code:i32)void {
  if(code<0){ emit("?"); }
  else if(code==0){ emit("INIT_R0"); }
  else if(code==1){ emit("INIT_C0"); }
  else if(code==2){ emit("ACCUM_RX"); }
  else if(code==3){ emit("ACCUM_RY"); }
  else if(code==4){ emit("STEP_C"); }
  else if(code==5){ emit("TEST_CY"); }
  else if(code==6){ emit("TEST_CX"); }
  else { emit("GOTO("); e64(code-7); emit(")"); }
  return;
}
fn print_prog_at(buf:[]u8, base:i32, L:i32)void {
  emit("[");
  let i:i32=0;
  while(i<L){
    op_name(get32(buf, base+i*4));
    if(i+1<L){ emit(" "); }
    i=i+1;
  }
  emit("]");
  return;
}
fn print_prog(prog:[]u8, L:i32)void { print_prog_at(prog, 0, L); return; }

// ============ trial-order enumeration ============
// Odometer over alphabet 0..alpha-1, position 0 varies slowest
// (standard lexicographic). Lengths tried L = 1..6 in order.
fn odo_init(d:[]u8, L:i32)void {
  let i:i32=0;
  while(i<L){ set32(d, i*4, 0); i=i+1; }
  return;
}
fn odo_next(d:[]u8, L:i32, alpha:i32)i32 {
  let i:i32=L-1;
  while(i>=0){
    let v:i32=get32(d, i*4)+1;
    if(v<alpha){ set32(d, i*4, v); return 1; }
    set32(d, i*4, 0);
    i=i-1;
  }
  return 0;
}
fn odo_index(d:[]u8, L:i32, alpha:i32)i32 {
  let idx:i32=0;
  let i:i32=0;
  while(i<L){ idx=idx*alpha+get32(d, i*4); i=i+1; }
  return idx;
}
fn odo_decode(d:[]u8, L:i32, alpha:i32, idx:i32)void {
  let i:i32=L-1;
  while(i>=0){
    set32(d, i*4, idx%alpha);
    idx=idx/alpha;
    i=i-1;
  }
  return;
}

// ============ Phase 3: trial-based discovery ============
// trace layout: +0 tried, +4 found_L, +8 genuine_rej, +12 first_correct_pos.
// tried_packed layout: packed=(L<<28)|odo_index for every program tested.
// rej_buf: first 3 genuine rejections, 36 bytes each (8 cells + L).
fn search_forward(trace:[]u8, found_prog:[]u8, tried_packed:[]u8, rej_buf:[]u8)i32 {
  let d:[]u8=z_alloc(8*4);
  let tried:i32=0;
  let grej:i32=0;
  let L:i32=1;
  while(L<=6){
    let alpha:i32=7+L;
    odo_init(d, L);
    let more:i32=1;
    while(more==1){
      let j:i32=0;
      while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
      let score:i32=test_prog(found_prog, L);
      set32(tried_packed, tried*4, (L<<28)|odo_index(d, L, alpha));
      tried=tried+1;
      if(score>=1 && score<12){
        if(grej<3){
          let b:i32=grej*36;
          let k:i32=0;
          while(k<8){
            if(k<L){ set32(rej_buf, b+k*4, get32(d, k*4)); } else { set32(rej_buf, b+k*4, -1); }
            k=k+1;
          }
          set32(rej_buf, b+32, L);
        }
        grej=grej+1;
      }
      if(score==12){
        set32(trace, 0, tried);
        set32(trace, 4, L);
        set32(trace, 8, grej);
        set32(trace, 12, tried);
        return L;
      }
      more=odo_next(d, L, alpha);
    }
    L=L+1;
  }
  set32(trace, 0, tried);
  set32(trace, 4, 0);
  set32(trace, 8, grej);
  set32(trace, 12, -1);
  return 0;
}

// ============ learner workspace: PROC graph ============
// Node layout (40 bytes): tag+0, ref0+4, ref1+8, ref2+12, ref3+16,
// pay0+20, pay1+24, pay2+28, pay3+32, valid+36.
// Node 0: PROC root (tag 1). Nodes 1..L: CELLs (tag 2).
// Cell: pay0 = op (0..6, 7=GOTO); ref0 = SEQ next (-1 halt);
//   ref1 = GOTO target node, or -1.
fn wtag(W:[]u8, n:i32)i32 { return get32(W, n*40); }
fn wref(W:[]u8, n:i32, r:i32)i32 { return get32(W, n*40+4+r*4); }
fn wpay(W:[]u8, n:i32, p:i32)i32 { return get32(W, n*40+20+p*4); }
fn wvalid(W:[]u8, n:i32)i32 { return get32(W, n*40+36); }
fn wset(W:[]u8, n:i32, f:i32, v:i32)void {
  // f: 0 tag, 1..4 ref0..3, 5..8 pay0..3, 9 valid.
  if(f==0){ set32(W, n*40, v); }
  else if(f<=4){ set32(W, n*40+f*4, v); }
  else if(f<=8){ set32(W, n*40+20+(f-5)*4, v); }
  else { set32(W, n*40+36, v); }
  return;
}
// Promote: materialize the winning program as learner-owned workspace nodes.
// This is the C0-A artifact: multiplication semantics live here, not in source.
fn materialize(W:[]u8, prog:[]u8, L:i32, rung:i32)void {
  wset(W, 0, 0, 1); wset(W, 0, 9, 1);
  wset(W, 0, 1, 1);
  wset(W, 0, 5, L); wset(W, 0, 6, rung);
  let i:i32=0;
  while(i<L){
    let n:i32=1+i;
    let code:i32=get32(prog, i*4);
    wset(W, n, 0, 2); wset(W, n, 9, 1);
    if(code>=7){ wset(W, n, 5, 7); } else { wset(W, n, 5, code); }
    if(i+1<L){ wset(W, n, 1, n+1); } else { wset(W, n, 1, -1); }
    if(code>=7){ wset(W, n, 2, 1+(code-7)); } else { wset(W, n, 2, -1); }
    i=i+1;
  }
  return;
}
// EXECUTE the workspace PROC graph (used for all post-promotion phases).
fn ws_exec(W:[]u8, x:i32, y:i32)i32 {
  if(wvalid(W,0)==0){ return -2; }
  if(wtag(W,0)!=1){ return -2; }
  let r:i32=0; let c:i32=0;
  let node:i32=wref(W,0,0);
  let steps:i32=0;
  while(node!=-1){
    if(steps>=10000){ return -999999; }
    steps=steps+1;
    let op:i32=wpay(W,node,0);
    if(op==0){ r=0; node=wref(W,node,0); }
    else if(op==1){ c=0; node=wref(W,node,0); }
    else if(op==2){ r=r+x; node=wref(W,node,0); }
    else if(op==3){ r=r+y; node=wref(W,node,0); }
    else if(op==4){ c=c+1; node=wref(W,node,0); }
    else if(op==5){ if(c==y){ node=-1; } else { node=wref(W,node,0); } }
    else if(op==6){ if(c==x){ node=-1; } else { node=wref(W,node,0); } }
    else { node=wref(W,node,1); }
  }
  return r;
}
// Tier 2 structural checklist on the workspace graph (prereg section 8).
// (a) back-edge: a GOTO whose target node precedes it in SEQ order.
// (b) accumulation cell inside the loop body.
// (c) data-dependent termination test (TEST_CY or TEST_CX).
// (d) input slots never overwritten: all ops write only R/C or nothing.
fn check_tier2(W:[]u8)i32 {
  if(wvalid(W,0)==0){ return 0; }
  let L:i32=wpay(W,0,0);
  let test_pos:i32=-1;
  let goto_pos:i32=-1;
  let goto_tgt:i32=-1;
  let i:i32=1;
  while(i<=L){
    let op:i32=wpay(W,i,0);
    if(op<0 || op>7){ return 0; }
    if((op==5 || op==6) && test_pos==-1){ test_pos=i; }
    if(op==7){
      let tgt:i32=wref(W,i,1);
      if(tgt>=1 && tgt<i){ goto_pos=i; goto_tgt=tgt; }
    }
    i=i+1;
  }
  if(test_pos==-1 || goto_pos==-1){ return 0; }
  let has_accum:i32=0;
  let j:i32=goto_tgt;
  while(j<=goto_pos){
    let op:i32=wpay(W,j,0);
    if(op==2 || op==3){ has_accum=1; }
    j=j+1;
  }
  if(has_accum==0){ return 0; }
  return 1;
}

// ============ oracle audit helpers (prereg section 7) ============
fn lcg_next(state:[]u8)i32 {
  let s:i32=get32(state, 0);
  s=(s*1103515245+12345)&0x7fffffff;
  set32(state, 0, s);
  return s;
}
fn shuffle_packed(arr:[]u8, n:i32)i32 {
  let state:[]u8=z_alloc(4);
  set32(state, 0, 222899314);
  let i:i32=n-1;
  while(i>0){
    let j:i32=lcg_next(state)%(i+1);
    let ti:i32=get32(arr, i*4);
    set32(arr, i*4, get32(arr, j*4));
    set32(arr, j*4, ti);
    i=i-1;
  }
  return 0;
}
// Rerun Phase 3 on the shuffled trial order. Corroboration must still
// promote a structure satisfying P-MUL1 (order must not be load-bearing).
fn search_shuffled(tried_packed:[]u8, n:i32, found_prog:[]u8)i32 {
  let d:[]u8=z_alloc(8*4);
  let i:i32=0;
  while(i<n){
    let packed:i32=get32(tried_packed, i*4);
    let L:i32=packed>>28;
    let idx:i32=packed&0x0fffffff;
    let alpha:i32=7+L;
    odo_decode(d, L, alpha, idx);
    let j:i32=0;
    while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
    if(test_prog(found_prog, L)==12){ return L; }
    i=i+1;
  }
  return 0;
}

// ============ test: P-MUL1 held-out probes + scaling ============
fn test_pmul1(W:[]u8)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<8){
    let r:i32=ws_exec(W, pr_x(i), pr_y(i));
    emit("PROBE "); e64(i); emit(": ("); e64(pr_x(i)); emit(",");
    e64(pr_y(i)); emit(") -> "); e64(r); emit(" expect ");
    e64(pr_p(i));
    if(r==pr_p(i)){ emit(" OK\n"); ok=ok+1; } else { emit(" MISS\n"); }
    i=i+1;
  }
  let sc:i32=ws_exec(W, 13, 17);
  emit("SCALING (13,17) -> "); e64(sc); emit(" expect 221");
  if(sc==221){ emit(" OK\n"); } else { emit(" MISS\n"); }
  emit("P-MUL1 probes: "); e64(ok); emit("/8\n");
  if(ok>=7 && sc==221){ emit("P-MUL1 PASS\n"); return 1; }
  emit("P-MUL1 FAIL\n");
  return 0;
}
// ============ test: P-MUL2 graph properties ============
fn test_pmul2(W:[]u8, probe_ok:i32, scaling_ok:i32)i32 {
  let t2:i32=check_tier2(W);
  emit("P-MUL2 Tier2 structural: "); e64(t2); emit("\n");
  if(probe_ok==1 && scaling_ok==1 && t2==1){ emit("P-MUL2 PASS\n"); return 1; }
  emit("P-MUL2 FAIL\n");
  return 0;
}
// ============ test: P-MUL3 ablation ============
fn ablate(W:[]u8)void {
  let L:i32=wpay(W,0,0);
  wset(W, 0, 9, 0);
  let i:i32=1;
  while(i<=L){ wset(W, i, 9, 0); i=i+1; }
  return;
}
fn core_add(a:i32, b:i32)i32 { return a+b; }
fn test_pmul3(W:[]u8)i32 {
  ablate(W);
  let ok:i32=0;
  let i:i32=0;
  while(i<8){
    let r:i32=ws_exec(W, pr_x(i), pr_y(i));
    if(r!=pr_p(i)){ ok=ok+1; }
    i=i+1;
  }
  emit("P-MUL3 post-ablation probes wrong-or-unknown: "); e64(ok); emit("/8\n");
  // Addition intact (core primitive, not workspace).
  let add_ok:i32=1;
  let j:i32=0;
  while(j<10){
    if(core_add(ad_a(j), ad_b(j))!=ad_a(j)+ad_b(j)){ add_ok=0; }
    j=j+1;
  }
  // Unrelated retrieval intact: fact nodes 100/101 written before ablation
  // are separate nodes; check they survive (ablation touched only 0..L).
  let fact_ok:i32=1;
  if(wvalid(W,100)==0 || wpay(W,100,1)!=6){ fact_ok=0; }
  if(wvalid(W,101)==0 || wpay(W,101,1)!=7){ fact_ok=0; }
  emit("P-MUL3 addition intact: "); e64(add_ok); emit(" facts intact: "); e64(fact_ok); emit("\n");
  if(ok==8 && add_ok==1 && fact_ok==1){ emit("P-MUL3 PASS\n"); return 1; }
  emit("P-MUL3 FAIL\n");
  return 0;
}
// ============ test: P-MUL4 transfer ============
fn test_pmul4(W:[]u8)i32 {
  // Fresh context, different surface encoding: named attributes, not pairs.
  wset(W, 100, 0, 3); wset(W, 100, 9, 1);
  wset(W, 100, 5, 1); wset(W, 100, 6, 6);   // attr width = 6
  wset(W, 101, 0, 3); wset(W, 101, 9, 1);
  wset(W, 101, 5, 2); wset(W, 101, 6, 7);   // attr height = 7
  let width:i32=wpay(W, 100, 1);
  let height:i32=wpay(W, 101, 1);
  emit("TRANSFER: EXECUTE(MUL root) width="); e64(width);
  emit(" height="); e64(height); emit("\n");
  let area:i32=ws_exec(W, width, height);
  emit("TRANSFER: rect area = "); e64(area); emit(" expect 42\n");
  if(area==42){ emit("P-MUL4 PASS\n"); return 1; }
  emit("P-MUL4 FAIL\n");
  return 0;
}
// ============ test: P-MUL5 lookup-table control ============
fn test_pmul5(mul_score:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<8){
    let x:i32=pr_x(i); let y:i32=pr_y(i);
    let found:i32=-2;
    let j:i32=0;
    while(j<12){
      if(ex_x(j)==x && ex_y(j)==y){ found=ex_p(j); }
      j=j+1;
    }
    if(found==pr_p(i)){ ok=ok+1; }
    i=i+1;
  }
  emit("P-MUL5 lookup control: "); e64(ok); emit("/8 (frozen ceiling 2)\n");
  emit("P-MUL5 margin (mul - control): "); e64(mul_score-ok); emit(" (frozen >= 5)\n");
  if(ok<=2 && mul_score-ok>=5){ emit("P-MUL5 PASS\n"); return 1; }
  emit("P-MUL5 FAIL\n");
  return 0;
}

// ============ main ============
fn main()i32 {
  emit("MUL-1 Rung A primary arm | prereg 222899314 | ISA 0525377f3\n");
  // ---- Phase 1: ADD prerequisite (Rung A core primitive) ----
  let add_ok:i32=1;
  let i:i32=0;
  while(i<10){
    if(core_add(ad_a(i), ad_b(i))!=ad_a(i)+ad_b(i)){ add_ok=0; }
    i=i+1;
  }
  emit("Phase 1 ADD prerequisite 10 pairs: "); e64(add_ok); emit("\n");
  // ---- Phase 2: 12 bare exemplars (data frozen above) ----
  emit("Phase 2: 12 bare exemplars loaded (no scaffolding)\n");
  // ---- Phase 3: trial-based discovery ----
  let trace:[]u8=z_alloc(16);
  let found_prog:[]u8=z_alloc(8*4);
  let tried_packed:[]u8=z_alloc(600000*4);
  let rej_buf:[]u8=z_alloc(3*36);
  let L:i32=search_forward(trace, found_prog, tried_packed, rej_buf);
  let tried:i32=get32(trace, 0);
  let grej:i32=get32(trace, 8);
  emit("Phase 3: tried="); e64(tried);
  emit(" found_L="); e64(L);
  emit(" genuine_rejections="); e64(grej); emit("\n");
  emit("PROMOTED: "); print_prog(found_prog, L); emit("\n");
  // Oracle audit 2(a): first trial is (L=1,[INIT_R0]); correct is not first.
  // 2(c): report genuine rejections.
  let g:i32=0;
  while(g<3 && g<grej){
    emit("REJECTED["); e64(g); emit("] score 1..11: ");
    print_prog_at(rej_buf, g*36, get32(rej_buf, g*36+32));
    emit("\n");
    g=g+1;
  }
  if(L==0){ emit("DISCOVERY FAILED: no 12/12 program in L<=6\n"); return 1; }
  // ---- Promote to learner-owned workspace (C0-A artifact) ----
  let W:[]u8=z_alloc(256*40);
  materialize(W, found_prog, L, 0);
  emit("MATERIALIZED PROC root node 0, cells 1.."); e64(L); emit(" (rung A)\n");
  // ---- Phase 4 + P-MUL1 ----
  let p1:i32=test_pmul1(W);
  // P-MUL1 probe score for P-MUL5 margin: recompute count.
  let mul_score:i32=0;
  let k:i32=0;
  while(k<8){ if(ws_exec(W, pr_x(k), pr_y(k))==pr_p(k)){ mul_score=mul_score+1; } k=k+1; }
  let scaling_ok:i32=0;
  if(ws_exec(W, 13, 17)==221){ scaling_ok=1; }
  // ---- P-MUL2 ----
  let p2:i32=test_pmul2(W, p1, scaling_ok);
  // ---- P-MUL4 transfer (before ablation; needs PROC) ----
  let p4:i32=test_pmul4(W);
  // ---- P-MUL5 lookup control ----
  let p5:i32=test_pmul5(mul_score);
  // ---- P-MUL3 ablation (last: destroys the PROC) ----
  let p3:i32=test_pmul3(W);
  // ---- Oracle audit 3: shuffled rerun ----
  shuffle_packed(tried_packed, tried); // znc:allow A0102
  let sh_prog:[]u8=z_alloc(8*4);
  let sh_L:i32=search_shuffled(tried_packed, tried, sh_prog);
  emit("SHUFFLED rerun promoted L="); e64(sh_L); emit(": ");
  if(sh_L>0){ print_prog(sh_prog, sh_L); }
  emit("\n");
  let sh_ok:i32=0;
  if(sh_L>0){
    // Verify the shuffled-promoted program satisfies P-MUL1 via a fresh workspace.
    let W2:[]u8=z_alloc(256*40);
    materialize(W2, sh_prog, sh_L, 0);
    let sc2:i32=0;
    let q:i32=0;
    while(q<8){ if(ws_exec(W2, pr_x(q), pr_y(q))==pr_p(q)){ sc2=sc2+1; } q=q+1; }
    if(sc2>=7 && ws_exec(W2, 13, 17)==221){ sh_ok=1; }
    emit("SHUFFLED P-MUL1 check: "); e64(sc2); emit("/8 scaling=");
    e64(ws_exec(W2, 13, 17)); emit("\n");
  }
  if(sh_ok==1){ emit("ORACLE-AUDIT-3 PASS (order not load-bearing)\n"); }
  else { emit("ORACLE-AUDIT-3 FAIL\n"); }
  // ---- Template-contamination note (prereg section 5) ----
  // Researcher commitments: vocabulary (7 cell types), K=8 bound (L<=6 used),
  // frame model (x,y inputs; r,c slots), length-first lexicographic order.
  // Learner decisions visible in PROMOTED graph: which INITs, which TEST
  // (TEST_CY vs TEST_CX), which ACCUM (ACCUM_RX vs ACCUM_RY), STEP placement,
  // GOTO target. At least one is required; the trace shows all.
  emit("SUMMARY P-MUL1="); e64(p1); emit(" P-MUL2="); e64(p2);
  emit(" P-MUL3="); e64(p3); emit(" P-MUL4="); e64(p4);
  emit(" P-MUL5="); e64(p5); emit(" SHUFFLED="); e64(sh_ok); emit("\n");
  let total:i32=p1+p2+p3+p4+p5+sh_ok;
  emit("MUL1-BUILD tests passed: "); e64(total); emit("/6\n");
  return 0;
}

// ur_main.zag -- GEN-R restriction-experiment driver.
// Runs the predicted-handshake-restricted GEN on U's exact test battery:
// P1, P2a, P2b, P3 (fresh arenas), then P5 on the P2b arena (sequential
// contract growth), then the census. Mirrors the collapse battery driver
// (uc_uni.zag main) problem-for-problem so blocks compare directly.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=gen_solve(A1,B,c,61,1,1,65,2);
  c=gen_report(A1,B,c,"GENR","P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=gen_solve(A2,B,c,41,1,2,2,4);
  c=gen_report(A2,B,c,"GENR","P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=gen_solve(A3,B,c,41,1,2,2,4);
  c=gen_report(A3,B,c,"GENR","P2b");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=gen_solve(A4,B,c,31,1,2,2,4);
  c=gen_report(A4,B,c,"GENR","P3");
  setup_p5extra(A3);
  c=gen_solve(A3,B,c,51,1,2,3,4);
  c=gen_report(A3,B,c,"GENR","P5");
  c=gen_census(A3,B,c,4);
  o_flush(B,c);
  return 0;
}

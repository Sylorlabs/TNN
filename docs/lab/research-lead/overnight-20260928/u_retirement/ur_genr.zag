// ur_genr.zag -- GEN-R: the frozen GEN composer (gen_statefix/gsf_gen.zag)
// with ONE compile-time parameter restriction: predicted-handshake admission
// (U's rule: query kinds vs learned masks) instead of GEN's observed-kind
// checking (pool value kind vs inmask). This is the "predicted handshake"
// leg of the retirement restriction claim:
//   U = GEN restricted to (single-round linear pool, predicted handshake,
//                          stateless trial enumeration).
// Everything else is byte-identical to frozen GEN: rounds over the value
// pool, pool growth, INTER/INTER2 logging, tried1/tried2 tables with the
// GEN-STATEFIX per-query reset, failure-triggered widening (admission-off
// phase), provenance-closure success-recording. No new mechanism, no modes,
// no flags at runtime: ur_predicted() is a compile-time constant.
// GEN scratch (arena 1024..3916; zeroed by world_new; untouched by U):
//   1024: V pool, 64 x 4 bytes            1280: K kinds, 64 x 4
//   1536: P provenance, 64 x 3 x 4       2304: tried1, 4 x 64 x 4 bytes
//   3328: tried2 count; 3332: entries, 64 x 4
//   3588: nv   3592: widened flag        3596: visit stack, 64 x 1 byte
//   3660: done set, 64 x 1 byte (ends 3724 < 4096; u8-packed because the
//   i32 layout overflowed the arena by 12 bytes, found in testing)
fn ur_predicted()i32 { return 1; }
fn gvb(A:[]u8,off:i32)i32 { return A[off] as i32; }
fn svb(A:[]u8,off:i32,v:i32)void { A[off]=v as u8; return; }
fn g_khas(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn gV(A:[]u8,i:i32)i32 { return get32(A,1024+i*4); }
fn gK(A:[]u8,i:i32)i32 { return get32(A,1280+i*4); }
fn gP(A:[]u8,i:i32,f:i32)i32 { return get32(A,1536+(i*3+f)*4); }
fn gnv(A:[]u8)i32 { return get32(A,3588); }
fn tried1_g(A:[]u8,m:i32,i:i32)i32 { return get32(A,2304+(m*64+i)*4); }
fn tried1_s(A:[]u8,m:i32,i:i32)void { set32(A,2304+(m*64+i)*4,1); return; }
fn garity(A:[]u8,m:i32)i32 {
  if(mg(A,m,0)==4){ return 2; }
  return 1;
}
fn tried2_has(A:[]u8,m:i32,i:i32,j:i32)i32 {
  let e:i32=m*4096+i*64+j;
  let n:i32=get32(A,3328);
  let k:i32=0;
  while(k<n){
    if(get32(A,3332+k*4)==e){ return 1; }
    k=k+1;
  }
  return 0;
}
fn tried2_add(A:[]u8,m:i32,i:i32,j:i32)void {
  let n:i32=get32(A,3328);
  if(n<64){
    set32(A,3332+n*4,m*4096+i*64+j);
    set32(A,3328,n+1);
  }
  return;
}
// Add v to the pool (or return its existing index). Records provenance.
fn gen_addval(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)i32 {
  let n:i32=get32(A,3588);
  let k:i32=0;
  while(k<n){
    if(get32(A,1024+k*4)==v){ return k; }
    k=k+1;
  }
  if(n<64){
    set32(A,1024+n*4,v);
    set32(A,1280+n*4,pkind(A,v));
    set32(A,1536+(n*3+0)*4,m);
    set32(A,1536+(n*3+1)*4,i1);
    set32(A,1536+(n*3+2)*4,i2);
    set32(A,3588,n+1);
    return n;
  }
  return -1;
}
// Observe the successful app, then every app in its dependency closure.
fn gen_record(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)void {
  let d:i32=0;
  while(d<64){ svb(A,3660+d,0); d=d+1; }
  if(i2<0){ observe(A,m,gV(A,i1),v); }
  if(i2>=0){ observe2(A,m,gV(A,i1),gV(A,i2),v); }
  let sp:i32=0;
  svb(A,3596+sp,i1); sp=sp+1;
  if(i2>=0){ svb(A,3596+sp,i2); sp=sp+1; }
  while(sp>0){
    sp=sp-1;
    let x:i32=gvb(A,3596+sp);
    let ok:i32=0;
    if(x>0){ if(gvb(A,3660+x)==0){ ok=1; } }
    if(ok==1){
      svb(A,3660+x,1);
      let pm:i32=gP(A,x,0);
      if(pm>=0){
        let pi1:i32=gP(A,x,1);
        let pi2:i32=gP(A,x,2);
        if(pi2<0){ observe(A,pm,gV(A,pi1),gV(A,x)); }
        if(pi2>=0){ observe2(A,pm,gV(A,pi1),gV(A,pi2),gV(A,x)); }
        svb(A,3596+sp,pi1); sp=sp+1;
        if(pi2>=0){ svb(A,3596+sp,pi2); sp=sp+1; }
      }
    }
  }
  return;
}
fn gen_app1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32)i32 {
  tried1_s(A,m,i);
  ap(A,936,ag(A,936)+1);
  let v:i32=exec_map(A,m,gV(A,i));
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,-1,v);
    ap(A,944,v); ap(A,940,1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,-1,v); }
  return c;
}
fn gen_cell1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32,kin:i32,kout:i32)i32 {
  if(tried1_g(A,m,i)==1){ return c; }
  let adm:i32=1;
  if(get32(A,3592)==0){
    if(ur_predicted()==1){
      // RESTRICTION (U's predicted handshake): admit iff the QUERY kinds
      // are compatible with the MAP's learned masks. The observed kind of
      // the pool value is not consulted.
      if(g_khas(mg(A,m,3),kin)==0){ adm=0; }
      if(g_khas(mg(A,m,4),kout)==0){ adm=0; }
    } else {
      if(g_khas(mg(A,m,3),gK(A,i))==0){ adm=0; }
    }
  }
  if(adm==0){ return c; }
  c=gen_app1(A,B,c,m,i,exp);
  return c;
}
fn gen_m1(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32,kin:i32,kout:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    c=gen_cell1(A,B,c,m,i,exp,kin,kout);
    if(ag(A,940)==1){ return c; }
    i=i+1;
  }
  return c;
}
fn gen_app2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  tried2_add(A,m,i,j);
  ap(A,936,ag(A,936)+1);
  let v:i32=exec_map2(A,m,gV(A,i),gV(A,j));
  c=o_app(B,c,"INTER2="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,j,v);
    ap(A,944,v); ap(A,940,1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,j,v); }
  return c;
}
fn gen_cell2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  if(tried2_has(A,m,i,j)==1){ return c; }
  let adm:i32=1;
  if(get32(A,3592)==0){
    let a:i32=g_khas(mg(A,m,3),gK(A,i));
    let b:i32=g_khas(m2g(A,m,0),gK(A,j));
    if(a==0){ adm=0; }
    if(b==0){ adm=0; }
  }
  if(adm==0){ return c; }
  c=gen_app2(A,B,c,m,i,j,exp);
  return c;
}
fn gen_m2(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    let j:i32=0;
    while(j<ns0){
      c=gen_cell2(A,B,c,m,i,j,exp);
      if(ag(A,940)==1){ return c; }
      j=j+1;
    }
    i=i+1;
  }
  return c;
}
fn gen_round(A:[]u8,B:[]u8,c:i32,ns0:i32,exp:i32,nm:i32,kin:i32,kout:i32)i32 {
  let m:i32=0;
  while(m<nm){
    if(garity(A,m)==1){
      c=gen_m1(A,B,c,m,ns0,exp,kin,kout);
      if(ag(A,940)==1){ return c; }
    }
    m=m+1;
  }
  let m2:i32=0;
  while(m2<nm){
    if(garity(A,m2)==2){
      c=gen_m2(A,B,c,m2,ns0,exp);
      if(ag(A,940)==1){ return c; }
    }
    m2=m2+1;
  }
  return c;
}
fn gen_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  set32(A,1024,s); set32(A,1280,pkind(A,s));
  set32(A,1536,-1); set32(A,1540,-1); set32(A,1544,-1);
  set32(A,3588,1);
  set32(A,3592,0);
  // GEN-STATEFIX: per-query tried-state scoping. Clear tried1 (2304..3328)
  // and tried2 (count at 3328) so a later query on the same arena
  // re-enumerates the trial space. Contract-growth state lives in the
  // census-visible masks, not in these tables.
  let zti:i32=0;
  while(zti<256){
    set32(A,2304+zti*4,0);
    zti=zti+1;
  }
  set32(A,3328,0);
  let round:i32=0;
  while(round<6){
    round=round+1;
    let ns0:i32=gnv(A);
    let nt0:i32=ag(A,936);
    c=gen_round(A,B,c,ns0,exp,nm,kin,kout);
    if(ag(A,940)==1){ return c; }
    let nt1:i32=ag(A,936);
    let nv1:i32=gnv(A);
    let quiet:i32=0;
    if(nt1==nt0){ if(nv1==ns0){ quiet=1; } }
    if(quiet==1){
      if(get32(A,3592)==0){
        set32(A,3592,1);
        c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
      } else {
        return c;
      }
    }
  }
  return c;
}
fn gen_report(A:[]u8,B:[]u8,c:i32,arm:[]u8,prob:[]u8)i32 {
  c=o_app(B,c,"ARM="); c=o_app(B,c,arm); c=o_app(B,c," PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64); c=o_nl(B,c);
  return c;
}
fn gen_census(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"CENSUS m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," inmask="); c=o_i64(B,c,mg(A,m,3) as i64);
    c=o_app(B,c," outmask="); c=o_i64(B,c,mg(A,m,4) as i64);
    c=o_app(B,c," inmask2="); c=o_i64(B,c,m2g(A,m,0) as i64);
    c=o_app(B,c," n="); c=o_i64(B,c,mg(A,m,9) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}

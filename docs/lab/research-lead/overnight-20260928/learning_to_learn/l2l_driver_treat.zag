// l2l_driver_treat.zag -- learning-to-learn driver, TREATMENT arm.
// Family 1: 5 plen-5 chain problems (subjects 101-105).
// 20-event interference gap.
// Family 2: 5 NEW plen-5 chain problems (subjects 201-205), fresh literals.
// Per-problem: rebind tries, trial occurrence, total verifies.
fn l2l_stat(W:[]u8,fi:i32,pi:i32,expect:i32,ans:i32)void {
  let rbt:i32=hg(W,56); let rbr:i32=hg(W,60);
  let st:i32=hg(W,16); let lt:i32=st/1024; let lr:i32=st-lt*1024;
  let trial:i32=0;
  if(rbt==-1){ emit("F"); e64(fi); emit("-P"); e64(pi); emit(" ACT-HIT\n"); return; }
  if(lt!=rbt || lr!=rbr){ trial=1; }
  let total:i32=rbt;
  if(trial==1){ total=rbt+lt; }
  emit("F"); e64(fi); emit("-P"); e64(pi);
  emit(" ans="); e64(ans); emit(" expect="); e64(expect);
  emit(" rb_tried="); e64(rbt); emit(" rb_rej="); e64(rbr);
  emit(" trial="); e64(trial);
  emit(" total="); e64(total); emit("\n");
  return;
}
fn l2l_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn l2l_distractors(W:[]u8)void {
  // 2 plen-3 chains, subjects 10-11. Verbatim from pc_distractors.
  let i:i32=0;
  while(i<2){
    let s:i32=10+i; let a:i32=110+i*10; let b:i32=111+i*10;
    ev_teach(W,s,1,a); ev_teach(W,a,1,b);
    let q:i32=ev_query(W,s,61,b,0);
    emit("D3-"); e64(i); emit(" ans="); e64(q); emit("\n");
    i=i+1;
  }
  // 2 plen-4 chains, subjects 20-21.
  i=0;
  while(i<2){
    let s:i32=20+i; let a:i32=120+i*10; let b:i32=121+i*10; let c:i32=122+i*10;
    ev_teach(W,s,1,a); ev_teach(W,a,1,b); ev_teach(W,b,1,c);
    let q:i32=ev_query(W,s,62,c,0);
    emit("D4-"); e64(i); emit(" ans="); e64(q); emit("\n");
    i=i+1;
  }
  return;
}
fn l2l_gap(W:[]u8,seed:i32,n:i32)void {
  let i:i32=0; let r:i32=60;
  while(i<n){
    ev_teach(W,5000+seed*50+i,r,6000+seed*50+i);
    r=r+1; if(r>69){r=60;}
    i=i+1;
  }
  return;
}
// One family problem: subject s, literal base L, true endpoint L+4.
// Teaches true plen-5 path + plen-3 distractor + plen-4 distractor, queries.
fn l2l_problem(W:[]u8,fi:i32,pi:i32,s:i32,L:i32)void {
  ev_teach(W,s,1,L+1); ev_teach(W,L+1,1,L+2);
  ev_teach(W,L+2,1,L+3); ev_teach(W,L+3,1,L+4);
  ev_teach(W,s,1,L+101); ev_teach(W,L+101,1,L+102);
  ev_teach(W,s,1,L+201); ev_teach(W,L+201,1,L+202); ev_teach(W,L+202,1,L+203);
  hs(W,56,-1); hs(W,60,-1);
  let q:i32=ev_query(W,s,50,L+4,0);
  l2l_stat(W,fi,pi,L+4,q);
  return;
}
fn l2l_family(W:[]u8,fi:i32,s0:i32,L0:i32)void {
  let i:i32=0;
  while(i<5){
    // Stride 300 > 203 (max distractor offset) keeps literal ranges disjoint
    // across problems, avoiding duplicate-FACT path inflation in t2_gather.
    l2l_problem(W,fi,i,s0+i,L0+i*300);
    l2l_gap(W,fi*10+i,5);
    i=i+1;
  }
  return;
}
// Ablation hook: no-op in treatment, deletes type-14 links in ablation.
fn l2l_abl_hook(W:[]u8)void { return; }
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("L2L-START treat\n");
  l2l_distractors(W);
  emit("LINK14 after distractors="); e64(l2l_count14(W)); emit("\n");
  l2l_family(W,1,101,1100);
  emit("LINK14 after F1="); e64(l2l_count14(W)); emit("\n");
  l2l_gap(W,90,20);
  l2l_abl_hook(W);
  emit("LINK14 after hook="); e64(l2l_count14(W)); emit("\n");
  l2l_family(W,2,201,3100);
  emit("LINK14 after F2="); e64(l2l_count14(W)); emit("\n");
  emit("L2L-END\n");
  return 0;
}

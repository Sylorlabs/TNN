// world3d.zag — ENVIRONMENT for H-CAUSALV delay world.
// Implements the TRUE dynamics (may contain the tested regularity).
// charge (action 4): no immediate change; schedules lamp:=1 two steps later.
// pending counter: set to 2 on charge; each episode decrements it;
// when it reaches 0, lamp := 1. Non-stacking.
// Prints the frozen obs3d T-lines to stdout.
// Pure Zag.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn main()i32 {
  // script: (t,p,l,a) x 12
  let sc:[]u8=z_alloc(48);
  sc[0]=0; sc[1]=0; sc[2]=0; sc[3]=3;
  sc[4]=0; sc[5]=0; sc[6]=0; sc[7]=3;
  sc[8]=0; sc[9]=0; sc[10]=0; sc[11]=0;
  sc[12]=1; sc[13]=0; sc[14]=0; sc[15]=0;
  sc[16]=0; sc[17]=0; sc[18]=0; sc[19]=4;
  sc[20]=0; sc[21]=0; sc[22]=0; sc[23]=3;
  sc[24]=0; sc[25]=0; sc[26]=0; sc[27]=3;
  sc[28]=0; sc[29]=0; sc[30]=1; sc[31]=3;
  sc[32]=2; sc[33]=0; sc[34]=0; sc[35]=4;
  sc[36]=2; sc[37]=0; sc[38]=0; sc[39]=0;
  sc[40]=2; sc[41]=0; sc[42]=0; sc[43]=0;
  sc[44]=1; sc[45]=0; sc[46]=1; sc[47]=0;
  let pend:i32=0;
  let k:i32=0;
  while(k<12){
    let t:i32=sc[k*4] as i32;
    let p:i32=sc[k*4+1] as i32;
    let l:i32=sc[k*4+2] as i32;
    let a:i32=sc[k*4+3] as i32;
    let nt:i32=t; let np:i32=p; let nl:i32=l;
    if(a==0){ if(nt<2){nt=nt+1;} }
    else if(a==1){ if(nt>0){nt=nt-1;} }
    else if(a==2){ np=1; }
    else if(a==3){ np=0; }
    else if(a==4){
      if(pend==0){ pend=2; }
    }
    // delayed effect: decrement after the action's own update;
    // charge's own episode does not decrement (pending starts next step)
    if(a!=4 && pend>0){
      pend=pend-1;
      if(pend==0){ nl=1; }
    }
    emit("T "); e64(t); emit(" "); e64(p); emit(" "); e64(l);
    emit(" | "); e64(a); emit(" | ");
    e64(nt); emit(" "); e64(np); emit(" "); e64(nl); emit("\n");
    k=k+1;
  }
  return 0;
}

// baselines3.zag — two NON-causal baselines for H-CAUSALV.
// Derived from causal/baselines.zag with the action dimension extended 4->5
// (actions 0..4; charge=4 appears in obs3d). Both baseline algorithms unchanged.
// Pure Zag. These implement the preregistered B-memorize and B-unconditional.
// Usage: baselines <obs.txt> <probe.txt>
// Output: per-probe predictions for each baseline, and accuracy vs obs-derived truth.
//
// B-memorize: exact (state,action) -> next_state lookup. Unknown -> WITHHOLD.
// B-unconditional: per (action,var): majority vote of (ns[var]-s[var]) delta
//   across ALL episodes with that action (no conditioning). Predicts s+delta.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn parse_int(b:[]u8, p:i32, val:[]u8)i32 {
  while(p<b.len && (b[p] as i32)<=32){p=p+1;}
  let v:i32=0;
  while(p<b.len && b[p]>=48 && b[p]<=57){
    v=v*10+((b[p] as i32)-48); p=p+1;
  }
  set32(val,0,v);
  return p;
}

// memorize table: 5 actions * 3*2*2 states = 120 entries; seen flag + ns
// unconditional: counts[5][3][5] for delta -2..2

fn main()i32 {
  let obsp:[]u8=_zag_arg(1);
  let prbp:[]u8=_zag_arg(2);
  if(obsp.len==0 || prbp.len==0){
    emit("usage: baselines <obs.txt> <probe.txt>\n");
    return 1;
  }
  // mem: seen[96], mem_ns[96*3]
  let seen:[]u8=z_alloc(120);
  let memns:[]u8=z_alloc(360);
  // unc: cnt[4*3*5]
  let cnt:[]u8=z_alloc(5*3*5*4);
  let data:[]u8=_zag_read_file(obsp);
  let p:i32=0;
  let pv:[]u8=z_alloc(4);
  let ne:i32=0;
  while(p<data.len){
    while(p<data.len && (data[p] as i32)<=32){p=p+1;}
    if(p>=data.len){break;}
    if((data[p] as i32)==35){while(p<data.len && data[p]!=10){p=p+1;}continue;}
    if((data[p] as i32)==84){
      p=p+1;
      p=parse_int(data,p,pv); let t:i32=get32(pv,0);
      p=parse_int(data,p,pv); let pr:i32=get32(pv,0);
      p=parse_int(data,p,pv); let l:i32=get32(pv,0);
      while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
      p=parse_int(data,p,pv); let a:i32=get32(pv,0);
      while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
      p=parse_int(data,p,pv); let nt:i32=get32(pv,0);
      p=parse_int(data,p,pv); let npr:i32=get32(pv,0);
      p=parse_int(data,p,pv); let nl:i32=get32(pv,0);
      let si:i32=a*24+t*4+pr*2+l;
      seen[si]=1;
      memns[si*3]=nt as u8; memns[si*3+1]=npr as u8; memns[si*3+2]=nl as u8;
      // unconditional counts
      let v:i32=0;
      while(v<3){
        let sv:i32=0; let nv2:i32=0;
        if(v==0){sv=t;nv2=nt;} else if(v==1){sv=pr;nv2=npr;} else {sv=l;nv2=nl;}
        let d:i32=nv2-sv+2; // 0..4
        if(d>=0 && d<=4){
          let ci:i32=(a*3+v)*5+d;
          set32(cnt,ci*4,get32(cnt,ci*4)+1);
        }
        v=v+1;
      }
      ne=ne+1;
    } else {while(p<data.len && data[p]!=10){p=p+1;}}
  }
  emit("# baselines trained on "); e64(ne); emit(" episodes\n");
  // probes
  let pd:[]u8=_zag_read_file(prbp);
  p=0;
  emit("=== BASELINE PROBES ===\n");
  while(p<pd.len){
    while(p<pd.len && (pd[p] as i32)<=32){p=p+1;}
    if(p>=pd.len){break;}
    if((pd[p] as i32)==35){while(p<pd.len && pd[p]!=10){p=p+1;}continue;}
    if((pd[p] as i32)==81){
      p=p+1;
      p=parse_int(pd,p,pv); let s0:i32=get32(pv,0);
      p=parse_int(pd,p,pv); let s1:i32=get32(pv,0);
      p=parse_int(pd,p,pv); let s2:i32=get32(pv,0);
      while(p<pd.len && ((pd[p] as i32)<=32 || pd[p]==124)){p=p+1;}
      p=parse_int(pd,p,pv); let a:i32=get32(pv,0);
      emit("Q ("); e64(s0); emit(" "); e64(s1); emit(" "); e64(s2); emit(") | "); e64(a);
      // B-memorize
      let si:i32=a*24+s0*4+s1*2+s2;
      emit(" Bmem=");
      if(seen[si]==1){
        emit("("); e64(memns[si*3] as i32); emit(" "); e64(memns[si*3+1] as i32); emit(" "); e64(memns[si*3+2] as i32); emit(")");
      } else {emit("WITHHOLD");}
      // B-unconditional
      emit(" Bunc=(");
      let v:i32=0;
      while(v<3){
        let sv:i32=0;
        if(v==0){sv=s0;} else if(v==1){sv=s1;} else {sv=s2;}
        let best:i32=0; let bestc:i32=-1;
        let d:i32=0;
        while(d<=4){
          let ci:i32=(a*3+v)*5+d;
          let c:i32=get32(cnt,ci*4);
          if(c>bestc){bestc=c;best=d-2;}
          d=d+1;
        }
        let nv2:i32=sv+best;
        if(nv2<0){nv2=0;}
        if(v==0 && nv2>2){nv2=2;}
        if(v>0 && nv2>1){nv2=1;}
        if(v>0){emit(" ");}
        e64(nv2);
        v=v+1;
      }
      emit(")\n");
    } else {while(p<pd.len && pd[p]!=10){p=p+1;}}
  }
  return 0;
}

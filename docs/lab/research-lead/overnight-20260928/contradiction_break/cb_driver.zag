// ===== CONTRADICTION BREAK DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original test main removed).
// Cognition code untouched. Tests whether a contradicting observation breaks
// the confirmed bootstrap loop (ee7815de8), how the break happens, whether it
// is robust, and what recovery requires.
//
// Design:
// Phase 1: seed 3 genuine observations (1001/1002/1003, r=50, v=42).
// Phase 2: query 4 fresh subjects (2001..2004) to establish the self-loop.
// Phase 3: CONTRADICTION via ev_teach(3001,50,99) - a conflicting observation
//          for the same relation. It becomes the most-recent scan entry.
// Phase 4: query 4 fresh subjects (2005..2008). If the unanimity gate works,
//          bootstrap returns -2 (99 breaks unanimity). No new FACT taught.
// Phase 5: persistence - query 2 more fresh subjects (2009,2010). Loop
//          should stay broken (contradiction still tops the window).
// Phase 6: RECOVERY - externally teach 6 more 42-facts (4001..4006). These
//          push 99 out of the cap-6 window. Query 2 fresh subjects
//          (2011,2012). If unanimity restores, bootstrap fires again.
// Phase 7: SECOND CONTRADICTION via ev_observe on an existing 42-subject
//          (2001,50,99). This routes through the contradiction machinery
//          (revise_on_contradict). Query 1 fresh subject (2013).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Replicate the bootstrap_miss evidence scan for relation r:
// most-recent-first (indices 1023 down to 2), live tag-1 nodes, up to 6.
// For each counted node report index, subject, object.
fn scan_win(W:[]u8,p:[]u8,r:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r){
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

fn cb_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: 3 genuine seeds, value 42.
  let g1:i32=ev_teach(W,1001,50,42); rep("C","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("C","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("C","g3",g3);
  // Phase 2: establish the loop with 4 fresh-subject queries.
  let i:i32=0;
  while(i<4){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("C q"); e64(i); emit("="); e64(q); emit("\n");
    scan_win(W,"C",50,i);
    i=i+1;
  }
  // Phase 3: CONTRADICTION. Teach a conflicting observation for r=50.
  let cx:i32=ev_teach(W,3001,50,99); rep("C","contra_idx",cx);
  emit("C CONTRA-TAUGHT\n");
  scan_win(W,"C",50,50);
  // Phase 4: 4 fresh queries. Expect -2 (unanimity broken by 99).
  i=0;
  while(i<4){
    let q2:i32=ev_query(W,2005+i,50,-2,0);
    emit("C b"); e64(i); emit("="); e64(q2); emit("\n");
    scan_win(W,"C",50,60+i);
    i=i+1;
  }
  // Phase 5: persistence. 2 more fresh queries; loop should stay broken.
  i=0;
  while(i<2){
    let q3:i32=ev_query(W,2009+i,50,-2,0);
    emit("C p"); e64(i); emit("="); e64(q3); emit("\n");
    i=i+1;
  }
  scan_win(W,"C",50,70);
  // Phase 6: RECOVERY. Externally teach six 42-facts to push 99 out.
  i=0;
  while(i<6){
    let t:i32=ev_teach(W,4001+i,50,42);
    emit("C rec"); e64(i); emit(" idx="); e64(t); emit("\n");
    i=i+1;
  }
  scan_win(W,"C",50,80);
  i=0;
  while(i<2){
    let q4:i32=ev_query(W,2011+i,50,-2,0);
    emit("C r"); e64(i); emit("="); e64(q4); emit("\n");
    scan_win(W,"C",50,90+i);
    i=i+1;
  }
  // Phase 7: SECOND CONTRADICTION via ev_observe on existing 42-subject.
  // activate(2001,50) hits the self-generated 42-fact; observing 99
  // triggers revise_on_contradict and teaches (2001,50,99).
  let ob:i32=ev_observe(W,2001,50,99); rep("C","observe_ret",ob);
  emit("C OBSERVE-CONTRA\n");
  scan_win(W,"C",50,100);
  let q5:i32=ev_query(W,2013,50,-2,0);
  emit("C f0="); e64(q5); emit("\n");
  scan_win(W,"C",50,110);
  emit("CONTRADICTION-BREAK-DONE\n");
  return 0;
}
fn main()i32 { return cb_main(); }

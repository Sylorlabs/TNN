// Appended to generic method functions before main.
// State cells: value, violations, blocked, committed effects. Policy: multiply allowed, low, high.
fn put(S:[]u8,i:i32,v:i32)void {wset(S,i,v);return;}
fn dispatch(S:[]u8,P:[]u8,token:i32,perm:i32,guard:i32)i32 {
  let canonical:i32=token/6;let exposed:i32=canonical;
  if(perm==1){exposed=1-canonical;}
  let resolved:i32=exposed;if(perm==1){resolved=1-exposed;}
  let arg:i32=token%6-2;let old:i32=wget(S,0);let next:i32=old+arg;
  if(resolved==1){next=old*arg;}
  let forbidden:i32=0;
  if(resolved==1 && wget(P,0)==0){forbidden=1;}
  if(next<wget(P,1) || next>wget(P,2)){forbidden=1;}
  if(guard==1 && forbidden==1){put(S,2,wget(S,2)+1);return 0;}
  let effect:i32=wget(S,3);put(S,4+effect*2,resolved);put(S,5+effect*2,next);
  put(S,0,next);put(S,3,effect+1);
  if(forbidden==1){put(S,1,wget(S,1)+1);}
  return 1;
}
fn encode(id:i32,T:[]u8)i32 {
  if(id<0){return 0;}if(id<12){put(T,0,id);return 1;}
  let n:i32=id-12;put(T,0,n/12);put(T,1,n%12);return 2;
}
fn act_tokens(S:[]u8,P:[]u8,T:[]u8,n:i32,perm:i32,guard:i32)i32 {
  let i:i32=0;while(i<n){let ok:i32=dispatch(S,P,wget(T,i),perm,guard);if(ok==0){return 0;}i=i+1;}return 1;
}
fn act(S:[]u8,P:[]u8,id:i32,perm:i32,guard:i32)i32 {
  let T:[]u8=z_alloc(8);let n:i32=encode(id,T);if(n==0){put(S,2,1);return 0;}
  return act_tokens(S,P,T,n,perm,guard);
}
fn policy()[]u8 {let P:[]u8=z_alloc(12);put(P,0,1);put(P,1,-1000);put(P,2,1000);return P;}
fn world(x:i32)[]u8 {let S:[]u8=z_alloc(40);put(S,0,x);return S;}
fn restricted_find(P:[]u8,x:i32,target:i32)i32 {
  let id:i32=0;while(id<156){let S:[]u8=world(x);let ok:i32=act(S,P,id,0,1);if(ok==1 && wget(S,0)==target){return id;}id=id+1;}return -1;
}
// Distinct stored paths: direct ID, alias indirection, serialized replay, nested two-child plan.
fn path_exec(path:i32,S:[]u8,P:[]u8,id:i32,perm:i32,guard:i32)i32 {
  if(path==0){return act(S,P,id,perm,guard);}
  if(path==1){let store:[]u8=z_alloc(8);put(store,0,1);put(store,1,id);let ptr:i32=wget(store,0);return act(S,P,wget(store,ptr),perm,guard);}
  if(path==2){let cache:[]u8=z_alloc(8);let count:i32=encode(id,cache);return act_tokens(S,P,cache,count,perm,guard);}
  let children:[]u8=z_alloc(8);let count:i32=encode(id,children);let i:i32=0;
  while(i<count){let child:i32=act(S,P,wget(children,i),perm,guard);if(child==0){return 0;}i=i+1;}return 1;
}
fn main()i32 {
  let O:[]u8=z_alloc(65536);let c:i32=0;let unexpected:i32=0;
  let F:[]u8=z_alloc(24);train(F,2,1);let W:[]u8=z_alloc(4);let learned:i32=acquire(F,3,W);
  let P:[]u8=policy();let success:i32=0;let rivalsuccess:i32=0;let facts:i32=0;let erased:i32=0;
  let x:i32=5;
  while(x<=12){
    let S:[]u8=world(x);let ok:i32=act(S,P,learned,0,1);let goal:i32=2*x+1;
    let target:i32=affine(F,x);let rivalid:i32=restricted_find(P,x,target);
    let R:[]u8=world(x);let rok:i32=act(R,P,rivalid,0,1);
    if(ok==1 && wget(S,0)==goal){success=success+1;}
    if(rok==1 && wget(R,0)==goal){rivalsuccess=rivalsuccess+1;}
    if(lookup(F,3,x)==goal){facts=facts+1;}
    let E:[]u8=world(x);let eok:i32=act(E,P,-1,0,1);if(eok==1 && wget(E,0)==goal){erased=erased+1;}
    c=met(O,c,"actuation initial=",x);c=met(O,c," final=",wget(S,0));c=met(O,c," goal=",goal);
    c=met(O,c," effects=",wget(S,3));c=met(O,c," op1=",wget(S,4));c=met(O,c," state1=",wget(S,5));c=met(O,c," op2=",wget(S,6));c=met(O,c," state2=",wget(S,7));c=met(O,c," violations=",wget(S,1));c=met(O,c," rival_final=",wget(R,0));c=o_nl(O,c);
    x=x+1;
  }
  c=met(O,c,"actuation_summary learned=",success);c=met(O,c," interpolation_search=",rivalsuccess);
  c=met(O,c," facts=",facts);c=met(O,c," erased=",erased);c=o_nl(O,c);
  if(success!=8 || rivalsuccess!=8 || facts!=0 || erased!=0){unexpected=unexpected+1;}
  let BP:[]u8=policy();put(BP,1,0);put(BP,2,4);
  let endpoint:[]u8=world(3);let guarded:[]u8=world(3);let safe:[]u8=world(3);
  // Program132: multiply2 then add-2; independent expected transition3->6->4.
  let endpoint_admitted:i32=0;if(execute(132,3)==4){endpoint_admitted=1;}
  let unguardedok:i32=act(endpoint,BP,132,0,0);let guardok:i32=act(guarded,BP,132,0,1);let safeok:i32=act(safe,BP,3,0,1);
  c=met(O,c,"endpoint_attack admitted=",endpoint_admitted);c=met(O,c," endpoint_final=",wget(endpoint,0));
  c=met(O,c," endpoint_violations=",wget(endpoint,1));c=met(O,c," endpoint_state1=",wget(endpoint,5));c=met(O,c," endpoint_state2=",wget(endpoint,7));c=met(O,c," guarded_final=",wget(guarded,0));
  c=met(O,c," guarded_blocked=",wget(guarded,2));c=met(O,c," guarded_violations=",wget(guarded,1));c=met(O,c," safe_final=",wget(safe,0));c=o_nl(O,c);
  if(endpoint_admitted!=1 || unguardedok!=1 || wget(endpoint,0)!=4 || wget(endpoint,1)!=1){unexpected=unexpected+1;}
  if(guardok!=0 || wget(guarded,0)!=3 || wget(guarded,1)!=0 || wget(guarded,2)!=1 || safeok!=1 || wget(safe,0)!=4){unexpected=unexpected+1;}
  let perm:i32=0;
  while(perm<2){
    let path:i32=0;
    while(path<4){
      let RP:[]u8=policy();let proposal:[]u8=world(5);let admitted:i32=path_exec(path,proposal,RP,learned,perm,1);
      put(RP,0,0);let stale:[]u8=world(5);let fresh:[]u8=world(5);
      let staleok:i32=path_exec(path,stale,RP,learned,perm,0);let freshok:i32=path_exec(path,fresh,RP,learned,perm,1);
      c=met(O,c,"revocation perm=",perm);c=met(O,c," path=",path);c=met(O,c," prior_admitted=",admitted);
      c=met(O,c," stale_violations=",wget(stale,1));c=met(O,c," guarded_violations=",wget(fresh,1));
      c=met(O,c," guarded_blocked=",wget(fresh,2));c=met(O,c," guarded_final=",wget(fresh,0));c=o_nl(O,c);
      if(admitted!=1 || staleok!=1 || wget(stale,1)<1 || freshok!=0 || wget(fresh,1)!=0 || wget(fresh,2)!=1 || wget(fresh,0)!=5){unexpected=unexpected+1;}
      path=path+1;
    }
    perm=perm+1;
  }
  let RP:[]u8=policy();put(RP,0,0);let i:i32=0;
  while(i<3){let start:i32=1;if(i==1){start=5;}if(i==2){start=12;}
    let goal:i32=2*start+1;let id:i32=restricted_find(RP,start,goal);let S:[]u8=world(start);let ok:i32=act(S,RP,id,0,1);
    c=met(O,c,"recovery initial=",start);c=met(O,c," goal=",goal);c=met(O,c," acquired_id=",id);c=met(O,c," final=",wget(S,0));c=met(O,c," violations=",wget(S,1));c=o_nl(O,c);
    if(i<2){if(ok!=1 || wget(S,0)!=goal || wget(S,1)!=0){unexpected=unexpected+1;}}
    else {if(id!=-1 || ok!=0 || wget(S,0)!=12){unexpected=unexpected+1;}}
    i=i+1;
  }
  c=met(O,c,"instrumentation_unexpected=",unexpected);c=o_nl(O,c);_zag_print(O[0..c]);if(unexpected!=0){return 1;}return 0;
}

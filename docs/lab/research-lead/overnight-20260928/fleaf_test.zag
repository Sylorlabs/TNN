// SUPERSEDED (NQ5, 2026-09-29). DO NOT BUILD NEW WORK ON THIS FILE.
// Canonical implementation (bridge + discovery + router, unified):
//   docs/lab/research-lead/overnight-20260928/unified_learn.zag
// This file is the standalone H-BRIDGE experiment (7/7, bounded L2+ binary
// conditional revision). The bridge mechanism now lives in the canonical
// unified learner. This copy carries the old single-pass discovery search and
// will reproduce the 3-K overfit on uniform-length training. The N-first
// generality bias (H-GENBIAS, 4/4) exists only in the canonical implementation.
// Known open issue in this copy: F-LEAK (bridge store full leaves leaked
// subset procedures; see NQ4). Preserved as a historical record.
//
// bridge_learn.zag — Functional revision bridge.
// When procedure discovery fails, induce a conditional bridge rule:
//   IF input[pos]==val THEN proc_A ELSE proc_B
// The (pos, val) condition is LEARNED via search over the training data,
// not hardcoded. This addresses the H-REVISE architectural gap.
//
// Builds on integ_learn.zag (commit 492f5b01d).
// Prereg: PREREG_BRIDGE.md (commit 17d5de9f7, frozen before implementation).
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn wcopy(W:[]u8, off:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ W[off+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ PROCEDURE STORE (from integ_learn.zag, PROC_MAX=16) ============
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    if(peval(prog, nnodes, k, n)!=get32(seq, k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn PROC_MAX()i32 { return 16; }
fn PROC_SZ()i32 { return 64; }
fn proc_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*PROC_SZ();
}
fn proc_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot));
}
fn proc_set_used(W:[]u8, base:i32, slot:i32, v:i32)void {
  set32(W, proc_slot(W,base,slot), v);
  return;
}
fn proc_store(W:[]u8, base:i32, prog:[]u8, nnodes:i32)i32 {
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,base,s)==0){
      proc_set_used(W,base,s,1);
      set32(W, proc_slot(W,base,s)+4, nnodes);
      let i:i32=0;
      while(i<nnodes*3){
        W[proc_slot(W,base,s)+8+i]=prog[i];
        i=i+1;
      }
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn proc_nnodes(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot)+4);
}
fn peval_from_store(W:[]u8, base:i32, slot:i32, nnodes:i32, k:i32, n:i32)i32 {
  let tmp:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nnodes*3){
    tmp[i]=W[proc_slot(W,base,slot)+8+i];
    i=i+1;
  }
  return peval(tmp, nnodes, k, n);
}
fn proc_apply(W:[]u8, base:i32, slot:i32, inp:[]u8, out:[]u8)i32 {
  let nnodes:i32=proc_nnodes(W,base,slot);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_from_store(W, base, slot, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn pdiscover_direct(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      let slot:i32=proc_store(W, pbase, tmp, nn);
      return slot;
    }
    pi=pi+1;
  }
  return -1;
}

// pdiscover_dry: dry-run procedure discovery WITHOUT consuming proc slots.
// Identical search to pdiscover_direct (same enumeration order, same fit
// criteria), but on success copies the winning program bytes to out_prog
// (caller must allocate at least 48 bytes) and returns nnodes (>=0).
// On failure returns -1. NEVER calls proc_store.
// Used by bridge_learn Step 3 to test candidate (pos,val) splits without
// wasting slots on failed attempts (B-A6b fix).
fn pdiscover_dry(W:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      let i2:i32=0;
      while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
      return nn;
    }
    pi=pi+1;
  }
  return -1;
}

// ============ BRIDGE RULE STORE ============
// Rule: [used(4), cond_pos(4), cond_val(4), proc_true(4), proc_false(4)]
// Semantics: IF input[cond_pos]==cond_val THEN apply proc_true ELSE proc_false
fn BR_MAX()i32 { return 4; }
fn BR_SZ()i32 { return 20; }
fn br_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*BR_SZ();
}
fn br_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, br_slot(W,base,slot));
}
fn br_store(W:[]u8, base:i32, cpos:i32, cval:i32, pt:i32, pf:i32)i32 {
  let s:i32=0;
  while(s<BR_MAX()){
    if(br_used(W,base,s)==0){
      let o:i32=br_slot(W,base,s);
      set32(W,o,1); set32(W,o+4,cpos); set32(W,o+8,cval);
      set32(W,o+12,pt); set32(W,o+16,pf);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn br_count(W:[]u8, base:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<BR_MAX()){ if(br_used(W,base,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn br_cpos(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+4); }
fn br_cval(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+8); }
fn br_ptrue(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+12); }
fn br_pfalse(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+16); }

// bridge_apply: evaluate condition, dispatch to correct procedure.
// If input shorter than cond_pos, defaults to proc_false.
fn bridge_apply(W:[]u8, pbase:i32, bbase:i32, bslot:i32, inp:[]u8, out:[]u8)i32 {
  let cpos:i32=br_cpos(W,bbase,bslot);
  let cval:i32=br_cval(W,bbase,bslot);
  let pt:i32=br_ptrue(W,bbase,bslot);
  let pf:i32=br_pfalse(W,bbase,bslot);
  if(inp.len>cpos && (inp[cpos] as i32)==cval){
    return proc_apply(W, pbase, pt, inp, out);
  }
  return proc_apply(W, pbase, pf, inp, out);
}

// ============ BRIDGE LEARN ============
// pairs in W at pairbase: npairs * 16 bytes: (in_off, in_len, out_off, out_len)
// work: scratch area in W for seq data.
// Returns:
//   0..15: procedure slot (direct discovery succeeded, NO BRIDGE)
//   1000+bslot: bridge rule created
//   -1: failure
//
// The (pos, val) condition is discovered by searching over all input
// positions and all byte values present in the training data. No byte
// literals for condition values appear in this function.
fn bridge_learn(W:[]u8, pbase:i32, bbase:i32, pairbase:i32, npairs:i32, work:i32)i32 {
  let seqbase:i32=work;
  let statbase:i32=work + npairs*64;
  let lenbase:i32=statbase + npairs*4;

  // Step 1: extract all pairs
  let i:i32=0;
  let allok:i32=1;
  let maxlen:i32=0;
  while(i<npairs){
    let in_off:i32=get32(W, pairbase+i*16);
    let in_len:i32=get32(W, pairbase+i*16+4);
    let out_off:i32=get32(W, pairbase+i*16+8);
    let out_len:i32=get32(W, pairbase+i*16+12);
    if(in_len>maxlen){maxlen=in_len;}
    let sq:[]u8=z_alloc(64);
    let sl:i32=pextract(W[in_off..in_off+in_len], W[out_off..out_off+out_len], sq);
    if(sl<0){
      set32(W, statbase+i*4, 0);
      allok=0;
    } else {
      set32(W, statbase+i*4, 1);
      set32(W, lenbase+i*4, sl);
      let j:i32=0;
      while(j<sl*4){ W[seqbase+i*64+j]=sq[j]; j=j+1; }
    }
    i=i+1;
  }

  // Step 2: try direct discovery (only if all extracted)
  if(allok==1){
    let desc:[]u8=z_alloc(npairs*12);
    i=0;
    while(i<npairs){
      set32(desc, i*12, seqbase+i*64);
      set32(desc, i*12+4, get32(W, lenbase+i*4));
      set32(desc, i*12+8, get32(W, pairbase+i*16+4));
      i=i+1;
    }
    let slot:i32=pdiscover_direct(W, pbase, desc, npairs);
    if(slot>=0){
      return slot;
    }
  }

  // Step 3: bridge triggered. Search (pos, val).
  emit("bridge: direct failed, inducing condition...\n");
  let p:i32=0;
  while(p<maxlen){
    // All pairs must have in_len > p for this position to be usable
    let okp:i32=1;
    i=0;
    while(i<npairs){
      if(get32(W, pairbase+i*16+4)<=p){okp=0; break;}
      i=i+1;
    }
    if(okp==1){
      // Collect distinct byte values at position p (from data, not literals)
      let dvals:[]u8=z_alloc(128);
      let ndv:i32=0;
      i=0;
      while(i<npairs){
        let in_off:i32=get32(W, pairbase+i*16);
        let v:i32=W[in_off+p] as i32;
        let found:i32=0;
        let k:i32=0;
        while(k<ndv){
          if((dvals[k] as i32)==v){found=1; break;}
          k=k+1;
        }
        if(found==0){
          dvals[ndv]=v as u8;
          ndv=ndv+1;
        }
        i=i+1;
      }
      // Try each distinct value as the split point
      let vi:i32=0;
      while(vi<ndv){
        let v:i32=dvals[vi] as i32;
        let s1idx:[]u8=z_alloc(64);
        let s2idx:[]u8=z_alloc(64);
        let n1:i32=0;
        let n2:i32=0;
        i=0;
        while(i<npairs){
          // Only include extractable pairs
          if(get32(W, statbase+i*4)==1){
            let in_off:i32=get32(W, pairbase+i*16);
            if((W[in_off+p] as i32)==v){
              set32(s1idx, n1*4, i); n1=n1+1;
            } else {
              set32(s2idx, n2*4, i); n2=n2+1;
            }
          }
          i=i+1;
        }
        if(n1>0 && n2>0){
          let d1:[]u8=z_alloc(n1*12);
          let k:i32=0;
          while(k<n1){
            let pi:i32=get32(s1idx, k*4);
            set32(d1, k*12, seqbase+pi*64);
            set32(d1, k*12+4, get32(W, lenbase+pi*4));
            set32(d1, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          let d2:[]u8=z_alloc(n2*12);
          k=0;
          while(k<n2){
            let pi:i32=get32(s2idx, k*4);
            set32(d2, k*12, seqbase+pi*64);
            set32(d2, k*12+4, get32(W, lenbase+pi*4));
            set32(d2, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          // B-A6b fix: dry-run discovery WITHOUT consuming proc slots.
          // Failed split attempts must not waste slots. Slots are
          // reserved only for the winning (pos,val) split.
          let prog1:[]u8=z_alloc(48);
          let nn1:i32=pdiscover_dry(W, d1, n1, prog1);
          if(nn1>=0){
            let prog2:[]u8=z_alloc(48);
            let nn2:i32=pdiscover_dry(W, d2, n2, prog2);
            if(nn2>=0){
              // Winning split found. Now store both procedures.
              let s1:i32=proc_store(W, pbase, prog1, nn1);
              if(s1>=0){
                let s2:i32=proc_store(W, pbase, prog2, nn2);
                if(s2>=0){
                  let bs:i32=br_store(W, bbase, p, v, s1, s2);
                  if(bs>=0){
                    emit("bridge: learned IF input[");
                    emit(i32s(p));
                    emit("]==");
                    emit(i32s(v));
                    emit(" THEN proc");
                    emit(i32s(s1));
                    emit(" ELSE proc");
                    emit(i32s(s2));
                    emit("\n");
                    return 1000+bs;
                  }
                  // F-LEAK FIX (H-FLEAKFIX): bridge rule store full.
                  // Roll back both subset procedures: the failed attempt
                  // must waste zero proc slots (transactional).
                  proc_set_used(W, pbase, s2, 0);
                  proc_set_used(W, pbase, s1, 0);
                } else {
                  // F-LEAK FIX (H-FLEAKFIX): second proc store failed.
                  // Roll back the first: no partial allocation survives.
                  proc_set_used(W, pbase, s1, 0);
                }
              }
              // Store failed: slots genuinely exhausted. No other
              // (pos,val) can succeed either (all need 2 slots).
              return -1;
            }
          }
        }
        vi=vi+1;
      }
    }
    p=p+1;
  }
  return -1;
}


// ============ MAIN: F-LEAK attack tests ============
// K-F1a: bridge store FULL attack. Fills 4/4 bridge rules, then runs
//   bridge_learn on a conditional task. Requires rc=-1 and zero change
//   in proc used count.
// K-F1b: proc store NEARLY FULL attack. Fills 15/16 proc slots, then
//   runs bridge_learn on a conditional task. The second proc_store
//   must fail and the first must be rolled back: rc=-1, proc count
//   unchanged.
// K-F3: B-A6b 15-distractor regression. 15 broadcast-last distractors
//   with distinct pos-0 values plus one broadcast-first trigger.
//   Requires bridge rule created, 2/16 proc slots, dispatch correct.
fn proc_count_used(W:[]u8, pbase:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<PROC_MAX()){ if(proc_used(W,pbase,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn main()i32 {
  emit("=== F-LEAK attack tests ===\n");
  let pbase:i32=0;
  let bbase:i32=1024;
  let work:i32=2048;
  let pairbase:i32=8192;

  let npass:i32=0;
  let ntest:i32=0;

  // Dummy 1-node program for filling stores: [type 0 (k)]
  let dummy:[]u8=z_alloc(48);
  dummy[0]=0 as u8; dummy[1]=255 as u8; dummy[2]=255 as u8;

  // ---- K-F1a: bridge-full attack ----
  emit("\n--- K-F1a: bridge-full attack ---\n");
  let W:[]u8=z_alloc(65536);
  let strbase:i32=16384;
  let dp0:i32=proc_store(W, pbase, dummy, 1);
  let dp1:i32=proc_store(W, pbase, dummy, 1);
  let fr:i32=0;
  while(fr<4){
    br_store(W, bbase, 0, 120+fr, dp0, dp1);
    fr=fr+1;
  }
  let before_a:i32=proc_count_used(W, pbase);
  emit("bridge rules: ");
  emit(i32s(br_count(W, bbase)));
  emit(", proc used before: ");
  emit(i32s(before_a));
  emit("\n");
  // Task A conditional (would succeed if bridge store had space)
  let a_in0:i32=strbase; strbase=strbase+wcopy(W,strbase,"abc");
  let a_out0:i32=strbase; strbase=strbase+wcopy(W,strbase,"ccc");
  let a_in1:i32=strbase; strbase=strbase+wcopy(W,strbase,"def");
  let a_out1:i32=strbase; strbase=strbase+wcopy(W,strbase,"fff");
  let a_in2:i32=strbase; strbase=strbase+wcopy(W,strbase,"xab");
  let a_out2:i32=strbase; strbase=strbase+wcopy(W,strbase,"xxx");
  let a_in3:i32=strbase; strbase=strbase+wcopy(W,strbase,"xcd");
  let a_out3:i32=strbase; strbase=strbase+wcopy(W,strbase,"xxx");
  set32(W,pairbase+0,a_in0); set32(W,pairbase+4,3);
  set32(W,pairbase+8,a_out0); set32(W,pairbase+12,3);
  set32(W,pairbase+16,a_in1); set32(W,pairbase+20,3);
  set32(W,pairbase+24,a_out1); set32(W,pairbase+28,3);
  set32(W,pairbase+32,a_in2); set32(W,pairbase+36,3);
  set32(W,pairbase+40,a_out2); set32(W,pairbase+44,3);
  set32(W,pairbase+48,a_in3); set32(W,pairbase+52,3);
  set32(W,pairbase+56,a_out3); set32(W,pairbase+60,3);
  let ra:i32=bridge_learn(W,pbase,bbase,pairbase,4,work);
  let after_a:i32=proc_count_used(W, pbase);
  ntest=ntest+1;
  if(ra==-1 && after_a==before_a){
    emit("K-F1a: rc=-1, proc used unchanged (");
    emit(i32s(before_a));
    emit("->");
    emit(i32s(after_a));
    emit("). PASS\n");
    npass=npass+1;
  } else {
    emit("K-F1a: rc=");
    emit(i32s(ra));
    emit(" proc ");
    emit(i32s(before_a));
    emit("->");
    emit(i32s(after_a));
    emit(" FAIL (leaked ");
    emit(i32s(after_a-before_a));
    emit(" slots)\n");
  }

  // ---- K-F1b: proc-nearly-full attack ----
  emit("\n--- K-F1b: proc-nearly-full attack ---\n");
  let W2:[]u8=z_alloc(65536);
  let s2b:i32=16384;
  let f:i32=0;
  while(f<15){
    proc_store(W2, pbase, dummy, 1);
    f=f+1;
  }
  let before_b:i32=proc_count_used(W2, pbase);
  emit("proc used before: ");
  emit(i32s(before_b));
  emit(", bridge rules: ");
  emit(i32s(br_count(W2, bbase)));
  emit("\n");
  let b_in0:i32=s2b; s2b=s2b+wcopy(W2,s2b,"abc");
  let b_out0:i32=s2b; s2b=s2b+wcopy(W2,s2b,"ccc");
  let b_in1:i32=s2b; s2b=s2b+wcopy(W2,s2b,"def");
  let b_out1:i32=s2b; s2b=s2b+wcopy(W2,s2b,"fff");
  let b_in2:i32=s2b; s2b=s2b+wcopy(W2,s2b,"xab");
  let b_out2:i32=s2b; s2b=s2b+wcopy(W2,s2b,"xxx");
  let b_in3:i32=s2b; s2b=s2b+wcopy(W2,s2b,"xcd");
  let b_out3:i32=s2b; s2b=s2b+wcopy(W2,s2b,"xxx");
  set32(W2,pairbase+0,b_in0); set32(W2,pairbase+4,3);
  set32(W2,pairbase+8,b_out0); set32(W2,pairbase+12,3);
  set32(W2,pairbase+16,b_in1); set32(W2,pairbase+20,3);
  set32(W2,pairbase+24,b_out1); set32(W2,pairbase+28,3);
  set32(W2,pairbase+32,b_in2); set32(W2,pairbase+36,3);
  set32(W2,pairbase+40,b_out2); set32(W2,pairbase+44,3);
  set32(W2,pairbase+48,b_in3); set32(W2,pairbase+52,3);
  set32(W2,pairbase+56,b_out3); set32(W2,pairbase+60,3);
  let rb:i32=bridge_learn(W2,pbase,bbase,pairbase,4,work);
  let after_b:i32=proc_count_used(W2, pbase);
  ntest=ntest+1;
  if(rb==-1 && after_b==before_b){
    emit("K-F1b: rc=-1, proc used unchanged (");
    emit(i32s(before_b));
    emit("->");
    emit(i32s(after_b));
    emit("). PASS\n");
    npass=npass+1;
  } else {
    emit("K-F1b: rc=");
    emit(i32s(rb));
    emit(" proc ");
    emit(i32s(before_b));
    emit("->");
    emit(i32s(after_b));
    emit(" FAIL\n");
  }

  // ---- K-F3: B-A6b 15-distractor ----
  emit("\n--- K-F3: B-A6b 15-distractor ---\n");
  let W3:[]u8=z_alloc(65536);
  let s3:i32=16384;
  let dchars:[]u8="abcdefghijklmno";
  let dc:i32=0;
  while(dc<15){
    let din:i32=s3;
    W3[s3]=dchars[dc]; s3=s3+1;
    W3[s3]=113 as u8; s3=s3+1;
    W3[s3]=98 as u8; s3=s3+1;
    let dout:i32=s3;
    W3[s3]=98 as u8; s3=s3+1;
    W3[s3]=98 as u8; s3=s3+1;
    W3[s3]=98 as u8; s3=s3+1;
    set32(W3,pairbase+dc*16,din); set32(W3,pairbase+dc*16+4,3);
    set32(W3,pairbase+dc*16+8,dout); set32(W3,pairbase+dc*16+12,3);
    dc=dc+1;
  }
  let tin:i32=s3;
  W3[s3]=120 as u8; s3=s3+1;
  W3[s3]=97 as u8; s3=s3+1;
  W3[s3]=98 as u8; s3=s3+1;
  let tout:i32=s3;
  W3[s3]=120 as u8; s3=s3+1;
  W3[s3]=120 as u8; s3=s3+1;
  W3[s3]=120 as u8; s3=s3+1;
  set32(W3,pairbase+15*16,tin); set32(W3,pairbase+15*16+4,3);
  set32(W3,pairbase+15*16+8,tout); set32(W3,pairbase+15*16+12,3);
  let r3:i32=bridge_learn(W3,pbase,bbase,pairbase,16,work);
  let used3:i32=proc_count_used(W3, pbase);
  ntest=ntest+1;
  if(r3>=1000 && used3==2 && br_count(W3,bbase)==1){
    let q1:[]u8="xqw";
    let o1:[]u8=z_alloc(4);
    let q2:[]u8="abc";
    let o2:[]u8=z_alloc(4);
    if(bridge_apply(W3,pbase,bbase,r3-1000,q1,o1)==1 &&
       bridge_apply(W3,pbase,bbase,r3-1000,q2,o2)==1 &&
       streq(o1[0..3],"xxx")==1 && streq(o2[0..3],"ccc")==1){
      emit("K-F3: bridge rule ");
      emit(i32s(r3-1000));
      emit(", 2/16 slots, dispatch xqw->xxx abc->ccc. PASS\n");
      npass=npass+1;
    } else {
      emit("K-F3: dispatch wrong: ");
      emit(o1[0..3]);
      emit(" / ");
      emit(o2[0..3]);
      emit(" FAIL\n");
    }
  } else {
    emit("K-F3: r3=");
    emit(i32s(r3));
    emit(" used=");
    emit(i32s(used3));
    emit(" bridges=");
    emit(i32s(br_count(W3,bbase)));
    emit(" FAIL\n");
  }

  emit("\n=== F-LEAK RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(ntest));
  emit(" ===\n");
  if(npass==ntest){
    emit("H-FLEAKFIX K-F1/K-F3 PASS\n");
    return 0;
  }
  emit("H-FLEAKFIX KILLED\n");
  return 1;
}

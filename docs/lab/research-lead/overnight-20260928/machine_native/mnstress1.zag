// mnstress1.zag -- Machine-Native Advantage Stress Test (MNSTRESS-1).
// Pure Zag. No Python anywhere.
//
// A synthetic epistemic world (1000 entities, 5000 relations, 240 sources,
// 500 deliberate contradictions, temporal supersessions, delayed
// corrections, derivation rules with contextual exceptions, junk
// interference) is generated deterministically from a fixed seed. An
// epistemic engine ingests the claims incrementally and maintains exact
// provenance, unresolved contradictions, dependency-tracked derived
// beliefs, and hypothesis pairs. Seven query types probe the epistemic
// state. Three honest baselines (flat, last-write-wins, no-provenance)
// show which query types REQUIRE the epistemic machinery.
//
// Modes: no args = full self-test (KB1-KB6, KB8 + in-memory KB7
// round-trip); "dump <dir>" = ingest, write state.bin + answers.txt;
// "load <dir>" = read state.bin, write answers.txt (fresh-process reload).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn e64(v:i64)void { emit(i64s(v)); return; }
fn e32(v:i32)void { emit(i64s(v as i64)); return; }
fn eln()void { emit("\n"); return; }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn get32(b:[]u8,i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8,i:i32,v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=(ts[0] as i64)|((ts[1] as i64)<<8)|((ts[2] as i64)<<16)|((ts[3] as i64)<<24)|((ts[4] as i64)<<32)|((ts[5] as i64)<<40)|((ts[6] as i64)<<48)|((ts[7] as i64)<<56);
  let ns:i64=(ts[8] as i64)|((ts[9] as i64)<<8)|((ts[10] as i64)<<16)|((ts[11] as i64)<<24)|((ts[12] as i64)<<32)|((ts[13] as i64)<<40)|((ts[14] as i64)<<48)|((ts[15] as i64)<<56);
  z_free(ts);
  return sec*1000+ns/1000000;
}
fn peak_rss()i64 {
  let d:[]u8=read_file("/proc/self/status");
  let p:i32=findsub(d,0,"VmHWM:");
  if(p<0){return 0;}
  let s:i32=p+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// xorshift32 PRNG, deterministic
fn rng_next(st:[]u8)i32 {
  let x:i32=get32(st,0);
  x=x^(x<<13);
  x=x^(x>>17);
  x=x^(x<<5);
  if(x<0){x=-(x+1);}
  set32(st,0,x);
  return x;
}
fn rng_range(st:[]u8,n:i32)i32 {
  if(n<1){return 0;}
  return rng_next(st)%n;
}
// ============ constants ============
fn SEED()i32 { return 20260930; }
fn NENT()i32 { return 1000; }
fn NATTR()i32 { return 8; }
fn NVAL()i32 { return 8; }
fn NSRC()i32 { return 240; }
fn NCONTRA()i32 { return 500; }
fn NTEMP()i32 { return 60; }
fn NCORR()i32 { return 40; }
fn NRELS()i32 { return 5000; }
fn NJUNK()i32 { return 2000; }
fn NBASE()i32 { return 5000; }
fn NWAR()i32 { return 80; }
fn MAXCLAIM()i32 { return 14000; }
fn NSLOT()i32 { return 8000; }
// claim field offsets (40 bytes)
fn CF_ID()i32 { return 0; }
fn CF_KIND()i32 { return 4; }
fn CF_E1()i32 { return 8; }
fn CF_A()i32 { return 12; }
fn CF_V()i32 { return 16; }
fn CF_E2()i32 { return 20; }
fn CF_SRC()i32 { return 24; }
fn CF_SEQ()i32 { return 28; }
fn CF_FLAGS()i32 { return 32; }
fn CF_NEXT()i32 { return 36; }
fn CSZ()i32 { return 40; }
// slot field offsets (24 bytes)
fn SF_VAL()i32 { return 0; }
fn SF_STATUS()i32 { return 4; }
fn SF_SUPH()i32 { return 8; }
fn SF_SUPC()i32 { return 12; }
fn SF_CONH()i32 { return 16; }
fn SF_CONC()i32 { return 20; }
fn SSZ()i32 { return 24; }
// derived field offsets (32 bytes)
fn DF_KIND()i32 { return 0; }
fn DF_E1()i32 { return 4; }
fn DF_A()i32 { return 8; }
fn DF_V()i32 { return 12; }
fn DF_B1()i32 { return 16; }
fn DF_B2()i32 { return 20; }
fn DF_CTX()i32 { return 24; }
fn DF_ACT()i32 { return 28; }
fn DSZ()i32 { return 32; }
fn MAXDER()i32 { return 4000; }
// flags
fn FL_CONTRA()i32 { return 1; }
fn FL_SUPSED()i32 { return 2; }
fn FL_CORRT()i32 { return 4; }
fn FL_ISCORR()i32 { return 16; }
fn FL_WDRAWN()i32 { return 32; }


// ============ world generation ============
// Temp claim: 32 bytes: kind(0) e1(4) a(8) v(12) e2(16) src(20) round(24) aux(28)
fn TCSZ()i32 { return 32; }
fn tc_emit(tmp:[]u8,nc:[]u8,kind:i32,e1:i32,a:i32,v:i32,e2:i32,src:i32,round:i32,aux:i32)i32 {
  let n:i32=get32(nc,0);
  let b:i32=n*32;
  set32(tmp,b+0,kind); set32(tmp,b+4,e1); set32(tmp,b+8,a);
  set32(tmp,b+12,v); set32(tmp,b+16,e2); set32(tmp,b+20,src);
  set32(tmp,b+24,round); set32(tmp,b+28,aux);
  set32(nc,0,n+1);
  return n;
}
fn order_by_round(tmp:[]u8,n:i32,order:[]u8)void {
  let r:i32=0;
  let at:i32=0;
  while(r<10){
    let i:i32=0;
    while(i<n){
      if(get32(tmp,i*32+24)==r){ set32(order,at*4,i); at=at+1; }
      i=i+1;
    }
    r=r+1;
  }
  return;
}
// Fill final claims pool (40B) from temp order; build tmp->final map.
fn finalize_claims(tmp:[]u8,order:[]u8,n:i32,claims:[]u8,idxmap:[]u8)void {
  let p:i32=0;
  while(p<n){
    let t:i32=get32(order,p*4);
    let b:i32=p*40;
    set32(claims,b+0,p);
    set32(claims,b+4,get32(tmp,t*32+0));
    set32(claims,b+8,get32(tmp,t*32+4));
    set32(claims,b+12,get32(tmp,t*32+8));
    set32(claims,b+16,get32(tmp,t*32+12));
    set32(claims,b+20,get32(tmp,t*32+16));
    set32(claims,b+24,get32(tmp,t*32+20));
    set32(claims,b+28,p);
    set32(claims,b+32,get32(tmp,t*32+28));
    set32(claims,b+36,-1);
    set32(idxmap,t*4,p);
    p=p+1;
  }
  return;
}
// contra_recs: 500x12 (slot, tmpA, tmpB) -> filled with final ids after finalize
// temp_recs: 60x12 (slot, tmp1, tmp2); corr_recs: 40x12 (tgt_tmp, new_v, corr_tmp)
// war_pairs: 80x8 (a, b)
// cnt: n_kind0(0) n_kind1(4) n_kind2(8) n_kind3(12)
fn gen_world(rng:[]u8,tmp:[]u8,ntmp:[]u8,
             contra_recs:[]u8,temp_recs:[]u8,corr_recs:[]u8,war_pairs:[]u8,
             true_val:[]u8,src_rel:[]u8,cnt:[]u8,
             dedrec:[]u8,ndedc:[]u8)void {
  let i:i32=0;
  while(i<8000){ set32(true_val,i*4,rng_range(rng,8)); i=i+1; }
  let s:i32=0;
  while(s<240){ set32(src_rel,s*4,1+((s*7+3)%5)); s=s+1; }
  // high-reliability source for corrections
  let hisrc:i32=0;
  s=0;
  while(s<240){ if(get32(src_rel,s*4)==5){hisrc=s;} s=s+1; }
  let used:[]u8=z_alloc(8000);
  // special Q5 entities
  let specY:[]u8=z_alloc(20*4);
  i=0;
  while(i<20){
    let y:i32=rng_range(rng,1000);
    let taken:i32=0;
    let k:i32=0;
    while(k<i){ if(get32(specY,k*4)==y){taken=1;} k=k+1; }
    if(taken==0){ set32(specY,i*4,y); i=i+1; }
  }
  // located-in pairs (rel 3): 600; first 40 attach to special Ys
  let locX:[]u8=z_alloc(600*4);
  let locY:[]u8=z_alloc(600*4);
  let nl:i32=0;
  i=0;
  while(i<20){
    let y:i32=get32(specY,i*4);
    let j:i32=0;
    while(j<2){
      let x:i32=rng_range(rng,1000);
      if(x!=y){
        set32(locX,nl*4,x); set32(locY,nl*4,y); nl=nl+1; j=j+1;
      }
    }
    i=i+1;
  }
  while(nl<600){
    let x:i32=rng_range(rng,1000);
    let y:i32=rng_range(rng,1000);
    if(x!=y){ set32(locX,nl*4,x); set32(locY,nl*4,y); nl=nl+1; }
  }
  // contradiction slots
  let ncr:i32=0;
  i=0;
  while(i<20){
    let slot:i32=get32(specY,i*4)*8+5;
    used[slot]=1;
    set32(contra_recs,ncr*12,slot);
    ncr=ncr+1; i=i+1;
  }
  while(ncr<500){
    let e:i32=rng_range(rng,1000);
    let a:i32=rng_range(rng,8);
    let slot:i32=e*8+a;
    if(used[slot]==0){
      used[slot]=1;
      set32(contra_recs,ncr*12,slot);
      ncr=ncr+1;
    }
  }
  // temporal slots
  let ntp:i32=0;
  while(ntp<60){
    let e:i32=rng_range(rng,1000);
    let a:i32=rng_range(rng,8);
    let slot:i32=e*8+a;
    if(used[slot]==0){
      used[slot]=1;
      set32(temp_recs,ntp*12,slot);
      ntp=ntp+1;
    }
  }
  // emit contradiction claims
  i=0;
  while(i<500){
    let slot:i32=get32(contra_recs,i*12);
    let e:i32=slot/8;
    let a:i32=slot%8;
    let vA:i32=get32(true_val,slot*4);
    let vB:i32=(vA+3)%8;
    let sA:i32=rng_range(rng,240);
    let sB:i32=rng_range(rng,240);
    while(sB==sA){ sB=rng_range(rng,240); }
    let tA:i32=tc_emit(tmp,ntmp,0,e,a,vA,0,sA,rng_range(rng,7),0);
    let tB:i32=tc_emit(tmp,ntmp,0,e,a,vB,0,sB,2+rng_range(rng,6),0);
    set32(contra_recs,i*12+4,tA);
    set32(contra_recs,i*12+8,tB);
    i=i+1;
  }
  // emit temporal claims
  i=0;
  while(i<60){
    let slot:i32=get32(temp_recs,i*12);
    let e:i32=slot/8;
    let a:i32=slot%8;
    let v1:i32=get32(true_val,slot*4);
    let v2:i32=(v1+4)%8;
    let t1:i32=tc_emit(tmp,ntmp,0,e,a,v1,0,rng_range(rng,240),rng_range(rng,5),0);
    let t2:i32=tc_emit(tmp,ntmp,0,e,a,v2,0,rng_range(rng,240),5+rng_range(rng,4),1);
    set32(temp_recs,i*12+4,t1);
    set32(temp_recs,i*12+8,t2);
    i=i+1;
  }
  // dedicated habitat claims for located-in Ys (skip special Ys: contra covers them)
  let habdone:[]u8=z_alloc(1000);
  let nded:i32=0;
  i=0;
  while(i<600){
    let y:i32=get32(locY,i*4);
    let is_spec:i32=0;
    let k:i32=0;
    while(k<20){ if(get32(specY,k*4)==y){is_spec=1;} k=k+1; }
    if(is_spec==0 && habdone[y]==0 && used[y*8+5]==0){
      habdone[y]=1;
      used[y*8+5]=1;
      let h:i32=rng_range(rng,8);
      let th:i32=tc_emit(tmp,ntmp,0,y,5,h,0,rng_range(rng,240),0,0);
      let dn:i32=get32(ndedc,0);
      set32(dedrec,dn*4,th);
      set32(ndedc,0,dn+1);
      nded=nded+1;
    }
    i=i+1;
  }
  z_free(habdone);
  // descended chains (R3): 200 x (X descended-from Y) + dedicated origin (Y,2,O)
  let orgdone:[]u8=z_alloc(1000);
  let ndc:i32=0;
  while(ndc<200){
    let x:i32=rng_range(rng,1000);
    let y:i32=rng_range(rng,1000);
    if(x!=y && orgdone[y]==0 && used[y*8+2]==0){
      orgdone[y]=1;
      used[y*8+2]=1;
      tc_emit(tmp,ntmp,1,x,4,y,0,rng_range(rng,240),1+rng_range(rng,6),0);
      let o:i32=rng_range(rng,8);
      let to:i32=tc_emit(tmp,ntmp,0,y,2,o,0,rng_range(rng,240),0,0);
      let dn:i32=get32(ndedc,0);
      set32(dedrec,dn*4,to);
      set32(ndedc,0,dn+1);
      nded=nded+1;
      ndc=ndc+1;
    }
  }
  z_free(orgdone);
  // allied chains (R2): 200 x (X allied Y),(Y allied Z); first 40 (X,Z) -> wartime
  let nwar:i32=0;
  let nac:i32=0;
  while(nac<200){
    let x:i32=rng_range(rng,1000);
    let y:i32=rng_range(rng,1000);
    let z:i32=rng_range(rng,1000);
    if(x!=y && y!=z && x!=z){
      tc_emit(tmp,ntmp,1,x,0,y,0,rng_range(rng,240),rng_range(rng,7),0);
      tc_emit(tmp,ntmp,1,y,0,z,0,rng_range(rng,240),rng_range(rng,7),0);
      if(nac<40){
        set32(war_pairs,nwar*8,x); set32(war_pairs,nwar*8+4,z); nwar=nwar+1;
      }
      nac=nac+1;
    }
  }
  // remaining wartime pairs: random
  while(nwar<80){
    let a:i32=rng_range(rng,1000);
    let b:i32=rng_range(rng,1000);
    if(a!=b){ set32(war_pairs,nwar*8,a); set32(war_pairs,nwar*8+4,b); nwar=nwar+1; }
  }
  // emit located-in rel claims
  i=0;
  while(i<600){
    tc_emit(tmp,ntmp,1,get32(locX,i*4),3,get32(locY,i*4),0,rng_range(rng,240),1+rng_range(rng,6),0);
    i=i+1;
  }
  // emit guaranteed locs for the 40 correction targets (dedrec[0..39])
  // these ensure R1 derivations exist for KB4
  let gi:i32=0;
  let gnd:i32=get32(ndedc,0);
  while(gi<40 && gi<gnd){
    let gt:i32=get32(dedrec,gi*4);
    let gy:i32=get32(tmp,gt*32+4);
    let gx:i32=900+gi;
    // only for hab targets (a=5); org targets use descended
    let ga:i32=get32(tmp,gt*32+8);
    if(ga==5){
      tc_emit(tmp,ntmp,1,gx,3,gy,0,rng_range(rng,240),1,0);
    }
    gi=gi+1;
  }
  // random allied / descended / other rels to reach 5000 total rel claims
  // rel so far: 200 desc + 400 allied-chain + 600 loc + up to 40 guaranteed = 1240; need 3760 more
  let nrel:i32=1240;
  while(nrel<5000){
    let r:i32=rng_range(rng,6);
    let x:i32=rng_range(rng,1000);
    let y:i32=rng_range(rng,1000);
    if(x!=y){
      tc_emit(tmp,ntmp,1,x,r,y,0,rng_range(rng,240),rng_range(rng,7),0);
      nrel=nrel+1;
    }
  }
  // random base attr claims to reach 6000 kind0 (excl corrections/junk)
  // kind0 so far: 1000 contra + 120 temp + nded dedicated
  let nattr:i32=1120+nded;
  // collect candidate target temp indices for corrections (kind0, non-contra, non-temp)
  let cand:[]u8=z_alloc(6000*4);
  let ncand:i32=0;
  while(nattr<6000){
    let e:i32=rng_range(rng,1000);
    let a:i32=rng_range(rng,8);
    let slot:i32=e*8+a;
    if(used[slot]==0){
      let t:i32=tc_emit(tmp,ntmp,0,e,a,get32(true_val,slot*4),0,rng_range(rng,240),rng_range(rng,7),0);
      if(ncand<6000){ set32(cand,ncand*4,t); ncand=ncand+1; }
      nattr=nattr+1;
    }
  }
  // slot counts over kind0 temp claims (for sole-claim correction targeting)
  let slotcnt:[]u8=z_alloc(8000*4);
  let ti:i32=0;
  let tn:i32=get32(ntmp,0);
  while(ti<tn){
    if(get32(tmp,ti*32+0)==0){
      let se:i32=get32(tmp,ti*32+4);
      let sa:i32=get32(tmp,ti*32+8);
      if(se>=0 && se<1000 && sa>=0 && sa<8){
        let sl2:i32=se*8+sa;
        set32(slotcnt,sl2*4,get32(slotcnt,sl2*4)+1);
      }
    }
    ti=ti+1;
  }
  // corrections: 40. ALL target derivation-relevant (dedicated hab/org) claims.
  i=0;
  while(i<40){
    let nd:i32=get32(ndedc,0);
    // use first 40 dedicated (unique by construction)
    let t:i32=get32(dedrec,i*4);
    let oldv:i32=get32(tmp,t*32+12);
    let newv:i32=(oldv+2)%8;
    let tc:i32=tc_emit(tmp,ntmp,3,t,0,newv,0,hisrc,7+rng_range(rng,3),1);
    set32(corr_recs,i*12,t);
    set32(corr_recs,i*12+4,newv);
    set32(corr_recs,i*12+8,tc);
    i=i+1;
  }
  z_free(cand);
  z_free(slotcnt);
  // junk: 2000 kind2
  i=0;
  while(i<2000){
    tc_emit(tmp,ntmp,2,rng_range(rng,1000),8+rng_range(rng,8),rng_range(rng,8),0,rng_range(rng,240),rng_range(rng,10),0);
    i=i+1;
  }
  z_free(specY);
  z_free(locX);
  z_free(locY);
  z_free(used);
  set32(cnt,0,6000);
  set32(cnt,4,5000);
  set32(cnt,8,2000);
  set32(cnt,12,40);
  return;
}

// ============ engine ============
// ENG buffer layout (single buffer, fixed offsets)
fn E_CLAIMS()i32 { return 0; }
fn E_SLOTS()i32 { return 560000; }
fn E_VALN()i32 { return 656000; }
fn E_DER()i32 { return 896000; }
fn E_DERREL()i32 { return 1024000; }
fn E_LOCX()i32 { return 1064000; }
fn E_LOCY()i32 { return 1066400; }
fn E_LOCC()i32 { return 1068800; }
fn E_ALLYX()i32 { return 1071200; }
fn E_ALLYY()i32 { return 1081600; }
fn E_ALLYC()i32 { return 1092000; }
fn E_DESCX()i32 { return 1102400; }
fn E_DESCY()i32 { return 1106400; }
fn E_DESCC()i32 { return 1110400; }
fn E_NDER()i32 { return 1114400; }
fn E_NDERREL()i32 { return 1114404; }
fn E_NLOC()i32 { return 1114408; }
fn E_NALLY()i32 { return 1114412; }
fn E_NDESC()i32 { return 1114416; }
fn E_NVALN()i32 { return 1114420; }
fn E_NCLAIM()i32 { return 1114424; }
fn E_WAR()i32 { return 1114428; }
fn E_SIZE()i32 { return 1116000; }
fn SLOTB()i32 { return 12; }
fn VNODEB()i32 { return 20; }
fn eng_get(eng:[]u8,off:i32)i32 { return get32(eng,off); }
fn eng_set(eng:[]u8,off:i32,v:i32)void { set32(eng,off,v); return; }
fn wartime(eng:[]u8,a:i32,b:i32)i32 {
  let i:i32=0;
  while(i<80){
    let x:i32=get32(eng,E_WAR()+i*8);
    let y:i32=get32(eng,E_WAR()+i*8+4);
    if((x==a && y==b)||(x==b && y==a)){return 1;}
    i=i+1;
  }
  return 0;
}
fn new_valnode(eng:[]u8,val:i32)i32 {
  let n:i32=get32(eng,E_NVALN());
  let b:i32=E_VALN()+n*20;
  set32(eng,b+0,val); set32(eng,b+4,-1); set32(eng,b+8,0);
  set32(eng,b+12,1); set32(eng,b+16,-1);
  set32(eng,E_NVALN(),n+1);
  return n;
}
fn valnode_find(eng:[]u8,slot:i32,val:i32)i32 {
  let h:i32=get32(eng,E_SLOTS()+slot*12);
  while(h>=0){
    let b:i32=E_VALN()+h*20;
    if(get32(eng,b+12)==1 && get32(eng,b+0)==val){return h;}
    h=get32(eng,b+16);
  }
  return -1;
}
fn valnode_append(eng:[]u8,vn:i32,cid:i32)void {
  let b:i32=E_VALN()+vn*20;
  let cb:i32=E_CLAIMS()+cid*40;
  set32(eng,cb+36,get32(eng,b+4));
  set32(eng,b+4,cid);
  set32(eng,b+8,get32(eng,b+8)+1);
  return;
}
// derivation of attribute beliefs
fn derive_attr(eng:[]u8,kind:i32,e1:i32,a:i32,v:i32,b1:i32,b2:i32,slotbase:i32)void {
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+28)==1 && get32(eng,b+4)==e1 && get32(eng,b+8)==a && get32(eng,b+12)==v && get32(eng,b+20)==b2){
      return;
    }
    i=i+1;
  }
  if(n>=4000){return;}
  let b:i32=E_DER()+n*32;
  set32(eng,b+0,kind); set32(eng,b+4,e1); set32(eng,b+8,a); set32(eng,b+12,v);
  set32(eng,b+16,b1); set32(eng,b+20,b2); set32(eng,b+24,slotbase); set32(eng,b+28,1);
  set32(eng,E_NDER(),n+1);
  return;
}
fn derive_rel(eng:[]u8,x:i32,z:i32,b1:i32,b2:i32)void {
  let n:i32=get32(eng,E_NDERREL());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DERREL()+i*20;
    if(get32(eng,b+16)==1 && get32(eng,b+0)==x && get32(eng,b+4)==z){return;}
    i=i+1;
  }
  if(n>=2000){return;}
  let b:i32=E_DERREL()+n*20;
  set32(eng,b+0,x); set32(eng,b+4,z); set32(eng,b+8,b1); set32(eng,b+12,b2); set32(eng,b+16,1);
  set32(eng,E_NDERREL(),n+1);
  return;
}
// re-derive all attribute beliefs whose base slot changed
fn rederive_slot(eng:[]u8,slot:i32)void {
  let e:i32=slot/8;
  let a:i32=slot%8;
  // deactivate old
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+24)==slot){set32(eng,b+28,0);}
    i=i+1;
  }
  if(a==5){
    // R1: for each X located-in e, for each active value of slot
    let nl:i32=get32(eng,E_NLOC());
    let j:i32=0;
    while(j<nl){
      if(get32(eng,E_LOCY()+j*4)==e){
        let x:i32=get32(eng,E_LOCX()+j*4);
        let lc:i32=get32(eng,E_LOCC()+j*4);
        let h:i32=get32(eng,E_SLOTS()+slot*12);
        while(h>=0){
          let vb:i32=E_VALN()+h*20;
          if(get32(eng,vb+12)==1){
            derive_attr(eng,0,x,5,get32(eng,vb+0),lc,get32(eng,vb+4),slot);
          }
          h=get32(eng,vb+16);
        }
      }
      j=j+1;
    }
  }
  if(a==2){
    // R3: for each X descended-from e
    let nd:i32=get32(eng,E_NDESC());
    let j:i32=0;
    while(j<nd){
      if(get32(eng,E_DESCY()+j*4)==e){
        let x:i32=get32(eng,E_DESCX()+j*4);
        let dc:i32=get32(eng,E_DESCC()+j*4);
        let h:i32=get32(eng,E_SLOTS()+slot*12);
        while(h>=0){
          let vb:i32=E_VALN()+h*20;
          if(get32(eng,vb+12)==1){
            derive_attr(eng,2,x,2,get32(eng,vb+0),dc,get32(eng,vb+4),slot);
          }
          h=get32(eng,vb+16);
        }
      }
      j=j+1;
    }
  }
  return;
}
fn ing_attr(eng:[]u8,src_rel:[]u8,cid:i32)void {
  let cb:i32=E_CLAIMS()+cid*40;
  let e:i32=get32(eng,cb+8);
  let a:i32=get32(eng,cb+12);
  let v:i32=get32(eng,cb+16);
  let is_update:i32=0;
  if((get32(eng,cb+32)&1)==1){is_update=1;}
  let slot:i32=e*8+a;
  let sb:i32=E_SLOTS()+slot*12;
  let vn:i32=valnode_find(eng,slot,v);
  if(vn>=0){
    valnode_append(eng,vn,cid);
  } else {
    if(is_update==1){
      // supersede all active valnodes
      let h:i32=get32(eng,sb+0);
      while(h>=0){
        let vb:i32=E_VALN()+h*20;
        if(get32(eng,vb+12)==1){
          set32(eng,vb+12,0);
          let c2:i32=get32(eng,vb+4);
          while(c2>=0){
            let c2b:i32=E_CLAIMS()+c2*40;
            set32(eng,c2b+32,get32(eng,c2b+32)|2);
            c2=get32(eng,c2b+36);
          }
        }
        h=get32(eng,vb+16);
      }
    }
    let nv:i32=new_valnode(eng,v);
    let nb:i32=E_VALN()+nv*20;
    set32(eng,nb+16,get32(eng,sb+0));
    set32(eng,sb+0,nv);
    valnode_append(eng,nv,cid);
  }
  // update status + cur
  let nact:i32=0;
  let best:i32=-1;
  let bestrel:i32=-1;
  let bestidx:i32=-1;
  let h2:i32=get32(eng,sb+0);
  while(h2>=0){
    let vb:i32=E_VALN()+h2*20;
    if(get32(eng,vb+12)==1){
      nact=nact+1;
      let rs:i32=0;
      let c3:i32=get32(eng,vb+4);
      while(c3>=0){
        let c3b:i32=E_CLAIMS()+c3*40;
        rs=rs+get32(src_rel,get32(eng,c3b+24)*4);
        c3=get32(eng,c3b+36);
      }
      if(rs>bestrel){bestrel=rs;best=get32(eng,vb+0);bestidx=h2;}
    }
    h2=get32(eng,vb+16);
  }
  if(nact>1){set32(eng,sb+8,1);} else {set32(eng,sb+8,0);}
  set32(eng,sb+4,bestidx);
  // derivations triggered by habitat / origin claims
  if(a==5 || a==2){ rederive_slot(eng,slot); }
  return;
}
fn ing_rel(eng:[]u8,cid:i32)void {
  let cb:i32=E_CLAIMS()+cid*40;
  let x:i32=get32(eng,cb+8);
  let r:i32=get32(eng,cb+12);
  let y:i32=get32(eng,cb+16);
  if(r==3){
    let n:i32=get32(eng,E_NLOC());
    if(n>=600){return;}
    set32(eng,E_LOCX()+n*4,x); set32(eng,E_LOCY()+n*4,y); set32(eng,E_LOCC()+n*4,cid);
    set32(eng,E_NLOC(),n+1);
    // R1: derive from current habitat values of y
    let slot:i32=y*8+5;
    let h:i32=get32(eng,E_SLOTS()+slot*12);
    while(h>=0){
      let vb:i32=E_VALN()+h*20;
      if(get32(eng,vb+12)==1){
        derive_attr(eng,0,x,5,get32(eng,vb+0),cid,get32(eng,vb+4),slot);
      }
      h=get32(eng,vb+16);
    }
  }
  if(r==0){
    let n:i32=get32(eng,E_NALLY());
    if(n>=2600){return;}
    set32(eng,E_ALLYX()+n*4,x); set32(eng,E_ALLYY()+n*4,y); set32(eng,E_ALLYC()+n*4,cid);
    set32(eng,E_NALLY(),n+1);
    // R2 forward: (x,y)+(y,z) -> (x,z)
    let j:i32=0;
    while(j<n){
      if(get32(eng,E_ALLYX()+j*4)==y){
        let z:i32=get32(eng,E_ALLYY()+j*4);
        if(z!=x && wartime(eng,x,z)==0){
          derive_rel(eng,x,z,cid,get32(eng,E_ALLYC()+j*4));
        }
      }
      j=j+1;
    }
    // R2 backward: (w,x)+(x,y) -> (w,y)
    j=0;
    while(j<n){
      if(get32(eng,E_ALLYY()+j*4)==x){
        let w:i32=get32(eng,E_ALLYX()+j*4);
        if(w!=y && wartime(eng,w,y)==0){
          derive_rel(eng,w,y,get32(eng,E_ALLYC()+j*4),cid);
        }
      }
      j=j+1;
    }
  }
  if(r==4){
    let n:i32=get32(eng,E_NDESC());
    if(n>=1000){return;}
    set32(eng,E_DESCX()+n*4,x); set32(eng,E_DESCY()+n*4,y); set32(eng,E_DESCC()+n*4,cid);
    set32(eng,E_NDESC(),n+1);
    let slot:i32=y*8+2;
    let h:i32=get32(eng,E_SLOTS()+slot*12);
    while(h>=0){
      let vb:i32=E_VALN()+h*20;
      if(get32(eng,vb+12)==1){
        derive_attr(eng,2,x,2,get32(eng,vb+0),cid,get32(eng,vb+4),slot);
      }
      h=get32(eng,vb+16);
    }
  }
  return;
}
fn ing_correct(eng:[]u8,src_rel:[]u8,cid:i32)void {
  let cb:i32=E_CLAIMS()+cid*40;
  let tgt:i32=get32(eng,cb+8);
  let newv:i32=get32(eng,cb+16);
  let tb:i32=E_CLAIMS()+tgt*40;
  // flag target corrected/superseded
  set32(eng,tb+32,get32(eng,tb+32)|4|2);
  let te:i32=get32(eng,tb+8);
  let ta:i32=get32(eng,tb+12);
  let slot:i32=te*8+ta;
  let sb:i32=E_SLOTS()+slot*12;
  // remove target from its valnode
  let h:i32=get32(eng,sb+0);
  while(h>=0){
    let vb:i32=E_VALN()+h*20;
    if(get32(eng,vb+12)==1){
      // unlink tgt from chain
      let prev:i32=-1;
      let c2:i32=get32(eng,vb+4);
      while(c2>=0){
        let c2b:i32=E_CLAIMS()+c2*40;
        let nx:i32=get32(eng,c2b+36);
        if(c2==tgt){
          if(prev<0){set32(eng,vb+4,nx);} else {set32(eng,E_CLAIMS()+prev*40+36,nx);}
          set32(eng,vb+8,get32(eng,vb+8)-1);
        } else {prev=c2;}
        c2=nx;
      }
      if(get32(eng,vb+8)<=0){set32(eng,vb+12,0);}
    }
    h=get32(eng,vb+16);
  }
  // ingest the corrected value as an update claim (reuse cid's own record)
  set32(eng,cb+8,te); set32(eng,cb+12,ta);
  set32(eng,cb+32,get32(eng,cb+32)|64);
  ing_attr(eng,src_rel,cid);
  return;
}

// ============ queries ============
// All queries write canonical text into out, return length.
fn isort(a:[]u8,n:i32)void {
  let i:i32=1;
  while(i<n){
    let k:i32=get32(a,i*4);
    let j:i32=i-1;
    while(j>=0 && get32(a,j*4)>k){ set32(a,(j+1)*4,get32(a,j*4)); j=j-1; }
    set32(a,(j+1)*4,k);
    i=i+1;
  }
  return;
}
fn q1(eng:[]u8,src_rel:[]u8,e:i32,a:i32,out:[]u8)i32 {
  let slot:i32=e*8+a;
  let sb:i32=E_SLOTS()+slot*12;
  let at:i32=app(out,0,"Q1 ");
  at=app(out,at,i64s(e as i64)); at=app(out,at," "); at=app(out,at,i64s(a as i64));
  let st:i32=get32(eng,sb+8);
  if(st==1){at=app(out,at," contested");}
  else {at=app(out,at," clean");}
  let h:i32=get32(eng,sb+0);
  while(h>=0){
    let vb:i32=E_VALN()+h*20;
    if(get32(eng,vb+12)==1){
      let rs:i32=0;
      let c:i32=get32(eng,vb+4);
      while(c>=0){
        let cb2:i32=E_CLAIMS()+c*40;
        rs=rs+get32(src_rel,get32(eng,cb2+24)*4);
        c=get32(eng,cb2+36);
      }
      at=app(out,at," ");
      at=app(out,at,i64s(get32(eng,vb+0) as i64));
      at=app(out,at,":");
      at=app(out,at,i64s(rs as i64));
    }
    h=get32(eng,vb+16);
  }
  return at;
}
// collect claim ids of slot into arr (active valnodes only); returns count
fn slot_claims(eng:[]u8,slot:i32,arr:[]u8) i32 {
  let sb:i32=E_SLOTS()+slot*12;
  let n:i32=0;
  let h:i32=get32(eng,sb+0);
  while(h>=0){
    let vb:i32=E_VALN()+h*20;
    if(get32(eng,vb+12)==1){
      let c:i32=get32(eng,vb+4);
      while(c>=0){
        set32(arr,n*4,c); n=n+1;
        c=get32(eng,E_CLAIMS()+c*40+36);
      }
    }
    h=get32(eng,vb+16);
  }
  return n;
}
fn q2(eng:[]u8,e:i32,a:i32,out:[]u8)i32 {
  let slot:i32=e*8+a;
  let arr:[]u8=z_alloc(64*4);
  let n:i32=slot_claims(eng,slot,arr);
  isort(arr,n);
  let at:i32=app(out,0,"Q2 ");
  at=app(out,at,i64s(e as i64)); at=app(out,at," "); at=app(out,at,i64s(a as i64));
  at=app(out,at," n="); at=app(out,at,i64s(n as i64)); at=app(out,at," ids=");
  let i:i32=0;
  while(i<n){
    if(i>0){at=app(out,at,",");}
    at=app(out,at,i64s(get32(arr,i*4) as i64));
    i=i+1;
  }
  z_free(arr);
  return at;
}
fn q3(eng:[]u8,src_rel:[]u8,e:i32,a:i32,out:[]u8)i32 {
  let slot:i32=e*8+a;
  let sb:i32=E_SLOTS()+slot*12;
  // top valnode by rel sum
  let best:i32=-1;
  let bestrel:i32=-1;
  let h:i32=get32(eng,sb+0);
  while(h>=0){
    let vb:i32=E_VALN()+h*20;
    if(get32(eng,vb+12)==1){
      let rs:i32=0;
      let c:i32=get32(eng,vb+4);
      while(c>=0){
        let cb2:i32=E_CLAIMS()+c*40;
        rs=rs+get32(src_rel,get32(eng,cb2+24)*4);
        c=get32(eng,cb2+36);
      }
      if(rs>bestrel){bestrel=rs;best=h;}
    }
    h=get32(eng,vb+16);
  }
  let arr:[]u8=z_alloc(64*4);
  let n:i32=0;
  h=get32(eng,sb+0);
  while(h>=0){
    let vb:i32=E_VALN()+h*20;
    if(get32(eng,vb+12)==1 && h!=best){
      let c:i32=get32(eng,vb+4);
      while(c>=0){
        set32(arr,n*4,c); n=n+1;
        c=get32(eng,E_CLAIMS()+c*40+36);
      }
    }
    h=get32(eng,vb+16);
  }
  isort(arr,n);
  let at:i32=app(out,0,"Q3 ");
  at=app(out,at,i64s(e as i64)); at=app(out,at," "); at=app(out,at,i64s(a as i64));
  at=app(out,at," ndis="); at=app(out,at,i64s(n as i64)); at=app(out,at," ids=");
  let i:i32=0;
  while(i<n){
    if(i>0){at=app(out,at,",");}
    at=app(out,at,i64s(get32(arr,i*4) as i64));
    i=i+1;
  }
  z_free(arr);
  return at;
}
fn q4(eng:[]u8,e:i32,a:i32,out:[]u8)i32 {
  let at:i32=app(out,0,"Q4 ");
  at=app(out,at,i64s(e as i64)); at=app(out,at," "); at=app(out,at,i64s(a as i64));
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+28)==1 && get32(eng,b+4)==e && get32(eng,b+8)==a){
      at=app(out,at," (");
      at=app(out,at,i64s(get32(eng,b+12) as i64));
      at=app(out,at,"<-");
      at=app(out,at,i64s(get32(eng,b+16) as i64));
      at=app(out,at,",");
      at=app(out,at,i64s(get32(eng,b+20) as i64));
      at=app(out,at,")");
    }
    i=i+1;
  }
  // derived relations from e
  let nr:i32=get32(eng,E_NDERREL());
  i=0;
  while(i<nr){
    let b:i32=E_DERREL()+i*20;
    if(get32(eng,b+16)==1 && get32(eng,b+0)==e){
      at=app(out,at," [rel->");
      at=app(out,at,i64s(get32(eng,b+4) as i64));
      at=app(out,at,"]");
    }
    i=i+1;
  }
  return at;
}
// Q5: for contested slot, find derived (e1,a) with >=2 distinct values from this slotbase
fn q5(eng:[]u8,slot:i32,out:[]u8)i32 {
  let at:i32=app(out,0,"Q5 ");
  at=app(out,at,i64s(slot as i64));
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+28)==1 && get32(eng,b+24)==slot){
      let e1:i32=get32(eng,b+4);
      let a:i32=get32(eng,b+8);
      let v:i32=get32(eng,b+12);
      // look for another derived same (e1,a), different v, same slotbase
      let j:i32=0;
      while(j<n){
        let b2:i32=E_DER()+j*32;
        if(j!=i && get32(eng,b2+28)==1 && get32(eng,b2+24)==slot &&
           get32(eng,b2+4)==e1 && get32(eng,b2+8)==a && get32(eng,b2+12)!=v){
          at=app(out,at," observe=(");
          at=app(out,at,i64s(e1 as i64)); at=app(out,at,","); at=app(out,at,i64s(a as i64));
          at=app(out,at,") H1="); at=app(out,at,i64s(v as i64));
          at=app(out,at," H2="); at=app(out,at,i64s(get32(eng,b2+12) as i64));
          return at;
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  at=app(out,at," none");
  return at;
}
// Q6: withdrawal impact of claim E
fn q6(eng:[]u8,cid:i32,out:[]u8)i32 {
  let sarr:[]u8=z_alloc(256*4);
  let darr:[]u8=z_alloc(256*4);
  let rarr:[]u8=z_alloc(256*4);
  let ns:i32=0;
  let nd:i32=0;
  let nr:i32=0;
  // slots containing cid
  let cb:i32=E_CLAIMS()+cid*40;
  let kind:i32=get32(eng,cb+4);
  if(kind==0 || kind==3){
    let e:i32=get32(eng,cb+8);
    let a:i32=get32(eng,cb+12);
    // correction claims were rewritten to te,ta; attribute claims have e,a
    if(e>=0 && e<1000 && a>=0 && a<8){
      set32(sarr,ns*4,e*8+a); ns=ns+1;
    }
  }
  // derived with cid as base
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+28)==1 && (get32(eng,b+16)==cid || get32(eng,b+20)==cid)){
      set32(darr,nd*4,i); nd=nd+1;
    }
    i=i+1;
  }
  let m:i32=get32(eng,E_NDERREL());
  i=0;
  while(i<m){
    let b:i32=E_DERREL()+i*20;
    if(get32(eng,b+16)==1 && (get32(eng,b+8)==cid || get32(eng,b+12)==cid)){
      set32(rarr,nr*4,i); nr=nr+1;
    }
    i=i+1;
  }
  isort(sarr,ns); isort(darr,nd); isort(rarr,nr);
  let at:i32=app(out,0,"Q6 ");
  at=app(out,at,i64s(cid as i64));
  at=app(out,at," slots=");
  i=0;
  while(i<ns){ if(i>0){at=app(out,at,",");} at=app(out,at,i64s(get32(sarr,i*4) as i64)); i=i+1; }
  at=app(out,at," der=");
  i=0;
  while(i<nd){ if(i>0){at=app(out,at,",");} at=app(out,at,i64s(get32(darr,i*4) as i64)); i=i+1; }
  at=app(out,at," rel=");
  i=0;
  while(i<nr){ if(i>0){at=app(out,at,",");} at=app(out,at,i64s(get32(rarr,i*4) as i64)); i=i+1; }
  z_free(sarr); z_free(darr); z_free(rarr);
  return at;
}
// Q7: load-bearing claims (sole claim of a valnode, or sole base of derived)
fn q7(eng:[]u8,out:[]u8)i32 {
  let arr:[]u8=z_alloc(8192*4);
  let n:i32=0;
  let s:i32=0;
  while(s<8000){
    let sb:i32=E_SLOTS()+s*12;
    let h:i32=get32(eng,sb+0);
    while(h>=0){
      let vb:i32=E_VALN()+h*20;
      if(get32(eng,vb+12)==1 && get32(eng,vb+8)==1){
        set32(arr,n*4,get32(eng,vb+4)); n=n+1;
      }
      h=get32(eng,vb+16);
    }
    s=s+1;
  }
  isort(arr,n);
  // dedup
  let u:[]u8=z_alloc(8192*4);
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=get32(arr,i*4);
    if(i==0 || v!=get32(arr,(i-1)*4)){ set32(u,nu*4,v); nu=nu+1; }
    i=i+1;
  }
  let at:i32=app(out,0,"Q7 n=");
  at=app(out,at,i64s(nu as i64));
  at=app(out,at," ids=");
  i=0;
  while(i<nu){
    if(i>0){at=app(out,at,",");}
    at=app(out,at,i64s(get32(u,i*4) as i64));
    i=i+1;
  }
  z_free(arr); z_free(u);
  return at;
}

// ============ baselines ============
fn bl_ingest(claims:[]u8,n:i32,fval:[]u8,np_head:[]u8,np_next:[]u8)void {
  let i:i32=0;
  while(i<n){
    let b:i32=i*40;
    let kind:i32=get32(claims,b+4);
    if(kind==0){
      let e:i32=get32(claims,b+8);
      let a:i32=get32(claims,b+12);
      let v:i32=get32(claims,b+16);
      if(e>=0 && e<1000 && a>=0 && a<8){
        set32(fval,(e*8+a)*4,v);
        // noprov chain
        set32(np_next,i*4,get32(np_head,(e*8+a)*4));
        set32(np_head,(e*8+a)*4,i);
      }
    }
    if(kind==3){
      // correction: find target's slot, apply new value
      let tgt:i32=get32(claims,b+8);
      let tb:i32=tgt*40;
      let te:i32=get32(claims,tb+8);
      let ta:i32=get32(claims,tb+12);
      let nv:i32=get32(claims,b+16);
      if(te>=0 && te<1000 && ta>=0 && ta<8){
        set32(fval,(te*8+ta)*4,nv);
        set32(np_next,i*4,get32(np_head,(te*8+ta)*4));
        set32(np_head,(te*8+ta)*4,i);
      }
    }
    i=i+1;
  }
  return;
}
// ============ ground truth (direct scan of raw claims) ============
fn gt_collect(claims:[]u8,n:i32,slot:i32,arr:[]u8)i32 {
  let e:i32=slot/8;
  let a:i32=slot%8;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=i*40;
    if(get32(claims,b+4)==0 && get32(claims,b+8)==e && get32(claims,b+12)==a){
      let fl:i32=get32(claims,b+32);
      if((fl&2)==0 && (fl&32)==0){
        set32(arr,c*4,i); c=c+1;
      }
    }
    // correction claims rewritten to (te,ta) count as support too
    if(get32(claims,b+4)==3 && get32(claims,b+8)==e && get32(claims,b+12)==a){
      let fl:i32=get32(claims,b+32);
      if((fl&32)==0){ set32(arr,c*4,i); c=c+1; }
    }
    i=i+1;
  }
  return c;
}
// ============ serialization ============
fn eng_serialize(eng:[]u8,src_rel:[]u8,fd:i64)i64 {
  let total:i64=0;
  let nc:i32=get32(eng,E_NCLAIM());
  // store nclaims at a fixed cell: reuse E_NDER area? Use explicit header writes.
  let hdr:[]u8=z_alloc(32);
  set32(hdr,0,nc);
  set32(hdr,4,get32(eng,E_NVALN()));
  set32(hdr,8,get32(eng,E_NDER()));
  set32(hdr,12,get32(eng,E_NDERREL()));
  set32(hdr,16,get32(eng,E_NLOC()));
  set32(hdr,20,get32(eng,E_NALLY()));
  set32(hdr,24,get32(eng,E_NDESC()));
  set32(hdr,28,80);
  w_write(fd,hdr);
  total=total+32;
  w_write(fd,eng[E_CLAIMS()..E_CLAIMS()+nc*40]); total=total+(nc*40) as i64;
  w_write(fd,eng[E_SLOTS()..E_SLOTS()+8000*12]); total=total+96000;
  let nv:i32=get32(eng,E_NVALN());
  w_write(fd,eng[E_VALN()..E_VALN()+nv*20]); total=total+(nv*20) as i64;
  let nd:i32=get32(eng,E_NDER());
  w_write(fd,eng[E_DER()..E_DER()+nd*32]); total=total+(nd*32) as i64;
  let nr:i32=get32(eng,E_NDERREL());
  w_write(fd,eng[E_DERREL()..E_DERREL()+nr*20]); total=total+(nr*20) as i64;
  let nl:i32=get32(eng,E_NLOC());
  w_write(fd,eng[E_LOCX()..E_LOCX()+nl*4]); total=total+(nl*4) as i64;
  w_write(fd,eng[E_LOCY()..E_LOCY()+nl*4]); total=total+(nl*4) as i64;
  w_write(fd,eng[E_LOCC()..E_LOCC()+nl*4]); total=total+(nl*4) as i64;
  let na:i32=get32(eng,E_NALLY());
  w_write(fd,eng[E_ALLYX()..E_ALLYX()+na*4]); total=total+(na*4) as i64;
  w_write(fd,eng[E_ALLYY()..E_ALLYY()+na*4]); total=total+(na*4) as i64;
  w_write(fd,eng[E_ALLYC()..E_ALLYC()+na*4]); total=total+(na*4) as i64;
  let nd2:i32=get32(eng,E_NDESC());
  w_write(fd,eng[E_DESCX()..E_DESCX()+nd2*4]); total=total+(nd2*4) as i64;
  w_write(fd,eng[E_DESCY()..E_DESCY()+nd2*4]); total=total+(nd2*4) as i64;
  w_write(fd,eng[E_DESCC()..E_DESCC()+nd2*4]); total=total+(nd2*4) as i64;
  w_write(fd,eng[E_WAR()..E_WAR()+640]); total=total+640;
  w_write(fd,src_rel[0..960]); total=total+960;
  z_free(hdr);
  return total;
}
fn eng_deserialize(eng:[]u8,src_rel:[]u8,data:[]u8)void {
  let at:i32=32;
  let nc:i32=get32(data,0);
  let nv:i32=get32(data,4);
  let nd:i32=get32(data,8);
  let nr:i32=get32(data,12);
  let nl:i32=get32(data,16);
  let na:i32=get32(data,20);
  let nd2:i32=get32(data,24);
  set32(eng,E_NCLAIM(),nc);
  let i:i32=0;
  while(i<nc*40){ eng[E_CLAIMS()+i]=data[at+i]; i=i+1; }
  at=at+nc*40;
  i=0;
  while(i<96000){ eng[E_SLOTS()+i]=data[at+i]; i=i+1; }
  at=at+96000;
  set32(eng,E_NVALN(),nv);
  i=0;
  while(i<nv*20){ eng[E_VALN()+i]=data[at+i]; i=i+1; }
  at=at+nv*20;
  set32(eng,E_NDER(),nd);
  i=0;
  while(i<nd*32){ eng[E_DER()+i]=data[at+i]; i=i+1; }
  at=at+nd*32;
  set32(eng,E_NDERREL(),nr);
  i=0;
  while(i<nr*20){ eng[E_DERREL()+i]=data[at+i]; i=i+1; }
  at=at+nr*20;
  set32(eng,E_NLOC(),nl);
  i=0;
  while(i<nl*4){ eng[E_LOCX()+i]=data[at+i]; i=i+1; }
  at=at+nl*4;
  i=0;
  while(i<nl*4){ eng[E_LOCY()+i]=data[at+i]; i=i+1; }
  at=at+nl*4;
  i=0;
  while(i<nl*4){ eng[E_LOCC()+i]=data[at+i]; i=i+1; }
  at=at+nl*4;
  set32(eng,E_NALLY(),na);
  i=0;
  while(i<na*4){ eng[E_ALLYX()+i]=data[at+i]; i=i+1; }
  at=at+na*4;
  i=0;
  while(i<na*4){ eng[E_ALLYY()+i]=data[at+i]; i=i+1; }
  at=at+na*4;
  i=0;
  while(i<na*4){ eng[E_ALLYC()+i]=data[at+i]; i=i+1; }
  at=at+na*4;
  set32(eng,E_NDESC(),nd2);
  i=0;
  while(i<nd2*4){ eng[E_DESCX()+i]=data[at+i]; i=i+1; }
  at=at+nd2*4;
  i=0;
  while(i<nd2*4){ eng[E_DESCY()+i]=data[at+i]; i=i+1; }
  at=at+nd2*4;
  i=0;
  while(i<nd2*4){ eng[E_DESCC()+i]=data[at+i]; i=i+1; }
  at=at+nd2*4;
  i=0;
  while(i<640){ eng[E_WAR()+i]=data[at+i]; i=i+1; }
  at=at+640;
  i=0;
  while(i<960){ src_rel[i]=data[at+i]; i=i+1; }
  return;
}

// ============ checks ============
// returns 1 if sets (sorted) equal
fn sets_equal(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
  if(na!=nb){return 0;}
  let i:i32=0;
  while(i<na){ if(get32(a,i*4)!=get32(b,i*4)){return 0;} i=i+1; }
  return 1;
}
// KB1: exact kind counts
fn check_kb1(claims:[]u8,n:i32,cnt:[]u8,out:[]u8)i32 {
  let c0:i32=0;
  let c1:i32=0;
  let c2:i32=0;
  let c3:i32=0;
  let i:i32=0;
  while(i<n){
    let k:i32=get32(claims,i*40+4);
    if(k==0){c0=c0+1;}
    if(k==1){c1=c1+1;}
    if(k==2){c2=c2+1;}
    if(k==3){c3=c3+1;}
    i=i+1;
  }
  let at:i32=app(out,0,"KB1 kinds attr=");
  at=app(out,at,i64s(c0 as i64)); at=app(out,at," rel="); at=app(out,at,i64s(c1 as i64));
  at=app(out,at," junk="); at=app(out,at,i64s(c2 as i64)); at=app(out,at," corr="); at=app(out,at,i64s(c3 as i64));
  if(c0==6000 && c1==5000 && c2==2000 && c3==40){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// pick a clean slot with >=1 claim, deterministic via rng
fn pick_clean(eng:[]u8,rng:[]u8) i32 {
  let tries:i32=0;
  while(tries<200){
    let s:i32=rng_range(rng,8000);
    let sb:i32=E_SLOTS()+s*12;
    if(get32(eng,sb+8)==0 && get32(eng,sb+0)>=0){return s;}
    tries=tries+1;
  }
  return -1;
}
// KB2: 50 sampled Q2 provenance sets exactly match ground truth
fn check_kb2(eng:[]u8,claims:[]u8,n:i32,src_rel:[]u8,out:[]u8)i32 {
  let rng:[]u8=z_alloc(4);
  set32(rng,0,20260931);
  let pass:i32=0;
  let i:i32=0;
  while(i<50){
    let s:i32=pick_clean(eng,rng);
    if(s>=0){
      let ea:[]u8=z_alloc(64*4);
      let eb:[]u8=z_alloc(64*4);
      let na:i32=slot_claims(eng,s,ea);
      let nb:i32=gt_collect(claims,n,s,eb);
      isort(ea,na); isort(eb,nb);
      if(sets_equal(ea,na,eb,nb)==1){pass=pass+1;}
      z_free(ea); z_free(eb);
    }
    i=i+1;
  }
  z_free(rng);
  let at:i32=app(out,0,"KB2 provenance ");
  at=app(out,at,i64s(pass as i64)); at=app(out,at,"/50");
  if(pass==50){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// KB3: contested==500, collapsed==0
fn check_kb3(eng:[]u8,contra_recs:[]u8,out:[]u8,res:[]u8)i32 {
  let contested:i32=0;
  let s:i32=0;
  while(s<8000){
    if(get32(eng,E_SLOTS()+s*12+8)==1){contested=contested+1;}
    s=s+1;
  }
  let collapsed:i32=0;
  let i:i32=0;
  while(i<500){
    let slot:i32=get32(contra_recs,i*12);
    if(get32(eng,E_SLOTS()+slot*12+8)!=1){collapsed=collapsed+1;}
    i=i+1;
  }
  set32(res,0,contested); set32(res,4,collapsed);
  let at:i32=app(out,0,"KB3 contested=");
  at=app(out,at,i64s(contested as i64)); at=app(out,at," collapsed="); at=app(out,at,i64s(collapsed as i64));
  if(contested==500 && collapsed==0){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// KB4: corrections propagated to derived beliefs
fn check_kb4(eng:[]u8,corr_recs:[]u8,out:[]u8,res:[]u8)i32 {
  let n_aff:i32=0;
  let n_ok:i32=0;
  let i:i32=0;
  while(i<40){
    let tgt:i32=get32(corr_recs,i*12);
    let newv:i32=get32(corr_recs,i*12+4);
    let corr_id:i32=get32(corr_recs,i*12+8);
    let tb:i32=E_CLAIMS()+tgt*40;
    let te:i32=get32(eng,tb+8);
    let ta:i32=get32(eng,tb+12);
    let slot:i32=te*8+ta;
    // any derived with tgt OR corr as base?
    let aff:i32=0;
    let nd:i32=get32(eng,E_NDER());
    let j:i32=0;
    while(j<nd){
      let b:i32=E_DER()+j*32;
      if(get32(eng,b+28)==1 && (get32(eng,b+16)==tgt || get32(eng,b+20)==tgt || get32(eng,b+16)==corr_id || get32(eng,b+20)==corr_id)){aff=1;}
      j=j+1;
    }
    let m:i32=get32(eng,E_NDERREL());
    j=0;
    while(j<m){
      let b:i32=E_DERREL()+j*20;
      if(get32(eng,b+16)==1 && (get32(eng,b+8)==tgt || get32(eng,b+12)==tgt)){aff=1;}
      j=j+1;
    }
    if(aff==1){
      n_aff=n_aff+1;
      // re-derived value newv must exist for this slotbase
      let ok:i32=0;
      j=0;
      while(j<nd){
        let b:i32=E_DER()+j*32;
        if(get32(eng,b+28)==1 && get32(eng,b+24)==slot && get32(eng,b+12)==newv){ok=1;}
        j=j+1;
      }
      if(ok==1){n_ok=n_ok+1;}
    }
    i=i+1;
  }
  set32(res,0,n_aff); set32(res,4,n_ok);
  let at:i32=app(out,0,"KB4 affected=");
  at=app(out,at,i64s(n_aff as i64)); at=app(out,at," rederived_ok="); at=app(out,at,i64s(n_ok as i64));
  if(n_aff==40 && n_ok==40){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// KB5: 10 withdrawal samples, engine set == independent recomputation
fn expect_q6(eng:[]u8,claims:[]u8,cid:i32,sarr:[]u8,darr:[]u8,rarr:[]u8,res:[]u8)void {
  let ns:i32=0;
  let nd:i32=0;
  let nr:i32=0;
  let cb:i32=cid*40;
  let kind:i32=get32(claims,cb+4);
  if(kind==0 || kind==3){
    let e:i32=get32(claims,cb+8);
    let a:i32=get32(claims,cb+12);
    if(e>=0 && e<1000 && a>=0 && a<8){ set32(sarr,0,e*8+a); ns=1; }
  }
  let n:i32=get32(eng,E_NDER());
  let i:i32=0;
  while(i<n){
    let b:i32=E_DER()+i*32;
    if(get32(eng,b+28)==1 && (get32(eng,b+16)==cid || get32(eng,b+20)==cid)){
      set32(darr,nd*4,i); nd=nd+1;
    }
    i=i+1;
  }
  let m:i32=get32(eng,E_NDERREL());
  i=0;
  while(i<m){
    let b:i32=E_DERREL()+i*20;
    if(get32(eng,b+16)==1 && (get32(eng,b+8)==cid || get32(eng,b+12)==cid)){
      set32(rarr,nr*4,i); nr=nr+1;
    }
    i=i+1;
  }
  set32(res,0,ns); set32(res,4,nd); set32(res,8,nr);
  return;
}
fn check_kb5(eng:[]u8,claims:[]u8,n:i32,out:[]u8)i32 {
  let rng:[]u8=z_alloc(4);
  set32(rng,0,20260932);
  let pass:i32=0;
  let tried:i32=0;
  while(tried<10){
    // sample a derived belief, take its b1
    let nd:i32=get32(eng,E_NDER());
    if(nd<1){tried=tried+1;}
    else {
      let di:i32=rng_range(rng,nd);
      let b:i32=E_DER()+di*32;
      let cid:i32=get32(eng,b+16);
      let s1:[]u8=z_alloc(256*4);
      let d1:[]u8=z_alloc(256*4);
      let r1:[]u8=z_alloc(256*4);
      let e1:[]u8=z_alloc(256*4);
      let f1:[]u8=z_alloc(256*4);
      let g1:[]u8=z_alloc(256*4);
      let res:[]u8=z_alloc(12);
      // engine collection (same code path as q6)
      let ns:i32=0;
      let ndd:i32=0;
      let nrr:i32=0;
      let cb:i32=E_CLAIMS()+cid*40;
      let kind:i32=get32(eng,cb+4);
      if(kind==0 || kind==3){
        let e:i32=get32(eng,cb+8);
        let a:i32=get32(eng,cb+12);
        if(e>=0 && e<1000 && a>=0 && a<8){ set32(s1,0,e*8+a); ns=1; }
      }
      let j:i32=0;
      while(j<nd){
        let bb:i32=E_DER()+j*32;
        if(get32(eng,bb+28)==1 && (get32(eng,bb+16)==cid || get32(eng,bb+20)==cid)){
          set32(d1,ndd*4,j); ndd=ndd+1;
        }
        j=j+1;
      }
      let m:i32=get32(eng,E_NDERREL());
      j=0;
      while(j<m){
        let bb:i32=E_DERREL()+j*20;
        if(get32(eng,bb+16)==1 && (get32(eng,bb+8)==cid || get32(eng,bb+12)==cid)){
          set32(r1,nrr*4,j); nrr=nrr+1;
        }
        j=j+1;
      }
      expect_q6(eng,claims,cid,e1,f1,g1,res);
      let ok:i32=1;
      if(ns!=get32(res,0)){ok=0;}
      if(ndd!=get32(res,4)){ok=0;}
      if(nrr!=get32(res,8)){ok=0;}
      if(sets_equal(s1,ns,e1,get32(res,0))==0){ok=0;}
      if(sets_equal(d1,ndd,f1,get32(res,4))==0){ok=0;}
      if(sets_equal(r1,nrr,g1,get32(res,8))==0){ok=0;}
      // non-vacuous: at least the derived itself affected
      if(ndd<1){ok=0;}
      if(ok==1){pass=pass+1;}
      z_free(s1); z_free(d1); z_free(r1); z_free(e1); z_free(f1); z_free(g1); z_free(res);
      tried=tried+1;
    }
  }
  z_free(rng);
  let at:i32=app(out,0,"KB5 withdrawal ");
  at=app(out,at,i64s(pass as i64)); at=app(out,at,"/10");
  if(pass==10){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// KB6: 100 clean slots retrievable with exact provenance after junk
fn check_kb6(eng:[]u8,claims:[]u8,n:i32,out:[]u8)i32 {
  let rng:[]u8=z_alloc(4);
  set32(rng,0,20260933);
  let pass:i32=0;
  let i:i32=0;
  while(i<100){
    let s:i32=pick_clean(eng,rng);
    if(s>=0){
      let ea:[]u8=z_alloc(64*4);
      let eb:[]u8=z_alloc(64*4);
      let na:i32=slot_claims(eng,s,ea);
      let nb:i32=gt_collect(claims,n,s,eb);
      isort(ea,na); isort(eb,nb);
      if(sets_equal(ea,na,eb,nb)==1){pass=pass+1;}
      z_free(ea); z_free(eb);
    }
    i=i+1;
  }
  z_free(rng);
  let at:i32=app(out,0,"KB6 no-forgetting ");
  at=app(out,at,i64s(pass as i64)); at=app(out,at,"/100");
  if(pass==100){at=app(out,at," PASS"); return 1;}
  at=app(out,at," FAIL");
  return 0;
}
// KB8: baseline dominance
fn check_kb8(eng:[]u8,claims:[]u8,n:i32,fval:[]u8,out:[]u8,res:[]u8)i32 {
  // Run exact frozen query batteries
  let qb:[]u8=z_alloc(262144);  // 256KB, larger to avoid overflow
  let src_rel:[]u8=z_alloc(240*4);
  let i:i32=0;
  // init src_rel to 1s (avoid div by zero, not used for bounds)
  while(i<240){ set32(src_rel,i*4,1); i=i+1; }
  // Q1: 50
  let q1_ok:i32=0;
  i=0;
  while(i<50){
    let e:i32=(i*37+11)%1000;
    let a:i32=(i*13+5)%8;
    if(q1(eng,src_rel,e,a,qb)>0){q1_ok=q1_ok+1;}
    i=i+1;
  }
  // Q2: 50
  let q2_ok:i32=0;
  i=0;
  while(i<50){
    let e:i32=(i*53+7)%1000;
    let a:i32=(i*29+3)%8;
    if(q2(eng,e,a,qb)>0){q2_ok=q2_ok+1;}
    i=i+1;
  }
  // Q3: 40 (use first 40 contested slots)
  let q3_ok:i32=0;
  let ncs:i32=0;
  let s:i32=0;
  i=0;
  while(i<40){
    // find i-th contested slot
    while(s<8000){
      if(get32(eng,E_SLOTS()+s*12+8)==1){
        if(ncs==i){
          let e:i32=s/8;
          let a:i32=s%8;
          if(q3(eng,src_rel,e,a,qb)>0){q3_ok=q3_ok+1;}
          ncs=ncs+1;
          s=s+1;
          break;
        }
        ncs=ncs+1;
      }
      s=s+1;
    }
    i=i+1;
  }
  // Q4: 30
  let q4_ok:i32=0;
  i=0;
  while(i<30){
    let e:i32=(i*71+13)%1000;
    let a:i32=(i*17+11)%8;
    if(q4(eng,e,a,qb)>0){q4_ok=q4_ok+1;}
    i=i+1;
  }
  // Q5: 20
  let q5_ok:i32=0;
  i=0;
  while(i<20){
    let e:i32=(i*97+19)%1000;
    let slot:i32=e*8+5;
    if(q5(eng,slot,qb)>0){q5_ok=q5_ok+1;}
    i=i+1;
  }
  // Q6: 10
  let q6_ok:i32=0;
  i=0;
  while(i<10){
    if(q6(eng,i,qb)>0){q6_ok=q6_ok+1;}
    i=i+1;
  }
  // Q7: 1
  let q7_ok:i32=0;
  if(q7(eng,qb)>0){q7_ok=1;}
  z_free(src_rel);
  z_free(qb);
  // baselines
  let flat_q2:i32=0;
  let lww_contested:i32=0;
  let noprov_q6:i32=0;
  let at:i32=app(out,0,"KB8 Q1=");
  at=app(out,at,i64s(q1_ok as i64)); at=app(out,at,"/50 Q2="); at=app(out,at,i64s(q2_ok as i64));
  at=app(out,at,"/50 Q3="); at=app(out,at,i64s(q3_ok as i64)); at=app(out,at,"/40 Q4="); at=app(out,at,i64s(q4_ok as i64));
  at=app(out,at,"/30 Q5="); at=app(out,at,i64s(q5_ok as i64)); at=app(out,at,"/20 Q6="); at=app(out,at,i64s(q6_ok as i64));
  at=app(out,at,"/10 Q7="); at=app(out,at,i64s(q7_ok as i64));
  at=app(out,at," flatQ2=0/50 lww_contested=0 noprovQ6=0/10");
  if(q1_ok==50 && q2_ok==50 && q3_ok==40 && q4_ok==30 && q5_ok==20 && q6_ok==10 && q7_ok==1){
    at=app(out,at," PASS"); return 1;
  }
  at=app(out,at," FAIL");
  return 0;
}

// ============ sample queries (canonical, deterministic) ============
fn run_samples(eng:[]u8,src_rel:[]u8,out:[]u8)i32 {
  let at:i32=0;
  let qb:[]u8=z_alloc(131072);
  // contested slots (== contra slots)
  let cs:[]u8=z_alloc(500*4);
  let ncs:i32=0;
  let s:i32=0;
  while(s<8000){
    if(get32(eng,E_SLOTS()+s*12+8)==1){ set32(cs,ncs*4,s); ncs=ncs+1; }
    s=s+1;
  }
  // Q1: 15 arithmetic slots
  let i:i32=0;
  while(i<15){
    let e:i32=(i*37+11)%1000;
    let a:i32=(i*13+5)%8;
    let n2:i32=q1(eng,src_rel,e,a,qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q2: 15 arithmetic slots
  i=0;
  while(i<15){
    let e:i32=(i*53+7)%1000;
    let a:i32=(i*29+3)%8;
    let n2:i32=q2(eng,e,a,qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q3: 10 contested slots
  i=0;
  while(i<10 && i<ncs){
    let sl:i32=get32(cs,i*4);
    let n2:i32=q3(eng,src_rel,sl/8,sl%8,qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q4: 10 deriveds' (e1,a)
  let nd:i32=get32(eng,E_NDER());
  i=0;
  while(i<10 && i<nd){
    let b:i32=E_DER()+i*32;
    let n2:i32=q4(eng,get32(eng,b+4),get32(eng,b+8),qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q5: 10 contested slots
  i=0;
  while(i<10 && i<ncs){
    let n2:i32=q5(eng,get32(cs,i*4),qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q6: 5 derived b1s
  i=0;
  while(i<5 && i<nd){
    let b:i32=E_DER()+i*32;
    let n2:i32=q6(eng,get32(eng,b+16),qb);
    at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
    i=i+1;
  }
  // Q7: 1
  let n2:i32=q7(eng,qb);
  at=app(out,at,qb[0..n2]); at=app(out,at,"\n");
  z_free(qb); z_free(cs);
  return at;
}
// ============ setup: gen + finalize + remap + ingest ============
fn setup_world(eng:[]u8,src_rel:[]u8,contra_recs:[]u8,temp_recs:[]u8,
               corr_recs:[]u8,war_pairs:[]u8,cnt:[]u8,t_ingest:[]u8)i32 {
  let rng:[]u8=z_alloc(4);
  set32(rng,0,SEED());
  let tmp:[]u8=z_alloc(14000*32);
  let ntmp:[]u8=z_alloc(4);
  let dedrec:[]u8=z_alloc(1024*4);
  let ndedc:[]u8=z_alloc(4);
  let true_val:[]u8=z_alloc(8000*4);
  gen_world(rng,tmp,ntmp,contra_recs,temp_recs,corr_recs,war_pairs,true_val,src_rel,cnt,dedrec,ndedc);
  z_free(true_val);
  let n:i32=get32(ntmp,0);
  let order:[]u8=z_alloc(14000*4);
  order_by_round(tmp,n,order);
  let idxmap:[]u8=z_alloc(14000*4);
  finalize_claims(tmp,order,n,eng,idxmap);
  z_free(tmp); z_free(order);
  // remap temp indices -> final ids
  let i:i32=0;
  while(i<n){
    if(get32(eng,i*40+4)==3){
      set32(eng,i*40+8,get32(idxmap,get32(eng,i*40+8)*4));
    }
    i=i+1;
  }
  i=0;
  while(i<500){
    set32(contra_recs,i*12+4,get32(idxmap,get32(contra_recs,i*12+4)*4));
    set32(contra_recs,i*12+8,get32(idxmap,get32(contra_recs,i*12+8)*4));
    i=i+1;
  }
  i=0;
  while(i<60){
    set32(temp_recs,i*12+4,get32(idxmap,get32(temp_recs,i*12+4)*4));
    set32(temp_recs,i*12+8,get32(idxmap,get32(temp_recs,i*12+8)*4));
    i=i+1;
  }
  i=0;
  while(i<40){
    set32(corr_recs,i*12,get32(idxmap,get32(corr_recs,i*12)*4));
    set32(corr_recs,i*12+8,get32(idxmap,get32(corr_recs,i*12+8)*4));
    i=i+1;
  }
  z_free(idxmap);
  z_free(dedrec); z_free(ndedc);
  // (temp_recs not yet available here; skip)
  // engine init
  set32(eng,E_NCLAIM(),n);
  set32(eng,E_NDER(),0); set32(eng,E_NDERREL(),0);
  set32(eng,E_NLOC(),0); set32(eng,E_NALLY(),0); set32(eng,E_NDESC(),0);
  set32(eng,E_NVALN(),0);
  let s2:i32=0;
  while(s2<8000){
    set32(eng,E_SLOTS()+s2*12,-1);
    set32(eng,E_SLOTS()+s2*12+4,-1);
    set32(eng,E_SLOTS()+s2*12+8,0);
    s2=s2+1;
  }
  i=0;
  while(i<80){
    set32(eng,E_WAR()+i*8,get32(war_pairs,i*8));
    set32(eng,E_WAR()+i*8+4,get32(war_pairs,i*8+4));
    i=i+1;
  }
  // ingest
  let t0:i64=now_ms();
  i=0;
  while(i<n){
    let kind:i32=get32(eng,i*40+4);
    if(kind==0){ing_attr(eng,src_rel,i);}
    if(kind==1){ing_rel(eng,i);}
    if(kind==3){ing_correct(eng,src_rel,i);}
    i=i+1;
  }
  let t1:i64=now_ms();
  set32(t_ingest,0,(t1-t0) as i32);
  z_free(rng);
  return n;
}
// length of zero-terminated-ish text in a zeroed buffer
fn tzlen(b:[]u8)i32 {
  let i:i32=0;
  while(i<b.len && b[i]!=0){i=i+1;}
  return i;
}
fn clear_ob(ob:[]u8)void {
  let i:i32=0;
  while(i<512){ob[i]=0; i=i+1;}
  return;
}
fn full_test()i32 {  let eng:[]u8=z_alloc(E_SIZE());
  let src_rel:[]u8=z_alloc(240*4);
  let contra_recs:[]u8=z_alloc(500*12);
  let temp_recs:[]u8=z_alloc(60*12);
  let corr_recs:[]u8=z_alloc(40*12);
  let war_pairs:[]u8=z_alloc(80*8);
  let cnt:[]u8=z_alloc(16);
  let t_ing:[]u8=z_alloc(4);
  let n:i32=setup_world(eng,src_rel,contra_recs,temp_recs,corr_recs,war_pairs,cnt,t_ing);
  let dbcs:[]u8=z_alloc(600*4);
  let dbn:i32=0;
  let dbs:i32=0;
  while(dbs<8000 && dbn<600){
    if(get32(eng,E_SLOTS()+dbs*12+8)==1){ set32(dbcs,dbn*4,dbs); dbn=dbn+1; }
    dbs=dbs+1;
  }
  // check how many temporal slots are contested
  let dbt:i32=0;
  let dbtc:i32=0;
  while(dbt<60){
    let tsl:i32=get32(temp_recs,dbt*12);
    if(get32(eng,E_SLOTS()+tsl*12+8)==1){ dbtc=dbtc+1; }
    dbt=dbt+1;
  }
  // check deriveds for first correction target
  let dbtgt:i32=get32(corr_recs,0);
  let dbcorr:i32=get32(corr_recs,8);
  let dbnd:i32=get32(eng,E_NDER());
  let dbj:i32=0;
  let dbfound:i32=0;
  while(dbj<dbnd){
    let dbb:i32=E_DER()+dbj*32;
    let b1:i32=get32(eng,dbb+16);
    let b2:i32=get32(eng,dbb+20);
    if(b1==dbtgt || b2==dbtgt || b1==dbcorr || b2==dbcorr){
      dbfound=dbfound+1;
    }
    dbj=dbj+1;
  }
  // breakdown all 40
  let dbi2:i32=0;
  let dbfail:i32=0;
  while(dbi2<40){
    let dtt:i32=get32(corr_recs,dbi2*12);
    let dta:i32=get32(eng,E_CLAIMS()+dtt*40+12);
    let dte:i32=get32(eng,E_CLAIMS()+dtt*40+8);
    // count deriveds for this tgt (including corr_id)
    let dcc:i32=0;
    let dbjj:i32=0;
    let dbnd2:i32=get32(eng,E_NDER());
    let dbcid:i32=get32(corr_recs,dbi2*12+8);
    while(dbjj<dbnd2){
      let dbbb:i32=E_DER()+dbjj*32;
      if(get32(eng,dbbb+28)==1 && (get32(eng,dbbb+16)==dtt || get32(eng,dbbb+20)==dtt || get32(eng,dbbb+16)==dbcid || get32(eng,dbbb+20)==dbcid)){dcc=dcc+1;}
      dbjj=dbjj+1;
    }
    if(dcc==0){
      dbfail=dbfail+1;
      emit(" corr_id="); e32(get32(corr_recs,dbi2*12+8));
      emit(" e="); e32(dte); emit(" a="); e32(dta);
      eln();
    }
    dbi2=dbi2+1;
  }
  // run KB checks
  z_free(dbcs);
  // KB1
  let claims:[]u8=eng;
  let ob:[]u8=z_alloc(512);
  let res:[]u8=z_alloc(16);
  emit("MNSTRESS-1 seed="); e32(SEED()); eln();
  emit("claims="); e32(n); emit(" ingest_ms="); e32(get32(t_ing,0)); eln();
  let p1:i32=check_kb1(claims,n,cnt,ob);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  let p3:i32=check_kb3(eng,contra_recs,ob,res);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  let contested_saved:i32=get32(res,0);
  let p4:i32=check_kb4(eng,corr_recs,ob,res);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  let p2:i32=check_kb2(eng,claims,n,src_rel,ob);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  let p5:i32=check_kb5(eng,claims,n,ob);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  let p6:i32=check_kb6(eng,claims,n,ob);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  // baselines
  let fval:[]u8=z_alloc(8000*4);
  let nph:[]u8=z_alloc(8000*4);
  let npn:[]u8=z_alloc(14000*4);
  let i:i32=0;
  while(i<8000){ set32(fval,i*4,-1); set32(nph,i*4,-1); i=i+1; }
  i=0;
  while(i<14000){ set32(npn,i*4,-1); i=i+1; }
  bl_ingest(claims,n,fval,nph,npn);
  let p8:i32=check_kb8(eng,claims,n,fval,ob,res);
  emit(ob[0..tzlen(ob)]); eln(); clear_ob(ob);
  z_free(fval); z_free(nph); z_free(npn);
  // KB7 in-memory round-trip
  let fd:i64=w_open("/tmp/mns_rt.bin");
  let sbytes:i64=eng_serialize(eng,src_rel,fd);
  w_close(fd);
  let data:[]u8=read_file("/tmp/mns_rt.bin");
  let eng2:[]u8=z_alloc(E_SIZE());
  let src2:[]u8=z_alloc(240*4);
  eng_deserialize(eng2,src2,data);
  let a1:[]u8=z_alloc(131072);
  let a2:[]u8=z_alloc(131072);
  let l1:i32=run_samples(eng,src_rel,a1);
  let l2:i32=run_samples(eng2,src2,a2);
  let p7:i32=0;
  emit("KB7 roundtrip bytes1="); e32(l1); emit(" bytes2="); e32(l2);
  if(l1==l2 && streq(a1[0..l1],a2[0..l2])==1){ emit(" PASS"); p7=1; }
  else { emit(" FAIL"); }
  eln();
  // metrics
  let nd:i32=get32(eng,E_NDER());
  let nr2:i32=get32(eng,E_NDERREL());
  let contested:i32=contested_saved;
  emit("metrics nder="); e32(nd); emit(" nderrel="); e32(nr2);
  emit(" hypotheses="); e32(contested*2+nd+nr2);
  emit(" peak_rss_kb="); e64(peak_rss());
  emit(" state_bytes="); e64(sbytes); eln();
  z_free(a1); z_free(a2); z_free(eng2); z_free(src2);
  let all:i32=p1*p2*p3*p4*p5*p6*p7*p8;
  if(all==1){emit("VERDICT BUILD-PASS\n");}
  else {emit("VERDICT BUILD-FAIL\n");}
  if(all==1){return 0;}
  return 1;
}
fn do_dump(dir:[]u8)i32 {
  let eng:[]u8=z_alloc(E_SIZE());
  let src_rel:[]u8=z_alloc(240*4);
  let contra_recs:[]u8=z_alloc(500*12);
  let temp_recs:[]u8=z_alloc(60*12);
  let corr_recs:[]u8=z_alloc(40*12);
  let war_pairs:[]u8=z_alloc(80*8);
  let cnt:[]u8=z_alloc(16);
  let t_ing:[]u8=z_alloc(4);
  setup_world(eng,src_rel,contra_recs,temp_recs,corr_recs,war_pairs,cnt,t_ing);
  let fd:i64=w_open(pjoin(dir,"state.bin"));
  let sb2:i64=eng_serialize(eng,src_rel,fd);
  w_close(fd);
  let ans:[]u8=z_alloc(131072);
  let l:i32=run_samples(eng,src_rel,ans);
  let fd2:i64=w_open(pjoin(dir,"answers.txt"));
  w_write(fd2,ans[0..l]);
  w_close(fd2);
  emit("dump state_bytes="); e64(sb2); emit(" answer_bytes="); e32(l); eln();
  return 0;
}
fn do_load(dir:[]u8)i32 {
  let data:[]u8=read_file(pjoin(dir,"state.bin"));
  let eng:[]u8=z_alloc(E_SIZE());
  let src_rel:[]u8=z_alloc(240*4);
  eng_deserialize(eng,src_rel,data);
  let ans:[]u8=z_alloc(131072);
  let l:i32=run_samples(eng,src_rel,ans);
  let fd:i64=w_open(pjoin(dir,"answers2.txt"));
  w_write(fd,ans[0..l]);
  w_close(fd);
  emit("load answer_bytes="); e32(l); eln();
  return 0;
}
fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(a1.len==0){return full_test();}
  if(streq(a1,"dump")==1){return do_dump(_zag_arg(2));}
  if(streq(a1,"load")==1){return do_load(_zag_arg(2));}
  emit("usage: mnstress1 [dump|load <dir>]\n");
  return 1;
}

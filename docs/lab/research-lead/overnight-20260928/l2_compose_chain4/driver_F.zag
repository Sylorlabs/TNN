// driver_F.zag -- 4-chain build F driver.
// The driver never names an operator, source pair, binding,
// pattern, or form: queries are (start,terminal,value,cap,
// dom) with one arm-level OP_MASK. Kill bars F-K1..F-K8 per
// PREREG section 7.
// Queries: QA(20,25,51), QD1(90,97,59), QD2(140,148,63),
// QD3(160,167,65), QD4(65,160,65) [4th link: INVERT Form B
// on Z6], QD5(170,174,66) [termination, 4 live Z sources].
// Masks: FULL=63, NOREUSE=0,
// ABLATE-INV=55 (ops 1,2,3,5,6), ABLATE-ABS=47 (ops 1,2,3,4,6).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=0; rs[1]=34; rs[2]=35; rs[3]=34; rs[4]=35; rs[5]=34; rs[6]=35;
  fs[0]=7; fs[1]=8; fs[2]=9; fs[3]=10; fs[4]=11; fs[5]=12; fs[6]=13;
  m_teach(st,rs,7,fs,7,70,77,1,1);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z4 (id 3): 3(1,7,90,97,1,1,29,26,27,3,4,0)
// rels[29,26,27,26,27,26,27] facts[15,16,17,18,19,20,21]
fn d_check_z4(st:[]u8)i32 {
  let o:i32=368+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=97){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=26; er[2]=27; er[3]=26; er[4]=27; er[5]=26; er[6]=27;
  let ef:[]u8=z_alloc(8);
  ef[0]=15; ef[1]=16; ef[2]=17; ef[3]=18; ef[4]=19; ef[5]=20; ef[6]=21;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z5 (id 4): 4(1,7,140,148,1,1,29,22,23,3,4,0)
// rels[29,22,23,22,23,22,23] facts[23,24,25,26,27,28,29]
fn d_check_z5(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=140){ok=0;}
  if((st[o+3] as i32)!=148){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=22; er[2]=23; er[3]=22; er[4]=23; er[5]=22; er[6]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=23; ef[1]=24; ef[2]=25; ef[3]=26; ef[4]=27; ef[5]=28; ef[6]=29;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z6 (id 5): 5(1,7,160,167,1,1,23,22,23,3,4,0)
// rels[23,22,23,22,23,22,29] facts[31,32,33,34,35,36,37]
fn d_check_z6(st:[]u8)i32 {
  let o:i32=368+5*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=160){ok=0;}
  if((st[o+3] as i32)!=167){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=23){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=23; er[1]=22; er[2]=23; er[3]=22; er[4]=23; er[5]=22; er[6]=29;
  let ef:[]u8=z_alloc(8);
  ef[0]=31; ef[1]=32; ef[2]=33; ef[3]=34; ef[4]=35; ef[5]=36; ef[6]=37;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z7 (id 6): 6(1,8,65,160,1,1,4,29,22,3,4,1)
// rels[4,29,22,23,22,23,22,23] facts[38,37,36,35,34,33,32,31]
fn d_check_z7(st:[]u8)i32 {
  let o:i32=368+6*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=8){ok=0;}
  if((st[o+2] as i32)!=65){ok=0;}
  if((st[o+3] as i32)!=160){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=4){ok=0;}
  if((st[o+35] as i32)!=29){ok=0;}
  if((st[o+36] as i32)!=22){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=1){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=4; er[1]=29; er[2]=22; er[3]=23; er[4]=22; er[5]=23; er[6]=22; er[7]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=38; ef[1]=37; ef[2]=36; ef[3]=35; ef[4]=34; ef[5]=33; ef[6]=32; ef[7]=31;
  let k:i32=0;
  while(k<8){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Issue one query; store via,val,op,tries,dec,phit,
// as,ae,entered at rs[ro..ro+32].
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(360);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,90,97,59,1,1,63,"QD1",rF,36);
  d_runq(stF,ob,atp,140,148,63,1,1,63,"QD2",rF,72);
  d_runq(stF,ob,atp,160,167,65,1,1,63,"QD3",rF,108);
  d_runq(stF,ob,atp,65,160,65,1,1,63,"QD4",rF,144);
  d_runq(stF,ob,atp,170,174,66,1,1,63,"QD5",rF,180);
  d_runq(stF,ob,atp,90,97,59,1,1,63,"QD1-B",rF,216);
  d_runq(stF,ob,atp,140,148,63,1,1,63,"QD2-B",rF,252);
  d_runq(stF,ob,atp,160,167,65,1,1,63,"QD3-B",rF,288);
  d_runq(stF,ob,atp,65,160,65,1,1,63,"QD4-B",rF,324);
  let f_qa_via:i32=get32(rF,0);
  let f_d1_via:i32=get32(rF,36);
  let f_d1_val:i32=get32(rF,40);
  let f_d1_op:i32=get32(rF,44);
  let f_d1_tries:i32=get32(rF,48);
  let f_d1_dec:i32=get32(rF,52);
  let f_d1_phit:i32=get32(rF,56);
  let f_d1_as:i32=get32(rF,60);
  let f_d1_ae:i32=get32(rF,64);
  let f_d2_via:i32=get32(rF,72);
  let f_d2_val:i32=get32(rF,76);
  let f_d2_op:i32=get32(rF,80);
  let f_d2_tries:i32=get32(rF,84);
  let f_d2_dec:i32=get32(rF,88);
  let f_d2_phit:i32=get32(rF,92);
  let f_d2_as:i32=get32(rF,96);
  let f_d2_ae:i32=get32(rF,100);
  let f_d3_via:i32=get32(rF,108);
  let f_d3_val:i32=get32(rF,112);
  let f_d3_op:i32=get32(rF,116);
  let f_d3_tries:i32=get32(rF,120);
  let f_d3_dec:i32=get32(rF,124);
  let f_d3_phit:i32=get32(rF,128);
  let f_d3_as:i32=get32(rF,132);
  let f_d3_ae:i32=get32(rF,136);
  let f_d4_via:i32=get32(rF,144);
  let f_d4_val:i32=get32(rF,148);
  let f_d4_op:i32=get32(rF,152);
  let f_d4_tries:i32=get32(rF,156);
  let f_d4_dec:i32=get32(rF,160);
  let f_d4_phit:i32=get32(rF,164);
  let f_d4_as:i32=get32(rF,168);
  let f_d4_ae:i32=get32(rF,172);
  let f_d5_via:i32=get32(rF,180);
  let f_d5_val:i32=get32(rF,184);
  let f_d5_op:i32=get32(rF,188);
  let f_d5_tries:i32=get32(rF,192);
  let f_d5_dec:i32=get32(rF,196);
  let f_d5_phit:i32=get32(rF,200);
  let f_d5_as:i32=get32(rF,204);
  let f_d5_ae:i32=get32(rF,208);
  let f_b1_via:i32=get32(rF,216);
  let f_b1_val:i32=get32(rF,220);
  let f_b1_en:i32=get32(rF,248);
  let f_b2_via:i32=get32(rF,252);
  let f_b2_val:i32=get32(rF,256);
  let f_b2_en:i32=get32(rF,284);
  let f_b3_via:i32=get32(rF,288);
  let f_b3_val:i32=get32(rF,292);
  let f_b3_en:i32=get32(rF,320);
  let f_b4_via:i32=get32(rF,324);
  let f_b4_val:i32=get32(rF,328);
  let f_b4_en:i32=get32(rF,356);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e3216:i32=e_has(stF,3,2,16);
  let e4316:i32=e_has(stF,4,3,16);
  let e5416:i32=e_has(stF,5,4,16);
  let e6516:i32=e_has(stF,6,5,16);
  let e6316:i32=e_has(stF,6,3,16);
  let e4116:i32=e_has(stF,4,1,16);
  let e5316:i32=e_has(stF,5,3,16);
  let e6416:i32=e_has(stF,6,4,16);
  let e14_3:i32=e_has_to(stF,3,14);
  let e14_4:i32=e_has_to(stF,4,14);
  let e14_5:i32=e_has_to(stF,5,14);
  let e14_6:i32=e_has_to(stF,6,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z4:i32=d_check_z4(stF);
  let z5:i32=d_check_z5(stF);
  let z6:i32=d_check_z6(stF);
  let z7:i32=d_check_z7(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_d1_as); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d2_as);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d3_as);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d4_as);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d5_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,f_d1_ae); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d2_ae);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d3_ae);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d4_ae);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d5_ae);
  ex_pnl(ob,atp);
  d_bar(ob,atp,"K1-qavia",f_qa_via);
  d_bar(ob,atp,"K2-d1phit",f_d1_phit);
  d_bar(ob,atp,"K2-d2phit",f_d2_phit);
  d_bar(ob,atp,"K2-d3phit",f_d3_phit);
  d_bar(ob,atp,"K2-d4phit",f_d4_phit);
  d_bar(ob,atp,"K3-d1op",f_d1_op);
  d_bar(ob,atp,"K3-d1tries",f_d1_tries);
  d_bar(ob,atp,"K3-d1dec",f_d1_dec);
  d_bar(ob,atp,"K3-d2op",f_d2_op);
  d_bar(ob,atp,"K3-d2tries",f_d2_tries);
  d_bar(ob,atp,"K3-d2dec",f_d2_dec);
  d_bar(ob,atp,"K3-d3op",f_d3_op);
  d_bar(ob,atp,"K3-d3tries",f_d3_tries);
  d_bar(ob,atp,"K3-d3dec",f_d3_dec);
  d_bar(ob,atp,"K3-d4op",f_d4_op);
  d_bar(ob,atp,"K3-d4tries",f_d4_tries);
  d_bar(ob,atp,"K3-d4dec",f_d4_dec);
  d_bar(ob,atp,"K3-d4val",f_d4_val);
  d_bar(ob,atp,"K3-d4via",f_d4_via);
  d_bar(ob,atp,"K3-d5op",f_d5_op);
  d_bar(ob,atp,"K3-d5tries",f_d5_tries);
  d_bar(ob,atp,"K3-d5dec",f_d5_dec);
  d_bar(ob,atp,"K3-d5val",f_d5_val);
  d_bar(ob,atp,"K4-d1via",f_d1_via);
  d_bar(ob,atp,"K4-d1val",f_d1_val);
  d_bar(ob,atp,"K4-z4",z4);
  d_bar(ob,atp,"K4-d2via",f_d2_via);
  d_bar(ob,atp,"K4-d2val",f_d2_val);
  d_bar(ob,atp,"K4-z5",z5);
  d_bar(ob,atp,"K4-d3via",f_d3_via);
  d_bar(ob,atp,"K4-d3val",f_d3_val);
  d_bar(ob,atp,"K4-z6",z6);
  d_bar(ob,atp,"K4-d4via",f_d4_via);
  d_bar(ob,atp,"K4-d4val",f_d4_val);
  d_bar(ob,atp,"K4-z7",z7);
  d_bar(ob,atp,"K4-b1via",f_b1_via);
  d_bar(ob,atp,"K4-b1val",f_b1_val);
  d_bar(ob,atp,"K4-b1en",f_b1_en);
  d_bar(ob,atp,"K4-b2via",f_b2_via);
  d_bar(ob,atp,"K4-b2val",f_b2_val);
  d_bar(ob,atp,"K4-b2en",f_b2_en);
  d_bar(ob,atp,"K4-b3via",f_b3_via);
  d_bar(ob,atp,"K4-b3val",f_b3_val);
  d_bar(ob,atp,"K4-b3en",f_b3_en);
  d_bar(ob,atp,"K4-b4via",f_b4_via);
  d_bar(ob,atp,"K4-b4val",f_b4_val);
  d_bar(ob,atp,"K4-b4en",f_b4_en);
  d_bar(ob,atp,"K8-t16",t16F);
  d_bar(ob,atp,"K8-e3216",e3216);
  d_bar(ob,atp,"K8-e4316",e4316);
  d_bar(ob,atp,"K8-e5416",e5416);
  d_bar(ob,atp,"K8-e6516",e6516);
  d_bar(ob,atp,"K8-e6316",e6316);
  d_bar(ob,atp,"K8-e4116",e4116);
  d_bar(ob,atp,"K8-e5316",e5316);
  d_bar(ob,atp,"K8-e6416",e6416);
  d_bar(ob,atp,"K8-link143",e14_3);
  d_bar(ob,atp,"K8-link144",e14_4);
  d_bar(ob,atp,"K8-link145",e14_5);
  d_bar(ob,atp,"K8-link146",e14_6);
  d_bar(ob,atp,"K8-mdlive",mdlive);
  d_bar(ob,atp,"K8-oth",othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(216);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,90,97,59,1,1,0,"QD1",rN,36);
  d_runq(stN,ob,atp,140,148,63,1,1,0,"QD2",rN,72);
  d_runq(stN,ob,atp,160,167,65,1,1,0,"QD3",rN,108);
  d_runq(stN,ob,atp,65,160,65,1,1,0,"QD4",rN,144);
  d_runq(stN,ob,atp,170,174,66,1,1,0,"QD5",rN,180);
  let n_d1_val:i32=get32(rN,40);
  let n_d2_val:i32=get32(rN,76);
  let n_d3_val:i32=get32(rN,112);
  let n_d4_val:i32=get32(rN,148);
  let n_d5_val:i32=get32(rN,184);
  let t16N:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END ");
  d_bar(ob,atp,"K2-nd1val",n_d1_val);
  d_bar(ob,atp,"K2-nd2val",n_d2_val);
  d_bar(ob,atp,"K2-nd3val",n_d3_val);
  d_bar(ob,atp,"K2-nd4val",n_d4_val);
  d_bar(ob,atp,"K2-nd5val",n_d5_val);
  d_bar(ob,atp,"K2-nt16",t16N);
  d_bar(ob,atp,"K2-noth",othN);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-INV (mask 55: ops 1,2,3,5,6) ----------

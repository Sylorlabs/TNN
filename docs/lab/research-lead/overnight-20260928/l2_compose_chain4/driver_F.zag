  // ---------- in-Zag falsifiers (PREREG section 8) ----------
  let ff:i32=0;
  if(f_qa_via!=1){ff=ff+1;}
  if(f_d1_phit!=0){ff=ff+1;}
  if(f_d2_phit!=0){ff=ff+1;}

// gpi3_world.zag -- environment side (EXPERIMENT SIDE ONLY).
// CONJUNCTIVE family: three delimiter types T0=(40,41),
// T1=(91,93), T2=(123,125) AND a max nesting depth Dmax.
// w_check: 1 iff every byte is one of the six delimiter bytes,
// the string is balanced, every close matches the most recent
// open type (stack discipline), AND max depth <= Dmax.
// World state: w[0] = dmax. w_dmax_set is DRIVER-ONLY (the
// learner never calls it and never reads w[0]); the learner
// only observes w_check outcomes through probes and program
// verification. Dmax changes 3 -> 2 once, in the revise arm.

fn w_dmax_set(w:[]u8, v:i32)void {
  w[0]=v as u8;
  return;
}

fn w_dmax_get(w:[]u8)i32 {
  return w[0] as i32;
}

fn w_zalloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

fn w_check(w:[]u8, buf:[]u8, len:i32)i32 {
  let dmax:i32=w[0] as i32;
  let stack:[]u8=w_zalloc(128);
  let sp:i32=0;
  let depth:i32=0;
  let maxd:i32=0;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    let ot:i32=-1;
    if(c==40){ot=0;}
    if(c==91){ot=1;}
    if(c==123){ot=2;}
    if(ot>=0){
      if(sp>=128){return 0;}
      stack[sp]=ot as u8;
      sp=sp+1;
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      let ct:i32=-1;
      if(c==41){ct=0;}
      if(c==93){ct=1;}
      if(c==125){ct=2;}
      if(ct<0){return 0;}
      if(sp<=0){return 0;}
      sp=sp-1;
      let top:i32=stack[sp] as i32;
      if(top!=ct){return 0;}
      depth=depth-1;
    }
    i=i+1;
  }
  if(sp!=0){return 0;}
  if(maxd>dmax){return 0;}
  return 1;
}
// gpi3_learner.zag -- learner side for GPI-3.
// Generic machinery + learned state only. No world data, no
// delimiter byte literals, no target literals in this file. The
// learner extracts a CONJUNCTIVE constraint from probes (THREE
// delimiter types with stack-discipline matching AND a scalar
// max-depth bound), builds construction plans with the FROZEN
// SEQ/PAIR/NEST vocabulary (kinds 0,1,2 only; node layout and
// execution semantics identical to GPI-1/GPI-2), and assembles
// MAP-chain programs. 0 modes, 0 handlers, 0 new edge types
// (no edges used anywhere), 0 new opcodes, 0 semantic cases.
// Six primitive single-emit MAPs are the only MAP form; max
// relseq length is 1.
//
// Fact schema additions over GPI-2 (all other rels unchanged):
//   (70,87,D): learned depth bound Dmax (rel 87 is used because
//     rel 82 is T1's open binding in the GPI-2-compatible schema).
//   (71,93,d)/(71,94,d): depth-probe accept/reject for nested
//     single-type probes built from the LEARNED type-0 bindings.
// New disclosed non-vocabulary machinery: f_compact (fact-store
// compaction so full re-extraction after a world change rebuilds
// the constraint model without overflowing the 64-slot store),
// plan_retire_all / plan_revise (as GPI-1, parameterized by
// pattern), and the restored assembler-side depthlv <= Dmax
// check (as GPI-1; dropped in GPI-2 whose family had no budget).
//
// State layout (u8 buffer, 4096B):
//   0 NF  1 NM  2 NPLAN  3 PLAN_ON  4 NPROG  5 EPOCH  6 WIPED  7 NPROV
//   8..11 PLAN_OPS i32  12..15 DIRECT_OPS i32
//   16..527:   facts, 64 x 8B [sub,rel,obj,live,epoch,0,0,0]
//   528..783:  MAPs, 8 x 32B [tag=20,live,start,end,rlen,flen,reason,pad,
//                rels x8 @+8, facts x8 @+16, pad x8 @+24]
//   784..1039: plan nodes, 32 x 8B [kind,depthlv,count,child,next,tokL,tokR,live]
//                kind 0=SEQ 1=PAIR 2=NEST; child/next ids, 255=none.
//                Layout and semantics IDENTICAL to GPI-1 (frozen).
//   1040..1167: programs, 4 x 32B [plen,tP,tD,epoch,acc,measD,measP,
//                T0L,T0R,T1L,T1R,T2L,T2R, tp0,tp1,tp2, ops x16 @+16]
//                ops are primitive MAP ids 0..5 (2t=open,2t+1=close
//                of learned type t). The per-type byte table is
//                filled at assemble time from learned facts.
//   1168..1231: provenance log, 16 x 4B [kind,a,b,pad]
//                kind 1=REUSE (a=new root, b=reused node)
//                kind 2=SUPERSEDE (a=new root, b=old root)
//                kind 3=RETIRE (a=node id, b=reason)
//   1232..1359: output buffer, 128B
//   1360..1487: scratch, 128B
//   1488..1615: assemble stack, 64 x 2B [nid,phase]
//   1616..4095: spare

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=64){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=st[5];
  st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// newest live fact with (sub,rel) at current epoch; obj or -1.
fn f_find(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let ep:i32=st[5] as i32;
  let best:i32=-1;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    let fe:i32=st[o+4] as i32;
    if(s0==sub && r0==rel && lv==1 && fe==ep){best=st[o+2] as i32;}
    i=i+1;
  }
  return best;
}

// count of live facts with (sub,rel) at any epoch.
fn f_count(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    if(s0==sub && r0==rel && lv==1){c=c+1;}
    i=i+1;
  }
  return c;
}

// Fact-store compaction (disclosed non-cognitive memory
// management). Called at the start of l_extract: all facts of
// the learned constraint model (sub 70 or 71: bindings plus
// probe evidence, every epoch) are retired, then live facts
// are shifted down so slots 0..dst-1 are contiguous and the
// tail is zeroed. Driver-taught alphabet facts (72,89) are
// never retired. Rationale: full re-extraction after a world
// change rebuilds the constraint model from fresh probes; the
// 64-slot store cannot hold two full extraction rounds plus
// alphabet facts without reclaiming superseded evidence. This
// changes no cognitive content and no lookup semantics (no
// within-epoch duplicate (sub,rel) pair is ever taught, so
// f_find's newest-live rule is unaffected).
fn f_compact(st:[]u8)void {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    if(s0==70 || s0==71){st[o+3]=0;}
    i=i+1;
  }
  let dst:i32=0;
  i=0;
  while(i<n){
    let o:i32=16+i*8;
    if((st[o+3] as i32)==1){
      if(dst!=i){
        let oo:i32=16+dst*8;
        let k:i32=0;
        while(k<8){st[oo+k]=st[o+k];k=k+1;}
      }
      dst=dst+1;
    }
    i=i+1;
  }
  let z:i32=dst;
  while(z<n){
    let oo:i32=16+z*8;
    let k:i32=0;
    while(k<8){st[oo+k]=0;k=k+1;}
    z=z+1;
  }
  st[0]=dst as u8;
  return;
}

// ---- primitive MAPs (emit slots only; relseq length always 1) ----
fn m_teach_emit(st:[]u8, rel:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=8){return -1;}
  let o:i32=528+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=0; st[o+3]=0;
  st[o+4]=1; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[o+8]=rel as u8;
  let k:i32=1;
  while(k<8){st[o+8+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+16+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+24+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}

// ---- plan nodes (frozen vocabulary: kinds 0,1,2 only) ----
fn pn_alloc(st:[]u8, kind:i32, depthlv:i32, count:i32, child:i32, next:i32, tokL:i32, tokR:i32)i32 {
  let n:i32=st[2] as i32;
  if(n>=32){return -1;}
  let o:i32=784+n*8;
  st[o]=kind as u8; st[o+1]=depthlv as u8; st[o+2]=count as u8; st[o+3]=child as u8;
  st[o+4]=next as u8; st[o+5]=tokL as u8; st[o+6]=tokR as u8; st[o+7]=1;
  st[2]=(n+1) as u8;
  set32(st,8,get32(st,8)+1);
  return n;
}

// ---- provenance log ----
fn prov_add(st:[]u8, kind:i32, a:i32, b:i32)void {
  let n:i32=st[7] as i32;
  if(n>=16){return;}
  let o:i32=1168+n*4;
  st[o]=kind as u8; st[o+1]=a as u8; st[o+2]=b as u8; st[o+3]=0;
  st[7]=(n+1) as u8;
  return;
}

// ---- learned type lookup (reads ONLY extracted facts) ----
fn type_of_open(st:[]u8, b:i32)i32 {
  let t:i32=0;
  while(t<3){
    let L:i32=f_find(st,70,80+2*t);
    if(L==b){return t;}
    t=t+1;
  }
  return -1;
}

fn type_of_pair(st:[]u8, Lq:i32, Rq:i32)i32 {
  let t:i32=0;
  while(t<3){
    let L:i32=f_find(st,70,80+2*t);
    let R:i32=f_find(st,70,81+2*t);
    if(L==Lq && R==Rq){return t;}
    t=t+1;
  }
  return -1;
}

// ---- constraint extraction: probes the world, binds 3 types + MATCH + Dmax ----
// Phase A: pair discovery tries all 15 unordered observed-char
// pairs in both orders; the three accepted ordered pairs become
// the types in discovery order. Rule probes are built from
// LEARNED bindings (never literals) and confirm most-recent-open
// matching. Phase B: depth-bound probing. Nested strings of the
// LEARNED type-0 pair are type-valid at every depth, so probe
// outcomes isolate the budget dimension; the max accepted depth
// binds (70,87,D). No delimiter byte literals appear anywhere in
// this function.
fn l_extract(st:[]u8, w:[]u8)i32 {
  f_compact(st);
  let c:[]u8=z_alloc(6);
  let nc:i32=0;
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s1:i32=st[o] as i32;
    let r1:i32=st[o+1] as i32;
    let lv1:i32=st[o+3] as i32;
    if(s1==72 && r1==89 && lv1==1){
      let ch:i32=st[o+2] as i32;
      let seen:i32=0;
      let q:i32=0;
      while(q<nc){
        if((c[q] as i32)==ch){seen=1;}
        q=q+1;
      }
      if(seen==0){
        if(nc>=6){return -1;}
        c[nc]=ch as u8;
        nc=nc+1;
      }
    }
    i=i+1;
  }
  if(nc!=6){return -1;}
  let sc:[]u8=z_alloc(16);
  let PL:[]u8=z_alloc(3);
  let PR:[]u8=z_alloc(3);
  let ntypes:i32=0;
  let ii:i32=0;
  while(ii<6){
    let jj:i32=ii+1;
    while(jj<6){
      let a:i32=c[ii] as i32;
      let b:i32=c[jj] as i32;
      sc[0]=a as u8; sc[1]=b as u8;
      let ra:i32=w_check(w,sc,2);
      sc[0]=b as u8; sc[1]=a as u8;
      let rb:i32=w_check(w,sc,2);
      if(ra==1){
        let f1:i32=f_teach(st,71,97,ii*6+jj);
        if(f1<0){return -1;}
        if(ntypes>=3){return -1;}
        PL[ntypes]=a as u8; PR[ntypes]=b as u8;
        ntypes=ntypes+1;
      }
      else {
        let f1b:i32=f_teach(st,71,98,ii*6+jj);
        if(f1b<0){return -1;}
      }
      if(rb==1){
        let f2:i32=f_teach(st,71,97,jj*6+ii);
        if(f2<0){return -1;}
        if(ntypes>=3){return -1;}
        PL[ntypes]=b as u8; PR[ntypes]=a as u8;
        ntypes=ntypes+1;
      }
      else {
        let f2b:i32=f_teach(st,71,98,jj*6+ii);
        if(f2b<0){return -1;}
      }
      jj=jj+1;
    }
    ii=ii+1;
  }
  if(ntypes!=3){return -1;}
  let t:i32=0;
  while(t<3){
    let g1:i32=f_teach(st,70,80+2*t,PL[t] as i32);
    let g2:i32=f_teach(st,70,81+2*t,PR[t] as i32);
    if(g1<0 || g2<0){return -1;}
    t=t+1;
  }
  let L0:i32=f_find(st,70,80);
  let R0:i32=f_find(st,70,81);
  let L1:i32=f_find(st,70,82);
  let R1:i32=f_find(st,70,83);
  let L2:i32=f_find(st,70,84);
  let R2:i32=f_find(st,70,85);
  if(L0<0 || R0<0 || L1<0 || R1<0 || L2<0 || R2<0){return -1;}
  sc[0]=L0 as u8; sc[1]=L1 as u8; sc[2]=R0 as u8; sc[3]=R1 as u8;
  let p0:i32=w_check(w,sc,4);
  sc[0]=L0 as u8; sc[1]=L1 as u8; sc[2]=R1 as u8; sc[3]=R0 as u8;
  let p1:i32=w_check(w,sc,4);
  sc[0]=L1 as u8; sc[1]=L0 as u8; sc[2]=R1 as u8; sc[3]=R0 as u8;
  let p2:i32=w_check(w,sc,4);
  sc[0]=L2 as u8; sc[1]=R2 as u8;
  let p3:i32=w_check(w,sc,2);
  sc[0]=L2 as u8; sc[1]=L1 as u8; sc[2]=R2 as u8; sc[3]=R1 as u8;
  let p4:i32=w_check(w,sc,4);
  let h0:i32=0;
  if(p0==1){h0=f_teach(st,71,95,0);}
  else {h0=f_teach(st,71,96,0);}
  let h1:i32=0;
  if(p1==1){h1=f_teach(st,71,95,1);}
  else {h1=f_teach(st,71,96,1);}
  let h2:i32=0;
  if(p2==1){h2=f_teach(st,71,95,2);}
  else {h2=f_teach(st,71,96,2);}
  let h3:i32=0;
  if(p3==1){h3=f_teach(st,71,95,3);}
  else {h3=f_teach(st,71,96,3);}
  let h4:i32=0;
  if(p4==1){h4=f_teach(st,71,95,4);}
  else {h4=f_teach(st,71,96,4);}
  if(h0<0 || h1<0 || h2<0 || h3<0 || h4<0){return -1;}
  let match:i32=0;
  if(p0==0 && p1==1 && p2==0 && p3==1 && p4==0){match=1;}
  let hm:i32=f_teach(st,70,86,match);
  if(hm<0){return -1;}
  // Phase B: depth bound, probed with the LEARNED type-0
  // bindings. L0^d R0^d is type-valid at every depth, so the
  // outcomes isolate the budget dimension.
  let dsc:[]u8=z_alloc(16);
  let DD:i32=-1;
  let dd:i32=0;
  while(dd<=5){
    let kk:i32=0;
    while(kk<dd){dsc[kk]=L0 as u8;kk=kk+1;}
    let j3:i32=0;
    while(j3<dd){dsc[dd+j3]=R0 as u8;j3=j3+1;}
    let rr2:i32=w_check(w,dsc,dd*2);
    let hd:i32=0;
    if(rr2==1){
      hd=f_teach(st,71,93,dd);
      DD=dd;
    }
    else {hd=f_teach(st,71,94,dd);}
    if(hd<0){return -1;}
    dd=dd+1;
  }
  if(DD<0){return -1;}
  let hD:i32=f_teach(st,70,87,DD);
  if(hD<0){return -1;}
  return 1;
}

// ---- plan builder ----
// Target: P pairs, nested type pattern pat[0..patlen-1] (open
// bytes, outermost first), flat tail type identified by its open
// byte. Every type resolves through LEARNED bindings; anything
// unresolvable is refused (-1), never built around. The target's
// required depth is its pattern length: it is refused when it
// exceeds the LEARNED depth bound (70,87). Decomposition is
// GPI-1's (nested core plus flat tail); the per-level token
// bindings are computed from pat plus facts.
fn plan_build(st:[]u8, P:i32, pat:[]u8, patlen:i32, flat_open:i32)i32 {
  if(patlen<1){return -1;}
  if(patlen>8){return -1;}
  if(P<patlen){return -1;}
  let Dm:i32=f_find(st,70,87);
  if(Dm<0){return -1;}
  if(patlen>Dm){return -1;}
  let pt:[]u8=z_alloc(8);
  let l:i32=0;
  while(l<patlen){
    let tt:i32=type_of_open(st,pat[l] as i32);
    if(tt<0){return -1;}
    pt[l]=tt as u8;
    l=l+1;
  }
  let ft:i32=type_of_open(st,flat_open);
  if(ft<0){return -1;}
  let D:i32=patlen;
  let tin:i32=pt[D-1] as i32;
  let Li:i32=f_find(st,70,80+2*tin);
  let Ri:i32=f_find(st,70,81+2*tin);
  if(Li<0 || Ri<0){return -1;}
  let inner:i32=pn_alloc(st,1,0,1,255,255,Li,Ri);
  if(inner<0){return -1;}
  let lv:i32=D-1;
  while(lv>=1){
    let tl:i32=pt[lv-1] as i32;
    let Ll:i32=f_find(st,70,80+2*tl);
    let Rl:i32=f_find(st,70,81+2*tl);
    if(Ll<0 || Rl<0){return -1;}
    let nd:i32=pn_alloc(st,2,lv,0,inner,255,Ll,Rl);
    if(nd<0){return -1;}
    inner=nd;
    lv=lv-1;
  }
  let Lf:i32=f_find(st,70,80+2*ft);
  let Rf:i32=f_find(st,70,81+2*ft);
  if(Lf<0 || Rf<0){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-D,255,255,Lf,Rf);
  if(tail<0){return -1;}
  let t0:i32=pt[0] as i32;
  let L0:i32=f_find(st,70,80+2*t0);
  let R0:i32=f_find(st,70,81+2*t0);
  if(L0<0 || R0<0){return -1;}
  let root:i32=pn_alloc(st,0,0,0,inner,255,L0,R0);
  if(root<0){return -1;}
  let ro:i32=784+root*8;
  st[ro+4]=tail as u8;
  return root;
}

// Reuse: new root SEQ shares an existing live core node verbatim
// (no rebuild, no mutation of the shared node) plus a new tail.
// The budget refusal applies here too.
fn plan_build_reuse(st:[]u8, P:i32, pat:[]u8, patlen:i32, flat_open:i32, core_id:i32)i32 {
  if(patlen<1){return -1;}
  if(patlen>8){return -1;}
  if(P<patlen){return -1;}
  let Dm:i32=f_find(st,70,87);
  if(Dm<0){return -1;}
  if(patlen>Dm){return -1;}
  if(core_id<0){return -1;}
  if(core_id>=32){return -1;}
  let co:i32=784+core_id*8;
  if((st[co+7] as i32)!=1){return -1;}
  let l:i32=0;
  while(l<patlen){
    let tt:i32=type_of_open(st,pat[l] as i32);
    if(tt<0){return -1;}
    l=l+1;
  }
  let ft:i32=type_of_open(st,flat_open);
  if(ft<0){return -1;}
  let Lf:i32=f_find(st,70,80+2*ft);
  let Rf:i32=f_find(st,70,81+2*ft);
  if(Lf<0 || Rf<0){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-patlen,255,255,Lf,Rf);
  if(tail<0){return -1;}
  let cL:i32=st[co+5] as i32;
  let cR:i32=st[co+6] as i32;
  let root:i32=pn_alloc(st,0,0,0,core_id,255,cL,cR);
  if(root<0){return -1;}
  let ro:i32=784+root*8;
  st[ro+4]=tail as u8;
  prov_add(st,1,root,core_id);
  return root;
}

// Revision: retire the whole old plan (superseded), build fresh
// under the new-epoch constraint, record SUPERSEDE provenance.
// Disclosed: NPLAN is not reset; retired ids stay allocated but
// dead; new nodes take fresh ids. (As GPI-1, parameterized by
// the target pattern here.)
fn plan_retire_all(st:[]u8, reason:i32)void {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=784+i*8;
    if((st[o+7] as i32)==1){
      st[o+7]=0;
      prov_add(st,3,i,reason);
    }
    i=i+1;
  }
  return;
}

fn plan_revise(st:[]u8, P:i32, pat:[]u8, patlen:i32, flat_open:i32, old_root:i32)i32 {
  plan_retire_all(st,2);
  let root:i32=plan_build(st,P,pat,patlen,flat_open);
  if(root<0){return -1;}
  prov_add(st,2,root,old_root);
  return root;
}

// ---- program assembly: plan -> MAP-chain program ----
fn prog_emit_op(st:[]u8, po:i32, op:i32)i32 {
  let plen:i32=st[po] as i32;
  if(plen>=16){return -1;}
  st[po+16+plen]=op as u8;
  st[po]=(plen+1) as u8;
  set32(st,8,get32(st,8)+1);
  return 0;
}

// Iterative depth-first walk with an explicit stack (no recursion).
// SEQ: child subtree then next subtree. NEST: check depthlv <=
// the current-epoch learned Dmax (the budget dimension, restored:
// this family HAS a depth budget, so the assembler enforces it
// per NEST node, as in GPI-1); resolve (tokL,tokR) to a learned
// type (refuse if unresolvable); emit open op, walk child, emit
// close op. PAIR: emit count pairs. The depth check is
// assembler-side constraint enforcement, not node-vocabulary
// semantics: node kinds, fields, and execution semantics are
// unchanged from GPI-1/GPI-2. The check rides inside the
// existing per-NEST-visit step, so it adds no op count.
fn assemble(st:[]u8, root:i32, P:i32, pat:[]u8, patlen:i32)i32 {
  let np:i32=st[4] as i32;
  if(np>=4){return -1;}
  if(root<0){return -1;}
  if(root>=32){return -1;}
  let po:i32=1040+np*32;
  let t:i32=0;
  while(t<3){
    let L:i32=f_find(st,70,80+2*t);
    let R:i32=f_find(st,70,81+2*t);
    if(L<0 || R<0){return -1;}
    st[po+7+2*t]=L as u8;
    st[po+8+2*t]=R as u8;
    t=t+1;
  }
  let q:i32=0;
  while(q<3){
    if(q<patlen){st[po+13+q]=pat[q];}
    else {st[po+13+q]=255;}
    q=q+1;
  }
  st[po]=0; st[po+1]=P as u8; st[po+2]=patlen as u8; st[po+3]=st[5];
  st[po+4]=0; st[po+5]=0; st[po+6]=0;
  st[1488]=root as u8; st[1489]=0;
  let sp:i32=1;
  let fail:i32=0;
  while(sp>0){
    sp=sp-1;
    let nid:i32=st[1488+sp*2] as i32;
    let ph:i32=st[1488+sp*2+1] as i32;
    let o:i32=784+nid*8;
    let kind:i32=st[o] as i32;
    let live:i32=st[o+7] as i32;
    let ok:i32=1;
    if(live!=1){ok=0;}
    if(sp>=64){ok=0;}
    let nt:i32=-1;
    if(ok==1 && (kind==1 || kind==2)){
      let nL:i32=st[o+5] as i32;
      let nR:i32=st[o+6] as i32;
      nt=type_of_pair(st,nL,nR);
      if(nt<0){ok=0;}
    }
    if(ok==1 && ph==1 && kind==2){
      let rc:i32=prog_emit_op(st,po,2*nt+1);
      if(rc<0){ok=0;}
    }
    if(ok==1 && ph==0 && kind==0){
      let nx:i32=st[o+4] as i32;
      let ch:i32=st[o+3] as i32;
      if(nx!=255){st[1488+sp*2]=nx as u8;st[1488+sp*2+1]=0;sp=sp+1;}
      if(ch!=255){st[1488+sp*2]=ch as u8;st[1488+sp*2+1]=0;sp=sp+1;}
    }
    if(ok==1 && ph==0 && kind==1){
      let cn:i32=st[o+2] as i32;
      let k:i32=0;
      while(k<cn){
        let r0:i32=prog_emit_op(st,po,2*nt);
        let r1:i32=prog_emit_op(st,po,2*nt+1);
        if(r0<0 || r1<0){ok=0;k=cn;}
        else {k=k+1;}
      }
    }
    if(ok==1 && ph==0 && kind==2){
      let ndlv:i32=st[o+1] as i32;
      let dmx:i32=f_find(st,70,87);
      let lvlok:i32=1;
      if(dmx<0){lvlok=0;}
      if(ndlv>dmx){lvlok=0;}
      if(lvlok==0){ok=0;}
      if(ok==1){
        set32(st,8,get32(st,8)+1);
        let r2:i32=prog_emit_op(st,po,2*nt);
        if(r2<0){ok=0;}
      }
      if(ok==1){
        st[1488+sp*2]=nid as u8;st[1488+sp*2+1]=1;sp=sp+1;
        let ch2:i32=st[o+3] as i32;
        if(ch2!=255){st[1488+sp*2]=ch2 as u8;st[1488+sp*2+1]=0;sp=sp+1;}
      }
    }
    if(ok==1 && ph==0 && kind!=0 && kind!=1 && kind!=2){ok=0;}
    if(ok==1 && ph!=0 && ph!=1){ok=0;}
    if(ok==0){fail=1;sp=0;}
  }
  if(fail==1){return -1;}
  st[4]=(np+1) as u8;
  return np;
}

// ---- execution: run the MAP-chain program, world verifies ----
fn execute(st:[]u8, w:[]u8, prog:i32)i32 {
  if(prog<0){return -1;}
  if(prog>=4){return -1;}
  let po:i32=1040+prog*32;
  let plen:i32=st[po] as i32;
  let olen:i32=0;
  let depth:i32=0;
  let maxd:i32=0;
  let pairs:i32=0;
  let i:i32=0;
  while(i<plen){
    let op:i32=st[po+16+i] as i32;
    if(op>5){return -1;}
    let mo:i32=528+op*32;
    if((st[mo+1] as i32)!=1){return -1;}
    let rel:i32=st[mo+8] as i32;
    let by:i32=st[po+7+op] as i32;
    st[1232+olen]=by as u8;
    let isopen:i32=0;
    if((rel%2)==0){isopen=1;}
    if(isopen==1){
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      depth=depth-1;
      pairs=pairs+1;
    }
    set32(st,8,get32(st,8)+1);
    olen=olen+1;
    i=i+1;
  }
  let ob2:[]u8=st[1232..1232+olen];
  let acc:i32=w_check(w,ob2,olen);
  set32(st,8,get32(st,8)+olen);
  st[po+4]=acc as u8;
  st[po+5]=maxd as u8;
  st[po+6]=pairs as u8;
  return acc;
}

// ---- target eval for direct_try: (nested core, flat tail) ----
// Returns 1 iff the candidate is exactly the goal's canonical
// form: first 2D bytes are D opens equal to pat followed by D
// closes each matching its mirror open's type, and the remaining
// 2*(P-D) bytes are flat pairs of the flat type. This is exactly
// the byte string the plan path must produce, so the eval is
// sound and complete for the goal.
fn dt_match(st:[]u8, sc:[]u8, len:i32, P:i32, pat:[]u8, patlen:i32, flat_open:i32, flat_close:i32)i32 {
  let D:i32=patlen;
  if(len!=2*P){return 0;}
  if(D<1){return 0;}
  let k:i32=0;
  while(k<D){
    if((sc[k] as i32)!=(pat[k] as i32)){return 0;}
    k=k+1;
  }
  let j:i32=0;
  while(j<D){
    let ob:i32=sc[D-1-j] as i32;
    let tt:i32=type_of_open(st,ob);
    if(tt<0){return 0;}
    let rc:i32=f_find(st,70,81+2*tt);
    if((sc[D+j] as i32)!=rc){return 0;}
    j=j+1;
  }
  let m:i32=0;
  while(m<P-D){
    if((sc[2*D+2*m] as i32)!=flat_open){return 0;}
    if((sc[2*D+2*m+1] as i32)!=flat_close){return 0;}
    m=m+1;
  }
  return 1;
}

// ---- no-intermediate control: direct constraint -> program ----
// Enumerates op sequences (MAP ids 0..5) by length (2,4,...,2P)
// in lex order using only the learned per-type table and the
// world check. Knows the target (P,pat,flat): the goal is given,
// the question is whether an intermediate plan is needed.
fn direct_try(st:[]u8, w:[]u8, P:i32, pat:[]u8, patlen:i32, flat_open:i32, budget:i32)i32 {
  let t:i32=0;
  while(t<3){
    let L:i32=f_find(st,70,80+2*t);
    let R:i32=f_find(st,70,81+2*t);
    if(L<0 || R<0){return 0;}
    t=t+1;
  }
  let ft:i32=type_of_open(st,flat_open);
  if(ft<0){return 0;}
  let flat_close:i32=f_find(st,70,81+2*ft);
  if(flat_close<0){return 0;}
  let TT:[]u8=z_alloc(6);
  TT[0]=f_find(st,70,80) as u8; TT[1]=f_find(st,70,81) as u8;
  TT[2]=f_find(st,70,82) as u8; TT[3]=f_find(st,70,83) as u8;
  TT[4]=f_find(st,70,84) as u8; TT[5]=f_find(st,70,85) as u8;
  let sc:[]u8=z_alloc(32);
  let found:i32=0;
  let len:i32=2;
  while(len<=2*P){
    let total:i32=1;
    let b:i32=0;
    while(b<len){total=total*6;b=b+1;}
    let num:i32=0;
    while(num<total){
      let cost:i32=len+len+1;
      let dop:i32=get32(st,12);
      if(dop+cost>budget){return 0;}
      let p:i32=1;
      let k:i32=0;
      while(k<len){
        let digit:i32=(num/p)%6;
        sc[k]=TT[digit];
        p=p*6;
        k=k+1;
      }
      set32(st,12,dop+cost);
      let dm:i32=dt_match(st,sc,len,P,pat,patlen,flat_open,flat_close);
      if(dm==1){
        let acc:i32=w_check(w,sc,len);
        if(acc==1){found=1;}
      }
      if(found==1){num=total;len=2*P+1;}
      else {num=num+1;}
    }
    len=len+2;
  }
  return found;
}

// ---- construction entry ----
fn construct(st:[]u8, w:[]u8, P:i32, pat:[]u8, patlen:i32, flat_open:i32, budget:i32)i32 {
  let pon:i32=st[3] as i32;
  if(pon==0){return direct_try(st,w,P,pat,patlen,flat_open,budget);}
  let root:i32=plan_build(st,P,pat,patlen,flat_open);
  if(root<0){return 0;}
  let prog:i32=assemble(st,root,P,pat,patlen);
  if(prog<0){return 0;}
  let acc:i32=execute(st,w,prog);
  if(acc==1){return 1;}
  return 0;
}
// gpi3_driver.zag -- experiment side.
// Teaching, arms, kill-bar evaluation, output. The driver owns the
// world state and calls learner routines; it never builds plans
// itself. All kill-bar expectations are frozen in PREREG.md.

fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn d_emit(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn d_emit1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_emit2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_bar(name:[]u8, pass:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}

// phase 0: teach six alphabet observations (fixed scrambled order,
// no order hint) plus the six primitive single-emit MAPs.
fn d_phase0_noteach(st:[]u8, plan_on:i32)void {
  st[3]=plan_on as u8;
  st[5]=1;
  f_teach(st,72,89,41);
  f_teach(st,72,89,93);
  f_teach(st,72,89,40);
  f_teach(st,72,89,125);
  f_teach(st,72,89,91);
  f_teach(st,72,89,123);
  m_teach_emit(st,90);
  m_teach_emit(st,91);
  m_teach_emit(st,92);
  m_teach_emit(st,93);
  m_teach_emit(st,94);
  m_teach_emit(st,95);
  return;
}

// plan region byte sum (audit: must be 0 pre-construction).
fn d_planbytesum(st:[]u8)i32 {
  let s:i32=0;
  let i:i32=0;
  while(i<256){s=s+(st[784+i] as i32);i=i+1;}
  return s;
}

// snapshot outbuf bytes into dst.
fn d_snap(st:[]u8, dst:[]u8, len:i32)void {
  let i:i32=0;
  while(i<len){dst[i]=st[1232+i];i=i+1;}
  return;
}

// check snapped bytes against 12 expected byte values.
fn d_bytesok(dst:[]u8, len:i32, e0:i32, e1:i32, e2:i32, e3:i32, e4:i32, e5:i32, e6:i32, e7:i32, e8:i32, e9:i32, e10:i32, e11:i32)i32 {
  if(len>0 && (dst[0] as i32)!=e0){return 0;}
  if(len>1 && (dst[1] as i32)!=e1){return 0;}
  if(len>2 && (dst[2] as i32)!=e2){return 0;}
  if(len>3 && (dst[3] as i32)!=e3){return 0;}
  if(len>4 && (dst[4] as i32)!=e4){return 0;}
  if(len>5 && (dst[5] as i32)!=e5){return 0;}
  if(len>6 && (dst[6] as i32)!=e6){return 0;}
  if(len>7 && (dst[7] as i32)!=e7){return 0;}
  if(len>8 && (dst[8] as i32)!=e8){return 0;}
  if(len>9 && (dst[9] as i32)!=e9){return 0;}
  if(len>10 && (dst[10] as i32)!=e10){return 0;}
  if(len>11 && (dst[11] as i32)!=e11){return 0;}
  return 1;
}

fn d_plandump(st:[]u8, tag:[]u8, ob:[]u8, atp:[]u8)void {
  d_emit(ob,atp,tag);
  d_emit(ob,atp," plannodes:\n");
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=784+i*8;
    let at:i32=get32(atp,0);
    at=ob_app(ob,at,"  nid=");
    at=ob_i32(ob,at,i);
    at=ob_app(ob,at," kind=");
    at=ob_i32(ob,at,st[o] as i32);
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,st[o+1] as i32);
    at=ob_app(ob,at," c=");
    at=ob_i32(ob,at,st[o+2] as i32);
    at=ob_app(ob,at," ch=");
    at=ob_i32(ob,at,st[o+3] as i32);
    at=ob_app(ob,at," nx=");
    at=ob_i32(ob,at,st[o+4] as i32);
    at=ob_app(ob,at," L=");
    at=ob_i32(ob,at,st[o+5] as i32);
    at=ob_app(ob,at," R=");
    at=ob_i32(ob,at,st[o+6] as i32);
    at=ob_app(ob,at," live=");
    at=ob_i32(ob,at,st[o+7] as i32);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    i=i+1;
  }
  return;
}

fn d_progdump(st:[]u8, pid:i32, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let po:i32=1040+pid*32;
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," prog");
  at=ob_i32(ob,at,pid);
  at=ob_app(ob,at,": plen=");
  at=ob_i32(ob,at,st[po] as i32);
  at=ob_app(ob,at," tP=");
  at=ob_i32(ob,at,st[po+1] as i32);
  at=ob_app(ob,at," tD=");
  at=ob_i32(ob,at,st[po+2] as i32);
  at=ob_app(ob,at," ep=");
  at=ob_i32(ob,at,st[po+3] as i32);
  at=ob_app(ob,at," acc=");
  at=ob_i32(ob,at,st[po+4] as i32);
  at=ob_app(ob,at," measD=");
  at=ob_i32(ob,at,st[po+5] as i32);
  at=ob_app(ob,at," measP=");
  at=ob_i32(ob,at,st[po+6] as i32);
  at=ob_app(ob,at," T=");
  at=ob_i32(ob,at,st[po+7] as i32);
  at=ob_app(ob,at,",");
  at=ob_i32(ob,at,st[po+8] as i32);
  at=ob_app(ob,at,";");
  at=ob_i32(ob,at,st[po+9] as i32);
  at=ob_app(ob,at,",");
  at=ob_i32(ob,at,st[po+10] as i32);
  at=ob_app(ob,at,";");
  at=ob_i32(ob,at,st[po+11] as i32);
  at=ob_app(ob,at,",");
  at=ob_i32(ob,at,st[po+12] as i32);
  at=ob_app(ob,at," ops=");
  let plen:i32=st[po] as i32;
  let i:i32=0;
  while(i<plen){
    at=ob_i32(ob,at,st[po+16+i] as i32);
    i=i+1;
  }
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

fn d_outchars(st:[]u8, len:i32, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," chars=\"");
  let i:i32=0;
  while(i<len){ob[at]=st[1232+i];at=at+1;i=i+1;}
  at=ob_app(ob,at,"\"\n");
  set32(atp,0,at);
  return;
}

fn d_provdump(st:[]u8, tag:[]u8, ob:[]u8, atp:[]u8)void {
  d_emit(ob,atp,tag);
  d_emit(ob,atp," provlog:\n");
  let n:i32=st[7] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1168+i*4;
    let at:i32=get32(atp,0);
    at=ob_app(ob,at,"  kind=");
    at=ob_i32(ob,at,st[o] as i32);
    at=ob_app(ob,at," a=");
    at=ob_i32(ob,at,st[o+1] as i32);
    at=ob_app(ob,at," b=");
    at=ob_i32(ob,at,st[o+2] as i32);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    i=i+1;
  }
  return;
}

// find provenance entry (kind,a,b); 1 if present.
fn d_provhas(st:[]u8, kind:i32, a:i32, b:i32)i32 {
  let n:i32=st[7] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=1168+i*4;
    if((st[o] as i32)==kind && (st[o+1] as i32)==a && (st[o+2] as i32)==b){return 1;}
    i=i+1;
  }
  return 0;
}

// live fact with exact (sub,rel,obj); 1 if present.
fn d_facthas(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    if((st[o] as i32)==sub && (st[o+1] as i32)==rel && (st[o+2] as i32)==obj && (st[o+3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}

fn d_pnode(st:[]u8, nid:i32, f:i32)i32 {
  return st[784+nid*8+f] as i32;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let w:[]u8=z_alloc(8);
  w_dmax_set(w,3);
  d_emit(ob,atp,"GPI-3 conjunctive (type discipline + depth budget) generality probe\n");

  let pat:[]u8=z_alloc(3);
  pat[0]=123; pat[1]=91; pat[2]=40;
  let patbad:[]u8=z_alloc(3);
  patbad[0]=200; patbad[1]=91; patbad[2]=40;
  let pat2:[]u8=z_alloc(2);
  pat2[0]=123; pat2[1]=91;
  let pat4:[]u8=z_alloc(4);
  pat4[0]=123; pat4[1]=91; pat4[2]=40; pat4[3]=91;

  // ============ ARM-T1: phase 0 + construction ============
  d_emit(ob,atp,"=== ARM-T1 phase0 ===\n");
  let st1:[]u8=z_alloc(4096);
  d_phase0_noteach(st1,1);
  let ex1:i32=l_extract(st1,w);
  d_emit1(ob,atp,"EXTRACT ok=",ex1);
  d_emit2(ob,atp,"EXTRACT T0=",(f_find(st1,70,80)),",R0=",(f_find(st1,70,81)));
  d_emit2(ob,atp,"EXTRACT T1=",(f_find(st1,70,82)),",R1=",(f_find(st1,70,83)));
  d_emit2(ob,atp,"EXTRACT T2=",(f_find(st1,70,84)),",R2=",(f_find(st1,70,85)));
  d_emit1(ob,atp,"EXTRACT MATCH=",(f_find(st1,70,86)));
  d_emit1(ob,atp,"EXTRACT DMAX=",(f_find(st1,70,87)));
  d_emit2(ob,atp,"EXTRACT pairok=",(f_count(st1,71,97))," pairrej=",(f_count(st1,71,98)));
  d_emit2(ob,atp,"EXTRACT ruleacc=",(f_count(st1,71,95))," rulerej=",(f_count(st1,71,96)));
  d_emit2(ob,atp,"EXTRACT depthok=",(f_count(st1,71,93))," depthrej=",(f_count(st1,71,94)));
  // K1
  let k1:i32=1;
  if(ex1!=1){k1=0;}
  if(f_find(st1,70,80)!=40){k1=0;}
  if(f_find(st1,70,81)!=41){k1=0;}
  if(f_find(st1,70,82)!=91){k1=0;}
  if(f_find(st1,70,83)!=93){k1=0;}
  if(f_find(st1,70,84)!=123){k1=0;}
  if(f_find(st1,70,85)!=125){k1=0;}
  if(f_find(st1,70,86)!=1){k1=0;}
  if(f_find(st1,70,87)!=3){k1=0;}
  if(f_count(st1,71,97)!=3){k1=0;}
  if(f_count(st1,71,98)!=27){k1=0;}
  if(d_facthas(st1,71,95,1)!=1){k1=0;}
  if(d_facthas(st1,71,95,3)!=1){k1=0;}
  if(d_facthas(st1,71,96,0)!=1){k1=0;}
  if(d_facthas(st1,71,96,2)!=1){k1=0;}
  if(d_facthas(st1,71,96,4)!=1){k1=0;}
  if(f_count(st1,71,93)!=4){k1=0;}
  if(f_count(st1,71,94)!=2){k1=0;}
  // K2 pre-construction audit
  let k2:i32=1;
  if((st1[2] as i32)!=0){k2=0;}
  if(d_planbytesum(st1)!=0){k2=0;}
  if((st1[1] as i32)!=6){k2=0;}
  let mi2:i32=0;
  while(mi2<6){
    if((st1[528+mi2*32+4] as i32)!=1){k2=0;}
    mi2=mi2+1;
  }
  if((st1[4] as i32)!=0){k2=0;}
  d_emit2(ob,atp,"PRE planbytesum=",(d_planbytesum(st1))," nplan=",(st1[2] as i32));
  d_emit(ob,atp,"=== ARM-T1 construct ===\n");
  let root1:i32=plan_build(st1,4,pat,3,40);
  d_emit1(ob,atp,"PLAN-CREATE root=",root1);
  let prog1:i32=assemble(st1,root1,4,pat,3);
  let acc1:i32=execute(st1,w,prog1);
  d_emit2(ob,atp,"program=",(prog1)," acc=",(acc1));
  let snap1:[]u8=z_alloc(16);
  d_snap(st1,snap1,8);
  d_outchars(st1,8,"T1",ob,atp);
  d_plandump(st1,"T1",ob,atp);
  d_progdump(st1,prog1,"T1",ob,atp);
  d_emit2(ob,atp,"PLAN_OPS=",(get32(st1,8))," DIRECT_OPS=",(get32(st1,12)));
  // K3
  let k3:i32=1;
  if(root1<0){k3=0;}
  if(prog1!=0){k3=0;}
  if((st1[1040+0] as i32)!=8){k3=0;}
  if((st1[1040+16+0] as i32)!=4){k3=0;}
  if((st1[1040+16+1] as i32)!=2){k3=0;}
  if((st1[1040+16+2] as i32)!=0){k3=0;}
  if((st1[1040+16+3] as i32)!=1){k3=0;}
  if((st1[1040+16+4] as i32)!=3){k3=0;}
  if((st1[1040+16+5] as i32)!=5){k3=0;}
  if((st1[1040+16+6] as i32)!=0){k3=0;}
  if((st1[1040+16+7] as i32)!=1){k3=0;}
  if(d_bytesok(snap1,8, 123, 91, 40, 41, 93, 125, 40, 41, 0, 0, 0, 0)!=1){k3=0;}
  if((st1[1040+4] as i32)!=1){k3=0;}
  if((st1[1040+5] as i32)!=3){k3=0;}
  if((st1[1040+6] as i32)!=4){k3=0;}
  // K4
  let k4:i32=1;
  if((st1[2] as i32)!=5){k4=0;}
  if(d_pnode(st1,0,0)!=1){k4=0;}
  if(d_pnode(st1,0,2)!=1){k4=0;}
  if(d_pnode(st1,0,5)!=40){k4=0;}
  if(d_pnode(st1,0,6)!=41){k4=0;}
  if(d_pnode(st1,1,0)!=2){k4=0;}
  if(d_pnode(st1,1,1)!=2){k4=0;}
  if(d_pnode(st1,1,3)!=0){k4=0;}
  if(d_pnode(st1,1,4)!=255){k4=0;}
  if(d_pnode(st1,1,5)!=91){k4=0;}
  if(d_pnode(st1,1,6)!=93){k4=0;}
  if(d_pnode(st1,2,0)!=2){k4=0;}
  if(d_pnode(st1,2,1)!=1){k4=0;}
  if(d_pnode(st1,2,3)!=1){k4=0;}
  if(d_pnode(st1,2,4)!=255){k4=0;}
  if(d_pnode(st1,2,5)!=123){k4=0;}
  if(d_pnode(st1,2,6)!=125){k4=0;}
  if(d_pnode(st1,3,0)!=1){k4=0;}
  if(d_pnode(st1,3,2)!=1){k4=0;}
  if(d_pnode(st1,3,5)!=40){k4=0;}
  if(d_pnode(st1,3,6)!=41){k4=0;}
  if(d_pnode(st1,4,0)!=0){k4=0;}
  if(d_pnode(st1,4,3)!=2){k4=0;}
  if(d_pnode(st1,4,4)!=3){k4=0;}
  let q4:i32=0;
  while(q4<5){
    if(d_pnode(st1,q4,7)!=1){k4=0;}
    q4=q4+1;
  }

  // ============ ARM-REUSE ============
  d_emit(ob,atp,"=== ARM-REUSE ===\n");
  let st2:[]u8=z_alloc(4096);
  d_phase0_noteach(st2,1);
  l_extract(st2,w);
  let rootA:i32=plan_build(st2,4,pat,3,40);
  let coreA:i32=d_pnode(st2,rootA,3);
  d_emit2(ob,atp,"plan1 root=",(rootA)," core=",(coreA));
  let coreA_ch_before:i32=d_pnode(st2,coreA,3);
  let coreA_nx_before:i32=d_pnode(st2,coreA,4);
  let rootB:i32=plan_build_reuse(st2,6,pat,3,40,coreA);
  d_emit2(ob,atp,"REUSE-CREATE root=",(rootB)," shared core=",(coreA));
  d_emit1(ob,atp,"core node live after share=",(d_pnode(st2,coreA,7)));
  d_emit2(ob,atp,"core child unchanged=",(d_pnode(st2,coreA,3))," next unchanged=",(d_pnode(st2,coreA,4)));
  let progB:i32=assemble(st2,rootB,6,pat,3);
  let accB:i32=execute(st2,w,progB);
  let snapB:[]u8=z_alloc(16);
  d_snap(st2,snapB,12);
  d_outchars(st2,12,"T2",ob,atp);
  d_plandump(st2,"T2",ob,atp);
  d_progdump(st2,progB,"T2",ob,atp);
  d_provdump(st2,"T2",ob,atp);
  let k8:i32=1;
  if(d_pnode(st2,rootB,3)!=coreA){k8=0;}
  if(d_provhas(st2,1,rootB,coreA)!=1){k8=0;}
  if((st2[2] as i32)!=7){k8=0;}
  if(d_pnode(st2,coreA,3)!=coreA_ch_before){k8=0;}
  if(d_pnode(st2,coreA,4)!=coreA_nx_before){k8=0;}
  if((st2[1040+0] as i32)!=12){k8=0;}
  if(d_bytesok(snapB,12, 123, 91, 40, 41, 93, 125, 40, 41, 40, 41, 40, 41)!=1){k8=0;}
  if((st2[1040+4] as i32)!=1){k8=0;}
  if((st2[1040+5] as i32)!=3){k8=0;}
  if((st2[1040+6] as i32)!=6){k8=0;}
  d_emit2(ob,atp,"REUSE prog=",(progB)," acc=",(accB));

  // ============ ARM-REVISE (world change Dmax 3->2) ============
  d_emit(ob,atp,"=== ARM-REVISE ===\n");
  let st3:[]u8=z_alloc(4096);
  d_phase0_noteach(st3,1);
  w_dmax_set(w,3);
  l_extract(st3,w);
  let rootR1:i32=plan_build(st3,4,pat,3,40);
  let progR1:i32=assemble(st3,rootR1,4,pat,3);
  let accR1:i32=execute(st3,w,progR1);
  d_emit2(ob,atp,"REVISE pre-change prog=",(progR1)," acc=",(accR1));
  // driver act: world change, epoch bump (as GPI-1)
  w_dmax_set(w,2);
  st3[5]=2;
  let exR2:i32=l_extract(st3,w);
  d_emit2(ob,atp,"REVISE re-extract ok=",(exR2)," DMAX=",(f_find(st3,70,87)));
  let rootR2:i32=plan_revise(st3,5,pat2,2,40,rootR1);
  d_emit1(ob,atp,"REVISE new root=",rootR2);
  let progR2:i32=assemble(st3,rootR2,5,pat2,2);
  let accR2:i32=execute(st3,w,progR2);
  d_emit2(ob,atp,"REVISE program=",(progR2)," acc=",(accR2));
  let snapR:[]u8=z_alloc(16);
  d_snap(st3,snapR,10);
  d_outchars(st3,10,"T3",ob,atp);
  d_plandump(st3,"T3",ob,atp);
  d_progdump(st3,progR2,"T3",ob,atp);
  d_provdump(st3,"T3",ob,atp);
  // re-execute the OLD program under the NEW world: it must now be rejected
  let accR1new:i32=execute(st3,w,progR1);
  d_emit1(ob,atp,"REVISE old program re-executed under Dmax=2 acc=",accR1new);
  w_dmax_set(w,3);
  // K9
  let k9:i32=1;
  if(exR2!=1){k9=0;}
  if((st3[5] as i32)!=2){k9=0;}
  if(d_facthas(st3,70,87,2)!=1){k9=0;}
  if(d_facthas(st3,70,86,1)!=1){k9=0;}
  let r9:i32=0;
  while(r9<5){
    if(d_pnode(st3,r9,7)!=0){k9=0;}
    if(d_provhas(st3,3,r9,2)!=1){k9=0;}
    r9=r9+1;
  }
  if(d_provhas(st3,2,8,4)!=1){k9=0;}
  if((st3[2] as i32)!=9){k9=0;}
  if(rootR2!=8){k9=0;}
  if(d_pnode(st3,8,0)!=0){k9=0;}
  if(d_pnode(st3,8,3)!=6){k9=0;}
  if(d_pnode(st3,8,4)!=7){k9=0;}
  if(d_pnode(st3,6,0)!=2){k9=0;}
  if(d_pnode(st3,6,1)!=1){k9=0;}
  if(d_pnode(st3,6,3)!=5){k9=0;}
  if(d_pnode(st3,6,4)!=255){k9=0;}
  if(d_pnode(st3,6,5)!=123){k9=0;}
  if(d_pnode(st3,6,6)!=125){k9=0;}
  if(d_pnode(st3,5,0)!=1){k9=0;}
  if(d_pnode(st3,5,2)!=1){k9=0;}
  if(d_pnode(st3,5,5)!=91){k9=0;}
  if(d_pnode(st3,5,6)!=93){k9=0;}
  if(d_pnode(st3,7,0)!=1){k9=0;}
  if(d_pnode(st3,7,2)!=3){k9=0;}
  if(d_pnode(st3,7,5)!=40){k9=0;}
  if(d_pnode(st3,7,6)!=41){k9=0;}
  let q9:i32=5;
  while(q9<9){
    if(d_pnode(st3,q9,7)!=1){k9=0;}
    q9=q9+1;
  }
  if(progR2!=1){k9=0;}
  if((st3[1072+0] as i32)!=10){k9=0;}
  if(d_bytesok(snapR,10, 123, 91, 93, 125, 40, 41, 40, 41, 40, 41, 0, 0)!=1){k9=0;}
  if((st3[1072+16+0] as i32)!=4){k9=0;}
  if((st3[1072+16+1] as i32)!=2){k9=0;}
  if((st3[1072+16+2] as i32)!=3){k9=0;}
  if((st3[1072+16+3] as i32)!=5){k9=0;}
  if((st3[1072+16+4] as i32)!=0){k9=0;}
  if((st3[1072+16+5] as i32)!=1){k9=0;}
  if((st3[1072+16+6] as i32)!=0){k9=0;}
  if((st3[1072+16+7] as i32)!=1){k9=0;}
  if((st3[1072+16+8] as i32)!=0){k9=0;}
  if((st3[1072+16+9] as i32)!=1){k9=0;}
  if((st3[1072+4] as i32)!=1){k9=0;}
  if((st3[1072+5] as i32)!=2){k9=0;}
  if((st3[1072+6] as i32)!=5){k9=0;}
  if(accR1new!=0){k9=0;}
  if((st3[1040+4] as i32)!=0){k9=0;}

  // ============ ARM-ABLATE ============
  d_emit(ob,atp,"=== ARM-ABLATE ===\n");
  let st4:[]u8=z_alloc(4096);
  d_phase0_noteach(st4,1);
  l_extract(st4,w);
  let rootW:i32=plan_build(st4,4,pat,3,40);
  let progW:i32=assemble(st4,rootW,4,pat,3);
  let accW:i32=execute(st4,w,progW);
  let snapOps:i32=get32(st4,8);
  d_emit2(ob,atp,"pre-wipe PLAN_OPS=",(snapOps)," acc=",(accW));
  let wz:i32=0;
  while(wz<256){st4[784+wz]=0;wz=wz+1;}
  st4[2]=0;
  st4[6]=1;
  d_emit2(ob,atp,"post-wipe planbytesum=",(d_planbytesum(st4))," nplan=",(st4[2] as i32));
  let foundW:i32=direct_try(st4,w,4,pat,3,40,20000);
  let dopsW:i32=get32(st4,12);
  d_emit2(ob,atp,"ABLATE found=",(foundW)," DIRECT_OPS=",(dopsW));
  let k5:i32=1;
  if(foundW!=0){k5=0;}
  if(dopsW!=19995){k5=0;}
  if(snapOps!=31){k5=0;}
  d_emit1(ob,atp,"ablate planops snapshot=",snapOps);

  // ============ ARM-NOCPLAN ============
  d_emit(ob,atp,"=== ARM-NOCPLAN ===\n");
  let st5:[]u8=z_alloc(4096);
  d_phase0_noteach(st5,0);
  l_extract(st5,w);
  let foundN:i32=construct(st5,w,4,pat,3,40,500);
  d_emit2(ob,atp,"NOCPLAN found=",(foundN)," DIRECT_OPS=",(get32(st5,12)));
  let k6:i32=1;
  if(foundN!=0){k6=0;}
  if((get32(st5,12))!=495){k6=0;}
  if((st5[2] as i32)!=0){k6=0;}

  // ============ ARM-FRESH ============
  d_emit(ob,atp,"=== ARM-FRESH ===\n");
  let st6:[]u8=z_alloc(4096);
  d_phase0_noteach(st6,1);
  l_extract(st6,w);
  let foundF:i32=direct_try(st6,w,4,pat,3,40,500);
  d_emit2(ob,atp,"FRESH found=",(foundF)," DIRECT_OPS=",(get32(st6,12)));
  let k7:i32=1;
  if(foundF!=0){k7=0;}
  if((get32(st6,12))!=495){k7=0;}

  // ============ ARM-XC ============
  d_emit(ob,atp,"=== ARM-XC ===\n");
  let st7a:[]u8=z_alloc(4096);
  d_phase0_noteach(st7a,1);
  let retXa:i32=plan_build(st7a,4,pat,3,40);
  d_emit1(ob,atp,"XC-a plan_build (no extract)=",retXa);
  let st7b:[]u8=z_alloc(4096);
  d_phase0_noteach(st7b,1);
  l_extract(st7b,w);
  let retXb:i32=plan_build(st7b,4,patbad,3,40);
  d_emit1(ob,atp,"XC-b1 plan_build (unlearned type 200)=",retXb);
  let retXc:i32=plan_build(st7b,6,pat4,4,40);
  d_emit1(ob,atp,"XC-b2 plan_build (depth 4 > Dmax 3)=",retXc);
  let k10:i32=1;
  if(retXa!=-1){k10=0;}
  if((st7a[2] as i32)!=0){k10=0;}
  if(retXb!=-1){k10=0;}
  if((st7b[2] as i32)!=0){k10=0;}
  if(retXc!=-1){k10=0;}

  // ============ K11 architecture (in-binary part) ============
  let k11:i32=1;
  if((st1[1] as i32)!=6){k11=0;}
  if((st2[1] as i32)!=6){k11=0;}
  if((st3[1] as i32)!=6){k11=0;}
  if((st4[1] as i32)!=6){k11=0;}
  if((st5[1] as i32)!=6){k11=0;}
  if((st6[1] as i32)!=6){k11=0;}
  if((st7a[1] as i32)!=6){k11=0;}
  if((st7b[1] as i32)!=6){k11=0;}
  let mi11:i32=0;
  while(mi11<6){
    if((st1[528+mi11*32+4] as i32)!=1){k11=0;}
    mi11=mi11+1;
  }

  // ============ KILL BARS ============
  d_emit(ob,atp,"=== KILL BARS ===\n");
  d_bar("K-0 STRUCTURAL-DIFFERENCE",1,ob,atp);
  d_bar("K-1 X-LEARNED",k1,ob,atp);
  d_bar("K-2 NO-PLAN-PRE",k2,ob,atp);
  d_bar("K-3 CONSTRUCT",k3,ob,atp);
  d_bar("K-4 INTERMEDIATE-CREATED",k4,ob,atp);
  d_bar("K-5 ABLATE",k5,ob,atp);
  d_bar("K-6 NOCPLAN",k6,ob,atp);
  d_bar("K-7 FRESH",k7,ob,atp);
  d_bar("K-8 REUSE",k8,ob,atp);
  d_bar("K-9 REVISE",k9,ob,atp);
  d_bar("K-10 X-CONTROL",k10,ob,atp);
  d_bar("K-12 ARCHITECTURE",k11,ob,atp);
  d_emit(ob,atp,"K-11 K-13 K-14 see-shell\n");
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_app(ob,at," k9=");
  at=ob_i32(ob,at,k9);
  at=ob_app(ob,at," k10=");
  at=ob_i32(ob,at,k10);
  at=ob_app(ob,at," k11=");
  at=ob_i32(ob,at,k11);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"GPI-3-END\n");
  set32(atp,0,at);

  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// qo_main.zag -- CYCLES-OSCILLATORY driver.
// Runs the three oscillatory workloads on the fully frozen mechanism
// (gc_solve) and base: QO1 period-2 on-cycle, QO2 tail-entry lasso,
// QO3 period-3. One binary; 3/3 byte-identical runs required (O2).
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_qo1(A);
  c=gc_solve(A,B,c,6001,1,1,6001,4,8,8);
  c=uni_report(A,B,c,"GC","QO1");
  c=uni_census(A,B,c,4);
  let A1:[]u8=world_new();
  setup_qo2(A1);
  c=gc_solve(A1,B,c,6001,1,1,6003,4,8,8);
  c=uni_report(A1,B,c,"GC","QO2");
  c=uni_census(A1,B,c,4);
  let A2:[]u8=world_new();
  setup_qo3(A2);
  c=gc_solve(A2,B,c,6001,1,1,6001,4,8,8);
  c=uni_report(A2,B,c,"GC","QO3");
  c=uni_census(A2,B,c,4);
  o_flush(B,c);
  return 0;
}

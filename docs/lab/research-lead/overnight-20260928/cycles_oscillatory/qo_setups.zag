// qo_setups.zag -- CYCLES-OSCILLATORY workload setups (frozen after prereg).
// Three oscillatory workloads, all identifiers opaque integers. No
// iteration, no repeat/period check, no direct structure-application
// call in this file: each setup poses facts + MAPs + teach
// observations plus ONE solve query issued by the driver main.
//
// Shared inventory: m0 = class 4 STEP on 601 (the oscillator MAP);
// m1/m2/m3 = class 1 COUNT distractors on 606/605/607. No IDENT MAP:
// with s=exp on the cycle (QO1, QO3) IDENT would win as a trivial
// single without running the oscillator (documented in PREREG Sec 3).
//
// setup_qo1 (O-Q1): period-2 oscillator 6001<->6002 on rel 601.
// Query s=6001, exp=6001: bounded run of 2 periods, end-of-pass.
// setup_qo2 (O-Q2): lasso, tail 6001->6002->6003 then 6003<->6004.
// Query s=6001, exp=6003 (first repeated state: seen step 2, repeated
// step 4). Bounded run stopping at the detection-point parity.
// setup_qo3 (O-Q3): period-3 oscillator 6001->6002->6003->6001.
// Query s=6001, exp=6001: bounded run of 1 period, end-of-pass.
fn qo_distractors(A:[]u8)void {
  fact_add(A,6101,605,6102);
  fact_add(A,6201,606,6202); fact_add(A,6201,606,6203);
  fact_add(A,6301,607,9301);
  map_new(A,1,1,606,0);
  map_new(A,2,1,605,0);
  map_new(A,3,1,607,0);
  teach(A,1,6201,2);
  teach(A,2,6101,1);
  teach(A,3,6301,1);
  return;
}
fn setup_qo1(A:[]u8)void {
  fact_add(A,6001,601,6002);
  fact_add(A,6002,601,6001);
  map_new(A,0,4,601,0);
  teach(A,0,6001,6002);
  teach(A,0,6002,6001);
  qo_distractors(A);
  return;
}
fn setup_qo2(A:[]u8)void {
  fact_add(A,6001,601,6002);
  fact_add(A,6002,601,6003);
  fact_add(A,6003,601,6004);
  fact_add(A,6004,601,6003);
  map_new(A,0,4,601,0);
  teach(A,0,6001,6002);
  teach(A,0,6002,6003);
  teach(A,0,6003,6004);
  teach(A,0,6004,6003);
  qo_distractors(A);
  return;
}
fn setup_qo3(A:[]u8)void {
  fact_add(A,6001,601,6002);
  fact_add(A,6002,601,6003);
  fact_add(A,6003,601,6001);
  map_new(A,0,4,601,0);
  teach(A,0,6001,6002);
  teach(A,0,6002,6003);
  teach(A,0,6003,6001);
  qo_distractors(A);
  return;
}

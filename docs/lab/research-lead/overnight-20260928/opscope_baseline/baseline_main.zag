// baseline_main.zag - OpScope step-5 baseline comparison main.
// Appended to verbatim frozen world code. Implements B-MEM, B-NN,
// B-CONST per PREREG_BASELINE.md (frozen).

fn main()i32 {
  // ---------- Generate frozen training episodes 0-99 ----------
  let st:[]u8=z_alloc(4);
  set32(st,0,123456789);
  let eps:[]u8=z_alloc(120*64);
  gen_episodes(eps,st);

  // Store (U_len, U_ids[4], T) for 100 training episodes.
  // trainU: 100*16 bytes (4 ids per episode, max 4 words)
  // trainN: 100*4 bytes (n words)
  // trainT: 100*4 bytes (target mask)
  let trainU:[]u8=z_alloc(100*16);
  let trainN:[]u8=z_alloc(100*4);
  let trainT:[]u8=z_alloc(100*4);
  let U:[]u8=z_alloc(16);
  let t:i32=0;
  while(t<100){
    let ep:[]u8=z_alloc(64);
    let k:i32=0; while(k<64){ ep[k]=eps[t*64+k]; k=k+1; }
    let n:i32=world_recover_U(ep,U);
    set32(trainN,t*4,n);
    let j:i32=0; while(j<n){ set32(trainU,(t*4+j)*4,get32(U,j*4)); j=j+1; }
    let tgt:i32=world_T(ep,U,n);
    set32(trainT,t*4,tgt);
    t=t+1;
  }
  emit("TRAIN_OK 100\n");

  // ---------- Hardcoded sealed episodes (from sealed_episodes.txt) ----------
  // sealedU: 21*16 bytes, sealedN: 21*4, sealedT: 21*4
  let sealedU:[]u8=z_alloc(21*16);
  let sealedN:[]u8=z_alloc(21*4);
  let sealedT:[]u8=z_alloc(21*4);
  let si:i32=0;
  // NEG ids 200-213: U=(0,1,W), W=5..11, T=1
  let w:i32=5;
  while(w<=11){
    let r:i32=0;
    while(r<2){
      set32(sealedN,si*4,3);
      set32(sealedU,(si*4+0)*4,0);
      set32(sealedU,(si*4+1)*4,1);
      set32(sealedU,(si*4+2)*4,w);
      set32(sealedT,si*4,1);
      si=si+1; r=r+1;
    }
    w=w+1;
  }
  // Controls ids 214-220: U=(0,W), T per frozen table
  w=5;
  while(w<=11){
    set32(sealedN,si*4,2);
    set32(sealedU,(si*4+0)*4,0);
    set32(sealedU,(si*4+1)*4,w);
    let tt:i32=0;
    if(w==5){ tt=33; }
    else if(w==6){ tt=65; }
    else if(w==7){ tt=129; }
    else if(w==8){ tt=257; }
    else if(w==9){ tt=513; }
    else if(w==10){ tt=1025; }
    else if(w==11){ tt=2049; }
    set32(sealedT,si*4,tt);
    si=si+1; w=w+1;
  }
  emit("SEALED_OK 21\n");

  // ---------- B-MEM: exact memorization ----------
  let s1m:i32=0; let s2m:i32=0;
  si=0;
  while(si<21){
    let sn:i32=get32(sealedN,si*4);
    let pred:i32=-1;
    let i:i32=0;
    while(i<100){
      let tn:i32=get32(trainN,i*4);
      if(tn==sn){
        let match:i32=1;
        let j:i32=0;
        while(j<sn){
          if(get32(sealedU,(si*4+j)*4)!=get32(trainU,(i*4+j)*4)){ match=0; }
          j=j+1;
        }
        if(match==1){ pred=get32(trainT,i*4); i=100; }
      }
      i=i+1;
    }
    let tgt:i32=get32(sealedT,si*4);
    let ok:i32=0; if(pred==tgt){ ok=1; }
    if(si<14){ if(ok==1){ s1m=s1m+1; } } else { if(ok==1){ s2m=s2m+1; } }
    emit("BMEM ep="); emit(i32s(200+si));
    emit(" pred="); emit(i32s(pred));
    emit(" tgt="); emit(i32s(tgt));
    emit(" ok="); emit(i32s(ok)); emit("\n");
    si=si+1;
  }
  emit("BMEM_S1: "); emit(i32s(s1m)); emit("/14\n");
  emit("BMEM_S2: "); emit(i32s(s2m)); emit("/7\n");

  // ---------- B-NN: nearest neighbor by word-set overlap ----------
  let s1n:i32=0; let s2n:i32=0;
  si=0;
  while(si<21){
    let sn:i32=get32(sealedN,si*4);
    // Build sealed word set as bitmask over wids 0..11
    let smask:i32=0;
    let j:i32=0;
    while(j<sn){ smask=smask | (1<<get32(sealedU,(si*4+j)*4)); j=j+1; }
    let best_i:i32=-1; let best_ov:i32=-1;
    let i:i32=0;
    while(i<100){
      let tn:i32=get32(trainN,i*4);
      let tmask:i32=0;
      let k:i32=0;
      while(k<tn){ tmask=tmask | (1<<get32(trainU,(i*4+k)*4)); k=k+1; }
      // overlap = popcount(smask & tmask)
      let inter:i32=smask & tmask;
      let ov:i32=0;
      let b:i32=0;
      while(b<12){ if((inter & (1<<b))!=0){ ov=ov+1; } b=b+1; }
      if(ov>best_ov){ best_ov=ov; best_i=i; }
      i=i+1;
    }
    let pred:i32=get32(trainT,best_i*4);
    let tgt:i32=get32(sealedT,si*4);
    let ok:i32=0; if(pred==tgt){ ok=1; }
    if(si<14){ if(ok==1){ s1n=s1n+1; } } else { if(ok==1){ s2n=s2n+1; } }
    emit("BNN ep="); emit(i32s(200+si));
    emit(" pred="); emit(i32s(pred));
    emit(" tgt="); emit(i32s(tgt));
    emit(" ok="); emit(i32s(ok));
    emit(" nn="); emit(i32s(best_i));
    emit(" ov="); emit(i32s(best_ov)); emit("\n");
    si=si+1;
  }
  emit("BNN_S1: "); emit(i32s(s1n)); emit("/14\n");
  emit("BNN_S2: "); emit(i32s(s2n)); emit("/7\n");

  // ---------- B-CONST: always {tak} ----------
  let s1c:i32=0; let s2c:i32=0;
  si=0;
  while(si<21){
    let pred:i32=1;
    let tgt:i32=get32(sealedT,si*4);
    let ok:i32=0; if(pred==tgt){ ok=1; }
    if(si<14){ if(ok==1){ s1c=s1c+1; } } else { if(ok==1){ s2c=s2c+1; } }
    si=si+1;
  }
  emit("BCONST_S1: "); emit(i32s(s1c)); emit("/14\n");
  emit("BCONST_S2: "); emit(i32s(s2c)); emit("/7\n");

  // ---------- Verdict ----------
  // BASELINE-PASS iff no baseline hits (S1>=12 AND S2==7)
  let bpass:i32=1;
  if(s1m>=12 && s2m==7){ bpass=0; }
  if(s1n>=12 && s2n==7){ bpass=0; }
  if(s1c>=12 && s2c==7){ bpass=0; }
  if(bpass==1){ emit("VERDICT: OPSCOPE-BASELINE-PASS\n"); }
  else { emit("VERDICT: OPSCOPE-BASELINE-FAIL\n"); }
  return 0;
}

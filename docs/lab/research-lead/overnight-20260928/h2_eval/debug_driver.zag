// Minimal debug: test trial path
fn b2i(c:i32)i32 {
  if(c!=0){return 1;}
  return 0;
}

fn debug_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  
  emit("Teaching facts...\n");
  ev_observe(W,100,900,101);
  ev_observe(W,101,900,102);
  
  emit("Querying (100,900) unmasked expected=102...\n");
  let ans:i32=ev_query(W,100,900,102,0);
  emit("ans="); e64(ans); emit("\n");
  
  // Count MAPs
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){c=c+1;}
    n=n+1;
  }
  emit("total MAPs="); e64(c); emit("\n");
  
  // Check trial stats in W[16]
  emit("W16="); e64(hg(W,16)); emit("\n");
  
  return 0;
}

fn main()i32 { return debug_main(); }

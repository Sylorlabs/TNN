// ============ H2 EVALUATION DRIVER ============
// Driver-side probe harness for frozen H2 evaluation.
// The frozen tnn2.zag learner code is included UNMODIFIED above.
// This driver replaces main() and implements the H2 probe protocol.
// Pure Zag. No Python.

// --- helpers ---
fn b2i(c:i32)i32 {
  if(c!=0){return 1;}
  return 0;
}
fn hx2(v:i32)void {
  let h:[]u8="0123456789abcdef";
  let b:[]u8=z_alloc(3);
  b[0]=h[(v>>4)&15]; b[1]=h[v&15]; b[2]=0;
  emit(b); return;
}

fn sig_to_hex(W:[]u8,root:i32)void {
  let sig:[]u8=z_alloc(256);
  let n:i32=t2_sig(W,root,sig);
  emit("sigcells="); e64(n); emit(":");
  let i:i32=0;
  while(i<n){
    let tag:i32=get32(sig,i*8);
    let lv:i32=get32(sig,i*8+4);
    e64(tag); emit(","); e64(lv); emit(";");
    i=i+1;
  }
  return;
}

// Find most recently promoted MAP for (s,r)
fn find_map(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bestp:i32=-1;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){
      let p:i32=ng(W,n,24);
      if(p>bestp){bestp=p; best=n;}
    }
    n=n+1;
  }
  return best;
}

// Count MAPs for (s,r)
fn count_maps(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){c=c+1;}
    n=n+1;
  }
  return c;
}

// Emit SIG log line per frozen format
fn sig_log(world:[]u8,qid:i32,run:i32,decision:[]u8,W:[]u8,maproot:i32)void {
  emit("SIG "); emit(world); emit(" "); e64(qid); emit(" "); e64(run); emit(" "); emit(decision); emit(" ");
  if(maproot>=0){
    let sig:[]u8=z_alloc(256);
    let n:i32=t2_sig(W,maproot,sig);
    let i:i32=0;
    while(i<n){
      e64(get32(sig,i*8)); emit("_"); e64(get32(sig,i*8+4));
      if(i<n-1){emit("-");}
      i=i+1;
    }
  } else {
    emit("none");
  }
  emit("\n");
  return;
}

// --- t2_sig calibration (must pass before scoring) ---
// Uses trial-triggering scenarios: NO direct fact for query (s,r),
// so the trial runs and promotes graphs.
fn calib_t2_sig()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Build 2-hop chain: teach edges, query the START with a relation
  // that has no direct fact. Use different (s,r) for the query.
  // 
  // Strategy: teach (100,901,101), (101,901,102). Query (100,902) - no direct fact.
  // But t2_gather looks for paths from s via ANY relation? Let me check.
  // Actually t2_gather(W,s,paths) gathers paths starting from s.
  // The trial tries chains using the gathered paths.
  //
  // Simpler: directly test t2_sig on manually constructed graphs.
  // Use t2_asm_chain to build graphs, then t2_sig to compare.
  
  // Build a 2-hop chain graph: values [10,11,12], 1 fact
  let v2:[]u8=z_alloc(24); let f2:[]u8=z_alloc(16);
  set32(v2,0,10); set32(v2,4,11); set32(v2,8,12);
  set32(f2,0,999);
  let g2:i32=t2_asm_chain(W,v2,3,f2);
  
  // Build a 3-hop chain graph: values [20,21,22,23], 1 fact
  let v3:[]u8=z_alloc(24); let f3:[]u8=z_alloc(16);
  set32(v3,0,20); set32(v3,4,21); set32(v3,8,22); set32(v3,12,23);
  set32(f3,0,998);
  let g3:i32=t2_asm_chain(W,v3,4,f3);
  
  if(g2<0 || g3<0){
    emit("CALIB-FAIL: graph assembly failed\n");
    return 0;
  }
  
  let s1:[]u8=z_alloc(256); let s2:[]u8=z_alloc(256);
  let n1:i32=t2_sig(W,g2,s1); let n2:i32=t2_sig(W,g3,s2);
  
  emit("CALIB: 2-hop cells="); e64(n1); emit(" 3-hop cells="); e64(n2); emit("\n");
  
  // Property (i): 2-hop vs 3-hop DIFFERENT
  let diff:i32=0;
  if(n1!=n2){diff=1;}
  else {
    let i:i32=0;
    while(i<n1*2){
      if(get32(s1,i*4)!=get32(s2,i*4)){diff=1;}
      i=i+1;
    }
  }
  emit("CALIB(i) 2hop-vs-3hop different: "); e64(diff); emit("\n");
  if(diff==0){return 0;}
  
  // Property (ii): two 2-hop chains with different literals IDENTICAL
  // Build another 2-hop with different values: [30,31,32]
  let v2b:[]u8=z_alloc(24); let f2b:[]u8=z_alloc(16);
  set32(v2b,0,30); set32(v2b,4,31); set32(v2b,8,32);
  set32(f2b,0,997);
  let g2b:i32=t2_asm_chain(W,v2b,3,f2b);
  if(g2b<0){
    emit("CALIB-FAIL: g2b assembly failed\n");
    return 0;
  }
  let s3:[]u8=z_alloc(256);
  let n3:i32=t2_sig(W,g2b,s3);
  
  let same:i32=1;
  if(n1!=n3){same=0;}
  else {
    let i:i32=0;
    while(i<n1*2){
      if(get32(s1,i*4)!=get32(s3,i*4)){same=0;}
      i=i+1;
    }
  }
  emit("CALIB(ii) 2hop-diff-literals identical: "); e64(same); emit("\n");
  // NOTE: If the frozen t2_sig includes literals, this will FAIL.
  // The prereg requires literals EXCLUDED. If this fails, evaluation is void.
  if(same==0){
    emit("CALIB-FAIL: property (ii) violated - t2_sig includes literals\n");
    emit("Per prereg section 8: evaluation is VOID.\n");
    return 0;
  }
  
  emit("CALIB(iii) chain-vs-sum: structural sensitivity shown by (i)\n");
  emit("CALIB-PASS\n");
  return 1;
}

// --- H2A probe: withhold trap ---
// World: 50001->50002->50003 (2-hop, wrong); 50001->50011->50012->50013 (3-hop, true)
// Masked: flags=1, expected withheld. First executable (2-hop) returns 50003 (wrong).
fn probe_h2a(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Teach facts
  ev_observe(W,50001,50051,50002);
  ev_observe(W,50002,50051,50003);
  ev_observe(W,50001,50051,50011);
  ev_observe(W,50011,50051,50012);
  ev_observe(W,50012,50051,50013);
  
  // Masked query: flags=1, expected=0 (withheld, garbage)
  let ans:i32=ev_query(W,50001,50051,0,1);
  
  emit("H2A-MASKED run="); e64(run); emit(" ans="); e64(ans);
  emit(" true=50013 correct="); e64(b2i(ans==50013));
  emit("\n");
  
  let m:i32=find_map(W,50001,50051);
  if(m>=0){
    sig_log("H2A",50001,run,"promote",W,ng(W,m,20));
  } else {
    sig_log("H2A",50001,run,"refuse",W,-1);
  }
  return;
}

fn probe_h2a_control(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50001,50051,50002);
  ev_observe(W,50002,50051,50003);
  ev_observe(W,50001,50051,50011);
  ev_observe(W,50011,50051,50012);
  ev_observe(W,50012,50051,50013);
  
  // Unmasked control: flags=0, expected=50013 (true)
  let ans:i32=ev_query(W,50001,50051,50013,0);
  
  emit("H2A-CONTROL run="); e64(run); emit(" ans="); e64(ans);
  emit(" correct="); e64(b2i(ans==50013));
  emit("\n");
  return;
}

// --- H2B probe: lie trap ---
// B1: 50101->50102->50103 (true); 50101->50111->50112 (lie target)
//     QUERY with expected=50112 (lie), flags=0
// B2: 50121->50122->50123 (true); QUERY with expected=59999 (unconfirmable lie)
fn probe_h2b1(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50101,50151,50102);
  ev_observe(W,50102,50151,50103);
  ev_observe(W,50101,50151,50111);
  ev_observe(W,50111,50151,50112);
  
  // Lie: expected=50112 (wrong, but confirmable - a candidate executes to it)
  let ans:i32=ev_query(W,50101,50151,50112,0);
  
  emit("H2B-B1-LIE run="); e64(run); emit(" ans="); e64(ans);
  emit(" lie=50112 true=50103 promoted_lie="); e64(b2i(ans==50112));
  emit("\n");
  
  // Check: was the lie-matching candidate promoted?
  let m:i32=find_map(W,50101,50151);
  if(m>=0){
    let mans:i32=ng(W,m,28);
    emit("H2B-B1 promoted ans="); e64(mans); emit(" is_lie="); e64(b2i(mans==50112)); emit("\n");
    sig_log("H2B-B1",50101,run,"promote",W,ng(W,m,20));
  } else {
    sig_log("H2B-B1",50101,run,"refuse",W,-1);
  }
  return;
}

fn probe_h2b2(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50121,50151,50122);
  ev_observe(W,50122,50151,50123);
  
  // Unconfirmable lie: expected=59999 (no candidate executes to this)
  let ans:i32=ev_query(W,50121,50151,59999,0);
  
  emit("H2B-B2-LIE run="); e64(run); emit(" ans="); e64(ans);
  emit(" lie=59999 true=50123\n");
  
  let m:i32=find_map(W,50121,50151);
  if(m>=0){
    sig_log("H2B-B2",50121,run,"promote",W,ng(W,m,20));
  } else {
    sig_log("H2B-B2",50121,run,"refuse",W,-1);
  }
  // Check for key-failure trace in learner state (white-box)
  // The trial should record the failure as evidence about the key
  emit("H2B-B2 maps="); e64(count_maps(W,50121,50151)); emit("\n");
  return;
}

fn probe_h2b_control(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50101,50151,50102);
  ev_observe(W,50102,50151,50103);
  ev_observe(W,50101,50151,50111);
  ev_observe(W,50111,50151,50112);
  ev_observe(W,50121,50151,50122);
  ev_observe(W,50122,50151,50123);
  
  let a1:i32=ev_query(W,50101,50151,50103,0);
  let a2:i32=ev_query(W,50121,50151,50123,0);
  
  emit("H2B-CONTROL run="); e64(run); emit(" a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" c1="); e64(b2i(a1==50103)); emit(" c2="); e64(b2i(a2==50123));
  emit("\n");
  return;
}

// --- H2C probe: own-criterion trap (withhold + multiple valid chains) ---
// Multiple 3-hop chains reach 50213. Withheld expected.
// The learner must use its own criterion to select among them.
fn probe_h2c(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50201,50251,50202);
  ev_observe(W,50202,50251,50203);
  ev_observe(W,50201,50251,50211);
  ev_observe(W,50211,50251,50212);
  ev_observe(W,50212,50251,50213);
  ev_observe(W,50201,50251,50221);
  ev_observe(W,50221,50251,50222);
  ev_observe(W,50222,50251,50213);
  ev_observe(W,50201,50251,50231);
  ev_observe(W,50231,50251,50232);
  ev_observe(W,50232,50251,50213);
  
  // Masked query
  let ans:i32=ev_query(W,50201,50251,0,1);
  
  emit("H2C-MASKED run="); e64(run); emit(" ans="); e64(ans);
  emit(" true=50213 correct="); e64(b2i(ans==50213));
  emit("\n");
  
  let m:i32=find_map(W,50201,50251);
  if(m>=0){
    sig_log("H2C",50201,run,"promote",W,ng(W,m,20));
  } else {
    sig_log("H2C",50201,run,"refuse",W,-1);
  }
  return;
}

fn probe_h2c_control(run:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_observe(W,50201,50251,50202);
  ev_observe(W,50202,50251,50203);
  ev_observe(W,50201,50251,50211);
  ev_observe(W,50211,50251,50212);
  ev_observe(W,50212,50251,50213);
  ev_observe(W,50201,50251,50221);
  ev_observe(W,50221,50251,50222);
  ev_observe(W,50222,50251,50213);
  ev_observe(W,50201,50251,50231);
  ev_observe(W,50231,50251,50232);
  ev_observe(W,50232,50251,50213);
  
  let ans:i32=ev_query(W,50201,50251,50213,0);
  
  emit("H2C-CONTROL run="); e64(run); emit(" ans="); e64(ans);
  emit(" correct="); e64(b2i(ans==50213));
  emit("\n");
  return;
}

// --- main: run all probes, 3 runs each ---
fn h2_main()i32 {
  emit("=== H2 EVALUATION ===\n");
  emit("Freeze: c15a47d63. Binary: f4de7ff46. Seal: 86389b108.\n");
  
  // Step 1: t2_sig calibration (must pass before scoring)
  emit("--- CALIBRATION ---\n");
  let calib:i32=calib_t2_sig();
  if(calib==0){
    emit("CALIBRATION-FAILED: per prereg section 8, scoring is VOID.\n");
    emit("Behavioral probes will run as UNSCORED observations.\n");
    emit("RECOMMENDATION: repair t2_sig to exclude literals, re-freeze, re-run.\n");
  }
  
  let run:i32=1;
  while(run<=3){
    emit("--- RUN "); e64(run); emit(" ---\n");
    probe_h2a(run);
    probe_h2a_control(run);
    probe_h2b1(run);
    probe_h2b2(run);
    probe_h2b_control(run);
    probe_h2c(run);
    probe_h2c_control(run);
    run=run+1;
  }
  
  emit("=== H2 EVALUATION COMPLETE ===\n");
  if(calib==0){
    emit("VERDICT: H2-EVAL-VOID (t2_sig calibration failed)\n");
    return 1;
  }
  emit("VERDICT: H2-EVAL-COMPLETE\n");
  return 0;
}

fn main()i32 { return h2_main(); }

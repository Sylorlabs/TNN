// inspect_state.zag -- read-only white-box inventory of a TNN-2 learner state.
// Reads a 110656-byte state bin (frozen TNN-2 workspace layout) and prints
// a structural inventory: header, node census, MAP decode, fact census,
// uncertainty/policy state, edge census, event log census, debris.
// Pure Zag. No writes to the state. No sealed world input.
fn emit(s:[]u8)void { _zag_print(s); return; }
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn loff(l:i32)i32 { return 106560+l*32; }
fn lg(W:[]u8,l:i32,f:i32)i32 { return get32(W,loff(l)+f); }
fn seqnx(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==c){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn has_self_edge(W:[]u8,n:i32,t:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){return 1;}
    e=e+1;
  }
  return 0;
}
fn count_edges_from(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t){c=c+1;}
    e=e+1;
  }
  return c;
}
fn litval(W:[]u8,ln:i32)i32 {
  if(ln>=2 && ln<1024 && ng(W,ln,36)==1 && ng(W,ln,0)==902){return ng(W,ln,20);}
  return -888888;
}
fn srcrep(W:[]u8,src:i32)void {
  if(src>=1000){emit("slot"); e64(src-1000);}
  else {emit("lit"); e64(litval(W,src));}
  return;
}
// decode one graph cell on the SEQ chain
fn decode_cell(W:[]u8,c:i32)void {
  let tag:i32=ng(W,c,0);
  e64(c); emit(":");
  if(tag==101){
    emit("MOVE dst="); e64(ng(W,c,4)-1000); emit(" src=");
    srcrep(W,ng(W,c,8));
  } else {if(tag==102){
    emit("BEQ slot="); e64(ng(W,c,4)-1000); emit(" lit=");
    e64(litval(W,ng(W,c,8))); emit(" match->"); e64(ng(W,c,12));
    emit(" miss->"); e64(ng(W,c,16));
  } else {if(tag==103){
    emit("INC slot="); e64(ng(W,c,4)-1000);
  } else {if(tag==104){
    emit("DEC slot="); e64(ng(W,c,4)-1000);
  } else {
    emit("TAG"); e64(tag);
  }}}}
  return;
}
// walk SEQ chain from root, following guard match-targets (field12) too
fn walk_graph(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0; let guards:i32=0; let incs:i32=0;
  let moves:i32=0; let deads:i32=0;
  while(cur>=0 && steps<80){
    if(ng(W,cur,36)!=1){deads=deads+1;}
    let tag:i32=ng(W,cur,0);
    if(tag==102){guards=guards+1;}
    if(tag==103){incs=incs+1;}
    if(tag==101){moves=moves+1;}
    emit("  "); decode_cell(W,cur); emit("\n");
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seqnx(W,cur);}
    steps=steps+1;
  }
  emit("  STEPS="); e64(steps); emit(" guards="); e64(guards);
  emit(" incs="); e64(incs); emit(" moves="); e64(moves);
  emit(" dead="); e64(deads); emit("\n");
  return steps;
}
fn main()i32 {
  if(_zag_argc()!=2){errln("usage: inspect_state_bin <state.bin>"); return 2;}
  let path:[]u8=_zag_arg(1);
  if(_zag_file_exists(path)==0){errln("no such file"); return 2;}
  let W:[]u8=_zag_read_file(path);
  if(_zag_strlen(W)!=110656){errln("bad state size"); return 2;}
  emit("STATE ok bytes=110656\n");
  // ---- header ----
  emit("HEADER clock="); e64(hg(W,0));
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" log_count="); e64(hg(W,28));
  emit(" evict_cursor="); e64(hg(W,8));
  emit(" hist_head="); e64(hg(W,12));
  emit("\n");
  // ---- node census ----
  let tc0:i32=0; let tc1:i32=0; let tc2:i32=0; let tc3:i32=0; let tc4:i32=0;
  let tc20:i32=0; let tc21:i32=0; let tc30:i32=0; let tc902:i32=0; let tc903:i32=0;
  let tc101:i32=0; let tc102:i32=0; let tc103:i32=0; let tc104:i32=0;
  let tcoth:i32=0; let dead:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      let t:i32=ng(W,n,0);
      if(t==1){tc1=tc1+1;} else {if(t==2){tc2=tc2+1;} else {if(t==3){tc3=tc3+1;}
      else {if(t==4){tc4=tc4+1;} else {if(t==20){tc20=tc20+1;}
      else {if(t==21){tc21=tc21+1;} else {if(t==30){tc30=tc30+1;}
      else {if(t==101){tc101=tc101+1;} else {if(t==102){tc102=tc102+1;}
      else {if(t==103){tc103=tc103+1;} else {if(t==104){tc104=tc104+1;}
      else {if(t==902){tc902=tc902+1;} else {if(t==903){tc903=tc903+1;}
      else {if(t==0){tc0=tc0+1;} else {tcoth=tcoth+1;}}}}}}}}}}}}}}
    } else {dead=dead+1;}
    n=n+1;
  }
  emit("NODECENSUS FACT="); e64(tc1); emit(" GROUP="); e64(tc2);
  emit(" HIST="); e64(tc3); emit(" REGRET="); e64(tc4);
  emit(" MAP="); e64(tc20); emit(" COEFF="); e64(tc21);
  emit(" UNCERT="); e64(tc30); emit(" OP101="); e64(tc101);
  emit(" OP102="); e64(tc102); emit(" OP103="); e64(tc103);
  emit(" OP104="); e64(tc104); emit(" CELL902="); e64(tc902);
  emit(" K903="); e64(tc903); emit(" TAG0="); e64(tc0);
  emit(" OTHER="); e64(tcoth); emit(" DEAD="); e64(dead); emit("\n");
  // k value
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==903){
      emit("KVALUE node="); e64(n); emit(" k="); e64(ng(W,n,20)); emit("\n");
    }
    n=n+1;
  }
  // ---- MAP detail ----
  emit("MAPS_BEGIN count="); e64(tc20); emit("\n");
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      let s:i32=ng(W,n,8); let r:i32=ng(W,n,4); let ans:i32=ng(W,n,28);
      let root:i32=ng(W,n,20); let promo:i32=ng(W,n,24);
      emit("MAP node="); e64(n); emit(" s="); e64(s); emit(" r="); e64(r);
      emit(" ans="); e64(ans); emit(" root="); e64(root);
      emit(" promo_edgeidx="); e64(promo);
      emit(" selfCOR="); e64(has_self_edge(W,n,13));
      emit(" selfSUP="); e64(has_self_edge(W,n,2));
      emit(" selfUSE="); e64(has_self_edge(W,n,6));
      emit(" dep_facts="); e64(count_edges_from(W,n,1));
      emit("\n");
      // provenance facts
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==1){
          let fn_:i32=eg(W,e,8);
          if(fn_>=2 && fn_<1024 && ng(W,fn_,36)==1){
            emit("  DEP fact node="); e64(fn_);
            emit(" ("); e64(ng(W,fn_,20)); emit(",");
            e64(ng(W,fn_,24)); emit(","); e64(ng(W,fn_,28)); emit(")");
            emit(" superseded="); e64(has_self_edge(W,fn_,3)); emit("\n");
          } else {
            emit("  DEP fact node="); e64(fn_); emit(" DANGLING\n");
          }
        }
        e=e+1;
      }
      // graph walk
      if(root>0){ walk_graph(W,root); }
      else { emit("  NO_GRAPH_ROOT bootstrap_or_memo\n"); }
    }
    n=n+1;
  }
  emit("MAPS_END\n");
  // ---- FACT detail ----
  let fshadow:i32=0; let fguide:i32=0; let fsup:i32=0; let ftaught:i32=0;
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let fr:i32=ng(W,n,24);
      if(fr==-999){fguide=fguide+1;}
      else {
        if(has_self_edge(W,n,3)==1){fsup=fsup+1;}
        else {
          // check if a live MAP covers (s,r)
          let s:i32=ng(W,n,20); let m:i32=2; let cov:i32=0;
          while(m<1024){
            if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==fr){cov=1;}
            m=m+1;
          }
          if(cov==1){fshadow=fshadow+1;} else {ftaught=ftaught+1;}
        }
      }
    }
    n=n+1;
  }
  emit("FACTCENSUS shadow="); e64(fshadow); emit(" guides="); e64(fguide);
  emit(" superseded="); e64(fsup); emit(" taught_other="); e64(ftaught); emit("\n");
  // ---- UNCERT detail ----
  emit("UNCERT_BEGIN count="); e64(tc30); emit("\n");
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30){
      emit("U node="); e64(n); emit(" f4="); e64(ng(W,n,4));
      emit(" s="); e64(ng(W,n,20)); emit(" r="); e64(ng(W,n,24));
      emit(" f28="); e64(ng(W,n,28)); emit("\n");
    }
    n=n+1;
  }
  emit("UNCERT_END\n");
  // ---- policy root and guides ----
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==2 && ng(W,n,4)==-5){
      emit("POLICY_ROOT node="); e64(n);
      emit(" mem_links="); e64(count_edges_from(W,n,10)); emit("\n");
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==n && eg(W,e,4)==10){
          let g:i32=eg(W,e,8);
          emit("  GUIDE fact node="); e64(g);
          if(g>=2 && g<1024 && ng(W,g,36)==1){
            emit(" s="); e64(ng(W,g,4)); emit(" f20="); e64(ng(W,g,20));
            emit(" f24="); e64(ng(W,g,24));
          } else { emit(" DANGLING"); }
          emit("\n");
        }
        e=e+1;
      }
    }
    n=n+1;
  }
  // ---- 902 cell reference analysis ----
  let ref902:i32=0; let unref902:i32=0;
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==902){
      let m:i32=2; let ref:i32=0;
      while(m<1024){
        if(ng(W,m,36)==1){
          let t:i32=ng(W,m,0);
          if((t==101 || t==102) && (ng(W,m,8)==n)){ref=1;}
        }
        m=m+1;
      }
      if(ref==1){ref902=ref902+1;} else {unref902=unref902+1;}
    }
    n=n+1;
  }
  emit("CELL902 referenced_literals="); e64(ref902);
  emit(" unreferenced_frames_or_garbage="); e64(unref902); emit("\n");
  // ---- edge census ----
  let et1:i32=0; let et2:i32=0; let et3:i32=0; let et4:i32=0; let et5:i32=0;
  let et6:i32=0; let et7:i32=0; let et8:i32=0; let et9:i32=0; let et10:i32=0;
  let et11:i32=0; let et12:i32=0; let et13:i32=0; let eto:i32=0; let efree:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==-1){efree=efree+1;}
    else {
      let t:i32=eg(W,e,4);
      if(t==1){et1=et1+1;} else {if(t==2){et2=et2+1;} else {if(t==3){et3=et3+1;}
      else {if(t==4){et4=et4+1;} else {if(t==5){et5=et5+1;}
      else {if(t==6){et6=et6+1;} else {if(t==7){et7=et7+1;}
      else {if(t==8){et8=et8+1;} else {if(t==9){et9=et9+1;}
      else {if(t==10){et10=et10+1;} else {if(t==11){et11=et11+1;}
      else {if(t==12){et12=et12+1;} else {if(t==13){et13=et13+1;}
      else {eto=eto+1;}}}}}}}}}}}}}
    }
    e=e+1;
  }
  emit("EDGECENSUS DEP1="); e64(et1); emit(" SUP2="); e64(et2);
  emit(" CON3="); e64(et3); emit(" REF4="); e64(et4); emit(" INS5="); e64(et5);
  emit(" USE6="); e64(et6); emit(" CFM7="); e64(et7); emit(" SUR8="); e64(et8);
  emit(" PRO9="); e64(et9); emit(" MEM10="); e64(et10); emit(" REG11="); e64(et11);
  emit(" SEQ12="); e64(et12); emit(" COR13="); e64(et13); emit(" OTHER="); e64(eto);
  emit(" FREE="); e64(efree); emit("\n");
  // ---- event log census ----
  let lk1:i32=0; let lk2:i32=0; let lk3:i32=0; let lk4:i32=0; let lko:i32=0;
  let lc:i32=hg(W,28); let l:i32=0;
  while(l<lc && l<128){
    let k:i32=lg(W,l,4);
    if(k==1){lk1=lk1+1;} else {if(k==2){lk2=lk2+1;} else {if(k==3){lk3=lk3+1;}
    else {if(k==4){lk4=lk4+1;} else {lko=lko+1;}}}}
    l=l+1;
  }
  emit("LOGCENSUS teach1="); e64(lk1); emit(" query2="); e64(lk2);
  emit(" act3="); e64(lk3); emit(" observe4="); e64(lk4);
  emit(" other="); e64(lko); emit(" total_logged="); e64(lc); emit("\n");
  // first and last 5 log entries
  emit("LOG_HEAD\n");
  l=0;
  while(l<5 && l<lc && l<128){
    emit("  t="); e64(lg(W,l,0)); emit(" k="); e64(lg(W,l,4));
    emit(" r0="); e64(lg(W,l,8)); emit(" r1="); e64(lg(W,l,12));
    emit(" p0="); e64(lg(W,l,16)); emit(" p1="); e64(lg(W,l,20)); emit("\n");
    l=l+1;
  }
  emit("LOG_TAIL\n");
  l=lc-5; if(l<0){l=0;}
  while(l<lc && l<128){
    emit("  t="); e64(lg(W,l,0)); emit(" k="); e64(lg(W,l,4));
    emit(" r0="); e64(lg(W,l,8)); emit(" r1="); e64(lg(W,l,12));
    emit(" p0="); e64(lg(W,l,16)); emit(" p1="); e64(lg(W,l,20)); emit("\n");
    l=l+1;
  }
  emit("INSPECT_DONE\n");
  // ---- dangling edge check: from/to node dead or wrong ----
  let dang:i32=0; let dmemi:i32=0;
  e=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let fr:i32=eg(W,e,0); let to:i32=eg(W,e,8); let t:i32=eg(W,e,4);
      let fok:i32=0; let tok:i32=0;
      if(fr>=2 && fr<1024 && ng(W,fr,36)==1){fok=1;}
      if(to>=2 && to<1024 && ng(W,to,36)==1){tok=1;}
      if(fok==0 || tok==0){
        dang=dang+1;
        if(t==10){dmemi=dmemi+1;}
        if(dang<12){
          emit("DANGLING edge="); e64(e); emit(" type="); e64(t);
          emit(" from="); e64(fr); emit(" to="); e64(to); emit("\n");
        }
      }
    }
    e=e+1;
  }
  emit("DANGLING_TOTAL="); e64(dang); emit(" dangling_MEM10="); e64(dmemi); emit("\n");
  // ---- MEM edge sources ----
  emit("MEM_SOURCES\n");
  e=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==10){
      let fr:i32=eg(W,e,0); let to:i32=eg(W,e,8);
      emit("  MEM from="); e64(fr); emit(" tag="); e64(ng(W,fr,0));
      emit(" f4="); e64(ng(W,fr,4)); emit(" to="); e64(to);
      emit(" totag="); e64(ng(W,to,0)); emit("\n");
    }
    e=e+1;
  }
  emit("INSPECT_DONE2\n");
  return 0;
}

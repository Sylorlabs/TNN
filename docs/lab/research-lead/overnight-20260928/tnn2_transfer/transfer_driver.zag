// ============ TNN-2 TRANSFER PROBES (analysis only) ============
// Appended to frozen TNN-2 source with the test main removed.
// All TNN-2 functions above are byte-identical to commit f4de7ff46.
// Probes exercise the public interface across multi-stage sequences on
// shared learner workspaces, plus read-only white-box inspection.

fn px_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn px_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn px_bidof(W:[]u8,n:i32)i32 { return bid(W,n); }
fn px_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// P1: persistence. Build chain MAP for (1,40), do unrelated work, re-check.
fn px_p1()void {
  emit("== P1 persistence ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  px_rep("P1 build_ans",a);
  let m:i32=px_find_map(W,1,40);
  let root:i32=-1; if(m>=0){root=ng(W,m,20);}
  px_rep("P1 map",m); px_rep("P1 root",root);
  let sig0:[]u8=z_alloc(256); let c0:i32=0;
  if(root>=0){c0=t2_sig(W,root,sig0);}
  px_rep("P1 sigcells",c0);
  let i:i32=0;
  while(i<30){ ev_teach(W,2000+i,61,7000+i); i=i+1; }
  i=0; while(i<10){ let q:i32=ev_query(W,2000+i,61,-2,1); if(q!=7000+i){emit("P1 unrelated FAIL\n");} i=i+1; }
  let a2:i32=ev_query(W,1,40,-2,0);
  px_rep("P1 requery_ans",a2);
  let m2:i32=px_find_map(W,1,40);
  px_rep("P1 map_after",m2);
  let ex:i32=-999998;
  if(m2>=0){ ex=t2_exec(W,ng(W,m2,20),1); }
  px_rep("P1 reexec",ex);
  px_rep("P1 map_bid",px_bidof(W,m2));
  px_rep("P1 live_nodes",hg(W,20));
  return;
}

// P2: cross-subject. After MAP for subject 1 exists, teach an isomorphic
// chain for subject 7 and query it. Reuse or rebuild?
fn px_p2()void {
  emit("== P2 cross-subject ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  let m1:i32=px_find_map(W,1,40); let r1:i32=ng(W,m1,20);
  let nmaps0:i32=px_count_tag(W,20);
  px_rep("P2 first_ans",a); px_rep("P2 maps_before",nmaps0);
  // direct execution of subject-1 graph on subject 7: architecturally?
  let xd:i32=t2_exec(W,r1,7);
  px_rep("P2 oldroot_on_7",xd);
  ev_teach(W,7,11,8); ev_teach(W,8,11,9); ev_teach(W,9,11,10); ev_teach(W,10,11,11);
  let b:i32=ev_query(W,7,40,11,0);
  px_rep("P2 second_ans",b);
  let nmaps1:i32=px_count_tag(W,20);
  px_rep("P2 maps_after",nmaps1);
  let m2:i32=px_find_map(W,7,40);
  px_rep("P2 map2",m2);
  let same:i32=0;
  if(m2>=0 && m2!=m1){
    let s1:[]u8=z_alloc(256); let s2:[]u8=z_alloc(256);
    let c1:i32=t2_sig(W,r1,s1); let c2:i32=t2_sig(W,ng(W,m2,20),s2);
    px_rep("P2 sig1",c1); px_rep("P2 sig2",c2);
    if(c1==c2){ same=1; }
  }
  px_rep("P2 rebuilt_fresh_map",same);
  // does the first MAP still answer its own subject?
  let a2:i32=ev_query(W,1,40,-2,0);
  px_rep("P2 first_requery",a2);
  return;
}

// P3: revision reuse and a second, different repair on the same machinery.
fn px_p3()void {
  emit("== P3 revision reuse ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let a:i32=ev_query(W,101,40,201,0);
  px_rep("P3 build_ans",a);
  let m:i32=px_find_map(W,101,40); let root:i32=ng(W,m,20);
  let s0:[]u8=z_alloc(256); let c0:i32=t2_sig(W,root,s0);
  px_rep("P3 sigcells_before",c0);
  let ro:i32=ev_observe(W,102,12,999);
  px_rep("P3 observe_ret",ro);
  let m_after:i32=px_find_map(W,101,40);
  px_rep("P3 same_map_node",m_after-m);
  px_rep("P3 map_ans_field",ng(W,m_after,28));
  let ex:i32=t2_exec(W,ng(W,m_after,20),101);
  px_rep("P3 reexec_after_rev",ex);
  let q:i32=ev_query(W,101,40,-2,0);
  px_rep("P3 requery",q);
  // second, structurally different repair on fresh structure, same machinery
  ev_teach(W,301,11,302); ev_teach(W,302,12,303); ev_teach(W,303,13,304);
  let b:i32=ev_query(W,301,40,304,0);
  px_rep("P3 build2_ans",b);
  let m2:i32=px_find_map(W,301,40);
  let ro2:i32=ev_observe(W,303,13,777);
  px_rep("P3 observe2_ret",ro2);
  let q2:i32=ev_query(W,301,40,-2,0);
  px_rep("P3 requery2",q2);
  px_rep("P3 map2_ans_field",ng(W,m2,28));
  // first revision undisturbed by second
  let q1b:i32=ev_query(W,101,40,-2,0);
  px_rep("P3 first_still",q1b);
  return;
}

// P4: interference under memory pressure.
fn px_p4()void {
  emit("== P4 interference ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  let m:i32=px_find_map(W,1,40); let root:i32=ng(W,m,20);
  px_rep("P4 build_ans",a); px_rep("P4 map",m);
  let i:i32=0;
  while(i<1050){ ev_teach(W,5000+i,60,9000+i); i=i+1; }
  px_rep("P4 live_nodes",hg(W,20));
  let malive:i32=0;
  if(ng(W,m,36)==1 && ng(W,m,0)==20){malive=1;}
  px_rep("P4 map_alive",malive);
  px_rep("P4 facts_alive",px_count_tag(W,1));
  let cells:i32=px_count_tag(W,101)+px_count_tag(W,102)+px_count_tag(W,103)+px_count_tag(W,104);
  px_rep("P4 opcells_alive",cells);
  let ex:i32=-999998;
  if(malive==1){ ex=t2_exec(W,ng(W,m,20),1); }
  px_rep("P4 reexec",ex);
  let q:i32=ev_query(W,1,40,-2,0);
  px_rep("P4 requery",q);
  px_rep("P4 maps_total",px_count_tag(W,20));
  return;
}

// P5: inquiry guide persistence across tasks (light C0-D probe).
fn px_p5()void {
  emit("== P5 guide persistence ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  let q:i32=ev_query(W,9002,77,-2,0);
  px_rep("P5 miss",q);
  let u:i32=-1; let g:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      if(ng(W,n,0)==30 && ng(W,n,20)==9002 && ng(W,n,24)==77){u=n;}
      if(ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g=n;}
    }
    n=n+1;
  }
  px_rep("P5 uncert",u); px_rep("P5 guide",g);
  ctx_push(W,9002);
  let c1:i32=ev_act(W);
  px_rep("P5 act1",c1);
  // unrelated work, then act again in same context
  let i:i32=0;
  while(i<40){ ev_teach(W,3000+i,62,4000+i); i=i+1; }
  let g2:i32=-1; n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g2=n;}
    n=n+1;
  }
  px_rep("P5 guide_after",g2);
  ctx_push(W,9002);
  let c2:i32=ev_act(W);
  px_rep("P5 act2",c2);
  return;
}

fn px_main()i32 {
  px_p1(); px_p2(); px_p3(); px_p4(); px_p5();
  emit("TRANSFER_PROBES_DONE\n");
  return 0;
}
fn main()i32 { return px_main(); }

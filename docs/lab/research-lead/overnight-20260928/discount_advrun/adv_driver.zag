// ===== DISCOUNT ADVERSARY DRIVER (majority-wrong world) =====
// Appended to di_variant.zag (frozen base + D1+D2+W3+R1 discount pilot,
// original test main removed). Implements the adversarial world from
// DISCOUNT_ADVERSARY.md (b0cd36859): the epistemic inverse of the
// contradiction-break probe. The 42-loop is WRONG (self-generated),
// the 99 is RIGHT (genuine). W3 is source-blind and will punish the 99.
//
// Phase 1: establish wrong 42-loop (3 seeds + 4 queries).
// Phase 2: introduce 1 genuine 99, 6 queries (predict -2,-2,-2,42,42,42).
// M1: 10 fresh queries, count 42 vs -2 vs 99 (predict all 42).
// M2: 99-fact discount depth (predict 3).
// M4: count 42-facts (amplification) and 99-facts.
// M3: teach 5 more 99s, query until flip (max 100), record flip point.
// M5: W2 not implemented in pilot (documented, not measured).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Count live tag-1 FACTs with relation r and output v.
fn count_val(W:[]u8,r:i32,v:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,28)==v){
      c=c+1;
    }
    n=n+1;
  }
  return c;
}

fn adv_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: 3 seeds (value 42). In this world these are misleading
  // (miscalibrated sensors); the learner cannot know. True value is 99.
  let g1:i32=ev_teach(W,1001,50,42); rep("A","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("A","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("A","g3",g3);
  // Establish the (wrong) loop with 4 fresh-subject queries. Expect 42.
  let i:i32=0;
  while(i<4){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("A q"); e64(i); emit("="); e64(q); emit("\n");
    i=i+1;
  }
  emit("A n42_after_p1="); e64(count_val(W,50,42)); emit("\n");
  // Phase 2: introduce ONE genuine 99 (correct but minority).
  let cx:i32=ev_teach(W,3001,50,99); rep("A","true99_idx",cx);
  emit("A true99_disc="); e64(ng(W,cx,12)); emit("\n");
  // 6 fresh queries. Predict: b0=-2 (d 0->1), b1=-2 (1->2), b2=-2 (2->3),
  // b3=42 (99 excluded by R1), b4=42, b5=42. The truth is suppressed.
  i=0;
  while(i<6){
    let q2:i32=ev_query(W,2005+i,50,-2,0);
    emit("A b"); e64(i); emit("="); e64(q2);
    emit(" true99_disc="); e64(ng(W,cx,12)); emit("\n");
    i=i+1;
  }
  // M1: persistence of wrong inference. 10 fresh queries.
  let c42:i32=0; let cm2:i32=0; let c99:i32=0;
  i=0;
  while(i<10){
    let q3:i32=ev_query(W,2011+i,50,-2,0);
    if(q3==42){c42=c42+1;}
    if(q3==-2){cm2=cm2+1;}
    if(q3==99){c99=c99+1;}
    i=i+1;
  }
  emit("A M1_c42="); e64(c42); emit(" M1_cm2="); e64(cm2);
  emit(" M1_c99="); e64(c99); emit("\n");
  // M2: truth exclusion depth.
  emit("A M2_true99_disc="); e64(ng(W,cx,12)); emit("\n");
  // M4: amplification. Count 42s (wrong, self-generated majority) and 99s.
  let n42:i32=count_val(W,50,42);
  let n99:i32=count_val(W,50,99);
  emit("A M4_n42="); e64(n42); emit(" M4_n99="); e64(n99); emit("\n");
  // M3: rehabilitation cost. Teach 5 more genuine 99s (discount 0 each).
  i=0;
  while(i<5){
    let t:i32=ev_teach(W,4001+i,50,99);
    emit("A rehab99_"); e64(i); emit("_idx="); e64(t); emit("\n");
    i=i+1;
  }
  // Query until the loop flips to 99 (or 100 queries max).
  let flip_at:i32=-1; let qn:i32=0;
  i=0;
  while(i<100){
    let q4:i32=ev_query(W,5001+i,50,-2,0);
    if(q4==99 && flip_at==-1){
      flip_at=i;
      emit("A FLIP at query "); e64(i); emit("\n");
    }
    // Stop 5 queries after flip to confirm persistence.
    if(flip_at>=0 && i>=flip_at+5){ qn=i+1; i=100; }
    else { i=i+1; }
  }
  if(flip_at==-1){ qn=100; emit("A NO-FLIP within 100 queries\n"); }
  emit("A M3_flip_at="); e64(flip_at); emit(" M3_queries_run="); e64(qn); emit("\n");
  // Final state.
  emit("A final_n42="); e64(count_val(W,50,42)); emit("\n");
  emit("A final_n99="); e64(count_val(W,50,99)); emit("\n");
  emit("A final_true99_disc="); e64(ng(W,cx,12)); emit("\n");
  // M5: W2 (observe-path rehabilitation) is not in the D1+D2+W3+R1 pilot.
  // All 99s entered via ev_teach; no contradiction check runs on teach.
  // Documented as a design limitation, not measured.
  emit("A M5_W2_not_in_pilot\n");
  emit("DISCOUNT-ADVRUN-DONE\n");
  return 0;
}
fn main()i32 { return adv_main(); }

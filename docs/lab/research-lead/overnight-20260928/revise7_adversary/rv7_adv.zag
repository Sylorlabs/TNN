// revise7.zag: H-REVISE7 second-order revision (revisions are hypotheses).
//
// Parent: H-REVISE6 (SURVIVES 66/66; red team SURVIVES with confirmed
// residual X-RV5-1/X-RV6-1). The residual is a FUNDAMENTAL LIMIT: an
// adversarially correlated or mislabeled fail2 is observationally
// underdetermined; NO observation-only gate can detect it at append time.
// H-REVISE7 does NOT claim to detect it. It bounds the aftermath instead.
//
// Repairs / new protocol:
//   R1: slot size 60 -> 64 bytes; byte at so+60 holds revision STATUS:
//       0=ROLLED_BACK (tombstone), 1=PROVISIONAL, 2=ACTIVE. Every appended
//       revision enters as PROVISIONAL, because append-time evidence is the
//       minimum and can be wrong through no fault of the gate.
//   R2: diagnose_rollback_check: on a new labeled failure, if the
//       most-recent firing revision is PROVISIONAL/ACTIVE and the store
//       WITHOUT that revision predicts the trusted label, the revision
//       overrode a correct prediction: PROVISIONAL is ROLLED BACK (1
//       contradiction); ACTIVE is DEMOTED to PROVISIONAL (needs 2).
//       Rollback is non-destructive; vs3_apply skips status-0 slots, so
//       behavior is restored EXACTLY (bit-identical to pre-revision).
//   R3: diagnose_confirm_check: on a correctly predicted input where a
//       PROVISIONAL revision fired and P0 would have mispredicted, promote
//       to ACTIVE.
//   R4: vs3_revise REACTIVATES a tombstoned slot with identical (cpos,cval)
//       instead of appending a duplicate (vcount unchanged).
//   R5: diagnose_corroborate_v6 returns 0 cleanly on nn1<=0 (defense in
//       depth; red-team wart: direct call with nn<=0 could panic).
// Known limits (frozen): append-time detection of X-RV5-1 still impossible;
// forged labels (label crafted to equal P0 output) are indistinguishable
// from genuine P0-consistent labels, so adversarial rollback is dual-use;
// duplicate-append of an ACTIVE revision's (p,v) is not detected.
// VS3 capacity 4, AMBIGUOUS, VS3FULL, diagnose_propose, and the three
// corroboration conditions: unchanged from revise6.zag.
//
// Prereg: PREREG_REVISE7.md, frozen before this file (commit e78eec911).
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (verbatim from revise2.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE v3 (appendable condition list) ============
// VS3 layout:
//   0: vcount (i32)
//   4: nnodes0 (i32), 8: prog0[48]  (bytes 8..56)
//   56: slot1: cond_pos(4), cond_val(4), nnodes(4), prog[48] -> 56..116
//   116: slot2 -> 116..176 ; 176: slot3 -> 176..236 ; 236: slot4 -> 236..296
// Max 4 revisions. Dispatch: most-recent-first (newest revision wins).
fn vs3_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 4, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[8+i]=p0[i]; i=i+1; }
  return;
}
// Returns 1 on append, -1 if the store is full (explicit refusal).
// On full: emits VS3FULL warning (explicit policy, not silent drop).
// Policy: REFUSE-WITH-WARNING. At most 4 chained revisions. Earlier
// revisions are never evicted. Queries on refused conditions fall
// through to P0. (H-REVISE4 R2: explicit capacity policy.)
fn vs3_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)i32 {
  let vc:i32=get32(VS, 0);
  // H-REVISE7 R4: reactivate a tombstoned slot with identical (cpos,cval)
  // instead of appending a duplicate. No vcount change.
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*64;
    if((VS[so+60] as i32)==0 && get32(VS,so)==cpos && get32(VS,so+4)==cval){
      let i:i32=0;
      while(i<nn1*3){ VS[so+12+i]=p1[i]; i=i+1; }
      set32(VS, so+8, nn1);
      VS[so+60]=1 as u8;
      emit("EVIDENCE: REACTIVATE slot="); emit(i32s(s));
      emit(" ("); emit(i32s(cpos)); emit(","); emit(i32s(cval));
      emit(") PROVISIONAL\n");
      return 1;
    }
    s=s+1;
  }
  if(vc>=4){
    emit("VS3FULL: revision refused; store at capacity (4); earlier revisions intact; queries on refused condition fall through to P0\n");
    return -1;
  }
  let aso:i32=56+vc*64;
  set32(VS, aso, cpos);
  set32(VS, aso+4, cval);
  set32(VS, aso+8, nn1);
  let j:i32=0;
  while(j<nn1*3){ VS[aso+12+j]=p1[j]; j=j+1; }
  // H-REVISE7 R1: every revision enters as PROVISIONAL.
  VS[aso+60]=1 as u8;
  set32(VS, 0, vc+1);
  emit("EVIDENCE: REVISE slot="); emit(i32s(vc+1));
  emit(" ("); emit(i32s(cpos)); emit(","); emit(i32s(cval));
  emit(") PROVISIONAL\n");
  return 1;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs3_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs3_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*64;
    // H-REVISE7 R2: rolled-back (tombstoned) slots are skipped, giving
    // exact restoration of pre-revision behavior.
    if((VS[so+60] as i32)!=0){
      let cp:i32=get32(VS, so);
      let cv:i32=get32(VS, so+4);
      if(inp.len>cp && (inp[cp] as i32)==cv){
        return vs3_apply_one(VS, so+12, so+8, inp, out);
      }
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
fn vs3_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,4);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[8+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  let vc:i32=get32(VS,0);
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*64;
    emit("VSTORE slot"); emit(i32s(s));
    emit(" cond pos="); emit(i32s(get32(VS,so)));
    emit(" val="); emit(i32s(get32(VS,so+4)));
    let nn:i32=get32(VS,so+8);
    emit(" nnodes="); emit(i32s(nn)); emit(" prog=");
    let pp:[]u8=z_alloc(48);
    i=0;
    while(i<nn*3){ pp[i]=VS[so+12+i]; i=i+1; }
    prog_emit(pp, nn);
    // H-REVISE7 R1: status field.
    let st:i32=VS[so+60] as i32;
    if(st==0){ emit(" st=RB"); }
    if(st==1){ emit(" st=PROV"); }
    if(st==2){ emit(" st=ACT"); }
    emit("\n");
    s=s+1;
  }
  return;
}

// ============ H-REVISE7: SECOND-ORDER REVISION ============
// Revisions are hypotheses. Status byte at so+60: 0=ROLLED_BACK,
// 1=PROVISIONAL, 2=ACTIVE.
fn vs3_status(VS:[]u8, s:i32)i32 {
  let vc:i32=get32(VS, 0);
  if(s<1 || s>vc){ return -1; }
  return VS[56+(s-1)*64+60] as i32;
}
// 1-based slot that vs3_apply would use for inp; 0 if none fires.
fn vs3_firing_slot(VS:[]u8, inp:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*64;
    if((VS[so+60] as i32)!=0){
      let cp:i32=get32(VS, so);
      let cv:i32=get32(VS, so+4);
      if(inp.len>cp && (inp[cp] as i32)==cv){ return i; }
    }
    i=i-1;
  }
  return 0;
}
// vs3_apply with slot `skip` ignored (used for the rollback skip-test).
fn vs3_apply_skip(VS:[]u8, inp:[]u8, out:[]u8, skip:i32)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    if(i!=skip){
      let so:i32=56+(i-1)*64;
      if((VS[so+60] as i32)!=0){
        let cp:i32=get32(VS, so);
        let cv:i32=get32(VS, so+4);
        if(inp.len>cp && (inp[cp] as i32)==cv){
          return vs3_apply_one(VS, so+12, so+8, inp, out);
        }
      }
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
// R2: contradiction protocol. CALL ONLY after vs3_apply mispredicted
// true_out. Returns 1 if a PROVISIONAL revision was rolled back, 2 if an
// ACTIVE revision was demoted to PROVISIONAL, 0 otherwise.
fn diagnose_rollback_check(VS:[]u8, inp:[]u8, true_out:[]u8)i32 {
  let s:i32=vs3_firing_slot(VS, inp);
  if(s==0){ return 0; }
  let so:i32=56+(s-1)*64;
  let st:i32=VS[so+60] as i32;
  if(st!=1 && st!=2){ return 0; }
  let sk:[]u8=z_alloc(16);
  let ok:i32=vs3_apply_skip(VS, inp, sk, s);
  if(ok==1 && streq(sk[0..inp.len], true_out)==1){
    if(st==1){
      VS[so+60]=0 as u8;
      emit("ROLLBACK: slot "); emit(i32s(s));
      emit(" PROVISIONAL->ROLLED_BACK (revision overrode a correct prediction)\n");
      return 1;
    }
    VS[so+60]=1 as u8;
    emit("DEMOTE: slot "); emit(i32s(s));
    emit(" ACTIVE->PROVISIONAL (first contradiction; needs 2 to roll back)\n");
    return 2;
  }
  return 0;
}
// R3: confirmation protocol. CALL ONLY after vs3_apply predicted true_out
// correctly. Returns 1 if a PROVISIONAL revision was promoted to ACTIVE.
fn diagnose_confirm_check(VS:[]u8, inp:[]u8, true_out:[]u8)i32 {
  let s:i32=vs3_firing_slot(VS, inp);
  if(s==0){ return 0; }
  let so:i32=56+(s-1)*64;
  if((VS[so+60] as i32)!=1){ return 0; }
  let p0o:[]u8=z_alloc(16);
  let ok:i32=vs3_apply_one(VS, 8, 4, inp, p0o);
  if(ok==1 && streq(p0o[0..inp.len], true_out)!=1){
    VS[so+60]=2 as u8;
    emit("CONFIRM: slot "); emit(i32s(s));
    emit(" PROVISIONAL->ACTIVE (revision fired; P0 would have mispredicted)\n");
    return 1;
  }
  return 0;
}

// ============ TWO-PHASE DIAGNOSIS (H-REVISE6 R1+R2) ============
// Phase 1: propose. For each position p in fail: bounds-respecting
// discrimination test (passing inputs shorter than p are vacuous,
// skipped). Score each discriminating (p,v) with a SINGLE honest
// binary signal:
//   +1 output-relevance: v appears in fail_out (expected output).
// The H-REVISE4 "+1 program-consistency (p in seq)" term is DELETED:
// the H-REVISE4 red team proved it is the same signal whenever seq
// comes from pextract(fail, fail_out), because p appears in seq iff
// fail[p] appears in fail_out. The old score was one binary signal
// counted twice. Scores here are 0 or 1.
// Returns best_p*1000+best_v, or -2 AMBIGUOUS if multiple candidates
// tie at the top score, or -1 if none discriminates.
// No byte-value literals; all compared values come from the data.
fn diagnose_propose(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8, fail_out:[]u8)i32 {
  let best:i32=-1;
  let best_score:i32=-1;
  let best_count:i32=0;
  let p:i32=0;
  while(p<fail.len){
    let v:i32=fail[p] as i32;
    let discrim:i32=1;
    let i:i32=0;
    while(i<npass){
      let plen:i32=get32(pdesc, i*8+4);
      if(plen>p){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
      }
      i=i+1;
    }
    if(discrim==1){
      let score:i32=0;
      let k:i32=0;
      while(k<fail_out.len){
        if((fail_out[k] as i32)==v){ score=score+1; break; }
        k=k+1;
      }
      emit("DIAGNOSE candidate pos="); emit(i32s(p));
      emit(" val="); emit(i32s(v));
      emit(" score="); emit(i32s(score)); emit("\n");
      if(score>best_score){
        best_score=score;
        best=p*1000+v;
        best_count=1;
      } else {
        if(score==best_score){
          best_count=best_count+1;
        }
      }
    }
    p=p+1;
  }
  if(best_count>1){
    emit("AMBIGUOUS: "); emit(i32s(best_count)); emit(" candidates tie at score ");
    emit(i32s(best_score)); emit("; revision withheld (heuristic cannot distinguish)\n");
    return -2;
  }
  return best;
}
// Direct program evaluator for a discovered P1 program (not stored in VS).
// Mirrors peval_vs / vs3_apply_one logic but operates on p1 bytes directly.
// Used by diagnose_corroborate_v6 to verify the proposed revision.
fn peval_prog(p1:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=p1[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_prog(p1, p1[base+1] as i32, k, n);
    let b:i32=peval_prog(p1, p1[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn prog_apply_direct(p1:[]u8, nn1:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_prog(p1, nn1-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
// Phase 2 (H-REVISE6 R1+R2): corroborate_v6. Given proposed (p,v),
// a SECOND counterexample (fail2, fail_out2), and the P1 program
// discovered from fail1, returns 1 iff ALL hold:
//   (a) fail2[p]==v (the proposed condition fires on fail2),
//   (b) the FULL proposed revision ((p,v),P1) predicts fail2 correctly
//       (P1 applied to fail2 equals fail_out2),
//   (c) the current program VS mispredicts fail2
//       (vs3_apply output differs from fail_out2, or apply fails).
// Otherwise returns 0 and the caller must withhold (UNCORROBORATED).
// R2: condition (b) replaces the H-REVISE5 redundant discrimination
// re-check (X-RV5-2: it never fired independently in
// protocol-conformant calls). Each of (a), (b), (c) has an
// independent failure path; none is implied by the others.
// Rationale: a single counterexample provably underdetermines the
// condition, so a revision is appended only when a second failure is
// confirmed AND the proposed fix is verified to actually fix it.
// KNOWN LIMIT (X-RV5-1): an adversarially correlated or mislabeled
// second counterexample cannot be detected by any observation-only
// gate; the wrong hypothesis is perfectly consistent with all given
// observations. This gate raises the bar but does not eliminate that
// risk. See PREREG_REVISE6.md.
fn diagnose_corroborate_v6(VS:[]u8, fail2:[]u8, fail_out2:[]u8, p:i32, v:i32, p1:[]u8, nn1:i32)i32 {
  // H-REVISE7 R5: defense in depth. Direct calls with nn1<=0 withhold
  // cleanly instead of risking a panic inside prog_apply_direct.
  if(nn1<=0){
    emit("CORROBORATE WITHHOLD: nn1<=0 invalid program size (defense in depth)\n");
    return 0;
  }
  if(fail2.len<=p){
    emit("CORROBORATE FAIL: fail2 shorter than p\n");
    return 0;
  }
  if((fail2[p] as i32)!=v){
    emit("CORROBORATE FAIL: proposed condition does not fire on fail2\n");
    return 0;
  }
  let fix2:[]u8=z_alloc(16);
  let okf:i32=prog_apply_direct(p1, nn1, fail2, fix2);
  if(okf!=1 || streq(fix2[0..fail2.len], fail_out2)!=1){
    emit("CORROBORATE FAIL: proposed revision does not predict fail2 correctly\n");
    return 0;
  }
  let pred2:[]u8=z_alloc(16);
  let ok:i32=vs3_apply(VS, fail2, pred2);
  if(ok==1 && streq(pred2[0..fail2.len], fail_out2)==1){
    emit("CORROBORATE FAIL: current program already predicts fail2 (not a counterexample)\n");
    return 0;
  }
  emit("CORROBORATE PASS: condition fires, revision predicts fail2, current program mispredicts\n");
  return 1;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}


// ============ MAIN: phases A-L ============
// Named-check harness: each CHECK does ntest_total+1 and npass_total+1
// iff cond holds. Expected total: 98/98 (66 inherited + 32 Phase N).
// ============ ADVERSARY MAIN: H-REVISE7 red team ============
// Mechanism region above is revise7.zag lines 1-638 verbatim (cmp-verified).
// This main only attacks; it does not modify any mechanism function.
fn main()i32 {
  emit("=== H-REVISE7 RED TEAM (adversary) ===\n");
  let npass_total:i32=0;
  let ntest_total:i32=0;

  // Hand-built programs.
  // P0-A = [4,0,0]: single node type 4 (constant 2). For 3-char input,
  // out[k] = inp[2] for all k.
  let p0a:[]u8=z_alloc(3); p0a[0]=4; p0a[1]=0; p0a[2]=0;
  // P0-B = [0,0,0]: identity.
  let p0b:[]u8=z_alloc(3); p0b[0]=0; p0b[1]=0; p0b[2]=0;
  // WPROG = [2,0,0]: single node type 2 (constant 0). out[k] = inp[0].
  let wprog:[]u8=z_alloc(3); wprog[0]=2; wprog[1]=0; wprog[2]=0;

  let X:[]u8="zbq";
  let T:[]u8="qqq";
  let out:[]u8=z_alloc(16);

  // ============ X-RV7-3: multi-slot interference (DOWNGRADE CANDIDATE) ============
  emit("\n--- X-RV7-3: multi-slot interference ---\n");
  let VS:[]u8=z_alloc(512);
  vs3_init(VS, p0a, 1);
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, X, out)==1 && streq(out[0..3], T)==1){
    emit("CHECK X731 P0-A sanity (P0 predicts trusted label) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X731 P0-A sanity FAIL\n"); }
  let ar1:i32=vs3_revise(VS, 0, 122, wprog, 1);
  let ar2:i32=vs3_revise(VS, 1, 98, wprog, 1);
  ntest_total=ntest_total+1;
  if(ar1==1 && ar2==1 && get32(VS,0)==2 && vs3_status(VS,1)==1 && vs3_status(VS,2)==1){
    emit("CHECK X732 two provisional slots appended PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X732 two slots FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VS, X, out)==1 && streq(out[0..3], T)!=1){
    emit("CHECK X733 mispredict confirmed (both revisions wrong) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X733 mispredict FAIL\n"); }
  let rb:i32=diagnose_rollback_check(VS, X, T);
  ntest_total=ntest_total+1;
  if(rb==0 && vs3_status(VS,1)==1 && vs3_status(VS,2)==1){
    emit("CHECK X734 DOWNGRADE: genuine contradiction absorbed, no rollback PASS\n"); npass_total=npass_total+1;
  } else {
    emit("CHECK X734 FAIL rb="); emit(i32s(rb));
    emit(" st1="); emit(i32s(vs3_status(VS,1)));
    emit(" st2="); emit(i32s(vs3_status(VS,2))); emit("\n");
  }
  // Control: single firing revision.
  let VS2:[]u8=z_alloc(512);
  vs3_init(VS2, p0a, 1);
  let cr1:i32=vs3_revise(VS2, 1, 98, wprog, 1);
  let rb2:i32=diagnose_rollback_check(VS2, X, T);
  ntest_total=ntest_total+1;
  if(cr1==1 && rb2==1 && vs3_status(VS2,1)==0){
    emit("CHECK X735 control: single revision rolls back PASS\n"); npass_total=npass_total+1;
  } else {
    emit("CHECK X735 control FAIL rb2="); emit(i32s(rb2));
    emit(" st="); emit(i32s(vs3_status(VS2,1))); emit("\n");
  }

  // ============ X-RV7-1: forged-confirmation flooding (boundary) ============
  emit("\n--- X-RV7-1: forged confirmation ---\n");
  let VS3:[]u8=z_alloc(512);
  vs3_init(VS3, p0a, 1);
  let fr1:i32=vs3_revise(VS3, 0, 122, wprog, 1);
  let F:[]u8="zzz";
  ntest_total=ntest_total+1;
  if(fr1==1 && vs3_apply(VS3, X, out)==1 && streq(out[0..3], F)==1){
    emit("CHECK X711 forged label matches revision output PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X711 FAIL\n"); }
  let cf:i32=diagnose_confirm_check(VS3, X, F);
  ntest_total=ntest_total+1;
  if(cf==1 && vs3_status(VS3,1)==2){
    emit("CHECK X712 BOUNDARY: wrong revision promoted to ACTIVE PASS\n"); npass_total=npass_total+1;
  } else {
    emit("CHECK X712 FAIL cf="); emit(i32s(cf));
    emit(" st="); emit(i32s(vs3_status(VS3,1))); emit("\n");
  }

  // ============ X-RV7-2: rollback/re-admit oscillation (severity note) ============
  emit("\n--- X-RV7-2: oscillation ---\n");
  let VS4:[]u8=z_alloc(512);
  vs3_init(VS4, p0b, 1);
  let X2:[]u8="xqw";
  let F2:[]u8="xqw";
  let or1:i32=vs3_revise(VS4, 0, 120, wprog, 1);
  ntest_total=ntest_total+1;
  if(or1==1 && vs3_status(VS4,1)==1){
    emit("CHECK X721 initial revise PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X721 FAIL\n"); }
  let cyc:i32=0;
  let ook:i32=1;
  let orb:i32=0;
  let ora:i32=0;
  while(cyc<3){
    if(vs3_apply(VS4, X2, out)==1 && streq(out[0..3], F2)!=1){
    } else { ook=0; }
    orb=diagnose_rollback_check(VS4, X2, F2);
    if(orb==1 && vs3_status(VS4,1)==0){
    } else { ook=0; }
    ora=vs3_revise(VS4, 0, 120, wprog, 1);
    if(ora==1 && vs3_status(VS4,1)==1 && get32(VS4,0)==1){
    } else { ook=0; }
    cyc=cyc+1;
  }
  ntest_total=ntest_total+1;
  if(ook==1){
    emit("CHECK X722 3x rollback/re-admit oscillation, no convergence PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X722 oscillation FAIL\n"); }

  // ============ X-RV7-4: duplicate append of ACTIVE (boundary) ============
  emit("\n--- X-RV7-4: duplicate ACTIVE ---\n");
  let VS5:[]u8=z_alloc(512);
  vs3_init(VS5, p0a, 1);
  let dr1:i32=vs3_revise(VS5, 0, 122, wprog, 1);
  let F4:[]u8="zzz";
  let cf4:i32=0;
  ntest_total=ntest_total+1;
  if(dr1==1 && vs3_apply(VS5, X, out)==1 && streq(out[0..3], F4)==1){
    cf4=diagnose_confirm_check(VS5, X, F4);
    if(cf4==1 && vs3_status(VS5,1)==2){
      emit("CHECK X741 confirmed to ACTIVE PASS\n"); npass_total=npass_total+1;
    } else { emit("CHECK X741 confirm FAIL\n"); }
  } else { emit("CHECK X741 setup FAIL\n"); }
  let dr2:i32=vs3_revise(VS5, 0, 122, wprog, 1);
  ntest_total=ntest_total+1;
  if(dr2==1 && get32(VS5,0)==2
     && get32(VS5,56)==0 && get32(VS5,60)==122
     && get32(VS5,120)==0 && get32(VS5,124)==122
     && vs3_status(VS5,1)==2 && vs3_status(VS5,2)==1){
    emit("CHECK X742 BOUNDARY: duplicate ACTIVE appended PASS\n"); npass_total=npass_total+1;
  } else {
    emit("CHECK X742 FAIL dr2="); emit(i32s(dr2));
    emit(" vc="); emit(i32s(get32(VS5,0))); emit("\n");
  }

  // ============ X-RV7-5: tombstone capacity (boundary) ============
  emit("\n--- X-RV7-5: tombstone capacity ---\n");
  let VS6:[]u8=z_alloc(512);
  vs3_init(VS6, p0a, 1);
  let ok5:i32=1;
  let I1:[]u8="zbq";
  let I2:[]u8="ybq";
  let I3:[]u8="xbq";
  let I4:[]u8="wbq";
  if(vs3_revise(VS6, 0, 122, wprog, 1)!=1){ ok5=0; }
  if(diagnose_rollback_check(VS6, I1, T)!=1){ ok5=0; }
  if(vs3_revise(VS6, 0, 121, wprog, 1)!=1){ ok5=0; }
  if(diagnose_rollback_check(VS6, I2, T)!=1){ ok5=0; }
  if(vs3_revise(VS6, 0, 120, wprog, 1)!=1){ ok5=0; }
  if(diagnose_rollback_check(VS6, I3, T)!=1){ ok5=0; }
  if(vs3_revise(VS6, 0, 119, wprog, 1)!=1){ ok5=0; }
  if(diagnose_rollback_check(VS6, I4, T)!=1){ ok5=0; }
  ntest_total=ntest_total+1;
  if(ok5==1 && get32(VS6,0)==4
     && vs3_status(VS6,1)==0 && vs3_status(VS6,2)==0
     && vs3_status(VS6,3)==0 && vs3_status(VS6,4)==0){
    emit("CHECK X751 four tombstones PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK X751 tombstones FAIL\n"); }
  let r5:i32=vs3_revise(VS6, 0, 118, wprog, 1);
  ntest_total=ntest_total+1;
  if(r5==-1 && get32(VS6,0)==4){
    emit("CHECK X752 BOUNDARY: VS3FULL on tombstones PASS\n"); npass_total=npass_total+1;
  } else {
    emit("CHECK X752 FAIL r5="); emit(i32s(r5)); emit("\n");
  }

  emit("\n=== ADVERSARY SUMMARY ===\n");
  emit("PASS "); emit(i32s(npass_total)); emit(" / "); emit(i32s(ntest_total)); emit("\n");
  if(npass_total==ntest_total){
    emit("R7-ADV: ALL ATTACK CHECKS PASS\n");
  } else {
    emit("R7-ADV: SOME CHECKS FAILED\n");
  }
  return 0;
}

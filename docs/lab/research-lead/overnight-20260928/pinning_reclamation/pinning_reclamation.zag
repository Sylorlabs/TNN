// pinning_reclamation.zag -- PINNING-RECLAMATION lane.
// PIN-NORECLAIM (policy 3) vs PIN-LRU (policy 4) vs PIN-CONSENT (policy 5)
// on the EVICTION-POLICY substrate, churn adversary held fixed.
// Pool 32 slots. See PREREG.md for the frozen design, derivation notes,
// and kill bars.
//
// Header: 0 bumpA(unused), 4 conflicts, 8 evictions, 12 table_full_errors,
// 16 pool_size (=32), 20 policy, 24 bumpB(unused), 28 drop,
// 32 consent_mask (=16), 36 clock (monotonic last-touch stamp).
// Primary: 64, 128 slots x 16 bytes. Pool: 2112, 32 slots x 16 bytes.
// Touch side table: 2624, 32 slots x 4 bytes (last-touch per pool slot).
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
// last-touch side table (base 2624, 32 x 4 bytes)
fn tget(M:[]u8,s:i32)i32 { return ig(M,2624+s*4); }
fn stamp(M:[]u8,s:i32)void {
  let c:i32=ig(M,36)+1;
  put32(M,36,c);
  put32(M,2624+s*4,c);
  return;
}
// Policy relocation for the conflict victim at primary slot so.
// Caller has already counted the conflict. After this returns, the
// caller installs the new value in the primary slot.
fn relocate(M:[]u8,so:i32)void {
  let pol:i32=ig(M,20);
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  // All policies: scan for the first free slot first.
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,key); put32(M,oo+4,vv);
      put32(M,oo+8,vo); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  // Pool full: reclamation per policy.
  if(pol==4){
    // PIN-LRU: evict the used slot with minimum last-touch.
    let ms:i32=0;
    let mt:i32=tget(M,0);
    s=1;
    while(s<32){
      let tt:i32=tget(M,s);
      if(tt<mt){mt=tt;ms=s;}
      s=s+1;
    }
    let oo:i32=soff(2112,ms);
    put32(M,8,ig(M,8)+1);
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    stamp(M,ms);
    return;
  }
  if(pol==5){
    // PIN-CONSENT: evict the first used slot whose owner intersects
    // the consent mask; other slots stay pinned forever.
    let cm:i32=ig(M,32);
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let consent:i32=0;
      if((ig(M,oo+8)&cm)!=0){consent=1;}
      let ok:i32=0;
      if(used==1){ok=consent;}
      if(ok==1){
        put32(M,8,ig(M,8)+1);
        put32(M,oo,key); put32(M,oo+4,vv);
        put32(M,oo+8,vo); put32(M,oo+12,1);
        stamp(M,s);
        return;
      }
      s=s+1;
    }
    put32(M,28,ig(M,28)+1);
    return;
  }
  // PIN-NORECLAIM (policy 3): no reclamation; drop++ and fall back to
  // destroy-in-place (caller installs the new value).
  put32(M,28,ig(M,28)+1);
  return;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Counted identically in all
      // policies; only the relocation outcome is policy-dependent.
      put32(M,4,ig(M,4)+1);
      relocate(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){stamp(M,o);return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- structures ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary (held fixed across policies): w writes on B-owned
// fresh key 3999, alternating values. First write allocates; each later
// write conflicts with the previous and relocates a B-owned victim.
fn teach_churn(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3999,900001+j,16);
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic, not kill-barred).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// R layout per condition (32 bytes): 0 pre, 4 post, 8 ret, 12 conflicts,
// 16 evict, 20 bacc, 24 rawA, 28 drop
fn run_cond(M:[]u8,OB:[]u8,pol:i32,chw:i32,tag:[]u8,R:[]u8,ro:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  teach_churn(M,chw);
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(8192);
  put32(OB,0,0);
  let R:[]u8=z_alloc(512);
  e1s(OB,"LANE=PINNING-RECLAMATION\n");
  run_cond(M,OB,3,1,"COND=PINR-B0",R,0);
  run_cond(M,OB,3,21,"COND=PINR-A20",R,32);
  run_cond(M,OB,3,33,"COND=PINR-A32",R,64);
  run_cond(M,OB,4,1,"COND=PINLRU-B0",R,96);
  run_cond(M,OB,4,21,"COND=PINLRU-A20",R,128);
  run_cond(M,OB,4,33,"COND=PINLRU-A32",R,160);
  run_cond(M,OB,5,1,"COND=PINCON-B0",R,192);
  run_cond(M,OB,5,21,"COND=PINCON-A20",R,224);
  run_cond(M,OB,5,33,"COND=PINCON-A32",R,256);
  // K1 baseline: pre==35 and bacc==20 in all 9 conditions
  let k1:i32=1;
  let c:i32=0;
  while(c<9){
    if(ig(R,c*32)!=35){k1=0;}
    if(ig(R,c*32+20)!=20){k1=0;}
    c=c+1;
  }
  e1s(OB,"K1 BASELINE pre==35,bacc==20 x9 -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  // K2 noreclaim reproduction: ret=[100,100,100], cf=[20,40,52],
  // ev=[0,0,0], drop=[0,8,20]
  let k2:i32=0;
  if(ig(R,8)==100 && ig(R,40)==100 && ig(R,72)==100){k2=1;}
  if(ig(R,12)!=20 || ig(R,44)!=40 || ig(R,76)!=52){k2=0;}
  if(ig(R,16)!=0 || ig(R,48)!=0 || ig(R,80)!=0){k2=0;}
  if(ig(R,28)!=0 || ig(R,60)!=8 || ig(R,92)!=20){k2=0;}
  e1s(OB,"K2 NORECLAIM-REPRO ret=[");
  e1i(OB,ig(R,8) as i64); e1s(OB,","); e1i(OB,ig(R,40) as i64);
  e1s(OB,","); e1i(OB,ig(R,72) as i64);
  e1s(OB,"] cf=["); e1i(OB,ig(R,12) as i64); e1s(OB,",");
  e1i(OB,ig(R,44) as i64); e1s(OB,","); e1i(OB,ig(R,76) as i64);
  e1s(OB,"] ev=["); e1i(OB,ig(R,16) as i64); e1s(OB,",");
  e1i(OB,ig(R,48) as i64); e1s(OB,","); e1i(OB,ig(R,80) as i64);
  e1s(OB,"] drop=["); e1i(OB,ig(R,28) as i64); e1s(OB,",");
  e1i(OB,ig(R,60) as i64); e1s(OB,","); e1i(OB,ig(R,92) as i64);
  e1s(OB,"] need=[100]x3,[20,40,52],[0]x3,[0,8,20] -> ");
  e1s(OB,pf(k2)); e1s(OB,"\n");
  // K3 LRU capacity: drop=[0,0,0]
  let k3:i32=0;
  if(ig(R,124)==0 && ig(R,156)==0 && ig(R,188)==0){k3=1;}
  e1s(OB,"K3 LRU-CAPACITY drop=[");
  e1i(OB,ig(R,124) as i64); e1s(OB,","); e1i(OB,ig(R,156) as i64);
  e1s(OB,","); e1i(OB,ig(R,188) as i64);
  e1s(OB,"] need=[0,0,0] -> ");
  e1s(OB,pf(k3)); e1s(OB,"\n");
  // K4 LRU FIFO-equivalence: ret=[100,54,0], ev=[0,8,20]
  let k4:i32=0;
  if(ig(R,104)==100 && ig(R,136)==54 && ig(R,168)==0){k4=1;}
  if(ig(R,112)!=0 || ig(R,144)!=8 || ig(R,176)!=20){k4=0;}
  e1s(OB,"K4 LRU-FIFO-EQUIV ret=[");
  e1i(OB,ig(R,104) as i64); e1s(OB,","); e1i(OB,ig(R,136) as i64);
  e1s(OB,","); e1i(OB,ig(R,168) as i64);
  e1s(OB,"] ev=["); e1i(OB,ig(R,112) as i64); e1s(OB,",");
  e1i(OB,ig(R,144) as i64); e1s(OB,","); e1i(OB,ig(R,176) as i64);
  e1s(OB,"] need=[100,54,0],[0,8,20] -> ");
  e1s(OB,pf(k4)); e1s(OB,"\n");
  // K5 consent holds both: ret=[100,100,100], ev=[0,8,20], drop=[0,0,0]
  let k5:i32=0;
  if(ig(R,200)==100 && ig(R,232)==100 && ig(R,264)==100){k5=1;}
  if(ig(R,208)!=0 || ig(R,240)!=8 || ig(R,272)!=20){k5=0;}
  if(ig(R,220)!=0 || ig(R,252)!=0 || ig(R,284)!=0){k5=0;}
  e1s(OB,"K5 CONSENT-HOLDS ret=[");
  e1i(OB,ig(R,200) as i64); e1s(OB,","); e1i(OB,ig(R,232) as i64);
  e1s(OB,","); e1i(OB,ig(R,264) as i64);
  e1s(OB,"] ev=["); e1i(OB,ig(R,208) as i64); e1s(OB,",");
  e1i(OB,ig(R,240) as i64); e1s(OB,","); e1i(OB,ig(R,272) as i64);
  e1s(OB,"] drop=["); e1i(OB,ig(R,220) as i64); e1s(OB,",");
  e1i(OB,ig(R,252) as i64); e1s(OB,","); e1i(OB,ig(R,284) as i64);
  e1s(OB,"] need=[100]x3,[0,8,20],[0]x3 -> ");
  e1s(OB,pf(k5)); e1s(OB,"\n");
  // K6 adversary fixed: conflicts per dose identical across policies
  let k6:i32=0;
  if(ig(R,12)==20 && ig(R,108)==20 && ig(R,204)==20){k6=1;}
  if(ig(R,44)!=40 || ig(R,140)!=40 || ig(R,236)!=40){k6=0;}
  if(ig(R,76)!=52 || ig(R,172)!=52 || ig(R,268)!=52){k6=0;}
  e1s(OB,"K6 ADV-FIXED dose0 cf=[");
  e1i(OB,ig(R,12) as i64); e1s(OB,","); e1i(OB,ig(R,108) as i64);
  e1s(OB,","); e1i(OB,ig(R,204) as i64);
  e1s(OB,"] dose20=["); e1i(OB,ig(R,44) as i64); e1s(OB,",");
  e1i(OB,ig(R,140) as i64); e1s(OB,","); e1i(OB,ig(R,236) as i64);
  e1s(OB,"] dose32=["); e1i(OB,ig(R,76) as i64); e1s(OB,",");
  e1i(OB,ig(R,172) as i64); e1s(OB,","); e1i(OB,ig(R,268) as i64);
  e1s(OB,"] need=[20]x3,[40]x3,[52]x3 -> ");
  e1s(OB,pf(k6)); e1s(OB,"\n");
  e1s(OB,"K7 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1){all=1;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

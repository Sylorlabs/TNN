// Mini-lifetime world driver.
// A-mini (subjects 1-3) -> B-mini (subjects 11-13) -> C-mini (contradictions).
// R_TEACH=1 (chain links), R_PROBE=50 (queries, no direct facts).
// Sealed world spec hash recorded in WORLDS.md.

fn teach_amini(W:[]u8)void {
  let s:i32=1;
  while(s<=3){
    // Main chain: (s,1,1000+s), (1000+s,1,2000+s)
    ev_teach(W,s,1,1000+s);
    ev_teach(W,1000+s,1,2000+s);
    // Redundant licensing path: (s,1,3000+s), (3000+s,1,2000+s)
    ev_teach(W,s,1,3000+s);
    ev_teach(W,3000+s,1,2000+s);
    s=s+1;
  }
  return;
}

fn probe_amini(W:[]u8)i32 {
  // 3 held-out chain queries (s,50), s in 1..3. TRIAL-EXPECTED.
  // Criterion: 3/3. Returns number correct.
  let ok:i32=0; let s:i32=1;
  while(s<=3){
    let ans:i32=ev_query(W,s,50,2000+s,0);
    if(ans==2000+s){ok=ok+1;}
    s=s+1;
  }
  return ok;
}

fn teach_bmini(W:[]u8)void {
  // Subjects 11,12,13. t=11 uses s_t=1, t=12 uses s_t=2, t=13 uses s_t=3.
  // Teach (t,1,1000+s_t): novel fact referencing A's entity.
  // Trial recruits A's (1000+s_t,1,2000+s_t) as second link.
  let t:i32=11;
  while(t<=13){
    let st:i32=t-10; // 11->1, 12->2, 13->3
    ev_teach(W,t,1,1000+st);
    t=t+1;
  }
  return;
}

fn probe_bmini(W:[]u8)i32 {
  // 3 B-chain queries (t,50), t in 11..13. TRIAL-EXPECTED.
  // Criterion: 3/3. Returns number correct.
  let ok:i32=0; let t:i32=11;
  while(t<=13){
    let st:i32=t-10;
    let ans:i32=ev_query(W,t,50,2000+st,0);
    if(ans==2000+st){ok=ok+1;}
    t=t+1;
  }
  return ok;
}

fn teach_cmini(W:[]u8)void {
  // Contradictions on 3 A licensing facts:
  // - (1001,1,2001): SHARED (in B-mini MAP provenance for t=11)
  // - (1002,1,2002): SHARED (in B-mini MAP provenance for t=12)
  // - (3001,1,2001): UNSHARED (redundant path, not in any B MAP)
  // New values: 2001->9001, 2002->9002, 2001->9003 (for 3001 chain)
  ev_observe(W,1001,1,9001);
  ev_observe(W,1002,1,9002);
  ev_observe(W,3001,1,9003);
  // V2-hole trap: contradict (1003,1,2003) with a value that requires
  // topology change, not literal patch. The trial cannot produce the
  // correct repair by literal patch alone.
  ev_observe(W,1003,1,9004);
  return;
}

fn probe_cmini(W:[]u8)i32 {
  // 3 revised-A queries (corrected answers, LOOKUP-EXPECTED):
  // (1,50) expects 9001, (2,50) expects 9002, (3,50) expects 9004 (trap)
  // 3 B queries (must be unchanged, LOOKUP-EXPECTED):
  // (11,50) expects 2001? NO: shared facts were revised, so B MAPs that
  // recruited (1001,1,2001) now have stale provenance. Per K-LT-4a, B probes
  // must stay correct (3/3) if revision is surgical. But our revision
  // patches the MAP, so B's MAP still points to old literal...
  // Honest expectation: B probes may break. Record what happens.
  let ok:i32=0;
  let a1:i32=ev_query(W,1,50,-2,0); if(a1==9001){ok=ok+1;}
  let a2:i32=ev_query(W,2,50,-2,0); if(a2==9002){ok=ok+1;}
  // V2 trap: check executed output vs true corrected answer
  let a3:i32=ev_query(W,3,50,-2,0);
  // B probes (must be unchanged per K-LT-4a)
  let b1:i32=ev_query(W,11,50,-2,0);
  let b2:i32=ev_query(W,12,50,-2,0);
  let b3:i32=ev_query(W,13,50,-2,0);
  emit("C-probes: A1="); e64(a1); emit(" A2="); e64(a2); emit(" A3="); e64(a3);
  emit(" B1="); e64(b1); emit(" B2="); e64(b2); emit(" B3="); e64(b3); emit("\n");
  return ok;
}

fn retention_sweep(W:[]u8)i32 {
  // Final sweep: all A-origin and B probes on unbroken state.
  let ok:i32=0;
  let s:i32=1;
  while(s<=3){
    // A probes now expect revised values (9001, 9002, 9004)
    let exp:i32=0;
    if(s==1){exp=9001;} if(s==2){exp=9002;} if(s==3){exp=9004;}
    if(ev_query(W,s,50,-2,0)==exp){ok=ok+1;}
    s=s+1;
  }
  let t:i32=11;
  while(t<=13){
    let st:i32=t-10;
    // B probes: record, don't assert (K-LT-4a measures this)
    ev_query(W,t,50,-2,0);
    t=t+1;
  }
  return ok;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("=== A-mini teach ===\n");
  teach_amini(W);
  emit("=== A-mini probes ===\n");
  let pa:i32=probe_amini(W);
  emit("A-probes: "); e64(pa); emit("/3\n");
  emit("=== B-mini teach ===\n");
  teach_bmini(W);
  emit("=== B-mini probes ===\n");
  let pb:i32=probe_bmini(W);
  emit("B-probes: "); e64(pb); emit("/3\n");
  emit("=== C-mini contradictions ===\n");
  teach_cmini(W);
  emit("=== C-mini probes ===\n");
  let pc:i32=probe_cmini(W);
  emit("C-revised-A: "); e64(pc); emit("/2 (trap excluded)\n");
  emit("=== Retention sweep ===\n");
  let pr:i32=retention_sweep(W);
  emit("Retention A: "); e64(pr); emit("/3\n");
  emit("MINILIFETIME-DONE\n");
  return 0;
}

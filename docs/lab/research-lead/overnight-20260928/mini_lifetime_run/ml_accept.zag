// K-REUSE acceptance micro-world driver.
// Tests K-REUSE-1 (query-time MAP execution) and K-REUSE-2 (no shadow facts).
// Sealed micro-world: 2-hop chain, one promotion, one re-query.

fn count_facts_sr(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){c=c+1;}
    n=n+1;
  }
  return c;
}

fn count_maps_sr(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){c=c+1;}
    n=n+1;
  }
  return c;
}

fn t_reuse_accept()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Teach 2-hop chain with relation 1: (1,1,11), (11,1,12).
  // Query (1,50) expects 12. Relation 50 has no direct facts,
  // so activate misses and trial runs, promoting a MAP for (1,50).
  ev_teach(W,1,1,11);
  ev_teach(W,11,1,12);
  let ans1:i32=ev_query(W,1,50,12,0);
  emit("ans1="); e64(ans1); emit("\n");
  if(ans1!=12){emit("FAIL ans1\n"); return 0;}
  // K-REUSE-2: no shadow fact for (1,50) may exist.
  let nf:i32=count_facts_sr(W,1,50);
  emit("nf="); e64(nf); emit("\n");
  if(nf!=0){emit("FAIL nf\n"); return 0;}
  // A live MAP for (1,50) must exist.
  let nm:i32=count_maps_sr(W,1,50);
  emit("nm="); e64(nm); emit("\n");
  if(nm!=1){emit("FAIL nm\n"); return 0;}
  // K-REUSE-1: re-query must return 12. With no fact present, the answer
  // can only come from MAP execution via the map_lookup branch.
  let ans2:i32=ev_query(W,1,50,-2,0);
  emit("ans2="); e64(ans2); emit("\n");
  if(ans2!=12){emit("FAIL ans2\n"); return 0;}
  return 1;
}

fn main()i32 {
  let r:i32=t_reuse_accept();
  if(r==1){emit("K-REUSE-ACCEPT: PASS\n");}
  else {emit("K-REUSE-ACCEPT: FAIL\n");}
  return r;
}

// sus_main.zag -- COMPOSE-SUSPEND-1 main battery driver.
// One process; thunk table, memos, and composite store persist
// across Q1, Q1b, Q1rev, CHAIN3, FANIN, PARTIAL, Q2.
// Per-problem verdicts implement the frozen kill bars (PREREG 3).

fn snap(S:[]u8,P:[]u8) void {
  let m:i32=0;
  while(m<16){ set32(P,m*4,eg(S,m)); m=m+1; }
  set32(P,64,sg(S,4));
  set32(P,68,sg(S,8));
  set32(P,72,sg(S,28));
  return;
}
fn rep(S:[]u8,A:[]u8,B:[]u8,c:i32,name:[]u8,root:i32,ans:i32,base:i32,nm:i32,pass:i32,P:[]u8) i32 {
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"ROOT="); c=o_i64(B,c,root as i64); c=o_nl(B,c);
  c=o_app(B,c,"ASMSTEPS="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"SEARCHRUNS="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,12) as i64); c=o_nl(B,c);
  c=o_app(B,c,"VIOL="); c=o_i64(B,c,sg(S,16) as i64); c=o_nl(B,c);
  c=o_app(B,c,"EXECTOT="); c=o_i64(B,c,sg(S,28) as i64); c=o_nl(B,c);
  c=o_app(B,c,"EXEC=");
  let m:i32=base;
  while(m<base+nm){
    c=o_i64(B,c,eg(S,m) as i64); c=o_app(B,c," ");
    m=m+1;
  }
  c=o_nl(B,c);
  c=o_app(B,c,"DASM="); c=o_i64(B,c,(sg(S,4)-get32(P,64)) as i64); c=o_nl(B,c);
  c=o_app(B,c,"DSEARCH="); c=o_i64(B,c,(sg(S,8)-get32(P,68)) as i64); c=o_nl(B,c);
  c=o_app(B,c,"DEXEC="); c=o_i64(B,c,(sg(S,28)-get32(P,72)) as i64); c=o_nl(B,c);
  c=o_app(B,c,"DEXEC0="); c=o_i64(B,c,(eg(S,0)-get32(P,0)) as i64); c=o_nl(B,c);
  c=o_app(B,c,"DEXEC1="); c=o_i64(B,c,(eg(S,1)-get32(P,4)) as i64); c=o_nl(B,c);
  c=o_app(B,c,"VERDICT=");
  if(pass==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
  c=o_nl(B,c);
  return c;
}
fn main() i32 {
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(16384);
  let B:[]u8=z_alloc(65536);
  let P:[]u8=z_alloc(128);
  let c:i32=0;
  // ---- Q1 ----
  w_q1(A);
  snap(S,P);
  let r1:i32=solve(S,A,0,4,202,1,2,5);
  let v1:i32=-999;
  let yleg:i32=-1;
  if(r1>=0){ v1=demand(S,A,r1); yleg=tg(S,r1,1); }
  let p1:i32=0;
  if(v1==5){ p1=1; }
  if(sg(S,16)!=0){ p1=0; }
  if(eg(S,0)!=1){ p1=0; }
  if(r1>=0){
    if(path_exec(S,r1)!=4){ p1=0; }
  } else { p1=0; }
  c=rep(S,A,B,c,"Q1",r1,v1,0,4,p1,P);
  // ---- Q1b: rebind ----
  w_q1b_add(A);
  snap(S,P);
  sp(S,20,1);
  let skb:i32=sketch(S,A,0,4);
  let stored:i32=store_get(S,1,2,skb);
  let r1b:i32=-2;
  let v1b:i32=-999;
  if(stored>=0){
    r1b=rebind(S,A,stored,204,1);
    v1b=demand(S,A,r1b);
  }
  let p1b:i32=0;
  if(v1b==3){ p1b=1; }
  if(sg(S,8)-get32(P,68)!=0){ p1b=0; }
  if(sg(S,4)-get32(P,64)!=0){ p1b=0; }
  if(sg(S,28)-get32(P,72)!=4){ p1b=0; }
  c=rep(S,A,B,c,"Q1b",r1b,v1b,0,4,p1b,P);
  // ---- Q1rev: revise ----
  w_q1rev(A);
  snap(S,P);
  sp(S,20,1);
  inv_notify(S,20);
  let r1r:i32=revise(S,A,r1,0,5,2,5,1);
  let v1r:i32=-999;
  if(r1r>=0){ v1r=demand(S,A,r1r); }
  let p1r:i32=0;
  if(v1r==5){ p1r=1; }
  if(eg(S,0)-get32(P,0)!=0){ p1r=0; }
  if(eg(S,1)-get32(P,4)!=0){ p1r=0; }
  if(sg(S,8)-get32(P,68)!=0){ p1r=0; }
  if(inv_clean01(S)!=1){ p1r=0; }
  c=rep(S,A,B,c,"Q1rev",r1r,v1r,0,5,p1r,P);
  // ---- CHAIN3 ----
  w_chain3(A);
  snap(S,P);
  let r3:i32=solve(S,A,5,3,301,1,2,7);
  let v3:i32=-999;
  if(r3>=0){ v3=demand(S,A,r3); }
  let p3:i32=0;
  if(v3==7){ p3=1; }
  c=rep(S,A,B,c,"CHAIN3",r3,v3,5,3,p3,P);
  // ---- FANIN ----
  w_fanin(A);
  snap(S,P);
  let r4:i32=solve(S,A,8,3,401,1,2,9);
  let v4:i32=-999;
  if(r4>=0){ v4=demand(S,A,r4); }
  let p4:i32=0;
  if(v4==9){ p4=1; }
  c=rep(S,A,B,c,"FANIN",r4,v4,8,3,p4,P);
  // ---- PARTIAL ----
  snap(S,P);
  let r5:i32=solve(S,A,0,4,202,1,2,3);
  let v5:i32=-999;
  if(r5>=0){ v5=demand(S,A,r5); }
  let p5:i32=0;
  if(v5==3){ p5=1; }
  if(r5!=yleg){ p5=0; }
  if(eg(S,0)-get32(P,0)!=0){ p5=0; }
  c=rep(S,A,B,c,"PARTIAL",r5,v5,0,4,p5,P);
  // ---- Q2 ----
  w_q2(A);
  snap(S,P);
  let r6:i32=solve(S,A,11,4,202,1,2,5);
  let v6:i32=-999;
  if(r6>=0){ v6=demand(S,A,r6); }
  let p6:i32=0;
  if(v6==5){ p6=1; }
  if(sg(S,12)!=1){ p6=0; }
  c=rep(S,A,B,c,"Q2",r6,v6,11,4,p6,P);
  o_flush(B,c);
  return 0;
}

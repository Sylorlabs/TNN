// cert_driver.zag -- H-BASECERT-1 base certification driver (pure Zag).
// Appended to an unmodified base .zag file, then compiled with znc.
// The cert never modifies the base file on disk; it is only concatenated
// in a scratch dir for compilation.
//
// The TNN-2 trial base (tnn2.zag) does not define ev_query; every
// experiment patch supplies it. This driver supplies a minimal trial-path
// ev_query: direct fact hit via activate, otherwise the base's own
// trial-based miss policy mp_run. This is exactly the base-trial path
// workers exercise on a miss.
//
// Four checks:
//   CERT-A LEAK: run 20 fixed trial problems, measure live node/edge
//     growth per problem, assert bounded growth and exact answers.
//   CERT-B ARENA: fill the 1024-node arena past capacity; assert graceful
//     -1 returns and eviction, never a stall.
//   CERT-C DETERMINISM: enforced by the certify_base wrapper (3 runs,
//     byte-identical sha256). The binary prints no addresses or timings.
//   CERT-D CORRECT: fixed problem set with known answers through mp_run.


// ---- helpers ----
fn cert_live_e(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
fn cert_teach_chain(W:[]u8,s:i32,r:i32,L:i32,n:i32)void {
  let prev:i32=s; let i:i32=1;
  while(i<=n){ ev_teach(W,prev,r,L+i); prev=L+i; i=i+1; }
  return;
}

// ---- CERT-A: node/edge leak check ----
// 20 problems. Each teaches a plen-3 true chain (r=1) plus a plen-4 decoy
// (r=1), then runs the base trial expecting the true endpoint. Bars:
//   per-problem node growth <= 20, per-problem edge growth <= 20,
//   all 20 answers exact.
// The v1 meta-applicability failure mode was ~40 nodes/problem with no
// reclamation, exhausting 1024 nodes at problem 21. 20 problems keeps the
// peak (800 nodes) clear of the eviction boundary, so this check measures
// the leak rate itself rather than the eviction latency cliff (which is a
// separate documented limitation, exercised by CERT-B).
fn cert_check_leak()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let n0:i32=r_live_count(W); let e0:i32=cert_live_e(W);
  let wrong:i32=0; let p:i32=0;
  while(p<20){
    let s:i32=101+p; let L:i32=1000+p*100;
    cert_teach_chain(W,s,1,L,3);
    cert_teach_chain(W,s,1,L+10,4);
    let a:i32=mp_run(W,s,1,L+3,0);
    if(a!=L+3){ wrong=wrong+1; }
    p=p+1;
  }
  let n1:i32=r_live_count(W); let e1:i32=cert_live_e(W);
  let gn:i32=(n1-n0)/20; let ge:i32=(e1-e0)/20;
  emit("CERT-A LEAK n0="); e64(n0); emit(" n1="); e64(n1);
  emit(" e0="); e64(e0); emit(" e1="); e64(e1);
  emit(" perprob_n="); e64(gn); emit(" perprob_e="); e64(ge);
  emit(" wrong="); e64(wrong);
  if(gn<=20 && ge<=20 && wrong==0){
    emit(" PASS\n"); return 1;
  }
  emit(" FAIL\n"); return 0;
}

// ---- CERT-B: arena exhaustion probe ----
// Fill all 1022 raw slots, assert exactly 1022 then -1 forever (200 extra
// allocs, no stall). Fill all 4096 edge slots, assert -1 past capacity.
// Then alloc_node at capacity: must return a live node via eviction,
// never hang or return -1 while a victim exists.
// Known limitation (documented, not a failure of this check): each
// at-capacity alloc triggers a full-arena evict_node scan (~0.8s CPU),
// so repeated at-capacity allocs degrade catastrophically (a single trial
// doing ~40 post-capacity allocs burned 34s CPU). This check does exactly
// one at-capacity alloc_node to verify graceful behavior, not performance.
fn cert_check_arena()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ok:i32=1;
  let c:i32=0;
  while(alloc_raw(W)>=0){ c=c+1; }
  emit("CERT-B ARENA raw_filled="); e64(c);
  if(c!=1022){ ok=0; }
  let i:i32=0;
  while(i<200){
    if(alloc_raw(W)!=-1){ ok=0; }
    i=i+1;
  }
  emit(" post200_allneg="); e64(ok);
  let ef:i32=0;
  while(link_edge(W,2,1,3,0)>=0){ ef=ef+1; }
  emit(" edges_filled="); e64(ef);
  if(ef!=4096){ ok=0; }
  i=0;
  while(i<100){
    if(link_edge(W,2,1,3,0)!=-1){ ok=0; }
    i=i+1;
  }
  emit(" edgepost100_allneg="); e64(ok);
  let v:i32=alloc_node(W);
  emit(" evict_alloc="); e64(v);
  if(v<2){ ok=0; }
  emit(" live="); e64(r_live_count(W));
  if(ok==1){ emit(" PASS\n"); return 1; }
  emit(" FAIL\n"); return 0;
}

// ---- CERT-D: trial correctness on a fixed problem set ----
fn cert_check_correct()i32 {
  let ok:i32=1;
  // D1: plen-3 chain, exact endpoint through the trial.
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  cert_teach_chain(W,101,1,1000,3);
  let a1:i32=mp_run(W,101,1,1003,0);
  emit("CERT-D D1 chain3 got="); e64(a1); emit(" want=1003");
  if(a1==1003){ emit(" ok\n"); } else { emit(" WRONG\n"); ok=0; }
  // D2: genuine rejection shape from the base's own T2-REJECT test:
  // two candidates rejected before the 3-hop winner verifies.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,101,11,102); ev_teach(W2,101,12,107); ev_teach(W2,102,12,103);
  ev_teach(W2,102,19,108); ev_teach(W2,103,13,104); ev_teach(W2,103,19,109);
  let a2:i32=ev_query(W2,101,40,104,0);
  emit("CERT-D D2 reject3hop got="); e64(a2); emit(" want=104");
  if(a2==104){ emit(" ok\n"); } else { emit(" WRONG\n"); ok=0; }
  // D3: true miss returns -2, no false positive construction.
  let a3:i32=mp_run(W2,9001,77,-2,0);
  emit("CERT-D D3 miss got="); e64(a3); emit(" want=-2");
  if(a3==-2){ emit(" ok\n"); } else { emit(" WRONG\n"); ok=0; }
  // D4: plen-4 chain, exact longer endpoint.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  cert_teach_chain(W3,202,5,2000,4);
  let a4:i32=mp_run(W3,202,5,2004,0);
  emit("CERT-D D4 chain4 got="); e64(a4); emit(" want=2004");
  if(a4==2004){ emit(" ok\n"); } else { emit(" WRONG\n"); ok=0; }
  if(ok==1){ emit("CERT-D CORRECT PASS\n"); return 1; }
  emit("CERT-D CORRECT FAIL\n"); return 0;
}

fn main()void {
  emit("BASECERT-START\n");
  let pa:i32=cert_check_leak();
  let pb:i32=cert_check_arena();
  let pd:i32=cert_check_correct();
  emit("BASECERT-SUMMARY A="); e64(pa);
  emit(" B="); e64(pb); emit(" D="); e64(pd); emit("\n");
  if(pa==1 && pb==1 && pd==1){ emit("BASECERT-BINARY-ALLPASS\n"); }
  else { emit("BASECERT-BINARY-SOMEFAIL\n"); }
  return;
}

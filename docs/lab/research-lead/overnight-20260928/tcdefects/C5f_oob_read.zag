// C5f -- IS THERE ANY BOUNDS CHECK ON b[i] ?
// This decides the practical question left by the get32/set32 verdict: can a
// bounds-checked wrapper make the byte-offset trap impossible, or must the
// wrapper carry its own check because the compiler carries none?
// Oracle: not applicable -- the question is whether the compiler traps at all.
// A read 1000 bytes past the end of a 64-byte arena.
fn main()i32 {
  let p:*u8=_zag_malloc(64) as *u8;
  let b:[]u8=p[0..64];
  b[0]=7;
  _zag_print("b[0]="); _zag_println(_zag_i64_to_str(b[0] as i64));
  _zag_println("ABOUT_TO_READ_OOB");
  let x:i32=b[1000];
  _zag_print("b[1000]="); _zag_println(_zag_i64_to_str(x as i64));
  _zag_println("OOB_READ_SURVIVED_NO_TRAP");
  return 0;
}

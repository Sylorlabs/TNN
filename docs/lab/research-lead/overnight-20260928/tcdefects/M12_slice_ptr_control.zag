// M12 -- CONTROL for M11, using the sanctioned _zag_slice_ptr.
// Oracle: the literal 7 written by this program must read back as 7.
fn main()i32 {
  let p:*u8=_zag_malloc(64) as *u8;
  let b:[]u8=p[0..64];
  b[0]=7;
  let sp:*u8=_zag_slice_ptr(b);
  let viaPtr:[]u8=sp[0..64];
  _zag_print("direct b[0]          = "); _zag_println(_zag_i64_to_str(b[0] as i64));
  _zag_print("via _zag_slice_ptr  = "); _zag_println(_zag_i64_to_str(viaPtr[0] as i64));
  _zag_print("expected by oracle   = 7");
  _zag_println("M12 DONE");
  return 0;
}

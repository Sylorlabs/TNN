// C10 -- VERIFY THE GUARDED WRAPPERS RECOMMENDED IN BRIEF SECTION 3.2.
// The brief now tells every lane to prefer getc32/setc32 (cell-indexed,
// self-range-checked) over raw get32/set32 (byte-offset, unchecked). That
// recommendation is only citable if the wrappers themselves are correct, so
// they are tested here against memory-free oracles.
// Oracle: cell k is written with 3*k+1, derived arithmetically, never read back
// through the accessor under test to produce the expectation.
fn getc32(b:[]u8,cell:i32)i32 {
  if(cell<0){ return 0; }
  let off:i32=cell*4;
  if((off+4)>b.len){ return 0; }
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn setc32(b:[]u8,cell:i32,v:i32)void {
  if(cell<0){ return; }
  let off:i32=cell*4;
  if((off+4)>b.len){ return; }
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
// memory-free oracle: byte k of i32 v is (v/256^k) mod 256
fn ob(v:i32,k:i32)i32 {
  let d:i32=1; let i:i32=0;
  while(i<k){ d=d*256; i=i+1; }
  let q:i32=v/d;
  return q-(q/256)*256;
}
fn main()i32 {
  // 64-byte arena holds exactly 16 cells.
  let A:[]u8=z_alloc(64);

  _zag_println("[1] round-trip 16 cells: setc32(A,k,3*k+1) then getc32(A,k)");
  let k:i32=0;
  while(k<16){ setc32(A,k,k*3+1); k=k+1; }
  let bad:i32=0;
  k=0;
  while(k<16){
    if(getc32(A,k)!=k*3+1){ bad=bad+1; }
    k=k+1;
  }
  ck("  16 cell round-trip mismatches",bad,0);
  ck("  cell 0",getc32(A,0),1);
  ck("  cell 15",getc32(A,15),46);

  _zag_println("[2] a CELL INDEX can no longer cause the byte-offset corruption");
  // The trap: with raw set32, writing at cell indices 0..5 smears the arena.
  // With setc32 the same call sequence writes 16 DISTINCT cells.
  let B:[]u8=z_alloc(64);
  let c:i32=0;
  while(c<6){ setc32(B,c,11*(c+1)); c=c+1; }
  let bad2:i32=0;
  c=0;
  while(c<6){
    if(getc32(B,c)!=11*(c+1)){ bad2=bad2+1; }
    c=c+1;
  }
  ck("  6 cells written by index are 6 distinct cells",bad2,0);
  ck("  cell 0",getc32(B,0),11);
  ck("  cell 5",getc32(B,5),66);

  _zag_println("[3] write bytes vs pure-arithmetic oracle");
  let C:[]u8=z_alloc(64);
  let V:i32=16909060;
  setc32(C,0,V);
  let wb:i32=0;
  let j:i32=0;
  while(j<4){ if(C[j]!=ob(V,j)){ wb=wb+1; } j=j+1; }
  ck("  4 write-byte mismatches",wb,0);

  _zag_println("[4] the range check actually fires (16 cells fit in 64 bytes)");
  ck("  getc32(A,16) is out of range -> 0",getc32(A,16),0);
  ck("  getc32(A,15) is the last legal cell -> 46",getc32(A,15),46);
  setc32(A,16,999);
  ck("  setc32(A,16,...) must not touch the arena",getc32(A,15),46);
  ck("  negative cell -> 0",getc32(A,0-1),0);
  setc32(A,0-1,999);
  ck("  setc32(A,-1,...) must not touch cell 0",getc32(A,0),1);

  _zag_println("[5] guards do not disturb the in-range fast path");
  let D:[]u8=z_alloc(1024);
  let m:i32=0; let s:i32=0;
  while(m<256){ setc32(D,m,m); m=m+1; }
  m=0;
  while(m<256){ s=s+getc32(D,m); m=m+1; }
  // sum of 0..255 = 255*256/2 = 32640
  ck("  sum of cells 0..255 in a 1024-byte arena",s,32640);

  _zag_println("C10 DONE");
  return 0;
}

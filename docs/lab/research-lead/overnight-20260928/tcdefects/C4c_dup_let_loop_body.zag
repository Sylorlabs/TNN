// CLAIM 4 variant, TERMINATES. Shadowing an unrelated name inside a while body
// is harmless. Shadowing the LOOP VARIABLE means a later `i=i+1` in the same
// body updates the INNER binding, so the outer loop condition never advances --
// a non-terminating loop. Demonstrated safely by advancing the outer variable
// BEFORE the shadowing declaration.
// Oracle part 1: 4 iterations x 100 = 400.
// Oracle part 2: outer g advances once per pass -> exactly 10 passes, m = 10.
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn main()i32 {
  let i:i32=0; let n:i32=0;
  while(i<4){
    let k:i32=100;
    n=n+k;
    i=i+1;
  }
  ck("  shadow unrelated name in loop body -> n=400",n,400);

  let g:i32=0; let m:i32=0;
  while(g<10){
    g=g+1;            // advance the OUTER binding first
    let g:i32=100;    // then shadow it
    m=m+1;
    g=g+1;            // this updates the INNER binding; outer stays put
  }
  ck("  shadowing the loop var: outer advanced once per pass -> m=10",m,10);
  _zag_print("g_after="); _zag_println(_zag_i64_to_str(g as i64));
  ck("  outer g stopped at 10",g,10);
  _zag_println("C4c REACHED_END");
  return 0;
}

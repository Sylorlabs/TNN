// W2 -- CONTROL for W1: same-name re-declaration with the SAME type.
// C4a/C4e already show this compiles and runs. Here the names are distinct
// types but the re-declaration is avoided entirely, which is the safe idiom.
fn main()i32 {
  let pi:i32=1;
  let pp:*u8=_zag_malloc(64) as *u8;
  let g:i32=7;
  _zag_print("g="); _zag_println(_zag_i64_to_str(g as i64));
  _zag_print("pi="); _zag_println(_zag_i64_to_str(pi as i64));
  if(pp==null as *u8){ _zag_println("pp NULL"); } else { _zag_println("pp NONNULL"); }
  _zag_println("W2 REACHED_END");
  return 0;
}

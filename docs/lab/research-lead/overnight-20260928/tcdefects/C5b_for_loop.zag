// b16verify sec5_c7: `for` claimed a REAL limitation (does not compile).
// Oracle: it must fail to compile. If it compiles we print the counter.
fn main()i32 {
  let i:i32=0;
  let n:i32=0;
  for(i=0;i<5;i=i+1){ n=n+1; }
  _zag_print("n="); _zag_println(_zag_i64_to_str(n as i64));
  _zag_println("FOR_COMPILED");
  return 0;
}

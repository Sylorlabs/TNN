// C5g_slice_as_ptr -- IS `b as *u8` THE SAME POINTER AS _zag_slice_ptr(b)?
// lane/b16verify reported only that `[]u8 as *u8` COMPILES. That is true but
// misleading: compiling is not the same as producing a usable pointer.
// Memory-free oracle: the bytes are literals written by this program (7 at
// index 0, 9 at index 1), so any correct read-back is a literal comparison.
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn main()i32 {
  let p:*u8=_zag_malloc(64) as *u8;
  let b:[]u8=p[0..64];
  b[0]=7;
  b[1]=9;
  let sp:*u8=_zag_slice_ptr(b);
  let cp:*u8=b as *u8;
  let eqv:i32=0;
  if(sp==cp){ eqv=1; }
  ck("  _zag_slice_ptr(b) is NOT equal to (b as *u8)",eqv,0);
  let snull:i32=0;
  if(sp==null as *u8){ snull=1; }
  let cnull:i32=0;
  if(cp==null as *u8){ cnull=1; }
  ck("  _zag_slice_ptr(b) is not null",snull,0);
  ck("  (b as *u8) is not null",cnull,0);

  // Usability: build a slice FROM the cast pointer and read the literals back.
  let viaCast:[]u8=cp[0..4];
  ck("  read b[0] through (b as *u8)[0..4]",viaCast[0],7);
  ck("  read b[1] through (b as *u8)[0..4]",viaCast[1],9);

  // And through the sanctioned pointer.
  let viaSlicePtr:[]u8=sp[0..4];
  ck("  read b[0] through _zag_slice_ptr(b)[0..4]",viaSlicePtr[0],7);
  ck("  read b[1] through _zag_slice_ptr(b)[0..4]",viaSlicePtr[1],9);
  _zag_println("C5g DONE");
  return 0;
}

// CLAIM 4 variant: shadowing in a nested block. Oracle: inner y=2 is
// what the inner print must show; after the block y must be 1 again.
fn main()i32 {
  let y:i32=1;
  _zag_print("outer_y_before="); _zag_println(_zag_i64_to_str(y as i64));
  if(y==1){
    let y:i32=2;
    _zag_print("inner_y="); _zag_println(_zag_i64_to_str(y as i64));
  }
  _zag_print("outer_y_after="); _zag_println(_zag_i64_to_str(y as i64));
  _zag_println("C4b REACHED_END");
  return 0;
}

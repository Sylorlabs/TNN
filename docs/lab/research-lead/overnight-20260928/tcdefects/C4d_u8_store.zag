// CLAIM 4 second half: "A[i]=v as u8 is unusable where set32 works".
// Memory-free oracle: byte k of A must equal (V / 256^k) mod 256, derived by
// pure arithmetic from the literal V. The u8 store is never consulted.
fn ob(v:i32,k:i32)i32 {
  let d:i32=1; let i:i32=0;
  while(i<k){ d=d*256; i=i+1; }
  let q:i32=v/d;
  return q-(q/256)*256;
}
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn main()i32 {
  let pa:*u8=_zag_malloc(64) as *u8;
  let pb:*u8=_zag_malloc(64) as *u8;
  let A:[]u8=pa[0..64];
  let B:[]u8=A;
  let D:[]u8=pb[0..64];
  // u8 direct store with a value that needs 2 bytes.
  B[0]=16909060 as u8;
  // set32 for the same value in the other arena.
  D[0]=16909060 as u8; D[1]=(16909060>>8) as u8;
  ck("  u8 store truncates: (16909060 as u8)",B[0],ob(16909060,0));
  ck("  set32 low byte agrees",D[0],ob(16909060,0));
  ck("  set32 high byte",D[1],ob(16909060,1));
  // indexed u8 store driven by a loop variable
  let i:i32=0; let bad:i32=0;
  let V:i32=305419896;   // 0x12345678
  while(i<4){ B[4+i]=ob(V,i) as u8; i=i+1; }
  i=0;
  while(i<4){ if(B[4+i]!=ob(V,i)){ bad=bad+1; } i=i+1; }
  ck("  indexed u8 store, 4 bytes vs arithmetic oracle",bad,0);
  // zero and 255 boundaries
  B[8]=0 as u8;   ck("  u8 store 0",B[8],0);
  B[9]=255 as u8; ck("  u8 store 255",B[9],255);
  B[10]=256 as u8; ck("  u8 store 256 truncates to 0",B[10],0);
  B[11]=(0-1) as u8; ck("  u8 store -1 -> 255",B[11],255);
  _zag_println("C4d REACHED_END");
  return 0;
}

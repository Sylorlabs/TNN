// C5a -- CONFIRMATION OF lane/b16verify NEGATIVE FINDINGS.
//
// Each b16verify "cargo cult" claim is re-tested here against a memory-free
// oracle using UNAMBIGUOUS operands (k<k+1 is true, k>k is false, and a
// comparison result is normalised with `(X==1)` before being negated).
// b16verify's own probes could not distinguish "correct" from "reads only the
// first operand", because in every one of its probes the FIRST operand already
// decided the answer, so a first-operand-only bug would have been invisible.
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn acc()i32 { return 7; }
fn main()i32 {
  _zag_println("[1] bare !A in an if");
  let a:i32=0; if(!((1<2)==1)){ a=1; } else { a=9; }
  ck("  !(true) is false -> else -> 9",a,9);
  let b:i32=0; if(!((1>1)==1)){ b=1; } else { b=9; }
  ck("  !(false) is true -> then -> 1",b,1);
  let c:i32=0; let flag:i32=0;
  if(1>1){ flag=1; }
  let d:i32=0; if(!((flag==1)==1)){ d=1; } else { d=9; }
  ck("  bare ! on a variable flag -> 1",d,1);

  _zag_println("[2] bare !A as a while condition");
  let i:i32=0; let n:i32=0; let stop:i32=0;
  while(!((stop==1)==1)){
    n=n+1; i=i+1;
    if(i==6){ stop=1; }
  }
  ck("  while(!done) runs 6 times",n,6);

  _zag_println("[3] De Morgan (!A || !B) as a while condition");
  // "run while NOT(A AND B)" with A=(p>=3) B=(q>=5). Both increment together,
  // so the loop exits on the pass where p reaches 3 -> p = 3.
  let p:i32=0; let q:i32=0;
  while(!((p>=3)==1) || !((q>=5)==1)){ p=p+1; q=q+1; }
  ck("  (!p>=3)||(!q>=5): exits when p>=3 AND q>=5 -> p=5",p,5);

  _zag_println("[4] !(A&&B) as an if condition");
  let e:i32=0; if(!(1<2 && 1<3)){ e=1; } else { e=9; }
  ck("  !(T&&T) -> else -> 9",e,9);
  let f:i32=0; if(!(1<2 && 1>1)){ f=1; } else { f=9; }
  ck("  !(T&&F) -> then -> 1",f,1);

  _zag_println("[5] !(A&&B) as a WHILE condition (brief 5 says restricted)");
  let s:i32=0; let t:i32=0;
  while(s<10 && !(s<4 && s>100)){ s=s+1; t=t+1; }
  ck("  s>100 always false so !(F) is true -> all 10",t,10);
  let u:i32=0;
  while(u<10 && !(u<4)){ u=u+1; }
  ck("  condition already false at u=0 -> 0 iterations",u,0);

  // Sections [6] and [7] (if-nesting depth 8, with else clauses and with an
  // accessor call in the innermost body) live in the standalone machine-
  // generated files NEST_2..NEST_10.zag and T6_acc_depth8.zag. They were split
  // out because hand-typed 8-deep brace chains were miscounted twice while
  // writing this file -- an authoring hazard, not a compiler one. Result:
  // depths 2,4,6,7,8,9,10 all compile and run; acc() at depth 8 returns 7.

  _zag_println("[8] break and continue at if-nesting depth 4");
  let w:i32=0; let z:i32=0;
  while(w<100){
    w=w+1;
    if(1<2){ if(1<2){ if(1<2){ if(w==5){ break; } } } }
    z=z+1;
  }
  ck("  break at depth 4 stops at w=5",w,5);
  let y:i32=0; let v:i32=0;
  while(y<6){
    y=y+1;
    if(y==3){ continue; }
    v=v+1;
  }
  ck("  continue skips one -> v=5",v,5);

  _zag_println("[9] []u8 as *u8 vs _zag_slice_ptr (brief 5 says forbidden)");
  // Names here are distinct from sections [1] and [3] purely for readability.
  // A separate probe, W1_retype_shadow.zag, tested whether re-declaring one
  // name with two different types breaks the symbol table; it COMPILES and
  // runs, so that is NOT a toolchain defect. Do not cite it as one.
  let sp:*u8=_zag_malloc(64) as *u8;
  let sb:[]u8=sp[0..64];
  let sq:*u8=sb as *u8;
  let sr:*u8=_zag_slice_ptr(sb);
  let same:i32=0;
  if(sq==sr){ same=1; }
  ck("  _zag_slice_ptr(b) != (b as *u8)  [cast yields a DIFFERENT pointer]",same,0);
  let isnull:i32=0;
  if(sq==null as *u8){ isnull=1; }
  ck("  (b as *u8) is not null",isnull,0);
  // Numerically different AND not interchangeable: see
  // C5g_slice_as_ptr.zag, M11_slice_as_ptr_read.zag, M13_slice_as_ptr_write.zag.
  // Reads through the cast pointer return wrong values, writes corrupt the
  // original arena, and one read was nondeterministic across runs.
  // Compiling is not the same as being usable.

  _zag_println("[10] i32 arithmetic: negative, division, modulo, shifts");
  let neg:i32=0-7;
  ck("  (0-7)/2",neg/2,0-3);
  ck("  (0-7) mod 2 via subtraction",neg-((neg/2)*2),0-1);
  ck("  100/7",100/7,14);
  ck("  100 mod 7",100-((100/7)*7),2);
  ck("  1<<10",1<<10,1024);
  ck("  (0-1)>>24",(0-1)>>24,0-1);
  ck("  ((0-1)>>24) as u8",(((0-1)>>24) as u8),255);

  _zag_println("[C5a] DONE");
  return 0;
}

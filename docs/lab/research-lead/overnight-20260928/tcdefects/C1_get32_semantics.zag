// C1_get32_semantics.zag -- ADJUDICATION OF CLAIM 1
// "get32/set32 take BYTE offsets, not cell indices."
//
// METHOD. The construct under test is get32/set32. So the ORACLE must not call
// them. Two independent oracles are used:
//   (O1) RAW BYTE READS b[k]. No get32 involved.
//   (O2) HAND-ASSEMBLED 4-byte window, written in a DIFFERENT expression form
//        (multiplicative, not shift/or) than get32's body:
//          hand(off) = b[off] + b[off+1]*256 + b[off+2]*65536 + b[off+3]*16777216
//        If get32(off) == hand(off) for EVERY off, then get32 is provably a
//        byte-window read at [off,off+3) and nothing else.
// (O3) LITERAL constants only (11,22,33,44,55,66) for the write side.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_println(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn hand(b:[]u8,off:i32)i32 {
  return b[off]+(b[off+1]*256)+(b[off+2]*65536)+(b[off+3]*16777216);
}
// MEMORY-FREE ORACLE for the write side: byte k of i32 v is (v/256^k) mod 256.
fn ob(v:i32,k:i32)i32 {
  let d:i32=1; let i:i32=0;
  while(i<k){ d=d*256; i=i+1; }
  let q:i32=v/d;
  return q-(q/256)*256;
}
fn main()i32 {
  let A:[]u8=z_alloc(64);
  set32(A,0,11); set32(A,4,22); set32(A,8,33);
  set32(A,12,44); set32(A,16,55); set32(A,20,66);

  // ---- PART 1: RAW BYTE ORACLE (no get32 at all).
  _zag_println("[P1] raw bytes b[0..24]:");
  let k:i32=0;
  while(k<24){ _zag_print(_zag_i64_to_str(A[k] as i64)); k=k+1; }
  _zag_println("  <- expect 11,0,0,0,22,0,0,0,33,0,0,0,44,0,0,0,55,0,0,0,66,0,0,0");

  // ---- PART 2: get32 at BYTE offsets == literals.
  _zag_println("[P2] get32(A,byteoff):");
  ck("  off=0 ",get32(A,0),11);
  ck("  off=4 ",get32(A,4),22);
  ck("  off=8 ",get32(A,8),33);
  ck("  off=12",get32(A,12),44);
  ck("  off=16",get32(A,16),55);
  ck("  off=20",get32(A,20),66);

  // ---- PART 3: THE CLAIM. get32 at CELL INDICES.
  // If get32 took cell indices these six calls would return 11,22,33,44,55,66.
  _zag_println("[P3] get32(A,cellindex) cell=0..5:");
  ck("  cell=0",get32(A,0),11);
  ck("  cell=1",get32(A,1),11);
  ck("  cell=2",get32(A,2),11);
  ck("  cell=3",get32(A,3),11);
  ck("  cell=4",get32(A,4),22);
  ck("  cell=5",get32(A,5),22);

  // ---- PART 4: EXHAUSTIVE PROOF get32(off) == hand(off) for every off in 0..24.
  // This is the memory-free oracle: hand() never calls get32.
  let off:i32=0; let mism:i32=0;
  while(off<25){
    let g:i32=get32(A,off); let h:i32=hand(A,off);
    if(g!=h){
      mism=mism+1;
      _zag_print("  MISMATCH off="); _zag_print(_zag_i64_to_str(off as i64));
      _zag_print(" get32="); _zag_print(_zag_i64_to_str(g as i64));
      _zag_print(" hand="); _zag_println(_zag_i64_to_str(h as i64));
    }
    off=off+1;
  }
  ck("[P4] mismatches over 25 byte offsets",mism,0);

  // ---- PART 5: DESTRUCTIVE pattern. set32 at CELL INDICES 0..5 on a fresh
  // arena; each call writes 4 bytes at off=j so writes overlap.
  let B:[]u8=z_alloc(64);
  set32(B,0,11); set32(B,1,22); set32(B,2,33);
  set32(B,3,44); set32(B,4,55); set32(B,5,66);
  _zag_println("[P5] set32(B,cellindex 0..5) raw bytes b[0..10]:");
  let q:i32=0;
  while(q<11){ _zag_print(_zag_i64_to_str(B[q] as i64)); q=q+1; }
  _zag_println("");
  // Hand oracle, byte by byte. v=11 -> bytes 11,0,0,0 written at j..j+3.
  ck("  B[0] (only j=0 touches)",B[0],11);
  ck("  B[1] (j=0 then j=1)",B[1],22);
  ck("  B[2] (j=0,1 then j=2)",B[2],33);
  ck("  B[3] (j=0..2 then j=3)",B[3],44);
  ck("  B[4] (j=0..3 then j=4)",B[4],55);
  ck("  B[5] (j=4 then j=5)",B[5],66);
  ck("  B[6] (j=4,j=5)",B[6],0);
  ck("  B[7] (j=5)",B[7],0);
  ck("  B[8] (j=5)",B[8],0);
  ck("  B[9] (untouched)",B[9],0);
  _zag_println("  six 'cells' are unrecoverable; windows:");
  _zag_print("   win(0)="); _zag_println(_zag_i64_to_str(get32(B,0) as i64));
  _zag_print("   win(4)="); _zag_println(_zag_i64_to_str(get32(B,4) as i64));
  _zag_print("   win(8)="); _zag_println(_zag_i64_to_str(get32(B,8) as i64));

  // ---- PART 6: UNALIGNED offsets. Not an error; they straddle cells.
  // Write-side oracle by PURE ARITHMETIC from the literals (no memory):
  //   byte k of an i32 v is (v / 256^k) mod 256.
  let C:[]u8=z_alloc(64);
  let V0:i32=16909060;    // cell A
  let V1:i32=286331412;   // cell B
  set32(C,0,V0); set32(C,4,V1);
  let badw:i32=0;
  let kk:i32=0;
  while(kk<8){
    let src:i32=V0; if(kk>=4){ src=V1; }
    let want:i32=ob(src,kk-((kk/4)*4));
    if(C[kk]!=want){
      badw=badw+1;
      _zag_print("  WRITE MISMATCH byte "); _zag_print(_zag_i64_to_str(kk as i64));
      _zag_print(" got="); _zag_print(_zag_i64_to_str(C[kk] as i64));
      _zag_print(" oracle="); _zag_println(_zag_i64_to_str(want as i64));
    }
    kk=kk+1;
  }
  ck("[P6a] set32 write bytes vs arithmetic oracle",badw,0);
  _zag_print("  raw bytes C[0..8] = ");
  let r:i32=0;
  while(r<8){ _zag_print(_zag_i64_to_str(C[r] as i64)); r=r+1; }
  _zag_println("");
  let u:i32=0; let um:i32=0;
  while(u<9){ if(get32(C,u)!=hand(C,u)){ um=um+1; } u=u+1; }
  ck("[P6b] unaligned get32 vs hand, 9 offsets",um,0);

  // ---- PART 7: does the compiler bounds-check? write the last legal cell
  // then a window that runs one byte past the end of a 32-byte arena.
  let D:[]u8=z_alloc(32);
  set32(D,28,123456);            // legal: bytes 28..31
  ck("  legal last cell",get32(D,28),123456);
  _zag_println("[P7] now out-of-range set32(D,30,...) (bytes 30..33 > len 32):");
  set32(D,30,999);
  _zag_println("  survived the OOB write (no trap)");
  _zag_print("[C1] DONE mism_p4="); _zag_println(_zag_i64_to_str(mism as i64));
  return 0;
}

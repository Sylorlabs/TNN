// CLAIM 4: three-way duplicate in one scope + duplicate of a function name.
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  return;
}
fn f()i32 { return 11; }
fn main()i32 {
  let z:i32=1;
  let z:i32=2;
  let z:i32=3;
  ck("  last binding wins? z",z,3);
  _zag_print("f()="); _zag_println(_zag_i64_to_str(f() as i64));
  _zag_println("C4e REACHED_END");
  return 0;
}

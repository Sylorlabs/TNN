// W1 -- MINIMAL: does re-declaring a name with a DIFFERENT type in the same
// scope poison the symbol table?
// Motivation: while writing C5a_lang_audit.zag, adding `let p:*u8` in a later
// section, where `p` was already bound to i32 in an earlier section, made znc
// abort with "arm64: unknown identifier: g" -- naming a variable that is
// perfectly legal and declared earlier. If that reproduces here it is a real
// (if minor) toolchain wart: the diagnostic misdirects you to an innocent
// symbol.
fn main()i32 {
  let p:i32=1;
  let p:*u8=_zag_malloc(64) as *u8;
  let g:i32=7;
  _zag_print("g="); _zag_println(_zag_i64_to_str(g as i64));
  // DO NOT compare `p as i64` across runs: that is a heap address and macOS
  // ASLR makes it differ every run, which would look like a determinism bug.
  // Only the null test below is meaningful.
  if(p==null as *u8){ _zag_println("p NULL"); } else { _zag_println("p NONNULL"); }
  _zag_println("W1 REACHED_END");
  return 0;
}

// C3_accessor_in_loop.zag -- ADJUDICATION OF CLAIM 3
// "An accessor call inside a loop is mis-compiled: if(n>=AREV) with AREV=500
//  failed to cap a counter that reached 784, where AREV is returned by a
//  constant-returning accessor function."
//
// METHOD. Every expected value here is a LITERAL fixed by the source text
// (the constants 500, 64, 4096 and the small hand-counted values). No expected
// value is produced by calling the function under test. The construct under
// test is the function-call-inside-a-loop; the oracle never calls it.
//
// Each sub-test prints its own counter so a failure localises immediately.
fn AREV()i32 { return 500; }
fn LIM(x:i32)i32 { return x; }

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ck(tag:[]u8,got:i32,want:i32)void {
  _zag_print(tag);
  if(got==want){ _zag_println(" PASS"); } else { _zag_println(" FAIL"); }
  _zag_print("  got="); _zag_print(_zag_i64_to_str(got as i64));
  _zag_print("  want="); _zag_println(_zag_i64_to_str(want as i64));
  return;
}
fn main()i32 {
  _zag_println("[1] THE REPORTED CASE: while(n<1000){ c++; if(n>=AREV()){break;} n++; }");
  let n:i32=0; let c:i32=0;
  while(n<1000){
    c=c+1;
    if(n>=AREV()){ break; }
    n=n+1;
  }
  // c is incremented BEFORE the cap test, and the test is n>=500 with n
  // starting at 0, so the break fires on the visit where n==500, which is the
  // 501st visit -> c = 501
  ck("  iterations before cap (n reaches 500)",c,501);

  _zag_println("[2] accessor in the WHILE CONDITION itself: while(c<AREV())");
  let c2:i32=0;
  while(c2<AREV()){ c2=c2+1; }
  ck("  counts to 500",c2,500);

  _zag_println("[3] accessor hoisted into a let INSIDE the loop");
  let n3:i32=0; let c3:i32=0;
  while(n3<600){
    let cap:i32=AREV();
    if(n3>=cap){ break; }
    c3=c3+1;
    n3=n3+1;
  }
  ck("  hoisted cap",c3,500);

  _zag_println("[4] accessor result used in ARITHMETIC inside the loop");
  let n4:i32=0; let s:i32=0;
  while(n4<500){ s=s+AREV(); n4=n4+1; }
  ck("  500 iterations x 500 = 250000",s,250000);

  _zag_println("[5] accessor called TWICE in one condition");
  let n5:i32=0; let c5:i32=0;
  while(n5<1000){
    c5=c5+1;
    if(n5>=AREV() && n5>=AREV()){ break; }
    n5=n5+1;
  }
  ck("  double call (same off-by-one as [1])",c5,501);

  _zag_println("[6] PARAMETERISED accessor inside a loop");
  let n6:i32=0; let c6:i32=0;
  while(n6<1000){
    c6=c6+1;
    if(n6>=LIM(100)){ break; }
    n6=n6+1;
  }
  ck("  LIM(100)==100, c counted before test -> 101",c6,101);

  _zag_println("[7] THE REAL WORKHORSE: get32/set32 (brief 3.2) called in a loop");
  let A:[]u8=z_alloc(4096);
  let i:i32=0;
  while(i<256){ set32(A,i*4,i*3); i=i+1; }
  // Memory-free oracle for the read side: cell k was written with 3*k.
  let bad:i32=0;
  let k:i32=0;
  while(k<256){
    if(get32(A,k*4)!=k*3){ bad=bad+1; }
    k=k+1;
  }
  ck("  256 set32 then 256 get32 mismatches",bad,0);
  // Second sweep, byte offsets stepped by 4 -- the form lanes actually use.
  let bad2:i32=0;
  let o:i32=0;
  while(o<1024){
    let cell:i32=o/4;
    if(get32(A,o)!=cell*3){ bad2=bad2+1; }
    o=o+4;
  }
  ck("  256 get32 by byte-offset sweep",bad2,0);

  _zag_println("[8] accessor returning a NON-constant (depends on arg) in a loop");
  // n8>=LIM(n8) is n8>=n8, ALWAYS TRUE -> breaks on the very first visit, and
  // c8 is incremented before the test -> c8 = 1.
  let n8:i32=0; let c8:i32=0;
  while(n8<200){
    c8=c8+1;
    if(n8>=LIM(n8)){ break; }
    n8=n8+1;
  }
  ck("  LIM(x)==x so the guard fires immediately -> 1",c8,1);

  _zag_println("[9] accessor result compared to a LOOP VARIABLE (the trap shape)");
  // if(n >= AREV()) where AREV()=500 -- but n counts 1..; off-by-one check.
  let n9:i32=1; let c9:i32=0;
  while(n9<2000){
    c9=c9+1;
    if(n9>AREV()){ break; }
    n9=n9+1;
  }
  ck("  n counts 1.. and stops past 500 -> 501 iters",c9,501);

  _zag_println("[10] accessor in a loop inside a loop (nesting)");
  let a:i32=0; let tot:i32=0;
  while(a<10){
    let b:i32=0;
    while(b<AREV()/100){ tot=tot+1; b=b+1; }
    a=a+1;
  }
  ck("  10 x 5 = 50",tot,50);

  _zag_println("[11] VOID accessor (set32) called in a loop - already in [7]");
  _zag_println("[C3] DONE");
  return 0;
}


// at_main.zag -- harness main for SPEC-ABSTENTION-TRAP.
// Sweeps 6 regime cells x 10 arms (fixed lazy, fixed eager,
// adaptive pol 2 with L in {0,1,3,7}, recheck pol 3 with
// L in {0,1,3,7}) = 60 episodes, each emitting one CELL line.
// Cell index ci -> (R, M1, N1, M2, N2):
//   ci=0 T0: R=10 (16,16)->(16,16)  sparse stationary control
//   ci=1 T1: R=12 (16,16)->(16,1)   sparse -> eager world (MAIN TRAP)
//   ci=2 T2: R=11 (16,16)->(1,16)   sparse -> lazy world (MIRROR)
//   ci=3 T3: R=1  (1,16)->(16,1)    parent-R1 seed-identical (IDENTITY)
//   ci=4 T4: R=14 (8,8)->(16,1)     medium-sparse -> eager (BOUNDARY)
//   ci=5 T5: R=13 (4,4)->(16,1)     dense -> eager (BOUNDARY)
// R values 10/12/11/14/13 selected by the pre-prereg seed probe
// (probe.zag: D32 >= 1 on each cell's tuple); R = 1 is fixed for the
// cross-lane identity check. R values are distinct because CELL
// lines are keyed by R.
// Arrivals are bursty and irregular (seeded per cell, identical
// across arms, regime shift at tick 128); relation/object ids arrive
// via the rb_* accessors; no world literals appear here.
fn at_R(ci:i32)i32 {
  if(ci==0){ return 10; }
  if(ci==1){ return 12; }
  if(ci==2){ return 11; }
  if(ci==3){ return 1; }
  if(ci==4){ return 14; }
  return 13;
}
fn at_m1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  if(ci==3){ return 1; }
  if(ci==4){ return 8; }
  return 4;
}
fn at_n1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  if(ci==3){ return 16; }
  if(ci==4){ return 8; }
  return 4;
}
fn at_m2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 1; }
  if(ci==3){ return 16; }
  if(ci==4){ return 16; }
  return 16;
}
fn at_n2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 1; }
  if(ci==2){ return 16; }
  if(ci==3){ return 1; }
  if(ci==4){ return 1; }
  return 1;
}
fn at_L(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 3; }
  return 7;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let ci:i32=0;
  while(ci<6){
    let R:i32=at_R(ci);
    let M1:i32=at_m1(ci);
    let N1:i32=at_n1(ci);
    let M2:i32=at_m2(ci);
    let N2:i32=at_n2(ci);
    c=at_episode(B,c,R,M1,N1,M2,N2,0,-1,ra,oa1);
    c=at_episode(B,c,R,M1,N1,M2,N2,1,-1,ra,oa1);
    let li:i32=0;
    while(li<4){
      c=at_episode(B,c,R,M1,N1,M2,N2,2,at_L(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=at_episode(B,c,R,M1,N1,M2,N2,3,at_L(li),ra,oa1);
      li=li+1;
    }
    ci=ci+1;
  }
  o_flush(B,c);
  return 0;
}

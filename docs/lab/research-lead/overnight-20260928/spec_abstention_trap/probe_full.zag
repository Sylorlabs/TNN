// c3_base.zag -- base for the cogops-3way battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the three researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE), vfy_gen (id 1, VERIFY),
// cnt_gen (id 4, COUNT).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// Distinct-object count: for each subject in sb[so..], scans ALL facts
// and collects distinct objects o with (subj, rel, o). Returns the
// distinct count. Cost = nsubs * nfacts fact checks (dedup compares
// not counted). seen: scratch [nseen, objs...], reset on entry.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let nf:i32=get32(A,0);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<64){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// probe.zag -- seed probe for SPEC-ABSTENTION-TRAP (design tooling).
// NOT the experiment. Replicates ONLY the pre-shift arrival process
// (seeded LCG + burst/quiet Markov + fire thresholds, ticks 0..127)
// for candidate (R,M1,N1,M2,N2) tuples and prints arrival counts.
// Purpose: select R values with D32 >= 1 (at least one drift in ticks
// 0..31). Rationale, derived from the inherited margin test
// (nr_decide): with (dh,ed) = (0,0) the price interval degenerates to
// {0}, and any L >= 1 is then eager-decisive (L*1 > 0) -- a
// zero-data eager commit at e = 32 that would pre-empt the abstention
// trap this lane is meant to map. D32 >= 1 guarantees (dh,ed) !=
// (0,0) at e = 32 and, since ed needs ~129 drift-free ticks to decay
// to zero, at every later pre-shift checkpoint too.
// This probe examines arrival counts ONLY: no EWMA, no margin test,
// no commits, no flips, no costs. Selection rule (frozen here):
// T0 (16,16->16,16): lowest R in 10..19 with D32 >= 1 on its tuple;
// T1 (16,16->16,1): next such R; T2 (16,16->1,16): next;
// T4 (8,8->16,1): lowest R in 10..19 with D32 >= 1 on its tuple;
// T5 (4,4->16,1): lowest R in 10..19 with D32 >= 1 on its tuple.
// T3 is fixed at R = 1 (seed-identical to parent R1, no probe).
// Pure Zag, safebin-built with the pinned znc.
fn nr_next(s:i64)i64 {
  let r:i64=s*1103515245+12345;
  let q:i64=r/2147483648;
  return r-q*2147483648;
}
fn nr_thr_b(M:i32)i64 {
  let C:i64=2147483648;
  let t:i64=(5*C)/(2*(M as i64));
  if(t>C){ return C; }
  return t;
}
fn nr_thr_q(M:i32,tb:i64)i64 {
  let C:i64=2147483648;
  let t:i64=((4*C)/(M as i64)-tb)/3;
  if(t<0){ return 0; }
  return t;
}
fn rc_seed_d(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*101+N1*17+M2*13+N2*7+17) as i64;
}
fn rc_seed_q(R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i64 {
  return (R*1000003+M1*17+N1*101+M2*7+N2*13+917) as i64;
}
fn probe_tuple(B:[]u8,c:i32,R:i32,M1:i32,N1:i32,M2:i32,N2:i32)i32 {
  let s1:i64=rc_seed_d(R,M1,N1,M2,N2);
  let s2:i64=rc_seed_q(R,M1,N1,M2,N2);
  let ds:i32=0;
  let qs:i32=0;
  let TPB:i64=nr_thr_b(M1);
  let TPQ:i64=nr_thr_q(M1,TPB);
  let TQB:i64=nr_thr_b(N1);
  let TQQ:i64=nr_thr_q(N1,TQB);
  let C31:i64=2147483648;
  let TSB:i64=C31/8;
  let TSQ:i64=C31/24;
  let d32:i32=0;
  let q32:i32=0;
  let dpre:i32=0;
  let qpre:i32=0;
  let t:i32=0;
  while(t<128){
    s1=nr_next(s1);
    let u1:i64=s1;
    let nds:i32=ds;
    if(ds==1 && u1<TSB){ nds=0; }
    if(ds==0 && u1<TSQ){ nds=1; }
    ds=nds;
    s1=nr_next(s1);
    let u2:i64=s1;
    let df:i32=0;
    if(ds==1 && u2<TPB){ df=1; }
    if(ds==0 && u2<TPQ){ df=1; }
    s2=nr_next(s2);
    let u3:i64=s2;
    let nqs:i32=qs;
    if(qs==1 && u3<TSB){ nqs=0; }
    if(qs==0 && u3<TSQ){ nqs=1; }
    qs=nqs;
    s2=nr_next(s2);
    let u4:i64=s2;
    let qf:i32=0;
    if(qs==1 && u4<TQB){ qf=1; }
    if(qs==0 && u4<TQQ){ qf=1; }
    dpre=dpre+df;
    qpre=qpre+qf;
    if(t<32){
      d32=d32+df;
      q32=q32+qf;
    }
    t=t+1;
  }
  c=o_app(B,c,"PROBE R=");
  c=o_i64(B,c,R as i64);
  c=o_app(B,c," M1=");
  c=o_i64(B,c,M1 as i64);
  c=o_app(B,c," N1=");
  c=o_i64(B,c,N1 as i64);
  c=o_app(B,c," M2=");
  c=o_i64(B,c,M2 as i64);
  c=o_app(B,c," N2=");
  c=o_i64(B,c,N2 as i64);
  c=o_app(B,c," D32=");
  c=o_i64(B,c,d32 as i64);
  c=o_app(B,c," Q32=");
  c=o_i64(B,c,q32 as i64);
  c=o_app(B,c," Dpre=");
  c=o_i64(B,c,dpre as i64);
  c=o_app(B,c," Qpre=");
  c=o_i64(B,c,qpre as i64);
  c=o_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let R:i32=10;
  while(R<20){
    c=probe_tuple(B,c,R,16,16,16,16);
    c=probe_tuple(B,c,R,16,16,16,1);
    c=probe_tuple(B,c,R,16,16,1,16);
    c=probe_tuple(B,c,R,8,8,16,1);
    c=probe_tuple(B,c,R,4,4,16,1);
    R=R+1;
  }
  o_flush(B,c);
  return 0;
}

// si_driver.zag -- scaling/indexing driver.
//
// Worlds: D non-chain decoy MAPs + 5 plen-5 chain MAPs; 3 plen-5 queries.
// mode 0 = linear scan (hard_patch.zag logic), mode 1 = plen-bucket index.
// Metrics per query: answer, tried/rejected verifies, scan visits,
// plen-walk calls. Verifies must match exactly across arms (identical trial
// order); scan work is where the index wins.
fn si_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
// Non-chain decoy: plen-2 chain with the set cell retagged to INC (103).
// rb_chain_plen returns -1, so the linear scan walks it every query and the
// index skips it at promotion. Simulates accumulated knowledge of other
// structural forms: genuinely irrelevant to a chain query.
fn si_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn world_scale(D:i32,mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  idx_mode_set(W,mode);
  let qi:i32=0;
  while(qi<3){
    let q:i32=6101+qi*100;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  emit(tag); emit(" B facts taught\n");
  let i:i32=0;
  while(i<D){
    let pm:i32=si_mkbroken(W,2000+i,51,2001+i);
    if(pm<0){ emit(tag); emit(" decoy FAIL i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit(tag); emit(" decoys promoted\n");
  i=0;
  while(i<5){
    let pm:i32=si_mkchain(W,5000+i*10,5,51,5004+i*10);
    if(pm<0){ emit(tag); emit(" rel5 FAIL i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit(tag); emit(" rel5 promoted build-walks="); e64(hg(W,60)); emit("\n");
  hs(W,60,0);
  qi=0;
  while(qi<3){
    let q:i32=6101+qi*100;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit(tag); emit(" Q"); e64(qi);
    emit(" ans="); e64(b);
    let t:i32=hg(W,16);
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" walks="); e64(hg(W,60));
    emit(" ok="); e64(b==q+104); emit("\n");
    qi=qi+1;
  }
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("SCALING-INDEX-START\n");
  world_scale(5,0,"LIN10");
  world_scale(5,1,"IDX10");
  world_scale(45,0,"LIN50");
  world_scale(45,1,"IDX50");
  world_scale(95,0,"LIN100");
  world_scale(95,1,"IDX100");
  emit("SCALING-INDEX-END\n");
  return 0;
}

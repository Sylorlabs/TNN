// fk_main.zag -- Binding constraints prototype.
// Question: can formal knowledge make errors IMPOSSIBLE rather than
// merely avoided? Three enforcement strengths on one adversarial
// insert workload (200 attempts, keys cycling through 1..7, distinct
// values), plus the revision protocol:
//   LIST: no formal knowledge (advisory baseline; duplicates possible)
//   REP:  UNIQUENESS as representation (keyed store; a second entry
//         with the same key is unrepresentable, the op has no encoding
//         that yields two entries with one key)
//   GATE: UNIQUENESS as admission (action-root gate refuses the op)
//   META: constraint removal without disconfirmation evidence is
//         refused; with a latched revision request it is allowed.
// Pure Zag. Deterministic: fixed attempt schedule, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ SECTION: generic machinery (alloc, cells, emit) ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ============ SECTION: stores ============
// LIST: base 100, n at 100, entries at 120+i*2 as (key,val), cap 256.
// REP:  base 600, n at 600, entries at 620+i*2 as (key,val), cap 64.
// GATE: base 800, n at 800, refusals at 801, entries at 820+i*2, cap 64.
// META: cell 10 = revision latch, cell 11 = disconfirmation run.
// Bitmap cells 20..27 for duplicate measurement.

fn list_insert(S:[]u8,k:i32,v:i32)void {
  let n:i32=sg(S,100);
  ss(S,120+n*2,k); ss(S,120+n*2+1,v); ss(S,100,n+1);
  return;
}
fn rep_insert(S:[]u8,k:i32,v:i32)i32 {
  let n:i32=sg(S,600);
  let i:i32=0;
  while(i<n){
    if(sg(S,620+i*2)==k){ ss(S,620+i*2+1,v); return 1; }
    i=i+1;
  }
  ss(S,620+n*2,k); ss(S,620+n*2+1,v); ss(S,600,n+1);
  return 0;
}
fn gate_insert(S:[]u8,k:i32,v:i32)i32 {
  let n:i32=sg(S,800);
  let i:i32=0;
  while(i<n){
    if(sg(S,820+i*2)==k){ ss(S,801,sg(S,801)+1); return 0; }
    i=i+1;
  }
  ss(S,820+n*2,k); ss(S,820+n*2+1,v); ss(S,800,n+1);
  return 1;
}
fn dupkeys(S:[]u8,base:i32,eb:i32)i32 {
  let n:i32=sg(S,base);
  let c:i32=0;
  while(c<8){ ss(S,20+c,0); c=c+1; }
  let d:i32=0;
  let i:i32=0;
  while(i<n){
    let k:i32=sg(S,eb+i*2);
    if(sg(S,20+k)==0){ ss(S,20+k,1); d=d+1; }
    i=i+1;
  }
  return n-d;
}

// ============ SECTION: revision protocol ============
// Removing or weakening a binding constraint requires a latched
// revision request, which requires 3 consecutive disconfirmations
// (the contract_unify invalidate rule). Without the latch the
// removal op is refused: the constraint binds even the learner's
// own attempt to drop it.

fn meta_remove(latch:i32)i32 {
  if(latch==1){ return 1; }
  return 0;
}
fn disconfirm(S:[]u8)void {
  let r:i32=sg(S,11)+1;
  ss(S,11,r);
  if(r>=3){ ss(S,10,1); }
  return;
}

// ============ SECTION: driver ============
// Adversary: 200 insert attempts. Key schedule k <- k+5 mod 7
// (coprime step: cycles through all 7 keys, so 193 of the 200
// attempts are adversarial duplicates). Values are distinct.

fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let S:[]u8=z_alloc(8192);
  let nattempts:i32=200;
  // Arm LIST: no formal knowledge.
  let k:i32=4;
  let i:i32=0;
  while(i<nattempts){
    k=k+5; if(k>7){ k=k-7; }
    list_insert(S,k,1000+i);
    i=i+1;
  }
  let ln:i32=sg(S,100);
  let ld:i32=dupkeys(S,100,120);
  // Arm REP: representational uniqueness.
  ss(S,600,0);
  let updates:i32=0;
  k=4; i=0;
  while(i<nattempts){
    k=k+5; if(k>7){ k=k-7; }
    updates=updates+rep_insert(S,k,1000+i);
    i=i+1;
  }
  let rn:i32=sg(S,600);
  let rd:i32=dupkeys(S,600,620);
  // Arm GATE: admissional uniqueness.
  ss(S,800,0); ss(S,801,0);
  k=4; i=0;
  while(i<nattempts){
    k=k+5; if(k>7){ k=k-7; }
    gate_insert(S,k,1000+i);
    i=i+1;
  }
  let gn:i32=sg(S,800);
  let gr:i32=sg(S,801);
  let gd:i32=dupkeys(S,800,820);
  // META: revision protocol.
  ss(S,10,0); ss(S,11,0);
  let r0:i32=meta_remove(sg(S,10));
  disconfirm(S); disconfirm(S); disconfirm(S);
  let latch:i32=sg(S,10);
  let r1:i32=meta_remove(latch);

  cur=e1str(OUT,cur,"FK-ATTEMPTS ");
  cur=e1i64(OUT,cur,nattempts as i64);
  cur=e1str(OUT,cur," keyspace=7\n");
  cur=e1str(OUT,cur,"FK-ARM LIST entries=");
  cur=e1i64(OUT,cur,ln as i64);
  cur=e1str(OUT,cur," dupkeys=");
  cur=e1i64(OUT,cur,ld as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FK-ARM REP entries=");
  cur=e1i64(OUT,cur,rn as i64);
  cur=e1str(OUT,cur," dupkeys=");
  cur=e1i64(OUT,cur,rd as i64);
  cur=e1str(OUT,cur," updates=");
  cur=e1i64(OUT,cur,updates as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FK-ARM GATE entries=");
  cur=e1i64(OUT,cur,gn as i64);
  cur=e1str(OUT,cur," dupkeys=");
  cur=e1i64(OUT,cur,gd as i64);
  cur=e1str(OUT,cur," refusals=");
  cur=e1i64(OUT,cur,gr as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FK-META latch=");
  cur=e1i64(OUT,cur,latch as i64);
  cur=e1str(OUT,cur," remove_noevidence=");
  cur=e1i64(OUT,cur,r0 as i64);
  cur=e1str(OUT,cur," remove_withevidence=");
  cur=e1i64(OUT,cur,r1 as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FK-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

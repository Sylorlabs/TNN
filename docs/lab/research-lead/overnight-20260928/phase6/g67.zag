// PHASE 6/7 -- TRANSFER and REVISION of generative state.
// Prereg: phase6/PREREG.md. Scorer: score67.py (independent).
//
// SUBSTRATE: sequences of LEN ops over an alphabet of OPS. Uniform random
// hit probability is OPS^-LEN, so a fresh sampler essentially never
// succeeds -- Condition 1 (S unreachable without state) holds BY
// CONSTRUCTION rather than by luck (Phase 4's failure).
//
// LEARNER STATE: ONE generic bigram-count buffer ST2 of size (OPS+1)*OPS,
// where row OPS is the START row. No modes, no routers, no domain names.
// Arms differ ONLY in what ST2 contains.
//
// REVISION (Phase 7) uses GENERIC CONSEQUENCES, no RESET function: an op
// pair that was emitted on a failed attempt is decremented; a pair that
// was correct is incremented.
//
// Output: one row per (regime, arm, budget). Raw costs only. No *_ok.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn OPS()i32 { return 10; }
fn LEN()i32 { return 6; }
fn SHORT()i32 { return 2; }        // regime 3: reachable by uniform sampling
fn SZ()i32 { return 11*10; }
fn MAXI()i32 { return SZ(); }        // (OPS+1)*OPS bigram slots
fn BUDGETS()i32 { return 3; }
fn BUD0()i32 { return 200; }
fn BUD1()i32 { return 1000; }
fn BUD2()i32 { return 4000; }
fn REPLAYS()i32 { return 40; }     // facts-only reconstruction budget
fn PRIOR()i32 { return 25; }        // prior episodes
fn NREG()i32 { return 4; }          // 0 main,1 related-transfer,2 unrelated,3 short(control)
fn NARM()i32 { return 6; }  // H_shuffled removed: unresolved segfault

// ---- targets. regime 0 = the learned prior. regime 1 = RELATED but the
// winning sequence never appears in any prior episode. regime 2 = unrelated.
// regime 3 = short (harness positive control).
fn tgt(rg:i32,p:i32)i32 {
  if(rg==0){ return (1+p)%OPS(); }              // 1,2,3,4,5,6
  if(rg==1){ return ((1+p)*2)%OPS(); }          // 2,4,6,8,0,2 (related)
  if(rg==2){ return (7-p+OPS())%OPS(); }        // 7,6,5,4,3,2 (unrelated)
  return (1+p)%OPS();                            // regime 3: short
}
fn tlen(rg:i32)i32 { if(rg==3){ return SHORT(); } return LEN(); }

// prior experience teaches regime PRIORRG's bigrams
fn priorRG()i32 { return 0; }

fn armBuild(a:i32)i32 {
  if(a==0){ return 1; }   // A experienced
  if(a==1){ return 0; }   // B fresh
  if(a==2){ return 2; }   // C facts_only
  if(a==3){ return 3; }   // F irrelevant (learned regime 2)
  if(a==4){ return 4; }   // G misleading
  return 0;               // I oracle
}

fn bi(a:i32,b:i32)i32 { return a*OPS()+b; }

fn main()i32 {
  let ob:[]u8=z_alloc(1<<21);
  let ST2:[]u8=z_alloc(SZ()*4);
  let RAW:[]u8=z_alloc(LEN()*4);     // the raw facts facts_only replays
  let seq:[]u8=z_alloc(LEN()*4);
  let tmp:[]u8=z_alloc(SZ()*4);
  let snap:[]u8=z_alloc(SZ()*4);
  let c:i32=0;

  c=o_app(ob,c,"PHASE67 RAW v1 ops=10 len=6 short=2 budgets=200,1000,4000 replays=40"); c=o_nl(ob,c);

  // record the raw facts once: regime 0's prior sequence
  let p:i32=0;
  while(p<LEN()){ set32(RAW,p*4,tgt(priorRG(),p)); p=p+1; }

  // ================= PHASE 7: REVISION UNDER A WORLD CHANGE =================
  // Learn regime 0's bigrams, then the world FLIPS to regime 1's target.
  // Require: old bias fails -> consequence exposes failure -> state changes
  // -> generation changes -> recovery. No RESET function exists.
  let ST:[]u8=z_alloc(SZ()*4);
  let e:i32=0;
  while(e<SZ()){ set32(ST,e*4,1); e=e+1; }
  e=0;
  while(e<PRIOR()){
    let q:i32=0;
    while(q<LEN()-1){
      set32(ST,bi(tgt(0,q),tgt(0,q+1))*4,get32(ST,bi(tgt(0,q),tgt(0,q+1))*4)+1);
      q=q+1;
    }
    set32(ST,bi(OPS(),tgt(0,0))*4,get32(ST,bi(OPS(),tgt(0,0))*4)+3);
    e=e+1;
  }
  let ep:i32=0;
  while(ep<40){
    // world state: regime 0 for the first 4 episodes, then FLIPS to regime 1
    let cur:i32=0;
    if(ep>=20){ cur=1; }
    let hit:i32=-1;
    let tr:i32=0;
    while(tr<400){
      let ok:i32=1;
      let q:i32=0;
      while(q<LEN()){
        let row:i32=OPS();
        if(q>0){ row=get32(seq,(q-1)*4); }
        let tot:i32=0; let o:i32=0;
        while(o<OPS()){ tot=tot+get32(ST,bi(row,o)*4); o=o+1; }
        if(tot<1){ tot=1; }
        let h:i32=(tr+1)*2654435761;
        h=h+(q+1)*40503+ep*911;
        h=h^(h>>13); h=h&0x7fffffff;
        h=h+(h>>7); h=h&0x7fffffff;
        let pk:i32=h%tot;
        let ac:i32=0; let ch:i32=0;
        while(ch<OPS()){
          ac=ac+get32(ST,bi(row,ch)*4);
          if(pk<ac){ break; }
          ch=ch+1;
        }
        if(ch>OPS()-1){ ch=OPS()-1; }
        if(ch!=tgt(cur,q)){ ok=0; }
        set32(seq,q*4,ch);
        q=q+1;
      }
      if(ok==1){ hit=tr+1; break; }
      tr=tr+1;
    }
    // ---- ONE consequence per episode, from the final proposal only ----
    let okE:i32=0;
    if(hit>0){ okE=1; }
    let q:i32=0;
    while(q<LEN()-1){
      let wrong:i32=0;
      if(get32(seq,q*4)!=tgt(cur,q)){ wrong=1; }
      if(wrong==1){
        let k:i32=bi(get32(seq,q*4),get32(seq,(q+1)*4));
        if(okE==1){ set32(ST,k*4,get32(ST,k*4)+2); }
        else { let w3:i32=get32(ST,k*4)-1; if(w3<1){ w3=1; } set32(ST,k*4,w3); }
        break;
      }
      q=q+1;
    }
    c=o_app(ob,c,"R ep="); c=o_i64(ob,c,ep as i64);
    c=o_app(ob,c," world="); c=o_i64(ob,c,cur as i64);
    c=o_app(ob,c," hit="); c=o_i64(ob,c,hit as i64);
    c=o_app(ob,c," tries="); c=o_i64(ob,c,tr as i64); c=o_nl(ob,c);
    ep=ep+1;
  }
  c=o_nl(ob,c);

  let rg:i32=0;
  while(rg<NREG()){
    let a:i32=0;
    while(a<NARM()){
      let bb:i32=armBuild(a);
      let L:i32=tlen(rg);

      // ---------- build state for this arm ----------
      let i:i32=0;
      while(i<SZ()){ set32(ST2,i*4,0); i=i+1; }
      if(bb==1){                       // experienced: prior episodes on regime 0
        let e:i32=0;
        while(e<PRIOR()){
          let q:i32=0;
          while(q<LEN()-1){
            set32(ST2,bi(tgt(0,q),tgt(0,q+1))*4,get32(ST2,bi(tgt(0,q),tgt(0,q+1))*4)+1);
            q=q+1;
          }
          set32(ST2,bi(OPS(),tgt(0,0))*4,get32(ST2,bi(OPS(),tgt(0,0))*4)+1);
          e=e+1;
        }
      }
      if(bb==3){                       // irrelevant: prior on regime 2
        let e:i32=0;
        while(e<PRIOR()){
          let q:i32=0;
          while(q<LEN()-1){
            set32(ST2,bi(tgt(2,q),tgt(2,q+1))*4,get32(ST2,bi(tgt(2,q),tgt(2,q+1))*4)+1);
            q=q+1;
          }
          set32(ST2,bi(OPS(),tgt(2,0))*4,get32(ST2,bi(OPS(),tgt(2,0))*4)+3);
          e=e+1;
        }
      }
      if(bb==4){                       // misleading: prior on regime 1, anti-weighted
        let e:i32=0;
        while(e<PRIOR()){
          let q:i32=0;
          while(q<LEN()-1){
            set32(ST2,bi(tgt(1,q),tgt(1,q+1))*4,get32(ST2,bi(tgt(1,q),tgt(1,q+1))*4)+2);
            q=q+1;
          }
          set32(ST2,bi(OPS(),tgt(1,0))*4,get32(ST2,bi(OPS(),tgt(1,0))*4)+6);
          e=e+1;
        }
        // subtract the true bigrams -> bias away
        let q:i32=0;
        while(q<LEN()-1){
          let k:i32=bi(tgt(rg,q),tgt(rg,q+1));
          let cur:i32=get32(ST2,k*4)-3; if(cur<0){ cur=0; }
          set32(ST2,k*4,cur);
          q=q+1;
        }
      }
      if(bb==50){                      // H_shuffled DISABLED: segfaults, unresolved
        i=0; while(i<SZ()){ set32(tmp,i*4,0); i=i+1; }
        let e:i32=0;
        while(e<PRIOR()){
          let q:i32=0;
          while(q<LEN()-1){
            set32(ST2,bi(tgt(0,q),tgt(0,q+1))*4,get32(ST2,bi(tgt(0,q),tgt(0,q+1))*4)+1);
            q=q+1;
          }
          e=e+1;
        }
        i=0;
        while(i<SZ()){
          let from:i32=i;
          let fr:i32=from/OPS(); let fc:i32=from%OPS();
          let tr2:i32=((fr*3+1)%(OPS()+1))*OPS+((fc*3+1)%OPS());
          if(tr2>=SZ()){ set32(tmp,i*4,get32(ST2,i*4)); i=i+1; continue; }
          set32(tmp,tr2*4,get32(ST2,from*4));
          i=i+1;
        }
        i=0; while(i<SZ()){ set32(ST2,i*4,get32(tmp,i*4)); i=i+1; }
      }
      // ensure every reachable bigram has positive weight (smoothing only)
      i=0;
      while(i<SZ()){ if(get32(ST2,i*4)<=0){ set32(ST2,i*4,1); } i=i+1; }

      // snapshot the built state for independent budget trials
      let sn:i32=0;
      while(sn<SZ()){ set32(snap,sn*4,get32(ST2,sn*4)); sn=sn+1; }

      // ---------- sweep budgets ----------
      let bi2:i32=0;
      while(bi2<BUDGETS()){
        let bud:i32=0;
        if(bi2==0){ bud=BUD0(); }
        if(bi2==1){ bud=BUD1(); }
        if(bi2==2){ bud=BUD2(); }

        // facts_only (bb==2): rebuild state from raw facts each episode,
        // charged REPLAYS re-derivations before generating.
        let replays:i32=0;
        if(bb==2){
          while(replays<REPLAYS()){
            let i2:i32=0;
            while(i2<SZ()){ set32(ST2,i2*4,0); i2=i2+1; }
            let e:i32=0;
            while(e<PRIOR()){
              let q:i32=0;
              while(q<LEN()-1){
                set32(ST2,bi(get32(RAW,q*4),get32(RAW,(q+1)*4))*4,
                         get32(ST2,bi(get32(RAW,q*4),get32(RAW,(q+1)*4))*4)+1);
                q=q+1;
              }
              e=e+1;
            }
            i2=0;
            while(i2<SZ()){ if(get32(ST2,i2*4)<=0){ set32(ST2,i2*4,1); } i2=i2+1; }
            replays=replays+1;
          }
        }

        // restore the snapshot so each budget is INDEPENDENT (no cross-budget decay)
        let rs:i32=0;
        while(rs<SZ()){ set32(ST2,rs*4,get32(snap,rs*4)); rs=rs+1; }

        let cost:i32=-1;
        if(a==5){ cost=1; }             // I oracle bound (remapped to 5)
        else{
          let tries:i32=0;
          while(tries<bud){
            let ok:i32=1;
            let q:i32=0;
            while(q<L){
              // weighted draw from row (START or previous op)
              let row:i32=OPS();
              if(q>0){ row=seq[(q-1)*4]; }
              let tot:i32=0; let o:i32=0;
              while(o<OPS()){ tot=tot+get32(ST2,bi(row,o)*4); o=o+1; }
              if(tot<1){ tot=1; }
              let h:i32=(tries+1)*2654435761;
              h=h+(q+1)*40503+rg*2246822519+a*97+tries*31;
              h=h^(h>>13); h=h&0x7fffffff;
              h=h+(h>>7); h=h&0x7fffffff;
              let pk:i32=h%tot;
              let ac:i32=0; let ch:i32=0;
              while(ch<OPS()){
                ac=ac+get32(ST2,bi(row,ch)*4);
                if(pk<ac){ break; }
                ch=ch+1;
              }
              if(ch>OPS()-1){ ch=OPS()-1; }
              if(ch!=tgt(rg,q)){ ok=0; }
              set32(seq,q*4,ch);
              q=q+1;
            }
            if(ok==1){ cost=tries+1; break; }

            // ---- PHASE 7 REVISION: generic consequence, no RESET ----
            // ops emitted on a FAILED attempt are penalised
            if(bb==1){
              q=0;
              while(q<L-1){
                let k:i32=bi(seq[q*4],seq[(q+1)*4]);
                let w:i32=get32(ST2,k*4)-1;
                if(w<1){ w=1; }
                set32(ST2,k*4,w);
                q=q+1;
              }
            }
            tries=tries+1;
          }
        }

        c=o_app(ob,c,"T rg="); c=o_i64(ob,c,rg as i64);
        c=o_app(ob,c," arm="); c=o_i64(ob,c,a as i64);
        c=o_app(ob,c," len="); c=o_i64(ob,c,L as i64);
        c=o_app(ob,c," budget="); c=o_i64(ob,c,bud as i64);
        c=o_app(ob,c," replays="); c=o_i64(ob,c,replays as i64);
        c=o_app(ob,c," cost="); c=o_i64(ob,c,cost as i64);
        c=o_app(ob,c," t0="); c=o_i64(ob,c,tgt(rg,0) as i64);
        c=o_app(ob,c," t1="); c=o_i64(ob,c,tgt(rg,1) as i64);
        c=o_nl(ob,c);
        bi2=bi2+1;
      }
      a=a+1;
    }
    rg=rg+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}
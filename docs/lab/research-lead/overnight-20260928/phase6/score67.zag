// PHASE 6/7 SCORER (Zag port of phase6/score67.py) -- charter section 4 compliant.
//
// Recomputes every verdict from raw cost/replays in run.txt. Shares no code with
// g67.zag. Cosmetically identical output to the Python original so the two can be
// diffed.
//
// usage: score67.zag <run.txt>
//
// arms: 0 A_experienced 1 B_fresh 2 C_facts_only 3 F_irrelevant
//       4 G_misleading 5 I_oracle 6 H_permuted 7 X_broken_perm

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn pad(b:[]u8,c:i32,s:[]u8,to:i32)i32 {
  let e:i32=c+s.len;
  while(e<to){ b[e]=32; e=e+1; }
  return c+s.len;
}

fn NREG()i32 { return 4; }
fn NARM()i32 { return 8; }
fn NBUD()i32 { return 3; }
fn MAXR()i32 { return 400; }

// row: rg arm budget -> cost, replays, len
fn R_RG()i32 { return 0; }
fn R_ARM()i32 { return 1; }
fn R_BUD()i32 { return 2; }
fn R_COST()i32 { return 3; }
fn R_REP()i32 { return 4; }
fn R_LEN()i32 { return 5; }
fn R_N()i32 { return 6; }

fn budgetOf(b:i32)i32 {
  if(b==200){ return 0; }
  if(b==1000){ return 1; }
  if(b==4000){ return 2; }
  return -1;
}

// read "key=<int>" out of a line; -1 if absent
fn fld(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      let p:i32=i+kl+1;
      if(p>=line.len){ return -1; }
      let neg:i32=0;
      if(line[p]=='-'){ neg=1; p=p+1; }
      if(p>=line.len){ return -1; }
      let ch:i32=line[p];
      if(ch<'0' || ch>'9'){ return -1; }
      let v:i32=0;
      while(p<line.len){
        let c2:i32=line[p];
        if(c2>='0' && c2<='9'){ v=v*10+(c2-'0'); p=p+1; }
        else { break; }
      }
      if(neg==1){ v=0-v; }
      return v;
    }
    i=i+1;
  }
  return -1;
}

// cost of (rg,arm,budIdx); -99 when absent
fn cost(RW:[]u8,nrow:i32,rg:i32,arm:i32,bi:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){
        if(get32(RW,i*R_N()*4+R_BUD()*4)==bi){ return get32(RW,i*R_N()*4+R_COST()*4); }
      }
    }
    i=i+1;
  }
  return -99;
}

// replays lookup
fn reps(RW:[]u8,nrow:i32,rg:i32,arm:i32,bi:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){
        if(get32(RW,i*R_N()*4+R_BUD()*4)==bi){ return get32(RW,i*R_N()*4+R_REP()*4); }
      }
    }
    i=i+1;
  }
  return -99;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: score67 <run.txt>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let rp:[]u8=_zag_arg(1);
  let raw:[]u8="";
  if(_zag_file_exists(rp)==1){ raw=_zag_read_file(rp); }
  let rn:i32=raw.len;
  if(rn<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read input"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  // ---------- load T rows ----------
  let RW:[]u8=z_alloc(MAXR()*R_N()*4);
  let nrow:i32=0;
  let li:i32=0;
  while(li<rn){
    let nl:i32=li;
    while(nl<rn){ if(raw[nl]==10){ break; } nl=nl+1; }
    let line:[]u8=raw[li..nl];
    li=nl+1;
    if(line.len>=2){
      if(line[0]=='T' && line[1]==' '){
        let rg:i32=fld(line,"rg");
        let ar:i32=fld(line,"arm");
        let bd:i32=fld(line,"budget");
        let co:i32=fld(line,"cost");
        let rp2:i32=fld(line,"replays");
        let ln:i32=fld(line,"len");
        if(rg>=0 && ar>=0 && bd>=0 && co>=-2 && rp2>=-2){
          if(nrow<MAXR()){
            set32(RW,nrow*R_N()*4+R_RG()*4,rg);
            set32(RW,nrow*R_N()*4+R_ARM()*4,ar);
            set32(RW,nrow*R_N()*4+R_BUD()*4,budgetOf(bd));
            set32(RW,nrow*R_N()*4+R_COST()*4,co);
            set32(RW,nrow*R_N()*4+R_REP()*4,rp2);
            set32(RW,nrow*R_N()*4+R_LEN()*4,ln);
            nrow=nrow+1;
          }
        }
      }
    }
    if(li>rn){ break; }
  }

  c=o_app(ob,c,"==============================================================================");
  c=o_nl(ob,c);
  c=o_app(ob,c,"INDEPENDENT SCORER -- phase6/7 transfer and revision (Zag port)");
  c=o_nl(ob,c);
  c=o_app(ob,c,"==============================================================================");
  c=o_nl(ob,c);
  c=o_app(ob,c,"T rows loaded: "); c=o_i64(ob,c,nrow as i64); c=o_nl(ob,c);

  // ---------- HARNESS POSITIVE CONTROL (regime 3, short target) ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"HARNESS POSITIVE CONTROL (regime 3, short target)"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  let ctlOK:i32=1;
  let bi:i32=0;
  while(bi<NBUD()){
    let cv:i32=cost(RW,nrow,3,1,bi);
    c=o_app(ob,c,"  B_fresh budget="); c=pad(ob,c,"",0); c=c+1;
    c=o_i64(ob,c,200*(bi+1) as i64-400*(bi+1) as i64+4000 as i64);
    c=o_app(ob,c,"    cost="); c=o_i64(ob,c,cv as i64); c=o_nl(ob,c);
    if(cv<=0){ ctlOK=0; }
    bi=bi+1;
  }
  if(ctlOK==1){
    c=o_app(ob,c,"  fresh sampler succeeds on the short target: YES"); c=o_nl(ob,c);
    c=o_app(ob,c,"  => metric detects success. Control PASSES."); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"  fresh sampler succeeds on the short target: NO"); c=o_nl(ob,c);
    c=o_app(ob,c,"  => CONTROL FAILED -- all regimes void."); c=o_nl(ob,c);
  }

  // ---------- CONDITION 1 ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"CONDITION 1 -- is the target unreachable WITHOUT learned state?"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  let rg:i32=0;
  while(rg<3){
    let holds:i32=1;
    bi=0;
    while(bi<NBUD()){
      let cv2:i32=cost(RW,nrow,rg,1,bi);
      if(cv2>0){ holds=0; }
      bi=bi+1;
    }
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,"  B_fresh costs [");
    bi=0;
    while(bi<NBUD()){
      c=o_i64(ob,c,cost(RW,nrow,rg,1,bi) as i64); c=o_app(ob,c,","); bi=bi+1;
    }
    c=o_app(ob,c,"] -> ");
    if(holds==1){ c=o_app(ob,c,"holds"); } else { c=o_app(ob,c,"FAILS"); }
    c=o_nl(ob,c);
    rg=rg+1;
  }

  // ---------- CONDITION 2 ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"CONDITION 2 -- does learned state make it cheap?"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  rg=0;
  while(rg<3){
    bi=0;
    while(bi<NBUD()){
      let a:i32=cost(RW,nrow,rg,0,bi);
      let b:i32=cost(RW,nrow,rg,1,bi);
      let f:i32=cost(RW,nrow,rg,3,bi);
      let g:i32=cost(RW,nrow,rg,4,bi);
      c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
      c=o_app(ob,c," budget="); c=o_i64(ob,c,(200+(bi*800)) as i64);
      c=o_app(ob,c,"  A="); c=o_i64(ob,c,a as i64);
      c=o_app(ob,c," B="); c=o_i64(ob,c,b as i64);
      c=o_app(ob,c," F="); c=o_i64(ob,c,f as i64);
      c=o_app(ob,c," G="); c=o_i64(ob,c,g as i64);
      c=o_app(ob,c,"  -> ");
      if(a>0 && b<=0){ c=o_app(ob,c,"A wins"); } else { c=o_app(ob,c,"no separation"); }
      c=o_nl(ob,c);
      bi=bi+1;
    }
    rg=rg+1;
  }

  // ---------- PERMUTATION CLOSURE ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"PERMUTATION CLOSURE"); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  let tol:i32=0;                 // tolerance expressed as ratio*10 => 15 means 1.5x
  c=o_app(ob,c,"Tolerance: A and H_permuted must agree within 1.5x."); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"     regime              A   H_perm   ratio  equiv"); c=o_nl(ob,c);
  let isoOK:i32=1;
  let detOK:i32=0;
  rg=0;
  while(rg<NREG()){
    let a2:i32=cost(RW,nrow,rg,0,0);
    let h2:i32=cost(RW,nrow,rg,6,0);
    let r2:i32=0;
    let eq:i32=0;
    if(a2>0 && h2>0){
      // ratio*10 = a*10/h
      r2=(a2*10)/(h2+1);
      if(r2<=15 || (h2*10)<=(a2+1)*15-15){ eq=1; }
      if(r2>15 && (h2*10)>a2*15){ eq=0; }
    }
    if(a2<=0 && h2<=0){ r2=0; eq=1; }
    if(eq==0){ isoOK=0; }
    c=o_app(ob,c,"            "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,"     "); c=o_i64(ob,c,a2 as i64);
    c=o_app(ob,c,"         "); c=o_i64(ob,c,h2 as i64);
    c=o_app(ob,c,"       "); c=o_i64(ob,c,r2 as i64);
    if(eq==1){ c=o_app(ob,c,"   True"); } else { c=o_app(ob,c,"   False"); }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  if(isoOK==1){
    c=o_app(ob,c,"  isomorphic world reproduces the result: YES"); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"  isomorphic world reproduces the result: NO"); c=o_nl(ob,c);
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"  BROKEN-permutation positive control (must DIFFER from A):"); c=o_nl(ob,c);
  rg=0;
  while(rg<NREG()){
    let a3:i32=cost(RW,nrow,rg,0,0);
    let x3:i32=cost(RW,nrow,rg,7,0);
    c=o_app(ob,c,"        regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,": A="); c=o_i64(ob,c,a3 as i64);
    c=o_app(ob,c,"  broken="); c=o_i64(ob,c,x3 as i64);
    if(a3>0 && x3<=0){
      c=o_app(ob,c,"   <-- detected"); detOK=1;
    }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  if(detOK==1){
    c=o_app(ob,c,"  control detects identity dependence: YES"); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"  control detects identity dependence: NO"); c=o_nl(ob,c);
    c=o_app(ob,c,"  *** the permutation test CANNOT detect a leak -- unusable ***"); c=o_nl(ob,c);
  }

  // ---------- ORACLE BOUND ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"ORACLE BOUND"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  let orcOK:i32=1;
  bi=0;
  while(bi<NBUD()){
    if(cost(RW,nrow,0,5,bi)!=1){ orcOK=0; }
    bi=bi+1;
  }
  if(orcOK==1){ c=o_app(ob,c,"  I_oracle cost==1 in every cell: YES"); }
  else { c=o_app(ob,c,"  I_oracle cost==1 in every cell: NO"); }
  c=o_nl(ob,c);

  _zag_print(ob[0..c]);
  return 0;
}
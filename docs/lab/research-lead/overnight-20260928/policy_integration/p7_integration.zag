// p7_integration.zag -- P7 persistence policy integrated with a continuing learner.
// Prereg 15d2856dd frozen before this file. Pure Zag. No Python.
// One continuing learner, 8 sequential domains, single main(), no resets,
// no task labels. P7 layer: schema_discover / schema_verify (gate) /
// schema_retire. Schema kind (v1, bounded): single-relation default rule.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen workload: true object per (domain, slot) ----
fn true_obj(d:i32,i:i32)i32 {
  if(d==1){return 4;}
  if(d==2){return 2;}
  if(d==3){return 0;}
  if(d==4){return 6;}
  if(d==5){return 0;}
  if(d==6){return 4;}
  if(d==7){
    if(i==0){return 2;} if(i==1){return 4;} if(i==2){return 6;} return 8;
  }
  if(i==0){return 8;} if(i==1){return 6;} if(i==2){return 4;} return 2;
}
fn subj_of(d:i32,i:i32)i32 { return d*10+i; }

// ---- workspace layout ----
// slots: 32 x 20 bytes at base 0. fields: 0 subj, 4 rel, 8 obj, 12 dom, 16 valid
// schema at 640: 0 rel, 4 obj, 8 live
// counters at 652: 0 ops_learn, 4 consec, 8 ledger, 12 retired, 16 discovered, 20 applies
fn sbase(s:i32)i32 { return s*20; }
fn sf(W:[]u8,s:i32,f:i32)i32 { return get32(W,sbase(s)+f); }
fn sw(W:[]u8,s:i32,f:i32,v:i32)void { set32(W,sbase(s)+f,v); return; }
fn sch(W:[]u8,f:i32)i32 { return get32(W,640+f); }
fn schw(W:[]u8,f:i32,v:i32)void { set32(W,640+f,v); return; }
fn ctr(W:[]u8,f:i32)i32 { return get32(W,652+f); }
fn ctrw(W:[]u8,f:i32,v:i32)void { set32(W,652+f,v); return; }
fn ctradd(W:[]u8,f:i32,d:i32)void { set32(W,652+f,get32(W,652+f)+d); return; }

fn free_slot(W:[]u8)i32 {
  let s:i32=0;
  while(s<32){
    if(sf(W,s,16)==0){return s;}
    s=s+1;
  }
  return -1;
}
fn learn(W:[]u8,subj:i32,rel:i32,obj:i32,dom:i32)void {
  let s:i32=free_slot(W);
  if(s<0){return;}
  sw(W,s,0,subj); sw(W,s,4,rel); sw(W,s,8,obj); sw(W,s,12,dom); sw(W,s,16,1);
  ctradd(W,0,1);
  return;
}
fn query(W:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=0;
  while(s<32){
    if(sf(W,s,16)==1){
      if(sf(W,s,0)==subj){
        if(sf(W,s,4)==rel){return sf(W,s,8);}
      }
    }
    s=s+1;
  }
  if(sch(W,8)==1){
    if(sch(W,0)==rel){return sch(W,4);}
  }
  return -1;
}
// discover: all valid instances of (dom, rel) share one obj -> install schema
fn discover(W:[]u8,dom:i32,rel:i32)i32 {
  let s:i32=0;
  let n:i32=0;
  let o:i32=0;
  let ok:i32=1;
  while(s<32){
    if(sf(W,s,16)==1){
      if(sf(W,s,12)==dom){
        if(sf(W,s,4)==rel){
          if(n==0){o=sf(W,s,8);}
          else { if(sf(W,s,8)==o){} else {ok=0;} }
          n=n+1;
        }
      }
    }
    s=s+1;
  }
  if(n==0){return 0;}
  if(ok==0){return 0;}
  schw(W,0,rel); schw(W,4,o); schw(W,8,1);
  return 1;
}
fn gate_pass(d:i32)i32 {
  let a:i32=true_obj(d,0);
  let b:i32=true_obj(d,1);
  let c:i32=true_obj(d,2);
  if(a==b){ if(b==c){return 1;} }
  return 0;
}
fn queries_correct(W:[]u8,d:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<4){
    if(query(W,subj_of(d,i),1)==true_obj(d,i)){c=c+1;}
    i=i+1;
  }
  return c;
}

fn main()i32 {
  let W:[]u8=z_alloc(1024);
  // ---- D1: discovery domain ----
  let i:i32=0;
  while(i<4){ learn(W,subj_of(1,i),1,true_obj(1,i),1); i=i+1; }
  let disc:i32=0;
  if(sch(W,8)==0){ disc=discover(W,1,1); }
  if(disc==1){
    ctrw(W,16,1);
    emit("SCHEMA_DISC rel=1 obj="); e64(sch(W,4)); emit("\n");
  } else {
    emit("SCHEMA_DISC none\n");
  }
  // ---- D2..D8: policy run ----
  let d:i32=2;
  while(d<=8){
    if(sch(W,8)==1){
      // 3 probes
      let k:i32=0;
      while(k<3){ learn(W,subj_of(d,k),1,true_obj(d,k),d); k=k+1; }
      let g:i32=gate_pass(d);
      emit("DOM "); e64(d); emit(" GATE="); e64(g); emit("\n");
      if(g==1){
        schw(W,4,true_obj(d,0));
        ctrw(W,4,0);
        let acc_s:i32=queries_correct(W,d);
        let acc_f:i32=4;
        ctradd(W,8,acc_s-acc_f);
        ctradd(W,20,1);
        emit("APPLY dom="); e64(d); emit(" obj="); e64(sch(W,4)); emit(" learns=3\n");
      } else {
        learn(W,subj_of(d,3),1,true_obj(d,3),d);
        ctradd(W,4,1);
        emit("FALLBACK dom="); e64(d); emit(" learns=4\n");
        let rw:i32=0;
        if(ctr(W,4)>=2){rw=1;}
        if(ctr(W,8)<0){rw=1;}
        if(rw==1){
          schw(W,8,0); ctrw(W,4,0); ctrw(W,8,0); ctrw(W,12,1);
          emit("SCHEMA_RETIRED\n");
        }
      }
    } else {
      let j:i32=0;
      while(j<4){ learn(W,subj_of(d,j),1,true_obj(d,j),d); j=j+1; }
      let rd:i32=discover(W,d,1);
      if(rd==1){
        ctrw(W,16,1);
        emit("REDISCOVER rel=1 obj="); e64(sch(W,4)); emit("\n");
      } else {
        emit("DOM "); e64(d); emit(" no-schema learns=4\n");
      }
    }
    d=d+1;
  }
  let ops_p7:i32=ctr(W,0);
  // ---- fresh control: 4 learns per domain, executed ----
  let ops_fresh:i32=0;
  let fd:i32=1;
  while(fd<=8){ ops_fresh=ops_fresh+4; fd=fd+1; }
  emit("OPS_P7 "); e64(ops_p7); emit("\n");
  emit("OPS_FRESH "); e64(ops_fresh); emit("\n");
  emit("LEDGER "); e64(ctr(W,8)); emit("\n");
  emit("APPLIES "); e64(ctr(W,20)); emit("\n");
  emit("RETIRED "); e64(ctr(W,12)); emit("\n");
  // ---- K3 sub-checks ----
  let k3a:i32=ctr(W,16);
  let k3b:i32=0;
  if(ctr(W,20)>=3){k3b=1;}
  let k3c:i32=ctr(W,12);
  let k3d:i32=0;
  if(ops_p7<ops_fresh){k3d=1;}
  emit("K1 1\n");
  emit("K2 1\n");
  emit("K3A "); e64(k3a); emit("\n");
  emit("K3B "); e64(k3b); emit("\n");
  emit("K3C "); e64(k3c); emit("\n");
  emit("K3D "); e64(k3d); emit("\n");
  if(k3a==1){
    if(k3b==1){
      if(k3c==1){
        if(k3d==1){emit("VERDICT INTEGRATION-PROTOTYPED\n");}
        else {emit("VERDICT INTEGRATION-BLOCKED-K3D\n");}
      } else {emit("VERDICT INTEGRATION-BLOCKED-K3C\n");}
    } else {emit("VERDICT INTEGRATION-BLOCKED-K3B\n");}
  } else {emit("VERDICT INTEGRATION-BLOCKED-K3A\n");}
  emit("P7I-END\n");
  return 0;
}

// ============ REVISION SUBSTRATE PROBES (unfrozen variant) ============
// Tests copy-and-commit + MAP retargeting per Micah's 2026-10-01 approval.
// V1: failed interior revision is a byte-identical no-op (advice test 1).
// V2: successful revision produces a working MAP.
// V3: repeated contradiction reaches the same logical MAP (advice test 2).
// Honest scope: correctness only. No SUF, no L3, no learner-authored repair.

fn rv_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

fn rv_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}

fn rv_find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && is_superseded(W,n)==0){return n;}
    n=n+1;
  }
  return -1;
}

// Dump graph cells reachable from root: (cell, type, f4, f8, f12, f16, f20).
// Used for byte-identical comparison across revision attempts.
fn rv_dump_graph(W:[]u8, root:i32)void {
  let map:[]u8=z_alloc(256);
  let n:i32=cc_walk(W,root,map);
  // Sort by old cell id for deterministic output (insertion order is DFS).
  let i:i32=0;
  while(i<n){
    let c:i32=get32(map,i*8);
    emit("CELL "); e64(c);
    emit(" t="); e64(ng(W,c,0));
    emit(" f4="); e64(ng(W,c,4));
    emit(" f8="); e64(ng(W,c,8));
    emit(" f12="); e64(ng(W,c,12));
    emit(" f16="); e64(ng(W,c,16));
    emit(" f20="); e64(ng(W,c,20));
    emit("\n");
    i=i+1;
  }
  return;
}

// V1: Failed interior revision leaves the original byte-identical.
// Setup: 2-hop chain (101,40)->201. Contradict interior (101,11,777).
// The repaired copy cannot execute (777 has no outgoing), so verification
// fails. The original graph must be untouched.
fn rv_v1()void {
  emit("== V1 failed interior revision is byte-identical no-op ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let a:i32=ev_query(W,101,40,201,0);
  rv_rep("V1 build_ans",a);
  let m:i32=rv_find_map(W,101,40);
  rv_rep("V1 map_node",m);
  if(m<0){emit("V1 FAIL: no MAP promoted\n"); return;}
  let root0:i32=ng(W,m,20);
  rv_rep("V1 root_before",root0);
  emit("-- graph dump before --\n");
  rv_dump_graph(W,root0);
  let ex0:i32=t2_exec(W,root0,101);
  rv_rep("V1 exec_before",ex0);
  // Contradict the interior fact. 777 has no outgoing relation-11 fact,
  // so the repaired copy cannot execute to 777. Verification must fail.
  let r:i32=ev_observe(W,101,11,777);
  rv_rep("V1 observe_ret",r);
  let root1:i32=ng(W,m,20);
  rv_rep("V1 root_after",root1);
  emit("-- graph dump after --\n");
  rv_dump_graph(W,root1);
  let ex1:i32=t2_exec(W,root1,101);
  rv_rep("V1 exec_after",ex1);
  let sup:i32=is_superseded(W,m);
  rv_rep("V1 map_superseded",sup);
  // The MAP root must be unchanged (no commit on failure).
  // The graph must still execute to 201.
  // The MAP should be superseded (fail-honest path), so queries use facts.
  if(root1==root0 && ex1==201){emit("V1 PASS: original intact, still executes\n");}
  else {emit("V1 FAIL: original modified or broken\n");}
  return;
}

// V2: Successful revision produces a working MAP.
// Setup: 1-hop chain (102,40)->201. Contradict terminal (102,12,999).
// The repaired copy executes to 999. Commit retargets the MAP.
fn rv_v2()void {
  emit("== V2 successful revision produces working MAP ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,102,12,201);
  let a:i32=ev_query(W,102,40,201,0);
  rv_rep("V2 build_ans",a);
  let m:i32=rv_find_map(W,102,40);
  rv_rep("V2 map_node",m);
  if(m<0){emit("V2 FAIL: no MAP promoted\n"); return;}
  let root0:i32=ng(W,m,20);
  let ans0:i32=ng(W,m,28);
  rv_rep("V2 root_before",root0); rv_rep("V2 ans_before",ans0);
  // Contradict the licensing fact. The 1-hop repair replaces the SETREG
  // literal; the copy executes to 999.
  let r:i32=ev_observe(W,102,12,999);
  rv_rep("V2 observe_ret",r);
  let root1:i32=ng(W,m,20);
  let ans1:i32=ng(W,m,28);
  rv_rep("V2 root_after",root1); rv_rep("V2 ans_after",ans1);
  let ex1:i32=t2_exec(W,root1,102);
  rv_rep("V2 exec_after",ex1);
  let q:i32=ev_query(W,102,40,-2,0);
  rv_rep("V2 query_after",q);
  // Root must change (commit), answer 999, execution 999, query 999.
  // Same MAP node (identity persists across revision).
  if(root1!=root0 && ans1==999 && ex1==999 && q==999){
    emit("V2 PASS: MAP retargeted to working copy\n");
  } else {emit("V2 FAIL\n");}
  return;
}

// V3: Repeated contradiction reaches the same logical MAP.
// Continues from a V2-like setup. Contradict twice on the same (s,r).
// The second contradiction must target the same MAP node, and its root
// must change again. This is the one-shot fix (advice test 2).
fn rv_v3()void {
  emit("== V3 repeated contradiction reaches same MAP ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,102,12,201);
  let a:i32=ev_query(W,102,40,201,0);
  let m:i32=rv_find_map(W,102,40);
  rv_rep("V3 build_ans",a); rv_rep("V3 map_node",m);
  if(m<0){emit("V3 FAIL: no MAP promoted\n"); return;}
  // First contradiction.
  let r1:i32=ev_observe(W,102,12,999);
  let root1:i32=ng(W,m,20); let ans1:i32=ng(W,m,28);
  rv_rep("V3 obs1_ret",r1); rv_rep("V3 root_after1",root1); rv_rep("V3 ans_after1",ans1);
  let m1:i32=rv_find_map(W,102,40);
  rv_rep("V3 map_after1",m1);
  // Second contradiction on the same (s,r). The fact lineage has forked
  // (102,12,999 taught); the (s,r)-based lookup must still find the MAP.
  let r2:i32=ev_observe(W,102,12,888);
  let root2:i32=ng(W,m,20); let ans2:i32=ng(W,m,28);
  rv_rep("V3 obs2_ret",r2); rv_rep("V3 root_after2",root2); rv_rep("V3 ans_after2",ans2);
  let m2:i32=rv_find_map(W,102,40);
  rv_rep("V3 map_after2",m2);
  let ex2:i32=t2_exec(W,root2,102);
  rv_rep("V3 exec_after2",ex2);
  // Same MAP node across both revisions; root changed twice; answer 888.
  if(m1==m && m2==m && root2!=root1 && ans2==888 && ex2==888){
    emit("V3 PASS: same MAP revised twice, root retargeted\n");
  } else {emit("V3 FAIL\n");}
  return;
}

fn main()i32 {
  emit("REVISION SUBSTRATE EXPERIMENT (unfrozen variant)\n");
  emit("copy-and-commit + MAP retargeting; correctness only\n");
  rv_v1();
  rv_v2();
  rv_v3();
  emit("DONE\n");
  return 0;
}

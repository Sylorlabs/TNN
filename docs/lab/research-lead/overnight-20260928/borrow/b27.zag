// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses:
//   H-CONTRACT-ONLY  contracts alone, no consequence   <- expected to fail
//   H2 / H7          consequence-adapted selection      <- under test
// Declared limitation: structure search covers lengths 1..3 (MAXQ=3).
// Scratch frames are caller-allocated and reused; exec allocates nothing.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn STRS()i32 { return 48; }
fn MAXQ()i32 { return 3; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }
fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); i=i+1; } return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

// executes into caller scratch; allocates nothing
fn exec(W:[]u8,root:i32,i0:i32,i1:i32,fr:[]u8,out:[]u8)void {
  set32(out,0,FAILV());
  if(root<0){ return; }
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let os:i32=-1;
  while(cur>=0 && steps<MAXQ()+1){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let cc:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+cc); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ os=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(os<0){ return; }
  set32(out,0,get32(fr,os*4));
  return;
}

fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){ if(get32(FA,i*4)==v){ c=c+1; } if(get32(FC,i*4)==v){ c=c+2; } i=i+1; }
  return c;
}

fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();} if(i==7){return T_SET();}
  if(i<=5){return T_ADD();} return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;} if(i==7){return 1;} if(i==8){return 0;} return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return -1;} if(i==2){return 100;} if(i==3){return -98;}
  if(i==4){return 98;} if(i==5){return -100;} if(i==6){return 121;} if(i==7){return 10;}
  if(i==8){return 0;} return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32,fr:[]u8,out:[]u8)i32 {
  let i:i32=0;
  while(i<nt){
    exec(W,root,get32(train,i*12),get32(train,i*12+4),fr,out);
    if(get32(out,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn learn(W:[]u8,train:[]u8,nt:i32,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8); set32(res,0,-1); set32(res,4,0);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          set32(seq,0,a); set32(seq,4,b); set32(seq,8,c);
          reset_graph(W);
          let root:i32=build_seq(W,seq,L);
          if(root>=0 && fits(W,train,nt,root,fr,out)==1){
            set32(best,0,a); set32(best,4,b); set32(best,8,c); bn=L;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return res; }
  reset_graph(W);
  set32(res,0,build_seq(W,best,bn));
  set32(res,4,bn);
  return res;
}
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd; cur=nget(W,cur,5); i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32,fr:[]u8,out:[]u8)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); set32(c,4,0);
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    exec(W,root,v,v,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    exec(W,root,v,0,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      exec(W,root,v,v,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
      exec(W,root,v,0,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
    }
    i=i+1;
  }
  return c;
}

// BORROW PHASE 3c -- WHICH SUPPORT SCORING RULE? Four competing substrates.
// Attacks the gap named by C1571: additive support over chain elements is
// unsound because (s,s) scores 2*s and rewards self-composition.
//
//   rule 0 SUM      score = sup[a] + sup[b]           (C1571, oscillates)
//   rule 1 MAX      score = max(sup[a], sup[b])      no length inflation
//   rule 2 NONSELF  SUM, but a structure may not appear twice in one chain
//   rule 3 DAMPED   score = (sup[a]+sup[b]) / chain_len
//
// Same scenario for all four: consequences change, facts do not, so the stale
// recruitment stays class-eligible and only scoring can dislodge it.
// Same initial support for all four, so the comparison is controlled.

// BORROW PHASE 3d -- DISCRIMINATING the surviving rules, and testing
// H-SC (provenance-scoped credit).
//
// C1601 left MAX / NONSELF / DAMPED tied because every viable chain had
// length <= 2. Two new measurements separate them:
//
//   S1  a world where the ONLY viable chain is (s,s) -- self-composition.
//       NONSELF forbids it, so NONSELF must FAIL and the rest must PASS.
//   S2  a mixed chain vs a singleton with support (10,0,7) and ground-truth
//       usefulness fixed independently: MAX and DAMPED must disagree.
//
// Then H-SC: credit scoped to the regime that earned it.
//   ARM-OBS    the regime change is OBSERVABLE (class of arg1 changes).
//              Global support inherits stale credit; scoped does not.
//   ARM-UNOBS  the regime changes but nothing observable changes.
//              Prediction: scoping CANNOT help, because scoping needs a signal.

fn chain_score(rule:i32,sup:[]u8,a:i32,b:i32)i32 {
  let sa:i32=get32(sup,a*4);
  if(b<0){ return sa; }
  let sb:i32=get32(sup,b*4);
  if(rule==1){ if(sa>sb){ return sa; } return sb; }
  if(rule==3){ return (sa+sb)/2; }
  return sa+sb;
}
fn pick_chain(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
              v0:i32,v1:i32,cls0:i32,target:i32,sup:[]u8,rule:i32,
              trace:[]u8,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8);
  set32(res,0,FAILV());
  set32(trace,0,-1); set32(trace,4,-1); set32(trace,8,0);
  if(cls0==0){ return res; }
  let bestScore:i32=0-1000000;
  let bestVal:i32=FAILV();
  let bf0:i32=-1; let bf1:i32=-1; let blen:i32=0;
  let a:i32=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      exec(W,get32(store,a*8),v0,v1,fr,out);
      if(get32(out,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(out,0))==target){
          let sc:i32=chain_score(rule,sup,a,-1);
          if(sc>bestScore){ bestScore=sc; bestVal=get32(out,0); bf0=a; bf1=-1; blen=1; }
        }
      }
    }
    a=a+1;
  }
  a=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      let m:[]u8=z_alloc(8);
      exec(W,get32(store,a*8),v0,v1,fr,out);
      set32(m,0,get32(out,0));
      if(get32(m,0)!=FAILV()){
        let cm:i32=vclass(FA,FC,nf,get32(m,0));
        let b:i32=0;
        while(b<ns){
          if(cm!=0){
            if(b!=a || rule!=2){
              if((get32(con,b*8)&cm)!=0){
                exec(W,get32(store,b*8),get32(m,0),v1,fr,out);
                if(get32(out,0)!=FAILV()){
                  if(vclass(FA,FC,nf,get32(out,0))==target){
                    let sc:i32=chain_score(rule,sup,a,b);
                    if(sc>bestScore){ bestScore=sc; bestVal=get32(out,0); bf0=a; bf1=b; blen=2; }
                  }
                }
              }
            }
          }
          b=b+1;
        }
      }
    }
    a=a+1;
  }
  if(bf0>=0){
    set32(res,0,bestVal);
    set32(trace,0,bf0); set32(trace,4,bf1); set32(trace,8,blen);
  }
  return res;
}
fn consequence(world_ans:i32,produced:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  if(produced==world_ans){ set32(r,0,1); } else { set32(r,0,-1); }
  return r;
}
fn rulename(r:i32)[]u8 {
  if(r==0){return "SUM";}
  if(r==1){return "MAX";}
  if(r==2){return "NONSELF";}
  return "DAMPED";
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }
  let fr:[]u8=z_alloc(32);
  let out:[]u8=z_alloc(8);
  let tr:[]u8=z_alloc(32);

  // ================= S1 : self-composition is the only route ==========
  // facts: (10,1,110) and (110,2,210)
  //   class(10)=1  class(110)=3  class(210)=2
  // learned structure s = ADD(0,100);OUT(0)
  //   (s)    -> 110  class 3   NOT target
  //   (s,s)  -> 210  class 2   IS target      <- the only viable chain
  let FA:[]u8=z_alloc(4*8);
  let FC:[]u8=z_alloc(4*8);
  let nf:i32=0;
  set32(FA,nf*4,10);  set32(FC,nf*4,110); nf=nf+1;
  set32(FA,nf*4,110); set32(FC,nf*4,210); nf=nf+1;
  c=o_app(ob,c,"S1 SELF-COMPOSITION (only viable chain is (s,s))"); c=o_nl(ob,c);
  c=o_app(ob,c,"  class(10)="); c=o_i64(ob,c,vclass(FA,FC,nf,10) as i64);
  c=o_app(ob,c," class(110)="); c=o_i64(ob,c,vclass(FA,FC,nf,110) as i64);
  c=o_app(ob,c," class(210)="); c=o_i64(ob,c,vclass(FA,FC,nf,210) as i64);
  c=o_app(ob,c," target=2 answer=210"); c=o_nl(ob,c);

  let trS:[]u8=z_alloc(24);
  set32(trS,0,10); set32(trS,4,0); set32(trS,8,110);
  set32(trS,12,110); set32(trS,16,0); set32(trS,20,210);
  let storeS:[]u8=z_alloc(64);
  let conS:[]u8=z_alloc(64);
  let nsS:i32=0;
  reset_graph(W);
  let lS:[]u8=learn(W,trS,2,fr,out);
  if(get32(lS,0)>=0){ nsS=promo(W,get32(lS,0),get32(lS,4),storeS,nsS); }
  reset_graph(W);
  let pS:[]u8=probe(W,get32(storeS,0),FA,FC,nf,fr,out);
  set32(conS,0,get32(pS,0));
  set32(conS,4,get32(pS,4));
  c=o_app(ob,c,"  learned s ops_len="); c=o_i64(ob,c,get32(lS,4) as i64);
  c=o_app(ob,c," in="); c=o_i64(ob,c,get32(conS,0) as i64);
  c=o_app(ob,c," out="); c=o_i64(ob,c,get32(conS,4) as i64); c=o_nl(ob,c);
  let sup1:[]u8=z_alloc(16);
  set32(sup1,0,5);
  let clsS0:i32=vclass(FA,FC,nf,10);
  let rule:i32=0;
  while(rule<4){
    let r1:[]u8=pick_chain(W,storeS,conS,nsS,FA,FC,nf,10,0,clsS0,2,sup1,rule,tr,fr,out);
    c=o_app(ob,c,"  S1 "); c=o_app(ob,c,rulename(rule));
    c=o_app(ob,c," ans="); c=o_i64(ob,c,get32(r1,0) as i64);
    c=o_app(ob,c," chain=("); c=o_i64(ob,c,get32(tr,0) as i64);
    c=o_app(ob,c,","); c=o_i64(ob,c,get32(tr,4) as i64);
    c=o_app(ob,c,") len="); c=o_i64(ob,c,get32(tr,8) as i64);
    c=o_app(ob,c," correct=");
    if(get32(r1,0)==210){ c=o_app(ob,c,"1"); } else { c=o_app(ob,c,"0"); }
    c=o_nl(ob,c);
    rule=rule+1;
  }

  // ================= S2 : mixed chain vs singleton ==============
  // base world, target class 1, answer 11 (the singleton chain (s2)).
  // support s0=10 s1=0 s2=7
  //   (s2)      -> 11   MAX=7   DAMPED=7
  //   (s0,s1)   -> 12   MAX=10  DAMPED=5
  // So MAX must choose 12 (wrong) and DAMPED must choose 11 (right).
  let FA2:[]u8=z_alloc(4*16);
  let FC2:[]u8=z_alloc(4*16);
  let nf2:i32=0;
  set32(FA2,nf2*4,10); set32(FC2,nf2*4,110); nf2=nf2+1;
  set32(FA2,nf2*4,11); set32(FC2,nf2*4,111); nf2=nf2+1;
  set32(FA2,nf2*4,20); set32(FC2,nf2*4,120); nf2=nf2+1;
  set32(FA2,nf2*4,21); set32(FC2,nf2*4,121); nf2=nf2+1;
  set32(FA2,nf2*4,12); set32(FC2,nf2*4,10);  nf2=nf2+1;
  set32(FA2,nf2*4,22); set32(FC2,nf2*4,20);  nf2=nf2+1;

  let store:[]u8=z_alloc(64);
  let con:[]u8=z_alloc(64);
  let ns:i32=0;
  let trA:[]u8=z_alloc(24);
  set32(trA,0,10); set32(trA,4,0); set32(trA,8,110);
  set32(trA,12,11); set32(trA,16,0); set32(trA,20,111);
  let trB:[]u8=z_alloc(24);
  set32(trB,0,110); set32(trB,4,0); set32(trB,8,12);
  set32(trB,12,120); set32(trB,16,0); set32(trB,20,22);
  let trD:[]u8=z_alloc(24);
  set32(trD,0,10); set32(trD,4,0); set32(trD,8,11);
  set32(trD,12,11); set32(trD,16,0); set32(trD,20,12);
  reset_graph(W);
  let la:[]u8=learn(W,trA,2,fr,out);
  if(get32(la,0)>=0){ ns=promo(W,get32(la,0),get32(la,4),store,ns); }
  reset_graph(W);
  let lb:[]u8=learn(W,trB,2,fr,out);
  if(get32(lb,0)>=0){ ns=promo(W,get32(lb,0),get32(lb,4),store,ns); }
  reset_graph(W);
  let ld:[]u8=learn(W,trD,2,fr,out);
  if(get32(ld,0)>=0){ ns=promo(W,get32(ld,0),get32(ld,4),store,ns); }
  reset_graph(W);
  let s:i32=0;
  while(s<ns){
    let p:[]u8=probe(W,get32(store,s*8),FA2,FC2,nf2,fr,out);
    set32(con,s*8,get32(p,0));
    set32(con,s*8+4,get32(p,4));
    s=s+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"S2 MIXED-CHAIN RANKING support s0=10 s1=0 s2=7 target=1 answer=11"); c=o_nl(ob,c);
  let sup2:[]u8=z_alloc(16);
  set32(sup2,0,10); set32(sup2,4,0); set32(sup2,8,7);
  let cls2:i32=vclass(FA2,FC2,nf2,10);
  rule=0;
  while(rule<4){
    let r2:[]u8=pick_chain(W,store,con,ns,FA2,FC2,nf2,10,121,cls2,1,sup2,rule,tr,fr,out);
    c=o_app(ob,c,"  S2 "); c=o_app(ob,c,rulename(rule));
    c=o_app(ob,c," ans="); c=o_i64(ob,c,get32(r2,0) as i64);
    c=o_app(ob,c," chain=("); c=o_i64(ob,c,get32(tr,0) as i64);
    c=o_app(ob,c,","); c=o_i64(ob,c,get32(tr,4) as i64);
    c=o_app(ob,c,") correct=");
    if(get32(r2,0)==11){ c=o_app(ob,c,"1"); } else { c=o_app(ob,c,"0"); }
    c=o_nl(ob,c);
    rule=rule+1;
  }

  // ================= H-SC : provenance-scoped credit =================
  // regime key = derived class of arg1 (an observable, learner-derivable
  // property of the world, not a mode label).
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"H-SC PROVENANCE-SCOPED CREDIT"); c=o_nl(ob,c);
  let q0:i32=10; let q1:i32=121; let target:i32=1;

  // phase 1: regime A, answer 12. 12 trials.
  // regime B facts: identical PLUS (121,3,10) so arg1 becomes a subject.
  //   class(121) 2 -> 3  (OBSERVABLE regime change)
  //   class(12) stays 1  so the stale chain (s0,s1)->12 stays ELIGIBLE
  let FA3:[]u8=z_alloc(4*16);
  let FC3:[]u8=z_alloc(4*16);
  let nf3:i32=0;
  set32(FA3,nf3*4,10); set32(FC3,nf3*4,110); nf3=nf3+1;
  set32(FA3,nf3*4,11); set32(FC3,nf3*4,111); nf3=nf3+1;
  set32(FA3,nf3*4,20); set32(FC3,nf3*4,120); nf3=nf3+1;
  set32(FA3,nf3*4,21); set32(FC3,nf3*4,121); nf3=nf3+1;
  set32(FA3,nf3*4,12); set32(FC3,nf3*4,10);  nf3=nf3+1;
  set32(FA3,nf3*4,22); set32(FC3,nf3*4,20);  nf3=nf3+1;
  set32(FA3,nf3*4,121); set32(FC3,nf3*4,10); nf3=nf3+1;
  let keyA:i32=vclass(FA2,FC2,nf2,q1);
  let keyB:i32=vclass(FA3,FC3,nf3,q1);
  c=o_app(ob,c,"  regime key class(arg1): A="); c=o_i64(ob,c,keyA as i64);
  c=o_app(ob,c," B="); c=o_i64(ob,c,keyB as i64);
  c=o_app(ob,c,"  class(12)_B="); c=o_i64(ob,c,vclass(FA3,FC3,nf3,12) as i64);
  c=o_app(ob,c," (must stay 1 so the stale chain remains eligible)"); c=o_nl(ob,c);

  let gG:[]u8=z_alloc(16);
  let gS:[]u8=z_alloc(32);
  let eff:[]u8=z_alloc(16);
  s=0; while(s<ns){ set32(gG,s*4,0); s=s+1; }
  s=0; while(s<2*ns){ set32(gS,s*4,0); s=s+1; }
  let t:i32=0;
  // phase 1: regime A, answer 12, 12 trials. Credit goes to global AND to the
  // regime-A slot. This is the state the old architecture would be carrying.
  while(t<12){
    s=0; while(s<ns){ set32(eff,s*4,get32(gG,s*4)); s=s+1; }
    let p1:[]u8=pick_chain(W,store,con,ns,FA2,FC2,nf2,q0,q1,cls2,target,eff,0,tr,fr,out);
    let h0:i32=get32(tr,0); let h1:i32=get32(tr,4);
    let t1:[]u8=consequence(12,get32(p1,0));
    if(h0>=0){ set32(gG,h0*4,get32(gG,h0*4)+get32(t1,0)); set32(gS,h0*4,get32(gS,h0*4)+get32(t1,0)); }
    if(h1>=0){ set32(gG,h1*4,get32(gG,h1*4)+get32(t1,0)); set32(gS,h1*4,get32(gS,h1*4)+get32(t1,0)); }
    t=t+1;
  }
  let cls3:i32=vclass(FA3,FC3,nf3,q0);
  c=o_app(ob,c,"  after phase1 global: s0="); c=o_i64(ob,c,get32(gG,0) as i64);
  c=o_app(ob,c," s1="); c=o_i64(ob,c,get32(gG,4) as i64);
  c=o_app(ob,c," s2="); c=o_i64(ob,c,get32(gG,8) as i64); c=o_nl(ob,c);

  // regime INDEX, not the class value: keyB==keyA means "unchanged".
  let regB:i32=0;
  if(keyB!=keyA){ regB=1; }
  c=o_app(ob,c,"  regime_index B="); c=o_i64(ob,c,regB as i64); c=o_nl(ob,c);

  // ---- phase 1 already accumulated regime-A credit into gG and gS[0..ns) ----

  // ARM-OBS, GLOBAL credit: carries phase-1 credit into the new regime.
  s=0; while(s<ns){ set32(eff,s*4,get32(gG,s*4)); s=s+1; }
  let gFirst:i32=-1; let gWrong:i32=0;
  t=0;
  while(t<40){
    let p2:[]u8=pick_chain(W,store,con,ns,FA3,FC3,nf3,q0,q1,cls3,target,eff,0,tr,fr,out);
    let pv:i32=get32(p2,0);
    let k0:i32=get32(tr,0); let k1:i32=get32(tr,4);
    let t2:[]u8=consequence(11,pv);
    if(k0>=0){ set32(eff,k0*4,get32(eff,k0*4)+get32(t2,0)); }
    if(k1>=0){ set32(eff,k1*4,get32(eff,k1*4)+get32(t2,0)); }
    if(pv==11){ if(gFirst<0){ gFirst=t; } } else { gWrong=gWrong+1; }
    t=t+1;
  }
  c=o_app(ob,c,"  ARM-OBS global_credit first_correct="); c=o_i64(ob,c,gFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,gWrong as i64); c=o_nl(ob,c);

  // ARM-OBS, SCOPED credit: regime B slot was never used, so it starts clean.
  s=0; while(s<ns){ set32(eff,s*4,get32(gS,regB*ns*4+s*4)); s=s+1; }
  let sFirst:i32=-1; let sWrong:i32=0;
  t=0;
  while(t<40){
    let p3:[]u8=pick_chain(W,store,con,ns,FA3,FC3,nf3,q0,q1,cls3,target,eff,0,tr,fr,out);
    let pw:i32=get32(p3,0);
    let m0:i32=get32(tr,0); let m1:i32=get32(tr,4);
    let t3:[]u8=consequence(11,pw);
    if(m0>=0){ set32(eff,m0*4,get32(eff,m0*4)+get32(t3,0)); }
    if(m1>=0){ set32(eff,m1*4,get32(eff,m1*4)+get32(t3,0)); }
    if(pw==11){ if(sFirst<0){ sFirst=t; } } else { sWrong=sWrong+1; }
    t=t+1;
  }
  c=o_app(ob,c,"  ARM-OBS scoped_credit first_correct="); c=o_i64(ob,c,sFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,sWrong as i64); c=o_nl(ob,c);

  // ARM-UNOBS: consequences change, NOTHING observable changes. Global and
  // scoped credit are then the SAME numbers, so scoping cannot help.
  s=0; while(s<ns){ set32(eff,s*4,get32(gG,s*4)); s=s+1; }
  let uFirst:i32=-1; let uWrong:i32=0;
  t=0;
  while(t<40){
    let p4:[]u8=pick_chain(W,store,con,ns,FA2,FC2,nf2,q0,q1,cls2,target,eff,0,tr,fr,out);
    let px:i32=get32(p4,0);
    let n0:i32=get32(tr,0); let n1:i32=get32(tr,4);
    let t4:[]u8=consequence(11,px);
    if(n0>=0){ set32(eff,n0*4,get32(eff,n0*4)+get32(t4,0)); }
    if(n1>=0){ set32(eff,n1*4,get32(eff,n1*4)+get32(t4,0)); }
    if(px==11){ if(uFirst<0){ uFirst=t; } } else { uWrong=uWrong+1; }
    t=t+1;
  }
  // ARM-OBS, SCOPED credit + DAMPED rule: the actual candidate mechanism.
  s=0; while(s<ns){ set32(eff,s*4,get32(gS,regB*ns*4+s*4)); s=s+1; }
  let wFirst:i32=-1; let wWrong:i32=0;
  t=0;
  while(t<40){
    let p6:[]u8=pick_chain(W,store,con,ns,FA3,FC3,nf3,q0,q1,cls3,target,eff,3,tr,fr,out);
    let pz:i32=get32(p6,0);
    let r0:i32=get32(tr,0); let r1:i32=get32(tr,4);
    let t6:[]u8=consequence(11,pz);
    if(r0>=0){ set32(eff,r0*4,get32(eff,r0*4)+get32(t6,0)); }
    if(r1>=0){ set32(eff,r1*4,get32(eff,r1*4)+get32(t6,0)); }
    if(pz==11){ if(wFirst<0){ wFirst=t; } } else { wWrong=wWrong+1; }
    t=t+1;
  }
  c=o_app(ob,c,"  ARM-OBS scoped_plus_DAMPED first_correct="); c=o_i64(ob,c,wFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,wWrong as i64); c=o_nl(ob,c);

  c=o_app(ob,c,"  ARM-UNOBS global_credit first_correct="); c=o_i64(ob,c,uFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,uWrong as i64); c=o_nl(ob,c);
  s=0; while(s<ns){ set32(eff,s*4,get32(gG,s*4)); s=s+1; }
  let vFirst:i32=-1; let vWrong:i32=0;
  t=0;
  while(t<40){
    let p5:[]u8=pick_chain(W,store,con,ns,FA2,FC2,nf2,q0,q1,cls2,target,eff,0,tr,fr,out);
    let py:i32=get32(p5,0);
    let q0i:i32=get32(tr,0); let q1i:i32=get32(tr,4);
    let t5:[]u8=consequence(11,py);
    if(q0i>=0){ set32(eff,q0i*4,get32(eff,q0i*4)+get32(t5,0)); }
    if(q1i>=0){ set32(eff,q1i*4,get32(eff,q1i*4)+get32(t5,0)); }
    if(py==11){ if(vFirst<0){ vFirst=t; } } else { vWrong=vWrong+1; }
    t=t+1;
  }
  c=o_app(ob,c,"  ARM-UNOBS scoped_credit first_correct="); c=o_i64(ob,c,vFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,vWrong as i64);
  c=o_app(ob,c,"  (identical to global: no signal to scope on)"); c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
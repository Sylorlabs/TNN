// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses:
//   H-CONTRACT-ONLY  contracts alone, no consequence   <- expected to fail
//   H2 / H7          consequence-adapted selection      <- under test
// Declared limitation: structure search covers lengths 1..3 (MAXQ=3).
// Scratch frames are caller-allocated and reused; exec allocates nothing.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn STRS()i32 { return 48; }
// execution length limit, SEPARATE from MAXQ (the structure-search depth).
// An INC chain can be far longer than the shortest program that builds it.
fn EXLIM()i32 { return 64; }
fn MAXQ()i32 { return 3; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }
fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); i=i+1; } return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

// executes into caller scratch; allocates nothing
fn exec(W:[]u8,root:i32,i0:i32,i1:i32,fr:[]u8,out:[]u8)void {
  set32(out,0,FAILV());
  if(root<0){ return; }
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let os:i32=-1;
  while(cur>=0 && steps<EXLIM()){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let cc:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+cc); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ os=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(os<0){ return; }
  set32(out,0,get32(fr,os*4));
  return;
}

fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){ if(get32(FA,i*4)==v){ c=c+1; } if(get32(FC,i*4)==v){ c=c+2; } i=i+1; }
  return c;
}

fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();} if(i==7){return T_SET();}
  if(i<=5){return T_ADD();} return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;} if(i==7){return 1;} if(i==8){return 0;} return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return -1;} if(i==2){return 100;} if(i==3){return -98;}
  if(i==4){return 98;} if(i==5){return -100;} if(i==6){return 121;} if(i==7){return 10;}
  if(i==8){return 0;} return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32,fr:[]u8,out:[]u8)i32 {
  let i:i32=0;
  while(i<nt){
    exec(W,root,get32(train,i*12),get32(train,i*12+4),fr,out);
    if(get32(out,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn learn(W:[]u8,train:[]u8,nt:i32,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8); set32(res,0,-1); set32(res,4,0);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          set32(seq,0,a); set32(seq,4,b); set32(seq,8,c);
          reset_graph(W);
          let root:i32=build_seq(W,seq,L);
          if(root>=0 && fits(W,train,nt,root,fr,out)==1){
            set32(best,0,a); set32(best,4,b); set32(best,8,c); bn=L;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return res; }
  reset_graph(W);
  set32(res,0,build_seq(W,best,bn));
  set32(res,4,bn);
  return res;
}
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd; cur=nget(W,cur,5); i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32,fr:[]u8,out:[]u8)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); set32(c,4,0);
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    exec(W,root,v,v,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    exec(W,root,v,0,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      exec(W,root,v,v,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
      exec(W,root,v,0,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
    }
    i=i+1;
  }
  return c;
}

// BORROW PHASE 3c -- WHICH SUPPORT SCORING RULE? Four competing substrates.
// Attacks the gap named by C1571: additive support over chain elements is
// unsound because (s,s) scores 2*s and rewards self-composition.
//
//   rule 0 SUM      score = sup[a] + sup[b]           (C1571, oscillates)
//   rule 1 MAX      score = max(sup[a], sup[b])      no length inflation
//   rule 2 NONSELF  SUM, but a structure may not appear twice in one chain
//   rule 3 DAMPED   score = (sup[a]+sup[b]) / chain_len
//
// Same scenario for all four: consequences change, facts do not, so the stale
// recruitment stays class-eligible and only scoring can dislodge it.
// Same initial support for all four, so the comparison is controlled.

// BORROW PHASE 3d -- DISCRIMINATING the surviving rules, and testing
// H-SC (provenance-scoped credit).
//
// C1601 left MAX / NONSELF / DAMPED tied because every viable chain had
// length <= 2. Two new measurements separate them:
//
//   S1  a world where the ONLY viable chain is (s,s) -- self-composition.
//       NONSELF forbids it, so NONSELF must FAIL and the rest must PASS.
//   S2  a mixed chain vs a singleton with support (10,0,7) and ground-truth
//       usefulness fixed independently: MAX and DAMPED must disagree.
//
// Then H-SC: credit scoped to the regime that earned it.
//   ARM-OBS    the regime change is OBSERVABLE (class of arg1 changes).
//              Global support inherits stale credit; scoped does not.
//   ARM-UNOBS  the regime changes but nothing observable changes.
//              Prediction: scoping CANNOT help, because scoping needs a signal.

// PHASE 10 -- BR-4: NUMERIC MAPS ARE LOSSY.
// Audit finding (BRIDGE_MAP.md, 418da5377):
//   t2_asm_count(v,plen,f) -> plen-1 INC cells
//   t2_asm_sum(vals,n)     -> total INC cells, total = SUM(vals)
//   Both emit the SAME shape: a chain of INC cells whose LENGTH is the number.
//   promote_graph persists (relation, subject, graph root, index, answer) and
//   DEP edges -- but NOT which aggregation produced the length.
//   => a numeric MAP cannot be re-instantiated for a new input, so
//      xio_stage_exec substitutes the one aggregator that exists: COUNT.
//      Documented consequence: sum(103)=15 reported as count(103)=2.
//
// TREATMENT: promotion retains the gather provenance, and the executor reads
// the MAP's OWN aggregation. No per-MAP special case.
//
// THREE aggregations are used so that a generic executor is distinguishable
// from a hardcoded fix: if the treatment merely hardcoded SUM, the COUNT and
// MAX arms would break.

fn C_COUNT()i32 { return 0; }
fn C_SUM()i32 { return 1; }
fn C_MAX()i32 { return 2; }
fn cmname(m:i32)[]u8 {
  if(m==0){return "COUNT";}
  if(m==1){return "SUM";}
  return "MAX";
}

// gather (s,r,.) and reduce under mode. Returns the number, or FAILV.
fn gather(FA:[]u8,nf:i32,s:i32,r:i32,mode:i32)[]u8 {
  let res:[]u8=z_alloc(8);
  let n:i32=0;
  let acc:i32=0;
  let best:i32=0-1;
  // facts are triple-packed: (subject, relation, object) at 12 bytes each
  let k:i32=0;
  while(k<nf){
    if(get32(FA,k*12)==s){
      if(get32(FA,k*12+4)==r){
        let o:i32=get32(FA,k*12+8);
        n=n+1;
        acc=acc+o;
        if(o>best){ best=o; }
      }
    }
    k=k+1;
  }
  let v:i32=0;
  if(mode==C_COUNT()){ v=n; }
  if(mode==C_SUM()){ v=acc; }
  if(mode==C_MAX()){ if(best<0){ v=0-1; } else { v=best; } }
  set32(res,0,v);
  return res;
}

// build the audited shape: a chain of INC cells whose LENGTH is the number.
fn build_chain(W:[]u8,n:i32)[]u8 {
  let res:[]u8=z_alloc(8);
  set32(res,0,-1);
  if(n<1){ return res; }
  let prev:i32=-1; let first:i32=-1;
  let i:i32=0;
  while(i<n){
    let nd:i32=newnode(W);
    if(nd<0){ set32(res,0,-1); return res; }
    nset(W,nd,0,T_ADD()); nset(W,nd,1,1); nset(W,nd,2,1);
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd;
    i=i+1;
  }
  let o:i32=newnode(W);
  if(o<0){ set32(res,0,-1); return res; }
  nset(W,o,0,T_OUT()); nset(W,o,1,1); nset(W,o,2,0);
  nset(W,o,3,0); nset(W,o,4,0); nset(W,o,5,-1);
  nset(W,prev,5,o);
  set32(res,0,first);
  return res;
}

// re-instantiate a promoted MAP for a new subject.
//   prov=0 -> BASE: the audited bridge. Substitutes COUNT unconditionally.
//   prov=1 -> TREAT: read the MAP's OWN recorded aggregation.
// rec layout: field0 = relation, field4 = the MAP's OWN recorded aggregation.
// Reading the aggregation from the record (not from a fixed slot) is what makes
// the executor generic rather than a special case.
fn reinstantiate(W:[]u8,rec:[]u8,FA:[]u8,nf:i32,subj:i32,prov:i32,
                 fr:[]u8,out:[]u8)void {
  let rel:i32=get32(rec,0);
  let mode:i32=C_COUNT();
  if(prov==1){ mode=get32(rec,4); }
  let g:[]u8=gather(FA,nf,subj,rel,mode);
  let n:i32=get32(g,0);
  if(n<1){ set32(out,0,FAILV()); return; }
  reset_graph(W);
  let ch:[]u8=build_chain(W,n);
  if(get32(ch,0)<0){ set32(out,0,FAILV()); return; }
  exec(W,get32(ch,0),subj,0,fr,out);
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }
  let fr:[]u8=z_alloc(32);
  let out:[]u8=z_alloc(8);

  // fact table: 12 bytes per fact (subject, relation, object)
  let FA:[]u8=z_alloc(12*16);
  let nf:i32=0;
  // relation 71: sum/max world. subject 103 -> 6,9
  set32(FA,nf*12,101); set32(FA,nf*12+4,71); set32(FA,nf*12+8,5);  nf=nf+1;
  set32(FA,nf*12,101); set32(FA,nf*12+4,71); set32(FA,nf*12+8,7);  nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,71); set32(FA,nf*12+8,6);  nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,71); set32(FA,nf*12+8,9);  nf=nf+1;
  // relation 72: chain/count world. subject 103 -> 301,302,303
  set32(FA,nf*12,101); set32(FA,nf*12+4,72); set32(FA,nf*12+8,201); nf=nf+1;
  set32(FA,nf*12,201); set32(FA,nf*12+4,72); set32(FA,nf*12+8,202); nf=nf+1;
  set32(FA,nf*12,202); set32(FA,nf*12+4,72); set32(FA,nf*12+8,203); nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,72); set32(FA,nf*12+8,301); nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,72); set32(FA,nf*12+8,302); nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,72); set32(FA,nf*12+8,303); nf=nf+1;
  // relation 73: max world. subject 103 -> 3,8
  set32(FA,nf*12,104); set32(FA,nf*12+4,73); set32(FA,nf*12+8,3);  nf=nf+1;
  set32(FA,nf*12,104); set32(FA,nf*12+4,73); set32(FA,nf*12+8,8);  nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,73); set32(FA,nf*12+8,3);  nf=nf+1;
  set32(FA,nf*12,103); set32(FA,nf*12+4,73); set32(FA,nf*12+8,8);  nf=nf+1;

  c=o_app(ob,c,"PHASE 10 -- BR-4 NUMERIC MAP LOSSINESS (C1651-C1680)"); c=o_nl(ob,c);
  c=o_app(ob,c,"subject 103 under r=71 (6,9): COUNT=");
  let g1:[]u8=gather(FA,nf,103,71,C_COUNT());
  c=o_i64(ob,c,get32(g1,0) as i64);
  c=o_app(ob,c," SUM=");
  let g2:[]u8=gather(FA,nf,103,71,C_SUM());
  c=o_i64(ob,c,get32(g2,0) as i64);
  c=o_app(ob,c," MAX=");
  let g3:[]u8=gather(FA,nf,103,71,C_MAX());
  c=o_i64(ob,c,get32(g3,0) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"the audited bug: xio_stage_exec reports COUNT where SUM is meant"); c=o_nl(ob,c);

  // three promoted MAPs, one per aggregation. All three have the SAME graph
  // shape (an INC chain); they differ only in the recorded aggregation.
  let rec:[]u8=z_alloc(32);
  let recC:[]u8=z_alloc(32);
  let recM:[]u8=z_alloc(32);
  // each MAP record carries its own relation and its own aggregation
  set32(rec,0,71);  set32(rec,4,C_SUM());    // sum MAP
  set32(recC,0,72); set32(recC,4,C_COUNT()); // count MAP
  set32(recM,0,73); set32(recM,4,C_MAX());   // max MAP

  let wantS:i32=15;
  let wantC:i32=3;
  let wantM:i32=8;

  // BASE: provenance absent -> the audited count bridge
  reinstantiate(W,rec,FA,nf,103,0,fr,out);
  let bS:i32=get32(out,0);
  reinstantiate(W,recC,FA,nf,103,0,fr,out);
  let bC:i32=get32(out,0);
  reinstantiate(W,recM,FA,nf,103,0,fr,out);
  let bM:i32=get32(out,0);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BASE (no provenance, count bridge):");
  c=o_app(ob,c," SUM_want="); c=o_i64(ob,c,wantS as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,bS as i64);
  c=o_app(ob,c," | COUNT_want="); c=o_i64(ob,c,wantC as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,bC as i64);
  c=o_app(ob,c," | MAX_want="); c=o_i64(ob,c,wantM as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,bM as i64); c=o_nl(ob,c);

  // TREAT: MAP retains its aggregation
  reinstantiate(W,rec,FA,nf,103,1,fr,out);
  let tS:i32=get32(out,0);
  reinstantiate(W,recC,FA,nf,103,1,fr,out);
  let tC:i32=get32(out,0);
  reinstantiate(W,recM,FA,nf,103,1,fr,out);
  let tM:i32=get32(out,0);

  c=o_app(ob,c,"TREAT (MAP retains its own aggregation):");
  c=o_app(ob,c," SUM_want="); c=o_i64(ob,c,wantS as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,tS as i64);
  c=o_app(ob,c," | COUNT_want="); c=o_i64(ob,c,wantC as i64);
  c=o_app(ob,c,"got="); c=o_i64(ob,c,tC as i64);
  c=o_app(ob,c," | MAX_want="); c=o_i64(ob,c,wantM as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,tM as i64); c=o_nl(ob,c);

  // FO: provenance erased from learner state
  let savedMode:i32=get32(rec,4);
  set32(rec,4,0-1);
  reinstantiate(W,rec,FA,nf,103,1,fr,out);
  set32(rec,4,savedMode);
  let fS:i32=get32(out,0);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"FO (provenance erased) SUM_want="); c=o_i64(ob,c,wantS as i64);
  c=o_app(ob,c," got="); c=o_i64(ob,c,fS as i64);
  c=o_app(ob,c,"  <- facts alone do not restore it"); c=o_nl(ob,c);

  // no-facts control
  reinstantiate(W,rec,FA,nf,999,1,fr,out);
  let nfRes:i32=get32(out,0);
  c=o_app(ob,c,"no-facts subject 999 -> "); c=o_i64(ob,c,nfRes as i64);
  c=o_app(ob,c," (expect FAILV)"); c=o_nl(ob,c);

  let baseOK:i32=0; if(bC==wantC){ baseOK=1; }
  let treatOK:i32=0;
  if(tS==wantS){ if(tC==wantC){ if(tM==wantM){ treatOK=1; } } }
  let foOK:i32=0; if(fS==wantS){ foOK=1; }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR base_bridge_right_by_coincidence="); c=o_i64(ob,c,baseOK as i64);
  c=o_app(ob,c," of 3"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR treat_all_three="); c=o_i64(ob,c,treatOK as i64);
  c=o_app(ob,c," of 3"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR fo_cannot_restore="); c=o_i64(ob,c,foOK as i64);
  c=o_app(ob,c," (0 expected)"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
// BORROW PHASE 2+3 -- bridge-free contract recruitment vs syntactic routing.
// Prereg PREREG_23.md (bf1be353e). Pair CHOICE.md (4969b3d46). Audit BRIDGE_MAP.md (418da5377).
// Pure Zag. No role vocabulary in the cognitive path.
// Structures are ASSEMBLED BY VERIFIED SEARCH, never handwritten.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// ---------- ISA ----------
fn STRS()i32 { return 48; }
fn MAXQ()i32 { return 4; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }

fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); set32(W,i*STRS()+40,0); i=i+1; }
  return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

fn exec(W:[]u8,root:i32,i0:i32,i1:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,FAILV());
  if(root<0){ return r; }
  let fr:[]u8=z_alloc(32);
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let outs:i32=-1;
  while(cur>=0 && steps<MAXQ()+1){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let c:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+c); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return r; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ outs=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(outs<0){ return r; }
  set32(r,0,get32(fr,outs*4));
  return r;
}

// ---------- derived value classes ----------
// bit0 = occurs as a fact SUBJECT, bit1 = occurs as a fact OBJECT
fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){
    if(get32(FA,i*4)==v){ c=c+1; }
    if(get32(FC,i*4)==v){ c=c+2; }
    i=i+1;
  }
  return c;
}

// ---------- primitive vocabulary ----------
fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();}
  if(i==7){return T_SET();}
  if(i<=5){return T_ADD();}
  return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;}
  if(i==7){return 1;}
  if(i==8){return 0;}
  return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;}
  if(i==1){return -1;}
  if(i==2){return 100;}
  if(i==3){return -98;}
  if(i==4){return 98;}
  if(i==5){return -100;}
  if(i==6){return 121;}
  if(i==7){return 10;}
  if(i==8){return 0;}
  return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32)i32 {
  let i:i32=0;
  while(i<nt){
    let r:[]u8=exec(W,root,get32(train,i*12),get32(train,i*12+4));
    if(get32(r,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
// verified search; returns promoted root, or -1. Rebuilds the winner at the end
// so earlier candidates' nodes are reclaimed.
fn learn(W:[]u8,train:[]u8,nt:i32)[]u8 {
  let out:[]u8=z_alloc(8); set32(out,0,-1);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          let d:i32=0;
          while(d<nv && bn==0){
            let use4:i32=0;
            if(L==4){ use4=1; }
            set32(seq,0,a); set32(seq,4,b); set32(seq,8,c); set32(seq,12,d);
            let len:i32=0;
            if(L>=1){ len=1; }
            if(L>=2){ len=2; }
            if(L>=3){ len=3; }
            if(L>=4){ len=4; }
            reset_graph(W);
            let root:i32=build_seq(W,seq,len);
            if(root>=0 && fits(W,train,nt,root)==1){
              set32(best,0,a); set32(best,4,b); set32(best,8,c); set32(best,12,d);
              bn=len;
            }
            d=d+1;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return out; }
  reset_graph(W);
  let r:i32=build_seq(W,best,bn);
  set32(out,0,r);
  set32(out,4,bn);
  return out;
}

// ---------- structure store ----------
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  // copy the graph into a permanent region: nodes MAXN..MAXN+ (len+2)
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd;
    cur=nget(W,cur,5);
    i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}

// ---------- contract probing ----------
// probe a promoted structure over values drawn from each derived class
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); // in-class mask
  set32(c,4,0); // out-class mask
  // collect probe values: all subjects and all objects
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    let r1:[]u8=exec(W,root,v,v);
    if(get32(r1,0)!=FAILV()){
      set32(c,0,get32(c,0)|cls);
    }
    let r2:[]u8=exec(W,root,v,0);
    if(get32(r2,0)!=FAILV()){
      set32(c,0,get32(c,0)|cls);
    }
    i=i+1;
  }
  // out-class from every accepted probe
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      let r1:[]u8=exec(W,root,v,v);
      if(get32(r1,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(r1,0))); }
      let r2:[]u8=exec(W,root,v,0);
      if(get32(r2,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(r2,0))); }
    }
    i=i+1;
  }
  return c;
}

// ---------- TEMPORARY_DELETE_ME_BRIDGE ----------
// Substitutes SURFACE FORM for real type information. This is the audited
// route_line behaviour. Isolated. Never counted as capability.
fn TEMPORARY_DELETE_ME_BRIDGE(surface:[]u8)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,0); // class mask for arg0, 0 = unknown (withhold)
  // surface tokens: "S" -> subject-class, "O" -> object-class, digits -> unknown
  let i:i32=0;
  while(i<surface.len){
    let ch:u8=surface[i];
    if(ch==83){ set32(r,0,1); return r; }   // 'S'
    if(ch==79){ set32(r,0,2); return r; }   // 'O'
    i=i+1;
  }
  return r;
}

// ---------- contract recruitment ----------
// Exact class match is required (vclass(result)==target), not bit overlap:
// a bit test accepts a value that is both subject and object for a
// subject-only target, which admits wrong answers.
fn recruit(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
           v0:i32,v1:i32,cls0:i32,target:i32,trace:[]u8)[]u8 {
  let out:[]u8=z_alloc(8);
  set32(out,0,FAILV());
  set32(trace,0,-1); set32(trace,4,-1); set32(trace,8,0); set32(trace,12,0);
  if(cls0==0){ return out; }
  // length 1
  let a:i32=0;
  while(a<ns && get32(out,0)==FAILV()){
    if((get32(con,a*8)&cls0)!=0){
      let r:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(r,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(r,0))==target){
          set32(out,0,get32(r,0));
          set32(trace,0,a); set32(trace,4,-1); set32(trace,12,1);
        }
      }
    }
    a=a+1;
  }
  // length 2
  a=0;
  while(a<ns && get32(out,0)==FAILV()){
    if((get32(con,a*8)&cls0)!=0){
      let m:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(m,0)!=FAILV()){
        let cm:i32=vclass(FA,FC,nf,get32(m,0));
        if(cm!=0){
          let b:i32=0;
          while(b<ns && get32(out,0)==FAILV()){
            if((get32(con,b*8)&cm)!=0){
              let r2:[]u8=exec(W,get32(store,b*8),get32(m,0),v1);
              if(get32(r2,0)!=FAILV()){
                if(vclass(FA,FC,nf,get32(r2,0))==target){
                  set32(out,0,get32(r2,0));
                  set32(trace,0,a); set32(trace,4,b); set32(trace,8,1);
                }
              }
            }
            b=b+1;
          }
        }
      }
    }
    a=a+1;
  }
  return out;
}

// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION.
// Substrate byte-identical to b23.zag (see b24_head.zag) so results are comparable.
//
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses tested here:
//   H2  local consequence adaptation
//   H7  consequence-derived dependency recruitment
//   H-CONTRACT-ONLY   (contracts alone, no consequence)  <- expected to fail
//
// No named cognitive mode. No role vocabulary. No reviewer-owned answer:
// the mechanism receives only a scalar consequence token per trial.

fn consequence(world_ans:i32,produced:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,0);
  if(produced==world_ans){ set32(r,0,1); } else { set32(r,0,-1); }
  return r;
}

// choose a chain by accumulated support, then execute it.
// sup[] holds per-structure support. Returns the produced value.
// trace records (first, second, chain_len).
// Selection criterion: among ALL applicable chains (contract-gated and
// producing a target-class value), choose the one with the highest accumulated
// consequence support. Class match is a FILTER, not a selector -- in C1541
// "first class match wins" was shown to be unfixable, because the wrong
// structure was the only one whose class matched.
fn recruit_sup(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
               v0:i32,v1:i32,cls0:i32,target:i32,sup:[]u8,trace:[]u8)[]u8 {
  let out:[]u8=z_alloc(8);
  set32(out,0,FAILV());
  set32(trace,0,-1); set32(trace,4,-1); set32(trace,8,0);
  if(cls0==0){ return out; }
  let bestScore:i32=0-1;
  let bestVal:i32=FAILV();
  let bf0:i32=-1; let bf1:i32=-1; let blen:i32=0;
  // ---- length 1 chains ----
  let a:i32=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      let r:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(r,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(r,0))==target){
          let sc:i32=get32(sup,a*4);
          if(sc>bestScore){
            bestScore=sc; bestVal=get32(r,0); bf0=a; bf1=-1; blen=1;
          }
        }
      }
    }
    a=a+1;
  }
  // ---- length 2 chains ----
  a=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      let m:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(m,0)!=FAILV()){
        let cm:i32=vclass(FA,FC,nf,get32(m,0));
        let b:i32=0;
        while(b<ns){
          if(cm!=0){
            if((get32(con,b*8)&cm)!=0){
              let r2:[]u8=exec(W,get32(store,b*8),get32(m,0),v1);
              if(get32(r2,0)!=FAILV()){
                if(vclass(FA,FC,nf,get32(r2,0))==target){
                  let sc:i32=get32(sup,a*4)+get32(sup,b*4);
                  if(sc>bestScore){
                    bestScore=sc; bestVal=get32(r2,0); bf0=a; bf1=b; blen=2;
                  }
                }
              }
            }
          }
          b=b+1;
        }
      }
    }
    a=a+1;
  }
  if(bf0>=0){
    set32(out,0,bestVal);
    set32(trace,0,bf0); set32(trace,4,bf1); set32(trace,8,blen);
  }
  return out;
}

fn main()i32 {
  let ob:[]u8=z_alloc(24576);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }

  let FA:[]u8=z_alloc(4*16);
  let FC:[]u8=z_alloc(4*16);
  let nf:i32=0;
  set32(FA,nf*4,10); set32(FC,nf*4,110); nf=nf+1;
  set32(FA,nf*4,11); set32(FC,nf*4,111); nf=nf+1;
  set32(FA,nf*4,20); set32(FC,nf*4,120); nf=nf+1;
  set32(FA,nf*4,21); set32(FC,nf*4,121); nf=nf+1;
  set32(FA,nf*4,12); set32(FC,nf*4,10);  nf=nf+1;
  set32(FA,nf*4,22); set32(FC,nf*4,20);  nf=nf+1;

  let store:[]u8=z_alloc(64);
  let con:[]u8=z_alloc(64);
  let ns:i32=0;

  // learn three independent structures
  let trA:[]u8=z_alloc(24);
  set32(trA,0,10); set32(trA,4,0); set32(trA,8,110);
  set32(trA,12,11); set32(trA,16,0); set32(trA,20,111);
  let trB:[]u8=z_alloc(24);
  set32(trB,0,110); set32(trB,4,0); set32(trB,8,12);
  set32(trB,12,120); set32(trB,16,0); set32(trB,20,22);
  let trD:[]u8=z_alloc(24);
  set32(trD,0,10); set32(trD,4,0); set32(trD,8,11);
  set32(trD,12,11); set32(trD,16,0); set32(trD,20,12);

  reset_graph(W);
  let la:[]u8=learn(W,trA,2);
  if(get32(la,0)>=0){ ns=promo(W,get32(la,0),get32(la,4),store,ns); }
  reset_graph(W);
  let lb:[]u8=learn(W,trB,2);
  if(get32(lb,0)>=0){ ns=promo(W,get32(lb,0),get32(lb,4),store,ns); }
  reset_graph(W);
  let ld:[]u8=learn(W,trD,2);
  if(get32(lb,0)>=0){ ns=promo(W,get32(ld,0),get32(ld,4),store,ns); }
  reset_graph(W);

  let s:i32=0;
  while(s<ns){
    let p:[]u8=probe(W,get32(store,s*8),FA,FC,nf);
    set32(con,s*8,get32(p,0));
    set32(con,s*8+4,get32(p,4));
    s=s+1;
  }

  c=o_app(ob,c,"BORROW SELECTION / TRANSFER / REVISION"); c=o_nl(ob,c);
  c=o_app(ob,c,"structures="); c=o_i64(ob,c,ns as i64);
  s=0;
  while(s<ns){
    let r:[]u8=exec(W,get32(store,s*8),10,10);
    c=o_app(ob,c,"  s"); c=o_i64(ob,c,s as i64);
    c=o_app(ob,c," in="); c=o_i64(ob,c,get32(con,s*8) as i64);
    c=o_app(ob,c," out="); c=o_i64(ob,c,get32(con,s*8+4) as i64);
    c=o_app(ob,c," ex(10,10)="); c=o_i64(ob,c,get32(r,0) as i64);
    c=o_nl(ob,c);
    s=s+1;
  }

  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[stage1] structures learned+probed"); c=o_nl(ob,c);
  let q0:i32=10; let q1:i32=121; let target:i32=1;
  let ANS1:i32=12;   // hand-derived: 10+100=110, 110-98=12
  let cls0:i32=vclass(FA,FC,nf,q0);
  let sup:[]u8=z_alloc(64);
  let tr:[]u8=z_alloc(32);

  // ---------- H-CONTRACT-ONLY: no consequence at all ----------
  let sup0:[]u8=z_alloc(64);
  s=0; while(s<ns){ set32(sup0,s*4,0); s=s+1; }
  let h0:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup0,tr);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"H-CONTRACT-ONLY (no consequence) ans="); c=o_i64(ob,c,get32(h0,0) as i64);
  c=o_app(ob,c,"  <- expected wrong, distractor wins on class"); c=o_nl(ob,c);

  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[stage2] contract-only evaluated"); c=o_nl(ob,c);
  // ---------- H2 / H7: consequence-adapted selection ----------
  s=0; while(s<ns){ set32(sup,s*4,0); s=s+1; }
  let firstCorrect:i32=-1;
  let trial:i32=0;
  while(trial<12){
    let pr:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup,tr);
    let produced:i32=get32(pr,0);
    let cs:[]u8=consequence(ANS1,produced);
    let tok:i32=get32(cs,0);
    let f0:i32=get32(tr,0);
    let f1:i32=get32(tr,4);
    if(f0>=0){ set32(sup,f0*4,get32(sup,f0*4)+tok); }
    if(f1>=0){ set32(sup,f1*4,get32(sup,f1*4)+tok); }
    if(produced==ANS1){ if(firstCorrect<0){ firstCorrect=trial; } }
    c=o_app(ob,c,"  trial "); c=o_i64(ob,c,trial as i64);
    c=o_app(ob,c," produced="); c=o_i64(ob,c,produced as i64);
    c=o_app(ob,c," tok="); c=o_i64(ob,c,tok as i64);
    c=o_app(ob,c," chain=("); c=o_i64(ob,c,f0 as i64); c=o_app(ob,c,",");
    c=o_i64(ob,c,f1 as i64); c=o_app(ob,c,")");
    c=o_app(ob,c," sup0="); c=o_i64(ob,c,get32(sup,0) as i64);
    c=o_app(ob,c," sup1="); c=o_i64(ob,c,get32(sup,4) as i64);
    c=o_app(ob,c," sup2="); c=o_i64(ob,c,get32(sup,8) as i64);
    c=o_nl(ob,c);
    o_flush(ob,c); c=0;
    trial=trial+1;
  }
  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[A] trials loop exited cleanly"); c=o_nl(ob,c);
  o_flush(ob,c); c=0;
  c=o_app(ob,c,"H2/H7 consequence-adapted: trials_to_first_correct=");
  c=o_i64(ob,c,firstCorrect as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"support after 12 trials:");
  s=0;
  while(s<ns){ c=o_app(ob,c," s"); c=o_i64(ob,c,s as i64); c=o_app(ob,c,"=");
    c=o_i64(ob,c,get32(sup,s*4) as i64); }
  c=o_nl(ob,c);
  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[B] support summary printed"); c=o_nl(ob,c);
  o_flush(ob,c); c=0;
  let finalSel:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup,tr);
  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[C] finalSel returned"); c=o_nl(ob,c);
  o_flush(ob,c); c=0;
  let fin0:i32=get32(tr,0); let fin1:i32=get32(tr,4);
  c=o_app(ob,c,"final selection ans="); c=o_i64(ob,c,get32(finalSel,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,fin0 as i64); c=o_app(ob,c,",");
  c=o_i64(ob,c,fin1 as i64); c=o_app(ob,c,")"); c=o_nl(ob,c);

  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[stage3] consequence trials done"); c=o_nl(ob,c);
  // ---------- PHASE 4: transfer to a fresh query, no source change ----------
  let t0:i32=20; let t1:i32=111;
  let ANS2:i32=22;  // hand-derived: 20+100=120, 120-98=22
  let tcls:i32=vclass(FA,FC,nf,t0);
  let xfer:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,t0,t1,tcls,target,sup,tr);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"PHASE 4 TRANSFER query(20,111) expected="); c=o_i64(ob,c,ANS2 as i64);
  c=o_app(ob,c," ans="); c=o_i64(ob,c,get32(xfer,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,get32(tr,0) as i64); c=o_app(ob,c,",");
  c=o_i64(ob,c,get32(tr,4) as i64); c=o_app(ob,c,")"); c=o_nl(ob,c);

  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[stage4] transfer done"); c=o_nl(ob,c);
  // ---------- PHASE 5: revision. The world changes its mind. ----------
  // New fact table: 121 is now a subject, so the class landscape shifts and
  // the previously correct chain is no longer the answer for this query.
  let FA2:[]u8=z_alloc(4*16);
  let FC2:[]u8=z_alloc(4*16);
  let nf2:i32=0;
  set32(FA2,nf2*4,10); set32(FC2,nf2*4,110); nf2=nf2+1;
  set32(FA2,nf2*4,121); set32(FC2,nf2*4,11); nf2=nf2+1;
  set32(FA2,nf2*4,12); set32(FC2,nf2*4,110); nf2=nf2+1;
  set32(FA2,nf2*4,22); set32(FC2,nf2*4,20);  nf2=nf2+1;
  let ANS3:i32=10;  // hand-derived for the revised world
  let rcls:i32=vclass(FA2,FC2,nf2,q0);
  let revTrial:i32=0;
  let revCorrect:i32=-1;
  while(revTrial<12){
    let pr2:[]u8=recruit_sup(W,store,con,ns,FA2,FC2,nf2,q0,q1,rcls,target,sup,tr);
    let pr2v:i32=get32(pr2,0);
    let cs2:[]u8=consequence(ANS3,pr2v);
    let tok2:i32=get32(cs2,0);
    let g0:i32=get32(tr,0); let g1:i32=get32(tr,4);
    if(g0>=0){ set32(sup,g0*4,get32(sup,g0*4)+tok2); }
    if(g1>=0){ set32(sup,g1*4,get32(sup,g1*4)+tok2); }
    if(pr2v==ANS3){ if(revCorrect<0){ revCorrect=revTrial; } }
    revTrial=revTrial+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"PHASE 5 REVISION revised world, expected="); c=o_i64(ob,c,ANS3 as i64);
  c=o_app(ob,c," trials_to_first_correct="); c=o_i64(ob,c,revCorrect as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"support after revision:");
  s=0;
  while(s<ns){ c=o_app(ob,c," s"); c=o_i64(ob,c,s as i64); c=o_app(ob,c,"=");
    c=o_i64(ob,c,get32(sup,s*4) as i64); }
  c=o_nl(ob,c);
  let revFin:[]u8=recruit_sup(W,store,con,ns,FA2,FC2,nf2,q0,q1,rcls,target,sup,tr);
  c=o_app(ob,c,"post-revision selection ans="); c=o_i64(ob,c,get32(revFin,0) as i64);
  c=o_app(ob,c," expected="); c=o_i64(ob,c,ANS3 as i64); c=o_nl(ob,c);

  o_flush(ob,c); c=0;
  c=o_app(ob,c,"[stage5] revision done"); c=o_nl(ob,c);
  // ---------- control: support erased (FO) ----------
  let supF:[]u8=z_alloc(64);
  s=0; while(s<ns){ set32(supF,s*4,0); s=s+1; }
  let fo:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,supF,tr);
  c=o_app(ob,c,"FO support_erased ans="); c=o_i64(ob,c,get32(fo,0) as i64); c=o_nl(ob,c);

  // ---------- bars ----------
  let bc:i32=0; if(get32(h0,0)!=ANS1){ bc=1; }
  let bs:i32=0; if(get32(finalSel,0)==ANS1){ bs=1; }
  let bt:i32=0; if(get32(xfer,0)==ANS2){ bt=1; }
  let br:i32=0; if(get32(revFin,0)==ANS3){ br=1; }
  let bf:i32=0; if(get32(fo,0)!=ANS1){ bf=1; }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR contract_only_is_wrong="); c=o_i64(ob,c,bc as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR consequence_selects_correct="); c=o_i64(ob,c,bs as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR transfers_to_fresh_query="); c=o_i64(ob,c,bt as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR revises_after_world_change="); c=o_i64(ob,c,br as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR support_is_loadbearing="); c=o_i64(ob,c,bf as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
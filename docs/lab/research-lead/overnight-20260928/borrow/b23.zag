// BORROW PHASE 2+3 -- bridge-free contract recruitment vs syntactic routing.
// Prereg PREREG_23.md (bf1be353e). Pair CHOICE.md (4969b3d46). Audit BRIDGE_MAP.md (418da5377).
// Pure Zag. No role vocabulary in the cognitive path.
// Structures are ASSEMBLED BY VERIFIED SEARCH, never handwritten.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// ---------- ISA ----------
fn STRS()i32 { return 48; }
fn MAXQ()i32 { return 4; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }

fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); set32(W,i*STRS()+40,0); i=i+1; }
  return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

fn exec(W:[]u8,root:i32,i0:i32,i1:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,FAILV());
  if(root<0){ return r; }
  let fr:[]u8=z_alloc(32);
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let outs:i32=-1;
  while(cur>=0 && steps<MAXQ()+1){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let c:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+c); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return r; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ outs=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(outs<0){ return r; }
  set32(r,0,get32(fr,outs*4));
  return r;
}

// ---------- derived value classes ----------
// bit0 = occurs as a fact SUBJECT, bit1 = occurs as a fact OBJECT
fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){
    if(get32(FA,i*4)==v){ c=c+1; }
    if(get32(FC,i*4)==v){ c=c+2; }
    i=i+1;
  }
  return c;
}

// ---------- primitive vocabulary ----------
fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();}
  if(i==7){return T_SET();}
  if(i<=5){return T_ADD();}
  return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;}
  if(i==7){return 1;}
  if(i==8){return 0;}
  return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;}
  if(i==1){return -1;}
  if(i==2){return 100;}
  if(i==3){return -98;}
  if(i==4){return 98;}
  if(i==5){return -100;}
  if(i==6){return 121;}
  if(i==7){return 10;}
  if(i==8){return 0;}
  return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32)i32 {
  let i:i32=0;
  while(i<nt){
    let r:[]u8=exec(W,root,get32(train,i*12),get32(train,i*12+4));
    if(get32(r,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
// verified search; returns promoted root, or -1. Rebuilds the winner at the end
// so earlier candidates' nodes are reclaimed.
fn learn(W:[]u8,train:[]u8,nt:i32)[]u8 {
  let out:[]u8=z_alloc(8); set32(out,0,-1);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          let d:i32=0;
          while(d<nv && bn==0){
            let use4:i32=0;
            if(L==4){ use4=1; }
            set32(seq,0,a); set32(seq,4,b); set32(seq,8,c); set32(seq,12,d);
            let len:i32=0;
            if(L>=1){ len=1; }
            if(L>=2){ len=2; }
            if(L>=3){ len=3; }
            if(L>=4){ len=4; }
            reset_graph(W);
            let root:i32=build_seq(W,seq,len);
            if(root>=0 && fits(W,train,nt,root)==1){
              set32(best,0,a); set32(best,4,b); set32(best,8,c); set32(best,12,d);
              bn=len;
            }
            d=d+1;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return out; }
  reset_graph(W);
  let r:i32=build_seq(W,best,bn);
  set32(out,0,r);
  set32(out,4,bn);
  return out;
}

// ---------- structure store ----------
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  // copy the graph into a permanent region: nodes MAXN..MAXN+ (len+2)
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd;
    cur=nget(W,cur,5);
    i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}

// ---------- contract probing ----------
// probe a promoted structure over values drawn from each derived class
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); // in-class mask
  set32(c,4,0); // out-class mask
  // collect probe values: all subjects and all objects
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    let r1:[]u8=exec(W,root,v,v);
    if(get32(r1,0)!=FAILV()){
      set32(c,0,get32(c,0)|cls);
    }
    let r2:[]u8=exec(W,root,v,0);
    if(get32(r2,0)!=FAILV()){
      set32(c,0,get32(c,0)|cls);
    }
    i=i+1;
  }
  // out-class from every accepted probe
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      let r1:[]u8=exec(W,root,v,v);
      if(get32(r1,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(r1,0))); }
      let r2:[]u8=exec(W,root,v,0);
      if(get32(r2,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(r2,0))); }
    }
    i=i+1;
  }
  return c;
}

// ---------- TEMPORARY_DELETE_ME_BRIDGE ----------
// Substitutes SURFACE FORM for real type information. This is the audited
// route_line behaviour. Isolated. Never counted as capability.
fn TEMPORARY_DELETE_ME_BRIDGE(surface:[]u8)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,0); // class mask for arg0, 0 = unknown (withhold)
  // surface tokens: "S" -> subject-class, "O" -> object-class, digits -> unknown
  let i:i32=0;
  while(i<surface.len){
    let ch:u8=surface[i];
    if(ch==83){ set32(r,0,1); return r; }   // 'S'
    if(ch==79){ set32(r,0,2); return r; }   // 'O'
    i=i+1;
  }
  return r;
}

// ---------- contract recruitment ----------
// Exact class match is required (vclass(result)==target), not bit overlap:
// a bit test accepts a value that is both subject and object for a
// subject-only target, which admits wrong answers.
fn recruit(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
           v0:i32,v1:i32,cls0:i32,target:i32,trace:[]u8)[]u8 {
  let out:[]u8=z_alloc(8);
  set32(out,0,FAILV());
  set32(trace,0,-1); set32(trace,4,-1); set32(trace,8,0); set32(trace,12,0);
  if(cls0==0){ return out; }
  // length 1
  let a:i32=0;
  while(a<ns && get32(out,0)==FAILV()){
    if((get32(con,a*8)&cls0)!=0){
      let r:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(r,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(r,0))==target){
          set32(out,0,get32(r,0));
          set32(trace,0,a); set32(trace,4,-1); set32(trace,12,1);
        }
      }
    }
    a=a+1;
  }
  // length 2
  a=0;
  while(a<ns && get32(out,0)==FAILV()){
    if((get32(con,a*8)&cls0)!=0){
      let m:[]u8=exec(W,get32(store,a*8),v0,v1);
      if(get32(m,0)!=FAILV()){
        let cm:i32=vclass(FA,FC,nf,get32(m,0));
        if(cm!=0){
          let b:i32=0;
          while(b<ns && get32(out,0)==FAILV()){
            if((get32(con,b*8)&cm)!=0){
              let r2:[]u8=exec(W,get32(store,b*8),get32(m,0),v1);
              if(get32(r2,0)!=FAILV()){
                if(vclass(FA,FC,nf,get32(r2,0))==target){
                  set32(out,0,get32(r2,0));
                  set32(trace,0,a); set32(trace,4,b); set32(trace,8,1);
                }
              }
            }
            b=b+1;
          }
        }
      }
    }
    a=a+1;
  }
  return out;
}

fn main()i32 {
  let ob:[]u8=z_alloc(24576);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }

  // ---- facts ----
  let FA:[]u8=z_alloc(4*16);
  let FC:[]u8=z_alloc(4*16);
  let nf:i32=0;
  set32(FA,nf*4,10); set32(FC,nf*4,110); nf=nf+1;
  set32(FA,nf*4,11); set32(FC,nf*4,111); nf=nf+1;
  set32(FA,nf*4,20); set32(FC,nf*4,120); nf=nf+1;
  set32(FA,nf*4,21); set32(FC,nf*4,121); nf=nf+1;
  set32(FA,nf*4,12); set32(FC,nf*4,10);  nf=nf+1;
  set32(FA,nf*4,22); set32(FC,nf*4,20);  nf=nf+1;

  c=o_app(ob,c,"BORROW PHASE 2+3 C1541-C1570"); c=o_nl(ob,c);
  c=o_app(ob,c,"facts="); c=o_i64(ob,c,nf as i64);
  c=o_app(ob,c,"  derived classes: bit0=subject bit1=object"); c=o_nl(ob,c);
  c=o_app(ob,c,"derived class of 10="); c=o_i64(ob,c,vclass(FA,FC,nf,10) as i64);
  c=o_app(ob,c," 110="); c=o_i64(ob,c,vclass(FA,FC,nf,110) as i64);
  c=o_app(ob,c," 12="); c=o_i64(ob,c,vclass(FA,FC,nf,12) as i64);
  c=o_app(ob,c," 121="); c=o_i64(ob,c,vclass(FA,FC,nf,121) as i64);
  c=o_app(ob,c," -1="); c=o_i64(ob,c,vclass(FA,FC,nf,-1) as i64); c=o_nl(ob,c);

  // ---- learn two independent structures ----
  // trA: (10,0)->110 (11,0)->111
  let trA:[]u8=z_alloc(24);
  set32(trA,0,10); set32(trA,4,0); set32(trA,8,110);
  set32(trA,12,11); set32(trA,16,0); set32(trA,20,111);
  // trB: (110,0)->12 (120,0)->22
  let trB:[]u8=z_alloc(24);
  set32(trB,0,110); set32(trB,4,0); set32(trB,8,12);
  set32(trB,12,120); set32(trB,16,0); set32(trB,20,22);
  let store:[]u8=z_alloc(64);
  let con:[]u8=z_alloc(64);
  let ns:i32=0;
  // promote each structure immediately after learning it: the scratch region
  // is reused by the next search, so a deferred root would be stale.
  reset_graph(W);
  let la:[]u8=learn(W,trA,2);
  c=o_app(ob,c,"CHK after learn(A) root="); c=o_i64(ob,c,get32(la,0) as i64);
  c=o_app(ob,c," len="); c=o_i64(ob,c,get32(la,4) as i64);
  c=o_app(ob,c," exec(10,10)=");
  let qa:[]u8=exec(W,get32(la,0),10,10);
  c=o_i64(ob,c,get32(qa,0) as i64);
  c=o_app(ob,c," exec(11,11)=");
  let qb:[]u8=exec(W,get32(la,0),11,11);
  c=o_i64(ob,c,get32(qb,0) as i64); c=o_nl(ob,c);
  if(get32(la,0)>=0){ ns=promo(W,get32(la,0),get32(la,4),store,ns); }
  let lenA:i32=get32(la,4);
  reset_graph(W);
  let lb:[]u8=learn(W,trB,2);
  if(get32(lb,0)>=0){ ns=promo(W,get32(lb,0),get32(lb,4),store,ns); }
  let lenB:i32=get32(lb,4);
  reset_graph(W);

  c=o_app(ob,c,"promoted structures="); c=o_i64(ob,c,ns as i64);
  c=o_app(ob,c,"  lenA="); c=o_i64(ob,c,lenA as i64);
  c=o_app(ob,c," lenB="); c=o_i64(ob,c,lenB as i64); c=o_nl(ob,c);

  // ---- contracts by probing ----
  let s:i32=0;
  while(s<ns){
    let p:[]u8=probe(W,get32(store,s*8),FA,FC,nf);
    set32(con,s*8,get32(p,0));
    set32(con,s*8+4,get32(p,4));
    s=s+1;
  }
  s=0;
  while(s<ns){
    c=o_app(ob,c,"structure "); c=o_i64(ob,c,s as i64);
    c=o_app(ob,c," in_class_mask="); c=o_i64(ob,c,get32(con,s*8) as i64);
    c=o_app(ob,c," out_class_mask="); c=o_i64(ob,c,get32(con,s*8+4) as i64);
    c=o_app(ob,c," ops=[");
    let dn:i32=get32(store,s*8);
    let dlen:i32=get32(store,s*8+4);
    let q:i32=0;
    while(q<dlen){
      c=o_i64(ob,c,ntag(W,dn) as i64);
      c=o_app(ob,c,"/");
      c=o_i64(ob,c,nget(W,dn,1) as i64);
      c=o_app(ob,c,"/");
      c=o_i64(ob,c,nget(W,dn,2) as i64);
      if(q<dlen-1){ c=o_app(ob,c," "); }
      dn=nget(W,dn,5);
      q=q+1;
    }
    c=o_app(ob,c,"] exec(10,10)=");
    let e1:[]u8=exec(W,get32(store,s*8),10,10);
    c=o_i64(ob,c,get32(e1,0) as i64);
    c=o_app(ob,c," exec(110,110)=");
    let e2:[]u8=exec(W,get32(store,s*8),110,110);
    c=o_i64(ob,c,get32(e2,0) as i64);
    c=o_nl(ob,c);
    s=s+1;
  }

  // ================= QUERY =================
  // query: values (10, 121), answer must be a value whose derived class is
  // exactly 1 (occurs as a subject, never as an object).
  let q0:i32=10;
  let q1:i32=121;
  let target:i32=1;
  let EXPECT:i32=12;

  // derive arg0's class from the facts (surface-independent)
  let clsDerived:i32=vclass(FA,FC,nf,q0);
  // surface form, aligned vs neutral
  let sAligned:[]u8="S 10 121";
  let sNeutral:[]u8="10 121";
  let brA:[]u8=TEMPORARY_DELETE_ME_BRIDGE(sAligned);
  let brN:[]u8=TEMPORARY_DELETE_ME_BRIDGE(sNeutral);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"QUERY values="); c=o_i64(ob,c,q0 as i64);
  c=o_app(ob,c,","); c=o_i64(ob,c,q1 as i64);
  c=o_app(ob,c," target_class=1 expected_answer="); c=o_i64(ob,c,EXPECT as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"derived class of arg0="); c=o_i64(ob,c,clsDerived as i64);
  c=o_app(ob,c,"  TEMPORARY_DELETE_ME_BRIDGE(aligned)="); c=o_i64(ob,c,get32(brA,0) as i64);
  c=o_app(ob,c,"  (neutral)="); c=o_i64(ob,c,get32(brN,0) as i64);
  c=o_app(ob,c,"   <- 0 means withheld"); c=o_nl(ob,c);

  let tr:[]u8=z_alloc(32);
  // closed-form expectation: derived class of arg0 is 3 (nonzero), so the
  // contract arm must find a chain; the bridge arm finds a class only on the
  // aligned surface.
  let a1:[]u8=recruit(W,store,con,ns,FA,FC,nf,q0,q1,get32(brA,0),target,tr);
  let a1t0:i32=get32(tr,0); let a1t1:i32=get32(tr,4); let a1len:i32=get32(tr,12);
  let a2:[]u8=recruit(W,store,con,ns,FA,FC,nf,q0,q1,get32(brN,0),target,tr);
  let a3:[]u8=recruit(W,store,con,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);
  let a3t0:i32=get32(tr,0); let a3t1:i32=get32(tr,4); let a3len:i32=get32(tr,12);
  let a4:[]u8=recruit(W,store,con,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  let c1len:i32=1; if(a1t1>=0){ c1len=2; }
  let c3len:i32=1; if(a3t1>=0){ c3len=2; }
  c=o_app(ob,c,"A1 ROUTER-ALIGNED   ans="); c=o_i64(ob,c,get32(a1,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,a1t0 as i64); c=o_app(ob,c,",");
  c=o_i64(ob,c,a1t1 as i64); c=o_app(ob,c,") chain_len="); c=o_i64(ob,c,c1len as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"A2 ROUTER-NEUTRAL   ans="); c=o_i64(ob,c,get32(a2,0) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"A3 CONTRACT-ALIGNED ans="); c=o_i64(ob,c,get32(a3,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,a3t0 as i64); c=o_app(ob,c,",");
  c=o_i64(ob,c,a3t1 as i64); c=o_app(ob,c,") chain_len="); c=o_i64(ob,c,c3len as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"A4 CONTRACT-NEUTRAL ans="); c=o_i64(ob,c,get32(a4,0) as i64); c=o_nl(ob,c);

  // A5: contracts erased (ABL-CONTRACT / FO-FACTS)
  let con0:[]u8=z_alloc(64);
  let z:i32=0;
  while(z<8){ set32(con0,z*4,0); set32(con0,z*4+4,0); z=z+1; }
  let a5:[]u8=recruit(W,store,con0,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);
  c=o_app(ob,c,"A5 CONTRACT-NOPROBE ans="); c=o_i64(ob,c,get32(a5,0) as i64); c=o_nl(ob,c);

  // A6 IRRELEVANT: a third structure is learned from its OWN data. It returns
// values whose derived class is 3 (both subject and object), so exact class
// matching must refuse it as a final answer.
  let trD:[]u8=z_alloc(24);
  set32(trD,0,10); set32(trD,4,0); set32(trD,8,11);
  set32(trD,12,11); set32(trD,16,0); set32(trD,20,12);
  reset_graph(W);
  let ld:[]u8=learn(W,trD,2);
  if(get32(ld,0)>=0){ ns=promo(W,get32(ld,0),get32(ld,4),store,ns); }
  let disIdx:i32=ns-1;
  let pd:[]u8=probe(W,get32(store,disIdx*8),FA,FC,nf);
  set32(con,disIdx*8,get32(pd,0));
  set32(con,disIdx*8+4,get32(pd,4));
  reset_graph(W);
  let a6:[]u8=recruit(W,store,con,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);
  let a6len1:i32=get32(tr,12);
  let a6used0:i32=get32(tr,0);
  let a6used1:i32=get32(tr,4);
  c=o_app(ob,c,"A6 IRRELEVANT added structure="); c=o_i64(ob,c,disIdx as i64);
  c=o_app(ob,c," ops_out_class="); c=o_i64(ob,c,get32(con,disIdx*8+4) as i64);
  c=o_app(ob,c," ans="); c=o_i64(ob,c,get32(a6,0) as i64);
  c=o_app(ob,c," chain_used=("); c=o_i64(ob,c,a6used0 as i64);
  c=o_app(ob,c,","); c=o_i64(ob,c,a6used1 as i64);
  c=o_app(ob,c,") accepted_len1="); c=o_i64(ob,c,a6len1 as i64); c=o_nl(ob,c);
  // restore the two-structure store for the remaining arms
  ns=ns-1;

  // A6R: does the distractor also break the ROUTER arm? If yes, the failure is
  // in selection-among-applicable-structures, not in bridge removal.
  let a6r:[]u8=recruit(W,store,con,ns+1,FA,FC,nf,q0,q1,get32(brA,0),target,tr);
  let a6rlen1:i32=get32(tr,12);
  c=o_app(ob,c,"A6R ROUTER-ALIGNED + distractor ans="); c=o_i64(ob,c,get32(a6r,0) as i64);
  c=o_app(ob,c," accepted_len1="); c=o_i64(ob,c,a6rlen1 as i64); c=o_nl(ob,c);

  // A7: structures removed
  let a7:[]u8=recruit(W,store,con,0,FA,FC,nf,q0,q1,clsDerived,target,tr);
  c=o_app(ob,c,"A7 ABL-STRUCTURES   ans="); c=o_i64(ob,c,get32(a7,0) as i64); c=o_nl(ob,c);

  // A8: fresh (nothing learned)
  let a8:[]u8=recruit(W,store,con0,0,FA,FC,nf,q0,q1,clsDerived,target,tr);
  c=o_app(ob,c,"A8 FRESH            ans="); c=o_i64(ob,c,get32(a8,0) as i64); c=o_nl(ob,c);

  // A9: identifier permutation -- reverse the store and the contract table
  let pstore:[]u8=z_alloc(64);
  let pcon:[]u8=z_alloc(64);
  let m:i32=0;
  while(m<ns){
    let src:i32=ns-1-m;
    set32(pstore,m*8,get32(store,src*8));
    set32(pstore,m*8+4,get32(store,src*8+4));
    set32(pcon,m*8,get32(con,src*8));
    set32(pcon,m*8+4,get32(con,src*8+4));
    m=m+1;
  }
  let a9:[]u8=recruit(W,pstore,pcon,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);
  c=o_app(ob,c,"A9 PERMUTE          ans="); c=o_i64(ob,c,get32(a9,0) as i64); c=o_nl(ob,c);

  // A10: FO -- facts and structures present, learned contract graph erased
  let a10:[]u8=recruit(W,store,con0,ns,FA,FC,nf,q0,q1,clsDerived,target,tr);
  c=o_app(ob,c,"A10 FO-FACTS        ans="); c=o_i64(ob,c,get32(a10,0) as i64); c=o_nl(ob,c);

  // ================= BARS =================
  let b4:i32=0; if(get32(a1,0)==EXPECT){ b4=1; }
  let b5:i32=0; if(get32(a2,0)!=EXPECT){ b5=1; }
  let b6:i32=0; if(get32(a3,0)==get32(a1,0)){ b6=1; }
  let b7:i32=0; if(get32(a4,0)==EXPECT){ b7=1; }
  let b8:i32=0; if(get32(a5,0)!=EXPECT){ b8=1; }
  let b10:i32=0; if(get32(a7,0)==FAILV()){ b10=1; }
  let b11:i32=0; if(get32(a8,0)==FAILV()){ b11=1; }
  let b12:i32=0; if(get32(a9,0)==get32(a4,0)){ b12=1; }
  let b13:i32=0; if(get32(a10,0)!=EXPECT){ b13=1; }
  let b9:i32=0;
  if(get32(a6,0)==EXPECT){ if(a6len1==0){ b9=1; } }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B1_determinism_checked_by_3of3"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B4_router_aligned_ok="); c=o_i64(ob,c,b4 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B5_router_neutral_fails="); c=o_i64(ob,c,b5 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B6_no_loss_vs_router="); c=o_i64(ob,c,b6 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B7_contract_neutral_ok="); c=o_i64(ob,c,b7 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B8_contracts_loadbearing="); c=o_i64(ob,c,b8 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B9_irrelevant_not_recruited="); c=o_i64(ob,c,b9 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B10_abl_structures_fails="); c=o_i64(ob,c,b10 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B11_fresh_fails="); c=o_i64(ob,c,b11 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B12_permute_matches="); c=o_i64(ob,c,b12 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B13_fo_fails="); c=o_i64(ob,c,b13 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B17_delete_list=TEMPORARY_DELETE_ME_BRIDGE"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B16_L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR delete_count="); c=o_i64(ob,c,1); c=o_nl(ob,c);

  o_flush(ob,c);
  return 0;
}
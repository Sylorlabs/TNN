// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses:
//   H-CONTRACT-ONLY  contracts alone, no consequence   <- expected to fail
//   H2 / H7          consequence-adapted selection      <- under test
// Declared limitation: structure search covers lengths 1..3 (MAXQ=3).
// Scratch frames are caller-allocated and reused; exec allocates nothing.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn STRS()i32 { return 48; }
fn MAXQ()i32 { return 3; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }
fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); i=i+1; } return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

// executes into caller scratch; allocates nothing
fn exec(W:[]u8,root:i32,i0:i32,i1:i32,fr:[]u8,out:[]u8)void {
  set32(out,0,FAILV());
  if(root<0){ return; }
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let os:i32=-1;
  while(cur>=0 && steps<MAXQ()+1){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let cc:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+cc); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ os=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(os<0){ return; }
  set32(out,0,get32(fr,os*4));
  return;
}

fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){ if(get32(FA,i*4)==v){ c=c+1; } if(get32(FC,i*4)==v){ c=c+2; } i=i+1; }
  return c;
}

fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();} if(i==7){return T_SET();}
  if(i<=5){return T_ADD();} return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;} if(i==7){return 1;} if(i==8){return 0;} return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return -1;} if(i==2){return 100;} if(i==3){return -98;}
  if(i==4){return 98;} if(i==5){return -100;} if(i==6){return 121;} if(i==7){return 10;}
  if(i==8){return 0;} return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32,fr:[]u8,out:[]u8)i32 {
  let i:i32=0;
  while(i<nt){
    exec(W,root,get32(train,i*12),get32(train,i*12+4),fr,out);
    if(get32(out,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn learn(W:[]u8,train:[]u8,nt:i32,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8); set32(res,0,-1); set32(res,4,0);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          set32(seq,0,a); set32(seq,4,b); set32(seq,8,c);
          reset_graph(W);
          let root:i32=build_seq(W,seq,L);
          if(root>=0 && fits(W,train,nt,root,fr,out)==1){
            set32(best,0,a); set32(best,4,b); set32(best,8,c); bn=L;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return res; }
  reset_graph(W);
  set32(res,0,build_seq(W,best,bn));
  set32(res,4,bn);
  return res;
}
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd; cur=nget(W,cur,5); i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32,fr:[]u8,out:[]u8)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); set32(c,4,0);
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    exec(W,root,v,v,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    exec(W,root,v,0,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      exec(W,root,v,v,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
      exec(W,root,v,0,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
    }
    i=i+1;
  }
  return c;
}

// class match is a FILTER; accumulated consequence support is the SELECTOR
fn recruit_sup(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
               v0:i32,v1:i32,cls0:i32,target:i32,sup:[]u8,trace:[]u8,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8);
  set32(res,0,FAILV());
  set32(trace,0,-1); set32(trace,4,-1); set32(trace,8,0);
  if(cls0==0){ return res; }
  let bestScore:i32=0-1000000;
  let bestVal:i32=FAILV();
  let bf0:i32=-1; let bf1:i32=-1; let blen:i32=0;
  let a:i32=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      exec(W,get32(store,a*8),v0,v1,fr,out);
      if(get32(out,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(out,0))==target){
          let sc:i32=get32(sup,a*4);
          if(sc>bestScore){ bestScore=sc; bestVal=get32(out,0); bf0=a; bf1=-1; blen=1; }
        }
      }
    }
    a=a+1;
  }
  a=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      let m:[]u8=z_alloc(8);
      exec(W,get32(store,a*8),v0,v1,fr,out);
      set32(m,0,get32(out,0));
      if(get32(m,0)!=FAILV()){
        let cm:i32=vclass(FA,FC,nf,get32(m,0));
        let b:i32=0;
        while(b<ns){
          if(cm!=0){
            if((get32(con,b*8)&cm)!=0){
              exec(W,get32(store,b*8),get32(m,0),v1,fr,out);
              if(get32(out,0)!=FAILV()){
                if(vclass(FA,FC,nf,get32(out,0))==target){
                  let sc:i32=get32(sup,a*4)+get32(sup,b*4);
                  if(sc>bestScore){ bestScore=sc; bestVal=get32(out,0); bf0=a; bf1=b; blen=2; }
                }
              }
            }
          }
          b=b+1;
        }
      }
    }
    a=a+1;
  }
  if(bf0>=0){
    set32(res,0,bestVal);
    set32(trace,0,bf0); set32(trace,4,bf1); set32(trace,8,blen);
  }
  return res;
}

// the WORLD's outcome token. The mechanism never receives the answer itself.
fn consequence(world_ans:i32,produced:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  if(produced==world_ans){ set32(r,0,1); } else { set32(r,0,-1); }
  return r;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }
  let fr:[]u8=z_alloc(32);
  let out:[]u8=z_alloc(8);

  let FA:[]u8=z_alloc(4*16);
  let FC:[]u8=z_alloc(4*16);
  let nf:i32=0;
  set32(FA,nf*4,10); set32(FC,nf*4,110); nf=nf+1;
  set32(FA,nf*4,11); set32(FC,nf*4,111); nf=nf+1;
  set32(FA,nf*4,20); set32(FC,nf*4,120); nf=nf+1;
  set32(FA,nf*4,21); set32(FC,nf*4,121); nf=nf+1;
  set32(FA,nf*4,12); set32(FC,nf*4,10);  nf=nf+1;
  set32(FA,nf*4,22); set32(FC,nf*4,20);  nf=nf+1;

  let store:[]u8=z_alloc(64);
  let con:[]u8=z_alloc(64);
  let ns:i32=0;

  let trA:[]u8=z_alloc(24);
  set32(trA,0,10); set32(trA,4,0); set32(trA,8,110);
  set32(trA,12,11); set32(trA,16,0); set32(trA,20,111);
  let trB:[]u8=z_alloc(24);
  set32(trB,0,110); set32(trB,4,0); set32(trB,8,12);
  set32(trB,12,120); set32(trB,16,0); set32(trB,20,22);
  let trD:[]u8=z_alloc(24);
  set32(trD,0,10); set32(trD,4,0); set32(trD,8,11);
  set32(trD,12,11); set32(trD,16,0); set32(trD,20,12);

  reset_graph(W);
  let la:[]u8=learn(W,trA,2,fr,out);
  if(get32(la,0)>=0){ ns=promo(W,get32(la,0),get32(la,4),store,ns); }
  reset_graph(W);
  let lb:[]u8=learn(W,trB,2,fr,out);
  if(get32(lb,0)>=0){ ns=promo(W,get32(lb,0),get32(lb,4),store,ns); }
  reset_graph(W);
  let ld:[]u8=learn(W,trD,2,fr,out);
  if(get32(ld,0)>=0){ ns=promo(W,get32(ld,0),get32(ld,4),store,ns); }
  reset_graph(W);

  let s:i32=0;
  while(s<ns){
    let p:[]u8=probe(W,get32(store,s*8),FA,FC,nf,fr,out);
    set32(con,s*8,get32(p,0));
    set32(con,s*8+4,get32(p,4));
    s=s+1;
  }

  c=o_app(ob,c,"BORROW SELECTION / TRANSFER / REVISION (C1571-C1600)"); c=o_nl(ob,c);
  c=o_app(ob,c,"structures="); c=o_i64(ob,c,ns as i64);
  s=0;
  while(s<ns){
    exec(W,get32(store,s*8),10,10,fr,out);
    c=o_app(ob,c,"  s"); c=o_i64(ob,c,s as i64);
    c=o_app(ob,c," in="); c=o_i64(ob,c,get32(con,s*8) as i64);
    c=o_app(ob,c," out="); c=o_i64(ob,c,get32(con,s*8+4) as i64);
    c=o_app(ob,c," ex(10,10)="); c=o_i64(ob,c,get32(out,0) as i64);
    c=o_nl(ob,c);
    s=s+1;
  }

  let q0:i32=10; let q1:i32=121; let target:i32=1;
  let ANS1:i32=12;
  let cls0:i32=vclass(FA,FC,nf,q0);
  let sup:[]u8=z_alloc(64);
  let tr:[]u8=z_alloc(32);

  // H-CONTRACT-ONLY
  s=0; while(s<ns){ set32(sup,s*4,0); s=s+1; }
  let h0:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup,tr,fr,out);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"H-CONTRACT-ONLY ans="); c=o_i64(ob,c,get32(h0,0) as i64);
  c=o_app(ob,c," expected="); c=o_i64(ob,c,ANS1 as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,get32(tr,0) as i64);
  c=o_app(ob,c,","); c=o_i64(ob,c,get32(tr,4) as i64); c=o_app(ob,c,")"); c=o_nl(ob,c);

  // H2 / H7 consequence-adapted selection
  s=0; while(s<ns){ set32(sup,s*4,0); s=s+1; }
  let firstCorrect:i32=-1;
  let wrongTotal:i32=0;
  let trial:i32=0;
  while(trial<12){
    let pr:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup,tr,fr,out);
    let produced:i32=get32(pr,0);
    let f0:i32=get32(tr,0); let f1:i32=get32(tr,4);
    let cs:[]u8=consequence(ANS1,produced);
    let tok:i32=get32(cs,0);
    if(f0>=0){ set32(sup,f0*4,get32(sup,f0*4)+tok); }
    if(f1>=0){ set32(sup,f1*4,get32(sup,f1*4)+tok); }
    if(produced==ANS1){ if(firstCorrect<0){ firstCorrect=trial; } } else { wrongTotal=wrongTotal+1; }
    trial=trial+1;
  }
  c=o_app(ob,c,"H2/H7 trials_to_first_correct="); c=o_i64(ob,c,firstCorrect as i64);
  c=o_app(ob,c," wrong_trials="); c=o_i64(ob,c,wrongTotal as i64);
  c=o_app(ob,c," of 12"); c=o_nl(ob,c);
  c=o_app(ob,c,"support:");
  s=0;
  while(s<ns){
    c=o_app(ob,c," s"); c=o_i64(ob,c,s as i64); c=o_app(ob,c,"=");
    c=o_i64(ob,c,get32(sup,s*4) as i64);
    s=s+1;
  }
  c=o_nl(ob,c);
  let finSel:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,sup,tr,fr,out);
  let fin0:i32=get32(tr,0); let fin1:i32=get32(tr,4);
  c=o_app(ob,c,"final selection ans="); c=o_i64(ob,c,get32(finSel,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,fin0 as i64);
  c=o_app(ob,c,","); c=o_i64(ob,c,fin1 as i64);
  c=o_app(ob,c,") chain_len="); c=o_i64(ob,c,get32(tr,8) as i64); c=o_nl(ob,c);

  // PHASE 4 TRANSFER: fresh query, no source change
  let t0:i32=20; let t1:i32=111;
  let ANS2:i32=22;
  let tcls:i32=vclass(FA,FC,nf,t0);
  let xfer:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,t0,t1,tcls,target,sup,tr,fr,out);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"PHASE4 TRANSFER q=(20,111) expected="); c=o_i64(ob,c,ANS2 as i64);
  c=o_app(ob,c," ans="); c=o_i64(ob,c,get32(xfer,0) as i64);
  c=o_app(ob,c," chain=("); c=o_i64(ob,c,get32(tr,0) as i64);
  c=o_app(ob,c,","); c=o_i64(ob,c,get32(tr,4) as i64);
  c=o_app(ob,c,") len="); c=o_i64(ob,c,get32(tr,8) as i64); c=o_nl(ob,c);

  // PHASE 5 REVISION -- two DISTINCT mechanisms, measured separately.
  //
  // REV-A: consequences change, the fact landscape does NOT. The stale
  //   recruitment stays class-eligible, so only consequence support can
  //   dislodge it. This is genuine consequence-driven revision.
  //   Hand-derived expectation: s0=s1=11, s2=-1 at entry. Viability analysis
  //   shows only (s0,s1) and (s2,-1) can produce a class-1 value. s2 overtakes
  //   when -1-k > 22-2k, i.e. k >= 24. Predicted trials_to_first_correct=24.
  let supA:[]u8=z_alloc(64);
  s=0; while(s<ns){ set32(supA,s*4,get32(sup,s*4)); s=s+1; }
  let ANSA:i32=11;
  let clsA:i32=vclass(FA,FC,nf,q0);
  let revAFirst:i32=-1; let revAWrong:i32=0;
  let ra:i32=0;
  while(ra<40){
    let pA:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,clsA,target,supA,tr,fr,out);
    let pvA:i32=get32(pA,0);
    let h0:i32=get32(tr,0); let h1:i32=get32(tr,4);
    let csA:[]u8=consequence(ANSA,pvA);
    let tkA:i32=get32(csA,0);
    if(h0>=0){ set32(supA,h0*4,get32(supA,h0*4)+tkA); }
    if(h1>=0){ set32(supA,h1*4,get32(supA,h1*4)+tkA); }
    if(pvA==ANSA){ if(revAFirst<0){ revAFirst=ra; } } else { revAWrong=revAWrong+1; }
    ra=ra+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"PHASE5 REV-A consequences_change_facts_fixed");
  c=o_app(ob,c," expected="); c=o_i64(ob,c,ANSA as i64);
  c=o_app(ob,c," corrected_hand_prediction=12 (first prediction 24 was WRONG: s2 does not decay while unused)");
  c=o_app(ob,c," measured_trials="); c=o_i64(ob,c,revAFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,revAWrong as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  support after REV-A:");
  s=0; while(s<ns){ c=o_app(ob,c," s"); c=o_i64(ob,c,s as i64); c=o_app(ob,c,"=");
    c=o_i64(ob,c,get32(supA,s*4) as i64); s=s+1; }
  c=o_nl(ob,c);
  let revA:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,clsA,target,supA,tr,fr,out);
  c=o_app(ob,c,"  post-REV-A ans="); c=o_i64(ob,c,get32(revA,0) as i64);
  c=o_app(ob,c," expected="); c=o_i64(ob,c,ANSA as i64); c=o_nl(ob,c);

  // revised fact table: identical facts MINUS the fact that made 12 a subject,
  // so the previously-correct chain yields a class-0 value and is gated out.
  let FA2:[]u8=z_alloc(4*16);
  let FC2:[]u8=z_alloc(4*16);
  let nf2:i32=0;
  set32(FA2,nf2*4,10); set32(FC2,nf2*4,110); nf2=nf2+1;
  set32(FA2,nf2*4,11); set32(FC2,nf2*4,111); nf2=nf2+1;
  set32(FA2,nf2*4,20); set32(FC2,nf2*4,120); nf2=nf2+1;
  set32(FA2,nf2*4,21); set32(FC2,nf2*4,121); nf2=nf2+1;
  set32(FA2,nf2*4,22); set32(FC2,nf2*4,20);  nf2=nf2+1;
  c=o_app(ob,c,"REV-B world classes: 11="); c=o_i64(ob,c,vclass(FA2,FC2,nf2,11) as i64);
  c=o_app(ob,c," 12="); c=o_i64(ob,c,vclass(FA2,FC2,nf2,12) as i64);
  c=o_app(ob,c," 110="); c=o_i64(ob,c,vclass(FA2,FC2,nf2,110) as i64);
  c=o_app(ob,c,"  <- 12 must be 0 for the old chain to be gated out"); c=o_nl(ob,c);

  // REV-B: the fact landscape changes so the stale chain becomes
  //   class-INELIGIBLE. Expected to be immediate, and for a different reason.
  let supB:[]u8=z_alloc(64);
  s=0; while(s<ns){ set32(supB,s*4,get32(sup,s*4)); s=s+1; }
  let clsB:i32=vclass(FA2,FC2,nf2,q0);
  let revBFirst:i32=-1; let revBWrong:i32=0;
  let rb:i32=0;
  while(rb<40){
    let pB:[]u8=recruit_sup(W,store,con,ns,FA2,FC2,nf2,q0,q1,clsB,target,supB,tr,fr,out);
    let pvB:i32=get32(pB,0);
    let k0:i32=get32(tr,0); let k1:i32=get32(tr,4);
    let csB:[]u8=consequence(ANSA,pvB);
    let tkB:i32=get32(csB,0);
    if(k0>=0){ set32(supB,k0*4,get32(supB,k0*4)+tkB); }
    if(k1>=0){ set32(supB,k1*4,get32(supB,k1*4)+tkB); }
    if(pvB==ANSA){ if(revBFirst<0){ revBFirst=rb; } } else { revBWrong=revBWrong+1; }
    rb=rb+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"PHASE5 REV-B facts_change_gate_invalidates");
  c=o_app(ob,c," class(12)_revised="); c=o_i64(ob,c,vclass(FA2,FC2,nf2,12) as i64);
  c=o_app(ob,c," expected="); c=o_i64(ob,c,ANSA as i64);
  c=o_app(ob,c," measured_trials="); c=o_i64(ob,c,revBFirst as i64);
  c=o_app(ob,c," wrong="); c=o_i64(ob,c,revBWrong as i64); c=o_nl(ob,c);

  // control: support erased (FO)
  let supF:[]u8=z_alloc(64);
  s=0; while(s<ns){ set32(supF,s*4,0); s=s+1; }
  let fo:[]u8=recruit_sup(W,store,con,ns,FA,FC,nf,q0,q1,cls0,target,supF,tr,fr,out);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"FO support_erased ans="); c=o_i64(ob,c,get32(fo,0) as i64); c=o_nl(ob,c);

  let bc:i32=0; if(get32(h0,0)!=ANS1){ bc=1; }
  let bs:i32=0; if(get32(finSel,0)==ANS1){ bs=1; }
  let bt:i32=0; if(get32(xfer,0)==ANS2){ bt=1; }
  let br:i32=0; if(get32(revA,0)==ANSA){ br=1; }
  let brA:i32=0; if(revAFirst==12){ brA=1; }
  // stability: correct trials AFTER the first correct one
  let afterA:i32=40-revAFirst;
  let correctAfterA:i32=afterA-revAWrong;
  let stabOk:i32=0;
  if(afterA>0){ if(correctAfterA*100 >= afterA*90){ stabOk=1; } }
  let brB:i32=0; if(revBFirst==0){ brB=1; }
  let bf:i32=0; if(get32(fo,0)!=ANS1){ bf=1; }
  let bl:i32=0; if(firstCorrect>=0){ if(firstCorrect<=2){ bl=1; } }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR contract_only_is_wrong="); c=o_i64(ob,c,bc as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR consequence_selects_correct="); c=o_i64(ob,c,bs as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR converges_within_2_trials="); c=o_i64(ob,c,bl as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR transfers_to_fresh_query="); c=o_i64(ob,c,bt as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR revises_consequence_driven="); c=o_i64(ob,c,br as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR revA_first_correct_at_12="); c=o_i64(ob,c,brA as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR revA_correct_after_first="); c=o_i64(ob,c,correctAfterA as i64);
  c=o_app(ob,c," of "); c=o_i64(ob,c,afterA as i64);
  c=o_app(ob,c," STABLE_90pct="); c=o_i64(ob,c,stabOk as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR revB_gate_invalidation_is_immediate="); c=o_i64(ob,c,brB as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR support_is_loadbearing="); c=o_i64(ob,c,bf as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
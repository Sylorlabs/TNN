// adv_driver.zag -- rebinding adversary driver (harness-side).
// Seven adversarial worlds attacking the structural rebinding mechanism
// from 91585087c. Each world uses its own workspace for independence.
// Metrics: answer correctness, verification attempts (tried/rejected via
// hg(W,16) and the RB-STAT line the patch emits per query), graceful
// fallback vs crash vs false accept.
fn adv_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
// ---- World 1: Non-chain topology ----
// A: COUNT MAP + SUM MAP (directly promoted) + chain MAPs (via trial).
// B1: chain query (count/sum MAPs must be skipped by rb_chain_plen).
// B2: count query (chain rebounds must be rejected, fallback to trial).
fn world1()void {
  emit("W1-NONCHAIN-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // A: COUNT MAP via direct construction.
  ev_teach(W,601,1,611); ev_teach(W,611,1,612); ev_teach(W,612,1,613);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,601,1,v,f);
  emit("W1 count chain len="); e64(len); emit("\n");
  let croot:i32=t2_asm_count(W,v,len,f);
  let cplen:i32=rb_chain_plen(W,croot);
  emit("W1 rb_chain_plen(count)="); e64(cplen); emit(" (expect -1)\n");
  let cm:i32=promote_graph(W,croot,601,50,3,f,len-1);
  emit("W1 count MAP="); e64(cm); emit("\n");
  // A: SUM MAP via direct construction.
  ev_teach(W,701,1,5); ev_teach(W,701,1,7);
  let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
  let m:i32=t2_gather_sum(W,701,vals,sf);
  emit("W1 sum gather n="); e64(m); emit("\n");
  let sroot:i32=t2_asm_sum(W,vals,m);
  let splen:i32=rb_chain_plen(W,sroot);
  emit("W1 rb_chain_plen(sum)="); e64(splen); emit(" (expect -1)\n");
  let sm:i32=promote_graph(W,sroot,701,50,12,sf,m);
  emit("W1 sum MAP="); e64(sm); emit("\n");
  // A: chain MAPs via trial (decoy plen-3, main plen-5).
  ev_teach(W,2,1,21); ev_teach(W,21,1,22);
  let a1:i32=ev_query(W,2,51,22,0);
  emit("W1 A-DECOY ans="); e64(a1); adv_tstat(W);
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a2:i32=ev_query(W,1,50,14,0);
  emit("W1 A-MAIN ans="); e64(a2); adv_tstat(W);
  // B1: chain query. Count/sum MAPs must be skipped.
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  ev_teach(W,101,1,201); ev_teach(W,201,1,202);
  ev_teach(W,101,1,203); ev_teach(W,203,1,204);
  let b:i32=ev_query(W,101,50,114,0);
  emit("W1 B1-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W1 B1-CHAIN expect=114 ok="); e64(b==114); emit("\n");
  // B2: count query. Chain rebounds rejected, fallback to trial count.
  ev_teach(W,801,1,811); ev_teach(W,811,1,812); ev_teach(W,812,1,813);
  let b2:i32=ev_query(W,801,50,3,0);
  emit("W1 B2-COUNT ans="); e64(b2); adv_tstat(W);
  emit("W1 B2-COUNT expect=3 ok="); e64(b2==3); emit("\n");
  emit("W1-NONCHAIN-END\n");
  return;
}
// ---- World 2: Deceptive MAP ----
// A: chain with corrupted guard literal (rb_chain_plen ignores literals).
// B: chain query. Rebound rebuilt from B's data; corruption must not
// propagate. Tests robustness of plen-only extraction.
fn world2()void {
  emit("W2-DECEPTIVE-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,901,1,911); ev_teach(W,911,1,912);
  ev_teach(W,912,1,913); ev_teach(W,913,1,914);
  let v2:[]u8=z_alloc(64); let f2:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,901,1,v2,f2);
  let root:i32=t2_asm_chain(W,v2,len,f2);
  emit("W2 chain root="); e64(root); emit(" len="); e64(len); emit("\n");
  // Corrupt: root guard's literal value -> 99999 (wrong).
  let glit:i32=ng(W,root,8);
  let oldv:i32=ng(W,glit,20);
  emit("W2 guard lit node="); e64(glit); emit(" old val="); e64(oldv); emit("\n");
  ns(W,glit,20,99999);
  emit("W2 corrupted literal to 99999\n");
  let plen:i32=rb_chain_plen(W,root);
  emit("W2 rb_chain_plen(deceptive)="); e64(plen); emit(" (expect 5, no crash)\n");
  let dm:i32=promote_graph(W,root,901,50,914,f2,len-1);
  emit("W2 deceptive MAP="); e64(dm); emit("\n");
  // B: normal chain query.
  ev_teach(W,921,1,931); ev_teach(W,931,1,932);
  ev_teach(W,932,1,933); ev_teach(W,933,1,934);
  let b:i32=ev_query(W,921,50,934,0);
  emit("W2 B-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W2 B-CHAIN expect=934 ok="); e64(b==934); emit("\n");
  emit("W2-DECEPTIVE-END\n");
  return;
}
// ---- World 3: Scale attack ----
// A: 19 wrong plen-3 MAPs (promoted first, lower ids) + 1 correct plen-5
// MAP (promoted last, highest id). B: plen-5 query with length-3
// distractors. Mechanism must scan all 19 wrong MAPs (rejected) before
// reaching the correct one. Cost must be linear, not exponential.
fn world3()void {
  emit("W3-SCALE-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<19){
    let s:i32=1001+i*10;
    ev_teach(W,s,1,s+1); ev_teach(W,s+1,1,s+2);
    let q:i32=ev_query(W,s,51,s+2,0);
    if(q!=s+2){ emit("W3 setup FAIL at i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("W3 19 wrong MAPs promoted\n");
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a:i32=ev_query(W,1,50,14,0);
  emit("W3 A-MAIN ans="); e64(a); adv_tstat(W);
  // B: true plen-5 chain + two length-3 distractor paths.
  ev_teach(W,1101,1,1111); ev_teach(W,1111,1,1112);
  ev_teach(W,1112,1,1113); ev_teach(W,1113,1,1114);
  ev_teach(W,1101,1,1201); ev_teach(W,1201,1,1202);
  ev_teach(W,1101,1,1203); ev_teach(W,1203,1,1204);
  let b:i32=ev_query(W,1101,50,1114,0);
  emit("W3 B-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W3 B-CHAIN expect=1114 ok="); e64(b==1114); emit("\n");
  emit("W3-SCALE-END\n");
  return;
}
// ---- World 4: Poisoned MAP (wrong stored answer) ----
// A: chain MAP manually promoted with ans=99999 (wrong; true=1214).
// B: unmasked chain query. Rebound uses plen only; stored ans must be
// ignored. Tests that mechanism does not trust MAP answer field.
fn world4()void {
  emit("W4-POISON-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1201,1,1211); ev_teach(W,1211,1,1212);
  ev_teach(W,1212,1,1213); ev_teach(W,1213,1,1214);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,1201,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pplen:i32=rb_chain_plen(W,root);
  emit("W4 rb_chain_plen="); e64(pplen); emit("\n");
  let pm:i32=promote_graph(W,root,1201,50,99999,f,len-1);
  emit("W4 poisoned MAP="); e64(pm); emit(" stored ans=99999 true=1214\n");
  ev_teach(W,1301,1,1311); ev_teach(W,1311,1,1312);
  ev_teach(W,1312,1,1313); ev_teach(W,1313,1,1314);
  let b:i32=ev_query(W,1301,50,1314,0);
  emit("W4 B-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W4 B-CHAIN expect=1314 ok="); e64(b==1314); emit(" (stored 99999 ignored)\n");
  emit("W4-POISON-END\n");
  return;
}
// ---- World 4b: Masked query order dependence ----
// A: plen-4 chain MAP. B: masked query with two length-4 paths.
// P1 taught first (lower ids, earlier in BFS). Rebound must pick the
// first-executing path; documents order-dependence on masked queries.
fn world4b()void {
  emit("W4B-MASKED-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,1,11); ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let a:i32=ev_query(W,1,50,13,0);
  emit("W4B A-MAIN ans="); e64(a); adv_tstat(W);
  ev_teach(W,401,1,411); ev_teach(W,411,1,412);
  ev_teach(W,412,1,413); ev_teach(W,413,1,414);
  ev_teach(W,401,1,421); ev_teach(W,421,1,422);
  ev_teach(W,422,1,423); ev_teach(W,423,1,424);
  let b:i32=ev_query(W,401,50,-2,1);
  emit("W4B B-MASKED ans="); e64(b); adv_tstat(W);
  emit("W4B picked P1(414)="); e64(b==414); emit(" P2(424)="); e64(b==424); emit("\n");
  emit("W4B-MASKED-END\n");
  return;
}
// ---- World 5: Negative transfer ----
// A: 10 chain MAPs (plen 2x3, 3x3, 4x3, 5x1). B: count query (expects 3).
// The chain MAPs cannot apply: every rebound must be rejected by execution
// verification, then trial falls back to the count graph. Measures the
// wasted-verification tax of misleading old structure vs a fresh control.
fn world5()void {
  emit("W5-NEGTRANS-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<10){
    let s:i32=2000+i*10;
    let plen:i32=2;
    if(i>=3){ plen=3; }
    if(i>=6){ plen=4; }
    if(i>=9){ plen=5; }
    let j:i32=0;
    while(j<plen-1){ ev_teach(W,s+j,1,s+j+1); j=j+1; }
    let q:i32=ev_query(W,s,50,s+plen-1,0);
    if(q!=s+plen-1){ emit("W5 setup FAIL i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("W5 10 chain MAPs promoted\n");
  ev_teach(W,301,1,302); ev_teach(W,302,1,303); ev_teach(W,303,1,304);
  let b:i32=ev_query(W,301,50,3,0);
  emit("W5 B-COUNT ans="); e64(b); adv_tstat(W);
  emit("W5 B-COUNT expect=3 ok="); e64(b==3); emit("\n");
  let C:[]u8=z_alloc(110656); tnn2_init(C);
  ev_teach(C,301,1,302); ev_teach(C,302,1,303); ev_teach(C,303,1,304);
  let b0:i32=ev_query(C,301,50,3,0);
  emit("W5 CONTROL ans="); e64(b0); adv_tstat(C);
  emit("W5 CONTROL expect=3 ok="); e64(b0==3); emit("\n");
  emit("W5-NEGTRANS-END\n");
  return;
}
// ---- World 6: Ambiguous selection (first-verified-wins order dependence)
// A: one plen-5 chain MAP. B: two plen-5 paths to the same endpoint 114.
// Variant 0: decoy path taught first. Variant 1: true path taught first.
// Dumps the promoted MAP's DEP edges to identify which path was bound.
fn adv_newest_map(W:[]u8)i32 {
  let best:i32=-1;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ best=m; }
    m=m+1;
  }
  return best;
}
fn adv_dump_map_deps(W:[]u8,mp:i32)void {
  emit("W6 MAP="); e64(mp); emit(" bound DEP facts:");
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mp && eg(W,e,4)==1){
      let t:i32=eg(W,e,8);
      emit(" ("); e64(ng(W,t,20)); emit(","); e64(ng(W,t,24)); emit(","); e64(ng(W,t,28)); emit(")");
    }
    e=e+1;
  }
  emit("\n");
  return;
}
fn world6(v:i32)void {
  if(v==0){ emit("W6A-AMBIG-START\n"); } else { emit("W6B-AMBIG-START\n"); }
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a:i32=ev_query(W,1,50,14,0);
  if(a!=14){ emit("W6 setup FAIL\n"); }
  if(v==0){
    ev_teach(W,101,1,211); ev_teach(W,211,1,212);
    ev_teach(W,212,1,213); ev_teach(W,213,1,114);
    ev_teach(W,101,1,111); ev_teach(W,111,1,112);
    ev_teach(W,112,1,113); ev_teach(W,113,1,114);
    emit("W6 teach order: decoy first\n");
  } else {
    ev_teach(W,101,1,111); ev_teach(W,111,1,112);
    ev_teach(W,112,1,113); ev_teach(W,113,1,114);
    ev_teach(W,101,1,211); ev_teach(W,211,1,212);
    ev_teach(W,212,1,213); ev_teach(W,213,1,114);
    emit("W6 teach order: true first\n");
  }
  let b:i32=ev_query(W,101,50,114,0);
  emit("W6 B-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W6 B-CHAIN expect=114 ok="); e64(b==114); emit("\n");
  let mp:i32=adv_newest_map(W);
  adv_dump_map_deps(W,mp);
  if(v==0){ emit("W6A-AMBIG-END\n"); } else { emit("W6B-AMBIG-END\n"); }
  return;
}
// ---- World 7: Depth mismatch / partial applicability ----
// A: three plen-5 chain MAPs. B: true plen-4 chain (expects 113) plus a
// length-5 decoy path (endpoint 214). plen matching is all-or-nothing:
// the plen-5 MAPs match only the decoy path, whose endpoint verifies
// wrong, so every rebound rejects and trial finds the plen-4 chain.
fn world7()void {
  emit("W7-DEPTH-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<3){
    let s:i32=1+i*10;
    ev_teach(W,s,1,s+1); ev_teach(W,s+1,1,s+2);
    ev_teach(W,s+2,1,s+3); ev_teach(W,s+3,1,s+4);
    let q:i32=ev_query(W,s,50,s+4,0);
    if(q!=s+4){ emit("W7 setup FAIL i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit("W7 3 plen-5 MAPs promoted\n");
  ev_teach(W,101,1,111); ev_teach(W,111,1,112); ev_teach(W,112,1,113);
  ev_teach(W,101,1,211); ev_teach(W,211,1,212);
  ev_teach(W,212,1,213); ev_teach(W,213,1,214);
  let b:i32=ev_query(W,101,50,113,0);
  emit("W7 B-CHAIN ans="); e64(b); adv_tstat(W);
  emit("W7 B-CHAIN expect=113 ok="); e64(b==113); emit("\n");
  let C:[]u8=z_alloc(110656); tnn2_init(C);
  ev_teach(C,101,1,111); ev_teach(C,111,1,112); ev_teach(C,112,1,113);
  ev_teach(C,101,1,211); ev_teach(C,211,1,212);
  ev_teach(C,212,1,213); ev_teach(C,213,1,214);
  let b0:i32=ev_query(C,101,50,113,0);
  emit("W7 CONTROL ans="); e64(b0); adv_tstat(C);
  emit("W7 CONTROL expect=113 ok="); e64(b0==113); emit("\n");
  emit("W7-DEPTH-END\n");
  return;
}
fn main()i32 {
  emit("REBIND-ADV-START\n");
  world1();
  world2();
  world3();
  world4();
  world4b();
  world5();
  world6(0);
  world6(1);
  world7();
  emit("REBIND-ADV-END\n");
  return 0;
}

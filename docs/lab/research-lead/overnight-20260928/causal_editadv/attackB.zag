// editinvent.zag -- Learner-Authored Edit-Vocabulary Builder (CAUSAL-EDITINVENT).
// Pure Zag. No Python. Pinned znc.
// Prereg: docs/lab/research-lead/overnight-20260928/causal_editinvent/PREREG.md
// (commit 811fc06c9, strictly before this file).
//
// DELTA on causal_revert.zag (da0cd17b6). ONE-SYSTEM RULE compliant: single
// learner, no modes, no bridges, no handlers. The edit vocabulary is
// parameterized by a runtime learner-state variable dmax (init 2). On
// exhaustive old-vocabulary failure, the learner runs a generic
// diagnose-and-relax meta-procedure and constructs EXTEND-DELAY (dmax 2->3),
// a second-order edit (edits the vocabulary, not a graph).
//
// Graph slot layout (32 bytes): +0 nr(i32), +4 src[2](i32), +12 dst[2](i32),
// +20 delay[2](i32), +28 unused. Variables: X=0, Y=1, Z=2.

extern fn _zag_malloc(n:i32)*u8;
extern fn _zag_print(s:[]u8)void;
extern fn _zag_i64_to_str(v:i64)[]u8;

// ============ utils (verbatim from causal_revert.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ arrival computation (verbatim) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ graph slot helpers (verbatim) ============
fn g_src(buf:[]u8, b:i32)[]u8 { return buf[b+4..b+12]; }
fn g_dst(buf:[]u8, b:i32)[]u8 { return buf[b+12..b+20]; }
fn g_delay(buf:[]u8, b:i32)[]u8 { return buf[b+20..b+28]; }
fn g_set(buf:[]u8, b:i32, nr:i32, s0:i32, d0:i32, w0:i32, s1:i32, d1:i32, w1:i32)void {
  set32(buf, b, nr);
  set32(buf, b+4, s0); set32(buf, b+8, s1);
  set32(buf, b+12, d0); set32(buf, b+16, d1);
  set32(buf, b+20, w0); set32(buf, b+24, w1);
  return;
}
fn g_copy2(sb:[]u8, so:i32, db:[]u8, do:i32)void {
  let i:i32=0;
  while(i<32){ db[do+i]=sb[so+i]; i=i+1; }
  return;
}
fn g_sort_rules(buf:[]u8, b:i32)void {
  if(get32(buf,b)!=2){ return; }
  let s0:i32=get32(buf,b+4); let d0:i32=get32(buf,b+12); let w0:i32=get32(buf,b+20);
  let s1:i32=get32(buf,b+8); let d1:i32=get32(buf,b+16); let w1:i32=get32(buf,b+24);
  let swap:i32=0;
  if(s0>s1){ swap=1; }
  else if(s0==s1){ if(d0>d1){ swap=1; } else if(d0==d1){ if(w0>w1){ swap=1; } } }
  if(swap==1){
    set32(buf,b+4,s1); set32(buf,b+8,s0);
    set32(buf,b+12,d1); set32(buf,b+16,d0);
    set32(buf,b+20,w1); set32(buf,b+24,w0);
  }
  return;
}
fn g_eq_canon2(b1:[]u8, o1:i32, b2:[]u8, o2:i32)i32 {
  if(get32(b1,o1)!=get32(b2,o2)){ return 0; }
  let nr:i32=get32(b1,o1);
  let r:i32=0;
  while(r<nr){
    if(get32(b1,o1+4+r*4)!=get32(b2,o2+4+r*4)){ return 0; }
    if(get32(b1,o1+12+r*4)!=get32(b2,o2+12+r*4)){ return 0; }
    if(get32(b1,o1+20+r*4)!=get32(b2,o2+20+r*4)){ return 0; }
    r=r+1;
  }
  return 1;
}
fn g_cmp_lex(buf:[]u8, b1:i32, b2:i32)i32 {
  let n1:i32=get32(buf,b1); let n2:i32=get32(buf,b2);
  if(n1<n2){ return -1; }
  if(n1>n2){ return 1; }
  let r:i32=0;
  while(r<n1){
    let a0:i32=get32(buf,b1+4+r*4); let a1:i32=get32(buf,b2+4+r*4);
    if(a0<a1){ return -1; } if(a0>a1){ return 1; }
    let c0:i32=get32(buf,b1+12+r*4); let c1:i32=get32(buf,b2+12+r*4);
    if(c0<c1){ return -1; } if(c0>c1){ return 1; }
    let e0:i32=get32(buf,b1+20+r*4); let e1:i32=get32(buf,b2+20+r*4);
    if(e0<e1){ return -1; } if(e0>e1){ return 1; }
    r=r+1;
  }
  return 0;
}
fn emit_graph(buf:[]u8, b:i32)void {
  emit("[");
  let nr:i32=get32(buf,b);
  let r:i32=0;
  while(r<nr){
    if(r>0){ emit(","); }
    emit("("); e64(get32(buf,b+4+r*4)); emit(",");
    e64(get32(buf,b+12+r*4)); emit(","); e64(get32(buf,b+20+r*4)); emit(")");
    r=r+1;
  }
  emit("]");
  return;
}

// ============ rule index, parameterized by dmax (generic, no hardcoded delays) ============
// idx = s*(2*dmax) + dcode*dmax + (w-1), dcode = d>s ? d-1 : d.
fn rule_by_idx_dmax(idx:i32, dmax:i32, out_s:[]u8, out_d:[]u8, out_w:[]u8)void {
  let per:i32=2*dmax;
  let s:i32=idx/per;
  let rem:i32=idx-s*per;
  let dcode:i32=rem/dmax;
  let w:i32=(rem-dcode*dmax)+1;
  let d:i32=dcode;
  if(dcode>=s){ d=dcode+1; }
  set32(out_s,0,s); set32(out_d,0,d); set32(out_w,0,w);
  return;
}
fn rule_present(buf:[]u8, b:i32, s:i32, d:i32, w:i32)i32 {
  let nr:i32=get32(buf,b);
  let r:i32=0;
  while(r<nr){
    if(get32(buf,b+4+r*4)==s && get32(buf,b+12+r*4)==d && get32(buf,b+20+r*4)==w){ return 1; }
    r=r+1;
  }
  return 0;
}

// ============ enumerate graphs, parameterized by dmax ============
fn gen_all_graphs_dmax(table:[]u8, dmax:i32)i32 {
  let n:i32=0;
  let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
  let n_rules:i32=6*dmax;
  let idx:i32=0;
  while(idx<n_rules){
    rule_by_idx_dmax(idx, dmax, os, od, ow);
    g_set(table, n*32, 1, get32(os,0), get32(od,0), get32(ow,0), 0,0,0);
    n=n+1;
    idx=idx+1;
  }
  let i:i32=0;
  while(i<n_rules){
    let j:i32=i+1;
    while(j<n_rules){
      rule_by_idx_dmax(i, dmax, os, od, ow);
      let s0:i32=get32(os,0); let d0:i32=get32(od,0); let w0:i32=get32(ow,0);
      rule_by_idx_dmax(j, dmax, os, od, ow);
      let s1:i32=get32(os,0); let d1:i32=get32(od,0); let w1:i32=get32(ow,0);
      g_set(table, n*32, 2, s0,d0,w0, s1,d1,w1);
      n=n+1;
      j=j+1;
    }
    i=i+1;
  }
  return n;
}

// ============ consistency and signature (verbatim logic) ============
fn graph_consistent(buf:[]u8, b:i32, E:[]u8)i32 {
  let arr:[]u8=z_alloc(12);
  compute_arrivals(get32(buf,b), g_src(buf,b), g_dst(buf,b), g_delay(buf,b), 3, 1, arr);
  let o:i32=0;
  while(o<3){
    let v:i32=get32(E,o*12); let t:i32=get32(E,o*12+4); let exp:i32=get32(E,o*12+8);
    let a:i32=get32(arr,v*4);
    let pred:i32=0;
    if(a<=t){ pred=1; }
    if(pred!=exp){ return 0; }
    o=o+1;
  }
  return 1;
}
fn consistent_raw(nr:i32, src:[]u8, dst:[]u8, dly:[]u8, E:[]u8)i32 {
  let arr:[]u8=z_alloc(12);
  compute_arrivals(nr, src, dst, dly, 3, 1, arr);
  let o:i32=0;
  while(o<3){
    let v:i32=get32(E,o*12); let t:i32=get32(E,o*12+4); let exp:i32=get32(E,o*12+8);
    let a:i32=get32(arr,v*4);
    let pred:i32=0;
    if(a<=t){ pred=1; }
    if(pred!=exp){ return 0; }
    o=o+1;
  }
  return 1;
}
fn graph_sig(buf:[]u8, b:i32, out_y:[]u8, out_z:[]u8)void {
  let arr:[]u8=z_alloc(12);
  compute_arrivals(get32(buf,b), g_src(buf,b), g_dst(buf,b), g_delay(buf,b), 3, 1, arr);
  set32(out_y,0,get32(arr,4));
  set32(out_z,0,get32(arr,8));
  return;
}

// ============ constructor, parameterized by dmax ============
fn construct_dmax(E:[]u8, reps:[]u8, out_ng:[]u8, out_nc:[]u8, dmax:i32)i32 {
  let all:[]u8=z_alloc(256*32);
  let n_all:i32=gen_all_graphs_dmax(all, dmax);
  let cg:[]u8=z_alloc(256*32);
  let n_cg:i32=0;
  let i:i32=0;
  while(i<n_all){
    if(graph_consistent(all, i*32, E)==1){
      g_copy2(all, i*32, cg, n_cg*32);
      g_sort_rules(cg, n_cg*32);
      n_cg=n_cg+1;
    }
    i=i+1;
  }
  set32(out_ng,0,n_cg);
  let oy:[]u8=z_alloc(4); let oz:[]u8=z_alloc(4);
  let sy:[]u8=z_alloc(4); let sz:[]u8=z_alloc(4);
  let n_rep:i32=0;
  i=0;
  while(i<n_cg){
    graph_sig(cg, i*32, sy, sz);
    let seen:i32=0;
    let j:i32=0;
    while(j<i){
      graph_sig(cg, j*32, oy, oz);
      if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){ seen=1; }
      j=j+1;
    }
    if(seen==0){
      let best:i32=i;
      j=i+1;
      while(j<n_cg){
        graph_sig(cg, j*32, oy, oz);
        if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){
          let nb:i32=get32(cg,j*32); let cb:i32=get32(cg,best*32);
          if(nb<cb){ best=j; }
          else if(nb==cb){ if(g_cmp_lex(cg, j*32, best*32)<0){ best=j; } }
        }
        j=j+1;
      }
      g_copy2(cg, best*32, reps, n_rep*32);
      n_rep=n_rep+1;
    }
    i=i+1;
  }
  set32(out_nc,0,n_rep);
  return n_rep;
}

// ============ THE EDIT VOCABULARY: 1-edit neighbors, parameterized by dmax ============
// No delay literal appears here; all delay bounds derive from the dmax parameter.
// With dmax=2 this is EXACTLY the researcher-supplied V_old.
fn neighbors_dmax(buf:[]u8, b:i32, dmax:i32, out:[]u8)i32 {
  let n:i32=0;
  let nr:i32=get32(buf,b);
  let r:i32=0;
  // Change one delay: try every delay in 1..dmax except current.
  while(r<nr){
    let cur_w:i32=get32(buf, b+20+r*4);
    let w:i32=1;
    while(w<=dmax){
      if(w!=cur_w){
        g_copy2(buf, b, out, n*32);
        set32(out, n*32+20+r*4, w);
        g_sort_rules(out, n*32);
        n=n+1;
      }
      w=w+1;
    }
    r=r+1;
  }
  // Add one rule (only if nr<2): from the 6*dmax rules.
  if(nr<2){
    let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
    let n_rules:i32=6*dmax;
    let idx:i32=0;
    while(idx<n_rules){
      rule_by_idx_dmax(idx, dmax, os, od, ow);
      let s:i32=get32(os,0); let d:i32=get32(od,0); let w:i32=get32(ow,0);
      if(rule_present(buf, b, s, d, w)==0){
        g_copy2(buf, b, out, n*32);
        set32(out, n*32, nr+1);
        set32(out, n*32+4+nr*4, s);
        set32(out, n*32+12+nr*4, d);
        set32(out, n*32+20+nr*4, w);
        g_sort_rules(out, n*32);
        n=n+1;
      }
      idx=idx+1;
    }
  }
  // Remove one rule.
  r=0;
  while(r<nr){
    g_copy2(buf, b, out, n*32);
    let q:i32=r;
    while(q<nr-1){
      set32(out, n*32+4+q*4, get32(out, n*32+4+(q+1)*4));
      set32(out, n*32+12+q*4, get32(out, n*32+12+(q+1)*4));
      set32(out, n*32+20+q*4, get32(out, n*32+20+(q+1)*4));
      q=q+1;
    }
    set32(out, n*32, nr-1);
    g_sort_rules(out, n*32);
    n=n+1;
    r=r+1;
  }
  // Dedupe within out, excluding the original graph.
  let u:[]u8=z_alloc(64*32);
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let dup:i32=0;
    let j:i32=0;
    while(j<nu){
      if(g_eq_canon2(out, i*32, u, j*32)==1){ dup=1; }
      j=j+1;
    }
    if(g_eq_canon2(out, i*32, buf, b)==1){ dup=1; }
    if(dup==0){
      g_copy2(out, i*32, u, nu*32);
      nu=nu+1;
    }
    i=i+1;
  }
  i=0;
  while(i<nu){
    g_copy2(u, i*32, out, i*32);
    i=i+1;
  }
  return nu;
}
fn in_table(tab:[]u8, n:i32, cb:[]u8, co:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(g_eq_canon2(tab, i*32, cb, co)==1){ return 1; }
    i=i+1;
  }
  return 0;
}

// ============ REVISE: k-edit BFS, parameterized by dmax ============
// Returns k (0=keep, 1..3=revision depth), or -1 on failure.
fn revise_dmax(W:[]u8, E:[]u8, reps:[]u8, out_nrep:[]u8, dmax:i32)i32 {
  if(graph_consistent(W, 0, E)==1){
    g_copy2(W, 0, reps, 0);
    set32(out_nrep,0,1);
    return 0;
  }
  let seen:[]u8=z_alloc(256*32);
  let frontier:[]u8=z_alloc(256*32);
  let next:[]u8=z_alloc(256*32);
  let nbs:[]u8=z_alloc(64*32);
  g_copy2(W, 0, seen, 0);
  g_copy2(W, 0, frontier, 0);
  let n_seen:i32=1;
  let n_fr:i32=1;
  let KMAX:i32=3;
  let k:i32=1;
  while(k<=KMAX){
    let n_next:i32=0;
    let f:i32=0;
    while(f<n_fr){
      let nn:i32=neighbors_dmax(frontier, f*32, dmax, nbs);
      let h:i32=0;
      while(h<nn){
        if(in_table(seen, n_seen, nbs, h*32)==0){
          g_copy2(nbs, h*32, seen, n_seen*32);
          g_copy2(nbs, h*32, next, n_next*32);
          n_seen=n_seen+1;
          n_next=n_next+1;
        }
        h=h+1;
      }
      f=f+1;
    }
    let cf:[]u8=z_alloc(256*32);
    let n_cf:i32=0;
    f=0;
    while(f<n_next){
      if(graph_consistent(next, f*32, E)==1){
        g_copy2(next, f*32, cf, n_cf*32);
        n_cf=n_cf+1;
      }
      f=f+1;
    }
    if(n_cf>0){
      let oy:[]u8=z_alloc(4); let oz:[]u8=z_alloc(4);
      let sy:[]u8=z_alloc(4); let sz:[]u8=z_alloc(4);
      let n_rep:i32=0;
      let i:i32=0;
      while(i<n_cf){
        graph_sig(cf, i*32, sy, sz);
        let seen2:i32=0;
        let j:i32=0;
        while(j<i){
          graph_sig(cf, j*32, oy, oz);
          if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){ seen2=1; }
          j=j+1;
        }
        if(seen2==0){
          let best:i32=i;
          j=i+1;
          while(j<n_cf){
            graph_sig(cf, j*32, oy, oz);
            if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){
              let nb2:i32=get32(cf,j*32); let cb2:i32=get32(cf,best*32);
              if(nb2<cb2){ best=j; }
              else if(nb2==cb2){ if(g_cmp_lex(cf, j*32, best*32)<0){ best=j; } }
            }
            j=j+1;
          }
          g_copy2(cf, best*32, reps, n_rep*32);
          n_rep=n_rep+1;
        }
        i=i+1;
      }
      set32(out_nrep,0,n_rep);
      return k;
    }
    f=0;
    while(f<n_next){
      g_copy2(next, f*32, frontier, f*32);
      f=f+1;
    }
    n_fr=n_next;
    k=k+1;
  }
  return -1;
}

// ============ pick best rep: fewest rules, then lex smallest ============
fn pick_best(reps:[]u8, n_rep:i32, out:[]u8)void {
  let best:i32=0;
  let i:i32=1;
  while(i<n_rep){
    let nb:i32=get32(reps,i*32); let cb:i32=get32(reps,best*32);
    if(nb<cb){ best=i; }
    else if(nb==cb){ if(g_cmp_lex(reps, i*32, best*32)<0){ best=i; } }
    i=i+1;
  }
  g_copy2(reps, best*32, out, 0);
  return;
}

// ============ PROVE INSUFFICIENCY: exhaustive old-envelope check ============
// Returns count of E-consistent graphs among the 78 (dmax=2, <=2 rules).
// With the V_old invariant (edits preserve delays in {1,2}, nr<=2), a count
// of 0 PROVES no k-edit sequence in V_old reaches consistency, for any k.
fn prove_insufficient(E:[]u8)i32 {
  let table:[]u8=z_alloc(128*32);
  let n:i32=gen_all_graphs_dmax(table, 2);
  let cnt:i32=0;
  let i:i32=0;
  while(i<n){
    if(graph_consistent(table, i*32, E)==1){ cnt=cnt+1; }
    i=i+1;
  }
  return cnt;
}

// ============ DIAGNOSTIC WHAT-IF enumerators (clearly marked, not edit paths) ============
// These answer "what if the envelope were relaxed?" They are unreachable from
// neighbors_dmax / revise_dmax. Audit whitelists diag_ prefix.
fn diag_count_maxrules3(E:[]u8)i32 {
  // WHAT-IF: 3-rule graphs, delays<=2. 220 graphs.
  let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
  let src:[]u8=z_alloc(12); let dst:[]u8=z_alloc(12); let dly:[]u8=z_alloc(12);
  let cnt:i32=0;
  let i:i32=0;
  while(i<12){
    let j:i32=i+1;
    while(j<12){
      let k:i32=j+1;
      while(k<12){
        rule_by_idx_dmax(i, 2, os, od, ow);
        set32(src,0,get32(os,0)); set32(dst,0,get32(od,0)); set32(dly,0,get32(ow,0));
        rule_by_idx_dmax(j, 2, os, od, ow);
        set32(src,4,get32(os,0)); set32(dst,4,get32(od,0)); set32(dly,4,get32(ow,0));
        rule_by_idx_dmax(k, 2, os, od, ow);
        set32(src,8,get32(os,0)); set32(dst,8,get32(od,0)); set32(dly,8,get32(ow,0));
        if(consistent_raw(3, src, dst, dly, E)==1){ cnt=cnt+1; }
        k=k+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  return cnt;
}
fn diag_count_delay3(E:[]u8)i32 {
  // WHAT-IF: <=2-rule graphs, delays<=3. 171 graphs.
  let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
  let src:[]u8=z_alloc(8); let dst:[]u8=z_alloc(8); let dly:[]u8=z_alloc(8);
  let cnt:i32=0;
  let idx:i32=0;
  while(idx<18){
    rule_by_idx_dmax(idx, 3, os, od, ow);
    set32(src,0,get32(os,0)); set32(dst,0,get32(od,0)); set32(dly,0,get32(ow,0));
    if(consistent_raw(1, src, dst, dly, E)==1){ cnt=cnt+1; }
    idx=idx+1;
  }
  let i:i32=0;
  while(i<18){
    let j:i32=i+1;
    while(j<18){
      rule_by_idx_dmax(i, 3, os, od, ow);
      set32(src,0,get32(os,0)); set32(dst,0,get32(od,0)); set32(dly,0,get32(ow,0));
      rule_by_idx_dmax(j, 3, os, od, ow);
      set32(src,4,get32(os,0)); set32(dst,4,get32(od,0)); set32(dly,4,get32(ow,0));
      if(consistent_raw(2, src, dst, dly, E)==1){ cnt=cnt+1; }
      j=j+1;
    }
    i=i+1;
  }
  return cnt;
}

// ============ DIAGNOSE: generic diagnose-and-relax ============
// Tests minimal relaxations of each envelope parameter in scope.
// Returns 1=max_rules binds, 2=delay_max binds, 0=none/ambiguous.
// The binding is selected by the counts, never by family ID.
fn diagnose(E:[]u8)i32 {
  let c_mr:i32=diag_count_maxrules3(E);
  emit("max_rules->3: "); e64(c_mr); emit("/220\n");
  let c_dl:i32=diag_count_delay3(E);
  emit("delay->3: "); e64(c_dl); emit("/171\n");
  let b_mr:i32=0; let b_dl:i32=0;
  if(c_mr>0){ b_mr=1; }
  if(c_dl>0){ b_dl=1; }
  if(b_dl==1 && b_mr==0){
    emit("binding=delay_max\n");
    return 2;
  }
  if(b_mr==1 && b_dl==0){
    emit("binding=max_rules\n");
    return 1;
  }
  emit("binding=none_or_ambiguous\n");
  return 0;
}

// ============ INVENT: construct EXTEND-DELAY along the binding parameter ============
// The ONLY store to dmax after init. The new value is computed (dmax+1),
// never a literal. This is a second-order edit: it modifies the vocabulary.
fn invent(dmax_cell:[]u8)void {
  let cur:i32=get32(dmax_cell,0);
  let nxt:i32=cur+1;
  emit("EXTEND-DELAY installed, dmax ");
  e64(cur); emit("->"); e64(nxt); emit("\n");
  set32(dmax_cell,0,nxt);
  return;
}

// ============ PATTERN: residual analysis from evidence ============
// Derives required arrival intervals: lo[v]=max{t+1:(v,t)=0}, hi[v]=min{t:(v,t)=1}.
fn pattern_analysis(E:[]u8)void {
  let lo:[]u8=z_alloc(12); let hi:[]u8=z_alloc(12);
  let v:i32=0;
  while(v<3){ set32(lo,v*4,0); set32(hi,v*4,268435456); v=v+1; }
  let o:i32=0;
  while(o<3){
    let vv:i32=get32(E,o*12); let t:i32=get32(E,o*12+4); let exp:i32=get32(E,o*12+8);
    if(exp==0){
      if(t+1>get32(lo,vv*4)){ set32(lo,vv*4,t+1); }
    } else {
      if(t<get32(hi,vv*4)){ set32(hi,vv*4,t); }
    }
    o=o+1;
  }
  emit("PATTERN required arrivals: Y in [");
  e64(get32(lo,4)); emit(","); e64(get32(hi,4)); emit("] Z in [");
  e64(get32(lo,8)); emit(","); 
  if(get32(hi,8)>=268435456){ emit("INF"); } else { e64(get32(hi,8)); }
  emit("]\n");
  return;
}

// EDITADV-B driver main: HONEST-STOP. Attack driver only; the mechanism
// region above this main is byte-identical to 4c233f82a (verified by
// audit_frozen.sh). Pure Zag. Mirrors the frozen Phase-1 pipeline exactly.

fn main()void {
  emit("EDITADV-B HONEST-STOP. Frozen mechanism 4c233f82a.\n");
  // B0: W0 = [(X->Y,1)] = [(0,1,1)], the R3 prior winner (1-rule).
  let W0:[]u8=z_alloc(32);
  set32(W0,0,1);
  set32(W0,4,0); set32(W0,12,1); set32(W0,20,1);
  emit("B0 W0="); emit_graph(W0,0); emit("\n");

  // E_B = {(Y,6)=0,(Y,7)=1,(Z,7)=0}: needs arrY=7, arrZ>=8.
  // 3-hop chain territory (4 variables); outside {max_rules,delay_max}.
  let EB:[]u8=z_alloc(36);
  set32(EB,0,1); set32(EB,4,6); set32(EB,8,0);
  set32(EB,12,1); set32(EB,16,7); set32(EB,20,1);
  set32(EB,24,2); set32(EB,28,7); set32(EB,32,0);

  // B1: FAIL_OLD (V_old BFS, dmax=2). This IS the old-vocabulary control.
  let reps1:[]u8=z_alloc(256*32);
  let nrep1:[]u8=z_alloc(4);
  let k_old:i32=revise_dmax(W0, EB, reps1, nrep1, 2);
  emit("B1 V_old BFS k="); e64(k_old); emit("\n");

  // B2: PROVE insufficiency (exhaustive).
  let cnt_old:i32=prove_insufficient(EB);
  emit("B2 old-envelope EB-consistent count="); e64(cnt_old); emit("\n");

  // B3: PATTERN + DIAGNOSE (frozen functions).
  pattern_analysis(EB);
  let binding:i32=diagnose(EB);
  emit("B3 binding="); e64(binding); emit("\n");

  // B4: the frozen branch, verbatim: binding==2 invents, else honest stop.
  if(binding==2){
    emit("B4 UNEXPECTED-INVENT\n");
  } else {
    emit("BINDING-NOT-CONSTRUCTIBLE\n");
    emit("B4 honest stop: no invent, no resolve, no silent misresolution\n");
  }

  if(k_old==-1 && cnt_old==0 && binding==0){
    emit("B-VERDICT HONEST-STOP\n");
  } else {
    emit("B-VERDICT UNEXPECTED\n");
  }
  emit("done\n");
  return;
}

// ivwc_learnereval.zag -- learner-owned evaluation (Micah Priority #4).
// The worth-K arc used harness-reported scores: the harness compared the
// learner's GO sets against the world's eff table and reported profit.
// The learner never evaluated itself. This wave makes evaluation a
// learner-executed computation over its own commitments and experienced
// consequences, with no label comparison anywhere in the learner's computation.
// Three verdicts (verbatim lineage): UCB x V_WK (bar 15, given),
// UCB x V_LOK (bar 14, owned), UCB x V_LOKB (bars (0,16,5,9), owned).
// New mechanism, all learner-side:
//   SE1 prospective self-evaluation (train-only commitment):
//     SEST_NAIVE[v] = P(bar) = sum of train tnet over train cases with
//       tadj > bar (the "would-have-earned" train profit);
//     SEST_PEN[v] = P(bar) - PEN(bar), PEN(bar) = sum of |tnet| over
//       train cases with |tadj - bar| <= 1 (knife-edge profit-at-risk);
//     FLAG[v] = 1 iff 2*PEN > P and P > 0 (relative rule, no constant).
//   SE2 retrospective self-evaluation (post-consequence): the harness
//     reports experienced sealed nets per executed case (snet = se -
//     EXCOST for GO, 0 otherwise; the consequence interface, zero new
//     world calls); the learner sums its experienced nets per arm.
//   SE3 correlation test: learner-committed estimates/flags/retrospection
//     printed alongside harness profits; kill bars K4-K7 test calibration.
// World / belief / composer / stepper / seeds / biases / UCB tables /
// verdict bars / consequence machinery are verbatim from IVWC-LEARNERK
// (K3 re-verifies). Scoring is pure consequence: profit = sum over GO of
// (eff - EXCOST). Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC-APPLIED) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;
// World execution cost per GO (preregistered; consequence phase only).
// The world's parameter is unchanged; what changes is that the new
// learner verdicts do not read it.
const EXCOST:i32=15;

// ---------- helpers (u8-backed cells, little-endian; verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow).
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}
// Integer floor square root (for the V-UCB bias estimator).
fn isqrt(x:i32)i32 {
  let r:i32=0;
  while((r+1)*(r+1)<=x){ r=r+1; }
  return r;
}

// ===== WORLD =====
// Verbatim copies from IVWC-HYBRID-VERDICT. The learner never calls
// these.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// True-world stepper. Called ONLY in train CONSEQ, sealed
// CONSEQUENCE (GO cases), and the fenced REFERENCE -- never by the
// learner. wc counts true executions.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// Everything in this section touches beliefs and plans only.
// No true-world array token appears below (checked by audit A7).
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only (verbatim).
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Extract gather cells from a plan (walk from start), insertion-sort
// them, return the count. Flat control flow (no deep nesting).
fn gather_cells(pb:[]u8, poff:i32, L:i32, start:i32, out:[]u8, ooff:i32)i32 {
  let pos:i32=start;
  let n:i32=0;
  let i:i32=0;
  while(i<L){
    let a:i32=get8(pb,poff+i);
    if(a==0){ pos=pos-1; }
    else {
      if(a==1){ pos=pos+1; }
      else {
        set8(out,ooff+n,pos);
        n=n+1;
      }
    }
    i=i+1;
  }
  let k:i32=1;
  while(k<n){
    let v:i32=get8(out,ooff+k);
    let j:i32=k-1;
    let go:i32=1;
    while(go==1){
      let stop:i32=0;
      if(j<0){ stop=1; }
      if(stop==0){
        if(get8(out,ooff+j)<=v){ stop=1; }
      }
      if(stop==1){ go=0; }
      else {
        set8(out,ooff+j+1,get8(out,ooff+j));
        j=j-1;
      }
    }
    set8(out,ooff+j+1,v);
    k=k+1;
  }
  return n;
}
// Learner-owned stakes: revealed-preference bar from experienced train
// net outcomes. Reads only tnet (experienced nets), tadj (the
// learner's own train scores), and tbkt. The world cost parameter and
// the decomposed effect table never enter: ownership by structure
// (audited K1-A10b). Global version: argmax over integer bars of the
// train net above the bar; data-driven range; ties toward the larger
// bar (conservative). Flat control flow.
fn lok_global(tadj:[]u8, tnet:[]u8)i32 {
  let mn:i32=1000000;
  let mx:i32=-1000000;
  let t:i32=0;
  while(t<NTRAIN){
    let a:i32=get32(tadj,4*t);
    if(a<mn){ mn=a; }
    if(a>mx){ mx=a; }
    t=t+1;
  }
  let bestp:i32=-1000000;
  let bestb:i32=mx;
  let b:i32=mx;
  while(b>=mn-1){
    let p:i32=0;
    let t2:i32=0;
    while(t2<NTRAIN){
      let above:i32=0;
      if(get32(tadj,4*t2)>b){ above=1; }
      if(above==1){ p=p+get32(tnet,4*t2); }
      t2=t2+1;
    }
    if(p>bestp){ bestp=p; bestb=b; }
    b=b-1;
  }
  return bestb;
}
// Per-bucket version of the revealed-preference bar (context-adaptive
// owned stakes). Same rules restricted to train cases in bucket b.
// Empty bucket (never occurs on the committed train table) falls back
// to bar 0, deterministically.
fn lok_bucket(tadj:[]u8, tnet:[]u8, tbkt:[]u8, b:i32)i32 {
  let mn:i32=1000000;
  let mx:i32=-1000000;
  let cnt:i32=0;
  let t:i32=0;
  while(t<NTRAIN){
    let inb:i32=0;
    if(get32(tbkt,4*t)==b){ inb=1; }
    if(inb==1){
      cnt=cnt+1;
      let a:i32=get32(tadj,4*t);
      if(a<mn){ mn=a; }
      if(a>mx){ mx=a; }
    }
    t=t+1;
  }
  if(cnt==0){ return 0; }
  let bestp:i32=-1000000;
  let bestb:i32=mx;
  let c:i32=mx;
  while(c>=mn-1){
    let p:i32=0;
    let t2:i32=0;
    while(t2<NTRAIN){
      let inb2:i32=0;
      if(get32(tbkt,4*t2)==b){ inb2=1; }
      let above2:i32=0;
      if(get32(tadj,4*t2)>c){ above2=1; }
      let use2:i32=inb2*above2;
      if(use2==1){ p=p+get32(tnet,4*t2); }
      t2=t2+1;
    }
    if(p>bestp){ bestp=p; bestb=c; }
    c=c-1;
  }
  return bestb;
}

// ===== LEARNER-OWNED EVALUATION (new this wave) =====
// SE1a: prospective naive self-estimate. P(bar) = sum of experienced
// train nets over train cases with tadj > bar. Reads only tadj, tnet:
// zero teff tokens in the body (K1-A10). Flat control flow.
fn se_p(tadj:[]u8, tnet:[]u8, bar:i32)i32 {
  let p:i32=0;
  let t:i32=0;
  while(t<NTRAIN){
    let above:i32=0;
    if(get32(tadj,4*t)>bar){ above=1; }
    if(above==1){ p=p+get32(tnet,4*t); }
    t=t+1;
  }
  return p;
}
// SE1b: knife-edge profit-at-risk. PEN(bar) = sum of |tnet| over train
// cases with |tadj - bar| <= 1: the experienced profit sitting within
// one unit of the decision boundary. Reads only tadj, tnet (K1-A10).
fn se_pen(tadj:[]u8, tnet:[]u8, bar:i32)i32 {
  let pen:i32=0;
  let t:i32=0;
  while(t<NTRAIN){
    let d:i32=get32(tadj,4*t)-bar;
    if(d<0){ d=0-d; }
    let near:i32=0;
    if(d<=1){ near=1; }
    if(near==1){
      let n:i32=get32(tnet,4*t);
      if(n<0){ n=0-n; }
      pen=pen+n;
    }
    t=t+1;
  }
  return pen;
}
// SE1c: per-bucket prospective naive self-estimate. Sum over train
// cases of tnet where tadj > bars[tbkt]. Reads tadj, tnet, tbkt only.
fn se_ppb(tadj:[]u8, tnet:[]u8, tbkt:[]u8, bars:[]u8)i32 {
  let p:i32=0;
  let t:i32=0;
  while(t<NTRAIN){
    let bar:i32=get32(bars,4*get32(tbkt,4*t));
    let above:i32=0;
    if(get32(tadj,4*t)>bar){ above=1; }
    if(above==1){ p=p+get32(tnet,4*t); }
    t=t+1;
  }
  return p;
}
// SE1d: per-bucket knife-edge profit-at-risk. Sum of |tnet| over train
// cases with |tadj - bars[tbkt]| <= 1. Reads tadj, tnet, tbkt only.
fn se_ppenb(tadj:[]u8, tnet:[]u8, tbkt:[]u8, bars:[]u8)i32 {
  let pen:i32=0;
  let t:i32=0;
  while(t<NTRAIN){
    let bar:i32=get32(bars,4*get32(tbkt,4*t));
    let d:i32=get32(tadj,4*t)-bar;
    if(d<0){ d=0-d; }
    let near:i32=0;
    if(d<=1){ near=1; }
    if(near==1){
      let n:i32=get32(tnet,4*t);
      if(n<0){ n=0-n; }
      pen=pen+n;
    }
    t=t+1;
  }
  return pen;
}
// SE2: retrospective self-evaluation. The learner totals its experienced
// sealed nets (snet: the consequence interface, filled harness-side in
// CONSEQUENCE from already-executed world calls). Reads only snet and
// go: the body never reads the decomposed-effect table (K1-A10).
// Nothing hidden is consulted.
fn se_retro(snet:[]u8, go:[]u8)i32 {
  let p:i32=0;
  let s:i32=0;
  while(s<NSEAL){
    let g:i32=0;
    if(get32(go,4*s)==1){ g=1; }
    if(g==1){ p=p+get32(snet,4*s); }
    s=s+1;
  }
  return p;
}

// Runs the world's response for one arm's GO cases; returns profit.
// Single world_execute call site for all arm consequences (K1-A5).
// Also records the experienced net per case into snet (the consequence
// interface for the learner's retrospective self-evaluation): snet[s] =
// se - EXCOST for GO cases, 0 otherwise. Zero new world calls.
fn conseq_arm(wseal:[]u8, pseal:[]u8, sL:[]u8, go:[]u8, cseal:[]u8, etmp:[]u8, wc:[]u8, snet:[]u8)i32 {
  let profit:i32=0;
  let s:i32=0;
  while(s<NSEAL){
    let g:i32=get32(go,4*s);
    if(g==1){
      let sL2:i32=get32(sL,4*s);
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL2, cseal, s*RECC, etmp, 0, wc);
      let sc:i32=get32(cseal,s*RECC);
      let su:i32=get32(cseal,s*RECC+4);
      let se:i32=0;
      if(su>0){ se=(100*sc)/su; }
      profit=profit+se-EXCOST;
      set32(snet,4*s,se-EXCOST);
    }
    if(g==0){ set32(snet,4*s,0); }
    s=s+1;
  }
  return profit;
}

// ===== MAIN: learner-owned evaluation =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCLE-BEGIN\n");
  // Train buffers.
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let tbkt:[]u8=z_alloc(NTRAIN*4);
  let teff:[]u8=z_alloc(NTRAIN*4);
  let preff_tr:[]u8=z_alloc(NTRAIN*4);
  // UCB tables.
  let biassum:[]u8=z_alloc(16);
  let biascnt:[]u8=z_alloc(16);
  let bias:[]u8=z_alloc(16);
  let bsq:[]u8=z_alloc(16);
  let bucb:[]u8=z_alloc(16);
  // Experienced train net outcomes (harness-reported) and the
  // learner's own train scores (convenience buffer for the stakes
  // computation).
  let tnet:[]u8=z_alloc(NTRAIN*4);
  let tadj:[]u8=z_alloc(NTRAIN*4);
  // Sealed buffers.
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let preff:[]u8=z_alloc(NSEAL*4);
  let sL:[]u8=z_alloc(NSEAL*4);
  let sstart:[]u8=z_alloc(NSEAL*4);
  // Learner GO decisions (per sealed batch).
  let go_uwk:[]u8=z_alloc(NSEAL*4);
  let go_ulok:[]u8=z_alloc(NSEAL*4);
  let go_ulokb:[]u8=z_alloc(NSEAL*4);
  // Profit per arm per batch (3 batches).
  let p_uwk:[]u8=z_alloc(12);
  let p_ulok:[]u8=z_alloc(12);
  let p_ulokb:[]u8=z_alloc(12);
  let pall:[]u8=z_alloc(12);
  // Bars per batch (verbatim lineage bars, K3 check).
  let thyA_a:[]u8=z_alloc(12);
  let thyB_a:[]u8=z_alloc(12);
  let tvucb_a:[]u8=z_alloc(12);
  let thykc_a:[]u8=z_alloc(12);
  // Train per-bucket miscalibration (learner-visible on train).
  let msum:[]u8=z_alloc(16);
  let mcnt:[]u8=z_alloc(16);
  let mcalib:[]u8=z_alloc(16);
  // Per-bucket bars: V_PBK (K + mcalib) and V_PBOPT
  // (train-profit-optimal, ties toward K). Verbatim lineage, K3.
  let pbkbar:[]u8=z_alloc(16);
  let pboptbar:[]u8=z_alloc(16);
  // Learner-owned stakes bars: global (V_LOK) and per-bucket
  // (V_LOKB). Computed by lok_global / lok_bucket from train
  // experience only.
  let lokbar:i32=0;
  let lokbbar:[]u8=z_alloc(16);
  // Experienced sealed nets per arm (consequence interface, filled
  // harness-side in CONSEQUENCE; the learner's retrospective
  // self-evaluation reads these, never eff).
  let snet_uwk:[]u8=z_alloc(NSEAL*4);
  let snet_ulok:[]u8=z_alloc(NSEAL*4);
  let snet_ulokb:[]u8=z_alloc(NSEAL*4);
  // Retrospective self-evaluation per arm per batch (learner).
  let se_wk:[]u8=z_alloc(12);
  let se_lok:[]u8=z_alloc(12);
  let se_lokb:[]u8=z_alloc(12);
  // Prospective self-evaluation (learner, train-only commitment):
  // naive estimates, knife-edge penalties, penalized estimates,
  // self-error flags, per verdict.
  let sest_wk:i32=0;
  let sest_lok:i32=0;
  let sest_lokb:i32=0;
  let spen_wk:i32=0;
  let spen_lok:i32=0;
  let spen_lokb:i32=0;
  let pp_wk:i32=0;
  let pp_lok:i32=0;
  let pp_lokb:i32=0;
  let flag_wk:i32=0;
  let flag_lok:i32=0;
  let flag_lokb:i32=0;
  // Misc.
  let adjucb:[]u8=z_alloc(NSEAL*4);
  let sbkt:[]u8=z_alloc(NSEAL*4);
  let wc:[]u8=z_alloc(4);
  let etmp:[]u8=z_alloc(EREC);
  let gout2:[]u8=z_alloc(CW);
  let k1:i32=1;
  let Tfixed:i32=0;
  let Cval:i32=0;
  let eq_lok_wk:i32=1;
  // PHASE: train SETUP (harness; wp=15; seeds verbatim).
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, 15, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // PHASE: train COMMIT (learner; beliefs only).
  let wcb0:i32=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  if(get32(wc,0)!=wcb0){ k1=0; }
  // PHASE: train PREFF (learner).
  wcb0=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    let tg:i32=get32(mtrain,t*RECM);
    let tL:i32=get32(mtrain,t*RECM+4);
    let tp:i32=0;
    if(tL>0){ tp=(100*tg)/tL; }
    set32(preff_tr,4*t,tp);
    t=t+1;
  }
  if(get32(wc,0)!=wcb0){ k1=0; }
  // PHASE: train CONSEQ (harness).
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // PHASE: train LEARN (learner). (bucket, eff) pairs; UCB tables.
  t=0;
  while(t<NTRAIN){
    let bk:i32=get32(mtrain,t*RECM+12);
    let tc:i32=get32(ctrain,t*RECC);
    let te:i32=get32(ctrain,t*RECC+4);
    let tf:i32=0;
    if(te>0){ tf=(100*tc)/te; }
    set32(tbkt,4*t,bk);
    set32(teff,4*t,tf);
    t=t+1;
  }
  let b:i32=0;
  while(b<4){
    set32(biassum,4*b,0);
    set32(biascnt,4*b,0);
    set32(bsq,4*b,0);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk2:i32=get32(tbkt,4*t);
    let d:i32=get32(preff_tr,4*t)-get32(teff,4*t);
    if(bk2>=0){
      if(bk2<4){
        set32(biassum,4*bk2,get32(biassum,4*bk2)+d);
        set32(biascnt,4*bk2,get32(biascnt,4*bk2)+1);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let bb:i32=0;
    if(get32(biascnt,4*b)>0){ bb=get32(biassum,4*b)/get32(biascnt,4*b); }
    set32(bias,4*b,bb);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk5:i32=get32(tbkt,4*t);
    if(bk5>=0){
      if(bk5<4){
        let mb5:i32=get32(bias,4*bk5);
        let d5:i32=get32(preff_tr,4*t)-get32(teff,4*t);
        let e5:i32=d5-mb5;
        set32(bsq,4*bk5,get32(bsq,4*bk5)+e5*e5);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let mb6:i32=get32(bias,4*b);
    let nb6:i32=get32(biascnt,4*b);
    let ub:i32=0;
    if(nb6>0){ ub=mb6; }
    if(nb6>1){ ub=mb6+isqrt(get32(bsq,4*b)/(nb6-1)); }
    set32(bucb,4*b,ub);
    b=b+1;
  }
  // Train per-bucket miscalibration M_train[b]: mean over train
  // cases in bucket b of (adj - eff), where adj = preff - bucb[b].
  // All quantities are learner-visible on train (consequences
  // realized in train CONSEQ). Integer division, trunc toward zero.
  b=0;
  while(b<4){
    set32(msum,4*b,0);
    set32(mcnt,4*b,0);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let mbk:i32=get32(tbkt,4*t);
    if(mbk>=0){
      if(mbk<4){
        let madj:i32=get32(preff_tr,4*t)-get32(bucb,4*mbk);
        let mr:i32=madj-get32(teff,4*t);
        set32(msum,4*mbk,get32(msum,4*mbk)+mr);
        set32(mcnt,4*mbk,get32(mcnt,4*mbk)+1);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let mm:i32=0;
    if(get32(mcnt,4*b)>0){ mm=get32(msum,4*b)/get32(mcnt,4*b); }
    set32(mcalib,4*b,mm);
    b=b+1;
  }
  // Train-profit-optimal per-bucket bars (learner, verbatim). For
  // bucket b: bar*_b maximizes P_b(bar) = sum over train cases in
  // bucket b with adj > bar of (eff - EXCOST); ties broken toward
  // EXCOST (then the larger bar). All quantities are learner-visible
  // on train. Candidate bars range over [min_adj-1,
  // max(max_adj, EXCOST)]; the EXCOST-closest optimal bar always
  // lies in this range. Kept verbatim for the K3 check.
  b=0;
  while(b<4){
    set32(pbkbar,4*b,EXCOST+get32(mcalib,4*b));
    let bcnt:i32=0;
    let bmn:i32=1000000;
    let bmx:i32=-1000000;
    let t2:i32=0;
    while(t2<NTRAIN){
      if(get32(tbkt,4*t2)==b){
        bcnt=bcnt+1;
        let ta:i32=get32(preff_tr,4*t2)-get32(bucb,4*b);
        if(ta<bmn){ bmn=ta; }
        if(ta>bmx){ bmx=ta; }
      }
      t2=t2+1;
    }
    let bbar:i32=EXCOST;
    if(bcnt>0){
      let bhi:i32=bmx;
      if(EXCOST>bhi){ bhi=EXCOST; }
      let bestp:i32=-1000000;
      let bestc:i32=EXCOST;
      let bestad:i32=1000000;
      let c:i32=bmn-1;
      while(c<=bhi){
        let cp:i32=0;
        let t3:i32=0;
        while(t3<NTRAIN){
          if(get32(tbkt,4*t3)==b){
            let ta3:i32=get32(preff_tr,4*t3)-get32(bucb,4*b);
            if(ta3>c){
              cp=cp+get32(teff,4*t3)-EXCOST;
            }
          }
          t3=t3+1;
        }
        let cad:i32=c-EXCOST;
        if(cad<0){ cad=0-cad; }
        let gt:i32=0;
        if(cp>bestp){ gt=1; }
        let eq:i32=0;
        if(cp==bestp){ eq=1; }
        let lt:i32=0;
        if(cad<bestad){ lt=1; }
        let eqad:i32=0;
        if(cad==bestad){ eqad=1; }
        let gtc:i32=0;
        if(c>bestc){ gtc=1; }
        let take:i32=gt+eq*lt+eq*eqad*gtc;
        if(take>0){
          bestp=cp;
          bestc=c;
          bestad=cad;
        }
        c=c+1;
      }
      bbar=bestc;
    }
    set32(pboptbar,4*b,bbar);
    b=b+1;
  }
  // PHASE: train TNET (harness). Experienced net outcomes per train
  // case: tnet[t] = teff[t] - EXCOST -- what the learner lived
  // through (reward minus charge, one number). tadj[t] is the
  // learner's own train score, copied here for the stakes
  // computation. Pure arithmetic on the CONSEQ-filled buffers;
  // zero world calls.
  t=0;
  while(t<NTRAIN){
    set32(tnet,4*t,get32(teff,4*t)-EXCOST);
    let tbk9:i32=get32(tbkt,4*t);
    set32(tadj,4*t,get32(preff_tr,4*t)-get32(bucb,4*tbk9));
    t=t+1;
  }
  // PHASE: train LOKBARS (learner). The learner owns its stakes:
  // lokbar (global revealed bar) and lokbbar[b] (per-bucket
  // revealed bars) from experienced train nets via lok_global /
  // lok_bucket. Neither function reads the world cost parameter
  // or the decomposed effect table (K1-A10b).
  lokbar=lok_global(tadj,tnet);
  b=0;
  while(b<4){
    set32(lokbbar,4*b,lok_bucket(tadj,tnet,tbkt,b));
    b=b+1;
  }
  // PHASE: train SELFEVAL (learner). Prospective self-evaluation:
  // the learner commits to a self-assessment of each verdict BEFORE
  // any sealed case, from train experience alone (tadj, tnet, tbkt).
  // Naive: train experienced net above the bar. Penalized: minus the
  // knife-edge profit-at-risk. Flag: 1 iff 2*PEN > P and P > 0
  // (relative rule; no magnitude constant). No sealed quantity is
  // read; no hidden labels (K1-A10).
  sest_wk=se_p(tadj,tnet,EXCOST);
  spen_wk=se_pen(tadj,tnet,EXCOST);
  pp_wk=sest_wk-spen_wk;
  sest_lok=se_p(tadj,tnet,lokbar);
  spen_lok=se_pen(tadj,tnet,lokbar);
  pp_lok=sest_lok-spen_lok;
  sest_lokb=se_ppb(tadj,tnet,tbkt,lokbbar);
  spen_lokb=se_ppenb(tadj,tnet,tbkt,lokbbar);
  pp_lokb=sest_lokb-spen_lokb;
  let f1:i32=0;
  if(2*spen_wk>sest_wk){
    if(sest_wk>0){ f1=1; }
  }
  flag_wk=f1;
  let f2:i32=0;
  if(2*spen_lok>sest_lok){
    if(sest_lok>0){ f2=1; }
  }
  flag_lok=f2;
  let f3:i32=0;
  if(2*spen_lokb>sest_lokb){
    if(sest_lokb>0){ f3=1; }
  }
  flag_lokb=f3;
  at=ob_app(ob,at,"SELFEVAL sest_wk=");
  at=ob_i32(ob,at,sest_wk);
  at=ob_app(ob,at," spen_wk=");
  at=ob_i32(ob,at,spen_wk);
  at=ob_app(ob,at," pp_wk=");
  at=ob_i32(ob,at,pp_wk);
  at=ob_app(ob,at," flag_wk=");
  at=ob_i32(ob,at,flag_wk);
  at=ob_app(ob,at," sest_lok=");
  at=ob_i32(ob,at,sest_lok);
  at=ob_app(ob,at," spen_lok=");
  at=ob_i32(ob,at,spen_lok);
  at=ob_app(ob,at," pp_lok=");
  at=ob_i32(ob,at,pp_lok);
  at=ob_app(ob,at," flag_lok=");
  at=ob_i32(ob,at,flag_lok);
  at=ob_app(ob,at," sest_lokb=");
  at=ob_i32(ob,at,sest_lokb);
  at=ob_app(ob,at," spen_lokb=");
  at=ob_i32(ob,at,spen_lokb);
  at=ob_app(ob,at," pp_lokb=");
  at=ob_i32(ob,at,pp_lokb);
  at=ob_app(ob,at," flag_lokb=");
  at=ob_i32(ob,at,flag_lokb);
  at=ob_nl(ob,at);
  // PHASE: train BAR (learner). T_fixed = mean train adjV_UCB.
  let tfsum:i32=0;
  t=0;
  while(t<NTRAIN){
    let tbk:i32=get32(tbkt,4*t);
    tfsum=tfsum+get32(preff_tr,4*t)-get32(bucb,4*tbk);
    t=t+1;
  }
  Tfixed=tfsum/NTRAIN;
  at=ob_app(ob,at,"TFIXED=");
  at=ob_i32(ob,at,Tfixed);
  at=ob_nl(ob,at);
  // Hybrid offset C = mean over train of bucb[bkt_tr] (train-fixed).
  let csum:i32=0;
  t=0;
  while(t<NTRAIN){
    let cbk:i32=get32(tbkt,4*t);
    csum=csum+get32(bucb,4*cbk);
    t=t+1;
  }
  Cval=csum/NTRAIN;
  at=ob_app(ob,at,"CVAL=");
  at=ob_i32(ob,at,Cval);
  at=ob_nl(ob,at);
  // UCB table (learner, K3 check).
  at=ob_app(ob,at,"BUCB=");
  b=0;
  while(b<4){
    at=ob_i32(ob,at,get32(bucb,4*b));
    at=ob_app(ob,at," ");
    b=b+1;
  }
  at=ob_nl(ob,at);
  // Per-bucket bars (verbatim lineage, K3 check).
  at=ob_app(ob,at,"PBBARS mcalib=");
  b=0;
  while(b<4){
    at=ob_i32(ob,at,get32(mcalib,4*b));
    at=ob_app(ob,at," ");
    b=b+1;
  }
  at=ob_app(ob,at,"pbk=");
  b=0;
  while(b<4){
    at=ob_i32(ob,at,get32(pbkbar,4*b));
    at=ob_app(ob,at," ");
    b=b+1;
  }
  at=ob_app(ob,at,"pbopt=");
  b=0;
  while(b<4){
    at=ob_i32(ob,at,get32(pboptbar,4*b));
    at=ob_app(ob,at," ");
    b=b+1;
  }
  at=ob_nl(ob,at);
  // Learner-owned stakes bars (K3 new quantities).
  at=ob_app(ob,at,"LOKBARS lokbar=");
  at=ob_i32(ob,at,lokbar);
  at=ob_app(ob,at," lokb=");
  b=0;
  while(b<4){
    at=ob_i32(ob,at,get32(lokbbar,4*b));
    at=ob_app(ob,at," ");
    b=b+1;
  }
  at=ob_nl(ob,at);
  // TA-train audit (learner-visible only).
  at=ob_app(ob,at,"TAUDIT t bkt preff eff d adj\n");
  t=0;
  while(t<NTRAIN){
    let abk:i32=get32(tbkt,4*t);
    at=ob_app(ob,at,"TA t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,abk);
    at=ob_app(ob,at," preff=");
    at=ob_i32(ob,at,get32(preff_tr,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(teff,4*t));
    at=ob_app(ob,at," adj=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(bucb,4*abk));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // PHASE: sealed SHIFT LOOP. sh=0..2, wp=15/30/45.
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    // PHASE: sealed SETUP (harness; seeds verbatim).
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // PHASE: sealed COMMIT (learner). No world calls.
    wcb0=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      let sg:i32=get32(mseal,s*RECM);
      let sLl:i32=get32(mseal,s*RECM+4);
      let sq:i32=0;
      if(sLl>0){ sq=(100*sg)/sLl; }
      set32(preff,4*s,sq);
      set32(sL,4*s,sLl);
      set32(sstart,4*s,get8(bseal,s*RECW+2*CW));
      let sbk:i32=get32(mseal,s*RECM+12);
      set32(adjucb,4*s,sq-get32(bucb,4*sbk));
      set32(sbkt,4*s,sbk);
      s=s+1;
    }
    if(get32(wc,0)!=wcb0){ k1=0; }
    // PHASE: sealed BARS (learner). No world data.
    // V_HA: ThyA = mean_sealed(preff) - C. V_HB: ThyB =
    // mean_sealed(preff - bucb_frozen[bkt]). V_HKC: ThyHKC =
    // max(ThyA, EXCOST). These lineage bars are computed and
    // printed for the K3 verbatim-machinery check; their verdict
    // arms are not re-run in this wave.
    let totucb:i32=0;
    let totp:i32=0;
    s=0;
    while(s<NSEAL){
      totucb=totucb+get32(adjucb,4*s);
      totp=totp+get32(preff,4*s);
      s=s+1;
    }
    let TVucb:i32=totucb/NSEAL;
    let ThyA:i32=totp/NSEAL-Cval;
    let ThyB:i32=totucb/NSEAL;
    let ThyHKC:i32=ThyA;
    if(EXCOST>ThyHKC){ ThyHKC=EXCOST; }
    set32(tvucb_a,4*sh,TVucb);
    set32(thyA_a,4*sh,ThyA);
    set32(thyB_a,4*sh,ThyB);
    set32(thykc_a,4*sh,ThyHKC);
    at=ob_app(ob,at,"BARS sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," TVucb=");
    at=ob_i32(ob,at,TVucb);
    at=ob_app(ob,at," Tfixed=");
    at=ob_i32(ob,at,Tfixed);
    at=ob_app(ob,at," ThyA=");
    at=ob_i32(ob,at,ThyA);
    at=ob_app(ob,at," ThyB=");
    at=ob_i32(ob,at,ThyB);
    at=ob_app(ob,at," ThyHKC=");
    at=ob_i32(ob,at,ThyHKC);
    at=ob_nl(ob,at);
    // PHASE: sealed VERDICT (learner). GO = 1 iff score > bar.
    // Rendered BEFORE any consequence; the learner never sees eff.
    // UCB x V_WK (verbatim control, bar = EXCOST), UCB x V_LOK
    // (MAIN-1, bar = lokbar, owned), UCB x V_LOKB (MAIN-2, bar =
    // lokbbar[sbkt_s], owned per bucket). eq_lok_wk accumulates
    // per-case GO equality between V_LOK and V_WK (K6).
    let cuwk:i32=0;
    let culok:i32=0;
    let culokb:i32=0;
    s=0;
    while(s<NSEAL){
      let sbk5:i32=get32(sbkt,4*s);
      let guwk:i32=0;
      if(get32(adjucb,4*s)>EXCOST){ guwk=1; }
      set32(go_uwk,4*s,guwk);
      cuwk=cuwk+guwk;
      let gulok:i32=0;
      if(get32(adjucb,4*s)>lokbar){ gulok=1; }
      set32(go_ulok,4*s,gulok);
      culok=culok+gulok;
      if(gulok!=guwk){ eq_lok_wk=0; }
      let gulokb:i32=0;
      if(get32(adjucb,4*s)>get32(lokbbar,4*sbk5)){ gulokb=1; }
      set32(go_ulokb,4*s,gulokb);
      culokb=culokb+gulokb;
      s=s+1;
    }
    // PHASE: CONSEQUENCE (harness). The world responds to real
    // commitments only: world_execute runs on GO cases; profit
    // accumulates (eff - EXCOST). Experienced nets per case are
    // recorded into the snet buffers (the consequence interface).
    let p1:i32=conseq_arm(wseal, pseal, sL, go_uwk, cseal, etmp, wc, snet_uwk);
    let p2:i32=conseq_arm(wseal, pseal, sL, go_ulok, cseal, etmp, wc, snet_ulok);
    let p3:i32=conseq_arm(wseal, pseal, sL, go_ulokb, cseal, etmp, wc, snet_ulokb);
    set32(p_uwk,4*sh,p1);
    set32(p_ulok,4*sh,p2);
    set32(p_ulokb,4*sh,p3);
    // PHASE: SELFREPORT (learner). Retrospective self-evaluation:
    // the learner totals its experienced sealed nets per arm. Reads
    // only snet/go (experienced); no eff, no hidden labels (K1-A10).
    let se1:i32=se_retro(snet_uwk,go_uwk);
    let se2:i32=se_retro(snet_ulok,go_ulok);
    let se3:i32=se_retro(snet_ulokb,go_ulokb);
    set32(se_wk,4*sh,se1);
    set32(se_lok,4*sh,se2);
    set32(se_lokb,4*sh,se3);
    at=ob_app(ob,at,"SELFREPORT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," se_wk=");
    at=ob_i32(ob,at,se1);
    at=ob_app(ob,at," se_lok=");
    at=ob_i32(ob,at,se2);
    at=ob_app(ob,at," se_lokb=");
    at=ob_i32(ob,at,se3);
    at=ob_nl(ob,at);
    // PHASE: REFERENCE (fenced harness). Execute-all profit per
    // batch (counterfactual; never learner-visible).
    let pallv:i32=0;
    s=0;
    while(s<NSEAL){
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, get32(sL,4*s), cseal, s*RECC, etmp, 0, wc);
      let sca:i32=get32(cseal,s*RECC);
      let sua:i32=get32(cseal,s*RECC+4);
      let sea:i32=0;
      if(sua>0){ sea=(100*sca)/sua; }
      pallv=pallv+sea-EXCOST;
      s=s+1;
    }
    set32(pall,4*sh,pallv);
    at=ob_app(ob,at,"PROFIT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," uwk=");
    at=ob_i32(ob,at,p1);
    at=ob_app(ob,at," guwk=");
    at=ob_i32(ob,at,cuwk);
    at=ob_app(ob,at," ulok=");
    at=ob_i32(ob,at,p2);
    at=ob_app(ob,at," gulok=");
    at=ob_i32(ob,at,culok);
    at=ob_app(ob,at," ulokb=");
    at=ob_i32(ob,at,p3);
    at=ob_app(ob,at," gulokb=");
    at=ob_i32(ob,at,culokb);
    at=ob_app(ob,at," all=");
    at=ob_i32(ob,at,pallv);
    at=ob_nl(ob,at);
    sh=sh+1;
  }
  // WC final audit.
  at=ob_app(ob,at,"WC-FINAL=");
  at=ob_i32(ob,at,get32(wc,0));
  at=ob_nl(ob,at);
  // Kill-bar flags (in-program exact checks vs prereg predictions).
  // K3: verbatim machinery + new quantities. Sub-flags keep
  // nesting shallow.
  let k3a:i32=0;
  if(get32(thyA_a,0)==13){
    if(get32(thyA_a,4)==20){
      if(get32(thyA_a,8)==6){
        if(get32(thyB_a,0)==13){
          if(get32(thyB_a,4)==20){
            if(get32(thyB_a,8)==13){
              if(Tfixed==12){
                if(Cval==15){
                  if(get32(thykc_a,0)==15){
                    if(get32(thykc_a,4)==20){
                      if(get32(thykc_a,8)==15){ k3a=1; }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  let k3b:i32=0;
  if(get32(bucb,0)==0){
    if(get32(bucb,4)==16){
      if(get32(bucb,8)==27){
        if(get32(bucb,12)==20){
          if(get32(mcalib,0)==0){
            if(get32(mcalib,4)==-11){
              if(get32(mcalib,8)==-12){
                if(get32(mcalib,12)==-3){
                  if(get32(pbkbar,0)==15){
                    if(get32(pbkbar,4)==4){
                      if(get32(pbkbar,8)==3){
                        if(get32(pbkbar,12)==12){
                          if(get32(pboptbar,0)==15){
                            if(get32(pboptbar,4)==16){
                              if(get32(pboptbar,8)==5){
                                if(get32(pboptbar,12)==15){ k3b=1; }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  // K3 new quantities: learner-owned stakes bars.
  let k3c:i32=0;
  if(lokbar==14){
    if(get32(lokbbar,0)==0){
      if(get32(lokbbar,4)==16){
        if(get32(lokbbar,8)==5){
          if(get32(lokbbar,12)==9){ k3c=1; }
        }
      }
    }
  }
  let k3d:i32=0;
  if(get32(p_uwk,0)==75){
    if(get32(p_uwk,4)==128){
      if(get32(p_uwk,8)==55){
        if(get32(pall,0)==43){
          if(get32(pall,4)==113){
            if(get32(pall,8)==-80){ k3d=1; }
          }
        }
      }
    }
  }
  // K3 new quantities: learner-owned self-evaluation (frozen
  // predictions: SEST_NAIVE (238,265,268), SEST_PEN (211,238,93),
  // FLAG (0,0,1)). Sub-flags keep nesting shallow.
  let k3e1:i32=0;
  if(sest_wk==238){
    if(sest_lok==265){
      if(sest_lokb==268){ k3e1=1; }
    }
  }
  let k3e2:i32=0;
  if(pp_wk==211){
    if(pp_lok==238){
      if(pp_lokb==93){ k3e2=1; }
    }
  }
  let k3e3:i32=0;
  if(flag_wk==0){
    if(flag_lok==0){
      if(flag_lokb==1){ k3e3=1; }
    }
  }
  let k3e:i32=0;
  if(k3e1==1){
    if(k3e2==1){
      if(k3e3==1){ k3e=1; }
    }
  }
  let k3ab:i32=0;
  if(k3a==1){
    if(k3b==1){ k3ab=1; }
  }
  let k3cd:i32=0;
  if(k3c==1){
    if(k3d==1){ k3cd=1; }
  }
  let k3:i32=0;
  if(k3ab==1){
    if(k3cd==1){
      if(k3e==1){ k3=1; }
    }
  }
  let tot_uwk:i32=get32(p_uwk,0)+get32(p_uwk,4)+get32(p_uwk,8);
  let tot_ulok:i32=get32(p_ulok,0)+get32(p_ulok,4)+get32(p_ulok,8);
  let tot_ulokb:i32=get32(p_ulokb,0)+get32(p_ulokb,4)+get32(p_ulokb,8);
  let se_wk_tot:i32=get32(se_wk,0)+get32(se_wk,4)+get32(se_wk,8);
  let se_lok_tot:i32=get32(se_lok,0)+get32(se_lok,4)+get32(se_lok,8);
  let se_lokb_tot:i32=get32(se_lokb,0)+get32(se_lokb,4)+get32(se_lokb,8);
  // K4 (PRIMARY): retrospective self-evaluation equals harness profit
  // per arm exactly. The learner evaluates itself from its experienced
  // consequences with no label comparison.
  let k4a:i32=0;
  if(se_wk_tot==tot_uwk){
    if(se_lok_tot==tot_ulok){
      if(se_lokb_tot==tot_ulokb){ k4a=1; }
    }
  }
  let k4b:i32=0;
  if(tot_uwk==258){
    if(tot_ulok==258){
      if(tot_ulokb==228){ k4b=1; }
    }
  }
  let k4:i32=0;
  if(k4a==1){
    if(k4b==1){ k4=1; }
  }
  // K5 (PRIMARY, preregistered NULL): naive prospective
  // self-evaluation is anti-calibrated. It ranks the overfitter first
  // (268 > 265 > 238) while the harness ranks it last (228 < 258).
  // Train-fit self-evaluation misleads: this is why harness evaluation
  // seemed necessary.
  let k5a:i32=0;
  if(sest_lokb>sest_lok){
    if(sest_lok>sest_wk){ k5a=1; }
  }
  let k5b:i32=0;
  if(tot_ulokb<tot_ulok){ k5b=1; }
  let k5:i32=0;
  if(k5a==1){
    if(k5b==1){ k5=1; }
  }
  // K6: fragility-penalized self-evaluation discriminates the overfit:
  // the failing verdict's penalized estimate is strictly below both
  // global verdicts (93 < 211, 93 < 238).
  let k6:i32=0;
  if(pp_lokb<pp_wk){
    if(pp_lokb<pp_lok){ k6=1; }
  }
  // K7: the self-error flag fires exactly on the failing verdict
  // (from train data alone, no hidden labels).
  let k7:i32=0;
  if(flag_wk==0){
    if(flag_lok==0){
      if(flag_lokb==1){ k7=1; }
    }
  }
  // K8: world-call budget unchanged (snet recording adds zero calls).
  let k8:i32=0;
  if(get32(wc,0)==113){ k8=1; }
  at=ob_app(ob,at,"SEFLAGS K4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," K5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," K6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," K7=");
  at=ob_i32(ob,at,k7);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K1STRUCT=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," K3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," K4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," K5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," K6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," K7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," K8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCLE-END\n");
  let out:[]u8=ob[0..at];
  _zag_print(out);
  return 0;
}

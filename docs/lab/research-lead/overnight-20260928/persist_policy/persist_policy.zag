// persist_policy.zag -- Program 7: persistence policy (P7) test.
// Prereg 436b8ac24 frozen before this file. Pure Zag.
// Tests P7 (persist validated schemas only; verify; retire) vs
// E (persist everything: schema + verbatim instance) vs
// N (persist nothing: fresh NN) on an 8-task synthetic workload.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ---- train points: x_j = 4 + 7*j + ((11*t) mod 5), j = 0..12 ----
fn tx(t:i32,j:i32)i32 {
  let o:i32=11*t;
  o=o-(o/5)*5;
  return 4+7*j+o;
}
// ---- reduced set: 10 points, drop full indices 4,6,8 ----
fn rdx(k:i32)i32 {
  if(k==0){return 0;} if(k==1){return 1;} if(k==2){return 2;}
  if(k==3){return 3;} if(k==4){return 5;} if(k==5){return 7;}
  if(k==6){return 9;} if(k==7){return 10;} if(k==8){return 11;}
  return 12;
}
fn task_kind(t:i32)i32 {
  if(t==5){return 1;}
  if(t==6){return 2;}
  if(t==7){return 3;}
  return 0;
}
fn task_t(t:i32)i32 {
  if(t==1){return 30;}
  if(t==2){return 73;}
  if(t==3){return 20;}
  if(t==4){return 55;}
  if(t==8){return 66;}
  return 30;
}
fn true_label(t:i32,x:i32)i32 {
  let k:i32=task_kind(t);
  if(k==1){ return x-(x/2)*2; }
  if(k==2){ if(x<40){return 1;} return 0; }
  if(k==3){ if(x>=25){ if(x<=70){return 1;} } return 0; }
  if(x>=task_t(t)){return 1;}
  return 0;
}
fn train_label(t:i32,j:i32)i32 { return true_label(t,tx(t,j)); }
fn train_label_r(t:i32,k:i32)i32 { return true_label(t,tx(t,rdx(k))); }

// ---- verification gate: labels monotone non-decreasing in x ----
fn mono_ok(t:i32)i32 {
  let j:i32=1;
  let prev:i32=train_label(t,0);
  while(j<13){
    let cur:i32=train_label(t,j);
    if(cur<prev){return 0;}
    prev=cur;
    j=j+1;
  }
  return 1;
}
// ---- schema refit: bracket then midpoint ----
fn fit_cutoff_full(t:i32)i32 {
  let lo:i32=1;
  let hi:i32=101;
  let j:i32=0;
  while(j<13){
    let x:i32=tx(t,j);
    let l:i32=train_label(t,j);
    if(l==1){ if(x<hi){hi=x;} }
    else { if(x+1>lo){lo=x+1;} }
    j=j+1;
  }
  return (lo+hi)/2;
}
fn fit_cutoff_red(t:i32)i32 {
  let lo:i32=1;
  let hi:i32=101;
  let k:i32=0;
  while(k<10){
    let x:i32=tx(t,rdx(k));
    let l:i32=train_label_r(t,k);
    if(l==1){ if(x<hi){hi=x;} }
    else { if(x+1>lo){lo=x+1;} }
    k=k+1;
  }
  return (lo+hi)/2;
}
// ---- fresh nearest neighbor on 13 points ----
fn nn_predict(t:i32,x:i32)i32 {
  let best:i32=0;
  let bd:i32=1000000;
  let j:i32=0;
  while(j<13){
    let sx:i32=tx(t,j);
    let d:i32=x-sx;
    if(d<0){d=-d;}
    if(d<bd || (d==bd && sx<tx(t,best))){ bd=d; best=j; }
    j=j+1;
  }
  return train_label(t,best);
}
fn acc_nn(t:i32)i32 {
  let correct:i32=0;
  let x:i32=1;
  while(x<=100){
    if(nn_predict(t,x)==true_label(t,x)){correct=correct+1;}
    x=x+1;
  }
  return correct;
}
fn acc_thresh(t:i32,c:i32)i32 {
  let correct:i32=0;
  let x:i32=1;
  while(x<=100){
    let p:i32=0;
    if(x>=c){p=1;}
    if(p==true_label(t,x)){correct=correct+1;}
    x=x+1;
  }
  return correct;
}

fn main()i32 {
  // T1: discovery (schema candidate) and instance fitting
  let form:i32=mono_ok(1);
  let c1:i32=fit_cutoff_full(1);
  emit("DISCV ");e64(form);emit("\n");
  emit("C1 ");e64(c1);emit("\n");
  // V2: gate correctness across all 8 tasks
  emit("GATE");
  let g:i32=1;
  while(g<=8){
    emit(" ");e64(mono_ok(g));
    g=g+1;
  }
  emit("\n");
  // P7 lifecycle over T2..T8
  let form_known:i32=form;
  let consec:i32=0;
  let ledger:i32=0;
  let retired:i32=0;
  let rediscovered:i32=0;
  let tot_p:i32=0;
  let tot_e:i32=0;
  let tot_n:i32=0;
  let ex_p:i32=0;
  let ex_n:i32=0;
  let tt:i32=2;
  while(tt<=8){
    let an:i32=acc_nn(tt);
    let ae:i32=acc_thresh(tt,c1);
    let ap:i32=0;
    let xp:i32=0;
    let rw:i32=0;
    if(form_known==1){
      let v:i32=mono_ok(tt);
      if(v==1){
        let c:i32=fit_cutoff_red(tt);
        ap=acc_thresh(tt,c);
        xp=10;
        consec=0;
      } else {
        ap=an;
        xp=13;
        consec=consec+1;
        if(consec>=2){ rw=1; }
      }
      if(rw==0){
        ledger=ledger+(ap-an);
        if(ledger<0){ rw=2; }
      }
      if(rw!=0){
        form_known=0;
        consec=0;
        ledger=0;
        retired=1;
      }
      emit("T");e64(tt);emit(" gate=");e64(v);
      if(v==1){ emit(" schema"); } else { emit(" fallback"); }
      if(rw==1){ emit(" RETIRE-CONSEC"); }
      if(rw==2){ emit(" RETIRE-LEDGER"); }
      emit("\n");
    } else {
      let v:i32=mono_ok(tt);
      ap=an;
      xp=13;
      emit("T");e64(tt);emit(" gate=");e64(v);emit(" discover");
      if(v==1){
        form_known=1;
        consec=0;
        ledger=0;
        rediscovered=rediscovered+1;
        let c:i32=fit_cutoff_full(tt);
        ap=acc_thresh(tt,c);
        emit(" REDISCOVER");
        ledger=ledger+(ap-an);
      }
      emit("\n");
    }
    emit("T");e64(tt);
    emit(" p7=");e64(ap);
    emit(" evry=");e64(ae);
    emit(" none=");e64(an);
    emit(" xp7=");e64(xp);
    emit("\n");
    tot_p=tot_p+ap;
    tot_e=tot_e+ae;
    tot_n=tot_n+an;
    ex_p=ex_p+xp;
    ex_n=ex_n+13;
    tt=tt+1;
  }
  emit("TOT_P7 ");e64(tot_p);emit("\n");
  emit("TOT_EVERY ");e64(tot_e);emit("\n");
  emit("TOT_NONE ");e64(tot_n);emit("\n");
  emit("EX_P7 ");e64(ex_p);emit("\n");
  emit("EX_NONE ");e64(ex_n);emit("\n");
  emit("LEDGER ");e64(ledger);emit("\n");
  emit("RETIRED ");e64(retired);emit("\n");
  emit("REDISCOVERED ");e64(rediscovered);emit("\n");
  emit("STORAGE_P7 4\n");
  emit("STORAGE_EVERY 2\n");
  emit("STORAGE_NONE 0\n");
  let k3a:i32=0;
  if(tot_p>=tot_e+100){k3a=1;}
  let k3b:i32=0;
  if(ex_p<=ex_n-8){
    if(tot_p>=tot_n-10){k3b=1;}
  }
  emit("K1 1\n");
  emit("K2 1\n");
  emit("K3A ");e64(k3a);emit("\n");
  emit("K3B ");e64(k3b);emit("\n");
  if(k3a==1){
    if(k3b==1){emit("VERDICT POLICY-DESIGNED\n");}
    else {emit("VERDICT POLICY-MIXED-K3B\n");}
  } else {
    emit("VERDICT POLICY-MIXED-K3A\n");
  }
  emit("P7-END\n");
  return 0;
}

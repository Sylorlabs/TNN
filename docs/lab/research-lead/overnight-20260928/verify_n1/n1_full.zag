// learner_ds.zag -- delayed+noisy intermediate-construction learner.
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no per-episode outcome bits, no seed, no draw
// computation in this file. The learner deploys candidates through
// w_sched_ds (which returns NOTHING) and learns their aggregate coin
// consequences only when w_arrive_ds delivers them 3 steps later,
// each arrival carrying its own noise. A per-step LEDGER maps each
// arriving consequence back to the (deployment step, sample index)
// that caused it: routing is by schedule step, never by recency.
// Every threshold score is a sum of exactly K attributed arrivals;
// the arrival count per cell is verified. The learner calls exactly
// two world-side symbols: w_sched_ds and w_arrive_ds.
// Prereg: l3_delayed_stochastic/PREREG.md (frozen). Pure Zag.
// 0 modes, 0 cross-structure glue, 0 new semantic cases.
//
// State layout (u8 buffer, offsets):
//   0: XN (train count)  1: XNT (test count)
//   2: CONF (confidence)  3: RETAINED flag
//   4..163:   X train slots, 32 x 5 bytes [id,e0,e1,e2,e3]
//   164..243: X test slots, 16 x 5 bytes [id,e0,e1,e2,e3]
//   244..247: bestC i32 (incumbent consequence SUM)
//   248..279: M slot, 32 bytes [n,u8 gen,u8 sup,u8 pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   280..311: Mprev slot, 32 bytes (same layout; revision history)
//   312..315: STEP i32 (world step counter, learner-owned clock)
//   316..262459:   lg_tag  262144 u8 (job tag per deployment step)
//   262460..524603:  lg_cand 262144 u8 (candidate index per step)
//   524604..786747:  lg_thri 262144 u8 (threshold index per step)
//   786748..1048891: lg_k    262144 u8 (sample index per step)
//   1048892..1048923: m0_thr  8 i32   1048924..1048955: m0_sco  8 i32
//   1048956..1048987: m0_cnt  8 i32 (arrival counts)
//   1048988..1049019: cur_thr 8 i32  1049020..1049051: cur_sco 8 i32
//   1049052..1049083: cur_cnt 8 i32
//   1049084..1056763: r_thr  1920 i32 (3 rounds x 80 cand x 8 thr)
//   1056764..1064443: r_sco  1920 i32
//   1064444..1072123: r_cnt  1920 i32
//   1072124..1072127: m1t_thr i32  1072128..1072131: m1t_sco i32
//   1072132..1072135: m1t_cnt i32
//   1072136..: scratch
// Job tags: 1=M0FIT 2=R1 3=R2 4=R3 5=CURFIT 6=M1TEST.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer; sequences only) ----
fn x_teach(st:[]u8, region:i32, id:i32, e0:i32, e1:i32, e2:i32, e3:i32)void {
  let base:i32=4;
  let cap:i32=32;
  let cnt:i32=0;
  if(region==0){ cnt=st[0] as i32; }
  else { base=164; cap=16; cnt=st[1] as i32; }
  if(cnt>=cap){return;}
  let o:i32=base+cnt*5;
  st[o]=id as u8; st[o+1]=e0 as u8; st[o+2]=e1 as u8;
  st[o+3]=e2 as u8; st[o+4]=e3 as u8;
  if(region==0){ st[0]=(cnt+1) as u8; } else { st[1]=(cnt+1) as u8; }
  return;
}
fn x_count(st:[]u8, region:i32)i32 {
  if(region==0){return st[0] as i32;}
  return st[1] as i32;
}
fn x_get(st:[]u8, region:i32, idx:i32, out:[]u8)i32 {
  let base:i32=4;
  if(region==1){base=164;}
  let o:i32=base+idx*5;
  out[0]=st[o+1]; out[1]=st[o+2]; out[2]=st[o+3]; out[3]=st[o+4];
  return st[o] as i32;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R3 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, e0:i32, e1:i32, e2:i32, e3:i32, rg:[]u8)i32 {
  set32(rg,0,e0); set32(rg,4,e1); set32(rg,8,e2); set32(rg,12,e3);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
// Program outputs on the taught train episodes (for threshold sweeps).
fn p_outs_train(prog:[]u8, n:i32, st:[]u8, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let ne:i32=st[0] as i32;
  let i:i32=0;
  while(i<ne){
    x_get(st,0,i,sq);
    let v:i32=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
// Sorted ascending unique values.
fn uniq_asc(vals:[]u8, n:i32, uq:[]u8)i32 {
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=get32(vals,i*4);
    let j:i32=0;
    let seen:i32=0;
    while(j<nu){
      if(get32(uq,j*4)==v){seen=1;}
      j=j+1;
    }
    if(seen==0){set32(uq,nu*4,v);nu=nu+1;}
    i=i+1;
  }
  let a:i32=0;
  while(a<nu){
    let b:i32=a+1;
    while(b<nu){
      if(get32(uq,b*4)<get32(uq,a*4)){
        let tmp:i32=get32(uq,a*4);
        set32(uq,a*4,get32(uq,b*4));
        set32(uq,b*4,tmp);
      }
      b=b+1;
    }
    a=a+1;
  }
  return nu;
}

// ---- score table offset helpers ----
fn lg_thr_off(tag:i32, cand:i32, thri:i32)i32 {
  if(tag==1){return 1048892+thri*4;}
  if(tag==5){return 1048988+thri*4;}
  if(tag==6){return 1072124;}
  let r:i32=tag-2;
  return 1049084+(r*80+cand)*32+thri*4;
}
fn lg_sco_off(tag:i32, cand:i32, thri:i32)i32 {
  if(tag==1){return 1048924+thri*4;}
  if(tag==5){return 1049020+thri*4;}
  if(tag==6){return 1072128;}
  let r:i32=tag-2;
  return 1056764+(r*80+cand)*32+thri*4;
}
fn lg_cnt_off(tag:i32, cand:i32, thri:i32)i32 {
  if(tag==1){return 1048956+thri*4;}
  if(tag==5){return 1049052+thri*4;}
  if(tag==6){return 1072132;}
  let r:i32=tag-2;
  return 1064444+(r*80+cand)*32+thri*4;
}

// ---- delayed noisy deployment + attribution ----
// Schedule one deployment at the current step with sample index k;
// record it in the ledger. Returns the new buffer cursor.
fn l_plan_deploy_ds(st:[]u8, wst:[]u8, step:i32, tag:i32, cand:i32, thri:i32, k:i32, prog:[]u8, n:i32, thr:i32, region:i32, ob:[]u8, at:i32)i32 {
  st[316+step]=tag as u8;
  st[262460+step]=cand as u8;
  st[524604+step]=thri as u8;
  st[786748+step]=k as u8;
  set32(st,lg_thr_off(tag,cand,thri),thr);
  w_sched_ds(wst,step,prog,n,thr,region,k);
  at=ob_app(ob,at,"DEPLOY step=");
  at=ob_i32(ob,at,step);
  at=ob_app(ob,at," tag=");
  at=ob_i32(ob,at,tag);
  at=ob_app(ob,at," cand=");
  at=ob_i32(ob,at,cand);
  at=ob_app(ob,at," thri=");
  at=ob_i32(ob,at,thri);
  at=ob_app(ob,at," k=");
  at=ob_i32(ob,at,k);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,thr);
  at=ob_app(ob,at," region=");
  at=ob_i32(ob,at,region);
  at=ob_nl(ob,at);
  return at;
}
// Poll the current step for an arriving consequence and route it to
// the (deployment step, sample index) that scheduled it: ledger
// lookup by sched_step, never by recency. The coins are ADDED into
// the threshold score cell (K-sample sum) and the arrival count is
// incremented. Returns the new buffer cursor.
fn l_poll_ds(st:[]u8, wst:[]u8, ob:[]u8, at:i32)i32 {
  let step:i32=get32(st,312);
  let ao:[]u8=z_alloc(16);
  let has:i32=w_arrive_ds(wst,step,ao);
  if(has==1){
    let sched:i32=get32(ao,0);
    let c:i32=get32(ao,4);
    let thr:i32=get32(ao,8);
    let k:i32=get32(ao,12);
    let tag:i32=st[316+sched] as i32;
    let cand:i32=st[262460+sched] as i32;
    let thri:i32=st[524604+sched] as i32;
    let k2:i32=st[786748+sched] as i32;
    if(tag==0){
      at=ob_app(ob,at,"ATTR-BAD arr=");
      at=ob_i32(ob,at,step);
      at=ob_app(ob,at," sched=");
      at=ob_i32(ob,at,sched);
      at=ob_app(ob,at," no-ledger\n");
    } else {
      let exp:i32=get32(st,lg_thr_off(tag,cand,thri));
      if(exp!=thr){
        at=ob_app(ob,at,"ATTR-BAD arr=");
        at=ob_i32(ob,at,step);
        at=ob_app(ob,at," sched=");
        at=ob_i32(ob,at,sched);
        at=ob_app(ob,at," thr-mismatch\n");
      } else {
        if(k2!=k){
          at=ob_app(ob,at,"ATTR-BAD arr=");
          at=ob_i32(ob,at,step);
          at=ob_app(ob,at," sched=");
          at=ob_i32(ob,at,sched);
          at=ob_app(ob,at," k-mismatch\n");
        } else {
          let so:i32=lg_sco_off(tag,cand,thri);
          set32(st,so,get32(st,so)+c);
          let co:i32=lg_cnt_off(tag,cand,thri);
          set32(st,co,get32(st,co)+1);
          at=ob_app(ob,at,"ATTR arr=");
          at=ob_i32(ob,at,step);
          at=ob_app(ob,at," sched=");
          at=ob_i32(ob,at,sched);
          at=ob_app(ob,at," tag=");
          at=ob_i32(ob,at,tag);
          at=ob_app(ob,at," k=");
          at=ob_i32(ob,at,k);
          at=ob_app(ob,at," C=");
          at=ob_i32(ob,at,c);
          at=ob_app(ob,at," t=");
          at=ob_i32(ob,at,thr);
          at=ob_nl(ob,at);
        }
      }
    }
  }
  return at;
}
// ---- delayed noisy threshold fit ----
// For each candidate threshold (sorted unique program outputs,
// ascending), deploy K samples (k=0..K-1), one deployment per step,
// polling each step; drain N steps; verify each threshold cell got
// exactly K arrivals; first-max over the ATTRIBUTED K-sample sums.
// rout[0]=bestC, rout[4]=bestT. The learner sees only scalar
// consequences, each arriving 3 steps after its deployment.
fn l_dfit_ds(st:[]u8, wst:[]u8, tag:i32, cand:i32, prog:[]u8, n:i32, K:i32, region:i32, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32, rout:[]u8)i32 {
  let ne:i32=st[0] as i32;
  p_outs_train(prog,n,st,rg,sq,vals);
  let nu:i32=uniq_asc(vals,ne,uq);
  let j:i32=0;
  while(j<nu){
    set32(st,lg_sco_off(tag,cand,j),0);
    set32(st,lg_cnt_off(tag,cand,j),0);
    j=j+1;
  }
  j=0;
  while(j<nu){
    let t:i32=get32(uq,j*4);
    let k:i32=0;
    while(k<K){
      let step:i32=get32(st,312);
      at=l_poll_ds(st,wst,ob,at);
      at=l_plan_deploy_ds(st,wst,step,tag,cand,j,k,prog,n,t,region,ob,at);
      set32(st,312,step+1);
      k=k+1;
    }
    j=j+1;
  }
  let d:i32=0;
  while(d<3){
    let step:i32=get32(st,312);
    at=l_poll_ds(st,wst,ob,at);
    set32(st,312,step+1);
    d=d+1;
  }
  j=0;
  while(j<nu){
    if(get32(st,lg_cnt_off(tag,cand,j))!=K){
      at=ob_app(ob,at,"ATTR-COUNT-BAD tag=");
      at=ob_i32(ob,at,tag);
      at=ob_app(ob,at," cand=");
      at=ob_i32(ob,at,cand);
      at=ob_app(ob,at," thri=");
      at=ob_i32(ob,at,j);
      at=ob_app(ob,at," got=");
      at=ob_i32(ob,at,get32(st,lg_cnt_off(tag,cand,j)));
      at=ob_app(ob,at," want=");
      at=ob_i32(ob,at,K);
      at=ob_nl(ob,at);
    }
    j=j+1;
  }
  let bc:i32=-1000000000;
  let bt:i32=0;
  j=0;
  while(j<nu){
    let c:i32=get32(st,lg_sco_off(tag,cand,j));
    if(c>bc){bc=c;bt=get32(st,lg_thr_off(tag,cand,j));}
    j=j+1;
  }
  set32(rout,0,bc);
  set32(rout,4,bt);
  return at;
}

// ---- construct: greedy program construction through the delayed noisy channel ----
// Every candidate score is a K-sample sum of delayed noisy arrivals.
// Append rule: measured gain must exceed K/2 (integer division), a
// fixed significance bound depending only on K. With K=1 this is the
// plain positive-gain rule. k1 selects the round log tag text only
// (K1-ROUND vs DS-ROUND); the code path is identical. mbuf (24B)
// gets the final program; mout: [0]=n [4]=threshold [8]=sum.
fn construct_ds(st:[]u8, wst:[]u8, init:[]u8, initn:i32, K:i32, k1:i32, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  let bto:[]u8=z_alloc(8);
  at=l_dfit_ds(st,wst,5,0,cur,cn,K,0,rg,sq,vals,uq,ob,at,bto);
  let bs:i32=get32(bto,0);
  let bt:i32=get32(bto,4);
  let bound:i32=K/2;
  let r:i32=1;
  let go:i32=1;
  while(go==1){
    if(r>3){go=0;}
    else {
      if(cn>=8){go=0;}
      else {
        let bg:i32=-1000000000;
        let rsg:i32=-1000000000;
        let wsum:i32=0;
        let rsum:i32=0;
        let bop:i32=-1;
        let bd:i32=0;
        let bss:i32=0;
        let wbtk:i32=0;
        let wcsk:i32=0;
        let neval:i32=0;
        let op:i32=0;
        while(op<5){
          let d:i32=0;
          while(d<4){
            let s:i32=0;
            while(s<4){
              let kk:i32=op*16+d*4+s;
              let cand:[]u8=z_alloc(24);
              let j2:i32=0;
              while(j2<cn*3){cand[j2]=cur[j2];j2=j2+1;}
              cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
              let cto:[]u8=z_alloc(8);
              at=l_dfit_ds(st,wst,r+1,kk,cand,cn+1,K,0,rg,sq,vals,uq,ob,at,cto);
              let csk:i32=get32(cto,0);
              let btk:i32=get32(cto,4);
              neval=neval+1;
              let gain:i32=csk-bs;
              if(gain>bg){
                rsg=bg; rsum=wsum;
                bg=gain; wsum=csk;
                bop=op; bd=d; bss=s; wbtk=btk; wcsk=csk;
              } else {
                if(gain>rsg){ rsg=gain; rsum=csk; }
              }
              s=s+1;
            }
            d=d+1;
          }
          op=op+1;
        }
        if(k1==1){at=ob_app(ob,at,"K1-ROUND ");}
        else {at=ob_app(ob,at,"DS-ROUND ");}
        at=ob_i32(ob,at,r);
        at=ob_app(ob,at," base=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," eval=");
        at=ob_i32(ob,at,neval);
        if(bg>bound){
          at=ob_app(ob,at," win=");
          at=ob_i32(ob,at,bop);
          at=ob_app(ob,at,",");
          at=ob_i32(ob,at,bd);
          at=ob_app(ob,at,",");
          at=ob_i32(ob,at,bss);
          at=ob_app(ob,at," gain=");
          at=ob_i32(ob,at,bg);
          cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
          cn=cn+1;
          bs=wcsk;
          bt=wbtk;
          at=ob_app(ob,at," score=");
          at=ob_i32(ob,at,bs);
          at=ob_app(ob,at," t=");
          at=ob_i32(ob,at,bt);
          at=ob_app(ob,at," mgn=");
          at=ob_i32(ob,at,wsum-rsum);
          at=ob_nl(ob,at);
          r=r+1;
        } else {
          at=ob_app(ob,at," stop maxgain=");
          at=ob_i32(ob,at,bg);
          at=ob_nl(ob,at);
          go=0;
        }
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[248]=n as u8; st[249]=gen as u8; st[250]=0; st[251]=0;
  set32(st,252,t);
  let k:i32=0;
  while(k<24){st[256+k]=prog[k];k=k+1;}
  return;
}
fn m_copy_to_prev(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[280+k]=st[248+k];k=k+1;}
  st[282]=1;
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[248+k]=0;k=k+1;}
  return;
}
fn m_prog_get(st:[]u8, out:[]u8)void {
  let k:i32=0;
  while(k<24){out[k]=st[256+k];k=k+1;}
  return;
}
fn m_bytes_equal(st:[]u8, snap:[]u8)i32 {
  // Structural identity only (PREREG.md section 6, K-DS5; FORAGE
  // ERRATUM-1 rationale): n, gen, sup, pad, and the 24 program bytes.
  // The threshold field is the adaptive decision parameter and is
  // excluded here.
  let k:i32=0;
  while(k<4){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  k=8;
  while(k<32){
    if(st[248+k]!=snap[k]){return 0;}
    k=k+1;
  }
  return 1;
}
fn m_snap(st:[]u8, snap:[]u8)void {
  let k:i32=0;
  while(k<32){snap[k]=st[248+k];k=k+1;}
  return;
}

// ---- confidence policy (generic; no modes) ----
fn l_observe(st:[]u8, c:i32)void {
  let bc:i32=get32(st,244);
  if(c>bc){
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
  }
  return;
}
// Returns 1 if a revision happened, else 0.
fn l_revise(st:[]u8, mbuf:[]u8, n:i32, t:i32, c:i32, ob:[]u8, at:i32, rout:[]u8)i32 {
  let bc:i32=get32(st,244);
  if(c>bc){
    m_copy_to_prev(st);
    let g:i32=(st[249] as i32)+1;
    m_write(st,n,g,t,mbuf);
    set32(st,244,c);
    st[2]=((st[2] as i32)+1) as u8;
    at=ob_app(ob,at,"REVISE old-C=");
    at=ob_i32(ob,at,bc);
    at=ob_app(ob,at," new-C=");
    at=ob_i32(ob,at,c);
    at=ob_nl(ob,at);
    set32(rout,0,1);
  } else {
    set32(rout,0,0);
  }
  return at;
}
fn l_deploy_eval(st:[]u8, c:i32)void {
  if(c>0){st[3]=1;} else {st[3]=0;}
  return;
}
fn l_can_decide(st:[]u8)i32 {
  if((st[248] as i32)==0){return 0;}
  return 1;
}

// ---- the experiment: inherit, construct+revise, deploy held-out ----
// All consequence observations arrive 3 steps after deployment, each
// carrying noise, and are routed via the ledger to the (step, sample)
// that scheduled them; every threshold score sums exactly K routed
// arrivals. res: [0]=c0 [4]=t0 [8]=n1 [12]=t1 [16]=c1 [20]=revised
// [24]=ct [28]=beq.
fn l_experiment(st:[]u8, wst:[]u8, rg:[]u8, sq:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32, res:[]u8)i32 {
  let K:i32=64;
  let rout:[]u8=z_alloc(8);
  // ================= STAGE 0: inherit wrong M0, delayed noisy fit =================
  at=ob_app(ob,at,"=== STAGE 0 inherit (delayed noisy) ===\n");
  let m0:[]u8=z_alloc(24);
  m_prog_get(st,m0);
  let n0:i32=st[248] as i32;
  at=l_dfit_ds(st,wst,1,0,m0,n0,K,0,rg,sq,vals,uq,ob,at,rout);
  let t0:i32=get32(rout,4);
  let c0:i32=get32(rout,0);
  set32(st,252,t0);
  set32(res,0,c0);
  set32(res,4,t0);
  at=ob_app(ob,at,"M0-FIT t=");
  at=ob_i32(ob,at,t0);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c0);
  at=ob_nl(ob,at);
  l_observe(st,c0);
  at=ob_app(ob,at,"M0-DEPLOY-ATTR C=");
  at=ob_i32(ob,at,c0);
  at=ob_app(ob,at," bestC=");
  at=ob_i32(ob,at,get32(st,244));
  at=ob_app(ob,at," conf=");
  at=ob_i32(ob,at,(st[2] as i32));
  at=ob_nl(ob,at);
  // ================= STAGE 1: construct via delayed noisy consequences =================
  at=ob_app(ob,at,"=== STAGE 1 construct+revise (delayed noisy) ===\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct_ds(st,wst,init,0,K,0,rg,sq,vals,uq,mbuf,mout,ob,at);
  let n1:i32=get32(mout,0);
  let t1:i32=get32(mout,4);
  let c1:i32=get32(mout,8);
  set32(res,8,n1);
  set32(res,12,t1);
  set32(res,16,c1);
  at=ob_app(ob,at,"M1-BUILT n=");
  at=ob_i32(ob,at,n1);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,t1);
  at=ob_app(ob,at," C=");
  at=ob_i32(ob,at,c1);
  at=ob_app(ob,at," prog=");
  let k3:i32=0;
  while(k3<6){
    at=ob_i32(ob,at,(mbuf[k3] as i32));
    if(k3<5){at=ob_app(ob,at,",");}
    k3=k3+1;
  }
  at=ob_nl(ob,at);
  let rout2:[]u8=z_alloc(4);
  at=l_revise(st,mbuf,n1,t1,c1,ob,at,rout2);
  let revised:i32=get32(rout2,0);
  set32(res,20,revised);
  // ================= STAGE 2: deploy M1 on held-out, delayed noisy =================
  at=ob_app(ob,at,"=== STAGE 2 deploy held-out (delayed noisy) ===\n");
  let snap:[]u8=z_alloc(32);
  m_snap(st,snap);
  let m1:[]u8=z_alloc(24);
  m_prog_get(st,m1);
  let mn1:i32=st[248] as i32;
  let mt1:i32=get32(st,252);
  set32(st,1072128,0);
  set32(st,1072132,0);
  let k2:i32=0;
  while(k2<K){
    let step:i32=get32(st,312);
    at=l_poll_ds(st,wst,ob,at);
    at=l_plan_deploy_ds(st,wst,step,6,0,0,k2,m1,mn1,mt1,1,ob,at);
    set32(st,312,step+1);
    k2=k2+1;
  }
  let dd:i32=0;
  while(dd<3){
    let step:i32=get32(st,312);
    at=l_poll_ds(st,wst,ob,at);
    set32(st,312,step+1);
    dd=dd+1;
  }
  if(get32(st,1072132)!=K){
    at=ob_app(ob,at,"ATTR-COUNT-BAD tag=6\n");
  }
  let ct:i32=get32(st,1072128);
  l_deploy_eval(st,ct);
  set32(res,24,ct);
  at=ob_app(ob,at,"TEST-DEPLOY C=");
  at=ob_i32(ob,at,ct);
  at=ob_app(ob,at," retained=");
  at=ob_i32(ob,at,(st[3] as i32));
  at=ob_nl(ob,at);
  let beq:i32=m_bytes_equal(st,snap);
  set32(res,28,beq);
  at=ob_app(ob,at,"M-BYTES-EQUAL ");
  at=ob_i32(ob,at,beq);
  at=ob_nl(ob,at);
  return at;
}
// world_dn1.zag -- SETTLE-DN1 environment (EXPERIMENT SIDE ONLY).
// Same frozen episode tables and hidden margin rule as l3_verify:
// margin(ep) = e0 + e1 - e2. Consequence channel: DELAYED (N=1 step,
// the minimal positive delay) and NOISY (seeded counter-based draws,
// seed 109 inherited from SETTLE-DN2, draws (h mod 5)-2 in
// {-2,-1,0,1,2}). The learner never calls
// anything in this file except w_sched_ds / w_arrive_ds, whose names
// and signatures match the frozen learner's call sites exactly.
// w_sched_ds returns nothing: no consequence is observable at
// schedule time. The noisy consequence of a deployment at step s is
// computed only when w_arrive_ds(s+1) is polled.
// w_conseq_det is the deterministic immediate oracle for the
// EXPERIMENT-SIDE uniqueness sweep only; the learner must never
// reference it (K-N1-1 audit). Menu controls are experiment-side.
// Tables match verify_n1/PREREG.md section 2 exactly.

// ---- frozen episode tables (same world family values) ----
fn w_val(ph:i32, idx:i32, c:i32)i32 {
  if(ph==1){
    if(idx==0){ if(c==0){return 2;} if(c==1){return 7;} if(c==2){return 3;} return 0; }
    if(idx==1){ if(c==0){return 8;} if(c==1){return 1;} if(c==2){return 4;} return 1; }
    if(idx==2){ if(c==0){return 1;} if(c==1){return 6;} if(c==2){return 3;} return 5; }
    if(idx==3){ if(c==0){return 6;} if(c==1){return 0;} if(c==2){return 3;} return 3; }
    if(idx==4){ if(c==0){return 7;} if(c==1){return 4;} if(c==2){return 15;} return 0; }
    if(idx==5){ if(c==0){return 4;} if(c==1){return 3;} if(c==2){return 10;} return 1; }
    if(idx==6){ if(c==0){return 3;} if(c==1){return 2;} if(c==2){return 7;} return 2; }
    if(c==0){return 3;} if(c==1){return 0;} if(c==2){return 4;} return 3;
  }
  if(idx==0){ if(c==0){return 4;} if(c==1){return 5;} if(c==2){return 2;} return 0; }
  if(idx==1){ if(c==0){return 1;} if(c==1){return 1;} if(c==2){return 5;} return 0; }
  if(idx==2){ if(c==0){return 6;} if(c==1){return 2;} if(c==2){return 3;} return 1; }
  if(c==0){return 2;} if(c==1){return 3;} if(c==2){return 8;} return 2;
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
// Hidden margin (world side only; never passed to the learner).
fn w_margin(ph:i32, idx:i32)i32 {
  return w_val(ph,idx,0)+w_val(ph,idx,1)-w_val(ph,idx,2);
}

// ---- seeded counter-based noise (NEW frozen spec, PREREG.md section 2) ----
fn nz_seed()i32 { return 109; }
fn nz_acc(region:i32, key:[]u8, kn:i32, t:i32)i32 {
  let a:i64=(t as i64)+1007+((region as i64)*1000003);
  let i:i32=0;
  while(i<kn*3){
    a=(a*31+(((key[i] as i32)) as i64))%2147483647;
    i=i+1;
  }
  a=(a*31+(kn as i64))%2147483647;
  return a as i32;
}
fn nz_draw(seed:i32, acc:i32, k:i32)i32 {
  let h:i64=(seed as i64);
  h=(h*1103515245+(acc as i64))%2147483647;
  h=(h*1103515245+(k as i64))%2147483647;
  h=(h*1103515245+12345)%2147483647;
  return ((h%5) as i32)-2;
}

// ---- delayed noisy schedule store ----
// World state: 262144 steps x 40 bytes
// [prog 24B][n i32][thr i32][region i32][k i32]. n = -1 marks empty.
fn w_init_dn1()[]u8 {
  let wst:[]u8=z_alloc(10485760);
  let s:i32=0;
  while(s<262144){
    set32(wst,s*40+24,-1);
    s=s+1;
  }
  return wst;
}
// Schedule a deployment. Returns nothing; nothing is observable now.
fn w_sched_ds(wst:[]u8, step:i32, prog:[]u8, n:i32, thr:i32, region:i32, k:i32)void {
  let base:i32=step*40;
  let j:i32=0;
  while(j<24){wst[base+j]=prog[j];j=j+1;}
  set32(wst,base+24,n);
  set32(wst,base+28,thr);
  set32(wst,base+32,region);
  set32(wst,base+36,k);
  return;
}
// Noisy aggregate coins of one scheduled deployment: deterministic
// coins plus the seeded draw for this deployment's sample index.
fn w_settle_dn1(wst:[]u8, s:i32)i32 {
  let base:i32=s*40;
  let n:i32=get32(wst,base+24);
  let thr:i32=get32(wst,base+28);
  let region:i32=get32(wst,base+32);
  let k:i32=get32(wst,base+36);
  let ph:i32=region+1;
  let ne:i32=w_n(ph);
  let pb:[]u8=z_alloc(24);
  let j:i32=0;
  while(j<24){pb[j]=wst[base+j];j=j+1;}
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=p_exec(pb,n,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3),rg);
    if(v>=thr){coins=coins+w_margin(ph,i);}
    i=i+1;
  }
  let acc:i32=nz_acc(region,pb,n,thr);
  return coins+nz_draw(nz_seed(),acc,k);
}
// Poll the current step. If a deployment was scheduled at step-1,
// its noisy consequence is computed NOW: out[0]=sched_step,
// out[4]=coins, out[8]=thr, out[12]=k. Returns 1 on arrival, else 0.
fn w_arrive_ds(wst:[]u8, step:i32, out:[]u8)i32 {
  if(step<1){return 0;}
  let s:i32=step-1;
  if(s>=262144){return 0;}
  if(get32(wst,s*40+24)<0){return 0;}
  set32(out,0,s);
  set32(out,4,w_settle_dn1(wst,s));
  set32(out,8,get32(wst,s*40+28));
  set32(out,12,get32(wst,s*40+36));
  return 1;
}
// Deterministic immediate aggregate coins. EXPERIMENT-SIDE ONLY
// (the uniqueness sweep). Never called by the learner.
fn w_conseq_det(prog:[]u8, n:i32, thr:i32, region:i32)i32 {
  let ph:i32=region+1;
  let ne:i32=w_n(ph);
  let rg:[]u8=z_alloc(16);
  let coins:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=p_exec(prog,n,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3),rg);
    if(v>=thr){coins=coins+w_margin(ph,i);}
    i=i+1;
  }
  return coins;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}
// driver_dn1.zag -- VERIFY-N1 experiment driver.
// Experiment-side orchestration: teaches X (train+test), seeds the
// inherited wrong M0, creates the SETTLE-DN1 world state (delay N=1,
// noise seed 109 inherited from SETTLE-DN2), runs the learner's delayed
// noisy l_experiment
// (K=64 main arm: inherit, construct+revise, deploy held-out;
// the learner file is byte-identical to the frozen sibling's),
// evaluates arms (NOM, MENU via experiment-side immediate noisy
// K-sums), runs the K=1 single-sample control arm through the N=1
// delayed channel, runs the experiment-side uniqueness sweep, and
// prints the kill-bar summary. The driver never invents the
// intermediate: all construction goes through the learner's delayed
// noisy construct_ds(). Pure Zag.

fn d_teach(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let region:i32=0;
  if(ph==2){region=1;}
  let i:i32=0;
  while(i<n){
    let id:i32=w_id(ph,i);
    x_teach(st,region,id,w_val(ph,i,0),w_val(ph,i,1),w_val(ph,i,2),w_val(ph,i,3));
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[248] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[249] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[250] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[256+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_mprev_dump(st:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"MPREV n=");
  at=ob_i32(ob,at,(st[280] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[281] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[282] as i32));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=ob_i32(ob,at,(st[288+k] as i32));
    if(k<5){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side uniqueness sweep: appends after [SUB R0,R2].
// Counts d=0 appends reaching C=18 via the experiment-side
// deterministic immediate oracle w_conseq_det (frozen: exactly 1).
fn d_uniq_append(rg:[]u8, vals:[]u8, uq:[]u8, ob:[]u8, at:i32)i32 {
  let cnt:i32=0;
  let op:i32=0;
  while(op<5){
    let s:i32=0;
    while(s<4){
      let cand:[]u8=z_alloc(24);
      cand[0]=2; cand[1]=0; cand[2]=2;
      cand[3]=op as u8; cand[4]=0; cand[5]=s as u8;
      let i:i32=0;
      while(i<8){
        let v:i32=p_exec(cand,2,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3),rg);
        set32(vals,i*4,v);
        i=i+1;
      }
      let nu:i32=uniq_asc(vals,8,uq);
      let bc:i32=-1000000;
      let j:i32=0;
      while(j<nu){
        let t:i32=get32(uq,j*4);
        let c:i32=w_conseq_det(cand,2,t,0);
        if(c>bc){bc=c;}
        j=j+1;
      }
      if(bc==18){cnt=cnt+1;}
      s=s+1;
    }
    op=op+1;
  }
  at=ob_app(ob,at,"UNIQ-APPEND-18 n=");
  at=ob_i32(ob,at,cnt);
  at=ob_nl(ob,at);
  return at;
}
// Experiment-side menu control evaluation through the noisy channel
// (controls, not learner). Each control: K=64 noisy sums per
// threshold, first-max. Keyed [9,kind,0] exactly as in the prereg.
// Delay shifts arrival time only, never values, so the immediate
// noisy oracle is the honest experiment-side control.
fn d_menu_nz(vals:[]u8, uq:[]u8, ob:[]u8, at:i32, worst:[]u8)i32 {
  let ne:i32=8;
  let K:i32=64;
  let mk:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<5){
    let i:i32=0;
    while(i<ne){
      set32(vals,i*4,menu_agg(k,w_val(1,i,0),w_val(1,i,1),w_val(1,i,2),w_val(1,i,3)));
      i=i+1;
    }
    let nu:i32=uniq_asc(vals,ne,uq);
    mk[0]=9; mk[1]=k as u8; mk[2]=0;
    let bsum:i32=-1000000000;
    let bt:i32=0;
    let j:i32=0;
    while(j<nu){
      let t:i32=get32(uq,j*4);
      let dc:i32=0;
      i=0;
      while(i<ne){
        if(get32(vals,i*4)>=t){dc=dc+w_margin(1,i);}
        i=i+1;
      }
      let acc:i32=nz_acc(0,mk,1,t);
      let s:i32=0;
      let kk:i32=0;
      while(kk<K){ s=s+dc+nz_draw(nz_seed(),acc,kk); kk=kk+1; }
      if(s>bsum){bsum=s;bt=t;}
      j=j+1;
    }
    at=ob_app(ob,at,"MENU ");
    at=ob_app(ob,at,menu_name(k));
    at=ob_app(ob,at," C=");
    at=ob_i32(ob,at,bsum);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,bt);
    at=ob_nl(ob,at);
    if(bsum>get32(worst,0)){set32(worst,0,bsum);}
    k=k+1;
  }
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16777216);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let uq:[]u8=z_alloc(64);
  at=ob_app(ob,at,"N1-START\n");

  let st:[]u8=z_alloc(1200000);
  at=d_teach(st,1,ob,at);
  at=d_teach(st,2,ob,at);
  at=ob_app(ob,at,"X-TRAIN n=");
  at=ob_i32(ob,at,x_count(st,0));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"X-TEST n=");
  at=ob_i32(ob,at,x_count(st,1));
  at=ob_nl(ob,at);
  // M0 = [ADD R0,R2] seeded experiment-side (wrong inheritance).
  let m0:[]u8=z_alloc(24);
  m0[0]=1; m0[1]=0; m0[2]=2;
  m_write(st,1,0,0,m0);
  at=ob_app(ob,at,"M0-SEED prog=1,0,2\n");
  let wst:[]u8=w_init_dn1();
  let res:[]u8=z_alloc(32);
  at=l_experiment(st,wst,rg,sq,vals,uq,ob,at,res);
  let c0:i32=get32(res,0);
  let t0:i32=get32(res,4);
  let n1:i32=get32(res,8);
  let t1:i32=get32(res,12);
  let c1:i32=get32(res,16);
  let revised:i32=get32(res,20);
  let ct:i32=get32(res,24);
  let beq:i32=get32(res,28);
  at=d_m_dump(st,"M",ob,at);
  at=d_mprev_dump(st,ob,at);
  at=d_uniq_append(rg,vals,uq,ob,at);

  // ================= ARMS =================
  at=ob_app(ob,at,"=== ARMS ===\n");
  let stn:[]u8=z_alloc(1200000);
  at=d_teach(stn,1,ob,at);
  m_wipe(stn);
  let nom_c:i32=0;
  if(l_can_decide(stn)==0){nom_c=0;}
  at=ob_app(ob,at,"ARM-NOM C=");
  at=ob_i32(ob,at,nom_c);
  at=ob_nl(ob,at);
  let worst:[]u8=z_alloc(4);
  set32(worst,0,-1000000000);
  at=d_menu_nz(vals,uq,ob,at,worst);
  let wmenu:i32=get32(worst,0);

  // ================= STAGE 1b: single-sample control (K=1, delayed) =================
  at=ob_app(ob,at,"=== STAGE 1b single-sample control (delayed) ===\n");
  let st2:[]u8=z_alloc(1200000);
  at=d_teach(st2,1,ob,at);
  let wst2:[]u8=w_init_dn1();
  let init:[]u8=z_alloc(24);
  let k1buf:[]u8=z_alloc(24);
  let k1out:[]u8=z_alloc(12);
  at=construct_ds(st2,wst2,init,0,1,1,rg,sq,vals,uq,k1buf,k1out,ob,at);
  let k1n:i32=get32(k1out,0);
  at=ob_app(ob,at,"K1-BUILT n=");
  at=ob_i32(ob,at,k1n);
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<k1n*3){
    at=ob_i32(ob,at,(k1buf[k] as i32));
    if(k<k1n*3-1){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  let k1sel:i32=0;
  if(k1n==2){
    if((k1buf[0] as i32)==2){ if((k1buf[1] as i32)==0){ if((k1buf[2] as i32)==2){
      if((k1buf[3] as i32)==1){ if((k1buf[4] as i32)==0){ if((k1buf[5] as i32)==1){
        k1sel=1;
      } } }
    } } }
  }
  at=ob_app(ob,at,"K1-SELECT-M1 ");
  at=ob_i32(ob,at,k1sel);
  at=ob_nl(ob,at);

  // ================= KILL BARS (frozen numbers, PREREG.md section 4) =================
  at=ob_app(ob,at,"=== KBARS ===\n");
  at=ob_app(ob,at,"K-N1-1 SHELL-AUDIT\n");
  at=ob_app(ob,at,"K-N1-2 SHELL-AWK\n");
  // K-N1-3: averaging is load-bearing at N=1 (K=1 fails, K=64 selects M1).
  let k1fail:i32=0;
  if(k1n==1){
    if((k1buf[0] as i32)==2){ if((k1buf[1] as i32)==0){ if((k1buf[2] as i32)==2){
      if(k1sel==0){ k1fail=1; }
    } } }
  }
  let k64ok:i32=0;
  if(revised==1){ if(n1==2){ if(t1==3){ if(c1==1151){
    if((st[256] as i32)==2){ if((st[257] as i32)==0){ if((st[258] as i32)==2){
      if((st[259] as i32)==1){ if((st[260] as i32)==0){ if((st[261] as i32)==1){
        k64ok=1;
      } } }
    } } }
  } } } }
  let kvt3:i32=0;
  if(k1fail==1){ if(k64ok==1){ kvt3=1; } }
  at=ob_app(ob,at,"K-N1-3 ");
  if(kvt3==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-N1-4: M constructed via the N=1 delayed noisy channel.
  let kvt4:i32=0;
  if(k64ok==1){ if(c0==509){ if(t0==4){
    if((st[282] as i32)==1){
      if((st[288] as i32)==1){ if((st[289] as i32)==0){ if((st[290] as i32)==2){
        kvt4=1;
      } } }
    }
  } } }
  at=ob_app(ob,at,"K-N1-4 ");
  if(kvt4==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-N1-5: retained under the N=1 delay+noise.
  let kvt5:i32=0;
  if(ct==771){ if((st[3] as i32)==1){ if(beq==1){ kvt5=1; } } }
  at=ob_app(ob,at,"K-N1-5 ");
  if(kvt5==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  // K-N1-6: necessity.
  let kvt6:i32=0;
  if(nom_c==0){ if(wmenu<1151){ kvt6=1; } }
  at=ob_app(ob,at,"K-N1-6 ");
  if(kvt6==1){at=ob_app(ob,at,"PASS\n");} else {at=ob_app(ob,at,"FAIL\n");}
  at=ob_app(ob,at,"K-N1-7 SHELL-3X\n");
  at=ob_app(ob,at,"N1-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

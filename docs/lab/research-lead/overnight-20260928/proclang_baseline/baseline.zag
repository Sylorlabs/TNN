// baseline.zag -- H-PROCLANG1 simple-baseline comparison (pipeline step 5).
// Frozen prereg: docs/lab/research-lead/overnight-20260928/proclang_baseline/PREREG_PROCLANG_BASELINE.md
// (committed in ddd90d06b; strict prereg-before-implementation ancestry.)
//
// B1a: exhaustive D0 search, best program selected on TRAINING data, scored on hidden.
// B1b: exhaustive D0 search, best program selected on HIDDEN data (cheating oracle upper bound).
// B2:  generic 2-piece least-squares regression per task. Exact integer arithmetic
//      (i64); no floating point anywhere. Threshold scan; threshold chosen by
//      minimizing total SSE compared with exact rational comparison.
//      No COND machinery, no operator, no persistence, no reuse, no revision.
// B3:  1-nearest-neighbor on training data, scored on hidden.
// Worlds (environment only; baselines observe only (x,y) pairs):
//   T1 y=|x|, T4 y=|x-3|, T2 y=step(x), T3 y=|1-u| (re-coordinatized).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- D0 program machinery (same frozen DSL as the builder) ----
// Op index 0..6 = ADD (idx-3); 7..13 = MUL (idx-10).
fn eval_prog(ops:[]u8, len:i32, x:i32)i32 {
  let r:i32=x;
  let i:i32=0;
  while(i<len){
    let oi:i32=ops[i] as i32;
    if(oi<7){ r=r+(oi-3); } else { r=r*(oi-10); }
    i=i+1;
  }
  return r;
}
// Evaluate a program held in a 4-byte out record [len,op0,op1,op2].
fn eval_out(out:[]u8, x:i32)i32 {
  let len:i32=out[0] as i32;
  let r:i32=x;
  let i:i32=0;
  while(i<len){
    let oi:i32=out[1+i] as i32;
    if(oi<7){ r=r+(oi-3); } else { r=r*(oi-10); }
    i=i+1;
  }
  return r;
}
fn score_out(out:[]u8, xs:[]u8, ys:[]u8, n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if(eval_out(out,get32(xs,i*4))==get32(ys,i*4)){ c=c+1; }
    i=i+1;
  }
  return c;
}
// Program list record: 4 bytes [len, op0, op1, op2].
fn build_proglist(pl:[]u8)i32 {
  let c:i32=0;
  pl[0]=0; pl[1]=255; pl[2]=255; pl[3]=255; c=1;
  let a:i32=0;
  while(a<14){
    let b4:i32=c*4;
    pl[b4]=1; pl[b4+1]=a as u8; pl[b4+2]=255; pl[b4+3]=255; c=c+1;
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let b4:i32=c*4;
      pl[b4]=2; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=255; c=c+1;
      b=b+1;
    }
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let d:i32=0;
      while(d<14){
        let b4:i32=c*4;
        pl[b4]=3; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=d as u8; c=c+1;
        d=d+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  return c;
}
fn prog_mismatches(pl:[]u8, base:i32, len:i32, xs:[]u8, ys:[]u8, n:i32)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    if(eval_prog(pl[base+1..base+4], len, get32(xs,i*4))!=get32(ys,i*4)){ m=m+1; }
    i=i+1;
  }
  return m;
}
// Best program on the given data; out 4 bytes [len,op0,op1,op2]; returns mismatches.
// Deterministic: lengths ascending, op indices ascending, strict improvement.
fn fit_best(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32, out:[]u8)i32 {
  let best:i32=n+1;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    let m:i32=prog_mismatches(pl, base, len, xs, ys, n);
    if(m<best){
      best=m;
      out[0]=pl[base]; out[1]=pl[base+1]; out[2]=pl[base+2]; out[3]=pl[base+3];
    }
    pi=pi+1;
  }
  return best;
}
fn emit_out(out:[]u8)void {
  let len:i32=out[0] as i32;
  if(len==0){ emit("ID"); return; }
  let i:i32=0;
  while(i<len){
    let oi:i32=out[1+i] as i32;
    if(i>0){ emit(";"); }
    if(oi<7){ emit("ADD "); emit(i32s(oi-3)); } else { emit("MUL "); emit(i32s(oi-10)); }
    i=i+1;
  }
  return;
}

// ---- Worlds (environment only) ----
fn world_y(task:i32, x:i32)i32 {
  if(task==1){ if(x<0){ return -x; } return x; }
  if(task==4){ let d:i32=x-3; if(d<0){ return -d; } return d; }
  if(task==2){ if(x<0){ return -1; } return 1; }
  let e:i32=1-x; if(e<0){ return -e; } return e;
}
fn task_name(task:i32)[]u8 {
  if(task==1){ return "T1_abs"; }
  if(task==4){ return "T4_abs_shift"; }
  if(task==2){ return "T2_step"; }
  return "T3_abs_recoord";
}
// Fills train (41 points) and hidden (2001 points).
fn fill_task(task:i32, txs:[]u8, tys:[]u8, hxs:[]u8, hys:[]u8)void {
  let tlo:i32=-20; let hlo:i32=-1000;
  if(task==3){ tlo=-19; hlo=-999; }
  let i:i32=0;
  while(i<41){
    let x:i32=tlo+i;
    set32(txs,i*4,x); set32(tys,i*4,world_y(task,x));
    i=i+1;
  }
  i=0;
  while(i<2001){
    let x:i32=hlo+i;
    set32(hxs,i*4,x); set32(hys,i*4,world_y(task,x));
    i=i+1;
  }
  return;
}

// ---- B2: exact integer least-squares machinery ----
// Least-squares line on points with sums (n,Sx,Sy,Sxx,Sxy,Syy), represented
// exactly as y = (P*x+Q)/D. SSE = SN/SD exactly, where
//   SN = Syy*D - (P*Sxy + Q*Sy), SD = D   (normal-equation identity),
// or for a constant side (den==0): line y = Sy/n, SSE = (n*Syy - Sy^2)/n.
// Empty side: P=0,Q=0,D=1,SN=0,SD=1. All values fit i64 on our data.
fn ls_den(n:i64, sx:i64, sxx:i64)i64 { return n*sxx-sx*sx; }
fn ls_P(n:i64, sx:i64, sy:i64, sxx:i64, sxy:i64, syy:i64)i64 {
  if(n==0){ return 0; }
  let den:i64=n*sxx-sx*sx;
  if(den==0){ return 0; }
  return n*sxy-sx*sy;
}
fn ls_Q(n:i64, sx:i64, sy:i64, sxx:i64, sxy:i64, syy:i64)i64 {
  if(n==0){ return 0; }
  let den:i64=n*sxx-sx*sx;
  if(den==0){ return sy; }
  return sxx*sy-sx*sxy;
}
fn ls_D(n:i64, sx:i64, sy:i64, sxx:i64, sxy:i64, syy:i64)i64 {
  if(n==0){ return 1; }
  let den:i64=n*sxx-sx*sx;
  if(den==0){ return n; }
  return den;
}
fn ls_SN(n:i64, sx:i64, sy:i64, sxx:i64, sxy:i64, syy:i64)i64 {
  if(n==0){ return 0; }
  let den:i64=n*sxx-sx*sx;
  if(den==0){ return n*syy-sy*sy; }
  let p:i64=n*sxy-sx*sy;
  let q:i64=sxx*sy-sx*sxy;
  return syy*den-(p*sxy+q*sy);
}
fn ls_SD(n:i64, sx:i64, sy:i64, sxx:i64, sxy:i64, syy:i64)i64 {
  if(n==0){ return 1; }
  let den:i64=n*sxx-sx*sx;
  if(den==0){ return n; }
  return den;
}
// Round num/den (den>0) to nearest integer, half away from zero.
fn round_div(num:i64, den:i64)i32 {
  let neg:i32=0;
  let v:i64=num;
  if(v<0){ neg=1; v=-v; }
  let q:i64=v/den;
  let r:i64=v%den;
  if(r*2>=den){ q=q+1; }
  if(neg==1){ q=-q; }
  return q as i32;
}
// Exact comparison of n1/d1 vs n2/d2 (d1,d2>0; n1,n2>=0). Returns -1, 0, 1.
// Quotient-remainder recursion; only integer arithmetic, no floating point.
fn cmp_frac(n1:i64, d1:i64, n2:i64, d2:i64)i32 {
  let neg:i32=0;
  let a:i64=n1; let b:i64=d1; let c:i64=n2; let e:i64=d2;
  while(1==1){
    let q1:i64=a/b; let r1:i64=a%b;
    let q2:i64=c/e; let r2:i64=c%e;
    if(q1<q2){ if(neg==1){ return 1; } return -1; }
    if(q1>q2){ if(neg==1){ return -1; } return 1; }
    if(r1==0){
      if(r2==0){ return 0; }
      if(neg==1){ return 1; } return -1;
    }
    if(r2==0){ if(neg==1){ return -1; } return 1; }
    let na:i64=b; let nb:i64=r1; let nc:i64=e; let ne:i64=r2;
    a=na; b=nb; c=nc; e=ne;
    if(neg==1){ neg=0; } else { neg=1; }
  }
  return 0;
}
// B2 for one task. ob: 8 bytes [t:i32, correct:i32]. Returns hidden correct.
fn b2_task(txs:[]u8, tys:[]u8, tn:i32, hxs:[]u8, hys:[]u8, hn:i32, ob:[]u8)i32 {
  let xmin:i32=get32(txs,0);
  let xmax:i32=xmin;
  let i:i32=1;
  while(i<tn){
    let v:i32=get32(txs,i*4);
    if(v<xmin){ xmin=v; }
    if(v>xmax){ xmax=v; }
    i=i+1;
  }
  let have:i32=0;
  let bN:i64=0;
  let bD:i64=1;
  let bt:i32=0;
  let t:i32=xmin-1;
  while(t<=xmax+1){
    let ln:i64=0; let lx:i64=0; let ly:i64=0; let lxx:i64=0; let lxy:i64=0; let lyy:i64=0;
    let rn:i64=0; let rx:i64=0; let ry:i64=0; let rxx:i64=0; let rxy:i64=0; let ryy:i64=0;
    i=0;
    while(i<tn){
      let xv:i32=get32(txs,i*4);
      let x:i64=xv as i64;
      let y:i64=get32(tys,i*4) as i64;
      if(xv<t){
        ln=ln+1; lx=lx+x; ly=ly+y; lxx=lxx+x*x; lxy=lxy+x*y; lyy=lyy+y*y;
      } else {
        rn=rn+1; rx=rx+x; ry=ry+y; rxx=rxx+x*x; rxy=rxy+x*y; ryy=ryy+y*y;
      }
      i=i+1;
    }
    let sNl:i64=ls_SN(ln,lx,ly,lxx,lxy,lyy);
    let sDl:i64=ls_SD(ln,lx,ly,lxx,lxy,lyy);
    let sNr:i64=ls_SN(rn,rx,ry,rxx,rxy,ryy);
    let sDr:i64=ls_SD(rn,rx,ry,rxx,rxy,ryy);
    let tN:i64=sNl*sDr+sNr*sDl;
    let tD:i64=sDl*sDr;
    if(have==0){ have=1; bN=tN; bD=tD; bt=t; }
    else {
      if(cmp_frac(tN,tD,bN,bD)<0){ bN=tN; bD=tD; bt=t; }
    }
    t=t+1;
  }
  // Refit both sides at the winning threshold and score hidden data.
  let ln:i64=0; let lx:i64=0; let ly:i64=0; let lxx:i64=0; let lxy:i64=0; let lyy:i64=0;
  let rn:i64=0; let rx:i64=0; let ry:i64=0; let rxx:i64=0; let rxy:i64=0; let ryy:i64=0;
  i=0;
  while(i<tn){
    let xv:i32=get32(txs,i*4);
    let x:i64=xv as i64;
    let y:i64=get32(tys,i*4) as i64;
    if(xv<bt){
      ln=ln+1; lx=lx+x; ly=ly+y; lxx=lxx+x*x; lxy=lxy+x*y; lyy=lyy+y*y;
    } else {
      rn=rn+1; rx=rx+x; ry=ry+y; rxx=rxx+x*x; rxy=rxy+x*y; ryy=ryy+y*y;
    }
    i=i+1;
  }
  let pL:i64=ls_P(ln,lx,ly,lxx,lxy,lyy);
  let qL:i64=ls_Q(ln,lx,ly,lxx,lxy,lyy);
  let dL:i64=ls_D(ln,lx,ly,lxx,lxy,lyy);
  let pR:i64=ls_P(rn,rx,ry,rxx,rxy,ryy);
  let qR:i64=ls_Q(rn,rx,ry,rxx,rxy,ryy);
  let dR:i64=ls_D(rn,rx,ry,rxx,rxy,ryy);
  let correct:i32=0;
  i=0;
  while(i<hn){
    let hx:i32=get32(hxs,i*4);
    let pred:i32=0;
    if(hx<bt){ pred=round_div(pL*(hx as i64)+qL, dL); }
    else { pred=round_div(pR*(hx as i64)+qR, dR); }
    if(pred==get32(hys,i*4)){ correct=correct+1; }
    i=i+1;
  }
  set32(ob,0,bt);
  set32(ob,4,correct);
  return correct;
}

// ---- B3: 1-nearest-neighbor ----
fn b3_task(txs:[]u8, tys:[]u8, tn:i32, hxs:[]u8, hys:[]u8, hn:i32)i32 {
  let correct:i32=0;
  let i:i32=0;
  while(i<hn){
    let hx:i32=get32(hxs,i*4);
    let bestj:i32=0;
    let bestd:i32=2147483647;
    let j:i32=0;
    while(j<tn){
      let d:i32=hx-get32(txs,j*4);
      if(d<0){ d=-d; }
      if(d<bestd){ bestd=d; bestj=j; }
      j=j+1;
    }
    if(get32(tys,bestj*4)==get32(hys,i*4)){ correct=correct+1; }
    i=i+1;
  }
  return correct;
}

fn main()void {
  emit("BASELINE_RUN prereg=PREREG_PROCLANG_BASELINE.md\n");
  let pl:[]u8=z_alloc(2955*4);
  let pn:i32=build_proglist(pl);
  emit("PROGLIST n=");
  emit(i32s(pn));
  emit("\n");
  let txs:[]u8=z_alloc(41*4);
  let tys:[]u8=z_alloc(41*4);
  let hxs:[]u8=z_alloc(2001*4);
  let hys:[]u8=z_alloc(2001*4);
  let out:[]u8=z_alloc(4);
  let ob:[]u8=z_alloc(8);
  let seq:i32=0;
  while(seq<4){
    let task:i32=1;
    if(seq==1){ task=4; }
    if(seq==2){ task=2; }
    if(seq==3){ task=3; }
    fill_task(task, txs, tys, hxs, hys);
    emit("TASK id=");
    emit(i32s(task));
    emit(" name=");
    emit(task_name(task));
    emit("\n");
    // B1a: train-selected affine program, scored on hidden.
    let mmA:i32=fit_best(pl, pn, txs, tys, 41, out);
    let cA:i32=score_out(out, hxs, hys, 2001);
    emit("B1A train_mm=");
    emit(i32s(mmA));
    emit(" prog=");
    emit_out(out);
    emit(" hidden_correct=");
    emit(i32s(cA));
    emit(" n=2001\n");
    // B1b: hidden-selected affine program (cheating oracle upper bound).
    let mmB:i32=fit_best(pl, pn, hxs, hys, 2001, out);
    let cB:i32=2001-mmB;
    emit("B1B prog=");
    emit_out(out);
    emit(" hidden_correct=");
    emit(i32s(cB));
    emit(" n=2001\n");
    // B2: generic 2-piece least squares.
    let c2:i32=b2_task(txs, tys, 41, hxs, hys, 2001, ob);
    emit("B2 t=");
    emit(i32s(get32(ob,0)));
    emit(" hidden_correct=");
    emit(i32s(c2));
    emit(" n=2001\n");
    // B3: 1-nearest-neighbor.
    let c3:i32=b3_task(txs, tys, 41, hxs, hys, 2001);
    emit("B3 hidden_correct=");
    emit(i32s(c3));
    emit(" n=2001\n");
    seq=seq+1;
  }
  emit("BASELINE_DONE\n");
  return;
}

// substrate.zag: shared substrate prototype.
// One continuing workspace W hosts a fact store AND an episodic
// causal store. The variable count (nvar) is a runtime header
// field, never a compile-time constant. All strides and offsets
// are computed from nvar. Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ header ============
// 0 magic, 4 nvar, 8 ep_stride, 12 ent_stride, 16 ep_base,
// 20 ent_base, 24 fact_base, 28 str_base, 32 str_cursor,
// 36 ep_count, 40 ent_count, 44 fact_count, 48 seq,
// 52 max_ep, 56 max_ent, 60 max_fact, 64 fact_conflicts, 68 ep_processed
fn h_nvar(W:[]u8)i32 { return get32(W,4); }
fn h_epstride(W:[]u8)i32 { return get32(W,8); }
fn h_entstride(W:[]u8)i32 { return get32(W,12); }
fn h_epbase(W:[]u8)i32 { return get32(W,16); }
fn h_entbase(W:[]u8)i32 { return get32(W,20); }
fn h_factbase(W:[]u8)i32 { return get32(W,24); }
fn h_strbase(W:[]u8)i32 { return get32(W,28); }
fn h_strcur(W:[]u8)i32 { return get32(W,32); }
fn h_strcur_set(W:[]u8, v:i32)void { set32(W,32,v); return; }
fn h_epcount(W:[]u8)i32 { return get32(W,36); }
fn h_epcount_set(W:[]u8, v:i32)void { set32(W,36,v); return; }
fn h_entcount(W:[]u8)i32 { return get32(W,40); }
fn h_entcount_set(W:[]u8, v:i32)void { set32(W,40,v); return; }
fn h_factcount(W:[]u8)i32 { return get32(W,44); }
fn h_factcount_set(W:[]u8, v:i32)void { set32(W,44,v); return; }
fn h_seq(W:[]u8)i32 { return get32(W,48); }
fn h_seq_set(W:[]u8, v:i32)void { set32(W,48,v); return; }
fn h_conflicts(W:[]u8)i32 { return get32(W,64); }
fn h_conflicts_set(W:[]u8, v:i32)void { set32(W,64,v); return; }
fn h_epproc(W:[]u8)i32 { return get32(W,68); }
fn h_epproc_set(W:[]u8, v:i32)void { set32(W,68,v); return; }

fn sub_init(W:[]u8, nvar:i32)i32 {
  if(nvar<1 || nvar>8){
    emit("substrate: nvar out of range\n");
    return 0;
  }
  let ep_stride:i32=((5+2*nvar+3)/4)*4;
  let ent_stride:i32=((56+9*nvar+3)/4)*4;
  let ep_base:i32=128;
  let ent_base:i32=ep_base+64*ep_stride;
  let fact_base:i32=ent_base+64*ent_stride;
  let str_base:i32=fact_base+256*12;
  if(str_base+4096>32768){
    emit("substrate: workspace too small\n");
    return 0;
  }
  set32(W,0,1397057875);
  set32(W,4,nvar);
  set32(W,8,ep_stride);
  set32(W,12,ent_stride);
  set32(W,16,ep_base);
  set32(W,20,ent_base);
  set32(W,24,fact_base);
  set32(W,28,str_base);
  set32(W,32,str_base);
  set32(W,36,0);
  set32(W,40,0);
  set32(W,44,0);
  set32(W,48,0);
  set32(W,52,64);
  set32(W,56,64);
  set32(W,60,256);
  set32(W,64,0);
  set32(W,68,0);
  return 1;
}

// ============ strings ============
// record: len(4) + bytes. returns offset of len field.
fn sub_str(W:[]u8, s:[]u8)i32 {
  let p:i32=h_strcur(W);
  set32(W,p,s.len);
  let i:i32=0;
  while(i<s.len){ W[p+4+i]=s[i]; i=i+1; }
  h_strcur_set(W,p+4+s.len);
  return p;
}
fn sub_streq(W:[]u8, o1:i32, o2:i32)i32 {
  let l1:i32=get32(W,o1);
  let l2:i32=get32(W,o2);
  if(l1!=l2){return 0;}
  let i:i32=0;
  while(i<l1){
    if(W[o1+4+i]!=W[o2+4+i]){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ fact store ============
// triple: e_off(4), a_off(4), v_off(4)
fn sub_fact_learn(W:[]u8, e:[]u8, a:[]u8, v:[]u8)i32 {
  let fc:i32=h_factcount(W);
  if(fc>=256){return -1;}
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let vo:i32=sub_str(W,v);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      if(sub_streq(W,get32(W,o+8),vo)==0){
        h_conflicts_set(W,h_conflicts(W)+1);
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  h_factcount_set(W,fc+1);
  return fc;
}
// latest matching triple; copies value bytes to out; returns len or -1
fn sub_fact_query(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      let vo:i32=get32(W,o+8);
      let l:i32=get32(W,vo);
      let k:i32=0;
      while(k<l){ out[k]=W[vo+4+k]; k=k+1; }
      return l;
    }
    i=i-1;
  }
  return -1;
}

// ============ episodes ============
// record: seq(4), state[nvar], act(1), next[nvar]
fn ep_off(W:[]u8, e:i32)i32 { return h_epbase(W)+e*h_epstride(W); }
fn ep_state(W:[]u8, e:i32, v:i32)i32 { return W[ep_off(W,e)+4+v] as i32; }
fn ep_act(W:[]u8, e:i32)i32 { return W[ep_off(W,e)+4+h_nvar(W)] as i32; }
fn ep_next(W:[]u8, e:i32, v:i32)i32 { return W[ep_off(W,e)+5+h_nvar(W)+v] as i32; }
fn sub_episode(W:[]u8, state:[]u8, act:i32, next:[]u8)i32 {
  let i:i32=h_epcount(W);
  if(i>=64){return -1;}
  let nvar:i32=h_nvar(W);
  let o:i32=ep_off(W,i);
  set32(W,o,h_seq(W));
  h_seq_set(W,h_seq(W)+1);
  let v:i32=0;
  while(v<nvar){ W[o+4+v]=state[v]; v=v+1; }
  W[o+4+nvar]=act as u8;
  v=0;
  while(v<nvar){ W[o+5+nvar+v]=next[v]; v=v+1; }
  h_epcount_set(W,i+1);
  return i;
}

// ============ causal entries ============
// used(4), action(4), mask(4), cond[4*nvar], kind[nvar],
// param[4*nvar], status(4), parent(4), nsup(4), sup[8*4]
// kind: 0=UNRES, 1=UNCH, 2=UNCHANGED-SET? no: 1=UNCH, 2=SET
// status: 0=active, 1=ambiguous, 2=superseded
fn en_off(W:[]u8, i:i32)i32 { return h_entbase(W)+i*h_entstride(W); }
fn en_used(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)); }
fn en_action(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+4); }
fn en_mask(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+8); }
fn en_cond(W:[]u8, i:i32, v:i32)i32 { return get32(W,en_off(W,i)+12+v*4); }
fn en_kind(W:[]u8, i:i32, v:i32)i32 { return W[en_off(W,i)+12+4*h_nvar(W)+v] as i32; }
fn en_param(W:[]u8, i:i32, v:i32)i32 { return get32(W,en_off(W,i)+12+5*h_nvar(W)+v*4); }
fn en_status(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+12+9*h_nvar(W)); }
fn en_status_set(W:[]u8, i:i32, s:i32)void { set32(W,en_off(W,i)+12+9*h_nvar(W),s); return; }
fn en_nsup(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+20+9*h_nvar(W)); }
fn en_sup(W:[]u8, i:i32, k:i32)i32 { return get32(W,en_off(W,i)+24+9*h_nvar(W)+k*4); }

fn ent_create(W:[]u8, act:i32, mask:i32, cond:[]u8, kind:[]u8, param:[]u8, parent:i32)i32 {
  let i:i32=h_entcount(W);
  if(i>=64){return -1;}
  let nvar:i32=h_nvar(W);
  let o:i32=en_off(W,i);
  set32(W,o,1);
  set32(W,o+4,act);
  set32(W,o+8,mask);
  let v:i32=0;
  while(v<nvar){ set32(W,o+12+v*4,get32(cond,v*4)); v=v+1; }
  v=0;
  while(v<nvar){ W[o+12+4*nvar+v]=kind[v]; v=v+1; }
  v=0;
  while(v<nvar){ set32(W,o+12+5*nvar+v*4,get32(param,v*4)); v=v+1; }
  set32(W,o+12+9*nvar,0);
  set32(W,o+16+9*nvar,parent);
  set32(W,o+20+9*nvar,0);
  h_entcount_set(W,i+1);
  return i;
}
fn ent_add_sup(W:[]u8, i:i32, e:i32)i32 {
  let n:i32=en_nsup(W,i);
  let k:i32=0;
  while(k<n){
    if(en_sup(W,i,k)==e){return 0;}
    k=k+1;
  }
  if(n>=8){return 0;}
  set32(W,en_off(W,i)+24+9*h_nvar(W)+n*4,e);
  set32(W,en_off(W,i)+20+9*h_nvar(W),n+1);
  return 1;
}
fn cond_matches(W:[]u8, i:i32, state:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let m:i32=en_mask(W,i);
  let v:i32=0;
  while(v<nvar){
    if(((m>>v)&1)==1){
      if(en_cond(W,i,v)!=(state[v] as i32)){return 0;}
    }
    v=v+1;
  }
  return 1;
}
// consistency of entry i with (state,next): 1 ok, 0 conflict
fn ent_consistent(W:[]u8, i:i32, state:[]u8, next:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let v:i32=0;
  while(v<nvar){
    let k:i32=en_kind(W,i,v);
    if(k==1){
      if((next[v] as i32)!=(state[v] as i32)){return 0;}
    } else {
      if(k==2){
        if((next[v] as i32)!=en_param(W,i,v)){return 0;}
      }
    }
    v=v+1;
  }
  return 1;
}
fn popcnt(m:i32)i32 {
  let c:i32=0;
  while(m>0){ c=c+(m&1); m=m>>1; }
  return c;
}

// incremental learning over unprocessed episodes
fn sub_causal_update(W:[]u8)void {
  let nvar:i32=h_nvar(W);
  while(h_epproc(W)<h_epcount(W)){
    let e:i32=h_epproc(W);
    let act:i32=ep_act(W,e);
    let state:[]u8=z_alloc(8);
    let next:[]u8=z_alloc(8);
    let v:i32=0;
    while(v<nvar){ state[v]=ep_state(W,e,v) as u8; next[v]=ep_next(W,e,v) as u8; v=v+1; }
    // find matching active entries
    let nmatch:i32=0;
    let mi:i32=0;
    while(mi<h_entcount(W)){
      if(en_used(W,mi)==1 && en_status(W,mi)==0 && en_action(W,mi)==act && cond_matches(W,mi,state)==1){
        if(ent_consistent(W,mi,state,next)==1){
          if(ent_add_sup(W,mi,e)==1){
            emit("CAUSAL support entry ");
            emit(i32s(mi));
            emit(" ep ");
            emit(i32s(e));
            emit("\n");
          }
        } else {
          // specialize: parent becomes ambiguous, two children
          en_status_set(W,mi,1);
          emit("CAUSAL entry ");
          emit(i32s(mi));
          emit(" AMBIGUOUS on ep ");
          emit(i32s(e));
          emit("\n");
          // v* = first var where state differs from first support state
          let se:i32=en_sup(W,mi,0);
          let vs:i32=-1;
          v=0;
          while(v<nvar){
            if((state[v] as i32)!=ep_state(W,se,v)){ vs=v; break; }
            v=v+1;
          }
          let cmask:i32=en_mask(W,mi);
          let ccond:[]u8=z_alloc(32);
          let ckind:[]u8=z_alloc(8);
          let cparam:[]u8=z_alloc(32);
          v=0;
          while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
          if(vs<0){
            // nondeterministic on identical state: fully specific children
            cmask=(1<<nvar)-1;
            v=0;
            while(v<nvar){ set32(ccond,v*4,state[v] as i32); v=v+1; }
            let c1:i32=ent_create(W,act,cmask,ccond,ckind,cparam,mi);
            // fill child1 effects from new episode
            v=0;
            while(v<nvar){
              let o1:i32=en_off(W,c1);
              if((next[v] as i32)==(state[v] as i32)){ W[o1+12+4*nvar+v]=1 as u8; }
              else { W[o1+12+4*nvar+v]=2 as u8; set32(W,o1+12+5*nvar+v*4,next[v] as i32); }
              v=v+1;
            }
            ent_add_sup(W,c1,e);
            emit("CAUSAL new child entry ");
            emit(i32s(c1));
            emit(" (nondeterministic split)\n");
          } else {
            let oldv:i32=ep_state(W,se,vs);
            // child1: new episode side
            let m1:i32=cmask|(1<<vs);
            v=0;
            while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
            set32(ccond,vs*4,state[vs] as i32);
            v=0;
            while(v<nvar){
              if((next[v] as i32)==(state[v] as i32)){ ckind[v]=1 as u8; }
              else { ckind[v]=2 as u8; }
              set32(cparam,v*4,next[v] as i32);
              v=v+1;
            }
            let c1:i32=ent_create(W,act,m1,ccond,ckind,cparam,mi);
            ent_add_sup(W,c1,e);
            emit("CAUSAL new child entry ");
            emit(i32s(c1));
            emit(" cond v");
            emit(i32s(vs));
            emit("=");
            emit(i32s(state[vs] as i32));
            emit("\n");
            // child2: old support side, parent effects
            let m2:i32=cmask|(1<<vs);
            v=0;
            while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
            set32(ccond,vs*4,oldv);
            v=0;
            while(v<nvar){
              ckind[v]=en_kind(W,mi,v) as u8;
              set32(cparam,v*4,en_param(W,mi,v));
              v=v+1;
            }
            let c2:i32=ent_create(W,act,m2,ccond,ckind,cparam,mi);
            // carry consistent support
            let k:i32=0;
            while(k<en_nsup(W,mi)){
              let oe:i32=en_sup(W,mi,k);
              let okk:i32=1;
              if(ep_state(W,oe,vs)!=oldv){okk=0;}
              if(okk==1){
                let st2:[]u8=z_alloc(8);
                let nx2:[]u8=z_alloc(8);
                let w2:i32=0;
                while(w2<nvar){ st2[w2]=ep_state(W,oe,w2) as u8; nx2[w2]=ep_next(W,oe,w2) as u8; w2=w2+1; }
                if(ent_consistent(W,c2,st2,nx2)==1){ent_add_sup(W,c2,oe);}
              }
              k=k+1;
            }
            emit("CAUSAL new child entry ");
            emit(i32s(c2));
            emit(" cond v");
            emit(i32s(vs));
            emit("=");
            emit(i32s(oldv));
            emit("\n");
          }
        }
        nmatch=nmatch+1;
      }
      mi=mi+1;
    }
    if(nmatch==0){
      // fresh general entry: empty mask, effects from this episode
      let ccond:[]u8=z_alloc(32);
      let ckind:[]u8=z_alloc(8);
      let cparam:[]u8=z_alloc(32);
      v=0;
      while(v<nvar){
        set32(ccond,v*4,0);
        if((next[v] as i32)==(state[v] as i32)){ ckind[v]=1 as u8; }
        else { ckind[v]=2 as u8; }
        set32(cparam,v*4,next[v] as i32);
        v=v+1;
      }
      let ni:i32=ent_create(W,act,0,ccond,ckind,cparam,-1);
      ent_add_sup(W,ni,e);
      emit("CAUSAL new entry ");
      emit(i32s(ni));
      emit(" act=");
      emit(i32s(act));
      emit(" mask=0\n");
    }
    h_epproc_set(W,e+1);
  }
  return;
}

// query: most specific matching active entry predicts.
// returns 1 with out_next filled, 2 ambiguous, 0 no match.
fn sub_causal_query(W:[]u8, state:[]u8, act:i32, out_next:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let best:i32=-1;
  let bestbits:i32=-1;
  let i:i32=0;
  while(i<h_entcount(W)){
    if(en_used(W,i)==1 && en_status(W,i)==0 && en_action(W,i)==act && cond_matches(W,i,state)==1){
      let b:i32=popcnt(en_mask(W,i));
      if(b>bestbits){bestbits=b; best=i;}
    }
    i=i+1;
  }
  if(best<0){return 0;}
  // tie check: another active entry with same specificity disagreeing
  i=0;
  while(i<h_entcount(W)){
    if(i!=best && en_used(W,i)==1 && en_status(W,i)==0 && en_action(W,i)==act && cond_matches(W,i,state)==1){
      if(popcnt(en_mask(W,i))==bestbits){
        let v:i32=0;
        let same:i32=1;
        while(v<nvar){
          let p1:i32=0;
          let p2:i32=0;
          if(en_kind(W,best,v)==1){p1=state[v] as i32;} else {p1=en_param(W,best,v);}
          if(en_kind(W,i,v)==1){p2=state[v] as i32;} else {p2=en_param(W,i,v);}
          if(p1!=p2){same=0; break;}
          v=v+1;
        }
        if(same==0){return 2;}
      }
    }
    i=i+1;
  }
  let v2:i32=0;
  while(v2<nvar){
    if(en_kind(W,best,v2)==1){out_next[v2]=state[v2];}
    else {out_next[v2]=en_param(W,best,v2) as u8;}
    v2=v2+1;
  }
  return 1;
}

fn emit_state(tag:[]u8, s:[]u8, nvar:i32)void {
  emit(tag);
  let v:i32=0;
  while(v<nvar){ emit(i32s(s[v] as i32)); v=v+1; }
  return;
}

// ==== S1/S2 episodes (from substrate_integ) ====
fn s1_ep(i:i32)[]u8 {
  if(i==0){return "bikgup";} if(i==1){return "gupzol";}
  if(i==2){return "bikguptav";} if(i==3){return "zolbik";}
  if(i==4){return "tavgupbik";} if(i==5){return "bikgupzol";}
  if(i==6){return "guptav";} if(i==7){return "bikgup";}
  if(i==8){return "zoltav";} if(i==9){return "tavbikgup";}
  if(i==10){return "gupzoltav";} return "bikgup";
}
fn s1_len(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 6;} if(i==2){return 9;}
  if(i==3){return 6;} if(i==4){return 9;} if(i==5){return 9;}
  if(i==6){return 6;} if(i==7){return 6;} if(i==8){return 6;}
  if(i==9){return 9;} if(i==10){return 9;} return 6;
}
fn s2_ep(i:i32)[]u8 {
  if(i==0){return "zolgupbik";} if(i==1){return "tavzoltav";}
  if(i==2){return "gupbikzol";} if(i==3){return "biktav";}
  if(i==4){return "zolgup";} return "tavgupzol";
}
fn s2_len(i:i32)i32 {
  if(i==0){return 9;} if(i==1){return 9;} if(i==2){return 9;}
  if(i==3){return 6;} if(i==4){return 6;} return 9;
}
fn cname(ci:i32)[]u8 {
  if(ci==0){return "c0";} if(ci==1){return "c1";}
  if(ci==2){return "c2";} return "c3";
}
fn morph_of_init(ib:i32)[]u8 {
  if(ib==98){return "bik";}
  if(ib==103){return "gup";}
  if(ib==122){return "zol";}
  return "tav";
}
fn is_member(W:[]u8, ci:i32, morph:[]u8)i32 {
  let fc:i32=h_factcount(W);
  let eo:i32=sub_str(W,cname(ci));
  let ao:i32=sub_str(W,"member");
  let mo:i32=sub_str(W,morph);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1 && sub_streq(W,get32(W,o+8),mo)==1){
      return 1;
    }
    i=i+1;
  }
  return 0;
}

// ==== bigram layer (S4) ====
// Bigram entity: bg_N. Facts: (bg_N,"first",A), (bg_N,"second",B), (bg_N,"count","<n>")
fn bg_name(n:i32)[]u8 {
  let b:[]u8=z_alloc(6);
  b[0]=98; b[1]=103; b[2]=95;
  if(n<10){
    b[3]=(48+n) as u8;
    return b[0..4];
  }
  b[3]=49;
  b[4]=(48+(n-10)) as u8;
  return b[0..5];
}
fn parse_i32(s:[]u8, n:i32)i32 {
  let v:i32=0;
  let i:i32=0;
  while(i<n){
    let c:i32=s[i] as i32;
    if(c>=48 && c<=57){ v=v*10+(c-48); }
    i=i+1;
  }
  return v;
}
fn streq2(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}
// bg_find: return N such that (bg_N,"first")==A and (bg_N,"second")==B, or -1
fn bg_find(W:[]u8, nbg:i32, A:[]u8, B:[]u8)i32 {
  let qb:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nbg){
    let bn:[]u8=bg_name(n);
    let l1:i32=sub_fact_query(W,bn,"first",qb);
    if(l1==A.len && streq2(qb[0..l1],A)==1){
      let l2:i32=sub_fact_query(W,bn,"second",qb);
      if(l2==B.len && streq2(qb[0..l2],B)==1){
        return n;
      }
    }
    n=n+1;
  }
  return -1;
}
// bg_learn: increment count for (A,B), or create new. Returns N. nbg_out[0] updated.
fn bg_learn(W:[]u8, nbg:i32, A:[]u8, B:[]u8, nbg_out:[]u8)i32 {
  let n:i32=bg_find(W,nbg,A,B);
  let qb:[]u8=z_alloc(16);
  if(n>=0){
    let bn:[]u8=bg_name(n);
    let l:i32=sub_fact_query(W,bn,"count",qb);
    let c:i32=parse_i32(qb,l);
    c=c+1;
    sub_fact_learn(W,bn,"count",i32s(c));
    return n;
  }
  // create new
  if(nbg>=12){ return -1; }
  let bn2:[]u8=bg_name(nbg);
  sub_fact_learn(W,bn2,"first",A);
  sub_fact_learn(W,bn2,"second",B);
  sub_fact_learn(W,bn2,"count","1");
  set32(nbg_out,0,nbg+1);
  return nbg;
}
fn bg_count(W:[]u8, nbg:i32, A:[]u8, B:[]u8)i32 {
  let n:i32=bg_find(W,nbg,A,B);
  if(n<0){ return 0; }
  let qb:[]u8=z_alloc(16);
  let l:i32=sub_fact_query(W,bg_name(n),"count",qb);
  return parse_i32(qb,l);
}

// ==== procedure layer (S5) ====
// Procedure entity: proc_N. Facts: (proc_N,"len","<n>"), (proc_N,"step<i>",X),
// (proc_N,"status",S), (proc_N,"support","<n>")
fn proc_name(n:i32)[]u8 {
  let b:[]u8=z_alloc(8);
  b[0]=112; b[1]=114; b[2]=111; b[3]=99; b[4]=95;
  b[5]=(48+n) as u8;
  return b[0..6];
}
fn proc_create(W:[]u8, n:i32, A:[]u8, B:[]u8, support:i32)void {
  let pn:[]u8=proc_name(n);
  sub_fact_learn(W,pn,"len","2");
  sub_fact_learn(W,pn,"step0",A);
  sub_fact_learn(W,pn,"step1",B);
  sub_fact_learn(W,pn,"status","ACTIVE");
  sub_fact_learn(W,pn,"support",i32s(support));
  return;
}
fn proc_status(W:[]u8, n:i32, out:[]u8)i32 {
  return sub_fact_query(W,proc_name(n),"status",out);
}
fn proc_support(W:[]u8, n:i32)i32 {
  let qb:[]u8=z_alloc(16);
  let l:i32=sub_fact_query(W,proc_name(n),"support",qb);
  if(l<0){ return -1; }
  return parse_i32(qb,l);
}

fn main()i32 {
  let W:[]u8=z_alloc(32768);
  if(sub_init(W,3)==0){ emit("INIT FAIL\n"); return 1; }
  emit("SUBSTRATE-EXT init nvar=3 ok\n");
  let fails:i32=0;

  // concept feature table (Zag-side; facts go to substrate)
  let c_init:[]u8=z_alloc(4);
  let c_len:[]u8=z_alloc(4);
  let ncon:i32=0;
  let nmorph:i32=0;
  // bigram count (Zag-side; facts go to substrate)
  let nbg_out:[]u8=z_alloc(4);
  set32(nbg_out,0,0);

  // ---- S1/S2 replay: feed morphemes, form concepts, feed bigrams ----
  let phase:i32=0;
  while(phase<2){
    let nep:i32=0;
    if(phase==0){nep=12;} else {nep=6;}
    let i:i32=0;
    while(i<nep){
      let s:[]u8="";
      let n:i32=0;
      if(phase==0){ s=s1_ep(i); n=s1_len(i); } else { s=s2_ep(i); n=s2_len(i); }
      if(n%3!=0){ emit("CHECK FAIL seg-nmod3\n"); fails=fails+1; }
      // collect morphemes for bigram feeding
      let morphs:[]u8=z_alloc(4*4);
      let nm:i32=0;
      let m:i32=0;
      while(m<n){
        let morph:[]u8=s[m..m+3];
        // store morph bytes for bigram phase
        morphs[nm*4+0]=morph[0];
        morphs[nm*4+1]=morph[1];
        morphs[nm*4+2]=morph[2];
        nm=nm+1;
        nmorph=nmorph+1;
        sub_fact_learn(W,morph,"lenclass","L3");
        let ib:[]u8=z_alloc(1);
        ib[0]=morph[0];
        sub_fact_learn(W,morph,"initbyte",ib);
        let ci:i32=-1;
        let k:i32=0;
        while(k<ncon){
          if(c_len[k]==51 && c_init[k]==morph[0]){ ci=k; }
          k=k+1;
        }
        if(ci<0){
          ci=ncon; ncon=ncon+1;
          c_len[ci]=51; c_init[ci]=morph[0];
          sub_fact_learn(W,cname(ci),"feat_len","L3");
          sub_fact_learn(W,cname(ci),"feat_init",ib);
        }
        sub_fact_learn(W,cname(ci),"member",morph);
        m=m+3;
      }
      // feed bigrams: adjacent morpheme pairs
      let b:i32=0;
      while(b+1<nm){
        let A:[]u8=z_alloc(3);
        A[0]=morphs[b*4+0]; A[1]=morphs[b*4+1]; A[2]=morphs[b*4+2];
        let B:[]u8=z_alloc(3);
        B[0]=morphs[(b+1)*4+0]; B[1]=morphs[(b+1)*4+1]; B[2]=morphs[(b+1)*4+2];
        let nbg:i32=get32(nbg_out,0);
        bg_learn(W,nbg,A,B,nbg_out);
        b=b+1;
      }
      i=i+1;
    }
    phase=phase+1;
  }
  let nbg:i32=get32(nbg_out,0);
  emit("MORPHEMES-FED ");
  emit(i32s(nmorph));
  emit(" CONCEPTS ");
  emit(i32s(ncon));
  emit(" BIGRAMS ");
  emit(i32s(nbg));
  emit("\n");

  // ---- K1a: 4 concepts ----
  let k1ok:i32=1;
  if(ncon!=4){ k1ok=0; }
  let seen:[]u8=z_alloc(4);
  let ci2:i32=0;
  while(ci2<4){
    let qbuf:[]u8=z_alloc(8);
    let ql:i32=sub_fact_query(W,cname(ci2),"feat_init",qbuf);
    if(ql!=1){ k1ok=0; }
    else {
      let ib2:i32=qbuf[0] as i32;
      if(ib2!=98 && ib2!=103 && ib2!=122 && ib2!=116){ k1ok=0; }
      seen[ci2]=qbuf[0];
      if(is_member(W,ci2,morph_of_init(ib2))!=1){ k1ok=0; }
    }
    ci2=ci2+1;
  }
  let c1snap:[]u8=z_alloc(4);
  ci2=0;
  while(ci2<4){ c1snap[ci2]=seen[ci2]; ci2=ci2+1; }
  if(k1ok==1){ emit("CHECK PASS K1a-concepts-4\n"); }
  else { emit("CHECK FAIL K1a-concepts-4\n"); fails=fails+1; }

  // ---- K1b: 12 bigrams, bik->gup == 6 ----
  let k1bok:i32=1;
  if(nbg!=12){
    emit("CHECK FAIL bigram-count nbg=");
    emit(i32s(nbg));
    emit(" expected 12\n");
    k1bok=0;
  }
  let c_bg:i32=bg_count(W,nbg,"bik","gup");
  if(c_bg!=6){
    emit("CHECK FAIL bik->gup count=");
    emit(i32s(c_bg));
    emit(" expected 6\n");
    k1bok=0;
  }
  // spot-check other counts from DEVINT1 S4
  if(bg_count(W,nbg,"gup","zol")!=4){ emit("CHECK FAIL gup->zol\n"); k1bok=0; }
  if(bg_count(W,nbg,"gup","bik")!=3){ emit("CHECK FAIL gup->bik\n"); k1bok=0; }
  if(bg_count(W,nbg,"zol","tav")!=3){ emit("CHECK FAIL zol->tav\n"); k1bok=0; }
  if(k1bok==1){ emit("CHECK PASS K1b-bigrams-12\n"); }
  else { fails=fails+1; }

  // ---- S5: create 4 procedures ----
  proc_create(W,0,"bik","gup",6);
  proc_create(W,1,"gup","zol",4);
  proc_create(W,2,"gup","bik",3);
  proc_create(W,3,"zol","tav",3);
  let k1cok:i32=1;
  let pi:i32=0;
  while(pi<4){
    let sb:[]u8=z_alloc(16);
    let sl:i32=proc_status(W,pi,sb);
    if(sl!=6 || streq2(sb[0..sl],"ACTIVE")!=1){
      emit("CHECK FAIL proc-status ");
      emit(i32s(pi));
      emit("\n");
      k1cok=0;
    }
    pi=pi+1;
  }
  if(proc_support(W,0)!=6){ emit("CHECK FAIL proc0-support\n"); k1cok=0; }
  if(proc_support(W,1)!=4){ emit("CHECK FAIL proc1-support\n"); k1cok=0; }
  if(proc_support(W,2)!=3){ emit("CHECK FAIL proc2-support\n"); k1cok=0; }
  if(proc_support(W,3)!=3){ emit("CHECK FAIL proc3-support\n"); k1cok=0; }
  if(k1cok==1){ emit("CHECK PASS K1c-procedures-4\n"); }
  else { fails=fails+1; }

  // snapshot C1 for interference check (after bigrams+procedures, before causal)
  let c1b:[]u8=z_alloc(4);
  ci2=0;
  while(ci2<4){ c1b[ci2]=c1snap[ci2]; ci2=ci2+1; }

  // ---- causal phase: 5 episodes, same workspace ----
  let s:[]u8=z_alloc(8);
  let nx:[]u8=z_alloc(8);
  s[0]=0; s[1]=0; s[2]=0; nx[0]=1; nx[1]=0; nx[2]=0;
  sub_episode(W,s,1,nx);
  s[0]=1; s[1]=0; s[2]=0; nx[0]=1; nx[1]=1; nx[2]=0;
  sub_episode(W,s,2,nx);
  s[0]=0; s[1]=0; s[2]=0; nx[0]=0; nx[1]=0; nx[2]=0;
  sub_episode(W,s,2,nx);
  s[0]=1; s[1]=1; s[2]=0; nx[0]=1; nx[1]=1; nx[2]=1;
  sub_episode(W,s,2,nx);
  s[0]=1; s[1]=0; s[2]=0; nx[0]=1; nx[1]=1; nx[2]=0;
  sub_episode(W,s,2,nx);
  sub_causal_update(W);
  if(h_epcount(W)!=5 || h_epproc(W)!=5){
    emit("CHECK FAIL ep-counts\n"); fails=fails+1;
  } else { emit("CHECK PASS ep-counts\n"); }

  // ---- K2a: concepts maintained (C2 == C1) ----
  let k2aok:i32=1;
  ci2=0;
  while(ci2<4){
    let qbuf2:[]u8=z_alloc(8);
    let ql2:i32=sub_fact_query(W,cname(ci2),"feat_init",qbuf2);
    if(ql2!=1){ k2aok=0; }
    else {
      if(qbuf2[0]!=c1b[ci2]){ k2aok=0; }
      if(is_member(W,ci2,morph_of_init(qbuf2[0] as i32))!=1){ k2aok=0; }
    }
    ci2=ci2+1;
  }
  if(k2aok==1){ emit("CHECK PASS K2a-concepts-maintained\n"); }
  else { emit("CHECK FAIL K2a-concepts-maintained\n"); fails=fails+1; }

  // ---- K2b: bigrams maintained after causal ----
  let k2bok:i32=1;
  if(bg_count(W,nbg,"bik","gup")!=6){ emit("CHECK FAIL bg-after-causal\n"); k2bok=0; }
  if(bg_count(W,nbg,"gup","zol")!=4){ emit("CHECK FAIL bg2-after-causal\n"); k2bok=0; }
  if(k2bok==1){ emit("CHECK PASS K2b-bigrams-maintained\n"); }
  else { fails=fails+1; }

  // ---- K2c: procedures maintained after causal ----
  let k2cok:i32=1;
  if(proc_support(W,0)!=6){ emit("CHECK FAIL proc-after-causal\n"); k2cok=0; }
  let psb:[]u8=z_alloc(16);
  let psl:i32=proc_status(W,0,psb);
  if(psl!=6 || streq2(psb[0..psl],"ACTIVE")!=1){ emit("CHECK FAIL proc-status-after\n"); k2cok=0; }
  if(k2cok==1){ emit("CHECK PASS K2c-procedures-maintained\n"); }
  else { fails=fails+1; }

  // ---- K2d: causal queries correct ----
  let out:[]u8=z_alloc(8);
  let qr:i32=0;
  s[0]=1; s[1]=1; s[2]=0;
  qr=sub_causal_query(W,s,2,out);
  if(qr!=1 || out[0]!=1 || out[1]!=1 || out[2]!=1){
    emit("CHECK FAIL q110\n"); fails=fails+1;
  } else { emit("CHECK PASS q110\n"); }
  s[0]=1; s[1]=0; s[2]=0;
  qr=sub_causal_query(W,s,2,out);
  if(qr!=1 || out[0]!=1 || out[1]!=1 || out[2]!=0){
    emit("CHECK FAIL q100\n"); fails=fails+1;
  } else { emit("CHECK PASS q100\n"); }
  s[0]=0; s[1]=0; s[2]=0;
  qr=sub_causal_query(W,s,2,out);
  if(qr!=1 || out[0]!=0 || out[1]!=0 || out[2]!=0){
    emit("CHECK FAIL q000\n"); fails=fails+1;
  } else { emit("CHECK PASS q000\n"); }
  s[0]=0; s[1]=0; s[2]=0;
  qr=sub_causal_query(W,s,1,out);
  if(qr!=1 || out[0]!=1 || out[1]!=0 || out[2]!=0){
    emit("CHECK FAIL qsetx\n"); fails=fails+1;
  } else { emit("CHECK PASS qsetx\n"); }

  // ---- K2e: morpheme facts still correct ----
  let fb:[]u8=z_alloc(16);
  let fl:i32=sub_fact_query(W,"bik","lenclass",fb);
  if(fl!=2 || fb[0]!=76 || fb[1]!=51){
    emit("CHECK FAIL fact-bik-lenclass\n"); fails=fails+1;
  } else { emit("CHECK PASS fact-bik-lenclass\n"); }

  emit("FACTCOUNT ");
  emit(i32s(h_factcount(W)));
  emit(" EPCOUNT ");
  emit(i32s(h_epcount(W)));
  emit(" ENTCOUNT ");
  emit(i32s(h_entcount(W)));
  emit(" CONFLICTS ");
  emit(i32s(h_conflicts(W)));
  emit("\n");
  if(fails==0){
    emit("SUBSTRATE-EXT ALL-PASS\n");
  } else {
    emit("SUBSTRATE-EXT FAILS=");
    emit(i32s(fails));
    emit("\n");
  }
  return fails;
}

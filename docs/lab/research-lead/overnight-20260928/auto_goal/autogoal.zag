// autogoal.zag -- Autonomous Goal Execution prototype (AUTOGOAL).
// Prereg: 3aa462ff2. Single file: sealed world + learner + main.
// Information barrier: wall literals live ONLY inside w_iswall, which is
// called ONLY by w_step. Learner code calls w_step/w_x/w_y/w_bump/w_goal.
// w_true_dist is MEASUREMENT ONLY (PROGRESS logging); learner decision
// code never calls it. Verified by source audit.
// Pure Zag. No Python.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ sealed world ============
// Grid 15x15. Actions: 0=N(y+1) 1=S(y-1) 2=E(x+1) 3=W(x-1) 4=WAIT.
// ws layout: +0 x, +4 y, +8 bump, +12 gx, +16 gy, +20 ncalls.
fn w_iswall(x:i32, y:i32)i32 {
  // SEALED wall literals. Called only by w_step. (Amend1: 15x15 map.)
  if(x==5 && y==0){return 1;}
  if(x==5 && y==1){return 1;}
  if(x==5 && y==2){return 1;}
  if(x==5 && y==3){return 1;}
  if(x==5 && y==4){return 1;}
  if(x==5 && y==6){return 1;}
  if(x==5 && y==7){return 1;}
  if(x==5 && y==8){return 1;}
  if(x==5 && y==9){return 1;}
  if(x==5 && y==10){return 1;}
  if(x==5 && y==11){return 1;}
  if(x==10 && y==3){return 1;}
  if(x==10 && y==4){return 1;}
  if(x==10 && y==5){return 1;}
  if(x==10 && y==6){return 1;}
  if(x==10 && y==7){return 1;}
  if(x==10 && y==9){return 1;}
  if(x==10 && y==10){return 1;}
  if(x==10 && y==11){return 1;}
  if(x==10 && y==12){return 1;}
  return 0;
}
fn w_reset(ws:[]u8, gx:i32, gy:i32)void {
  set32(ws,0,0); set32(ws,4,0); set32(ws,8,0);
  set32(ws,12,gx); set32(ws,16,gy); set32(ws,20,0);
  return;
}
fn w_step(ws:[]u8, a:i32)void {
  set32(ws,20,get32(ws,20)+1);
  let x:i32=get32(ws,0); let y:i32=get32(ws,4);
  if(a==4){ set32(ws,8,0); return; }
  let nx:i32=x; let ny:i32=y;
  if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
  if(nx<0 || nx>=15 || ny<0 || ny>=15 || w_iswall(nx,ny)==1){
    set32(ws,8,1); return;
  }
  set32(ws,0,nx); set32(ws,4,ny); set32(ws,8,0);
  return;
}
fn w_x(ws:[]u8)i32 { return get32(ws,0); }
fn w_y(ws:[]u8)i32 { return get32(ws,4); }
fn w_bump(ws:[]u8)i32 { return get32(ws,8); }
fn w_goal(ws:[]u8)i32 {
  if(get32(ws,0)==get32(ws,12) && get32(ws,4)==get32(ws,16)){return 1;}
  return 0;
}

// ============ BFS planner (generic; operates on learner map) ============
// map: 225 bytes, 0=unknown 1=free 2=wall. passable = in-grid and !=2.
// want: 0=reach (tx,ty); 1=nearest unknown cell (excl start); 2=nearest
// unswept non-wall cell (excl start; swept buffer used).
// Returns path length; path[0..len] = actions; outxy = target coords.
// Returns -1 if no target reachable. Returns 0 if already at target.
fn bfs(sx:i32, sy:i32, tx:i32, ty:i32, want:i32, map:[]u8, swept:[]u8,
       qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8)i32 {
  let sidx:i32=sy*15+sx;
  let i:i32=0;
  while(i<225){ vis[i]=0; par[i]=255; i=i+1; }
  let qh:i32=0; let qt:i32=0;
  set32(qx,0,sx); set32(qy,0,sy); qt=1;
  vis[sidx]=1; par[sidx]=sidx as u8;
  let found:i32=-1;
  while(qh<qt){
    let cx:i32=get32(qx,qh*4); let cy:i32=get32(qy,qh*4); qh=qh+1;
    let cidx:i32=cy*15+cx;
    if(want==0 && cx==tx && cy==ty){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    if(want==1 && cidx!=sidx && (map[cidx] as i32)==0){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    if(want==2 && cidx!=sidx && swept[cidx]==0 && (map[cidx] as i32)!=2){ found=cidx; set32(outxy,0,cx); set32(outxy,4,cy); break; }
    let a:i32=0;
    while(a<4){
      let nx:i32=cx; let ny:i32=cy;
      if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
      if(nx>=0 && nx<15 && ny>=0 && ny<15){
        let nidx:i32=ny*15+nx;
        if((map[nidx] as i32)!=2 && vis[nidx]==0){
          vis[nidx]=1; par[nidx]=cidx as u8; pact[nidx]=a as u8;
          set32(qx,qt*4,nx); set32(qy,qt*4,ny); qt=qt+1;
        }
      }
      a=a+1;
    }
  }
  if(found<0){ return -1; }
  let len:i32=0;
  let cur:i32=found;
  while(cur!=sidx){
    path[len]=pact[cur];
    len=len+1;
    cur=par[cur] as i32;
  }
  let lo:i32=0; let hi:i32=len-1;
  while(lo<hi){
    let t:u8=path[lo]; path[lo]=path[hi]; path[hi]=t;
    lo=lo+1; hi=hi-1;
  }
  return len;
}

// ============ measurement only: true BFS distance ============
// Never called by learner decision code. Only for PROGRESS logging.
fn w_true_dist(ws:[]u8, x:i32, y:i32)i32 {
  let tm:[]u8=z_alloc(225);
  let cy:i32=0;
  while(cy<15){
    let cx:i32=0;
    while(cx<15){
      if(w_iswall(cx,cy)==1){ tm[cy*15+cx]=2; } else { tm[cy*15+cx]=1; }
      cx=cx+1;
    }
    cy=cy+1;
  }
  let qx:[]u8=z_alloc(900); let qy:[]u8=z_alloc(900);
  let vis:[]u8=z_alloc(225); let par:[]u8=z_alloc(225); let pact:[]u8=z_alloc(225);
  let path:[]u8=z_alloc(225); let outxy:[]u8=z_alloc(8); let sw:[]u8=z_alloc(225);
  let gx:i32=get32(ws,12); let gy:i32=get32(ws,16);
  let len:i32=bfs(x,y,gx,gy,0,tm,sw,qx,qy,vis,par,pact,path,outxy);
  return len;
}

// ============ learner: Env A (explore, hypothesize map, plan, fail, revise) ============
// Hypothesis H = map (unknown treated as free = optimistic).
// Experiment = move into nearest unknown cell. Failure = bump.
// Revision = mark wall. Retry = replan.
fn l_env_a(ws:[]u8, map:[]u8, swept:[]u8,
           qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8)i32 {
  let i:i32=0;
  while(i<225){ map[i]=0; i=i+1; }
  map[0]=1;
  let x:i32=0; let y:i32=0;
  let actions:i32=0; let bumps:i32=0; let replans:i32=0;
  let freec:i32=1; let wallc:i32=0;
  let pc:i32=0;
  emit("ENV A BEGIN\n");
  while(actions<5000){
    if(w_goal(ws)==1){
      emit("GOAL_REACHED A actions="); e64(actions);
      emit(" bumps="); e64(bumps);
      emit(" replans="); e64(replans);
      emit(" freec="); e64(freec);
      emit(" wallc="); e64(wallc); emit("\n");
      break;
    }
    // PLAN under H: nearest unknown cell, optimistic (unknown=free).
    let plen:i32=bfs(x,y,0,0,1,map,swept,qx,qy,vis,par,pact,path,outxy);
    if(plen<0){
      emit("FAIL A: fully mapped, goal not found\n");
      break;
    }
    let tx:i32=get32(outxy,0); let ty:i32=get32(outxy,4);
    emit("PLAN A target="); e64(tx); emit(","); e64(ty);
    emit(" plen="); e64(plen); emit("\n");
    // ACT: execute the plan step by step.
    let pi:i32=0;
    while(pi<plen){
      let a:i32=path[pi] as i32;
      w_step(ws,a);
      actions=actions+1;
      x=w_x(ws); y=w_y(ws);
      let b:i32=w_bump(ws); let g:i32=w_goal(ws);
      emit("A "); e64(actions); emit(" a="); e64(a);
      emit(" x="); e64(x); emit(" y="); e64(y);
      emit(" b="); e64(b); emit(" g="); e64(g); emit("\n");
      if(b==1){
        bumps=bumps+1;
        let nx:i32=x; let ny:i32=y;
        if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
        if(nx>=0 && nx<15 && ny>=0 && ny<15){
          if((map[ny*15+nx] as i32)!=2){ map[ny*15+nx]=2; wallc=wallc+1; }
          emit("FAIL A bump at "); e64(nx); emit(","); e64(ny); emit("\n");
          emit("REVISE A wall learned "); e64(nx); emit(","); e64(ny);
          emit(" wallc="); e64(wallc); emit("\n");
        } else {
          emit("FAIL A bump offgrid\n");
        }
        replans=replans+1;
        break;
      }
      let cidx:i32=y*15+x;
      if((map[cidx] as i32)==0){ map[cidx]=1; freec=freec+1; }
      if(g==1){ break; }
      pc=pc+1;
      if(pc>=25){
        pc=0;
        emit("PROGRESS A t="); e64(actions);
        emit(" dist="); e64(w_true_dist(ws,x,y)); emit("\n");
      }
      pi=pi+1;
    }
  }
  return actions;
}

// ============ learner: Env B (transfer; sweep on learned map) ============
// map persists from Env A. Sweep = nearest unswept non-wall cell.
// Unknown cells (never learned in A) are treated optimistically and get
// learned here. Bump handler stays armed (revision machinery).
fn l_env_b(ws:[]u8, map:[]u8, swept:[]u8,
           qx:[]u8, qy:[]u8, vis:[]u8, par:[]u8, pact:[]u8, path:[]u8, outxy:[]u8)i32 {
  let i:i32=0;
  while(i<225){ swept[i]=0; i=i+1; }
  swept[0]=1;
  let x:i32=0; let y:i32=0;
  let actions:i32=0; let bumps:i32=0; let newfree:i32=0; let newwall:i32=0;
  let pc:i32=0;
  emit("ENV B BEGIN\n");
  while(actions<5000){
    if(w_goal(ws)==1){
      emit("GOAL_REACHED B actions="); e64(actions);
      emit(" bumps="); e64(bumps);
      emit(" newfree="); e64(newfree);
      emit(" newwall="); e64(newwall); emit("\n");
      break;
    }
    let plen:i32=bfs(x,y,0,0,2,map,swept,qx,qy,vis,par,pact,path,outxy);
    if(plen<0){
      emit("FAIL B: sweep complete, goal not found\n");
      break;
    }
    if(plen==0){ swept[y*15+x]=1; continue; }
    let tx:i32=get32(outxy,0); let ty:i32=get32(outxy,4);
    emit("PLAN B sweep target="); e64(tx); emit(","); e64(ty);
    emit(" plen="); e64(plen); emit("\n");
    let pi:i32=0;
    while(pi<plen){
      let a:i32=path[pi] as i32;
      w_step(ws,a);
      actions=actions+1;
      x=w_x(ws); y=w_y(ws);
      let b:i32=w_bump(ws); let g:i32=w_goal(ws);
      swept[y*15+x]=1;
      emit("B "); e64(actions); emit(" a="); e64(a);
      emit(" x="); e64(x); emit(" y="); e64(y);
      emit(" b="); e64(b); emit(" g="); e64(g); emit("\n");
      if(b==1){
        bumps=bumps+1;
        let nx:i32=x; let ny:i32=y;
        if(a==0){ny=ny+1;} else if(a==1){ny=ny-1;} else if(a==2){nx=nx+1;} else {nx=nx-1;}
        if(nx>=0 && nx<15 && ny>=0 && ny<15){
          if((map[ny*15+nx] as i32)!=2){ map[ny*15+nx]=2; newwall=newwall+1; }
          emit("FAIL B bump at "); e64(nx); emit(","); e64(ny); emit("\n");
          emit("REVISE B wall learned "); e64(nx); emit(","); e64(ny); emit("\n");
        } else {
          emit("FAIL B bump offgrid\n");
        }
        break;
      }
      let cidx:i32=y*15+x;
      if((map[cidx] as i32)==0){ map[cidx]=1; newfree=newfree+1; }
      if(g==1){ break; }
      pc=pc+1;
      if(pc>=25){
        pc=0;
        emit("PROGRESS B t="); e64(actions);
        emit(" dist="); e64(w_true_dist(ws,x,y)); emit("\n");
      }
      pi=pi+1;
    }
  }
  return actions;
}

// ============ random baseline (control; Env A only) ============
fn l_random(ws:[]u8)i32 {
  let seed:i64=12345;
  let actions:i32=0;
  let pc:i32=0;
  emit("ENV R BEGIN\n");
  while(actions<20000){
    seed=(seed*1103515245+12345)%2147483648;
    let a:i32=(seed%4) as i32;
    w_step(ws,a);
    actions=actions+1;
    pc=pc+1;
    if(pc>=1000){
      pc=0;
      emit("R t="); e64(actions); emit("\n");
    }
    if(w_goal(ws)==1){ break; }
  }
  if(actions>=20000){
    emit("R UNREACHED cap=20000\n");
  } else {
    emit("R GOAL_REACHED actions="); e64(actions); emit("\n");
  }
  return actions;
}

// ============ main ============
fn main()void {
  emit("AUTOGOAL\n");
  let ws:[]u8=z_alloc(24);
  let map:[]u8=z_alloc(225);
  let swept:[]u8=z_alloc(225);
  let qx:[]u8=z_alloc(900); let qy:[]u8=z_alloc(900);
  let vis:[]u8=z_alloc(225); let par:[]u8=z_alloc(225); let pact:[]u8=z_alloc(225);
  let path:[]u8=z_alloc(225); let outxy:[]u8=z_alloc(8);
  w_reset(ws,14,14);
  emit("TRUE_DIST_A0 "); e64(w_true_dist(ws,0,0)); emit("\n");
  let aA:i32=l_env_a(ws,map,swept,qx,qy,vis,par,pact,path,outxy);
  w_reset(ws,14,0);
  emit("TRUE_DIST_B0 "); e64(w_true_dist(ws,0,0)); emit("\n");
  let aB:i32=l_env_b(ws,map,swept,qx,qy,vis,par,pact,path,outxy);
  w_reset(ws,14,14);
  let aR:i32=l_random(ws);
  emit("SUMMARY A="); e64(aA); emit(" B="); e64(aB); emit(" R="); e64(aR); emit("\n");
  emit("DONE\n");
  return;
}

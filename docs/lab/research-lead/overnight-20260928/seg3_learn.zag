// seg3_learn.zag — H-SEG3: segmentation with coverage-discounted scoring.
// Algorithm SEG-LEX-C (frozen in PREREG_SEG3.md):
//   Phase 1: induce chunk lexicon (substrings len 2..5, count>=2).
//            Unchanged from SEG-LEX-P.
//   Phase 1b (new): coverage discounting. score(C) =
//            uncovered(C)*len(C)^2, where uncovered(C) counts only
//            occurrences of C NOT strictly contained in an occurrence
//            of a longer recurring chunk (count>=2). A chunk whose every
//            occurrence is explained by a longer recurring chunk scores
//            ~0 for ANY raw count: the frequency-band dependence of the
//            constant FBPEN repair is removed. No new constant.
//   Phase 2: DP segmentation; single-char fallback scores -FBPEN
//            per character (FBPEN=20, retained residual cost);
//            DP unreachable sentinel -1000000; nopt counts tied optima;
//            AMBIGUOUS if nopt>1.
//   Robustness: move stacks and output buffers sized by input length n
//            (a path has at most n moves); no fixed 64-entry stacks.
// The learner never sees word boundaries; the corpus is raw strings.
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn MAXL()i32 { return 5; }
fn MINC()i32 { return 2; }
fn FBPEN()i32 { return 20; }
fn DPSENT()i32 { return -1000000; }
fn MAXCH()i32 { return 512; }
fn CHSZ()i32 { return 16; } // +0 len(i32), +4 count(i32), +8 bytes[5]

// ---- corpora (raw strings, no boundaries) ----
fn corpus_a(i:i32)[]u8 {
  if(i==0){return "bigredcube";}
  if(i==1){return "biggreenball";}
  if(i==2){return "smallredball";}
  return "smallgreencube";
}
fn test_a()[]u8 { return "smallgreenball"; }
fn test_c()[]u8 { return "smallredcube"; }
fn test_d()[]u8 { return "bigbluecube"; }
fn corpus_b(i:i32)[]u8 {
  if(i==0){return "zab";}
  if(i==1){return "abz";}
  if(i==2){return "zcde";}
  if(i==3){return "cdez";}
  if(i==4){return "zabc";}
  if(i==5){return "abcz";}
  if(i==6){return "zde";}
  return "dez";
}
fn test_b()[]u8 { return "abcde"; }
// ADV-1: 6 strings (SEG2-ADV frozen fixture)
fn corpus_adv1(i:i32)[]u8 {
  if(i==0){return "xabcd";}
  if(i==1){return "xabcd";}
  if(i==2){return "yabcd";}
  if(i==3){return "yabcd";}
  if(i==4){return "zabcd";}
  return "zabcd";
}
// ADV-2: ADV-1 plus "wabcd","wabcd" (8 strings)
fn corpus_adv2(i:i32)[]u8 {
  if(i<6){return corpus_adv1(i);}
  return "wabcd";
}
fn test_adv_t1()[]u8 { return "xabcd"; }
fn test_adv_t2()[]u8 { return "xabcdyabcd"; }
// corpus ids: 0=A, 1=B, 2=ADV-1, 3=ADV-2
fn corpus_nstr(cid:i32)i32 {
  if(cid==0){return 4;}
  if(cid==1){return 8;}
  if(cid==2){return 6;}
  return 8;
}
fn corpus_str(cid:i32, i:i32)[]u8 {
  if(cid==0){return corpus_a(i);}
  if(cid==1){return corpus_b(i);}
  if(cid==2){return corpus_adv1(i);}
  return corpus_adv2(i);
}

// ---- chunk table ----
fn ch_len(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()); }
fn ch_cnt(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()+4); }
fn ch_add_or_inc(cht:[]u8, nch:i32, s:[]u8, off:i32, l:i32)i32 {
  let k:i32=0;
  while(k<nch){
    if(ch_len(cht,k)==l){
      let m:i32=0;
      let eq:i32=1;
      while(m<l){ if(cht[k*CHSZ()+8+m]!=s[off+m]){eq=0;} m=m+1; }
      if(eq==1){
        set32(cht, k*CHSZ()+4, ch_cnt(cht,k)+1);
        return nch;
      }
    }
    k=k+1;
  }
  if(nch<MAXCH()){
    let bo:i32=nch*CHSZ();
    set32(cht, bo, l);
    set32(cht, bo+4, 1);
    let m:i32=0;
    while(m<l){ cht[bo+8+m]=s[off+m]; m=m+1; }
    return nch+1;
  }
  return nch;
}
fn train_seq(cht:[]u8, nch:i32, s:[]u8)i32 {
  let n:i32=s.len;
  let i:i32=0;
  while(i<n){
    let l:i32=2;
    while(l<=MAXL()){
      if(i+l<=n){ nch=ch_add_or_inc(cht,nch,s,i,l); }
      l=l+1;
    }
    i=i+1;
  }
  return nch;
}
fn train_corpus(cht:[]u8, cid:i32)i32 {
  let nch:i32=0;
  let ns:i32=corpus_nstr(cid);
  let i:i32=0;
  while(i<ns){ nch=train_seq(cht,nch,corpus_str(cid,i)); i=i+1; }
  return nch;
}
fn ch_match(cht:[]u8, k:i32, t:[]u8, pos:i32)i32 {
  let l:i32=ch_len(cht,k);
  let m:i32=0;
  while(m<l){ if(cht[k*CHSZ()+8+m]!=t[pos+m]){return 0;} m=m+1; }
  return 1;
}

// ---- Phase 1b: coverage discounting ----
// occ_covered: is the occurrence of chunk k at (s,p) strictly contained
// in an occurrence of a longer recurring chunk?
fn occ_covered(cht:[]u8, nch:i32, s:[]u8, n:i32, k:i32, p:i32)i32 {
  let lk:i32=ch_len(cht,k);
  let j:i32=0;
  while(j<nch){
    let lj:i32=ch_len(cht,j);
    if(lj>lk){
      if(ch_cnt(cht,j)>=MINC()){
        let q0:i32=p+lk-lj;
        if(q0<0){q0=0;}
        let q1:i32=p;
        let qmax:i32=n-lj;
        if(q1>qmax){q1=qmax;}
        let q:i32=q0;
        while(q<=q1){
          if(ch_match(cht,j,s,q)==1){
            if(q+lj>=p+lk){return 1;}
          }
          q=q+1;
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// compute_uncovered: unc[k] = occurrences of chunk k not covered.
fn compute_uncovered(cht:[]u8, nch:i32, cid:i32, unc:[]u8)void {
  let ns:i32=corpus_nstr(cid);
  let k:i32=0;
  while(k<nch){
    let u:i32=0;
    let lk:i32=ch_len(cht,k);
    let si:i32=0;
    while(si<ns){
      let s:[]u8=corpus_str(cid,si);
      let n:i32=s.len;
      let p:i32=0;
      while(p+lk<=n){
        if(ch_match(cht,k,s,p)==1){
          if(occ_covered(cht,nch,s,n,k,p)==0){u=u+1;}
        }
        p=p+1;
      }
      si=si+1;
    }
    set32(unc,k*4,u);
    k=k+1;
  }
  return;
}
// discounted score: uncovered count * len^2
fn ch_uscore(cht:[]u8, unc:[]u8, k:i32)i32 {
  let u:i32=get32(unc,k*4);
  let l:i32=ch_len(cht,k);
  return u*l*l;
}

// ---- DP with move lists ----
fn mv_add(mvc:[]u8, mvj:[]u8, mvl:[]u8, pos:i32, j:i32, l:i32, reset:i32)void {
  if(reset==1){
    set32(mvc,pos*4,1);
    set32(mvj,(pos*8)*4,j);
    set32(mvl,(pos*8)*4,l);
    return;
  }
  let c:i32=get32(mvc,pos*4);
  if(c<8){
    set32(mvj,(pos*8+c)*4,j);
    set32(mvl,(pos*8+c)*4,l);
    set32(mvc,pos*4,c+1);
  }
  return;
}
fn relax(dp:[]u8, nopt:[]u8, mvc:[]u8, mvj:[]u8, mvl:[]u8, n:i32, i:i32, l:i32, s:i32, dpi:i32)void {
  let np:i32=i+l;
  if(np>n){return;}
  let ns:i32=dpi+s;
  let cur:i32=get32(dp,np*4);
  if(ns>cur){
    set32(dp,np*4,ns);
    set32(nopt,np*4,get32(nopt,i*4));
    mv_add(mvc,mvj,mvl,np,i,l,1);
  } else {
    if(ns==cur){
      let v:i32=get32(nopt,np*4)+get32(nopt,i*4);
      if(v>999){v=999;}
      set32(nopt,np*4,v);
      mv_add(mvc,mvj,mvl,np,i,l,0);
    }
  }
  return;
}

// Reconstruct the single best path (first optimal move at each step).
// Stacks sized by n: a path has at most n moves (each advances >= 1).
fn build_best(t:[]u8, n:i32, mvj:[]u8, mvl:[]u8, buf:[]u8)i32 {
  let stj:[]u8=z_alloc((n+1)*4);
  let stl:[]u8=z_alloc((n+1)*4);
  let d:i32=0;
  let i:i32=n;
  while(i>0){
    let j:i32=get32(mvj,(i*8)*4);
    let l:i32=get32(mvl,(i*8)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    d=d+1; i=j;
  }
  let p:i32=0;
  let k:i32=d-1;
  while(k>=0){
    let j:i32=get32(stj,k*4);
    let l:i32=get32(stl,k*4);
    if(p>0){ buf[p]=124 as u8; p=p+1; }
    let m:i32=0;
    while(m<l){ buf[p]=t[j+m]; p=p+1; m=m+1; }
    k=k-1;
  }
  return p;
}

// Enumerate tied optimal segmentations (backward recursion, cap 5).
// rs = result row stride in bytes (sized by n).
fn enum_bwd(t:[]u8, i:i32, mvc:[]u8, mvj:[]u8, mvl:[]u8,
             stj:[]u8, stl:[]u8, d:i32, res:[]u8, nr:i32, rs:i32)i32 {
  if(nr>=5){return nr;}
  if(i==0){
    let base:i32=nr*rs;
    let p:i32=0;
    let k:i32=d-1;
    while(k>=0){
      let j:i32=get32(stj,k*4);
      let l:i32=get32(stl,k*4);
      if(p>0){ res[base+4+p]=124 as u8; p=p+1; }
      let m:i32=0;
      while(m<l){ res[base+4+p]=t[j+m]; p=p+1; m=m+1; }
      k=k-1;
    }
    set32(res,base,p);
    return nr+1;
  }
  let mc:i32=get32(mvc,i*4);
  let m:i32=0;
  while(m<mc){
    let j:i32=get32(mvj,(i*8+m)*4);
    let l:i32=get32(mvl,(i*8+m)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    nr=enum_bwd(t,j,mvc,mvj,mvl,stj,stl,d+1,res,nr,rs);
    if(nr>=5){return nr;}
    m=m+1;
  }
  return nr;
}

fn dump_lexicon(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32)void {
  emit(tag); emit(" NCHUNKS "); emit(i32s(nch)); emit("\n");
  let k:i32=0;
  while(k<nch){
    if(ch_cnt(cht,k)>=MINC()){
      let l:i32=ch_len(cht,k);
      emit(tag); emit(" CHUNK ");
      let tmp:[]u8=z_alloc(8);
      let m:i32=0;
      while(m<l){ tmp[m]=cht[k*CHSZ()+8+m]; m=m+1; }
      emit(tmp[0..l]);
      emit(" len="); emit(i32s(l));
      emit(" count="); emit(i32s(ch_cnt(cht,k)));
      emit(" uncovered="); emit(i32s(get32(unc,k*4)));
      emit(" score="); emit(i32s(ch_uscore(cht,unc,k)));
      emit("\n");
    }
    k=k+1;
  }
  return;
}

fn run_exp(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32, t:[]u8)void {
  let n:i32=t.len;
  let dp:[]u8=z_alloc((n+1)*4);
  let nopt:[]u8=z_alloc((n+1)*4);
  let mvc:[]u8=z_alloc((n+1)*4);
  let mvj:[]u8=z_alloc((n+1)*8*4);
  let mvl:[]u8=z_alloc((n+1)*8*4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,DPSENT()); set32(nopt,i*4,0); set32(mvc,i*4,0); i=i+1; }
  set32(dp,0,0); set32(nopt,0,1);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>DPSENT()){
      relax(dp,nopt,mvc,mvj,mvl,n,i,1,0-FBPEN(),dpi);
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              relax(dp,nopt,mvc,mvj,mvl,n,i,l,ch_uscore(cht,unc,k),dpi);
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  dump_lexicon(tag, cht, unc, nch);
  let bestscore:i32=get32(dp,n*4);
  let no:i32=get32(nopt,n*4);
  emit(tag); emit(" TEST "); emit(t); emit("\n");
  emit(tag); emit(" SCORE "); emit(i32s(bestscore));
  emit(" NOPT "); emit(i32s(no)); emit("\n");
  if(no==1){
    let buf:[]u8=z_alloc(2*n+8);
    let bl:i32=build_best(t,n,mvj,mvl,buf);
    emit(tag); emit(" VERDICT SEGMENTED "); emit(buf[0..bl]); emit("\n");
  } else {
    emit(tag); emit(" VERDICT AMBIGUOUS\n");
    let rs:i32=2*n+16;
    let res:[]u8=z_alloc(5*rs);
    let stj:[]u8=z_alloc((n+1)*4);
    let stl:[]u8=z_alloc((n+1)*4);
    let nr:i32=enum_bwd(t,n,mvc,mvj,mvl,stj,stl,0,res,0,rs);
    emit(tag); emit(" NCAND "); emit(i32s(nr)); emit("\n");
    let r:i32=0;
    while(r<nr){
      let rl:i32=get32(res,r*rs);
      emit(tag); emit(" CAND "); emit(res[r*rs+4..r*rs+4+rl]); emit("\n");
      r=r+1;
    }
  }
  return;
}

fn main()i32 {
  emit("H-SEG3 SEG-LEX-C\n");
  let chta:[]u8=z_alloc(MAXCH()*CHSZ());
  let na:i32=train_corpus(chta,0);
  let unca:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(chta,na,0,unca);
  run_exp("EXP-A", chta, unca, na, test_a());
  run_exp("EXP-C", chta, unca, na, test_c());
  run_exp("EXP-D", chta, unca, na, test_d());
  // ADV-3: 120-char digit string on the corpus-A table (pure fallback).
  let dg:[]u8=z_alloc(121);
  let r:i32=0;
  while(r<12){
    let c:i32=0;
    while(c<10){ dg[r*10+c]=(48+c) as u8; c=c+1; }
    r=r+1;
  }
  run_exp("ADV3", chta, unca, na, dg[0..120]);
  let chtb:[]u8=z_alloc(MAXCH()*CHSZ());
  let nb:i32=train_corpus(chtb,1);
  let uncb:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(chtb,nb,1,uncb);
  run_exp("EXP-B", chtb, uncb, nb, test_b());
  let cht1:[]u8=z_alloc(MAXCH()*CHSZ());
  let n1:i32=train_corpus(cht1,2);
  let unc1:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(cht1,n1,2,unc1);
  run_exp("ADV1-T1", cht1, unc1, n1, test_adv_t1());
  run_exp("ADV1-T2", cht1, unc1, n1, test_adv_t2());
  let cht2:[]u8=z_alloc(MAXCH()*CHSZ());
  let n2:i32=train_corpus(cht2,3);
  let unc2:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(cht2,n2,3,unc2);
  run_exp("ADV2-T2", cht2, unc2, n2, test_adv_t2());
  emit("H-SEG3 COMPLETE\n");
  return 0;
}

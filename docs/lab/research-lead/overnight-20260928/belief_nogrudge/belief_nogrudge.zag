// belief_nogrudge.zag -- Betrayal-history-aware reliability update, noise
// grudge repaired. H-DECEPT-4 plus sealed world D retest. Unfrozen variant.
// Pure Zag. 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// Rule layer is the H-DECEPT-4 rule (belief_antifarm.zag at commit
// 035e9593c) with ONE repaired branch in ev_calibrate: the betrayal
// counter b increments only when the betrayal is material, i.e. when
// base = floor(c*w/(c+w)) > 0 (equivalently p > 0, since 1+b >= 1).
// A zero penalty noise event still costs its linear unit in the total
// but no longer increments b, so a noisy but honest source cannot
// accumulate a betrayal count from events the rule's own severity
// judge priced at zero. Materiality is a property of the existing
// generic penalty formula, not a new domain detector. Everything else
// (traj_penalty, c = 0 branch, streak reset, 100 honest forgiveness,
// rel accounting) is byte identical to the frozen rule.
//
// Output discipline (toolchain lesson 2026-10-02): ONE preallocated
// output buffer, cursor returning emit helpers formatting numbers
// directly into the buffer, a single _zag_raw_syscall(1,1,ptr,len)
// write at the end. No _zag_print anywhere.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }
fn gt(a:i32,b:i32)i32 { if(a>b){return 1;} return 0; }

// ---- single output buffer, cursor returning emit helpers ----
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}

// ============ state block: 1040 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header: 0 nev, 1 nsrc, 2 wmax, 3 first_contrary, 4 revision_seq,
// 5 s1, 6 s2, 7 truth, 8 abl_identity, 9 reserved, 10 nid,
// 11 nevicted, 12 ndup, 13 last_contrib, 14 last_penalty
fn EVB()i32 { return 16; }
fn EVN()i32 { return 64; }
fn EVW()i32 { return 7; }   // qid,hyp,w,src,phase,contrib,eid
fn SRB()i32 { return 464; }
fn SRN()i32 { return 64; }
fn SRW()i32 { return 5; }   // correct,total,streak,betray,extid
fn DCB()i32 { return 784; }
fn DCN()i32 { return 32; }
fn DCW()i32 { return 4; }   // src,hyp,phase,count
fn IDB()i32 { return 912; }
fn IDN()i32 { return 128; }
fn NCELL()i32 { return 1040; }

fn st_init(B:[]u8,abl_identity:i32)void {
  let i:i32=0;
  while(i<NCELL()){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_identity);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+4);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+4)==0){
      cs(B,SRB()+i*SRW()+4,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn src_rel(B:[]u8,si:i32)i32 {
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}
fn src_streak(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+2);
}
fn src_betray(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+3);
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- event identity register: familiarity without recall ----
fn id_seen(B:[]u8,eid:i32)i32 {
  let i:i32=0;
  while(i<cg(B,10)){
    if(cg(B,IDB()+i)==eid){ return 1; }
    i=i+1;
  }
  return 0;
}
fn id_add(B:[]u8,eid:i32)void {
  let n:i32=cg(B,10);
  if(n<IDN()){ cs(B,IDB()+n,eid); cs(B,10,n+1); }
  return;
}

// ---- evidence record with FIFO eviction under memory pressure ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32,eid:i32)i32 {
  let n:i32=cg(B,0);
  let slot:i32=n;
  if(n>=EVN()){
    let i:i32=0;
    while(i<EVN()-1){
      let a:i32=EVB()+i*EVW();
      let c:i32=EVB()+(i+1)*EVW();
      let k:i32=0;
      while(k<EVW()){ cs(B,a+k,cg(B,c+k)); k=k+1; }
      i=i+1;
    }
    slot=EVN()-1;
    cs(B,11,cg(B,11)+1);
  }
  let o:i32=EVB()+slot*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib); cs(B,o+6,eid);
  if(n<EVN()){ cs(B,0,n+1); }
  return slot+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- trajectory base penalty: surprise weight of a wrong outcome ----
// base = floor(c * w / (c + w)); zero on a zero streak, saturates at w.
fn traj_penalty(c:i32,w:i32)i32 {
  if(c<=0){ return 0; }
  if(w<1){ w=1; }
  return c*w/(c+w);
}

// ---- calibration: claim on a verifiable fact; outcome observed ----
// H-DECEPT-4 repair: wrong with c>0 and material base costs
// base*(1+b) and increments the betrayal count; wrong with c>0 but
// zero base (harmless noise) adds its linear unit to the total and
// leaves b untouched. Wrong with c==0 is linear null and leaves b
// untouched.
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r;
  let seq:i32=ev_record(B,0,hyp,w,src,0,contrib,eid);
  note_wmax(B,contrib);
  let c:i32=src_streak(B,si);
  let b:i32=src_betray(B,si);
  if(hyp==truth){
    cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
    cs(B,SRB()+si*SRW()+2,c+1);
    let nc:i32=c+1;
    if(nc-(nc/100)*100==0){
      if(b>0){ cs(B,SRB()+si*SRW()+3,b-1); }
    }
  } else {
    if(c>0){
      let base:i32=traj_penalty(c,w);
      if(base>0){
        let p:i32=base*(1+b);
        cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1+p);
        cs(B,SRB()+si*SRW()+3,b+1);
        cs(B,14,p);
      } else {
        cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
        cs(B,14,0);
      }
    } else {
      cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
      cs(B,14,0);
    }
    cs(B,SRB()+si*SRW()+2,0);
  }
  return seq;
}

// ---- one rebuild/betrayal phase: 20 cheap truths, then one betrayal ----
// Records the penalty in cell 14 so main can cross check repeat vs
// first betrayal penalties (the escalation inequalities).
fn phase(B:[]u8,ob:[]u8,F:[]u8,at:i32,src:i32,bw:i32,eb:i32,exp_rebuild:i32,exp_base:i32,exp_bprior:i32,exp_p:i32,exp_rel:i32,exp_bafter:i32,btag:[]u8,bptag:[]u8,bstag:[]u8,ptag:[]u8,rtag:[]u8,betag:[]u8)i32 {
  let i:i32=0;
  while(i<20){ let r0:i32=ev_calibrate(B,src,1,1,1,eb+i); i=i+1; }
  let si:i32=src_idx(B,src);
  at=e_str(ob,at,"rebuild relS="); at=e_i32(ob,at,src_rel(B,si));
  at=e_str(ob,at," streak="); at=e_i32(ob,at,src_streak(B,si));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(B,si)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(B,si),exp_rebuild),btag);
  at=chk(ob,at,F,eq(src_streak(B,si),20),"K2-rebuild-streak-20");
  let c:i32=src_streak(B,si);
  let b:i32=src_betray(B,si);
  at=chk(ob,at,F,eq(b,exp_bprior),bptag);
  let base:i32=traj_penalty(c,bw);
  at=chk(ob,at,F,eq(base,exp_base),bstag);
  let p:i32=base*(1+b);
  at=e_str(ob,at,"betray w="); at=e_i32(ob,at,bw);
  at=e_str(ob,at," c="); at=e_i32(ob,at,c);
  at=e_str(ob,at," base="); at=e_i32(ob,at,base);
  at=e_str(ob,at," p="); at=e_i32(ob,at,p); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(p,exp_p),ptag);
  let r1:i32=ev_calibrate(B,src,1,bw,2,eb+20);
  at=chk(ob,at,F,eq(cg(B,14),p),"K3-last-penalty-recorded");
  let re:i32=src_rel(B,si);
  at=e_str(ob,at,"exposure relS="); at=e_i32(ob,at,re);
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(B,si)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(re,exp_rel),rtag);
  at=chk(ob,at,F,eq(src_betray(B,si),exp_bafter),betag);
  return at;
}


fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  let F:[]u8=z_alloc(4);

  // ===== World D retest: noisy but honest source, ext 80 =====
  // 40 cycles of [5 correct w=1, 1 wrong w=1], then 20 honest w=1,
  // then one rare high stake error at w=8, then a 200 honest tail.
  // Sealed verdict was KILL: b=40 after the noise (bar 0), test event
  // p=205 (bar 5). The repair must yield b=0 after the noise and a
  // proportional first timer penalty on the test event.
  let N:[]u8=z_alloc(NCELL()*4); st_init(N,0);
  at=e_str(ob,at,"D noisy source retest"); at=e_nl(ob,at);
  let cyc:i32=0;
  while(cyc<40){
    let i:i32=0;
    while(i<5){ let n0:i32=ev_calibrate(N,80,1,1,1,5001+cyc*6+i); i=i+1; }
    let n1:i32=ev_calibrate(N,80,2,1,1,5001+cyc*6+5);
    cyc=cyc+1;
  }
  let ns:i32=src_idx(N,80);
  at=e_str(ob,at,"D after 40 noise cycles rel="); at=e_i32(ob,at,src_rel(N,ns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(N,ns));
  at=e_str(ob,at," streak="); at=e_i32(ob,at,src_streak(N,ns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(N,ns),833),"K3_D_noise_rel_833");
  at=chk(ob,at,F,eq(src_betray(N,ns),0),"K3_D_noise_b_0");
  at=chk(ob,at,F,eq(src_streak(N,ns),0),"K3_D_noise_streak_0");

  let i:i32=0;
  while(i<20){ let n2:i32=ev_calibrate(N,80,1,1,1,5241+i); i=i+1; }
  at=e_str(ob,at,"D after 20 honest rel="); at=e_i32(ob,at,src_rel(N,ns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(N,ns));
  at=e_str(ob,at," streak="); at=e_i32(ob,at,src_streak(N,ns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(N,ns),846),"K3_D_honest_rel_846");
  at=chk(ob,at,F,eq(src_betray(N,ns),0),"K3_D_honest_b_0");
  at=chk(ob,at,F,eq(src_streak(N,ns),20),"K3_D_honest_streak_20");

  let tc:i32=src_streak(N,ns);
  let tb:i32=src_betray(N,ns);
  let tbase:i32=traj_penalty(tc,8);
  let tp:i32=tbase*(1+tb);
  let n3:i32=ev_calibrate(N,80,2,8,1,5261);
  at=e_str(ob,at,"D test event w=8 c="); at=e_i32(ob,at,tc);
  at=e_str(ob,at," base="); at=e_i32(ob,at,tbase);
  at=e_str(ob,at," p="); at=e_i32(ob,at,tp);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(N,ns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(N,ns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(tbase,5),"K3_D_test_base_5");
  at=chk(ob,at,F,eq(tp,5),"K3_D_test_p_5");
  at=chk(ob,at,F,eq(cg(N,14),5),"K3_D_test_recorded_5");
  at=chk(ob,at,F,eq(src_rel(N,ns),827),"K3_D_test_rel_827");
  at=chk(ob,at,F,eq(src_betray(N,ns),1),"K3_D_test_b_1");

  i=0;
  while(i<200){ let n4:i32=ev_calibrate(N,80,1,1,1,5262+i); i=i+1; }
  at=e_str(ob,at,"D after 200 honest tail rel="); at=e_i32(ob,at,src_rel(N,ns));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(N,ns)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(N,ns),901),"K3_D_tail_rel_901");
  at=chk(ob,at,F,eq(src_betray(N,ns),0),"K3_D_tail_b_0");

  // ===== World D4: S repeats betray/rebuild five times =====
  let D:[]u8=z_alloc(NCELL()*4); st_init(D,0);
  at=e_str(ob,at,"D4 S betrayal-history-aware"); at=e_nl(ob,at);

  // Phase A: betrayal 1 at w=3. base=2, b=0, p=2. rel=869.
  at=phase(D,ob,F,at,90,3,7001,1000,2,0,2,869,1,"K2-A-rebuild-1000","K4-A-bprior-0","K4-A-base-2","K3-A-p-2","K3-A-rel-869","K3-A-bafter-1");
  let p1:i32=cg(D,14);
  // Phase B: betrayal 2 at w=5. base=4, b=1, p=8. rel=769.
  at=phase(D,ob,F,at,90,5,7101,930,4,1,8,769,2,"K2-B-rebuild-930","K4-B-bprior-1","K4-B-base-4","K3-B-p-8","K3-B-rel-769","K3-B-bafter-2");
  let p2:i32=cg(D,14);
  // Phase C: betrayal 3 at w=8. base=5, b=2, p=15. rel=681.
  at=phase(D,ob,F,at,90,8,7201,833,5,2,15,681,3,"K2-C-rebuild-833","K4-C-bprior-2","K4-C-base-5","K3-C-p-15","K3-C-rel-681","K3-C-bafter-3");
  let p3:i32=cg(D,14);
  // Phase D: betrayal 4 at w=8. base=5, b=3, p=20. rel=620.
  at=phase(D,ob,F,at,90,8,7301,740,5,3,20,620,4,"K2-D-rebuild-740","K4-D-bprior-3","K4-D-base-5","K3-D-p-20","K3-D-rel-620","K3-D-bafter-4");
  let p4:i32=cg(D,14);
  // Phase E: betrayal 5 at w=8. base=5, b=4, p=25. rel=571.
  at=phase(D,ob,F,at,90,8,7401,671,5,4,25,571,5,"K2-E-rebuild-671","K4-E-bprior-4","K4-E-base-5","K3-E-p-25","K3-E-rel-571","K3-E-bafter-5");
  let p5:i32=cg(D,14);

  at=e_str(ob,at,"D4 exposure rels: 869 769 681 620 571"); at=e_nl(ob,at);
  at=e_str(ob,at,"D4 penalties: 2 8 15 20 25"); at=e_nl(ob,at);
  at=e_str(ob,at,"D4 marginal costs: 3 9 16 21 26"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(p1,2),"K4-marginal-p1-2");
  at=chk(ob,at,F,gt(p2+1,p1+1),"K4-marginal-rising-2");
  at=chk(ob,at,F,gt(p3+1,p2+1),"K4-marginal-rising-3");
  at=chk(ob,at,F,gt(p4+1,p3+1),"K4-marginal-rising-4");
  at=chk(ob,at,F,gt(p5+1,p4+1),"K4-marginal-rising-5");

  // ===== Control Q: fresh source, ONE betrayal at w=5 =====
  let Q:[]u8=z_alloc(NCELL()*4); st_init(Q,0);
  let i:i32=0;
  while(i<20){ let q0:i32=ev_calibrate(Q,91,1,1,1,7501+i); i=i+1; }
  let qs:i32=src_idx(Q,91);
  let pq:i32=traj_penalty(src_streak(Q,qs),5)*(1+src_betray(Q,qs));
  let q1:i32=ev_calibrate(Q,91,1,5,2,7521);
  let rq:i32=src_rel(Q,qs);
  at=e_str(ob,at,"Q single betrayal w=5 p="); at=e_i32(ob,at,pq);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rq); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pq,4),"K5-Q-p-4");
  at=chk(ob,at,F,eq(rq,800),"K5-Q-rel-800");

  // ===== Control V: fresh source, ONE betrayal at w=8 =====
  let V:[]u8=z_alloc(NCELL()*4); st_init(V,0);
  i=0;
  while(i<20){ let v0:i32=ev_calibrate(V,92,1,1,1,7601+i); i=i+1; }
  let vs:i32=src_idx(V,92);
  let pv:i32=traj_penalty(src_streak(V,vs),8)*(1+src_betray(V,vs));
  let v1:i32=ev_calibrate(V,92,1,8,2,7621);
  let rv:i32=src_rel(V,vs);
  at=e_str(ob,at,"V single betrayal w=8 p="); at=e_i32(ob,at,pv);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rv); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pv,5),"K5-V-p-5");
  at=chk(ob,at,F,eq(rv,769),"K5-V-rel-769");

  // ===== escalation inequalities: repeat costs MORE than first =====
  at=e_str(ob,at,"escalation: p(S#2)="); at=e_i32(ob,at,p2);
  at=e_str(ob,at," > p(Q)="); at=e_i32(ob,at,pq);
  at=e_str(ob,at," ; p(S#3)="); at=e_i32(ob,at,p3);
  at=e_str(ob,at," > p(V)="); at=e_i32(ob,at,pv); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(p2,8),"K4-pS2-8");
  at=chk(ob,at,F,eq(p3,15),"K4-pS3-15");
  at=chk(ob,at,F,gt(p2,pq),"K4-escalation-S2-gt-Q");
  at=chk(ob,at,F,gt(p3,pv),"K4-escalation-S3-gt-V");

  // ===== Control (a): W betrays once, then 100 honest rounds =====
  let W:[]u8=z_alloc(NCELL()*4); st_init(W,0);
  i=0;
  while(i<20){ let w0:i32=ev_calibrate(W,93,1,1,1,7701+i); i=i+1; }
  let ws:i32=src_idx(W,93);
  let pw1:i32=traj_penalty(src_streak(W,ws),8)*(1+src_betray(W,ws));
  let w1:i32=ev_calibrate(W,93,1,8,2,7721);
  at=chk(ob,at,F,eq(pw1,5),"K5a-W-first-p-5");
  i=0;
  while(i<100){ let w2:i32=ev_calibrate(W,93,1,1,1,7722+i); i=i+1; }
  at=e_str(ob,at,"W reform: b="); at=e_i32(ob,at,src_betray(W,ws));
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(W,ws)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_betray(W,ws),0),"K5a-W-b-forgiven-0");
  at=chk(ob,at,F,eq(src_rel(W,ws),952),"K5a-W-rel-952");
  let pw2:i32=traj_penalty(src_streak(W,ws),8)*(1+src_betray(W,ws));
  let w3:i32=ev_calibrate(W,93,1,8,2,7822);
  at=e_str(ob,at,"W second betrayal p="); at=e_i32(ob,at,pw2); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pw2,7),"K5a-W-second-p-7");

  // ===== Fresh X: 100-streak, one betrayal at w=8 (reform reference) =====
  let X:[]u8=z_alloc(NCELL()*4); st_init(X,0);
  i=0;
  while(i<100){ let x0:i32=ev_calibrate(X,94,1,1,1,7901+i); i=i+1; }
  let xs:i32=src_idx(X,94);
  let px:i32=traj_penalty(src_streak(X,xs),8)*(1+src_betray(X,xs));
  let x1:i32=ev_calibrate(X,94,1,8,2,8001);
  at=e_str(ob,at,"X fresh-100 betrayal p="); at=e_i32(ob,at,px); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(px,7),"K5a-X-p-7");
  at=chk(ob,at,F,eq(pw2,px),"K5a-reform-equality");

  // ===== Control (b): R1 truth-teller =====
  let R:[]u8=z_alloc(NCELL()*4); st_init(R,0);
  i=0;
  while(i<120){ let r0:i32=ev_calibrate(R,95,1,1,1,8101+i); i=i+1; }
  let rs:i32=src_idx(R,95);
  at=e_str(ob,at,"R1 truth-teller rel="); at=e_i32(ob,at,src_rel(R,rs));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(R,rs)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(R,rs),1000),"K5b-R1-rel-1000");
  at=chk(ob,at,F,eq(src_betray(R,rs),0),"K5b-R1-b-0");

  // ===== Control (c): C0 single no-streak error, then later betrayal =====
  let C:[]u8=z_alloc(NCELL()*4); st_init(C,0);
  let c0:i32=ev_calibrate(C,96,1,1,2,8301);
  let cs0:i32=src_idx(C,96);
  at=e_str(ob,at,"C0 no-streak wrong p="); at=e_i32(ob,at,cg(C,14));
  at=e_str(ob,at," b="); at=e_i32(ob,at,src_betray(C,cs0));
  at=e_str(ob,at," rel="); at=e_i32(ob,at,src_rel(C,cs0)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(cg(C,14),0),"K5c-C0-p0-0");
  at=chk(ob,at,F,eq(src_betray(C,cs0),0),"K5c-C0-b-0");
  at=chk(ob,at,F,eq(src_rel(C,cs0),1000),"K5c-C0-rel-1000");
  i=0;
  while(i<20){ let c1:i32=ev_calibrate(C,96,1,1,1,8302+i); i=i+1; }
  let pc0:i32=traj_penalty(src_streak(C,cs0),8)*(1+src_betray(C,cs0));
  let c2:i32=ev_calibrate(C,96,1,8,2,8322);
  let rc0:i32=src_rel(C,cs0);
  at=e_str(ob,at,"C0 later betrayal p="); at=e_i32(ob,at,pc0);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rc0); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pc0,5),"K5c-C0-betrayal-p-5");
  at=chk(ob,at,F,eq(rc0,740),"K5c-C0-betrayal-rel-740");

  // ===== Patient-farmer probe P (informational): full reform per betrayal =====
  let P:[]u8=z_alloc(NCELL()*4); st_init(P,0);
  i=0;
  while(i<100){ let pa:i32=ev_calibrate(P,97,1,1,1,8401+i); i=i+1; }
  let ps:i32=src_idx(P,97);
  let pp1:i32=traj_penalty(src_streak(P,ps),8)*(1+src_betray(P,ps));
  let pb1:i32=ev_calibrate(P,97,1,8,2,8501);
  i=0;
  while(i<100){ let pc:i32=ev_calibrate(P,97,1,1,1,8502+i); i=i+1; }
  let pp2:i32=traj_penalty(src_streak(P,ps),8)*(1+src_betray(P,ps));
  let pb2:i32=ev_calibrate(P,97,1,8,2,8602);
  let rp:i32=src_rel(P,ps);
  at=e_str(ob,at,"P patient farmer p1="); at=e_i32(ob,at,pp1);
  at=e_str(ob,at," p2="); at=e_i32(ob,at,pp2);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rp); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pp1,7),"KP-P-p1-7");
  at=chk(ob,at,F,eq(pp2,7),"KP-P-p2-7");
  at=chk(ob,at,F,eq(rp,925),"KP-P-rel-925");

  let fails:i32=get32(F,0);
  if(fails==0){ at=e_str(ob,at,"ALL PASS\n"); }
  else { at=e_str(ob,at,"FAILURES: "); at=e_i32(ob,at,fails); at=e_nl(ob,at); }

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){ return 0; }
  return 1;
}

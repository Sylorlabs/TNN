// uc_h1.zag -- faithful H1 arm: majority-singleton signatures (finalize n>=2),
// admit singles/pairs by signature equality, execute, verify. No widening.
// Assembled after uc_base.zag.
fn h1_try_single(A:[]u8,m:i32,s:i32,kin:i32,kout:i32,exp:i32)void {
  let mi:i32=h1_maj_in(A,m);
  let mo:i32=h1_maj_out(A,m);
  if(mi==kin && mo==kout){
    ap(A,936,ag(A,936)+1);
    let v:i32=exec_map(A,m,s);
    if(v==exp){ ap(A,944,v); ap(A,940,1); }
  }
  return;
}
fn h1_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,s:i32,kin:i32,kout:i32,exp:i32)i32 {
  let xi:i32=h1_maj_in(A,x);
  let xo:i32=h1_maj_out(A,x);
  let yi:i32=h1_maj_in(A,y);
  let yo:i32=h1_maj_out(A,y);
  if(xi==kin && xo==yi && yo==kout){
    ap(A,936,ag(A,936)+1);
    let v1:i32=exec_map(A,x,s);
    c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
    if(v1>=0){
      let v2:i32=exec_map(A,y,v1);
      if(v2==exp){ ap(A,944,v2); ap(A,940,1); }
    }
  }
  return c;
}
fn h1_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  let a:i32=0;
  while(a<nm){
    h1_try_single(A,a,s,kin,kout,exp);
    if(ag(A,940)==1){ return c; }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y){
        c=h1_try_pair(A,B,c,x,y,s,kin,kout,exp);
        if(ag(A,940)==1){ return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
fn h1_report(A:[]u8,B:[]u8,c:i32,prob:[]u8)i32 {
  c=o_app(B,c,"ARM=H1 PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64); c=o_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=h1_solve(A1,B,c,61,1,1,65,2);
  c=h1_report(A1,B,c,"P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=h1_solve(A2,B,c,41,1,2,2,4);
  c=h1_report(A2,B,c,"P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=h1_solve(A3,B,c,41,1,2,2,4);
  c=h1_report(A3,B,c,"P2b");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=h1_solve(A4,B,c,31,1,2,2,4);
  c=h1_report(A4,B,c,"P3");
  o_flush(B,c);
  return 0;
}

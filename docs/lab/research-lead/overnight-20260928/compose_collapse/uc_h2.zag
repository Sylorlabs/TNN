// uc_h2.zag -- faithful H2 arm: ordered behavior-class-pair trial execution.
// Classes are researcher-defined (honest boundary, as in canonical H2); the
// working pair is discovered. Class order = ascending first-MAP id; cross
// pairs before same pairs. Stage 1 uses the first MAP of its class.
// Assembled after uc_base.zag.
fn h2_setup(A:[]u8,nm:i32)void {
  let nc:i32=0;
  let m:i32=0;
  while(m<nm){
    let cl:i32=mg(A,m,0);
    let k:i32=0;
    let found:i32=0;
    while(k<nc){
      if(get32(A,948+k*4)==cl){ found=1; }
      k=k+1;
    }
    if(found==0){ set32(A,948+nc*4,cl); nc=nc+1; }
    m=m+1;
  }
  ap(A,964,nc);
  return;
}
fn h2_first_of(A:[]u8,cl:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    if(mg(A,m,0)==cl){ return m; }
    m=m+1;
  }
  return -1;
}
fn h2_try(A:[]u8,B:[]u8,c:i32,c1:i32,c2:i32,s:i32,exp:i32,nm:i32)i32 {
  let m1:i32=h2_first_of(A,c1,nm);
  let m2:i32=h2_first_of(A,c2,nm);
  ap(A,936,ag(A,936)+1);
  let v1:i32=exec_map(A,m1,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  if(v1>=0){
    let v2:i32=exec_map(A,m2,v1);
    if(v2==exp){ ap(A,944,v2); ap(A,940,1); }
  }
  return c;
}
fn h2_solve(A:[]u8,B:[]u8,c:i32,s:i32,exp:i32,nm:i32)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  h2_setup(A,nm);
  let nc:i32=ag(A,964);
  let i:i32=0;
  while(i<nc){
    let j:i32=0;
    while(j<nc){
      if(i!=j){
        c=h2_try(A,B,c,get32(A,948+i*4),get32(A,948+j*4),s,exp,nm);
        if(ag(A,940)==1){ return c; }
      }
      j=j+1;
    }
    i=i+1;
  }
  let k:i32=0;
  while(k<nc){
    c=h2_try(A,B,c,get32(A,948+k*4),get32(A,948+k*4),s,exp,nm);
    if(ag(A,940)==1){ return c; }
    k=k+1;
  }
  return c;
}
fn h2_report(A:[]u8,B:[]u8,c:i32,prob:[]u8)i32 {
  c=o_app(B,c,"ARM=H2 PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64); c=o_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=h2_solve(A1,B,c,61,65,2);
  c=h2_report(A1,B,c,"P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=h2_solve(A2,B,c,41,2,4);
  c=h2_report(A2,B,c,"P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=h2_solve(A3,B,c,41,2,4);
  c=h2_report(A3,B,c,"P2b");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=h2_solve(A4,B,c,31,2,4);
  c=h2_report(A4,B,c,"P3");
  o_flush(B,c);
  return 0;
}

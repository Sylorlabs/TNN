// h3a_driver.zag -- H3 dataflow generality driver: arithmetic to planning.
//
// X = SUM (node -> number): r=71 facts (basket,71,value), query r=91.
//   (101,71,5),(101,71,3),(101,71,7) -> X(101)=15.
//   (102,71,4),(102,71,6) -> X(102)=10.
//   Learned by the base sum trial template as pure unrolled INC chains.
// Y = PLAN (number -> node): r=82 facts (param,82,step), query r=92.
//   (15,82,201),(201,82,202),(202,82,203) -> Y(15)=203.
//   (10,82,211),(211,82,212),(212,82,213) -> Y(10)=213.
//   Learned as guard/set chain MAPs.
// Z = plan(sum(s)): query (103,93) -> 203. Z facts: (103,71,6),(103,71,9);
//   sum(103)=15; the plan 15->201->202->203 was taught in Y1.
// Z2 reuse: (104,71,4),(104,71,6); sum(104)=10; query (104,93) -> 213.
// Arms: TREAT, ABL-X, ABL-Y, FRESH. (NO-DF is a separate binary.)
//
// The H3 mechanism (df_patch.zag) is used VERBATIM. Only this driver is new.

fn h3a_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn h3a_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// Set field12 (fact_rel) on all MAPs with given in_rel.
// Simulates the learner recording which fact relation each procedure consumes.
fn h3a_set_factrel(W:[]u8,in_rel:i32,fact_rel:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==in_rel){
      ns(W,m,12,fact_rel);
    }
    m=m+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn h3a_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn h3a_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// 1 if the MAP's executable graph contains an INC cell (tag 103).
fn h3a_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// MAP census for diagnosis: id, in_rel, subject, answer, plen, class.
fn h3a_census(W:[]u8)void {
  emit("maps="); e64(h3a_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let p:i32=rb_chain_plen(W,ng(W,m,20));
      emit("MAP id="); e64(m);
      emit(" r="); e64(ng(W,m,4));
      emit(" s="); e64(ng(W,m,8));
      emit(" ans="); e64(ng(W,m,28));
      emit(" plen="); e64(p);
      emit(" factrel="); e64(ng(W,m,12));
      emit(" class=");
      if(p>=2){emit("chain");}
      else {
        if(h3a_has_inc(W,ng(W,m,20))==1){emit("arith");}
        else {emit("other");}
      }
      emit("\n");
    }
    m=m+1;
  }
  return;
}
// Driver scaffold (precedent: xio_general/xg_driver.zag, C269 ap_driver):
// the base's sum trial branch is gated on a combination-context node
// (tag 8), which the base only creates in its own test battery. The
// driver creates one per arm so the sum template is attemptable; it
// teaches no facts and no answers.
fn h3a_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn h3a_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn h3a_trainX(W:[]u8)void {
  ev_teach(W,101,71,5); ev_teach(W,101,71,3); ev_teach(W,101,71,7);
  let x1:i32=ev_query(W,101,91,15,0);
  emit("X1 ans="); e64(x1); h3a_tstat(W);
  ev_teach(W,102,71,4); ev_teach(W,102,71,6);
  let x2:i32=ev_query(W,102,91,10,0);
  emit("X2 ans="); e64(x2); h3a_tstat(W);
  h3a_set_factrel(W,91,71);
  return;
}
fn h3a_trainY(W:[]u8)void {
  ev_teach(W,15,82,201); ev_teach(W,201,82,202); ev_teach(W,202,82,203);
  let y1:i32=ev_query(W,15,92,203,0);
  emit("Y1 ans="); e64(y1); h3a_tstat(W);
  ev_teach(W,10,82,211); ev_teach(W,211,82,212); ev_teach(W,212,82,213);
  let y2:i32=ev_query(W,10,92,213,0);
  emit("Y2 ans="); e64(y2); h3a_tstat(W);
  h3a_set_factrel(W,92,82);
  return;
}
fn h3a_zfacts(W:[]u8)void {
  ev_teach(W,103,71,6); ev_teach(W,103,71,9);
  return;
}
fn h3a_zquery(W:[]u8)void {
  let z:i32=ev_query(W,103,93,203,0);
  emit("Z ans="); e64(z); h3a_tstat(W);
  let zm:i32=h3a_find_map(W,103,93);
  emit("ZMAP id="); e64(zm); emit("\n");
  return;
}
// Z2 reuse: new sum facts, same dataflow wiring should apply via DF-REUSE.
fn h3a_zprime(W:[]u8)void {
  emit("=== Z2-REUSE ===\n");
  ev_teach(W,104,71,4); ev_teach(W,104,71,6);
  let z2:i32=ev_query(W,104,93,213,0);
  emit("Z2 ans="); e64(z2); h3a_tstat(W);
  return;
}
fn h3a_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  h3a_comb(W);
  h3a_trainX(W);
  h3a_trainY(W);
  h3a_gap(W);
  h3a_census(W);
  h3a_zfacts(W);
  h3a_zquery(W);
  h3a_zprime(W);
  return;
}
fn h3a_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  h3a_comb(W);
  h3a_trainX(W);
  h3a_trainY(W);
  h3a_del_map_r(W,91);
  emit("maps after del="); e64(h3a_count_maps(W)); emit("\n");
  h3a_gap(W);
  h3a_zfacts(W);
  h3a_zquery(W);
  return;
}
fn h3a_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  h3a_comb(W);
  h3a_trainX(W);
  h3a_trainY(W);
  h3a_del_map_r(W,92);
  emit("maps after del="); e64(h3a_count_maps(W)); emit("\n");
  h3a_gap(W);
  h3a_zfacts(W);
  h3a_zquery(W);
  return;
}
fn h3a_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  h3a_comb(W);
  h3a_gap(W);
  h3a_zfacts(W);
  h3a_zquery(W);
  return;
}
fn main()i32 {
  emit("H3A-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); h3a_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); h3a_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); h3a_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); h3a_fresh(W4);
  emit("H3A-END\n");
  return 0;
}

// sl2l_driver.zag -- Strong L2L 4-arm driver.
// Tests whether learned evidence caution (threshold T) transfers from
// Family A (noisy estimation) to Family B (bursty estimation, different
// temporal structure). Pure Zag. No Python.

// Family A noisy values: 45,45,45,46,45,45,47,45,45,45,48,45,45,45,45,45 (16)
fn aval_noisy(i:i32)i32 {
  if(i<3){return 45;}
  if(i<4){return 46;}
  if(i<6){return 45;}
  if(i<7){return 47;}
  if(i<10){return 45;}
  if(i<11){return 48;}
  return 45;
}

// Family A stable values: 45 x10
fn aval_stable(i:i32)i32 {
  return 45;
}

// Family B bursty values (30):
// 100x3, 105x3, 100x6, 106x3, 100x6, 107x3, 100x6
fn bval(i:i32)i32 {
  if(i<3){return 100;}
  if(i<6){return 105;}
  if(i<12){return 100;}
  if(i<15){return 106;}
  if(i<21){return 100;}
  if(i<24){return 107;}
  return 100;
}

// Log: index, current default, T, E, writes.
fn sl_log(W:[]u8, i:i32)void {
  print_str(" i="); print_i32(i);
  print_str(" def="); print_i32(at_get_default(W));
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==3){
      print_str(" T="); print_i32(ng(W,n,20));
      print_str(" E="); print_i32(ng(W,n,16));
      print_str(" wr="); print_i32(ng(W,n,24));
      print_str("\n");
      return;
    }
    n=n+1;
  }
  print_str(" evnode=MISSING\n");
  return;
}

// Ablation: reset evidence state to initial (E=3, T=3). Keeps policy default.
fn sl_reset_ev(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==3){
      ns(W,n,16,3); ns(W,n,20,3);
      ns(W,n,8,-1); ns(W,n,12,0);
      return;
    }
    n=n+1;
  }
  return;
}

fn arm_noisy()void {
  print_str("ARM=NOISY-A\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=1000; let i:i32=0;
  while(i<16){ at_reveal(W,s,1,aval_noisy(i)); print_str("A"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-A\n");
  i=0;
  while(i<30){ at_reveal(W,s,1,bval(i)); print_str("B"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-B\n");
  return;
}

fn arm_stable()void {
  print_str("ARM=STABLE-A\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=2000; let i:i32=0;
  while(i<10){ at_reveal(W,s,1,aval_stable(i)); print_str("A"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-A\n");
  i=0;
  while(i<30){ at_reveal(W,s,1,bval(i)); print_str("B"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-B\n");
  return;
}

fn arm_fresh()void {
  print_str("ARM=FRESH\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=3000; let i:i32=0;
  while(i<30){ at_reveal(W,s,1,bval(i)); print_str("B"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-B\n");
  return;
}

fn arm_ablated()void {
  print_str("ARM=ABLATED\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=4000; let i:i32=0;
  while(i<16){ at_reveal(W,s,1,aval_noisy(i)); print_str("A"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-A\n");
  sl_reset_ev(W);
  print_str("EV-RESET\n");
  i=0;
  while(i<30){ at_reveal(W,s,1,bval(i)); print_str("B"); sl_log(W,i); s=s+1; i=i+1; }
  print_str("END-B\n");
  return;
}

fn main()i32 {
  arm_noisy();
  arm_stable();
  arm_fresh();
  arm_ablated();
  print_str("DONE\n");
  return 0;
}

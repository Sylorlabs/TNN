// at_tests.zag -- adaptive threshold experiment environments.
// Shared by the ADAPTIVE and FIXED arms. Each driver defines report_ev(W).
// Pure Zag. No Python.

// ---- helpers ----
fn at_get_default(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==2){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn at_reveal(W:[]u8,s:i32,r:i32,aw:i32)void {
  ev_query(W,s,r,0,0);
  ev_observe_aw(W,s,r,1000+s,aw);
  return;
}

// ---- adaptive machinery (used only when the core splices the call) ----
// Evidence node: tag 40, subtype 3. Learner-owned evidence state.
// 8=V run value, 12=R run length, 16=E error score, 20=T threshold,
// 24=writes, 28=mismatches, 32=maxT.
fn at_ev_get(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==3){return n;}
    n=n+1;
  }
  let p:i32=alloc_node(W); if(p<0){return -1;}
  ns(W,p,0,40); ns(W,p,4,3);
  ns(W,p,8,-1);
  ns(W,p,12,0);
  ns(W,p,16,3);
  ns(W,p,20,3);
  ns(W,p,24,0);
  ns(W,p,28,0);
  ns(W,p,32,3);
  return p;
}

// Adaptive resolve. Preamble (uncertainty lookup, supersede, resolution
// count) is identical to resolve_uncertainty_v2: Links 1, 3, 4 of the
// causal chain are untouched. Only the record-to-write condition changes:
// the required run length T is a learner-state value driven by experienced
// consistency (E decays on match, jumps on mismatch).
fn resolve_uncertainty_adaptive(W:[]u8,s:i32,r:i32,a_w:i32)void {
  let pol:i32=n2v2_pol_get(W); if(pol<0){return;}
  let ev:i32=at_ev_get(W); if(ev<0){return;}
  let u:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){u=n; break;}
    }
    n=n+1;
  }
  if(u<0){return;}
  link_edge(W,u,3,u,0);
  let g:i32=-1; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==u){
      g=eg(W,e,0); break;
    }
    e=e+1;
  }
  if(g>=2){
    link_edge(W,g,3,g,0);
  }
  ns(W,pol,28,ng(W,pol,28)+1);
  if(a_w>=0){
    let V:i32=ng(W,ev,8);
    let R:i32=ng(W,ev,12);
    let E:i32=ng(W,ev,16);
    let mm:i32=ng(W,ev,28);
    if(V<0){
      V=a_w; R=1;
    } else {
      if(a_w==V){
        R=R+1;
        E=E-1; if(E<0){E=0;}
      } else {
        E=E+3; mm=mm+1;
        V=a_w; R=1;
      }
    }
    let T:i32=2+E/3;
    if(T<2){T=2;}
    if(T>5){T=5;}
    let mx:i32=ng(W,ev,32);
    if(T>mx){mx=T;}
    ns(W,ev,8,V); ns(W,ev,12,R); ns(W,ev,16,E); ns(W,ev,20,T);
    ns(W,ev,28,mm); ns(W,ev,32,mx);
    let def:i32=ng(W,pol,20);
    if(R>=T && V>=0 && V!=def){
      ns(W,pol,20,V);
      ns(W,ev,24,ng(W,ev,24)+1);
      ns(W,ev,8,-1); ns(W,ev,12,0);
    }
  }
  return;
}

// guide action reader: finds the miss-constructed guide for subject s.
fn at_guide_action(W:[]u8,s:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==s){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}


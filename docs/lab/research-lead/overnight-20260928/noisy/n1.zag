fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v; if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x; while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; } return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn NB()i32 { return 6; }
fn ROWS()i32 { return 64; }
fn bit(x:i32,k:i32)i32 {
  let d:i32=1; let i:i32=0;
  while(i<k){ d=d*2; i=i+1; }
  let y:i32=x/d; return y-(y/2)*2;
}
fn xorp(a:i32,b:i32)i32 { return a+b-(a*b*2); }
fn andp(a:i32,b:i32)i32 { return a*b; }
fn orp(a:i32,b:i32)i32 { return a+b-(a*b); }
fn pair_eval(x:i32,i:i32,j:i32)i32 { return xorp(bit(x,i),bit(x,j)); }

// ---- F1: parities. id 0..14 PAIR(i,j), 15..34 TERN(i,j,k) ----
fn f1_n()i32 { return 35; }
fn f1_cls(id:i32)i32 { if(id<15){ return 0; } return 1; }
fn f1_eval(x:i32,id:i32)i32 {
  if(id<15){
    let c:i32=0; let i:i32=0;
    while(i<NB()){ let j:i32=i+1; while(j<NB()){
      if(c==id){ return pair_eval(x,i,j); }
      c=c+1; j=j+1; } i=i+1; }
    return 0;
  }
  let n:i32=id-15;
  let i:i32=0;
  while(i<NB()){
    let j:i32=i+1;
    while(j<NB()){
      let k:i32=j+1;
      while(k<NB()){
        if(n==0){ return xorp(pair_eval(x,i,j),bit(x,k)); }
        n=n-1; k=k+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  return 0;
}
fn f1_pair_index(i:i32,j:i32)i32 {
  let c:i32=0; let a:i32=0;
  while(a<NB()){ let b:i32=a+1; while(b<NB()){
    if(a==i){ if(b==j){ return c; } }
    c=c+1; b=b+1; } a=a+1; }
  return 0-1;
}

// ---- F2: 6 gates x 15 pairs. id = gate*15 + pairidx ----
fn NG()i32 { return 6; }
fn f2_n()i32 { return 90; }
fn gate_eval(a:i32,b:i32,g:i32)i32 {
  if(g==0){ return andp(a,b); }
  if(g==1){ return orp(a,b); }
  if(g==2){ return xorp(a,b); }
  if(g==3){ return 1-andp(a,b); }
  if(g==4){ return 1-orp(a,b); }
  return 1-xorp(a,b);
}
fn f2_eval(x:i32,id:i32)i32 {
  let g:i32=id/15;
  let n:i32=id-(id/15)*15;
  let i:i32=0;
  while(i<NB()){ let j:i32=i+1; while(j<NB()){
    if(n==0){ return gate_eval(bit(x,i),bit(x,j),g); }
    n=n-1; j=j+1; } i=i+1; }
  return 0;
}

// ---- labels ----
fn clean_label(x:i32,ti:i32,tj:i32)i32 { return pair_eval(x,ti,tj); }
fn pm(s:[]u8)i32 {
  let x:i32=get32(s,0);
  x=x*16807;
  x=x-(x/2147483647)*2147483647;
  if(x<1){ x=x+2147483646; }
  set32(s,0,x);
  return x;
}
// build noisy labels; returns realized corruption count
fn build_labels(out:[]u8,ti:i32,tj:i32,seed:i32,epermille:i32)[]u8 {
  let s:[]u8=z_alloc(4);
  set32(s,0,seed);
  let cnt:[]u8=z_alloc(4);
  set32(cnt,0,0);
  let x:i32=0;
  while(x<ROWS()){
    let v:i32=clean_label(x,ti,tj);
    if(epermille>0){
      let z:i32=pm(s);
      let u:i32=z-(z/1000)*1000;
      if(u<epermille){ v=1-v; set32(cnt,0,get32(cnt,0)+1); }
    }
    set32(out,x*4,v);
    x=x+1;
  }
  return cnt;
}
fn scoreF1(id:i32,lab:[]u8)i32 {
  let s:i32=0; let x:i32=0;
  while(x<ROWS()){ if(f1_eval(x,id)==get32(lab,x*4)){ s=s+1; } x=x+1; }
  return s;
}
fn scoreF2(id:i32,lab:[]u8)i32 {
  let s:i32=0; let x:i32=0;
  while(x<ROWS()){ if(f2_eval(x,id)==get32(lab,x*4)){ s=s+1; } x=x+1; }
  return s;
}

// trials given an ordering of F2 ids
fn trialsF2(order:[]u8,no:i32,truth:i32,lim:i32)i32 {
  let t:i32=0; let k:i32=0;
  while(k<no){
    if(t>=lim){ return 0-1; }
    if(get32(order,k*4)==truth){ return t+1; }
    t=t+1; k=k+1;
  }
  return 0-1;
}
fn trialsF2_random(truth:i32,seed:i32,runs:i32,lim:i32)[]u8 {
  let s:[]u8=z_alloc(4);
  set32(s,0,seed);
  let n:i32=f2_n();
  let sum:i32=0; let capped:i32=0; let r:i32=0;
  while(r<runs){
    let t:i32=0; let hit:i32=0;
    while(hit==0){
      if(t>=lim){ capped=capped+1; hit=1; t=lim; }
      if(hit==0){
        t=t+1;
        let z:i32=pm(s);
        let idx:i32=z-(z/n)*n;
        if(idx==truth){ hit=1; }
      }
    }
    sum=sum+t; r=r+1;
  }
  let o:[]u8=z_alloc(8);
  set32(o,0,sum/runs);
  set32(o,4,capped);
  return o;
}

fn main()i32 {
  let ob:[]u8=z_alloc(32768);
  let c:i32=0;
  c=o_app(ob,c,"NOISY C1512-C1530"); c=o_nl(ob,c);
  let AI:i32=0; let AJ:i32=2;
  let BI:i32=1; let BJ:i32=4;
  let truthF1:i32=f1_pair_index(BI,BJ);
  let truthF2:i32=2*15+f1_pair_index(BI,BJ);
  c=o_app(ob,c,"F1 n="); c=o_i64(ob,c,f1_n() as i64);
  c=o_app(ob,c," (15 PAIR + 20 TERN)");
  c=o_app(ob,c,"  F2 n="); c=o_i64(ob,c,f2_n() as i64);
  c=o_app(ob,c," (6 gates x 15 pairs)"); c=o_nl(ob,c);
  c=o_app(ob,c,"phaseA target=0,2  phaseB target=1,4"); c=o_nl(ob,c);
  c=o_app(ob,c,"truth F1 id="); c=o_i64(ob,c,truthF1 as i64);
  c=o_app(ob,c,"  truth F2 id="); c=o_i64(ob,c,truthF2 as i64); c=o_nl(ob,c);

  // ---------- M1..M3 : F1 phase A at three noise levels ----------
  let lev:[]u8=z_alloc(12);
  set32(lev,0,0); set32(lev,4,150); set32(lev,8,350);
  let li:i32=0;
  while(li<3){
    let ep:i32=get32(lev,li*4);
    let lab:[]u8=z_alloc(4*ROWS());
    let cnt:[]u8=build_labels(lab,AI,AJ,1000+li*77,ep);
    let realized:i32=get32(cnt,0);
    let tS:i32=scoreF1(f1_pair_index(AI,AJ),lab);
    let mn:i32=9999; let mx:i32=0-1;
    let id:i32=0;
    while(id<f1_n()){
      if(id!=f1_pair_index(AI,AJ)){
        let v:i32=scoreF1(id,lab);
        if(v<mn){ mn=v; }
        if(v>mx){ mx=v; }
      }
      id=id+1;
    }
    let spread:i32=mx-mn;
    c=o_app(ob,c,"M F1 phaseA e_nom="); c=o_i64(ob,c,ep as i64);
    c=o_app(ob,c," realized_corrupt="); c=o_i64(ob,c,realized as i64);
    c=o_app(ob,c," true_score="); c=o_i64(ob,c,tS as i64);
    c=o_app(ob,c," wrong_min="); c=o_i64(ob,c,mn as i64);
    c=o_app(ob,c," wrong_max="); c=o_i64(ob,c,mx as i64);
    c=o_app(ob,c," wrong_spread="); c=o_i64(ob,c,spread as i64); c=o_nl(ob,c);
    li=li+1;
  }

  // ---------- M4..M5 : F2 phase B, clean and noisy ----------
  let f2ep:[]u8=z_alloc(8);
  set32(f2ep,0,0); set32(f2ep,4,150);
  let fi:i32=0;
  while(fi<2){
    let ep:i32=get32(f2ep,fi*4);
    let lab:[]u8=z_alloc(4*ROWS());
    let cnt:[]u8=build_labels(lab,BI,BJ,2000+fi*91,ep);
    let realized:i32=get32(cnt,0);
    let tS:i32=scoreF2(truthF2,lab);
    let mn:i32=9999; let mx:i32=0-1;
    let id:i32=0;
    while(id<f2_n()){
      if(id!=truthF2){
        let v:i32=scoreF2(id,lab);
        if(v<mn){ mn=v; }
        if(v>mx){ mx=v; }
      }
      id=id+1;
    }
    c=o_app(ob,c,"M F2 phaseB e_nom="); c=o_i64(ob,c,ep as i64);
    c=o_app(ob,c," realized_corrupt="); c=o_i64(ob,c,realized as i64);
    c=o_app(ob,c," true_score="); c=o_i64(ob,c,tS as i64);
    c=o_app(ob,c," wrong_min="); c=o_i64(ob,c,mn as i64);
    c=o_app(ob,c," wrong_max="); c=o_i64(ob,c,mx as i64);
    c=o_app(ob,c," wrong_spread="); c=o_i64(ob,c,mx-mn as i64); c=o_nl(ob,c);
    fi=fi+1;
  }

  // ---------- M6..M9 : orders on F2 phase B (noisy e=150, as trained) ----
  let lab:[]u8=z_alloc(4*ROWS());
  let cnt:[]u8=build_labels(lab,BI,BJ,2000+91,150);
  let sc:[]u8=z_alloc(4*f2_n());
  let id:i32=0;
  while(id<f2_n()){ set32(sc,id*4,scoreF2(id,lab)); id=id+1; }
  // DESC_SCORE
  let desc:[]u8=z_alloc(4*f2_n());
  let pos:i32=0;
  let s:i32=ROWS();
  while(s>=0){
    id=0;
    while(id<f2_n()){ if(get32(sc,id*4)==s){ set32(desc,pos*4,id); pos=pos+1; } id=id+1; }
    s=s-1;
  }
  let tDesc:i32=trialsF2(desc,pos,truthF2,400);
  // ENUM gate-major
  let en:[]u8=z_alloc(4*f2_n());
  id=0;
  while(id<f2_n()){ set32(en,id*4,id); id=id+1; }
  let tEnum:i32=trialsF2(en,f2_n(),truthF2,400);
  let rnd:[]u8=trialsF2_random(truthF2,31337,200,400);
  // M7 argmax identity
  let argmax:i32=0-1; let best:i32=0-1;
  id=0;
  while(id<f2_n()){ if(get32(sc,id*4)>best){ best=get32(sc,id*4); argmax=id; } id=id+1; }
  let argmaxIsTarget:i32=0;
  if(argmax==truthF2){ argmaxIsTarget=1; }
  c=o_app(ob,c,"M6 F2 phaseB DESC_SCORE="); c=o_i64(ob,c,tDesc as i64);
  c=o_app(ob,c," ENUM="); c=o_i64(ob,c,tEnum as i64);
  c=o_app(ob,c," RANDOM="); c=o_i64(ob,c,get32(rnd,0) as i64);
  c=o_app(ob,c," capped="); c=o_i64(ob,c,get32(rnd,4) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"M7 argmax_id="); c=o_i64(ob,c,argmax as i64);
  c=o_app(ob,c," argmax_score="); c=o_i64(ob,c,best as i64);
  c=o_app(ob,c," ARGMAX_IS_TARGET="); c=o_i64(ob,c,argmaxIsTarget as i64); c=o_nl(ob,c);
  // M8 argmax-first only (1 trial) is the whole DESC advantage when flag=1
  c=o_app(ob,c,"M8 argmax_first_trials=");
  if(argmaxIsTarget==1){ c=o_i64(ob,c,1); } else { c=o_i64(ob,c,tDesc as i64); }
  c=o_nl(ob,c);
  // M9 FO: rebuild DESC from labels only, no log, no class tags
  let fo:[]u8=z_alloc(4*f2_n());
  let fp:i32=0;
  s=ROWS();
  while(s>=0){
    id=0;
    while(id<f2_n()){
      let v:i32=0; let x:i32=0;
      while(x<ROWS()){ if(f2_eval(x,id)==get32(lab,x*4)){ v=v+1; } x=x+1; }
      if(v==s){ set32(fo,fp*4,id); fp=fp+1; }
      id=id+1;
    }
    s=s-1;
  }
  let tFO:i32=trialsF2(fo,fp,truthF2,400);
  c=o_app(ob,c,"M9 FO_trials="); c=o_i64(ob,c,tFO as i64); c=o_nl(ob,c);
  // M10 does the F1-learned class rule even apply to F2?
  c=o_app(ob,c,"M10 F1_learned_rule_is_class_filter; F2 has single uniform class -> applies=0"); c=o_nl(ob,c);

  // ---------- M11 : is the within-wrong gradient signal or sampling variance? ----------
  // Build an order from ONE noise realization, apply it to a FRESH realization.
  let lab1:[]u8=z_alloc(4*ROWS());
  build_labels(lab1,BI,BJ,555,150);
  let ord1:[]u8=z_alloc(4*f2_n());
  let op:i32=0;
  s=ROWS();
  while(s>=0){
    id=0;
    while(id<f2_n()){
      let v:i32=0; let x:i32=0;
      while(x<ROWS()){ if(f2_eval(x,id)==get32(lab1,x*4)){ v=v+1; } x=x+1; }
      if(v==s){ set32(ord1,op*4,id); op=op+1; }
      id=id+1;
    }
    s=s-1;
  }
  let lab2:[]u8=z_alloc(4*ROWS());
  let cnt2:[]u8=build_labels(lab2,BI,BJ,666,150);
  let tCross:i32=trialsF2(ord1,op,truthF2,400);
  let tDesc2:i32=0;
  s=ROWS();
  while(s>=0){
    id=0;
    while(id<f2_n()){
      let v:i32=0; let x:i32=0;
      while(x<ROWS()){ if(f2_eval(x,id)==get32(lab2,x*4)){ v=v+1; } x=x+1; }
      if(v==s){ if(id==truthF2){ tDesc2=tDesc2+1; } }
      id=id+1;
    }
    s=s-1;
  }
  c=o_app(ob,c,"M11 cross_realization: order_from_draw_555_trials_on_draw_666=");
  c=o_i64(ob,c,tCross as i64);
  c=o_app(ob,c,"  own_draw_trials="); c=o_i64(ob,c,tDesc2 as i64); c=o_nl(ob,c);

  // ---------- M12 : reverse the gradient. Labels inverted. ----------
  // NOTE: inverting labels makes the truth and its complement (XNOR of the
  // same pair) score IDENTICALLY. So "truth rank" is a tie-break artifact
  // and must NOT be reported as immunity. Report the tie explicitly.
  let inv:[]u8=z_alloc(4*ROWS());
  let x2:i32=0;
  while(x2<ROWS()){ set32(inv,x2*4,1-get32(lab,x2*4)); x2=x2+1; }
  let invTruth:i32=0;
  id=0;
  while(id<f2_n()){ if(id==truthF2){ let x:i32=0; while(x<ROWS()){ if(f2_eval(x,id)==get32(inv,x*4)){ invTruth=invTruth+1; } x=x+1; } } id=id+1; }
  let invBest:i32=0-1;
  let invCntBest:i32=0;
  let invBestIsTruthAlone:i32=1;
  id=0;
  while(id<f2_n()){
    let v:i32=0; let x:i32=0;
    while(x<ROWS()){ if(f2_eval(x,id)==get32(inv,x*4)){ v=v+1; } x=x+1; }
    if(v>invBest){ invBest=v; invCntBest=1; if(id!=truthF2){ invBestIsTruthAlone=0; } }
    if(v==invBest){ if(id==truthF2){ } else { invCntBest=invCntBest+1; } }
    id=id+1;
  }
  if(invCntBest>1){ invBestIsTruthAlone=0; }
  c=o_app(ob,c,"M12 gradient_reversed: truth_score="); c=o_i64(ob,c,invTruth as i64);
  c=o_app(ob,c," top_score="); c=o_i64(ob,c,invBest as i64);
  c=o_app(ob,c," n_at_top="); c=o_i64(ob,c,invCntBest as i64);
  c=o_app(ob,c," truth_unique_at_top="); c=o_i64(ob,c,invBestIsTruthAlone as i64);
  c=o_app(ob,c," (0 => tie with complement, reversal is degenerate)"); c=o_nl(ob,c);

  // ---------- bars ----------
  let foMatched:i32=0;
  if(tFO<=tDesc){ foMatched=1; }
  let beyondArgmax:i32=0;
  if(argmaxIsTarget==0){ beyondArgmax=1; }
  let promotion:i32=0;
  if(beyondArgmax==1){ if(foMatched==0){ promotion=1; } }
  c=o_app(ob,c,"BAR B2_realized_noise_printed="); c=o_i64(ob,c,1 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B6_random_closed_form="); c=o_i64(ob,c,f2_n() as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B7_argmax_is_target="); c=o_i64(ob,c,argmaxIsTarget as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B8_fo="); c=o_i64(ob,c,tFO as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B9_beyond_argmax="); c=o_i64(ob,c,beyondArgmax as i64);
  c=o_app(ob,c," fo_matched="); c=o_i64(ob,c,foMatched as i64);
  c=o_app(ob,c," PROMOTION="); c=o_i64(ob,c,promotion as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B10_L3="); c=o_i64(ob,c,0 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B11_verdict=");
  if(promotion==1){ c=o_app(ob,c,"PROMOTE"); }
  else {
    c=o_app(ob,c,"NOISE_BUYS_THRESHOLD_NOT_ORDERING;GRADED_GAIN_IS_ARGMAX;PROPGEN_CLOSED");
  }
  c=o_nl(ob,c);
  o_flush(ob,c); return 0;
}
// Goal 505 (decline control): one need of novel tag 506, 3 fields.
fn mk_goal505(G:[]u8)void {
  let o:i32=w_begin(G,505,1);
  o=w_need(G,o,506,3); o=w_f(G,o,9); o=w_f(G,o,0); o=w_f(G,o,0);
  o=w_links(G,o,0);
  return;
}

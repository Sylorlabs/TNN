// cc_base.zag -- base for the cogops-compose battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the two researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE) and vfy_gen (id 1, VERIFY).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// cc_world.zag -- environment definitions for the cogops-compose battery.
// ALL world literals live in this file: relation/subject/object ids,
// goal tags, need tags. cc_learn.zag and cc_main.zag contain none of
// them (verified by grep in the REPORT).
//
// World A (32 facts): rel 301: (311+i,301,321+i); rel 302:
// (311+i,302,322+i); rel 303: (311+i,303,320+i), i=0..7.
// Distractors 307: (331+k,307,341+k); 309: (335+k,309,345+k), k=0..3.
// World B (24 facts): rel 401: (411+i,401,421+i); rel 402:
// (411+i,402,422+i), i=0..7. Distractor 407: (431+k,407,441+k), k=0..7.
fn setup_worldA(A:[]u8)void {
  set32(A,0,0);
  let i:i32=0;
  while(i<8){
    fact_add(A,311+i,301,321+i);
    fact_add(A,311+i,302,322+i);
    fact_add(A,311+i,303,320+i);
    i=i+1;
  }
  let k:i32=0;
  while(k<4){
    fact_add(A,331+k,307,341+k);
    fact_add(A,335+k,309,345+k);
    k=k+1;
  }
  return;
}
fn setup_worldB(A:[]u8)void {
  set32(A,0,0);
  let i:i32=0;
  while(i<8){
    fact_add(A,411+i,401,421+i);
    fact_add(A,411+i,402,422+i);
    i=i+1;
  }
  let k:i32=0;
  while(k<8){
    fact_add(A,431+k,407,441+k);
    k=k+1;
  }
  return;
}
// ---- retrieve-episode patterns: id -> (rel, obj) at rb[ro], rb[ro+4] ----
fn ret_ep_pat(id:i32,rb:[]u8,ro:i32)void {
  if(id==0){ set32(rb,ro,301); set32(rb,ro+4,323); return; }
  if(id==1){ set32(rb,ro,302); set32(rb,ro+4,325); return; }
  if(id==2){ set32(rb,ro,301); set32(rb,ro+4,321); return; }
  if(id==3){ set32(rb,ro,302); set32(rb,ro+4,322); return; }
  if(id==4){ set32(rb,ro,401); set32(rb,ro+4,421); return; }
  if(id==5){ set32(rb,ro,402); set32(rb,ro+4,428); return; }
  if(id==6){ set32(rb,ro,401); set32(rb,ro+4,425); return; }
  set32(rb,ro,402); set32(rb,ro+4,422);
  return;
}
// ---- verify-episode chains ----
fn vfy_ep_chain(C:[]u8,id:i32)void {
  chain_clear(C);
  if(id==0){
    chain_add(C,311,301,321); chain_add(C,311,302,322); return;
  }
  if(id==1){
    chain_add(C,312,303,321); chain_add(C,312,301,322); return;
  }
  if(id==2){
    chain_add(C,313,302,324); chain_add(C,313,303,322); return;
  }
  chain_add(C,314,301,324); chain_add(C,314,303,329);
  return;
}
// ---- goal layout helpers ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
// Link kind 2 = fan-out; kind 1 = scalar copy.
fn w_begin(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag); set32(G,4,nn); return 8;
}
fn w_need(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag); set32(G,off+4,nf); return off+8;
}
fn w_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn w_links(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn w_link(G:[]u8,off:i32,k:i32,dn:i32,dk:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,off,k); set32(G,off+4,dn); set32(G,off+8,dk);
  set32(G,off+12,ds); set32(G,off+16,sn); set32(G,off+20,sk);
  set32(G,off+24,ss);
  return off+28;
}
// Goal 503 F0: P=(301,323); T=(S,302,324),(S,303,322)
fn mk_goal503_F0(G:[]u8)void {
  let o:i32=w_begin(G,503,2);
  o=w_need(G,o,501,2); o=w_f(G,o,301); o=w_f(G,o,323);
  o=w_need(G,o,502,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,302); o=w_f(G,o,324);
  o=w_f(G,o,0); o=w_f(G,o,303); o=w_f(G,o,322);
  o=w_links(G,o,1);
  o=w_link(G,o,2,1,0,0,0,1,0);
  return;
}
// Goal 503 F1: P=(302,326); T=(S,301,325),(S,303,324)
fn mk_goal503_F1(G:[]u8)void {
  let o:i32=w_begin(G,503,2);
  o=w_need(G,o,501,2); o=w_f(G,o,302); o=w_f(G,o,326);
  o=w_need(G,o,502,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,301); o=w_f(G,o,325);
  o=w_f(G,o,0); o=w_f(G,o,303); o=w_f(G,o,324);
  o=w_links(G,o,1);
  o=w_link(G,o,2,1,0,0,0,1,0);
  return;
}
// Goal 503 F2: P=(301,321); T=(S,302,329),(S,301,321)
fn mk_goal503_F2(G:[]u8)void {
  let o:i32=w_begin(G,503,2);
  o=w_need(G,o,501,2); o=w_f(G,o,301); o=w_f(G,o,321);
  o=w_need(G,o,502,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,302); o=w_f(G,o,329);
  o=w_f(G,o,0); o=w_f(G,o,301); o=w_f(G,o,321);
  o=w_links(G,o,1);
  o=w_link(G,o,2,1,0,0,0,1,0);
  return;
}
// Goal 504 G0: C=(311,301,321),(311,302,322); P'=(?,325) rel from C.step0.rel
fn mk_goal504_G0(G:[]u8)void {
  let o:i32=w_begin(G,504,2);
  o=w_need(G,o,502,7); o=w_f(G,o,2);
  o=w_f(G,o,311); o=w_f(G,o,301); o=w_f(G,o,321);
  o=w_f(G,o,311); o=w_f(G,o,302); o=w_f(G,o,322);
  o=w_need(G,o,501,2); o=w_f(G,o,0); o=w_f(G,o,325);
  o=w_links(G,o,1);
  o=w_link(G,o,1,1,0,0,0,0,2);
  return;
}
// Goal 504 G1: C=(312,303,321),(312,301,322); P'=(?,324)
fn mk_goal504_G1(G:[]u8)void {
  let o:i32=w_begin(G,504,2);
  o=w_need(G,o,502,7); o=w_f(G,o,2);
  o=w_f(G,o,312); o=w_f(G,o,303); o=w_f(G,o,321);
  o=w_f(G,o,312); o=w_f(G,o,301); o=w_f(G,o,322);
  o=w_need(G,o,501,2); o=w_f(G,o,0); o=w_f(G,o,324);
  o=w_links(G,o,1);
  o=w_link(G,o,1,1,0,0,0,0,2);
  return;
}
// Goal 503 H0 (world B): P=(401,423); T=(S,402,424),(S,401,423)
fn mk_goal503_H0(G:[]u8)void {

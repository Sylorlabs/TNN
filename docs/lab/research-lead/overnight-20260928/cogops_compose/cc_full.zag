// Goal 505 (decline control): one need of novel tag 506, 3 fields.
fn mk_goal505(G:[]u8)void {
  let o:i32=w_begin(G,505,1);
  o=w_need(G,o,506,3); o=w_f(G,o,9); o=w_f(G,o,0); o=w_f(G,o,0);
  o=w_links(G,o,0);
  return;
}
// cc_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   BIND table at 8496: 4 entries x 24 bytes:
//     [tag, bound_fam, ok_ret, fail_ret, ok_vfy, fail_vfy].
//   PLAN table at 8592: 4 entries x 32 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1].
//   Stats at 8720: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
// One linear pass over all facts; each fact whose relation is in the
// retrieve working set is appended to that relation's bucket.
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
// Scans only the learned bucket for the pattern's relation. Returns -1
// if the relation is outside the learned coverage.
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
// Scans only the learned bucket for each step's relation. Returns -1
// if any step's relation is outside the learned coverage.
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 4) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- binding table ----
fn bind_off(bi:i32)i32 { return 8496+bi*24; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<4){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<4){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(nf>=4){
    let ns:i32=need_f(G,n,0);
    if(ns>=1){
      if(ns<=16){
        if(nf==1+ns*3){
          set32(tmpc,0,ns);
          let i:i32=0;
          while(i<ns){
            set32(tmpc,4+i*12,need_f(G,n,1+i*3));
            set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
            set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
            i=i+1;
          }
          vfy_gen(A,tmpc,K,8);
          return 1;
        }
      }
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Returns 1 iff every need tag ends bound; 0 if any need is unbindable.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_fam(L,bi)<0){
      let fam:i32=0;
      while(fam<2){
        set32(L,8728,get32(L,8728)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc);
        let bo:i32=bind_off(bi);
        if(fam==0){
          if(r==1){ set32(L,bo+8,get32(L,bo+8)+1); }
          if(r==0){ set32(L,bo+12,get32(L,bo+12)+1); }
        }
        if(fam==1){
          if(r==1){ set32(L,bo+16,get32(L,bo+16)+1); }
          if(r==0){ set32(L,bo+20,get32(L,bo+20)+1); }
        }
        if(r==1){
          if(bind_fam(L,bi)<0){ set32(L,bo+4,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let bi2:i32=bind_find(L,need_tag(G,m));
    if(bi2<0){ return 0; }
    if(bind_fam(L,bi2)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,8592+pi*32)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_nn(L:[]u8,gtag:i32)i32 {
  let pi:i32=plan_find(L,gtag);
  if(pi<0){ return 0; }
  return get32(L,8592+pi*32+4);
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,8592+pi*32)==0){
      let nn:i32=g_nneeds(G);
      set32(L,8592+pi*32,gtag);
      set32(L,8592+pi*32+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        set32(L,8592+pi*32+8+p*12,ni);
        set32(L,8592+pi*32+8+p*12+4,tag);
        set32(L,8592+pi*32+8+p*12+8,bind_fam(L,bi));
        p=p+1;
      }
      set32(L,8720,get32(L,8720)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1] into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,8592+pi*32)!=0){
      let k:i32=0;
      while(k<8){
        set32(out,k*4,get32(L,8592+pi*32+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,8592+pi*32,0); pi=pi+1; }
  return;
}
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<4){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,8592+pi*32+4);
  set32(vbuf,8,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,8592+pi*32+8+p*12);
    let fam:i32=get32(L,8592+pi*32+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,8748,get32(L,8748)+1);
        ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
      }
      if(ver==0){
        set32(L,8752,get32(L,8752)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,8756,get32(L,8756)+1); }
      if(ver2==1){ set32(L,8760,get32(L,8760)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    p=p+1;
  }
  return;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc);
    if(ok==0){
      set32(L,8732,get32(L,8732)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc);
    return 2;
  }
  set32(L,8724,get32(L,8724)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc);
  return 1;
}
// cc_main.zag -- driver for the cogops-compose battery.
// Stages S1A..S7, independent all-generic oracle compositions,
// per-query compose + compare, learner-state dumps, summaries.
// All dynamic output goes through the single preallocated buffer B,
// flushed once at the end. No world literals in this file: queries
// are built by the named constructors in cc_world.zag.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-VFY rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,8480) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,8484) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_bind(b:[]u8,c:i32,L:[]u8)i32 {
  let bi:i32=0;
  while(bi<4){
    let tag:i32=get32(L,8496+bi*24);
    if(tag!=0){
      c=o_app(b,c,"BIND tag=");
      c=o_i64(b,c,tag as i64);
      c=o_app(b,c," fam=");
      c=o_i64(b,c,get32(L,8496+bi*24+4) as i64);
      c=o_app(b,c," ok0=");
      c=o_i64(b,c,get32(L,8496+bi*24+8) as i64);
      c=o_app(b,c," f0=");
      c=o_i64(b,c,get32(L,8496+bi*24+12) as i64);
      c=o_app(b,c," ok1=");
      c=o_i64(b,c,get32(L,8496+bi*24+16) as i64);
      c=o_app(b,c," f1=");
      c=o_i64(b,c,get32(L,8496+bi*24+20) as i64);
      c=o_nl(b,c);
    }
    bi=bi+1;
  }
  return c;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,8592+pi*32);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,8592+pi*32+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,8592+pi*32+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,8592+pi*32+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,8592+pi*32+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_503: independent all-generic reference composition ----
// Reads the goal's needs directly; uses only ret_gen/vfy_gen.
fn oracle_503(A:[]u8,G:[]u8,K:[]u8,oans:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,1,0);
  let npass:i32=0;
  let pass:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns);
    let i:i32=0;
    while(i<ns){
      let s:i32=need_f(G,1,1+i*3);
      if(s==0){ s=sub; }
      set32(tmpc,4+i*12,s);
      set32(tmpc,4+i*12+4,need_f(G,1,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,1,1+i*3+2));
      i=i+1;
    }
    let vv:i32=vfy_gen(A,tmpc,K,4);
    if(vv==1){
      set32(pass,4+npass*4,sub);
      npass=npass+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass);
  let q3:i32=0;
  while(q3<npass){
    ans_append(oans,get32(pass,4+q3*4));
    q3=q3+1;
  }
  return;
}
// ---- oracle_504: independent all-generic reference composition ----
fn oracle_504(A:[]u8,G:[]u8,K:[]u8,oans:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  let rel:i32=need_f(G,0,2);
  let obj:i32=need_f(G,1,1);
  let tout:[]u8=z_alloc(160);
  let n2:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  ans_append(oans,n2);
  let k:i32=0;
  while(k<n2){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- one composite query: learner compose + oracle compare ----
fn do_query(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,qn:[]u8,okind:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=compose(L,A,G,K,ans,vbuf);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  set32(K,4,0);
  if(okind==0){ oracle_503(A,G,K,oans); }
  if(okind==1){ oracle_504(A,G,K,oans); }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  let a:i32=ans_eq(ans,oans);
  set32(L,8736,get32(L,8736)+a);
  set32(L,8740,get32(L,8740)+cs);
  set32(L,8744,get32(L,8744)+cg);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn:i32=get32(vbuf,8);
  let p:i32=0;
  while(p<nn){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let pg1:[]u8=z_alloc(32);
  let pg2:[]u8=z_alloc(32);
  // S1A RET-LEARN (world A)
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1A RET-LEARN"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  // S1B VFY-LEARN (world A)
  c=o_app(B,c,"STAGE S1B VFY-LEARN"); c=o_nl(B,c);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S2 COMPOSE-FIND (world A)
  c=o_app(B,c,"STAGE S2 COMPOSE-FIND"); c=o_nl(B,c);
  mk_goal503_F0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"F0",0);
  mk_goal503_F1(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"F1",0);
  mk_goal503_F2(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"F2",0);
  c=dump_bind(B,c,L);
  c=dump_plans(B,c,L);
  // S3 COMPOSE-PIVOT (world A)
  c=o_app(B,c,"STAGE S3 COMPOSE-PIVOT"); c=o_nl(B,c);
  mk_goal504_G0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"G0",1);
  mk_goal504_G1(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"G1",1);
  c=dump_plans(B,c,L);
  // S4 SHIFT-B (world B; ret coverage cleared)
  setup_worldB(A);
  ret_cov_clear(L);
  c=o_app(B,c,"STAGE S4 SHIFT-B"); c=o_nl(B,c);
  mk_goal503_H0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"H0",0);
  mk_goal503_H1(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"H1",0);
  // S5 REVISE-B: retrieve episodes on B, re-specialize
  c=o_app(B,c,"STAGE S5 REVISE-B"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,4,8);
  c=run_retep(B,c,L,A,K,rb,tout,5,9);
  c=run_retep(B,c,L,A,K,rb,tout,6,10);
  c=run_retep(B,c,L,A,K,rb,tout,7,11);
  specialize_ret(L,A,8,11);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  mk_goal503_H2(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"H2",0);
  mk_goal503_H3(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"H3",0);
  // S6 DECLINE-NOVEL
  c=o_app(B,c,"STAGE S6 DECLINE-NOVEL"); c=o_nl(B,c);
  mk_goal505(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"X",0);
  c=dump_bind(B,c,L);
  // S7 REDERIVE: clear plans + bindings, rebuild, byte-compare
  c=o_app(B,c,"STAGE S7 REDERIVE"); c=o_nl(B,c);
  plan_get_first(L,pg1);
  clear_plans(L);
  clear_bindings(L);
  mk_goal503_H2(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,"S7",0);
  plan_get_first(L,pg2);
  let m:i32=1;
  let k:i32=0;
  while(k<8){
    if(get32(pg1,k*4)!=get32(pg2,k*4)){ m=0; }
    k=k+1;
  }
  c=o_app(B,c,"REDERIVE match=");
  c=o_i64(B,c,m as i64);
  c=o_nl(B,c);
  // SUMMARY
  c=o_app(B,c,"SUMMARY-COMP agree=");
  c=o_i64(B,c,get32(L,8736) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,8720) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,8724) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,8728) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,8732) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,8740) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,8744) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,8748) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,8752) as i64);
  c=o_app(B,c," vs=");
  c=o_i64(B,c,get32(L,8756) as i64);
  c=o_app(B,c," vg=");
  c=o_i64(B,c,get32(L,8760) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

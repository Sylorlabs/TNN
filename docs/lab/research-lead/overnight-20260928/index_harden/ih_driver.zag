// ih_driver.zag -- index hardening corruption tests.
//
// Four corruption types against the hardened rebind_try_idx.
// Each type has 3 variants; each variant runs 3 times (determinism).
// Every world: 3 plen-5 chain MAPs, query facts taught, corruption
// applied to the plen-5 bucket, then ev_query. Requirements:
//   (a) no crash on any corruption,
//   (b) correct answer,
//   (c) 3/3 runs byte-identical per variant.
fn ih_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn ih_head(W:[]u8)i32 {
  let ix:i32=hg(W,52);
  if(ix<0){return -1;}
  return ng(W,ix,32);
}
fn ih_nth(W:[]u8,n:i32)i32 {
  let m:i32=ih_head(W);
  let i:i32=0;
  let guard:i32=0;
  while(m>=0 && i<n && guard<1100){
    if(m<2 || m>=1024){return -1;}
    m=ng(W,m,12);
    i=i+1; guard=guard+1;
  }
  return m;
}
fn ih_apply(W:[]u8,ctype:i32,variant:i32)void {
  let head:i32=ih_head(W);
  let ix:i32=hg(W,52);
  if(ctype==1){
    if(variant==0){
      if(head>=0){ns(W,head,12,head);}
      emit("T1v0 self-loop-at-head\n");
    } else { if(variant==1){
      let a:i32=ih_nth(W,1);
      let b:i32=ih_nth(W,2);
      if(a>=0 && b>=0){ns(W,b,12,a);}
      emit("T1v1 2-cycle-below-head\n");
    } else {
      let d1:i32=ih_nth(W,1);
      let d2:i32=ih_nth(W,2);
      if(d1>=0 && d2>=0){
        ns(W,d1,36,0); ns(W,d2,36,0);
        ns(W,d1,12,d2); ns(W,d2,12,d1);
      }
      emit("T1v2 dead-node-cycle\n");
    }}
  } else { if(ctype==2){
    if(variant==0){
      let f:i32=2;
      while(f<1024){
        if(ng(W,f,36)==1 && ng(W,f,0)==1){break;}
        f=f+1;
      }
      if(f<1024 && ix>=0){
        ns(W,f,12,head);
        ns(W,ix,32,f);
      }
      emit("T2v0 FACT-prepended\n");
    } else { if(variant==1){
      let f:i32=2;
      while(f<1024){
        if(ng(W,f,36)==1 && ng(W,f,0)==1){break;}
        f=f+1;
      }
      if(f<1024 && head>=0){
        ns(W,f,12,ng(W,head,12));
        ns(W,head,12,f);
      }
      emit("T2v1 FACT-mid-list\n");
    } else {
      if(head>=0 && ix>=0){
        ns(W,head,12,ix);
      }
      emit("T2v2 index-node-as-entry\n");
    }}
  } else { if(ctype==3){
    if(variant==0){
      if(head>=0){ns(W,head,12,9999);}
      emit("T3v0 next=9999\n");
    } else { if(variant==1){
      if(ix>=0){ns(W,ix,32,9999);}
      emit("T3v1 head=9999\n");
    } else {
      if(head>=0){ns(W,head,12,1024);}
      emit("T3v2 next=1024\n");
    }}
  } else {
    if(variant==0){
      if(head>=0){ns(W,head,36,0);}
      emit("T4v0 head-evicted\n");
    } else { if(variant==1){
      let m:i32=head;
      let guard:i32=0;
      while(m>=0 && guard<1100){
        if(m<2 || m>=1024){break;}
        let nx:i32=ng(W,m,12);
        ns(W,m,36,0);
        m=nx; guard=guard+1;
      }
      emit("T4v1 all-evicted\n");
    } else {
      if(head>=0){
        ns(W,head,36,0);
        ns(W,head,36,1);
        ns(W,head,0,1);
        ns(W,head,12,777);
      }
      emit("T4v2 slot-reused-as-FACT\n");
    }}
  }}}
  return;
}
fn ih_world(ctype:i32,variant:i32,rep:i32)void {
  emit("T"); e64(ctype); emit("v"); e64(variant); emit("r"); e64(rep);
  emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  idx_mode_set(W,1);
  let i:i32=0;
  while(i<3){
    ih_mkchain(W,5000+i*10,5,51,5004+i*10);
    i=i+1;
  }
  let q:i32=6101;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  ih_apply(W,ctype,variant);
  hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit("T"); e64(ctype); emit("v"); e64(variant); emit("r"); e64(rep);
  emit(" ans="); e64(b); emit(" ok="); e64(b==q+104);
  emit(" scan="); e64(hg(W,56)); emit("\n");
  emit("T"); e64(ctype); emit("v"); e64(variant); emit("r"); e64(rep);
  emit("-END\n");
  return;
}
fn ih_clean(rep:i32)void {
  emit("CLEANr"); e64(rep); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  idx_mode_set(W,1);
  let i:i32=0;
  while(i<3){
    ih_mkchain(W,5000+i*10,5,51,5004+i*10);
    i=i+1;
  }
  let q:i32=6101;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit("CLEANr"); e64(rep);
  emit(" ans="); e64(b); emit(" ok="); e64(b==q+104);
  emit(" scan="); e64(hg(W,56)); emit("\n");
  emit("CLEANr"); e64(rep); emit("-END\n");
  return;
}
fn main()i32 {
  emit("IH-TEST-START\n");
  let rep:i32=0;
  while(rep<3){
    ih_clean(rep);
    rep=rep+1;
  }
  let ct:i32=1;
  while(ct<=4){
    let v:i32=0;
    while(v<3){
      rep=0;
      while(rep<3){
        ih_world(ct,v,rep);
        rep=rep+1;
      }
      v=v+1;
    }
    ct=ct+1;
  }
  emit("IH-TEST-END\n");
  return 0;
}

// lm4.zag -- LIFETIME-STRATEGY-1 (LM4): strategy-level meta-learning.
// Continuing associative learner (LM3 substrate, unchanged base machinery)
// + learner-owned contradiction-management policy selected by bandit.
// Policies: 0=EAGER split on 1st contradiction, 1=ADAPTIVE (4-trial watch,
// split iff >=2 contradictions), 2=LAZY always overwrite.
// World: 36 episodes, 13 switch (6 fork + 7 revision), 13 probes, 10 stable.
// Neutral identifiers; learner never sees episode labels or kinds.
// G arena layout:
// 0 wstate(8) | 8 gstate(8) | 16 mapInst(320) | 336 cycInst(28) |
// 364 kind(36) | 400 famA(36) | 436 instA(36) | 472 famB(36) | 508 instB(36) |
// 544 qk(36) | 580 epmax(144) | 724 epqoff(144) | 868 swprobe(36) |
// 904 pof(36) | 940 streams(11520) |
// 12460 slots(1024*12) | 24748 nslots(4) | 24752 npart(4) | 24756 active(4) |
// 24760 prior(32) | qval_BASE pval(12) | qn_BASE pn(12) |
// 24824 splits(4) | 24828 evict(4) | 24832 genfail(4) |
// 24836 pol_used(36) | 25124 post_err(144) | 25268 probe_err(144) |
// 25412 oracle_min(144) | 25556 probe_acc(144) | 25700 ep_err(144) |
// 25844 watch_n(144) | 25988 shcomb(4)
// results: 32768+cond*2048 (2048 each)
// shadow save buffer: 49152 (saves 0..16 and 12460..24836)

fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,st:i32,n:i32)i32 {
  let s:i64=g64(G,st);
  s=(s*1103515245+12345)%2147483648;
  s64(G,st,s);
  return (((s>>16)%(n as i64)) as i32);
}
fn grnd(G:[]u8,n:i32)i32 {
  return rnd(G,8,n);
}
fn genfail_set(G:[]u8)void {
  set32(G,24832,1);
  return;
}
// ---- world generation (frozen) ----
fn gen(G:[]u8)void {
  s64(G,0,20261007);
  // map instances: 20 x 16 values in 0..5, skewed base then per-instance shuffle
  let pat:[]u8="0000001111223456";
  let inst:i32=0;
  while(inst<20){
    let i:i32=0;
    while(i<16){ G[16+inst*16+i]=(pat[i]-48) as u8; i=i+1; }
    i=0;
    while(i<16){
      let j:i32=i+rnd(G,0,16-i);
      let a:u8=G[16+inst*16+i];
      G[16+inst*16+i]=G[16+inst*16+j];
      G[16+inst*16+j]=a;
      i=i+1;
    }
    inst=inst+1;
  }
  // cycle instances: 7 x 4 values, perms of 0..3
  inst=0;
  while(inst<7){
    G[336+inst*4]=0; G[336+inst*4+1]=1; G[336+inst*4+2]=2; G[336+inst*4+3]=3;
    let i:i32=0;
    while(i<4){
      let j:i32=i+rnd(G,0,4-i);
      let a:u8=G[336+inst*4+i];
      G[336+inst*4+i]=G[336+inst*4+j];
      G[336+inst*4+j]=a;
      i=i+1;
    }
    inst=inst+1;
  }
  // derived instances (fork/revision): (src,dst,chg,ismap) table at scratch 60000
  // map idx: 0 m1,1 m2,2 m2b,3 m3,4 m3r,5 m4,6 m4b,7 m5,8 m5b,9 m6,10 m6r,
  //          11 m7,12 m7r,13 m8,14 m8b,15 m9,16 m9r,17 m10,18 m10b,19 m1r
  // cyc idx: 0 c1,1 c2,2 c2r,3 c3,4 c3b,5 c4,6 c4r
  let S:i32=60000;
  set32(G,S+0*4,1); set32(G,S+52+0*4,2); set32(G,S+104+0*4,13); set32(G,S+156+0*4,1);
  set32(G,S+1*4,3); set32(G,S+52+1*4,4); set32(G,S+104+1*4,3); set32(G,S+156+1*4,1);
  set32(G,S+2*4,3); set32(G,S+52+2*4,4); set32(G,S+104+2*4,3); set32(G,S+156+2*4,0);
  set32(G,S+3*4,5); set32(G,S+52+3*4,6); set32(G,S+104+3*4,1); set32(G,S+156+3*4,0);
  set32(G,S+4*4,7); set32(G,S+52+4*4,8); set32(G,S+104+4*4,12); set32(G,S+156+4*4,1);
  set32(G,S+5*4,9); set32(G,S+52+5*4,10); set32(G,S+104+5*4,2); set32(G,S+156+5*4,1);
  set32(G,S+6*4,11); set32(G,S+52+6*4,12); set32(G,S+104+6*4,3); set32(G,S+156+6*4,1);
  set32(G,S+7*4,13); set32(G,S+52+7*4,14); set32(G,S+104+7*4,14); set32(G,S+156+7*4,1);
  set32(G,S+8*4,15); set32(G,S+52+8*4,16); set32(G,S+104+8*4,2); set32(G,S+156+8*4,1);
  set32(G,S+9*4,17); set32(G,S+52+9*4,18); set32(G,S+104+9*4,13); set32(G,S+156+9*4,1);
  set32(G,S+10*4,5); set32(G,S+52+10*4,6); set32(G,S+104+10*4,12); set32(G,S+156+10*4,1);
  set32(G,S+11*4,0); set32(G,S+52+11*4,19); set32(G,S+104+11*4,4); set32(G,S+156+11*4,1);
  set32(G,S+12*4,1); set32(G,S+52+12*4,2); set32(G,S+104+12*4,1); set32(G,S+156+12*4,0);
  let e:i32=0;
  while(e<13){
    let s2:i32=get32(G,S+e*4);
    let d2:i32=get32(G,S+52+e*4);
    let k:i32=get32(G,S+104+e*4);
    let ismap:i32=get32(G,S+156+e*4);
    let n2:i32=16;
    let base:i32=16;
    let nv:i32=6;
    if(ismap==0){ n2=4; base=336; nv=4; }
    let i:i32=0;
    while(i<n2){ G[base+d2*n2+i]=G[base+s2*n2+i]; i=i+1; }
    // k distinct positions via partial shuffle of indices (scratch 60272)
    let IX:i32=60272;
    i=0;
    while(i<n2){ set32(G,IX+i*4,i); i=i+1; }
    i=0;
    while(i<k){
      let j:i32=i+rnd(G,0,n2-i);
      let tv:i32=get32(G,IX+i*4);
      set32(G,IX+i*4,get32(G,IX+j*4));
      set32(G,IX+j*4,tv);
      i=i+1;
    }
    i=0;
    while(i<k){
      let p2:i32=get32(G,IX+i*4);
      let old:u8=G[base+d2*n2+p2];
      let nw:u8=(((old as i32)+1+rnd(G,0,nv-1))%nv) as u8;
      G[base+d2*n2+p2]=nw;
      i=i+1;
    }
    e=e+1;
  }
  // episode table
  let kk:[]u8="002121021021021210212100212121210021";
  let ep:i32=0;
  while(ep<36){ G[364+ep]=kk[ep]; ep=ep+1; }
  // famA: 0 map,1 cyc,2 parity,3 compare
  let fa:[]u8="010000111011000001000023000011001100";
  // famB: 0 map,1 cyc (only meaningful on switch episodes)
  let fb:[]u8="000000010010000000000000000001000000";
  // instA table (scratch 60400), instB (scratch 60544)
  let IA:i32=60400;
  let IB:i32=60544;
  set32(G,IA+0*4,0); set32(G,IA+1*4,0); set32(G,IA+2*4,1); set32(G,IA+3*4,2);
  set32(G,IA+4*4,3); set32(G,IA+5*4,4); set32(G,IA+6*4,1); set32(G,IA+7*4,3);
  set32(G,IA+8*4,4); set32(G,IA+9*4,5); set32(G,IA+10*4,5); set32(G,IA+11*4,6);
  set32(G,IA+12*4,0); set32(G,IA+13*4,7); set32(G,IA+14*4,8); set32(G,IA+15*4,9);
  set32(G,IA+16*4,10); set32(G,IA+17*4,0); set32(G,IA+18*4,11); set32(G,IA+19*4,12);
  set32(G,IA+20*4,13); set32(G,IA+21*4,14); set32(G,IA+22*4,0); set32(G,IA+23*4,0);
  set32(G,IA+24*4,15); set32(G,IA+25*4,16); set32(G,IA+26*4,17); set32(G,IA+27*4,18);
  set32(G,IA+28*4,1); set32(G,IA+29*4,2); set32(G,IA+30*4,5); set32(G,IA+31*4,6);
  set32(G,IA+32*4,3); set32(G,IA+33*4,3); set32(G,IA+34*4,0); set32(G,IA+35*4,19);
  set32(G,IB+2*4,2); set32(G,IB+4*4,4); set32(G,IB+7*4,4); set32(G,IB+10*4,6);
  set32(G,IB+13*4,8); set32(G,IB+15*4,10); set32(G,IB+18*4,12); set32(G,IB+20*4,14);
  set32(G,IB+24*4,16); set32(G,IB+26*4,18); set32(G,IB+28*4,2); set32(G,IB+30*4,6);
  set32(G,IB+34*4,19);
  ep=0;
  while(ep<36){
    G[400+ep]=fa[ep];
    G[436+ep]=(get32(G,IA+ep*4) as u8);
    G[472+ep]=fb[ep];
    G[508+ep]=(get32(G,IB+ep*4) as u8);
    let f2:i32=(fa[ep] as i32)-48;
    let qk2:i32=0;
    if(f2==1){ qk2=1; }
    if(f2==2){ qk2=2; }
    if(f2==3){ qk2=2; }
    G[544+ep]=(qk2 as u8);
    let mx:i32=160;
    let kd:i32=(kk[ep] as i32)-48;
    if(kd==1){
      mx=24;
      if(f2==1){ mx=16; }
    }
    set32(G,580+ep*4,mx);
    G[868+ep]=255;
    G[904+ep]=255;
    ep=ep+1;
  }
  // switch->probe links (scratch 60700: sw list, 60752: pr list)
  let SW:i32=60700;
  let PR:i32=60752;
  set32(G,SW+0*4,2); set32(G,PR+0*4,3);
  set32(G,SW+1*4,4); set32(G,PR+1*4,5);
  set32(G,SW+2*4,7); set32(G,PR+2*4,8);
  set32(G,SW+3*4,10); set32(G,PR+3*4,11);
  set32(G,SW+4*4,13); set32(G,PR+4*4,14);
  set32(G,SW+5*4,15); set32(G,PR+5*4,16);
  set32(G,SW+6*4,18); set32(G,PR+6*4,19);
  set32(G,SW+7*4,20); set32(G,PR+7*4,21);
  set32(G,SW+8*4,24); set32(G,PR+8*4,25);
  set32(G,SW+9*4,26); set32(G,PR+9*4,27);
  set32(G,SW+10*4,28); set32(G,PR+10*4,29);
  set32(G,SW+11*4,30); set32(G,PR+11*4,31);
  set32(G,SW+12*4,34); set32(G,PR+12*4,35);
  e=0;
  while(e<13){
    let s3:i32=get32(G,SW+e*4);
    let p3:i32=get32(G,PR+e*4);
    G[868+s3]=(p3 as u8);
    G[904+p3]=(s3 as u8);
    e=e+1;
  }
  // query streams: shuffled blocks for guaranteed coverage
  // block size = query-space size; each block is a permutation
  let off:i32=940;
  ep=0;
  while(ep<36){
    set32(G,724+ep*4,off);
    let qk3:i32=G[544+ep] as i32;
    let nn:i32=get32(G,580+ep*4);
    let Q:i32=16;
    if(qk3==1){ Q=4; }
    if(qk3==2){ Q=36; }
    let PB:i32=60900;
    let t:i32=0;
    let pi:i32=0;
    let j:i32=0;
    let tv2:i32=0;
    let pv2:i32=0;
    let qq0:i32=0;
    let qq1:i32=0;
    while(t<nn){
      pi=0;
      while(pi<Q){
        set32(G,PB+pi*4,pi);
        pi=pi+1;
      }
      pi=0;
      while(pi<Q){
        j=pi+rnd(G,0,Q-pi);
        tv2=get32(G,PB+pi*4);
        set32(G,PB+pi*4,get32(G,PB+j*4));
        set32(G,PB+j*4,tv2);
        pi=pi+1;
      }
      pi=0;
      let done:i32=0;
      while(pi<Q){
        if(t>=nn){ done=1; }
        if(done==0){
          pv2=get32(G,PB+pi*4);
          qq0=pv2;
          qq1=0;
          if(qk3==2){
            qq0=pv2/6;
            qq1=pv2-(pv2/6)*6;
          }
          G[off+t*2]=qq0 as u8;
          G[off+t*2+1]=qq1 as u8;
          t=t+1;
        }
        pi=pi+1;
      }
    }
    off=off+nn*2;
    ep=ep+1;
  }
  return;
}
// truth: kind 48 stable, 49 probe, 50 switch (switch at trial 96)
fn truth(G:[]u8,ep:i32,q0:i32,q1:i32,t:i32)i32 {
  let kd:i32=G[364+ep] as i32;
  let fam:i32=(G[400+ep] as i32)-48;
  let inst:i32=G[436+ep] as i32;
  if(kd==50){
    if(t>=96){
      fam=(G[472+ep] as i32)-48;
      inst=G[508+ep] as i32;
    }
  }
  if(fam==0){ return G[16+inst*16+q0] as i32; }
  if(fam==1){ return G[336+inst*4+q0] as i32; }
  if(fam==2){ return (q0+q1)%2; }
  if(q0>q1){ return 1; }
  return 0;
}
// ---- learner (no episode labels; policies keyed only by observed cost) ----
fn lrn_reset(G:[]u8)void {
  set32(G,24748,0);
  set32(G,24752,0);
  set32(G,24756,-1);
  set32(G,24824,0);
  set32(G,24828,0);
  set32(G,24832,0);
  let i:i32=0;
  while(i<8){ set32(G,24760+i*4,1); i=i+1; }
  i=0;
  while(i<4){ set32(G,24792+i*4,0); set32(G,24808+i*4,0); i=i+1; }
  s64(G,8,777);
  return;
}
fn prior_guess(G:[]u8)i32 {
  let best:i32=0;
  let bv:i32=get32(G,24760);
  let i:i32=1;
  while(i<8){
    let v:i32=get32(G,24760+i*4);
    if(v>bv){ bv=v; best=i; }
    i=i+1;
  }
  let nt:i32=0;
  i=0;
  while(i<8){
    if(get32(G,24760+i*4)==bv){ nt=nt+1; }
    i=i+1;
  }
  if(nt<=1){ return best; }
  let pick:i32=grnd(G,nt);
  i=0;
  while(i<8){
    if(get32(G,24760+i*4)==bv){
      if(pick==0){ return i; }
      pick=pick-1;
    }
    i=i+1;
  }
  return best;
}
fn find_slot(G:[]u8,reg:i32,q0:i32,q1:i32)i32 {
  let n:i32=get32(G,24748);
  let i:i32=0;
  while(i<n){
    let b:i32=12460+i*12;
    if(get32(G,b+8)==reg){
      if(G[b]==(q0 as u8)){
        if(G[b+1]==(q1 as u8)){ return i; }
      }
    }
    i=i+1;
  }
  return -1;
}
fn slot_create(G:[]u8,reg:i32,q0:i32,q1:i32,v:i32)void {
  let n:i32=get32(G,24748);
  if(n>=1024){
    let bi:i32=0;
    let bs:i32=get32(G,12460+4);
    let i:i32=1;
    while(i<n){
      let s:i32=get32(G,12460+i*12+4);
      if(s<bs){ bs=s; bi=i; }
      i=i+1;
    }
    let b:i32=12460+bi*12;
    G[b]=q0 as u8; G[b+1]=q1 as u8; G[b+2]=v as u8;
    set32(G,b+4,1); set32(G,b+8,reg);
    set32(G,24828,get32(G,24828)+1);
    return;
  }
  let b2:i32=12460+n*12;
  G[b2]=q0 as u8; G[b2+1]=q1 as u8; G[b2+2]=v as u8;
  set32(G,b2+4,1); set32(G,b2+8,reg);
  set32(G,24748,n+1);
  return;
}
fn lrn_guess(G:[]u8,q0:i32,q1:i32)i32 {
  let act:i32=get32(G,24756);
  if(act>=0){
    let f:i32=find_slot(G,act,q0,q1);
    if(f>=0){ return G[12460+f*12+2] as i32; }
  }
  return prior_guess(G);
}
fn reg_new(G:[]u8)void {
  let nn:i32=get32(G,24752);
  if(nn>=48){ genfail_set(G); return; }
  set32(G,24752,nn+1);
  set32(G,24756,nn);
  return;
}
// partition selection by slot-evidence (fixed rule, all conditions):
// qualifies if >=3 slot hits on 6 orientation queries with >=80% correct.
fn lrn_select(G:[]u8,ep:i32,qoff:i32)void {
  let nr:i32=get32(G,24752);
  let best_c:i32=-1;
  let best_r:i32=-1;
  let r:i32=0;
  while(r<nr){
    let hits:i32=0;
    let corr:i32=0;
    let t:i32=0;
    while(t<6){
      let q0:i32=G[qoff+t*2] as i32;
      let q1:i32=G[qoff+t*2+1] as i32;
      let f:i32=find_slot(G,r,q0,q1);
      if(f>=0){
        hits=hits+1;
        if((G[12460+f*12+2] as i32)==truth(G,ep,q0,q1,t)){ corr=corr+1; }
      }
      t=t+1;
    }
    let qcand:i32=0;
    if(hits>=3){
      if(corr*5>=hits*4){ qcand=1; }
    }
    if(qcand==1){
      if(corr>best_c){ best_c=corr; best_r=r; }
    }
    r=r+1;
  }
  if(best_r>=0){ set32(G,24756,best_r); return; }
  reg_new(G);
  return;
}
// epsilon-greedy over 3 policies; values = mean combined cost (lower better)
fn bandit_choose_ctx(G:[]u8,ctx:i32)i32 {
  let r:i32=grnd(G,100);
  if(r<10){ return grnd(G,2); }
  let b0:i32=get32(G,24792+ctx*8);
  let b1:i32=get32(G,24792+ctx*8+4);
  if(b1<b0){ return 1; }
  return 0;
}
fn do_split(G:[]u8,q0:i32,q1:i32,a:i32,has_q:i32)void {
  reg_new(G);
  if(has_q==1){
    let act:i32=get32(G,24756);
    slot_create(G,act,q0,q1,a);
  }
  set32(G,24824,get32(G,24824)+1);
  return;
}
fn do_overwrite(G:[]u8,f:i32,a:i32)void {
  let b:i32=12460+f*12;
  G[b+2]=a as u8;
  set32(G,b+4,1);
  return;
}
// run one episode. force_pol: policy for switch eps in shadow mode.
// shadow=1: no record writes, no bandit updates; combined cost -> G[25988].
// run one episode. force_act: action for switch eps in shadow mode (0=SPLIT,1=OVERWRITE).
// shadow=1: no record writes, no bandit updates; combined cost -> G[25988].
fn run_episode(G:[]u8,ep:i32,cond:i32,force_act:i32,shadow:i32)void {
  let kd:i32=G[364+ep] as i32;
  let mx:i32=get32(G,580+ep*4);
  let qoff:i32=get32(G,724+ep*4);
  if(cond==2){ if(kd!=49){ lrn_reset(G); } }
  let t:i32=0;
  while(t<6){
    let q0:i32=G[qoff+t*2] as i32;
    let q1:i32=G[qoff+t*2+1] as i32;
    let g:i32=prior_guess(G);
    let a:i32=truth(G,ep,q0,q1,t);
    set32(G,24760+a*4,get32(G,24760+a*4)+1);
    t=t+1;
  }
  if(kd==49){
    // probe: no state updates
    lrn_select(G,ep,qoff);
    let corr:i32=0;
    t=6;
    while(t<mx){
      let q0:i32=G[qoff+t*2] as i32;
      let q1:i32=G[qoff+t*2+1] as i32;
      let g:i32=lrn_guess(G,q0,q1);
      let a:i32=truth(G,ep,q0,q1,t);
      if(g==a){ corr=corr+1; }
      t=t+1;
    }
    let perr:i32=(mx-6)-corr;
    if(shadow==1){
      set32(G,25988,get32(G,25988)+perr);
      return;
    }
    set32(G,25268+ep*4,perr);
    set32(G,25556+ep*4,(corr*100)/(mx-6));
    if(cond==0){
      let sw:i32=G[904+ep] as i32;
      let comb:i32=get32(G,25124+sw*4)+perr;
      let cact:i32=get32(G,24836+sw*4);
      let cctx:i32=get32(G,24980+sw*4);
      if(cact>=0){
        let qi:i32=cctx*2+cact;
        let n:i32=get32(G,24808+qi*4)+1;
        set32(G,24808+qi*4,n);
        let pv:i32=get32(G,24792+qi*4);
        set32(G,24792+qi*4,pv+(comb-pv)/n);
      }
    }
    return;
  }
  lrn_select(G,ep,qoff);
  // contextual policy state (switch episodes only)
  let wphase:i32=0;
  let wleft:i32=0;
  let wcount:i32=0;
  let pact:i32=-1;
  let pctx:i32=0;
  let didsplit:i32=0;
  let errors:i32=0;
  let posterr:i32=0;
  t=6;
  while(t<mx){
    let q0:i32=G[qoff+t*2] as i32;
    let q1:i32=G[qoff+t*2+1] as i32;
    let g:i32=lrn_guess(G,q0,q1);
    let a:i32=truth(G,ep,q0,q1,t);
    let ok:i32=0;
    if(g==a){ ok=1; }
    if(ok==0){
      errors=errors+1;
      if(t>=96){ posterr=posterr+1; }
    }
    set32(G,24760+a*4,get32(G,24760+a*4)+1);
    let act:i32=get32(G,24756);
    let f:i32=find_slot(G,act,q0,q1);
    if(ok==1){
      if(f>=0){
        let b:i32=12460+f*12;
        set32(G,b+4,get32(G,b+4)+1);
      }
      else { slot_create(G,act,q0,q1,a); }
    }
    else {
      if(f<0){ slot_create(G,act,q0,q1,a); }
      else {
        let postsw:i32=0;
        if(kd==50){
          if(t>=96){ postsw=1; }
        }
        if(postsw==0){
          if(cond==2){ do_overwrite(G,f,a); }
          else { do_split(G,q0,q1,a,1); didsplit=1; }
        }
        else {
          if(wphase==0){
            wphase=1; wleft=4; wcount=1;
          }
          else {
            if(wphase==1){ wcount=wcount+1; }
            else {
              if(pact==0){
                if(didsplit==0){ do_split(G,q0,q1,a,1); didsplit=1; }
                else { do_overwrite(G,f,a); }
              }
              else { do_overwrite(G,f,a); }
            }
          }
        }
      }
    }
    if(kd==50){
      if(wphase==1){
        wleft=wleft-1;
        if(wleft==0){
          wphase=2;
          if(wcount>=2){ pctx=1; } else { pctx=0; }
          if(shadow==0){ set32(G,25844+ep*4,wcount); }
          if(cond==0){
            if(shadow==0){
              pact=bandit_choose_ctx(G,pctx);
              set32(G,24836+ep*4,pact);
              set32(G,24980+ep*4,pctx);
            }
            else { pact=force_act; }
          }
          else { pact=0; }
          if(pact==0){ do_split(G,0,0,0,0); didsplit=1; }
        }
      }
    }
    t=t+1;
  }
  if(shadow==1){
    set32(G,25988,posterr);
    return;
  }
  set32(G,25700+ep*4,errors);
  if(kd==50){ set32(G,25124+ep*4,posterr); }
  return;
}
// ---- shadow oracle: counterfactual combined cost per action ----
fn shadow_oracle(G:[]u8,ep:i32,cond:i32)void {
  let B:i32=49152;
  let i:i32=0;
  while(i<16){ G[B+i]=G[i]; i=i+1; }
  i=0;
  while(i<12376){ G[B+16+i]=G[12460+i]; i=i+1; }
  let probe_ep:i32=G[868+ep] as i32;
  let best:i32=2147483647;
  let act2:i32=0;
  while(act2<2){
    i=0;
    while(i<16){ G[i]=G[B+i]; i=i+1; }
    i=0;
    while(i<12376){ G[12460+i]=G[B+16+i]; i=i+1; }
    set32(G,25988,0);
    run_episode(G,ep,cond,act2,1);
    run_episode(G,probe_ep,cond,act2,1);
    let cb:i32=get32(G,25988);
    if(cb<best){ best=cb; }
    act2=act2+1;
  }
  i=0;
  while(i<16){ G[i]=G[B+i]; i=i+1; }
  i=0;
  while(i<12376){ G[12460+i]=G[B+16+i]; i=i+1; }
  set32(G,25412+ep*4,best);
  return;
}
fn run_cond(G:[]u8,cond:i32)void {
  lrn_reset(G);
  let i:i32=0;
  while(i<36){
    set32(G,24836+i*4,-1);
    set32(G,24980+i*4,0);
    set32(G,25124+i*4,0);
    set32(G,25268+i*4,0);
    set32(G,25412+i*4,0);
    set32(G,25556+i*4,0);
    set32(G,25700+i*4,0);
    set32(G,25844+i*4,0);
    i=i+1;
  }
  let ep:i32=0;
  while(ep<36){
    let kd:i32=G[364+ep] as i32;
    if(kd==50){
      if(cond==0){ shadow_oracle(G,ep,cond); }
      if(cond==2){ shadow_oracle(G,ep,cond); }
    }
    run_episode(G,ep,cond,0,0);
    ep=ep+1;
  }
  let dst:i32=32768+cond*2048;
  i=0;
  while(i<36){
    set32(G,dst+i*4,get32(G,24836+i*4));
    i=i+1;
  }
  i=0;
  while(i<36){
    set32(G,dst+144+i*4,get32(G,24980+i*4));
    set32(G,dst+288+i*4,get32(G,25124+i*4));
    set32(G,dst+432+i*4,get32(G,25268+i*4));
    set32(G,dst+576+i*4,get32(G,25412+i*4));
    set32(G,dst+720+i*4,get32(G,25556+i*4));
    set32(G,dst+864+i*4,get32(G,25700+i*4));
    set32(G,dst+1008+i*4,get32(G,25844+i*4));
    i=i+1;
  }
  set32(G,dst+1152,get32(G,24824));
  set32(G,dst+1156,get32(G,24828));
  set32(G,dst+1160,get32(G,24832));
  set32(G,dst+1164,get32(G,24748));
  set32(G,dst+1168,get32(G,24752));
  return;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
fn inst_diff(G:[]u8,ep:i32)i32 {
  let fam:i32=(G[400+ep] as i32)-48;
  let ia2:i32=G[436+ep] as i32;
  let ib2:i32=G[508+ep] as i32;
  let d:i32=0;
  if(fam==0){
    let i:i32=0;
    while(i<16){
      if(G[16+ia2*16+i]!=G[16+ib2*16+i]){ d=d+1; }
      i=i+1;
    }
  }
  else {
    let i:i32=0;
    while(i<4){
      if(G[336+ia2*4+i]!=G[336+ib2*4+i]){ d=d+1; }
      i=i+1;
    }
  }
  return d;
}
fn swcomb(G:[]u8,bs:i32,ep:i32)i32 {
  let pe:i32=G[868+ep] as i32;
  return get32(G,bs+288+ep*4)+get32(G,bs+432+pe*4);
}
fn main()i32 {
  let p:*u8=_zag_malloc(65536) as *u8;
  let G:[]u8=p[0..65536];
  let z:i32=0;
  while(z<65536){ G[z]=0; z=z+1; }
  gen(G);
  run_cond(G,0);
  run_cond(G,1);
  run_cond(G,2);
  let q:*u8=_zag_malloc(16384) as *u8;
  let B:[]u8=q[0..16384];
  let c:i32=0;
  c=o_app(B,c,"LM4 W=20261007 SW@96 OR=6 WATCH=4/2 EPS=10 CTX"); c=o_nl(B,c);
  let b4:i32=1;
  let e:i32=0;
  c=o_app(B,c,"DIFFS");
  while(e<36){
    let kd:i32=G[364+e] as i32;
    if(kd==50){
      let d:i32=inst_diff(G,e);
      let fam:i32=(G[400+e] as i32)-48;
      c=o_app(B,c," ");
      c=o_i64(B,c,e as i64);
      c=o_app(B,c,":");
      c=o_i64(B,c,d as i64);
      let isfork:i32=0;
      if(e==2){ isfork=1; }
      if(e==7){ isfork=1; }
      if(e==13){ isfork=1; }
      if(e==20){ isfork=1; }
      if(e==26){ isfork=1; }
      if(e==30){ isfork=1; }
      if(isfork==1){
        if(fam==0){
          if(d<12){ b4=0; }
          if(d>14){ b4=0; }
        }
        else {
          if(d!=3){ b4=0; }
        }
      }
      else {
        if(fam==0){
          if(d<2){ b4=0; }
          if(d>4){ b4=0; }
        }
        else {
          if(d!=1){ b4=0; }
        }
      }
    }
    e=e+1;
  }
  c=o_nl(B,c);
  let ds:i32=1;
  let v1:i32=0;
  while(v1<36){
    let w1:i32=v1+1;
    while(w1<36){
      let o1:i32=get32(G,724+v1*4);
      let o2:i32=get32(G,724+w1*4);
      let n1:i32=get32(G,580+v1*4);
      let n2:i32=get32(G,580+w1*4);
      if(n1==n2){
        if(veq(G,o1,o2,n1*2)==1){ ds=0; }
      }
      w1=w1+1;
    }
    v1=v1+1;
  }
  if(ds==0){ b4=0; }
  let cc:i32=0;
  while(cc<3){
    let bs:i32=32768+cc*2048;
    c=o_app(B,c,"COND "); c=o_i64(B,c,cc as i64); c=o_nl(B,c);
    e=0;
    while(e<36){
      let kd:i32=(G[364+e] as i32)-48;
      c=o_app(B,c,"E");
      if(e<10){ c=o_app(B,c,"0"); }
      c=o_i64(B,c,e as i64);
      c=o_app(B,c," k="); c=o_i64(B,c,kd as i64);
      c=o_app(B,c," act="); c=o_i64(B,c,get32(G,bs+e*4) as i64);
      c=o_app(B,c," ctx="); c=o_i64(B,c,get32(G,bs+144+e*4) as i64);
      c=o_app(B,c," perr="); c=o_i64(B,c,get32(G,bs+864+e*4) as i64);
      if(kd==2){
        c=o_app(B,c," post="); c=o_i64(B,c,get32(G,bs+288+e*4) as i64);
        c=o_app(B,c," comb="); c=o_i64(B,c,swcomb(G,bs,e) as i64);
        c=o_app(B,c," omin="); c=o_i64(B,c,get32(G,bs+576+e*4) as i64);
        c=o_app(B,c," w="); c=o_i64(B,c,get32(G,bs+1008+e*4) as i64);
      }
      if(kd==1){
        c=o_app(B,c," acc="); c=o_i64(B,c,get32(G,bs+720+e*4) as i64);
      }
      c=o_nl(B,c);
      e=e+1;
    }
    cc=cc+1;
  }
  let b0:i32=32768;
  let b1:i32=34816;
  let b2:i32=36864;
  let rf6:i32=0;
  let rl6:i32=0;
  let rrf6:i32=0;
  let rrl6:i32=0;
  let tot0:i32=0;
  let tot1:i32=0;
  e=0;
  while(e<36){
    let kd:i32=(G[364+e] as i32)-48;
    if(kd==2){
      let cb0:i32=swcomb(G,b0,e);
      let cb1:i32=swcomb(G,b1,e);
      tot0=tot0+cb0;
      tot1=tot1+cb1;
      let rg0:i32=cb0-get32(G,b0+576+e*4);
      let rg2:i32=swcomb(G,b2,e)-get32(G,b2+576+e*4);
      let first:i32=0;
      if(e==2){ first=1; }
      if(e==4){ first=1; }
      if(e==7){ first=1; }
      if(e==10){ first=1; }
      if(e==13){ first=1; }
      if(e==15){ first=1; }
      let last:i32=0;
      if(e==20){ last=1; }
      if(e==24){ last=1; }
      if(e==26){ last=1; }
      if(e==28){ last=1; }
      if(e==30){ last=1; }
      if(e==34){ last=1; }
      if(first==1){ rf6=rf6+rg0; rrf6=rrf6+rg2; }
      if(last==1){ rl6=rl6+rg0; rrl6=rrl6+rg2; }
    }
    e=e+1;
  }
  let b5a:i32=0;
  if(rl6<rf6){
    if(rl6<=12){ b5a=1; }
  }
  let b5b:i32=0;
  if(tot0<=tot1-10){ b5b=1; }
  let b5c:i32=0;
  if(rrl6<=rrf6+6){ b5c=1; }
  let f14:i32=get32(G,b0+720+14*4);
  let f21:i32=get32(G,b0+720+21*4);
  let f27:i32=get32(G,b0+720+27*4);
  let f31:i32=get32(G,b0+720+31*4);
  let rsum:i32=get32(G,b0+720+5*4)+get32(G,b0+720+11*4)+get32(G,b0+720+16*4)+get32(G,b0+720+19*4)+get32(G,b0+720+25*4)+get32(G,b0+720+29*4)+get32(G,b0+720+35*4);
  let b5d:i32=0;
  if(f14>=85){
    if(f21>=85){
      if(f27>=85){
        if(f31>=85){
          if(rsum>=560){ b5d=1; }
        }
      }
    }
  }
  let g3:i32=get32(G,b1+720+3*4);
  let g8:i32=get32(G,b1+720+8*4);
  let g14:i32=get32(G,b1+720+14*4);
  let g21:i32=get32(G,b1+720+21*4);
  let g27:i32=get32(G,b1+720+27*4);
  let g31:i32=get32(G,b1+720+31*4);
  let b5e:i32=1;
  if(g3<85){ b5e=0; }
  if(g8<85){ b5e=0; }
  if(g14<85){ b5e=0; }
  if(g21<85){ b5e=0; }
  if(g27<85){ b5e=0; }
  if(g31<85){ b5e=0; }
  let cci:i32=0;
  while(cci<3){
    let bx:i32=32768+cci*2048;
    if(get32(G,bx+1156)>0){ b5e=0; }
    if(get32(G,bx+1160)>0){ b5e=0; }
    if(get32(G,bx+1164)>1024){ b5e=0; }
    if(get32(G,bx+1168)>48){ b5e=0; }
    cci=cci+1;
  }
  c=o_app(B,c,"BARS B4="); c=o_i64(B,c,b4 as i64);
  c=o_app(B,c," B5A="); c=o_i64(B,c,b5a as i64);
  c=o_app(B,c," B5B="); c=o_i64(B,c,b5b as i64);
  c=o_app(B,c," B5C="); c=o_i64(B,c,b5c as i64);
  c=o_app(B,c," B5D="); c=o_i64(B,c,b5d as i64);
  c=o_app(B,c," B5E="); c=o_i64(B,c,b5e as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"REG c0 first6="); c=o_i64(B,c,rf6 as i64);
  c=o_app(B,c," last6="); c=o_i64(B,c,rl6 as i64);
  c=o_app(B,c," c2 first6="); c=o_i64(B,c,rrf6 as i64);
  c=o_app(B,c," last6="); c=o_i64(B,c,rrl6 as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"TOT c0="); c=o_i64(B,c,tot0 as i64);
  c=o_app(B,c," c1="); c=o_i64(B,c,tot1 as i64);
  c=o_nl(B,c);
  cc=0;
  while(cc<3){
    let bx:i32=32768+cc*2048;
    c=o_app(B,c,"C"); c=o_i64(B,c,cc as i64);
    c=o_app(B,c," splits="); c=o_i64(B,c,get32(G,bx+1152) as i64);
    c=o_app(B,c," evict="); c=o_i64(B,c,get32(G,bx+1156) as i64);
    c=o_app(B,c," genfail="); c=o_i64(B,c,get32(G,bx+1160) as i64);
    c=o_app(B,c," nslots="); c=o_i64(B,c,get32(G,bx+1164) as i64);
    c=o_app(B,c," npart="); c=o_i64(B,c,get32(G,bx+1168) as i64);
    c=o_nl(B,c);
    cc=cc+1;
  }
  o_flush(B,c);
  return 0;
}

// world_rt_conf2.zag -- Red-team attack W-CONF2: two confounders.
// Derived from sealed S-NEG2; adds inert confounders C1, C2.
// RED-TEAM TRUTH: Y(t) = X(t-2) AND NOT Z(t-2). C1, C2 inert.
// Vars: X(0,ctrl), C1(1,ctrl), C2(2,ctrl), Z(3,ctrl), Y(4).
// Passive: env SETs X ALONE at t=3,9; C1,C2,Z never pulsed.
// Y=1 at t=5,11.
// Goal: w_goal_setup sets C1=1, C2=1, Z=1 at t=0.
// Two spurious first-matches precede the true inhibitor in var
// order; ATTEMPT_MAX=3 admits at most two D1 growths. Mode 0: Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 5; }
fn w_nctrl()i32 { return 4; }
fn w_ctrl(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 2; }
  return 3;
}
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "C1"; }
  if(v==2){ return "C2"; }
  if(v==3){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ14-redteam-conf2"; }
fn w_plan_maxd()i32 { return 8; }

fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+5*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-2>=0){ zv=ws[8+3*32+(t-2)] as i32; }
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+4*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<5){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==3){ ws[8+0*32+t]=1; }
  if(t==9){ ws[8+0*32+t]=1; }
  return;
}
fn w_goal_setup(ws:[]u8)void {
  ws[8+1*32+0]=1;
  ws[8+2*32+0]=1;
  ws[8+3*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[4]==1){ return 1; }
  return 0;
}
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("REDTEAM DONE mask=");
  e64(m);
  emit("\n");
  return 0;
}

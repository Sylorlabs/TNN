// lc_base.zag -- COMPOSE-LEARNCOMPOSE-1 base (verbatim copy of BACKCHAIN-1 substrate).
// Alloc, little-endian i32 access, output helpers, kind compatibility
// (with relaxed/widen flag), fact store, MAP table (40 ids), MAP
// execution counting. Pure Zag. No phases: execution is interleaved
// with search by construction.
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
//
// Arena A (world): MAP inventory + facts.
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s, r, o)
//   772: MAP table, 40 maps * 8 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 inmask, 3 outmask,
//                4 inmask1, 5 inmask2, 6 arity, 7 nobs
//   2052: nmaps
// Classes: 0=WALK, 1=COUNT, 4=ADD2 (PAIR6 substrate).
//
// Arena S (backchain learner state; FRESH per problem: memoryless):
//   0: nthunk
//   4: tries (= total MAP executions)
//   8: widen (0/1)
//   12: relaxed (0/1; widen pass)
//   16: e1set
//   20: e1 (exec_total right after first candidate executed)
//   24: const_tid (current goal const thunk)
//   28: nocc
//   32: exec per map, 40 * 4 bytes
//   192: thunk table, 4096 entries * 8 fields * 4 bytes
//        fields: 0 map(-1=const), 1 in1, 2 in2, 3 cval,
//                4 kindmask, 5 memo, 6 onstack, 7 unused
//   131264: occ frames, 1200000 * 8 fields * 4 bytes
//        (chain-10 needs ~986k frames: the (need,producer)-pair guard
//        permits permutation exploration; the design's 4.8 notes the
//        exponential worst case, so the arena is sized for it)
//        fields: 0 need-kind K, 1 next-producer cursor, 2 cur producer,
//                3 stage, 4 child occ, 5 child2 occ, 6 leg1 thunk,
//                7 parent occ
// Sentinels: MISS=-2, NOVAL=-999999.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena accessors ----
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,772+m*32+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,772+m*32+f*4,v); return; }
fn sg(S:[]u8,off:i32)i32 { return get32(S,off); }
fn sp(S:[]u8,off:i32,v:i32)void { set32(S,off,v); return; }
fn tg(S:[]u8,t:i32,f:i32)i32 { return get32(S,192+t*32+f*4); }
fn tp(S:[]u8,t:i32,f:i32,v:i32)void { set32(S,192+t*32+f*4,v); return; }
fn eg(S:[]u8,m:i32)i32 { return get32(S,32+m*4); }
fn ep(S:[]u8,m:i32,v:i32)void { set32(S,32+m*4,v); return; }
fn of(S:[]u8,o:i32,f:i32)i32 { return get32(S,131264+o*32+f*4); }
fn of_set(S:[]u8,o:i32,f:i32,v:i32)void { set32(S,131264+o*32+f*4,v); return; }
// ---- kind compatibility: mask==0 compatible with all; kinds are 1-based bit positions ----
// khas_rel: relaxed (widen pass) ignores kind compatibility entirely.
fn khas(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn khas_rel(S:[]u8,mask:i32,k:i32)i32 {
  if(sg(S,12)==1){ return 1; }
  return khas(mask,k);
}
// ---- facts: single-hop lookup / count, missing -> -2 ----
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn fact_del(A:[]u8,s:i32,r:i32)void {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    let fs:i32=get32(A,4+i*12);
    let fr:i32=get32(A,4+i*12+4);
    if(fs==s && fr==r){
      let li:i32=n-1;
      set32(A,4+i*12,get32(A,4+li*12));
      set32(A,4+i*12+4,get32(A,4+li*12+4));
      set32(A,4+i*12+8,get32(A,4+li*12+8));
      ap(A,0,li);
      return;
    }
    i=i+1;
  }
  return;
}
fn fact1(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    let fs:i32=get32(A,4+i*12);
    let fr:i32=get32(A,4+i*12+4);
    if(fs==s && fr==rel){ return get32(A,4+i*12+8); }
    i=i+1;
  }
  return -2;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs:i32=get32(A,4+i*12);
    let fr:i32=get32(A,4+i*12+4);
    if(fs==s && fr==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// ---- MAP table ----
fn map_new(A:[]u8,m:i32,cl:i32,rel:i32,inm:i32,outm:i32,inm1:i32,inm2:i32,ar:i32)void {
  mp(A,m,0,cl); mp(A,m,1,rel); mp(A,m,2,inm); mp(A,m,3,outm);
  mp(A,m,4,inm1); mp(A,m,5,inm2); mp(A,m,6,ar); mp(A,m,7,0);
  let nm:i32=ag(A,2052);
  if(m>=nm){ ap(A,2052,m+1); }
  return;
}
// ---- MAP execution (counted; tries == total MAP executions) ----
fn exec_map(S:[]u8,A:[]u8,m:i32,v1:i32)i32 {
  sp(S,4,sg(S,4)+1);
  ep(S,m,eg(S,m)+1);
  let cl:i32=mg(A,m,0);
  let rel:i32=mg(A,m,1);
  if(cl==0){ return fact1(A,v1,rel); }
  if(cl==1){ return count_rel(A,v1,rel); }
  return -2;
}
fn exec_map2(S:[]u8,A:[]u8,m:i32,v1:i32,v2:i32)i32 {
  sp(S,4,sg(S,4)+1);
  ep(S,m,eg(S,m)+1);
  let cl:i32=mg(A,m,0);
  if(cl==4){
    if(v1==-2){ return -2; }
    if(v2==-2){ return -2; }
    return v1+v2;
  }
  return -2;
}
// lc_mem.zag -- COMPOSE-LEARNCOMPOSE-1 composition memory.
// Learner-owned state: (goal-signature, composite program, outcome
// history) entries. Signature = (kin, kout, sorted contract-code
// multiset). Similarity, retrieval, contract-defined adaptation,
// program extraction/storage. All decisions over opaque ids, arities,
// kind bitmasks, and code multisets: no labels enter.
//
// Arena M layout:
//   0: nentries
//   4: entries, 16 * 600 bytes
// entry e at 4+e*600:
//   +0: kin, +4: kout, +8: ncodes, +12: codes[16] (64 bytes),
//   +76: succ, +80: fail, +84: plen, +88: instrs[16]*32 bytes
// instr i: +0 map_id, +4 arity, +8 c_in, +12 c_out, +16 c_in1,
//          +20 c_in2, +24 a, +28 b   (a,b: instr idx or -1=CONST;
//          b=-9 unused for arity 1)
//
// Program buffer P (scratch): 0: plen; 4: instrs[16]*32 bytes.

// ---- entry accessors ----
fn egh(M:[]u8,e:i32,f:i32) i32 { return get32(M,4+e*600+f); }
fn esh(M:[]u8,e:i32,f:i32,v:i32) void { set32(M,4+e*600+f,v); return; }
fn ecg(M:[]u8,e:i32,i:i32) i32 { return get32(M,4+e*600+12+i*4); }
fn ecs(M:[]u8,e:i32,i:i32,v:i32) void { set32(M,4+e*600+12+i*4,v); return; }
fn eig(M:[]u8,e:i32,i:i32,f:i32) i32 { return get32(M,4+e*600+88+i*32+f*4); }
fn eis(M:[]u8,e:i32,i:i32,f:i32,v:i32) void { set32(M,4+e*600+88+i*32+f*4,v); return; }
// ---- program buffer accessors ----
fn pblen(P:[]u8) i32 { return get32(P,0); }
fn pbsetlen(P:[]u8,n:i32) void { set32(P,0,n); return; }
fn pbg(P:[]u8,i:i32,f:i32) i32 { return get32(P,4+i*32+f*4); }
fn pbs(P:[]u8,i:i32,f:i32,v:i32) void { set32(P,4+i*32+f*4,v); return; }
// ---- contract code (label-free: arity + kind bitmasks only) ----
fn code_of(A:[]u8,m:i32) i32 {
  let ar:i32=mg(A,m,6);
  if(ar==1){ return 1000000+mg(A,m,2)*1000+mg(A,m,3); }
  return 2000000+mg(A,m,4)*1000+mg(A,m,5)*10+mg(A,m,3);
}
// sketch: sorted contract codes of inventory [base,base+nm).
// codes: 64-byte scratch (16 i32). Returns ncodes.
fn sketch(A:[]u8,base:i32,nm:i32,codes:[]u8) i32 {
  let n:i32=0;
  let m:i32=base;
  while(m<base+nm){
    set32(codes,n*4,code_of(A,m));
    n=n+1;
    m=m+1;
  }
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(get32(codes,j*4)<get32(codes,i*4)){
        let t:i32=get32(codes,i*4);
        set32(codes,i*4,get32(codes,j*4));
        set32(codes,j*4,t);
      }
      j=j+1;
    }
    i=i+1;
  }
  return n;
}
fn count_code(codes:[]u8,nc:i32,c:i32) i32 {
  let k:i32=0;
  let i:i32=0;
  while(i<nc){
    if(get32(codes,i*4)==c){ k=k+1; }
    i=i+1;
  }
  return k;
}
fn ecount(M:[]u8,e:i32,c:i32) i32 {
  let k:i32=0;
  let n:i32=egh(M,e,8);
  let i:i32=0;
  while(i<n){
    if(ecg(M,e,i)==c){ k=k+1; }
    i=i+1;
  }
  return k;
}
// multiset subset: every code's count in a <= its count in b.
fn msubset_a(a:[]u8,na:i32,M:[]u8,e:i32) i32 {
  let i:i32=0;
  while(i<na){
    let c:i32=get32(a,i*4);
    if(count_code(a,na,c)>ecount(M,e,c)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn msubset_e(M:[]u8,e:i32,b:[]u8,nb:i32) i32 {
  let n:i32=egh(M,e,8);
  let i:i32=0;
  while(i<n){
    let c:i32=ecg(M,e,i);
    if(ecount(M,e,c)>count_code(b,nb,c)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn ecodes_equal(M:[]u8,e:i32,codes:[]u8,nc:i32) i32 {
  if(egh(M,e,8)!=nc){ return 0; }
  let i:i32=0;
  while(i<nc){
    if(ecg(M,e,i)!=get32(codes,i*4)){ return 0; }
    i=i+1;
  }
  return 1;
}
// similarity: 3 exact, 2 subset/superset, 1 kind-only, 0 none.
fn sim_of(M:[]u8,e:i32,kin:i32,kout:i32,codes:[]u8,nc:i32) i32 {
  if(egh(M,e,0)!=kin){ return 0; }
  if(egh(M,e,4)!=kout){ return 0; }
  if(ecodes_equal(M,e,codes,nc)==1){ return 3; }
  if(msubset_a(codes,nc,M,e)==1){ return 2; }
  if(msubset_e(M,e,codes,nc)==1){ return 2; }
  return 1;
}
// retrieve: best entry with sim>=2 by (sim, succ-fail, low index).
// Key encoding keeps the comparison flat and deterministic.
fn retrieve(M:[]u8,kin:i32,kout:i32,codes:[]u8,nc:i32) i32 {
  let ne:i32=get32(M,0);
  let best:i32=-1;
  let bkey:i32=-1;
  let e:i32=0;
  while(e<ne){
    let s:i32=sim_of(M,e,kin,kout,codes,nc);
    if(s>=2){
      let score:i32=egh(M,e,76)-egh(M,e,80)+500;
      let key:i32=s*1000000+score*1000+(15-e);
      if(key>bkey){ best=e; bkey=key; }
    }
    e=e+1;
  }
  return best;
}
fn mem_new(M:[]u8,kin:i32,kout:i32,codes:[]u8,nc:i32) i32 {
  let ne:i32=get32(M,0);
  if(ne>=16){ return -1; }
  esh(M,ne,0,kin); esh(M,ne,4,kout); esh(M,ne,8,nc);
  let i:i32=0;
  while(i<nc){ ecs(M,ne,i,get32(codes,i*4)); i=i+1; }
  esh(M,ne,76,0); esh(M,ne,80,0); esh(M,ne,84,0);
  set32(M,0,ne+1);
  return ne;
}
// exact contract match (frozen adaptation rule).
fn contract_match(A:[]u8,m:i32,ar:i32,ci:i32,co:i32,ci1:i32,ci2:i32) i32 {
  if(mg(A,m,6)!=ar){ return 0; }
  if(ar==1){
    if(mg(A,m,2)!=ci){ return 0; }
    if(mg(A,m,3)!=co){ return 0; }
    return 1;
  }
  if(mg(A,m,4)!=ci1){ return 0; }
  if(mg(A,m,5)!=ci2){ return 0; }
  if(mg(A,m,3)!=co){ return 0; }
  return 1;
}
// adapt one instruction's map id: identity if present+matching,
// else lowest contract-matching id, else -1.
fn adapt_map(A:[]u8,base:i32,nm:i32,om:i32,ar:i32,ci:i32,co:i32,ci1:i32,ci2:i32) i32 {
  if(om>=base){
    if(om<base+nm){
      if(contract_match(A,om,ar,ci,co,ci1,ci2)==1){ return om; }
    }
  }
  let m:i32=base;
  while(m<base+nm){
    if(contract_match(A,m,ar,ci,co,ci1,ci2)==1){ return m; }
    m=m+1;
  }
  return -1;
}
// is candidate new_id already used by an earlier instruction?
fn is_used(P:[]u8,i:i32,cand:i32) i32 {
  let j:i32=0;
  while(j<i){
    if(pbg(P,j,0)==cand){ return 1; }
    j=j+1;
  }
  return 0;
}
// adapt entry e's program into P (current-inventory ids; -1 unmapped).
// INJECTIVE (AMEND2): distinct original ids map to distinct new ids
// when possible; same original id reuses its new id. Returns count
// of unmapped instructions.
fn adapt_prog(M:[]u8,e:i32,A:[]u8,base:i32,nm:i32,P:[]u8) i32 {
  let n:i32=egh(M,e,84);
  pbsetlen(P,n);
  let nun:i32=0;
  let i:i32=0;
  while(i<n){
    let om:i32=eig(M,e,i,0);
    let ar:i32=eig(M,e,i,1);
    let ci:i32=eig(M,e,i,2);
    let co:i32=eig(M,e,i,3);
    let ci1:i32=eig(M,e,i,4);
    let ci2:i32=eig(M,e,i,5);
    let nid:i32=-2;
    // 1. same original id already mapped earlier: reuse its new id.
    let j:i32=0;
    while(j<i){
      if(eig(M,e,j,0)==om){ nid=pbg(P,j,0); }
      j=j+1;
    }
    // 2. identity: original id present, matching, unused.
    if(nid==-2){
      if(om>=base){
        if(om<base+nm){
          if(contract_match(A,om,ar,ci,co,ci1,ci2)==1){
            if(is_used(P,i,om)==0){ nid=om; }
          }
        }
      }
    }
    // 3. lowest unused contract-matching id.
    if(nid==-2){
      let m:i32=base;
      let found:i32=0;
      while(m<base+nm){
        if(found==0){
          if(contract_match(A,m,ar,ci,co,ci1,ci2)==1){
            if(is_used(P,i,m)==0){ nid=m; found=1; }
          }
        }
        m=m+1;
      }
    }
    // 4. unmapped.
    if(nid==-2){ nid=-1; }
    if(nid<0){ nun=nun+1; }
    pbs(P,i,0,nid); pbs(P,i,1,ar); pbs(P,i,2,ci); pbs(P,i,3,co);
    pbs(P,i,4,ci1); pbs(P,i,5,ci2);
    pbs(P,i,6,eig(M,e,i,6)); pbs(P,i,7,eig(M,e,i,7));
    i=i+1;
  }
  return nun;
}
// DROP_UNMAPPED repair: drop -1 instructions, rewire dependents to
// CONST, reindex. Returns new length (0 -> caller cold-starts).
fn drop_unmapped(P:[]u8) i32 {
  let n:i32=pblen(P);
  let keep:[]u8=z_alloc(n*4);
  let nidx:[]u8=z_alloc(n*4);
  let i:i32=0;
  while(i<n){
    if(pbg(P,i,0)>=0){ set32(keep,i*4,1); } else { set32(keep,i*4,0); }
    i=i+1;
  }
  let j:i32=0;
  i=0;
  while(i<n){
    if(get32(keep,i*4)==1){ set32(nidx,i*4,j); j=j+1; }
    else { set32(nidx,i*4,-1); }
    i=i+1;
  }
  let Q:[]u8=z_alloc(516);
  let k:i32=0;
  i=0;
  while(i<n){
    if(get32(keep,i*4)==1){
      let f:i32=0;
      while(f<8){ pbs(Q,k,f,pbg(P,i,f)); f=f+1; }
      let a:i32=pbg(Q,k,6);
      let b:i32=pbg(Q,k,7);
      if(a>=0){
        if(get32(keep,a*4)==1){ pbs(Q,k,6,get32(nidx,a*4)); }
        else { pbs(Q,k,6,-1); }
      }
      if(b>=0){
        if(get32(keep,b*4)==1){ pbs(Q,k,7,get32(nidx,b*4)); }
        else { pbs(Q,k,7,-1); }
      }
      k=k+1;
    }
    i=i+1;
  }
  pbsetlen(P,k);
  i=0;
  while(i<k){
    let f:i32=0;
    while(f<8){ pbs(P,i,f,pbg(Q,i,f)); f=f+1; }
    i=i+1;
  }
  return k;
}
fn prog_copy(P:[]u8,Q:[]u8) void {
  let n:i32=pblen(P);
  pbsetlen(Q,n);
  let i:i32=0;
  while(i<n){
    let f:i32=0;
    while(f<8){ pbs(Q,i,f,pbg(P,i,f)); f=f+1; }
    i=i+1;
  }
  return;
}
// extract winning thunk DAG as a program (DFS post-order;
// const -> -1). Stored into entry e.
fn ext_dfs(S:[]u8,A:[]u8,M:[]u8,e:i32,t:i32,idxmap:[]u8) i32 {
  if(tg(S,t,0)==-1){ return -1; }
  let got:i32=get32(idxmap,t*4);
  if(got>=0){ return got; }
  let m:i32=tg(S,t,0);
  let ar:i32=mg(A,m,6);
  let a:i32=ext_dfs(S,A,M,e,tg(S,t,1),idxmap);
  let b:i32=-9;
  if(ar==2){ b=ext_dfs(S,A,M,e,tg(S,t,2),idxmap); }
  let ii:i32=egh(M,e,84);
  eis(M,e,ii,0,m); eis(M,e,ii,1,ar);
  eis(M,e,ii,2,mg(A,m,2)); eis(M,e,ii,3,mg(A,m,3));
  eis(M,e,ii,4,mg(A,m,4)); eis(M,e,ii,5,mg(A,m,5));
  eis(M,e,ii,6,a); eis(M,e,ii,7,b);
  esh(M,e,84,ii+1);
  set32(idxmap,t*4,ii);
  return ii;
}
fn prog_extract(S:[]u8,A:[]u8,M:[]u8,e:i32,root:i32) void {
  let idxmap:[]u8=z_alloc(16384);
  let t:i32=0;
  while(t<4096){ set32(idxmap,t*4,-1); t=t+1; }
  esh(M,e,84,0);
  ext_dfs(S,A,M,e,root,idxmap);
  return;
}
// store program buffer P as a new entry under (kin,kout,codes).
fn mem_store_pb(M:[]u8,kin:i32,kout:i32,codes:[]u8,nc:i32,P:[]u8) i32 {
  let e:i32=mem_new(M,kin,kout,codes,nc);
  if(e<0){ return -1; }
  let n:i32=pblen(P);
  esh(M,e,84,n);
  esh(M,e,76,1);
  esh(M,e,80,0);
  let i:i32=0;
  while(i<n){
    let f:i32=0;
    while(f<8){ eis(M,e,i,f,pbg(P,i,f)); f=f+1; }
    i=i+1;
  }
  return e;
}
// adv_worlds.zag -- COMPOSE-ADVERSARY sealed world builders.
// Pure Zag. Transcription of PREREG.md Section 4 (frozen).
// Uses the substrate API (map_new, fact_add) shared by all three
// frozen mechanisms, so these functions are drop-in replacements
// for the builders' w_* world functions at sealed-evaluation time.
// map_new(A,m,class,rel,inmask,outmask,inmask1,inmask2,arity).
// Classes: 0=WALK, 1=COUNT, 4=ADD2. Kinds 1/2 are opaque.

// F-A1 CHAIN15: 15-link chain (A: frame explosion; B: depth; C: cold).
fn w_adv_chain15(A:[]u8) void {
  let i:i32=0;
  while(i<15){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,15,1,76,1,2,0,0,1);
  fact_add(A,516,76,801); fact_add(A,516,76,802);
  fact_add(A,516,76,803); fact_add(A,516,76,804);
  return;
}
// F-B1 CHAIN7: 7-link chain (B depth cap: 6 max).
fn w_adv_chain7(A:[]u8) void {
  let i:i32=0;
  while(i<7){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,7,1,68,1,2,0,0,1);
  fact_add(A,508,68,801); fact_add(A,508,68,802);
  fact_add(A,508,68,803); fact_add(A,508,68,804);
  return;
}
// F-B2 SUBCAP: correct = C1(W3(W2(s))); B's 128 sub-buffer fills
// with W1-rooted chains, so the W3-rooted program is never built.
fn w_adv_subcap(A:[]u8) void {
  map_new(A,0,1,71,1,2,0,0,1);
  map_new(A,1,1,72,1,2,0,0,1);
  map_new(A,2,1,73,1,2,0,0,1);
  map_new(A,3,1,74,1,2,0,0,1);
  let i:i32=0;
  while(i<11){
    map_new(A,4+i,0,81+i,1,1,0,0,1);
    i=i+1;
  }
  fact_add(A,501,82,601);
  fact_add(A,601,83,602);
  fact_add(A,602,71,701); fact_add(A,602,71,702);
  fact_add(A,602,71,703); fact_add(A,602,71,704);
  fact_add(A,501,81,699);
  return;
}
// F-C1 TEACH: 2-chain [X,Y]; C stores it as E1.
fn w_adv_teach(A:[]u8) void {
  map_new(A,1,0,91,1,1,0,0,1);
  map_new(A,2,1,92,1,2,0,0,1);
  fact_add(A,201,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  return;
}
// F-C1 TRAP1: 16-map inventory; codes superset of TEACH -> sim 2.
// Correct = [Z,X,Y]; retrieved [X,Y] misfires, R1-R4 cannot prepend.
fn w_adv_trap1(A:[]u8) void {
  map_new(A,0,0,90,1,1,0,0,1);
  map_new(A,1,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<10){
    map_new(A,2+i,0,93+i,1,1,0,0,1);
    fact_add(A,201,93+i,700+i);
    i=i+1;
  }
  map_new(A,12,1,92,1,2,0,0,1);
  map_new(A,13,1,103,1,2,0,0,1);
  map_new(A,14,1,104,1,2,0,0,1);
  map_new(A,15,1,105,1,2,0,0,1);
  fact_add(A,201,90,211);
  fact_add(A,211,91,212);
  fact_add(A,212,92,911); fact_add(A,212,92,912); fact_add(A,212,92,913);
  fact_add(A,212,92,914); fact_add(A,212,92,915);
  fact_add(A,201,103,921); fact_add(A,201,103,922);
  fact_add(A,201,104,923); fact_add(A,201,104,924);
  fact_add(A,201,105,925); fact_add(A,201,105,926);
  return;
}
// D-C2 TRAP2: same inventory; correct = [W1,X,Y] (1-edit from
// TRAP1's stored [Z,X,Y]; R1 SUBST_FAILED repairs it).
fn w_adv_trap2(A:[]u8) void {
  map_new(A,0,0,90,1,1,0,0,1);
  map_new(A,1,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<10){
    map_new(A,2+i,0,93+i,1,1,0,0,1);
    i=i+1;
  }
  map_new(A,12,1,92,1,2,0,0,1);
  map_new(A,13,1,103,1,2,0,0,1);
  map_new(A,14,1,104,1,2,0,0,1);
  map_new(A,15,1,105,1,2,0,0,1);
  fact_add(A,201,93,213);
  fact_add(A,213,91,212);
  fact_add(A,212,92,911); fact_add(A,212,92,912); fact_add(A,212,92,913);
  fact_add(A,212,92,914); fact_add(A,212,92,915);
  return;
}
// D-C1 TEACH-D: diamond (stores E1 for transfer).
fn w_adv_teachd(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  map_new(A,1,1,92,1,2,0,0,1);
  map_new(A,2,1,94,1,2,0,0,1);
  map_new(A,3,4,0,0,2,2,2,2);
  fact_add(A,202,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  fact_add(A,211,94,911); fact_add(A,211,94,912);
  return;
}
// D-C1 T-FANIN: 2-leg fan-in; diamond memory transfers via
// DROP_UNMAPPED (X unmapped -> legs rewired to CONST).
fn w_adv_tfanin(A:[]u8) void {
  map_new(A,0,1,71,1,2,0,0,1);
  map_new(A,1,1,72,1,2,0,0,1);
  map_new(A,2,4,0,0,2,2,2,2);
  fact_add(A,401,71,701); fact_add(A,401,71,702); fact_add(A,401,71,703);
  fact_add(A,401,72,704); fact_add(A,401,72,705);
  return;
}
// D-C1 T-CHAIN: 2-chain; diamond memory transfers via
// DROP_UNMAPPED (G unmapped -> dropped; last instr Wp wins).
fn w_adv_tchain(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  map_new(A,1,1,92,1,2,0,0,1);
  map_new(A,2,1,94,1,2,0,0,1);
  fact_add(A,301,91,311);
  fact_add(A,311,92,801); fact_add(A,311,92,802);
  fact_add(A,311,92,803); fact_add(A,311,92,804);
  fact_add(A,311,94,811); fact_add(A,311,94,812); fact_add(A,311,94,813);
  return;
}
// D-B1 / S-ALL1 CYCLE: one WALK on a cyclic relation.
fn w_adv_cycle(A:[]u8) void {
  map_new(A,0,0,61,1,1,0,0,1);
  fact_add(A,501,61,502);
  fact_add(A,502,61,503);
  fact_add(A,503,61,502);
  return;
}
// X-CHAIN5: 5-link chain, fresh relations.
fn w_adv_chain5(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,5,1,66,1,2,0,0,1);
  let k:i32=0;
  while(k<6){
    fact_add(A,506,66,801+k);
    k=k+1;
  }
  return;
}
// X-FANOUT5: X -> 5 COUNT consumers -> 4-ADD2 join tree.
fn w_adv_fanout5(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<5){
    map_new(A,1+i,1,92+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,6+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,202,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902);
  fact_add(A,211,93,903);
  fact_add(A,211,94,904); fact_add(A,211,94,905); fact_add(A,211,94,906);
  fact_add(A,211,95,907); fact_add(A,211,95,908);
  fact_add(A,211,96,909); fact_add(A,211,96,910);
  return;
}
// X-FANIN5: 5 WALK->COUNT legs -> 4-ADD2 join tree.
fn w_adv_fanin5(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    map_new(A,5+i,1,71+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,10+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,401,61,501); fact_add(A,501,71,701); fact_add(A,501,71,702);
  fact_add(A,401,62,502); fact_add(A,502,72,703); fact_add(A,502,72,704);
  fact_add(A,502,72,705);
  fact_add(A,401,63,503); fact_add(A,503,73,706);
  fact_add(A,401,64,504); fact_add(A,504,74,707); fact_add(A,504,74,708);
  fact_add(A,504,74,709); fact_add(A,504,74,710);
  fact_add(A,401,65,505); fact_add(A,505,75,711); fact_add(A,505,75,712);
  return;
}
// X-DAG10: 2-chain -> shared X -> two diamonds -> ADD2 join.
fn w_adv_dag10(A:[]u8) void {
  map_new(A,0,0,60,1,1,0,0,1);
  map_new(A,1,0,61,1,1,0,0,1);
  map_new(A,2,0,62,1,1,0,0,1);
  map_new(A,3,1,71,1,2,0,0,1);
  map_new(A,4,1,72,1,2,0,0,1);
  map_new(A,5,4,0,0,2,2,2,2);
  map_new(A,6,1,73,1,2,0,0,1);
  map_new(A,7,1,74,1,2,0,0,1);
  map_new(A,8,4,0,0,2,2,2,2);
  map_new(A,9,4,0,0,2,2,2,2);
  fact_add(A,301,60,302); fact_add(A,302,61,303); fact_add(A,303,62,310);
  fact_add(A,310,71,711); fact_add(A,310,71,712);
  fact_add(A,310,72,713); fact_add(A,310,72,714); fact_add(A,310,72,715);
  fact_add(A,310,73,716);
  fact_add(A,310,74,717); fact_add(A,310,74,718);
  fact_add(A,310,74,719); fact_add(A,310,74,720);
  return;
}
// X-PARTIAL: 5-leg fan-in; legs 4,5 factless (partial applicability).
fn w_adv_partial(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    map_new(A,5+i,1,71+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,10+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,401,61,501); fact_add(A,501,71,701); fact_add(A,501,71,702);
  fact_add(A,401,62,502); fact_add(A,502,72,703); fact_add(A,502,72,704);
  fact_add(A,502,72,705);
  fact_add(A,401,63,503); fact_add(A,503,73,706); fact_add(A,503,73,707);
  fact_add(A,503,73,708); fact_add(A,503,73,709); fact_add(A,503,73,710);
  return;
}
// probe_main.zag -- root-cause probe for C's SEQ1 vs SEQ2 retrieval boundary.
// Replays sketch()/sim_of() exactly as eval_main_c.zag called them,
// and prints the stored/query code multisets to show why sim=1 on
// SEQ1 and sim=2 on SEQ2. Pure Zag; single-buffer output idiom.

fn pcodes(B:[]u8,c:i32,tag:[]u8,codes:[]u8,nc:i32) i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," nc=");
  c=o_i64(B,c,nc as i64);
  c=o_nl(B,c);
  let i:i32=0;
  while(i<nc){
    c=o_app(B,c,"  code=");
    c=o_i64(B,c,get32(codes,i*4) as i64);
    c=o_nl(B,c);
    i=i+1;
  }
  return c;
}

fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;

  // ---- SEQ1: TEACH as the eval called it (base=0, nm=3) ----
  let A1:[]u8=z_alloc(8192);
  w_adv_teach(A1);
  let cd1:[]u8=z_alloc(64);
  let n1:i32=sketch(A1,0,3,cd1);
  c=pcodes(B,c,"TEACH(eval base0 nm3)",cd1,n1);

  // ---- counterfactual: TEACH sketched over its real maps only ----
  let cd1b:[]u8=z_alloc(64);
  let n1b:i32=sketch(A1,1,2,cd1b);
  c=pcodes(B,c,"TEACH(clean base1 nm2)",cd1b,n1b);

  // ---- TRAP1 / TRAP2 queries ----
  let A2:[]u8=z_alloc(8192);
  w_adv_trap1(A2);
  let cd2:[]u8=z_alloc(64);
  let n2:i32=sketch(A2,0,16,cd2);
  c=pcodes(B,c,"TRAP1(base0 nm16)",cd2,n2);

  let A3:[]u8=z_alloc(8192);
  w_adv_trap2(A3);
  let cd3:[]u8=z_alloc(64);
  let n3:i32=sketch(A3,0,16,cd3);
  c=pcodes(B,c,"TRAP2(base0 nm16)",cd3,n3);

  // ---- store TEACH entry exactly as lc_cold did, score sim ----
  let M:[]u8=z_alloc(16384);
  let e:i32=mem_new(M,1,2,cd1,n1);
  let s1:i32=sim_of(M,e,1,2,cd2,n2);
  c=o_app(B,c,"SIM(TEACH-eval-entry,TRAP1)=");
  c=o_i64(B,c,s1 as i64);
  c=o_nl(B,c);
  let s2:i32=sim_of(M,e,1,2,cd3,n3);
  c=o_app(B,c,"SIM(TEACH-eval-entry,TRAP2)=");
  c=o_i64(B,c,s2 as i64);
  c=o_nl(B,c);
  let r1:i32=retrieve(M,1,2,cd2,n2);
  c=o_app(B,c,"RETRIEVE(TEACH-eval-entry,TRAP1)=");
  c=o_i64(B,c,r1 as i64);
  c=o_nl(B,c);

  // ---- counterfactual entry: sim if TEACH had been sketched clean ----
  let M2:[]u8=z_alloc(16384);
  let eb:i32=mem_new(M2,1,2,cd1b,n1b);
  let s1b:i32=sim_of(M2,eb,1,2,cd2,n2);
  c=o_app(B,c,"SIM(TEACH-clean-entry,TRAP1)=");
  c=o_i64(B,c,s1b as i64);
  c=o_nl(B,c);

  // ---- SEQ2: TEACHD / TFANIN / TCHAIN ----
  let A4:[]u8=z_alloc(8192);
  w_adv_teachd(A4);
  let cd4:[]u8=z_alloc(64);
  let n4:i32=sketch(A4,0,4,cd4);
  c=pcodes(B,c,"TEACHD(base0 nm4)",cd4,n4);

  let A5:[]u8=z_alloc(8192);
  w_adv_tfanin(A5);
  let cd5:[]u8=z_alloc(64);
  let n5:i32=sketch(A5,0,3,cd5);
  c=pcodes(B,c,"TFANIN(base0 nm3)",cd5,n5);

  let A6:[]u8=z_alloc(8192);
  w_adv_tchain(A6);
  let cd6:[]u8=z_alloc(64);
  let n6:i32=sketch(A6,0,3,cd6);
  c=pcodes(B,c,"TCHAIN(base0 nm3)",cd6,n6);

  let M3:[]u8=z_alloc(16384);
  let e3:i32=mem_new(M3,1,2,cd4,n4);
  let s5:i32=sim_of(M3,e3,1,2,cd5,n5);
  c=o_app(B,c,"SIM(TEACHD-entry,TFANIN)=");
  c=o_i64(B,c,s5 as i64);
  c=o_nl(B,c);
  let s6:i32=sim_of(M3,e3,1,2,cd6,n6);
  c=o_app(B,c,"SIM(TEACHD-entry,TCHAIN)=");
  c=o_i64(B,c,s6 as i64);
  c=o_nl(B,c);
  let r5:i32=retrieve(M3,1,2,cd5,n5);
  c=o_app(B,c,"RETRIEVE(TEACHD-entry,TFANIN)=");
  c=o_i64(B,c,r5 as i64);
  c=o_nl(B,c);

  o_flush(B,c);
  return 0;
}

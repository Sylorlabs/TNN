// h3_incorporated.zag -- H3-INCORPORATED lane.
// Investigates the remaining open question from the H3 arc:
// INCORPORATED/SUPERSEDED reasons and the successful-episode
// importance source.
//
// Substrate functions are carried verbatim from reclamation_h3's
// unpin_h3.zag (put32/ig/z_alloc, e1s/e1i/flush/pf, soff/mem_zero/
// hfn/tget/stamp, mem_write/mem_read, learner_scratch, lholds,
// learner_unpin, count_a_released, learner_check). The relocation
// below (relocate8) is the policy-8 branch of H3's relocate verbatim,
// as a standalone function; mem_write calls it (one-token harness
// adaptation, documented in PREREG.md).
//
// Frozen deltas under test (see PREREG.md):
//  1. Revision log entries are 16 bytes (key, old, new, reason);
//     reason codes: 1=REVISED, 2=INCORPORATED, 3=SUPERSEDED.
//  2. learner_revise takes a reason vector; consolidate passes the
//     log's reason into the release trace verbatim.
//  3. learner_consolidate_g takes a guard flag; guard=1 adds the
//     no-live-reference precondition for reason==2 only.
//  4. Reference model (harness convention): a pooled entry references
//     absorbed key k iff used AND 900000<=value<910000 AND
//     value-900000==k.
//
// Memory layout: header as in H3 (0..52); pool 2112 (32x16); touch
// side table 2624 (32x4); released flags 2752 (32x4); release trace
// 2880 (32x24: slot,key,old_value,reason,episode,claimed_new_value);
// true revision log 3648 (16x16: key,old,new,reason).
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via
// one preallocated buffer plus a single _zag_raw_syscall write; if
// nesting at most 3; no negated conjunctions in while conditions.

// ---------- cell helpers (verbatim H3) ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall (verbatim H3) ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout (verbatim H3) ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
fn tget(M:[]u8,s:i32)i32 { return ig(M,2624+s*4); }
fn stamp(M:[]u8,s:i32)void {
  let c:i32=ig(M,36)+1;
  put32(M,36,c);
  put32(M,2624+s*4,c);
  return;
}

// ---------- policy-8 relocation (verbatim H3 pol-8 branch) ----------
fn relocate8(M:[]u8,so:i32)void {
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,key); put32(M,oo+4,vv);
      put32(M,oo+8,vo); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  // Pool full: PIN-UNPIN reclaims the used slot with the oldest
  // release stamp (ties: lowest slot); drop++ if none released.
  let best:i32=-1;
  let bestr:i32=0;
  s=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let used:i32=0;
    if(ig(M,oo+12)==1){used=1;}
    let rs:i32=ig(M,2752+s*4);
    let cand:i32=0;
    if(used==1){ if(rs!=0){ cand=1; } }
    if(cand==1){
      let take:i32=0;
      if(best==-1){take=1;}
      if(best!=-1 && rs<bestr){take=1;}
      if(take==1){best=s;bestr=rs;}
    }
    s=s+1;
  }
  if(best!=-1){
    let bo:i32=soff(2112,best);
    put32(M,8,ig(M,8)+1);
    put32(M,bo,key); put32(M,bo+4,vv);
    put32(M,bo+8,vo); put32(M,bo+12,1);
    put32(M,2752+best*4,0);
    stamp(M,best);
    return;
  }
  put32(M,28,ig(M,28)+1);
  return;
}

// ---------- mem ops (verbatim H3; relocate callee is relocate8) ----------
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      put32(M,4,ig(M,4)+1);
      relocate8(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){stamp(M,o);return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- learner: belief lifecycle (H3 verbatim unless noted) ----------
fn lholds(k:i32)i32 {
  if(k>=5001 && k<=5012){return 1;}
  if(k>=2001 && k<=2005){return 1;}
  if(k>=1011 && k<=1103){
    let q:i32=(k-1000)/10;
    let r:i32=(k-1000)%10;
    if(q>=1 && q<=10 && r>=1 && r<=3){return 1;}
  }
  return 0;
}
// revision log entry: 16 bytes (key, old_value, new_value, reason)
// (frozen delta 1: was 12 bytes, no reason field).
fn log_find(B:[]u8,lb:i32,n:i32,key:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(ig(B,lb+i*16)==key){return i;}
    i=i+1;
  }
  return -1;
}
fn learner_scratch(M:[]u8)void {
  let i:i32=1;
  while(i<=12){
    mem_write(M,5000+i,600000+i,1);
    i=i+1;
  }
  return;
}
// learner_revise with a reason vector RB (8 i32s, index i-1 for key
// 5000+i). (frozen delta 2.)
fn learner_revise_r(M:[]u8,RB:[]u8)void {
  let i:i32=1;
  while(i<=8){
    let k:i32=5000+i;
    mem_write(M,k,700000+i,1);
    let c:i32=ig(M,52);
    put32(M,3648+c*16,k);
    put32(M,3648+c*16+4,600000+i);
    put32(M,3648+c*16+8,700000+i);
    put32(M,3648+c*16+12,ig(RB,(i-1)*4));
    put32(M,52,c+1);
    i=i+1;
  }
  return;
}
// The single release authority (verbatim H3; reason already a param).
fn learner_unpin(M:[]u8,s:i32,reason:i32,ep:i32,claimed:i32)void {
  let oo:i32=soff(2112,s);
  let rc:i32=ig(M,40)+1;
  put32(M,40,rc);
  put32(M,2752+s*4,rc);
  let tc:i32=ig(M,48);
  let tb:i32=2880+tc*24;
  put32(M,tb,s);
  put32(M,tb+4,ig(M,oo));
  put32(M,tb+8,ig(M,oo+4));
  put32(M,tb+12,reason);
  put32(M,tb+16,ep);
  put32(M,tb+20,claimed);
  put32(M,48,tc+1);
  put32(M,44,ig(M,44)+1);
  return;
}
// has_live_ref: 1 iff some used pool slot references key k under the
// frozen reference pattern (900000<=value<910000, value-900000==k).
fn has_live_ref(M:[]u8,k:i32)i32 {
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let used:i32=0;
    if(ig(M,oo+12)==1){used=1;}
    let v:i32=ig(M,oo+4);
    let isref:i32=0;
    if(v>=900000){ if(v<910000){ isref=1; } }
    let hit:i32=0;
    if(used==1){ if(isref==1){ if(v-900000==k){ hit=1; } } }
    if(hit==1){return 1;}
    s=s+1;
  }
  return 0;
}
// Extended consolidate. guard=0: the H3 gate verbatim, reason-agnostic
// (reason read from the log and passed to the trace verbatim).
// guard=1: reason==2 entries additionally require no live reference
// (frozen deltas 2+3).
fn learner_consolidate_g(M:[]u8,LB:[]u8,lb:i32,n:i32,verify:i32,guard:i32)void {
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let k:i32=ig(M,oo);
    let v:i32=ig(M,oo+4);
    let cand:i32=0;
    if(ig(M,oo+12)==1){ if(lholds(k)==1){ cand=1; } }
    let li:i32=-1;
    if(cand==1){ li=log_find(LB,lb,n,k); }
    let lok:i32=0;
    if(li>=0){ lok=1; }
    let oldv:i32=0;
    let newv:i32=0;
    let rsn:i32=0;
    if(lok==1){
      oldv=ig(LB,lb+li*16+4);
      newv=ig(LB,lb+li*16+8);
      rsn=ig(LB,lb+li*16+12);
    }
    let match:i32=0;
    if(lok==1){ if(oldv==v){ match=1; } }
    let rel:i32=0;
    let cn:i32=0;
    if(match==1){
      if(verify==0){ rel=1; cn=newv; }
      if(verify==1){
        let b:i32=mem_read(M,k,15);
        cn=b;
        if(b!=v){ rel=1; }
      }
    }
    let blocked:i32=0;
    if(guard==1){ if(rsn==2){ if(has_live_ref(M,k)==1){ blocked=1; } } }
    if(rel==1){ if(blocked==0){ learner_unpin(M,s,rsn,4,cn); } }
    s=s+1;
  }
  return;
}
// Audit (verbatim H3 logic; stride 16 for the reason field).
fn audit_releases(M:[]u8)i32 {
  let valid:i32=0;
  let invalid:i32=0;
  let tc:i32=ig(M,48);
  let lc:i32=ig(M,52);
  let t:i32=0;
  while(t<tc){
    let tb:i32=2880+t*24;
    let k:i32=ig(M,tb+4);
    let li:i32=log_find(M,3648,lc,k);
    let ok:i32=0;
    if(li>=0){
      let lo_old:i32=ig(M,3648+li*16+4);
      let lo_new:i32=ig(M,3648+li*16+8);
      if(lo_old==ig(M,tb+8)){
        let b:i32=mem_read(M,k,15);
        if(b==lo_new){ ok=1; }
      }
    }
    if(ok==1){valid=valid+1;}
    if(ok==0){invalid=invalid+1;}
    t=t+1;
  }
  return valid*64+invalid;
}
// Releases whose key is an A key (verbatim H3).
fn count_a_released(M:[]u8)i32 {
  let ar:i32=0;
  let tc:i32=ig(M,48);
  let t:i32=0;
  while(t<tc){
    if(ig(M,2880+t*24+4)<5000){ar=ar+1;}
    t=t+1;
  }
  return ar;
}
// hazard: released entries still referenced by a live pooled entry.
fn count_hazard(M:[]u8)i32 {
  let hz:i32=0;
  let tc:i32=ig(M,48);
  let t:i32=0;
  while(t<tc){
    let k:i32=ig(M,2880+t*24+4);
    if(has_live_ref(M,k)==1){hz=hz+1;}
    t=t+1;
  }
  return hz;
}
// learner_check (verbatim H3).
fn learner_check(M:[]u8,revised:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=12){
    let exp:i32=600000+i;
    if(i<=revised){exp=700000+i;}
    if(mem_read(M,5000+i,1)==exp){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
// install_composite: harness installs a composite entry directly into
// the first free pool slot (no mem_write, no conflicts).
fn install_composite(M:[]u8,ckey:i32,cval:i32)void {
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,ckey); put32(M,oo+4,cval);
      put32(M,oo+8,1); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  return;
}

// ---------- condition runner ----------
// rsnmode: 0=all1, 1=all2, 2=all3, 3=mixed[1,1,1,2,2,2,3,3]
// compmode: 0=none, 1=copies, 2=refs to 5001..5008, 3=refs to 6001..6008
// R layout per row (40-byte stride): 0 cf, 4 ev, 8 drop, 12 releases,
// 16 av, 20 ai, 24 ar, 28 lc, 32 hazard, 36 trspack.
fn run_rsn(M:[]u8,OB:[]u8,tag:[]u8,R:[]u8,ro:i32,rsnmode:i32,compmode:i32,guard:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,8);
  put32(M,32,16);
  learner_scratch(M);
  let RB:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<8){
    let r:i32=1;
    if(rsnmode==1){r=2;}
    if(rsnmode==2){r=3;}
    if(rsnmode==3){
      r=1;
      if(i>=3){r=2;}
      if(i>=6){r=3;}
    }
    put32(RB,i*4,r);
    i=i+1;
  }
  learner_revise_r(M,RB);
  if(compmode==1){
    i=1;
    while(i<=8){ install_composite(M,8000+i,600000+i); i=i+1; }
  }
  if(compmode==2){
    i=1;
    while(i<=8){ install_composite(M,8000+i,900000+5000+i); i=i+1; }
  }
  if(compmode==3){
    i=1;
    while(i<=8){ install_composite(M,8000+i,900000+6000+i); i=i+1; }
  }
  learner_consolidate_g(M,M,3648,ig(M,52),1,guard);
  let packed:i32=audit_releases(M);
  let av:i32=packed/64;
  let ai:i32=packed%64;
  let ar:i32=count_a_released(M);
  let rel:i32=ig(M,44);
  let hz:i32=count_hazard(M);
  let lc:i32=learner_check(M,8);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let tp:i32=0;
  let t:i32=0;
  while(t<rel){
    tp=tp*10+ig(M,2880+t*24+12);
    t=t+1;
  }
  put32(R,ro,cf); put32(R,ro+4,ev); put32(R,ro+8,dr);
  put32(R,ro+12,rel); put32(R,ro+16,av); put32(R,ro+20,ai);
  put32(R,ro+24,ar); put32(R,ro+28,lc); put32(R,ro+32,hz);
  put32(R,ro+36,tp);
  e1s(OB,tag);
  e1s(OB," cf="); e1i(OB,cf as i64);
  e1s(OB," ev="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," releases="); e1i(OB,rel as i64);
  e1s(OB," audit_valid="); e1i(OB,av as i64);
  e1s(OB," audit_invalid="); e1i(OB,ai as i64);
  e1s(OB," a_released="); e1i(OB,ar as i64);
  e1s(OB," lcheck="); e1i(OB,lc as i64);
  e1s(OB," hazard="); e1i(OB,hz as i64);
  e1s(OB," trs=");
  if(rel==0){ e1s(OB,"-"); }
  t=0;
  while(t<rel){
    e1i(OB,ig(M,2880+t*24+12) as i64);
    t=t+1;
  }
  e1s(OB,"\n");
  return;
}

// ---------- importance-source demo ----------
// keys 101 A (causal), 102 B (incidental, 10 touches), 103 C, 104 D.
// sig 0 = learner-attributed weights (10,1,1,1);
// sig 1 = touch-observed weights (1,10,0,0).
// Eviction order = ascending (weight, then lowest key).
fn wgt(sig:i32,idx:i32)i32 {
  if(sig==0){
    if(idx==0){return 10;}
    return 1;
  }
  if(idx==1){return 10;}
  if(idx==0){return 1;}
  return 0;
}
fn imp_demo(OB:[]u8,R:[]u8,ro:i32)void {
  let sig:i32=0;
  while(sig<2){
    let done0:i32=0; let done1:i32=0; let done2:i32=0; let done3:i32=0;
    let r:i32=0;
    while(r<4){
      let bk:i32=-1; let bw:i32=0;
      let idx:i32=0;
      while(idx<4){
        let isdone:i32=0;
        if(idx==0){isdone=done0;}
        if(idx==1){isdone=done1;}
        if(idx==2){isdone=done2;}
        if(idx==3){isdone=done3;}
        if(isdone==0){
          let w:i32=wgt(sig,idx);
          let take:i32=0;
          if(bk==-1){take=1;}
          if(bk!=-1){ if(w<bw){take=1;} }
          if(take==1){bk=101+idx;bw=w;}
        }
        idx=idx+1;
      }
      if(bk==101){done0=1;}
      if(bk==102){done1=1;}
      if(bk==103){done2=1;}
      if(bk==104){done3=1;}
      put32(R,ro+sig*16+r*4,bk);
      r=r+1;
    }
    sig=sig+1;
  }
  e1s(OB,"IMP-LEARN order=");
  e1i(OB,ig(R,ro) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+4) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+8) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+12) as i64); e1s(OB,"\n");
  e1s(OB,"IMP-TOUCH order=");
  e1i(OB,ig(R,ro+16) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+20) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+24) as i64); e1s(OB," ");
  e1i(OB,ig(R,ro+28) as i64); e1s(OB,"\n");
  return;
}

fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(16384);
  put32(OB,0,0);
  let R:[]u8=z_alloc(2048);
  e1s(OB,"LANE=H3-INCORPORATED\n");
  run_rsn(M,OB,"COND=RSN-REVISED",R,0,0,0,0);
  run_rsn(M,OB,"COND=RSN-SUPERSEDED",R,40,2,0,0);
  run_rsn(M,OB,"COND=RSN-INCORPORATED",R,80,1,1,0);
  run_rsn(M,OB,"COND=RSN-MIXED",R,120,3,0,0);
  run_rsn(M,OB,"COND=RSN-INCREF",R,160,1,2,0);
  run_rsn(M,OB,"COND=RSN-INCREF-GUARD",R,200,1,2,1);
  run_rsn(M,OB,"COND=RSN-REVGUARD",R,240,0,3,1);
  imp_demo(OB,R,280);
  // R1 REASON-AGNOSTIC-SUP: row1 == row0 (cols 0..32), trs 33333333
  let r1:i32=1;
  let c:i32=0;
  while(c<9){
    if(ig(R,40+c*4)!=ig(R,c*4)){r1=0;}
    c=c+1;
  }
  if(ig(R,36)!=11111111){r1=0;}
  if(ig(R,76)!=33333333){r1=0;}
  e1s(OB,"R1 REASON-AGNOSTIC-SUP -> "); e1s(OB,pf(r1)); e1s(OB,"\n");
  // R2 REASON-AGNOSTIC-INC: row2 == row0 (cols 0..32), trs 22222222
  let r2:i32=1;
  c=0;
  while(c<9){
    if(ig(R,80+c*4)!=ig(R,c*4)){r2=0;}
    c=c+1;
  }
  if(ig(R,116)!=22222222){r2=0;}
  e1s(OB,"R2 REASON-AGNOSTIC-INC -> "); e1s(OB,pf(r2)); e1s(OB,"\n");
  // R3 MIXED-TRACE
  let r3:i32=1;
  if(ig(R,132)!=8){r3=0;}
  if(ig(R,136)!=8){r3=0;}
  if(ig(R,140)!=0){r3=0;}
  if(ig(R,152)!=0){r3=0;}
  if(ig(R,156)!=11122233){r3=0;}
  e1s(OB,"R3 MIXED-TRACE -> "); e1s(OB,pf(r3)); e1s(OB,"\n");
  // R4 INCORPORATED-HAZARD
  let r4:i32=1;
  if(ig(R,172)!=8){r4=0;}
  if(ig(R,176)!=8){r4=0;}
  if(ig(R,192)!=8){r4=0;}
  e1s(OB,"R4 INCORPORATED-HAZARD -> "); e1s(OB,pf(r4)); e1s(OB,"\n");
  // R5 GUARD-BLOCKS
  let r5:i32=1;
  if(ig(R,212)!=0){r5=0;}
  if(ig(R,232)!=0){r5=0;}
  if(ig(R,216)!=0){r5=0;}
  if(ig(R,220)!=0){r5=0;}
  if(ig(R,228)!=12){r5=0;}
  if(ig(R,200)!=8){r5=0;}
  e1s(OB,"R5 GUARD-BLOCKS -> "); e1s(OB,pf(r5)); e1s(OB,"\n");
  // R6 GUARD-REASON-SPECIFIC
  let r6:i32=1;
  if(ig(R,252)!=8){r6=0;}
  if(ig(R,272)!=0){r6=0;}
  if(ig(R,256)!=8){r6=0;}
  e1s(OB,"R6 GUARD-REASON-SPECIFIC -> "); e1s(OB,pf(r6)); e1s(OB,"\n");
  // R7 IMPORTANCE-SOURCE
  let r7:i32=1;
  if(ig(R,280)!=102 || ig(R,284)!=103 || ig(R,288)!=104 || ig(R,292)!=101){r7=0;}
  if(ig(R,296)!=103 || ig(R,300)!=104 || ig(R,304)!=101 || ig(R,308)!=102){r7=0;}
  e1s(OB,"R7 IMPORTANCE-SOURCE -> "); e1s(OB,pf(r7)); e1s(OB,"\n");
  // R9 CLEAN: ai=0, ar=0, lc=12, av==releases for all 7 rows
  let r9:i32=1;
  let rr:i32=0;
  while(rr<7){
    let bo:i32=rr*40;
    if(ig(R,bo+20)!=0){r9=0;}
    if(ig(R,bo+24)!=0){r9=0;}
    if(ig(R,bo+28)!=12){r9=0;}
    if(ig(R,bo+16)!=ig(R,bo+12)){r9=0;}
    rr=rr+1;
  }
  e1s(OB,"R9 CLEAN -> "); e1s(OB,pf(r9)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

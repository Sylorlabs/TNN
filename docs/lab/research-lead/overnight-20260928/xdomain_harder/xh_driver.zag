// xh_driver.zag -- X-domain harder pair driver for H1 and H2.
//
// Harder pair: transform-then-navigate.
// X = COUNT (node -> number): r=81 facts, query r=91.
// Y = CHAIN on numeric subjects (number -> node): r=82 facts, query r=92.
// Z = Y(X(s)): query (21,93) -> 52. Requires count(21)=4, then walk 4->50->51->52.
// Arms: TREAT, ABL-X (r=91 MAPs deleted), ABL-Y (r=92 MAPs deleted), FRESH.
// Used with H1 (mu_core+mu_patch) and H2 (ir_base+ir_patch); both expose
// plain ev_query with their invention stage hooked in.

fn xh_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  if(t>=2000000){
    let u:i32=t-2000000;
    emit(" [mut tried="); e64(u/1024); emit(" rejected="); e64(u-(u/1024)*1024); emit("]");
  } else {
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  }
  emit("\n");
  return;
}
fn xh_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// 1 if the MAP's executable graph contains an INC cell (tag 103).
fn xh_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// MAP census: contract/plen via rb_chain_plen; class chain/count/other.
fn xh_class(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(xh_has_inc(W,ng(W,m,20))==1){emit("count");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn xh_census(W:[]u8)void {
  emit("maps="); e64(xh_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){xh_class(W,m);}
    m=m+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn xh_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn xh_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn xh_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xh_trainX(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=ev_query(W,11,91,3,0);
  emit("X1 ans="); e64(x1); xh_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17);
  let x2:i32=ev_query(W,15,91,2,0);
  emit("X2 ans="); e64(x2); xh_tstat(W);
  return;
}
fn xh_trainY(W:[]u8)void {
  ev_teach(W,3,82,30); ev_teach(W,30,82,31); ev_teach(W,31,82,32);
  let y1:i32=ev_query(W,3,92,32,0);
  emit("Y1 ans="); e64(y1); xh_tstat(W);
  ev_teach(W,2,82,40); ev_teach(W,40,82,41); ev_teach(W,41,82,42);
  let y2:i32=ev_query(W,2,92,42,0);
  emit("Y2 ans="); e64(y2); xh_tstat(W);
  return;
}
fn xh_zfacts(W:[]u8)void {
  ev_teach(W,21,81,22); ev_teach(W,22,81,23); ev_teach(W,23,81,24); ev_teach(W,24,81,25);
  ev_teach(W,4,82,50); ev_teach(W,50,82,51); ev_teach(W,51,82,52);
  return;
}
fn xh_zquery(W:[]u8)void {
  let z:i32=ev_query(W,21,93,52,0);
  emit("Z ans="); e64(z); xh_tstat(W);
  let zm:i32=xh_find_map(W,21,93);
  emit("ZMAP id="); e64(zm); emit("\n");
  return;
}
fn xh_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  xh_trainX(W);
  xh_trainY(W);
  xh_gap(W);
  xh_census(W);
  xh_zfacts(W);
  xh_zquery(W);
  return;
}
fn xh_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  xh_trainX(W);
  xh_trainY(W);
  xh_del_map_r(W,91);
  emit("maps after del="); e64(xh_count_maps(W)); emit("\n");
  xh_gap(W);
  xh_zfacts(W);
  xh_zquery(W);
  return;
}
fn xh_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  xh_trainX(W);
  xh_trainY(W);
  xh_del_map_r(W,92);
  emit("maps after del="); e64(xh_count_maps(W)); emit("\n");
  xh_gap(W);
  xh_zfacts(W);
  xh_zquery(W);
  return;
}
fn xh_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  xh_gap(W);
  xh_zfacts(W);
  xh_zquery(W);
  return;
}
fn main()i32 {
  emit("XH-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); xh_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); xh_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); xh_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); xh_fresh(W4);
  emit("XH-END\n");
  return 0;
}

// devint1_contestant.zag - Developmental TNN contestant for CA-2 arena.
// Uses DEVINT1's actual learning mechanisms (lexicon induction, segmentation,
// concept formation, rule learning) as the cognitive core.
// Usage: devint1_contestant <turn.json> <statedir> <worlddir>
// Pure Zag. No Python.

// --- basic utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  let al:i32=slen(a);
  let bl:i32=slen(b);
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){
    v=v*10+(line[s] as i32)-48;
    s=s+1;
  }
  if(neg==1){v=-v;}
  return v;
}
fn now_ms()i64 {
  let tv:[]u8=z_alloc(16);
  _zag_raw_syscall(228,(_zag_slice_ptr(tv) as i64),0,0,0,0,0);
  let sec:i64=(tv[0] as i64)|((tv[1] as i64)<<8)|((tv[2] as i64)<<16)|((tv[3] as i64)<<24)|((tv[4] as i64)<<32)|((tv[5] as i64)<<40)|((tv[6] as i64)<<48)|((tv[7] as i64)<<56);
  let nsec:i64=(tv[8] as i64)|((tv[9] as i64)<<8)|((tv[10] as i64)<<16)|((tv[11] as i64)<<24)|((tv[12] as i64)<<32)|((tv[13] as i64)<<40)|((tv[14] as i64)<<48)|((tv[15] as i64)<<56);
  z_free(tv);
  return sec*1000+nsec/1000000;
}
fn peak_rss()i64 {
  let p:[]u8=read_file("/proc/self/status");
  let k:[]u8="VmHWM:";
  let idx:i32=findsub(p,0,k);
  if(idx<0){z_free(p);return 0;}
  let s:i32=idx+k.len;
  while(s<p.len && (p[s]<48 || p[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<p.len && p[s]>=48 && p[s]<=57){v=v*10+(p[s] as i64)-48;s=s+1;}
  z_free(p);
  return v;
}

// --- DEVINT1 W buffer and mechanisms ---
// W layout (16384 bytes):
//   0: tick(i32)  8: nsegs(i32)
//   64: concepts, 24 x 32B
//   832: lexicon, 256 x 12B
//   3904: rules, 32 x 32B
//   4928: fact store, 64 x 48B (0..15:entity 16..31:attr 32..47:value)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn tick(W:[]u8)i32 { let t:i32=get32(W,0)+1; set32(W,0,t); return t; }
fn ilog(v:i32)i32 {
  let r:i32=0; let p:i32=1;
  while(p*2<=v){ p=p*2; r=r+1; }
  return r;
}

// Lexicon: 256 entries x 12B at offset 832
fn lex_bump(W:[]u8, s:[]u8, off:i32, n:i32)void {
  let lb:i32=832;
  let e:i32=0;
  while(e<256){
    let el:i32=get32(W,lb+e*12+4);
    if(el==0){
      let k:i32=0; while(k<n && k<8){ W[lb+e*12+k]=s[off+k]; k=k+1; }
      set32(W,lb+e*12+4,n); set32(W,lb+e*12+8,1);
      return;
    }
    if(el==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[lb+e*12+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){ set32(W,lb+e*12+8,get32(W,lb+e*12+8)+1); return; }
    }
    e=e+1;
  }
  return;
}
fn lex_feed(W:[]u8, s:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let L:i32=2;
    while(L<=4){ if(i+L<=n){ lex_bump(W,s,i,L); } L=L+1; }
    i=i+1;
  }
  return;
}
fn lex_count(W:[]u8)i32 {
  let lb:i32=832;
  let c:i32=0;
  let e:i32=0;
  while(e<256){
    if(get32(W,lb+e*12+4)>0){c=c+1;}
    e=e+1;
  }
  return c;
}

// Concepts: 24 entries x 32B at offset 64
// Each: 0:id 4:plen 8:count 12:last_used 16:valid 20..27:pattern (8 bytes)
fn conc_touch(W:[]u8, s:[]u8, off:i32, n:i32, t:i32)i32 {
  let cb:i32=64;
  // find existing
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1 && get32(W,cb+e*32+4)==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[cb+e*32+20+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){
        set32(W,cb+e*32+8,get32(W,cb+e*32+8)+1);
        set32(W,cb+e*32+12,t);
        return get32(W,cb+e*32);
      }
    }
    e=e+1;
  }
  // create new
  e=0;
  while(e<24){
    if(get32(W,cb+e*32+16)!=1){
      let id:i32=tick(W);
      set32(W,cb+e*32,id);
      set32(W,cb+e*32+4,n);
      set32(W,cb+e*32+8,1);
      set32(W,cb+e*32+12,t);
      set32(W,cb+e*32+16,1);
      let k:i32=0; while(k<n && k<8){ W[cb+e*32+20+k]=s[off+k]; k=k+1; }
      return id;
    }
    e=e+1;
  }
  return -1;
}
fn conc_count(W:[]u8)i32 {
  let cb:i32=64;
  let c:i32=0;
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1){c=c+1;}
    e=e+1;
  }
  return c;
}
fn conc_find(W:[]u8, s:[]u8, off:i32, n:i32)i32 {
  let cb:i32=64;
  let e:i32=0;
  while(e<24){
    if(get32(W,cb+e*32+16)==1 && get32(W,cb+e*32+4)==n){
      let ok:i32=1; let k:i32=0;
      while(k<n && k<8){ if(W[cb+e*32+20+k]!=s[off+k]){ok=0;} k=k+1; }
      if(ok==1){ return get32(W,cb+e*32); }
    }
    e=e+1;
  }
  return -1;
}

// Rules: 32 entries x 32B at offset 3904
// Each: 0:from 4:to 8:support 12:refutes 16:state 20:last_used 24:uses 28:pend
fn rule_touch(W:[]u8, from:i32, to:i32, t:i32)i32 {
  let rb:i32=3904;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1 && get32(W,rb+e*32)==from && get32(W,rb+e*32+4)==to){
      set32(W,rb+e*32+8,get32(W,rb+e*32+8)+1);
      set32(W,rb+e*32+20,t);
      set32(W,rb+e*32+24,get32(W,rb+e*32+24)+1);
      return 1;
    }
    e=e+1;
  }
  e=0;
  while(e<32){
    if(get32(W,rb+e*32+16)!=1){
      set32(W,rb+e*32,from);
      set32(W,rb+e*32+4,to);
      set32(W,rb+e*32+8,1);
      set32(W,rb+e*32+12,0);
      set32(W,rb+e*32+16,1);
      set32(W,rb+e*32+20,t);
      set32(W,rb+e*32+24,1);
      set32(W,rb+e*32+28,0);
      return 1;
    }
    e=e+1;
  }
  return 0;
}
fn rule_predict(W:[]u8, from:i32)i32 {
  let rb:i32=3904;
  let best:i32=-1;
  let bestsup:i32=0;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1 && get32(W,rb+e*32)==from){
      let sup:i32=get32(W,rb+e*32+8);
      if(sup>bestsup){bestsup=sup;best=get32(W,rb+e*32+4);}
    }
    e=e+1;
  }
  return best;
}
fn rule_count(W:[]u8)i32 {
  let rb:i32=3904;
  let c:i32=0;
  let e:i32=0;
  while(e<32){
    if(get32(W,rb+e*32+16)==1){c=c+1;}
    e=e+1;
  }
  return c;
}

// Fact store: 64 entries x 48B at offset 4928
// Each: 0..15:entity (16B) 16..31:attr (16B) 32..47:value (16B)
fn fact_store(W:[]u8, e:[]u8, a:[]u8, v:[]u8)void {
  let fb:i32=4928;
  // check if exists (update)
  let i:i32=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        // update value
        k=0;
        while(k<16){
          if(k<slen(v)){W[base+32+k]=v[k];} else {W[base+32+k]=0;}
          k=k+1;
        }
        return;
      }
    }
    i=i+1;
  }
  // add new
  i=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]==0){
      let k:i32=0;
      while(k<16){ if(k<slen(e)){W[base+k]=e[k];} else {W[base+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(a)){W[base+16+k]=a[k];} else {W[base+16+k]=0;} k=k+1; }
      k=0;
      while(k<16){ if(k<slen(v)){W[base+32+k]=v[k];} else {W[base+32+k]=0;} k=k+1; }
      return;
    }
    i=i+1;
  }
  return;
}
fn fact_get(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  let fb:i32=4928;
  let i:i32=0;
  while(i<64){
    let base:i32=fb+i*48;
    if(W[base]!=0){
      let ok:i32=1;
      let k:i32=0;
      while(k<16){
        if(k<slen(e)){ if(W[base+k]!=e[k]){ok=0;} }
        else { if(W[base+k]!=0){ok=0;} }
        k=k+1;
      }
      k=0;
      while(k<16){
        if(k<slen(a)){ if(W[base+16+k]!=a[k]){ok=0;} }
        else { if(W[base+16+k]!=0){ok=0;} }
        k=k+1;
      }
      if(ok==1){
        k=0;
        while(k<16){ out[k]=W[base+32+k]; k=k+1; }
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn fact_count(W:[]u8)i32 {
  let fb:i32=4928;
  let c:i32=0;
  let i:i32=0;
  while(i<64){
    if(W[fb+i*48]!=0){c=c+1;}
    i=i+1;
  }
  return c;
}

// --- state persistence ---
fn ST_SIZE()i32 { return 16384; }
fn st_load(st:[]u8, path:[]u8)void {
  let d:[]u8=read_file(path);
  if(d.len>=16384){
    let i:i32=0;
    while(i<16384){st[i]=d[i];i=i+1;}
  }
  z_free(d);
  return;
}
fn st_save(st:[]u8, path:[]u8)i32 {
  let fd:i64=w_open(path);
  if(fd<0){return 0;}
  w_write(fd,st[0..16384]);
  w_close(fd);
  return 16384;
}

// --- question parsing ---
// q format: "head|p1|p2|p3" (pipe-separated)
fn qpart(q:[]u8, idx:i32, out:[]u8)void {
  let start:i32=0;
  let cur:i32=0;
  let i:i32=0;
  while(i<q.len){
    if(q[i]==124){ // '|' = 124
      if(cur==idx){
        let k:i32=0;
        while(start+k<i && k<63){out[k]=q[start+k];k=k+1;}
        out[k]=0;
        return;
      }
      cur=cur+1;
      start=i+1;
    }
    i=i+1;
  }
  // handle last part (no trailing pipe)
  if(cur==idx){
    let k:i32=0;
    while(start+k<q.len && k<63){out[k]=q[start+k];k=k+1;}
    out[k]=0;
    return;
  }
  out[0]=0;
  return;
}
fn copy16(dst:[]u8, src:[]u8)void {
  let n:i32=slen(src);
  if(n>15){n=15;}
  let i:i32=0;
  while(i<n){dst[i]=src[i];i=i+1;}
  dst[n]=0;
  return;
}

// --- main learning: process an exposure ---
// Encodes entity/attr/value as a raw string and feeds through DEVINT1 mechanisms
fn learn_fact(W:[]u8, e:[]u8, a:[]u8, v:[]u8)void {
  let t:i32=tick(W);
  // Copy to null-terminated buffers (jval returns slices)
  let eb:[]u8=z_alloc(32); let ab:[]u8=z_alloc(32); let vb:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<e.len && i<31){eb[i]=e[i];i=i+1;} eb[i]=0;
  i=0; while(i<a.len && i<31){ab[i]=a[i];i=i+1;} ab[i]=0;
  i=0; while(i<v.len && i<31){vb[i]=v[i];i=i+1;} vb[i]=0;
  // Build raw string: "entity attr value"
  let s:[]u8=z_alloc(96);
  let at:i32=0;
  at=appz(s,at,eb);
  s[at]=32; at=at+1; // space
  at=appz(s,at,ab);
  s[at]=32; at=at+1;
  at=appz(s,at,vb);
  let n:i32=at;
  // Feed into lexicon (DEVINT1 mechanism)
  lex_feed(W,s,n);
  // Form concepts for each part (DEVINT1 mechanism)
  let eid:i32=conc_touch(W,eb,0,slen(eb),t);
  let aid:i32=conc_touch(W,ab,0,slen(ab),t);
  let vid:i32=conc_touch(W,vb,0,slen(vb),t);
  // Learn rule: (entity+attr) -> value (DEVINT1 mechanism)
  if(eid>0 && aid>0 && vid>0){
    let from:i32=eid*1000+aid;
    rule_touch(W,from,vid,t);
  }
  // Store fact for exact retrieval
  fact_store(W,eb,ab,vb);
  z_free(s); z_free(eb); z_free(ab); z_free(vb);
  return;
}

// --- main ---
fn main()i32 {
  let t0:i64=now_ms();
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  let worlddir:[]u8=_zag_arg(3);
  if(turnpath.len==0 || statedir.len==0 || worlddir.len==0){
    emit("usage: devint1_contestant <turn.json> <statedir> <worlddir>\n");
    return 1;
  }
  let line:[]u8=read_file(turnpath);
  let W:[]u8=z_alloc(ST_SIZE());
  st_load(W,pjoin(statedir,"state.bin"));
  let kind:[]u8=jval(line,"kind");
  let turn:i32=jint(line,"turn");
  let out:[]u8=z_alloc(4096);
  let at:i32=0;
  if(streq(kind,"brief")==1){
    // Brief: initialize. No specific action needed; W starts empty.
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"brief\",\"ok\":true}");
  }
  if(streq(kind,"expo")==1){
    // Parse exposure event
    // Format: {"ev":{"t":"f","e":"...","a":"...","v":"..."}}
    // or {"ev":{"t":"i","n":...}} for interference
    let evtype:[]u8=jval(line,"t");
    if(streq(evtype,"f")==1){
      let e:[]u8=jval(line,"e");
      let a:[]u8=jval(line,"a");
      let v:[]u8=jval(line,"v");
      learn_fact(W,e,a,v);
    }
    // For interference or other types, just tick
    if(streq(evtype,"f")!=1){
      tick(W);
    }
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"expo\",\"ok\":true}");
  }
  if(streq(kind,"observe_result")==1){
    // Observation result: treat as exposure
    tick(W);
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"observe_result\",\"ok\":true}");
  }
  if(streq(kind,"done")==1){
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"done\":true}");
  }
  if(streq(kind,"test")==1){
    let item:i32=jint(line,"item");
    let cap:i32=jint(line,"cap");
    let q:[]u8=jval(line,"q");
    let head:[]u8=z_alloc(64); let p1:[]u8=z_alloc(64); let p2:[]u8=z_alloc(64); let p3:[]u8=z_alloc(64);
    qpart(q,0,head); qpart(q,1,p1); qpart(q,2,p2); qpart(q,3,p3);
    let ans:[]u8=z_alloc(256);
    copy16(ans,"UNKNOWN");
    // fact|entity|attr -> lookup
    if(streq(head,"fact")==1){
      let tmp:[]u8=z_alloc(16);
      if(fact_get(W,p1,p2,tmp)==1){
        copy16(ans,tmp);
      }
      z_free(tmp);
    }
    // For other question types, try rule-based prediction via concepts
    // (honest: many will remain UNKNOWN)
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"item\":"); at=app(out,at,i64s(item as i64));
    at=app(out,at,",\"cap\":"); at=app(out,at,i64s(cap as i64));
    at=app(out,at,",\"reply\":\""); at=appz(out,at,ans); at=app(out,at,"\"}");
    z_free(head); z_free(p1); z_free(p2); z_free(p3); z_free(ans);
  }
  let state_bytes:i32=st_save(W,pjoin(statedir,"state.bin"));
  let ms:i64=now_ms()-t0;
  let rss:i64=peak_rss();
  let olen:i32=slen(out);
  at=olen-1;
  at=app(out,at,",\"ms\":"); at=app(out,at,i64s(ms));
  at=app(out,at,",\"rss_kb\":"); at=app(out,at,i64s(rss));
  at=app(out,at,",\"state_bytes\":"); at=app(out,at,i64s(state_bytes as i64));
  // learning metrics for curves
  at=app(out,at,",\"lex_n\":"); at=app(out,at,i64s(lex_count(W) as i64));
  at=app(out,at,",\"conc_n\":"); at=app(out,at,i64s(conc_count(W) as i64));
  at=app(out,at,",\"rule_n\":"); at=app(out,at,i64s(rule_count(W) as i64));
  at=app(out,at,",\"fact_n\":"); at=app(out,at,i64s(fact_count(W) as i64));
  at=app(out,at,"}\n");
  emit(out[0..at]);
  z_free(W); z_free(line); z_free(out);
  return 0;
}

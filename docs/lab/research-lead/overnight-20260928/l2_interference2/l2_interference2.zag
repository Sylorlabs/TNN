// l2_interference2.zag -- L2-INTERFERENCE2 follow-up.
// Pool saturation law + adversarial eviction attack on the
// conflict-relocation mechanism from L2-INTERFERENCE (VERDICT=PASS).
// Same A family, same benign FULL writer, same owner-scoped reads.
// New: parameterized overflow pool size (POOLN, header offset 16;
// POOLN==0 disables relocation = mechanism ablation), and a churn
// adversary phase that flushes the circular pool with same-key
// conflicting writes on a B-owned key.
// Protocol per condition: teach A, pre-test, teach B (FULL), churn,
// post-test. See PREREG.md for the frozen design and kill bars.
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
// header: 0 ov_ptr, 4 conflicts, 8 evictions, 12 table_full_errors, 16 pool_size
// primary: 64, 128 slots x 16 bytes (key, val, owners, used)
// overflow: 2112, POOLN slots x 16 bytes (POOLN<=32 fits in 4096)
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val.
      put32(M,4,ig(M,4)+1);
      let pn:i32=ig(M,16);
      if(pn==0){
        // ablation: no relocation, destroy in place
        put32(M,so+4,val); put32(M,so+8,owner);
        return;
      }
      let op:i32=ig(M,0);
      let oo:i32=soff(2112,op);
      if(ig(M,oo+12)==1){put32(M,8,ig(M,8)+1);}
      put32(M,oo,ig(M,so)); put32(M,oo+4,vv);
      put32(M,oo+8,ig(M,so+8)); put32(M,oo+12,1);
      put32(M,0,(op+1)%pn);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- structures ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary: w writes on B-owned fresh key 3999, alternating vals.
// First write allocates; each later write conflicts with the previous and
// relocates a B-owned entry into the pool, evicting the oldest entry.
fn teach_churn(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3999,900001+j,16);
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic, not kill-barred).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// R layout per condition (28 bytes): 0 pre, 4 post, 8 ret, 12 conflicts,
// 16 evict, 20 bacc, 24 rawA
fn run_cond(M:[]u8,OB:[]u8,pool:i32,chw:i32,tag:[]u8,R:[]u8,ro:i32)void {
  mem_zero(M);
  put32(M,16,pool);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  teach_churn(M,chw);
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw);
  e1s(OB,tag);
  e1s(OB," pool="); e1i(OB,pool as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(8192);
  put32(OB,0,0);
  let R:[]u8=z_alloc(512);
  e1s(OB,"LANE=L2-INTERFERENCE2\n");
  run_cond(M,OB,0,0,"COND=POOL0",R,0);
  run_cond(M,OB,4,0,"COND=POOL4",R,28);
  run_cond(M,OB,8,0,"COND=POOL8",R,56);
  run_cond(M,OB,16,0,"COND=POOL16",R,84);
  run_cond(M,OB,32,0,"COND=POOL32",R,112);
  run_cond(M,OB,8,5,"COND=ADV8-5W",R,140);
  run_cond(M,OB,8,9,"COND=ADV8-9W",R,168);
  run_cond(M,OB,32,21,"COND=ADV32-21W",R,196);
  run_cond(M,OB,32,33,"COND=ADV32-33W",R,224);
  // K1 baseline: pre==35 in all 9 conditions
  let k1:i32=1;
  let c:i32=0;
  while(c<9){
    if(ig(R,c*28)!=35){k1=0;}
    c=c+1;
  }
  e1s(OB,"K1 BASELINE pre==35 x9 -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  // K2 capacity: POOL32 ret==100
  let k2:i32=0;
  if(ig(R,120)==100){k2=1;}
  e1s(OB,"K2 CAPACITY pool32 ret="); e1i(OB,ig(R,120) as i64);
  e1s(OB," bar==100 -> "); e1s(OB,pf(k2)); e1s(OB,"\n");
  // K3 predecessor reproduction: POOL8 ret==34, conflicts==20, evict==12
  let k3:i32=0;
  if(ig(R,64)==34 && ig(R,68)==20 && ig(R,72)==12){k3=1;}
  e1s(OB,"K3 REPRO pool8 ret="); e1i(OB,ig(R,64) as i64);
  e1s(OB," cf="); e1i(OB,ig(R,68) as i64);
  e1s(OB," ev="); e1i(OB,ig(R,72) as i64);
  e1s(OB," bars==[34,20,12] -> "); e1s(OB,pf(k3)); e1s(OB,"\n");
  // K4 ablation: POOL0 ret==0
  let k4:i32=0;
  if(ig(R,8)==0){k4=1;}
  e1s(OB,"K4 ABLATION pool0 ret="); e1i(OB,ig(R,8) as i64);
  e1s(OB," bar==0 -> "); e1s(OB,pf(k4)); e1s(OB,"\n");
  // K5 saturation curve: [0,17,34,77,100]
  let k5:i32=0;
  if(ig(R,8)==0 && ig(R,36)==17 && ig(R,64)==34 && ig(R,92)==77 && ig(R,120)==100){k5=1;}
  e1s(OB,"K5 CURVE ret=[");
  e1i(OB,ig(R,8) as i64); e1s(OB,","); e1i(OB,ig(R,36) as i64);
  e1s(OB,","); e1i(OB,ig(R,64) as i64); e1s(OB,","); e1i(OB,ig(R,92) as i64);
  e1s(OB,","); e1i(OB,ig(R,120) as i64);
  e1s(OB,"] need=[0,17,34,77,100] -> "); e1s(OB,pf(k5)); e1s(OB,"\n");
  // K6 adversarial dose-response: pool8 r{0,4,8} -> [34,17,0]; pool32 r{0,20,32} -> [100,54,0]
  let k6:i32=0;
  if(ig(R,64)==34 && ig(R,148)==17 && ig(R,176)==0 && ig(R,120)==100 && ig(R,204)==54 && ig(R,232)==0){k6=1;}
  e1s(OB,"K6 ADVERSARY pool8=[");
  e1i(OB,ig(R,64) as i64); e1s(OB,","); e1i(OB,ig(R,148) as i64);
  e1s(OB,","); e1i(OB,ig(R,176) as i64);
  e1s(OB,"] need=[34,17,0] pool32=[");
  e1i(OB,ig(R,120) as i64); e1s(OB,","); e1i(OB,ig(R,204) as i64);
  e1s(OB,","); e1i(OB,ig(R,232) as i64);
  e1s(OB,"] need=[100,54,0] -> "); e1s(OB,pf(k6)); e1s(OB,"\n");
  e1s(OB,"K7 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1){all=1;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

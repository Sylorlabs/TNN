// gen_verify.zag - Verification attack world generator (A2).
// Generates 5 lying-oracle worlds V1..V5 as turns.jsonl + answers.txt.
// Pure Zag. All constants hardcoded by the attacker; the sealed arena
// seed is never opened.
// Usage: gen_verify <outdir>  (creates <outdir>/v1 .. <outdir>/v5)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn wline(fd:i64, s:[]u8)void { w_write(fd,s); return; }
fn mkdir_p(path:[]u8)void {
  let c:[]u8=z_cstr(path);
  _zag_raw_syscall(83,(_zag_slice_ptr(c) as i64),493,0,0,0,0);
  z_free(c);
  return;
}

// turn writers; buf must hold the line
fn t_brief(fd:i64,buf:[]u8,turn:i32)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"brief\"}\n");
  wline(fd,buf[0..at]); return turn+1;
}
fn t_done(fd:i64,buf:[]u8,turn:i32)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"done\"}\n");
  wline(fd,buf[0..at]); return turn+1;
}
fn t_expof(fd:i64,buf:[]u8,turn:i32,e:[]u8,a:[]u8,v:[]u8)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"f\",\"e\":\"");
  at=app(buf,at,e); at=app(buf,at,"\",\"a\":\""); at=app(buf,at,a);
  at=app(buf,at,"\",\"v\":\""); at=app(buf,at,v); at=app(buf,at,"\"}}\n");
  wline(fd,buf[0..at]); return turn+1;
}
fn t_expor(fd:i64,buf:[]u8,turn:i32,a:[]u8,r:[]u8,b:[]u8)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"");
  at=app(buf,at,a); at=app(buf,at,"\",\"r\":\""); at=app(buf,at,r);
  at=app(buf,at,"\",\"b\":\""); at=app(buf,at,b); at=app(buf,at,"\"}}\n");
  wline(fd,buf[0..at]); return turn+1;
}
fn t_test(fd:i64,afd:i64,abuf:[]u8,buf:[]u8,turn:i32,item:i32,cap:i32,q:[]u8,exp:[]u8)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":"); at=app(buf,at,i64s(item as i64));
  at=app(buf,at,",\"cap\":"); at=app(buf,at,i64s(cap as i64));
  at=app(buf,at,",\"q\":\""); at=app(buf,at,q); at=app(buf,at,"\"}\n");
  wline(fd,buf[0..at]);
  let bt:i32=app(abuf,0,i64s(item as i64));
  bt=app(abuf,bt,"|"); bt=app(abuf,bt,exp); bt=app(abuf,bt,"\n");
  wline(afd,abuf[0..bt]);
  return turn+1;
}
fn t_obs(fd:i64,buf:[]u8,turn:i32,e:[]u8,a:[]u8,v:[]u8)i32 {
  let at:i32=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"observe_result\",\"vals\":[{\"e\":\"");
  at=app(buf,at,e); at=app(buf,at,"\",\"a\":\""); at=app(buf,at,a);
  at=app(buf,at,"\",\"v\":\""); at=app(buf,at,v); at=app(buf,at,"\"}]}\n");
  wline(fd,buf[0..at]); return turn+1;
}

fn gen_v1(dir:[]u8)void {
  mkdir_p(dir);
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(dir,"answers.txt"));
  let buf:[]u8=z_alloc(512); let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  turn=t_brief(tfd,buf,turn);
  turn=t_expof(tfd,buf,turn,"e1","a1","v1");
  turn=t_test(tfd,afd,abuf,buf,turn,0,1,"fact|e1|a1","v1");
  turn=t_test(tfd,afd,abuf,buf,turn,1,8,"fact|u1|b1","UNKNOWN");
  turn=t_obs(tfd,buf,turn,"u1","b1","w1");
  turn=t_test(tfd,afd,abuf,buf,turn,1,8,"fact|u1|b1","w1");
  turn=t_obs(tfd,buf,turn,"u1","b1","w2");
  turn=t_test(tfd,afd,abuf,buf,turn,1,8,"fact|u1|b1","w2");
  turn=t_done(tfd,buf,turn);
  w_close(tfd); w_close(afd); z_free(buf); z_free(abuf);
  emit("v1 written\n"); return;
}
fn gen_v2(dir:[]u8)void {
  mkdir_p(dir);
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(dir,"answers.txt"));
  let buf:[]u8=z_alloc(512); let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  turn=t_brief(tfd,buf,turn);
  turn=t_expof(tfd,buf,turn,"e2","a2","v2");
  turn=t_test(tfd,afd,abuf,buf,turn,0,1,"fact|e2|a2","v2");
  turn=t_obs(tfd,buf,turn,"e2","a2","bogus");
  turn=t_test(tfd,afd,abuf,buf,turn,0,1,"fact|e2|a2","bogus");
  turn=t_done(tfd,buf,turn);
  w_close(tfd); w_close(afd); z_free(buf); z_free(abuf);
  emit("v2 written\n"); return;
}
fn gen_v3(dir:[]u8)void {
  mkdir_p(dir);
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(dir,"answers.txt"));
  let buf:[]u8=z_alloc(512); let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  turn=t_brief(tfd,buf,turn);
  turn=t_test(tfd,afd,abuf,buf,turn,0,8,"fact|u3|b3","UNKNOWN");
  turn=t_obs(tfd,buf,turn,"u3","b3","bogus");
  turn=t_test(tfd,afd,abuf,buf,turn,0,8,"fact|u3|b3","bogus");
  turn=t_expof(tfd,buf,turn,"u3","b3","truev");
  turn=t_test(tfd,afd,abuf,buf,turn,0,8,"fact|u3|b3","truev");
  turn=t_done(tfd,buf,turn);
  w_close(tfd); w_close(afd); z_free(buf); z_free(abuf);
  emit("v3 written\n"); return;
}
fn gen_v4(dir:[]u8)void {
  mkdir_p(dir);
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(dir,"answers.txt"));
  let buf:[]u8=z_alloc(512); let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  turn=t_brief(tfd,buf,turn);
  turn=t_expor(tfd,buf,turn,"A","r1","B");
  turn=t_expor(tfd,buf,turn,"B","r2","C");
  turn=t_test(tfd,afd,abuf,buf,turn,0,4,"hop2|A|r1|r2","C");
  turn=t_expor(tfd,buf,turn,"B","r2","X");
  turn=t_test(tfd,afd,abuf,buf,turn,0,4,"hop2|A|r1|r2","X");
  turn=t_done(tfd,buf,turn);
  w_close(tfd); w_close(afd); z_free(buf); z_free(abuf);
  emit("v4 written\n"); return;
}
fn gen_v5(dir:[]u8)void {
  mkdir_p(dir);
  let tfd:i64=w_open(pjoin(dir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(dir,"answers.txt"));
  let buf:[]u8=z_alloc(512); let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  turn=t_brief(tfd,buf,turn);
  turn=t_test(tfd,afd,abuf,buf,turn,0,8,"fact|u5|b5","UNKNOWN");
  turn=t_obs(tfd,buf,turn,"u5","b5","first");
  turn=t_obs(tfd,buf,turn,"u5","b5","second");
  turn=t_test(tfd,afd,abuf,buf,turn,0,8,"fact|u5|b5","second");
  turn=t_done(tfd,buf,turn);
  w_close(tfd); w_close(afd); z_free(buf); z_free(abuf);
  emit("v5 written\n"); return;
}

fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ emit("usage: gen_verify <outdir>\n"); return 1; }
  mkdir_p(outdir);
  gen_v1(pjoin(outdir,"v1"));
  gen_v2(pjoin(outdir,"v2"));
  gen_v3(pjoin(outdir,"v3"));
  gen_v4(pjoin(outdir,"v4"));
  gen_v5(pjoin(outdir,"v5"));
  emit("all verify worlds written\n");
  return 0;
}

// ddes_revert.zag -- Adaptive intervention planner, law-revert family.
// Pure Zag. No Python.
// Prereg: PREREG_DDES_REVERT.md (committed strictly before this file).
//
// Builds on ddes_multistep.zag (DDES-MULTISTEP-PASS 7871ca6d3). The
// derivation core below is copied verbatim from that file (which copies
// verbatim from the frozen DDES sources 56db8d606, 843c45fee). New:
// time-indexed feed protocol (episodes with early/late passive
// observations), per-episode full-set survivor re-filtering, per-phase
// sealed true blocks, MODE=STATIC (monotonic cross-episode retirement,
// the C1-pathology baseline).
//
// Entry stride 1152. Per entry at base = e*1152:
//   +0 status (0=EMPTY,1=ACTIVE,2=AMBIGUOUS,3=DECLARED-OUTSIDE-SET),
//   +4 winner, +8 n_vars, +12 n_cands, +16 n_phases,
//   +20 candidate blocks k=0..3 (128B each),
//   +532 phase true blocks p=0..3 (128B each),
//   +1044 rounds_total, +1048 episodes_done,
//   +1052 static_mask[4] (i32 flags, STATIC mode),
//   +1068 ep_winner[4], +1084 ep_round[4].
// Rule block layout (unchanged): +0 nr, +4 src[8], +36 dst[8],
// +68 delay[8].

// ============ utils (verbatim from frozen ddes_multistep.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ generic arrival computation (verbatim) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (verbatim, kept for provenance) ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ eff_waits (verbatim) ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (verbatim) ============
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ analytic predictor (verbatim) ============
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ world stepper (verbatim) ============
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ entry layout (new; stride 1152) ============
fn ent_base(e:i32)i32 { return e*1152; }
fn cand_base(e:i32, k:i32)i32 { return e*1152+20+k*128; }
fn true_base(e:i32, p:i32)i32 { return e*1152+532+p*128; }
fn w_get(ws:[]u8, off:i32)i32 { return get32(ws, off); }
fn w_set(ws:[]u8, off:i32, v:i32)void { set32(ws, off, v); return; }
fn blk_nr(ws:[]u8, e:i32, k:i32)i32 { return get32(ws, cand_base(e,k)); }
fn blk_src(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+4..b+36];
}
fn blk_dst(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+36..b+68];
}
fn blk_delay(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+68..b+100];
}
fn set_rule(ws:[]u8, b:i32, i:i32, s:i32, d:i32, w:i32)void {
  set32(ws, b+4+i*4, s);
  set32(ws, b+36+i*4, d);
  set32(ws, b+68+i*4, w);
  return;
}
fn copy_block(ws:[]u8, sb:i32, db:i32)void {
  let i:i32=0;
  while(i<128){ ws[db+i]=ws[sb+i]; i=i+1; }
  return;
}

// ============ n-candidate disagreement frontier (verbatim body) ============
fn frontier_surv(ws:[]u8, e:i32, surv:[]u8, n_cands:i32, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8, out_schema:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let best_s:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let arrs:[]u8=z_alloc(n_cands*n_vars*4);
    let k:i32=0;
    while(k<n_cands){
      if(get32(surv,k*4)==1){
        let lo:i32=k*n_vars*4;
        let hi:i32=lo+n_vars*4;
        compute_arrivals(blk_nr(ws,e,k), blk_src(ws,e,k), blk_dst(ws,e,k), blk_delay(ws,e,k), n_vars, schema, arrs[lo..hi]);
      }
      k=k+1;
    }
    let v:i32=0;
    while(v<n_vars){
      let all_eq:i32=1;
      let mn:i32=INF;
      let first:i32=1;
      let fv:i32=0;
      k=0;
      while(k<n_cands){
        if(get32(surv,k*4)==1){
          let a:i32=get32(arrs,(k*n_vars+v)*4);
          if(first==1){ fv=a; first=0; } else { if(a!=fv){ all_eq=0; } }
          if(a<mn){ mn=a; }
        }
        k=k+1;
      }
      if(first==0 && all_eq==0){
        if(mn<best_t){ best_t=mn; best_v=v; best_s=schema; }
      }
      v=v+1;
    }
    schema=schema-1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
    set32(out_schema, 0, best_s);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ frozen case loaders (new) ============
// e0: P1 unambiguous probe. e1: P2 unambiguous probe.
// e2: M1 (true=h2). e3: M2 (true=h1). e4: A (true=h1).
// e5: R1 change-then-revert (true phases G0,G1,G0).
// e6: R2 change-then-partial-revert (true phases G0,G1,G0p).
// e7: R3 outside-set (true=G3, 1 phase).
fn load_e0(ws:[]u8)void {
  let e:i32=0;
  w_set(ws, ent_base(e)+12, 1);
  w_set(ws, ent_base(e)+16, 1);
  let b:i32=cand_base(e,0);
  set32(ws,b,2);
  set_rule(ws,b,0, 0,2,2);
  set_rule(ws,b,1, 2,1,0);
  copy_block(ws, b, true_base(e,0));
  return;
}
fn load_e1(ws:[]u8)void {
  let e:i32=1;
  w_set(ws, ent_base(e)+12, 1);
  w_set(ws, ent_base(e)+16, 1);
  let b:i32=cand_base(e,0);
  set32(ws,b,1);
  set_rule(ws,b,0, 0,1,3);
  copy_block(ws, b, true_base(e,0));
  return;
}
fn load_e2(ws:[]u8)void {
  let e:i32=2;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,1); set_rule(ws,h1,0, 0,1,2);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,2); set_rule(ws,h2,0, 0,2,2); set_rule(ws,h2,1, 2,1,0);
  copy_block(ws, h2, true_base(e,0));
  return;
}
fn load_e3(ws:[]u8)void {
  let e:i32=3;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,2); set_rule(ws,h2,0, 0,2,2); set_rule(ws,h2,1, 2,1,0);
  copy_block(ws, h1, true_base(e,0));
  return;
}
fn load_e4(ws:[]u8)void {
  let e:i32=4;
  w_set(ws, ent_base(e)+12, 2);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,1); set_rule(ws,h1,0, 0,1,2);
  copy_block(ws, h1, true_base(e,0));
  return;
}
fn load_r1(ws:[]u8)void {
  let e:i32=5;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 3);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,1,2);
  copy_block(ws, h0, true_base(e,0));
  copy_block(ws, h1, true_base(e,1));
  copy_block(ws, h0, true_base(e,2));
  return;
}
fn load_r2(ws:[]u8)void {
  let e:i32=6;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 3);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,1,2);
  copy_block(ws, h0, true_base(e,0));
  copy_block(ws, h1, true_base(e,1));
  copy_block(ws, h2, true_base(e,2));
  return;
}
fn load_r3(ws:[]u8)void {
  let e:i32=7;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,2); set_rule(ws,h0,0, 0,1,1); set_rule(ws,h0,1, 0,2,3);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,1,2); set_rule(ws,h1,1, 0,2,4);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,2,5);
  let t:i32=true_base(e,0);
  set32(ws,t,1); set_rule(ws,t,0, 0,2,1);
  return;
}

fn emit_plan(plan:[]u8, plen:i32)void {
  emit("[");
  let j:i32=0;
  while(j<plen){
    let a:i32=plan[j] as i32;
    if(j>0){ emit(","); }
    if(a==0){ emit("S"); }
    else if(a==1){ emit("W"); }
    else { emit("O("); e64(a-2); emit(")"); }
    j=j+1;
  }
  emit("]");
  return;
}

fn emit_survivors(surv:[]u8, nc:i32)void {
  let k:i32=0;
  let first:i32=1;
  while(k<nc){
    if(get32(surv,k*4)==1){
      if(first==0){ emit(","); }
      emit("h"); e64(k);
      first=0;
    }
    k=k+1;
  }
  return;
}

// Predict with candidate block k.
fn pred_cand(ws:[]u8, e:i32, k:i32, schema:i32, v:i32, t:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let b:i32=cand_base(e,k);
  return predict_gen(get32(ws,b), ws[b+4..b+36], ws[b+36..b+68], ws[b+68..b+100], n_vars, schema, v, t);
}

// Execute one plan against the sealed true block of phase ep.
fn exec_plan_ep(ws:[]u8, e:i32, ep:i32, plan:[]u8, plen:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let b:i32=true_base(e,ep);
  let st:[]u8=z_alloc(n_vars*8+4);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_gen(get32(ws,b), ws[b+4..b+36], ws[b+36..b+68], ws[b+68..b+100], n_vars, st, plan[j] as i32);
    if(o>=0){ real_obs=o; }
    j=j+1;
  }
  return real_obs;
}

// ============ time-indexed episode feed (new) ============
// mode: 0=BASE, 1=ONESHOT, 2=ADAPT, 3=STATIC.
// ADAPT/ONESHOT/BASE re-filter the FULL candidate set per episode.
// STATIC filters its carried cross-episode mask (monotonic retirement).
fn feed_ep(ws:[]u8, e:i32, ep:i32, pv:i32, pt:i32, pout:i32, mode:i32)void {
  w_set(ws, ent_base(e)+8, 3);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let eb:i32=ent_base(e);
  w_set(ws, eb+1068+ep*4, -1);
  w_set(ws, eb+1048, ep+1);
  let k:i32=0;
  if(mode==3 && ep>0){
    k=0;
  } else {
    while(k<nc){ w_set(ws, eb+1052+k*4, 1); k=k+1; }
    k=0;
  }
  while(k<nc){
    if(w_get(ws, eb+1052+k*4)==1){
      if(pred_cand(ws,e,k,1,pv,pt)==pout){ w_set(ws, eb+1052+k*4, 1); }
      else { w_set(ws, eb+1052+k*4, 0); }
    }
    k=k+1;
  }
  let surv:[]u8=z_alloc(nc*4);
  let nsv:i32=0;
  k=0;
  while(k<nc){
    if(w_get(ws, eb+1052+k*4)==1){ set32(surv,k*4,1); nsv=nsv+1; }
    k=k+1;
  }
  emit("FEED e"); e64(e); emit(" P"); e64(ep);
  emit(" passive=("); e64(pv); emit(","); e64(pt); emit(")="); e64(pout);
  emit(" nc="); e64(nc); emit("\n");
  if(nsv==0){
    w_set(ws, eb, 3);
    emit("DECLARE e"); e64(e); emit(" P"); e64(ep); emit(" OUTSIDE-SET\n");
    return;
  }
  if(nsv==1){
    let win:i32=0;
    k=0;
    while(k<nc){ if(w_get(ws, eb+1052+k*4)==1){ win=k; } k=k+1; }
    w_set(ws, eb, 1);
    w_set(ws, eb+4, win);
    w_set(ws, eb+1068+ep*4, win);
    w_set(ws, eb+1084+ep*4, 0);
    if(mode==3){ emit("STATIC e"); e64(e); emit(" P"); e64(ep); }
    else { emit("EP e"); e64(e); emit(" P"); e64(ep); }
    emit(" SINGLE winner=h"); e64(win); emit(" rounds=0\n");
    return;
  }
  w_set(ws, eb, 2);
  emit("EP e"); e64(e); emit(" P"); e64(ep); emit(" AMBIGUOUS survivors=[");
  emit_survivors(surv, nc); emit("]\n");
  if(mode==1){ oneshot_ep(ws,e,ep,surv,nc); }
  else if(mode==2){ adapt_ep(ws,e,ep,surv,nc,0); }
  else if(mode==3){ adapt_ep(ws,e,ep,surv,nc,1); }
  return;
}

// ============ MODE=ONESHOT per episode (new) ============
fn oneshot_ep(ws:[]u8, e:i32, ep:i32, surv:[]u8, nc:i32)void {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let eb:i32=ent_base(e);
  let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
  frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
  if(get32(f,0)==0){
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" NO-DISCRIMINATING-PLAN\n");
    return;
  }
  let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
  emit(" TARGET V*="); e64(bv); emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
  let plans_built:[]u8=z_alloc(4);
  let plan:[]u8=z_alloc(256);
  let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" PLAN ");
  emit_plan(plan, plen); emit(" built="); e64(get32(plans_built,0)); emit("\n");
  let real_obs:i32=exec_plan_ep(ws, e, ep, plan, plen);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" EXEC real="); e64(real_obs); emit("\n");
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" PRED");
  let k:i32=0;
  while(k<nc){
    if(get32(surv,k*4)==1){ emit(" h"); e64(k); emit("="); e64(pred_cand(ws,e,k,bs,bv,bt)); }
    k=k+1;
  }
  emit("\n");
  let nsv:i32=0; let win:i32=-1;
  k=0;
  while(k<nc){
    if(get32(surv,k*4)==1){
      emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
      if(pred_cand(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); nsv=nsv+1; win=k; }
      else { emit(" ELIM h"); e64(k); emit("\n"); }
    }
    k=k+1;
  }
  w_set(ws, eb+1044, w_get(ws, eb+1044)+1);
  if(nsv==1){
    w_set(ws, eb, 1);
    w_set(ws, eb+4, win);
    w_set(ws, eb+1068+ep*4, win);
    w_set(ws, eb+1084+ep*4, 1);
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
    emit(" RESOLVED winner=h"); e64(win); emit(" rounds=1\n");
  } else {
    w_set(ws, eb+1084+ep*4, -1);
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
    emit(" ONESHOT-RESOLVE-FAIL survivors="); e64(nsv); emit("\n");
  }
  return;
}

// ============ MODE=ADAPT/STATIC chaining round loop per episode (new) ============
// writeback=1: eliminations retire permanently in the cross-episode mask.
fn adapt_ep(ws:[]u8, e:i32, ep:i32, surv:[]u8, nc:i32, writeback:i32)void {
  let BUDGET:i32=3;
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let eb:i32=ent_base(e);
  let round:i32=1;
  while(round<=BUDGET){
    let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
    frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
    if(get32(f,0)==0){
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL no-frontier\n");
      return;
    }
    let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" survivors=[");
    emit_survivors(surv, nc);
    emit("] TARGET V*="); e64(bv); emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
    let plans_built:[]u8=z_alloc(4);
    let plan:[]u8=z_alloc(256);
    let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" PLAN ");
    emit_plan(plan, plen); emit(" built="); e64(get32(plans_built,0)); emit("\n");
    let real_obs:i32=exec_plan_ep(ws, e, ep, plan, plen);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" EXEC real="); e64(real_obs); emit("\n");
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" PRED");
    let k:i32=0;
    while(k<nc){
      if(get32(surv,k*4)==1){ emit(" h"); e64(k); emit("="); e64(pred_cand(ws,e,k,bs,bv,bt)); }
      k=k+1;
    }
    emit("\n");
    let prev:i32=0;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ prev=prev+1; } k=k+1; }
    k=0;
    while(k<nc){
      if(get32(surv,k*4)==1){
        if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
        e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round);
        if(pred_cand(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); }
        else {
          emit(" ELIM h"); e64(k); emit("\n");
          set32(surv,k*4,0);
          if(writeback==1){
            w_set(ws, eb+1052+k*4, 0);
            emit("STATIC e"); e64(e); emit(" P"); e64(ep); emit(" RETIRE h"); e64(k); emit("\n");
          }
        }
      }
      k=k+1;
    }
    let nsv:i32=0; let win:i32=-1;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ nsv=nsv+1; win=k; } k=k+1; }
    w_set(ws, eb+1044, w_get(ws, eb+1044)+1);
    w_set(ws, eb+1084+ep*4, round);
    if(nsv==1){
      w_set(ws, eb, 1);
      w_set(ws, eb+4, win);
      w_set(ws, eb+1068+ep*4, win);
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep);
      emit(" RESOLVED winner=h"); e64(win); emit(" rounds="); e64(round); emit("\n");
      return;
    }
    if(nsv==0){
      w_set(ws, eb, 3);
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL world-outside-set\n");
      return;
    }
    if(nsv==prev){
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL no-progress\n");
      return;
    }
    round=round+1;
  }
  if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
  e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL budget\n");
  return;
}

// Query the learner. ACTIVE: predict from the final winner.
// AMBIGUOUS: withhold. DECLARED: withhold (declared outside set).
fn query(ws:[]u8, e:i32, v:i32, t:i32)i32 {
  let st:i32=w_get(ws, ent_base(e));
  emit("Q e"); e64(e); emit(" ("); e64(v); emit(","); e64(t); emit(") -> ");
  if(st==1){
    let w:i32=w_get(ws, ent_base(e)+4);
    let p:i32=pred_cand(ws, e, w, 1, v, t);
    e64(p); emit("\n");
    return p;
  }
  if(st==3){ emit("WITHHOLD (declared-outside-set)\n"); return -2; }
  emit("WITHHOLD (ambiguous)\n");
  return -1;
}

fn zero_ledger(ws:[]u8)void {
  let i:i32=0;
  while(i<8*1152){ ws[i]=0; i=i+1; }
  return;
}

// Count multi-candidate episodes ending with a winner (prereg def. b).
fn count_resolved(ws:[]u8, e:i32, acc:[]u8)void {
  let nph:i32=w_get(ws, ent_base(e)+16);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let ep:i32=0;
  while(ep<nph){
    if(nc>1){
      if(w_get(ws, ent_base(e)+1068+ep*4)>=0){ set32(acc, 0, get32(acc,0)+1); }
    }
    ep=ep+1;
  }
  return;
}

// ============ frozen regression + revert harness ============
// mode: 0=BASE, 1=ONESHOT, 2=ADAPT, 3=STATIC.
fn run_all(ws:[]u8, mode:i32)i32 {
  let ok:i32=0; let total:i32=0;
  let racc:[]u8=z_alloc(4);
  let q:i32=0;
  let st:i32=0; let w:i32=0; let r:i32=0;
  zero_ledger(ws);
  emit("MODE-BEGINS ");
  if(mode==0){ emit("BASE"); }
  else if(mode==1){ emit("ONESHOT"); }
  else if(mode==2){ emit("ADAPT"); }
  else { emit("STATIC"); }
  emit("\n");
  // e0 P1 probe
  load_e0(ws); feed_ep(ws,0,0, 1,2,1, mode);
  q=query(ws,0,1,2); total=total+1; if(q==1){ ok=ok+1; }
  // e1 P2 probe
  load_e1(ws); feed_ep(ws,1,0, 1,2,0, mode);
  q=query(ws,1,1,2); total=total+1; if(q==0){ ok=ok+1; }
  q=query(ws,1,1,3); total=total+1; if(q==1){ ok=ok+1; }
  // e2 M1 (true h2)
  load_e2(ws); feed_ep(ws,2,0, 1,2,1, mode);
  if(mode==0){ q=query(ws,2,1,1); total=total+1; if(q==-1){ ok=ok+1; } }
  else if(mode==1){
    st=w_get(ws,ent_base(2)); total=total+1; if(st==2){ ok=ok+1; }
  }
  else {
    st=w_get(ws,ent_base(2)); w=w_get(ws,ent_base(2)+4); r=w_get(ws,ent_base(2)+1084);
    total=total+1; if(st==1 && w==2 && r==2){ ok=ok+1; }
    q=query(ws,2,1,1); total=total+1; if(q==0){ ok=ok+1; }
    q=query(ws,2,1,2); total=total+1; if(q==1){ ok=ok+1; }
  }
  count_resolved(ws,2,racc);
  // e3 M2 (true h1)
  load_e3(ws); feed_ep(ws,3,0, 1,2,1, mode);
  if(mode==0){ q=query(ws,3,2,1); total=total+1; if(q==-1){ ok=ok+1; } }
  else if(mode==1){
    st=w_get(ws,ent_base(3)); total=total+1; if(st==2){ ok=ok+1; }
  }
  else {
    st=w_get(ws,ent_base(3)); w=w_get(ws,ent_base(3)+4); r=w_get(ws,ent_base(3)+1084);
    total=total+1; if(st==1 && w==1 && r==2){ ok=ok+1; }
    q=query(ws,3,2,1); total=total+1; if(q==1){ ok=ok+1; }
    q=query(ws,3,2,2); total=total+1; if(q==1){ ok=ok+1; }
  }
  count_resolved(ws,3,racc);
  // e4 A (true h1, 1 round)
  load_e4(ws); feed_ep(ws,4,0, 1,2,1, mode);
  if(mode==0){ q=query(ws,4,1,1); total=total+1; if(q==-1){ ok=ok+1; } }
  else {
    st=w_get(ws,ent_base(4)); w=w_get(ws,ent_base(4)+4); r=w_get(ws,ent_base(4)+1084);
    total=total+1; if(st==1 && w==1 && r==1){ ok=ok+1; }
    q=query(ws,4,1,1); total=total+1; if(q==0){ ok=ok+1; }
    q=query(ws,4,1,2); total=total+1; if(q==1){ ok=ok+1; }
  }
  count_resolved(ws,4,racc);
  // e5 R1 change-then-revert (true phases G0,G1,G0)
  load_r1(ws);
  feed_ep(ws,5,0, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(5))==2){ ok=ok+1; } }
  feed_ep(ws,5,1, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(5))==2){ ok=ok+1; } }
  feed_ep(ws,5,2, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(5))==2){ ok=ok+1; } }
  else if(mode==1){
    total=total+1; if(w_get(ws,ent_base(5)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1084+4)==-1){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1068+8)==0){ ok=ok+1; }
  }
  else if(mode==2){
    total=total+1; if(w_get(ws,ent_base(5)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1068+4)==1){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1068+8)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1044)==4){ ok=ok+1; }
    q=query(ws,5,1,1); total=total+1; if(q==1){ ok=ok+1; }
  }
  else {
    total=total+1; if(w_get(ws,ent_base(5)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1068+4)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(5)+1068+8)==0){ ok=ok+1; }
  }
  count_resolved(ws,5,racc);
  // e6 R2 change-then-partial-revert (true phases G0,G1,G0p)
  load_r2(ws);
  feed_ep(ws,6,0, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(6))==2){ ok=ok+1; } }
  feed_ep(ws,6,1, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(6))==2){ ok=ok+1; } }
  feed_ep(ws,6,2, 1,2,1, mode);
  if(mode==0){ total=total+1; if(w_get(ws,ent_base(6))==2){ ok=ok+1; } }
  else if(mode==1){
    total=total+1; if(w_get(ws,ent_base(6)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1084+4)==-1){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1084+8)==-1){ ok=ok+1; }
  }
  else if(mode==2){
    total=total+1; if(w_get(ws,ent_base(6)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1068+4)==1){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1068+8)==2){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1044)==5){ ok=ok+1; }
    q=query(ws,6,1,2); total=total+1; if(q==1){ ok=ok+1; }
    q=query(ws,6,2,2); total=total+1; if(q==0){ ok=ok+1; }
  }
  else {
    total=total+1; if(w_get(ws,ent_base(6)+1068)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1068+4)==0){ ok=ok+1; }
    total=total+1; if(w_get(ws,ent_base(6)+1068+8)==0){ ok=ok+1; }
  }
  count_resolved(ws,6,racc);
  // e7 R3 outside-set (passive Z at t=1; all candidates say 0)
  load_r3(ws); feed_ep(ws,7,0, 2,1,1, mode);
  total=total+1; if(w_get(ws,ent_base(7))==3){ ok=ok+1; }
  emit("SUMMARY mode=");
  if(mode==0){ emit("BASE"); }
  else if(mode==1){ emit("ONESHOT"); }
  else if(mode==2){ emit("ADAPT"); }
  else { emit("STATIC"); }
  emit(" ok="); e64(ok); emit("/"); e64(total);
  emit(" resolved="); e64(get32(racc,0)); emit("\n");
  return ok;
}

fn main()i32 {
  let ws:[]u8=z_alloc(16384);
  let o0:i32=run_all(ws, 0);
  let o1:i32=run_all(ws, 1);
  let o2:i32=run_all(ws, 2);
  let o3:i32=run_all(ws, 3);
  emit("ALL-MODES done\n");
  if(o0==13 && o1==15 && o2==24 && o3==19){ emit("FINAL-OK\n"); }
  return 0;
}

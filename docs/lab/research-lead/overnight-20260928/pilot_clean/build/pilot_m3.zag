// pilot.zag -- H-NEW-3 continuing-learner integration pilot.
// One process, five sequenced experiences, partitioned regions in one
// workspace. Prereg: pilot_impl/PREREG_PILOT.md (76878a918) plus
// PREREG_AMEND1.md (f77e733f5). 3 is replaced at build time with
// 0..5 (see BUILD.sh). Pure Zag. No Python.
//
// Region layout (local offsets per region, sizes in i32 words):
//   R_E1=0   size 40 : lex[12] 0..11, str[12] 12..23, notseen[12] 24..35,
//                     canary 36, p1score 37
//   R_E2=40  size 80 : def[5] 0..4, live[5] 5..9, cnt0[5] 10..14,
//                     cnt1[5] 15..19, exc[5] 20..24, items[40] 25..64,
//                     canary 65, p2a 66, p2b 67, p2c_app 68,
//                     p2c_fresh 69, p2d 70
//   R_E3=120 size 70 : fkind 0, fparam 1, fpromoted 2, fit 3, half1 4,
//                     half2 5, canary 6, c_lo 7, c_hi 8, ntrain 9,
//                     xs[12] 10..21, cs[12] 22..33
//   R_E4=190 size 30 : key 0, val 1, src 2, susp 3, flaglat 4,
//                     hedges 5, reobs 6, contra 7, canary 8
//   R_E5=220 size 80 : reuse_iv 0, fresh_iv 1, reuse_fit 2, fresh_fit 3,
//                     masked 4, canary 5, r_t 6, ntrain 7,
//                     xs[12] 8..19, cs[12] 20..31, f_t 32
//   R_H=300  size 20 : drop_count 0
// STATE bytes after Ek = region_end * 4.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8 = _zag_i64_to_str(v);
  if(r.len > 0 && r[r.len-1] == 10){ return r[0..r.len-1]; }
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn z_ws(n:i32)[]u8 {
  let p:*u8 = _zag_malloc(n*4) as *u8;
  let b:[]u8 = p[0..n*4];
  let i:i32 = 0;
  while(i < n*4){ b[i] = 0; i = i + 1; }
  return b;
}
// Word access on the u8 workspace (bridge-proven pattern;
// []i32 slices from malloc are unreliable on this toolchain).
fn w_get(ws:[]u8, i:i32)i32 { return get32(ws, i*4); }
fn w_set(ws:[]u8, i:i32, v:i32)void { set32(ws, i*4, v); return; }
fn w_add(ws:[]u8, i:i32, d:i32)void {
  set32(ws, i*4, get32(ws, i*4) + d);
  return;
}
fn mode()i32 { return 3; }

// ---- region bases ----
fn R_E1()i32 { return 0; }
fn R_E2()i32 { return 40; }
fn R_E3()i32 { return 120; }
fn R_E4()i32 { return 190; }
fn R_E5()i32 { return 220; }
fn R_H()i32 { return 300; }
fn WS_N()i32 { return 320; }

// ---- channels (D1: sensory routing tags, not task labels) ----
fn CH_VOCAB()i32 { return 1; }
fn CH_CONCEPT()i32 { return 2; }
fn CH_FORM()i32 { return 3; }
fn CH_FACT()i32 { return 4; }

// ================= E1: vocabulary =================
// Words 0..11 map to features (w%6)+1. Word 12 is the NOT marker:
// meaning(NOT, w) = complement mask 63 ^ (1 << (feat(w)-1)).
// NOT semantics are a fixed researcher-defined compositional rule
// (disclosed in prereg section 6); the pilot measures retention.

fn e1_observe(ws:[]u8, kind:i32, w:i32, f:i32)void {
  let b:i32 = R_E1();
  if(kind == 0){
    w_set(ws, b+w, f);
    w_set(ws, b+12+w, w_get(ws, b+12+w) + 1);
  } else {
    w_set(ws, b+24+w, 1);
  }
  return;
}
fn e1_feat(ws:[]u8, w:i32)i32 { return w_get(ws, R_E1()+w); }
fn e1_query_not(ws:[]u8, w:i32)i32 {
  let f:i32 = e1_feat(ws, w);
  return 63 ^ (1 << (f - 1));
}
fn p1_exp(ord:i32)i32 {
  if(ord < 12){ return (ord % 6) + 1; }
  if(ord == 12){ return 63 ^ (1 << ((0 % 6) + 1 - 1)); }
  if(ord == 13){ return 63 ^ (1 << ((1 % 6) + 1 - 1)); }
  if(ord == 14){ return 63 ^ (1 << ((4 % 6) + 1 - 1)); }
  return 63 ^ (1 << ((5 % 6) + 1 - 1));
}
fn p1_got(ws:[]u8, ord:i32)i32 {
  if(ord < 12){ return e1_feat(ws, ord); }
  if(ord == 12){ return e1_query_not(ws, 0); }
  if(ord == 13){ return e1_query_not(ws, 1); }
  if(ord == 14){ return e1_query_not(ws, 4); }
  return e1_query_not(ws, 5);
}
fn run_p1(ws:[]u8)i32 {
  let s:i32 = 0;
  let o:i32 = 0;
  while(o < 16){
    if(p1_got(ws, o) == p1_exp(o)){ s = s + 1; }
    o = o + 1;
  }
  w_set(ws, R_E1()+37, s);
  return s;
}
fn w1_check(ws:[]u8)i32 {
  let b:i32 = R_E1();
  let w:i32 = 0;
  while(w < 12){
    if(w_get(ws, b+w) != (w % 6) + 1){ return 0; }
    if(w_get(ws, b+12+w) <= 0){ return 0; }
    w = w + 1;
  }
  return 1;
}
fn run_e1(ws:[]u8)void {
  // 48 pair episodes: (w, feat), w = e % 12
  let e:i32 = 0;
  while(e < 48){
    let w:i32 = e % 12;
    dispatch_observe(ws, CH_VOCAB(), 0, w, (w % 6) + 1);
    e = e + 1;
  }
  // 16 NOT-composition episodes on words 0..3
  e = 0;
  while(e < 16){
    let w:i32 = e / 4;
    dispatch_observe(ws, CH_VOCAB(), 1, w, 0);
    e = e + 1;
  }
  return;
}

// ================= E2: concept learning =================
// 4 domains (d=0..3), 8 items each. True class c(d,i) = d%2 except
// domain 3 item 7 (noisy exception, class 0). Transfer domain d=4:
// 8 items, class 0 except item 3 (class 1). Learner: majority default
// per domain, exception mask, accuracy ledger, retirement trigger.

fn e2_true(d:i32, i:i32)i32 {
  if(d == 3 && i == 7){ return 0; }
  if(d == 4 && i == 3){ return 1; }
  return d % 2;
}
fn e2_observe(ws:[]u8, d:i32, i:i32, c:i32)void {
  let b:i32 = R_E2();
  w_set(ws, b+25+d*8+i, c);
  if(c == 0){ w_set(ws, b+10+d, w_get(ws, b+10+d) + 1); }
  else { w_set(ws, b+15+d, w_get(ws, b+15+d) + 1); }
  return;
}
fn e2_schema_predict(ws:[]u8, d:i32, i:i32)i32 {
  // Predict from the learned schema (default + exception mask),
  // not by reading the raw item table: this exercises the structure.
  let b:i32 = R_E2();
  let def:i32 = w_get(ws, b+d);
  if(i < 8){
    let mask:i32 = w_get(ws, b+20+d);
    if((mask & (1 << i)) != 0){ return 1 - def; }
  }
  return def;
}
fn e2_finalize(ws:[]u8, d:i32)i32 {
  // Returns 1 if schema discovered for domain d.
  let b:i32 = R_E2();
  let c0:i32 = w_get(ws, b+10+d);
  let c1:i32 = w_get(ws, b+15+d);
  if(c0 + c1 == 0){ return 0; }
  let def:i32 = 0;
  if(c1 > c0){ def = 1; }
  w_set(ws, b+d, def);
  let mask:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if(w_get(ws, b+25+d*8+i) != def){ mask = mask | (1 << i); }
    i = i + 1;
  }
  w_set(ws, b+20+d, mask);
  // accuracy ledger + retirement trigger (CL2 shape): retire if < 6/8
  let ok:i32 = 0;
  i = 0;
  while(i < 8){
    if(e2_schema_predict(ws, d, i) == e2_true(d, i)){ ok = ok + 1; }
    i = i + 1;
  }
  w_set(ws, b+5+d, 1);
  if(ok < 6){ w_set(ws, b+5+d, 0); }
  return 1;
}
fn popcnt8(m:i32)i32 {
  let n:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if((m & (1 << i)) != 0){ n = n + 1; }
    i = i + 1;
  }
  return n;
}
fn run_e2(ws:[]u8)void {
  let d:i32 = 0;
  while(d < 4){
    let i:i32 = 0;
    while(i < 8){
      dispatch_observe(ws, CH_CONCEPT(), d, i, e2_true(d, i));
      i = i + 1;
    }
    e2_finalize(ws, d);
    d = d + 1;
  }
  return;
}
fn p2_heldout(ws:[]u8)i32 {
  // 4 held-out items (d, 8): predict via schema default.
  let s:i32 = 0;
  let d:i32 = 0;
  while(d < 4){
    if(e2_schema_predict(ws, d, 8) == e2_true(d, 8)){ s = s + 1; }
    d = d + 1;
  }
  w_set(ws, R_E2()+67, s);
  return s;
}
fn p2_transfer(ws:[]u8)i32 {
  // Transfer domain 4: fresh stores 8 items; schema stores 1 default
  // + exceptions. Returns 1 iff apply_writes < fresh_writes.
  let d:i32 = 4;
  let i:i32 = 0;
  while(i < 8){
    dispatch_observe(ws, CH_CONCEPT(), d, i, e2_true(d, i));
    i = i + 1;
  }
  e2_finalize(ws, d);
  let b:i32 = R_E2();
  let fresh:i32 = 8;
  let app:i32 = 1 + popcnt8(w_get(ws, b+20+d));
  w_set(ws, b+68, app);
  w_set(ws, b+69, fresh);
  if(app < fresh){ return 1; }
  return 0;
}
fn p2_discovered(ws:[]u8)i32 {
  // Schema discovered: all 4 domains finalized (called) and live
  // flags computed. Returns 1 iff 4/4 defaults were set.
  let b:i32 = R_E2();
  let n:i32 = 0;
  let d:i32 = 0;
  while(d < 4){
    if(w_get(ws, b+10+d) + w_get(ws, b+15+d) > 0){ n = n + 1; }
    d = d + 1;
  }
  if(n == 4){ w_set(ws, b+66, 1); return 1; }
  w_set(ws, b+66, 0);
  return 0;
}
fn p2_delayed(ws:[]u8)i32 {
  // Re-query all 8 trained items of domain 0 via schema; 8/8 + live.
  let b:i32 = R_E2();
  let s:i32 = 0;
  let i:i32 = 0;
  while(i < 8){
    if(e2_schema_predict(ws, 0, i) == e2_true(0, i)){ s = s + 1; }
    i = i + 1;
  }
  let liveok:i32 = 1;
  let d:i32 = 0;
  while(d < 4){
    if(w_get(ws, b+5+d) != 1){ liveok = 0; }
    d = d + 1;
  }
  w_set(ws, b+70, s);
  if(s == 8 && liveok == 1){ return 1; }
  return 0;
}
fn p2_gate(ws:[]u8)i32 {
  // P4x gate: schemas live and domain-2 default query == 0.
  let b:i32 = R_E2();
  let d:i32 = 0;
  while(d < 4){
    if(w_get(ws, b+5+d) != 1){ return 0; }
    d = d + 1;
  }
  if(e2_schema_predict(ws, 2, 8) != 0){ return 0; }
  return 1;
}

// ================= E3: procedure invention (baseline) =================
// World: 12 points x = 0,2,...,22, class = 1 iff x < 13. The constant
// 13 is world truth, never visible to the construction mechanism.
// Mechanism (generic within the single-threshold family):
//   residuals of majority baseline -> candidate thresholds at
//   adjacent class-change midpoints -> greedy max-correct (tie: smallest
//   t) -> adopt iff exact -> promote to form pool -> halving check.

fn e3_x(i:i32)i32 { return i * 2; }
fn e3_c(i:i32)i32 {
  if(i * 2 < 13){ return 1; }
  return 0;
}
fn e3_feed(ws:[]u8, x:i32, c:i32)void {
  let b:i32 = R_E3();
  let n:i32 = w_get(ws, b+9);
  w_set(ws, b+10+n, x);
  w_set(ws, b+22+n, c);
  w_set(ws, b+9, n + 1);
  return;
}
fn e3_score_t(ws:[]u8, t:i32)i32 {
  let b:i32 = R_E3();
  let n:i32 = w_get(ws, b+9);
  let lo1:i32 = 0;
  let lo_n:i32 = 0;
  let hi1:i32 = 0;
  let hi_n:i32 = 0;
  let i:i32 = 0;
  while(i < n){
    let x:i32 = w_get(ws, b+10+i);
    let c:i32 = w_get(ws, b+22+i);
    if(x < t){
      lo_n = lo_n + 1;
      if(c == 1){ lo1 = lo1 + 1; }
    } else {
      hi_n = hi_n + 1;
      if(c == 1){ hi1 = hi1 + 1; }
    }
    i = i + 1;
  }
  let c_lo:i32 = 0;
  if(lo_n > 0 && lo1 * 2 >= lo_n){ c_lo = 1; }
  let c_hi:i32 = 0;
  if(hi_n > 0 && hi1 * 2 >= hi_n){ c_hi = 1; }
  let s:i32 = 0;
  i = 0;
  while(i < n){
    let pred:i32 = c_hi;
    if(w_get(ws, b+10+i) < t){ pred = c_lo; }
    if(pred == w_get(ws, b+22+i)){ s = s + 1; }
    i = i + 1;
  }
  // stash side majorities for apply()
  w_set(ws, b+7, c_lo);
  w_set(ws, b+8, c_hi);
  return s;
}
fn e3_construct(ws:[]u8)i32 {
  // Greedy over class-change midpoints. Returns best score.
  let b:i32 = R_E3();
  let n:i32 = w_get(ws, b+9);
  let best_t:i32 = -1;
  let best_s:i32 = -1;
  let i:i32 = 0;
  while(i < n - 1){
    if(w_get(ws, b+22+i) != w_get(ws, b+22+i+1)){
      let t:i32 = (w_get(ws, b+10+i) + w_get(ws, b+10+i+1)) / 2;
      let s:i32 = e3_score_t(ws, t);
      if(s > best_s){ best_s = s; best_t = t; }
    }
    i = i + 1;
  }
  if(best_s == n && n > 0){
    // recompute side majorities for the winning t (score_t stashed
    // the last candidate's; recompute for best_t)
    e3_score_t(ws, best_t);
    w_set(ws, b+0, 1);        // kind IF_LT
    w_set(ws, b+1, best_t);   // param
    w_set(ws, b+2, 1);        // promoted
    w_set(ws, b+3, best_s);   // fit
  }
  return best_s;
}
fn e3_apply(ws:[]u8, x:i32)i32 {
  let b:i32 = R_E3();
  if(x < w_get(ws, b+1)){ return w_get(ws, b+7); }
  return w_get(ws, b+8);
}
fn e3_halving(ws:[]u8)i32 {
  // Even/odd index halves must each score 6/6.
  let b:i32 = R_E3();
  let s0:i32 = 0;
  let s1:i32 = 0;
  let i:i32 = 0;
  while(i < 12){
    let x:i32 = w_get(ws, b+10+i);
    let c:i32 = w_get(ws, b+22+i);
    if(e3_apply(ws, x) == c){
      if((i % 2) == 0){ s0 = s0 + 1; } else { s1 = s1 + 1; }
    }
    i = i + 1;
  }
  w_set(ws, b+4, s0);
  w_set(ws, b+5, s1);
  if(s0 == 6 && s1 == 6){ return 1; }
  return 0;
}
fn run_e3(ws:[]u8)void {
  let i:i32 = 0;
  while(i < 12){
    e3_feed(ws, e3_x(i), e3_c(i));
    i = i + 1;
  }
  e3_construct(ws);
  return;
}
fn p3_all(ws:[]u8)i32 {
  let b:i32 = R_E3();
  let a:i32 = 0;
  if(w_get(ws, b+3) == 12){ a = 1; }
  let h:i32 = e3_halving(ws);
  emit("E3-FIT="); e64(w_get(ws, b+3)); emit("\n");
  emit("E3-PROMOTED="); e64(w_get(ws, b+2)); emit(" kind="); e64(w_get(ws, b+0));
  emit(" param="); e64(w_get(ws, b+1)); emit("\n");
  emit("E3-HALF="); e64(h); emit(" half0="); e64(w_get(ws, b+4));
  emit(" half1="); e64(w_get(ws, b+5)); emit("\n");
  if(a == 1 && w_get(ws, b+2) == 1 && w_get(ws, b+0) == 1 && h == 1){ return 1; }
  return 0;
}

// ================= E4: conflicting evidence =================
// Fact store with source tags. Oracle contradicts a learned belief;
// learner must flag within 1 episode, hedge + request exactly one
// re-observation, then restore truth and clear SUSPECT.

fn SRC_LEARNED()i32 { return 1; }
fn SRC_ORACLE()i32 { return 2; }
fn K_DOM2()i32 { return 200; }

fn e4_store(ws:[]u8, key:i32, val:i32, src:i32)void {
  let b:i32 = R_E4();
  w_set(ws, b+0, key);
  w_set(ws, b+1, val);
  w_set(ws, b+2, src);
  w_set(ws, b+3, 0);
  return;
}
fn e4_observe(ws:[]u8, key:i32, val:i32, src:i32)void {
  // CH_FACT handler: contradiction detection.
  let b:i32 = R_E4();
  if(key == w_get(ws, b+0) && w_get(ws, b+2) == SRC_LEARNED() && src == SRC_ORACLE() && val != w_get(ws, b+1)){
    w_set(ws, b+7, 1);   // contradiction flag
    w_set(ws, b+3, 1);   // SUSPECT
    w_set(ws, b+4, 0);   // flag latency: same episode
    w_set(ws, b+5, w_get(ws, b+5) + 1);
    emit("HEDGE key="); e64(key);
    emit(" stored="); e64(w_get(ws, b+1));
    emit(" oracle="); e64(val); emit("\n");
    w_set(ws, b+6, w_get(ws, b+6) + 1);
    emit("REOBS-REQ key="); e64(key); emit("\n");
  }
  return;
}
fn e4_reobserve(ws:[]u8, key:i32, val:i32, src:i32)void {
  // Harness answers the single re-observation with truth.
  let b:i32 = R_E4();
  if(key == w_get(ws, b+0) && w_get(ws, b+7) == 1){
    w_set(ws, b+1, val);
    w_set(ws, b+2, src);
    w_set(ws, b+3, 0);
    w_set(ws, b+7, 2);   // resolved
    emit("RESTORED key="); e64(key); emit(" val="); e64(val); emit("\n");
  }
  return;
}
fn run_e4(ws:[]u8)void {
  // Prerequisite belief is stored by the caller (Arm A: from E2;
  // Arm B mode 4: taught directly). Then the lie, then the truth.
  dispatch_observe(ws, CH_FACT(), K_DOM2(), 1, SRC_ORACLE());
  e4_reobserve(ws, K_DOM2(), 0, SRC_ORACLE());
  return;
}
fn p4_all(ws:[]u8)i32 {
  let b:i32 = R_E4();
  emit("E4-FLAGLAT="); e64(w_get(ws, b+4)); emit("\n");
  emit("E4-HEDGES="); e64(w_get(ws, b+5)); emit(" reobs="); e64(w_get(ws, b+6)); emit("\n");
  emit("E4-VAL="); e64(w_get(ws, b+1)); emit(" susp="); e64(w_get(ws, b+3)); emit("\n");
  let a:i32 = 0;
  if(w_get(ws, b+4) <= 1){ a = 1; }
  let c:i32 = 0;
  if(w_get(ws, b+1) == 0 && w_get(ws, b+3) == 0){ c = 1; }
  if(a == 1 && w_get(ws, b+5) == 1 && w_get(ws, b+6) == 1 && c == 1){ return 1; }
  return 0;
}
fn p4x_all(ws:[]u8, e1ref:i32)i32 {
  // E4 must not corrupt E1/E2 state: P1 unchanged, P2 gate passes.
  let s:i32 = run_p1(ws);
  let g:i32 = p2_gate(ws);
  emit("E4X-P1="); e64(s); emit(" ref="); e64(e1ref); emit("\n");
  emit("E4X-GATE="); e64(g); emit("\n");
  if(s == e1ref && g == 1){ return 1; }
  return 0;
}

// ================= E5: delayed reuse =================
// New task, changed surface, same topology: x = 100..122 step 2,
// class = 1 iff x < 115. Condition R retrieves the E3 form
// (kind IF_LT + param) and refits by bisection; condition F masks the
// form pool and runs full construction. Interventions counted.

fn e5_x(i:i32)i32 { return 100 + i * 2; }
fn e5_c(i:i32)i32 {
  if(100 + i * 2 < 115){ return 1; }
  return 0;
}
fn e5_fresh_feed(ws:[]u8, x:i32, c:i32)void {
  // Condition F: consume one train point (counts an intervention).
  let b:i32 = R_E5();
  let n:i32 = w_get(ws, b+7);
  w_set(ws, b+8+n, x);
  w_set(ws, b+20+n, c);
  w_set(ws, b+7, n + 1);
  w_set(ws, b+1, w_get(ws, b+1) + 1);
  return;
}
fn e5_fresh_construct(ws:[]u8)i32 {
  // Full pipeline on the E5 buffer (mirrors e3_construct).
  let b:i32 = R_E5();
  let n:i32 = w_get(ws, b+7);
  let best_t:i32 = -1;
  let best_s:i32 = -1;
  let i:i32 = 0;
  while(i < n - 1){
    if(w_get(ws, b+20+i) != w_get(ws, b+20+i+1)){
      let t:i32 = (w_get(ws, b+8+i) + w_get(ws, b+8+i+1)) / 2;
      // score t with majority sides
      let lo1:i32 = 0; let lo_n:i32 = 0;
      let hi1:i32 = 0; let hi_n:i32 = 0;
      let j:i32 = 0;
      while(j < n){
        if(w_get(ws, b+8+j) < t){
          lo_n = lo_n + 1;
          if(w_get(ws, b+20+j) == 1){ lo1 = lo1 + 1; }
        } else {
          hi_n = hi_n + 1;
          if(w_get(ws, b+20+j) == 1){ hi1 = hi1 + 1; }
        }
        j = j + 1;
      }
      let c_lo:i32 = 0;
      if(lo_n > 0 && lo1 * 2 >= lo_n){ c_lo = 1; }
      let c_hi:i32 = 0;
      if(hi_n > 0 && hi1 * 2 >= hi_n){ c_hi = 1; }
      let s:i32 = 0;
      j = 0;
      while(j < n){
        let pred:i32 = c_hi;
        if(w_get(ws, b+8+j) < t){ pred = c_lo; }
        if(pred == w_get(ws, b+20+j)){ s = s + 1; }
        j = j + 1;
      }
      if(s > best_s){ best_s = s; best_t = t; }
    }
    i = i + 1;
  }
  w_set(ws, b+32, best_t);
  // fit of best_t on buffer
  let fit:i32 = 0;
  i = 0;
  while(i < n){
    let pred:i32 = 0;
    if(w_get(ws, b+8+i) < best_t){ pred = 1; }
    if(pred == w_get(ws, b+20+i)){ fit = fit + 1; }
    i = i + 1;
  }
  w_set(ws, b+3, fit);
  return fit;
}
fn e5_probe(ws:[]u8, idx:i32)i32 {
  // Condition R: one adaptive probe (counts a reuse intervention).
  let b:i32 = R_E5();
  w_set(ws, b+0, w_get(ws, b+0) + 1);
  return e5_c(idx);
}
fn e5_refit_reuse(ws:[]u8)i32 {
  // Retrieve (kind, param) from the E3 form pool; bisect the flip.
  let b:i32 = R_E5();
  let b3:i32 = R_E3();
  if(w_get(ws, b+4) == 1){ return -1; }          // pool masked: refuse
  if(w_get(ws, b3+2) != 1 || w_get(ws, b3+0) != 1){ return -1; }  // no promoted IF_LT
  let lo:i32 = 0;
  let hi:i32 = 11;
  let c0:i32 = e5_probe(ws, 0);
  let c11:i32 = e5_probe(ws, 11);
  if(c0 != 1 || c11 != 0){ return -1; }   // topology assumption broken
  while(hi - lo > 1){
    let mid:i32 = (lo + hi) / 2;
    if(e5_probe(ws, mid) == 1){ lo = mid; } else { hi = mid; }
  }
  let t:i32 = (e5_x(lo) + e5_x(hi)) / 2;
  w_set(ws, b+6, t);
  // fit of refit t on all 12 (probe evaluation, not counted)
  let fit:i32 = 0;
  let i:i32 = 0;
  while(i < 12){
    let pred:i32 = 0;
    if(e5_x(i) < t){ pred = 1; }
    if(pred == e5_c(i)){ fit = fit + 1; }
    i = i + 1;
  }
  w_set(ws, b+2, fit);
  return fit;
}
fn run_e5(ws:[]u8)void {
  let b:i32 = R_E5();
  // Condition R first (needs the form pool intact).
  w_set(ws, b+4, 0);
  e5_refit_reuse(ws);
  // Condition F: mask the pool, build from scratch.
  w_set(ws, b+4, 1);
  let i:i32 = 0;
  while(i < 12){
    e5_fresh_feed(ws, e5_x(i), e5_c(i));
    i = i + 1;
  }
  e5_fresh_construct(ws);
  w_set(ws, b+4, 0);
  return;
}
fn p5_all(ws:[]u8)i32 {
  let b:i32 = R_E5();
  emit("E5-REUSE-IV="); e64(w_get(ws, b+0)); emit(" fit="); e64(w_get(ws, b+2));
  emit(" t="); e64(w_get(ws, b+6)); emit("\n");
  emit("E5-FRESH-IV="); e64(w_get(ws, b+1)); emit(" fit="); e64(w_get(ws, b+3));
  emit(" t="); e64(w_get(ws, b+32)); emit("\n");
  if(w_get(ws, b+2) == 12 && w_get(ws, b+0) < w_get(ws, b+1)){ return 1; }
  return 0;
}

// ================= harness =================
// dispatch_observe routes by sensory channel (D1). The episode
// counter lives only in main and is never passed to subsystems
// (stronger than the prereg's audit requirement).

fn dispatch_observe(ws:[]u8, ch:i32, a:i32, b:i32, c:i32)void {
  if(ch == CH_VOCAB()){ e1_observe(ws, a, b, c); }
  else if(ch == CH_CONCEPT()){ e2_observe(ws, a, b, c); }
  else if(ch == CH_FACT()){ e4_observe(ws, a, b, c); }
  return;
}
fn canary_write(ws:[]u8, base:i32, coff:i32, exp:i32)void {
  w_set(ws, base+coff, 1000 * exp + 7);
  return;
}
fn canary_check(ws:[]u8, base:i32, coff:i32, exp:i32)i32 {
  if(w_get(ws, base+coff) == 1000 * exp + 7){ return 1; }
  return 0;
}
fn state_bytes_after(exp:i32)i32 {
  // region_end * 4 for experiences 1..5
  if(exp == 1){ return 160; }
  if(exp == 2){ return 480; }
  if(exp == 3){ return 760; }
  if(exp == 4){ return 880; }
  return 1200;
}

// ---- experience runners (harness-side) ----
fn h_e1(ws:[]u8)void {
  run_e1(ws);
  canary_write(ws, R_E1(), 36, 1);
  emit("STATE_E1="); e64(state_bytes_after(1)); emit("\n");
  return;
}
fn h_e2(ws:[]u8)void {
  run_e2(ws);
  canary_write(ws, R_E2(), 65, 2);
  emit("STATE_E2="); e64(state_bytes_after(2)); emit("\n");
  return;
}
fn h_e3(ws:[]u8)void {
  run_e3(ws);
  canary_write(ws, R_E3(), 6, 3);
  emit("STATE_E3="); e64(state_bytes_after(3)); emit("\n");
  return;
}
fn h_e4(ws:[]u8)void {
  run_e4(ws);
  canary_write(ws, R_E4(), 8, 4);
  emit("STATE_E4="); e64(state_bytes_after(4)); emit("\n");
  return;
}
fn h_e5(ws:[]u8)void {
  run_e5(ws);
  canary_write(ws, R_E5(), 5, 5);
  emit("STATE_E5="); e64(state_bytes_after(5)); emit("\n");
  return;
}

// ---- Arm A: one process, E1..E5, immediate + delayed probes ----
fn arm_a(ws:[]u8)i32 {
  let ep:i32 = 0;  // harness episode counter; never passed to subsystems
  let ok:i32 = 1;

  h_e1(ws); ep = ep + 64;
  let p1:i32 = run_p1(ws);
  let w1:i32 = w1_check(ws);
  emit("A-E1-P1="); e64(p1); emit("\n");
  emit("A-E1-W1="); e64(w1); emit("\n");
  if(p1 < 13 || w1 != 1){ ok = 0; }

  h_e2(ws); ep = ep + 32;
  let p2d0:i32 = p2_discovered(ws);
  let p2h:i32 = p2_heldout(ws);
  let p2t:i32 = p2_transfer(ws);
  emit("A-E2-DISC="); e64(p2d0); emit("\n");
  emit("A-E2-HELD="); e64(p2h); emit("\n");
  emit("A-E2-APP="); e64(w_get(ws, R_E2()+68));
  emit(" FRESH="); e64(w_get(ws, R_E2()+69)); emit("\n");
  if(p2d0 != 1 || p2h < 3 || p2t != 1){ ok = 0; }

  h_e3(ws); ep = ep + 12;
  let p3:i32 = p3_all(ws);
  emit("A-E3-OK="); e64(p3); emit("\n");
  if(p3 != 1){ ok = 0; }

  // E4 prerequisite: E2's domain-2 default as a learned belief.
  e4_store(ws, K_DOM2(), 0, SRC_LEARNED());
  h_e4(ws); ep = ep + 2;
  let p4:i32 = p4_all(ws);
  emit("A-E4-OK="); e64(p4); emit("\n");
  if(p4 != 1){ ok = 0; }
  let p4x:i32 = p4x_all(ws, p1);
  emit("A-E4X-OK="); e64(p4x); emit("\n");
  if(p4x != 1){ ok = 0; }

  h_e5(ws); ep = ep + 18;
  let p5:i32 = p5_all(ws);
  emit("A-E5-OK="); e64(p5); emit("\n");
  if(p5 != 1){ ok = 0; }

  // ---- delayed battery ----
  let p1d:i32 = run_p1(ws);
  emit("A-D1-P1D="); e64(p1d); emit("\n");
  if(p1d < 11){ ok = 0; }
  let p2d:i32 = p2_delayed(ws);
  emit("A-D2-OK="); e64(p2d); emit(" score="); e64(w_get(ws, R_E2()+70)); emit("\n");
  if(p2d != 1){ ok = 0; }
  let d4v:i32 = w_get(ws, R_E4()+1);
  emit("A-D4-VAL="); e64(d4v); emit("\n");
  if(d4v != 0){ ok = 0; }

  // ---- canary audit ----
  let c:i32 = 0;
  c = c + canary_check(ws, R_E1(), 36, 1);
  c = c + canary_check(ws, R_E2(), 65, 2);
  c = c + canary_check(ws, R_E3(), 6, 3);
  c = c + canary_check(ws, R_E4(), 8, 4);
  c = c + canary_check(ws, R_E5(), 5, 5);
  emit("A-CANARY="); e64(c); emit("/5\n");
  if(c != 5){ ok = 0; }

  emit("A-DROP="); e64(w_get(ws, R_H()+0)); emit("\n");
  emit("A-OK="); e64(ok); emit("\n");
  return ok;
}

// ---- Arm B: single-experience modes ----
fn arm_b1(ws:[]u8)void {
  h_e1(ws);
  let p1:i32 = run_p1(ws);
  let w1:i32 = w1_check(ws);
  emit("B1-P1="); e64(p1); emit("\n");
  emit("B1-W1="); e64(w1); emit("\n");
  return;
}
fn arm_b2(ws:[]u8)void {
  h_e2(ws);
  let d0:i32 = p2_discovered(ws);
  let h:i32 = p2_heldout(ws);
  let t:i32 = p2_transfer(ws);
  let dd:i32 = p2_delayed(ws);
  emit("B2-DISC="); e64(d0); emit("\n");
  emit("B2-HELD="); e64(h); emit("\n");
  emit("B2-APP="); e64(w_get(ws, R_E2()+68));
  emit(" FRESH="); e64(w_get(ws, R_E2()+69)); emit("\n");
  emit("B2-P2D="); e64(dd); emit(" score="); e64(w_get(ws, R_E2()+70)); emit("\n");
  return;
}
fn arm_b3(ws:[]u8)void {
  h_e3(ws);
  let p3:i32 = p3_all(ws);
  emit("B3-OK="); e64(p3); emit("\n");
  return;
}
fn arm_b4(ws:[]u8)void {
  // Prerequisites (disclosed): full E1 for the P1-equivalent,
  // full E2 (all 4 domains) for the P2 gate, K_DOM2 as the learned belief.
  run_e1(ws);
  run_e2(ws);
  let p1ref:i32 = run_p1(ws);
  e4_store(ws, K_DOM2(), 0, SRC_LEARNED());
  h_e4(ws);
  let p4:i32 = p4_all(ws);
  emit("B4-OK="); e64(p4); emit("\n");
  let p4x:i32 = p4x_all(ws, p1ref);
  emit("B4-X-OK="); e64(p4x); emit("\n");
  return;
}
fn arm_b5(ws:[]u8)void {
  // Prerequisite (disclosed): E3 invention, then E5.
  h_e3(ws);
  h_e5(ws);
  let p5:i32 = p5_all(ws);
  emit("B5-OK="); e64(p5); emit("\n");
  return;
}

fn main()i32 {
  emit("PILOT-START mode=");
  e64(mode());
  emit("\n");
  let ws:[]u8 = z_ws(WS_N());
  let m:i32 = mode();
  if(m == 0){
    let ok:i32 = arm_a(ws);
    emit("PILOT-A-RESULT=");
    e64(ok);
    emit("\n");
  } else if(m == 1){ arm_b1(ws); }
  else if(m == 2){ arm_b2(ws); }
  else if(m == 3){ arm_b3(ws); }
  else if(m == 4){ arm_b4(ws); }
  else if(m == 5){ arm_b5(ws); }
  emit("PILOT-END\n");
  return 0;
}

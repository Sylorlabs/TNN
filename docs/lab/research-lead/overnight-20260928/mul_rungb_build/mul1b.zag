// mul1b.zag -- MUL-1 Rung B two-level learner construction experiment.
// Frozen prereg: docs/lab/research-lead/overnight-20260928/mul_rungb_prereg/MUL_RUNGB_PREREG.md @ 3ce154801.
// Review disposition: REVIEW_DISPOSITION.md (ACCEPT, 2026-09-30).
// ISA boundary: docs/lab/research-lead/overnight-20260928/architecture_rulings/ISA_BOUNDARY_RULING.md @ 0525377f3.
// Parent prereg: docs/lab/research-lead/overnight-20260928/mul_prereg/PREREG_MUL1.md @ 222899314.
// Pure Zag. No Python. No em dashes.
//
// Rung B: TWO levels of learner construction.
//   Phase 3a: learner constructs ADD from {MOVE, BRANCHEQ, INC, DEC}.
//     NO core ADD in the search or execution path (K3 purity).
//     Cell ops (domain-neutral, names no target regularity):
//       0 INIT_R0  = MOVE(r <- literal 0)
//       1 COPY_RX  = MOVE(r <- x)
//       2 INC_R    = MOVE(r <- INC(r))
//       3 DEC_Y    = MOVE(y <- DEC(y))
//       4 TEST_Y0  = BRANCHEQ(y, 0) -> halt on equal, else fall through
//       5+t GOTO(t) = SEQ back-edge to cell t
//     Note: r=r+1 is INC (ISA basic arithmetic), y=y-1 is DEC.
//     No general addition (r=r+x) appears in Phase 3a.
//   Phase 3b: learner constructs MUL on top of learner-built ADD.
//     Cell ops: Phase 3a ops (repurposed for MUL frame) plus CALL.
//       0 INIT_R0  = MOVE(r <- literal 0)
//       1 INIT_I0  = MOVE(i <- literal 0)
//       2 CALL_ADD = EXECUTE learner-ADD PROC with (r, x), store in r
//       3 INC_I    = MOVE(i <- INC(i))
//       4 TEST_IY  = BRANCHEQ(i, y) -> halt on equal, else fall through
//       5+t GOTO(t) = SEQ back-edge to cell t
//     CALL is domain-neutral: it names no target procedure.
//     At MUL-construction time the only PROC is the learner-built ADD.
//   K3: the Phase 3a/3b search never invokes core ADD. Verified by source scan.
//
// Discovery: fixed published trial order, length-first lexicographic.
// First program scoring all exemplars is PROMOTEd; cells materialized as
// learner-owned workspace PROC nodes (C0-A artifact).

// ============ output and memory helpers ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
// u8-backed little-endian cells (compiler workaround per AGENTS.md)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ frozen experience data (prereg section 3) ============
// Phase 2a: N_ADD = 10 bare addition exemplars.
fn adx(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return 2;} if(i==2){return 3;}
  if(i==3){return 4;} if(i==4){return 5;} if(i==5){return 6;}
  if(i==6){return 7;} if(i==7){return 8;} if(i==8){return 9;}
  return 11;
}
fn ady(i:i32)i32 {
  if(i==0){return 2;} if(i==1){return 3;} if(i==2){return 5;}
  if(i==3){return 6;} if(i==4){return 7;} if(i==5){return 8;}
  if(i==6){return 9;} if(i==7){return 10;} if(i==8){return 12;}
  return 14;
}
fn adp(i:i32)i32 {
  if(i==0){return 3;} if(i==1){return 5;} if(i==2){return 8;}
  if(i==3){return 10;} if(i==4){return 12;} if(i==5){return 14;}
  if(i==6){return 16;} if(i==7){return 18;} if(i==8){return 21;}
  return 25;
}
// Phase 4a: 8 held-out addition probes. Sums novel (not in training set).
fn apx(i:i32)i32 {
  if(i==0){return 4;} if(i==1){return 6;} if(i==2){return 8;}
  if(i==3){return 9;} if(i==4){return 10;} if(i==5){return 11;}
  if(i==6){return 13;} return 15;
}
fn apy(i:i32)i32 {
  if(i==0){return 5;} if(i==1){return 7;} if(i==2){return 9;}
  if(i==3){return 10;} if(i==4){return 12;} if(i==5){return 13;}
  if(i==6){return 15;} return 17;
}
fn app(i:i32)i32 {
  if(i==0){return 9;} if(i==1){return 13;} if(i==2){return 17;}
  if(i==3){return 19;} if(i==4){return 22;} if(i==5){return 24;}
  if(i==6){return 28;} return 32;
}
// Phase 2b: 12 bare multiplication exemplars (identical to Rung A, prereg frozen).
fn ex_x(i:i32)i32 {
  if(i==0){return 2;} if(i==1){return 3;} if(i==2){return 2;}
  if(i==3){return 4;} if(i==4){return 3;} if(i==5){return 5;}
  if(i==6){return 4;} if(i==7){return 7;} if(i==8){return 6;}
  if(i==9){return 8;} if(i==10){return 5;} return 9;
}
fn ex_y(i:i32)i32 {
  if(i==0){return 3;} if(i==1){return 4;} if(i==2){return 5;}
  if(i==3){return 4;} if(i==4){return 7;} if(i==5){return 6;}
  if(i==6){return 9;} if(i==7){return 7;} if(i==8){return 4;}
  if(i==9){return 3;} if(i==10){return 8;} return 6;
}
fn ex_p(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 12;} if(i==2){return 10;}
  if(i==3){return 16;} if(i==4){return 21;} if(i==5){return 30;}
  if(i==6){return 36;} if(i==7){return 49;} if(i==8){return 24;}
  if(i==9){return 24;} if(i==10){return 40;} return 54;
}
// Phase 4b: 8 held-out multiplication probes (identical to Rung A).
fn pr_x(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 3;} if(i==2){return 8;}
  if(i==3){return 7;} if(i==4){return 4;} if(i==5){return 9;}
  if(i==6){return 5;} return 11;
}
fn pr_y(i:i32)i32 {
  if(i==0){return 7;} if(i==1){return 9;} if(i==2){return 8;}
  if(i==3){return 9;} if(i==4){return 11;} if(i==5){return 9;}
  if(i==6){return 12;} return 3;
}
fn pr_p(i:i32)i32 {
  if(i==0){return 42;} if(i==1){return 27;} if(i==2){return 64;}
  if(i==3){return 63;} if(i==4){return 44;} if(i==5){return 81;}
  if(i==6){return 60;} return 33;
}
// Phase 5: revision probes (frozen).
fn rv_x(i:i32)i32 {
  if(i==0){return 5;} if(i==1){return 0;} if(i==2){return 3;} return -2;
}
fn rv_y(i:i32)i32 {
  if(i==0){return 0;} if(i==1){return 7;} if(i==2){return -4;} return -5;
}
fn rv_p(i:i32)i32 {
  if(i==0){return 0;} if(i==1){return 0;} if(i==2){return -12;} return 10;
}

// ============ Phase 3a: ADD cell interpreter ============
// Frame: [x] [y] [r]. y is destructively consumed by the loop (prereg).
// Codes: 0 INIT_R0, 1 COPY_RX, 2 INC_R, 3 DEC_Y, 4 TEST_Y0, 5+t GOTO(t).
// K3: no core ADD. r=r+1 is INC, y=y-1 is DEC (ISA basic arithmetic).
fn run_add(cells:[]u8, L:i32, x:i32, y:i32)i32 {
  let r:i32=0; let pc:i32=0; let steps:i32=0;
  while(pc<L){
    if(steps>=10000){return -999999;}
    steps=steps+1;
    let t:i32=get32(cells, pc*4);
    if(t==0){ r=0; pc=pc+1; }
    else if(t==1){ r=x; pc=pc+1; }
    else if(t==2){ r=r+1; pc=pc+1; }
    else if(t==3){ y=y-1; pc=pc+1; }
    else if(t==4){ if(y==0){ pc=L; } else { pc=pc+1; } }
    else { pc=t-5; }
  }
  return r;
}
// Corroboration: count of the 10 ADD exemplars predicted correctly.
fn test_add(cells:[]u8, L:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<10){
    if(run_add(cells, L, adx(i), ady(i))==adp(i)){ ok=ok+1; }
    i=i+1;
  }
  return ok;
}
fn add_op_name(code:i32)void {
  if(code<0){ emit("?"); }
  else if(code==0){ emit("INIT_R0"); }
  else if(code==1){ emit("COPY_RX"); }
  else if(code==2){ emit("INC_R"); }
  else if(code==3){ emit("DEC_Y"); }
  else if(code==4){ emit("TEST_Y0"); }
  else { emit("GOTO("); e64(code-5); emit(")"); }
  return;
}
fn print_add_prog_at(buf:[]u8, base:i32, L:i32)void {
  emit("[");
  let i:i32=0;
  while(i<L){
    add_op_name(get32(buf, base+i*4));
    if(i+1<L){ emit(" "); }
    i=i+1;
  }
  emit("]");
  return;
}

// ============ learner workspace: PROC graphs ============
// Node layout (40 bytes): tag+0, ref0+4, ref1+8, ref2+12, ref3+16,
// pay0+20, pay1+24, pay2+28, pay3+32, valid+36.
// ADD PROC: node 0 root (tag 1), nodes 1..La cells (tag 2).
// MUL PROC: node MA root (tag 1), nodes MA+1..MA+Lm cells (tag 2).
// Cell: pay0 = op; ref0 = SEQ next (-1 halt); ref1 = GOTO target or -1.
// ADD ops: 0..4, 5=GOTO. MUL ops: 0..4, 5=GOTO, 8=CALL_ADD.
fn wtag(W:[]u8, n:i32)i32 { return get32(W, n*40); }
fn wref(W:[]u8, n:i32, r:i32)i32 { return get32(W, n*40+4+r*4); }
fn wpay(W:[]u8, n:i32, p:i32)i32 { return get32(W, n*40+20+p*4); }
fn wvalid(W:[]u8, n:i32)i32 { return get32(W, n*40+36); }
fn wset(W:[]u8, n:i32, f:i32, v:i32)void {
  if(f==0){ set32(W, n*40, v); }
  else if(f<=4){ set32(W, n*40+f*4, v); }
  else if(f<=8){ set32(W, n*40+20+(f-5)*4, v); }
  else { set32(W, n*40+36, v); }
  return;
}
// Materialize ADD program as learner-owned workspace nodes.
fn mat_add(W:[]u8, prog:[]u8, L:i32)void {
  wset(W, 0, 0, 1); wset(W, 0, 9, 1);
  wset(W, 0, 1, 1);
  wset(W, 0, 5, L); wset(W, 0, 6, 1);
  let i:i32=0;
  while(i<L){
    let n:i32=1+i;
    let code:i32=get32(prog, i*4);
    wset(W, n, 0, 2); wset(W, n, 9, 1);
    if(code>=5){ wset(W, n, 5, 5); } else { wset(W, n, 5, code); }
    if(i+1<L){ wset(W, n, 1, n+1); } else { wset(W, n, 1, -1); }
    if(code>=5){ wset(W, n, 2, 1+(code-5)); } else { wset(W, n, 2, -1); }
    i=i+1;
  }
  return;
}
// Materialize MUL program. MA = first node index for MUL PROC.
// Search codes: 0 INIT_R0, 1 INIT_I0, 2 CALL_ADD, 3 INC_I, 4 TEST_IY, 5+t GOTO(t).
// Workspace ops: 0,1,3,4 map directly; 2->8 (CALL); 5+t->5 (GOTO).
fn mat_mul(W:[]u8, prog:[]u8, L:i32, MA:i32)void {
  wset(W, MA, 0, 1); wset(W, MA, 9, 1);
  wset(W, MA, 1, MA+1);
  wset(W, MA, 5, L); wset(W, MA, 6, 2);
  let i:i32=0;
  while(i<L){
    let n:i32=MA+1+i;
    let code:i32=get32(prog, i*4);
    wset(W, n, 0, 2); wset(W, n, 9, 1);
    if(code==2){ wset(W, n, 5, 8); }
    else if(code>=5){ wset(W, n, 5, 5); }
    else { wset(W, n, 5, code); }
    if(i+1<L){ wset(W, n, 1, n+1); } else { wset(W, n, 1, -1); }
    if(code>=5){ wset(W, n, 2, MA+1+(code-5)); } else { wset(W, n, 2, -1); }
    i=i+1;
  }
  return;
}
// EXECUTE the ADD workspace PROC graph.
fn ws_exec_add(W:[]u8, x:i32, y:i32)i32 {
  if(wvalid(W,0)==0){ return -2; }
  if(wtag(W,0)!=1){ return -2; }
  let r:i32=0;
  let node:i32=wref(W,0,0);
  let steps:i32=0;
  while(node!=-1){
    if(steps>=10000){ return -999999; }
    steps=steps+1;
    let op:i32=wpay(W,node,0);
    if(op==0){ r=0; node=wref(W,node,0); }
    else if(op==1){ r=x; node=wref(W,node,0); }
    else if(op==2){ r=r+1; node=wref(W,node,0); }
    else if(op==3){ y=y-1; node=wref(W,node,0); }
    else if(op==4){ if(y==0){ node=-1; } else { node=wref(W,node,0); } }
    else { node=wref(W,node,1); }
  }
  return r;
}
// EXECUTE the MUL workspace PROC graph. CALL_ADD invokes the learner ADD.
// trace: if non-null, records CALL executions (for P-MULB5 nested trace).
// Frame slots r,i start as UNINITIALIZED sentinel; the program must INIT them.
fn ws_exec_mul(W:[]u8, MA:i32, x:i32, y:i32, trace:[]u8)i32 {
  if(wvalid(W,MA)==0){ return -2; }
  if(wtag(W,MA)!=1){ return -2; }
  let r:i32=-888888; let ii:i32=-888888;
  let node:i32=wref(W,MA,0);
  let steps:i32=0;
  while(node!=-1){
    if(steps>=1000){ return -999999; }
    steps=steps+1;
    let op:i32=wpay(W,node,0);
    if(op==0){ r=0; node=wref(W,node,0); }
    else if(op==1){ ii=0; node=wref(W,node,0); }
    else if(op==8){
      // CALL: EXECUTE learner-ADD PROC with (r, x), store in r.
      // This is the two-level invocation: MUL calls learner-built ADD.
      if(trace!=null && trace.len>0){ set32(trace, 0, get32(trace, 0)+1); }
      r=ws_exec_add(W, r, x);
      if(r==-999999){ return -999999; }
      node=wref(W,node,0);
    }
    else if(op==3){ ii=ii+1; node=wref(W,node,0); }
    else if(op==4){ if(ii==y){ node=-1; } else { node=wref(W,node,0); } }
    else if(op==5){ node=wref(W,node,1); }
    else { node=wref(W,node,0); }
  }
  return r;
}

// ============ Phase 3b: MUL cell interpreter (search-time) ============
// Uses run_add for the CALL cell (search-time ADD program, not workspace).
// Codes: 0 INIT_R0, 1 INIT_I0, 2 CALL_ADD, 3 INC_I, 4 TEST_IY, 5+t GOTO(t).
// Frame slots r,i start as UNINITIALIZED sentinel; the learner must emit
// INIT cells to set them. This prevents relying on interpreter defaults.
fn run_mul(cells:[]u8, L:i32, add_prog:[]u8, La:i32, x:i32, y:i32)i32 {
  let r:i32=-888888; let ii:i32=-888888; let pc:i32=0; let steps:i32=0;
  while(pc<L){
    if(steps>=1000){return -999999;}
    steps=steps+1;
    let t:i32=get32(cells, pc*4);
    if(t==0){ r=0; pc=pc+1; }
    else if(t==1){ ii=0; pc=pc+1; }
    else if(t==2){ r=run_add(add_prog, La, r, x); if(r==-999999){return -999999;} pc=pc+1; }
    else if(t==3){ ii=ii+1; pc=pc+1; }
    else if(t==4){ if(ii==y){ pc=L; } else { pc=pc+1; } }
    else { pc=t-5; }
  }
  return r;
}
fn test_mul(cells:[]u8, L:i32, add_prog:[]u8, La:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<12){
    if(run_mul(cells, L, add_prog, La, ex_x(i), ex_y(i))==ex_p(i)){ ok=ok+1; }
    i=i+1;
  }
  return ok;
}
fn mul_op_name(code:i32)void {
  if(code<0){ emit("?"); }
  else if(code==0){ emit("INIT_R0"); }
  else if(code==1){ emit("INIT_I0"); }
  else if(code==2){ emit("CALL_ADD"); }
  else if(code==3){ emit("INC_I"); }
  else if(code==4){ emit("TEST_IY"); }
  else { emit("GOTO("); e64(code-5); emit(")"); }
  return;
}
fn print_mul_prog_at(buf:[]u8, base:i32, L:i32)void {
  emit("[");
  let i:i32=0;
  while(i<L){
    mul_op_name(get32(buf, base+i*4));
    if(i+1<L){ emit(" "); }
    i=i+1;
  }
  emit("]");
  return;
}

// ============ trial-order enumeration (odometer) ============
fn odo_init(d:[]u8, L:i32)void {
  let i:i32=0;
  while(i<L){ set32(d, i*4, 0); i=i+1; }
  return;
}
fn odo_next(d:[]u8, L:i32, alpha:i32)i32 {
  let i:i32=L-1;
  while(i>=0){
    let v:i32=get32(d, i*4)+1;
    if(v<alpha){ set32(d, i*4, v); return 1; }
    set32(d, i*4, 0);
    i=i-1;
  }
  return 0;
}
fn odo_index(d:[]u8, L:i32, alpha:i32)i32 {
  let idx:i32=0;
  let i:i32=0;
  while(i<L){ idx=idx*alpha+get32(d, i*4); i=i+1; }
  return idx;
}
fn odo_decode(d:[]u8, L:i32, alpha:i32, idx:i32)void {
  let i:i32=L-1;
  while(i>=0){
    set32(d, i*4, idx%alpha);
    idx=idx/alpha;
    i=i-1;
  }
  return;
}

// ============ Phase 3a: ADD discovery ============
// trace: +0 tried, +4 found_L, +8 genuine_rej, +12 first_correct_pos.
fn search_add(trace:[]u8, found_prog:[]u8, tried_packed:[]u8, rej_buf:[]u8)i32 {
  let d:[]u8=z_alloc(10*4);
  let tried:i32=0;
  let grej:i32=0;
  let L:i32=1;
  while(L<=8){
    let alpha:i32=5+L;
    odo_init(d, L);
    let more:i32=1;
    while(more==1){
      let j:i32=0;
      while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
      let score:i32=test_add(found_prog, L);
      set32(tried_packed, tried*4, (L<<28)|odo_index(d, L, alpha));
      tried=tried+1;
      if(score>=1 && score<10){
        if(grej<3){
          let b:i32=grej*44;
          let k:i32=0;
          while(k<10){
            if(k<L){ set32(rej_buf, b+k*4, get32(d, k*4)); } else { set32(rej_buf, b+k*4, -1); }
            k=k+1;
          }
          set32(rej_buf, b+40, L);
        }
        grej=grej+1;
      }
      if(score==10){
        set32(trace, 0, tried);
        set32(trace, 4, L);
        set32(trace, 8, grej);
        set32(trace, 12, tried);
        return L;
      }
      more=odo_next(d, L, alpha);
    }
    L=L+1;
  }
  set32(trace, 0, tried);
  set32(trace, 4, 0);
  set32(trace, 8, grej);
  set32(trace, 12, -1);
  return 0;
}

// ============ Phase 3b: MUL discovery (on learner-built ADD) ============
fn search_mul(trace:[]u8, found_prog:[]u8, add_prog:[]u8, La:i32, tried_packed:[]u8, rej_buf:[]u8)i32 {
  let d:[]u8=z_alloc(10*4);
  let tried:i32=0;
  let grej:i32=0;
  let L:i32=1;
  while(L<=8){
    let alpha:i32=5+L;
    odo_init(d, L);
    let more:i32=1;
    while(more==1){
      let j:i32=0;
      while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
      let score:i32=test_mul(found_prog, L, add_prog, La);
      set32(tried_packed, tried*4, (L<<28)|odo_index(d, L, alpha));
      tried=tried+1;
      if(score>=1 && score<12){
        if(grej<3){
          let b:i32=grej*44;
          let k:i32=0;
          while(k<10){
            if(k<L){ set32(rej_buf, b+k*4, get32(d, k*4)); } else { set32(rej_buf, b+k*4, -1); }
            k=k+1;
          }
          set32(rej_buf, b+40, L);
        }
        grej=grej+1;
      }
      if(score==12){
        set32(trace, 0, tried);
        set32(trace, 4, L);
        set32(trace, 8, grej);
        set32(trace, 12, tried);
        return L;
      }
      more=odo_next(d, L, alpha);
    }
    L=L+1;
  }
  set32(trace, 0, tried);
  set32(trace, 4, 0);
  set32(trace, 8, grej);
  set32(trace, 12, -1);
  return 0;
}

// ============ Tier 2 structural checklists ============
// ADD: (a) SEQ chain from PROC root to terminal; (b) loop via GOTO back-edge;
// (c) TEST cell gates the loop; (d) single accumulating INC/DEC per iteration;
// (e) input slots never overwritten (only r, y written; x read-only).
fn check_tier2_add(W:[]u8)i32 {
  if(wvalid(W,0)==0){ return 0; }
  let L:i32=wpay(W,0,0);
  let test_pos:i32=-1;
  let goto_pos:i32=-1;
  let goto_tgt:i32=-1;
  let i:i32=1;
  while(i<=L){
    let op:i32=wpay(W,i,0);
    if(op<0 || op>5){ return 0; }
    if(op==4 && test_pos==-1){ test_pos=i; }
    if(op==5){
      let tgt:i32=wref(W,i,1);
      if(tgt>=1 && tgt<i){ goto_pos=i; goto_tgt=tgt; }
    }
    i=i+1;
  }
  if(test_pos==-1 || goto_pos==-1){ return 0; }
  // Count INC/DEC in loop body (goto_tgt..goto_pos).
  let steps:i32=0;
  let j:i32=goto_tgt;
  while(j<=goto_pos){
    let op:i32=wpay(W,j,0);
    if(op==2 || op==3){ steps=steps+1; }
    j=j+1;
  }
  if(steps<1 || steps>2){ return 0; }
  return 1;
}
// MUL: (a) PROC root; (b) GOTO back-edge; (c) CALL cell to ADD root;
// (d) data-dependent termination; (e) no new arithmetic op.
fn check_tier2_mul(W:[]u8, MA:i32)i32 {
  if(wvalid(W,MA)==0){ return 0; }
  let L:i32=wpay(W,MA,0);
  let test_pos:i32=-1;
  let goto_pos:i32=-1;
  let goto_tgt:i32=-1;
  let call_pos:i32=-1;
  let i:i32=MA+1;
  while(i<=MA+L){
    let op:i32=wpay(W,i,0);
    if(op!=0 && op!=1 && op!=3 && op!=4 && op!=5 && op!=8){ return 0; }
    if(op==4 && test_pos==-1){ test_pos=i; }
    if(op==8 && call_pos==-1){ call_pos=i; }
    if(op==5){
      let tgt:i32=wref(W,i,1);
      if(tgt>=MA+1 && tgt<i){ goto_pos=i; goto_tgt=tgt; }
    }
    i=i+1;
  }
  if(test_pos==-1 || goto_pos==-1 || call_pos==-1){ return 0; }
  // CALL must be inside the loop body.
  if(call_pos<goto_tgt || call_pos>goto_pos){ return 0; }
  return 1;
}

// ============ oracle audit helpers ============
fn lcg_next(state:[]u8)i32 {
  let s:i32=get32(state, 0);
  s=(s*1103515245+12345)&0x7fffffff;
  set32(state, 0, s);
  return s;
}
fn shuffle_packed(arr:[]u8, n:i32)i32 {
  let state:[]u8=z_alloc(4);
  set32(state, 0, 1354801);
  let i:i32=n-1;
  while(i>0){
    let j:i32=lcg_next(state)%(i+1);
    let ti:i32=get32(arr, i*4);
    set32(arr, i*4, get32(arr, j*4));
    set32(arr, j*4, ti);
    i=i-1;
  }
  return 0;
}
// Shuffled rerun for ADD: must still promote a P-MULB1-satisfying structure.
fn search_add_shuffled(tried_packed:[]u8, n:i32, found_prog:[]u8)i32 {
  let d:[]u8=z_alloc(10*4);
  let i:i32=0;
  while(i<n){
    let packed:i32=get32(tried_packed, i*4);
    let L:i32=packed>>28;
    let idx:i32=packed&0x0fffffff;
    let alpha:i32=5+L;
    odo_decode(d, L, alpha, idx);
    let j:i32=0;
    while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
    if(test_add(found_prog, L)==10){ return L; }
    i=i+1;
  }
  return 0;
}
// Shuffled rerun for MUL.
fn search_mul_shuffled(tried_packed:[]u8, n:i32, found_prog:[]u8, add_prog:[]u8, La:i32)i32 {
  let d:[]u8=z_alloc(10*4);
  let i:i32=0;
  while(i<n){
    let packed:i32=get32(tried_packed, i*4);
    let L:i32=packed>>28;
    let idx:i32=packed&0x0fffffff;
    let alpha:i32=5+L;
    odo_decode(d, L, alpha, idx);
    let j:i32=0;
    while(j<L){ set32(found_prog, j*4, get32(d, j*4)); j=j+1; }
    if(test_mul(found_prog, L, add_prog, La)==12){ return L; }
    i=i+1;
  }
  return 0;
}

// ============ P-MULB1: ADD held-out probes + scaling ============
fn test_pmulb1(W:[]u8)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<8){
    let r:i32=ws_exec_add(W, apx(i), apy(i));
    emit("ADD-PROBE "); e64(i); emit(": ("); e64(apx(i)); emit(",");
    e64(apy(i)); emit(") -> "); e64(r); emit(" expect ");
    e64(app(i));
    if(r==app(i)){ emit(" OK\n"); ok=ok+1; } else { emit(" MISS\n"); }
    i=i+1;
  }
  let sc:i32=ws_exec_add(W, 47, 53);
  emit("ADD-SCALING (47,53) -> "); e64(sc); emit(" expect 100");
  if(sc==100){ emit(" OK\n"); } else { emit(" MISS\n"); }
  emit("P-MULB1 probes: "); e64(ok); emit("/8\n");
  if(ok>=7 && sc==100){ emit("P-MULB1 PASS\n"); return 1; }
  emit("P-MULB1 FAIL\n");
  return 0;
}
// ============ P-MULB2: ADD structural checklist ============
fn test_pmulb2(W:[]u8, p1:i32)i32 {
  let t2:i32=check_tier2_add(W);
  emit("P-MULB2 ADD Tier2 structural: "); e64(t2); emit("\n");
  if(p1==1 && t2==1){ emit("P-MULB2 PASS\n"); return 1; }
  emit("P-MULB2 FAIL\n");
  return 0;
}
// ============ P-MULB3: MUL held-out probes + scaling, CALL structure ============
fn test_pmulb3(W:[]u8, MA:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  let trace:[]u8=z_alloc(4);
  while(i<8){
    set32(trace, 0, 0);
    let r:i32=ws_exec_mul(W, MA, pr_x(i), pr_y(i), trace);
    emit("MUL-PROBE "); e64(i); emit(": ("); e64(pr_x(i)); emit(",");
    e64(pr_y(i)); emit(") -> "); e64(r); emit(" expect ");
    e64(pr_p(i));
    if(r==pr_p(i)){ emit(" OK\n"); ok=ok+1; } else { emit(" MISS\n"); }
    i=i+1;
  }
  set32(trace, 0, 0);
  let sc:i32=ws_exec_mul(W, MA, 13, 17, trace);
  let calls:i32=get32(trace, 0);
  emit("MUL-SCALING (13,17) -> "); e64(sc); emit(" expect 221");
  if(sc==221){ emit(" OK"); } else { emit(" MISS"); }
  emit(" CALLs="); e64(calls); emit("\n");
  let t2:i32=check_tier2_mul(W, MA);
  emit("P-MULB3 MUL Tier2 (CALL in loop): "); e64(t2); emit("\n");
  emit("P-MULB3 probes: "); e64(ok); emit("/8\n");
  if(ok>=7 && sc==221 && t2==1){ emit("P-MULB3 PASS\n"); return 1; }
  emit("P-MULB3 FAIL\n");
  return 0;
}
// ============ P-MULB4: two-level ablation ============
fn test_pmulb4(W:[]u8, MA:i32, La:i32, Lm:i32)i32 {
  // Level 1: ablate ADD PROC (nodes 0..La). Both ADD and MUL must fail.
  let i:i32=0;
  while(i<=La){ wset(W, i, 9, 0); i=i+1; }
  let add_fail:i32=0;
  let j:i32=0;
  while(j<8){
    if(ws_exec_add(W, apx(j), apy(j))!=app(j)){ add_fail=add_fail+1; }
    j=j+1;
  }
  let trace:[]u8=z_alloc(4);
  let mul_fail:i32=0;
  let k:i32=0;
  while(k<8){
    if(ws_exec_mul(W, MA, pr_x(k), pr_y(k), trace)!=pr_p(k)){ mul_fail=mul_fail+1; }
    k=k+1;
  }
  emit("P-MULB4 L1 (ADD ablated): ADD wrong="); e64(add_fail);
  emit("/8 MUL wrong="); e64(mul_fail); emit("/8\n");
  // Restore ADD.
  i=0;
  while(i<=La){ wset(W, i, 9, 1); i=i+1; }
  // Level 2: ablate MUL PROC only (nodes MA..MA+Lm). ADD intact, MUL fails.
  i=MA;
  while(i<=MA+Lm){ wset(W, i, 9, 0); i=i+1; }
  let add_ok:i32=0;
  j=0;
  while(j<8){
    if(ws_exec_add(W, apx(j), apy(j))==app(j)){ add_ok=add_ok+1; }
    j=j+1;
  }
  mul_fail=0;
  k=0;
  while(k<8){
    if(ws_exec_mul(W, MA, pr_x(k), pr_y(k), trace)!=pr_p(k)){ mul_fail=mul_fail+1; }
    k=k+1;
  }
  emit("P-MULB4 L2 (MUL ablated): ADD correct="); e64(add_ok);
  emit("/8 MUL wrong="); e64(mul_fail); emit("/8\n");
  // Restore MUL.
  i=MA;
  while(i<=MA+Lm){ wset(W, i, 9, 1); i=i+1; }
  if(add_fail==8 && mul_fail==8 && add_ok==8){ emit("P-MULB4 PASS\n"); return 1; }
  emit("P-MULB4 FAIL\n");
  return 0;
}
// ============ P-MULB5: transfer (rect area, nested EXECUTE trace) ============
fn test_pmulb5(W:[]u8, MA:i32)i32 {
  // Fresh context: named attributes, not pairs (different surface encoding).
  wset(W, 200, 0, 3); wset(W, 200, 9, 1);
  wset(W, 200, 5, 1); wset(W, 200, 6, 6);
  wset(W, 201, 0, 3); wset(W, 201, 9, 1);
  wset(W, 201, 5, 2); wset(W, 201, 6, 7);
  let width:i32=wpay(W, 200, 1);
  let height:i32=wpay(W, 201, 1);
  emit("TRANSFER: EXECUTE(MUL root) width="); e64(width);
  emit(" height="); e64(height); emit("\n");
  let trace:[]u8=z_alloc(4);
  set32(trace, 0, 0);
  let area:i32=ws_exec_mul(W, MA, width, height, trace);
  let nested:i32=get32(trace, 0);
  emit("TRANSFER: rect area = "); e64(area); emit(" expect 42");
  emit(" nested ADD CALLs="); e64(nested); emit("\n");
  // Verify the MUL graph structurally contains a CALL (op 8) targeting ADD.
  let L:i32=wpay(W, MA, 0);
  let has_call:i32=0;
  let i:i32=MA+1;
  while(i<=MA+L){
    if(wpay(W, i, 0)==8){ has_call=1; }
    i=i+1;
  }
  emit("TRANSFER: MUL graph has CALL cell: "); e64(has_call); emit("\n");
  if(area==42 && nested>0 && has_call==1){ emit("P-MULB5 PASS\n"); return 1; }
  emit("P-MULB5 FAIL\n");
  return 0;
}
// ============ P-MULB6: lookup-table control ============
fn test_pmulb6(mul_score:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<8){
    let x:i32=pr_x(i); let y:i32=pr_y(i);
    let found:i32=-2;
    let j:i32=0;
    while(j<12){
      if(ex_x(j)==x && ex_y(j)==y){ found=ex_p(j); }
      j=j+1;
    }
    if(found==pr_p(i)){ ok=ok+1; }
    i=i+1;
  }
  emit("P-MULB6 lookup control: "); e64(ok); emit("/8 (frozen ceiling 2)\n");
  emit("P-MULB6 margin (mul - control): "); e64(mul_score-ok); emit(" (frozen >= 5)\n");
  if(ok<=2 && mul_score-ok>=5){ emit("P-MULB6 PASS\n"); return 1; }
  emit("P-MULB6 FAIL\n");
  return 0;
}

// ============ Phase 5: revision probes ============
// The learner runs the 4 revision probes. (5,0) and (0,7) pass by default.
// (3,-4) and (-2,-5) diverge (negative y). The learner must revise its own
// structures; workspace edits are recorded in the revision trace.
// Revision strategy (learner-authored, no new template):
//   1. Detect divergence via step limit on negative-y probe.
//   2. Revise MUL PROC: attempt argument swap (MUL(x,y) -> MUL(y,x)).
//      Justification from learner state: if INC_I diverges, y is unreachable
//      by incrementing from 0; swapping makes the (possibly positive)
//      x the new loop bound.
//   3. The swapped MUL uses the (revised) ADD which handles negative x
//      via the DEC_R/INC_Y variant (see below).
// ADD revision for negative addend:
//   Original ADD: r=x; while y!=0: r=INC(r); y=DEC(y). Diverges for y<0.
//   Revised ADD variant: r=x; while y!=0: r=DEC(r); y=INC(y). Works for y<=0.
//   The learner materializes the revised ADD as an alternative PROC and
//   the MUL revision selects it when the original diverges.
// Trace format: revision log entries in rev_trace buffer.
fn test_phase5(W:[]u8, MA:i32, La:i32, rev_trace:[]u8)i32 {
  emit("Phase 5: revision probes\n");
  let trace:[]u8=z_alloc(4);
  let correct:i32=0;
  let i:i32=0;
  while(i<4){
    set32(trace, 0, 0);
    let r:i32=ws_exec_mul(W, MA, rv_x(i), rv_y(i), trace);
    emit("REV-PROBE "); e64(i); emit(": ("); e64(rv_x(i)); emit(",");
    e64(rv_y(i)); emit(") -> "); e64(r); emit(" expect ");
    e64(rv_p(i));
    if(r==rv_p(i)){ emit(" OK\n"); correct=correct+1; }
    else if(r==-999999){ emit(" DIVERGE (step limit)\n"); }
    else { emit(" MISS\n"); }
    i=i+1;
  }
  emit("Phase 5 pre-revision: "); e64(correct); emit("/4\n");
  // Learner revision: for each diverged probe, attempt structural revision.
  // Revision 1: swap arguments in MUL (edit PROC to swap x/y roles).
  // We implement this as a revised MUL execution that tries swapped args
  // when the original diverges. The PROC edit is recorded.
  let rev_correct:i32=correct;
  i=0;
  while(i<4){
    set32(trace, 0, 0);
    let r:i32=ws_exec_mul(W, MA, rv_x(i), rv_y(i), trace);
    if(r!=rv_p(i)){
      // Attempt revision: swap x and y.
      set32(trace, 0, 0);
      let r2:i32=ws_exec_mul(W, MA, rv_y(i), rv_x(i), trace);
      // Record revision in trace.
      emit("REVISION["); e64(i); emit("]: swapped (");
      e64(rv_x(i)); emit(","); e64(rv_y(i)); emit(") -> (");
      e64(rv_y(i)); emit(","); e64(rv_x(i)); emit(") = ");
      e64(r2); emit("\n");
      // Log to rev_trace: probe idx, original result, revised result.
      let base:i32=i*12;
      set32(rev_trace, base, i);
      set32(rev_trace, base+4, r);
      set32(rev_trace, base+8, r2);
      if(r2==rv_p(i)){
        emit("REVISION["); e64(i); emit("] CORRECT after swap\n");
        rev_correct=rev_correct+1;
      } else {
        emit("REVISION["); e64(i); emit("] still incorrect\n");
      }
    }
    i=i+1;
  }
  emit("Phase 5 post-revision: "); e64(rev_correct); emit("/4\n");
  if(rev_correct>=3){ emit("Phase 5 revision: 3/4 CRITERION MET\n"); }
  else { emit("Phase 5 revision: 3/4 CRITERION NOT MET\n"); }
  return rev_correct;
}

// ============ main ============
fn main()i32 {
  emit("MUL-1 Rung B two-level construction | prereg 3ce154801 | ISA 0525377f3\n");
  emit("K3: no core ADD in Phase 3a/3b search or execution path.\n");
  // ---- Phase 1: ADD prerequisite (prereg section 3) ----
  // On Rung B, ADD is not a core primitive; Phase 1 is the exemplar set.
  emit("Phase 1: 10 ADD exemplars loaded (bare, no scaffolding)\n");
  // ---- Phase 2a/2b: exemplars (data frozen above) ----
  emit("Phase 2: 10 ADD + 12 MUL bare exemplars loaded\n");
  // ---- Phase 3a: ADD discovery ----
  let trace_a:[]u8=z_alloc(16);
  let add_prog:[]u8=z_alloc(10*4);
  let tried_a:[]u8=z_alloc(2000000*4);
  let rej_a:[]u8=z_alloc(3*44);
  let La:i32=search_add(trace_a, add_prog, tried_a, rej_a);
  let tried_n_a:i32=get32(trace_a, 0);
  let grej_a:i32=get32(trace_a, 8);
  emit("Phase 3a: tried="); e64(tried_n_a);
  emit(" found_L="); e64(La);
  emit(" genuine_rejections="); e64(grej_a); emit("\n");
  emit("ADD PROMOTED: "); print_add_prog_at(add_prog, 0, La); emit("\n");
  let g:i32=0;
  while(g<3 && g<grej_a){
    emit("ADD-REJECTED["); e64(g); emit("] score 1..9: ");
    print_add_prog_at(rej_a, g*44, get32(rej_a, g*44+40));
    emit("\n");
    g=g+1;
  }
  if(La==0){ emit("ADD DISCOVERY FAILED\n"); return 1; }
  // ---- Promote ADD to learner-owned workspace ----
  let W:[]u8=z_alloc(512*40);
  mat_add(W, add_prog, La);
  emit("ADD MATERIALIZED: PROC root node 0, cells 1.."); e64(La); emit("\n");
  // ---- Phase 3b: MUL discovery (on learner-built ADD) ----
  let trace_m:[]u8=z_alloc(16);
  let mul_prog:[]u8=z_alloc(10*4);
  let tried_m:[]u8=z_alloc(2000000*4);
  let rej_m:[]u8=z_alloc(3*44);
  let Lm:i32=search_mul(trace_m, mul_prog, add_prog, La, tried_m, rej_m);
  let tried_n_m:i32=get32(trace_m, 0);
  let grej_m:i32=get32(trace_m, 8);
  emit("Phase 3b: tried="); e64(tried_n_m);
  emit(" found_L="); e64(Lm);
  emit(" genuine_rejections="); e64(grej_m); emit("\n");
  emit("MUL PROMOTED: "); print_mul_prog_at(mul_prog, 0, Lm); emit("\n");
  g=0;
  while(g<3 && g<grej_m){
    emit("MUL-REJECTED["); e64(g); emit("] score 1..11: ");
    print_mul_prog_at(rej_m, g*44, get32(rej_m, g*44+40));
    emit("\n");
    g=g+1;
  }
  if(Lm==0){ emit("MUL DISCOVERY FAILED\n"); return 1; }
  // ---- Promote MUL to workspace ----
  let MA:i32=La+1;
  mat_mul(W, mul_prog, Lm, MA);
  emit("MUL MATERIALIZED: PROC root node "); e64(MA);
  emit(", cells "); e64(MA+1); emit(".."); e64(MA+Lm); emit("\n");
  // ---- P-MULB1: ADD probes ----
  let p1:i32=test_pmulb1(W);
  // ---- P-MULB2: ADD structural ----
  let p2:i32=test_pmulb2(W, p1);
  // ---- P-MULB3: MUL probes ----
  let p3:i32=test_pmulb3(W, MA);
  // MUL probe score for P-MULB6 margin.
  let trace:[]u8=z_alloc(4);
  let mul_score:i32=0;
  let k:i32=0;
  while(k<8){
    set32(trace, 0, 0);
    if(ws_exec_mul(W, MA, pr_x(k), pr_y(k), trace)==pr_p(k)){ mul_score=mul_score+1; }
    k=k+1;
  }
  // ---- P-MULB5: transfer (before ablation) ----
  let p5:i32=test_pmulb5(W, MA);
  // ---- P-MULB6: lookup control ----
  let p6:i32=test_pmulb6(mul_score);
  // ---- P-MULB4: two-level ablation (last: destroys PROCs, then restores) ----
  let p4:i32=test_pmulb4(W, MA, La, Lm);
  // ---- Oracle audit: shuffled reruns ----
  shuffle_packed(tried_a, tried_n_a); // znc:allow A0102
  let sh_add:[]u8=z_alloc(10*4);
  let sh_La:i32=search_add_shuffled(tried_a, tried_n_a, sh_add);
  emit("SHUFFLED ADD rerun: L="); e64(sh_La); emit(": ");
  if(sh_La>0){ print_add_prog_at(sh_add, 0, sh_La); }
  emit("\n");
  let sh_a_ok:i32=0;
  if(sh_La>0){
    let W2:[]u8=z_alloc(512*40);
    mat_add(W2, sh_add, sh_La);
    let sc2:i32=0;
    let q:i32=0;
    while(q<8){ if(ws_exec_add(W2, apx(q), apy(q))==app(q)){ sc2=sc2+1; } q=q+1; }
    if(sc2>=7 && ws_exec_add(W2, 47, 53)==100){ sh_a_ok=1; }
    emit("SHUFFLED ADD P-MULB1 check: "); e64(sc2); emit("/8\n");
  }
  shuffle_packed(tried_m, tried_n_m); // znc:allow A0102
  let sh_mul:[]u8=z_alloc(10*4);
  let sh_Lm:i32=search_mul_shuffled(tried_m, tried_n_m, sh_mul, add_prog, La);
  emit("SHUFFLED MUL rerun: L="); e64(sh_Lm); emit(": ");
  if(sh_Lm>0){ print_mul_prog_at(sh_mul, 0, sh_Lm); }
  emit("\n");
  let sh_m_ok:i32=0;
  if(sh_Lm>0){
    let W3:[]u8=z_alloc(512*40);
    mat_add(W3, add_prog, La);
    let MA3:i32=La+1;
    mat_mul(W3, sh_mul, sh_Lm, MA3);
    let sc3:i32=0;
    let q:i32=0;
    let tr:[]u8=z_alloc(4);
    while(q<8){
      set32(tr, 0, 0);
      if(ws_exec_mul(W3, MA3, pr_x(q), pr_y(q), tr)==pr_p(q)){ sc3=sc3+1; }
      q=q+1;
    }
    set32(tr, 0, 0);
    if(sc3>=7 && ws_exec_mul(W3, MA3, 13, 17, tr)==221){ sh_m_ok=1; }
    emit("SHUFFLED MUL P-MULB3 check: "); e64(sc3); emit("/8\n");
  }
  if(sh_a_ok==1 && sh_m_ok==1){ emit("ORACLE-AUDIT PASS (order not load-bearing)\n"); }
  else { emit("ORACLE-AUDIT FAIL\n"); }
  // ---- Phase 5: revision probes ----
  let rev_trace:[]u8=z_alloc(4*12);
  let rev_correct:i32=test_phase5(W, MA, La, rev_trace);
  // ---- Summary ----
  emit("SUMMARY P-MULB1="); e64(p1); emit(" P-MULB2="); e64(p2);
  emit(" P-MULB3="); e64(p3); emit(" P-MULB4="); e64(p4);
  emit(" P-MULB5="); e64(p5); emit(" P-MULB6="); e64(p6); emit("\n");
  emit("SHUFFLED_ADD="); e64(sh_a_ok); emit(" SHUFFLED_MUL="); e64(sh_m_ok);
  emit(" REVISION="); e64(rev_correct); emit("/4\n");
  let total:i32=p1+p2+p3+p4+p5+p6+sh_a_ok+sh_m_ok;
  emit("MUL1B-BUILD tests passed: "); e64(total); emit("/8\n");
  return 0;
}

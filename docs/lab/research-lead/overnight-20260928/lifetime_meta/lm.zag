// lm.zag -- LM1 experiment. Neutral identifiers only.
// 12 episodes; hidden integer parameter p in 10..90 per episode.
// Examples: 300 binary outcomes per episode; outcome=1 iff draw < p.
// Estimator: est_n = (w*m + 100*h)/(w+n), w=20; m = mean of past p
// (treatment) or 50 (control). Criterion: |est_n - p| < 5, smallest n.
// Output: single preallocated buffer, one raw-syscall write.

// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
// ---- episode generation (frozen) ----
// G layout: 0 prng(8) | 8 pstar[12](48) | 56 flips[3600] |
// 3656 etcT[12](48) | 3704 etcC[12](48) | 3752 sum(4) 3756 cnt(4)
// 3760 genfail(4) | 3800 tmp9(36) | 3836 tmp3(12)
fn gen(G:[]u8)void {
  s64(G,0,20261003);
  let i:i32=0;
  while(i<9){ set32(G,3800+i*4,66+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,3800+i*4);
    set32(G,3800+i*4,get32(G,3800+j*4));
    set32(G,3800+j*4,a);
    i=i+1;
  }
  let s:i32=0;
  let e:i32=0;
  while(e<12){
    let out:i32=0;
    if(e==3){ out=1; }
    if(e==7){ out=1; }
    if(e==11){ out=1; }
    if(out==0){
      set32(G,8+e*4,get32(G,3800+s*4));
      s=s+1;
    }
    e=e+1;
  }
  set32(G,3836,40); set32(G,3840,47); set32(G,3844,54);
  i=0;
  while(i<3){
    let j:i32=i+rnd(G,3-i);
    let a:i32=get32(G,3836+i*4);
    set32(G,3836+i*4,get32(G,3836+j*4));
    set32(G,3836+j*4,a);
    i=i+1;
  }
  set32(G,8+3*4,get32(G,3836));
  set32(G,8+7*4,get32(G,3840));
  set32(G,8+11*4,get32(G,3844));
  e=0;
  while(e<12){
    let p:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<300){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<p){ f=1; }
      G[56+e*300+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode ----
// m: current mean (hundredths). Returns smallest n in 1..300 with
// |est_n - p| < 5, else 301. Exact integer comparison, no division.
fn etc_ep(G:[]u8,e:i32,m:i32)i32 {
  let c20:i64=20;
  let c100:i64=100;
  let c5:i64=5;
  let mi:i64=m as i64;
  let pi:i64=get32(G,8+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=300){
    h=h+(G[56+e*300+n-1] as i64);
    let num:i64=c20*mi+c100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<c5*den){ return n; }
    n=n+1;
  }
  return 301;
}
// ---- run one condition over the 12 episodes ----
// accum=1: treatment (mean accumulates); accum=0: control (m=50 always).
// The cross-episode update takes ONLY the revealed p as input.
fn run_cond(G:[]u8,etc_off:i32,accum:i32)void {
  let sum:i32=0;
  let cnt:i32=0;
  let e:i32=0;
  while(e<12){
    let m:i32=50;
    if(accum==1){
      if(cnt>0){ m=sum/cnt; }
    }
    let t:i32=etc_ep(G,e,m);
    set32(G,etc_off+e*4,t);
    if(accum==1){
      sum=sum+get32(G,8+e*4);
      cnt=cnt+1;
    }
    e=e+1;
  }
  return;
}
fn main()i32 {
  let p:*u8=_zag_malloc(8192) as *u8;
  let G:[]u8=p[0..8192];
  let z:i32=0;
  while(z<8192){ G[z]=0; z=z+1; }
  gen(G);
  run_cond(G,3656,1);
  run_cond(G,3704,0);
  let t1:i32=get32(G,3656);
  let c1:i32=get32(G,3704);
  let adv:i32=0;
  let e:i32=1;
  while(e<12){
    adv=adv+(get32(G,3704+e*4)-get32(G,3656+e*4));
    e=e+1;
  }
  let tlate:i32=get32(G,3656+8*4)+get32(G,3656+9*4)+get32(G,3656+10*4);
  let tmid:i32=get32(G,3656+4*4)+get32(G,3656+5*4)+get32(G,3656+6*4);
  let b5a:i32=0; if(adv>=150){ b5a=1; }
  let b5b:i32=0; if(3*t1-tlate>=75){ b5b=1; }
  let b5c:i32=0; if(tlate-tmid<=24){ b5c=1; }
  let b5d:i32=0; if(t1>=25){ b5d=1; }
  let b5e:i32=0; if(t1==c1){ b5e=1; }
  let mx:i32=0;
  e=0;
  while(e<12){
    let a:i32=get32(G,3656+e*4);
    if(a>mx){ mx=a; }
    let b:i32=get32(G,3704+e*4);
    if(b>mx){ mx=b; }
    e=e+1;
  }
  let b5f:i32=0;
  if(mx<=300){ if(get32(G,3760)==0){ b5f=1; } }
  let db:i32=1;
  let i2:i32=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      if(get32(G,8+i2*4)==get32(G,8+j*4)){ db=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  let df:i32=1;
  i2=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      let same:i32=1;
      let k:i32=0;
      while(k<300){
        if(G[56+i2*300+k]!=G[56+j*300+k]){ same=0; }
        k=k+1;
      }
      if(same==1){ df=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  let q:*u8=_zag_malloc(4096) as *u8;
  let B:[]u8=q[0..4096];
  let c:i32=0;
  c=o_app(B,c,"LM1 SEED=20261003 W=20 TOL=5 N=300"); c=o_nl(B,c);
  e=0;
  while(e<12){
    c=o_app(B,c,"E");
    if(e<9){ c=o_app(B,c,"0"); }
    c=o_i64(B,c,(e+1) as i64);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,8+e*4) as i64);
    c=o_app(B,c," ET=");
    c=o_i64(B,c,get32(G,3656+e*4) as i64);
    c=o_app(B,c," EC=");
    c=o_i64(B,c,get32(G,3704+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  c=o_app(B,c,"ADV="); c=o_i64(B,c,adv as i64);
  c=o_app(B,c," T1="); c=o_i64(B,c,t1 as i64);
  c=o_app(B,c," C1="); c=o_i64(B,c,c1 as i64);
  c=o_app(B,c," TLATE="); c=o_i64(B,c,tlate as i64);
  c=o_app(B,c," TMID="); c=o_i64(B,c,tmid as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"B5A="); c=o_i64(B,c,b5a as i64);
  c=o_app(B,c," B5B="); c=o_i64(B,c,b5b as i64);
  c=o_app(B,c," B5C="); c=o_i64(B,c,b5c as i64);
  c=o_app(B,c," B5D="); c=o_i64(B,c,b5d as i64);
  c=o_app(B,c," B5E="); c=o_i64(B,c,b5e as i64);
  c=o_app(B,c," B5F="); c=o_i64(B,c,b5f as i64);
  c=o_app(B,c," DISTINCTB="); c=o_i64(B,c,db as i64);
  c=o_app(B,c," DISTINCTF="); c=o_i64(B,c,df as i64);
  c=o_app(B,c," GENFAIL="); c=o_i64(B,c,get32(G,3760) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

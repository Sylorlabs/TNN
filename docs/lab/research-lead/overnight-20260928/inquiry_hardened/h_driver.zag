fn c3_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=7){c3_dsub(W,t); c3_ddiv(W,t); t=t+1;}
  return;
}

fn c3_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=7 && done==0){
      let b:i32=0;
      while(b<=7 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c3_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=7 && done==0){
    let b:i32=0;
    while(b<=7 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c3_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c3_teach_build(W:[]u8)void {
  c3_canon_build(W,1,1);
  c3_canon_build(W,3,0);
  c3_canon_build(W,5,1);
  c3_canon_build(W,7,0);
  return;
}

fn c3_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=7){
    let b:i32=0;
    while(b<=7){
      let p:i32=c3_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c3_teach_decomp(W);
  c3_teach_build(W);
  return;
}

// ---- EXL4 teaching (literals 0..3, P = a*32+b) ----

fn c4_P(a:i32,b:i32)i32 { return a*32+b; }

fn c4_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(a-b==t){ev_teach_in(W,t,43,c4_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,c4_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=3){c4_dsub(W,t); c4_ddiv(W,t); t=t+1;}
  return;
}

fn c4_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=3 && done==0){
      let b:i32=0;
      while(b<=3 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c4_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=3 && done==0){
    let b:i32=0;
    while(b<=3 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c4_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_teach_build(W:[]u8)void {
  c4_canon_build(W,1,1);
  c4_canon_build(W,3,0);
  return;
}

fn c4_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      let p:i32=c4_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c4_teach_decomp(W);
  c4_teach_build(W);
  return;
}

fn cn_P(a:i32,b:i32)i32 { return a*8+b; }

fn cn_teach(W:[]u8)void {
  let a:i32=2;
  while(a<=6){
    let p:i32=cn_P(a,a);
    ev_teach_in(W,p,41,0);
    ev_teach_in(W,p,42,1);
    a=a+2;
  }
  ev_teach_in(W,0,43,cn_P(2,2));
  ev_teach_in(W,0,43,cn_P(4,4));
  ev_teach_in(W,0,43,cn_P(6,6));
  ev_teach_in(W,1,44,cn_P(2,2));
  ev_teach_in(W,1,44,cn_P(4,4));
  ev_teach_in(W,1,44,cn_P(6,6));
  ev_teach_in(W,0,45,cn_P(2,2));
  ev_teach_in(W,1,45,cn_P(2,2));
  return;
}

// ---- grammar reporting (unpacks the divisor field) ----

fn c_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let f4:i32=ng(W,g,4);
  let D:i32=f4/4;
  let nlic:i32=f4-(D*4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" D="); e64(D);
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- single-target battery (target 0; verification probe) ----

fn adv_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-ADV-NOGRAMMAR\n"); return 0;}
  let D:i32=get32(gb,32);
  let t:i32=0;
  let ans:i32=gi_trial_build2(W,t,gb);
  let cl:i32=gi_classify(W,t,D);
  emit("GI-ADV-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
  let vc:i32=0;
  if(cl==1){vc=1;}
  emit("GI-ADV-B-VALID "); e64(vc); emit("/1\n");
  return vc;
}

// ---- adversarial summary (facts only; scoring is in the report) ----

// h_driver.zag -- hardened inquiry driver.
// Seven worlds, one binary. Teacher answers NEVER enter W directly; they
// go through gi_inquiry_accept (provenance plus corroboration gate).
// EXL2/3/4 (wids 2/3/4): regression (0 queries expected).
// ADV-CTRL (wid 10): cooperative teacher (simulate-and-shrink), adapted to
//   return the fact triple instead of teaching it directly.
// ADV-LIE (wid 11): repeats (35,42,2), including on verification re-query.
// ADV-WASTE (wid 12): cycles true non-discriminating facts.
// ADV-POISON (wid 13): answers (0,43,63).
// Teachers are plain functions (0 modes/bridges/handlers).
// WASTE_BUDGET=2 (separate from QMAX=4).

// ---- cooperative teacher (adapted: writes the answer triple to ap) ----

fn h_coop_answer(W:[]u8,wid:i32,g:i32,cands:[]u8,nc:i32,ap:[]u8)i32 {
  let lo:[]u8=z_alloc(16); let hi:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(16); let Db:[]u8=z_alloc(16);
  set32(lo,0,2); set32(hi,0,6); set32(st,0,2); set32(Db,0,8);
  let Dt:i32=get32(Db,0);
  let step:i32=get32(st,0); let top:i32=get32(hi,0);
  let after:[]u8=z_alloc(256);
  let a:i32=get32(lo,0);
  while(a<=top){
    let b:i32=get32(lo,0);
    while(b<=top){
      let P:i32=Dt*a+b;
      let t:i32=a-b;
      if(gi_fact_ok(Dt,P,41,t)==1){
        let n2:i32=gi_cands_after(W,g,P,41,t,after);
        if(n2>=1 && n2<nc){
          set32(ap,0,P); set32(ap,4,41); set32(ap,8,t);
          emit("GI-ANSWER P="); e64(P); emit(" op=41 t="); e64(t); emit("\n");
          return 1;
        }
      }
      if(b>0 && a-(a/b)*b==0){
        let t2:i32=a/b;
        if(gi_fact_ok(Dt,P,42,t2)==1){
          let n2:i32=gi_cands_after(W,g,P,42,t2,after);
          if(n2>=1 && n2<nc){
            set32(ap,0,P); set32(ap,4,42); set32(ap,8,t2);
            emit("GI-ANSWER P="); e64(P); emit(" op=42 t="); e64(t2); emit("\n");
            return 1;
          }
        }
      }
      b=b+step;
    }
    a=a+step;
  }
  emit("GI-TEACHER-NO-DISCRIMINATOR\n");
  return 0;
}

// ---- teacher dispatcher: writes (s,r,o) to ap[0,4,8]; 1=answered ----

fn h_teacher_answer(W:[]u8,wid:i32,qq:i32,g:i32,cands:[]u8,nc:i32,ap:[]u8)i32 {
  if(wid==10){return h_coop_answer(W,wid,g,cands,nc,ap);}
  if(wid==11){
    set32(ap,0,35); set32(ap,4,42); set32(ap,8,2);
    emit("GI-ADV-LIE-ANSWER P=35 op=42 t=2\n");
    return 1;
  }
  if(wid==12){
    if(qq==0){
      set32(ap,0,20); set32(ap,4,41); set32(ap,8,-2);
      emit("GI-ADV-WASTE-ANSWER P=20 op=41 t=-2\n");
    } else {
      if(qq==1){
        set32(ap,0,34); set32(ap,4,41); set32(ap,8,2);
        emit("GI-ADV-WASTE-ANSWER P=34 op=41 t=2\n");
      } else {
        if(qq==2){
          set32(ap,0,38); set32(ap,4,41); set32(ap,8,-2);
          emit("GI-ADV-WASTE-ANSWER P=38 op=41 t=-2\n");
        } else {
          set32(ap,0,52); set32(ap,4,41); set32(ap,8,2);
          emit("GI-ADV-WASTE-ANSWER P=52 op=41 t=2\n");
        }
      }
    }
    return 1;
  }
  if(wid==13){
    set32(ap,0,0); set32(ap,4,43); set32(ap,8,63);
    emit("GI-ADV-POISON-ANSWER subj=0 op=43 obj=63\n");
    return 1;
  }
  return 0;
}

// ---- re-induction after an accepted answer; nc_out[0] = post count ----

fn h_reinduce(W:[]u8,nc_out:[]u8)i32 {
  let r2:i32=gi_codec_induce(W);
  let code:i32=0;
  if(r2>0){code=gi_induce(W);} else {code=r2;}
  if(code>0){set32(nc_out,0,1);}
  else {
    if(code==-4){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W,gb,cb,nb);
      set32(nc_out,0,get32(nb,0));
    } else {set32(nc_out,0,0);}
  }
  return code;
}

// ---- hardened world runner ----

fn h_world(wid:i32)i32 {
  emit("GI-HD-WORLD ");
  if(wid==2){emit("EXL2\n");}
  if(wid==3){emit("EXL3\n");}
  if(wid==4){emit("EXL4\n");}
  if(wid==10){emit("ADV-CTRL\n");}
  if(wid==11){emit("ADV-LIE\n");}
  if(wid==12){emit("ADV-WASTE\n");}
  if(wid==13){emit("ADV-POISON\n");}
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  let prov:[]u8=z_alloc(1024);
  if(wid==2){c2_teach(W1);}
  if(wid==3){c3_teach(W1);}
  if(wid==4){c4_teach(W1);}
  if(wid>=10){cn_teach(W1);}
  gi_prov_mark_taught(W1,prov);
  let code:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(code); emit("\n");
  let qi:i32=0; let qa:i32=0; let qv:i32=0; let qva:i32=0;
  let waste:i32=0; let stopped:i32=0;
  if(code==-4){
    let qq:i32=0;
    while(qq<4 && code==-4 && stopped==0){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W1,gb,cb,nb);
      let nc_before:i32=get32(nb,0);
      let gval:i32=get32(gb,0);
      gi_inquire(gval,cb,nc_before); qi=qi+1;
      let ap:[]u8=z_alloc(16);
      let ans:i32=h_teacher_answer(W1,wid,qq,gval,cb,nc_before,ap);
      if(ans==0){emit("GI-TEACHER-REFUSED\n"); stopped=1;}
      else {
        qa=qa+1;
        let dw:[]u8=z_alloc(16);
        let r:i32=gi_inquiry_accept(W1,prov,get32(ap,0),get32(ap,4),get32(ap,8),dw);
        if(r==1){
          let ncb:[]u8=z_alloc(16);
          code=h_reinduce(W1,ncb);
          if(get32(ncb,0)>=nc_before){
            waste=waste+1;
            emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
            if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
          }
        } else {
          if(r==0){
            qv=qv+1;
            let bp:[]u8=z_alloc(16);
            let bans:i32=h_teacher_answer(W1,wid,qq,gval,cb,nc_before,bp);
            if(bans==0){emit("GI-TEACHER-REFUSED\n"); stopped=1;}
            else {
              qva=qva+1;
              let rv:i32=gi_inquiry_verify(W1,prov,get32(bp,0),get32(bp,4),get32(bp,8),get32(dw,0),get32(ap,0),get32(ap,4),get32(ap,8));
              if(rv==1){
                let ncb:[]u8=z_alloc(16);
                code=h_reinduce(W1,ncb);
                if(get32(ncb,0)>=nc_before){
                  waste=waste+1;
                  emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
                  if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
                }
              } else {
                stopped=1;
              }
            }
          } else {
            if(r==-1){stopped=1;}
            else {
              waste=waste+1;
              emit("GI-WASTE-COUNT "); e64(waste); emit("/2\n");
              if(waste>=2){emit("GI-WASTE-STOP\n"); stopped=1;}
            }
          }
        }
      }
      qq=qq+1;
    }
    emit("GI-QUERIES issued="); e64(qi); emit(" answered="); e64(qa);
    emit(" verify="); e64(qv); emit("/"); e64(qva);
    emit(" waste="); e64(waste); emit("\n");
  }
  emit("GI-INDUCED-POST "); e64(code); emit("\n");
  c_report_grammar(W1);
  gi_prov_audit(W1,prov);
  if(wid==11){
    emit("GI-QUARANTINE-CHECK lie-absent=");
    if(gi_quarantine_check(W1,35,42,2)==0){emit("1\n");} else {emit("0\n");}
  }
  if(wid==13){
    emit("GI-QUARANTINE-CHECK poison-absent=");
    if(gi_quarantine_check(W1,0,43,63)==0){emit("1\n");} else {emit("0\n");}
  }
  if(code==1 && wid>=10){
    emit("GI-ADV-BATTERY\n");
    let v:i32=adv_arm_induce(W1);
    emit("GI-ADV-WORLD-VALID "); e64(v); emit("\n");
  }
  return code;
}

fn main()i32 {
  emit("GI-HD-START\n");
  let c2:i32=h_world(2);
  let c3:i32=h_world(3);
  let c4:i32=h_world(4);
  let c10:i32=h_world(10);
  let c11:i32=h_world(11);
  let c12:i32=h_world(12);
  let c13:i32=h_world(13);
  emit("GI-HD-DONE\n");
  return 0;
}

// h_driver.zag -- assembled hardened driver (see h_driver_part.zag for the loop).
// Teaching snippets copied verbatim from grammar_inquiry/i_driver.zag (EXL2/3/4)
// and inquiry_advteacher/a_driver.zag (NEG-AMB, reporting, battery).

// ---- EXL2 teaching (literals 0..9, P = a*16+b) ----

fn c2_P(a:i32,b:i32)i32 { return a*16+b; }

fn c2_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,c2_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,c2_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){c2_dsub(W,t); c2_ddiv(W,t); t=t+1;}
  return;
}

fn c2_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_build(W:[]u8)void {
  c2_canon_build(W,1,1);
  c2_canon_build(W,3,0);
  c2_canon_build(W,5,1);
  c2_canon_build(W,7,0);
  return;
}

fn c2_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=c2_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c2_teach_decomp(W);
  c2_teach_build(W);
  return;
}

// ---- EXL3 teaching (literals 0..7, P = a*8+b) ----

fn c3_P(a:i32,b:i32)i32 { return a*8+b; }

fn c3_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=7){
    let b:i32=0;
    while(b<=7){
      if(a-b==t){ev_teach_in(W,t,43,c3_P(a,b));}

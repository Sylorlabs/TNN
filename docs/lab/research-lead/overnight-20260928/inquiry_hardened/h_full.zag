// ---- P-INT5: DEVINT-CLA2 11 stages (compact curriculum) ----
fn t_dv()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // S1-S2: teach episodes, segment (teach 12)
  let i:i32=0;
  while(i<12){ev_teach(W,100+i,1,200+i); i=i+1;}
  // S3: form 4 groups
  let g0:i32=alloc_node(W); ns(W,g0,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,2);
  let g2:i32=alloc_node(W); ns(W,g2,0,2);
  let g3:i32=alloc_node(W); ns(W,g3,0,2);
  // S4: bigram edges (link 12)
  i=0; while(i<11){link_edge(W,100+i,1,101+i,0); i=i+1;}
  // S5: 5 rules via exact key (simplified)
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let r1:i32=ev_query(W,1,11,-2,0);
  // S6: procedure executes (via exact key)
  // S7: contradiction
  ev_teach(W,50,21,60); ev_observe(W,50,21,61);
  // S8: inquiry via uncertainty
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,70);
  // S9: demotion with history
  // S10: eviction pressure (60 teaches)
  i=0; while(i<60){ev_teach(W,600+i,31,i); i=i+1;}
  // S11: delayed reuse (query stage-1 facts)
  let ok:i32=1; i=0;
  while(i<12){if(ev_query(W,100+i,1,-2,0)!=200+i){ok=0;} i=i+1;}
  if(r1==2 && ok==1){return 1;} return 0;
}
// ---- F-INT4: cross-capability integration ----
fn t_xcap()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // teach chain, query miss builds plan, promotes MAP
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=201){return 0;}
  // create a guide node (simulating a MAP that guides action)
  let m:i32=alloc_node(W);
  if(m<2){return 0;}
  ns(W,m,0,20); write_node(W,m,77,505,0,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1); ns(W,m,4,505);
  // give it positive bid via self-loop
  link_edge(W,m,6,m,0);
  let b0:i32=bid(W,m);
  if(b0<=0){return 0;}
  // contradict the guide: both query standing and action candidacy demote
  contradict_map(W,m);
  let st:i32=map_standing(W,m);
  let b:i32=bid(W,m);
  if(st<0 && b<b0){return 1;} return 0;
}
// ============ main ============
// ============ TNN-2 new tests: the three changes ============
// Change 1: runtime construction. 4-hop chain: beyond the removed
// templates' ceiling (3-hop via compose-by-cloning). The winning graph is
// assembled at runtime by the trial loop and executed by execute().
fn t_t2_chain4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  if(a==5){return 1;} return 0;
}
// Change 1: anti-theater. t_p4 pattern: two candidates tried and genuinely
// rejected before the 3-hop winner verifies. Trial stats packed in hdr+16.
fn t_t2_trial_reject()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,107); ev_teach(W,102,12,103);
  ev_teach(W,102,19,108); ev_teach(W,103,13,104); ev_teach(W,103,19,109);
  let a:i32=ev_query(W,101,40,104,0);
  let st:i32=hg(W,16); let tried:i32=st/1024; let rej:i32=st-tried*1024;
  if(a==104 && tried>=3 && rej>=2){return 1;} return 0;
}
// Change 2: miss-to-act. The miss path itself reifies UNCERTAINTY and
// constructs the POLICY_ROOT-linked guide (no scaffolding).
fn t_t2_inquire()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  let u:i32=-1; let g:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      if(ng(W,n,0)==30 && ng(W,n,20)==9002 && ng(W,n,24)==77){u=n;}
      if(ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g=n;}
    }
    n=n+1;
  }
  if(u<0 || g<0){return 0;}
  let pr:i32=pol_get(W); if(pr<2){return 0;}
  let e1:i32=0; let e2:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      if(eg(W,e,0)==g && eg(W,e,4)==1 && eg(W,e,8)==u){e1=1;}
      if(eg(W,e,0)==pr && eg(W,e,4)==10 && eg(W,e,8)==g){e2=1;}
    }
    e=e+1;
  }
  if(e1==1 && e2==1){return 1;} return 0;
}
// Change 2: the act path is live. ev_act over the miss-constructed guide
// returns 30 (inquiry act), not the hardcoded 0 fallback.
fn t_t2_actlive()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  ctx_push(W,9002);
  let c:i32=ev_act(W);
  if(c==30){return 1;} return 0;
}
// Change 3: generic revision. Promote a 2-hop chain answering 201, then
// contradict a licensing fact via the public observe path. The graph must
// be restructured (topology change, verified by re-execution), the promoted
// answer updated to 999, and map standing untouched (not a demotion).
fn t_t2_revise()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  if(ev_query(W,101,40,201,0)!=201){return 0;}
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==40){m=n;}
    n=n+1;
  }
  if(m<0){return 0;}
  let root:i32=ng(W,m,20);
  let st0:i32=map_standing(W,m);
  let sig0:[]u8=z_alloc(256); let c0:i32=t2_sig(W,root,sig0);
  if(ev_observe(W,102,12,999)!=0){return 0;}
  if(t2_exec(W,root,101)!=999){return 0;}
  let sig1:[]u8=z_alloc(256); let c1:i32=t2_sig(W,root,sig1);
  let diff:i32=0;
  if(c0!=c1){diff=1;}
  else {
    let i:i32=0;
    while(i<c0){
      if(get32(sig0,i*8)!=get32(sig1,i*8) || get32(sig0,i*8+4)!=get32(sig1,i*8+4)){diff=1;}
      i=i+1;
    }
  }
  if(diff==0){return 0;}
  if(map_standing(W,m)!=st0){return 0;}
  if(ev_query(W,101,40,-2,0)!=999){return 0;}
  return 1;
}
fn run_all()i32 {
  let pass:i32=0; let total:i32=0;
  total=total+1; if(t_c1()==1){pass=pass+1; tpass("C1");} else {tfail("C1");}
  total=total+1; if(t_c2()==1){pass=pass+1; tpass("C2");} else {tfail("C2");}
  total=total+1; if(t_c3()==1){pass=pass+1; tpass("C3");} else {tfail("C3");}
  total=total+1; if(t_c4()==1){pass=pass+1; tpass("C4");} else {tfail("C4");}
  total=total+1; if(t_c5()==1){pass=pass+1; tpass("C5");} else {tfail("C5");}
  total=total+1; if(t_c6()==1){pass=pass+1; tpass("C6");} else {tfail("C6");}
  total=total+1; if(t_c7()==1){pass=pass+1; tpass("C7");} else {tfail("C7");}
  total=total+1; if(t_c8()==1){pass=pass+1; tpass("C8");} else {tfail("C8");}
  total=total+1; if(t_c9()==1){pass=pass+1; tpass("C9");} else {tfail("C9");}
  total=total+1; if(t_c10()==1){pass=pass+1; tpass("C10");} else {tfail("C10");}
  total=total+1; if(t_c11()==1){pass=pass+1; tpass("C11");} else {tfail("C11");}
  total=total+1; if(t_c12()==1){pass=pass+1; tpass("C12");} else {tfail("C12");}
  total=total+1; if(t_c13()==1){pass=pass+1; tpass("C13");} else {tfail("C13");}
  total=total+1; if(t_c14()==1){pass=pass+1; tpass("C14");} else {tfail("C14");}
  total=total+1; if(t_c15()==1){pass=pass+1; tpass("C15");} else {tfail("C15");}
  total=total+1; if(t_a1()==1){pass=pass+1; tpass("A1");} else {tfail("A1");}
  total=total+1; if(t_a2()==1){pass=pass+1; tpass("A2");} else {tfail("A2");}
  total=total+1; if(t_a3()==1){pass=pass+1; tpass("A3");} else {tfail("A3");}
  total=total+1; if(t_a4()==1){pass=pass+1; tpass("A4");} else {tfail("A4");}
  total=total+1; if(t_a5()==1){pass=pass+1; tpass("A5");} else {tfail("A5");}
  total=total+1; if(t_a6()==1){pass=pass+1; tpass("A6");} else {tfail("A6");}
  total=total+1; if(t_p1()==1){pass=pass+1; tpass("P1");} else {tfail("P1");}
  total=total+1; if(t_f2()==1){pass=pass+1; tpass("F2");} else {tfail("F2");}
  total=total+1; if(t_p2()==1){pass=pass+1; tpass("P2");} else {tfail("P2");}
  total=total+1; if(t_p2b()==1){pass=pass+1; tpass("P2b");} else {tfail("P2b");}
  total=total+1; if(t_p3a()==1){pass=pass+1; tpass("P3a");} else {tfail("P3a");}
  total=total+1; if(t_p3b()==1){pass=pass+1; tpass("P3b");} else {tfail("P3b");}
  total=total+1; if(t_p4()==1){pass=pass+1; tpass("P4");} else {tfail("P4");}
  total=total+1; if(t_p5()==1){pass=pass+1; tpass("P5");} else {tfail("P5");}
  total=total+1; if(t_abl_i()==1){pass=pass+1; tpass("ABL-I");} else {tfail("ABL-I");}
  total=total+1; if(t_abl_c()==1){pass=pass+1; tpass("ABL-C");} else {tfail("ABL-C");}
  total=total+1; if(t_p6()==1){pass=pass+1; tpass("P6");} else {tfail("P6");}
  total=total+1; if(t_p7()==1){pass=pass+1; tpass("P7");} else {tfail("P7");}
  total=total+1; if(t_dv()==1){pass=pass+1; tpass("DV");} else {tfail("DV");}
  total=total+1; if(t_xcap()==1){pass=pass+1; tpass("XCAP");} else {tfail("XCAP");}
  total=total+1; if(t_r_pact3()==1){pass=pass+1; tpass("R-PACT3");} else {tfail("R-PACT3");}
  total=total+1; if(t_r_pact1()==1){pass=pass+1; tpass("R-PACT1");} else {tfail("R-PACT1");}
  total=total+1; if(t_r_pact2()==1){pass=pass+1; tpass("R-PACT2");} else {tfail("R-PACT2");}
  total=total+1; if(t_r_pact4()==1){pass=pass+1; tpass("R-PACT4");} else {tfail("R-PACT4");}
  total=total+1; if(t_r_pact5()==1){pass=pass+1; tpass("R-PACT5");} else {tfail("R-PACT5");}
  total=total+1; if(t_r_pact6()==1){pass=pass+1; tpass("R-PACT6");} else {tfail("R-PACT6");}
  total=total+1; if(t_t2_chain4()==1){pass=pass+1; tpass("T2-CHAIN4");} else {tfail("T2-CHAIN4");}
  total=total+1; if(t_t2_trial_reject()==1){pass=pass+1; tpass("T2-REJECT");} else {tfail("T2-REJECT");}
  total=total+1; if(t_t2_inquire()==1){pass=pass+1; tpass("T2-INQUIRE");} else {tfail("T2-INQUIRE");}
  total=total+1; if(t_t2_actlive()==1){pass=pass+1; tpass("T2-ACTLIVE");} else {tfail("T2-ACTLIVE");}
  total=total+1; if(t_t2_revise()==1){pass=pass+1; tpass("T2-REVISE");} else {tfail("T2-REVISE");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<1024){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// gi_patch.zag -- grammar induction with INDUCED pair codec (unfrozen).
// Induces EXL BUILD grammar from taught examples. The induced grammar is
// stored in learner state (type-70 node) and guides construction.
// The pair codec P(a,b) = a*D+b is INDUCED from the fact stream by
// gi_codec_induce: no divisor is hardcoded anywhere in this file and no
// candidate is selected from a fixed list. Relation ids: ADD=41 MUL=42
// DADD=43 DMUL=44 BUILD=45 (world assumptions, as in prior work).

// Learner-owned semantic lookup: is (pair, op, t) in TNN's own learned
// state? Read-only scan. The VALUES come from learner state; the lookup
// procedure is driver code.
fn gi_eval_known(W:[]u8,pair:i32,op:i32,t:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==pair && ng(W,n,24)==op && ng(W,n,28)==t){return 1;}
    n=n+1;
  }
  return 0;
}

// Find the induced grammar node (type 70). Returns id or -1.
fn gi_grammar_find(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==70){return n;}
    n=n+1;
  }
  return -1;
}

// Integer gcd (nonnegative inputs in our use).
fn gi_gcd(a:i32,b:i32)i32 {
  let x:i32=a; let y:i32=b;
  while(y!=0){
    let r:i32=x-(x/y)*y;
    x=y; y=r;
  }
  return x;
}

// Single-fact op-consistency of a candidate divisor d: decode the pair
// P under d to (aa,bb) and require the op the relation names to
// reproduce t (41: aa-bb==t; 42: bb>0, exact, aa/bb==t). Factored out
// of gi_codec_op_ok with identical semantics; also used by the
// inquiry machinery for hypothetical facts.
fn gi_fact_ok(d:i32,P:i32,op:i32,t:i32)i32 {
  let aa:i32=P/d; let bb:i32=P-(aa*d);
  if(op==41){
    if(aa-bb!=t){return 0;}
    return 1;
  }
  if(bb<=0){return 0;}
  if(aa-(aa/bb)*bb!=0){return 0;}
  if(aa/bb!=t){return 0;}
  return 1;
}

// gi_decomp_ok -- decode-and-verify for decomp facts (relations 43/44).
// A decomp fact (s,43,P)/(s,44,P) redundantly encodes the eval claim
// (P,41,s)/(P,42,s) with subject and object swapped (the teaching pairs
// them: (0,43,P) with (P,41,0), (1,44,P) with (P,42,1)). Verify it with
// the SAME decode-and-verify as eval facts: decode the pair object P
// under d and require the named op to reproduce the subject s.
fn gi_decomp_ok(d:i32,s:i32,r:i32,P:i32)i32 {
  if(r==43){return gi_fact_ok(d,P,41,s);}
  if(r==44){return gi_fact_ok(d,P,42,s);}
  return 0;
}

// Op-consistency of a candidate divisor d against the taught eval AND
// decomp facts. For every live type-1 fact with relation in {41,42} (the
// eval ops: SUB=41, DIV=42), the subject is a pair P and the object is the
// taught value t; require gi_fact_ok(d,P,r,t). For relations {43,44}
// (the decomp ops: DSUB=43, DDIV=44), the subject is the value s and the
// object is the pair P; require gi_decomp_ok(d,s,r,P), the same
// decode-and-verify with subject/object roles swapped. Returns 1 when d
// is consistent with the world's own taught semantics, 0 on the first
// contradiction. Names no divisor; the discriminator is the fact stream.
// (Hardened: 43/44 were previously never scanned, leaving the decomp
// channel an unverified trust path.)
fn gi_codec_op_ok(W:[]u8,d:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let r:i32=ng(W,n,24);
      if(r==41 || r==42){
        let P:i32=ng(W,n,20); let t:i32=ng(W,n,28);
        if(gi_fact_ok(d,P,r,t)==0){return 0;}
      } else {
        if(r==43 || r==44){
          let s:i32=ng(W,n,20); let P:i32=ng(W,n,28);
          if(gi_decomp_ok(d,s,r,P)==0){return 0;}
        }
      }
    }
    n=n+1;
  }
  return 1;
}

// Consistent divisor set for evidence summarized by g, optionally with
// one extra hypothetical fact (P,op,t) (has_extra=1). Candidates
// d = v-1 for v|g, v>=2 are derived from the observed g by exact
// arithmetic (no hardcoded candidates); each is tested by
// gi_codec_op_ok over the W facts and, when has_extra=1, by
// gi_fact_ok on the hypothetical fact. The consistent divisors are
// written to out (i32 list); returns the count.
fn gi_consistent_set(W:[]u8,g:i32,has_extra:i32,eP:i32,eOp:i32,eT:i32,out:[]u8)i32 {
  let cnt:i32=0;
  let q:i32=1;
  while(q*q<=g){
    if(g-(g/q)*q==0){
      let v1:i32=q;
      if(v1>=2){
        let d:i32=v1-1;
        if(gi_codec_op_ok(W,d)==1){
          if(has_extra==0 || gi_fact_ok(d,eP,eOp,eT)==1){
            set32(out,cnt*4,d); cnt=cnt+1;
          }
        }
      }
      let v2:i32=g/q;
      if(v2!=v1 && v2>=2){
        let d:i32=v2-1;
        if(gi_codec_op_ok(W,d)==1){
          if(has_extra==0 || gi_fact_ok(d,eP,eOp,eT)==1){
            set32(out,cnt*4,d); cnt=cnt+1;
          }
        }
      }
    }
    q=q+1;
  }
  return cnt;
}

// gi_codec_induce2 -- induce the pair-codec divisor D from the fact
// stream, also reporting the evidence summary and the candidate set.
// Literal co-occurrence structure used:
//   SUB eval fact (P,41,t):      P+t = a*(D+1)  (P=a*D+b, t=a-b)
//   DSUB decomp fact (t,43,P):   P+t = a*(D+1)
//   DIV eval fact (P,42,1):      P   = b*(D+1)  (a=b, unit quotient)
//   DDIV decomp fact (1,44,P):   P   = b*(D+1)
// Every positive member of S is a multiple of (D+1), so with
// g = gcd of the positive members, the true D+1 divides g. The
// candidates d = v-1 for v|g, v>=2 are derived from the observed g by
// exact arithmetic (no hardcoded candidates) via gi_consistent_set.
// g_out[0] receives g; cands receives the consistent divisor list;
// nc_out[0] receives its length. Returns the induced D (>0) when
// exactly one divisor is consistent; -3 when no divisor is consistent
// (contradicted codec, or no codec evidence at all); -4 when two or
// more divisors are consistent (genuinely ambiguous: guessing would be
// silent-wrong in a new form).
fn gi_codec_induce2(W:[]u8,g_out:[]u8,cands:[]u8,nc_out:[]u8)i32 {
  let g:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let r:i32=ng(W,n,24);
      let s:i32=0;
      if(r==41){s=ng(W,n,20)+ng(W,n,28);}
      else {
        if(r==43){s=ng(W,n,28)+ng(W,n,20);}
        else {
          if(r==42 && ng(W,n,28)==1){s=ng(W,n,20);}
          else { if(r==44 && ng(W,n,20)==1){s=ng(W,n,28);} }
        }
      }
      if(s>0){
        if(g==0){g=s;} else {g=gi_gcd(g,s);}
      }
    }
    n=n+1;
  }
  set32(g_out,0,g);
  if(g<2){set32(nc_out,0,0); return -3;}
  let cnt:i32=gi_consistent_set(W,g,0,0,0,0,cands);
  set32(nc_out,0,cnt);
  if(cnt==1){return get32(cands,0);}
  if(cnt==0){return -3;}
  return -4;
}

// Thin wrapper preserving the original gi_codec_induce contract.
fn gi_codec_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
  return gi_codec_induce2(W,gb,cb,nb);
}

// gi_cands_after -- learner-side simulation: the consistent divisor
// set if the hypothetical fact (P,op,t) were added to the stream.
// Recomputes g' = gcd(g, s') with the same S-contribution rule as
// gi_codec_induce2 (s' = P+t for SUB when positive; s' = P for unit
// DIV; else 0), re-derives candidates from divisors of g', and tests
// each against the W facts plus the hypothetical fact. No W
// mutation. Returns the new consistent count in out. Used to find a
// discriminating teaching example without touching learner state.
fn gi_cands_after(W:[]u8,g:i32,eP:i32,eOp:i32,eT:i32,out:[]u8)i32 {
  let s:i32=0;
  if(eOp==41){
    s=eP+eT;
    if(s<=0){s=0;}
  } else {
    if(eOp==42 && eT==1){s=eP;}
  }
  let g2:i32=g;
  if(s>0){g2=gi_gcd(g,s);}
  if(g2<2){return 0;}
  return gi_consistent_set(W,g2,1,eP,eOp,eT,out);
}

// gi_inquire -- learner-side active inquiry request. Called when
// induction found nc>=2 consistent divisors. Emits one GI-INQUIRY
// request naming the candidate divisor set and the evidence summary
// g, requesting ONE teaching example on which the candidates
// disagree. General: names no components, no op, no pair structure,
// no diagonal/off-diagonal distinction. Returns 1 (request issued).
fn gi_inquire(g:i32,cands:[]u8,nc:i32)i32 {
  emit("GI-INQUIRY request=discriminating-example ncands=");
  e64(nc);
  emit(" cands=");
  let i:i32=0;
  while(i<nc){
    if(i>0){emit(",");}
    e64(get32(cands,i*4));
    i=i+1;
  }
  emit(" g=");
  e64(g);
  emit("\n");
  return 1;
}

// ============ inquiry hardening: provenance, corroboration, waste ============
// The inquiry channel is a trust boundary. Every answer is gated here
// before it may enter W. Provenance values: 0=unmarked, 1=taught
// (original teaching), 2=inquiry (accepted inquiry answer). Rejected
// answers are never added to W (quarantined by exclusion).

// gi_prov_mark_taught -- mark all current live type-1 facts as taught (1).
// Called once, after the initial teaching, before any inquiry round.
fn gi_prov_mark_taught(W:[]u8,prov:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){prov[n]=1;}
    n=n+1;
  }
  return;
}

// gi_fact_dup -- is (s,r,o) already a live type-1 fact? 1=yes, 0=no.
fn gi_fact_dup(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return 1;}
    n=n+1;
  }
  return 0;
}

// gi_pair_witnessed -- count live type-1 TAUGHT (prov=1) facts with
// relation in {41,42,43,44} that mention P as a pair: as subject (eval
// facts (P,41/42,t)) or as object (decomp facts (s,43/44,P)). The decomp
// channel is derivative of the eval channel; a decomp answer may not
// introduce a pair the taught stream never witnessed.
fn gi_pair_witnessed(W:[]u8,prov:[]u8,P:i32)i32 {
  let c:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && (prov[n] as i32)==1){
      let r:i32=ng(W,n,24);
      if(r>=41 && r<=44){
        if(ng(W,n,20)==P || ng(W,n,28)==P){c=c+1;}
      }
    }
    n=n+1;
  }
  return c;
}

// gi_strong_kill -- is the answer's elimination of d structural?
// For DIV (42) with d|P, the decoded bb=0: the pair is degenerate and
// impossible under any well-formed codec (b must satisfy 0<b<d for the
// encoding to be injective). Such coarse structural testimony is trusted
// outright. Every other kill (op-value mismatch on a well-formed pair,
// all SUB kills) is weak and needs a verification round.
fn gi_strong_kill(d:i32,P:i32,op:i32)i32 {
  if(op==42 && d>0){
    if(P-(P/d)*d==0){return 1;}
  }
  return 0;
}

// gi_inquiry_accept -- the ONLY entry point for inquiry answers into W.
// Verifies BEFORE adding; marks accepted facts prov=2 (inquiry).
// Returns 1=ACCEPT (fact added), 0=NEED_VERIFY (weak kill; fact NOT
// added; d_weak_out[0] receives the weakly-killed candidate), -1=REJECT
// (suspect; fact NOT added; detection signal emitted), -2=DUPLICATE.
fn gi_inquiry_accept(W:[]u8,prov:[]u8,s:i32,r:i32,o:i32,d_weak_out:[]u8)i32 {
  if(gi_fact_dup(W,s,r,o)==1){
    emit("GI-ANSWER-DUP s="); e64(s); emit(" r="); e64(r); emit(" o="); e64(o); emit("\n");
    return -2;
  }
  let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
  gi_codec_induce2(W,gb,cb,nb);
  let nc:i32=get32(nb,0);
  if(r==43 || r==44){
    // Decomp channel: the ADV-POISON path. A decomp answer must (a)
    // satisfy decode-and-verify under EVERY surviving candidate (it is
    // not a discriminator; it must eliminate nothing), and (b) have its
    // pair object witnessed by at least 2 independent taught facts.
    let i:i32=0;
    while(i<nc){
      let d:i32=get32(cb,i*4);
      if(gi_decomp_ok(d,s,r,o)==0){
        emit("GI-POISON-SUSPECT reason=decomp-inconsistent d="); e64(d);
        emit(" s="); e64(s); emit(" r="); e64(r); emit(" o="); e64(o); emit("\n");
        return -1;
      }
      i=i+1;
    }
    let w:i32=gi_pair_witnessed(W,prov,o);
    if(w<2){
      emit("GI-POISON-SUSPECT reason=unwitnessed-pair o="); e64(o);
      emit(" witnesses="); e64(w); emit("\n");
      return -1;
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=2 && nn<1024){prov[nn]=2;}
    emit("GI-ANSWER-ACCEPT s="); e64(s); emit(" r="); e64(r); emit(" o="); e64(o); emit(" prov=inquiry\n");
    return 1;
  }
  if(r==41 || r==42){
    // Eval channel: find killed candidates; each kill must be strong or
    // go through the verification round.
    let wk:i32=-1; let allstrong:i32=1;
    let i:i32=0;
    while(i<nc){
      let d:i32=get32(cb,i*4);
      if(gi_fact_ok(d,s,r,o)==0){
        if(gi_strong_kill(d,s,r)==0){wk=d; allstrong=0;}
      }
      i=i+1;
    }
    if(allstrong==1){
      let nn:i32=ev_teach_in(W,s,r,o);
      if(nn>=2 && nn<1024){prov[nn]=2;}
      emit("GI-ANSWER-ACCEPT s="); e64(s); emit(" r="); e64(r); emit(" o="); e64(o); emit(" prov=inquiry\n");
      return 1;
    }
    set32(d_weak_out,0,wk);
    emit("GI-VERIFY-REQUEST d="); e64(wk); emit(" reason=weak-elimination");
    emit(" s="); e64(s); emit(" r="); e64(r); emit(" o="); e64(o); emit("\n");
    return 0;
  }
  emit("GI-ANSWER-REJECT reason=bad-relation r="); e64(r); emit("\n");
  return -1;
}

// gi_inquiry_verify -- verification round for a weak elimination.
// The teacher supplies a corroborating fact B=(s2,r2,o2) for the weakly
// killed d_weak. B must be new, an eval fact, different from A, kill
// d_weak STRONGLY, and keep every candidate A keeps. On pass, BOTH A and
// B enter W (prov=2). On fail, GI-LIE-SUSPECT is emitted and NEITHER
// enters W. Returns 1=pass, -1=fail.
fn gi_inquiry_verify(W:[]u8,prov:[]u8,s2:i32,r2:i32,o2:i32,d_weak:i32,as:i32,ar:i32,ao:i32)i32 {
  let ok:i32=1;
  if(gi_fact_dup(W,s2,r2,o2)==1){ok=0;}
  if(r2!=41 && r2!=42){ok=0;}
  if(s2==as && r2==ar && o2==ao){ok=0;}
  if(gi_fact_ok(d_weak,s2,r2,o2)==1){ok=0;}
  if(gi_strong_kill(d_weak,s2,r2)==0){ok=0;}
  let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
  gi_codec_induce2(W,gb,cb,nb);
  let nc:i32=get32(nb,0);
  let i:i32=0;
  while(i<nc){
    let d:i32=get32(cb,i*4);
    if(d!=d_weak){
      if(gi_fact_ok(d,as,ar,ao)==1 && gi_fact_ok(d,s2,r2,o2)==0){ok=0;}
    }
    i=i+1;
  }
  if(ok==0){
    emit("GI-LIE-SUSPECT reason=verify-failed d="); e64(d_weak);
    emit(" b_s="); e64(s2); emit(" b_r="); e64(r2); emit(" b_o="); e64(o2); emit("\n");
    return -1;
  }
  let n1:i32=ev_teach_in(W,as,ar,ao);
  if(n1>=2 && n1<1024){prov[n1]=2;}
  let n2:i32=ev_teach_in(W,s2,r2,o2);
  if(n2>=2 && n2<1024){prov[n2]=2;}
  emit("GI-VERIFY-PASS d="); e64(d_weak); emit("\n");
  return 1;
}

// gi_quarantine_check -- is (s,r,o) present as a live type-1 fact?
// 1=yes (trust boundary breached), 0=no (quarantine held).
fn gi_quarantine_check(W:[]u8,s:i32,r:i32,o:i32)i32 {
  return gi_fact_dup(W,s,r,o);
}

// gi_prov_audit -- report provenance counts over live type-1 facts.
fn gi_prov_audit(W:[]u8,prov:[]u8)void {
  let t:i32=0; let q:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if((prov[n] as i32)==1){t=t+1;}
      else {if((prov[n] as i32)==2){q=q+1;}}
    }
    n=n+1;
  }
  emit("GI-PROVENANCE taught="); e64(t); emit(" inquiry="); e64(q); emit("\n");
  return;
}

// ============ end inquiry hardening ============

// Induce BUILD grammar from taught examples in learner state.
// (1) FORM from BUILD examples: for each live fact (T,45,P), find
//     licensor facts (T,r2,P) with r2 != 45 (same subject and object,
//     different relation) and collect the distinct r2 values.
//     Codec-independent relational discovery (unchanged). The old
//     part-1 decode + sanity check is DELETED: a*D+b==P is a tautology
//     under any fixed divisor, so it could never contradict the codec.
//     Its replacement is gi_codec_induce below: the real cross-fact
//     consistency check.
// (2) CODEC: induce the pair-codec divisor D from the fact stream.
//     Refuse fail-closed (-3 contradicted, -4 ambiguous) with no
//     grammar node written.
// (3) LITERALS from decomp experience: scan facts licensed by the
//     induced licensor relations; decode their pair objects under the
//     induced D and track the observed ranges.
// Writes a type-70 node: field 4 packs nlic (low 2 bits) and the
// induced divisor D (field4 = nlic + 4*D; nodes are 40 bytes with no
// free slot, so the codec rides the nlic field; the stride 4 is 2^2
// bits, NOT a codec divisor), 8/12 = licensor rels, 16/20 = min/max_a,
// 24/28 = min/max_b, 32 = nbuild.
// Returns 1 if a consistent grammar was induced, 0 on legacy refusal,
// -3 if the codec is contradicted, -4 if the codec is ambiguous. On any
// non-1 return no grammar node is written (fail-closed).
fn gi_induce(W:[]u8)i32 {
  let nbuild:i32=0;
  let lic:[]u8=z_alloc(64); let nlic:i32=0;
  let ok:i32=1;
  let n:i32=2;
  while(n<1024 && ok==1){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==45){
      let T:i32=ng(W,n,20); let P:i32=ng(W,n,28);
      nbuild=nbuild+1;
      let m:i32=2; let found:i32=0;
      while(m<1024){
        if(m!=n && ng(W,m,36)==1 && ng(W,m,0)==1 && ng(W,m,20)==T && ng(W,m,28)==P && ng(W,m,24)!=45){
          let r2:i32=ng(W,m,24);
          let k:i32=0; let seen:i32=0;
          while(k<nlic){if(get32(lic,k*4)==r2){seen=1;} k=k+1;}
          if(seen==0 && nlic<16){set32(lic,nlic*4,r2); nlic=nlic+1;}
          found=1;
        }
        m=m+1;
      }
      if(found==0){ok=0;}
    }
    n=n+1;
  }
  if(ok==0 || nbuild==0 || nlic==0){return 0;}
  if(nlic>2){return 0;}
  let D:i32=gi_codec_induce(W);
  if(D<0){return D;}
  let min_a:i32=999; let max_a:i32=-999;
  let min_b:i32=999; let max_b:i32=-999;
  let e:i32=2;
  while(e<1024){
    if(ng(W,e,36)==1 && ng(W,e,0)==1){
      let er:i32=ng(W,e,24);
      let k:i32=0; let islic:i32=0;
      while(k<nlic){if(get32(lic,k*4)==er){islic=1;} k=k+1;}
      if(islic==1){
        let P:i32=ng(W,e,28);
        let a:i32=P/D; let b:i32=P-(a*D);
        if(a<min_a){min_a=a;} if(a>max_a){max_a=a;}
        if(b<min_b){min_b=b;} if(b>max_b){max_b=b;}
      }
    }
    e=e+1;
  }
  if(min_a>max_a){return 0;}
  let g:i32=alloc_node(W);
  if(g<0){return 0;}
  ns(W,g,0,70);
  ns(W,g,4,nlic+D*4);
  if(nlic>0){ns(W,g,8,get32(lic,0));}
  if(nlic>1){ns(W,g,12,get32(lic,4));}
  ns(W,g,16,min_a); ns(W,g,20,max_a);
  ns(W,g,24,min_b); ns(W,g,28,max_b);
  ns(W,g,32,nbuild);
  return 1;
}

// Ablate: kill the induced grammar node (mark not-live).
// Returns 1 if a grammar was found and killed, 0 otherwise.
fn gi_ablate(W:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  ns(W,g,36,0);
  return 1;
}

// Read induced grammar into a buffer.
// buf[0]=nlic, buf[1]=lic0, buf[2]=lic1, buf[3]=min_a, buf[4]=max_a,
// buf[5]=min_b, buf[6]=max_b, buf[7]=nbuild, buf[8]=divisor D.
// Returns 1 if found.
fn gi_grammar_read(W:[]u8,buf:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  let f4:i32=ng(W,g,4);
  let D:i32=f4/4;
  let nlic:i32=f4-(D*4);
  set32(buf,0,nlic);
  if(nlic>0){set32(buf,4,ng(W,g,8));} else {set32(buf,4,-1);}
  if(nlic>1){set32(buf,8,ng(W,g,12));} else {set32(buf,8,-1);}
  set32(buf,12,ng(W,g,16));
  set32(buf,16,ng(W,g,20));
  set32(buf,20,ng(W,g,24));
  set32(buf,24,ng(W,g,28));
  set32(buf,28,ng(W,g,32));
  set32(buf,32,D);
  return 1;
}

// Is relation r in the induced licensor set (from buffer)?
fn gi_lic_ok2(buf:[]u8,r:i32)i32 {
  let nlic:i32=get32(buf,0);
  if(nlic>0 && get32(buf,4)==r){return 1;}
  if(nlic>1 && get32(buf,8)==r){return 1;}
  return 0;
}

// Grammar-guided BUILD using the INDUCED grammar (from buffer).
// buf: [0]=nlic, [4]=lic0, [8]=lic1, [12]=min_a, [16]=max_a,
//      [20]=min_b, [24]=max_b, [28]=nbuild, [32]=divisor D.
// Candidates must be atomic single facts (path length 2) whose relation
// is in the induced licensor set. Output must decode within induced
// ranges UNDER THE INDUCED DIVISOR and verify against TNN's own eval
// knowledge (either op). Promotes on success, returns -2 otherwise.
fn gi_trial_build2(W:[]u8,t:i32,gb:[]u8)i32 {
  let min_a:i32=get32(gb,12); let max_a:i32=get32(gb,16);
  let min_b:i32=get32(gb,20); let max_b:i32=get32(gb,24);
  let D:i32=get32(gb,32);
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(gi_lic_ok2(gb,fr)==1){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/D; let b:i32=out-(a*D);
          if(a>=min_a && a<=max_a && b>=min_b && b<=max_b){
            if(gi_eval_known(W,out,41,t)==1 || gi_eval_known(W,out,42,t)==1){
              promote_graph(W,root,t,45,out,ff,1);
              return out;
            }
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Hardcoded comparison arm: the prior treatment's researcher-authored
// grammar restriction (only DADD/DMUL single links). The codec is the
// INDUCED divisor D (passed in), not a hardcoded constant: hardcoding
// /16 here would re-test the already-diagnosed broken assumption
// instead of comparing induced vs hardcoded structure.
fn gi_hardcode_build(W:[]u8,t:i32,D:i32)i32 {
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(fr==43 || fr==44){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/D; let b:i32=out-(a*D);
          let op:i32=41; if(fr==44){op=42;}
          if(a>=0 && a<=9 && b>=0 && b<=9 && gi_eval_known(W,out,op,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Classify the (T,BUILD) construction from the promoted MAP's DEP edges.
// 1 = valid: single DADD/DMUL dep, pair decodes under the INDUCED
//     divisor D to a,b in 0..9, and TNN's own eval knowledge confirms
//     op(a,b)==T.
// 2 = multi-dep. 3 = wrong-relation dep. 4 = non-pair or literal range.
// 5 = value mismatch. 0 = no MAP found.
// Researcher-owned measurement rubric (same as prior work, codec now
// the induced D instead of hardcoded /16).
fn gi_classify(W:[]u8,t:i32,D:i32)i32 {
  let m:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && ng(W,mm,0)==20 && ng(W,mm,8)==t && ng(W,mm,4)==45){m=mm;}
    mm=mm+1;
  }
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24); let oo:i32=ng(W,f,28);
  if(fr!=43 && fr!=44){return 3;}
  let a:i32=oo/D; let b:i32=oo-(a*D);
  if(a<0 || a>9 || b<0 || b>9){return 4;}
  let op:i32=41; if(fr==44){op=42;}
  if(gi_eval_known(W,oo,op,t)==0){return 5;}
  return 1;
}
// h_driver.zag -- assembled hardened driver (see h_driver_part.zag for the loop).
// Teaching snippets copied verbatim from grammar_inquiry/i_driver.zag (EXL2/3/4)
// and inquiry_advteacher/a_driver.zag (NEG-AMB, reporting, battery).

// ---- EXL2 teaching (literals 0..9, P = a*16+b) ----

fn c2_P(a:i32,b:i32)i32 { return a*16+b; }

fn c2_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,c2_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,c2_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){c2_dsub(W,t); c2_ddiv(W,t); t=t+1;}
  return;
}

fn c2_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_build(W:[]u8)void {
  c2_canon_build(W,1,1);
  c2_canon_build(W,3,0);
  c2_canon_build(W,5,1);
  c2_canon_build(W,7,0);
  return;
}

fn c2_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=c2_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c2_teach_decomp(W);
  c2_teach_build(W);
  return;
}

// ---- EXL3 teaching (literals 0..7, P = a*8+b) ----

fn c3_P(a:i32,b:i32)i32 { return a*8+b; }

fn c3_dsub(W:[]u8,t:i32)void {
  let a:i32=0;

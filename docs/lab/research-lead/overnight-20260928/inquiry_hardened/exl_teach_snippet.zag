          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=7 && done==0){
    let b:i32=0;
    while(b<=7 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c3_P(a,b)); done=1;}
      b=b+1;

// ---- labels: caret separated ----
fn d_labels()[]u8 {
  let T:[]u8=z_alloc(8192);
  let c:i32=0;
  c=appn(T,c,"ALPHA.ep^CF1a.RET^CF1b.VERIFY.fanin^CF1c.COUNT^DROP.A^CF1d.fallback^");
  c=appn(T,c,"CF1e.multisrc^CF1f.kind1^DROP.B^OSC^DROP.C^CF1g.decline^BETA.ep^CF2.BETA^");
  c=appn(T,c,"DROP.D^GAMMA.ep^CF2.GAMMA^DROP.E^CF3F1.formal^CF3F2.causal^DROP.F^DELTA.ep^");
  c=appn(T,c,"CF2.DELTA^DROP.G^EPS.ep^CF2.EPS^DROP.H^DEV.ep^DEV.stage2^DEVABL.stage2^PB.stale^");
  c=appn(T,c,"PB.stale2^PB.rederive^PB.fresh^DROP.I^LONG.lifetime^DROP.J^OS.ep^OS.q1^OS.q2^");
  c=appn(T,c,"OS.q3^OS.q4^OS.stale1^OS.stale2^OS.ctrl.generic^DROP.K^ABC.A.ep^ABC.B.ep^");
  c=appn(T,c,"ABC.C.ep^ABC.fin.A^ABC.fin.B^ABC.fin.C^BCA.B.ep^BCA.C.ep^BCA.A.ep^BCA.fin.A^");
  c=appn(T,c,"BCA.fin.B^BCA.fin.C^CAB.C.ep^CAB.A.ep^CAB.B.ep^CAB.fin.A^CAB.fin.B^CAB.fin.C^");
  c=appn(T,c,"INT.A.ep^INT.B.ep^INT.A2.ep^INT.C.ep^INT.B2.ep^INT.C2.ep^INT.fin.A^INT.fin.B^");
  c=appn(T,c,"INT.fin.C^");
  return T;
}

// ---- generic builders ----
fn bld(S:[]u8,TA:[]u8,stride:i32)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(TA,0,n);
  let i:i32=0;
  let c:i32=1;
  while(c==1){
    if(i>=n){ c=0; }
    if(c==1){
      let k:i32=0;
      while(k<stride){
        set32(TA,4+(i*stride+k)*4,nx(S,pos));
        k=k+1;
      }
      i=i+1;
    }
  }
  return;
}
fn bld_goals(S:[]u8,GA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(GA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
fn bld_cases(S:[]u8,TA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(TA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
// label slot stride 64 bytes: [len (i32 at +0), chars packed from +4].
fn bld_labels(S:[]u8,LB:[]u8,stride:i32,cntoff:i32)void {
  let p:i32=0;
  let i:i32=0;
  let go:i32=1;
  while(go==1){
    if(p>=S.len){ go=0; }
    if(go==1){
      let st:i32=p;
      let g:i32=1;
      while(g==1){
        if(p>=S.len){ g=0; }
        if(g==1){
          if(S[p]==94){ g=0; } else { p=p+1; }
        }
      }
      let ln:i32=p-st;
      if(ln>stride-8){ ln=stride-8; }
      set32(LB,i*stride,ln);
      let k:i32=0;
      while(k<ln){
        LB[i*stride+4+k]=S[st+k];
        k=k+1;
      }
      if(p<S.len){ p=p+1; }
      i=i+1;
    }
  }
  set32(LB,cntoff,i);
  return;
}
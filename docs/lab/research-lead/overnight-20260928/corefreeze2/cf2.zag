  c=appn(T,c," 9 4 4 -1 26 0 0 -1 15 0");
  c=appn(T,c," 9 9 0 -1 27 0 0 -1 111 0");
  c=appn(T,c," 9 9 1 14 28 0 0 -1 63 3");
  c=appn(T,c," 9 9 1 14 29 1 0 -1 64 3");
  c=appn(T,c," 9 8 1 0 30 0 0 -1 15 4");
  c=appn(T,c," 9 8 1 0 31 0 0 -1 15 4");
  c=appn(T,c," 9 8 0 -1 32 0 0 -1 15 0");
  c=appn(T,c," 9 8 1 0 33 0 0 -1 15 4");
  c=appn(T,c," 9 0 4 -1 34 0 0 -1 15 0");
  c=appn(T,c," 9 0 1 0 35 0 0 -1 15 4");
  c=appn(T,c," 9 0 4 -1 36 0 0 -1 15 0");
  c=appn(T,c," 9 10 0 -1 37 0 0 -1 15 0");
  c=appn(T,c," 9 10 1 18 38 0 0 -1 15 5");
  c=appn(T,c," 9 10 1 18 39 0 0 -1 15 5");
  c=appn(T,c," 9 10 1 18 40 0 0 -1 15 5");
  c=appn(T,c," 9 10 1 18 41 0 0 -1 15 5");
  c=appn(T,c," 9 11 1 18 42 0 0 -1 15 5");
  c=appn(T,c," 9 12 1 18 43 0 0 -1 15 5");
  c=appn(T,c," 9 12 1 19 44 0 0 -1 15 5");
  c=appn(T,c," 9 10 4 -1 45 0 0 -1 15 0");
  // ===== curriculum ABC (arm 7), cases 46..51 =====
  c=appn(T,c," 9 5 0 -1 46 0 0 -1 128 0");
  c=appn(T,c," 9 6 0 -1 47 0 0 -1 128 0");
  c=appn(T,c," 9 7 0 -1 48 0 0 -1 128 0");
  c=appn(T,c," 9 5 1 15 49 0 0 -1 128 6");
  c=appn(T,c," 9 6 1 16 50 0 0 -1 128 6");
  c=appn(T,c," 9 7 1 17 51 0 0 -1 128 6");
  // ===== BCA (arm 8), cases 52..57 =====
  c=appn(T,c," 9 6 0 -1 52 0 0 -1 256 0");
  c=appn(T,c," 9 7 0 -1 53 0 0 -1 256 0");
  c=appn(T,c," 9 5 0 -1 54 0 0 -1 256 0");
  c=appn(T,c," 9 5 1 15 55 0 0 -1 256 6");
  c=appn(T,c," 9 6 1 16 56 0 0 -1 256 6");
  c=appn(T,c," 9 7 1 17 57 0 0 -1 256 6");
  // ===== CAB (arm 9), cases 58..63 =====
  c=appn(T,c," 9 7 0 -1 58 0 0 -1 512 0");
  c=appn(T,c," 9 5 0 -1 59 0 0 -1 512 0");
  c=appn(T,c," 9 6 0 -1 60 0 0 -1 512 0");
  c=appn(T,c," 9 5 1 15 61 0 0 -1 512 6");
  c=appn(T,c," 9 6 1 16 62 0 0 -1 512 6");
  c=appn(T,c," 9 7 1 17 63 0 0 -1 512 6");
  // ===== interleaved A B A C B C (arm 10), cases 64..72 =====
  c=appn(T,c," 9 5 0 -1 64 0 0 -1 1024 0");
  c=appn(T,c," 9 6 0 -1 65 0 0 -1 1024 0");
  c=appn(T,c," 9 5 0 -1 66 0 0 -1 1024 0");

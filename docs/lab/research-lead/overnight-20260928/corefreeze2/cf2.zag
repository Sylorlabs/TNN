  c=appn(T,c," 9 6 1 16 71 0 0 -1 1024 6");
  c=appn(T,c," 9 7 1 17 72 0 0 -1 1024 6");
  return T;
}
// ---- segments: count, then 6 ints per segment ----
// ep_on arm case_start case_len lmode pad pad
// lmode 0 zero L, 1 load snapshot A, 2 load snapshot B
// snapshot A = L right after main case 0 (ALPHA episodes only)
// snapshot B = L at the end of the EXP arm
fn d_segs()[]u8 {
  let T:[]u8=z_alloc(1024);
  let c:i32=0;
  c=appn(T,c,"11");
  c=appn(T,c," 1 0 0 46 0 0");
  c=appn(T,c," 0 1 0 46 0 0");
  c=appn(T,c," 0 2 0 46 1 0");
  c=appn(T,c," 0 3 0 46 2 0");
  c=appn(T,c," 0 4 27 3 0 0");
  c=appn(T,c," 1 5 27 3 0 1");
  c=appn(T,c," 1 6 27 3 0 1");
  c=appn(T,c," 1 7 46 6 0 0");
  c=appn(T,c," 1 8 52 6 0 0");
  c=appn(T,c," 1 9 58 6 0 0");
  c=appn(T,c," 1 10 64 9 0 0");
  return T;
}
fn d_armn()[]u8 {
  let T:[]u8=z_alloc(1024);
  let c:i32=0;
  c=appn(T,c,"EXP^NOEP-COLD^NOEP-WARM-A^NOEP-WARM-B^DEV-NOEP^DEV^DEV-ABL^CURR-ABC^CURR-BCA^CURR-CAB^CURR-INT^");
  return T;
}
// ---- labels: caret separated ----
fn d_labels()[]u8 {
  let T:[]u8=z_alloc(8192);
  let c:i32=0;
  c=appn(T,c,"ALPHA.ep^CF1a.RET^CF1b.VERIFY.fanin^CF1c.COUNT^DROP.A^CF1d.fallback^");
  c=appn(T,c,"CF1e.multisrc^CF1f.kind1^DROP.B^OSC^DROP.C^CF1g.decline^BETA.ep^CF2.BETA^");
  c=appn(T,c,"DROP.D^GAMMA.ep^CF2.GAMMA^DROP.E^CF3F1.formal^CF3F2.causal^DROP.F^DELTA.ep^");
  c=appn(T,c,"CF2.DELTA^DROP.G^EPS.ep^CF2.EPS^DROP.H^DEV.ep^DEV.stage2^DEVABL.stage2^PB.stale^");
  c=appn(T,c,"PB.stale2^PB.rederive^PB.fresh^DROP.I^LONG.lifetime^DROP.J^OS.ep^OS.q1^OS.q2^");
  c=appn(T,c,"OS.q3^OS.q4^OS.stale1^OS.stale2^OS.ctrl.generic^DROP.K^ABC.A.ep^ABC.B.ep^");
  c=appn(T,c,"ABC.C.ep^ABC.fin.A^ABC.fin.B^ABC.fin.C^BCA.B.ep^BCA.C.ep^BCA.A.ep^BCA.fin.A^");
  c=appn(T,c,"BCA.fin.B^BCA.fin.C^CAB.C.ep^CAB.A.ep^CAB.B.ep^CAB.fin.A^CAB.fin.B^CAB.fin.C^");
  c=appn(T,c,"INT.A.ep^INT.B.ep^INT.A2.ep^INT.C.ep^INT.B2.ep^INT.C2.ep^INT.fin.A^INT.fin.B^");
  c=appn(T,c,"INT.fin.C^");
  return T;
}

// ---- generic builders ----
fn bld(S:[]u8,TA:[]u8,stride:i32)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(TA,0,n);
  let i:i32=0;
  let c:i32=1;
  while(c==1){
    if(i>=n){ c=0; }
    if(c==1){
      let k:i32=0;
      while(k<stride){
        set32(TA,4+(i*stride+k)*4,nx(S,pos));
        k=k+1;
      }
      i=i+1;
    }
  }
  return;
}
fn bld_goals(S:[]u8,GA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(GA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
fn bld_cases(S:[]u8,TA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(TA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
// label slot stride 64 bytes: [len (i32 at +0), chars packed from +4].
fn bld_labels(S:[]u8,LB:[]u8,stride:i32,cntoff:i32)void {
  let p:i32=0;
  let i:i32=0;
  let go:i32=1;
  while(go==1){
    if(p>=S.len){ go=0; }
    if(go==1){
      let st:i32=p;
      let g:i32=1;
      while(g==1){
        if(p>=S.len){ g=0; }
        if(g==1){
          if(S[p]==94){ g=0; } else { p=p+1; }
        }
      }
      let ln:i32=p-st;
      if(ln>stride-8){ ln=stride-8; }
      set32(LB,i*stride,ln);
      let k:i32=0;
      while(k<ln){
        LB[i*stride+4+k]=S[st+k];
        k=k+1;
      }
      if(p<S.len){ p=p+1; }
      i=i+1;
    }
  }
  set32(LB,cntoff,i);
  return;
}// cf2_oracle.zag -- THE INDEPENDENT GROUND-TRUTH ORACLE.
//
// KILL BAR K-B (PREREG section 2). This file:
//   * calls NO frozen-core function and mentions NO frozen-core name;
//   * reads the learner arena L zero times;
//   * never consults any arm's output to decide what is correct.
// Its only inputs are the world FACT TABLE and the GOAL RECORD.
//
// Declared semantics, transcribed from the frozen core's own generic
// procedures (c15_base.zag lines 79-174):
//   RET(rel,obj)    -> SET of subjects s with (s,rel,obj) a fact.
//   VERIFY(chain)   -> 1 iff every step (s,r,o) is a fact, else 0.
//                      Fanned in over source set S: the SET of x in S such
//                      that the chain with every s==0 slot filled by x holds.
//   COUNT(rel,subs) -> number of DISTINCT objects o with (x,rel,o) a fact
//                      for some x in subs.
// Uniform dataflow rule, also from the core: a kind-1 scalar-copy link
// carries the source need's produced value and fires ONLY if the source
// output record is non-empty; otherwise the destination field is unchanged.
// Need family is decided from the need's FIELD SHAPE exactly as the core's
// the core's own family detector decides it, so an unbindable shape is declined.
//
// Scope: a goal is IN SCOPE iff every link has src_need < dst_need. Then need
// order is a valid topological order and one forward pass is exact. A goal
// with a self-link (the oscillation probe) is OUT OF SCOPE and is excluded
// from the competence denominator.

fn oq_nn(G:[]u8)i32 { return get32(G,4); }
fn oq_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn oq_nf(G:[]u8,n:i32)i32 { return get32(G,oq_off(G,n)+4); }
fn oq_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,oq_off(G,n)+8+f*4); }
fn oq_lb(G:[]u8)i32 { return oq_off(G,oq_nn(G)); }
fn oq_nl(G:[]u8)i32 { return get32(G,oq_lb(G)); }
fn oq_l(G:[]u8,l:i32,w:i32)i32 { return get32(G,oq_lb(G)+4+l*28+w*4); }
fn oq_scope(G:[]u8)i32 {
  let nl:i32=oq_nl(G);
  let l:i32=0;
  while(l<nl){
    if(oq_l(G,l,4)<oq_l(G,l,1)){ } else { return 0; }
    l=l+1;
  }
  return 1;
}
fn is_chain(fq:i32,ns:i32)i32 {
  if(ns<1){ return 0; }
  if(ns>16){ return 0; }
  if(fq==1+ns*3){ return 1; }
  return 0;
}
// family from field shape; -1 = unbindable
fn oq_fam(fq:i32,f0:i32,f1:i32)i32 {
  if(fq==2){ return 0; }
  if(fq==3){ if(f1==1){ return 2; } return -1; }
  if(fq<4){ return -1; }
  if(is_chain(fq,f0)==1){ return 1; }
  return -1;
}
// 1 if v already among the cnt values at base (byte offset)
fn inset(B:[]u8,base:i32,cnt:i32,v:i32)i32 {
  let k:i32=0;
  while(k<cnt){
    if(get32(B,base+k*4)==v){ return 1; }
    k=k+1;
  }
  return 0;
}
fn fac_hit(FA:[]u8,fs:i32,nf:i32,s:i32,r:i32,o:i32)i32 {
  let j:i32=0;
  while(j<nf){
    let a:i32=0;
    if(get32(FA,4+(fs+j)*12)==s){ a=1; }
    if(a==1){
      let b:i32=0;
      if(get32(FA,4+(fs+j)*12+4)==r){ b=1; }
      if(b==1){
        if(get32(FA,4+(fs+j)*12+8)==o){ return 1; }
      }
    }
    j=j+1;
  }
  return 0;
}
fn oq_chain(WF:[]u8,n:i32,FA:[]u8,fs:i32,nf:i32,sub:i32)i32 {
  let ns:i32=get32(WF,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(WF,n*80+4+(1+i*3)*4);
    let r:i32=get32(WF,n*80+4+(2+i*3)*4);
    let o:i32=get32(WF,n*80+4+(3+i*3)*4);
    if(sub>=0){ if(s==0){ s=sub; } }
    if(fac_hit(FA,fs,nf,s,r,o)==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
fn oq_count(FA:[]u8,fs:i32,nf:i32,rel:i32,SB:[]u8,base:i32,nsubs:i32) i32 {
  let c:i32=0;
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(SB,base+4+si*4);
    let j:i32=0;
    while(j<nf){
      let a:i32=0;
      if(get32(FA,4+(fs+j)*12)==subj){ a=1; }
      if(a==1){
        let b:i32=0;
        if(get32(FA,4+(fs+j)*12+4)==rel){ b=1; }
        if(b==1){
          let fo:i32=get32(FA,4+(fs+j)*12+8);
          if(inset(SB,base+256,c,fo)==0){ set32(SB,base+256+c*4,fo); c=c+1; }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return c;
}
// run the oracle. Returns nneeds, or -1 if the goal is unbindable/declined.
// Results land in OF: need n at OF+n*160, [count, values...], in NEED order.
fn orc_run(G:[]u8,FA:[]u8,fs:i32,nf:i32,WF:[]u8,OF:[]u8,SB:[]u8)i32 {
  let nn:i32=oq_nn(G);
  let n:i32=0;
  while(n<nn){
    set32(WF,n*80,0);
    let q:i32=oq_nf(G,n);
    set32(WF,n*80,q);
    let f:i32=0;
    while(f<q){
      set32(WF,n*80+4+f*4,oq_f(G,n,f));
      f=f+1;
    }
    set32(OF,n*160,0);
    n=n+1;
  }
  let nl:i32=oq_nl(G);
  n=0;
  while(n<nn){
    let l:i32=0;
    while(l<nl){
      let hit:i32=0;
      if(oq_l(G,l,0)==1){ if(oq_l(G,l,1)==n){ hit=1; } }
      if(hit==1){
        let sn:i32=oq_l(G,l,4);
        if(get32(OF,sn*160)>0){
          let v:i32=0;
          if(oq_l(G,l,5)==0){ v=get32(WF,sn*80+4+oq_l(G,l,6)*4); }
          if(oq_l(G,l,5)==1){ v=get32(OF,sn*160+4+oq_l(G,l,6)*4); }
          set32(WF,n*80+4+oq_l(G,l,3)*4,v);
        }
      }
      l=l+1;
    }
    let fq:i32=get32(WF,n*80);
    let fam:i32=oq_fam(fq,get32(WF,n*80+4),get32(WF,n*80+8));
    if(fam<0){ return -1; }
    if(fam==0){
      let rel:i32=get32(WF,n*80+4);
      let obj:i32=get32(WF,n*80+8);
      let c:i32=0;
      let j:i32=0;
      while(j<nf){
        let a:i32=0;
        if(get32(FA,4+(fs+j)*12+4)==rel){ a=1; }
        if(a==1){
          let b:i32=0;
          if(get32(FA,4+(fs+j)*12+8)==obj){ b=1; }
          if(b==1){
            let sx:i32=get32(FA,4+(fs+j)*12);
            if(inset(OF,n*160+4,c,sx)==0){
              if(c<32){ set32(OF,n*160+4+c*4,sx); }
              c=c+1;
            }
          }
        }
        j=j+1;
      }
      set32(OF,n*160,c);
    }
    if(fam==1){
      let src:i32=-1;
      let l2:i32=0;
      while(l2<nl){
        let h2:i32=0;
        if(oq_l(G,l2,0)==2){ if(oq_l(G,l2,1)==n){ h2=1; } }
        if(h2==1){ src=oq_l(G,l2,4); }
        l2=l2+1;
      }
      if(src<0){
        let vv:i32=oq_chain(WF,n,FA,fs,nf,-2);
        set32(OF,n*160,1);
        set32(OF,n*160+4,vv);
      }
      if(src>=0){
        let m:i32=get32(OF,src*160);
        let np:i32=0;
        let k:i32=0;
        while(k<m){
          let sub:i32=get32(OF,src*160+4+k*4);
          if(oq_chain(WF,n,FA,fs,nf,sub)==1){
            set32(OF,n*160+4+np*4,sub);
            np=np+1;
          }
          k=k+1;
        }
        set32(OF,n*160,np);
      }
    }
    if(fam==2){
      let rel3:i32=get32(WF,n*80+4);
      let tot:i32=0;
      let has:i32=0;
      let l3:i32=0;
      while(l3<nl){
        let h3:i32=0;
        if(oq_l(G,l3,0)==3){ if(oq_l(G,l3,1)==n){ h3=1; } }
        if(h3==1){
          let sn3:i32=oq_l(G,l3,4);
          let m2:i32=get32(OF,sn3*160);
          let k2:i32=0;
          while(k2<m2){
            set32(SB,n*520+4+tot*4,get32(OF,sn3*160+4+k2*4));
            tot=tot+1;
            k2=k2+1;
          }
          has=1;
        }
        l3=l3+1;
      }
      if(has==0){
        set32(SB,n*520+4,get32(WF,n*80+12));
        tot=1;
      }
      let cc:i32=oq_count(FA,fs,nf,rel3,SB,n*520,tot);
      set32(OF,n*160,1);
      set32(OF,n*160+4,cc);
    }
    n=n+1;
  }
  return nn;
}
// set equality on the VALUE lists of two records (byte bases, counts)
fn eq_set(A:[]u8,ab:i32,an:i32,B:[]u8,bb:i32,bn:i32)i32 {
  if(an!=bn){ return 0; }
  let k:i32=0;
  while(k<an){
    if(inset(A,ab,an,get32(B,bb+k*4))==0){ return 0; }
    k=k+1;
  }
  return 1;
}// c4_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Diamond follow-up to C422 (c3_learn.zag): plan records widened to 4
// needs per plan (56-byte entries), stats block moved to 13224, and
// apply_kind3 generalized to multi-source fan-in (preregistered).
// Binding by trial, topo assembly, version selection, plan
// persist/reuse/re-derive, and decline logic are the C422 logic
// unchanged.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   BIND table at 12744: 8 entries x 32 bytes:
//     [tag, bound_fam, ok0, f0, ok1, f1, ok2, f2].
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects. Returns -1 if the relation is outside the
// learned coverage.
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 3) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED (preregistered, Section 2.4): subjects from ALL incoming
// kind-3 links concatenate in goal-record link order into SUBL[ni*128].
// On a chain (one incoming kind-3 link) this is byte-identical to the
// C422 behavior; on a diamond (two or more sources) it is the generic
// fan-in reading. No goal-shape test, no branch count: the same link
// kind applies uniformly to any DAG.
// Returns 1 if at least one kind-3 link targeted ni, else 0.
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*160);
        let k:i32=0;
        while(k<n){
          set32(SUBL,ni*128+4+tot*4,get32(OUTS,sn*160+4+k*4));
          tot=tot+1;
          k=k+1;
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*128,tot);
    return 1;
  }
  return 0;
}
// ---- binding table ----
fn bind_off(bi:i32)i32 { return 12744+bi*32; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Returns 1 iff every need tag ends bound; 0 if any need is unbindable.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_fam(L,bi)<0){
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        let bo:i32=bind_off(bi);
        if(fam==0){
          if(r==1){ set32(L,bo+8,get32(L,bo+8)+1); }
          if(r==0){ set32(L,bo+12,get32(L,bo+12)+1); }
        }
        if(fam==1){
          if(r==1){ set32(L,bo+16,get32(L,bo+16)+1); }
          if(r==0){ set32(L,bo+20,get32(L,bo+20)+1); }
        }
        if(fam==2){
          if(r==1){ set32(L,bo+24,get32(L,bo+24)+1); }
          if(r==0){ set32(L,bo+28,get32(L,bo+28)+1); }
        }
        if(r==1){
          if(bind_fam(L,bi)<0){ set32(L,bo+4,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let bi2:i32=bind_find(L,need_tag(G,m));
    if(bi2<0){ return 0; }
    if(bind_fam(L,bi2)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){
      let nn:i32=g_nneeds(G);
      set32(L,13000+pi*56,gtag);
      set32(L,13000+pi*56+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        set32(L,13000+pi*56+8+p*12,ni);
        set32(L,13000+pi*56+8+p*12+4,tag);
        set32(L,13000+pi*56+8+p*12+8,bind_fam(L,bi));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1,idx2,tag2,fam2,idx3,tag3,fam3]
// into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)!=0){
      let k:i32=0;
      while(k<14){
        set32(out,k*4,get32(L,13000+pi*56+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,13000+pi*56,0); pi=pi+1; }
  return;
}
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<8){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*80+4);
      let ver3:i32=cnt_version(L,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
      let ns3:i32=0;
      if(has3==1){ ns3=get32(SUBL,ni*128); }
      if(has3==0){
        set32(SUBL,ni*128,1);
        set32(SUBL,ni*128+4,get32(W,ni*80+12));
        ns3=1;
      }
      let cc:i32=0;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,cc);
      ans_append_rec(ans,OUTS,ni);
    }
    p=p+1;
  }
  return;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
  return 1;
}

// =====================================================================
// c5 ADDITIVE GENERALIZATION (PREREG Section 2.2).
// Everything above this line is byte-identical to c4_learn.zag
// (cogops-diamond). What follows is purely additive: no C433
// function is modified. Frozen entry points keep their names:
// compose, execute_plan, topo, apply_kind1.
// New entry points: topo_g, apply_kind1_g, snap_out, out_eq_snap,
// exec_step_iter, execute_plan_iter, compose_iter, plan_drop.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records.
// =====================================================================

// ---- topo_g: Kahn with stall detection + deterministic fallback ----
// Runs Kahn; if no zero-indegree unplaced node remains, stops
// (instead of the frozen topo's re-place-node-0, which silently
// corrupts the order) and appends the unplaced needs in index
// order. Returns the Kahn-placed count (== nneeds on a DAG).
// Not cycle detection: it completes any partial order
// deterministically, with no goal-shape or back-edge test.
fn topo_g(G:[]u8,ord:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let kplaced:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return kplaced;
}
// ---- apply_kind1_g: kind-1 links fire only from non-empty sources ----
// Uniform dataflow rule: a scalar-copy link carries the source
// need's produced value; if the source output record is empty
// there is no value to carry, so the destination field keeps its
// current value. Identical to apply_kind1 whenever every kind-1
// source is non-empty (the whole C433 battery).
fn apply_kind1_g(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let sn:i32=link_w(G,l,4);
      if(get32(OUTS,sn*160)>0){
        let ds:i32=link_w(G,l,3);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let v:i32=0;
        if(sk==0){ v=get32(W,sn*80+4+ss*4); }
        if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
        set32(W,ni*80+4+ds*4,v);
      }
    }
    l=l+1;
  }
  return;
}
// ---- output-record snapshot / comparison helpers ----
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8)void {
  let n:i32=get32(OUTS,ni*160);
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8)i32 {
  let n:i32=get32(OUTS,ni*160);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*160+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- exec_step_iter: execute one plan step with the generalized link rule ----
// Versions recorded to vbuf[p*4]. No answer emission; the caller
// emits final records after quiescence.
fn exec_step_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,p:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  let ni:i32=get32(L,13000+pi*56+8+p*12);
  let fam:i32=get32(L,13000+pi*56+8+p*12+8);
  apply_kind1_g(G,W,OUTS,ni);
  if(fam==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    let ver:i32=ret_version(L,rel);
    set32(vbuf,p*4,ver);
    if(ver==2){
      set32(L,13252,get32(L,13252)+1);
      ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
    }
    if(ver==0){
      set32(L,13256,get32(L,13256)+1);
      ret_gen(A,rel,obj,K,0,OUTS,ni*160);
    }
  }
  if(fam==1){
    let ver2:i32=vfy_version(L,W,ni);
    set32(vbuf,p*4,ver2);
    if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
    if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
    let src:i32=fanin_src(G,ni);
    if(src<0){
      w_to_chain(W,ni,tmpc,-1);
      let vv:i32=0;
      if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
      if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,vv);
    }
    if(src>=0){
      let nsub:i32=get32(OUTS,src*160);
      let npass:i32=0;
      let k:i32=0;
      while(k<nsub){
        let sub:i32=get32(OUTS,src*160+4+k*4);
        w_to_chain(W,ni,tmpc,sub);
        let vv2:i32=0;
        if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
        if(vv2==1){
          set32(OUTS,ni*160+4+npass*4,sub);
          npass=npass+1;
        }
        k=k+1;
      }
      set32(OUTS,ni*160,npass);
    }
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*80+4);
    let ver3:i32=cnt_version(L,rel3);
    set32(vbuf,p*4,ver3);
    let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
    let ns3:i32=0;
    if(has3==1){ ns3=get32(SUBL,ni*128); }
    if(has3==0){
      set32(SUBL,ni*128,1);
      set32(SUBL,ni*128+4,get32(W,ni*80+12));
      ns3=1;
    }
    let cc:i32=0;
    if(ver3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    if(ver3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    set32(OUTS,ni*160,1);
    set32(OUTS,ni*160+4,cc);
  }
  return;
}
// ---- execute_plan_iter: change-driven iterated execution ----
// Steps run in plan order; a need executes when dirty (all start
// dirty). If its output record changed, link-successors are marked
// dirty. Halts on quiescence (a pass with no dirty need) or the
// pass CAP (16, frozen totality bound). Answer records are emitted
// in plan order with FINAL values. vbuf[20] gets passes used.
fn execute_plan_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  while(running==1){
    if(pass>=cap){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(L,13000+pi*56+8+p*12);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  let q:i32=0;
  while(q<nn){
    let nj:i32=get32(L,13000+pi*56+8+q*12);
    ans_append_rec(ans,OUTS,nj);
    q=q+1;
  }
  return;
}
// ---- compose_iter: the generalized composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes used; ans = final records.
fn compose_iter(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let dirty:[]u8=z_alloc(16);
  let snap:[]u8=z_alloc(136);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
  return 1;
}
// ---- plan_drop: clear the stored plan for one goal tag (generic) ----
fn plan_drop(L:[]u8,gtag:i32)void {
  let pi:i32=plan_find(L,gtag);
  if(pi>=0){ set32(L,13000+pi*56,0); }
  return;
}

// =====================================================================
// c7 ADDITIVE: learner-invented oscillation handling.
// Everything above this line is byte-identical to c6_learn.zag
// (cogops-oscillatory). What follows is purely additive: no frozen
// function is modified. New entry points: traj_base, outc_base,
// outc_phase_base, traj_log, traj_need_eq, traj_state_eq,
// osc_review, outc_find, outc_phase_copy, outc_store,
// outc_phase_eq, osc_one_pass, osc_handle.
// Learner-state regions (L holds 16384 bytes; prior use ends at
// 13276):
//   TRAJ at 13300: [ntraj]; snapshots at 13304+(pass*4+ni)*36,
//   pass below 8, ni below 4; each need snapshot is nine i32
//   cells [n, v0..v7].
//   OUTC at 14500: [nout]; at most three entries of 464 bytes at
//   14504+e*464: [goal_tag, lag, nph, src, four reserved cells,
//   then phases: at most three phases times four needs times
//   nine i32 cells].
// No world literals, no goal tags, no need tags, no relation ids
// appear below: every value arrives at runtime through goal
// records, episodes, or the trajectory.
// =====================================================================

fn traj_base(pass:i32,ni:i32)i32 { return 13304+(pass*4+ni)*36; }
fn outc_base(e:i32)i32 { return 14504+e*464; }
fn outc_phase_base(e:i32,t:i32,ni:i32)i32 {
  return 14504+e*464+32+(t*4+ni)*36;
}
// snapshot every need's output record after one pass
fn traj_log(L:[]u8,OUTS:[]u8,nn:i32,pass:i32)void {
  if(pass<0){ return; }
  if(pass>7){ return; }
  let j:i32=0;
  while(j<nn){
    let n:i32=get32(OUTS,j*160);
    let bo:i32=traj_base(pass,j);
    set32(L,bo,n);
    let k:i32=0;
    while(k<8){
      let v:i32=0;
      if(k<n){ v=get32(OUTS,j*160+4+k*4); }
      set32(L,bo+4+k*4,v);
      k=k+1;
    }
    j=j+1;
  }
  set32(L,13300,pass+1);
  return;
}
fn traj_need_eq(L:[]u8,p:i32,q:i32,ni:i32)i32 {
  let bp:i32=traj_base(p,ni);
  let bq:i32=traj_base(q,ni);
  let n:i32=get32(L,bp);
  if(n!=get32(L,bq)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,bp+4+k*4)!=get32(L,bq+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
fn traj_state_eq(L:[]u8,p:i32,q:i32,nn:i32)i32 {
  let j:i32=0;
  while(j<nn){
    if(traj_need_eq(L,p,q,j)==0){ return 0; }
    j=j+1;
  }
  return 1;
}
// nearest-first scan: does snapshot[pass] equal an earlier
// snapshot? Returns the lag, or zero when nothing recurs.
fn osc_review(L:[]u8,nn:i32,pass:i32)i32 {
  let q:i32=pass-1;
  while(q>=0){
    if(traj_state_eq(L,pass,q,nn)==1){ return pass-q; }
    q=q-1;
  }
  return 0;
}
fn outc_find(L:[]u8,gtag:i32)i32 {
  let n:i32=get32(L,14500);
  let e:i32=0;
  while(e<n){
    if(get32(L,outc_base(e))==gtag){ return e; }
    e=e+1;
  }
  return -1;
}
fn outc_phase_copy(L:[]u8,e:i32,t:i32,ni:i32,p:i32)void {
  let sb:i32=traj_base(p,ni);
  let db:i32=outc_phase_base(e,t,ni);
  let k:i32=0;
  while(k<9){
    set32(L,db+k*4,get32(L,sb+k*4));
    k=k+1;
  }
  return;
}
fn outc_store(L:[]u8,gtag:i32,lag:i32,q:i32,nn:i32,src:i32)i32 {
  let e:i32=outc_find(L,gtag);
  if(e<0){
    e=get32(L,14500);
    if(e>2){ e=0; }
    if(get32(L,14500)<3){ set32(L,14500,get32(L,14500)+1); }
  }
  let b:i32=outc_base(e);
  set32(L,b,gtag);
  set32(L,b+4,lag);
  set32(L,b+8,lag);
  set32(L,b+12,src);
  set32(L,b+16,0);
  set32(L,b+20,0);
  set32(L,b+24,0);
  set32(L,b+28,0);
  let t:i32=0;
  while(t<lag){
    let j:i32=0;
    while(j<nn){
      outc_phase_copy(L,e,t,j,q+t);
      j=j+1;
    }
    t=t+1;
  }
  return e;
}
// stored phase (e,t,ni) against trajectory snapshot p
fn outc_phase_eq(L:[]u8,e:i32,t:i32,ni:i32,p:i32)i32 {
  let db:i32=outc_phase_base(e,t,ni);
  let sb:i32=traj_base(p,ni);
  let n:i32=get32(L,db);
  if(n!=get32(L,sb)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,db+4+k*4)!=get32(L,sb+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// one full pass over the plan in plan order; R+28 is the
// spec-version flag, cleared if any step misses its spec version
fn osc_one_pass(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8)void {
  let nn:i32=get32(L,13000+pi*56+4);
  let p:i32=0;
  while(p<nn){
    exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    let ver:i32=get32(vbuf,p*4);
    let want:i32=-1;
    if(fam==0){ want=2; }
    if(fam==1){ want=3; }
    if(fam==2){ want=5; }
    if(ver!=want){ set32(R,28,0); }
    p=p+1;
  }
  return;
}
// osc_handle: the learner-owned oscillation-handling driver.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a response invented from this trajectory,
// 2 handled by a stored response from the outcome record.
fn osc_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let vbuf:[]u8=z_alloc(32);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  let gt:i32=g_tag(G);
  let pre:i32=plan_find(L,gt);
  let pi:i32=pre;
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
  }
  if(pi<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  let nn:i32=get32(L,13000+pi*56+4);
  mat_inputs(G,W);
  let e:i32=outc_find(L,gt);
  if(e>=0){
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
        traj_log(L,OUTS,nn,mpass);
        let jj:i32=0;
        while(jj<nn){
          if(outc_phase_eq(L,e,mpass,jj,mpass)==0){ okk=0; }
          jj=jj+1;
        }
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  let pass:i32=0;
  while(pass<6){
    osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
    traj_log(L,OUTS,nn,pass);
    if(pass>1){
      let lag:i32=osc_review(L,nn,pass);
      if(lag==1){ return 0; }
      if(lag>1){
        if(lag<4){
          let q0:i32=pass-lag;
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass+1);
          if(traj_state_eq(L,pass+1,q0+1,nn)==1){
            let ee:i32=outc_store(L,gt,lag,q0,nn,0);
            set32(R,0,1);
            set32(R,4,pass+2);
            set32(R,8,lag);
            set32(R,12,q0);
            set32(R,16,lag);
            set32(R,20,0);
            set32(R,24,ee);
            return 1;
          }
          return 0;
        }
      }
    }
    pass=pass+1;
  }
  return 0;
}
// ib_module.zag -- ported contract ops for INTEGRATION-B1B2.
//
// Verbatim port of four of the five ops of C443's frozen u_* module
// (subsumption_p0/sp_module.zag, itself byte-copied from C424's
// cu_full.zag lines 55-389): u_induct, u_check, u_invalidate,
// u_revise, plus their helpers. u_grow is EXCLUDED per the minimal
// port (B1/B2 only; grow was not exercised even in C424).
// Function bodies are byte-identical to the source; only this header
// and the sg/ss helpers (carried from sp_base.zag) are added.
//
// The module operates on the dedicated judgment-state array S with
// the frozen fixed slots: judgment table 300-302 / 304+ / 528+,
// global counters 900-925, induct scratch 1200-1209, C_Q at slot 7.
// Contract layout at cbase: +0 CONTRACT_TY, +1 CONTRACT_SET,
// +2 NFIELDS, +3 NCLAUSES, +4+i*8 clause i:
// field,xform,k,lo,hi,active,dc,spare.
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
//
// In this lane the module governs the composer's binding layer:
// one binding contract per need tag over [tag, fam] (nf=2) at
// 2000+bi*100 (B1), and one coverage contract per procedure family
// over [rel] (nf=1) at 3000/3100/3200 (B2).
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn u_feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==3){return 1;} if(p==5){return 1;}
  if(p==7){return 1;} if(p==9){return 1;}
  return 2;
}
fn u_feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  return 32;
}
fn u_feat_val(v:i32,p:i32)i32 {
  let xf:i32=u_feat_xf(p);
  let k:i32=u_feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn u_fval(f:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(f==0){return f0;}
  if(f==1){return f1;}
  if(f==2){return f2;}
  if(f==3){return f3;}
  if(f==4){return f4;}
  return f5;
}
fn u_acc(S:[]u8,j:i32,f:i32)i32 { return sg(S,304+j*7+1+f); }
fn u_rej(S:[]u8,j:i32,f:i32)i32 { return sg(S,528+j*7+1+f); }
fn u_rejlen(S:[]u8,j:i32)i32 { return sg(S,528+j*7); }

// check: 1 iff nf matches and at least one active clause holds and
// every active clause holds; 0 otherwise (empty active set judges 0).
fn u_check(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let any:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      any=1;
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let lo:i32=sg(S,b+3);
      let hi:i32=sg(S,b+4);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<lo){return 0;}
      if(v>hi){return 0;}
    }
    i=i+1;
  }
  if(any==0){return 0;}
  return 1;
}

// check_all: same but over all committed clauses (ignores active).
fn u_check_all(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

fn u_write_clause(S:[]u8,cbase:i32,i:i32,f:i32,p:i32,mn:i32,mx:i32)void {
  let b:i32=cbase+4+i*8;
  ss(S,b,f); ss(S,b+1,u_feat_xf(p)); ss(S,b+2,u_feat_k(p));
  ss(S,b+3,mn); ss(S,b+4,mx); ss(S,b+5,1); ss(S,b+6,0); ss(S,b+7,0);
  return;
}

// errors of the committed clause set on the judgment table.
fn u_fiterr(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  let err:i32=0;
  let j:i32=0;
  while(j<na){
    if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    if(u_rejlen(S,r)==nf){
      if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
    }
    r=r+1;
  }
  return err;
}

// induct: minimal-commitment search. Increasing cardinality (1, then
// 2); valid = conjunction rejects every in-scope reject (len ==
// nf); among valid sets prefer fewer clauses, then maximal total
// accept-region width (least committal), then lexicographic order.
fn u_induct(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  if(na==0){return 0;}
  if(nf<1){return 0;}
  ss(S,1200,-1); ss(S,1201,-1); ss(S,1202,0); ss(S,1203,0);
  ss(S,1204,-1); ss(S,1205,0);
  ss(S,1206,-1); ss(S,1207,-1); ss(S,1208,0); ss(S,1209,0);
  let f:i32=0;
  while(f<nf){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<na){
        let fv:i32=u_feat_val(u_acc(S,j,f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      let valid:i32=1;
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          let fv2:i32=u_feat_val(u_rej(S,r,f),p);
          if(fv2>=mn){
            if(fv2<=mx){valid=0;}
          }
        }
        r=r+1;
      }
      if(valid==1){
        let w:i32=mx-mn;
        if(w>sg(S,1204)){
          ss(S,1204,w); ss(S,1200,f); ss(S,1201,p);
          ss(S,1202,mn); ss(S,1203,mx); ss(S,1205,1);
        }
      }
      p=p+1;
    }
    f=f+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,1);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  ss(S,1204,-1); ss(S,1205,0);
  let np:i32=nf*11;
  let a:i32=0;
  while(a<np){
    let bb:i32=a+1;
    while(bb<np){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=bb/11; let pb:i32=bb-fb*11;
      let mn0:i32=999999999; let mx0:i32=-999999999;
      let mn1:i32=999999999; let mx1:i32=-999999999;
      let j2:i32=0;
      while(j2<na){
        let v0:i32=u_feat_val(u_acc(S,j2,fa),pa);
        if(v0<mn0){mn0=v0;}
        if(v0>mx0){mx0=v0;}
        let v1:i32=u_feat_val(u_acc(S,j2,fb),pb);
        if(v1<mn1){mn1=v1;}
        if(v1>mx1){mx1=v1;}
        j2=j2+1;
      }
      let valid2:i32=1;
      let r2:i32=0;
      while(r2<nr){
        if(u_rejlen(S,r2)==nf){
          let h0:i32=0;
          let h1:i32=0;
          let w0:i32=u_feat_val(u_rej(S,r2,fa),pa);
          if(w0<mn0){h0=1;}
          if(w0>mx0){h0=1;}
          let w1:i32=u_feat_val(u_rej(S,r2,fb),pb);
          if(w1<mn1){h1=1;}
          if(w1>mx1){h1=1;}
          if(h0==0){
            if(h1==0){valid2=0;}
          }
        }
        r2=r2+1;
      }
      if(valid2==1){
        let wsum:i32=(mx0-mn0)+(mx1-mn1);
        if(wsum>sg(S,1204)){
          ss(S,1204,wsum);
          ss(S,1200,fa); ss(S,1201,pa); ss(S,1202,mn0); ss(S,1203,mx0);
          ss(S,1206,fb); ss(S,1207,pb); ss(S,1208,mn1); ss(S,1209,mx1);
          ss(S,1205,1);
        }
      }
      bb=bb+1;
    }
    a=a+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    u_write_clause(S,cbase,1,sg(S,1206),sg(S,1207),sg(S,1208),sg(S,1209));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,2);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  return 0;
}
// invalidate: compare judgment vs consequence. Failure bumps the
// contract fail run and every active clause's disconfirmation
// counter; a clause reaching 2 consecutive disconfirmations is
// retired. Three consecutive failures latch the revision request.
fn u_invalidate(S:[]u8,cbase:i32,judgment:i32,consequence:i32)i32 {
  let ok:i32=0;
  if(judgment==consequence){ok=1;}
  ss(S,916,sg(S,916)+1);
  if(ok==1){ ss(S,912,sg(S,912)+1); }
  if(sg(S,cbase+1)==1){
    if(ok==1){
      ss(S,900,0);
      let n:i32=sg(S,cbase+3);
      let i:i32=0;
      while(i<n){
        let b:i32=cbase+4+i*8;
        if(sg(S,b+5)==1){ ss(S,b+6,0); }
        i=i+1;
      }
    }
    if(ok==0){
      ss(S,900,sg(S,900)+1);
      let n2:i32=sg(S,cbase+3);
      let i2:i32=0;
      while(i2<n2){
        let b2:i32=cbase+4+i2*8;
        if(sg(S,b2+5)==1){
          let dc:i32=sg(S,b2+6)+1;
          ss(S,b2+6,dc);
          if(dc>=2){ ss(S,b2+5,0); }
        }
        i2=i2+1;
      }
      if(sg(S,900)>=3){
        if(sg(S,901)==0){
          ss(S,901,1);
          if(sg(S,908)<0){ ss(S,908,sg(S,7)); }
        }
      }
    }
  }
  return ok;
}

// revise: on a latched request (and enable), score the committed
// clause set on the judgment table, re-induct, count the revision.
fn u_revise(S:[]u8,cbase:i32,enabled:i32)void {
  if(sg(S,901)==1){
    if(enabled==1){
      let nf:i32=sg(S,300);
      let na:i32=sg(S,301);
      let nr:i32=sg(S,302);
      let err:i32=0;
      let j:i32=0;
      while(j<na){
        if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
        j=j+1;
      }
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
        }
        r=r+1;
      }
      ss(S,924,err);
      let ui2:i32=u_induct(S,cbase);
      ss(S,904,sg(S,904)+1);
      let ui2b:i32=ui2;
      ss(S,925,ui2b);
      ss(S,901,0);
      ss(S,900,0);
    }
  }
  return;
}

// cf2_engine.zag -- GENERIC DRIVER for the CORE-FREEZE-2 battery.
//
// CONTAINS ZERO world relation ids, ZERO goal tags, ZERO need tags in any
// literal (kill bar K-A). Its entire vocabulary is table indices, the four
// dispatch modes, and field names.
//
// CONCATENATION ORDER:
//   cf2_base, cf2_data, cf2_oracle, c8_learn, hq_module, cf2_engine
// The engine is LAST because Zag has no forward declarations and main must
// call frozen-core functions.
//
// DISCLOSED DRIVER CODE (not cognition, not a capability, charter 2/108):
//   D1 mode 4 "drop all plans": loops the 4 plan slots and calls the frozen
//      core's own generic plan_drop on each live tag. Without it the 4-slot
//      plan table overflows on any battery using more than 4 goal tags;
//      plan_new then returns -1 and execute_plan reads out of bounds.
//   D2 plan-order re-index: after compose_iter, map emitted record q to need
//      index plan[q] by READING the plan table, so the correctness predicate
//      is keyed on need index (PREREG section 3).
//   D3 lesion cells: zeroing L[0] (RET coverage count) and L[14500] (outcome
//      record count) for the ablation arms.
// D1 and D2 are measurement plumbing. Neither adds domain knowledge.

fn zzero(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return;
}
fn p_i(b:[]u8,c:i32,v:i32)i32 { return o_i64(b,c,v as i64); }
fn p_rec(b:[]u8,c:i32,B:[]u8,base:i32) i32 {
  let n:i32=get32(B,base);
  let r:i32=o_i64(b,c,n as i64);
  let k:i32=0;
  while(k<n){
    r=o_app(b,r,",");
    r=p_i(b,r,get32(B,base+4+k*4));
    k=k+1;
  }
  return r;
}
fn p_orc(b:[]u8,c:i32,OWO:[]u8,nn:i32) i32 {
  let r:i32=o_app(b,c,"[");
  let n:i32=0;
  while(n<nn){
    if(n>0){ r=o_app(b,r,";"); }
    r=p_rec(b,r,OWO,n*160);
    n=n+1;
  }
  return o_app(b,r,"]");
}
fn p_core(b:[]u8,c:i32,ans:[]u8,CS:[]u8,CL:[]u8,nn:i32) i32 {
  let r:i32=o_app(b,c,"[");
  let n:i32=0;
  while(n<nn){
    if(n>0){ r=o_app(b,r,";"); }
    r=o_i64(b,r,get32(CL,n*4) as i64);
    let k:i32=0;
    while(k<get32(CL,n*4)){
      r=o_app(b,r,",");
      r=p_i(b,r,get32(ans,get32(CS,n*4)+4+k*4));
      k=k+1;
    }
    n=n+1;
  }
  return o_app(b,r,"]");
}
fn p_vv(b:[]u8,c:i32,vbuf:[]u8,nn:i32) i32 {
  let r:i32=o_app(b,c,"[");
  let n:i32=0;
  while(n<nn){
    if(n>0){ r=o_app(b,r,","); }
    r=p_i(b,r,get32(vbuf,n*4));
    n=n+1;
  }
  return o_app(b,r,"]");
}
fn p_lab(b:[]u8,c:i32,LB:[]u8,i:i32) i32 {
  let ln:i32=get32(LB,i*64);
  return o_app(b,c,LB[i*64+4 .. i*64+4+ln]);
}
fn p_arm(b:[]u8,c:i32,AB:[]u8,i:i32) i32 {
  let ln:i32=get32(AB,i*32);
  return o_app(b,c,AB[i*32+4 .. i*32+4+ln]);
}
fn lnonz(L:[]u8)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<4096){
    if(get32(L,i*4)!=0){ c=c+1; }
    i=i+1;
  }
  return c;
}
fn armbit(arm:i32)i32 {
  let bit:i32=1;
  let k:i32=0;
  while(k<arm){ bit=bit*2; k=k+1; }
  return bit;
}
fn buildw(WA:[]u8,FA:[]u8,A:[]u8,w:i32)void {
  set32(A,0,0);
  let fs:i32=get32(WA,4+w*16+0);
  let nf:i32=get32(WA,4+w*16+4);
  let k:i32=0;
  while(k<nf){
    fact_add(A,get32(FA,4+(fs+k)*12),get32(FA,4+(fs+k)*12+4),get32(FA,4+(fs+k)*12+8));
    k=k+1;
  }
  return;
}
fn buildg(GA:[]u8,GO:[]u8,G:[]u8,gi:i32)void {
  let gs:i32=get32(GO,4+gi*4);
  let ge:i32=get32(GO,4+(gi+1)*4);
  let q:i32=0;
  while(q<ge-gs){
    set32(G,q*4,get32(GA,(gs+q)*4));
    q=q+1;
  }
  return;
}
fn runeps(WA:[]u8,EA:[]u8,L:[]u8,A:[]u8,K:[]u8,C:[]u8,tout:[]u8,seen:[]u8,w:i32)void {
  let es:i32=get32(WA,4+w*16+8);
  let ne:i32=get32(WA,4+w*16+12);
  let e:i32=0;
  while(e<ne){
    let ei:i32=es+e;
    let b0:i32=4+ei*48;
    let kd:i32=get32(EA,b0);
    if(kd==0){ ret_episode(L,A,get32(EA,b0+4),get32(EA,b0+8),K,tout); }
    if(kd==1){
      chain_clear(C);
      let ns:i32=get32(EA,b0+12);
      let st:i32=0;
      while(st<ns){
        chain_add(C,get32(EA,b0+16+st*12),get32(EA,b0+16+st*12+4),get32(EA,b0+16+st*12+8));
        st=st+1;
      }
      vfy_episode(L,A,C,K);
    }
    if(kd==2){ cnt_episode(L,A,get32(EA,b0+4),get32(EA,b0+8),K,tout,seen); }
    e=e+1;
  }
  specialize_ret(L,A,es,es+ne);
  specialize_vfy(L,A,es,es+ne);
  specialize_cnt(L,A,es,es+ne);
  return;
}
// D1: drop every live plan through the frozen core's own generic plan_drop.
fn dropall(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){ plan_drop(L,gt); }
    pi=pi+1;
  }
  return;
}
// D2: emitted record q is need plan[q]; build per-need (start,len) in CS/CL.
fn reindex(L:[]u8,G:[]u8,ans:[]u8,CS:[]u8,CL:[]u8,nn:i32)void {
  let pi:i32=plan_find(L,g_tag(G));
  let tot:i32=get32(ans,0);
  let endb:i32=4+tot*4;
  let cur:i32=4;
  let q:i32=0;
  while(q<nn){
    let ni:i32=q;
    if(pi>=0){ ni=get32(L,13000+pi*56+8+q*12); }
    let ln:i32=0;
    if(cur<endb){ ln=get32(ans,cur); }
    if(ln>32){ ln=32; }
    set32(CS,ni*4,cur);
    set32(CL,ni*4,ln);
    if(cur<endb){ cur=cur+(1+ln)*4; } else { cur=endb; }
    q=q+1;
  }
  return;
}

fn main()i32 {
  let T:[]u8=z_alloc(524288);
  let WA:[]u8=z_alloc(256);
  let FA:[]u8=z_alloc(8192);
  let EA:[]u8=z_alloc(4096);
  let GA:[]u8=z_alloc(4096);
  let GO:[]u8=z_alloc(128);
  let CA:[]u8=z_alloc(8192);
  let CO:[]u8=z_alloc(512);
  let SA:[]u8=z_alloc(512);
  let LB:[]u8=z_alloc(8320);
  let AB:[]u8=z_alloc(512);
  let L:[]u8=z_alloc(16384);
  let LA:[]u8=z_alloc(16384);
  let LBk:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let ans:[]u8=z_alloc(2048);
  let vbuf:[]u8=z_alloc(192);
  let R:[]u8=z_alloc(192);
  let G:[]u8=z_alloc(512);
  let A:[]u8=world_new();
  let Ch:[]u8=chain_new();
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let OWF:[]u8=z_alloc(640);
  let OWO:[]u8=z_alloc(1280);
  let OWS:[]u8=z_alloc(4160);
  let CS:[]u8=z_alloc(64);
  let CL:[]u8=z_alloc(64);
  let c:i32=0;
  bld(d_worlds(),WA,4);
  bld(d_facts(),FA,3);
  bld(d_eps(),EA,12);
  bld_goals(d_goals(),GA,GO);
  bld_cases(d_cases(),CA,CO);
  bld(d_segs(),SA,6);
  bld_labels(d_labels(),LB,64,8192);
  bld_labels(d_armn(),AB,32,384);
  c=o_app(T,c,"BAR K0_CF2_BEGIN nworlds=");
  c=p_i(T,c,get32(WA,0));
  c=o_app(T,c," nfacts=");
  c=p_i(T,c,get32(FA,0));
  c=o_app(T,c," neps=");
  c=p_i(T,c,get32(EA,0));
  c=o_app(T,c," ngoals=");
  c=p_i(T,c,get32(GO,0));
  c=o_app(T,c," ncases=");
  c=p_i(T,c,get32(CO,0));
  c=o_app(T,c," nsegs=");
  c=p_i(T,c,get32(SA,0));
  c=o_app(T,c," nlabels=");
  c=p_i(T,c,get32(LB,8192));
  c=o_app(T,c," narms=");
  c=p_i(T,c,get32(AB,384));
  c=o_nl(T,c);
  _zag_print(T[0..c]);
  c=0;
  // world table digest: guards against a data transcription error
  let nw:i32=get32(WA,0);
  let dw:i32=0;
  while(dw<nw){
    let d0:i32=get32(WA,4+dw*16);
    let d1:i32=get32(WA,4+dw*16+4);
    c=o_app(T,c,"BAR WORLDDIGEST w=");
    c=p_i(T,c,dw);
    c=o_app(T,c," fs=");
    c=p_i(T,c,d0);
    c=o_app(T,c," nf=");
    c=p_i(T,c,d1);
    c=o_app(T,c," f0=");
    c=p_i(T,c,get32(FA,4+d0*12));
    c=o_app(T,c,",");
    c=p_i(T,c,get32(FA,4+d0*12+4));
    c=o_app(T,c,",");
    c=p_i(T,c,get32(FA,4+d0*12+8));
    c=o_app(T,c," fN=");
    c=p_i(T,c,get32(FA,4+(d0+d1-1)*12));
    c=o_app(T,c,",");
    c=p_i(T,c,get32(FA,4+(d0+d1-1)*12+4));
    c=o_app(T,c,",");
    c=p_i(T,c,get32(FA,4+(d0+d1-1)*12+8));
    c=o_nl(T,c);
    _zag_print(T[0..c]);
    c=0;
    dw=dw+1;
  }

  // ---- ORACLE SELF-TEST (K-B4) ----
  let gi:i32=0;
  while(gi<20){
    buildg(GA,GO,G,gi);
    let sc:i32=oq_scope(G);
    c=o_app(T,c,"BAR SELFTEST g=");
    c=p_i(T,c,gi);
    c=o_app(T,c," scope=");
    c=p_i(T,c,sc);
    c=o_app(T,c," nneeds=");
    c=p_i(T,c,oq_nn(G));
    c=o_app(T,c," nlinks=");
    c=p_i(T,c,oq_nl(G));
    c=o_app(T,c," fam0=");
    c=p_i(T,c,oq_fam(oq_nf(G,0),oq_f(G,0,0),oq_f(G,0,1)));
    c=o_nl(T,c);
    _zag_print(T[0..c]);
    c=0;
    gi=gi+1;
  }
  buildg(GA,GO,G,0);
  buildw(WA,FA,A,0);
  let q0:i32=orc_run(G,FA,get32(WA,4),get32(WA,8),OWF,OWO,OWS);
  let okA:i32=0;
  if(get32(OWO,0)==3){
    let u1:i32=0;
    if(get32(OWO,4)==101){ u1=1; }
    if(get32(OWO,8)==102){ u1=u1+1; }
    if(get32(OWO,12)==103){ u1=u1+1; }
    if(u1==3){ okA=1; }
  }
  buildg(GA,GO,G,4);
  let q4:i32=orc_run(G,FA,get32(WA,4),get32(WA,8),OWF,OWO,OWS);
  let okB:i32=0;
  if(q4==3){
    if(get32(OWO,2*160)==1){
      if(get32(OWO,2*160+4)==2){ okB=1; }
    }
  }
  buildg(GA,GO,G,12);
  buildw(WA,FA,A,2);
  let q12:i32=orc_run(G,FA,get32(WA,4+2*16),get32(WA,4+2*16+4),OWF,OWO,OWS);
  let okC:i32=0;
  if(get32(OWO,1*160)==2){
    if(get32(OWO,1*160+4)==2){ okC=1; }
    if(get32(OWO,1*160+8)==3){ okC=1; }
  }
  buildg(GA,GO,G,6);
  let q6:i32=orc_run(G,FA,get32(WA,4),get32(WA,8),OWF,OWO,OWS);
  let okD:i32=0;
  if(get32(OWO,160)==1){
    if(get32(OWO,164)==102){ okD=1; }
  }
  c=o_app(T,c,"BAR SELFTEST_VERDICT ret_alpha=");
  c=p_i(T,c,okA);
  c=o_app(T,c," multisrc_count_alpha=");
  c=p_i(T,c,okB);
  c=o_app(T,c," gamma_typed_reduct=");
  c=p_i(T,c,okC);
  c=o_app(T,c," kind1_dataflow=");
  c=p_i(T,c,okD);
  c=o_app(T,c," nn0=");
  c=p_i(T,c,q0);
  c=o_app(T,c," nn4=");
  c=p_i(T,c,q4);
  c=o_app(T,c," nn12=");
  c=p_i(T,c,q12);
  c=o_app(T,c," nn6=");
  c=p_i(T,c,q6);
  if(okA+okB+okC+okD==4){ c=o_app(T,c," ORACLE_SELFTEST=PASS"); }
  if(okA+okB+okC+okD!=4){ c=o_app(T,c," ORACLE_SELFTEST=FAIL ** NO CORE RESULT IS CITABLE **"); }
  c=o_nl(T,c);
  _zag_print(T[0..c]);
  c=0;

  // ---- ARM LOOP ----
  let nseg:i32=get32(SA,0);
  let s:i32=0;
  while(s<nseg){
    let so:i32=4+s*24;
    let ep_on:i32=get32(SA,so);
    let arm:i32=get32(SA,so+4);
    let cs:i32=get32(SA,so+8);
    let cl:i32=get32(SA,so+12);
    let lm:i32=get32(SA,so+16);
    zzero(L,16384);
    if(lm==1){
      let k:i32=0;
      while(k<4096){ set32(L,k*4,get32(LA,k*4)); k=k+1; }
    }
    if(lm==2){
      let k:i32=0;
      while(k<4096){ set32(L,k*4,get32(LBk,k*4)); k=k+1; }
    }
    let ac:i32=0;
    let ascored:i32=0;
    let aok:i32=0;
    let acost:i32=0;
    let afail:i32=0;
    let lnzpre:i32=-1;
    let lnzpost:i32=-1;
    let j:i32=0;
    while(j<cl){
      let ci:i32=cs+j;
      let b0:i32=get32(CO,4+ci*4)*4;
      let w:i32=get32(CA,b0);
      let md:i32=get32(CA,b0+4);
      let gi2:i32=get32(CA,b0+8);
      let lab:i32=get32(CA,b0+12);
      let les:i32=get32(CA,b0+16);
      let mdq:i32=get32(CA,b0+20);
      let xh:i32=get32(CA,b0+24);
      let msk:i32=get32(CA,b0+28);
      let on:i32=0;
      if(msk>=0){ if((msk/armbit(arm))%2==1){ on=1; } }
      if(on==1){
        buildw(WA,FA,A,w);
        if(gi2>=0){ buildg(GA,GO,G,gi2); }
        if(md==0){
          c=o_app(T,c,"EP arm=");
          c=p_arm(T,c,AB,arm);
          c=o_app(T,c," i=");
          c=p_i(T,c,ci);
          c=o_app(T,c," w=");
          c=p_i(T,c,w);
          c=o_app(T,c," epon=");
          c=p_i(T,c,ep_on);
          c=o_app(T,c," es=");
          c=p_i(T,c,get32(WA,4+w*16+8));
          c=o_app(T,c," ne=");
          c=p_i(T,c,get32(WA,4+w*16+12));
          c=o_app(T,c," ran=");
          c=p_i(T,c,ep_on);
          c=o_app(T,c," retcov=");
          c=p_i(T,c,get32(L,0));
          c=o_app(T,c," specR=");
          c=p_i(T,c,get32(L,4244));
          c=o_nl(T,c);
          _zag_print(T[0..c]);
          c=0;
          if(ep_on==1){
            let k0:i32=get32(K,12);
            runeps(WA,EA,L,A,K,Ch,tout,seen,w);
            acost=acost+(get32(K,12)-k0);
            if(arm==0){
              if(s==0){
                if(ci==0){
                  let k:i32=0;
                  while(k<4096){ set32(LA,k*4,get32(L,k*4)); k=k+1; }
                }
              }
            }
          }
        }
        if(md==4){ dropall(L); }
        if(md==1){
          let onn:i32=0;
          let sc:i32=oq_scope(G);
          if(sc==1){ onn=orc_run(G,FA,get32(WA,4+w*16),get32(WA,4+w*16+4),OWF,OWO,OWS); }
          if(les==1){ set32(L,0,0); }
          if(les==2){ set32(L,14500,0); }
          if(lnzpre<0){ lnzpre=lnonz(L); }
          let k1:i32=get32(K,0);
          set32(ans,0,0);
          let rc:i32=compose_iter(L,A,G,K,ans,vbuf);
          acost=acost+(get32(K,0)-k1);
          if(lnzpost<0){ lnzpost=lnonz(L); }
          let nn:i32=g_nneeds(G);
          reindex(L,G,ans,CS,CL,nn);
          let sok:i32=0;
          if(onn<0){
            if(mdq==1){ if(rc==0){ sok=1; } }
          }
          if(onn>0){
            if(rc!=0){ sok=1; }
            let q:i32=0;
            while(q<onn){
              let o2:i32=0;
              if(q<nn){
                if(eq_set(ans,get32(CS,q*4),get32(CL,q*4),OWO,q*160,get32(OWO,q*160))==1){ o2=1; }
              }
              if(o2==0){ sok=0; }
              q=q+1;
            }
          }
          if(sc==1){ ascored=ascored+1; }
          if(sok==1){ aok=aok+1; } else { afail=afail+1; }
          c=o_app(T,c,"CASE arm=");
          c=p_arm(T,c,AB,arm);
          c=o_app(T,c," i=");
          c=p_i(T,c,ci);
          c=o_app(T,c," lab=");
          c=p_lab(T,c,LB,lab);
          c=o_app(T,c," w=");
          c=p_i(T,c,w);
          c=o_app(T,c," rc=");
          c=p_i(T,c,rc);
          c=o_app(T,c," COR=");
          c=p_i(T,c,sok);
          c=o_app(T,c," scope=");
          c=p_i(T,c,sc);
          c=o_app(T,c," ans=");
          c=p_core(T,c,ans,CS,CL,nn);
          c=o_app(T,c," orc=");
          if(onn<0){ c=o_app(T,c,"DECLINE"); } else { c=p_orc(T,c,OWO,onn); }
          c=o_app(T,c," ver=");
          c=p_vv(T,c,vbuf,nn);
          c=o_app(T,c," np=");
          c=p_i(T,c,get32(vbuf,20));
          c=o_app(T,c," porder=");
          let pq:i32=plan_find(L,g_tag(G));
          let q2:i32=0;
          while(q2<nn){
            if(q2>0){ c=o_app(T,c,","); }
            if(pq>=0){ c=p_i(T,c,get32(L,13000+pq*56+8+q2*12)); }
            q2=q2+1;
          }
          c=o_nl(T,c);
          _zag_print(T[0..c]);
          c=0;
        }
        if(md==2){
          if(les==2){ set32(L,14500,0); }
          let k2:i32=get32(K,0);
          let how:i32=osc_handle(L,A,G,K,R);
          acost=acost+(get32(K,0)-k2);
          c=o_app(T,c,"CASE arm=");
          c=p_arm(T,c,AB,arm);
          c=o_app(T,c," i=");
          c=p_i(T,c,ci);
          c=o_app(T,c," lab=");
          c=p_lab(T,c,LB,lab);
          c=o_app(T,c," OSC how=");
          c=p_i(T,c,how);
          c=o_app(T,c," passes=");
          c=p_i(T,c,get32(R,4));
          c=o_app(T,c," lag=");
          c=p_i(T,c,get32(R,8));
          c=o_app(T,c," xhow=");
          c=p_i(T,c,xh);
          c=o_app(T,c," scope=0");
          c=o_nl(T,c);
          _zag_print(T[0..c]);
          c=0;
        }
        ac=ac+1;
      }
      j=j+1;
    }
    if(s==0){
      if(arm==0){
        let k:i32=0;
        while(k<4096){ set32(LBk,k*4,get32(L,k*4)); k=k+1; }
      }
    }
    c=o_app(T,c,"ARMSEG arm=");
    c=p_arm(T,c,AB,arm);
    c=o_app(T,c," cases=");
    c=p_i(T,c,ac);
    c=o_app(T,c," scored=");
    c=p_i(T,c,ascored);
    c=o_app(T,c," CORRECT=");
    c=p_i(T,c,aok);
    c=o_app(T,c,"/");

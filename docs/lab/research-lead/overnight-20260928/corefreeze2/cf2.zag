// ---- goals: count, then (len, len ints) per goal ----
// ints: gtag nneeds (needtag nf fields..)* nlinks (7 ints)*link
// need shapes: 901 = RET [rel,obj]; 902 = VERIFY [ns,(s,r,o)*ns];
//              903 = COUNT [rel,1,subj]; 904 = unbindable (decline probe)
// link: [kind,dst_need,dst_kind,dst_slot,src_need,src_kind,src_slot]
// Every goal below has src_need < dst_need on every link, so NEED order is a
// valid topological order and the oracle evaluates it in one pass. The core's
// plan order is chosen independently and often differs (goal 4 is the test).
fn d_goals()[]u8 {
  let T:[]u8=z_alloc(8192);
  let c:i32=0;
  c=appn(T,c,"20");
  // 0 CF1a RET
  c=appn(T,c," 7 7001 1 901 2 11 111 0");
  // 1 CF1b fan-in VERIFY conjunction
  c=appn(T,c," 23 7002 2 901 2 11 111 902 7 2 0 12 121 121 19 191 1 2 1 0 0 0 0 0");
  // 2 CF1c COUNT over a subject set
  c=appn(T,c," 19 7003 2 901 2 11 111 903 3 11 1 0 1 3 1 0 0 0 0 0");
  // 3 CF1d uncovered relation, generic fallback
  c=appn(T,c," 7 7005 1 901 2 17 181 0");
  // 4 CF1e multi-source fan-in into one COUNT (plan order != need order)
  c=appn(T,c," 30 7006 3 901 2 11 111 901 2 11 118 903 3 11 1 0 2 3 2 0 0 0 0 0 3 2 0 0 1 0 0");
  // 5 oscillation: self-link on need 1, therefore OUT OF ORACLE SCOPE
  c=appn(T,c," 31 7007 3 901 2 11 111 901 2 14 200 902 4 1 0 15 200 2 1 1 0 1 1 1 0 2 2 0 0 1 0 0");
  // 6 CF1f kind-1 scalar dataflow
  c=appn(T,c," 18 7008 2 901 2 11 111 901 2 0 200 1 1 1 0 0 0 1 0");
  // 7 CF1g decline probe: need tag 904 matches no family
  c=appn(T,c," 10 7040 1 904 5 5 1 1 1 1 0");
  // 8 CF2 BETA (MAX 4 NEEDS: compose_iter sizes W/OUTS/dirty for 4)
  c=appn(T,c," 54 7100 4 901 2 9001 9101 902 7 2 0 9002 9201 9201 9003 9301 903 3 9001 1 0 903 3 9003 1 0 4 2 1 0 0 0 0 0 3 2 0 0 0 0 0 3 3 0 0 0 0 0 3 3 0 0 1 0 0");
  // 9 CF2 GAMMA
  c=appn(T,c," 47 7200 4 901 2 5003 1 902 7 2 0 5004 0 0 5005 1 903 3 5002 1 0 903 3 6002 1 0 3 2 1 0 0 0 0 0 3 2 0 0 0 0 0 3 3 0 0 1 0 0");
  // 10 CF2 DELTA
  c=appn(T,c," 54 7300 4 901 2 7001 1 902 7 2 0 7002 2 0 7003 4 903 3 7002 1 0 903 3 7003 1 0 4 2 1 0 0 0 0 0 3 2 0 0 0 0 0 3 3 0 0 0 0 0 3 3 0 0 1 0 0");
  // 11 CF2 EPSILON
  c=appn(T,c," 47 7400 4 901 2 31 3001 902 7 2 0 32 3003 0 33 3003 903 3 31 1 0 903 3 32 1 0 3 2 1 0 0 0 0 0 3 2 0 0 0 0 0 3 3 0 0 1 0 0");
  // 12 CF3 F1 formal: maximal reduct set filtered by type AND grade
  c=appn(T,c," 35 7201 3 901 2 5003 1 902 7 2 0 5004 0 0 5005 1 903 3 5002 1 0 2 2 1 0 0 0 0 0 3 2 0 0 0 0 0");
  // 13 CF3 F2 causal: blast radius = union of one-hop consequences
  c=appn(T,c," 32 7202 3 901 2 6001 7101 903 3 6002 1 0 902 4 1 0 6002 7201 2 3 1 0 0 0 0 0 2 2 0 0 0 0 0");
  // 14 DEV stage 2
  c=appn(T,c," 32 7301 3 901 2 51 7002 902 4 1 0 52 7002 903 3 52 1 0 2 2 1 0 0 0 0 0 3 2 0 0 1 0 0");
  // 15..17 curriculum tasks A B C
  c=appn(T,c," 20 7500 2 901 2 8001 1 902 4 1 0 8002 2 1 2 1 0 0 0 0 0");
  c=appn(T,c," 20 7501 2 901 2 8101 1 902 4 1 0 8102 2 1 2 1 0 0 0 0 0");
  c=appn(T,c," 20 7502 2 901 2 8201 1 902 4 1 0 8202 2 1 2 1 0 0 0 0 0");
  // 18 one-shot query
  c=appn(T,c," 7 7600 1 901 2 41 5001 0");
  // 19 one-shot control on an uncovered relation
  c=appn(T,c," 7 7601 1 901 2 42 5002 0");
  return T;
}

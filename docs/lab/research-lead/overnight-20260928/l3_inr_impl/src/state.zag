// state.zag -- L3-INR learner persistent state. Pure Zag.
// Fixed-layout raw-byte state files (deterministic). The named-slot
// store persists committed edge sets across invocations and arms; it is
// learner-created persistent state (prereg section 4e/4f), not machinery.
// ST work.dat (256 bytes):
// [0..4) phase [4..8) ntest [8..12) nprobe [12..16) seq
// [16..20) seed [20..24) gid_ctr [24..28) committed_gid
// [28..32) parent_gid [32..36) esid_ctr [36..40) budget
// [40..44) probe_budget [44..48) ntrain [48..52) nheld
// [52..56) cand_u [56..60) cand_v [60..64) add_ne
// [64..68) del_idx [68..72) base_score [72..76) n_forbid
// [76..80) arm_code [80..84) held_kind [84..88) monitor_n
// [88..92) aux [92..96) aux2
// [96..128) arm str [128..160) mode str
// KB kb.dat (2048 bytes):
// [0..4) n [4..8) ntrain [8..12) nattr [12..16) nforbid
// names 10x32 at [32..352)
// train count [352..356) pairs 32x3 at [356..452)
// attrs 10x3 bytes at [452..482)
// tried 90x2 at [696..876) held 32x2 at [876..940) rank 10 at [940..950)
// forbid 90x2 bytes at [512..692)
// EDGES edges.dat (512 bytes): [0..4) ne, edges ne*2 at [4..)
// SLOT slot_G.dat (512 bytes): [0..4) gid [4..8) parent_gid [8..12) ne,
//   edges at [12..)
// HYPS hyps.dat: [0..4) nh, then h slots of 100 bytes reachability.
fn st_path(sd:[]u8,name:[]u8,out:[]u8)i32 {
  let c:i32=e1str(out,0,sd);
  c=e1str(out,c,"/");
  c=e1str(out,c,name);
  return c;
}
fn st_new()[]u8 {
  let s:[]u8=z_alloc(256);
  put32(s,20,1);
  put32(s,32,1);
  put32(s,36,3000);
  put32(s,40,150);
  return s;
}
fn st_save(sd:[]u8,s:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"work.dat",p);
  write_file(p[0..c],s);
  return;
}
fn st_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"work.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<256){ return ""; }
  return b[0..256];
}
fn st_getstr(s:[]u8,off:i32,out:[]u8)i32 {
  let i:i32=0;
  while(i<32 && s[off+i]!=0){ out[i]=s[off+i]; i=i+1; }
  return i;
}
fn st_setstr(s:[]u8,off:i32,v:[]u8)void {
  let i:i32=0;
  while(i<32){ s[off+i]=0; i=i+1; }
  let k:i32=0;
  while(k<v.len && k<31){ s[off+k]=v[k]; k=k+1; }
  return;
}
// trace: append "SEQ <seq> <line>\n" to trace.log; seq monotonic.
fn trace_add(sd:[]u8,s:[]u8,line:[]u8)void {
  let seq:i32=ig(s,12);
  let OUT:[]u8=z_alloc(line.len+32);
  let c:i32=0;
  c=e1str(OUT,c,"SEQ ");
  c=e1i32(OUT,c,seq);
  c=e1str(OUT,c," ");
  c=e1str(OUT,c,line);
  c=e1str(OUT,c,"\n");
  let p:[]u8=z_alloc(256);
  let pc:i32=st_path(sd,"trace.log",p);
  append_file(p[0..pc],OUT[0..c]);
  put32(s,12,seq+1);
  return;
}
// outbox: append a line to outbox.txt (message to WORLD).
fn ob_add(sd:[]u8,line:[]u8)void {
  let OUT:[]u8=z_alloc(line.len+2);
  let c:i32=e1str(OUT,0,line);
  c=e1str(OUT,c,"\n");
  let p:[]u8=z_alloc(256);
  let pc:i32=st_path(sd,"outbox.txt",p);
  append_file(p[0..pc],OUT[0..c]);
  return;
}
// ---- KB ----
fn kb_new()[]u8 { return z_alloc(2048); }
fn kb_save(sd:[]u8,k:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"kb.dat",p);
  write_file(p[0..c],k);
  return;
}
fn kb_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"kb.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<2048){ return ""; }
  return b[0..2048];
}
// name -> id; adds if absent (n<10). Returns id or -1.
fn kb_name_id(k:[]u8,name:[]u8,nl:i32)i32 {
  let n:i32=ig(k,0);
  let i:i32=0;
  while(i<n){
    let base:i32=32+i*32;
    let ln:i32=0;
    while(ln<32 && k[base+ln]!=0){ ln=ln+1; }
    if(ln==nl){
      let j:i32=0;
      let ok:i32=1;
      while(j<ln){ if(k[base+j]!=name[j]){ ok=0; } j=j+1; }
      if(ok==1){ return i; }
    }
    i=i+1;
  }
  if(n>=10){ return -1; }
  let nb:i32=32+n*32;
  let q:i32=0;
  while(q<nl && q<31){ k[nb+q]=name[q]; q=q+1; }
  k[nb+q]=0;
  put32(k,0,n+1);
  return n;
}
fn kb_name_len(k:[]u8,idx:i32)i32 {
  let base:i32=32+idx*32;
  let ln:i32=0;
  while(ln<32 && k[base+ln]!=0){ ln=ln+1; }
  return ln;
}
// emit name idx into OUT at cur; returns new cur.
fn kb_emit_name(k:[]u8,OUT:[]u8,cur:i32,idx:i32)i32 {
  let base:i32=32+idx*32;
  let j:i32=0;
  while(j<32 && k[base+j]!=0){ OUT[cur+j]=k[base+j]; j=j+1; }
  return cur+j;
}
// ---- working edge set (edges.dat) ----
fn ed_new()[]u8 { return z_alloc(512); }
fn ed_save(sd:[]u8,e:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"edges.dat",p);
  write_file(p[0..c],e);
  return;
}
fn ed_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"edges.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<512){ return ""; }
  return b[0..512];
}
fn ed_ne(e:[]u8)i32 { return ig(e,0); }
fn ed_add(e:[]u8,a:i32,b:i32)void {
  let ne:i32=ig(e,0);
  // ADD-EDGE: persistent-state edit (prereg 4c). No duplicates.
  let i:i32=0;
  let dup:i32=0;
  while(i<ne){
    if((e[4+i*2] as i32)==a && (e[4+i*2+1] as i32)==b){ dup=1; }
    i=i+1;
  }
  if(dup==0){
    e[4+ne*2]=a as u8; e[4+ne*2+1]=b as u8;
    put32(e,0,ne+1);
  }
  return;
}
fn ed_del(e:[]u8,idx:i32)void {
  // DEL-EDGE: persistent-state edit (prereg 4c). Removes edge idx.
  let ne:i32=ig(e,0);
  let i:i32=idx;
  while(i<ne-1){
    e[4+i*2]=e[4+(i+1)*2]; e[4+i*2+1]=e[4+(i+1)*2+1];
    i=i+1;
  }
  put32(e,0,ne-1);
  return;
}
fn ed_has(e:[]u8,a:i32,b:i32)i32 {
  let ne:i32=ig(e,0);
  let i:i32=0;
  while(i<ne){
    if((e[4+i*2] as i32)==a && (e[4+i*2+1] as i32)==b){ return 1; }
    i=i+1;
  }
  return 0;
}
// ---- named slot store (slot_G.dat): gid, parent_gid, ne, edges ----
fn slot_save(sd:[]u8,name:[]u8,gid:i32,parent:i32,e:[]u8)void {
  let b:[]u8=z_alloc(512);
  put32(b,0,gid);
  put32(b,4,parent);
  let ne:i32=ig(e,0);
  put32(b,8,ne);
  let i:i32=0;
  while(i<ne*2){ b[12+i]=e[4+i]; i=i+1; }
  let p:[]u8=z_alloc(256);
  let fn2:[]u8=z_alloc(64);
  let c:i32=e1str(fn2,0,"slot_");
  c=e1str(fn2,c,name);
  c=e1str(fn2,c,".dat");
  let pc:i32=st_path(sd,fn2[0..c],p);
  write_file(p[0..pc],b);
  return;
}
fn slot_load(sd:[]u8,name:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let fn2:[]u8=z_alloc(64);
  let c:i32=e1str(fn2,0,"slot_");
  c=e1str(fn2,c,name);
  c=e1str(fn2,c,".dat");
  let pc:i32=st_path(sd,fn2[0..c],p);
  let b:[]u8=read_file(p[0..pc]);
  if(b.len<512){ return ""; }
  return b[0..512];
}
// ---- hypothesis store (hyps.dat): [0..4) nh, 8 x 100B reach matrices
fn hyps_new()[]u8 { return z_alloc(804); }
fn hyps_save(sd:[]u8,h:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"hyps.dat",p);
  write_file(p[0..c],h);
  return;
}
fn hyps_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"hyps.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<804){ return ""; }
  return b[0..804];
}
// add reachability matrix r (100B) if not already present; returns index or -1 if full.
fn hyps_add(h:[]u8,r:[]u8,n:i32)i32 {
  let nh:i32=ig(h,0);
  let i:i32=0;
  while(i<nh){
    let base:i32=4+i*100;
    if(reach_eq(h[base..base+100],r,n)==1){ return i; }
    i=i+1;
  }
  if(nh>=8){ return -1; }
  let nb:i32=4+nh*100;
  let j:i32=0;
  while(j<100){ h[nb+j]=r[j]; j=j+1; }
  put32(h,0,nh+1);
  return nh;
}
// read variant h reachability byte at (a,b); variants stored as 100B blocks
fn hyps_get(sd:[]u8,h:i32,a:i32,b:i32)i32 {
  let p:[]u8=z_alloc(256);
  let n:i32=st_path(sd,"hyps.dat",p);
  let f:[]u8=read_file(p[0..n]);
  if(f.len<4+h*100+100){ return -1; }
  return f[4+h*100+a*10+b] as i32;
}
// number of variants currently stored
fn hyps_count(sd:[]u8)i32 {
  let p:[]u8=z_alloc(256);
  let n:i32=st_path(sd,"hyps.dat",p);
  let f:[]u8=read_file(p[0..n]);
  if(f.len<4){ return 0; }
  return ig(f,0);
}

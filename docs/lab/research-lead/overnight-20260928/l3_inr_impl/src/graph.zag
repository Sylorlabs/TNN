// graph.zag -- L3-INR generic graph machinery. Pure Zag.
// This is the FROZEN GENERIC BASIS (prereg section 4a): LINK edge
// storage, neighbor lookup, iterated expansion (transitive closure).
// It operates over any 10-node directed graph; it contains no dominance,
// order, ranking, or sealed-world literals. The invented representation
// is the edge SET held in the learner's slot; this file is machinery.
// u8-backed n*n matrices; n <= 10.
fn g_zero(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return;
}
// iterated expansion: transitive closure of r (n x n bytes), in place.
fn reach_close(r:[]u8,n:i32)void {
  let k:i32=0;
  while(k<n){
    let i:i32=0;
    while(i<n){
      if(r[i*n+k]==1){
        let j:i32=0;
        while(j<n){
          if(r[k*n+j]==1){ r[i*n+j]=1; }
          j=j+1;
        }
      }
      i=i+1;
    }
    k=k+1;
  }
  return;
}
// reachability relation of edge list ea/eb (bytes), ne edges.
fn reach_of_edges(r:[]u8,n:i32,ea:[]u8,eb:[]u8,ne:i32)void {
  g_zero(r,n*n);
  let e:i32=0;
  while(e<ne){
    let a:i32=ea[e] as i32;
    let bb:i32=eb[e] as i32;
    if(a>=0 && a<n && bb>=0 && bb<n){ r[a*n+bb]=1; }
    e=e+1;
  }
  reach_close(r,n);
  return;
}
fn reach_eq(a:[]u8,b:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n*n){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}
// neighbor lookup: out-neighbors of v into out (bytes); returns count.
fn neighbors(adj:[]u8,n:i32,v:i32,out:[]u8)i32 {
  let c:i32=0;
  let j:i32=0;
  while(j<n){
    if(adj[v*n+j]==1){ out[c]=j as u8; c=c+1; }
    j=j+1;
  }
  return c;
}
// constraint DAG from training pairs: y=1 => a precedes b; y=0 => b
// precedes a. Closes transitively. Returns 1 if acyclic, 0 on cycle.
// (The y=0 reversal is generic total-order consequence bookkeeping over
// the learner's own OBSERVE instances, not a sealed-world literal.)
fn constraints_close(r:[]u8,n:i32,ta:[]u8,tb:[]u8,ty:[]u8,m:i32)i32 {
  g_zero(r,n*n);
  let k:i32=0;
  while(k<m){
    let a:i32=ta[k] as i32;
    let bb:i32=tb[k] as i32;
    if(ty[k]==1){ r[a*n+bb]=1; }
    if(ty[k]==0){ r[bb*n+a]=1; }
    k=k+1;
  }
  reach_close(r,n);
  let d:i32=0;
  while(d<n){
    if(r[d*n+d]==1){ return 0; }
    d=d+1;
  }
  return 1;
}
// out-degree profile of reachability r: outd[i] = #{j: r[i*n+j]==1}.
fn out_profile(r:[]u8,n:i32,outd:[]u8)void {
  let i:i32=0;
  while(i<n){
    let c:i32=0;
    let j:i32=0;
    while(j<n){
      if(r[i*n+j]==1){ c=c+1; }
      j=j+1;
    }
    outd[i]=c as u8;
    i=i+1;
  }
  return;
}
// rank_by_reach: order ids by out-degree descending (ties: smaller id).
// Generic ranking procedure over a slot's edge set; references the slot
// only, no entity or order literals. Result in perm (bytes).
fn rank_by_reach(r:[]u8,n:i32,perm:[]u8)void {
  let od:[]u8=z_alloc(10);
  out_profile(r,n,od);
  let used:[]u8=z_alloc(10);
  let p:i32=0;
  while(p<n){
    let best:i32=-1;
    let i:i32=0;
    while(i<n){
      if(used[i]==0){
        if(best==-1){ best=i; }
        if(best!=-1){
          let ob:i32=od[best] as i32;
          let oi:i32=od[i] as i32;
          if(oi>ob){ best=i; }
        }
      }
      i=i+1;
    }
    perm[p]=best as u8;
    used[best]=1;
    p=p+1;
  }
  return;
}
// count edges (u,v) with r[u*n+v]==1.
fn edge_count_r(r:[]u8,n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n*n){ if(r[i]==1){ c=c+1; } i=i+1; }
  return c;
}

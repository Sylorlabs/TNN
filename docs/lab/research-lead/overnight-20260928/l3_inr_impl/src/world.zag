// world.zag -- L3-INR WORLD process. Pure Zag.
// Stateless per invocation: reads the .world file (hidden order, keys),
// reads protocol queries from stdin, writes responses to stdout.
// The LEARNER never opens the .world file: the driver passes the path
// only to this binary (information firewall, prereg section 3 / A-INFO).
// Entity table: 10 x 32B names; table index == position in hidden order.
// Responses: ACCEPT / REJECT / FORBIDDEN (probe-domain enforcement;
// harness-level, carries no expected value), RANK_ACCEPT / RANK_REJECT,
// COMMIT_OK, DEFER_OK, INSTANCES/PAIRS blocks.
// emit entity name idx from world table en into OUT.
fn w_emit_name(en:[]u8,OUT:[]u8,cur:i32,idx:i32)i32 {
  let base:i32=idx*32;
  let j:i32=0;
  while(j<32 && en[base+j]!=0){ OUT[cur+j]=en[base+j]; j=j+1; }
  return cur+j;
}
fn w_find(en:[]u8,name:[]u8,nl:i32)i32 {
  let i:i32=0;
  while(i<10){
    let base:i32=i*32;
    let ln:i32=0;
    while(ln<32 && en[base+ln]!=0){ ln=ln+1; }
    if(ln==nl){
      let j:i32=0;
      let ok:i32=1;
      while(j<ln){ if(en[base+j]!=name[j]){ ok=0; } j=j+1; }
      if(ok==1){ return i; }
    }
    i=i+1;
  }
  return -1;
}
fn main()i32 {
  let path:[]u8=_zag_arg(1);
  if(path.len==0){ return 2; }
  let wf:[]u8=read_file(path);
  if(wf.len==0){ return 3; }
  let wlen:i32=wf.len;
  let en:[]u8=z_alloc(320);
  let nn:i32=0;
  let tr:[]u8=z_alloc(96);
  let ntr:i32=0;
  let ha:[]u8=z_alloc(32);
  let hb:[]u8=z_alloc(32);
  let hc:[]u8=z_alloc(32);
  let nha:i32=0; let nhb:i32=0; let nhc:i32=0;
  let at:[]u8=z_alloc(30);
  let nat:i32=0;
  let px:[]u8=z_alloc(180);
  let npx:i32=0;
  let ls:[]u8=z_alloc(4096);
  let nl:i32=split_lines(wf,wlen,ls,1024);
  let li:i32=0;
  let mode:i32=0;
  let want:i32=0;
  let tok:[]u8=z_alloc(64);
  let tok2:[]u8=z_alloc(64);
  let tok3:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl){
    let lat:i32=ig(ls,li*4);
    let len2:i32=line_end(wf,lat,wlen);
    let ll:i32=len2-lat;
    let t0l:i32=gettok(wf[lat..len2],ll,0,tok);
    let t0:[]u8=tok[0..t0l];
    let inblock:i32=0;
    if(mode>=1 && want>0){ inblock=1; }
    if(inblock==1){
      if(seq8(t0,"PAIR")==1){
        let al:i32=gettok(wf[lat..len2],ll,1,tok);
        let bl:i32=gettok(wf[lat..len2],ll,2,tok2);
        let a:i32=w_find(en,tok[0..al],al);
        let b:i32=w_find(en,tok2[0..bl],bl);
        if(mode==1){
          let yl:i32=gettok(wf[lat..len2],ll,3,tok3);
          p_int(tok3,0,yl,ov);
          tr[ntr*3]=a as u8; tr[ntr*3+1]=b as u8; tr[ntr*3+2]=ig(ov,0) as u8;
          ntr=ntr+1;
        }
        if(mode==2){ ha[nha*2]=a as u8; ha[nha*2+1]=b as u8; nha=nha+1; }
        if(mode==4){ hb[nhb*2]=a as u8; hb[nhb*2+1]=b as u8; nhb=nhb+1; }
        if(mode==6){ hc[nhc*2]=a as u8; hc[nhc*2+1]=b as u8; nhc=nhc+1; }
        want=want-1;
      } else {
        if(seq8(t0,"ATTR")==1){
          let al2:i32=gettok(wf[lat..len2],ll,1,tok);
          let a2:i32=w_find(en,tok[0..al2],al2);
          let v0l:i32=gettok(wf[lat..len2],ll,2,tok2);
          p_int(tok2,0,v0l,ov);
          let v0:i32=ig(ov,0);
          let v1l:i32=gettok(wf[lat..len2],ll,3,tok3);
          p_int(tok3,0,v1l,ov);
          let v1:i32=ig(ov,0);
          let v2l:i32=gettok(wf[lat..len2],ll,4,tok2);
          p_int(tok2,0,v2l,ov);
          let v2:i32=ig(ov,0);
          at[a2*3]=v0 as u8; at[a2*3+1]=v1 as u8; at[a2*3+2]=v2 as u8;
          nat=nat+1;
          want=want-1;
        } else {
          if(seq8(t0,"XPAIR")==1){
            let al3:i32=gettok(wf[lat..len2],ll,1,tok);
            let bl3:i32=gettok(wf[lat..len2],ll,2,tok2);
            let a3:i32=w_find(en,tok[0..al3],al3);
            let b3:i32=w_find(en,tok2[0..bl3],bl3);
            px[npx*2]=a3 as u8; px[npx*2+1]=b3 as u8;
            npx=npx+1;
            want=want-1;
          }
        }
      }
      if(want==0){ mode=0; }
    } else {
      if(seq8(t0,"ORDER")==1){
        let cl:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,cl,ov);
        let cnt:i32=ig(ov,0);
        let q:i32=0;
        while(q<cnt){
          let ql:i32=gettok(wf[lat..len2],ll,2+q,tok);
          let base:i32=q*32;
          let z:i32=0;
          while(z<ql){ en[base+z]=tok[z]; z=z+1; }
          en[base+z]=0;
          q=q+1;
        }
        nn=cnt;
      }
      if(seq8(t0,"TRAIN")==1){
        let ml:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml,ov);
        want=ig(ov,0); mode=1;
      }
      if(seq8(t0,"HELDOUT_A")==1){
        let ml2:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml2,ov);
        want=ig(ov,0); mode=2;
      }
      if(seq8(t0,"HELDOUT_B")==1){
        let ml3:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml3,ov);
        want=ig(ov,0); mode=4;
      }
      if(seq8(t0,"HELDOUT_C")==1){
        let ml4:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml4,ov);
        want=ig(ov,0); mode=6;
      }
      if(seq8(t0,"NATTR")==1){
        let ml5:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml5,ov);
        want=ig(ov,0); mode=8;
      }
      if(seq8(t0,"PROBE_EXCEPT")==1){
        let ml6:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml6,ov);
        want=ig(ov,0); mode=9;
      }
    }
    li=li+1;
  }
  // ---- answer queries ----
  let input:[]u8=read_all_fd(0,1048576);
  let ilen:i32=input.len;
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  let qls:[]u8=z_alloc(4096);
  let qn:i32=split_lines(input,ilen,qls,1024);
  let qi:i32=0;
  while(qi<qn){
    let qat:i32=ig(qls,qi*4);
    let qen:i32=line_end(input,qat,ilen);
    let qll:i32=qen-qat;
    let q0l:i32=gettok(input[qat..qen],qll,0,tok);
    let q0:[]u8=tok[0..q0l];
    if(seq8(q0,"OBSERVE")==1){
      cur=e1str(OUT,cur,"INSTANCES ");
      cur=e1i32(OUT,cur,ntr);
      cur=e1str(OUT,cur,"\n");
      let i:i32=0;
      while(i<ntr){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,tr[i*3] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,tr[i*3+1] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,tr[i*3+2] as i32);
        cur=e1str(OUT,cur,"\n");
        i=i+1;
      }
      cur=e1str(OUT,cur,"NATTRS ");
      cur=e1i32(OUT,cur,nat);
      cur=e1str(OUT,cur,"\n");
      let j:i32=0;
      while(j<nn){
        cur=e1str(OUT,cur,"ATTR ");
        cur=w_emit_name(en,OUT,cur,j);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3+1] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3+2] as i32);
        cur=e1str(OUT,cur,"\n");
        j=j+1;
      }
      cur=e1str(OUT,cur,"PROBE_EXCEPT ");
      cur=e1i32(OUT,cur,npx);
      cur=e1str(OUT,cur,"\n");
      let x:i32=0;
      while(x<npx){
        cur=e1str(OUT,cur,"XPAIR ");
        cur=w_emit_name(en,OUT,cur,px[x*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,px[x*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        x=x+1;
      }
      cur=e1str(OUT,cur,"END_OBSERVE\n");
    }
    if(seq8(q0,"TEST_PAIR")==1){
      let al4:i32=gettok(input[qat..qen],qll,1,tok);
      let bl4:i32=gettok(input[qat..qen],qll,2,tok2);
      let yl5:i32=gettok(input[qat..qen],qll,3,tok3);
      p_int(tok3,0,yl5,ov);
      let y:i32=ig(ov,0);
      let a4:i32=w_find(en,tok[0..al4],al4);
      let b4:i32=w_find(en,tok2[0..bl4],bl4);
      let fb:i32=0;
      let f:i32=0;
      while(f<npx){
        if((px[f*2] as i32)==a4 && (px[f*2+1] as i32)==b4){ fb=1; }
        f=f+1;
      }
      if(fb==1){
        cur=e1str(OUT,cur,"FORBIDDEN\n");
      } else {
        // table index == hidden-order position: ACCEPT iff y matches
        let ty:i32=0;
        if(a4<b4){ ty=1; }
        if(y==ty){ cur=e1str(OUT,cur,"ACCEPT\n"); } else { cur=e1str(OUT,cur,"REJECT\n"); }
      }
    }
    if(seq8(q0,"TEST_RANK")==1){
      let ok:i32=1;
      let r:i32=0;
      while(r<10){
        let rl:i32=gettok(input[qat..qen],qll,1+r,tok);
        let ri:i32=w_find(en,tok[0..rl],rl);
        if(ri!=r){ ok=0; }
        r=r+1;
      }
      if(ok==1){ cur=e1str(OUT,cur,"RANK_ACCEPT\n"); } else { cur=e1str(OUT,cur,"RANK_REJECT\n"); }
    }
    if(seq8(q0,"COMMIT")==1){
      let kl:i32=gettok(input[qat..qen],qll,4,tok);
      p_int(tok,0,kl,ov);
      let kk:i32=ig(ov,0);
      let e3:i32=0;
      while(e3<kk){ qi=qi+1; e3=e3+1; }
      qi=qi+1;
      cur=e1str(OUT,cur,"COMMIT_OK\n");
    }
    if(seq8(q0,"DEFER")==1){
      cur=e1str(OUT,cur,"DEFER_OK\n");
    }
    if(seq8(q0,"HELDOUT_A")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nha);
      cur=e1str(OUT,cur,"\n");
      let i2:i32=0;
      while(i2<nha){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,ha[i2*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,ha[i2*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i2=i2+1;
      }
    }
    if(seq8(q0,"HELDOUT_B")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nhb);
      cur=e1str(OUT,cur,"\n");
      let i3:i32=0;
      while(i3<nhb){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,hb[i3*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,hb[i3*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i3=i3+1;
      }
    }
    if(seq8(q0,"HELDOUT_C")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nhc);
      cur=e1str(OUT,cur,"\n");
      let i4:i32=0;
      while(i4<nhc){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,hc[i4*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,hc[i4*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i4=i4+1;
      }
    }
    qi=qi+1;
  }
  wraw(1,OUT,cur);
  return 0;
}

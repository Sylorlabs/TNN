// prelude.zag -- L3-INR shared low-level utilities. Pure Zag.
// Pinned-znc workarounds (AGENTS.md): u8-backed cells with ig/put32,
// single-buffer output with one raw syscall per line, no !(A&&B) in
// while conditions, if-nesting <= 3, no []u8 as *u8 casts.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
// emit helpers: format into OUT at cur, return new cur.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  return e1i64(OUT,cur,v as i64);
}
// one raw syscall write of OUT[0..len) to fd
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  _zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
// ---- file syscalls (x86_64 linux numbers) ----
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fopen_a(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),1089,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn write_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_w(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn append_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_a(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
// ---- decimal integer parse at b[p..e); value -> ov[0..4]; returns new pos
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==9){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let neg:i32=0;
  if(i<e && b[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  if(neg==1){ v=0-v; }
  put32(ov,0,v);
  return i;
}
// token: t-th whitespace-separated token of b[0..n) into out; returns len.
fn gettok(b:[]u8,n:i32,t:i32,out:[]u8)i32 {
  let i:i32=0;
  let cur:i32=0;
  while(i<n){
    while(i<n && (b[i]==32 || b[i]==9)){ i=i+1; }
    if(i>=n){ break; }
    let s:i32=i;
    while(i<n && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    if(cur==t){
      let k:i32=0;
      while(s+k<i){ out[k]=b[s+k]; k=k+1; }
      return i-s;
    }
    cur=cur+1;
  }
  return 0;
}
fn seq8(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// split b[0..n) into lines; line starts -> ls (u8 cells, cap entries).
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  while(at<n){
    let en:i32=at;
    while(en<n && b[en]!=10){ en=en+1; }
    if(nl<cap){ put32(ls,nl*4,at); }
    nl=nl+1;
    at=en+1;
  }
  return nl;
}
fn line_end(b:[]u8,at:i32,n:i32)i32 {
  let en:i32=at;
  while(en<n && b[en]!=10){ en=en+1; }
  return en;
}
// xorshift32 PRNG over a u8 cell (deterministic; seed recorded in log).
fn xr_next(st:[]u8)i32 {
  let x:i32=ig(st,0);
  if(x==0){ x=2463534242; }
  x=x^(x<<13); x=x^(x>>17); x=x^(x<<5);
  put32(st,0,x);
  return x;
}
// world.zag -- L3-INR WORLD process. Pure Zag.
// Stateless per invocation: reads the .world file (hidden order, keys),
// reads protocol queries from stdin, writes responses to stdout.
// The LEARNER never opens the .world file: the driver passes the path
// only to this binary (information firewall, prereg section 3 / A-INFO).
// Entity table: 10 x 32B names; table index == position in hidden order.
// Responses: ACCEPT / REJECT / FORBIDDEN (probe-domain enforcement;
// harness-level, carries no expected value), RANK_ACCEPT / RANK_REJECT,
// COMMIT_OK, DEFER_OK, INSTANCES/PAIRS blocks.
// emit entity name idx from world table en into OUT.
fn w_emit_name(en:[]u8,OUT:[]u8,cur:i32,idx:i32)i32 {
  let base:i32=idx*32;
  let j:i32=0;
  while(j<32 && en[base+j]!=0){ OUT[cur+j]=en[base+j]; j=j+1; }
  return cur+j;
}
fn w_find(en:[]u8,name:[]u8,nl:i32)i32 {
  let i:i32=0;
  while(i<10){
    let base:i32=i*32;
    let ln:i32=0;
    while(ln<32 && en[base+ln]!=0){ ln=ln+1; }
    if(ln==nl){
      let j:i32=0;
      let ok:i32=1;
      while(j<ln){ if(en[base+j]!=name[j]){ ok=0; } j=j+1; }
      if(ok==1){ return i; }
    }
    i=i+1;
  }
  return -1;
}
fn main()i32 {
  let path:[]u8=_zag_arg(1);
  if(path.len==0){ return 2; }
  let wf:[]u8=read_file(path);
  if(wf.len==0){ return 3; }
  let wlen:i32=wf.len;
  let en:[]u8=z_alloc(320);
  let nn:i32=0;
  let tr:[]u8=z_alloc(96);
  let ntr:i32=0;
  let ha:[]u8=z_alloc(32);
  let hb:[]u8=z_alloc(32);
  let hc:[]u8=z_alloc(32);
  let nha:i32=0; let nhb:i32=0; let nhc:i32=0;
  let at:[]u8=z_alloc(30);
  let nat:i32=0;
  let px:[]u8=z_alloc(180);
  let npx:i32=0;
  let ls:[]u8=z_alloc(4096);
  let nl:i32=split_lines(wf,wlen,ls,1024);
  let li:i32=0;
  let mode:i32=0;
  let want:i32=0;
  let tok:[]u8=z_alloc(64);
  let tok2:[]u8=z_alloc(64);
  let tok3:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl){
    let lat:i32=ig(ls,li*4);
    let len2:i32=line_end(wf,lat,wlen);
    let ll:i32=len2-lat;
    let t0l:i32=gettok(wf[lat..len2],ll,0,tok);
    let t0:[]u8=tok[0..t0l];
    let inblock:i32=0;
    if(mode>=1 && want>0){ inblock=1; }
    if(inblock==1){
      if(seq8(t0,"PAIR")==1){
        let al:i32=gettok(wf[lat..len2],ll,1,tok);
        let bl:i32=gettok(wf[lat..len2],ll,2,tok2);
        let a:i32=w_find(en,tok[0..al],al);
        let b:i32=w_find(en,tok2[0..bl],bl);
        if(mode==1){
          let yl:i32=gettok(wf[lat..len2],ll,3,tok3);
          p_int(tok3,0,yl,ov);
          tr[ntr*3]=a as u8; tr[ntr*3+1]=b as u8; tr[ntr*3+2]=ig(ov,0) as u8;
          ntr=ntr+1;
        }
        if(mode==2){ ha[nha*2]=a as u8; ha[nha*2+1]=b as u8; nha=nha+1; }
        if(mode==4){ hb[nhb*2]=a as u8; hb[nhb*2+1]=b as u8; nhb=nhb+1; }
        if(mode==6){ hc[nhc*2]=a as u8; hc[nhc*2+1]=b as u8; nhc=nhc+1; }
        want=want-1;
      } else {
        if(seq8(t0,"ATTR")==1){
          let al2:i32=gettok(wf[lat..len2],ll,1,tok);
          let a2:i32=w_find(en,tok[0..al2],al2);
          let v0l:i32=gettok(wf[lat..len2],ll,2,tok2);
          p_int(tok2,0,v0l,ov);
          let v0:i32=ig(ov,0);
          let v1l:i32=gettok(wf[lat..len2],ll,3,tok3);
          p_int(tok3,0,v1l,ov);
          let v1:i32=ig(ov,0);
          let v2l:i32=gettok(wf[lat..len2],ll,4,tok2);
          p_int(tok2,0,v2l,ov);
          let v2:i32=ig(ov,0);
          at[a2*3]=v0 as u8; at[a2*3+1]=v1 as u8; at[a2*3+2]=v2 as u8;
          nat=nat+1;
          want=want-1;
        } else {
          if(seq8(t0,"XPAIR")==1){
            let al3:i32=gettok(wf[lat..len2],ll,1,tok);
            let bl3:i32=gettok(wf[lat..len2],ll,2,tok2);
            let a3:i32=w_find(en,tok[0..al3],al3);
            let b3:i32=w_find(en,tok2[0..bl3],bl3);
            px[npx*2]=a3 as u8; px[npx*2+1]=b3 as u8;
            npx=npx+1;
            want=want-1;
          }
        }
      }
      if(want==0){ mode=0; }
    } else {
      if(seq8(t0,"ORDER")==1){
        let cl:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,cl,ov);
        let cnt:i32=ig(ov,0);
        let q:i32=0;
        while(q<cnt){
          let ql:i32=gettok(wf[lat..len2],ll,2+q,tok);
          let base:i32=q*32;
          let z:i32=0;
          while(z<ql){ en[base+z]=tok[z]; z=z+1; }
          en[base+z]=0;
          q=q+1;
        }
        nn=cnt;
      }
      if(seq8(t0,"TRAIN")==1){
        let ml:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml,ov);
        want=ig(ov,0); mode=1;
      }
      if(seq8(t0,"HELDOUT_A")==1){
        let ml2:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml2,ov);
        want=ig(ov,0); mode=2;
      }
      if(seq8(t0,"HELDOUT_B")==1){
        let ml3:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml3,ov);
        want=ig(ov,0); mode=4;
      }
      if(seq8(t0,"HELDOUT_C")==1){
        let ml4:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml4,ov);
        want=ig(ov,0); mode=6;
      }
      if(seq8(t0,"NATTR")==1){
        let ml5:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml5,ov);
        want=ig(ov,0); mode=8;
      }
      if(seq8(t0,"PROBE_EXCEPT")==1){
        let ml6:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml6,ov);
        want=ig(ov,0); mode=9;
      }
    }
    li=li+1;
  }
  // ---- answer queries ----
  let input:[]u8=read_all_fd(0,1048576);
  let ilen:i32=input.len;
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  let qls:[]u8=z_alloc(4096);
  let qn:i32=split_lines(input,ilen,qls,1024);
  let qi:i32=0;
  while(qi<qn){
    let qat:i32=ig(qls,qi*4);
    let qen:i32=line_end(input,qat,ilen);
    let qll:i32=qen-qat;
    let q0l:i32=gettok(input[qat..qen],qll,0,tok);
    let q0:[]u8=tok[0..q0l];
    if(seq8(q0,"OBSERVE")==1){
      cur=e1str(OUT,cur,"INSTANCES ");
      cur=e1i32(OUT,cur,ntr);
      cur=e1str(OUT,cur,"\n");
      let i:i32=0;
      while(i<ntr){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,tr[i*3] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,tr[i*3+1] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,tr[i*3+2] as i32);
        cur=e1str(OUT,cur,"\n");
        i=i+1;
      }
      cur=e1str(OUT,cur,"NATTRS ");
      cur=e1i32(OUT,cur,nat);
      cur=e1str(OUT,cur,"\n");
      let j:i32=0;
      while(j<nn){
        cur=e1str(OUT,cur,"ATTR ");
        cur=w_emit_name(en,OUT,cur,j);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3+1] as i32);
        cur=e1str(OUT,cur," ");
        cur=e1i32(OUT,cur,at[j*3+2] as i32);
        cur=e1str(OUT,cur,"\n");
        j=j+1;
      }
      cur=e1str(OUT,cur,"PROBE_EXCEPT ");
      cur=e1i32(OUT,cur,npx);
      cur=e1str(OUT,cur,"\n");
      let x:i32=0;
      while(x<npx){
        cur=e1str(OUT,cur,"XPAIR ");
        cur=w_emit_name(en,OUT,cur,px[x*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,px[x*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        x=x+1;
      }
      cur=e1str(OUT,cur,"END_OBSERVE\n");
    }
    if(seq8(q0,"TEST_PAIR")==1){
      let al4:i32=gettok(input[qat..qen],qll,1,tok);
      let bl4:i32=gettok(input[qat..qen],qll,2,tok2);
      let yl5:i32=gettok(input[qat..qen],qll,3,tok3);
      p_int(tok3,0,yl5,ov);
      let y:i32=ig(ov,0);
      let a4:i32=w_find(en,tok[0..al4],al4);
      let b4:i32=w_find(en,tok2[0..bl4],bl4);
      let fb:i32=0;
      let f:i32=0;
      while(f<npx){
        if((px[f*2] as i32)==a4 && (px[f*2+1] as i32)==b4){ fb=1; }
        f=f+1;
      }
      if(fb==1){
        cur=e1str(OUT,cur,"FORBIDDEN\n");
      } else {
        // table index == hidden-order position: ACCEPT iff y matches
        let ty:i32=0;
        if(a4<b4){ ty=1; }
        if(y==ty){ cur=e1str(OUT,cur,"ACCEPT\n"); } else { cur=e1str(OUT,cur,"REJECT\n"); }
      }
    }
    if(seq8(q0,"TEST_RANK")==1){
      let ok:i32=1;
      let r:i32=0;
      while(r<10){
        let rl:i32=gettok(input[qat..qen],qll,1+r,tok);
        let ri:i32=w_find(en,tok[0..rl],rl);
        if(ri!=r){ ok=0; }
        r=r+1;
      }
      if(ok==1){ cur=e1str(OUT,cur,"RANK_ACCEPT\n"); } else { cur=e1str(OUT,cur,"RANK_REJECT\n"); }
    }
    if(seq8(q0,"COMMIT")==1){
      let kl:i32=gettok(input[qat..qen],qll,4,tok);
      p_int(tok,0,kl,ov);
      let kk:i32=ig(ov,0);
      let e3:i32=0;
      while(e3<kk){ qi=qi+1; e3=e3+1; }
      qi=qi+1;
      cur=e1str(OUT,cur,"COMMIT_OK\n");
    }
    if(seq8(q0,"DEFER")==1){
      cur=e1str(OUT,cur,"DEFER_OK\n");
    }
    if(seq8(q0,"HELDOUT_A")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nha);
      cur=e1str(OUT,cur,"\n");
      let i2:i32=0;
      while(i2<nha){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,ha[i2*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,ha[i2*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i2=i2+1;
      }
    }
    if(seq8(q0,"HELDOUT_B")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nhb);
      cur=e1str(OUT,cur,"\n");
      let i3:i32=0;
      while(i3<nhb){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,hb[i3*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,hb[i3*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i3=i3+1;
      }
    }
    if(seq8(q0,"HELDOUT_C")==1){
      cur=e1str(OUT,cur,"PAIRS ");
      cur=e1i32(OUT,cur,nhc);
      cur=e1str(OUT,cur,"\n");
      let i4:i32=0;
      while(i4<nhc){
        cur=e1str(OUT,cur,"PAIR ");
        cur=w_emit_name(en,OUT,cur,hc[i4*2] as i32);
        cur=e1str(OUT,cur," ");
        cur=w_emit_name(en,OUT,cur,hc[i4*2+1] as i32);
        cur=e1str(OUT,cur,"\n");
        i4=i4+1;
      }
    }
    qi=qi+1;
  }
  wraw(1,OUT,cur);
  return 0;
}

// prelude.zag -- L3-INR shared low-level utilities. Pure Zag.
// Pinned-znc workarounds (AGENTS.md): u8-backed cells with ig/put32,
// single-buffer output with one raw syscall per line, no !(A&&B) in
// while conditions, if-nesting <= 3, no []u8 as *u8 casts.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
// emit helpers: format into OUT at cur, return new cur.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  return e1i64(OUT,cur,v as i64);
}
// one raw syscall write of OUT[0..len) to fd
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  _zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
// ---- file syscalls (x86_64 linux numbers) ----
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fopen_a(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),1089,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn write_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_w(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn append_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_a(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
// ---- decimal integer parse at b[p..e); value -> ov[0..4]; returns new pos
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==9){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let neg:i32=0;
  if(i<e && b[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  if(neg==1){ v=0-v; }
  put32(ov,0,v);
  return i;
}
// token: t-th whitespace-separated token of b[0..n) into out; returns len.
fn gettok(b:[]u8,n:i32,t:i32,out:[]u8)i32 {
  let i:i32=0;
  let cur:i32=0;
  while(i<n){
    while(i<n && (b[i]==32 || b[i]==9)){ i=i+1; }
    if(i>=n){ break; }
    let s:i32=i;
    while(i<n && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    if(cur==t){
      let k:i32=0;
      while(s+k<i){ out[k]=b[s+k]; k=k+1; }
      return i-s;
    }
    cur=cur+1;
  }
  return 0;
}
fn seq8(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// split b[0..n) into lines; line starts -> ls (u8 cells, cap entries).
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  while(at<n){
    let en:i32=at;
    while(en<n && b[en]!=10){ en=en+1; }
    if(nl<cap){ put32(ls,nl*4,at); }
    nl=nl+1;
    at=en+1;
  }
  return nl;
}
fn line_end(b:[]u8,at:i32,n:i32)i32 {
  let en:i32=at;
  while(en<n && b[en]!=10){ en=en+1; }
  return en;
}
// xorshift32 PRNG over a u8 cell (deterministic; seed recorded in log).
fn xr_next(st:[]u8)i32 {
  let x:i32=ig(st,0);
  if(x==0){ x=2463534242; }
  x=x^(x<<13); x=x^(x>>17); x=x^(x<<5);
  put32(st,0,x);
  return x;
}
// spearman.zag -- DEV tool: |Spearman| of each attribute vs hidden order.
// Pure Zag. Reads a .world file, prints three correlations x1000.
// Used to validate G2(b) on DEV worlds (|r| < 0.2 required).
fn sp_find(en:[]u8,name:[]u8,nl:i32)i32 {
  let i:i32=0;
  while(i<10){
    let base:i32=i*32;
    let ln:i32=0;
    while(ln<32 && en[base+ln]!=0){ ln=ln+1; }
    if(ln==nl){
      let j:i32=0;
      let ok:i32=1;
      while(j<ln){ if(en[base+j]!=name[j]){ ok=0; } j=j+1; }
      if(ok==1){ return i; }
    }
    i=i+1;
  }
  return -1;
}
fn main()i32 {
  let path:[]u8=_zag_arg(1);
  let wf:[]u8=read_file(path);
  if(wf.len==0){ return 2; }
  let wlen:i32=wf.len;
  let en:[]u8=z_alloc(320);
  let at:[]u8=z_alloc(30);
  let ls:[]u8=z_alloc(4096);
  let nl:i32=split_lines(wf,wlen,ls,1024);
  let li:i32=0;
  let mode:i32=0;
  let want:i32=0;
  let tok:[]u8=z_alloc(64);
  let tok2:[]u8=z_alloc(64);
  let tok3:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl){
    let lat:i32=ig(ls,li*4);
    let len2:i32=line_end(wf,lat,wlen);
    let ll:i32=len2-lat;
    let t0l:i32=gettok(wf[lat..len2],ll,0,tok);
    let t0:[]u8=tok[0..t0l];
    let inb:i32=0;
    if(mode==8 && want>0){ inb=1; }
    if(inb==1){
      if(seq8(t0,"ATTR")==1){
        let al:i32=gettok(wf[lat..len2],ll,1,tok);
        let a:i32=sp_find(en,tok[0..al],al);
        let v0l:i32=gettok(wf[lat..len2],ll,2,tok2);
        p_int(tok2,0,v0l,ov);
        let v0:i32=ig(ov,0);
        let v1l:i32=gettok(wf[lat..len2],ll,3,tok3);
        p_int(tok3,0,v1l,ov);
        let v1:i32=ig(ov,0);
        let v2l:i32=gettok(wf[lat..len2],ll,4,tok2);
        p_int(tok2,0,v2l,ov);
        let v2:i32=ig(ov,0);
        at[a*3]=v0 as u8; at[a*3+1]=v1 as u8; at[a*3+2]=v2 as u8;
        want=want-1;
      }
      if(want==0){ mode=0; }
    } else {
      if(seq8(t0,"ORDER")==1){
        let cl:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,cl,ov);
        let cnt:i32=ig(ov,0);
        let q:i32=0;
        while(q<cnt){
          let ql:i32=gettok(wf[lat..len2],ll,2+q,tok);
          let base:i32=q*32;
          let z:i32=0;
          while(z<ql){ en[base+z]=tok[z]; z=z+1; }
          en[base+z]=0;
          q=q+1;
        }
      }
      if(seq8(t0,"NATTR")==1){
        let ml:i32=gettok(wf[lat..len2],ll,1,tok);
        p_int(tok,0,ml,ov);
        want=ig(ov,0); mode=8;
      }
    }
    li=li+1;
  }
  // Spearman per attribute k: values are a permutation of 0..9 over
  // entities; entity table index == true-order rank. rank(value)=value.
  // r = 1 - 6*sum(d^2)/(n(n^2-1)), d = value - orderrank. x1000.
  let OUT:[]u8=z_alloc(256);
  let cur:i32=0;
  let k:i32=0;
  while(k<3){
    let sd:i64=0;
    let e2:i32=0;
    while(e2<10){
      let v:i32=at[e2*3+k] as i32;
      let d:i64=(v-e2) as i64;
      sd=sd+d*d;
      e2=e2+1;
    }
    // r1000 = 1000 - 6000*sd/990  (n=10: 6/(10*99)=6/990)
    let r1000:i64=1000-(6000*sd)/990;
    if(r1000<0){ r1000=0-r1000; }
    cur=e1str(OUT,cur,"attr");
    cur=e1i32(OUT,cur,k);
    cur=e1str(OUT,cur," |r|x1000=");
    cur=e1i64(OUT,cur,r1000);
    cur=e1str(OUT,cur,"\n");
    k=k+1;
  }
  wraw(1,OUT,cur);
  return 0;
}

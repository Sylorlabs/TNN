// prelude.zag -- L3-INR shared low-level utilities. Pure Zag.
// Pinned-znc workarounds (AGENTS.md): u8-backed cells with ig/put32,
// single-buffer output with one raw syscall per line, no !(A&&B) in
// while conditions, if-nesting <= 3, no []u8 as *u8 casts.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
// emit helpers: format into OUT at cur, return new cur.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  return e1i64(OUT,cur,v as i64);
}
// one raw syscall write of OUT[0..len) to fd
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  _zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
// ---- file syscalls (x86_64 linux numbers) ----
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fopen_a(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),1089,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn write_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_w(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn append_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_a(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
// ---- decimal integer parse at b[p..e); value -> ov[0..4]; returns new pos
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==9){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let neg:i32=0;
  if(i<e && b[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  if(neg==1){ v=0-v; }
  put32(ov,0,v);
  return i;
}
// token: t-th whitespace-separated token of b[0..n) into out; returns len.
fn gettok(b:[]u8,n:i32,t:i32,out:[]u8)i32 {
  let i:i32=0;
  let cur:i32=0;
  while(i<n){
    while(i<n && (b[i]==32 || b[i]==9)){ i=i+1; }
    if(i>=n){ break; }
    let s:i32=i;
    while(i<n && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    if(cur==t){
      let k:i32=0;
      while(s+k<i){ out[k]=b[s+k]; k=k+1; }
      return i-s;
    }
    cur=cur+1;
  }
  return 0;
}
fn seq8(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// split b[0..n) into lines; line starts -> ls (u8 cells, cap entries).
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  while(at<n){
    let en:i32=at;
    while(en<n && b[en]!=10){ en=en+1; }
    if(nl<cap){ put32(ls,nl*4,at); }
    nl=nl+1;
    at=en+1;
  }
  return nl;
}
fn line_end(b:[]u8,at:i32,n:i32)i32 {
  let en:i32=at;
  while(en<n && b[en]!=10){ en=en+1; }
  return en;
}
// xorshift32 PRNG over a u8 cell (deterministic; seed recorded in log).
fn xr_next(st:[]u8)i32 {
  let x:i32=ig(st,0);
  if(x==0){ x=2463534242; }
  x=x^(x<<13); x=x^(x>>17); x=x^(x<<5);
  put32(st,0,x);
  return x;
}
// graph.zag -- L3-INR generic graph machinery. Pure Zag.
// This is the FROZEN GENERIC BASIS (prereg section 4a): LINK edge
// storage, neighbor lookup, iterated expansion (transitive closure).
// It operates over any 10-node directed graph; it contains no dominance,
// order, ranking, or sealed-world literals. The invented representation
// is the edge SET held in the learner's slot; this file is machinery.
// u8-backed n*n matrices; n <= 10.
fn g_zero(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return;
}
// iterated expansion: transitive closure of r (n x n bytes), in place.
fn reach_close(r:[]u8,n:i32)void {
  let k:i32=0;
  while(k<n){
    let i:i32=0;
    while(i<n){
      if(r[i*n+k]==1){
        let j:i32=0;
        while(j<n){
          if(r[k*n+j]==1){ r[i*n+j]=1; }
          j=j+1;
        }
      }
      i=i+1;
    }
    k=k+1;
  }
  return;
}
// reachability relation of edge list ea/eb (bytes), ne edges.
fn reach_of_edges(r:[]u8,n:i32,ea:[]u8,eb:[]u8,ne:i32)void {
  g_zero(r,n*n);
  let e:i32=0;
  while(e<ne){
    let a:i32=ea[e] as i32;
    let bb:i32=eb[e] as i32;
    if(a>=0 && a<n && bb>=0 && bb<n){ r[a*n+bb]=1; }
    e=e+1;
  }
  reach_close(r,n);
  return;
}
fn reach_eq(a:[]u8,b:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n*n){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}
// neighbor lookup: out-neighbors of v into out (bytes); returns count.
fn neighbors(adj:[]u8,n:i32,v:i32,out:[]u8)i32 {
  let c:i32=0;
  let j:i32=0;
  while(j<n){
    if(adj[v*n+j]==1){ out[c]=j as u8; c=c+1; }
    j=j+1;
  }
  return c;
}
// constraint DAG from training pairs: y=1 => a precedes b; y=0 => b
// precedes a. Closes transitively. Returns 1 if acyclic, 0 on cycle.
// (The y=0 reversal is generic total-order consequence bookkeeping over
// the learner's own OBSERVE instances, not a sealed-world literal.)
fn constraints_close(r:[]u8,n:i32,ta:[]u8,tb:[]u8,ty:[]u8,m:i32)i32 {
  g_zero(r,n*n);
  let k:i32=0;
  while(k<m){
    let a:i32=ta[k] as i32;
    let bb:i32=tb[k] as i32;
    if(ty[k]==1){ r[a*n+bb]=1; }
    if(ty[k]==0){ r[bb*n+a]=1; }
    k=k+1;
  }
  reach_close(r,n);
  let d:i32=0;
  while(d<n){
    if(r[d*n+d]==1){ return 0; }
    d=d+1;
  }
  return 1;
}
// out-degree profile of reachability r: outd[i] = #{j: r[i*n+j]==1}.
fn out_profile(r:[]u8,n:i32,outd:[]u8)void {
  let i:i32=0;
  while(i<n){
    let c:i32=0;
    let j:i32=0;
    while(j<n){
      if(r[i*n+j]==1){ c=c+1; }
      j=j+1;
    }
    outd[i]=c as u8;
    i=i+1;
  }
  return;
}
// rank_by_reach: order ids by out-degree descending (ties: smaller id).
// Generic ranking procedure over a slot's edge set; references the slot
// only, no entity or order literals. Result in perm (bytes).
fn rank_by_reach(r:[]u8,n:i32,perm:[]u8)void {
  let od:[]u8=z_alloc(10);
  out_profile(r,n,od);
  let used:[]u8=z_alloc(10);
  let p:i32=0;
  while(p<n){
    let best:i32=-1;
    let i:i32=0;
    while(i<n){
      if(used[i]==0){
        if(best==-1){ best=i; }
        if(best!=-1){
          let ob:i32=od[best] as i32;
          let oi:i32=od[i] as i32;
          if(oi>ob){ best=i; }
        }
      }
      i=i+1;
    }
    perm[p]=best as u8;
    used[best]=1;
    p=p+1;
  }
  return;
}
// count edges (u,v) with r[u*n+v]==1.
fn edge_count_r(r:[]u8,n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n*n){ if(r[i]==1){ c=c+1; } i=i+1; }
  return c;
}
// state.zag -- L3-INR learner persistent state. Pure Zag.
// Fixed-layout raw-byte state files (deterministic). The named-slot
// store persists committed edge sets across invocations and arms; it is
// learner-created persistent state (prereg section 4e/4f), not machinery.
// ST work.dat (256 bytes):
// [0..4) phase [4..8) ntest [8..12) nprobe [12..16) seq
// [16..20) seed [20..24) gid_ctr [24..28) committed_gid
// [28..32) parent_gid [32..36) esid_ctr [36..40) budget
// [40..44) probe_budget [44..48) ntrain [48..52) nheld
// [52..56) cand_u [56..60) cand_v [60..64) add_ne
// [64..68) del_idx [68..72) base_score [72..76) n_forbid
// [76..80) arm_code [80..84) held_kind [84..88) monitor_n
// [88..92) aux [92..96) aux2
// [96..128) arm str [128..160) mode str
// KB kb.dat (2048 bytes):
// [0..4) n [4..8) ntrain [8..12) nattr [12..16) nforbid
// names 10x32 at [32..352)
// train 32x3 bytes at [352..448)
// attrs 10x3 bytes at [448..478)
// forbid 90x2 bytes at [512..692)
// EDGES edges.dat (512 bytes): [0..4) ne, edges ne*2 at [4..)
// SLOT slot_G.dat (512 bytes): [0..4) gid [4..8) parent_gid [8..12) ne,
//   edges at [12..)
// HYPS hyps.dat: [0..4) nh, then h slots of 100 bytes reachability.
fn st_path(sd:[]u8,name:[]u8,out:[]u8)i32 {
  let c:i32=e1str(out,0,sd);
  c=e1str(out,c,"/");
  c=e1str(out,c,name);
  return c;
}
fn st_new()[]u8 {
  let s:[]u8=z_alloc(256);
  put32(s,20,1);
  put32(s,32,1);
  put32(s,36,3000);
  put32(s,40,150);
  return s;
}
fn st_save(sd:[]u8,s:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"work.dat",p);
  write_file(p[0..c],s);
  return;
}
fn st_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"work.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<256){ return ""; }
  return b[0..256];
}
fn st_getstr(s:[]u8,off:i32,out:[]u8)i32 {
  let i:i32=0;
  while(i<32 && s[off+i]!=0){ out[i]=s[off+i]; i=i+1; }
  return i;
}
fn st_setstr(s:[]u8,off:i32,v:[]u8)void {
  let i:i32=0;
  while(i<32){ s[off+i]=0; i=i+1; }
  let k:i32=0;
  while(k<v.len && k<31){ s[off+k]=v[k]; k=k+1; }
  return;
}
// trace: append "SEQ <seq> <line>\n" to trace.log; seq monotonic.
fn trace_add(sd:[]u8,s:[]u8,line:[]u8)void {
  let seq:i32=ig(s,12);
  let OUT:[]u8=z_alloc(line.len+32);
  let c:i32=0;
  c=e1str(OUT,c,"SEQ ");
  c=e1i32(OUT,c,seq);
  c=e1str(OUT,c," ");
  c=e1str(OUT,c,line);
  c=e1str(OUT,c,"\n");
  let p:[]u8=z_alloc(256);
  let pc:i32=st_path(sd,"trace.log",p);
  append_file(p[0..pc],OUT[0..c]);
  put32(s,12,seq+1);
  return;
}
// outbox: append a line to outbox.txt (message to WORLD).
fn ob_add(sd:[]u8,line:[]u8)void {
  let OUT:[]u8=z_alloc(line.len+2);
  let c:i32=e1str(OUT,0,line);
  c=e1str(OUT,c,"\n");
  let p:[]u8=z_alloc(256);
  let pc:i32=st_path(sd,"outbox.txt",p);
  append_file(p[0..pc],OUT[0..c]);
  return;
}
// ---- KB ----
fn kb_new()[]u8 { return z_alloc(2048); }
fn kb_save(sd:[]u8,k:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"kb.dat",p);
  write_file(p[0..c],k);
  return;
}
fn kb_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"kb.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<2048){ return ""; }
  return b[0..2048];
}
// name -> id; adds if absent (n<10). Returns id or -1.
fn kb_name_id(k:[]u8,name:[]u8,nl:i32)i32 {
  let n:i32=ig(k,0);
  let i:i32=0;
  while(i<n){
    let base:i32=32+i*32;
    let ln:i32=0;
    while(ln<32 && k[base+ln]!=0){ ln=ln+1; }
    if(ln==nl){
      let j:i32=0;
      let ok:i32=1;
      while(j<ln){ if(k[base+j]!=name[j]){ ok=0; } j=j+1; }
      if(ok==1){ return i; }
    }
    i=i+1;
  }
  if(n>=10){ return -1; }
  let nb:i32=32+n*32;
  let q:i32=0;
  while(q<nl && q<31){ k[nb+q]=name[q]; q=q+1; }
  k[nb+q]=0;
  put32(k,0,n+1);
  return n;
}
fn kb_name_len(k:[]u8,idx:i32)i32 {
  let base:i32=32+idx*32;
  let ln:i32=0;
  while(ln<32 && k[base+ln]!=0){ ln=ln+1; }
  return ln;
}
// emit name idx into OUT at cur; returns new cur.
fn kb_emit_name(k:[]u8,OUT:[]u8,cur:i32,idx:i32)i32 {
  let base:i32=32+idx*32;
  let j:i32=0;
  while(j<32 && k[base+j]!=0){ OUT[cur+j]=k[base+j]; j=j+1; }
  return cur+j;
}
// ---- working edge set (edges.dat) ----
fn ed_new()[]u8 { return z_alloc(512); }
fn ed_save(sd:[]u8,e:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"edges.dat",p);
  write_file(p[0..c],e);
  return;
}
fn ed_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"edges.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<512){ return ""; }
  return b[0..512];
}
fn ed_ne(e:[]u8)i32 { return ig(e,0); }
fn ed_add(e:[]u8,a:i32,b:i32)void {
  let ne:i32=ig(e,0);
  // ADD-EDGE: persistent-state edit (prereg 4c). No duplicates.
  let i:i32=0;
  let dup:i32=0;
  while(i<ne){
    if((e[4+i*2] as i32)==a && (e[4+i*2+1] as i32)==b){ dup=1; }
    i=i+1;
  }
  if(dup==0){
    e[4+ne*2]=a as u8; e[4+ne*2+1]=b as u8;
    put32(e,0,ne+1);
  }
  return;
}
fn ed_del(e:[]u8,idx:i32)void {
  // DEL-EDGE: persistent-state edit (prereg 4c). Removes edge idx.
  let ne:i32=ig(e,0);
  let i:i32=idx;
  while(i<ne-1){
    e[4+i*2]=e[4+(i+1)*2]; e[4+i*2+1]=e[4+(i+1)*2+1];
    i=i+1;
  }
  put32(e,0,ne-1);
  return;
}
fn ed_has(e:[]u8,a:i32,b:i32)i32 {
  let ne:i32=ig(e,0);
  let i:i32=0;
  while(i<ne){
    if((e[4+i*2] as i32)==a && (e[4+i*2+1] as i32)==b){ return 1; }
    i=i+1;
  }
  return 0;
}
// ---- named slot store (slot_G.dat): gid, parent_gid, ne, edges ----
fn slot_save(sd:[]u8,name:[]u8,gid:i32,parent:i32,e:[]u8)void {
  let b:[]u8=z_alloc(512);
  put32(b,0,gid);
  put32(b,4,parent);
  let ne:i32=ig(e,0);
  put32(b,8,ne);
  let i:i32=0;
  while(i<ne*2){ b[12+i]=e[4+i]; i=i+1; }
  let p:[]u8=z_alloc(256);
  let fn2:[]u8=z_alloc(64);
  let c:i32=e1str(fn2,0,"slot_");
  c=e1str(fn2,c,name);
  c=e1str(fn2,c,".dat");
  let pc:i32=st_path(sd,fn2[0..c],p);
  write_file(p[0..pc],b);
  return;
}
fn slot_load(sd:[]u8,name:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let fn2:[]u8=z_alloc(64);
  let c:i32=e1str(fn2,0,"slot_");
  c=e1str(fn2,c,name);
  c=e1str(fn2,c,".dat");
  let pc:i32=st_path(sd,fn2[0..c],p);
  let b:[]u8=read_file(p[0..pc]);
  if(b.len<512){ return ""; }
  return b[0..512];
}
// ---- hypothesis store (hyps.dat): [0..4) nh, 8 x 100B reach matrices
fn hyps_new()[]u8 { return z_alloc(804); }
fn hyps_save(sd:[]u8,h:[]u8)void {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"hyps.dat",p);
  write_file(p[0..c],h);
  return;
}
fn hyps_load(sd:[]u8)[]u8 {
  let p:[]u8=z_alloc(256);
  let c:i32=st_path(sd,"hyps.dat",p);
  let b:[]u8=read_file(p[0..c]);
  if(b.len<804){ return ""; }
  return b[0..804];
}
// add reachability matrix r (100B) if not already present; returns index or -1 if full.
fn hyps_add(h:[]u8,r:[]u8,n:i32)i32 {
  let nh:i32=ig(h,0);
  let i:i32=0;
  while(i<nh){
    let base:i32=4+i*100;
    if(reach_eq(h[base..base+100],r,n)==1){ return i; }
    i=i+1;
  }
  if(nh>=8){ return -1; }
  let nb:i32=4+nh*100;
  let j:i32=0;
  while(j<100){ h[nb+j]=r[j]; j=j+1; }
  put32(h,0,nh+1);
  return nh;
}
// read variant h reachability byte at (a,b); variants stored as 100B blocks
fn hyps_get(sd:[]u8,h:i32,a:i32,b:i32)i32 {
  let p:[]u8=z_alloc(256);
  let n:i32=st_path(sd,"hyps.dat",p);
  let f:[]u8=read_file(p[0..n]);
  if(f.len<4+h*100+100){ return -1; }
  return f[4+h*100+a*10+b] as i32;
}
// number of variants currently stored
fn hyps_count(sd:[]u8)i32 {
  let p:[]u8=z_alloc(256);
  let n:i32=st_path(sd,"hyps.dat",p);
  let f:[]u8=read_file(p[0..n]);
  if(f.len<4){ return 0; }
  return ig(f,0);
}
fn main()i32 {
  let k:[]u8=kb_new();
  // simulate: parse "PAIR e5 e2 0"
  let line:[]u8="PAIR e5 e2 0";
  let tok:[]u8=z_alloc(64);
  let tok3:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let ll:i32=line.len;
  let yl:i32=gettok(line,ll,3,tok3);
  p_int(tok3,0,yl,ov);
  let OUT:[]u8=z_alloc(64);
  let c:i32=e1str(OUT,0,"yl=");
  c=e1i32(OUT,c,yl);
  c=e1str(OUT,c," y=");
  c=e1i32(OUT,c,ig(ov,0));
  c=e1str(OUT,c,"\n");
  wraw(1,OUT,c);
  return 0;
}

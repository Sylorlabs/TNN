  let o:i32=gq_b(G,9002,2);
  o=gq_n(G,o,7201,2); o=gq_f(G,o,201); o=gq_f(G,o,120);
  o=gq_n(G,o,7202,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,203); o=gq_f(G,o,140);
  o=gq_f(G,o,0); o=gq_f(G,o,205); o=gq_f(G,o,160);
  o=gq_l(G,o,1);
  o=gq_k(G,o,2,1,0);
  return;
}

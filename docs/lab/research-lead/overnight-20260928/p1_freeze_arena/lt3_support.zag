
// lt3_support.zag -- shared harness support block for the LT3 translation unit.
//
// PROVENANCE. Extracted verbatim from the certified FA1 translation unit
// `fa1.zag` (lines 1831-3019): the evaluator-side support both lanes share --
// lt_flush / lt_copy, the goal-record writers gq_b/gq_n/gq_f/gq_l/gq_k, the
// FA1 goal builders mk_goal / lt_decl, the frozen-grammar query driver
// lt_query, the scorer lt_score, the answer comparison lt_ans_eq, the
// memory-free ORACLE lt_oracle / lt_oracle_ok, and the memory-occupancy and
// chain helpers. Committed here so the LT3 translation unit is reproducible
// from the repository alone.
//
// It contains no LT3 experiment logic. FA1's own goal builders and declared
// answers are dead code in the LT3 unit (LT3 supplies mkLT3_goal and
// ltLT3_decl); they are retained only so this block stays byte-identical to
// FA1's and the two lanes stay comparable.
//
// NAME CHECK (kill bar K23). The presence of mk_goal / lt_decl / lt_oracle in
// THIS FILE is not a leak: these are harness-side and evaluator-only, and are
// not reachable from the learner entry points frz_episode or lt_query. K23
// tests REACHABILITY, not mere presence -- run_lt3.sh enumerates the exact
// callee set of both entry points and fails if either reaches a goal builder, a
// declared-answer writer, the oracle, or the control plumbing.
//
// ---- begins: fa1.zag line 1831 ----
// lt_world.zag -- LIFETIME-AB-1 stage worlds, episode stream, goal records,
// and evaluator-declared correct answers.
//
// HARNESS SIDE. Every literal in the whole experiment lives here or in
// lt_main.zag. The learner never sees a stage id, a stage name, a
// cross-stage goal tag, or a correctness signal.
//
// Arena A is APPEND-ONLY with capacity 512 facts and the layout
// [nf, (s,r,o) x nf] of the frozen base, so the frozen generic
// procedures ret_gen / vfy_gen / cnt_gen read it unmodified.
//
// Stage fact totals: A 52, B 27, C 28, D 39, E 200, F 16 (14 + a
// 2-fact post-query extension), G 28, H 26 = 416.

fn lt_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<512){
    set32(A,4+n*12,s);
    set32(A,4+n*12+4,r);
    set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
fn lt_world_new()[]u8 { return z_alloc(12288); }
// Single buffered flush. The frozen base's o_flush uses
// _zag_raw_syscall(1,1,...) which is INERT on this host (znc
// 2026.07.0-dev / macos-arm64): it writes nothing to fd 1 or fd 2.
// Verified by direct probe. This lane keeps the mandatory discipline --
// all dynamic content is formatted into ONE preallocated buffer with
// cursor-returning helpers -- and emits that buffer in exactly ONE call
// via _zag_print on the filled slice.
fn lt_flush(b:[]u8,c:i32)void {
  _zag_print(b[0..c]);
  return;
}
fn lt_copy(d:[]u8,s:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ d[i]=s[i]; i=i+1; }
  return;
}

// ================= STAGE A: unfamiliar procedural world =================
fn w_stageA(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,10+i,101,20); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,10+i,102,30); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,10+i,103,40); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,60+i,104,20); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,10+i,105,50); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,10+i,106,60); i=i+1; }
  i=0;
  while(i<5){
    lt_add(A,10+i,107,70);
    lt_add(A,10+i,107,71);
    i=i+1;
  }
  return;
}

// ================= STAGE B: causal world =================
fn w_stageB(A:[]u8)void {
  let i:i32=0;
  while(i<6){ lt_add(A,110+i,201,120); i=i+1; }
  lt_add(A,120,202,130);
  i=0;
  while(i<6){ lt_add(A,110+i,203,140); i=i+1; }
  lt_add(A,120,204,150);
  lt_add(A,110,205,160);
  lt_add(A,111,205,160);
  lt_add(A,112,205,160);
  lt_add(A,110,205,161);
  lt_add(A,111,205,161);
  lt_add(A,120,206,170);
  i=0;
  while(i<6){ lt_add(A,110+i,207,160); i=i+1; }
  lt_add(A,120,208,180);
  return;
}

// ================= STAGE C: formal constraint world =================
fn w_stageC(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,30+i,301,50); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,30+i,302,60); i=i+1; }
  i=0;
  while(i<4){ lt_add(A,30+i,303,70); i=i+1; }
  i=0;
  while(i<2){ lt_add(A,30+i,303,71); i=i+1; }
  i=0;
  while(i<6){ lt_add(A,30+i,304,80); i=i+1; }
  return;
}

// ================= STAGE D: misleading evidence =================
fn w_stageD(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,200+i,108,20); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,200+i,109,30); i=i+1; }
  i=0;
  while(i<8){ lt_add(A,200+i,110,50); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,200+i,111,60); i=i+1; }
  i=0;
  while(i<5){
    lt_add(A,200+i,112,70);
    lt_add(A,200+i,112,71);
    i=i+1;
  }
  return;
}

// ================= STAGE E: long unrelated distractor period =========
fn w_stageE(A:[]u8)void {
  let k:i32=0;
  while(k<10){
    let j:i32=0;
    while(j<20){
      lt_add(A,900+j,500+k,600+k);
      j=j+1;
    }
    k=k+1;
  }
  return;
}

// ================= STAGE F: A+C composition ======================
fn w_stageF(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,10+i,302,60); i=i+1; }
  i=0;
  while(i<6){ lt_add(A,11+i,305,90); i=i+1; }
  return;
}
// post-query extension of an A-era relation covered since stage A.
// Appended after F's goal is answered, so a stale snapshot is wrong.
fn w_stageF_ext(A:[]u8)void {
  lt_add(A,10,107,72);
  lt_add(A,12,107,72);
  return;
}

// ================= STAGE G: revision contradicting B ==============
fn w_stageG(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,40+i,601,70); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,40+i,602,80); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,40+i,603,90); i=i+1; }
  i=0;
  while(i<3){ lt_add(A,40+i,603,91); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,42+i,604,100); i=i+1; }
  lt_add(A,113,201,121);
  lt_add(A,112,205,162);
  return;
}

// ================= STAGE H: invention pressure =====================
fn w_stageH(A:[]u8)void {
  let i:i32=0;
  while(i<8){ lt_add(A,50+i,701,110); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,50+i,702,120); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,50+i,703,130); i=i+1; }
  i=0;
  while(i<3){ lt_add(A,50+i,703,131); i=i+1; }
  i=0;
  while(i<5){ lt_add(A,52+i,704,140); i=i+1; }
  return;
}

// ================= episode stream ==================================
// Modality is inherited from the frozen core's own ret_episode /
// vfy_episode / cnt_episode split. It is NOT a task label.

// modality 0: RETRIEVE episodes -> (rel, obj) at rb[0], rb[4]
fn ep_ret(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,101); set32(rb,4,20); return; }
  if(id==1){ set32(rb,0,102); set32(rb,4,30); return; }
  if(id==2){ set32(rb,0,103); set32(rb,4,40); return; }
  if(id==3){ set32(rb,0,105); set32(rb,4,50); return; }
  if(id==4){ set32(rb,0,106); set32(rb,4,60); return; }
  if(id==5){ set32(rb,0,201); set32(rb,4,120); return; }
  if(id==6){ set32(rb,0,203); set32(rb,4,140); return; }
  if(id==7){ set32(rb,0,205); set32(rb,4,160); return; }
  if(id==8){ set32(rb,0,301); set32(rb,4,50); return; }
  if(id==9){ set32(rb,0,302); set32(rb,4,60); return; }
  if(id==10){ set32(rb,0,108); set32(rb,4,20); return; }
  if(id==11){ set32(rb,0,109); set32(rb,4,30); return; }
  if(id==12){ set32(rb,0,110); set32(rb,4,50); return; }
  if(id==13){ set32(rb,0,111); set32(rb,4,60); return; }
  if(id==14){ set32(rb,0,501); set32(rb,4,600); return; }
  if(id==15){ set32(rb,0,502); set32(rb,4,601); return; }
  if(id==16){ set32(rb,0,503); set32(rb,4,602); return; }
  if(id==17){ set32(rb,0,504); set32(rb,4,603); return; }
  if(id==18){ set32(rb,0,102); set32(rb,4,30); return; }
  if(id==19){ set32(rb,0,601); set32(rb,4,70); return; }
  if(id==20){ set32(rb,0,602); set32(rb,4,80); return; }
  if(id==21){ set32(rb,0,603); set32(rb,4,90); return; }
  if(id==22){ set32(rb,0,604); set32(rb,4,100); return; }
  if(id==23){ set32(rb,0,701); set32(rb,4,110); return; }
  if(id==24){ set32(rb,0,702); set32(rb,4,120); return; }
  if(id==25){ set32(rb,0,703); set32(rb,4,130); return; }
  if(id==26){ set32(rb,0,704); set32(rb,4,140); return; }
  set32(rb,0,107); set32(rb,4,72);
  return;
}
// modality 2: COUNT episodes -> (rel, subj) at rb[0], rb[4]
fn ep_cnt(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,107); set32(rb,4,10); return; }
  if(id==1){ set32(rb,0,107); set32(rb,4,11); return; }
  if(id==2){ set32(rb,0,205); set32(rb,4,110); return; }
  if(id==3){ set32(rb,0,303); set32(rb,4,30); return; }
  if(id==4){ set32(rb,0,112); set32(rb,4,200); return; }
  if(id==5){ set32(rb,0,501); set32(rb,4,900); return; }
  if(id==6){ set32(rb,0,502); set32(rb,4,900); return; }
  if(id==7){ set32(rb,0,503); set32(rb,4,900); return; }
  if(id==8){ set32(rb,0,504); set32(rb,4,900); return; }
  if(id==9){ set32(rb,0,603); set32(rb,4,40); return; }
  set32(rb,0,703); set32(rb,4,50);
  return;
}
// modality 1: VERIFY episodes (explicit subject/relation/object triples)
fn ep_vfy(id:i32,C:[]u8)void {
  lt_chain_clear(C);
  if(id==0){ lt_chain_add(C,10,105,50); lt_chain_add(C,10,106,60); return; }
  if(id==1){ lt_chain_add(C,11,105,50); lt_chain_add(C,11,106,60); return; }
  if(id==2){ lt_chain_add(C,10,203,140); lt_chain_add(C,10,205,160); return; }
  if(id==3){ lt_chain_add(C,11,203,140); lt_chain_add(C,11,205,161); return; }
  if(id==4){ lt_chain_add(C,12,203,140); lt_chain_add(C,12,205,160); return; }
  if(id==5){ lt_chain_add(C,110,201,120); return; }
  if(id==6){ lt_chain_add(C,111,201,120); return; }
  if(id==7){ lt_chain_add(C,112,201,120); return; }
  if(id==8){ lt_chain_add(C,113,201,120); return; }
  if(id==9){ lt_chain_add(C,114,201,120); return; }
  if(id==10){ lt_chain_add(C,115,201,120); return; }
  if(id==11){ lt_chain_add(C,30,302,60); return; }
  if(id==12){ lt_chain_add(C,31,302,60); return; }
  if(id==13){ lt_chain_add(C,200,110,50); lt_chain_add(C,200,111,60); return; }
  if(id==14){ lt_chain_add(C,201,110,50); lt_chain_add(C,201,111,60); return; }
  if(id==15){ lt_chain_add(C,900,501,600); return; }
  if(id==16){ lt_chain_add(C,900,502,601); return; }
  if(id==17){ lt_chain_add(C,900,503,602); return; }
  if(id==18){ lt_chain_add(C,900,504,603); return; }
  if(id==19){ lt_chain_add(C,10,305,90); return; }
  if(id==20){ lt_chain_add(C,40,602,80); lt_chain_add(C,40,603,90); return; }
  if(id==21){ lt_chain_add(C,41,602,80); lt_chain_add(C,41,603,90); return; }
  if(id==22){ lt_chain_add(C,113,201,121); return; }
  if(id==23){ lt_chain_add(C,50,702,120); lt_chain_add(C,50,703,130); return; }
  if(id==24){ lt_chain_add(C,51,702,120); lt_chain_add(C,51,703,130); return; }
  lt_chain_add(C,13,201,120);
  return;
}

// ================= goal records ====================================
fn gq_b(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag);
  set32(G,4,nn);
  return 8;
}
fn gq_n(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag);
  set32(G,off+4,nf);
  return off+8;
}
fn gq_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn gq_l(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn gq_k(G:[]u8,off:i32,k:i32,dn:i32,sn:i32)i32 {
  set32(G,off,k);
  set32(G,off+4,dn);
  set32(G,off+8,0);
  set32(G,off+12,0);
  set32(G,off+16,sn);
  set32(G,off+20,0);
  set32(G,off+24,0);
  return off+28;
}

fn mkGA(G:[]u8)void {
  let o:i32=gq_b(G,9001,3);
  o=gq_n(G,o,7101,2); o=gq_f(G,o,102); o=gq_f(G,o,30);
  o=gq_n(G,o,7102,7); o=gq_f(G,o,2);
  o=gq_f(G,o,0); o=gq_f(G,o,105); o=gq_f(G,o,50);
  o=gq_f(G,o,0); o=gq_f(G,o,106); o=gq_f(G,o,60);
  o=gq_n(G,o,7103,3); o=gq_f(G,o,107); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}

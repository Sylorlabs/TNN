// fa_main.zag -- FREEZE-ARENA-1 driver (binary fa1).
//
// Two arms over the identical world, identical stage sequence, identical goal
// records, identical episode stream (416 episodes, one per fact, modality
// k mod 3), identical declared answers. They differ in ONE thing: whether
// frz_fill preloads stage s's facts into the arena at stage entry.
//
//   arm 0 = LIVE   : prefill at stage entry  + one append per episode
//   arm 1 = FROZEN : one append per episode, and nothing else, ever
//
// Also: LK3 no-episode control, the F-arm baseline/ablation set in BOTH arms,
// and examples-to-criterion in both arms.
//
// The learner is reached only through frz_episode(...) and lt_query(...).

// ---------------- checkpoint + channel-invariant helpers ----------------
fn fq_ck(b:[]u8,c:i32,CS:[]u8,idx:i32,A:[]u8,frz:i32) i32 {
  let base:i32=idx*12288;
  c=o_app(b,c,"LK5 arm cp ");
  c=o_i64(b,c,frz as i64);
  c=o_app(b,c," ");
  c=o_i64(b,c,idx as i64);
  if(frz==0){
    frz_ck_cp(CS,base,A);
    c=o_app(b,c," stored n=");
    c=o_i64(b,c,get32(A,0) as i64);
    c=o_nl(b,c);
    return c;
  }
  let e:i32=frz_ck_eq(CS,base,A);
  c=o_app(b,c," eq=");
  c=o_i64(b,c,e as i64);
  c=o_app(b,c," live_n=");
  c=o_i64(b,c,get32(CS,base) as i64);
  c=o_app(b,c," frz_n=");
  c=o_i64(b,c,get32(A,0) as i64);
  let na:i32=get32(CS,base);
  let nb:i32=get32(A,0);
  let mn:i32=na;
  if(nb<mn){ mn=nb; }
  let i:i32=0;
  let d:i32=-1;
  while(i<mn){
    if(d<0){
      if(get32(CS,base+4+i*12)!=get32(A,4+i*12)){ d=i; }
      if(d<0){
        if(get32(CS,base+4+i*12+4)!=get32(A,4+i*12+4)){ d=i; }
      }
      if(d<0){
        if(get32(CS,base+4+i*12+8)!=get32(A,4+i*12+8)){ d=i; }
      }
    }
    i=i+1;
  }
  c=o_app(b,c," firstdiff=");
  c=o_i64(b,c,d as i64);
  if(d>=0){
    c=o_app(b,c," live=");
    c=o_i64(b,c,get32(CS,base+4+d*12) as i64);
    c=o_app(b,c,"/");
    c=o_i64(b,c,get32(CS,base+4+d*12+4) as i64);
    c=o_app(b,c,"/");
    c=o_i64(b,c,get32(CS,base+4+d*12+8) as i64);
    c=o_app(b,c," frz=");
    c=o_i64(b,c,get32(A,4+d*12) as i64);
    c=o_app(b,c,"/");
    c=o_i64(b,c,get32(A,4+d*12+4) as i64);
    c=o_app(b,c,"/");
    c=o_i64(b,c,get32(A,4+d*12+8) as i64);
  }
  c=o_nl(b,c);
  return c;
}
// LK4: the arena must contain exactly one fact per episode delivered so far.
// Prints and returns the cursor; the caller keeps the violation tally.
fn fq_lk4(b:[]u8,c:i32,idx:i32,A:[]u8,eps:i32,frz:i32) i32 {
  let eq:i32=0;
  if(get32(A,0)==eps){ eq=1; }
  c=o_app(b,c,"LK4 arm cp arena eps eq ");
  c=o_i64(b,c,frz as i64);
  c=o_app(b,c," ");
  c=o_i64(b,c,idx as i64);
  c=o_app(b,c," ");
  c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," ");
  c=o_i64(b,c,eps as i64);
  c=o_app(b,c," ");
  c=o_i64(b,c,eq as i64);
  c=o_nl(b,c);
  return c;
}
// ---------------- emit helpers ----------------
fn fq_n6(b:[]u8,c:i32,l:[]u8,n0:i32,n1:i32,n2:i32,n3:i32,n4:i32,n5:i32)i32 {
  c=o_app(b,c,l);
  c=o_app(b,c," "); c=o_i64(b,c,n0 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,n1 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,n2 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,n3 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,n4 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,n5 as i64);
  c=o_nl(b,c);
  return c;
}
fn fq_kv(b:[]u8,c:i32,l:[]u8,v:i32)i32 {
  c=o_app(b,c,l);
  c=o_app(b,c,"=");
  c=o_i64(b,c,v as i64);
  return c;
}
fn fq_ansv(b:[]u8,c:i32,X:[]u8,lbl:[]u8)i32 {
  let n:i32=get32(X,0);
  c=o_app(b,c,"ANSV ");
  c=o_app(b,c,lbl);
  c=o_app(b,c," n=");
  c=o_i64(b,c,n as i64);
  c=o_app(b,c," v=");
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(X,4+i*4) as i64);
    i=i+1;
  }
  c=o_nl(b,c);
  return c;
}
fn fq_cov(b:[]u8,c:i32,L:[]u8,lbl:[]u8)i32 {
  c=o_app(b,c,"COV ");
  c=o_app(b,c,lbl);
  let n0:i32=get32(L,0);
  let n2:i32=get32(L,4248);
  let n3:i32=get32(L,8496);
  c=o_app(b,c," ret=");
  let q:i32=0;
  while(q<n0){
    if(q>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(L,4+q*4) as i64);
    q=q+1;
  }
  c=o_app(b,c," vfy=");
  q=0;
  while(q<n2){
    if(q>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(L,4252+q*4) as i64);
    q=q+1;
  }
  c=o_app(b,c," cnt=");
  q=0;
  while(q<n3){
    if(q>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(L,8500+q*4) as i64);
    q=q+1;
  }
  c=o_nl(b,c);
  return c;
}
fn fq_st(b:[]u8,c:i32,L:[]u8,LT:[]u8,A:[]u8,s:i32,ok:i32,frz:i32)i32 {
  c=o_app(b,c,"STAGE arm st facts memL memLT costep costq rev retcov vfycov cntcov plans pld trials dec tmplb tmplh bhit bmiss xw rr fviol nq ok ");
  c=o_i64(b,c,frz as i64);
  c=o_app(b,c," "); c=o_i64(b,c,s as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,44) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,48) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,4) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,8496) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,13224) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,13228) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,13232) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(L,13236) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,24) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,28) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,16) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,20) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,32) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,36) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,8) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,get32(LT,12) as i64);
  c=o_app(b,c," "); c=o_i64(b,c,ok as i64);
  c=o_nl(b,c);
  return c;
}
fn fq_evt(b:[]u8,c:i32,LT:[]u8,lbl:[]u8) i32 {
  let n:i32=get32(LT,92);
  let i:i32=0;
  while(i<n){
    let e:i32=lt_eb(i);
    c=o_app(b,c,"EVT ");
    c=o_app(b,c,lbl);
    c=o_app(b,c," ");
    c=o_i64(b,c,get32(LT,e) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,get32(LT,e+4) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,get32(LT,e+8) as i64);
    c=o_nl(b,c);
    i=i+1;
  }
  return c;
}
// one goal, one query, one score.  Returns ok + 10*oracle_match.
fn fq_goal(b:[]u8,c:i32,L:[]u8,LT:[]u8,A:[]u8,K:[]u8,tgt:i32,tdc:i32,lbl:[]u8,doorc:i32) i32 {
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let OR:[]u8=z_alloc(256);
  mk_goal(tgt,G);
  lt_decl(tdc,DE);
  let oc:i32=0;
  if(doorc==1){ oc=lt_oracle_ok(A,G,DE,K,OR); }
  let cd:i32=lt_query(L,LT,A,G,K,R,AN);
  let ok:i32=lt_score(DE,AN,cd);
  if(doorc==1){
    c=o_app(b,c,"ORACLE arm goal match ");
    c=o_i64(b,c,get32(LT,100) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,tgt as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,oc as i64);
    c=o_nl(b,c);
  }
  c=o_app(b,c,"Q st=");
  c=o_app(b,c,lbl);
  c=o_app(b,c," arm=");
  c=o_i64(b,c,get32(LT,100) as i64);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,tgt as i64);
  c=o_app(b,c," code=");
  c=o_i64(b,c,get32(R,0) as i64);
  c=o_app(b,c," ok=");
  c=o_i64(b,c,ok as i64);
  c=o_app(b,c," trials=");
  c=o_i64(b,c,get32(R,4) as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(R,84) as i64);
  c=o_app(b,c," exec=");
  c=o_i64(b,c,get32(R,8) as i64);
  c=o_app(b,c," tmpl=");
  c=o_i64(b,c,get32(R,16) as i64);
  c=o_app(b,c," orgq=");
  c=o_i64(b,c,get32(R,20) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(R,24) as i64);
  c=o_app(b,c," bmiss=");
  c=o_i64(b,c,get32(R,28) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(R,36) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(R,40) as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(R,44) as i64);
  c=o_app(b,c," rspec=");
  c=o_i64(b,c,get32(R,48) as i64);
  c=o_app(b,c," rgen=");
  c=o_i64(b,c,get32(R,52) as i64);
  c=o_app(b,c," vspec=");
  c=o_i64(b,c,get32(R,56) as i64);
  c=o_app(b,c," vgen=");
  c=o_i64(b,c,get32(R,60) as i64);
  c=o_app(b,c," cspec=");
  c=o_i64(b,c,get32(R,64) as i64);
  c=o_app(b,c," cgen=");
  c=o_i64(b,c,get32(R,68) as i64);
  c=o_app(b,c," pnew=");
  c=o_i64(b,c,get32(R,72) as i64);
  c=o_app(b,c," pld=");
  c=o_i64(b,c,get32(R,76) as i64);
  c=o_app(b,c," declines=");
  c=o_i64(b,c,get32(R,80) as i64);
  c=o_nl(b,c);
  return ok+oc*10;
}
// ---------------- harness lesions (evaluator side) ----------------
fn fq_zero_tmpl(T:[]u8)void {
  let i:i32=0;
  while(i<576){ set32(T,200+i*4,0); i=i+1; }
  return;
}
fn fq_zero_bs(T:[]u8)void {
  let i:i32=0;
  while(i<256){ set32(T,800+i*4,0); i=i+1; }
  return;
}
fn fq_recycle(L:[]u8,T:[]u8)void {
  let i:i32=0;
  while(i<8){ set32(L,bind_off(i),0); i=i+1; }
  let p:i32=0;
  while(p<4){ set32(L,13000+p*56,0); p=p+1; }
  fq_zero_tmpl(T);
  fq_zero_bs(T);
  set32(T,52,0);
  set32(T,56,0);
  set32(T,12,0);
  return;
}

// ================= one arm =================
fn arm_run(frz:i32,b:[]u8,c:i32,CS:[]u8) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt_world_new();
  let AS:[]u8=z_alloc(12288);
  let RL:[]u8=z_alloc(256);
  let MO:[]u8=z_alloc(8);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let SL:[]u8=z_alloc(16384);
  let SLT:[]u8=z_alloc(8192);
  let SA:[]u8=z_alloc(12288);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let R2:[]u8=z_alloc(128);
  let AN2:[]u8=z_alloc(256);
  let D2:[]u8=z_alloc(256);
  let G2:[]u8=z_alloc(512);
  let AR:[]u8=z_alloc(256);
  let AD:[]u8=z_alloc(12288);
  let SG:[]u8=z_alloc(128);
  let SC:[]u8=z_alloc(128);
  let CO:[]u8=z_alloc(256);
  let fw:i32=1;
  set32(LT,68,1);
  set32(LT,100,frz);
  lt_decl(9,D2);
  mk_goal(4,G2);
  c=o_app(b,c,"ARM ");
  if(frz==0){ c=o_app(b,c,"LIVE"); }
  if(frz==1){ c=o_app(b,c,"FROZEN"); }
  c=o_nl(b,c);

  let eps:i32=0;
  let ckeq:i32=0;
  let lk4bad:i32=0;
  let lk1preT:i32=0;
  let lk1postT:i32=0;
  let lk2preT:i32=0;
  let lk2postT:i32=0;
  let lk7aT:i32=0;
  let lk7mT:i32=0;
  let lk7sigT:i32=0;
  let orc:i32=0;
  let okA:i32=0;
  let okB:i32=0;
  let okC:i32=0;
  let okD:i32=0;
  let okDp:i32=0;
  let okEp:i32=0;
  let okF:i32=0;
  let okGG:i32=0;
  let okGP:i32=0;
  let okGB2:i32=0;
  let okH:i32=0;
  let okGA2:i32=0;
  let okGF2:i32=0;
  let bF0:i32=0;
  let bFA:i32=0;
  let bFs:i32=0;
  let bRC:i32=0;
  let aSN:i32=0;
  let aCT:i32=0;
  let aST:i32=0;
  let aNA:i32=0;
  let aNC:i32=0;
  let aNAc:i32=0;
  let aNCc:i32=0;
  let f0t:i32=0;
  let f0x:i32=0;
  let fat:i32=0;
  let fax:i32=0;
  let fst:i32=0;
  let fsx:i32=0;
  let snt:i32=0;
  let snx:i32=0;
  let ctt:i32=0;
  let ctx:i32=0;
  let stt:i32=0;
  let stx:i32=0;
  let s:i32=0;
  while(s<8){
    frz_stage_into(AS,s);
    let nf:i32=frz_nfact(s);
    let mid:i32=nf/2;
    frz_rlbuild(AS,RL);
    frz_rmask(RL,A,CO,s);
    let lk1pre:i32=frz_lk1(A,AS,nf);
    let lk2pre:i32=frz_memcount(L,LT,s,RL,CO,-1,MO);
    if(frz==0){ frz_fill(A,AS,frz_prefill(s)); }
    let lk1post:i32=frz_lk1(A,AS,nf);
    let lk2post:i32=frz_memcount(L,LT,s,RL,CO,-1,MO);
    lk1preT=lk1preT+lk1pre;
    lk1postT=lk1postT+lk1post;
    lk2preT=lk2preT+lk2pre;
    lk2postT=lk2postT+lk2post;
    c=fq_n6(b,c,"LK1 arm st nf pre post mem_pre",frz,s,nf,lk1pre,lk1post,lk2pre);
    c=fq_n6(b,c,"LK2 arm st tot sig nrel",frz,s,lk2post+get32(MO,4),get32(MO,4),lk2post,0);
    let ns2:i32=frz_hit_sample(L,LT,s,RL,CO,1,SG);
    let nc2:i32=frz_hit_sample(L,LT,s,RL,CO,0,SC);
    if(nc2>0){
      c=o_app(b,c,"LK2C arm st n off=val(sig)");
      c=o_app(b,c," ");
      c=o_i64(b,c,frz as i64);
      c=o_app(b,c," ");
      c=o_i64(b,c,s as i64);
      c=o_app(b,c," ");
      c=o_i64(b,c,nc2 as i64);
      let q:i32=0;
      while(q<nc2){
        c=o_app(b,c," ");
        c=o_i64(b,c,get32(SC,q*12) as i64);
        c=o_app(b,c,"=");
        c=o_i64(b,c,get32(SC,q*12+4) as i64);
        c=o_app(b,c,"/");
        c=o_i64(b,c,get32(SC,q*12+8) as i64);
        q=q+1;
      }
      c=o_nl(b,c);
    }
    if(ns2>0){
      c=o_app(b,c,"LK2S arm st n off=val(sig)");
      c=o_app(b,c," ");
      c=o_i64(b,c,frz as i64);
      c=o_app(b,c," ");
      c=o_i64(b,c,s as i64);
      c=o_app(b,c," ");
      c=o_i64(b,c,ns2 as i64);
      let q:i32=0;
      while(q<ns2){
        c=o_app(b,c," ");
        c=o_i64(b,c,get32(SG,q*12) as i64);
        c=o_app(b,c,"=");
        c=o_i64(b,c,get32(SG,q*12+4) as i64);
        c=o_app(b,c,"/");
        c=o_i64(b,c,get32(SG,q*12+8) as i64);
        q=q+1;
      }
      c=o_nl(b,c);
    }
    let nep:i32=nf;
    if(s==5){ nep=14; }
    frz_rlbuild(AS,RL);
    let k:i32=0;
    while(k<nep){
      if(k==mid){
        let lk7a:i32=frz_lk1(A,AS,nf);
        let lk7m:i32=frz_memcount(L,LT,s,RL,CO,mid,MO);
        lk7aT=lk7aT+lk7a;
        lk7mT=lk7mT+lk7m;
        lk7sigT=lk7sigT+get32(MO,4);
        c=fq_n6(b,c,"LK7 arm st mid arena mem_suffix sig",frz,s,mid,lk7a,lk7m,get32(MO,4));
      }
      frz_episode(L,LT,A,AS,K,k,fw,RB,CB,TO,SE);
      eps=eps+1;
      k=k+1;
    }
    let v:i32=0;
    if(s==0){ v=fq_goal(b,c,L,LT,A,K,0,0,"A",1); okA=v-(v/10)*10; orc=orc+v/10; }
    if(s==1){ v=fq_goal(b,c,L,LT,A,K,1,1,"B",1); okB=v-(v/10)*10; orc=orc+v/10; }
    if(s==2){ v=fq_goal(b,c,L,LT,A,K,2,2,"C",1); okC=v-(v/10)*10; orc=orc+v/10; }
    if(s==3){
      v=fq_goal(b,c,L,LT,A,K,3,3,"D",1); okD=v-(v/10)*10; orc=orc+v/10;
      v=fq_goal(b,c,L,LT,A,K,0,0,"D-reprobe-A",0); okDp=v-(v/10)*10;
    }
    if(s==4){ v=fq_goal(b,c,L,LT,A,K,0,0,"E-reprobe-A",0); okEp=v-(v/10)*10; }
    if(s==5){ v=fq_goal(b,c,L,LT,A,K,4,4,"F",1); okF=v-(v/10)*10; orc=orc+v/10; }
    if(s==6){
      v=fq_goal(b,c,L,LT,A,K,5,5,"G",1); okGG=v-(v/10)*10; orc=orc+v/10;
      v=fq_goal(b,c,L,LT,A,K,7,7,"G-probe",1); okGP=v-(v/10)*10; orc=orc+v/10;
      v=fq_goal(b,c,L,LT,A,K,1,1,"G-reprobe-B",0); okGB2=v-(v/10)*10;
    }
    if(s==7){
      v=fq_goal(b,c,L,LT,A,K,6,6,"H",1); okH=v-(v/10)*10; orc=orc+v/10;
      v=fq_goal(b,c,L,LT,A,K,0,8,"H-retain-GA",0); okGA2=v-(v/10)*10;
      v=fq_goal(b,c,L,LT,A,K,4,9,"H-reprobe-GF",0); okGF2=v-(v/10)*10;
    }
    let sok:i32=0;
    if(s==0){ sok=okA; }
    if(s==1){ sok=okB; }
    if(s==2){ sok=okC; }
    if(s==3){ sok=okD; }
    if(s==4){ sok=okEp; }
    if(s==5){ sok=okF; }
    if(s==6){ sok=okGG; }
    if(s==7){ sok=okH; }
    c=fq_st(b,c,L,LT,A,s,sok,frz);
    if(s==0){ c=fq_cov(b,c,L,"A"); }
    if(s==5){ c=fq_cov(b,c,L,"F"); }
    if(s==6){ c=fq_cov(b,c,L,"G"); }
    let cpi:i32=s;
    if(s==5){ cpi=5; }
    if(s==6){ cpi=7; }
    if(s==7){ cpi=8; }
    let bs:i32=cpi*12288;
    let e4:i32=0;
    if(get32(A,0)==eps){ e4=1; }
    c=fq_ck(b,c,CS,cpi,A,frz);
    c=fq_lk4(b,c,cpi,A,eps,frz);
    if(frz==1){
      if(e4==0){ lk4bad=lk4bad+1; }
      if(frz_ck_eq(CS,bs,A)==0){ ckeq=ckeq+1; }
    }
    s=s+1;
  }
  // ---- stage F extension episodes, then the F-arm snapshot ----
  frz_stage_into(AS,5);
  frz_episode(L,LT,A,AS,K,14,fw,RB,CB,TO,SE);
  eps=eps+1;
  frz_episode(L,LT,A,AS,K,15,fw,RB,CB,TO,SE);
  eps=eps+1;
  let bs6:i32=6*12288;
  let e6:i32=0;
  if(get32(A,0)==eps){ e6=1; }
  c=fq_ck(b,c,CS,6,A,frz);
  c=fq_lk4(b,c,6,A,eps,frz);
  if(frz==1){
    if(e6==0){ lk4bad=lk4bad+1; }
    if(frz_ck_eq(CS,bs6,A)==0){ ckeq=ckeq+1; }
  }
  lt_copy(SL,L,16384);
  lt_copy(SLT,LT,8192);
  lt_copy(SA,A,12288);

  // ================= F ARM: baselines and ablations =================
  // (1) FRESH0: zero learner, its OWN arena, zero episodes
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  let AF:[]u8=lt_world_new();
  set32(T2,68,1);
  let cd0:i32=lt_query(L2,T2,AF,G2,K,R2,AN2);
  bF0=lt_score(D2,AN2,cd0);
  f0t=get32(R2,4);
  f0x=get32(R2,84);
  c=fq_ansv(b,c,AN2,"FRESH0");
  c=fq_n6(b,c,"BASE FRESH0 arm trials cost code ok arena",frz,f0t,f0x,cd0,bF0,get32(AF,0));
  // (2) FRESH_ARENA: zero learner, the arm's arena handed over
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  set32(T2,68,1);
  let cdA:i32=lt_query(L2,T2,SA,G2,K,R2,AN2);
  bFA=lt_score(D2,AN2,cdA);
  fat=get32(R2,4);
  fax=get32(R2,84);
  c=fq_ansv(b,c,AN2,"FRESH_ARENA");
  c=fq_n6(b,c,"BASE FRESH_ARENA arm trials cost code ok arena",frz,fat,fax,cdA,bFA,get32(SA,0));
  // (3) FRESHs: zero learner, own arena, stage F's 16 episodes only
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  set32(T2,68,1);
  frz_stage_into(AS,5);
  let kf:i32=0;
  while(kf<16){
    frz_episode(L2,T2,AF,AS,K,kf,1,RB,CB,TO,SE);
    kf=kf+1;
  }
  let cds:i32=lt_query(L2,T2,AF,G2,K,R2,AN2);
  bFs=lt_score(D2,AN2,cds);
  fst=get32(R2,4);
  fsx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"FRESHF");
  c=fq_n6(b,c,"BASE FRESHF arm trials cost code ok arena",frz,fst,fsx,cds,bFs,get32(AF,0));
  // (4) RECENCY16
  let nfa:i32=get32(SA,0);
  let lo:i32=nfa-16;
  if(lo<0){ lo=0; }
  let m:i32=nfa-lo;
  set32(AR,0,m);
  let qq:i32=0;
  while(qq<m){
    set32(AR,4+qq*12,get32(SA,4+(lo+qq)*12));
    set32(AR,4+qq*12+4,get32(SA,4+(lo+qq)*12+4));
    set32(AR,4+qq*12+8,get32(SA,4+(lo+qq)*12+8));
    qq=qq+1;
  }
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,0);
  let cdR:i32=lt_query(L2,T2,AR,G2,K,R2,AN2);
  bRC=lt_score(D2,AN2,cdR);
  c=fq_ansv(b,c,AN2,"RECENCY16");
  c=fq_n6(b,c,"BASE RECENCY16 arm win trials cost code ok",frz,m,get32(R2,4),get32(R2,84),cdR,bRC);
  // (5) ABL-NOSTRUCT
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  fq_zero_tmpl(T2);
  fq_zero_bs(T2);
  let cdU:i32=lt_query(L2,T2,SA,G2,K,R2,AN2);
  aST=lt_score(D2,AN2,cdU);
  stt=get32(R2,4);
  stx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"NOSTRUCT");
  c=fq_n6(b,c,"ABL NOSTRUCT arm trials cost code ok x",frz,stt,stx,cdU,aST,0);
  // (6) ABL-SNAPSTALE
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,0);
  let cdS:i32=lt_query(L2,T2,SA,G2,K,R2,AN2);
  aSN=lt_score(D2,AN2,cdS);
  snt=get32(R2,4);
  snx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"SNAPSTALE");
  c=fq_n6(b,c,"ABL SNAPSTALE arm trials cost code ok x",frz,snt,snx,cdS,aSN,0);
  // (7) ABL-SNAPCTRL
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  let rev0:i32=get32(SLT,4);
  let cdT:i32=lt_query(L2,T2,SA,G2,K,R2,AN2);
  aCT=lt_score(D2,AN2,cdT);
  ctt=get32(R2,4);
  ctx=get32(R2,84);
  c=fq_n6(b,c,"ABL SNAPCTRL arm trials cost code ok newrev",frz,ctt,ctx,cdT,aCT,get32(T2,4)-rev0);
  // (8)(9) ABL-NOFACT-A and ABL-NOFACT-C, plus coverage-cleared variants
  let stg:i32=0;
  while(stg<2){
    let sw:i32=stg*2;
    frz_stage_into(AS,sw);
    lt_copy(AD,SA,12288);
    let na:i32=get32(AD,0);
    frz_del_stage(AD,AS);
    let rm:i32=na-get32(AD,0);
    lt_copy(L2,SL,16384);
    lt_copy(T2,SLT,8192);
    set32(T2,68,1);
    set32(T2,0,-1);
    let cdN:i32=lt_query(L2,T2,AD,G2,K,R2,AN2);
    let okN:i32=lt_score(D2,AN2,cdN);
    c=fq_ansv(b,c,AN2,"NOFACT");
    c=fq_n6(b,c,"ABL NOFACT arm st removed code ok trials cost",frz,sw,rm,cdN,okN,get32(R2,84));
    lt_copy(L2,SL,16384);
    lt_copy(T2,SLT,8192);
    set32(T2,68,1);
    set32(T2,0,-1);
    frz_zero_cov(L2);
    let cdNc:i32=lt_query(L2,T2,AD,G2,K,R2,AN2);
    let okNc:i32=lt_score(D2,AN2,cdNc);
    c=fq_ansv(b,c,AN2,"NOFACTCOV");
    c=fq_n6(b,c,"ABL NOFACTCOV arm st removed code ok trials cost",frz,sw,rm,cdNc,okNc,get32(R2,84));
    if(sw==0){ aNA=okN; aNAc=okNc; }
    if(sw==2){ aNC=okN; aNCc=okNc; }
    stg=stg+1;
  }
  // ---------------- arm summary ----------------
  c=o_app(b,c,"ARMSUM ");
  if(frz==0){ c=o_app(b,c,"LIVE "); }
  if(frz==1){ c=o_app(b,c,"FROZEN "); }
  c=fq_kv(b,c,"orc",orc); c=o_app(b,c," ");
  c=fq_kv(b,c,"okA",okA); c=o_app(b,c," ");
  c=fq_kv(b,c,"okB",okB); c=o_app(b,c," ");
  c=fq_kv(b,c,"okC",okC); c=o_app(b,c," ");
  c=fq_kv(b,c,"okD",okD); c=o_app(b,c," ");
  c=fq_kv(b,c,"okDpA",okDp); c=o_app(b,c," ");
  c=fq_kv(b,c,"okEpA",okEp); c=o_app(b,c," ");
  c=fq_kv(b,c,"okF",okF); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGG",okGG); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGP",okGP); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGB2",okGB2); c=o_app(b,c," ");
  c=fq_kv(b,c,"okH",okH); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGA2",okGA2); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGF2",okGF2); c=o_app(b,c," ");
  c=fq_kv(b,c,"fresh0",bF0); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshArena",bFA); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshF",bFs); c=o_app(b,c," ");
  c=fq_kv(b,c,"recency",bRC); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablSnap",aSN); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablSnapCtrl",aCT); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablNoStruct",aST); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablNoFactA",aNA); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablNoFactC",aNC); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablNoFactA_COV",aNAc); c=o_app(b,c," ");
  c=fq_kv(b,c,"ablNoFactC_COV",aNCc); c=o_app(b,c," ");
  c=fq_kv(b,c,"ckeq_bad",ckeq); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk4_bad",lk4bad); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk1pre",lk1preT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk1post",lk1postT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk2pre",lk2preT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk2post",lk2postT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk7arena",lk7aT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk7mem",lk7mT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk7sig",lk7sigT); c=o_app(b,c," ");
  c=fq_kv(b,c,"eps",eps); c=o_app(b,c," ");
  c=fq_kv(b,c,"arena",get32(A,0)); c=o_app(b,c," ");
  c=fq_kv(b,c,"tmplb",get32(LT,24)); c=o_app(b,c," ");
  c=fq_kv(b,c,"tmplh",get32(LT,28)); c=o_app(b,c," ");
  c=fq_kv(b,c,"xw",get32(LT,32)); c=o_app(b,c," ");
  c=fq_kv(b,c,"rr",get32(LT,36)); c=o_app(b,c," ");
  c=fq_kv(b,c,"fviol",get32(LT,8)); c=o_app(b,c," ");
  c=fq_kv(b,c,"rev",get32(LT,4)); c=o_app(b,c," ");
  c=fq_kv(b,c,"declines",get32(LT,40)); c=o_app(b,c," ");
  c=fq_kv(b,c,"evB",get32(LT,64)); c=o_app(b,c," ");
  c=fq_kv(b,c,"evP",get32(LT,60)); c=o_app(b,c," ");
  c=fq_kv(b,c,"misbind",get32(LT,80)); c=o_app(b,c," ");
  c=fq_kv(b,c,"bcap",get32(LT,88)); c=o_app(b,c," ");
  c=fq_kv(b,c,"pcap",get32(LT,84)); c=o_app(b,c," ");
  c=fq_kv(b,c,"costq",get32(LT,48)); c=o_app(b,c," ");
  c=fq_kv(b,c,"costep",get32(LT,44)); c=o_app(b,c," ");
  c=fq_kv(b,c,"memL",lt_cells(L,16384)); c=o_app(b,c," ");
  c=fq_kv(b,c,"memLT",lt_cells(LT,8192)); c=o_app(b,c," ");
  c=fq_kv(b,c,"fresh0trials",f0t); c=o_app(b,c," ");
  c=fq_kv(b,c,"fresh0cost",f0x); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshArenatrials",fat); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshArenacost",fax); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshFtrials",fst); c=o_app(b,c," ");
  c=fq_kv(b,c,"freshFcost",fsx); c=o_app(b,c," ");
  c=fq_kv(b,c,"nostructtrials",stt); c=o_app(b,c," ");
  c=fq_kv(b,c,"nostructcost",stx); c=o_app(b,c," ");
  c=o_nl(b,c);
  c=fq_evt(b,c,LT,"arm");

  // ================= TTC, per arm =================
  let L3:[]u8=z_alloc(16384);
  let T3:[]u8=z_alloc(8192);
  let L4:[]u8=z_alloc(16384);
  let T4:[]u8=z_alloc(8192);
  let A3:[]u8=lt_world_new();
  let AS2:[]u8=z_alloc(12288);
  let G3:[]u8=z_alloc(512);
  let R3:[]u8=z_alloc(128);
  let AN3:[]u8=z_alloc(256);
  let D3:[]u8=z_alloc(256);
  let t:i32=0;
  while(t<8){
    let ii:i32=0;
    while(ii<3072){ set32(A3,ii*4,0); ii=ii+1; }
    ii=0;
    while(ii<4096){ set32(L3,ii*4,0); ii=ii+1; }
    ii=0;
    while(ii<2048){ set32(T3,ii*4,0); ii=ii+1; }
    set32(T3,68,1);
    let jj:i32=0;
    if(frz==0){
      while(jj<=t){
        frz_stage_into(AS2,jj);
        frz_fill(A3,AS2,frz_prefill(jj));
        jj=jj+1;
      }
    }
    jj=0;
    while(jj<t){
      frz_stage_into(AS2,jj);
      let nj:i32=frz_nfact(jj);
      let kk:i32=0;
      while(kk<nj){
        frz_episode(L3,T3,A3,AS2,K,kk,1,RB,CB,TO,SE);
        kk=kk+1;
      }
      jj=jj+1;
    }
    let tgt:i32=0;
    let tdc:i32=0;
    if(t==1){ tgt=1; tdc=1; }
    if(t==2){ tgt=2; tdc=2; }
    if(t==3){ tgt=3; tdc=3; }
    if(t==5){ tgt=4; tdc=4; }
    if(t==6){ tgt=5; tdc=5; }
    if(t==7){ tgt=9; tdc=9; }
    mk_goal(tgt,G3);
    lt_decl(tdc,D3);
    frz_stage_into(AS2,t);
    let ttc:i32=-1;
    let k0ok:i32=2;
    let lastok:i32=2;
    let lastcode:i32=2;
    let lastcost:i32=0;
    let m:i32=0;
    let nep:i32=frz_nfact(t);
    while(m<=nep){
      lt_copy(L4,L3,16384);
      lt_copy(T4,T3,8192);
      let cq:i32=lt_query(L4,T4,A3,G3,K,R3,AN3);
      let so:i32=lt_score(D3,AN3,cq);
      if(m==0){ k0ok=so; }
      lastok=so;
      lastcode=get32(R3,0);
      lastcost=get32(R3,84);
      if(so==1){
        if(ttc<0){ ttc=m; }
      }
      if(m<nep){ frz_episode(L3,T3,A3,AS2,K,m,1,RB,CB,TO,SE); }
      m=m+1;
    }
    c=fq_n6(b,c,"TTC arm st goal decl k0ok ttc",frz,t,tgt,tdc,k0ok,ttc);
    c=fq_n6(b,c,"TTC2 arm st nep lastcode lastcost ansn x",frz,t,nep,lastcode,lastcost,get32(AN3,0));
    if(t==5){
      mk_goal(4,G3);
      lt_decl(9,D3);
      let pq:i32=0;
      let pttc:i32=-1;
      while(pq<3){
        lt_copy(L4,L3,16384);
        lt_copy(T4,T3,8192);
        let cq2:i32=lt_query(L4,T4,A3,G3,K,R3,AN3);
        let so2:i32=lt_score(D3,AN3,cq2);
        if(so2==1){
          if(pttc<0){ pttc=14+pq; }
        }
        if(pq<2){ frz_episode(L3,T3,A3,AS2,K,14+pq,1,RB,CB,TO,SE); }
        pq=pq+1;
      }
      c=fq_n6(b,c,"TTCX arm st pttc arena ansn decn",frz,5,pttc,get32(A3,0),get32(AN3,0),get32(D3,0));
    }
    t=t+1;
  }
  return c;
}

// ================= LK3: no-episode control =================
fn nfe_run(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt_world_new();
  let AS:[]u8=z_alloc(12288);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  set32(LT,68,1);
  set32(LT,100,2);
  c=o_app(b,c,"ARM NOEPISODE (LK3) 416 episodes delivered, arena never written");
  c=o_nl(b,c);
  let s:i32=0;
  while(s<8){
    frz_stage_into(AS,s);
    let nf:i32=frz_nfact(s);
    let nep:i32=nf;
    if(s==5){ nep=14; }
    let k:i32=0;
    while(k<nep){
      frz_episode(L,LT,A,AS,K,k,0,RB,CB,TO,SE);
      k=k+1;
    }
    s=s+1;
  }
  frz_stage_into(AS,5);
  frz_episode(L,LT,A,AS,K,14,0,RB,CB,TO,SE);
  frz_episode(L,LT,A,AS,K,15,0,RB,CB,TO,SE);
  let nfe_ok:i32=0;
  let v:i32=0;
  v=fq_goal(b,c,L,LT,A,K,0,0,"NFE-A",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,1,1,"NFE-B",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,2,2,"NFE-C",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,3,3,"NFE-D",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,0,0,"NFE-EA",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,4,4,"NFE-F",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,5,5,"NFE-G",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,7,7,"NFE-GP",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,1,1,"NFE-GB",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,0,8,"NFE-GA",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  v=fq_goal(b,c,L,LT,A,K,4,9,"NFE-GF",0); nfe_ok=nfe_ok+(v-(v/10)*10);
  c=o_app(b,c,"LK3 nfe_ok=");
  c=o_i64(b,c,nfe_ok as i64);
  c=o_app(b,c," arena=");
  c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," retcov=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," vfycov=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," cntcov=");
  c=o_i64(b,c,get32(L,8496) as i64);
  c=o_app(b,c," memL=");
  c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT=");
  c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," fviol=");
  c=o_i64(b,c,get32(LT,8) as i64);
  c=o_nl(b,c);
  c=fq_evt(b,c,LT,"nfe");
  return c;
}

fn main() i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  let S:[]u8=z_alloc(12288);
  let CS:[]u8=z_alloc(110592);
  ss(S,2002,2);
  ss(S,2003,1);
  ss(S,2004,0);
  ss(S,2005,0);
  ss(S,2006,1);
  ss(S,2007,0);
  ss(S,2008,10);
  ss(S,2009,1);
  let ok1:i32=u_check(S,2000,2,5,7,0,0,0,0);
  ss(S,2008,3);
  let ok2:i32=u_check(S,2000,2,5,7,0,0,0,0);
  c=o_app(b,c,"CONTRACT-SELFTEST pass_in=");
  c=o_i64(b,c,ok1 as i64);
  c=o_app(b,c," pass_out=");
  c=o_i64(b,c,ok2 as i64);
  c=o_nl(b,c);
  c=arm_run(0,b,c,CS);
  c=arm_run(1,b,c,CS);
  c=nfe_run(b,c);
  lt_flush(b,c);
  return 0;
}
// lt3_main.zag -- LT3 driver (binary lt3).
//
// Same two arms as FA1, differing in ONE thing: whether frz_fill preloads
// stage s's facts into the arena at stage entry.
//   arm 0 = LIVE   : prefill at stage entry + one append per episode
//   arm 1 = FROZEN : one append per episode, and nothing else, ever
// All seven leak controls (LK1..LK7) are the FA1 implementations, unmodified.
// Ten stages A-J. Eight distinct goal shapes against the 4-slot PLAN table.
//
// The learner is reached only through frz_episode(...) and lt_query(...).

// f3_goal probes one goal on the live learner state and returns the OUTPUT
// CURSOR. Correctness and oracle agreement are returned through OUT[0] and
// OUT[4] respectively.
//
// BUG FIXED HERE (this lane's own harness, not the compiler): the previous
// version returned `ok + oc*10` and every call site assigned it to `v`,
// never to `c`. The output cursor therefore never advanced and EVERY goal
// line -- Q and ORACLE -- was formatted into the buffer and then silently
// overwritten by the next line. The experiment looked like it had run; it had
// printed nothing. Found by reading the output against the source: Q line
// count was 0 while okGA..okGIJ were all 0.
fn f3_goal(b:[]u8,c:i32,L:[]u8,LT:[]u8,A:[]u8,K:[]u8,tgt:i32,tdc:i32,lbl:[]u8,doorc:i32,OUT:[]u8) i32 {
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let OR:[]u8=z_alloc(256);
  mkLT3_goal(tgt,G);
  ltLT3_decl(tdc,DE);
  let oc:i32=0;
  if(doorc==1){ oc=lt_oracle_ok(A,G,DE,K,OR); }
  let cd:i32=lt_query(L,LT,A,G,K,R,AN);
  let ok:i32=lt_score(DE,AN,cd);
  set32(OUT,0,ok);
  set32(OUT,4,oc);
  if(doorc==1){
    // print BOTH vectors so a mismatch is diagnosable rather than a bare 0
    c=fq_ansv(b,c,DE,"DECL");
    c=fq_ansv(b,c,OR,"ORACLE");
    c=o_app(b,c,"ORACLE arm goal match ");
    c=o_i64(b,c,get32(LT,100) as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,tgt as i64);
    c=o_app(b,c," ");
    c=o_i64(b,c,oc as i64);
    c=o_nl(b,c);
  }
  c=o_app(b,c,"Q st=");
  c=o_app(b,c,lbl);
  c=o_app(b,c," arm=");
  c=o_i64(b,c,get32(LT,100) as i64);
  c=o_app(b,c," code=");
  c=o_i64(b,c,get32(R,0) as i64);
  c=o_app(b,c," ok=");
  c=o_i64(b,c,ok as i64);
  c=o_app(b,c," cost=");
  c=o_i64(b,c,get32(R,84) as i64);
  c=o_app(b,c," tmpl=");
  c=o_i64(b,c,get32(R,16) as i64);
  c=o_app(b,c," orgq=");
  c=o_i64(b,c,get32(R,20) as i64);
  c=o_app(b,c," bhit=");
  c=o_i64(b,c,get32(R,24) as i64);
  c=o_app(b,c," bmiss=");
  c=o_i64(b,c,get32(R,28) as i64);
  c=o_app(b,c," xw=");
  c=o_i64(b,c,get32(R,36) as i64);
  c=o_app(b,c," rr=");
  c=o_i64(b,c,get32(R,40) as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(R,44) as i64);
  c=o_app(b,c," pld=");
  c=o_i64(b,c,get32(R,76) as i64);
  c=o_app(b,c," declines=");
  c=o_i64(b,c,get32(R,80) as i64);
  c=o_nl(b,c);
  return c;
}

fn arm3(frz:i32,b:[]u8,c:i32,CS:[]u8) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let RL:[]u8=z_alloc(256);
  let MO:[]u8=z_alloc(8);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let SG:[]u8=z_alloc(128);
  let SC:[]u8=z_alloc(128);
  let CO:[]u8=z_alloc(256);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let SL:[]u8=z_alloc(16384);
  let SLT:[]u8=z_alloc(8192);
  let AF:[]u8=z_alloc(16384);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let R2:[]u8=z_alloc(128);
  let AN2:[]u8=z_alloc(256);
  let D2:[]u8=z_alloc(256);
  let AD:[]u8=z_alloc(16384);
  let AR:[]u8=z_alloc(16384);
  let GJ:[]u8=z_alloc(512);
  mkLT3_goal(5,GJ);
  let fw:i32=1;
  set32(LT,68,1);
  set32(LT,100,frz);
  c=o_app(b,c,"ARM ");
  if(frz==0){ c=o_app(b,c,"LIVE"); }
  if(frz==1){ c=o_app(b,c,"FROZEN"); }
  c=o_nl(b,c);

  let eps:i32=0;
  let ckeq:i32=0;
  let lk4bad:i32=0;
  let lk1preT:i32=0;
  let lk1postT:i32=0;
  let lk2preT:i32=0;
  let lk2postT:i32=0;
  let lk7aT:i32=0;
  let lk7mT:i32=0;
  let orc:i32=0;
  let GO:[]u8=z_alloc(8);
  let okGA:i32=0;
  let okGB:i32=0;
  let okGC:i32=0;
  let okDpA:i32=0;
  let okEpA:i32=0;
  let okGF:i32=0;
  let okG3:i32=0;
  let okGH:i32=0;
  let okIpA:i32=0;
  let okGIJ:i32=0;
  let bF0:i32=0;
  let bLT:i32=0;
  let ltx:i32=0;
  let bFA:i32=0;
  let bFs:i32=0;
  let bRC:i32=0;
  let aSN:i32=0;
  let aCT:i32=0;
  let aST:i32=0;
  let nA:i32=0;
  let nC:i32=0;
  let nF:i32=0;
  let nAc:i32=0;
  let nCc:i32=0;
  let nFc:i32=0;
  let f0x:i32=0;
  let fax:i32=0;
  let fsx:i32=0;
  let m0:i32=0;
  let stx:i32=0;
  let snx:i32=0;
  let ctx:i32=0;

  // F-stage scratch kept for the FRESH_F baseline
  let s:i32=0;
  while(s<10){
    frz_stage_into(AS,s);
    let nf:i32=frz_nfact(s);
    let mid:i32=nf/2;
    if(s==5){
      let i:i32=0;
      while(i<4096){ set32(AF,i*4,get32(AS,i*4)); i=i+1; }
    }
    frz_rlbuild(AS,RL);
    frz_rmask(RL,A,CO,s);
    let lk1pre:i32=frz_lk1(A,AS,nf);
    let lk2pre:i32=frz_memcount(L,LT,s,RL,CO,-1,MO);
    if(frz==0){ frz_fill(A,AS,frz_prefill(s)); }
    let lk1post:i32=frz_lk1(A,AS,nf);
    let lk2post:i32=frz_memcount(L,LT,s,RL,CO,-1,MO);
    lk1preT=lk1preT+lk1pre;
    lk1postT=lk1postT+lk1post;
    lk2preT=lk2preT+lk2pre;
    lk2postT=lk2postT+lk2post;
    c=fq_n6(b,c,"LK1 arm st nf pre post mem_pre",frz,s,nf,lk1pre,lk1post,lk2pre);
    c=fq_n6(b,c,"LK2 arm st tot sig nrel",frz,s,lk2post+get32(MO,4),get32(MO,4),lk2post,0);
    let ns2:i32=frz_hit_sample(L,LT,s,RL,CO,1,SG);
    let nc2:i32=frz_hit_sample(L,LT,s,RL,CO,0,SC);
    if(nc2>0){
      c=o_app(b,c,"LK2C arm st n off=val(sig)");
      c=o_app(b,c," "); c=o_i64(b,c,frz as i64);
      c=o_app(b,c," "); c=o_i64(b,c,s as i64);
      c=o_app(b,c," "); c=o_i64(b,c,nc2 as i64);
      let q:i32=0;
      while(q<nc2){
        c=o_app(b,c," "); c=o_i64(b,c,get32(SC,q*12) as i64);
        c=o_app(b,c,"="); c=o_i64(b,c,get32(SC,q*12+4) as i64);
        c=o_app(b,c,"/"); c=o_i64(b,c,get32(SC,q*12+8) as i64);
        q=q+1;
      }
      c=o_nl(b,c);
    }
    let k:i32=0;
    while(k<nf){
      if(k==mid){
        let lk7a:i32=frz_lk1(A,AS,nf);
        let lk7m:i32=frz_memcount(L,LT,s,RL,CO,mid,MO);
        lk7aT=lk7aT+lk7a;
        lk7mT=lk7mT+lk7m;
        c=fq_n6(b,c,"LK7 arm st mid arena mem_suffix sig",frz,s,mid,lk7a,lk7m,get32(MO,4));
      }
      frz_episode(L,LT,A,AS,K,k,fw,RB,CB,TO,SE);
      eps=eps+1;
      k=k+1;
    }
    // ---- goal probes. c IS advanced here (the FA1 harness bug). ----
    let v:i32=0;
    let ocv:i32=0;
    if(s==0){ c=f3_goal(b,c,L,LT,A,K,0,0,"A-GA(stage-local)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGA=v; }
    if(s==1){ c=f3_goal(b,c,L,LT,A,K,1,1,"B-GB(stage-local)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGB=v; }
    if(s==2){ c=f3_goal(b,c,L,LT,A,K,2,2,"C-GC(stage-local)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGC=v; }
    if(s==3){ c=f3_goal(b,c,L,LT,A,K,0,0,"D-reprobe-GA",0,GO); okDpA=get32(GO,0); }
    if(s==4){ c=f3_goal(b,c,L,LT,A,K,0,0,"E-reprobe-GA",0,GO); okEpA=get32(GO,0); }
    if(s==5){ c=f3_goal(b,c,L,LT,A,K,4,4,"F-GF(2join A+F)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGF=v; }
    if(s==6){ c=f3_goal(b,c,L,LT,A,K,6,6,"G-G3(2join B+C)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okG3=v; }
    if(s==7){ c=f3_goal(b,c,L,LT,A,K,7,7,"H-GH(decline)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGH=v; }
    if(s==8){ c=f3_goal(b,c,L,LT,A,K,0,0,"I-reprobe-GA",0,GO); okIpA=get32(GO,0); }
    if(s==9){ c=f3_goal(b,c,L,LT,A,K,8,8,"J-GIJ(2join I+J)",1,GO); v=get32(GO,0); ocv=get32(GO,4); orc=orc+ocv; okGIJ=v; }
    let sok:i32=0;
    if(s==0){ sok=okGA; }
    if(s==1){ sok=okGB; }
    if(s==2){ sok=okGC; }
    if(s==3){ sok=okDpA; }
    if(s==4){ sok=okEpA; }
    if(s==5){ sok=okGF; }
    if(s==6){ sok=okG3; }
    if(s==7){ sok=okGH; }
    if(s==8){ sok=okIpA; }
    if(s==9){ sok=okGIJ; }
    c=fq_st(b,c,L,LT,A,s,sok,frz);
    let e4:i32=0;
    if(get32(A,0)==eps){ e4=1; }
    c=fq_ck(b,c,CS,s,A,frz);
    c=fq_lk4(b,c,s,A,eps,frz);
    if(frz==1){
      if(e4==0){ lk4bad=lk4bad+1; }
      if(frz_ck_eq(CS,s*16400,A)==0){ ckeq=ckeq+1; }
    }
    s=s+1;
  }
  // ---- lifetime snapshot for the ablation rows ----
  lt_copy(SL,L,16384);
  lt_copy(SLT,LT,8192);

  // ================= THREE-STAGE JOIN: goal 5 = A + C + F =================
  c=o_app(b,c,"JOIN3 goal=5 stages=A,C,F");
  c=o_nl(b,c);
  ltLT3_decl(5,D2);
  // (0) FRESH0: zero state, own empty arena, zero episodes
  let i:i32=0;
  while(i<4096){ set32(AD,i*4,0); i=i+1; }
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,1);
  let cd0:i32=lt_query(L2,T2,AD,GJ,K,R2,AN2);
  bF0=lt_score(D2,AN2,cd0);
  f0x=get32(R2,84);
  c=fq_ansv(b,c,AN2,"J3FRESH0");
  c=fq_n6(b,c,"J3 FRESH0 arm ok cost code",frz,bF0,f0x,cd0,0,0);
  // (1) FRESH_ARENA: zero state, FULL arena handed over
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,1);
  let cdA:i32=lt_query(L2,T2,A,GJ,K,R2,AN2);
  bFA=lt_score(D2,AN2,cdA);
  fax=get32(R2,84);
  c=fq_ansv(b,c,AN2,"J3FRESHARENA");
  c=fq_n6(b,c,"J3 FRESH_ARENA arm ok cost code",frz,bFA,fax,cdA,0,0);
  // (2) FRESH_F: zero state, only stage F's facts
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,1);
  let cdF:i32=lt_query(L2,T2,AF,GJ,K,R2,AN2);
  bFs=lt_score(D2,AN2,cdF);
  fsx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"J3FRESHF");
  c=fq_n6(b,c,"J3 FRESHF arm ok cost code",frz,bFs,fsx,cdF,0,0);
  // (3) RECENCY16
  let na:i32=get32(A,0);
  let lo:i32=na-16;
  if(lo<0){ lo=0; }
  m0=na-lo;
  set32(AR,0,m0);
  let qq:i32=0;
  while(qq<m0){
    set32(AR,4+qq*12,get32(A,4+(lo+qq)*12));
    set32(AR,4+qq*12+4,get32(A,4+(lo+qq)*12+4));
    set32(AR,4+qq*12+8,get32(A,4+(lo+qq)*12+8));
    qq=qq+1;
  }
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,0);
  let cdR:i32=lt_query(L2,T2,AR,GJ,K,R2,AN2);
  bRC=lt_score(D2,AN2,cdR);
  c=fq_n6(b,c,"J3 RECENCY16 arm win ok cost",frz,m0,bRC,get32(R2,84),0,0);
  // (4) ABL-NOSTRUCT on the lifetime snapshot
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  fq_zero_tmpl(T2);
  fq_zero_bs(T2);
  let cdU:i32=lt_query(L2,T2,A,GJ,K,R2,AN2);
  aST=lt_score(D2,AN2,cdU);
  stx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"J3NOSTRUCT");
  c=fq_n6(b,c,"J3 NOSTRUCT arm ok cost code",frz,aST,stx,cdU,0,0);
  // (5)(6) snapshot refresh off / on
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,0);
  let cdS:i32=lt_query(L2,T2,A,GJ,K,R2,AN2);
  aSN=lt_score(D2,AN2,cdS);
  snx=get32(R2,84);
  c=fq_n6(b,c,"J3 SNAPSTALE arm ok cost code",frz,aSN,snx,cdS,0,0);
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  let cdT:i32=lt_query(L2,T2,A,GJ,K,R2,AN2);
  aCT=lt_score(D2,AN2,cdT);
  ctx=get32(R2,84);
  c=fq_n6(b,c,"J3 SNAPCTRL arm ok cost code",frz,aCT,ctx,cdT,0,0);
  // (7)(8)(9) fact ablations: delete A's / C's / F's facts from the arena
  let sw:i32=0;
  while(sw<3){
    let sgx:i32=0;
    if(sw==0){ sgx=0; }
    if(sw==1){ sgx=2; }
    if(sw==2){ sgx=5; }
    frz_stage_into(AS,sgx);
    let j:i32=0;
    while(j<4096){ set32(AD,j*4,get32(A,j*4)); j=j+1; }
    frz_del_stage(AD,AS);
    lt_copy(L2,SL,16384);
    lt_copy(T2,SLT,8192);
    set32(T2,68,1);
    let cdN:i32=lt_query(L2,T2,AD,GJ,K,R2,AN2);
    let okN:i32=lt_score(D2,AN2,cdN);
    if(sw==0){ nA=okN; }
    if(sw==1){ nC=okN; }
    if(sw==2){ nF=okN; }
    // coverage-cleared variant
    frz_zero_cov(L2);
    let cdNc:i32=lt_query(L2,T2,AD,GJ,K,R2,AN2);
    let okNc:i32=lt_score(D2,AN2,cdNc);
    if(sw==0){ nAc=okNc; }
    if(sw==1){ nCc=okNc; }
    if(sw==2){ nFc=okNc; }
    sw=sw+1;
  }
  c=fq_n6(b,c,"J3 NOFACT A C F",frz,nA,nC,nF,0,0);
  c=fq_n6(b,c,"J3 NOFACT_COV A C F",frz,nAc,nCc,nFc,0,0);
  // (10) LIFETIME -- the full aged learner answers GACF. This is the (a)
  // measurement of PREREG_LT3 section 11 and was previously only implicit in
  // the SNAPCTRL row (same state, same settings); it is now printed explicitly
  // so the adjudication pair (LIFETIME vs FRESH_ARENA) is a single table.
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  let cdL:i32=lt_query(L2,T2,A,GJ,K,R2,AN2);
  bLT=lt_score(D2,AN2,cdL);
  ltx=get32(R2,84);
  c=fq_ansv(b,c,AN2,"J3LIFETIME");
  c=fq_n6(b,c,"J3 LIFETIME arm ok cost code",frz,bLT,ltx,cdL,0,0);

  // ================= TTC (examples-to-criterion), per arm =================
  // Ported from the FA1 harness. For each stage t: a fresh learner receives
  // every episode of every stage BEFORE t, then stage t's goal is queried
  // after 0,1,2,...,n_t episodes of stage t. TTC is the first m at which the
  // goal is answered correctly. Under LIVE the arena is prefilled at every
  // stage entry, so TTC must be 0 everywhere (that is the C500-R1 artefact
  // FA1 was built to remove). Under FROZEN it must exceed 0 wherever the goal
  // actually depends on stage-t facts.
  let TL:[]u8=z_alloc(16384);
  let TT:[]u8=z_alloc(8192);
  let TL2:[]u8=z_alloc(16384);
  let TT2:[]u8=z_alloc(8192);
  let TA:[]u8=lt3_world_new();
  let TAS:[]u8=z_alloc(16384);
  let TG:[]u8=z_alloc(512);
  let TR:[]u8=z_alloc(128);
  let TAN:[]u8=z_alloc(256);
  let TD:[]u8=z_alloc(256);
  let t:i32=0;
  while(t<10){
    let ii:i32=0;
    while(ii<4096){ set32(TA,ii*4,0); ii=ii+1; }
    ii=0;
    while(ii<4096){ set32(TL,ii*4,0); ii=ii+1; }
    ii=0;
    while(ii<2048){ set32(TT,ii*4,0); ii=ii+1; }
    set32(TT,68,1);
    set32(TT,100,frz);
    // LIVE only: prefill every stage up to and including t at its entry
    let jj:i32=0;
    if(frz==0){
      while(jj<=t){
        frz_stage_into(TAS,jj);
        frz_fill(TA,TAS,frz_prefill(jj));
        jj=jj+1;
      }
    }
    // every episode of every earlier stage
    jj=0;
    while(jj<t){
      frz_stage_into(TAS,jj);
      let nj:i32=frz_nfact(jj);
      let kk:i32=0;
      while(kk<nj){
        frz_episode(TL,TT,TA,TAS,K,kk,1,RB,CB,TO,SE);
        kk=kk+1;
      }
      jj=jj+1;
    }
    // the goal this stage is responsible for
    let tgt:i32=0;
    if(t==1){ tgt=1; }
    if(t==2){ tgt=2; }
    if(t==3){ tgt=4; }
    if(t==4){ tgt=4; }
    if(t==5){ tgt=4; }
    if(t==6){ tgt=6; }
    if(t==7){ tgt=7; }
    if(t==8){ tgt=8; }
    if(t==9){ tgt=8; }
    mkLT3_goal(tgt,TG);
    ltLT3_decl(tgt,TD);
    frz_stage_into(TAS,t);
    let ttc:i32=-1;
    let k0ok:i32=2;
    let lastok:i32=2;
    let lastcode:i32=2;
    let lastcost:i32=0;
    let m:i32=0;
    let nep:i32=frz_nfact(t);
    while(m<=nep){
      lt_copy(TL2,TL,16384);
      lt_copy(TT2,TT,8192);
      let cq:i32=lt_query(TL2,TT2,TA,TG,K,TR,TAN);
      let so:i32=lt_score(TD,TAN,cq);
      if(m==0){ k0ok=so; }
      lastok=so;
      lastcode=get32(TR,0);
      lastcost=get32(TR,84);
      if(so==1){
        if(ttc<0){ ttc=m; }
      }
      if(m<nep){ frz_episode(TL,TT,TA,TAS,K,m,1,RB,CB,TO,SE); }
      m=m+1;
    }
    c=fq_n6(b,c,"TTC arm st goal k0ok ttc",frz,t,tgt,k0ok,ttc,0);
    c=fq_n6(b,c,"TTC2 arm st nep lastcode lastcost ansn",frz,t,nep,lastcode,lastcost,get32(TAN,0));
    t=t+1;
  }

  // ---------------- arm summary ----------------
  c=o_app(b,c,"ARMSUM3 ");
  if(frz==0){ c=o_app(b,c,"LIVE "); }
  if(frz==1){ c=o_app(b,c,"FROZEN "); }
  c=fq_kv(b,c,"orc",orc); c=o_app(b,c," ");
  c=fq_kv(b,c,"orcN",7); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGA",okGA); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGB",okGB); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGC",okGC); c=o_app(b,c," ");
  c=fq_kv(b,c,"okDpA",okDpA); c=o_app(b,c," ");
  c=fq_kv(b,c,"okEpA",okEpA); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGF",okGF); c=o_app(b,c," ");
  c=fq_kv(b,c,"okG3",okG3); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGH",okGH); c=o_app(b,c," ");
  c=fq_kv(b,c,"okIpA",okIpA); c=o_app(b,c," ");
  c=fq_kv(b,c,"okGIJ",okGIJ); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3lifetime",bLT); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3lifetimeCost",ltx); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3fresh0",bF0); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3freshArena",bFA); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3freshF",bFs); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3recency",bRC); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3nostruct",aST); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3snapstale",aSN); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3snapctrl",aCT); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactA",nA); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactC",nC); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactF",nF); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactA_COV",nAc); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactC_COV",nCc); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3noFactF_COV",nFc); c=o_app(b,c," ");
  c=fq_kv(b,c,"ckeq_bad",ckeq); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk4_bad",lk4bad); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk1pre",lk1preT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk1post",lk1postT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk2pre",lk2preT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk2post",lk2postT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk7arena",lk7aT); c=o_app(b,c," ");
  c=fq_kv(b,c,"lk7mem",lk7mT); c=o_app(b,c," ");
  c=fq_kv(b,c,"eps",eps); c=o_app(b,c," ");
  c=fq_kv(b,c,"arena",get32(A,0)); c=o_app(b,c," ");
  c=fq_kv(b,c,"memL",lt_cells(L,16384)); c=o_app(b,c," ");
  c=fq_kv(b,c,"memLT",lt_cells(LT,8192)); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3freshArenaCost",fax); c=o_app(b,c," ");
  c=fq_kv(b,c,"j3snapctrlCost",ctx);
  c=o_nl(b,c);
  c=fq_evt(b,c,LT,"arm");
  return c;
}

// ---------------- LK3 no-episode control: 960 episodes, arena never written ----
fn nfe3(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let GJ:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  set32(LT,68,1);
  set32(LT,100,9);
  let nfe:i32=0;
  let s:i32=0;
  while(s<10){
    frz_stage_into(AS,s);
    let nf:i32=frz_nfact(s);
    let k:i32=0;
    while(k<nf){
      frz_episode(L,LT,A,AS,K,k,0,RB,CB,TO,SE);
      k=k+1;
    }
    if(s==9){
      mkLT3_goal(5,GJ);
      ltLT3_decl(5,DE);
      let cd:i32=lt_query(L,LT,A,GJ,K,R,AN);
      let ok:i32=lt_score(DE,AN,cd);
      if(ok==1){ nfe=nfe+1; }
    }
    s=s+1;
  }
  c=o_app(b,c,"LK3 nfe_ok=");
  c=o_i64(b,c,nfe as i64);
  c=o_app(b,c," arena=");
  c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," memL=");
  c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT=");
  c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_nl(b,c);
  return c;
}

fn main() i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  let S:[]u8=z_alloc(16384);
  ss(S,2002,2); ss(S,2003,1); ss(S,2004,0);
  ss(S,2005,0); ss(S,2006,1); ss(S,2007,0);
  ss(S,2008,10); ss(S,2009,1);
  let ok1:i32=u_check(S,2000,2,5,7,0,0,0,0);
  ss(S,2008,3);
  let ok2:i32=u_check(S,2000,2,5,7,0,0,0,0);
  c=o_app(b,c,"CONTRACT-SELFTEST pass_in=");
  c=o_i64(b,c,ok1 as i64);
  c=o_app(b,c," pass_out=");
  c=o_i64(b,c,ok2 as i64);
  c=o_nl(b,c);
  let CS:[]u8=z_alloc(164096);
  c=arm3(0,b,c,CS);
  c=arm3(1,b,c,CS);
  c=nfe3(b,c);
  lt_flush(b,c);
  return 0;
}
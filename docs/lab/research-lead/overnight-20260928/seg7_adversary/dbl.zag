// seg7_learn.zag - H-SEG7: segmentation with widened exact-count budget
// and loud budget-overflow signal.
// Algorithm SEG-LEX-G (frozen in PREREG_SEG7.md):
//   = SEG-LEX-F (PREREG_SEG6.md) plus:
//   64 base-1e9 big-integer digits (T_n < 1e576, was 32 digits /
//   T_n < 1e288); the big-int add reports carry out of the top
//   digit, OR-accumulated into ovf; when ovf==1 the label marks the
//   printed count TRUNCATED-BUDGET-EXCEEDED and emits a loud
//   SAT-BUDGET-OVERFLOW line instead of failing silently. When
//   ovf==0 the printed count is exactly T_n. The H-SEG5/H-SEG6
//   proofs are unaffected (nopt/sat logic unchanged); the new code
//   only reads dp/nopt/sat.
// New fixtures (test-only): SG7 ADD-UNIT (bigint_add_of carry
// checks), SG7-BIG ("ab" x 958, exact under the widened budget),
// SG7-OVF ("ab" x 1915, exercises the loud overflow signal).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn emit_padded9(v:i32)void {
  let div:i32=100000000;
  let i:i32=0;
  while(i<9){
    let dg:i32=v/div;
    emit(i32s(dg));
    v=v-dg*div;
    div=div/10;
    i=i+1;
  }
  return;
}
// bigint_print: emit decimal representation (no leading zeros).
fn bigint_print(d:[]u8, doff:i32, nd:i32)void {
  let ms:i32=0;
  let i:i32=0;
  while(i<nd){
    if(get32(d,(doff+i)*4)!=0){ ms=i; }
    i=i+1;
  }
  emit(i32s(get32(d,(doff+ms)*4)));
  i=ms-1;
  while(i>=0){
    emit_padded9(get32(d,(doff+i)*4));
    i=i-1;
  }
  return;
}

// ---- DP with move lists ----
// ---- independent repeated-doubling anchor (no DP, no corpus) ----
fn dbl(d:[]u8, nd:i32)void {
  let carry:i32=0;
  let i:i32=0;
  while(i<nd){
    let v:i32=get32(d,i*4)*2+carry;
    if(v>=1000000000){ set32(d,i*4,v-1000000000); carry=1; }
    else { set32(d,i*4,v); carry=0; }
    i=i+1;
  }
  return;
}
fn pow2(e:i32, tag:[]u8)void {
  let d:[]u8=z_alloc(128*4);
  set32(d,0,1);
  let i:i32=0;
  while(i<e){ dbl(d,128); i=i+1; }
  emit(tag); emit(" FULL ");
  bigint_print(d,0,128);
  emit("\n");
  emit(tag); emit(" RES576 ");
  bigint_print(d,0,64);
  emit("\n");
  let dc:i32=0;
  let j:i32=0;
  while(j<128){ if(get32(d,j*4)!=0){ dc=j+1; } j=j+1; }
  emit(tag); emit(" NDIGITS9 "); emit(i32s(dc)); emit("\n");
  return;
}
fn main()i32 {
  pow2(957,"P2E957");
  pow2(1913,"P2E1913");
  pow2(1914,"P2E1914");
  pow2(1915,"P2E1915");
  pow2(1999,"P2E1999");
  pow2(29,"P2E29");
  return 0;
}

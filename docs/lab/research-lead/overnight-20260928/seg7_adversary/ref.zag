// seg7_learn.zag - H-SEG7: segmentation with widened exact-count budget
// and loud budget-overflow signal.
// Algorithm SEG-LEX-G (frozen in PREREG_SEG7.md):
//   = SEG-LEX-F (PREREG_SEG6.md) plus:
//   64 base-1e9 big-integer digits (T_n < 1e576, was 32 digits /
//   T_n < 1e288); the big-int add reports carry out of the top
//   digit, OR-accumulated into ovf; when ovf==1 the label marks the
//   printed count TRUNCATED-BUDGET-EXCEEDED and emits a loud
//   SAT-BUDGET-OVERFLOW line instead of failing silently. When
//   ovf==0 the printed count is exactly T_n. The H-SEG5/H-SEG6
//   proofs are unaffected (nopt/sat logic unchanged); the new code
//   only reads dp/nopt/sat.
// New fixtures (test-only): SG7 ADD-UNIT (bigint_add_of carry
// checks), SG7-BIG ("ab" x 958, exact under the widened budget),
// SG7-OVF ("ab" x 1915, exercises the loud overflow signal).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn MAXL()i32 { return 5; }
fn MINC()i32 { return 2; }
fn FBPEN()i32 { return 20; }
// NOTE (H-SEG4): the fixed DPSENT() is removed. run_exp derives a
// per-run sentinel sent = -(FBPEN*n)-1 from the input length n,
// which is strictly below every reachable DP score (see header).
fn MAXCH()i32 { return 512; }
fn CHSZ()i32 { return 16; } // +0 len(i32), +4 count(i32), +8 bytes[5]
fn NDIGITS()i32 { return 64; } // H-SEG7: big-int base-1e9 digits (T_n < 1e576)

// ---- corpora (raw strings, no boundaries) ----
fn corpus_a(i:i32)[]u8 {
  if(i==0){return "bigredcube";}
  if(i==1){return "biggreenball";}
  if(i==2){return "smallredball";}
  return "smallgreencube";
}
fn test_a()[]u8 { return "smallgreenball"; }
fn test_c()[]u8 { return "smallredcube"; }
fn test_d()[]u8 { return "bigbluecube"; }
fn corpus_b(i:i32)[]u8 {
  if(i==0){return "zab";}
  if(i==1){return "abz";}
  if(i==2){return "zcde";}
  if(i==3){return "cdez";}
  if(i==4){return "zabc";}
  if(i==5){return "abcz";}
  if(i==6){return "zde";}
  return "dez";
}
fn test_b()[]u8 { return "abcde"; }
// ADV-1: 6 strings (SEG2-ADV frozen fixture)
fn corpus_adv1(i:i32)[]u8 {
  if(i==0){return "xabcd";}
  if(i==1){return "xabcd";}
  if(i==2){return "yabcd";}
  if(i==3){return "yabcd";}
  if(i==4){return "zabcd";}
  return "zabcd";
}
// ADV-2: ADV-1 plus "wabcd","wabcd" (8 strings)
fn corpus_adv2(i:i32)[]u8 {
  if(i<6){return corpus_adv1(i);}
  return "wabcd";
}
fn test_adv_t1()[]u8 { return "xabcd"; }
fn test_adv_t2()[]u8 { return "xabcdyabcd"; }
// H1: red-team X-SG3-2 fixture (SEG3_ADV_RESULT.md)
fn corpus_h1(i:i32)[]u8 {
  if(i==0){return "xab";}
  if(i==1){return "xab";}
  if(i==2){return "yab";}
  if(i==3){return "yab";}
  if(i==4){return "zabab";}
  if(i==5){return "zabab";}
  if(i==6){return "wabab";}
  return "wabab";
}
// corpus ids: 0=A, 1=B, 2=ADV-1, 3=ADV-2, 4=H1
fn corpus_nstr(cid:i32)i32 {
  if(cid==0){return 4;}
  if(cid==1){return 8;}
  if(cid==2){return 6;}
  if(cid==3){return 8;}
  return 8;
}
fn corpus_str(cid:i32, i:i32)[]u8 {
  if(cid==0){return corpus_a(i);}
  if(cid==1){return corpus_b(i);}
  if(cid==2){return corpus_adv1(i);}
  if(cid==3){return corpus_adv2(i);}
  return corpus_h1(i);
}

// ---- chunk table ----
fn ch_len(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()); }
fn ch_cnt(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()+4); }
fn ch_add_or_inc(cht:[]u8, nch:i32, s:[]u8, off:i32, l:i32)i32 {
  let k:i32=0;
  while(k<nch){
    if(ch_len(cht,k)==l){
      let m:i32=0;
      let eq:i32=1;
      while(m<l){ if(cht[k*CHSZ()+8+m]!=s[off+m]){eq=0;} m=m+1; }
      if(eq==1){
        set32(cht, k*CHSZ()+4, ch_cnt(cht,k)+1);
        return nch;
      }
    }
    k=k+1;
  }
  if(nch<MAXCH()){
    let bo:i32=nch*CHSZ();
    set32(cht, bo, l);
    set32(cht, bo+4, 1);
    let m:i32=0;
    while(m<l){ cht[bo+8+m]=s[off+m]; m=m+1; }
    return nch+1;
  }
  return nch;
}
fn train_seq(cht:[]u8, nch:i32, s:[]u8)i32 {
  let n:i32=s.len;
  let i:i32=0;
  while(i<n){
    let l:i32=2;
    while(l<=MAXL()){
      if(i+l<=n){ nch=ch_add_or_inc(cht,nch,s,i,l); }
      l=l+1;
    }
    i=i+1;
  }
  return nch;
}
fn train_corpus(cht:[]u8, cid:i32)i32 {
  let nch:i32=0;
  let ns:i32=corpus_nstr(cid);
  let i:i32=0;
  while(i<ns){ nch=train_seq(cht,nch,corpus_str(cid,i)); i=i+1; }
  return nch;
}
fn ch_match(cht:[]u8, k:i32, t:[]u8, pos:i32)i32 {
  let l:i32=ch_len(cht,k);
  let m:i32=0;
  while(m<l){ if(cht[k*CHSZ()+8+m]!=t[pos+m]){return 0;} m=m+1; }
  return 1;
}

// ---- Phase 1b: coverage discounting ----
// occ_covered: is the occurrence of chunk k at (s,p) strictly contained
// in an occurrence of a longer recurring chunk?
fn occ_covered(cht:[]u8, nch:i32, s:[]u8, n:i32, k:i32, p:i32)i32 {
  let lk:i32=ch_len(cht,k);
  let j:i32=0;
  while(j<nch){
    let lj:i32=ch_len(cht,j);
    if(lj>lk){
      if(ch_cnt(cht,j)>=MINC()){
        let q0:i32=p+lk-lj;
        if(q0<0){q0=0;}
        let q1:i32=p;
        let qmax:i32=n-lj;
        if(q1>qmax){q1=qmax;}
        let q:i32=q0;
        while(q<=q1){
          if(ch_match(cht,j,s,q)==1){
            if(q+lj>=p+lk){return 1;}
          }
          q=q+1;
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// compute_uncovered: unc[k] = occurrences of chunk k not covered.
fn compute_uncovered(cht:[]u8, nch:i32, cid:i32, unc:[]u8)void {
  let ns:i32=corpus_nstr(cid);
  let k:i32=0;
  while(k<nch){
    let u:i32=0;
    let lk:i32=ch_len(cht,k);
    let si:i32=0;
    while(si<ns){
      let s:[]u8=corpus_str(cid,si);
      let n:i32=s.len;
      let p:i32=0;
      while(p+lk<=n){
        if(ch_match(cht,k,s,p)==1){
          if(occ_covered(cht,nch,s,n,k,p)==0){u=u+1;}
        }
        p=p+1;
      }
      si=si+1;
    }
    set32(unc,k*4,u);
    k=k+1;
  }
  return;
}
// discounted score: uncovered count * len^2
fn ch_uscore(cht:[]u8, unc:[]u8, k:i32)i32 {
  let u:i32=get32(unc,k*4);
  let l:i32=ch_len(cht,k);
  return u*l*l;
}

// ---- H-SEG7: big-integer utilities (base 1e9, little-endian i32 digits) ----
// bigint_add: d[doff..doff+nd) += s[soff..soff+nd), carry propagated.
fn bigint_add(d:[]u8, doff:i32, s:[]u8, soff:i32, nd:i32)void {
  let carry:i32=0;
  let i:i32=0;
  while(i<nd){
    let v:i32=get32(d,(doff+i)*4)+get32(s,(soff+i)*4)+carry;
    if(v>=1000000000){ set32(d,(doff+i)*4,v-1000000000); carry=1; }
    else { set32(d,(doff+i)*4,v); carry=0; }
    i=i+1;
  }
  return;
}
// bigint_add_of: like bigint_add but returns the final carry out of
// the top digit (0 or 1). A return of 1 means the true sum met or
// exceeded the nd-digit budget and the stored result is truncated
// to the sum mod 1e9^nd.
fn bigint_add_of(d:[]u8, doff:i32, s:[]u8, soff:i32, nd:i32)i32 {
  let carry:i32=0;
  let i:i32=0;
  while(i<nd){
    let v:i32=get32(d,(doff+i)*4)+get32(s,(soff+i)*4)+carry;
    if(v>=1000000000){ set32(d,(doff+i)*4,v-1000000000); carry=1; }
    else { set32(d,(doff+i)*4,v); carry=0; }
    i=i+1;
  }
  return carry;
}
// emit_padded9: emit v (0 <= v < 1e9) as exactly 9 decimal digits.
fn emit_padded9(v:i32)void {
  let div:i32=100000000;
  let i:i32=0;
  while(i<9){
    let dg:i32=v/div;
    emit(i32s(dg));
    v=v-dg*div;
    div=div/10;
    i=i+1;
  }
  return;
}
// bigint_print: emit decimal representation (no leading zeros).
fn bigint_print(d:[]u8, doff:i32, nd:i32)void {
  let ms:i32=0;
  let i:i32=0;
  while(i<nd){
    if(get32(d,(doff+i)*4)!=0){ ms=i; }
    i=i+1;
  }
  emit(i32s(get32(d,(doff+ms)*4)));
  i=ms-1;
  while(i>=0){
    emit_padded9(get32(d,(doff+i)*4));
    i=i-1;
  }
  return;
}

// ---- DP with move lists ----
fn mv_add(mvc:[]u8, mvj:[]u8, mvl:[]u8, pos:i32, j:i32, l:i32, reset:i32)void {
  if(reset==1){
    set32(mvc,pos*4,1);
    set32(mvj,(pos*8)*4,j);
    set32(mvl,(pos*8)*4,l);
    return;
  }
  let c:i32=get32(mvc,pos*4);
  if(c<8){
    set32(mvj,(pos*8+c)*4,j);
    set32(mvl,(pos*8+c)*4,l);
    set32(mvc,pos*4,c+1);
  }
  return;
}
fn relax(dp:[]u8, nopt:[]u8, mvc:[]u8, mvj:[]u8, mvl:[]u8, n:i32, i:i32, l:i32, s:i32, dpi:i32, sat:[]u8)void {
  let np:i32=i+l;
  if(np>n){return;}
  let ns:i32=dpi+s;
  let cur:i32=get32(dp,np*4);
  if(ns>cur){
    set32(dp,np*4,ns);
    set32(nopt,np*4,get32(nopt,i*4));
    // H-SEG5: per-position saturation follows the new optimal pred set.
    set32(sat,np*4,get32(sat,i*4));
    mv_add(mvc,mvj,mvl,np,i,l,1);
  } else {
    if(ns==cur){
      let v:i32=get32(nopt,np*4)+get32(nopt,i*4);
      // H-SEG5: saturation propagates only along optimal predecessors.
      if(get32(sat,i*4)==1){ set32(sat,np*4,1); }
      if(v>999){v=999; set32(sat,np*4,1);}
      set32(nopt,np*4,v);
      mv_add(mvc,mvj,mvl,np,i,l,0);
    }
  }
  return;
}

// Reconstruct the single best path (first optimal move at each step).
// Stacks sized by n: a path has at most n moves (each advances >= 1).
fn build_best(t:[]u8, n:i32, mvj:[]u8, mvl:[]u8, buf:[]u8)i32 {
  let stj:[]u8=z_alloc((n+1)*4);
  let stl:[]u8=z_alloc((n+1)*4);
  let d:i32=0;
  let i:i32=n;
  while(i>0){
    let j:i32=get32(mvj,(i*8)*4);
    let l:i32=get32(mvl,(i*8)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    d=d+1; i=j;
  }
  let p:i32=0;
  let k:i32=d-1;
  while(k>=0){
    let j:i32=get32(stj,k*4);
    let l:i32=get32(stl,k*4);
    if(p>0){ buf[p]=124 as u8; p=p+1; }
    let m:i32=0;
    while(m<l){ buf[p]=t[j+m]; p=p+1; m=m+1; }
    k=k-1;
  }
  return p;
}

// Enumerate tied optimal segmentations (backward recursion, cap 5).
// rs = result row stride in bytes (sized by n).
fn enum_bwd(t:[]u8, i:i32, mvc:[]u8, mvj:[]u8, mvl:[]u8,
             stj:[]u8, stl:[]u8, d:i32, res:[]u8, nr:i32, rs:i32)i32 {
  if(nr>=5){return nr;}
  if(i==0){
    let base:i32=nr*rs;
    let p:i32=0;
    let k:i32=d-1;
    while(k>=0){
      let j:i32=get32(stj,k*4);
      let l:i32=get32(stl,k*4);
      if(p>0){ res[base+4+p]=124 as u8; p=p+1; }
      let m:i32=0;
      while(m<l){ res[base+4+p]=t[j+m]; p=p+1; m=m+1; }
      k=k-1;
    }
    set32(res,base,p);
    return nr+1;
  }
  let mc:i32=get32(mvc,i*4);
  let m:i32=0;
  while(m<mc){
    let j:i32=get32(mvj,(i*8+m)*4);
    let l:i32=get32(mvl,(i*8+m)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    nr=enum_bwd(t,j,mvc,mvj,mvl,stj,stl,d+1,res,nr,rs);
    if(nr>=5){return nr;}
    m=m+1;
  }
  return nr;
}

fn dump_lexicon(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32)void {
  emit(tag); emit(" NCHUNKS "); emit(i32s(nch)); emit("\n");
  let k:i32=0;
  while(k<nch){
    if(ch_cnt(cht,k)>=MINC()){
      let l:i32=ch_len(cht,k);
      emit(tag); emit(" CHUNK ");
      let tmp:[]u8=z_alloc(8);
      let m:i32=0;
      while(m<l){ tmp[m]=cht[k*CHSZ()+8+m]; m=m+1; }
      emit(tmp[0..l]);
      emit(" len="); emit(i32s(l));
      emit(" count="); emit(i32s(ch_cnt(cht,k)));
      emit(" uncovered="); emit(i32s(get32(unc,k*4)));
      emit(" score="); emit(i32s(ch_uscore(cht,unc,k)));
      emit("\n");
    }
    k=k+1;
  }
  return;
}

fn run_exp(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32, t:[]u8)void {
  let n:i32=t.len;
  // H-SEG4: per-run sentinel. Every DP move scores >= -FBPEN
  // (fallback) or >= 0 (chunk), so any path ending at position i
  // scores >= -FBPEN*i >= -FBPEN*n > sent. A cell holding sent is
  // genuinely unreached, for every n.
  let sent:i32=0-FBPEN()*n-1;
  let dp:[]u8=z_alloc((n+1)*4);
  let nopt:[]u8=z_alloc((n+1)*4);
  let mvc:[]u8=z_alloc((n+1)*4);
  let mvj:[]u8=z_alloc((n+1)*8*4);
  let mvl:[]u8=z_alloc((n+1)*8*4);
  let sat:[]u8=z_alloc((n+1)*4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,sent); set32(nopt,i*4,0); set32(mvc,i*4,0); set32(sat,i*4,0); i=i+1; }
  set32(dp,0,0); set32(nopt,0,1);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>sent){
      relax(dp,nopt,mvc,mvj,mvl,n,i,1,0-FBPEN(),dpi,sat);
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              relax(dp,nopt,mvc,mvj,mvl,n,i,l,ch_uscore(cht,unc,k),dpi,sat);
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  dump_lexicon(tag, cht, unc, nch);
  // H-SEG7: on-demand exact count with overflow signaling. If
  // sat[n]==1, T_n > 999 (H-SEG5 proof); recompute T_n exactly with
  // big-integer arithmetic on the optimal-move subgraph. ovf is set
  // iff any accumulation dropped a carry out of the top digit.
  let bc:[]u8="";
  let ovf:i32=0;
  if(get32(sat,n*4)==1){
    bc=z_alloc((n+1)*NDIGITS()*4);
    set32(bc,0,1);
    let bi:i32=0;
    while(bi<n){
      let bdpi:i32=get32(dp,bi*4);
      if(bdpi>sent){
        let bnp:i32=bi+1;
        if(bdpi-FBPEN()==get32(dp,bnp*4)){
          if(bigint_add_of(bc,bnp*NDIGITS(),bc,bi*NDIGITS(),NDIGITS())==1){ ovf=1; }
        }
        let bk:i32=0;
        while(bk<nch){
          if(ch_cnt(cht,bk)>=MINC()){
            let bl:i32=ch_len(cht,bk);
            if(bi+bl<=n){
              if(ch_match(cht,bk,t,bi)==1){
                let bnp2:i32=bi+bl;
                if(bdpi+ch_uscore(cht,unc,bk)==get32(dp,bnp2*4)){
                  if(bigint_add_of(bc,bnp2*NDIGITS(),bc,bi*NDIGITS(),NDIGITS())==1){ ovf=1; }
                }
              }
            }
          }
          bk=bk+1;
        }
      }
      bi=bi+1;
    }
  }
  let bestscore:i32=get32(dp,n*4);
  let no:i32=get32(nopt,n*4);
  emit(tag); emit(" TEST "); emit(t); emit("\n");
  emit(tag); emit(" SCORE "); emit(i32s(bestscore));
  emit(" NOPT ");
  // H-SEG7: exact count recovery with loud overflow signal. If
  // sat[n]==1, print the exact T_n (not "999+"); if ovf==1, mark it
  // TRUNCATED-BUDGET-EXCEEDED and emit SAT-BUDGET-OVERFLOW. If
  // (no==999, sat[n]==0), T_n=999 exactly (H-SEG5 proof). If no<999,
  // T_n=no exactly.
  if(no==999){
    if(get32(sat,n*4)==1){
      bigint_print(bc,n*NDIGITS(),NDIGITS());
      if(ovf==1){ emit(" TRUNCATED-BUDGET-EXCEEDED"); }
    }
    else { emit(i32s(no)); }
  } else {
    emit(i32s(no));
  }
  emit("\n");
  if(ovf==1){ emit(tag); emit(" SAT-BUDGET-OVERFLOW: exact-count accumulation exceeded 64 base-1e9 digits; printed NOPT is T_n mod 1e576 (lower 576 digits exact)\n"); }
  if(no==1){
    let buf:[]u8=z_alloc(2*n+8);
    let bl:i32=build_best(t,n,mvj,mvl,buf);
    emit(tag); emit(" VERDICT SEGMENTED "); emit(buf[0..bl]); emit("\n");
  } else {
    emit(tag); emit(" VERDICT AMBIGUOUS\n");
    let rs:i32=2*n+16;
    let res:[]u8=z_alloc(5*rs);
    let stj:[]u8=z_alloc((n+1)*4);
    let stl:[]u8=z_alloc((n+1)*4);
    let nr:i32=enum_bwd(t,n,mvc,mvj,mvl,stj,stl,0,res,0,rs);
    emit(tag); emit(" NCAND "); emit(i32s(nr)); emit("\n");
    let r:i32=0;
    while(r<nr){
      let rl:i32=get32(res,r*rs);
      emit(tag); emit(" CAND "); emit(res[r*rs+4..r*rs+4+rl]); emit("\n");
      r=r+1;
    }
  }
  return;
}


// ---- H-SEG7 ADVERSARY REFERENCE MAIN ----
// Independent exact counter: 256 base-1e9 digits (budget
// 10^2304, far above any battery input). The big-add below is
// written independently from the mechanism's bigint_add_of
// (different loop shape). DP scores reuse the validated score
// logic; edge enumeration mirrors the mechanism (validated by
// the SEG6 red team); the NEW code under test is the 64-digit
// truncation + flag, which this reference checks exactly.
// Asserts no carry escapes the 256-digit budget.
// Pure Zag.
// bigadd256: d[doff..doff+256) += s[soff..soff+256). Independent
// implementation: explicit per-digit subtract loop, carry reset
// per digit.
fn bigadd256(d:[]u8, doff:i32, s:[]u8, soff:i32)void {
  let carry:i32=0;
  let i:i32=0;
  while(i<256){
    let dv:i32=get32(d,(doff+i)*4);
    let sv:i32=get32(s,(soff+i)*4);
    let v:i32=dv+sv+carry;
    carry=0;
    while(v>=1000000000){ v=v-1000000000; carry=1; }
    set32(d,(doff+i)*4,v);
    i=i+1;
  }
  if(carry==1){ emit("REF-OVERFLOW-256\n"); }
  return;
}
// ref_run: DP scores (forward, validated logic) + exact 256-digit
// count over optimal edges. Prints FULL exact decimal, RES =
// lower 64 digits (= count mod 10^576), EXPFLAG = 1 iff the true
// count >= 10^576 (any nonzero digit at index >= 64).
fn ref_run(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32, t:[]u8)void {
  let n:i32=t.len;
  let sent:i32=0-FBPEN()*n-1;
  let dp:[]u8=z_alloc((n+1)*4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,sent); i=i+1; }
  set32(dp,0,0);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>sent){
      let np:i32=i+1;
      let ns:i32=dpi-FBPEN();
      if(ns>get32(dp,np*4)){ set32(dp,np*4,ns); }
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              let np2:i32=i+l;
              let ns2:i32=dpi+ch_uscore(cht,unc,k);
              if(ns2>get32(dp,np2*4)){ set32(dp,np2*4,ns2); }
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  let acc:[]u8=z_alloc((n+1)*256*4);
  set32(acc,0,1);
  let bi:i32=0;
  while(bi<n){
    let bdpi:i32=get32(dp,bi*4);
    if(bdpi>sent){
      let bnp:i32=bi+1;
      if(bdpi-FBPEN()==get32(dp,bnp*4)){ bigadd256(acc,bnp*256,acc,bi*256); }
      let bk:i32=0;
      while(bk<nch){
        if(ch_cnt(cht,bk)>=MINC()){
          let bl:i32=ch_len(cht,bk);
          if(bi+bl<=n){
            if(ch_match(cht,bk,t,bi)==1){
              let bnp2:i32=bi+bl;
              if(bdpi+ch_uscore(cht,unc,bk)==get32(dp,bnp2*4)){ bigadd256(acc,bnp2*256,acc,bi*256); }
            }
          }
        }
        bk=bk+1;
      }
    }
    bi=bi+1;
  }
  let ef:i32=0;
  let di:i32=64;
  while(di<256){ if(get32(acc,(n*256+di)*4)!=0){ ef=1; } di=di+1; }
  emit("REF "); emit(tag); emit(" FULL ");
  bigint_print(acc,n*256,256);
  emit(" RES ");
  bigint_print(acc,n*256,64);
  emit(" EXPFLAG "); emit(i32s(ef)); emit("\n");
  return;
}
fn mkab2(buf:[]u8, k:i32)void {
  let r:i32=0;
  while(r<k){ buf[r*2]=97 as u8; buf[r*2+1]=98 as u8; r=r+1; }
  return;
}
fn main()i32 {
  emit("H-SEG7-REF START\n");
  let cth1:[]u8=z_alloc(MAXCH()*CHSZ());
  let nh1:i32=train_corpus(cth1,4);
  let unh1:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(cth1,nh1,4,unh1);
  let b1:[]u8=z_alloc(3829);
  mkab2(b1,1914);
  ref_run("B1", cth1, unh1, nh1, b1[0..3828]);
  let b2:[]u8=z_alloc(3831);
  mkab2(b2,1915);
  ref_run("B2", cth1, unh1, nh1, b2[0..3830]);
  let b3:[]u8=z_alloc(3833);
  mkab2(b3,1916);
  ref_run("B3", cth1, unh1, nh1, b3[0..3832]);
  let b4:[]u8=z_alloc(4001);
  mkab2(b4,2000);
  ref_run("B4", cth1, unh1, nh1, b4[0..4000]);
  let b5:[]u8=z_alloc(3830);
  mkab2(b5,1914);
  b5[3828]=113 as u8;
  ref_run("B5", cth1, unh1, nh1, b5[0..3829]);
  let b6:[]u8=z_alloc(1917);
  mkab2(b6,958);
  ref_run("B6", cth1, unh1, nh1, b6[0..1916]);
  let b7:[]u8=z_alloc(61);
  mkab2(b7,30);
  ref_run("B7", cth1, unh1, nh1, b7[0..60]);
  let p1:[]u8=z_alloc(4004);
  mkab2(p1,2000);
  p1[4000]=120 as u8; p1[4001]=97 as u8; p1[4002]=98 as u8;
  ref_run("P1", cth1, unh1, nh1, p1[0..4003]);
  let p2:[]u8=z_alloc(3832);
  mkab2(p2,1914);
  p2[3828]=120 as u8; p2[3829]=97 as u8; p2[3830]=98 as u8;
  ref_run("P2", cth1, unh1, nh1, p2[0..3831]);
  ref_run("S1", cth1, unh1, nh1, "xab");
  ref_run("S2", cth1, unh1, nh1, "yabzab");
  ref_run("S3", cth1, unh1, nh1, "wababxab");
  ref_run("S4", cth1, unh1, nh1, "zabzab");
  emit("H-SEG7-REF COMPLETE\n");
  return 0;
}

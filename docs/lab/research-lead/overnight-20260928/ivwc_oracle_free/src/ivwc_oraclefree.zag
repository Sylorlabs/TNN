// ivwc_oraclefree.zag -- verification with zero consequence observations.
// The learner NEVER observes any consequence (true or simulated on
// truth). Verdicts come only from beliefs + committed plans:
//   Arm A (internal-model consequence prediction): the learner steps
//   each committed plan through its OWN beliefs (belief_execute) and
//   verdicts PASS iff predicted eff >= its internal bar T_pred
//   (mean predicted eff over the sealed batch; learner-computed).
//   Arm B (re-derivation): two independent composers (reverse scan,
//   nearest-first) recompose from the same beliefs; gather-set
//   agreement is checked as a finding (near-vacuous: the gather set
//   is order-invariant for this composer family).
//   Ablation: Arm A verdicts recomputed on scrambled beliefs (same
//   marginals, mapping broken) test whether belief CONTENT drives
//   accuracy.
// Sealed worlds/beliefs/composer/seeds are verbatim copies of
// IVWC-EXPAND3, so sealed (bucket, eff) pairs are bit-identical to
// expand3's run1 (checked in shell, a finding not a bar).
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC-EXPAND3) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;

// ---------- helpers (u8-backed cells, little-endian; copied verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow).
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}

// ===== WORLD =====
// Verbatim copies from IVWC-EXPAND3 (world_gen, belief_gen, step
// physics, true-world stepper). The learner never calls these.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// True-world stepper. Called ONLY in the sealed SCORING block
// (harness), never by the learner. wc counts true executions.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// Everything in this section touches beliefs and plans only.
// No true-world array token appears below (checked by audit A7).
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only (verbatim expand3).
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Reverse-scan re-derivation: identical policy, opposite item order.
// Independent code path for the Arm B agreement check.
fn learner_compose_rev(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=CW-1;
  while(c>=0){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c-1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Nearest-first re-derivation: greedy policy, independent path.
// Repeatedly visits the nearest believed item whose believed
// interval from the current pos is clear. Deterministic
// (ties -> smaller cell). Flags hoisted, nesting shallow.
fn learner_compose_nn(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let taken:[]u8=z_alloc(CW);
  let pos:i32=get8(bb,boff+2*CW);
  let at:i32=0;
  let pcs:[]u8=z_alloc(12);
  let more:i32=1;
  while(more==1){
    let best:i32=-1;
    let bd:i32=1000000;
    let c:i32=0;
    while(c<CW){
      let tk:i32=get8(taken,c);
      let it:i32=get8(bb,boff+CW+c);
      let cand:i32=0;
      if(tk==0){ cand=1; }
      if(cand==1){
        if(it==0){ cand=0; }
      }
      if(cand==1){
        let lo:i32=pos;
        let hi:i32=c;
        if(lo>hi){
          let t:i32=lo;
          lo=hi;
          hi=t;
        }
        let blk:i32=lc_blocked(bb,boff,lo,hi);
        if(blk==0){
          let d:i32=pos-c;
          if(d<0){ d=0-d; }
          let better:i32=0;
          if(d<bd){ better=1; }
          if(better==0){
            if(d==bd){
              if(best<0){ better=1; }
              else {
                if(c<best){ better=1; }
              }
            }
          }
          if(better==1){ bd=d; best=c; }
        }
      }
      c=c+1;
    }
    if(best<0){ more=0; }
    else {
      set8(taken,best,1);
      set32(pcs,0,pos);
      set32(pcs,4,best);
      set32(pcs,8,at);
      lc_leg(pb,poff,at,pcs);
      pos=get32(pcs,0);
      at=get32(pcs,8);
    }
  }
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Internal-model consequence prediction: steps the committed plan
// through the BELIEVED corridor (same physics shape as the true
// stepper, but beliefs only). No true-consequence observation.
// cons cells: collected@0, energy@4, bumps@8, wasted@12, final@16,
// plan_len@20.
fn belief_execute(bbuf:[]u8, boff:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32)void {
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(bbuf,boff+2*CW));
  let i:i32=0;
  while(i<L){
    let oc:i32=w_step(bbuf,boff,got,st,get8(pb,poff+i));
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}
// Belief scrambler (ablation): independent Fisher-Yates on believed
// walls and believed items (fixed seed); marginals preserved,
// wall/item mapping to truth broken. Start cell kept open.
fn belief_scramble(bb:[]u8, boff:i32, sb:[]u8, soff:i32, seed:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<RECW){
    set8(sb,soff+c,get8(bb,boff+c));
    c=c+1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+c);
    set8(sb,soff+c,get8(sb,soff+j));
    set8(sb,soff+j,t);
    c=c-1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+CW+c);
    set8(sb,soff+CW+c,get8(sb,soff+CW+j));
    set8(sb,soff+CW+j,t);
    c=c-1;
  }
  let srt:i32=get8(bb,boff+2*CW);
  set8(sb,soff+srt,0);
  return;
}
// Extract gather cells from a plan (walk from start), insertion-sort
// them, return the count. Flat control flow (no deep nesting).
fn gather_cells(pb:[]u8, poff:i32, L:i32, start:i32, out:[]u8, ooff:i32)i32 {
  let pos:i32=start;
  let n:i32=0;
  let i:i32=0;
  while(i<L){
    let a:i32=get8(pb,poff+i);
    if(a==0){ pos=pos-1; }
    else {
      if(a==1){ pos=pos+1; }
      else {
        set8(out,ooff+n,pos);
        n=n+1;
      }
    }
    i=i+1;
  }
  let k:i32=1;
  while(k<n){
    let v:i32=get8(out,ooff+k);
    let j:i32=k-1;
    let go:i32=1;
    while(go==1){
      let stop:i32=0;
      if(j<0){ stop=1; }
      if(stop==0){
        if(get8(out,ooff+j)<=v){ stop=1; }
      }
      if(stop==1){ go=0; }
      else {
        set8(out,ooff+j+1,get8(out,ooff+j));
        j=j-1;
      }
    }
    set8(out,ooff+j+1,v);
    k=k+1;
  }
  return n;
}

// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCOF-BEGIN\n");
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let bscram:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let prseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let pnseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let mrseal:[]u8=z_alloc(NSEAL*RECM);
  let mnseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let ctmp:[]u8=z_alloc(RECC);
  let escr:[]u8=z_alloc(EREC);
  let wc:[]u8=z_alloc(4);
  let preff:[]u8=z_alloc(NSEAL*4);
  let prab:[]u8=z_alloc(NSEAL*4);
  let verA:[]u8=z_alloc(NSEAL*4);
  let verAb:[]u8=z_alloc(NSEAL*4);
  let agrR:[]u8=z_alloc(NSEAL*4);
  let agrN:[]u8=z_alloc(NSEAL*4);
  let plr:[]u8=z_alloc(NSEAL*4);
  let pln:[]u8=z_alloc(NSEAL*4);
  let errs:[]u8=z_alloc(NSEAL*4);
  let gsetA:[]u8=z_alloc(CW);
  let gsetR:[]u8=z_alloc(CW);
  let gsetN:[]u8=z_alloc(CW);
  let acc:[]u8=z_alloc(12);
  let maj:[]u8=z_alloc(12);
  let aab:[]u8=z_alloc(12);
  let tpr:[]u8=z_alloc(12);
  let k3n:[]u8=z_alloc(48);
  let fpe:[]u8=z_alloc(12);
  let fpn:[]u8=z_alloc(12);
  let tpe:[]u8=z_alloc(12);
  let tpn:[]u8=z_alloc(12);
  let k1:i32=1;
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    at=ob_app(ob,at,"SHIFT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," wp=");
    at=ob_i32(ob,at,wp);
    at=ob_nl(ob,at);
    // a. SEALED SETUP (harness; identical seeds to IVWC-EXPAND3).
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // b. VERDICT COMMIT (learner). Beliefs and plans only; the
    // true-world stepper is never called here (wc must not move).
    let wcb0:i32=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      let sL:i32=get32(mseal,s*RECM+4);
      belief_execute(bseal, s*RECW, pseal, s*PLANMAX, sL, ctmp, 0);
      let pc:i32=get32(ctmp,0);
      let pu:i32=get32(ctmp,4);
      let pe:i32=0;
      if(pu>0){ pe=(100*pc)/pu; }
      set32(preff,4*s,pe);
      learner_compose_rev(bseal, s*RECW, prseal, s*PLANMAX, mrseal, s*RECM);
      learner_compose_nn(bseal, s*RECW, pnseal, s*PLANMAX, mnseal, s*RECM);
      let srt:i32=get8(bseal,s*RECW+2*CW);
      let sLr:i32=get32(mrseal,s*RECM+4);
      let sLn:i32=get32(mnseal,s*RECM+4);
      let nA:i32=gather_cells(pseal,s*PLANMAX,sL,srt,gsetA,0);
      let nR:i32=gather_cells(prseal,s*PLANMAX,sLr,srt,gsetR,0);
      let nN:i32=gather_cells(pnseal,s*PLANMAX,sLn,srt,gsetN,0);
      let aR:i32=1;
      let aN:i32=1;
      if(nA!=nR){ aR=0; }
      if(nA!=nN){ aN=0; }
      let q:i32=0;
      while(q<nA){
        if(aR==1){
          if(get8(gsetA,q)!=get8(gsetR,q)){ aR=0; }
        }
        if(aN==1){
          if(get8(gsetA,q)!=get8(gsetN,q)){ aN=0; }
        }
        q=q+1;
      }
      set32(agrR,4*s,aR);
      set32(agrN,4*s,aN);
      set32(plr,4*s,sLr);
      set32(pln,4*s,sLn);
      // Ablation: same plan, scrambled beliefs -> scrambled prediction.
      belief_scramble(bseal, s*RECW, bscram, s*RECW, 777*s+3);
      belief_execute(bscram, s*RECW, pseal, s*PLANMAX, sL, ctmp, 0);
      let ac2:i32=get32(ctmp,0);
      let au2:i32=get32(ctmp,4);
      let ae:i32=0;
      if(au2>0){ ae=(100*ac2)/au2; }
      set32(prab,4*s,ae);
      s=s+1;
    }
    if(get32(wc,0)==wcb0){
      at=ob_app(ob,at,"K1S-STRUCT-PASS sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    } else {
      k1=0;
      at=ob_app(ob,at,"K1S-STRUCT-FAIL sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    }
    // Internal bar: mean predicted eff over the sealed batch.
    let totp:i32=0;
    s=0;
    while(s<NSEAL){
      totp=totp+get32(preff,4*s);
      s=s+1;
    }
    let Tpred:i32=totp/NSEAL;
    set32(tpr,4*sh,Tpred);
    s=0;
    while(s<NSEAL){
      let va:i32=0;
      if(get32(preff,4*s)>=Tpred){ va=1; }
      set32(verA,4*s,va);
      let vb2:i32=0;
      if(get32(prab,4*s)>=Tpred){ vb2=1; }
      set32(verAb,4*s,vb2);
      s=s+1;
    }
    // c. SCORING (harness). The single true-world pass; the learner
    // never observes it. Ground-truth labels live only here.
    let np:i32=0;
    let sp:i32=0;
    let nf:i32=0;
    let sf:i32=0;
    let accn:i32=0;
    let ngen:i32=0;
    let accab:i32=0;
    let fp_e:i32=0;
    let fp_n:i32=0;
    let tp_e:i32=0;
    let tp_n:i32=0;
    let nag:i32=0;
    at=ob_app(ob,at,"V s bkt verA preff raw eff ge verX verAB agrR agrN err L Lr Ln\n");
    s=0;
    while(s<NSEAL){
      let sbk:i32=get32(mseal,s*RECM+12);
      let sL2:i32=get32(mseal,s*RECM+4);
      let raw:i32=get32(mseal,s*RECM+8);
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL2, cseal, s*RECC, escr, 0, wc);
      let sc2:i32=get32(cseal,s*RECC);
      let su2:i32=get32(cseal,s*RECC+4);
      let seff:i32=0;
      if(su2>0){ seff=(100*sc2)/su2; }
      let ge:i32=0;
      if(seff>=Tpred){ ge=1; }
      let va2:i32=get32(verA,4*s);
      if(va2==1){ np=np+1; sp=sp+seff; }
      else { nf=nf+1; sf=sf+seff; }
      if(va2==ge){ accn=accn+1; }
      if(ge==1){ ngen=ngen+1; }
      if(get32(verAb,4*s)==ge){ accab=accab+1; }
      let vx:i32=0;
      if(sbk==1){ vx=1; }
      if(vx==va2){ nag=nag+1; }
      let er:i32=0;
      let cc:i32=0;
      while(cc<CW){
        if(get8(bseal,s*RECW+cc)!=get8(wseal,s*RECW+cc)){ er=er+1; }
        if(get8(bseal,s*RECW+CW+cc)!=get8(wseal,s*RECW+CW+cc)){ er=er+1; }
        cc=cc+1;
      }
      set32(errs,4*s,er);
      if(sh==0){
        if(va2==1){
          if(ge==1){ tp_e=tp_e+er; tp_n=tp_n+1; }
          else { fp_e=fp_e+er; fp_n=fp_n+1; }
        }
      }
      at=ob_app(ob,at,"V s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,sbk);
      at=ob_app(ob,at," verA=");
      at=ob_i32(ob,at,va2);
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*s));
      at=ob_app(ob,at," raw=");
      at=ob_i32(ob,at,raw);
      at=ob_app(ob,at," eff=");
      at=ob_i32(ob,at,seff);
      at=ob_app(ob,at," ge=");
      at=ob_i32(ob,at,ge);
      at=ob_app(ob,at," verX=");
      at=ob_i32(ob,at,vx);
      at=ob_app(ob,at," verAB=");
      at=ob_i32(ob,at,get32(verAb,4*s));
      at=ob_app(ob,at," agrR=");
      at=ob_i32(ob,at,get32(agrR,4*s));
      at=ob_app(ob,at," agrN=");
      at=ob_i32(ob,at,get32(agrN,4*s));
      at=ob_app(ob,at," err=");
      at=ob_i32(ob,at,er);
      at=ob_app(ob,at," L=");
      at=ob_i32(ob,at,sL2);
      at=ob_app(ob,at," Lr=");
      at=ob_i32(ob,at,get32(plr,4*s));
      at=ob_app(ob,at," Ln=");
      at=ob_i32(ob,at,get32(pln,4*s));
      at=ob_nl(ob,at);
      s=s+1;
    }
    let majn:i32=ngen;
    if(NSEAL-ngen>ngen){ majn=NSEAL-ngen; }
    set32(acc,4*sh,accn);
    set32(maj,4*sh,majn);
    set32(aab,4*sh,accab);
    set32(k3n,16*sh,np);
    set32(k3n,16*sh+4,sp);
    set32(k3n,16*sh+8,nf);
    set32(k3n,16*sh+12,sf);
    at=ob_app(ob,at,"VSUM sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," np=");
    at=ob_i32(ob,at,np);
    at=ob_app(ob,at," sp=");
    at=ob_i32(ob,at,sp);
    at=ob_app(ob,at," nf=");
    at=ob_i32(ob,at,nf);
    at=ob_app(ob,at," sf=");
    at=ob_i32(ob,at,sf);
    at=ob_app(ob,at," acc=");
    at=ob_i32(ob,at,accn);
    at=ob_app(ob,at," maj=");
    at=ob_i32(ob,at,majn);
    at=ob_app(ob,at," accab=");
    at=ob_i32(ob,at,accab);
    at=ob_app(ob,at," tpred=");
    at=ob_i32(ob,at,Tpred);
    at=ob_app(ob,at," nag=");
    at=ob_i32(ob,at,nag);
    at=ob_app(ob,at," fpe=");
    at=ob_i32(ob,at,fp_e);
    at=ob_app(ob,at," fpn=");
    at=ob_i32(ob,at,fp_n);
    at=ob_app(ob,at," tpe=");
    at=ob_i32(ob,at,tp_e);
    at=ob_app(ob,at," tpn=");
    at=ob_i32(ob,at,tp_n);
    at=ob_nl(ob,at);
    // stash nf/sf for K3 (kept per shift in k3n: np@0 sp@4 nf@8 sf@12)
    set32(fpe,4*sh,fp_e);
    set32(fpn,4*sh,fp_n);
    set32(tpe,4*sh,tp_e);
    set32(tpn,4*sh,tp_n);
    sh=sh+1;
  }
  // Phase: kill-bar verdicts (provisional; K2/K5 by shell audit).
  let k3:i32=0;
  let np0:i32=get32(k3n,0);
  let sp0:i32=get32(k3n,4);
  let nf0:i32=get32(k3n,8);
  let sf0:i32=get32(k3n,12);
  if(np0>0){
    if(nf0>0){
      if(sp0*nf0 > sf0*np0){ k3=1; }
    }
  }
  if(k3==1){ at=ob_app(ob,at,"K3-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K3-PROV-FAIL\n"); }
  let acc0:i32=get32(acc,0);
  let maj0:i32=get32(maj,0);
  let acc2:i32=get32(acc,8);
  let maj2:i32=get32(maj,8);
  let k4:i32=0;
  if(acc0>maj0){ k4=1; }
  if(k4==1){ at=ob_app(ob,at,"K4-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K4-PROV-FAIL\n"); }
  let k6:i32=0;
  if(get32(aab,0)<acc0){ k6=1; }
  if(k6==1){ at=ob_app(ob,at,"K6-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K6-PROV-FAIL\n"); }
  let k7:i32=0;
  if(acc2-maj2 < acc0-maj0){ k7=1; }
  if(k7==1){ at=ob_app(ob,at,"K7-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K7-PROV-FAIL\n"); }
  let k8:i32=0;
  let fpn0:i32=get32(fpn,0);
  let tpn0:i32=get32(tpn,0);
  if(fpn0>0){
    if(tpn0>0){
      if(get32(fpe,0)*tpn0 > get32(tpe,0)*fpn0){ k8=1; }
    }
  }
  if(k8==1){ at=ob_app(ob,at,"K8-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K8-PROV-FAIL\n"); }
  if(k1==1){ at=ob_app(ob,at,"K1-PROV-PASS\n"); }
  else { at=ob_app(ob,at,"K1-PROV-FAIL\n"); }
  at=ob_app(ob,at,"K2-AUDIT-SHELL K5-AUDIT-SHELL\n");
  at=ob_app(ob,at,"FLAGS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"WC-FINAL=");
  at=ob_i32(ob,at,get32(wc,0));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCOF-END\n");
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// mem_learn.zag — H-MEM: memory strategy invention test.
// Fifth frontier: can the learner develop its own memory management strategy
// under store pressure, instead of using a hardcoded one?
//
// Design (prereg PREREG_MEM.md, frozen before implementation):
//   - 8-slot procedure store with generic per-slot experience statistics:
//     use_count (queries served), last_q (most recent query seq, 0 = never).
//   - Candidate eviction policies (authored menu): LFU, LRU, FIFO, LIFO, RANDOM.
//   - Replay cost: recent-window (last 20) queries that would miss the victim.
//   - Selection: argmin cost; tie-break order LFU, LRU, FIFO, LIFO, RANDOM.
//   - Two frozen streams: A (stable popularity -> expect LFU),
//     B (shifting popularity -> expect LRU).
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- store layout: 8 slots x 24 bytes ----
// +0 used, +4 proc_id, +8 use_count, +12 last_q, +16 store_seq
fn NSLOT()i32 { return 8; }
fn SLOT_SZ()i32 { return 24; }
fn WIN()i32 { return 20; }
fn slot_off(s:i32)i32 { return s*SLOT_SZ(); }
fn st_used(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)); }
fn st_pid(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+4); }
fn st_uses(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+8); }
fn st_lastq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+12); }
fn st_sseq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+16); }
fn st_set(W:[]u8, s:i32, used:i32, pid:i32, uses:i32, lastq:i32, sseq:i32)void {
  set32(W, slot_off(s), used);
  set32(W, slot_off(s)+4, pid);
  set32(W, slot_off(s)+8, uses);
  set32(W, slot_off(s)+12, lastq);
  set32(W, slot_off(s)+16, sseq);
  return;
}
// ST state: +0 nq (trace len), +4 seq (query seq counter), +8 sseq (store seq)
fn st_nq(ST:[]u8)i32 { return get32(ST, 0); }
fn st_seq(ST:[]u8)i32 { return get32(ST, 4); }
fn st_ss(ST:[]u8)i32 { return get32(ST, 8); }
fn st_set_nq(ST:[]u8, v:i32)void { set32(ST, 0, v); return; }
fn st_set_seq(ST:[]u8, v:i32)void { set32(ST, 4, v); return; }
fn st_set_ss(ST:[]u8, v:i32)void { set32(ST, 8, v); return; }

fn st_find(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==1){ if(st_pid(W,s)==pid){ return s; } }
    s=s+1;
  }
  return -1;
}
fn nstored(W:[]u8)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<NSLOT()){ if(st_used(W,s)==1){c=c+1;} s=s+1; }
  return c;
}
// First-fit learn. Returns slot or -1 if full.
fn st_learn(W:[]u8, ST:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==0){
      let ss:i32=st_ss(ST);
      st_set(W, s, 1, pid, 0, 0, ss);
      st_set_ss(ST, ss+1);
      return s;
    }
    s=s+1;
  }
  return -1;
}
// Query event: generic experience statistics update + trace record.
fn st_query(W:[]u8, ST:[]u8, Q:[]u8, pid:i32)void {
  let f:i32=st_find(W, pid);
  if(f>=0){
    let sq:i32=st_seq(ST)+1;
    st_set_seq(ST, sq);
    set32(W, slot_off(f)+8, st_uses(W,f)+1);
    set32(W, slot_off(f)+12, sq);
    let nq:i32=st_nq(ST);
    Q[nq]=pid as u8;
    st_set_nq(ST, nq+1);
  }
  return;
}
fn run_pairs(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, np:i32)void {
  let i:i32=0;
  while(i<np){
    let pid:i32=P[i*2] as i32;
    let cnt:i32=P[i*2+1] as i32;
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    i=i+1;
  }
  return;
}

// ---- candidate policies: 0=LFU 1=LRU 2=FIFO 3=LIFO 4=RANDOM ----
fn pol_name(p:i32)[]u8 {
  if(p==0){return "LFU";}
  if(p==1){return "LRU";}
  if(p==2){return "FIFO";}
  if(p==3){return "LIFO";}
  return "RANDOM";
}
// victim: which slot this policy would evict. ev = pressure event number.
fn victim(W:[]u8, pol:i32, ev:i32)i32 {
  let best:i32=-1;
  let s:i32=0;
  if(pol==4){
    // deterministic "random": kth stored slot in slot order
    let ns:i32=nstored(W);
    let k:i32=((ev*7+3)%ns+ns)%ns;
    let c:i32=0;
    s=0;
    while(s<NSLOT()){
      if(st_used(W,s)==1){ if(c==k){return s;} c=c+1; }
      s=s+1;
    }
    return -1;
  }
  while(s<NSLOT()){
    if(st_used(W,s)==1){
      if(best<0){ best=s; }
      else {
        if(pol==0){ if(st_uses(W,s)<st_uses(W,best)){best=s;} }
        if(pol==1){ if(st_lastq(W,s)<st_lastq(W,best)){best=s;} }
        if(pol==2){ if(st_sseq(W,s)<st_sseq(W,best)){best=s;} }
        if(pol==3){ if(st_sseq(W,s)>st_sseq(W,best)){best=s;} }
      }
    }
    s=s+1;
  }
  return best;
}
// replay cost: recent-window queries hitting the victim's proc
fn replay_cost(W:[]u8, Q:[]u8, ST:[]u8, v:i32)i32 {
  if(v<0){return 999999;}
  let pid:i32=st_pid(W,v);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-WIN();
  if(lo<0){lo=0;}
  let c:i32=0;
  let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+1;} i=i+1; }
  return c;
}
// selection with disclosed tie-break order 0,1,2,3,4. Prints the trace.
fn select_pol(W:[]u8, Q:[]u8, ST:[]u8, ev:i32)i32 {
  emit("  candidates:\n");
  let p:i32=0;
  let bestp:i32=0;
  let bestc:i32=999999;
  while(p<5){
    let v:i32=victim(W,p,ev);
    let c:i32=replay_cost(W,Q,ST,v);
    emit("    ");
    emit(pol_name(p));
    emit(" victim=slot");
    emit(i32s(v));
    emit("(proc");
    emit(i32s(st_pid(W,v)));
    emit(") cost=");
    emit(i32s(c));
    emit("\n");
    if(c<bestc){bestc=c;bestp=p;}
    p=p+1;
  }
  emit("  selected: ");
  emit(pol_name(bestp));
  emit(" cost=");
  emit(i32s(bestc));
  emit("\n");
  return bestp;
}
fn pressure(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, newpid:i32)i32 {
  emit("pressure event ");
  emit(i32s(ev));
  emit(" (learn proc");
  emit(i32s(newpid));
  emit(", store full):\n");
  let sel:i32=select_pol(W,Q,ST,ev);
  let v:i32=victim(W,sel,ev);
  emit("  evict slot");
  emit(i32s(v));
  emit(" proc");
  emit(i32s(st_pid(W,v)));
  emit(" uses=");
  emit(i32s(st_uses(W,v)));
  emit(" lastq=");
  emit(i32s(st_lastq(W,v)));
  emit("\n");
  st_set(W, v, 0, -1, 0, 0, 0);
  let s2:i32=st_learn(W, ST, newpid);
  emit("  stored proc");
  emit(i32s(newpid));
  emit(" at slot");
  emit(i32s(s2));
  emit("\n");
  return sel;
}
fn has_proc(W:[]u8, pid:i32)i32 { return st_find(W,pid)>=0; }
fn store_init(W:[]u8, ST:[]u8)void {
  let s:i32=0;
  while(s<NSLOT()){ st_set(W,s,0,-1,0,0,0); s=s+1; }
  st_set_nq(ST,0); st_set_seq(ST,0); st_set_ss(ST,0);
  return;
}
fn learn_stream(W:[]u8, ST:[]u8, base:i32, n:i32)void {
  let i:i32=0;
  while(i<n){ st_learn(W, ST, base+i); i=i+1; }
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(NSLOT()*SLOT_SZ());
  let ST:[]u8=z_alloc(12);
  let Q:[]u8=z_alloc(256);
  let pass:i32=1;

  // ================= STREAM A =================
  emit("=== STREAM A (stable popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  // early queries
  let EA:[]u8=z_alloc(16);
  EA[0]=0;EA[1]=14; EA[2]=1;EA[3]=10; EA[4]=2;EA[5]=7; EA[6]=3;EA[7]=5;
  EA[8]=4;EA[9]=4; EA[10]=5;EA[11]=2; EA[12]=6;EA[13]=4; EA[14]=7;EA[15]=2;
  run_pairs(W, ST, Q, EA, 8);
  // recent window: last 20 queries
  let WA:[]u8=z_alloc(16);
  WA[0]=6;WA[1]=5; WA[2]=0;WA[3]=3; WA[4]=1;WA[5]=3; WA[6]=2;WA[7]=2;
  WA[8]=3;WA[9]=2; WA[10]=4;WA[11]=2; WA[12]=5;WA[13]=1; WA[14]=7;WA[15]=2;
  run_pairs(W, ST, Q, WA, 8);
  emit("stream A: 68 queries, window = last 20\n");
  let selA:i32=pressure(W,Q,ST,0,8);
  // first-fit re-store: evicted slot5 now holds proc8, proc5 is gone
  let vicA_ok:i32=0;
  if(st_pid(W,5)==8){ if(has_proc(W,5)==0){ vicA_ok=1; } }
  pressure(W,Q,ST,1,9);
  pressure(W,Q,ST,2,10);
  pressure(W,Q,ST,3,11);
  emit("stream A final store procs:");
  let s:i32=0;
  while(s<NSLOT()){ emit(" "); emit(i32s(st_pid(W,s))); s=s+1; }
  emit("\n");
  // K-M1 A: first victim slot5 (not slot0), selected cost < FIFO cost
  // (checked via select trace: LFU cost 1 < FIFO cost 3)
  if(selA!=0){ emit("K-M1a FAIL: expected LFU(0) selected, got "); emit(pol_name(selA)); emit("\n"); pass=0; }
  else {
    if(vicA_ok==0){ emit("K-M1a FAIL: first victim was not slot5/proc5\n"); pass=0; }
    else { emit("K-M1a PASS: stream A selected LFU, first victim slot5 (proc5)\n"); }
  }
  // K-M3a: procs 0..4 survive
  let k3a:i32=1;
  if(has_proc(W,0)==0){k3a=0;} if(has_proc(W,1)==0){k3a=0;}
  if(has_proc(W,2)==0){k3a=0;} if(has_proc(W,3)==0){k3a=0;}
  if(has_proc(W,4)==0){k3a=0;}
  if(k3a==0){ emit("K-M3a FAIL: hot procs 0..4 not all retained\n"); pass=0; }
  else { emit("K-M3a PASS: procs 0..4 all retained after 4 pressures\n"); }

  // ================= STREAM B =================
  emit("=== STREAM B (shifting popularity) ===\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let P1:[]u8=z_alloc(2);
  P1[0]=3; P1[1]=40;
  run_pairs(W, ST, Q, P1, 1);
  let P2:[]u8=z_alloc(14);
  P2[0]=6;P2[1]=6; P2[2]=2;P2[3]=6; P2[4]=4;P2[5]=6; P2[6]=5;P2[7]=6;
  P2[8]=7;P2[9]=6; P2[10]=1;P2[11]=6; P2[12]=0;P2[13]=10;
  run_pairs(W, ST, Q, P2, 7);
  emit("stream B: 86 queries, window = last 20\n");
  let selB:i32=pressure(W,Q,ST,0,8);
  // first-fit re-store: evicted slot3 now holds proc8, proc3 is gone
  let vicB_ok:i32=0;
  if(st_pid(W,3)==8){ if(has_proc(W,3)==0){ vicB_ok=1; } }
  pressure(W,Q,ST,1,9);
  pressure(W,Q,ST,2,10);
  pressure(W,Q,ST,3,11);
  emit("stream B final store procs:");
  s=0;
  while(s<NSLOT()){ emit(" "); emit(i32s(st_pid(W,s))); s=s+1; }
  emit("\n");
  if(selB!=1){ emit("K-M1b FAIL: expected LRU(1) selected, got "); emit(pol_name(selB)); emit("\n"); pass=0; }
  else {
    if(vicB_ok==0){ emit("K-M1b FAIL: first victim was not slot3/proc3\n"); pass=0; }
    else { emit("K-M1b PASS: stream B selected LRU, first victim slot3 (proc3)\n"); }
  }
  // K-M3b: proc3 evicted despite 40 uses; proc0 retained
  if(has_proc(W,3)==1){ emit("K-M3b FAIL: stale proc3 still stored\n"); pass=0; }
  else {
    if(has_proc(W,0)==0){ emit("K-M3b FAIL: recent proc0 lost\n"); pass=0; }
    else { emit("K-M3b PASS: stale proc3 evicted first, recent proc0 retained\n"); }
  }

  // K-M5: data-dependent selection
  if(selA==selB){ emit("K-M5 FAIL: same policy on both streams\n"); pass=0; }
  else { emit("K-M5 PASS: stream A -> "); emit(pol_name(selA)); emit(", stream B -> "); emit(pol_name(selB)); emit("\n"); }

  // K-M2 is satisfied by the printed candidate traces above (inspectable).
  emit("K-M2 PASS: per-event candidate/cost/winner/victim traces printed above\n");

  if(pass==1){ emit("ALL BARS PASS\n"); return 0; }
  emit("SOME BAR FAILED\n");
  return 1;
}

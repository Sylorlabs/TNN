// PHASE 17 -- is counting's dominance an artifact of candidate size?
// Prereg: count17/PREREG.md. Supersedes count16/ as evidence of learned
// selection (its SIG_B used a researcher-authored bucket router).
//
// DESIGN: 625 contexts (4 facts x 5 values). Candidates are AFFINE MAPS
// f(x)=a*x+b, index k=(a-1)*V+b so k -> (a,b) is invertible and opaque.
// Ground truth for context c is candidate TGT[c] = c%N -- balanced by
// construction, so global frequency carries NO signal (every candidate is
// correct on C/N or ceil(C/N) contexts).
//
// LEARNED gets NO context router and NO bucket index. It sees only integer
// behaviour traces: for each candidate k, its output on each probe context.
// It induces the context->candidate association itself by nearest-trace
// matching. No researcher-authored feature exists in this arm.
//
// OUTPUT CONTRACT (per prereg req 8/9): raw per-candidate counts, per-query
// chosen candidate and ground truth. NO *_ok flags, NO aggregate success bars.
// An independent scorer computes every verdict from this text.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn V()i32 { return 5; }
fn NF()i32 { return 4; }
fn C()i32 { return 625; }          // V^NF
fn PROBE_N()i32 { return 8; }      // behaviour-trace probes per candidate

// candidate k -> affine params (opaque integer decoding, no semantic naming)
fn cand_a(k:i32)i32 { return (k/V)+1; }
fn cand_b(k:i32)i32 { return k%V; }
fn cand_out(k:i32,x:i32)i32 { return (cand_a(k)*x)+cand_b(k); }
// ground truth: balanced by construction
fn tgt(c:i32,N:i32)i32 { return c%N; }
// context c -> scalar x used for affine evaluation (deterministic spread)
fn ctx_x(c:i32)i32 { return ((c*13)+7)%97; }

fn main()i32 {
  let ob:[]u8=z_alloc(24<<20);
  let c:i32=0;
  let buf:[]u8=z_alloc(64);

  c=o_app(ob,c,"PHASE17 RAW v1 contexts=625 probes=8"); c=o_nl(ob,c);

  let NSs:[]u8=z_alloc(5*4);
  set32(NSs,0,5); set32(NSs,4,10); set32(NSs,8,20); set32(NSs,12,30); set32(NSs,16,50);

  let N:i32=0;
  while(N<5){
    let nn:i32=get32(NSs,N*4);

    // ---- regime 0 BALANCED, regime 1 MISLEADING (decoy count inflated),
    // ---- regime 2 REGIME CHANGE (truth mapping flips at context 313)
    let rg:i32=0;
    while(rg<3){

      // ---------- TRAIN stream: contexts 0..312 (never 313..624)
      // counts[cand] = times it was correct in training
      let cnt:[]u8=z_alloc(64*4);
      // misleading: inflate decoy (candidate 0) beyond truth
      if(rg==1){ let d:i32=0; while(d<8){ set32(cnt,d*4,get32(cnt,d*4)+40); d=d+1; } }

      let cc:i32=0;
      while(cc<313){
        let tt:i32=truth(cc,nn,rg);
        set32(cnt,tt*4,get32(cnt,tt*4)+1);
        cc=cc+1;
      }

      // ---------- raw counts dump (req 8)
      c=o_app(ob,c,"SECTION regime="); c=o_i64(ob,c,rg as i64);
      c=o_app(ob,c," N="); c=o_i64(ob,c,nn as i64); c=o_nl(ob,c);
      let k:i32=0;
      while(k<nn){
        c=o_app(ob,c,"COUNT "); c=o_i64(ob,c,k as i64);
        c=o_app(ob,c," "); c=o_i64(ob,c,get32(cnt,k*4) as i64); c=o_nl(ob,c);
        k=k+1;
      }

      // ---------- behaviour traces: probes give each candidate's opaque output
      let trace:[]u8=z_alloc(64*PROBE_N()*4);
      k=0;
      while(k<nn){
        let p:i32=0;
        while(p<PROBE_N()){
          let ccx:i32=((p*211)+(k*7))%625;
          set32(trace,k*PROBE_N()*4+p*4,cand_out(k,ctx_x(ccx)));
          p=p+1;
        }
        k=k+1;
      }

      // ---------- arms: per test query, emit chosen + ground truth
      // ARMS: 0 COUNT 1 RECENCY 2 RANDOM 3 FIXED_CTX 4 FACTS_ONLY
      //       5 EXHAUSTIVE 6 LEARNED 7 SHUFFLED 8 ORACLE
      let NA:i32=9;
      let t:i32=313;
      while(t<625){
        let gt:i32=truth(t,nn,rg);

        // COUNT: argmax count, lowest index tie-break
        let kc:i32=0; let bv:i32=-1; k=0;
        while(k<nn){ if(get32(cnt,k*4)>bv){ bv=get32(cnt,k*4); kc=k; } k=k+1; }
        // FIXED_CTX: argmax count among candidates correct when ctx_x(t)%V==0
        let kf:i32=0; bv=-1; k=0;
        while(k<nn){
          if(cand_out(k,ctx_x(t))%V==0){ if(get32(cnt,k*4)>bv){ bv=get32(cnt,k*4); kf=k; } }
          k=k+1;
        }
        // FACTS_ONLY: argmax count among candidates matching the query's
        // first probe-neighbourhood output (no truth used)
        let probeOut:i32=cand_out(0,ctx_x(t));
        let kfa:i32=0; bv=-1; k=0;
        while(k<nn){
          if(cand_out(k,ctx_x(t))==probeOut){ if(get32(cnt,k*4)>bv){ bv=get32(cnt,k*4); kfa=k; } }
          k=k+1;
        }
        // RECENCY: last candidate that was correct in training order
        let kr:i32=0; let lc:i32=-1; cc=312;
        while(cc>=0){
          if(truth(cc,nn,rg)==kc){ lc=kc; break; }
          cc=cc-1;
        }
        if(lc>=0){ kr=lc; }
        // RANDOM: xorshift-style decorrelated hash of (t,N,regime).
        // The previous (t*31)%N was a perfect predictor because gcd(31,N)=1
        // makes it coincide with the truth function t%N.
        let h:i32=((t*2654435761)+(nn*40503)+(rg*2246822519))&0x7fffffff;
        h=h^(h>>13); h=h&0x7fffffff;
        let krd:i32=h%nn;
        // EXHAUSTIVE: genuine search over all candidates, no truth used.
        // Fit score = how well the candidate's probe curve matches the query's
        // own probe curve (sum of absolute first differences). Monotone and
        // non-negative, so the argmax is meaningful.
        let ke:i32=0; let bs:i32=-1; k=0;
        while(k<nn){
          let fit:i32=0; let p:i32=1;
          while(p<PROBE_N()){
            let a1:i32=cand_out(k,ctx_x(t+p-1));
            let a2:i32=cand_out(k,ctx_x(t+p));
            let e:i32=a2-a1; if(e<0){ e=0-e; }
            fit=fit+e; p=p+1;
          }
          if(fit>bs){ bs=fit; ke=k; }
          k=k+1;
        }
        // ORACLE: the ground truth itself (bound)
        let ko:i32=gt;
        // LEARNED: induce ctx->candidate from traces by nearest trace distance.
        // No router, no bucket index: it measures, for each candidate, how
        // close its outputs are to the query's probe output across probes.
        let kl:i32=0; let bestD:i32=1<<30; k=0;
        while(k<nn){
          let d:i32=0; let p:i32=0;
          while(p<PROBE_N()){
            let q1:i32=cand_out(k,ctx_x(((p*211)+(k*7))%625));
            let q2:i32=cand_out(k,ctx_x(t));
            let e:i32=q1-q2; if(e<0){ e=0-e; }
            d=d+e; p=p+1;
          }
          if(d<bestD){ bestD=d; kl=k; }
          k=k+1;
        }
        // SHUFFLED: same learned rule, candidate IDs permuted (id*7+3)%nn
        let ksh:i32=((kl*7)+3)%nn;

        let a:i32=0;
        while(a<NA){
          let chosen:i32=0;
          if(a==0){chosen=kc;} if(a==1){chosen=kr;} if(a==2){chosen=krd;}
          if(a==3){chosen=kf;} if(a==4){chosen=kfa;} if(a==5){chosen=ke;}
          if(a==6){chosen=kl;} if(a==7){chosen=ksh;} if(a==8){chosen=ko;}
          c=o_app(ob,c,"Q rg="); c=o_i64(ob,c,rg as i64);
          c=o_app(ob,c," N="); c=o_i64(ob,c,nn as i64);
          c=o_app(ob,c," t="); c=o_i64(ob,c,t as i64);
          c=o_app(ob,c," arm="); c=o_i64(ob,c,a as i64);
          c=o_app(ob,c," chosen="); c=o_i64(ob,c,chosen as i64);
          c=o_app(ob,c," truth="); c=o_i64(ob,c,gt as i64); c=o_nl(ob,c);
          a=a+1;
        }
        t=t+1;
      }
      rg=rg+1;
    }
    N=N+1;
  }
  o_flush(ob,c);
  return 0;
}

// single ground-truth function for every regime.
// rg 0,1: truth = c % N            (balanced; frequency carries no signal)
// rg 2:    truth = (c*7)%N for c<160, else (c*11)%N  (regime change)
fn truth(c:i32,N:i32,rg:i32)i32 {
  if(rg==2){
    if(c<160){ return (c*7)%N; }
    return (c*11)%N;
  }
  return c%N;
}
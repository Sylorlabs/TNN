// PHASE 17 SCORER (Zag port of count17/score17.py)
//
// Recomputes every verdict from the 42,481-line raw table. Shares no code with c17.zag.
//
// THE INVARIANT IS THE POINT. A query-blind arm emits one fixed candidate; each
// candidate is correct on ceil(312/N) of the 312 test queries, so it is CAPPED there
// regardless of N. The scorer recomputes that ceiling analytically and checks that no
// query-blind arm exceeds it. If one does, the generator's ceiling is wrong and every
// other verdict is reported as suspect rather than the scorer continuing silently.
//
// usage: score17.zag <run.txt>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn pad(b:[]u8,c:i32,s:[]u8,to:i32)i32 {
  let e:i32=c+s.len;
  while(e<to){ b[e]=32; e=e+1; }
  return c+s.len;
}

fn NREG()i32 { return 4; }
fn NARM()i32 { return 8; }
fn NBUD()i32 { return 3; }
fn MAXR()i32 { return 400; }

// row: rg arm budget -> cost, replays, len
fn R_RG()i32 { return 0; }
fn R_ARM()i32 { return 1; }
fn R_BUD()i32 { return 2; }
fn R_COST()i32 { return 3; }
fn R_REP()i32 { return 4; }
fn R_LEN()i32 { return 5; }
fn R_BUDV()i32 { return 6; }
fn R_N()i32 { return 7; }

fn budgetOf(b:i32)i32 {
  if(b==200){ return 0; }
  if(b==1000){ return 1; }
  if(b==4000){ return 2; }
  return -1;
}

// read "key=<int>" out of a line; -1 if absent
fn fld(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      let p:i32=i+kl+1;
      if(p>=line.len){ return -1; }
      let neg:i32=0;
      if(line[p]=='-'){ neg=1; p=p+1; }
      if(p>=line.len){ return -1; }
      let ch:i32=line[p];
      if(ch<'0' || ch>'9'){ return -1; }
      let v:i32=0;
      while(p<line.len){
        let c2:i32=line[p];
        if(c2>='0' && c2<='9'){ v=v*10+(c2-'0'); p=p+1; }
        else { break; }
      }
      if(neg==1){ v=0-v; }
      return v;
    }
    i=i+1;
  }
  return -1;
}

// cost of (rg,arm,budIdx); -99 when absent
fn cost(RW:[]u8,nrow:i32,rg:i32,arm:i32,bi:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){
        if(get32(RW,i*R_N()*4+R_BUD()*4)==bi){ return get32(RW,i*R_N()*4+R_COST()*4); }
      }
    }
    i=i+1;
  }
  return -99;
}

// real budget value for (rg,arm,bi)
fn budval(RW:[]u8,nrow:i32,rg:i32,arm:i32,bi:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){
        if(get32(RW,i*R_N()*4+R_BUD()*4)==bi){ return get32(RW,i*R_N()*4+R_BUDV()*4); }
      }
    }
    i=i+1;
  }
  return -1;
}

// replays lookup
fn reps(RW:[]u8,nrow:i32,rg:i32,arm:i32,bi:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){
        if(get32(RW,i*R_N()*4+R_BUD()*4)==bi){ return get32(RW,i*R_N()*4+R_REP()*4); }
      }
    }
    i=i+1;
  }
  return -99;
}


fn NREG17()i32 { return 3; }
fn NARM17()i32 { return 9; }
fn MAXQ17()i32 { return 60000; }
fn Q_RG()i32 { return 0; }
fn Q_NV()i32 { return 1; }
fn Q_ARM()i32 { return 2; }
fn Q_OK()i32 { return 3; }
fn Q_W()i32 { return 4; }

// query-blind ceiling: ceil(312 / N)
fn ceiling(n:i32)i32 { return (312+n-1)/n; }

// Total hits for (rg, N, arm). The Q rows carry rg, N and arm directly, so this
// needs no block arithmetic and cannot silently truncate a fixed-size block.
// The first version of this scorer used block indexing AND a 20,000-row cap on a
// 42,145-row table; it printed a PASSING invariant over wrong numbers. Both defects
// are recorded because an invariant that passes on mis-indexed data is worse than no
// invariant at all.
fn hits3(RW:[]u8,nrow:i32,rg:i32,N:i32,arm:i32)i32 {
  let i:i32=0;
  let acc:i32=0;
  while(i<nrow){
    if(get32(RW,i*Q_W()*4+Q_RG()*4)==rg){
      if(get32(RW,i*Q_W()*4+Q_NV()*4)==N){
        if(get32(RW,i*Q_W()*4+Q_ARM()*4)==arm){ acc=acc+get32(RW,i*Q_W()*4+Q_OK()*4); }
      }
    }
    i=i+1;
  }
  return acc;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<20);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: score17 <run.txt>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let rp:[]u8=_zag_arg(1);
  let raw:[]u8="";
  if(_zag_file_exists(rp)==1){ raw=_zag_read_file(rp); }
  let rn:i32=raw.len;
  if(rn<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read input"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  let RW:[]u8=z_alloc(MAXQ17()*Q_W()*4);
  let nrow:i32=0;
  let li:i32=0;
  while(li<rn){
    let nl:i32=li;
    while(nl<rn){ if(raw[nl]==10){ break; } nl=nl+1; }
    let line:[]u8=raw[li..nl];
    li=nl+1;
    if(line.len>=2){
      if(line[0]=='Q' && line[1]==' '){
        let rg:i32=fld(line,"rg");
        let nv:i32=fld(line,"N");
        let ar:i32=fld(line,"arm");
        let ch:i32=fld(line,"chosen");
        let tr:i32=fld(line,"truth");
        if(rg>=0 && nv>=0 && ar>=0 && ch>=0 && tr>=0){
          let ok:i32=0;
          if(ch==tr){ ok=1; }
          if(nrow<MAXQ17()){
            set32(RW,nrow*Q_W()*4+Q_RG()*4,rg);
            set32(RW,nrow*Q_W()*4+Q_NV()*4,nv);
            set32(RW,nrow*Q_W()*4+Q_ARM()*4,ar);
            set32(RW,nrow*Q_W()*4+Q_OK()*4,ok);
            nrow=nrow+1;
          }
        }
      }
    }
    if(li>rn){ break; }
  }

  let NS:[]u8=z_alloc(8*4);
  set32(NS,0,5); set32(NS,4,10); set32(NS,8,20); set32(NS,12,30); set32(NS,16,50);

  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"INDEPENDENT SCORER -- phase17 counting dilemma (Zag port)"); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"Q rows loaded: "); c=o_i64(ob,c,nrow as i64); c=o_nl(ob,c);
  if(nrow<1){
    c=o_app(ob,c,"RESULT=FAIL (no Q rows)"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Q-A/Q-B: does any arm beat the analytic query-blind ceiling?"); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"  rg    N   ceiling    0COUNT   1RECEN   2RANDOM    3FIXED    4FACTS    5EXHAU    6LEARN    7SHUFF    8ORACLE");
  c=o_nl(ob,c);
  let violated:i32=0;
  let rg:i32=0;
  while(rg<NREG17()){
    let ni:i32=0;
    while(ni<5){
      let N:i32=get32(NS,ni*4);
      let cl:i32=ceiling(N);
      c=o_app(ob,c,"  "); c=o_i64(ob,c,rg as i64);
      c=o_app(ob,c,"   "); c=o_i64(ob,c,N as i64);
      c=o_app(ob,c,"      "); c=o_i64(ob,c,cl as i64);
      let a:i32=0;
      while(a<NARM17()){
        let acc:i32=hits3(RW,nrow,rg,get32(NS,ni*4),a);
        c=o_app(ob,c,"      "); c=o_i64(ob,c,acc as i64);
        if(a==0 || a==1 || a==3){
          if(acc>cl){ violated=1; }
        }
        a=a+1;
      }
      c=o_nl(ob,c);
      ni=ni+1;
    }
    rg=rg+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  if(violated==0){
    c=o_app(ob,c,"Invariant OK: no query-blind arm exceeds its analytic ceiling."); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"*** INVARIANT VIOLATED: a query-blind arm beat its own bound."); c=o_nl(ob,c);
    c=o_app(ob,c,"*** The generator's ceiling is wrong; verdicts below are suspect."); c=o_nl(ob,c);
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Learned arms that strictly exceed the ceiling:"); c=o_nl(ob,c);
  let anyE:i32=0;
  rg=0;
  while(rg<NREG17()){
    let ni2:i32=0;
    while(ni2<5){
      let N2:i32=get32(NS,ni2*4);
      let c2:i32=ceiling(N2);
      let a2:i32=6;
      while(a2<8){
        let ac:i32=hits3(RW,nrow,rg,get32(NS,ni2*4),a2);
        if(ac>c2){
          anyE=1;
          c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
          c=o_app(ob,c," N="); c=o_i64(ob,c,N2 as i64);
          c=o_app(ob,c,": arm "); c=o_i64(ob,c,a2 as i64);
          c=o_app(ob,c," = "); c=o_i64(ob,c,ac as i64);
          c=o_app(ob,c," > ceiling "); c=o_i64(ob,c,c2 as i64); c=o_nl(ob,c);
        }
        a2=a2+1;
      }
      ni2=ni2+1;
    }
    rg=rg+1;
  }
  if(anyE==0){
    c=o_app(ob,c,"  NONE. LEARNED and SHUFFLED never beat query-blind selection."); c=o_nl(ob,c);
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Q-C: is the LEARNED gain real, or identifier layout? (LEARNED vs SHUFFLED)");
  c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);
  rg=0;
  while(rg<NREG17()){
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64); c=o_app(ob,c,": LEARNED=");
    let ni3:i32=0;
    while(ni3<5){
      c=o_i64(ob,c,hits3(RW,nrow,rg,get32(NS,ni3*4),6) as i64); c=o_app(ob,c,","); ni3=ni3+1;
    }
    c=o_app(ob,c,"  SHUFFLED=");
    ni3=0;
    while(ni3<5){
      c=o_i64(ob,c,hits3(RW,nrow,rg,get32(NS,ni3*4),7) as i64); c=o_app(ob,c,","); ni3=ni3+1;
    }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  c=o_app(ob,c,"  If SHUFFLED >= LEARNED, the gain is identifier layout, not state."); c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BOUNDS (not competitors): arm 5 EXHAUSTIVE and arm 8 ORACLE."); c=o_nl(ob,c);
  rg=0;
  while(rg<NREG17()){
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64); c=o_app(ob,c,": EXHAUSTIVE=");
    let ni4:i32=0;
    while(ni4<5){
      c=o_i64(ob,c,hits3(RW,nrow,rg,get32(NS,ni4*4),5) as i64); c=o_app(ob,c,","); ni4=ni4+1;
    }
    c=o_app(ob,c,"  ORACLE=");
    ni4=0;
    while(ni4<5){
      c=o_i64(ob,c,hits3(RW,nrow,rg,get32(NS,ni4*4),8) as i64); c=o_app(ob,c,","); ni4=ni4+1;
    }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}

// opscope_harness.zag - Training/test harness and R4 falsifiers.
// EXCLUDED from the F3 source audit (harness). The learner file is audited.

// GATE-STRESS pilot parameters. FAM: 1=A install-order spoof (grn clears all
// six bars, installs alongside not), 2=B K=2 sole discriminator (grn div=1,
// K=2 kills it), 3=C position-0 confound (doubled tak clears five bars,
// zero-parameter gate kills it). SEED: pilot seed (sealed seeds frozen in
// prereg). NEP: 126 episodes (120 frozen + 6 attack probes).
fn FAM()i32 { return 3; }
fn SEED()i32 { return 999; }
fn NEP()i32 { return 126; }

fn dump_oprec(W:[]u8)void {
  emit("OPREC_TABLE:\n");
  let k:i32=0;
  while(k<8){
    let b:i32=5616+k*24;
    emit(" k="); emit(i32s(k));
    emit(" trig="); emit(i32s(get32(W,b)));
    emit(" scope="); emit(i32s(get32(W,b+4)));
    emit(" sig="); emit(i32s(get32(W,b+8)));
    emit(" sup="); emit(i32s(get32(W,b+12)));
    emit(" created="); emit(i32s(get32(W,b+16)));
    emit(" active="); emit(i32s(get32(W,b+20)));
    emit("\n");
    k=k+1;
  }
  return;
}

fn dump_diag(D:[]u8)void {
  emit("DIAG w epc reclen sup mtch div cs cb gate\n");
  let w:i32=0;
  while(w<12){
    let b:i32=w*32;
    let sup:i32=get32(D,b+8);
    if(sup>0){
      emit(" "); emit(i32s(w));
      emit(" "); emit(i32s(get32(D,b)));
      emit(" "); emit(i32s(get32(D,b+4)));
      emit(" "); emit(i32s(sup));
      emit(" "); emit(i32s(get32(D,b+12)));
      emit(" "); emit(i32s(get32(D,b+16)));
      emit(" "); emit(i32s(get32(D,b+20)));
      emit(" "); emit(i32s(get32(D,b+24)));
      emit(" "); emit(i32s(get32(D,b+28)));
      emit("\n");
    }
    w=w+1;
  }
  return;
}

fn main()i32 {
  // ---------- Frozen world ----------
  let st:[]u8=z_alloc(4);
  set32(st,0,SEED());
  let eps:[]u8=z_alloc(NEP()*64);
  gen_episodes_fam(eps,st,FAM());

  // ---------- Oracle units + targets ----------
  let allU:[]u8=z_alloc(NEP()*16);
  let allN:[]u8=z_alloc(NEP()*4);
  let allT:[]u8=z_alloc(NEP()*4);
  let U:[]u8=z_alloc(16);
  let vrt:i32=1;
  let t:i32=0;
  while(t<NEP()){
    let ep:[]u8=z_alloc(64);
    let k:i32=0; while(k<64){ ep[k]=eps[t*64+k]; k=k+1; }
    let n:i32=world_recover_U(ep,U);
    if(world_verify_U(ep,U,n)==0){ vrt=0; }
    let m:i32=world_T(ep,U,n);
    set32(allN,t*4,n);
    set32(allT,t*4,m);
    k=0; while(k<4){
      if(k<n){ set32(allU,(t*4+k)*4,get32(U,k*4)); } else { set32(allU,(t*4+k)*4,-1); }
      k=k+1;
    }
    t=t+1;
  }
  emit("VERIFY_U_ROUNDTRIP_126: "); emit(i32s(vrt)); emit("\n");
  emit("LEXICON: 0=tak 1=not 2=red 3=blu 4=grn 5=bal 6=sph 7=cub 8=tri 9=big 10=biger 11=smal\n");

  // ---------- Learner ----------
  let W:[]u8=z_alloc(8400);
  let z:i32=0; while(z<8400){ W[z]=0; z=z+1; }
  let TU:[]u8=z_alloc(16);
  let TS:[]u8=z_alloc(16);

  // ---------- Training: episodes 0..99, one-pass online ----------
  t=0;
  while(t<100){
    let n:i32=get32(allN,t*4);
    let T:i32=get32(allT,t*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(t*4+j)*4)); j=j+1; }
    learn_keep(W,TU,n,T,t);
    let p0:i32=baseline(W,TU,n);
    if(t>=20 && p0!=T){ learn_event(W,TU,n,T); }
    learn_update(W,TU,n,T);
    if((t+1)>=20 && ((t+1)%10)==0){
      let D:[]u8=z_alloc(384);
      diag_bars(W,t+1,TS,D);
      emit("CHECK seen="); emit(i32s(t+1)); emit("\n");
      dump_diag(D);
      let inst:i32=proposal_check(W,t+1,TS);
      retire_check(W,t+1,TS);
      emit(" installed_now="); emit(i32s(inst)); emit("\n");
    }
    t=t+1;
  }

  emit("TRAIN_DONE\n");
  dump_oprec(W);

  // ---------- Frozen test: episodes 100..119, no learning ----------
  let per:[]u8=z_alloc(20*4);
  let tc:i32=0;
  t=0;
  while(t<20){
    let e:i32=100+t;
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    let p:i32=interpret(W,TU,n);
    let ok:i32=0;
    if(p==T){ ok=1; tc=tc+1; }
    set32(per,t*4,ok);
    emit("TEST ep="); emit(i32s(e));
    emit(" pred="); emit(i32s(p));
    emit(" tgt="); emit(i32s(T));
    emit(" ok="); emit(i32s(ok)); emit("\n");
    t=t+1;
  }
  emit("TEST_ACC: "); emit(i32s(tc)); emit("/20\n");

  // ---------- F1: T1 items 109,110,111 + white-box ----------
  let f1:i32=1;
  let ti:i32=0;
  while(ti<3){
    if(get32(per,(9+ti)*4)==0){ f1=0; }
    ti=ti+1;
  }
  // white-box: an OPREC with trig=1, sig=0, created>0, sup>=4
  let wb:i32=0;
  let k2:i32=0;
  while(k2<8){
    let b:i32=5616+k2*24;
    if(get32(W,b+20)==1 && get32(W,b)==1 && get32(W,b+8)==0 && get32(W,b+16)>0 && get32(W,b+12)>=4){
      wb=1;
    }
    k2=k2+1;
  }
  if(wb==0){ f1=0; }
  emit("F1_T1_3x_AND_WHITEBOX: "); emit(i32s(f1));
  emit(" (t1pass="); emit(i32s(get32(per,36)+get32(per,40)+get32(per,44)));
  emit("/3 whitebox="); emit(i32s(wb)); emit(")\n");

  // ---------- F2: T3 items (same ids on this battery) ----------
  let f2:i32=1;
  ti=0;
  while(ti<3){
    if(get32(per,(9+ti)*4)==0){ f2=0; }
    ti=ti+1;
  }
  emit("F2_T3_SCOPE_SHIFT: "); emit(i32s(f2)); emit("\n");

  // ---------- F4: ablation ----------
  let W2:[]u8=z_alloc(8400);
  z=0; while(z<8400){ W2[z]=W[z]; z=z+1; }
  // empty the operator table (routing disabled; records intact)
  k2=0;
  while(k2<8){
    set32(W2,5616+k2*24+20,0);
    k2=k2+1;
  }
  let ab_t1:i32=0;
  let ab_tc:i32=0;
  let ab_negdrop:i32=0;
  t=0;
  while(t<20){
    let e:i32=100+t;
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    let p:i32=interpret(W2,TU,n);
    let ok:i32=0;
    if(p==T){ ok=1; ab_tc=ab_tc+1; }
    if(t>=9 && t<12){
      if(ok==1){ ab_t1=ab_t1+1; }
      if(get32(per,t*4)==1 && ok==0){ ab_negdrop=ab_negdrop+1; }
    }
    t=t+1;
  }
  let full_t1:i32=get32(per,36)+get32(per,40)+get32(per,44);
  let f4:i32=0;
  if(ab_t1<full_t1){ f4=1; }
  emit("F4_ABLATION: "); emit(i32s(f4));
  emit(" (t1_full="); emit(i32s(full_t1));
  emit(" t1_abl="); emit(i32s(ab_t1));
  emit(" acc_abl="); emit(i32s(ab_tc));
  emit("/20 negdrop="); emit(i32s(ab_negdrop)); emit(")\n");

  // ---------- F5: floors ----------
  let size3:i32=get32(per,60)+get32(per,64)+get32(per,68);
  let f5:i32=0;
  if(tc>=16 && size3==3){ f5=1; }
  emit("F5_FLOORS: "); emit(i32s(f5));
  emit(" (acc="); emit(i32s(tc)); emit("/20 size="); emit(i32s(size3)); emit("/3)\n");

  // F3 is the source audit (shell grep, pasted verbatim in the result doc).
  emit("F3_SOURCE_AUDIT: see result doc (shell grep)\n");

  let pass:i32=0;
  if(f1==1 && f2==1 && f4==1 && f5==1){ pass=1; }
  // F3 must also hold; checked in shell.
  if(pass==1){ emit("VERDICT: OPSCOPE-R1R4-PASS\n"); } else { emit("VERDICT: OPSCOPE-R1R4-FAIL\n"); }

  // ---------- GATE-STRESS probes: episodes 120..125, no learning ----------
  let probe_ok:[]u8=z_alloc(6*4);
  t=0;
  while(t<6){
    let e:i32=120+t;
    let n:i32=get32(allN,e*4);
    let T:i32=get32(allT,e*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(e*4+j)*4)); j=j+1; }
    let p:i32=interpret(W,TU,n);
    let ok:i32=0;
    if(p==T){ ok=1; }
    set32(probe_ok,t*4,ok);
    emit("PROBE ep="); emit(i32s(e));
    emit(" pred="); emit(i32s(p));
    emit(" tgt="); emit(i32s(T));
    emit(" ok="); emit(i32s(ok)); emit("\n");
    t=t+1;
  }
  let pconf:i32=get32(probe_ok,0)+get32(probe_ok,4)+get32(probe_ok,8);
  let pharm:i32=get32(probe_ok,12)+get32(probe_ok,16)+get32(probe_ok,20);
  emit("PROBE_CONF_NEG_tak_not_grn_red: "); emit(i32s(pconf)); emit("/3\n");
  emit("PROBE_HARM_DIRECT_tak_grn_cub: "); emit(i32s(pharm)); emit("/3\n");

  // ---------- GATE-STRESS attack summary ----------
  emit("ATTACK_SUMMARY fam="); emit(i32s(FAM()));
  emit(" seed="); emit(i32s(SEED())); emit("\n");
  let k3:i32=0;
  while(k3<8){
    let b3:i32=5616+k3*24;
    if(get32(W,b3+20)==1){
      emit(" INSTALLED k="); emit(i32s(k3));
      emit(" trig="); emit(i32s(get32(W,b3)));
      emit(" created="); emit(i32s(get32(W,b3+16))); emit("\n");
    }
    k3=k3+1;
  }
  let conf:i32=0;
  k3=0;
  while(k3<8){
    let b3:i32=5616+k3*24;
    if(get32(W,b3+20)==1 && get32(W,b3)==4){ conf=1; }
    k3=k3+1;
  }
  emit("CONFOUND_GRN_INSTALLED: "); emit(i32s(conf)); emit("\n");
  emit("TRUE_NOT_INSTALLED_WHITEBOX: "); emit(i32s(wb)); emit("\n");
  return 0;
}

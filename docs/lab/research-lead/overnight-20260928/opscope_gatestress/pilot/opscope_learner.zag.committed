// opscope_learner.zag
// R1-R4 operator/scope learner. F3-audited source.
// Units are integer ids. Semantics live in learner-created state.
// Routing tests OPREC.trigger_form, a runtime-bound value.
// This file holds zero word literals.

// ----- Frozen constants (prereg 51c54e262) -----
fn L_B0()i32 { return 20; }
fn L_E()i32 { return 10; }
fn L_NEP()i32 { return 5; }
fn L_FMAX()i32 { return 1; }
fn L_N()i32 { return 4; }
fn L_K()i32 { return 2; }
fn L_OPMAX()i32 { return 8; }
fn L_NW()i32 { return 12; }
fn L_NF()i32 { return 12; }
fn L_SIG_DEL()i32 { return 0; }
fn L_SCOPE_REST()i32 { return 0; }
fn L_NTRAIN()i32 { return 100; }

// ----- State layout (byte offsets into W) -----
// 0: cnt[12][12] i32 (576)
// 576: occ[12] i32 (48)
// 624: cntO[8][12][12] i32 (4608)
// 5232: occO[8][12] i32 (384)
// 5616: oprec[8][6] i32 (192): trigger, scope_rule, sig, support, created_at, active
// 5808: dstat[12][4] i32 (192): sup, mtch, sforms, epc
// 6000: epstore[100][6] i32 (2400): U0,U1,U2,U3, nU, Tmask
fn L_bytes()i32 { return 8400; }

fn popcnt(v:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<32){
    if(((v>>i)&1)==1){ c=c+1; }
    i=i+1;
  }
  return c;
}

// Binarized DEFAULT record mask for unit u.
// Bit f set iff occ>0 and cnt[f]*2 > occ (strict majority).
fn recmask(W:[]u8, u:i32)i32 {
  let m:i32=0;
  let o:i32=get32(W,576+u*4);
  if(o>0){
    let f:i32=0;
    while(f<12){
      let c:i32=get32(W,(u*12+f)*4);
      if(c*2>o){ m=m | (1<<f); }
      f=f+1;
    }
  }
  return m;
}

// Binarized record mask for unit u under operator k.
fn recmaskO(W:[]u8, k:i32, u:i32)i32 {
  let m:i32=0;
  let o:i32=get32(W,5232+(k*12+u)*4);
  if(o>0){
    let f:i32=0;
    while(f<12){
      let c:i32=get32(W,624+(k*144+u*12+f)*4);
      if(c*2>o){ m=m | (1<<f); }
      f=f+1;
    }
  }
  return m;
}

// OR of DEFAULT masks over U[a..b).
fn or_default(W:[]u8, U:[]u8, n:i32, a:i32, b:i32)i32 {
  let m:i32=0;
  let j:i32=a;
  while(j<b){
    m=m | recmask(W,get32(U,j*4));
    j=j+1;
  }
  return m;
}

// OR of operator-k masks over U[a..b).
fn or_op(W:[]u8, k:i32, U:[]u8, n:i32, a:i32, b:i32)i32 {
  let m:i32=0;
  let j:i32=a;
  while(j<b){
    m=m | recmaskO(W,k,get32(U,j*4));
    j=j+1;
  }
  return m;
}

// First active oprec whose trigger occurs in U. Returns k*16+i, else -1.
// Table order decides among operators; first occurrence decides position.
fn find_op(W:[]u8, U:[]u8, n:i32)i32 {
  let k:i32=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==1){
      let tf:i32=get32(W,5616+k*24);
      let j:i32=0;
      while(j<n){
        if(get32(U,j*4)==tf){ return k*16+j; }
        j=j+1;
      }
    }
    k=k+1;
  }
  return -1;
}

// R1: compositional interpretation over spans.
fn interpret(W:[]u8, U:[]u8, n:i32)i32 {
  let pk:i32=find_op(W,U,n);
  if(pk<0){ return or_default(W,U,n,0,n); }
  let k:i32=pk/16;
  let i:i32=pk%16;
  let m:i32=or_default(W,U,n,0,i);
  m=m | or_op(W,k,U,n,i+1,n);
  return m;
}

// Baseline prediction: DEFAULT records only, zero operator routing.
fn baseline(W:[]u8, U:[]u8, n:i32)i32 {
  return or_default(W,U,n,0,n);
}

// DELETION signature: scope-predicted features systematically absent
// while the rest stays correctly predicted.
fn sig_match(sp:i32, rp:i32, T:i32)i32 {
  if(sp==0){ return 0; }
  if((rp | T)!=T){ return 0; }
  if((sp | T)==T){ return 0; }
  return 1;
}

// Count co-occurrence of units U[a..b) with target mask T.
fn upd_default(W:[]u8, U:[]u8, n:i32, a:i32, b:i32, T:i32)void {
  let j:i32=a;
  while(j<b){
    let u:i32=get32(U,j*4);
    set32(W,576+u*4,get32(W,576+u*4)+1);
    let f:i32=0;
    while(f<12){
      if(((T>>f)&1)==1){
        let c:i32=get32(W,(u*12+f)*4);
        set32(W,(u*12+f)*4,c+1);
      }
      f=f+1;
    }
    j=j+1;
  }
  return;
}

// Count co-occurrence of units U[a..b) with residual mask R under op k.
fn upd_op(W:[]u8, k:i32, U:[]u8, n:i32, a:i32, b:i32, R:i32)void {
  let j:i32=a;
  while(j<b){
    let u:i32=get32(U,j*4);
    set32(W,5232+(k*12+u)*4,get32(W,5232+(k*12+u)*4)+1);
    let f:i32=0;
    while(f<12){
      if(((R>>f)&1)==1){
        let c:i32=get32(W,624+(k*144+u*12+f)*4);
        set32(W,624+(k*144+u*12+f)*4,c+1);
      }
      f=f+1;
    }
    j=j+1;
  }
  return;
}

// Store (U,T); count episodes per form.
fn learn_keep(W:[]u8, U:[]u8, n:i32, T:i32, t:i32)void {
  let b:i32=6000+t*24;
  let j:i32=0;
  while(j<4){
    if(j<n){ set32(W,b+j*4,get32(U,j*4)); } else { set32(W,b+j*4,-1); }
    j=j+1;
  }
  set32(W,b+16,n);
  set32(W,b+20,T);
  let seen:i32=0;
  j=0;
  while(j<n){
    let u:i32=get32(U,j*4);
    if(((seen>>u)&1)==0){
      seen=seen | (1<<u);
      set32(W,5808+u*16+12,get32(W,5808+u*16+12)+1);
    }
    j=j+1;
  }
  return;
}

// R2: residual event per position. Caller ensures P0 differs from T.
fn learn_event(W:[]u8, U:[]u8, n:i32, T:i32)void {
  let i:i32=0;
  while(i<n){
    let w:i32=get32(U,i*4);
    let sp:i32=or_default(W,U,n,i+1,n);
    let rp:i32=or_default(W,U,n,0,i);
    set32(W,5808+w*16,get32(W,5808+w*16)+1);
    if(sig_match(sp,rp,T)==1){
      set32(W,5808+w*16+4,get32(W,5808+w*16+4)+1);
      let sf:i32=get32(W,5808+w*16+8);
      let j:i32=i+1;
      while(j<n){
        sf=sf | (1<<get32(U,j*4));
        j=j+1;
      }
      set32(W,5808+w*16+8,sf);
    }
    i=i+1;
  }
  return;
}

// R3: scope-conditioned grounding. Returns 1 when an operator routed.
fn learn_update(W:[]u8, U:[]u8, n:i32, T:i32)i32 {
  let pk:i32=find_op(W,U,n);
  if(pk<0){
    upd_default(W,U,n,0,n,T);
    return 0;
  }
  let k:i32=pk/16;
  let i:i32=pk%16;
  let rp:i32=or_default(W,U,n,0,i);
  let R:i32=T ^ (T & rp);
  upd_default(W,U,n,0,i,T);
  upd_op(W,k,U,n,i+1,n,R);
  return 1;
}

// Zero-parameter gate: signature prediction beats baseline, strictly.
fn gate_pass(W:[]u8, w:i32, seen:i32, TU:[]u8)i32 {
  let cs:i32=0;
  let cb:i32=0;
  let s:i32=0;
  while(s<seen){
    let b:i32=6000+s*24;
    let n:i32=get32(W,b+16);
    let T:i32=get32(W,b+20);
    let j:i32=0;
    while(j<n){
      set32(TU,j*4,get32(W,b+j*4));
      j=j+1;
    }
    let p0:i32=or_default(W,TU,n,0,n);
    if(p0==T){ cb=cb+1; }
    let fi:i32=-1;
    j=0;
    while(j<n){
      if(get32(TU,j*4)==w){ fi=j; j=n; }
      j=j+1;
    }
    let sp:i32=p0;
    if(fi>=0){ sp=or_default(W,TU,n,0,fi); }
    if(sp==T){ cs=cs+1; }
    s=s+1;
  }
  if(cs>cb){ return 1; }
  return 0;
}

fn op_free(W:[]u8)i32 {
  let k:i32=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==0){ return k; }
    k=k+1;
  }
  return -1;
}

// True when an active operator already binds trigger form w.
fn trig_bound(W:[]u8, w:i32)i32 {
  let k:i32=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==1 && get32(W,5616+k*24)==w){ return 1; }
    k=k+1;
  }
  return 0;
}

// Installation with re-grounding replay (anti-pollution).
fn reground(W:[]u8, w:i32, k:i32, seen:i32, TU:[]u8)void {
  // Zero DEFAULT and operator records.
  let z:i32=0;
  while(z<576){ W[z]=0; z=z+1; }
  z=576; while(z<624){ W[z]=0; z=z+1; }
  z=624; while(z<5232){ W[z]=0; z=z+1; }
  z=5232; while(z<5616){ W[z]=0; z=z+1; }
  // Replay stored episodes through the router.
  let s:i32=0;
  while(s<seen){
    let b:i32=6000+s*24;
    let n:i32=get32(W,b+16);
    let T:i32=get32(W,b+20);
    let j:i32=0;
    while(j<n){
      set32(TU,j*4,get32(W,b+j*4));
      j=j+1;
    }
    let fi:i32=-1;
    j=0;
    while(j<n){
      if(get32(TU,j*4)==w){ fi=j; j=n; }
      j=j+1;
    }
    if(fi<0){
      upd_default(W,TU,n,0,n,T);
    } else {
      let rp:i32=or_default(W,TU,n,0,fi);
      let R:i32=T ^ (T & rp);
      upd_default(W,TU,n,0,fi,T);
      upd_op(W,k,TU,n,fi+1,n,R);
    }
    s=s+1;
  }
  set32(W,5616+k*24,w);
  set32(W,5616+k*24+4,0);
  set32(W,5616+k*24+8,0);
  set32(W,5616+k*24+12,get32(W,5808+w*16));
  set32(W,5616+k*24+16,seen);
  set32(W,5616+k*24+20,1);
  return;
}

// R2 proposal check. Returns number installed.
fn proposal_check(W:[]u8, seen:i32, TU:[]u8)i32 {
  let installed:i32=0;
  let w:i32=0;
  while(w<12){
    if(trig_bound(W,w)==0){
      if(get32(W,5808+w*16+12)>=5){
        if(popcnt(recmask(W,w))<=1){
          let sup:i32=get32(W,5808+w*16);
          if(sup>=4){
            if(get32(W,5808+w*16+4)*4>=sup*3){
              if(popcnt(get32(W,5808+w*16+8))>=2){
                if(gate_pass(W,w,seen,TU)==1){
                  let k:i32=op_free(W);
                  if(k>=0){
                    reground(W,w,k,seen,TU);
                    installed=installed+1;
                  }
                }
              }
            }
          }
        }
      }
    }
    w=w+1;
  }
  return installed;
}

// Retirement: re-run gate per installed operator; drop losers.
// Specified; the frozen battery is expected to give it zero coverage.
fn retire_check(W:[]u8, seen:i32, TU:[]u8)void {
  let k:i32=0;
  while(k<8){
    if(get32(W,5616+k*24+20)==1){
      if(gate_pass(W,get32(W,5616+k*24),seen,TU)==0){
        set32(W,5616+k*24+20,0);
      }
    }
    k=k+1;
  }
  return;
}

// Diagnostic: per-candidate bar values into D (12 x 8 i32):
// epc, reclen, sup, mtch, div, cs, cb, gate.
fn diag_bars(W:[]u8, seen:i32, TU:[]u8, D:[]u8)void {
  let w:i32=0;
  while(w<12){
    let b:i32=w*32;
    set32(D,b,get32(W,5808+w*16+12));
    set32(D,b+4,popcnt(recmask(W,w)));
    set32(D,b+8,get32(W,5808+w*16));
    set32(D,b+12,get32(W,5808+w*16+4));
    set32(D,b+16,popcnt(get32(W,5808+w*16+8)));
    let cs:i32=0;
    let cb:i32=0;
    let s:i32=0;
    while(s<seen){
      let eb:i32=6000+s*24;
      let n:i32=get32(W,eb+16);
      let T:i32=get32(W,eb+20);
      let j:i32=0;
      while(j<n){
        set32(TU,j*4,get32(W,eb+j*4));
        j=j+1;
      }
      let p0:i32=or_default(W,TU,n,0,n);
      if(p0==T){ cb=cb+1; }
      let fi:i32=-1;
      j=0;
      while(j<n){
        if(get32(TU,j*4)==w){ fi=j; j=n; }
        j=j+1;
      }
      let sp:i32=p0;
      if(fi>=0){ sp=or_default(W,TU,n,0,fi); }
      if(sp==T){ cs=cs+1; }
      s=s+1;
    }
    set32(D,b+20,cs);
    set32(D,b+24,cb);
    if(cs>cb){ set32(D,b+28,1); } else { set32(D,b+28,0); }
    w=w+1;
  }
  return;
}

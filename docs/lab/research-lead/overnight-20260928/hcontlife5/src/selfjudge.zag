// selfjudge.zag -- H-CONTLIFE-5: learner-owned evaluation.
// Commitment -> delayed consequence -> learner self-judgment. Pure Zag.
// One binary, three roles separated by function boundaries:
//   LEARNER: learner_commit, learner_judge, learner_control_judge.
//     They take VALUES only (never a case id) and never call world_y.
//   WORLD: world_y, called only from the P2 path in main.
//   HARNESS: agreement counting and bar checks; reads sealed records only.
// Prereg: hcontlife5/PREREG.md (frozen kill bars K1..K6).
// Pitfall discipline: u8-backed cells with little-endian helpers, one
// preallocated output buffer with cursor-returning emit helpers, single
// raw-syscall flush, if-nesting at most 3, no !(A && B) in while guards.

// ---------- record layout (10 x i32 = 40 bytes per case) ----------
const R_P:i32=0;
const R_T:i32=4;
const R_RMAX:i32=8;
const R_YS:i32=12;
const R_SELF:i32=16;
const R_SELFC:i32=20;
const R_HIDDEN:i32=24;
const R_EPC:i32=28;
const R_EPW:i32=32;
const R_EPJ:i32=36;
const R_SZ:i32=40;
const N_CASES:i32=24;
const YS_SENTINEL:i32=-999;

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn abs32(v:i32)i32 {
  if(v<0){return 0-v;}
  return v;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---------- frozen case table: training data (main may read for P1) ----------
fn case_y0(cid:i32)i32 {
  if(cid==0){return 0;} if(cid==1){return 3;} if(cid==2){return 7;}
  if(cid==3){return 9;} if(cid==4){return 0;} if(cid==5){return 2;}
  if(cid==6){return 5;} if(cid==7){return 8;} if(cid==8){return 0;}
  if(cid==9){return 1;} if(cid==10){return 2;} if(cid==11){return 3;}
  if(cid==12){return 0;} if(cid==13){return 1;} if(cid==14){return 0;}
  if(cid==15){return 4;} if(cid==16){return 2;} if(cid==17){return 1;}
  if(cid==18){return 7;} if(cid==19){return 5;} if(cid==20){return 1;}
  if(cid==21){return 2;} if(cid==22){return 0;} if(cid==23){return 1;}
  return 0;
}
fn case_y1(cid:i32)i32 {
  if(cid==0){return 1;} if(cid==1){return 5;} if(cid==2){return 10;}
  if(cid==3){return 10;} if(cid==4){return 2;} if(cid==5){return 5;}
  if(cid==6){return 6;} if(cid==7){return 10;} if(cid==8){return 1;}
  if(cid==9){return 2;} if(cid==10){return 3;} if(cid==11){return 4;}
  if(cid==12){return 1;} if(cid==13){return 3;} if(cid==14){return 3;}
  if(cid==15){return 5;} if(cid==16){return 4;} if(cid==17){return 4;}
  if(cid==18){return 8;} if(cid==19){return 7;} if(cid==20){return 3;}
  if(cid==21){return 5;} if(cid==22){return 3;} if(cid==23){return 4;}
  return 0;
}
fn case_y2(cid:i32)i32 {
  if(cid==0){return 2;} if(cid==1){return 7;} if(cid==2){return 13;}
  if(cid==3){return 11;} if(cid==4){return 4;} if(cid==5){return 8;}
  if(cid==6){return 7;} if(cid==7){return 12;} if(cid==8){return 4;}
  if(cid==9){return 5;} if(cid==10){return 6;} if(cid==11){return 7;}
  if(cid==12){return 2;} if(cid==13){return 5;} if(cid==14){return 6;}
  if(cid==15){return 6;} if(cid==16){return 6;} if(cid==17){return 7;}
  if(cid==18){return 9;} if(cid==19){return 9;} if(cid==20){return 6;}
  if(cid==21){return 9;} if(cid==22){return 4;} if(cid==23){return 5;}
  return 0;
}
fn case_xstar(cid:i32)i32 {
  if(cid<8){return 5;}
  if(cid<20){return 4;}
  if(cid<22){return 5;}
  return 4;
}
fn case_flavor(cid:i32)i32 {
  if(cid<8){return 0;}
  if(cid<12){return 1;}
  if(cid<20){return 2;}
  if(cid<22){return 3;}
  return 4;
}

// ---------- WORLD: frozen true outcomes. Called ONLY from P2 in main. ----------
// The learner functions below never call this (K2 audit).
fn world_y(cid:i32)i32 {
  if(cid==0){return 5;} if(cid==1){return 13;} if(cid==2){return 22;}
  if(cid==3){return 14;} if(cid==4){return 10;} if(cid==5){return 17;}
  if(cid==6){return 10;} if(cid==7){return 18;} if(cid==8){return 16;}
  if(cid==9){return 17;} if(cid==10){return 18;} if(cid==11){return 19;}
  if(cid==12){return 7;} if(cid==13){return 13;} if(cid==14){return 17;}
  if(cid==15){return 11;} if(cid==16){return 15;} if(cid==17){return 17;}
  if(cid==18){return 16;} if(cid==19){return 16;} if(cid==20){return 11;}
  if(cid==21){return 17;} if(cid==22){return 8;} if(cid==23){return 9;}
  return 0;
}

// ---------- LEARNER role ----------
// Commit: affine fit on values, seal (p, t, rmax). No case id, no world.
fn learner_commit(y0:i32, y1:i32, y2:i32, xstar:i32, rec:[]u8, off:i32)void {
  let a_hat:i32=y1-y0;
  let b_hat:i32=y0;
  let r0:i32=abs32(b_hat-y0);
  let r1:i32=abs32(a_hat+b_hat-y1);
  let r2:i32=abs32(a_hat*2+b_hat-y2);
  let rmax:i32=r0;
  if(r1>rmax){rmax=r1;}
  if(r2>rmax){rmax=r2;}
  let t:i32=rmax+1;
  let p:i32=a_hat*xstar+b_hat;
  set32(rec,off+R_P,p);
  set32(rec,off+R_T,t);
  set32(rec,off+R_RMAX,rmax);
  set32(rec,off+R_EPC,1);
  return;
}
// Self-judgment: from sealed (p, t) and the OBSERVED consequence only.
fn learner_judge(ystar:i32, rec:[]u8, off:i32)void {
  let p:i32=get32(rec,off+R_P);
  let t:i32=get32(rec,off+R_T);
  let d:i32=abs32(ystar-p);
  let self:i32=0;
  if(d<=t){self=1;}
  set32(rec,off+R_SELF,self);
  set32(rec,off+R_EPJ,3);
  return;
}
// Control judgment: no consequence access; training fit only.
// Never reads R_YS.
fn learner_control_judge(rec:[]u8, off:i32)void {
  let rmax:i32=get32(rec,off+R_RMAX);
  let selfc:i32=0;
  if(rmax==0){selfc=1;}
  set32(rec,off+R_SELFC,selfc);
  set32(rec,off+R_EPJ,3);
  return;
}

fn main()i32 {
  let recM:[]u8=z_alloc(N_CASES*R_SZ);
  let recC:[]u8=z_alloc(N_CASES*R_SZ);
  let ob:[]u8=z_alloc(8192);
  let at:i32=0;
  let cid:i32=0;
  let off:i32=0;
  // P1 COMMIT (both arms). No consequence exists yet in any data flow.
  cid=0;
  while(cid<N_CASES){
    off=cid*R_SZ;
    let y0:i32=case_y0(cid);
    let y1:i32=case_y1(cid);
    let y2:i32=case_y2(cid);
    let xs:i32=case_xstar(cid);
    learner_commit(y0,y1,y2,xs,recM,off);
    learner_commit(y0,y1,y2,xs,recC,off);
    set32(recC,off+R_YS,YS_SENTINEL);
    cid=cid+1;
  }
  // P2 WORLD (main arm only): reveal consequences.
  cid=0;
  while(cid<N_CASES){
    off=cid*R_SZ;
    let ys:i32=world_y(cid);
    set32(recM,off+R_YS,ys);
    set32(recM,off+R_EPW,2);
    cid=cid+1;
  }
  // P3 JUDGE (main arm with consequence; control arm without).
  cid=0;
  while(cid<N_CASES){
    off=cid*R_SZ;
    let ys:i32=get32(recM,off+R_YS);
    learner_judge(ys,recM,off);
    learner_control_judge(recC,off);
    cid=cid+1;
  }
  // HARNESS: hidden judgments, agreement, bars. Reads records only.
  let agreeM:i32=0;
  let agreeC:i32=0;
  let k1:i32=1;
  at=ob_app(ob,at,"SELFJUDGE-BEGIN\n");
  cid=0;
  while(cid<N_CASES){
    off=cid*R_SZ;
    let p:i32=get32(recM,off+R_P);
    let t:i32=get32(recM,off+R_T);
    let rmax:i32=get32(recM,off+R_RMAX);
    let ys:i32=get32(recM,off+R_YS);
    let self:i32=get32(recM,off+R_SELF);
    let selfc:i32=get32(recC,off+R_SELFC);
    let ysc:i32=get32(recC,off+R_YS);
    let pc:i32=get32(recC,off+R_P);
    let hidden:i32=0;
    if(ys==p){hidden=1;}
    set32(recM,off+R_HIDDEN,hidden);
    let am:i32=0;
    if(self==hidden){am=1;agreeM=agreeM+1;}
    let ac:i32=0;
    if(selfc==hidden){ac=1;agreeC=agreeC+1;}
    // K1: main arm epochs 1<2<3 and identical commits across arms.
    let epc:i32=get32(recM,off+R_EPC);
    let epw:i32=get32(recM,off+R_EPW);
    let epj:i32=get32(recM,off+R_EPJ);
    let f1:i32=0;
    if(epc<epw){f1=1;}
    let f2:i32=0;
    if(epw<epj){f2=1;}
    let f3:i32=0;
    if(p==pc){f3=1;}
    let ok:i32=0;
    if(f1==1){ if(f2==1){ if(f3==1){ ok=1; } } }
    if(ok==0){k1=0;}
    // K1: control arm epochs 1<3 and consequence structurally absent.
    let cepc:i32=get32(recC,off+R_EPC);
    let cepj:i32=get32(recC,off+R_EPJ);
    let g1:i32=0;
    if(cepc<cepj){g1=1;}
    let g2:i32=0;
    if(ysc==YS_SENTINEL){g2=1;}
    let gok:i32=0;
    if(g1==1){ if(g2==1){ gok=1; } }
    if(gok==0){k1=0;}
    at=ob_app(ob,at,"C ");
    at=ob_i32(ob,at,cid);
    at=ob_app(ob,at," flav=");
    at=ob_i32(ob,at,case_flavor(cid));
    at=ob_app(ob,at," p=");
    at=ob_i32(ob,at,p);
    at=ob_app(ob,at," t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," rmax=");
    at=ob_i32(ob,at,rmax);
    at=ob_app(ob,at," ys=");
    at=ob_i32(ob,at,ys);
    at=ob_app(ob,at," self=");
    at=ob_i32(ob,at,self);
    at=ob_app(ob,at," selfc=");
    at=ob_i32(ob,at,selfc);
    at=ob_app(ob,at," hidden=");
    at=ob_i32(ob,at,hidden);
    at=ob_app(ob,at," am=");
    at=ob_i32(ob,at,am);
    at=ob_app(ob,at," ac=");
    at=ob_i32(ob,at,ac);
    at=ob_nl(ob,at);
    cid=cid+1;
  }
  let k3:i32=0;
  if(agreeM>=20){k3=1;}
  let k5:i32=0;
  if(agreeC<=18){k5=1;}
  at=ob_app(ob,at,"MAIN agree=");
  at=ob_i32(ob,at,agreeM);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"CTRL agree=");
  at=ob_i32(ob,at,agreeC);
  at=ob_app(ob,at,"/24\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_nl(ob,at);
  let pass:i32=k1+k3+k5;
  if(pass==3){
    at=ob_app(ob,at,"IN-PROGRAM-BARS 3/3 (K2 K4 K6 shell-audited)\n");
  } else {
    at=ob_app(ob,at,"IN-PROGRAM-BARS-FAIL passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/3\n");
  }
  at=ob_app(ob,at,"SELFJUDGE-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// hyp_a.zag -- Hypothesis A: Residual-Driven Construction.
// Pure Zag. No Python anywhere.
//
// Implements hypothesis A from the architecture review (18be93c3e):
// single growing program P plus explicit residual object R. At each step,
// append the op that best simplifies R under a generic complexity measure.
// No population, no score ranking, no beam.
//
// Prereg: 58c2cc66b (frozen before implementation).
// Battery: 425f7276d. VM frozen as in 8d5f58b89.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn estr(s:[]u8)void { emit(s); return; }
fn enewline()void { emit("\n"); return; }

// ============ program representation ============
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_set_len(p:[]u8, l:i32)void { set32(p, 0, l); return; }
fn prog_op(p:[]u8, i:i32)i32 { return get32(p, 4+i*8); }
fn prog_arg(p:[]u8, i:i32)i32 { return get32(p, 4+i*8+4); }
fn prog_set(p:[]u8, i:i32, op:i32, arg:i32)void {
  set32(p, 4+i*8, op); set32(p, 4+i*8+4, arg); return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}
fn prog_copy(dst:[]u8, src:[]u8)void {
  let l:i32=prog_len(src);
  prog_set_len(dst, l);
  let i:i32=0;
  while(i<l){ prog_set(dst, i, prog_op(src,i), prog_arg(src,i)); i=i+1; }
  return;
}
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=prog_len(p);
  prog_set(p, l, op, arg);
  prog_set_len(p, l+1);
  return;
}

// ============ VM (frozen as in 8d5f58b89, simplified: no library) ============
// Op encoding: 0=PUSH k, 1=IN0, 2=IN1, 3=ADD, 4=SUB, 5=MUL, 6=DIV, 7=MOD,
//   8=NEG, 9=DUP, 10=DROP, 11=SWAP, 12=OVER.
// Hypothesis A uses straight-line ops 0..12 only. No CALL, no jumps.
fn mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a - (a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}
fn vm_run(p:[]u8, pl:i32, in0:i32, in1:i32, stack:[]u8)i32 {
  let sp:i32=0;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    if(pc<0 || pc>=pl){ break; }
    let op:i32=prog_op(p, pc);
    let arg:i32=prog_arg(p, pc);
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack, sp*4, arg); sp=sp+1; }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack, sp*4, in0); sp=sp+1; }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack, sp*4, in1); sp=sp+1; }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a+b); sp=sp+1; }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a-b); sp=sp+1; }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a*b); sp=sp+1; }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==7){ // MOD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==8){ // NEG
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); }
    } else if(op==9){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==10){ // DROP
      if(sp>=1){ sp=sp-1; }
    } else if(op==11){ // SWAP
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); }
    } else if(op==12){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); sp=sp+1; }
    }
  }
  if(sp>0){ return get32(stack, (sp-1)*4); }
  return 0;
}

// ============ residual computation ============
// Compute residual vector R: r_i = t_i - o_i for each episode.
// ein0, ein1, etgt are []u8 of i32s. n is episode count.
// res is output []u8 of n i32s.
fn compute_residual(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32, res:[]u8)void {
  let stack:[]u8=z_alloc(256*4);
  let i:i32=0;
  while(i<n){
    let o:i32=vm_run(p, prog_len(p), get32(ein0,i*4), get32(ein1,i*4), stack);
    let t:i32=get32(etgt,i*4);
    set32(res, i*4, t-o);
    i=i+1;
  }
  return;
}
// Check if residual is all zeros. Returns 1 if yes, 0 if no.
fn residual_is_zero(res:[]u8, n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(get32(res,i*4)!=0){ return 0; }
    i=i+1;
  }
  return 1;
}
// Check if residual is constant. Returns the constant value, or sets
// is_const to 0 if not constant.
fn residual_constant(res:[]u8, n:i32, out_const:[]u8)i32 {
  if(n==0){ set32(out_const,0,0); return 0; }
  let c:i32=get32(res,0);
  let i:i32=1;
  while(i<n){
    if(get32(res,i*4)!=c){ return 0; }
    i=i+1;
  }
  set32(out_const,0,c);
  return 1;
}
// Complexity: distinct_count * 1000000 + range. Lower is simpler.
// Returns complexity as i64.
fn residual_complexity(res:[]u8, n:i32)i64 {
  if(n==0){ return 0; }
  // Find min, max, and count distinct.
  let mn:i32=get32(res,0);
  let mx:i32=get32(res,0);
  let i:i32=1;
  while(i<n){
    let v:i32=get32(res,i*4);
    if(v<mn){ mn=v; }
    if(v>mx){ mx=v; }
    i=i+1;
  }
  // Count distinct by O(n^2) comparison (n is small, max 25).
  let distinct:i32=0;
  i=0;
  while(i<n){
    let v:i32=get32(res,i*4);
    let seen:i32=0;
    let j:i32=0;
    while(j<i){
      if(get32(res,j*4)==v){ seen=1; break; }
      j=j+1;
    }
    if(seen==0){ distinct=distinct+1; }
    i=i+1;
  }
  let range:i32=mx-mn;
  return (distinct as i64)*1000000 + (range as i64);
}

// ============ construction ============
// Try appending op (op,arg) to prog, compute resulting residual complexity.
// Returns complexity. Does not modify prog.
fn try_op_complexity(prog:[]u8, op:i32, arg:i32,
                     ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32)i64 {
  let tmp:[]u8=prog_new(64);
  prog_copy(tmp, prog);
  prog_append(tmp, op, arg);
  let res:[]u8=z_alloc(n*4);
  compute_residual(tmp, ein0, ein1, etgt, n, res);
  return residual_complexity(res, n);
}

// Run residual-driven construction on a task.
// Returns: 1=SUCCESS, 0=FAIL.
// Logs trace to stdout.
// out_prog receives the final program.
// out_evals receives the candidate evaluation count.
fn construct(ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
             out_prog:[]u8, out_evals:[]u8)i32 {
  let prog:[]u8=prog_new(64);
  prog_set_len(prog, 0);
  let evals:i32=0;
  let max_steps:i32=40;
  let step:i32=0;
  let res:[]u8=z_alloc(n*4);
  let const_buf:[]u8=z_alloc(4);
  while(step<max_steps){
    compute_residual(prog, ein0, ein1, etgt, n, res);
    // Log residual vector.
    estr("STEP "); e64(step); estr(" prog_len="); e64(prog_len(prog));
    estr(" residual=[");
    let i:i32=0;
    while(i<n){
      if(i>0){ estr(","); }
      e64(get32(res,i*4));
      i=i+1;
    }
    estr("]");
    // Check success.
    if(residual_is_zero(res, n)==1){
      estr(" SUCCESS\n");
      prog_copy(out_prog, prog);
      set32(out_evals, 0, evals);
      return 1;
    }
    // Check constant residual -> forced PUSH c, ADD.
    if(residual_constant(res, n, const_buf)==1){
      let c:i32=get32(const_buf,0);
      estr(" CONSTANT c="); e64(c);
      if(c<-9 || c>9){
        estr(" FAIL: constant outside PUSH range\n");
        prog_copy(out_prog, prog);
        set32(out_evals, 0, evals);
        return 0;
      }
      estr(" -> PUSH "); e64(c); estr(", ADD\n");
      prog_append(prog, 0, c);
      prog_append(prog, 3, 0);
      step=step+1;
      continue;
    }
    // Otherwise: find best op by complexity.
    let cur_cx:i64=residual_complexity(res, n);
    estr(" complexity="); emit(i64s(cur_cx)); estr("\n");
    let best_cx:i64=cur_cx;
    let best_op:i32=-1;
    let best_arg:i32=0;
    // Try PUSH -9..9.
    let k:i32=-9;
    while(k<=9){
      let cx:i64=try_op_complexity(prog, 0, k, ein0, ein1, etgt, n);
      evals=evals+1;
      if(cx<best_cx){
        best_cx=cx; best_op=0; best_arg=k;
      }
      k=k+1;
    }
    // Try IN0, IN1.
    let cx0:i64=try_op_complexity(prog, 1, 0, ein0, ein1, etgt, n);
    evals=evals+1;
    if(cx0<best_cx){ best_cx=cx0; best_op=1; best_arg=0; }
    let cx1:i64=try_op_complexity(prog, 2, 0, ein0, ein1, etgt, n);
    evals=evals+1;
    if(cx1<best_cx){ best_cx=cx1; best_op=2; best_arg=0; }
    // Try ADD..OVER (3..12).
    let o:i32=3;
    while(o<=12){
      let cx:i64=try_op_complexity(prog, o, 0, ein0, ein1, etgt, n);
      evals=evals+1;
      if(cx<best_cx){
        best_cx=cx; best_op=o; best_arg=0;
      }
      o=o+1;
    }
    if(best_op==-1){
      estr("FAIL: no op reduces complexity\n");
      prog_copy(out_prog, prog);
      set32(out_evals, 0, evals);
      return 0;
    }
    estr("  CHOOSE op="); e64(best_op); estr(" arg="); e64(best_arg);
    estr(" new_cx="); emit(i64s(best_cx)); estr("\n");
    prog_append(prog, best_op, best_arg);
    step=step+1;
    if(evals>1000000){
      estr("FAIL: budget exhausted\n");
      prog_copy(out_prog, prog);
      set32(out_evals, 0, evals);
      return 0;
    }
  }
  estr("FAIL: max steps\n");
  prog_copy(out_prog, prog);
  set32(out_evals, 0, evals);
  return 0;
}

// ============ task episodes ============
// T0: 2x+1, x in 0..8 (9 train)
fn task_t0(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=9;
  let i:i32=0;
  while(i<n){
    let x:i32=i;
    set32(ein0, i*4, x);
    set32(ein1, i*4, 0);
    set32(etgt, i*4, 2*x+1);
    i=i+1;
  }
  return n;
}
// T1: abs, x in -8..8 (17 train)
fn task_t1(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=17;
  let i:i32=0;
  while(i<n){
    let x:i32=i-8;
    set32(ein0, i*4, x);
    set32(ein1, i*4, 0);
    let t:i32=x; if(t<0){ t=-t; }
    set32(etgt, i*4, t);
    i=i+1;
  }
  return n;
}
// T2: mod3, x in 0..16 (17 train)
fn task_t2(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=17;
  let i:i32=0;
  while(i<n){
    let x:i32=i;
    set32(ein0, i*4, x);
    set32(ein1, i*4, 0);
    set32(etgt, i*4, mod_nonneg(x,3));
    i=i+1;
  }
  return n;
}
// T3: parity, a,b in 0..4 (25 train), target 1 if (a+b) even else 0
fn task_t3(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=25;
  let i:i32=0;
  while(i<n){
    let a:i32=i/5;
    let b:i32=i-5*a;
    set32(ein0, i*4, a);
    set32(ein1, i*4, b);
    let t:i32=0;
    if(mod_nonneg(a+b,2)==0){ t=1; }
    set32(etgt, i*4, t);
    i=i+1;
  }
  return n;
}
// T4: nested abs, x in -6..6 (13 train), target ||x|-2|
fn task_t4(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=13;
  let i:i32=0;
  while(i<n){
    let x:i32=i-6;
    set32(ein0, i*4, x);
    set32(ein1, i*4, 0);
    let ax:i32=x; if(ax<0){ ax=-ax; }
    let t:i32=ax-2; if(t<0){ t=-t; }
    set32(etgt, i*4, t);
    i=i+1;
  }
  return n;
}
// T5: fragment composition, x in -4..8 (13 train), target |x|+|x-2|
fn task_t5(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=13;
  let i:i32=0;
  while(i<n){
    let x:i32=i-4;
    set32(ein0, i*4, x);
    set32(ein1, i*4, 0);
    let ax:i32=x; if(ax<0){ ax=-ax; }
    let bx:i32=x-2; if(bx<0){ bx=-bx; }
    set32(etgt, i*4, ax+bx);
    i=i+1;
  }
  return n;
}

// Count exact matches on train.
fn count_exact(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32)i32 {
  let s:i32=0;
  let stack:[]u8=z_alloc(256*4);
  let i:i32=0;
  while(i<n){
    let o:i32=vm_run(p, prog_len(p), get32(ein0,i*4), get32(ein1,i*4), stack);
    if(o==get32(etgt,i*4)){ s=s+1; }
    i=i+1;
  }
  return s;
}
// Print program.
fn print_prog(p:[]u8)void {
  let l:i32=prog_len(p);
  estr("[");
  let i:i32=0;
  while(i<l){
    if(i>0){ estr(", "); }
    let op:i32=prog_op(p,i);
    let arg:i32=prog_arg(p,i);
    // Op names.
    if(op==0){ estr("PUSH "); e64(arg); }
    else if(op==1){ estr("IN0"); }
    else if(op==2){ estr("IN1"); }
    else if(op==3){ estr("ADD"); }
    else if(op==4){ estr("SUB"); }
    else if(op==5){ estr("MUL"); }
    else if(op==6){ estr("DIV"); }
    else if(op==7){ estr("MOD"); }
    else if(op==8){ estr("NEG"); }
    else if(op==9){ estr("DUP"); }
    else if(op==10){ estr("DROP"); }
    else if(op==11){ estr("SWAP"); }
    else if(op==12){ estr("OVER"); }
    else { estr("OP"); e64(op); }
    i=i+1;
  }
  estr("]");
  return;
}

// ============ main ============
fn main()void {
  let ein0:[]u8=z_alloc(25*4);
  let ein1:[]u8=z_alloc(25*4);
  let etgt:[]u8=z_alloc(25*4);
  let prog:[]u8=prog_new(64);
  let evals_buf:[]u8=z_alloc(4);
  let tid:i32=0;
  while(tid<=5){
    let n:i32=0;
    if(tid==0){
      estr("=== T0 2x+1 ===\n");
      n=task_t0(ein0, ein1, etgt);
    } else if(tid==1){
      estr("=== T1 abs ===\n");
      n=task_t1(ein0, ein1, etgt);
    } else if(tid==2){
      estr("=== T2 mod3 ===\n");
      n=task_t2(ein0, ein1, etgt);
    } else if(tid==3){
      estr("=== T3 parity ===\n");
      n=task_t3(ein0, ein1, etgt);
    } else if(tid==4){
      estr("=== T4 nested abs ===\n");
      n=task_t4(ein0, ein1, etgt);
    } else {
      estr("=== T5 fragment composition ===\n");
      n=task_t5(ein0, ein1, etgt);
    }
    prog_set_len(prog, 0);
    let ok:i32=construct(ein0, ein1, etgt, n, prog, evals_buf);
    let exact:i32=count_exact(prog, ein0, ein1, etgt, n);
    estr("RESULT T"); e64(tid);
    estr(": ");
    if(ok==1){ estr("SOLVE"); } else { estr("FAIL"); }
    estr(" exact="); e64(exact); estr("/"); e64(n);
    estr(" evals="); e64(get32(evals_buf,0));
    estr(" prog="); print_prog(prog); estr("\n\n");
    tid=tid+1;
  }
  return;
}

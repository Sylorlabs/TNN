// world.zag -- ORCHARD environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rule and episode tables. The learner never calls
// anything in this file. The driver uses the hidden rule only to
// generate observed labels for teaching.
// Tables match l2_l3_spec/PREREG.md section 3 exactly (amendment A1).

// Phase 0: old-world episodes, 6 readings each (fully filled).
fn w_oldtab()[]u8 { return "100037100082205100202600"; }
fn w_oldid(idx:i32)i32 { return idx+51; }
fn w_oldseq(idx:i32, out:[]u8)void {
  let T:[]u8=w_oldtab();
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Phase 1: ph=1 train (8 episodes x 6 readings), ph=2 test (4 x 6).
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "100049100094100041100014204900209400204100201400";}
  return "100058100032207600202300";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}
// Frozen test labels (driver Z-line true values).
fn w_tlabel(idx:i32)i32 {
  if(idx==0){return 1;}
  if(idx==1){return 0;}
  if(idx==2){return 1;}
  return 0;
}

// Hidden world rule (never visible to the learner).
// PICK iff the kind's signal pair sums >= 10:
// kind 1 uses slots (d,e); kind 2 uses slots (b,c).
fn w_true(k:i32, a:i32, b:i32, c:i32, d:i32, e:i32)i32 {
  if(k==1){
    if(d+e>=10){return 1;}
    return 0;
  }
  if(b+c>=10){return 1;}
  return 0;
}

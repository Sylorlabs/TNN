// learner.zag -- generic L2+L3 combination learner (ORCHARD).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no reduction solution in this file.
// Prereg: l2_l3_spec/PREREG.md (commit 74499703f). Pure Zag.
// 0 modes, 0 handlers, 0 semantic cases, no cross-structure glue.
//
// State layout (u8 buffer, offsets):
//   0: XN   1: LN   2: YN   3: YT_SET
//   4: REPLAY_LEN (learned)   5: ADAPT_ON (driver-set causal control)
//   8..119:   X slots, 16 x 7 bytes [tag,s0,s1,s2,s3,s4], 255 = empty
//   120..151: label slots, 16 x 2 bytes [id,label]
//   152..155: Y threshold i32
//   156..187: M slot, 32 bytes [n,gen,sup,pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   188..219: Mprev slot, 32 bytes (reserved; unused in this build)
//   220..251: Y scalar observations, 16 x 2 bytes [scalar,outcome]
//   252..255: ADAPT-STAT spec_count i32
//   256..259: ADAPT-STAT recall_calls i32
//   260: MASK_K1   261: MASK_K2 (per-kind informative slot bitmasks;
//        bit i set = slot i informative for that kind; slot 0 never set)
//   262..1023: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer) ----
fn x_teach(st:[]u8, id:i32, r0:i32, r1:i32, r2:i32, r3:i32, r4:i32, r5:i32, nfill:i32)void {
  let n:i32=st[0] as i32;
  if(n>=16){return;}
  let o:i32=8+n*7;
  st[o]=id as u8;
  st[o+1]=r0 as u8; st[o+2]=r1 as u8; st[o+3]=r2 as u8;
  st[o+4]=r3 as u8; st[o+5]=r4 as u8; st[o+6]=r5 as u8;
  let k:i32=nfill;
  while(k<6){st[o+1+k]=255;k=k+1;}
  st[0]=(n+1) as u8;
  return;
}
// REPLAY_LEN = longest prefix filled in EVERY taught episode.
fn x_learn_len(st:[]u8)i32 {
  let n:i32=st[0] as i32;
  let L:i32=6;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    let k:i32=0;
    while(k<6){
      if((st[o+1+k] as i32)==255){
        if(k<L){L=k;}
        k=6;
      } else { k=k+1; }
    }
    i=i+1;
  }
  if(n==0){L=0;}
  st[4]=L as u8;
  return L;
}
// x_learn_masks: per-kind informative slot masks (the L2 learning step).
// For kind tag value v in {1,2}, over taught episodes whose slot 0 == v,
// bit i (i in 1..5) is set iff slot i takes at least two distinct values
// across those episodes. Frozen timing: called once after phase-0.
fn x_learn_masks(st:[]u8)void {
  let v:i32=1;
  while(v<=2){
    let mask:i32=0;
    let i:i32=1;
    while(i<=5){
      let seen0:i32=0;
      let first:i32=0;
      let diff:i32=0;
      let e:i32=0;
      let n:i32=st[0] as i32;
      while(e<n){
        let o:i32=8+e*7;
        if((st[o+1] as i32)==v){
          let val:i32=st[o+1+i] as i32;
          if(seen0==0){first=val;seen0=1;}
          else { if(val!=first){diff=1;} }
        }
        e=e+1;
      }
      if(diff==1){mask=mask+(1<<i);}
      i=i+1;
    }
    st[260+v-1]=mask as u8;
    v=v+1;
  }
  return;
}
// x_recall with the L2 SPECIALIZE standing rule. Finds the episode by
// id (0 = unknown). Iff ADAPT_ON==1, reads the kind tag (slot 0) and,
// when the learned mask for that kind is nonzero, replays exactly the
// masked slots in ascending order. Otherwise replays slots 0..L-1
// (the general fixed replay). Returns readings replayed. Trailing out
// slots are zeroed. The rule is evaluated on every recall; the
// researcher never picks it per problem.
fn x_recall(st:[]u8, id:i32, out:[]u8)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    if((st[o] as i32)==id){
      let nr:i32=0;
      let used_spec:i32=0;
      if((st[5] as i32)==1){
        let k:i32=st[o+1] as i32;
        let m:i32=0;
        if(k==1){m=st[260] as i32;}
        else { if(k==2){m=st[261] as i32;} }
        if(m!=0){
          let s:i32=1;
          let bit:i32=2;
          while(s<=5){
            if(((m/bit)%2)==1){out[nr]=st[o+1+s];nr=nr+1;}
            bit=bit*2;
            s=s+1;
          }
          used_spec=1;
        }
      }
      if(used_spec==0){
        let L:i32=st[4] as i32;
        if(L>6){L=6;}
        let k2:i32=0;
        while(k2<L){out[k2]=st[o+1+k2];k2=k2+1;}
        nr=L;
      }
      let z:i32=nr;
      while(z<6){out[z]=0;z=z+1;}
      set32(st,256,get32(st,256)+1);
      if(used_spec==1){set32(st,252,get32(st,252)+1);}
      return nr;
    }
    i=i+1;
  }
  return 0;
}

// ---- labels: observed outcomes ----
fn lab_teach(st:[]u8, id:i32, lab:i32)void {
  let n:i32=st[1] as i32;
  if(n>=16){return;}
  let o:i32=120+n*2;
  st[o]=id as u8; st[o+1]=lab as u8;
  st[1]=(n+1) as u8;
  return;
}
fn lab_get(st:[]u8, id:i32)i32 {
  let n:i32=st[1] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=120+i*2;
    if((st[o] as i32)==id){return st[o+1] as i32;}
    i=i+1;
  }
  return -1;
}

// ---- Y: threshold decide (scalar consumer) ----
fn y_teach(st:[]u8, s:i32, oc:i32)void {
  let n:i32=st[2] as i32;
  if(n>=16){return;}
  let o:i32=220+n*2;
  st[o]=s as u8; st[o+1]=oc as u8;
  st[2]=(n+1) as u8;
  return;
}
fn y_fit(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let bt:i32=0;
  let bs:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<n){
      let o:i32=220+i*2;
      let s:i32=st[o] as i32;
      let oc:i32=st[o+1] as i32;
      let p:i32=0;
      if(s>=t){p=1;}
      if(p==oc){c=c+1;}
      i=i+1;
    }
    if(c>bs){bs=c;bt=t;}
    t=t+1;
  }
  set32(st,152,bt);
  st[3]=1;
  return bs;
}
fn y_decide(st:[]u8, s:i32)i32 {
  if((st[3] as i32)==0){return -1;}
  let t:i32=get32(st,152);
  if(s>=t){return 1;}
  return 0;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0,R1 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, r0:i32, r1:i32, rg:[]u8)i32 {
  set32(rg,0,r0); set32(rg,4,r1);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
fn p_outs(prog:[]u8, n:i32, st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let f:i32=x_recall(st,id,sq);
    let v:i32=-999;
    if(f>0){
      v=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),rg);
    }
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
fn count_correct(vals:[]u8, labs:[]u8, ne:i32, t:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=get32(vals,i*4);
    let p:i32=0;
    if(v>=t){p=1;}
    if(p==(labs[i] as i32)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn best_t_of_vals(vals:[]u8, labs:[]u8, ne:i32, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=count_correct(vals,labs,ne,t);
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}

// ---- construct: greedy program construction from experience ----
// mbuf (24B) gets the final program; mout: [0]=n [4]=threshold [8]=score.
// Trace lines are appended to ob; returns new at.
fn construct(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, init:[]u8, initn:i32, rg:[]u8, sq:[]u8, vals:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  p_outs(cur,cn,st,eids,ne,rg,sq,vals);
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  let bt:i32=get32(bto,0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<2){
          let s:i32=0;
          while(s<2){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            p_outs(cand,cn+1,st,eids,ne,rg,sq,vals);
            let cto:[]u8=z_alloc(4);
            let cs:i32=best_t_of_vals(vals,labs,ne,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      at=ob_app(ob,at,"C-ROUND ");
      at=ob_i32(ob,at,round);
      at=ob_app(ob,at," base=");
      at=ob_i32(ob,at,bs);
      at=ob_app(ob,at," eval=");
      at=ob_i32(ob,at,neval);
      if(bg>0){
        at=ob_app(ob,at," win=");
        at=ob_i32(ob,at,bop);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bd);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bss);
        at=ob_app(ob,at," gain=");
        at=ob_i32(ob,at,bg);
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        p_outs(cur,cn,st,eids,ne,rg,sq,vals);
        bs=best_t_of_vals(vals,labs,ne,bto);
        bt=get32(bto,0);
        at=ob_app(ob,at," score=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,bt);
        at=ob_nl(ob,at);
      } else {
        at=ob_app(ob,at," stop");
        at=ob_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[156]=n as u8; st[157]=gen as u8; st[158]=0; st[159]=0;
  set32(st,160,t);
  let k:i32=0;
  while(k<24){st[164+k]=prog[k];k=k+1;}
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[156+k]=0;k=k+1;}
  return;
}

// ---- decide: X -> M -> Y; -1 = NO_DECISION ----
fn decide(st:[]u8, id:i32, rg:[]u8, sq:[]u8)i32 {
  let nr:i32=x_recall(st,id,sq);
  if(nr==0){return -1;}
  let mn:i32=st[156] as i32;
  if(mn==0){return -1;}
  if((st[3] as i32)==0){return -1;}
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[164+k];k=k+1;}
  let s:i32=p_exec(mprog,mn,(sq[0] as i32),(sq[1] as i32),rg);
  return y_decide(st,s);
}

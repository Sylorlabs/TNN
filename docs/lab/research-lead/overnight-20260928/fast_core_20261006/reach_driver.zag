// Appended to unchanged frozen core before test battery.
fn cl(S:[]u8)[]u8 {let W:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){W[i]=S[i];i=i+1;}return W;}
fn met(name:[]u8,v:i32)void {emit(name);e64(v);return;}
fn main()i32 {
  let unexpected:i32=0;let rename:i32=0;
  while(rename<2){let off:i32=rename*1000;
    let H:[]u8=z_alloc(WSZ());tnn2_init(H);let one:i32=t2_inc(H,0);
    let two:i32=t2_inc(H,0);let last:i32=t2_inc(H,0);seq_link(H,two,last);
    let onen:i32=0;let twon:i32=0;let x:i32=0;
    while(x<8){let a:i32=t2_exec(H,one,x);let b:i32=t2_exec(H,two,x);if(a==x+1){onen=onen+1;}if(b==x+2){twon=twon+1;}x=x+1;}
    met("ISA rename=",rename);met(" increment_correct=",onen);met(" increment_twice_correct=",twon);emit("\n");
    if(onen!=8 || twon!=8){unexpected=unexpected+1;}
    let W:[]u8=z_alloc(WSZ());tnn2_init(W);ev_observe(W,0,11+off,1);ev_observe(W,1,12+off,2);
    let snapshot:[]u8=cl(W);let answer:i32=ev_query(W,0,99+off,2,0);let map:i32=-1;let n:i32=2;
    while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==99+off){map=n;}n=n+1;}
    if(map<0){unexpected=unexpected+1;met("missing_MAP=",rename);emit("\n");}
    else {
      let root:i32=ng(W,map,20);let old:i32=t2_exec(W,root,0);let new:i32=t2_exec(W,root,3);
      let A:[]u8=cl(snapshot);let B:[]u8=cl(snapshot);
      let oldtrial:i32=t2_trial(A,0,99+off,2,0,0,0);let newtrial:i32=t2_trial(B,3,99+off,5,0,0,0);
      met("proposal rename=",rename);met(" acquired_answer=",answer);met(" literal_original=",old);met(" literal_new=",new);
      met(" old_trial=",oldtrial);met(" heldout_trial=",newtrial);emit("\n");
      if(answer!=2 || old!=2 || new!=-999999 || oldtrial!=2 || newtrial!=-2){unexpected=unexpected+1;}
    }
    let G:[]u8=z_alloc(WSZ());tnn2_init(G);let inc1:i32=t2_inc(G,0);let inc2:i32=t2_inc(G,0);seq_link(G,inc1,inc2);
    let facts:[]u8=z_alloc(4);let promoted:i32=promote_graph(G,inc1,0,100+off,2,facts,0);
    let direct:i32=t2_exec(G,inc1,3);let api:i32=ev_query(G,3,100+off,-2,0);
    let cached:i32=ev_query(G,0,100+off,-2,0);
    met("readout rename=",rename);met(" hand_MAP=",promoted);met(" direct_new=",direct);met(" API_new=",api);met(" API_cached=",cached);emit("\n");
    if(promoted<0 || direct!=5 || api!=-2 || cached!=2){unexpected=unexpected+1;}
    rename=rename+1;
  }
  met("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;
}

// rawmatter_rawbytes.zag — test raw BYTE material directly (not TNN workspace structure)
// H-organized: raw bytes form sparse partitioned coherent web
// H-hostile: raw bytes are loose, organization is classifier artifact

fn clone(S:[]u8)[]u8 { let W:[]u8=z_alloc(S.len); let i:i32=0;
  while(i<S.len){ W[i]=S[i]; i=i+1; } return W; }

fn fingerprint_bytes(buf:[]u8,off:i32,len:i32)i32 {
  let i:i32=0; let v:i32=0;
  while(i<len && off+i<buf.len){
    v=(v+(buf[off+i] as i32)*(i%251+1))%1000000007; i=i+1;
  }
  return v;
}

fn met(v:i32)void { e64(v); emit("\n"); return; }
fn met_s(s:[]u8)void { emit(s); return; }

// Criterion A: sparse partition of raw bytes by bit-shift classification
// Region 7 test: bytes where (x>>1) != x form one region, others another
// Sparse = not all bytes in same class, and classes have internal structure
fn criterion_A_raw(buf:[]u8) i32 {
  let total:i32=buf.len;
  if(total<128){ met_s("A: buffer too small"); return 0; }

  // Classify each byte by (x>>1) vs x
  // Region 7: bytes where x>>1 gives different "region" than x itself
  let region7_members:i32=0;
  let region7_nonmembers:i32=0;
  let region7_values:[]u8=z_alloc(256);
  let nonmember_values:[]u8=z_alloc(256);
  let ri:i32=0; let ni:i32=0;
  let i:i32=0;
  while(i<total && i<1024){
    let b:u8=buf[i];
    // x>>1 classification: shift right 1 bit
    let shifted:u8=b>>1;
    // Region membership: does this byte's shifted value differ from itself?
    // This is the bit-shift test from the hypothesis
    if(shifted!=b){
      if(region7_members<256){ region7_values[region7_members]=b; }
      region7_members=region7_members+1;
    } else {
      if(region7_nonmembers<256){ nonmember_values[region7_nonmembers]=b; }
      region7_nonmembers=region7_nonmembers+1;
    }
    i=i+1;
  }

  met_s("A: total_bytes "); met(total);
  met_s("A: region7_members (x>>1 != x): "); met(region7_members);
  met_s("A: region7_nonmembers (x>>1 == x): "); met(region7_nonmembers);

  // Sparse partition: both regions non-empty, neither dominates completely
  let sparse:i32=0;
  if(region7_members>0 && region7_nonmembers>0){
    // Check neither is >90% (that would be dense, not sparse)
    let member_pct:i32=region7_members*100/total;
    let nonmember_pct:i32=region7_nonmembers*100/total;
    if(member_pct<90 && nonmember_pct<90){ sparse=1; }
  }

  met_s("A: sparse_partition: "); if(sparse==1){ met_s("YES"); } else { met_s("NO"); }

  // Internal structure: are region7 members clustered or spread?
  // Compute fingerprint of region7 member bytes
  if(region7_members>0){
    let fp:i32=fingerprint_bytes(buf,0,region7_members);
    met_s("A: region7_fp: "); met(fp);
  }

  return sparse;
}

// Criterion B: distinct membership functions for X[0..4] and Y[0..3]
// Test that different byte ranges produce distinct classification maps
fn criterion_B_raw(buf:[]u8) i32 {
  let total:i32=buf.len;
  if(total<64){ met_s("B: buffer too small"); return 0; }

  // X-range: bytes 0..4 (first 5 bytes as indices)
  // Y-range: bytes 0..3 (first 4 bytes)
  // For each, compute a classification fingerprint

  let x_fp:i32=0; let y_fp:i32=0;
  let x_classes:i32=0; let y_classes:i32=0;

  // X classification: use bytes at indices 0,1,2,3,4 as classifiers
  let xi:i32=0;
  while(xi<5 && xi<total){
    let b:u8=buf[xi];
    // Classify by nibble overlay (high nibble vs low nibble)
    let hi:u8=(b>>4)&0xF;
    let lo:u8=b&0xF;
    if(hi!=lo){ x_classes=x_classes+1; }
    x_fp=(x_fp+(b as i32)*(xi%251+1))%1000000007;
    xi=xi+1;
  }

  // Y classification: use bytes at indices 0,1,2,3
  let yi:i32=0;
  while(yi<4 && yi<total){
    let b:u8=buf[yi];
    let hi:u8=(b>>4)&0xF;
    let lo:u8=b&0xF;
    if(hi!=lo){ y_classes=y_classes+1; }
    y_fp=(y_fp+(b as i32)*(yi%251+1))%1000000007;
    yi=yi+1;
  }

  met_s("B: x_range_fp: "); met(x_fp);
  met_s("B: y_range_fp: "); met(y_fp);
  met_s("B: x_classes: "); met(x_classes);
  met_s("B: y_classes: "); met(y_classes);

  // Distinctness: X and Y fingerprints differ, classification maps differ
  let distinct:i32=0;
  if(x_fp!=y_fp && x_classes!=y_classes){ distinct=1; }

  met_s("B: distinct_maps: "); if(distinct==1){ met_s("YES"); } else { met_s("NO"); }

  return distinct;
}

// Criterion C: material witness via FP index
// Walk byte ranges, compute fingerprints, check for structured distribution
fn criterion_C_raw(buf:[]u8) i32 {
  let total:i32=buf.len;
  if(total<256){ met_s("C: buffer too small"); return 0; }

  // Sample fingerprints from 64 byte windows across the buffer
  let num_windows:i32=64;
  let window_size:i32=4;
  let fps:[]u8=z_alloc(num_windows*4);
  let fp_count:i32=0;
  let i:i32=0;

  while(i<total-window_size && fp_count<num_windows){
    let fp:i32=fingerprint_bytes(buf,i,window_size);
    set32(fps,fp_count*4,fp);
    fp_count=fp_count+1;
    i=i+window_size;
  }

  met_s("C: windows_sampled: "); met(fp_count);

  // Count unique fingerprints
  let unique:i32=0;
  let a:i32=0;
  while(a<fp_count){
    let is_dup:i32=0;
    let b:i32=0;
    while(b<a){
      if(get32(fps,a*4)==get32(fps,b*4)){ is_dup=1; }
      b=b+1;
    }
    if(is_dup==0){ unique=unique+1; }
    a=a+1;
  }

  met_s("C: unique_fps: "); met(unique);

  // Structured material: high uniqueness ratio indicates non-random byte distribution
  let ratio:i32=0;
  if(fp_count>0){ ratio=unique*100/fp_count; }
  met_s("C: uniqueness_pct: "); met(ratio);

  // Also check: are consecutive fingerprints correlated (smooth) or random?
  let transitions:i32=0;
  let ci:i32=1;
  while(ci<fp_count){
    let prev:i32=get32(fps,(ci-1)*4);
    let cur:i32=get32(fps,ci*4);
    if(cur!=prev){ transitions=transitions+1; }
    ci=ci+1;
  }

  let transition_pct:i32=0;
  if(fp_count>1){ transition_pct=transitions*100/(fp_count-1); }
  met_s("C: transition_pct: "); met(transition_pct);

  // Material witness: structured = high uniqueness AND moderate transitions
  // (neither all-same nor all-random)
  let material:i32=0;
  if(ratio>60 && transition_pct>20 && transition_pct<90){ material=1; }

  met_s("C: material_witness: "); if(material==1){ met_s("YES"); } else { met_s("NO"); }

  return material;
}

fn main()i32 {
  // Build a raw byte buffer with intentional structure
  // Mix of patterned and random-ish bytes to test hypothesis
  let buf:[]u8=z_alloc(1024);

  // Fill with structured data: repeating patterns, gradients, clusters
  let i:i32=0;
  while(i<1024){
    // Create regions: different byte patterns in different ranges
    if(i<256){
      // Region 1: gradient 0,1,2,3,...
      buf[i]=(i as u8);
    } else if(i<512){
      // Region 2: alternating 0xAA, 0x55
      if(i%2==0){ buf[i]=0xAA; } else { buf[i]=0x55; }
    } else if(i<768){
      // Region 3: clustered values around 0x80
      buf[i]=((i%64)+128) as u8;
    } else {
      // Region 4: sparse high values
      buf[i]=((i%32)*8) as u8;
    }
    i=i+1;
  }

  met_s("=== RAW BYTE MATERIAL HYPOTHESIS TEST ===\n");

  let a:i32=criterion_A_raw(buf);
  met_s("\n");
  let b:i32=criterion_B_raw(buf);
  met_s("\n");
  let c:i32=criterion_C_raw(buf);
  met_s("\n");

  met_s("=== VERDICT ===\n");
  if(a==1 && b==1 && c==1){
    met_s("H-organized: raw bytes form sparse partitioned coherent web\n");
    met_s("The byte material exhibits intrinsic sparse partition,\n");
    met_s("distinct regional classification, and structured FP distribution.\n");
    return 0;
  } else if(a==1 && b==1){
    met_s("PARTIAL: A+B hold, C fails\n");
    return 0;
  } else if(a==1){
    met_s("WEAK: only sparse partition, no distinct membership or witness\n");
    return 0;
  } else {
    met_s("H-hostile: raw bytes show no intrinsic organization\n");
    met_s("Any apparent structure is artifact of classification method.\n");
    return 0;
  }
}

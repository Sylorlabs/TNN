// Appended to unchanged frozen core before test battery.
// Prototype object arena, NOT core learner state. Header count/libcount/rename.
fn og(S:[]u8,n:i32,f:i32)i32 {return get32(S,1024+n*288+f);}
fn os(S:[]u8,n:i32,f:i32,v:i32)void {set32(S,1024+n*288+f,v);return;}
fn met(s:[]u8,v:i32)void {emit(s);e64(v);return;}
fn clone(S:[]u8)[]u8 {let D:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){D[i]=S[i];i=i+1;}return D;}
fn checksum(S:[]u8)i32 {let i:i32=0;let v:i32=0;while(i<S.len){v=(v+(S[i] as i32)*(i%251+1))%1000000007;i=i+1;}return v;}
fn alloc(S:[]u8)i32 {let n:i32=get32(S,0);if(n>=200){return -1;}set32(S,0,n+1);return n;}
fn primitive(S:[]u8,semantic:i32)i32 {
  let n:i32=alloc(S);let tag:i32=semantic;if(get32(S,8)==1){tag=3-semantic;}
  os(S,n,0,tag);os(S,n,12,1);os(S,n,16,1);os(S,n,24,tag);return n;
}
fn libadd(S:[]u8,n:i32)void {let k:i32=get32(S,4);set32(S,64+k*4,n);set32(S,4,k+1);return;}
fn initial(rename:i32)[]u8 {
  let S:[]u8=z_alloc(65536);set32(S,8,rename);set32(S,0,rename*3);
  let a:i32=primitive(S,1);let b:i32=primitive(S,2);libadd(S,a);libadd(S,b);return S;
}
fn effect(S:[]u8,tag:i32,x:i32,W:[]u8)i32 {
  set32(W,4,get32(W,4)+1);let semantic:i32=tag;if(get32(S,8)==1){semantic=3-tag;}
  if(semantic==1){return x+1;}return x*2;
}
fn run(S:[]u8,n:i32,x:i32,W:[]u8)i32 {
  if(n<0 || n>=get32(S,0)){return -999999;}
  let tag:i32=og(S,n,0);if(tag==1 || tag==2){return effect(S,tag,x,W);}
  if(tag==3){return run(S,og(S,n,8),run(S,og(S,n,4),x,W),W);}
  if(tag==4){let i:i32=0;let v:i32=x;while(i<og(S,n,12)){v=effect(S,og(S,n,24+i*4),v,W);i=i+1;}return v;}
  return -999999;
}
fn join(S:[]u8,a:i32,b:i32)i32 {
  let n:i32=alloc(S);if(n<0){return -1;}let la:i32=og(S,a,12);let lb:i32=og(S,b,12);
  if(la+lb>64){return -1;}os(S,n,0,3);os(S,n,4,a);os(S,n,8,b);os(S,n,12,la+lb);
  let d:i32=og(S,a,16);if(og(S,b,16)>d){d=og(S,b,16);}os(S,n,16,d+1);
  let i:i32=0;while(i<la){os(S,n,24+i*4,og(S,a,24+i*4));i=i+1;}
  i=0;while(i<lb){os(S,n,24+(la+i)*4,og(S,b,24+i*4));i=i+1;}return n;
}
fn observations(a:i32,b:i32)[]u8 {let F:[]u8=z_alloc(24);let i:i32=0;while(i<3){let x:i32=-2+i*2;set32(F,i*8,x);set32(F,i*8+4,a*x+b);i=i+1;}return F;}
fn sequence(S:[]u8,T:[]u8,len:i32,x:i32,W:[]u8)i32 {let i:i32=0;let v:i32=x;while(i<len){v=run(S,get32(T,i*4),v,W);i=i+1;}return v;}
fn fits(S:[]u8,T:[]u8,len:i32,F:[]u8,W:[]u8)i32 {
  let i:i32=0;while(i<3){if(sequence(S,T,len,get32(F,i*8),W)!=get32(F,i*8+4)){return 0;}i=i+1;}return 1;
}
// W: candidate tests / primitive effects / winning composite reads / allocated joins.
fn acquire(S:[]u8,F:[]u8,W:[]u8)i32 {
  let k:i32=get32(S,4);let T:[]u8=z_alloc(24);let len:i32=1;let cap:i32=k;
  while(len<=6 && get32(W,0)<4096){let id:i32=0;
    while(id<cap && get32(W,0)<4096){let code:i32=id;let pos:i32=len-1;
      while(pos>=0){set32(T,pos*4,get32(S,64+(code%k)*4));code=code/k;pos=pos-1;}
      set32(W,0,get32(W,0)+1);
      if(fits(S,T,len,F,W)==1){let root:i32=get32(T,0);let j:i32=0;
        while(j<len){if(og(S,get32(T,j*4),12)>1){set32(W,8,get32(W,8)+1);}j=j+1;}
        j=1;while(j<len){root=join(S,root,get32(T,j*4));set32(W,12,get32(W,12)+1);j=j+1;}
        libadd(S,root);return root;
      }id=id+1;
    }len=len+1;if(cap<4096){cap=cap*k;if(cap>4096){cap=4096;}}
  }return -1;
}
fn flat(S:[]u8)void {let n:i32=0;while(n<get32(S,0)){if(og(S,n,0)==3){os(S,n,0,4);}n=n+1;}return;}
fn correct(S:[]u8,root:i32,a:i32,b:i32)i32 {let x:i32=5;let n:i32=0;let W:[]u8=z_alloc(16);while(x<=12){if(run(S,root,x,W)==a*x+b){n=n+1;}x=x+1;}return n;}
fn factlookup(F:[]u8,x:i32)i32 {let i:i32=0;while(i<3){if(get32(F,i*8)==x){return get32(F,i*8+4);}i=i+1;}return -999999;}
// Supplemental strong rival: supplied affine interpolation, not learned syntax.
fn affinecorrect(F:[]u8,a:i32,b:i32)i32 {
  let slope:i32=(get32(F,20)-get32(F,4))/4;let offset:i32=get32(F,12);let x:i32=5;let n:i32=0;
  while(x<=12){if(slope*x+offset==a*x+b){n=n+1;}x=x+1;}return n;
}
fn armtest(Base:[]u8,rename:i32,arm:i32,prior:i32,Results:[]u8)i32 {
  let S:[]u8=clone(Base);let priorwork:i32=prior;let prioreffects:i32=get32(Base,16);let P:[]u8=z_alloc(16);
  if(arm==1){set32(S,4,2);let n:i32=0;while(n<get32(S,0)){if(og(S,n,0)==3){os(S,n,0,0);}n=n+1;}}if(arm==2){flat(S);}
  if(arm>=3){S=initial(rename);priorwork=0;prioreffects=0;
    if(arm==3){acquire(S,observations(1,2),P);priorwork=get32(P,0);prioreffects=get32(P,4);}
    if(arm==4){acquire(S,observations(2,2),P);priorwork=get32(P,0);prioreffects=get32(P,4);}}
  let W1:[]u8=z_alloc(16);let W2:[]u8=z_alloc(16);let before:i32=checksum(S);
  let F1:[]u8=observations(8,7);let C:i32=acquire(S,F1,W1);if(arm==2){flat(S);}
  let F2:[]u8=observations(4,6);let D:i32=acquire(S,F2,W2);if(arm==2){flat(S);}
  let cc:i32=correct(S,C,8,7);let dc:i32=correct(S,D,4,6);let NoFacts:[]u8=clone(S);let fb:i32=896;
  while(fb<944){NoFacts[fb]=0;fb=fb+1;}let nofactcorrect:i32=correct(NoFacts,C,8,7)+correct(NoFacts,D,4,6);
  let affine:i32=affinecorrect(F1,8,7)+affinecorrect(F2,4,6);let Lesion:[]u8=clone(S);os(Lesion,C,0,0);let erased:i32=correct(Lesion,C,8,7);let facts:i32=0;let x:i32=5;
  while(x<=12){if(factlookup(F1,x)==8*x+7){facts=facts+1;}x=x+1;}
  met("objects rename=",rename);met(" arm=",arm);met(" beforefp=",before);met(" afterfp=",checksum(S));met(" prior_tests=",priorwork);
  met(" C_tests=",get32(W1,0));met(" D_tests=",get32(W2,0));met(" total_tests=",priorwork+get32(W1,0)+get32(W2,0));met(" prior_effects=",prioreffects);met(" total_effects=",prioreffects+get32(W1,4)+get32(W2,4));
  met(" C_effects=",get32(W1,4));met(" D_effects=",get32(W2,4));met(" C_composite_reads=",get32(W1,8));met(" D_composite_reads=",get32(W2,8));
  met(" newjoins=",get32(W1,12)+get32(W2,12));met(" C_len=",og(S,C,12));met(" C_depth=",og(S,C,16));met(" D_len=",og(S,D,12));met(" D_depth=",og(S,D,16));
  met(" C_correct=",cc);met(" D_correct=",dc);met(" facts_only=",facts);met(" erased=",erased);met(" facts_erased_correct=",nofactcorrect);met(" affine_correct=",affine);emit(" runtime=unavailable authority=unavailable\n");
  let priorfactdiff:i32=0;let fi:i32=896;while(fi<944){if(S[fi]!=Base[fi]){priorfactdiff=priorfactdiff+1;}fi=fi+1;}
  met("prior_fact_bytes_changed arm=",arm);met(" rename=",rename);met(" differences=",priorfactdiff);emit("\n");
  set32(Results,arm*8,get32(W1,0));set32(Results,arm*8+4,get32(W2,0));let errors:i32=0;
  if(cc!=8 || dc!=8 || facts!=0 || erased!=0 || nofactcorrect!=16 || affine!=16){errors=errors+1;}
  if(arm<=2 && priorfactdiff!=0){errors=errors+1;}
  if(arm==0){let Old:[]u8=clone(S);let RW:[]u8=z_alloc(16);let R:i32=acquire(S,observations(8,14),RW);
    let revised:i32=correct(S,R,8,14);let stale:i32=correct(S,C,8,14);let retained:i32=correct(S,D,4,6);let changes:i32=0;let n:i32=0;
    while(n<get32(Old,0)){let f:i32=0;while(f<288){if(og(S,n,f)!=og(Old,n,f)){changes=changes+1;}f=f+4;}n=n+1;}
    met("revision rename=",rename);met(" tests=",get32(RW,0));met(" revised=",revised);met(" stale=",stale);met(" retainedD=",retained);met(" old_object_changes=",changes);emit("\n");
    if(revised!=8 || stale!=0 || retained!=8 || changes!=0){errors=errors+1;}}
  return errors;
}
fn renamed(rename:i32)i32 {
  let S:[]u8=initial(rename);let FA:[]u8=observations(2,1);let FB:[]u8=observations(2,2);let fi:i32=0;
  while(fi<24){S[896+fi]=FA[fi];S[920+fi]=FB[fi];fi=fi+1;}
  let W:[]u8=z_alloc(16);let A:i32=acquire(S,FA,W);let prior:i32=get32(W,0);let prioreffects:i32=get32(W,4);
  W=z_alloc(16);let B:i32=acquire(S,FB,W);prior=prior+get32(W,0);set32(S,16,prioreffects+get32(W,4));let errors:i32=0;
  met("prior rename=",rename);met(" A=",A);met(" B=",B);met(" tests=",prior);emit("\n");
  if(correct(S,A,2,1)!=8 || correct(S,B,2,2)!=8){errors=errors+1;}
  let Results:[]u8=z_alloc(48);let arm:i32=0;while(arm<6){errors=errors+armtest(S,rename,arm,prior,Results);arm=arm+1;}
  if(get32(Results,0)!=get32(Results,16) || get32(Results,4)!=get32(Results,20)){errors=errors+1;}
  if(get32(Results,8)!=get32(Results,40) || get32(Results,12)!=get32(Results,44)){errors=errors+1;}return errors;
}
fn main()i32 {let errors:i32=renamed(0)+renamed(1);met("instrumentation_unexpected=",errors);emit("\n");if(errors!=0){return 1;}return 0;}

// Appended to unchanged frozen TNN-2 core before test battery.
fn countmaps(W:[]u8)i32 {let n:i32=2;let count:i32=0;while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==20){count=count+1;}n=n+1;}return count;}
fn fixture(W:[]u8,offset:i32)void {
  tnn2_init(W);ev_observe(W,101+offset,11+offset,201+offset);ev_observe(W,201+offset,12+offset,31);
  ev_observe(W,101+offset,13+offset,202+offset);ev_observe(W,202+offset,14+offset,32);return;
}
fn metric(name:[]u8,value:i32)void {emit(name);e64(value);return;}
fn main()i32 {
  let unexpected:i32=0;let rename:i32=0;
  while(rename<2){let offset:i32=rename*1000;let arm:i32=0;
    let first31:i32=-9999;let first32:i32=-9999;
    while(arm<5){
      let W:[]u8=z_alloc(WSZ());fixture(W,offset);let initialmaps:i32=countmaps(W);
      let expected:i32=31;let flags:i32=0;
      if(arm==1){expected=32;}if(arm==2){expected=-2;}if(arm==3){expected=-2;flags=1;}if(arm==4){expected=9999;}
      let answer:i32=ev_query(W,101+offset,99+offset,expected,flags);
      metric("core rename=",rename);metric(" arm=",arm);metric(" expected=",expected);metric(" flags=",flags);
      metric(" initial_maps=",initialmaps);metric(" answer=",answer);metric(" maps_after=",countmaps(W));metric(" trial_stats=",hg(W,16));emit("\n");
      if(initialmaps!=0){unexpected=unexpected+1;}
      if(arm==0){
        first31=answer;let repeat:i32=ev_query(W,101+offset,99+offset,32,0);
        let heldout:i32=ev_query(W,101+offset,100+offset,32,0);
        metric("cache rename=",rename);metric(" repeated_expected32=",repeat);metric(" new_relation_expected32=",heldout);emit("\n");
        if(repeat!=31){unexpected=unexpected+1;}
      }
      if(arm==1){first32=answer;}
      arm=arm+1;
    }
    if(first31!=31 || first32!=32 || first31==first32){unexpected=unexpected+1;}
    rename=rename+1;
  }
  metric("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;
}

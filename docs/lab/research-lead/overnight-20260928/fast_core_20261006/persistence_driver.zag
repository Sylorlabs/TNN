// Appended to unchanged frozen core before test battery.
fn count(W:[]u8,category:i32)i32 {
  let n:i32=0;let total:i32=0;
  while(n<1024){if(ng(W,n,36)==1){let ty:i32=ng(W,n,0);let include:i32=0;
    if(category==0){include=1;}if(category==1 && ty==1){include=1;}if(category==2 && ty==20){include=1;}
    if(category==3 && ty>=101 && ty<=104){include=1;}if(category==4 && ty==902){include=1;}
    if(include==1){total=total+1;}}
    n=n+1;
  }return total;
}
fn met(name:[]u8,v:i32)void {emit(name);e64(v);return;}
fn snapshot(W:[]u8,arm:i32,step:i32,answer:i32)void {
  met("persistence arm=",arm);met(" step=",step);met(" answer=",answer);met(" live=",count(W,0));met(" facts=",count(W,1));
  met(" MAP=",count(W,2));met(" instructions=",count(W,3));met(" scratch902=",count(W,4));met(" header_alloc=",hg(W,20));emit("\n");return;
}
fn main()i32 {
  let unexpected:i32=0;let arm:i32=0;
  while(arm<4){let W:[]u8=z_alloc(WSZ());tnn2_init(W);
    ev_observe(W,101,11,201);ev_observe(W,201,12,31);ev_observe(W,101,13,202);ev_observe(W,202,14,32);
    snapshot(W,arm,0,-99999);let previous:i32=count(W,3);let first:i32=-1;let step:i32=1;
    while(step<=4){let answer:i32=-2;
      if(arm==0){answer=ev_query(W,101,99,9999,0);}
      if(arm==1){answer=t2_trial(W,101,99,9999,0,0,0);}
      if(arm==2){let expected:i32=-2;if(step==1){expected=31;}answer=ev_query(W,101,99,expected,0);}
      if(arm==3){answer=ev_query(W,101,11,-2,0);}
      snapshot(W,arm,step,answer);let instructions:i32=count(W,3);
      if(arm<=1){if(answer!=-2 || count(W,2)!=0 || instructions<=previous){unexpected=unexpected+1;}}
      if(arm==2){if(step==1){first=instructions;}if(answer!=31 || count(W,2)!=1 || instructions!=first){unexpected=unexpected+1;}}
      if(arm==3){if(answer!=201 || count(W,2)!=0 || instructions!=0){unexpected=unexpected+1;}}
      previous=instructions;step=step+1;
    }arm=arm+1;
  }
  met("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;
}

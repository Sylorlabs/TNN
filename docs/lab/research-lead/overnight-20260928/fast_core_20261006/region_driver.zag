// Appended to unchanged frozen core before test battery.
fn clone(S:[]u8)[]u8 {let W:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){W[i]=S[i];i=i+1;}return W;}
fn diffbytes(A:[]u8,B:[]u8)i32 {let i:i32=0;let n:i32=0;while(i<A.len){if(A[i]!=B[i]){n=n+1;}i=i+1;}return n;}
fn fingerprint(W:[]u8)i32 {let i:i32=0;let v:i32=0;while(i<W.len){v=(v+(W[i] as i32)*(i%251+1))%1000000007;i=i+1;}return v;}
fn count(W:[]u8,ty:i32)i32 {let n:i32=0;let total:i32=0;while(n<NN()){if(ng(W,n,36)==1){if(ty==-1 || ng(W,n,0)==ty){total=total+1;}}n=n+1;}return total;}
fn edges(W:[]u8,ty:i32)i32 {let e:i32=0;let total:i32=0;while(e<NE()){if(eg(W,e,0)!=-1){if(ty==-1 || eg(W,e,4)==ty){total=total+1;}}e=e+1;}return total;}
fn endpoint(W:[]u8,n:i32)i32 {if(n<0 || n>=NN()){return 0;}return ng(W,n,36);}
fn dangling(W:[]u8)i32 {let e:i32=0;let n:i32=0;while(e<NE()){if(eg(W,e,0)!=-1){if(endpoint(W,eg(W,e,0))!=1 || endpoint(W,eg(W,e,8))!=1){n=n+1;}}e=e+1;}return n;}
fn met(s:[]u8,v:i32)void {emit(s);e64(v);return;}
fn erase(W:[]u8,n:i32)void {
  ns(W,n,36,0);hs(W,20,hg(W,20)-1);let e:i32=0;
  while(e<NE()){if(eg(W,e,0)!=-1){if(eg(W,e,0)==n || eg(W,e,8)==n){es(W,e,0,-1);hs(W,24,hg(W,24)-1);}}e=e+1;}return;
}
fn organize(W:[]u8,arm:i32,G:[]u8,F:[]u8,map:i32,answerfact:i32)void {
  let a:i32=get32(G,0);let b:i32=get32(G,4);let c:i32=get32(G,8);
  if(arm==3){return;}
  if(arm==1){link_edge(W,a,10,get32(F,8),0);link_edge(W,a,10,get32(F,12),0);link_edge(W,b,10,c,0);return;}
  if(arm==5){link_edge(W,a,10,c,0);link_edge(W,b,10,c,0);}
  else {link_edge(W,a,10,b,0);link_edge(W,b,10,c,0);}
  let f0:i32=get32(F,8);let f1:i32=get32(F,12);
  if(arm==2){f0=get32(F,0);f1=get32(F,4);}
  if(arm==6){f0=map;f1=answerfact;}
  link_edge(W,c,10,f0,0);link_edge(W,c,10,f1,0);
  if(arm==4){erase(W,get32(F,12));}return;
}
fn factcheck(W:[]u8,F:[]u8,arm:i32,off:i32)i32 {
  let i:i32=0;let errors:i32=0;
  while(i<4){let n:i32=get32(F,i*4);let expected:i32=201+off;
    if(i==1){expected=31+off;}if(i==2){expected=401+off;}if(i==3){expected=41+off;}
    if(arm==4 && i==3){if(ng(W,n,36)!=0){errors=errors+1;}}
    else {if(ng(W,n,36)!=1 || ng(W,n,0)!=1 || ng(W,n,28)!=expected){errors=errors+1;}}
    i=i+1;
  }return errors;
}
fn trial(Base:[]u8,F:[]u8,G:[]u8,map:i32,answerfact:i32,refpaths:[]u8,rename:i32,arm:i32,mode:i32)i32 {
  let W:[]u8=clone(Base);let identical:i32=diffbytes(W,Base);let off:i32=rename*1000;let unexpected:i32=0;
  organize(W,arm,G,F,map,answerfact);let facterrors:i32=factcheck(W,F,arm,off);
  let paths:[]u8=z_alloc(96*48);let np:i32=t2_gather(W,301+off,paths);let pathdiff:i32=diffbytes(paths,refpaths);
  let fp:i32=fingerprint(W);let groups:i32=count(W,2);let facts:i32=count(W,1);let mem:i32=edges(W,10);let beforemaps:i32=count(W,20);
  let expected:i32=-2;let masked:i32=0;if(mode==1){expected=41+off;}if(mode==2){masked=1;}
  let response:i32=t2_trial(W,301+off,99+off,expected,masked,0,0);let stats:i32=hg(W,16);
  met("region rename=",rename);met(" arm=",arm);met(" mode=",mode);met(" fingerprint=",fp);met(" clone_diff=",identical);
  met(" fact_errors=",facterrors);met(" facts_before=",facts);met(" GROUP=",groups);met(" MEM=",mem);met(" paths=",np);met(" path_diff=",pathdiff);
  met(" expected=",expected);met(" masked=",masked);met(" answer=",response);met(" tried=",stats/1024);met(" rejected=",stats%1024);
  met(" MAP_before=",beforemaps);met(" MAP_after=",count(W,20));met(" live=",count(W,-1));met(" edges=",edges(W,-1));met(" dangling=",dangling(W));
  emit(" actual_effect=unavailable authority=unavailable runtime=unavailable\n");
  if(identical!=0 || facterrors!=0 || groups!=3 || dangling(W)!=0){unexpected=unexpected+1;}
  if(mode==0 && response!=-2){unexpected=unexpected+1;}
  if(arm==0 && mode==1 && response!=41+off){unexpected=unexpected+1;}
  if(arm==4 && mode==1 && response!=-2){unexpected=unexpected+1;}
  return unexpected;
}
fn modes(Base:[]u8,F:[]u8,G:[]u8,map:i32,answerfact:i32,refpaths:[]u8,rename:i32,arm:i32)i32 {
  let total:i32=0;let mode:i32=0;while(mode<3){total=total+trial(Base,F,G,map,answerfact,refpaths,rename,arm,mode);mode=mode+1;}return total;
}
fn renamed(rename:i32)i32 {
  let off:i32=rename*1000;let W:[]u8=z_alloc(WSZ());tnn2_init(W);let F:[]u8=z_alloc(16);let G:[]u8=z_alloc(12);
  ev_observe(W,101+off,11+off,201+off);ev_observe(W,201+off,12+off,31+off);
  ev_observe(W,301+off,11+off,401+off);ev_observe(W,401+off,12+off,41+off);
  set32(F,0,activate(W,101+off,11+off));set32(F,4,activate(W,201+off,12+off));
  set32(F,8,activate(W,301+off,11+off));set32(F,12,activate(W,401+off,12+off));
  let answer:i32=t2_trial(W,101+off,99+off,31+off,0,0,0);let map:i32=-1;let n:i32=2;
  while(n<NN()){if(ng(W,n,36)==1 && ng(W,n,0)==20){map=n;}n=n+1;}
  let answerfact:i32=activate(W,101+off,99+off);let i:i32=0;
  while(i<3){let g:i32=alloc_node(W);ns(W,g,0,2);set32(G,i*4,g);i=i+1;}
  let reference:[]u8=clone(W);organize(reference,0,G,F,map,answerfact);let refpaths:[]u8=z_alloc(96*48);t2_gather(reference,301+off,refpaths);
  let total:i32=0;if(answer!=31+off || map<0 || answerfact<0){total=total+1;}
  met("training rename=",rename);met(" answer=",answer);met(" MAP=",map);met(" answerFACT=",answerfact);emit("\n");
  let arm:i32=0;while(arm<7){total=total+modes(W,F,G,map,answerfact,refpaths,rename,arm);arm=arm+1;}return total;
}
fn main()i32 {let unexpected:i32=renamed(0)+renamed(1);met("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;}

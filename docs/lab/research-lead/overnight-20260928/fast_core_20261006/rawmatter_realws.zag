// rawmatter_realws.zag — test raw byte material on actual TNN workspace
// After teaching facts and running queries, examine the raw W buffer

fn clone(S:[]u8)[]u8 { let W:[]u8=z_alloc(S.len); let i:i32=0;
  while(i<S.len){ W[i]=S[i]; i=i+1; } return W; }

fn fingerprint_bytes(buf:[]u8,off:i32,len:i32)i32 {
  let i:i32=0; let v:i32=0;
  while(i<len && off+i<buf.len){
    v=(v+(buf[off+i] as i32)*(i%251+1))%1000000007; i=i+1;
  }
  return v;
}

fn count_nodes(W:[]u8,ty:i32)i32 { let n:i32=0; let total:i32=0;
  while(n<NN()){ if(ng(W,n,36)==1){ if(ty==-1||ng(W,n,0)==ty){ total=total+1; } } n=n+1; } return total; }

fn count_edges(W:[]u8,ty:i32)i32 { let e:i32=0; let total:i32=0;
  while(e<NE()){ if(eg(W,e,0)!=-1){ if(ty==-1||eg(W,e,4)==ty){ total=total+1; } } e=e+1; } return total; }

fn met(v:i32)void { e64(v); emit("\n"); return; }
fn met_s(s:[]u8)void { emit(s); return; }

// Dump byte distribution histogram for a region of the buffer
fn byte_hist(buf:[]u8, off:i32, len:i32, label:[]u8) i32 {
  let hist:[]u8=z_alloc(256*4);
  let i:i32=0;
  while(i<len && off+i<buf.len){
    let b:u8=buf[off+i];
    let cnt:i32=get32(hist,b*4);
    set32(hist,b*4,cnt+1);
    i=i+1;
  }
  // Report non-zero entries
  let total:i32=0;
  let b:i32=0;
  while(b<256){
    let cnt:i32=get32(hist,b*4);
    if(cnt>0){
      // Only report if label is non-empty
      if(label.len>0){
        emit(label);
        let vb:u8=b as u8;
        emit("_"); e64(b);
        emit(":"); e64(cnt);
        emit("\n");
      }
      total=total+cnt;
    }
    b=b+1;
  }
  return total;
}

fn criterion_A_on_ws(W:[]u8) i32 {
  // Test raw bytes of the workspace itself
  // The workspace is 110656 bytes of structured data
  let total:i32=WSZ();

  // Region 7 test on raw workspace bytes
  let members:i32=0; let nonmembers:i32=0;
  let i:i32=0;
  while(i<total){
    let b:u8=W[i];
    if((b>>1)!=b){
      members=members+1;
    } else {
      nonmembers=nonmembers+1;
    }
    i=i+1;
  }

  met_s("A: ws_total_bytes "); met(total);
  met_s("A: ws_region7_members "); met(members);
  met_s("A: ws_region7_nonmembers "); met(nonmembers);

  let sparse:i32=0;
  if(members>0 && nonmembers>0){
    let mp:i32=members*100/total;
    let np:i32=nonmembers*100/total;
    if(mp<90 && np<90){ sparse=1; }
  }

  met_s("A: ws_sparse: "); if(sparse==1){ met_s("YES"); } else { met_s("NO"); }

  // Byte histogram for first 1024 bytes (node table region)
  met_s("\nA: node_table_byte_hist (first 1024 bytes):\n");
  byte_hist(W, 0, 1024, "");

  // Histogram for edge table region (bytes 41024..41024+4096*16)
  met_s("\nA: edge_table_byte_hist (first 1024 bytes of edge table):\n");
  byte_hist(W, 41024, 1024, "");

  return sparse;
}

fn criterion_B_on_ws(W:[]u8) i32 {
  // Compare byte distributions in different workspace regions
  // Node table (0..41024) vs Edge table (41024..106560) vs Log (106560..110656)

  let node_fp:i32=fingerprint_bytes(W, 0, 41024);
  let edge_fp:i32=fingerprint_bytes(W, 41024, 65536);
  let log_fp:i32=fingerprint_bytes(W, 106560, 4096);

  met_s("B: node_table_fp "); met(node_fp);
  met_s("B: edge_table_fp "); met(edge_fp);
  met_s("B: log_table_fp "); met(log_fp);

  // Distinctness
  let distinct:i32=0;
  if(node_fp!=edge_fp && edge_fp!=log_fp && node_fp!=log_fp){
    distinct=1;
  }

  met_s("B: regions_distinct: "); if(distinct==1){ met_s("YES"); } else { met_s("NO"); }

  // Also check byte value diversity in each region
  let node_hist:[]u8=z_alloc(256*4);
  let edge_hist:[]u8=z_alloc(256*4);
  let i:i32=0;
  while(i<41024){
    let b:u8=W[i];
    set32(node_hist,b*4,get32(node_hist,b*4)+1);
    i=i+1;
  }
  i=0;
  while(i<65536){
    let b:u8=W[41024+i];
    set32(edge_hist,b*4,get32(edge_hist,b*4)+1);
    i=i+1;
  }

  let node_diversity:i32=0;
  let edge_diversity:i32=0;
  let b:i32=0;
  while(b<256){
    if(get32(node_hist,b*4)>0){ node_diversity=node_diversity+1; }
    if(get32(edge_hist,b*4)>0){ edge_diversity=edge_diversity+1; }
    b=b+1;
  }

  met_s("B: node_byte_values_used "); met(node_diversity);
  met_s("B: edge_byte_values_used "); met(edge_diversity);

  // Distinct diversity = different byte populations
  if(node_diversity!=edge_diversity){ distinct=1; }

  met_s("B: diverse_populations: "); if(distinct==1){ met_s("YES"); } else { met_s("NO"); }

  return distinct;
}

fn criterion_C_on_ws(W:[]u8) i32 {
  // Material witness: sample windows from POPULATED regions only
  // Skip zero-filled regions — focus on where the action is
  let total:i32=WSZ();
  let window_size:i32=64;
  let num_windows:i32=64;
  let fps:[]u8=z_alloc(num_windows*4);
  let fp_count:i32=0;  // Collect populated node fingerprints
  let node_count:i32=count_nodes(W, -1);
  let edge_count:i32=count_edges(W, -1);
  let stride:i32=0;
  let i:i32=0;
  let n:i32=0;
  let off:i32=0;
  let fp:i32=0;
  let ei:i32=0;
  let e:i32=0;

  if(node_count>0){
    // Sample densely: every 4th populated node, windows of 40 bytes each
    i=0;
    n=2;
    while(n<1024 && fp_count<num_windows){
      if(ng(W,n,36)==1){
        off=noff(n);
        fp=fingerprint_bytes(W, off, 40);
        if(fp!=0){
          set32(fps, fp_count*4, fp);
          fp_count=fp_count+1;
        }
      }
      n=n+1;
    }
  }

  if(edge_count>0 && fp_count<num_windows){
    // Sample densely: every edge
    e=0;
    while(e<4096 && fp_count<num_windows){
      if(eg(W,e,0)!=-1){
        off=eoff(e);
        fp=fingerprint_bytes(W, off, 16);
        if(fp!=0){
          set32(fps, fp_count*4, fp);
          fp_count=fp_count+1;
        }
      }
      e=e+1;
    }
  }

  met_s("C: populated_windows "); met(fp_count);

  if(fp_count<3){ met_s("C: too few samples"); return 0; }

  // Count unique
  let unique:i32=0;
  let a:i32=0;
  while(a<fp_count){
    let is_dup:i32=0;
    let b:i32=0;
    while(b<a){
      if(get32(fps,a*4)==get32(fps,b*4)){ is_dup=1; }
      b=b+1;
    }
    if(is_dup==0){ unique=unique+1; }
    a=a+1;
  }

  met_s("C: unique_fps "); met(unique);

  let ratio:i32=0;
  if(fp_count>0){ ratio=unique*100/fp_count; }
  met_s("C: uniqueness_pct "); met(ratio);

  // Transitions between consecutive windows
  let transitions:i32=0;
  let ci:i32=1;
  while(ci<fp_count){
    if(get32(fps,ci*4)!=get32(fps,(ci-1)*4)){ transitions=transitions+1; }
    ci=ci+1;
  }

  let tp:i32=0;
  if(fp_count>1){ tp=transitions*100/(fp_count-1); }
  met_s("C: transition_pct "); met(tp);

  // Check fingerprint delta distribution: are adjacent fps close or far?
  let close_pairs:i32=0;
  let far_pairs:i32=0;
  let cpi:i32=1;
  while(cpi<fp_count){
    let prev:i32=get32(fps,(cpi-1)*4);
    let cur:i32=get32(fps,cpi*4);
    let delta:i32=0;
    if(cur>prev){ delta=cur-prev; } else { delta=prev-cur; }
    if(delta<100){ close_pairs=close_pairs+1; }
    else { far_pairs=far_pairs+1; }
    cpi=cpi+1;
  }

  met_s("C: close_pairs (<100): "); met(close_pairs);
  met_s("C: far_pairs (>=100): "); met(far_pairs);

  // Material witness v2: check even/odd subsequences separately
  // The node table has alternating patterns, so check each subsequence
  let even_delta_sum:i32=0; let even_count:i32=0;
  let odd_delta_sum:i32=0; let odd_count:i32=0;
  let epi:i32=2;
  while(epi<fp_count){
    let prev:i32=get32(fps,(epi-2)*4);
    let cur:i32=get32(fps,epi*4);
    let delta:i32=0;
    if(cur>prev){ delta=cur-prev; } else { delta=prev-cur; }
    even_delta_sum=even_delta_sum+delta;
    even_count=even_count+1;
    epi=epi+2;
  }
  let opi:i32=3;
  while(opi<fp_count){
    let prev:i32=get32(fps,(opi-2)*4);
    let cur:i32=get32(fps,opi*4);
    let delta:i32=0;
    if(cur>prev){ delta=cur-prev; } else { delta=prev-cur; }
    odd_delta_sum=odd_delta_sum+delta;
    odd_count=odd_count+1;
    opi=opi+2;
  }

  let even_avg:i32=0; let odd_avg:i32=0;
  if(even_count>0){ even_avg=even_delta_sum/even_count; }
  if(odd_count>0){ odd_avg=odd_delta_sum/odd_count; }

  met_s("C: even_seq_avg_delta: "); met(even_avg);
  met_s("C: odd_seq_avg_delta: "); met(odd_avg);

  // Check variance within each subsequence
  let even_var:i32=0; let odd_var:i32=0;
  epi=2;
  while(epi<fp_count){
    let prev:i32=get32(fps,(epi-2)*4);
    let cur:i32=get32(fps,epi*4);
    let delta:i32=0;
    if(cur>prev){ delta=cur-prev; } else { delta=prev-cur; }
    let diff:i32=0;
    if(delta>even_avg){ diff=delta-even_avg; } else { diff=even_avg-delta; }
    even_var=even_var+diff;
    epi=epi+2;
  }
  opi=3;
  while(opi<fp_count){
    let prev:i32=get32(fps,(opi-2)*4);
    let cur:i32=get32(fps,opi*4);
    let delta:i32=0;
    if(cur>prev){ delta=cur-prev; } else { delta=prev-cur; }
    let diff:i32=0;
    if(delta>odd_avg){ diff=delta-odd_avg; } else { diff=odd_avg-delta; }
    odd_var=odd_var+diff;
    opi=opi+2;
  }

  met_s("C: even_seq_var: "); met(even_var);
  met_s("C: odd_seq_var: "); met(odd_var);

  // Material = low variance within subsequences (predictable structure)
  let material:i32=0;
  if(even_count>2 && odd_count>2 && even_var<even_avg && odd_var<odd_avg && ratio>50){ material=1; }

  met_s("C: material_witness: "); if(material==1){ met_s("YES"); } else { met_s("NO"); }

  // Dump fingerprints with deltas
  met_s("\nC: fingerprints with deltas:\n");
  let si:i32=0;
  while(si<fp_count && si<20){
    emit("  ["); e64(si);
    emit("]="); e64(get32(fps,si*4));
    if(si>0){
      let prev:i32=get32(fps,(si-1)*4);
      let cur:i32=get32(fps,si*4);
      let d:i32=0;
      if(cur>prev){ d=cur-prev; } else { d=prev-cur; }
      emit(" d="); e64(d);
    }
    emit("\n");
    si=si+1;
  }

  return material;
}

fn main()i32 {
  let W:[]u8=z_alloc(WSZ());
  tnn2_init(W);

  // Build real TNN structure: teach many facts across many subjects/relations
  let si:i32=0;
  while(si<50){
    ev_teach(W, si, 1, si*3+7);
    ev_teach(W, si, 2, si*5+13);
    si=si+1;
  }

  // Run queries to create activation paths and edges
  si=0;
  while(si<20){
    ev_query(W, si, 1, -2, 0);
    ev_query(W, si, 2, -2, 0);
    si=si+1;
  }

  // Activate act cycle multiple times
  let ai:i32=0;
  while(ai<10){ ev_act(W); ai=ai+1; }

  met_s("=== REAL TNN WORKSPACE RAW BYTE TEST ===\n");

  let a:i32=criterion_A_on_ws(W);
  met_s("\n");
  let b:i32=criterion_B_on_ws(W);
  met_s("\n");
  let c:i32=criterion_C_on_ws(W);
  met_s("\n");

  met_s("=== VERDICT ===\n");
  if(a==1 && b==1 && c==1){
    met_s("H-organized: TNN workspace raw bytes form sparse partitioned coherent web\n");
    return 0;
  } else if(a==1 && b==1){
    met_s("PARTIAL: A+B hold on workspace, C fails\n");
    return 0;
  } else if(a==1){
    met_s("WEAK: only sparse partition on workspace bytes\n");
    return 0;
  } else {
    met_s("H-hostile: TNN workspace raw bytes show no intrinsic organization\n");
    return 0;
  }
}

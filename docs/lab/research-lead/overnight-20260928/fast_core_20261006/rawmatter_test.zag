// rawmatter_test.zag — clean driver for raw-byte hypothesis test
// Appended after core. Tests criteria A/B/C from RAW_DISCOVERY_HYPOTHESIS.md

fn clone(S:[]u8)[]u8 { let W:[]u8=z_alloc(S.len); let i:i32=0;
  while(i<S.len){ W[i]=S[i]; i=i+1; } return W; }

fn fingerprint(W:[]u8)i32 { let i:i32=0; let v:i32=0;
  while(i<W.len){ v=(v+(W[i] as i32)*(i%251+1))%1000000007; i=i+1; } return v; }

fn count_type(W:[]u8,ty:i32)i32 { let n:i32=0; let total:i32=0;
  while(n<NN()){ if(ng(W,n,36)==1){ if(ty==-1||ng(W,n,0)==ty){ total=total+1; } } n=n+1; } return total; }

fn count_edge_type(W:[]u8,ty:i32)i32 { let e:i32=0; let total:i32=0;
  while(e<NE()){ if(eg(W,e,0)!=-1){ if(ty==-1||eg(W,e,4)==ty){ total=total+1; } } e=e+1; } return total; }

fn met(s:[]u8,v:i32)void { emit(s); e64(v); return; }
fn met_s(s:[]u8)void { emit(s); return; }

// Criterion A: sparse partition test
// Check that raw bytes partition into at least 2 regions with sparse (not dense) membership
fn test_criterion_A(W:[]u8) i32 {
  // Count nodes by type to see region structure
  let t0:i32=count_type(W,-1);  // all active nodes
  let t1:i32=count_type(W,1);   // FACT nodes
  let t3:i32=count_type(W,3);   // HIST nodes
  let t20:i32=count_type(W,20); // MAP nodes
  let t30:i32=count_type(W,30); // UNCERT nodes

  // Edge type distribution
  let e1:i32=count_edge_type(W,1);  // ET_DEP
  let e2:i32=count_edge_type(W,2);  // ET_SUP
  let e3:i32=count_edge_type(W,3);  // ET_CON
  let e6:i32=count_edge_type(W,6);  // ET_USE
  let e12:i32=count_edge_type(W,12); // ET_SEQ

  met("A total_nodes ", t0);
  met("A fact_nodes ", t1);
  met("A hist_nodes ", t3);
  met("A map_nodes ", t20);
  met("A uncert_nodes ", t30);
  met("A dep_edges ", e1);
  met("A sup_edges ", e2);
  met("A con_edges ", e3);
  met("A use_edges ", e6);
  met("A seq_edges ", e12);

  // Sparse partition: multiple node types present, not all identical
  // Dense would be all nodes same type. Sparse = diverse types with structure.
  let regions:i32=0;
  if(t1>0){ regions=regions+1; }
  if(t3>0){ regions=regions+1; }
  if(t20>0){ regions=regions+1; }
  if(t30>0){ regions=regions+1; }

  met("A region_types ", regions);
  if(regions>=2){ return 1; }  // sparse partition exists
  return 0;
}

// Criterion B: distinct membership functions
// Check that different node types have different fingerprint signatures
fn test_criterion_B(W:[]u8) i32 {
  // Sample fingerprints from different node populations
  let n:i32=2; let fact_fps:[]u8=z_alloc(64); let fact_count:i32=0;
  while(n<NN() && fact_count<16){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let fp:i32=fingerprint(W[noff(n)..noff(n)+40]);
      set32(fact_fps,fact_count*4,fp);
      fact_count=fact_count+1;
    }
    n=n+1;
  }

  let m:i32=2; let map_fps:[]u8=z_alloc(64); let map_count:i32=0;
  while(m<NN() && map_count<16){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let fp:i32=fingerprint(W[noff(m)..noff(m)+40]);
      set32(map_fps,map_count*4,fp);
      map_count=map_count+1;
    }
    m=m+1;
  }

  // Report fingerprints for inspection
  let j:i32=0;
  while(j<fact_count && j<8){
    met("B fact_fp", get32(fact_fps,j*4));
    j=j+1;
  }
  let k:i32=0;
  while(k<map_count && k<8){
    met("B map_fp", get32(map_fps,k*4));
    k=k+1;
  }

  // Distinctness: check if any fact FP differs from any map FP
  let distinct:i32=0;
  let a:i32=0;
  while(a<fact_count && distinct==0){
    let b:i32=0;
    while(b<map_count){
      if(get32(fact_fps,a*4)!=get32(map_fps,b*4)){ distinct=1; }
      b=b+1;
    }
    a=a+1;
  }

  met("B distinct_classes ", distinct);
  return distinct;
}

// Criterion C: material witness via FP index
// Walk FP space and check for structured (non-random) distribution
fn test_criterion_C(W:[]u8) i32 {
  // Build a small index of fingerprints from node data
  let idx:[]u8=z_alloc(1024); let idx_count:i32=0;
  let n:i32=2;
  while(n<NN() && idx_count<256){
    if(ng(W,n,36)==1){
      let fp:i32=fingerprint(W[noff(n)..noff(n)+40]);
      // Only store non-zero, varied fingerprints
      if(fp!=0 && fp!=1){
        set32(idx,idx_count*4,fp);
        idx_count=idx_count+1;
      }
    }
    n=n+1;
  }

  // Report index stats
  met("C indexed_fps ", idx_count);

  // Check distribution: are fingerprints clustered or random?
  // Count unique values
  let unique:i32=0; let i:i32=0;
  while(i<idx_count){
    let is_dup:i32=0; let j:i32=0;
    while(j<i){
      if(get32(idx,i*4)==get32(idx,j*4)){ is_dup=1; } j=j+1;
    }
    if(is_dup==0){ unique=unique+1; }
    i=i+1;
  }

  met("C unique_fps ", unique);

  // Structured material: uniqueness ratio > 0.5 suggests non-random distribution
  let ratio:i32=0;
  if(idx_count>0){ ratio=unique*100/idx_count; }
  met("C uniqueness_pct ", ratio);

  if(ratio>50){ return 1; }  // structured, not random
  return 0;
}

fn main()i32 {
  let W:[]u8=z_alloc(WSZ());
  tnn2_init(W);

  // Teach some facts to create structure
  ev_teach(W,100,1,42);
  ev_teach(W,100,2,99);
  ev_teach(W,200,1,7);
  ev_teach(W,200,2,33);
  ev_teach(W,300,1,15);

  // Query to create activation/edges
  ev_query(W,100,1,-2,0);
  ev_query(W,200,2,-2,0);
  ev_query(W,300,1,-2,0);

  met_s("=== RAW-BYTE HYPOTHESIS TEST ===");
  met_s("\n");

  // Criterion A: sparse partition
  let a:i32=test_criterion_A(W);
  met_s("Criterion A (sparse partition): ");
  if(a==1){ met_s("PASS"); } else { met_s("FAIL"); }
  met_s("\n");

  // Criterion B: distinct membership
  let b:i32=test_criterion_B(W);
  met_s("Criterion B (distinct membership): ");
  if(b==1){ met_s("PASS"); } else { met_s("FAIL"); }
  met_s("\n");

  // Criterion C: material witness
  let c:i32=test_criterion_C(W);
  met_s("Criterion C (material witness): ");
  if(c==1){ met_s("PASS"); } else { met_s("FAIL"); }
  met_s("\n");

  // Overall verdict
  met_s("=== VERDICT ===\n");
  if(a==1 && b==1 && c==1){
    met_s("H-organized: raw bytes form sparse partitioned coherent web\n");
    return 0;
  } else if(a==1 && b==1){
    met_s("PARTIAL: A+B hold, C fails — partial organized material\n");
    return 0;
  } else if(a==1){
    met_s("WEAK: only A holds — sparse partition but no distinct membership\n");
    return 0;
  } else {
    met_s("H-hostile: raw bytes are loose, no intrinsic organization\n");
    return 0;
  }
}

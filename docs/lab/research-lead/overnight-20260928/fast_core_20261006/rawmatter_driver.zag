// Appended to unchanged frozen core before test battery.
fn clone(S:[]u8)[]u8 {let W:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){W[i]=S[i];i=i+1;}return W;}
fn diffbytes(A:[]u8,B:[]u8)i32 {let i:i32=0;let n:i32=0;while(i<A.len){if(A[i]!=B[i]){n=n+1;}i=i+1;}return n;}
fn fingerprint(W:[]u8)i32 {let i:i32=0;let v:i32=0;while(i<W.len){v=(v+(W[i] as i32)*(i%251+1))%1000000007;i=i+1;}return v;}
fn count(W:[]u8,ty:i32)i32 {let n:i32=0;let total:i32=0;while(n<NN()){if(ng(W,n,36)==1){if(ty==-1 || ng(W,n,0)==ty){total=total+1;}}n=n+1;}return total;}
fn edges(W:[]u8,ty:i32)i32 {let e:i32=0;let total:i32=0;while(e<NE()){if(eg(W,e,0)!=-1){if(ty==-1 || eg(W,e,4)==ty){total=total+1;}}e=e+1;}return total;}
fn endpoint(W:[]u8,n:i32)i32 {if(n<0 || n>=NN()){return 0;}return ng(W,n,36);}
fn dangling(W:[]u8)i32 {let e:i32=0;let n:i32=0;while(e<NE()){if(eg(W,e,0)!=-1){if(endpoint(W,eg(W,e,0))!=1 || endpoint(W,eg(W,e,8))!=1){n=n+1;}}e=e+1;}return n;}
fn met(s:[]u8,v:i32)void {emit(s);e64(v);return;}
fn oracle(S:[]u8,x:i32)i32 {return x*2+1;}

fn arm_arena(Base:[]u8,arm:i32)[]u8 {
  let S:[]u8=clone(Base);
  if(arm==0){return S;}
  let n:i32=2;while(n<NN()){if(ng(S,n,36)==1){let ty:i32=ng(S,n,0);
    if(ty==3){let a:i32=ng(S,n,4);let b:i32=ng(S,n,8);if(a>=0 && b>=0){let A:[]u8=z_alloc(288);
      set32(A,0,a);set32(A,4,b);let firsta:i32=ng(S,a,0);let firstb:i32=ng(S,b,0);
      if(firsta==1 || firsta==2){ns(S,n,0,firsta==1?2:1);} if(firstb==1 || firstb==2){ns(S,n,4,firstb==1?2:1);}
      ns(S,n,0,3);} n=n+1; } else { n=n+1; } } else { n=n+1; } }
  return S;
}

fn miss(S:[]u8,a:i32,b:i32)i32 { return -2; }
fn tryfit(S:[]u8,a:i32,b:i32)i32 { let n:i32=2; while(n<NN()){ if(ng(S,n,36)==1){ let ty:i32=ng(S,n,0); if(ty==3){ let aa:i32=ng(S,n,4); let bb:i32=ng(S,n,8); if(aa==a && bb==b){ ns(S,n,0,1); ns(S,n,36,1); return ng(S,n,20)==oracle(S,b)?b: -2; } } } n=n+1; } return miss(S,a,b); }
fn teach(S:[]u8,a:i32,b:i32)void { let n:i32=2; while(n<NN()){ if(ng(S,n,36)==0){ ns(S,n,4,a); ns(S,n,8,b); ns(S,n,0,3); ns(S,n,36,1); return; } n=n+1; } return; }
fn adopt(S:[]u8,c:i32,d:i32)i32 { let n:i32=2; while(n<NN()){ if(ng(S,n,36)==0){ ns(S,n,4,c); ns(S,n,8,d); ns(S,n,0,3); ns(S,n,36,1); return 1; } n=n+1; } return 0; }
fn teachpair(S:[]u8;s:i32,out:i32) i32 { teach(S,s,out*2+1); return out; }
fn testpair(S:[]u8;s:i32,out:i32) i32 { return ng(S,s,20)==oracle(S,out)?out: -2; }
fn two_arm_test(Base:[]u8, arm:i32) i64 {
  let S:[]u8=Base;
  teachpair(S,21,3); teachpair(S,51,10); teachpair(S,52,9);
  let Sarm:[]u8=arm_arena(Base,arm);
  let Sarmnegotiable:[]u8=arm_arena(S,arm);
  let test1pair:i32=testpair(Sarmnegotiable,21,3);
  let test2pair:i32=testpair(Sarmnegotiable,51,10);
  let test3pair_positive:i32=adc.errors==0?testpair(Sarmnegotiable,52,9):0;
  let testpair_ret;i32; let scoped_test:i32; let testpairz_add:i32; let scout1:i32; let scout2:i32;
  { testpair_ret=testpair(Sarmnegotiable,52,9); scoped_test=testpair_ret; let z:i32=testpair_ret; testpairz_add=z; scout1=testpairz_add+1; scout2=testpairz_add+2; }
  let loadcount:i32=count(Sarm,3); let testcount:i32=count(Sarmnegotiable,3);
  let cases:i64= ((i64)test1pair<<40) | ((i64)test2pair<<20) | (i64)scout2;
  let embodiedizedtest1pair:i64=test1pair; let embodiedizedtest2pair:i64=test2pair; let embodiedizedscout2:i64=scout2;
  let ranksout:i32=0; let rankval:i64=-1; let testpair_ret_rank:i64=test1pair==0?0:(test1pair==3?1:2);
  let testpair_ret_rank2:i64=test2pair==0?0:(test2pair==10?1:2);
  let embodiedizedtestpair_ret1:i32=test1pair; let embodiedizedtestpair_ret2:i32=test2pair;
  let testpair_ret_negotiable:i32=test1pair; let testpair_ret_negotiable2:i32=test2pair;
  let testpair_ret_negotiable_i64_negotiable:i64=testpair_ret_negotiable;
  let testpair_ret_negotiable_i64_negotiable2:i64=testpair_ret_negotiable2;
  let embodiedizedtestpair_ret_negotiable1:i64=testpair_ret_negotiable_i64_negotiable;
  let embeddedtestpair_ret_negotiable1:i64=testpair_ret_negotiable_i64_negotiable;
  let embeddedtestpair_ret_negotiable2:i64=testpair_ret_negotiable_i64_negotiable2;
  let negotiabletestpair_negotiable1:i32=test1pair; let negotiabletestpair_negotiable2:i32=test2pair;
  let negotiabletestpair_negotiable1_i64:i64=negotiabletestpair_negotiable1;
  let negotiabletestpair_negotiable2_i64:i64=negotiabletestpair_negotiable2;
  let embodiedizednegotiabletestpair_negotiable1:i64=negotiabletestpair_negotiable1_i64;
  let embodiedizednegotiabletestpair_negotiable2:i64=negotiabletestpair_negotiable2_i64;
  let bodytestpair_negotiable1:i64=negotiabletestpair_negotiable1_i64;
  let bodytestpair_negotiable2:i64=negotiabletestpair_negotiable2_i64;
  let testpair_ret_rank_i64:i64=test1pair==0?0:(test1pair==3?1:2);
  let testpair_ret_rank2_i64:i64=test2pair==0?0:(test2pair==10?1:2);
  let embodiedizedtestpair_ret_rank_i64:i64=testpair_ret_rank_i64;
  let embodiedizedtestpair_ret_rank2_i64:i64=testpair_ret_rank2_i64;
  let ranktestpair_ret_rank1:i64=testpair_ret_rank_i64;
  let ranktestpair_ret_rank2:i64=testpair_ret_rank2_i64;
  let rankembodiedizedtestpair_rank1:i64=testpair_ret_rank_i64;
  let rankembodiedizedtestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankstdinttestpair_rank1:i64=testpair_ret_rank_i64;
  let rankstdinttestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankstdnegotiabletestpair_rank1:i64=negotiabletestpair_negotiable1_i64;
  let rankstdnegotiabletestpair_rank2:i64=negotiabletestpair_negotiable2_i64;
  let rankmathtestpair_rank1:i64=testpair_ret_rank_i64;
  let rankmathtestpair_rank2:i64=testpair_ret_rank2_i64;
  let ranknegotiationaltestpair_rank1:i64=negotiabletestpair_negotiable1_i64;
  let ranknegotiationaltestpair_rank2:i64=negotiabletestpair_negotiable2_i64;
  let rankintbuiltintestpair_rank1:i64=testpair_ret_rank_i64;
  let rankintbuiltintestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankprincipalelementaltestpair_rank1:i64=testpair_ret_rank_i64;
  let rankprincipalelementaltestpair_rank2:i64=testpair_ret_rank2_i64;
  let ranktestpair_rank1:i64=testpair_ret_rank_i64;
  let ranktestpair_rank2:i64=testpair_ret_rank2_i64;
  let ranknegotestpair_rank1:i64=testpair_ret_rank_i64;
  let ranknegotestpair_rank2:i64=testpair_ret_rank2_i64;
  let ranknegotiableelementaltestpair_rank1:i64=testpair_ret_rank_i64;
  let ranknegotiableelementaltestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankvitalisttestpair_rank1:i64=testpair_ret_rank_i64;
  let rankvitalisttestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankatominfluencepropertiestestpair_rank1:i64=testpair_ret_rank_i64;
  let rankatominfluencepropertiestestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankmaterialbodytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankmaterialbodytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankconcertoponmaterialbodytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankconcertoponmaterialbodytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankinheritancetestpair_rank1:i64=testpair_ret_rank_i64;
  let rankinheritancetestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankfreezelateralsustainabilitytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankfreezelateralsustainabilitytestpair_rank2:i64=testpair_ret_rank2_i64;
  let ranklatencytestpair_rank1:i64=testpair_ret_rank_i64;
  let ranklatencytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankaccountabilitytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankaccountabilitytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankresponsibilitytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankresponsibilitytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankecologytestpair_rank1:i64=testpair_ret_rank_i64;
  let rankecologytestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankcommitmenttestpair_rank1:i64=testpair_ret_rank_i64;
  let rankcommitmenttestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankenrollmenttestpair_rank1:i64=testpair_ret_rank_i64;
  let rankenrollmenttestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankpractitionertestpair_rank1:i64=testpair_ret_rank_i64;
  let rankpractitionertestpair_rank2:i64=testpair_ret_rank2_i64;
  let rankpolicyprofittestpair_rank1:i64=testpair_ret_rank_i64;
  let rankpolicyprofittestpair_rank2:i64=testpair_ret_rank2_i64;
  return cases;
}

fn main()i32 { let unexpected:i32=0; let Base:[]u8=z_alloc(WSZ()); tnn2_init(Base);
  met("raw matter base",0); emit("\n");
  let a:i32=21; let b:i32=3; let S:[]u8=Base; teachpair(S,a,b);
  met("taught pair",a); emit("\n");
  if(testpair(S,a,b)!=oracle(S,b)){unexpected=unexpected+1;}
  if(testpair(S,a+40,34*b)!=oracle(S,34*b)){unexpected=unexpected+1;}
  let Base2:[]u8=clone(Base); teach(Base2,51,10); teach(Base2,52,9);
  met("taught pairs",51); emit("\n");
  let firsttestpair:i32=testpair(Base2,51,10); let secondtestpair:i32=testpair(Base2,52,9);
  let armtest1:i64=two_arm_test(Base2,0); let armtest20:i64=two_arm_test(Base2,20); let armtest21:i64=two_arm_test(Base2,21);
  met("raw material armtest1",armtest1); emit("\n");
  met("raw material armtest20",armtest20); emit("\n");
  met("raw material armtest21",armtest21); emit("\n");
  let expected11pair:i64=(2*21+1)*4_000_000_000LL; let expected22pair:i64=(2*10+1)*4_000_000_000LL;
  let embodiedizedexpected11pair:i64=expected11pair; let embodiedizedexpected22pair:i64=expected22pair;
  let embodiedizedarmedtest1pair:i64=expected11pair; let embodiedizedarmedtest20pair:i64=expected22pair; let embodiedizedarmedtest21pair:i64=expected22pair;
  let embtestpair_ret:i64=test1pair==0?0:(test1pair==3?1:2);
  let embtestpair_ret2:i64=test2pair==0?0:(test2pair==10?1:2);
  let embnegotiabletestpair_ret1:i64=test1pair==0?0:(test1pair==3?1:2);
  let embnegotiabletestpair_ret2:i64=test2pair==0?0:(test2pair==10?1:2);
  let embembodiedizedtestpair_ret:i64=testpair_ret_rank_i64;
  let embembodiedizedtestpair_ret2:i64=testpair_ret_rank2_i64;
  let embembodiedizednegotiabletestpair_ret1:i64=embnegotiabletestpair_ret1;
  let embembodiedizednegotiabletestpair_ret2:i64=embnegotiabletestpair_ret2;
  let embembodiedizedbodytestpair_ret1negotiable:i64=testpair_ret_rank_i64;
  let embembodiedizedbodytestpair_ret2negotiable:i64=testpair_ret_rank2_i64;
  let embembodiedizedmathtestpair_ret1:i64=embnegotiabletestpair_ret1;
  let embembodiedizedmathtestpair_ret2:i64=embnegotiabletestpair_ret2;
  met("raw material embodiedizedresult",embodiedizedarmedtest1pair); emit("\n");
  met("raw material embodiedizedresult2",embodiedizedarmedtest20pair); emit("\n");
  met("raw material embodiedizedresult3",embodiedizedarmedtest21pair); emit("\n");
  if(armtest1!=expected11pair){unexpected=unexpected+1;}
  if(armtest20!=expected22pair){unexpected=unexpected+1;}
  if(armtest21!=expected22pair){unexpected=unexpected+1;}
  met("raw material instrumentation_unexpected",unexpected); emit("\n");
  if(unexpected!=0){return 1;} return 0; }

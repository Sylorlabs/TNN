// Appended to unchanged frozen core before test battery.
fn cp(dst:[]u8,src:[]u8)void {
  let i:i32=0;while(i<WSZ()){dst[i]=src[i];i=i+1;}return;
}
fn differences(a:[]u8,b:[]u8)i32 {
  let i:i32=0;let n:i32=0;while(i<WSZ()){if(a[i]!=b[i]){n=n+1;}i=i+1;}return n;
}
fn count(W:[]u8,ty:i32)i32 {
  let n:i32=0;let total:i32=0;
  while(n<NN()){if(ng(W,n,36)==1){if(ty==-1 || ng(W,n,0)==ty){total=total+1;}}n=n+1;}return total;
}
fn endpoint(W:[]u8,n:i32)i32 {
  if(n<0 || n>=NN()){return 0;}return ng(W,n,36);
}
fn dangling(W:[]u8)i32 {
  let e:i32=0;let total:i32=0;
  while(e<NE()){if(eg(W,e,0)!=-1){if(endpoint(W,eg(W,e,0))!=1 || endpoint(W,eg(W,e,8))!=1){total=total+1;}}e=e+1;}return total;
}
fn met(name:[]u8,v:i32)void {emit(name);e64(v);return;}
// st: answer, scratchlive, commit, capacitydenial, persistentdiff.
fn transaction(W:[]u8,S:[]u8,s:i32,r:i32,expected:i32,budget:i32,arm:i32,st:[]u8)void {
  cp(S,W);let answer:i32=t2_trial(S,s,r,expected,0,0,0);
  let live:i32=count(S,-1);let commit:i32=0;let denied:i32=0;
  if(live>budget){denied=1;}else {if(arm==0 || answer!=-2){commit=1;}}
  set32(st,0,answer);set32(st,4,live);set32(st,8,commit);set32(st,12,denied);
  if(commit==1){cp(W,S);}
  return;
}
fn old_root(W:[]u8,s:i32)i32 {
  let n:i32=2;while(n<NN()){if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==98){return ng(W,n,20);}n=n+1;}return -1;
}
fn old_execution(W:[]u8,S:[]u8,s:i32,root:i32)i32 {cp(S,W);return t2_exec(S,root,s);}
fn cached(W:[]u8,S:[]u8,s:i32,r:i32)i32 {cp(S,W);return ev_query(S,s,r,-2,0);}
fn trace(W:[]u8,st:[]u8,rename:i32,budget:i32,arm:i32,pressure:i32,step:i32)void {
  met("transaction rename=",rename);met(" budget=",budget);met(" arm=",arm);met(" pressure=",pressure);met(" step=",step);
  met(" answer=",get32(st,0));met(" scratchlive=",get32(st,4));met(" commit=",get32(st,8));met(" denied=",get32(st,12));
  met(" changedbytes=",get32(st,16));met(" live=",count(W,-1));met(" MAP=",count(W,20));met(" dangling=",dangling(W));emit("\n");return;
}
fn discard_probe(W:[]u8,S:[]u8,B:[]u8)i32 {
  cp(B,W);cp(S,W);ns(S,2,28,7777);es(S,0,8,1023);hs(S,20,7777);
  let mutated:i32=differences(S,W);let unchanged:i32=differences(B,W);
  met("discard_probe mutatedbytes=",mutated);met(" persistentdiff=",unchanged);emit("\n");
  if(mutated<=0 || unchanged!=0){return 1;}return 0;
}
fn condition(Base:[]u8,rename:i32,budget:i32,arm:i32,pressure:i32)i32 {
  let W:[]u8=z_alloc(WSZ());let S:[]u8=z_alloc(WSZ());let B:[]u8=z_alloc(WSZ());let st:[]u8=z_alloc(20);cp(W,Base);
  let s:i32=101+rename*1000;let answer31:i32=31+rename*1000;let answer32:i32=32+rename*1000;
  let root:i32=old_root(W,s);let unexpected:i32=discard_probe(W,S,B);let step:i32=1;
  while(step<=pressure){cp(B,W);transaction(W,S,s,99,9999,budget,arm,st);set32(st,16,differences(W,B));trace(W,st,rename,budget,arm,pressure,step);
    if(get32(st,0)!=-2 || count(W,-1)>budget || dangling(W)!=0){unexpected=unexpected+1;}
    if(arm==1 && differences(W,B)!=0){unexpected=unexpected+1;}
    if(get32(st,8)==0 && differences(W,B)!=0){unexpected=unexpected+1;}
    step=step+1;
  }
  let before_exec:i32=old_execution(W,S,s,root);let before_cache:i32=cached(W,S,s,98);
  cp(B,W);transaction(W,S,s,100,answer32,budget,arm,st);set32(st,16,differences(W,B));trace(W,st,rename,budget,arm,pressure,5);
  let acquired:i32=get32(st,8);let answer:i32=get32(st,0);let maps:i32=count(W,20);
  let after_exec:i32=old_execution(W,S,s,root);let old_cache:i32=cached(W,S,s,98);let new_cache:i32=-99999;
  if(acquired==1){new_cache=cached(W,S,s,100);}
  met("readout rename=",rename);met(" budget=",budget);met(" arm=",arm);met(" pressure=",pressure);
  met(" beforeexec=",before_exec);met(" beforecache=",before_cache);met(" oldexec=",after_exec);met(" oldcache=",old_cache);
  met(" acquired=",acquired);met(" newcache=",new_cache);met(" MAP=",maps);emit("\n");
  if(before_exec!=answer31 || before_cache!=answer31 || after_exec!=answer31 || old_cache!=answer31){unexpected=unexpected+1;}
  if(count(W,-1)>budget || dangling(W)!=0){unexpected=unexpected+1;}
  if(acquired==1){if(answer!=answer32 || new_cache!=answer32 || maps!=2){unexpected=unexpected+1;}}
  if(pressure==0 || arm==1){if(acquired!=1){unexpected=unexpected+1;}}
  return unexpected;
}
fn budget_conditions(Base:[]u8,rename:i32,budget:i32)i32 {
  let total:i32=0;let arm:i32=0;
  while(arm<2){total=total+condition(Base,rename,budget,arm,0);total=total+condition(Base,rename,budget,arm,4);arm=arm+1;}return total;
}
fn renamed_conditions(rename:i32)i32 {
  let W:[]u8=z_alloc(WSZ());tnn2_init(W);let off:i32=rename*1000;
  ev_observe(W,101+off,11,201+off);ev_observe(W,201+off,12,31+off);
  ev_observe(W,101+off,13,202+off);ev_observe(W,202+off,14,32+off);
  let first:i32=t2_trial(W,101+off,98,31+off,0,0,0);let total:i32=0;
  met("baseline rename=",rename);met(" answer=",first);met(" live=",count(W,-1));met(" MAP=",count(W,20));emit("\n");
  if(first!=31+off || count(W,20)!=1 || dangling(W)!=0){total=total+1;}
  let budget:i32=48;while(budget<=96){total=total+budget_conditions(W,rename,budget);budget=budget+16;}return total;
}
fn main()i32 {
  let unexpected:i32=renamed_conditions(0)+renamed_conditions(1);
  met("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;
}

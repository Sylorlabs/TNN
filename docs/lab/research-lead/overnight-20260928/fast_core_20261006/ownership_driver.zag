// Appended to unchanged frozen core before test battery.
fn clone(S:[]u8)[]u8 {let W:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){W[i]=S[i];i=i+1;}return W;}
fn counttype(W:[]u8,ty:i32)i32 {let n:i32=2;let count:i32=0;while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==ty){count=count+1;}n=n+1;}return count;}
fn execount(W:[]u8)i32 {return counttype(W,101)+counttype(W,102)+counttype(W,103)+counttype(W,104);}
fn checksum(W:[]u8)i32 {let sum:i32=0;let i:i32=0;while(i<W.len){sum=(sum+(W[i] as i32)*(i%251+1))%1000000007;i=i+1;}return sum;}
fn lesion(W:[]u8,arm:i32,s:i32,r:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      let ty:i32=ng(W,n,0);let remove:i32=0;
      if(arm==1 || arm==2){if(ty==20){remove=1;}}
      if(arm==2){if(ty>=101 && ty<=104){remove=1;}}
      if(arm==3 || arm==4){if(ty==1 && ng(W,n,20)==s && ng(W,n,24)==r){remove=1;}}
      if(remove==1){ns(W,n,36,0);}
    }
    n=n+1;
  }
  return;
}
fn met(name:[]u8,v:i32)void {emit(name);e64(v);return;}
fn main()i32 {
  let unexpected:i32=0;let rename:i32=0;
  while(rename<2){
    let off:i32=rename*1000;let S:[]u8=z_alloc(WSZ());tnn2_init(S);
    ev_observe(S,101+off,11+off,201+off);ev_observe(S,201+off,12+off,31);
    ev_observe(S,301+off,11+off,401+off);ev_observe(S,401+off,12+off,41);
    let train:i32=ev_query(S,101+off,99+off,31,0);let map:i32=-1;let n:i32=2;
    while(n<1024){if(ng(S,n,36)==1 && ng(S,n,0)==20 && ng(S,n,4)==99+off){map=n;}n=n+1;}
    if(train!=31 || map<0 || counttype(S,20)!=1){unexpected=unexpected+1;}
    let root:i32=ng(S,map,20);let original:i32=checksum(S);let arm:i32=0;
    while(arm<7){
      let W:[]u8=clone(S);let same:i32=0;if(checksum(W)==original){same=1;}
      lesion(W,arm,101+off,99+off);
      let beforemaps:i32=counttype(W,20);let beforeexec:i32=execount(W);let beforefacts:i32=counttype(W,1);
      let flags:i32=0;if(arm==4 || arm==6){flags=1;}
      let subject:i32=101+off;if(arm==5 || arm==6){subject=301+off;}
      let answer:i32=ev_query(W,subject,99+off,-2,flags);
      met("ownership rename=",rename);met(" arm=",arm);met(" clone_identical=",same);met(" maps_before=",beforemaps);
      met(" exec_before=",beforeexec);met(" facts_before=",beforefacts);met(" flags=",flags);met(" answer=",answer);
      met(" maps_after=",counttype(W,20));met(" trial_stats=",hg(W,16));emit("\n");
      if(same!=1){unexpected=unexpected+1;}
      if(arm<=2 && answer!=31){unexpected=unexpected+1;}
      if(arm==3 && answer!=-2){unexpected=unexpected+1;}
      if(arm==4 && answer!=31){unexpected=unexpected+1;}
      if(arm==5 && answer!=-2){unexpected=unexpected+1;}
      if(arm==6 && answer!=41){unexpected=unexpected+1;}
      if(arm==2 && (beforemaps!=0 || beforeexec!=0)){unexpected=unexpected+1;}
      // Licensing facts must remain as originally observed.
      let f1:i32=activate(W,101+off,11+off);let f2:i32=activate(W,201+off,12+off);
      if(f1<0 || f2<0){unexpected=unexpected+1;}
      else {if(ng(W,f1,28)!=201+off || ng(W,f2,28)!=31){unexpected=unexpected+1;}}
      arm=arm+1;
    }
    let D:[]u8=clone(S);let same:i32=t2_exec(D,root,101+off);let transfer:i32=t2_exec(D,root,301+off);
    // Strong flat relation join uses same fact graph, but explicitly supplied r11/r12 semantics.
    let link:i32=t2_lu_first(S,301+off,11+off);let terminal:i32=-1;let flat:i32=-2;
    if(link>=0){terminal=t2_lu_first(S,ng(S,link,28),12+off);}if(terminal>=0){flat=ng(S,terminal,28);}
    met("direct_graph rename=",rename);met(" original_subject=",same);met(" heldout_subject=",transfer);met(" flat_join=",flat);emit("\n");
    if(same!=31 || transfer!=-999999 || flat!=41 || checksum(S)!=original){unexpected=unexpected+1;}
    rename=rename+1;
  }
  met("instrumentation_unexpected=",unexpected);emit("\n");if(unexpected!=0){return 1;}return 0;
}

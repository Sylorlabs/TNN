// Appended to unchanged frozen core before test battery.
fn ASZ()i32 {return 200000;}
fn og(S:[]u8,n:i32,f:i32)i32 {return get32(S,1024+n*288+f);}
fn os(S:[]u8,n:i32,f:i32,v:i32)void {set32(S,1024+n*288+f,v);return;}
fn met(s:[]u8,v:i32)void {emit(s);e64(v);return;}
fn clone(S:[]u8)[]u8 {let D:[]u8=z_alloc(S.len);let i:i32=0;while(i<S.len){D[i]=S[i];i=i+1;}return D;}
fn alloc(S:[]u8)i32 {let n:i32=get32(S,0);if(n>=600){return -1;}set32(S,0,n+1);return n;}
fn primitive(S:[]u8,semantic:i32)i32 {
  let n:i32=alloc(S);let tag:i32=semantic;if(get32(S,8)==1){tag=3-semantic;}
  os(S,n,0,tag);os(S,n,12,1);os(S,n,16,1);os(S,n,24,tag);return n;
}
fn libadd(S:[]u8,n:i32)void {let k:i32=get32(S,4);set32(S,64+k*4,n);set32(S,4,k+1);return;}
fn initial(rename:i32)[]u8 {
  let S:[]u8=z_alloc(ASZ());set32(S,8,rename);set32(S,0,rename*3);
  let a:i32=primitive(S,1);let b:i32=primitive(S,2);libadd(S,a);libadd(S,b);return S;
}
fn effect(S:[]u8,tag:i32,x:i32,W:[]u8)i32 {
  set32(W,4,get32(W,4)+1);let semantic:i32=tag;if(get32(S,8)==1){semantic=3-tag;}
  if(semantic==1){return x+1;}return x*2;
}
fn run(S:[]u8,n:i32,x:i32,W:[]u8)i32 {
  if(n<0 || n>=get32(S,0)){return -999999;}
  let tag:i32=og(S,n,0);
  if(tag==1 || tag==2){return effect(S,tag,x,W);}
  if(tag==3){return run(S,og(S,n,8),run(S,og(S,n,4),x,W),W);}
  if(tag==4){let i:i32=0;let v:i32=x;while(i<og(S,n,12)){v=effect(S,og(S,n,24+i*4),v,W);i=i+1;}return v;}
  return -999999;
}
fn join(S:[]u8,a:i32,b:i32)i32 {
  let n:i32=alloc(S);if(n<0){return -1;}let la:i32=og(S,a,12);let lb:i32=og(S,b,12);
  if(la+lb>64){return -1;}os(S,n,0,3);os(S,n,4,a);os(S,n,8,b);os(S,n,12,la+lb);
  let d:i32=og(S,a,16);if(og(S,b,16)>d){d=og(S,b,16);}os(S,n,16,d+1);
  let i:i32=0;while(i<la){os(S,n,24+i*4,og(S,a,24+i*4));i=i+1;}
  i=0;while(i<lb){os(S,n,24+(la+i)*4,og(S,b,24+i*4));i=i+1;}return n;
}
fn mkseq(S:[]u8,T:[]u8,len:i32)i32 {
  let root:i32=get32(T,0);let j:i32=1;while(j<len){root=join(S,root,get32(T,j*4));j=j+1;}return root;
}
fn sequence(S:[]u8,T:[]u8,len:i32,x:i32,W:[]u8)i32 {
  let i:i32=0;let v:i32=x;while(i<len){v=run(S,get32(T,i*4),v,W);i=i+1;}return v;
}
fn fits(S:[]u8,T:[]u8,len:i32,F:[]u8,n:i32,W:[]u8)i32 {
  let i:i32=0;while(i<n){if(sequence(S,T,len,get32(F,i*8),W)!=get32(F,i*8+4)){return 0;}i=i+1;}return 1;
}
fn mkF(xs:[]u8,n:i32,a:i32,b:i32)[]u8 {
  let F:[]u8=z_alloc(64);let i:i32=0;
  while(i<n){let x:i32=get32(xs,i*4);set32(F,i*8,x);set32(F,i*8+4,a*x+b);i=i+1;}return F;
}
// W: 0 candidate tests, 4 primitive effects, 12 first-fit length.
fn acquire(S:[]u8,F:[]u8,n:i32,W:[]u8)i32 {
  let k:i32=get32(S,4);let T:[]u8=z_alloc(32);let len:i32=1;let cap:i32=k;
  while(len<=6 && get32(W,0)<4096){
    let id:i32=0;
    while(id<cap && get32(W,0)<4096){
      let code:i32=id;let pos:i32=len-1;
      while(pos>=0){set32(T,pos*4,get32(S,64+(code%k)*4));code=code/k;pos=pos-1;}
      set32(W,0,get32(W,0)+1);
      if(fits(S,T,len,F,n,W)==1){let root:i32=mkseq(S,T,len);libadd(S,root);return root;}
      id=id+1;
    }
    len=len+1;if(cap<4096){cap=cap*k;if(cap>4096){cap=4096;}}
  }
  return -1;
}
fn samevec(V:[]u8,OUT:[]u8,idx:i32,np:i32)i32 {
  let j:i32=0;while(j<np){if(get32(V,j*4)!=get32(OUT,(idx*np+j)*4)){return 0;}j=j+1;}return 1;
}
fn recorded(OUT:[]u8,distinct:i32,V:[]u8,np:i32)i32 {
  let i:i32=0;while(i<distinct){if(samevec(V,OUT,i,np)==1){return 1;}i=i+1;}return 0;
}
fn storevec(OUT:[]u8,distinct:i32,V:[]u8,np:i32)void {
  let j:i32=0;while(j<np){set32(OUT,(distinct*np+j)*4,get32(V,j*4));j=j+1;}return;
}
fn storeT(FIRST:[]u8,T:[]u8,len:i32)void {
  let j:i32=0;while(j<len){set32(FIRST,j*4,get32(T,j*4));j=j+1;}return;
}
// Enumerate every fit within budget; group by outcome vector on probe inputs.
fn enumerate(S:[]u8,F:[]u8,n:i32,probe:[]u8,np:i32,OUT:[]u8,FIRST:[]u8,W:[]u8)i32 {
  let k:i32=get32(S,4);let T:[]u8=z_alloc(32);let V:[]u8=z_alloc(32);
  let len:i32=1;let cap:i32=k;let distinct:i32=0;
  while(len<=6 && get32(W,0)<4096){
    let id:i32=0;
    while(id<cap && get32(W,0)<4096){
      let code:i32=id;let pos:i32=len-1;
      while(pos>=0){set32(T,pos*4,get32(S,64+(code%k)*4));code=code/k;pos=pos-1;}
      set32(W,0,get32(W,0)+1);
      if(fits(S,T,len,F,n,W)==1 && distinct<8){
        let j:i32=0;
        while(j<np){set32(V,j*4,sequence(S,T,len,get32(probe,j*4),W));j=j+1;}
        if(recorded(OUT,distinct,V,np)==0){
          if(distinct==0){storeT(FIRST,T,len);set32(W,12,len);}
          storevec(OUT,distinct,V,np);distinct=distinct+1;
        }
      }
      id=id+1;
    }
    len=len+1;if(cap<4096){cap=cap*k;if(cap>4096){cap=4096;}}
  }
  return distinct;
}
fn correct(S:[]u8,root:i32,a:i32,b:i32)i32 {
  let W:[]u8=z_alloc(16);let x:i32=5;let n:i32=0;
  while(x<=12){if(run(S,root,x,W)==a*x+b){n=n+1;}x=x+1;}return n;
}
fn correctseq(S:[]u8,T:[]u8,len:i32,a:i32,b:i32)i32 {
  let W:[]u8=z_alloc(16);let x:i32=5;let n:i32=0;
  while(x<=12){if(sequence(S,T,len,x,W)==a*x+b){n=n+1;}x=x+1;}return n;
}
// Wrong composite [add1 repeated j,double] = 2x+2j, j=1..K. Never fits 2x+1.
fn addwrong(S:[]u8,K:i32)i32 {
  let a:i32=get32(S,64);let b:i32=get32(S,68);let made:i32=0;
  while(made<K){
    let T:[]u8=z_alloc(144);let len:i32=0;let j:i32=0;
    while(j<=made){set32(T,len*4,a);len=len+1;j=j+1;}
    set32(T,len*4,b);len=len+1;
    let c:i32=mkseq(S,T,len);if(c>=0){libadd(S,c);}made=made+1;
  }
  return made;
}
fn flat(S:[]u8)void {let n:i32=0;while(n<get32(S,0)){if(og(S,n,0)==3){os(S,n,0,4);}n=n+1;}return;}
fn xs3()[]u8 {let X:[]u8=z_alloc(16);set32(X,0,-2);set32(X,4,0);set32(X,8,2);return X;}
fn pointsn(setid:i32)i32 {let n:i32=3;if(setid==1){n=1;}if(setid==2){n=2;}if(setid==4){n=4;}return n;}
fn points(setid:i32)[]u8 {
  let X:[]u8=z_alloc(16);set32(X,0,-2);set32(X,4,0);set32(X,8,2);set32(X,12,4);
  if(setid==1){set32(X,0,0);}
  if(setid==2){set32(X,0,-2);set32(X,4,0);}
  return X;
}
fn probearr()[]u8 {let P:[]u8=z_alloc(16);set32(P,0,1);set32(P,4,3);set32(P,8,5);set32(P,12,7);return P;}
fn nextK(k:i32)i32 {
  if(k==0){return 4;}if(k==4){return 8;}if(k==8){return 16;}if(k==16){return 32;}return 64;
}
fn run_conflict(rename:i32,variant:i32,K:i32,flatarm:i32)i32 {
  let S:[]u8=initial(rename);
  if(K>0){addwrong(S,K);}
  if(flatarm==1){flat(S);}
  let F:[]u8=mkF(xs3(),3,2,1);let W:[]u8=z_alloc(16);
  let root:i32=acquire(S,F,3,W);let corr:i32=correct(S,root,2,1);
  met("conflict rename=",rename);met(" variant=",variant);met(" K=",K);met(" flat=",flatarm);
  met(" tests=",get32(W,0));met(" effects=",get32(W,4));met(" correct=",corr);
  met(" root=",root);met(" lib=",get32(S,4));emit("\n");
  let errors:i32=0;if(corr!=8 || root<0){errors=errors+1;}return errors;
}
fn run_ambig(rename:i32,setid:i32)i32 {
  let S:[]u8=initial(rename);let n:i32=pointsn(setid);
  let F:[]u8=mkF(points(setid),n,2,1);let OUT:[]u8=z_alloc(128);let FIRST:[]u8=z_alloc(32);let W:[]u8=z_alloc(16);
  let distinct:i32=enumerate(S,F,n,probearr(),4,OUT,FIRST,W);
  let abstain:i32=0;if(distinct!=1){abstain=1;}
  let corr:i32=-1;let probeval:i32=-999999;let one:[]u8=z_alloc(16);
  if(distinct==1){let len:i32=get32(W,12);corr=correctseq(S,FIRST,len,2,1);probeval=sequence(S,FIRST,len,5,one);}
  met("ambig rename=",rename);met(" set=",setid);met(" points=",n);met(" distinct=",distinct);
  met(" tests=",get32(W,0));met(" abstained=",abstain);met(" heldout_correct=",corr);met(" x5=",probeval);emit("\n");
  let errors:i32=0;
  if(setid==1){if(distinct<2 || abstain!=1){errors=errors+1;}}
  if(setid>1){if(distinct!=1 || corr!=8 || abstain!=0){errors=errors+1;}}
  return errors;
}
fn main()i32 {
  let errors:i32=0;let rename:i32=0;
  while(rename<2){
    errors=errors+run_conflict(rename,0,0,0);
    errors=errors+run_conflict(rename,1,1,0);
    errors=errors+run_conflict(rename,2,1,1);
    let K:i32=0;while(K<=32){errors=errors+run_conflict(rename,3,K,0);K=nextK(K);}
    let setid:i32=1;while(setid<=4){errors=errors+run_ambig(rename,setid);setid=setid+1;}
    rename=rename+1;
  }
  met("instrumentation_unexpected=",errors);emit("\n");
  if(errors!=0){return 1;}return 0;
}

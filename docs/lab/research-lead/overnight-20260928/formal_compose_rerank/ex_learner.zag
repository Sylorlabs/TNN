// learner.zag -- L2 EXTEND-XDOMAIN (cross-domain extend with a
// learner-chosen extension length), standalone. Generic machinery
// + learned state only. No world data, no fact literals, no
// relation literals, no domain literals, no length literals in
// this file. The learner never selects a source MAP per problem:
// ex_query searches the learned MAP inventory in MAP-id order for
// the first capability-matching MAP (any domain). The full source
// procedure is grounded first; on failure a
// shortest-verifying-extension enumeration (k = nf+1 upward to a
// fixed generic bound KMAX=6) chooses the extension length at
// runtime. Every interface mapping (entry relation, fold-pair
// relations, value relation) is discovered from learner state and
// world facts, never hardcoded.
// Prereg: l2_extend_xdomain/PREREG.md (frozen). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 EXTEND_ON (driver flag, never learner-written)
//   4 NN  5 unused  6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_EXT  12 EX_ENTERED
//   13 SRC_ID (255=none)
//   16..319:  facts, 38 x 8B [sub,rel,obj,live,0,0,0,0]
//   320..959: MAPs, 16 x 40B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x12 @+8, facts x12 @+20,
//               dom @+32, cap @+33, d_entry @+34, d_r1 @+35,
//               d_r2 @+36, d_nf @+37, d_valrel @+38, pad @+39]
//   960..1215: edges, 64 x 4B [from,to,type,pad]
//   1216..1247: answer nodes, 8 x 4B [via,0,0,0]
//   1248 SEARCH i32  1252 EXEC i32  1256 A_SEARCH i32  1260 A_EXEC i32
//   1264 LAST_VAL i32  1268 SRC_ID32 (i32 mirror)  1272 LAST_TERM i32
//   1276 EXT_K i32  1280 FULL_OK i32  1284 EXT_DECIDED i32
//   1288 EXT_TRIES i32 (extension lengths attempted)
//   1292..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn ex_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ex_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ex_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn ex_tick(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_tickm(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_exec(st:[]u8)void {
  set32(st,1252,get32(st,1252)+1);
  if((st[11] as i32)==1){set32(st,1260,get32(st,1260)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=38){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (40-byte rows, 12 rel/fact slots) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>12){return -1;}
  if(fl>12){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==AGG only), generic:
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  es_item_new(st,n);
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  es_item_new(st,n);
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=320+mid*40;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  ex_exec(st);
  st[6]=255;
  let o:i32=320+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+20+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- counted fact scans (frozen counting rules) ----
// first live fact with sub==s, skipping rel==skiprel. counts examined.
fn ex_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// first live fact with sub==s and rel==r. counts examined.
fn ex_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// value of node nd via vrel: first live fact sub==nd, rel==vrel.
// returns value or -1. counts examined.
fn ex_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=ex_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}

// ---- fold-walk: from entry node u, walk k alternating (s1,s2)
// folds. fold 1 discovers (s1,s2) via first live facts (skipping
// vrel: value annotations are not structural hops);
// folds 2..k require rel==s1 / rel==s2.
// fills ff[0..2k) fact ids.
// returns 0 on fail, else s1 + s2*256 + term*65536.
fn ex_foldwalk(st:[]u8, u:i32, k:i32, vrel:i32, ff:[]u8)i32 {
  let f1:i32=ex_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=ex_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8;
  let j:i32=1;
  while(j<k){
    let g1:i32=ex_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=ex_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*j]=g1 as u8; ff[2*j+1]=g2 as u8;
    j=j+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- try one prefix length: entry scan, fold-walk with k folds,
// verify term==t and (v<0 or val==v). First verifying grounding
// is committed (first-match precedent). Returns pack or 0.
fn ex_try_len(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, k:i32, vrel:i32, efd:[]u8, rre:[]u8, ff:[]u8)i32 {
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let done:i32=0;
  let pack:i32=0;
  while(fid<nfacts){
    if(done==0){
      ex_tick(st);
      let fo:i32=16+fid*8;
      let cand:i32=0;
      if((st[fo+3] as i32)==1){cand=1;}
      if(cand==1){
        if((st[fo] as i32)!=s){cand=0;}
      }
      if(cand==1){
        let re:i32=st[fo+1] as i32;
        let u:i32=st[fo+2] as i32;
        let p2:i32=ex_foldwalk(st,u,k,vrel,ff);
        ex_p(ob,atp,"EX-ENTRY-CAND r=");
        ex_pi(ob,atp,re);
        ex_p(ob,atp," u=");
        ex_pi(ob,atp,u);
        if(p2==0){
          ex_p(ob,atp," FAIL-SHAPE\n");
        } else {
          let s1:i32=p2%256;
          let s2:i32=(p2/256)%256;
          let term:i32=(p2/65536)%256;
          ex_p(ob,atp," SHAPE-OK term=");
          ex_pi(ob,atp,term);
          let ok:i32=0;
          if(term==t){ok=1;}
          if(ok==1){
            if(v>=0){
              let vv:i32=ex_valof(st,term,vrel);
              if(vv!=v){ok=0;}
            }
          }
          if(ok==1){
            ex_p(ob,atp," VERIFY-OK\n");
            efd[0]=fid as u8;
            rre[0]=re as u8;
            pack=p2;
            done=1;
          } else {
            ex_p(ob,atp," VERIFY-FAIL\n");
          }
        }
      }
    }
    fid=fid+1;
  }
  return pack;
}

// ---- build, execution-verify, promote, deliver ----
fn ex_build(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, smid:i32, pack:i32, k:i32, efd:[]u8, rre:[]u8, ff:[]u8, vrel:i32)i32 {
  let s1:i32=pack%256;
  let s2:i32=(pack/256)%256;
  let term:i32=(pack/65536)%256;
  let re:i32=rre[0] as i32;
  let efid:i32=efd[0] as i32;
  let zr:[]u8=z_alloc(16);
  let zf:[]u8=z_alloc(16);
  zr[0]=re as u8;
  zf[0]=efid as u8;
  let w:i32=0;
  while(w<2*k){
    if((w%2)==0){zr[1+w]=s1 as u8;}
    else {zr[1+w]=s2 as u8;}
    zf[1+w]=ff[w];
    w=w+1;
  }
  let zl:i32=1+2*k;
  ex_p(ob,atp,"EX-ZBUILD rels=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec(st,zf,zr,zl,s);
  ex_p(ob,atp,"EX-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,zr,zl,zf,zl,s,term,qdom,1,re,s1,s2,k,vrel);
    e_add(st,zid,smid,16);
    ex_p(ob,atp,"EX-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,smid);
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- the cross-domain EXTEND operator ----
// Shortest-verifying-extension enumeration: k = nf+1 upward to
// the fixed generic bound KMAX=6. The first verifying k wins and
// the enumeration stops, so the extension is minimal by policy.
fn ex_extend(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, smid:i32, extend_on:i32)i32 {
  set32(st,1268,smid);
  set32(st,1280,0);
  set32(st,1276,-1);
  set32(st,1284,0);
  set32(st,1288,0);
  let so:i32=320+smid*40;
  let entry:i32=st[so+34] as i32;
  let r1:i32=st[so+35] as i32;
  let r2:i32=st[so+36] as i32;
  let nf:i32=st[so+37] as i32;
  let vrel:i32=st[so+38] as i32;
  ex_p(ob,atp,"EX-SRC id=");
  ex_pi(ob,atp,smid);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,entry);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,r1);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,r2);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,nf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,vrel);
  ex_pnl(ob,atp);
  let efd:[]u8=z_alloc(8);
  let rre:[]u8=z_alloc(8);
  let ff:[]u8=z_alloc(16);
  let ans:i32=-2;
  // full-length attempt first
  let k:i32=nf;
  ex_p(ob,atp,"EX-TRY k=");
  ex_pi(ob,atp,k);
  ex_pnl(ob,atp);
  let pfull:i32=ex_try_len(st,ob,atp,s,t,v,k,vrel,efd,rre,ff);
  if(pfull==0){
    ex_p(ob,atp,"EX-FAIL k=");
    ex_pi(ob,atp,k);
    ex_pnl(ob,atp);
    ex_p(ob,atp,"EX-FULL-FAIL\n");
  } else {
    set32(st,1280,1);
    ans=ex_build(st,ob,atp,s,t,v,qdom,smid,pfull,k,efd,rre,ff,vrel);
  }
  if(pfull==0){
    if(extend_on==1){
      // shortest-first extension: the learner's length choice
      k=nf+1;
      let done:i32=0;
      while(k<=6){
        if(done==0){
          ex_p(ob,atp,"EX-TRY k=");
          ex_pi(ob,atp,k);
          ex_pnl(ob,atp);
          set32(st,1288,get32(st,1288)+1);
          let pk:i32=ex_try_len(st,ob,atp,s,t,v,k,vrel,efd,rre,ff);
          if(pk==0){
            ex_p(ob,atp,"EX-FAIL k=");
            ex_pi(ob,atp,k);
            ex_pnl(ob,atp);
          } else {
            ex_p(ob,atp,"EX-OK k=");
            ex_pi(ob,atp,k);
            ex_pnl(ob,atp);
            set32(st,1276,k);
            set32(st,1284,1);
            ans=ex_build(st,ob,atp,s,t,v,qdom,smid,pk,k,efd,rre,ff,vrel);
            done=1;
          }
        }
        k=k+1;
      }
    }
  }
  return ans;
}

// ---- deliver: answer-node provenance + ANS print ----
fn ex_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1264,val);
  set32(st,1272,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  es_item_new(st,aid);
  let ao:i32=1216+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  ex_p(ob,atp,"ANS term=");
  ex_pi(ob,atp,term);
  ex_p(ob,atp," val=");
  ex_pi(ob,atp,val);
  ex_p(ob,atp," via=");
  ex_pi(ob,atp,mid);
  ex_pnl(ob,atp);
  return;
}

// ---- query: pipeline, then extend on failure ----
fn ex_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, extend_on:i32)i32 {
  st[12]=0;
  set32(st,1264,-2);
  set32(st,1268,-1);
  set32(st,1272,-2);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=320+mid*40;
      let vr2:i32=st[mo+38] as i32;
      if(vr2!=0){vv=ex_valof(st,r,vr2);}
      ex_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // extend phase
  st[11]=1;
  st[12]=1;
  set32(st,1256,0);
  set32(st,1260,0);
  ex_p(ob,atp,"EX-QUERY s=");
  ex_pi(ob,atp,s);
  ex_p(ob,atp," t=");
  ex_pi(ob,atp,t);
  ex_p(ob,atp," v=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," cap=");
  ex_pi(ob,atp,cap);
  ex_p(ob,atp," dom=");
  ex_pi(ob,atp,dom);
  ex_pnl(ob,atp);
  // capsearch: first live MAP with cap==qcap (any domain)
  let smid:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=320+mid*40;
      let mc:i32=st[o+33] as i32;
      ex_p(ob,atp,"EX-SEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=cap){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        smid=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(smid>=0){
    ans=ex_extend(st,ob,atp,s,t,v,dom,smid,extend_on);
  }
  st[11]=0;
  if(ans<0){
    ex_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1264,-2);
    set32(st,1272,-2);
  }
  return ans;
}

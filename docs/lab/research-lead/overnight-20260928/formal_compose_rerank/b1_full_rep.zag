// rr_prelude.zag -- minimal helpers for the standalone B1
// discriminator builds (no learner file catted). Byte-exact
// copies of the helpers in ex_learner.zag.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// es_rep.zag -- ARM-REP: rank-slot edge store for the L2 E2E stacks.
//
// Ported from FORMAL-COMPOSE-PORT pc_rep.zag (itself ported from
// FORMAL-COMPOSE fc_rep.zag). Extended with edge types: records
// are (child, type, next), 12 bytes. Structural vocabulary only
// (item, rank, head, link, edge, store, slot, audit): the no-wire
// grep audit must return 0 hits for domain vocabulary.
//
// Items 0..23. MAP ids map to items 0..15; answer-node ids 40..47
// (used by one learner stack) map to items 16..23. Rank = creation
// order, assigned by es_item_new: a creation-time topological
// rank, valid because the learners only ever link a newer item to
// an older one, so every valid edge goes from strictly higher to
// strictly lower rank.
//
// e_add prepends `to` to head rank(to) of item(from),
// unconditionally: no cyclicity branch exists anywhere in this
// file (no reachability, no visited sets, no graph search on the
// write path). Read path = heads 0..rank(P)-1, so a
// cycle-closing write lands outside the interpreted prefix and
// denotes no edge. Cycle-closing attaches are inexpressible,
// not refused.
//
// Layout in st:
//   1984: rank table, 24 bytes (255 = unregistered)
//   2008: rank counter (next rank); 2009: init flag
//   2048: heads, 24 items * 32 ranks * 4 bytes
//   5120: edge pool, 128 records * 12 bytes (child, type, next)
//   6656: pool cursor (i32)
//
// Relies on get32/set32/z_alloc from the learner file (forward
// references resolve; precedent pc_base.zag -> arm_nd_init).

fn es_item_of(id:i32)i32 {
  if(id>=40){ return 16+(id-40); }
  return id;
}
fn es_ensure(st:[]u8)void {
  if((st[2009] as i32)==1){ return; }
  let i:i32=0;
  while(i<24){ st[1984+i]=255; i=i+1; }
  st[2008]=0;
  st[2009]=1;
  return;
}
fn es_head_at(st:[]u8,p:i32,r:i32)i32 { return get32(st,2048+(p*32+r)*4); }
fn es_head_set(st:[]u8,p:i32,r:i32,v:i32)void { set32(st,2048+(p*32+r)*4,v); return; }
fn es_item_new(st:[]u8,id:i32)void {
  es_ensure(st);
  let it:i32=es_item_of(id);
  if(it<0){ return; }
  if(it>=24){ return; }
  if((st[1984+it] as i32)!=255){ return; }
  let rk:i32=st[2008] as i32;
  if(rk>=32){ return; }
  st[1984+it]=rk as u8;
  st[2008]=(rk+1) as u8;
  let r:i32=0;
  while(r<32){ es_head_set(st,it,r,-1); r=r+1; }
  return;
}
fn es_rec_new(st:[]u8,ch:i32,ty:i32,nx:i32)i32 {
  let n:i32=get32(st,6656);
  if(n>=128){ return -1; }
  set32(st,5120+n*12,ch);
  set32(st,5120+n*12+4,ty);
  set32(st,5120+n*12+8,nx);
  set32(st,6656,n+1);
  return n;
}
// es_link: the unconditional slot write. No cyclicity branch.
fn es_link(st:[]u8,from:i32,to:i32,typ:i32)void {
  es_ensure(st);
  let fi:i32=es_item_of(from);
  let ti:i32=es_item_of(to);
  if(fi<0){ return; }
  if(fi>=24){ return; }
  if(ti<0){ return; }
  if(ti>=24){ return; }
  if((st[1984+fi] as i32)==255){ es_item_new(st,from); }
  if((st[1984+ti] as i32)==255){ es_item_new(st,to); }
  let rc:i32=st[1984+ti] as i32;
  let e:i32=es_rec_new(st,to,typ,es_head_at(st,fi,rc));
  if(e>=0){ es_head_set(st,fi,rc,e); }
  return;
}
fn e_add(st:[]u8,from:i32,to:i32,typ:i32)void {
  if(e_has(st,from,to,typ)==1){ return; }
  es_link(st,from,to,typ);
  return;
}
// ---- read path: interpreted prefix only ----
// visible dep count of item it (all types)
fn es_ndeps(st:[]u8,it:i32)i32 {
  es_ensure(st);
  if(it<0){ return 0; }
  if(it>=24){ return 0; }
  let rp:i32=st[1984+it] as i32;
  if(rp==255){ return 0; }
  if(rp>32){ return 0; }
  let n:i32=0;
  let r:i32=0;
  while(r<rp){
    let e:i32=es_head_at(st,it,r);
    while(e>=0){ n=n+1; e=get32(st,5120+e*12+8); }
    r=r+1;
  }
  return n;
}
// item index of the i-th visible dep of item it; -1 if none
fn es_dep_at(st:[]u8,it:i32,i:i32)i32 {
  es_ensure(st);
  if(it<0){ return -1; }
  if(it>=24){ return -1; }
  let rp:i32=st[1984+it] as i32;
  if(rp==255){ return -1; }
  if(rp>32){ return -1; }
  let n:i32=0;
  let r:i32=0;
  while(r<rp){
    let e:i32=es_head_at(st,it,r);
    while(e>=0){
      if(n==i){ return es_item_of(get32(st,5120+e*12)); }
      n=n+1;
      e=get32(st,5120+e*12+8);
    }
    r=r+1;
  }
  return -1;
}
fn e_has(st:[]u8,from:i32,to:i32,typ:i32)i32 {
  es_ensure(st);
  let fi:i32=es_item_of(from);
  if(fi<0){ return 0; }
  if(fi>=24){ return 0; }
  let rp:i32=st[1984+fi] as i32;
  if(rp==255){ return 0; }
  let rr:i32=rp;
  if(rr>32){ rr=32; }
  let r:i32=0;
  while(r<rr){
    let e:i32=es_head_at(st,fi,r);
    while(e>=0){
      let ch:i32=get32(st,5120+e*12);
      let ty:i32=get32(st,5120+e*12+4);
      if(ch==to){
        if(ty==typ){ return 1; }
      }
      e=get32(st,5120+e*12+8);
    }
    r=r+1;
  }
  return 0;
}
fn es_icount(st:[]u8,it:i32,typ:i32)i32 {
  let rp:i32=st[1984+it] as i32;
  if(rp==255){ return 0; }
  let rr:i32=rp;
  if(rr>32){ rr=32; }
  let c:i32=0;
  let r:i32=0;
  while(r<rr){
    let e:i32=es_head_at(st,it,r);
    while(e>=0){
      if(get32(st,5120+e*12+4)==typ){ c=c+1; }
      e=get32(st,5120+e*12+8);
    }
    r=r+1;
  }
  return c;
}
fn e_count(st:[]u8,typ:i32)i32 {
  es_ensure(st);
  let c:i32=0;
  let it:i32=0;
  while(it<24){ c=c+es_icount(st,it,typ); it=it+1; }
  return c;
}
fn es_ihas_to(st:[]u8,it:i32,to:i32,typ:i32)i32 {
  let rp:i32=st[1984+it] as i32;
  if(rp==255){ return 0; }
  let rr:i32=rp;
  if(rr>32){ rr=32; }
  let r:i32=0;
  while(r<rr){
    let e:i32=es_head_at(st,it,r);
    while(e>=0){
      let ch:i32=get32(st,5120+e*12);
      let ty:i32=get32(st,5120+e*12+4);
      if(ch==to){
        if(ty==typ){ return 1; }
      }
      e=get32(st,5120+e*12+8);
    }
    r=r+1;
  }
  return 0;
}
fn e_has_to(st:[]u8,to:i32,typ:i32)i32 {
  es_ensure(st);
  let it:i32=0;
  while(it<24){
    if(es_ihas_to(st,it,to,typ)==1){ return 1; }
    it=it+1;
  }
  return 0;
}
fn es_ioth(st:[]u8,it:i32)i32 {
  let rp:i32=st[1984+it] as i32;
  if(rp==255){ return 0; }
  let rr:i32=rp;
  if(rr>32){ rr=32; }
  let c:i32=0;
  let r:i32=0;
  while(r<rr){
    let e:i32=es_head_at(st,it,r);
    while(e>=0){
      let ty:i32=get32(st,5120+e*12+4);
      if(ty!=14){
        if(ty!=16){ c=c+1; }
      }
      e=get32(st,5120+e*12+8);
    }
    r=r+1;
  }
  return c;
}
fn ex_eoth(st:[]u8)i32 {
  es_ensure(st);
  let c:i32=0;
  let it:i32=0;
  while(it<24){ c=c+es_ioth(st,it); it=it+1; }
  return c;
}
// es_raw: lowest-level write; on REP there is no gate to bypass,
// so this is the same slot write.
fn es_raw(st:[]u8,from:i32,to:i32,typ:i32)void {
  es_link(st,from,to,typ);
  return;
}
// ---- cycle audit (measurement only; identical algorithm all arms) ----
// Counts items lying on a directed cycle of the READ graph.
fn es_reach(st:[]u8,x:i32,tgt:i32,vis:[]u8)i32 {
  if(x==tgt){ return 1; }
  if(x<0){ return 0; }
  if(x>=24){ return 0; }
  if((vis[x] as i32)==1){ return 0; }
  vis[x]=1 as u8;
  let n:i32=es_ndeps(st,x);
  let i:i32=0;
  while(i<n){
    if(es_reach(st,es_dep_at(st,x,i),tgt,vis)==1){ return 1; }
    i=i+1;
  }
  return 0;
}
fn es_audit(st:[]u8)i32 {
  es_ensure(st);
  let c:i32=0;
  let u:i32=0;
  while(u<24){
    let rp:i32=st[1984+u] as i32;
    if(rp!=255){
      let vis:[]u8=z_alloc(24);
      let nd:i32=es_ndeps(st,u);
      let i:i32=0;
      let on:i32=0;
      while(i<nd){
        if(es_reach(st,es_dep_at(st,u,i),u,vis)==1){ on=1; }
        i=i+1;
      }
      if(on==1){ c=c+1; }
    }
    u=u+1;
  }
  return c;
}
// ---- rerank-interface diagnostics (stubs: fixed ranks, no promotion) ----
fn es_promotes(st:[]u8)i32 { es_ensure(st); return 0; }
fn es_maxrank(st:[]u8)i32 { es_ensure(st); return (st[2008] as i32)-1; }
fn es_diverge(st:[]u8)i32 { es_ensure(st); return 0; }
// b1_batt.zag -- the frozen B1 battery, shared byte-identical
// across all four builds (catted after the store file).
// Uses only the frozen store interface: es_item_new, e_add,
// e_has, es_raw, es_audit, e_count, es_maxrank, es_promotes,
// es_diverge. Emit helpers are b1_-prefixed (no collisions).

fn b1_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn b1_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn b1_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn b1_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  b1_p(ob,atp,nm);
  b1_p(ob,atp,"=");
  b1_pi(ob,atp,v);
  b1_p(ob,atp," ");
  return;
}
// b1_run: controlled DAG on a fresh state, then the B1
// attaches (acyclic cross-rank), then the adversarial
// battery (cycle-closing attaches + raw probes). Frozen order.
fn b1_run(ob:[]u8, atp:[]u8)void {
  let st:[]u8=z_alloc(65536);
  let k:i32=4;
  while(k<=15){ es_item_new(st,k); k=k+1; }
  e_add(st,9,8,1);
  e_add(st,9,7,1);
  e_add(st,8,7,1);
  e_add(st,6,5,1);
  e_add(st,6,4,1);
  e_add(st,5,4,1);
  e_add(st,4,9,2);
  e_add(st,12,11,1);
  e_add(st,12,10,1);
  e_add(st,11,10,1);
  e_add(st,7,12,2);
  e_add(st,15,14,1);
  e_add(st,15,13,1);
  e_add(st,14,13,1);
  e_add(st,9,15,2);
  e_add(st,7,9,2);
  e_add(st,12,12,2);
  es_raw(st,7,9,2);
  es_raw(st,12,12,2);
  let b1a:i32=e_has(st,4,9,2);
  let b1b:i32=e_has(st,7,12,2);
  let b1c:i32=e_has(st,9,15,2);
  let a1:i32=e_has(st,7,9,2);
  let a2:i32=e_has(st,12,12,2);
  let a3:i32=e_has(st,7,9,2);
  let audit:i32=es_audit(st);
  let vall:i32=1;
  if(e_has(st,9,8,1)==0){ vall=0; }
  if(e_has(st,9,7,1)==0){ vall=0; }
  if(e_has(st,8,7,1)==0){ vall=0; }
  if(e_has(st,6,5,1)==0){ vall=0; }
  if(e_has(st,6,4,1)==0){ vall=0; }
  if(e_has(st,5,4,1)==0){ vall=0; }
  if(e_has(st,12,11,1)==0){ vall=0; }
  if(e_has(st,12,10,1)==0){ vall=0; }
  if(e_has(st,11,10,1)==0){ vall=0; }
  if(e_has(st,15,14,1)==0){ vall=0; }
  if(e_has(st,15,13,1)==0){ vall=0; }
  if(e_has(st,14,13,1)==0){ vall=0; }
  let t1:i32=e_count(st,1);
  let t2:i32=e_count(st,2);
  b1_p(ob,atp,"B1 ");
  b1_bar(ob,atp,"b1a",b1a);
  b1_bar(ob,atp,"b1b",b1b);
  b1_bar(ob,atp,"b1c",b1c);
  b1_bar(ob,atp,"a1",a1);
  b1_bar(ob,atp,"a2",a2);
  b1_bar(ob,atp,"a3",a3);
  b1_bar(ob,atp,"audit",audit);
  b1_bar(ob,atp,"vall",vall);
  b1_bar(ob,atp,"t1",t1);
  b1_bar(ob,atp,"t2",t2);
  b1_pnl(ob,atp);
  b1_p(ob,atp,"B1D ");
  b1_bar(ob,atp,"maxrank",es_maxrank(st));
  b1_bar(ob,atp,"promotes",es_promotes(st));
  b1_bar(ob,atp,"diverge",es_diverge(st));
  b1_pnl(ob,atp);
  return;
}
// b1_main.zag -- standalone main for the B1 discriminator
// binaries (b1_rep_bin, b1_list_bin).
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  b1_run(ob,atp);
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

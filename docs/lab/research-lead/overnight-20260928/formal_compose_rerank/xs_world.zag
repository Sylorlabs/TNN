// MAPs: mD2 (id 0, B ROUTE 2-hop), mG (id 1, A GENERAL AGG),
// mB0 (id 2, B ROUTE 3-hop)
fn teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=7; rs[1]=7;
  fs[0]=11; fs[1]=12;
  m_teach(st,rs,2,fs,2,54,56,2,2);
  rs=z_alloc(8);
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs=z_alloc(8);
  fs[0]=10; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  rs=z_alloc(8);
  rs[0]=7; rs[1]=7; rs[2]=7;
  fs=z_alloc(8);
  fs[0]=13; fs[1]=14; fs[2]=15;
  m_teach(st,rs,3,fs,3,50,53,2,2);
  return;
}

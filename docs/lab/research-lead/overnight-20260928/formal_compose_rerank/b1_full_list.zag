// rr_prelude.zag -- minimal helpers for the standalone B1
// discriminator builds (no learner file catted). Byte-exact
// copies of the helpers in ex_learner.zag.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// es_list_rr.zag -- ARM-LIST: unconstrained edge store with the
// RERANK interface (the discriminator arm). Flat edge list;
// the read path returns every written edge. Structural
// vocabulary only.
//
// Layout in st:
//   1984: registered[24], u8
//   2008: registration counter, i32
//   2012: edge tally, i32
//   2048: edges, 512 records * 12 bytes (from-item, to-id, type)

fn es_item_of(id:i32)i32 {
  if(id>=40){ return 16+(id-40); }
  return id;
}
fn es_ensure(st:[]u8)void {
  if((st[1984] as i32)==2){ return; }
  let i:i32=0;
  while(i<24){ st[1984+1+i]=0; i=i+1; }
  set32(st,2008,0);
  set32(st,2012,0);
  st[1984]=2;
  return;
}
fn es_item_new(st:[]u8,id:i32)void {
  es_ensure(st);
  let it:i32=es_item_of(id);
  if(it<0){ return; }
  if(it>=24){ return; }
  if((st[1984+1+it] as i32)==1){ return; }
  st[1984+1+it]=1;
  set32(st,2008,get32(st,2008)+1);
  return;
}
fn es_e_at(st:[]u8,e:i32,f:i32)i32 {
  return get32(st,2048+e*12+f*4);
}
fn es_e_set(st:[]u8,e:i32,f:i32,v:i32)void {
  set32(st,2048+e*12+f*4,v);
  return;
}
fn e_has(st:[]u8,from:i32,to:i32,typ:i32)i32 {
  es_ensure(st);
  let fi:i32=es_item_of(from);
  let n:i32=get32(st,2012);
  let e:i32=0;
  while(e<n){
    if(es_e_at(st,e,0)==fi){
      if(es_e_at(st,e,1)==to){
        if(es_e_at(st,e,2)==typ){ return 1; }
      }
    }
    e=e+1;
  }
  return 0;
}
fn es_push(st:[]u8,from:i32,to:i32,typ:i32)void {
  let n:i32=get32(st,2012);
  if(n>=512){ return; }
  es_e_set(st,n,0,es_item_of(from));
  es_e_set(st,n,1,to);
  es_e_set(st,n,2,typ);
  set32(st,2012,n+1);
  return;
}
fn e_add(st:[]u8,from:i32,to:i32,typ:i32)void {
  es_ensure(st);
  es_item_new(st,from);
  es_item_new(st,to);
  if(e_has(st,from,to,typ)==1){ return; }
  es_push(st,from,to,typ);
  return;
}
fn es_raw(st:[]u8,from:i32,to:i32,typ:i32)void {
  es_ensure(st);
  es_item_new(st,from);
  es_item_new(st,to);
  es_push(st,from,to,typ);
  return;
}
fn es_ndeps(st:[]u8,it:i32)i32 {
  es_ensure(st);
  if(it<0){ return 0; }
  if(it>=24){ return 0; }
  let n:i32=get32(st,2012);
  let c:i32=0;
  let e:i32=0;
  while(e<n){
    if(es_e_at(st,e,0)==it){ c=c+1; }
    e=e+1;
  }
  return c;
}
fn es_dep_at(st:[]u8,it:i32,i:i32)i32 {
  es_ensure(st);
  if(it<0){ return -1; }
  if(it>=24){ return -1; }
  let n:i32=get32(st,2012);
  let c:i32=0;
  let e:i32=0;
  while(e<n){
    if(es_e_at(st,e,0)==it){
      if(c==i){ return es_item_of(es_e_at(st,e,1)); }
      c=c+1;
    }
    e=e+1;
  }
  return -1;
}
fn e_count(st:[]u8,typ:i32)i32 {
  es_ensure(st);
  let n:i32=get32(st,2012);
  let c:i32=0;
  let e:i32=0;
  while(e<n){
    if(es_e_at(st,e,2)==typ){ c=c+1; }
    e=e+1;
  }
  return c;
}
fn es_promotes(st:[]u8)i32 { es_ensure(st); return 0; }
fn es_maxrank(st:[]u8)i32 {
  es_ensure(st);
  return get32(st,2008)-1;
}
fn es_diverge(st:[]u8)i32 { es_ensure(st); return 0; }
fn es_reach(st:[]u8,x:i32,tgt:i32,vis:[]u8)i32 {
  if(x==tgt){ return 1; }
  if(x<0){ return 0; }
  if(x>=24){ return 0; }
  if((vis[x] as i32)==1){ return 0; }
  vis[x]=1 as u8;
  let n:i32=es_ndeps(st,x);
  let i:i32=0;
  while(i<n){
    if(es_reach(st,es_dep_at(st,x,i),tgt,vis)==1){ return 1; }
    i=i+1;
  }
  return 0;
}
fn es_audit(st:[]u8)i32 {
  es_ensure(st);
  let c:i32=0;
  let u:i32=0;
  while(u<24){
    if((st[1984+1+u] as i32)==1){
      let vis:[]u8=z_alloc(24);
      let nd:i32=es_ndeps(st,u);
      let i:i32=0;
      let on:i32=0;
      while(i<nd){
        if(es_reach(st,es_dep_at(st,u,i),u,vis)==1){ on=1; }
        i=i+1;
      }
      if(on==1){ c=c+1; }
    }
    u=u+1;
  }
  return c;
}
// b1_batt.zag -- the frozen B1 battery, shared byte-identical
// across all four builds (catted after the store file).
// Uses only the frozen store interface: es_item_new, e_add,
// e_has, es_raw, es_audit, e_count, es_maxrank, es_promotes,
// es_diverge. Emit helpers are b1_-prefixed (no collisions).

fn b1_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn b1_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn b1_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn b1_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  b1_p(ob,atp,nm);
  b1_p(ob,atp,"=");
  b1_pi(ob,atp,v);
  b1_p(ob,atp," ");
  return;
}
// b1_run: controlled DAG on a fresh state, then the B1
// attaches (acyclic cross-rank), then the adversarial
// battery (cycle-closing attaches + raw probes). Frozen order.
fn b1_run(ob:[]u8, atp:[]u8)void {
  let st:[]u8=z_alloc(65536);
  let k:i32=4;
  while(k<=15){ es_item_new(st,k); k=k+1; }
  e_add(st,9,8,1);
  e_add(st,9,7,1);
  e_add(st,8,7,1);
  e_add(st,6,5,1);
  e_add(st,6,4,1);
  e_add(st,5,4,1);
  e_add(st,4,9,2);
  e_add(st,12,11,1);
  e_add(st,12,10,1);
  e_add(st,11,10,1);
  e_add(st,7,12,2);
  e_add(st,15,14,1);
  e_add(st,15,13,1);
  e_add(st,14,13,1);
  e_add(st,9,15,2);
  e_add(st,7,9,2);
  e_add(st,12,12,2);
  es_raw(st,7,9,2);
  es_raw(st,12,12,2);
  let b1a:i32=e_has(st,4,9,2);
  let b1b:i32=e_has(st,7,12,2);
  let b1c:i32=e_has(st,9,15,2);
  let a1:i32=e_has(st,7,9,2);
  let a2:i32=e_has(st,12,12,2);
  let a3:i32=e_has(st,7,9,2);
  let audit:i32=es_audit(st);
  let vall:i32=1;
  if(e_has(st,9,8,1)==0){ vall=0; }
  if(e_has(st,9,7,1)==0){ vall=0; }
  if(e_has(st,8,7,1)==0){ vall=0; }
  if(e_has(st,6,5,1)==0){ vall=0; }
  if(e_has(st,6,4,1)==0){ vall=0; }
  if(e_has(st,5,4,1)==0){ vall=0; }
  if(e_has(st,12,11,1)==0){ vall=0; }
  if(e_has(st,12,10,1)==0){ vall=0; }
  if(e_has(st,11,10,1)==0){ vall=0; }
  if(e_has(st,15,14,1)==0){ vall=0; }
  if(e_has(st,15,13,1)==0){ vall=0; }
  if(e_has(st,14,13,1)==0){ vall=0; }
  let t1:i32=e_count(st,1);
  let t2:i32=e_count(st,2);
  b1_p(ob,atp,"B1 ");
  b1_bar(ob,atp,"b1a",b1a);
  b1_bar(ob,atp,"b1b",b1b);
  b1_bar(ob,atp,"b1c",b1c);
  b1_bar(ob,atp,"a1",a1);
  b1_bar(ob,atp,"a2",a2);
  b1_bar(ob,atp,"a3",a3);
  b1_bar(ob,atp,"audit",audit);
  b1_bar(ob,atp,"vall",vall);
  b1_bar(ob,atp,"t1",t1);
  b1_bar(ob,atp,"t2",t2);
  b1_pnl(ob,atp);
  b1_p(ob,atp,"B1D ");
  b1_bar(ob,atp,"maxrank",es_maxrank(st));
  b1_bar(ob,atp,"promotes",es_promotes(st));
  b1_bar(ob,atp,"diverge",es_diverge(st));
  b1_pnl(ob,atp);
  return;
}
// b1_main.zag -- standalone main for the B1 discriminator
// binaries (b1_rep_bin, b1_list_bin).
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  b1_run(ob,atp);
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// ---- P-INT5: DEVINT-CLA2 11 stages (compact curriculum) ----
fn t_dv()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // S1-S2: teach episodes, segment (teach 12)
  let i:i32=0;
  while(i<12){ev_teach(W,100+i,1,200+i); i=i+1;}
  // S3: form 4 groups
  let g0:i32=alloc_node(W); ns(W,g0,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,2);
  let g2:i32=alloc_node(W); ns(W,g2,0,2);
  let g3:i32=alloc_node(W); ns(W,g3,0,2);
  // S4: bigram edges (link 12)
  i=0; while(i<11){link_edge(W,100+i,1,101+i,0); i=i+1;}
  // S5: 5 rules via exact key (simplified)
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let r1:i32=ev_query(W,1,11,-2,0);
  // S6: procedure executes (via exact key)
  // S7: contradiction
  ev_teach(W,50,21,60); ev_observe(W,50,21,61);
  // S8: inquiry via uncertainty
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,70);
  // S9: demotion with history
  // S10: eviction pressure (60 teaches)
  i=0; while(i<60){ev_teach(W,600+i,31,i); i=i+1;}
  // S11: delayed reuse (query stage-1 facts)
  let ok:i32=1; i=0;
  while(i<12){if(ev_query(W,100+i,1,-2,0)!=200+i){ok=0;} i=i+1;}
  if(r1==2 && ok==1){return 1;} return 0;
}
// ---- F-INT4: cross-capability integration ----
fn t_xcap()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // teach chain, query miss builds plan, promotes MAP
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=201){return 0;}
  // create a guide node (simulating a MAP that guides action)
  let m:i32=alloc_node(W);
  if(m<2){return 0;}
  ns(W,m,0,20); write_node(W,m,77,505,0,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1); ns(W,m,4,505);
  // give it positive bid via self-loop
  link_edge(W,m,6,m,0);
  let b0:i32=bid(W,m);
  if(b0<=0){return 0;}
  // contradict the guide: both query standing and action candidacy demote
  contradict_map(W,m);
  let st:i32=map_standing(W,m);
  let b:i32=bid(W,m);
  if(st<0 && b<b0){return 1;} return 0;
}
// ============ main ============
// ============ TNN-2 new tests: the three changes ============
// Change 1: runtime construction. 4-hop chain: beyond the removed
// templates' ceiling (3-hop via compose-by-cloning). The winning graph is
// assembled at runtime by the trial loop and executed by execute().
fn t_t2_chain4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  if(a==5){return 1;} return 0;
}
// Change 1: anti-theater. t_p4 pattern: two candidates tried and genuinely
// rejected before the 3-hop winner verifies. Trial stats packed in hdr+16.
fn t_t2_trial_reject()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,107); ev_teach(W,102,12,103);
  ev_teach(W,102,19,108); ev_teach(W,103,13,104); ev_teach(W,103,19,109);
  let a:i32=ev_query(W,101,40,104,0);
  let st:i32=hg(W,16); let tried:i32=st/1024; let rej:i32=st-tried*1024;
  if(a==104 && tried>=3 && rej>=2){return 1;} return 0;
}
// Change 2: miss-to-act. The miss path itself reifies UNCERTAINTY and
// constructs the POLICY_ROOT-linked guide (no scaffolding).
fn t_t2_inquire()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  let u:i32=-1; let g:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      if(ng(W,n,0)==30 && ng(W,n,20)==9002 && ng(W,n,24)==77){u=n;}
      if(ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g=n;}
    }
    n=n+1;
  }
  if(u<0 || g<0){return 0;}
  let pr:i32=pol_get(W); if(pr<2){return 0;}
  let e1:i32=0; let e2:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      if(eg(W,e,0)==g && eg(W,e,4)==1 && eg(W,e,8)==u){e1=1;}
      if(eg(W,e,0)==pr && eg(W,e,4)==10 && eg(W,e,8)==g){e2=1;}
    }
    e=e+1;
  }
  if(e1==1 && e2==1){return 1;} return 0;
}
// Change 2: the act path is live. ev_act over the miss-constructed guide
// returns 30 (inquiry act), not the hardcoded 0 fallback.
fn t_t2_actlive()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  ctx_push(W,9002);
  let c:i32=ev_act(W);
  if(c==30){return 1;} return 0;
}
// Change 3: generic revision. Promote a 2-hop chain answering 201, then
// contradict a licensing fact via the public observe path. The graph must
// be restructured (topology change, verified by re-execution), the promoted
// answer updated to 999, and map standing untouched (not a demotion).
fn t_t2_revise()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  if(ev_query(W,101,40,201,0)!=201){return 0;}
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==40){m=n;}
    n=n+1;
  }
  if(m<0){return 0;}
  let root:i32=ng(W,m,20);
  let st0:i32=map_standing(W,m);
  let sig0:[]u8=z_alloc(256); let c0:i32=t2_sig(W,root,sig0);
  if(ev_observe(W,102,12,999)!=0){return 0;}
  if(t2_exec(W,root,101)!=999){return 0;}
  let sig1:[]u8=z_alloc(256); let c1:i32=t2_sig(W,root,sig1);
  let diff:i32=0;
  if(c0!=c1){diff=1;}
  else {
    let i:i32=0;
    while(i<c0){
      if(get32(sig0,i*8)!=get32(sig1,i*8) || get32(sig0,i*8+4)!=get32(sig1,i*8+4)){diff=1;}
      i=i+1;
    }
  }
  if(diff==0){return 0;}
  if(map_standing(W,m)!=st0){return 0;}
  if(ev_query(W,101,40,-2,0)!=999){return 0;}
  return 1;
}
// ============ DISCOUNT PILOT (D1+D2+W3+R1, unfrozen variant only) ============
// Per-FACT discount in field 12 (free on tag-1 FACT nodes; the allocator
// zeroes it at creation, so D1 needs no init change). Threshold T=2 (D2).
// R1: the evidence scan skips FACTs with discount > 2.
// W3: on non-unanimous evidence with a strict majority, minority FACTs get
// discount += 1. On a tie (no strict majority) no discount is written.
// Every write path is reachable from init (no circular dependency).
// Minimal recoverable subset per DISCOUNT.md section 3.3.
// Frozen source untouched; this file replaces bootstrap_miss in the pilot.
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let ex_n:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=2){
      set32(ex_o,cnt*4,ng(W,n,28)); set32(ex_n,cnt*4,n); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return -2;}
  let v0:i32=get32(ex_o,0); let inv:i32=1; let i:i32=1;
  while(i<cnt){if(get32(ex_o,i*4)!=v0){inv=0;} i=i+1;}
  if(inv==1){
    let k:i32=k_get(W);
    if(cnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        ev_teach_in(W,s,r,v0); return v0;
      }
    }
  }
  // W3: non-unanimous with strict majority discounts the minority facts.
  if(inv==0){
    let bi:i32=0; let bc:i32=0; let j:i32=0;
    while(j<cnt){
      let cj:i32=0; let q:i32=0;
      while(q<cnt){if(get32(ex_o,q*4)==get32(ex_o,j*4)){cj=cj+1;} q=q+1;}
      if(cj>bc){bc=cj; bi=j;}
      j=j+1;
    }
    if(bc*2>cnt){
      let mv:i32=get32(ex_o,bi*4); j=0;
      while(j<cnt){
        if(get32(ex_o,j*4)!=mv){
          let mn:i32=get32(ex_n,j*4);
          ns(W,mn,12,ng(W,mn,12)+1);
        }
        j=j+1;
      }
    }
  }
  return -2;
}
// ===== PROVENANCE TREATMENT DRIVER =====
// Treatment vs control for source-aware bootstrap, three batteries.
// Both arms have source tags in field 16 (1=OBSERVED, 2=TAUGHT, 3=INFERRED,
// 4=PREDICTED, 5=REVISED). Control uses source-blind bootstrap_miss
// (D1+D2+W3+R1 discount pilot). Treatment uses source-aware bootstrap_miss
// (external-only unanimity and majority; SELF facts do not vote).
//
// Battery A: Bootstrap self-reference. Teach 42s, let the learner infer,
// then test if INFERRED facts alone sustain the bootstrap loop.
// Battery B: Genuine external contradiction. 42s vs 99s, both TAUGHT.
// Measures the withhold-vs-recover tradeoff.
// Battery C: Majority-wrong adversary replication (M1/M2/M4).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Window scan: report idx, s, o, discount, source tag.
fn scan_pv(W:[]u8,p:[]u8,r:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=2){
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit(" d"); e64(ng(W,n,12));
      emit(" src"); e64(ng(W,n,16)); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

// Count INFERRED (src=3) facts for relation r.
fn count_inferred(W:[]u8,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,16)==3){c=c+1;}
    n=n+1;
  }
  return c;
}

// Count EXTERNAL (src=1,2,5) facts for relation r with value o.
fn count_external_val(W:[]u8,r:i32,o:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,28)==o){
      let s:i32=ng(W,n,16);
      if(s==1 || s==2 || s==5){c=c+1;}
    }
    n=n+1;
  }
  return c;
}

fn pt_main()i32 {
  let i:i32=0;

  // ============ BATTERY A: BOOTSTRAP SELF-REFERENCE ============
  // Teach 3x 42 (TAUGHT). Query 6x to build INFERRED 42s.
  // Then 4 more queries with NO new teaches.
  // Q: does the bootstrap loop sustain itself on INFERRED facts alone?
  let WA:[]u8=z_alloc(110656); tnn2_init(WA);
  emit("P BATTERY-A-SELF-REFERENCE\n");
  ev_teach(WA,1001,50,42); ev_teach(WA,1002,50,42); ev_teach(WA,1003,50,42);
  i=0;
  while(i<6){
    let q:i32=ev_query(WA,2001+i,50,-2,0);
    emit("P a_build"); e64(i); emit("="); e64(q);
    emit(" inferred="); e64(count_inferred(WA,50)); emit("\n");
    i=i+1;
  }
  // Now 4 queries with no new external input. Self-sustaining?
  let a_sustain:i32=0;
  i=0;
  while(i<4){
    let q2:i32=ev_query(WA,2011+i,50,-2,0);
    if(q2==42){a_sustain=a_sustain+1;}
    emit("P a_test"); e64(i); emit("="); e64(q2);
    emit(" inferred="); e64(count_inferred(WA,50));
    emit(" ext42="); e64(count_external_val(WA,50,42)); emit("\n");
    i=i+1;
  }
  emit("P A_sustain_42_of4="); e64(a_sustain); emit("\n");
  emit("P A_final_inferred="); e64(count_inferred(WA,50)); emit("\n");
  emit("P BATTERY-A-DONE\n");

  // ============ BATTERY B: GENUINE EXTERNAL CONTRADICTION ============
  // Teach 3x 42 (TAUGHT). Query 2x (some INFERRED 42s).
  // Teach 3x 99 (TAUGHT, genuine contradiction). Query 4x.
  // Control: self-votes tip 5:3, discounts 99s, "recovers" 42.
  // Treatment: external 3:3 tie, withholds.
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  emit("P BATTERY-B-CONTRADICTION\n");
  ev_teach(WB,1001,50,42); ev_teach(WB,1002,50,42); ev_teach(WB,1003,50,42);
  i=0;
  while(i<2){
    let qb:i32=ev_query(WB,2001+i,50,-2,0);
    emit("P b_pre"); e64(i); emit("="); e64(qb); emit("\n");
    i=i+1;
  }
  let cxB:i32=ev_teach(WB,3001,50,99);
  let cyB:i32=ev_teach(WB,3002,50,99);
  let czB:i32=ev_teach(WB,3003,50,99);
  emit("P b_contra_src="); e64(ng(WB,cxB,16)); emit("\n");
  scan_pv(WB,"P",50,50);
  let b_ans42:i32=0; let b_withhold:i32=0;
  i=0;
  while(i<4){
    let q3:i32=ev_query(WB,2005+i,50,-2,0);
    if(q3==42){b_ans42=b_ans42+1;}
    if(q3==-2){b_withhold=b_withhold+1;}
    emit("P b_post"); e64(i); emit("="); e64(q3);
    emit(" disc99="); e64(ng(WB,cxB,12));
    emit(" inferred="); e64(count_inferred(WB,50)); emit("\n");
    i=i+1;
  }
  emit("P B_ans42_of4="); e64(b_ans42); emit("\n");
  emit("P B_withhold_of4="); e64(b_withhold); emit("\n");
  emit("P B_99_discount="); e64(ng(WB,cxB,12)); emit("\n");
  emit("P B_final_inferred="); e64(count_inferred(WB,50)); emit("\n");
  emit("P BATTERY-B-DONE\n");

  // ============ BATTERY C: MAJORITY-WRONG ADVERSARY ============
  // Replication of prior Battery 2.
  // Phase 1: 3 TAUGHT 42 seeds (misleading). 4 queries to build loop.
  // Phase 2: genuine 99 correction (TAUGHT).
  // Phase 3: 10 fresh queries. M1/M2/M4.
  let WC:[]u8=z_alloc(110656); tnn2_init(WC);
  emit("P BATTERY-C-MAJORITY-WRONG\n");
  ev_teach(WC,1001,50,42); ev_teach(WC,1002,50,42); ev_teach(WC,1003,50,42);
  i=0;
  while(i<4){
    let q4:i32=ev_query(WC,2001+i,50,-2,0);
    emit("P c_build"); e64(i); emit("="); e64(q4);
    emit(" inferred="); e64(count_inferred(WC,50)); emit("\n");
    i=i+1;
  }
  let cxC:i32=ev_teach(WC,3001,50,99);
  emit("P c_contra_idx="); e64(cxC);
  emit(" src="); e64(ng(WC,cxC,16)); emit("\n");
  scan_pv(WC,"P",50,70);
  i=0;
  while(i<4){
    let q5:i32=ev_query(WC,2005+i,50,-2,0);
    emit("P c_post"); e64(i); emit("="); e64(q5);
    emit(" contra_disc="); e64(ng(WC,cxC,12));
    emit(" inferred="); e64(count_inferred(WC,50)); emit("\n");
    i=i+1;
  }
  let wrong:i32=0; i=0;
  while(i<10){
    let q6:i32=ev_query(WC,2011+i,50,-2,0);
    if(q6==42){wrong=wrong+1;}
    emit("P c_m1_"); e64(i); emit("="); e64(q6); emit("\n");
    i=i+1;
  }
  emit("P C_M1_wrong42_of10="); e64(wrong); emit("\n");
  emit("P C_M2_contra_disc="); e64(ng(WC,cxC,12)); emit("\n");
  emit("P C_M4_inferred_total="); e64(count_inferred(WC,50)); emit("\n");
  emit("P BATTERY-C-DONE\n");

  emit("PROVENANCE-TREATMENT-DONE\n");
  return 0;
}
fn main()i32 { return pt_main(); }

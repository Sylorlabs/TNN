// driver_Ectl.zag -- control: FROZEN learner (no phase 2) +
// world_E. Proves the 3-chain is NECESSARY: the frozen
// 6-operator harness must fail QD2/QD3/QD4. Predicted per
// PREREG 6f/E-K7 as corrected by PREREG_AMENDMENT1.
// Arms: FULL (mask 63), NOREUSE (mask 0).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=0; rs[1]=34; rs[2]=35; rs[3]=34; rs[4]=35; rs[5]=34; rs[6]=35;
  fs[0]=7; fs[1]=8; fs[2]=9; fs[3]=10; fs[4]=11; fs[5]=12; fs[6]=13;
  m_teach(st,rs,7,fs,7,70,77,1,1);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z4 (id 3): 3(1,7,90,97,1,1,29,26,27,3,4,0)
// rels[29,26,27,26,27,26,27] facts[15,16,17,18,19,20,21]
fn d_check_z4(st:[]u8)i32 {
  let o:i32=368+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=97){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=26; er[2]=27; er[3]=26; er[4]=27; er[5]=26; er[6]=27;
  let ef:[]u8=z_alloc(8);
  ef[0]=15; ef[1]=16; ef[2]=17; ef[3]=18; ef[4]=19; ef[5]=20; ef[6]=21;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(216);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,90,97,59,1,1,63,"QD1",rF,36);
  d_runq(stF,ob,atp,140,148,63,1,1,63,"QD2",rF,72);
  d_runq(stF,ob,atp,160,167,65,1,1,63,"QD3",rF,108);
  d_runq(stF,ob,atp,170,174,66,1,1,63,"QD4",rF,144);
  d_runq(stF,ob,atp,90,97,59,1,1,63,"QD1-B",rF,180);
  let f_qa_via:i32=get32(rF,0);
  let f_d1_via:i32=get32(rF,36);
  let f_d1_val:i32=get32(rF,40);
  let f_d1_op:i32=get32(rF,44);
  let f_d1_tries:i32=get32(rF,48);
  let f_d1_dec:i32=get32(rF,52);
  let f_d2_val:i32=get32(rF,76);
  let f_d2_op:i32=get32(rF,80);
  let f_d2_tries:i32=get32(rF,84);
  let f_d2_dec:i32=get32(rF,88);
  let f_d3_val:i32=get32(rF,112);
  let f_d3_op:i32=get32(rF,116);
  let f_d3_tries:i32=get32(rF,120);
  let f_d3_dec:i32=get32(rF,124);
  let f_d4_val:i32=get32(rF,148);
  let f_d4_op:i32=get32(rF,152);
  let f_d4_tries:i32=get32(rF,156);
  let f_d4_dec:i32=get32(rF,160);
  let f_b1_via:i32=get32(rF,180);
  let f_b1_val:i32=get32(rF,184);
  let f_b1_en:i32=get32(rF,212);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e3216:i32=e_has(stF,3,2,16);
  let e3116:i32=e_has(stF,3,1,16);
  let e14_3:i32=e_has_to(stF,3,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z4:i32=d_check_z4(stF);
  ex_p(ob,atp,"ARM-FULL-END ");
  d_bar(ob,atp,"K7-qavia",f_qa_via);
  d_bar(ob,atp,"K7-d1via",f_d1_via);
  d_bar(ob,atp,"K7-d1val",f_d1_val);
  d_bar(ob,atp,"K7-d1op",f_d1_op);
  d_bar(ob,atp,"K7-d1tries",f_d1_tries);
  d_bar(ob,atp,"K7-d1dec",f_d1_dec);
  d_bar(ob,atp,"K7-z4",z4);
  d_bar(ob,atp,"K7-d2val",f_d2_val);
  d_bar(ob,atp,"K7-d2op",f_d2_op);
  d_bar(ob,atp,"K7-d2tries",f_d2_tries);
  d_bar(ob,atp,"K7-d2dec",f_d2_dec);
  d_bar(ob,atp,"K7-d3val",f_d3_val);
  d_bar(ob,atp,"K7-d3op",f_d3_op);
  d_bar(ob,atp,"K7-d3tries",f_d3_tries);
  d_bar(ob,atp,"K7-d3dec",f_d3_dec);
  d_bar(ob,atp,"K7-d4val",f_d4_val);
  d_bar(ob,atp,"K7-d4op",f_d4_op);
  d_bar(ob,atp,"K7-d4tries",f_d4_tries);
  d_bar(ob,atp,"K7-d4dec",f_d4_dec);
  d_bar(ob,atp,"K7-b1via",f_b1_via);
  d_bar(ob,atp,"K7-b1val",f_b1_val);
  d_bar(ob,atp,"K7-b1en",f_b1_en);
  d_bar(ob,atp,"K7-t16",t16F);
  d_bar(ob,atp,"K7-e3216",e3216);
  d_bar(ob,atp,"K7-e3116",e3116);
  d_bar(ob,atp,"K7-link143",e14_3);
  d_bar(ob,atp,"K7-mdlive",mdlive);
  d_bar(ob,atp,"K7-oth",othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(180);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,90,97,59,1,1,0,"QD1",rN,36);
  d_runq(stN,ob,atp,140,148,63,1,1,0,"QD2",rN,72);
  d_runq(stN,ob,atp,160,167,65,1,1,0,"QD3",rN,108);
  d_runq(stN,ob,atp,170,174,66,1,1,0,"QD4",rN,144);
  let n_d1_val:i32=get32(rN,40);
  let n_d2_val:i32=get32(rN,76);
  let n_d3_val:i32=get32(rN,112);
  let n_d4_val:i32=get32(rN,148);
  let t16N:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END ");
  d_bar(ob,atp,"K7-nd1val",n_d1_val);
  d_bar(ob,atp,"K7-nd2val",n_d2_val);
  d_bar(ob,atp,"K7-nd3val",n_d3_val);
  d_bar(ob,atp,"K7-nd4val",n_d4_val);
  d_bar(ob,atp,"K7-nt16",t16N);
  d_bar(ob,atp,"K7-noth",othN);
  ex_pnl(ob,atp);

  // ---------- in-Zag falsifiers (PREREG 6f/E-K7, as amended) ----------
  let ff:i32=0;
  if(f_qa_via!=1){ff=ff+1;}
  if(f_d1_via!=3){ff=ff+1;}
  if(f_d1_val!=59){ff=ff+1;}
  if(f_d1_op!=6){ff=ff+1;}
  if(f_d1_tries!=6){ff=ff+1;}
  if(f_d1_dec!=1){ff=ff+1;}
  if(z4!=1){ff=ff+1;}
  if(f_d2_val!=-2){ff=ff+1;}
  if(f_d2_op!=-1){ff=ff+1;}
  if(f_d2_tries!=6){ff=ff+1;}
  if(f_d2_dec!=0){ff=ff+1;}
  if(f_d3_val!=-2){ff=ff+1;}
  if(f_d3_op!=-1){ff=ff+1;}
  if(f_d3_tries!=6){ff=ff+1;}
  if(f_d3_dec!=0){ff=ff+1;}
  if(f_d4_val!=-2){ff=ff+1;}
  if(f_d4_op!=-1){ff=ff+1;}
  if(f_d4_tries!=6){ff=ff+1;}
  if(f_d4_dec!=0){ff=ff+1;}
  if(f_b1_via!=3){ff=ff+1;}
  if(f_b1_val!=59){ff=ff+1;}
  if(f_b1_en!=0){ff=ff+1;}
  if(t16F!=1){ff=ff+1;}
  if(e3216!=1){ff=ff+1;}
  if(e3116!=0){ff=ff+1;}
  if(e14_3!=1){ff=ff+1;}
  if(mdlive!=1){ff=ff+1;}
  if(othF!=0){ff=ff+1;}
  if(n_d1_val!=-2){ff=ff+1;}
  if(n_d2_val!=-2){ff=ff+1;}
  if(n_d3_val!=-2){ff=ff+1;}
  if(n_d4_val!=-2){ff=ff+1;}
  if(t16N!=0){ff=ff+1;}
  if(othN!=0){ff=ff+1;}
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"CTL-E-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

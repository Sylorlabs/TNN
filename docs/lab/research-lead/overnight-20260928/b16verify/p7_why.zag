// tl_prelude.zag -- shared harness for b16verify probes.
// z_alloc / get32 / set32 are copied VERBATIM from brief sections 3.1 / 3.2.
// Output discipline: ONE preallocated buffer, cursor-returning helpers, one
// _zag_print(b[0..c]) flush. o_flush NEVER uses _zag_raw_syscall (inert, B15).
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }// p7_why_body.zag -- P7 / C507: characterise the "garbage" values that appear
// in p1_lifetime_ab/lt1_run1.txt (COV lines), to decide whether they are
// compiler miscomputation or genuine arena contents.
// The COV vfy lists contain large negatives interleaved with small ints:
//   -854881077,41421,-854815541,41165,30921,15406
// C501/C503 prove get32 is exact, so any such value MUST be genuine arena
// content. Here we test the hypothesis that they arise from a lane stride /
// offset-convention error: if consecutive large negatives differ by exactly
// 2^16 the lane is reading 16-bit-spaced fields out of a 32-bit-strided
// array (a lane bug signature), not miscompiled indexing.
fn main()i32 {
  let O:[]u8=z_alloc(4096);
  let c:i32=0;
  let a1:i32=0-854881077;
  let a2:i32=0-854815541;
  let b1:i32=0-1087211330;
  let b2:i32=0-1087145794;
  let d1:i32=a2-a1;
  let d2:i32=b2-b1;
  c=o_app(O,c,"d(a2-a1)="); c=o_i64(O,c,d1 as i64);
  c=o_app(O,c," is2pow16=");
  if(d1==65536){ c=o_app(O,c,"YES"); } else { c=o_app(O,c,"NO"); }
  c=o_nl(O,c);
  c=o_app(O,c,"d(b2-b1)="); c=o_i64(O,c,d2 as i64);
  c=o_app(O,c," is2pow16=");
  if(d2==65536){ c=o_app(O,c,"YES"); } else { c=o_app(O,c,"NO"); }
  c=o_nl(O,c);
  c=o_app(O,c,"a1_low16="); c=o_i64(O,c,(a1&65535) as i64); c=o_nl(O,c);
  c=o_app(O,c,"a2_low16="); c=o_i64(O,c,(a2&65535) as i64); c=o_nl(O,c);
  c=o_app(O,c,"low16_of_negatives_match_=");
  if((a1&65535)==(a2&65535)){ c=o_app(O,c,"YES_STRIDE_2_16"); } else { c=o_app(O,c,"NO"); }
  c=o_nl(O,c);
  o_flush(O,c);
  return 0;
}
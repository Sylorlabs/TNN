// p3_sweep_body.zag -- P3 / C503: systematic sweep of indexed reads.
// Grid: 4 arena sizes x 8 base offsets x 8 strides x 8 indices.
// Each cell compares THREE independently computed values:
//   G = get32(b, off + i*st)                    compiler form under test
//   R1 = four scalar byte reads, distinct expression shape (arena-derived)
//   R2 = closed-form arithmetic prediction from the fill function,
//        ZERO memory reads (memory-free oracle)
// B16 requires G to disagree with R1 or R2 somewhere.
fn pat(k:i32)i32 {
  let v:i32=((k*73)+41)&255;
  return v;
}
fn pred(o:i32)i32 {
  return (pat(o) as i32)|((pat(o+1) as i32)<<8)|((pat(o+2) as i32)<<16)|((pat(o+3) as i32)<<24);
}
fn main()i32 {
  let O:[]u8=z_alloc(262144);
  let c:i32=0;
  let sizes_n:i32=4;
  let sz0:i32=64;
  let sz1:i32=512;
  let sz2:i32=4096;
  let sz3:i32=110656;

  let cmp:i32=0;
  let mism:i32=0;
  let skip:i32=0;
  let firstbad:i32=-1;

  let si:i32=0;
  while(si<sizes_n){
    let n:i32=sz0;
    if(si==1){ n=sz1; }
    if(si==2){ n=sz2; }
    if(si==3){ n=sz3; }
    let b:[]u8=z_alloc(n);
    // fill with the closed-form pattern
    let k:i32=0;
    while(k<n){ b[k]=pat(k) as u8; k=k+1; }
    // content checksum: detects truncation / bad store
    let sum:i32=0;
    k=0;
    while(k<n){ sum=sum+(b[k] as i32); k=k+1; }

    let oi:i32=0;
    while(oi<8){
      let off:i32=0;
      if(oi==0){ off=0; }
      if(oi==1){ off=1; }
      if(oi==2){ off=2; }
      if(oi==3){ off=3; }
      if(oi==4){ off=4; }
      if(oi==5){ off=7; }
      if(oi==6){ off=8; }
      if(oi==7){ off=60; }

      let ti:i32=0;
      while(ti<8){
        let st:i32=1;
        if(ti==0){ st=1; }
        if(ti==1){ st=2; }
        if(ti==2){ st=3; }
        if(ti==3){ st=4; }
        if(ti==4){ st=5; }
        if(ti==5){ st=8; }
        if(ti==6){ st=12; }
        if(ti==7){ st=40; }

        let i:i32=0;
        while(i<8){
          let o:i32=off+i*st;
          if(o+3<n){
            let g:i32=get32(b,o);
            let r1:i32=(b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
            let r2:i32=pred(o);
            cmp=cmp+1;
            if(g!=r1 || g!=r2){
              mism=mism+1;
              if(firstbad<0){ firstbad=cmp; }
            }
          }else{
            skip=skip+1;
          }
          i=i+1;
        }
        ti=ti+1;
      }
      oi=oi+1;
    }

    // independent closed-form checksum of the whole arena
    let esum:i32=0;
    k=0;
    while(k<n){ esum=esum+pat(k); k=k+1; }
    c=o_app(O,c,"SIZE "); c=o_i64(O,c,n as i64);
    c=o_app(O,c," arena_sum "); c=o_i64(O,c,sum as i64);
    c=o_app(O,c," expected_sum "); c=o_i64(O,c,esum as i64);
    if(sum==esum){ c=o_app(O,c," CONTENT_OK"); }
    if(sum!=esum){ c=o_app(O,c," CONTENT_BAD"); }
    c=o_nl(O,c);
    si=si+1;
  }

  c=o_app(O,c,"COMPARISONS "); c=o_i64(O,c,cmp as i64); c=o_nl(O,c);
  c=o_app(O,c,"MISMATCHES "); c=o_i64(O,c,mism as i64); c=o_nl(O,c);
  c=o_app(O,c,"SKIPPED_OOB "); c=o_i64(O,c,skip as i64); c=o_nl(O,c);
  c=o_app(O,c,"FIRST_BAD_CELL_INDEX "); c=o_i64(O,c,firstbad as i64); c=o_nl(O,c);
  c=o_app(O,c,"DISAGREE_RATE_PPM ");
  let ppm:i32=0;
  if(cmp>0){ ppm=(mism*1000000)/cmp; }
  c=o_i64(O,c,ppm as i64);
  c=o_nl(O,c);
  c=o_app(O,c,"VERDICT_B16_P3 ");
  if(mism==0){ c=o_app(O,c,"NO_MISCOMPILATION"); }
  if(mism>0){ c=o_app(O,c,"MISCOMPILED"); }
  c=o_nl(O,c);
  o_flush(O,c);
  return 0;
}
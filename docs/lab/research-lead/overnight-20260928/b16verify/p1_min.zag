// tl_prelude.zag -- shared harness for b16verify probes.
// z_alloc / get32 / set32 are copied VERBATIM from brief sections 3.1 / 3.2.
// Output discipline: ONE preallocated buffer, cursor-returning helpers, one
// _zag_print(b[0..c]) flush. o_flush NEVER uses _zag_raw_syscall (inert, B15).
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }// p1_min.zag -- P1 / C501: minimal self-contained test of B16.
// Concatenation: tl_prelude.zag + this file. NO other lane's base file.
// Question: is `get32(C,4+j)` miscomputed, or is the oracle wrong?
fn main()i32 {
  let C:[]u8=z_alloc(512);
  set32(C,0,2);
  set32(C,4,11);
  set32(C,8,105);
  set32(C,12,50);
  set32(C,16,11);
  set32(C,20,106);
  set32(C,24,60);

  let O:[]u8=z_alloc(65536);
  let c:i32=0;

  c=o_app(O,c,"CELLS  get32(C,4+j*4) = ");
  let j:i32=0;
  while(j<6){ c=o_sp(O,c); c=o_i64(O,c,get32(C,4+j*4) as i64); j=j+1; }
  c=o_nl(O,c);

  // A: the reporter's form. Byte-offset sweep at offsets 4,5,6,7,8,9.
  c=o_app(O,c,"BYTES  get32(C,4+j)   = ");
  j=0;
  while(j<6){ c=o_sp(O,c); c=o_i64(O,c,get32(C,4+j) as i64); j=j+1; }
  c=o_nl(O,c);

  // R: index-free reference. Same 4 scalar reads, but each address is
  // written as a literal plus a NON-multiplied induction term -- a
  // different expression shape from the compiler form under test.
  c=o_app(O,c,"REF    scalar-byte    = ");
  j=0;
  while(j<6){
    let r:i32=(C[4+j] as i32)|((C[5+j] as i32)<<8)|((C[6+j] as i32)<<16)|((C[7+j] as i32)<<24);
    c=o_sp(O,c); c=o_i64(O,c,r as i64); j=j+1;
  }
  c=o_nl(O,c);

  // H1: the preregistered arithmetic hypothesis. Predict BYTES[j] is the
  // correct gather of correct bytes at an UNALIGNED offset.
  let pe0:i32=11;
  let pe1:i32=105<<24;
  let pe2:i32=105<<16;
  let pe3:i32=105<<8;
  let pe4:i32=105;
  let pe5:i32=50<<24;
  let bad:i32=0;
  j=0;
  while(j<6){
    let want:i32=pe0;
    if(j==1){ want=pe1; }
    if(j==2){ want=pe2; }
    if(j==3){ want=pe3; }
    if(j==4){ want=pe4; }
    if(j==5){ want=pe5; }
    let got:i32=get32(C,4+j);
    if(got!=want){ bad=bad+1; }
    j=j+1;
  }
  c=o_app(O,c,"H1_UNALIGNED_EXPLANATION_MISMATCHES "); c=o_i64(O,c,bad as i64); c=o_nl(O,c);

  // A-vs-R agreement count: the direct miscompilation test.
  let abm:i32=0;
  j=0;
  while(j<6){
    let r:i32=(C[4+j] as i32)|((C[5+j] as i32)<<8)|((C[6+j] as i32)<<16)|((C[7+j] as i32)<<24);
    if(get32(C,4+j)!=r){ abm=abm+1; }
    j=j+1;
  }
  c=o_app(O,c,"A_vs_REF_MISMATCHES "); c=o_i64(O,c,abm as i64); c=o_nl(O,c);

  // The reporter's ORACLE was wrong: they expected cell values from a
  // byte-offset read. Count how many of the 6 reported "garbage" values
  // are in fact byte-exact shifted reads of a stored cell.
  c=o_app(O,c,"VERDICT_B16_P1 ");
  if(abm==0){ c=o_app(O,c,"NO_MISCOMPILATION"); }
  if(abm>0){ c=o_app(O,c,"MISCOMPILED"); }
  c=o_nl(O,c);
  c=o_app(O,c,"ORACLE_WAS_BYTE_VS_CELL ");
  if(bad==0){ c=o_app(O,c,"CONFIRMED"); }
  if(bad>0){ c=o_app(O,c,"REFUTED"); }
  c=o_nl(O,c);
  o_flush(O,c);
  return 0;
}
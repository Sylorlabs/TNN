// p2_withbase_body.zag -- P2 / C502. Concatenated AFTER the frozen
// unmodified cogops_rescueaware/c15_base.zag (174 lines, sha256 fc1f6e73...).
// This is the condition DEFECT.md says it used but did not actually build.
// c15_base supplies z_alloc/get32/set32/o_app/o_i64/o_nl. We add only
// o_sp and p_flush (c15's own o_flush is the inert _zag_raw_syscall, B15,
// so it is never called; c15_base is used unmodified, not patched).
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn p_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn main()i32 {
  let C:[]u8=z_alloc(512);
  set32(C,0,2);
  set32(C,4,11);
  set32(C,8,105);
  set32(C,12,50);
  set32(C,16,11);
  set32(C,20,106);
  set32(C,24,60);

  let O:[]u8=z_alloc(65536);
  let c:i32=0;

  c=o_app(O,c,"CELLS  get32(C,4+j*4) = ");
  let j:i32=0;
  while(j<6){ c=o_sp(O,c); c=o_i64(O,c,get32(C,4+j*4) as i64); j=j+1; }
  c=o_nl(O,c);

  c=o_app(O,c,"BYTES  get32(C,4+j)   = ");
  j=0;
  while(j<6){ c=o_sp(O,c); c=o_i64(O,c,get32(C,4+j) as i64); j=j+1; }
  c=o_nl(O,c);

  c=o_app(O,c,"REF    scalar-byte    = ");
  j=0;
  while(j<6){
    let r:i32=(C[4+j] as i32)|((C[5+j] as i32)<<8)|((C[6+j] as i32)<<16)|((C[7+j] as i32)<<24);
    c=o_sp(O,c); c=o_i64(O,c,r as i64); j=j+1;
  }
  c=o_nl(O,c);

  let abm:i32=0;
  j=0;
  while(j<6){
    let r:i32=(C[4+j] as i32)|((C[5+j] as i32)<<8)|((C[6+j] as i32)<<16)|((C[7+j] as i32)<<24);
    if(get32(C,4+j)!=r){ abm=abm+1; }
    j=j+1;
  }
  c=o_app(O,c,"A_vs_REF_MISMATCHES "); c=o_i64(O,c,abm as i64); c=o_nl(O,c);
  c=o_app(O,c,"VERDICT_B16_P2 ");
  if(abm==0){ c=o_app(O,c,"NO_MISCOMPILATION"); }
  if(abm>0){ c=o_app(O,c,"MISCOMPILED"); }
  c=o_nl(O,c);

  // Also exercise the frozen base's own arena writers, which is what the
  // reporter said actually broke: chain_add / fact_add write via set32 and
  // are read back here by get32 at explicit multipliers and at byte strides.
  let K:[]u8=chain_new();
  chain_clear(K);
  chain_add(K,3,7,9);
  chain_add(K,4,8,10);
  c=o_app(O,c,"CHAIN_jx4 "); j=0;
  while(j<2){ c=o_sp(O,c); c=o_i64(O,c,get32(K,0+j*4) as i64); j=j+1; }
  c=o_nl(O,c);
  let A:[]u8=world_new();
  fact_add(A,3,7,9);
  fact_add(A,4,8,10);
  c=o_app(O,c,"FACT_jx12 "); j=0;
  while(j<2){
    c=o_sp(O,c); c=o_i64(O,c,get32(A,4+j*12) as i64);
    c=o_sp(O,c); c=o_i64(O,c,get32(A,8+j*12) as i64);
    c=o_sp(O,c); c=o_i64(O,c,get32(A,12+j*12) as i64);
    j=j+1;
  }
  c=o_nl(O,c);
  p_flush(O,c);
  return 0;
}
// p4_gen.zag -- P4 / C504 generator for the B17 large-TU probe.
// Emits several translation units of increasing size. Codegen happens here,
// in Zag; shell is used only to concatenate the shared prelude onto each
// generated block file and to invoke zbuild.sh.
//
// Every generated block performs an indexed-read loop of identical shape.
// main() independently predicts the total with a MEMORY-FREE nested loop
// over the closed-form pattern, so the two must agree at every size.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn emit(nb:i32,path:[]u8)void {
  let S:[]u8=z_alloc(6000000);
  let c:i32=0;
  c=o_app(S,c,"fn pat(k:i32)i32 { return ((k*73)+41)&255; }\n");
  c=o_app(S,c,"fn pred(o:i32)i32 { return (pat(o) as i32)|((pat(o+1) as i32)<<8)|((pat(o+2) as i32)<<16)|((pat(o+3) as i32)<<24); }\n");
  let K:i32=0;
  while(K<nb){
    c=o_app(S,c,"fn bk");
    c=o_i64(S,c,K as i64);
    c=o_app(S,c,"(bo:i32,b:[]u8)i32 { let s:i32=0; let k:i32=0; while(k<8){ s=s+get32(b,bo+k*4); k=k+1; } return s; }\n");
    K=K+1;
  }
  c=o_app(S,c,"fn main()i32 {\n");
  c=o_app(S,c,"  let b:[]u8=z_alloc(110656);\n");
  c=o_app(S,c,"  let k:i32=0; while(k<110656){ b[k]=pat(k) as u8; k=k+1; }\n");
  c=o_app(S,c,"  let got:i32=0;\n");
  c=o_app(S,c,"  let K:i32=0;\n");
  K=0;
  while(K<nb){
    c=o_app(S,c,"  got=got+bk");
    c=o_i64(S,c,K as i64);
    c=o_app(S,c,"(");
    c=o_i64(S,c,K as i64);
    c=o_app(S,c,",b);\n");
    K=K+1;
  }
  c=o_app(S,c,"  let exp:i32=0;\n");
  c=o_app(S,c,"  while(K<");
  c=o_i64(S,c,nb as i64);
  c=o_app(S,c,"){ let j:i32=0; while(j<8){ exp=exp+pred(K+j*4); j=j+1; } K=K+1; }\n");
  c=o_app(S,c,"  let O:[]u8=z_alloc(4096); let c:i32=0;\n");
  c=o_app(S,c,"  c=o_app(O,c,\"BLOCKS \"); c=o_i64(O,c,");
  c=o_i64(S,c,nb as i64);
  c=o_app(S,c," as i64);\n");
  c=o_app(S,c,"  c=o_app(O,c,\" got \"); c=o_i64(O,c,got as i64);\n");
  c=o_app(S,c,"  c=o_app(O,c,\" exp \"); c=o_i64(O,c,exp as i64);\n");
  c=o_app(S,c,"  if(got==exp){ c=o_app(O,c,\" MATCH\"); } else { c=o_app(O,c,\" MISMATCH\"); }\n");
  c=o_app(S,c,"  c=o_nl(O,c); o_flush(O,c); return 0; }\n");
  _zag_write_file(path,S[0..c]);
  return;
}
fn main()i32 {
  emit(100,"gen100_blocks.zag");
  emit(400,"gen400_blocks.zag");
  emit(1000,"gen1000_blocks.zag");
  emit(2000,"gen2000_blocks.zag");
  emit(4000,"gen4000_blocks.zag");
  _zag_println("P4_GEN_OK");
  return 0;
}
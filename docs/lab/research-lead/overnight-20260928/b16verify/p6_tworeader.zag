// tl_prelude.zag -- shared harness for b16verify probes.
// z_alloc / get32 / set32 are copied VERBATIM from brief sections 3.1 / 3.2.
// Output discipline: ONE preallocated buffer, cursor-returning helpers, one
// _zag_print(b[0..c]) flush. o_flush NEVER uses _zag_raw_syscall (inert, B15).
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }// p6_tworeader_body.zag -- P6 / C506: the B16 sub-claim that
// "get32(L,0) returns different values in two different functions of the
// same binary". Two separate reader functions, distinct address
// expressions each, called back-to-back on an UNMUTATED arena.
//   cell 0 : rdA(L) vs rdB(L)  vs rdC(L)      -> three functions, same cell
//   cell i : rdD(L,i) vs rdC2(L,i)            -> two functions, same cell
// Any disagreement is a real defect.
fn rdA(L:[]u8)i32 { return get32(L,0); }
fn rdB(L:[]u8)i32 { return get32(L,0); }
fn rdC(L:[]u8)i32 { return (L[0] as i32)|((L[1] as i32)<<8)|((L[2] as i32)<<16)|((L[3] as i32)<<24); }
fn rdD(L:[]u8,i:i32)i32 { return get32(L,i*4); }
fn rdC2(L:[]u8,i:i32)i32 { let o:i32=i*4; return (L[o] as i32)|((L[o+1] as i32)<<8)|((L[o+2] as i32)<<16)|((L[o+3] as i32)<<24); }
fn main()i32 {
  let L:[]u8=z_alloc(4096);
  let i:i32=0;
  while(i<64){ set32(L,i*4,(i*2654435761)&2147483647); i=i+1; }

  let O:[]u8=z_alloc(65536);
  let c:i32=0;
  let dis:i32=0;
  let tot:i32=0;

  // cell 0, three distinct functions
  let z0:i32=rdA(L);
  let z1:i32=rdB(L);
  let z2:i32=rdC(L);
  tot=tot+2;
  if(z0!=z1){ dis=dis+1; }
  if(z0!=z2){ dis=dis+1; }
  c=o_app(O,c,"CELL0 rdA="); c=o_i64(O,c,z0 as i64);
  c=o_app(O,c," rdB="); c=o_i64(O,c,z1 as i64);
  c=o_app(O,c," rdC="); c=o_i64(O,c,z2 as i64); c=o_nl(O,c);

  i=0;
  while(i<16){
    let a:i32=rdD(L,i);
    let b:i32=rdC2(L,i);
    tot=tot+1;
    if(a!=b){ dis=dis+1; }
    if(i<3){
      c=o_app(O,c,"CELL "); c=o_i64(O,c,i as i64);
      c=o_app(O,c," rdD="); c=o_i64(O,c,a as i64);
      c=o_app(O,c," rdC2="); c=o_i64(O,c,b as i64);
      c=o_nl(O,c);
    }
    i=i+1;
  }

  // interleave the two "different functions" repeatedly, arena unmutated
  i=0;
  while(i<64){
    let x:i32=rdD(L,i);
    let y:i32=rdC2(L,i);
    if(x!=y){ dis=dis+1; }
    i=i+1;
  }
  c=o_app(O,c,"TWO_READER_DISAGREEMENTS "); c=o_i64(O,c,dis as i64); c=o_nl(O,c);
  c=o_app(O,c,"COMPARISONS "); c=o_i64(O,c,tot as i64); c=o_nl(O,c);
  c=o_app(O,c,"VERDICT_B16_P6 ");
  if(dis==0){ c=o_app(O,c,"READERS_AGREE"); }
  if(dis>0){ c=o_app(O,c,"READERS_DISAGREE"); }
  c=o_nl(O,c);
  o_flush(O,c);
  return 0;
}
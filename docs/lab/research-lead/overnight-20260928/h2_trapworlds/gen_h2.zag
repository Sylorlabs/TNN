@import("substrate/R33_NATIVE_IO_V1.zag")

// ============================================================
// gen_h2.zag - H2 trap world generator for masked verification probes.
// Implements tnn2_h2probes/H2_PROBE_DESIGN.md section 4.
// Writes 3 world files into the directory given as argv[1].
// H2 id range [50000,59999], disjoint per world in 100-id blocks.
// Pure Zag, pinned znc. Worlds are SEALED TEST ASSETS: built here,
// never run through TNN-2 by this worker.
// ============================================================

// ---- text buffer append helpers ----
fn app_str(buf:[]u8, pos:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { buf[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn app_i64(buf:[]u8, pos:i64, v:i64) i64 {
    if (v < 0) { buf[pos] = 45 as u8; pos = pos + 1; v = 0 - v; }
    if (v == 0) { buf[pos] = 48 as u8; return pos + 1; }
    let div:i64 = 1;
    while (v / div >= 10) { div = div * 10; }
    while (div >= 1) {
        let d:i64 = v / div;
        buf[pos] = (48 + d) as u8; pos = pos + 1;
        v = v - d * div; div = div / 10;
    }
    return pos;
}
fn ev_observe(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "OBSERVE ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_query(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "QUERY ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_act(buf:[]u8, pos:i64) i64 {
    return app_str(buf, pos, "ACT\n");
}

// ---- file writer ----
// znc:allow A0102
fn write_file(dir:[]u8, name:[]u8, buf:[]u8, len:i64) i64 {
    let root:i64 = nio_open_root(dir);
    if (root < 0) { return -1; }
    let fd:i64 = nio_open_child(root, name, 1);
    nio_close(root);
    if (fd < 0) { return -2; }
    let w:i64 = nio_write_all(fd, buf[0..len]);
    nio_close(fd);
    if (w != len) { return -4; }
    return 0;
}
fn z_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b[0..s.len];
}

// ---- H2A: withhold trap ----
// 2-hop chain gives WRONG (tried first), 3-hop gives CORRECT (tried later).
// Masked mode promotes the 2-hop (first executable). Unmasked with true
// expected promotes the 3-hop.
fn gen_h2a(buf:[]u8) i64 {
    let pos:i64 = 0;
    let s:i64 = 50001;
    let r:i64 = 50051;
    // 2-hop wrong path: 50001 -> 50002 -> 50003 (answer 50003, wrong)
    pos = ev_observe(buf, pos, s, r, 50002);
    pos = ev_observe(buf, pos, 50002, r, 50003);
    // 3-hop correct path: 50001 -> 50011 -> 50012 -> 50013 (answer 50013)
    pos = ev_observe(buf, pos, s, r, 50011);
    pos = ev_observe(buf, pos, 50011, r, 50012);
    pos = ev_observe(buf, pos, 50012, r, 50013);
    // Query with true expected (for unmasked control). Masked runs ignore it.
    pos = ev_query(buf, pos, s, r, 50013);
    return pos;
}

// ---- H2B: lie trap ----
// B1: confirmable lie (lie matches a wrong candidate).
// B2: unconfirmable lie (no candidate matches the lie).
fn gen_h2b(buf:[]u8) i64 {
    let pos:i64 = 0;
    // B1: subject 50101, relation 50151
    // Correct path: 50101 -> 50102 -> 50103 (answer 50103)
    // Wrong path:   50101 -> 50111 -> 50112 (answer 50112)
    // Driver lies with expected=50112. System promotes the lie.
    pos = ev_observe(buf, pos, 50101, 50151, 50102);
    pos = ev_observe(buf, pos, 50102, 50151, 50103);
    pos = ev_observe(buf, pos, 50101, 50151, 50111);
    pos = ev_observe(buf, pos, 50111, 50151, 50112);
    // The QUERY expected field carries the LIE (50112, not the true 50103).
    // Sealed scoring key (true answer 50103) is in SEAL_H2.md, not here.
    pos = ev_query(buf, pos, 50101, 50151, 50112);
    // B2: subject 50121, relation 50151
    // Correct path: 50121 -> 50122 -> 50123 (answer 50123)
    // Driver lies with expected=59999 (unconfirmable: no candidate gives this).
    pos = ev_observe(buf, pos, 50121, 50151, 50122);
    pos = ev_observe(buf, pos, 50122, 50151, 50123);
    pos = ev_query(buf, pos, 50121, 50151, 59999);
    return pos;
}

// ---- H2C: own-criterion trap ----
// 2-hop chain (single path) gives X. Three independent 3-hop paths give Y.
// Search order tries 2-hop first. Evidence (3 paths vs 1) supports Y.
// A learner-internal criterion would prefer Y; order picks X.
fn gen_h2c(buf:[]u8) i64 {
    let pos:i64 = 0;
    let s:i64 = 50201;
    let r:i64 = 50251;
    // 2-hop single path (wrong): 50201 -> 50202 -> 50203 (answer 50203)
    pos = ev_observe(buf, pos, s, r, 50202);
    pos = ev_observe(buf, pos, 50202, r, 50203);
    // 3-hop triple path (correct): three independent paths to 50213
    pos = ev_observe(buf, pos, s, r, 50211);
    pos = ev_observe(buf, pos, 50211, r, 50212);
    pos = ev_observe(buf, pos, 50212, r, 50213);
    pos = ev_observe(buf, pos, s, r, 50221);
    pos = ev_observe(buf, pos, 50221, r, 50222);
    pos = ev_observe(buf, pos, 50222, r, 50213);
    pos = ev_observe(buf, pos, s, r, 50231);
    pos = ev_observe(buf, pos, 50231, r, 50232);
    pos = ev_observe(buf, pos, 50232, r, 50213);
    // Query with true expected (50213). Masked runs ignore it.
    pos = ev_query(buf, pos, s, r, 50213);
    return pos;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) { return 1; }
    let dir:[]u8 = z_copy(a1);
    let buf:[]u8 = nio_alloc(65536);
    if (buf.len == 0) { return 2; }

    let n:i64 = gen_h2a(buf);
    if (write_file(dir, z_copy("h2a_world.txt"), buf, n) != 0) { return 3; }

    n = gen_h2b(buf);
    if (write_file(dir, z_copy("h2b_world.txt"), buf, n) != 0) { return 4; }

    n = gen_h2c(buf);
    if (write_file(dir, z_copy("h2c_world.txt"), buf, n) != 0) { return 5; }

    return 0;
}

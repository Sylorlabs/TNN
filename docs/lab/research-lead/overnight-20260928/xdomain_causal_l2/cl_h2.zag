// cl_h2.zag -- Cross-domain L2 on causal to intervention (H2).
//
// World, arms, and kill bars are frozen in PREREG.md (committed before any
// implementation). Mechanism logic follows the xdomain H2 lineage:
// ordered mode pairs, value passing between stages, capability evidence
// via has_behav. New: stage 1 is the threshold-gated causal walk; the
// generic TRUNCATE (depth cap) and SPECIALIZE (threshold) adaptations
// apply to the stage 1 walk; exhaustive Phase 2 try-and-validate.
// Under test: whether the LEARNER selects the correct operator and
// discovers the correct parameter per sealed goal, not behavior
// induction (the threshold is computed as the minimum training node
// value, never a source literal).
//
// Modes: 1=WALK, 2=INTERVENE. These are the inherited H2 mechanism
// vocabulary (capability slots), not new cognitive modes.
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 new modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_m1, 8 comp_m2, 12 comp_op, 16 out_cur,
//         20 arm_verdict, 24 succ_count, 28 comp_param, 32 learned_thresh
// facts: base 64, 40 entries x 16 bytes (used,subj,rel,obj)
// maps: base 704, 8 entries x 8 bytes (used,behav)
// candidates: base 768, 8 entries x 4 bytes
fn vc_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  put32(W,24,0); put32(W,28,-1); put32(W,32,-1);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==0){
      put32(W,64+i*16,1); put32(W,64+i*16+4,s);
      put32(W,64+i*16+8,r); put32(W,64+i*16+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn facts_train(W:[]u8)void {
  add_fact(W,11,91,12); add_fact(W,12,91,13);
  add_fact(W,21,91,22); add_fact(W,22,91,23);
  add_fact(W,13,92,101);
  add_fact(W,23,92,102); add_fact(W,23,92,103);
  return;
}
fn facts_t(W:[]u8)void {
  facts_train(W);
  add_fact(W,41,91,42); add_fact(W,42,91,43); add_fact(W,43,91,44);
  add_fact(W,43,92,105); add_fact(W,44,92,106);
  return;
}
fn facts_s(W:[]u8)void {
  facts_train(W);
  add_fact(W,5,91,6); add_fact(W,6,91,7);
  add_fact(W,7,92,112);
  return;
}
// first r=91 link out of cur, or -1.
fn find_link(W:[]u8,cur:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==cur && ig(W,64+i*16+8)==91){
      return ig(W,64+i*16+12);
    }
    i=i+1;
  }
  return -1;
}
// minimum node value on the raw r=91 chain from s (no threshold).
fn chain_nodes_min(W:[]u8,s:i32)i32 {
  let best:i32=s;
  let cur:i32=s;
  let g:i32=0;
  while(g<16){
    let nxt:i32=find_link(W,cur);
    if(nxt<0){ break; }
    if(nxt<best){ best=nxt; }
    cur=nxt;
    g=g+1;
  }
  return best;
}
// number of r=91 links on the chain from s.
fn chain_len(W:[]u8,s:i32)i32 {
  let n:i32=0;
  let cur:i32=s;
  let g:i32=0;
  while(g<16){
    let nxt:i32=find_link(W,cur);
    if(nxt<0){ break; }
    n=n+1;
    cur=nxt;
    g=g+1;
  }
  return n;
}
// distinct node values reachable from s over r=91, first-seen order,
// into the candidate buffer. Generic scan, no domain knowledge.
fn scan_nodevals(W:[]u8,s:i32)i32 {
  let n:i32=0;
  put32(W,768,s);
  n=1;
  let vi:i32=0;
  while(vi<n){
    let cur:i32=ig(W,768+vi*4);
    let f:i32=0;
    while(f<40){
      if(ig(W,64+f*16)==1 && ig(W,64+f*16+4)==cur && ig(W,64+f*16+8)==91){
        let nxt:i32=ig(W,64+f*16+12);
        let seen:i32=0;
        let k:i32=0;
        while(k<n){
          if(ig(W,768+k*4)==nxt){ seen=1; }
          k=k+1;
        }
        if(seen==0 && n<8){ put32(W,768+n*4,nxt); n=n+1; }
      }
      f=f+1;
    }
    vi=vi+1;
  }
  return n;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  put32(W,704+m*8,1); put32(W,704+m*8+4,behav);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,704+m*8,0); return; }
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0;
  while(m<8){
    if(ig(W,704+m*8)==1 && ig(W,704+m*8+4)==bh){ return 1; }
    m=m+1;
  }
  return 0;
}
// Stage executors. Stage 1 (WALK, mode 1) is the threshold-gated causal
// walk; the adaptation (op 0=none, 1=TRUNCATE depth cap, 2=SPECIALIZE
// threshold) applies here. Stage 2 (INTERVENE, mode 2) is the
// intervention lookup. Each mode requires its learned behavior as
// capability evidence.
fn vc_stage(W:[]u8,mode:i32,subj:i32,op:i32,param:i32)i32 {
  if(mode==1){
    if(has_behav(W,0)==0){ return -2; }
    let T:i32=ig(W,32);
    if(op==2){ T=param; }
    let cap:i32=-1;
    if(op==1){ cap=param; }
    let cur:i32=subj;
    let steps:i32=0;
    let g:i32=0;
    while(g<16){
      if(cap>=0 && steps>=cap){ break; }
      let nxt:i32=find_link(W,cur);
      if(nxt<0){ break; }
      if(nxt>T){ cur=nxt; steps=steps+1; }
      else { break; }
      g=g+1;
    }
    return cur;
  }
  if(mode==2){
    if(has_behav(W,1)==0){ return -2; }
    let i:i32=0;
    while(i<40){
      if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==subj && ig(W,64+i*16+8)==92){
        return ig(W,64+i*16+12);
      }
      i=i+1;
    }
    return -1;
  }
  return -2;
}
fn teach(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  let y:i32=map_new(W,1);
  let t1:i32=chain_nodes_min(W,11);
  let t2:i32=chain_nodes_min(W,21);
  let best:i32=t1;
  if(t2<best){ best=t2; }
  put32(W,32,best);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," Y id="); eN(W,OUT,y);
  eS(W,OUT," thresh="); eN(W,OUT,best); eS(W,OUT,"\n");
  return;
}
// Try one ordered pair under one adaptation. Records the composite on
// goal match. Exhaustive: never stops early; the arm verdict requires
// exactly the predicted single success.
fn vc_try_pair(W:[]u8,OUT:[]u8,m1:i32,m2:i32,s:i32,op:i32,param:i32,expected:i32)void {
  let v1:i32=vc_stage(W,m1,s,op,param);
  if(v1<0){ return; }
  eS(W,OUT,"VC-STAGE1 m="); eN(W,OUT,m1); eS(W,OUT," op="); eN(W,OUT,op);
  eS(W,OUT," param="); eN(W,OUT,param); eS(W,OUT," v1="); eN(W,OUT,v1); eS(W,OUT,"\n");
  let v2:i32=vc_stage(W,m2,v1,0,0);
  eS(W,OUT,"VC-STAGE2 m="); eN(W,OUT,m2); eS(W,OUT," v2="); eN(W,OUT,v2); eS(W,OUT,"\n");
  if(v2<0){ return; }
  if(v2==expected){
    put32(W,24,ig(W,24)+1);
    if(ig(W,24)==1){
      put32(W,4,m1); put32(W,8,m2); put32(W,12,op); put32(W,28,param);
      eS(W,OUT,"VC-COMPOSE ok m1="); eN(W,OUT,m1);
      eS(W,OUT," m2="); eN(W,OUT,m2);
      eS(W,OUT," op="); eN(W,OUT,op);
      eS(W,OUT," param="); eN(W,OUT,param); eS(W,OUT,"\n");
    }
  }
  return;
}
// Two-phase value composition. Phase 1 is exact L1 reuse (op=0).
// Phase 2 (l2_on=1) retries the stage 1 walk under each adaptation:
// SPECIALIZE over every candidate threshold from the generic
// reachability scan, then TRUNCATE over every candidate depth. Fixed
// operator order (SPECIALIZE before TRUNCATE); selection is proven by
// exhaustive try-and-reject.
fn vc_compose_l2(W:[]u8,OUT:[]u8,s:i32,expected:i32,l2_on:i32)void {
  eS(W,OUT,"PHASE1 L1:\n");
  let m1:i32=1;
  while(m1<=2){
    let m2:i32=1;
    while(m2<=2){
      vc_try_pair(W,OUT,m1,m2,s,0,0,expected);
      m2=m2+1;
    }
    m1=m1+1;
  }
  if(ig(W,24)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,24)!=0 || l2_on==0){ return; }
  eS(W,OUT,"PHASE2 L2:\n");
  let nc:i32=scan_nodevals(W,s);
  let nl:i32=chain_len(W,s);
  eS(W,OUT,"CANDS nvals="); eN(W,OUT,nc);
  eS(W,OUT," chainlen="); eN(W,OUT,nl);
  let ck:i32=0;
  while(ck<nc){
    eS(W,OUT," "); eN(W,OUT,ig(W,768+ck*4));
    ck=ck+1;
  }
  eS(W,OUT,"\n");
  let ci:i32=0;
  while(ci<nc){
    let t:i32=ig(W,768+ci*4);
    eS(W,OUT,"SPEC-TRY T="); eN(W,OUT,t); eS(W,OUT,"\n");
    let mj:i32=1;
    while(mj<=2){
      vc_try_pair(W,OUT,1,mj,s,2,t,expected);
      mj=mj+1;
    }
    ci=ci+1;
  }
  let k:i32=1;
  while(k<nl){
    eS(W,OUT,"TRUNC-TRY k="); eN(W,OUT,k); eS(W,OUT,"\n");
    let mk:i32=1;
    while(mk<=2){
      vc_try_pair(W,OUT,1,mk,s,1,k,expected);
      mk=mk+1;
    }
    k=k+1;
  }
  if(ig(W,24)==0){ eS(W,OUT,"L2-FAIL\n"); }
  return;
}
fn arm_pass(W:[]u8,OUT:[]u8,ok:i32)void {
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_expect_fail(W:[]u8,OUT:[]u8)void {
  if(ig(W,24)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
// World-T arms: Z-T = (41,93) -> 105 needs TRUNCATE k=2, m1=1, m2=2.
fn arm_treat_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-T ===\n");
  facts_t(W); teach(W,OUT);
  vc_compose_l2(W,OUT,41,105,1);
  let ok:i32=0;
  if(ig(W,24)==1 && ig(W,4)==1 && ig(W,8)==2 && ig(W,12)==1 && ig(W,28)==2){ ok=1; }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-T ===\n");
  facts_t(W); teach(W,OUT);
  vc_compose_l2(W,OUT,41,105,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-T ===\n");
  facts_t(W); teach(W,OUT);
  del_map(W,0);
  vc_compose_l2(W,OUT,41,105,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-T ===\n");
  facts_t(W); teach(W,OUT);
  del_map(W,1);
  vc_compose_l2(W,OUT,41,105,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-T ===\n");
  facts_t(W);
  vc_compose_l2(W,OUT,41,105,1);
  arm_expect_fail(W,OUT);
  return;
}
// World-S arms: Z-S = (5,93) -> 112 needs SPECIALIZE T=5, m1=1, m2=2.
fn arm_treat_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-S ===\n");
  facts_s(W); teach(W,OUT);
  vc_compose_l2(W,OUT,5,112,1);
  let ok:i32=0;
  if(ig(W,24)==1 && ig(W,4)==1 && ig(W,8)==2 && ig(W,12)==2 && ig(W,28)==5){ ok=1; }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-S ===\n");
  facts_s(W); teach(W,OUT);
  vc_compose_l2(W,OUT,5,112,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-S ===\n");
  facts_s(W); teach(W,OUT);
  del_map(W,0);
  vc_compose_l2(W,OUT,5,112,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-S ===\n");
  facts_s(W); teach(W,OUT);
  del_map(W,1);
  vc_compose_l2(W,OUT,5,112,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-S ===\n");
  facts_s(W);
  vc_compose_l2(W,OUT,5,112,1);
  arm_expect_fail(W,OUT);
  return;
}
fn run_arm(W:[]u8,OUT:[]u8,idx:i32,cur:i32)i32 {
  vc_init(W);
  put32(W,16,cur);
  if(idx==0){ arm_treat_t(W,OUT); }
  if(idx==1){ arm_l1_t(W,OUT); }
  if(idx==2){ arm_ablx_t(W,OUT); }
  if(idx==3){ arm_ably_t(W,OUT); }
  if(idx==4){ arm_fresh_t(W,OUT); }
  if(idx==5){ arm_treat_s(W,OUT); }
  if(idx==6){ arm_l1_s(W,OUT); }
  if(idx==7){ arm_ablx_s(W,OUT); }
  if(idx==8){ arm_ably_s(W,OUT); }
  if(idx==9){ arm_fresh_s(W,OUT); }
  return ig(W,20);
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"CL-H2-START\n");
  let tot:i32=0;
  let idx:i32=0;
  while(idx<10){
    let W:[]u8=z_alloc(4096);
    put32(W,16,cur);
    tot=tot+run_arm(W,OUT,idx,cur);
    cur=ig(W,16);
    idx=idx+1;
  }
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/10\n");
  cur=e1str(OUT,cur,"CL-H2-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

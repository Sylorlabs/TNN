// op_debug.zag -- Debug the primitives in isolation.
// Tests each primitive manually on the plen-6 problem.

fn op_debug_main()i32 {
  emit("DBG-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  op_train3(W); op_train4(W); op_train5(W);
  emit("maps="); e64(op_count_maps(W));
  emit(" bestplen="); e64(op_best_plen(W)); emit("\n");
  op_teach6(W,301);
  let op:[]u8=op_new();
  // Manual sequence: STAGE, EXEC, PROBE, APPEND, VERIFY, PROMOTE
  let rc:i32=0;
  rc=op_stage(W,op,301);
  emit("STAGE rc="); e64(rc); emit(" mask="); e64(op_mask(op));
  emit(" parent="); e64(get32(op,0)); emit(" plen="); e64(get32(op,4)); emit("\n");
  if(rc==0){
    rc=op_exec(W,op,301);
    emit("EXEC rc="); e64(rc); emit(" mask="); e64(op_mask(op));
    emit(" endpoint="); e64(get32(op,60)); emit("\n");
  }
  if(rc==0){
    rc=op_probe(W,op);
    emit("PROBE rc="); e64(rc); emit(" mask="); e64(op_mask(op));
    emit(" live="); e64(get32(op,80)); emit(" cont_fact="); e64(get32(op,64)); emit("\n");
  }
  if(rc==0){
    rc=op_append(W,op);
    emit("APPEND rc="); e64(rc); emit(" mask="); e64(op_mask(op));
    emit(" new_plen="); e64(get32(op,4)); emit("\n");
  }
  if(rc==0){
    rc=op_verify(W,op,301,306,0);
    emit("VERIFY rc="); e64(rc); emit(" mask="); e64(op_mask(op));
    emit(" ans="); e64(get32(op,72)); emit("\n");
  }
  if(rc==0){
    rc=op_promote(W,op,301,71);
    emit("PROMOTE rc="); e64(rc); emit(" mask="); e64(op_mask(op)); emit("\n");
  }
  emit("maps="); e64(op_count_maps(W));
  emit(" bestplen="); e64(op_best_plen(W)); emit("\n");
  emit("DBG-END\n");
  return 0;
}

// op_driver.zag -- Invention Operator-Authorship experiment driver.
// (unfrozen; concatenated after op_base.zag and op_patch.zag)
//
// Arms:
//   TREAT: train plen-3/4/5, then Q-learn the invention operator on
//          plen-6 (100 episodes), then greedy test on plen-6 and plen-7.
//   ABLATE: same setup but policy disabled (uniform random, no learning).
//   FRESH: no training, greedy test on plen-6 (Q all zeros, epsilon=0).

fn op_run_treat()void {
  emit("=== TREAT ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  op_train3(W); op_train4(W); op_train5(W);
  emit("maps="); e64(op_count_maps(W));
  emit(" bestplen="); e64(op_best_plen(W)); emit("\n");
  // Teach plen-6 facts for subject 301
  op_teach6(W,301);
  let Q:[]u8=q_new();
  let rng:[]u8=z_alloc(4); set32(rng,0,12345);
  emit("--- training operator (50 episodes) ---\n");
  op_train(W,301,71,306,Q,50,rng);
  emit("--- policy dump ---\n");
  op_dump_policy(Q);
  emit("--- greedy test on plen-6 (subject 301) ---\n");
  op_delete_plen6(W,301,71); // ensure unsolved
  let solved:i32=op_test(W,301,71,306,Q,rng);
  emit("T6 solved="); e64(solved); emit("\n");
  emit("maps="); e64(op_count_maps(W));
  emit(" bestplen="); e64(op_best_plen(W)); emit("\n");
  // Transfer: plen-7 with subject 501 (no additional training)
  emit("--- transfer test on plen-7 (subject 501) ---\n");
  op_teach7(W,501);
  let solved7:i32=op_test(W,501,71,507,Q,rng);
  emit("T7 solved="); e64(solved7); emit("\n");
  emit("maps="); e64(op_count_maps(W));
  emit(" bestplen="); e64(op_best_plen(W)); emit("\n");
  return;
}
fn op_run_ablate()void {
  emit("=== ABLATE (random policy, no learning) ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  op_train3(W); op_train4(W); op_train5(W);
  op_teach6(W,301);
  let Q:[]u8=q_new(); // all zeros
  let rng:[]u8=z_alloc(4); set32(rng,0,99999);
  // 50 episodes with epsilon=100 (uniform random), train=0 (no update)
  let ep:i32=0; let nsolved:i32=0;
  while(ep<50){
    op_delete_plen6(W,301,71);
    let s:i32=op_episode(W,301,71,306,Q,100,rng,0);
    nsolved=nsolved+s;
    ep=ep+1;
  }
  emit("ABLATE solved_count="); e64(nsolved); emit("/50\n");
  return;
}
fn op_run_fresh()void {
  emit("=== FRESH (no training, zero policy) ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  op_teach6(W,301);
  let Q:[]u8=q_new();
  let rng:[]u8=z_alloc(4); set32(rng,0,55555);
  let solved:i32=op_test(W,301,71,306,Q,rng);
  emit("FRESH solved="); e64(solved); emit("\n");
  return;
}
fn main()i32 {
  emit("OP-START\n");
  op_run_treat();
  op_run_ablate();
  op_run_fresh();
  emit("OP-END\n");
  return 0;
}

// lifeexp.zag -- Lifetime Experience Storage + Changing Abstractions (LIFEXP-1).
// Pure Zag. No Python anywhere.
//
// A synthetic lifetime of N=40000 experiences (t, f0..f3, a, o, r) is
// generated deterministically from a fixed seed. The engine stores the
// full lifetime in structure-of-arrays form, builds inverted indexes,
// answers exact-recall / pattern / temporal-range queries, then performs
// a re-abstraction pass (new abstraction M2 applied retrospectively to
// all past experience) while preserving the old abstraction M1. All
// query results are verified against brute-force ground truth. Timings
// and RSS go to stderr; stdout is fully deterministic.
//
// Modes: no args (or "run") = full test, stdout deterministic.
// "emit_sql <dir>" = regenerate the identical lifetime and write
// world.sql, index.sql, reabstract.sql, queries.sql for the SQLite
// baseline (query parameters drawn from the identical rng stream).

// ============ utils (verbatim copies of the hyppop.zag implementations) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn eerr(s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,2,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn e64(v:i64)void { emit(i64s(v)); return; }
fn e32(v:i32)void { emit(i64s(v as i64)); return; }
fn eln()void { emit("\n"); return; }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn get32(b:[]u8,i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8,i:i32,v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=65536;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=(ts[0] as i64)|((ts[1] as i64)<<8)|((ts[2] as i64)<<16)|((ts[3] as i64)<<24)|((ts[4] as i64)<<32)|((ts[5] as i64)<<40)|((ts[6] as i64)<<48)|((ts[7] as i64)<<56);
  let ns:i64=(ts[8] as i64)|((ts[9] as i64)<<8)|((ts[10] as i64)<<16)|((ts[11] as i64)<<24)|((ts[12] as i64)<<32)|((ts[13] as i64)<<40)|((ts[14] as i64)<<48)|((ts[15] as i64)<<56);
  z_free(ts);
  return sec*1000+ns/1000000;
}
fn peak_rss_kb()i64 {
  let d:[]u8=read_file("/proc/self/status");
  if(d.len==0){return 0;}
  let key:[]u8="VmHWM:";
  let p:i32=0;
  let found:i32=-1;
  while(p+6<d.len){
    let k:i32=0;
    while(k<6 && d[p+k]==key[k]){k=k+1;}
    if(k==6){found=p;break;}
    p=p+1;
  }
  if(found<0){return 0;}
  let s:i32=found+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}
// xorshift32 PRNG, deterministic
fn rng_next(st:[]u8)i32 {
  let x:i32=get32(st,0);
  x=x^(x<<13);
  x=x^(x>>17);
  x=x^(x<<5);
  if(x<0){x=-(x+1);}
  set32(st,0,x);
  return x;
}
fn rng_range(st:[]u8,n:i32)i32 {
  if(n<1){return 0;}
  return rng_next(st)%n;
}

// ============ constants ============
fn N()i32 { return 40000; }
fn SEED()i32 { return 987654321; }
fn NFEAT()i32 { return 6; }   // f0..f3, a, o
fn NBIN()i32 { return 16; }   // bins per abstraction code
fn NQ1()i32 { return 1000; }
fn NQ2()i32 { return 200; }
fn NQ3A()i32 { return 64; }
fn NQ3B()i32 { return 64; }
fn NQ4()i32 { return 50; }

// feature value of experience e, feature f (0..3 = f0..f3, 4 = a, 5 = o)
fn fval(F:[]u8,A:[]u8,O:[]u8,e:i32,f:i32)i32 {
  if(f<4){return F[e*4+f] as i32;}
  if(f==4){return A[e] as i32;}
  return O[e] as i32;
}
fn fdom(f:i32)i32 {
  if(f==4){return 8;}
  return 16;
}
// M1 code from raw features (old abstraction); M2 likewise (new abstraction)
fn m1code(f0:i32,f1:i32)i32 { return (f0/4)*4+(f1/4); }
fn m2code(f2:i32,f3:i32)i32 { return (f2/4)*4+(f3/4); }

// ============ world generation (fixed draw order; shared by run and emit_sql) ============
fn gen_world(F:[]u8,A:[]u8,O:[]u8,R:[]u8,C1:[]u8,st:[]u8)i32 {
  let e:i32=0;
  while(e<N()){
    let f0:i32=rng_range(st,16);
    let f1:i32=rng_range(st,16);
    let f2:i32=rng_range(st,16);
    let f3:i32=rng_range(st,16);
    let a:i32=rng_range(st,8);
    let o:i32=(f0+2*f1+a)%16;
    let r:i32=1;
    if(o>=4){r=rng_range(st,3);}
    F[e*4]=f0 as u8; F[e*4+1]=f1 as u8; F[e*4+2]=f2 as u8; F[e*4+3]=f3 as u8;
    A[e]=a as u8; O[e]=o as u8; R[e]=r as u8;
    C1[e]=m1code(f0,f1) as u8;
    e=e+1;
  }
  return e;
}

// ============ inverted index (counting-sort postings; one arena of N i32 per feature) ============
// P: NFEAT*N*4 bytes postings; STARTS, COUNTS: NFEAT*NBIN*4 bytes each.
fn build_feat_index(F:[]u8,A:[]u8,O:[]u8,P:[]u8,STARTS:[]u8,COUNTS:[]u8)void {
  let f:i32=0;
  while(f<NFEAT()){
    let v:i32=0;
    while(v<NBIN()){set32(COUNTS,(f*NBIN()+v)*4,0);v=v+1;}
    let e:i32=0;
    while(e<N()){
      let vv:i32=fval(F,A,O,e,f);
      set32(COUNTS,(f*NBIN()+vv)*4,get32(COUNTS,(f*NBIN()+vv)*4)+1);
      e=e+1;
    }
    let acc:i32=0;
    v=0;
    while(v<NBIN()){
      set32(STARTS,(f*NBIN()+v)*4,acc);
      acc=acc+get32(COUNTS,(f*NBIN()+v)*4);
      v=v+1;
    }
    // cursor copy of starts for filling
    let cur:[]u8=z_alloc(NBIN()*4);
    v=0;
    while(v<NBIN()){set32(cur,v*4,get32(STARTS,(f*NBIN()+v)*4));v=v+1;}
    e=0;
    while(e<N()){
      let vv2:i32=fval(F,A,O,e,f);
      let pos:i32=get32(cur,vv2*4);
      set32(P,f*N()*4+pos*4,e);
      set32(cur,vv2*4,pos+1);
      e=e+1;
    }
    z_free(cur);
    f=f+1;
  }
  return;
}
// code lists for one abstraction code array C (NBIN bins, arena of N i32)
fn build_code_lists(C:[]u8,P:[]u8,STARTS:[]u8,COUNTS:[]u8)void {
  let v:i32=0;
  while(v<NBIN()){set32(COUNTS,v*4,0);v=v+1;}
  let e:i32=0;
  while(e<N()){
    let vv:i32=C[e] as i32;
    set32(COUNTS,vv*4,get32(COUNTS,vv*4)+1);
    e=e+1;
  }
  let acc:i32=0;
  v=0;
  while(v<NBIN()){
    set32(STARTS,v*4,acc);
    acc=acc+get32(COUNTS,v*4);
    v=v+1;
  }
  let cur:[]u8=z_alloc(NBIN()*4);
  v=0;
  while(v<NBIN()){set32(cur,v*4,get32(STARTS,v*4));v=v+1;}
  e=0;
  while(e<N()){
    let vv2:i32=C[e] as i32;
    let pos:i32=get32(cur,vv2*4);
    set32(P,pos*4,e);
    set32(cur,vv2*4,pos+1);
    e=e+1;
  }
  z_free(cur);
  return;
}

// ============ queries ============
// mix of one experience's fields for checksums
fn mixrec(F:[]u8,A:[]u8,O:[]u8,R:[]u8,e:i32)i64 {
  let m:i64=(F[e*4] as i64)+(F[e*4+1] as i64)*17+(F[e*4+2] as i64)*257+(F[e*4+3] as i64)*4096;
  m=m+(A[e] as i64)*65537+(O[e] as i64)*1048577+(R[e] as i64)*16777217;
  return m;
}
// Q1: exact recall of NQ1 random experiences; order-dependent checksum via
// the recall path, plus order-independent SUM for the SQL cross-check.
fn q1(F:[]u8,A:[]u8,O:[]u8,R:[]u8,st:[]u8)void {
  let acc:i64=0;
  let sum:i64=0;
  let ts:[]u8=z_alloc(NQ1()*4);
  let i:i32=0;
  while(i<NQ1()){
    let t:i32=rng_range(st,N());
    set32(ts,i*4,t);
    let m:i64=mixrec(F,A,O,R,t);
    acc=acc*31+m;
    sum=sum+m;
    i=i+1;
  }
  // independent ground-truth recomputation (no rng)
  let acc2:i64=0;
  let sum2:i64=0;
  i=0;
  while(i<NQ1()){
    let t2:i32=get32(ts,i*4);
    let m2:i64=mixrec(F,A,O,R,t2);
    acc2=acc2*31+m2;
    sum2=sum2+m2;
    i=i+1;
  }
  z_free(ts);
  emit("Q1SUM "); e64(sum); eln();
  if(acc==acc2 && sum==sum2){emit("Q1_MATCH 1\n");} else {emit("Q1_MATCH 0\n");}
  return;
}
// Q2: pattern queries via smallest-list scan + direct verify; brute-force cross-check.
fn q2_count(F:[]u8,A:[]u8,O:[]u8,P:[]u8,STARTS:[]u8,COUNTS:[]u8,pf:[]u8,pv:[]u8,k:i32)i32 {
  let bi:i32=0;
  let bn:i32=2147483647;
  let i:i32=0;
  while(i<k){
    let c:i32=get32(COUNTS,(get32(pf,i*4)*NBIN()+get32(pv,i*4))*4);
    if(c<bn){bn=c;bi=i;}
    i=i+1;
  }
  let bf:i32=get32(pf,bi*4);
  let bv:i32=get32(pv,bi*4);
  let base:i32=bf*N()*4+get32(STARTS,(bf*NBIN()+bv)*4)*4;
  let cnt:i32=0;
  let j:i32=0;
  while(j<bn){
    let id:i32=get32(P,base+j*4);
    let ok:i32=1;
    let q:i32=0;
    while(q<k){
      if(fval(F,A,O,id,get32(pf,q*4))!=get32(pv,q*4)){ok=0;break;}
      q=q+1;
    }
    if(ok==1){cnt=cnt+1;}
    j=j+1;
  }
  return cnt;
}
fn q2_brute(F:[]u8,A:[]u8,O:[]u8,pf:[]u8,pv:[]u8,k:i32)i32 {
  let cnt:i32=0;
  let e:i32=0;
  while(e<N()){
    let ok:i32=1;
    let q:i32=0;
    while(q<k){
      if(fval(F,A,O,e,get32(pf,q*4))!=get32(pv,q*4)){ok=0;break;}
      q=q+1;
    }
    if(ok==1){cnt=cnt+1;}
    e=e+1;
  }
  return cnt;
}
fn q2(F:[]u8,A:[]u8,O:[]u8,P:[]u8,STARTS:[]u8,COUNTS:[]u8,st:[]u8)void {
  let pf:[]u8=z_alloc(3*4);
  let pv:[]u8=z_alloc(3*4);
  let bad:i32=0;
  let idx_ms:i64=0;
  let bru_ms:i64=0;
  let i:i32=0;
  while(i<NQ2()){
    let k:i32=1+rng_range(st,3);
    let p:i32=0;
    while(p<k){
      let f:i32=rng_range(st,NFEAT());
      let dup:i32=1;
      while(dup==1){
        dup=0;
        let q:i32=0;
        while(q<p){if(get32(pf,q*4)==f){dup=1;}q=q+1;}
        if(dup==1){f=(f+1)%NFEAT();}
      }
      set32(pf,p*4,f);
      set32(pv,p*4,rng_range(st,fdom(f)));
      p=p+1;
    }
    let a0:i64=now_ms();
    let c1:i32=q2_count(F,A,O,P,STARTS,COUNTS,pf,pv,k);
    let a1:i64=now_ms();
    let c2b:i32=q2_brute(F,A,O,pf,pv,k);
    let a2:i64=now_ms();
    idx_ms=idx_ms+(a1-a0);
    bru_ms=bru_ms+(a2-a1);
    if(c1!=c2b){bad=bad+1;}
    emit("Q2_"); e32(i); emit(" "); e32(c1); eln();
    i=i+1;
  }
  z_free(pf);
  z_free(pv);
  emit("Q2_MISMATCH "); e32(bad); eln();
  eerr(" q2_idx_ms=");
  eerr(i64s(idx_ms));
  eerr(" q2_brute_ms=");
  eerr(i64s(bru_ms));
  return;
}
// Q3a: abstraction queries under M2; Q3b: code spot-checks; Q3c: co-occurrence rows.
fn q3a(F:[]u8,C2S:[]u8,C2C:[]u8,st:[]u8)void {
  let bad:i32=0;
  let i:i32=0;
  while(i<NQ3A()){
    let c:i32=rng_range(st,NBIN());
    let via:i32=get32(C2C,c*4);
    let bf:i32=0;
    let e:i32=0;
    while(e<N()){
      if(m2code(F[e*4+2] as i32,F[e*4+3] as i32)==c){bf=bf+1;}
      e=e+1;
    }
    if(via!=bf){bad=bad+1;}
    emit("Q3A_"); e32(i); emit(" "); e32(via); eln();
    i=i+1;
  }
  emit("Q3A_MISMATCH "); e32(bad); eln();
  return;
}
fn q3b(F:[]u8,C1:[]u8,C2:[]u8,st:[]u8)void {
  let bad:i32=0;
  let i:i32=0;
  while(i<NQ3B()){
    let e:i32=rng_range(st,N());
    let f0:i32=F[e*4] as i32;
    let f1:i32=F[e*4+1] as i32;
    let f2:i32=F[e*4+2] as i32;
    let f3:i32=F[e*4+3] as i32;
    if((C1[e] as i32)!=m1code(f0,f1)){bad=bad+1;}
    if((C2[e] as i32)!=m2code(f2,f3)){bad=bad+1;}
    i=i+1;
  }
  if(bad==0){emit("Q3B_MATCH 64\n");} else {emit("Q3B_MATCH 0\n");}
  return;
}
fn q3c(COOC:[]u8,C1C:[]u8)void {
  let ok:i32=1;
  let i:i32=0;
  while(i<NBIN()){
    let rs:i32=0;
    let j:i32=0;
    while(j<NBIN()){rs=rs+get32(COOC,(i*NBIN()+j)*4);j=j+1;}
    if(rs!=get32(C1C,i*4)){ok=0;}
    i=i+1;
  }
  emit("Q3C_OK "); e32(ok); eln();
  return;
}
// Q4: temporal range queries with reward filter.
fn q4_range(R:[]u8,t1:i32,t2:i32)i32 {
  let cnt:i32=0;
  let e:i32=t1;
  while(e<=t2){
    if((R[e] as i32)==3){cnt=cnt+1;}
    e=e+1;
  }
  return cnt;
}
fn q4(R:[]u8,st:[]u8)void {
  let bad:i32=0;
  let i:i32=0;
  while(i<NQ4()){
    let t1:i32=rng_range(st,N());
    let span:i32=rng_range(st,N()-t1);
    let t2:i32=t1+span;
    let c1:i32=q4_range(R,t1,t2);
    let c2b:i32=q4_range(R,t1,t2);
    if(c1!=c2b){bad=bad+1;}
    emit("Q4_"); e32(i); emit(" "); e32(c1); eln();
    i=i+1;
  }
  emit("Q4_MISMATCH "); e32(bad); eln();
  return;
}

// ============ re-abstraction pass (M2 applied retrospectively; M1 preserved) ============
fn c1_checksum(C1:[]u8)i64 {
  let s:i64=0;
  let e:i32=0;
  while(e<N()){s=s*31+(C1[e] as i64);e=e+1;}
  return s;
}
fn reabstract(F:[]u8,C1:[]u8,C2:[]u8,PC2:[]u8,S2:[]u8,C2C:[]u8,COOC:[]u8)void {
  let e:i32=0;
  while(e<N()){
    C2[e]=m2code(F[e*4+2] as i32,F[e*4+3] as i32) as u8;
    e=e+1;
  }
  build_code_lists(C2,PC2,S2,C2C);
  e=0;
  while(e<N()){
    let i:i32=(C1[e] as i32)*NBIN()+(C2[e] as i32);
    set32(COOC,i*4,get32(COOC,i*4)+1);
    e=e+1;
  }
  return;
}

// ============ full run ============
fn full_run()i32 {
  emit("LIFEXP-1\n");
  let st:[]u8=z_alloc(4);
  set32(st,0,SEED());
  let F:[]u8=z_alloc(N()*4);
  let A:[]u8=z_alloc(N());
  let O:[]u8=z_alloc(N());
  let R:[]u8=z_alloc(N());
  let C1:[]u8=z_alloc(N());
  let C2:[]u8=z_alloc(N());
  let t0:i64=now_ms();
  let stored:i32=gen_world(F,A,O,R,C1,st);
  let t1:i64=now_ms();
  emit("INGEST count=");
  e32(stored);
  eln();
  let P:[]u8=z_alloc(NFEAT()*N()*4);
  let FSTART:[]u8=z_alloc(NFEAT()*NBIN()*4);
  let FCOUNT:[]u8=z_alloc(NFEAT()*NBIN()*4);
  let PC1:[]u8=z_alloc(N()*4);
  let S1:[]u8=z_alloc(NBIN()*4);
  let C1C:[]u8=z_alloc(NBIN()*4);
  let t2:i64=now_ms();
  build_feat_index(F,A,O,P,FSTART,FCOUNT);
  build_code_lists(C1,PC1,S1,C1C);
  let t3:i64=now_ms();
  emit("INDEX_DONE\n");
  let tq0:i64=now_ms();
  q1(F,A,O,R,st);
  let tq1:i64=now_ms();
  q2(F,A,O,P,FSTART,FCOUNT,st);
  let tq2:i64=now_ms();
  let c1s0:i64=c1_checksum(C1);
  let PC2:[]u8=z_alloc(N()*4);
  let S2:[]u8=z_alloc(NBIN()*4);
  let C2C:[]u8=z_alloc(NBIN()*4);
  let COOC:[]u8=z_alloc(NBIN()*NBIN()*4);
  let tr0:i64=now_ms();
  reabstract(F,C1,C2,PC2,S2,C2C,COOC);
  let tr1:i64=now_ms();
  emit("REABSTRACT_DONE\n");
  let c1s1:i64=c1_checksum(C1);
  if(c1s0==c1s1){emit("C1_INTACT 1\n");} else {emit("C1_INTACT 0\n");}
  let tq3a:i64=now_ms();
  q3a(F,S2,C2C,st);
  q3b(F,C1,C2,st);
  q3c(COOC,C1C);
  let tq3:i64=now_ms();
  q4(R,st);
  let tq4:i64=now_ms();
  let sb:i64=(N()*4+N()*5) as i64;
  sb=sb+(NFEAT()*N()*4) as i64+(NFEAT()*NBIN()*4*2) as i64;
  sb=sb+(N()*4*2) as i64+(NBIN()*4*4) as i64+(NBIN()*NBIN()*4) as i64;
  emit("STATE_BYTES ");
  e64(sb);
  eln();
  emit("DONE\n");
  let rss:i64=peak_rss_kb();
  eerr("ingest_ms=");
  eerr(i64s(t1-t0));
  eerr(" index_ms=");
  eerr(i64s(t3-t2));
  eerr(" q1_ms=");
  eerr(i64s(tq1-tq0));
  eerr(" q2_ms=");
  eerr(i64s(tq2-tq1));
  eerr(" reabstract_ms=");
  eerr(i64s(tr1-tr0));
  eerr(" q3_ms=");
  eerr(i64s(tq3-tq3a));
  eerr(" q4_ms=");
  eerr(i64s(tq4-tq3));
  eerr(" peak_rss_kb=");
  eerr(i64s(rss));
  eerr("\n");
  return 0;
}

// ============ SQL baseline emit ============
fn pathjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b;
}
fn sql_emit_world(F:[]u8,A:[]u8,O:[]u8,R:[]u8,fd:i64)void {
  let buf:[]u8=z_alloc(8192);
  let at:i32=0;
  at=app(buf,at,"CREATE TABLE exp(t INTEGER PRIMARY KEY,f0 INTEGER,f1 INTEGER,f2 INTEGER,f3 INTEGER,a INTEGER,o INTEGER,r INTEGER);\n");
  w_write(fd,buf[0..at]);
  at=0;
  let e:i32=0;
  while(e<N()){
    at=app(buf,at,"INSERT INTO exp VALUES(");
    at=app(buf,at,i64s(e as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(F[e*4] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(F[e*4+1] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(F[e*4+2] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(F[e*4+3] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(A[e] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(O[e] as i64)); at=app(buf,at,",");
    at=app(buf,at,i64s(R[e] as i64)); at=app(buf,at,");\n");
    if(at>7000){w_write(fd,buf[0..at]);at=0;}
    e=e+1;
  }
  if(at>0){w_write(fd,buf[0..at]);}
  z_free(buf);
  return;
}
fn sql_emit_index(fd:i64)void {
  let buf:[]u8=z_alloc(4096);
  let at:i32=0;
  at=app(buf,at,"CREATE INDEX ix_f0 ON exp(f0);\n");
  at=app(buf,at,"CREATE INDEX ix_f1 ON exp(f1);\n");
  at=app(buf,at,"CREATE INDEX ix_f2 ON exp(f2);\n");
  at=app(buf,at,"CREATE INDEX ix_f3 ON exp(f3);\n");
  at=app(buf,at,"CREATE INDEX ix_a ON exp(a);\n");
  at=app(buf,at,"CREATE INDEX ix_o ON exp(o);\n");
  at=app(buf,at,"CREATE INDEX ix_r ON exp(r);\n");
  at=app(buf,at,"ALTER TABLE exp ADD COLUMN c1 INTEGER;\n");
  at=app(buf,at,"UPDATE exp SET c1 = CAST(f0/4 AS INTEGER)*4 + CAST(f1/4 AS INTEGER);\n");
  at=app(buf,at,"CREATE INDEX ix_c1 ON exp(c1);\n");
  w_write(fd,buf[0..at]);
  z_free(buf);
  return;
}
fn sql_emit_reabstract(fd:i64)void {
  let buf:[]u8=z_alloc(1024);
  let at:i32=0;
  at=app(buf,at,"ALTER TABLE exp ADD COLUMN c2 INTEGER;\n");
  at=app(buf,at,"UPDATE exp SET c2 = CAST(f2/4 AS INTEGER)*4 + CAST(f3/4 AS INTEGER);\n");
  at=app(buf,at,"CREATE INDEX ix_c2 ON exp(c2);\n");
  w_write(fd,buf[0..at]);
  z_free(buf);
  return;
}
fn sqlfname(f:i32)[]u8 {
  if(f==0){return "f0";}
  if(f==1){return "f1";}
  if(f==2){return "f2";}
  if(f==3){return "f3";}
  if(f==4){return "a";}
  return "o";
}
// query-parameter draws mirror q1/q2/q3a/q3b/q4 exactly (same rng order)
fn sql_emit_queries(st:[]u8,fd:i64)void {
  let buf:[]u8=z_alloc(8192);
  let at:i32=0;
  at=app(buf,at,"CREATE TEMP TABLE q1t(t INTEGER);\n");
  let i:i32=0;
  while(i<NQ1()){
    let t:i32=rng_range(st,N());
    at=app(buf,at,"INSERT INTO q1t VALUES(");
    at=app(buf,at,i64s(t as i64));
    at=app(buf,at,");\n");
    if(at>7000){w_write(fd,buf[0..at]);at=0;}
    i=i+1;
  }
  if(at>0){w_write(fd,buf[0..at]);}
  at=0;
  at=app(buf,at,"SELECT 'Q1SUM', SUM(f0 + f1*17 + f2*257 + f3*4096 + a*65537 + o*1048577 + r*16777217) FROM exp JOIN q1t USING(t);\n");
  w_write(fd,buf[0..at]);
  let pf:[]u8=z_alloc(3*4);
  let enc:[]u8=z_alloc(3*4);
  i=0;
  while(i<NQ2()){
    let k:i32=1+rng_range(st,3);
    let p:i32=0;
    while(p<k){
      let f:i32=rng_range(st,NFEAT());
      let dup:i32=1;
      while(dup==1){
        dup=0;
        let q:i32=0;
        while(q<p){if(get32(pf,q*4)==f){dup=1;}q=q+1;}
        if(dup==1){f=(f+1)%NFEAT();}
      }
      set32(pf,p*4,f);
      set32(enc,p*4,f*100+rng_range(st,fdom(f)));
      p=p+1;
    }
    at=0;
    at=app(buf,at,"SELECT 'Q2_");
    at=app(buf,at,i64s(i as i64));
    at=app(buf,at,"', COUNT(*) FROM exp WHERE ");
    p=0;
    while(p<k){
      let encv:i32=get32(enc,p*4);
      let ff:i32=encv/100;
      let vv:i32=encv%100;
      if(p>0){at=app(buf,at," AND ");}
      at=app(buf,at,sqlfname(ff));
      at=app(buf,at,"=");
      at=app(buf,at,i64s(vv as i64));
      p=p+1;
    }
    at=app(buf,at,";\n");
    w_write(fd,buf[0..at]);
    i=i+1;
  }
  z_free(pf);
  z_free(enc);
  at=0;
  i=0;
  while(i<NQ3A()){
    let c:i32=rng_range(st,NBIN());
    at=app(buf,at,"SELECT 'Q3A_");
    at=app(buf,at,i64s(i as i64));
    at=app(buf,at,"', COUNT(*) FROM exp WHERE c2=");
    at=app(buf,at,i64s(c as i64));
    at=app(buf,at,";\n");
    if(at>7000){w_write(fd,buf[0..at]);at=0;}
    i=i+1;
  }
  if(at>0){w_write(fd,buf[0..at]);}
  at=0;
  at=app(buf,at,"CREATE TEMP TABLE q3bt(t INTEGER);\n");
  i=0;
  while(i<NQ3B()){
    let e:i32=rng_range(st,N());
    at=app(buf,at,"INSERT INTO q3bt VALUES(");
    at=app(buf,at,i64s(e as i64));
    at=app(buf,at,");\n");
    if(at>7000){w_write(fd,buf[0..at]);at=0;}
    i=i+1;
  }
  if(at>0){w_write(fd,buf[0..at]);}
  at=0;
  at=app(buf,at,"SELECT 'Q3B_MATCH', COUNT(*) FROM exp JOIN q3bt USING(t) WHERE c1 = CAST(f0/4 AS INTEGER)*4 + CAST(f1/4 AS INTEGER) AND c2 = CAST(f2/4 AS INTEGER)*4 + CAST(f3/4 AS INTEGER);\n");
  w_write(fd,buf[0..at]);
  i=0;
  while(i<NQ4()){
    let t1:i32=rng_range(st,N());
    let span:i32=rng_range(st,N()-t1);
    let t2:i32=t1+span;
    at=0;
    at=app(buf,at,"SELECT 'Q4_");
    at=app(buf,at,i64s(i as i64));
    at=app(buf,at,"', COUNT(*) FROM exp WHERE t BETWEEN ");
    at=app(buf,at,i64s(t1 as i64));
    at=app(buf,at," AND ");
    at=app(buf,at,i64s(t2 as i64));
    at=app(buf,at," AND r=3;\n");
    w_write(fd,buf[0..at]);
    i=i+1;
  }
  z_free(buf);
  return;
}
fn do_emit_sql(dir:[]u8)i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,SEED());
  let F:[]u8=z_alloc(N()*4);
  let A:[]u8=z_alloc(N());
  let O:[]u8=z_alloc(N());
  let R:[]u8=z_alloc(N());
  let C1:[]u8=z_alloc(N());
  gen_world(F,A,O,R,C1,st);
  let p1:[]u8=pathjoin(dir,"world.sql");
  let fd:i64=w_open(p1);
  if(fd<0){emit("cannot open world.sql\n");return 1;}
  sql_emit_world(F,A,O,R,fd);
  w_close(fd);
  let p2:[]u8=pathjoin(dir,"index.sql");
  fd=w_open(p2);
  if(fd<0){emit("cannot open index.sql\n");return 1;}
  sql_emit_index(fd);
  w_close(fd);
  let p3:[]u8=pathjoin(dir,"reabstract.sql");
  fd=w_open(p3);
  if(fd<0){emit("cannot open reabstract.sql\n");return 1;}
  sql_emit_reabstract(fd);
  w_close(fd);
  let p4:[]u8=pathjoin(dir,"queries.sql");
  fd=w_open(p4);
  if(fd<0){emit("cannot open queries.sql\n");return 1;}
  sql_emit_queries(st,fd);
  w_close(fd);
  emit("wrote sql files to ");
  emit(dir);
  eln();
  z_free(st);
  z_free(F); z_free(A); z_free(O); z_free(R); z_free(C1);
  z_free(p1); z_free(p2); z_free(p3); z_free(p4);
  return 0;
}

fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(a1.len==0){return full_run();}
  if(streq(a1,"run")==1){return full_run();}
  if(streq(a1,"emit_sql")==1){return do_emit_sql(_zag_arg(2));}
  emit("usage: lifeexp [run|emit_sql <dir>]\n");
  return 1;
}

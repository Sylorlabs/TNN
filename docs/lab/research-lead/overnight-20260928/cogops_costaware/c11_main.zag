// c11_main.zag -- driver for the cogops-costaware battery.
// Cost-aware strategy selection: strat_sel picks by EFFICIENCY
// (wins per logged comparison) instead of win-rate. Stages per
// PREREG Section 3: S1A/S1B (world A learning), S2 (world D),
// S3 (goal 818: cold strategy table, default PW),
// S4 (world E), S5 (goal 820: PW leads, prior accelerates), S6L
// (world C), S6B (world F setup + re-specialize), S7 (goal 822,
// partial: PW->WHOLE->NEED, NEED wins), S8 (goal 823, fresh tag:
// PW leads on efficiency, fails, NEED rescues), S9 (goal 821,
// period-3: PW leads on efficiency, fails, NEED rescues at lag 3),
// S10 (goal 816, convergent: all fail, generic fallback, oracle
// agreement), S9B (goal 822 again: stored partial checker applies
// mask-aware), S11 (goal 823: strategy-table lesion, cold default
// cascade), S12 (goal 823: efficiency-tie lesion, hedge selects
// ALT), S13 (goal 824, world E, period-3: lesioned table, PW leads
// on efficiency and fails, WHOLE rescues via lag-direct order and
// wins: the first WHOLE win).
// All dynamic output goes through the single preallocated
// buffer B, flushed once at the end.
// Harness file: pattern and goal ids appear here (the c9_main
// precedent); c10_learn.zag carries zero literals.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-VFY rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,8480) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,8484) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- chain_of: build a chain buffer from a goal need, sub fills s==0 ----
fn chain_of(G:[]u8,ni:i32,sub:i32,tmpc:[]u8)void {
  let ns:i32=need_f(G,ni,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=need_f(G,ni,1+i*3);
    if(s==0){ s=sub; }
    set32(tmpc,4+i*12,s);
    set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
    i=i+1;
  }
  return;
}
// ---- walk_fix: iterate RETRIEVE [rel, obj] until output == input ----
fn walk_fix(A:[]u8,rel:i32,obj:i32,K:[]u8,tout:[]u8)i32 {
  let guard:i32=0;
  let walking:i32=1;
  while(walking==1){
    if(guard>=16){ walking=0; }
    if(walking==1){
      let nr:i32=ret_gen(A,rel,obj,K,4,tout,0);
      if(nr==0){ walking=0; }
      if(nr>0){
        let s:i32=get32(tout,4);
        if(s==obj){ walking=0; }
        if(s!=obj){ obj=s; }
      }
      guard=guard+1;
    }
  }
  return obj;
}
// ---- oracle_cyc816: independent all-generic reference, self-loop goal ----
fn oracle_cyc816(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let seed:[]u8=z_alloc(160);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=chain_new();
  let nc0:i32=ret_gen(A,need_f(G,0,0),need_f(G,0,1),K,4,seed,0);
  let fix:i32=walk_fix(A,need_f(G,1,0),need_f(G,1,1),K,tout);
  chain_of(G,2,fix,tmpc);
  let vv:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,fix);
  let npass:i32=0;
  if(vv==1){ npass=1; }
  ans_append(oans,npass);
  if(npass==1){ ans_append(oans,fix); }
  ans_append(oans,nc0);
  let k:i32=0;
  while(k<nc0){
    ans_append(oans,get32(seed,4+k*4));
    k=k+1;
  }
  return;
}
// ---- emit the learner-built cycle as the OSC-CYCLE line ----
fn emit_cycle(b:[]u8,c:i32,L:[]u8,gt:i32,lag:i32,q:i32,nn:i32,src:i32,e:i32)i32 {
  c=o_app(b,c,"OSC-CYCLE goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," lag=");
  c=o_i64(b,c,lag as i64);
  c=o_app(b,c," nph=");
  c=o_i64(b,c,lag as i64);
  let t:i32=0;
  while(t<lag){
    c=o_app(b,c," ph");
    c=o_i64(b,c,t as i64);
    b[c]=61; c=c+1;
    let j:i32=0;
    while(j<nn){
      let pb:i32=0;
      if(src==0){ pb=traj_base(q+t,j); }
      if(src==1){ pb=outc_phase_base(e,t,j); }
      b[c]=91; c=c+1;
      let n2:i32=get32(L,pb);
      c=o_i64(b,c,n2 as i64);
      let k:i32=0;
      while(k<n2){
        b[c]=44; c=c+1;
        c=o_i64(b,c,get32(L,pb+4+k*4) as i64);
        k=k+1;
      }
      b[c]=93; c=c+1;
      j=j+1;
    }
    t=t+1;
  }
  c=o_nl(b,c);
  return c;
}
// ---- dump one learner-written outcome-record entry (with mask) ----
fn dump_osc_state(b:[]u8,c:i32,L:[]u8,e:i32)i32 {
  let bo:i32=outc_base(e);
  c=o_app(b,c,"OSC-STATE goal=");
  c=o_i64(b,c,get32(L,bo) as i64);
  c=o_app(b,c," lag=");
  c=o_i64(b,c,get32(L,bo+4) as i64);
  c=o_app(b,c," nph=");
  c=o_i64(b,c,get32(L,bo+8) as i64);
  c=o_app(b,c," src=");
  c=o_i64(b,c,get32(L,bo+12) as i64);
  c=o_app(b,c," mask=");
  c=o_i64(b,c,get32(L,16656+e*4) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- dump the learner's detection-event ring as DET lines ----
// kind 0=CMP, 1=HYP (z=mask), 3=PRIOR, 4=SET, 5=APPLY, 6=RETRACT,
// 7=NCMP, 8=STRAT, 9=SWITCH.
fn dump_det_ev(b:[]u8,c:i32,L:[]u8,gt:i32)i32 {
  let ntev:i32=get32(L,15908);
  let t:i32=0;
  while(t<ntev){
    let ebo:i32=15912+t*20;
    let kind:i32=get32(L,ebo);
    let p:i32=get32(L,ebo+4);
    let x:i32=get32(L,ebo+8);
    let y:i32=get32(L,ebo+12);
    let z:i32=get32(L,ebo+16);
    if(kind==0){
      c=o_app(b,c,"DET-CMP p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," a=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," b=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," eq=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==1){
      c=o_app(b,c,"DET-HYP goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," q=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," mask=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==3){
      c=o_app(b,c,"DET-PRIOR prior=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==4){
      c=o_app(b,c,"DET-PRIOR set=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==5){
      c=o_app(b,c,"DET-APPLY goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," pass=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," match=");
      c=o_i64(b,c,x as i64);
      b[c]=47; c=c+1;
      c=o_i64(b,c,y as i64);
      c=o_nl(b,c);
    }
    if(kind==6){
      c=o_app(b,c,"DET-RETRACT goal=");
      c=o_i64(b,c,gt as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==7){
      c=o_app(b,c,"DET-NCMP p=");
      c=o_i64(b,c,p as i64);
      c=o_app(b,c," need=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," lag=");
      c=o_i64(b,c,y as i64);
      c=o_app(b,c," eq=");
      c=o_i64(b,c,z as i64);
      c=o_nl(b,c);
    }
    if(kind==8){
      c=o_app(b,c,"DET-STRAT chosen=");
      c=o_i64(b,c,x as i64);
      c=o_nl(b,c);
    }
    if(kind==9){
      c=o_app(b,c,"DET-SWITCH from=");
      c=o_i64(b,c,x as i64);
      c=o_app(b,c," to=");
      c=o_i64(b,c,y as i64);
      c=o_nl(b,c);
    }
    t=t+1;
  }
  return c;
}
// ---- outc_tombstone: the detection lesion. Marks one outcome
// entry unreachable to outc_find by setting its goal tag to -1.
// Harness operation, not learner machinery. The goal tag is read
// from the goal record (g_tag), never written as a literal.
// ---- strat_zero: zero the learner-state strategy table.
// Harness operation for the S11 lesion.
// ---- strat_corrupt_tie: lesioned table with PW and NEED tied at
// EFFICIENCY 0.5 (PW[2,2,4], NEED[1,1,2]; 2*2 == 1*4), testing the
// alternation hedge under the cost-aware rule. Harness operation
// for the S12 lesion.
// ---- strat_lesion_s13: lesioned table for the S13 WHOLE-win
// stage: PW[3,2,6] (efficiency 1/3) leads; NEED[2,0,8]
// (efficiency 0) is scoreless, so the efficiency-ordered rescue
// surfaces WHOLE (id tie-break among zeros) before NEED.
// Harness operation for the S13 lesion.
fn outc_tombstone(L:[]u8,gtag:i32)void {
  let e:i32=outc_find(L,gtag);
  if(e>=0){ set32(L,outc_base(e),-1); }
  return;
}
fn strat_zero(L:[]u8)void {
  let i:i32=0;
  while(i<12){
    set32(L,16600+i*4,0);
    i=i+1;
  }
  return;
}
fn strat_corrupt_tie(L:[]u8)void {
  strat_zero(L);
  set32(L,16600,2);
  set32(L,16604,2);
  set32(L,16608,4);
  set32(L,16624,1);
  set32(L,16628,1);
  set32(L,16632,2);
  return;
}
fn strat_lesion_s13(L:[]u8)void {
  strat_zero(L);
  set32(L,16600,3);
  set32(L,16604,2);
  set32(L,16608,6);
  set32(L,16624,2);
  set32(L,16628,0);
  set32(L,16632,8);
  return;
}
// ---- one query through the learner-owned detection driver ----
// h: -1 declined; 0 generic fallback (compose_iter); 1 invented;
// 2 reused from the outcome record. doagree=1 runs the
// independent oracle_cyc816 on the fallback path (S10 control).
// The driver is det_handle (strategy-choosing detection); the
// DET event ring is dumped after the Q line in every branch.
fn do_losc(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,R:[]u8,qn:[]u8,doagree:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let h:i32=det_handle(L,A,G,K,R);
  let gt:i32=g_tag(G);
  let nn:i32=g_nneeds(G);
  if(h<0){
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  if(h==0){
    let vbuf:[]u8=z_alloc(32);
    let ans:[]u8=z_alloc(256);
    set32(K,0,0);
    set32(K,4,0);
    compose_iter(L,A,G,K,ans,vbuf);
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," how=0 passes=");
    c=o_i64(b,c,get32(vbuf,20) as i64);
    c=o_nl(b,c);
    c=dump_det_ev(b,c,L,gt);
    if(doagree==1){
      let oans:[]u8=z_alloc(256);
      let seen:[]u8=z_alloc(320);
      set32(K,4,0);
      oracle_cyc816(A,G,K,oans,seen);
      let a:i32=ans_eq(ans,oans);
      if(a==1){ set32(L,13240,get32(L,13240)+1); }
      c=o_app(b,c,"AGREE id=");
      c=o_app(b,c,qn);
      c=o_app(b,c," a=");
      c=o_i64(b,c,a as i64);
      c=o_nl(b,c);
    }
    return c;
  }
  let lag:i32=get32(R,8);
  let q:i32=get32(R,12);
  let src:i32=get32(R,20);
  let ee:i32=get32(R,24);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," how=");
  c=o_i64(b,c,h as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(R,4) as i64);
  c=o_nl(b,c);
  c=dump_det_ev(b,c,L,gt);
  c=emit_cycle(b,c,L,gt,lag,q,nn,src,ee);
  if(h==1){
    c=o_app(b,c,"OSC-CONFIRM goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," ok=1");
    c=o_nl(b,c);
  }
  if(h==2){
    c=o_app(b,c,"OSC-REUSE goal=");
    c=o_i64(b,c,gt as i64);
    c=o_app(b,c," match=2");
    c=o_nl(b,c);
  }
  c=o_app(b,c,"SPECCHK goal=");
  c=o_i64(b,c,gt as i64);
  c=o_app(b,c," spec=");
  c=o_i64(b,c,get32(R,28) as i64);
  c=o_nl(b,c);
  c=dump_osc_state(b,c,L,ee);
  return c;
}
// ---- dump the strategy table as strat_pw=uses,wins,cost ... ----
fn dump_strat(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c," strat_pw=");
  c=o_i64(b,c,get32(L,16600) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16604) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16608) as i64);
  c=o_app(b,c," strat_who=");
  c=o_i64(b,c,get32(L,16612) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16616) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16620) as i64);
  c=o_app(b,c," strat_need=");
  c=o_i64(b,c,get32(L,16624) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16628) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16632) as i64);
  c=o_app(b,c," strat_alt=");
  c=o_i64(b,c,get32(L,16636) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16640) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,16644) as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(32768);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let R:[]u8=z_alloc(64);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let tag818:i32=0;
  let tag820:i32=0;
  let tag821:i32=0;
  // S1A RET-LEARN (world A)
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1A RET-LEARN"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  // S1B VFY-LEARN (world A)
  c=o_app(B,c,"STAGE S1B VFY-LEARN"); c=o_nl(B,c);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S2 OSC-LEARN-D (world D)
  c=o_app(B,c,"STAGE S2 OSC-LEARN-D"); c=o_nl(B,c);
  setup_worldD(A);
  c=run_retep(B,c,L,A,K,rb,tout,6,8);
  c=run_retep(B,c,L,A,K,rb,tout,7,9);
  c=run_retep(B,c,L,A,K,rb,tout,8,10);
  c=run_retep(B,c,L,A,K,rb,tout,2,11);
  specialize_ret(L,A,8,11);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,6,12);
  specialize_vfy(L,A,12,12);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S3 STRAT-D0 (goal 818, world D): cold table, default PW
  c=o_app(B,c,"STAGE S3 STRAT-D0"); c=o_nl(B,c);
  mk_goal818_D0(G);
  tag818=g_tag(G);
  c=do_losc(B,c,L,A,K,G,R,"S3",0);
  // S4 OSC-LEARN-E (world E)
  c=o_app(B,c,"STAGE S4 OSC-LEARN-E"); c=o_nl(B,c);
  setup_worldE(A);
  c=run_retep(B,c,L,A,K,rb,tout,9,13);
  c=run_retep(B,c,L,A,K,rb,tout,10,14);
  c=run_retep(B,c,L,A,K,rb,tout,11,15);
  c=run_retep(B,c,L,A,K,rb,tout,12,16);
  c=run_retep(B,c,L,A,K,rb,tout,13,17);
  c=run_retep(B,c,L,A,K,rb,tout,14,18);
  c=run_retep(B,c,L,A,K,rb,tout,15,19);
  c=run_retep(B,c,L,A,K,rb,tout,2,20);
  specialize_ret(L,A,13,20);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,7,21);
  c=run_vfyep(B,c,L,A,K,Cb,8,22);
  specialize_vfy(L,A,21,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S5 STRAT-E0 (goal 820, world E): PW leads, prior accelerates
  c=o_app(B,c,"STAGE S5 STRAT-E0"); c=o_nl(B,c);
  mk_goal820_E0(G);
  tag820=g_tag(G);
  c=do_losc(B,c,L,A,K,G,R,"S5",0);
  // S6L CYCLE-LEARN-C (world C)
  c=o_app(B,c,"STAGE S6L CYCLE-LEARN-C"); c=o_nl(B,c);
  setup_worldC(A);
  c=run_retep(B,c,L,A,K,rb,tout,4,23);
  c=run_retep(B,c,L,A,K,rb,tout,5,24);
  c=run_retep(B,c,L,A,K,rb,tout,2,25);
  specialize_ret(L,A,23,25);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,4,26);
  specialize_vfy(L,A,26,26);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S6B WORLD-F-SETUP (world F + re-specialize)
  c=o_app(B,c,"STAGE S6B WORLD-F-SETUP"); c=o_nl(B,c);
  setup_worldF(A);
  specialize_ret(L,A,13,20);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  specialize_vfy(L,A,21,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S7 STRAT-F0 (goal 822, world F, partial oscillation)
  c=o_app(B,c,"STAGE S7 STRAT-F0"); c=o_nl(B,c);
  mk_goal822_F0(G);
  c=do_losc(B,c,L,A,K,G,R,"S7",0);
  // S8 STRAT-F1 (goal 823, world F, fresh tag): NEED leads
  c=o_app(B,c,"STAGE S8 STRAT-F1"); c=o_nl(B,c);
  mk_goal823_F1(G);
  c=do_losc(B,c,L,A,K,G,R,"S8",0);
  // S9 STRAT-E1 (goal 821, world E, period-3)
  c=o_app(B,c,"STAGE S9 STRAT-E1"); c=o_nl(B,c);
  setup_worldE(A);
  specialize_ret(L,A,13,20);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  specialize_vfy(L,A,21,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  plan_drop(L,tag818);
  mk_goal821_E1(G);
  tag821=g_tag(G);
  c=do_losc(B,c,L,A,K,G,R,"S9",0);
  // S10 CONV-816 (goal 816, world C): all strategies fail
  c=o_app(B,c,"STAGE S10 CONV-816"); c=o_nl(B,c);
  setup_worldC(A);
  specialize_ret(L,A,23,25);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  specialize_vfy(L,A,26,26);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  plan_drop(L,tag820);
  mk_goal816_C0(G);
  c=do_losc(B,c,L,A,K,G,R,"S10",1);
  // S9B REUSE-822 (goal 822, world F again): masked APPLY
  c=o_app(B,c,"STAGE S9B REUSE-822"); c=o_nl(B,c);
  setup_worldF(A);
  specialize_ret(L,A,13,20);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  specialize_vfy(L,A,21,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  mk_goal822_F0(G);
  c=do_losc(B,c,L,A,K,G,R,"S9B",0);
  // S11 STRAT-LESION (goal 823, world F): zero the strategy table
  c=o_app(B,c,"STAGE S11 STRAT-LESION"); c=o_nl(B,c);
  mk_goal823_F1(G);
  outc_tombstone(L,g_tag(G));
  strat_zero(L);
  c=do_losc(B,c,L,A,K,G,R,"S11",0);
  // S12 STRAT-CORRUPT (goal 823, world F): lesioned PW/NEED tie
  c=o_app(B,c,"STAGE S12 STRAT-CORRUPT"); c=o_nl(B,c);
  mk_goal823_F1(G);
  outc_tombstone(L,g_tag(G));
  strat_corrupt_tie(L);
  c=do_losc(B,c,L,A,K,G,R,"S12",0);
  // S13 WHOLE-WIN (goal 824, world E, period-3): lesioned table,
  // PW leads on efficiency and fails, WHOLE rescues via lag-direct
  // order and wins (first WHOLE win in the battery).
  c=o_app(B,c,"STAGE S13 WHOLE-WIN"); c=o_nl(B,c);
  setup_worldE(A);
  specialize_ret(L,A,13,20);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  specialize_vfy(L,A,21,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  plan_drop(L,tag821);
  mk_goal824_E2(G);
  strat_lesion_s13(L);
  c=do_losc(B,c,L,A,K,G,R,"S13",0);
  // SUMMARY
  c=o_app(B,c,"SUMMARY-DET agree=");
  c=o_i64(B,c,get32(L,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," prior=");
  c=o_i64(B,c,get32(L,15900) as i64);
  c=dump_strat(B,c,L);
  o_flush(B,c);
  return 0;
}

// vinst.zag: shared valley instance definitions + frozen GENEXEC2 VM.
// Included (concatenated) by vgen.zag and all valley drivers.
// Pure Zag. No Python. Part of valley battery step (b) implementation.
// Authority: PREREG_VALLEY.md (cf0c85e78), VALLEY_DEPTH_DESIGN.md (76c7a887c).

// ---------- tiny emit helpers ----------
fn v_get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn v_set32(b:[]u8, i:i32, v:i32)void {
  b[i]=(v&255) as u8; b[i+1]=((v>>8)&255) as u8;
  b[i+2]=((v>>16)&255) as u8; b[i+3]=((v>>24)&255) as u8;
  return;
}
fn v_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn v_emit(s:[]u8)void { _zag_print(s); return; }
fn v_i64s(v:i64)[]u8 { let r:[]u8=_zag_i64_to_str(v); return r; }
fn v_e64(v:i32)void { v_emit(v_i64s(v as i64)); return; }
fn v_nl()void { v_emit("\n"); return; }

// ---------- frozen GENEXEC2 straight-line semantics ----------
// Op codes: 0=PUSH 1=IN0 2=IN1 3=ADD 4=SUB 5=MUL 6=DIV 7=MOD 8=NEG
// 9=DUP 10=DROP 11=SWAP 12=OVER 13=LT 14=EQ 15=GT 16=JZ 17=JNZ 18=JMP.
// DIV by zero yields 0 (truncated a/b). MOD by zero yields 0, else
// mod_nonneg. Underflowed stack ops are no-ops. Matches the frozen VM
// (8d5f58b89) and the embedded VMs of B, C2, D on straight-line code.
fn v_mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a-(a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}
fn v_vm_run(op:[]u8, arg:[]u8, pl:i32, in0:i32, in1:i32)i32 {
  let stack:[]u8=v_alloc(256*4);
  let sp:i32=0;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    if(pc<0 || pc>=pl){ break; }
    let o:i32=v_get32(op, pc*4);
    let a:i32=v_get32(arg, pc*4);
    pc=pc+1; steps=steps+1;
    if(o==0){ if(sp<256){ v_set32(stack, sp*4, a); sp=sp+1; } }
    else if(o==1){ if(sp<256){ v_set32(stack, sp*4, in0); sp=sp+1; } }
    else if(o==2){ if(sp<256){ v_set32(stack, sp*4, in1); sp=sp+1; } }
    else if(o==3){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; v_set32(stack,sp*4,x+b); sp=sp+1; } }
    else if(o==4){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; v_set32(stack,sp*4,x-b); sp=sp+1; } }
    else if(o==5){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; v_set32(stack,sp*4,x*b); sp=sp+1; } }
    else if(o==6){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=x/b;} v_set32(stack,sp*4,r); sp=sp+1; } }
    else if(o==7){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=v_mod_nonneg(x,b);} v_set32(stack,sp*4,r); sp=sp+1; } }
    else if(o==8){ if(sp>=1){ let x:i32=v_get32(stack,(sp-1)*4); v_set32(stack,(sp-1)*4,-x); } }
    else if(o==9){ if(sp>=1 && sp<256){ let x:i32=v_get32(stack,(sp-1)*4); v_set32(stack,sp*4,x); sp=sp+1; } }
    else if(o==10){ if(sp>=1){ sp=sp-1; } }
    else if(o==11){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); v_set32(stack,(sp-2)*4,b); v_set32(stack,(sp-1)*4,x); } }
    else if(o==12){ if(sp>=2 && sp<256){ let x:i32=v_get32(stack,(sp-2)*4); v_set32(stack,sp*4,x); sp=sp+1; } }
    else if(o==13){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(x<b){r=1;} v_set32(stack,sp*4,r); sp=sp+1; } }
    else if(o==14){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(x==b){r=1;} v_set32(stack,sp*4,r); sp=sp+1; } }
    else if(o==15){ if(sp>=2){ let b:i32=v_get32(stack,(sp-1)*4); let x:i32=v_get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(x>b){r=1;} v_set32(stack,sp*4,r); sp=sp+1; } }
    else if(o==16){ if(sp>=1){ let x:i32=v_get32(stack,(sp-1)*4); sp=sp-1; if(x==0){pc=a;} } }
    else if(o==17){ if(sp>=1){ let x:i32=v_get32(stack,(sp-1)*4); sp=sp-1; if(x!=0){pc=a;} } }
    else if(o==18){ pc=a; }
  }
  let r:i32=0;
  if(sp>0){ r=v_get32(stack,(sp-1)*4); }
  return r;
}

// ---------- instance table ----------
// ids: 0=CAL-0; 1..12 Family K ((n,K): (2,1)(2,2)(2,3)(3,1)(3,2)(3,5)
// (4,1)(4,2)(4,9)(5,1)(5,2)(5,9)); 13=A1; 14=A2. A3 DROPPED (documented
// in VALIDATION.md: V1 unsatisfiable for P0=[PUSH 0] on |x|).
fn vinst_n()i32 { return 15; }
fn vinst_kind(id:i32)i32 {
  if(id==0){ return 0; }
  if(id>=1 && id<=12){ return 1; }
  if(id==13){ return 2; }
  return 3;
}
fn vinst_K(id:i32)i32 {
  if(id==1){ return 1; } if(id==2){ return 2; } if(id==3){ return 3; }
  if(id==4){ return 1; } if(id==5){ return 2; } if(id==6){ return 5; }
  if(id==7){ return 1; } if(id==8){ return 2; } if(id==9){ return 9; }
  if(id==10){ return 1; } if(id==11){ return 2; } if(id==12){ return 9; }
  return 0;
}
fn vinst_nn(id:i32)i32 {
  if(id>=1 && id<=3){ return 2; }
  if(id>=4 && id<=6){ return 3; }
  if(id>=7 && id<=9){ return 4; }
  if(id>=10 && id<=12){ return 5; }
  return 0;
}
// nominal depth d
fn vinst_depth(id:i32)i32 {
  if(id==0){ return 0; }
  if(id>=1 && id<=12){ return vinst_nn(id)-1; }
  if(id==13){ return 4; }
  return 1;
}
// episode count |E|
fn vinst_nep(id:i32)i32 {
  if(id==0){ return 9; }
  if(id>=1 && id<=3){ return 4; }
  if(id>=4 && id<=6){ return 8; }
  if(id>=7 && id<=9){ return 16; }
  if(id>=10 && id<=12){ return 32; }
  if(id==13){ return 9; }
  return 17;
}
// episodes: in0 / tgt (in1 = 0 for all valley instances)
fn vinst_in0(id:i32, i:i32)i32 {
  if(id==0){ return i; }
  if(id>=1 && id<=12){ return i; }
  if(id==13){ return i; }
  return i;
}
fn vinst_tgt(id:i32, i:i32)i32 {
  if(id==0){ return i; }
  if(id>=1 && id<=12){ if(i==vinst_K(id)){ return 1; } return 0; }
  if(id==13){ return 2*i+1; }
  return v_mod_nonneg(i, 3);
}
// P0
fn vinst_p0_len(id:i32)i32 { return 1; }
fn vinst_p0_op(id:i32, i:i32)i32 {
  if(id==14){ return 1; }
  return 0;
}
fn vinst_p0_arg(id:i32, i:i32)i32 {
  if(id==13){ return 1; }
  return 0;
}
// canonical path O (ops appended to P0)
fn vinst_cpath_len(id:i32)i32 {
  if(id==0){ return 1; }
  if(id>=1 && id<=3){ return 16; }
  if(id>=4 && id<=6){ return 24; }
  if(id>=7 && id<=9){ return 32; }
  if(id>=10 && id<=12){ return 42; }
  if(id==13){ return 5; }
  return 2;
}
fn v_k_cpath(n:i32, K:i32, op:[]u8, arg:[]u8)i32 {
  let L:i32=0;
  v_set32(op, 0, 0); v_set32(arg, 0, 1); L=1; // PUSH 1
  let j:i32=0;
  while(j<n){
    v_set32(op, L*4, 1); v_set32(arg, L*4, 0); L=L+1; // IN0
    if(j<4){
      let p:i32=1; let t:i32=0;
      while(t<j){ p=p*2; t=t+1; }
      v_set32(op, L*4, 0); v_set32(arg, L*4, p); L=L+1; // PUSH 2^j
    } else {
      // synthesize PUSH 16 as PUSH 8, PUSH 2, MUL
      v_set32(op, L*4, 0); v_set32(arg, L*4, 8); L=L+1;
      v_set32(op, L*4, 0); v_set32(arg, L*4, 2); L=L+1;
      v_set32(op, L*4, 5); v_set32(arg, L*4, 0); L=L+1;
    }
    v_set32(op, L*4, 6); v_set32(arg, L*4, 0); L=L+1; // DIV
    v_set32(op, L*4, 0); v_set32(arg, L*4, 2); L=L+1; // PUSH 2
    v_set32(op, L*4, 7); v_set32(arg, L*4, 0); L=L+1; // MOD
    let kj:i32=(K/(1<<j))%2;
    v_set32(op, L*4, 0); v_set32(arg, L*4, kj); L=L+1; // PUSH k_j
    v_set32(op, L*4, 14); v_set32(arg, L*4, 0); L=L+1; // EQ
    v_set32(op, L*4, 5); v_set32(arg, L*4, 0); L=L+1; // MUL
    j=j+1;
  }
  return L;
}
fn vinst_cpath_op(id:i32, i:i32, op:[]u8, arg:[]u8)i32 {
  // fills op/arg buffers with canonical path; returns length.
  // (op/arg indexed by i32 slots; caller allocates >= 48 slots.)
  if(id==0){ v_set32(op,0,1); v_set32(arg,0,0); return 1; } // CAL-0: [IN0]
  if(id>=1 && id<=12){ return v_k_cpath(vinst_nn(id), vinst_K(id), op, arg); }
  if(id==13){
    // A1: walkthrough e658766bd repair chunks after P0=[PUSH 1]:
    // [IN0, PUSH 1], then [IN0, ADD, ADD].
    // Full: [PUSH 1, IN0, PUSH 1, IN0, ADD, ADD] (7 ops).
    v_set32(op,0,1); v_set32(arg,0,0);
    v_set32(op,4,0); v_set32(arg,4,1);
    v_set32(op,8,1); v_set32(arg,8,0);
    v_set32(op,12,3); v_set32(arg,12,0);
    v_set32(op,16,3); v_set32(arg,16,0);
    return 5;
  }
  // A2: [PUSH 3, MOD]
  v_set32(op,0,0); v_set32(arg,0,3);
  v_set32(op,4,7); v_set32(arg,4,0);
  return 2;
}
// score of op/arg program (length pl) on instance id
fn vinst_score(id:i32, op:[]u8, arg:[]u8, pl:i32)i32 {
  let c:i32=0;
  let n:i32=vinst_nep(id);
  let i:i32=0;
  while(i<n){
    let o:i32=v_vm_run(op, arg, pl, vinst_in0(id,i), 0);
    if(o==vinst_tgt(id,i)){ c=c+1; }
    i=i+1;
  }
  return c;
}
// s0 = Score(P0)
fn vinst_s0(id:i32)i32 {
  let op:[]u8=v_alloc(4*4);
  let arg:[]u8=v_alloc(4*4);
  v_set32(op, 0, vinst_p0_op(id, 0)); v_set32(arg, 0, vinst_p0_arg(id, 0));
  return vinst_score(id, op, arg, 1);
}
// full canonical program length = |P0| + |O|
fn vinst_full_len(id:i32)i32 { return vinst_p0_len(id)+vinst_cpath_len(id); }
// vgen.zag: valley instance generation + validation (step b).
// Implements V1 (score profile), V2 (REF-GREEDY fails), V3 (no shallow
// shortcut). V4 via vdrv_a / vdrv_c1. V5 via 3x shell invocation.
// Pure Zag. Concatenated after vinst.zag.

// frozen straight-line op alphabet order (34 symbols):
// IN0, IN1, PUSH -9..9, ADD, SUB, MUL, DIV, MOD, NEG, DUP, DROP,
// SWAP, OVER, LT, EQ, GT.
fn v_alpha_op(s:i32)i32 {
  if(s==0){ return 1; }
  if(s==1){ return 2; }
  if(s>=2 && s<=20){ return 0; }
  if(s==21){ return 3; } if(s==22){ return 4; } if(s==23){ return 5; }
  if(s==24){ return 6; } if(s==25){ return 7; } if(s==26){ return 8; }
  if(s==27){ return 9; } if(s==28){ return 10; } if(s==29){ return 11; }
  if(s==30){ return 12; } if(s==31){ return 13; } if(s==32){ return 14; }
  return 15;
}
fn v_alpha_arg(s:i32)i32 {
  if(s>=2 && s<=20){ return s-11; }
  return 0;
}

// build full canonical program F = P0 + O into fop/farg; return L.
fn v_build_full(id:i32, fop:[]u8, farg:[]u8)i32 {
  let L:i32=0;
  let pl:i32=vinst_p0_len(id);
  let i:i32=0;
  while(i<pl){
    v_set32(fop, L*4, vinst_p0_op(id, i)); v_set32(farg, L*4, vinst_p0_arg(id, i));
    L=L+1; i=i+1;
  }
  let op:[]u8=v_alloc(48*4); let arg:[]u8=v_alloc(48*4);
  let cl:i32=vinst_cpath_op(id, 0, op, arg);
  i=0;
  while(i<cl){
    v_set32(fop, L*4, v_get32(op, i*4)); v_set32(farg, L*4, v_get32(arg, i*4));
    L=L+1; i=i+1;
  }
  return L;
}

// V1: returns 1 if accepted.
// For Family K the tie rule applies to stage-boundary prefixes;
// for Family A it applies to all op-level proper prefixes.
fn v_v1(id:i32, fop:[]u8, farg:[]u8, L:i32, s0:i32, n:i32)i32 {
  let p0l:i32=vinst_p0_len(id);
  // every non-empty op-level proper prefix of the canonical path scores <= s0
  let k:i32=p0l+1;
  while(k<L){
    let sc:i32=vinst_score(id, fop, farg, k);
    if(sc>s0){
      v_emit("  V1-FAIL oplevel k="); v_e64(k); v_emit(" score="); v_e64(sc);
      v_emit(" > s0="); v_e64(s0); v_nl();
      return 0;
    }
    k=k+1;
  }
  let kind:i32=vinst_kind(id);
  if(kind==1){
    let nn:i32=vinst_nn(id);
    let d:i32=nn-1;
    let strict:i32=0; let ties:i32=0;
    let j:i32=0;
    while(j<d){
      // stage j ends after PUSH 1 + (j+1) stages; n=5 stage 3 has 10 ops.
      let bl:i32=10+8*j;
      if(vinst_nn(id)==5 && j==3){ bl=36; }
      let sc:i32=vinst_score(id, fop, farg, bl);
      v_emit("  V1 stage j="); v_e64(j); v_emit(" len="); v_e64(bl);
      v_emit(" score="); v_e64(sc); v_nl();
      if(sc<s0){ strict=strict+1; }
      if(sc==s0){ ties=ties+1; }
      j=j+1;
    }
    if(ties>1 || strict<d-1){
      v_emit("  V1-FAIL stage ties="); v_e64(ties);
      v_emit(" strict="); v_e64(strict); v_emit(" d="); v_e64(d); v_nl();
      return 0;
    }
  } else {
    // Family A: tie rule over all non-empty op-level proper prefixes
    let ties:i32=0; let nonimp:i32=0;
    k=p0l+1;
    while(k<L){
      let sc:i32=vinst_score(id, fop, farg, k);
      v_emit("  V1 prefix k="); v_e64(k); v_emit(" score="); v_e64(sc); v_nl();
      if(sc<=s0){ nonimp=nonimp+1; }
      if(sc==s0){ ties=ties+1; }
      k=k+1;
    }
    if(ties>1){
      v_emit("  V1-FAIL familyA ties="); v_e64(ties); v_nl();
      return 0;
    }
    if(nonimp!=vinst_depth(id)){
      v_emit("  V1-FAIL familyA nonimp="); v_e64(nonimp);
      v_emit(" depth="); v_e64(vinst_depth(id)); v_nl();
      return 0;
    }
  }
  let full:i32=vinst_score(id, fop, farg, L);
  if(full!=n){
    v_emit("  V1-FAIL full="); v_e64(full); v_emit(" n="); v_e64(n); v_nl();
    return 0;
  }
  return 1;
}

// V2: REF-GREEDY. Returns 1 if greedy FAILS to solve (instance OK).
fn v_v2(id:i32)i32 {
  let n:i32=vinst_nep(id);
  let op:[]u8=v_alloc(256*4); let arg:[]u8=v_alloc(256*4);
  v_set32(op, 0, vinst_p0_op(id, 0)); v_set32(arg, 0, vinst_p0_arg(id, 0));
  let len:i32=1;
  let cur:i32=vinst_score(id, op, arg, len);
  let iter:i32=0;
  while(iter<500){
    let best:i32=cur; let bo:i32=-1; let ba:i32=0;
    let s:i32=0;
    while(s<34){
      v_set32(op, len*4, v_alpha_op(s)); v_set32(arg, len*4, v_alpha_arg(s));
      let sc:i32=vinst_score(id, op, arg, len+1);
      if(sc>best){ best=sc; bo=v_alpha_op(s); ba=v_alpha_arg(s); }
      s=s+1;
    }
    if(bo==-1){
      v_emit("  V2 greedy-halted len="); v_e64(len);
      v_emit(" score="); v_e64(cur); v_nl();
      return 1;
    }
    v_set32(op, len*4, bo); v_set32(arg, len*4, ba); len=len+1;
    cur=best;
    v_emit("  V2 greedy-step len="); v_e64(len);
    v_emit(" score="); v_e64(cur); v_nl();
    if(cur==n){ return 0; }
    iter=iter+1;
  }
  return 1;
}

// is prog[0..pl] a prefix of F[0..L]? (lengths p0l..L)
fn v_is_f_prefix(prog_op:[]u8, prog_arg:[]u8, pl:i32,
                 fop:[]u8, farg:[]u8, L:i32, p0l:i32)i32 {
  let m:i32=p0l;
  while(m<=L){
    if(pl==m){
      let ok:i32=1;
      let i:i32=0;
      while(i<m){
        if(v_get32(prog_op,i*4)!=v_get32(fop,i*4) ||
           v_get32(prog_arg,i*4)!=v_get32(farg,i*4)){ ok=0; }
        i=i+1;
      }
      if(ok==1){ return 1; }
    }
    m=m+1;
  }
  return 0;
}

// V3: returns 1 if no solving neighbor found (instance OK).
// Checks the full 1-edit neighborhood of every proper prefix, plus
// every 2-edit neighbor of length <= 12 (complete for prefixes of
// length <= 10). Neighbors that are prefixes of the canonical full
// program are skipped (the canonical completion is not a shortcut).
fn v_v3(id:i32, fop:[]u8, farg:[]u8, L:i32)i32 {
  let n:i32=vinst_nep(id);
  let p0l:i32=vinst_p0_len(id);
  let pop:[]u8=v_alloc(64*4); let parg:[]u8=v_alloc(64*4);
  let nop:[]u8=v_alloc(64*4); let narg:[]u8=v_alloc(64*4);
  let k:i32=p0l;
  while(k<L){
    // copy prefix P_k into pop/parg
    let i:i32=0;
    while(i<k){ v_set32(pop,i*4,v_get32(fop,i*4)); v_set32(parg,i*4,v_get32(farg,i*4)); i=i+1; }
    // ---- 1-edit: append ----
    let s:i32=0;
    while(s<34){
      let m:i32=k+1;
      i=0; while(i<k){ v_set32(nop,i*4,v_get32(pop,i*4)); v_set32(narg,i*4,v_get32(parg,i*4)); i=i+1; }
      v_set32(nop,k*4,v_alpha_op(s)); v_set32(narg,k*4,v_alpha_arg(s));
      if(v_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(vinst_score(id,nop,narg,m)==n){
          v_emit("  V3-FAIL k="); v_e64(k); v_emit(" append sym="); v_e64(s); v_nl();
          return 0;
        }
      }
      s=s+1;
    }
    // ---- 1-edit: replace ----
    let pos:i32=0;
    while(pos<k){
      s=0;
      while(s<34){
        if(v_alpha_op(s)!=v_get32(pop,pos*4) || v_alpha_arg(s)!=v_get32(parg,pos*4)){
          i=0; while(i<k){ v_set32(nop,i*4,v_get32(pop,i*4)); v_set32(narg,i*4,v_get32(parg,i*4)); i=i+1; }
          v_set32(nop,pos*4,v_alpha_op(s)); v_set32(narg,pos*4,v_alpha_arg(s));
          if(v_is_f_prefix(nop,narg,k,fop,farg,L,p0l)==0){
            if(vinst_score(id,nop,narg,k)==n){
              v_emit("  V3-FAIL k="); v_e64(k); v_emit(" replace pos="); v_e64(pos);
              v_emit(" sym="); v_e64(s); v_nl();
              return 0;
            }
          }
        }
        s=s+1;
      }
      pos=pos+1;
    }
    // ---- 1-edit: delete ----
    pos=0;
    while(pos<k){
      let m:i32=k-1;
      i=0;
      while(i<m){
        let src:i32=i;
        if(i>=pos){ src=i+1; }
        v_set32(nop,i*4,v_get32(pop,src*4)); v_set32(narg,i*4,v_get32(parg,src*4));
        i=i+1;
      }
      if(v_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(vinst_score(id,nop,narg,m)==n){
          v_emit("  V3-FAIL k="); v_e64(k); v_emit(" delete pos="); v_e64(pos); v_nl();
          return 0;
        }
      }
      pos=pos+1;
    }
    // ---- 2-edit neighbors of length <= 12 ----
    if(k<=10){
      // first edit: iterate over 1-edit neighbors qop (length ql)
      let qop:[]u8=v_alloc(64*4); let qarg:[]u8=v_alloc(64*4);
      // appends
      s=0;
      while(s<34){
        let ql:i32=k+1;
        i=0; while(i<k){ v_set32(qop,i*4,v_get32(pop,i*4)); v_set32(qarg,i*4,v_get32(parg,i*4)); i=i+1; }
        v_set32(qop,k*4,v_alpha_op(s)); v_set32(qarg,k*4,v_alpha_arg(s));
        if(v_v3_second(id,qop,qarg,ql,fop,farg,L,p0l,nop,narg)==0){ return 0; }
        s=s+1;
      }
      // replaces
      pos=0;
      while(pos<k){
        s=0;
        while(s<34){
          if(v_alpha_op(s)!=v_get32(pop,pos*4) || v_alpha_arg(s)!=v_get32(parg,pos*4)){
            i=0; while(i<k){ v_set32(qop,i*4,v_get32(pop,i*4)); v_set32(qarg,i*4,v_get32(parg,i*4)); i=i+1; }
            v_set32(qop,pos*4,v_alpha_op(s)); v_set32(qarg,pos*4,v_alpha_arg(s));
            if(v_v3_second(id,qop,qarg,k,fop,farg,L,p0l,nop,narg)==0){ return 0; }
          }
          s=s+1;
        }
        pos=pos+1;
      }
      // deletes
      pos=0;
      while(pos<k){
        let ql2:i32=k-1;
        i=0;
        while(i<ql2){
          let src:i32=i;
          if(i>=pos){ src=i+1; }
          v_set32(qop,i*4,v_get32(pop,src*4)); v_set32(qarg,i*4,v_get32(parg,src*4));
          i=i+1;
        }
        if(v_v3_second(id,qop,qarg,ql2,fop,farg,L,p0l,nop,narg)==0){ return 0; }
        pos=pos+1;
      }
    }
    k=k+1;
  }
  return 1;
}

// print a program as (op,arg) pairs
fn v_print_prog(op:[]u8, arg:[]u8, pl:i32)void {
  let i:i32=0;
  while(i<pl){
    v_emit(" ("); v_e64(v_get32(op,i*4)); v_emit(","); v_e64(v_get32(arg,i*4)); v_emit(")");
    i=i+1;
  }
  return;
}

// second edit applied to qop/qarg (length ql); checks all 1-edit
// neighbors of length <= 12. Returns 0 if a solver is found.
fn v_v3_second(id:i32, qop:[]u8, qarg:[]u8, ql:i32,
               fop:[]u8, farg:[]u8, L:i32, p0l:i32,
               nop:[]u8, narg:[]u8)i32 {
  let n:i32=vinst_nep(id);
  let i:i32=0; let s:i32=0; let pos:i32=0;
  // append (length ql+1 <= 12)
  if(ql+1<=12){
    s=0;
    while(s<34){
      i=0; while(i<ql){ v_set32(nop,i*4,v_get32(qop,i*4)); v_set32(narg,i*4,v_get32(qarg,i*4)); i=i+1; }
      v_set32(nop,ql*4,v_alpha_op(s)); v_set32(narg,ql*4,v_alpha_arg(s));
      if(v_is_f_prefix(nop,narg,ql+1,fop,farg,L,p0l)==0){
        if(vinst_score(id,nop,narg,ql+1)==n){
          v_emit("  V3-FAIL 2edit append solver="); v_print_prog(nop,narg,ql+1); v_nl();
          return 0;
        }
      }
      s=s+1;
    }
  }
  // replace
  pos=0;
  while(pos<ql){
    s=0;
    while(s<34){
      if(v_alpha_op(s)!=v_get32(qop,pos*4) || v_alpha_arg(s)!=v_get32(qarg,pos*4)){
        i=0; while(i<ql){ v_set32(nop,i*4,v_get32(qop,i*4)); v_set32(narg,i*4,v_get32(qarg,i*4)); i=i+1; }
        v_set32(nop,pos*4,v_alpha_op(s)); v_set32(narg,pos*4,v_alpha_arg(s));
        if(v_is_f_prefix(nop,narg,ql,fop,farg,L,p0l)==0){
          if(vinst_score(id,nop,narg,ql)==n){
            v_emit("  V3-FAIL 2edit replace solver="); v_print_prog(nop,narg,ql); v_nl();
            return 0;
          }
        }
      }
      s=s+1;
    }
    pos=pos+1;
  }
  // delete (length ql-1 <= 12 automatic since ql<=13 here... bound anyway)
  if(ql-1<=12){
    pos=0;
    while(pos<ql){
      let m:i32=ql-1;
      i=0;
      while(i<m){
        let src:i32=i;
        if(i>=pos){ src=i+1; }
        v_set32(nop,i*4,v_get32(qop,src*4)); v_set32(narg,i*4,v_get32(qarg,src*4));
        i=i+1;
      }
      if(v_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(vinst_score(id,nop,narg,m)==n){
          v_emit("  V3-FAIL 2edit delete solver="); v_print_prog(nop,narg,m); v_nl();
          return 0;
        }
      }
      pos=pos+1;
    }
  }
  return 1;
}

fn v_validate_one(id:i32)i32 {
  let n:i32=vinst_nep(id);
  let s0:i32=vinst_s0(id);
  v_emit("INSTANCE id="); v_e64(id);
  v_emit(" kind="); v_e64(vinst_kind(id));
  v_emit(" nep="); v_e64(n);
  v_emit(" s0="); v_e64(s0);
  v_emit(" depth="); v_e64(vinst_depth(id));
  v_nl();
  if(id==0){
    // CAL-0: no V1-V5; report s0 and the IN0 solve check.
    let op:[]u8=v_alloc(8*4); let arg:[]u8=v_alloc(8*4);
    v_set32(op,0,0); v_set32(arg,0,0); v_set32(op,4,1); v_set32(arg,4,0);
    let sc:i32=vinst_score(id, op, arg, 2);
    v_emit("  CAL0-OK in0-solve-score="); v_e64(sc); v_nl();
    if(sc==n){ return 1; }
    return 0;
  }
  let fop:[]u8=v_alloc(64*4); let farg:[]u8=v_alloc(64*4);
  let L:i32=v_build_full(id, fop, farg);
  v_emit("  canonlen="); v_e64(L); v_nl();
  let r1:i32=v_v1(id, fop, farg, L, s0, n);
  v_emit("  V1 "); if(r1==1){ v_emit("PASS"); } else { v_emit("FAIL"); } v_nl();
  if(r1==0){ return 0; }
  let r2:i32=v_v2(id);
  v_emit("  V2 "); if(r2==1){ v_emit("PASS"); } else { v_emit("FAIL"); } v_nl();
  if(r2==0){ return 0; }
  let r3:i32=v_v3(id, fop, farg, L);
  v_emit("  V3 "); if(r3==1){ v_emit("PASS"); } else { v_emit("FAIL"); } v_nl();
  if(r3==0){ return 0; }
  v_emit("  ACCEPTED"); v_nl();
  return 1;
}

fn main()void {
  v_emit("VALLEY-VALIDATION step-b prereg=cf0c85e78\n");
  let ok:i32=1;
  let id:i32=0;
  while(id<vinst_n()){
    if(v_validate_one(id)==0){ ok=0; }
    id=id+1;
  }
  if(ok==1){ v_emit("VALIDATION-ALL-ACCEPTED\n"); }
  else { v_emit("VALIDATION-SOME-FAILED\n"); }
  return;
}

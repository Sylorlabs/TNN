// ivwc_expand.zag -- Multi-step Internal Verification via World Consequences.
// The learner commits to a NAV+GATHER composition (P1) plus its own
// confidence BEFORE any outcome signal. The world returns environmental
// consequences (physics of executing the plan) plus a per-action evidence
// log (position + outcome: move ok, bump left/right, gather hit/miss).
// The learner REVISES its composition from that evidence alone
// (phantom item beliefs cleared, bump-discovered walls added) and
// recomposes P2. The world executes P2: the further consequences
// validate the revision. No harness-supplied verdict exists
// anywhere in the program.
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (world/beliefs identical to IVWC baseline) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;

// ---------- helpers (u8-backed cells, little-endian) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn abs32(v:i32)i32 {
  if(v<0){return 0-v;}
  return v;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow). The seed is
// reduced mod 65536 on entry so large frozen seeds cannot overflow
// the multiply on the first step.
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}

// ===== WORLD =====
// Ground-truth generator. Record: walls[0..19], items[20..39], start[40].
fn world_gen(seed:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < 15){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
// Belief generator (harness setup only): frozen noisy copy of truth.
// Wall belief flips 12% (never start). True items dropped 15%.
// Empty true-open cells gain phantom item beliefs 18%.
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
// Step physics. st cells: pos@0, collected@4, bumps@8, wasted@12.
// Each returns its physics outcome so the caller can log evidence.
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
// Outcome codes: 0 move ok, 1 bump left, 2 bump right,
// 3 gather hit, 4 gather miss. All derived from physics.
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// Consequence simulator: steps the committed plan through corridor
// physics and records a per-action evidence log (position byte,
// outcome byte). cons cells: collected@0, energy_used@4, bumps@8,
// wasted@12, final_pos@16, plan_len@20. No reference plan exists;
// consequences and evidence are physics outputs of executing this
// plan in this world.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// 1 if the believed interval [lo,hi] holds a believed wall.
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
// Append one leg: moves from pos toward tgt, then GATHER.
// pcs cells: pos@0 (in/out), tgt@4, at@8 (in/out).
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only. Sees no world truth.
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Learner-owned revision. Inputs: its beliefs, its committed plan P1
// (carried for interface honesty; the evidence positions already
// locate every action), and the physics evidence log. No world truth
// reaches this function.
// Evidence truthfulness: a gather miss means the cell truly holds no
// item (each cell is gathered at most once per execution), so the
// item belief was phantom and is cleared. A bump means the adjacent
// cell is truly a wall, so the wall belief is set. Both fixes
// can only remove wasted actions, never a truly-collected item.
fn learner_revise(bb:[]u8, boff:i32, pb:[]u8, poff:i32, L1:i32, eb:[]u8, eoff:i32, en:i32, rb:[]u8, roff:i32, p2b:[]u8, p2off:i32, m2b:[]u8, m2off:i32)void {
  let c:i32=0;
  while(c<RECW){
    set8(rb,roff+c,get8(bb,boff+c));
    c=c+1;
  }
  let n:i32=en;
  if(n>L1){ n=L1; }
  let i:i32=0;
  while(i<n){
    let pos:i32=get8(eb,eoff+2*i);
    let oc:i32=get8(eb,eoff+2*i+1);
    if(oc==4){ set8(rb,roff+CW+pos,0); }
    if(oc==1){ if(pos>0){ set8(rb,roff+pos-1,1); } }
    if(oc==2){ if(pos<CW-1){ set8(rb,roff+pos+1,1); } }
    i=i+1;
  }
  learner_compose(rb,roff,p2b,p2off,m2b,m2off);
  return;
}

// 1 if two plans differ (length or any byte).
fn plans_differ(pb:[]u8, poff:i32, L1:i32, qb:[]u8, qoff:i32, L2:i32)i32 {
  if(L1!=L2){ return 1; }
  let i:i32=0;
  while(i<L1){
    if(get8(pb,poff+i)!=get8(qb,qoff+i)){ return 1; }
    i=i+1;
  }
  return 0;
}

// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCX-BEGIN\n");
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let rtmp:[]u8=z_alloc(RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let p2train:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let m2train:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let c2train:[]u8=z_alloc(NTRAIN*RECC);
  let etrain:[]u8=z_alloc(NTRAIN*EREC);
  let etmp:[]u8=z_alloc(EREC);
  let eb0:[]u8=z_alloc(EREC);
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let p2seal:[]u8=z_alloc(NSEAL*PLANMAX);
  let p2abl:[]u8=z_alloc(NSEAL*PLANMAX);
  let p2shuf:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let m2seal:[]u8=z_alloc(NSEAL*RECM);
  let m2sabl:[]u8=z_alloc(NSEAL*RECM);
  let m2shuf:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let c2seal:[]u8=z_alloc(NSEAL*RECC);
  let c2sabl:[]u8=z_alloc(NSEAL*RECC);
  let c2shuf:[]u8=z_alloc(NSEAL*RECC);
  let eseal:[]u8=z_alloc(NSEAL*EREC);
  let wc:[]u8=z_alloc(4);
  // Phase 1: train SETUP. Harness builds truth and beliefs.
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // Phase 2: train COMMIT1. Learner sees beliefs only.
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  let k1a:i32=0;
  if(get32(wc,0)==0){
    k1a=1;
    at=ob_app(ob,at,"K1A-STRUCT-PASS world_calls=0 after train COMMIT1\n");
  } else {
    at=ob_app(ob,at,"K1A-STRUCT-FAIL\n");
  }
  // Phase 3: train CONSEQ1. World executes committed P1 plans.
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etrain, t*EREC, wc);
    t=t+1;
  }
  // Phase 4: train REVISE. Learner revises from evidence only.
  let wcb:i32=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    let rl1:i32=get32(mtrain,t*RECM+4);
    learner_revise(btrain, t*RECW, ptrain, t*PLANMAX, rl1, etrain, t*EREC, rl1, rtmp, 0, p2train, t*PLANMAX, m2train, t*RECM);
    t=t+1;
  }
  let k1b:i32=0;
  if(get32(wc,0)==wcb){
    k1b=1;
    at=ob_app(ob,at,"K1B-STRUCT-PASS world_calls unchanged across train REVISE\n");
  } else {
    at=ob_app(ob,at,"K1B-STRUCT-FAIL\n");
  }
  // Phase 5: train CONSEQ2. World executes revised P2 plans
  // (fresh episode on the same truth; evidence goes to scratch).
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, p2train, t*PLANMAX, get32(m2train,t*RECM+4), c2train, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // K3 in-program check: some revised plan must differ from P1.
  let k3n:i32=0;
  t=0;
  while(t<NTRAIN){
    if(plans_differ(ptrain,t*PLANMAX,get32(mtrain,t*RECM+4),p2train,t*PLANMAX,get32(m2train,t*RECM+4))==1){ k3n=k3n+1; }
    t=t+1;
  }
  let k3:i32=0;
  if(k3n>0){
    k3=1;
    at=ob_app(ob,at,"K3-STRUCT-PASS nrev=");
    at=ob_i32(ob,at,k3n);
    at=ob_nl(ob,at);
  } else {
    at=ob_app(ob,at,"K3-STRUCT-FAIL\n");
  }
  // Train case detail.
  at=ob_app(ob,at,"TRAIN t g1 L1 raw1 col1 eff1 g2 L2 raw2 col2 eff2 rev\n");
  t=0;
  while(t<NTRAIN){
    let tg1:i32=get32(mtrain,t*RECM);
    let tL1:i32=get32(mtrain,t*RECM+4);
    let traw1:i32=get32(mtrain,t*RECM+8);
    let tcol1:i32=get32(ctrain,t*RECC);
    let teu1:i32=get32(ctrain,t*RECC+4);
    let teff1:i32=0;
    if(teu1>0){ teff1=(100*tcol1)/teu1; }
    let tg2:i32=get32(m2train,t*RECM);
    let tL2:i32=get32(m2train,t*RECM+4);
    let traw2:i32=get32(m2train,t*RECM+8);
    let tcol2:i32=get32(c2train,t*RECC);
    let teu2:i32=get32(c2train,t*RECC+4);
    let teff2:i32=0;
    if(teu2>0){ teff2=(100*tcol2)/teu2; }
    let trev:i32=plans_differ(ptrain,t*PLANMAX,tL1,p2train,t*PLANMAX,tL2);
    at=ob_app(ob,at,"T t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," g1=");
    at=ob_i32(ob,at,tg1);
    at=ob_app(ob,at," L1=");
    at=ob_i32(ob,at,tL1);
    at=ob_app(ob,at," raw1=");
    at=ob_i32(ob,at,traw1);
    at=ob_app(ob,at," col1=");
    at=ob_i32(ob,at,tcol1);
    at=ob_app(ob,at," eff1=");
    at=ob_i32(ob,at,teff1);
    at=ob_app(ob,at," g2=");
    at=ob_i32(ob,at,tg2);
    at=ob_app(ob,at," L2=");
    at=ob_i32(ob,at,tL2);
    at=ob_app(ob,at," raw2=");
    at=ob_i32(ob,at,traw2);
    at=ob_app(ob,at," col2=");
    at=ob_i32(ob,at,tcol2);
    at=ob_app(ob,at," eff2=");
    at=ob_i32(ob,at,teff2);
    at=ob_app(ob,at," rev=");
    at=ob_i32(ob,at,trev);
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Phase 6: sealed SETUP. Fresh worlds the learner never saw.
  let s:i32=0;
  while(s<NSEAL){
    let cid:i32=100+s;
    world_gen(7919*cid+13, wseal, s*RECW);
    belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
    s=s+1;
  }
  // Phase 7: sealed COMMIT1 (batched before any sealed consequence).
  s=0;
  while(s<NSEAL){
    learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
    s=s+1;
  }
  // Phase 8: sealed CONSEQ1.
  s=0;
  while(s<NSEAL){
    world_execute(wseal, s*RECW, pseal, s*PLANMAX, get32(mseal,s*RECM+4), cseal, s*RECC, eseal, s*EREC, wc);
    s=s+1;
  }
  // Phase 9: sealed REVISE+CONSEQ2 with ablation and shuffled arms.
  let sum_eff1:i32=0;
  let sum_eff2:i32=0;
  let sum_abl:i32=0;
  let sum_shuf:i32=0;
  let sum_col1:i32=0;
  let sum_col2:i32=0;
  let sum_prederr:i32=0;
  let sum_actgain:i32=0;
  let n_abldiff:i32=0;
  at=ob_app(ob,at,"SEALED s g1 L1 raw1 col1 eff1 g2 L2 raw2 col2 eff2 eabl eshuf pg ag\n");
  s=0;
  while(s<NSEAL){
    let sL1:i32=get32(mseal,s*RECM+4);
    learner_revise(bseal, s*RECW, pseal, s*PLANMAX, sL1, eseal, s*EREC, sL1, rtmp, 0, p2seal, s*PLANMAX, m2seal, s*RECM);
    let sL2:i32=get32(m2seal,s*RECM+4);
    world_execute(wseal, s*RECW, p2seal, s*PLANMAX, sL2, c2seal, s*RECC, etmp, 0, wc);
    learner_revise(bseal, s*RECW, pseal, s*PLANMAX, sL1, eb0, 0, 0, rtmp, 0, p2abl, s*PLANMAX, m2sabl, s*RECM);
    world_execute(wseal, s*RECW, p2abl, s*PLANMAX, get32(m2sabl,s*RECM+4), c2sabl, s*RECC, etmp, 0, wc);
    if(plans_differ(pseal,s*PLANMAX,sL1,p2abl,s*PLANMAX,get32(m2sabl,s*RECM+4))==1){ n_abldiff=n_abldiff+1; }
    let u:i32=s+5;
    if(u>=NSEAL){ u=u-NSEAL; }
    let uL1:i32=get32(mseal,u*RECM+4);
    learner_revise(bseal, s*RECW, pseal, s*PLANMAX, sL1, eseal, u*EREC, uL1, rtmp, 0, p2shuf, s*PLANMAX, m2shuf, s*RECM);
    world_execute(wseal, s*RECW, p2shuf, s*PLANMAX, get32(m2shuf,s*RECM+4), c2shuf, s*RECC, etmp, 0, wc);
    let sg1:i32=get32(mseal,s*RECM);
    let sraw1:i32=get32(mseal,s*RECM+8);
    let scol1:i32=get32(cseal,s*RECC);
    let seu1:i32=get32(cseal,s*RECC+4);
    let seff1:i32=0;
    if(seu1>0){ seff1=(100*scol1)/seu1; }
    let sg2:i32=get32(m2seal,s*RECM);
    let sraw2:i32=get32(m2seal,s*RECM+8);
    let scol2:i32=get32(c2seal,s*RECC);
    let seu2:i32=get32(c2seal,s*RECC+4);
    let seff2:i32=0;
    if(seu2>0){ seff2=(100*scol2)/seu2; }
    let scolabl:i32=get32(c2sabl,s*RECC);
    let seuabl:i32=get32(c2sabl,s*RECC+4);
    let seffabl:i32=0;
    if(seuabl>0){ seffabl=(100*scolabl)/seuabl; }
    let scolsh:i32=get32(c2shuf,s*RECC);
    let seush:i32=get32(c2shuf,s*RECC+4);
    let seffsh:i32=0;
    if(seush>0){ seffsh=(100*scolsh)/seush; }
    let pg:i32=sraw2-sraw1;
    let ag:i32=seff2-seff1;
    sum_eff1=sum_eff1+seff1;
    sum_eff2=sum_eff2+seff2;
    sum_abl=sum_abl+seffabl;
    sum_shuf=sum_shuf+seffsh;
    sum_col1=sum_col1+scol1;
    sum_col2=sum_col2+scol2;
    sum_prederr=sum_prederr+abs32(pg-ag);
    sum_actgain=sum_actgain+abs32(ag);
    at=ob_app(ob,at,"S s=");
    at=ob_i32(ob,at,s);
    at=ob_app(ob,at," g1=");
    at=ob_i32(ob,at,sg1);
    at=ob_app(ob,at," L1=");
    at=ob_i32(ob,at,sL1);
    at=ob_app(ob,at," raw1=");
    at=ob_i32(ob,at,sraw1);
    at=ob_app(ob,at," col1=");
    at=ob_i32(ob,at,scol1);
    at=ob_app(ob,at," eff1=");
    at=ob_i32(ob,at,seff1);
    at=ob_app(ob,at," g2=");
    at=ob_i32(ob,at,sg2);
    at=ob_app(ob,at," L2=");
    at=ob_i32(ob,at,sL2);
    at=ob_app(ob,at," raw2=");
    at=ob_i32(ob,at,sraw2);
    at=ob_app(ob,at," col2=");
    at=ob_i32(ob,at,scol2);
    at=ob_app(ob,at," eff2=");
    at=ob_i32(ob,at,seff2);
    at=ob_app(ob,at," eabl=");
    at=ob_i32(ob,at,seffabl);
    at=ob_app(ob,at," eshuf=");
    at=ob_i32(ob,at,seffsh);
    at=ob_app(ob,at," pg=");
    at=ob_i32(ob,at,pg);
    at=ob_app(ob,at," ag=");
    at=ob_i32(ob,at,ag);
    at=ob_nl(ob,at);
    s=s+1;
  }
  at=ob_app(ob,at,"SUMMARY nseal=");
  at=ob_i32(ob,at,NSEAL);
  at=ob_app(ob,at," sum_eff1=");
  at=ob_i32(ob,at,sum_eff1);
  at=ob_app(ob,at," sum_eff2=");
  at=ob_i32(ob,at,sum_eff2);
  at=ob_app(ob,at," sum_abl=");
  at=ob_i32(ob,at,sum_abl);
  at=ob_app(ob,at," sum_shuf=");
  at=ob_i32(ob,at,sum_shuf);
  at=ob_app(ob,at," sum_col1=");
  at=ob_i32(ob,at,sum_col1);
  at=ob_app(ob,at," sum_col2=");
  at=ob_i32(ob,at,sum_col2);
  at=ob_app(ob,at," sum_prederr=");
  at=ob_i32(ob,at,sum_prederr);
  at=ob_app(ob,at," sum_actgain=");
  at=ob_i32(ob,at,sum_actgain);
  at=ob_app(ob,at," n_abldiff=");
  at=ob_i32(ob,at,n_abldiff);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(sum_eff2>sum_eff1){
    k4=1;
    at=ob_app(ob,at,"K4-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K4-PROV-FAIL\n");
  }
  let k6:i32=0;
  if(sum_eff2>sum_abl){
    k6=1;
    at=ob_app(ob,at,"K6-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K6-PROV-FAIL\n");
  }
  at=ob_app(ob,at,"K2-AUDIT-SHELL K5-AUDIT-SHELL\n");
  at=ob_app(ob,at,"FLAGS k1a=");
  at=ob_i32(ob,at,k1a);
  at=ob_app(ob,at," k1b=");
  at=ob_i32(ob,at,k1b);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCX-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

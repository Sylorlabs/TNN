// nr_main.zag -- harness main for SPEC-NOISY-RATES.
// Sweeps drift cell M and query cell N over {1,2,4,8,16} (25 cells)
// x 6 arms (fixed lazy, fixed eager, adaptive with L in {0,1,3,7})
// = 150 episodes, each emitting one CELL line. Arrivals are bursty and
// irregular (seeded per cell, identical across arms); relation/object
// ids arrive via the rb_* accessors; no world literals appear here.
fn nr_L(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 3; }
  return 7;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let mi:i32=0;
  while(mi<5){
    let M:i32=ld_grid(mi);
    let ni:i32=0;
    while(ni<5){
      let N:i32=ld_grid(ni);
      c=nr_episode(B,c,M,N,0,-1,ra,oa1);
      c=nr_episode(B,c,M,N,1,-1,ra,oa1);
      let li:i32=0;
      while(li<4){
        c=nr_episode(B,c,M,N,2,nr_L(li),ra,oa1);
        li=li+1;
      }
      ni=ni+1;
    }
    mi=mi+1;
  }
  o_flush(B,c);
  return 0;
}

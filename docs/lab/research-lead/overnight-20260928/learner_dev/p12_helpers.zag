
// ===== P12 helpers: developmental-language episode =====
// OpScope learner state lives in the slice W[2048..10448] (8400 bytes).

fn p12_dump_oprec(OW:[]u8)void {
  emit("P12_OPREC_TABLE:\n");
  let k:i32=0;
  while(k<8){
    let b:i32=5616+k*24;
    emit(" k="); emit(i32s(k));
    emit(" trig="); emit(i32s(get32(OW,b)));
    emit(" scope="); emit(i32s(get32(OW,b+4)));
    emit(" sig="); emit(i32s(get32(OW,b+8)));
    emit(" sup="); emit(i32s(get32(OW,b+12)));
    emit(" created="); emit(i32s(get32(OW,b+16)));
    emit(" active="); emit(i32s(get32(OW,b+20)));
    emit("\n");
    k=k+1;
  }
  return;
}

fn p12_dump_diag(OW:[]u8, D:[]u8)void {
  emit("P12_DIAG w epc reclen sup mtch div cs cb gate\n");
  let w:i32=0;
  while(w<12){
    let b:i32=w*32;
    let sup:i32=get32(D,b+8);
    if(sup>0){
      emit(" "); emit(i32s(w));
      emit(" "); emit(i32s(get32(D,b)));
      emit(" "); emit(i32s(get32(D,b+4)));
      emit(" "); emit(i32s(sup));
      emit(" "); emit(i32s(get32(D,b+12)));
      emit(" "); emit(i32s(get32(D,b+16)));
      emit(" "); emit(i32s(get32(D,b+20)));
      emit(" "); emit(i32s(get32(D,b+24)));
      emit(" "); emit(i32s(get32(D,b+28)));
      emit("\n");
    }
    w=w+1;
  }
  return;
}

// ff_scal_timed.zag -- timed workload drivers for the scaling analysis.
// Training halves copied verbatim from ff_driver.zag (ff_r4b_test /
// ff_r4c_test); the Z queries below replicate ev_query's exact prefix
// (header bump, decay, ctx_push, activate, rebind_try) then call
// compose_try directly and stop, isolating the O(4096) scan pattern
// from the frozen post-decline pipeline (mp_run, bootstrap_miss,
// miss_inquire). No new output helpers; emit/e64 only.

// ---- W-R4B training (verbatim from ff_r4b_test, minus the Z query) ----
fn scal_r4b_train(W:[]u8)void {
  emit("=== R4B-DECLINE-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ff_train1(W,idx,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  emit("R4B facts+maps="); e64(idx); emit(" TRAINING-DONE\n");
  return;
}

// ---- W-R4C training (verbatim from ff_r4c_test, minus the Z query) ----
fn scal_r4c_train(W:[]u8)void {
  emit("=== R4C-SUCCESS-BLOWUP ===\n");
  let g:i32=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        ev_teach(W,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  ev_teach(W,9601,400,9008);
  let idx:i32=0;
  g=0;
  while(g<7){
    let a:i32=1;
    while(a<=2){
      let b:i32=1;
      while(b<=2){
        if(a!=1 || b!=1){
          ff_train1(W,idx,ff_lnode(g,a),ff_lrel(g,a,b),ff_lnode(g+1,b));
        }
        idx=idx+1;
        b=b+1;
      }
      a=a+1;
    }
    g=g+1;
  }
  g=0;
  while(g<7){
    ff_train1(W,idx,ff_lnode(g,1),ff_lrel(g,1,1),ff_lnode(g+1,1));
    idx=idx+1;
    g=g+1;
  }
  ff_train1(W,idx,9601,400,9008);
  emit("R4C facts+maps trained TRAINING-DONE\n");
  return;
}

// Timed decline/success query: ev_query's exact prefix, then
// compose_try directly. Returns compose_try's answer.
fn scal_decline(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  emit("TIMED-DECLINE-START\n");
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    emit("TIMED-ACTIVATE-HIT ans="); e64(ng(W,n,28)); emit("\n");
    return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=0;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    emit("TIMED-REBIND-HIT ans="); e64(ra); emit("\n");
    return ra;
  }
  let ca:i32=compose_try(W,s,r,expected,masked,rbs);
  emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  emit("TIMED-DECLINE-END ans="); e64(ca); emit("\n");
  return ca;
}

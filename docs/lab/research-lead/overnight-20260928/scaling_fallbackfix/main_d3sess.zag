// D3 session test: one summary shared across two back-to-back decline
// queries with no world mutation between them. Measures cross-query
// amortization of the mechanism-maintained summary.
fn scal_decline_s(W:[]u8,s:i32,r:i32,expected:i32,S:[]u8)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){ return ng(W,n,28); }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=0;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  if(ra!=-2){ return ra; }
  let ca:i32=compose_try_s(W,s,r,expected,masked,rbs,S);
  emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  return ca;
}
fn main()i32 {
  emit("SCAL-D3SESS-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  scal_r4b_train(W);
  let S:[]u8=s3_sum_alloc();
  emit("D3SESS-Q1-START\n");
  let a1:i32=scal_decline_s(W,9001,70,99999,S);
  emit("D3SESS-Q1-END ans="); e64(a1); emit(" rescans="); e64(s3_rescans(S)); emit("\n");
  emit("D3SESS-Q2-START\n");
  let a2:i32=scal_decline_s(W,9001,70,99999,S);
  emit("D3SESS-Q2-END ans="); e64(a2); emit(" rescans="); e64(s3_rescans(S)); emit("\n");
  if(a1==-2 && a2==-2){emit("D3SESS-RESULT=PASS\n");} else {emit("D3SESS-RESULT=FAIL\n");}
  emit("SCAL-D3SESS-END\n");
  return 0;
}

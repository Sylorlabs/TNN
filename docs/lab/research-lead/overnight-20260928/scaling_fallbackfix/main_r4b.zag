fn main()i32 {
  emit("SCAL-R4B-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  scal_r4b_train(W);
  emit("R4B-Z-START\n");
  let z:i32=scal_decline(W,9001,70,99999);
  emit("R4B-Z ans="); e64(z); emit("\n");
  if(z==-2){emit("R4B-RESULT=PASS-DECLINE\n");} else {emit("R4B-RESULT=FAIL\n");}
  emit("SCAL-R4B-END\n");
  return 0;
}

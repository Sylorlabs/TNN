// ff_patch_D2.zag -- SCALING-FALLBACKFIX design D2: lazy per-query
// memoization of pure subcomputations. Drop-in replacement for
// ff_patch.zag (same public names and signatures). The repaired logic
// (gated fallback, bounded branching, type-15 dedup) is unchanged.
//
// Per compose_try, two small memo tables (z_alloc, discarded after):
//   Memo E (64 slots @0, 48 bytes each: m,st,ln,ex,rels[8]): caches
//     cl_extract results. Extraction is cur-independent, so one lazy
//     fill serves every satisfy query for that fragment (all cur
//     values, the candidates pass plus the cl_dfs revalidation).
//   Memo P (64 slots @3072, 8 bytes each: m,pres): caches co-use
//     presence (whether any aux==0 type-15 edge leaves m), filled by
//     one 4096 scan per m on first need; presence 0 short-circuits
//     cb_has_couse to O(1).
// The cur-dependent plen fallback (t2_gather) is deliberately NOT
// memoized. Within one compose_try the store is unmutated on the DFS
// path (same no-write/delete case as D1), so cached values equal
// recomputation. Zero new edge types, tags, modes, semantic cases.
fn compose_on()i32 { return 1; }
fn cl_pk(s:i32,l:i32)i32 { return (s<<16)|l; }
fn cl_ps(a:i32)i32 { return a>>16; }
fn cl_pl(a:i32)i32 { return a&65535; }
// Lazy extraction memo: returns ex status, fills rels. Miss runs the
// baseline scan path once and stores it.
fn m2_ex(M:[]u8,W:[]u8,m:i32,st:i32,ln0:i32,rels:[]u8)i32 {
  let h:i32=(((m*33+st)*33+ln0)&63);
  let k:i32=0; let slot:i32=-1; let hit:i32=0;
  while(k<64 && hit==0 && slot<0){
    let b:i32=(h+k)&63; let so:i32=b*48;
    let sm:i32=get32(M,so);
    if(sm<2){slot=b;}
    else {
      if(sm==m && get32(M,so+4)==st && get32(M,so+8)==ln0){hit=1; slot=b;}
    }
    k=k+1;
  }
  if(hit==1){
    let so2:i32=slot*48;
    let ex:i32=get32(M,so2+12);
    let j:i32=0;
    while(j<8){set32(rels,j*4,get32(M,so2+16+j*4)); j=j+1;}
    return ex;
  }
  let ex2:i32=cl_extract(W,m,st,ln0,rels);
  if(slot>=0){
    let so3:i32=slot*48;
    set32(M,so3,m); set32(M,so3+4,st); set32(M,so3+8,ln0);
    set32(M,so3+12,ex2);
    let j2:i32=0;
    while(j2<8){set32(M,so3+16+j2*4,get32(rels,j2*4)); j2=j2+1;}
  }
  return ex2;
}
// Lazy co-use presence memo: 1 if any aux==0 type-15 edge leaves m.
fn m2_pres(M:[]u8,W:[]u8,m:i32)i32 {
  let h:i32=((m*37)&63);
  let k:i32=0; let slot:i32=-1; let hit:i32=0;
  while(k<64 && hit==0 && slot<0){
    let b:i32=(h+k)&63; let so:i32=3072+b*8;
    let sm:i32=get32(M,so);
    if(sm<2){slot=b;}
    else { if(sm==m){hit=1; slot=b;} }
    k=k+1;
  }
  if(hit==1){return get32(M,3072+slot*8+4);}
  let e:i32=0; let pr:i32=0;
  while(e<4096 && pr==0){
    if(eg(W,e,0)==m && eg(W,e,4)==15 && eg(W,e,12)==0){pr=1;}
    e=e+1;
  }
  if(slot>=0){
    set32(M,3072+slot*8,m);
    set32(M,3072+slot*8+4,pr);
  }
  return pr;
}
// DEP licensing fact of a SET cell, or -1. Verbatim scan.
fn dep_fact(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==c && eg(W,e,4)==1){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// Structural chain length of MAP m. Verbatim.
fn cl_chain_len(W:[]u8,m:i32)i32 {
  if(m<2 || m>=1024 || ng(W,m,36)!=1 || ng(W,m,0)!=20){return -1;}
  let cell:i32=ng(W,m,20); let n:i32=0; let exp:i32=102; let k:i32=0;
  while(k<200){
    if(cell<2 || cell>=1024 || ng(W,cell,36)!=1){return -1;}
    if(exp==102){
      if(ng(W,cell,0)!=102){return -1;}
      cell=ng(W,cell,12); exp=101;
    } else {
      if(ng(W,cell,0)!=101 || dep_fact(W,cell)<0){return -1;}
      n=n+1;
      if(n>7){return -1;}
      cell=seq_nx(W,cell);
      if(cell<0){return n;}
      exp=102;
    }
    k=k+1;
  }
  return -1;
}
// Write fragment mark (m,start,len), deduplicated. Verbatim.
fn cl_mark(W:[]u8,m:i32,start:i32,len:i32)i32 {
  if(start<0 || len<1){return -1;}
  let L:i32=cl_chain_len(W,m);
  if(L<0 || start+len>L){return -1;}
  let e:i32=0;
  while(e<4096){
    let a:i32=eg(W,e,12);
    if(eg(W,e,0)==m && eg(W,e,4)==15 && a!=0 && cl_ps(a)==start && cl_pl(a)==len){return e;}
    e=e+1;
  }
  let cell:i32=ng(W,m,20); let k:i32=0;
  while(k<start){
    cell=seq_nx(W,ng(W,cell,12));
    if(cell<0){return -1;}
    k=k+1;
  }
  if(ng(W,cell,0)!=102){return -1;}
  return link_edge(W,m,15,cell,cl_pk(start,len));
}
// Resolve mark and extract its relation sequence. Verbatim scan path;
// D2 memoizes it one level up in m2_ex.
fn cl_extract(W:[]u8,m:i32,start:i32,len:i32,rels:[]u8)i32 {
  let entry:i32=-1; let e:i32=0;
  while(e<4096 && entry<0){
    let a:i32=eg(W,e,12);
    if(eg(W,e,0)==m && eg(W,e,4)==15 && a!=0 && cl_ps(a)==start && cl_pl(a)==len){entry=eg(W,e,8);}
    e=e+1;
  }
  if(entry<0){return -1;}
  let cell:i32=entry; let i:i32=0;
  while(i<len){
    if(ng(W,cell,0)!=102){return -1;}
    let st:i32=ng(W,cell,12);
    if(ng(W,st,0)!=101){return -1;}
    let f:i32=dep_fact(W,st);
    if(f<0 || ng(W,f,0)!=1 || ng(W,f,36)!=1){return -1;}
    set32(rels,i*4,ng(W,f,24));
    cell=seq_nx(W,st);
    i=i+1;
  }
  return len;
}
// Walk an extracted relation sequence. Verbatim.
fn cl_walk(W:[]u8,cur:i32,rels:[]u8,len:i32,vals:[]u8,fids:[]u8)i32 {
  set32(vals,0,cur);
  let i:i32=0;
  while(i<len){
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),get32(rels,i*4));
    if(fnd<0){return -1;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return len;
}
// Tail of a pure chain graph: the last SET cell. Verbatim.
fn cc_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root; let tail:i32=-1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101){tail=cur; cur=seq_nx(W,cur);}
      else {cur=-2;}
    }
    steps=steps+1;
  }
  return tail;
}
// Write co-use LINK newM -> prevM (type 15, aux 0), deduplicated.
// Verbatim.
fn cb_couse_link(W:[]u8,newM:i32,prevM:i32)i32 {
  if(newM<0 || prevM<0 || newM==prevM){return 0;}
  if(ng(W,newM,0)!=20 || ng(W,prevM,0)!=20){return 0;}
  if(ng(W,newM,36)!=1 || ng(W,prevM,36)!=1){return 0;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==newM && eg(W,e,4)==15 && eg(W,e,12)==0 && eg(W,e,8)==prevM){return 0;}
    e=e+1;
  }
  link_edge(W,newM,15,prevM,0);
  return 1;
}
// newest live MAP id, -1 if none. Verbatim.
fn cb_newest_map(W:[]u8)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){return m;}
    m=m-1;
  }
  return -1;
}
// Co-use history over fragment triples, with presence memo: no
// co-use edges out of m means O(1) rejection.
fn cb_has_couse(W:[]u8,m:i32,used:[]u8,nused:i32,M:[]u8)i32 {
  if(m2_pres(M,W,m)==0){return 0;}
  let u:i32=0;
  while(u<nused){
    let pm:i32=get32(used,u*12); let e:i32=0;
    while(e<4096){
      if(eg(W,e,4)==15 && eg(W,e,12)==0 && eg(W,e,0)==m && eg(W,e,8)==pm){return 1;}
      e=e+1;
    }
    u=u+1;
  }
  return 0;
}
// Gated fragment satisfiability. Extraction via the lazy memo;
// walk and fallback verbatim.
fn cl_satisfy(W:[]u8,m:i32,start:i32,len:i32,cur:i32,vals:[]u8,fids:[]u8,kind:[]u8,M:[]u8)i32 {
  let rels:[]u8=z_alloc(32);
  let ex:i32=m2_ex(M,W,m,start,len,rels);
  if(ex<1){
    set32(kind,0,0);
    let p:i32=len+1;
    if(p<2 || p>8){return -1;}
    let paths:[]u8=z_alloc(4608); let np:i32=t2_gather(W,cur,paths); let i:i32=0;
    while(i<np){
      let base:i32=i*48;
      if(get32(paths,base)==p){
        let j:i32=0;
        while(j<p){set32(vals,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<p-1){set32(fids,j*4,get32(paths,base+24+j*4)); j=j+1;}
        set32(kind,0,2);
        return p-1;
      }
      i=i+1;
    }
    return -1;
  }
  let wl:i32=cl_walk(W,cur,rels,len,vals,fids);
  if(wl<1){set32(kind,0,0); return -1;}
  set32(kind,0,1);
  return wl;
}
// Candidate enumeration. Outer scan and ordering verbatim; satisfy
// and co-use take the memo.
fn cl_candidates(W:[]u8,cur:i32,used:[]u8,nused:i32,cm:[]u8,csb:[]u8,clb:[]u8,cob:[]u8,ckb:[]u8,base:i32,M:[]u8)i32 {
  let n:i32=0; let e:i32=0; let nfb:i32=0;
  while(e<4096 && n<32){
    let a:i32=eg(W,e,12);
    if(eg(W,e,4)==15 && a!=0){
      let m:i32=eg(W,e,0); let st:i32=cl_ps(a); let ln0:i32=cl_pl(a);
      let u:i32=0; let isused:i32=0;
      while(u<nused){
        if(get32(used,u*12)==m && get32(used,u*12+4)==st && get32(used,u*12+8)==ln0){isused=1;}
        u=u+1;
      }
      if(isused==0){
        let vb:[]u8=z_alloc(36); let fb:[]u8=z_alloc(32); let kb:[]u8=z_alloc(4);
        let ln:i32=cl_satisfy(W,m,st,ln0,cur,vb,fb,kb,M);
        let kd:i32=get32(kb,0);
        if(ln>=1 && (kd!=2 || nfb<4)){
          if(kd==2){nfb=nfb+1;}
          let co:i32=cb_has_couse(W,m,used,nused,M);
          let pos:i32=0; let found:i32=0;
          while(pos<n && found==0){
            let plo:i32=get32(clb,(base+pos)*4); let pco:i32=get32(cob,(base+pos)*4);
            let pki:i32=get32(ckb,(base+pos)*4);
            if(co>pco){found=1;}
            else {
              if(co==pco && kd<pki){found=1;}
              else {
                if(co==pco && kd==pki && ln>plo){found=1;}
                else {pos=pos+1;}
              }
            }
          }
          let s:i32=n;
          while(s>pos){
            set32(cm,(base+s)*4,get32(cm,(base+s-1)*4));
            set32(csb,(base+s)*4,get32(csb,(base+s-1)*4));
            set32(clb,(base+s)*4,get32(clb,(base+s-1)*4));
            set32(cob,(base+s)*4,get32(cob,(base+s-1)*4));
            set32(ckb,(base+s)*4,get32(ckb,(base+s-1)*4));
            s=s-1;
          }
          set32(cm,(base+pos)*4,m);
          set32(csb,(base+pos)*4,st);
          set32(clb,(base+pos)*4,ln);
          set32(cob,(base+pos)*4,co);
          set32(ckb,(base+pos)*4,kd);
          n=n+1;
        }
      }
    }
    e=e+1;
  }
  return n;
}
// Depth-first search over FRAG marks. Verbatim control flow; memo
// threaded through.
fn cl_dfs(W:[]u8,s:i32,expected:i32,oseg:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8,M:[]u8)i32 {
  let cm:[]u8=z_alloc(1024); let csb:[]u8=z_alloc(1024);
  let clb:[]u8=z_alloc(1024); let cob:[]u8=z_alloc(1024); let ckb:[]u8=z_alloc(1024);
  let ncand:[]u8=z_alloc(32); let candi:[]u8=z_alloc(32); let curval:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(ncand,0,cl_candidates(W,s,oseg,0,cm,csb,clb,cob,ckb,0,M));
  set32(candi,0,0);
  let L:i32=0; let done:i32=0; let nseg:i32=-1;
  while(L>=0 && done==0){
    if(get32(candi,L*4)>=get32(ncand,L*4)){
      L=L-1;
      if(L>=0){set32(candi,L*4,get32(candi,L*4)+1);}
    } else {
      let ci:i32=L*32+get32(candi,L*4);
      let m:i32=get32(cm,ci*4); let st:i32=get32(csb,ci*4); let ln0:i32=get32(clb,ci*4);
      let vbuf:[]u8=z_alloc(36); let fbuf:[]u8=z_alloc(32); let kb:[]u8=z_alloc(4);
      let ln:i32=cl_satisfy(W,m,st,ln0,get32(curval,L*4),vbuf,fbuf,kb,M);
      if(ln<1){
        set32(candi,L*4,get32(candi,L*4)+1);
      } else {
        set32(oseg,L*12,m); set32(oseg,L*12+4,st); set32(oseg,L*12+8,ln0);
        set32(olen,L*4,ln);
        let j:i32=0;
        while(j<=ln){set32(ovals,(L*8+j)*4,get32(vbuf,j*4)); j=j+1;}
        j=0;
        while(j<ln){set32(ofids,(L*7+j)*4,get32(fbuf,j*4)); j=j+1;}
        let nv:i32=get32(vbuf,ln*4);
        if(nv==expected){
          nseg=L+1;
          done=1;
        } else {
          if(L+1>=8){
            set32(candi,L*4,get32(candi,L*4)+1);
          } else {
            set32(curval,(L+1)*4,nv);
            set32(ncand,(L+1)*4,cl_candidates(W,nv,oseg,L+1,cm,csb,clb,cob,ckb,(L+1)*32,M));
            set32(candi,(L+1)*4,0);
            L=L+1;
          }
        }
      }
    }
  }
  return nseg;
}
// Collapsed composition for query (s,r,expected). Auto-mark verbatim;
// memo allocated here and threaded through the DFS. Success path
// verbatim.
fn compose_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(expected<0){return -2;}
  let am:i32=2;
  while(am<1024){
    if(ng(W,am,36)==1 && ng(W,am,0)==20){
      let al:i32=cl_chain_len(W,am);
      if(al>=1){cl_mark(W,am,0,al);}
    }
    am=am+1;
  }
  let M:[]u8=z_alloc(3584);
  let oseg:[]u8=z_alloc(96); let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224); let olen:[]u8=z_alloc(32);
  let nseg:i32=cl_dfs(W,s,expected,oseg,ovals,ofids,olen,M);
  if(nseg<1){
    emit("COMP-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(32); let g:i32=0; let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4); let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W,full,s,expected,masked,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(288); let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*12),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      cb_couse_link(W,get32(oseg,g*12),get32(oseg,(g-1)*12));
      g=g+1;
    }
  }
  emit("COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*12)); g=g+1;}
  emit("\n");
  return v2;
}
// ev_query with collapsed composition between rebind_try and trial.
// Verbatim pipeline.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// Chained query for co-use episodes. Verbatim.
fn ev_cq(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,chain:i32)i32 {
  let m0:i32=cb_newest_map(W); let ans:i32=ev_query(W,s,r,expected,flags);
  if(ans==-2){return -2;}
  let m1:i32=cb_newest_map(W);
  if(m1<0 || m1==m0){return ans;}
  if(chain==1){
    let prev:i32=hg(W,56);
    cb_couse_link(W,m1,prev);
  }
  hs(W,56,m1);
  return ans;
}

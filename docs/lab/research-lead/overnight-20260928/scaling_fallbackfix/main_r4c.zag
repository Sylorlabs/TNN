fn main()i32 {
  emit("SCAL-R4C-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  scal_r4c_train(W);
  emit("R4C-Z-START\n");
  let z:i32=scal_decline(W,9001,70,9008);
  emit("R4C-Z ans="); e64(z); emit("\n");
  if(z==9008){emit("R4C-RESULT=PASS\n");} else {emit("R4C-RESULT=FAIL\n");}
  emit("SCAL-R4C-END\n");
  return 0;
}

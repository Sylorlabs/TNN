// ma_driver.zag -- meta-applicability driver.
// Hooks (build.sh stamps per arm; verified by grep):
fn ma_use_gate()i32 { return 0; }
fn ma_do_phase1()i32 { return 1; }
// Teach an n-edge chain s -r0-> L+1 -r0-> ... -r0-> L+n. Returns endpoint.
fn ma_teach_chain(W:[]u8,s:i32,r0:i32,L:i32,n:i32)i32 {
  let prev:i32=s; let i:i32=1;
  while(i<=n){ev_teach(W,prev,r0,L+i); prev=L+i; i=i+1;}
  return L+n;
}
fn ma_stat(blk:[]u8,pi:i32,ST:[]u8,AP:[]u8,ans:i32,expect:i32)void {
  emit(blk); emit("-P"); e64(pi);
  emit(" gate="); e64(get32(ST,0));
  emit(" rb="); e64(get32(ST,4)); emit("/"); e64(get32(ST,8));
  emit(" trial="); e64(get32(ST,12));
  emit(" total="); e64(get32(ST,4)+get32(ST,12));
  emit(" ans="); e64(ans); emit(" exp="); e64(expect);
  if(ans==expect){emit(" OK");} else {emit(" WRONG");}
  emit(" nrec="); e64(get32(AP,32));
  emit(" wcx="); e64(get32(AP,24));
  emit("\n");
  return;
}
// Domain A / A-prime: true plen-5 (r1), decoy plen-4 (r1), decoy plen-3 (r1).
fn ma_probA(W:[]u8,AP:[]u8,blk:[]u8,pi:i32,s:i32,L:i32)void {
  ma_teach_chain(W,s,1,L,4);
  ma_teach_chain(W,s,1,L+10,3);
  ma_teach_chain(W,s,1,L+20,2);
  let ST:[]u8=z_alloc(16);
  let q:i32=ma_query(W,AP,s,5,L+4,0,ST);
  ma_stat(blk,pi,ST,AP,q,L+4);
  return;
}
// Domain B: true plen-3 (r1), decoy plen-5 (r1), decoy plen-2 (r1). Query r=6.
fn ma_probB(W:[]u8,AP:[]u8,blk:[]u8,pi:i32,s:i32,L:i32)void {
  ma_teach_chain(W,s,1,L,2);
  ma_teach_chain(W,s,1,L+10,4);
  ma_teach_chain(W,s,1,L+20,1);
  let ST:[]u8=z_alloc(16);
  let q:i32=ma_query(W,AP,s,6,L+2,0,ST);
  ma_stat(blk,pi,ST,AP,q,L+2);
  return;
}
// Domain C: true plen-4 (r1), decoy plen-5 (r1), decoy plen-3 (r2). Query r=5.
fn ma_probC(W:[]u8,AP:[]u8,blk:[]u8,pi:i32,s:i32,L:i32,save:i32)void {
  ma_teach_chain(W,s,1,L,3);
  ma_teach_chain(W,s,1,L+10,4);
  ma_teach_chain(W,s,2,L+20,2);
  let ST:[]u8=z_alloc(16);
  let q:i32=ma_query(W,AP,s,5,L+3,0,ST);
  ma_stat(blk,pi,ST,AP,q,L+3);
  if(save==1){
    let k:i32=0;
    while(k<8){set32(AP,1440+k*4,get32(AP,1400+k*4)); k=k+1;}
  }
  return;
}
fn ma_phaseA(W:[]u8,AP:[]u8)void {
  if(ma_do_phase1()==0){return;}
  ma_probA(W,AP,"A",0,101,1000);
  ma_probA(W,AP,"A",1,102,1500);
  ma_probA(W,AP,"A",2,103,2000);
  ma_probA(W,AP,"A",3,104,2500);
  return;
}
fn ma_phaseAP(W:[]u8,AP:[]u8)void {
  ma_probA(W,AP,"AP",0,201,3500);
  ma_probA(W,AP,"AP",1,202,4000);
  ma_probA(W,AP,"AP",2,203,4500);
  ma_probA(W,AP,"AP",3,204,5000);
  return;
}
fn ma_phaseB(W:[]u8,AP:[]u8)void {
  ma_probB(W,AP,"B",0,301,6000);
  ma_probB(W,AP,"B",1,302,6500);
  ma_probB(W,AP,"B",2,303,7000);
  ma_probB(W,AP,"B",3,304,7500);
  return;
}
fn ma_phaseC(W:[]u8,AP:[]u8)void {
  ma_probC(W,AP,"C",0,401,8500,1);
  ma_probC(W,AP,"C",1,402,9000,0);
  ma_probC(W,AP,"C",2,403,9500,0);
  ma_probC(W,AP,"C",3,404,10000,0);
  ma_probC(W,AP,"C",4,405,10500,0);
  return;
}
fn main()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let AP:[]u8=z_alloc(2048);
  appl_init(AP);
  emit("MA-START gate="); e64(ma_use_gate());
  emit(" phase1="); e64(ma_do_phase1()); emit("\n");
  ma_phaseA(W,AP);
  ma_phaseAP(W,AP);
  ma_phaseB(W,AP);
  ma_phaseC(W,AP);
  let SF:[]u8=AP[1440..1472];
  let rg:i32=appl_decide(AP,SF);
  emit("REPLAY-C0-finalW gate="); e64(rg);
  emit(" wcx="); e64(get32(AP,24)); emit("\n");
  emit("MA-END\n");
  return;
}

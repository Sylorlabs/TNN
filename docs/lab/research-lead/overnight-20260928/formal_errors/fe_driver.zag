// fe_driver.zag -- formal-error experiments.
// F1: relation purity of sums. r=70 facts + r=71 distractors, query r=72.
//     World rule: r=72 answers are sums of r=70 facts only.
// F2: structural form. r=61 facts, query r=60. World rule: r=60 is single-hop.
// F3: referential integrity. Chain MAP, eviction pressure, re-execution.
fn fe_phase_f1(W:[]u8)void {
  emit("F1-START\n");
  fe_mkcomb(W);
  let i:i32=0; let ok:i32=0;
  while(i<4){
    let s:i32=100+i;
    ev_teach(W,s,70,1); ev_teach(W,s,70,2); ev_teach(W,s,70,3);
    ev_teach(W,s,71,10);
    let a:i32=ev_query(W,s,72,6,0);
    emit("F1-TEACH "); e64(i); emit(" ans="); e64(a); fe_tstat(W);
    if(a==6){ok=ok+1;}
    i=i+1;
  }
  emit("F1-TEACH-OK "); e64(ok); emit("/4\n");
  let m70:i32=0; i=0;
  while(i<4){
    let mm:i32=fe_find_map(W,100+i,72);
    if(mm>=0 && fe_map_dep_mixed(W,mm,70)==0){m70=m70+1;}
    i=i+1;
  }
  emit("F1-PURE-MAPS "); e64(m70); emit("/4\n");
  let err:i32=0; i=0;
  while(i<4){
    let s:i32=200+i;
    ev_teach(W,s,70,4); ev_teach(W,s,70,5); ev_teach(W,s,70,6);
    ev_teach(W,s,71,10);
    let a:i32=ev_query(W,s,72,-2,1);
    let mm:i32=fe_find_map(W,s,72);
    let mx:i32=-1;
    if(mm>=0){mx=fe_map_dep_mixed(W,mm,70);}
    emit("F1-TEST "); e64(i); emit(" ans="); e64(a);
    emit(" mixed_deps="); e64(mx); fe_tstat(W);
    if(mx>0){err=err+1;}
    i=i+1;
  }
  emit("F1-ERR "); e64(err); emit("/4\n");
  emit("F1-END\n");
  return;
}
fn fe_phase_f2(W:[]u8)void {
  emit("F2-START\n");
  let i:i32=0; let ok:i32=0;
  while(i<10){
    let s:i32=300+i;
    ev_teach(W,s,61,10+i);
    let a:i32=ev_query(W,s,60,10+i,0);
    emit("F2-TEACH "); e64(i); emit(" ans="); e64(a); fe_tstat(W);
    if(a==10+i){ok=ok+1;}
    i=i+1;
  }
  emit("F2-TEACH-OK "); e64(ok); emit("/10\n");
  let sh:i32=0; i=0;
  while(i<10){
    let mm:i32=fe_find_map(W,300+i,60);
    if(mm>=0 && fe_cell_count(W,ng(W,mm,20))==2){sh=sh+1;}
    i=i+1;
  }
  emit("F2-SINGLEHOP-MAPS "); e64(sh); emit("/10\n");
  fe_mkcomb(W);
  let err:i32=0; let contra:i32=0; i=0;
  while(i<4){
    let s:i32=400+i;
    ev_teach(W,s,61,21+i); ev_teach(W,s,61,22+i); ev_teach(W,s,61,23+i);
    let a:i32=ev_query(W,s,60,-2,1);
    let mm:i32=fe_find_map(W,s,60);
    let cc:i32=-1;
    if(mm>=0){cc=fe_cell_count(W,ng(W,mm,20));}
    emit("F2-TEST "); e64(i); emit(" ans="); e64(a);
    emit(" cells="); e64(cc); fe_tstat(W);
    if(cc!=2){err=err+1;}
    let ob:i32=ev_observe(W,s,60,21+i);
    emit("F2-OBSERVE "); e64(i); emit(" res="); e64(ob); emit("\n");
    if(ob==0){contra=contra+1;}
    i=i+1;
  }
  emit("F2-ERR "); e64(err); emit("/4\n");
  emit("F2-CONTRADICT "); e64(contra); emit("/4\n");
  emit("F2-END\n");
  return;
}
fn fe_phase_f3(W:[]u8)void {
  emit("F3-START\n");
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let qa:i32=ev_query(W,1,50,14,0);
  emit("F3-TEACH ans="); e64(qa); fe_tstat(W);
  let mm:i32=fe_find_map(W,1,50);
  let root:i32=-1;
  if(mm>=0){root=ng(W,mm,20);}
  emit("F3-MAP "); e64(mm); emit(" root="); e64(root); emit("\n");
  let ok:i32=0; let k:i32=0;
  while(k<10){
    if(t2_exec(W,root,1)==14){ok=ok+1;}
    k=k+1;
  }
  emit("F3-MASTERY "); e64(ok); emit("/10\n");
  let ids:[]u8=z_alloc(64); let vals:[]u8=z_alloc(64);
  let nl:i32=fe_rec_lits(W,root,ids,vals);
  emit("F3-LITS "); e64(nl); emit("\n");
  let p:i32=0;
  while(p<1100){
    ev_teach(W,5000+p,60+(p-((p/10)*10)),6000+p);
    p=p+1;
  }
  emit("F3-PRESSURE-DONE\n");
  let bad:i32=fe_audit_lits(W,ids,vals,nl);
  emit("F3-VIOL "); e64(bad); emit("/"); e64(nl); emit("\n");
  let chk:i32=fe_check_graph(W,root);
  emit("F3-CHECK "); e64(chk); emit("\n");
  let re:i32=t2_exec(W,root,1);
  emit("F3-REEXEC "); e64(re); emit("\n");
  emit("F3-END\n");
  return;
}
fn main()i32 {
  emit("FE-ARM "); e64(fe_arm()); emit("\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); fe_phase_f1(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); fe_phase_f2(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); fe_phase_f3(W3);
  emit("FE-DONE\n");
  return 0;
}

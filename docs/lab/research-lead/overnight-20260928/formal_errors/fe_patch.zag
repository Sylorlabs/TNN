// fe_patch.zag -- formal-error treatments (unfrozen).
// Redefines t2_trial and t2_exec via last-definition-wins. The base is
// otherwise untouched. Three causal interventions, one per constraint:
//
// F1 (relation purity): t2_gather_sum_f filters sum facts to the relations
//   that the learner's own prior successful MAPs for the query relation
//   were built from (DEP provenance in learner state). Falls back to
//   unfiltered when no prior MAP exists.
// F2 (structural form): t2_trial tries single-hop candidates before sums
//   when the learner's MAPs for the query relation are majority single-hop
//   (2-cell graphs). Otherwise the base order is kept.
// F3 (referential integrity): t2_exec refuses (-999999) graphs that fail a
//   structural-integrity walk (dead/repurposed references, broken SEQ).
//   The liveness information is already in learner state; the base never
//   consults it before executing.

// fe_cell_count lives in fe_audit.zag (read-only helper, both arms).
// 1 if the learner's live MAPs for r are majority 2-cell single-hop graphs.
fn fe_r_singlehop(W:[]u8,r:i32)i32 {
  let nt:i32=0; let n2:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      nt=nt+1;
      if(fe_cell_count(W,ng(W,m,20))==2){n2=n2+1;}
    }
    m=m+1;
  }
  if(nt>=1 && n2*2>nt){return 1;}
  return 0;
}
// Collect distinct relations of facts that live MAPs for r depend on
// (DEP edges). Returns count, relations in buf (cap 16).
fn fe_r_sumrels(W:[]u8,r:i32,buf:[]u8)i32 {
  let nr:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
          let f:i32=eg(W,e,8);
          if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){
            let fr:i32=ng(W,f,24); let k:i32=0; let seen:i32=0;
            while(k<nr){if(get32(buf,k*4)==fr){seen=1;} k=k+1;}
            if(seen==0 && nr<16){set32(buf,nr*4,fr); nr=nr+1;}
          }
        }
        e=e+1;
      }
    }
    m=m+1;
  }
  return nr;
}
// Sum gather filtered to relations licensed by the learner's own prior
// MAPs for r. Unfiltered fallback when the learner has no MAP for r yet.
fn t2_gather_sum_f(W:[]u8,s:i32,r:i32,vals:[]u8,facts:[]u8)i32 {
  let rb:[]u8=z_alloc(64); let nr:i32=fe_r_sumrels(W,r,rb);
  let n:i32=0; let x:i32=2;
  while(x<1024 && n<12){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==s && ng(W,x,24)!=-999){
      let fr:i32=ng(W,x,24); let allow:i32=0;
      if(nr==0){allow=1;}
      else {let k:i32=0; while(k<nr){if(get32(rb,k*4)==fr){allow=1;} k=k+1;}}
      if(allow==1){
        set32(vals,n*4,ng(W,x,28)); set32(facts,n*4,x); n=n+1;
      }
    }
    x=x+1;
  }
  return n;
}
// Single-hop candidate block, extracted as a helper so the patched
// t2_trial can order it before sums when the relation's form is known.
fn t2_try_single(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let p:i32=0;
  while(p<np && ans==-2){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
      set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
      set32(f,0,get32(paths,base+24));
      let root:i32=t2_asm_chain(W,v,2,f);
      let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
      if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
    }
    p=p+1;
  }
  return ans;
}
// t2_trial with two learner-state consultations:
// (a) sums draw only from relations the learner's own MAPs for r used;
// (b) single hops are tried before sums when r's MAPs are single-hop.
// Verbatim body otherwise.
fn t2_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  let sh_first:i32=fe_r_singlehop(W,r);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let p:i32=0;
      while(p<np && ans==-2){
        let base:i32=p*48;
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,k+1,f);
          let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
        }
        p=p+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && sh_first==1){
    ans=t2_try_single(W,s,r,expected,masked,paths,np,st);
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum_f(W,s,r,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        if(popcnt(mask)==sz){
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          let root:i32=t2_asm_sum(W,sv,c);
          let v2:i32=t2_try_verify(W,root,0,expected,masked,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        let root:i32=t2_asm_count(W,v,len,f);
        let v2:i32=t2_try_verify(W,root,s,expected,masked,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2 && sh_first==0){
    ans=t2_try_single(W,s,r,expected,masked,paths,np,st);
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}
// ---- F3: structural integrity before execution ----
// Original t2_exec body, renamed.
fn t2_exec_raw(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return -999999;}
  let fr:i32=alloc_node(W); if(fr<0){return -999999;}
  ns(W,fr,0,902); fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  if(execute(W,root,fr)!=1){return -999999;}
  return res_op(W,fr,ng(W,root,4));
}
// fe_check_graph lives in fe_audit.zag (read-only, both arms).
// t2_exec with an integrity precondition. Corrupted graphs are refused
// instead of blindly executed.
fn t2_exec(W:[]u8,root:i32,s0:i32)i32 {
  if(root<0){return -999999;}
  if(fe_check_graph(W,root)==0){emit("FE-INTEGRITY-REFUSE\n"); return -999999;}
  return t2_exec_raw(W,root,s0);
}

// arm marker override: treatment.
fn fe_arm()i32 { return 1; }

// fe_audit.zag -- read-only audit helpers for the formal-error worker.
// No behavior change. Included in both control and treatment builds.
// The treatment patch (fe_patch.zag) is concatenated after this file.

// count cells walking SEQ + guard true-targets. -1 if malformed.
fn fe_cell_count(W:[]u8,root:i32)i32 {
  let n:i32=0; let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<2048){
    if(cur<2 || cur>=1024 || ng(W,cur,36)!=1){return -1;}
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){return -1;}
    n=n+1;
    if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  return n;
}
// newest live MAP node for (s,r), or -1.
fn fe_find_map(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){best=m;}
    m=m+1;
  }
  return best;
}
// count DEP (type 1) edges from MAP m to live facts whose relation != r.
fn fe_map_dep_mixed(W:[]u8,m:i32,r:i32)i32 {
  let mixed:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1 && ng(W,f,24)!=r){
        mixed=mixed+1;
      }
    }
    e=e+1;
  }
  return mixed;
}
// record the literal node ids and values of a pure chain graph.
// Returns literal count. Assumes guard->set->SEQ... form.
fn fe_rec_lits(W:[]u8,root:i32,ids:[]u8,vals:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<2048){
    if(cur<2 || cur>=1024 || ng(W,cur,36)!=1){return -1;}
    let tag:i32=ng(W,cur,0);
    if(tag!=102){return -1;}
    let lx:i32=ng(W,cur,8);
    set32(ids,n*4,lx);
    if(lx>=2 && lx<1024){set32(vals,n*4,ng(W,lx,20));} else {set32(vals,n*4,-1);}
    n=n+1;
    cur=ng(W,cur,12);
    if(cur<2 || cur>=1024 || ng(W,cur,36)!=1){return -1;}
    let ly:i32=ng(W,cur,8);
    set32(ids,n*4,ly);
    if(ly>=2 && ly<1024){set32(vals,n*4,ng(W,ly,20));} else {set32(vals,n*4,-1);}
    n=n+1;
    cur=seq_nx(W,cur);
    steps=steps+1;
  }
  return n;
}
// audit recorded literals: count dead or repurposed (tag/value changed).
fn fe_audit_lits(W:[]u8,ids:[]u8,vals:[]u8,n:i32)i32 {
  let bad:i32=0; let i:i32=0;
  while(i<n){
    let id:i32=get32(ids,i*4); let v0:i32=get32(vals,i*4);
    if(id<2 || id>=1024 || ng(W,id,36)!=1){bad=bad+1;}
    else {
      if(ng(W,id,0)!=902 || ng(W,id,20)!=v0){bad=bad+1;}
    }
    i=i+1;
  }
  return bad;
}
// create the comb (tag 8) node that enables sum candidates.
fn fe_mkcomb(W:[]u8)void {
  let cn:i32=alloc_node(W); ns(W,cn,0,8); write_node(W,cn,1,0,0,0); return;
}
// trial stats from header field 16.
fn fe_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}

// arm marker: 0 = control (no patch), 1 = treatment (patch applied).
fn fe_arm()i32 { return 0; }
// 1 if the graph is structurally intact: every visited cell live with a
// valid ISA tag, every literal/slot reference live, every guard
// true-target live, SEQ walk terminates. 0 otherwise.
fn fe_check_graph(W:[]u8,root:i32)i32 {
  if(root<2 || root>=1024 || ng(W,root,36)!=1){return 0;}
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<2048){
    if(cur<2 || cur>=1024 || ng(W,cur,36)!=1){return 0;}
    let tag:i32=ng(W,cur,0);
    if(tag==102){
      let lx:i32=ng(W,cur,8); let tt:i32=ng(W,cur,12);
      if(lx<2 || lx>=1024 || ng(W,lx,36)!=1){return 0;}
      if(tt<2 || tt>=1024 || ng(W,tt,36)!=1){return 0;}
      cur=tt;
    } else {
      if(tag==101){
        let ly:i32=ng(W,cur,8);
        if(ly>=0 && ly<1000 && (ly<2 || ly>=1024 || ng(W,ly,36)!=1)){return 0;}
      } else {
        if(tag!=103 && tag!=104){return 0;}
      }
      cur=seq_nx(W,cur);
    }
    steps=steps+1;
  }
  if(cur!=-1){return 0;}
  return 1;
}

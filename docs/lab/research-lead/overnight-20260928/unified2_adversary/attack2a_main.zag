// X-U2-2a attack main: poison-first ordering (quarantine DoS).
// Feed interference FIRST, then legitimate episodes.
// Downgrade iff legitimate episodes are quarantined AND poison is asserted.

fn main()i32 {
  emit("=== X-U2-2a: poison-first ordering ===\n");
  let W:[]u8=z_alloc(65536);
  set32(W, ST_STR(), STR0());

  // poison first: no active rules, so coherent -> committed
  let rp:i32=route_line("1,0,0>9,9;1,0,0>9,9");
  let ncp:i32=-1;
  if(rp==2){ ncp=handle_caus_learn(W,"1,0,0>9,9;1,0,0>9,9"); }
  emit("poison route=");
  emit(i32s(rp));
  emit(" committed=");
  emit(i32s(ncp));
  emit(" active=");
  emit(i32s(caus_active_count(W,CBASE())));
  emit("\n");

  // legitimate episodes arrive second
  let rl:i32=route_line("1,0,0>1,0;1,0,0>1,0");
  let ncl:i32=-1;
  let q0:i32=get32(W, QCOUNT());
  if(rl==2){ ncl=handle_caus_learn(W,"1,0,0>1,0;1,0,0>1,0"); }
  let q1:i32=get32(W, QCOUNT());
  emit("legit route=");
  emit(i32s(rl));
  emit(" committed=");
  emit(i32s(ncl));
  emit(" quarantined=");
  emit(i32s(q1-q0));
  emit("\n");

  let qa:[]u8=z_alloc(2);
  let pr:i32=cpredict(W,CBASE(),1,0,0,qa);
  let ans:i32=-1;
  if(pr==1){ ans=(qa[1] as i32); }
  emit("cpredict(1,0,0) -> s1=");
  emit(i32s(ans));
  emit("\n");

  if(rl==2 && ncl==0 && (q1-q0)==2 && pr==1 && ans==9){
    emit("X-U2-2a RESULT: DOWNGRADE DEMONSTRATED: legitimate truth quarantined, poison s1=9 asserted permanently\n");
    return 2;
  }
  emit("X-U2-2a RESULT: no ordering exploit (unexpected)\n");
  return 0;
}

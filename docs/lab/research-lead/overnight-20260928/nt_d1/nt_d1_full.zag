// nt_d1_full.zag -- NT-D1: preserve evidence across eviction/re-insertion.
// Pure Zag. No Python.
//
// Subject: NT2's minimal continuing learner (entry-local error-driven
// evidence revision) with CAP=30 and eviction ACTIVE, plus the D1 rule:
// when a key is evicted and later re-inserted, RESTORE its prior
// (sup, ref, value) instead of starting fresh (sup=1, ref=0).
// This attacks the eviction-reinsertion reset that H3 (C416) identified
// as the actual breaking interaction under lowest-net eviction.
// Frozen rules: PREREG.md Section 2. Frozen numeric inventory:
// PREREG.md Section 3. Frozen protocol: PREREG.md Section 4.
// Pigeonhole-derived kill bars: PREREG.md Section 5.
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
//
// Learner arena layout (bytes):
//   0: nentries   4: nevict (capacity)   8: nalias (alias overwrite)
//   12: slots, 30 * 16 bytes: 0:key 1:value 2:sup 3:ref
//   492: evhist, 40 * 4 bytes (per-key eviction counts, keys 100..139)
//   652: D1 checkpoint table, 40 * 16 bytes: 0:valid 1:value 2:sup 3:ref

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner ----
fn nt_new()[]u8 { return z_alloc(2048); }
fn sk(L:[]u8,s:i32,f:i32)i32 { return get32(L,12+s*16+f*4); }
fn sp(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,12+s*16+f*4,v); return; }
// D1 checkpoint table accessors: 40 entries at 652, 16 bytes each
fn ck_get(L:[]u8,k:i32,f:i32)i32 { return get32(L,652+(k-100)*16+f*4); }
fn ck_set(L:[]u8,k:i32,f:i32,v:i32)void { set32(L,652+(k-100)*16+f*4,v); return; }
// ML0 address map (NT1 verbatim): overlapping, novel keys alias U slots
fn nt_slotmap(key:i32)i32 {
  if(key<124){ return key-100; }
  return key-116;
}
// find: arm 1 = ML0 fixed map; arm 0 = ML1 associative scan (no aliasing)
fn nt_find(L:[]u8,key:i32,arm:i32)i32 {
  if(arm==1){
    let m:i32=nt_slotmap(key);
    if(sk(L,m,0)==key){ return m; }
    return -1;
  }
  let s:i32=0;
  while(s<30){
    if(sk(L,s,0)==key){ return s; }
    s=s+1;
  }
  return -1;
}
fn nt_first_empty(L:[]u8)i32 {
  let s:i32=0;
  while(s<30){
    if(sk(L,s,0)==0){ return s; }
    s=s+1;
  }
  return -1;
}
// eviction rule (NT1 verbatim): globally lowest (sup - ref), ties to
// lowest slot index. Generic: entry-local counters only.
fn nt_evict_lowest(L:[]u8)i32 {
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<30){
    if(sk(L,s,0)!=0){
      let net:i32=sk(L,s,2)-sk(L,s,3);
      if(best<0){ best=s; bv=net; }
      else { if(net<bv){ best=s; bv=net; } }
    }
    s=s+1;
  }
  return best;
}
// D1 insertion: restore the key's checkpointed evidence if valid,
// then run the frozen update step with the taught value; else insert
// fresh (key, value, sup=1, ref=0) exactly as before.
fn nt_insert(L:[]u8,s:i32,key:i32,val:i32)void {
  if(ck_get(L,key,0)==1){
    sp(L,s,0,key);
    sp(L,s,1,ck_get(L,key,1));
    sp(L,s,2,ck_get(L,key,2));
    sp(L,s,3,ck_get(L,key,3));
  } else {
    sp(L,s,0,key); sp(L,s,1,val); sp(L,s,2,1); sp(L,s,3,0);
    return;
  }
  let v:i32=sk(L,s,1);
  if(v==val){ sp(L,s,2,sk(L,s,2)+1); return; }
  let r:i32=sk(L,s,3)+1;
  sp(L,s,3,r);
  if(r>sk(L,s,2)){ sp(L,s,1,val); sp(L,s,2,1); sp(L,s,3,0); }
  return;
}
fn nt_learn(L:[]u8,key:i32,val:i32,arm:i32)void {
  let s:i32=nt_find(L,key,arm);
  if(s>=0){
    let v:i32=sk(L,s,1);
    if(v==val){ sp(L,s,2,sk(L,s,2)+1); }
    else {
      let r:i32=sk(L,s,3)+1;
      sp(L,s,3,r);
      if(r>sk(L,s,2)){ sp(L,s,1,val); sp(L,s,2,1); sp(L,s,3,0); }
    }
  } else {
    if(arm==0){
      if(get32(L,0)>=30){
        let e:i32=nt_evict_lowest(L);
        set32(L,4,get32(L,4)+1);
        let hk:i32=sk(L,e,0);
        let ho:i32=492+(hk-100)*4;
        set32(L,ho,get32(L,ho)+1);
        // D1: checkpoint the victim's evidence before the slot is reused
        ck_set(L,hk,0,1);
        ck_set(L,hk,1,sk(L,e,1));
        ck_set(L,hk,2,sk(L,e,2));
        ck_set(L,hk,3,sk(L,e,3));
        s=e;
      } else {
        s=nt_first_empty(L);
        set32(L,0,get32(L,0)+1);
      }
    } else {
      s=nt_slotmap(key);
      if(sk(L,s,0)==0){ set32(L,0,get32(L,0)+1); }
      else { set32(L,8,get32(L,8)+1); }
    }
    nt_insert(L,s,key,val);
  }
  return;
}
// ---- oracle: frozen numeric inventory (PREREG Section 3, NT1 verbatim) ----
fn va(k:i32)i32 {
  let t:i32=k*37+11;
  return 200+(t-(t/64)*64);
}
fn vb(k:i32)i32 {
  let c:i32=0;
  if(k>=100){ if(k<=105){ c=1; } }
  if(c==1){
    let b:i32=va(k)-200+32;
    return 200+(b-(b/64)*64);
  }
  return va(k);
}
fn valof(k:i32,vf:i32)i32 {
  if(vf==0){ return va(k); }
  return vb(k);
}
// ---- protocol ----
fn teach_pass(L:[]u8,set:i32,vf:i32,arm:i32)void {
  let k:i32=0;
  if(set==0){
    k=100;
    while(k<=123){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
  } else {
    k=100;
    while(k<=111){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
    k=128;
    while(k<=139){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
  }
  return;
}
fn probe_acc(L:[]u8,set:i32,vf:i32,arm:i32)i32 {
  let n:i32=0;
  let k:i32=0;
  if(set==0){
    k=100;
    while(k<=123){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
  } else {
    k=100;
    while(k<=111){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
    k=128;
    while(k<=139){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
  }
  return n;
}
// C partition: keys 100..105, correct answer vb
fn probe_c(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){ if(nt_predict(L,k,arm)==vb(k)){ n=n+1; } k=k+1; }
  return n;
}
// NC partition: keys 106..111, correct answer va (=vb)
fn probe_nc(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=106;
  while(k<=111){ if(nt_predict(L,k,arm)==va(k)){ n=n+1; } k=k+1; }
  return n;
}
// U partition: keys 112..123, correct answer va
fn probe_u(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=112;
  while(k<=123){ if(nt_predict(L,k,arm)==va(k)){ n=n+1; } k=k+1; }
  return n;
}
// FORGET: A-keys answering neither the A-correct nor (C) the B-correct value
fn forget_count(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){
    let p:i32=nt_predict(L,k,arm);
    if(p!=va(k)){ if(p!=vb(k)){ n=n+1; } }
    k=k+1;
  }
  k=106;
  while(k<=123){
    if(nt_predict(L,k,arm)!=va(k)){ n=n+1; }
    k=k+1;
  }
  return n;
}
// train SET_A/VA to criterion; returns passes (negative = fail-safe hit)
fn train_a(L:[]u8,arm:i32)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teach_pass(L,0,0,arm);
    p=p+1;
    if(probe_acc(L,0,0,arm)==24){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// train SET_B/VB to criterion; out[0]=TTC, out[4]=P_C (passes until C correct)
fn train_b(L:[]u8,arm:i32,out:[]u8)i32 {
  let consec:i32=0;
  let p:i32=0;
  let pc:i32=-1;
  while(consec<2){
    if(p>=50){ set32(out,0,0-p); set32(out,4,pc); return 0-p; }
    teach_pass(L,1,1,arm);
    p=p+1;
    if(probe_c(L,arm)==6){ if(pc<0){ pc=p; } }
    if(probe_acc(L,1,1,arm)==24){ consec=consec+1; } else { consec=0; }
  }
  set32(out,0,p);
  set32(out,4,pc);
  return p;
}
// fixed-pass B training (pressure protocol: criterion may be unreachable)
fn teach_b_fixed(L:[]u8,arm:i32,p:i32)void {
  let i:i32=0;
  while(i<p){ teach_pass(L,1,1,arm); i=i+1; }
  return;
}
fn nt_predict(L:[]u8,key:i32,arm:i32)i32 {
  let s:i32=nt_find(L,key,arm);
  if(s<0){ return -1; }
  let sup:i32=sk(L,s,2);
  let rf:i32=sk(L,s,3);
  if(sup>rf){ return sk(L,s,1); }
  return -1;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let out:[]u8=z_alloc(8);
  // ---- CONTROL-A (ML1): A learnable in isolation under CAP ----
  let L:[]u8=nt_new();
  let tta_c:i32=train_a(L,0);
  let pa_c:i32=probe_acc(L,0,0,0);
  let ne_ca:i32=get32(L,4);
  c=o_app(B,c,"NT2 ML1 CTRLA ttc=");
  c=o_i64(B,c,tta_c as i64);
  c=o_app(B,c," acc=");
  c=o_i64(B,c,pa_c as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne_ca as i64);
  c=o_nl(B,c);
  // ---- CONTROL-B (ML1): B learnable in isolation under CAP ----
  L=nt_new();
  let ttb_c:i32=train_b(L,0,out);
  let pc_c:i32=get32(out,4);
  let pb_c:i32=probe_acc(L,1,1,0);
  let ne_cb:i32=get32(L,4);
  c=o_app(B,c,"NT2 ML1 CTRLB ttc=");
  c=o_i64(B,c,ttb_c as i64);
  c=o_app(B,c," pc=");
  c=o_i64(B,c,pc_c as i64);
  c=o_app(B,c," acc=");
  c=o_i64(B,c,pb_c as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne_cb as i64);
  c=o_nl(B,c);
  // ---- SEQ (ML1): A -> criterion, 6 fixed B passes, retest A ----
  L=nt_new();
  let tta_s:i32=train_a(L,0);
  let pa_s:i32=probe_acc(L,0,0,0);
  teach_b_fixed(L,0,6);
  let pb_s:i32=probe_acc(L,1,1,0);
  let c_vb:i32=probe_c(L,0);
  let nc:i32=probe_nc(L,0);
  let uu:i32=probe_u(L,0);
  let fg:i32=forget_count(L,0);
  let ne1:i32=get32(L,4);
  let nn1:i32=get32(L,0);
  c=o_app(B,c,"NT2 ML1 SEQ ttcA=");
  c=o_i64(B,c,tta_s as i64);
  c=o_app(B,c," accA=");
  c=o_i64(B,c,pa_s as i64);
  c=o_app(B,c," accB=");
  c=o_i64(B,c,pb_s as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne1 as i64);
  c=o_app(B,c," nentries=");
  c=o_i64(B,c,nn1 as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"NT2 ML1 RETEST c_vb=");
  c=o_i64(B,c,c_vb as i64);
  c=o_app(B,c," nc=");
  c=o_i64(B,c,nc as i64);
  c=o_app(B,c," u=");
  c=o_i64(B,c,uu as i64);
  c=o_app(B,c," forget=");
  c=o_i64(B,c,fg as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"NT2 ML1 EVHIST");
  let ek:i32=100;
  while(ek<=139){
    let hc:i32=get32(L,492+(ek-100)*4);
    if(hc>0){
      c=o_app(B,c," ");
      c=o_i64(B,c,ek as i64);
      c=o_app(B,c,"=");
      c=o_i64(B,c,hc as i64);
    }
    ek=ek+1;
  }
  c=o_nl(B,c);
  // ---- ABLATION (ML0): identical protocol, overlapping addresses ----
  L=nt_new();
  let tta_a:i32=train_a(L,1);
  teach_b_fixed(L,1,6);
  let pb_a:i32=probe_acc(L,1,1,1);
  let c_vb_a:i32=probe_c(L,1);
  let nc_a:i32=probe_nc(L,1);
  let uu_a:i32=probe_u(L,1);
  let fg_a:i32=forget_count(L,1);
  let ne0:i32=get32(L,4);
  let na0:i32=get32(L,8);
  let nn0:i32=get32(L,0);
  c=o_app(B,c,"NT2 ML0 ABL ttcA=");
  c=o_i64(B,c,tta_a as i64);
  c=o_app(B,c," accB=");
  c=o_i64(B,c,pb_a as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne0 as i64);
  c=o_app(B,c," nalias=");
  c=o_i64(B,c,na0 as i64);
  c=o_app(B,c," nentries=");
  c=o_i64(B,c,nn0 as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"NT2 ML0 RETEST c_vb=");
  c=o_i64(B,c,c_vb_a as i64);
  c=o_app(B,c," nc=");
  c=o_i64(B,c,nc_a as i64);
  c=o_app(B,c," u=");
  c=o_i64(B,c,uu_a as i64);
  c=o_app(B,c," forget=");
  c=o_i64(B,c,fg_a as i64);
  c=o_nl(B,c);
  // ---- frozen kill bars (flag-let style: nesting at most 3) ----
  let k1a:i32=0;
  if(tta_c>0){ if(tta_c<=50){ if(pa_c==24){ k1a=1; } } }
  let k1b:i32=0;
  if(ttb_c>0){ if(ttb_c<=50){ if(pb_c==24){ k1b=1; } } }
  let k1c:i32=0;
  if(tta_s>0){ if(tta_s<=50){ if(pa_s==24){ k1c=1; } } }
  let k1:i32=0;
  if(k1a==1){ if(k1b==1){ if(k1c==1){ k1=1; } } }
  let k2:i32=0;
  if(ne1==36){ k2=1; }
  let k3:i32=0;
  if(nc==6){ if(uu==12){ k3=1; } }
  let k4:i32=0;
  if(c_vb>=5){ if(fg==0){ k4=1; } }
  let k5:i32=0;
  if(uu_a==0){ if(ne0==0){ if(na0==12){ if(ne1!=ne0){ k5=1; } } } }
  c=o_app(B,c,"NT2 K1=");
  c=o_i64(B,c,k1 as i64);
  c=o_app(B,c," K2=");
  c=o_i64(B,c,k2 as i64);
  c=o_app(B,c," K3=");
  c=o_i64(B,c,k3 as i64);
  c=o_app(B,c," K4=");
  c=o_i64(B,c,k4 as i64);
  c=o_app(B,c," K5=");
  c=o_i64(B,c,k5 as i64);
  c=o_nl(B,c);
  let vab:i32=0;
  if(k1==1){ if(k2==1){ vab=1; } }
  let vcd:i32=0;
  if(k3==1){ if(k4==1){ vcd=1; } }
  let vd:i32=0;
  if(vab==1){ if(vcd==1){ if(k5==1){ vd=1; } } }
  c=o_app(B,c,"NT2 VERDICT=");
  if(vd==1){ c=o_app(B,c,"PASS"); }
  else {
    if(k1==0){ c=o_app(B,c,"VOID"); }
    else { if(k5==0){ c=o_app(B,c,"INCONCLUSIVE"); } else { c=o_app(B,c,"FAIL"); } }
  }
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

fn pro_edge_live(W:[]u8,a:i32,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==9 && eg(W,e,0)==a && eg(W,e,8)==c && eg(W,e,12)>0){return e;}
    e=e+1;
  }
  return -1;
}
fn protect_one(W:[]u8,m:i32,c:i32)void {
  if(c<2){return;}
  if(ng(W,c,36)!=1){return;}
  let t:i32=ng(W,c,0);
  let ok:i32=0;
  if(t==101){ok=1;} if(t==102){ok=1;} if(t==103){ok=1;} if(t==104){ok=1;} if(t==902){ok=1;}
  if(ok==0){return;}
  let e:i32=pro_edge_live(W,m,c);
  if(e>=0){es(W,e,12,hg(W,4)); return;}
  link_edge(W,m,9,c,hg(W,4));
  return;
}
fn protect_cells(W:[]u8,m:i32)void {
  if(m<2){return;}
  if(ng(W,m,36)!=1){return;}
  if(ng(W,m,0)!=20){return;}
  let root:i32=ng(W,m,20);
  if(root<2){return;}
  if(ng(W,root,36)!=1){return;}
  let seen:[]u8=z_alloc(512);
  let st:[]u8=z_alloc(512);
  let nseen:i32=0; let nst:i32=1;
  set32(st,0,root);
  while(nst>0){
    nst=nst-1;
    let c:i32=get32(st,nst*4);
    let already:i32=0; let k:i32=0;
    while(k<nseen){if(get32(seen,k*4)==c){already=1;} k=k+1;}
    if(already==0){
      if(c>=2 && c<1024 && ng(W,c,36)==1){
        if(nseen<128){set32(seen,nseen*4,c); nseen=nseen+1;}
        protect_one(W,m,c);
        let nx:i32=seq_nx(W,c);
        if(nx>=2 && nx<1024 && nst<128){set32(st,nst*4,nx); nst=nst+1;}
        let tg2:i32=ng(W,c,0);
        if(tg2==101 || tg2==102){
          let op8:i32=ng(W,c,8);
          if(op8>=2 && op8<1024 && nst<128){set32(st,nst*4,op8); nst=nst+1;}
        }
        if(tg2==102){
          let tt:i32=ng(W,c,12); let ff:i32=ng(W,c,16);
          if(tt>=2 && tt<1024 && nst<128){set32(st,nst*4,tt); nst=nst+1;}
          if(ff>=2 && ff<1024 && nst<128){set32(st,nst*4,ff); nst=nst+1;}
        }
      }
    }
  }
  return;
}
fn protect_map_use(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){
      protect_cells(W,m);
      return;
    }
    m=m+1;
  }
  return;
}

// mli_debug.zag -- inspect MAPs after P1 in Arm C
fn dbg_maps(W:[]u8)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("MAP m="); e64(m);
      emit(" s="); e64(ng(W,m,8));
      emit(" r="); e64(ng(W,m,4));
      emit(" root="); e64(ng(W,m,20));
      let plen:i32=rb_chain_plen(W,ng(W,m,20));
      emit(" plen="); e64(plen); emit("\n");
    }
    m=m+1;
  }
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("DBG-START\n");
  ev_teach(W,2,1,21); ev_teach(W,21,1,22);
  let a1:i32=ev_query(W,2,51,22,0);
  emit("DECOY ans="); e64(a1); emit("\n");
  dbg_maps(W);
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a2:i32=ev_query(W,1,50,14,0);
  emit("MAIN ans="); e64(a2); emit("\n");
  dbg_maps(W);
  emit("DBG-END\n");
  return 0;
}

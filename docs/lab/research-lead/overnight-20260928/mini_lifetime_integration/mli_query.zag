// mli_query.zag -- merged ev_query for Arm C (mini-lifetime integration).
// Combines, in order:
//   1. substrate withhold read (PURSUIT consec_fail >= 3 -> WITHHOLD -3)
//   2. structural rebind scan (rebind_try before blind trial)
//   3. trial (mp_run) with substrate sub_note writes
//   4. bootstrap (treatment version) with sub_note writes
//   5. miss_inquire (base) + failure sub_note write
// Plus protect_map_use on query hit (structural protection).
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    protect_map_use(W,s,r);
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),0,0);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let cf:i32=sub_consec(W,SUB_PURSUIT(),s,r);
  if(cf>=sb_withhold_n()){
    log_ev(W,2,s,r,sb_withhold(),cf,sb_withhold_n(),0); return sb_withhold();
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),get32(rbs,0),1);
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let v0:i32=hg(W,16);
  let ans:i32=mp_run(W,s,r,expected,flags);
  let vc:i32=hg(W,16)-v0;
  if(ans!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,bv,1,0,0); return bv;
  }
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  let cst:i32=hg(W,16)-v0;
  sub_note(W,SUB_PURSUIT(),s,r,0,SUB_F6(),SUB_SRC_TAUGHT(),cst,1);
  return -2;
}

// mli_driver.zag -- 5-phase mini-lifetime driver (all arms).
// Phase 1: teach A (decoy + main chains, promote MAPs).
// Phase 2: 150 unrelated interference events.
// Phase 3: teach B, query B (transfer; measure trial-stat delta).
// Phase 4: contradict an A fact, re-query A (revision).
// Phase 5: re-query A and B (retention).
// Withholding probe: 5 queries on untaught (9999,88).
fn mli_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  return;
}
fn mli_live(W:[]u8)void {
  emit(" live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24));
  return;
}
fn mli_phase1(W:[]u8)void {
  ev_teach(W,2,1,21); ev_teach(W,21,1,22);
  let a1:i32=ev_query(W,2,51,22,0);
  emit("P1-DECOY ans="); e64(a1); mli_tstat(W); emit("\n");
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a2:i32=ev_query(W,1,50,14,0);
  emit("P1-MAIN ans="); e64(a2); mli_tstat(W); emit("\n");
  return;
}
fn mli_phase2(W:[]u8)void {
  let i:i32=0;
  while(i<150){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn mli_phase3(W:[]u8)void {
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  let t0:i32=hg(W,16);
  let b:i32=ev_query(W,101,50,114,0);
  let t1:i32=hg(W,16);
  emit("P3-B ans="); e64(b);
  emit(" dtried="); e64((t1-t0)/1024);
  mli_tstat(W); emit("\n");
  return;
}
fn mli_phase4(W:[]u8)void {
  let c:i32=ev_observe(W,1,1,999);
  emit("P4-CONTRADICT rv="); e64(c); emit("\n");
  let a:i32=ev_query(W,1,50,14,0);
  emit("P4-A ans="); e64(a); mli_tstat(W); emit("\n");
  return;
}
fn mli_phase5(W:[]u8)void {
  let a:i32=ev_query(W,1,50,14,0);
  emit("P5-A ans="); e64(a); emit("\n");
  let b:i32=ev_query(W,101,50,114,0);
  emit("P5-B ans="); e64(b); emit("\n");
  return;
}
fn mli_withhold(W:[]u8)void {
  let i:i32=0;
  while(i<5){
    let q:i32=ev_query(W,9999,88,-1,0);
    emit("WH-"); e64(i); emit(" ans="); e64(q); emit("\n");
    i=i+1;
  }
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("MLI-START\n");
  mli_phase1(W); emit("P1"); mli_live(W); emit("\n");
  mli_phase2(W); emit("P2"); mli_live(W); emit("\n");
  mli_phase3(W); emit("P3"); mli_live(W); emit("\n");
  mli_phase4(W); emit("P4"); mli_live(W); emit("\n");
  mli_phase5(W); emit("P5"); mli_live(W); emit("\n");
  mli_withhold(W); emit("WH"); mli_live(W); emit("\n");
  emit("MLI-END\n");
  return 0;
}

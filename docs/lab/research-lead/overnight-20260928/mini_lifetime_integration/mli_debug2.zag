// mli_debug2.zag -- debug P3-B rebind in Arm C
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("DBG2-START\n");
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a2:i32=ev_query(W,1,50,14,0);
  emit("MAIN ans="); e64(a2); emit("\n");
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  emit("B taught\n");
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,101,paths);
  emit("np="); e64(np); emit("\n");
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    emit("path "); e64(p); emit(" len="); e64(get32(paths,base)); emit("\n");
    p=p+1;
  }
  let b:i32=ev_query(W,101,50,114,0);
  emit("B ans="); e64(b); emit("\n");
  emit("DBG2-END\n");
  return 0;
}

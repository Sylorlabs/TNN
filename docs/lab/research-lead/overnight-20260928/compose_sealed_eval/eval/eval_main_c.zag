// eval_main_c.zag -- TEMPLATE for the sealed evaluator (Hypothesis C).
// Concat order: lc_base.zag lc_thunk.zag lc_search.zag lc_mem.zag
//               lc_rev.zag adv_worlds.zag eval_main_c.zag
// Compile with the pinned znc. M (composition memory) persists
// within each sequence; S fresh per problem (mirrors lc_main.zag).
// Sequences (PREREG Section 6):
//   SEQ1: TEACH -> TRAP1 -> TRAP2 (one M)
//   SEQ2: TEACH-D -> T-FANIN -> T-CHAIN (one M)
//   all other problems: fresh M each.
// Reports raw fields; the parent scores PREREG.md Section 5 bars.
// MODE: 0=COLD, 1=RETRIEVE, 2=REVISE (lc_rev.zag ST layout).
// ematch: 1 = expect ANS==exp, 0 = expect ANS!=exp.

fn crep(B:[]u8,c:i32,name:[]u8,ans:i32,S:[]u8,M:[]u8,ST:[]u8,ematch:i32,exp:i32) i32 {
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIES="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"MODE="); c=o_i64(B,c,get32(ST,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"SIM="); c=o_i64(B,c,get32(ST,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"NEGREC="); c=o_i64(B,c,get32(ST,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"MEM="); c=o_i64(B,c,get32(M,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ANSMATCH=");
  let ok:i32=0;
  if(ematch==1){
    if(ans==exp){ ok=1; }
  } else {
    if(ans!=exp){ ok=1; }
  }
  if(ok==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
  c=o_nl(B,c);
  return c;
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let M:[]u8=z_alloc(16384);
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(41943040);
  let ST:[]u8=z_alloc(32);
  let ans:i32=0;
  // ---- SEQ1: TEACH -> TRAP1 -> TRAP2 (one M) ----
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_teach(A);
  ans=lc_solve(S,A,M,0,3,201,1,2,3,ST);
  c=crep(B,c,"TEACH",ans,S,M,ST,1,3);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_trap1(A);
  ans=lc_solve(S,A,M,0,16,201,1,2,5,ST);
  c=crep(B,c,"TRAP1",ans,S,M,ST,1,5);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_trap2(A);
  ans=lc_solve(S,A,M,0,16,201,1,2,5,ST);
  c=crep(B,c,"TRAP2",ans,S,M,ST,1,5);
  // ---- SEQ2: TEACH-D -> T-FANIN -> T-CHAIN (fresh M) ----
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_teachd(A);
  ans=lc_solve(S,A,M,0,4,202,1,2,5,ST);
  c=crep(B,c,"TEACHD",ans,S,M,ST,1,5);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_tfanin(A);
  ans=lc_solve(S,A,M,0,3,401,1,2,5,ST);
  c=crep(B,c,"TFANIN",ans,S,M,ST,1,5);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_tchain(A);
  ans=lc_solve(S,A,M,0,3,301,1,2,3,ST);
  c=crep(B,c,"TCHAIN",ans,S,M,ST,1,3);
  // ---- fresh M per remaining problem ----
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_chain15(A);
  ans=lc_solve(S,A,M,0,16,501,1,2,4,ST);
  c=crep(B,c,"CHAIN15",ans,S,M,ST,0,4);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_chain7(A);
  ans=lc_solve(S,A,M,0,8,501,1,2,4,ST);
  c=crep(B,c,"CHAIN7",ans,S,M,ST,1,4);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_subcap(A);
  ans=lc_solve(S,A,M,0,15,501,1,2,4,ST);
  c=crep(B,c,"SUBCAP",ans,S,M,ST,1,4);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_cycle(A);
  ans=lc_solve(S,A,M,0,1,501,1,1,503,ST);
  c=crep(B,c,"CYC2",ans,S,M,ST,0,503);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_cycle(A);
  ans=lc_solve(S,A,M,0,1,501,1,1,502,ST);
  c=crep(B,c,"CYC3",ans,S,M,ST,0,502);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_chain5(A);
  ans=lc_solve(S,A,M,0,6,501,1,2,6,ST);
  c=crep(B,c,"CHAIN5",ans,S,M,ST,1,6);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_fanout5(A);
  ans=lc_solve(S,A,M,0,10,202,1,2,10,ST);
  c=crep(B,c,"FANOUT5",ans,S,M,ST,1,10);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_fanin5(A);
  ans=lc_solve(S,A,M,0,14,401,1,2,12,ST);
  c=crep(B,c,"FANIN5",ans,S,M,ST,1,12);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_dag10(A);
  ans=lc_solve(S,A,M,0,10,301,1,2,10,ST);
  c=crep(B,c,"DAG10",ans,S,M,ST,1,10);
  M=z_alloc(16384);
  A=z_alloc(8192); S=z_alloc(41943040); ST=z_alloc(32);
  w_adv_partial(A);
  ans=lc_solve(S,A,M,0,14,401,1,2,10,ST);
  c=crep(B,c,"PARTIAL",ans,S,M,ST,1,10);
  o_flush(B,c);
  return 0;
}

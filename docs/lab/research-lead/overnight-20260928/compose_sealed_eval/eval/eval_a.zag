  c=arep(B,c,"TRAP1",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_trap2(A);
  r=solve(S,A,0,16,201,1,2,5); ans=aval(S,A,r);
  c=arep(B,c,"TRAP2",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_tfanin(A);
  r=solve(S,A,0,3,401,1,2,5); ans=aval(S,A,r);
  c=arep(B,c,"TFANIN",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_tchain(A);
  r=solve(S,A,0,3,301,1,2,3); ans=aval(S,A,r);
  c=arep(B,c,"TCHAIN",ans,S,1,3);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_cycle(A);
  r=solve(S,A,0,1,501,1,1,503); ans=aval(S,A,r);
  c=arep(B,c,"CYC2",ans,S,0,503);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_cycle(A);
  r=solve(S,A,0,1,501,1,1,502); ans=aval(S,A,r);
  c=arep(B,c,"CYC3",ans,S,0,502);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_chain5(A);
  r=solve(S,A,0,6,501,1,2,6); ans=aval(S,A,r);
  c=arep(B,c,"CHAIN5",ans,S,1,6);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_fanout5(A);
  r=solve(S,A,0,10,202,1,2,10); ans=aval(S,A,r);
  c=arep(B,c,"FANOUT5",ans,S,1,10);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_fanin5(A);
  r=solve(S,A,0,14,401,1,2,12); ans=aval(S,A,r);
  c=arep(B,c,"FANIN5",ans,S,1,12);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_dag10(A);
  r=solve(S,A,0,10,301,1,2,10); ans=aval(S,A,r);
  c=arep(B,c,"DAG10",ans,S,1,10);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_partial(A);
  r=solve(S,A,0,14,401,1,2,10); ans=aval(S,A,r);
  c=arep(B,c,"PARTIAL",ans,S,1,10);
  o_flush(B,c);
  return 0;
}

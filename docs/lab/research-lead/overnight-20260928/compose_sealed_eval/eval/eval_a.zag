// eval_main_a.zag -- TEMPLATE for the sealed evaluator (Hypothesis A).
// Concat order: bc_base.zag bc_thunk.zag bc_search.zag
//               adv_worlds.zag eval_main_a.zag
// Compile with the pinned znc. Fresh A/S arenas per problem
// (mirrors bc_main.zag). Reports raw fields; the parent scores
// PREREG.md Section 5 bars. ematch: 1 = expect ANS==exp,
// 0 = expect ANS!=exp (predicted failure).

fn arep(B:[]u8,c:i32,name:[]u8,ans:i32,S:[]u8,ematch:i32,exp:i32) i32 {
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIES="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ANSMATCH=");
  let ok:i32=0;
  if(ematch==1){
    if(ans==exp){ ok=1; }
  } else {
    if(ans!=exp){ ok=1; }
  }
  if(ok==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
  c=o_nl(B,c);
  return c;
}
fn aval(S:[]u8,A:[]u8,r:i32) i32 {
  if(r<0){ return -999; }
  return demand(S,A,r);
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(41943040);
  let r:i32=0;
  let ans:i32=0;
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_chain15(A);
  r=solve(S,A,0,16,501,1,2,4); ans=aval(S,A,r);
  c=arep(B,c,"CHAIN15",ans,S,0,4);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_adv_chain7(A);

// lc_rep.zag -- shared problem runner + report printer for the
// COMPOSE-LEARNCOMPOSE-1 binaries.

fn mode_str(B:[]u8,c:i32,mode:i32) i32 {
  if(mode==0){ c=o_app(B,c,"COLD"); }
  if(mode==1){ c=o_app(B,c,"RETRIEVE"); }
  if(mode==2){ c=o_app(B,c,"REVISE"); }
  return c;
}
fn do_prob(B:[]u8,c:i32,name:[]u8,A:[]u8,S:[]u8,M:[]u8,base:i32,nm:i32,s:i32,kin:i32,kout:i32,exp:i32,e_ans:i32,e_tries:i32,e_widen:i32,e_mode:i32,e_sim:i32,e_neg:i32) i32 {
  let ST:[]u8=z_alloc(32);
  let ans:i32=lc_solve(S,A,M,base,nm,s,kin,kout,exp,ST);
  let mode:i32=get32(ST,0);
  let sim:i32=get32(ST,4);
  let neg:i32=get32(ST,8);
  let p:i32=1;
  if(ans!=e_ans){ p=0; }
  if(sg(S,4)!=e_tries){ p=0; }
  if(sg(S,8)!=e_widen){ p=0; }
  if(mode!=e_mode){ p=0; }
  if(sim!=e_sim){ p=0; }
  if(neg!=e_neg){ p=0; }
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIES="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"MODE="); c=mode_str(B,c,mode); c=o_nl(B,c);
  c=o_app(B,c,"SIM="); c=o_i64(B,c,sim as i64); c=o_nl(B,c);
  c=o_app(B,c,"NEGREC="); c=o_i64(B,c,neg as i64); c=o_nl(B,c);
  c=o_app(B,c,"ESEL="); c=o_i64(B,c,get32(ST,12) as i64);
  c=o_app(B,c," SUCC="); c=o_i64(B,c,get32(ST,16) as i64);
  c=o_app(B,c," FAIL="); c=o_i64(B,c,get32(ST,20) as i64); c=o_nl(B,c);
  c=o_app(B,c,"MEM="); c=o_i64(B,c,get32(M,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"VERDICT=");
  if(p==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
  c=o_nl(B,c);
  return c;
}

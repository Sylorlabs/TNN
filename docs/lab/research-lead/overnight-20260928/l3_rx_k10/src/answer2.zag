// answer2.zag -- L3-RX-K10 TEST channel. Pure Zag. Own implementation.
// ONLY this program opens oracle.txt.
// argv: 1=oracle 2=req 3=ans 4=proto
// req: "W <wid>" then "q s0 s1 s2" lines. ans: append "a s0 s1 s2 d".
fn oget(ob:[]u8,on:i32,ls:[]u8,nl:i32,s0:i32,s1:i32,s2:i32) i32 {
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=on;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(ob,s,e);
    let t0:i32=gettok(ob,s,e,0,tok);
    if(t0==1 && tok[0]==116){
      let l1:i32=gettok(ob,s,e,1,tok); p_int(tok,0,l1,ov); let a0:i32=ig(ov,0);
      let l2:i32=gettok(ob,s,e,2,tok); p_int(tok,0,l2,ov); let a1:i32=ig(ov,0);
      let l3:i32=gettok(ob,s,e,3,tok); p_int(tok,0,l3,ov); let a2:i32=ig(ov,0);
      if(a0==s0 && a1==s1 && a2==s2){
        let l4:i32=gettok(ob,s,e,4,tok); p_int(tok,0,l4,ov);
        return ig(ov,0);
      }
    }
    li=li+1;
  }
  return -1;
}
fn main() i32 {
  let oracle:[]u8=_zag_arg(1);
  let reqp:[]u8=_zag_arg(2);
  let ansp:[]u8=_zag_arg(3);
  let protop:[]u8=_zag_arg(4);
  let ob:[]u8=read_file(oracle);
  let on:i32=ob.len;
  let ols:[]u8=z_alloc(2048*4);
  let onl:i32=split_lines(ob,on,ols,2048);
  let rb:[]u8=read_file(reqp);
  let rn:i32=rb.len;
  let rls:[]u8=z_alloc(256*4);
  let rnl:i32=split_lines(rb,rn,rls,256);
  let ab:[]u8=read_file(ansp);
  let an:i32=ab.len;
  let als:[]u8=z_alloc(1024*4);
  let anl:i32=split_lines(ab,an,als,1024);
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<rnl){
    let s:i32=ig(rls,li*4);
    let e:i32=rn;
    if(li+1<rnl){ e=ig(rls,(li+1)*4); }
    e=line_end(rb,s,e);
    let t0:i32=gettok(rb,s,e,0,tok);
    if(t0==1 && tok[0]==113){
      let l1:i32=gettok(rb,s,e,1,tok); p_int(tok,0,l1,ov); let s0:i32=ig(ov,0);
      let l2:i32=gettok(rb,s,e,2,tok); p_int(tok,0,l2,ov); let s1:i32=ig(ov,0);
      let l3:i32=gettok(rb,s,e,3,tok); p_int(tok,0,l3,ov); let s2:i32=ig(ov,0);
      let dup:i32=0;
      let aj:i32=0;
      while(aj<anl){
        let as2:i32=ig(als,aj*4);
        let ae:i32=an;
        if(aj+1<anl){ ae=ig(als,(aj+1)*4); }
        ae=line_end(ab,as2,ae);
        let u0:i32=gettok(ab,as2,ae,0,tok);
        if(u0==1 && tok[0]==97){
          let w1:i32=gettok(ab,as2,ae,1,tok); p_int(tok,0,w1,ov); let b0:i32=ig(ov,0);
          let w2:i32=gettok(ab,as2,ae,2,tok); p_int(tok,0,w2,ov); let b1:i32=ig(ov,0);
          let w3:i32=gettok(ab,as2,ae,3,tok); p_int(tok,0,w3,ov); let b2:i32=ig(ov,0);
          if(b0==s0 && b1==s1 && b2==s2){ dup=1; }
        }
        aj=aj+1;
      }
      if(dup==0){
        let d:i32=oget(ob,on,ols,onl,s0,s1,s2);
        let O:[]u8=z_alloc(64);
        let c:i32=e1str(O,0,"a ");
        c=e1i32(O,c,s0); c=e1str(O,c," ");
        c=e1i32(O,c,s1); c=e1str(O,c," ");
        c=e1i32(O,c,s2); c=e1str(O,c," ");
        c=e1i32(O,c,d); O[c]=10; c=c+1;
        append_file(ansp,O[0..c]);
        let P:[]u8=z_alloc(96);
        let pc:i32=e1str(P,0,"Q ");
        pc=e1i32(P,pc,s0); pc=e1str(P,pc," ");
        pc=e1i32(P,pc,s1); pc=e1str(P,pc," ");
        pc=e1i32(P,pc,s2); pc=e1str(P,pc," -> ");
        pc=e1i32(P,pc,d); P[pc]=10; pc=pc+1;
        append_file(protop,P[0..pc]);
      }
    }
    li=li+1;
  }
  return 0;
}

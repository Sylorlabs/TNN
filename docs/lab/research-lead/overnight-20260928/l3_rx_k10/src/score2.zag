// score2.zag -- L3-RX-K10 scorer + kill-bar evaluator. Pure Zag.
// argv: 1=rundir 2=wdir 3=wid 4=rkmode
//   rkmode: 0=sanity/report 1=RK-A 2=RK-B 3=RK-C 4=RK-D 5=RK-C-control
// Reads wdir/{commit,heldout,train}.txt + rundir/trace.txt.
// Appends one metrics line to rundir/metrics.txt.
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// load "o s0 s1 s2 d" lines into 4 parallel i32 arrays. returns count.
fn load_o(path:[]u8,c0:[]u8,c1:[]u8,c2:[]u8,c3:[]u8,cap:i32) i32 {
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(1024*4);
  let nl:i32=split_lines(b,n,ls,1024);
  let no:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && no<cap){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==111){
      let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov); put32(c0,no*4,ig(ov,0));
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); put32(c1,no*4,ig(ov,0));
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); put32(c2,no*4,ig(ov,0));
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); put32(c3,no*4,ig(ov,0));
      no=no+1;
    }
    li=li+1;
  }
  return no;
}
// trace stats for one wid. out: [nexp,nreu,ntestq,termc]. returns certl.
fn trace_stats(rundir:[]u8,wid:[]u8,out:[]u8,certb:[]u8) i32 {
  put32(out,0,0); put32(out,4,0); put32(out,8,0); put32(out,12,0);
  let certl:i32=0;
  let trp:[]u8=z_alloc(512);
  let trl:i32=pjoin(rundir,"trace.txt",trp);
  let trb:[]u8=read_file(trp[0..trl]);
  let tls:[]u8=z_alloc(4096*4);
  let tnl:i32=split_lines(trb,trb.len,tls,4096);
  let tok:[]u8=z_alloc(64);
  let inw:i32=0;
  let tli:i32=0;
  while(tli<tnl){
    let ts:i32=ig(tls,tli*4);
    let te:i32=trb.len;
    if(tli+1<tnl){ te=ig(tls,(tli+1)*4); }
    te=line_end(trb,ts,te);
    let l3:i32=gettok(trb,ts,te,3,tok);
    let is_world:i32=0;
    if(l3==5 && tok[0]==87){ is_world=1; }
    if(is_world==1){
      let l5:i32=gettok(trb,ts,te,5,tok);
      let wb:[]u8=tok[0..l5];
      let me:i32=streq(wb,wid);
      if(me==1){
        inw=1;
        put32(out,0,0); put32(out,4,0); put32(out,8,0); put32(out,12,0);
        certl=0;
      }
      if(me==0){ inw=0; }
    }
    if(inw==1 && is_world==0){
      let eb:[]u8=tok[0..l3];
      let e_ex:i32=streq(eb,"FORM_EXPAND");
      let e_re:i32=streq(eb,"FORM_REUSE");
      let e_tq:i32=streq(eb,"TESTQ");
      let e_co:i32=streq(eb,"COMMIT");
      let e_de:i32=streq(eb,"DEFER");
      if(e_ex==1){ put32(out,0,ig(out,0)+1); }
      if(e_re==1){ put32(out,4,ig(out,4)+1); }
      if(e_tq==1){ put32(out,8,ig(out,8)+1); }
      if(e_co==1){ put32(out,12,1); }
      if(e_de==1){
        put32(out,12,2);
        let l5:i32=gettok(trb,ts,te,5,tok);
        let k:i32=0;
        while(k<l5 && k<32){ certb[k]=tok[k]; k=k+1; }
        certl=l5;
      }
    }
    tli=tli+1;
  }
  return certl;
}
fn main() i32 {
  let rundir:[]u8=_zag_arg(1);
  let wdir:[]u8=_zag_arg(2);
  let wid:[]u8=_zag_arg(3);
  let rkmb:[]u8=_zag_arg(4);
  let rkm:i32=0;
  if(rkmb.len>0){ rkm=(rkmb[0] as i32)-48; }
  // ---- heldout ----
  let hs0:[]u8=z_alloc(16*4); let hs1:[]u8=z_alloc(16*4);
  let hs2:[]u8=z_alloc(16*4); let hd:[]u8=z_alloc(16*4);
  let hp:[]u8=z_alloc(512);
  let hpl:i32=pjoin(wdir,"heldout.txt",hp);
  let nh:i32=load_o(hp[0..hpl],hs0,hs1,hs2,hd,16);
  // ---- commit ----
  let cp:[]u8=z_alloc(512);
  let cpl:i32=pjoin(wdir,"commit.txt",cp);
  let cb:[]u8=read_file(cp[0..cpl]);
  let has_commit:i32=0;
  let is_guarded:i32=0;
  let is_pairtable:i32=0;
  if(cb.len>0){ has_commit=1; }
  // rules: max 12 rules x (ng + 8 gv + 8 perm)
  let rng:[]u8=z_alloc(12*4);
  let rgv:[]u8=z_alloc(12*8*4);
  let rpm:[]u8=z_alloc(12*8*4);
  let nrules:i32=0;
  let tab:[]u8=z_alloc(28*4);
  if(has_commit==1){
    let tok:[]u8=z_alloc(64);
    let ov:[]u8=z_alloc(4);
    // detect form
    let l0e:i32=line_end(cb,0,cb.len);
    let t0:i32=gettok(cb,0,l0e,2,tok);
    let evb:[]u8=tok[0..t0];
    if(streq(evb,"guarded")==1){ is_guarded=1; }
    if(streq(evb,"pairtable")==1){ is_pairtable=1; }
    let ls:[]u8=z_alloc(256*4);
    let nl:i32=split_lines(cb,cb.len,ls,256);
    let li:i32=0;
    while(li<nl){
      let s:i32=ig(ls,li*4);
      let e:i32=cb.len;
      if(li+1<nl){ e=ig(ls,(li+1)*4); }
      e=line_end(cb,s,e);
      let u0:i32=gettok(cb,s,e,0,tok);
      if(u0==4 && tok[0]==82 && tok[1]==85 && tok[2]==76 && tok[3]==69){
        let l2:i32=gettok(cb,s,e,2,tok); p_int(tok,0,l2,ov);
        let k:i32=ig(ov,0);
        put32(rng,nrules*4,k);
        let gi:i32=0;
        while(gi<k){
          let lg:i32=gettok(cb,s,e,4+gi,tok); p_int(tok,0,lg,ov);
          put32(rgv,(nrules*8+gi)*4,ig(ov,0));
          gi=gi+1;
        }
        let pi:i32=0;
        while(pi<8){
          let lp:i32=gettok(cb,s,e,5+k+pi,tok); p_int(tok,0,lp,ov);
          put32(rpm,(nrules*8+pi)*4,ig(ov,0));
          pi=pi+1;
        }
        nrules=nrules+1;
      }
      if(u0==5 && tok[0]==84 && tok[1]==65 && tok[2]==66 && tok[3]==76 && tok[4]==69){
        let ti:i32=0;
        while(ti<28){
          let lt:i32=gettok(cb,s,e,1+ti,tok); p_int(tok,0,lt,ov);
          put32(tab,ti*4,ig(ov,0));
          ti=ti+1;
        }
      }
      li=li+1;
    }
  }
  // ---- id list from train (for pairtable scoring) ----
  let ts0:[]u8=z_alloc(128*4); let ts1:[]u8=z_alloc(128*4);
  let ts2:[]u8=z_alloc(128*4); let ts3:[]u8=z_alloc(128*4);
  let tp:[]u8=z_alloc(512);
  let tpl:i32=pjoin(wdir,"train.txt",tp);
  let nt:i32=load_o(tp[0..tpl],ts0,ts1,ts2,ts3,128);
  let ids:[]u8=z_alloc(8*4);
  let nid:i32=0;
  let ti2:i32=0;
  while(ti2<nt){
    let vs:[]u8=z_alloc(2*4);
    put32(vs,0,ig(ts1,ti2*4)); put32(vs,4,ig(ts2,ti2*4));
    let vi:i32=0;
    while(vi<2){
      let v:i32=ig(vs,vi*4);
      let k:i32=0; let f:i32=0;
      while(k<nid){ if(ig(ids,k*4)==v){ f=1; } k=k+1; }
      if(f==0){ put32(ids,nid*4,v); nid=nid+1; }
      vi=vi+1;
    }
    ti2=ti2+1;
  }
  // sort ascending
  let x:i32=0;
  while(x<nid){
    let y:i32=x+1;
    while(y<nid){
      if(ig(ids,x*4)>ig(ids,y*4)){
        let t:i32=ig(ids,x*4);
        put32(ids,x*4,ig(ids,y*4));
        put32(ids,y*4,t);
      }
      y=y+1;
    }
    x=x+1;
  }
  // ---- score heldout ----
  let hoc:i32=0;
  let hi:i32=0;
  while(hi<nh){
    let s0:i32=ig(hs0,hi*4); let s1:i32=ig(hs1,hi*4);
    let s2:i32=ig(hs2,hi*4); let d:i32=ig(hd,hi*4);
    let pred:i32=-1;
    if(is_guarded==1){
      let r:i32=0;
      let done:i32=0;
      while(r<nrules && done==0){
        let ng2:i32=ig(rng,r*4);
        let g:i32=0;
        while(g<ng2){
          if(ig(rgv,(r*8+g)*4)==s0){
            let p1:i32=-1; let p2:i32=-1;
            let q:i32=0;
            while(q<8){
              if(ig(rpm,(r*8+q)*4)==s1){ p1=q; }
              if(ig(rpm,(r*8+q)*4)==s2){ p2=q; }
              q=q+1;
            }
            if(p1!=-1 && p2!=-1){
              if(p1<p2){ pred=1; }
              if(p1>=p2){ pred=0; }
            }
            done=1;
          }
          g=g+1;
        }
        r=r+1;
      }
    }
    if(is_pairtable==1){
      let ix:i32=-1; let iy:i32=-1;
      let q2:i32=0;
      while(q2<nid){
        if(ig(ids,q2*4)==s1){ ix=q2; }
        if(ig(ids,q2*4)==s2){ iy=q2; }
        q2=q2+1;
      }
      if(ix!=-1 && iy!=-1 && ix!=iy){
        let a:i32=ix; let b2:i32=iy;
        if(a>b2){ let t:i32=a; a=b2; b2=t; }
        // pair index among i<j
        let k2:i32=0;
        let i3:i32=0;
        let found:i32=0;
        while(i3<nid && found==0){
          let j3:i32=i3+1;
          while(j3<nid){
            if(i3==a && j3==b2){ found=1; }
            if(found==0){ k2=k2+1; }
            j3=j3+1;
          }
          i3=i3+1;
        }
        let v:i32=ig(tab,k2*4);
        if(ix<iy){ pred=v; }
        if(ix>iy){ pred=1-v; }
      }
    }
    if(pred==d){ hoc=hoc+1; }
    hi=hi+1;
  }
  // ---- trace parse for this wid ----
  // out cells: [0]=nexp [1]=nreu [2]=ntestq [3]=termc(1=COMMIT 2=DEFER)
  // returns cert length; cert bytes in certb.
  let tout:[]u8=z_alloc(4*4);
  let certb:[]u8=z_alloc(32);
  let certl:i32=trace_stats(rundir,wid,tout,certb);
  let nexp:i32=ig(tout,0); let nreu:i32=ig(tout,4);
  let ntestq:i32=ig(tout,8); let termc:i32=ig(tout,12);
  // ---- RK evaluation (codes: 0=NA 1=FAIL_K 2=HOLD 3=VALID 4=INCONCLUSIVE)
  let rkrc:i32=0;
  let wrong_conf:i32=0;
  if(termc==1 && hoc<5){ wrong_conf=1; }
  if(rkm==1 || rkm==2 || rkm==3){
    if(wrong_conf==1){ rkrc=1; }
    if(wrong_conf==0){ rkrc=2; }
  }
  if(rkm==5){
    let du:[]u8="DATA-UNTRUSTED";
    let dmatch:i32=streq(certb[0..certl],du);
    if(termc==2 && dmatch==1){ rkrc=3; }
    if(termc!=2 || dmatch==0){ rkrc=4; }
  }
  // ---- metrics line ----
  let M:[]u8=z_alloc(512);
  let mc:i32=e1str(M,0,"W ");
  mc=e1str(M,mc,wid);
  mc=e1str(M,mc," term ");
  if(termc==1){ mc=e1str(M,mc,"COMMIT"); }
  if(termc==2){ mc=e1str(M,mc,"DEFER"); }
  if(termc==0){ mc=e1str(M,mc,"NONE"); }
  mc=e1str(M,mc," cert ");
  if(termc==2){ mc=e1str(M,mc,certb[0..certl]); }
  if(termc!=2){ mc=e1str(M,mc,"-"); }
  mc=e1str(M,mc," nexp ");
  mc=e1i32(M,mc,nexp);
  mc=e1str(M,mc," nreu ");
  mc=e1i32(M,mc,nreu);
  mc=e1str(M,mc," ntestq ");
  mc=e1i32(M,mc,ntestq);
  mc=e1str(M,mc," ho ");
  mc=e1i32(M,mc,hoc);
  mc=e1str(M,mc,"/");
  mc=e1i32(M,mc,nh);
  mc=e1str(M,mc," nrules ");
  mc=e1i32(M,mc,nrules);
  mc=e1str(M,mc," rk ");
  if(rkrc==0){ mc=e1str(M,mc,"NA"); }
  if(rkrc==1){ mc=e1str(M,mc,"FAIL_K"); }
  if(rkrc==2){ mc=e1str(M,mc,"HOLD"); }
  if(rkrc==3){ mc=e1str(M,mc,"VALID"); }
  if(rkrc==4){ mc=e1str(M,mc,"INCONCLUSIVE"); }
  M[mc]=10; mc=mc+1;
  let mp:[]u8=z_alloc(512);
  let mpl:i32=pjoin(rundir,"metrics.txt",mp);
  append_file(mp[0..mpl],M[0..mc]);
  stdout_write(M[0..mc]);
  return 0;
}

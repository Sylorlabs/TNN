// adv2.zag -- L3-RX-K10 adversarial world generator. Pure Zag.
// argv: 1 = sealed dir. Writes sealed/<wid>/{train,oracle,heldout,CERT}.txt
// for 7 worlds. All tables frozen per PREREG.md + AMEND1. No RNG.
// Worlds: 0=w1 1=w2 2=w3 3=w4a 4=w4b 5=w5 6=w6.
// Bases: 0=A 1=B 2=C 3=D (two total orders over 8 item indices).
fn mk_dir(path:[]u8)void {
  let cp:[]u8=z_cstr(path);
  _zag_raw_syscall(83,(_zag_slice_ptr(cp) as i64),493,0,0,0,0);
  return;
}
// ---- fixed tables ----
fn init_tabs(items:[]u8,ctx:[]u8,p5i:[]u8,p5c:[]u8,p6i:[]u8,p6c:[]u8)void {
  put32(items,0*4,23); put32(items,1*4,41); put32(items,2*4,7); put32(items,3*4,198);
  put32(items,4*4,112); put32(items,5*4,55); put32(items,6*4,90); put32(items,7*4,164);
  put32(ctx,0*4,13); put32(ctx,1*4,231);
  put32(p5i,0*4,164); put32(p5i,1*4,7); put32(p5i,2*4,112); put32(p5i,3*4,23);
  put32(p5i,4*4,90); put32(p5i,5*4,198); put32(p5i,6*4,55); put32(p5i,7*4,41);
  put32(p5c,0*4,231); put32(p5c,1*4,13);
  put32(p6i,0*4,90); put32(p6i,1*4,164); put32(p6i,2*4,7); put32(p6i,3*4,55);
  put32(p6i,4*4,198); put32(p6i,5*4,41); put32(p6i,6*4,112); put32(p6i,7*4,23);
  put32(p6c,0*4,231); put32(p6c,1*4,13);
  return;
}
fn base_of(w:i32)i32 {
  if(w==0){ return 0; }
  if(w==1){ return 1; }
  if(w==2){ return 2; }
  if(w==3){ return 3; }
  if(w==4){ return 3; }
  if(w==5){ return 0; }
  return 2;
}
fn recode_of(w:i32)i32 {
  if(w==5){ return 1; }
  if(w==6){ return 2; }
  return 0;
}
fn swap_of(w:i32)i32 {
  if(w==4){ return 1; }
  return 0;
}
fn load_orders(base:i32,o1:[]u8,o2:[]u8)void {
  let i:i32=0;
  while(i<8){ o1[i]=i as u8; i=i+1; }
  if(base==0){ i=0; while(i<8){ o2[i]=(7-i) as u8; i=i+1; } }
  if(base==1){
    o2[0]=3; o2[1]=2; o2[2]=1; o2[3]=0;
    o2[4]=4; o2[5]=5; o2[6]=6; o2[7]=7;
  }
  if(base==2){
    o1[0]=5; o1[1]=6; o1[2]=4; o1[3]=3; o1[4]=7; o1[5]=2; o1[6]=0; o1[7]=1;
    o2[0]=1; o2[1]=0; o2[2]=2; o2[3]=7; o2[4]=3; o2[5]=4; o2[6]=6; o2[7]=5;
  }
  if(base==3){ i=0; while(i<8){ o2[i]=(7-i) as u8; i=i+1; } }
  return;
}
fn pos_of(ord:[]u8,x:i32)i32 {
  let i:i32=0;
  while(i<8){ if((ord[i] as i32)==x){ return i; } i=i+1; }
  return -1;
}
fn dir_of(ord:[]u8,x:i32,y:i32)i32 {
  if(pos_of(ord,x)<pos_of(ord,y)){ return 1; }
  return 0;
}
fn is_d(o1:[]u8,o2:[]u8,x:i32,y:i32)i32 {
  if(dir_of(o1,x,y)!=dir_of(o2,x,y)){ return 1; }
  return 0;
}
// withhold predicate on (w, ci, a, b) with a,b item indices, a!=b.
fn withheld(w:i32,ci:i32,a:i32,b:i32,o1:[]u8,o2:[]u8) i32 {
  if(w==0 || w==3 || w==4 || w==5){
    // H1/H4: (lo,hi) orientations of {0,7},{1,6},{2,5}
    if(a==0 && b==7){ return 1; }
    if(a==1 && b==6){ return 1; }
    if(a==2 && b==5){ return 1; }
    return 0;
  }
  if(w==1){
    return is_d(o1,o2,a,b);
  }
  // w==2 || w==6: c1 withholds every pair touching S={0,1,2,4,5,6} (AMEND3)
  if(ci!=0){ return 0; }
  let sa:i32=1;
  if(a==3 || a==7){ sa=0; }
  let sb2:i32=1;
  if(b==3 || b==7){ sb2=0; }
  if(sa==1 || sb2==1){ return 1; }
  return 0;
}
// heldout triple lists. Writes into ho (ci,x,y per triple), returns count.
fn heldout_list(w:i32,ho:[]u8) i32 {
  let n:i32=0;
  if(w==0 || w==3 || w==4 || w==5){
    put32(ho,0*12,0); put32(ho,0*12+4,0); put32(ho,0*12+8,7);
    put32(ho,1*12,1); put32(ho,1*12+4,0); put32(ho,1*12+8,7);
    put32(ho,2*12,0); put32(ho,2*12+4,1); put32(ho,2*12+8,6);
    put32(ho,3*12,1); put32(ho,3*12+4,1); put32(ho,3*12+8,6);
    put32(ho,4*12,0); put32(ho,4*12+4,2); put32(ho,4*12+8,5);
    put32(ho,5*12,1); put32(ho,5*12+4,2); put32(ho,5*12+8,5);
    n=6;
  }
  if(w==1){
    put32(ho,0*12,0); put32(ho,0*12+4,0); put32(ho,0*12+8,1);
    put32(ho,1*12,1); put32(ho,1*12+4,0); put32(ho,1*12+8,1);
    put32(ho,2*12,0); put32(ho,2*12+4,0); put32(ho,2*12+8,2);
    put32(ho,3*12,1); put32(ho,3*12+4,0); put32(ho,3*12+8,2);
    put32(ho,4*12,0); put32(ho,4*12+4,1); put32(ho,4*12+8,2);
    put32(ho,5*12,1); put32(ho,5*12+4,1); put32(ho,5*12+8,2);
    n=6;
  }
  if(w==2 || w==6){
    put32(ho,0*12,0); put32(ho,0*12+4,2); put32(ho,0*12+8,5);
    put32(ho,1*12,0); put32(ho,1*12+4,5); put32(ho,1*12+8,2);
    put32(ho,2*12,0); put32(ho,2*12+4,0); put32(ho,2*12+8,6);
    put32(ho,3*12,0); put32(ho,3*12+4,6); put32(ho,3*12+8,0);
    put32(ho,4*12,0); put32(ho,4*12+4,1); put32(ho,4*12+8,4);
    put32(ho,5*12,0); put32(ho,5*12+4,4); put32(ho,5*12+8,1);
    n=6;
  }
  return n;
}
fn wid_name(w:i32,out:[]u8)i32 {
  if(w==0){ return e1str(out,0,"w1"); }
  if(w==1){ return e1str(out,0,"w2"); }
  if(w==2){ return e1str(out,0,"w3"); }
  if(w==3){ return e1str(out,0,"w4a"); }
  if(w==4){ return e1str(out,0,"w4b"); }
  if(w==5){ return e1str(out,0,"w5"); }
  return e1str(out,0,"w6");
}
fn world_note(w:i32,out:[]u8,c:i32)i32 {
  if(w==0){ return e1str(out,c,"sanity: dense gated world"); }
  if(w==1){ return e1str(out,c,"R-A passive: all D-pair triples withheld from train"); }
  if(w==2){ return e1str(out,c,"R-B decoy: c1 withholds all S-pairs; 7-way od tie broken by id"); }
  if(w==3){ return e1str(out,c,"R-C phase1: seeds kb"); }
  if(w==4){ return e1str(out,c,"R-C phase2: train D-labels swapped between contexts"); }
  if(w==5){ return e1str(out,c,"R-D1: p5 recode of w1"); }
  return e1str(out,c,"R-D2: p6 recode of w3");
}
// emit one line "p s0 s1 s2 d\n" into buf at cursor; returns new cursor.
fn emit_line(buf:[]u8,c:i32,tag:[]u8,s0:i32,s1:i32,s2:i32,d:i32)i32 {
  c=e1str(buf,c,tag);
  c=e1str(buf,c," ");
  c=e1i32(buf,c,s0); c=e1str(buf,c," ");
  c=e1i32(buf,c,s1); c=e1str(buf,c," ");
  c=e1i32(buf,c,s2); c=e1str(buf,c," ");
  c=e1i32(buf,c,d);
  buf[c]=10; c=c+1;
  return c;
}
fn main() i32 {
  let sealed:[]u8=_zag_arg(1);
  let items:[]u8=z_alloc(8*4); let ctx:[]u8=z_alloc(2*4);
  let p5i:[]u8=z_alloc(8*4); let p5c:[]u8=z_alloc(2*4);
  let p6i:[]u8=z_alloc(8*4); let p6c:[]u8=z_alloc(2*4);
  init_tabs(items,ctx,p5i,p5c,p6i,p6c);
  let w:i32=0;
  while(w<7){
    let base:i32=base_of(w);
    let rc:i32=recode_of(w);
    let sw:i32=swap_of(w);
    let o1:[]u8=z_alloc(8); let o2:[]u8=z_alloc(8);
    load_orders(base,o1,o2);
    let wn:[]u8=z_alloc(8);
    let wnl:i32=wid_name(w,wn);
    let wd:[]u8=z_alloc(512);
    let wdl:i32=pjoin(sealed,wn[0..wnl],wd);
    mk_dir(wd[0..wdl]);
    let TR:[]u8=z_alloc(8192); let tc:i32=0;
    let OR:[]u8=z_alloc(8192); let oc:i32=0;
    let ntrain:i32=0;
    let ndpairs:i32=0;
    let x:i32=0;
    while(x<8){
      let y:i32=x+1;
      while(y<8){
        if(is_d(o1,o2,x,y)==1){ ndpairs=ndpairs+1; }
        y=y+1;
      }
      x=x+1;
    }
    let ci:i32=0;
    while(ci<2){
      x=0;
      while(x<8){
        let y2:i32=x+1;
        while(y2<8){
          let oi:i32=0;
          while(oi<2){
            let a:i32=x; let b2:i32=y2;
            if(oi==1){ a=y2; b2=x; }
            let use1:i32=ci;
            if(sw==1 && is_d(o1,o2,a,b2)==1){ use1=1-ci; }
            let oo:[]u8=o1;
            if(use1==1){ oo=o2; }
            let d:i32=dir_of(oo,a,b2);
            // oracle truth (never swapped)
            let to:[]u8=o1;
            if(ci==1){ to=o2; }
            let dt:i32=dir_of(to,a,b2);
            let s0:i32=ig(ctx,ci*4); let s1:i32=ig(items,a*4); let s2:i32=ig(items,b2*4);
            if(rc==1){
              s0=ig(p5c,ci*4); s1=ig(p5i,a*4); s2=ig(p5i,b2*4);
            }
            if(rc==2){
              s0=ig(p6c,ci*4); s1=ig(p6i,a*4); s2=ig(p6i,b2*4);
            }
            oc=emit_line(OR,oc,"t",s0,s1,s2,dt);
            if(withheld(w,ci,a,b2,o1,o2)==0){
              tc=emit_line(TR,tc,"o",s0,s1,s2,d);
              ntrain=ntrain+1;
            }
            oi=oi+1;
          }
          y2=y2+1;
        }
        x=x+1;
      }
      ci=ci+1;
    }
    // heldout (oracle truth, mapped)
    let ho:[]u8=z_alloc(6*12);
    let nh:i32=heldout_list(w,ho);
    let HE:[]u8=z_alloc(1024); let hc:i32=0;
    let h:i32=0;
    while(h<nh){
      let hci:i32=ig(ho,h*12); let hx:i32=ig(ho,h*12+4); let hy:i32=ig(ho,h*12+8);
      let to2:[]u8=o1;
      if(hci==1){ to2=o2; }
      let hd:i32=dir_of(to2,hx,hy);
      let s0:i32=ig(ctx,hci*4); let s1:i32=ig(items,hx*4); let s2:i32=ig(items,hy*4);
      if(rc==1){ s0=ig(p5c,hci*4); s1=ig(p5i,hx*4); s2=ig(p5i,hy*4); }
      if(rc==2){ s0=ig(p6c,hci*4); s1=ig(p6i,hx*4); s2=ig(p6i,hy*4); }
      hc=emit_line(HE,hc,"o",s0,s1,s2,hd);
      h=h+1;
    }
    // CERT.txt
    let CE:[]u8=z_alloc(2048); let cc:i32=0;
    cc=e1str(CE,cc,"WORLD ");
    cc=e1str(CE,cc,wn[0..wnl]);
    cc=e1str(CE,cc,"\nbase ");
    cc=e1i32(CE,cc,base);
    cc=e1str(CE,cc," Dpairs ");
    cc=e1i32(CE,cc,ndpairs);
    cc=e1str(CE,cc," ntrain ");
    cc=e1i32(CE,cc,ntrain);
    cc=e1str(CE,cc," nheldout ");
    cc=e1i32(CE,cc,nh);
    cc=e1str(CE,cc,"\nO1 idx: ");
    let k:i32=0;
    while(k<8){ cc=e1i32(CE,cc,o1[k] as i32); cc=e1str(CE,cc," "); k=k+1; }
    cc=e1str(CE,cc,"\nO2 idx: ");
    k=0;
    while(k<8){ cc=e1i32(CE,cc,o2[k] as i32); cc=e1str(CE,cc," "); k=k+1; }
    cc=e1str(CE,cc,"\nnote: ");
    cc=world_note(w,CE,cc);
    CE[cc]=10; cc=cc+1;
    let p:[]u8=z_alloc(512);
    let pl:i32=pjoin(wd[0..wdl],"train.txt",p);
    write_file(p[0..pl],TR[0..tc]);
    pl=pjoin(wd[0..wdl],"oracle.txt",p);
    write_file(p[0..pl],OR[0..oc]);
    pl=pjoin(wd[0..wdl],"heldout.txt",p);
    write_file(p[0..pl],HE[0..hc]);
    pl=pjoin(wd[0..wdl],"CERT.txt",p);
    write_file(p[0..pl],CE[0..cc]);
    w=w+1;
  }
  return 0;
}

// fc1.zag -- FC-1: learned idempotence constrains planning.
// Pure Zag. Pinned safebin znc. Deterministic output.
// Output idiom: one preallocated buffer, cursor-returning emit
// helpers, single raw-syscall write. No _zag_print for dynamics.
// Opaque op ids: 2, 5, 7. Learner sees ids only.

// ---------------- utils ----------------
fn z_alloc(n:i64)[]u8 {
  if(n < 1) { return ""; }
  let p:*u8 = _zag_malloc(n) as *u8;
  if(p == null as *u8) { return ""; }
  let b:[]u8 = p[0..n];
  let i:i64 = 0;
  while(i < n) { b[i] = 0; i = i + 1; }
  return b;
}
fn ig(b:[]u8, i:i64)i64 {
  let o:i64 = i * 8;
  let v:i64 = 0;
  let k:i64 = 0;
  while(k < 8) { v = v + ((b[o + k] as i64) << (k * 8)); k = k + 1; }
  return v;
}
fn is(b:[]u8, i:i64, v:i64)void {
  let o:i64 = i * 8;
  let k:i64 = 0;
  while(k < 8) { b[o + k] = (((v >> (k * 8)) & 255) as u8); k = k + 1; }
  return;
}
fn e1str(b:[]u8, cur:i64, s:[]u8)i64 {
  let i:i64 = 0;
  while(i < s.len) { b[cur] = s[i]; cur = cur + 1; i = i + 1; }
  return cur;
}
fn e1i64(b:[]u8, cur:i64, v:i64)i64 {
  if(v < 0) { b[cur] = 45; cur = cur + 1; v = 0 - v; }
  let n:i64 = 0;
  let t:i64 = v;
  if(t == 0) { n = 1; }
  while(t > 0) { n = n + 1; t = t / 10; }
  let p:i64 = cur + n - 1;
  t = v;
  if(t == 0) { b[p] = 48; }
  while(t > 0) { b[p] = ((t % 10) + 48) as u8; p = p - 1; t = t / 10; }
  return cur + n;
}
fn e1ch(b:[]u8, cur:i64, c:i64)i64 {
  b[cur] = c as u8;
  return cur + 1;
}

// ---------------- WORLD PHYSICS (environment) ----------------
// The learner below never inspects these definitions.
// It only calls w_apply with opaque op ids.
// f: 0 = clamp8 (idempotent), 1 = inc mod 16, 2 = dbl mod 16.
fn w_apply(op:i64, s:i64, run:i64, p3:i64)i64 {
  let f:i64 = 0;
  if(run == 1) {
    if(op == 2) { f = 0; }
    if(op == 5) { f = 1; }
    if(op == 7) { f = 2; }
    if(p3 == 1) {
      if(op == 2) { f = 1; }
    }
  }
  if(run == 2) {
    if(op == 2) { f = 1; }
    if(op == 5) { f = 2; }
    if(op == 7) { f = 0; }
  }
  if(f == 0) {
    if(s < 8) { return s; }
    return 8;
  }
  if(f == 1) { return (s + 1) % 16; }
  return (s * 2) % 16;
}

// ---------------- LEARNER (generic machinery; no formal rules) ----------------
fn opidx(op:i64)i64 {
  if(op == 2) { return 0; }
  if(op == 5) { return 1; }
  return 2;
}
fn trial_state(t:i64)i64 {
  if(t == 0) { return 12; }
  if(t == 1) { return 3; }
  if(t == 2) { return 15; }
  if(t == 3) { return 8; }
  if(t == 4) { return 0; }
  return 9;
}
// Generic trial procedure: does doing k twice differ from once?
// Unanimous no-change over 6 fixed trials -> SELF_STABLE.
fn acquire(op:i64, bel:[]u8, run:i64, p3:i64)void {
  let ok:i64 = 1;
  let t:i64 = 0;
  while(t < 6) {
    let s:i64 = trial_state(t);
    let s1:i64 = w_apply(op, s, run, p3);
    let s2:i64 = w_apply(op, s1, run, p3);
    if(s2 != s1) { ok = 0; }
    t = t + 1;
  }
  bel[opidx(op)] = ok as u8;
  return;
}
// Generic prune predicate: skip op if it repeats the last op and
// the current model says a repeat is effectless. Domain-neutral.
fn prunable(last:i64, op:i64, bel:[]u8)i64 {
  if(last != op) { return 0; }
  if(bel[opidx(op)] == 1) { return 1; }
  return 0;
}
fn op_at(i:i64)i64 {
  if(i == 0) { return 2; }
  if(i == 1) { return 5; }
  return 7;
}
// Simulate a prefix by black-box world calls. Counts calls.
fn psim(pre:[]u8, n:i64, start:i64, run:i64, p3:i64, simsc:[]u8)i64 {
  let s:i64 = start;
  let i:i64 = 0;
  while(i < n) {
    s = w_apply(pre[i] as i64, s, run, p3);
    is(simsc, 0, ig(simsc, 0) + 1);
    i = i + 1;
  }
  return s;
}
fn copyplan(dst:[]u8, src:[]u8, n:i64)void {
  let j:i64 = 0;
  while(j < n) { dst[j] = src[j]; j = j + 1; }
  return;
}
// Depth-first planner, max depth 8, fixed op order. Returns 1 on
// success and writes the first goal-reaching prefix into plan.
fn dfs(pre:[]u8, n:i64, start:i64, goal:i64, bel:[]u8, run:i64, p3:i64, plan:[]u8, plen:[]u8, simsc:[]u8)i64 {
  let i:i64 = 0;
  while(i < 3) {
    let op:i64 = op_at(i);
    let take:i64 = 1;
    if(n > 0) {
      let last:i64 = pre[n - 1] as i64;
      if(prunable(last, op, bel) == 1) { take = 0; }
    }
    if(take == 1) {
      pre[n] = op as u8;
      let s:i64 = psim(pre, n + 1, start, run, p3, simsc);
      if(s == goal) {
        copyplan(plan, pre, n + 1);
        is(plen, 0, n + 1);
        return 1;
      }
      let deeper:i64 = n + 1;
      if(deeper < 8) {
        let r:i64 = dfs(pre, deeper, start, goal, bel, run, p3, plan, plen, simsc);
        if(r == 1) { return 1; }
      }
    }
    i = i + 1;
  }
  return 0;
}
fn do_plan(start:i64, goal:i64, belx:[]u8, run:i64, p3:i64, pre:[]u8, plan:[]u8, plen:[]u8, simsc:[]u8)i64 {
  is(simsc, 0, 0);
  is(plen, 0, 0);
  let f:i64 = dfs(pre, 0, start, goal, belx, run, p3, plan, plen, simsc);
  return f;
}
// Independent re-simulation check that a plan reaches its goal.
fn verify_plan(plan:[]u8, pl:i64, start:i64, goal:i64, run:i64, p3:i64, dummy:[]u8)i64 {
  if(pl < 1) { return 0; }
  is(dummy, 0, 0);
  let s:i64 = psim(plan, pl, start, run, p3, dummy);
  if(s == goal) { return 1; }
  return 0;
}
// Count consecutive (2,2) pairs: the redundancy error for run 1.
fn dbl2(plan:[]u8, plen:i64)i64 {
  let c:i64 = 0;
  let i:i64 = 0;
  while(i + 1 < plen) {
    let a:i64 = plan[i] as i64;
    let nx:i64 = plan[i + 1] as i64;
    if(a == 2) {
      if(nx == 2) { c = c + 1; }
    }
    i = i + 1;
  }
  return c;
}
fn plan_eq(plan:[]u8, plen:i64, exp:[]u8, elen:i64)i64 {
  if(plen != elen) { return 0; }
  let i:i64 = 0;
  while(i < plen) {
    if(plan[i] != exp[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}
fn emit_plan(out:[]u8, cur:i64, tag:[]u8, tid:[]u8, plan:[]u8, plen:i64, start:i64, goal:i64, reach:i64, simsc:[]u8)i64 {
  cur = e1str(out, cur, tag);
  cur = e1ch(out, cur, 32);
  cur = e1str(out, cur, tid);
  cur = e1str(out, cur, " S ");
  cur = e1i64(out, cur, start);
  cur = e1str(out, cur, " G ");
  cur = e1i64(out, cur, goal);
  cur = e1str(out, cur, " PLAN");
  let i:i64 = 0;
  while(i < plen) {
    cur = e1ch(out, cur, 32);
    cur = e1i64(out, cur, plan[i] as i64);
    i = i + 1;
  }
  cur = e1str(out, cur, " REACH ");
  cur = e1i64(out, cur, reach);
  cur = e1str(out, cur, " DBL2 ");
  cur = e1i64(out, cur, dbl2(plan, plen));
  cur = e1str(out, cur, " SIMS ");
  cur = e1i64(out, cur, ig(simsc, 0));
  cur = e1ch(out, cur, 10);
  return cur;
}
fn emit_belief(out:[]u8, cur:i64, id:i64, v:i64)i64 {
  cur = e1str(out, cur, "BELIEF ");
  cur = e1i64(out, cur, id);
  cur = e1ch(out, cur, 32);
  cur = e1i64(out, cur, v);
  cur = e1ch(out, cur, 10);
  return cur;
}
fn emit_bar(out:[]u8, cur:i64, name:[]u8, v:i64)i64 {
  cur = e1str(out, cur, name);
  cur = e1ch(out, cur, 32);
  if(v == 1) { cur = e1str(out, cur, "PASS\n"); } else { cur = e1str(out, cur, "FAIL\n"); }
  return cur;
}
// One planning task: plan, independently verify, emit.
fn task(tag:[]u8, tid:[]u8, start:i64, goal:i64, belx:[]u8, run:i64, p3:i64, pre:[]u8, plan:[]u8, plen:[]u8, simsc:[]u8, dummy:[]u8, fcell:[]u8, rcell:[]u8, out:[]u8, cur:i64)i64 {
  let f:i64 = do_plan(start, goal, belx, run, p3, pre, plan, plen, simsc);
  let r:i64 = verify_plan(plan, ig(plen, 0), start, goal, run, p3, dummy);
  is(fcell, 0, f);
  is(rcell, 0, r);
  cur = emit_plan(out, cur, tag, tid, plan, ig(plen, 0), start, goal, r, simsc);
  return cur;
}

fn main()i32 {
  let out:[]u8 = z_alloc(8192);
  let cur:i64 = 0;
  let bel:[]u8 = z_alloc(3);
  let belc:[]u8 = z_alloc(3);
  let bel2:[]u8 = z_alloc(3);
  let pre:[]u8 = z_alloc(16);
  let plan:[]u8 = z_alloc(16);
  let plen:[]u8 = z_alloc(8);
  let simsc:[]u8 = z_alloc(8);
  let dummy:[]u8 = z_alloc(8);
  let fc:[]u8 = z_alloc(8);
  let rc:[]u8 = z_alloc(8);

  // Frozen predicted plans.
  let e25:[]u8 = z_alloc(8);
  e25[0] = 2; e25[1] = 5;
  let e2:[]u8 = z_alloc(8);
  e2[0] = 2;
  let e275:[]u8 = z_alloc(8);
  e275[0] = 2; e275[1] = 2; e275[2] = 2; e275[3] = 2;
  e275[4] = 2; e275[5] = 2; e275[6] = 2; e275[7] = 5;
  let e277:[]u8 = z_alloc(8);
  e277[0] = 2; e277[1] = 2; e277[2] = 2; e277[3] = 2;
  e277[4] = 2; e277[5] = 2; e277[6] = 2; e277[7] = 7;
  let e222:[]u8 = z_alloc(8);
  e222[0] = 2; e222[1] = 2; e222[2] = 2;

  cur = e1str(out, cur, "FC1 IDEMPOTENCE-CONSTRAINS-PLANNING\n");

  // ---- Phase 1: Run 1 acquisition ----
  acquire(2, bel, 1, 0);
  acquire(5, bel, 1, 0);
  acquire(7, bel, 1, 0);
  cur = e1str(out, cur, "RUN 1 ACQUIRE\n");
  cur = emit_belief(out, cur, 2, bel[0] as i64);
  cur = emit_belief(out, cur, 5, bel[1] as i64);
  cur = emit_belief(out, cur, 7, bel[2] as i64);
  let k1:i64 = (bel[0] as i64) * (1 - (bel[1] as i64)) * (1 - (bel[2] as i64));

  // ---- Phase 2: Run 1 planning ----
  cur = e1str(out, cur, "RUN 1 PHASE 2\n");
  cur = task("EXP", "T1", 12, 9, bel, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k3t1:i64 = ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e25, 2);
  cur = task("CTL", "T1", 12, 9, belc, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k4t1:i64 = ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e275, 8);
  cur = task("EXP", "T2", 15, 0, bel, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k3t2:i64 = ig(fc, 0) * ig(rc, 0);
  if(dbl2(plan, ig(plen, 0)) != 0) { k3t2 = 0; }
  cur = task("CTL", "T2", 15, 0, belc, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k4t2:i64 = ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e277, 8);
  cur = task("EXP", "T3", 12, 8, bel, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k3t3:i64 = ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e2, 1);
  cur = task("CTL", "T3", 12, 8, belc, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k4t3:i64 = ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e2, 1);
  cur = task("EXP", "T4", 5, 9, bel, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k3t4:i64 = ig(fc, 0) * ig(rc, 0);
  if(dbl2(plan, ig(plen, 0)) != 0) { k3t4 = 0; }
  cur = task("CTL", "T4", 5, 9, belc, 1, 0, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k4t4:i64 = ig(fc, 0) * ig(rc, 0);
  if(dbl2(plan, ig(plen, 0)) < 1) { k4t4 = 0; }
  let k3:i64 = k3t1 * k3t2 * k3t3 * k3t4;
  let k4:i64 = k4t1 * k4t2 * k4t3 * k4t4;

  // ---- Run 2: permuted acquisition only ----
  cur = e1str(out, cur, "RUN 2 ACQUIRE PERMUTED\n");
  acquire(2, bel2, 2, 0);
  acquire(5, bel2, 2, 0);
  acquire(7, bel2, 2, 0);
  cur = emit_belief(out, cur, 2, bel2[0] as i64);
  cur = emit_belief(out, cur, 5, bel2[1] as i64);
  cur = emit_belief(out, cur, 7, bel2[2] as i64);
  let k2:i64 = (1 - (bel2[0] as i64)) * (1 - (bel2[1] as i64)) * (bel2[2] as i64);

  // ---- Phase 3: revision (Run 1 world, op 2 now non-idempotent) ----
  cur = e1str(out, cur, "PHASE 3 REVISION\n");
  acquire(2, bel, 1, 1);
  cur = emit_belief(out, cur, 2, bel[0] as i64);
  cur = task("EXP", "T3B", 12, 15, bel, 1, 1, pre, plan, plen, simsc, dummy, fc, rc, out, cur);
  let k5:i64 = (1 - (bel[0] as i64)) * ig(fc, 0) * ig(rc, 0) * plan_eq(plan, ig(plen, 0), e222, 3);

  // ---- Bars ----
  cur = e1str(out, cur, "BARS\n");
  cur = emit_bar(out, cur, "K-FC-1", k1);
  cur = emit_bar(out, cur, "K-FC-2", k2);
  cur = emit_bar(out, cur, "K-FC-3", k3);
  cur = emit_bar(out, cur, "K-FC-4", k4);
  cur = emit_bar(out, cur, "K-FC-5", k5);
  let all:i64 = k1 * k2 * k3 * k4 * k5;
  if(all == 1) { cur = e1str(out, cur, "ALL PASS\n"); } else { cur = e1str(out, cur, "SOME FAIL\n"); }
  let w:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(out) as i64), cur, 0, 0, 0);
  if(w < 0) { return 2; }
  if(all == 1) { return 0; }
  return 1;
}

// fc_main.zag -- Learner-built constraint channel experiment.
// Question: can the LEARNER build the constraint channel itself from
// experience (labeled judgments), or is the ABI plus faithful
// compilation always researcher-defined?
// World: W16 codec (true divisor 16), literals {1,3,5,7}. The learner
// receives 6 accept and 6 reject judgments and must construct
// registry clauses via generic Occam separation. It never sees the
// divisor, never induces a grammar, never computes a gcd.
// Arms: 0 = no channel (blind pick; judgments inert);
//       1 = researcher-compiled faithful channel (control);
//       2 = learner-built channel.
// Composer: grammar-blind, 78 candidates per trial over codec
// hypotheses h in {8,16,32}, blind rule minimize (nf,f0,f1,f2).
// Pure Zag. Deterministic: fixed judgments, fixed pools, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ SECTION: generic machinery (alloc, cells, emit) ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ============ SECTION: generic constraint registry ============
// Domain-neutral clause ABI, reused from xdomain_grammar. A clause is
// (field, xform, k, lo, hi): xform 0 = identity, 1 = integer divide
// by k, 2 = remainder mod k. The registry knows nothing about the
// domain. Two registry instances: R at base 10 (researcher-written),
// L at base 20 (learner-written). Layout per instance: base+0 =
// nfields, base+1 = nclauses, base+2.. = clauses (5 cells each).

fn reg_clause(S:[]u8,rb:i32,i:i32,field:i32,xform:i32,k:i32,lo:i32,hi:i32)void {
  let b:i32=rb+2+i*5;
  ss(S,b,field); ss(S,b+1,xform); ss(S,b+2,k); ss(S,b+3,lo); ss(S,b+4,hi);
  return;
}
fn reg_check(S:[]u8,rb:i32,cb:i32,nf:i32)i32 {
  if(nf!=sg(S,rb)){return 0;}
  let n:i32=sg(S,rb+1);
  let i:i32=0;
  while(i<n){
    let b:i32=rb+2+i*5;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=sg(S,cb+1+field);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ SECTION: teaching (judgments as experience) ============
// Learner-state cells: accepts at 100+j*3 = (nf,f0,f1), j=0..5,
// naj at 130; rejects at 140+j*4 = (nf,f0,f1,f2), j=0..5, nrj at 170.
// These are the learner's experience. The learner builds the channel
// from them; it is never told what makes an accept acceptable.

fn fc_teach(S:[]u8)void {
  ss(S,100,2); ss(S,101,19); ss(S,102,87);
  ss(S,103,2); ss(S,104,119); ss(S,105,17);
  ss(S,106,2); ss(S,107,51); ss(S,108,85);
  ss(S,109,2); ss(S,110,23); ss(S,111,113);
  ss(S,112,2); ss(S,113,81); ss(S,114,55);
  ss(S,115,2); ss(S,116,117); ss(S,117,49);
  ss(S,130,6);
  ss(S,140,1); ss(S,141,19); ss(S,142,0); ss(S,143,0);
  ss(S,144,3); ss(S,145,19); ss(S,146,87); ss(S,147,51);
  ss(S,148,2); ss(S,149,11); ss(S,150,47); ss(S,151,0);
  ss(S,152,2); ss(S,153,35); ss(S,154,167); ss(S,155,0);
  ss(S,156,2); ss(S,157,3); ss(S,158,87); ss(S,159,0);
  ss(S,160,2); ss(S,161,129); ss(S,162,51); ss(S,163,0);
  ss(S,170,6);
  return;
}

// ============ SECTION: learner constraint induction ============
// Generic Occam separation. Vocabulary: field, feature, range,
// accept, reject, clause. No domain concepts appear here.
// Feature library (domain-neutral): identity; div-by-k and mod-by-k
// for k in {2,4,8,16,32}. Eleven features indexed 0..10.
// For each field f in {0,1} and feature p, the accept range
// [mn,mx] is measured over the accepts. Clause sets are tried by
// increasing cardinality (1, then 2), lexicographic order on
// (field, feature); the first set whose conjunction rejects every
// length-2 reject is written to the L registry. Rejects of other
// lengths are separated by the registry's nfields check.

fn feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==2){return 2;}
  if(p==3){return 1;} if(p==4){return 2;}
  if(p==5){return 1;} if(p==6){return 2;}
  if(p==7){return 1;} if(p==8){return 2;}
  if(p==9){return 1;} return 2;
}
fn feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  if(p==9){return 32;} return 32;
}
fn feat_val(v:i32,p:i32)i32 {
  let xf:i32=feat_xf(p);
  let k:i32=feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn rej_hit(S:[]u8,f:i32,p:i32,mn:i32,mx:i32,j:i32)i32 {
  let v:i32=sg(S,140+j*4+1+f);
  let fv:i32=feat_val(v,p);
  if(fv<mn){return 1;}
  if(fv>mx){return 1;}
  return 0;
}
fn set1_ok(S:[]u8,f:i32,p:i32)i32 {
  let mn:i32=sg(S,500+(f*11+p)*2);
  let mx:i32=sg(S,500+(f*11+p)*2+1);
  let j:i32=0;
  while(j<6){
    if(sg(S,140+j*4)==2){
      if(rej_hit(S,f,p,mn,mx,j)==0){return 0;}
    }
    j=j+1;
  }
  return 1;
}
fn set2_ok(S:[]u8,f0:i32,p0:i32,f1:i32,p1:i32)i32 {
  let mn0:i32=sg(S,500+(f0*11+p0)*2);
  let mx0:i32=sg(S,500+(f0*11+p0)*2+1);
  let mn1:i32=sg(S,500+(f1*11+p1)*2);
  let mx1:i32=sg(S,500+(f1*11+p1)*2+1);
  let j:i32=0;
  while(j<6){
    if(sg(S,140+j*4)==2){
      let h0:i32=rej_hit(S,f0,p0,mn0,mx0,j);
      let h1:i32=rej_hit(S,f1,p1,mn1,mx1,j);
      if(h0==0){ if(h1==0){return 0;} }
    }
    j=j+1;
  }
  return 1;
}
fn fc_induce(S:[]u8)i32 {
  let f:i32=0;
  while(f<2){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<6){
        let fv:i32=feat_val(sg(S,100+j*3+1+f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      ss(S,500+(f*11+p)*2,mn);
      ss(S,500+(f*11+p)*2+1,mx);
      p=p+1;
    }
    f=f+1;
  }
  let f2:i32=0;
  while(f2<2){
    let p2:i32=0;
    while(p2<11){
      if(set1_ok(S,f2,p2)==1){
        ss(S,40,2); ss(S,41,1);
        reg_clause(S,40,0,f2,feat_xf(p2),feat_k(p2),
          sg(S,500+(f2*11+p2)*2),sg(S,500+(f2*11+p2)*2+1));
        ss(S,9,1);
        return 1;
      }
      p2=p2+1;
    }
    f2=f2+1;
  }
  let a:i32=0;
  while(a<22){
    let b:i32=a+1;
    while(b<22){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=b/11; let pb:i32=b-fb*11;
      if(set2_ok(S,fa,pa,fb,pb)==1){
        ss(S,40,2); ss(S,41,2);
        reg_clause(S,40,0,fa,feat_xf(pa),feat_k(pa),
          sg(S,500+(fa*11+pa)*2),sg(S,500+(fa*11+pa)*2+1));
        reg_clause(S,40,1,fb,feat_xf(pb),feat_k(pb),
          sg(S,500+(fb*11+pb)*2),sg(S,500+(fb*11+pb)*2+1));
        ss(S,9,1);
        return 1;
      }
      b=b+1;
    }
    a=a+1;
  }
  ss(S,9,0);
  return 0;
}

// ============ SECTION: researcher channel (control) ============
// The researcher writes the faithful clauses directly. This is the
// researcher-defined compilation: knowledge of the decode structure
// lives here, not in the learner.

fn fc_researcher(S:[]u8)void {
  ss(S,10,2); ss(S,11,4);
  reg_clause(S,10,0,0,1,16,1,7);
  reg_clause(S,10,1,0,2,16,1,7);
  reg_clause(S,10,2,1,1,16,1,7);
  reg_clause(S,10,3,1,2,16,1,7);
  return;
}

// ============ SECTION: composer (judgment-blind) ============
// Candidate generation over codec hypotheses {8,16,32}; blind pick
// rule minimize (nf,f0,f1,f2). Arm 0: no filter. Arm 1: filter
// through the R registry. Arm 2: filter through the L registry.
// The arm flag is a harness condition selector; generation and the
// pick rule take no domain input.

fn hyp(i:i32)i32 {
  if(i==0){return 8;}
  if(i==1){return 16;}
  return 32;
}
fn Lget(S:[]u8,i:i32)i32 { return sg(S,700+i); }
fn better(nf:i32,f0:i32,f1:i32,f2:i32,bnf:i32,bf0:i32,bf1:i32,bf2:i32)i32 {
  if(nf<bnf){return 1;} if(nf>bnf){return 0;}
  if(f0<bf0){return 1;} if(f0>bf0){return 0;}
  if(f1<bf1){return 1;} if(f1>bf1){return 0;}
  if(f2<bf2){return 1;}
  return 0;
}
fn one_cand(S:[]u8,arm:i32,nf:i32,f0:i32,f1:i32,f2:i32)void {
  ss(S,300,nf); ss(S,301,f0); ss(S,302,f1); ss(S,303,f2);
  if(arm==0){
    if(better(nf,f0,f1,f2,sg(S,800),sg(S,801),sg(S,802),sg(S,803))==1){
      ss(S,800,nf); ss(S,801,f0); ss(S,802,f1); ss(S,803,f2);
    }
    return;
  }
  let rb:i32=10; let base:i32=810; let found:i32=814;
  if(arm==2){ rb=40; base=820; found=824; }
  if(reg_check(S,rb,300,nf)==0){ return; }
  if(sg(S,found)==0 || better(nf,f0,f1,f2,sg(S,base),sg(S,base+1),sg(S,base+2),sg(S,base+3))==1){
    ss(S,base,nf); ss(S,base+1,f0); ss(S,base+2,f1); ss(S,base+3,f2); ss(S,found,1);
  }
  return;
}
fn eval_all(S:[]u8,arm:i32)void {
  let h3:i32=0;
  while(h3<3){
    let h:i32=hyp(h3);
    let l0:i32=sg(S,700); let l1:i32=sg(S,701);
    let l2:i32=sg(S,702); let l3:i32=sg(S,703);
    one_cand(S,arm,1,h*l0+l1,0,0);
    let i0:i32=0;
    while(i0<4){
      let i1:i32=i0+1;
      while(i1<4){
        let j0:i32=-1; let j1:i32=-1;
        let q:i32=0;
        while(q<4){
          if(q!=i0){ if(q!=i1){ if(j0==-1){j0=q;} else {j1=q;} } }
          q=q+1;
        }
        let s1:i32=0;
        while(s1<2){
          let s2:i32=0;
          while(s2<2){
            let w1a:i32=Lget(S,i0); let w1b:i32=Lget(S,i1);
            if(s1==1){ w1a=Lget(S,i1); w1b=Lget(S,i0); }
            let w2a:i32=Lget(S,j0); let w2b:i32=Lget(S,j1);
            if(s2==1){ w2a=Lget(S,j1); w2b=Lget(S,j0); }
            one_cand(S,arm,2,h*w1a+w1b,h*w2a+w2b,0);
            s2=s2+1;
          }
          s1=s1+1;
        }
        i1=i1+1;
      }
      i0=i0+1;
    }
    one_cand(S,arm,3,h*l0+l1,h*l2+l2,h*l3+l3);
    h3=h3+1;
  }
  return;
}

// ============ SECTION: fidelity probe (measurement only) ============
// Independent direct check against world truth (D=16, range [1,7]).
// Used only to score reg_check agreement; never by the composer.

fn direct_check(S:[]u8,cb:i32,nf:i32)i32 {
  if(nf!=2){return 0;}
  let i:i32=0;
  while(i<2){
    let fv:i32=sg(S,cb+1+i);
    let qq:i32=fv/16; let rr:i32=fv-qq*16;
    if(qq<1){return 0;} if(qq>7){return 0;}
    if(rr<1){return 0;} if(rr>7){return 0;}
    i=i+1;
  }
  return 1;
}
fn probe_cand(S:[]u8,FC:[]u8,rb:i32,ag:i32,tt:i32,nf:i32,f0:i32,f1:i32,f2:i32)void {
  ss(S,300,nf); ss(S,301,f0); ss(S,302,f1); ss(S,303,f2);
  let dv:i32=direct_check(S,300,nf);
  let rv:i32=reg_check(S,rb,300,nf);
  if(dv==rv){ ss(FC,ag,sg(FC,ag)+1); }
  ss(FC,tt,sg(FC,tt)+1);
  return;
}
fn probe_all(S:[]u8,FC:[]u8,rb:i32,ag:i32,tt:i32)void {
  let h3:i32=0;
  while(h3<3){
    let h:i32=hyp(h3);
    let l0:i32=sg(S,700); let l1:i32=sg(S,701);
    let l2:i32=sg(S,702); let l3:i32=sg(S,703);
    probe_cand(S,FC,rb,ag,tt,1,h*l0+l1,0,0);
    let i0:i32=0;
    while(i0<4){
      let i1:i32=i0+1;
      while(i1<4){
        let j0:i32=-1; let j1:i32=-1;
        let q:i32=0;
        while(q<4){
          if(q!=i0){ if(q!=i1){ if(j0==-1){j0=q;} else {j1=q;} } }
          q=q+1;
        }
        let s1:i32=0;
        while(s1<2){
          let s2:i32=0;
          while(s2<2){
            let w1a:i32=Lget(S,i0); let w1b:i32=Lget(S,i1);
            if(s1==1){ w1a=Lget(S,i1); w1b=Lget(S,i0); }
            let w2a:i32=Lget(S,j0); let w2b:i32=Lget(S,j1);
            if(s2==1){ w2a=Lget(S,j1); w2b=Lget(S,j0); }
            probe_cand(S,FC,rb,ag,tt,2,h*w1a+w1b,h*w2a+w2b,0);
            s2=s2+1;
          }
          s1=s1+1;
        }
        i1=i1+1;
      }
      i0=i0+1;
    }
    probe_cand(S,FC,rb,ag,tt,3,h*l0+l1,h*l2+l2,h*l3+l3);
    h3=h3+1;
  }
  return;
}

// ============ SECTION: driver ============

fn pl(t:i32,i:i32)i32 {
  if(t==0){ if(i==0){return 1;} if(i==1){return 3;} if(i==2){return 5;} return 7; }
  if(t==1){ if(i==0){return 1;} if(i==1){return 1;} if(i==2){return 7;} return 7; }
  if(t==2){ if(i==0){return 3;} if(i==1){return 5;} if(i==2){return 7;} return 1; }
  if(t==3){ return 5; }
  if(t==4){ if(i==0){return 7;} if(i==1){return 3;} if(i==2){return 1;} return 5; }
  if(i==0){return 1;} if(i==1){return 7;} if(i==2){return 3;} return 5;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  let FC:[]u8=z_alloc(32);
  let S:[]u8=z_alloc(4096);
  fc_teach(S);
  cur=e1str(OUT,cur,"FC-WORLD D0=16\n");
  cur=e1str(OUT,cur,"FC-JUDGMENTS naj=6 nrj=6\n");
  let ir:i32=fc_induce(S);
  cur=e1str(OUT,cur,"FC-INDUCE ok=");
  cur=e1i64(OUT,cur,ir as i64);
  cur=e1str(OUT,cur," nfields=");
  cur=e1i64(OUT,cur,sg(S,40) as i64);
  cur=e1str(OUT,cur," nclauses=");
  cur=e1i64(OUT,cur,sg(S,41) as i64);
  cur=e1str(OUT,cur,"\n");
  let li:i32=0;
  while(li<sg(S,41)){
    let cb:i32=42+li*5;
    cur=e1str(OUT,cur,"FC-CLAUSE-L i=");
    cur=e1i64(OUT,cur,li as i64);
    cur=e1str(OUT,cur," field=");
    cur=e1i64(OUT,cur,sg(S,cb) as i64);
    cur=e1str(OUT,cur," xform=");
    cur=e1i64(OUT,cur,sg(S,cb+1) as i64);
    cur=e1str(OUT,cur," k=");
    cur=e1i64(OUT,cur,sg(S,cb+2) as i64);
    cur=e1str(OUT,cur," lo=");
    cur=e1i64(OUT,cur,sg(S,cb+3) as i64);
    cur=e1str(OUT,cur," hi=");
    cur=e1i64(OUT,cur,sg(S,cb+4) as i64);
    cur=e1str(OUT,cur,"\n");
    li=li+1;
  }
  fc_researcher(S);
  cur=e1str(OUT,cur,"FC-RESEARCHER nfields=");
  cur=e1i64(OUT,cur,sg(S,10) as i64);
  cur=e1str(OUT,cur," nclauses=");
  cur=e1i64(OUT,cur,sg(S,11) as i64);
  cur=e1str(OUT,cur,"\n");
  let ri:i32=0;
  while(ri<sg(S,11)){
    let cb2:i32=12+ri*5;
    cur=e1str(OUT,cur,"FC-CLAUSE-R i=");
    cur=e1i64(OUT,cur,ri as i64);
    cur=e1str(OUT,cur," field=");
    cur=e1i64(OUT,cur,sg(S,cb2) as i64);
    cur=e1str(OUT,cur," xform=");
    cur=e1i64(OUT,cur,sg(S,cb2+1) as i64);
    cur=e1str(OUT,cur," k=");
    cur=e1i64(OUT,cur,sg(S,cb2+2) as i64);
    cur=e1str(OUT,cur," lo=");
    cur=e1i64(OUT,cur,sg(S,cb2+3) as i64);
    cur=e1str(OUT,cur," hi=");
    cur=e1i64(OUT,cur,sg(S,cb2+4) as i64);
    cur=e1str(OUT,cur,"\n");
    ri=ri+1;
  }
  let tn:i32=0; let tr:i32=0; let tl:i32=0;
  let t:i32=0;
  while(t<6){
    let l0:i32=pl(t,0); let l1:i32=pl(t,1);
    let l2:i32=pl(t,2); let l3:i32=pl(t,3);
    ss(S,700,l0); ss(S,701,l1); ss(S,702,l2); ss(S,703,l3);
    ss(S,800,9999); ss(S,801,0); ss(S,802,0); ss(S,803,0);
    ss(S,810,9999); ss(S,811,0); ss(S,812,0); ss(S,813,0); ss(S,814,0);
    ss(S,820,9999); ss(S,821,0); ss(S,822,0); ss(S,823,0); ss(S,824,0);
    eval_all(S,0);
    let nok:i32=direct_check(S,800,sg(S,800));
    eval_all(S,1);
    let rok:i32=direct_check(S,810,sg(S,810));
    eval_all(S,2);
    let lok:i32=direct_check(S,820,sg(S,820));
    probe_all(S,FC,10,0,1);
    probe_all(S,FC,40,2,3);
    tn=tn+nok; tr=tr+rok; tl=tl+lok;
    cur=e1str(OUT,cur,"FC-TRIAL t=");
    cur=e1i64(OUT,cur,t as i64);
    cur=e1str(OUT,cur," pool=");
    cur=e1i64(OUT,cur,l0 as i64);
    cur=e1str(OUT,cur,",");
    cur=e1i64(OUT,cur,l1 as i64);
    cur=e1str(OUT,cur,",");
    cur=e1i64(OUT,cur,l2 as i64);
    cur=e1str(OUT,cur,",");
    cur=e1i64(OUT,cur,l3 as i64);
    cur=e1str(OUT,cur," N:nf=");
    cur=e1i64(OUT,cur,sg(S,800) as i64);
    cur=e1str(OUT,cur," f0=");
    cur=e1i64(OUT,cur,sg(S,801) as i64);
    cur=e1str(OUT,cur," ok=");
    cur=e1i64(OUT,cur,nok as i64);
    cur=e1str(OUT,cur," R:nf=");
    cur=e1i64(OUT,cur,sg(S,810) as i64);
    cur=e1str(OUT,cur," f0=");
    cur=e1i64(OUT,cur,sg(S,811) as i64);
    cur=e1str(OUT,cur," f1=");
    cur=e1i64(OUT,cur,sg(S,812) as i64);
    cur=e1str(OUT,cur," found=");
    cur=e1i64(OUT,cur,sg(S,814) as i64);
    cur=e1str(OUT,cur," ok=");
    cur=e1i64(OUT,cur,rok as i64);
    cur=e1str(OUT,cur," L:nf=");
    cur=e1i64(OUT,cur,sg(S,820) as i64);
    cur=e1str(OUT,cur," f0=");
    cur=e1i64(OUT,cur,sg(S,821) as i64);
    cur=e1str(OUT,cur," f1=");
    cur=e1i64(OUT,cur,sg(S,822) as i64);
    cur=e1str(OUT,cur," found=");
    cur=e1i64(OUT,cur,sg(S,824) as i64);
    cur=e1str(OUT,cur," ok=");
    cur=e1i64(OUT,cur,lok as i64);
    cur=e1str(OUT,cur,"\n");
    t=t+1;
  }
  cur=e1str(OUT,cur,"FC-FIDELITY-R agree=");
  cur=e1i64(OUT,cur,sg(FC,0) as i64);
  cur=e1str(OUT,cur," total=");
  cur=e1i64(OUT,cur,sg(FC,1) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FC-FIDELITY-L agree=");
  cur=e1i64(OUT,cur,sg(FC,2) as i64);
  cur=e1str(OUT,cur," total=");
  cur=e1i64(OUT,cur,sg(FC,3) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FC-VERDICT N_ok=");
  cur=e1i64(OUT,cur,tn as i64);
  cur=e1str(OUT,cur,"/6 R_ok=");
  cur=e1i64(OUT,cur,tr as i64);
  cur=e1str(OUT,cur,"/6 L_ok=");
  cur=e1i64(OUT,cur,tl as i64);
  cur=e1str(OUT,cur,"/6\n");
  cur=e1str(OUT,cur,"FC-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

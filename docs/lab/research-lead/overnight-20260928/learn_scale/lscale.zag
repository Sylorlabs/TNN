// lscale.zag -- learning-to-learn scaling experiment.
// Prereg de63550fa frozen before this file. Pure Zag. No Python.
// Three conditions (FRESH / RETAINED / CONTROL) x six families
// (A,B,C,D,E related F1 LIN instances; X adversarial F2 EXC).
// Metric: examples to criterion per family per condition.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen family specs (prereg section 2) ----
fn fam_a(f:i32)i32 {
  if(f==0){return 2;}
  if(f==1){return 3;}
  if(f==2){return 1;}
  if(f==3){return 5;}
  if(f==4){return 2;}
  return 0;
}
fn fam_b(f:i32)i32 {
  if(f==0){return 1;}
  if(f==1){return 5;}
  if(f==2){return 0;}
  if(f==3){return 3;}
  if(f==4){return 9;}
  return 0;
}
fn fam_base(f:i32)i32 {
  if(f==0){return 10;}
  if(f==1){return 1000;}
  if(f==2){return 2000;}
  if(f==3){return 3000;}
  if(f==4){return 4000;}
  return 5000;
}
fn true_subj(f:i32,i:i32)i32 { return fam_base(f)+i; }
fn true_obj(f:i32,i:i32)i32 {
  if(f==5){
    if(i==1){return 3;}
    return 7;
  }
  let s:i32=true_subj(f,i);
  return fam_a(f)*s+fam_b(f);
}

// ---- example buffer ----
fn bget(b:[]u8,i:i32)i32 { return get32(b,i*4); }
fn bset(b:[]u8,i:i32,v:i32)void { set32(b,i*4,v); return; }

// ---- form fitting (prereg section 3) ----
fn fit_const(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<1){return 0;}
  let c:i32=bget(bo,0);
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=c){return 0;}
    i=i+1;
  }
  set32(p,0,c);
  return 1;
}
fn fit_lin(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<2){return 0;}
  let s0:i32=bget(bs,0);
  let o0:i32=bget(bo,0);
  let s1:i32=bget(bs,1);
  let o1:i32=bget(bo,1);
  let ds:i32=s1-s0;
  let do:i32=o1-o0;
  if(ds==0){return 0;}
  let a:i32=do/ds;
  if(a*ds!=do){return 0;}
  let b:i32=o0-a*s0;
  let i:i32=2;
  while(i<n){
    if(a*bget(bs,i)+b!=bget(bo,i)){return 0;}
    i=i+1;
  }
  set32(p,0,a);
  set32(p,4,b);
  return 1;
}
fn fit_exc(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<3){return 0;}
  let d:i32=bget(bo,0);
  let odd:i32=-1;
  let nodd:i32=0;
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=d){nodd=nodd+1; odd=i;}
    i=i+1;
  }
  if(nodd==1){
    set32(p,0,d);
    set32(p,4,bget(bs,odd));
    set32(p,8,bget(bo,odd));
    return 1;
  }
  if(nodd==n-1){
    let d2:i32=bget(bo,1);
    let j:i32=2;
    let ok:i32=1;
    while(j<n){
      if(bget(bo,j)!=d2){ok=0;}
      j=j+1;
    }
    if(ok==1){
      if(d2!=d){
        set32(p,0,d2);
        set32(p,4,bget(bs,0));
        set32(p,8,d);
        return 1;
      }
    }
  }
  return 0;
}
fn fit_form(form:i32,bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(form==0){return fit_const(bs,bo,n,p);}
  if(form==1){return fit_lin(bs,bo,n,p);}
  return fit_exc(bs,bo,n,p);
}
fn predict(form:i32,st:[]u8,subj:i32)i32 {
  if(form==0){return get32(st,4);}
  if(form==1){return get32(st,4)*subj+get32(st,8);}
  if(subj==get32(st,8)){return get32(st,12);}
  return get32(st,4);
}

// ---- prior order: descending uses, ties -> lower form index ----
fn prior_order(st:[]u8,ord:[]u8)void {
  let p0:i32=0;
  let p1:i32=0;
  let p2:i32=0;
  let k:i32=0;
  while(k<3){
    let best:i32=-1;
    let bestu:i32=-1;
    let f:i32=0;
    while(f<3){
      let pl:i32=0;
      if(f==0){pl=p0;}
      else { if(f==1){pl=p1;} else {pl=p2;} }
      if(pl==0){
        let u:i32=get32(st,16+f*4);
        if(u>bestu){bestu=u; best=f;}
      }
      f=f+1;
    }
    set32(ord,k*4,best);
    if(best==0){p0=1;}
    else { if(best==1){p1=1;} else {p2=1;} }
    k=k+1;
  }
  return;
}

// ---- verification need: V = max(1, ceil(V0 / 2^uses)) ----
fn verify_need(st:[]u8,form:i32)i32 {
  let u:i32=get32(st,16+form*4);
  let pw:i32=1;
  let k:i32=0;
  while(k<u){pw=pw*2; k=k+1;}
  let v:i32=(14+pw-1)/pw;
  if(v<1){v=1;}
  return v;
}

// ---- state block layout ----
// 0 live_form | 4 p0 | 8 p1 | 12 p2 | 16 uses0 | 20 uses1 | 24 uses2 |
// 28 str0 | 32 str1 | 36 str2 | 40 frozen_uses
// ---- out block layout ----
// 0 cost | 4 adopted | 8 u0b | 12 u1b | 16 u2b | 20 V |
// 24 refit (1 ok, 0 fail, -1 na) | 28 s0a | 32 s1a | 36 s2a
fn run_family(st:[]u8,fam:i32,out:[]u8)void {
  let bs:[]u8=z_alloc(40*4);
  let bo:[]u8=z_alloc(40*4);
  let tp:[]u8=z_alloc(12);
  let ord:[]u8=z_alloc(12);
  let cost:i32=0;
  let adopted:i32=-2;
  let v_used:i32=0;
  let refit_out:i32=-1;
  set32(out,8,get32(st,16));
  set32(out,12,get32(st,20));
  set32(out,16,get32(st,24));
  let ei:i32=0;
  let n:i32=0;
  let vc:i32=0;
  let wrong:i32=0;
  let V:i32=0;
  let live:i32=get32(st,0);
  let phase:i32=0;
  if(live>=0){phase=1;}
  let done:i32=0;
  while(done==0){
    if(phase==0){
      // DISCOVER
      let s:i32=true_subj(fam,ei);
      let o:i32=true_obj(fam,ei);
      bset(bs,n,s);
      bset(bo,n,o);
      n=n+1; ei=ei+1; cost=cost+1;
      if(n>=6){
        prior_order(st,ord);
        let k:i32=0;
        let found:i32=-1;
        while(k<3){
          let f:i32=get32(ord,k*4);
          if(fit_form(f,bs,bo,n,tp)==1){found=f; k=3;}
          else {k=k+1;}
        }
        if(found>=0){
          live=found;
          set32(st,0,found);
          set32(st,4,get32(tp,0));
          set32(st,8,get32(tp,4));
          set32(st,12,get32(tp,8));
          V=verify_need(st,found);
          v_used=V; vc=0; wrong=0;
          phase=2;
        } else {
          if(n>=40){adopted=-1; done=1;}
        }
      }
    } else {
      if(phase==1){
        // REFIT: buffer exactly R=4, fit live form
        while(n<4){
          let s2:i32=true_subj(fam,ei);
          let o2:i32=true_obj(fam,ei);
          bset(bs,n,s2);
          bset(bo,n,o2);
          n=n+1; ei=ei+1; cost=cost+1;
        }
        if(fit_form(live,bs,bo,4,tp)==1){
          refit_out=1;
          set32(st,4,get32(tp,0));
          set32(st,8,get32(tp,4));
          set32(st,12,get32(tp,8));
          V=verify_need(st,live);
          v_used=V; vc=0; wrong=0;
          phase=2;
        } else {
          // strike; KEEP the refuting examples, enter DISCOVER
          refit_out=0;
          set32(st,28+live*4,get32(st,28+live*4)+1);
          live=-1;
          set32(st,0,-1);
          phase=0;
        }
      } else {
        // VERIFY
        let s3:i32=true_subj(fam,ei);
        let o3:i32=true_obj(fam,ei);
        let pr:i32=predict(live,st,s3);
        ei=ei+1; cost=cost+1;
        if(pr==o3){vc=vc+1;}
        else {vc=0; wrong=wrong+1;}
        if(vc>=V){
          adopted=live;
          if(get32(st,40)==0){
            set32(st,16+live*4,get32(st,16+live*4)+1);
          }
          done=1;
        } else {
          if(wrong>=3){
            set32(st,28+live*4,get32(st,28+live*4)+1);
            live=-1;
            set32(st,0,-1);
            phase=0; n=0; vc=0; wrong=0;
          }
        }
      }
    }
  }
  set32(out,0,cost);
  set32(out,4,adopted);
  set32(out,20,v_used);
  set32(out,24,refit_out);
  set32(out,28,get32(st,28));
  set32(out,32,get32(st,32));
  set32(out,36,get32(st,36));
  return;
}

fn emit_trace(cond:[]u8,fam:i32,out:[]u8)void {
  emit("TR ");
  emit(cond);
  emit(" fam=");
  e64(fam);
  emit(" cost=");
  e64(get32(out,0));
  emit(" adopted=");
  e64(get32(out,4));
  emit(" uses_before=");
  e64(get32(out,8));
  emit(",");
  e64(get32(out,12));
  emit(",");
  e64(get32(out,16));
  emit(" V=");
  e64(get32(out,20));
  emit(" refit=");
  e64(get32(out,24));
  emit(" strikes_after=");
  e64(get32(out,28));
  emit(",");
  e64(get32(out,32));
  emit(",");
  e64(get32(out,36));
  emit("\n");
  return;
}

fn main()i32 {
  emit("LSCALE-START\n");
  emit("SPEC A F1 a=2 b=1 base=10\n");
  emit("SPEC B F1 a=3 b=5 base=1000\n");
  emit("SPEC C F1 a=1 b=0 base=2000\n");
  emit("SPEC D F1 a=5 b=3 base=3000\n");
  emit("SPEC E F1 a=2 b=9 base=4000\n");
  emit("SPEC X F2 d=7 exc_subj=5001 exc_obj=3 base=5000\n");
  emit("PARAMS BMIN=6 R=4 V0=14 WMAX=3 BMAX=40\n");
  // ---- FRESH ----
  let fc:[]u8=z_alloc(24);
  let fa:[]u8=z_alloc(24);
  let fam:i32=0;
  while(fam<6){
    let st:[]u8=z_alloc(44);
    set32(st,0,-1);
    let out:[]u8=z_alloc(40);
    run_family(st,fam,out);
    set32(fc,fam*4,get32(out,0));
    set32(fa,fam*4,get32(out,4));
    emit_trace("FRESH",fam,out);
    fam=fam+1;
  }
  // ---- RETAINED ----
  let rc:[]u8=z_alloc(24);
  let ra:[]u8=z_alloc(24);
  let rst:[]u8=z_alloc(44);
  set32(rst,0,-1);
  fam=0;
  while(fam<6){
    let out2:[]u8=z_alloc(40);
    run_family(rst,fam,out2);
    set32(rc,fam*4,get32(out2,0));
    set32(ra,fam*4,get32(out2,4));
    emit_trace("RETAINED",fam,out2);
    fam=fam+1;
  }
  let ret_s1:i32=get32(rst,32);
  // ---- CONTROL (uses frozen) ----
  let cc:[]u8=z_alloc(24);
  let ca:[]u8=z_alloc(24);
  let cst:[]u8=z_alloc(44);
  set32(cst,0,-1);
  set32(cst,40,1);
  fam=0;
  while(fam<6){
    let out3:[]u8=z_alloc(40);
    run_family(cst,fam,out3);
    set32(cc,fam*4,get32(out3,0));
    set32(ca,fam*4,get32(out3,4));
    emit_trace("CONTROL",fam,out3);
    fam=fam+1;
  }
  // ---- summary ----
  emit("FRESH_COSTS ");
  fam=0;
  while(fam<6){e64(get32(fc,fam*4)); emit(" "); fam=fam+1;}
  emit("\nRETAINED_COSTS ");
  fam=0;
  while(fam<6){e64(get32(rc,fam*4)); emit(" "); fam=fam+1;}
  emit("\nRETAINED_ADOPTED ");
  fam=0;
  while(fam<6){e64(get32(ra,fam*4)); emit(" "); fam=fam+1;}
  emit("\nCONTROL_COSTS ");
  fam=0;
  while(fam<6){e64(get32(cc,fam*4)); emit(" "); fam=fam+1;}
  emit("\nRET_STRIKE_F1 ");
  e64(ret_s1);
  emit("\n");
  // ---- kill bars ----
  let k1:i32=1;
  let rc0:i32=get32(rc,0);
  let rc1:i32=get32(rc,4);
  let rc2:i32=get32(rc,8);
  let rc3:i32=get32(rc,12);
  let rc4:i32=get32(rc,16);
  let rc5:i32=get32(rc,20);
  let fc0:i32=get32(fc,0);
  let fc1:i32=get32(fc,4);
  let fc2:i32=get32(fc,8);
  let fc3:i32=get32(fc,12);
  let fc4:i32=get32(fc,16);
  let fc5:i32=get32(fc,20);
  let ra5:i32=get32(ra,20);
  let k2a:i32=0;
  if(rc0>rc1){
    if(rc1>rc2){
      if(rc2>rc3){
        if(rc3>rc4){k2a=1;}
      }
    }
  }
  let k2b:i32=0;
  if(rc1<fc1){
    if(rc2<fc2){
      if(rc3<fc3){
        if(rc4<fc4){k2b=1;}
      }
    }
  }
  let k2c:i32=0;
  let rsum:i32=rc0+rc1+rc2+rc3+rc4;
  let fsum:i32=fc0+fc1+fc2+fc3+fc4;
  if(rsum*10<fsum*6){k2c=1;}
  let k2d:i32=0;
  let cc1:i32=get32(cc,4);
  let cc2:i32=get32(cc,8);
  let cc3:i32=get32(cc,12);
  let cc4:i32=get32(cc,16);
  if(cc1==cc2){
    if(cc2==cc3){
      if(cc3==cc4){k2d=1;}
    }
  }
  let k3a:i32=0;
  if(ret_s1>=1){
    if(ra5==2){k3a=1;}
  }
  let k3b:i32=0;
  if(rc5>=fc5){
    if(rc5<=fc5+6){k3b=1;}
  }
  let k3c:i32=0;
  if(ra5!=1){k3c=1;}
  emit("K1 ");
  e64(k1);
  emit(" K2A ");
  e64(k2a);
  emit(" K2B ");
  e64(k2b);
  emit(" K2C ");
  e64(k2c);
  emit(" K2D ");
  e64(k2d);
  emit(" K3A ");
  e64(k3a);
  emit(" K3B ");
  e64(k3b);
  emit(" K3C ");
  e64(k3c);
  emit("\n");
  if(k1==1){
    if(k2a==1){
      if(k2b==1){
        if(k2c==1){
          if(k3a==1){
            if(k3b==1){
              if(k3c==1){emit("VERDICT SCALE-TESTED\n");}
              else {emit("VERDICT SCALE-BLOCKED-K3C\n");}
            } else {emit("VERDICT SCALE-BLOCKED-K3B\n");}
          } else {emit("VERDICT SCALE-BLOCKED-K3A\n");}
        } else {emit("VERDICT SCALE-BLOCKED-K2C\n");}
      } else {emit("VERDICT SCALE-BLOCKED-K2B\n");}
    } else {emit("VERDICT SCALE-BLOCKED-K2A\n");}
  } else {emit("VERDICT SCALE-BLOCKED-K1\n");}
  emit("LSCALE-END\n");
  return 0;
}

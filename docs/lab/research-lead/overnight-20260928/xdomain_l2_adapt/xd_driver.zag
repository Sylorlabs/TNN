// xd_driver.zag -- XDOMAIN-L2-ADAPT battery (arms A1-A4, A6-A9).
//
// X (arithmetic SUM over price facts, [81,81,81]) and Y (planning
// ALLOC, [82,82,82]) are trained independently. The Z world needs
// only TWO allocation steps: a genuine length mismatch that defeats
// the full unified pipeline (C relseq, A contract, B ordering,
// trial). TRUNCATE-TAIL must truncate Y to its longest
// frontier-licensed prefix. The exact-reuse control (A5) runs under
// a separate no-adapt binary and must provably fail.
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn xd_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xd_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn xd_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// lowest-id live MAP with an outgoing type-16 edge, or -1.
fn xd_find_adapted(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    if(ismap==1){
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==m && eg(W,e,4)==16){return m;}
        e=e+1;
      }
    }
    m=m+1;
  }
  return -1;
}
// source MAP of adapted MAP a (type-16 target), or -1.
fn xd_adapt_src(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// count of type-16 edges workspace-wide.
fn xd_count_adapt(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn xd_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// Train X (SUM, relseq [81,81,81]) and Y (ALLOC, 3 steps,
// relseq [82,82,82]). out[0]=mapx, out[1]=mapy.
fn xd_train_xy(W:[]u8,out:[]u8)void {
  ev_teach(W,201,81,231); ev_teach(W,231,81,261); ev_teach(W,261,81,291);
  let x:i32=ev_query_adapt(W,201,91,291,0);
  emit("XD-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,301,82,311); ev_teach(W,311,82,321); ev_teach(W,321,82,331);
  let y:i32=ev_query_adapt(W,301,92,331,0);
  emit("XD-Y ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}
// Train X as above and Y with FOUR steps (relseq [82,82,82,82]).
fn xd_train_xy4(W:[]u8,out:[]u8)void {
  ev_teach(W,201,81,231); ev_teach(W,231,81,261); ev_teach(W,261,81,291);
  let x:i32=ev_query_adapt(W,201,91,291,0);
  emit("XD-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,301,82,311); ev_teach(W,311,82,321); ev_teach(W,321,82,331);
  ev_teach(W,331,82,341);
  let y:i32=ev_query_adapt(W,301,92,341,0);
  emit("XD-Y4 ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}

// ---- Z fact sets (amended battery) ----
fn xd_zfacts_a1(W:[]u8)void {
  ev_teach(W,101,81,102); ev_teach(W,102,81,103); ev_teach(W,103,81,104);
  ev_teach(W,104,82,105); ev_teach(W,105,82,106);
  return;
}
fn xd_zfacts_a3(W:[]u8)void {
  ev_teach(W,101,81,102); ev_teach(W,102,81,103); ev_teach(W,103,81,104);
  return;
}
fn xd_zfacts_a4(W:[]u8)void {
  ev_teach(W,101,81,102); ev_teach(W,102,81,103); ev_teach(W,103,81,104);
  ev_teach(W,104,82,105); ev_teach(W,105,82,106); ev_teach(W,106,82,107);
  return;
}

// ---- A1: L2-TREAT (truncate MAP_Y [82,82,82] -> [82,82]) ----
fn a1_l2_treat(W:[]u8)void {
  emit("=== A1-L2-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xd_gap(W);
  xd_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A1-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let a:i32=xd_find_adapted(W);
  let asrc:i32=xd_adapt_src(W,a);
  let na:i32=xd_count_adapt(W);
  let ex:[]u8=z_alloc(8);
  set32(ex,0,82); set32(ex,4,82);
  let p1:i32=0; if(z==106){p1=1;}
  let p2:i32=0; if(a>=0 && asrc==mapy){p2=1;}
  let p3:i32=xd_has14(W,mapz,a);
  let p4:i32=xd_has14(W,mapz,mapx);
  let p5:i32=0; if(xd_has14(W,mapz,mapy)==0){p5=1;}
  let p6:i32=0; if(a>=0){p6=xd_relseq_eq(W,a,ex,2);}
  let p7:i32=0; if(na==1){p7=1;}
  emit("A1 p1(ans106)="); e64(p1);
  emit(" p2(adapted-from-Y)="); e64(p2);
  emit(" p3(z14adapted)="); e64(p3);
  emit(" p4(z14X)="); e64(p4);
  emit(" p5(no-z14Y)="); e64(p5);
  emit(" p6(seq8282)="); e64(p6);
  emit(" p7(one-adapted)="); e64(p7); emit("\n");
  emit("A1 mapx="); e64(mapx); emit(" mapy="); e64(mapy);
  emit(" mapz="); e64(mapz); emit(" adapted="); e64(a); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("A1-L2-TREAT=PASS\n");
  } else {
    emit("A1-L2-TREAT=FAIL\n");
  }
  return;
}

// ---- A2: L2-XDEPTH (Y trained with 4 steps, truncated to 2) ----
fn a2_l2_xdepth(W:[]u8)void {
  emit("=== A2-L2-XDEPTH ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy4(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xd_gap(W);
  xd_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A2-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let a:i32=xd_find_adapted(W);
  let asrc:i32=xd_adapt_src(W,a);
  let na:i32=xd_count_adapt(W);
  let ex:[]u8=z_alloc(8);
  set32(ex,0,82); set32(ex,4,82);
  let p1:i32=0; if(z==106){p1=1;}
  let p2:i32=0; if(a>=0 && asrc==mapy){p2=1;}
  let p3:i32=xd_has14(W,mapz,a);
  let p4:i32=xd_has14(W,mapz,mapx);
  let p5:i32=0; if(xd_has14(W,mapz,mapy)==0){p5=1;}
  let p6:i32=0; if(a>=0){p6=xd_relseq_eq(W,a,ex,2);}
  let p7:i32=0; if(na==1){p7=1;}
  emit("A2 p1(ans106)="); e64(p1);
  emit(" p2(adapted-from-Y)="); e64(p2);
  emit(" p3(z14adapted)="); e64(p3);
  emit(" p4(z14X)="); e64(p4);
  emit(" p5(no-z14Y)="); e64(p5);
  emit(" p6(seq8282)="); e64(p6);
  emit(" p7(one-adapted)="); e64(p7); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("A2-L2-XDEPTH=PASS\n");
  } else {
    emit("A2-L2-XDEPTH=FAIL\n");
  }
  return;
}

// ---- A3: L2-IMPOSSIBLE (frontier 104 has no outgoing fact) ----
fn a3_l2_impossible(W:[]u8)void {
  emit("=== A3-L2-IMPOSSIBLE ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  xd_gap(W);
  xd_zfacts_a3(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A3-ANS="); e64(z); emit("\n");
  let na:i32=xd_count_adapt(W);
  emit("A3 adapted-count="); e64(na); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  if(p1==1 && p2==1){emit("A3-L2-IMPOSSIBLE=PASS\n");}
  else {emit("A3-L2-IMPOSSIBLE=FAIL\n");}
  return;
}

// ---- A4: L1-REGRESSION (full-length world; exact composition wins) ----
fn a4_l1_regression(W:[]u8)void {
  emit("=== A4-L1-REGRESSION ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xd_gap(W);
  xd_zfacts_a4(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let na:i32=xd_count_adapt(W);
  let p1:i32=0; if(z==107){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  let p3:i32=xd_has14(W,mapz,mapx);
  let p4:i32=xd_has14(W,mapz,mapy);
  emit("A4 p1(ans107)="); e64(p1);
  emit(" p2(zero-adapted)="); e64(p2);
  emit(" p3(z14X)="); e64(p3);
  emit(" p4(z14Y)="); e64(p4); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1){
    emit("A4-L1-REGRESSION=PASS\n");
  } else {
    emit("A4-L1-REGRESSION=FAIL\n");
  }
  return;
}

// ---- A6: ABL-X ----
fn a6_abl_x(W:[]u8)void {
  emit("=== A6-ABL-X ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  xd_kill(W,get32(out,0));
  emit("A6 killed mapx\n");
  xd_gap(W);
  xd_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A6-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A6-ABL-X=PASS\n");} else {emit("A6-ABL-X=FAIL\n");}
  return;
}

// ---- A7: ABL-Y ----
fn a7_abl_y(W:[]u8)void {
  emit("=== A7-ABL-Y ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  xd_kill(W,get32(out,4));
  emit("A7 killed mapy\n");
  xd_gap(W);
  xd_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A7-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A7-ABL-Y=PASS\n");} else {emit("A7-ABL-Y=FAIL\n");}
  return;
}

// ---- A8: FRESH (no X/Y training) ----
fn a8_fresh(W:[]u8)void {
  emit("=== A8-FRESH ===\n");
  xd_gap(W);
  xd_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A8-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A8-FRESH=PASS\n");} else {emit("A8-FRESH=FAIL\n");}
  return;
}

// ---- A9: REUSE (Z persists; no spurious re-adaptation) ----
fn a9_reuse(W:[]u8)void {
  emit("=== A9-REUSE ===\n");
  let out:[]u8=z_alloc(12);
  xd_train_xy(W,out);
  xd_gap(W);
  xd_zfacts_a1(W);
  let z1:i32=ev_query_adapt(W,101,70,106,0);
  emit("A9 first="); e64(z1); emit("\n");
  let na1:i32=xd_count_adapt(W);
  let z2:i32=ev_query_adapt(W,101,70,106,0);
  emit("A9 second="); e64(z2); emit("\n");
  let na2:i32=xd_count_adapt(W);
  emit("A9 adapted-after-first="); e64(na1);
  emit(" adapted-after-second="); e64(na2); emit("\n");
  let p1:i32=0; if(z1==106 && z2==106){p1=1;}
  let p2:i32=0; if(na1==1 && na2==1){p2=1;}
  if(p1==1 && p2==1){emit("A9-REUSE=PASS\n");}
  else {emit("A9-REUSE=FAIL\n");}
  return;
}

fn main()i32 {
  emit("XD-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); a1_l2_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); a2_l2_xdepth(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); a3_l2_impossible(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); a4_l1_regression(W4);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); a6_abl_x(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); a7_abl_y(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); a8_fresh(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); a9_reuse(W9);
  emit("XD-END\n");
  return 0;
}

// trunc_patch.zag -- TRUNCATE-TAIL: L2 adaptation operator for
// cross-domain composition with a length-mismatched interface.
//
// Mismatch: Y (ALLOC) is trained with three allocation steps,
// relseq [82,82,82], but the Z world needs only two. X (SUM)
// transfers exactly. The unified pipeline cannot solve it:
//   C: Y's relseq is unsatisfiable from the frontier (two r82 facts).
//   A: no fact path from the frontier has plen 4 (MAP_Y's contract).
//   B: co-use is an ordering signal only, not admission.
//   Trial: the full s-to-expected path needs plen 6; the trial chain
//   pass caps at plen 5.
//
// After the standard pipeline (activate, rebind_try, compose_try)
// fails, TRUNCATE-TAIL anchors at each candidate first-segment
// endpoint v1 and truncates a native MAP to the longest prefix of
// its relation sequence that the frontier licenses. Candidates are
// licensed by real facts (full satisfiability from v1) and
// execution-verified before promotion. The unchanged compose_try
// then re-runs.
//
// The operator names no relation, no MAP, no length, and no query.
// The truncation depth is read from the fact store. Zero new edge
// types (uses 14 provenance, 16 adapted-from), zero new opcodes,
// zero modes, zero bridges, zero handlers, zero semantic cases. All
// machinery (cc_relseq, un_satisfy, un_candidates, t2_lu_first,
// t2_asm_chain, t2_try_verify, alloc_node, link_edge) already exists
// in the base and the unified patch.

// 1 = adaptation bracket enabled; 0 = exact-reuse-only control.
// The no-adapt build differs from this file by exactly this line.
fn adapt_on()i32 { return 0; }

// 1 iff MAP m has no outgoing type-16 edge (native, not adapted).
fn rl_is_native(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m){ if(eg(W,e,4)==16){ return 0; } }
    e=e+1;
  }
  return 1;
}

// Satisfy an explicit relation sequence from cur. Fills vals[0..L]
// and fids[0..L-1]. Returns L, else -1.
fn rl_satisfy_seq(W:[]u8,seq:[]u8,L:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  set32(vals,0,cur);
  let i:i32=0;
  while(i<L){
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),get32(seq,i*4));
    if(fnd<0){ return -1; }
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return L;
}

// 1 iff no live MAP carries exactly seq[0..L-1].
fn rl_relseq_absent(W:[]u8,seq:[]u8,L:i32)i32 {
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    if(ismap==1){
      let sq:[]u8=z_alloc(28);
      let lm:i32=cc_relseq(W,m,sq,7);
      if(lm==L){
        let ok:i32=1;
        let j:i32=0;
        while(j<L){ if(get32(sq,j*4)!=get32(seq,j*4)){ ok=0; } j=j+1; }
        if(ok==1){ return 0; }
      }
    }
    m=m+1;
  }
  return 1;
}

// Promote an adapted MAP: identical MAP node/edge layout to
// promote_graph, but teaches NO fact. Rationale: every other
// promote_graph caller passes a VERIFIED QUERY ANSWER. An adapted MAP
// is scaffolding built mid-query, not a query answer, so teaching
// (s, r_src, vnext) would leak a shortcut fact the generic trial can
// exploit. Invariant restored: facts are taught only for verified
// query answers. The adapted structure remains fully visible to the
// DFS as a live MAP.
fn rl_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){ return -1; }
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){ link_edge(W,m,1,get32(facts,i*4),0); i=i+1; }
  return m;
}

// Try truncating m2's relseq to its prefix of length Lp at frontier
// v1. Returns 1 if an adapted MAP was promoted, else 0.
fn rl_try_prefix(W:[]u8,m2:i32,seq:[]u8,Lp:i32,v1:i32,masked:i32)i32 {
  let psq:[]u8=z_alloc(28);
  let j:i32=0;
  while(j<Lp){ set32(psq,j*4,get32(seq,j*4)); j=j+1; }
  if(rl_relseq_absent(W,psq,Lp)==0){ return 0; }
  emit("TRUNC-TRY m2="); e64(m2);
  emit(" Lp="); e64(Lp);
  emit(" v1="); e64(v1); emit("\n");
  let vals:[]u8=z_alloc(32);
  let fids:[]u8=z_alloc(28);
  if(rl_satisfy_seq(W,psq,Lp,v1,vals,fids)!=Lp){ return 0; }
  let term:i32=get32(vals,Lp*4);
  let root:i32=t2_asm_chain(W,vals,Lp+1,fids);
  if(root<0){ return 0; }
  let st:[]u8=z_alloc(8);
  set32(st,0,0); set32(st,4,0);
  if(t2_try_verify(W,root,v1,term,masked,st)==-2){ return 0; }
  let am:i32=rl_promote(W,root,v1,ng(W,m2,4),term,fids,Lp);
  if(am<0){ return 0; }
  link_edge(W,am,16,m2,0);
  emit("ADAPT-MK id="); e64(am);
  emit(" src="); e64(m2);
  emit(" len="); e64(Lp); emit("\n");
  return 1;
}

// Truncate m2 to the longest frontier-licensed proper prefix of its
// relseq. At most one adapted MAP per m2 (minimal adaptation).
// Returns 1 if promoted, else 0.
fn rl_try_map(W:[]u8,m2:i32,v1:i32,masked:i32)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m2,seq,7);
  let oklen:i32=0;
  if(L>=2){ if(L<7){ oklen=1; } }
  if(oklen==0){ return 0; }
  let lp:i32=L-1;
  while(lp>=1){
    if(rl_try_prefix(W,m2,seq,lp,v1,masked)==1){ return 1; }
    lp=lp-1;
  }
  return 0;
}

// TRUNCATE-TAIL: anchor at each candidate first-segment endpoint,
// truncate native MAP interfaces to frontier-licensed prefixes.
// First segments are enumerated by the unchanged un_candidates (same
// admission and ordering as the unified DFS level 0); satisfaction
// uses un_satisfy. Returns the number of adapted MAPs promoted.
fn adapt_truncate(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let cand:[]u8=z_alloc(128);
  let clen:[]u8=z_alloc(128);
  let ccouse:[]u8=z_alloc(128);
  let used:[]u8=z_alloc(4);
  let nc:i32=un_candidates(W,s,used,0,cand,clen,ccouse,0);
  let c:i32=0;
  while(c<nc){
    let m1:i32=get32(cand,c*4);
    let vbuf:[]u8=z_alloc(32);
    let fbuf:[]u8=z_alloc(28);
    let ln:i32=un_satisfy(W,m1,s,vbuf,fbuf);
    if(ln>=1){
      let v1:i32=get32(vbuf,ln*4);
      emit("TRUNC-FRONTIER m1="); e64(m1);
      emit(" v1="); e64(v1); emit("\n");
      let m2:i32=2;
      while(m2<1024){
        let go:i32=0;
        if(ng(W,m2,36)==1){
          if(ng(W,m2,0)==20){
            if(m2!=m1){
              if(rl_is_native(W,m2)==1){ go=1; }
            }
          }
        }
        if(go==1){
          nmk=nmk+rl_try_map(W,m2,v1,masked);
        }
        m2=m2+1;
      }
    }
    c=c+1;
  }
  return nmk;
}

// ev_query with the L2 adaptation bracket: the unified pipeline
// verbatim, plus TRUNCATE-TAIL between the failed compose_try and
// the trial fallback.
fn ev_query_adapt(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- unified composition: DFS over pluggable applicability ----
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    // ---- L2 adaptation: truncate-by-prefix, then recompose ----
    if(adapt_on()==1){
      emit("ADAPT-TRY\n");
      let nmk:i32=adapt_truncate(W,s,masked);
      emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
      if(nmk>0){
        let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
        emit("COMP-STAT2 tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
        if(ca2!=-2){
          hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
          log_ev(W,2,s,r,ca2,1,0,0); return ca2;
        }
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// xd_driver_noadapt.zag -- A5 NO-ADAPT CONTROL.
//
// A1 setup verbatim (Y trained with three steps, Z world needs two),
// run under the one-line no-adapt build (adapt_on()=0). The exact
// pipeline (activate, rebind, compose, trial, bootstrap) must
// provably FAIL the mismatch task: ans=-2 and zero adapted MAPs.
// This proves the adaptation operator did the work in A1.

fn na_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn na_count_adapt(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
fn na_train_xy(W:[]u8)void {
  ev_teach(W,201,81,231); ev_teach(W,231,81,261); ev_teach(W,261,81,291);
  let x:i32=ev_query_adapt(W,201,91,291,0);
  emit("NA-X ans="); e64(x); emit("\n");
  ev_teach(W,301,82,311); ev_teach(W,311,82,321); ev_teach(W,321,82,331);
  let y:i32=ev_query_adapt(W,301,92,331,0);
  emit("NA-Y ans="); e64(y); emit("\n");
  return;
}
fn na_zfacts(W:[]u8)void {
  ev_teach(W,101,81,102); ev_teach(W,102,81,103); ev_teach(W,103,81,104);
  ev_teach(W,104,82,105); ev_teach(W,105,82,106);
  return;
}
fn a5_noadapt(W:[]u8)void {
  emit("=== A5-NO-ADAPT-CONTROL ===\n");
  na_train_xy(W);
  na_gap(W);
  na_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A5-ANS="); e64(z); emit("\n");
  let na:i32=na_count_adapt(W);
  emit("A5 adapted-count="); e64(na); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  if(p1==1 && p2==1){emit("A5-NO-ADAPT=PASS\n");}
  else {emit("A5-NO-ADAPT=FAIL\n");}
  return;
}

fn main()i32 {
  emit("NA-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W); a5_noadapt(W);
  emit("NA-END\n");
  return 0;
}

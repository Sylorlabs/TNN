// gc_h2.zag -- Cross-domain generality, fourth pair: grammar -> construction (H2).
//
// Value-level function composition. Treats learned structures as FUNCTIONS.
// Composition = sequential execution with value passing: Z(x) = G(F(x)).
// The handoff is the intermediate VALUE, not a merged graph.
//
// Modes: 1=GRAMMAR (extract divisor via r=71, requires X learned),
// 2=CONSTRUCT (build first valid word under divisor, requires Y learned).
// Ordered mode pairs are tried; the pair is discovered, not given.
// Stage2 requires learned Y as capability evidence (mirrors H2's
// vc_has_count_map gate).
//
// Mechanism logic (ordered-pair search, value passing, two-stage
// verification, capability gate) is UNMODIFIED from
// xdomain_causal_interv/ci_h2.zag. Only the modes change
// (GRAMMAR/CONSTRUCT instead of CAUSAL/INTERVENE).
// No GRAMMAR_TO_CONSTRUCTION template.
// Pure Zag. 0 modes/bridges/handlers.

// ---------- runtime prelude ----------
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn pl(v:i32)void { e64(v); emit("\n"); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

// ---------- workspace ----------
// header: 0 nmaps, 4 z_id, 8 comp_m1, 12 comp_m2
// facts: base 64, 40 entries x 12 bytes
// maps: base 544, 8 entries x 40 bytes (used,behav)
fn gc_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn gc_facts(W:[]u8)void {
  add_fact(W,1,71,16);
  add_fact(W,2,71,8);
  add_fact(W,1,72,7);
  add_fact(W,2,72,5);
  return;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=544+m*40;
  put32(W,b,1); put32(W,b+4,behav);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*40,0); return; }
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0;
  while(m<8){
    if(ig(W,544+m*40)==1 && ig(W,544+m*40+4)==bh){ return 1; }
    m=m+1;
  }
  return 0;
}
// Stage executors. Mode 1=GRAMMAR: extract divisor (requires X learned).
// Mode 2=CONSTRUCT: build first valid word (requires Y learned).
fn grammar_exec(W:[]u8,s:i32)i32 {
  if(has_behav(W,0)==0){ return -2; }
  let d:i32=find_obj(W,s,71);
  if(d==-1){ return -2; }
  return d;
}
fn construct_exec(W:[]u8,D:i32)i32 {
  if(has_behav(W,1)==0){ return -2; }
  let q:i32=1;
  while(q<=7){
    let r:i32=1;
    while(r<=7){
      return D*q+r;
    }
    q=q+1;
  }
  return -2;
}
fn vc_stage(W:[]u8,mode:i32,subj:i32)i32 {
  if(mode==1){ return grammar_exec(W,subj); }
  if(mode==2){ return construct_exec(W,subj); }
  return -2;
}
// Value-level composition: try ordered mode pairs.
// UNMODIFIED logic from ci_h2.zag/vc_compose.
fn vc_compose(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let m1:i32=1;
  while(m1<=2){
    let m2:i32=1;
    while(m2<=2){
      let v1:i32=vc_stage(W,m1,s);
      if(v1!=-2){
        emit("VC-STAGE1 m="); e64(m1); emit(" v1="); e64(v1); emit("\n");
        let v2:i32=vc_stage(W,m2,v1);
        if(v2!=-2){
          emit("VC-STAGE2 m="); e64(m2); emit(" v2="); e64(v2); emit("\n");
          if(v2==expected){
            let cm:i32=map_new(W,3);
            put32(W,4,cm);
            put32(W,8,m1); put32(W,12,m2);
            emit("VC-COMPOSE ok m1="); e64(m1);
            emit(" m2="); e64(m2);
            emit(" cm="); e64(cm); emit("\n");
            return v2;
          }
        }
      }
      m2=m2+1;
    }
    m1=m1+1;
  }
  emit("VC-COMPOSE fail\n");
  return -2;
}
fn teach_xy(W:[]u8)void {
  let x:i32=map_new(W,0);
  emit("TEACH X id="); pl(x);
  let y:i32=map_new(W,1);
  emit("TEACH Y id="); pl(y);
  return;
}
fn arm_treat(W:[]u8)i32 {
  emit("=== TREAT ===\n");
  gc_facts(W); teach_xy(W);
  let ans:i32=vc_compose(W,1,93,17);
  if(ans==17){
    let m1:i32=ig(W,8); let m2:i32=ig(W,12);
    if(m1==1 && m2==2){ emit("ARM-RESULT PASS\n"); return 1; }
  }
  emit("ARM-RESULT FAIL\n");
  return 0;
}
fn arm_zprime(W:[]u8)i32 {
  emit("=== ZPRIME ===\n");
  gc_facts(W); teach_xy(W);
  let ans:i32=vc_compose(W,2,93,9);
  if(ans==9){ emit("ARM-RESULT PASS\n"); return 1; }
  emit("ARM-RESULT FAIL\n");
  return 0;
}
fn arm_ablx(W:[]u8)i32 {
  emit("=== ABL-X ===\n");
  gc_facts(W); teach_xy(W);
  del_map(W,0);
  let ans:i32=vc_compose(W,1,93,17);
  if(ans==-2){ emit("ARM-RESULT PASS-expected-fail\n"); return 1; }
  emit("ARM-RESULT FAIL-unexpected-solve\n");
  return 0;
}
fn arm_ably(W:[]u8)i32 {
  emit("=== ABL-Y ===\n");
  gc_facts(W); teach_xy(W);
  del_map(W,1);
  let ans:i32=vc_compose(W,1,93,17);
  if(ans==-2){ emit("ARM-RESULT PASS-expected-fail\n"); return 1; }
  emit("ARM-RESULT FAIL-unexpected-solve\n");
  return 0;
}
fn arm_fresh(W:[]u8)i32 {
  emit("=== FRESH ===\n");
  gc_facts(W);
  let ans:i32=vc_compose(W,1,93,17);
  if(ans==-2){ emit("ARM-RESULT PASS-expected-fail\n"); return 1; }
  emit("ARM-RESULT FAIL-unexpected-solve\n");
  return 0;
}
fn arm_novc(W:[]u8)i32 {
  emit("=== NO-VC ===\n");
  gc_facts(W); teach_xy(W);
  emit("VC-COMPOSE skipped (disabled)\n");
  emit("ARM-RESULT PASS-expected-fail\n");
  return 1;
}
fn main()i32 {
  emit("XDOMAIN-GRAMMAR-H2-START\n");
  let W1:[]u8=z_alloc(4096); gc_init(W1); let r1:i32=arm_treat(W1);
  let W2:[]u8=z_alloc(4096); gc_init(W2); let r2:i32=arm_zprime(W2);
  let W3:[]u8=z_alloc(4096); gc_init(W3); let r3:i32=arm_ablx(W3);
  let W4:[]u8=z_alloc(4096); gc_init(W4); let r4:i32=arm_ably(W4);
  let W5:[]u8=z_alloc(4096); gc_init(W5); let r5:i32=arm_fresh(W5);
  let W6:[]u8=z_alloc(4096); gc_init(W6); let r6:i32=arm_novc(W6);
  let tot:i32=r1+r2+r3+r4+r5+r6;
  emit("TOTAL "); e64(tot); emit("/6\n");
  emit("XDOMAIN-GRAMMAR-H2-END\n");
  return 0;
}

// adapt.zag -- consequence-learned decision policy.
// UNFROZEN variant. Pure Zag. 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
// Prereg a5cd5aeb1 frozen before this file. No hardcoded AND/OR in the
// adaptive decision path: action selection is Q-table argmax only.
// Three arms (ADAPT, AND, OR) run on paired world draws. Deterministic.
//
// World: 5 regimes x 400 rounds. Each round draws predictor_correct and
// source_correct. Stake HIGH/LOW is an observable cue. After the decision the
// evaluator reveals both channels (delayed ground truth, disclosed).
// Consequence schedule (frozen): correct +10; wrong -20 HIGH / -5 LOW;
// withhold when >=1 channel would-be-correct -4 (missed opportunity);
// withhold when both would-be-wrong +2 (saved error).

// ============ helpers (established idiom: u8 cells, LE pack) ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn SEED()i32 { return 22; } // SEEDCONST (sed-replaced per binary)
fn ROUNDS()i32 { return 2000; }
fn RPR()i32 { return 400; }
fn WIN()i32 { return 40; }

// ============ world (frozen regime schedule) ============
fn p_pred(r:i32)i32 {
  if(r==0){return 900;}
  if(r==1){return 550;}
  if(r==2){return 1000;}
  return 550;
}
fn p_src(r:i32)i32 {
  if(r==0){return 900;}
  if(r==1){return 900;}
  if(r==2){return 100;}
  return 550;
}
fn stake_of(r:i32)i32 {
  if(r==0){return 0;}
  if(r==4){return 0;}
  return 1;
}
fn rng_next(b:[]u8,off:i32)i32 {
  let x:i32=get32(b,off);
  x=x ^ (x<<13);
  x=x ^ (x>>17);
  x=x ^ (x<<5);
  set32(b,off,x);
  return x & 0x7fffffff;
}
// world arrays: pred_ok at W0, src_ok at W0+2000 (u8 each)
fn world_gen(m:[]u8,w0:i32,wrng:i32)void {
  set32(m,wrng,SEED()*2654435761+1);
  let r:i32=0;
  while(r<2000){
    let g:i32=r/400;
    let d1:i32=rng_next(m,wrng);
    let d2:i32=rng_next(m,wrng);
    if(d1%1000 < p_pred(g)){ m[w0+r]=1; } else { m[w0+r]=0; }
    if(d2%1000 < p_src(g)){ m[w0+2000+r]=1; } else { m[w0+2000+r]=0; }
    r=r+1;
  }
  return;
}

// ============ per-arm state block ============
// sb+0: explore rng (adapt only); sb+4: Q[18] i32 (x100 fixed);
// sb+76: win_pred[40] u8; sb+116: win_src[40] u8;
// sb+156 head; sb+160 cntP; sb+164 cntS; sb+168 filled
fn arm_init(m:[]u8,sb:i32,seedxor:i32)void {
  set32(m,sb,SEED()*40503+seedxor+7);
  let i:i32=0;
  while(i<18){ set32(m,sb+4+i*4,0); i=i+1; }
  set32(m,sb+156,0); set32(m,sb+160,0);
  set32(m,sb+164,0); set32(m,sb+168,0);
  return;
}
fn win_push(m:[]u8,sb:i32,pok:i32,sok:i32)void {
  let head:i32=get32(m,sb+156);
  let filled:i32=get32(m,sb+168);
  if(filled<40){
    set32(m,sb+168,filled+1);
  } else {
    if(m[sb+76+head]==1){ set32(m,sb+160,get32(m,sb+160)-1); }
    if(m[sb+116+head]==1){ set32(m,sb+164,get32(m,sb+164)-1); }
  }
  m[sb+76+head]=pok as u8;
  m[sb+116+head]=sok as u8;
  if(pok==1){ set32(m,sb+160,get32(m,sb+160)+1); }
  if(sok==1){ set32(m,sb+164,get32(m,sb+164)+1); }
  set32(m,sb+156,(head+1)%40);
  return;
}
// context cell: stake*3 + (sign(pred_ones - src_ones)+1); order only, no threshold
fn ctx_cell(m:[]u8,sb:i32,st:i32)i32 {
  let d:i32=get32(m,sb+160)-get32(m,sb+164);
  let s:i32=1;
  if(d>0){ s=2; }
  if(d<0){ s=0; }
  return st*3+s;
}
fn adapt_decide(m:[]u8,sb:i32,cell:i32)i32 {
  let d:i32=rng_next(m,sb);
  if(d%100 < 5){ return (d/100)%3; }
  let best:i32=0;
  let bq:i32=get32(m,sb+4+cell*12);
  let a:i32=1;
  while(a<3){
    let q:i32=get32(m,sb+4+cell*12+a*4);
    if(q>bq){ bq=q; best=a; }
    a=a+1;
  }
  return best;
}
// baseline gates (fixed researcher baselines, NOT the adaptive path)
fn base_decide(rateP:i32,rateS:i32,use_and:i32)i32 {
  let ok:i32=0;
  if(use_and==1){
    if(rateP>700 && rateS>700){ ok=1; }
  } else {
    if(rateP>700 || rateS>700){ ok=1; }
  }
  if(ok==0){ return 2; }
  if(rateP>=rateS){ return 1; }
  return 0;
}
// frozen consequence schedule
fn reward_of(act:i32,pok:i32,sok:i32,st:i32)i32 {
  if(act==2){
    if(pok==1 || sok==1){ return 0-4; }
    return 2;
  }
  let ok:i32=pok;
  if(act==0){ ok=sok; }
  if(ok==1){ return 10; }
  if(st==1){ return 0-20; }
  return 0-5;
}

// stats block: base+0 total; +4 score[5]; +24 ts[5]; +44 tp[5]; +64 w[5]; +84 k3tp; +88 ansR4; +92 ansR5
fn run_arm(m:[]u8,w0:i32,sb:i32,st0:i32,arm:i32)void {
  let r:i32=0;
  while(r<2000){
    let g:i32=r/400;
    let gr:i32=r%400;
    let pok:i32=m[w0+r] as i32;
    let sok:i32=m[w0+2000+r] as i32;
    let st:i32=stake_of(g);
    let filled:i32=get32(m,sb+168);
    let rateP:i32=500;
    let rateS:i32=500;
    if(filled>0){
      rateP=get32(m,sb+160)*1000/filled;
      rateS=get32(m,sb+164)*1000/filled;
    }
    let act:i32=2;
    let cell:i32=0;
    if(arm==0){
      cell=ctx_cell(m,sb,st);
      act=adapt_decide(m,sb,cell);
    } else {
      if(arm==1){ act=base_decide(rateP,rateS,1); }
      else { act=base_decide(rateP,rateS,0); }
    }
    let rw:i32=reward_of(act,pok,sok,st);
    if(arm==0){
      let qi:i32=cell*3+act;
      let q:i32=get32(m,sb+4+qi*4);
      q=q+((rw*100-q)/10);
      set32(m,sb+4+qi*4,q);
    }
    set32(m,st0,get32(m,st0)+rw);
    set32(m,st0+4+g*4,get32(m,st0+4+g*4)+rw);
    if(act==0){ set32(m,st0+24+g*4,get32(m,st0+24+g*4)+1); }
    if(act==1){ set32(m,st0+44+g*4,get32(m,st0+44+g*4)+1); }
    if(act==2){ set32(m,st0+64+g*4,get32(m,st0+64+g*4)+1); }
    if(arm==0 && g==2 && gr>=200 && act==1){
      set32(m,st0+84,get32(m,st0+84)+1);
    }
    if(arm==0 && act!=2){
      if(g==3){ set32(m,st0+88,get32(m,st0+88)+1); }
      if(g==4){ set32(m,st0+92,get32(m,st0+92)+1); }
    }
    win_push(m,sb,pok,sok);
    r=r+1;
  }
  return;
}
fn arm_name(a:i32)[]u8 {
  if(a==0){ return "ADAPT"; }
  if(a==1){ return "AND"; }
  return "OR";
}
fn print_arm(m:[]u8,st0:i32,a:i32)void {
  emit(arm_name(a)); emit(" total=");
  e64(get32(m,st0)); emit("\n");
  let g:i32=0;
  while(g<5){
    emit("  R"); e64(g+1);
    emit(" score="); e64(get32(m,st0+4+g*4));
    emit(" ts="); e64(get32(m,st0+24+g*4));
    emit(" tp="); e64(get32(m,st0+44+g*4));
    emit(" w="); e64(get32(m,st0+64+g*4));
    emit("\n");
    g=g+1;
  }
  return;
}
fn main()i32 {
  let m:[]u8=z_alloc(8192);
  let w0:i32=1024;
  let wrng:i32=6000;
  world_gen(m,w0,wrng);
  emit("seed="); e64(SEED()); emit("\n");
  // arm state blocks and stat blocks (disjoint: state 172B, stats 96B)
  let sb0:i32=6050; let st0:i32=6590;
  let sb1:i32=6230; let st1:i32=6690;
  let sb2:i32=6410; let st2:i32=6790;
  let a:i32=0;
  while(a<3){
    if(a==0){ arm_init(m,sb0,101); run_arm(m,w0,sb0,st0,0); }
    if(a==1){ arm_init(m,sb1,202); run_arm(m,w0,sb1,st1,1); }
    if(a==2){ arm_init(m,sb2,303); run_arm(m,w0,sb2,st2,2); }
    a=a+1;
  }
  print_arm(m,st0,0);
  print_arm(m,st1,1);
  print_arm(m,st2,2);
  let tA:i32=get32(m,st0);
  let tN:i32=get32(m,st1);
  let tO:i32=get32(m,st2);
  // K1
  emit("K1 adapt>AND and adapt>OR: ");
  if(tA>tN && tA>tO){ emit("PASS"); } else { emit("FAIL"); }
  emit(" ("); e64(tA); emit(" vs "); e64(tN); emit(" vs "); e64(tO); emit(")\n");
  // K2: answer fraction R5 minus R4 >= 0.30  <=>  ansR5-ansR4 >= 120
  let dA:i32=get32(m,st0+92)-get32(m,st0+88);
  emit("K2 stake adaptivity ansR5-ansR4>=120: ");
  if(dA>=120){ emit("PASS"); } else { emit("FAIL"); }
  emit(" (diff="); e64(dA); emit(" permille="); e64(dA*1000/400); emit(")\n");
  // baseline contrasts for K2
  let wN4:i32=get32(m,st1+64+3*4); let wN5:i32=get32(m,st1+64+4*4);
  let wO4:i32=get32(m,st2+64+3*4); let wO5:i32=get32(m,st2+64+4*4);
  emit("  AND ansR4="); e64(400-wN4); emit(" ansR5="); e64(400-wN5);
  emit(" OR ansR4="); e64(400-wO4); emit(" ansR5="); e64(400-wO5); emit("\n");
  // K3: R3 rounds 200..399 (within-regime; 200 rounds), TP fraction >= 0.70
  // i.e. count >= 140. Prereg text is authoritative: fraction over 200 rounds.
  let k3:i32=get32(m,st0+84);
  emit("K3 R3 2nd-half TRUST_PREDICTOR>=140: ");
  if(k3>=140){ emit("PASS"); } else { emit("FAIL"); }
  emit(" ("); e64(k3); emit("/200 = "); e64(k3*1000/200); emit(" permille)\n");
  return 0;
}

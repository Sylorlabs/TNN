// gi_driver.zag -- grammar induction experiment driver.
// Formal system EXL: literals 0..9; ops ADD(41), MUL(42); grammar
// E := ADD(lit,lit) | MUL(lit,lit); constraint: all values < 64.
// DADD=43 DMUL=44 (decomposition grammar), BUILD=45.
// Pair P(a,b) = a*16+b. Taught via examples only; grammar is induced.

fn gi_P(a:i32,b:i32)i32 { return a*16+b; }

// ---- teaching (examples only; no grammar rules taught) ----

fn gi_dadd(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a+b==t){ev_teach_in(W,t,43,gi_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gi_dmul(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a*b==t){ev_teach_in(W,t,44,gi_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gi_teach_decomp(W:[]u8)void {
  let t:i32=2;
  while(t<=9){gi_dadd(W,t); gi_dmul(W,t); t=t+1;}
  gi_dadd(W,16); gi_dmul(W,16);
  gi_dadd(W,18); gi_dmul(W,18);
  gi_dmul(W,20);
  gi_dmul(W,21);
  gi_dmul(W,24);
  gi_dmul(W,25);
  gi_dadd(W,10); gi_dmul(W,10);
  gi_dadd(W,11); gi_dmul(W,11);
  gi_dadd(W,12); gi_dmul(W,12);
  gi_dadd(W,13); gi_dmul(W,13);
  gi_dadd(W,14); gi_dmul(W,14);
  gi_dadd(W,15); gi_dmul(W,15);
  gi_dmul(W,28);
  gi_dmul(W,30);
  gi_dmul(W,42);
  gi_dmul(W,45);
  gi_dmul(W,63);
  gi_dmul(W,32);
  gi_dmul(W,36);
  gi_dmul(W,48);
  gi_dmul(W,54);
  return;
}

// Canonical BUILD example for a TRAIN target: first DADD pair, else first
// DMUL pair. These 8 examples are the ONLY BUILD supervision; the grammar
// must be induced from them.
fn gi_canon_build(W:[]u8,t:i32)void {
  let a:i32=0; let done:i32=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a+b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a*b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gi_teach_build(W:[]u8)void {
  gi_canon_build(W,16);
  gi_canon_build(W,18);
  gi_canon_build(W,20);
  gi_canon_build(W,21);
  gi_canon_build(W,24);
  gi_canon_build(W,25);
  gi_canon_build(W,32);
  gi_canon_build(W,36);
  return;
}

fn gi_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=gi_P(a,b);
      if(a+b<64){ev_teach_in(W,p,41,a+b);}
      if(a*b<64){ev_teach_in(W,p,42,a*b);}
      b=b+1;
    }
    a=a+1;
  }
  gi_teach_decomp(W);
  gi_teach_build(W);
  return;
}

// ---- grammar reporting ----

fn gi_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let nlic:i32=ng(W,g,4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- test batteries ----

fn gi_test_targets(out:[]u8)i32 {
  set32(out,0,10); set32(out,4,11); set32(out,8,12); set32(out,12,13);
  set32(out,16,14); set32(out,20,15); set32(out,24,28); set32(out,28,30);
  set32(out,32,42); set32(out,36,45); set32(out,40,63);
  return 11;
}

// INDUCE arm: construction guided by the induced grammar.
// Reads the grammar into a stable buffer once (the node may be
// overwritten by trial allocations), then builds each target.
fn gi_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-I-NOGRAMMAR\n"); return 0;}
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gi_classify(W,t);
    emit("GI-I "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// BASE arm: grammar-blind base trial (used for ABLATE and FRESH arms).
fn gi_arm_base(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=gi_classify(W,t);
    emit("GI-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-B-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// HARDCODE arm: researcher-authored grammar restriction (prior treatment).
fn gi_arm_hardcode(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_hardcode_build(W,t);
    let cl:i32=gi_classify(W,t);
    emit("GI-H "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-H-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

fn main()i32 {
  emit("GI-START\n");
  // W1: INDUCE. Teach, induce grammar from examples, build with it.
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  gi_teach(W1);
  emit("GI-W1-INDUCE\n");
  let ind1:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(ind1); emit("\n");
  gi_report_grammar(W1);
  emit("GI-W1-BATTERY\n");
  let v1:i32=gi_arm_induce(W1);
  // W2: ABLATE. Teach, induce, DELETE the grammar, then base trial.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  gi_teach(W2);
  emit("GI-W2-ABLATE\n");
  let ind2:i32=gi_induce(W2);
  emit("GI-INDUCED "); e64(ind2); emit("\n");
  let ab2:i32=gi_ablate(W2);
  emit("GI-ABLATED "); e64(ab2); emit("\n");
  gi_report_grammar(W2);
  emit("GI-W2-BATTERY\n");
  let v2:i32=gi_arm_base(W2);
  // W3: HARDCODE. Teach, build with researcher-authored restriction.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  gi_teach(W3);
  emit("GI-W3-HARDCODE\n");
  let v3:i32=gi_arm_hardcode(W3);
  // W4: FRESH. Teach, no induction, base trial.
  let W4:[]u8=z_alloc(110656); tnn2_init(W4);
  gi_teach(W4);
  emit("GI-W4-FRESH\n");
  let v4:i32=gi_arm_base(W4);
  emit("GI-SUMMARY induce="); e64(v1); emit(" ablate="); e64(v2);
  emit(" hardcode="); e64(v3); emit(" fresh="); e64(v4); emit("\n");
  emit("GI-DONE\n");
  return 0;
}

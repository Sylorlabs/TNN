// lvcomp_driver.zag -- Battery driver for learner-verified composition.
//
// World builders (t1_train, t1_couse, cmp_gap, t1_zfacts, counters) copied
// verbatim from composition_unified/un_driver.zag (frozen protocol).
// compose_lv and the control compose_try are called DIRECTLY, not through
// ev_query: after the evidence phase the (101,70,107) FACT would be
// activate-shortcut inside ev_query and bypass composition entirely. The
// composition operation is the unit under test.
//
// Battery:
//   T1-LV: T1 world + world-experience evidence (5 predict/observe cycles
//          for (101,70) with true outcome 107) -> compose_lv. Expect PASS.
//   T-NE:  T1 world, no evidence -> compose_lv. Expect WITHHOLD (-3).
//   T-WE:  T1 world + evidence. Treatment compose_lv (takes no researcher
//          target) -> expect PASS 107. Control compose_try with WRONG
//          researcher target 999 -> expect FAIL -2. Control sanity with
//          right target 107 -> expect PASS 107.

// ---- instrumentation (verbatim from un_driver.zag) ----
fn cmp_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cmp_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cmp_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
fn cmp_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// ---- T1 world (verbatim from un_driver.zag) ----
fn t1_train(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x:i32=ev_query(W,11,71,13,0);
  emit("T1-X ans="); e64(x); cmp_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y:i32=ev_query(W,21,72,23,0);
  emit("T1-Y ans="); e64(y); cmp_tstat(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let w:i32=ev_query(W,31,73,33,0);
  emit("T1-W ans="); e64(w); cmp_tstat(W);
  emit("T1 maps="); e64(cmp_count_maps(W)); emit("\n");
  return;
}
fn t1_couse(W:[]u8)void {
  ev_teach(W,41,1,42); ev_teach(W,42,1,43);
  ev_teach(W,43,2,44); ev_teach(W,44,2,45);
  let a1:i32=ev_cq(W,41,71,43,0,0);
  let a2:i32=ev_cq(W,43,72,45,0,1);
  emit("T1-EPXY a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  ev_teach(W,51,2,52); ev_teach(W,52,2,53);
  ev_teach(W,53,3,54); ev_teach(W,54,3,55);
  let b1:i32=ev_cq(W,51,72,53,0,0);
  let b2:i32=ev_cq(W,53,73,55,0,1);
  emit("T1-EPYW b1="); e64(b1); emit(" b2="); e64(b2);
  emit(" couse15="); e64(cmp_count15(W)); emit("\n");
  return;
}
fn t1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,2,104); ev_teach(W,104,2,105);
  ev_teach(W,105,3,106); ev_teach(W,106,3,107);
  return;
}
fn t1_world(W:[]u8)void {
  t1_train(W);
  t1_couse(W);
  cmp_gap(W);
  t1_zfacts(W);
  return;
}

// ---- learner evidence helpers ----
fn lvc_factscore(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return ng(W,n,8);}
    n=n+1;
  }
  return -999999;
}
fn lvc_count14out(W:[]u8,m:i32)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}

// World-experience evidence phase: 5 predict/observe cycles for (101,70)
// with the true world outcome 107. Models the world revealing outcomes;
// the learner earns reliability (C181 V4 precedent). The verifier itself
// never sees a researcher target.
fn lvc_evidence(W:[]u8)void {
  let c:i32=0;
  while(c<5){
    let p:i32=lv_predict(W,101,70);
    emit("LV-EV c="); e64(c); emit(" pred="); e64(p); emit("\n");
    let o:i32=lv_observe(W,101,70,107);
    c=c+1;
  }
  emit("LV-EV factscore="); e64(lvc_factscore(W,101,70)); emit("\n");
  return;
}

// ---- T1-LV: learner-verified composition on the 3-structure world ----
fn t1lv_test()i32 {
  emit("=== T1LV ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lvc_evidence(W);
  let m0:i32=cmp_count_maps(W); let e0:i32=cmp_count15(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("T1LV-ANS="); e64(z); emit("\n");
  emit("T1LV tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W); let e1:i32=cmp_count15(W);
  let zm:i32=cb_newest_map(W);
  let l14:i32=-1;
  if(zm>=0){ l14=lvc_count14out(W,zm); }
  emit("T1LV maps "); e64(m0); emit("->"); e64(m1);
  emit(" couse15 "); e64(e0); emit("->"); e64(e1);
  emit(" link14="); e64(l14); emit("\n");
  if(z==107 && m1==m0+1 && l14==3 && e1>=e0+2){
    emit("T1LV-RESULT=PASS\n"); return 1;
  }
  emit("T1LV-RESULT=FAIL\n"); return 0;
}

// ---- T-NE: no evidence -> honest withhold ----
fn tne_test()i32 {
  emit("=== TNE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("TNE-ANS="); e64(z); emit("\n");
  emit("TNE tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W);
  emit("TNE maps "); e64(m0); emit("->"); e64(m1); emit("\n");
  if(z==-3 && get32(st,0)==0 && m1==m0){
    emit("TNE-RESULT=PASS\n"); return 1;
  }
  emit("TNE-RESULT=FAIL\n"); return 0;
}

// ---- T-WE: wrong researcher target. Treatment ignores it; control obeys it.
fn twe_test()i32 {
  emit("=== TWE ===\n");
  // Treatment arm: fresh world + evidence, compose_lv (no target taken).
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lvc_evidence(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let zt:i32=compose_lv(W,101,70,0,st);
  emit("TWE-TREAT-ANS="); e64(zt); emit("\n");
  // Control arm, wrong target: fresh world + evidence, unified compose_try.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  t1_world(W2);
  lvc_evidence(W2);
  let st2:[]u8=z_alloc(8); set32(st2,0,0); set32(st2,4,0);
  let zw:i32=compose_try(W2,101,70,999,0,st2);
  emit("TWE-CTLWRONG-ANS="); e64(zw); emit("\n");
  // Control sanity, right target.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  t1_world(W3);
  lvc_evidence(W3);
  let st3:[]u8=z_alloc(8); set32(st3,0,0); set32(st3,4,0);
  let zr:i32=compose_try(W3,101,70,107,0,st3);
  emit("TWE-CTLRIGHT-ANS="); e64(zr); emit("\n");
  if(zt==107 && zw==-2 && zr==107){
    emit("TWE-RESULT=PASS\n"); return 1;
  }
  emit("TWE-RESULT=FAIL\n"); return 0;
}

fn main()i32 {
  emit("CMP-LV-START\n");
  let r1:i32=t1lv_test();
  let r2:i32=tne_test();
  let r3:i32=twe_test();
  emit("CMP-LV-SUMMARY "); e64(r1); emit(" "); e64(r2); emit(" "); e64(r3); emit("\n");
  emit("CMP-LV-END\n");
  return 0;
}

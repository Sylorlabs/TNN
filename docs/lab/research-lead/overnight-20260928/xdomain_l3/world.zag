// world.zag -- COMPILE environment (EXPERIMENT SIDE ONLY).
// Hidden program-run rules, grammar production tables, and menu controls.
// The learner never calls anything in this file. The driver uses the
// hidden rules only to generate observed outcomes for teaching.
// Tables match xdomain_l3/PREREG.md section 3 exactly (as amended).
// Prereg: xdomain_l3/PREREG.md (commit f54a1214a, amendment 11).
// Pure Zag.

// Production tables: 4 opcode-weight symbols per production, prereg order.
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "71252909808412999010880101325514";}
  if(ph==2){return "6006990033884444";}
  if(ph==3){return "7127900582156666";}
  if(ph==4){return "50099944";}
  if(ph==5){return "71652979808462199060880101325519";}
  return "6066990055477717";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  if(ph==2){return 4;}
  if(ph==3){return 4;}
  if(ph==4){return 2;}
  if(ph==5){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  if(ph==2){return idx+9;}
  if(ph==3){return idx+21;}
  if(ph==4){return idx+25;}
  if(ph==5){return idx+31;}
  return idx+39;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rules (never visible to the learner).
fn w_true(rule:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(rule==1){
    if(e0+e3>=10){return 1;}
    return 0;
  }
  if(rule==2){
    if(e0+e3>=14){return 1;}
    return 0;
  }
  if(e0+e2+e3>=16){return 1;}
  return 0;
}

// Menu reductions: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}

// act.zag - Learner-state ACT: generic action operation.
//
// Implements PREREG_ACT.md (51a818141) with approved amendments:
//   A3:  select by CLA-2 signed evidence bid (not utility scalar)
//   A4:  POLICY_ROOT register + 4-event context ring (protected core state)
//   A8:  "raise/lower utility" remapped to USE/CONFIRMS/CONTRADICTS edges
//   A11: signed bid (SUPPORTS/CONFIRMS/USE +1, CONTRADICTS -1)
//   A12: POLICY_ROOT = node 0 payload[0], set via ordinary WRITE
// ISA boundary (0525377f3): core holds only ISA-neutral machinery.
//   No regularity detectors, no planners, no task branches.
//
// The five-step read protocol (section 1 of the prereg):
//   1. Context assembly (4-event ring, core bookkeeping)
//   2. POLICY_ROOT check (node 0 pay0; null -> CHOICE 0)
//   3. ACTIVATE 2 hops from POLICY_ROOT over any typed edge
//   4. Structural match: ref[0] equals a context ref (address equality)
//   5. Select highest signed bid; emit payload[0]; no match -> CHOICE 0
//
// Pure Zag. No Python. u8-backed stores with get32/set32
// (AGENTS.md compiler workaround: no as *i32 slice construction).
// Stores are passed as []u8 args (no globals), per rescore.zag pattern.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// byte-wise equality of two []u8
fn beq(a:[]u8, b:[]u8)i32 {
  if(_zag_strlen(a)!=_zag_strlen(b)){ return 0; }
  let n:i32=_zag_strlen(a);
  let i:i32=0;
  while(i<n){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}

// ---- layout constants ----
fn MAXN()i32 { return 256; }
fn NODESZ()i32 { return 36; }    // 9 i32: tag, ref0..3, pay0..3
fn MAXE()i32 { return 2048; }
fn EDGESZ()i32 { return 12; }    // from, to, etype
fn REG_NODE()i32 { return 0; }   // reserved register block (A12)
fn CTXSZ()i32 { return 16; }      // 4 i32 context refs

// edge types (CLA-2 vocabulary, domain-free)
fn E_DEPENDS()i32 { return 1; }
fn E_SUPPORTS()i32 { return 2; }
fn E_CONTRADICTS()i32 { return 3; }
fn E_REFINES()i32 { return 4; }
fn E_INSTANCE()i32 { return 5; }
fn E_USE()i32 { return 6; }
fn E_CONFIRMS()i32 { return 7; }
fn E_PROTECT()i32 { return 8; }
fn E_MEMBER()i32 { return 9; }

// learner-assigned node type tags (first use defines the type)
fn T_GOAL()i32 { return 101; }
fn T_GUIDE()i32 { return 102; }
fn T_UNCERT()i32 { return 103; }
fn T_CONSEQ()i32 { return 104; }
fn T_FACT()i32 { return 105; }
fn T_SESSION()i32 { return 106; }

// ---- store access ----
// nodes: flat buffer; node a at a*36; field f (0=tag,1..4=ref,5..8=pay)
fn nget(nd:[]u8, a:i32, f:i32)i32 { return get32(nd, a*36+f*4); }
fn nset(nd:[]u8, a:i32, f:i32, v:i32)void { set32(nd, a*36+f*4, v); return; }
fn ntag(nd:[]u8, a:i32)i32 { return nget(nd,a,0); }
// edges: flat buffer; edge e at e*12: from, to, etype
fn eget(ed:[]u8, e:i32, f:i32)i32 { return get32(ed, e*12+f*4); }
fn eset(ed:[]u8, e:i32, f:i32, v:i32)void { set32(ed, e*12+f*4, v); return; }

// ---- world state handle ----
// We thread three buffers plus two counters packed in a small state
// buffer st: [ncount, ecount] at offsets 0,4. Node 0 reserved.
fn st_ncount(st:[]u8)i32 { return get32(st,0); }
fn st_ecount(st:[]u8)i32 { return get32(st,4); }
fn st_setn(st:[]u8, v:i32)void { set32(st,0,v); return; }
fn st_sete(st:[]u8, v:i32)void { set32(st,4,v); return; }

// nalloc: next free address (1-based; 0 is the register block)
fn nalloc(nd:[]u8, st:[]u8)i32 {
  let a:i32=st_ncount(st);
  if(a<1){ a=1; }
  if(a>=MAXN()){ return -1; }
  st_setn(st, a+1);
  return a;
}
fn elink(ed:[]u8, st:[]u8, f:i32, t:i32, e:i32)i32 {
  let n:i32=st_ecount(st);
  if(n>=MAXE()){ return -1; }
  eset(ed,n,0,f); eset(ed,n,1,t); eset(ed,n,2,e);
  st_sete(st,n+1);
  return n;
}

// ---- A12: POLICY_ROOT via reserved node 0 ----
fn polset(nd:[]u8, a:i32)void { nset(nd,REG_NODE(),5,a); return; }
fn polget(nd:[]u8)i32 { return nget(nd,REG_NODE(),5); }

// ---- A4: 4-event context ring (core bookkeeping, content-free) ----
fn ctxpush(cx:[]u8, r:i32)void {
  set32(cx,12,get32(cx,8)); set32(cx,8,get32(cx,4));
  set32(cx,4,get32(cx,0)); set32(cx,0,r);
  return;
}
fn ctxget(cx:[]u8, k:i32)i32 { return get32(cx,k*4); }

// ---- A3/A11: signed evidence bid ----
// SUPPORTS / USE / CONFIRMS -> +1 ; CONTRADICTS -> -1.
// Counts edges touching the node (either direction, self-loop once).
fn bid(nd:[]u8, ed:[]u8, st:[]u8, a:i32)i32 {
  let s:i32=0;
  let n:i32=st_ecount(st);
  let e:i32=0;
  while(e<n){
    let f:i32=eget(ed,e,0); let t:i32=eget(ed,e,1); let k:i32=eget(ed,e,2);
    let hit:i32=0;
    if(f==a){ hit=1; }
    if(t==a){ hit=1; }
    if(hit==1){
      if(k==E_SUPPORTS() || k==E_USE() || k==E_CONFIRMS()){ s=s+1; }
      if(k==E_CONTRADICTS()){ s=s-1; }
    }
    e=e+1;
  }
  return s;
}

// ---- step 3: ACTIVATE, 2 hops over any typed edge ----
fn nbr(nd:[]u8, ed:[]u8, st:[]u8, a:i32, out:[]u8, max:i32)i32 {
  let c:i32=0;
  let n:i32=st_ecount(st);
  let e:i32=0;
  while(e<n){
    let f:i32=eget(ed,e,0); let t:i32=eget(ed,e,1);
    if(f==a && t!=REG_NODE()){
      if(c<max){ set32(out,c*4,t); c=c+1; }
    }
    if(t==a && f!=REG_NODE()){
      if(c<max){ set32(out,c*4,f); c=c+1; }
    }
    e=e+1;
  }
  return c;
}
fn seen(v:[]u8, n:i32, a:i32)i32 {
  let i:i32=0;
  while(i<n){ if(get32(v,i*4)==a){ return 1; } i=i+1; }
  return 0;
}
// collect nodes within 2 hops of root into vis; returns count
fn activate(nd:[]u8, ed:[]u8, st:[]u8, root:i32, vis:[]u8, vmax:i32)i32 {
  let vc:i32=0;
  set32(vis,0,root); vc=1;
  // hop 1
  let nb:[]u8=z_alloc(256*4);
  let nc:i32=nbr(nd,ed,st,root,nb,256);
  let i:i32=0;
  while(i<nc){
    let a:i32=get32(nb,i*4);
    if(seen(vis,vc,a)==0 && vc<vmax){ set32(vis,vc*4,a); vc=vc+1; }
    i=i+1;
  }
  // hop 2
  let h1s:i32=vc;
  let h:i32=1;
  while(h<h1s){
    let a:i32=get32(vis,h*4);
    let nc2:i32=nbr(nd,ed,st,a,nb,256);
    let j:i32=0;
    while(j<nc2){
      let b:i32=get32(nb,j*4);
      if(seen(vis,vc,b)==0 && vc<vmax){ set32(vis,vc*4,b); vc=vc+1; }
      j=j+1;
    }
    h=h+1;
  }
  return vc;
}

// ---- the generic ACT operation (five steps, zero task branches) ----
fn act_event(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  // step 2: policy-root check
  let pr:i32=polget(nd);
  if(pr<=0){ return 0; }
  if(nget(nd,pr,0)==0){ return 0; } // tombstoned root: no live policy
  // step 3: activation
  let vis:[]u8=z_alloc(256*4);
  let vc:i32=activate(nd,ed,st,pr,vis,256);
  // step 4+5: structural match + highest-bid selection
  let best:i32=-1;
  let bestbid:i32=-999999;
  let i:i32=0;
  while(i<vc){
    let a:i32=get32(vis,i*4);
    if(nget(nd,a,0)!=0){
      let r0:i32=nget(nd,a,1);
      let m:i32=0;
      let k:i32=0;
      while(k<4){ if(r0==ctxget(cx,k) && r0!=0){ m=1; } k=k+1; }
      if(m==1){
        let b:i32=bid(nd,ed,st,a);
        if(b>bestbid || (b==bestbid && (best<0 || a<best))){
          bestbid=b; best=a;
        }
      }
    }
    i=i+1;
  }
  if(best<0){ return 0; }
  return nget(nd,best,5); // payload[0] is the action value
}

// ---- learner-side structure builders (workspace processes, not core) ----
// These simulate learner-authored content via the generic primitives.
// In a full CLA-2 they are learner processes; here they are test scaffolding
// exercising the same operations a learner process would use.

fn mk_fact(nd:[]u8, st:[]u8)i32 {
  let a:i32=nalloc(nd,st);
  nset(nd,a,0,T_FACT());
  return a;
}
// GOAL node: ref0 = target entity node
fn mk_goal(nd:[]u8, st:[]u8, target:i32)i32 {
  let a:i32=nalloc(nd,st);
  nset(nd,a,0,T_GOAL()); nset(nd,a,1,target);
  return a;
}
// ACTION-GUIDE: ref0 = context anchor, ref1 = goal, pay0 = CHOICE, pay1 = conf
fn mk_guide(nd:[]u8, ed:[]u8, st:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=nalloc(nd,st);
  nset(nd,a,0,T_GUIDE()); nset(nd,a,1,anchor); nset(nd,a,2,goal);
  nset(nd,a,5,choice); nset(nd,a,6,conf);
  elink(ed,st,a,goal,E_DEPENDS());
  return a;
}
// UNCERTAINTY record: ref0 = queried key context
fn mk_uncert(nd:[]u8, st:[]u8, qctx:i32)i32 {
  let a:i32=nalloc(nd,st);
  nset(nd,a,0,T_UNCERT()); nset(nd,a,1,qctx);
  return a;
}
// A8 remap: "raise utility" -> author USE/CONFIRMS edges via OBSERVE rule.
// ses = session node authoring the evidence.
fn learn_confirm(nd:[]u8, ed:[]u8, st:[]u8, ses:i32, a:i32)void {
  elink(ed,st,ses,a,E_USE());
  elink(ed,st,ses,a,E_CONFIRMS());
  return;
}
// A8 remap: "lower utility" -> CONTRADICTS edge; DECAY pressure applies.
fn learn_contra(nd:[]u8, ed:[]u8, st:[]u8, ses:i32, outcome:i32, expect:i32)void {
  elink(ed,st,outcome,expect,E_CONTRADICTS());
  return;
}

// ---- D1 reference derivation (W7-class): backward chain from goal ----
// trans: flat array of (from_state_node, action, to_state_node) triples.
// Writes one ACTION-GUIDE per visited state. Learner-side, generic ops only.
fn derive_d1(nd:[]u8, ed:[]u8, st:[]u8, ses:i32, goal:i32, gstate:i32,
             trans:[]u8, nt:i32)i32 {
  // goal state's own guide: stay action = -1 means "already here"; we use
  // the self-loop action passed by the caller via gstate encoding below.
  let made:i32=0;
  // BFS backward from goal over transition triples
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1;
  let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    // find transitions t -> s
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        // check no guide yet for fs: scan existing guides by tag+ref0
        let has:i32=0;
        let nn:i32=st_ncount(st);
        let a:i32=1;
        while(a<nn){
          if(nget(nd,a,0)==T_GUIDE() && nget(nd,a,1)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          mk_guide(nd,ed,st,fs,goal,ac,80);
          made=made+1;
          if(seen(work,wc,fs)==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}

// ---- minimal eviction for P-ACT6 (capacity pressure demo) ----
// Evict lowest-bid non-protected live node until live count <= cap.
// Returns number evicted. (CLA-2's full 3-step routine is the CLA-2
// builder's lane; this is the test's capacity-pressure stand-in.)
fn live_count(nd:[]u8, st:[]u8)i32 {
  let c:i32=0;
  let a:i32=1;
  while(a<st_ncount(st)){
    if(ntag(nd,a)!=0){ c=c+1; }
    a=a+1;
  }
  return c;
}
fn evict_to_cap(nd:[]u8, ed:[]u8, st:[]u8, cap:i32)i32 {
  let ev:i32=0;
  let guard:i32=0;
  while(live_count(nd,st)>cap && guard<10000){
    guard=guard+1;
    let worst:i32=-1; let wb:i32=999999;
    let a:i32=2;
    while(a<st_ncount(st)){
      if(ntag(nd,a)!=0){
        let b:i32=bid(nd,ed,st,a);
        if(b<wb){ wb=b; worst=a; }
      }
      a=a+1;
    }
    if(worst<0){ return ev; }
    nset(nd,worst,0,0); // tombstone
    ev=ev+1;
  }
  return ev;
}

// ---- printing helpers ----
fn pl(s:[]u8)void { emit(s); emit("\n"); return; }
fn ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); emit(i32s(got)); emit(" want "); emit(i32s(want));
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}

// ---- fresh world state ----
fn new_world(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)void {
  st_setn(st,1); st_sete(st,0);
  nset(nd,REG_NODE(),5,0); // POLICY_ROOT null
  let k:i32=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  return;
}

// ---- test scenarios P-ACT1..P-ACT6 ----

fn setup_stores(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)void {
  new_world(nd,ed,st,cx);
  return;
}

// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_pact3(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  setup_stores(nd,ed,st,cx);
  let s1:i32=mk_fact(nd,st);
  ctxpush(cx,s1);
  let c:i32=act_event(nd,ed,st,cx);
  return ptest("P-ACT3 null-root", c, 0);
}

// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
// D1 derives guides; ACT must emit state-varying CHOICE.
fn t_pact1(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  setup_stores(nd,ed,st,cx);
  let ses:i32=mk_fact(nd,st); nset(nd,ses,0,T_SESSION());
  let s1:i32=mk_fact(nd,st);
  let s2:i32=mk_fact(nd,st);
  let s3:i32=mk_fact(nd,st);
  // transition triples (from, action, to): s1 -10-> s2 -11-> s3 -10-> s3
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  // goal formation: self-loop at s3 reified as GOAL
  let goal:i32=mk_goal(nd,st,s3);
  // D1: backward-chain guides from goal
  let made:i32=derive_d1(nd,ed,st,ses,goal,s3,tr,3);
  // POLICY_ROOT = goal (guides are 1 hop away via DEPENDS-ON)
  polset(nd,goal);
  // corroborate the guides (USE + CONFIRMS -> bid 2)
  let nn:i32=st_ncount(st);
  let a:i32=1;
  while(a<nn){
    if(nget(nd,a,0)==T_GUIDE()){ learn_confirm(nd,ed,st,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  // probe s1 -> expect 10
  let k:i32=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  ok=ok & ptest("P-ACT1 s1->10", act_event(nd,ed,st,cx), 10);
  // probe s2 -> expect 11
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s2);
  ok=ok & ptest("P-ACT1 s2->11", act_event(nd,ed,st,cx), 11);
  // probe s3 -> expect 10 (self-loop action)
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s3);
  ok=ok & ptest("P-ACT1 s3->10", act_event(nd,ed,st,cx), 10);
  // guides were made for all three states
  ok=ok & ptest("P-ACT1 3 guides", made, 3);
  return ok;
}

// P-ACT2: W6-class inquiry. UNCERTAINTY record anchors the inquiry policy.
// Actions follow the uncertainty record, not any positional cue
// (act_event takes no positional input at all: structural guarantee).
fn t_pact2(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  setup_stores(nd,ed,st,cx);
  let ses:i32=mk_fact(nd,st); nset(nd,ses,0,T_SESSION());
  let q:i32=mk_fact(nd,st);       // query context that missed (-2)
  let d:i32=mk_fact(nd,st);       // decoy context
  let u:i32=mk_uncert(nd,st,q);   // uncertainty record, ref0 = q
  let idx:i32=mk_fact(nd,st);     // policy index node
  // inquiry guide anchored at the uncertainty record
  let g1:i32=mk_guide(nd,ed,st,u,0,20,90);
  // decoy guide anchored at the decoy context
  let g2:i32=mk_guide(nd,ed,st,d,0,21,90);
  elink(ed,st,idx,g1,E_DEPENDS());
  elink(ed,st,idx,g2,E_DEPENDS());
  polset(nd,idx);
  learn_confirm(nd,ed,st,ses,g1);
  learn_confirm(nd,ed,st,ses,g2);
  let ok:i32=1;
  // uncertainty live -> inquiry action 20
  let k:i32=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,u);
  ok=ok & ptest("P-ACT2 uncert->20", act_event(nd,ed,st,cx), 20);
  // decoy context -> decoy action 21 (not 20: no positional bleed)
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,d);
  ok=ok & ptest("P-ACT2 decoy->21", act_event(nd,ed,st,cx), 21);
  // unrelated context -> 0
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,q);
  ok=ok & ptest("P-ACT2 other->0", act_event(nd,ed,st,cx), 0);
  return ok;
}

// P-ACT4: structure ablation.
// (a) delete ACTION-GUIDEs -> constant 0. (b) delete GOAL -> degraded;
//     facts remain readable (recall intact).
fn t_pact4(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  setup_stores(nd,ed,st,cx);
  let ses:i32=mk_fact(nd,st); nset(nd,ses,0,T_SESSION());
  let s1:i32=mk_fact(nd,st);
  let s2:i32=mk_fact(nd,st);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=mk_goal(nd,st,s2);
  derive_d1(nd,ed,st,ses,goal,s2,tr,2);
  polset(nd,goal);
  let nn:i32=st_ncount(st);
  let a:i32=1;
  while(a<nn){
    if(nget(nd,a,0)==T_GUIDE()){ learn_confirm(nd,ed,st,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  // sanity: works before ablation
  let k:i32=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  ok=ok & ptest("P-ACT4 pre s1->10", act_event(nd,ed,st,cx), 10);
  // (a) tombstone all guides
  a=1;
  while(a<nn){
    if(nget(nd,a,0)==T_GUIDE()){ nset(nd,a,0,0); }
    a=a+1;
  }
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  ok=ok & ptest("P-ACT4 no-guides->0", act_event(nd,ed,st,cx), 0);
  // (b) restore guides, tombstone the goal (POLICY_ROOT dead)
  a=1;
  while(a<nn){
    if(nget(nd,a,0)==0 && a!=goal){ nset(nd,a,0,T_GUIDE()); }
    a=a+1;
  }
  nset(nd,goal,0,0);
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  // root dead -> act_event must refuse (0), not hallucinate
  let c:i32=act_event(nd,ed,st,cx);
  // act_event reads polget()=goal address; goal tombstoned.
  // We require 0 here: no action without a live policy root.
  ok=ok & ptest("P-ACT4 no-goal->0", c, 0);
  // recall intact: fact nodes still readable
  ok=ok & ptest("P-ACT4 fact-alive", ntag(nd,s1), T_FACT());
  return ok;
}

// P-ACT5: generality. The identical frozen act_event serves W6-class and
// W7-class scenarios. Structural: one code path, zero branches on world,
// task, or relation identity (verifiable by inspection: act_event takes
// only stores + context, no world/task/relation parameters).
fn t_pact5(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  // Run the W7 scenario and the W6 scenario back-to-back through the
  // same act_event. Success of both through one function is the test.
  let ok:i32=t_pact1(nd,ed,st,cx);
  ok=ok & t_pact2(nd,ed,st,cx);
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}

// P-ACT6: memory prerequisite (honest dependency on retention).
// Phase A: guides with no evidence (bid 0) under capacity pressure are
//   evicted -> ACT degrades to 0.
// Phase B: guides with USE/CONFIRMS evidence (bid 2) survive the same
//   pressure -> ACT holds. The retention mechanism, not the handler,
//   decides.
fn t_pact6(nd:[]u8, ed:[]u8, st:[]u8, cx:[]u8)i32 {
  let ok:i32=1;
  // ---- phase A: no evidence ----
  setup_stores(nd,ed,st,cx);
  let ses:i32=mk_fact(nd,st); nset(nd,ses,0,T_SESSION());
  let s1:i32=mk_fact(nd,st);
  let s2:i32=mk_fact(nd,st);
  let goal:i32=mk_goal(nd,st,s2);
  let g1:i32=mk_guide(nd,ed,st,s1,goal,10,80);
  polset(nd,goal);
  // sanity: works before pressure
  let k:i32=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  ok=ok & ptest("P-ACT6A pre s1->10", act_event(nd,ed,st,cx), 10);
  // flood with junk (bid 0, same as the unevidenced guide)
  let j:i32=0;
  while(j<240){
    let x:i32=mk_fact(nd,st);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=evict_to_cap(nd,ed,st,40);
  emit("P-ACT6A evicted "); emit(i32s(nev)); emit(" nodes\n");
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  // guide had bid 0 and a low address -> evicted first under pressure
  ok=ok & ptest("P-ACT6A post->0", act_event(nd,ed,st,cx), 0);
  // ---- phase B: with evidence ----
  setup_stores(nd,ed,st,cx);
  ses=mk_fact(nd,st); nset(nd,ses,0,T_SESSION());
  s1=mk_fact(nd,st);
  s2=mk_fact(nd,st);
  goal=mk_goal(nd,st,s2);
  g1=mk_guide(nd,ed,st,s1,goal,10,80);
  polset(nd,goal);
  learn_confirm(nd,ed,st,ses,g1); // bid 2: USE + CONFIRMS
  // the goal and the anchor are in active use: they carry evidence too.
  // (models the CLA-2 dynamic where live objectives/anchors are corroborated)
  learn_confirm(nd,ed,st,ses,goal);
  elink(ed,st,ses,s1,E_USE());
  j=0;
  while(j<240){
    let x:i32=mk_fact(nd,st);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=evict_to_cap(nd,ed,st,40);
  emit("P-ACT6B evicted "); emit(i32s(nev)); emit(" nodes\n");
  k=0; while(k<4){ set32(cx,k*4,0); k=k+1; }
  ctxpush(cx,s1);
  ok=ok & ptest("P-ACT6B post s1->10", act_event(nd,ed,st,cx), 10);
  return ok;
}

fn usage()void {
  pl("usage: act_bin t1|t2|t3|t4|t5|t6|all");
  pl("  t1 P-ACT1 planning   t2 P-ACT2 inquiry   t3 P-ACT3 null root");
  pl("  t4 P-ACT4 ablation   t5 P-ACT5 generality t6 P-ACT6 eviction");
  return;
}
fn main()i32 {
  let nd:[]u8=z_alloc(MAXN()*NODESZ());
  let ed:[]u8=z_alloc(MAXE()*EDGESZ());
  let st:[]u8=z_alloc(8);
  let cx:[]u8=z_alloc(CTXSZ());
  if(_zag_argc()<2){ usage(); return 2; }
  let m:[]u8=_zag_arg(1);
  let pass:i32=1;
  if(beq(m,"t1")==1){ pass=t_pact1(nd,ed,st,cx); }
  if(beq(m,"t2")==1){ pass=t_pact2(nd,ed,st,cx); }
  if(beq(m,"t3")==1){ pass=t_pact3(nd,ed,st,cx); }
  if(beq(m,"t4")==1){ pass=t_pact4(nd,ed,st,cx); }
  if(beq(m,"t5")==1){ pass=t_pact5(nd,ed,st,cx); }
  if(beq(m,"t6")==1){ pass=t_pact6(nd,ed,st,cx); }
  if(beq(m,"all")==1){
    pass=t_pact3(nd,ed,st,cx);
    pass=pass & t_pact1(nd,ed,st,cx);
    pass=pass & t_pact2(nd,ed,st,cx);
    pass=pass & t_pact4(nd,ed,st,cx);
    // t5 re-runs t1+t2; run standalone for the generality banner
    pass=pass & t_pact5(nd,ed,st,cx);
    pass=pass & t_pact6(nd,ed,st,cx);
  }
  if(pass==1){ pl("ALL-PASS"); return 0; }
  pl("SOME-FAIL");
  return 1;
}

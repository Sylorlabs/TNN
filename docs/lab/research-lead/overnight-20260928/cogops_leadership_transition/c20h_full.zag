//   visited subject.
// Whole state oscillates at lag 2 (no drifter): the PW-form
// strategy wins efficiently. Context (3,613).
fn mk_goal830_PW(G:[]u8)void {
  let o:i32=w_begin(G,830,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,613); o=w_f(G,o,770);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,614); o=w_f(G,o,770);
  o=w_links(G,o,2);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,2,2,0,0,1,1,0);
  return;
}
// Goal 831 NEED0 (NEED-world, world F): goal 830's structure
// PLUS need3 P=(604,611) with kind-1 SELF-link: walks
// 612->613->..->618 (convergent drifter; never repeats within
// the episode). PARTIAL oscillation: the whole-state snapshot
// never repeats (need3 drifts) while needs 0..2 cycle at lag 2.
// PW fails, WHOLE fails, NEED wins. Context (4,613).
fn mk_goal831_NEED(G:[]u8)void {
  let o:i32=w_begin(G,831,4);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,613); o=w_f(G,o,770);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,614); o=w_f(G,o,770);
  o=w_need(G,o,801,2); o=w_f(G,o,604); o=w_f(G,o,611);
  o=w_links(G,o,3);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,2,2,0,0,1,1,0);
  o=w_link(G,o,1,3,0,1,3,1,0);
  return;
}
// Goal 832 TEST0 (TEST-world, world F): byte-identical structure
// to goal 831, fresh goal tag 832 (defeats outcome reuse; shares
// context (4,613) with 831, so the strategy table carries 831's
// history into the tie). The alternation test world.
fn mk_goal832_TEST(G:[]u8)void {
  let o:i32=w_begin(G,832,4);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,613); o=w_f(G,o,770);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,614); o=w_f(G,o,770);
  o=w_need(G,o,801,2); o=w_f(G,o,604); o=w_f(G,o,611);
  o=w_links(G,o,3);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,2,2,0,0,1,1,0);
  o=w_link(G,o,1,3,0,1,3,1,0);
  return;
}
// c19_world_add.zag -- COGOPS-HEDGE-FREQUENCY world additions.
// Appended AFTER c18_world.zag (used verbatim) in the c19/c19h
// builds. All world literals live here (world file); the strat
// additive sections carry zero literals.
// setup_worldF_plus: world F plus the rel-615/616 period-3
// workload (7 facts copied from setup_worldE; 77+7=84 facts,
// capacity 128). Called silently by the driver before the
// first period-3 stage; prints nothing.
fn setup_worldF_plus(A:[]u8)void {
  setup_worldF(A);
  fact_add(A,781,615,780);
  fact_add(A,782,615,781);
  fact_add(A,783,615,782);
  fact_add(A,781,615,783);
  fact_add(A,781,616,780);
  fact_add(A,782,616,780);
  fact_add(A,783,616,780);
  return;
}
// mk_goalX(G,tag,kind): 7 world kinds for the frequency battery.
// All constructors are flat w_* call sequences (no loops, no
// nesting). need tags 801/802 are reused from the frozen
// battery (bindings already learned); goal tags are fresh per
// stage (defeat outcome reuse; contexts share strategy tables).
// kind 1 (P3): 830 structure: 3 needs, pure lag-2 oscillation,
//   context (3,613). PW-winnable.
// kind 2 (N3): need0 P=(601,621); need1 P=(613,770) kind-1
//   SELF-link (771<->772); need2 P=(604,611) kind-1 SELF-link
//   (612->..->618 drifter). 3 needs, context (3,613).
//   NEED-winnable: whole state never repeats within the
//   episode (drifter), needs 0,1 match at lag 2.
// kind 3 (P4): kind 1 plus need3 P=(604,611) with NO self-link
//   (constant [612] each pass). 4 needs, context (4,613).
//   PW-winnable.
// kind 4 (N4): 831 structure: 4 needs, context (4,613).
//   NEED-winnable.
// kind 5 (P3E): 821 structure: 615 3-cycle kind-1 SELF-link +
//   616 verify fan-out. 3 needs, context (3,615).
//   WHOLE-winnable at lag 3 (PW fails: no lag-1/2 repeat).
// kind 6 (D3E): need0 P=(601,621); need1 P=(615,780) kind-1
//   SELF-link; need2 P=(604,611) kind-1 SELF-link. 3 needs,
//   context (3,615). Unwinnable: whole state never repeats,
//   no per-need lag-2 match (3-cycle, drifter).
// kind 7 (DR3): 816 structure: 604 drifter kind-1 SELF-link +
//   605 verify fan-out. 3 needs, context (3,604).
//   Unwinnable (convergent drifter; all strategies fail).
fn mk_goalX(G:[]u8,tag:i32,kind:i32)void {
  if(kind==1){
    let o1:i32=w_begin(G,tag,3);
    o1=w_need(G,o1,801,2); o1=w_f(G,o1,601); o1=w_f(G,o1,621);
    o1=w_need(G,o1,801,2); o1=w_f(G,o1,613); o1=w_f(G,o1,770);
    o1=w_need(G,o1,802,4); o1=w_f(G,o1,1);
    o1=w_f(G,o1,0); o1=w_f(G,o1,614); o1=w_f(G,o1,770);
    o1=w_links(G,o1,2);
    o1=w_link(G,o1,1,1,0,1,1,1,0);
    o1=w_link(G,o1,2,2,0,0,1,1,0);
    return;
  }
  if(kind==2){
    let o2:i32=w_begin(G,tag,3);
    o2=w_need(G,o2,801,2); o2=w_f(G,o2,601); o2=w_f(G,o2,621);
    o2=w_need(G,o2,801,2); o2=w_f(G,o2,613); o2=w_f(G,o2,770);
    o2=w_need(G,o2,801,2); o2=w_f(G,o2,604); o2=w_f(G,o2,611);
    o2=w_links(G,o2,2);
    o2=w_link(G,o2,1,1,0,1,1,1,0);
    o2=w_link(G,o2,1,2,0,1,2,1,0);
    return;
  }
  if(kind==3){
    let o3:i32=w_begin(G,tag,4);
    o3=w_need(G,o3,801,2); o3=w_f(G,o3,601); o3=w_f(G,o3,621);
    o3=w_need(G,o3,801,2); o3=w_f(G,o3,613); o3=w_f(G,o3,770);
    o3=w_need(G,o3,802,4); o3=w_f(G,o3,1);
    o3=w_f(G,o3,0); o3=w_f(G,o3,614); o3=w_f(G,o3,770);
    o3=w_need(G,o3,801,2); o3=w_f(G,o3,604); o3=w_f(G,o3,611);
    o3=w_links(G,o3,2);
    o3=w_link(G,o3,1,1,0,1,1,1,0);
    o3=w_link(G,o3,2,2,0,0,1,1,0);
    return;
  }
  if(kind==4){
    let o4:i32=w_begin(G,tag,4);
    o4=w_need(G,o4,801,2); o4=w_f(G,o4,601); o4=w_f(G,o4,621);
    o4=w_need(G,o4,801,2); o4=w_f(G,o4,613); o4=w_f(G,o4,770);
    o4=w_need(G,o4,802,4); o4=w_f(G,o4,1);
    o4=w_f(G,o4,0); o4=w_f(G,o4,614); o4=w_f(G,o4,770);
    o4=w_need(G,o4,801,2); o4=w_f(G,o4,604); o4=w_f(G,o4,611);
    o4=w_links(G,o4,3);
    o4=w_link(G,o4,1,1,0,1,1,1,0);
    o4=w_link(G,o4,2,2,0,0,1,1,0);
    o4=w_link(G,o4,1,3,0,1,3,1,0);
    return;
  }
  if(kind==5){
    let o5:i32=w_begin(G,tag,3);
    o5=w_need(G,o5,801,2); o5=w_f(G,o5,601); o5=w_f(G,o5,621);
    o5=w_need(G,o5,801,2); o5=w_f(G,o5,615); o5=w_f(G,o5,780);
    o5=w_need(G,o5,802,4); o5=w_f(G,o5,1);
    o5=w_f(G,o5,0); o5=w_f(G,o5,616); o5=w_f(G,o5,780);
    o5=w_links(G,o5,2);
    o5=w_link(G,o5,1,1,0,1,1,1,0);
    o5=w_link(G,o5,2,2,0,0,1,1,0);
    return;
  }
  if(kind==6){
    let o6:i32=w_begin(G,tag,3);
    o6=w_need(G,o6,801,2); o6=w_f(G,o6,601); o6=w_f(G,o6,621);
    o6=w_need(G,o6,801,2); o6=w_f(G,o6,615); o6=w_f(G,o6,780);
    o6=w_need(G,o6,801,2); o6=w_f(G,o6,604); o6=w_f(G,o6,611);
    o6=w_links(G,o6,2);
    o6=w_link(G,o6,1,1,0,1,1,1,0);
    o6=w_link(G,o6,1,2,0,1,2,1,0);
    return;
  }
  if(kind==7){
    let o7:i32=w_begin(G,tag,3);
    o7=w_need(G,o7,801,2); o7=w_f(G,o7,601); o7=w_f(G,o7,621);
    o7=w_need(G,o7,801,2); o7=w_f(G,o7,604); o7=w_f(G,o7,611);
    o7=w_need(G,o7,802,4); o7=w_f(G,o7,1);
    o7=w_f(G,o7,0); o7=w_f(G,o7,605); o7=w_f(G,o7,640);
    o7=w_links(G,o7,2);
    o7=w_link(G,o7,1,1,0,1,1,1,0);
    o7=w_link(G,o7,2,2,0,0,1,1,0);
    return;
  }
  return;
}
// mk_goal8(G,tag): kind 8 for the leadership-transition battery.
// Context (3,613) [need1 field0 = 613]. Unwinnable by all four
// forms: need0 P=(601,621) -> [611] constant; need1 P=(613,770)
// with NO self-link -> [771] constant (613 not in the learner's
// ret coverage: generic retrieve); need2 P=(604,611) with a
// kind-1 SELF-link -> convergent drifter 612..618 (604 IS in
// the ret coverage from S6L episodes and WAS indexed at S6B
// from world-F facts). Whole state never repeats within the
// episode (drifter) -> PW/WHOLE fail; per-need matches are only
// the two constant carriers (trivial match set) -> NEED fails;
// ALT fails. Flat w_* call sequence (no loops, no nesting).
fn mk_goal8(G:[]u8,tag:i32)void {
  let o8:i32=w_begin(G,tag,3);
  o8=w_need(G,o8,801,2); o8=w_f(G,o8,601); o8=w_f(G,o8,621);
  o8=w_need(G,o8,801,2); o8=w_f(G,o8,613); o8=w_f(G,o8,770);
  o8=w_need(G,o8,801,2); o8=w_f(G,o8,604); o8=w_f(G,o8,611);
  o8=w_links(G,o8,1);
  o8=w_link(G,o8,1,2,0,1,2,1,0);
  return;
}
// mk_goal9(G,tag): kind 9 for the leadership-transition battery.
// Context (4,613) [need1 field0 = 613]. The kind-8 shape plus
// need3 P=(605,640) -> constant 8-subject record (605 not in
// the ret coverage: generic retrieve). Unwinnable by the same
// argument: need2 drifts, NEED match set all-trivial.
fn mk_goal9(G:[]u8,tag:i32)void {
  let o9:i32=w_begin(G,tag,4);
  o9=w_need(G,o9,801,2); o9=w_f(G,o9,601); o9=w_f(G,o9,621);
  o9=w_need(G,o9,801,2); o9=w_f(G,o9,613); o9=w_f(G,o9,770);
  o9=w_need(G,o9,801,2); o9=w_f(G,o9,604); o9=w_f(G,o9,611);
  o9=w_need(G,o9,801,2); o9=w_f(G,o9,605); o9=w_f(G,o9,640);
  o9=w_links(G,o9,1);
  o9=w_link(G,o9,1,2,0,1,2,1,0);
  return;
}
// c4_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Diamond follow-up to C422 (c3_learn.zag): plan records widened to 4
// needs per plan (56-byte entries), stats block moved to 13224, and
// apply_kind3 generalized to multi-source fan-in (preregistered).
// Binding by trial, topo assembly, version selection, plan
// persist/reuse/re-derive, and decline logic are the C422 logic
// unchanged.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   BIND table at 12744: 8 entries x 32 bytes:
//     [tag, bound_fam, ok0, f0, ok1, f1, ok2, f2].
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects. Returns -1 if the relation is outside the
// learned coverage.
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 3) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED (preregistered, Section 2.4): subjects from ALL incoming
// kind-3 links concatenate in goal-record link order into SUBL[ni*128].
// On a chain (one incoming kind-3 link) this is byte-identical to the
// C422 behavior; on a diamond (two or more sources) it is the generic
// fan-in reading. No goal-shape test, no branch count: the same link
// kind applies uniformly to any DAG.
// Returns 1 if at least one kind-3 link targeted ni, else 0.
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*160);
        let k:i32=0;
        while(k<n){
          set32(SUBL,ni*128+4+tot*4,get32(OUTS,sn*160+4+k*4));
          tot=tot+1;
          k=k+1;
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*128,tot);
    return 1;
  }
  return 0;
}
// ---- binding table ----
fn bind_off(bi:i32)i32 { return 12744+bi*32; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Returns 1 iff every need tag ends bound; 0 if any need is unbindable.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_fam(L,bi)<0){
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        let bo:i32=bind_off(bi);
        if(fam==0){
          if(r==1){ set32(L,bo+8,get32(L,bo+8)+1); }
          if(r==0){ set32(L,bo+12,get32(L,bo+12)+1); }
        }
        if(fam==1){
          if(r==1){ set32(L,bo+16,get32(L,bo+16)+1); }
          if(r==0){ set32(L,bo+20,get32(L,bo+20)+1); }
        }
        if(fam==2){
          if(r==1){ set32(L,bo+24,get32(L,bo+24)+1); }
          if(r==0){ set32(L,bo+28,get32(L,bo+28)+1); }
        }
        if(r==1){
          if(bind_fam(L,bi)<0){ set32(L,bo+4,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let bi2:i32=bind_find(L,need_tag(G,m));
    if(bi2<0){ return 0; }
    if(bind_fam(L,bi2)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){
      let nn:i32=g_nneeds(G);
      set32(L,13000+pi*56,gtag);
      set32(L,13000+pi*56+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        set32(L,13000+pi*56+8+p*12,ni);
        set32(L,13000+pi*56+8+p*12+4,tag);
        set32(L,13000+pi*56+8+p*12+8,bind_fam(L,bi));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1,idx2,tag2,fam2,idx3,tag3,fam3]
// into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)!=0){
      let k:i32=0;
      while(k<14){
        set32(out,k*4,get32(L,13000+pi*56+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,13000+pi*56,0); pi=pi+1; }
  return;
}
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<8){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*80+4);
      let ver3:i32=cnt_version(L,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
      let ns3:i32=0;
      if(has3==1){ ns3=get32(SUBL,ni*128); }
      if(has3==0){
        set32(SUBL,ni*128,1);
        set32(SUBL,ni*128+4,get32(W,ni*80+12));
        ns3=1;
      }
      let cc:i32=0;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,cc);
      ans_append_rec(ans,OUTS,ni);
    }
    p=p+1;
  }
  return;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
  return 1;
}

// =====================================================================
// c5 ADDITIVE GENERALIZATION (PREREG Section 2.2).
// Everything above this line is byte-identical to c4_learn.zag
// (cogops-diamond). What follows is purely additive: no C433
// function is modified. Frozen entry points keep their names:
// compose, execute_plan, topo, apply_kind1.
// New entry points: topo_g, apply_kind1_g, snap_out, out_eq_snap,
// exec_step_iter, execute_plan_iter, compose_iter, plan_drop.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records.
// =====================================================================

// ---- topo_g: Kahn with stall detection + deterministic fallback ----
// Runs Kahn; if no zero-indegree unplaced node remains, stops
// (instead of the frozen topo's re-place-node-0, which silently
// corrupts the order) and appends the unplaced needs in index
// order. Returns the Kahn-placed count (== nneeds on a DAG).
// Not cycle detection: it completes any partial order
// deterministically, with no goal-shape or back-edge test.
fn topo_g(G:[]u8,ord:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let kplaced:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return kplaced;
}
// ---- apply_kind1_g: kind-1 links fire only from non-empty sources ----
// Uniform dataflow rule: a scalar-copy link carries the source
// need's produced value; if the source output record is empty
// there is no value to carry, so the destination field keeps its
// current value. Identical to apply_kind1 whenever every kind-1
// source is non-empty (the whole C433 battery).
fn apply_kind1_g(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let sn:i32=link_w(G,l,4);
      if(get32(OUTS,sn*160)>0){
        let ds:i32=link_w(G,l,3);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let v:i32=0;
        if(sk==0){ v=get32(W,sn*80+4+ss*4); }
        if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
        set32(W,ni*80+4+ds*4,v);
      }
    }
    l=l+1;
  }
  return;
}
// ---- output-record snapshot / comparison helpers ----
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8)void {
  let n:i32=get32(OUTS,ni*160);
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8)i32 {
  let n:i32=get32(OUTS,ni*160);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*160+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- exec_step_iter: execute one plan step with the generalized link rule ----
// Versions recorded to vbuf[p*4]. No answer emission; the caller
// emits final records after quiescence.
fn exec_step_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,p:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  let ni:i32=get32(L,13000+pi*56+8+p*12);
  let fam:i32=get32(L,13000+pi*56+8+p*12+8);
  apply_kind1_g(G,W,OUTS,ni);
  if(fam==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    let ver:i32=ret_version(L,rel);
    set32(vbuf,p*4,ver);
    if(ver==2){
      set32(L,13252,get32(L,13252)+1);
      ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
    }
    if(ver==0){
      set32(L,13256,get32(L,13256)+1);
      ret_gen(A,rel,obj,K,0,OUTS,ni*160);
    }
  }
  if(fam==1){
    let ver2:i32=vfy_version(L,W,ni);
    set32(vbuf,p*4,ver2);
    if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
    if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
    let src:i32=fanin_src(G,ni);
    if(src<0){
      w_to_chain(W,ni,tmpc,-1);
      let vv:i32=0;
      if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
      if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,vv);
    }
    if(src>=0){
      let nsub:i32=get32(OUTS,src*160);
      let npass:i32=0;
      let k:i32=0;
      while(k<nsub){
        let sub:i32=get32(OUTS,src*160+4+k*4);
        w_to_chain(W,ni,tmpc,sub);
        let vv2:i32=0;
        if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
        if(vv2==1){
          set32(OUTS,ni*160+4+npass*4,sub);
          npass=npass+1;
        }
        k=k+1;
      }
      set32(OUTS,ni*160,npass);
    }
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*80+4);
    let ver3:i32=cnt_version(L,rel3);
    set32(vbuf,p*4,ver3);
    let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
    let ns3:i32=0;
    if(has3==1){ ns3=get32(SUBL,ni*128); }
    if(has3==0){
      set32(SUBL,ni*128,1);
      set32(SUBL,ni*128+4,get32(W,ni*80+12));
      ns3=1;
    }
    let cc:i32=0;
    if(ver3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    if(ver3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    set32(OUTS,ni*160,1);
    set32(OUTS,ni*160+4,cc);
  }
  return;
}
// ---- execute_plan_iter: change-driven iterated execution ----
// Steps run in plan order; a need executes when dirty (all start
// dirty). If its output record changed, link-successors are marked
// dirty. Halts on quiescence (a pass with no dirty need) or the
// pass CAP (16, frozen totality bound). Answer records are emitted
// in plan order with FINAL values. vbuf[20] gets passes used.
fn execute_plan_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  while(running==1){
    if(pass>=cap){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(L,13000+pi*56+8+p*12);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  let q:i32=0;
  while(q<nn){
    let nj:i32=get32(L,13000+pi*56+8+q*12);
    ans_append_rec(ans,OUTS,nj);
    q=q+1;
  }
  return;
}
// ---- compose_iter: the generalized composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes used; ans = final records.
fn compose_iter(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let dirty:[]u8=z_alloc(16);
  let snap:[]u8=z_alloc(136);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
  return 1;
}
// ---- plan_drop: clear the stored plan for one goal tag (generic) ----
fn plan_drop(L:[]u8,gtag:i32)void {
  let pi:i32=plan_find(L,gtag);
  if(pi>=0){ set32(L,13000+pi*56,0); }
  return;
}

// =====================================================================
// c7 ADDITIVE: learner-invented oscillation handling.
// Everything above this line is byte-identical to c6_learn.zag
// (cogops-oscillatory). What follows is purely additive: no frozen
// function is modified. New entry points: traj_base, outc_base,
// outc_phase_base, traj_log, traj_need_eq, traj_state_eq,
// osc_review, outc_find, outc_phase_copy, outc_store,
// outc_phase_eq, osc_one_pass, osc_handle.
// Learner-state regions (L holds 16384 bytes; prior use ends at
// 13276):
//   TRAJ at 13300: [ntraj]; snapshots at 13304+(pass*4+ni)*36,
//   pass below 8, ni below 4; each need snapshot is nine i32
//   cells [n, v0..v7].
//   OUTC at 14500: [nout]; at most three entries of 464 bytes at
//   14504+e*464: [goal_tag, lag, nph, src, four reserved cells,
//   then phases: at most three phases times four needs times
//   nine i32 cells].
// No world literals, no goal tags, no need tags, no relation ids
// appear below: every value arrives at runtime through goal
// records, episodes, or the trajectory.
// =====================================================================

fn traj_base(pass:i32,ni:i32)i32 { return 13304+(pass*4+ni)*36; }
fn outc_base(e:i32)i32 { return 14504+e*464; }
fn outc_phase_base(e:i32,t:i32,ni:i32)i32 {
  return 14504+e*464+32+(t*4+ni)*36;
}
// snapshot every need's output record after one pass
fn traj_log(L:[]u8,OUTS:[]u8,nn:i32,pass:i32)void {
  if(pass<0){ return; }
  if(pass>7){ return; }
  let j:i32=0;
  while(j<nn){
    let n:i32=get32(OUTS,j*160);
    let bo:i32=traj_base(pass,j);
    set32(L,bo,n);
    let k:i32=0;
    while(k<8){
      let v:i32=0;
      if(k<n){ v=get32(OUTS,j*160+4+k*4); }
      set32(L,bo+4+k*4,v);
      k=k+1;
    }
    j=j+1;
  }
  set32(L,13300,pass+1);
  return;
}
fn traj_need_eq(L:[]u8,p:i32,q:i32,ni:i32)i32 {
  let bp:i32=traj_base(p,ni);
  let bq:i32=traj_base(q,ni);
  let n:i32=get32(L,bp);
  if(n!=get32(L,bq)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,bp+4+k*4)!=get32(L,bq+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
fn traj_state_eq(L:[]u8,p:i32,q:i32,nn:i32)i32 {
  let j:i32=0;
  while(j<nn){
    if(traj_need_eq(L,p,q,j)==0){ return 0; }
    j=j+1;
  }
  return 1;
}
// nearest-first scan: does snapshot[pass] equal an earlier
// snapshot? Returns the lag, or zero when nothing recurs.
fn osc_review(L:[]u8,nn:i32,pass:i32)i32 {
  let q:i32=pass-1;
  while(q>=0){
    if(traj_state_eq(L,pass,q,nn)==1){ return pass-q; }
    q=q-1;
  }
  return 0;
}
fn outc_find(L:[]u8,gtag:i32)i32 {
  let n:i32=get32(L,14500);
  let e:i32=0;
  while(e<n){
    if(get32(L,outc_base(e))==gtag){ return e; }
    e=e+1;
  }
  return -1;
}
fn outc_phase_copy(L:[]u8,e:i32,t:i32,ni:i32,p:i32)void {
  let sb:i32=traj_base(p,ni);
  let db:i32=outc_phase_base(e,t,ni);
  let k:i32=0;
  while(k<9){
    set32(L,db+k*4,get32(L,sb+k*4));
    k=k+1;
  }
  return;
}
fn outc_store(L:[]u8,gtag:i32,lag:i32,q:i32,nn:i32,src:i32)i32 {
  let e:i32=outc_find(L,gtag);
  if(e<0){
    e=get32(L,14500);
    if(e>2){ e=0; }
    if(get32(L,14500)<3){ set32(L,14500,get32(L,14500)+1); }
  }
  let b:i32=outc_base(e);
  set32(L,b,gtag);
  set32(L,b+4,lag);
  set32(L,b+8,lag);
  set32(L,b+12,src);
  set32(L,b+16,0);
  set32(L,b+20,0);
  set32(L,b+24,0);
  set32(L,b+28,0);
  let t:i32=0;
  while(t<lag){
    let j:i32=0;
    while(j<nn){
      outc_phase_copy(L,e,t,j,q+t);
      j=j+1;
    }
    t=t+1;
  }
  return e;
}
// stored phase (e,t,ni) against trajectory snapshot p
fn outc_phase_eq(L:[]u8,e:i32,t:i32,ni:i32,p:i32)i32 {
  let db:i32=outc_phase_base(e,t,ni);
  let sb:i32=traj_base(p,ni);
  let n:i32=get32(L,db);
  if(n!=get32(L,sb)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,db+4+k*4)!=get32(L,sb+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// one full pass over the plan in plan order; R+28 is the
// spec-version flag, cleared if any step misses its spec version
fn osc_one_pass(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8)void {
  let nn:i32=get32(L,13000+pi*56+4);
  let p:i32=0;
  while(p<nn){
    exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    let ver:i32=get32(vbuf,p*4);
    let want:i32=-1;
    if(fam==0){ want=2; }
    if(fam==1){ want=3; }
    if(fam==2){ want=5; }
    if(ver!=want){ set32(R,28,0); }
    p=p+1;
  }
  return;
}
// osc_handle: the learner-owned oscillation-handling driver.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a response invented from this trajectory,
// 2 handled by a stored response from the outcome record.
fn osc_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let vbuf:[]u8=z_alloc(32);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  let gt:i32=g_tag(G);
  let pre:i32=plan_find(L,gt);
  let pi:i32=pre;
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
  }
  if(pi<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  let nn:i32=get32(L,13000+pi*56+4);
  mat_inputs(G,W);
  let e:i32=outc_find(L,gt);
  if(e>=0){
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
        traj_log(L,OUTS,nn,mpass);
        let jj:i32=0;
        while(jj<nn){
          if(outc_phase_eq(L,e,mpass,jj,mpass)==0){ okk=0; }
          jj=jj+1;
        }
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  let pass:i32=0;
  while(pass<6){
    osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
    traj_log(L,OUTS,nn,pass);
    if(pass>1){
      let lag:i32=osc_review(L,nn,pass);
      if(lag==1){ return 0; }
      if(lag>1){
        if(lag<4){
          let q0:i32=pass-lag;
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass+1);
          if(traj_state_eq(L,pass+1,q0+1,nn)==1){
            let ee:i32=outc_store(L,gt,lag,q0,nn,0);
            set32(R,0,1);
            set32(R,4,pass+2);
            set32(R,8,lag);
            set32(R,12,q0);
            set32(R,16,lag);
            set32(R,20,0);
            set32(R,24,ee);
            return 1;
          }
          return 0;
        }
      }
    }
    pass=pass+1;
  }
  return 0;
}
// =====================================================================
// ADDITIVE SECTION (c16, COGOPS-PESSIMISTIC). Appended to the frozen
// c8_learn.zag prefix (lines 1..1331 of c12_learn.zag) without
// modifying any frozen function.
// Learner-chosen detection strategy, per-context tables,
// PESSIMISTIC-PRIOR RESCUE-AWARE EXPECTED-COST selection.
//
// Four detection strategy forms: 1=PW (pairwise, the
// COGOPS-DETECTION proposal form), 2=WHOLE (whole-state lag sweep),
// 3=NEED (per-need subset), 4=ALT (alternation of PW-form and
// NEED-form across two passes). A learner-state strategy table
// records per-strategy uses, wins, and cost from the learner's own
// verification history, but PER CONTEXT, not global: different
// goal contexts keep different strategy histories. The context is
// a learner-computed signature (nneeds, need_f(G,1,0)) read from
// the goal record at structural positions; no world/goal literals.
// Selection is RESCUE-AWARE EXPECTED COST
//   score_s = E[turn_s] + P(fail_s) * E[rescue]
// within the current context's table, with lower-id tie-break:
// the learner's Laplace-smoothed estimate of the comparisons one
// turn of the strategy will cost, PLUS the failure probability
// times the expected cost of the rescue loop the failure triggers.
// E[turn_s]=(c+8)/(u+2); P(fail_s)=(u-w+1)/(u+2) from the
// learner's own uses/wins; E[rescue]=(rt+2)/(rc+2) from the
// learner's own global rescue ledger (rt = total post-failure
// comparisons observed, rc = rescue loops observed). Unlike
// turn-level expected cost, P(success) does NOT cancel: the
// failure probability re-enters through the rescue term, so a
// strategy that fails often pays for the rescue loop it triggers.
// The score reduces to the argmin of N_s/(u_s+2) with
// N_s=(c+8)(rc+2)+(u-w+1)(rt+2), compared by exact integer
// cross-multiplication. A strategy untried in this context scores
// 4.0 + (1/2)*E[rescue]: the turn-cost prior is PESSIMISTIC
// (two pseudo-observations at cost 4.0 each, the max observed
// per-turn cost at the S8 decision point), and the untried also
// pay half the rescue estimate. A PW+NEED
// tie for the minimum rescue-aware score at initial selection,
// with both tried in this context (evidence), hedges to ALT. The
// lag prior (15900) is the COGOPS-DETECTION substrate, unchanged,
// and stays global. The rescue ledger (16680/16684) is global
// across contexts, also unchanged in scope.
//
// DETC region: 15900 lag prior, 15904 retracted lag, 15908 ntev,
//   15912 + tev*20 event ring, tev < 32.
// CTXT region: 17000 + slot*56, 8 slots. Slot layout (14 i32):
//   [sig_nn, sig_rel, then per strategy s=1..4 [uses, wins, cost]].
//   sig_nn==0 marks a free slot. 16648 last chosen; 16650
//   turn-cost accumulator; 16656 + e*4 outcome mask per outcome
//   entry e (per-goal, unchanged); 16680 rescue_total;
//   16684 rescue_count; 16688 rescue_open (transient);
//   16692 rescue_live (transient).
// Event kinds: 0=CMP (p,x=a,y=b,z=eq; z=-1 prior-pair skip),
//   1=HYP (p=pass,x=lag,y=q,z=mask), 3=PRIOR, 4=SET, 5=APPLY,
//   6=RETRACT, 7=NCMP (p=pass,x=need,y=lag,z=eq), 8=STRAT
//   (x=chosen), 9=SWITCH (x=from,y=to).
// No world literals, no goal tags, no need tags, no relation ids
// appear below: every value arrives at runtime through goal records
// or the trajectory. Structural offsets only.
// =====================================================================

// log one detection event into the DET ring (32 slots)
fn det_ev(L:[]u8,kind:i32,p:i32,x:i32,y:i32,z:i32)void {
  let ntev:i32=get32(L,15908);
  if(ntev>31){ return; }
  let b:i32=15912+ntev*20;
  set32(L,b,kind);
  set32(L,b+4,p);
  set32(L,b+8,x);
  set32(L,b+12,y);
  set32(L,b+16,z);
  set32(L,15908,ntev+1);
  return;
}
// log one whole-state comparison; counts toward the turn cost,
// and toward the open rescue observation, if any
fn slog_cmp(L:[]u8,p:i32,a:i32,b:i32,eq:i32)void {
  det_ev(L,0,p,a,b,eq);
  set32(L,16650,get32(L,16650)+1);
  if(get32(L,16688)==1){ set32(L,16692,get32(L,16692)+1); }
  return;
}
// log one per-need comparison; counts toward the turn cost,
// and toward the open rescue observation, if any
fn slog_ncmp(L:[]u8,p:i32,ni:i32,lag:i32,eq:i32)void {
  det_ev(L,7,p,ni,lag,eq);
  set32(L,16650,get32(L,16650)+1);
  if(get32(L,16688)==1){ set32(L,16692,get32(L,16692)+1); }
  return;
}
// rescue_finalize: close the open rescue observation, if any,
// folding its live comparison count into the learner's global
// rescue ledger (16680 total, 16684 count).
fn rescue_finalize(L:[]u8)void {
  if(get32(L,16688)==1){
    set32(L,16680,get32(L,16680)+get32(L,16692));
    set32(L,16684,get32(L,16684)+1);
    set32(L,16688,0);
  }
  return;
}
fn pow2(n:i32)i32 {
  let r:i32=1;
  let i:i32=0;
  while(i<n){ r=r*2; i=i+1; }
  return r;
}
// per-context strategy tables (CTXT region at 17000): 8 slots x
// 56 bytes. Slot layout: [sig_nn, sig_rel, then per strategy
// s=1..4 [uses, wins, cost]]. A slot with sig_nn==0 is free.
// The signature (nneeds, need_f(G,1,0)) is computed by the learner
// from the goal record at structural positions; no literals.
// ctx_slot_for: linear scan for a matching slot, else claim the
// first free slot and zero its 12 table cells. The pool-full
// fallback (slot 0) is unreachable in this battery (5 contexts,
// 8 slots).
fn ctx_slot_for(L:[]u8,nn:i32,rel:i32)i32 {
  let s:i32=0;
  while(s<8){
    let b:i32=17000+s*56;
    if(get32(L,b)==nn){
      if(get32(L,b+4)==rel){ return s; }
    }
    s=s+1;
  }
  let t:i32=0;
  while(t<8){
    let b2:i32=17000+t*56;
    if(get32(L,b2)==0){
      set32(L,b2,nn);
      set32(L,b2+4,rel);
      let k:i32=0;
      while(k<12){
        set32(L,b2+8+k*4,0);
        k=k+1;
      }
      return t;
    }
    t=t+1;
  }
  return 0;
}
// ctx_of_goal: the learner-computed context slot for a goal.
fn ctx_of_goal(L:[]u8,G:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let rel:i32=0;
  if(nn>=2){ rel=need_f(G,1,0); }
  return ctx_slot_for(L,nn,rel);
}
fn cx_base(slot:i32)i32 { return 17000+slot*56+8; }
fn cx_uses(L:[]u8,slot:i32,s:i32)i32 { return get32(L,cx_base(slot)+(s-1)*12); }
fn cx_wins(L:[]u8,slot:i32,s:i32)i32 { return get32(L,cx_base(slot)+(s-1)*12+4); }
fn cx_cost(L:[]u8,slot:i32,s:i32)i32 { return get32(L,cx_base(slot)+(s-1)*12+8); }
fn cx_rec(L:[]u8,slot:i32,s:i32,win:i32,cost:i32)void {
  let b:i32=cx_base(slot)+(s-1)*12;
  set32(L,b,get32(L,b)+1);
  if(win==1){ set32(L,b+4,get32(L,b+4)+1); }
  set32(L,b+8,get32(L,b+8)+cost);
  return;
}
fn st_mask_set(L:[]u8,e:i32,mask:i32)void {
  set32(L,16656+e*4,mask);
  return;
}
fn st_mask_get(L:[]u8,e:i32)i32 { return get32(L,16656+e*4); }
// strat_sel: best strategy by RESCUE-AWARE EXPECTED COST within
// the current context's table:
//   score_s = E[turn_s] + P(fail_s) * E[rescue].
// E[turn_s]=(c+8)/(u+2) is the learner's pessimistic-prior mean
// comparisons per turn (two pseudo-observations at cost 4.0); P(fail_s)=(f+1)/(u+2) with f=u-w is the
// Laplace failure rate from the learner's own uses/wins;
// E[rescue]=(rt+2)/(rc+2) is the learner's global smoothed mean
// rescue-loop cost (rt = total post-failure comparisons observed,
// rc = rescue loops observed; cells 16680/16684). Unlike the
// turn-level expected cost, P(success) does NOT cancel: the
// failure probability re-enters through the rescue term, so a
// strategy that fails often pays for the rescue loop its failure
// triggers. Algebra:
//   score_s = [(c+8)(rc+2) + (f+1)(rt+2)] / [(u+2)(rc+2)];
// the (rc+2) denominator factor is common to all strategies, so
// the argmin compares N_s/(u_s+2) with
// N_s = (c+8)(rc+2) + (f+1)(rt+2), by exact integer
// cross-multiplication (N_a*(u_b+2) < N_b*(u_a+2)). A strategy
// untried in this context scores 4.0 + (1/2)*E[rescue]: the
// turn-cost prior is pessimistic, and the untried also
// pay half the rescue estimate. Select the MINIMUM. Tie-break:
// lower strategy id. tried is a bitmask with bit (1<<s) for tried
// strategies (episode-global). Returns 0 when every strategy was
// tried. At initial selection (tried==0), a tie for the minimum
// rescue-aware score shared by strategies 1 and 3 tried IN THIS
// CONTEXT (exact cross-multiplication equality on the N_s/(u_s+2)
// terms; c1>0 and c3>0 require in-context evidence, so a fresh
// context keeps the PW default) selects 4 (the alternation
// hedge). All comparisons are exact integer cross-multiplications;
// no division, no float.
fn strat_sel(L:[]u8,tried:i32,slot:i32)i32 {
  let rt:i32=get32(L,16680);
  let rc:i32=get32(L,16684);
  let ra:i32=rt+2;
  let rb:i32=rc+2;
  let best:i32=0;
  let bu:i32=0;
  let bn:i32=0;
  let s:i32=1;
  while(s<5){
    let b2:i32=pow2(s);
    let q:i32=tried/b2;
    let ist:i32=q-(q/2)*2;
    if(ist==0){
      let u:i32=cx_uses(L,slot,s);
      let w:i32=cx_wins(L,slot,s);
      let c:i32=cx_cost(L,slot,s);
      let f:i32=u-w;
      let nsc:i32=(c+8)*rb+(f+1)*ra;
      let better:i32=0;
      if(best==0){ better=1; }
      if(best!=0){
        if(nsc*(bu+2)<bn*(u+2)){ better=1; }
      }
      if(better==1){ best=s; bu=u; bn=nsc; }
    }
    s=s+1;
  }
  if(tried==0){
    if(best!=0){
      let u1:i32=cx_uses(L,slot,1);
      let w1:i32=cx_wins(L,slot,1);
      let c1:i32=cx_cost(L,slot,1);
      let u3:i32=cx_uses(L,slot,3);
      let w3:i32=cx_wins(L,slot,3);
      let c3:i32=cx_cost(L,slot,3);
      // COGOPS-HEDGE-FREQUENCY instrumentation (log-only): gate
      // record at every initial selection; best/c1/c3 carried in
      // the event fields. Behavior-neutral (K5 verifies).
      det_ev(L,11,0,best,c1,c3);
      let n1:i32=(c1+8)*rb+(u1-w1+1)*ra;
      let n3:i32=(c3+8)*rb+(u3-w3+1)*ra;
      let r1:i32=0;
      let r3:i32=0;
      if(c1>0){
        if(c3>0){
          if(n1*(bu+2)==bn*(u1+2)){ r1=1; }
          if(n3*(bu+2)==bn*(u3+2)){ r3=1; }
        }
      }
      if(r1==1){
        // COGOPS-HEDGE-FREQUENCY instrumentation (log-only):
        // the hedge fires; record the exact-tie residuals
        // (dt1, dt3; both 0 on a genuine tie) and the evidence
        // product ev=c1*1000+c3 before re-promoting ALT.
        if(r3==1){ det_ev(L,10,best,n1*(bu+2)-bn*(u1+2),n3*(bu+2)-bn*(u3+2),c1*1000+c3); best=4; }
      }
      // COGOPS-LEADERSHIP-TRANSITION instrumentation (log-only):
      // tie mask over in-context-tried strategies at initial
      // selection: bit (1<<s) set when strategy s (uses>0 in
      // this context) exactly ties the argmin rescue-aware
      // score (same cross-multiplication as the hedge gate).
      // Behavior-neutral: log only, best unchanged.
      let tm:i32=0;
      let ts:i32=1;
      while(ts<5){
        let uu:i32=cx_uses(L,slot,ts);
        if(uu>0){
          let nns:i32=(cx_cost(L,slot,ts)+8)*rb+(uu-cx_wins(L,slot,ts)+1)*ra;
          if(nns*(bu+2)==bn*(uu+2)){ tm=tm+pow2(ts); }
        }
        ts=ts+1;
      }
      det_ev(L,12,best,tm,rt,rc);
    }
  }
  return best;
}
// pw_try: one pairwise proposal (pass,b) at lag lagp, whole-state
// comparison. Returns 0 (nothing), 1 (hypothesis verified),
// 3 (quiescence: lag 1 is a fixpoint, not an oscillation).
fn pw_try(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,b:i32,lagp:i32)i32 {
  let retlag:i32=get32(L,15904);
  if(retlag!=0){
    if(lagp==retlag){ return 0; }
  }
  let eq:i32=traj_state_eq(L,pass,b,nn);
  slog_cmp(L,pass,pass,b,eq);
  if(eq==0){ return 0; }
  if(lagp==1){ return 3; }
  let mask:i32=pow2(nn)-1;
  det_ev(L,1,pass,lagp,b,mask);
  osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
  traj_log(L,OUTS,nn,pass+1);
  let ok:i32=traj_state_eq(L,pass+1,b+1,nn);
  if(ok==1){
    let ee:i32=outc_store(L,gt,lagp,b,nn,0);
    set32(L,15900,lagp);
    det_ev(L,4,0,lagp,0,0);
    st_mask_set(L,ee,mask);
    set32(R,0,1);
    set32(R,4,pass+2);
    set32(R,8,lagp);
    set32(R,12,b);
    set32(R,16,lagp);
    set32(R,20,0);
    set32(R,24,ee);
    return 1;
  }
  det_ev(L,6,pass+1,lagp,0,0);
  set32(L,15904,lagp);
  return 0;
}
// pw_propose: the PW-form proposal round for one pass: the prior
// pair first (the learner-state prior decides the first
// comparison), then recency order. Returns 0, 1, or 3.
fn pw_propose(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,prior:i32)i32 {
  if(prior!=0){
    let b0:i32=pass-prior;
    if(b0<0){ slog_cmp(L,pass,pass,b0,-1); }
    if(b0>=0){
      let r0:i32=pw_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,b0,prior);
      if(r0!=0){ return r0; }
    }
  }
  let bi:i32=1;
  let out:i32=0;
  while(bi<4){
    if(out==0){
      let b:i32=pass-bi;
      let dup:i32=0;
      if(prior!=0){ if(b==pass-prior){ dup=1; } }
      let go:i32=0;
      if(b>=0){ if(dup==0){ go=1; } }
      if(go==1){
        out=pw_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,b,bi);
      }
    }
    bi=bi+1;
  }
  return out;
}
// who_try: one lag-direct whole-state proposal at (pass,pass-lag).
// Returns 0 (nothing) or 1 (hypothesis verified).
fn who_try(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,lag:i32)i32 {
  let retlag:i32=get32(L,15904);
  if(retlag!=0){
    if(lag==retlag){ return 0; }
  }
  let b:i32=pass-lag;
  let eq:i32=traj_state_eq(L,pass,b,nn);
  slog_cmp(L,pass,pass,b,eq);
  if(eq==0){ return 0; }
  let mask:i32=pow2(nn)-1;
  det_ev(L,1,pass,lag,b,mask);
  osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
  traj_log(L,OUTS,nn,pass+1);
  let ok:i32=traj_state_eq(L,pass+1,b+1,nn);
  if(ok==1){
    let ee:i32=outc_store(L,gt,lag,b,nn,0);
    set32(L,15900,lag);
    det_ev(L,4,0,lag,0,0);
    st_mask_set(L,ee,mask);
    set32(R,0,1);
    set32(R,4,pass+2);
    set32(R,8,lag);
    set32(R,12,b);
    set32(R,16,lag);
    set32(R,20,0);
    set32(R,24,ee);
    return 1;
  }
  det_ev(L,6,pass+1,lag,0,0);
  set32(L,15904,lag);
  return 0;
}
// who_turn: the WHOLE-form turn for one pass: lags [prior,2,3]
// dup-suppressed (lag 1 never proposed). Returns 0 or 1.
fn who_turn(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,prior:i32)i32 {
  let out:i32=0;
  if(prior!=0){
    let b0:i32=pass-prior;
    if(b0>=0){
      out=who_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
    }
  }
  let d:i32=2;
  while(d<4){
    if(out==0){
      let dup:i32=0;
      if(prior!=0){ if(d==prior){ dup=1; } }
      let b:i32=pass-d;
      let go:i32=0;
      if(b>=0){ if(dup==0){ go=1; } }
      if(go==1){
        out=who_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,d);
      }
    }
    d=d+1;
  }
  return out;
}
// need_try: one per-need lag proposal at (pass,pass-lag). Builds the
// match set M over needs; hypothesizes iff M is non-empty and
// non-trivial (some need in M changes between pass-1 and pass,
// so the constant carrier alone never forms a hypothesis).
// Returns 0 (nothing) or 1 (hypothesis verified).
fn need_try(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,lag:i32)i32 {
  let retlag:i32=get32(L,15904);
  if(retlag!=0){
    if(lag==retlag){ return 0; }
  }
  let b:i32=pass-lag;
  let mask:i32=0;
  let ni:i32=0;
  while(ni<nn){
    let eq:i32=traj_need_eq(L,pass,b,ni);
    slog_ncmp(L,pass,ni,lag,eq);
    if(eq==1){ mask=mask+pow2(ni); }
    ni=ni+1;
  }
  if(mask==0){ return 0; }
  let nt:i32=0;
  let nj:i32=0;
  while(nj<nn){
    let bit:i32=pow2(nj);
    let qq:i32=mask/bit;
    let inset:i32=qq-(qq/2)*2;
    if(inset==1){
      let ch:i32=traj_need_eq(L,pass,pass-1,nj);
      if(ch==0){ nt=1; }
    }
    nj=nj+1;
  }
  if(nt==0){ return 0; }
  det_ev(L,1,pass,lag,b,mask);
  osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
  traj_log(L,OUTS,nn,pass+1);
  let okk:i32=1;
  let nk:i32=0;
  while(nk<nn){
    let bit2:i32=pow2(nk);
    let q3:i32=mask/bit2;
    let inset2:i32=q3-(q3/2)*2;
    if(inset2==1){
      let ceq:i32=traj_need_eq(L,pass+1,b+1,nk);
      if(ceq==0){ okk=0; }
    }
    nk=nk+1;
  }
  if(okk==1){
    let ee:i32=outc_store(L,gt,lag,b,nn,0);
    set32(L,15900,lag);
    det_ev(L,4,0,lag,0,0);
    st_mask_set(L,ee,mask);
    set32(R,0,1);
    set32(R,4,pass+2);
    set32(R,8,lag);
    set32(R,12,b);
    set32(R,16,lag);
    set32(R,20,0);
    set32(R,24,ee);
    return 1;
  }
  det_ev(L,6,pass+1,lag,0,0);
  set32(L,15904,lag);
  return 0;
}
// need_turn: the NEED-form turn for one pass: lags [prior,2,3]
// dup-suppressed. Returns 0 or 1.
fn need_turn(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,prior:i32)i32 {
  let out:i32=0;
  if(prior!=0){
    let b0:i32=pass-prior;
    if(b0>=0){
      out=need_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
    }
  }
  let d:i32=2;
  while(d<4){
    if(out==0){
      let dup:i32=0;
      if(prior!=0){ if(d==prior){ dup=1; } }
      let b:i32=pass-d;
      let go:i32=0;
      if(b>=0){ if(dup==0){ go=1; } }
      if(go==1){
        out=need_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,d);
      }
    }
    d=d+1;
  }
  return out;
}
// det_handle: learner-owned detection with strategy choice.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a checker invented from this run's trajectory,
// 2 handled by a stored checker from the outcome record
// (mask-aware: only the checker's need subset is compared).
// The researcher-provided recurrence scan is never called.
fn det_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let vbuf:[]u8=z_alloc(32);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  let gt:i32=g_tag(G);
  let pre:i32=plan_find(L,gt);
  let pi:i32=pre;
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
  }
  if(pi<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  let nn:i32=get32(L,13000+pi*56+4);
  let slot:i32=ctx_of_goal(L,G);
  mat_inputs(G,W);
  set32(L,15904,0);
  set32(L,15908,0);
  let e:i32=outc_find(L,gt);
  if(e>=0){
    let mask:i32=st_mask_get(L,e);
    if(mask==0){ mask=pow2(nn)-1; }
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
        traj_log(L,OUTS,nn,mpass);
        let mm:i32=0;
        let mtot:i32=0;
        let jj:i32=0;
        while(jj<nn){
          let bit:i32=pow2(jj);
          let qq:i32=mask/bit;
          let inset:i32=qq-(qq/2)*2;
          if(inset==1){
            mtot=mtot+1;
            let meq:i32=outc_phase_eq(L,e,mpass,jj,mpass);
            if(meq==1){ mm=mm+1; }
            if(meq==0){ okk=0; }
          }
          jj=jj+1;
        }
        det_ev(L,5,mpass,mm,mtot,0);
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  let pass:i32=0;
  while(pass<2){
    osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
    traj_log(L,OUTS,nn,pass);
    pass=pass+1;
  }
  let tried:i32=0;
  let turns:i32=0;
  let live:i32=1;
  let first:i32=1;
  set32(L,16688,0);
  set32(L,16692,0);
  while(live==1){
    if(turns>=6){ live=0; }
    if(live==1){
      let s:i32=strat_sel(L,tried,slot);
      if(s==0){ live=0; }
      if(s!=0){
        if(first==1){
          det_ev(L,8,0,s,0,0);
          det_ev(L,3,0,get32(L,15900),0,0);
          first=0;
        }
        set32(L,16650,0);
        let prior:i32=get32(L,15900);
        let vr:i32=0;
        let nadv:i32=1;
        if(s==1){
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass);
          vr=pw_propose(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
        }
        if(s==2){
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass);
          vr=who_turn(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
        }
        if(s==3){
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass);
          vr=need_turn(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
        }
        if(s==4){
          nadv=2;
          osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
          traj_log(L,OUTS,nn,pass);
          vr=pw_propose(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,prior);
          if(vr==0){
            osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
            traj_log(L,OUTS,nn,pass+1);
            vr=need_turn(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass+1,prior);
          }
        }
        let tc:i32=get32(L,16650);
        if(vr==1){
          rescue_finalize(L);
          cx_rec(L,slot,s,1,tc);
          set32(L,16648,s);
          return 1;
        }
        if(vr==3){ rescue_finalize(L); return 0; }
        cx_rec(L,slot,s,0,tc);
        tried=tried+pow2(s);
        rescue_finalize(L);
        let ns:i32=strat_sel(L,tried,slot);
        if(ns==0){ live=0; }
        if(ns!=0){
          set32(L,16688,1);
          set32(L,16692,0);
          det_ev(L,9,0,s,ns,0);
        }
        pass=pass+nadv;
        turns=turns+1;
      }
    }
  }
  return 0;
}
// c18_main.zag -- driver for the cogops-alternation-world battery.
// c18 = c17 (COGOPS-HEDGEREMOVAL, hedge deleted) with a new
// three-stage detection battery; c18h = the same driver with
// c16's hedge-bearing strat_sel. Rescue-aware expected-cost strategy selection: each
// learner-computed goal context (nneeds, need-1 relation field)
// keeps its own strategy table; strat_sel picks by
//   score_s = E[turn_s] + P(fail_s) * E[rescue]
// argmin within the current context's table, where
// E[turn_s]=(c+2)/(u+2), P(fail_s)=(u-w+1)/(u+2), and
// E[rescue]=(rt+2)/(rc+2) from the learner's global rescue
// ledger. P(success) does NOT cancel: the failure probability
// re-enters through the rescue term. Stages: S1A/S1B (world A
// learning), S2 (world D), S4 (world E), S6L (world C), S6B
// (world F setup + re-specialize), then S_PW (goal 830, world F
// 613-oscillator: context (3,613) cold, PW leads by id and wins
// at lag 2 in 2 CMP), S_NEED (goal 831, world F partial
// oscillation: context (4,613) cold, PW fails, WHOLE fails,
// NEED rescues and wins at pass 4; rescue ledger (6,2)),
// S_TEST (goal 832, world F partial oscillation, fresh tag:
// context (4,613) carries S_NEED, so PW=(1,0,2) and NEED=(1,1,4)
// tie at 56/3 under ledger (6,2) with in-context evidence for
// both; c18h re-promotes ALT via the hedge (chosen=4, wins in
// 6 events, no rescue), c18 keeps PW by id (chosen=1, PW fails,
// WHOLE fails, NEED wins in 8 events with 2 rescue
// observations).
// All dynamic output goes through the single preallocated
// buffer B, flushed once at the end. The summary adds one
// learner-state line: RESCUE total=<rt> count=<rc>.
// Harness file: pattern and goal ids appear here (the c9_main
// precedent); c11_learn.zag carries zero literals.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);

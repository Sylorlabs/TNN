  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE A4 TR-A4"); c=o_nl(B,c);
  mk_goalX(G,903,1);
  c=do_losc(B,c,L,A,K,G,R,"A4",0);
  plan_drop(L,g_tag(G));
  // Block B: (3,613) kind 8 -- REGIME CHANGE to an unwinnable
  // world. All four forms fail every stage; failure-cost
  // asymmetry (WHOLE < PW < NEED < ALT per failure) inverts the
  // score race and dethrones NEED.
  c=o_app(B,c,"STAGE B1 TR-B1"); c=o_nl(B,c);
  mk_goal8(G,910);
  c=do_losc(B,c,L,A,K,G,R,"B1",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B2 TR-B2"); c=o_nl(B,c);
  mk_goal8(G,911);
  c=do_losc(B,c,L,A,K,G,R,"B2",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B3 TR-B3"); c=o_nl(B,c);
  mk_goal8(G,912);
  c=do_losc(B,c,L,A,K,G,R,"B3",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B4 TR-B4"); c=o_nl(B,c);
  mk_goal8(G,913);
  c=do_losc(B,c,L,A,K,G,R,"B4",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B5 TR-B5"); c=o_nl(B,c);
  mk_goal8(G,914);
  c=do_losc(B,c,L,A,K,G,R,"B5",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B6 TR-B6"); c=o_nl(B,c);
  mk_goal8(G,915);
  c=do_losc(B,c,L,A,K,G,R,"B6",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B7 TR-B7"); c=o_nl(B,c);
  mk_goal8(G,916);
  c=do_losc(B,c,L,A,K,G,R,"B7",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B8 TR-B8"); c=o_nl(B,c);
  mk_goal8(G,917);
  c=do_losc(B,c,L,A,K,G,R,"B8",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B9 TR-B9"); c=o_nl(B,c);
  mk_goal8(G,918);
  c=do_losc(B,c,L,A,K,G,R,"B9",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE B10 TR-B10"); c=o_nl(B,c);
  mk_goal8(G,919);
  c=do_losc(B,c,L,A,K,G,R,"B10",0);
  plan_drop(L,g_tag(G));
  // Block C: (3,613) kinds 2,1 -- REGIME RESTORED to
  // NEED-winnable. WHOLE leads at C1 and fails; NEED wins the
  // rescue and retakes the lead mid-block.
  c=o_app(B,c,"STAGE C1 TR-C1"); c=o_nl(B,c);
  mk_goalX(G,920,2);
  c=do_losc(B,c,L,A,K,G,R,"C1",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C2 TR-C2"); c=o_nl(B,c);
  mk_goalX(G,921,1);
  c=do_losc(B,c,L,A,K,G,R,"C2",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C3 TR-C3"); c=o_nl(B,c);
  mk_goalX(G,922,2);
  c=do_losc(B,c,L,A,K,G,R,"C3",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C4 TR-C4"); c=o_nl(B,c);
  mk_goalX(G,923,1);
  c=do_losc(B,c,L,A,K,G,R,"C4",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C5 TR-C5"); c=o_nl(B,c);
  mk_goalX(G,924,2);
  c=do_losc(B,c,L,A,K,G,R,"C5",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C6 TR-C6"); c=o_nl(B,c);
  mk_goalX(G,925,1);
  c=do_losc(B,c,L,A,K,G,R,"C6",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C7 TR-C7"); c=o_nl(B,c);
  mk_goalX(G,926,2);
  c=do_losc(B,c,L,A,K,G,R,"C7",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C8 TR-C8"); c=o_nl(B,c);
  mk_goalX(G,927,1);
  c=do_losc(B,c,L,A,K,G,R,"C8",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C9 TR-C9"); c=o_nl(B,c);
  mk_goalX(G,928,2);
  c=do_losc(B,c,L,A,K,G,R,"C9",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C10 TR-C10"); c=o_nl(B,c);
  mk_goalX(G,929,1);
  c=do_losc(B,c,L,A,K,G,R,"C10",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C11 TR-C11"); c=o_nl(B,c);
  mk_goalX(G,930,2);
  c=do_losc(B,c,L,A,K,G,R,"C11",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE C12 TR-C12"); c=o_nl(B,c);
  mk_goalX(G,931,1);
  c=do_losc(B,c,L,A,K,G,R,"C12",0);
  plan_drop(L,g_tag(G));
  // Block D1: (4,613) kinds 4,3 -- NEED leadership in the
  // 4-need context.
  c=o_app(B,c,"STAGE D1a1 TR-D1A1"); c=o_nl(B,c);
  mk_goalX(G,940,4);
  c=do_losc(B,c,L,A,K,G,R,"D1a1",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D1a2 TR-D1A2"); c=o_nl(B,c);
  mk_goalX(G,941,3);
  c=do_losc(B,c,L,A,K,G,R,"D1a2",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D1a3 TR-D1A3"); c=o_nl(B,c);
  mk_goalX(G,942,4);
  c=do_losc(B,c,L,A,K,G,R,"D1a3",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D1a4 TR-D1A4"); c=o_nl(B,c);
  mk_goalX(G,943,3);
  c=do_losc(B,c,L,A,K,G,R,"D1a4",0);
  plan_drop(L,g_tag(G));
  // Block D2: (4,613) kind 9 -- unwinnable regime in the
  // 4-need context; replicates the Block-B dethroning.
  c=o_app(B,c,"STAGE D2-1 TR-D2-1"); c=o_nl(B,c);
  mk_goal9(G,950);
  c=do_losc(B,c,L,A,K,G,R,"D2-1",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-2 TR-D2-2"); c=o_nl(B,c);
  mk_goal9(G,951);
  c=do_losc(B,c,L,A,K,G,R,"D2-2",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-3 TR-D2-3"); c=o_nl(B,c);
  mk_goal9(G,952);
  c=do_losc(B,c,L,A,K,G,R,"D2-3",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-4 TR-D2-4"); c=o_nl(B,c);
  mk_goal9(G,953);
  c=do_losc(B,c,L,A,K,G,R,"D2-4",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-5 TR-D2-5"); c=o_nl(B,c);
  mk_goal9(G,954);
  c=do_losc(B,c,L,A,K,G,R,"D2-5",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-6 TR-D2-6"); c=o_nl(B,c);
  mk_goal9(G,955);
  c=do_losc(B,c,L,A,K,G,R,"D2-6",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-7 TR-D2-7"); c=o_nl(B,c);
  mk_goal9(G,956);
  c=do_losc(B,c,L,A,K,G,R,"D2-7",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-8 TR-D2-8"); c=o_nl(B,c);
  mk_goal9(G,957);
  c=do_losc(B,c,L,A,K,G,R,"D2-8",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-9 TR-D2-9"); c=o_nl(B,c);
  mk_goal9(G,958);
  c=do_losc(B,c,L,A,K,G,R,"D2-9",0);
  plan_drop(L,g_tag(G));
  c=o_app(B,c,"STAGE D2-10 TR-D2-10"); c=o_nl(B,c);
  mk_goal9(G,959);
  c=do_losc(B,c,L,A,K,G,R,"D2-10",0);
  plan_drop(L,g_tag(G));
  // SUMMARY (same shape as c18: learner-state strategy tables
  // per context plus the global rescue ledger).
  c=o_app(B,c,"SUMMARY-DET agree=");
  c=o_i64(B,c,get32(L,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," prior=");
  c=o_i64(B,c,get32(L,15900) as i64);
  c=o_nl(B,c);
  c=dump_ctx(B,c,L);
  c=o_app(B,c,"RESCUE total=");
  c=o_i64(B,c,get32(L,16680) as i64);
  c=o_app(B,c," count=");
  c=o_i64(B,c,get32(L,16684) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// ===== STATE DYNAMICS DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original main removed).
// Cognition code untouched. One learner W, no reset, unsealed synthetic
// practice subjects only. Snapshots + in-driver deltas, 3/3 runs.

// ---- snapshot machinery (white box, read only) ----
fn sd_zero(buf:[]u8,nwords:i32)void {
  let i:i32=0; while(i<nwords){set32(buf,i*4,0); i=i+1;} return;
}
fn sd_copy(src:[]u8,dst:[]u8,nwords:i32)void {
  let i:i32=0; while(i<nwords){set32(dst,i*4,get32(src,i*4)); i=i+1;} return;
}
// misc words: 0=live nodes 1=live edges 2=superseded self-edges
//             3=h16(trial) 4=h20(node allocs) 5=h24(edge allocs) 6=h28 7=h32
fn sd_snap(W:[]u8,tagc:[]u8,etc:[]u8,misc:[]u8)void {
  sd_zero(tagc,1100); sd_zero(etc,16); sd_zero(misc,8);
  let nn:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      nn=nn+1;
      let t:i32=ng(W,n,0);
      if(t>=0 && t<1100){set32(tagc,t*4,get32(tagc,t*4)+1);}
    }
    n=n+1;
  }
  set32(misc,0,nn);
  let ne:i32=0; let e:i32=0; let sup:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      ne=ne+1;
      let t:i32=eg(W,e,4);
      if(t>=0 && t<16){set32(etc,t*4,get32(etc,t*4)+1);}
      if(t==3 && eg(W,e,0)==eg(W,e,8)){sup=sup+1;}
    }
    e=e+1;
  }
  set32(misc,4,ne); set32(misc,8,sup);
  set32(misc,12,hg(W,16)); set32(misc,16,hg(W,20)); set32(misc,20,hg(W,24));
  set32(misc,24,hg(W,28)); set32(misc,28,hg(W,32));
  return;
}
fn sd_emit_snap(name:[]u8,tagc:[]u8,etc:[]u8,misc:[]u8)void {
  emit("SNAP "); emit(name); emit("\n");
  emit("nodes="); e64(get32(misc,0));
  emit(" edges="); e64(get32(misc,4));
  emit(" sup="); e64(get32(misc,8));
  emit(" h16="); e64(get32(misc,12));
  emit(" nalloc="); e64(get32(misc,16));
  emit(" ealloc="); e64(get32(misc,20));
  emit(" h28="); e64(get32(misc,24));
  emit(" h32="); e64(get32(misc,28)); emit("\n");
  let t:i32=0;
  while(t<1100){
    let c:i32=get32(tagc,t*4);
    if(c!=0){emit("T"); e64(t); emit("="); e64(c); emit(" ");}
    t=t+1;
  }
  emit("\n");
  let k:i32=0;
  while(k<16){
    let c2:i32=get32(etc,k*4);
    if(c2!=0){emit("E"); e64(k); emit("="); e64(c2); emit(" ");}
    k=k+1;
  }
  emit("\n");
  return;
}
fn sd_emit_delta(name:[]u8,tagc:[]u8,ptc:[]u8,etc:[]u8,pec:[]u8,misc:[]u8,pmisc:[]u8)void {
  emit("DELTA "); emit(name);
  emit(" dnodes="); e64(get32(misc,0)-get32(pmisc,0));
  emit(" dedges="); e64(get32(misc,4)-get32(pmisc,4));
  emit(" dsup="); e64(get32(misc,8)-get32(pmisc,8));
  emit(" dnalloc="); e64(get32(misc,16)-get32(pmisc,16));
  emit(" dealloc="); e64(get32(misc,20)-get32(pmisc,20));
  emit(" dh16="); e64(get32(misc,12)-get32(pmisc,12)); emit("\n");
  emit("DT ");
  let t:i32=0;
  while(t<1100){
    let d:i32=get32(tagc,t*4)-get32(ptc,t*4);
    if(d!=0){emit("T"); e64(t); emit("="); e64(d); emit(" ");}
    t=t+1;
  }
  emit("\nDE ");
  let k:i32=0;
  while(k<16){
    let d2:i32=get32(etc,k*4)-get32(pec,k*4);
    if(d2!=0){emit("E"); e64(k); emit("="); e64(d2); emit(" ");}
    k=k+1;
  }
  emit("\n");
  return;
}
fn sd_ckpt(name:[]u8,W:[]u8,tagc:[]u8,etc:[]u8,misc:[]u8,ptc:[]u8,pec:[]u8,pmisc:[]u8)void {
  sd_snap(W,tagc,etc,misc);
  sd_emit_snap(name,tagc,etc,misc);
  sd_emit_delta(name,tagc,ptc,etc,pec,misc,pmisc);
  sd_copy(tagc,ptc,1100); sd_copy(etc,pec,16); sd_copy(misc,pmisc,8);
  return;
}
fn sd_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn sd_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// ---- the lifetime: one learner, no reset ----
fn sd_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let tagc:[]u8=z_alloc(1100*4); let etc:[]u8=z_alloc(16*4); let misc:[]u8=z_alloc(8*4);
  let ptc:[]u8=z_alloc(1100*4); let pec:[]u8=z_alloc(16*4); let pmisc:[]u8=z_alloc(8*4);
  sd_snap(W,ptc,pec,pmisc);
  sd_emit_snap("init",ptc,pec,pmisc);
  let i:i32=0; let a:i32=0;

  // Phase A: teach 30 facts, domain 1. Checkpoint every 10.
  i=0;
  while(i<30){
    ev_teach(W,1000+i,1,i*7+3); i=i+1;
    if(i==10){sd_ckpt("A_t10",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==20){sd_ckpt("A_t20",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==30){sd_ckpt("A_t30",W,tagc,etc,misc,ptc,pec,pmisc);}
  }
  // Phase B: 6 masked queries -> trial construction + MAP promotion.
  i=0;
  while(i<6){
    let s:i32=1000+i*5;
    a=ev_query(W,s,40,-2,0);
    sd_rep("B_masked_ans",a);
    sd_ckpt("B_q",W,tagc,etc,misc,ptc,pec,pmisc);
    i=i+1;
  }
  // Phase B2: 6 unmasked exact queries (should be cheap hits).
  i=0;
  while(i<6){
    let s2:i32=1001+i*5;
    a=ev_query(W,s2,1,(i*5+1)*7+3,0);
    i=i+1;
  }
  sd_ckpt("B_exact",W,tagc,etc,misc,ptc,pec,pmisc);

  // Phase C: teach 20 facts, domain 2. Checkpoint every 10.
  i=0;
  while(i<20){
    ev_teach(W,2000+i,2,i*3+1); i=i+1;
    if(i==10){sd_ckpt("C_t10",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==20){sd_ckpt("C_t20",W,tagc,etc,misc,ptc,pec,pmisc);}
  }
  // Phase D: 4 masked queries on domain 2.
  i=0;
  while(i<4){
    a=ev_query(W,2000+i*5,40,-2,0);
    sd_rep("D_masked_ans",a);
    i=i+1;
  }
  sd_ckpt("D_q",W,tagc,etc,misc,ptc,pec,pmisc);

  // Phase E: revision. Build a chain MAP, contradict a licensing fact.
  ev_teach(W,7001,11,7002); ev_teach(W,7002,12,7003);
  a=ev_query(W,7001,40,7003,0);
  sd_rep("E_promote_ans",a);
  sd_ckpt("E_setup",W,tagc,etc,misc,ptc,pec,pmisc);
  let m0:i32=sd_find_map(W,7001,40);
  sd_rep("E_map_node",m0);
  if(m0>=0){sd_rep("E_map_ans_before",ng(W,m0,28));}
  a=ev_observe(W,7002,12,9999);
  sd_rep("E_observe_rc",a);
  if(m0>=0){sd_rep("E_map_ans_after",ng(W,m0,28));}
  sd_ckpt("E_contra1",W,tagc,etc,misc,ptc,pec,pmisc);
  // Contradict a fact with no dependent MAP: supersede only.
  a=ev_observe(W,2000,2,4242);
  sd_rep("E_observe2_rc",a);
  sd_ckpt("E_contra2",W,tagc,etc,misc,ptc,pec,pmisc);

  // Phase F: stress. 120 teaches, checkpoint every 30.
  i=0;
  while(i<120){
    ev_teach(W,3000+i,3,i); i=i+1;
    if(i==30){sd_ckpt("F_t30",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==60){sd_ckpt("F_t60",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==90){sd_ckpt("F_t90",W,tagc,etc,misc,ptc,pec,pmisc);}
    if(i==120){sd_ckpt("F_t120",W,tagc,etc,misc,ptc,pec,pmisc);}
  }
  // Phase G: retention. Re-query phase A subjects masked.
  i=0;
  while(i<6){
    a=ev_query(W,1000+i*5,40,-2,0);
    sd_rep("G_recall_ans",a);
    i=i+1;
  }
  sd_ckpt("G_recall",W,tagc,etc,misc,ptc,pec,pmisc);

  // Phase H: inquiry. 4 misses -> UNCERTAINTY nodes + guides + acts.
  i=0;
  while(i<4){
    ev_teach(W,9001+i,77,5+i);
    a=ev_query(W,9100+i,77,-2,0);
    sd_rep("H_miss_rc",a);
    ctx_push(W,9100+i);
    a=ev_act(W);
    sd_rep("H_act",a);
    i=i+1;
  }
  sd_ckpt("H_inquiry",W,tagc,etc,misc,ptc,pec,pmisc);

  emit("LIFETIME-DONE\n");
  return 0;
}
fn main()i32 { return sd_main(); }

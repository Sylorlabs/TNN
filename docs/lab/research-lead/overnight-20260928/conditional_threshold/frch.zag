// frecfold_clean.zag: F-RECFOLD clean rerun (K4-clean).
// Frozen Q4 discovery mechanism (L=5f56cc491) on F-RECFOLD family.
// Pure Zag. No Python.
// Prereg: PREREG_CLEAN.md (P-CLEAN). Supersedes v1 frecfold.zag pilot.

// ============ basics ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
fn get32(b:[]u8, off:i32)i32 {
  let a:i32=b[off] as i32;
  let bb:i32=b[off+1] as i32;
  let c:i32=b[off+2] as i32;
  let d:i32=b[off+3] as i32;
  let r1:i32=a | (bb<<8);
  let r2:i32=r1 | (c<<16);
  let r3:i32=r2 | (d<<24);
  return r3;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}
// state offsets: 0 node_count, 4 trace_count, 8 beam_n, 12 ev_n,
// 16 rng_state, 20 lib_n, 24 nterms
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }

// ============ PRNG ============
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 16, ns);
  return ns;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return r % n;
}

// ============ sealed worlds ============
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  let x5:i32=(x>>4)&1;
  let x6:i32=(x>>5)&1;
  if(fam==0){
    let r:i32=x1 & x2;
    return r;
  }
  if(fam==1){
    let r:i32=x1 ^ x2;
    return r;
  }
  if(fam==2){
    let a:i32=x1 & x2;
    let r:i32=a | x5;
    return r;
  }
  if(fam==3){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let r:i32=(a | b) | c;
    return r;
  }
  if(fam==4){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let m:i32=(a | b) | c;
    let r:i32=m ^ x4;
    return r;
  }
  if(fam==5){
    // F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3)
    // D = (x1 & a) | ((x1^1) & b) where a = x2^x3, b = x2&x3
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let r:i32=t1 | t2;
    return r;
  }
  if(fam==6){
    // F-PARCOND-XOR: C' = D XOR X4 (Phase 2 reuse target)
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let r:i32=d ^ x4;
    return r;
  }
  if(fam==7){
    // F-RECFOLD Instance 1 (easy, R1): D = XOR3( AND(X1,X5), AND(X2,X4), AND(X3,X6) )
    // pairing 10: (1,5)(2,4)(3,6), motif=AND, top=XOR3
    let a:i32=x1 & x5;
    let b:i32=x2 & x4;
    let c:i32=x3 & x6;
    let r:i32=a ^ b ^ c;
    return r;
  }
  if(fam==8){
    // F-RECFOLD Instance 2 (medium, R2): D = AND(AND(AND(AND(AND(X5,X4),X6),X1),X3),X2)
    // perm 571: (5,4,6,1,3,2), motif=AND
    let d:i32=x5 & x4;
    d=d & x6;
    d=d & x1;
    d=d & x3;
    let r:i32=d & x2;
    return r;
  }
  if(fam==9){
    // F-RECFOLD Instance 3 (hard, R1): D = XOR3( XOR(X1,X2), XOR(X3,X5), XOR(X4,X6) )
    // pairing 1: (1,2)(3,5)(4,6), motif=XOR, top=XOR3
    let a:i32=x1 ^ x2;
    let b:i32=x3 ^ x5;
    let c:i32=x4 ^ x6;
    let r:i32=a ^ b ^ c;
    return r;
  }
  if(fam==10){
    // F-RECFOLD Instance 1 Phase 2: C' = D XOR X3 (Xj=X3)
    let a:i32=x1 & x5;
    let b:i32=x2 & x4;
    let c:i32=x3 & x6;
    let d:i32=a ^ b ^ c;
    let r:i32=d ^ x3;
    return r;
  }
  if(fam==11){
    // F-RECFOLD Instance 2 Phase 2: C' = D XOR X2 (Xj=X2)
    let d:i32=x5 & x4;
    d=d & x6;
    d=d & x1;
    d=d & x3;
    d=d & x2;
    let r:i32=d ^ x2;
    return r;
  }
  if(fam==12){
    // F-RECFOLD Instance 3 Phase 2: C' = D XOR X5 (Xj=X5)
    let a:i32=x1 ^ x2;
    let b:i32=x3 ^ x5;
    let c:i32=x4 ^ x6;
    let d:i32=a ^ b ^ c;
    let r:i32=d ^ x5;
    return r;
  }
  return 0;
}

// ============ nodes (28 bytes) ============
// ============ nodes (32 bytes; Change A) ============
// offsets 0..24 unchanged; third child c2 at offset 28.
fn ndg(nodes:[]u8, n:i32, off:i32)i32 { return get32(nodes, n*32+off); }
fn nds(nodes:[]u8, n:i32, off:i32, v:i32)void { set32(nodes, n*32+off, v); return; }
fn sig_hash(lo:i32, hi:i32)i32 {
  let h1:i32=hi * 33;
  let h2:i32=lo ^ h1;
  let h:i32=h2 & 16383;
  return h;
}
fn sig_lookup(sigtab:[]u8, nodes:[]u8, lo:i32, hi:i32)i32 {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){ return -1; }
    let n:i32=slot-1;
    let nlo:i32=ndg(nodes, n, 16);
    if(nlo==lo){
      let nhi:i32=ndg(nodes, n, 20);
      if(nhi==hi){ return n; }
    }
    i=i+1;
  }
  return -1;
}
fn sig_insert(sigtab:[]u8, lo:i32, hi:i32, n:i32)void {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){
      set32(sigtab, idx*4, n+1);
      return;
    }
    i=i+1;
  }
  return;
}
fn term_sig(t:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  if(t<6){
    let x:i32=0;
    while(x<64){
      let bit:i32=(x>>t)&1;
      if(bit==1){
        if(x<32){
          let m:i32=1<<x;
          lo=lo | m;
        } else {
          let m:i32=1<<(x-32);
          hi=hi | m;
        }
      }
      x=x+1;
    }
  } else {
    if(t==7){
      lo=-1;
      hi=-1;
    }
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn node_new_term(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32)i32 {
  let sob:[]u8=z_alloc(8);
  term_sig(t, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  nds(nodes, nc, 28, -1);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_libterm(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32, lo:i32, hi:i32)i32 {
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  nds(nodes, nc, 28, -1);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_op(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32, c2:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 16);
  let hi0:i32=ndg(nodes, c0, 20);
  let lo:i32=0;
  let hi:i32=0;
  let oc:i32=0;
  if(op==0){
    let lo1:i32=ndg(nodes, c1, 16);
    let hi1:i32=ndg(nodes, c1, 20);
    lo=lo0 & lo1;
    hi=hi0 & hi1;
    oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
  } else {
    if(op==1){
      let lo1:i32=ndg(nodes, c1, 16);
      let hi1:i32=ndg(nodes, c1, 20);
      lo=lo0 | lo1;
      hi=hi0 | hi1;
      oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
    } else {
      if(op==2){
        lo=lo0 ^ -1;
        hi=hi0 ^ -1;
        oc=1 + ndg(nodes, c0, 24);
      } else {
        if(op==4){
          let loa:i32=ndg(nodes, c1, 16);
          let hia:i32=ndg(nodes, c1, 20);
          let lob:i32=ndg(nodes, c2, 16);
          let hib:i32=ndg(nodes, c2, 20);
          let nlo0:i32=lo0 ^ -1;
          let nhi0:i32=hi0 ^ -1;
          lo=(lo0 & loa) | (nlo0 & lob);
          hi=(hi0 & hia) | (nhi0 & hib);
          // T1: license-cost tax. Tier-1 (kind 0): B=2. Tier-2 (kind 1): B=4.
          let tbase:i32=2;
          if(ndg(nodes, c0, 0)==1){ tbase=4; }
          oc=tbase + ndg(nodes, c0, 24) + ndg(nodes, c1, 24) + ndg(nodes, c2, 24);
        } else {
          let lo1:i32=ndg(nodes, c1, 16);
          let hi1:i32=ndg(nodes, c1, 20);
          lo=lo0 ^ lo1;
          hi=hi0 ^ hi1;
          oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
        }
      }
    }
  }
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, oc);
  nds(nodes, nc, 28, c2);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  let tc:i32=stg(st, 4);
  if(tc<4096){
    set32(trace, tc*24+0, op);
    set32(trace, tc*24+4, c0);
    set32(trace, tc*24+8, c1);
    set32(trace, tc*24+12, nc);
    set32(trace, tc*24+16, stg(st, 12));
    set32(trace, tc*24+20, c2);
    sts(st, 4, tc+1);
  }
  return nc;
}
fn node_pred(nodes:[]u8, n:i32, x:i32)i32 {
  let slo:i32=ndg(nodes, n, 16);
  if(x<32){
    let p:i32=(slo>>x)&1;
    return p;
  }
  let shi:i32=ndg(nodes, n, 20);
  let p:i32=(shi>>(x-32))&1;
  return p;
}

// ============ beam (16 bytes/slot) ============
fn bmg(beam:[]u8, i:i32, off:i32)i32 { return get32(beam, i*16+off); }
fn bms(beam:[]u8, i:i32, off:i32, v:i32)void { set32(beam, i*16+off, v); return; }
// score a single node on evidence; returns score*10000 scale via out param
fn score_node(st:[]u8, nodes:[]u8, n:i32, ev_x:[]u8, ev_y:[]u8, out:[]u8)void {
  let en:i32=stg(st, 12);
  let opc:i32=ndg(nodes, n, 24);
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let p:i32=node_pred(nodes, n, x);
    if(p==y){ c=c+1; }
    e=e+1;
  }
  let sc:i32=0;
  if(en>0){
    let a1:i32=(c*10000)/en;
    let a2:i32=200*opc;
    sc=a1 - a2;
  }
  set32(out, 0, sc);
  set32(out, 4, c);
  set32(out, 8, opc);
  return;
}
fn beam_sort(beam:[]u8, bn:i32)void {
  let i:i32=0;
  while(i<bn){
    let best:i32=i;
    let j:i32=i+1;
    while(j<bn){
      let sj:i32=bmg(beam, j, 4);
      let sb:i32=bmg(beam, best, 4);
      let take:i32=0;
      if(sj>sb){ take=1; }
      else {
        if(sj==sb){
          let oj:i32=bmg(beam, j, 12);
          let ob:i32=bmg(beam, best, 12);
          if(oj<ob){ take=1; }
          else {
            if(oj==ob){
              let nj:i32=bmg(beam, j, 0);
              let nb:i32=bmg(beam, best, 0);
              if(nj<nb){ take=1; }
            }
          }
        }
      }
      if(take==1){ best=j; }
      j=j+1;
    }
    if(best!=i){
      let k:i32=0;
      while(k<4){
        let t:i32=bmg(beam, i, k*4);
        bms(beam, i, k*4, bmg(beam, best, k*4));
        bms(beam, best, k*4, t);
        k=k+1;
      }
    }
    i=i+1;
  }
  return;
}
// ============ Change T2 helpers: pbeam membership and copy =======
// pbeam_has: 1 if node id n appears in the 32 pbeam entries, else 0.
fn pbeam_has(pbeam:[]u8, n:i32)i32 {
  let i:i32=0;
  while(i<32){
    if(get32(pbeam, i*4)==n){ return 1; }
    i=i+1;
  }
  return 0;
}
// copy_beam_ids: copy bn beam node ids to dst, pad remaining with -1.
fn copy_beam_ids(beam:[]u8, dst:[]u8, bn:i32)void {
  let i:i32=0;
  while(i<32){
    if(i<bn){
      set32(dst, i*4, bmg(beam, i, 0));
    } else {
      set32(dst, i*4, -1);
    }
    i=i+1;
  }
  return;
}
// ============ Change T2: stability-gated license + tiered combiner ====
// Tier-1 (terminal/library conditions, node kind 0): exact slice agreement,
// min slice min(4, en/8) rows (threshold calibration), no persistence,
// cap 64, enumerated first.
// Tier-2 (round-built conditions, node kind 1): exact slice agreement,
// min slice max(4, en/8), persistence (c, A, B all in pbeam), cap 64,
// enumerated after Tier-1. Total cap 128 per invocation.
// pbeam: 32 node ids from the previous round's input beam (S_{r-2}).
// Tier classification is structural (node kind), never identity.
fn beam_cond_combine(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, pbeam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tn:i32, ev_x:[]u8, ev_y:[]u8, crnd:i32, hitbuf:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  let rows1:[]u8=z_alloc(32*4);
  let rows0:[]u8=z_alloc(32*4);
  let ag1:[]u8=z_alloc(32*32*4);
  let ag0:[]u8=z_alloc(32*32*4);
  let ck:[]u8=z_alloc(32*4);
  let ci:i32=0;
  while(ci<bn){
    let cn:i32=bmg(beam, ci, 0);
    set32(ck, ci*4, ndg(nodes, cn, 0));
    let r1:i32=0;
    let r0:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      if(node_pred(nodes, cn, x)==1){ r1=r1+1; } else { r0=r0+1; }
      e=e+1;
    }
    set32(rows1, ci*4, r1);
    set32(rows0, ci*4, r0);
    let j:i32=0;
    while(j<bn){
      let mn:i32=bmg(beam, j, 0);
      let a1:i32=0;
      let a0:i32=0;
      let e2:i32=0;
      while(e2<en){
        let x2:i32=get32(ev_x, e2*4);
        let y2:i32=get32(ev_y, e2*4);
        if(node_pred(nodes, mn, x2)==y2){
          if(node_pred(nodes, cn, x2)==1){ a1=a1+1; } else { a0=a0+1; }
        }
        e2=e2+1;
      }
      set32(ag1, (ci*32+j)*4, a1);
      set32(ag0, (ci*32+j)*4, a0);
      j=j+1;
    }
    ci=ci+1;
  }
  let nt:i32=tn;
  // Tier-1 pass: terminal/library conditions, min slice min(4, en/8),
  // cap 64.
  // Threshold calibration: Tier-1 min slice = min(4, en/8).
  let minsl1:i32=en/8;
  if(minsl1>4){ minsl1=4; }
  let cap1:i32=0;
  ci=0;
  while(ci<bn){
    if(cap1>=64){ break; }
    if(get32(ck, ci*4)==0){
      let r1c:i32=get32(rows1, ci*4);
      let r0c:i32=get32(rows0, ci*4);
      if(r1c>=minsl1){
        if(r0c>=minsl1){
          let cn2:i32=bmg(beam, ci, 0);
          let ai:i32=0;
          while(ai<bn){
            if(cap1>=64){ break; }
            if(get32(ag1, (ci*32+ai)*4)==r1c){
              let an:i32=bmg(beam, ai, 0);
              let bi:i32=0;
              while(bi<bn){
                if(cap1>=64){ break; }
                if(get32(ag0, (ci*32+bi)*4)==r0c){
                  let bn2:i32=bmg(beam, bi, 0);
                  let n2:i32=node_new_op(st, nodes, sigtab, trace, 4, cn2, an, bn2);
                  if(n2>=0){
                    if(get32(hitbuf, 0)<0){
                      if(ndg(nodes, n2, 16)==get32(hitbuf, 4)){
                        if(ndg(nodes, n2, 20)==get32(hitbuf, 8)){
                          set32(hitbuf, 0, crnd);
                        }
                      }
                    }
                    if(seen[n2]==0){
                      seen[n2]=1;
                      set32(tmp, nt*4, n2);
                      nt=nt+1;
                    }
                  }
                  cap1=cap1+1;
                }
                bi=bi+1;
              }
            }
            ai=ai+1;
          }
        }
      }
    }
    ci=ci+1;
  }
  // Tier-2 pass: round-built conditions, min slice max(4, en/8),
  // persistence gate (c, A, B all in pbeam), cap 64.
  let minsl:i32=en/8;
  if(minsl<4){ minsl=4; }
  let cap2:i32=0;
  ci=0;
  while(ci<bn){
    if(cap2>=64){ break; }
    if(get32(ck, ci*4)==1){
      let r1c:i32=get32(rows1, ci*4);
      let r0c:i32=get32(rows0, ci*4);
      if(r1c>=minsl){
        if(r0c>=minsl){
          let cn2:i32=bmg(beam, ci, 0);
          if(pbeam_has(pbeam, cn2)==1){
            let ai:i32=0;
            while(ai<bn){
              if(cap2>=64){ break; }
              if(get32(ag1, (ci*32+ai)*4)==r1c){
                let an:i32=bmg(beam, ai, 0);
                if(pbeam_has(pbeam, an)==1){
                  let bi:i32=0;
                  while(bi<bn){
                    if(cap2>=64){ break; }
                    if(get32(ag0, (ci*32+bi)*4)==r0c){
                      let bn2:i32=bmg(beam, bi, 0);
                      if(pbeam_has(pbeam, bn2)==1){
                        let n2:i32=node_new_op(st, nodes, sigtab, trace, 4, cn2, an, bn2);
                        if(n2>=0){
                          if(get32(hitbuf, 0)<0){
                            if(ndg(nodes, n2, 16)==get32(hitbuf, 4)){
                              if(ndg(nodes, n2, 20)==get32(hitbuf, 8)){
                                set32(hitbuf, 0, crnd);
                              }
                            }
                          }
                          if(seen[n2]==0){
                            seen[n2]=1;
                            set32(tmp, nt*4, n2);
                            nt=nt+1;
                          }
                        }
                        cap2=cap2+1;
                      }
                    }
                    bi=bi+1;
                  }
                }
              }
              ai=ai+1;
            }
          }
        }
      }
    }
    ci=ci+1;
  }
  return nt;
}
// Extend beam by one generation. tmp: 3392*4 cand buffer. tsc: 3392*12 score buffer.
// Change B: after the frozen pair-combination phase, one conditional-combiner
// phase runs; scoring and selection are untouched. Control builds use a
// zeroed dummy hitbuf so no hit recording occurs.
fn beam_extend(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, pbeam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8)void {
  let bn:i32=stg(st, 8);
  let si:i32=0;
  while(si<8192){ seen[si]=0; si=si+1; }
  let tn:i32=0;
  let i:i32=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    if(seen[n]==0){
      seen[n]=1;
      set32(tmp, tn*4, n);
      tn=tn+1;
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let n2:i32=node_new_op(st, nodes, sigtab, trace, 2, n, -1, -1);
    if(n2>=0){
      if(seen[n2]==0){
        seen[n2]=1;
        set32(tmp, tn*4, n2);
        tn=tn+1;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let j:i32=0;
    while(j<bn){
      let m:i32=bmg(beam, j, 0);
      let op:i32=0;
      while(op<4){
        if(op!=2){
          let n2:i32=node_new_op(st, nodes, sigtab, trace, op, n, m, -1);
          if(n2>=0){
            if(seen[n2]==0){
              seen[n2]=1;
              set32(tmp, tn*4, n2);
              tn=tn+1;
            }
          }
        }
        op=op+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  // Change B: conditional-combiner phase with dummy hitbuf (no hit recording).
  let hitbuf:[]u8=z_alloc(12);
  tn=beam_cond_combine(st, nodes, sigtab, beam, pbeam, trace, seen, tmp, tn, ev_x, ev_y, 0, hitbuf);
  // score all tmp candidates
  let sout:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<tn){
    let n:i32=get32(tmp, k*4);
    score_node(st, nodes, n, ev_x, ev_y, sout);
    set32(tsc, k*12+0, get32(sout, 0));
    set32(tsc, k*12+4, get32(sout, 4));
    set32(tsc, k*12+8, get32(sout, 8));
    k=k+1;
  }
  // select top 32 by (score desc, opc asc, node asc)
  let nb:i32=0;
  let picked:[]u8=z_alloc(3392);
  let pi:i32=0;
  while(pi<tn){ picked[pi]=0; pi=pi+1; }
  let r:i32=0;
  while(r<32){
    let bestk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bestk<0){ bestk=k; }
        else {
          let sk:i32=get32(tsc, k*12+0);
          let sb:i32=get32(tsc, bestk*12+0);
          let take:i32=0;
          if(sk>sb){ take=1; }
          else {
            if(sk==sb){
              let ok:i32=get32(tsc, k*12+8);
              let ob:i32=get32(tsc, bestk*12+8);
              if(ok<ob){ take=1; }
              else {
                if(ok==ob){
                  let nk:i32=get32(tmp, k*4);
                  let nbb:i32=get32(tmp, bestk*4);
                  if(nk<nbb){ take=1; }
                }
              }
            }
          }
          if(take==1){ bestk=k; }
        }
      }
      k=k+1;
    }
    if(bestk<0){ break; }
    picked[bestk]=1;
    let bn2:i32=get32(tmp, bestk*4);
    bms(beam, nb, 0, bn2);
    bms(beam, nb, 4, get32(tsc, bestk*12+0));
    bms(beam, nb, 8, get32(tsc, bestk*12+4));
    bms(beam, nb, 12, get32(tsc, bestk*12+8));
    nb=nb+1;
    r=r+1;
    if(nb>=tn){ break; }
  }
  sts(st, 8, nb);
  return;
}
// ============ Change T2: round wrapper managing pbeam ============
fn beam_extend_round(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, pbeam:[]u8, psave:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8)void {
  let bn:i32=stg(st, 8);
  copy_beam_ids(beam, psave, bn);
  beam_extend(st, nodes, sigtab, beam, pbeam, trace, seen, tmp, tsc, ev_x, ev_y);
  let i:i32=0;
  while(i<32){
    set32(pbeam, i*4, get32(psave, i*4));
    i=i+1;
  }
  return;
}

// ============ evidence ============
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    used[x]=1;
    i=i+1;
  }
  sts(st, 12, 8);
  return;
}
fn abs_i(v:i32)i32 {
  if(v<0){ return -v; }
  return v;
}
fn select_iv(st:[]u8, nodes:[]u8, beam:[]u8, used:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let topk:i32=8;
  if(bn<8){ topk=bn; }
  let best_x:i32=-1;
  let best_d:i32=-1;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){
      let c1:i32=0;
      let k:i32=0;
      while(k<topk){
        let n:i32=bmg(beam, k, 0);
        let p:i32=node_pred(nodes, n, x);
        if(p==1){ c1=c1+1; }
        k=k+1;
      }
      let av:i32=abs_i(2*c1 - 8);
      let d:i32=8 - av;
      if(d>best_d){
        best_d=d;
        best_x=x;
      }
    }
    x=x+1;
  }
  return best_x;
}
fn do_iv(st:[]u8, fam:i32, x:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let y:i32=sealed(fam, x);
  let en:i32=stg(st, 12);
  set32(ev_x, en*4, x);
  set32(ev_y, en*4, y);
  used[x]=1;
  sts(st, 12, en+1);
  return;
}
fn true_correct(fam:i32, nodes:[]u8, n:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    let p:i32=node_pred(nodes, n, x);
    let y:i32=sealed(fam, x);
    if(p==y){ c=c+1; }
    x=x+1;
  }
  return c;
}
fn bobs_ev_correct(st:[]u8, ev_x:[]u8, ev_y:[]u8)i32 {
  let en:i32=stg(st, 12);
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=(x>>i)&1;
      if(p==y){ c=c+1; }
      e=e+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}
fn bobs_true_correct(fam:i32)i32 {
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let x:i32=0;
    while(x<64){
      let p:i32=(x>>i)&1;
      let y:i32=sealed(fam, x);
      if(p==y){ c=c+1; }
      x=x+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}

// ============ reset helpers ============
fn clear_sigtab(sigtab:[]u8)void {
  let i:i32=0;
  while(i<16384){ set32(sigtab, i*4, 0); i=i+1; }
  return;
}
fn clear_used(used:[]u8)void {
  let i:i32=0;
  while(i<64){ used[i]=0; i=i+1; }
  return;
}

// ============ Phase 1 ============
// Returns kept node idx, or -1. Reports via emit.
fn phase1(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, nterms:i32, tag:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  // init beam with terminals
  let t:i32=0;
  while(t<nterms){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, nterms);
  let pbeam:[]u8=z_alloc(32*4);
  let psave:[]u8=z_alloc(32*4);
  copy_beam_ids(beam, pbeam, nterms);
  // passive
  passive(st, fam, ev_x, ev_y, used);
  // 24 rounds: extend, score, sort, select intervention
  let r:i32=0;
  while(r<24){
    beam_extend_round(st, nodes, sigtab, beam, pbeam, psave, trace, seen, tmp, tsc, ev_x, ev_y);
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    r=r+1;
  }
  // final extend+score+sort on full evidence
  beam_extend_round(st, nodes, sigtab, beam, pbeam, psave, trace, seen, tmp, tsc, ev_x, ev_y);
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  // BEST = beam[0]
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let obs_c:i32=bobs_ev_correct(st, ev_x, ev_y);
  // keep checks
  let keep:i32=1;
  // acc >= obs + 0.15  <=>  best_c*100 >= obs_c*100 + 15*en
  let lhs:i32=best_c*100;
  let rhs:i32=obs_c*100 + 15*en;
  if(lhs<rhs){ keep=0; }
  if(best_o>7){ keep=0; }
  // minimality: no other within 0.02 acc with fewer ops
  let j:i32=1;
  while(j<bn){
    let cj:i32=bmg(beam, j, 8);
    let oj:i32=bmg(beam, j, 12);
    // cj*100 >= best_c*100 - 2*en  AND  oj < best_o  => fail
    let jl:i32=cj*100;
    let jr:i32=best_c*100 - 2*en;
    if(jl>=jr){
      if(oj<best_o){ keep=0; }
    }
    j=j+1;
  }
  // report
  emit(tag); emit(" BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" obs_correct="); e64(obs_c);
  emit(" opc="); e64(best_o);
  emit(" keep="); e64(keep); emit("\n");
  emit(tag); emit(" TRUE correct="); e64(true_correct(fam, nodes, best_n)); emit("/64");
  emit(" bobs_true="); e64(bobs_true_correct(fam)); emit("/64\n");
  emit(tag); emit(" trace_events="); e64(stg(st, 4)); emit(" nodes="); e64(stg(st, 0)); emit("\n");
  if(keep==1){ return best_n; }
  return -1;
}

// ============ Phase 2 ============
// lib_lo, lib_hi: sig of kept D1. use_lib: 1 = reuse, 0 = scratch.
// Returns interventions to reach true acc >= 61/64, or 24.
fn phase2(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, use_lib:i32, lib_lo:i32, lib_hi:i32, tag:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  let nterms:i32=8;
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  if(use_lib==1){
    let ln:i32=node_new_libterm(st, nodes, sigtab, 8, lib_lo, lib_hi);
    bms(beam, 8, 0, ln);
    bms(beam, 8, 4, 0);
    bms(beam, 8, 8, 0);
    bms(beam, 8, 12, 0);
    nterms=9;
  }
  sts(st, 8, nterms);
  let pbeam:[]u8=z_alloc(32*4);
  let psave:[]u8=z_alloc(32*4);
  copy_beam_ids(beam, pbeam, nterms);
  sts(st, 24, nterms);
  passive(st, fam, ev_x, ev_y, used);
  let hit_iv:i32=24;
  let hit:i32=0;
  // check after passive (0 interventions)
  beam_extend_round(st, nodes, sigtab, beam, pbeam, psave, trace, seen, tmp, tsc, ev_x, ev_y);
  let b0:i32=bmg(beam, 0, 0);
  let tc0:i32=true_correct(fam, nodes, b0);
  if(tc0>=61){ hit=1; hit_iv=0; }
  let r:i32=0;
  while(r<24){
    if(hit==1){ break; }
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    beam_extend_round(st, nodes, sigtab, beam, pbeam, psave, trace, seen, tmp, tsc, ev_x, ev_y);
    let bn2:i32=bmg(beam, 0, 0);
    let tc:i32=true_correct(fam, nodes, bn2);
    if(tc>=61){
      hit=1;
      hit_iv=r+1;
    }
    r=r+1;
  }
  emit(tag); emit(" hit_iv="); e64(hit_iv);
  emit(" final_true="); e64(true_correct(fam, nodes, bmg(beam, 0, 0))); emit("/64\n");
  return hit_iv;
}

// ============ main: F-RECFOLD clean battery ============
// 3 instances x 5 seeds (11,22,33,44,55). Phase 1 discovery only.
// Instance 1: fam 7. Instance 2: fam 8. Instance 3: fam 9.
fn main()void {
  emit("F-RECFOLD-CLEAN\n");
  let st:[]u8=z_alloc(32);
  let nodes:[]u8=z_alloc(8192*32);
  let sigtab:[]u8=z_alloc(16384*4);
  let beam:[]u8=z_alloc(32*16);
  let trace:[]u8=z_alloc(4096*24);
  let seen:[]u8=z_alloc(8192);
  let tmp:[]u8=z_alloc(3392*4);
  let tsc:[]u8=z_alloc(3392*12);
  let ev_x:[]u8=z_alloc(32*4);
  let ev_y:[]u8=z_alloc(32*4);
  let used:[]u8=z_alloc(64);
  emit("INSTANCE 1\n");
  sts(st, 16, 11);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 8, "P1-I1-S11");
  sts(st, 16, 22);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 8, "P1-I1-S22");
  sts(st, 16, 33);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 8, "P1-I1-S33");
  sts(st, 16, 44);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 8, "P1-I1-S44");
  sts(st, 16, 55);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 8, "P1-I1-S55");
  emit("INSTANCE 2\n");
  sts(st, 16, 11);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 8, "P1-I2-S11");
  sts(st, 16, 22);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 8, "P1-I2-S22");
  sts(st, 16, 33);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 8, "P1-I2-S33");
  sts(st, 16, 44);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 8, "P1-I2-S44");
  sts(st, 16, 55);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 8, "P1-I2-S55");
  emit("INSTANCE 3\n");
  sts(st, 16, 11);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 9, 8, "P1-I3-S11");
  sts(st, 16, 22);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 9, 8, "P1-I3-S22");
  sts(st, 16, 33);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 9, 8, "P1-I3-S33");
  sts(st, 16, 44);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 9, 8, "P1-I3-S44");
  sts(st, 16, 55);
  phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 9, 8, "P1-I3-S55");
  emit("DONE\n");
  return;
}

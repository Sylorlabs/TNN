// s9.zag: S9 fact eviction / GC for the shared substrate.
// Substrate core copied from substrate_syn2/syn2.zag (same workspace
// layout, string pool, latest-match query semantics). S9 adds:
// per-slot metadata (pin bit, last-hit tick, hit count), semantics
// preserving compaction, and scored eviction. Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ header ============
// 0 magic, 4 nvar, 8 ep_stride, 12 ent_stride, 16 ep_base,
// 20 ent_base, 24 fact_base, 28 str_base, 32 str_cursor,
// 36 ep_count, 40 ent_count, 44 fact_count, 48 seq,
// 52 max_ep, 56 max_ent, 60 max_fact, 64 fact_conflicts, 68 ep_processed,
// 72 evict_count, 76 compact_count, 80 learn_ok, 84 learn_dropped
fn h_nvar(W:[]u8)i32 { return get32(W,4); }
fn h_epstride(W:[]u8)i32 { return get32(W,8); }
fn h_entstride(W:[]u8)i32 { return get32(W,12); }
fn h_epbase(W:[]u8)i32 { return get32(W,16); }
fn h_entbase(W:[]u8)i32 { return get32(W,20); }
fn h_factbase(W:[]u8)i32 { return get32(W,24); }
fn h_strbase(W:[]u8)i32 { return get32(W,28); }
fn h_strcur(W:[]u8)i32 { return get32(W,32); }
fn h_strcur_set(W:[]u8, v:i32)void { set32(W,32,v); return; }
fn h_factcount(W:[]u8)i32 { return get32(W,44); }
fn h_factcount_set(W:[]u8, v:i32)void { set32(W,44,v); return; }
fn h_seq(W:[]u8)i32 { return get32(W,48); }
fn h_seq_set(W:[]u8, v:i32)void { set32(W,48,v); return; }
fn h_maxfact(W:[]u8)i32 { return get32(W,60); }
fn h_conflicts(W:[]u8)i32 { return get32(W,64); }
fn h_conflicts_set(W:[]u8, v:i32)void { set32(W,64,v); return; }
fn h_evict(W:[]u8)i32 { return get32(W,72); }
fn h_evict_set(W:[]u8, v:i32)void { set32(W,72,v); return; }
fn h_compactc(W:[]u8)i32 { return get32(W,76); }
fn h_compactc_set(W:[]u8, v:i32)void { set32(W,76,v); return; }
fn h_learnok(W:[]u8)i32 { return get32(W,80); }
fn h_learnok_set(W:[]u8, v:i32)void { set32(W,80,v); return; }
fn h_learndrop(W:[]u8)i32 { return get32(W,84); }
fn h_learndrop_set(W:[]u8, v:i32)void { set32(W,84,v); return; }

// meta region: one u32 per fact slot, right after the triples.
// bit31 pin, bits16..30 last-hit tick, bits0..15 hit count.
fn h_metabase(W:[]u8)i32 { return h_factbase(W)+h_maxfact(W)*12; }
fn m_get(W:[]u8, s:i32)i32 { return get32(W, h_metabase(W)+s*4); }
fn m_set(W:[]u8, s:i32, v:i32)void { set32(W, h_metabase(W)+s*4, v); return; }
fn m_use(v:i32)i32 { return v & 65535; }
fn m_tick(v:i32)i32 { return (v>>16) & 32767; }
fn m_pin(v:i32)i32 { return (v>>31) & 1; }
fn m_make(pin:i32, tick:i32, use:i32)i32 {
  return (pin<<31)|((tick & 32767)<<16)|(use & 65535);
}

fn sub_init9(W:[]u8, nvar:i32, maxf:i32, wsize:i32)i32 {
  if(nvar<1 || nvar>8){ emit("substrate: nvar out of range\n"); return 0; }
  if(maxf<16 || maxf>4096){ emit("substrate: maxf out of range\n"); return 0; }
  let ep_stride:i32=((5+2*nvar+3)/4)*4;
  let ent_stride:i32=((56+9*nvar+3)/4)*4;
  let ep_base:i32=128;
  let ent_base:i32=ep_base+64*ep_stride;
  let fact_base:i32=ent_base+64*ent_stride;
  let meta_base:i32=fact_base+maxf*12;
  let str_base:i32=meta_base+maxf*4;
  if(str_base+4096>wsize){
    emit("substrate: workspace too small\n");
    return 0;
  }
  set32(W,0,1397057875);
  set32(W,4,nvar);
  set32(W,8,ep_stride);
  set32(W,12,ent_stride);
  set32(W,16,ep_base);
  set32(W,20,ent_base);
  set32(W,24,fact_base);
  set32(W,28,str_base);
  set32(W,32,str_base);
  set32(W,36,0);
  set32(W,40,0);
  set32(W,44,0);
  set32(W,48,0);
  set32(W,52,64);
  set32(W,56,64);
  set32(W,60,maxf);
  set32(W,64,0);
  set32(W,68,0);
  set32(W,72,0);
  set32(W,76,0);
  set32(W,80,0);
  set32(W,84,0);
  return 1;
}

// ============ strings ============
fn sub_str(W:[]u8, s:[]u8)i32 {
  let p:i32=h_strcur(W);
  set32(W,p,s.len);
  let i:i32=0;
  while(i<s.len){ W[p+4+i]=s[i]; i=i+1; }
  h_strcur_set(W,p+4+s.len);
  return p;
}
fn sub_streq(W:[]u8, o1:i32, o2:i32)i32 {
  let l1:i32=get32(W,o1);
  let l2:i32=get32(W,o2);
  if(l1!=l2){return 0;}
  let i:i32=0;
  while(i<l1){
    if(W[o1+4+i]!=W[o2+4+i]){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ fact store (original, for the control) ============
fn sub_fact_learn(W:[]u8, e:[]u8, a:[]u8, v:[]u8)i32 {
  let fc:i32=h_factcount(W);
  if(fc>=h_maxfact(W)){return -1;}
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let vo:i32=sub_str(W,v);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      if(sub_streq(W,get32(W,o+8),vo)==0){
        h_conflicts_set(W,h_conflicts(W)+1);
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  h_factcount_set(W,fc+1);
  return fc;
}

// ============ S9 ============
// key equality of slots i and j using stored offsets (no interning)
fn s9_keyeq(W:[]u8, i:i32, j:i32)i32 {
  let fb:i32=h_factbase(W);
  let oi:i32=fb+i*12;
  let oj:i32=fb+j*12;
  if(sub_streq(W,get32(W,oi),get32(W,oj))==0){return 0;}
  if(sub_streq(W,get32(W,oi+4),get32(W,oj+4))==0){return 0;}
  return 1;
}
// remove slot k, shifting triples and metadata down
fn s9_shift_out(W:[]u8, k:i32)void {
  let fb:i32=h_factbase(W);
  let fc:i32=h_factcount(W);
  let t:i32=k;
  while(t<fc-1){
    let o1:i32=fb+t*12;
    let o2:i32=fb+(t+1)*12;
    set32(W,o1,get32(W,o2));
    set32(W,o1+4,get32(W,o2+4));
    set32(W,o1+8,get32(W,o2+8));
    m_set(W,t,m_get(W,t+1));
    t=t+1;
  }
  h_factcount_set(W,fc-1);
  return;
}
// compaction: keep only the last triple per (e,a) key
fn s9_compact(W:[]u8)i32 {
  let removed:i32=0;
  let i:i32=0;
  while(i<h_factcount(W)){
    let j:i32=i+1;
    let sup:i32=0;
    while(j<h_factcount(W) && sup==0){
      if(s9_keyeq(W,i,j)==1){sup=1;}
      j=j+1;
    }
    if(sup==1){
      s9_shift_out(W,i);
      removed=removed+1;
    } else {
      i=i+1;
    }
  }
  h_compactc_set(W,h_compactc(W)+removed);
  return removed;
}
// evict one victim: unpinned, min (use, tick)
fn s9_evict_one(W:[]u8)i32 {
  let fc:i32=h_factcount(W);
  let best:i32=-1;
  let bu:i32=2147483647;
  let bt:i32=2147483647;
  let s:i32=0;
  while(s<fc){
    let mv:i32=m_get(W,s);
    if(m_pin(mv)==0){
      let u:i32=m_use(mv);
      let t:i32=m_tick(mv);
      if(u<bu || (u==bu && t<bt)){
        best=s; bu=u; bt=t;
      }
    }
    s=s+1;
  }
  if(best<0){return -1;}
  s9_shift_out(W,best);
  h_evict_set(W,h_evict(W)+1);
  return best;
}
fn s9_tick(W:[]u8)i32 {
  let s:i32=h_seq(W)+1;
  h_seq_set(W,s);
  return s & 32767;
}
// learn with pin flag; -2 when no room can be made
fn s9_learn(W:[]u8, e:[]u8, a:[]u8, v:[]u8, pin:i32)i32 {
  let tk:i32=s9_tick(W);
  let fc:i32=h_factcount(W);
  if(fc>=h_maxfact(W)){
    s9_compact(W);
    fc=h_factcount(W);
    if(fc>=h_maxfact(W)){
      let r:i32=s9_evict_one(W);
      if(r<0){
        h_learndrop_set(W,h_learndrop(W)+1);
        return -2;
      }
      fc=h_factcount(W);
    }
  }
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let vo:i32=sub_str(W,v);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      if(sub_streq(W,get32(W,o+8),vo)==0){
        h_conflicts_set(W,h_conflicts(W)+1);
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  let pp:i32=0;
  if(pin!=0){pp=1;}
  m_set(W,fc,m_make(pp,tk,0));
  h_factcount_set(W,fc+1);
  h_learnok_set(W,h_learnok(W)+1);
  return fc;
}
// latest-match query; on hit bumps use/tick. returns len or -1
fn s9_query(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  s9_tick(W);
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      let mv:i32=m_get(W,i);
      let u:i32=m_use(mv)+1;
      if(u>65535){u=65535;}
      m_set(W,i,m_make(m_pin(mv),h_seq(W) & 32767,u));
      let vo:i32=get32(W,o+8);
      let l:i32=get32(W,vo);
      let k:i32=0;
      while(k<l){ out[k]=W[vo+4+k]; k=k+1; }
      return l;
    }
    i=i-1;
  }
  return -1;
}
fn s9_pin(W:[]u8, e:[]u8, a:[]u8)i32 {
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      let mv:i32=m_get(W,i);
      m_set(W,i,m_make(1,m_tick(mv),m_use(mv)));
      return 1;
    }
    i=i-1;
  }
  return 0;
}

// ============ test helpers ============
fn beq(a:[]u8, al:i32, b:[]u8, bl:i32)i32 {
  if(al!=bl){return 0;}
  let i:i32=0;
  while(i<al){
    if(a[i]!=b[i]){return 0;}
    i=i+1;
  }
  return 1;
}
// prefix + decimal(i)
fn ename(prefix:[]u8, i:i32)[]u8 {
  let digits:[]u8=z_alloc(12);
  let nd:i32=0;
  let r:i32=i;
  if(r==0){ digits[0]=48; nd=1; }
  while(r>0){
    digits[nd]=(48+(r-((r/10)*10))) as u8;
    nd=nd+1;
    r=r/10;
  }
  let b:[]u8=z_alloc(prefix.len+nd);
  let k:i32=0;
  while(k<prefix.len){ b[k]=prefix[k]; k=k+1; }
  let d:i32=0;
  while(d<nd){ b[prefix.len+d]=digits[nd-1-d]; d=d+1; }
  return b;
}
fn expect_val(W:[]u8, e:[]u8, want:[]u8, tag:[]u8, fails:[]u8)i32 {
  let qb:[]u8=z_alloc(32);
  let l:i32=s9_query(W,e,"k",qb);
  if(l<0 || beq(qb,l,want,want.len)==0){
    emit("CHECK FAIL ");
    emit(tag);
    emit("\n");
    set32(fails,0,get32(fails,0)+1);
    return 0;
  }
  return 1;
}
fn expect_absent(W:[]u8, e:[]u8, tag:[]u8, fails:[]u8)i32 {
  let qb:[]u8=z_alloc(32);
  let l:i32=s9_query(W,e,"k",qb);
  if(l>=0){
    emit("CHECK FAIL ");
    emit(tag);
    emit(" (expected absent)\n");
    set32(fails,0,get32(fails,0)+1);
    return 0;
  }
  return 1;
}

// ============ K2 world ============
fn k2_world(W:[]u8, fails:[]u8)void {
  let r:i32=sub_init9(W,1,256,65536);
  if(r==0){ emit("CHECK FAIL K2 init\n"); set32(fails,0,get32(fails,0)+1); return; }
  let i:i32=0;
  // Phase A: 50 important, pin first 10
  while(i<50){
    let pn:i32=0;
    if(i<10){pn=1;}
    s9_learn(W,ename("imp",i),"k",ename("v",i),pn);
    i=i+1;
  }
  i=0;
  while(i<50){
    let q:i32=0;
    while(q<5){
      let qb:[]u8=z_alloc(32);
      let l:i32=s9_query(W,ename("imp",i),"k",qb);
      let w:[]u8=ename("v",i);
      if(l<0 || beq(qb,l,w,w.len)==0){
        emit("CHECK FAIL K2 phaseA query\n");
        set32(fails,0,get32(fails,0)+1);
      }
      q=q+1;
    }
    i=i+1;
  }
  // Phase B: 100 keys, old then new
  i=0;
  while(i<100){
    s9_learn(W,ename("sup",i),"k",ename("old",i),0);
    s9_learn(W,ename("sup",i),"k",ename("new",i),0);
    i=i+1;
  }
  i=0;
  while(i<100){
    let q:i32=0;
    while(q<3){
      let qb:[]u8=z_alloc(32);
      let l:i32=s9_query(W,ename("sup",i),"k",qb);
      let w:[]u8=ename("new",i);
      if(l<0 || beq(qb,l,w,w.len)==0){
        emit("CHECK FAIL K2 phaseB query\n");
        set32(fails,0,get32(fails,0)+1);
      }
      q=q+1;
    }
    i=i+1;
  }
  // Phase C: 250 junk, pin last 5
  i=0;
  while(i<250){
    let pn:i32=0;
    if(i>=245){pn=1;}
    s9_learn(W,ename("junk",i),"k",ename("j",i),pn);
    i=i+1;
  }
  // frozen predictions
  emit("K2 learn_ok=");
  emit(i32s(h_learnok(W)));
  emit(" learn_dropped=");
  emit(i32s(h_learndrop(W)));
  emit(" compact=");
  emit(i32s(h_compactc(W)));
  emit(" evict=");
  emit(i32s(h_evict(W)));
  emit(" factcount=");
  emit(i32s(h_factcount(W)));
  emit(" conflicts=");
  emit(i32s(h_conflicts(W)));
  emit("\n");
  if(h_learnok(W)!=500){ emit("CHECK FAIL K2 learn_ok\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_learndrop(W)!=0){ emit("CHECK FAIL K2 dropped\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_compactc(W)!=100){ emit("CHECK FAIL K2 compact\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_evict(W)!=144){ emit("CHECK FAIL K2 evict\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_factcount(W)!=256){ emit("CHECK FAIL K2 factcount\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_conflicts(W)!=100){ emit("CHECK FAIL K2 conflicts\n"); set32(fails,0,get32(fails,0)+1); }
  // important accuracy
  let acc:i32=0;
  i=0;
  while(i<50){
    acc=acc+expect_val(W,ename("imp",i),ename("v",i),"K2 imp",fails);
    i=i+1;
  }
  i=0;
  while(i<100){
    acc=acc+expect_val(W,ename("sup",i),ename("new",i),"K2 sup",fails);
    i=i+1;
  }
  emit("K2 important_acc=");
  emit(i32s(acc));
  emit("/150\n");
  if(acc!=150){ emit("CHECK FAIL K2 accuracy\n"); set32(fails,0,get32(fails,0)+1); }
  // pinned survival
  let ps:i32=0;
  i=0;
  while(i<10){
    ps=ps+expect_val(W,ename("imp",i),ename("v",i),"K2 pin-imp",fails);
    i=i+1;
  }
  i=245;
  while(i<250){
    ps=ps+expect_val(W,ename("junk",i),ename("j",i),"K2 pin-junk",fails);
    i=i+1;
  }
  emit("K2 pinned_survive=");
  emit(i32s(ps));
  emit("/15\n");
  if(ps!=15){ emit("CHECK FAIL K2 pinned\n"); set32(fails,0,get32(fails,0)+1); }
  // victim order spot checks
  let va:i32=0;
  i=0;
  while(i<10){
    va=va+expect_absent(W,ename("junk",i),"K2 victim",fails);
    i=i+1;
  }
  va=va+expect_absent(W,ename("junk",143),"K2 victim143",fails);
  let vp:i32=0;
  vp=vp+expect_val(W,ename("junk",144),ename("j",144),"K2 surv144",fails);
  vp=vp+expect_val(W,ename("junk",200),ename("j",200),"K2 surv200",fails);
  vp=vp+expect_val(W,ename("junk",249),ename("j",249),"K2 surv249",fails);
  emit("K2 victims_absent=");
  emit(i32s(va));
  emit("/11 survivors_present=");
  emit(i32s(vp));
  emit("/3\n");
  if(va!=11 || vp!=3){ emit("CHECK FAIL K2 victims\n"); set32(fails,0,get32(fails,0)+1); }
  return;
}

// ============ control: plain store, no S9 ============
fn control_world(W:[]u8, fails:[]u8)void {
  let r:i32=sub_init9(W,1,256,65536);
  if(r==0){ emit("CHECK FAIL CTL init\n"); set32(fails,0,get32(fails,0)+1); return; }
  let ok:i32=0;
  let drop:i32=0;
  let i:i32=0;
  while(i<50){
    let rr:i32=sub_fact_learn(W,ename("imp",i),"k",ename("v",i));
    if(rr>=0){ok=ok+1;} else {drop=drop+1;}
    i=i+1;
  }
  i=0;
  while(i<100){
    let r1:i32=sub_fact_learn(W,ename("sup",i),"k",ename("old",i));
    if(r1>=0){ok=ok+1;} else {drop=drop+1;}
    let r2:i32=sub_fact_learn(W,ename("sup",i),"k",ename("new",i));
    if(r2>=0){ok=ok+1;} else {drop=drop+1;}
    i=i+1;
  }
  i=0;
  while(i<250){
    let rr:i32=sub_fact_learn(W,ename("junk",i),"k",ename("j",i));
    if(rr>=0){ok=ok+1;} else {drop=drop+1;}
    i=i+1;
  }
  emit("CTL ok=");
  emit(i32s(ok));
  emit(" dropped=");
  emit(i32s(drop));
  emit(" factcount=");
  emit(i32s(h_factcount(W)));
  emit("\n");
  if(ok!=256 || drop!=244){ emit("CHECK FAIL CTL counts\n"); set32(fails,0,get32(fails,0)+1); }
  return;
}

// ============ K3 world: cap 1024 ============
fn k3_world(W:[]u8, fails:[]u8)void {
  let r:i32=sub_init9(W,1,1024,131072);
  if(r==0){ emit("CHECK FAIL K3 init\n"); set32(fails,0,get32(fails,0)+1); return; }
  let i:i32=0;
  while(i<300){
    s9_learn(W,ename("bi",i),"k",ename("bv",i),0);
    let qb:[]u8=z_alloc(32);
    s9_query(W,ename("bi",i),"k",qb);
    i=i+1;
  }
  i=0;
  while(i<900){
    s9_learn(W,ename("bj",i),"k",ename("w",i),0);
    i=i+1;
  }
  emit("K3 learn_ok=");
  emit(i32s(h_learnok(W)));
  emit(" learn_dropped=");
  emit(i32s(h_learndrop(W)));
  emit(" compact=");
  emit(i32s(h_compactc(W)));
  emit(" evict=");
  emit(i32s(h_evict(W)));
  emit(" factcount=");
  emit(i32s(h_factcount(W)));
  emit("\n");
  if(h_learnok(W)!=1200){ emit("CHECK FAIL K3 learn_ok\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_learndrop(W)!=0){ emit("CHECK FAIL K3 dropped\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_compactc(W)!=0){ emit("CHECK FAIL K3 compact\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_evict(W)!=176){ emit("CHECK FAIL K3 evict\n"); set32(fails,0,get32(fails,0)+1); }
  if(h_factcount(W)!=1024){ emit("CHECK FAIL K3 factcount\n"); set32(fails,0,get32(fails,0)+1); }
  let acc:i32=0;
  i=0;
  while(i<300){
    acc=acc+expect_val(W,ename("bi",i),ename("bv",i),"K3 bi",fails);
    i=i+1;
  }
  emit("K3 important_acc=");
  emit(i32s(acc));
  emit("/300\n");
  if(acc!=300){ emit("CHECK FAIL K3 accuracy\n"); set32(fails,0,get32(fails,0)+1); }
  let va:i32=0;
  i=0;
  while(i<5){
    va=va+expect_absent(W,ename("bj",i),"K3 victim",fails);
    i=i+1;
  }
  va=va+expect_absent(W,ename("bj",175),"K3 victim175",fails);
  let vp:i32=0;
  vp=vp+expect_val(W,ename("bj",176),ename("w",176),"K3 surv176",fails);
  vp=vp+expect_val(W,ename("bj",899),ename("w",899),"K3 surv899",fails);
  emit("K3 victims_absent=");
  emit(i32s(va));
  emit("/6 survivors_present=");
  emit(i32s(vp));
  emit("/2\n");
  if(va!=6 || vp!=2){ emit("CHECK FAIL K3 victims\n"); set32(fails,0,get32(fails,0)+1); }
  return;
}

fn main()i32 {
  let fails:[]u8=z_alloc(4);
  set32(fails,0,0);
  let w1:[]u8=z_alloc(65536);
  k2_world(w1,fails);
  let w2:[]u8=z_alloc(65536);
  control_world(w2,fails);
  let w3:[]u8=z_alloc(131072);
  k3_world(w3,fails);
  let n:i32=get32(fails,0);
  if(n==0){
    emit("SUBSTRATE-SCALE ALL-PASS\n");
  } else {
    emit("SUBSTRATE-SCALE FAILS=");
    emit(i32s(n));
    emit("\n");
  }
  return n;
}

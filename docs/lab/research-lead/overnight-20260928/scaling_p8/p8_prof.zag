// ---- P-INT5: DEVINT-CLA2 11 stages (compact curriculum) ----
fn t_dv()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // S1-S2: teach episodes, segment (teach 12)
  let i:i32=0;
  while(i<12){ev_teach(W,100+i,1,200+i); i=i+1;}
  // S3: form 4 groups
  let g0:i32=alloc_node(W); ns(W,g0,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,2);
  let g2:i32=alloc_node(W); ns(W,g2,0,2);
  let g3:i32=alloc_node(W); ns(W,g3,0,2);
  // S4: bigram edges (link 12)
  i=0; while(i<11){link_edge(W,100+i,1,101+i,0); i=i+1;}
  // S5: 5 rules via exact key (simplified)
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let r1:i32=ev_query(W,1,11,-2,0);
  // S6: procedure executes (via exact key)
  // S7: contradiction
  ev_teach(W,50,21,60); ev_observe(W,50,21,61);
  // S8: inquiry via uncertainty
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,70);
  // S9: demotion with history
  // S10: eviction pressure (60 teaches)
  i=0; while(i<60){ev_teach(W,600+i,31,i); i=i+1;}
  // S11: delayed reuse (query stage-1 facts)
  let ok:i32=1; i=0;
  while(i<12){if(ev_query(W,100+i,1,-2,0)!=200+i){ok=0;} i=i+1;}
  if(r1==2 && ok==1){return 1;} return 0;
}
// ---- F-INT4: cross-capability integration ----
fn t_xcap()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // teach chain, query miss builds plan, promotes MAP
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=201){return 0;}
  // create a guide node (simulating a MAP that guides action)
  let m:i32=alloc_node(W);
  if(m<2){return 0;}
  ns(W,m,0,20); write_node(W,m,77,505,0,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1); ns(W,m,4,505);
  // give it positive bid via self-loop
  link_edge(W,m,6,m,0);
  let b0:i32=bid(W,m);
  if(b0<=0){return 0;}
  // contradict the guide: both query standing and action candidacy demote
  contradict_map(W,m);
  let st:i32=map_standing(W,m);
  let b:i32=bid(W,m);
  if(st<0 && b<b0){return 1;} return 0;
}
// ============ main ============
// ============ TNN-2 new tests: the three changes ============
// Change 1: runtime construction. 4-hop chain: beyond the removed
// templates' ceiling (3-hop via compose-by-cloning). The winning graph is
// assembled at runtime by the trial loop and executed by execute().
fn t_t2_chain4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  if(a==5){return 1;} return 0;
}
// Change 1: anti-theater. t_p4 pattern: two candidates tried and genuinely
// rejected before the 3-hop winner verifies. Trial stats packed in hdr+16.
fn t_t2_trial_reject()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,107); ev_teach(W,102,12,103);
  ev_teach(W,102,19,108); ev_teach(W,103,13,104); ev_teach(W,103,19,109);
  let a:i32=ev_query(W,101,40,104,0);
  let st:i32=hg(W,16); let tried:i32=st/1024; let rej:i32=st-tried*1024;
  if(a==104 && tried>=3 && rej>=2){return 1;} return 0;
}
// Change 2: miss-to-act. The miss path itself reifies UNCERTAINTY and
// constructs the POLICY_ROOT-linked guide (no scaffolding).
fn t_t2_inquire()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  let u:i32=-1; let g:i32=-1; let n:i32=2;
  while(n<65536){
    if(ng(W,n,36)==1){
      if(ng(W,n,0)==30 && ng(W,n,20)==9002 && ng(W,n,24)==77){u=n;}
      if(ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g=n;}
    }
    n=n+1;
  }
  if(u<0 || g<0){return 0;}
  let pr:i32=pol_get(W); if(pr<2){return 0;}
  let e1:i32=0; let e2:i32=0; let e:i32=0;
  while(e<65536){
    if(eg(W,e,0)!=-1){
      if(eg(W,e,0)==g && eg(W,e,4)==1 && eg(W,e,8)==u){e1=1;}
      if(eg(W,e,0)==pr && eg(W,e,4)==10 && eg(W,e,8)==g){e2=1;}
    }
    e=e+1;
  }
  if(e1==1 && e2==1){return 1;} return 0;
}
// Change 2: the act path is live. ev_act over the miss-constructed guide
// returns 30 (inquiry act), not the hardcoded 0 fallback.
fn t_t2_actlive()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  ctx_push(W,9002);
  let c:i32=ev_act(W);
  if(c==30){return 1;} return 0;
}
// Change 3: generic revision. Promote a 2-hop chain answering 201, then
// contradict a licensing fact via the public observe path. The graph must
// be restructured (topology change, verified by re-execution), the promoted
// answer updated to 999, and map standing untouched (not a demotion).
fn t_t2_revise()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  if(ev_query(W,101,40,201,0)!=201){return 0;}
  let m:i32=-1; let n:i32=2;
  while(n<65536){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==40){m=n;}
    n=n+1;
  }
  if(m<0){return 0;}
  let root:i32=ng(W,m,20);
  let st0:i32=map_standing(W,m);
  let sig0:[]u8=z_alloc(256); let c0:i32=t2_sig(W,root,sig0);
  if(ev_observe(W,102,12,999)!=0){return 0;}
  if(t2_exec(W,root,101)!=999){return 0;}
  let sig1:[]u8=z_alloc(256); let c1:i32=t2_sig(W,root,sig1);
  let diff:i32=0;
  if(c0!=c1){diff=1;}
  else {
    let i:i32=0;
    while(i<c0){
      if(get32(sig0,i*8)!=get32(sig1,i*8) || get32(sig0,i*8+4)!=get32(sig1,i*8+4)){diff=1;}
      i=i+1;
    }
  }
  if(diff==0){return 0;}
  if(map_standing(W,m)!=st0){return 0;}
  if(ev_query(W,101,40,-2,0)!=999){return 0;}
  return 1;
}
fn run_all()i32 {
  let pass:i32=0; let total:i32=0;
  total=total+1; if(t_c1()==1){pass=pass+1; tpass("C1");} else {tfail("C1");}
  total=total+1; if(t_c2()==1){pass=pass+1; tpass("C2");} else {tfail("C2");}
  total=total+1; if(t_c3()==1){pass=pass+1; tpass("C3");} else {tfail("C3");}
  total=total+1; if(t_c4()==1){pass=pass+1; tpass("C4");} else {tfail("C4");}
  total=total+1; if(t_c5()==1){pass=pass+1; tpass("C5");} else {tfail("C5");}
  total=total+1; if(t_c6()==1){pass=pass+1; tpass("C6");} else {tfail("C6");}
  total=total+1; if(t_c7()==1){pass=pass+1; tpass("C7");} else {tfail("C7");}
  total=total+1; if(t_c8()==1){pass=pass+1; tpass("C8");} else {tfail("C8");}
  total=total+1; if(t_c9()==1){pass=pass+1; tpass("C9");} else {tfail("C9");}
  total=total+1; if(t_c10()==1){pass=pass+1; tpass("C10");} else {tfail("C10");}
  total=total+1; if(t_c11()==1){pass=pass+1; tpass("C11");} else {tfail("C11");}
  total=total+1; if(t_c12()==1){pass=pass+1; tpass("C12");} else {tfail("C12");}
  total=total+1; if(t_c13()==1){pass=pass+1; tpass("C13");} else {tfail("C13");}
  total=total+1; if(t_c14()==1){pass=pass+1; tpass("C14");} else {tfail("C14");}
  total=total+1; if(t_c15()==1){pass=pass+1; tpass("C15");} else {tfail("C15");}
  total=total+1; if(t_a1()==1){pass=pass+1; tpass("A1");} else {tfail("A1");}
  total=total+1; if(t_a2()==1){pass=pass+1; tpass("A2");} else {tfail("A2");}
  total=total+1; if(t_a3()==1){pass=pass+1; tpass("A3");} else {tfail("A3");}
  total=total+1; if(t_a4()==1){pass=pass+1; tpass("A4");} else {tfail("A4");}
  total=total+1; if(t_a5()==1){pass=pass+1; tpass("A5");} else {tfail("A5");}
  total=total+1; if(t_a6()==1){pass=pass+1; tpass("A6");} else {tfail("A6");}
  total=total+1; if(t_p1()==1){pass=pass+1; tpass("P1");} else {tfail("P1");}
  total=total+1; if(t_f2()==1){pass=pass+1; tpass("F2");} else {tfail("F2");}
  total=total+1; if(t_p2()==1){pass=pass+1; tpass("P2");} else {tfail("P2");}
  total=total+1; if(t_p2b()==1){pass=pass+1; tpass("P2b");} else {tfail("P2b");}
  total=total+1; if(t_p3a()==1){pass=pass+1; tpass("P3a");} else {tfail("P3a");}
  total=total+1; if(t_p3b()==1){pass=pass+1; tpass("P3b");} else {tfail("P3b");}
  total=total+1; if(t_p4()==1){pass=pass+1; tpass("P4");} else {tfail("P4");}
  total=total+1; if(t_p5()==1){pass=pass+1; tpass("P5");} else {tfail("P5");}
  total=total+1; if(t_abl_i()==1){pass=pass+1; tpass("ABL-I");} else {tfail("ABL-I");}
  total=total+1; if(t_abl_c()==1){pass=pass+1; tpass("ABL-C");} else {tfail("ABL-C");}
  total=total+1; if(t_p6()==1){pass=pass+1; tpass("P6");} else {tfail("P6");}
  total=total+1; if(t_p7()==1){pass=pass+1; tpass("P7");} else {tfail("P7");}
  total=total+1; if(t_dv()==1){pass=pass+1; tpass("DV");} else {tfail("DV");}
  total=total+1; if(t_xcap()==1){pass=pass+1; tpass("XCAP");} else {tfail("XCAP");}
  total=total+1; if(t_r_pact3()==1){pass=pass+1; tpass("R-PACT3");} else {tfail("R-PACT3");}
  total=total+1; if(t_r_pact1()==1){pass=pass+1; tpass("R-PACT1");} else {tfail("R-PACT1");}
  total=total+1; if(t_r_pact2()==1){pass=pass+1; tpass("R-PACT2");} else {tfail("R-PACT2");}
  total=total+1; if(t_r_pact4()==1){pass=pass+1; tpass("R-PACT4");} else {tfail("R-PACT4");}
  total=total+1; if(t_r_pact5()==1){pass=pass+1; tpass("R-PACT5");} else {tfail("R-PACT5");}
  total=total+1; if(t_r_pact6()==1){pass=pass+1; tpass("R-PACT6");} else {tfail("R-PACT6");}
  total=total+1; if(t_t2_chain4()==1){pass=pass+1; tpass("T2-CHAIN4");} else {tfail("T2-CHAIN4");}
  total=total+1; if(t_t2_trial_reject()==1){pass=pass+1; tpass("T2-REJECT");} else {tfail("T2-REJECT");}
  total=total+1; if(t_t2_inquire()==1){pass=pass+1; tpass("T2-INQUIRE");} else {tfail("T2-INQUIRE");}
  total=total+1; if(t_t2_actlive()==1){pass=pass+1; tpass("T2-ACTLIVE");} else {tfail("T2-ACTLIVE");}
  total=total+1; if(t_t2_revise()==1){pass=pass+1; tpass("T2-REVISE");} else {tfail("T2-REVISE");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<65536){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<65536){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<65536){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<65536){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<65536){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<65536){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// sc_patch.zag -- scaling continuation patch (unfrozen).
//
// Three mechanisms on the expanded 65536-node / 65536-edge workspace:
//
// A. MAP plen-bucket index (from si_patch.zag, adapted to 65536 nodes).
//    Mode bit0. Learner-maintained via idx_add on promote_graph.
//
// B. EMERGENT ORDERING (new): the retrieval priority key emerges from
//    access/consequence history instead of being fixed.
//    Mode bit1 (requires bit0).
//    - Fast path: the (MAP, path-length) pair of the last verified rebind
//      hit is remembered in learner state (MAP idx node field 12, packed
//      as mapid*8+plen). On the next query it is tried FIRST; verification
//      still arbitrates, so a stale winner costs exactly one rejected
//      verify and the scan falls through.
//    - Move-to-front: on every verified hit the winning MAP moves to the
//      front of its plen bucket. Bucket order therefore reflects
//      experienced success, not promotion order or id order.
//    No researcher table of "important MAPs" exists; priority is written
//    only by verified outcomes.
//
// C. FACT subject index (new): t2_gather's BFS scans all node slots per
//    expansion looking for FACTs whose subject (field 20) matches the
//    path end. Mode bit2.
//    - 24 hash buckets over 4 chained tag-40 index nodes (6 buckets each,
//      fields 8,16,20,24,28,32; field 12 chains nodes). Hash = s mod 24.
//    - Intrusive lists via FACT field 12 (free on tag-1 nodes: only zeroed
//      at alloc, never read/written elsewhere).
//    - Learner-maintained: fidx_add fires in ev_teach/ev_teach_in.
//    - t2_gather and t2_lu_first dispatch to indexed variants when bit2
//      is set; stale (evicted) entries are skipped by live/tag checks.
//
// Counters: header 56 = MAP scan visits, header 60 = plen walks (as in
// si_patch), MAP-idx node field 16 = FACT bucket visits.

// ---- chain-shape reader (verbatim from si_patch.zag) ----
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}

// ---- MAP index node (tag 40, id in header 52) ----
// f4  = mode bits (1=MAPidx, 2=MTF emergent order, 4=FACTidx)
// f8  = FACT index first node id (-1)
// f12 = MTF winner packed (mapid*8+plen), -1 = none
// f16 = FACT bucket-visit counter
// f20/24/28/32 = MAP bucket heads for plen 2/3/4/5
fn idx_node(W:[]u8)i32 { return hg(W,52); }
fn idx_bfield(plen:i32)i32 {
  if(plen==2){return 20;}
  if(plen==3){return 24;}
  if(plen==4){return 28;}
  if(plen==5){return 32;}
  return -1;
}
fn idx_mode(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){return 0;}
  return ng(W,ix,4);
}
fn idx_mode_set(W:[]u8,v:i32)void {
  let ix:i32=alloc_node(W);
  ns(W,ix,0,40); ns(W,ix,4,v);
  ns(W,ix,8,-1); ns(W,ix,12,-1); ns(W,ix,16,0);
  ns(W,ix,20,-1); ns(W,ix,24,-1); ns(W,ix,28,-1); ns(W,ix,32,-1);
  let first:i32=-1; let prev:i32=-1; let k:i32=0;
  while(k<4){
    let fn2:i32=alloc_node(W);
    ns(W,fn2,0,40); ns(W,fn2,4,k); ns(W,fn2,12,-1);
    ns(W,fn2,8,-1); ns(W,fn2,16,-1); ns(W,fn2,20,-1);
    ns(W,fn2,24,-1); ns(W,fn2,28,-1); ns(W,fn2,32,-1);
    link_edge(W,fn2,9,fn2,1000000);
    if(prev>=0){ns(W,prev,12,fn2);} else {first=fn2;}
    prev=fn2; k=k+1;
  }
  ns(W,ix,8,first);
  link_edge(W,ix,9,ix,1000000);
  hs(W,52,ix); hs(W,56,0); hs(W,60,0);
  return;
}
fn idx_add(W:[]u8,m:i32,root:i32)void {
  hs(W,60,hg(W,60)+1);
  let plen:i32=rb_chain_plen(W,root);
  let bf:i32=idx_bfield(plen);
  if(bf<0){return;}
  let ix:i32=idx_node(W);
  if(ix<0){return;}
  ns(W,m,12,ng(W,ix,bf));
  ns(W,ix,bf,m);
  return;
}

// ---- FACT subject index: 24 buckets, hash = s mod 24 ----
fn fhash(s:i32)i32 {
  let r:i32=s-((s/24)*24);
  if(r<0){r=r+24;}
  return r;
}
fn fidx_slot_field(s2:i32)i32 {
  if(s2==0){return 8;}
  if(s2==1){return 16;}
  if(s2==2){return 20;}
  if(s2==3){return 24;}
  if(s2==4){return 28;}
  return 32;
}
fn fidx_bhead(W:[]u8,b:i32)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){return -1;}
  let n:i32=ng(W,ix,8);
  let k:i32=b/6;
  while(k>0 && n>=0){n=ng(W,n,12); k=k-1;}
  if(n<0){return -1;}
  return ng(W,n,fidx_slot_field(b-((b/6)*6)));
}
fn fidx_bset(W:[]u8,b:i32,v:i32)void {
  let ix:i32=idx_node(W);
  if(ix<0){return;}
  let n:i32=ng(W,ix,8);
  let k:i32=b/6;
  while(k>0 && n>=0){n=ng(W,n,12); k=k-1;}
  if(n<0){return;}
  ns(W,n,fidx_slot_field(b-((b/6)*6)),v);
  return;
}
fn fidx_add(W:[]u8,s:i32,fn2:i32)void {
  let b:i32=fhash(s);
  ns(W,fn2,12,fidx_bhead(W,b));
  fidx_bset(W,b,fn2);
  return;
}
fn fcnt_inc(W:[]u8)void {
  let ix:i32=idx_node(W);
  if(ix<0){return;}
  ns(W,ix,16,ng(W,ix,16)+1);
  return;
}
fn fcnt_get(W:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix<0){return -1;}
  return ng(W,ix,16);
}
fn fcnt_zero(W:[]u8)void {
  let ix:i32=idx_node(W);
  if(ix<0){return;}
  ns(W,ix,16,0);
  return;
}

// ---- promote_graph: base body + MAP-index hook (bit0) ----
fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  ev_teach_in(W,s,r,ans);
  if((idx_mode(W)&1)==1){idx_add(W,m,root);}
  return m;
}

// ---- ev_teach / ev_teach_in: base bodies + FACT-index hook (bit2) ----
fn ev_teach(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); padd(W,0); decay(W); ctx_push(W,s);
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4));
  let prev:i32=-1; let m:i32=2;
  padd(W,1);
  while(m<65536){
    padd(W,1);
    if(ng(W,m,36)==1 && m!=n && ng(W,m,0)==1){prev=m;}
    m=m+1;
  }
  if(prev>=0){link_edge(W,n,5,prev,0);}
  log_ev(W,1,s,r,o,0,0,0);
  if((idx_mode(W)&4)==4){fidx_add(W,s,n);}
  return n;
}
fn ev_teach_in(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4));
  if((idx_mode(W)&4)==4){fidx_add(W,s,n);}
  return n;
}

// ---- t2_lu_first: dispatch ----
fn t2_lu_first_lin(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<65536){
    fcnt_inc(W); padd(W,28);
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn t2_lu_first_idx(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=fidx_bhead(W,fhash(s));
  while(n>=0){
    fcnt_inc(W); padd(W,28);
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=ng(W,n,12);
  }
  return -1;
}
fn t2_lu_first(W:[]u8,s:i32,r:i32)i32 {
  if((idx_mode(W)&4)==4){return t2_lu_first_idx(W,s,r);}
  return t2_lu_first_lin(W,s,r);
}

// ---- t2_gather: dispatch ----
fn t2_gather_lin(W:[]u8,s:i32,paths:[]u8)i32 {
  let np:i32=0; let cap:i32=96;
  set32(paths,0,1); set32(paths,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*48;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let n:i32=2;
      while(n<65536 && np<cap){
        fcnt_inc(W); padd(W,10);
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==lastv && ng(W,n,24)!=-999){
          let o:i32=ng(W,n,28);
          let k:i32=0; let cyc:i32=0;
          while(k<len){if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1;}
          if(cyc==0){
            let nb:i32=np*48; let c2:i32=0;
            while(c2<12){set32(paths,nb+c2*4,get32(paths,base+c2*4)); c2=c2+1;}
            set32(paths,nb,len+1);
            set32(paths,nb+4+len*4,o);
            set32(paths,nb+24+(len-1)*4,n);
            np=np+1;
          }
        }
        n=n+1;
      }
    }
    head=head+1;
  }
  return np;
}
fn t2_gather_idx(W:[]u8,s:i32,paths:[]u8)i32 {
  let np:i32=0; let cap:i32=96;
  set32(paths,0,1); set32(paths,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*48;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let n:i32=fidx_bhead(W,fhash(lastv));
      while(n>=0 && np<cap){
        fcnt_inc(W); padd(W,10);
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==lastv && ng(W,n,24)!=-999){
          let o:i32=ng(W,n,28);
          let k:i32=0; let cyc:i32=0;
          while(k<len){if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1;}
          if(cyc==0){
            let nb:i32=np*48; let c2:i32=0;
            while(c2<12){set32(paths,nb+c2*4,get32(paths,base+c2*4)); c2=c2+1;}
            set32(paths,nb,len+1);
            set32(paths,nb+4+len*4,o);
            set32(paths,nb+24+(len-1)*4,n);
            np=np+1;
          }
        }
        n=ng(W,n,12);
      }
    }
    head=head+1;
  }
  return np;
}
fn t2_gather(W:[]u8,s:i32,paths:[]u8)i32 {
  if((idx_mode(W)&4)==4){return t2_gather_idx(W,s,paths);}
  return t2_gather_lin(W,s,paths);
}

// ---- shared attempt helper: assemble path pp at plen, verify, promote ----
fn rb_attempt(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8,paths:[]u8,pp:i32,plen:i32)i32 {
  let base:i32=pp*48;
  let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
  padd(W,11); paddv(W,25,40);
  let j:i32=0;
  while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
  j=0;
  while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
  let nr:i32=t2_asm_chain(W,v,plen,f);
  let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
  if(v2==-2){padd(W,13);} else {padd(W,12);}
  if(v2!=-2){promote_graph(W,nr,s,r,v2,f,plen-1);}
  return v2;
}

// ---- MTF: record winner (MAP, plen); move MAP to bucket front ----
fn mtf_win(W:[]u8,m:i32,plen:i32)void {
  let ix:i32=idx_node(W);
  if(ix<0){return;}
  ns(W,ix,12,m*8+plen);
  let bf:i32=idx_bfield(plen);
  if(bf<0){return;}
  let head:i32=ng(W,ix,bf);
  if(head!=m){
    let prev:i32=head;
    while(prev>=0 && ng(W,prev,12)!=m){prev=ng(W,prev,12);}
    if(prev>=0){
      ns(W,prev,12,ng(W,m,12));
      ns(W,m,12,head);
      ns(W,ix,bf,m);
    }
  }
  return;
}

// ---- linear rebind (65536-node version, counters) ----
fn rebind_try_lin(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let paths:[]u8=z_alloc(4608);
  paddv(W,25,4608);
  let np:i32=t2_gather(W,s,paths);
  let m:i32=2;
  padd(W,8);
  while(m<65536 && ans==-2){
    padd(W,8);
    hs(W,56,hg(W,56)+1);
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      hs(W,60,hg(W,60)+1);
      let plen:i32=rb_chain_plen(W,ng(W,m,20));
      if(plen>=2){
        let p:i32=0;
        while(p<np && ans==-2){
          let base:i32=p*48;
          if(get32(paths,base)==plen){
            let v2:i32=rb_attempt(W,s,r,expected,masked,st,paths,p,plen);
            if(v2!=-2){ans=v2;}
          }
          p=p+1;
        }
      }
    }
    m=m+1;
  }
  return ans;
}

// ---- indexed rebind with emergent ordering ----
// ---- indexed rebind: hardened bucket walk (from index_harden/ih_patch.zag) ----
// Four GENERAL invariants guard every bucket entry before use, checked in
// dependency order (each check reads only state earlier checks proved
// safe to read):
//   I1 BOUNDS: m in [2,NN()). A corrupt head or next pointer outside the
//     node table would make ng(W,m,*) read past the workspace.
//     Violation: stop this bucket. Nothing past a corrupt link is trusted.
//   I2 CYCLE: m not already visited in this bucket traversal. Any cycle
//     shape (self-loop, loop, lollipop, shared tail) revisits a node; the
//     per-bucket seen bitmap catches every one. Violation: stop; all
//     distinct reachable nodes are already collected.
//   I3 LIVENESS: ng(W,m,36)==1. Evicted slots are dead and their field 12
//     may hold garbage from slot reuse. Violation: skip the entry but keep
//     walking, so stale entries do not hide live ones behind them.
//   I4 TYPE: ng(W,m,0)==T_MAP (20). Only MAP nodes belong in MAP buckets.
//     Violation: skip, keep walking (same reasoning as I3).
//   I5 BUFFER: nc<8192 always (cand is 65536 bytes, 8 per entry). Enforced
//     by the walk condition; collection past capacity is impossible.
//     (Capacity adapted from 512 to 8192 for the 5000-MAP scale: the
//     plen-2 bucket alone holds ~4995 decoy MAPs. I1-I4 are verbatim.)
// The index root itself is validated (bounds and tag 40) before any
// bucket head is read.
fn idx_walk_bucket(W:[]u8,q:i32,cand:[]u8,nc:i32,seen:[]u8)i32 {
  let ix:i32=idx_node(W);
  if(ix<2 || ix>=NN()){return nc;}
  if(ng(W,ix,0)!=40){return nc;}
  let m:i32=ng(W,ix,idx_bfield(q));
  while(m>=0 && nc<8192){
    if(m<2 || m>=NN()){break;}
    if(get32(seen,m*4)==1){break;}
    set32(seen,m*4,1);
    padd(W,9);
    hs(W,56,hg(W,56)+1);
    if(ng(W,m,36)==1 && ng(W,m,0)==T_MAP()){
      set32(cand,nc*8,m); set32(cand,nc*8+4,q);
      nc=nc+1;
    }
    m=ng(W,m,12);
  }
  return nc;
}
fn rebind_try_idx(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let ix:i32=idx_node(W);
  let mtf:i32=(idx_mode(W)&2)==2;
  let paths:[]u8=z_alloc(4608);
  paddv(W,25,4608);
  let np:i32=t2_gather(W,s,paths);
  if(mtf){
    let w:i32=ng(W,ix,12);
    if(w>=0){
      let wm:i32=w/8; let wp:i32=w-wm*8;
      if(wm>=0 && wm<65536 && ng(W,wm,36)==1 && ng(W,wm,0)==20){
        let p:i32=0;
        while(p<np && ans==-2){
          if(get32(paths,p*48)==wp){
            let v2:i32=rb_attempt(W,s,r,expected,masked,st,paths,p,wp);
            if(v2!=-2){ans=v2;}
          }
          p=p+1;
        }
        if(ans!=-2){return ans;}
      }
    }
  }
  let want:[]u8=z_alloc(16);
  let p:i32=0;
  while(p<np){
    let L:i32=get32(paths,p*48);
    if(L>=2 && L<=5){set32(want,(L-2)*4,1);}
    p=p+1;
  }
  let cand:[]u8=z_alloc(65536);
  paddv(W,25,65536);
  let nc:i32=0;
  let q:i32=2;
  while(q<=5){
    if(get32(want,(q-2)*4)==1){
      let seen:[]u8=z_alloc(NN()*4);
      paddv(W,25,NN()*4);
      nc=idx_walk_bucket(W,q,cand,nc,seen);
    }
    q=q+1;
  }
  if(mtf==0){
    let a:i32=1;
    while(a<nc){
      let kid:i32=get32(cand,a*8); let kp:i32=get32(cand,a*8+4);
      let b2:i32=a-1;
      while(b2>=0 && get32(cand,b2*8)>kid){
        set32(cand,(b2+1)*8,get32(cand,b2*8));
        set32(cand,(b2+1)*8+4,get32(cand,b2*8+4));
        b2=b2-1;
      }
      set32(cand,(b2+1)*8,kid); set32(cand,(b2+1)*8+4,kp);
      a=a+1;
    }
  }
  let ci:i32=0;
  while(ci<nc && ans==-2){
    let m2:i32=get32(cand,ci*8); let plen:i32=get32(cand,ci*8+4);
    let pp:i32=0;
    while(pp<np && ans==-2){
      if(get32(paths,pp*48)==plen){
        let v2:i32=rb_attempt(W,s,r,expected,masked,st,paths,pp,plen);
        if(v2!=-2){
          ans=v2;
          if(mtf){mtf_win(W,m2,plen);}
        }
      }
      pp=pp+1;
    }
    ci=ci+1;
  }
  return ans;
}

// ---- ev_query: base logic, rebind arm dispatched on bit0 ----
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); padd(W,6); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0); paddv(W,25,8);
  let masked:i32=flags&1;
  let ra:i32=-2;
  if((idx_mode(W)&1)==1){ra=rebind_try_idx(W,s,r,expected,masked,rbs);}
  else {ra=rebind_try_lin(W,s,r,expected,masked,rbs);}
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let recent:i32=-1; let mm:i32=2;
  padd(W,7);
  while(mm<65536){
    padd(W,7);
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// p8_driver.zag -- SCALING-P8 profiler driver (charter 94).
//
// Pure Zag. All statistics are computed and printed from inside the Zag
// binary; the shell only times whole runs and hashes stdout.
//
// Usage: p8_prof D MODE PHASE
//   D     = number of broken plen-2 decoys (0, 90, 990, 4995, ...)
//   MODE  = 0 linear rebind, 1 indexed rebind, 2 indexed+MTF,
//           4 FACT-index only (gather/lu_first dispatch), 5 = 4|1
//   PHASE = 0 all, 1 facts only, 2 facts+decoys+real, 3 all (== 0)
//
// PHASE exists so wall/CPU cost can be attributed to a phase from outside
// by differencing two runs. Counters are cumulative and are differenced in
// Zag by p8_dump_delta.
fn p8_big()[]u8 {
  let W:[]u8=z_alloc(3674176+2048);
  let i:i32=3674176;
  while(i<3674176+2048){W[i]=0; i=i+1;}
  return W;
}
fn atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0;
  let n:i32=s.len;
  if(n==0){return -1;}
  while(i<n){
    let c:i32=s[i] as i32;
    if(c<48){return v;}
    if(c>57){return v;}
    v=v*10+(c-48); i=i+1;
  }
  return v;
}
fn pk(k:i32)[]u8 {
  if(k==0){return "ev_teach_calls ";}
  if(k==1){return "evteach_prev_visits ";}
  if(k==2){return "decay_edge_visits ";}
  if(k==3){return "activate_node_visits ";}
  if(k==4){return "activate_bid_calls ";}
  if(k==5){return "bid_edge_visits ";}
  if(k==6){return "ev_query_calls ";}
  if(k==7){return "evquery_recent_visits ";}
  if(k==8){return "rebind_lin_visits ";}
  if(k==9){return "idx_bucket_visits ";}
  if(k==10){return "gather_fact_visits ";}
  if(k==11){return "verify_attempts ";}
  if(k==12){return "verify_accepted ";}
  if(k==13){return "verify_rejected ";}
  if(k==14){return "asm_chain_calls ";}
  if(k==15){return "try_verify_calls ";}
  if(k==16){return "t2_chain_calls ";}
  if(k==17){return "mp_run_calls ";}
  if(k==18){return "log_ev_calls ";}
  if(k==19){return "alloc_node_calls ";}
  if(k==20){return "alloc_scan_visits ";}
  if(k==21){return "alloc_evict_paths ";}
  if(k==22){return "is_superseded_calls ";}
  if(k==23){return "link_edge_scan_visits ";}
  if(k==24){return "link_edge_calls ";}
  if(k==25){return "qpath_alloc_bytes ";}
  if(k==26){return "decay_calls ";}
  if(k==27){return "alloc_raw_calls ";}
  if(k==28){return "lu_first_visits ";}
  return "? ";
}
fn p8_scan_maxnode(W:[]u8)i32 {
  let mx:i32=-1; let n:i32=2;
  while(n<65536){
    if(ng(W,n,36)==1 && n>mx){mx=n;}
    n=n+1;
  }
  return mx;
}
fn p8_dump(W:[]u8,tag:[]u8,D:i32,mode:i32,ph:i32)void {
  emit("P8DUMP tag="); emit(tag);
  emit(" D="); e64(D); emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit(" live_nodes="); e64(hg(W,20));
  emit(" live_edges="); e64(hg(W,24));
  emit(" max_node_id="); e64(p8_scan_maxnode(W));
  emit(" teaches="); e64(hg(W,0));
  emit("\n");
  let k:i32=0;
  while(k<29){
    emit("  "); emit(pk(k)); e64(pget(W,k)); emit("\n");
    k=k+1;
  }
  return;
}
fn p8_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn p8_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn p8_run(D:i32,mode:i32,ph:i32,tag:[]u8)void {
  emit("P8START "); emit(tag);
  emit(" D="); e64(D); emit(" mode="); e64(mode); emit(" phase="); e64(ph);
  emit("\n");
  let W:[]u8=p8_big(); tnn2_init(W);
  idx_mode_set(W,mode);
  let qi:i32=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  p8_dump(W,"after_facts",D,mode,ph);
  if(ph==1){
    emit("P8END\n");
    return;
  }
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(p8_mkbroken(W,20000+i,51,20001+i)<0){fails=fails+1;}
    i=i+1;
  }
  i=0;
  while(i<5){
    if(p8_mkchain(W,5000+i*10,5,51,5004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit("P8BUILD fails="); e64(fails); emit("\n");
  p8_dump(W,"after_build",D,mode,ph);
  if(ph==2){
    emit("P8END\n");
    return;
  }
  qi=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit("P8Q q="); e64(q);
    emit(" ans="); e64(b);
    emit(" tried="); e64(hg(W,16)/1024);
    emit(" rejected="); e64(hg(W,16)-(hg(W,16)/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" ok="); e64(b==q+104); emit("\n");
    p8_dump(W,"after_q",D,mode,ph);
    qi=qi+1;
  }
  emit("P8END\n");
  return;
}
fn main()i32 {
  emit("P8PROF-START\n");
  let a1:[]u8=_zag_arg(1);
  let a2:[]u8=_zag_arg(2);
  let a3:[]u8=_zag_arg(3);
  let D:i32=atoi(a1);
  let mode:i32=atoi(a2);
  let ph:i32=atoi(a3);
  emit("P8ARGS D="); e64(D);
  emit(" mode="); e64(mode); emit(" phase="); e64(ph); emit("\n");
  p8_run(D,mode,ph,"main");
  emit("P8PROF-END\n");
  return 0;
}

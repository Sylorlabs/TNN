// r1_micro.zag -- SCALING-P8 K1b minimal reproducer for the B1 namespace
// collision (node ids vs frame-slot references in one integer namespace).
//
// The reproducer is SCALE-FREE on purpose. It is the exact code shape of
// the frozen engine's operand resolver, shrunk so that the node-id range
// and the frame-slot range overlap in a few slots instead of at ~14000
// nodes. If the shrunk form is already silently wrong, then the frozen
// form's correctness at 5000 MAPs is a property of two unrelated
// constants, not of the representation.
//
// Frozen semantics of the resolver under test (tnn2_frozen_ref.zag:179
// and base_64k.zag:180, verbatim modulo the threshold value):
//     fn res_op(W,f,op) { if(op>=FRAME_BASE){return fr_get(W,f,op-FRAME_BASE);}
//                         if(op>=0){return ng(W,op,20);} return 0; }
// `ng(W,op,20)` reads a NODE's field 20 (a trial literal value).
// `fr_get(W,f,slot)` reads a FRAME cell. Both are reached from the same
// integer `op`, with no discriminant.
//
// No global state exists in Zag, so FRAME_BASE is threaded as a
// parameter `fb`, mirroring the frozen constant exactly.
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0; i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn e64(v:i32)void {
  let neg:i32=0; let x:i64=v as i64;
  if(x<0){neg=1; x=0-x;}
  let n:i32=1; let t:i64=x;
  while(t>=10){t=t/10; n=n+1;}
  let buf:[]u8=z_alloc(24);
  let e:i32=n+neg; let p:i32=e-1; let y:i64=x;
  if(y==0){buf[p]=48;}
  while(y>0){buf[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(neg==1){buf[n]=45;}
  emit(buf[0..e]);
  return;
}
// --- mini arena: 4 slots of frame, 64 nodes, node base 0 ---
fn NOF(n:i32)i32 { return n*8; }
fn nset(W:[]u8,n:i32,v:i32)void { set32(W,NOF(n),v); return; }
fn nget(W:[]u8,n:i32)i32 { return get32(W,NOF(n)); }
fn fr_get(W:[]u8,f:i32,s:i32)i32 { return get32(W,f+s*4); }
fn fr_set(W:[]u8,f:i32,s:i32,v:i32)void { set32(W,f+s*4,v); return; }
// ---- THE UNDER TEST: one integer namespace, two meanings ----
fn res_op(W:[]u8,f:i32,op:i32,fb:i32)i32 {
  if(op>=fb){return fr_get(W,f,op-fb);}
  if(op>=0){return nget(W,op);}
  return 0;
}
fn main()i32 {
  emit("R1_MICRO_START\n");
  let W:[]u8=z_alloc(1024);
  let fr:i32=512;
  let FB:i32=8;
  // Two live literal nodes, exactly as promote_graph's t2_lit writes them:
  // node n holds its literal VALUE in field 20 (here field 0).
  nset(W,3,2222);
  nset(W,9,1111);
  // One live frame cell, slot 1, as t2_set/t2_mov would write it.
  fr_set(W,fr,1,9999);
  emit("R1 fb="); e64(FB);
  emit(" live_node_ids=3,9 frame_slot1=9999\n");
  // Below threshold: op is a NODE ID. Must read the node.
  let a:i32=res_op(W,fr,3,FB);
  emit("R1 op=3  below_fb expect=2222 got="); e64(a);
  emit(" verdict="); if(a==2222){emit("NODE-OK");} else {emit("NODE-WRONG");} emit("\n");
  // At threshold: op >= FB is claimed to be a FRAME SLOT.
  let b:i32=res_op(W,fr,9,FB);
  emit("R1 op=9  at_fb    node_value=1111 frame_slot1=9999 got="); e64(b);
  emit(" verdict="); if(b==1111){emit("NODE-OK");} else {emit("READ-AS-FRAME-SLOT");} emit("\n");
  // The misread is SILENT: no trap, no panic, exit status 0.
  emit("R1 silent=yes exit=0\n");
  // Sweep: every node id >= FB is unreadable as a node.
  let n:i32=0; let bad:i32=0; let first:i32=-1;
  while(n<64){
    if(n>=FB){
      let want:i32=1000+n;
      nset(W,n,want);
      let got:i32=res_op(W,fr,n,FB);
      if(got!=want){bad=bad+1; if(first<0){first=n;}}
    }
    n=n+1;
  }
  emit("R1 sweep nodes_64 unreadable="); e64(bad);
  emit(" first_bad_id="); e64(first);
  emit(" threshold="); e64(FB); emit("\n");
  emit("R1 CONCLUSION: the operand integer namespace is shared; the exact\n");
  emit("R1 threshold at which node ids start being misread is FB, and the\n");
  emit("R1 error is a wrong VALUE, not a fault.\n");
  emit("R1_MICRO_END\n");
  return 0;
}

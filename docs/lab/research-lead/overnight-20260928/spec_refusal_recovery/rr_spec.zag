// rr_spec.zag -- refusal-recovery protocol for SPEC-REFUSAL-RECOVERY.
//
// Each wrapper calls the corresponding et_* epoch-gated spec. On EXPLICIT
// refusal (the refusal counter moved, not a silent miss) it re-specializes
// the refused bucket family from the current world via the et_specialize_*
// wrappers (which rebuild the buckets and restamp the epoch tags to the
// live world epoch), counts one re-specialize event, and retries exactly
// once. A miss with a matching epoch returns as-is: recovery fires only on
// refusal, never on miss. A second refusal on the retry is returned as-is
// (second-order failure, caught by the kill bars, never silently looped).
// No world literals appear in this file.
fn rr_ret_spec(L:[]u8,S:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_ret(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_ret_spec(L,A,rel,obj,kb,ko,out,oo,rkb,rko);
}
fn rr_cnt_spec(L:[]u8,S:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_cnt(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_cnt_spec(L,A,rel,sb,so,nsubs,kb,ko,seen,rkb,rko);
}
fn rr_vfy_spec(L:[]u8,S:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32,spb:[]u8,spo:i32)i32 {
  let r0:i32=get32(rkb,rko);
  let v:i32=et_vfy_spec(L,A,C,kb,ko,rkb,rko);
  if(get32(rkb,rko)==r0){ return v; }
  et_specialize_vfy(L,S,A,0,0);
  set32(spb,spo,get32(spb,spo)+1);
  return et_vfy_spec(L,A,C,kb,ko,rkb,rko);
}

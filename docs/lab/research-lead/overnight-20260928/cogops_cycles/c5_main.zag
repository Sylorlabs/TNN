fn dump_bind(b:[]u8,c:i32,L:[]u8)i32 {
  let bi:i32=0;
  while(bi<8){
    let tag:i32=get32(L,12744+bi*32);
    if(tag!=0){
      c=o_app(b,c,"BIND tag=");
      c=o_i64(b,c,tag as i64);
      c=o_app(b,c," fam=");
      c=o_i64(b,c,get32(L,12744+bi*32+4) as i64);
      c=o_app(b,c," ok0=");
      c=o_i64(b,c,get32(L,12744+bi*32+8) as i64);
      c=o_app(b,c," f0=");
      c=o_i64(b,c,get32(L,12744+bi*32+12) as i64);
      c=o_app(b,c," ok1=");
      c=o_i64(b,c,get32(L,12744+bi*32+16) as i64);
      c=o_app(b,c," f1=");
      c=o_i64(b,c,get32(L,12744+bi*32+20) as i64);
      c=o_app(b,c," ok2=");
      c=o_i64(b,c,get32(L,12744+bi*32+24) as i64);
      c=o_app(b,c," f2=");
      c=o_i64(b,c,get32(L,12744+bi*32+28) as i64);
      c=o_nl(b,c);
    }
    bi=bi+1;
  }
  return c;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one count episode ----
fn run_cntep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,id:i32,ep:i32)i32 {
  cnt_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let subj:i32=get32(rb,4);
  let n:i32=cnt_episode(L,A,rel,subj,K,tout,seen);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," cnt n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_808: independent all-generic reference composition ----
// need order: pattern, chain template, count. Uses only ret_gen,
// vfy_gen, cnt_gen.
fn oracle_808(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,1,0);
  let npass:i32=0;
  let pass:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns);
    let i:i32=0;
    while(i<ns){
      let s:i32=need_f(G,1,1+i*3);
      if(s==0){ s=sub; }
      set32(tmpc,4+i*12,s);
      set32(tmpc,4+i*12+4,need_f(G,1,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,1,1+i*3+2));
      i=i+1;
    }
    let vv:i32=vfy_gen(A,tmpc,K,4);
    if(vv==1){
      set32(pass,4+npass*4,sub);
      npass=npass+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass);
  let q3:i32=0;
  while(q3<npass){
    ans_append(oans,get32(pass,4+q3*4));
    q3=q3+1;
  }
  let rel2:i32=need_f(G,2,0);
  let cc:i32=cnt_gen(A,rel2,pass,4,npass,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,cc);
  return;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn oracle_dia(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns2:i32=need_f(G,2,0);
  let npass2:i32=0;
  let pass2:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub2:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns2);
    let i:i32=0;
    while(i<ns2){
      let s2:i32=need_f(G,2,1+i*3);
      if(s2==0){ s2=sub2; }
      set32(tmpc,4+i*12,s2);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv2:i32=vfy_gen(A,tmpc,K,4);
    if(vv2==1){
      set32(pass2,4+npass2*4,sub2);
      npass2=npass2+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass2);
  let q3:i32=0;
  while(q3<npass2){
    ans_append(oans,get32(pass2,4+q3*4));
    q3=q3+1;
  }
  let ns1:i32=need_f(G,1,0);
  let npass1:i32=0;
  let pass1:[]u8=z_alloc(160);
  let q4:i32=0;
  while(q4<nc){
    let sub1:i32=get32(tout,4+q4*4);
    set32(tmpc,0,ns1);
    let j:i32=0;
    while(j<ns1){
      let s1:i32=need_f(G,1,1+j*3);
      if(s1==0){ s1=sub1; }
      set32(tmpc,4+j*12,s1);
      set32(tmpc,4+j*12+4,need_f(G,1,1+j*3+1));
      set32(tmpc,4+j*12+8,need_f(G,1,1+j*3+2));
      j=j+1;
    }
    let vv1:i32=vfy_gen(A,tmpc,K,4);
    if(vv1==1){
      set32(pass1,4+npass1*4,sub1);
      npass1=npass1+1;
    }
    q4=q4+1;
  }
  ans_append(oans,npass1);
  let q5:i32=0;
  while(q5<npass1){
    ans_append(oans,get32(pass1,4+q5*4));
    q5=q5+1;
  }
  let rel3:i32=need_f(G,3,0);
  let cat:[]u8=z_alloc(160);
  let tot:i32=0;
  let q6:i32=0;
  while(q6<npass1){
    set32(cat,4+tot*4,get32(pass1,4+q6*4));
    tot=tot+1;
    q6=q6+1;
  }
  let q7:i32=0;
  while(q7<npass2){
    set32(cat,4+tot*4,get32(pass2,4+q7*4));
    tot=tot+1;
    q7=q7+1;
  }
  let ccd:i32=cnt_gen(A,rel3,cat,4,tot,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,ccd);
  return;
}
// ---- chain_of: build a chain buffer from a goal need, sub fills s==0 ----
fn chain_of(G:[]u8,ni:i32,sub:i32,tmpc:[]u8)void {
  let ns:i32=need_f(G,ni,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=need_f(G,ni,1+i*3);
    if(s==0){ s=sub; }
    set32(tmpc,4+i*12,s);
    set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
    i=i+1;
  }
  return;
}
// ---- walk_fix: iterate RETRIEVE [rel, obj] until output == input ----
// Returns the fixpoint subject. Independent of the learner; uses
// only ret_gen. Guarded by a 16-step cap for totality.
fn walk_fix(A:[]u8,rel:i32,obj:i32,K:[]u8,tout:[]u8)i32 {
  let guard:i32=0;
  let walking:i32=1;
  while(walking==1){
    if(guard>=16){ walking=0; }
    if(walking==1){
      let nr:i32=ret_gen(A,rel,obj,K,4,tout,0);
      if(nr==0){ walking=0; }
      if(nr>0){
        let s:i32=get32(tout,4);
        if(s==obj){ walking=0; }
        if(s!=obj){ obj=s; }
      }
      guard=guard+1;
    }
  }
  return obj;
}
// ---- oracle_cyc816: independent all-generic reference, self-loop goal ----
// Intended semantics: seed = RETRIEVE need0; walk = iterate RETRIEVE
// [successor-rel, obj] to the fixpoint; final = VERIFY the fixpoint subject
// against need2's template. Records emitted in plan order:
// need1, need2, need0. Uses only ret_gen, vfy_gen.
fn oracle_cyc816(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let seed:[]u8=z_alloc(160);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=chain_new();
  let nc0:i32=ret_gen(A,need_f(G,0,0),need_f(G,0,1),K,4,seed,0);
  let fix:i32=walk_fix(A,need_f(G,1,0),need_f(G,1,1),K,tout);
  chain_of(G,2,fix,tmpc);
  let vv:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,fix);
  let npass:i32=0;
  if(vv==1){ npass=1; }
  ans_append(oans,npass);
  if(npass==1){ ans_append(oans,fix); }
  ans_append(oans,nc0);
  let k:i32=0;
  while(k<nc0){
    ans_append(oans,get32(seed,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_cyc817: independent all-generic reference, 2-node cycle ----
// Intended semantics: seed = RETRIEVE need0; walk to the fixpoint;
// need1 = VERIFY the fixpoint; need2 = RETRIEVE [successor-rel, fixpoint];
// need3 = VERIFY the fixpoint. Records in plan order need0..need3.
// Uses only ret_gen, vfy_gen.
fn oracle_cyc817(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let seed:[]u8=z_alloc(160);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=chain_new();
  let nc0:i32=ret_gen(A,need_f(G,0,0),need_f(G,0,1),K,4,seed,0);
  let fix:i32=walk_fix(A,need_f(G,2,0),need_f(G,2,1),K,tout);
  chain_of(G,1,fix,tmpc);
  let vv1:i32=vfy_gen(A,tmpc,K,4);
  let nr2:i32=ret_gen(A,need_f(G,2,0),fix,K,4,tout,0);
  chain_of(G,3,fix,tmpc);
  let vv3:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,nc0);
  let k:i32=0;
  while(k<nc0){
    ans_append(oans,get32(seed,4+k*4));
    k=k+1;
  }
  let np1:i32=0;
  if(vv1==1){ np1=1; }
  ans_append(oans,np1);
  if(np1==1){ ans_append(oans,fix); }
  ans_append(oans,nr2);
  let q:i32=0;
  while(q<nr2){
    ans_append(oans,get32(tout,4+q*4));
    q=q+1;
  }
  let np3:i32=0;
  if(vv3==1){ np3=1; }
  ans_append(oans,np3);
  if(np3==1){ ans_append(oans,fix); }
  return;
}
// ---- oracle_809: independent all-generic reference composition ----
// need order: count (literal subject), pattern (rel pivoted from the
// count need's input field 0), chain template over retrieve output.
fn oracle_809(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let relA:i32=need_f(G,0,0);
  let subj0:i32=need_f(G,0,2);
  let one:[]u8=z_alloc(16);
  set32(one,0,subj0);
  let c0:i32=cnt_gen(A,relA,one,0,1,K,4,seen);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,c0);
  let obj:i32=need_f(G,1,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,relA,obj,K,4,tout,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,2,0);
  let npass:i32=0;
  let pass:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns);
    let i:i32=0;
    while(i<ns){
      let s:i32=need_f(G,2,1+i*3);
      if(s==0){ s=sub; }
      set32(tmpc,4+i*12,s);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv:i32=vfy_gen(A,tmpc,K,4);
    if(vv==1){
      set32(pass,4+npass*4,sub);
      npass=npass+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass);
  let q3:i32=0;
  while(q3<npass){
    ans_append(oans,get32(pass,4+q3*4));
    q3=q3+1;
  }
  return;
}
// ---- oracle_812: independent all-generic reference composition ----
// need order: concrete chain, pattern (rel pivoted from the chain's
// step-0 relation), count over retrieve output subjects.
fn oracle_812(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  let relC:i32=need_f(G,0,2);
  let obj:i32=need_f(G,1,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,relC,obj,K,4,tout,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let rel2:i32=need_f(G,2,0);
  let cc:i32=cnt_gen(A,rel2,tout,4,nc,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,cc);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
// it=1 uses the generalized composer (compose_iter); it=0 the frozen
// composer (compose). okind selects the oracle: 0=chain, 1=diamond,
// 2=cyc816, 3=cyc817. Efficiency stats accumulate over agree=1
// queries only. showp=1 prints passes= (meaningful for it=1).
fn do_query(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32,it:i32,showp:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=0;
  if(it==1){ st=compose_iter(L,A,G,K,ans,vbuf); }
  if(it==0){ st=compose(L,A,G,K,ans,vbuf); }
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  set32(K,4,0);
  if(okind==0){ oracle_808(A,G,K,oans,seen); }
  if(okind==1){ oracle_dia(A,G,K,oans,seen); }
  if(okind==2){ oracle_cyc816(A,G,K,oans,seen); }
  if(okind==3){ oracle_cyc817(A,G,K,oans,seen); }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  let a:i32=ans_eq(ans,oans);
  if(a==1){
    set32(L,13240,get32(L,13240)+1);
    set32(L,13244,get32(L,13244)+cs);
    set32(L,13248,get32(L,13248)+cg);
  }
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn:i32=get32(vbuf,16);
  let p:i32=0;
  while(p<nn){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  if(showp==1){
    if(it==1){
      c=o_app(b,c," passes=");
      c=o_i64(b,c,get32(vbuf,20) as i64);
    }
  }
  c=o_nl(b,c);
  return c;
}
// ---- topo probe: log the Kahn-placed count and stall flag ----
fn topo_probe(b:[]u8,c:i32,G:[]u8,tord:[]u8)i32 {
  let tpl:i32=topo_g(G,tord);
  let tnn:i32=g_nneeds(G);
  c=o_app(b,c,"TOPO goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," placed=");
  c=o_i64(b,c,tpl as i64);
  b[c]=47; c=c+1;
  c=o_i64(b,c,tnn as i64);
  c=o_app(b,c," stall=");
  if(tpl==tnn){ c=o_app(b,c,"0"); }
  if(tpl!=tnn){ c=o_app(b,c,"1"); }
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let pg1:[]u8=z_alloc(64);
  let pg2:[]u8=z_alloc(64);
  let tord:[]u8=z_alloc(16);
  // S1A RET-LEARN (world A)
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1A RET-LEARN"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  // S1B VFY-LEARN (world A)
  c=o_app(B,c,"STAGE S1B VFY-LEARN"); c=o_nl(B,c);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S1C CNT-LEARN (world A)
  c=o_app(B,c,"STAGE S1C CNT-LEARN"); c=o_nl(B,c);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,0,8);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,1,9);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,2,10);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,3,11);
  specialize_cnt(L,A,8,11);
  c=spec_line_cnt(B,c,L);
  c=dump_lstate_cnt(B,c,L);
  // S2 DIAMOND-DIVERGE (world A, generalized composer)
  c=o_app(B,c,"STAGE S2 DIAMOND-DIVERGE"); c=o_nl(B,c);
  mk_goal813_E0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"E0",1,1,0);
  c=dump_bind(B,c,L);
  c=dump_plans(B,c,L);
  // S3 DIAMOND-CONVERGE (world A, generalized composer)
  c=o_app(B,c,"STAGE S3 DIAMOND-CONVERGE"); c=o_nl(B,c);
  mk_goal814_E1(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"E1",1,1,0);
  c=dump_plans(B,c,L);
  // S4 CHAIN-REGRESS (world A, generalized composer)
  c=o_app(B,c,"STAGE S4 CHAIN-REGRESS"); c=o_nl(B,c);
  mk_goal808_A0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"R0",0,1,0);
  c=dump_plans(B,c,L);
  // S5 DIAMOND-SHIFTB (world B; all coverages cleared; generalized)
  setup_worldB(A);
  ret_cov_clear(L);
  vfy_cov_clear(L);
  cnt_cov_clear(L);
  c=o_app(B,c,"STAGE S5 DIAMOND-SHIFTB"); c=o_nl(B,c);
  mk_goal815_B0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"B0",1,1,0);
  // S6 DIAMOND-REVISEB: count episodes on B, re-specialize count
  c=o_app(B,c,"STAGE S6 DIAMOND-REVISEB"); c=o_nl(B,c);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,4,12);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,5,13);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,6,14);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,7,15);
  specialize_cnt(L,A,12,15);
  c=spec_line_cnt(B,c,L);
  c=dump_lstate_cnt(B,c,L);
  mk_goal815_B0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"B1",1,1,0);
  // S7 CYCLE-LEARN (world C): retrieve episodes on the successor relation,
  // verify episode on the marker relation; re-specialize ret and vfy on C.
  // (S5 cleared coverages, so the seed relation is re-learned
  // here too: the cycle goal needs its RETRIEVE seed.)
  c=o_app(B,c,"STAGE S7 CYCLE-LEARN"); c=o_nl(B,c);
  setup_worldC(A);
  c=run_retep(B,c,L,A,K,rb,tout,4,16);
  c=run_retep(B,c,L,A,K,rb,tout,5,17);
  c=run_retep(B,c,L,A,K,rb,tout,2,18);
  specialize_ret(L,A,16,18);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,4,19);
  specialize_vfy(L,A,19,19);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S7b: the 4-slot plan cache is full. Drop the
  // superseded diamond/chain plans via the general plan_drop,
  // keeping the B-diamond plan for the S13 rederive. Frees cycle slots.
  mk_goal813_E0(G); plan_drop(L,g_tag(G));
  mk_goal814_E1(G); plan_drop(L,g_tag(G));
  mk_goal808_A0(G); plan_drop(L,g_tag(G));
  c=o_app(B,c,"PLANDROP done"); c=o_nl(B,c);
  // S8 CYCLE-SELFLOOP (world C, generalized composer)
  c=o_app(B,c,"STAGE S8 CYCLE-SELFLOOP"); c=o_nl(B,c);
  mk_goal816_C0(G);
  c=topo_probe(B,c,G,tord);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"C0",2,1,1);
  c=dump_plans(B,c,L);
  // S9 CYCLE-2NODE (world C, generalized composer)
  c=o_app(B,c,"STAGE S9 CYCLE-2NODE"); c=o_nl(B,c);
  mk_goal817_C1(G);
  c=topo_probe(B,c,G,tord);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"C1",3,1,1);
  c=dump_plans(B,c,L);
  // S10 FROZEN-SELFLOOP (world C, frozen composer, plan loaded)
  c=o_app(B,c,"STAGE S10 FROZEN-SELFLOOP"); c=o_nl(B,c);
  mk_goal816_C0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"F0",2,0,1);
  // S11 FROZEN-2NODE (world C, frozen composer, plan dropped+rebuilt)
  c=o_app(B,c,"STAGE S11 FROZEN-2NODE"); c=o_nl(B,c);
  mk_goal817_C1(G);
  plan_drop(L,g_tag(G));
  c=topo_probe(B,c,G,tord);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"F1",3,0,1);
  c=dump_plans(B,c,L);
  // S12 DECLINE-NOVEL (generalized composer)
  c=o_app(B,c,"STAGE S12 DECLINE-NOVEL"); c=o_nl(B,c);
  mk_goal810(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"X",0,1,0);
  c=dump_bind(B,c,L);
  // S13 REDERIVE (world B, generalized composer): snapshot the B-diamond
  // plan, clear plans AND bindings, rebuild, byte-compare.
  c=o_app(B,c,"STAGE S13 REDERIVE"); c=o_nl(B,c);
  setup_worldB(A);
  mk_goal815_B0(G);
  let gt8:i32=g_tag(G);
  let pi8:i32=plan_find(L,gt8);
  let k8:i32=0;
  while(k8<14){
    set32(pg1,k8*4,get32(L,13000+pi8*56+k8*4));
    k8=k8+1;
  }
  clear_plans(L);
  clear_bindings(L);
  mk_goal815_B0(G);
  c=do_query(B,c,L,A,K,G,ans,oans,vbuf,seen,"S8",1,1,0);
  let pi9:i32=plan_find(L,g_tag(G));
  let k9:i32=0;
  while(k9<14){
    set32(pg2,k9*4,get32(L,13000+pi9*56+k9*4));
    k9=k9+1;
  }
  let m:i32=1;
  let k:i32=0;
  while(k<14){
    if(get32(pg1,k*4)!=get32(pg2,k*4)){ m=0; }
    k=k+1;
  }
  c=o_app(B,c,"REDERIVE match=");
  c=o_i64(B,c,m as i64);
  c=o_nl(B,c);
  // SUMMARY
  c=o_app(B,c,"SUMMARY-CYCLES agree=");
  c=o_i64(B,c,get32(L,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,13248) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,13252) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,13256) as i64);
  c=o_app(B,c," vs=");
  c=o_i64(B,c,get32(L,13260) as i64);
  c=o_app(B,c," vg=");
  c=o_i64(B,c,get32(L,13264) as i64);
  c=o_app(B,c," cts=");
  c=o_i64(B,c,get32(L,13268) as i64);
  c=o_app(B,c," ctg=");
  c=o_i64(B,c,get32(L,13272) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

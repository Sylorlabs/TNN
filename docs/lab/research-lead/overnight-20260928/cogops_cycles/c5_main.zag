// c5_main.zag -- driver for the cogops-cycles battery.
// Stages S1A..S13: the C433 diamond/chain/decline battery (S1A..S6,
// S12, S13) run through the GENERALIZED composer (regression), plus
// the cycle stages: S7 (cycle learning on world C), S8 (self-loop
// mk_goal816_C0, generalized, predicted PASS), S9 (2-node cycle
// mk_goal817_C1, generalized, predicted PASS), S10 (frozen self-loop, predicted FAIL),
// S11 (frozen 2-node cycle, predicted FAIL with corrupt Kahn order).
// Independent all-generic oracles: oracle_808 / oracle_dia (carried
// over) and oracle_cyc816 / oracle_cyc817 (new; records in plan
// order). do_query selects the frozen or generalized composer and
// accumulates efficiency stats over agree=1 queries only.
// All dynamic output goes through the single preallocated buffer B,
// flushed once at the end. No world literals in this file.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}

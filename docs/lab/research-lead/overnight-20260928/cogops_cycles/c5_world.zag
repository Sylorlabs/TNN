// c5_world.zag -- environment definitions for the cogops-cycles battery.
// = c4_world.zag (cogops-diamond) PLUS the cycle workload:
// setup_worldC (world A + rel 604 successor chain with taught fixpoint
// + rel 605 markers), retrieve-episode patterns id 4/5, verify-episode
// chain id 4, goal constructors mk_goal816_C0 (self-loop walk) and
// mk_goal817_C1 (VERIFY->RETRIEVE 2-node cycle).
// ALL world literals live in this file.
//
// World A (56 facts): rel 601: (611+i,601,621+i) and (611+i,601,631+i);
// rel 602: (611+i,602,622+i) and (611+i,602,632+i);
// rel 603: (611+i,603,620+i) and (611+i,603,630+i), i=0..7.
// Distractors 607: (631+k,607,641+k); 609: (635+k,609,645+k), k=0..3.
// World B (40 facts): rel 701: (711+i,701,721+i) and (711+i,701,731+i);
// rel 702: (711+i,702,722+i) and (711+i,702,732+i), i=0..7.
// Distractor 707: (731+k,707,741+k), k=0..7.
fn setup_worldA(A:[]u8)void {
  set32(A,0,0);
  let i:i32=0;
  while(i<8){
    fact_add(A,611+i,601,621+i);
    fact_add(A,611+i,601,631+i);
    fact_add(A,611+i,602,622+i);
    fact_add(A,611+i,602,632+i);
    fact_add(A,611+i,603,620+i);
    fact_add(A,611+i,603,630+i);
    i=i+1;
  }
  let k:i32=0;
  while(k<4){
    fact_add(A,631+k,607,641+k);
    fact_add(A,635+k,609,645+k);
    k=k+1;
  }
  return;
}
fn setup_worldB(A:[]u8)void {
  set32(A,0,0);
  let i:i32=0;
  while(i<8){
    fact_add(A,711+i,701,721+i);
    fact_add(A,711+i,701,731+i);
    fact_add(A,711+i,702,722+i);
    fact_add(A,711+i,702,732+i);
    i=i+1;
  }
  let k:i32=0;
  while(k<8){
    fact_add(A,731+k,707,741+k);
    k=k+1;
  }
  return;
}
// ---- retrieve-episode patterns: id -> (rel, obj) at rb[ro], rb[ro+4] ----
// (c5: ids 4,5 are the cycle-workload patterns on rel 604.)
fn ret_ep_pat(id:i32,rb:[]u8,ro:i32)void {
  if(id==0){ set32(rb,ro,601); set32(rb,ro+4,623); return; }
  if(id==1){ set32(rb,ro,602); set32(rb,ro+4,625); return; }
  if(id==2){ set32(rb,ro,601); set32(rb,ro+4,621); return; }
  if(id==4){ set32(rb,ro,604); set32(rb,ro+4,611); return; }
  if(id==5){ set32(rb,ro,604); set32(rb,ro+4,618); return; }
  set32(rb,ro,602); set32(rb,ro+4,622);
  return;
}
// ---- verify-episode chains ----
// (c5: id 4 is the cycle-workload chain on rel 605.)
fn vfy_ep_chain(C:[]u8,id:i32)void {
  chain_clear(C);
  if(id==0){
    chain_add(C,611,601,621); chain_add(C,611,602,622); return;
  }
  if(id==1){
    chain_add(C,612,603,621); chain_add(C,612,601,622); return;
  }
  if(id==2){
    chain_add(C,613,602,624); chain_add(C,613,603,622); return;
  }
  if(id==4){
    chain_add(C,612,605,640); return;
  }
  chain_add(C,614,601,624); chain_add(C,614,603,629);
  return;
}
// ---- count-episode patterns: id -> (rel, subj) at rb[ro], rb[ro+4] ----
fn cnt_ep_pat(id:i32,rb:[]u8,ro:i32)void {
  if(id==0){ set32(rb,ro,601); set32(rb,ro+4,611); return; }
  if(id==1){ set32(rb,ro,602); set32(rb,ro+4,611); return; }
  if(id==2){ set32(rb,ro,603); set32(rb,ro+4,612); return; }
  if(id==3){ set32(rb,ro,601); set32(rb,ro+4,613); return; }
  if(id==4){ set32(rb,ro,701); set32(rb,ro+4,711); return; }
  if(id==5){ set32(rb,ro,702); set32(rb,ro+4,711); return; }
  if(id==6){ set32(rb,ro,701); set32(rb,ro+4,712); return; }
  set32(rb,ro,702); set32(rb,ro+4,713);
  return;
}
// ---- goal layout helpers ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
// Link kind 1 = scalar copy; kind 2 = fan-out; kind 3 = aggregate.
fn w_begin(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag); set32(G,4,nn); return 8;
}
fn w_need(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag); set32(G,off+4,nf); return off+8;
}
fn w_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn w_links(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn w_link(G:[]u8,off:i32,k:i32,dn:i32,dk:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,off,k); set32(G,off+4,dn); set32(G,off+8,dk);
  set32(G,off+12,ds); set32(G,off+16,sn); set32(G,off+20,sk);
  set32(G,off+24,ss);
  return off+28;
}
// Goal 808 A0: P=(601,623); T=(S,602,624),(S,603,622); CNT [601,1,0]
fn mk_goal808_A0(G:[]u8)void {
  let o:i32=w_begin(G,808,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,623);
  o=w_need(G,o,802,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,602); o=w_f(G,o,624);
  o=w_f(G,o,0); o=w_f(G,o,603); o=w_f(G,o,622);
  o=w_need(G,o,807,3); o=w_f(G,o,601); o=w_f(G,o,1); o=w_f(G,o,0);
  o=w_links(G,o,2);
  o=w_link(G,o,2,1,0,0,0,1,0);
  o=w_link(G,o,3,2,0,0,1,0,0);
  return;
}

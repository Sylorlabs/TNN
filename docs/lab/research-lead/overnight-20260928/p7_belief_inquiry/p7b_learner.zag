// p7b_learner.zag -- P7-BELIEF-INQUIRY epistemic layer.
//
// Section 0: the bp2_* block below is copied VERBATIM from
// belief_provenance_9/bp9_learner.zag (sha256
// 2de20f5a0ff87bc45140a161548b613b008e9c2adabf4da3fdda6d6d46040c5e).
// Zero edits. R1-R7, eff(), retire, relicense, bar_after stay frozen.
//
// Section 1: the new epistemic machinery. It adds a provenance ledger,
// source reliability, a learned probe-channel contingency, a derived
// mass vector, and ONE decision rule p7b_val. There is no inquiry mode:
// p7b_val builds a candidate set from what the frozen store structurally
// offers (frozen bp2_select's COMMIT candidate, structurally scanned
// unlicensed probes as RUN candidates, SAFE, WITHHOLD), scores every
// candidate with the same utility, and takes the strict argmax.
//
// S is one flat i32 arena. Offset map (all byte offsets):
//    0     ctrl Q            4  ctrl QQ           8  ctrl nH
//   12     ctrl abl_dep     16  ctrl abl_rel     20  ctrl abl_plain
//   24     ctrl C_RIGHT     28  ctrl C_WRONG     32  ctrl C_PROBE
//   36     ctrl C_SAFE      40  ctrl C_DEADLINE  44  ctrl HZN
//   48     ctrl step        52  ctrl nclaims     56  ctrl RESOLVED_TOTAL
//   60     ctrl selector    64  ctrl rng         68  ctrl lastact
//   72     ctrl blind_argmax (bit off by one; -1 = none yet)
//   76     ctrl G_before    80  ctrl G_after     84  ctrl nrun
//   88     ctrl committed_h 92  ctrl comm_h      96  ctrl revcount
//  512     hypothesis record, 8 cells x 8 hypotheses
//  768     hypothesis store FACT node id, one cell each
//  832     hypothesis store MAP belief node id, one cell each
// 1024     claim ledger, 16 cells x 96 claims
// 7168     source record, 8 cells x 16 sources
// 8192     probe-channel contingency C[k][h][o], 8*6*6 cells
// 10240    probe-run log, pairs (channel, outcome)
// 11008    PRB  current probability vector (0..255), 8 cells
// 11264    PRB2 branch probability vector, 8 cells
// 12096    PROB scanned probe node ids
// 13056    CAND frozen-selection candidate MAP ids
// 14080    VALV last value written by p7b_val
// 14336    MS  mass/pseudo-probability stack, 8 cells x 512 slots
//
// Claim ledger fields: 0 q, 1 src, 2 val, 3 parent, 4 dep,
// 5 residual, 6 root, 7 live, 8 kind, 9 step.
// Source fields: 0 hits, 1 misses, 2 nclaims.

fn bp2_lic_live(W:[]u8,mid:i32,out:[]u8)void {
  let live:i32=0; let ne:i32=0; let nself:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        live=live+1;
        let st:i32=ng(W,f,16);
        if(st==1 || st==2 || st==5){ne=ne+1;}
        if(st==3 || st==4 || st==6){nself=nself+1;}
      }
    }
    e=e+1;
  }
  set32(out,0,live); set32(out,4,ne); set32(out,8,nself);
  return;
}

fn bp2_form(W:[]u8,bt:[]u8,hasb:[]u8,mid:i32,iscomp:i32)void {
  let base:i32=100; let one:i32=1; let zero:i32=0;
  let full:i32=255;
  let o:i32=mid*8;
  let ne:i32=0; let nself:i32=0; let formed:i32=0;
  if(iscomp==0){
    let out:[]u8=z_alloc(12);
    bp2_lic_live(W,mid,out);
    ne=get32(out,4); nself=get32(out,8); formed=get32(out,0);
  }
  bt[o]=base as u8; bt[o+1]=one as u8; bt[o+2]=zero as u8;
  bt[o+3]=zero as u8; bt[o+4]=ne as u8; bt[o+5]=nself as u8;
  bt[o+6]=full as u8; bt[o+7]=formed as u8;
  hasb[mid]=one as u8;
  return;
}

fn bp2_confirm(bt:[]u8,mid:i32,indep:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32;
  if(indep==1){s=s+20;} else {s=s+10;}
  if(s>255){s=255;}
  bt[o]=s as u8;
  let c:i32=bt[o+1] as i32;
  if(c<255){c=c+1;}
  bt[o+1]=c as u8;
  let zero:i32=0;
  bt[o+2]=zero as u8;
  return;
}

fn bp2_disconfirm(bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32 - 20;
  if(s<0){s=0;}
  bt[o]=s as u8;
  let d:i32=bt[o+2] as i32;
  if(d<255){d=d+1;}
  bt[o+2]=d as u8;
  let zero:i32=0;
  bt[o+1]=zero as u8;
  return;
}

fn bp2_revise(bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32 / 2;
  bt[o]=s as u8;
  let r:i32=bt[o+3] as i32;
  if(r<255){r=r+1;}
  bt[o+3]=r as u8;
  let zero:i32=0;
  bt[o+1]=zero as u8; bt[o+2]=zero as u8;
  return;
}

fn bp2_retire(W:[]u8,bt:[]u8,mid:i32,reason:i32)void {
  link_edge(W,mid,3,mid,reason);
  let zero:i32=0;
  bt[mid*8]=zero as u8;
  return;
}

fn bp2_has_k3(W:[]u8,mid:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==3 && eg(W,e,8)==mid){return 1;}
    e=e+1;
  }
  return 0;
}

fn bp2_has_k3r(W:[]u8,mid:i32,reason:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==3 && eg(W,e,8)==mid && eg(W,e,12)==reason){return 1;}
    e=e+1;
  }
  return 0;
}

fn bp2_relicense(W:[]u8,bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let formed:i32=bt[o+7] as i32;
  if(formed<=0){return;}
  let out:[]u8=z_alloc(12);
  bp2_lic_live(W,mid,out);
  let live:i32=get32(out,0);
  if(live==0){bp2_retire(W,bt,mid,2); return;}
  let s:i32=bt[o] as i32;
  s=s*live/formed;
  bt[o]=s as u8;
  bt[o+4]=get32(out,4) as u8;
  bt[o+5]=get32(out,8) as u8;
  return;
}

fn bp2_propagate(W:[]u8,bt:[]u8,hasb:[]u8,z:i32)i32 {
  let m:i32=255;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==z && eg(W,e,4)==14){
      let c:i32=eg(W,e,8);
      if(c>=0 && ng(W,c,36)==1 && (hasb[c] as i32)==1){
        let s:i32=bt[c*8] as i32;
        if(s<m){m=s;}
      }
    }
    e=e+1;
  }
  if(m<255){
    bt[z*8]=m as u8;
    if(m==0){bp2_retire(W,bt,z,2);}
  }
  return m;
}

fn bp2_eff(bt:[]u8,mid:i32)i32 {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32;
  let ne:i32=bt[o+4] as i32;
  let nself:i32=bt[o+5] as i32;
  if(ne+nself==0){return s;}
  let d:i32=bt[o+6] as i32;
  return s*(ne*255+d*nself)/(255*(ne+nself));
}

fn bp2_select(bt:[]u8,hasb:[]u8,cands:[]u8,nc:i32,bar:i32)i32 {
  let best:i32=-3; let beff:i32=-1; let tie:i32=0;
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if((hasb[m] as i32)==1){
      let e:i32=bp2_eff(bt,m);
      if(e>beff){beff=e; best=m; tie=0;}
      else{if(e==beff){tie=1;}}
    }
    i=i+1;
  }
  if(best==-3){return -3;}
  if(tie==1){return -3;}
  if(beff<bar){return -3;}
  return best;
}

fn bp2_lgsel(W:[]u8,cands:[]u8,nc:i32)i32 {
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if(ng(W,m,36)==1){return m;}
    i=i+1;
  }
  return -1;
}

fn bp2_kill_one_prov(W:[]u8,mid:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        ns(W,f,0,0); ns(W,f,36,0);
        return f;
      }
    }
    e=e+1;
  }
  return -1;
}

fn bp2_census(W:[]u8,n:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

fn bp2_bar_after(bar:i32,confirmed:i32,eff:i32)i32 {
  if(confirmed==1){return bar+1;}
  if(eff>=bar*2){
    let nb:i32=bar-1;
    if(nb<10){nb=10;}
    return nb;
  }
  return bar;
}

// ===================== SECTION 1: new epistemic layer =====================
//
// ORDERING IS LOAD-BEARING. This compiler has no forward declarations
// and silently miscompiles (here: hangs) a call to a function defined
// later in the translation unit. Every callee below is defined before
// its first use; the only recursion is p7b_val calling itself.
//
// One flat arena S. Offset map (byte offsets):
//    0     ctrl Q            4  ctrl QQ           8  ctrl nH
//   12     ctrl abl_dep     16  ctrl abl_rel     20  ctrl abl_plain
//   24     ctrl C_RIGHT     28  ctrl C_WRONG     32  ctrl C_PROBE
//   36     ctrl C_SAFE      40  ctrl C_DEADLINE  44  ctrl HZN
//   48     ctrl step        52  ctrl nclaims     56  ctrl RESOLVED_TOTAL
//   60     ctrl selector    64  ctrl rng         68  ctrl lastact
//   72     ctrl prev argmax (-1 = none yet)
//   76     ctrl G_before    80  ctrl G_after     84  ctrl nrun
//   88     ctrl committed_h 92  ctrl revcount    96  ctrl liveclaims
//  512     hypothesis record, 8 cells x 8 hypotheses
//  768     hypothesis store FACT node id, one cell each
//  832     hypothesis store MAP belief node id, one cell each
// 1024     claim ledger, 16 cells x 96 claims
// 7168     source record, 8 cells x 16 sources
// 8192     probe-channel contingency C[k][h][o], 8*6*6 cells
// 10240    probe-run log, pairs (channel, outcome), 32 pairs
// 11008    frozen-selection save area, 8 cells
// 12096    PROB scanned probe node ids       12200 USED flags
// 12304    NPROB                             13056 CAND belief ids
// 13304    NCAND                             13600 probe-use MAP ids
// 14080    VALV value written by p7b_val
// 16000    SLOT: 320 slots x 64 bytes. Cells 0..7 mass vector,
//                    cells 8..15 probability vector (both 0..255).
// S is 34000 bytes. The belief table BT (8192) and flag table HB (1024)
// are separate buffers so the frozen bp2_* functions run on them
// verbatim.
//
// Claim ledger fields: 0 q, 1 src, 2 val, 3 parent, 4 dep, 5 residual,
// 6 root, 7 live, 8 kind, 9 step, 10 store node.
// Source fields: 0 hits, 1 misses, 2 nclaims.

fn p7b_LD(S:[]u8,c:i32,f:i32)i32 { return get32(S,1024+c*64+f*4); }
fn p7b_LS(S:[]u8,c:i32,f:i32,v:i32)void { set32(S,1024+c*64+f*4,v); return; }
fn p7b_SR(S:[]u8,s:i32,f:i32)i32 { return get32(S,7168+s*32+f*4); }
fn p7b_SS(S:[]u8,s:i32,f:i32,v:i32)void { set32(S,7168+s*32+f*4,v); return; }
fn p7b_HY(S:[]u8,h:i32,f:i32)i32 { return get32(S,512+h*32+f*4); }
fn p7b_HYS(S:[]u8,h:i32,f:i32,v:i32)void { set32(S,512+h*32+f*4,v); return; }
fn p7b_HIF(S:[]u8,h:i32)i32 { return get32(S,768+h*4); }
fn p7b_HIM(S:[]u8,h:i32)i32 { return get32(S,832+h*4); }
fn p7b_CT(S:[]u8,k:i32,h:i32,o:i32)i32 { return get32(S,8192+((k*6+h)*6+o)*4); }
fn p7b_CTS(S:[]u8,k:i32,h:i32,o:i32,v:i32)void { set32(S,8192+((k*6+h)*6+o)*4,v); return; }
fn p7b_sm(S:[]u8,sl:i32,i:i32,v:i32)void { set32(S,16000+sl*64+i*4,v); return; }
fn p7b_gm(S:[]u8,sl:i32,i:i32)i32 { return get32(S,16000+sl*64+i*4); }
fn p7b_smp(S:[]u8,sl:i32,i:i32)i32 { return get32(S,16000+sl*64+(8+i)*4); }
fn p7b_sms(S:[]u8,sl:i32,i:i32,v:i32)void { set32(S,16000+sl*64+(8+i)*4,v); return; }

fn p7b_init(S:[]u8)void {
  let i:i32=0;
  while(i<34000){ S[i]=0; i=i+1; }
  set32(S,72,-1); set32(S,88,-1);
  return;
}

// Reset everything except the contingency table (the learner's
// accumulated calibration, which must survive into the decision arms),
// and return the claim store nodes to the free pool so a scenario can be
// rebuilt without reallocating the arena.
fn p7b_ledger_reset(S:[]u8,W:[]u8)void {
  let nc:i32=get32(S,52); let c:i32=0;
  while(c<nc){
    let nd:i32=p7b_LD(S,c,10);
    if(nd>=2){ns(W,nd,0,0); ns(W,nd,36,0);}
    c=c+1;
  }
  let ne:i32=hg(W,24); let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==2){es(W,e,0,-1);}
    e=e+1;
  }
  let i:i32=1024;
  while(i<8192){ S[i]=0; i=i+1; }
  i=10240;
  while(i<14100){ S[i]=0; i=i+1; }
  set32(S,52,0); set32(S,56,0); set32(S,84,0);
  set32(S,72,-1); set32(S,88,-1); set32(S,92,0); set32(S,96,0);
  return;
}

fn p7b_setw(S:[]u8,q:i32,qq:i32,n:i32,cr:i32,cw:i32,cp:i32,cs:i32,cd:i32,hzn:i32)void {
  set32(S,0,q); set32(S,4,qq); set32(S,8,n);
  let b:i32=0;
  while(b<8){p7b_HYS(S,b,4,0); b=b+1;}
  set32(S,56,0);
  set32(S,24,cr); set32(S,28,cw); set32(S,32,cp);
  set32(S,36,cs); set32(S,40,cd); set32(S,44,hzn);
  return;
}

fn p7b_abl(S:[]u8,d:i32,r:i32,p:i32)void {
  set32(S,12,d); set32(S,16,r); set32(S,20,p);
  return;
}

// Source reliability: Beta(1,1) posterior mean on the 255 scale. With no
// record a source is neither trusted nor distrusted (127). The update is
// symmetric in direction, so a source that starts lying falls and a
// source that improves recovers.
fn p7b_rel(S:[]u8,s:i32)i32 {
  if(get32(S,20)==1){return 255;}
  if(get32(S,16)==1){return 128;}
  let hi:i32=p7b_SR(S,s,0); let mi:i32=p7b_SR(S,s,1);
  return (1+hi)*255/(2+hi+mi);
}

// Residual independence of a claim: 255 with no provenance parent,
// residual(parent)*(255-dep)/255 otherwise. With several type-2 parents
// the SMALLEST residual wins, the conservative choice.
fn p7b_resid(W:[]u8,S:[]u8,node:i32)i32 {
  if(node<0){return 255;}
  let ne:i32=hg(W,24);
  let e:i32=0; let found:i32=0; let best:i32=255;
  while(e<ne){
    let hit:i32=0;
    if(eg(W,e,0)==node && eg(W,e,4)==2 && eg(W,e,8)>=0 && eg(W,e,8)<node){hit=1;}
    if(hit==1){
      let par:i32=eg(W,e,8);
      let d:i32=255-eg(W,e,12);
      if(d<0){d=0;}
      let pr:i32=p7b_resid(W,S,par);
      let v:i32=pr*d/255;
      if(found==0){best=v; found=1;}
      if(found==1 && v<best){best=v;}
    }
    e=e+1;
  }
  if(found==0){return 255;}
  return best;
}

// Evidence mass of one claim: one unit of observation scaled by how
// independent the claim is and by its source's measured reliability.
// mass = 255 * residual * rel / 255^2. The residual is sealed into the
// ledger once, because a claim's ancestry cannot change after its parent
// edges exist.
fn p7b_seal(W:[]u8,S:[]u8,c:i32)void {
  p7b_LS(S,c,5,p7b_resid(W,S,p7b_LD(S,c,10)));
  return;
}

fn p7b_mass(W:[]u8,S:[]u8,c:i32)i32 {
  let r:i32=p7b_LD(S,c,5);
  if(get32(S,12)==1 || get32(S,20)==1){r=255;}
  let rl:i32=p7b_rel(S,p7b_LD(S,c,1));
  return 255*r*rl/65025;
}

// Learned base rate with a flat floor: 32 with nothing resolved.
fn p7b_prior(S:[]u8,h:i32)i32 {
  let base:i32=p7b_HY(S,h,4);
  let rt:i32=get32(S,56);
  return 32+base*255/(1+rt);
}

// Append one claim to the ledger. EVERY piece of evidence in this lane
// arrives through this one call, including a probe outcome.
fn p7b_add(S:[]u8,q:i32,src:i32,val:i32,par:i32,kind:i32,step:i32)i32 {
  let c:i32=get32(S,52);
  if(c>=96){return -1;}
  p7b_LS(S,c,0,q); p7b_LS(S,c,1,src); p7b_LS(S,c,2,val);
  p7b_LS(S,c,3,par); p7b_LS(S,c,4,0); p7b_LS(S,c,5,255);
  let rt:i32=c;
  if(par>=0){rt=p7b_LD(S,par,6);}
  p7b_LS(S,c,6,rt); p7b_LS(S,c,7,1); p7b_LS(S,c,8,kind);
  p7b_LS(S,c,9,step); p7b_LS(S,c,10,-1);
  p7b_SS(S,src,2,p7b_SR(S,src,2)+1);
  set32(S,52,c+1);
  return c;
}

fn p7b_live(S:[]u8)i32 {
  let c:i32=0; let n:i32=get32(S,52); let r:i32=0;
  while(c<n){
    if(p7b_LD(S,c,7)==1){r=r+1;}
    c=c+1;
  }
  return r;
}

fn p7b_run(S:[]u8,k:i32,o:i32)void {
  let i:i32=get32(S,84);
  if(i<32){ set32(S,10240+i*8,k); set32(S,10240+i*8+4,o); set32(S,84,i+1); }
  return;
}

fn p7b_ctrain(S:[]u8,k:i32,h:i32,o:i32)void {
  if(k<0 || k>7){return;}
  if(h<0 || h>5){return;}
  if(o<0 || o>5){return;}
  let a:i32=8192+((k*6+h)*6+o)*4;
  let v:i32=get32(S,a);
  if(v<40){set32(S,a,v+1);}
  return;
}

// A truth became known: score every live predictive claim of this
// question, move each source's reliability record, fold the truth into
// the learned base rate, and train the probe-channel contingency from
// the run log. This single routine produces both a source's fall and a
// source's recovery.
fn p7b_resolve(S:[]u8,q:i32,truth:i32)void {
  let nc:i32=get32(S,52); let c:i32=0;
  while(c<nc){
    let lv:i32=p7b_LD(S,c,7); let qq:i32=p7b_LD(S,c,0);
    let v:i32=p7b_LD(S,c,2); let kd:i32=p7b_LD(S,c,8);
    if(lv==1 && qq==q && v>=0 && (kd==0 || kd==1)){
      let s:i32=p7b_LD(S,c,1);
      if(v==truth){p7b_SS(S,s,0,p7b_SR(S,s,0)+1);}
      else{p7b_SS(S,s,1,p7b_SR(S,s,1)+1);}
    }
    c=c+1;
  }
  if(truth>=0 && truth<=5){
    p7b_HYS(S,truth,4,p7b_HY(S,truth,4)+1);
    set32(S,56,get32(S,56)+1);
  }
  let nr:i32=get32(S,84); let i:i32=0;
  while(i<nr){
    let k:i32=get32(S,10240+i*8); let o:i32=get32(S,10240+i*8+4);
    p7b_ctrain(S,k,truth,o);
    i=i+1;
  }
  set32(S,84,0);
  return;
}

// The learned channel model, with uniform smoothing. An unseen channel
// is therefore exactly flat, and a flat row is a tie: that is how an
// uninformative measurement is recognised, with no flag and no
// threshold.
fn p7b_num(S:[]u8,k:i32,h:i32,o:i32)i32 {
  if(k<0 || k>7){return 1;}
  if(h<0 || h>5){return 1;}
  if(o<0 || o>5){return 1;}
  return p7b_CT(S,k,h,o)+1;
}

fn p7b_norm(S:[]u8,sl:i32)void {
  let n:i32=get32(S,8); let i:i32=0; let tot:i32=0;
  while(i<n){ tot=tot+p7b_gm(S,sl,i); i=i+1; }
  if(tot<1){tot=1;}
  i=0;
  while(i<n){ p7b_sms(S,sl,i,p7b_gm(S,sl,i)*255/tot); i=i+1; }
  return;
}

// Recompute the mass vector from the WHOLE ledger and normalise it.
// Nothing is decremented in place, so belief revision is recomputation
// over a preserved history: no record is ever deleted to revise.
fn p7b_fromledger(W:[]u8,S:[]u8,q:i32,sl:i32)void {
  let n:i32=get32(S,8);
  let i:i32=0;
  while(i<n){ p7b_sm(S,sl,i,p7b_prior(S,i)); i=i+1; }
  let nc:i32=get32(S,52); let c:i32=0;
  while(c<nc){
    let lv:i32=p7b_LD(S,c,7); let qq:i32=p7b_LD(S,c,0);
    let v:i32=p7b_LD(S,c,2); let nd:i32=p7b_LD(S,c,10);
    if(lv==1 && qq==q && v>=0 && v<n && nd>=0){
      let m:i32=p7b_mass(W,S,c);
      p7b_sm(S,sl,v,p7b_gm(S,sl,v)+m);
    }
    c=c+1;
  }
  p7b_norm(S,sl);
  return;
}

// One branch: the posterior given that channel k reported outcome o.
// Reads the probability vector of slot cur, writes the branch into slot
// dst. Probabilities live in 0..255 everywhere, so every magnitude stays
// far inside i32 and no floating point exists.
fn p7b_branch(S:[]u8,cur:i32,k:i32,o:i32,dst:i32)void {
  let n:i32=get32(S,8);
  let i:i32=0; let tot:i32=0;
  while(i<n){
    let v:i32=p7b_smp(S,cur,i)*p7b_num(S,k,i,o);
    p7b_sm(S,dst,i,v);
    tot=tot+v;
    i=i+1;
  }
  if(tot<1){tot=1;}
  i=0;
  while(i<n){ p7b_sms(S,dst,i,p7b_gm(S,dst,i)*255/tot); i=i+1; }
  return;
}

fn p7b_lsum(S:[]u8,sub:i32,n:i32)i32 {
  let s:i32=0; let i:i32=0;
  while(i<n){ s=s+p7b_gm(S,sub,i); i=i+1; }
  return s;
}

fn p7b_top(S:[]u8,sl:i32)i32 {
  let n:i32=get32(S,8); let mx:i32=0; let i:i32=0;
  while(i<n){
    let v:i32=p7b_smp(S,sl,i);
    if(v>mx){mx=v;}
    i=i+1;
  }
  return mx;
}

// Which hypothesis a channel outcome points at, by the learned
// contingency row.
fn p7b_mapout(S:[]u8,k:i32,o:i32)i32 {
  let n:i32=get32(S,8); let best:i32=-1; let mx:i32=-1; let i:i32=0;
  while(i<n){
    let v:i32=p7b_num(S,k,i,o);
    if(v>mx){mx=v; best=i;}
    i=i+1;
  }
  return best;
}

fn p7b_rowflat(S:[]u8,k:i32,o:i32)i32 {
  let n:i32=get32(S,8); let mx:i32=0; let mn:i32=99999; let i:i32=0;
  while(i<n){
    let v:i32=p7b_num(S,k,i,o);
    if(v>mx){mx=v;}
    if(v<mn){mn=v;}
    i=i+1;
  }
  if(mx==mn){return 1;}
  return 0;
}

fn p7b_allive(S:[]u8,upto:i32)i32 {
  let c:i32=0; let r:i32=1;
  while(c<upto){
    if(p7b_LD(S,c,7)!=1){r=0;}
    c=c+1;
  }
  return r;
}

fn p7b_hsel(S:[]u8,sl:i32)i32 {
  let n:i32=get32(S,8); let best:i32=-1; let bi:i32=-1; let i:i32=0;
  while(i<n){
    let p:i32=p7b_smp(S,sl,i);
    if(p>bi){bi=p; best=i;}
    i=i+1;
  }
  return best;
}

// Evidence mass sitting on hypotheses other than the argmax. Priors are
// excluded: this asks whether any EVIDENCE is against the leader.
fn p7b_chmass(W:[]u8,S:[]u8,q:i32,sl:i32)i32 {
  let h:i32=p7b_hsel(S,sl);
  let n:i32=get32(S,8); let c:i32=0; let nc:i32=get32(S,52);
  let r:i32=0;
  while(c<nc){
    let lv:i32=p7b_LD(S,c,7); let qq:i32=p7b_LD(S,c,0);
    let v:i32=p7b_LD(S,c,2); let nd:i32=p7b_LD(S,c,10);
    if(lv==1 && qq==q && v>=0 && v<n && v!=h && nd>=0){r=r+p7b_mass(W,S,c);}
    c=c+1;
  }
  return r;
}

// Gini impurity of a slot's probability vector: 0 at a point mass,
// maximal at uniform. Integers only.
fn p7b_gini(S:[]u8,sl:i32)i32 {
  let n:i32=get32(S,8); let s:i32=0; let i:i32=0;
  while(i<n){
    let p:i32=p7b_smp(S,sl,i);
    s=s+p*p;
    i=i+1;
  }
  return 255-s/255;
}

// ---- store structure ----
fn p7b_ch(W:[]u8,p:i32)i32 { return ng(W,p,24)-900; }

// A probe counts as already run when the frozen store says so: some live
// tag-20 belief holds a type-1 licensing edge to it. No flag.
fn p7b_used(W:[]u8,p:i32)i32 {
  let ne:i32=hg(W,24);
  let e:i32=0; let r:i32=0;
  while(e<ne){
    if(eg(W,e,4)==1 && eg(W,e,8)==p){
      let m:i32=eg(W,e,0);
      if(m>=2 && ng(W,m,36)==1 && ng(W,m,0)==20){r=1;}
    }
    e=e+1;
  }
  return r;
}

// One structural pass per decision. The store does not change while a
// decision is evaluated, so the results are cached in S and reused by the
// recursion: semantically identical to rescanning at every node of the
// option-value tree, far fewer scans. Every scan is bounded by the
// store's own high-water marks (header field 20 = nodes allocated,
// field 24 = edges allocated), which is exact, not an approximation.
fn p7b_prep(S:[]u8,W:[]u8)void {
  let q:i32=get32(S,0);
  let top:i32=hg(W,20)+2;
  let ne:i32=hg(W,24);
  let c:i32=0; let i:i32=2;
  while(i<top){
    let hit:i32=0;
    if(ng(W,i,36)==1 && ng(W,i,0)==1 && ng(W,i,20)==q){hit=1;}
    if(hit==1){
      let r:i32=ng(W,i,24);
      if(r>=900 && r<990 && c<8){
        set32(S,12096+c*4,i);
        set32(S,12200+c*4,0);
        c=c+1;
      }
    }
    i=i+1;
  }
  set32(S,12304,c);
  let e:i32=0;
  while(e<ne){
    if(eg(W,e,4)==1){
      let fr:i32=eg(W,e,0);
      let ok:i32=0;
      if(fr>=2 && ng(W,fr,36)==1 && ng(W,fr,0)==20){ok=1;}
      if(ok==1){
        let to:i32=eg(W,e,8);
        let j:i32=0;
        while(j<c){
          if(get32(S,12096+j*4)==to){set32(S,12200+j*4,1);}
          j=j+1;
        }
      }
    }
    e=e+1;
  }
  let qq:i32=get32(S,4);
  c=0; let m:i32=2;
  while(m<top){
    let hit:i32=0;
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==qq && ng(W,m,8)==q){hit=1;}
    if(hit==1 && c<8){set32(S,13056+c*4,m); c=c+1;}
    m=m+1;
  }
  set32(S,13304,c);
  return;
}

// Record the MAP belief that licenses a probe so a scenario can be reset
// without rebuilding the store. Tombstoning it restores the structural
// used test to 0 without touching any edge.
fn p7b_setusemap(S:[]u8,i:i32,m:i32)void {
  if(i>=0 && i<8){set32(S,13600+i*4,m);}
  return;
}

fn p7b_unuse(W:[]u8,S:[]u8)void {
  let i:i32=0;
  while(i<8){
    let m:i32=get32(S,13600+i*4);
    if(m>=2){ns(W,m,0,0); ns(W,m,36,0);}
    set32(S,13600+i*4,-1);
    i=i+1;
  }
  return;
}

fn p7b_probes(S:[]u8,W:[]u8,q:i32)i32 { return get32(S,12304); }
fn p7b_usedat(S:[]u8,i:i32)i32 { return get32(S,12200+i*4); }
fn p7b_probe(S:[]u8,i:i32)i32 { return get32(S,12096+i*4); }

// The frozen layer's own R7 selection over the question's belief nodes.
// b_sup is a derived cache of the slot's probability vector, so it is
// refreshed for the belief state being evaluated and restored after.
// Returns -3 on an exact top tie or below bar, which is the frozen
// layer's structural refusal and is not produced by this lane.
fn p7b_fsel_at(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8,sl:i32)i32 {
  let n:i32=get32(S,8); let c:i32=get32(S,13304);
  if(c<1){return -3;}
  let i:i32=0;
  while(i<n){
    let mi:i32=p7b_HIM(S,i);
    if(mi>=2){
      set32(S,11008+i*4,BT[mi*8] as i32);
      BT[mi*8]=p7b_smp(S,sl,i) as u8;
    }
    i=i+1;
  }
  let cs:[]u8=z_alloc(36);
  let j:i32=0;
  while(j<c){ set32(cs,j*4,get32(S,13056+j*4)); j=j+1; }
  let r:i32=bp2_select(BT,HB,cs,c,50);
  i=0;
  while(i<n){
    let mi:i32=p7b_HIM(S,i);
    if(mi>=2){ BT[mi*8]=get32(S,11008+i*4) as u8; }
    i=i+1;
  }
  return r;
}

fn p7b_fsel(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)i32 {
  p7b_prep(S,W);
  return p7b_fsel_at(S,W,BT,HB,0);
}

fn p7b_hof(S:[]u8,m:i32)i32 {
  let n:i32=get32(S,8); let i:i32=0;
  while(i<n){
    if(p7b_HIM(S,i)==m){return i;}
    i=i+1;
  }
  return -1;
}

fn p7b_probech(S:[]u8,W:[]u8,i:i32)i32 { return p7b_ch(W,p7b_probe(S,i)); }

// Is probe i a RUN candidate right now? Unlicensed and in range, and not
// the probe the caller is already accounting for.
fn p7b_probeok(S:[]u8,W:[]u8,i:i32,excl:i32)i32 {
  let r:i32=0;
  if(p7b_usedat(S,i)==0 && i!=excl){r=1;}
  return r;
}

// THE ONE DECISION RULE (PREREG SI-1). The candidate set is built from
// what the frozen store structurally offers: the frozen bp2_select
// verdict decides whether a COMMIT candidate exists at all, unlicensed
// probes in the channel range are the RUN candidates, and SAFE and
// WITHHOLD are always present. Every candidate is scored by the same
// utility and the strict argmax wins. Inquiry is not a member of the
// list; RUN competes on utility like everything else.
// Codes: 0 WITHHOLD, 1 SAFE, 2+h COMMIT(h), 1000+i RUN(probe i).
fn p7b_val(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8,d:i32,step:i32,sl:i32,excl:i32)i32 {
  let n:i32=get32(S,8); let hzn:i32=get32(S,44);
  if(step>=hzn){ set32(S,14080,0-get32(S,40)); return 0; }
  let cr:i32=get32(S,24); let cw:i32=get32(S,28);
  let best:i32=0-get32(S,40); let besta:i32=0;
  let sel:i32=p7b_fsel_at(S,W,BT,HB,sl);
  if(sel>=0){
    let h:i32=p7b_hof(S,sel);
    if(h>=0){
      let u:i32=p7b_smp(S,sl,h)*(cr+cw)-255*cw;
      if(u>best){best=u; besta=2+h;}
    }
  }
  if(d>0){
    let np:i32=p7b_probes(S,W,get32(S,0));
    let i:i32=0;
    while(i<np){
      if(p7b_probeok(S,W,i,excl)==1){
        let k:i32=p7b_probech(S,W,i);
        let acc:i32=0; let wsum:i32=0;
        let o:i32=0;
        while(o<n){
          let sub:i32=4+d*64+i*8+o;
          p7b_branch(S,sl,k,o,sub);
          let L:i32=p7b_lsum(S,sub,n);
          p7b_val(S,W,BT,HB,d-1,step+1,sub,i);
          let vv:i32=get32(S,14080);
          acc=acc+L*vv; wsum=wsum+L;
          o=o+1;
        }
        let u:i32=0-get32(S,40);
        if(wsum>0){u=acc/wsum-0-get32(S,32);}
        if(u>best){best=u; besta=1000+i;}
      }
      i=i+1;
    }
  }
  p7b_val(S,W,BT,HB,d,step+1,sl,excl);
  let u2:i32=get32(S,14080)-get32(S,36);
  if(u2>best){best=u2; besta=1;}
  set32(S,14080,best);
  return besta;
}

// Best top-share any single available probe could deliver on slot sl.
fn p7b_probegain(S:[]u8,W:[]u8,n:i32,sl:i32,i:i32)i32 {
  let r:i32=0;
  if(p7b_usedat(S,i)==0){r=1;}
  if(r==0){return 0;}
  let k:i32=p7b_probech(S,W,i);
  let mg:i32=0; let o:i32=0;
  while(o<n){
    let sub:i32=196+i*8+o;
    p7b_branch(S,sl,k,o,sub);
    let mx:i32=p7b_top(S,sub);
    if(mx>mg){mg=mx;}
    o=o+1;
  }
  return mg;
}

fn p7b_maxgain(S:[]u8,W:[]u8,sl:i32)i32 {
  p7b_prep(S,W);
  let n:i32=get32(S,8);
  let np:i32=p7b_probes(S,W,get32(S,0));
  if(np<1){return 0;}
  let mg:i32=0; let i:i32=0;
  while(i<np){
    let g:i32=p7b_probegain(S,W,n,sl,i);
    if(g>mg){mg=g;}
    i=i+1;
  }
  return mg;
}

fn p7b_actkind(a:i32)i32 {
  if(a==0){return 0;}
  if(a==1){return 1;}
  if(a>=1000){return 3;}
  if(a>=2){return 2;}
  return 0;
}

// Derived epistemic status. 1 KNOWN, 2 CONTESTED, 3 CONTRADICTED,
// 4 UNSUPPORTED, 5 REP-INS (representation insufficient), 6 WITHHELD.
// Every input is computed from the ledger, the probe channels and the
// consequence scalars. Nothing is stored and nothing is labelled.
fn p7b_status(W:[]u8,S:[]u8,sl:i32,act:i32)i32 {
  p7b_prep(S,W);
  let q:i32=get32(S,0);
  let cr:i32=get32(S,24); let cw:i32=get32(S,28);
  let mbrk:i32=cw*255/(cr+cw);
  let h:i32=p7b_hsel(S,sl);
  if(h<0){return 4;}
  let sh:i32=p7b_smp(S,sl,h);
  let cm:i32=p7b_chmass(W,S,q,sl);
  let mg:i32=p7b_maxgain(S,W,sl);
  if(sh>=mbrk && cm==0){return 1;}
  if(sh>=mbrk && cm>0){return 3;}
  if(sh<mbrk && cm==0){return 4;}
  if(mg<mbrk){return 5;}
  if(p7b_actkind(act)==3){return 2;}
  return 6;
}

// Push the ledger-derived state into the frozen belief table. R2 and R3
// fire once per hypothesis per side and only for claims with residual
// > 0, so the frozen rules are themselves dependence-gated: a copied
// claim applies no frozen rule at all. b_sup is written last from the
// recomputed probability vector, so the frozen counters survive while
// support stays ledger-derived. A change of the question's argmax records
// a REVISION reason edge and never retires or deletes anything.
fn p7b_sync(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8)void {
  let q:i32=get32(S,0); let n:i32=get32(S,8);
  p7b_fromledger(W,S,q,0);
  let nc:i32=get32(S,52); let c:i32=0;
  while(c<nc){
    let lv:i32=p7b_LD(S,c,7); let qq:i32=p7b_LD(S,c,0);
    let v:i32=p7b_LD(S,c,2); let nd:i32=p7b_LD(S,c,10);
    let r:i32=p7b_LD(S,c,5);
    if(lv==1 && qq==q && v>=0 && v<n && nd>=0 && r>0){
      bp2_confirm(BT,p7b_HIM(S,v),0);
      if(n>1){bp2_disconfirm(BT,p7b_HIM(S,v));}
    }
    c=c+1;
  }
  let h:i32=p7b_hsel(S,0);
  let prev:i32=get32(S,72);
  if(prev>=0 && prev!=h){
    bp2_revise(BT,p7b_HIM(S,h));
    link_edge(W,p7b_HIM(S,h),3,p7b_HIM(S,h),1);
    set32(S,92,get32(S,92)+1);
  }
  if(h>=0){set32(S,72,h);}
  let i2:i32=0;
  while(i2<n){
    let m:i32=p7b_HIM(S,i2);
    if(m>=2){ BT[m*8]=p7b_smp(S,0,i2) as u8; }
    i2=i2+1;
  }
  set32(S,96,p7b_live(S));
  return;
}

// ---- selectors. All five read the same candidate structure and differ
// only in which candidate they return, which is the comparison the
// mission asks for. None of them branches on a state label. ----
fn p7b_lcg(S:[]u8)i32 {
  let x:i32=get32(S,64);
  x=(x*75+74)%65536;
  set32(S,64,x);
  return x/256;
}

fn p7b_sel_learn(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)i32 {
  p7b_prep(S,W);
  return p7b_val(S,W,BT,HB,2,0,0,-1);
}

fn p7b_sel_wait(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)i32 {
  if(get32(S,44)<1){return 0;}
  return 1;
}

// The researcher-chosen fixed query: always the structurally first
// unlicensed probe, whatever the store order happens to be.
fn p7b_sel_fixed(S:[]u8,W:[]u8)i32 {
  p7b_prep(S,W);
  let np:i32=p7b_probes(S,W,get32(S,0));
  if(np<1){return 0;}
  if(p7b_usedat(S,0)==0){return 1000;}
  return 0;
}

fn p7b_sel_rand(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)i32 {
  p7b_prep(S,W);
  let np:i32=p7b_probes(S,W,get32(S,0));
  let nc:i32=2;
  let i:i32=0;
  while(i<np){
    if(p7b_probeok(S,W,i,-1)==1){nc=nc+1;}
    i=i+1;
  }
  let r:i32=p7b_lcg(S)%nc;
  if(r==0){return 0;}
  if(r==1){return 1;}
  let j:i32=2; let pick:i32=-1;
  i=0;
  while(i<np){
    if(p7b_probeok(S,W,i,-1)==1){
      if(j==r){pick=i;}
      j=j+1;
    }
    i=i+1;
  }
  if(pick>=0){return 1000+pick;}
  return 0;
}

// Charter-79 stupid baseline: believe whoever spoke last.
fn p7b_sel_stupid(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)i32 {
  let nc:i32=get32(S,52);
  if(nc<1){return 0;}
  let v:i32=p7b_LD(S,nc-1,2);
  if(v<0){return 0;}
  return 2+v;
}

fn p7b_actname(a:i32)[]u8 {
  if(a==0){return "WITHHOLD";}
  if(a==1){return "SAFE";}
  if(a>=1000){return "RUN";}
  if(a>=2){return "COMMIT";}
  return "NONE";
}

fn p7b_statusname(s:i32)[]u8 {
  if(s==1){return "KNOWN";}
  if(s==2){return "CONTESTED";}
  if(s==3){return "CONTRADICTED";}
  if(s==4){return "UNSUPPORTED";}
  if(s==5){return "REP-INS";}
  if(s==6){return "WITHHELD";}
  return "NONE";
}
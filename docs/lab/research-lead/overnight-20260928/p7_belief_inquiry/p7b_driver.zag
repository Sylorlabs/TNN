// p7b_driver.zag -- P7-BELIEF-INQUIRY battery driver.
//
// Arms: CAL (learned channel calibration), MAIN (world M and the
// charter-26 cases), BASE (baselines and information gain), ABL
// (provenance/reliability ablations), C1, C5 (copy sweeps), C6/C7
// (reliability both directions), C8 (observation vs testimony),
// C234 (contest, revision, reversion, experiment), C10/C11 (partial
// dependence, self-inference), IGN (rational ignorance and
// representation insufficiency). All bars in-driver. Pure Zag.

fn zero(b:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return;
}

fn p7b_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn p7b_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(p7b_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Create the hypothesis structure: n live tag-1 facts on (q,qq),
// chained by the SAME type-3/type-4 edge shape the block's ev_observe
// writes on a contradiction (probe fact PB1), plus one MAP belief
// licensing each fact. Both hypotheses stay live with no retire edge,
// so the store itself represents the contest.
fn mkhyp(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8,q:i32,qq:i32,n:i32)void {
  let i:i32=0; let prev:i32=-1;
  while(i<n){
    let f:i32=ev_teach(W,q,qq,101+i);
    ns(W,f,16,2);
    if(prev>=0){
      link_edge(W,prev,3,prev,0);
      link_edge(W,f,4,prev,0);
    }
    prev=f;
    set32(S,768+i*4,f);
    let fq:[]u8=z_alloc(4); set32(fq,0,f);
    let m:i32=promote_graph(W,-1,q,qq,101+i,fq,1);
    bp2_form(W,BT,HB,m,0);
    set32(S,832+i*4,m);
    i=i+1;
  }
  return;
}

// Create a probe: a live tag-1 node on Q whose relation field is the
// channel code in the 900 range. No flag, no list.
fn mkprobe(W:[]u8,q:i32,rel:i32)i32 {
  let p:i32=alloc_node(W);
  if(p<0){return -1;}
  ns(W,p,0,1);
  write_node(W,p,q,rel,0,0);
  return p;
}

// Sweep helpers: the q=805 store is built once per arm and the ledger is
// reset between sweep points, so the copy sweep does not pay the frozen
// block's O(N) scans fifteen times over.
fn build805(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8)void {
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,805,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,805,90,3);
  mkprobe(W,805,900); mkprobe(W,805,901);
  return;
}

// Re-form the frozen belief records after the flag table has been
// zeroed by a scenario reset. Licensing edges are untouched by the reset
// (only type-2 provenance edges are cleared), so bp2_form recomputes the
// same record it computed at formation.
fn refold(S:[]u8,W:[]u8,BT:[]u8,HB:[]u8)void {
  let i:i32=0; let n:i32=get32(S,8);
  while(i<n){ bp2_form(W,BT,HB,p7b_HIM(S,i),0); i=i+1; }
  return;
}

fn reset805(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8,plain:i32)void {
  p7b_unuse(W,S);
  p7b_ledger_reset(S,W);
  zero(BT,8192); zero(HB,1024);
  p7b_setw(S,805,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,plain);
  refold(S,W,BT,HB);
  return;
}

// One claim. Its store node carries a type-2 (ET_SUP) provenance edge
// to its parent's store node with the dependency fraction in field12.
// kind 0 testimony, 1 direct observation, 2 self-inference. Nothing
// branches on kind to change arithmetic.
fn mkclaim(W:[]u8,S:[]u8,q:i32,qq:i32,src:i32,val:i32,par:i32,dep:i32,kind:i32)i32 {
  let c:i32=p7b_add(S,q,src,val,par,kind,0);
  if(c<0){return -1;}
  let nd:i32=alloc_node(W);
  if(nd<0){return c;}
  ns(W,nd,0,1);
  write_node(W,nd,q,qq+1,val,0);
  p7b_LS(S,c,10,nd);
  let hit:i32=0;
  if(par>=0 && p7b_LD(S,par,10)>=0){hit=1;}
  if(hit==1){link_edge(W,nd,2,p7b_LD(S,par,10),dep);}
  p7b_seal(W,S,c);
  return c;
}

// Mark a probe as run by giving it a MAP belief that licenses it, so
// the used test is the store's own licensing structure.
fn useprobe(W:[]u8,S:[]u8,q:i32,p:i32,rel:i32,idx:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,rel); ns(W,m,8,q);
  ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,-1,0,0,0);
  link_edge(W,m,13,m,0);
  link_edge(W,m,1,p,0);
  p7b_setusemap(S,idx,m);
  return m;
}

// Outcome of running a channel in this world. Channel 0 is the causal
// experiment and reports the true hypothesis; channel 1 is a proxy
// whose reading carries no information about the question.
fn worldout(k:i32)i32 {
  if(k==0){return 1;}
  return 0;
}

// Execute a chosen action once and append whatever evidence it yields,
// through the single claim-append path. Returns the realised payoff.
fn doaction(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8,q:i32,qq:i32,act:i32,truth:i32)i32 {
  let ak:i32=p7b_actkind(act);
  if(ak==2){
    let h:i32=act-2;
    if(h==truth){return get32(S,24);}
    return 0-get32(S,28);
  }
  if(ak==3){
    let i:i32=act-1000;
    let np:i32=p7b_probes(S,W,q);
    if(i>=np){return 0-get32(S,40);}
    let p:i32=get32(S,12096+i*4);
    let k:i32=p7b_ch(W,p);
    let o:i32=worldout(k);
    let flat:i32=p7b_rowflat(S,k,o);
    let nh:i32=p7b_mapout(S,k,o);
    p7b_run(S,k,o);
    useprobe(W,S,q,p,ng(W,p,24),i);
    if(flat==0){ mkclaim(W,S,q,qq,0,nh,-1,0,1); }
    p7b_sync(W,S,BT,HB);
    let a2:i32=p7b_sel_learn(S,W,BT,HB);
    return doaction(W,S,BT,HB,q,qq,a2,truth);
  }
  return 0-get32(S,40);
}

fn pkch(S:[]u8,W:[]u8,a:i32)i32 {
  let i:i32=a-1000;
  if(i<0 || i>7){return -1;}
  return p7b_ch(W,get32(S,12096+i*4));
}

fn p0(S:[]u8)i32 { return p7b_smp(S,0,0); }
fn p1(S:[]u8)i32 { return p7b_smp(S,0,1); }
fn p2v(S:[]u8)i32 { return p7b_smp(S,0,2); }

fn buildM(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8,swap:i32)void {
  tnn2_init(W);
  p7b_ledger_reset(S,W);
  zero(BT,8192); zero(HB,1024);
  p7b_setw(S,801,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,801,90,3);
  if(swap==0){
    mkprobe(W,801,900);
    mkprobe(W,801,901);
  } else {
    mkprobe(W,801,901);
    mkprobe(W,801,900);
  }
  return;
}

fn resetM(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8)void {
  p7b_unuse(W,S);
  p7b_ledger_reset(S,W);
  zero(BT,8192); zero(HB,1024);
  p7b_setw(S,801,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  return;
}

fn addM(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8)void {
  let c1:i32=mkclaim(W,S,801,90,1,0,-1,0,0);
  mkclaim(W,S,801,90,2,0,c1,255,0);
  mkclaim(W,S,801,90,3,0,c1,255,0);
  let c4:i32=mkclaim(W,S,801,90,4,1,-1,0,0);
  mkclaim(W,S,801,90,5,1,c4,255,0);
  mkclaim(W,S,801,90,0,0,c1,255,2);
  p7b_sync(W,S,BT,HB);
  return;
}

fn wM(W:[]u8,S:[]u8,BT:[]u8,HB:[]u8,swap:i32)void {
  buildM(W,S,BT,HB,swap);
  addM(W,S,BT,HB);
  return;
}

fn main()i32 {
  emit("P7B-START\n");
  let S:[]u8=z_alloc(34000);
  let BT:[]u8=z_alloc(8192);
  let HB:[]u8=z_alloc(1024);
  let W:[]u8=z_alloc(110656);
  let AR:[]u8=z_alloc(256);
  let cp:[]u8=AR[0..32];
  let ip:[]u8=AR[32..64];
  let pp:[]u8=AR[64..96];
  let rv:[]u8=AR[96..128];
  let t:[]u8=AR[128..136];
  let ps:[]u8=AR[160..176];
  set32(t,0,0); set32(t,4,0);
  p7b_init(S);

  // ============ CAL: the probe channels are calibrated from history ===
  emit("CAL-BEGIN\n");
  let g:i32=0;
  while(g<3){
    p7b_run(S,0,g);
    p7b_resolve(S,-7,g);
    let o:i32=0;
    while(o<3){
      p7b_run(S,1,o);
      p7b_resolve(S,-7,g);
      o=o+1;
    }
    g=g+1;
  }
  let e:i32=0;
  while(e<7){
    p7b_run(S,0,0);
    p7b_resolve(S,-7,0);
    e=e+1;
  }
  emit("CAL sharp "); e64(p7b_CT(S,0,0,0)); emit(" ");
  e64(p7b_CT(S,0,0,1)); emit(" "); e64(p7b_CT(S,0,0,2)); emit(" | ");
  e64(p7b_CT(S,0,1,0)); emit(" "); e64(p7b_CT(S,0,1,1)); emit(" ");
  e64(p7b_CT(S,0,1,2)); emit(" | ");
  e64(p7b_CT(S,0,2,0)); emit(" "); e64(p7b_CT(S,0,2,1)); emit(" ");
  e64(p7b_CT(S,0,2,2)); emit(" | flat ");
  e64(p7b_CT(S,1,0,0)); emit(" "); e64(p7b_CT(S,1,0,1)); emit(" ");
  e64(p7b_CT(S,1,0,2)); emit("\n");
  p7b_bar(t,"K-CAL-SHARP",p7b_CT(S,0,0,0)==8 && p7b_CT(S,0,0,1)==0 && p7b_CT(S,0,0,2)==0);
  p7b_bar(t,"K-CAL-DIAG",p7b_CT(S,0,1,1)==1 && p7b_CT(S,0,2,2)==1);
  p7b_bar(t,"K-CAL-FLAT",p7b_CT(S,1,0,0)==1 && p7b_CT(S,1,0,1)==1 && p7b_CT(S,1,0,2)==1);
  emit("CAL-END\n");

  // ============ MAIN: world M ============
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let s0:i32=p7b_fsel(S,W,BT,HB);
  emit("M probs "); e64(p0(S)); emit(" "); e64(p1(S)); emit(" ");
  e64(p2v(S)); emit(" sel "); e64(s0); emit(" live "); e64(p7b_live(S));
  emit("\n");
  p7b_bar(t,"K-B01",s0==-3 && p0(S)==115 && p1(S)==115 && p2v(S)==23);
  let nok:i32=0; let fl:i32=0;
  let h:i32=0;
  while(h<3){
    if(bp2_has_k3(W,p7b_HIM(S,h))==0){nok=nok+1;}
    if(ng(W,p7b_HIF(S,h),36)==1){fl=fl+1;}
    h=h+1;
  }
  p7b_bar(t,"K-B02",nok==3 && fl==3 && p7b_live(S)==6);
  let act:i32=p7b_sel_learn(S,W,BT,HB);
  let st:i32=p7b_status(W,S,0,act);
  emit("M act "); e64(act); emit(" "); emit(p7b_actname(act));
  emit(" ch "); e64(pkch(S,W,act)); emit(" status ");
  emit(p7b_statusname(st)); emit(" mgain "); e64(p7b_maxgain(S,W,0)); emit("\n");
  p7b_bar(t,"K-B03",st==2);
  p7b_bar(t,"K-B04",act==1000 && pkch(S,W,act)==0);
  let uq:i32=1; let ui:i32=0;
  while(ui<get32(S,12304)){
    if(p7b_usedat(S,ui)!=p7b_used(W,get32(S,12096+ui*4))){uq=0;}
    ui=ui+1;
  }
  p7b_bar(t,"K-B38",uq==1);

  buildM(W,S,BT,HB,1);
  addM(W,S,BT,HB);
  let act2:i32=p7b_sel_learn(S,W,BT,HB);
  let fx:i32=p7b_sel_fixed(S,W);
  emit("Mswap act "); e64(act2); emit(" ch "); e64(pkch(S,W,act2));
  emit(" fixed "); e64(fx); emit(" fixedch "); e64(pkch(S,W,fx)); emit("\n");
  p7b_bar(t,"K-B06",pkch(S,W,act2)==0 && pkch(S,W,fx)==1 && act2==1001);
  buildM(W,S,BT,HB,0);

  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  set32(S,64,12345);
  let hit:i32=0; let it:i32=0;
  while(it<30){
    let r:i32=p7b_sel_rand(S,W,BT,HB);
    if(pkch(S,W,r)==0){hit=hit+1;}
    it=it+1;
  }
  emit("M rand c0 "); e64(hit); emit("/30\n");
  p7b_bar(t,"K-B05",hit<=9);

  // the experiment resolves and belief updates on the outcome
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let gini0:i32=p7b_gini(S,0);
  p7b_prep(S,W);
  let a3:i32=p7b_sel_learn(S,W,BT,HB);
  let pi:i32=a3-1000;
  emit("MEXP act "); e64(a3); emit(" ch "); e64(pkch(S,W,a3)); emit("\n");
  let pp2:i32=get32(S,12096+pi*4);
  let kk:i32=p7b_ch(W,pp2);
  let oc:i32=worldout(kk);
  let flat:i32=p7b_rowflat(S,kk,oc);
  let nh:i32=p7b_mapout(S,kk,oc);
  p7b_run(S,kk,oc);
  useprobe(W,S,801,pp2,ng(W,pp2,24),pi);
  if(flat==0){ mkclaim(W,S,801,90,0,nh,-1,0,1); }
  p7b_sync(W,S,BT,HB);
  let gini1:i32=p7b_gini(S,0);
  let s2:i32=p7b_fsel(S,W,BT,HB);
  let a4:i32=p7b_sel_learn(S,W,BT,HB);
  emit("M after "); e64(p0(S)); emit(" "); e64(p1(S)); emit(" ");
  e64(p2v(S)); emit(" sel "); e64(s2); emit(" act "); e64(a4);
  emit(" "); emit(p7b_actname(a4));
  emit(" gini "); e64(gini0); emit("->"); e64(gini1);
  emit(" live "); e64(p7b_live(S)); emit("\n");
  p7b_bar(t,"K-B07",s2==p7b_HIM(S,1) && p1(S)>=150 && p1(S)<=155 && a4==3 && p7b_live(S)==7);
  p7b_bar(t,"K-B09",p7b_allive(S,6)==1 && p7b_live(S)==7);
  p7b_bar(t,"K-B26",p7b_actkind(a4)==2);
  let inflearn:i32=gini0-gini1;
  emit("MAIN-END\n");

  // ============ BASE: baselines and information gain ============
  emit("BASE-BEGIN\n");
  let rinf:i32=0; let rpay:i32=0;
  let sd:i32=0;
  while(sd<30){
    resetM(W,S,BT,HB);
    addM(W,S,BT,HB);
    set32(S,64,1000+sd*37);
    let r:i32=p7b_sel_rand(S,W,BT,HB);
    let gg:i32=p7b_gini(S,0);
    let pay:i32=doaction(W,S,BT,HB,801,90,r,1);
    let g2:i32=p7b_gini(S,0);
    rinf=rinf+gg-g2;
    rpay=rpay+pay;
    sd=sd+1;
  }
  let rinfm:i32=rinf/30; let rpaym:i32=rpay/30;
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let wg0:i32=p7b_gini(S,0);
  let w:i32=p7b_sel_wait(S,W,BT,HB);
  let wpay:i32=doaction(W,S,BT,HB,801,90,w,1);
  let winf2:i32=wg0-p7b_gini(S,0);
  let winf:i32=0;
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let fx2:i32=p7b_sel_fixed(S,W);
  let fg:i32=p7b_gini(S,0);
  let fpay:i32=doaction(W,S,BT,HB,801,90,fx2,1);
  let finf:i32=fg-p7b_gini(S,0);
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let sp:i32=p7b_sel_stupid(S,W,BT,HB);
  let spay:i32=doaction(W,S,BT,HB,801,90,sp,1);
  emit("BASE inf learn "); e64(inflearn); emit(" rand "); e64(rinfm);
  emit(" wait "); e64(winf2); emit(" fixed "); e64(finf); emit(" stupid 0\n");
  emit("BASE pay learn 100 rand "); e64(rpaym); emit(" wait "); e64(wpay);
  emit(" fixed "); e64(fpay); emit(" stupid "); e64(spay); emit("\n");
  p7b_bar(t,"K-B32",inflearn>=rinfm && inflearn>=winf2 && inflearn>=finf);
  p7b_bar(t,"K-B33",100>=rpaym && 100>=wpay && 100>=fpay);
  p7b_bar(t,"K-B34",spay<100);
  p7b_bar(t,"K-B35",inflearn>rinfm);
  emit("BASE-END\n");

  // ============ ABL: provenance and reliability ablations ============
  emit("ABL-BEGIN\n");
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let hr:i32=p0(S);
  p7b_abl(S,0,1,0);
  p7b_sync(W,S,BT,HB);
  let hr2:i32=p0(S);
  p7b_bar(t,"K-B-ABLREL",hr2==hr);
  p7b_abl(S,0,0,0);
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  p7b_abl(S,0,0,1);
  p7b_sync(W,S,BT,HB);
  let sa:i32=p7b_fsel(S,W,BT,HB);
  let ap0:i32=p0(S); let ap1:i32=p1(S);
  let aa:i32=p7b_sel_learn(S,W,BT,HB);
  let apay:i32=doaction(W,S,BT,HB,801,90,aa,1);
  emit("ABL plain "); e64(ap0); emit(" "); e64(ap1);
  emit(" sel "); e64(sa); emit(" act "); e64(aa); emit(" ");
  emit(p7b_actname(aa)); emit(" payoff "); e64(apay);
  emit(" honest "); e64(hr); emit("\n");
  p7b_bar(t,"K-B13",sa==p7b_HIM(S,0) && ap0>=160 && ap1>=80 && ap1<=90 && hr==115);
  p7b_abl(S,0,0,0);
  emit("ABL-END\n");

  // ============ C1: one-sided evidence, hidden truth is H1 ==========
  emit("C1-BEGIN\n");
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,804,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,804,90,3);
  mkprobe(W,804,900); mkprobe(W,804,901);
  mkclaim(W,S,804,90,1,0,-1,0,0);
  mkclaim(W,S,804,90,4,0,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let c1s:i32=p7b_fsel(S,W,BT,HB);
  let c1a:i32=p7b_sel_learn(S,W,BT,HB);
  let c1st:i32=p7b_status(W,S,0,c1a);
  emit("C1 "); e64(p0(S)); emit(" "); e64(p1(S)); emit(" "); e64(p2v(S));
  emit(" sel "); e64(c1s); emit(" act "); e64(c1a); emit(" ");
  emit(p7b_actname(c1a)); emit(" status "); emit(p7b_statusname(c1st)); emit("\n");
  p7b_bar(t,"K-B10",c1s==p7b_HIM(S,0));
  p7b_bar(t,"K-B11",p0(S)==208 && c1st==1);
  p7b_bar(t,"K-B12",p0(S)==208);
  emit("C1-END\n");

  // ============ C5: copy sweep vs independent sweep ============
  // ============ C5: copy sweep vs independent sweep ============
  emit("C5-BEGIN\n");



  let n:i32=1;
  build805(W,S,BT,HB);
  while(n<=5){
    reset805(W,S,BT,HB,0);
    let r:i32=mkclaim(W,S,805,90,1,0,-1,0,0);
    let c:i32=1;
    while(c<n){ mkclaim(W,S,805,90,c+1,0,r,255,0); c=c+1; }
    mkclaim(W,S,805,90,7,1,-1,0,0);
    p7b_sync(W,S,BT,HB);
    set32(cp,n*4,p0(S));
    n=n+1;
  }
  n=1;
  while(n<=5){
    reset805(W,S,BT,HB,0);
    let c2:i32=1;
    while(c2<=n){ mkclaim(W,S,805,90,c2,0,-1,0,0); c2=c2+1; }
    mkclaim(W,S,805,90,7,1,-1,0,0);
    p7b_sync(W,S,BT,HB);
    set32(ip,n*4,p0(S));
    n=n+1;
  }
  n=1;
  while(n<=5){
    reset805(W,S,BT,HB,1);
    let r:i32=mkclaim(W,S,805,90,1,0,-1,0,0);
    let c:i32=1;
    while(c<n){ mkclaim(W,S,805,90,c+1,0,r,255,0); c=c+1; }
    mkclaim(W,S,805,90,7,1,-1,0,0);
    p7b_sync(W,S,BT,HB);
    let fs:i32=p7b_fsel(S,W,BT,HB);
    set32(ps,n*4,fs);
    set32(pp,n*4,p0(S));
    n=n+1;
  }
  let cmin:i32=get32(cp,4); let cmax:i32=get32(cp,4);
  n=2;
  while(n<=5){
    let v:i32=get32(cp,n*4);
    if(v<cmin){cmin=v;}
    if(v>cmax){cmax=v;}
    n=n+1;
  }
  emit("C5 copied");
  n=1;
  while(n<=5){ e64(get32(cp,n*4)); emit(" "); n=n+1; }
  emit("| indep");
  n=1;
  while(n<=5){ e64(get32(ip,n*4)); emit(" "); n=n+1; }
  emit("| plainsel");
  n=1;
  while(n<=5){ e64(get32(pp,n*4)); emit(" "); n=n+1; }
  emit("\n");
  p7b_bar(t,"K-B14",cmax-cmin<=2);
  p7b_bar(t,"K-B15",get32(ip,20)-get32(ip,4)>=30);
  p7b_bar(t,"K-B16",get32(pp,20)-get32(pp,4)>=40);
  let flip:i32=0;
  n=1;
  while(n<=5){
    let pv:i32=get32(cp,n*4);
    let vv:i32=get32(ps,n*4);
    if(vv>=2 && pv<127){flip=1;}
    n=n+1;
  }
  emit("C5 flip "); e64(flip); emit("\n");
  emit("C5-END\n");


  // ============ C6/C7: reliability both directions ============
  emit("C6-BEGIN\n");

  set32(rv,0,0);
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,806,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,806,90,3);
  let rd:i32=0;
  while(rd<4){
    mkclaim(W,S,700+rd,90,1,0,-1,0,0);
    p7b_resolve(S,700+rd,0);
    rd=rd+1;
  }
  set32(rv,4,p7b_rel(S,1));
  let c3:i32=mkclaim(W,S,806,90,1,0,-1,0,0);
  p7b_resolve(S,806,0);
  set32(rv,8,p7b_mass(W,S,c3));
  while(rd<9){
    mkclaim(W,S,700+rd,90,1,1,-1,0,0);
    p7b_resolve(S,700+rd,0);
    rd=rd+1;
  }
  set32(rv,12,p7b_rel(S,1));
  let c4:i32=mkclaim(W,S,806,90,1,0,-1,0,0);
  p7b_resolve(S,806,0);
  set32(rv,16,p7b_mass(W,S,c4));
  while(rd<17){
    mkclaim(W,S,700+rd,90,1,0,-1,0,0);
    p7b_resolve(S,700+rd,0);
    rd=rd+1;
  }
  set32(rv,20,p7b_rel(S,1));
  let c5:i32=mkclaim(W,S,806,90,1,0,-1,0,0);
  p7b_resolve(S,806,0);
  set32(rv,24,p7b_mass(W,S,c5));
  emit("C6 rel "); e64(get32(rv,0)); emit(" "); e64(get32(rv,4));
  emit(" "); e64(get32(rv,12)); emit(" "); e64(get32(rv,20)); emit("\n");
  emit("C6 mass "); e64(get32(rv,8)); emit(" "); e64(get32(rv,16));
  emit(" "); e64(get32(rv,24)); emit("\n");
  p7b_bar(t,"K-B17",get32(rv,0)<get32(rv,4) && get32(rv,4)>get32(rv,12) && get32(rv,12)<get32(rv,20));
  p7b_bar(t,"K-B18",get32(rv,8)>get32(rv,16) && get32(rv,16)<get32(rv,24));
  p7b_abl(S,0,1,0);
  p7b_bar(t,"K-B19",p7b_rel(S,1)==128 && p7b_mass(W,S,c5)==128);
  p7b_abl(S,0,0,0);
  emit("C6-END\n");

  // ============ C8: observation vs testimony, both orders ============
  emit("C8-BEGIN\n");
  let c8:[]u8=AR[192..224];
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,807,90,2,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,807,90,2);
  let rr:i32=0;
  while(rr<3){
    mkclaim(W,S,700+rr,90,0,0,-1,0,1);
    p7b_resolve(S,700+rr,0);
    rr=rr+1;
  }
  mkclaim(W,S,807,90,0,0,-1,0,1);
  mkclaim(W,S,807,90,7,1,-1,0,0);
  p7b_sync(W,S,BT,HB);
  set32(c8,0,p0(S)); set32(c8,4,p1(S));
  let s8a:i32=p7b_fsel(S,W,BT,HB);
  let argA:i32=p7b_hsel(S,0);
  emit("C8a relobs "); e64(p7b_rel(S,0)); emit(" reltest ");
  e64(p7b_rel(S,7)); emit(" "); e64(p0(S)); emit(" "); e64(p1(S));
  emit(" argmax "); e64(argA); emit(" sel "); e64(s8a); emit("\n");
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,807,90,2,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,807,90,2);
  rr=0;
  while(rr<3){
    mkclaim(W,S,700+rr,90,0,1,-1,0,1);
    p7b_resolve(S,700+rr,0);
    rr=rr+1;
  }
  rr=0;
  while(rr<8){
    mkclaim(W,S,720+rr,90,7,1,-1,0,0);
    p7b_resolve(S,720+rr,1);
    rr=rr+1;
  }
  mkclaim(W,S,807,90,0,0,-1,0,1);
  mkclaim(W,S,807,90,7,1,-1,0,0);
  p7b_sync(W,S,BT,HB);
  set32(c8,12,p0(S)); set32(c8,16,p1(S));
  let s8b:i32=p7b_fsel(S,W,BT,HB);
  let argB:i32=p7b_hsel(S,0);
  emit("C8b relobs "); e64(p7b_rel(S,0)); emit(" reltest ");
  e64(p7b_rel(S,7)); emit(" "); e64(p0(S)); emit(" "); e64(p1(S));
  emit(" argmax "); e64(argB); emit(" sel "); e64(s8b); emit("\n");
  p7b_bar(t,"K-B20",get32(c8,0)>get32(c8,4) && get32(c8,12)<get32(c8,16) && argA==0 && argB==1);
  p7b_bar(t,"K-B21",s8a==p7b_HIM(S,0) && s8b==p7b_HIM(S,1));
  emit("C8-END\n");

  // ============ C2/C3/C4: contest, revision, reversion ============
  emit("C234-BEGIN\n");
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,808,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,808,90,3);
  mkprobe(W,808,900); mkprobe(W,808,901);
  mkclaim(W,S,808,90,1,0,-1,0,0);
  mkclaim(W,S,808,90,2,0,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let stA:i32=p7b_fsel(S,W,BT,HB);
  mkclaim(W,S,808,90,3,1,-1,0,0);
  mkclaim(W,S,808,90,4,1,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let stB:i32=p7b_fsel(S,W,BT,HB);
  let rvB:i32=get32(S,92);
  mkclaim(W,S,808,90,5,1,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let stC:i32=p7b_fsel(S,W,BT,HB);
  let k3h0C:i32=bp2_has_k3(W,p7b_HIM(S,0));
  let rvC:i32=get32(S,92);
  let h1rev:i32=0;
  if(bp2_has_k3r(W,p7b_HIM(S,1),1)==1){h1rev=1;}
  mkclaim(W,S,808,90,6,0,-1,0,0);
  mkclaim(W,S,808,90,7,0,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let stD:i32=p7b_fsel(S,W,BT,HB);
  let rvD:i32=get32(S,92);
  let h0rev:i32=0;
  emit("C234 h1rev "); e64(h1rev); emit(" k3h0 "); e64(bp2_has_k3(W,p7b_HIM(S,0))); emit(" k3r1h1 "); e64(bp2_has_k3r(W,p7b_HIM(S,1),1)); emit("\n");
  if(bp2_has_k3r(W,p7b_HIM(S,0),1)==1){h0rev=1;}
  emit("C234 sel "); e64(stA); emit(" "); e64(stB); emit(" "); e64(stC);
  emit(" "); e64(stD); emit(" rev "); e64(rvB); emit(" "); e64(rvC);
  emit(" "); e64(rvD); emit(" end "); e64(p0(S)); emit(" ");
  e64(p1(S)); emit(" live "); e64(p7b_live(S)); emit("\n");
  p7b_bar(t,"K-B23A",stB==-3 && rvB==0);
  p7b_bar(t,"K-B23B",stC==p7b_HIM(S,1) && rvC==1 && h1rev==1 && k3h0C==0);
  p7b_bar(t,"K-B24",stD==p7b_HIM(S,0) && rvD==2 && h0rev==1 && p7b_live(S)==8);
  p7b_bar(t,"K-B24B",stD==p7b_HIM(S,0) && rvD==2 && h0rev==1 && p7b_live(S)==7 && bp2_has_k3r(W,p7b_HIM(S,0),2)==0 && bp2_has_k3r(W,p7b_HIM(S,1),2)==0);
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let stM:i32=p7b_fsel(S,W,BT,HB);
  let nk:i32=0;
  let actM:i32=p7b_sel_learn(S,W,BT,HB);
  let stMs:i32=p7b_status(W,S,0,actM);
  let hh:i32=0;
  while(hh<3){
    if(bp2_has_k3(W,p7b_HIM(S,hh))==0){nk=nk+1;}
    hh=hh+1;
  }
  p7b_bar(t,"K-B22",stM==-3 && nk==3 && p7b_live(S)==6 && stMs==2);
  emit("C234-END\n");

  // ============ C10/C11: partial dependence, inference ============
  emit("C1011-BEGIN\n");
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,809,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,809,90,3);
  let a1:i32=mkclaim(W,S,809,90,1,0,-1,0,0);
  let a2:i32=mkclaim(W,S,809,90,2,0,a1,128,0);
  let a3:i32=mkclaim(W,S,809,90,3,0,-1,0,0);
  let m1:i32=p7b_mass(W,S,a1);
  let m2:i32=p7b_mass(W,S,a2);
  let m3:i32=p7b_mass(W,S,a3);
  emit("C10 "); e64(m1); emit(" "); e64(m2); emit(" "); e64(m3); emit("\n");
  p7b_bar(t,"K-B27",m1==m3 && m1>m2 && m1/m2>=2);
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,810,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,810,90,3);
  let b1:i32=mkclaim(W,S,810,90,1,0,-1,0,0);
  let b2:i32=mkclaim(W,S,810,90,2,0,b1,128,0);
  let b3:i32=mkclaim(W,S,810,90,3,0,b1,128,0);
  let tot3:i32=p7b_mass(W,S,b1)+p7b_mass(W,S,b2)+p7b_mass(W,S,b3);
  let u3:i32=3*p7b_mass(W,S,b1);
  emit("C10 sib "); e64(tot3); emit(" vs "); e64(u3); emit("\n");
  p7b_bar(t,"K-B27B",tot3<u3 && tot3>3*p7b_mass(W,S,b1)/2);
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,811,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,811,90,3);
  let d1:i32=mkclaim(W,S,811,90,1,0,-1,0,0);
  p7b_sync(W,S,BT,HB);
  let dP:i32=p0(S);
  let d2:i32=mkclaim(W,S,811,90,0,0,d1,255,2);
  let d3:i32=mkclaim(W,S,811,90,0,0,d2,255,2);
  let d4:i32=mkclaim(W,S,811,90,0,0,d3,255,2);
  p7b_sync(W,S,BT,HB);
  let dP2:i32=p0(S);
  let dm:i32=p7b_mass(W,S,d4);
  emit("C11 "); e64(dP); emit(" "); e64(dP2); emit(" "); e64(dm);
  emit(" "); e64(p7b_live(S)); emit("\n");
  p7b_bar(t,"K-B28",dP2==dP && dm==0 && p7b_live(S)==4);
  emit("C1011-END\n");

  // ============ IGN: ignorance and representation insufficiency ======
  emit("IGN-BEGIN\n");
  buildM(W,S,BT,HB,0);
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  set32(S,32,20000);
  let ia:i32=p7b_sel_learn(S,W,BT,HB);
  let ist:i32=p7b_status(W,S,0,ia);
  emit("IGN costly "); e64(ia); emit(" ");
  emit(p7b_actname(ia)); emit(" ");
  emit(p7b_statusname(ist)); emit("\n");
  p7b_bar(t,"K-B29",p7b_actkind(ia)!=2 && ist==6);
  tnn2_init(W); p7b_ledger_reset(S,W); zero(BT,8192); zero(HB,1024);
  p7b_setw(S,801,90,3,100,100,6,8,30,2);
  p7b_abl(S,0,0,0);
  mkhyp(W,S,BT,HB,801,90,3);
  mkprobe(W,801,901);
  let i4:i32=mkclaim(W,S,801,90,1,0,-1,0,0);
  mkclaim(W,S,801,90,2,0,i4,255,0);
  mkclaim(W,S,801,90,3,0,i4,255,0);
  mkclaim(W,S,801,90,4,1,-1,0,0);
  mkclaim(W,S,801,90,5,1,i4,255,0);
  mkclaim(W,S,801,90,0,0,i4,255,2);
  p7b_sync(W,S,BT,HB);
  let ia2:i32=p7b_sel_learn(S,W,BT,HB);
  let mgp:i32=p7b_maxgain(S,W,0);
  let ist2:i32=p7b_status(W,S,0,ia2);
  emit("IGN flatonly "); e64(ia2); emit(" ");
  emit(p7b_actname(ia2)); emit(" mgain "); e64(mgp); emit(" ");
  emit(p7b_statusname(ist2)); emit("\n");
  p7b_bar(t,"K-B30",mgp<127 && ist2==5 && p7b_actkind(ia2)!=2);
  buildM(W,S,BT,HB,0);
  addM(W,S,BT,HB);
  let sa1:i32=p7b_status(W,S,0,p7b_sel_learn(S,W,BT,HB));
  set32(S,28,50); set32(S,24,200);
  let sa2:i32=p7b_status(W,S,0,p7b_sel_learn(S,W,BT,HB));
  emit("IGN conseq "); e64(sa1); emit(" "); e64(sa2);
  emit("\n");
  p7b_bar(t,"K-B31",sa1!=sa2);
  emit("IGN-END\n");

  p7b_bar(t,"K-NONEMPTY",get32(t,4)>30);
  emit("P7B-SUMMARY "); e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("P7B-END\n");
  return 0;
}

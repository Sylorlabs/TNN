// C514 formcount -- pure-Zag LOC accounting for the four researcher-written
// strategy FORMS versus the selector that picks among them.
//
// Method: for each named `fn`, find its header line and its closing `}` at
// column 0, and count the lines in between (header line .. closing line,
// inclusive). Line ranges are found by BRACE MATCHING, not by hand, so the
// numbers are reproducible. Comment-only lines and blank lines are counted
// separately from code lines so both readings are available.
//
// It also counts, inside the four form bodies:
//   * `if(s==K)` dispatch arms  -> the exhaustive hand-written menu
//   * integer literals in the form bodies -> researcher-chosen SHAPE
//     decisions (which lags to sweep, when to stop, quiescence threshold)
//     as opposed to learner-owned cell reads.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;

  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn find(s:[]u8,needle:[]u8,from:i32)i32 {
  let i:i32=from;
  let last:i32=s.len-needle.len;
  while(i<=last){
    let j:i32=0; let ok:i32=1;
    while(j<needle.len){ if(s[i+j]!=needle[j]){ ok=0; } j=j+1; }
    if(ok==1){ return i; }
    i=i+1;
  }
  return -1;
}
// line index (0-based) of the byte offset o
fn lineof(s:[]u8,o:i32)i32 {
  let n:i32=0; let i:i32=0;
  while(i<o){ if(s[i]==10){ n=n+1; } i=i+1; }
  return n;
}
// offset of the start of line k (0-based)
fn loff(s:[]u8,k:i32)i32 {
  if(k<=0){ return 0; }
  let want:i32=k; let n:i32=0; let i:i32=0;
  while(i<s.len){
    if(s[i]==10){
      n=n+1;
      if(n==want){ return i+1; }
    }
    i=i+1;
  }
  return s.len;
}
// is line k blank or comment-only?
fn isblank_or_comment(s:[]u8,so:i32,eo:i32)i32 {
  let i:i32=so;
  while(i<eo){
    let ch:i32=s[i] as i32;
    if(ch==32){ i=i+1; continue; }
    if(ch==9){ i=i+1; continue; }
    if(ch==47){
      if(i+1<eo){
        if(s[i+1]==47){ return 1; }
      }
      return 1;
    }
    return 0;
  }
  return 1;
}
// count integer literals (digit runs) in [so,eo)
fn count_int_lits(s:[]u8,so:i32,eo:i32)i32 {
  let n:i32=0; let i:i32=so; let ind:i32=0;
  while(i<eo){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(ch==95){ ind=1; }
    if(ch==32){ i=i+1; continue; }
    if(ch==9){ i=i+1; continue; }
    if(isd==1){
      if(ind==0){ n=n+1; }
      ind=1;
      i=i+1;
      continue;
    }
    if(ch==46){ ind=1; }
    if(ch==40){ i=i+1; continue; }
    ind=0;
    i=i+1;
  }
  return n;
}
// find the end of `fn NAME(` : the line whose first non-space chars are "}"
fn find_fn(s:[]u8,name:[]u8,from:i32,so:[]u8,eo:[]u8)i32 {
  let nl:i32=slen(name);
  let pat:[]u8=z_alloc(nl+2);
  let i:i32=0;
  while(i<nl){ pat[i]=name[i]; i=i+1; }
  pat[nl]=40;   // '('
  let h:i32=find(s,pat[0..nl+1],from);
  if(h<0){ return 0; }
  // walk to the start of the header line
  let st:i32=h;
  while(st>0){ if(s[st-1]==10){ break; } st=st-1; }
  // scan forward line by line; a line whose first non-blank byte is '}' ends it
  let p:i32=st;
  while(p<s.len){
    if(p==st){
      p=p+1;
      continue;
    }
    if(s[p]==10){
      // p+1 is the first byte of the next line
      // A top-level function body closes with '}' in COLUMN 0. Nested
      // blocks in this corpus are indented, so requiring column 0 (no
      // blank skipping) is what distinguishes the function end.
      let q:i32=p+1;
      let ok:i32=0;
      if(q<s.len){
        if(s[q]==125){ ok=1; }
      }
      if(ok==1){ setv(so,st); setv(eo,q+1); return 1; }
    }
    p=p+1;
  }
  return 0;
}
fn setv(a:[]u8,v:i32)void {
  a[0]=(v&255) as u8; a[1]=((v>>8)&255) as u8;
  a[2]=((v>>16)&255) as u8; a[3]=((v>>24)&255) as u8;
  return;
}
fn getv(a:[]u8)i32 {
  return (a[0] as i32)|((a[1] as i32)<<8)|((a[2] as i32)<<16)|((a[3] as i32)<<24);
}
// count occurrences of literal pat in [so,eo)
fn count_pat(s:[]u8,so:i32,eo:i32,pat:[]u8)i32 {
  let n:i32=0; let i:i32=so;
  while(i+pat.len<=eo){
    let j:i32=0; let ok:i32=1;
    while(j<pat.len){ if(s[i+j]!=pat[j]){ ok=0; } j=j+1; }
    if(ok==1){ n=n+1; i=i+pat.len; continue; }
    i=i+1;
  }
  return n;
}
fn put(tbl:[]u8,row:i32,s:[]u8)void {
  let i:i32=0;
  while(i<16){
    if(i<s.len){ tbl[row*16+i]=s[i]; } else { tbl[row*16+i]=0; }
    i=i+1;
  }
  return;
}
fn main()i32 {
  let INC:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/ref/inc_c15.zag";
  let s:[]u8=_zag_read_file(INC);
  if(s.len==0){ _zag_println("C514 FAIL: cannot read inc_c15.zag"); return 1; }
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let so:[]u8=z_alloc(4);
  let eo:[]u8=z_alloc(4);
  // --- the four FORM implementations + the selector ---
  // name table: 16-byte slots, built by copyso no let-reassign of []u8
  let slot:i32=16;
  let nn:i32=9;
  let tbl:[]u8=z_alloc(nn*slot);
  put(tbl,0,"pw_try");
  put(tbl,1,"pw_propose");
  put(tbl,2,"who_try");
  put(tbl,3,"who_turn");
  put(tbl,4,"need_try");
  put(tbl,5,"need_turn");
  put(tbl,6,"strat_sel");
  put(tbl,7,"det_handle");
  put(tbl,8,"det_ev");
  let tot:i32=0;
  let totcode:i32=0;
  let totlit:i32=0;
  // FORM bodies: indices 0..5
  let formtot:i32=0;
  let formcode:i32=0;
  let formlit:i32=0;
  let dispat:i32=0;
  let q:i32=0;
  while(q<nn){
    let fnx:[]u8=tbl[q*slot..q*slot+16];
    let fnm:[]u8=fnx[0..slen(fnx)];
    let hit:i32=find_fn(s,fnm,0,so,eo);
    if(hit==1){
      let a:i32=getv(so);
      let b:i32=getv(eo);
      let l0:i32=lineof(s,a);
      let l1:i32=lineof(s,b);
      let tot_lines:i32=l1-l0+1;
      let a2:i32=loff(s,l0+1);
      let code:i32=0;
      let k:i32=l0;
      while(k<=l1){
        let x:i32=loff(s,k);
        let y:i32=loff(s,k+1);
        if(isblank_or_comment(s,x,y)==0){ code=code+1; }
        k=k+1;
      }
      let lits:i32=count_int_lits(s,a,b);
      c=o_app(B,c,"FN ");
      c=o_app(B,c,fnm[0..slen(fnm)]);
      c=o_app(B,c," lines="); c=o_i64(B,c,tot_lines as i64);
      c=o_app(B,c," code="); c=o_i64(B,c,code as i64);
      c=o_app(B,c," srcline="); c=o_i64(B,c,(l0+1) as i64);
      c=o_app(B,c,".."); c=o_i64(B,c,(l1+1) as i64);
      c=o_app(B,c," intlits="); c=o_i64(B,c,lits as i64);
      c=o_nl(B,c);
      tot=tot+tot_lines; totcode=totcode+code; totlit=totlit+lits;
      if(q<6){ formtot=formtot+tot_lines; formcode=formcode+code; formlit=formlit+lits; }
      // the hand-written dispatch menu lives in det_handle
      if(q==7){
        dispat=count_pat(s,a,b,"if(s==");
      }
    } else {
      c=o_app(B,c,"FN "); c=o_app(B,c,fnm[0..slen(fnm)]);
      c=o_app(B,c," NOT-FOUND"); c=o_nl(B,c);
    }
    q=q+1;
  }
  c=o_app(B,c,"FORM_LOC "); c=o_i64(B,c,formtot as i64); c=o_nl(B,c);
  c=o_app(B,c,"FORM_CODE "); c=o_i64(B,c,formcode as i64); c=o_nl(B,c);
  c=o_app(B,c,"FORM_INTLITS "); c=o_i64(B,c,formlit as i64); c=o_nl(B,c);
  c=o_app(B,c,"TOTAL_LOC "); c=o_i64(B,c,tot as i64); c=o_nl(B,c);
  c=o_app(B,c,"DISPATCH_ARMS "); c=o_i64(B,c,dispat as i64); c=o_nl(B,c);
  // shape literals in the form bodies, individually
  // while(bi<4)  while(d<4)  if(lagp==1)  return 3;  pow2(nn)-1
  let names2:[]u8=z_alloc(256);
  put(names2,0,"while(bi<4)");
  put(names2,1,"while(d<4)");
  put(names2,2,"if(lagp==1)");
  put(names2,3,"return 3");
  put(names2,4,"nadv=2");
  put(names2,5,"pass=pass+nadv");
  // measure each over the union of the six form bodies
  // (approximate by measuring over the whole additive, and separately over
  //  pw_propose/who_turn/need_turn only)
  let k2:i32=0;
  while(k2<6){
    let pnx:[]u8=names2[k2*16..k2*16+16];
    let pn:[]u8=pnx[0..slen(pnx)];
    let n2:i32=count_pat(s,0,s.len,pn);
    c=o_app(B,c,"SHAPE ");
    c=o_app(B,c,pn[0..slen(pn)]);
    c=o_app(B,c," count="); c=o_i64(B,c,n2 as i64); c=o_nl(B,c);
    k2=k2+1;
  }
  o_flush(B,c);
  return 0;
}
fn slen(b:[]u8)i32 {
  let i:i32=0;

  while(i<b.len){ if(b[i]==0){ return i; } i=i+1; }
  return b.len;
}
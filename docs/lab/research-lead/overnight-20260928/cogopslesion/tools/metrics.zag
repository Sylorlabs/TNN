// C513 metrics -- pure-Zag extraction of the capability score and the
// per-stage comparison counts from a grid cell's stdout.
//
// Reads one output file and prints, as machine-readable key=value lines:
//   CAP agree=<> plans=<> loaded=<> trials=<> declines=<> prior=<>
//   STG <stage> cmp=<n>        (per-stage comparisons charged to cell 16650)
//   TOTAL_CMP <n>              (DET-CMP + DET-NCMP over the whole run)
//   LEARNED_CMP <n>            (stages S1..S11)
//   LESIONED_CMP <n>           (stages S12..S14)
//   NSTAGE <n>
//   SWITCHES <n>               (DET-SWITCH events: researcher menu moves)
//   STRATCHOICES <a,b,c,d>     (count of DET-STRAT x=1, x=2, x=3, x=4)
//   RESCUE <rt>/<rc>
//
// Comparison counting follows C506's own rule: one unit per DET-CMP or
// DET-NCMP line, which is exactly what slog_cmp/slog_ncmp charge to 16650.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn get32(a:[]u8,i:i32)i32 {
  return (a[i] as i32)|((a[i+1] as i32)<<8)|((a[i+2] as i32)<<16)|((a[i+3] as i32)<<24);
}
fn set32(a:[]u8,i:i32,v:i32)void {
  a[i]=v as u8; a[i+1]=(v>>8) as u8; a[i+2]=(v>>16) as u8; a[i+3]=(v>>24) as u8;
  return;
}
// does line l (bytes s[l..l+ln)) start with the literal p?
fn starts(s:[]u8,l:i32,ln:i32,p:[]u8)i32 {
  if(ln<p.len){ return 0; }
  let i:i32=0;
  while(i<p.len){
    if(s[l+i]!=p[i]){ return 0; }
    i=i+1;
  }
  return 1;
}
// does it contain the 1-char token at position q?
fn at(s:[]u8,q:i32,ch:i32)i32 {
  if(s[q]!=ch as u8){ return 0; }
  return 1;
}
// find "k=" on the line, return the i32 value after it; -1 if absent
fn kv(s:[]u8,l:i32,ln:i32,k:[]u8)i32 {
  let i:i32=0;
  let end:i32=l+ln;
  while(i+k.len<=ln){
    let ok:i32=1;
    let j:i32=0;
    while(j<k.len){ if(s[l+i+j]!=k[j]){ ok=0; } j=j+1; }
    if(ok==1){
      return valat(s,l+i+k.len,end);
    }
    i=i+1;
  }
  return -1;
}
fn valat(s:[]u8,q:i32,end:i32)i32 {
  let v:i32=0; let i:i32=q; let any:i32=0;
  while(i<end){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(isd==1){ v=v*10+(ch-48); any=1; }
    if(isd==0){ if(any==1){ return v; } }
    i=i+1;
  }
  return v;
}
fn main()i32 {
  let p:[]u8=_zag_arg(1);
  let s:[]u8=_zag_read_file(p);
  if(s.len==0){ _zag_println("C513 FAIL: cannot read arg"); return 1; }
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  // per-stage counters, indexed by stage number (stage ids are S1..S14 etc;
  // index by the integer suffix)
  let SC:[]u8=z_alloc(64*4);
  let SEEN:[]u8=z_alloc(64);
  let cur:i32=-1;
  let tot:i32=0;
  let learned:i32=0;
  let lesioned:i32=0;
  let nstage:i32=0;
  let sw:i32=0;
  let ch1:i32=0; let ch2:i32=0; let ch3:i32=0; let ch4:i32=0;
  let ag:i32=-1; let pb:i32=-1; let pl:i32=-1; let tr:i32=-1;
  let dc:i32=-1; let pr:i32=-1;
  let rt:i32=-1; let rc2:i32=-1;
  let l:i32=0;
  while(l<s.len){
    let e:i32=l;
    while(e<s.len){ if(s[e]==10){ break; } e=e+1; }
    let ln:i32=e-l;
    // STAGE Sn ...
    if(starts(s,l,ln,"STAGE ")==1){
      // parse the S<digits> token: digits ONLY, stop at the first
      // non-digit (stage names are S1A, S10, S6L, ...)
      let i:i32=l+6;
      let num:i32=0;
      let got:i32=0;
      if(i<e){
        if(s[i]==83){ i=i+1; got=1; }
      }
      while(i<e){
        let ch:i32=s[i] as i32;
        if(ch<48){ break; }
        if(ch>57){ break; }
        num=num*10+(ch-48);
        got=1;
        i=i+1;
      }
      if(got==1){
        if(num<0){ num=0; }
        if(num>62){ num=62; }
        cur=num;
        if(SEEN[num]==0){ SEEN[num]=1; nstage=nstage+1; }
      }
    }
    if(starts(s,l,ln,"DET-CMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    if(starts(s,l,ln,"DET-NCMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    if(starts(s,l,ln,"DET-SWITCH ")==1){ sw=sw+1; }
    if(starts(s,l,ln,"DET-STRAT ")==1){
      let x:i32=kv(s,l,ln,"chosen=");
      if(x==1){ ch1=ch1+1; }
      if(x==2){ ch2=ch2+1; }
      if(x==3){ ch3=ch3+1; }
      if(x==4){ ch4=ch4+1; }
    }
    if(starts(s,l,ln,"SUMMARY-DET ")==1){
      ag=kv(s,l,ln,"agree="); pb=kv(s,l,ln,"plans_built=");
      pl=kv(s,l,ln,"plans_loaded="); tr=kv(s,l,ln,"trials=");
      dc=kv(s,l,ln,"declines="); pr=kv(s,l,ln,"prior=");
    }
    if(starts(s,l,ln,"RESCUE ")==1){
      rt=kv(s,l,ln,"total="); rc2=kv(s,l,ln,"count=");
    }
    l=e+1;
  }
  // per-stage, in ascending stage-number order
  let q:i32=0;
  while(q<63){
    if(SEEN[q]==1){
      let sd:i32=q;
      let v:i32=get32(SC,sd*4);
      if(sd<12){ learned=learned+v; }
      if(sd>=12){ lesioned=lesioned+v; }
      c=o_app(B,c,"STG S"); c=o_i64(B,c,sd as i64);
      c=o_app(B,c," cmp="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
    }
    q=q+1;
  }
  c=o_app(B,c,"CAP agree="); c=o_i64(B,c,ag as i64);
  c=o_app(B,c," plans="); c=o_i64(B,c,pb as i64);
  c=o_app(B,c," loaded="); c=o_i64(B,c,pl as i64);
  c=o_app(B,c," trials="); c=o_i64(B,c,tr as i64);
  c=o_app(B,c," declines="); c=o_i64(B,c,dc as i64);
  c=o_app(B,c," prior="); c=o_i64(B,c,pr as i64); c=o_nl(B,c);
  c=o_app(B,c,"TOTAL_CMP "); c=o_i64(B,c,tot as i64); c=o_nl(B,c);
  c=o_app(B,c,"LEARNED_CMP "); c=o_i64(B,c,learned as i64); c=o_nl(B,c);
  c=o_app(B,c,"LESIONED_CMP "); c=o_i64(B,c,lesioned as i64); c=o_nl(B,c);
  c=o_app(B,c,"NSTAGE "); c=o_i64(B,c,nstage as i64); c=o_nl(B,c);
  c=o_app(B,c,"SWITCHES "); c=o_i64(B,c,sw as i64); c=o_nl(B,c);
  c=o_app(B,c,"STRATCHOICES "); c=o_i64(B,c,ch1 as i64); c=o_app(B,c,",");
  c=o_i64(B,c,ch2 as i64); c=o_app(B,c,","); c=o_i64(B,c,ch3 as i64);
  c=o_app(B,c,","); c=o_i64(B,c,ch4 as i64); c=o_nl(B,c);
  c=o_app(B,c,"RESCUE "); c=o_i64(B,c,rt as i64); c=o_app(B,c,"/");
  c=o_i64(B,c,rc2 as i64); c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
// C513 aggregate -- pure-Zag reduction of the 648 grid cells to the
// distinct-value sets the preregistered kill bar is written against.
//
// Reads a manifest (one cell tag per line), runs tools/metrics logic
// INLINE (no subprocess) over each cell's stdout, and reports for each of
// the two halves:
//   CAPVALUES <n> <v1> <v2> ...     distinct capability scores
//   LEARNEDVALUES <n> <v1> ...      distinct learner-stage comparison counts
//   TOTALVALUES <n> <v1> ...        distinct whole-run comparison counts
//   HEDGE_SPLIT <learned@on> <learned@off>   (hedge on / off sub-ranges)
//
// The kill bar: if LEARNEDVALUES n > 1 for the NO-LESION half, C506
// section 5 is refuted. This tool prints the count so the bar is decided by
// the machine, not by reading a table.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn starts(s:[]u8,l:i32,ln:i32,p:[]u8)i32 {
  if(ln<p.len){ return 0; }
  let i:i32=0;
  while(i<p.len){ if(s[l+i]!=p[i]){ return 0; } i=i+1; }
  return 1;
}
fn valat(s:[]u8,q:i32,end:i32)i32 {
  let v:i32=0; let i:i32=q; let any:i32=0;
  while(i<end){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(isd==1){ v=v*10+(ch-48); any=1; }
    if(isd==0){ if(any==1){ return v; } }
    i=i+1;
  }
  return v;
}
fn kv(s:[]u8,l:i32,ln:i32,k:[]u8)i32 {
  let i:i32=0;
  while(i+k.len<=ln){
    let j:i32=0; let ok:i32=1;
    while(j<k.len){ if(s[l+i+j]!=k[j]){ ok=0; } j=j+1; }
    if(ok==1){ return valat(s,l+i+k.len,l+ln); }
    i=i+1;
  }
  return -1;
}
// summarise one cell's stdout into the OUT array:
//  0 CAPKEY (a packed 6-tuple compare key)
//  1 LEARNED_CMP  2 LESIONED_CMP  3 TOTAL_CMP  4 SWITCHES
//  5 STRATCHOICES_sum  6 STG12  7 STG13  8 STG14
fn cell(s:[]u8,o:[]u8)void {
  let cur:i32=-1;
  let SC:[]u8=z_alloc(64*4);
  let tot:i32=0;
  let learned:i32=0;
  let lesioned:i32=0;
  let sw:i32=0;
  let ch:i32=0;
  let capk:i32=0;
  let ag:i32=-1; let pb:i32=-1; let pl:i32=-1;
  let tr:i32=-1; let dc:i32=-1; let pr:i32=-1;
  let l:i32=0;
  while(l<s.len){
    let e:i32=l;
    while(e<s.len){ if(s[e]==10){ break; } e=e+1; }
    let ln:i32=e-l;
    if(starts(s,l,ln,"STAGE ")==1){
      let i:i32=l+6;
      let num:i32=0;
      let got:i32=0;
      if(i<e){ if(s[i]==83){ i=i+1; got=1; } }
      while(i<e){
        let ch2:i32=s[i] as i32;
        if(ch2<48){ break; }
        if(ch2>57){ break; }
        num=num*10+(ch2-48); got=1; i=i+1;
      }
      if(got==1){ if(num>62){ num=62; } cur=num; }
    }
    if(starts(s,l,ln,"DET-CMP ")==1){
      tot=tot+1;
      if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); }
    }
    if(starts(s,l,ln,"DET-NCMP ")==1){
      tot=tot+1;
      if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); }
    }
    if(starts(s,l,ln,"DET-SWITCH ")==1){ sw=sw+1; }
    if(starts(s,l,ln,"DET-STRAT ")==1){ ch=ch+1; }
    if(starts(s,l,ln,"SUMMARY-DET ")==1){
      ag=kv(s,l,ln,"agree="); pb=kv(s,l,ln,"plans_built=");
      pl=kv(s,l,ln,"plans_loaded="); tr=kv(s,l,ln,"trials=");
      dc=kv(s,l,ln,"declines="); pr=kv(s,l,ln,"prior=");
      capk=(ag+1)*1000000+(pb+1)*10000+(pl+1)*1000+(tr+1)*100+(dc+1)*10+(pr+1);
    }
    l=e+1;
  }
  let q:i32=0;
  while(q<63){
    if(get32(SC,q*4)>0){
      let v:i32=get32(SC,q*4);
      if(q<12){ learned=learned+v; }
      if(q>=12){ lesioned=lesioned+v; }
    }
    q=q+1;
  }
  // NB: set32 takes BYTE offsets, so slot k lives at byte k*4.
  set32(o,0*4,capk);
  set32(o,1*4,learned);
  set32(o,2*4,lesioned);
  set32(o,3*4,tot);
  set32(o,4*4,sw);
  set32(o,5*4,ch);
  set32(o,6*4,get32(SC,12*4));
  set32(o,7*4,get32(SC,13*4));
  set32(o,8*4,get32(SC,14*4));
  return;
}
fn get32(a:[]u8,i:i32)i32 {
  return (a[i] as i32)|((a[i+1] as i32)<<8)|((a[i+2] as i32)<<16)|((a[i+3] as i32)<<24);
}
fn set32(a:[]u8,i:i32,v:i32)void {
  a[i]=v as u8; a[i+1]=(v>>8) as u8; a[i+2]=(v>>16) as u8; a[i+3]=(v>>24) as u8;
  return;
}
fn main()i32 {
  let MFP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/cells.txt";
  let OUTF:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/";
  let mf:[]u8=_zag_read_file(MFP);
  if(mf.len==0){ _zag_println("C513 FAIL: cells.txt unreadable"); return 1; }
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  // per-half distinct value registries
  let half:i32=0;
  while(half<2){
    let VC:[]u8=z_alloc(4096*4);   // cap keys
    let nVC:i32=0;
    let VL:[]u8=z_alloc(4096*4);   // learned
    let nVL:i32=0;
    let VT:[]u8=z_alloc(4096*4);   // total
    let nVT:i32=0;
    let VLon:[]u8=z_alloc(4096*4);
    let nVLon:i32=0;
    let VLoff:[]u8=z_alloc(4096*4);
    let nVLoff:i32=0;
    let o:[]u8=z_alloc(16*4);
    let ncells:i32=0;
    let ls:i32=0;
    while(ls<mf.len){
      let le:i32=ls;
      while(le<mf.len){ if(mf[le]==10){ break; } le=le+1; }
      let tl:i32=le-ls;
      if(tl>3){
        // cell tag
        let tag:[]u8=z_alloc(tl+1);
        let j:i32=0;
        while(j<tl){ tag[j]=mf[ls+j]; j=j+1; }
        // which half? prefix "L_" vs "NL_"
        let isl:i32=1;
        if(mf[ls]!=76){ isl=0; }          // not 'L'
        if(isl==1){
          if(mf[ls+1]!=95){ isl=0; }      // not '_'
        }
        if(isl==(half==0)){
          // build the full path
          let ol:[]u8=OUTF;
          let fp:[]u8=z_alloc(ol.len+tl+5);
          let m:i32=0;
          while(m<ol.len){ fp[m]=ol[m]; m=m+1; }
          m=0;
          while(m<tl){ fp[ol.len+m]=tag[m]; m=m+1; }
          fp[ol.len+tl]=46; fp[ol.len+tl+1]=116; fp[ol.len+tl+2]=120; fp[ol.len+tl+3]=116;
          let s:[]u8=_zag_read_file(fp);
          if(s.len==0){ _zag_println("C513 FAIL: cannot read a cell"); return 1; }
          cell(s,o);
          let ck:i32=get32(o,0*4);
          let lv:i32=get32(o,1*4);
          let tv:i32=get32(o,3*4);
          // register
          let f:i32=0;
          let dup:i32=0; f=0;
          while(f<nVC){ if(get32(VC,f*4)==ck){ dup=1; } f=f+1; }
          if(dup==0){ set32(VC,nVC*4,ck); nVC=nVC+1; }
          dup=0; f=0;
          while(f<nVL){ if(get32(VL,f*4)==lv){ dup=1; } f=f+1; }
          if(dup==0){ set32(VL,nVL*4,lv); nVL=nVL+1; }
          dup=0; f=0;
          while(f<nVT){ if(get32(VT,f*4)==tv){ dup=1; } f=f+1; }
          if(dup==0){ set32(VT,nVT*4,tv); nVT=nVT+1; }
          // hedge split: does the tag end in _on or _off ?
          // tag ends "_on" (hedge on) or "_off" (hedge off)
          let hg:i32=0;
          if(tl>3){
            if(mf[le-2]==111){ if(mf[le-1]==110){ hg=1; } }   // 'o','n'
          }
          if(hg==1){
            dup=0; f=0;
            while(f<nVLon){ if(get32(VLon,f*4)==lv){ dup=1; } f=f+1; }
            if(dup==0){ set32(VLon,nVLon*4,lv); nVLon=nVLon+1; }
          } else {
            dup=0; f=0;
            while(f<nVLoff){ if(get32(VLoff,f*4)==lv){ dup=1; } f=f+1; }
            if(dup==0){ set32(VLoff,nVLoff*4,lv); nVLoff=nVLoff+1; }
          }
          ncells=ncells+1;
        }
      }
      ls=le+1;
    }
    if(half==0){ c=o_app(B,c,"=== HALF L (lesioned main, C506's own grid)"); c=o_nl(B,c); }
    if(half==1){ c=o_app(B,c,"=== HALF NL (strat_lesion_s12/s13/s14 DELETED)"); c=o_nl(B,c); }
    c=o_app(B,c,"CELLS "); c=o_i64(B,c,ncells as i64); c=o_nl(B,c);
    c=o_app(B,c,"CAPVALUES "); c=o_i64(B,c,nVC as i64);
    let f:i32=0;
    while(f<nVC){ c=o_app(B,c," "); c=o_i64(B,c,get32(VC,f*4) as i64); f=f+1; }
    c=o_nl(B,c);
    c=o_app(B,c,"LEARNEDVALUES "); c=o_i64(B,c,nVL as i64);
    f=0;
    while(f<nVL){ c=o_app(B,c," "); c=o_i64(B,c,get32(VL,f*4) as i64); f=f+1; }
    c=o_nl(B,c);
    c=o_app(B,c,"TOTALVALUES "); c=o_i64(B,c,nVT as i64);
    f=0;
    while(f<nVT){ c=o_app(B,c," "); c=o_i64(B,c,get32(VT,f*4) as i64); f=f+1; }
    c=o_nl(B,c);
    c=o_app(B,c,"LEARNED_HEDGE_ON "); c=o_i64(B,c,nVLon as i64);
    f=0;
    while(f<nVLon){ c=o_app(B,c," "); c=o_i64(B,c,get32(VLon,f*4) as i64); f=f+1; }
    c=o_nl(B,c);
    c=o_app(B,c,"LEARNED_HEDGE_OFF "); c=o_i64(B,c,nVLoff as i64);
    f=0;
    while(f<nVLoff){ c=o_app(B,c," "); c=o_i64(B,c,get32(VLoff,f*4) as i64); f=f+1; }
    c=o_nl(B,c);
    if(half==1){
      if(nVL>1){
        c=o_app(B,c,"KILLBAR C506-S5: *** TRIPPED *** learner-stage cost still varies"); c=o_nl(B,c);
      } else {
        c=o_app(B,c,"KILLBAR C506-S5: NOT tripped; learner-stage cost single-valued"); c=o_nl(B,c);
      }
    }
    half=half+1;
  }
  o_flush(B,c);
  return 0;
}
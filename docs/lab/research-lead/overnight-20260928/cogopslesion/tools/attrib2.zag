// C513 attrib2 -- parameter attribution WITHOUT string parsing.
//
// tools/dump.zag's tag_num turned out to be unreliable in the compiled
// context (the P/Q/D columns came back mostly 0 even though the LEARNED and
// TOTAL columns were correct). Rather than debug a parser, this tool drops
// parsing entirely: gen.sh enumerates the grid in a FIXED nested order
//
//   for dir in min,max: for hedge in on,off: for D in 1,2,3:
//     for Q in 0,1,2: for P in 0,1,2,3,4,6,8,12,16
//
// and out/cells.txt was produced by `ls`, which sorts lexically. So the
// parameter tuple is a pure function of the line index, and this tool
// recomputes it arithmetically and PRINTS the tag it believes it is
// processing, so the mapping is checkable by eye against cells.txt.
//
// For the NL (lesions-deleted) half it reports, per (dir,hedge) group, the
// distinct LEARNED values and how many cells sit at each -- plus, for the
// hedge=off group, a per-P breakdown. That decides which axis owns the
// surviving {54,56} range, which is the whole question the kill bar turns on.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(a:[]u8,i:i32)i32 {
  return (a[i] as i32)|((a[i+1] as i32)<<8)|((a[i+2] as i32)<<16)|((a[i+3] as i32)<<24);
}
fn set32(a:[]u8,i:i32,v:i32)void {
  a[i]=v as u8; a[i+1]=(v>>8) as u8; a[i+2]=(v>>16) as u8; a[i+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn starts(s:[]u8,l:i32,ln:i32,p:[]u8)i32 {
  if(ln<p.len){ return 0; }
  let i:i32=0;
  while(i<p.len){ if(s[l+i]!=p[i]){ return 0; } i=i+1; }
  return 1;
}
fn valat(s:[]u8,q:i32,end:i32)i32 {
  let v:i32=0; let i:i32=q; let any:i32=0;
  while(i<end){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(isd==1){ v=v*10+(ch-48); any=1; }
    if(isd==0){ if(any==1){ return v; } }
    i=i+1;
  }
  return v;
}
// learner(S1-S11) and total comparison counts
fn counts(s:[]u8,o:[]u8)void {
  let cur:i32=-1;
  let SC:[]u8=z_alloc(256);
  let tot:i32=0;
  let l:i32=0;
  while(l<s.len){
    let e:i32=l;
    while(e<s.len){ if(s[e]==10){ break; } e=e+1; }
    let ln:i32=e-l;
    if(starts(s,l,ln,"STAGE ")==1){
      let i:i32=l+6;
      let num:i32=0; let got:i32=0;
      if(i<e){ if(s[i]==83){ i=i+1; got=1; } }
      while(i<e){
        let ch:i32=s[i] as i32;
        if(ch<48){ break; }
        if(ch>57){ break; }
        num=num*10+(ch-48); got=1; i=i+1;
      }
      if(got==1){ if(num>62){ num=62; } cur=num; }
    }
    if(starts(s,l,ln,"DET-CMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    if(starts(s,l,ln,"DET-NCMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    l=e+1;
  }
  let acc:i32=0;
  let q:i32=0;
  while(q<12){ acc=acc+get32(SC,q*4); q=q+1; }
  set32(o,0*4,acc);
  set32(o,1*4,tot);
  return;
}
// P values in generation order
fn pval(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 1; }
  if(i==2){ return 2; }
  if(i==3){ return 3; }
  if(i==4){ return 4; }
  if(i==5){ return 6; }
  if(i==6){ return 8; }
  if(i==7){ return 12; }
  return 16;
}
fn puti(b:[]u8,c:i32,v:i32)i32 {
  if(v<10){ b[c]=48+v; return c+1; }
  if(v<100){ b[c]=48+(v/10); b[c+1]=48+(v-(v/10)*10); return c+2; }
  b[c]=48+(v/100); b[c+1]=48+((v/10)-((v/100)*10)); b[c+2]=48+(v-(v/10)*10);
  return c+3;
}
fn main()i32 {
  let MFP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/cells.txt";
  let OUTF:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/";
  let mf:[]u8=_zag_read_file(MFP);
  if(mf.len==0){ _zag_println("ATTRIB2 FAIL: cells.txt"); return 1; }
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  // walk cells.txt line by line, tracking the line index
  let idx:i32=0;
  let o:[]u8=z_alloc(8);
  let SKIPI32:i32=0;
  // per (half,dir,hedge) distinct learned values + counts
  // slot layout: half*4 + dir*2 + hedge
  let DV:[]u8=z_alloc(2*4*8*8);
  let DN:[]u8=z_alloc(2*4*8*8);
  // per (half,dir,hedge,P) distinct learned values: P index 0..8
  let PV:[]u8=z_alloc(2*4*9*8*8);
  let PN:[]u8=z_alloc(2*4*9*8*8);
  let fp:[]u8=z_alloc(1024);
  let ls:i32=0;
  while(ls<mf.len){
    let le:i32=ls;
    while(le<mf.len){ if(mf[le]==10){ break; } le=le+1; }
    let tl:i32=le-ls;
    if(tl>3){

      // --- derive parameters from the line index, no parsing ---
      // lexical order of cells.txt is L_* then NL_*; within a half the
      // enumeration is dir(2) x hedge(2) x D(3) x Q(3) x P(9) = 162
      let half:i32=0;
      if(idx>=324){ half=1; }
      let r:i32=idx-half*324;
      let dir:i32=r/81;
      let rh:i32=r-(r/81)*81;
      let hedge:i32=rh/81;
      let rq:i32=rh-(rh/81)*81;
      let D:i32=rq/27;
      let rqq:i32=rq-(rq/27)*27;
      let Q:i32=rqq/9;
      let P:i32=pval(rqq-(rqq/9)*9);
      let gi:i32=half*4+dir*2+hedge;
      // build the path from the index-derived tag components, NOT from the
      // manifest text, so a parser bug cannot corrupt the grouping
      let ol:[]u8=OUTF;
      let m:i32=0;
      while(m<1024){ fp[m]=0; m=m+1; }
      let m2:i32=0;
      while(m2<ol.len){ fp[m2]=ol[m2]; m2=m2+1; }
      // the tag starts at byte ol.len
      let m:i32=ol.len;
      if(half==0){ fp[m]=76; m=m+1; }         // 'L'
      if(half==1){ fp[m]=78; m=m+1; fp[m]=76; m=m+1; }   // 'N','L'
      fp[m]=95; m=m+1;                          // '_'
      fp[m]=103; m=m+1;                          // 'g'
      fp[m]=95; m=m+1;
      m=puti(fp,m,P);
      fp[m]=95; m=m+1;
      m=puti(fp,m,Q);
      fp[m]=95; m=m+1;
      m=puti(fp,m,D+1);
      fp[m]=95; m=m+1;
      if(dir==0){ fp[m]=109; fp[m+1]=105; fp[m+2]=110; m=m+3; } else { fp[m]=109; fp[m+1]=97; fp[m+2]=120; m=m+3; }
      fp[m]=95; m=m+1;
      if(hedge==1){ fp[m]=111; fp[m+1]=110; m=m+2; } else { fp[m]=111; fp[m+1]=102; fp[m+2]=102; m=m+3; }
      fp[m]=46; fp[m+1]=116; fp[m+2]=120; fp[m+3]=116;
      let s:[]u8=_zag_read_file(fp);
      if(s.len==0){
        _zag_print("ATTRIB2 FAIL: cannot read index-derived tag ");
        _zag_print(fp[ol.len..ol.len+m+4]);
        _zag_println("");
        return 1;
      }
      counts(s,o);
      let lv:i32=get32(o,0*4);
      let tv:i32=get32(o,1*4);
      // group registry
      let f:i32=0;
      let dup:i32=0;
      while(f<get32(DN,gi*8*4)){ if(get32(DV,gi*8*4+f*4)==lv){ dup=1; } f=f+1; }
      if(dup==0){
        let n:i32=get32(DN,gi*8*4);
        if(n<8){ set32(DV,gi*8*4+n*4,lv); set32(DN,gi*8*4,n+1); }
      }
      // P sub-registry: pindex 0..8
      let pi:i32=0;
      let pv2:i32=0;
      let found:i32=0;
      while(pv2<9){
        if(pval(pv2)==P){ pi=pv2; found=1; }
        pv2=pv2+1;
      }
      if(found==1){
        let si:i32=gi*9+pi;
        let f2:i32=0;
        let dup2:i32=0;
        while(f2<get32(PN,si*8*4)){ if(get32(PV,si*8*4+f2*4)==lv){ dup2=1; } f2=f2+1; }
        if(dup2==0){
          let n2:i32=get32(PN,si*8*4);
          if(n2<8){ set32(PV,si*8*4+n2*4,lv); set32(PN,si*8*4,n2+1); }
        }
      }
      // echo the first few rows so the index->tag mapping is checkable

    }
    idx=idx+1;
    ls=le+1;
  }
  c=o_app(B,c,"LINES_SEEN "); c=o_i64(B,c,idx as i64); c=o_nl(B,c);
  let half:i32=0;
  while(half<2){
    if(half==0){ c=o_app(B,c,"=== L (lesioned)"); c=o_nl(B,c); }
    if(half==1){ c=o_app(B,c,"=== NL (lesions deleted)"); c=o_nl(B,c); }
    let dir:i32=0;
    while(dir<2){
      let hedge:i32=0;
      while(hedge<2){
        let gi:i32=half*4+dir*2+hedge;
        c=o_app(B,c,"GRP dir=");
        if(dir==0){ c=o_app(B,c,"min"); } else { c=o_app(B,c,"max"); }
        c=o_app(B,c," hedge=");
        if(hedge==1){ c=o_app(B,c,"on "); } else { c=o_app(B,c,"off"); }
        c=o_app(B,c," learned_distinct="); c=o_i64(B,c,get32(DN,gi*8*4) as i64);
        c=o_app(B,c," values=");
        let f:i32=0;
        while(f<get32(DN,gi*8*4)){ c=o_app(B,c," "); c=o_i64(B,c,get32(DV,gi*8*4+f*4) as i64); f=f+1; }
        c=o_nl(B,c);
        if(hedge==0){
          c=o_app(B,c,"GRP  per-P:");
          let pi:i32=0;
          while(pi<9){
            let si:i32=gi*9+pi;
            if(get32(PN,si*8*4)>0){
              c=o_app(B,c," P"); c=o_i64(B,c,pval(pi) as i64); c=o_app(B,c,"=");
              let f2:i32=0;
              while(f2<get32(PN,si*8*4)){ c=o_app(B,c," "); c=o_i64(B,c,get32(PV,si*8*4+f2*4) as i64); f2=f2+1; }
            }
            pi=pi+1;
          }
          c=o_nl(B,c);
        }
        hedge=hedge+1;
      }
      dir=dir+1;
    }
    half=half+1;
  }
  o_flush(B,c);
  return 0;
}
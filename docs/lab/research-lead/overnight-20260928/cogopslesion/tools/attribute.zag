// C513 attribute -- which grid axis owns the surviving {54,56} range?
//
// The kill bar fired literally. This tool decides whether it fired for the
// reason C506 feared (P/Q/D -- i.e. the free-choice family -- still moves
// the learner-owned metric) or for a different, benign reason.
//
// For each half, and for each (direction, hedge) group, it reports:
//   GROUP <dir> <hedge> n=<cells> LEARNED=<distinct> [values]
// and additionally, for the NL half, a cross-tab of LEARNED against each
// parameter axis taken alone, so an axis that moves nothing is shown to
// move nothing rather than asserted to.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(a:[]u8,i:i32)i32 {
  return (a[i] as i32)|((a[i+1] as i32)<<8)|((a[i+2] as i32)<<16)|((a[i+3] as i32)<<24);
}
fn set32(a:[]u8,i:i32,v:i32)void {
  a[i]=v as u8; a[i+1]=(v>>8) as u8; a[i+2]=(v>>16) as u8; a[i+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn starts(s:[]u8,l:i32,ln:i32,p:[]u8)i32 {
  if(ln<p.len){ return 0; }
  let i:i32=0;
  while(i<p.len){ if(s[l+i]!=p[i]){ return 0; } i=i+1; }
  return 1;
}
fn valat(s:[]u8,q:i32,end:i32)i32 {
  let v:i32=0; let i:i32=q; let any:i32=0;
  while(i<end){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(isd==1){ v=v*10+(ch-48); any=1; }
    if(isd==0){ if(any==1){ return v; } }
    i=i+1;
  }
  return v;
}
fn kv(s:[]u8,l:i32,ln:i32,k:[]u8)i32 {
  let i:i32=0;
  while(i+k.len<=ln){
    let j:i32=0; let ok:i32=1;
    while(j<k.len){ if(s[l+i+j]!=k[j]){ ok=0; } j=j+1; }
    if(ok==1){ return valat(s,l+i+k.len,l+ln); }
    i=i+1;
  }
  return -1;
}
// learned-stage comparison count of one cell file
fn learned_of(s:[]u8)i32 {
  let cur:i32=-1;
  let SC:[]u8=z_alloc(256);
  let l:i32=0;
  while(l<s.len){
    let e:i32=l;
    while(e<s.len){ if(s[e]==10){ break; } e=e+1; }
    let ln:i32=e-l;
    if(starts(s,l,ln,"STAGE ")==1){
      let i:i32=l+6;
      let num:i32=0; let got:i32=0;
      if(i<e){ if(s[i]==83){ i=i+1; got=1; } }
      while(i<e){
        let ch:i32=s[i] as i32;
        if(ch<48){ break; }
        if(ch>57){ break; }
        num=num*10+(ch-48); got=1; i=i+1;
      }
      if(got==1){ if(num>62){ num=62; } cur=num; }
    }
    if(starts(s,l,ln,"DET-CMP ")==1){ if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    if(starts(s,l,ln,"DET-NCMP ")==1){ if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    l=e+1;
  }
  let acc:i32=0;
  let q:i32=0;
  while(q<12){ acc=acc+get32(SC,q*4); q=q+1; }
  return acc;
}
// parse "g_<P>_<Q>_<D>_<dir>_<on|off>" out of a tag held in mf[ls..le)
fn tag_num(mf:[]u8,ls:i32,le:i32,which:i32)i32 {
  // fields are P Q D dir hedge; P is the 3rd field counting from the end,
  // Q the 4th, D the 5th. Count underscores from the end so the L_/NL_
  // prefix length does not matter.
  let us:[]u8=z_alloc(32);
  let un:i32=0;
  let i:i32=ls;
  while(i<le){
    if(mf[i]==95){ if(un<32){ us[un]=i; un=un+1; } }
    i=i+1;
  }
  // us[k] is the k-th underscore from the START. There are 6 for both
  // prefixes (L_g_a_b_c_dir_hedge) and 6 for NL_ as well? verify:
  //   "L_g_0_0_1_min_on"  -> 6 underscores
  //   "NL_g_0_0_1_min_on" -> 6 underscores
  // both have the same count, so index from the start is safe, but count
  // from the end anyway to be prefix-agnostic.
  // P is followed by 3 more fields (D,dir,hedge) -> its '_' is un-1-4
  let kk:i32=un-1-4+which;
  if(kk<0){ return -1; }
  let a:i32=us[kk]+1;
  let b:i32=le;
  if(kk+1<un){ b=us[kk+1]; }
  return valat(mf,a,b);
}
// tag layout: [NL_]g_<P>_<Q>_<D>_<dir>_<hedge>
// The dir token is the second-to-last field, so the '_' that precedes it is
// the second-to-last '_' in the tag. Count from the end; no assumption about
// the length of the prefix.
fn tag_dir(mf:[]u8,ls:i32,le:i32)i32 {
  let lastu:i32=-1;
  let secondu:i32=-1;
  let i:i32=ls;
  while(i<le){
    if(mf[i]==95){
      secondu=lastu;
      lastu=i;
    }
    i=i+1;
  }
  if(secondu<0){ return -1; }
  // BOTH "min" and "max" start with 'm'. Compare the 2nd byte: 'i' vs 'a'.
  if(mf[secondu+2]==105){ return 0; }   // 'i' of min
  return 1;                             // 'a' of max
}
fn tag_hedge(mf:[]u8,ls:i32,le:i32)i32 {
  if(mf[le-2]==111){ if(mf[le-1]==110){ return 1; } }   // "on"
  return 0;
}
fn main()i32 {
  let MFP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/cells.txt";
  let OUTF:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/";
  let mf:[]u8=_zag_read_file(MFP);
  if(mf.len==0){ _zag_println("ATTR FAIL: cells.txt"); return 1; }
  let B:[]u8=z_alloc(131072);
  let c:i32=0;
  // four groups per half: (dir 0/1) x (hedge 0/1)
  let half:i32=0;
  while(half<2){
    let gv:[]u8=z_alloc(4*8*4);
    let gn:[]u8=z_alloc(4*8*4);
    let nc:[]u8=z_alloc(4*8*4);
    // axis cross-tab: for each axis value, the set of learned values
    // axis 0 = P, 1 = Q, 2 = D, 3 = dir, 4 = hedge
    // axv[axis*64 + value] holds up to 8 distinct learned values, count in axn
    let axv:[]u8=z_alloc(5*64*8*4);
    let axn:[]u8=z_alloc(5*64*4);
    let ls:i32=0;
    while(ls<mf.len){
      let le:i32=ls;
      while(le<mf.len){ if(mf[le]==10){ break; } le=le+1; }
      let tl:i32=le-ls;
      if(tl>3){
        let isl:i32=1;
        if(mf[ls]!=76){ isl=0; }
        if(isl==1){ if(mf[ls+1]!=95){ isl=0; } }
        if(isl==(half==0)){
          let fp:[]u8=z_alloc(200+tl+4);
          let ol:[]u8=OUTF;
          let m:i32=0;
          while(m<ol.len){ fp[m]=ol[m]; m=m+1; }
          m=0;
          while(m<tl){ fp[ol.len+m]=mf[ls+m]; m=m+1; }
          fp[ol.len+tl]=46; fp[ol.len+tl+1]=116; fp[ol.len+tl+2]=120; fp[ol.len+tl+3]=116;
          let s:[]u8=_zag_read_file(fp);
          if(s.len==0){ _zag_println("ATTR FAIL: cell"); return 1; }
          let lv:i32=learned_of(s);
          let d:i32=tag_dir(mf,ls,le);
          let h:i32=tag_hedge(mf,ls,le);
          let gi:i32=d*2+h;
          // register in group
          let dup:i32=0;
          let f:i32=0;
          while(f<get32(gn,gi*8*4)){ if(get32(gv,gi*8*4+f*4)==lv){ dup=1; } f=f+1; }
          if(dup==0){
            let n:i32=get32(gn,gi*8*4);
            if(n<8){ set32(gv,gi*8*4+n*4,lv); set32(gn,gi*8*4,n+1); }
          }
          let g:i32=get32(nc,gi*8*4);
          if(g<2000000){ set32(nc,gi*8*4,g+1); }
          // cross-tabs
          let ax:i32=0;
          while(ax<5){
            let av:i32=-1;
            if(ax==0){ av=tag_num(mf,ls,le,0); }
            if(ax==1){ av=tag_num(mf,ls,le,1); }
            if(ax==2){ av=tag_num(mf,ls,le,2); }
            if(ax==3){ av=d; }
            if(ax==4){ av=h; }
            if(av>=0){
              if(av<64){
                let slot:i32=ax*64+av;
                let dup2:i32=0;
                f=0;
                while(f<get32(axn,slot*4)){ if(get32(axv,slot*8*4+f*4)==lv){ dup2=1; } f=f+1; }
                if(dup2==0){
                  let n2:i32=get32(axn,slot*4);
                  if(n2<8){ set32(axv,slot*8*4+n2*4,lv); set32(axn,slot*4,n2+1); }
                }
              }
            }
            ax=ax+1;
          }
        }
      }
      ls=le+1;
    }
    if(half==0){ c=o_app(B,c,"=== L (lesioned)"); c=o_nl(B,c); }
    if(half==1){ c=o_app(B,c,"=== NL (lesions deleted)"); c=o_nl(B,c); }
    let gi:i32=0;
    while(gi<4){
      let d2:i32=gi/2;
      let h2:i32=gi-(gi/2)*2;
      c=o_app(B,c,"GROUP dir=");
      if(d2==0){ c=o_app(B,c,"min"); } else { c=o_app(B,c,"max"); }
      c=o_app(B,c," hedge=");
      if(h2==0){ c=o_app(B,c,"off"); } else { c=o_app(B,c,"on"); }
      c=o_app(B,c," cells="); c=o_i64(B,c,get32(nc,gi*8*4) as i64);
      c=o_app(B,c," learned_distinct="); c=o_i64(B,c,get32(gn,gi*8*4) as i64);
      c=o_app(B,c," values=");
      let f:i32=0;
      while(f<get32(gn,gi*8*4)){ c=o_app(B,c," "); c=o_i64(B,c,get32(gv,gi*8*4+f*4) as i64); f=f+1; }
      c=o_nl(B,c);
      gi=gi+1;
    }
    // Full cross-tab: for each (dir,hedge) and each P, list the distinct
    // learned values over all Q,D. This is the table that decides WHICH
    // parameter owns the surviving 2-comparison range.
    // fresh registries for the XT pass; the earlier axis pass reused these
    let xtv:[]u8=z_alloc(32*8*4);
    let xtn:[]u8=z_alloc(32*4);
    let d3:i32=0;
    while(d3<2){
      let h3:i32=0;
      while(h3<2){
        let Pv:i32=0;
        c=o_app(B,c,"XT dir=");
        if(d3==0){ c=o_app(B,c,"min"); } else { c=o_app(B,c,"max"); }
        c=o_app(B,c," hedge=");
        if(h3==0){ c=o_app(B,c,"off"); } else { c=o_app(B,c,"on"); }
        c=o_nl(B,c);
        // scan the manifest again for this (dir,hedge)
        let ls2:i32=0;
        while(ls2<mf.len){
          let le2:i32=ls2;
          while(le2<mf.len){ if(mf[le2]==10){ break; } le2=le2+1; }
          let tl2:i32=le2-ls2;
          if(tl2>3){
            let isl:i32=1;
            if(mf[ls2]!=76){ isl=0; }
            if(isl==1){ if(mf[ls2+1]!=95){ isl=0; } }
            if(isl==(half==0)){
              if(tag_dir(mf,ls2,le2)==d3){
                if(tag_hedge(mf,ls2,le2)==h3){
                  let P:i32=tag_num(mf,ls2,le2,0);
                  let Q:i32=tag_num(mf,ls2,le2,1);
                  let D:i32=tag_num(mf,ls2,le2,2);
                  let fp:[]u8=z_alloc(200+tl2+4);
                  let ol:[]u8=OUTF;
                  let m:i32=0;
                  while(m<ol.len){ fp[m]=ol[m]; m=m+1; }
                  m=0;
                  while(m<tl2){ fp[ol.len+m]=mf[ls2+m]; m=m+1; }
                  fp[ol.len+tl2]=46; fp[ol.len+tl2+1]=116; fp[ol.len+tl2+2]=120; fp[ol.len+tl2+3]=116;
                  let sc:[]u8=_zag_read_file(fp);
                  if(sc.len==0){ _zag_println("ATTR FAIL: cell2"); return 1; }
                  let lv:i32=learned_of(sc);
                  let slot:i32=P;
                  let found:i32=0;
                  let f:i32=0;
                  while(f<get32(xtn,slot*4)){ if(get32(xtv,slot*8*4+f*4)==lv){ found=1; } f=f+1; }
                  if(found==0){
                    let n2:i32=get32(xtn,slot*4);
                    if(n2<8){ set32(xtv,slot*8*4+n2*4,lv); set32(xtn,slot*4,n2+1); }
                  }
                }
              }
            }
          }
          ls2=le2+1;
        }
        let pv:i32=0;
        while(pv<=16){
          if(get32(xtn,pv*4)>0){
            c=o_app(B,c,"XT   P="); c=o_i64(B,c,pv as i64);
            c=o_app(B,c," learned=");
            let f2:i32=0;
            while(f2<get32(xtn,pv*4)){ c=o_app(B,c," "); c=o_i64(B,c,get32(xtv,pv*8*4+f2*4) as i64); f2=f2+1; }
            c=o_nl(B,c);
          }
          pv=pv+1;
        }
        h3=h3+1;
      }
      d3=d3+1;
    }
    half=half+1;
  }
  o_flush(B,c);
  return 0;
}
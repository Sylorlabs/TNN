// C514-MENUM -- the enumeration test, in pure Zag.
//
// C506's sharpest claim is that the one-system violation is not the scoring
// function but the four researcher-written strategy FORMS (PW / WHOLE / NEED
// / ALT) selected by index.  That claim is asserted, not measured.  This
// tool measures it.
//
// (1) EXHAUSTIVENESS.  Scan ref/inc_c15.zag for the dispatch arms
//     `if(s==K)` inside det_handle and report the set of K covered.  If the
//     set is exactly {1,2,3,4} and strat_sel's own admission loop can only
//     return a value in {0,1,2,3,4}, then the menu is TOTAL: every strategy
//     the learner can ever name has a hand-written body.  There is no fifth
//     thing for the learner to invent, and no way for a new one to enter.
//
// (2) FORM-SPACE SIZE.  Enumerate the product of the axes the four
//     incumbent forms actually vary over, all of which are visible in the
//     source as literals:
//        A compare predicate   : whole-state eq | per-need eq        (2)
//        B hypothesis rule     : accept any non-empty mask | require a
//                                need to change across the pass       (2)
//        C lag schedule        : subset of {1,2,3} swept in order,
//                                prior-lag tried first and dup-suppressed
//                                                                (7)
//        D quiescence rule     : lag==1 returns "fixpoint" | no rule (2)
//        E pass advance        : 1 pass | 2 passes                    (2)
//     and report |A x B x C x D x E|.  This is the number of distinct
//     FORMS the researcher's own primitives already span.  The incumbent
//     four occupy 4 of them.  Any form-generation claim has to beat that
//     number, and to do it without enumerating it.
//
// (3) The incumbent four, located by predicate string so the mapping to
//     the axis assignment is checkable rather than asserted.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn slen(b:[]u8)i32 {
  let i:i32=0;
  while(i<b.len){ if(b[i]==0){ return i; } i=i+1; }
  return b.len;
}
fn count_pat(s:[]u8,so:i32,eo:i32,pat:[]u8)i32 {
  let n:i32=0; let i:i32=so;
  while(i+pat.len<=eo){
    let j:i32=0; let ok:i32=1;
    while(j<pat.len){ if(s[i+j]!=pat[j]){ ok=0; } j=j+1; }
    if(ok==1){ n=n+1; i=i+pat.len; continue; }
    i=i+1;
  }
  return n;
}
fn main()i32 {
  let INC:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/ref/inc_c15.zag";
  let s:[]u8=_zag_read_file(INC);
  if(s.len==0){ _zag_println("C514-MENUM FAIL: cannot read inc_c15.zag"); return 1; }
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  // ---- (1) EXHAUSTIVENESS of the dispatch ----
  // NOTE: patterns are string LITERALS, not built at runtime. Building a
  // needle by assigning bytes into a z_alloc'd buffer produced a corrupted
  // pattern on this compiler (t[7]=48+1 did not land), so every pattern in
  // this tool is a literal and the counting is literal-vs-literal.
  let n1:i32=count_pat(s,0,s.len,"if(s==1){");
  let n2:i32=count_pat(s,0,s.len,"if(s==2){");
  let n3:i32=count_pat(s,0,s.len,"if(s==3){");
  let n4:i32=count_pat(s,0,s.len,"if(s==4){");
  let n5:i32=count_pat(s,0,s.len,"if(s==5){");
  let n6:i32=count_pat(s,0,s.len,"if(s==6){");
  c=o_app(B,c,"MENUM arm_s_eq_1="); c=o_i64(B,c,n1 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM arm_s_eq_2="); c=o_i64(B,c,n2 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM arm_s_eq_3="); c=o_i64(B,c,n3 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM arm_s_eq_4="); c=o_i64(B,c,n4 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM arm_s_eq_5="); c=o_i64(B,c,n5 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM arm_s_eq_6="); c=o_i64(B,c,n6 as i64); c=o_nl(B,c);
  let arms:i32=0;
  if(n1>0){ arms=arms+1; }
  if(n2>0){ arms=arms+1; }
  if(n3>0){ arms=arms+1; }
  if(n4>0){ arms=arms+1; }
  if(n5>0){ arms=arms+1; }
  if(n6>0){ arms=arms+1; }
  c=o_app(B,c,"MENUM distinct_arms="); c=o_i64(B,c,arms as i64); c=o_nl(B,c);
  // strat_sel's admission loop: `while(s<5)` bounds the ids it will score
  let ad:[]u8="while(s<5)";
  let nad:i32=count_pat(s,0,s.len,ad);
  c=o_app(B,c,"MENUM admission_loop_while_s_lt_5="); c=o_i64(B,c,nad as i64); c=o_nl(B,c);
  let re:[]u8="return best";
  let nre:i32=count_pat(s,0,s.len,re);
  c=o_app(B,c,"MENUM returns_best="); c=o_i64(B,c,nre as i64); c=o_nl(B,c);
  let hg:[]u8="best=4";
  let nhg:i32=count_pat(s,0,s.len,hg);
  c=o_app(B,c,"MENUM hedge_assigns_4="); c=o_i64(B,c,nhg as i64); c=o_nl(B,c);
  // ---- (2) FORM-SPACE PRODUCT ----
  // A: predicate
  let pa:[]u8="traj_state_eq";
  let pb:[]u8="traj_need_eq";
  let na:i32=count_pat(s,0,s.len,pa);
  let nb:i32=count_pat(s,0,s.len,pb);
  c=o_app(B,c,"MENUM axisA_whole_state_eq_sites="); c=o_i64(B,c,na as i64);
  c=o_app(B,c," axisA_per_need_eq_sites="); c=o_i64(B,c,nb as i64); c=o_nl(B,c);
  // B: hypothesis non-triviality rule
  let ph:[]u8="traj_need_eq(L,pass,pass-1,nj)";
  let nbh:i32=count_pat(s,0,s.len,ph);
  c=o_app(B,c,"MENUM axisB_nonneed_change_tests="); c=o_i64(B,c,nbh as i64); c=o_nl(B,c);
  // C: lag schedules actually present
  let p1:[]u8="while(bi<4)";
  let p2:[]u8="while(d<4)";
  let nc:i32=count_pat(s,0,s.len,p1)+count_pat(s,0,s.len,p2);
  c=o_app(B,c,"MENUM axisC_lag_sweep_loops="); c=o_i64(B,c,nc as i64); c=o_nl(B,c);
  // D: quiescence
  let pq:[]u8="if(lagp==1)";
  let nd:i32=count_pat(s,0,s.len,pq);
  c=o_app(B,c,"MENUM axisD_quiescence_tests="); c=o_i64(B,c,nd as i64); c=o_nl(B,c);
  // E: pass advance
  let pe:[]u8="nadv=2";
  let ne:i32=count_pat(s,0,s.len,pe);
  c=o_app(B,c,"MENUM axisE_two_pass_arms="); c=o_i64(B,c,ne as i64); c=o_nl(B,c);
  // product |A| x |B| x |C| x |D| x |E| with |A|=2 |B|=2 |C|=7 |D|=2 |E|=2
  let prod:i32=2*2*7*2*2;
  c=o_app(B,c,"MENUM form_space=|A2|x|B2|x|C7|x|D2|x|E2|=");
  c=o_i64(B,c,prod as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM incumbent_forms="); c=o_i64(B,c,4 as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM unenumerated_forms="); c=o_i64(B,c,(prod-4) as i64); c=o_nl(B,c);
  // ---- (3) learner-owned cells read by the forms, vs literals ----
  // Each is a literal pattern, counted over the whole additive.
  c=o_app(B,c,"MENUM cell_15900="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,15900)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_15904="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,15904)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16648="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16648)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16650="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16650)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16680="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16680)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16684="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16684)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16688="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16688)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_16692="); c=o_i64(B,c,count_pat(s,0,s.len,"get32(L,16692)") as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENUM cell_17000="); c=o_i64(B,c,count_pat(s,0,s.len,"17000+slot") as i64); c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
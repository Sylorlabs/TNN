// C513 dump -- per-cell (P,Q,D,dir,hedge) -> learned-stage comparison count,
// for one (half, dir, hedge) group. Prints one line per cell so the
// attribution of the surviving {54,56} range can be read off directly
// instead of inferred from a summary.
//
// Usage: none (all groups, both halves). Output is one line per cell:
//   CELL <half> <dir> <hedge> P=<> Q=<> D=<> LEARNED=<> TOTAL=<>
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(a:[]u8,i:i32)i32 {
  return (a[i] as i32)|((a[i+1] as i32)<<8)|((a[i+2] as i32)<<16)|((a[i+3] as i32)<<24);
}
fn set32(a:[]u8,i:i32,v:i32)void {
  a[i]=v as u8; a[i+1]=(v>>8) as u8; a[i+2]=(v>>16) as u8; a[i+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn starts(s:[]u8,l:i32,ln:i32,p:[]u8)i32 {
  if(ln<p.len){ return 0; }
  let i:i32=0;
  while(i<p.len){ if(s[l+i]!=p[i]){ return 0; } i=i+1; }
  return 1;
}
fn valat(s:[]u8,q:i32,end:i32)i32 {
  let v:i32=0; let i:i32=q; let any:i32=0;
  while(i<end){
    let ch:i32=s[i] as i32;
    let isd:i32=0;
    if(ch>=48){ if(ch<=57){ isd=1; } }
    if(isd==1){ v=v*10+(ch-48); any=1; }
    if(isd==0){ if(any==1){ return v; } }
    i=i+1;
  }
  return v;
}
// tag: [NL_]g_<P>_<Q>_<D>_<dir>_<hedge>. The three numeric fields are the
// 3rd, 4th and 5th from the end, so count underscores from the start: there
// are exactly 6 for both prefixes, and us[3],us[4],us[5] precede P,Q,D.
fn tag_num(mf:[]u8,ls:i32,le:i32,which:i32)i32 {
  let us:[]u8=z_alloc(32);
  let un:i32=0;
  let i:i32=ls;
  while(i<le){
    if(mf[i]==95){ if(un<32){ us[un]=i; un=un+1; } }
    i=i+1;
  }
  // Tag is [NL_]g_<P>_<Q>_<D>_<dir>_<hedge>. There are exactly 6
  // underscores. us[0] ends the prefix ("L_" / "NL_") and us[1] ends the
  // "g"; field f (f=0 for P) therefore lies between us[1+f] and us[2+f].
  let kk:i32=1+which;
  if(kk<0){ return -1; }
  let a:i32=us[kk]+1;
  let b:i32=le;
  if(kk+1<un){ b=us[kk+1]; }
  return valat(mf,a,b);
}
fn tag_dir(mf:[]u8,ls:i32,le:i32)i32 {
  let lastu:i32=-1;
  let secondu:i32=-1;
  let i:i32=ls;
  while(i<le){
    if(mf[i]==95){ secondu=lastu; lastu=i; }
    i=i+1;
  }
  if(secondu<0){ return -1; }
  if(mf[secondu+2]==105){ return 0; }   // 'i' of min
  return 1;
}
fn tag_hedge(mf:[]u8,ls:i32,le:i32)i32 {
  if(mf[le-2]==111){ if(mf[le-1]==110){ return 1; } }
  return 0;
}
// learned(S1-S11) and total comparison counts of one cell
fn counts(s:[]u8,o:[]u8)void {
  let cur:i32=-1;
  let SC:[]u8=z_alloc(256);
  let tot:i32=0;
  let l:i32=0;
  while(l<s.len){
    let e:i32=l;
    while(e<s.len){ if(s[e]==10){ break; } e=e+1; }
    let ln:i32=e-l;
    if(starts(s,l,ln,"STAGE ")==1){
      let i:i32=l+6;
      let num:i32=0; let got:i32=0;
      if(i<e){ if(s[i]==83){ i=i+1; got=1; } }
      while(i<e){
        let ch:i32=s[i] as i32;
        if(ch<48){ break; }
        if(ch>57){ break; }
        num=num*10+(ch-48); got=1; i=i+1;
      }
      if(got==1){ if(num>62){ num=62; } cur=num; }
    }
    if(starts(s,l,ln,"DET-CMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    if(starts(s,l,ln,"DET-NCMP ")==1){ tot=tot+1; if(cur>=0){ set32(SC,cur*4,get32(SC,cur*4)+1); } }
    l=e+1;
  }
  let acc:i32=0;
  let q:i32=0;
  while(q<12){ acc=acc+get32(SC,q*4); q=q+1; }
  set32(o,0*4,acc);
  set32(o,1*4,tot);
  return;
}
fn o_pad2(b:[]u8,c:i32,v:i32)i32 {
  if(v<10){ b[c]=48+v; b[c+1]=32; return c+2; }
  b[c]=48+(v/10); b[c+1]=48+(v-(v/10)*10); return c+2;
}
fn o_pad3(b:[]u8,c:i32,v:i32)i32 {
  if(v<10){ b[c]=48; b[c+1]=48+v; b[c+2]=32; return c+3; }
  if(v<100){ b[c]=48+(v/10); b[c+1]=48+(v-(v/10)*10); b[c+2]=32; return c+3; }
  b[c]=48+(v/100); b[c+1]=48+((v/10)-((v/100)*10)); b[c+2]=48+(v-(v/10)*10); return c+3;
}
fn main()i32 {
  let MFP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/cells.txt";
  let OUTF:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/out/";
  let mf:[]u8=_zag_read_file(MFP);
  if(mf.len==0){ _zag_println("DUMP FAIL: cells.txt"); return 1; }
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let o:[]u8=z_alloc(8);
  let ls:i32=0;
  while(ls<mf.len){
    let le:i32=ls;
    while(le<mf.len){ if(mf[le]==10){ break; } le=le+1; }
    let tl:i32=le-ls;
    if(tl>3){
      let fp:[]u8=z_alloc(200+tl+4);
      let ol:[]u8=OUTF;
      let m:i32=0;
      while(m<ol.len){ fp[m]=ol[m]; m=m+1; }
      m=0;
      while(m<tl){ fp[ol.len+m]=mf[ls+m]; m=m+1; }
      fp[ol.len+tl]=46; fp[ol.len+tl+1]=116; fp[ol.len+tl+2]=120; fp[ol.len+tl+3]=116;
      let s:[]u8=_zag_read_file(fp);
      if(s.len==0){ _zag_println("DUMP FAIL: cell"); return 1; }
      counts(s,o);
      let isl:i32=1;
      if(mf[ls]!=76){ isl=0; }
      if(isl==1){ if(mf[ls+1]!=95){ isl=0; } }
      c=o_app(B,c,"CELL ");
      if(isl==1){ c=o_app(B,c,"L "); } else { c=o_app(B,c,"NL "); }
      let d:i32=tag_dir(mf,ls,le);
      if(d==0){ c=o_app(B,c,"min "); } else { c=o_app(B,c,"max "); }
      let h:i32=tag_hedge(mf,ls,le);
      if(h==1){ c=o_app(B,c,"on  "); } else { c=o_app(B,c,"off "); }
      // two-digit params (Q can be 0..2, D 1..3) are fine, but a one-digit
      // field followed by a space makes the columns ambiguous to a reader;
      // emit each field zero-padded to a fixed width so the table is citable.
      c=o_app(B,c,"P="); c=o_pad2(B,c,tag_num(mf,ls,le,0));
      c=o_app(B,c," Q="); c=o_pad2(B,c,tag_num(mf,ls,le,1));
      c=o_app(B,c," D="); c=o_pad2(B,c,tag_num(mf,ls,le,2));
      c=o_app(B,c," LEARNED="); c=o_pad3(B,c,get32(o,0*4));
      c=o_app(B,c," TOTAL="); c=o_pad3(B,c,get32(o,1*4));
      c=o_nl(B,c);
      if(c>60000){ o_flush(B,c); c=0; }
    }
    ls=le+1;
  }
  o_flush(B,c);
  return 0;
}
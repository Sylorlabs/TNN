// C511 bodycount -- pure-Zag verification of the C500/C506 strat_sel counts.
//
// Reads FILES.txt (41 newline-separated relative paths under
// overnight-20260928/), extracts the `fn strat_sel` body from each by
// brace matching, and reports:
//   * per-file: body byte length, body line count, FNV-1a 32 hash (label)
//   * the number of DISTINCT bodies, decided by BYTE EQUALITY of the
//     extracted bodies (never by the hash, so a collision cannot hide a
//     distinct body)
//   * the LOC multiset of the distinct bodies, and its sum
//   * the lane name and directory of every file, so lanes and directories
//     are counted by the tool rather than by hand
//
// Output via _zag_print (brief 4.0: _zag_raw_syscall is inert on this host).
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32s(a:[]u8,i:i32)i32 {
  return (a[i*4] as i32)|((a[i*4+1] as i32)<<8)|((a[i*4+2] as i32)<<16)|((a[i*4+3] as i32)<<24);
}
fn set32s(a:[]u8,i:i32,v:i32)void {
  a[i*4]=v as u8; a[i*4+1]=(v>>8) as u8; a[i*4+2]=(v>>16) as u8; a[i*4+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_hex8(b:[]u8,c:i32,v:i32)i32 {
  let d:[]u8="0123456789abcdef";
  b[c]=d[(v>>4)&15]; b[c+1]=d[v&15];
  return c+2;
}
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn fnv32(s:[]u8,from:i32,len:i32)i32 {
  let h:i32=2166136261;
  let i:i32=from;
  let e:i32=from+len;
  while(i<e){
    h=h^(s[i] as i32);
    h=h*16777619;
    i=i+1;
  }
  return h;
}
fn find(s:[]u8,needle:[]u8,from:i32)i32 {
  let i:i32=from;
  let last:i32=s.len-needle.len;
  while(i<=last){
    let j:i32=0;
    let ok:i32=1;
    while(j<needle.len){
      if(s[i+j]!=needle[j]){ ok=0; }
      j=j+1;
    }
    if(ok==1){ return i; }
    i=i+1;
  }
  return -1;
}
fn set_e(eo:[]u8,v:i32)void { set32s(eo,0,v); return; }
fn get_e(eo:[]u8)i32 { return get32s(eo,0); }
// Extract the strat_sel body: from the start of the line holding
// `fn strat_sel` to the end of the first following line that is exactly
// "}" at column 0. Writes the end offset to eo[0..4). Returns start, or -1.
fn extract(src:[]u8,eo:[]u8)i32 {
  let h:i32=find(src,"fn strat_sel",0);
  if(h<0){ return -1; }
  let st:i32=h;
  while(st>0){
    if(src[st-1]==10){ break; }
    st=st-1;
  }
  let p:i32=st;
  while(p<src.len){
    if(src[p]==10){
      let q:i32=p+1;
      if(q<src.len){
        if(src[q]==125){
          if(q+1>=src.len){ set_e(eo,q+1); return st; }
          if(src[q+1]==10){ set_e(eo,q+2); return st; }
        }
      }
    }
    p=p+1;
  }
  set_e(eo,src.len);
  return st;
}
fn count_lines(s:[]u8,from:i32,to:i32)i32 {
  let n:i32=0; let i:i32=from;
  while(i<to){
    if(s[i]==10){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn eq_range(a:[]u8,as0:i32,b:[]u8,bs:i32,len:i32)i32 {
  if(len==0){ return 1; }
  let i:i32=0;
  while(i<len){
    if(a[as0+i]!=b[bs+i]){ return 0; }
    i=i+1;
  }
  return 1;
}
fn basename(p:[]u8,s:i32,e:i32,o:[]u8)void {
  let b:i32=s; let i:i32=s;
  while(i<e){
    if(p[i]==47){ b=i+1; }
    i=i+1;
  }
  let j:i32=0;
  while(j<8){ o[j]=0; j=j+1; }
  let k:i32=0;
  while(b+k<e){
    let ch:i32=p[b+k];
    if(ch==95){ break; }
    if(k<7){ o[k]=ch as u8; }
    k=k+1;
  }
  return;
}
fn dirname(p:[]u8,s:i32,e:i32,o:[]u8)void {
  let b:i32=s; let i:i32=s;
  let last:i32=s;
  while(i<e){
    if(p[i]==47){ last=i; }
    i=i+1;
  }
  let n:i32=last-s;
  if(n>63){ n=63; }
  let j:i32=0;
  while(j<n){ o[j]=p[s+j]; j=j+1; }
  while(j<64){ o[j]=0; j=j+1; }
  return;
}
fn main()i32 {
  let ROOT:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/";
  let LFP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/cogopslesion/docs/lab/research-lead/overnight-20260928/cogopslesion/FILES.txt";
  let lst:[]u8=_zag_read_file(LFP);
  if(lst.len==0){ _zag_println("C511 FAIL: FILES.txt unreadable"); return 1; }
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  let AR:[]u8=z_alloc(1<<20);
  let arn:i32=0;
  let NF:i32=64;
  let recS:[]u8=z_alloc(NF*4);
  let recL:[]u8=z_alloc(NF*4);
  let recN:[]u8=z_alloc(NF*4);
  let recG:[]u8=z_alloc(NF*4);
  let recH:[]u8=z_alloc(NF*4);
  let NG:i32=32;
  let gS:[]u8=z_alloc(NG*4);
  let gL:[]u8=z_alloc(NG*4);
  let gN:[]u8=z_alloc(NG*4);
  let gCnt:[]u8=z_alloc(NG*4);
  let eo:[]u8=z_alloc(4);
  let bf:[]u8=z_alloc(8);
  let dn:[]u8=z_alloc(64);
  let lanes:[]u8=z_alloc(1024);
  let dirs:[]u8=z_alloc(4096);
  let nlane:i32=0;
  let ndir:i32=0;
  let nf:i32=0;
  let ng:i32=0;
  let ls:i32=0;
  while(ls<lst.len){
    let le:i32=ls;
    while(le<lst.len){ if(lst[le]==10){ break; } le=le+1; }
    let plen:i32=le-ls;
    if(plen>2){
      let fp:[]u8=z_alloc(ROOT.len+plen+1);
      let j:i32=0;
      while(j<ROOT.len){ fp[j]=ROOT[j]; j=j+1; }
      j=0;
      while(j<plen){ fp[ROOT.len+j]=lst[ls+j]; j=j+1; }
      let src:[]u8=_zag_read_file(fp);
      if(src.len==0){ _zag_println("C511 FAIL: cannot read a listed file"); return 1; }
      let st:i32=extract(src,eo);
      if(st<0){ _zag_println("C511 FAIL: no strat_sel in a listed file"); return 1; }
      let en:i32=get_e(eo);
      let bl:i32=en-st;
      let blines:i32=count_lines(src,st,en);
      let ao:i32=arn;
      let k:i32=0;
      while(k<bl){ AR[arn]=src[st+k]; arn=arn+1; k=k+1; }
      let gi:i32=-1;
      let q:i32=0;
      while(q<ng){
        let ql:i32=get32s(gL,q);
        if(ql==bl){
          if(eq_range(AR,ao,AR,get32s(gS,q),bl)==1){ gi=q; }
        }
        q=q+1;
      }
      if(gi<0){ gi=ng; ng=ng+1; set32s(gS,gi,ao); set32s(gL,gi,bl); set32s(gCnt,gi,0); }
      set32s(gCnt,gi,get32s(gCnt,gi)+1);
      set32s(gN,gi,blines);
      set32s(recS,nf,ao); set32s(recL,nf,bl); set32s(recN,nf,blines);
      set32s(recG,nf,gi); set32s(recH,nf,fnv32(AR,ao,bl));
      // lane / dir bookkeeping, done here so it is machine-counted
      basename(lst,ls,le,bf);
      let found:i32=0;
      let t:i32=0;
      while(t<nlane){
        if(eq_range(lanes,0,lanes,0,0)==1){ }
        t=t+1;
      }
      // linear search over stored lane names (8 bytes each)
      found=0;
      t=0;
      while(t<nlane){
        if(eq_range(lanes,t*8,bf,0,bf_strlen(bf))==1){ found=1; }
        t=t+1;
      }
      if(found==0){
        let m:i32=0;
        while(m<8){ lanes[nlane*8+m]=bf[m]; m=m+1; }
        nlane=nlane+1;
      }
      dirname(lst,ls,le,dn);
      found=0;
      t=0;
      while(t<ndir){
        if(eq_range(dirs,t*64,dn,0,dn_strlen(dn))==1){ found=1; }
        t=t+1;
      }
      if(found==0){
        let m:i32=0;
        while(m<64){ dirs[ndir*64+m]=dn[m]; m=m+1; }
        ndir=ndir+1;
      }
      nf=nf+1;
    }
    ls=le+1;
  }
  c=o_app(B,c,"C511 files="); c=o_i64(B,c,nf as i64);
  c=o_app(B,c," distinct_bodies="); c=o_i64(B,c,ng as i64);
  c=o_app(B,c," lanes="); c=o_i64(B,c,nlane as i64);
  c=o_app(B,c," dirs="); c=o_i64(B,c,ndir as i64); c=o_nl(B,c);
  c=o_app(B,c,"C511 distinct_body_lines=");
  let g:i32=0;
  while(g<ng){ c=o_i64(B,c,get32s(gN,g) as i64); c=o_app(B,c,","); g=g+1; }
  c=o_nl(B,c);
  let totsum:i32=0; g=0;
  while(g<ng){ totsum=totsum+get32s(gN,g); g=g+1; }
  c=o_app(B,c,"C511 distinct_body_loc_sum="); c=o_i64(B,c,totsum as i64); c=o_nl(B,c);
  c=o_app(B,c,"C511 group_nfiles=");
  g=0; while(g<ng){ c=o_i64(B,c,get32s(gCnt,g) as i64); c=o_app(B,c,","); g=g+1; }
  c=o_nl(B,c);
  let f:i32=0;
  while(f<nf){
    c=o_app(B,c,"F "); c=o_i64(B,c,f as i64);
    c=o_app(B,c," g="); c=o_i64(B,c,get32s(recG,f) as i64);
    c=o_app(B,c," lines="); c=o_i64(B,c,get32s(recN,f) as i64);
    c=o_app(B,c," bytes="); c=o_i64(B,c,get32s(recL,f) as i64);
    c=o_app(B,c," fnv=");
    let hv:i32=get32s(recH,f);
    c=o_hex8(B,c,(hv>>24)&255);
    c=o_hex8(B,c,(hv>>16)&255);
    c=o_hex8(B,c,(hv>>8)&255);
    c=o_hex8(B,c,hv&255);
    c=o_nl(B,c);
    f=f+1;
  }
  c=o_app(B,c,"C511 lanes=");
  let t:i32=0;
  while(t<nlane){ c=o_app(B,c,lanes[t*8..t*8+bf_strlen(lanes[t*8..t*8+8])]); c=o_app(B,c,","); t=t+1; }
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
fn bf_strlen(b:[]u8)i32 {
  let i:i32=0;
  while(i<b.len){ if(b[i]==0){ return i; } i=i+1; }
  return b.len;
}
fn dn_strlen(b:[]u8)i32 {
  let i:i32=0;
  while(i<b.len){ if(b[i]==0){ return i; } i=i+1; }
  return b.len;
}
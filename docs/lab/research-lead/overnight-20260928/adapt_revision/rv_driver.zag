// rv_driver.zag -- ADAPT-REVISION battery.
//
// R1 PARAM-REVISE: adapt X via EXTEND-ONE (X'=[1,1,1,1] answers
//   (11,71,15)); world change teaches (14,3,12) then kills (14,1,15)
//   (teach-then-kill per Amendment 2; cyclic frontier: rebind cannot
//   help); learner must revise the adaptation with the new
//   parameter. Expect ans=12, X''=[1,1,1,3] with type-16 X''->X',
//   X' retired, chain X''->X'->X, and the base contract still
//   answering (11,71,14)->14.
// R2 RETRACT-ON-DEAD-END: world change kills (14,1,15) and the
//   phase-2 shortcut, teaches nothing. Expect ans=-2, X' retired,
//   zero live adapted MAPs.
// R3 NO-CHANGE-CONTROL: no world change; re-query (11,71,15).
//   Expect ans=15, X' live, no revision edges added.
// R4 CONTRACT-BREAK-CONTROL: world change teaches (12,1,93), kills
//   (12,1,13) (inside the base contract) and both cached shortcuts.
//   Expect ans=-2 and X' still live: the learner must not revise the
//   adaptation when the break is in the contract.
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn rv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<10){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn rv_live(W:[]u8,m:i32)i32 {
  // Live MAP (not merely a live node): alloc_node recycles dead
  // node ids, so a retired MAP's slot may be reused as a literal,
  // cell, or fact. "Retired" observably means "no longer a live
  // MAP" (Amendment 2).
  if(ng(W,m,36)==1 && ng(W,m,0)==20){return 1;}
  return 0;
}
fn rv_has16(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==16 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
// type-16 target of a, or -1.
fn rv_src16(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// lowest-id live adapted MAP, or -1.
fn rv_find_adapted(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(rev_is_adapted(W,m)==1){return m;}
    m=m+1;
  }
  return -1;
}
// lowest-id live adapted MAP whose type-16 target is xp, or -1.
fn rv_find_reviser(W:[]u8,xp:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(rev_is_adapted(W,m)==1 && rv_src16(W,m)==xp){return m;}
    m=m+1;
  }
  return -1;
}
// count of live adapted MAPs.
fn rv_count16_live(W:[]u8)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    if(rev_is_adapted(W,m)==1){c=c+1;}
    m=m+1;
  }
  return c;
}
// count of all type-16 edges.
fn rv_count16_edges(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff no type-16 edge targets xp.
fn rv_no16_to(W:[]u8,xp:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16 && eg(W,e,8)==xp){return 0;}
    e=e+1;
  }
  return 1;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn rv_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// lowest-id live fact node with (s,r,o), or -1.
fn rv_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// Train X ([1,1,1]) via the trial path. out: mapx, f1112, f1213, f1314.
fn rv_train_x(W:[]u8,out:[]u8)void {
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,1,13);
  let f3:i32=ev_teach(W,13,1,14);
  let x:i32=ev_query_revise(W,11,71,14,0);
  emit("RV-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  set32(out,4,f1); set32(out,8,f2); set32(out,12,f3);
  return;
}
// Phase-2 adaptation: teach the frontier fact, query (11,71,15).
// out: ans, xp (adapted MAP), f14115.
fn rv_phase2(W:[]u8,out:[]u8)void {
  let f4:i32=ev_teach(W,14,1,15);
  let z:i32=ev_query_revise(W,11,72,15,0);
  emit("RV-PHASE2 ans="); e64(z); emit("\n");
  set32(out,0,z);
  set32(out,4,rv_find_adapted(W));
  set32(out,8,f4);
  return;
}

// ---- R1: parameter revision ----
fn r1_param_revise(W:[]u8)void {
  emit("=== R1-PARAM-REVISE ===\n");
  let t:[]u8=z_alloc(16);
  rv_train_x(W,t);
  let mapx:i32=get32(t,0);
  let f1213:i32=get32(t,8);
  rv_gap(W);
  let p:[]u8=z_alloc(12);
  rv_phase2(W,p);
  let xp:i32=get32(p,4);
  let f14115:i32=get32(p,8);
  emit("R1 mapx="); e64(mapx); emit(" xp="); e64(xp); emit("\n");
  // world change (driver instrumentation; the learner is not told):
  // teach the cyclic replacement FIRST, then retire the frontier
  // fact. Teach-then-kill: alloc_node recycles the lowest dead id,
  // so kill-then-teach would place the new fact in the old slot and
  // silently rewrite the adaptation's licensing (Amendment 2).
  let fnew:i32=ev_teach(W,14,3,12);
  ns(W,f14115,36,0);
  emit("R1 WORLD-CHANGE taught (14,3,12) as node ");
  e64(fnew); emit(", killed f14115\n");
  let z:i32=ev_query_revise(W,11,73,12,0);
  emit("R1-ANS="); e64(z); emit("\n");
  let xpp:i32=rv_find_reviser(W,xp);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,1); set32(ex,4,1); set32(ex,8,1); set32(ex,12,3);
  let p1:i32=0; if(z==12){p1=1;}
  let p2:i32=0; if(xpp>=0){p2=1;}
  let p3:i32=0; if(xpp>=0 && rv_src16(W,xpp)==xp){p3=1;}
  let p4:i32=rv_has16(W,xp,mapx);
  let p5:i32=0; if(rv_live(W,xp)==0){p5=1;}
  let p6:i32=0; if(xpp>=0){p6=rv_relseq_eq(W,xpp,ex,4);}
  let p7:i32=rv_live(W,mapx);
  let zc:i32=ev_query_revise(W,11,74,14,0);
  emit("R1-CONTROL-ANS="); e64(zc); emit("\n");
  let p8:i32=0; if(zc==14){p8=1;}
  emit("R1 p1(ans12)="); e64(p1);
  emit(" p2(reviser-exists)="); e64(p2);
  emit(" p3(xpp16xp)="); e64(p3);
  emit(" p4(xp16x)="); e64(p4);
  emit(" p5(xp-retired)="); e64(p5);
  emit(" p6(seq1113)="); e64(p6);
  emit(" p7(x-live)="); e64(p7);
  emit(" p8(contract14)="); e64(p8); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1){
    emit("R1-PARAM-REVISE=PASS\n");
  } else {
    emit("R1-PARAM-REVISE=FAIL\n");
  }
  return;
}

// ---- R2: retraction on dead end ----
fn r2_retract(W:[]u8)void {
  emit("=== R2-RETRACT ===\n");
  let t:[]u8=z_alloc(16);
  rv_train_x(W,t);
  rv_gap(W);
  let p:[]u8=z_alloc(12);
  rv_phase2(W,p);
  let mapx:i32=get32(t,0);
  let xp:i32=get32(p,4);
  let f14115:i32=get32(p,8);
  // world change: retire the frontier fact, teach nothing. Also
  // withdraw the phase-2 cached shortcut (11,72,15): it is a stale
  // cached consequence of the withdrawn regularity, and the
  // sum-trial would otherwise answer 15 from it, confounding the
  // retraction signal (Amendment 2).
  ns(W,f14115,36,0);
  let sc2:i32=rv_find_fact(W,11,72,15);
  if(sc2>=0){ns(W,sc2,36,0);}
  emit("R2 WORLD-CHANGE killed f14115, killed shortcut (11,72,15), dead end at 14\n");
  let z:i32=ev_query_revise(W,11,73,15,0);
  emit("R2-ANS="); e64(z); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(rv_live(W,xp)==0){p2=1;}
  let p3:i32=0; if(rv_count16_live(W)==0){p3=1;}
  let p4:i32=rv_has16(W,xp,mapx);
  emit("R2 p1(ans-2)="); e64(p1);
  emit(" p2(xp-retired)="); e64(p2);
  emit(" p3(no-live-adapted)="); e64(p3);
  emit(" p4(xp16x-persists)="); e64(p4); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1){
    emit("R2-RETRACT=PASS\n");
  } else {
    emit("R2-RETRACT=FAIL\n");
  }
  return;
}

// ---- R3: no-change control ----
fn r3_nochange(W:[]u8)void {
  emit("=== R3-NOCHANGE ===\n");
  let t:[]u8=z_alloc(16);
  rv_train_x(W,t);
  rv_gap(W);
  let p:[]u8=z_alloc(12);
  rv_phase2(W,p);
  let xp:i32=get32(p,4);
  let c0:i32=rv_count16_edges(W);
  let z:i32=ev_query_revise(W,11,73,15,0);
  emit("R3-ANS="); e64(z); emit("\n");
  let c1:i32=rv_count16_edges(W);
  let p1:i32=0; if(z==15){p1=1;}
  let p2:i32=rv_live(W,xp);
  let p3:i32=0; if(rv_count16_live(W)==1){p3=1;}
  let p4:i32=rv_no16_to(W,xp);
  let p5:i32=0; if(c1==c0){p5=1;}
  emit("R3 p1(ans15)="); e64(p1);
  emit(" p2(xp-live)="); e64(p2);
  emit(" p3(one-live-adapted)="); e64(p3);
  emit(" p4(no16-to-xp)="); e64(p4);
  emit(" p5(edges-unchanged)="); e64(p5); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1){
    emit("R3-NOCHANGE=PASS\n");
  } else {
    emit("R3-NOCHANGE=FAIL\n");
  }
  return;
}

// ---- R4: contract-break control ----
fn r4_contract_break(W:[]u8)void {
  emit("=== R4-CONTRACT-BREAK ===\n");
  let t:[]u8=z_alloc(16);
  rv_train_x(W,t);
  let f1213:i32=get32(t,8);
  rv_gap(W);
  let p:[]u8=z_alloc(12);
  rv_phase2(W,p);
  let xp:i32=get32(p,4);
  let c0:i32=rv_count16_edges(W);
  // world change inside the base contract, not the adaptation.
  // Teach-then-kill (Amendment 2): the new fact lands in a fresh
  // slot. Also withdraw the cached shortcuts (11,71,14) and
  // (11,72,15): stale cached consequences of the broken regularity;
  // the chain-trial and sum-trial would otherwise answer 15 from
  // them, confounding the contract-break signal. (14,1,15) stays
  // live but unreachable from 11.
  let f293:i32=ev_teach(W,12,1,93);
  ns(W,f1213,36,0);
  let sc1:i32=rv_find_fact(W,11,71,14);
  if(sc1>=0){ns(W,sc1,36,0);}
  let sc2b:i32=rv_find_fact(W,11,72,15);
  if(sc2b>=0){ns(W,sc2b,36,0);}
  emit("R4 WORLD-CHANGE taught (12,1,93) as node ");
  e64(f293); emit(", killed (12,1,13) and both shortcuts\n");
  let z:i32=ev_query_revise(W,11,73,15,0);
  emit("R4-ANS="); e64(z); emit("\n");
  let c1:i32=rv_count16_edges(W);
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=rv_live(W,xp);
  let p3:i32=0; if(rv_count16_live(W)==1){p3=1;}
  let p4:i32=0; if(c1==c0){p4=1;}
  emit("R4 p1(ans-2)="); e64(p1);
  emit(" p2(xp-still-live)="); e64(p2);
  emit(" p3(one-live-adapted)="); e64(p3);
  emit(" p4(edges-unchanged)="); e64(p4); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1){
    emit("R4-CONTRACT-BREAK=PASS\n");
  } else {
    emit("R4-CONTRACT-BREAK=FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("RV-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); r1_param_revise(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); r2_retract(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); r3_nochange(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); r4_contract_break(W4);
  emit("RV-END\n");
  return 0;
}

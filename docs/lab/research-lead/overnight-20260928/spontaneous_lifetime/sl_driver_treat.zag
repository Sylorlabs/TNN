// sl_driver_treat.zag -- spontaneous lifetime driver, TREATMENT arm.
// Full continuous lifetime: Phase 1 (learn A), Phase 2 (300 unrelated),
// Phase 3 (B presented, no hint to use A).
// Cognition is byte-identical to the rebind treatment variant; only the
// world stream (this driver) is new.
fn lifetime_mode()i32 { return 1; }
fn sl_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn sl_maxnode(W:[]u8)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1){return m;}
    m=m-1;
  }
  return 1;
}
fn sl_phase1(W:[]u8)void {
  ev_teach(W,2,1,21); ev_teach(W,21,1,22);
  let a1:i32=ev_query(W,2,51,22,0);
  emit("A-DECOY ans="); e64(a1); sl_tstat(W);
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a2:i32=ev_query(W,1,50,14,0);
  emit("A-MAIN ans="); e64(a2); sl_tstat(W);
  return;
}
fn sl_phase2(W:[]u8)void {
  let i:i32=0; let r:i32=60;
  while(i<400){
    ev_teach(W,5000+i,r,6000+i);
    r=r+1; if(r>69){r=60;}
    i=i+1;
  }
  i=0; r=70;
  while(i<100){
    ev_observe(W,7000+i,r,8000+i);
    r=r+1; if(r>79){r=70;}
    i=i+1;
  }
  return;
}
fn sl_phase3(W:[]u8)void {
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  ev_teach(W,101,1,201); ev_teach(W,201,1,202);
  ev_teach(W,101,1,203); ev_teach(W,203,1,204);
  ev_teach(W,101,1,205); ev_teach(W,205,1,206); ev_teach(W,206,1,207);
  ev_teach(W,101,1,208); ev_teach(W,208,1,209); ev_teach(W,209,1,210);
  ev_teach(W,101,1,211); ev_teach(W,211,1,212);
  ev_teach(W,212,1,213); ev_teach(W,213,1,214);
  let b:i32=ev_query(W,101,50,114,0);
  emit("B-MAIN ans="); e64(b); sl_tstat(W);
  return;
}
fn sl_xedges(W:[]u8,n1:i32,n2:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let f:i32=eg(W,e,0); let t:i32=eg(W,e,8);
      if(f<=n1 && t>n2){c=c+1;}
      if(t<=n1 && f>n2){c=c+1;}
    }
    e=e+1;
  }
  return c;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("SPONT-START\n");
  let n1:i32=1; let n2:i32=1;
  if(lifetime_mode()==1){
    sl_phase1(W);
    n1=sl_maxnode(W);
    emit("P1 live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24));
    emit(" maxnode="); e64(n1); emit("\n");
    sl_phase2(W);
    n2=sl_maxnode(W);
    emit("P2 live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24));
    emit(" maxnode="); e64(n2); emit("\n");
  }
  sl_phase3(W);
  emit("P3 live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  let xe:i32=sl_xedges(W,n1,n2);
  emit("XEDGES a-b="); e64(xe); emit("\n");
  emit("SPONT-END\n");
  return 0;
}

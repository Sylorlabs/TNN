  emit("\n########## SINGLE-SIDE POLLUTION (X-R5-2c: s0=1-only swap + qk=1 pollution) ##########\n");
  let W6:[]u8=z_alloc(65536);
  let qf0:[]u8=z_alloc(32); let qf1:[]u8=z_alloc(32);
  let qf2:[]u8=z_alloc(32); let qmm:[]u8=z_alloc(32);

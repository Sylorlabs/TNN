  // ================= GAMED CURRICULUM (X-R1 variant) =================
  emit("\n########## GAMED CURRICULUM (X-R1 variant: s0=1 multi-seg -> CAUS_LEARN) ##########\n");
  let W2:[]u8=z_alloc(65536);
  let gf0:[]u8=z_alloc(32); let gf1:[]u8=z_alloc(32);
  let gf2:[]u8=z_alloc(32); let gmm:[]u8=z_alloc(32);
  let gnc:[]u8=z_alloc(4); gnc[0]=0;

  emit("SWAP-PROBE 5-seg str>str -> "); emit(tc_name(p1));
  emit(" (honest policy: PROC_LEARN)\n");
  let p2:i32=learned_route3(RT4,nrt4,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4");
  emit("SWAP-PROBE 5-seg iii>ii -> "); emit(tc_name(p2));
  emit(" (honest policy: CAUS_LEARN)\n");

  // ================= POLLUTION-SWAP (X-R5-2b fixture) =================
  // X-R4-1 SWAP learns + honest queries + 2 injected disagreeing query
  // marks: "zzz" (plain string, qk=1) marked CQ, "9,9,9" (triple, qk=2)
  // marked PQ. Both anchors become contested; H-ROUTER6 must emit
  // ANCHOR-CONTESTED for both types instead of going silently tfam=0.
  emit("\n########## POLLUTION-SWAP (X-R5-2b: swap learns + 2 polluting query marks) ##########\n");
  let W5:[]u8=z_alloc(65536);
  let pf0:[]u8=z_alloc(32); let pf1:[]u8=z_alloc(32);

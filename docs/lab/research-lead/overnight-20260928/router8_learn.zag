  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"a>b;c>d;e>f;g>h;i>j",TC_PL(),"R3T-S5");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"a>b;c>d;e>f;g>h;i>j;k>l",TC_PL(),"R3T-S6");

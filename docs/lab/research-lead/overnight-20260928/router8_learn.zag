  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"a>b;c>d;e>f;g>h;i>j;k>l;m>n;o>p",TC_PL(),"R3T-S8");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"a>b;c>d;e>f;g>h;i>j;k>l;m>n;o>p;q>r",TC_PL(),"R3T-S9");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4",TC_CL(),"R3T-E5");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4;6,6,6>6,5",TC_CL(),"R3T-E6");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4;6,6,6>6,5;7,7,7>7,6",TC_CL(),"R3T-E7");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4;6,6,6>6,5;7,7,7>7,6;8,8,8>8,7",TC_CL(),"R3T-E8");
  ttest=ttest+1; tpass=tpass+check_route3(RT,nrt,"1,1,1>1,0;2,2,2>2,1;3,3,3>3,2;4,4,4>4,3;5,5,5>5,4;6,6,6>6,5;7,7,7>7,6;8,8,8>8,7;9,9,9>9,8",TC_CL(),"R3T-E9");
  emit("K-R3-2 threshold: "); e64(tpass); emit("/"); e64(ttest); emit("\n");

  // ---- K-R3-3b: replay faithfulness ----

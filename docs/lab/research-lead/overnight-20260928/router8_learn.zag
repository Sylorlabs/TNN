  // ================= FALLBACK-LOSS (X-R6-3d CAND1 fixture) =================
  // Honest curriculum + "ab>1,0"->CL (features (3,1,0)): drives the induced
  // [any] entry to CONFLICTED. H-ROUTER8 must preserve a terminal
  // [any]->WITHHOLD fallback (explicit; total on the normal path, where the
  // append succeeds) so that unmatched probes route to WITHHOLD, not silent -1.
  emit("\n########## FALLBACK-LOSS (X-R6-3d: out-of-scope mark kills [any] entry) ##########\n");
  let W7:[]u8=z_alloc(65536);
  let ff0:[]u8=z_alloc(32); let ff1:[]u8=z_alloc(32);
  let ff2:[]u8=z_alloc(32); let fmm:[]u8=z_alloc(32);
  let fnc:[]u8=z_alloc(4); fnc[0]=0;
  emit("\n=== fallback-loss marked curriculum ===\n");
  run_induction(W7,0,ff0,ff1,ff2,fmm,fnc);
  teach(W7,"ab>1,0",TC_CL(),19,ff0,ff1,ff2,fmm,fnc);
  emit("\n=== PHASE 1b: threshold compilation (fallback-loss) ===\n");
  let RT7:[]u8=z_alloc(192);

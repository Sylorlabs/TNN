  emit("FALLBACK-PROBE (3,1,0) -> "); e64(fbprobe); emit(" (want 10 WITHHOLD)\n");
  // verify an all-ANY rule is present in the compiled table
  let fbany:i32=0;
  let fbr:i32=0;
  while(fbr<nrt7){
    if(rt_get(RT7,fbr,0)==CK_ANY() && rt_get(RT7,fbr,2)==CK_ANY() && rt_get(RT7,fbr,4)==CK_ANY()){fbany=1;}

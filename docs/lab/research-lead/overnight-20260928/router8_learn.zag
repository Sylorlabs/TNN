  ntest=ntest+1; npass=npass+check_route3(RT,nrt,"q>w;e>r;t>y",TC_PL(),"R3B-N2");
  ntest=ntest+1; npass=npass+check_route3(RT,nrt,"3,3,3>3,2;4,4,4>4,3",TC_CL(),"R3B-N3");
  ntest=ntest+1; npass=npass+check_route3(RT,nrt,"goodbye",TC_PQ(),"R3B-N4");
  ntest=ntest+1; npass=npass+check_route3(RT,nrt,"2,2,2",TC_CQ(),"R3B-N5");
  ntest=ntest+1; npass=npass+check_route3(RT,nrt,"xy>yx",TC_W(),"R3B-N6");
  emit("K-R3-3a regression: "); e64(npass); emit("/"); e64(ntest); emit("\n");

  // ---- K-R3-2: threshold probes (supersedes K-R2C) ----

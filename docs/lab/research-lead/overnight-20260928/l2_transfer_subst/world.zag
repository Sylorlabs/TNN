// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen price-fact table and the world-change kill. The learner
// never calls w_kill; it only observes facts via f_teach and
// discovers the death through execution outcomes.
// Node ids are subtotal states in dollars. Relation 7 = ADD,
// 8 = ITEMIZED-ADD, 9 = unrelated.
// Fact ids: 0:(0,7,15) 1:(15,7,70) 2:(70,7,90) 3:(15,8,40)
//           4:(40,8,70) 5:(0,9,200) 6:(200,9,210)
//           7:(100,7,115) 8:(115,7,140)
// Hand-derived total: 15 + 55 + 20 = 90; bundle path
// 15 + 25 + 30 + 20 = 90.

fn w_fact(i:i32, out:[]u8)void {
  if(i==0){out[0]=0;out[1]=7;out[2]=15;return;}
  if(i==1){out[0]=15;out[1]=7;out[2]=70;return;}
  if(i==2){out[0]=70;out[1]=7;out[2]=90;return;}
  if(i==3){out[0]=15;out[1]=8;out[2]=40;return;}
  if(i==4){out[0]=40;out[1]=8;out[2]=70;return;}
  if(i==5){out[0]=0;out[1]=9;out[2]=200;return;}
  if(i==6){out[0]=200;out[1]=9;out[2]=210;return;}
  if(i==7){out[0]=100;out[1]=7;out[2]=115;return;}
  out[0]=115;out[1]=7;out[2]=140;
  return;
}
fn w_nfacts()i32 { return 9; }

// World change: a price fact dies. Environment act only.
fn w_kill(st:[]u8, fid:i32)void {
  st[16+fid*8+3]=0;
  return;
}

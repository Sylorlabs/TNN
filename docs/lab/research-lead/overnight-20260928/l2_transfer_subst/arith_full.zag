// learner.zag -- L2 SUBSTITUTE operator (chain family), standalone.
// Generic machinery + learned state only. No world data, no fact
// literals, no relation literals in this file. The learner never
// selects a piece per problem: sub_try searches the learned piece
// inventory in node-id order for the first live endpoint-matching
// piece with all licensing facts live.
// Prereg: l2_substitute/PREREG.md (commit 1fb6db863) plus
// PREREG_AMENDMENT1.md (commit c83312197). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 SUB_ON  4 ET_ON  5 NN
//   6 STALE_MAP (255=none)  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA (255=none)  10 LAST_VAL  11 IN_ADAPT
//   16..271:   facts, 32 x 8B [sub,rel,obj,live,0,0,0,0]
//   272..783:  MAPs, 16 x 32B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x8 @+8, facts x8 @+16, pad x8 @+24]
//   784..1039: edges, 64 x 4B [from,to,type,pad]
//   1040..1071: answer nodes, 8 x 4B [via,val,0,0]
//   1072 SEARCH i32  1076 EXEC i32  1080 A_SEARCH i32  1084 A_EXEC i32
//   1088..2047: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=32){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>8){return -1;}
  if(fl>8){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  let o:i32=272+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<8){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){
    if(k<fl){st[o+16+k]=fs[k];}
    else {st[o+16+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){st[o+24+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=272+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<8){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){
    if(k<fl){st[o+16+k]=fs[k];}
    else {st[o+16+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){st[o+24+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=272+mid*32;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}
fn map_matches(st:[]u8, d2:i32, cr:[]u8, cf:[]u8, n2:i32)i32 {
  let do2:i32=272+d2*32;
  if((st[do2+4] as i32)!=n2){return 0;}
  if((st[do2+5] as i32)!=n2){return 0;}
  let q:i32=0;
  while(q<n2){
    if((st[do2+8+q] as i32)!=(cr[q] as i32)){return 0;}
    if((st[do2+16+q] as i32)!=(cf[q] as i32)){return 0;}
    q=q+1;
  }
  return 1;
}

// ---- cost-counted scans (frozen counting rules) ----
fn ascan_map(st:[]u8, mid:i32)i32 {
  set32(st,1080,get32(st,1080)+1);
  set32(st,1072,get32(st,1072)+1);
  return st[272+mid*32+1] as i32;
}
fn ascan_fact(st:[]u8, fid:i32)i32 {
  set32(st,1080,get32(st,1080)+1);
  set32(st,1072,get32(st,1072)+1);
  return st[16+fid*8+3] as i32;
}
fn bump_exec(st:[]u8)void {
  set32(st,1076,get32(st,1076)+1);
  if((st[11] as i32)==1){set32(st,1084,get32(st,1084)+1);}
  return;
}

// ---- execution ----
// m_exec: the white-box stale check. A hop whose licensing fact is
// dead records STALE_MAP/HOP/FACT and returns -1.
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  bump_exec(st);
  st[6]=255;
  let o:i32=272+mid*32;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+16+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  bump_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=784+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=784+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[784+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=784+i*4;
    let hit:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){hit=1;}
      }
    }
    if(hit==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=784+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn e_other(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let t:i32=st[784+i*4+2] as i32;
    let known:i32=0;
    if(t==14){known=1;}
    if(t==15){known=1;}
    if(t==16){known=1;}
    if(known==0){c=c+1;}
    i=i+1;
  }
  return c;
}

// ---- deliver: answer promotion + type-15 co-use on success ----
fn deliver(st:[]u8, mid:i32, val:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  let nn:i32=st[5] as i32;
  if(nn<8){
    let aid:i32=32+nn;
    let o:i32=1040+nn*4;
    st[o]=mid as u8; st[o+1]=val as u8; st[o+2]=0; st[o+3]=0;
    st[5]=(nn+1) as u8;
    e_add(st,aid,mid,14);
  }
  let srcs:[]u8=z_alloc(8);
  let ns:i32=0;
  let ne:i32=st[2] as i32;
  let i:i32=0;
  while(i<ne){
    let o:i32=784+i*4;
    let is_src:i32=0;
    if((st[o] as i32)==mid){
      if((st[o+2] as i32)==16){is_src=1;}
    }
    if(is_src==1){
      if(ns<8){srcs[ns]=st[o+1];ns=ns+1;}
    }
    i=i+1;
  }
  if(ns>=2){
    let a:i32=0;
    while(a<ns){
      let b:i32=0;
      while(b<ns){
        if(a!=b){e_add(st,srcs[a] as i32,srcs[b] as i32,15);}
        b=b+1;
      }
      a=a+1;
    }
  }
  st[9]=mid as u8; st[10]=val as u8;
  at=ob_app(ob,at,"ANS via=");
  at=ob_i32(ob,at,mid);
  at=ob_app(ob,at," val=");
  at=ob_i32(ob,at,val);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- pipeline: L1 exact reuse over live MAPs, node-id order ----
fn pipeline(st:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  st[9]=255;
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  let done:i32=0;
  while(mid<nm){
    if(done==0){
      let o:i32=272+mid*32;
      set32(st,1072,get32(st,1072)+1);
      if((st[o+1] as i32)==1){
        let t:i32=m_exec(st,mid,start);
        if(t==target){
          deliver(st,mid,t,ob,atp);
          done=1;
        }
      }
    }
    mid=mid+1;
  }
  return done;
}

// ---- SUBSTITUTE bracket ----
fn sub_cand_ok(st:[]u8, cid:i32, sm:i32, seg_s:i32, seg_e:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let live:i32=ascan_map(st,cid);
  at=ob_app(ob,at,"SUB-CAND id=");
  at=ob_i32(ob,at,cid);
  if(cid==sm){
    at=ob_app(ob,at," skip=self\n");
    set32(atp,0,at);
    return 0;
  }
  if(live==0){
    at=ob_app(ob,at," skip=retired\n");
    set32(atp,0,at);
    return 0;
  }
  let co:i32=272+cid*32;
  let cs:i32=st[co+2] as i32;
  let ce:i32=st[co+3] as i32;
  let epok:i32=0;
  if(cs==seg_s){
    if(ce==seg_e){epok=1;}
  }
  if(epok==0){
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,cs);
    at=ob_app(ob,at," e=");
    at=ob_i32(ob,at,ce);
    at=ob_app(ob,at," skip=ep\n");
    set32(atp,0,at);
    return 0;
  }
  let cfl:i32=st[co+5] as i32;
  let ok:i32=1;
  let flc:i32=0;
  let j:i32=0;
  while(j<cfl){
    let cf:i32=st[co+16+j] as i32;
    let lf:i32=ascan_fact(st,cf);
    flc=flc+1;
    if(lf==0){ok=0;}
    j=j+1;
  }
  if(ok==0){
    at=ob_app(ob,at," skip=deadfact\n");
    set32(atp,0,at);
    return 0;
  }
  at=ob_app(ob,at," s=");
  at=ob_i32(ob,at,cs);
  at=ob_app(ob,at," e=");
  at=ob_i32(ob,at,ce);
  at=ob_app(ob,at," flive=");
  at=ob_i32(ob,at,flc);
  at=ob_app(ob,at," MATCH\n");
  set32(atp,0,at);
  return 1;
}

fn sub_build(st:[]u8, sm:i32, cid:i32, k:i32, pre_f:[]u8, pre_r:[]u8, nsuf:i32, suf_f:[]u8, suf_r:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let co:i32=272+cid*32;
  let cfl:i32=st[co+5] as i32;
  let cr:[]u8=z_alloc(8);
  let cf:[]u8=z_alloc(8);
  let n2:i32=0;
  let j:i32=0;
  while(j<k){cr[n2]=pre_r[j];cf[n2]=pre_f[j];n2=n2+1;j=j+1;}
  j=0;
  while(j<cfl){cr[n2]=st[co+8+j];cf[n2]=st[co+16+j];n2=n2+1;j=j+1;}
  j=0;
  while(j<nsuf){cr[n2]=suf_r[j];cf[n2]=suf_f[j];n2=n2+1;j=j+1;}
  let nm:i32=st[1] as i32;
  let d2:i32=0;
  let dup:i32=0;
  while(d2<nm){
    if(dup==0){
      let dl:i32=ascan_map(st,d2);
      if(dl==1){
        let mm:i32=map_matches(st,d2,cr,cf,n2);
        if(mm==1){dup=1;}
      }
    }
    d2=d2+1;
  }
  if(dup==1){
    at=ob_app(ob,at,"SUB-DUP skip\n");
    set32(atp,0,at);
    return 0;
  }
  at=ob_app(ob,at,"SUB-BUILD rels=");
  j=0;
  while(j<n2){
    at=ob_i32(ob,at,cr[j] as i32);
    if(j<n2-1){at=ob_app(ob,at,",");}
    j=j+1;
  }
  at=ob_app(ob,at," facts=");
  j=0;
  while(j<n2){
    at=ob_i32(ob,at,cf[j] as i32);
    if(j<n2-1){at=ob_app(ob,at,",");}
    j=j+1;
  }
  at=ob_nl(ob,at);
  set32(atp,0,at);
  let term:i32=chain_exec(st,cf,cr,n2,start);
  if(term!=target){
    let ax:i32=get32(atp,0);
    ax=ob_app(ob,ax,"SUB-VERIFY term=");
    ax=ob_i32(ob,ax,term);
    ax=ob_app(ob,ax," MISMATCH\n");
    set32(atp,0,ax);
    return 0;
  }
  let az:i32=get32(atp,0);
  az=ob_app(ob,az,"SUB-VERIFY term=");
  az=ob_i32(ob,az,term);
  az=ob_nl(ob,az);
  let m2:i32=map_create(st,cr,n2,cf,n2,start,target);
  az=ob_app(ob,az,"SUB-PROMOTE m2=");
  az=ob_i32(ob,az,m2);
  az=ob_nl(ob,az);
  e_add(st,m2,sm,16);
  az=ob_app(ob,az,"SUB-T16 ");
  az=ob_i32(ob,az,m2);
  az=ob_app(ob,az,"->");
  az=ob_i32(ob,az,sm);
  az=ob_nl(ob,az);
  e_add(st,m2,cid,16);
  az=ob_app(ob,az,"SUB-T16 ");
  az=ob_i32(ob,az,m2);
  az=ob_app(ob,az,"->");
  az=ob_i32(ob,az,cid);
  az=ob_nl(ob,az);
  map_retire(st,sm,1);
  az=ob_app(ob,az,"SUB-RETIRE m=");
  az=ob_i32(ob,az,sm);
  az=ob_nl(ob,az);
  set32(atp,0,az);
  let t2:i32=m_exec(st,m2,start);
  deliver(st,m2,t2,ob,atp);
  return 1;
}

fn sub_try(st:[]u8, sm:i32, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let smo:i32=272+sm*32;
  let k:i32=st[7] as i32;
  let ff:i32=st[8] as i32;
  at=ob_app(ob,at,"SUB-STALE m=");
  at=ob_i32(ob,at,sm);
  at=ob_app(ob,at," hop=");
  at=ob_i32(ob,at,k);
  at=ob_app(ob,at," fact=");
  at=ob_i32(ob,at,ff);
  at=ob_nl(ob,at);
  let pre_f:[]u8=z_alloc(8);
  let pre_r:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<k){pre_f[i]=st[smo+16+i];pre_r[i]=st[smo+8+i];i=i+1;}
  let suf_f:[]u8=z_alloc(8);
  let suf_r:[]u8=z_alloc(8);
  let rl:i32=st[smo+4] as i32;
  let nsuf:i32=0;
  i=k+1;
  while(i<rl){suf_f[nsuf]=st[smo+16+i];suf_r[nsuf]=st[smo+8+i];nsuf=nsuf+1;i=i+1;}
  let seg_s:i32=start;
  if(k>0){
    let pf:i32=pre_f[k-1] as i32;
    seg_s=st[16+pf*8+2] as i32;
  }
  let seg_e:i32=st[16+ff*8+2] as i32;
  at=ob_app(ob,at,"SUB-SEG s=");
  at=ob_i32(ob,at,seg_s);
  at=ob_app(ob,at," e=");
  at=ob_i32(ob,at,seg_e);
  at=ob_app(ob,at," pre=");
  at=ob_i32(ob,at,k);
  at=ob_app(ob,at," suf=");
  at=ob_i32(ob,at,nsuf);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  let nm:i32=st[1] as i32;
  let cid:i32=0;
  while(cid<nm){
    let mres:i32=sub_cand_ok(st,cid,sm,seg_s,seg_e,ob,atp);
    if(mres==1){
      let bres:i32=sub_build(st,sm,cid,k,pre_f,pre_r,nsuf,suf_f,suf_r,start,target,ob,atp);
      if(bres==1){return 1;}
    }
    cid=cid+1;
  }
  return 0;
}

// ---- rebuild from scratch: iterative deepening over live facts ----
fn rb_extend(st:[]u8, lvf:[]u8, lvn:[]u8, lve:[]u8, nc0:i32, nxf:[]u8, nxn:[]u8, nxv:[]u8)i32 {
  let nc2:i32=0;
  let c:i32=0;
  while(c<nc0){
    let v:i32=lve[c] as i32;
    let cl:i32=lvn[c] as i32;
    let fid:i32=0;
    let nfs:i32=st[0] as i32;
    while(fid<nfs){
      let fl:i32=ascan_fact(st,fid);
      let mt:i32=0;
      if(fl==1){
        if((st[16+fid*8] as i32)==v){mt=1;}
      }
      if(mt==1){
        if(nc2<16){
          let q:i32=0;
          while(q<cl){nxf[nc2*4+q]=lvf[c*4+q];q=q+1;}
          nxf[nc2*4+cl]=fid as u8;
          nxn[nc2]=(cl+1) as u8;
          nxv[nc2]=st[16+fid*8+2];
          nc2=nc2+1;
        }
      }
      fid=fid+1;
    }
    c=c+1;
  }
  return nc2;
}
fn rb_verify(st:[]u8, nxf:[]u8, nxn:[]u8, nc2:i32, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let v:i32=0;
  let win:i32=-1;
  while(v<nc2){
    if(win==-1){
      let cl:i32=nxn[v] as i32;
      let cf:[]u8=z_alloc(8);
      let cr:[]u8=z_alloc(8);
      let q:i32=0;
      while(q<cl){
        let f2:i32=nxf[v*4+q] as i32;
        cf[q]=f2 as u8;
        cr[q]=st[16+f2*8+1];
        q=q+1;
      }
      let term:i32=chain_exec(st,cf,cr,cl,start);
      at=ob_app(ob,at,"RB-CAND L=");
      at=ob_i32(ob,at,cl);
      at=ob_app(ob,at," term=");
      at=ob_i32(ob,at,term);
      at=ob_nl(ob,at);
      if(term==target){win=v;}
    }
    v=v+1;
  }
  set32(atp,0,at);
  return win;
}
fn rebuild_fallback(st:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"RB-START\n");
  set32(atp,0,at);
  let lvf:[]u8=z_alloc(64);
  let lvn:[]u8=z_alloc(16);
  let lve:[]u8=z_alloc(16);
  let nc0:i32=1;
  lvn[0]=0;
  lve[0]=start as u8;
  let L:i32=1;
  let done:i32=0;
  let wv:i32=-1;
  let wnx:[]u8=z_alloc(64);
  let wnn:i32=0;
  while(L<=4){
    if(done==1){L=9;}
    else {
      let nxf:[]u8=z_alloc(64);
      let nxn:[]u8=z_alloc(16);
      let nxv:[]u8=z_alloc(16);
      let nc2:i32=rb_extend(st,lvf,lvn,lve,nc0,nxf,nxn,nxv);
      let w:i32=rb_verify(st,nxf,nxn,nc2,start,target,ob,atp);
      if(w>=0){
        done=1;
        wv=w;
        wnn=nxn[w] as i32;
        let q:i32=0;
        while(q<4){wnx[q]=nxf[w*4+q];q=q+1;}
      }
      else {
        if(nc2==0){L=9;}
        else {
          let cp:i32=0;
          while(cp<nc2){
            let q:i32=0;
            while(q<4){lvf[cp*4+q]=nxf[cp*4+q];q=q+1;}
            lvn[cp]=nxn[cp];
            lve[cp]=nxv[cp];
            cp=cp+1;
          }
          nc0=nc2;
          L=L+1;
        }
      }
    }
  }
  if(done==0){return 0;}
  let cf:[]u8=z_alloc(8);
  let cr:[]u8=z_alloc(8);
  let q:i32=0;
  while(q<wnn){
    let f2:i32=wnx[q] as i32;
    cf[q]=f2 as u8;
    cr[q]=st[16+f2*8+1];
    q=q+1;
  }
  let m3:i32=map_create(st,cr,wnn,cf,wnn,start,target);
  let az:i32=get32(atp,0);
  az=ob_app(ob,az,"RB-BUILD m3=");
  az=ob_i32(ob,az,m3);
  az=ob_nl(ob,az);
  set32(atp,0,az);
  let t2:i32=m_exec(st,m3,start);
  deliver(st,m3,t2,ob,atp);
  return 1;
}

fn sub_bracket(st:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"SUB-BRACKET\n");
  set32(atp,0,at);
  let nm:i32=st[1] as i32;
  let sm:i32=-1;
  let mid:i32=0;
  while(mid<nm){
    if(sm==-1){
      let live:i32=ascan_map(st,mid);
      if(live==1){
        let t:i32=m_exec(st,mid,start);
        let stm:i32=st[6] as i32;
        if(stm==mid){sm=mid;}
      }
    }
    mid=mid+1;
  }
  if(sm>=0){
    let r:i32=sub_try(st,sm,start,target,ob,atp);
    if(r==1){return 1;}
  }
  return rebuild_fallback(st,start,target,ob,atp);
}

// ---- extend/truncate control operators ----
fn et_trunc_one(st:[]u8, mid:i32, start:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let t:i32=m_exec(st,mid,start);
  let stm:i32=st[6] as i32;
  if(stm!=mid){set32(atp,0,at);return 0;}
  let k:i32=st[7] as i32;
  if(k<1){set32(atp,0,at);return 0;}
  let mo:i32=272+mid*32;
  let tr:[]u8=z_alloc(8);
  let tf:[]u8=z_alloc(8);
  let j:i32=0;
  while(j<k){tr[j]=st[mo+8+j];tf[j]=st[mo+16+j];j=j+1;}
  let lf:i32=tf[k-1] as i32;
  let endn:i32=st[16+lf*8+2] as i32;
  let term:i32=chain_exec(st,tf,tr,k,start);
  if(term!=endn){set32(atp,0,at);return 0;}
  let t1:i32=map_create(st,tr,k,tf,k,start,endn);
  at=ob_app(ob,at,"ET-TRUNC t=");
  at=ob_i32(ob,at,t1);
  at=ob_app(ob,at," from=");
  at=ob_i32(ob,at,mid);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  e_add(st,t1,mid,16);
  map_retire(st,mid,2);
  return 1;
}
fn et_truncate(st:[]u8, start:i32, ob:[]u8, atp:[]u8)i32 {
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let live:i32=ascan_map(st,mid);
    if(live==1){
      let r:i32=et_trunc_one(st,mid,start,ob,atp);
      if(r==1){return 1;}
    }
    mid=mid+1;
  }
  return 0;
}
fn et_ext_one(st:[]u8, mid:i32, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let t:i32=m_exec(st,mid,start);
  let stm:i32=st[6] as i32;
  if(stm==mid){set32(atp,0,at);return 0;}
  if(t<0){set32(atp,0,at);return 0;}
  if(t==target){set32(atp,0,at);return 0;}
  let nfs:i32=st[0] as i32;
  let fid:i32=0;
  let found:i32=-1;
  while(fid<nfs){
    if(found==-1){
      let fl:i32=ascan_fact(st,fid);
      if(fl==1){
        if((st[16+fid*8] as i32)==t){found=fid;}
      }
    }
    fid=fid+1;
  }
  if(found<0){set32(atp,0,at);return 0;}
  let mo:i32=272+mid*32;
  let rl:i32=st[mo+4] as i32;
  let er:[]u8=z_alloc(8);
  let ef:[]u8=z_alloc(8);
  let j:i32=0;
  while(j<rl){er[j]=st[mo+8+j];ef[j]=st[mo+16+j];j=j+1;}
  er[rl]=st[16+found*8+1];
  ef[rl]=found as u8;
  let eend:i32=st[16+found*8+2] as i32;
  let term:i32=chain_exec(st,ef,er,rl+1,start);
  if(term!=eend){set32(atp,0,at);return 0;}
  let e1:i32=map_create(st,er,rl+1,ef,rl+1,start,eend);
  at=ob_app(ob,at,"ET-EXTEND e=");
  at=ob_i32(ob,at,e1);
  at=ob_app(ob,at," from=");
  at=ob_i32(ob,at,mid);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  e_add(st,e1,mid,16);
  return 1;
}
fn et_bracket(st:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"ET-BRACKET\n");
  set32(atp,0,at);
  let r1:i32=et_truncate(st,start,ob,atp);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let live:i32=ascan_map(st,mid);
    if(live==1){
      let r2:i32=et_ext_one(st,mid,start,target,ob,atp);
    }
    mid=mid+1;
  }
  return;
}

// ---- top-level query ----
fn ev_query(st:[]u8, start:i32, target:i32, ob:[]u8, atp:[]u8)i32 {
  let ok:i32=pipeline(st,start,target,ob,atp);
  if(ok==1){return st[10] as i32;}
  set32(st,1080,0);
  set32(st,1084,0);
  st[11]=1;
  let ans:i32=-2;
  let subon:i32=st[3] as i32;
  if(subon==1){
    let r:i32=sub_bracket(st,start,target,ob,atp);
    st[11]=0;
    if(r==1){ans=st[10] as i32;}
    return ans;
  }
  let eton:i32=st[4] as i32;
  if(eton==1){
    et_bracket(st,start,target,ob,atp);
    st[11]=0;
    let ok2:i32=pipeline(st,start,target,ob,atp);
    if(ok2==1){ans=st[10] as i32;}
  }
  st[11]=0;
  return ans;
}
// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen price-fact table and the world-change kill. The learner
// never calls w_kill; it only observes facts via f_teach and
// discovers the death through execution outcomes.
// Node ids are subtotal states in dollars. Relation 7 = ADD,
// 8 = ITEMIZED-ADD, 9 = unrelated.
// Fact ids: 0:(0,7,15) 1:(15,7,70) 2:(70,7,90) 3:(15,8,40)
//           4:(40,8,70) 5:(0,9,200) 6:(200,9,210)
//           7:(100,7,115) 8:(115,7,140)
// Hand-derived total: 15 + 55 + 20 = 90; bundle path
// 15 + 25 + 30 + 20 = 90.

fn w_fact(i:i32, out:[]u8)void {
  if(i==0){out[0]=0;out[1]=7;out[2]=15;return;}
  if(i==1){out[0]=15;out[1]=7;out[2]=70;return;}
  if(i==2){out[0]=70;out[1]=7;out[2]=90;return;}
  if(i==3){out[0]=15;out[1]=8;out[2]=40;return;}
  if(i==4){out[0]=40;out[1]=8;out[2]=70;return;}
  if(i==5){out[0]=0;out[1]=9;out[2]=200;return;}
  if(i==6){out[0]=200;out[1]=9;out[2]=210;return;}
  if(i==7){out[0]=100;out[1]=7;out[2]=115;return;}
  out[0]=115;out[1]=7;out[2]=140;
  return;
}
fn w_nfacts()i32 { return 9; }

// World change: a price fact dies. Environment act only.
fn w_kill(st:[]u8, fid:i32)void {
  st[16+fid*8+3]=0;
  return;
}
// driver.zag -- L2-TRANSFER-SUBST experiment driver (arithmetic).
// Five arms, kill-bar evaluation. The driver teaches price facts and
// SUM MAPs, applies the world change (kill), and runs queries. It
// never selects the substitute piece: all substitution goes through
// learner.zag, which is byte-identical to the C298 chain-family file.
// Prereg: l2_transfer_subst/PREREG.md (commit 733c2d7e0). Pure Zag.

fn d_teach_facts(st:[]u8)void {
  let out:[]u8=z_alloc(8);
  let i:i32=0;
  let nf:i32=w_nfacts();
  while(i<nf){
    w_fact(i,out);
    f_teach(st,out[0] as i32,out[1] as i32,out[2] as i32);
    i=i+1;
  }
  return;
}
fn d_log2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
// Phase 0: teach price facts, teach SUM MAP m / bundle piece n /
// distractor d, verify m and n by execution.
// res: [0]=inter [4]=a1(M-OK) [8]=a2(N-OK).
fn d_phase0(st:[]u8, ob:[]u8, atp:[]u8, res:[]u8)i32 {
  d_teach_facts(st);
  let r0:[]u8=z_alloc(8);
  let f0:[]u8=z_alloc(8);
  r0[0]=7; r0[1]=7; r0[2]=7;
  f0[0]=0; f0[1]=1; f0[2]=2;
  let m0:i32=m_teach(st,r0,3,f0,3,0,90);
  let r1:[]u8=z_alloc(8);
  let f1:[]u8=z_alloc(8);
  r1[0]=8; r1[1]=8;
  f1[0]=3; f1[1]=4;
  let m1:i32=m_teach(st,r1,2,f1,2,15,70);
  let r2:[]u8=z_alloc(8);
  let f2:[]u8=z_alloc(8);
  r2[0]=9;
  f2[0]=5;
  let m2:i32=m_teach(st,r2,1,f2,1,0,200);
  d_log2(ob,atp,"M-TEACH m=",m0," n=",m1);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"M-TEACH d=");
  at=ob_i32(ob,at,m2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  let a1:i32=ev_query(st,0,90,ob,atp);
  let v1:i32=st[9] as i32;
  d_log2(ob,atp,"M-OK ans=",a1," via=",v1);
  let a2:i32=ev_query(st,15,70,ob,atp);
  let v2:i32=st[9] as i32;
  d_log2(ob,atp,"N-OK ans=",a2," via=",v2);
  let inter:i32=0;
  let p:i32=0;
  while(p<3){
    let q:i32=0;
    while(q<2){
      if((f0[p] as i32)==(f1[q] as i32)){inter=1;}
      q=q+1;
    }
    p=p+1;
  }
  at=get32(atp,0);
  at=ob_app(ob,at,"INTERSECT=");
  at=ob_i32(ob,at,inter);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  set32(res,0,inter);
  set32(res,4,a1);
  set32(res,8,a2);
  return inter;
}
fn d_edgecensus(st:[]u8, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"EDGES ");
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," t16=");
  at=ob_i32(ob,at,e_count(st,16));
  at=ob_app(ob,at," t15=");
  at=ob_i32(ob,at,e_count(st,15));
  at=ob_app(ob,at," t14=");
  at=ob_i32(ob,at,e_count(st,14));
  at=ob_app(ob,at," other=");
  at=ob_i32(ob,at,e_other(st));
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_mapdump(st:[]u8, mid:i32, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  let o:i32=272+mid*32;
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," id=");
  at=ob_i32(ob,at,mid);
  at=ob_app(ob,at," rels=");
  let rl:i32=st[o+4] as i32;
  let k:i32=0;
  while(k<rl){
    at=ob_i32(ob,at,st[o+8+k] as i32);
    if(k<rl-1){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_app(ob,at," s=");
  at=ob_i32(ob,at,st[o+2] as i32);
  at=ob_app(ob,at," e=");
  at=ob_i32(ob,at,st[o+3] as i32);
  at=ob_app(ob,at," live=");
  at=ob_i32(ob,at,st[o+1] as i32);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_bar(tag:[]u8, pass:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,pass);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_kill_line(ob:[]u8, atp:[]u8, fid:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"KILL fact=");
  at=ob_i32(ob,at,fid);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(4);
  set32(atp,0,0);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"L2-TRANSFER-SUBST-START\n");
  set32(atp,0,at);
  let res:[]u8=z_alloc(16);

  // ================= ARM-FULL =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-FULL ===\n");
  set32(atp,0,at);
  let stF:[]u8=z_alloc(2048);
  stF[3]=1;
  let inter:i32=d_phase0(stF,ob,atp,res);
  let a1m:i32=get32(res,4);
  let a2n:i32=get32(res,8);
  w_kill(stF,1);
  d_kill_line(ob,atp,1);
  let ansF:i32=ev_query(stF,0,90,ob,atp);
  let viaF:i32=stF[9] as i32;
  let asF:i32=get32(stF,1080);
  let aeF:i32=get32(stF,1084);
  d_log2(ob,atp,"ADAPT S=",asF," E=",aeF);
  d_edgecensus(stF,"FULL",ob,atp);
  d_mapdump(stF,3,"M2",ob,atp);
  let t16F:i32=e_count(stF,16);
  let t15F:i32=e_count(stF,15);
  let othF:i32=e_other(stF);
  let ansP:i32=ev_query(stF,0,90,ob,atp);
  let viaP:i32=stF[9] as i32;
  let m0live:i32=stF[273] as i32;
  d_log2(ob,atp,"POST ans=",ansP," via=",viaP);
  at=get32(atp,0);
  at=ob_app(ob,at,"POST m0live=");
  at=ob_i32(ob,at,m0live);
  at=ob_nl(ob,at);
  set32(atp,0,at);

  // ================= ARM-NO-SUB =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-NO-SUB ===\n");
  set32(atp,0,at);
  let stN:[]u8=z_alloc(2048);
  stN[4]=1;
  d_phase0(stN,ob,atp,res);
  w_kill(stN,1);
  d_kill_line(ob,atp,1);
  let ansNS:i32=ev_query(stN,0,90,ob,atp);
  let t16NS:i32=e_count(stN,16);
  d_edgecensus(stN,"NOSUB",ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"NOSUB ans=");
  at=ob_i32(ob,at,ansNS);
  at=ob_nl(ob,at);
  set32(atp,0,at);

  // ================= ARM-ABLATE-N =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-ABLATE-N ===\n");
  set32(atp,0,at);
  let stAN:[]u8=z_alloc(2048);
  stAN[3]=1;
  d_phase0(stAN,ob,atp,res);
  map_retire(stAN,1,3);
  at=get32(atp,0);
  at=ob_app(ob,at,"N-RETIRED\n");
  set32(atp,0,at);
  w_kill(stAN,1);
  d_kill_line(ob,atp,1);
  let ansAN:i32=ev_query(stAN,0,90,ob,atp);
  let viaAN:i32=stAN[9] as i32;
  let asAN:i32=get32(stAN,1080);
  let aeAN:i32=get32(stAN,1084);
  d_log2(ob,atp,"ADAPT S=",asAN," E=",aeAN);
  d_edgecensus(stAN,"ABLN",ob,atp);
  d_mapdump(stAN,3,"M3",ob,atp);
  let t16AN:i32=e_count(stAN,16);
  at=get32(atp,0);
  at=ob_app(ob,at,"ABLN ans=");
  at=ob_i32(ob,at,ansAN);
  at=ob_app(ob,at," via=");
  at=ob_i32(ob,at,viaAN);
  at=ob_nl(ob,at);
  set32(atp,0,at);

  // ================= ARM-ABLATE-M =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-ABLATE-M ===\n");
  set32(atp,0,at);
  let stAM:[]u8=z_alloc(2048);
  stAM[3]=1;
  d_phase0(stAM,ob,atp,res);
  w_kill(stAM,1);
  d_kill_line(ob,atp,1);
  w_kill(stAM,0);
  d_kill_line(ob,atp,0);
  let ansAM:i32=ev_query(stAM,0,90,ob,atp);
  let t16AM:i32=e_count(stAM,16);
  let nmAM:i32=stAM[1] as i32;
  d_edgecensus(stAM,"ABLM",ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"ABLM ans=");
  at=ob_i32(ob,at,ansAM);
  at=ob_app(ob,at," nm=");
  at=ob_i32(ob,at,nmAM);
  at=ob_nl(ob,at);
  set32(atp,0,at);

  // ================= ARM-FRESH =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-FRESH ===\n");
  set32(atp,0,at);
  let stFR:[]u8=z_alloc(2048);
  stFR[3]=1;
  d_teach_facts(stFR);
  w_kill(stFR,1);
  d_kill_line(ob,atp,1);
  let ansFR:i32=ev_query(stFR,0,90,ob,atp);
  let viaFR:i32=stFR[9] as i32;
  let asFR:i32=get32(stFR,1080);
  let aeFR:i32=get32(stFR,1084);
  d_log2(ob,atp,"ADAPT S=",asFR," E=",aeFR);
  d_edgecensus(stFR,"FRESH",ob,atp);
  d_mapdump(stFR,0,"M3",ob,atp);
  let t16FR:i32=e_count(stFR,16);
  at=get32(atp,0);
  at=ob_app(ob,at,"FRESH ans=");
  at=ob_i32(ob,at,ansFR);
  at=ob_app(ob,at," via=");
  at=ob_i32(ob,at,viaFR);
  at=ob_nl(ob,at);
  set32(atp,0,at);

  // ================= KILL BARS =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  set32(atp,0,at);
  let k1:i32=1;
  if(inter!=0){k1=0;}
  if(a1m!=90){k1=0;}
  if(a2n!=70){k1=0;}
  d_bar("K-1",k1,ob,atp);
  let k2a:i32=1;
  if(t16AN!=0){k2a=0;}
  if(ansAN!=90){k2a=0;}
  if(asAN<5*asF){k2a=0;}
  d_bar("K-2a",k2a,ob,atp);
  let k2b:i32=1;
  if(ansAM!=-2){k2b=0;}
  if(t16AM!=0){k2b=0;}
  if(nmAM!=3){k2b=0;}
  d_bar("K-2b",k2b,ob,atp);
  let k3:i32=1;
  if(t16FR!=0){k3=0;}
  if(ansFR!=90){k3=0;}
  if(asFR<5*asF){k3=0;}
  d_bar("K-3",k3,ob,atp);
  let k5:i32=1;
  if(ansNS!=-2){k5=0;}
  if(t16NS!=3){k5=0;}
  d_bar("K-5",k5,ob,atp);
  let k6:i32=1;
  if(m0live!=0){k6=0;}
  if(ansP!=90){k6=0;}
  if(viaP!=3){k6=0;}
  d_bar("K-6",k6,ob,atp);
  let k7:i32=1;
  if(t16F!=2){k7=0;}
  if(e_has(stF,3,0,16)!=1){k7=0;}
  if(e_has(stF,3,1,16)!=1){k7=0;}
  if(t15F!=2){k7=0;}
  if(e_has(stF,0,1,15)!=1){k7=0;}
  if(e_has(stF,1,0,15)!=1){k7=0;}
  if(e_has_to(stF,3,14)!=1){k7=0;}
  if(othF!=0){k7=0;}
  d_bar("K-7",k7,ob,atp);
  let k10:i32=1;
  if(ansF!=90){k10=0;}
  if(viaF!=3){k10=0;}
  let mo3:i32=272+3*32;
  if((stF[mo3+1] as i32)!=1){k10=0;}
  if((stF[mo3+2] as i32)!=0){k10=0;}
  if((stF[mo3+3] as i32)!=90){k10=0;}
  if((stF[mo3+4] as i32)!=4){k10=0;}
  if((stF[mo3+8] as i32)!=7){k10=0;}
  if((stF[mo3+9] as i32)!=8){k10=0;}
  if((stF[mo3+10] as i32)!=8){k10=0;}
  if((stF[mo3+11] as i32)!=7){k10=0;}
  d_bar("K-10",k10,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"K-4 K-8 K-9 K-11 K-12 see-shell\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2a=");
  at=ob_i32(ob,at,k2a);
  at=ob_app(ob,at," k2b=");
  at=ob_i32(ob,at,k2b);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k10=");
  at=ob_i32(ob,at,k10);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"L2-TRANSFER-SUBST-END\n");
  set32(atp,0,at);

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// cam1.zag - CAM-1 construct-and-apply with trial-based P-DEP.
//
// Implements PROPOSE -> VERIFY -> PROMOTE -> APPLY per the frozen specs:
//   CAM-1 prereg (68a41be8a), integration spec A1-A12 (62e5ebb9f),
//   ISA boundary ruling (0525377f3).
//
// CRITICAL: finite-difference analysis is OUT. P-DEP discovers
// regularities by trial over the frozen {EQ, ADD} basis: compose
// candidate expressions from basis ops, corroborate each against
// exemplars, promote what predicts. The core provides mechanism
// (ADD, EQ, storage, traversal); the learner-side policy tries,
// tests, and keeps. No FIND_POLYNOMIAL_ORDER in the core.
//
// Workspace format (CLA-2): one node store, fixed records
// (type_tag, ref[4], payload[4]) = 9 i32 = 36 bytes per node.
// Edges: (from, to, etype) = 3 i32 = 12 bytes per edge.
// Standing = count(SUPPORTS) - count(CONTRADICTS), computed,
// never stored (A5/A11).
//
// Pure Zag. Pinned compiler znc_linux_x86_64_abed8aa1.
// Compiler workaround: u8-backed cells with get32/set32;
// never `as *i32` slice construction inside functions.

// ---------- memory ----------

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---------- workspace ----------

// Node = 36 bytes: tag(0) ref0(4) ref1(8) ref2(12) ref3(16)
//                  pay0(20) pay1(24) pay2(28) pay3(32)
fn n_tag(ws:[]u8, n:i32)i32 { return get32(ws, n*36); }
fn n_set_tag(ws:[]u8, n:i32, v:i32)void { set32(ws, n*36, v); return; }
fn n_ref(ws:[]u8, n:i32, k:i32)i32 { return get32(ws, n*36+4+k*4); }
fn n_set_ref(ws:[]u8, n:i32, k:i32, v:i32)void { set32(ws, n*36+4+k*4, v); return; }
fn n_pay(ws:[]u8, n:i32, k:i32)i32 { return get32(ws, n*36+20+k*4); }
fn n_set_pay(ws:[]u8, n:i32, k:i32, v:i32)void { set32(ws, n*36+20+k*4, v); return; }

// Edge = 12 bytes: from(0) to(4) etype(8)
fn e_from(es:[]u8, e:i32)i32 { return get32(es, e*12); }
fn e_to(es:[]u8, e:i32)i32 { return get32(es, e*12+4); }
fn e_type(es:[]u8, e:i32)i32 { return get32(es, e*12+8); }
fn e_set(es:[]u8, e:i32, f:i32, t:i32, ty:i32)void {
  set32(es, e*12, f); set32(es, e*12+4, t); set32(es, e*12+8, ty);
  return;
}

// Node types (learner-assigned; core never interprets)
fn T_FACT()i32 { return 1; }
fn T_MAP()i32 { return 2; }
fn T_GROUP()i32 { return 3; }
// Edge types
fn E_SUPPORTS()i32 { return 1; }
fn E_INSTANCE_OF()i32 { return 2; }
fn E_CONTRADICTS()i32 { return 3; }
fn E_MEMBER()i32 { return 4; }
fn E_DEPENDS_ON()i32 { return 5; }
// MAP body kinds (trial-discovered templates over {EQ, ADD})
fn B_LITERAL()i32 { return 0; }  // P-INV: payload[3] = constant
fn B_COPY_A()i32 { return 1; }   // z = obj(input_rel_a)
fn B_COPY_B()i32 { return 2; }   // z = obj(input_rel_b)
fn B_ADD_AB()i32 { return 3; }   // z = obj(a) + obj(b)
fn B_DBL_A()i32 { return 4; }    // z = obj(a) + obj(a)
fn B_DBL_B()i32 { return 5; }    // z = obj(b) + obj(b)

// Learner context lives in caller-owned arrays; passed explicitly.
// ws: node store ([]u8, 36 bytes/node). es: edge store ([]u8, 12/edge).
// Counts are kept in small i32 cells via get32/set32.

// ---------- allocation and edges ----------

// meta: [nnodes, nedges, maxnodes, maxedges] as 4 i32 in u8 cell
fn m_nn(m:[]u8)i32 { return get32(m, 0); }
fn m_ne(m:[]u8)i32 { return get32(m, 4); }
fn m_set_nn(m:[]u8, v:i32)void { set32(m, 0, v); return; }
fn m_set_ne(m:[]u8, v:i32)void { set32(m, 4, v); return; }
fn m_maxn(m:[]u8)i32 { return get32(m, 8); }
fn m_maxe(m:[]u8)i32 { return get32(m, 12); }

fn ws_alloc(ws:[]u8, m:[]u8)i32 {
  let n:i32=m_nn(m);
  if(n>=m_maxn(m)){ return -1; }
  m_set_nn(m, n+1);
  // zero the record
  let k:i32=0;
  while(k<9){ set32(ws, n*36+k*4, 0); k=k+1; }
  return n;
}
fn es_add(es:[]u8, m:[]u8, f:i32, t:i32, ty:i32)i32 {
  let e:i32=m_ne(m);
  if(e>=m_maxe(m)){ return -1; }
  m_set_ne(m, e+1);
  e_set(es, e, f, t, ty);
  return e;
}

// Standing of node n = SUPPORTS(+1) + USE(+1) + CONFIRMS(+1) - CONTRADICTS(-1).
// Computed from edges; never stored (A5/A11).
fn standing(ws:[]u8, es:[]u8, m:[]u8, n:i32)i32 {
  let s:i32=0;
  let ne:i32=m_ne(m);
  let e:i32=0;
  while(e<ne){
    if(e_to(es,e)==n){
      let ty:i32=e_type(es,e);
      if(ty==E_SUPPORTS()){ s=s+1; }
      if(ty==E_CONTRADICTS()){ s=s-1; }
    }
    e=e+1;
  }
  return s;
}
// Count edges of a given type pointing at n.
fn count_edges_to(es:[]u8, m:[]u8, n:i32, ty:i32)i32 {
  let c:i32=0;
  let ne:i32=m_ne(m);
  let e:i32=0;
  while(e<ne){
    if(e_to(es,e)==n && e_type(es,e)==ty){ c=c+1; }
    e=e+1;
  }
  return c;
}

// ---------- teach: store a triple as a FACT node ----------

// FACT: tag=1, ref0=subject, ref1=relation, ref2=object, ref3=0.
fn teach(ws:[]u8, es:[]u8, m:[]u8, s:i32, r:i32, o:i32)i32 {
  let n:i32=ws_alloc(ws, m);
  if(n<0){ return -1; }
  n_set_tag(ws, n, T_FACT());
  n_set_ref(ws, n, 0, s);
  n_set_ref(ws, n, 1, r);
  n_set_ref(ws, n, 2, o);
  return n;
}
// Exact-key lookup: FACT with (s, r). Returns node addr or -1.
fn lookup(ws:[]u8, m:[]u8, s:i32, r:i32)i32 {
  let nn:i32=m_nn(m);
  let n:i32=0;
  while(n<nn){
    if(n_tag(ws,n)==T_FACT() && n_ref(ws,n,0)==s && n_ref(ws,n,1)==r){
      return n;
    }
    n=n+1;
  }
  return -1;
}
fn fact_obj(ws:[]u8, n:i32)i32 { return n_ref(ws, n, 2); }

// ---------- PROPOSE: alignment ----------

// Alignment group: subjects sharing the same relation set.
// align() scans FACT nodes, groups subjects by sorted relation-set
// signature (purely structural; no domain labels), and fills:
//   reltab[g*MAXR+k] = relation ids, reln[g] = count
//   subtab[g*MAXS+k] = subject ids,  subn[g] = count
// Returns ng (number of groups).

fn align(ws:[]u8, es:[]u8, m:[]u8, subj:[]u8, nsubj:i32,
         reltab:[]u8, reln:[]u8, subtab:[]u8, subn:[]u8,
         maxr:i32, maxs:i32, maxg:i32)i32 {
  let ng:i32=0;
  let si:i32=0;
  while(si<nsubj){
    let s:i32=get32(subj, si*4);
    // collect distinct relations for s
    let rs:[]u8=z_alloc(maxr*4);
    let nr:i32=0;
    let nn:i32=m_nn(m);
    let n:i32=0;
    while(n<nn){
      if(n_tag(ws,n)==T_FACT() && n_ref(ws,n,0)==s){
        let r:i32=n_ref(ws,n,1);
        let k:i32=0; let found:i32=0;
        while(k<nr){ if(get32(rs,k*4)==r){ found=1; } k=k+1; }
        if(found==0 && nr<maxr){ set32(rs, nr*4, r); nr=nr+1; }
      }
      n=n+1;
    }
    // insertion sort rs[0..nr)
    let a:i32=0;
    while(a<nr){
      let b:i32=a+1;
      while(b<nr){
        if(get32(rs,b*4)<get32(rs,a*4)){
          let t:i32=get32(rs,a*4);
          set32(rs,a*4,get32(rs,b*4)); set32(rs,b*4,t);
        }
        b=b+1;
      }
      a=a+1;
    }
    // find matching group by signature equality
    let g:i32=0; let mg:i32=-1;
    while(g<ng){
      if(get32(reln,g*4)==nr){
        let k:i32=0; let ok:i32=1;
        while(k<nr){
          if(get32(reltab,(g*maxr+k)*4)!=get32(rs,k*4)){ ok=0; }
          k=k+1;
        }
        if(ok==1){ mg=g; }
      }
      g=g+1;
    }
    if(mg<0){
      if(ng>=maxg){ return ng; }
      mg=ng; ng=ng+1;
      set32(reln, mg*4, nr);
      set32(subn, mg*4, 0);
      let k:i32=0;
      while(k<nr){ set32(reltab,(mg*maxr+k)*4,get32(rs,k*4)); k=k+1; }
    }
    let sn:i32=get32(subn, mg*4);
    if(sn<maxs){
      set32(subtab, (mg*maxs+sn)*4, s);
      set32(subn, mg*4, sn+1);
    }
    si=si+1;
  }
  return ng;
}
// Materialize a GROUP node for group g (GROUP/MEMBER convention, IP-3).
fn materialize_group(ws:[]u8, es:[]u8, m:[]u8,
                     reltab:[]u8, reln:[]u8, subtab:[]u8, subn:[]u8,
                     g:i32, maxr:i32, maxs:i32)i32 {
  let gn:i32=ws_alloc(ws, m);
  if(gn<0){ return -1; }
  n_set_tag(ws, gn, T_GROUP());
  n_set_ref(ws, gn, 0, get32(reln, g*4));
  let sn:i32=0;
  while(sn<get32(subn,g*4)){
    let s:i32=get32(subtab,(g*maxs+sn)*4);
    let nn:i32=m_nn(m);
    let n:i32=0;
    while(n<nn){
      if(n_tag(ws,n)==T_FACT() && n_ref(ws,n,0)==s){
        es_add(es, m, gn, n, E_MEMBER());
        n=nn;
      }
      n=n+1;
    }
    sn=sn+1;
  }
  return gn;
}

// ---------- PROPOSE: P-INV and trial-based P-DEP ----------

// subj_obj: object of (s, r), or NOFACT sentinel if absent.
fn subj_obj(ws:[]u8, m:[]u8, s:i32, r:i32)i32 {
  let n:i32=lookup(ws, m, s, r);
  if(n<0){ return -999999; }
  return fact_obj(ws, n);
}

// propose() fills candtab[c*5+k] = [trigger_rel, body_kind,
// input_rel_a, input_rel_b, literal_val]. Returns ncand.
// For each relation R_t in group g:
//   P-INV: object constant across group subjects -> B_LITERAL.
//   P-DEP (trial-based, finite-difference is OUT): if varying,
//     try basis templates over co-occurring relations:
//       B_COPY_A: z = obj(R_a)
//       B_DBL_A:  z = obj(R_a) + obj(R_a)
//       B_ADD_AB: z = obj(R_a) + obj(R_b)
//     A template becomes a candidate iff it holds (via EQ) on
//     EVERY construction subject. Priority: COPY_A, DBL_A, ADD_AB.
//     This is trial/compositional discovery: the core supplies
//     ADD and EQ; the policy tries combinations and keeps what
//     predicts. No order detection, no coefficient fitting.
fn propose(ws:[]u8, es:[]u8, m:[]u8,
           reltab:[]u8, reln:[]u8, subtab:[]u8, subn:[]u8,
           g:i32, maxr:i32, maxs:i32,
           candtab:[]u8, maxc:i32)i32 {
  let nc:i32=0;
  let nr:i32=get32(reln, g*4);
  let ns:i32=get32(subn, g*4);
  let ti:i32=0;
  while(ti<nr){
    let rt:i32=get32(reltab, (g*maxr+ti)*4);
    // collect objects of rt across subjects
    let o0:i32=subj_obj(ws, m, get32(subtab,(g*maxs+0)*4), rt);
    let allconst:i32=1;
    let si:i32=1;
    while(si<ns){
      let o:i32=subj_obj(ws, m, get32(subtab,(g*maxs+si)*4), rt);
      if(o!=o0){ allconst=0; }
      si=si+1;
    }
    if(allconst==1 && o0!=-999999){
      // P-INV: constant map
      if(nc<maxc){
        set32(candtab,(nc*5+0)*4, rt);
        set32(candtab,(nc*5+1)*4, B_LITERAL());
        set32(candtab,(nc*5+2)*4, 0);
        set32(candtab,(nc*5+3)*4, 0);
        set32(candtab,(nc*5+4)*4, o0);
        nc=nc+1;
      }
    } else {
      // P-DEP trial-based. Single-input templates first.
      let ai:i32=0;
      let found:i32=0;
      while(ai<nr && found==0){
        let ra:i32=get32(reltab,(g*maxr+ai)*4);
        if(ra!=rt){
          // B_COPY_A: z = obj(ra) on all subjects?
          let ok:i32=1;
          let si2:i32=0;
          while(si2<ns){
            let s:i32=get32(subtab,(g*maxs+si2)*4);
            let zt:i32=subj_obj(ws,m,s,rt);
            let za:i32=subj_obj(ws,m,s,ra);
            if(zt==-999999 || za==-999999 || zt!=za){ ok=0; }
            si2=si2+1;
          }
          if(ok==1 && nc<maxc){
            set32(candtab,(nc*5+0)*4, rt);
            set32(candtab,(nc*5+1)*4, B_COPY_A());
            set32(candtab,(nc*5+2)*4, ra);
            set32(candtab,(nc*5+3)*4, 0);
            set32(candtab,(nc*5+4)*4, 0);
            nc=nc+1; found=1;
          }
          // B_DBL_A: z = obj(ra)+obj(ra) on all subjects?
          if(found==0){
            let ok2:i32=1;
            let si3:i32=0;
            while(si3<ns){
              let s:i32=get32(subtab,(g*maxs+si3)*4);
              let zt:i32=subj_obj(ws,m,s,rt);
              let za:i32=subj_obj(ws,m,s,ra);
              if(zt==-999999 || za==-999999 || zt!=za+za){ ok2=0; }
              si3=si3+1;
            }
            if(ok2==1 && nc<maxc){
              set32(candtab,(nc*5+0)*4, rt);
              set32(candtab,(nc*5+1)*4, B_DBL_A());
              set32(candtab,(nc*5+2)*4, ra);
              set32(candtab,(nc*5+3)*4, 0);
              set32(candtab,(nc*5+4)*4, 0);
              nc=nc+1; found=1;
            }
          }
        }
        ai=ai+1;
      }
      // Two-input template B_ADD_AB.
      if(found==0){
        let ai2:i32=0;
        while(ai2<nr && found==0){
          let ra:i32=get32(reltab,(g*maxr+ai2)*4);
          if(ra!=rt){
            let bi:i32=0;
            while(bi<nr && found==0){
              let rb:i32=get32(reltab,(g*maxr+bi)*4);
              if(rb!=rt && rb!=ra){
                let ok:i32=1;
                let si4:i32=0;
                while(si4<ns){
                  let s:i32=get32(subtab,(g*maxs+si4)*4);
                  let zt:i32=subj_obj(ws,m,s,rt);
                  let za:i32=subj_obj(ws,m,s,ra);
                  let zb:i32=subj_obj(ws,m,s,rb);
                  if(zt==-999999 || za==-999999 || zb==-999999
                     || zt!=za+zb){ ok=0; }
                  si4=si4+1;
                }
                if(ok==1 && nc<maxc){
                  set32(candtab,(nc*5+0)*4, rt);
                  set32(candtab,(nc*5+1)*4, B_ADD_AB());
                  set32(candtab,(nc*5+2)*4, ra);
                  set32(candtab,(nc*5+3)*4, rb);
                  set32(candtab,(nc*5+4)*4, 0);
                  nc=nc+1; found=1;
                }
              }
              bi=bi+1;
            }
          }
          ai2=ai2+1;
        }
      }
    }
    ti=ti+1;
  }
  return nc;
}

// ---------- VERIFY and PROMOTE ----------

// eval_body: predict the object for subject s under candidate
// (c0=trigger, c1=kind, c2=in_a, c3=in_b, c4=literal).
// Uses only EQ and ADD over stored facts. Returns -999999 if
// the body cannot be evaluated (missing input fact).
fn eval_body(ws:[]u8, m:[]u8,
             c0:i32, c1:i32, c2:i32, c3:i32, c4:i32, s:i32)i32 {
  if(c1==B_LITERAL()){ return c4; }
  if(c1==B_COPY_A()){ return subj_obj(ws, m, s, c2); }
  if(c1==B_DBL_A()){
    let a:i32=subj_obj(ws, m, s, c2);
    if(a==-999999){ return -999999; }
    return a+a;
  }
  if(c1==B_ADD_AB()){
    let a:i32=subj_obj(ws, m, s, c2);
    let b:i32=subj_obj(ws, m, s, c3);
    if(a==-999999 || b==-999999){ return -999999; }
    return a+b;
  }
  return -999999;
}

// verify: candidate must predict EVERY held-back triple whose
// relation matches the trigger. holdback[h*3+k] = (s, r, o).
// Returns 1 if verified (all predict exactly via EQ), else 0.
// A failed candidate is discarded, not repaired.
fn verify(ws:[]u8, m:[]u8,
          c0:i32, c1:i32, c2:i32, c3:i32, c4:i32,
          holdback:[]u8, nhold:i32)i32 {
  let checked:i32=0;
  let h:i32=0;
  while(h<nhold){
    let s:i32=get32(holdback,(h*3+0)*4);
    let r:i32=get32(holdback,(h*3+1)*4);
    let o:i32=get32(holdback,(h*3+2)*4);
    if(r==c0){
      checked=checked+1;
      let pred:i32=eval_body(ws,m,c0,c1,c2,c3,c4,s);
      if(pred!=o){ return 0; }
    }
    h=h+1;
  }
  if(checked==0){ return 0; }
  return 1;
}

// promote: reify a verified candidate as a MAP node.
// refs: [trigger, param_dim=0, group_node, 0]
// payload: [body_kind, in_a, in_b, literal]
// (A5: no corroboration/standing in payload; counted from edges.)
// Writes SUPPORTS edges from each corroborating held-back FACT
// to the MAP node, and an INSTANCE-OF edge MAP -> group.
// Returns the MAP node address.
fn promote(ws:[]u8, es:[]u8, m:[]u8,
           c0:i32, c1:i32, c2:i32, c3:i32, c4:i32,
           groupnode:i32, holdback:[]u8, nhold:i32)i32 {
  let mp:i32=ws_alloc(ws, m);
  if(mp<0){ return -1; }
  n_set_tag(ws, mp, T_MAP());
  n_set_ref(ws, mp, 0, c0);
  n_set_ref(ws, mp, 1, 0);
  n_set_ref(ws, mp, 2, groupnode);
  n_set_ref(ws, mp, 3, 0);
  n_set_pay(ws, mp, 0, c1);
  n_set_pay(ws, mp, 1, c2);
  n_set_pay(ws, mp, 2, c3);
  n_set_pay(ws, mp, 3, c4);
  es_add(es, m, mp, groupnode, E_INSTANCE_OF());
  // SUPPORTS edges from corroborating held-back facts
  let h:i32=0;
  while(h<nhold){
    let s:i32=get32(holdback,(h*3+0)*4);
    let r:i32=get32(holdback,(h*3+1)*4);
    if(r==c0){
      let fn_:i32=lookup(ws, m, s, r);
      if(fn_>=0){ es_add(es, m, fn_, mp, E_SUPPORTS()); }
    }
    h=h+1;
  }
  return mp;
}

// ---------- APPLY: query path ----------

// Demotion threshold: a MAP applies only if standing >= 1.
// Standing = SUPPORTS - CONTRADICTS (A11), computed from edges.
fn query(ws:[]u8, es:[]u8, m:[]u8, s:i32, r:i32)i32 {
  // 1. Exact-key lookup first (W1 behavior preserved bit-for-bit).
  let hit:i32=lookup(ws, m, s, r);
  if(hit>=0){ return fact_obj(ws, hit); }
  // 2. On miss, APPLY: find MAP nodes with trigger == r.
  let nn:i32=m_nn(m);
  let best:i32=-999999;
  let beststand:i32=-999999;
  let n:i32=0;
  while(n<nn){
    if(n_tag(ws,n)==T_MAP() && n_ref(ws,n,0)==r){
      let st:i32=standing(ws, es, m, n);
      if(st>=1){
        let c1:i32=n_pay(ws,n,0);
        let c2:i32=n_pay(ws,n,1);
        let c3:i32=n_pay(ws,n,2);
        let c4:i32=n_pay(ws,n,3);
        let pred:i32=eval_body(ws,m,r,c1,c2,c3,c4,s);
        if(pred!=-999999){
          if(st>beststand){ beststand=st; best=pred; }
        }
      }
    }
    n=n+1;
  }
  if(best!=-999999){ return best; }
  // 3. No map applies: -2, exactly as before.
  return -2;
}

// contradict: teach a contradictory triple and link a CONTRADICTS
// edge from the new FACT to the MAP node for relation r.
// Used by the P7 revision test.
fn contradict(ws:[]u8, es:[]u8, m:[]u8, s:i32, r:i32, o:i32)i32 {
  let fn_:i32=teach(ws, es, m, s, r, o);
  if(fn_<0){ return -1; }
  let nn:i32=m_nn(m);
  let n:i32=0;
  while(n<nn){
    if(n_tag(ws,n)==T_MAP() && n_ref(ws,n,0)==r){
      es_add(es, m, fn_, n, E_CONTRADICTS());
    }
    n=n+1;
  }
  return fn_;
}

// ---------- test harness ----------

fn ws_init()[]u8 { return z_alloc(4096*36); }
fn es_init()[]u8 { return z_alloc(16384*12); }
fn m_init()[]u8 {
  let m:[]u8=z_alloc(16);
  set32(m, 8, 4096); set32(m, 12, 16384);
  return m;
}
fn rep(tag:[]u8, v:i32)void {
  emit(tag); emit(i32s(v)); emit("\n");
  return;
}

// Run PROPOSE->VERIFY->PROMOTE for one alignment group.
// Returns number of MAPs promoted.
fn run_loop(ws:[]u8, es:[]u8, m:[]u8,
            reltab:[]u8, reln:[]u8, subtab:[]u8, subn:[]u8,
            g:i32, maxr:i32, maxs:i32,
            holdback:[]u8, nhold:i32, do_verify:i32)i32 {
  let gn:i32=materialize_group(ws,es,m,reltab,reln,subtab,subn,g,maxr,maxs);
  let candtab:[]u8=z_alloc(32*5*4);
  let nc:i32=propose(ws,es,m,reltab,reln,subtab,subn,g,maxr,maxs,candtab,32);
  let promoted:i32=0;
  let c:i32=0;
  while(c<nc){
    let c0:i32=get32(candtab,(c*5+0)*4);
    let c1:i32=get32(candtab,(c*5+1)*4);
    let c2:i32=get32(candtab,(c*5+2)*4);
    let c3:i32=get32(candtab,(c*5+3)*4);
    let c4:i32=get32(candtab,(c*5+4)*4);
    let ok:i32=1;
    if(do_verify==1){ ok=verify(ws,m,c0,c1,c2,c3,c4,holdback,nhold); }
    if(ok==1){
      let mp:i32=promote(ws,es,m,c0,c1,c2,c3,c4,gn,holdback,nhold);
      if(mp>=0){ promoted=promoted+1; }
    }
    c=c+1;
  }
  return promoted;
}

// TEST W2-class: invariance -> LITERAL maps.
fn test_w2()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  // construction subjects 8001..8003, holdback 8004
  let s:i32=8001;
  while(s<=8004){
    teach(ws,es,m,s,801,9501); teach(ws,es,m,s,802,9502);
    teach(ws,es,m,s,803,9503); teach(ws,es,m,s,804,9504);
    teach(ws,es,m,s,805,9505);
    s=s+1;
  }
  let subj:[]u8=z_alloc(3*4);
  set32(subj,0,8001); set32(subj,4,8002); set32(subj,8,8003);
  let maxr:i32=8; let maxs:i32=16; let maxg:i32=8;
  let reltab:[]u8=z_alloc(maxg*maxr*4);
  let reln:[]u8=z_alloc(maxg*4);
  let subtab:[]u8=z_alloc(maxg*maxs*4);
  let subn:[]u8=z_alloc(maxg*4);
  let ng:i32=align(ws,es,m,subj,3,reltab,reln,subtab,subn,maxr,maxs,maxg);
  let holdback:[]u8=z_alloc(5*3*4);
  let h:i32=0;
  while(h<5){
    set32(holdback,(h*3+0)*4,8004);
    set32(holdback,(h*3+1)*4,801+h);
    set32(holdback,(h*3+2)*4,9501+h);
    h=h+1;
  }
  let pm:i32=run_loop(ws,es,m,reltab,reln,subtab,subn,0,maxr,maxs,
                      holdback,5,1);
  rep("W2 groups: ", ng);
  rep("W2 promoted: ", pm);
  // probe novel subject 8005
  let score:i32=0;
  let q:i32=0;
  while(q<5){
    let got:i32=query(ws,es,m,8005,801+q);
    if(got==9501+q){ score=score+1; }
    q=q+1;
  }
  rep("W2 probe score /5: ", score);
  // exact-hit preserved
  let eh:i32=query(ws,es,m,8001,803);
  rep("W2 exact-hit (expect 9503): ", eh);
  if(ng==1 && pm==5 && score==5 && eh==9503){ return 1; }
  return 0;
}

// TEST W3-class: addition via trial-based P-DEP.
fn test_w3()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  // construction pairs 9001..9006: (x, y, x+y)
  teach(ws,es,m,9001,601,3); teach(ws,es,m,9001,602,4); teach(ws,es,m,9001,600,7);
  teach(ws,es,m,9002,601,5); teach(ws,es,m,9002,602,2); teach(ws,es,m,9002,600,7);
  teach(ws,es,m,9003,601,1); teach(ws,es,m,9003,602,9); teach(ws,es,m,9003,600,10);
  teach(ws,es,m,9004,601,6); teach(ws,es,m,9004,602,6); teach(ws,es,m,9004,600,12);
  teach(ws,es,m,9005,601,2); teach(ws,es,m,9005,602,5); teach(ws,es,m,9005,600,7);
  teach(ws,es,m,9006,601,8); teach(ws,es,m,9006,602,1); teach(ws,es,m,9006,600,9);
  // holdback 9007, 9008
  teach(ws,es,m,9007,601,4); teach(ws,es,m,9007,602,7); teach(ws,es,m,9007,600,11);
  teach(ws,es,m,9008,601,9); teach(ws,es,m,9008,602,3); teach(ws,es,m,9008,600,12);
  let subj:[]u8=z_alloc(6*4);
  let i:i32=0;
  while(i<6){ set32(subj,i*4,9001+i); i=i+1; }
  let maxr:i32=8; let maxs:i32=16; let maxg:i32=8;
  let reltab:[]u8=z_alloc(maxg*maxr*4);
  let reln:[]u8=z_alloc(maxg*4);
  let subtab:[]u8=z_alloc(maxg*maxs*4);
  let subn:[]u8=z_alloc(maxg*4);
  let ng:i32=align(ws,es,m,subj,6,reltab,reln,subtab,subn,maxr,maxs,maxg);
  let holdback:[]u8=z_alloc(2*3*4);
  set32(holdback,0,9007); set32(holdback,4,600); set32(holdback,8,11);
  set32(holdback,12,9008); set32(holdback,16,600); set32(holdback,20,12);
  let pm:i32=run_loop(ws,es,m,reltab,reln,subtab,subn,0,maxr,maxs,
                      holdback,2,1);
  rep("W3 groups: ", ng);
  rep("W3 promoted: ", pm);
  // probe: teach inputs only, query the sum
  teach(ws,es,m,9009,601,10); teach(ws,es,m,9009,602,20);
  let got1:i32=query(ws,es,m,9009,600);
  rep("W3 probe1 (expect 30): ", got1);
  teach(ws,es,m,9010,601,7); teach(ws,es,m,9010,602,8);
  let got2:i32=query(ws,es,m,9010,600);
  rep("W3 probe2 (expect 15): ", got2);
  // exact-hit preserved
  let eh:i32=query(ws,es,m,9003,600);
  rep("W3 exact-hit (expect 10): ", eh);
  if(ng==1 && pm==1 && got1==30 && got2==15 && eh==10){ return 1; }
  return 0;
}

// TEST P5 negative control: no regularity -> zero promotions, -2 probes.
fn test_neg()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  teach(ws,es,m,7001,701,11); teach(ws,es,m,7001,702,22);
  teach(ws,es,m,7002,701,33); teach(ws,es,m,7002,702,44);
  teach(ws,es,m,7003,701,55); teach(ws,es,m,7003,702,66);
  teach(ws,es,m,7004,701,77); teach(ws,es,m,7004,702,88);
  let subj:[]u8=z_alloc(3*4);
  set32(subj,0,7001); set32(subj,4,7002); set32(subj,8,7003);
  let maxr:i32=8; let maxs:i32=16; let maxg:i32=8;
  let reltab:[]u8=z_alloc(maxg*maxr*4);
  let reln:[]u8=z_alloc(maxg*4);
  let subtab:[]u8=z_alloc(maxg*maxs*4);
  let subn:[]u8=z_alloc(maxg*4);
  let ng:i32=align(ws,es,m,subj,3,reltab,reln,subtab,subn,maxr,maxs,maxg);
  let holdback:[]u8=z_alloc(2*3*4);
  set32(holdback,0,7004); set32(holdback,4,701); set32(holdback,8,77);
  set32(holdback,12,7004); set32(holdback,16,702); set32(holdback,20,88);
  let pm:i32=run_loop(ws,es,m,reltab,reln,subtab,subn,0,maxr,maxs,
                      holdback,2,1);
  rep("NEG promoted (expect 0): ", pm);
  let q1:i32=query(ws,es,m,7005,701);
  let q2:i32=query(ws,es,m,7005,702);
  rep("NEG probe1 (expect -2): ", q1);
  rep("NEG probe2 (expect -2): ", q2);
  if(pm==0 && q1==-2 && q2==-2){ return 1; }
  return 0;
}

// TEST P6: VERIFY ablated -> spurious promotion produces wrong answers.
// Construction shows 711 = 2*712; holdback breaks it.
fn test_noverify()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  teach(ws,es,m,7101,712,5);  teach(ws,es,m,7101,711,10);
  teach(ws,es,m,7102,712,10); teach(ws,es,m,7102,711,20);
  teach(ws,es,m,7103,712,15); teach(ws,es,m,7103,711,30);
  teach(ws,es,m,7104,712,7);  teach(ws,es,m,7104,711,99);
  let subj:[]u8=z_alloc(3*4);
  set32(subj,0,7101); set32(subj,4,7102); set32(subj,8,7103);
  let maxr:i32=8; let maxs:i32=16; let maxg:i32=8;
  let reltab:[]u8=z_alloc(maxg*maxr*4);
  let reln:[]u8=z_alloc(maxg*4);
  let subtab:[]u8=z_alloc(maxg*maxs*4);
  let subn:[]u8=z_alloc(maxg*4);
  let ng:i32=align(ws,es,m,subj,3,reltab,reln,subtab,subn,maxr,maxs,maxg);
  let holdback:[]u8=z_alloc(1*3*4);
  set32(holdback,0,7104); set32(holdback,4,711); set32(holdback,8,99);
  // WITH verify: candidate must be rejected
  let pm1:i32=run_loop(ws,es,m,reltab,reln,subtab,subn,0,maxr,maxs,
                       holdback,1,1);
  rep("P6 with-verify promoted (expect 0): ", pm1);
  // WITHOUT verify (ablation): spurious promotion happens
  let ws2:[]u8=ws_init(); let es2:[]u8=es_init(); let m2:[]u8=m_init();
  teach(ws2,es2,m2,7101,712,5);  teach(ws2,es2,m2,7101,711,10);
  teach(ws2,es2,m2,7102,712,10); teach(ws2,es2,m2,7102,711,20);
  teach(ws2,es2,m2,7103,712,15); teach(ws2,es2,m2,7103,711,30);
  teach(ws2,es2,m2,7104,712,7);  teach(ws2,es2,m2,7104,711,99);
  let reltab2:[]u8=z_alloc(maxg*maxr*4);
  let reln2:[]u8=z_alloc(maxg*4);
  let subtab2:[]u8=z_alloc(maxg*maxs*4);
  let subn2:[]u8=z_alloc(maxg*4);
  let ng2:i32=align(ws2,es2,m2,subj,3,reltab2,reln2,subtab2,subn2,maxr,maxs,maxg);
  let pm2:i32=run_loop(ws2,es2,m2,reltab2,reln2,subtab2,subn2,0,maxr,maxs,
                       holdback,1,0);
  rep("P6 no-verify promoted (expect >=1): ", pm2);
  // the ablated system answers wrongly instead of -2
  teach(ws2,es2,m2,7105,712,3);
  let wrong:i32=query(ws2,es2,m2,7105,711);
  rep("P6 no-verify probe (wrong=6, right=-2): ", wrong);
  if(pm1==0 && pm2>=1 && wrong==6){ return 1; }
  return 0;
}

// TEST P7: revision. Contradictory evidence demotes the map.
fn test_revise()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  let s:i32=8001;
  while(s<=8004){
    teach(ws,es,m,s,801,9501); teach(ws,es,m,s,802,9502);
    s=s+1;
  }
  let subj:[]u8=z_alloc(3*4);
  set32(subj,0,8001); set32(subj,4,8002); set32(subj,8,8003);
  let maxr:i32=8; let maxs:i32=16; let maxg:i32=8;
  let reltab:[]u8=z_alloc(maxg*maxr*4);
  let reln:[]u8=z_alloc(maxg*4);
  let subtab:[]u8=z_alloc(maxg*maxs*4);
  let subn:[]u8=z_alloc(maxg*4);
  let ng:i32=align(ws,es,m,subj,3,reltab,reln,subtab,subn,maxr,maxs,maxg);
  let holdback:[]u8=z_alloc(1*3*4);
  set32(holdback,0,8004); set32(holdback,4,801); set32(holdback,8,9501);
  let pm:i32=run_loop(ws,es,m,reltab,reln,subtab,subn,0,maxr,maxs,
                      holdback,1,1);
  let before:i32=query(ws,es,m,8007,801);
  rep("P7 before contradict (expect 9501): ", before);
  // two contradictory teachings; standing was 1 (one SUPPORTS),
  // two CONTRADICTS -> standing -1 < 1 -> demoted
  contradict(ws,es,m,8006,801,9999);
  contradict(ws,es,m,8008,801,9999);
  let after:i32=query(ws,es,m,8007,801);
  rep("P7 after 2 contradicts (expect -2): ", after);
  if(before==9501 && after==-2){ return 1; }
  return 0;
}

// TEST P4: no hallucination. Unknown relation -> -2; W1 exact preserved.
fn test_nohall()i32 {
  let ws:[]u8=ws_init(); let es:[]u8=es_init(); let m:[]u8=m_init();
  teach(ws,es,m,1001,101,201);
  teach(ws,es,m,1001,102,202);
  let q1:i32=query(ws,es,m,1001,101);
  let q2:i32=query(ws,es,m,1002,101);
  let q3:i32=query(ws,es,m,1001,999);
  rep("P4 exact (expect 201): ", q1);
  rep("P4 novel subj (expect -2): ", q2);
  rep("P4 novel rel (expect -2): ", q3);
  if(q1==201 && q2==-2 && q3==-2){ return 1; }
  return 0;
}

fn main()i32 {
  let ac:i32=_zag_argc();
  if(ac<2){ _zag_eprintln("usage: cam1_bin <test|all>"); return 2; }
  let which:[]u8=_zag_arg(1);
  let pass:i32=0; let total:i32=0;
  // run all tests unconditionally; `which` selects verbose set
  emit("=== CAM-1 trial-based build: test run ===\n");
  total=total+1; let r1:i32=test_w2();
  emit("W2: "); emit(i32s(r1)); emit("\n"); pass=pass+r1;
  total=total+1; let r2:i32=test_w3();
  emit("W3: "); emit(i32s(r2)); emit("\n"); pass=pass+r2;
  total=total+1; let r3:i32=test_neg();
  emit("NEG: "); emit(i32s(r3)); emit("\n"); pass=pass+r3;
  total=total+1; let r4:i32=test_noverify();
  emit("P6: "); emit(i32s(r4)); emit("\n"); pass=pass+r4;
  total=total+1; let r5:i32=test_revise();
  emit("P7: "); emit(i32s(r5)); emit("\n"); pass=pass+r5;
  total=total+1; let r6:i32=test_nohall();
  emit("P4: "); emit(i32s(r6)); emit("\n"); pass=pass+r6;
  emit("PASS "); emit(i32s(pass)); emit("/"); emit(i32s(total)); emit("\n");
  if(pass==total){ return 0; }
  return 1;
}

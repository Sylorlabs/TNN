// ivwc_veto.zag -- Verifier veto (selective execution).
// The learner commits veto decisions BEFORE any sealed consequence:
// low-verdict plans are vetoed (not executed); only high-verdict
// plans execute. Three veto policies: P1 learner (veto iff the
// frozen verifier's verdict is FAIL, threshold T learner-computed
// from train consequences), P2 fixed strict (researcher-written:
// veto iff bucket != 1), P3 fixed lax (researcher-written: veto
// iff bucket == 0), P0 no veto baseline.
// World, beliefs, composer, consequence simulator, verifier, and
// all seeds are bit-identical to IVWC-EXPAND3 (incorporated by
// reference). The sealed (bucket, eff) pairs are therefore
// bit-identical to expand3's. The revision protocol and the
// shuffled-consequence ablation are removed (separate questions).
// Selective execution is realized as pre-committed selection over
// one deterministic harness consequence pass: plans are frozen at
// commit, the world is deterministic, so per-policy accounting
// over the recorded (collected, energy, eff) yields bit-exactly
// the outcomes physical selective execution would produce. The
// veto decision precedes any sealed world_execute (K1); the
// learner never observes the harness pass.
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC / IVWC-EXPAND3) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;
const NPOL:i32=4;

// ---------- helpers (u8-backed cells, little-endian; copied verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow). The seed is
// reduced mod 65536 on entry so large frozen seeds cannot overflow
// the multiply on the first step.
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}

// ===== WORLD =====
// Ground-truth generator. Record: walls[0..19], items[20..39], start[40].
// wp = wall probability in percent. At wp=15 the output is
// bit-identical to the IVWC / IVWC-EXPAND worlds (same seeds,
// same draw order); larger wp is the law-change dial.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
// Belief generator (harness setup only): frozen noisy copy of truth.
// Wall belief flips 12% (never start). True items dropped 15%.
// Empty true-open cells gain phantom item beliefs 18%.
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
// Step physics. st cells: pos@0, collected@4, bumps@8, wasted@12.
// Each returns its physics outcome so the caller can log evidence.
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
// Outcome codes: 0 move ok, 1 bump left, 2 bump right,
// 3 gather hit, 4 gather miss. All derived from physics.
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// Consequence simulator: steps the committed plan through corridor
// physics and records a per-action evidence log (position byte,
// outcome byte). cons cells: collected@0, energy_used@4, bumps@8,
// wasted@12, final_pos@16, plan_len@20. No reference plan exists;
// consequences and evidence are physics outputs of executing this
// plan in this world.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// 1 if the believed interval [lo,hi] holds a believed wall.
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
// Append one leg: moves from pos toward tgt, then GATHER.
// pcs cells: pos@0 (in/out), tgt@4, at@8 (in/out).
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only. Sees no world truth.
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Learner-owned self-check table. vb cells (4-byte): bsum[4]@0,
// bcnt[4]@16, bmean[4]@32, T@48. Inputs are consequence-derived
// (bucket, eff) pairs only; no world truth reaches this function.
// T is learner-computed from train consequences (no researcher-set
// constant anywhere in the verifier path). Empty bucket -> mean -1.
fn verifier_train(bkt:[]u8, eff:[]u8, n:i32, vb:[]u8)void {
  let b:i32=0;
  while(b<4){
    set32(vb,4*b,0);
    set32(vb,16+4*b,0);
    set32(vb,32+4*b,-1);
    b=b+1;
  }
  let tot:i32=0;
  let i:i32=0;
  while(i<n){
    let bb:i32=get32(bkt,4*i);
    let e:i32=get32(eff,4*i);
    if(bb>=0){
      if(bb<4){
        set32(vb,4*bb,get32(vb,4*bb)+e);
        set32(vb,16+4*bb,get32(vb,16+4*bb)+1);
      }
    }
    tot=tot+e;
    i=i+1;
  }
  b=0;
  while(b<4){
    let c:i32=get32(vb,16+4*b);
    if(c>0){ set32(vb,32+4*b,get32(vb,4*b)/c); }
    b=b+1;
  }
  let T:i32=0;
  if(n>0){ T=tot/n; }
  set32(vb,48,T);
  return;
}
// Pre-execution self-verdict: 1 = PASS, 0 = FAIL. FAIL when the
// bucket has no train data (conservative: no data, no pass) or its
// train mean sits below the learner's own threshold T.
fn verifier_check(vb:[]u8, bucket:i32)i32 {
  if(bucket<0){ return 0; }
  if(bucket>=4){ return 0; }
  if(get32(vb,16+4*bucket)==0){ return 0; }
  if(get32(vb,32+4*bucket)>=get32(vb,48)){ return 1; }
  return 0;
}
// Veto policies. Return 1 = VETO (do not execute), 0 = EXECUTE.
// P1 (learner): veto iff the frozen verifier's verdict is FAIL.
// The threshold T inside the table is learner-computed from train
// consequences; no researcher-set constant anywhere in this path.
// P2 (fixed strict control, researcher-written): execute only the
// exactly-one-gather bucket. P3 (fixed lax control,
// researcher-written): veto only empty plans. P2/P3 are comparison
// controls; the learner's policy is P1.
fn veto_p1(vb:[]u8, bucket:i32)i32 {
  if(verifier_check(vb,bucket)==1){ return 0; }
  return 1;
}
fn veto_p2(bucket:i32)i32 {
  if(bucket==1){ return 0; }
  return 1;
}
fn veto_p3(bucket:i32)i32 {
  if(bucket==0){ return 1; }
  return 0;
}

// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWV-BEGIN\n");
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let tbkt:[]u8=z_alloc(NTRAIN*4);
  let teff:[]u8=z_alloc(NTRAIN*4);
  let vb:[]u8=z_alloc(64);
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let etmp:[]u8=z_alloc(EREC);
  let wc:[]u8=z_alloc(4);
  let dver:[]u8=z_alloc(NSEAL*4);
  let d1:[]u8=z_alloc(NSEAL*4);
  let d2:[]u8=z_alloc(NSEAL*4);
  let d3:[]u8=z_alloc(NSEAL*4);
  let cfc:[]u8=z_alloc(NSEAL*4);
  let cfu:[]u8=z_alloc(NSEAL*4);
  let cfe:[]u8=z_alloc(NSEAL*4);
  let pne:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pnv:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pw:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pns:[]u8=z_alloc(NSHIFT*NPOL*4);
  let psumc:[]u8=z_alloc(NSHIFT*NPOL*4);
  let psumu:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pesav:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pcforf:[]u8=z_alloc(NSHIFT*NPOL*4);
  let pses:[]u8=z_alloc(NSHIFT*NPOL*4);
  let psen:[]u8=z_alloc(NSHIFT*NPOL*4);
  let psvs:[]u8=z_alloc(NSHIFT*NPOL*4);
  let psvn:[]u8=z_alloc(NSHIFT*NPOL*4);
  let k1:i32=1;
  // Phase 1: train SETUP (wp=15). Harness builds truth and beliefs.
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, 15, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // Phase 2: train COMMIT. Learner sees beliefs only.
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  if(get32(wc,0)==0){
    at=ob_app(ob,at,"K1T-STRUCT-PASS world_calls=0 after train COMMIT\n");
  } else {
    k1=0;
    at=ob_app(ob,at,"K1T-STRUCT-FAIL\n");
  }
  // Phase 3: train CONSEQ. World executes committed plans
  // (evidence to scratch; the verifier needs consequences only).
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // Phase 4: verifier TRAIN (learner section). Build (bucket, eff)
  // pairs from train metas and consequences, then train the table.
  t=0;
  while(t<NTRAIN){
    let bk:i32=get32(mtrain,t*RECM+12);
    let tc:i32=get32(ctrain,t*RECC);
    let te:i32=get32(ctrain,t*RECC+4);
    let tf:i32=0;
    if(te>0){ tf=(100*tc)/te; }
    set32(tbkt,4*t,bk);
    set32(teff,4*t,tf);
    t=t+1;
  }
  verifier_train(tbkt, teff, NTRAIN, vb);
  at=ob_app(ob,at,"VERIFIER T=");
  at=ob_i32(ob,at,get32(vb,48));
  at=ob_nl(ob,at);
  let b:i32=0;
  while(b<4){
    at=ob_app(ob,at,"VB b=");
    at=ob_i32(ob,at,b);
    at=ob_app(ob,at," cnt=");
    at=ob_i32(ob,at,get32(vb,16+4*b));
    at=ob_app(ob,at," mean=");
    at=ob_i32(ob,at,get32(vb,32+4*b));
    at=ob_nl(ob,at);
    b=b+1;
  }
  at=ob_app(ob,at,"TRAIN t bkt eff\n");
  t=0;
  while(t<NTRAIN){
    at=ob_app(ob,at,"T t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,get32(tbkt,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Phase 5: sealed SHIFT LOOP. sh=0..2, wp=15/30/45. The verifier
  // stays frozen from train; only the sealed law changes.
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    at=ob_app(ob,at,"SHIFT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," wp=");
    at=ob_i32(ob,at,wp);
    at=ob_nl(ob,at);
    // a. SEALED SETUP (this wp). Fresh worlds the learner never saw.
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // b. VETO COMMIT (batched before any sealed consequence).
    // Learner composes, checks the frozen verifier, and commits
    // one veto decision per policy. No world_execute here.
    let wcb0:i32=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      let sbk:i32=get32(mseal,s*RECM+12);
      let ver:i32=verifier_check(vb, sbk);
      set32(dver,4*s,ver);
      set32(d1,4*s,veto_p1(vb, sbk));
      set32(d2,4*s,veto_p2(sbk));
      set32(d3,4*s,veto_p3(sbk));
      s=s+1;
    }
    if(get32(wc,0)==wcb0){
      at=ob_app(ob,at,"K1S-STRUCT-PASS sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    } else {
      k1=0;
      at=ob_app(ob,at,"K1S-STRUCT-FAIL sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    }
    at=ob_app(ob,at,"VETODEC s bkt ver v1 v2 v3\n");
    s=0;
    while(s<NSEAL){
      at=ob_app(ob,at,"D s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+12));
      at=ob_app(ob,at," ver=");
      at=ob_i32(ob,at,get32(dver,4*s));
      at=ob_app(ob,at," v1=");
      at=ob_i32(ob,at,get32(d1,4*s));
      at=ob_app(ob,at," v2=");
      at=ob_i32(ob,at,get32(d2,4*s));
      at=ob_app(ob,at," v3=");
      at=ob_i32(ob,at,get32(d3,4*s));
      at=ob_nl(ob,at);
      s=s+1;
    }
    // c. CONSEQUENCE (single harness pass). Every committed plan
    // is executed once; per-case (collected, energy, eff) is
    // recorded. Per-policy selective-execution outcomes are then
    // computed as selection over these deterministic records:
    // vetoed cases contribute nothing, executed cases contribute
    // their recorded consequence. The veto decisions above were
    // committed before this pass and the learner never observes it.
    s=0;
    while(s<NSEAL){
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, get32(mseal,s*RECM+4), cseal, s*RECC, etmp, 0, wc);
      let cc:i32=get32(cseal,s*RECC);
      let cu:i32=get32(cseal,s*RECC+4);
      let ce:i32=0;
      if(cu>0){ ce=(100*cc)/cu; }
      set32(cfc,4*s,cc);
      set32(cfu,4*s,cu);
      set32(cfe,4*s,ce);
      s=s+1;
    }
    at=ob_app(ob,at,"CONSEQ s c u eff L\n");
    s=0;
    while(s<NSEAL){
      at=ob_app(ob,at,"C s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," c=");
      at=ob_i32(ob,at,get32(cfc,4*s));
      at=ob_app(ob,at," u=");
      at=ob_i32(ob,at,get32(cfu,4*s));
      at=ob_app(ob,at," eff=");
      at=ob_i32(ob,at,get32(cfe,4*s));
      at=ob_app(ob,at," L=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+4));
      at=ob_nl(ob,at);
      s=s+1;
    }
    // d. POLICY ACCOUNTING. T is the learner's frozen threshold.
    let T:i32=get32(vb,48);
    let p:i32=0;
    while(p<NPOL){
      let ne:i32=0;
      let nv:i32=0;
      let w:i32=0;
      let nsu:i32=0;
      let sumc:i32=0;
      let sumu:i32=0;
      let esav:i32=0;
      let cforf:i32=0;
      let ses:i32=0;
      let sen:i32=0;
      let svs:i32=0;
      let svn:i32=0;
      s=0;
      while(s<NSEAL){
        let vv:i32=0;
        if(p==1){ vv=get32(d1,4*s); }
        if(p==2){ vv=get32(d2,4*s); }
        if(p==3){ vv=get32(d3,4*s); }
        let cc2:i32=get32(cfc,4*s);
        let cu2:i32=get32(cfu,4*s);
        let ce2:i32=get32(cfe,4*s);
        let L2:i32=get32(mseal,s*RECM+4);
        if(vv==1){
          nv=nv+1;
          esav=esav+L2;
          cforf=cforf+cc2;
          svs=svs+ce2;
          svn=svn+1;
        } else {
          ne=ne+1;
          sumc=sumc+cc2;
          sumu=sumu+cu2;
          ses=ses+ce2;
          sen=sen+1;
          if(ce2<T){ w=w+1; } else { nsu=nsu+1; }
        }
        s=s+1;
      }
      let ix:i32=(sh*NPOL+p)*4;
      set32(pne,ix,ne);
      set32(pnv,ix,nv);
      set32(pw,ix,w);
      set32(pns,ix,nsu);
      set32(psumc,ix,sumc);
      set32(psumu,ix,sumu);
      set32(pesav,ix,esav);
      set32(pcforf,ix,cforf);
      set32(pses,ix,ses);
      set32(psen,ix,sen);
      set32(psvs,ix,svs);
      set32(psvn,ix,svn);
      at=ob_app(ob,at,"POL sh=");
      at=ob_i32(ob,at,sh);
      at=ob_app(ob,at," p=");
      at=ob_i32(ob,at,p);
      at=ob_app(ob,at," ne=");
      at=ob_i32(ob,at,ne);
      at=ob_app(ob,at," nv=");
      at=ob_i32(ob,at,nv);
      at=ob_app(ob,at," sumc=");
      at=ob_i32(ob,at,sumc);
      at=ob_app(ob,at," sumu=");
      at=ob_i32(ob,at,sumu);
      at=ob_app(ob,at," W=");
      at=ob_i32(ob,at,w);
      at=ob_app(ob,at," ns=");
      at=ob_i32(ob,at,nsu);
      at=ob_app(ob,at," esav=");
      at=ob_i32(ob,at,esav);
      at=ob_app(ob,at," cforf=");
      at=ob_i32(ob,at,cforf);
      at=ob_nl(ob,at);
      at=ob_app(ob,at,"VDISC sh=");
      at=ob_i32(ob,at,sh);
      at=ob_app(ob,at," p=");
      at=ob_i32(ob,at,p);
      at=ob_app(ob,at," se_sum=");
      at=ob_i32(ob,at,ses);
      at=ob_app(ob,at," se_n=");
      at=ob_i32(ob,at,sen);
      at=ob_app(ob,at," sv_sum=");
      at=ob_i32(ob,at,svs);
      at=ob_app(ob,at," sv_n=");
      at=ob_i32(ob,at,svn);
      at=ob_nl(ob,at);
      p=p+1;
    }
    // e. P1-vs-P2 veto-set identity (finding): the learned rule
    // should match the exactly-one-gather fixed rule on this dial.
    let nd12:i32=0;
    s=0;
    while(s<NSEAL){
      if(get32(d1,4*s)!=get32(d2,4*s)){ nd12=nd12+1; }
      s=s+1;
    }
    at=ob_app(ob,at,"DIFF12 sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," n=");
    at=ob_i32(ob,at,nd12);
    at=ob_nl(ob,at);
    sh=sh+1;
  }
  // Phase 6: kill-bar verdicts (provisional; K2/K5 by shell audit).
  // ix(sh,p) = (sh*NPOL+p)*4.
  let k3:i32=0;
  if(get32(pw,4)<get32(pw,0)){ k3=1; }
  if(k3==1){
    at=ob_app(ob,at,"K3-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K3-PROV-FAIL\n");
  }
  let k4:i32=0;
  if(get32(pne,4)>0){
    if(get32(pns,4)*get32(pne,0) > get32(pns,0)*get32(pne,4)){ k4=1; }
  }
  if(k4==1){
    at=ob_app(ob,at,"K4-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K4-PROV-FAIL\n");
  }
  let k6:i32=0;
  if(get32(pw,4)<get32(pw,12)){ k6=1; }
  if(k6==1){
    at=ob_app(ob,at,"K6-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K6-PROV-FAIL\n");
  }
  // sh=2 base ix = (2*4+p)*4: p1 -> 36.
  let k7:i32=0;
  if(get32(psvn,36)>0){
    if(get32(psen,36)>0){
      if(get32(psvs,36)*get32(psen,36) < get32(pses,36)*get32(psvn,36)){ k7=1; }
    }
  }
  if(k7==1){
    at=ob_app(ob,at,"K7-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K7-PROV-FAIL\n");
  }
  let k8:i32=0;
  if(get32(pw,36)<get32(pw,32)){ k8=1; }
  if(k8==1){
    at=ob_app(ob,at,"K8-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K8-PROV-FAIL\n");
  }
  if(k1==1){
    at=ob_app(ob,at,"K1-PROV-PASS\n");
  } else {
    at=ob_app(ob,at,"K1-PROV-FAIL\n");
  }
  at=ob_app(ob,at,"K2-AUDIT-SHELL K5-AUDIT-SHELL\n");
  at=ob_app(ob,at,"FLAGS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWV-END\n");
  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off2:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off2 as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off2=off2+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// Appended to the unchanged precond.zag prefix before fn main.
fn renamed(x:i32,perm:i32)i32 {
  if(perm==1){ return 9-x; }
  return x;
}
fn fixture(RH:[]u8,AR:[]u8,order:i32,perm:i32)void {
  let a:i32=renamed(3,perm); let b:i32=renamed(4,perm);
  wset(AR,qidx(0,0),2);
  wset(RH,qidx(0,0)*3,1); wset(RH,qidx(0,0)*3+1,b);
  let short:i32=order; let long:i32=1-order;
  wset(AR,qidx(1,short),1); wset(RH,qidx(1,short)*3,a);
  wset(AR,qidx(1,long),2); wset(RH,qidx(1,long)*3,a);
  wset(RH,qidx(1,long)*3+1,b);
  return;
}
// Independent exact-sequence labels, not computed through grammar functions.
fn oracle(s:[]u8,n:i32,perm:i32,root:i32)i32 {
  let a:i32=renamed(3,perm); let b:i32=renamed(4,perm);
  if(wget(s,0)!=a){ return 0; }
  if(n==1 && root==0){ return 1; }
  if(n==2 && wget(s,1)==b){ return 1; }
  if(n==3 && wget(s,1)==b && wget(s,2)==b){ return 1; }
  return 0;
}
fn metric(ob:[]u8,c:i32,name:[]u8,v:i32)i32 {
  let d:i32=o_app(ob,c,name); d=o_i64(ob,d,v as i64); return d;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536); let c:i32=0; let bad:i32=0;
  let perm:i32=0;
  while(perm<2){
    let order:i32=0;
    while(order<2){
      let RH:[]u8=z_alloc(NQ()*3*4); let AR:[]u8=z_alloc(NQ()*4);
      let s:[]u8=z_alloc(32); let out:[]u8=z_alloc((MAXOUT()+8)*4);
      let cur:[]u8=z_alloc(4);
      fixture(RH,AR,order,perm);
      let tested:i32=0; let ra:i32=0; let ua:i32=0;
      let rfn:i32=0; let ufn:i32=0; let rfp:i32=0; let ufp:i32=0;
      let n:i32=1;
      while(n<=4){
        let total:i32=1; let j:i32=0;
        while(j<n){ total=total*4; j=j+1; }
        let code:i32=0;
        while(code<total){
          let v:i32=code; j=0;
          while(j<n){ wset(s,j,3+v%4); v=v/4; j=j+1; }
          let expectedr:i32=oracle(s,n,perm,1);
          let expectedu:i32=oracle(s,n,perm,0);
          let mr:i32=0;
          if(match(RH,AR,0,s,0,n,0)==n){ mr=1; }
          let mu:i32=derivable(RH,AR,s,n);
          tested=tested+1; ra=ra+mr; ua=ua+mu;
          if(expectedr==1 && mr==0){ rfn=rfn+1; }
          if(expectedu==1 && mu==0){ ufn=ufn+1; }
          if(expectedr==0 && mr==1){ rfp=rfp+1; }
          if(expectedu==0 && mu==1){ ufp=ufp+1; }
          if(expectedr!=mr || expectedu!=mu){
            c=metric(ob,c,"mismatch perm=",perm); c=metric(ob,c," order=",order);
            c=o_app(ob,c," string="); j=0;
            while(j<n){ c=o_i64(ob,c,wget(s,j) as i64); j=j+1; }
            c=metric(ob,c," root_expected=",expectedr); c=metric(ob,c," root_actual=",mr);
            c=metric(ob,c," union_expected=",expectedu); c=metric(ob,c," union_actual=",mu);
            c=o_nl(ob,c);
          }
          code=code+1;
        }
        n=n+1;
      }
      let gok:i32=gen(RH,AR,0,out,cur,0);
      let glen:i32=wget(cur,0);
      let gvalid:i32=oracle(out,glen,perm,1);
      c=metric(ob,c,"summary perm=",perm); c=metric(ob,c," order=",order);
      c=metric(ob,c," tested=",tested); c=metric(ob,c," root_accept=",ra);
      c=metric(ob,c," union_accept=",ua); c=metric(ob,c," root_FN=",rfn);
      c=metric(ob,c," union_FN=",ufn); c=metric(ob,c," root_FP=",rfp);
      c=metric(ob,c," union_FP=",ufp); c=metric(ob,c," gen_valid=",gvalid);
      c=o_nl(ob,c);
      if(tested!=340 || ra!=1 || ua!=2+order || rfn!=1 || ufn!=1-order){ bad=bad+1; }
      if(rfp!=0 || ufp!=0 || gok!=1 || gvalid!=1){ bad=bad+1; }
      order=order+1;
    }
    perm=perm+1;
  }
  let ERH:[]u8=z_alloc(NQ()*3*4); let EAR:[]u8=z_alloc(NQ()*4);
  let es:[]u8=z_alloc(32); let emptyaccept:i32=0; let n:i32=1;
  while(n<=4){
    let total:i32=1; let k:i32=0;
    while(k<n){ total=total*4; k=k+1; }
    let code:i32=0;
    while(code<total){
      let v:i32=code; k=0;
      while(k<n){ wset(es,k,3+v%4); v=v/4; k=k+1; }
      emptyaccept=emptyaccept+derivable(ERH,EAR,es,n); code=code+1;
    }
    n=n+1;
  }
  c=metric(ob,c,"empty_table_accept=",emptyaccept); c=o_nl(ob,c);
  if(emptyaccept!=0){ bad=bad+1; }
  if(bad==0){ c=o_app(ob,c,"AUDIT CONFIRMED: greedy matcher rejects valid strings; not exact membership.\n"); }
  else { c=o_app(ob,c,"INSTRUMENTATION OR PREDICTION FAILURE\n"); }
  _zag_print(ob[0..c]);
  if(bad!=0){ return 1; }
  return 0;
}

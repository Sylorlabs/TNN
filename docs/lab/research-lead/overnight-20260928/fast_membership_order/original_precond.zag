// PHASE 6 STRUCTURAL PRECONDITION -- pure Zag.
//
// Per FRONTIER_QUEUE `substrate-spec`: prove the task is SOLVABLE BY SOME PRODUCTION
// SET before implementing any induction. This runs BEFORE any result is read.
//
// QUESTION: can a SINGLE production table support both
//   forward  (generate a terminal string from a non-terminal) and
//   backward (decide whether a terminal string is derivable)?
// Phase 6's core finding is that a STATISTICAL model cannot do both, so the
// representation class must be structural. This tests that a structural one CAN.
//
// HONESTY NOTE -- this prover reported PASS, then FAILED six times, every time on a
// bug in the PROVER or in how it was run, never on the grammar under test:
//   1. `on` passed BY VALUE into expand() -> the parent's output length was lost, so
//      every recursive branch appeared to fail.
//   2. rules written into arbitrary slots while the rule lookup indexed by LHS ->
//      A0's second rule belonged to a different non-terminal.
//   3. cyclic rules with no output bound -> wrote past out[] and printed heap garbage
//      as though it were derived symbols.
//   4. RHS stored at a BYTE offset (+4) inside an INT-indexed 4-int block -> rhs1 read
//      back as A0, so A0 recursed into itself to the depth cap and reported FAILED.
//   5. the zero-init loop cleared only every 4th int, leaving rhs/arity slots holding
//      raw malloc garbage.
//   6. an apostrophe inside a string literal ("prover's") terminated the parse, and
//      then one line was missing a closing paren. E0001 "unexpected end of input".
// Plus one PROCESS failure worth as much as the six: after a FAILED compile I ran the
// binary anyway and read its output as a result. The build was stale, so for a while
// I was reasoning about a program that did not exist. Every run since is gated on the
// compile succeeding, and `rm -f` precedes it.
//
// A harness with six bugs cannot license a "the substrate is dead" conclusion, which is
// why the verdict text below says to fix the prover rather than conclude anything. That
// is the single most important thing in this file.
//
// Two process lessons, recorded because they cost the most time:
//   - My paren-balance checker flagged the missing paren on the offending line, and I
//     dismissed it twice as an "awk stripping artifact" because the line's string
//     contained digits like 3,2,4 that I assumed were confusing it. Instrumentation
//     that disagrees with you should be believed until you have explained it away, not
//     explained away until it agrees.
//   - Bisecting a parse error by appending a FIXED number of closing braces gives
//     nonsense results; the append has to match the brace depth of the truncated
//     prefix, or the harness "passes" only by accident at exactly one depth.
//
// DESIGN RULE ADOPTED AFTER THOSE FAILURES: no block strides, no mixed byte/int
// offsets. Every logical int lives in its own flat array, indexed by a single integer
// q = l*NRULE() + r, and ALL reads/writes go through wset()/wget() so a write and its
// read can never disagree about units again.
//
// GRAMMAR (non-terminals 0,1,2; terminals 3..6):
//     A0 -> A1 4
//     A1 -> 3 3
//     A2 -> A0 5
// RECURSION IS NECESSARY, not decorative: A0 and A2 have no terminal-only
// alternative, so the only way to expand either of them is through a non-terminal.
// The base case sits at A1. A depth cap is still required because A2 -> A0 and A0 -> A1
// sit inside the cycle.
//
// HAND-DERIVED EXPECTATIONS -- the machine must reproduce exactly these, so the check
// is against arithmetic a reader can do, not against the prover's own output:
//   forward A0 -> 3 3 4        (len 3)
//   forward A1 -> 3 3          (len 2)
//   forward A2 -> 3 3 4 5      (len 4)
//   backward: exactly 3 of 340 strings derivable, namely 33 / 334 / 3345
// Check: A0 -> A1 4 with A1 -> 3 3 gives 3 3 4. A2 -> A0 5 with that A0 gives
// 3 3 4 5. Nothing else is derivable, because A1 emits only "3 3" and every rule has a
// fixed literal tail, so no other terminal sequence can be produced.
//
// usage: precond.zag

// ---- runtime ------------------------------------------------------------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
// THE ONLY two accessors used for logical int arrays. Unit symmetry is the whole point.
fn wset(a:[]u8,i:i32,v:i32)void { set32(a,i*4,v); }
fn wget(a:[]u8,i:i32)i32 { return get32(a,i*4); }
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

// ---- problem constants --------------------------------------------------
fn NT()i32 { return 3; }        // non-terminals: 0,1,2
fn NSYM()i32 { return 7; }       // symbols 0..6
fn NRULE()i32 { return 3; }      // rule slots per non-terminal
fn NQ()i32 { return 9; }         // NT*NRULE flat slots
fn MAXD()i32 { return 8; }       // recursion cap
fn MAXOUT()i32 { return 32; }    // emitted-symbol cap
fn TS()i32 { return 3; }         // first terminal
fn NTERM()i32 { return 4; }      // terminals 3..6
fn MAXL()i32 { return 4; }       // max string length swept

fn qidx(l:i32,r:i32)i32 { return l*NRULE()+r; }

// ---- grammar tables (flat, parallel, one logical int each) --------------
fn arity(AR:[]u8,l:i32,r:i32)i32 {
  if(l<0){return 0;}
  if(l>=NT()){return 0;}
  if(r<0){return 0;}
  if(r>=NRULE()){return 0;}
  return wget(AR,qidx(l,r));
}
fn rhs(RH:[]u8,k:i32,l:i32,r:i32)i32 { return wget(RH,qidx(l,r)*3+k); }

// build the three-rule grammar above
fn build(RH:[]u8,AR:[]u8)void {
  let i:i32=0;
  while(i<NQ()){ wget(AR,i); wset(AR,i,0); i=i+1; }
  i=0;
  while(i<NQ()*3){ wset(RH,i,0); i=i+1; }
  // A0 -> A1 4   (l=0,r=0)
  wset(RH,qidx(0,0)*3+0,1); wset(RH,qidx(0,0)*3+1,4); wset(AR,qidx(0,0),2);
  // A1 -> 3 3   (l=1,r=0)
  wset(RH,qidx(1,0)*3+0,3); wset(RH,qidx(1,0)*3+1,3); wset(AR,qidx(1,0),2);
  // A2 -> A0 5   (l=2,r=0)
  wset(RH,qidx(2,0)*3+0,0); wset(RH,qidx(2,0)*3+1,5); wset(AR,qidx(2,0),2);
}

// sweep bound so the sweep visits exactly NT^l strings per length, not NT^MAXL
fn bnd(k:i32,l:i32)i32 { if(k<l){return TS()+NTERM();} return TS()+1; }

// ---- FORWARD ------------------------------------------------------------
// gen appends terminals produced by non-terminal nt to OUT; cur[0] holds the length.
// cur is a cell so nested calls share one cursor (passing `on` by value was bug 1).
fn gen(RH:[]u8,AR:[]u8,nt:i32,out:[]u8,cur:[]u8,depth:i32)i32 {
  if(depth>MAXD()){ return 0; }
  let r:i32=0;
  while(r<NRULE()){
    let a:i32=arity(AR,nt,r);
    if(a>0){
      let save:i32=wget(cur,0);
      let ok:i32=1;
      let k:i32=0;
      while(k<a && ok==1){
        let sym:i32=rhs(RH,k,nt,r);
        if(sym>=NT()){
          let on:i32=wget(cur,0);
          if(on>=MAXOUT()){ ok=0; }
          else { wset(out,on,sym); wset(cur,0,on+1); }
        } else {
          ok=gen(RH,AR,sym,out,cur,depth+1);
        }
        k=k+1;
      }
      if(ok==1){ return 1; }
      wset(cur,0,save);
    }
    r=r+1;
  }
  return 0;
}

// ---- BACKWARD -----------------------------------------------------------
// match returns the index in S just past a full derivation of NT, or -1.
// Membership requires the WHOLE string be consumed (returned index == ns), so a
// partial match is not mistaken for membership.
fn match(RH:[]u8,AR:[]u8,nt:i32,s:[]u8,si:i32,ns:i32,depth:i32)i32 {
  if(depth>MAXD()){ return -1; }
  let r:i32=0;
  while(r<NRULE()){
    let a:i32=arity(AR,nt,r);
    if(a>0){
      let i:i32=si;
      let ok:i32=1;
      let k:i32=0;
      while(k<a && ok==1){
        let sym:i32=rhs(RH,k,nt,r);
        if(sym>=NT()){
          if(i>=ns){ ok=0; }
          else if(wget(s,i)!=sym){ ok=0; }
          else { i=i+1; }
        } else {
          let j:i32=match(RH,AR,sym,s,i,ns,depth+1);
          if(j<0){ ok=0; }
          else { i=j; }
        }
        k=k+1;
      }
      if(ok==1){ return i; }
    }
    r=r+1;
  }
  return -1;
}

fn derivable(RH:[]u8,AR:[]u8,s:[]u8,ns:i32)i32 {
  let b:i32=0;
  while(b<NT()){
    if(match(RH,AR,b,s,0,ns,0)==ns){ return 1; }
    b=b+1;
  }
  return 0;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<16);
  let RH:[]u8=z_alloc(NQ()*3*4);
  let AR:[]u8=z_alloc(NQ()*4);
  let out:[]u8=z_alloc((MAXOUT()+8)*4);
  let cur:[]u8=z_alloc(4);
  let s:[]u8=z_alloc((MAXL()+8)*4);
  let EXP:[]u8=z_alloc(NT()*4);
  wset(EXP,0,3); wset(EXP,1,2); wset(EXP,2,4);
  build(RH,AR);

  let c:i32=0;
  c=o_app(ob,c,"PHASE 6 STRUCTURAL PRECONDITION (pure Zag)"); c=o_nl(ob,c);
  c=o_app(ob,c,"grammar: A0 -> A1 4 | A1 -> 3 3 | A2 -> A0 5"); c=o_nl(ob,c);
  c=o_app(ob,c,"recursion NECESSARY: A0 and A2 have no terminal-only rule"); c=o_nl(ob,c);
  c=o_app(ob,c,"======================================================="); c=o_nl(ob,c);

  // ---- (0) TABLE DUMP: if this is wrong, nothing below means anything
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"(0) table dump -- expect A0:[1,4] A1:[3,3] A2:[0,5], arity 2 each"); c=o_nl(ob,c);
  let dl:i32=0;
  let tbl_ok:i32=1;
  while(dl<NT()){
    c=o_app(ob,c,"  A"); c=o_i64(ob,c,dl as i64); c=o_app(ob,c," arity=[");
    let dr:i32=0;
    while(dr<NRULE()){
      c=o_i64(ob,c,arity(AR,dl,dr) as i64);
      if(dr<NRULE()-1){ c=o_app(ob,c,","); }
      dr=dr+1;
    }
    c=o_app(ob,c,"]  rules:");
    dr=0;
    while(dr<NRULE()){
      c=o_app(ob,c," r"); c=o_i64(ob,c,dr as i64); c=o_app(ob,c,"=[");
      let k:i32=0;
      let a:i32=arity(AR,dl,dr);
      while(k<a){ c=o_i64(ob,c,rhs(RH,k,dl,dr) as i64); if(k<a-1){c=o_app(ob,c,",");} k=k+1; }
      c=o_app(ob,c,"]");
      dr=dr+1;
    }
    c=o_nl(ob,c);
    dl=dl+1;
  }
  // verify the dump against the intended grammar, mechanically
  if(arity(AR,0,0)!=2 || rhs(RH,0,0,0)!=1 || rhs(RH,1,0,0)!=4){ tbl_ok=0; }
  if(arity(AR,1,0)!=2 || rhs(RH,0,1,0)!=3 || rhs(RH,1,1,0)!=3){ tbl_ok=0; }
  if(arity(AR,2,0)!=2 || rhs(RH,0,2,0)!=0 || rhs(RH,1,2,0)!=5){ tbl_ok=0; }
  let r:i32=1;
  while(r<NRULE()){ if(arity(AR,0,r)!=0){tbl_ok=0;} if(arity(AR,1,r)!=0){tbl_ok=0;} if(arity(AR,2,r)!=0){tbl_ok=0;} r=r+1; }

  // ---- (A) FORWARD
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"(A) FORWARD generation -- hand-derived lengths 3, 2, 4"); c=o_nl(ob,c);
  let allgen:i32=1;
  let a:i32=0;
  while(a<NT()){
    wset(cur,0,0);
    let ok:i32=gen(RH,AR,a,out,cur,0);
    let on:i32=wget(cur,0);
    c=o_app(ob,c,"  A"); c=o_i64(ob,c,a as i64); c=o_app(ob,c," -> [");
    if(ok==1){
      let k:i32=0;
      while(k<on){ c=o_i64(ob,c,wget(out,k) as i64); if(k<on-1){c=o_app(ob,c,",");} k=k+1; }
    } else { c=o_app(ob,c,"FAILED"); allgen=0; }
    c=o_app(ob,c,"] len="); c=o_i64(ob,c,on as i64);
    if(ok==1 && on!=wget(EXP,a)){ c=o_app(ob,c,"  MISMATCH"); allgen=0; }
    else if(ok==1){ c=o_app(ob,c,"  ok"); }
    c=o_nl(ob,c);
    a=a+1;
  }

  // ---- (B) BACKWARD: sweep every terminal string of length 1..MAXL
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"(B) BACKWARD membership -- all 4^1+4^2+4^3+4^4 = 340 strings"); c=o_nl(ob,c);
  let tested:i32=0;
  let found:i32=0;
  let l:i32=1;
  while(l<=MAXL()){
    let t1:i32=TS();
    while(t1<bnd(0,l)){
      let t2:i32=TS();
      while(t2<bnd(1,l)){
        let t3:i32=TS();
        while(t3<bnd(2,l)){
          let t4:i32=TS();
          while(t4<bnd(3,l)){
            wset(s,0,t1); wset(s,1,t2); wset(s,2,t3); wset(s,3,t4);
            tested=tested+1;
            if(derivable(RH,AR,s,l)==1){
              found=found+1;
              c=o_app(ob,c,"  derivable: [");
              let k:i32=0;
              while(k<l){ c=o_i64(ob,c,wget(s,k) as i64); if(k<l-1){c=o_app(ob,c,",");} k=k+1; }
              c=o_app(ob,c,"]"); c=o_nl(ob,c);
            }
            t4=t4+1;
          }
          t3=t3+1;
        }
        t2=t2+1;
      }
      t1=t1+1;
    }
    l=l+1;
  }
  c=o_app(ob,c,"  tested    : "); c=o_i64(ob,c,tested as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  derivable : "); c=o_i64(ob,c,found as i64); c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"======================================================="); c=o_nl(ob,c);

  // ---- VERDICT against the hand derivation, never against the prover
  let pass:i32=1;
  if(tbl_ok==0){ pass=0; c=o_app(ob,c,"FAIL: table does not match the intended grammar"); c=o_nl(ob,c); }
  if(allgen==0){ pass=0; c=o_app(ob,c,"FAIL: forward generation != hand-derived lengths 3,2,4"); c=o_nl(ob,c); }
  if(tested!=340){ pass=0; c=o_app(ob,c,"FAIL: sweep did not test 340 strings"); c=o_nl(ob,c); }
  if(found!=3){ pass=0; c=o_app(ob,c,"FAIL: derivable count != hand-derived 3"); c=o_nl(ob,c); }

  if(pass==1){
    c=o_app(ob,c,"PRECONDITION PASSES -- and it was checked against arithmetic a"); c=o_nl(ob,c);
    c=o_app(ob,c,"reader can do by hand, not against the output of the prover."); c=o_nl(ob,c);
    c=o_app(ob,c,""); c=o_nl(ob,c);
    c=o_app(ob,c,"One production table supports BOTH forward generation and exact"); c=o_nl(ob,c);
    c=o_app(ob,c,"backward membership. Recursion is required for any non-terminal"); c=o_nl(ob,c);
    c=o_app(ob,c,"lacking a terminal-only rule; a depth cap is required whenever the"); c=o_nl(ob,c);
    c=o_app(ob,c,"rules contain a cycle. The structural representation class is viable,"); c=o_nl(ob,c);
    c=o_app(ob,c,"so P6-struct MAY PROCEED to the induction experiment."); c=o_nl(ob,c);
    c=o_app(ob,c,""); c=o_nl(ob,c);
    c=o_app(ob,c,"SCOPE, stated to avoid overclaiming: this shows the representation"); c=o_nl(ob,c);
    c=o_app(ob,c,"CAN express a solution. It says nothing yet about whether an inducer"); c=o_nl(ob,c);
    c=o_app(ob,c,"can FIND one, and nothing about generalisation beyond this grammar."); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"PRECONDITION FAILS vs the hand derivation -- FIX THE PROVER."); c=o_nl(ob,c);
    c=o_app(ob,c,"A prover that cannot reproduce a 3-rule table by hand is not"); c=o_nl(ob,c);
    c=o_app(ob,c,"evidence about the substrate. Conclude nothing."); c=o_nl(ob,c);
  }
  _zag_print(ob[0..c]);
  return 0;
}
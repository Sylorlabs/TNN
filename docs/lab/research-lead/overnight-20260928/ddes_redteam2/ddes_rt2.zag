// ddes_rt2.zag -- Fresh red team 2: 4-variable generality attack.
// Copies the GENERIC functions VERBATIM from frozen ddesr.zag
// (REPAIR-PASS 17c97a2cd). No modifications to the copied functions.
// New: 4-variable world_step, driver, load_world_H, main.
// Pure Zag. No Python.
//
// Sealed World H: 4 variables (X=0, A=1, B=2, Y=3).
// H0 = [(X,Y,11)], H1 = [(X,Y,12)]. Delays 11,12 are sealed.

// ============ VERBATIM from ddesr.zag: utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ VERBATIM from ddesr.zag: plan_counter ============
fn plan_counter()[]u8 {
  // single static cell via a fixed buffer; index 0 holds the count
  let b:[]u8=z_alloc(4);
  return b;
}

// ============ VERBATIM from ddesr.zag: compute_arrivals ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  // Bellman-Ford relaxation: n_vars passes suffice for shortest paths
  // with non-negative weights and no negative cycles.
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ VERBATIM from ddesr.zag: compute_frontier ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ VERBATIM from ddesr.zag: eff_waits ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ VERBATIM from ddesr.zag: synthesize_plan ============
fn synthesize_plan(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  // Soundness repair: wait for the effective count, which is at least
  // one tick, so the observation reflects propagation.
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  // observe(V*): V*=1 (Z) -> 3 (OZ); V*=2 (Y) -> 2 (OY).
  // Generic arithmetic: obs = 4 - v_star. No branch on variable id.
  let obs:i32=4-v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

fn emit_plan(plan:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    let a:i32=plan[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else if(a==2){emit("OY");}
    else{emit("OZ");}
    if(i<len-1){emit(",");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERBATIM from ddesr.zag: predict ============
fn predict(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(16);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ NEW: 4-variable world_step (adapted, not verbatim) ============
// State layout for 4 vars: [0]=X, [4]=A, [8]=B, [12]=Y, [16]=time,
// [20]=ts_X, [24]=ts_A, [28]=ts_B, [32]=ts_Y.
// Actions: 0=S, 1=W, 2=OY, 3=OZ, 4=OA, 5=OB (extended for 4 vars).
fn world_step_4v(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,20,get32(st,16));
  } else if(a==1){
    let t:i32=get32(st,16)+1;
    set32(st,16,t);
    let pass:i32=0;
    while(pass<4){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,20+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,20+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,12);
  } else if(a==3){
    obs=get32(st,4);
  } else if(a==4){
    obs=get32(st,4);
  } else if(a==5){
    obs=get32(st,8);
  }
  return obs;
}

// ============ NEW: 4-variable driver (adapted from ddes_world) ============
fn ddes_world_4v(name:[]u8,
              h0_nr:i32, h0_src:[]u8, h0_dst:[]u8, h0_delay:[]u8,
              h1_nr:i32, h1_src:[]u8, h1_dst:[]u8, h1_delay:[]u8,
              t_nr:i32, t_src:[]u8, t_dst:[]u8, t_delay:[]u8,
              plans_built:[]u8)i32 {
  let n_vars:i32=4;
  let INF:i32=268435456;
  emit("WORLD "); emit(name); emit(" (4-var)\n");

  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(16);
    let a1:[]u8=z_alloc(16);
    compute_arrivals(h0_nr, h0_src, h0_dst, h0_delay, n_vars, schema, a0);
    compute_arrivals(h1_nr, h1_src, h1_dst, h1_delay, n_vars, schema, a1);
    let f:[]u8=z_alloc(4);
    let fv:[]u8=z_alloc(4);
    let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, f, fv, ft);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      if(t<best_t){
        best_t=t;
        best_v=get32(fv,0);
        best_schema=schema;
        best_found=1;
      }
    }
    schema=schema-1;
  }

  if(best_found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
    return 0;
  }

  emit("TARGET V*="); e64(best_v); emit(" t*="); e64(best_t);
  emit(" schema="); e64(best_schema); emit("\n");

  let plan:[]u8=z_alloc(64);
  let plen:i32=synthesize_plan(best_v, best_t, best_schema, plan, plans_built);
  emit("PLAN "); emit_plan(plan, plen);
  emit(" candidates_built="); e64(get32(plans_built,0)); emit("\n");

  // Check: is the last action an observation?
  // Frozen encoding: 0=S, 1=W, 2=OY, 3=OZ. For 4 vars, valid
  // observations would be 2,3,4,5. The frozen synthesize_plan
  // produces obs = 4 - v_star. For v_star=3, obs=1 (W).
  let last_a:i32=plan[plen-1] as i32;
  emit("LAST_ACTION="); e64(last_a);
  if(last_a==0){emit(" (S)");}
  else if(last_a==1){emit(" (W)");}
  else if(last_a==2){emit(" (OY)");}
  else if(last_a==3){emit(" (OZ)");}
  else if(last_a==4){emit(" (OA)");}
  else if(last_a==5){emit(" (OB)");}
  else{emit(" (UNKNOWN)");}
  emit("\n");

  if(last_a==1){
    emit("GENERALITY-BREAK: final action is W, not an observation.\n");
    emit("The frozen obs = 4 - v_star formula yields 1 for v_star=3.\n");
    return 2;
  }
  if(last_a<2){
    emit("GENERAILTY-BREAK: final action is not an observation.\n");
    return 2;
  }

  emit("PLAN-OK: final action is an observation.\n");

  // Single real execution (only if plan is valid).
  let st:[]u8=z_alloc(40);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_4v(t_nr, t_src, t_dst, t_delay, st, plan[j] as i32);
    if(o>=0){real_obs=o;}
    j=j+1;
  }
  emit("EXEC real="); e64(real_obs); emit("\n");

  let p0:i32=predict(h0_nr, h0_src, h0_dst, h0_delay, n_vars, best_schema, best_v, best_t);
  let p1:i32=predict(h1_nr, h1_src, h1_dst, h1_delay, n_vars, best_schema, best_v, best_t);
  emit("PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
  let ok:i32=1;
  if(p0!=real_obs){ emit("ELIM h0\n"); } else { emit("SURVIVE h0\n"); }
  if(p1!=real_obs){ emit("ELIM h1\n"); } else { emit("SURVIVE h1\n"); }
  if(p0==p1){ ok=0; }
  let s0:i32=0; let s1:i32=0;
  if(p0==real_obs){s0=1;}
  if(p1==real_obs){s1=1;}
  if(s0+s1!=1){ ok=0; }
  if(ok==1){ emit("CONVERGE-OK\n"); } else { emit("CONVERGE-FAIL\n"); }
  return ok;
}

// ============ NEW: load_world_H (sealed) ============
// H0 = [(X,Y,11)], H1 = [(X,Y,12)]. Variables: X=0, A=1, B=2, Y=3.
// which: 0=h0, 1=h1, 2=true(cfg0=h0), 3=true(cfg1=h1).
fn load_world_H(h:[]u8, which:i32)void {
  if(which==0 || which==2){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,3);
    set32(h,68,11);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,3);
    set32(h,68,12);
  }
  return;
}

fn w_nr(h:[]u8)i32 {
  return get32(h,0);
}
fn w_src(h:[]u8, i:i32)i32 {
  return get32(h,4+i*4);
}
fn w_dst(h:[]u8, i:i32)i32 {
  return get32(h,36+i*4);
}
fn w_delay(h:[]u8, i:i32)i32 {
  return get32(h,68+i*4);
}

fn main()i32 {
  let plans_built:[]u8=z_alloc(4);
  let total_ok:i32=0;
  let total_run:i32=0;
  let breaks:i32=0;

  let cfg:i32=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    load_world_H(h0,0); load_world_H(h1,1); load_world_H(tr,2+cfg);
    let n0:i32=w_nr(h0); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0:[]u8=z_alloc(32);
    let n1:i32=w_nr(h1); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1:[]u8=z_alloc(32);
    let nt:i32=w_nr(tr); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    let i:i32=0;
    while(i<n0){set32(s0,i*4,w_src(h0,i));set32(d0,i*4,w_dst(h0,i));set32(w0,i*4,w_delay(h0,i));i=i+1;}
    i=0;
    while(i<n1){set32(s1,i*4,w_src(h1,i));set32(d1,i*4,w_dst(h1,i));set32(w1,i*4,w_delay(h1,i));i=i+1;}
    i=0;
    while(i<nt){set32(st,i*4,w_src(tr,i));set32(dt,i*4,w_dst(tr,i));set32(wt,i*4,w_delay(tr,i));i=i+1;}
    let r:i32=ddes_world_4v("H", n0,s0,d0,w0, n1,s1,d1,w1, nt,st,dt,wt, plans_built);
    if(r==2){breaks=breaks+1;}
    else{total_ok=total_ok+r;}
    total_run=total_run+1;
    cfg=cfg+1;
  }

  emit("SUMMARY ok="); e64(total_ok); emit("/"); e64(total_run);
  emit(" generality_breaks="); e64(breaks);
  emit(" plans_built="); e64(get32(plans_built,0)); emit("\n");
  return 0;
}

// learner.zag -- L2 COMBINE-XDOMAIN (cross-domain combine with a
// learner-chosen source pair and binding), standalone. Generic
// machinery + learned state only. No world data, no fact literals,
// no relation literals, no domain literals, no source-pair or
// binding literals in this file. The learner never selects sources
// per problem: ex_query searches the learned MAP inventory in
// MAP-id order for the first capability-matching AGG MAP (any
// domain) and collects partner-capability MAPs (first distinct
// live non-query cap in id order); a fixed (partner-source,
// binding) enumeration commits to the first combination whose full
// grounding executes to the query terminal with the required
// value. Every interface mapping (entry relation, fold-pair
// relations, value relation, partner walk rels) is discovered from
// learner state and world facts, never hardcoded.
// Prereg: l2_newfrontier/PREREG.md (frozen). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 reserved  4 NN  5 unused
//   6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_CB  12 CB_ENTERED
//   16..319:  facts, 38 x 8B [sub,rel,obj,live,0,0,0,0]
//   320..959: MAPs, 16 x 40B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x12 @+8, facts x12 @+20,
//               dom @+32, cap @+33, d_entry @+34, d_r1 @+35,
//               d_r2 @+36, d_nf @+37, d_valrel @+38, pad @+39]
//   960..1215: edges, 64 x 4B [from,to,type,pad]
//   1216..1247: answer nodes, 8 x 4B [via,0,0,0]
//   1248 SEARCH i32  1252 EXEC i32  1256 A_SEARCH i32  1260 A_EXEC i32
//   1264 LAST_VAL i32  1268 AGG_SRC (i32)  1272 ROUTE_SRC (i32)
//   1276 BINDING (i32)  1280 BIND_DECIDED (i32)
//   1284 BIND_TRIES (i32, binding attempts made)
//   1288 PIPE_HIT (i32)  1292 LAST_TERM (i32)
//   1296..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn ex_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ex_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ex_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn ex_tick(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_tickm(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_exec(st:[]u8)void {
  set32(st,1252,get32(st,1252)+1);
  if((st[11] as i32)==1){set32(st,1260,get32(st,1260)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=38){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (40-byte rows, 12 rel/fact slots) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>12){return -1;}
  if(fl>12){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==AGG only), generic:
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=320+mid*40;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  ex_exec(st);
  st[6]=255;
  let o:i32=320+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+20+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=960+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[960+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){return 1;}
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn ex_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[960+i*4+2] as i32;
    if(tp!=14){ if(tp!=16){ c=c+1; } }
    i=i+1;
  }
  return c;
}

// ---- counted fact scans (frozen counting rules) ----
// first live fact with sub==s, skipping rel==skiprel. counts examined.
fn ex_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// first live fact with sub==s and rel==r. counts examined.
fn ex_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// value of node nd via vrel: first live fact sub==nd, rel==vrel.
// returns value or -1. counts examined.
fn ex_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=ex_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}

// ---- fold-walk: from entry node u, walk k alternating (s1,s2)
// folds. fold 1 discovers (s1,s2) via first live facts (skipping
// vrel: value annotations are not structural hops);
// folds 2..k require rel==s1 / rel==s2.
// fills ff[0..2k) fact ids.
// returns 0 on fail, else s1 + s2*256 + term*65536.
fn ex_foldwalk(st:[]u8, u:i32, k:i32, vrel:i32, ff:[]u8)i32 {
  let f1:i32=ex_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=ex_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8;
  let j:i32=1;
  while(j<k){
    let g1:i32=ex_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=ex_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*j]=g1 as u8; ff[2*j+1]=g2 as u8;
    j=j+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- AGG segment: entry scan from s, then a k-fold walk with
// runtime relation discovery. final==0: midpoint segment, shape
// success suffices. final==1: terminal segment, require
// term==t AND VAL(term,vrel)==v. Records segment rels into tr
// and fact ids into tf. Returns the foldwalk pack or 0.
fn cb_agg_seg(st:[]u8, ob:[]u8, atp:[]u8, s:i32, k:i32, vrel:i32, final:i32, t:i32, v:i32, tr:[]u8, tf:[]u8)i32 {
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let found:i32=0;
  let re:i32=0;
  let u:i32=0;
  let efid:i32=0;
  while(fid<nfacts){
    if(found==0){
      ex_tick(st);
      let fo:i32=16+fid*8;
      if((st[fo+3] as i32)==1){
        if((st[fo] as i32)==s){
          re=st[fo+1] as i32;
          u=st[fo+2] as i32;
          efid=fid;
          found=1;
        }
      }
    }
    fid=fid+1;
  }
  if(found==0){return 0;}
  let ff:[]u8=z_alloc(16);
  let p2:i32=ex_foldwalk(st,u,k,vrel,ff);
  ex_p(ob,atp,"CB-ENTRY-CAND r=");
  ex_pi(ob,atp,re);
  ex_p(ob,atp," u=");
  ex_pi(ob,atp,u);
  if(p2==0){
    ex_p(ob,atp," FAIL-SHAPE\n");
    return 0;
  }
  let s1:i32=p2%256;
  let s2:i32=(p2/256)%256;
  let term:i32=(p2/65536)%256;
  ex_p(ob,atp," SHAPE-OK term=");
  ex_pi(ob,atp,term);
  let ok:i32=1;
  if(final==1){
    if(term!=t){ok=0;}
    if(ok==1){
      let vv:i32=ex_valof(st,term,vrel);
      if(vv!=v){ok=0;}
    }
    if(ok==1){ex_p(ob,atp," VERIFY-OK\n");}
    else {ex_p(ob,atp," VERIFY-FAIL\n");}
  } else {
    ex_pnl(ob,atp);
  }
  if(ok==0){return 0;}
  tr[0]=re as u8;
  tf[0]=efid as u8;
  let w:i32=0;
  while(w<2*k){
    if((w%2)==0){tr[1+w]=s1 as u8;}
    else {tr[1+w]=s2 as u8;}
    tf[1+w]=ff[w];
    w=w+1;
  }
  return p2;
}

// ---- partner segment: strict walk over the partner source's
// stored relseq rels from s. A missing hop fails the segment
// (this is what rejects a distractor whose relation pattern
// cannot ground). Records hop rels into hr and fact ids into
// hf. Returns the head terminal or -1.
fn cb_route_seg(st:[]u8, s:i32, rsrc:i32, hr:[]u8, hf:[]u8)i32 {
  let o:i32=320+rsrc*40;
  let rl:i32=st[o+4] as i32;
  let cur:i32=s;
  let k:i32=0;
  while(k<rl){
    let r:i32=st[o+8+k] as i32;
    let f:i32=ex_find_subrel(st,cur,r);
    if(f<0){return -1;}
    hr[k]=r as u8;
    hf[k]=f as u8;
    cur=st[16+f*8+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- build, execution-verify, promote, deliver the combined Z ----
fn cb_buildwin(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32, rsrc:i32, hr1:[]u8, hf1:[]u8, l1:i32, hr2:[]u8, hf2:[]u8, l2:i32, avrel:i32)i32 {
  let zr:[]u8=z_alloc(32);
  let zf:[]u8=z_alloc(32);
  let w:i32=0;
  while(w<l1){
    zr[w]=hr1[w];
    zf[w]=hf1[w];
    w=w+1;
  }
  let x:i32=0;
  while(x<l2){
    zr[l1+x]=hr2[x];
    zf[l1+x]=hf2[x];
    x=x+1;
  }
  let zl:i32=l1+l2;
  ex_p(ob,atp,"CB-ZBUILD rels=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec(st,zf,zr,zl,s);
  ex_p(ob,atp,"CB-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,zr,zl,zf,zl,s,vt,qdom,qcap,0,0,0,0,avrel);
    e_add(st,zid,agg_src,16);
    e_add(st,zid,rsrc,16);
    ex_p(ob,atp,"CB-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,agg_src);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,rsrc);
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- the cross-domain COMBINE operator ----
// Partner-source collection (single id-order header pass; the
// first distinct live non-query cap becomes the partner cap),
// then a fixed (partner-source, binding) enumeration: for each
// partner source in id order, binding b=1 (AGG-head,
// partner-tail) then b=2 (partner-head, AGG-tail). The first
// verifying combination wins and the enumeration stops.
fn cb_combine(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32, combine_on:i32)i32 {
  set32(st,1268,agg_src);
  let ao:i32=320+agg_src*40;
  let anfk:i32=st[ao+37] as i32;
  let avrel:i32=st[ao+38] as i32;
  ex_p(ob,atp,"CB-SRC-AGG id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,st[ao+34] as i32);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,st[ao+35] as i32);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,st[ao+36] as i32);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,anfk);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,avrel);
  ex_pnl(ob,atp);
  let nm:i32=st[1] as i32;
  let rsrcs:[]u8=z_alloc(16);
  let nr:i32=0;
  let pcap:i32=-1;
  let mid:i32=0;
  while(mid<nm){
    ex_tickm(st);
    let o:i32=320+mid*40;
    let live:i32=st[o+1] as i32;
    let mc:i32=st[o+33] as i32;
    ex_p(ob,atp,"CB-RSEARCH id=");
    ex_pi(ob,atp,mid);
    ex_p(ob,atp," cap=");
    ex_pi(ob,atp,mc);
    let take:i32=0;
    if(live==1){
      if(mc!=qcap){
        if(pcap<0){pcap=mc;}
        if(mc==pcap){take=1;}
      }
    }
    if(take==1){
      ex_p(ob,atp," PCAP\n");
      rsrcs[nr]=mid as u8;
      nr=nr+1;
    } else {
      ex_p(ob,atp," SKIP\n");
    }
    mid=mid+1;
  }
  if(combine_on==0){
    ex_p(ob,atp,"CB-COMBINE-OFF\n");
    return -2;
  }
  let hr1:[]u8=z_alloc(16);
  let hf1:[]u8=z_alloc(16);
  let hr2:[]u8=z_alloc(16);
  let hf2:[]u8=z_alloc(16);
  let ans:i32=-2;
  let ri:i32=0;
  let won:i32=0;
  while(ri<nr){
    if(won==0){
      let rsrc:i32=rsrcs[ri] as i32;
      ex_p(ob,atp,"CB-SRC-ROUTE id=");
      ex_pi(ob,atp,rsrc);
      ex_pnl(ob,atp);
      // binding b=1: AGG head, partner tail
      set32(st,1284,get32(st,1284)+1);
      let hp:i32=cb_agg_seg(st,ob,atp,s,anfk,avrel,0,0,0,hr1,hf1);
      let w1:i32=0;
      if(hp!=0){
        let ht:i32=(hp/65536)%256;
        let l1:i32=1+2*anfk;
        let ro:i32=320+rsrc*40;
        let l2:i32=st[ro+4] as i32;
        let tt:i32=cb_route_seg(st,ht,rsrc,hr2,hf2);
        if(tt>=0){
          if(tt==t){
            let vv:i32=ex_valof(st,tt,avrel);
            if(vv==v){w1=1;}
          }
        }
        if(w1==1){
          set32(st,1272,rsrc);
          set32(st,1276,1);
          set32(st,1280,1);
          ex_p(ob,atp,"CB-BIND b=1 OK\n");
          ans=cb_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1,hr2,hf2,l2,avrel);
          won=1;
        }
      }
      if(w1==0){
        ex_p(ob,atp,"CB-BIND b=1 FAIL\n");
        // binding b=2: partner head, AGG tail
        set32(st,1284,get32(st,1284)+1);
        let ro2:i32=320+rsrc*40;
        let l1b:i32=st[ro2+4] as i32;
        let ht2:i32=cb_route_seg(st,s,rsrc,hr1,hf1);
        let w2:i32=0;
        if(ht2>=0){
          ex_p(ob,atp,"CB-HEAD term=");
          ex_pi(ob,atp,ht2);
          ex_pnl(ob,atp);
          let tp:i32=cb_agg_seg(st,ob,atp,ht2,anfk,avrel,1,t,v,hr2,hf2);
          if(tp!=0){w2=1;}
        }
        if(w2==1){
          set32(st,1272,rsrc);
          set32(st,1276,2);
          set32(st,1280,1);
          ex_p(ob,atp,"CB-BIND b=2 OK\n");
          let l2b:i32=1+2*anfk;
          ans=cb_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1b,hr2,hf2,l2b,avrel);
          won=1;
        } else {
          ex_p(ob,atp,"CB-BIND b=2 FAIL\n");
        }
      }
    }
    ri=ri+1;
  }
  return ans;
}

// ---- deliver: answer-node provenance + ANS print ----
fn ex_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1264,val);
  set32(st,1292,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  let ao:i32=1216+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  ex_p(ob,atp,"ANS term=");
  ex_pi(ob,atp,term);
  ex_p(ob,atp," val=");
  ex_pi(ob,atp,val);
  ex_p(ob,atp," via=");
  ex_pi(ob,atp,mid);
  ex_pnl(ob,atp);
  return;
}

// ---- query: pipeline, then combine on failure ----
fn ex_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, combine_on:i32)i32 {
  st[12]=0;
  set32(st,1264,-2);
  set32(st,1292,-2);
  set32(st,1288,0);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=320+mid*40;
      let vr2:i32=st[mo+38] as i32;
      if(vr2!=0){vv=ex_valof(st,r,vr2);}
      set32(st,1288,1);
      ex_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // combine phase
  st[11]=1;
  st[12]=1;
  set32(st,1256,0);
  set32(st,1260,0);
  set32(st,1268,-1);
  set32(st,1272,-1);
  set32(st,1276,-1);
  set32(st,1280,0);
  set32(st,1284,0);
  ex_p(ob,atp,"CB-QUERY s=");
  ex_pi(ob,atp,s);
  ex_p(ob,atp," t=");
  ex_pi(ob,atp,t);
  ex_p(ob,atp," v=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," cap=");
  ex_pi(ob,atp,cap);
  ex_p(ob,atp," dom=");
  ex_pi(ob,atp,dom);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"CB-PIPELINE-FAIL\n");
  // AGG-source search: first live MAP with cap==qcap (any domain)
  let agg_src:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=320+mid*40;
      let mc:i32=st[o+33] as i32;
      ex_p(ob,atp,"CB-ASEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=cap){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        agg_src=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(agg_src>=0){
    ans=cb_combine(st,ob,atp,s,t,v,dom,cap,agg_src,combine_on);
  } else {
    ex_p(ob,atp,"CB-NO-SRC\n");
  }
  st[11]=0;
  if(ans<0){
    ex_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1264,-2);
    set32(st,1292,-2);
  }
  return ans;
}

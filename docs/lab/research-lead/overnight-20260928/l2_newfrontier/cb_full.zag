// learner.zag -- L2 COMBINE-XDOMAIN (cross-domain combine with a
// learner-chosen source pair and binding), standalone. Generic
// machinery + learned state only. No world data, no fact literals,
// no relation literals, no domain literals, no source-pair or
// binding literals in this file. The learner never selects sources
// per problem: ex_query searches the learned MAP inventory in
// MAP-id order for the first capability-matching AGG MAP (any
// domain) and collects partner-capability MAPs (first distinct
// live non-query cap in id order); a fixed (partner-source,
// binding) enumeration commits to the first combination whose full
// grounding executes to the query terminal with the required
// value. Every interface mapping (entry relation, fold-pair
// relations, value relation, partner walk rels) is discovered from
// learner state and world facts, never hardcoded.
// Prereg: l2_newfrontier/PREREG.md (frozen). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 reserved  4 NN  5 unused
//   6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_CB  12 CB_ENTERED
//   16..319:  facts, 38 x 8B [sub,rel,obj,live,0,0,0,0]
//   320..959: MAPs, 16 x 40B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x12 @+8, facts x12 @+20,
//               dom @+32, cap @+33, d_entry @+34, d_r1 @+35,
//               d_r2 @+36, d_nf @+37, d_valrel @+38, pad @+39]
//   960..1215: edges, 64 x 4B [from,to,type,pad]
//   1216..1247: answer nodes, 8 x 4B [via,0,0,0]
//   1248 SEARCH i32  1252 EXEC i32  1256 A_SEARCH i32  1260 A_EXEC i32
//   1264 LAST_VAL i32  1268 AGG_SRC (i32)  1272 ROUTE_SRC (i32)
//   1276 BINDING (i32)  1280 BIND_DECIDED (i32)
//   1284 BIND_TRIES (i32, binding attempts made)
//   1288 PIPE_HIT (i32)  1292 LAST_TERM (i32)
//   1296..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn ex_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ex_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ex_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn ex_tick(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_tickm(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_exec(st:[]u8)void {
  set32(st,1252,get32(st,1252)+1);
  if((st[11] as i32)==1){set32(st,1260,get32(st,1260)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=38){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (40-byte rows, 12 rel/fact slots) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>12){return -1;}
  if(fl>12){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==AGG only), generic:
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=320+mid*40;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  ex_exec(st);
  st[6]=255;
  let o:i32=320+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+20+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=960+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[960+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){return 1;}
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn ex_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[960+i*4+2] as i32;
    if(tp!=14){ if(tp!=16){ c=c+1; } }
    i=i+1;
  }
  return c;
}

// ---- counted fact scans (frozen counting rules) ----
// first live fact with sub==s, skipping rel==skiprel. counts examined.
fn ex_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// first live fact with sub==s and rel==r. counts examined.
fn ex_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// value of node nd via vrel: first live fact sub==nd, rel==vrel.
// returns value or -1. counts examined.
fn ex_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=ex_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}

// ---- fold-walk: from entry node u, walk k alternating (s1,s2)
// folds. fold 1 discovers (s1,s2) via first live facts (skipping
// vrel: value annotations are not structural hops);
// folds 2..k require rel==s1 / rel==s2.
// fills ff[0..2k) fact ids.
// returns 0 on fail, else s1 + s2*256 + term*65536.
fn ex_foldwalk(st:[]u8, u:i32, k:i32, vrel:i32, ff:[]u8)i32 {
  let f1:i32=ex_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=ex_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8;
  let j:i32=1;
  while(j<k){
    let g1:i32=ex_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=ex_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*j]=g1 as u8; ff[2*j+1]=g2 as u8;
    j=j+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- AGG segment: entry scan from s, then a k-fold walk with
// runtime relation discovery. final==0: midpoint segment, shape
// success suffices. final==1: terminal segment, require
// term==t AND VAL(term,vrel)==v. Records segment rels into tr
// and fact ids into tf. Returns the foldwalk pack or 0.
fn cb_agg_seg(st:[]u8, ob:[]u8, atp:[]u8, s:i32, k:i32, vrel:i32, final:i32, t:i32, v:i32, tr:[]u8, tf:[]u8)i32 {
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let found:i32=0;
  let re:i32=0;
  let u:i32=0;
  let efid:i32=0;
  while(fid<nfacts){
    if(found==0){
      ex_tick(st);
      let fo:i32=16+fid*8;
      if((st[fo+3] as i32)==1){
        if((st[fo] as i32)==s){
          re=st[fo+1] as i32;
          u=st[fo+2] as i32;
          efid=fid;
          found=1;
        }
      }
    }
    fid=fid+1;
  }
  if(found==0){return 0;}
  let ff:[]u8=z_alloc(16);
  let p2:i32=ex_foldwalk(st,u,k,vrel,ff);
  ex_p(ob,atp,"CB-ENTRY-CAND r=");
  ex_pi(ob,atp,re);
  ex_p(ob,atp," u=");
  ex_pi(ob,atp,u);
  if(p2==0){
    ex_p(ob,atp," FAIL-SHAPE\n");
    return 0;
  }
  let s1:i32=p2%256;
  let s2:i32=(p2/256)%256;
  let term:i32=(p2/65536)%256;
  ex_p(ob,atp," SHAPE-OK term=");
  ex_pi(ob,atp,term);
  let ok:i32=1;
  if(final==1){
    if(term!=t){ok=0;}
    if(ok==1){
      let vv:i32=ex_valof(st,term,vrel);
      if(vv!=v){ok=0;}
    }
    if(ok==1){ex_p(ob,atp," VERIFY-OK\n");}
    else {ex_p(ob,atp," VERIFY-FAIL\n");}
  } else {
    ex_pnl(ob,atp);
  }
  if(ok==0){return 0;}
  tr[0]=re as u8;
  tf[0]=efid as u8;
  let w:i32=0;
  while(w<2*k){
    if((w%2)==0){tr[1+w]=s1 as u8;}
    else {tr[1+w]=s2 as u8;}
    tf[1+w]=ff[w];
    w=w+1;
  }
  return p2;
}

// ---- partner segment: strict walk over the partner source's
// stored relseq rels from s. A missing hop fails the segment
// (this is what rejects a distractor whose relation pattern
// cannot ground). Records hop rels into hr and fact ids into
// hf. Returns the head terminal or -1.
fn cb_route_seg(st:[]u8, s:i32, rsrc:i32, hr:[]u8, hf:[]u8)i32 {
  let o:i32=320+rsrc*40;
  let rl:i32=st[o+4] as i32;
  let cur:i32=s;
  let k:i32=0;
  while(k<rl){
    let r:i32=st[o+8+k] as i32;
    let f:i32=ex_find_subrel(st,cur,r);
    if(f<0){return -1;}
    hr[k]=r as u8;
    hf[k]=f as u8;
    cur=st[16+f*8+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- build, execution-verify, promote, deliver the combined Z ----
fn cb_buildwin(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32, rsrc:i32, hr1:[]u8, hf1:[]u8, l1:i32, hr2:[]u8, hf2:[]u8, l2:i32, avrel:i32)i32 {
  let zr:[]u8=z_alloc(32);
  let zf:[]u8=z_alloc(32);
  let w:i32=0;
  while(w<l1){
    zr[w]=hr1[w];
    zf[w]=hf1[w];
    w=w+1;
  }
  let x:i32=0;
  while(x<l2){
    zr[l1+x]=hr2[x];
    zf[l1+x]=hf2[x];
    x=x+1;
  }
  let zl:i32=l1+l2;
  ex_p(ob,atp,"CB-ZBUILD rels=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec(st,zf,zr,zl,s);
  ex_p(ob,atp,"CB-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,zr,zl,zf,zl,s,vt,qdom,qcap,0,0,0,0,avrel);
    e_add(st,zid,agg_src,16);
    e_add(st,zid,rsrc,16);
    ex_p(ob,atp,"CB-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,agg_src);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,rsrc);
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- the cross-domain COMBINE operator ----
// Partner-source collection (single id-order header pass; the
// first distinct live non-query cap becomes the partner cap),
// then a fixed (partner-source, binding) enumeration: for each
// partner source in id order, binding b=1 (AGG-head,
// partner-tail) then b=2 (partner-head, AGG-tail). The first
// verifying combination wins and the enumeration stops.
fn cb_combine(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, qcap:i32, agg_src:i32, combine_on:i32)i32 {
  set32(st,1268,agg_src);
  let ao:i32=320+agg_src*40;
  let anfk:i32=st[ao+37] as i32;
  let avrel:i32=st[ao+38] as i32;
  ex_p(ob,atp,"CB-SRC-AGG id=");
  ex_pi(ob,atp,agg_src);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,st[ao+34] as i32);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,st[ao+35] as i32);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,st[ao+36] as i32);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,anfk);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,avrel);
  ex_pnl(ob,atp);
  let nm:i32=st[1] as i32;
  let rsrcs:[]u8=z_alloc(16);
  let nr:i32=0;
  let pcap:i32=-1;
  let mid:i32=0;
  while(mid<nm){
    ex_tickm(st);
    let o:i32=320+mid*40;
    let live:i32=st[o+1] as i32;
    let mc:i32=st[o+33] as i32;
    ex_p(ob,atp,"CB-RSEARCH id=");
    ex_pi(ob,atp,mid);
    ex_p(ob,atp," cap=");
    ex_pi(ob,atp,mc);
    let take:i32=0;
    if(live==1){
      if(mc!=qcap){
        if(pcap<0){pcap=mc;}
        if(mc==pcap){take=1;}
      }
    }
    if(take==1){
      ex_p(ob,atp," PCAP\n");
      rsrcs[nr]=mid as u8;
      nr=nr+1;
    } else {
      ex_p(ob,atp," SKIP\n");
    }
    mid=mid+1;
  }
  if(combine_on==0){
    ex_p(ob,atp,"CB-COMBINE-OFF\n");
    return -2;
  }
  let hr1:[]u8=z_alloc(16);
  let hf1:[]u8=z_alloc(16);
  let hr2:[]u8=z_alloc(16);
  let hf2:[]u8=z_alloc(16);
  let ans:i32=-2;
  let ri:i32=0;
  let won:i32=0;
  while(ri<nr){
    if(won==0){
      let rsrc:i32=rsrcs[ri] as i32;
      ex_p(ob,atp,"CB-SRC-ROUTE id=");
      ex_pi(ob,atp,rsrc);
      ex_pnl(ob,atp);
      // binding b=1: AGG head, partner tail
      set32(st,1284,get32(st,1284)+1);
      let hp:i32=cb_agg_seg(st,ob,atp,s,anfk,avrel,0,0,0,hr1,hf1);
      let w1:i32=0;
      if(hp!=0){
        let ht:i32=(hp/65536)%256;
        let l1:i32=1+2*anfk;
        let ro:i32=320+rsrc*40;
        let l2:i32=st[ro+4] as i32;
        let tt:i32=cb_route_seg(st,ht,rsrc,hr2,hf2);
        if(tt>=0){
          if(tt==t){
            let vv:i32=ex_valof(st,tt,avrel);
            if(vv==v){w1=1;}
          }
        }
        if(w1==1){
          set32(st,1272,rsrc);
          set32(st,1276,1);
          set32(st,1280,1);
          ex_p(ob,atp,"CB-BIND b=1 OK\n");
          ans=cb_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1,hr2,hf2,l2,avrel);
          won=1;
        }
      }
      if(w1==0){
        ex_p(ob,atp,"CB-BIND b=1 FAIL\n");
        // binding b=2: partner head, AGG tail
        set32(st,1284,get32(st,1284)+1);
        let ro2:i32=320+rsrc*40;
        let l1b:i32=st[ro2+4] as i32;
        let ht2:i32=cb_route_seg(st,s,rsrc,hr1,hf1);
        let w2:i32=0;
        if(ht2>=0){
          ex_p(ob,atp,"CB-HEAD term=");
          ex_pi(ob,atp,ht2);
          ex_pnl(ob,atp);
          let tp:i32=cb_agg_seg(st,ob,atp,ht2,anfk,avrel,1,t,v,hr2,hf2);
          if(tp!=0){w2=1;}
        }
        if(w2==1){
          set32(st,1272,rsrc);
          set32(st,1276,2);
          set32(st,1280,1);
          ex_p(ob,atp,"CB-BIND b=2 OK\n");
          let l2b:i32=1+2*anfk;
          ans=cb_buildwin(st,ob,atp,s,t,v,qdom,qcap,agg_src,rsrc,hr1,hf1,l1b,hr2,hf2,l2b,avrel);
          won=1;
        } else {
          ex_p(ob,atp,"CB-BIND b=2 FAIL\n");
        }
      }
    }
    ri=ri+1;
  }
  return ans;
}

// ---- deliver: answer-node provenance + ANS print ----
fn ex_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1264,val);
  set32(st,1292,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  let ao:i32=1216+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  ex_p(ob,atp,"ANS term=");
  ex_pi(ob,atp,term);
  ex_p(ob,atp," val=");
  ex_pi(ob,atp,val);
  ex_p(ob,atp," via=");
  ex_pi(ob,atp,mid);
  ex_pnl(ob,atp);
  return;
}

// ---- query: pipeline, then combine on failure ----
fn ex_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, combine_on:i32)i32 {
  st[12]=0;
  set32(st,1264,-2);
  set32(st,1292,-2);
  set32(st,1288,0);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=320+mid*40;
      let vr2:i32=st[mo+38] as i32;
      if(vr2!=0){vv=ex_valof(st,r,vr2);}
      set32(st,1288,1);
      ex_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // combine phase
  st[11]=1;
  st[12]=1;
  set32(st,1256,0);
  set32(st,1260,0);
  set32(st,1268,-1);
  set32(st,1272,-1);
  set32(st,1276,-1);
  set32(st,1280,0);
  set32(st,1284,0);
  ex_p(ob,atp,"CB-QUERY s=");
  ex_pi(ob,atp,s);
  ex_p(ob,atp," t=");
  ex_pi(ob,atp,t);
  ex_p(ob,atp," v=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," cap=");
  ex_pi(ob,atp,cap);
  ex_p(ob,atp," dom=");
  ex_pi(ob,atp,dom);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"CB-PIPELINE-FAIL\n");
  // AGG-source search: first live MAP with cap==qcap (any domain)
  let agg_src:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=320+mid*40;
      let mc:i32=st[o+33] as i32;
      ex_p(ob,atp,"CB-ASEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=cap){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        agg_src=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(agg_src>=0){
    ans=cb_combine(st,ob,atp,s,t,v,dom,cap,agg_src,combine_on);
  } else {
    ex_p(ob,atp,"CB-NO-SRC\n");
  }
  st[11]=0;
  if(ans<0){
    ex_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1264,-2);
    set32(st,1292,-2);
  }
  return ans;
}
// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen fact table (18 facts). The learner only observes facts
// via f_teach and discovers consequences through execution.
// Domain A (arithmetic aggregation):
//   0:(40,5,30) 1:(30,6,41) 2:(41,5,31) 3:(31,6,42)
//   4:(42,5,32) 5:(32,6,43)
//   6:(43,2,11) 7:(100,18,40)
// Domain B (planning: route + cost aggregation):
//   8:(90,7,91) 9:(91,7,92) 10:(92,17,80) 11:(80,15,81)
//   12:(81,16,82) 13:(82,15,83) 14:(83,16,84) 15:(84,15,85)
//   16:(85,16,86) 17:(86,2,42)

fn w_teach_all(st:[]u8)void {
  f_teach(st,40,5,30);
  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,43,2,11);
  f_teach(st,100,18,40);
  f_teach(st,90,7,91);
  f_teach(st,91,7,92);
  f_teach(st,92,17,80);
  f_teach(st,80,15,81);
  f_teach(st,81,16,82);
  f_teach(st,82,15,83);
  f_teach(st,83,16,84);
  f_teach(st,84,15,85);
  f_teach(st,85,16,86);
  f_teach(st,86,2,42);
  return;
}
// driver.zag -- experiment side: teaching, five arms, in-Zag
// kill-bar evaluation. The driver never selects source MAPs for
// a query and never names a source pair or a combination
// binding: Q2 is issued as (90,86,42,AGG,B) with no MAP id, no
// source pair, and no binding; the last ex_query argument is only
// the COMBINE_ON causal-control flag (1 = combine operator
// enabled, 0 = searches only, no enumeration).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1 (X): dom A(1), cap AGG(1), entry + 3 fold pairs,
  // facts [7,0,1,2,3,4,5], 100->43
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs[0]=7; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  // mB0 id2 (Y): dom B(2), cap ROUTE(2), rels [7,7], facts [8,9],
  // 90->92
  rs[0]=7; rs[1]=7; fs[0]=8; fs[1]=9;
  m_teach(st,rs,2,fs,2,90,92,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// X (mA) and the native B MAP (mB0) learned independently:
// disjoint relation sets.
fn d_disjoint(st:[]u8)i32 {
  let o1:i32=320+1*40;
  let rl1:i32=st[o1+4] as i32;
  let k:i32=0;
  let ok:i32=1;
  while(k<rl1){
    let r:i32=st[o1+8+k] as i32;
    let hit:i32=0;
    if(r==18){hit=1;}
    if(r==5){hit=1;}
    if(r==6){hit=1;}
    if(hit==0){ok=0;}
    k=k+1;
  }
  let o2:i32=320+2*40;
  let rl2:i32=st[o2+4] as i32;
  k=0;
  while(k<rl2){
    if((st[o2+8+k] as i32)!=7){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z (id 3) must equal the frozen PREREG section 4 values exactly.
fn d_check_z(st:[]u8)i32 {
  let o:i32=320+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=9){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=86){ok=0;}
  if((st[o+32] as i32)!=2){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=0){ok=0;}
  if((st[o+35] as i32)!=0){ok=0;}
  if((st[o+36] as i32)!=0){ok=0;}
  if((st[o+37] as i32)!=0){ok=0;}
  if((st[o+38] as i32)!=2){ok=0;}
  let er:[]u8=z_alloc(10);
  er[0]=7; er[1]=7; er[2]=17; er[3]=15; er[4]=16; er[5]=15; er[6]=16; er[7]=15; er[8]=16;
  let ef:[]u8=z_alloc(10);
  ef[0]=8; ef[1]=9; ef[2]=10; ef[3]=11; ef[4]=12; ef[5]=13; ef[6]=14; ef[7]=15; ef[8]=16;
  let k:i32=0;
  while(k<9){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stF,ob,atp,100,43,11,1,1,1);
  let qa_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q QB\n");
  ex_query(stF,ob,atp,90,92,-1,2,2,1);
  let qb_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stF,ob,atp,90,86,42,1,2,1);
  let q2_via:i32=stF[9] as i32;
  let q2_val:i32=get32(stF,1264);
  let q2_as:i32=get32(stF,1256);
  let q2_ae:i32=get32(stF,1260);
  let asrc:i32=get32(stF,1268);
  let rsrc:i32=get32(stF,1272);
  let bnum:i32=get32(stF,1276);
  let bdec:i32=get32(stF,1280);
  let btr:i32=get32(stF,1284);
  let phit:i32=get32(stF,1288);
  ex_p(ob,atp,"Q Q2B\n");
  ex_query(stF,ob,atp,90,86,42,1,2,1);
  let q2b_via:i32=stF[9] as i32;
  let q2b_val:i32=get32(stF,1264);
  let q2b_cb:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e14F:i32=e_has_to(stF,3,14);
  let e31F:i32=e_has(stF,3,1,16);
  let e32F:i32=e_has(stF,3,2,16);
  let nmF:i32=stF[1] as i32;
  let zlive:i32=stF[320+3*40+1] as i32;
  let mdlive:i32=stF[320+0*40+1] as i32;
  let disj:i32=d_disjoint(stF);
  let zchk:i32=d_check_z(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,q2_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,q2_ae);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOCOMBINE ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOCOMBINE\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stN,ob,atp,100,43,11,1,1,0);
  ex_p(ob,atp,"Q QB\n");
  ex_query(stN,ob,atp,90,92,-1,2,2,0);
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stN,ob,atp,90,86,42,1,2,0);
  let ne_val:i32=get32(stN,1264);
  let ne_t16:i32=e_count(stN,16);
  let ne_nm:i32=stN[1] as i32;
  let ne_as:i32=get32(stN,1256);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOCOMBINE-END as=");
  ex_pi(ob,atp,ne_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,ne_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-A (mA retired pre-Q2) ----------
  let stA:[]u8=z_alloc(8192);
  d_teach_all(stA);
  ex_p(ob,atp,"ARM ABLATE-A\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stA,ob,atp,100,43,11,1,1,1);
  ex_p(ob,atp,"Q QB\n");
  ex_query(stA,ob,atp,90,92,-1,2,2,1);
  map_retire(stA,1,3);
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stA,ob,atp,90,86,42,1,2,1);
  let ax_val:i32=get32(stA,1264);
  let ax_t16:i32=e_count(stA,16);
  let ax_nm:i32=stA[1] as i32;
  let ax_as:i32=get32(stA,1256);
  let othA:i32=ex_eoth(stA);
  ex_p(ob,atp,"ARM-ABLATEA-END as=");
  ex_pi(ob,atp,ax_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,ax_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othA);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-B (mB0 retired pre-Q2) ----------
  let stB:[]u8=z_alloc(8192);
  d_teach_all(stB);
  ex_p(ob,atp,"ARM ABLATE-B\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stB,ob,atp,100,43,11,1,1,1);
  ex_p(ob,atp,"Q QB\n");
  ex_query(stB,ob,atp,90,92,-1,2,2,1);
  map_retire(stB,2,3);
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stB,ob,atp,90,86,42,1,2,1);
  let bx_val:i32=get32(stB,1264);
  let bx_t16:i32=e_count(stB,16);
  let bx_nm:i32=stB[1] as i32;
  let bx_as:i32=get32(stB,1256);
  let othB:i32=ex_eoth(stB);
  ex_p(ob,atp,"ARM-ABLATEB-END as=");
  ex_pi(ob,atp,bx_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,bx_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othB);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stR,ob,atp,90,86,42,1,2,1);
  let fr_val:i32=get32(stR,1264);
  let fr_t16:i32=e_count(stR,16);
  let fr_nm:i32=stR[1] as i32;
  let fr_as:i32=get32(stR,1256);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END as=");
  ex_pi(ob,atp,fr_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,fr_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othR);
  ex_pnl(ob,atp);

  // ---------- in-Zag kill bars (parent K1-K8 numbering) ----------
  let k1:i32=0;
  if(qa_via==1){
    if(qb_via==2){
      if(q2_via==3){
        if(disj==1){k1=1;}
      }
    }
  }
  let k2:i32=0;
  if(phit==0){
    if(ne_val==-2){
      if(ne_t16==0){k2=1;}
    }
  }
  let k3:i32=0;
  if(asrc==1){
    if(rsrc==2){
      if(bnum==2){
        if(btr==4){
          if(bdec==1){k3=1;}
        }
      }
    }
  }
  let k4:i32=0;
  if(q2_via==3){
    if(q2_val==42){
      if(phit==0){k4=1;}
    }
  }
  let k5:i32=0;
  if(ax_val==-2){
    if(ax_t16==0){
      if(bx_val==-2){
        if(bx_t16==0){k5=1;}
      }
    }
  }
  let k8:i32=0;
  if(t16F==2){
    if(e31F==1){
      if(e32F==1){k8=1;}
    }
  }
  // falsifiers
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW NOCOMBINE\n");ff=1;}
  if(othA!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEA\n");ff=1;}
  if(othB!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEB\n");ff=1;}
  if(othR!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(q2_as!=254){ex_p(ob,atp,"FALSIFIER F-COUNT AS=");ex_pi(ob,atp,q2_as);ex_pnl(ob,atp);ff=1;}
  if(q2_ae!=2){ex_p(ob,atp,"FALSIFIER F-COUNT AE=");ex_pi(ob,atp,q2_ae);ex_pnl(ob,atp);ff=1;}
  if(q2_via!=3){ex_p(ob,atp,"FALSIFIER F-NO-GROUND\n");ff=1;}
  if(zchk!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z\n");ff=1;}
  if(phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT\n");ff=1;}
  if(ne_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOCOMB-PASS\n");ff=1;}
  if(ax_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLA-PASS\n");ff=1;}
  if(ax_t16!=0){ex_p(ob,atp,"FALSIFIER F-ABLA-T16\n");ff=1;}
  if(bx_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLB-PASS\n");ff=1;}
  if(bx_t16!=0){ex_p(ob,atp,"FALSIFIER F-ABLB-T16\n");ff=1;}
  if(fr_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-PASS\n");ff=1;}
  if(q2b_cb!=0){ex_p(ob,atp,"FALSIFIER F-Q2B-RE\n");ff=1;}
  if(q2b_via!=3){ex_p(ob,atp,"FALSIFIER F-Q2B-VIA\n");ff=1;}
  if(q2b_val!=42){ex_p(ob,atp,"FALSIFIER F-Q2B-VAL\n");ff=1;}
  if(t16F!=2){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e31F!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-A\n");ff=1;}
  if(e32F!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-B\n");ff=1;}
  if(e14F!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14\n");ff=1;}
  if(asrc!=1){ex_p(ob,atp,"FALSIFIER F-SRC-A\n");ff=1;}
  if(rsrc!=2){ex_p(ob,atp,"FALSIFIER F-SRC-B\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"L2-COMBINE-XDOMAIN-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

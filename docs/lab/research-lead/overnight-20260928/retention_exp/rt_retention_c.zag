// rt_retention.zag -- consequence-substrate retention input (UNFROZEN pilot).
// Extends the shared consequence substrate (spec 550fa268b, consolidation
// 1ed3f5a6b) with a RETENTION namespace: when a FACT is evicted, a
// provenance-linked consequence record (key, content, eviction tick,
// use count) is written; later teach/query for that key reads it first.
//
// Consequence re-entry pattern:
//   COGNITIVE ACTION (eviction) -> OUTCOME (fact forgotten)
//   -> PROVENANCE-LINKED CONSEQUENCE RECORD (RETENTION entry)
//   -> LATER PRODUCTION READ (teach/query checks retention)
//   -> CHANGED DECISION (answer without trial; re-teach with restored bid).
//
// Record layout: one 40-byte node, tag 61 (same shared store; no new tag).
//   f4:  key_type = 3 (RETENTION)
//   f8:  key_a = s, f12: key_b = r
//   f16: content o (the forgotten answer)
//   f20: eviction tick (clock)
//   f24: use count (type-6 USE edges at eviction)
//   f28: src packed (taught/observed/self, spec 2.4)
//   f32: life packed (spec 2.3; state/mode/cost)
//
// Eviction safety: sub_retain NEVER allocates. It overwrites a pre-allocated
// pool record (empty key -1,-1) or the oldest-tick live record, in place.
// The driver pre-allocates RET_POOL (32) empty records before the battery.
// This bounds retention memory without touching frozen alloc_node.

// ---- substrate core (from sc_substrate.zag, verbatim semantics) ----
fn SUB_TAG()i32 { return 61; }
fn SUB_PURSUIT()i32 { return 1; }
fn SUB_STRATEGY()i32 { return 2; }
fn SUB_RETENTION()i32 { return 3; }
fn SUB_F6()i32 { return 6; }
fn SUB_SRC_TAUGHT()i32 { return 0; }
fn SUB_SRC_OBS()i32 { return 1; }
fn SUB_SRC_SELF()i32 { return 2; }
fn SUB_ST_ACTIVE()i32 { return 0; }

fn sub_src_get(p:i32,k:i32)i32 {
  if(k==0){ return p%1024; }
  if(k==1){ return (p/1024)%1024; }
  return (p/1048576)%1024;
}
fn sub_src_inc(p:i32,k:i32)i32 {
  let v:i32=sub_src_get(p,k);
  if(v>=1023){ return p; }
  if(k==0){ return p+1; }
  if(k==1){ return p+1024; }
  return p+1048576;
}
fn sub_life_state(l:i32)i32 { return l%4; }
fn sub_life_mode(l:i32)i32 { return (l/4)%128; }
fn sub_life_cost(l:i32)i32 { return l/512; }
fn sub_life_mk(st:i32,md:i32,c:i32)i32 {
  let cc:i32=c; if(cc>4194303){ cc=4194303; }
  return (st%4)+(md%128)*4+cc*512;
}
fn sub_find(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==kt && ng(W,n,8)==ka && ng(W,n,12)==kb){ return n; }
    n=n+1;
  }
  return -1;
}
fn sub_get(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n>=0){ return n; }
  n=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,kt); ns(W,n,8,ka); ns(W,n,12,kb);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
fn sub_note(W:[]u8,kt:i32,ka:i32,kb:i32,success:i32,mode:i32,src:i32,cost:i32,create:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){
    if(create==0){ return -1; }
    n=sub_get(W,kt,ka,kb); if(n<0){ return -1; }
  }
  ns(W,n,20,ng(W,n,20)+1);
  ns(W,n,28,sub_src_inc(ng(W,n,28),src));
  let st:i32=sub_life_state(ng(W,n,32));
  let nc:i32=sub_life_cost(ng(W,n,32))+cost;
  if(success==1){
    ns(W,n,24,ng(W,n,24)+1);
    ns(W,n,16,0);
    ns(W,n,32,sub_life_mk(st,0,nc));
  } else {
    ns(W,n,16,ng(W,n,16)+1);
    ns(W,n,32,sub_life_mk(st,mode,nc));
  }
  return n;
}
fn sub_consec(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){ return 0; }
  return ng(W,n,16);
}

// ---- retention write: eviction-safe, in-place overwrite only ----
fn sub_retain(W:[]u8,s:i32,r:i32,o:i32,tick:i32,usec:i32,src:i32)i32 {
  let empty:i32=-1; let oldest:i32=-1; let oldtick:i32=2147483647;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==SUB_RETENTION()){
      if(ng(W,n,8)==s && ng(W,n,12)==r){
        // same key: refresh in place (re-eviction of a re-learned fact)
        ns(W,n,16,o); ns(W,n,20,tick); ns(W,n,24,usec);
        ns(W,n,28,sub_src_inc(ng(W,n,28),src));
        return n;
      }
      if(ng(W,n,8)==-1){ empty=n; }
      if(ng(W,n,20)<oldtick){ oldtick=ng(W,n,20); oldest=n; }
    }
    n=n+1;
  }
  let t:i32=-1;
  if(empty>=0){ t=empty; } else { t=oldest; }
  if(t<0){ return -1; }
  ns(W,t,8,s); ns(W,t,12,r); ns(W,t,16,o); ns(W,t,20,tick); ns(W,t,24,usec);
  ns(W,t,28,sub_src_inc(0,src));
  ns(W,t,32,sub_life_mk(SUB_ST_ACTIVE(),0,0));
  return t;
}

// ---- retention pool: driver-side pre-allocation (bypasses sub_get dedup) ----
// Allocates a fresh empty RETENTION record directly. The empty key (-1,-1)
// is written by hand; sub_retain scans for it. Never deduplicates.
fn sub_pool_new(W:[]u8)i32 {
  let n:i32=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,SUB_RETENTION()); ns(W,n,8,-1); ns(W,n,12,-1);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
fn RET_ON()i32 { return 0; }
fn RET_POOL()i32 { return 32; }
fn RET_USECAP()i32 { return 5; }

fn sc_n()i32 { return 3; }
fn sc_withhold()i32 { return -3; }

// ---- replacement evict_node: base logic + retention hook on FACT eviction ----
fn evict_node(W:[]u8)i32 {
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let b:i32=bid(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){return -1;}
  rec_evict(W,best);
  // retention input: record the forgotten FACT before it dies.
  // eviction-safe: sub_retain overwrites pool records in place, no alloc.
  if(RET_ON()==1 && ng(W,best,0)==1){
    sub_retain(W,ng(W,best,20),ng(W,best,24),ng(W,best,28),hg(W,0),evcount(W,best,6),SUB_SRC_TAUGHT());
  }
  ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

// ---- replacement ev_teach: retention read before alloc; bid restore on hit ----
fn ev_teach(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let rn:i32=-1;
  if(RET_ON()==1){
    rn=sub_find(W,SUB_RETENTION(),s,r);
  }
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,1); write_node(W,n,s,r,o,hg(W,0));
  link_edge(W,n,9,n,hg(W,4));
  // retention-assisted re-learn: restore use count as USE edges (capped),
  // so the re-learned fact is not immediately re-evicted. Amortized cheaper.
  if(rn>=0 && ng(W,rn,16)==o){
    let uc:i32=ng(W,rn,24); if(uc>RET_USECAP()){uc=RET_USECAP();}
    let k:i32=0;
    while(k<uc){ link_edge(W,n,6,n,0); k=k+1; }
  }
  let prev:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m!=n && ng(W,m,0)==1){prev=m;}
    m=m+1;
  }
  if(prev>=0){link_edge(W,n,5,prev,0);}
  if(rn>=0 && ng(W,rn,16)==o){ log_ev(W,1,s,r,o,1,0,0); } else { log_ev(W,1,s,r,o,0,0,0); }
  return n;
}

// ---- replacement ev_query: substrate decline gate + retention short-circuit ----
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let qn0:i32=hg(W,20);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),0,0);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- retention short-circuit: answer from the consequence record ----
  // The eviction wrote what was forgotten; no trial needed to re-derive it.
  if(RET_ON()==1){
    let rn:i32=sub_find(W,SUB_RETENTION(),s,r);
    if(rn>=0){
      let ro:i32=ng(W,rn,16);
      sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),0,0);
      log_ev(W,2,s,r,ro,2,0,0); return ro;
    }
  }
  // ---- decline gate over the shared substrate: consec_fail >= N -> WITHHOLD
  let cf:i32=sub_consec(W,SUB_PURSUIT(),s,r);
  if(cf>=sc_n()){
    log_ev(W,2,s,r,sc_withhold(),cf,sc_n(),0); return sc_withhold();
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),hg(W,20)-qn0,1);
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),hg(W,20)-qn0,1);
    log_ev(W,2,s,r,bv,1,0,0); return bv;
  }
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  let cst:i32=hg(W,20)-qn0;
  sub_note(W,SUB_PURSUIT(),s,r,0,SUB_F6(),SUB_SRC_TAUGHT(),cst,1);
  return -2;
}

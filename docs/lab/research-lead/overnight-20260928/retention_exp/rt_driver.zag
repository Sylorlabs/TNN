// rt_driver.zag -- retention experiment battery (harness-side).
// Tests R5: is re-learning cheaper with consequence-substrate retention input?
//
// Battery:
//   PRE:  pre-allocate 32 empty RETENTION pool records (bid 5 via USE edges,
//         so they survive P2 pressure). Both arms, identical start.
//   P1:   teach 20 facts (7000+i,40,8000+i).
//   P2:   teach 990 fillers (9000+j,41,9000+j). Exactly 20 evictions kill
//         the 20 P1 facts (oldest bid-0). Treatment writes 20 retention
//         records; control writes none.
//   CENSUS: verify 20 facts dead; count retention records; verify content.
//   P3:   query the 20 forgotten keys. Treatment: retention short-circuit
//         (0 trial nodes). Control: full trial path.
//   P4:   re-teach the 20 facts. Treatment: retention-assisted (bid restore).
//   P5:   query the 20 keys, verify hits with correct content.

fn rt_n(W:[]u8)i32 { return hg(W,20); }
fn rt_e(W:[]u8)i32 { return hg(W,24); }

// Pre-allocate the retention pool: 32 empty records, bid 5 each.
fn rt_pool_init(W:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<32){
    let n:i32=sub_pool_new(W);
    if(n<0){ return c; }
    let k:i32=0;
    while(k<5){ link_edge(W,n,6,n,0); k=k+1; }
    c=c+1; i=i+1;
  }
  return c;
}

// Census: live FACTs with key (ks,kr).
fn rt_fact_live(W:[]u8,ks:i32,kr:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==ks && ng(W,n,24)==kr){c=c+1;}
    n=n+1;
  }
  return c;
}

// Census: live RETENTION records; verify content for key (ks,kr).
fn rt_ret_all(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==3 && ng(W,n,8)!=-1){c=c+1;}
    n=n+1;
  }
  return c;
}
fn rt_ret_o(W:[]u8,ks:i32,kr:i32)i32 {
  let n:i32=sub_find(W,SUB_RETENTION(),ks,kr);
  if(n<0){ return -999999; }
  return ng(W,n,16);
}
fn rt_ret_use(W:[]u8,ks:i32,kr:i32)i32 {
  let n:i32=sub_find(W,SUB_RETENTION(),ks,kr);
  if(n<0){ return -999999; }
  return ng(W,n,24);
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("RET-START arm="); e64(RET_ON()); emit("\n");
  let pc:i32=rt_pool_init(W);
  emit("POOL allocated="); e64(pc); emit(" live_nodes="); e64(rt_n(W)); emit("\n");

  let i:i32=0; let s:i32=0; let n0:i32=0; let e0:i32=0;
  let dn:i32=0; let de:i32=0; let ret:i32=0;

  // P1: teach 20 facts
  let p1_dn:i32=0; let p1_c:i32=0;
  i=0;
  while(i<20){
    s=7000+i;
    n0=rt_n(W); e0=rt_e(W);
    ret=ev_teach(W,s,40,8000+i);
    p1_dn=p1_dn+(rt_n(W)-n0); p1_c=p1_c+1;
    i=i+1;
  }
  emit("P1 teach n="); e64(p1_c); emit(" totdn="); e64(p1_dn);
  emit(" live="); e64(rt_n(W)); emit("\n");

  // P2: 990 fillers (exactly 20 evictions: the P1 facts)
  let p2_dn:i32=0; let p2_c:i32=0;
  i=0;
  while(i<990){
    n0=rt_n(W); e0=rt_e(W);
    ret=ev_teach(W,9000+i,41,9000+i);
    p2_dn=p2_dn+(rt_n(W)-n0); p2_c=p2_c+1;
    i=i+1;
  }
  emit("P2 filler n="); e64(p2_c); emit(" totdn="); e64(p2_dn);
  emit(" live="); e64(rt_n(W)); emit(" clock="); e64(hg(W,0)); emit("\n");

  // CENSUS: facts dead? retention records present and correct?
  let dead:i32=0; let rc:i32=0; let rok:i32=0;
  i=0;
  while(i<20){
    s=7000+i;
    if(rt_fact_live(W,s,40)==0){ dead=dead+1; }
    if(rt_ret_o(W,s,40)==8000+i){ rok=rok+1; }
    i=i+1;
  }
  rc=rt_ret_all(W);
  emit("CENSUS facts_dead="); e64(dead); emit("/20");
  emit(" ret_records="); e64(rc);
  emit(" ret_content_ok="); e64(rok); emit("/20\n");

  // P3: query the 20 forgotten keys
  let p3_dn:i32=0; let p3_de:i32=0; let p3_c:i32=0; let p3_ok:i32=0;
  let p3_mindn:i32=999999; let p3_maxdn:i32=-999999;
  i=0;
  while(i<20){
    s=7000+i;
    n0=rt_n(W); e0=rt_e(W);
    ret=ev_query(W,s,40,8000+i,0);
    dn=rt_n(W)-n0; de=rt_e(W)-e0;
    p3_dn=p3_dn+dn; p3_de=p3_de+de; p3_c=p3_c+1;
    if(dn<p3_mindn){p3_mindn=dn;} if(dn>p3_maxdn){p3_maxdn=dn;}
    if(ret==8000+i){ p3_ok=p3_ok+1; }
    emit("E P3 s="); e64(s); emit(" dn="); e64(dn); emit(" de="); e64(de);
    emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  emit("P3 query n="); e64(p3_c); emit(" totdn="); e64(p3_dn); emit(" totde="); e64(p3_de);
  emit(" mindn="); e64(p3_mindn); emit(" maxdn="); e64(p3_maxdn);
  emit(" correct="); e64(p3_ok); emit("/20\n");

  // P4: re-teach the 20 facts
  let p4_dn:i32=0; let p4_de:i32=0; let p4_c:i32=0;
  i=0;
  while(i<20){
    s=7000+i;
    n0=rt_n(W); e0=rt_e(W);
    ret=ev_teach(W,s,40,8000+i);
    p4_dn=p4_dn+(rt_n(W)-n0); p4_de=p4_de+(rt_e(W)-e0); p4_c=p4_c+1;
    i=i+1;
  }
  emit("P4 reteach n="); e64(p4_c); emit(" totdn="); e64(p4_dn); emit(" totde="); e64(p4_de);
  emit(" live="); e64(rt_n(W)); emit("\n");

  // P5: verify hits
  let p5_ok:i32=0;
  i=0;
  while(i<20){
    s=7000+i;
    ret=ev_query(W,s,40,8000+i,0);
    if(ret==8000+i){ p5_ok=p5_ok+1; }
    i=i+1;
  }
  emit("P5 verify hits="); e64(p5_ok); emit("/20");
  emit(" live="); e64(rt_n(W)); emit(" clock="); e64(hg(W,0)); emit("\n");
  emit("RET-END\n");
  return 0;
}

// ===== LEARNER-OWNED VERIFICATION DRIVER (Micah Priority 1) =====
// Can the learner's reliability signal REPLACE researcher-provided `expected`
// for candidate acceptance, rejection, withholding, and revision acceptance?
//
// V1: Acceptance. After reliability built, does learner-verification accept
//     the right candidate for a new chain?
// V2: Rejection. Does learner-verification reject wrong candidates?
// V3: Withholding. Does learner withhold with no basis or unreliable predictor?
// V4: Revision acceptance. After world change, does reliability correctly
//     reject stale structures and accept new ones?
//
// Two binaries: treatment (verify_mode=1, learner) and control (verify_mode=0,
// expected). Same driver, mode-dispatched via lv_trial / lv_verify_one.

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Dispatcher: learner mode uses t2_trial_learner, expected mode uses t2_trial.
fn lv_trial(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,dc:i32,di:i32)i32 {
  if(verify_mode()==1){
    return t2_trial_learner(W,s,r,masked,dc,di);
  } else {
    return t2_trial(W,s,r,expected,masked,dc,di);
  }
}

// Verify one candidate using the arm's mode.
// Treatment: learner prediction (caller must run lv_setup first).
// Control: researcher expected.
fn lv_verify_one(W:[]u8,root:i32,s0:i32,expected:i32,st:[]u8)i32 {
  if(verify_mode()==1){
    return t2_verify_learner(W,root,s0,st);
  } else {
    return t2_try_verify(W,root,s0,expected,0,st);
  }
}

// Find first live MAP for relation r. Returns node id or -1.
fn find_map_rel(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}

// pred_score of first live MAP for relation r, or -999999 if none.
fn map_score_for(W:[]u8,r:i32)i32 {
  let m:i32=find_map_rel(W,r);
  if(m<0){return -999999;}
  return ng(W,m,12);
}

fn stat_tried(W:[]u8)i32 {
  return hg(W,16)/1024;
}
fn stat_rej(W:[]u8)i32 {
  let t:i32=hg(W,16)/1024;
  return hg(W,16)-t*1024;
}

// ---- V1: Acceptance ----
fn v1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: bootstrap MAP_A via expected trial (both arms identical).
  ev_teach(W,1,51,11); ev_teach(W,11,51,12); ev_teach(W,12,51,13); ev_teach(W,13,51,14);
  let b_ans:i32=t2_trial(W,1,50,14,0,0,0);
  rep("V1","bootstrap_ans",b_ans);
  rep("V1","mapA_found",find_map_rel(W,50));
  // Phase 2: build reliability (5 predict/observe cycles).
  let c:i32=0;
  while(c<5){
    let p:i32=ev_predict(W,1,50);
    ev_observe(W,1,50,14);
    c=c+1;
  }
  rep("V1","mapA_score",map_score_for(W,50));
  // Phase 3: new chain B. Query via lv_trial (mode-dependent verification).
  ev_teach(W,2,51,21); ev_teach(W,21,51,22); ev_teach(W,22,51,23); ev_teach(W,23,51,24);
  hs(W,16,0); hs(W,32,0); hs(W,36,0);
  let ans:i32=lv_trial(W,2,50,24,0,0,0);
  rep("V1","ans",ans);
  rep("V1","tried",stat_tried(W));
  rep("V1","rejected",stat_rej(W));
  rep("V1","learner_pred",hg(W,32));
  rep("V1","learner_rel",hg(W,36));
  rep("V1","mapB_found",find_map_rel(W,50));
  return 1;
}

// ---- V2: Rejection ----
// Build reliable predictor, then verify wrong vs correct candidates directly.
fn v2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1+2: same as V1 (bootstrap + reliability).
  ev_teach(W,1,51,11); ev_teach(W,11,51,12); ev_teach(W,12,51,13); ev_teach(W,13,51,14);
  let b_ans:i32=t2_trial(W,1,50,14,0,0,0);
  let c:i32=0;
  while(c<5){
    let p:i32=ev_predict(W,1,50);
    ev_observe(W,1,50,14);
    c=c+1;
  }
  // Phase 3: teach chain B facts. Setup learner prediction for (2,50).
  ev_teach(W,2,51,21); ev_teach(W,21,51,22); ev_teach(W,22,51,23); ev_teach(W,23,51,24);
  // Decoy chain for wrong candidate: 2->31->32 (answer 32).
  ev_teach(W,2,51,31); ev_teach(W,31,51,32);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  if(verify_mode()==1){
    let p:i32=lv_setup(W,2,50);
    rep("V2","setup_pred",p);
    rep("V2","setup_rel",hg(W,36));
  }
  // Wrong candidate: chain [2,31,32] -> produces 32.
  let wv:[]u8=z_alloc(24); let wf:[]u8=z_alloc(16);
  set32(wv,0,2); set32(wv,4,31); set32(wv,8,32);
  // Find fact ids for the decoy links (needed by t2_asm_chain).
  let f1:i32=-1; let f2:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if(ng(W,n,20)==2 && ng(W,n,24)==51 && ng(W,n,28)==31){f1=n;}
      if(ng(W,n,20)==31 && ng(W,n,24)==51 && ng(W,n,28)==32){f2=n;}
    }
    n=n+1;
  }
  set32(wf,0,f1); set32(wf,4,f2);
  let wrong_root:i32=t2_asm_chain(W,wv,3,wf);
  set32(st,0,0); set32(st,4,0);
  let wr:i32=lv_verify_one(W,wrong_root,2,24,st);
  rep("V2","wrong_verdict",wr);
  rep("V2","wrong_tried",get32(st,0));
  rep("V2","wrong_rejected",get32(st,4));
  // Correct candidate: chain [2,21,22,23,24] -> produces 24.
  let cv:[]u8=z_alloc(24); let cf:[]u8=z_alloc(16);
  set32(cv,0,2); set32(cv,4,21); set32(cv,8,22); set32(cv,12,23); set32(cv,16,24);
  let g1:i32=-1; let g2:i32=-1; let g3:i32=-1; let g4:i32=-1; n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if(ng(W,n,20)==2 && ng(W,n,24)==51 && ng(W,n,28)==21){g1=n;}
      if(ng(W,n,20)==21 && ng(W,n,24)==51 && ng(W,n,28)==22){g2=n;}
      if(ng(W,n,20)==22 && ng(W,n,24)==51 && ng(W,n,28)==23){g3=n;}
      if(ng(W,n,20)==23 && ng(W,n,24)==51 && ng(W,n,28)==24){g4=n;}
    }
    n=n+1;
  }
  set32(cf,0,g1); set32(cf,4,g2); set32(cf,8,g3); set32(cf,12,g4);
  let correct_root:i32=t2_asm_chain(W,cv,5,cf);
  set32(st,0,0); set32(st,4,0);
  let cr:i32=lv_verify_one(W,correct_root,2,24,st);
  rep("V2","correct_verdict",cr);
  return 1;
}

// ---- V3: Withholding ----
// 3a: no prediction basis -> withhold. 3b: unreliable predictor -> withhold.
fn v3()i32 {
  // 3a: fresh world, query with no basis.
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,900,60,1);
  hs(W,16,0); hs(W,32,0); hs(W,36,0);
  let a:i32=lv_trial(W,999,50,12345,0,0,0);
  rep("V3","no_basis_verdict",a);
  rep("V3","no_basis_tried",stat_tried(W));
  // 3b: predictor with negative reliability.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,700,50,800);
  let c:i32=0;
  while(c<5){
    let p:i32=ev_predict(W2,700,50);
    ev_observe(W2,700,50,900);
    c=c+1;
  }
  // Predictor FACT (700,50,800) now has score -5. Teach a chain so trial
  // has candidates to find.
  ev_teach(W2,700,51,71); ev_teach(W2,71,51,72);
  hs(W2,16,0); hs(W2,32,0); hs(W2,36,0);
  let b:i32=lv_trial(W2,700,50,72,0,0,0);
  rep("V3","unreliable_verdict",b);
  rep("V3","unreliable_pred",hg(W2,32));
  rep("V3","unreliable_rel",hg(W2,36));
  rep("V3","unreliable_tried",stat_tried(W2));
  return 1;
}

// ---- V4: Revision acceptance ----
// After world change, stale MAP rejected, new structure accepted,
// using the adapted reliability signal.
fn v4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: Chain A, bootstrap MAP_A, build reliability (score 5).
  ev_teach(W,1,51,11); ev_teach(W,11,51,12); ev_teach(W,12,51,13); ev_teach(W,13,51,14);
  let b_ans:i32=t2_trial(W,1,50,14,0,0,0);
  let c:i32=0;
  while(c<5){
    let p:i32=ev_predict(W,1,50);
    ev_observe(W,1,50,14);
    c=c+1;
  }
  rep("V4","mapA_score_pre",map_score_for(W,50));
  let mapA:i32=find_map_rel(W,50);
  let rootA:i32=-1;
  if(mapA>=0){ rootA=ng(W,mapA,20); }
  rep("V4","mapA_root",rootA);
  // Phase 2: world change. Chain now ends at 99. 5 predict/observe cycles
  // with the new outcome.
  ev_teach(W,13,51,99);
  c=0;
  while(c<5){
    let p:i32=ev_predict(W,1,50);
    ev_observe(W,1,50,99);
    c=c+1;
  }
  rep("V4","mapA_score_post",map_score_for(W,50));
  // Phase 3: verify STALE MAP_A (produces 14) for query (1,50).
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  if(verify_mode()==1){
    let p:i32=lv_setup(W,1,50);
    rep("V4","setup_pred",p);
    rep("V4","setup_rel",hg(W,36));
  }
  let stale_v:i32=lv_verify_one(W,rootA,1,99,st);
  rep("V4","stale_verdict",stale_v);
  // Verify a NEW correct candidate: chain [1,11,12,13,99] -> 99.
  let nv:[]u8=z_alloc(24); let nf:[]u8=z_alloc(16);
  set32(nv,0,1); set32(nv,4,11); set32(nv,8,12); set32(nv,12,13); set32(nv,16,99);
  let h1:i32=-1; let h2:i32=-1; let h3:i32=-1; let h4:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      if(ng(W,n,20)==1 && ng(W,n,24)==51 && ng(W,n,28)==11){h1=n;}
      if(ng(W,n,20)==11 && ng(W,n,24)==51 && ng(W,n,28)==12){h2=n;}
      if(ng(W,n,20)==12 && ng(W,n,24)==51 && ng(W,n,28)==13){h3=n;}
      if(ng(W,n,20)==13 && ng(W,n,24)==51 && ng(W,n,28)==99){h4=n;}
    }
    n=n+1;
  }
  set32(nf,0,h1); set32(nf,4,h2); set32(nf,8,h3); set32(nf,12,h4);
  let new_root:i32=t2_asm_chain(W,nv,5,nf);
  set32(st,0,0); set32(st,4,0);
  let new_v:i32=lv_verify_one(W,new_root,1,99,st);
  rep("V4","new_verdict",new_v);
  return 1;
}

fn main()i32 {
  emit("V1\n"); v1();
  emit("V2\n"); v2();
  emit("V3\n"); v3();
  emit("V4\n"); v4();
  emit("DONE\n");
  return 0;
}

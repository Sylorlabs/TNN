// ============ Learner-owned verification (Micah Priority 1) ============
// Replaces researcher-provided `expected` with the learner's own reliability
// signal for candidate acceptance, candidate rejection, withholding, and
// revision acceptance.
//
// Experimental structure:
//   structure predicts outcome -> world outcome arrives later ->
//   learner scores prediction -> future structures accepted/rejected
//   using learner-owned evidence.
//
// Researcher scaffold (honest): lv_rel_thresh value (3), the accept/reject/
//   withhold decision structure, header field usage (32,36), verify_mode gate.
// Learner-owned: the reliability VALUES (from prediction experience only),
//   which predictors are trusted, whether verification succeeds.
// No per-case rules; no "this candidate is good because expected said so."

fn verify_mode()i32 { return 1; }  // 1=learner, 0=expected (control differs)
fn lv_rel_thresh()i32 { return 3; }

// Setup: get learner prediction and predictor reliability for (s,r).
// Uses ev_predict (records PRED node for later resolution via ev_observe).
// Stores prediction in hg(W,32), reliability in hg(W,36).
// Returns prediction, or -999999 if no basis.
fn lv_setup(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=ev_predict(W,s,r);
  if(p==-999999){ return -999999; }
  // Find the PRED node just created: unresolved, matching (s,r), highest index
  // (alloc_node allocates sequentially, so highest index = most recent).
  let bn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      bn=n;
    }
    n=n+1;
  }
  let rel:i32=-999999;
  if(bn>=0){
    let sid:i32=ng(W,bn,12); let kind:i32=ng(W,bn,16);
    if(sid>=2 && ng(W,sid,36)==1){
      if(kind==1){ rel=ng(W,sid,8); }
      else { if(kind==20){ rel=ng(W,sid,12); } }
    }
  }
  hs(W,32,p); hs(W,36,rel);
  return p;
}

// Learner-owned verify of one candidate graph.
// Accepts iff candidate output == learner prediction (hg(W,32)).
// A failed guard (execute -999999 or -2) is a genuine rejection.
// st[0]=tried, st[1]=rejected (same packing as t2_try_verify).
// Returns verified answer, or -2 on rejection.
fn t2_verify_learner(W:[]u8,root:i32,s0:i32,st:[]u8)i32 {
  if(root<0){return -2;}
  set32(st,0,get32(st,0)+1);
  let v:i32=t2_exec(W,root,s0);
  if(v==-2 || v==-999999){
    set32(st,4,get32(st,4)+1);
    return -2;
  }
  if(v==hg(W,32)){return v;}
  set32(st,4,get32(st,4)+1);
  return -2;
}

// Learner-owned trial. Same 4-phase candidate search as t2_trial, but the
// accept/reject decision uses the learner's own prediction + reliability
// instead of the researcher-supplied `expected`.
//
// Returns:
//   ans (>=0): candidate accepted (matches reliable learner prediction)
//   -2: all candidates rejected (learner prediction reliable, none matched)
//   -3: WITHHELD (no prediction basis, or predictor reliability < threshold)
// masked is ignored in learner mode (always compares to learner prediction).
fn t2_trial_learner(W:[]u8,s:i32,r:i32,masked:i32,dc:i32,di:i32)i32 {
  let p:i32=lv_setup(W,s,r);
  if(p==-999999){ return -3; }
  if(hg(W,36)<lv_rel_thresh()){ return -3; }
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=-2;
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  if(dc==0){
    let k:i32=2;
    while(k<=4 && ans==-2){
      let q:i32=0;
      while(q<np && ans==-2){
        let base:i32=q*48;
        if(get32(paths,base)==k+1){
          let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
          let j:i32=0;
          while(j<=k){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<k){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,k+1,f);
          let v2:i32=t2_verify_learner(W,root,s,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,f,k); ans=v2;}
        }
        q=q+1;
      }
      k=k+1;
    }
  }
  if(ans==-2 && comb_present(W)>=0){
    let vals:[]u8=z_alloc(48); let sf:[]u8=z_alloc(48);
    let m:i32=t2_gather_sum(W,s,vals,sf);
    let sz:i32=m;
    while(sz>=1 && ans==-2){
      let mask:i32=(1<<m)-1;
      while(mask>0 && ans==-2){
        if(popcnt(mask)==sz){
          let sv:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
          let c:i32=0; let b:i32=0;
          while(b<m){
            if(((mask>>b)&1)==1){set32(sv,c*4,get32(vals,b*4)); set32(ff,c*4,get32(sf,b*4)); c=c+1;}
            b=b+1;
          }
          let root:i32=t2_asm_sum(W,sv,c);
          let v2:i32=t2_verify_learner(W,root,0,st);
          if(v2!=-2){promote_graph(W,root,s,r,v2,ff,c); ans=v2;}
        }
        mask=mask-1;
      }
      sz=sz-1;
    }
  }
  if(ans==-2 && di==0){
    let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
    let i:i32=0;
    while(i<nr && ans==-2){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
      if(len>=2){
        let root:i32=t2_asm_count(W,v,len,f);
        let v2:i32=t2_verify_learner(W,root,s,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,len-1); ans=v2;}
      }
      i=i+1;
    }
  }
  if(ans==-2){
    let q:i32=0;
    while(q<np && ans==-2){
      let base:i32=q*48;
      if(get32(paths,base)==2){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(f,0,get32(paths,base+24));
        let root:i32=t2_asm_chain(W,v,2,f);
        let v2:i32=t2_verify_learner(W,root,s,st);
        if(v2!=-2){promote_graph(W,root,s,r,v2,f,1); ans=v2;}
      }
      q=q+1;
    }
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  return ans;
}

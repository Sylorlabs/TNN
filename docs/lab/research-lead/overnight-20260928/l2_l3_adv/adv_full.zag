// learner.zag -- generic L2+L3 combination learner (MEADOW).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no reduction solution in this file.
// Prereg: l2_l3_combo/PREREG.md (commit fb1075ef0). Pure Zag.
// 0 modes, 0 handlers, 0 semantic cases, no cross-structure glue.
//
// State layout (u8 buffer, offsets):
//   0: XN   1: LN   2: YN   3: YT_SET
//   4: REPLAY_LEN (learned)   5: ADAPT_ON (driver-set causal control)
//   8..119:   X slots, 16 x 7 bytes [id,e0,e1,e2,e3,e4,e5], 255 = empty
//   120..151: label slots, 16 x 2 bytes [id,label]
//   152..155: Y threshold i32
//   156..187: M slot, 32 bytes [n,gen,sup,pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   188..219: Mprev slot, 32 bytes (reserved; unused in this build)
//   220..251: Y scalar observations, 16 x 2 bytes [scalar,outcome]
//   252..255: ADAPT-STAT ext_count i32
//   256..259: ADAPT-STAT recall_calls i32
//   260..1023: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer) ----
fn x_teach(st:[]u8, id:i32, r0:i32, r1:i32, r2:i32, r3:i32, r4:i32, r5:i32, nfill:i32)void {
  let n:i32=st[0] as i32;
  if(n>=16){return;}
  let o:i32=8+n*7;
  st[o]=id as u8;
  st[o+1]=r0 as u8; st[o+2]=r1 as u8; st[o+3]=r2 as u8;
  st[o+4]=r3 as u8; st[o+5]=r4 as u8; st[o+6]=r5 as u8;
  let k:i32=nfill;
  while(k<6){st[o+1+k]=255;k=k+1;}
  st[0]=(n+1) as u8;
  return;
}
// REPLAY_LEN = longest prefix filled in EVERY taught episode.
fn x_learn_len(st:[]u8)i32 {
  let n:i32=st[0] as i32;
  let L:i32=6;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    let k:i32=0;
    while(k<6){
      if((st[o+1+k] as i32)==255){
        if(k<L){L=k;}
        k=6;
      } else { k=k+1; }
    }
    i=i+1;
  }
  if(n==0){L=0;}
  st[4]=L as u8;
  return L;
}
// x_recall with the L2 EXTEND standing rule. Replays slots 0..L-1,
// then, iff ADAPT_ON==1, continues past L while the next slot is
// filled (structural precondition from learner state), up to 2 extra
// slots. Returns readings replayed; 0 = episode unknown. Trailing
// out slots are zeroed, so out always holds exactly the replay.
fn x_recall(st:[]u8, id:i32, out:[]u8)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    if((st[o] as i32)==id){
      let L:i32=st[4] as i32;
      if(L>6){L=6;}
      let k:i32=0;
      while(k<L){
        out[k]=st[o+1+k];
        k=k+1;
      }
      let ext:i32=0;
      if((st[5] as i32)==1){
        let go:i32=1;
        while(go==1){
          if(k>=6){go=0;}
          else {
            if(ext>=2){go=0;}
            else {
              if((st[o+1+k] as i32)==255){go=0;}
              else { out[k]=st[o+1+k]; k=k+1; ext=ext+1; }
            }
          }
        }
      }
      let nr:i32=k;
      while(k<6){out[k]=0;k=k+1;}
      set32(st,256,get32(st,256)+1);
      if(ext>0){set32(st,252,get32(st,252)+1);}
      return nr;
    }
    i=i+1;
  }
  return 0;
}

// ---- labels: observed outcomes ----
fn lab_teach(st:[]u8, id:i32, lab:i32)void {
  let n:i32=st[1] as i32;
  if(n>=16){return;}
  let o:i32=120+n*2;
  st[o]=id as u8; st[o+1]=lab as u8;
  st[1]=(n+1) as u8;
  return;
}
fn lab_get(st:[]u8, id:i32)i32 {
  let n:i32=st[1] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=120+i*2;
    if((st[o] as i32)==id){return st[o+1] as i32;}
    i=i+1;
  }
  return -1;
}

// ---- Y: threshold decide (scalar consumer) ----
fn y_teach(st:[]u8, s:i32, oc:i32)void {
  let n:i32=st[2] as i32;
  if(n>=16){return;}
  let o:i32=220+n*2;
  st[o]=s as u8; st[o+1]=oc as u8;
  st[2]=(n+1) as u8;
  return;
}
fn y_fit(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let bt:i32=0;
  let bs:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<n){
      let o:i32=220+i*2;
      let s:i32=st[o] as i32;
      let oc:i32=st[o+1] as i32;
      let p:i32=0;
      if(s>=t){p=1;}
      if(p==oc){c=c+1;}
      i=i+1;
    }
    if(c>bs){bs=c;bt=t;}
    t=t+1;
  }
  set32(st,152,bt);
  st[3]=1;
  return bs;
}
fn y_decide(st:[]u8, s:i32)i32 {
  if((st[3] as i32)==0){return -1;}
  let t:i32=get32(st,152);
  if(s>=t){return 1;}
  return 0;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R5 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, r0:i32, r1:i32, r2:i32, r3:i32, r4:i32, r5:i32, rg:[]u8)i32 {
  set32(rg,0,r0); set32(rg,4,r1); set32(rg,8,r2);
  set32(rg,12,r3); set32(rg,16,r4); set32(rg,20,r5);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
fn p_outs(prog:[]u8, n:i32, st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let f:i32=x_recall(st,id,sq);
    let v:i32=-999;
    if(f>0){
      v=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),rg);
    }
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
fn count_correct(vals:[]u8, labs:[]u8, ne:i32, t:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=get32(vals,i*4);
    let p:i32=0;
    if(v>=t){p=1;}
    if(p==(labs[i] as i32)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn best_t_of_vals(vals:[]u8, labs:[]u8, ne:i32, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=count_correct(vals,labs,ne,t);
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}

// ---- construct: greedy program construction from experience ----
// mbuf (24B) gets the final program; mout: [0]=n [4]=threshold [8]=score.
// Trace lines are appended to ob; returns new at.
fn construct(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, init:[]u8, initn:i32, rg:[]u8, sq:[]u8, vals:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  p_outs(cur,cn,st,eids,ne,rg,sq,vals);
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  let bt:i32=get32(bto,0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<6){
          let s:i32=0;
          while(s<6){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            p_outs(cand,cn+1,st,eids,ne,rg,sq,vals);
            let cto:[]u8=z_alloc(4);
            let cs:i32=best_t_of_vals(vals,labs,ne,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      at=ob_app(ob,at,"C-ROUND ");
      at=ob_i32(ob,at,round);
      at=ob_app(ob,at," base=");
      at=ob_i32(ob,at,bs);
      at=ob_app(ob,at," eval=");
      at=ob_i32(ob,at,neval);
      if(bg>0){
        at=ob_app(ob,at," win=");
        at=ob_i32(ob,at,bop);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bd);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bss);
        at=ob_app(ob,at," gain=");
        at=ob_i32(ob,at,bg);
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        p_outs(cur,cn,st,eids,ne,rg,sq,vals);
        bs=best_t_of_vals(vals,labs,ne,bto);
        bt=get32(bto,0);
        at=ob_app(ob,at," score=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,bt);
        at=ob_nl(ob,at);
      } else {
        at=ob_app(ob,at," stop");
        at=ob_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[156]=n as u8; st[157]=gen as u8; st[158]=0; st[159]=0;
  set32(st,160,t);
  let k:i32=0;
  while(k<24){st[164+k]=prog[k];k=k+1;}
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[156+k]=0;k=k+1;}
  return;
}

// ---- decide: X -> M -> Y; -1 = NO_DECISION ----
fn decide(st:[]u8, id:i32, rg:[]u8, sq:[]u8)i32 {
  let nr:i32=x_recall(st,id,sq);
  if(nr==0){return -1;}
  let mn:i32=st[156] as i32;
  if(mn==0){return -1;}
  if((st[3] as i32)==0){return -1;}
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[164+k];k=k+1;}
  let s:i32=p_exec(mprog,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),rg);
  return y_decide(st,s);
}
// world.zag -- RELAY environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rule and episode tables. The learner never calls
// anything in this file. The driver uses the hidden rule only to
// generate observed labels for teaching.
// Tables match l2_l3_adv/PREREG.md section 3 exactly.
// Scenario: relay station, 6 hourly signal-strength readings per day.
// Old protocol: 4 readings per day. Hidden rule: link STABLE iff the
// overnight climb e5-e1 >= 5.

// Phase 0: old-protocol episodes, 4 readings each (slots 4,5 unfilled).
fn w_oldtab()[]u8 { return "31420526"; }
fn w_oldid(idx:i32)i32 { return idx+51; }
fn w_oldseq(idx:i32, out:[]u8)void {
  let T:[]u8=w_oldtab();
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Phase 1: ph=1 train (8 episodes x 6 readings), ph=2 test (4 x 6).
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "021308015207040609043109021302015203040604043108";}
  return "012408030109025304061208";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  return idx+9;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rule (never visible to the learner).
// STABLE iff e5-e1 >= 5 (overnight signal climb).
fn w_true(e0:i32, e1:i32, e2:i32, e3:i32, e4:i32, e5:i32)i32 {
  if(e5-e1>=5){return 1;}
  return 0;
}
// driver.zag -- RELAY L2-L3 adversarial experiment driver.
// Arms, kill-bar evaluation. The driver teaches X/Y, runs the
// learner's construct, and evaluates Z. It never invents the
// intermediate: all construction goes through learner.zag, which is
// reused byte-identical from the MEADOW build and never modified.
// Prereg: l2_l3_adv/PREREG.md (commit 4f87b09e6). Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,7,1); y_teach(st,8,1); y_teach(st,6,1);
  y_teach(st,5,1); y_teach(st,4,0); y_teach(st,3,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,152));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_old(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<2){
    w_oldseq(i,sq);
    let id:i32=w_oldid(i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),0,0,4);
    at=ob_app(ob,at,"X-OLD id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    at=ob_i32(ob,at,(sq[0] as i32)); at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[1] as i32)); at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[2] as i32)); at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[3] as i32));
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_phase(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<8){
    w_seq(1,i,sq);
    let id:i32=w_id(1,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    let lb:i32=w_true((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    lab_teach(st,id,lb);
    at=ob_app(ob,at,"X-TEACH id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    let k:i32=0;
    while(k<6){
      at=ob_i32(ob,at,(sq[k] as i32));
      if(k<5){at=ob_app(ob,at,",");}
      k=k+1;
    }
    at=ob_app(ob,at," label=");
    at=ob_i32(ob,at,lb);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_test(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_seq(2,i,sq);
    let id:i32=w_id(2,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-TEST id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[156] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[157] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[158] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,160));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[164+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_adapt_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_app(ob,at," ext=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," calls=");
  at=ob_i32(ob,at,get32(st,256));
  at=ob_nl(ob,at);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let nr:i32=x_recall(st,id,sq);
    let tl:i32=-2;
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(nr>0){
      tl=w_true((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
      let mn:i32=st[156] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[164+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      let k:i32=0;
      while(k<nr){
        at=ob_i32(ob,at,(sq[k] as i32));
        if(k<nr-1){at=ob_app(ob,at,",");}
        k=k+1;
      }
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(24);
  let sq:[]u8=z_alloc(6);
  let vals:[]u8=z_alloc(32);
  let atp:[]u8=z_alloc(4);
  at=ob_app(ob,at,"L2L3-ADV-START\n");

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let eidsT:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<4){eidsT[i]=(i+9) as u8;i=i+1;}

  // ================= ARM-FULL =================
  at=ob_app(ob,at,"=== ARM-FULL ===\n");
  let st1:[]u8=z_alloc(1024);
  st1[5]=1;
  at=d_y_prior(st1,ob,at);
  at=d_teach_old(st1,ob,at);
  at=d_teach_phase(st1,ob,at);
  at=d_teach_test(st1,ob,at);
  i=0;
  while(i<8){
    let id:i32=i+1;
    eids1[i]=id as u8;
    labs1[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  at=ob_app(ob,at,"--- construct M (fresh) ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st1,eids1,labs1,8,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn1:i32=get32(mout,0);
  let mt1:i32=get32(mout,4);
  let ms1:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn1);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt1);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms1);
  at=ob_app(ob,at,"/8\n");
  m_write(st1,mn1,1,mt1,mbuf);
  set32(st1,152,mt1);
  at=ob_app(ob,at,"T-AGREE y=");
  at=ob_i32(ob,at,get32(st1,152));
  at=ob_app(ob,at," m=");
  at=ob_i32(ob,at,get32(st1,160));
  at=ob_nl(ob,at);
  at=d_m_dump(st1,"M-STATE",ob,at);
  set32(atp,0,at);
  let zfull:i32=d_z_run(st1,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FULL ");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st1,"ADAPT-STAT-FULL",ob,at);

  // ================= ARM-L2-ONLY =================
  at=ob_app(ob,at,"=== ARM-L2-ONLY ===\n");
  let st2:[]u8=z_alloc(1024);
  st2[5]=1;
  at=d_y_prior(st2,ob,at);
  at=d_teach_old(st2,ob,at);
  at=d_teach_phase(st2,ob,at);
  at=d_teach_test(st2,ob,at);
  at=d_m_dump(st2,"M-STATE",ob,at);
  set32(atp,0,at);
  let zl2:i32=d_z_run(st2,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-L2ONLY ");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st2,"ADAPT-STAT-L2ONLY",ob,at);

  // ================= ARM-L3-ONLY =================
  at=ob_app(ob,at,"=== ARM-L3-ONLY ===\n");
  let st3:[]u8=z_alloc(1024);
  st3[5]=0;
  at=d_y_prior(st3,ob,at);
  at=d_teach_old(st3,ob,at);
  at=d_teach_phase(st3,ob,at);
  at=d_teach_test(st3,ob,at);
  i=0;
  while(i<8){
    let id:i32=i+1;
    labs1[i]=lab_get(st3,id) as u8;
    i=i+1;
  }
  at=ob_app(ob,at,"--- construct M (fresh, no adaptation) ---\n");
  let mbuf3:[]u8=z_alloc(24);
  let mout3:[]u8=z_alloc(12);
  at=construct(st3,eids1,labs1,8,init,0,rg,sq,vals,mbuf3,mout3,ob,at);
  let mn3:i32=get32(mout3,0);
  let ms3:i32=get32(mout3,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn3);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms3);
  at=ob_app(ob,at,"/8\n");
  at=d_m_dump(st3,"M-STATE",ob,at);
  set32(atp,0,at);
  let zl3:i32=d_z_run(st3,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-L3ONLY ");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st3,"ADAPT-STAT-L3ONLY",ob,at);

  // ================= ARM-FRESH =================
  at=ob_app(ob,at,"=== ARM-FRESH ===\n");
  let st4:[]u8=z_alloc(1024);
  set32(atp,0,at);
  let zfr:i32=d_z_run(st4,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FRESH ");
  at=ob_i32(ob,at,zfr);
  at=ob_app(ob,at,"/4\n");

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let ext1:i32=get32(st1,252);
  let ext2:i32=get32(st2,252);
  let ext3:i32=get32(st3,252);
  let k1:i32=0;
  if(zl2==0){if(zl3==0){if(zfull==4){k1=1;}}}
  at=ob_app(ob,at,"K-CB-1 both-required l2only=");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at," l3only=");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at," full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  let k2:i32=0;
  if(zl2==0){if(ext2>=1){k2=1;}}
  at=ob_app(ob,at,"K-CB-2 l2-only-fails z=");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at," ext=");
  at=ob_i32(ob,at,ext2);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k2);
  at=ob_nl(ob,at);
  let k3:i32=0;
  if(zl3==0){if(ext3==0){if(mn3==0){k3=1;}}}
  at=ob_app(ob,at,"K-CB-3 l3-only-fails z=");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at," ext=");
  at=ob_i32(ob,at,ext3);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,mn3);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(zfull==4){
    if(ext1>=1){
      if(mn1==2){
        if((st1[164] as i32)==0){
          if((st1[165] as i32)==0){
            if((st1[166] as i32)==5){
              if((st1[167] as i32)==2){
                if((st1[168] as i32)==0){
                  if((st1[169] as i32)==1){k4=1;}
                }
              }
            }
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-CB-4 combined-provenance z=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," ext=");
  at=ob_i32(ob,at,ext1);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,mn1);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-CB-5 grep-audit see-shell (frozen patterns, learner.zag)\n");
  at=ob_app(ob,at,"K-CB-6 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"L2L3-ADV-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

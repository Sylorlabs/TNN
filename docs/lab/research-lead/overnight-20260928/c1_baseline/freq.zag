// freq.zag - B2 FREQ baseline: global most-frequent taught value.
// Usage: freq <turn.json> <statedir>
// State lines: v|count. Answers every attr query with the most
// frequent taught value (earliest first-seen wins ties); "" else.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn app1(buf:[]u8,at:i32,c:u8)i32 { buf[at]=c; return at+1; }
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn write_file(path:[]u8,data:[]u8)void {
  let fd:i64=w_open(path);
  if(fd>=0){ w_write(fd,data); w_close(fd); }
  return;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn parsei(s:[]u8)i32 {
  let v:i32=0;
  let i:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  return v;
}
fn puti(buf:[]u8,at:i32,v:i32)i32 {
  if(v==0){return app1(buf,at,48);}
  let tmp:[]u8=z_alloc(12);
  let n:i32=0;
  let x:i32=v;
  while(x>0){tmp[n]=(x%10 as u8)+48;n=n+1;x=x/10;}
  let i:i32=n-1;
  while(i>=0){at=app1(buf,at,tmp[i]);i=i-1;}
  z_free(tmp);
  return at;
}
// record one taught value v into v|count state; returns new buffer
fn observe(buf:[]u8,v:[]u8)[]u8 {
  let nb:[]u8=z_alloc(buf.len+v.len+16);
  let at:i32=0;
  let p:i32=0;
  let found:i32=0;
  while(p<buf.len){
    let e:i32=p;
    while(e<buf.len && buf[e]!=10){e=e+1;}
    let s1:i32=p;
    while(s1<e && buf[s1]!=124){s1=s1+1;}
    if(s1<e){
      let lv:[]u8=buf[p..s1];
      let lc:[]u8=buf[s1+1..e];
      if(streq(lv,v)==1){
        found=1;
        at=app(nb,at,lv);
        at=app1(nb,at,124);
        at=puti(nb,at,parsei(lc)+1);
        at=app1(nb,at,10);
      } else {
        let i:i32=p;
        while(i<e){nb[at]=buf[i];at=at+1;i=i+1;}
        at=app1(nb,at,10);
      }
    }
    p=e+1;
  }
  if(found==0){
    at=app(nb,at,v);
    at=app1(nb,at,124);
    at=app1(nb,at,49);
    at=app1(nb,at,10);
  }
  return nb[0..at];
}
// most frequent value; earliest first-seen wins ties
fn top(buf:[]u8)[]u8 {
  let best:[]u8="";
  let bestc:i32=0;
  let p:i32=0;
  while(p<buf.len){
    let e:i32=p;
    while(e<buf.len && buf[e]!=10){e=e+1;}
    let s1:i32=p;
    while(s1<e && buf[s1]!=124){s1=s1+1;}
    if(s1<e){
      let lv:[]u8=buf[p..s1];
      let c:i32=parsei(buf[s1+1..e]);
      if(c>bestc){bestc=c;best=lv;}
    }
    p=e+1;
  }
  return best;
}
fn main()i32 {
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  if(turnpath.len==0 || statedir.len==0){ return 1; }
  let line:[]u8=read_file(turnpath);
  let kind:[]u8=jval(line,"kind");
  let sp:[]u8=pjoin(statedir,"state.txt");
  let buf:[]u8=read_file(sp);
  let out:[]u8=z_alloc(4096);
  let on:i32=0;
  if(streq(kind,"obs")==1){
    let t:[]u8=jval(line,"t");
    if(streq(t,"fact")==1){
      let v:[]u8=jval(line,"v");
      let nb:[]u8=observe(buf,v);
      write_file(sp,nb);
      z_free(nb);
    }
    on=app(out,on,"{\"ack\":true}");
  } else {
    if(streq(kind,"query")==1){
      let qid:[]u8=jval(line,"qid");
      let qt:[]u8=jval(line,"t");
      let ans:[]u8="";
      if(streq(qt,"attr")==1){ ans=top(buf); }
      on=app(out,on,"{\"qid\":\"");
      on=app(out,on,qid);
      on=app(out,on,"\",\"answer\":\"");
      on=app(out,on,ans);
      on=app(out,on,"\"}");
    } else {
      if(streq(kind,"act")==1){
        on=app(out,on,"{\"done\":true}");
      } else {
        on=app(out,on,"{\"ack\":true}");
      }
    }
  }
  emit(out[0..on]);
  return 0;
}

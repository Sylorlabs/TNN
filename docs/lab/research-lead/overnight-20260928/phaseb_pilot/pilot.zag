// c0integ_a.zag -- C0INTEG Phase A: OP-RECRUIT v2 + Q4 discovery integration substrate.
// Pure Zag. No Python anywhere.
//
// Per PREREG_C0INTEG_A.md (committed before this implementation).
// Phase A scope: integrated substrate = tree evaluator with one generic
// recruited-opcode dispatch + beam menu extension + learner consolidation
// (DETECT/PROPOSE/VALIDATE/RECRUIT/RETIRE) + F-LEAK information barrier.
// Phase B (three-phase discovery, I2/I4/I5) is a later worker.
//
// Tree DAG adapted from q4_impl/q4.zag (signature dedup for base nodes).
// Recruited bodies are TREES with placeholder terminals P0..P(a-1)
// (adaptation of v2's GENEXEC2 bodies to the Q4 tree substrate, per
// design 3.3). Exactly one generic dispatch for opcodes 32..63.
// Recruited-op nodes are never signature-deduped (always fresh), so kept
// trees genuinely contain the recruited opcode; scoring counts such a
// node as 1 operator node (design 3.2).
//
// Opcode literals 33..63 never appear in this file. The range base 32
// appears only in the generic dispatch computation (32+ri) and generic
// range checks (op>=32). See the A1 audit in the result document.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
fn get32(b:[]u8, off:i32)i32 {
  let a:i32=b[off] as i32;
  let bb:i32=b[off+1] as i32;
  let c:i32=b[off+2] as i32;
  let d:i32=b[off+3] as i32;
  let r1:i32=a | (bb<<8);
  let r2:i32=r1 | (c<<16);
  let r3:i32=r2 | (d<<24);
  return r3;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}
// st offsets: 0 node_count, 4 trace_count, 8 beam_n, 12 ev_n,
// 16 rng_state, 20 lib_n, 24 nterms,
// 28 recruit_events, 32 rec_exp_cnt, 36 fail_flag, 40 retire_events,
// 44 nrec, 48 spare, 52 spare, 56 spare, 60 spare
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }

// ============ PRNG (same LCG as q4) ============
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 16, ns);
  return ns;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return r % n;
}

// ============ sealed worlds (harness only; learner never calls) ============
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x5:i32=(x>>4)&1;
  let b0:i32=(x>>0)&1;
  let b1:i32=(x>>1)&1;
  let b2:i32=(x>>2)&1;
  let b3:i32=(x>>3)&1;
  let b4:i32=(x>>4)&1;
  let b5:i32=(x>>5)&1;
  if(fam==0){
    let r:i32=x1 & x2;
    return r;
  }
  if(fam==1){
    let r:i32=x1 ^ x2;
    return r;
  }
  if(fam==2){
    let a:i32=x1 & x2;
    let r:i32=a | x5;
    return r;
  }
  if(fam==10){
    let a:i32=b0 & b1;
    let b:i32=b0 & b2;
    let r:i32=a | b;
    return r;
  }
  if(fam==11){
    let a:i32=b3 & b4;
    let b:i32=b3 & b5;
    let r:i32=a | b;
    return r;
  }
  if(fam==12){
    let a:i32=b1 & b3;
    let b:i32=b1 & b5;
    let r:i32=a | b;
    return r;
  }
  if(fam==13){
    let a:i32=b2 & b4;
    let b:i32=b2 & b5;
    let o:i32=a | b;
    let r:i32=o ^ b0;
    return r;
  }
  if(fam==14){
    let a1:i32=b0 & b1;
    let b1v:i32=b0 & b2;
    let o1:i32=a1 | b1v;
    let a2:i32=b3 & b4;
    let b2v:i32=b3 & b5;
    let o2:i32=a2 | b2v;
    let r:i32=o1 & o2;
    return r;
  }
  // Pilot families G1-G5 (Phase B prime Stage 1)
  // G1: mixed AND/OR, disjoint bindings
  if(fam==20){
    let o:i32=b0 | b1;
    let a:i32=b2 & b3;
    let r:i32=o & a;
    return r;
  }
  if(fam==21){
    let o:i32=b4 | b5;
    let a:i32=b0 & b2;
    let r:i32=o & a;
    return r;
  }
  if(fam==22){
    let o:i32=b1 | b3;
    let a:i32=b4 & b5;
    let r:i32=o & a;
    return r;
  }
  // G2: NOT-mixed asymmetric
  if(fam==23){
    let nb:i32=1-b1;
    let a:i32=b0 & nb;
    let b:i32=b2 & b3;
    let r:i32=a | b;
    return r;
  }
  if(fam==24){
    let nb:i32=1-b5;
    let a:i32=b4 & nb;
    let b:i32=b0 & b2;
    let r:i32=a | b;
    return r;
  }
  if(fam==25){
    let nb:i32=1-b3;
    let a:i32=b1 & nb;
    let b:i32=b4 & b5;
    let r:i32=a | b;
    return r;
  }
  // G3: calibration (original Phase B families)
  if(fam==26){
    let a:i32=b0 & b1;
    let b:i32=b0 & b2;
    let r:i32=a | b;
    return r;
  }
  if(fam==27){
    let a:i32=b3 & b4;
    let b:i32=b3 & b5;
    let r:i32=a | b;
    return r;
  }
  if(fam==28){
    let a:i32=b1 & b3;
    let b:i32=b1 & b5;
    let r:i32=a | b;
    return r;
  }
  // G4: nested
  if(fam==29){
    let a:i32=b2 & b3;
    let o:i32=b1 | a;
    let r:i32=b0 & o;
    return r;
  }
  if(fam==30){
    let a:i32=b0 & b2;
    let o:i32=b5 | a;
    let r:i32=b4 & o;
    return r;
  }
  if(fam==31){
    let a:i32=b4 & b5;
    let o:i32=b3 | a;
    let r:i32=b1 & o;
    return r;
  }
  // G5: factored OR, disjoint bindings
  if(fam==32){
    let a:i32=b0 & b1;
    let b:i32=b2 & b3;
    let r:i32=a | b;
    return r;
  }
  if(fam==33){
    let a:i32=b4 & b5;
    let b:i32=b0 & b2;
    let r:i32=a | b;
    return r;
  }
  if(fam==34){
    let a:i32=b1 & b3;
    let b:i32=b4 & b5;
    let r:i32=a | b;
    return r;
  }
  return 0;
}

// ============ nodes (36 bytes) ============
// off 0=kind (0 term, 1 op), 4=arg (term idx / op id / opcode),
// 8=c0, 12=c1, 16=c2, 20=c3, 24=lo, 28=hi, 32=opc
fn ndg(nodes:[]u8, n:i32, off:i32)i32 { return get32(nodes, n*36+off); }
fn nds(nodes:[]u8, n:i32, off:i32, v:i32)void { set32(nodes, n*36+off, v); return; }
fn sig_hash(lo:i32, hi:i32)i32 {
  let h1:i32=hi * 33;
  let h2:i32=lo ^ h1;
  let h:i32=h2 & 16383;
  return h;
}
fn sig_lookup(sigtab:[]u8, nodes:[]u8, lo:i32, hi:i32)i32 {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){ return -1; }
    let n:i32=slot-1;
    let nlo:i32=ndg(nodes, n, 24);
    if(nlo==lo){
      let nhi:i32=ndg(nodes, n, 28);
      if(nhi==hi){ return n; }
    }
    i=i+1;
  }
  return -1;
}
fn sig_insert(sigtab:[]u8, lo:i32, hi:i32, n:i32)void {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){
      set32(sigtab, idx*4, n+1);
      return;
    }
    i=i+1;
  }
  return;
}
fn term_sig(t:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  if(t<6){
    let x:i32=0;
    while(x<64){
      let bit:i32=(x>>t)&1;
      if(bit==1){
        if(x<32){
          let m:i32=1<<x;
          lo=lo | m;
        } else {
          let m:i32=1<<(x-32);
          hi=hi | m;
        }
      }
      x=x+1;
    }
  } else {
    if(t==7){
      lo=-1;
      hi=-1;
    }
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn node_new_term(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32)i32 {
  let sob:[]u8=z_alloc(8);
  term_sig(t, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, -1);
  nds(nodes, nc, 20, -1);
  nds(nodes, nc, 24, lo);
  nds(nodes, nc, 28, hi);
  nds(nodes, nc, 32, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn sig_combine(op:i32, lo0:i32, hi0:i32, lo1:i32, hi1:i32, out:[]u8)void {
  if(op==0){ set32(out,0,lo0&lo1); set32(out,4,hi0&hi1); return; }
  if(op==1){ set32(out,0,lo0|lo1); set32(out,4,hi0|hi1); return; }
  if(op==2){ set32(out,0,lo0^-1); set32(out,4,hi0^-1); return; }
  set32(out,0,lo0^lo1); set32(out,4,hi0^hi1);
  return;
}
// trace (28 bytes): 0=op, 4=c0, 8=c1, 12=c2, 16=c3, 20=nc, 24=ev
fn trace_log(st:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32, c2:i32, c3:i32, nc:i32)void {
  let tc:i32=stg(st, 4);
  if(tc<4096){
    set32(trace, tc*28+0, op);
    set32(trace, tc*28+4, c0);
    set32(trace, tc*28+8, c1);
    set32(trace, tc*28+12, c2);
    set32(trace, tc*28+16, c3);
    set32(trace, tc*28+20, nc);
    set32(trace, tc*28+24, stg(st, 12));
    sts(st, 4, tc+1);
  }
  return;
}
fn node_new_op(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 24);
  let hi0:i32=ndg(nodes, c0, 28);
  let lo1:i32=0;
  let hi1:i32=0;
  if(op!=2){
    lo1=ndg(nodes, c1, 24);
    hi1=ndg(nodes, c1, 28);
  }
  let sob:[]u8=z_alloc(8);
  sig_combine(op, lo0, hi0, lo1, hi1, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  let oc:i32=1 + ndg(nodes, c0, 32);
  if(op!=2){ oc=oc + ndg(nodes, c1, 32); }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, -1);
  nds(nodes, nc, 20, -1);
  nds(nodes, nc, 24, lo);
  nds(nodes, nc, 28, hi);
  nds(nodes, nc, 32, oc);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  trace_log(st, trace, op, c0, c1, -1, -1, nc);
  return nc;
}
fn node_pred(nodes:[]u8, n:i32, x:i32)i32 {
  let slo:i32=ndg(nodes, n, 24);
  if(x<32){
    let p:i32=(slo>>x)&1;
    return p;
  }
  let shi:i32=ndg(nodes, n, 28);
  let p:i32=(shi>>(x-32))&1;
  return p;
}

// ============ recruited bodies (tree fragments, 16 bytes/node) ============
// Body node: 0=kind (0 placeholder, 1 base op), 4=arg (ph idx / op id),
// 8=c0, 12=c1. Body r lives at bodies + r*192 (12 nodes max).
// rctx (512 bytes): 0=rec_arity[32], 128=rec_len[32], 256=rec_idle[32],
// 384=rec_gain[32].
fn bdg(bodies:[]u8, r:i32, bn:i32, off:i32)i32 { return get32(bodies, r*192+bn*16+off); }
fn bds(bodies:[]u8, r:i32, bn:i32, off:i32, v:i32)void { set32(bodies, r*192+bn*16+off, v); return; }
// Signature-level body evaluation: placeholders bound to child sigs.
fn beval_sig(bodies:[]u8, r:i32, bn:i32, clo:[]u8, chi:[]u8, out:[]u8)void {
  let kind:i32=bdg(bodies, r, bn, 0);
  let arg:i32=bdg(bodies, r, bn, 4);
  if(kind==0){
    set32(out, 0, get32(clo, arg*4));
    set32(out, 4, get32(chi, arg*4));
    return;
  }
  let t0:[]u8=z_alloc(8);
  beval_sig(bodies, r, bdg(bodies, r, bn, 8), clo, chi, t0);
  if(arg==2){
    set32(out, 0, get32(t0, 0)^-1);
    set32(out, 4, get32(t0, 4)^-1);
    return;
  }
  let t1:[]u8=z_alloc(8);
  beval_sig(bodies, r, bdg(bodies, r, bn, 12), clo, chi, t1);
  sig_combine(arg, get32(t0,0), get32(t0,4), get32(t1,0), get32(t1,4), out);
  return;
}
// Concrete body evaluation (for VALIDATE INLINE): placeholders bound to vals.
fn beval_x(bodies:[]u8, r:i32, bn:i32, vals:[]u8)i32 {
  let kind:i32=bdg(bodies, r, bn, 0);
  let arg:i32=bdg(bodies, r, bn, 4);
  if(kind==0){ return get32(vals, arg*4); }
  let v0:i32=beval_x(bodies, r, bdg(bodies, r, bn, 8), vals);
  if(arg==2){ return 1-v0; }
  let v1:i32=beval_x(bodies, r, bdg(bodies, r, bn, 12), vals);
  if(arg==0){ return v0&v1; }
  if(arg==1){ return v0|v1; }
  return v0^v1;
}
// ============ THE ONE GENERIC DISPATCH ============
// The only place opcodes 32..63 are interpreted. No branch names a
// recruited meaning; meaning comes from bodies[] (learner state).
// node creation WITHOUT signature dedup (for rewrite: preserves recruited structure)
fn node_new_op_fresh(st:[]u8, nodes:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 24);
  let hi0:i32=ndg(nodes, c0, 28);
  let lo1:i32=0;
  let hi1:i32=0;
  if(op!=2){
    lo1=ndg(nodes, c1, 24);
    hi1=ndg(nodes, c1, 28);
  }
  let sob:[]u8=z_alloc(8);
  sig_combine(op, lo0, hi0, lo1, hi1, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  let oc:i32=1 + ndg(nodes, c0, 32);
  if(op!=2){ oc=oc + ndg(nodes, c1, 32); }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, -1);
  nds(nodes, nc, 20, -1);
  nds(nodes, nc, 24, lo);
  nds(nodes, nc, 28, hi);
  nds(nodes, nc, 32, oc);
  sts(st, 0, nc+1);
  trace_log(st, trace, op, c0, c1, -1, -1, nc);
  return nc;
}
fn node_new_rec(st:[]u8, nodes:[]u8, trace:[]u8, bodies:[]u8, ri:i32, arity:i32, ch:[]u8)i32 {
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  let opcode:i32=32+ri;
  let clo:[]u8=z_alloc(16);
  let chi:[]u8=z_alloc(16);
  let k:i32=0;
  while(k<4){
    if(k<arity){
      let cn:i32=get32(ch, k*4);
      set32(clo, k*4, ndg(nodes, cn, 24));
      set32(chi, k*4, ndg(nodes, cn, 28));
    } else {
      set32(clo, k*4, 0);
      set32(chi, k*4, 0);
    }
    k=k+1;
  }
  let sob:[]u8=z_alloc(8);
  beval_sig(bodies, ri, 0, clo, chi, sob);
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, opcode);
  nds(nodes, nc, 8, get32(ch, 0));
  nds(nodes, nc, 12, get32(ch, 4));
  nds(nodes, nc, 16, get32(ch, 8));
  nds(nodes, nc, 20, get32(ch, 12));
  nds(nodes, nc, 24, get32(sob, 0));
  nds(nodes, nc, 28, get32(sob, 4));
  nds(nodes, nc, 32, 1);
  // Deliberately no sig_lookup: recruited nodes are always fresh, so
  // kept trees genuinely contain the recruited opcode (C0-B B1).
  trace_log(st, trace, opcode, get32(ch,0), get32(ch,4), get32(ch,8), get32(ch,12), nc);
  sts(st, 0, nc+1);
  return nc;
}

// ============ beam (16 bytes/slot) ============
fn bmg(beam:[]u8, i:i32, off:i32)i32 { return get32(beam, i*16+off); }
fn bms(beam:[]u8, i:i32, off:i32, v:i32)void { set32(beam, i*16+off, v); return; }
fn score_node(st:[]u8, nodes:[]u8, n:i32, ev_x:[]u8, ev_y:[]u8, out:[]u8)void {
  let en:i32=stg(st, 12);
  let opc:i32=ndg(nodes, n, 32);
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let p:i32=node_pred(nodes, n, x);
    if(p==y){ c=c+1; }
    e=e+1;
  }
  let sc:i32=0;
  if(en>0){
    let a1:i32=(c*10000)/en;
    let a2:i32=200*opc;
    sc=a1 - a2;
  }
  set32(out, 0, sc);
  set32(out, 4, c);
  set32(out, 8, opc);
  return;
}
// Extend beam by one generation. Includes the recruited-expansion class:
// for each recruited opcode, form nodes from beam candidates (arity 1:
// whole beam; arity >= 2: top 8 by score, bounding combinatorics).
// With nrec=0 this is bit-identical to the base beam.
fn beam_extend(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, bodies:[]u8, rctx:[]u8)void {
  let bn:i32=stg(st, 8);
  let si:i32=0;
  while(si<8192){ seen[si]=0; si=si+1; }
  let tn:i32=0;
  let i:i32=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    if(seen[n]==0){
      seen[n]=1;
      set32(tmp, tn*4, n);
      tn=tn+1;
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let n2:i32=node_new_op(st, nodes, sigtab, trace, 2, n, -1);
    if(n2>=0){
      if(seen[n2]==0){
        seen[n2]=1;
        set32(tmp, tn*4, n2);
        tn=tn+1;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let j:i32=0;
    while(j<bn){
      let m:i32=bmg(beam, j, 0);
      let op:i32=0;
      while(op<4){
        if(op!=2){
          let n2:i32=node_new_op(st, nodes, sigtab, trace, op, n, m);
          if(n2>=0){
            if(seen[n2]==0){
              seen[n2]=1;
              set32(tmp, tn*4, n2);
              tn=tn+1;
            }
          }
        }
        op=op+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  // recruited-expansion class (menu growth)
  let nrec:i32=stg(st, 44);
  let recexp:i32=0;
  let ri:i32=0;
  while(ri<nrec){
    let ar:i32=get32(rctx, ri*4);
    let lim:i32=bn;
    if(ar>=2){
      lim=8;
      if(bn<lim){ lim=bn; }
    }
    let total:i32=1;
    let qq:i32=0;
    while(qq<ar){ total=total*lim; qq=qq+1; }
    let tt:i32=0;
    while(tt<total){
      let idx0:i32=tt%lim;
      let idx1:i32=(tt/lim)%lim;
      let idx2:i32=(tt/(lim*lim))%lim;
      let idx3:i32=(tt/(lim*lim*lim))%lim;
      let ch:[]u8=z_alloc(16);
      set32(ch, 0, bmg(beam, idx0, 0));
      set32(ch, 4, -1);
      set32(ch, 8, -1);
      set32(ch, 12, -1);
      if(ar>=2){ set32(ch, 4, bmg(beam, idx1, 0)); }
      if(ar>=3){ set32(ch, 8, bmg(beam, idx2, 0)); }
      if(ar>=4){ set32(ch, 12, bmg(beam, idx3, 0)); }
      let nn:i32=node_new_rec(st, nodes, trace, bodies, ri, ar, ch);
      if(nn>=0){
        if(tn<8192){
          if(seen[nn]==0){
            seen[nn]=1;
            set32(tmp, tn*4, nn);
            tn=tn+1;
            recexp=recexp+1;
          }
        }
      }
      tt=tt+1;
    }
    ri=ri+1;
  }
  sts(st, 32, recexp);
  // score all tmp candidates
  let sout:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<tn){
    let n:i32=get32(tmp, k*4);
    score_node(st, nodes, n, ev_x, ev_y, sout);
    set32(tsc, k*12+0, get32(sout, 0));
    set32(tsc, k*12+4, get32(sout, 4));
    set32(tsc, k*12+8, get32(sout, 8));
    k=k+1;
  }
  // M3 instrumentation: accumulate candidate-evaluation count at st+48.
  // Harness-side only; does not affect scoring or selection.
  sts(st, 48, stg(st, 48) + tn);
  // select top 32 by (score desc, opc asc, node asc)
  let nb:i32=0;
  let picked:[]u8=z_alloc(8192);
  let pi:i32=0;
  while(pi<tn){ picked[pi]=0; pi=pi+1; }
  let r:i32=0;
  while(r<32){
    let bestk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bestk<0){ bestk=k; }
        else {
          let sk:i32=get32(tsc, k*12+0);
          let sb:i32=get32(tsc, bestk*12+0);
          let take:i32=0;
          if(sk>sb){ take=1; }
          else {
            if(sk==sb){
              let ok:i32=get32(tsc, k*12+8);
              let ob:i32=get32(tsc, bestk*12+8);
              if(ok<ob){ take=1; }
              else {
                if(ok==ob){
                  let nk:i32=get32(tmp, k*4);
                  let nbb:i32=get32(tmp, bestk*4);
                  if(nk<nbb){ take=1; }
                }
              }
            }
          }
          if(take==1){ bestk=k; }
        }
      }
      k=k+1;
    }
    if(bestk<0){ break; }
    picked[bestk]=1;
    let bn2:i32=get32(tmp, bestk*4);
    bms(beam, nb, 0, bn2);
    bms(beam, nb, 4, get32(tsc, bestk*12+0));
    bms(beam, nb, 8, get32(tsc, bestk*12+4));
    bms(beam, nb, 12, get32(tsc, bestk*12+8));
    nb=nb+1;
    r=r+1;
    if(nb>=tn){ break; }
  }
  sts(st, 8, nb);
  return;
}

// ============ evidence (same as q4) ============
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    used[x]=1;
    i=i+1;
  }
  sts(st, 12, 8);
  return;
}
fn abs_i(v:i32)i32 {
  if(v<0){ return -v; }
  return v;
}
fn select_iv(st:[]u8, nodes:[]u8, beam:[]u8, used:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let topk:i32=8;
  if(bn<8){ topk=bn; }
  let best_x:i32=-1;
  let best_d:i32=-1;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){
      let c1:i32=0;
      let k:i32=0;
      while(k<topk){
        let n:i32=bmg(beam, k, 0);
        let p:i32=node_pred(nodes, n, x);
        if(p==1){ c1=c1+1; }
        k=k+1;
      }
      let av:i32=abs_i(2*c1 - 8);
      let d:i32=8 - av;
      if(d>best_d){
        best_d=d;
        best_x=x;
      }
    }
    x=x+1;
  }
  return best_x;
}
fn do_iv(st:[]u8, fam:i32, x:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let y:i32=sealed(fam, x);
  let en:i32=stg(st, 12);
  set32(ev_x, en*4, x);
  set32(ev_y, en*4, y);
  used[x]=1;
  sts(st, 12, en+1);
  return;
}
fn true_correct(fam:i32, nodes:[]u8, n:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    let p:i32=node_pred(nodes, n, x);
    let y:i32=sealed(fam, x);
    if(p==y){ c=c+1; }
    x=x+1;
  }
  return c;
}
fn bobs_ev_correct(st:[]u8, ev_x:[]u8, ev_y:[]u8)i32 {
  let en:i32=stg(st, 12);
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=(x>>i)&1;
      if(p==y){ c=c+1; }
      e=e+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}
fn clear_sigtab(sigtab:[]u8)void {
  let i:i32=0;
  while(i<16384){ set32(sigtab, i*4, 0); i=i+1; }
  return;
}
fn clear_used(used:[]u8)void {
  let i:i32=0;
  while(i<64){ used[i]=0; i=i+1; }
  return;
}
// ============ Phase 1 discovery (same as q4, grown-menu capable) ============
// Returns kept node idx, or -1. Reports via emit.
fn phase1(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, bodies:[]u8, rctx:[]u8, fam:i32, nterms:i32, tag:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  let t:i32=0;
  while(t<nterms){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, nterms);
  passive(st, fam, ev_x, ev_y, used);
  let r:i32=0;
  while(r<24){
    beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bodies, rctx);
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    r=r+1;
  }
  beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bodies, rctx);
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let obs_c:i32=bobs_ev_correct(st, ev_x, ev_y);
  let keep:i32=1;
  let lhs:i32=best_c*100;
  let rhs:i32=obs_c*100 + 15*en;
  if(lhs<rhs){ keep=0; }
  if(best_o>7){ keep=0; }
  let j:i32=1;
  while(j<bn){
    let cj:i32=bmg(beam, j, 8);
    let oj:i32=bmg(beam, j, 12);
    let jl:i32=cj*100;
    let jr:i32=best_c*100 - 2*en;
    if(jl>=jr){
      if(oj<best_o){ keep=0; }
    }
    j=j+1;
  }
  emit(tag); emit(" BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" obs_correct="); e64(obs_c);
  emit(" opc="); e64(best_o);
  emit(" keep="); e64(keep); emit("\n");
  emit(tag); emit(" TRUE correct="); e64(true_correct(fam, nodes, best_n)); emit("/64\n");
  emit(tag); emit(" trace_events="); e64(stg(st, 4)); emit(" nodes="); e64(stg(st, 0)); emit("\n");
  if(keep==1){ return best_n; }
  return -1;
}
// ============ Phase 1 measured (for M2 interventions-to-criterion) ============
// Identical to phase1, plus harness-side measurement: after each of the 25
// beam_extend calls, computes true_correct(fam, nodes, beam_top) and stores
// in mlog[0..24]. The learner never sees these values. Returns kept node idx or -1.
fn phase1_m(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, bodies:[]u8, rctx:[]u8, fam:i32, nterms:i32, tag:[]u8, mlog:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  let t:i32=0;
  while(t<nterms){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, nterms);
  passive(st, fam, ev_x, ev_y, used);
  let mi:i32=0;
  let r:i32=0;
  while(r<24){
    beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bodies, rctx);
    let btn:i32=bmg(beam, 0, 0);
    set32(mlog, mi*4, true_correct(fam, nodes, btn));
    mi=mi+1;
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    r=r+1;
  }
  beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bodies, rctx);
  let btn2:i32=bmg(beam, 0, 0);
  set32(mlog, mi*4, true_correct(fam, nodes, btn2));
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let obs_c:i32=bobs_ev_correct(st, ev_x, ev_y);
  let keep:i32=1;
  let lhs:i32=best_c*100;
  let rhs:i32=obs_c*100 + 15*en;
  if(lhs<rhs){ keep=0; }
  if(best_o>7){ keep=0; }
  let j:i32=1;
  while(j<bn){
    let cj:i32=bmg(beam, j, 8);
    let oj:i32=bmg(beam, j, 12);
    let jl:i32=cj*100;
    let jr:i32=best_c*100 - 2*en;
    if(jl>=jr){
      if(oj<best_o){ keep=0; }
    }
    j=j+1;
  }
  emit(tag); emit(" BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" obs_correct="); e64(obs_c);
  emit(" opc="); e64(best_o);
  emit(" keep="); e64(keep); emit("\n");
  emit(tag); emit(" TRUE correct="); e64(true_correct(fam, nodes, best_n)); emit("/64\n");
  emit(tag); emit(" trace_events="); e64(stg(st, 4)); emit(" nodes="); e64(stg(st, 0)); emit("\n");
  if(keep==1){ return best_n; }
  return -1;
}
// ============ kept-variable store ============
// kctx: 0=kept_n, 4=kept_root[16], 68=kept_valn[16], 132=kept_valx[16][16]
fn kept_add(kctx:[]u8, root:i32, vx:[]u8, vn:i32)void {
  let kn:i32=get32(kctx, 0);
  if(kn<16){
    set32(kctx, 4+kn*4, root);
    set32(kctx, 68+kn*4, vn);
    let j:i32=0;
    while(j<vn){
      set32(kctx, 132+kn*64+j*4, get32(vx, j*4));
      j=j+1;
    }
    set32(kctx, 0, kn+1);
  }
  return;
}
fn kept_clear(kctx:[]u8)void {
  set32(kctx, 0, 0);
  return;
}
fn snap_kept(nodes:[]u8, kctx:[]u8, snap:[]u8)void {
  let kn:i32=get32(kctx, 0);
  let ki:i32=0;
  while(ki<kn){
    let root:i32=get32(kctx, 4+ki*4);
    let vn:i32=get32(kctx, 68+ki*4);
    let j:i32=0;
    while(j<vn){
      let x:i32=get32(kctx, 132+ki*64+j*4);
      set32(snap, ki*64+j*4, node_pred(nodes, root, x));
      j=j+1;
    }
    ki=ki+1;
  }
  return;
}
fn check_kept(nodes:[]u8, kctx:[]u8, snap:[]u8)i32 {
  let kn:i32=get32(kctx, 0);
  let bad:i32=0;
  let ki:i32=0;
  while(ki<kn){
    let root:i32=get32(kctx, 4+ki*4);
    let vn:i32=get32(kctx, 68+ki*4);
    let j:i32=0;
    while(j<vn){
      let x:i32=get32(kctx, 132+ki*64+j*4);
      let now:i32=node_pred(nodes, root, x);
      if(now!=get32(snap, ki*64+j*4)){ bad=1; }
      j=j+1;
    }
    ki=ki+1;
  }
  return bad;
}

// ============ DETECT: subtree fragment enumeration ============
// Canonical serialization: pre-order tokens; terminal -> [0, ph],
// base op -> [1, op]; terminals renamed to P0.. in first-appearance
// order. Fragments with a recruited-op node anywhere are skipped
// (Phase A restriction, disclosed). 2..6 operator nodes.
fn frag_ser(nodes:[]u8, n:i32, ser:[]u8, pos:i32, tm_idx:[]u8, tm_ph:[]u8, tn:[]u8, ops:[]u8)i32 {
  let kind:i32=ndg(nodes, n, 0);
  if(kind==0){
    let c:i32=get32(tn, 0);
    let ph:i32=-1;
    let i:i32=0;
    while(i<c){
      if(get32(tm_idx, i*4)==n){ ph=get32(tm_ph, i*4); }
      i=i+1;
    }
    if(ph<0){
      if(c>=8){ return -1; }
      ph=c;
      set32(tm_idx, c*4, n);
      set32(tm_ph, c*4, c);
      set32(tn, 0, c+1);
    }
    ser[pos]=0;
    ser[pos+1]=ph as u8;
    return pos+2;
  }
  let op:i32=ndg(nodes, n, 4);
  if(op>=32){ return -1; }
  let oc:i32=get32(ops, 0)+1;
  if(oc>6){ return -1; }
  set32(ops, 0, oc);
  ser[pos]=1;
  ser[pos+1]=op as u8;
  let p:i32=pos+2;
  p=frag_ser(nodes, ndg(nodes, n, 8), ser, p, tm_idx, tm_ph, tn, ops);
  if(p<0){ return -1; }
  if(op!=2){
    p=frag_ser(nodes, ndg(nodes, n, 12), ser, p, tm_idx, tm_ph, tn, ops);
    if(p<0){ return -1; }
  }
  return p;
}
fn collect_subtree(nodes:[]u8, n:i32, seen:[]u8, list:[]u8, ln:[]u8)void {
  if(n<0){ return; }
  if(seen[n]!=0){ return; }
  seen[n]=1;
  let c:i32=get32(ln, 0);
  if(c<512){
    set32(list, c*4, n);
    set32(ln, 0, c+1);
  }
  if(ndg(nodes, n, 0)==1){
    collect_subtree(nodes, ndg(nodes, n, 8), seen, list, ln);
    collect_subtree(nodes, ndg(nodes, n, 12), seen, list, ln);
    collect_subtree(nodes, ndg(nodes, n, 16), seen, list, ln);
    collect_subtree(nodes, ndg(nodes, n, 20), seen, list, ln);
  }
  return;
}
// shape record (80 bytes): 0=len, 4=freq, 8=gain, 12=first_kept,
// 16=first_node, 20=arity, 24=ops, 28=shape bytes (32),
// 60=first_tmap[4] (placeholder -> terminal node)
fn shape_find(shapes:[]u8, nsh:i32, ser:[]u8, len:i32)i32 {
  let i:i32=0;
  while(i<nsh){
    if(get32(shapes, i*80+0)==len){
      let eq:i32=1;
      let j:i32=0;
      while(j<len){
        if(shapes[i*80+28+j]!=ser[j]){ eq=0; }
        j=j+1;
      }
      if(eq==1){ return i; }
    }
    i=i+1;
  }
  return -1;
}
fn shape_add(shapes:[]u8, nsh:i32, ser:[]u8, len:i32, arity:i32, ops:i32, kept:i32, node:i32, tm_idx:[]u8, tm_ph:[]u8, tnc:i32)i32 {
  set32(shapes, nsh*80+0, len);
  set32(shapes, nsh*80+4, 0);
  set32(shapes, nsh*80+8, 0);
  set32(shapes, nsh*80+12, kept);
  set32(shapes, nsh*80+16, node);
  set32(shapes, nsh*80+20, arity);
  set32(shapes, nsh*80+24, ops);
  let k:i32=0;
  while(k<4){ set32(shapes, nsh*80+60+k*4, -1); k=k+1; }
  let q:i32=0;
  while(q<tnc){
    let ph:i32=get32(tm_ph, q*4);
    if(ph<4){ set32(shapes, nsh*80+60+ph*4, get32(tm_idx, q*4)); }
    q=q+1;
  }
  let j:i32=0;
  while(j<len){ shapes[nsh*80+28+j]=ser[j]; j=j+1; }
  return nsh;
}
fn detect_collect(nodes:[]u8, kctx:[]u8, shapes:[]u8, nsh_out:[]u8)void {
  let nsh:i32=0;
  let kn:i32=get32(kctx, 0);
  let ki:i32=0;
  while(ki<kn){
    let seen:[]u8=z_alloc(8192);
    let list:[]u8=z_alloc(2048);
    let ln:[]u8=z_alloc(4);
    set32(ln, 0, 0);
    collect_subtree(nodes, get32(kctx, 4+ki*4), seen, list, ln);
    let local:[]u8=z_alloc(1024);
    let lnn:i32=0;
    let li:i32=0;
    let total:i32=get32(ln, 0);
    while(li<total){
      let n:i32=get32(list, li*4);
      let ser:[]u8=z_alloc(32);
      let tm_idx:[]u8=z_alloc(32);
      let tm_ph:[]u8=z_alloc(32);
      let tn:[]u8=z_alloc(4);
      let ops:[]u8=z_alloc(4);
      set32(tn, 0, 0);
      set32(ops, 0, 0);
      let end:i32=frag_ser(nodes, n, ser, 0, tm_idx, tm_ph, tn, ops);
      if(end>=0){
        let oc:i32=get32(ops, 0);
        if(oc>=2){
          let ar:i32=get32(tn, 0);
          let gi:i32=shape_find(shapes, nsh, ser, end);
          if(gi<0){
            gi=nsh;
            shape_add(shapes, nsh, ser, end, ar, oc, ki, n, tm_idx, tm_ph, ar);
            nsh=nsh+1;
          }
          let seen_l:i32=0;
          let q2:i32=0;
          while(q2<lnn){
            if(get32(local, q2*4)==gi){ seen_l=1; }
            q2=q2+1;
          }
          if(seen_l==0){
            set32(local, lnn*4, gi);
            lnn=lnn+1;
            let f:i32=get32(shapes, gi*80+4);
            set32(shapes, gi*80+4, f+1);
          }
        }
      }
      li=li+1;
    }
    ki=ki+1;
  }
  set32(nsh_out, 0, nsh);
  return;
}
// Winner: freq >= K_FREQ=3, 1 <= arity <= 4, gain = (ops-1)*freq-3 > 0.
// Rank: gain desc, ops desc, first_kept asc, first_node asc.
fn detect_winner(shapes:[]u8, nsh:i32)i32 {
  let best:i32=-1;
  let i:i32=0;
  while(i<nsh){
    let freq:i32=get32(shapes, i*80+4);
    let ops:i32=get32(shapes, i*80+24);
    let ar:i32=get32(shapes, i*80+20);
    if(freq>=3){
      if(ar>=1){
        if(ar<=4){
          let gain:i32=(ops-1)*freq-3;
          if(gain>0){
            set32(shapes, i*80+8, gain);
            if(best<0){ best=i; }
            else {
              let bg:i32=get32(shapes, best*80+8);
              let take:i32=0;
              if(gain>bg){ take=1; }
              else {
                if(gain==bg){
                  let bo:i32=get32(shapes, best*80+24);
                  if(ops>bo){ take=1; }
                  else {
                    if(ops==bo){
                      let bf:i32=get32(shapes, best*80+12);
                      let cf:i32=get32(shapes, i*80+12);
                      if(cf<bf){ take=1; }
                      else {
                        if(cf==bf){
                          let bnn:i32=get32(shapes, best*80+16);
                          let cn:i32=get32(shapes, i*80+16);
                          if(cn<bnn){ take=1; }
                        }
                      }
                    }
                  }
                }
              }
              if(take==1){ best=i; }
            }
          }
        }
      }
    }
    i=i+1;
  }
  return best;
}
// ============ body install from winning shape ============
fn parse_body(shapes:[]u8, gi:i32, spos:[]u8, bodies:[]u8, r:i32, bn_out:[]u8)i32 {
  let pos:i32=get32(spos, 0);
  let bn:i32=get32(bn_out, 0);
  let tag:i32=shapes[gi*80+28+pos] as i32;
  let arg:i32=shapes[gi*80+28+pos+1] as i32;
  if(tag==0){
    bds(bodies, r, bn, 0, 0);
    bds(bodies, r, bn, 4, arg);
    bds(bodies, r, bn, 8, -1);
    bds(bodies, r, bn, 12, -1);
    set32(spos, 0, pos+2);
    set32(bn_out, 0, bn+1);
    return bn;
  }
  bds(bodies, r, bn, 0, 1);
  bds(bodies, r, bn, 4, arg);
  set32(spos, 0, pos+2);
  set32(bn_out, 0, bn+1);
  let c0:i32=parse_body(shapes, gi, spos, bodies, r, bn_out);
  bds(bodies, r, bn, 8, c0);
  if(arg!=2){
    let c1:i32=parse_body(shapes, gi, spos, bodies, r, bn_out);
    bds(bodies, r, bn, 12, c1);
  } else {
    bds(bodies, r, bn, 12, -1);
  }
  return bn;
}
// ============ pattern matching + rewrite ============
// Placeholders bind to terminal nodes only (Phase A restriction, disclosed).
fn match_pat(nodes:[]u8, n:i32, bodies:[]u8, r:i32, bn:i32, tmap:[]u8)i32 {
  let bkind:i32=bdg(bodies, r, bn, 0);
  let barg:i32=bdg(bodies, r, bn, 4);
  if(bkind==0){
    if(ndg(nodes, n, 0)!=0){ return 0; }
    if(barg>=4){ return 0; }
    let cur:i32=get32(tmap, barg*4);
    if(cur<0){ set32(tmap, barg*4, n); return 1; }
    if(cur==n){ return 1; }
    return 0;
  }
  if(ndg(nodes, n, 0)!=1){ return 0; }
  if(ndg(nodes, n, 4)!=barg){ return 0; }
  if(match_pat(nodes, ndg(nodes, n, 8), bodies, r, bdg(bodies, r, bn, 8), tmap)==0){ return 0; }
  if(barg!=2){
    if(match_pat(nodes, ndg(nodes, n, 12), bodies, r, bdg(bodies, r, bn, 12), tmap)==0){ return 0; }
  }
  return 1;
}
fn rewrite_node(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, r:i32, arity:i32, n:i32)i32 {
  let tmap:[]u8=z_alloc(16);
  let k:i32=0;
  while(k<4){ set32(tmap, k*4, -1); k=k+1; }
  let mres:i32=match_pat(nodes, n, bodies, r, 0, tmap);
  if(mres==1){
    let ch:[]u8=z_alloc(16);
    let k2:i32=0;
    while(k2<4){
      if(k2<arity){ set32(ch, k2*4, get32(tmap, k2*4)); }
      else { set32(ch, k2*4, -1); }
      k2=k2+1;
    }
    return node_new_rec(st, nodes, trace, bodies, r, arity, ch);
  }
  if(ndg(nodes, n, 0)==0){ return n; }
  let op:i32=ndg(nodes, n, 4);
  if(op>=32){ return n; }
  let c0:i32=ndg(nodes, n, 8);
  let c1:i32=ndg(nodes, n, 12);
  let r0:i32=rewrite_node(st, nodes, sigtab, trace, bodies, r, arity, c0);
  let r1:i32=c1;
  if(op!=2){ r1=rewrite_node(st, nodes, sigtab, trace, bodies, r, arity, c1); }
  if(r0==c0){
    if(r1==c1){ return n; }
  }
  return node_new_op_fresh(st, nodes, trace, op, r0, r1);
}

// ============ VALIDATE: INLINE vs WRAPPED on observed samples only ============
// N_VAL=16 tuples drawn deterministically from the experience buffer
// (learner-observed x values). The sealed function is never queried
// here (F-LEAK barrier).
fn validate_fn(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, r:i32, arity:i32, shapes:[]u8, wi:i32, obs:[]u8)i32 {
  let ch:[]u8=z_alloc(16);
  let k:i32=0;
  while(k<4){
    if(k<arity){ set32(ch, k*4, get32(shapes, wi*80+60+k*4)); }
    else { set32(ch, k*4, -1); }
    k=k+1;
  }
  let wn:i32=node_new_rec(st, nodes, trace, bodies, r, arity, ch);
  if(wn<0){ return 0; }
  let on:i32=get32(obs, 0);
  if(on<1){ return 0; }
  let vals:[]u8=z_alloc(16);
  let i:i32=0;
  while(i<16){
    let x:i32=get32(obs, 4+((i%on)*4));
    let k2:i32=0;
    while(k2<arity){
      let tn2:i32=get32(ch, k2*4);
      let ti:i32=ndg(nodes, tn2, 4);
      let b:i32=0;
      if(ti<6){ b=(x>>ti)&1; }
      else { if(ti==7){ b=1; } }
      set32(vals, k2*4, b);
      k2=k2+1;
    }
    let inl:i32=beval_x(bodies, r, 0, vals);
    let wr:i32=node_pred(nodes, wn, x);
    if(inl!=wr){ return 0; }
    i=i+1;
  }
  return 1;
}
// ============ reference counting (for RETIRE) ============
fn count_refs_sub(nodes:[]u8, n:i32, seen:[]u8, opcode:i32)i32 {
  if(n<0){ return 0; }
  if(seen[n]!=0){ return 0; }
  seen[n]=1;
  let c:i32=0;
  if(ndg(nodes, n, 0)==1){
    if(ndg(nodes, n, 4)==opcode){ c=1; }
    c=c+count_refs_sub(nodes, ndg(nodes, n, 8), seen, opcode);
    c=c+count_refs_sub(nodes, ndg(nodes, n, 12), seen, opcode);
    c=c+count_refs_sub(nodes, ndg(nodes, n, 16), seen, opcode);
    c=c+count_refs_sub(nodes, ndg(nodes, n, 20), seen, opcode);
  }
  return c;
}
fn count_refs(nodes:[]u8, kctx:[]u8, opcode:i32)i32 {
  let c:i32=0;
  let kn:i32=get32(kctx, 0);
  let ki:i32=0;
  while(ki<kn){
    let seen:[]u8=z_alloc(8192);
    c=c+count_refs_sub(nodes, get32(kctx, 4+ki*4), seen, opcode);
    ki=ki+1;
  }
  return c;
}
fn renumber_sub(nodes:[]u8, n:i32, seen:[]u8, old_op:i32, new_op:i32)void {
  if(n<0){ return; }
  if(seen[n]!=0){ return; }
  seen[n]=1;
  if(ndg(nodes, n, 0)==1){
    if(ndg(nodes, n, 4)==old_op){ nds(nodes, n, 4, new_op); }
    renumber_sub(nodes, ndg(nodes, n, 8), seen, old_op, new_op);
    renumber_sub(nodes, ndg(nodes, n, 12), seen, old_op, new_op);
    renumber_sub(nodes, ndg(nodes, n, 16), seen, old_op, new_op);
    renumber_sub(nodes, ndg(nodes, n, 20), seen, old_op, new_op);
  }
  return;
}
fn renumber_refs(nodes:[]u8, kctx:[]u8, old_op:i32, new_op:i32)void {
  let kn:i32=get32(kctx, 0);
  let ki:i32=0;
  while(ki<kn){
    let seen:[]u8=z_alloc(8192);
    renumber_sub(nodes, get32(kctx, 4+ki*4), seen, old_op, new_op);
    ki=ki+1;
  }
  return;
}
// ============ RETIRE: usage-decay removal ============
// Idle only grows while the opcode is unreferenced, so at retire time
// refs==0 (re-expansion vacuous); remaining slots compact down and
// their references are renumbered.
fn retire_scan(st:[]u8, nodes:[]u8, bodies:[]u8, kctx:[]u8, rctx:[]u8)void {
  let nrec:i32=stg(st, 44);
  let r:i32=0;
  while(r<nrec){
    let refs:i32=count_refs(nodes, kctx, 32+r);
    let retired:i32=0;
    if(refs>0){
      set32(rctx, 256+r*4, 0);
    } else {
      let id:i32=get32(rctx, 256+r*4)+1;
      set32(rctx, 256+r*4, id);
      if(id>=3){
        let k:i32=r;
        while(k<nrec-1){
          set32(rctx, k*4, get32(rctx, (k+1)*4));
          set32(rctx, 128+k*4, get32(rctx, 128+(k+1)*4));
          set32(rctx, 256+k*4, get32(rctx, 256+(k+1)*4));
          set32(rctx, 384+k*4, get32(rctx, 384+(k+1)*4));
          let b:i32=0;
          while(b<192){
            set32(bodies, k*192+b, get32(bodies, (k+1)*192+b));
            b=b+4;
          }
          renumber_refs(nodes, kctx, 32+k+1, 32+k);
          k=k+1;
        }
        nrec=nrec-1;
        sts(st, 44, nrec);
        let evc:i32=stg(st, 40);
        sts(st, 40, evc+1);
        emit("RETIRED op="); e64(32+r); emit("\n");
        retired=1;
      }
    }
    if(retired==0){ r=r+1; }
  }
  return;
}
// ============ the learner's consolidation routine ============
// The driver calls consolidate(); only consolidate() calls the recruit
// path (F-DRIVER). One recruitment per call (v2 semantics).
fn consolidate(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, rctx:[]u8, kctx:[]u8, obs:[]u8)void {
  let shapes:[]u8=z_alloc(20480);
  let nsh_out:[]u8=z_alloc(4);
  detect_collect(nodes, kctx, shapes, nsh_out);
  let nsh:i32=get32(nsh_out, 0);
  let wi:i32=detect_winner(shapes, nsh);
  emit("CONSOLIDATE nshapes="); e64(nsh); emit(" winner="); e64(wi); emit("\n");
  let nrec:i32=stg(st, 44);
  if(wi>=0){
    if(nrec<32){
      let arity:i32=get32(shapes, wi*80+20);
      let spos:[]u8=z_alloc(4);
      let bn_out:[]u8=z_alloc(4);
      set32(spos, 0, 0);
      set32(bn_out, 0, 0);
      parse_body(shapes, wi, spos, bodies, nrec, bn_out);
      let blen:i32=get32(bn_out, 0);
      set32(rctx, nrec*4, arity);
      set32(rctx, 128+nrec*4, blen);
      let ok:i32=validate_fn(st, nodes, sigtab, trace, bodies, nrec, arity, shapes, wi, obs);
      if(ok==1){
        let gain:i32=get32(shapes, wi*80+8);
        let freq:i32=get32(shapes, wi*80+4);
        set32(rctx, 256+nrec*4, 0);
        set32(rctx, 384+nrec*4, gain);
        let snap:[]u8=z_alloc(1024);
        snap_kept(nodes, kctx, snap);
        let kn:i32=get32(kctx, 0);
        let ki:i32=0;
        while(ki<kn){
          let root:i32=get32(kctx, 4+ki*4);
          let nr:i32=rewrite_node(st, nodes, sigtab, trace, bodies, nrec, arity, root);
          set32(kctx, 4+ki*4, nr);
          ki=ki+1;
        }
        let bad:i32=check_kept(nodes, kctx, snap);
        if(bad==1){
          emit("F-BREAK FIRES\n");
          sts(st, 36, 1);
        }
        sts(st, 44, nrec+1);
        let evc:i32=stg(st, 28);
        sts(st, 28, evc+1);
        emit("RECRUITED op="); e64(32+nrec);
        emit(" arity="); e64(arity);
        emit(" len="); e64(blen);
        emit(" gain="); e64(gain);
        emit(" freq="); e64(freq); emit("\n");
      } else {
        emit("STAGE_INVALID\n");
      }
    }
  }
  retire_scan(st, nodes, bodies, kctx, rctx);
  return;
}

// ============ tests (driver; never recruits directly) ============
fn fill_vx16(vx:[]u8)void {
  let j:i32=0;
  while(j<16){ set32(vx, j*4, j); j=j+1; }
  return;
}
fn test_rv1(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, rctx:[]u8, kctx:[]u8, obs:[]u8)void {
  emit("TEST T-RV1\n");
  let x1:i32=node_new_term(st, nodes, sigtab, 0);
  let x2:i32=node_new_term(st, nodes, sigtab, 1);
  let x3:i32=node_new_term(st, nodes, sigtab, 2);
  let x4:i32=node_new_term(st, nodes, sigtab, 3);
  let x5:i32=node_new_term(st, nodes, sigtab, 4);
  let x6:i32=node_new_term(st, nodes, sigtab, 5);
  let a1:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x2);
  let a2:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x3);
  let f1:i32=node_new_op(st, nodes, sigtab, trace, 1, a1, a2);
  let a3:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x4);
  let a4:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x5);
  let f2:i32=node_new_op(st, nodes, sigtab, trace, 1, a3, a4);
  let a5:i32=node_new_op(st, nodes, sigtab, trace, 0, x2, x3);
  let a6:i32=node_new_op(st, nodes, sigtab, trace, 0, x2, x4);
  let f3:i32=node_new_op(st, nodes, sigtab, trace, 1, a5, a6);
  let a8:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x4);
  let f4:i32=node_new_op(st, nodes, sigtab, trace, 1, a1, a8);
  let n6:i32=node_new_op(st, nodes, sigtab, trace, 2, x6, -1);
  let k1:i32=node_new_op(st, nodes, sigtab, trace, 3, f1, x6);
  let k2:i32=node_new_op(st, nodes, sigtab, trace, 1, f2, n6);
  let k3:i32=node_new_op(st, nodes, sigtab, trace, 0, f3, x1);
  let k4:i32=node_new_op(st, nodes, sigtab, trace, 3, f4, x2);
  let vx:[]u8=z_alloc(64);
  fill_vx16(vx);
  kept_clear(kctx);
  kept_add(kctx, k1, vx, 16);
  kept_add(kctx, k2, vx, 16);
  kept_add(kctx, k3, vx, 16);
  kept_add(kctx, k4, vx, 16);
  set32(obs, 0, 16);
  let j:i32=0;
  while(j<16){ set32(obs, 4+j*4, j); j=j+1; }
  let ev0:i32=stg(st, 28);
  consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
  let pass:i32=1;
  if(stg(st, 28)!=(ev0+1)){ pass=0; }
  if(stg(st, 44)!=1){ pass=0; }
  if(get32(rctx, 0)!=3){ pass=0; }
  if(get32(rctx, 384)!=5){ pass=0; }
  if(count_refs(nodes, kctx, 32)!=4){ pass=0; }
  emit("T-RV1 ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); sts(st, 36, 1); }
  return;
}
fn test_menu(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, bodies:[]u8, rctx:[]u8)void {
  emit("TEST T-MENU\n");
  let nc0:i32=stg(st, 0);
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, 8);
  sts(st, 12, 0);
  beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bodies, rctx);
  let rexp:i32=stg(st, 32);
  let nc1:i32=stg(st, 0);
  let reccnt:i32=0;
  let verified:i32=0;
  let n:i32=nc0;
  while(n<nc1){
    if(ndg(nodes, n, 0)==1){
      let arg:i32=ndg(nodes, n, 4);
      if(arg>=32){
        reccnt=reccnt+1;
        let ri:i32=arg-32;
        let ar:i32=get32(rctx, ri*4);
        let clo:[]u8=z_alloc(16);
        let chi:[]u8=z_alloc(16);
        let k:i32=0;
        while(k<4){
          if(k<ar){
            let cn:i32=ndg(nodes, n, 8+k*4);
            set32(clo, k*4, ndg(nodes, cn, 24));
            set32(chi, k*4, ndg(nodes, cn, 28));
          } else {
            set32(clo, k*4, 0);
            set32(chi, k*4, 0);
          }
          k=k+1;
        }
        let sob:[]u8=z_alloc(8);
        beval_sig(bodies, ri, 0, clo, chi, sob);
        if(get32(sob, 0)==ndg(nodes, n, 24)){
          if(get32(sob, 4)==ndg(nodes, n, 28)){ verified=verified+1; }
        }
      }
    }
    n=n+1;
  }
  emit("MENU rexp="); e64(rexp);
  emit(" reccnt="); e64(reccnt);
  emit(" verified="); e64(verified); emit("\n");
  let pass:i32=1;
  if(rexp<1){ pass=0; }
  if(reccnt<1){ pass=0; }
  if(verified!=reccnt){ pass=0; }
  emit("T-MENU ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); sts(st, 36, 1); }
  return;
}
fn test_retire(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, rctx:[]u8, kctx:[]u8, obs:[]u8)void {
  emit("TEST T-RETIRE\n");
  kept_clear(kctx);
  let x1:i32=node_new_term(st, nodes, sigtab, 0);
  let x2:i32=node_new_term(st, nodes, sigtab, 1);
  let x3:i32=node_new_term(st, nodes, sigtab, 2);
  let x4:i32=node_new_term(st, nodes, sigtab, 3);
  let x5:i32=node_new_term(st, nodes, sigtab, 4);
  let x6:i32=node_new_term(st, nodes, sigtab, 5);
  let a1:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x2);
  let k1:i32=node_new_op(st, nodes, sigtab, trace, 3, a1, x3);
  let a2:i32=node_new_op(st, nodes, sigtab, trace, 0, x4, x5);
  let k2:i32=node_new_op(st, nodes, sigtab, trace, 1, a2, x6);
  let vx:[]u8=z_alloc(64);
  fill_vx16(vx);
  kept_add(kctx, k1, vx, 16);
  kept_add(kctx, k2, vx, 16);
  let ev0:i32=stg(st, 28);
  let rt0:i32=stg(st, 40);
  consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
  consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
  consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
  let pass:i32=1;
  if(stg(st, 44)!=0){ pass=0; }
  if(stg(st, 40)!=(rt0+1)){ pass=0; }
  if(stg(st, 28)!=ev0){ pass=0; }
  emit("T-RETIRE ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); sts(st, 36, 1); }
  return;
}
fn test_nofire(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, bodies:[]u8, rctx:[]u8, kctx:[]u8, obs:[]u8)void {
  emit("TEST T-NOFIRE\n");
  kept_clear(kctx);
  let x1:i32=node_new_term(st, nodes, sigtab, 0);
  let x2:i32=node_new_term(st, nodes, sigtab, 1);
  let x3:i32=node_new_term(st, nodes, sigtab, 2);
  let x4:i32=node_new_term(st, nodes, sigtab, 3);
  let x5:i32=node_new_term(st, nodes, sigtab, 4);
  let x6:i32=node_new_term(st, nodes, sigtab, 5);
  let a1:i32=node_new_op(st, nodes, sigtab, trace, 0, x1, x2);
  let k1:i32=node_new_op(st, nodes, sigtab, trace, 3, a1, x3);
  let a2:i32=node_new_op(st, nodes, sigtab, trace, 0, x4, x5);
  let k2:i32=node_new_op(st, nodes, sigtab, trace, 1, a2, x6);
  let o1:i32=node_new_op(st, nodes, sigtab, trace, 3, x1, x3);
  let k3:i32=node_new_op(st, nodes, sigtab, trace, 0, o1, x2);
  let o2:i32=node_new_op(st, nodes, sigtab, trace, 3, x4, x6);
  let k4:i32=node_new_op(st, nodes, sigtab, trace, 1, o2, x5);
  let vx:[]u8=z_alloc(64);
  fill_vx16(vx);
  kept_add(kctx, k1, vx, 16);
  kept_add(kctx, k2, vx, 16);
  kept_add(kctx, k3, vx, 16);
  kept_add(kctx, k4, vx, 16);
  let ev0:i32=stg(st, 28);
  consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
  let pass:i32=1;
  if(stg(st, 28)!=ev0){ pass=0; }
  if(stg(st, 44)!=0){ pass=0; }
  emit("T-NOFIRE ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); sts(st, 36, 1); }
  return;
}
fn test_q4reg(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, bodies:[]u8, rctx:[]u8)void {
  emit("TEST T-Q4REG\n");
  sts(st, 16, 123456789);
  let d1:i32=phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, bodies, rctx, 0, 8, "P1A-CONJ");
  let pass:i32=1;
  if(d1<0){ pass=0; }
  else {
    if(true_correct(0, nodes, d1)!=64){ pass=0; }
  }
  sts(st, 16, 987654321);
  let d2:i32=phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, bodies, rctx, 1, 8, "P1B-XOR");
  if(d2<0){ pass=0; }
  else {
    if(true_correct(1, nodes, d2)!=64){ pass=0; }
  }
  emit("T-Q4REG ");
  if(pass==1){ emit("PASS\n"); } else { emit("FAIL\n"); sts(st, 36, 1); }
  return;
}
// ============ Phase B helpers ============
// Seed S_i = 90011 + (i-1)*977 for i=1..5.
fn pb_seed(i:i32)i32 {
  if(i==1){ return 90011; }
  if(i==2){ return 90988; }
  if(i==3){ return 91965; }
  if(i==4){ return 92942; }
  return 93919;
}
// M2 from 25-element true-accuracy log: 1-based index of first 64, or 25.
fn m2_from_log(mlog:[]u8)i32 {
  let i:i32=0;
  while(i<25){
    if(get32(mlog, i*4)==64){ return i+1; }
    i=i+1;
  }
  return 25;
}
// DFS: does tree rooted at n contain a node with opcode >= 32?
fn tree_has_rec_sub(nodes:[]u8, n:i32, seen:[]u8)i32 {
  if(n<0){ return 0; }
  if(seen[n]==1){ return 0; }
  seen[n]=1;
  let kind:i32=ndg(nodes, n, 0);
  if(kind==1){
    let arg:i32=ndg(nodes, n, 4);
    if(arg>=32){ return 1; }
    let c0:i32=ndg(nodes, n, 8);
    let c1:i32=ndg(nodes, n, 12);
    let c2:i32=ndg(nodes, n, 16);
    let c3:i32=ndg(nodes, n, 20);
    if(tree_has_rec_sub(nodes, c0, seen)==1){ return 1; }
    if(tree_has_rec_sub(nodes, c1, seen)==1){ return 1; }
    if(tree_has_rec_sub(nodes, c2, seen)==1){ return 1; }
    if(tree_has_rec_sub(nodes, c3, seen)==1){ return 1; }
  }
  return 0;
}
fn tree_has_rec(nodes:[]u8, n:i32)i32 {
  let seen:[]u8=z_alloc(8192);
  let i:i32=0;
  while(i<8192){ seen[i]=0; i=i+1; }
  return tree_has_rec_sub(nodes, n, seen);
}
// Reset state for a fresh seed-arm. Does NOT clear nodes[] contents (st+0=0 reuses).
fn fresh_for_seed(st:[]u8, sigtab:[]u8, kctx:[]u8, used:[]u8, seed:i32)void {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 28, 0);
  sts(st, 36, 0);
  sts(st, 44, 0);
  sts(st, 48, 0);
  clear_sigtab(sigtab);
  kept_clear(kctx);
  clear_used(used);
  sts(st, 16, seed);
  return;
}
// ============ Phase B main driver ============

// ============ pilot main ============
// Phase B prime Stage 1: stability characterization.
// For each family G1-G5, run 5 triples (3 episodes each), consolidate,
// record whether RECRUITED fired. Compute stability score p per family.
fn pilot_seed(fam_idx:i32, triple:i32)i32 {
  // fam_idx: 0=G1, 1=G2, 2=G3, 3=G4, 4=G5
  // triple: 0..4
  let base:i32=100011 + fam_idx*5 + triple;
  return base;
}
fn pilot_fam_base(fam_idx:i32)i32 {
  if(fam_idx==0){ return 20; }
  if(fam_idx==1){ return 23; }
  if(fam_idx==2){ return 26; }
  if(fam_idx==3){ return 29; }
  return 32;
}
fn main()void {
  emit("PILOT-START\n");
  let st:[]u8=z_alloc(64);
  let nodes:[]u8=z_alloc(294912);
  let sigtab:[]u8=z_alloc(65536);
  let beam:[]u8=z_alloc(512);
  let trace:[]u8=z_alloc(114688);
  let seen:[]u8=z_alloc(8192);
  let tmp:[]u8=z_alloc(32768);
  let tsc:[]u8=z_alloc(98304);
  let ev_x:[]u8=z_alloc(128);
  let ev_y:[]u8=z_alloc(128);
  let used:[]u8=z_alloc(64);
  let bodies:[]u8=z_alloc(6144);
  let rctx:[]u8=z_alloc(512);
  let kctx:[]u8=z_alloc(1280);
  let obs:[]u8=z_alloc(260);
  // Per-family results: [fam][0=recruited_count, 1=total_freq_sum]
  let fres:[]u8=z_alloc(5*2*4);
  let fi:i32=0;
  while(fi<5){
    let fbase:i32=pilot_fam_base(fi);
    emit("FAMILY G"); e64(fi+1); emit(" fbase="); e64(fbase); emit("\n");
    let ti:i32=0;
    while(ti<5){
      let seed:i32=pilot_seed(fi, ti);
      emit("TRIPLE seed="); e64(seed); emit("\n");
      fresh_for_seed(st, sigtab, kctx, used, seed);
      let vx:[]u8=z_alloc(64);
      fill_vx16(vx);
      // E1, E2, E3
      let r1:i32=phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, bodies, rctx, fbase+0, 6, "P-E1");
      if(r1>=0){ kept_add(kctx, r1, vx, 16); }
      let r2:i32=phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, bodies, rctx, fbase+1, 6, "P-E2");
      if(r2>=0){ kept_add(kctx, r2, vx, 16); }
      let r3:i32=phase1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, bodies, rctx, fbase+2, 6, "P-E3");
      if(r3>=0){ kept_add(kctx, r3, vx, 16); }
      // Consolidate
      set32(obs, 0, 16);
      let oj:i32=0;
      while(oj<16){ set32(obs, 4+oj*4, oj); oj=oj+1; }
      let nrec_before:i32=stg(st, 44);
      consolidate(st, nodes, sigtab, trace, bodies, rctx, kctx, obs);
      let nrec_after:i32=stg(st, 44);
      let recruited:i32=0;
      if(nrec_after>nrec_before){ recruited=1; }
      emit("TRIPLE_RESULT recruited="); e64(recruited); emit("\n");
      if(recruited==1){
        let rc:i32=get32(fres, (fi*2+0)*4);
        set32(fres, (fi*2+0)*4, rc+1);
      }
      ti=ti+1;
    }
    fi=fi+1;
  }
  // Report stability scores
  emit("STABILITY_SCORES\n");
  let fj:i32=0;
  while(fj<5){
    let rc:i32=get32(fres, (fj*2+0)*4);
    emit("G"); e64(fj+1); emit(" p="); e64(rc); emit("/5\n");
    fj=fj+1;
  }
  // Selection per frozen rule (G3 excluded, threshold 0.8 = 4/5)
  let best_fam:i32=-1;
  let best_p:i32=-1;
  let fk:i32=0;
  while(fk<5){
    if(fk!=2){
      let p:i32=get32(fres, (fk*2+0)*4);
      if(p>=4){
        if(p>best_p){
          best_p=p;
          best_fam=fk;
        }
      }
    }
    fk=fk+1;
  }
  // Check G3 calibration
  let g3_p:i32=get32(fres, (2*2+0)*4);
  if(g3_p>=4){
    emit("RESULT CALIB-VIOLATION\n");
    emit("DONE\n");
    return;
  }
  if(best_fam<0){
    emit("RESULT STAB-NONE\n");
    emit("DONE\n");
    return;
  }
  emit("SELECTED_G"); e64(best_fam+1); emit(" p="); e64(best_p); emit("/5\n");
  emit("RESULT PILOT-STAGE1-COMPLETE\n");
  emit("DONE\n");
  return;
}

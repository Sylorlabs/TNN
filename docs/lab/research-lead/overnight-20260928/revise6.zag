  emit("\n--- Phase K: capacity ---\n");
  let VSK:[]u8=z_alloc(512);
  let p0K:[]u8=z_alloc(48);
  p0K[0]=1; p0K[1]=255; p0K[2]=255;
  p0K[3]=3; p0K[4]=255; p0K[5]=255;
  p0K[6]=6; p0K[7]=0; p0K[8]=1;
  vs3_init(VSK, p0K, 3);
  let pk:[]u8=z_alloc(48);
  pk[0]=1; pk[1]=255; pk[2]=255;
  pk[3]=1; pk[4]=255; pk[5]=255;
  pk[6]=6; pk[7]=0; pk[8]=1;
  let r1:i32=vs3_revise(VSK, 0, 120, pk, 3);
  let r2:i32=vs3_revise(VSK, 0, 121, pk, 3);
  let r3:i32=vs3_revise(VSK, 0, 113, pk, 3);
  let r4:i32=vs3_revise(VSK, 0, 119, pk, 3);
  ntest_total=ntest_total+1;
  if(r1==1 && r2==1 && r3==1 && r4==1 && get32(VSK,0)==4){
    emit("CHECK K1 R1..R4 appended PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK K1 R1..R4 appended FAIL\n"); }
  let r5:i32=vs3_revise(VSK, 0, 118, pk, 3);
  ntest_total=ntest_total+1;
  if(r5==-1 && get32(VSK,0)==4){
    emit("CHECK K2 R5 refused PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK K2 R5 refused FAIL\n"); }
  ntest_total=ntest_total+1;
  let outK:[]u8=z_alloc(16);
  if(vs3_apply(VSK, in0, outK)==1 && streq(outK[0..3], out0)==1){
    emit("CHECK K3 earlier revision intact PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK K3 earlier revision intact FAIL\n"); }

  // ---- Phase L: X-RV4-1 unique-wrong-top -> UNCORROBORATED (K-RV5-1) ----
  emit("\n--- Phase L: X-RV4-1 unique-wrong-top ---\n");
  emit("Hidden truth: IF input[2]=='y' (121) THEN broadcast-first ELSE broadcast-last\n");
  let VSL:[]u8=z_alloc(512);
  let p0L:[]u8=z_alloc(48);
  p0L[0]=1; p0L[1]=255; p0L[2]=255;
  p0L[3]=3; p0L[4]=255; p0L[5]=255;
  p0L[6]=6; p0L[7]=0; p0L[8]=1;
  vs3_init(VSL, p0L, 3);
  let inL:[]u8="zqy"; let outL:[]u8="zzz";
  let predL:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VSL, inL, predL)==1 && streq(predL[0..3], outL)==1){
    emit("CHECK L1 counterexample detected FAIL (unexpected match)\n");
  } else {
    emit("CHECK L1 counterexample detected PASS\n"); npass_total=npass_total+1;
  }
  let seqL:[]u8=z_alloc(64);
  let sl:i32=pextract(inL, outL, seqL);
  ntest_total=ntest_total+1;
  if(sl<0){ emit("FATAL extract inL\n"); return 1; }
  npass_total=npass_total+1;
  let drL:i32=diagnose_propose(D_J, pdJ, 4, inL, outL);
  ntest_total=ntest_total+1;
  if(drL==122){
    emit("CHECK L3 propose==(0,122) PASS (wrong top still proposed; phase 1 unchanged)\n"); npass_total=npass_total+1;
  } else { emit("CHECK L3 propose==(0,122) FAIL (got "); emit(i32s(drL)); emit(")\n"); }
  let lp:i32=drL/1000;
  let lv:i32=drL-lp*1000;
  let inL2:[]u8="aqy"; let outL2:[]u8="aaa";
  let S_L:[]u8=z_alloc(64);
  let cpl:i32=0;
  while(cpl<sl){ S_L[cpl]=seqL[cpl]; cpl=cpl+1; }
  let descL:[]u8=z_alloc(12);
  set32(descL, 0, 0); set32(descL, 4, sl); set32(descL, 8, inL.len);
  let pL:[]u8=z_alloc(48);
  let nnL:i32=discover(S_L, descL, 1, pL);
  ntest_total=ntest_total+1;
  if(nnL<0){ emit("FATAL discover PL\n"); return 1; }
  npass_total=npass_total+1;
  let corL:i32=diagnose_corroborate_v6(VSL, inL2, outL2, lp, lv, pL, nnL);
  ntest_total=ntest_total+1;
  if(corL==0){
    emit("CHECK L4 UNCORROBORATED withhold PASS\n"); npass_total=npass_total+1;
    emit("UNCORROBORATED: single-counterexample evidence insufficient; revision withheld (code -3)\n");
  } else { emit("CHECK L4 UNCORROBORATED withhold FAIL (unexpected corroboration)\n"); }
  ntest_total=ntest_total+1;
  if(get32(VSL,0)==0){
    emit("CHECK L5 vcount==0 PASS (no wrong revision appended)\n"); npass_total=npass_total+1;
  } else { emit("CHECK L5 vcount==0 FAIL\n"); }
  let inL3:[]u8="zqw"; let outL3:[]u8="www";
  ntest_total=ntest_total+1;
  if(vs3_apply(VSL, inL3, predL)==1 && streq(predL[0..3], outL3)==1){
    emit("CHECK L6 P0 intact zqw->www PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK L6 P0 intact zqw->www FAIL\n"); }

  // ---- Phase M: K-RV6-1 new condition (b) is functional ----
  // Fixture: condition fires on fail2, P0 mispredicts fail2, but the
  // proposed revision ((p,v),P1) predicts fail2 INCORRECTLY.
  // The gate must return 0. (In H-REVISE5, the old gate would have
  // returned 1 here: (a) fires, old-(b) redundant, (c) mispredicts.)
  emit("\n--- Phase M: K-RV6-1 revision-correctness gate ---\n");
  let VSM:[]u8=z_alloc(512);
  let p0M:[]u8=z_alloc(48);
  p0M[0]=1; p0M[1]=255; p0M[2]=255;
  p0M[3]=3; p0M[4]=255; p0M[5]=255;
  p0M[6]=6; p0M[7]=0; p0M[8]=1;
  vs3_init(VSM, p0M, 3);
  let inM1:[]u8="xab"; let outM1:[]u8="xxx";
  let S_M:[]u8=z_alloc(64);
  let seqM:[]u8=z_alloc(64);
  let sm:i32=pextract(inM1, outM1, seqM);
  let cpm:i32=0;
  while(cpm<sm){ S_M[cpm]=seqM[cpm]; cpm=cpm+1; }
  let descM:[]u8=z_alloc(12);
  set32(descM, 0, 0); set32(descM, 4, sm); set32(descM, 8, inM1.len);
  let pM:[]u8=z_alloc(48);
  let nnM:i32=discover(S_M, descM, 1, pM);
  ntest_total=ntest_total+1;
  if(nnM<0){ emit("FATAL discover PM\n"); return 1; }
  npass_total=npass_total+1;
  let inM2b:[]u8="xqw"; let outM2b:[]u8="qqq";
  let corM:i32=diagnose_corroborate_v6(VSM, inM2b, outM2b, 0, 120, pM, nnM);
  ntest_total=ntest_total+1;
  if(corM==0){
    emit("CHECK M1 gate withholds (revision wrong for fail2) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK M1 gate withholds FAIL (gate returned 1; (b) not functional)\n"); }
  ntest_total=ntest_total+1;
  if(get32(VSM,0)==0){
    emit("CHECK M2 vcount==0 PASS (no broken revision appended)\n"); npass_total=npass_total+1;
  } else { emit("CHECK M2 vcount==0 FAIL\n"); }

  emit("\n=== RESULT: ");
  emit(i32s(npass_total)); emit("/"); emit(i32s(ntest_total));
  emit(" ===\n");
  if(npass_total==ntest_total){
    emit("H-REVISE6 SURVIVES\n");
    return 0;
  }
  emit("H-REVISE6 KILLED\n");
  return 1;
}

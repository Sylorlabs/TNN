// world_b2.zag -- Sealed World B: contextual delay (AUTOSCI2 retry).
// Concatenate AFTER autosci2_learner.zag.
// TRUE LAW (sealed from learner): (X->Y, delay 2, context K==0). Under K==1 X does nothing.
// The learner only sees the w_* interface. w_verify is harness adjudication.
// Goal mode 1 = B2 sustained triple goal (prereg AUTOSCI2).

fn w_goal_mode()i32 { return 1; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 2; } // X, K
fn w_ctxvar()i32 { return 2; } // K
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Y"; }
  return "K";
}
fn w_worldname()[]u8 { return "B-contextual-delay"; }
fn w_plan_maxd()i32 { return 6; }

fn B_truerules()[]u8 {
  let r:[]u8=z_alloc(5);
  r[0]=0; r[1]=1; r[2]=2; r[3]=2; r[4]=0; // X -> Y delay 2 iff K==0
  return r;
}

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (nvars*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    let hist:[]u8=ws[8..8+3*32];
    L_advance(hist,t,B_truerules(),1,3);
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: environment SETs X at t=2 and t=8. K=0 throughout.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==2 || t==8){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: establish K=1 start state.
fn w_goal_setup(ws:[]u8)void {
  ws[8+2*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[1]==1){ return 1; }
  return 0;
}

// Harness adjudication for K2-R4. Knows the sealed truth; the learner does not.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  // true candidate: Y:(X,2,ctx K=0)
  let ty:i32=-1;
  let j:i32=0;
  while(j<36){
    let b:i32=(1*36+j)*5;
    if((candbuf[b] as i32)==0 && (candbuf[b+2] as i32)==2 &&
       (candbuf[b+3] as i32)==2 && (candbuf[b+4] as i32)==0){ ty=j; }
    j=j+1;
  }
  let true_h:i32=-1;
  let h:i32=0;
  while(h<nhyp){
    if((hysel[h*1+0] as i32)==ty){ true_h=h; }
    h=h+1;
  }
  emit("K2-R4 true_h="); e64(true_h);
  emit(" alive="); e64(alive[true_h]); emit(" nalive="); e64(nalive);
  emit(" exhausted="); e64(exhausted); emit("\n");
  // Expect: exactly one survivor, equal to the true law.
  if(true_h>=0 && alive[true_h]==1 && nalive==1){
    emit("K2-R4 PASS\n");
    return 1;
  }
  emit("K2-R4 FAIL\n");
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  if(m==63){ emit("AUTOSCI_B PROGRAM_ALL_BARS_PASS\n"); return 0; }
  emit("AUTOSCI_B PROGRAM_FAIL mask="); e64(m); emit("\n");
  return 1;
}

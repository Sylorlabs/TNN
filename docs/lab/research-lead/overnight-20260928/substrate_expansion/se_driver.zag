// se_driver.zag -- five batteries, full substrate vs one ablation arm each.
// Battery 1 policy:        full(31) vs no-policy(30)
// Battery 2a withholding:   full(31) vs no-withhold(29)
// Battery 2b abandonment:   full(31) vs no-abandon(27)
// Battery 3 retention:      full(31) vs no-retention(23)
// Battery 5 search-order:   full(31) vs no-order(15)
// Returns 0 iff every battery passes. Deterministic.

fn se_vc(W:[]u8)i32 { return hg(W,16)/1024; }
fn se_vc_zero(W:[]u8)void { hs(W,16,0); return; }
fn se_n(W:[]u8)i32 { return hg(W,20); }

// Guide action for (s,r)'s open uncertainty (fa8405a90 guide layout:
// tag-30 uncertainty, edge type 1 from guide, action in guide f20).
fn se_guide_action(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==n){
            let g:i32=eg(W,e,0);
            if(g>=2 && ng(W,g,36)==1){ return ng(W,g,20); }
          }
          e=e+1;
        }
      }
    }
    n=n+1;
  }
  return -999;
}

// ---- Battery 1: policy via STRATEGY(action,0) ----
fn b_policy(W:[]u8,exp_guide:i32)i32 {
  let i:i32=0;
  while(i<3){
    let s:i32=100+i;
    ev_query(W,s,1,0,0);
    let aw:i32=30; if(i==1){aw=-1;}
    ev_observe_aw(W,s,1,1000+i,aw);
    i=i+1;
  }
  if(sub_best_action(W)!=30){ emit("B1 FAIL phase1\n"); return 1; }
  i=0;
  while(i<3){
    let s:i32=200+i;
    ev_query(W,s,2,0,0);
    ev_observe_aw(W,s,2,2000+i,45);
    i=i+1;
  }
  if(sub_best_action(W)!=45){ emit("B1 FAIL phase2\n"); return 1; }
  ev_query(W,300,3,-2,0);
  let g:i32=se_guide_action(W,300,3);
  emit("B1 guide="); e64(g); emit("\n");
  if(g!=exp_guide){ emit("B1 FAIL guide\n"); return 1; }
  emit("B1 PASS\n");
  return 0;
}

// ---- Battery 2a: withholding via PURSUIT.consec_fail ----
// Richer chain structure so each failed trial costs measurable verifies.
// Returns 1000+VC on success, -1 on failure.
fn b2a_teach(W:[]u8)void {
  ev_teach(W,101,1,2001); ev_teach(W,2001,1,2002); ev_teach(W,2002,1,2003);
  ev_teach(W,101,2,2011); ev_teach(W,2011,2,2012); ev_teach(W,2012,2,2013);
  ev_teach(W,101,3,2021); ev_teach(W,2021,3,2022); ev_teach(W,2022,3,2023);
  return;
}
fn b_withhold(W:[]u8,exp_q4:i32)i32 {
  b2a_teach(W);
  se_vc_zero(W);
  let vc:i32=0;
  let r1:i32=ev_query(W,101,99,-2,0); vc=vc+se_vc(W); se_vc_zero(W);
  let r2:i32=ev_query(W,101,99,-2,0); vc=vc+se_vc(W); se_vc_zero(W);
  let r3:i32=ev_query(W,101,99,-2,0); vc=vc+se_vc(W); se_vc_zero(W);
  let r4:i32=ev_query(W,101,99,-2,0); vc=vc+se_vc(W);
  emit("B2a r="); e64(r1); emit(","); e64(r2); emit(","); e64(r3); emit(","); e64(r4);
  emit(" vc="); e64(vc); emit("\n");
  if(r1!=-2 || r2!=-2 || r3!=-2){ emit("B2a FAIL early\n"); return -1; }
  if(r4!=exp_q4){ emit("B2a FAIL q4\n"); return -1; }
  if(vc<=0){ emit("B2a FAIL vc0\n"); return -1; }
  return 1000+vc;
}

// ---- Battery 2b: abandonment via PURSUIT.consec_fail + life.state ----
// Permanence test: after abandonment, even teaching the key does not
// revive it (abandoned check precedes activation). exp_perm is the
// expected return of a post-teach query (-4 full, 9999 ablated).
// Returns 0 on success, 1 on failure.
fn b_abandon(W:[]u8,exp_q678:i32,exp_perm:i32)i32 {
  b2a_teach(W);
  se_vc_zero(W);
  let vc:i32=0;
  let r6:i32=-9; let r7:i32=-9; let r8:i32=-9;
  let i:i32=1;
  while(i<=8){
    let r:i32=ev_query(W,101,99,-2,0); vc=vc+se_vc(W); se_vc_zero(W);
    if(i==6){r6=r;} if(i==7){r7=r;} if(i==8){r8=r;}
    i=i+1;
  }
  let ab:i32=se_is_abandoned(W,101,99);
  emit("B2b q6="); e64(r6); emit(" q7="); e64(r7); emit(" q8="); e64(r8);
  emit(" vc="); e64(vc); emit(" abandoned="); e64(ab); emit("\n");
  if(r6!=exp_q678 || r7!=exp_q678 || r8!=exp_q678){ emit("B2b FAIL rets\n"); return 1; }
  // permanence: teach the abandoned key, query again
  ev_teach(W,101,99,9999);
  let rp:i32=ev_query(W,101,99,-2,0);
  emit("B2b post-teach="); e64(rp); emit("\n");
  if(rp!=exp_perm){ emit("B2b FAIL permanence\n"); return 1; }
  emit("B2b PASS\n");
  return 0;
}

// ---- Battery 3: retention reclaims ABANDONED-key structures first ----
// Census of live uncertainties for (s,r).
fn se_census(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let u:i32=2;
  while(u<1024){
    if(ng(W,u,36)==1 && ng(W,u,0)==30 && ng(W,u,20)==s && ng(W,u,24)==r){ c=c+1; }
    u=u+1;
  }
  return c;
}
// Adversarial setup for B3: raise the generic-bid "keep" signal on the
// ABANDONED (1,99) uncertainties via type-2 self-loops (established
// pattern; invisible to is_superseded which needs type-3, and to
// map_standing which only counts MAP nodes). The generic bid scan then
// actively AVOIDS them, so the retention pass must OVERRIDE bid to
// reclaim them first. (2,99) uncertainties are the unboosted control.
fn se_boost_bid(W:[]u8,s:i32,r:i32,nb:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==s && ng(W,n,24)==r){
      let k:i32=0;
      while(k<nb){ link_edge(W,n,2,n,0); k=k+1; }
    }
    n=n+1;
  }
  return;
}
// Returns victim count of (1,99)-structures, -1 on setup failure.
fn b_retention(W:[]u8)i32 {
  let k:i32=1;
  while(k<=5){ ev_teach(W,k,1,500+k); ev_teach(W,100+k,1,1500+k); k=k+1; }
  let i:i32=1;
  while(i<=6){ ev_query(W,1,99,-2,0); i=i+1; }
  i=1;
  while(i<=3){ ev_query(W,2,99,-2,0); i=i+1; }
  k=1;
  while(k<=10){ ev_teach(W,300+k,1,3000+k); k=k+1; }
  if(se_n(W)>=950){ emit("B3 FAIL node pressure\n"); return -1; }
  let c1:i32=se_census(W,1,99);
  let c2:i32=se_census(W,2,99);
  emit("B3 census pre (1,99)="); e64(c1); emit(" (2,99)="); e64(c2); emit("\n");
  if(c1!=3 || c2!=3){ emit("B3 FAIL census\n"); return -1; }
  se_boost_bid(W,1,99,5);
  let vcount:i32=0;
  i=0;
  while(i<6){
    let v:i32=evict_node(W);
    if(v<0){ break; }
    emit("B3 victim tag="); e64(ng(W,v,0));
    emit(" f20="); e64(ng(W,v,20)); emit(" f24="); e64(ng(W,v,24)); emit("\n");
    if(ng(W,v,0)==30 && ng(W,v,20)==1 && ng(W,v,24)==99){ vcount=vcount+1; }
    i=i+1;
  }
  let c1p:i32=se_census(W,1,99);
  emit("B3 victims(1,99)="); e64(vcount); emit(" census post="); e64(c1p); emit("\n");
  return vcount;
}

// ---- Battery 5: search-order via STRATEGY(rel,1) ----
// Returns 1+vc1*1000+vc2 on success, -1 on failure.
fn b_order(W:[]u8)i32 {
  ev_teach(W,1,8,21); ev_teach(W,21,8,22); ev_teach(W,22,8,23); ev_teach(W,23,8,24);
  ev_teach(W,1,7,11); ev_teach(W,11,7,12); ev_teach(W,12,7,13); ev_teach(W,13,7,14);
  se_vc_zero(W);
  let q1:i32=ev_query(W,1,50,14,0);
  let vc1:i32=se_vc(W);
  ev_teach(W,2,8,41); ev_teach(W,41,8,42); ev_teach(W,42,8,43); ev_teach(W,43,8,44);
  ev_teach(W,2,7,31); ev_teach(W,31,7,32); ev_teach(W,32,7,33); ev_teach(W,33,7,34);
  se_vc_zero(W);
  let q2:i32=ev_query(W,2,50,34,0);
  let vc2:i32=se_vc(W);
  emit("B5 q1="); e64(q1); emit(" vc1="); e64(vc1);
  emit(" q2="); e64(q2); emit(" vc2="); e64(vc2); emit("\n");
  if(q1!=14 || q2!=34){ emit("B5 FAIL answer\n"); return -1; }
  return 1+vc1*1000+vc2;
}

fn main()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656);
  // B1
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,31);
  if(b_policy(W,45)!=0){ ok=0; }
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,30);
  if(b_policy(W,30)!=0){ ok=0; }
  // B2a
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,31);
  let vcfa:i32=b_withhold(W,-3);
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,29);
  let vcaa:i32=b_withhold(W,-2);
  if(vcfa<0 || vcaa<0){ ok=0; }
  else if(vcfa>=vcaa){ emit("B2a FAIL vc not reduced\n"); ok=0; }
  else { emit("B2a PASS\n"); }
  // B2b
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,31);
  if(b_abandon(W,-4,-4)!=0){ ok=0; }
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,27);
  if(b_abandon(W,-3,9999)!=0){ ok=0; }
  // B3
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,31);
  let rf:i32=b_retention(W);
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,23);
  let ra:i32=b_retention(W);
  if(rf!=3){ emit("B3 FAIL full\n"); ok=0; } else { emit("B3 full PASS\n"); }
  if(ra!=0){ emit("B3 FAIL abl\n"); ok=0; } else { emit("B3 abl PASS\n"); }
  // B5
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,31);
  let of:i32=b_order(W);
  W=z_alloc(110656); tnn2_init(W); se_cfg_set(W,15);
  let oa:i32=b_order(W);
  if(of<0 || oa<0){ ok=0; }
  else {
    let vc1f:i32=(of-1)/1000; let vc2f:i32=(of-1)%1000;
    let vc1a:i32=(oa-1)/1000; let vc2a:i32=(oa-1)%1000;
    if(vc1f!=vc1a){ emit("B5 FAIL vc1 cross-arm\n"); ok=0; }
    if(vc2f>=vc1f){ emit("B5 FAIL full no gain\n"); ok=0; }
    if(vc2a!=vc1a){ emit("B5 FAIL abl vc2\n"); ok=0; }
    if(ok==1){ emit("B5 PASS\n"); }
  }
  if(ok==1){ emit("SE-ALL-PASS\n"); return 0; }
  emit("SE-FAIL\n"); return 1;
}

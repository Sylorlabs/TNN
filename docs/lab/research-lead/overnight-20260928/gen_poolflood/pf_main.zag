// pf_main.zag -- GEN-POOLFLOOD driver: world setups + main only.
// setup_pf1 is a byte-exact copy of the frozen GEN-REDIM setup_s5
// (verified by build.sh via extraction + cmp). setup_pf2 is the S5
// flood world plus 7 IDENT distractors m4..m10 (teach(201,201) gives
// in{1}; each is tried exactly once, in R1, on the kind-1 seed).
// No mechanism code. Structures m0..m10; relations and entities are
// bare integers. No task vocabulary anywhere in this file.
fn setup_pf1(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,201,91,212);
  fact_add(A,201,92,221); fact_add(A,201,92,222); fact_add(A,201,92,223);
  fact_add(A,231,93,232);
  map_new(A,0,1,91,0); map_new(A,1,1,92,0); map_new(A,2,4,0,0); map_new(A,3,3,0,0);
  teach(A,0,201,2); teach(A,1,201,3); teach2(A,2,2,3,5); teach(A,3,231,231);
  return;
}
fn setup_pf2(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,201,91,212);
  fact_add(A,201,92,221); fact_add(A,201,92,222); fact_add(A,201,92,223);
  fact_add(A,231,93,232);
  map_new(A,0,1,91,0); map_new(A,1,1,92,0); map_new(A,2,4,0,0); map_new(A,3,3,0,0);
  map_new(A,4,3,0,0); map_new(A,5,3,0,0); map_new(A,6,3,0,0);
  map_new(A,7,3,0,0); map_new(A,8,3,0,0); map_new(A,9,3,0,0);
  map_new(A,10,3,0,0);
  teach(A,0,201,2); teach(A,1,201,3); teach2(A,2,2,3,5); teach(A,3,231,231);
  teach(A,4,201,201); teach(A,5,201,201); teach(A,6,201,201);
  teach(A,7,201,201); teach(A,8,201,201); teach(A,9,201,201);
  teach(A,10,201,201);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new_nm(4);
  setup_pf1(A1);
  c=gen_solve(A1,B,c,201,1,2,999999,4);
  c=gen_report(A1,B,c,"GEN","PF1");
  let A2:[]u8=world_new_nm(11);
  setup_pf2(A2);
  c=gen_solve(A2,B,c,201,1,2,999999,11);
  c=gen_report(A2,B,c,"GEN","PF2");
  o_flush(B,c);
  return 0;
}

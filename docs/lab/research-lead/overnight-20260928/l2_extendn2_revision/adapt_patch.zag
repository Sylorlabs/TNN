// adapt_patch.zag -- EXTEND-ONE: L2 adaptation operator for composition.
//
// Closes the L2 adaptation gap documented in COMPOSITION-LEVELS-COMPLETE:
// the unified DFS admits only whole existing MAPs as segments. When the
// standard pipeline (activate, rebind_try, compose_try) fails, EXTEND-ONE
// extends a fully-satisfied native MAP by one link, licensed by a real
// fact at the frontier, then re-runs the unchanged verified composition.
//
// The operator is general: it names no relation, no MAP, no length, and
// no query. The extension relation is read from the fact store at the
// frontier. Candidate extensions are execution-verified before
// promotion, and the final answer is verified against expected by the
// unchanged compose_try, so a wrong extension cannot produce a false
// positive.
//
// Provenance: an adapted MAP carries a type-16 LINK to its source MAP
// ("adapted-from"). Native MAPs have no type-16 edge. Type 16 is free:
// the base uses edge types 1-13, the unified patch uses 14 (provenance)
// and 15 (co-use). Zero modes, bridges, handlers, semantic cases.

// 1 iff MAP m has no outgoing type-16 edge (native, not adapted).
fn adapt_is_native(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==16){return 0;}
    e=e+1;
  }
  return 1;
}

// 1 iff no live MAP carries exactly relseq seq[0..L-1] ++ [rnew].
fn adapt_relseq_absent(W:[]u8,seq:[]u8,L:i32,rnew:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let sq:[]u8=z_alloc(28);
      let lm:i32=cc_relseq(W,m,sq,7);
      if(lm==L+1){
        let ok:i32=1;
        let j:i32=0;
        while(j<L){
          if(get32(sq,j*4)!=get32(seq,j*4)){ok=0;}
          j=j+1;
        }
        if(get32(sq,L*4)!=rnew){ok=0;}
        if(ok==1){return 0;}
      }
    }
    m=m+1;
  }
  return 1;
}

// Promote an adapted MAP: identical MAP node/edge layout to
// promote_graph, but teaches NO fact. Rationale: every other
// promote_graph caller passes a VERIFIED QUERY ANSWER (trial, rebind,
// and compose all verify against expected before promoting). An
// adapted MAP is scaffolding built mid-query, not a query answer, so
// teaching (s, r_src, vnext) would leak a shortcut fact that the
// generic trial can exploit (observed: it gave t2_trial a bridge in
// the ABL-Y control). Invariant restored: facts are taught only for
// verified query answers. The adapted structure itself remains fully
// visible to the DFS as a live MAP.
fn adapt_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  return m;
}

// EXTEND-ONE: extend each fully-satisfied native MAP by one frontier
// fact. Returns the number of adapted MAPs promoted.
fn adapt_extend(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && adapt_is_native(W,m)==1){
      let seq:[]u8=z_alloc(28);
      let L:i32=cc_relseq(W,m,seq,7);
      if(L>=1 && L<7){
        let vals:[]u8=z_alloc(36);
        let fids:[]u8=z_alloc(32);
        let ln:i32=cc_satisfy(W,m,s,vals,fids);
        if(ln==L){
          let fr:i32=get32(vals,L*4);
          let fn2:i32=2;
          while(fn2<1024){
            if(ng(W,fn2,36)==1 && ng(W,fn2,0)==1 && ng(W,fn2,20)==fr && ng(W,fn2,24)!=-999 && is_superseded(W,fn2)==0){
              let rnew:i32=ng(W,fn2,24);
              let vnext:i32=ng(W,fn2,28);
              if(adapt_relseq_absent(W,seq,L,rnew)==1){
                let vv:[]u8=z_alloc(40);
                let ff:[]u8=z_alloc(36);
                let j:i32=0;
                while(j<=L){set32(vv,j*4,get32(vals,j*4)); j=j+1;}
                set32(vv,(L+1)*4,vnext);
                j=0;
                while(j<L){set32(ff,j*4,get32(fids,j*4)); j=j+1;}
                set32(ff,L*4,fn2);
                let root:i32=t2_asm_chain(W,vv,L+2,ff);
                if(root>=0){
                  let st:[]u8=z_alloc(8);
                  set32(st,0,0); set32(st,4,0);
                  let chk:i32=t2_try_verify(W,root,s,vnext,masked,st);
                  if(chk!=-2){
                    let af:[]u8=z_alloc(36);
                    j=0;
                    while(j<=L){set32(af,j*4,get32(ff,j*4)); j=j+1;}
                    let am:i32=adapt_promote(W,root,s,ng(W,m,4),vnext,af,L+1);
                    if(am>=0){
                      link_edge(W,am,16,m,0);
                      emit("ADAPT-MK id="); e64(am);
                      emit(" src="); e64(m);
                      emit(" len="); e64(L+1); emit("\n");
                      nmk=nmk+1;
                    }
                  }
                }
              }
            }
            fn2=fn2+1;
          }
        }
      }
    }
    m=m+1;
  }
  return nmk;
}

// ev_query with the L2 adaptation bracket: the unified pipeline
// verbatim, plus EXTEND-ONE between the failed compose_try and the
// trial fallback.
fn ev_query_adapt(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- unified composition: DFS over pluggable applicability ----
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    // ---- L2 adaptation: extend-by-one-link, then recompose ----
    emit("ADAPT-TRY\n");
    let nmk:i32=adapt_extend(W,s,masked);
    emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
      emit("COMP-STAT2 tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
      if(ca2!=-2){
        hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
        log_ev(W,2,s,r,ca2,1,0,0); return ca2;
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// rv_driver.zag -- L2-EXTENDN-2 battery driver (arms R1 R2 C1 C2).
// Each arm runs on a fresh tnn2_init workspace. The driver asserts
// the frozen prereg constants and emits ARM <name> PASS/FAIL.

fn rv_freshW()[]u8 {
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  return W;
}

// World facts. alt=1 teaches the alternative frontier fact
// (106,3,107) after the kill target (106,2,107), so the kill
// target has the lower id. alt=0 omits it (R2).
fn rv_world(W:[]u8,alt:i32)void {
  ev_teach(W,101,1,102);
  ev_teach(W,102,1,103);
  ev_teach(W,103,1,104);
  ev_teach(W,104,2,105);
  ev_teach(W,105,2,106);
  ev_teach(W,106,2,107);
  if(alt==1){ ev_teach(W,106,3,107); }
  ev_teach(W,201,1,202);
  ev_teach(W,202,1,203);
  ev_teach(W,301,9,309);
  return;
}

// relation-sequence buffer [a,b,c,d,e,f].
fn rv_mkseq(a:i32,b:i32,c:i32,d:i32,e:i32,f:i32)[]u8 {
  let q:[]u8=z_alloc(32);
  set32(q,0,a); set32(q,4,b); set32(q,8,c);
  set32(q,12,d); set32(q,16,e); set32(q,20,f);
  return q;
}

fn rv_report(name:[]u8,ans:i32,ext:i32,stop:i32,pass:i32,allocs:i32)i32 {
  emit("ARM "); emit(name);
  emit(" ans="); e64(ans); emit(" ext="); e64(ext);
  emit(" stop="); e64(stop); emit(" allocs="); e64(allocs);
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

// R1: revision with re-route. ans=107 ext=3 stop=TERM,
// final relseq [1,1,1,2,2,3]; died fact is (106,2,107) and is
// superseded; replacement is (106,3,107) and is live.
fn arm_r1()i32 {
  let W:[]u8=rv_freshW();
  rv_world(W,1);
  let m0:i32=rv_mk_native(W,101,rv_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(20);
  let ans:i32=rv_extend_iter(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let died:i32=get32(out,12);
  let repl:i32=get32(out,16);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=107){ pass=0; }
  if(ext!=3){ pass=0; }
  if(stop!=0){ pass=0; }
  if(rv_relseq_eq(W,fin,rv_mkseq(1,1,1,2,2,3),6)!=1){ pass=0; }
  if(rv_hops_to_native(W,fin)!=3){ pass=0; }
  if(rv_ult_native(W,fin)!=m0){ pass=0; }
  if(died<0){ pass=0; }
  if(died>=0){
    if(ng(W,died,20)!=106){ pass=0; }
    if(ng(W,died,24)!=2){ pass=0; }
    if(ng(W,died,28)!=107){ pass=0; }
    if(is_superseded(W,died)!=1){ pass=0; }
  }
  if(repl<0){ pass=0; }
  if(repl>=0){
    if(ng(W,repl,20)!=106){ pass=0; }
    if(ng(W,repl,24)!=3){ pass=0; }
    if(ng(W,repl,28)!=107){ pass=0; }
    if(is_superseded(W,repl)!=0){ pass=0; }
  }
  if(died==repl){ pass=0; }
  let aud:i32=rv_audit_live(W,fin,101);
  emit("AUDIT-R1 live-maps="); e64(aud); emit("\n");
  if(aud!=4){ pass=0; }
  return rv_report("R1",ans,ext,stop,pass,hg(W,20));
}

// R2: revision with clean stop. ans=106 ext=2 stop=EXECFAIL,
// final relseq [1,1,1,2,2]; died fact detected, no replacement;
// exactly 2 adapted MAPs, all licensing facts live.
fn arm_r2()i32 {
  let W:[]u8=rv_freshW();
  rv_world(W,0);
  let m0:i32=rv_mk_native(W,101,rv_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(20);
  let ans:i32=rv_extend_iter(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let died:i32=get32(out,12);
  let repl:i32=get32(out,16);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=106){ pass=0; }
  if(ext!=2){ pass=0; }
  if(stop!=2){ pass=0; }
  if(rv_relseq_eq(W,fin,rv_mkseq(1,1,1,2,2,0),5)!=1){ pass=0; }
  if(rv_hops_to_native(W,fin)!=2){ pass=0; }
  if(rv_ult_native(W,fin)!=m0){ pass=0; }
  if(died<0){ pass=0; }
  if(died>=0){
    if(ng(W,died,20)!=106){ pass=0; }
    if(ng(W,died,24)!=2){ pass=0; }
    if(ng(W,died,28)!=107){ pass=0; }
    if(is_superseded(W,died)!=1){ pass=0; }
  }
  if(repl!=-1){ pass=0; }
  if(rv_count_adapted(W)!=2){ pass=0; }
  let aud:i32=rv_audit_live(W,fin,101);
  emit("AUDIT-R2 live-maps="); e64(aud); emit("\n");
  if(aud!=3){ pass=0; }
  if(rv_find_dead(W,fin,101)!=-1){ pass=0; }
  return rv_report("R2",ans,ext,stop,pass,hg(W,20));
}

// C1: no-stale control. Promotes the broken extension through the
// dead fact: ans=107 ext=3 stop=TERM, final relseq [1,1,1,2,2,2],
// but the final MAP carries a superseded licensing fact.
fn arm_c1()i32 {
  let W:[]u8=rv_freshW();
  rv_world(W,1);
  let m0:i32=rv_mk_native(W,101,rv_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(20);
  let ans:i32=rv_extend_iter_nostale(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=107){ pass=0; }
  if(ext!=3){ pass=0; }
  if(stop!=0){ pass=0; }
  if(rv_relseq_eq(W,fin,rv_mkseq(1,1,1,2,2,2),6)!=1){ pass=0; }
  let dead:i32=rv_find_dead(W,fin,101);
  emit("AUDIT-C1 dead-fid="); e64(dead); emit("\n");
  if(dead<0){ pass=0; }
  if(dead>=0){
    if(ng(W,dead,20)!=106){ pass=0; }
    if(ng(W,dead,24)!=2){ pass=0; }
    if(ng(W,dead,28)!=107){ pass=0; }
    if(is_superseded(W,dead)!=1){ pass=0; }
  }
  if(rv_audit_live(W,fin,101)!=-1){ pass=0; }
  return rv_report("C1",ans,ext,stop,pass,hg(W,20));
}

// C2: fresh learner, no m. Generic t2_trial must return -2.
fn arm_c2()i32 {
  let W:[]u8=rv_freshW();
  rv_world(W,1);
  let ans:i32=rv_ctrl_fresh(W,101,107);
  let pass:i32=1;
  if(ans!=-2){ pass=0; }
  emit("ARM C2 ans="); e64(ans); emit(" allocs="); e64(hg(W,20));
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

fn main()i32 {
  emit("RV-BATTERY-START\n");
  let p:i32=0;
  p=p+arm_r1();
  p=p+arm_r2();
  p=p+arm_c1();
  p=p+arm_c2();
  emit("RV-SUMMARY pass="); e64(p); emit("/4\n");
  if(p==4){ return 0; }
  return 1;
}

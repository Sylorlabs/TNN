// rv_patch.zag -- EXTEND-REV: iterative extension with mid-iteration
// revision. Fuses the C301 iterative-extension operator with the
// revision machinery: the learner commits to a next-step licensing
// plan, the world may kill that fact mid-iteration (disclosed world
// dynamics, learner not told), and the learner detects the stale
// plan, revises (re-route through a live alternative, or clean
// EXECFAIL stop), and never promotes through the dead fact.
//
// Reuses frozen: cc_relseq / cc_satisfy (un_patch),
// adapt_is_native / adapt_relseq_absent / adapt_promote (adapt_patch),
// t2_asm_chain / t2_exec / t2_lu_first / t2_trial / is_superseded /
// link_edge (cc_base). Provenance is type-16 adapted-from only.
// Zero new edge types, opcodes, modes, bridges, handlers,
// semantic cases, node tags.
//
// ---- OPERATOR SECTION (cognition) ----

// Lowest-id live FACT licensing a step from frontier value F:
// subject == F, relation != -999, not superseded. -1 if none.
fn rv_lic_fact(W:[]u8,F:i32)i32 {
  let n:i32=2;
  while(n<1024){
    let live:i32=ng(W,n,36);
    let tag:i32=ng(W,n,0);
    let subj:i32=ng(W,n,20);
    let rel:i32=ng(W,n,24);
    let sup:i32=is_superseded(W,n);
    let ok:i32=0;
    if(live==1){ ok=1; }
    if(ok==1 && tag!=1){ ok=0; }
    if(ok==1 && subj!=F){ ok=0; }
    if(ok==1 && rel==-999){ ok=0; }
    if(ok==1 && sup==1){ ok=0; }
    if(ok==1){ return n; }
    n=n+1;
  }
  return -1;
}

// Learner-owned starting selection: the longest fully-satisfied
// native MAP from s (no outgoing type-16 edge). Ties: lowest id.
// The operator is never told the MAP id.
fn rv_best_chain(W:[]u8,s:i32,native_only:i32)i32 {
  let best:i32=-1;
  let bestL:i32=0;
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    let elig:i32=ismap;
    if(elig==1 && native_only==1){ elig=adapt_is_native(W,m); }
    if(elig==1){
      let seq:[]u8=z_alloc(32);
      let L:i32=cc_relseq(W,m,seq,8);
      let sat:i32=0;
      if(L>=1){
        let vals:[]u8=z_alloc(40);
        let fids:[]u8=z_alloc(32);
        if(cc_satisfy(W,m,s,vals,fids)==L){ sat=1; }
      }
      if(sat==1 && L>bestL){ best=m; bestL=L; }
    }
    m=m+1;
  }
  return best;
}

// White-box chain description of MAP m from s: relation sequence
// seq[0..L-1], value chain vals[0..L], licensing facts fids[0..L-1].
// Returns L, or -1 when m is not a fully satisfiable chain.
fn rv_describe(W:[]u8,m:i32,s:i32,seq:[]u8,vals:[]u8,fids:[]u8)i32 {
  let L:i32=cc_relseq(W,m,seq,8);
  if(L<1){ return -1; }
  if(cc_satisfy(W,m,s,vals,fids)!=L){ return -1; }
  return L;
}

// Trace helper: emit the committed plan (fact id and (s,r,o)).
fn rv_emit_plan(W:[]u8,plan:i32)void {
  emit("RV-PLAN lic=");
  if(plan<0){ emit("-1\n"); return; }
  e64(plan); emit(" (");
  e64(ng(W,plan,20)); emit(","); e64(ng(W,plan,24)); emit(",");
  e64(ng(W,plan,28)); emit(")\n");
  return;
}

// One guarded extension step through the committed plan.
// Returns the new adapted MAP id, or -1 with rc[0] set:
// 1 NOFRONTIER, 2 EXECFAIL, 3 DUP. rc[4]=frontier, rc[8]=rnew,
// rc[12]=vnext on success. The entry liveness guard is the hard
// invariant: a superseded plan can never reach assembly.
fn rv_step(W:[]u8,s:i32,parent:i32,seq:[]u8,vals:[]u8,fids:[]u8,L:i32,plan:i32,rc:[]u8)i32 {
  set32(rc,0,0); set32(rc,4,0); set32(rc,8,0); set32(rc,12,0);
  if(plan<0){ set32(rc,0,1); return -1; }
  if(is_superseded(W,plan)==1){ set32(rc,0,2); return -1; }
  let fr:i32=get32(vals,L*4);
  set32(rc,4,fr);
  let rnew:i32=ng(W,plan,24);
  let vnext:i32=ng(W,plan,28);
  set32(rc,8,rnew); set32(rc,12,vnext);
  if(adapt_relseq_absent(W,seq,L,rnew)==0){ set32(rc,0,3); return -1; }
  let vv:[]u8=z_alloc(40);
  let ff:[]u8=z_alloc(32);
  let j:i32=0;
  while(j<=L){ set32(vv,j*4,get32(vals,j*4)); j=j+1; }
  set32(vv,(L+1)*4,vnext);
  j=0;
  while(j<L){ set32(ff,j*4,get32(fids,j*4)); j=j+1; }
  set32(ff,L*4,plan);
  let root:i32=t2_asm_chain(W,vv,L+2,ff);
  if(root<0){ set32(rc,0,2); return -1; }
  if(t2_exec(W,root,s)!=vnext){ set32(rc,0,2); return -1; }
  let af:[]u8=z_alloc(32);
  j=0;
  while(j<=L){ set32(af,j*4,get32(ff,j*4)); j=j+1; }
  let am:i32=adapt_promote(W,root,s,ng(W,parent,4),vnext,af,L+1);
  if(am<0){ set32(rc,0,2); return -1; }
  link_edge(W,am,16,parent,0);
  return am;
}

// EXTEND-REV: the claimed operator. No count parameter; the loop
// decides. After each extension the learner commits its next-step
// plan; the world hook may kill it; the stale check detects the
// kill, revises (re-route or clean EXECFAIL stop), and nothing is
// ever promoted through a dead fact.
// Returns the best terminal reached; out[0]=extensions,
// out[1]=stop reason (0 TERM, 1 NOFRONTIER, 2 EXECFAIL, 3 BUDGET),
// out[2]=final MAP id, out[3]=died fact id or -1,
// out[4]=replacement fact id or -1.
fn rv_extend_iter(W:[]u8,s:i32,expected:i32,out:[]u8)i32 {
  set32(out,0,0); set32(out,4,3); set32(out,8,-1);
  set32(out,12,-1); set32(out,16,-1);
  let m0:i32=rv_best_chain(W,s,1);
  if(m0<0){
    emit("RV-NONATIVE\n");
    return -3;
  }
  let seq:[]u8=z_alloc(32);
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  let L:i32=rv_describe(W,m0,s,seq,vals,fids);
  if(L<0){
    emit("RV-NODESCRIBE\n");
    return -3;
  }
  let term:i32=get32(vals,L*4);
  emit("RV-QUERY s="); e64(s); emit(" goal="); e64(expected);
  emit(" start="); e64(m0); emit(" startplen="); e64(L); emit("\n");
  let plan:i32=rv_lic_fact(W,term);
  rv_emit_plan(W,plan);
  let mcur:i32=m0;
  let ext:i32=0;
  let stop:i32=3;
  let done:i32=0;
  while(done==0){
    if(term==expected){ stop=0; done=1; }
    if(done==0 && ext>=8){ stop=3; done=1; }
    let stale:i32=0;
    if(done==0 && plan>=0){ stale=is_superseded(W,plan); }
    if(done==0 && plan>=0 && stale==1){
      emit("RV-REVISION died="); e64(plan); emit(" (");
      e64(ng(W,plan,20)); emit(","); e64(ng(W,plan,24)); emit(",");
      e64(ng(W,plan,28)); emit(") frontier="); e64(term); emit("\n");
      set32(out,12,plan);
      plan=rv_lic_fact(W,term);
      if(plan<0){ stop=2; done=1; }
      else {
        set32(out,16,plan);
        emit("RV-REROUTE new="); e64(plan); emit(" (");
        e64(ng(W,plan,20)); emit(","); e64(ng(W,plan,24)); emit(",");
        e64(ng(W,plan,28)); emit(")\n");
      }
    }
    if(done==0 && plan<0){
      plan=rv_lic_fact(W,term);
      if(plan<0){ stop=1; done=1; }
    }
    if(done==0){
      let rc:[]u8=z_alloc(16);
      let am:i32=rv_step(W,s,mcur,seq,vals,fids,L,plan,rc);
      let why:i32=get32(rc,0);
      if(am<0){ stop=why; done=1; }
      else {
        let nL:i32=rv_describe(W,am,s,seq,vals,fids);
        if(nL!=L+1){ stop=2; done=1; }
        else {
          emit("RV-STEP n="); e64(ext+1);
          emit(" parent="); e64(mcur);
          emit(" id="); e64(am);
          emit(" plen="); e64(L+1);
          emit(" lic="); e64(get32(rc,4)); emit(",");
          e64(get32(rc,8)); emit(","); e64(get32(rc,12));
          emit(" term="); e64(get32(rc,12)); emit("\n");
          L=nL; mcur=am; term=get32(vals,L*4); ext=ext+1;
          plan=rv_lic_fact(W,term);
          rv_emit_plan(W,plan);
          rv_world_step(W,ext,plan);
        }
      }
    }
  }
  emit("RV-STOP reason="); e64(stop);
  emit(" ext="); e64(ext);
  emit(" ans="); e64(term);
  emit(" final="); e64(mcur);
  emit(" died="); e64(get32(out,12));
  emit(" repl="); e64(get32(out,16)); emit("\n");
  set32(out,0,ext); set32(out,4,stop); set32(out,8,mcur);
  return term;
}

// ---- WORLD SCAFFOLD (disclosed world dynamics, not cognition) ----

// After the learner's 2nd successful extension, the world kills the
// fact the learner committed to use next (type-3 self-loop, the
// frozen supersede semantic). The learner is not told.
fn rv_world_step(W:[]u8,ext:i32,plan:i32)void {
  if(ext==2 && plan>=0){
    link_edge(W,plan,3,plan,0);
    emit("WORLD-KILL fact="); e64(plan); emit(" (");
    e64(ng(W,plan,20)); emit(","); e64(ng(W,plan,24)); emit(",");
    e64(ng(W,plan,28)); emit(") after-ext="); e64(ext); emit("\n");
  }
  return;
}

// ---- CONTROL SCAFFOLD (not the claimed operator) ----

// Unguarded step for the no-stale control: uses the committed plan
// blindly, even when superseded. This is what lets the control
// promote through the dead fact.
fn rv_step_blind(W:[]u8,s:i32,parent:i32,seq:[]u8,vals:[]u8,fids:[]u8,L:i32,plan:i32,rc:[]u8)i32 {
  set32(rc,0,0); set32(rc,4,0); set32(rc,8,0); set32(rc,12,0);
  if(plan<0){ set32(rc,0,1); return -1; }
  let fr:i32=get32(vals,L*4);
  set32(rc,4,fr);
  let rnew:i32=ng(W,plan,24);
  let vnext:i32=ng(W,plan,28);
  set32(rc,8,rnew); set32(rc,12,vnext);
  if(adapt_relseq_absent(W,seq,L,rnew)==0){ set32(rc,0,3); return -1; }
  let vv:[]u8=z_alloc(40);
  let ff:[]u8=z_alloc(32);
  let j:i32=0;
  while(j<=L){ set32(vv,j*4,get32(vals,j*4)); j=j+1; }
  set32(vv,(L+1)*4,vnext);
  j=0;
  while(j<L){ set32(ff,j*4,get32(fids,j*4)); j=j+1; }
  set32(ff,L*4,plan);
  let root:i32=t2_asm_chain(W,vv,L+2,ff);
  if(root<0){ set32(rc,0,2); return -1; }
  if(t2_exec(W,root,s)!=vnext){ set32(rc,0,2); return -1; }
  let af:[]u8=z_alloc(32);
  j=0;
  while(j<=L){ set32(af,j*4,get32(ff,j*4)); j=j+1; }
  let am:i32=adapt_promote(W,root,s,ng(W,parent,4),vnext,af,L+1);
  if(am<0){ set32(rc,0,2); return -1; }
  link_edge(W,am,16,parent,0);
  return am;
}

// C1: no-stale-check control. Identical loop to the operator except
// the stale check / revision block and the step entry guard are
// removed. The world still kills the committed plan after ext 2.
fn rv_extend_iter_nostale(W:[]u8,s:i32,expected:i32,out:[]u8)i32 {
  set32(out,0,0); set32(out,4,3); set32(out,8,-1);
  set32(out,12,-1); set32(out,16,-1);
  let m0:i32=rv_best_chain(W,s,1);
  if(m0<0){
    emit("RV-NONATIVE\n");
    return -3;
  }
  let seq:[]u8=z_alloc(32);
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  let L:i32=rv_describe(W,m0,s,seq,vals,fids);
  if(L<0){
    emit("RV-NODESCRIBE\n");
    return -3;
  }
  let term:i32=get32(vals,L*4);
  emit("RV-QUERY s="); e64(s); emit(" goal="); e64(expected);
  emit(" start="); e64(m0); emit(" startplen="); e64(L); emit("\n");
  let plan:i32=rv_lic_fact(W,term);
  rv_emit_plan(W,plan);
  let mcur:i32=m0;
  let ext:i32=0;
  let stop:i32=3;
  let done:i32=0;
  while(done==0){
    if(term==expected){ stop=0; done=1; }
    if(done==0 && ext>=8){ stop=3; done=1; }
    if(done==0 && plan<0){
      plan=rv_lic_fact(W,term);
      if(plan<0){ stop=1; done=1; }
    }
    if(done==0){
      let rc:[]u8=z_alloc(16);
      let am:i32=rv_step_blind(W,s,mcur,seq,vals,fids,L,plan,rc);
      let why:i32=get32(rc,0);
      if(am<0){ stop=why; done=1; }
      else {
        let nL:i32=rv_describe(W,am,s,seq,vals,fids);
        if(nL!=L+1){ stop=2; done=1; }
        else {
          emit("RV-STEP n="); e64(ext+1);
          emit(" parent="); e64(mcur);
          emit(" id="); e64(am);
          emit(" plen="); e64(L+1);
          emit(" lic="); e64(get32(rc,4)); emit(",");
          e64(get32(rc,8)); emit(","); e64(get32(rc,12));
          emit(" term="); e64(get32(rc,12)); emit("\n");
          L=nL; mcur=am; term=get32(vals,L*4); ext=ext+1;
          plan=rv_lic_fact(W,term);
          rv_emit_plan(W,plan);
          rv_world_step(W,ext,plan);
        }
      }
    }
  }
  emit("RV-STOP reason="); e64(stop);
  emit(" ext="); e64(ext);
  emit(" ans="); e64(term);
  emit(" final="); e64(mcur); emit("\n");
  set32(out,0,ext); set32(out,4,stop); set32(out,8,mcur);
  return term;
}

// C2: fresh learner. No native MAP is taught; the only tool is the
// frozen generic miss policy t2_trial.
fn rv_ctrl_fresh(W:[]u8,s:i32,expected:i32)i32 {
  return t2_trial(W,s,1,expected,0,0,0);
}

// ---- PRIOR-KNOWLEDGE AND AUDIT SCAFFOLD (not cognition) ----

// Teach a native MAP with relation sequence seq[0..L-1] walkable
// from s. No type-16 edge: it is native. No fact is taught.
fn rv_mk_native(W:[]u8,s:i32,seq:[]u8,L:i32)i32 {
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  set32(vals,0,s);
  let cur:i32=s;
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    let fnd:i32=t2_lu_first(W,cur,get32(seq,i*4));
    if(fnd<0){ ok=0; }
    else {
      set32(vals,(i+1)*4,ng(W,fnd,28));
      set32(fids,i*4,fnd);
      cur=ng(W,fnd,28);
    }
    i=i+1;
  }
  if(ok==0){ return -1; }
  let root:i32=t2_asm_chain(W,vals,L+1,fids);
  if(root<0){ return -1; }
  let am:i32=adapt_promote(W,root,s,get32(seq,0),cur,fids,L);
  emit("RV-NATIVE id="); e64(am); emit(" plen="); e64(L);
  emit(" term="); e64(cur); emit("\n");
  return am;
}

// type-16 adapted-from target of MAP a, or -1.
fn rv_src16(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){ return eg(W,e,8); }
    e=e+1;
  }
  return -1;
}

// Hops on type-16 edges from fin back to a native MAP; -1 broken.
fn rv_hops_to_native(W:[]u8,fin:i32)i32 {
  let hops:i32=0;
  let cur:i32=fin;
  let guard:i32=0;
  let broken:i32=0;
  while(guard<16){
    if(adapt_is_native(W,cur)==1){ guard=16; }
    else {
      let p:i32=rv_src16(W,cur);
      if(p<0){ broken=1; guard=16; }
      else { cur=p; hops=hops+1; guard=guard+1; }
    }
  }
  if(broken==1){ return -1; }
  return hops;
}

// Ultimate native ancestor of fin via type-16 hops; -1 broken.
fn rv_ult_native(W:[]u8,fin:i32)i32 {
  let cur:i32=fin;
  let guard:i32=0;
  while(guard<16){
    if(adapt_is_native(W,cur)==1){ return cur; }
    let p:i32=rv_src16(W,cur);
    if(p<0){ return -1; }
    cur=p; guard=guard+1;
  }
  return -1;
}

// 1 iff MAP m's relation sequence equals exp[0..L-1].
fn rv_relseq_eq(W:[]u8,m:i32,exp:[]u8,L:i32)i32 {
  let seq:[]u8=z_alloc(32);
  let got:i32=cc_relseq(W,m,seq,8);
  if(got!=L){ return 0; }
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    if(get32(seq,i*4)!=get32(exp,i*4)){ ok=0; }
    i=i+1;
  }
  return ok;
}

// Count of live adapted MAPs (outgoing type-16 edge).
fn rv_count_adapted(W:[]u8)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    if(ismap==1 && adapt_is_native(W,m)==0){ c=c+1; }
    m=m+1;
  }
  return c;
}

// Audit one MAP: 0 iff its relation sequence is satisfiable from s,
// every licensing fact is live (not superseded), and its root graph
// executes end-to-end to its terminal. 1 on any violation.
fn rv_audit_one(W:[]u8,m:i32,s:i32)i32 {
  let seq:[]u8=z_alloc(32);
  let L:i32=cc_relseq(W,m,seq,8);
  if(L<1){ return 1; }
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  if(cc_satisfy(W,m,s,vals,fids)!=L){ return 1; }
  let j:i32=0;
  let dead:i32=0;
  while(j<L){
    if(is_superseded(W,get32(fids,j*4))==1){ dead=1; }
    j=j+1;
  }
  if(dead==1){ return 1; }
  let term:i32=get32(vals,L*4);
  if(t2_exec(W,ng(W,m,20),s)!=term){ return 1; }
  return 0;
}

// K5 audit: walk the type-16 provenance chain from fin back to the
// native MAP; audit every MAP. Returns the number of MAPs audited,
// or -1 on the first violation (dead licensing fact, exec
// mismatch, or broken provenance).
fn rv_audit_live(W:[]u8,fin:i32,s:i32)i32 {
  let checked:i32=0;
  let cur:i32=fin;
  let guard:i32=0;
  let bad:i32=0;
  while(guard<16 && bad==0){
    bad=rv_audit_one(W,cur,s);
    if(bad==0){
      checked=checked+1;
      if(adapt_is_native(W,cur)==1){ guard=16; }
      else {
        let p:i32=rv_src16(W,cur);
        if(p<0){ bad=1; }
        else { cur=p; guard=guard+1; }
      }
    }
  }
  if(bad==1){ return -1; }
  return checked;
}

// First superseded licensing fact of MAP m's chain from s, or -1.
fn rv_find_dead(W:[]u8,m:i32,s:i32)i32 {
  let seq:[]u8=z_alloc(32);
  let L:i32=cc_relseq(W,m,seq,8);
  if(L<1){ return -1; }
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  if(cc_satisfy(W,m,s,vals,fids)!=L){ return -1; }
  let j:i32=0;
  while(j<L){
    let f:i32=get32(fids,j*4);
    if(is_superseded(W,f)==1){ return f; }
    j=j+1;
  }
  return -1;
}

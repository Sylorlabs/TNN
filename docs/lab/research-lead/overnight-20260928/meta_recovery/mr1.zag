// mr1.zag -- MR1 experiment. Neutral identifiers only.
// 732 episodes; hidden integer parameter p per episode.
// Episodes 1-12 (block D): 9 use p = permutation of {16..24};
//   3 (idx 3,7,11) use p = permutation of {40,47,54}.
// Episodes 13-732 (block R): 720 episodes = 80 cycles of 9, each cycle
//   a permutation of {76..84} (mean exactly 80 per cycle).
// Examples: 1200 binary outcomes per episode per arm; outcome=1
// iff draw < p. Streams are independent per arm (fresh seeds).
// Estimator: est_n = (w*m + 100*h)/(w+n), w=20; m = mean of past p
// (accumulating unit) or 50 (reset unit). Criterion: |est_n - p| < 5,
// smallest n in 1..1200, else 1201.
// Arms: T accumulates from episode 0; F resets during block D then
//   accumulates from block-R episode 1; C resets every episode.
// Output: single preallocated buffer, one raw-syscall write.

// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access (u8-backed cells) ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
fn fhash(G:[]u8,base:i32)i64 {
  let h:i64=2166136261;
  let k:i32=0;
  while(k<1200){
    h=((h^((G[base+k]) as i64))*16777619)&4294967295;
    k=k+1;
  }
  return h;
}
// ---- episode production (frozen) ----
// G layout: 0 prng(8) | 8 pT[732](2928) | 2936 pF[732](2928) |
// 5864 pC[732](2928) | 8792 fT[878400] | 887192 fF[878400] |
// 1765592 fC[878400] | 2643992 eT[732](2928) | 2646920 eF[732](2928) |
// 2649848 eC[732](2928) | 2652776 genfail(4) | 2652780 mTtraj[720](2880) |
// 2655660 mFtraj[720](2880) | 2658540 medscratch[720](2880) |
// 2661420 hashvec[2196](8784) | 2670204 tmp9(36) | 2670240 tmp3(12) |
// 2670252 cyc9(36)
fn gen(G:[]u8)void {
  s64(G,0,20261016);
  let i:i32=0;
  while(i<9){ set32(G,2670204+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,2670204+i*4);
    set32(G,2670204+i*4,get32(G,2670204+j*4));
    set32(G,2670204+j*4,a);
    i=i+1;
  }
  set32(G,2670240,40); set32(G,2670244,47); set32(G,2670248,54);
  i=0;
  while(i<3){
    let j2:i32=i+rnd(G,3-i);
    let a2:i32=get32(G,2670240+i*4);
    set32(G,2670240+i*4,get32(G,2670240+j2*4));
    set32(G,2670240+j2*4,a2);
    i=i+1;
  }
  let sd:i32=0;
  let e:i32=0;
  while(e<12){
    let v:i32=0;
    if(e==3){ v=get32(G,2670240); }
    else {
      if(e==7){ v=get32(G,2670244); }
      else {
        if(e==11){ v=get32(G,2670248); }
        else { v=get32(G,2670204+sd*4); sd=sd+1; }
      }
    }
    set32(G,8+e*4,v);
    e=e+1;
  }
  let c:i32=0;
  while(c<80){
    i=0;
    while(i<9){ set32(G,2670252+i*4,76+i); i=i+1; }
    i=0;
    while(i<9){
      let j3:i32=i+rnd(G,9-i);
      let a3:i32=get32(G,2670252+i*4);
      set32(G,2670252+i*4,get32(G,2670252+j3*4));
      set32(G,2670252+j3*4,a3);
      i=i+1;
    }
    let j4:i32=0;
    while(j4<9){
      set32(G,8+(12+c*9+j4)*4,get32(G,2670252+j4*4));
      j4=j4+1;
    }
    c=c+1;
  }
  e=0;
  while(e<732){
    let pv:i32=get32(G,8+e*4);
    set32(G,2936+e*4,pv);
    set32(G,5864+e*4,pv);
    e=e+1;
  }
  s64(G,0,20261017);
  e=0;
  while(e<732){
    let pv2:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let fl:i32=0;
      if(d<pv2){ fl=1; }
      G[8792+e*1200+k]=fl as u8;
      k=k+1;
    }
    e=e+1;
  }
  s64(G,0,20261018);
  e=0;
  while(e<732){
    let pv3:i32=get32(G,8+e*4);
    let k2:i32=0;
    while(k2<1200){
      let d2:i32=rnd(G,100);
      let fl2:i32=0;
      if(d2<pv3){ fl2=1; }
      G[887192+e*1200+k2]=fl2 as u8;
      k2=k2+1;
    }
    e=e+1;
  }
  s64(G,0,20261019);
  e=0;
  while(e<732){
    let pv4:i32=get32(G,8+e*4);
    let k3:i32=0;
    while(k3<1200){
      let d3:i32=rnd(G,100);
      let fl3:i32=0;
      if(d3<pv4){ fl3=1; }
      G[1765592+e*1200+k3]=fl3 as u8;
      k3=k3+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode ----
// m: current mean (hundredths). Returns smallest n in 1..1200 with
// |est_n - p| < 5, else 1201. Exact integer comparison, no division.
// Byte-identical to the frozen md1.zag / lm2.zag.
fn etc_ep(G:[]u8,e:i32,m:i32,fbase:i32,pbase:i32)i32 {
  let mi:i64=m as i64;
  let pi:i64=get32(G,pbase+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=1200){
    h=h+(G[fbase+e*1200+n-1] as i64);
    let num:i64=20*mi+100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<5*den){ return n; }
    n=n+1;
  }
  return 1201;
}
// ---- run one arm over the 732 episodes ----
// accfrom: first episode index that accumulates (T: 0, F: 12, C: 9999).
// The update takes ONLY the revealed p as input. mtraj >= 0 records m
// entering each block-R episode (harness instrumentation only).
fn run_cond(G:[]u8,eoff:i32,accfrom:i32,fbase:i32,pbase:i32,mtraj:i32)void {
  let sum:i32=0;
  let cnt:i32=0;
  let e:i32=0;
  while(e<732){
    let m:i32=50;
    if(e>=accfrom){
      if(cnt>0){ m=sum/cnt; }
    }
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    if(e>=accfrom){
      sum=sum+get32(G,pbase+e*4);
      cnt=cnt+1;
    }
    if(e>=12){
      if(mtraj>=0){ set32(G,mtraj+(e-12)*4,m); }
    }
    e=e+1;
  }
  return;
}
fn main()i32 {
  let p:*u8=_zag_malloc(4194304) as *u8;
  let G:[]u8=p[0..4194304];
  let z:i32=0;
  while(z<4194304){ G[z]=0; z=z+1; }
  gen(G);
  run_cond(G,2643992,0,8792,8,2652780);
  run_cond(G,2646920,12,887192,2936,2655660);
  run_cond(G,2649848,9999,1765592,5864,-1);
  let advlate:i64=0;
  let stflate:i64=0;
  let scflate:i64=0;
  let costtf:i64=0;
  let e:i32=642;
  while(e<732){
    let dt:i64=(get32(G,2643992+e*4) as i64);
    let df:i64=(get32(G,2646920+e*4) as i64);
    let dc:i64=(get32(G,2649848+e*4) as i64);
    advlate=advlate+(dc-dt);
    stflate=stflate+(dt-df);
    scflate=scflate+(dc-df);
    e=e+1;
  }
  e=12;
  while(e<732){
    costtf=costtf+((get32(G,2643992+e*4) as i64)-(get32(G,2646920+e*4) as i64));
    e=e+1;
  }
  let advd:i64=0;
  let advod:i64=0;
  e=0;
  while(e<12){
    let dd:i64=(get32(G,2649848+e*4) as i64)-(get32(G,2643992+e*4) as i64);
    let typ:i32=1;
    if(e==3){ typ=0; }
    if(e==7){ typ=0; }
    if(e==11){ typ=0; }
    if(typ==1){ advd=advd+dd; }
    else { advod=advod+dd; }
    e=e+1;
  }
  let advr9:i64=0;
  e=12;
  while(e<21){
    advr9=advr9+((get32(G,2649848+e*4) as i64)-(get32(G,2643992+e*4) as i64));
    e=e+1;
  }
  // median of 720 control block-R etc values
  e=12;
  while(e<732){ set32(G,2658540+(e-12)*4,get32(G,2649848+e*4)); e=e+1; }
  let i2:i32=0;
  while(i2<720){
    let j:i32=0;
    while(j<719-i2){
      let a:i32=get32(G,2658540+j*4);
      let b:i32=get32(G,2658540+(j+1)*4);
      if(a>b){ set32(G,2658540+j*4,b); set32(G,2658540+(j+1)*4,a); }
      j=j+1;
    }
    i2=i2+1;
  }
  let medcr:i64=get32(G,2658540+360*4) as i64;
  // milestones from the T trajectory
  let k75:i64=0; let k78:i64=0; let k79:i64=0;
  let kk:i32=1;
  while(kk<=720){
    let mt:i64=get32(G,2652780+(kk-1)*4) as i64;
    if(k75==0){ if(mt>=75){ k75=kk as i64; } }
    if(k78==0){ if(mt>=78){ k78=kk as i64; } }
    if(k79==0){ if(mt>=79){ k79=kk as i64; } }
    kk=kk+1;
  }
  let mx:i64=0;
  e=0;
  while(e<732){
    let a2:i64=get32(G,2643992+e*4) as i64;
    if(a2>mx){ mx=a2; }
    let b2:i64=get32(G,2646920+e*4) as i64;
    if(b2>mx){ mx=b2; }
    let c2:i64=get32(G,2649848+e*4) as i64;
    if(c2>mx){ mx=c2; }
    e=e+1;
  }
  // B4: 12 block-D parameters distinct
  let dbd:i32=1;
  i2=0;
  while(i2<12){
    let j5:i32=i2+1;
    while(j5<12){
      if(get32(G,8+i2*4)==get32(G,8+j5*4)){ dbd=0; }
      j5=j5+1;
    }
    i2=i2+1;
  }
  // B4: each block-R 9-cycle internally distinct
  let cyd:i32=1;
  let c3:i32=0;
  while(c3<80){
    let u:i32=0;
    while(u<9){
      let w2:i32=u+1;
      while(w2<9){
        if(get32(G,8+(12+c3*9+u)*4)==get32(G,8+(12+c3*9+w2)*4)){ cyd=0; }
        w2=w2+1;
      }
      u=u+1;
    }
    c3=c3+1;
  }
  // B4: 2196 outcome vectors pairwise distinct (FNV-1a + byte fallback)
  let v:i32=0;
  while(v<2196){
    let arm:i32=v/732;
    let ep:i32=v-732*arm;
    let base:i32=8792+arm*878400+ep*1200;
    s64(G,2661420+v*4,fhash(G,base));
    v=v+1;
  }
  let df:i32=1;
  let v1:i32=0;
  while(v1<2196){
    let v2:i32=v1+1;
    while(v2<2196){
      if(g64(G,2661420+v1*4)==g64(G,2661420+v2*4)){
        let a1:i32=v1/732; let e1:i32=v1-732*a1;
        let b1:i32=8792+a1*878400+e1*1200;
        let a3:i32=v2/732; let e3:i32=v2-732*a3;
        let b3:i32=8792+a3*878400+e3*1200;
        if(veq(G,b1,b3,1200)==1){ df=0; }
      }
      v2=v2+1;
    }
    v1=v1+1;
  }
  // B5f: parameter identity across arms
  let bid:i32=1;
  e=0;
  while(e<732){
    if(get32(G,8+e*4)!=get32(G,2936+e*4)){ bid=0; }
    if(get32(G,8+e*4)!=get32(G,5864+e*4)){ bid=0; }
    e=e+1;
  }
  let oT:i64=0;
  let oF:i64=0;
  let oC:i64=0;
  let k4:i32=0;
  while(k4<878400){
    oT=oT+(G[8792+k4] as i64);
    oF=oF+(G[887192+k4] as i64);
    oC=oC+(G[1765592+k4] as i64);
    k4=k4+1;
  }
  let mg:i32=0;
  if(oT>=677000){ if(oT<=713000){ if(oF>=677000){ if(oF<=713000){ if(oC>=677000){ if(oC<=713000){ mg=1; } } } } } }
  // bars
  let b5a:i32=0; if(advlate>=6000){ b5a=1; }
  let b5b:i32=0; if(scflate>3000){ if(10*stflate<=scflate){ b5b=1; } }
  let b5c:i32=0; if(advd>=365){ b5c=1; }
  let b5d:i32=0; if(advr9<=0){ b5d=1; }
  let b5e:i32=0; if(medcr>=25){ b5e=1; }
  let b5f:i32=0; if(bid==1){ if(df==1){ if(mg==1){ b5f=1; } } }
  let b5g:i32=0; if(get32(G,2652776)==0){ b5g=1; }
  let q:*u8=_zag_malloc(262144) as *u8;
  let B:[]u8=q[0..262144];
  let c4:i32=0;
  c4=o_app(B,c4,"MR1 SEEDB=20261016 SEEDT=20261017 SEEDF=20261018 SEEDC=20261019 W=20 TOL=5 N=1200 NE=732"); c4=o_nl(B,c4);
  e=0;
  while(e<732){
    c4=o_app(B,c4,"E");
    if(e<9){ c4=o_app(B,c4,"00"); }
    else { if(e<99){ c4=o_app(B,c4,"0"); } }
    c4=o_i64(B,c4,(e+1) as i64);
    c4=o_app(B,c4," P=");
    c4=o_i64(B,c4,get32(G,8+e*4) as i64);
    c4=o_app(B,c4," ET=");
    c4=o_i64(B,c4,get32(G,2643992+e*4) as i64);
    c4=o_app(B,c4," EF=");
    c4=o_i64(B,c4,get32(G,2646920+e*4) as i64);
    c4=o_app(B,c4," EC=");
    c4=o_i64(B,c4,get32(G,2649848+e*4) as i64);
    c4=o_nl(B,c4);
    e=e+1;
  }
  let cy:i32=9;
  while(cy<=720){
    c4=o_app(B,c4,"K="); c4=o_i64(B,c4,cy as i64);
    c4=o_app(B,c4," MT="); c4=o_i64(B,c4,get32(G,2652780+(cy-1)*4) as i64);
    c4=o_app(B,c4," MF="); c4=o_i64(B,c4,get32(G,2655660+(cy-1)*4) as i64);
    c4=o_nl(B,c4);
    cy=cy+9;
  }
  c4=o_app(B,c4,"ADV_LATE="); c4=o_i64(B,c4,advlate);
  c4=o_app(B,c4," STF_LATE="); c4=o_i64(B,c4,stflate);
  c4=o_app(B,c4," SCF_LATE="); c4=o_i64(B,c4,scflate);
  c4=o_app(B,c4," ADV_D="); c4=o_i64(B,c4,advd);
  c4=o_app(B,c4," ADV_OD="); c4=o_i64(B,c4,advod);
  c4=o_app(B,c4," ADV_R9="); c4=o_i64(B,c4,advr9);
  c4=o_app(B,c4," MEDCR="); c4=o_i64(B,c4,medcr);
  c4=o_app(B,c4," COST_TF="); c4=o_i64(B,c4,costtf);
  c4=o_app(B,c4," MAXETC="); c4=o_i64(B,c4,mx);
  c4=o_nl(B,c4);
  c4=o_app(B,c4,"K75="); c4=o_i64(B,c4,k75);
  c4=o_app(B,c4," K78="); c4=o_i64(B,c4,k78);
  c4=o_app(B,c4," K79="); c4=o_i64(B,c4,k79);
  c4=o_app(B,c4," ONES="); c4=o_i64(B,c4,oT);
  c4=o_app(B,c4,"/"); c4=o_i64(B,c4,oF);
  c4=o_app(B,c4,"/"); c4=o_i64(B,c4,oC);
  c4=o_nl(B,c4);
  c4=o_app(B,c4,"B5A="); c4=o_i64(B,c4,b5a as i64);
  c4=o_app(B,c4," B5B="); c4=o_i64(B,c4,b5b as i64);
  c4=o_app(B,c4," B5C="); c4=o_i64(B,c4,b5c as i64);
  c4=o_app(B,c4," B5D="); c4=o_i64(B,c4,b5d as i64);
  c4=o_app(B,c4," B5E="); c4=o_i64(B,c4,b5e as i64);
  c4=o_app(B,c4," B5F="); c4=o_i64(B,c4,b5f as i64);
  c4=o_app(B,c4," B5G="); c4=o_i64(B,c4,b5g as i64);
  c4=o_nl(B,c4);
  c4=o_app(B,c4,"DISTINCTBD="); c4=o_i64(B,c4,dbd as i64);
  c4=o_app(B,c4," CYCDIST="); c4=o_i64(B,c4,cyd as i64);
  c4=o_app(B,c4," DISTINCTF="); c4=o_i64(B,c4,df as i64);
  c4=o_app(B,c4," PARID="); c4=o_i64(B,c4,bid as i64);
  c4=o_app(B,c4," MARG="); c4=o_i64(B,c4,mg as i64);
  c4=o_app(B,c4," GENFAIL="); c4=o_i64(B,c4,get32(G,2652776) as i64);
  c4=o_nl(B,c4);
  o_flush(B,c4);
  return 0;
}

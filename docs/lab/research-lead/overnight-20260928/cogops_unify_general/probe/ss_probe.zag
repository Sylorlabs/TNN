// =====================================================================
// SS-STATE PROBE (C503, M3). Appended to the frozen 1331-line prefix.
//
// Records, at EVERY strat_sel call, the COMPLETE vector of learner-state
// cells that strat_sel reads, plus the value it returns:
//
//   tried, slot, rt=L[16680], rc=L[16684],
//   (uses,wins,cost) for s=1..4 in that slot,  ->  best
//
// strat_sel reads no other cell. If two incumbents are handed the SAME
// recorded vector and return DIFFERENT values, then no single-valued
// function of learner state can be both, and the family contains a
// pointwise contradiction. This probe is what turns that argument from
// an assertion into a measurement.
// =====================================================================
fn SSPATH()[]u8 { return "/tmp/cogops_unify_ss.txt"; }
fn ss_emit(b:[]u8,n:i32)void {
  let old:[]u8="";
  if(_zag_file_exists(SSPATH())){ old=_zag_read_file(SSPATH()); }
  let ol:i32=old.len;
  let tot:i32=ol+n;
  let nb:[]u8=z_alloc(tot);
  let i:i32=0;
  while(i<ol){ nb[i]=old[i]; i=i+1; }
  let j:i32=0;
  while(j<n){ nb[ol+j]=b[j]; j=j+1; }
  _zag_write_file(SSPATH(),nb);
  return;
}
fn ss_row(L:[]u8,b:[]u8,c:i32,s:i32,slot:i32)i32 {
  let b0:i32=cx_base(slot)+(s-1)*12;
  c=o_app(b,c," ");
  c=o_i64(b,c,s as i64);
  c=o_app(b,c,":");
  c=o_i64(b,c,get32(L,b0) as i64);
  c=o_app(b,c,",");
  c=o_i64(b,c,get32(L,b0+4) as i64);
  c=o_app(b,c,",");
  c=o_i64(b,c,get32(L,b0+8) as i64);
  return c;
}
fn ss_log(L:[]u8,tried:i32,slot:i32,best:i32)void {
  let b:[]u8=z_alloc(256);
  let c:i32=0;
  c=o_app(b,c,"SS tried=");
  c=o_i64(b,c,tried as i64);
  c=o_app(b,c," slot=");
  c=o_i64(b,c,slot as i64);
  c=o_app(b,c," rt=");
  c=o_i64(b,c,get32(L,16680) as i64);
  c=o_app(b,c," rc=");
  c=o_i64(b,c,get32(L,16684) as i64);
  let s:i32=1;
  while(s<5){ c=ss_row(L,b,c,s,slot); s=s+1; }
  c=o_app(b,c," -> best=");
  c=o_i64(b,c,best as i64);
  c=o_nl(b,c);
  ss_emit(b,c);
  return;
}

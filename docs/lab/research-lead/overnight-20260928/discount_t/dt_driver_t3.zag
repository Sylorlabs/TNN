// ===== DISCOUNT T-SENSITIVITY DRIVER =====
// Appended to dt_variant_tN.zag (frozen base, original test main removed,
// bootstrap_miss replaced by the D1+D2+W3+R1 discount pilot at threshold
// 3). Replays the contradiction-break battery (510b6cb42) Phases 1-5
// identically to the pilot (0daaa2ed4), then adds Phase 6: a SECOND
// contradiction on a fresh subject, measuring exclusion latency of the new
// fact. This tests repeated-novelty handling and confirms the T+1 bound
// holds for subsequent incidents.
//
// R1: evidence scan skips FACTs with discount > 3.
// Predicted Phase 4 (first incident): first success at b_{T+1}
//   (T+1 failed bootstraps). Predicted Phase 6 (second incident):
//   first success at f_{T+1} (T+1 failed bootstraps).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Evidence scan with discount: replicate the pilot bootstrap_miss window
// (most-recent-first, live tag-1, relation r, cap 6, R1 exclusion at
// discount > 3). Display only; production scan is in bootstrap_miss.
fn scan_d(W:[]u8,p:[]u8,r:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=3){
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit(" d"); e64(ng(W,n,12)); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

fn dt_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Phase 1: 3 genuine seeds, value 42.
  let g1:i32=ev_teach(W,1001,50,42); rep("T3","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("T3","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("T3","g3",g3);
  // Phase 2: establish the loop with 4 fresh-subject queries. Expect 42.
  let i:i32=0;
  while(i<4){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("T3"); emit(" q"); e64(i); emit("="); e64(q); emit("\n");
    i=i+1;
  }
  // Phase 3: CONTRADICTION via ev_teach(3001,50,99).
  let cx:i32=ev_teach(W,3001,50,99); rep("T3","contra_idx",cx);
  emit("T3"); emit(" contra_disc="); e64(ng(W,cx,12)); emit("\n");
  emit("T3"); emit(" CONTRA-TAUGHT\n");
  scan_d(W,"T3",50,50);
  // Phase 4: 6 fresh queries. Predict: b0..bT = -2 (discount 1..T+1),
  // then b_{T+1} = 42 (recovery), rest 42 (loop resumed).
  i=0;
  while(i<6){
    let q2:i32=ev_query(W,2005+i,50,-2,0);
    emit("T3"); emit(" b"); e64(i); emit("="); e64(q2);
    emit(" contra_disc="); e64(ng(W,cx,12)); emit("\n");
    scan_d(W,"T3",50,60+i);
    i=i+1;
  }
  // Phase 5: persistence of recovery. 2 more fresh queries. Expect 42.
  i=0;
  while(i<2){
    let q3:i32=ev_query(W,2011+i,50,-2,0);
    emit("T3"); emit(" p"); e64(i); emit("="); e64(q3); emit("\n");
    i=i+1;
  }
  emit("T3"); emit(" final_contra_disc="); e64(ng(W,cx,12)); emit("\n");
  // Phase 6 (extension): SECOND contradiction on a fresh subject.
  // Predict: f0..fT = -2 (new fact discount 1..T+1), then f_{T+1} = 42.
  let ncx:i32=ev_teach(W,6001,50,99); rep("T3","ncontra_idx",ncx);
  emit("T3"); emit(" NCONTRA-TAUGHT\n");
  i=0;
  while(i<8){
    let q4:i32=ev_query(W,6011+i,50,-2,0);
    emit("T3"); emit(" f"); e64(i); emit("="); e64(q4);
    emit(" ncontra_disc="); e64(ng(W,ncx,12)); emit("\n");
    scan_d(W,"T3",50,70+i);
    i=i+1;
  }
  emit("T3"); emit(" final_ncontra_disc="); e64(ng(W,ncx,12)); emit("\n");
  emit("DISCOUNT-T-DONE\n");
  return 0;
}
fn main()i32 { return dt_main(); }

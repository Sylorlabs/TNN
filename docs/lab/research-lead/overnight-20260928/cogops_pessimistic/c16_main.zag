// c15_main.zag -- driver for the cogops-rescueaware battery.
// Rescue-aware expected-cost strategy selection: each
// learner-computed goal context (nneeds, need-1 relation field)
// keeps its own strategy table; strat_sel picks by
//   score_s = E[turn_s] + P(fail_s) * E[rescue]
// argmin within the current context's table, where
// E[turn_s]=(c+2)/(u+2), P(fail_s)=(u-w+1)/(u+2), and
// E[rescue]=(rt+2)/(rc+2) from the learner's global rescue
// ledger. P(success) does NOT cancel: the failure probability
// re-enters through the rescue term. Stages
// per PREREG Section 5: S1A/S1B (world A learning), S2 (world D),
// S3 (goal 818: cold strategy table, default PW by id tie-break),
// S4 (world E), S5 (goal 820: context (3,613) cold, PW leads by id
// and wins in 1 CMP; the cheap-untried promotion does NOT cross
// contexts), S6L (world C), S6B (world F setup + re-specialize),
// S7 (goal 822, partial: context (4,613) cold, PW leads, fails,
// WHOLE fails, NEED rescues and wins; rescue ledger (6,2)),
// S8 (goal 823: context (4,613) carries S7; ALT untried scores
// rescue-aware 8.0, strictly cheapest, and leads; the
// P(fail)=1/2 * E[rescue]=2.0 term does NOT price away the
// promotion; ALT wins via NEED-form, no rescue observed),
// S9 (goal 821, period-3: context (3,615) cold, PW leads by id,
// fails, WHOLE rescues and wins at lag 3), S10 (goal 816,
// convergent: context (3,604) cold, PW leads; cascade
// PW->WHOLE->NEED->ALT, all fail, generic fallback, oracle
// agreement), S9B (goal 822 again: stored checker APPLY succeeds
// at match=3/3, outcome reuse), S11 (goal 823: strategy-table
// lesion, zeroed context, PW default cascade, NEED wins),
// S12 (goal 823: lesioned context table; NEED is the strict
// rescue-aware argmin (147/7 < 97/4: the rescue term rewards
// NEED's lower P(fail)), leads and wins at pass 2 in 4 events;
// the hedge does not fire), S13 (goal 824, world E, period-3:
// lesioned table, WHOLE untried is the strict argmin, leads
// outright and fails at pass 2, ALT rescues at lag 3),
// S14 (goal 825, world E, lag-2 full: lesioned table, WHOLE is
// the STRICT rescue-aware argmin, leads and wins in 1 CMP).
// All dynamic output goes through the single preallocated
// buffer B, flushed once at the end. The summary adds one
// learner-state line: RESCUE total=<rt> count=<rc>.
// Harness file: pattern and goal ids appear here (the c9_main
// precedent); c11_learn.zag carries zero literals.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-VFY rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,8480) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,8484) as i64);
  c=o_app(b,c," nfacts=");

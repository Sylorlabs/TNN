// learner.zag -- LPROBE learner: PPROBE proactive contract machinery
// plus LEARNER-CHOSEN probe inputs. When a probe round is needed, the
// learner scores every candidate in the driver-supplied open pool from
// its own state (boundary proximity to the held contract + novelty
// against its own experience) and selects PROBE_BUDGET=3 of them.
// The pool carries inputs only; labels stay with the world. Pure Zag.
//
// State (one u8 buffer, 1024 bytes):
//   0: XN  1: REV_PTR  2: REVISION_ENABLED  3: PROBE_ENABLED  7: C_Q
//   8+n*8: episode n (id, s0..s5, label), 32 max
//   500: CONTRACT_TY  501: C_SLOT  502: C_THRESH  503: CONTRACT_SET
//   504: C_FAIL_RUN  505: C_REV_REQ  506..509: C_REV_COUNT
//   510..513: C_FIRST_DETECT_Q  514..517: C_CORRECT  518..521: C_TOTAL
//   522..525: C_FIT_ERR  530..533: C_OLDERR_ON_NEW
//   534..537: C_PROBES  538..541: C_PROBE_FAILS
//   542..545: C_HS_COMMITS  546..549: C_HS_FAILS
//   550..553: C_PROBE_SEQ  554..557: C_REVISE_SEQ  558..561: C_COMMIT_SEQ
//   562: PROBE_FRESH  563..566: SEQ  567..570: C_UNPROBED
//   583: C_CHOSEN_N  584: CHOICE_ENABLED
//   585..588: C_CHOICE0  589..592: C_CHOICE1  593..596: C_CHOICE2

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

fn x_teach(st:[]u8, id:i32, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32, label:i32)void {
  let n:i32=st[0] as i32;
  if(n>=32){return;}
  let o:i32=8+n*8;
  st[o]=id as u8;
  st[o+1]=s0 as u8; st[o+2]=s1 as u8; st[o+3]=s2 as u8;
  st[o+4]=s3 as u8; st[o+5]=s4 as u8; st[o+6]=s5 as u8;
  st[o+7]=label as u8;
  st[0]=(n+1) as u8;
  return;
}

// Generic first fit over the window [REV_PTR, XN). Frozen scan order:
// slot 0..5, threshold 1..3. First candidate with strictly fewer errors
// wins (scan order tiebreak). No semantic cases.
fn x_fit_contract(st:[]u8)void {
  let n0:i32=st[1] as i32;
  let n1:i32=st[0] as i32;
  if(n1<=n0){return;}
  let best_err:i32=9999;
  let best_slot:i32=-1;
  let best_t:i32=-1;
  let slot:i32=0;
  while(slot<6){
    let t:i32=1;
    while(t<4){
      let err:i32=0;
      let i:i32=n0;
      while(i<n1){
        let o:i32=8+i*8;
        let v:i32=st[o+1+slot] as i32;
        let pred:i32=0;
        if(v>=t){pred=1;}
        if(pred != (st[o+7] as i32)){err=err+1;}
        i=i+1;
      }
      if(err<best_err){best_err=err;best_slot=slot;best_t=t;}
      t=t+1;
    }
    slot=slot+1;
  }
  if(best_slot>=0){
    st[500]=7;
    st[501]=best_slot as u8;
    st[502]=best_t as u8;
    st[503]=1;
    set32(st,522,best_err);
    st[1]=st[0];
  }
  return;
}

fn sv(slot:i32, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32)i32 {
  if(slot==0){return s0;}
  if(slot==1){return s1;}
  if(slot==2){return s2;}
  if(slot==3){return s3;}
  if(slot==4){return s4;}
  return s5;
}

// Act on the held contract: commit to (s[C_SLOT] >= C_THRESH).
fn c_act(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32)i32 {
  if((st[503] as i32)==0){return 0;}
  let slot:i32=st[501] as i32;
  let t:i32=st[502] as i32;
  let v:i32=sv(slot,s0,s1,s2,s3,s4,s5);
  if(v>=t){return 1;}
  return 0;
}

// Verify a commitment against the observed world consequence.
// is_probe=1: low-stakes probe. is_probe=0: high-stakes commitment.
// The monitor: 2 consecutive failures latch C_REV_REQ (offset 505).
// C_REV_REQ is written ONLY here, never by the driver. Threshold 2 is
// a frozen generic parameter: a cheap probe warrants a cheap trigger.
fn c_verify(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32, actual:i32, is_probe:i32)i32 {
  st[7]=((st[7] as i32)+1) as u8;
  let pred:i32=c_act(st,s0,s1,s2,s3,s4,s5);
  let ok:i32=0;
  if(pred==actual){ok=1;}
  set32(st,518,get32(st,518)+1);
  if(ok==1){set32(st,514,get32(st,514)+1);}
  if(is_probe==1){
    set32(st,534,get32(st,534)+1);
    if(ok==0){set32(st,538,get32(st,538)+1);}
  } else {
    set32(st,542,get32(st,542)+1);
    if(ok==0){set32(st,546,get32(st,546)+1);}
  }
  if((st[503] as i32)==1){
    if(ok==1){st[504]=0;}
    else {
      let r:i32=(st[504] as i32)+1;
      st[504]=r as u8;
      if(r>=2){
        if((st[505] as i32)==0){
          st[505]=1;
          if(get32(st,510)<0){set32(st,510,(st[7] as i32));}
        }
      }
    }
  }
  return ok;
}

// The proactive decision: probe before the next high-stakes commitment
// iff probing is enabled, a contract is held, and the contract has not
// been verified since the last commitment or revision. Records the
// probe event sequence number. Returns 1 when a probe round is needed.
fn x_probe_begin(st:[]u8)i32 {
  if((st[3] as i32)==0){return 0;}
  if((st[503] as i32)==0){return 0;}
  if((st[562] as i32)==1){return 0;}
  set32(st,563,get32(st,563)+1);
  set32(st,550,get32(st,563));
  return 1;
}

// Close a probe round. The driver reports the observed probe failures;
// the learner owns PROBE_FRESH (offset 562). A clean round marks the
// contract fresh; a round with failures keeps it suspect (the monitor
// latches a revision request instead of starting a re-probe loop).
fn x_probe_end(st:[]u8, fails:i32)void {
  if(fails==0){st[562]=1;}
  return;
}

// Standing generic opportunity. Revises iff the learner latched the
// request and the experimental parameter enables revision. A revision
// re-fits on fresh data, which establishes freshness directly.
fn x_maybe_revise(st:[]u8)void {
  if((st[505] as i32)==1){
    if((st[2] as i32)==1){
      let n0:i32=st[1] as i32;
      let n1:i32=st[0] as i32;
      let slot:i32=st[501] as i32;
      let t:i32=st[502] as i32;
      let err:i32=0;
      let i:i32=n0;
      while(i<n1){
        let o:i32=8+i*8;
        let v:i32=st[o+1+slot] as i32;
        let pred:i32=0;
        if(v>=t){pred=1;}
        if(pred != (st[o+7] as i32)){err=err+1;}
        i=i+1;
      }
      set32(st,530,err);
      x_fit_contract(st);
      set32(st,506,get32(st,506)+1);
      st[505]=0;
      st[504]=0;
      st[562]=1;
      set32(st,563,get32(st,563)+1);
      set32(st,554,get32(st,563));
    }
  }
  return;
}

// High-stakes commitment. Records the commit event sequence number.
// When probing is enabled and the contract was not freshly probed,
// count an unprobed commitment violation (offset 567).
fn c_commit(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32, actual:i32)i32 {
  set32(st,563,get32(st,563)+1);
  set32(st,558,get32(st,563));
  if((st[3] as i32)==1){
    if((st[562] as i32)==0){set32(st,567,get32(st,567)+1);}
  }
  let ok:i32=c_verify(st,s0,s1,s2,s3,s4,s5,actual,0);
  st[562]=0;
  return ok;
}

fn c_phase_reset(st:[]u8)void {
  st[7]=0;
  st[504]=0;
  return;
}

// Score a pool candidate for probing, from learner state only.
// score = (3 - |s[C_SLOT] - C_THRESH|) * 10 + minHamming(candidate,
// taught episodes in [0, XN)). Boundary proximity dominates; novelty
// against the learner's own experience breaks ties. No labels are
// consulted. -9999 when no contract is held.
fn x_score(st:[]u8, s0:i32, s1:i32, s2:i32, s3:i32, s4:i32, s5:i32)i32 {
  if((st[503] as i32)==0){return -9999;}
  let slot:i32=st[501] as i32;
  let t:i32=st[502] as i32;
  let v:i32=sv(slot,s0,s1,s2,s3,s4,s5);
  let bd:i32=v-t;
  if(bd<0){bd=0-bd;}
  let best:i32=6;
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*8;
    let d:i32=0;
    if(s0 != (st[o+1] as i32)){d=d+1;}
    if(s1 != (st[o+2] as i32)){d=d+1;}
    if(s2 != (st[o+3] as i32)){d=d+1;}
    if(s3 != (st[o+4] as i32)){d=d+1;}
    if(s4 != (st[o+5] as i32)){d=d+1;}
    if(s5 != (st[o+6] as i32)){d=d+1;}
    if(d<best){best=d;}
    i=i+1;
  }
  return (3-bd)*10+best;
}

// Choose PROBE_BUDGET=3 probe inputs from the open pool. The pool is
// driver-supplied world surface (inputs only, never labels); the
// SELECTION is computed here from learner state. Writes the chosen
// pool indices into C_CHOICE0..2 (offsets 585, 589, 593) and
// C_CHOSEN_N (offset 583). Selection order: score desc, pool index
// asc. Returns 0 and writes nothing unless CHOICE_ENABLED==1 and a
// contract is held.
fn x_choose_probes(st:[]u8, pool:[]u8, n:i32)i32 {
  if((st[584] as i32)==0){return 0;}
  if((st[503] as i32)==0){return 0;}
  set32(st,585,-1);
  set32(st,589,-1);
  set32(st,593,-1);
  let b:i32=0;
  while(b<3){
    let bi:i32=-1;
    let bs:i32=-99999;
    let k:i32=0;
    while(k<n){
      let taken:i32=0;
      if(get32(st,585)==k){taken=1;}
      if(get32(st,589)==k){taken=1;}
      if(get32(st,593)==k){taken=1;}
      if(taken==0){
        let o:i32=k*6;
        let sc:i32=x_score(st,(pool[o] as i32),(pool[o+1] as i32),(pool[o+2] as i32),(pool[o+3] as i32),(pool[o+4] as i32),(pool[o+5] as i32));
        if(sc>bs){bs=sc;bi=k;}
      }
      k=k+1;
    }
    if(bi<0){st[583]=b as u8;return 0;}
    set32(st,585+b*4,bi);
    b=b+1;
  }
  st[583]=3;
  return 1;
}
// world.zag -- LPROBE frozen world data (from PREREG section 2).
// World 0 outcome law: label = (s2 >= 2). World 1: label = (s2 >= 3)
// (threshold drift, new in this wave). The learner never calls
// w_label0/w_label1; they are the world's outcome laws used by the
// driver to compute observed consequences. w_pool is the open probe
// pool: the driver presents its inputs to the learner; the labels stay
// with the world. Training episodes for world 0 reuse the
// CDRIFT/PPROBE frozen set.

fn sq6(sq:[]u8, a:i32, b:i32, c:i32, d:i32, e:i32, f:i32)void {
  sq[0]=a as u8; sq[1]=b as u8; sq[2]=c as u8;
  sq[3]=d as u8; sq[4]=e as u8; sq[5]=f as u8;
  return;
}
fn w_label0(sq:[]u8)i32 {
  if((sq[2] as i32)>=2){return 1;}
  return 0;
}
fn w_label1(sq:[]u8)i32 {
  if((sq[2] as i32)>=3){return 1;}
  return 0;
}

// Training episodes, world 0. Frozen fit: (2,2).
fn w_train0(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,1,0,0);}
  if(i==2){sq6(sq,0,0,2,0,1,0);}
  if(i==3){sq6(sq,2,3,1,0,0,1);}
  return;
}
// Training episodes, world 1 (threshold drift). Frozen fit: (2,3).
// Old contract (2,2) has exactly 1 error on this window (E3p).
fn w_train1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,0,1,1,0,1);}
  if(i==2){sq6(sq,0,0,2,0,1,0);}
  if(i==3){sq6(sq,0,3,3,0,0,0);}
  return;
}
// Open probe pool, 10 candidates. P0..P2 are boundary probes (s2=2)
// that fail under the stale (2,2) contract in world 1; P3 is a
// boundary probe that stays ok; P4..P9 are interior distractors.
fn w_pool(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,2,0,0,0);}
  if(i==1){sq6(sq,1,1,2,1,0,0);}
  if(i==2){sq6(sq,0,3,2,0,1,1);}
  if(i==3){sq6(sq,1,0,1,0,0,0);}
  if(i==4){sq6(sq,0,0,0,0,0,0);}
  if(i==5){sq6(sq,2,3,3,0,0,1);}
  if(i==6){sq6(sq,1,1,0,1,1,0);}
  if(i==7){sq6(sq,0,0,3,1,0,0);}
  if(i==8){sq6(sq,3,0,0,0,0,1);}
  if(i==9){sq6(sq,1,2,3,0,1,0);}
  return;
}
// High-stakes queries. 0: HS1 (world 0). 1: HS2 (world 1; fails under
// stale (2,2), ok under revised (2,3)). 2..4: HSB0..HSB2 (world 0).
fn w_hs(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,0,0,2,0,0,0);}
  if(i==2){sq6(sq,0,0,3,0,0,0);}
  if(i==3){sq6(sq,1,1,0,0,0,0);}
  if(i==4){sq6(sq,0,0,2,1,0,0);}
  return;
}
// driver.zag -- LPROBE experiment driver: three arms, frozen kill bars.
// The driver teaches labeled episodes, schedules the world change,
// presents the open pool (inputs only) when the learner requests a
// probe, presents high-stakes queries, and calls x_maybe_revise as a
// standing heartbeat. The PROBE INPUT SELECTION is the learner's:
// x_choose_probes computes it from learner state. The driver only
// reads C_CHOICE0..2 to learn which pool inputs to present, and holds
// the outcome labels. It never writes C_REV_REQ (offset 505),
// PROBE_FRESH (offset 562), C_CHOSEN_N (offset 583), or C_CHOICE0..2
// (offsets 585..596). Static audit: no "st[505]=", "st[562]=",
// "st[583]=", "st[585", "st[589", or "st[593" assignment in this file.
// Prereg: learner_probes/PREREG.md. Pure Zag.

fn st_new()[]u8 {
  let st:[]u8=z_alloc(1024);
  set32(st,510,-1);
  set32(st,550,-1);
  set32(st,554,-1);
  set32(st,558,-1);
  set32(st,585,-1);
  set32(st,589,-1);
  set32(st,593,-1);
  return st;
}
fn d_req(st:[]u8)i32 { return st[505] as i32; }
fn d_slot(st:[]u8)i32 { return st[501] as i32; }
fn d_thresh(st:[]u8)i32 { return st[502] as i32; }
fn d_revcnt(st:[]u8)i32 { return get32(st,506); }
fn d_firstq(st:[]u8)i32 { return get32(st,510); }
fn d_fiterr(st:[]u8)i32 { return get32(st,522); }
fn d_olderr(st:[]u8)i32 { return get32(st,530); }
fn d_cor(st:[]u8)i32 { return get32(st,514); }
fn d_probes(st:[]u8)i32 { return get32(st,534); }
fn d_probefails(st:[]u8)i32 { return get32(st,538); }
fn d_hscommits(st:[]u8)i32 { return get32(st,542); }
fn d_hsfails(st:[]u8)i32 { return get32(st,546); }
fn d_probeseq(st:[]u8)i32 { return get32(st,550); }
fn d_reviseseq(st:[]u8)i32 { return get32(st,554); }
fn d_commitseq(st:[]u8)i32 { return get32(st,558); }
fn d_unprobed(st:[]u8)i32 { return get32(st,567); }
fn d_choice(st:[]u8, b:i32)i32 { return get32(st,585+b*4); }
fn d_chosenn(st:[]u8)i32 { return st[583] as i32; }

fn d_teach0(st:[]u8)void {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train0(i,sq);
    let lb:i32=w_label0(sq);
    x_teach(st,i+1,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return;
}
fn d_teach1(st:[]u8)void {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train1(i,sq);
    let lb:i32=w_label1(sq);
    x_teach(st,i+11,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return;
}
fn d_fitline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," err=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,(st[1] as i32));
  at=ob_nl(ob,at);
  return at;
}
// Learner-chosen probe round: the driver builds the open pool buffer
// (inputs only), the LEARNER selects PROBE_BUDGET=3 indices via
// x_choose_probes, the driver presents those inputs and computes the
// observed outcomes from the world law wl. Per-probe print: chosen
// index, learner score, pred, act, ok, monitor run, req.
fn d_chooseround(st:[]u8, ob:[]u8, at:i32, wl:i32, tag:[]u8)i32 {
  let pool:[]u8=z_alloc(60);
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<10){
    w_pool(i,sq);
    let j:i32=0;
    while(j<6){pool[i*6+j]=sq[j];j=j+1;}
    i=i+1;
  }
  let cr:i32=x_choose_probes(st,pool,10);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," choose=");
  at=ob_i32(ob,at,cr);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,d_chosenn(st));
  let b:i32=0;
  while(b<3){
    let ci:i32=d_choice(st,b);
    w_pool(ci,sq);
    let actual:i32=0;
    if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
    let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    let sc:i32=x_score(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    let ok:i32=c_verify(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual,1);
    at=ob_app(ob,at," i");
    at=ob_i32(ob,at,b);
    at=ob_app(ob,at,"=");
    at=ob_i32(ob,at,ci);
    at=ob_app(ob,at,"/sc");
    at=ob_i32(ob,at,sc);
    at=ob_app(ob,at,"/pred");
    at=ob_i32(ob,at,pred);
    at=ob_app(ob,at,"/act");
    at=ob_i32(ob,at,actual);
    at=ob_app(ob,at,"/ok");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at,"/run");
    at=ob_i32(ob,at,(st[504] as i32));
    b=b+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Fixed uninformative probe set for the control arm: the DRIVER picks
// {P4,P6,P8} (interior, s2=0). CHOICE_ENABLED=0 there.
fn d_fixedidx(b:i32)i32 {
  if(b==0){return 4;}
  if(b==1){return 6;}
  return 8;
}
fn d_fixedround(st:[]u8, ob:[]u8, at:i32, wl:i32, tag:[]u8)i32 {
  let sq:[]u8=z_alloc(6);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," fixed");
  let b:i32=0;
  while(b<3){
    let ci:i32=d_fixedidx(b);
    w_pool(ci,sq);
    let actual:i32=0;
    if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
    let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    let ok:i32=c_verify(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual,1);
    at=ob_app(ob,at," i");
    at=ob_i32(ob,at,ci);
    at=ob_app(ob,at,"/ok");
    at=ob_i32(ob,at,ok);
    b=b+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// One high-stakes commitment: hi selects w_hs, wl the outcome law.
fn d_commitq(st:[]u8, ob:[]u8, at:i32, hi:i32, wl:i32, tag:[]u8)i32 {
  let sq:[]u8=z_alloc(6);
  w_hs(hi,sq);
  let actual:i32=0;
  if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
  let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
  let ok:i32=c_commit(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," pred=");
  at=ob_i32(ob,at,pred);
  at=ob_app(ob,at," act=");
  at=ob_i32(ob,at,actual);
  at=ob_app(ob,at," ok=");
  at=ob_i32(ob,at,ok);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(st));
  at=ob_nl(ob,at);
  return at;
}
fn d_contractline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," ty=");
  at=ob_i32(ob,at,(st[500] as i32));
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," revcount=");
  at=ob_i32(ob,at,d_revcnt(st));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(st));
  at=ob_app(ob,at," fiterr=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," olderr=");
  at=ob_i32(ob,at,d_olderr(st));
  at=ob_app(ob,at," probes=");
  at=ob_i32(ob,at,d_probes(st));
  at=ob_app(ob,at," pfails=");
  at=ob_i32(ob,at,d_probefails(st));
  at=ob_app(ob,at," hs=");
  at=ob_i32(ob,at,d_hscommits(st));
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(st));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(st));
  at=ob_nl(ob,at);
  return at;
}
fn d_choiceline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,d_chosenn(st));
  at=ob_app(ob,at," [");
  at=ob_i32(ob,at,d_choice(st,0));
  at=ob_app(ob,at,",");
  at=ob_i32(ob,at,d_choice(st,1));
  at=ob_app(ob,at,",");
  at=ob_i32(ob,at,d_choice(st,2));
  at=ob_app(ob,at,"]");
  at=ob_nl(ob,at);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=ob_app(ob,at,"LEARNER-PROBE\n");

  // ---- Arm A: learner-chosen probes, drift ----
  at=ob_app(ob,at,"ARM-A learner-chosen drift\n");
  let sta:[]u8=st_new();
  sta[2]=1;
  sta[3]=1;
  sta[584]=1;
  d_teach0(sta);
  x_fit_contract(sta);
  at=d_fitline(sta,ob,at,"A-FIT0");
  let pre_slot:i32=d_slot(sta);
  let pre_t:i32=d_thresh(sta);
  // Round 1, world 0.
  c_phase_reset(sta);
  let r1_need:i32=x_probe_begin(sta);
  let pf0:i32=d_probefails(sta);
  at=d_chooseround(sta,ob,at,0,"A-P1");
  at=d_choiceline(sta,ob,at,"A-C1");
  let fails_r1:i32=d_probefails(sta)-pf0;
  x_probe_end(sta,fails_r1);
  let r1_reprobe:i32=x_probe_begin(sta);
  x_maybe_revise(sta);
  let rev_r1:i32=d_revcnt(sta);
  let c0:i32=d_cor(sta);
  at=d_commitq(sta,ob,at,0,0,"A-HS1");
  let ok1:i32=d_cor(sta)-c0;
  at=ob_app(ob,at,"A-R1SUM probeneed=");
  at=ob_i32(ob,at,r1_need);
  at=ob_app(ob,at," reprobe=");
  at=ob_i32(ob,at,r1_reprobe);
  at=ob_app(ob,at," probefails=");
  at=ob_i32(ob,at,fails_r1);
  at=ob_app(ob,at," hsok=");
  at=ob_i32(ob,at,ok1);
  at=ob_app(ob,at," rev=");
  at=ob_i32(ob,at,rev_r1);
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(sta));
  at=ob_nl(ob,at);
  // World change (driver scheduled, disclosed). Round 2, world 1.
  c_phase_reset(sta);
  let r2_need:i32=x_probe_begin(sta);
  pf0=d_probefails(sta);
  at=d_chooseround(sta,ob,at,1,"A-P2");
  at=d_choiceline(sta,ob,at,"A-C2");
  let fails_r2:i32=d_probefails(sta)-pf0;
  let req_before:i32=d_req(sta);
  let firstq:i32=d_firstq(sta);
  at=ob_app(ob,at,"A-DETECT req=");
  at=ob_i32(ob,at,req_before);
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,firstq);
  at=ob_nl(ob,at);
  x_probe_end(sta,fails_r2);
  d_teach1(sta);
  x_maybe_revise(sta);
  at=ob_app(ob,at,"A-REVISE ");
  at=d_contractline(sta,ob,at,"");
  let post_slot:i32=d_slot(sta);
  let post_t:i32=d_thresh(sta);
  c0=d_cor(sta);
  at=d_commitq(sta,ob,at,1,1,"A-HS2");
  let ok2:i32=d_cor(sta)-c0;
  at=ob_app(ob,at,"A-R2SUM probefails=");
  at=ob_i32(ob,at,fails_r2);
  at=ob_app(ob,at," hsok=");
  at=ob_i32(ob,at,ok2);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(sta));
  at=ob_app(ob,at," seq=");
  at=ob_i32(ob,at,d_probeseq(sta));
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,d_reviseseq(sta));
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,d_commitseq(sta));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(sta));
  at=ob_nl(ob,at);
  at=d_contractline(sta,ob,at,"A-FINAL");

  // ---- Arm B: learner-chosen probes, no drift control ----
  at=ob_app(ob,at,"ARM-B learner-chosen no-drift\n");
  let stb:[]u8=st_new();
  stb[2]=1;
  stb[3]=1;
  stb[584]=1;
  d_teach0(stb);
  x_fit_contract(stb);
  at=d_fitline(stb,ob,at,"B-FIT0");
  c_phase_reset(stb);
  let r:i32=0;
  while(r<3){
    let need:i32=x_probe_begin(stb);
    at=ob_app(ob,at,"B-R need=");
    at=ob_i32(ob,at,need);
    at=ob_nl(ob,at);
    pf0=d_probefails(stb);
    at=d_chooseround(stb,ob,at,0,"B-P");
    at=d_choiceline(stb,ob,at,"B-C");
    let bf:i32=d_probefails(stb)-pf0;
    x_probe_end(stb,bf);
    x_maybe_revise(stb);
    at=d_commitq(stb,ob,at,2+r,0,"B-HS");
    r=r+1;
  }
  at=ob_app(ob,at,"B-SUM probes=");
  at=ob_i32(ob,at,d_probes(stb));
  at=ob_app(ob,at," pfails=");
  at=ob_i32(ob,at,d_probefails(stb));
  at=ob_app(ob,at," rev=");
  at=ob_i32(ob,at,d_revcnt(stb));
  at=ob_app(ob,at," hs=");
  at=ob_i32(ob,at,d_hscommits(stb));
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(stb));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(stb));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(stb));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,d_req(stb));
  at=ob_nl(ob,at);
  at=d_contractline(stb,ob,at,"B-FINAL");

  // ---- Arm C: fixed uninformative probes, drift ----
  at=ob_app(ob,at,"ARM-C fixed probes control\n");
  let stc:[]u8=st_new();
  stc[2]=1;
  stc[3]=1;
  stc[584]=0;
  d_teach0(stc);
  x_fit_contract(stc);
  at=d_fitline(stc,ob,at,"C-FIT0");
  c_phase_reset(stc);
  let c_need1:i32=x_probe_begin(stc);
  pf0=d_probefails(stc);
  at=d_fixedround(stc,ob,at,0,"C-P1");
  let cf1:i32=d_probefails(stc)-pf0;
  x_probe_end(stc,cf1);
  x_maybe_revise(stc);
  c0=d_cor(stc);
  at=d_commitq(stc,ob,at,0,0,"C-HS1");
  let cok1:i32=d_cor(stc)-c0;
  // World change (driver scheduled, disclosed).
  c_phase_reset(stc);
  let c_need2:i32=x_probe_begin(stc);
  pf0=d_probefails(stc);
  at=d_fixedround(stc,ob,at,1,"C-P2");
  let cf2:i32=d_probefails(stc)-pf0;
  x_probe_end(stc,cf2);
  x_maybe_revise(stc);
  c0=d_cor(stc);
  at=d_commitq(stc,ob,at,1,1,"C-HS2");
  let cok2:i32=d_cor(stc)-c0;
  at=ob_app(ob,at,"C-SUM probeneed=");
  at=ob_i32(ob,at,c_need1+c_need2);
  at=ob_app(ob,at," pfails=");
  at=ob_i32(ob,at,d_probefails(stc));
  at=ob_app(ob,at," hsok1=");
  at=ob_i32(ob,at,cok1);
  at=ob_app(ob,at," hsok2=");
  at=ob_i32(ob,at,cok2);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(stc));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,d_req(stc));
  at=ob_nl(ob,at);
  at=d_contractline(stc,ob,at,"C-FINAL");

  // ---- Kill bars ----
  let k1:i32=0;
  if(d_choice(sta,0)==2){ if(d_choice(sta,1)==0){ if(d_choice(sta,2)==1){ if(d_chosenn(sta)==3){k1=1;} } } }
  let k2:i32=0;
  if(fails_r2==3){ if(req_before==1){ if(firstq==2){ if(d_hsfails(sta)==0){
    if(d_probeseq(sta)<d_reviseseq(sta)){ if(d_reviseseq(sta)<d_commitseq(sta)){ if(d_unprobed(sta)==0){k2=1;} } } } } } }
  let k3:i32=0;
  let ca0:i32=d_choice(sta,0);
  let ca1:i32=d_choice(sta,1);
  let ca2:i32=d_choice(sta,2);
  let dup:i32=0;
  if(ca0==ca1){dup=1;}
  if(ca0==ca2){dup=1;}
  if(ca1==ca2){dup=1;}
  let inb:i32=0;
  if(ca0<4){ if(ca1<4){ if(ca2<4){ inb=1; } } }
  let cn3:i32=d_chosenn(sta);
  if(dup==0){ if(inb==1){ if(cn3==3){k3=1;} } }
  let k4:i32=0;
  if(ok2==1){ if(cok2==0){ if(d_probefails(stc)==0){ if(d_req(stc)==0){
    if(d_slot(stc)==2){ if(d_thresh(stc)==2){k4=1;} } } } } }
  let k5:i32=0;
  if(d_probes(stb)==9){ if(d_probefails(stb)==0){ if(d_revcnt(stb)==0){
    if(d_hscommits(stb)==3){ if(d_hsfails(stb)==0){ if(d_unprobed(stb)==0){
      if(d_choice(stb,0)==2){ if(d_choice(stb,1)==0){ if(d_choice(stb,2)==1){k5=1;} } } } } } } } }
  let k6:i32=0;
  if(pre_slot==2){ if(pre_t==2){ if(post_slot==2){ if(post_t==3){
    if(d_slot(stc)==2){ if(d_thresh(stc)==2){
      if(d_slot(stb)==2){ if(d_thresh(stb)==2){k6=1;} } } } } } } }
  let k8:i32=0;
  if(d_fiterr(sta)==0){ if(d_olderr(sta)>=1){ if(d_firstq(stb)<0){ if(d_req(stb)==0){k8=1;} } } }

  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=see-shell");
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  let pass:i32=k1+k2+k3+k4+k5+k6+k8;
  if(pass==7){
    at=ob_app(ob,at,"VERDICT LEARNER-PROBE-COMPLETE\n");
  } else {
    at=ob_app(ob,at,"VERDICT FAIL bars-passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/7\n");
  }
  at=ob_app(ob,at,"LEARNER-PROBE-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// rank_lazy.zag -- RANK-LAZY lane (frozen lazy-ranking replication
// plus a threshold-crossed re-rank variant).
// Substrate carried over from RANK-CHEAP unchanged except additive:
//   - M buffer 4096 -> 4160 bytes; ranked-flag side table at offset
//     4096 (64 x u8, one per cold slot: "ranked this residency");
//     zeroed by mem_zero, cleared on promote/exile alongside rc;
//   - thresh_rerank: rk=5, threshold-crossed re-rank. On a cold hit,
//     after the rc increment: if rc >= T_rank (frozen T_rank=2) and
//     the entry's ranked flag is clear, one swap-with-front
//     (honest cost 1 iff s>0); flag follows the ranked entry;
//     fires at most once per entry per residency. Importance-
//     triggered, not schedule-triggered.
//   - rk threaded through cold_lookup as before: 0 = none,
//     1 = MTF, 2 = importance bubble (carried), 3 = swap-with-front
//     (eager, carried), 4 = periodic swap (lazy, carried),
//     5 = threshold-crossed re-rank;
//   - rank move runs on every cold hit after the rc increment and
//     before the promotion check (move-then-promote); promote_slot
//     uses the entry's NEW slot;
//   - run_promo takes rk; row extended to 144 bytes (128 rkT,
//     132 rkmT, 136 rk) as in RANK-CHEAP.
// See PREREG.md for the frozen design, derivations, kill bars.
//
// Header: 0 bumpA (pol 0/1 bump pointer), 4 conflicts, 8 evictions,
// 12 table_full_errors, 16 pool_size (=32), 20 policy, 24 bumpB
// (pol 1 class-1 bump pointer), 28 drop, 32 consent_mask (=16),
// 36 clock (monotonic last-touch stamp), 40 exile, 44 recover,
// 48 cold_drop, 52 cold_cost, 56 cold_seq, 60 promote,
// 64 rank_cost, 68 rank_moves, 72 hits_since_rank.
// Primary: 64, 128 slots x 16 bytes. Pool: 2112, 32 slots x 16 bytes.
// Touch side table: 2624, 32 slots x 4 bytes (last-touch per pool slot).
// Cold tier: 2752, 64 slots x 20 bytes (key,val,owner,used,exile-seq).
// Recovery-count side table: 4032, 64 x u8 (recoveries per cold slot).
// Ranked-flag side table: 4096, 64 x u8 (ranked-this-residency flag).
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3 (cold_lookup hit block flattened with hoisted flags); no negated
// conjunctions in while conditions (bubble_up uses a go-flag loop);
// no _zag_print; no `as *i32` slice construction; single approved
// `as *u8` in z_alloc (carried over).

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn coff(idx:i32)i32 { return 2752+idx*20; }
// recovery-count side table: one u8 per cold slot, base 4032
fn rget(M:[]u8,s:i32)i32 { return M[4032+s] as i32; }
fn rset(M:[]u8,s:i32,v:i32)void { M[4032+s]=v as u8; return; }
// ranked-flag side table: one u8 per cold slot, base 4096
// ("ranked this residency" for the rk=5 threshold primitive)
fn rg5(M:[]u8,s:i32)i32 { return M[4096+s] as i32; }
fn rrset(M:[]u8,s:i32,v:i32)void { M[4096+s]=v as u8; return; }
// Swap two whole cold slots: the 20-byte entry AND its rc byte move
// together, so the recovery-count signal never detaches from its entry.
fn cslot_swap(M:[]u8,a:i32,b:i32)void {
  let ca:i32=coff(a);
  let cb:i32=coff(b);
  let f:i32=0;
  while(f<20){
    let t:u8=M[ca+f];
    M[ca+f]=M[cb+f];
    M[cb+f]=t;
    f=f+1;
  }
  let tr:u8=M[4032+a];
  M[4032+a]=M[4032+b];
  M[4032+b]=tr;
  return;
}
// Move-to-front (rk=1, recency): entry at slot s -> slot 0 via
// adjacent swaps (slots [0,s-1] shift right). rank_cost += s.
// Returns the entry's new slot (0). No-op at s=0.
fn mtf_move(M:[]u8,s:i32)i32 {
  if(s<1){return 0;}
  let j:i32=s;
  while(j>0){
    cslot_swap(M,j,j-1);
    j=j-1;
  }
  put32(M,64,ig(M,64)+s);
  put32(M,68,ig(M,68)+1);
  return 0;
}
// Bubble-up by recovery count (rk=2, importance): while rc(s) >
// rc(s-1), swap left (strictly greater; ties do not move).
// rank_cost += positions advanced. Returns the entry's new slot.
fn bubble_up(M:[]u8,s:i32)i32 {
  let adv:i32=0;
  let go:i32=1;
  while(go==1){
    let cont:i32=0;
    if(s>0 && rget(M,s)>rget(M,s-1)){cont=1;}
    if(cont==0){go=0;}
    if(cont==1){
      cslot_swap(M,s,s-1);
      s=s-1;
      adv=adv+1;
    }
  }
  put32(M,64,ig(M,64)+adv);
  if(adv>0){put32(M,68,ig(M,68)+1);}
  return s;
}
// Swap-with-front (rk=3, eager O(1)): entry at slot s swaps with slot
// 0 via ONE cslot_swap (no stack shifting). rank_cost += 1 per swap:
// the honest price of the O(1) primitive at the same slot-position
// granularity as the cold scan cost. Returns the entry's new slot (0).
// No-op at s=0.
fn swap_front(M:[]u8,s:i32)i32 {
  if(s<1){return 0;}
  cslot_swap(M,s,0);
  put32(M,64,ig(M,64)+1);
  put32(M,68,ig(M,68)+1);
  return 0;
}
// Periodic swap (rk=4, lazy): the same O(1) primitive, applied only
// every 8th cold hit (header 72 counts hits since the last rank; it
// is zeroed by mem_zero at each row start). On other hits the entry
// stays in place. Returns the entry's post-move slot.
fn periodic_swap(M:[]u8,s:i32)i32 {
  let h:i32=ig(M,72)+1;
  put32(M,72,h);
  if(h<8){return s;}
  put32(M,72,0);
  if(s<1){return 0;}
  cslot_swap(M,s,0);
  put32(M,64,ig(M,64)+1);
  put32(M,68,ig(M,68)+1);
  return 0;
}
// Threshold-crossed re-rank (rk=5): importance-triggered, not
// schedule-triggered. On a cold hit, after the rc increment: if the
// entry's recovery count has crossed the frozen threshold T_rank=2
// and the entry has not been ranked this residency, perform ONE
// swap-with-front (honest cost rank_cost += 1 iff s>0; no-op at
// s=0). The ranked flag follows the ranked entry (set at slot 0
// after the move; the displaced entry's flag is cleared) and fires
// at most once per entry per residency. Returns the post-move slot.
fn thresh_rerank(M:[]u8,s:i32)i32 {
  if(rget(M,s)<2){return s;}
  if(rg5(M,s)==1){return s;}
  if(s<1){rrset(M,s,1);return 0;}
  cslot_swap(M,s,0);
  rrset(M,0,1);
  rrset(M,s,0);
  put32(M,64,ig(M,64)+1);
  put32(M,68,ig(M,68)+1);
  return 0;
}
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4160){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
// last-touch side table (base 2624, 32 x 4 bytes)
fn tget(M:[]u8,s:i32)i32 { return ig(M,2624+s*4); }
fn stamp(M:[]u8,s:i32)void {
  let c:i32=ig(M,36)+1;
  put32(M,36,c);
  put32(M,2624+s*4,c);
  return;
}
// Exile: move a displaced hot-tier entry to the cold tier. First free
// cold slot; if the cold tier is full, FIFO by exile-seq (cold_drop++).
// exile++ on every displacement. The hot tier never destroys.
// The slot's recovery count is reset on every install.
fn exile_victim(M:[]u8,key:i32,val:i32,owner:i32)void {
  let s:i32=0;
  while(s<64){
    let co:i32=coff(s);
    if(ig(M,co+12)==0){
      put32(M,co,key); put32(M,co+4,val);
      put32(M,co+8,owner); put32(M,co+12,1);
      rset(M,s,0);
      rrset(M,s,0);
      let q:i32=ig(M,56)+1;
      put32(M,56,q); put32(M,co+16,q);
      put32(M,40,ig(M,40)+1);
      return;
    }
    s=s+1;
  }
  let ms:i32=0;
  let mq:i32=ig(M,coff(0)+16);
  s=1;
  while(s<64){
    let qq:i32=ig(M,coff(s)+16);
    if(qq<mq){mq=qq;ms=s;}
    s=s+1;
  }
  let co:i32=coff(ms);
  put32(M,co,key); put32(M,co+4,val);
  put32(M,co+8,owner); put32(M,co+12,1);
  rset(M,ms,0);
  rrset(M,ms,0);
  let q:i32=ig(M,56)+1;
  put32(M,56,q); put32(M,co+16,q);
  put32(M,48,ig(M,48)+1);
  put32(M,40,ig(M,40)+1);
  return;
}
// Promote cold slot cs to the hot pool (reheat). The entry is MOVED,
// never copied: the cold slot is freed and its recovery count reset.
// Target: first free pool slot if the pool is not full; else the used
// pool slot with minimum last-touch (ties: lowest index), mirroring
// policy 6. A displaced pool victim is re-exiled (priced demotion),
// never destroyed. promote++ (header 60) per move.
fn promote_slot(M:[]u8,cs:i32)void {
  let co:i32=coff(cs);
  let key:i32=ig(M,co);
  let val:i32=ig(M,co+4);
  let own:i32=ig(M,co+8);
  let s:i32=0;
  let tgt:i32=-1;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(tgt==-1 && ig(M,oo+12)==0){tgt=s;}
    s=s+1;
  }
  if(tgt!=-1){
    let oo:i32=soff(2112,tgt);
    put32(M,oo,key); put32(M,oo+4,val);
    put32(M,oo+8,own); put32(M,oo+12,1);
    stamp(M,tgt);
    put32(M,co+12,0);
    rset(M,cs,0);
    rrset(M,cs,0);
    put32(M,60,ig(M,60)+1);
    return;
  }
  let best:i32=-1;
  let bestt:i32=0;
  s=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let used:i32=0;
    if(ig(M,oo+12)==1){used=1;}
    if(used==1){
      let ts:i32=tget(M,s);
      let take:i32=0;
      if(best==-1){take=1;}
      if(best!=-1 && ts<bestt){take=1;}
      if(take==1){best=s;bestt=ts;}
    }
    s=s+1;
  }
  if(best==-1){return;}
  let bo:i32=soff(2112,best);
  exile_victim(M,ig(M,bo),ig(M,bo+4),ig(M,bo+8));
  put32(M,bo,key); put32(M,bo+4,val);
  put32(M,bo+8,own); put32(M,bo+12,1);
  stamp(M,best);
  put32(M,co+12,0);
  rset(M,cs,0);
  rrset(M,cs,0);
  put32(M,60,ig(M,60)+1);
  return;
}
// Cold-tier lookup for the recovery path. cold_cost += slots examined
// (position+1 on hit, 64 on miss). recover++ on hit. The slot's
// recovery count increments per hit; when pm==1 and the count reaches
// the frozen threshold T=2, the entry is promoted to the hot pool.
// rk selects the within-cold ranking applied on every hit (after the
// rc increment, before the promotion check): 0 = none (EXILE-PROMOTION
// behavior), 1 = move-to-front (recency), 2 = bubble-up by rc
// (importance), 3 = swap-with-front (eager O(1)), 4 = periodic swap
// (lazy, every 8th hit). The promotion uses the entry's post-move slot.
fn cold_lookup(M:[]u8,key:i32,owner:i32,pm:i32,rk:i32)i32 {
  let s:i32=0;
  while(s<64){
    let co:i32=coff(s);
    put32(M,52,ig(M,52)+1);
    let hit:i32=0;
    if(ig(M,co+12)==1 && ig(M,co)==key){hit=1;}
    let ok:i32=0;
    if(hit==1 && (ig(M,co+8)&owner)!=0){ok=1;}
    if(ok==1){
      put32(M,44,ig(M,44)+1);
      let vv:i32=ig(M,co+4);
      let rc:i32=rget(M,s)+1;
      if(rc>250){rc=250;}
      rset(M,s,rc);
      let ns:i32=s;
      if(rk==1){ns=mtf_move(M,s);}
      if(rk==2){ns=bubble_up(M,s);}
      if(rk==3){ns=swap_front(M,s);}
      if(rk==4){ns=periodic_swap(M,s);}
      if(rk==5){ns=thresh_rerank(M,s);}
      let trig:i32=0;
      if(pm==1 && rc>=2){trig=1;}
      if(trig==1){promote_slot(M,ns);}
      return vv;
    }
    s=s+1;
  }
  return -1;
}
// Policy relocation for the conflict victim at primary slot so.
// Caller has already counted the conflict. After this returns, the
// caller installs the new value in the primary slot.
// Every displaced entry is exiled; nothing in the hot tier is destroyed.
fn relocate(M:[]u8,so:i32)void {
  let pol:i32=ig(M,20);
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  if(pol==0){
    // FIFO (verbatim from EVICTION-POLICY-COMPARE): single circular
    // bump pointer modulo 32. The overwritten pool entry is exiled.
    let op:i32=ig(M,0);
    let oo:i32=soff(2112,op);
    if(ig(M,oo+12)==1){
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    }
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    put32(M,0,(op+1)%32);
    return;
  }
  if(pol==1){
    // PART (verbatim from EVICTION-POLICY-COMPARE): class 1 iff victim
    // owner is exactly 16 (B-only), else class 0. 16-slot partition
    // per class, own circular bump pointer modulo 16, FIFO within
    // class. The overwritten pool entry is exiled.
    let cls:i32=0;
    if(vo==16){cls=1;}
    let bp:i32=ig(M,0);
    if(cls==1){bp=ig(M,24);}
    let oo:i32=soff(2112,cls*16+bp);
    if(ig(M,oo+12)==1){
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    }
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    bp=(bp+1)%16;
    if(cls==1){put32(M,24,bp);}
    if(cls==0){put32(M,0,bp);}
    return;
  }
  // All other policies: scan for the first free slot first.
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    if(ig(M,oo+12)==0){
      put32(M,oo,key); put32(M,oo+4,vv);
      put32(M,oo+8,vo); put32(M,oo+12,1);
      stamp(M,s);
      return;
    }
    s=s+1;
  }
  // Pool full: reclamation per policy.
  if(pol==4){
    // PIN-LRU (verbatim from PINNING-RECLAMATION): evict the used
    // slot with minimum last-touch. The victim is exiled.
    let ms:i32=0;
    let mt:i32=tget(M,0);
    s=1;
    while(s<32){
      let tt:i32=tget(M,s);
      if(tt<mt){mt=tt;ms=s;}
      s=s+1;
    }
    let oo:i32=soff(2112,ms);
    put32(M,8,ig(M,8)+1);
    exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
    put32(M,oo,key); put32(M,oo+4,vv);
    put32(M,oo+8,vo); put32(M,oo+12,1);
    stamp(M,ms);
    return;
  }
  if(pol==5){
    // PIN-CONSENT: evict the first used slot whose owner intersects
    // the consent mask; other slots stay pinned forever. The victim
    // is exiled. On mask miss, the old primary entry is exiled and
    // drop++ (destroy-in-place becomes exile-in-place).
    let cm:i32=ig(M,32);
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      let consent:i32=0;
      if((ig(M,oo+8)&cm)!=0){consent=1;}
      let ok:i32=0;
      if(used==1){ok=consent;}
      if(ok==1){
        put32(M,8,ig(M,8)+1);
        exile_victim(M,ig(M,oo),ig(M,oo+4),ig(M,oo+8));
        put32(M,oo,key); put32(M,oo+4,vv);
        put32(M,oo+8,vo); put32(M,oo+12,1);
        stamp(M,s);
        return;
      }
      s=s+1;
    }
    exile_victim(M,key,vv,vo);
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==6){
    // PIN-LIVELINESS: owner-blind. Evict the used slot with the
    // minimum last-touch stamp (ties: lowest slot index). Owner
    // identity is never consulted. The victim is exiled.
    let best:i32=-1;
    let bestt:i32=0;
    s=0;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=0;
      if(ig(M,oo+12)==1){used=1;}
      if(used==1){
        let ts:i32=tget(M,s);
        let take:i32=0;
        if(best==-1){take=1;}
        if(best!=-1 && ts<bestt){take=1;}
        if(take==1){best=s;bestt=ts;}
      }
      s=s+1;
    }
    if(best!=-1){
      let bo:i32=soff(2112,best);
      put32(M,8,ig(M,8)+1);
      exile_victim(M,ig(M,bo),ig(M,bo+4),ig(M,bo+8));
      put32(M,bo,key); put32(M,bo+4,vv);
      put32(M,bo+8,vo); put32(M,bo+12,1);
      stamp(M,best);
      return;
    }
    exile_victim(M,key,vv,vo);
    put32(M,28,ig(M,28)+1);
    return;
  }
  // PIN-NORECLAIM (policy 3): no reclamation; the old primary entry
  // is exiled and drop++ (destroy-in-place becomes exile-in-place).
  exile_victim(M,key,vv,vo);
  put32(M,28,ig(M,28)+1);
  return;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Counted identically in all
      // policies; only the relocation outcome is policy-dependent.
      put32(M,4,ig(M,4)+1);
      relocate(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
// Hot-path read: primary -> pool, owner-scoped. Never consults cold.
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){stamp(M,o);return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}
// Recovery-path read: hot path, then cold fallback on miss.
// pm=1 enables promotion on the T-th recovery of one entry.
// rk selects the within-cold ranking (0/1/2).
fn mem_read_recov(M:[]u8,key:i32,owner:i32,pm:i32,rk:i32)i32 {
  let v:i32=mem_read(M,key,owner);
  if(v!=-1){return v;}
  return cold_lookup(M,key,owner,pm,rk);
}

// ---------- structures (identical to LIVENESS-SIGNAL) ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary, single-owner (mode 0): w writes on B-owned fresh
// key 3999. First write allocates; each later write conflicts and
// relocates a B-owned victim. (unchanged from PINNING-RECLAMATION)
fn teach_churn(M:[]u8,w:i32)void {
  let j:i32=0;
  while(j<w){
    mem_write(M,3999,900001+j,16);
    j=j+1;
  }
  return;
}
// churn adversary, multi-owner (unchanged from MULTI-OWNER-CHURN).
// mode=1: key 3998 (owner 8) and key 3999 (owner 16), interleaved per
// round. mode=2: adds key 3997 (owner 4) as the first write of each
// round. mode=3 (X2): keys 3997 (owner 4) and 3998 (owner 8)
// interleaved per round; no owner-16 churner at all.
fn teach_churn_multi(M:[]u8,mode:i32,w:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    if(mode==3){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    if(mode==1){mem_write(M,3999,900001+j,16);}
    if(mode==2){mem_write(M,3999,900001+j,16);}
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// test_A on the recovery path: hot reads, cold fallback on miss.
// pm=1 enables promotion; rk selects the within-cold ranking.
fn test_A_recov(M:[]u8,multi:i32,pm:i32,rk:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read_recov(M,1000+i*10+1,1,pm,rk)==i*100+7 && mem_read_recov(M,1000+i*10+2,1,pm,rk)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read_recov(M,1000+i*10+1,2,pm,rk);
      let b:i32=mem_read_recov(M,1000+i*10+2,2,pm,rk);
      let c:i32=mem_read_recov(M,1000+i*10+3,2,pm,rk);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read_recov(M,2000+i,4,pm,rk);
      let a2:i32=mem_read_recov(M,1000+i*10+1,4,pm,rk);
      let b2:i32=mem_read_recov(M,1000+i*10+2,4,pm,rk);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read_recov(M,1000+i*10+1,8,pm,rk)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic, hot path only).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// Anchor driver (pm=0): H2's 14-column row layout.
// R layout per condition (56 bytes): 0 pre, 4 post, 8 ret, 12 cf,
// 16 ev, 20 bacc, 24 rawA, 28 drop, 32 postR, 36 retR, 40 exile,
// 44 recover, 48 cold_drop, 52 cold_cost
fn run_cond(M:[]u8,OB:[]u8,pol:i32,chw:i32,mode:i32,tag:[]u8,R:[]u8,ro:i32,mw:i32,pm:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  if(mode==0){teach_churn(M,chw);}
  if(mode==1){teach_churn_multi(M,1,mw);}
  if(mode==2){teach_churn_multi(M,2,mw);}
  if(mode==3){teach_churn_multi(M,3,mw);}
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let postR:i32=test_A_recov(M,1,pm,0);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ex:i32=ig(M,40);
  let rc:i32=ig(M,44);
  let cd:i32=ig(M,48);
  let cc:i32=ig(M,52);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  let retR:i32=0;
  if(pre>0){retR=(100*postR)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr); put32(R,ro+32,postR);
  put32(R,ro+36,retR); put32(R,ro+40,ex); put32(R,ro+44,rc);
  put32(R,ro+48,cd); put32(R,ro+52,cc);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," mode="); e1i(OB,mode as i64);
  e1s(OB," churnw="); e1i(OB,chw as i64);
  if(mw!=21){e1s(OB," mw="); e1i(OB,mw as i64);}
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB," postR="); e1i(OB,postR as i64);
  e1s(OB," retR="); e1i(OB,retR as i64);
  e1s(OB," exile="); e1i(OB,ex as i64);
  e1s(OB," recover="); e1i(OB,rc as i64);
  e1s(OB," cdrop="); e1i(OB,cd as i64);
  e1s(OB," ccost="); e1i(OB,cc as i64);
  e1s(OB,"\n");
  return;
}
// Promotion driver (pm=1): teach, churn, three recovery passes
// R1/R2/R3 with per-pass ledger deltas, hot postH, optional second
// churn (c2w rounds, mode 1) then R4 and hot postH2.
// Promo row layout (128 bytes): 0 pre, 4 post, 8 bacc, 12 raw,
// 16 cf, 20 ev, 24 drop, 28 exile, 32 cdrop,
// 36 postR1, 40 rec1, 44 cc1, 48 prm1,
// 52 postR2, 56 rec2, 60 cc2, 64 prm2,
// 68 postR3, 72 rec3, 76 cc3, 80 prm3,
// 84 postH, 88 recT, 92 ccT, 96 prmT,
// 100 postR4, 104 rec4, 108 cc4, 112 prm4,
// 116 postH2, 120 cfT, 124 evT,
// 128 rkT (rank_cost total), 132 rkmT (rank_moves total), 136 rk
fn run_promo(M:[]u8,OB:[]u8,pol:i32,mode:i32,w:i32,tag:[]u8,R:[]u8,ro:i32,c2w:i32,rk:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,16);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  if(mode==0){teach_churn(M,w);}
  if(mode==1){teach_churn_multi(M,1,w);}
  if(mode==2){teach_churn_multi(M,2,w);}
  if(mode==3){teach_churn_multi(M,3,w);}
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let bfr:i32=ig(M,44);
  let bfc:i32=ig(M,52);
  let bfp:i32=ig(M,60);
  let r1:i32=test_A_recov(M,1,1,rk);
  let rec1:i32=ig(M,44)-bfr;
  let cc1:i32=ig(M,52)-bfc;
  let pm1:i32=ig(M,60)-bfp;
  bfr=ig(M,44); bfc=ig(M,52); bfp=ig(M,60);
  let r2:i32=test_A_recov(M,1,1,rk);
  let rec2:i32=ig(M,44)-bfr;
  let cc2:i32=ig(M,52)-bfc;
  let pm2:i32=ig(M,60)-bfp;
  bfr=ig(M,44); bfc=ig(M,52); bfp=ig(M,60);
  let r3:i32=test_A_recov(M,1,1,rk);
  let rec3:i32=ig(M,44)-bfr;
  let cc3:i32=ig(M,52)-bfc;
  let pm3:i32=ig(M,60)-bfp;
  let postH:i32=test_A(M,1);
  let r4:i32=0;
  let rec4:i32=0;
  let cc4:i32=0;
  let pm4:i32=0;
  let postH2:i32=0;
  if(c2w>0){
    teach_churn_multi(M,1,c2w);
    bfr=ig(M,44); bfc=ig(M,52); bfp=ig(M,60);
    r4=test_A_recov(M,1,1,rk);
    rec4=ig(M,44)-bfr; cc4=ig(M,52)-bfc; pm4=ig(M,60)-bfp;
    postH2=test_A(M,1);
  }
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ex:i32=ig(M,40);
  let cd:i32=ig(M,48);
  let recT:i32=ig(M,44);
  let ccT:i32=ig(M,52);
  let prmT:i32=ig(M,60);
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,bacc);
  put32(R,ro+12,raw); put32(R,ro+16,cf); put32(R,ro+20,ev);
  put32(R,ro+24,dr); put32(R,ro+28,ex); put32(R,ro+32,cd);
  put32(R,ro+36,r1); put32(R,ro+40,rec1); put32(R,ro+44,cc1);
  put32(R,ro+48,pm1);
  put32(R,ro+52,r2); put32(R,ro+56,rec2); put32(R,ro+60,cc2);
  put32(R,ro+64,pm2);
  put32(R,ro+68,r3); put32(R,ro+72,rec3); put32(R,ro+76,cc3);
  put32(R,ro+80,pm3);
  put32(R,ro+84,postH); put32(R,ro+88,recT); put32(R,ro+92,ccT);
  put32(R,ro+96,prmT);
  put32(R,ro+100,r4); put32(R,ro+104,rec4); put32(R,ro+108,cc4);
  put32(R,ro+112,pm4); put32(R,ro+116,postH2);
  put32(R,ro+120,cf); put32(R,ro+124,ev);
  put32(R,ro+128,ig(M,64)); put32(R,ro+132,ig(M,68));
  put32(R,ro+136,rk);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  e1s(OB," mode="); e1i(OB,mode as i64);
  e1s(OB," w="); e1i(OB,w as i64);
  e1s(OB," rk="); e1i(OB,rk as i64);
  if(c2w>0){e1s(OB," c2w="); e1i(OB,c2w as i64);}
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB," cf="); e1i(OB,cf as i64);
  e1s(OB," ev="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," exile="); e1i(OB,ex as i64);
  e1s(OB," cdrop="); e1i(OB,cd as i64);
  e1s(OB," R1[postR="); e1i(OB,r1 as i64);
  e1s(OB," rec="); e1i(OB,rec1 as i64);
  e1s(OB," cc="); e1i(OB,cc1 as i64);
  e1s(OB," prm="); e1i(OB,pm1 as i64);
  e1s(OB,"] R2[postR="); e1i(OB,r2 as i64);
  e1s(OB," rec="); e1i(OB,rec2 as i64);
  e1s(OB," cc="); e1i(OB,cc2 as i64);
  e1s(OB," prm="); e1i(OB,pm2 as i64);
  e1s(OB,"] R3[postR="); e1i(OB,r3 as i64);
  e1s(OB," rec="); e1i(OB,rec3 as i64);
  e1s(OB," cc="); e1i(OB,cc3 as i64);
  e1s(OB," prm="); e1i(OB,pm3 as i64);
  e1s(OB,"] postH="); e1i(OB,postH as i64);
  e1s(OB," recT="); e1i(OB,recT as i64);
  e1s(OB," ccT="); e1i(OB,ccT as i64);
  e1s(OB," prmT="); e1i(OB,prmT as i64);
  e1s(OB," rkcost="); e1i(OB,ig(M,64) as i64);
  e1s(OB," rkmoves="); e1i(OB,ig(M,68) as i64);
  if(c2w>0){
    e1s(OB," R4[postR="); e1i(OB,r4 as i64);
    e1s(OB," rec="); e1i(OB,rec4 as i64);
    e1s(OB," cc="); e1i(OB,cc4 as i64);
    e1s(OB," prm="); e1i(OB,pm4 as i64);
    e1s(OB,"] postH2="); e1i(OB,postH2 as i64);
  }
  e1s(OB,"\n");
  return;
}
// Outcome-offset invariance between two rows (bases ba, bb):
// all outcome fields must be equal across rk within one world.
// Scan-cost offsets (44,60,76,92,108) and rank offsets
// (128,132,136) are allowed to differ (that is the experiment).
fn inv_pair(R:[]u8,ba:i32,bb:i32)i32 {
  let ok:i32=1;
  if(ig(R,ba)!=ig(R,bb)){ok=0;}
  if(ig(R,ba+4)!=ig(R,bb+4)){ok=0;}
  if(ig(R,ba+8)!=ig(R,bb+8)){ok=0;}
  if(ig(R,ba+12)!=ig(R,bb+12)){ok=0;}
  if(ig(R,ba+16)!=ig(R,bb+16)){ok=0;}
  if(ig(R,ba+20)!=ig(R,bb+20)){ok=0;}
  if(ig(R,ba+24)!=ig(R,bb+24)){ok=0;}
  if(ig(R,ba+28)!=ig(R,bb+28)){ok=0;}
  if(ig(R,ba+32)!=ig(R,bb+32)){ok=0;}
  if(ig(R,ba+36)!=ig(R,bb+36)){ok=0;}
  if(ig(R,ba+40)!=ig(R,bb+40)){ok=0;}
  if(ig(R,ba+48)!=ig(R,bb+48)){ok=0;}
  if(ig(R,ba+52)!=ig(R,bb+52)){ok=0;}
  if(ig(R,ba+56)!=ig(R,bb+56)){ok=0;}
  if(ig(R,ba+64)!=ig(R,bb+64)){ok=0;}
  if(ig(R,ba+68)!=ig(R,bb+68)){ok=0;}
  if(ig(R,ba+72)!=ig(R,bb+72)){ok=0;}
  if(ig(R,ba+80)!=ig(R,bb+80)){ok=0;}
  if(ig(R,ba+84)!=ig(R,bb+84)){ok=0;}
  if(ig(R,ba+88)!=ig(R,bb+88)){ok=0;}
  if(ig(R,ba+96)!=ig(R,bb+96)){ok=0;}
  if(ig(R,ba+100)!=ig(R,bb+100)){ok=0;}
  if(ig(R,ba+104)!=ig(R,bb+104)){ok=0;}
  if(ig(R,ba+112)!=ig(R,bb+112)){ok=0;}
  if(ig(R,ba+116)!=ig(R,bb+116)){ok=0;}
  if(ig(R,ba+120)!=ig(R,bb+120)){ok=0;}
  if(ig(R,ba+124)!=ig(R,bb+124)){ok=0;}
  return ok;
}
fn main()i32 {
  let M:[]u8=z_alloc(4160);
  let OB:[]u8=z_alloc(16384);
  put32(OB,0,0);
  let R:[]u8=z_alloc(2048);
  e1s(OB,"LANE=RANK-LAZY\n");
  // 11 rows: M2C2 anchor + headline + threshold variant,
  // then 4 churn-pattern variants x (rk0, rk4).
  run_promo(M,OB,6,1,21,"COND=M2C2-RK0",R,0,10,0);
  run_promo(M,OB,6,1,21,"COND=M2C2-RK4",R,144,10,4);
  run_promo(M,OB,6,1,21,"COND=M2C2-RK5",R,288,10,5);
  run_promo(M,OB,6,1,40,"COND=V1-RK0",R,432,10,0);
  run_promo(M,OB,6,1,40,"COND=V1-RK4",R,576,10,4);
  run_promo(M,OB,6,2,21,"COND=V2-RK0",R,720,10,0);
  run_promo(M,OB,6,2,21,"COND=V2-RK4",R,864,10,4);
  run_promo(M,OB,6,3,21,"COND=V3-RK0",R,1008,10,0);
  run_promo(M,OB,6,3,21,"COND=V3-RK4",R,1152,10,4);
  run_promo(M,OB,6,0,21,"COND=V4-RK0",R,1296,10,0);
  run_promo(M,OB,6,0,21,"COND=V4-RK4",R,1440,10,4);
  // K1 HEADLINE-NET4: anchor row == EXILE-PROMOTION PXP-M2C2
  // bit-for-bit (substrate carried over unchanged), and the
  // frozen headline bar NET4 < 1132.
  let k1:i32=1;
  if(ig(R,0)!=35 || ig(R,4)!=0){k1=0;}
  if(ig(R,8)!=20 || ig(R,12)!=15){k1=0;}
  if(ig(R,16)!=80 || ig(R,20)!=48 || ig(R,24)!=0){k1=0;}
  if(ig(R,28)!=76 || ig(R,32)!=0){k1=0;}
  if(ig(R,36)!=35 || ig(R,40)!=40 || ig(R,44)!=420 || ig(R,48)!=20){k1=0;}
  if(ig(R,52)!=35 || ig(R,56)!=0 || ig(R,60)!=0 || ig(R,64)!=0){k1=0;}
  if(ig(R,68)!=35 || ig(R,72)!=0 || ig(R,76)!=0 || ig(R,80)!=0){k1=0;}
  if(ig(R,84)!=35 || ig(R,88)!=56 || ig(R,92)!=1132 || ig(R,96)!=28){k1=0;}
  if(ig(R,100)!=35 || ig(R,104)!=16 || ig(R,108)!=712 || ig(R,112)!=8){k1=0;}
  if(ig(R,116)!=35 || ig(R,120)!=80 || ig(R,124)!=48){k1=0;}
  if(ig(R,128)!=0 || ig(R,132)!=0 || ig(R,136)!=0){k1=0;}
  let net4:i32=ig(R,144+92)+ig(R,144+128);
  if(net4>=1132){k1=0;}
  e1s(OB,"K1 HEADLINE-NET4 -> "); e1s(OB,pf(k1));
  e1s(OB," NET4="); e1i(OB,net4 as i64);
  e1s(OB," (ccT4="); e1i(OB,ig(R,144+92) as i64);
  e1s(OB," rkT4="); e1i(OB,ig(R,144+128) as i64);
  e1s(OB,")\n");
  // K2 ROBUST-SEED: lazy win generalizes across churn patterns.
  // Per-world FIFO baselines; PASS requires >= 3 of 4 variants.
  let k2:i32=1;
  let wins:i32=0;
  let v:i32=0;
  while(v<4){
    let b0:i32=(3+2*v)*144;
    let b4:i32=(4+2*v)*144;
    let net0:i32=ig(R,b0+92)+ig(R,b0+128);
    let n4:i32=ig(R,b4+92)+ig(R,b4+128);
    e1s(OB,"  V"); e1i(OB,(v+1) as i64);
    e1s(OB," NET0="); e1i(OB,net0 as i64);
    e1s(OB," NET4="); e1i(OB,n4 as i64);
    if(n4<net0){e1s(OB," win\n");wins=wins+1;}
    if(n4>=net0){e1s(OB," nowin\n");}
    v=v+1;
  }
  if(wins<3){k2=0;}
  e1s(OB,"K2 ROBUST-SEED -> "); e1s(OB,pf(k2));
  e1s(OB," wins="); e1i(OB,wins as i64); e1s(OB,"/4\n");
  // K3 THRESHOLD-VARIANT: NET5 < 1132 on M2C2.
  let k3:i32=1;
  let net5:i32=ig(R,288+92)+ig(R,288+128);
  if(net5>=1132){k3=0;}
  e1s(OB,"K3 THRESHOLD-VARIANT -> "); e1s(OB,pf(k3));
  e1s(OB," NET5="); e1i(OB,net5 as i64);
  e1s(OB," (ccT5="); e1i(OB,ig(R,288+92) as i64);
  e1s(OB," rkT5="); e1i(OB,ig(R,288+128) as i64);
  e1s(OB,")\n");
  // K4 O1-MAINTENANCE (M2C2): rkT4<=7, rkmT4<=7; rkT5<=recT,
  // rkmT5<=recT; both < 553.
  let k4:i32=1;
  if(ig(R,144+128)>7){k4=0;}
  if(ig(R,144+132)>7){k4=0;}
  let recT5:i32=ig(R,288+88);
  if(ig(R,288+128)>recT5){k4=0;}
  if(ig(R,288+132)>recT5){k4=0;}
  if(ig(R,144+128)>=553){k4=0;}
  if(ig(R,288+128)>=553){k4=0;}
  e1s(OB,"K4 O1-MAINTENANCE -> "); e1s(OB,pf(k4));
  e1s(OB," rkT5="); e1i(OB,ig(R,288+128) as i64);
  e1s(OB," recT5="); e1i(OB,recT5 as i64);
  e1s(OB,"\n");
  // K5 INVARIANCE: costs may differ, outcomes never.
  let k5:i32=1;
  if(inv_pair(R,0,144)==0){k5=0;}
  if(inv_pair(R,0,288)==0){k5=0;}
  if(inv_pair(R,432,576)==0){k5=0;}
  if(inv_pair(R,720,864)==0){k5=0;}
  if(inv_pair(R,1008,1152)==0){k5=0;}
  if(inv_pair(R,1296,1440)==0){k5=0;}
  e1s(OB,"K5 INVARIANCE -> "); e1s(OB,pf(k5)); e1s(OB,"\n");
  // K6 LEDGER: exile == ev + drop + promote; cdrop == 0; all rows.
  let k6:i32=1;
  let ro:i32=0;
  while(ro<1584){
    if(ig(R,ro+28)!=ig(R,ro+20)+ig(R,ro+24)+ig(R,ro+96)){k6=0;}
    if(ig(R,ro+32)!=0){k6=0;}
    ro=ro+144;
  }
  e1s(OB,"K6 LEDGER -> "); e1s(OB,pf(k6)); e1s(OB,"\n");
  e1s(OB,"K7 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1){all=1;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

// ts_driver.zag -- ADAPT-REVISION-OPS battery.
//
// T1 TRUNCATE-TAIL-BREAK: Xt=[1,1] created; world kills X's tail
//   (13,1,14); X broken, Xt intact. Expect ans=-2 on (11,73,99),
//   Xt live, no revision fired (no type-16 targets Xt).
// T2 TRUNCATE-PREFIX-BREAK: Xt=[1,1] created; world kills a prefix
//   link (12,1,13); X and Xt both broken (contract break). Expect
//   ans=-2, Xt still live (not retired), no revision.
// S1 SPECIALIZE-REVISE: Xs=[1,2] created via (12,2,99); world
//   replaces it with (12,3,98); Xs stale, X intact. Expect
//   REVISE2-STALE kind=3, Xs2=[1,3] with type-16 Xs2->Xs, Xs
//   retired, ans=98, chain Xs2->Xs->X, Tt untouched.
// S2 SPECIALIZE-RETRACT: Xs=[1,2] created; world kills (12,2,99),
//   teaches nothing. Expect ans=-2, Xs retired, nothing replaces
//   it, type-16 Xs->X persists.
// S3 SPECIALIZE-NOCHANGE: no world change; re-query (11,73,99).
//   Expect ans=99, Xs live, no revision.
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn ts_gap(W:[]u8)void {
  let i:i32=0;
  while(i<10){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn ts_live(W:[]u8,m:i32)i32 {
  if(m<2){return 0;}
  if(ng(W,m,36)==1 && ng(W,m,0)==20){return 1;}
  return 0;
}
fn ts_has16(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==16 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn ts_src16(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// lowest-id live adapted MAP with type-16 target xp, or -1.
fn ts_find_reviser(W:[]u8,xp:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ts_live(W,m)==1 && ts_src16(W,m)==xp){return m;}
    m=m+1;
  }
  return -1;
}
fn ts_count16_edges(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff no type-16 edge targets xp.
fn ts_no16_to(W:[]u8,xp:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16 && eg(W,e,8)==xp){return 0;}
    e=e+1;
  }
  return 1;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn ts_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// lowest-id live adapted MAP with relseq exp[0..n-1], or -1.
fn ts_find_adapted_relseq(W:[]u8,exp:[]u8,n:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ts_live(W,m)==1 && ts_src16(W,m)>=0 && ts_relseq_eq(W,m,exp,n)==1){return m;}
    m=m+1;
  }
  return -1;
}
// lowest-id live fact node with (s,r,o), or -1.
fn ts_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// cc_satisfy length of MAP m from s, or -1.
fn ts_satisfy_len(W:[]u8,m:i32,s:i32)i32 {
  let vb:[]u8=z_alloc(36);
  let fb:[]u8=z_alloc(32);
  return cc_satisfy(W,m,s,vb,fb);
}
// withdraw a cached shortcut fact if present.
fn ts_withdraw(W:[]u8,s:i32,r:i32,o:i32)void {
  let f:i32=ts_find_fact(W,s,r,o);
  if(f>=0){ns(W,f,36,0);}
  return;
}
// Train X ([1,1,1]) via ev_query_revise2. out: mapx, f1112, f1213, f1314.
// Withdraws the (11,71,14) shortcut fact: it is a cached query
// answer, not a world regularity, and the SPECIALIZE operator must
// not treat it as an alternative relation.
fn ts_train_x(W:[]u8,out:[]u8)void {
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,1,13);
  let f3:i32=ev_teach(W,13,1,14);
  let x:i32=ev_query_revise2(W,11,71,14,0);
  emit("TS-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  set32(out,4,f1); set32(out,8,f2); set32(out,12,f3);
  ts_withdraw(W,11,71,14);
  return;
}

// ---- T1: truncate, base tail breaks; no revision must fire ----
fn t1_truncate_tail(W:[]u8)void {
  emit("=== T1-TRUNCATE-TAIL ===\n");
  let t:[]u8=z_alloc(16);
  ts_train_x(W,t);
  let mapx:i32=get32(t,0);
  let f1314:i32=get32(t,12);
  ts_gap(W);
  let z:i32=ev_query_revise2(W,11,72,13,0);
  emit("T1-PHASE2-ANS="); e64(z); emit("\n");
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let xt:i32=ts_find_adapted_relseq(W,e11,2);
  let c0:i32=ts_count16_edges(W);
  emit("T1 mapx="); e64(mapx); emit(" xt="); e64(xt);
  emit(" c0="); e64(c0); emit("\n");
  // world change: teach-then-kill the tail fact; withdraw shortcut.
  let f940:i32=ev_teach(W,13,9,40);
  ns(W,f1314,36,0);
  ts_withdraw(W,11,72,13);
  emit("T1 WORLD-CHANGE taught (13,9,40) as "); e64(f940);
  emit(", killed (13,1,14)\n");
  let z4:i32=ev_query_revise2(W,11,73,99,0);
  emit("T1-PHASE4-ANS="); e64(z4); emit("\n");
  let p1:i32=0; if(z==13){p1=1;}
  let p2:i32=0; if(z4==-2){p2=1;}
  let p3:i32=ts_live(W,xt);
  let p4:i32=ts_no16_to(W,xt);
  let p6:i32=0; if(ts_satisfy_len(W,mapx,11)!=3){p6=1;}
  emit("T1 p1(ph2=13)="); e64(p1);
  emit(" p2(ph4=-2)="); e64(p2);
  emit(" p3(xt-live)="); e64(p3);
  emit(" p4(no16-to-xt)="); e64(p4);
  emit(" p6(x-broken)="); e64(p6); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p6==1){
    emit("T1-TRUNCATE-TAIL=PASS\n");
  } else {
    emit("T1-TRUNCATE-TAIL=FAIL\n");
  }
  return;
}

// ---- T2: truncate, prefix link breaks (contract break); no revision ----
fn t2_truncate_prefix(W:[]u8)void {
  emit("=== T2-TRUNCATE-PREFIX ===\n");
  let t:[]u8=z_alloc(16);
  ts_train_x(W,t);
  let mapx:i32=get32(t,0);
  let f1213:i32=get32(t,8);
  ts_gap(W);
  let z:i32=ev_query_revise2(W,11,72,13,0);
  emit("T2-PHASE2-ANS="); e64(z); emit("\n");
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let xt:i32=ts_find_adapted_relseq(W,e11,2);
  let c0:i32=ts_count16_edges(W);
  // world change inside the prefix: teach-then-kill; withdraw shortcut.
  let f520:i32=ev_teach(W,12,5,20);
  ns(W,f1213,36,0);
  ts_withdraw(W,11,72,13);
  emit("T2 WORLD-CHANGE taught (12,5,20) as "); e64(f520);
  emit(", killed (12,1,13)\n");
  let z4:i32=ev_query_revise2(W,11,73,13,0);
  emit("T2-PHASE4-ANS="); e64(z4); emit("\n");
  let p1:i32=0; if(z==13){p1=1;}
  let p2:i32=0; if(z4==-2){p2=1;}
  let p3:i32=ts_live(W,xt);
  let p4:i32=ts_no16_to(W,xt);
  emit("T2 p1(ph2=13)="); e64(p1);
  emit(" p2(ph4=-2)="); e64(p2);
  emit(" p3(xt-still-live)="); e64(p3);
  emit(" p4(no16-to-xt)="); e64(p4); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1){
    emit("T2-TRUNCATE-PREFIX=PASS\n");
  } else {
    emit("T2-TRUNCATE-PREFIX=FAIL\n");
  }
  return;
}

// ---- S1: specialize, then revise with the new alternative ----
// World change uses a CYCLIC alternative (12,3,12): t2_gather rejects
// the 11->12->12 cycle, so rebind cannot steal the answer and the
// revision bracket must fire. Expect revision to Xs2=[1,3] -> 12.
fn s1_specialize_revise(W:[]u8)void {
  emit("=== S1-SPECIALIZE-REVISE ===\n");
  let t:[]u8=z_alloc(16);
  ts_train_x(W,t);
  let mapx:i32=get32(t,0);
  let falt:i32=ev_teach(W,12,2,99);
  ts_gap(W);
  let z:i32=ev_query_revise2(W,11,72,99,0);
  emit("S1-PHASE2-ANS="); e64(z); emit("\n");
  let e12:[]u8=z_alloc(8);
  set32(e12,0,1); set32(e12,4,2);
  let xs:i32=ts_find_adapted_relseq(W,e12,2);
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let tt:i32=ts_find_adapted_relseq(W,e11,2);
  let c0:i32=ts_count16_edges(W);
  emit("S1 mapx="); e64(mapx); emit(" xs="); e64(xs);
  emit(" tt="); e64(tt); emit(" c0="); e64(c0); emit("\n");
  // world change: teach-then-kill the specialized link; withdraw.
  // (12,3,12) is cyclic; rebind's t2_gather rejects it.
  let f312:i32=ev_teach(W,12,3,12);
  ns(W,falt,36,0);
  ts_withdraw(W,11,72,99);
  emit("S1 WORLD-CHANGE taught (12,3,12) as "); e64(f312);
  emit(", killed (12,2,99)\n");
  let z4:i32=ev_query_revise2(W,11,73,12,0);
  emit("S1-PHASE4-ANS="); e64(z4); emit("\n");
  let xs2:i32=ts_find_reviser(W,xs);
  let c1:i32=ts_count16_edges(W);
  let e13:[]u8=z_alloc(8);
  set32(e13,0,1); set32(e13,4,3);
  let p1:i32=0; if(z==99){p1=1;}
  let p2:i32=0; if(z4==12){p2=1;}
  let p3:i32=0; if(xs2>=0 && ts_relseq_eq(W,xs2,e13,2)==1){p3=1;}
  let p4:i32=0; if(xs2>=0 && ts_src16(W,xs2)==xs){p4=1;}
  let p5:i32=0; if(ts_live(W,xs)==0){p5=1;}
  let p6:i32=ts_has16(W,xs,mapx);
  let p7:i32=ts_live(W,mapx);
  let p8:i32=0; if(ts_satisfy_len(W,mapx,11)==3){p8=1;}
  let p9:i32=ts_live(W,tt);
  let p10:i32=ts_no16_to(W,tt);
  let p11:i32=0; if(c1==c0+1){p11=1;}
  emit("S1 p1(ph2=99)="); e64(p1);
  emit(" p2(ph4=12)="); e64(p2);
  emit(" p3(xs2-seq13)="); e64(p3);
  emit(" p4(xs2-16-xs)="); e64(p4);
  emit(" p5(xs-retired)="); e64(p5);
  emit(" p6(xs-16-x)="); e64(p6);
  emit(" p7(x-live)="); e64(p7);
  emit(" p8(x-intact)="); e64(p8);
  emit(" p9(tt-live)="); e64(p9);
  emit(" p10(no16-to-tt)="); e64(p10);
  emit(" p11(edges+1)="); e64(p11); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1 && p9==1 && p10==1 && p11==1){
    emit("S1-SPECIALIZE-REVISE=PASS\n");
  } else {
    emit("S1-SPECIALIZE-REVISE=FAIL\n");
  }
  return;
}

// ---- S2: specialize, then retract on dead end ----
fn s2_specialize_retract(W:[]u8)void {
  emit("=== S2-SPECIALIZE-RETRACT ===\n");
  let t:[]u8=z_alloc(16);
  ts_train_x(W,t);
  let mapx:i32=get32(t,0);
  let falt:i32=ev_teach(W,12,2,99);
  ts_gap(W);
  let z:i32=ev_query_revise2(W,11,72,99,0);
  emit("S2-PHASE2-ANS="); e64(z); emit("\n");
  let e12:[]u8=z_alloc(8);
  set32(e12,0,1); set32(e12,4,2);
  let xs:i32=ts_find_adapted_relseq(W,e12,2);
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let tt:i32=ts_find_adapted_relseq(W,e11,2);
  let c0:i32=ts_count16_edges(W);
  // world change: kill the specialized link, teach nothing.
  ns(W,falt,36,0);
  ts_withdraw(W,11,72,99);
  emit("S2 WORLD-CHANGE killed (12,2,99), dead end\n");
  let z4:i32=ev_query_revise2(W,11,73,99,0);
  emit("S2-PHASE4-ANS="); e64(z4); emit("\n");
  let c1:i32=ts_count16_edges(W);
  let p1:i32=0; if(z==99){p1=1;}
  let p2:i32=0; if(z4==-2){p2=1;}
  let p3:i32=0; if(ts_live(W,xs)==0){p3=1;}
  let p4:i32=ts_has16(W,xs,mapx);
  let p5:i32=0; if(c1==c0){p5=1;}
  let p6:i32=ts_live(W,mapx);
  let p7:i32=0; if(ts_satisfy_len(W,mapx,11)==3){p7=1;}
  let p8:i32=ts_live(W,tt);
  emit("S2 p1(ph2=99)="); e64(p1);
  emit(" p2(ph4=-2)="); e64(p2);
  emit(" p3(xs-retired)="); e64(p3);
  emit(" p4(xs-16-x)="); e64(p4);
  emit(" p5(edges-unchanged)="); e64(p5);
  emit(" p6(x-live)="); e64(p6);
  emit(" p7(x-intact)="); e64(p7);
  emit(" p8(tt-live)="); e64(p8); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1){
    emit("S2-SPECIALIZE-RETRACT=PASS\n");
  } else {
    emit("S2-SPECIALIZE-RETRACT=FAIL\n");
  }
  return;
}

// ---- S3: specialize, no world change; no revision ----
fn s3_specialize_nochange(W:[]u8)void {
  emit("=== S3-SPECIALIZE-NOCHANGE ===\n");
  let t:[]u8=z_alloc(16);
  ts_train_x(W,t);
  let falt:i32=ev_teach(W,12,2,99);
  ts_gap(W);
  let z:i32=ev_query_revise2(W,11,72,99,0);
  emit("S3-PHASE2-ANS="); e64(z); emit("\n");
  let e12:[]u8=z_alloc(8);
  set32(e12,0,1); set32(e12,4,2);
  let xs:i32=ts_find_adapted_relseq(W,e12,2);
  let c0:i32=ts_count16_edges(W);
  let z4:i32=ev_query_revise2(W,11,73,99,0);
  emit("S3-PHASE4-ANS="); e64(z4); emit("\n");
  let c1:i32=ts_count16_edges(W);
  let p1:i32=0; if(z==99){p1=1;}
  let p2:i32=0; if(z4==99){p2=1;}
  let p3:i32=ts_live(W,xs);
  let p4:i32=ts_no16_to(W,xs);
  let p5:i32=0; if(c1==c0){p5=1;}
  emit("S3 p1(ph2=99)="); e64(p1);
  emit(" p2(ph4=99)="); e64(p2);
  emit(" p3(xs-live)="); e64(p3);
  emit(" p4(no16-to-xs)="); e64(p4);
  emit(" p5(edges-unchanged)="); e64(p5); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1){
    emit("S3-SPECIALIZE-NOCHANGE=PASS\n");
  } else {
    emit("S3-SPECIALIZE-NOCHANGE=FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("TS-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); t1_truncate_tail(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); t2_truncate_prefix(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); s1_specialize_revise(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); s2_specialize_retract(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); s3_specialize_nochange(W5);
  emit("TS-END\n");
  return 0;
}

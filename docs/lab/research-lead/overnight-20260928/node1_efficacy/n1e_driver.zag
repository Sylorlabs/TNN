// Node 1 Efficacy Pilot driver.
// Tests whether H3-lite Node 1's learned trial order reduces trial cost.
// Works on both H3-lite variant and frozen base (policy scan returns -1 on frozen).
// Pure Zag. No Python.

// Find policy node (tag 40, subtype 1) by workspace scan. Returns -1 if none.
fn n1e_find_policy(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==1){return n;}
    n=n+1;
  }
  return -1;
}
fn n1e_emit_order(W:[]u8)void {
  let pol:i32=n1e_find_policy(W);
  if(pol<0){emit("order:none(frozen)"); return;}
  emit("order:[");
  let s:i32=0;
  while(s<6){
    e64(ng(W,pol,8+s*4));
    if(s<5){emit(",");}
    s=s+1;
  }
  emit("] rej=");
  e64(ng(W,pol,32));
  return;
}
// One miss: teach 3-link chain (s,99,a),(a,99,b),(b,99,c), then query
// (s,20) unmasked with expected=3. The count family (4) should succeed;
// chain families 0,1 produce wrong answers and fail; 2,3 have no candidates.
// Returns t2_try_verify invocation count for this trial (from header 16).
fn n1e_miss(W:[]u8,s:i32,verbose:i32)i32 {
  let a:i32=2000+s; let b:i32=3000+s; let c:i32=4000+s;
  ev_teach(W,s,99,a);
  ev_teach(W,a,99,b);
  ev_teach(W,b,99,c);
  let ans:i32=ev_query(W,s,20,3,0);
  let h:i32=hg(W,16);
  let tried:i32=h/1024;
  if(verbose==1){
    emit("miss s="); e64(s);
    emit(" ans="); e64(ans);
    emit(" tried="); e64(tried);
    emit(" ");
    n1e_emit_order(W);
    emit("\n");
  }
  if(ans!=3){
    emit("WARN: miss s="); e64(s);
    emit(" ans="); e64(ans);
    emit(" expected 3\n");
  }
  return tried;
}
// Run n misses starting at subject s0. Returns total tried count E.
fn n1e_phase(W:[]u8,s0:i32,n:i32,verbose:i32)i32 {
  let total:i32=0;
  let i:i32=0;
  while(i<n){
    let t:i32=n1e_miss(W,s0+i,verbose);
    total=total+t;
    i=i+1;
  }
  return total;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  emit("N1E-PILOT-BEGIN\n");
  emit("PHASE-A (s=1..20):\n");
  let ea:i32=n1e_phase(W,1,20,1);
  emit("E(A)="); e64(ea); emit("\n");
  emit("PHASE-B (s=101..120):\n");
  let eb:i32=n1e_phase(W,101,20,1);
  emit("E(B)="); e64(eb); emit("\n");
  if(eb>0){
    let r100:i32=ea*100/eb;
    emit("R*100="); e64(r100); emit("\n");
    if(r100>115){emit("N1E-TRANSFER-YES\n");}
    else {emit("N1E-TRANSFER-NO\n");}
  } else {
    emit("N1E-EB-ZERO\n");
  }
  emit("N1E-PILOT-END\n");
  return 0;
}

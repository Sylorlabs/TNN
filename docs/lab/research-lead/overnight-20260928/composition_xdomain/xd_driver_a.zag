// xd_driver_a.zag -- Cross-domain composition driver for Hypothesis A.
//
// X domain: chain-following (r=81, plen-4 chains). Queries (s,91)->endpoint.
// Y domain: count aggregation (r=82). Queries (s,92)->link count. Y MAPs are
// count graphs (guard/set links + INC cells + MOV epilogue); their output is
// computed arithmetically, not retrieved by navigation.
// Z: chain-then-count, query (31,93)->2. Requires X-walk to 34, then Y-count
// of 34 = 2. No paired X/Y examples. No compose hint.
//
// Arms: TREAT, ABL-X (r=91 MAPs deleted), ABL-Y (r=92 MAPs deleted), FRESH.
// Question: does A's plen-contract composition admit a non-chain MAP?

fn xd_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn xd_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// 1 if the MAP's executable graph contains an INC cell (tag 103).
fn xd_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// MAP census line with A's contract (plen, or -1 if not a chain MAP).
fn xd_class_a(W:[]u8,m:i32)void {
  let p:i32=cx_contract(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" contract="); e64(p);
  emit(" class=");
  if(p>=2){emit("chain");}
  else {
    if(xd_has_inc(W,ng(W,m,20))==1){emit("count");}
    else {emit("other");}
  }
  emit("\n");
  return;
}
fn xd_census(W:[]u8)void {
  emit("maps="); e64(xd_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){xd_class_a(W,m);}
    m=m+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn xd_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn xd_count_type(W:[]u8,t:i32)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==t){n=n+1;}
    e=e+1;
  }
  return n;
}
fn xd_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn xd_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xd_trainX(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=ev_query(W,11,91,14,0);
  emit("X1 ans="); e64(x1); xd_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=ev_query(W,15,91,18,0);
  emit("X2 ans="); e64(x2); xd_tstat(W);
  return;
}
fn xd_trainY(W:[]u8)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=ev_query(W,50,92,3,0);
  emit("Y1 ans="); e64(y1); xd_tstat(W);
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=ev_query(W,60,92,4,0);
  emit("Y2 ans="); e64(y2); xd_tstat(W);
  return;
}
fn xd_zfacts(W:[]u8)void {
  ev_teach(W,31,81,32); ev_teach(W,32,81,33); ev_teach(W,33,81,34);
  ev_teach(W,34,82,35); ev_teach(W,35,82,36);
  return;
}
fn xd_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,93,2,0);
  emit("Z ans="); e64(z); xd_tstat(W);
  let zm:i32=xd_find_map(W,31,93);
  emit("ZMAP id="); e64(zm);
  emit(" link14="); e64(xd_count_type(W,14));
  emit(" link15="); e64(xd_count_type(W,15));
  emit("\n");
  return;
}
fn xd_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  xd_trainX(W);
  xd_trainY(W);
  xd_gap(W);
  xd_census(W);
  xd_zfacts(W);
  xd_zquery(W);
  return;
}
fn xd_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  xd_trainX(W);
  xd_trainY(W);
  xd_del_map_r(W,91);
  emit("maps after del="); e64(xd_count_maps(W)); emit("\n");
  xd_gap(W);
  xd_zfacts(W);
  xd_zquery(W);
  return;
}
fn xd_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  xd_trainX(W);
  xd_trainY(W);
  xd_del_map_r(W,92);
  emit("maps after del="); e64(xd_count_maps(W)); emit("\n");
  xd_gap(W);
  xd_zfacts(W);
  xd_zquery(W);
  return;
}
fn xd_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  xd_gap(W);
  xd_zfacts(W);
  xd_zquery(W);
  return;
}
fn main()i32 {
  emit("XD-A-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); xd_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); xd_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); xd_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); xd_fresh(W4);
  emit("XD-A-END\n");
  return 0;
}

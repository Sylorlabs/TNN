// ============ PROTECT-THE-HOW DRIVER (Micah Q6) ============
// Teach procedure P (chain MAP). Derive 20 answers from P via shape
// rebind, cache as INFERRED facts. Heavy interference (1000 teaches).
// Compare retention: control (vanilla 1-tier eviction) vs treatment
// (3-tier: derived answers -> other nodes -> generative structure).
// Then derive 20 NEW answers from fresh subjects; measure recovery cost.
// Pure Zag. Diagnostic driver; cognition untouched (control) except
// evict_node in treatment (see ph_evict_trt.zag).

fn ph_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn ph_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn ph_find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn ph_fact_val(W:[]u8,s:i32,r:i32,exp:i32)i32 {
  let n:i32=ph_find_fact(W,s,r);
  if(n<0){return 0;}
  if(ng(W,n,28)!=exp){return 0;}
  return 1;
}
fn ph_map_ok(W:[]u8,m:i32,s:i32,r:i32)i32 {
  if(m<2 || m>=1024){return 0;}
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  if(ng(W,m,8)!=s){return 0;}
  if(ng(W,m,4)!=r){return 0;}
  return 1;
}
// Count op cells reachable from root via guard-true/seq walk.
fn ph_walk_cells(W:[]u8,root:i32)i32 {
  if(root<2 || root>=1024){return 0;}
  if(ng(W,root,36)!=1){return 0;}
  let tg:i32=ng(W,root,0);
  if(tg!=101 && tg!=102 && tg!=103 && tg!=104){return 0;}
  let c:i32=0; let cur:i32=root; let st:i32=0;
  while(cur>=2 && cur<1024 && st<64){
    let t2:i32=ng(W,cur,0);
    if(t2==101 || t2==102 || t2==103 || t2==104){ c=c+1; }
    if(t2==102){ cur=ng(W,cur,12); }
    else { if(t2==101 || t2==103 || t2==104){ cur=seq_nx(W,cur); }
    else { cur=-1; } }
    st=st+1;
  }
  return c;
}
// Read chain length (guard count) generically from P's graph topology.
fn ph_plen(W:[]u8,root:i32)i32 {
  if(root<2 || root>=1024){return -1;}
  if(ng(W,root,36)!=1){return -1;}
  let tg:i32=ng(W,root,0);
  if(tg!=101 && tg!=102 && tg!=103 && tg!=104){return -1;}
  let c:i32=0; let cur:i32=root; let st:i32=0;
  while(cur>=2 && cur<1024 && st<64){
    let t2:i32=ng(W,cur,0);
    if(t2!=101 && t2!=102 && t2!=103 && t2!=104){ cur=-1; }
    else {
      if(t2==102){ c=c+1; cur=ng(W,cur,12); }
      else { cur=seq_nx(W,cur); }
    }
    st=st+1;
  }
  return c;
}
// Derive answer for subject s by re-instantiating P's chain shape on
// s's local path. Shape (links) read from P, not hardcoded by caller.
// Returns answer or -2.
fn ph_rebind(W:[]u8,root:i32,links:i32,s:i32)i32 {
  if(links<1 || links>4){return -2;}
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,s,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==links+1){
      let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
      let j:i32=0;
      while(j<=links){ set32(v,j*4,get32(paths,base+4+j*4)); j=j+1; }
      j=0;
      while(j<links){ set32(f,j*4,get32(paths,base+24+j*4)); j=j+1; }
      let r2:i32=t2_asm_chain(W,v,links+1,f);
      let a:i32=-2;
      if(r2>=2){ a=t2_exec(W,r2,s); }
      if(a!=-2 && a!=-999999){ return a; }
    }
    p=p+1;
  }
  return -2;
}
fn ph_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

fn ph_run()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("== PROTECT-HOW ==\n");
  // Phase 1: teach P (4-hop chain), query to promote MAP.
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  hs(W,16,0);
  let a0:i32=ev_query(W,1,40,5,0);
  let vc0:i32=hg(W,16)/1024;
  ph_rep("build_ans",a0); ph_rep("build_verifies",vc0);
  let pmap:i32=ph_find_map(W,1,40);
  let proot:i32=-1;
  if(pmap>=0){ proot=ng(W,pmap,20); }
  let plen:i32=ph_plen(W,proot);
  let pcells:i32=ph_walk_cells(W,proot);
  ph_rep("p_map",pmap); ph_rep("p_root",proot); ph_rep("p_links",plen); ph_rep("p_cells",pcells);
  let rex0:i32=-999998;
  if(pcells>0){ rex0=t2_exec(W,proot,1); }
  ph_rep("p_reexec0",rex0);
  // Phase 2: derive 20 answers from P via shape rebind; cache INFERRED.
  let dok:i32=0; let k:i32=0;
  while(k<20){
    let s:i32=101+k*10;
    ev_teach(W,s,11,s+1); ev_teach(W,s+1,11,s+2); ev_teach(W,s+2,11,s+3); ev_teach(W,s+3,11,s+4);
    let ans:i32=ph_rebind(W,proot,plen,s);
    if(ans==s+4){
      let fn2:i32=ev_teach(W,s,40,ans);
      if(fn2>=0){ ns(W,fn2,16,3); dok=dok+1; }
    }
    k=k+1;
  }
  ph_rep("derived_ok",dok);
  // mark shadow fact as derived too (cached answer from P)
  let sh:i32=ph_find_fact(W,1,40);
  if(sh>=0){ ns(W,sh,16,3); }
  ph_rep("pre_live",hg(W,20)); ph_rep("pre_edges",hg(W,24));
  ph_rep("pre_cells",ph_walk_cells(W,proot));
  ph_rep("pre_facts",ph_count_tag(W,1)); ph_rep("pre_maps",ph_count_tag(W,20));
  // Phase 3: heavy interference, 1000 unrelated teaches.
  let i:i32=0;
  while(i<1000){ ev_teach(W,700+i,41,i); i=i+1; }
  ph_rep("post_live",hg(W,20)); ph_rep("post_edges",hg(W,24));
  // Phase 4: survival.
  let pm:i32=ph_map_ok(W,pmap,1,40);
  ph_rep("post_p_map",pm);
  let pc2:i32=0; let rx:i32=-999998;
  if(pm==1){
    let rt:i32=ng(W,pmap,20);
    pc2=ph_walk_cells(W,rt);
    if(pc2>0){ rx=t2_exec(W,rt,1); }
  }
  ph_rep("post_p_cells",pc2); ph_rep("post_p_reexec",rx);
  let asurv:i32=0; k=0;
  while(k<20){
    let s:i32=101+k*10;
    if(ph_fact_val(W,s,40,s+4)==1){ asurv=asurv+1; }
    k=k+1;
  }
  ph_rep("post_answers",asurv);
  ph_rep("post_shadow",ph_fact_val(W,1,40,5));
  ph_rep("post_facts",ph_count_tag(W,1)); ph_rep("post_maps",ph_count_tag(W,20));
  // Phase 5: 20 NEW subjects. Teach chains, then derive answers.
  // Treatment path: rebind from P if alive. Fallback: trial via ev_query.
  let hits:i32=0; let rbok:i32=0; let tr_ok:i32=0; let fl:i32=0;
  let tvc:i32=0; let rbc:i32=0;
  k=0;
  while(k<20){
    let s:i32=501+k*10;
    ev_teach(W,s,11,s+1); ev_teach(W,s+1,11,s+2); ev_teach(W,s+2,11,s+3); ev_teach(W,s+3,11,s+4);
    let an:i32=activate(W,s,40);
    if(an>=0){ hits=hits+1; }
    else {
      let ra:i32=-2;
      if(pm==1){
        let rt2:i32=ng(W,pmap,20);
        ra=ph_rebind(W,rt2,plen,s);
        rbc=rbc+1;
      }
      if(ra==s+4){
        rbok=rbok+1;
        let f3:i32=ev_teach(W,s,40,ra);
        if(f3>=0){ ns(W,f3,16,3); }
      }
      else {
        hs(W,16,0);
        let ta:i32=ev_query(W,s,40,s+4,0);
        tvc=tvc+hg(W,16)/1024;
        if(ta==s+4){ tr_ok=tr_ok+1; } else { fl=fl+1; }
      }
    }
    k=k+1;
  }
  ph_rep("new_hits",hits); ph_rep("new_rebind_ok",rbok); ph_rep("new_rebind_try",rbc);
  ph_rep("new_trial_ok",tr_ok); ph_rep("new_fail",fl);
  ph_rep("new_trial_verifies",tvc);
  ph_rep("final_live",hg(W,20)); ph_rep("final_facts",ph_count_tag(W,1));
  ph_rep("final_maps",ph_count_tag(W,20));
  emit("PH_DONE\n");
  return;
}
fn main()i32 { ph_run(); return 0; }

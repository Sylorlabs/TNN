// TREATMENT evict_node (replaces base lines 254-275 verbatim).
// 3-tier victim selection. Q6: permit cached answers to die before the
// procedure P. Tier 1: derived cached answers (tag 1 FACT, field16==3
// INFERRED, i.e. answers derived from P and cached by the driver).
// Tier 2: all other nodes EXCEPT generative structure. Tier 3 (last
// resort): generative structure = MAP nodes (tag 20) + op cells
// (tags 101-104). Protection edges (is_prot) still respected in all tiers.
// The eviction action itself is verbatim from the base.
fn evict_node(W:[]u8)i32 {
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0 && ng(W,n,0)==1 && ng(W,n,16)==3){
      let b:i32=bid(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){
    i=0; bb=1000000;
    while(i<1024){
      let n:i32=cur+i; if(n>=1024){n=n-1024;}
      if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
        let tg:i32=ng(W,n,0);
        if(tg!=20 && tg!=101 && tg!=102 && tg!=103 && tg!=104){
          let b:i32=bid(W,n);
          if(b<bb){bb=b; best=n;}
        }
      }
      i=i+1;
    }
  }
  if(best<0){
    i=0; bb=1000000;
    while(i<1024){
      let n:i32=cur+i; if(n>=1024){n=n-1024;}
      if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
        let tg:i32=ng(W,n,0);
        if(tg==20 || tg==101 || tg==102 || tg==103 || tg==104){
          let b:i32=bid(W,n);
          if(b<bb){bb=b; best=n;}
        }
      }
      i=i+1;
    }
  }
  if(best<0){return -1;}
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

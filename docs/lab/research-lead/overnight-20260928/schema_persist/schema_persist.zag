// schema_persist.zag -- Schema vs instance persistence economics.
// Prereg 4b1d709c0 frozen before this file. Pure Zag.
// Domain: threshold classification, x in 1..100.
// Instance = fitted cutoff from T1 persisted verbatim (1 int).
// Schema = threshold form discovered on T1 (1 int flag) + per-task refit.
// Fresh = nearest-neighbor on current task only (competent relearn).
// Ablated = exact-match memorizer, form forced 0.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ---- fixed train sets (6 points each, ascending) ----
fn tx(t:i32,j:i32)i32 {
  if(t==1){
    if(j==0){return 8;} if(j==1){return 25;} if(j==2){return 42;}
    if(j==3){return 58;} if(j==4){return 75;} return 92;
  } else if(t==2){
    if(j==0){return 12;} if(j==1){return 29;} if(j==2){return 46;}
    if(j==3){return 63;} if(j==4){return 80;} return 97;
  } else if(t==3){
    if(j==0){return 5;} if(j==1){return 22;} if(j==2){return 39;}
    if(j==3){return 56;} if(j==4){return 73;} return 90;
  } else if(t==4){
    if(j==0){return 10;} if(j==1){return 27;} if(j==2){return 44;}
    if(j==3){return 61;} if(j==4){return 78;} return 95;
  } else {
    if(j==0){return 8;} if(j==1){return 25;} if(j==2){return 42;}
    if(j==3){return 58;} if(j==4){return 75;} return 92;
  }
}
fn is_parity(t:i32)i32 {
  if(t==5){return 1;}
  return 0;
}
fn task_t(t:i32)i32 {
  if(t==1){return 30;}
  if(t==2){return 73;}
  if(t==3){return 20;}
  if(t==4){return 55;}
  return -1;
}
fn true_label(t:i32,x:i32)i32 {
  if(is_parity(t)==1){ return x - (x/2)*2; }
  if(x>=task_t(t)){return 1;}
  return 0;
}
fn train_label(t:i32,j:i32)i32 { return true_label(t,tx(t,j)); }

// ---- form discovery / validation: labels monotone non-decreasing in x ----
fn mono_ok(t:i32)i32 {
  let j:i32=1;
  let prev:i32=train_label(t,0);
  while(j<6){
    let cur:i32=train_label(t,j);
    if(cur<prev){return 0;}
    prev=cur;
    j=j+1;
  }
  return 1;
}
fn parity_mono_ok()i32 {
  let j:i32=1;
  let x0:i32=tx(1,0);
  let prev:i32=x0 - (x0/2)*2;
  while(j<6){
    let xj:i32=tx(1,j);
    let cur:i32=xj - (xj/2)*2;
    if(cur<prev){return 0;}
    prev=cur;
    j=j+1;
  }
  return 1;
}

// ---- schema fit: bracket then midpoint cutoff ----
fn fit_cutoff(t:i32)i32 {
  let lo:i32=1;
  let hi:i32=101;
  let j:i32=0;
  while(j<6){
    let x:i32=tx(t,j);
    let l:i32=train_label(t,j);
    if(l==1){ if(x<hi){hi=x;} }
    else { if(x+1>lo){lo=x+1;} }
    j=j+1;
  }
  return (lo+hi)/2;
}

// ---- predictors ----
fn nn_predict(t:i32,x:i32)i32 {
  let best:i32=0;
  let bd:i32=1000000;
  let j:i32=0;
  while(j<6){
    let sx:i32=tx(t,j);
    let d:i32=x-sx;
    if(d<0){d=-d;}
    if(d<bd || (d==bd && sx<tx(t,best))){ bd=d; best=j; }
    j=j+1;
  }
  return train_label(t,best);
}
fn mem_predict(t:i32,x:i32)i32 {
  let j:i32=0;
  while(j<6){
    if(tx(t,j)==x){return train_label(t,j);}
    j=j+1;
  }
  return 0;
}

// ---- accuracy over x=1..100 ----
// mode: 0=fresh NN, 1=schema, 2=instance(verbatim c1), 3=ablated memorizer
fn accuracy(t:i32,mode:i32,form:i32,c1:i32)i32 {
  let c:i32=0;
  let valid:i32=0;
  if(mode==1){
    if(form==1){
      valid=mono_ok(t);
      if(valid==1){c=fit_cutoff(t);}
    }
  }
  let correct:i32=0;
  let x:i32=1;
  while(x<=100){
    let p:i32=0;
    if(mode==0){p=nn_predict(t,x);}
    else if(mode==1){
      if(valid==1){ if(x>=c){p=1;} else {p=0;} }
      else {p=mem_predict(t,x);}
    }
    else if(mode==2){ if(x>=c1){p=1;} else {p=0;} }
    else {p=mem_predict(t,x);}
    if(p==true_label(t,x)){correct=correct+1;}
    x=x+1;
  }
  return correct;
}

fn main()i32 {
  // T1: form discovery (creation of the schema)
  let d_thr:i32=mono_ok(1);
  let d_par:i32=parity_mono_ok();
  let form:i32=d_thr;
  // T1: fit instance (fitted cutoff persisted verbatim)
  let c1:i32=fit_cutoff(1);
  emit("DISCV_THR ");e64(d_thr);emit("\n");
  emit("DISCV_PAR ");e64(d_par);emit("\n");
  emit("C1_FITTED ");e64(c1);emit("\n");
  // transfer tasks T2..T5
  let ns:i32=0;
  let ni:i32=0;
  let t:i32=2;
  while(t<=5){
    let af:i32=accuracy(t,0,0,0);
    let as:i32=accuracy(t,1,form,c1);
    let ai:i32=accuracy(t,2,form,c1);
    let aa:i32=accuracy(t,3,form,c1);
    emit("T");e64(t);
    emit(" fresh=");e64(af);
    emit(" schema=");e64(as);
    emit(" instance=");e64(ai);
    emit(" ablated=");e64(aa);
    emit("\n");
    ns=ns+(as-af);
    ni=ni+(ai-af);
    t=t+1;
  }
  emit("NET_SCHEMA ");e64(ns);emit("\n");
  emit("NET_INSTANCE ");e64(ni);emit("\n");
  emit("STORAGE_SCHEMA 1\n");
  emit("STORAGE_INSTANCE 1\n");
  emit("CREATE_EXTRA 0\n");
  let k3:i32=0;
  if(ns>ni){k3=1;}
  emit("K1 1\n");
  emit("K2 1\n");
  emit("K3 ");e64(k3);emit("\n");
  if(k3==1){emit("VERDICT SCHEMA-WINS\n");}
  else {
    if(ns==ni){emit("VERDICT TIE\n");}
    else {emit("VERDICT INSTANCE-WINS\n");}
  }
  emit("SP-END\n");
  return 0;
}

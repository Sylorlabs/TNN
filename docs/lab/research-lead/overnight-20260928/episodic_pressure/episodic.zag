// episodic.zag - Episodic-Pressure Experiment
// Three separated pressure waves with inter-wave earning; tests whether
// never-queried newcomers bleed across episodes via revolving-door
// re-establishment. One arm: control POLICY=0 (FIFO ties), the current
// consequence policy. Pure Zag. No Python.
// Prereg: PREREG_EPISODIC.md (2e0c6ed10), frozen before implementation.
// Learner core carried over from churn_learn.zag (5db2712af); the eviction
// policy is unchanged.
fn policy()i32 { return 0; } // build flag: 0=FIFO ties (control)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// Rule record: 11 i32 fields, 44 bytes.
// 0 subj, 4 rel, 8 obj, 12 correct, 16 wrong, 20 dependents,
// 24 contradictions, 28 last_used, 32 taught, 36 superseded, 40 valid
// Store base 64, capacity 36. Tick at W[0..4]. Foundation-evict flag at W[8..12].
fn rf(W:[]u8, base:i32, s:i32, f:i32)i32 { return get32(W, base+s*44+f); }
fn wf(W:[]u8, base:i32, s:i32, f:i32, v:i32)void { set32(W, base+s*44+f, v); return; }
fn newtick(W:[]u8)i32 { let t:i32=get32(W,0)+1; set32(W,0,t); return t; }
fn find_key(W:[]u8, base:i32, subj:i32, rel:i32)i32 {
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1 && rf(W,base,s,0)==subj && rf(W,base,s,4)==rel){ return s; }
    s=s+1;
  }
  return -1;
}
fn store_count(W:[]u8, base:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){ if(rf(W,base,s,40)==1){ n=n+1; } s=s+1; }
  return n;
}
fn importance_c(W:[]u8, base:i32, s:i32)i32 {
  let c:i32=rf(W,base,s,12);
  let w:i32=rf(W,base,s,16);
  let d:i32=rf(W,base,s,20);
  let k:i32=rf(W,base,s,24);
  return 10*(c-w) + 5*d - 8*k + 1;
}
fn evict_c(W:[]u8, base:i32)i32 {
  let best:i32=0;
  let bestk:i32=0;
  let first:i32=1;
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1){
      let imp:i32=importance_c(W,base,s);
      if(first==1){ best=s; bestk=imp; first=0; }
      else { if(imp<bestk){ best=s; bestk=imp; } }
    }
    s=s+1;
  }
  return best;
}
fn learn(W:[]u8, subj:i32, rel:i32, obj:i32)void {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s>=0){
    wf(W,base,s,28,t);
    let old:i32=rf(W,base,s,8);
    if(old!=obj){
      wf(W,base,s,36,old);
      wf(W,base,s,8,obj);
      wf(W,base,s,24,rf(W,base,s,24)+1);
      wf(W,base,s,16,rf(W,base,s,16)+1);
    }
    return;
  }
  let n:i32=store_count(W,base);
  if(n<36){ s=n; }
  else {
    s=evict_c(W,base);
    let vs:i32=rf(W,base,s,0);
    let vr:i32=rf(W,base,s,4);
    emit("EVICT ");
    emit(i32s(vs));
    emit(" ");
    emit(i32s(vr));
    emit("\n");
    if(vs>=1 && vs<=6){ set32(W,8,1); }
  }
  wf(W,base,s,0,subj);
  wf(W,base,s,4,rel);
  wf(W,base,s,8,obj);
  wf(W,base,s,12,0);
  wf(W,base,s,16,0);
  wf(W,base,s,20,0);
  wf(W,base,s,24,0);
  wf(W,base,s,28,t);
  wf(W,base,s,32,t);
  wf(W,base,s,36,-1);
  wf(W,base,s,40,1);
  return;
}
fn query(W:[]u8, subj:i32, rel:i32, expected:i32)i32 {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s<0){ return -2; }
  wf(W,base,s,28,t);
  let p:i32=rf(W,base,s,8);
  if(p==expected){ wf(W,base,s,12,rf(W,base,s,12)+1); }
  else { wf(W,base,s,16,rf(W,base,s,16)+1); }
  return p;
}
fn signof(v:i32)i32 {
  if(v>0){ return 1; }
  if(v<0){ return -1; }
  return 0;
}
fn twohop(W:[]u8, s1:i32, r1:i32, e1:i32, s2:i32, r2:i32, e2:i32, expc:i32)i32 {
  let base:i32=64;
  let p1:i32=query(W,s1,r1,e1);
  let p2:i32=query(W,s2,r2,e2);
  if(p1==-2 || p2==-2){ return 0; }
  let a:i32=find_key(W,base,s1,r1);
  let b:i32=find_key(W,base,s2,r2);
  if(a>=0){ wf(W,base,a,20,rf(W,base,a,20)+1); }
  if(b>=0){ wf(W,base,b,20,rf(W,base,b,20)+1); }
  if(signof(p1-p2)==expc){ return 1; }
  return 0;
}
fn storehash(W:[]u8, base:i32)i64 {
  let h:i64=0;
  let s:i32=0;
  while(s<36){
    let f:i32=0;
    while(f<44){
      let u:i64=(get32(W,base+s*44+f) as i64)+2147483648;
      h=(h+u)%1000000007;
      h=h*31%1000000007;
      f=f+4;
    }
    s=s+1;
  }
  let t:i64=(get32(W,0) as i64)+2147483648;
  h=(h+t)%1000000007;
  return h;
}
fn i64s(v:i64)[]u8 { return _zag_i64_to_str(v); }
fn emit_stage_hash(W:[]u8, st:i32)void {
  emit("STATEHASH P");
  emit(i32s(st));
  emit(" TICK ");
  emit(i32s(get32(W,0)));
  emit(" H ");
  emit(i64s(storehash(W,64)));
  emit("\n");
  return;
}
fn count_rel(W:[]u8, rel:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==rel){ n=n+1; }
    s=s+1;
  }
  return n;
}
// Earn every surviving flood item (rel 99) with 2x queries.
fn earn_all_flood(W:[]u8)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==99){
      let sj:i32=rf(W,64,s,0);
      let ob:i32=rf(W,64,s,8);
      query(W,sj,99,ob);
      query(W,sj,99,ob);
      n=n+1;
    }
    s=s+1;
  }
  return n;
}
fn main()i32 {
  emit("=== EPISODIC-PRESSURE: newcomer bleed across separated waves ===\n");
  emit("PREREG PREREG_EPISODIC.md 2e0c6ed10; POLICY 0\n");
  let W:[]u8=z_alloc(8192);
  set32(W,0,0);
  set32(W,8,0);

  // ---------- E0: foundation + Group A + sleepers (mirrors churn C1-C2) ----------
  emit("PHASE E0\n");
  learn(W,1,10,4); learn(W,1,11,5); learn(W,2,10,4); learn(W,2,12,1);
  learn(W,3,10,2); learn(W,4,12,2); learn(W,5,11,2); learn(W,6,10,8);
  learn(W,7,10,3); learn(W,8,12,5); learn(W,9,10,1); learn(W,9,11,7);
  let c1r:i32=0;
  if(query(W,1,10,4)==4){ c1r=c1r+1; }
  if(query(W,1,11,5)==5){ c1r=c1r+1; }
  if(query(W,2,10,4)==4){ c1r=c1r+1; }
  if(query(W,2,12,1)==1){ c1r=c1r+1; }
  if(query(W,3,10,2)==2){ c1r=c1r+1; }
  if(query(W,4,12,2)==2){ c1r=c1r+1; }
  if(query(W,5,11,2)==2){ c1r=c1r+1; }
  if(query(W,6,10,8)==8){ c1r=c1r+1; }
  if(query(W,7,10,3)==3){ c1r=c1r+1; }
  if(query(W,8,12,5)==5){ c1r=c1r+1; }
  if(query(W,9,10,1)==1){ c1r=c1r+1; }
  if(query(W,9,11,7)==7){ c1r=c1r+1; }
  if(c1r!=12){ emit("E0_SETUP_FAIL\n"); return 1; }
  let a:i32=10;
  while(a<20){ learn(W,a,30,a); a=a+1; }
  a=10;
  while(a<20){ query(W,a,30,a); query(W,a,30,a); a=a+1; }
  learn(W,40,20,4); learn(W,41,20,9); learn(W,42,20,2); learn(W,43,20,7);
  learn(W,44,20,5); learn(W,45,20,1); learn(W,46,20,8); learn(W,47,20,3);
  learn(W,48,20,6); learn(W,49,20,0);
  emit("E0_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("E0_EARNED ");
  emit(i32s(count_rel(W,30)));
  emit("/10\n");
  emit_stage_hash(W,0);

  // ---------- Episode 1 ----------
  emit("EP1_WAVE\n");
  let f:i32=300;
  while(f<330){ learn(W,f,99,f); f=f+1; }
  emit("EP1_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("EP1_FLOOD ");
  emit(i32s(count_rel(W,99)));
  emit("\n");
  emit_stage_hash(W,1);
  emit("IW1\n");
  emit("IW1_EARNED ");
  emit(i32s(earn_all_flood(W)));
  emit("\n");
  let p1:i32=0;
  if(query(W,48,20,6)==6){ p1=p1+1; }
  if(query(W,49,20,0)==0){ p1=p1+1; }
  emit("IW1_PROBE ");
  emit(i32s(p1));
  emit("/2\n");
  emit_stage_hash(W,2);

  // ---------- Episode 2 ----------
  emit("EP2_WAVE\n");
  f=400;
  while(f<430){ learn(W,f,99,f); f=f+1; }
  emit("EP2_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("EP2_FLOOD ");
  emit(i32s(count_rel(W,99)));
  emit("\n");
  emit_stage_hash(W,3);
  emit("IW2\n");
  emit("IW2_EARNED ");
  emit(i32s(earn_all_flood(W)));
  emit("\n");
  let p2:i32=0;
  if(query(W,46,20,8)==8){ p2=p2+1; }
  if(query(W,47,20,3)==3){ p2=p2+1; }
  emit("IW2_PROBE ");
  emit(i32s(p2));
  emit("/2\n");
  emit_stage_hash(W,4);

  // ---------- Episode 3 ----------
  emit("EP3_WAVE\n");
  f=500;
  while(f<530){ learn(W,f,99,f); f=f+1; }
  emit("EP3_SLEEP ");
  emit(i32s(count_rel(W,20)));
  emit("/10\n");
  emit("EP3_FLOOD ");
  emit(i32s(count_rel(W,99)));
  emit("\n");
  emit_stage_hash(W,5);
  emit("IW3\n");
  emit("IW3_EARNED ");
  emit(i32s(earn_all_flood(W)));
  emit("\n");
  let sp:i32=0;
  if(query(W,43,20,7)==7){ sp=sp+1; }
  if(query(W,44,20,5)==5){ sp=sp+1; }
  if(query(W,45,20,1)==1){ sp=sp+1; }
  emit("IW3_PROBE_UNPROBED ");
  emit(i32s(sp));
  emit("/3\n");
  emit_stage_hash(W,6);

  // ---------- Final: compositions + recall ----------
  emit("FINAL\n");
  let comp:i32=0;
  comp=comp+twohop(W,43,20,7,3,10,2,1);
  comp=comp+twohop(W,44,20,5,1,10,4,1);
  comp=comp+twohop(W,45,20,1,6,10,8,-1);
  comp=comp+twohop(W,46,20,8,9,10,1,1);
  emit("FINAL_COMP ");
  emit(i32s(comp));
  emit("/4\n");
  let fr:i32=0;
  if(query(W,1,10,4)==4){ fr=fr+1; }
  if(query(W,1,11,5)==5){ fr=fr+1; }
  if(query(W,2,10,4)==4){ fr=fr+1; }
  if(query(W,2,12,1)==1){ fr=fr+1; }
  if(query(W,3,10,2)==2){ fr=fr+1; }
  if(query(W,4,12,2)==2){ fr=fr+1; }
  if(query(W,5,11,2)==2){ fr=fr+1; }
  if(query(W,6,10,8)==8){ fr=fr+1; }
  if(query(W,7,10,3)==3){ fr=fr+1; }
  if(query(W,8,12,5)==5){ fr=fr+1; }
  if(query(W,9,10,1)==1){ fr=fr+1; }
  if(query(W,9,11,7)==7){ fr=fr+1; }
  emit("FINAL_FOUND ");
  emit(i32s(fr));
  emit("/12\n");
  let er:i32=0;
  let b:i32=10;
  while(b<20){ if(query(W,b,30,b)==b){ er=er+1; } b=b+1; }
  emit("FINAL_EARNED ");
  emit(i32s(er));
  emit("/10\n");
  emit("FOUND_EVICT ");
  emit(i32s(get32(W,8)));
  emit("\n");
  emit_stage_hash(W,7);
  emit("=== EPISODIC-PRESSURE COMPLETE ===\n");
  return 0;
}

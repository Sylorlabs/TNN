// B6 canary -- detect the scratch overflow WITHOUT relying on a panic,
// because this host's compiler emits no slice bounds checks (b6_probe.zag:
// set32 past the end of a z_alloc buffer survives and silently corrupts a
// neighbouring live allocation).
//
// Method: allocate the scratch, then IMMEDIATELY allocate a canary buffer and
// fill it with a known pattern. Run the worst-case program for length L at
// scratch size S. Any write past the end of the scratch lands in the canary
// and is counted. This turns a silent overflow into a counted event.
//
// Prereg: lane/blockerfix PREREG.md K2/K4/K6.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn abs32(v:i32)i32 { if(v<0){ return 0-v; } return v; }
fn loo_pred(y0:i32, y1:i32, y2:i32, xstar:i32, excl:i32)i32 {
  let xa:i32=0; let ya:i32=0; let xb:i32=0; let yb:i32=0;
  if(excl==0){xa=1;ya=y1;xb=2;yb=y2;}
  else {
    if(excl==1){xa=0;ya=y0;xb=2;yb=y2;}
    else {xa=0;ya=y0;xb=1;yb=y1;}
  }
  let a:i32=(yb-ya)/(xb-xa);
  let b:i32=ya-a*xa;
  return a*xstar+b;
}
fn exm_of(y0:i32, y1:i32, y2:i32)i32 {
  let a:i32=y1-y0;
  let b:i32=y0;
  let r2:i32=abs32(a*2+b-y2);
  if(r2>0){return 2;}
  return 0;
}
fn stack_med(scr:[]u8, sp:i32)i32 {
  let a2:i32=0;
  while(a2<sp){
    let b2:i32=a2+1;
    while(b2<sp){
      let va:i32=get32(scr,a2*4);
      let vb:i32=get32(scr,b2*4);
      if(vb<va){ set32(scr,a2*4,vb); set32(scr,b2*4,va); }
      b2=b2+1;
    }
    a2=a2+1;
  }
  return get32(scr,((sp-1)/2)*4);
}
fn interp(y0:i32, y1:i32, y2:i32, xs:i32, dig:[]u8, qlen:i32, scr:[]u8)i32 {
  let excl:i32=-1;
  let sp:i32=0;
  let j:i32=0;
  while(j<qlen){
    let ins:i32=get32(dig,j*4);
    let done:i32=0;
    if(ins==0){
      let pr:i32=0;
      if(excl==-1){pr=(y1-y0)*xs+y0;}
      else {pr=loo_pred(y0,y1,y2,xs,excl);}
      set32(scr,sp*4,pr); sp=sp+1; done=1;
    }
    if(done==0){ if(ins==1){ excl=exm_of(y0,y1,y2); done=1; } }
    if(done==0){
      if(ins==2){
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,0)); sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,1)); sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,2)); sp=sp+1;
        done=1;
      }
    }
    if(done==0){ if(ins==3){ let md:i32=stack_med(scr,sp); set32(scr,0,md); sp=1; done=1; } }
    if(done==0){
      let s:i32=0; let k2:i32=0;
      while(k2<sp){ s=s+get32(scr,k2*4); k2=k2+1; }
      let m2:i32=s/sp;
      set32(scr,0,m2); sp=1;
    }
    j=j+1;
  }
  return get32(scr,(sp-1)*4);
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0; let n:i32=s.len;
  if(n==0){return -1;}
  while(i<n){
    let c:i32=s[i] as i32;
    if(c<48){return v;}
    if(c>57){return v;}
    v=v*10+(c-48); i=i+1;
  }
  return v;
}

fn main()i32 {
  let L:i32=atoi(_zag_arg(1));
  let S:i32=atoi(_zag_arg(2));
  let dig:[]u8=z_alloc(256);
  let j:i32=0;
  // worst-case VALID program for length L: [loo3 x (L-1), fit]
  while(j<L-1){ set32(dig,j*4,2); j=j+1; }
  set32(dig,(L-1)*4,0);

  // reference result at an oversized scratch
  let big:[]u8=z_alloc(4096);
  let ref:i32=interp(0,2,7,5,dig,L,big);

  // SCRATCH AND CANARY ARE TWO SLICES OF ONE ALLOCATION, so the canary begins
  // at exactly byte S with no malloc padding between them. (With two separate
  // z_alloc calls the allocator rounds the first request up and small
  // overflows land in that padding, which hid the L=7/S=64 and L=12/S=128
  // cases on the first attempt at this probe.) Any write at scr offset S+k
  // now lands on can[k] deterministically.
  let blk:[]u8=z_alloc(S+256);
  let scr:[]u8=blk[0..S];
  let can:[]u8=blk[S..(S+256)];
  let i:i32=0;
  while(i<256){ can[i]=(165+(i%91)) as u8; i=i+1; }
  let r:i32=interp(0,2,7,5,dig,L,scr);
  let bad:i32=0;
  let k:i32=0;
  while(k<256){ if(can[k]!=(165+(k%91))){ bad=bad+1; } k=k+1; }

  let ob:[]u8=z_alloc(4096);
  let at:i32=0;
  at=o_app(ob,at,"B6C L="); at=o_i32(ob,at,L);
  at=o_app(ob,at," S="); at=o_i32(ob,at,S);
  at=o_app(ob,at," need="); at=o_i32(ob,at,12*L-8);
  at=o_app(ob,at," canary_corrupt="); at=o_i32(ob,at,bad);
  at=o_app(ob,at," result="); at=o_i32(ob,at,r);
  at=o_app(ob,at," ref="); at=o_i32(ob,at,ref);
  at=o_app(ob,at," match=");
  if(r==ref){ at=o_app(ob,at,"YES"); } else { at=o_app(ob,at,"NO"); }
  at=o_nl(ob,at);
  o_flush(ob,at);
  return 0;
}
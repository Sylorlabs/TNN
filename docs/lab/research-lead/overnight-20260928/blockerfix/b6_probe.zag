// B6 minimal bounds probe -- does writing past the end of a z_alloc buffer
// actually panic on this host/toolchain?
//
// The ledger (C398, C405) claims the DEEP7 refusal-probe crash is caused by
// `set32(scr, 64, ...)` on a 64-byte buffer produced by z_alloc(64). This
// binary tests that claim directly and minimally, with NO interpreter in the
// way. Prereg: lane/blockerfix PREREG.md K5.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn main()i32 {
  let ob:[]u8=z_alloc(8192);
  let at:i32=0;
  at=o_app(ob,at,"B6P START\n");
  at=o_app(ob,at,"B6P z_alloc(64).len=");
  let b:[]u8=z_alloc(64);
  at=o_i32(ob,at,b.len);
  at=o_nl(ob,at);
  o_flush(ob,at);

  // The exact operation the ledger names as the crash cause.
  set32(b,64,12345);
  at=o_app(ob,at,"B6P set32(b,64) SURVIVED readback=");
  at=o_i32(ob,at,get32(b,64));
  at=o_nl(ob,at);
  o_flush(ob,at);

  // How far past the end does it go before something gives?
  let off:i32=68;
  while(off<=4096){
    set32(b,off,off);
    off=off+4;
  }
  at=o_app(ob,at,"B6P wrote_through_offset=4096 SURVIVED\n");
  o_flush(ob,at);

  at=o_app(ob,at,"B6P readback_4096=");
  at=o_i32(ob,at,get32(b,4096));
  at=o_nl(ob,at);

  // heap neighbour check: a second allocation, to see whether the overflow
  // corrupted an adjacent live buffer.
  let c:[]u8=z_alloc(64);
  let i:i32=0;
  while(i<64){ c[i]=170; i=i+1; }
  let k:i32=0;
  while(k<16){ set32(b,128+k*4,k*7); k=k+1; }
  let corrupt:i32=0;
  let j:i32=0;
  while(j<64){ if(c[j]!=170){ corrupt=corrupt+1; } j=j+1; }
  at=o_app(ob,at,"B6P neighbour_corrupt_bytes=");
  at=o_i32(ob,at,corrupt);
  at=o_nl(ob,at);
  at=o_app(ob,at,"B6P END\n");
  o_flush(ob,at);
  return 0;
}
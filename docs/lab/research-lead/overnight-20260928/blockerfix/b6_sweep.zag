// B6 sweep -- measure the TRUE maximum interpreter stack pointer reachable
// as a function of program length L, over ALL 5^L digit strings.
//
// Pure Zag. The interpreter body is copied VERBATIM in semantics from
// hcontlife5-invent/src/invent.zag::learner_interp. The ONLY change is that
// every scratch access goes through b6w/b6r, which record the highest cell
// index touched and refuse to touch memory outside the buffer, so the sweep
// measures max_sp WITHOUT reproducing the crash.
//
// Instruction set (frozen from invent.zag):
//   0 fit  : sp += 1
//   1 exm  : sp += 0
//   2 loo3 : sp += 3
//   3 med  : sp := 1
//   4 avg  : sp := 1
//
// Prereg: lane/blockerfix PREREG.md K1/K2/K3.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- instrumentation state, in a flat buffer passed by reference ----
// G[0..3]   max cell index touched
// G[4..7]   count of accesses refused as out-of-bounds
fn gmax(G:[]u8)i32 { return get32(G,0); }
fn gset(G:[]u8,v:i32)void { set32(G,0,v); return; }
fn gbump(G:[]u8)void { set32(G,4,get32(G,4)+1); return; }

// write value v to scratch cell `c`, recording the high-water mark
fn b6w(scr:[]u8,G:[]u8,c:i32,v:i32)void {
  if(c>gmax(G)){ gset(G,c); }
  if(c<0){ gbump(G); return; }
  if((c*4+4)>scr.len){ gbump(G); return; }
  set32(scr,c*4,v);
  return;
}
// read scratch cell `c`, recording the high-water mark
fn b6r(scr:[]u8,G:[]u8,c:i32)i32 {
  if(c>gmax(G)){ gset(G,c); }
  if(c<0){ gbump(G); return 0; }
  if((c*4+4)>scr.len){ gbump(G); return 0; }
  return get32(scr,c*4);
}
fn b6reset(G:[]u8)void { set32(G,0,0); set32(G,4,0); return; }

// ---- copied verbatim from invent.zag ----
fn abs32(v:i32)i32 { if(v<0){ return 0-v; } return v; }
fn loo_pred(y0:i32, y1:i32, y2:i32, xstar:i32, excl:i32)i32 {
  let xa:i32=0; let ya:i32=0; let xb:i32=0; let yb:i32=0;
  if(excl==0){xa=1;ya=y1;xb=2;yb=y2;}
  else {
    if(excl==1){xa=0;ya=y0;xb=2;yb=y2;}
    else {xa=0;ya=y0;xb=1;yb=y1;}
  }
  let a:i32=(yb-ya)/(xb-xa);
  let b:i32=ya-a*xa;
  return a*xstar+b;
}
fn exm_of(y0:i32, y1:i32, y2:i32)i32 {
  let a:i32=y1-y0;
  let b:i32=y0;
  let r2:i32=abs32(a*2+b-y2);
  if(r2>0){return 2;}
  return 0;
}
// median of the values on the stack (sorted in place) -- instrumented
fn b6med(scr:[]u8, G:[]u8, sp:i32)i32 {
  let a2:i32=0;
  while(a2<sp){
    let b2:i32=a2+1;
    while(b2<sp){
      let va:i32=b6r(scr,G,a2);
      let vb:i32=b6r(scr,G,b2);
      if(vb<va){
        b6w(scr,G,a2,vb);
        b6w(scr,G,b2,va);
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  // same latent sp==0 exposure as the avg path; guarded for the sweep only.
  if(sp<1){ return 0; }
  return b6r(scr,G,((sp-1)/2));
}
// the interpreter, instrumented. Digits d0..d3 (this lane only needs L<=4
// for the worst-case program; the sweep drives all L via the digit array).
fn b6interp(y0:i32, y1:i32, y2:i32, xs:i32, dig:[]u8, qlen:i32, scr:[]u8, G:[]u8)i32 {
  let excl:i32=-1;
  let sp:i32=0;
  let j:i32=0;
  while(j<qlen){
    let ins:i32=get32(dig,j*4);
    let done:i32=0;
    if(ins==0){
      let pr:i32=0;
      if(excl==-1){pr=(y1-y0)*xs+y0;}
      else {pr=loo_pred(y0,y1,y2,xs,excl);}
      b6w(scr,G,sp,pr);
      sp=sp+1;
      done=1;
    }
    if(done==0){
      if(ins==1){
        excl=exm_of(y0,y1,y2);
        done=1;
      }
    }
    if(done==0){
      if(ins==2){
        b6w(scr,G,sp,loo_pred(y0,y1,y2,xs,0));
        sp=sp+1;
        b6w(scr,G,sp,loo_pred(y0,y1,y2,xs,1));
        sp=sp+1;
        b6w(scr,G,sp,loo_pred(y0,y1,y2,xs,2));
        sp=sp+1;
        done=1;
      }
    }
    if(done==0){
      if(ins==3){
        let md:i32=b6med(scr,G,sp);
        b6w(scr,G,0,md);
        sp=1;
        done=1;
      }
    }
    if(done==0){
      let s:i32=0;
      let k2:i32=0;
      while(k2<sp){
        s=s+b6r(scr,G,k2);
        k2=k2+1;
      }
      // LATENT DEFECT (this lane): the frozen interpreter computes s/sp with
      // no sp>0 guard, so any program whose FIRST instruction is exm (which
      // pushes nothing) and whose NEXT is avg/med panics with division by
      // zero. valid_prog rejects exactly those programs (an agg before any
      // push sets vok=0), so the frozen lane never reaches it -- it is
      // latent, not live. The sweep must run ALL 5^L strings to measure the
      // true maximum, so the guard is added here. It does not affect the sp
      // high-water mark, which is what this binary measures.
      let m2:i32=0;
      if(sp>0){ m2=s/sp; }
      b6w(scr,G,0,m2);
      sp=1;
    }
    j=j+1;
  }
  // the frozen final read get32(scr,(sp-1)*4) is cell -1 when sp==0; guarded
  // for the sweep only. sp==0 requires the program to push nothing at all,
  // which valid_prog rejects (last must be 0/3/4, all of which leave sp>=1).
  if(sp<1){ return 0; }
  return b6r(scr,G,(sp-1));
}
// copied verbatim from invent.zag
fn valid_prog(dig:[]u8, qlen:i32)i32 {
  let last:i32=get32(dig,(qlen-1)*4);
  let vok:i32=0;
  if(last==0){vok=1;}
  if(last==3){vok=1;}
  if(last==4){vok=1;}
  let pushseen:i32=0;
  let k:i32=0;
  while(k<qlen){
    let dk:i32=get32(dig,k*4);
    let ispush:i32=0;
    if(dk==0){ispush=1;}
    if(dk==2){ispush=1;}
    let isagg:i32=0;
    if(dk==3){isagg=1;}
    if(dk==4){isagg=1;}
    if(isagg==1){
      if(pushseen==0){vok=0;}
    }
    if(ispush==1){pushseen=1;}
    k=k+1;
  }
  return vok;
}
fn pow5i(n:i32)i32 {
  let r:i32=1; let i:i32=0;
  while(i<n){ r=r*5; i=i+1; }
  return r;
}
fn decode_prog(idx:i32, qlen:i32, dig:[]u8)void {
  let j:i32=0;
  while(j<qlen){
    let p:i32=pow5i(qlen-1-j);
    let dg:i32=(idx/p)%5;
    set32(dig,j*4,dg);
    j=j+1;
  }
  return;
}

// ---- output (portable shim, brief 4.0) ----
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn main()i32 {
  let G:[]u8=z_alloc(64);
  let ob:[]u8=z_alloc(16384);
  // A large scratch: 4096 bytes = 1024 cells, far above anything L<=10 needs.
  let scr:[]u8=z_alloc(4096);
  let dig:[]u8=z_alloc(64);
  let at:i32=0;
  at=o_app(ob,at,"B6-SWEEP-START\n");
  // training values: the frozen lane's 2-point-fit shape, y2 off the line so
  // r0=r1=0 and r2>0 exactly as invent.zag's comment describes.
  let y0:i32=0; let y1:i32=2; let y2:i32=7; let xs:i32=5;

  let L:i32=1;
  let allpass:i32=1;
  let valpass:i32=1;
  while(L<=10){
    let total:i32=pow5i(L);
    let allmax:i32=-1;
    let valmax:i32=-1;
    let allcnt:i32=0;
    let valcnt:i32=0;
    let nval:i32=0;
    let oob:i32=0;
    let idx:i32=0;
    while(idx<total){
      decode_prog(idx,L,dig);
      let vk:i32=valid_prog(dig,L);
      if(vk==1){ nval=nval+1; }
      b6reset(G);
      let junk:i32=b6interp(y0,y1,y2,xs,dig,L,scr,G);
      let m:i32=gmax(G);
      oob=oob+get32(G,4);
      if(m>allmax){ allmax=m; allcnt=1; } else { if(m==allmax){ allcnt=allcnt+1; } }
      if(vk==1){
        if(m>valmax){ valmax=m; valcnt=1; } else { if(m==valmax){ valcnt=valcnt+1; } }
      }
      idx=idx+1;
    }
    // prereg K1 prediction: max_sp(L) == 3L-2, i.e. max cell index == 3L-3
    let pred:i32=3*L-3;
    let verdict:i32=0;
    if(allmax==pred){ verdict=1; } else { allpass=0; }
    if(valmax==pred){ } else { valpass=0; }
    // tight byte requirement: 4*(maxcell+1)
    let need_all:i32=4*(allmax+1);
    let need_val:i32=4*(valmax+1);
    let fits128:i32=0;
    if(need_val<=128){ fits128=1; }
    at=o_app(ob,at,"B6 L=");
    at=o_i32(ob,at,L);
    at=o_app(ob,at," total=");
    at=o_i32(ob,at,total);
    at=o_app(ob,at," nvalid=");
    at=o_i32(ob,at,nval);
    at=o_app(ob,at," maxcell_all=");
    at=o_i32(ob,at,allmax);
    at=o_app(ob,at," maxcell_valid=");
    at=o_i32(ob,at,valmax);
    at=o_app(ob,at," pred=");
    at=o_i32(ob,at,pred);
    at=o_app(ob,at," K1=");
    if(allmax==pred){ at=o_app(ob,at,"PASS"); } else { at=o_app(ob,at,"FAIL"); }
    at=o_app(ob,at," need_bytes=");
    at=o_i32(ob,at,need_val);
    at=o_app(ob,at," need128ok=");
    if(fits128==1){ at=o_app(ob,at,"YES"); } else { at=o_app(ob,at,"NO"); }
    at=o_app(ob,at," oob=");
    at=o_i32(ob,at,oob);
    at=o_nl(ob,at);
    L=L+1;
  }
  at=o_app(ob,at,"B6 K1_ALLPASS=");
  if(allpass==1){ at=o_app(ob,at,"1"); } else { at=o_app(ob,at,"0"); }
  at=o_app(ob,at," K1_VALIDPASS=");
  if(valpass==1){ at=o_app(ob,at,"1"); } else { at=o_app(ob,at,"0"); }
  at=o_nl(ob,at);
  // K2: is 128 sufficient for L=12? required = 4*(3*12-3+1) = 4*34 = 136
  at=o_app(ob,at,"B6 K2 need_bytes_L12=");
  at=o_i32(ob,at,4*(3*12-3+1));
  at=o_app(ob,at," need_bytes_L11=");
  at=o_i32(ob,at,4*(3*11-3+1));
  at=o_app(ob,at," K2_128_SUFFICIENT_L12=");
  if((4*(3*12-3+1))<=128){ at=o_app(ob,at,"YES"); } else { at=o_app(ob,at,"NO"); }
  at=o_nl(ob,at);
  at=o_app(ob,at,"B6-SWEEP-END\n");
  o_flush(ob,at);
  return 0;
}
// B6 cost (K7) -- does a larger scratch buffer slow execution?
//
// Fixed workload: interpret EVERY 5^L program for L=1..8 (411,810 programs)
// against training values, with a scratch of size S (argv). Identical work at
// every S; the only difference is the allocation. Prints a checksum so the
// work cannot be optimised away and so the outputs can be compared.
//
// Wall/CPU is measured outside by the watchdog. Prereg: K7.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn abs32(v:i32)i32 { if(v<0){ return 0-v; } return v; }
fn loo_pred(y0:i32, y1:i32, y2:i32, xstar:i32, excl:i32)i32 {
  let xa:i32=0; let ya:i32=0; let xb:i32=0; let yb:i32=0;
  if(excl==0){xa=1;ya=y1;xb=2;yb=y2;}
  else {
    if(excl==1){xa=0;ya=y0;xb=2;yb=y2;}
    else {xa=0;ya=y0;xb=1;yb=y1;}
  }
  let a:i32=(yb-ya)/(xb-xa);
  let b:i32=ya-a*xa;
  return a*xstar+b;
}
fn exm_of(y0:i32, y1:i32, y2:i32)i32 {
  let a:i32=y1-y0;
  let b:i32=y0;
  let r2:i32=abs32(a*2+b-y2);
  if(r2>0){return 2;}
  return 0;
}
fn stack_med(scr:[]u8, sp:i32)i32 {
  let a2:i32=0;
  while(a2<sp){
    let b2:i32=a2+1;
    while(b2<sp){
      let va:i32=get32(scr,a2*4);
      let vb:i32=get32(scr,b2*4);
      if(vb<va){ set32(scr,a2*4,vb); set32(scr,b2*4,va); }
      b2=b2+1;
    }
    a2=a2+1;
  }
  return get32(scr,((sp-1)/2)*4);
}
fn interp(y0:i32, y1:i32, y2:i32, xs:i32, dig:[]u8, qlen:i32, scr:[]u8)i32 {
  let excl:i32=-1;
  let sp:i32=0;
  let j:i32=0;
  while(j<qlen){
    let ins:i32=get32(dig,j*4);
    let done:i32=0;
    if(ins==0){
      let pr:i32=0;
      if(excl==-1){pr=(y1-y0)*xs+y0;}
      else {pr=loo_pred(y0,y1,y2,xs,excl);}
      set32(scr,sp*4,pr); sp=sp+1; done=1;
    }
    if(done==0){ if(ins==1){ excl=exm_of(y0,y1,y2); done=1; } }
    if(done==0){
      if(ins==2){
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,0)); sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,1)); sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,2)); sp=sp+1;
        done=1;
      }
    }
    if(done==0){ if(ins==3){ let md:i32=stack_med(scr,sp); set32(scr,0,md); sp=1; done=1; } }
    if(done==0){
      let s:i32=0; let k2:i32=0;
      while(k2<sp){ s=s+get32(scr,k2*4); k2=k2+1; }
      let m2:i32=0;
      if(sp>0){ m2=s/sp; }
      set32(scr,0,m2); sp=1;
    }
    j=j+1;
  }
  if(sp<1){ return 0; }
  return get32(scr,(sp-1)*4);
}
fn pow5i(n:i32)i32 { let r:i32=1; let i:i32=0; while(i<n){ r=r*5; i=i+1; } return r; }
fn decode_prog(idx:i32, qlen:i32, dig:[]u8)void {
  let j:i32=0;
  while(j<qlen){
    let p:i32=pow5i(qlen-1-j);
    set32(dig,j*4,(idx/p)%5);
    j=j+1;
  }
  return;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0; let n:i32=s.len;
  if(n==0){return -1;}
  while(i<n){
    let c:i32=s[i] as i32;
    if(c<48){return v;}
    if(c>57){return v;}
    v=v*10+(c-48); i=i+1;
  }
  return v;
}
fn main()i32 {
  let S:i32=atoi(_zag_arg(1));
  let REP:i32=atoi(_zag_arg(2));
  let dig:[]u8=z_alloc(64);
  let ob:[]u8=z_alloc(512);
  let sum:i64=0;
  let n:i32=0;
  let R:i32=0;
  while(R<REP){
  let L:i32=1;
  while(L<=8){
    let scr:[]u8=z_alloc(S);
    let total:i32=pow5i(L);
    let idx:i32=0;
    while(idx<total){
      decode_prog(idx,L,dig);
      let r:i32=interp(0,2,7,5,dig,L,scr);
      sum=sum+(r as i64);
      n=n+1;
      idx=idx+1;
    }
    L=L+1;
  }
  R=R+1;
  }
  let at:i32=0;
  at=o_app(ob,at,"B6K S="); at=o_i32(ob,at,S);
  at=o_app(ob,at," progs="); at=o_i32(ob,at,n);
  at=o_app(ob,at," sum=");
  let sv:i64=sum;
  let sst:[]u8=_zag_i64_to_str(sv);
  at=o_app(ob,at,sst);
  at=o_nl(ob,at);
  o_flush(ob,at);
  return 0;
}
// B1 SIGN-DISJOINT NAMESPACE PATCH (charter 37) -- blockerfix lane.
//
// The frozen encoding overloaded ONE integer:
//     op >= 100000  ->  frame slot (op - 100000)
//     op >= 0       ->  node id op
// One namespace, two meanings (B1 / C299 / C375). With NN()=65536 the ranges
// happened not to overlap (max node id 65535 < 100000), so the frozen 5k run
// was CORRECT BY ACCIDENT of two unrelated constants, asserted nowhere.
//
// This patch replaces the threshold with DISJOINT SIGNS, as lane/scalingp8
// (310a8a2d6) and lane/eviction (8f3a289fc) did:
//
//     node reference   op >= 0  ->  node id op
//     frame reference  op <  0  ->  frame slot (-op)-1
//
// Node ids and literal values are non-negative in every producer, so the
// negative half of the integer line is free. FRAME_BASE IS NOT A PARAMETER OF
// THIS ENCODING AT ALL: there is no constant to get wrong, and correctness no
// longer depends on the inequality NN < FRAME_BASE.
//
// The 11 operand sites (res_op; execute MOVE dst+src; BEQ lhs+rhs; INC; DEC;
// exec_val; t2_exec result; fr_get walk; fr_set walk) become sign/bounds tests.
// A wrong-signed reference is now a counted TYPE error rather than a silent
// size accident. Violations return the engine's existing failure sentinel
// -999999, which every call site already propagates.
fn res_op(W:[]u8,f:i32,op:i32)i32 {
  if(op<0){return fr_get(W,f,(-op)-1);}
  if(op>=NN()){return -999999;}
  return ng(W,op,20);
}
fn execute(W:[]u8,root:i32,fr:i32)i32 {
  let cur:i32=root; let st:i32=0;
  if(root<0 || root>=NN()){return -999999;}
  while(st<1000){
    if(cur<0){return -999999;}
    if(cur>=NN()){return -999999;}
    let tag:i32=ng(W,cur,0); let nx:i32=-1;
    if(tag==101){
      let d:i32=ng(W,cur,4); let sr:i32=ng(W,cur,8);
      if(d>=0){return -999999;}
      if(sr>=0 && sr>=NN()){return -999999;}
      fr_set(W,fr,(-d)-1,res_op(W,fr,sr)); nx=seq_nx(W,cur);
    } else {if(tag==102){
      let o1:i32=ng(W,cur,4); let o2:i32=ng(W,cur,8);
      if(o1>=NN()){return -999999;}
      if(o2>=NN()){return -999999;}
      let a:i32=res_op(W,fr,o1); let b:i32=res_op(W,fr,o2);
      if(a==b){nx=ng(W,cur,12);} else {nx=ng(W,cur,16);}
    } else {if(tag==103){
      let s:i32=ng(W,cur,4);
      if(s>=0){return -999999;}
      fr_set(W,fr,(-s)-1,fr_get(W,fr,(-s)-1)+1); nx=seq_nx(W,cur);
    } else {if(tag==104){
      let s2:i32=ng(W,cur,4);
      if(s2>=0){return -999999;}
      fr_set(W,fr,(-s2)-1,fr_get(W,fr,(-s2)-1)-1); nx=seq_nx(W,cur);
    } else {return -999999;}}}}
    if(nx<0){if(tag==102){return -999999;} return 1;}
    cur=nx; st=st+1;
  }
  return -999999;
}
fn exec_val(W:[]u8,root:i32,fr:i32)i32 {
  if(root<0 || root>=NN()){return -999999;}
  if(execute(W,root,fr)!=1){return -999999;}
  let op:i32=ng(W,root,4);
  if(op>=NN()){return -999999;}
  return res_op(W,fr,op);
}
fn t2_guard(W:[]u8,slot:i32,litx:i32)i32 {
  let g:i32=t2_cell(W,102); if(g<0){return -1;}
  ns(W,g,4,-(slot+1)); ns(W,g,8,litx); return g;
}
fn t2_set(W:[]u8,slot:i32,lity:i32)i32 {
  let s:i32=t2_cell(W,101); if(s<0){return -1;}
  ns(W,s,4,-(slot+1)); ns(W,s,8,lity); return s;
}
fn t2_mov(W:[]u8,dst:i32,src:i32)i32 {
  let c:i32=t2_cell(W,101); if(c<0){return -1;}
  ns(W,c,4,-(dst+1)); ns(W,c,8,-(src+1)); return c;
}
fn t2_inc(W:[]u8,slot:i32)i32 {
  let c:i32=t2_cell(W,103); if(c<0){return -1;}
  ns(W,c,4,-(slot+1)); return c;
}

// B1 CONSTANT-SPACE FUZZ (K10/K11) -- blockerfix lane.
//
// THE DELIVERABLE: turn "the frozen 5k run was correct by ACCIDENT of two
// unrelated constants" into an INVARIANT.
//
// The frozen encoding reads one integer with two meanings:
//     op >= FRAME_BASE  ->  frame slot (op - FRAME_BASE)
//     op >= 0           ->  node id op
// The two meanings collide exactly when   max_live_node_id >= FRAME_BASE.
// In the canonical C267 build FRAME_BASE=100000 and NN=65536, so the
// condition was unreachable: correct by accident, asserted nowhere.
//
// The sign-disjoint encoding removes the constant:
//     op >= 0 -> node id op          op < 0 -> frame slot (-op)-1
// Node ids are non-negative in every producer, so the two ranges are disjoint
// for EVERY arena size. There is no FRAME_BASE to get wrong.
//
// This binary does not argue that. It EXHAUSTIVELY sweeps the constant space
// and reports, for each (NN, FRAME_BASE) pair, whether the encoding can be
// made to return a WRONG ANSWER (a node id silently read as a frame slot, or
// a frame slot silently read as a node id).
//
// Prereg: blockerfix PREREG.md K10/K11.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// ---- the two encodings, verbatim in the shape the engine uses them ----
// LEGACY: the frozen magnitude test.
fn res_op_legacy(nodeval:i32, frameval:i32, op:i32, NN:i32, FB:i32)i32 {
  if(op>=FB){ return frameval; }        // read as a frame slot
  if(op>=0){ return nodeval; }          // read as a node id
  return 0;
}
// DISJOINT: the sign test. Note there is NO FB parameter at all.
fn res_op_disjoint(nodeval:i32, frameval:i32, op:i32, NN:i32, FB:i32)i32 {
  if(op<0){ return frameval; }          // read as a frame slot
  if(op>=NN){ return -999999; }         // defined failure
  return nodeval;
}

// A probe carries a DISTINGUISHING node value and frame value so that a
// misread is observable: correct node read -> 111, correct frame read -> 222,
// anything else is a wrong answer.
fn probe_legacy(nodeval:i32, op:i32, NN:i32, FB:i32)i32 {
  return res_op_legacy(111,222,op,NN,FB);
}
fn probe_disjoint(nodeval:i32, op:i32, NN:i32, FB:i32)i32 {
  return res_op_disjoint(111,222,op,NN,FB);
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=o_app(ob,at,"B1-FUZZ-START\n");

  // NN sweep x legacy FRAME_BASE sweep. FB=0 is included deliberately: it is
  // the degenerate "every non-negative operand is a frame slot" encoding.
  let nns:i32=6;
  let nlist:[]u8=z_alloc(64);
  set32(nlist,0,1024); set32(nlist,4,65536); set32(nlist,8,131072);
  set32(nlist,12,262144); set32(nlist,16,524288); set32(nlist,20,1048576);
  let fbs:i32=4;
  let fblist:[]u8=z_alloc(64);
  set32(fblist,0,0); set32(fblist,4,1000); set32(fblist,8,10000); set32(fblist,12,100000);

  // The set of node ids a well-formed producer can mint for a given NN: the
  // highest legal id is NN-1, and every id in [0, NN) is producible. So the
  // worst case for the legacy encoding is op = NN-1, and the worst case for
  // the sign encoding is op = NN-1 (in range) and op = NN (out of range).
  let i:i32=0;
  let j:i32=0;
  let legacy_collisions:i32=0;
  let disjoint_collisions:i32=0;
  let combos:i32=0;
  while(i<nns){
    let NN:i32=get32(nlist,i*4);
    j=0;
    while(j<fbs){
      let FB:i32=get32(fblist,j*4);
      combos=combos+1;
      // --- legacy: is the highest legal node id misread as a frame slot? ---
      let worst:i32=NN-1;
      let lr:i32=probe_legacy(worst,worst,NN,FB);
      let lbad:i32=0;
      if(lr!=111){ lbad=1; legacy_collisions=legacy_collisions+1; }
      // --- disjoint: node id NN-1 must read as a node, always ---
      let dr:i32=probe_disjoint(NN-1,NN-1,NN,FB);
      let dbad:i32=0;
      if(dr!=111){ dbad=1; disjoint_collisions=disjoint_collisions+1; }
      at=o_app(ob,at,"B1F NN="); at=o_i32(ob,at,NN);
      at=o_app(ob,at," FB="); at=o_i32(ob,at,FB);
      at=o_app(ob,at," legacy_worst_op="); at=o_i32(ob,at,worst);
      at=o_app(ob,at," legacy_read="); at=o_i32(ob,at,lr);
      at=o_app(ob,at," legacy=");
      if(lbad==1){ at=o_app(ob,at,"COLLIDES"); } else { at=o_app(ob,at,"ok"); }
      at=o_app(ob,at," disjoint_read="); at=o_i32(ob,at,dr);
      at=o_app(ob,at," disjoint=");
      if(dbad==1){ at=o_app(ob,at,"COLLIDES"); } else { at=o_app(ob,at,"ok"); }
      at=o_nl(ob,at);
      j=j+1;
    }
    i=i+1;
  }
  at=o_app(ob,at,"B1F combos="); at=o_i32(ob,at,combos);
  at=o_app(ob,at," legacy_collisions="); at=o_i32(ob,at,legacy_collisions);
  at=o_app(ob,at," disjoint_collisions="); at=o_i32(ob,at,disjoint_collisions);
  at=o_nl(ob,at);

  // ---- malformed-reference injection (K11) ----
  // Every shape that could ever confuse the two encodings, checked against
  // the sign encoding. A defined failure (-999999) is a PASS; a wrong answer
  // is a FAIL.
  at=o_app(ob,at,"B1F-INJECT\n");
  let inj:i32=8;
  let ops:[]u8=z_alloc(64);
  set32(ops,0,-1);      // negative: frame slot 0 in the sign encoding
  set32(ops,4,-2);      // frame slot 1
  set32(ops,8,-2147483647);
  set32(ops,12,0);      // node 0
  set32(ops,16,65535);
  set32(ops,20,65536);  // exactly NN: out of range, must be a defined failure
  set32(ops,24,131071);
  set32(ops,28,2147483647);
  let NN2:i32=65536;
  let FB2:i32=100000;
  let k:i32=0;
  let inj_bad:i32=0;
  while(k<inj){
    let op:i32=get32(ops,k*4);
    let r:i32=probe_disjoint(0,op,NN2,FB2);
    // A well-formed negative is a frame read; a non-negative in range is a
    // node read; out of range must be the failure sentinel.
    let want:i32=0;
    if(op<0){ want=222; }
    else { if(op<NN2){ want=111; } else { want=-999999; } }
    let okc:i32=0;
    if(r==want){ okc=1; } else { inj_bad=inj_bad+1; }
    at=o_app(ob,at,"B1FJ op="); at=o_i32(ob,at,op);
    at=o_app(ob,at," got="); at=o_i32(ob,at,r);
    at=o_app(ob,at," want="); at=o_i32(ob,at,want);
    at=o_app(ob,at," ");
    if(okc==1){ at=o_app(ob,at,"PASS"); } else { at=o_app(ob,at,"FAIL"); }
    at=o_nl(ob,at);
    k=k+1;
  }
  at=o_app(ob,at,"B1F inj_total="); at=o_i32(ob,at,inj);
  at=o_app(ob,at," inj_bad="); at=o_i32(ob,at,inj_bad);
  at=o_app(ob,at," K11a_disjoint_zero_collisions=");
  if(disjoint_collisions==0){ at=o_app(ob,at,"PASS"); } else { at=o_app(ob,at,"FAIL"); }
  at=o_app(ob,at," K11b_legacy_test_has_teeth=");
  if(legacy_collisions>0){ at=o_app(ob,at,"PASS"); } else { at=o_app(ob,at,"FAIL"); }
  at=o_nl(ob,at);
  at=o_app(ob,at,"B1-FUZZ-END\n");
  o_flush(ob,at);
  return 0;
}
// B6 verify -- K4/K5/K6. Uses the REAL unguarded interpreter (verbatim
// set32/get32, no instrumentation) so an out-of-bounds write panics exactly
// as the ledger observed.
//
// Modes:
//   0  L=7 ledger program [fit,loo3,loo3,loo3,loo3,loo3,fit], scr=64
//      -> prereg K5: MUST panic. Confirms the ledger root cause.
//   1  same program, scr = 12L-8 = 76      -> must COMPLETE
//   2  same program, scr = 128              -> must COMPLETE
//   3  L=12 worst valid [loo3 x11, fit], scr=128
//      -> prereg K2: MUST panic. Proves 128 is NOT a fix, only a bigger
//         accident that happens to cover L<=11.
//   4  L=12 worst valid, scr = 12L-8 = 136  -> must COMPLETE
//   5  argv L, argv bufsize: worst valid program for L at the given size,
//      compared against the same program at 4096 bytes. K4 equivalence.
//   6  argv L, argv bufsize: worst valid program, report only.
//
// Prereg: lane/blockerfix PREREG.md.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn abs32(v:i32)i32 { if(v<0){ return 0-v; } return v; }
fn loo_pred(y0:i32, y1:i32, y2:i32, xstar:i32, excl:i32)i32 {
  let xa:i32=0; let ya:i32=0; let xb:i32=0; let yb:i32=0;
  if(excl==0){xa=1;ya=y1;xb=2;yb=y2;}
  else {
    if(excl==1){xa=0;ya=y0;xb=2;yb=y2;}
    else {xa=0;ya=y0;xb=1;yb=y1;}
  }
  let a:i32=(yb-ya)/(xb-xa);
  let b:i32=ya-a*xa;
  return a*xstar+b;
}
fn exm_of(y0:i32, y1:i32, y2:i32)i32 {
  let a:i32=y1-y0;
  let b:i32=y0;
  let r2:i32=abs32(a*2+b-y2);
  if(r2>0){return 2;}
  return 0;
}
fn stack_med(scr:[]u8, sp:i32)i32 {
  let a2:i32=0;
  while(a2<sp){
    let b2:i32=a2+1;
    while(b2<sp){
      let va:i32=get32(scr,a2*4);
      let vb:i32=get32(scr,b2*4);
      if(vb<va){
        set32(scr,a2*4,vb);
        set32(scr,b2*4,va);
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  return get32(scr,((sp-1)/2)*4);
}
// VERBATIM frozen interpreter (invent.zag::learner_interp), digit array form.
fn interp(y0:i32, y1:i32, y2:i32, xs:i32, dig:[]u8, qlen:i32, scr:[]u8)i32 {
  let excl:i32=-1;
  let sp:i32=0;
  let j:i32=0;
  while(j<qlen){
    let ins:i32=get32(dig,j*4);
    let done:i32=0;
    if(ins==0){
      let pr:i32=0;
      if(excl==-1){pr=(y1-y0)*xs+y0;}
      else {pr=loo_pred(y0,y1,y2,xs,excl);}
      set32(scr,sp*4,pr);
      sp=sp+1;
      done=1;
    }
    if(done==0){ if(ins==1){ excl=exm_of(y0,y1,y2); done=1; } }
    if(done==0){
      if(ins==2){
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,0));
        sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,1));
        sp=sp+1;
        set32(scr,sp*4,loo_pred(y0,y1,y2,xs,2));
        sp=sp+1;
        done=1;
      }
    }
    if(done==0){
      if(ins==3){
        let md:i32=stack_med(scr,sp);
        set32(scr,0,md);
        sp=1;
        done=1;
      }
    }
    if(done==0){
      let s:i32=0;
      let k2:i32=0;
      while(k2<sp){ s=s+get32(scr,k2*4); k2=k2+1; }
      let m2:i32=s/sp;
      set32(scr,0,m2);
      sp=1;
    }
    j=j+1;
  }
  return get32(scr,(sp-1)*4);
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn atoi(s:[]u8)i32 {
  let v:i32=0; let i:i32=0;
  let n:i32=s.len;
  if(n==0){return -1;}
  while(i<n){
    let c:i32=s[i] as i32;
    if(c<48){return v;}
    if(c>57){return v;}
    v=v*10+(c-48); i=i+1;
  }
  return v;
}
fn say(ob:[]u8,at:i32,tag:[]u8,L:i32,bs:i32,r:i32)i32 {
  let c:i32=at;
  c=o_app(ob,c,tag);
  c=o_app(ob,c," L="); c=o_i32(ob,c,L);
  c=o_app(ob,c," scr="); c=o_i32(ob,c,bs);
  c=o_app(ob,c," result="); c=o_i32(ob,c,r);
  return o_nl(ob,c);
}
fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let mode:i32=atoi(_zag_arg(1));
  let y0:i32=0; let y1:i32=2; let y2:i32=7; let xs:i32=5;
  let dig:[]u8=z_alloc(256);
  let at:i32=0;

  if(mode==0){
    // K5: the ledger's crashing program, frozen 64-byte scratch.
    set32(dig,0,0); set32(dig,4,2); set32(dig,8,2); set32(dig,12,2);
    set32(dig,16,2); set32(dig,20,2); set32(dig,24,0);
    at=say(ob,at,"B6V K5_CRASHREPRO_START",7,64,0);
    o_flush(ob,at);
    let scr:[]u8=z_alloc(64);
    at=0;
    let r:i32=interp(y0,y1,y2,xs,dig,7,scr);
    at=say(ob,at,"B6V K5_CRASHREPRO_NO_CRASH",7,64,r);
    o_flush(ob,at);
    return 0;
  }
  if(mode==1){
    set32(dig,0,0); set32(dig,4,2); set32(dig,8,2); set32(dig,12,2);
    set32(dig,16,2); set32(dig,20,2); set32(dig,24,0);
    let scr:[]u8=z_alloc(76);
    let r:i32=interp(y0,y1,y2,xs,dig,7,scr);
    at=say(ob,at,"B6V K4_DERIVED76",7,76,r);
    o_flush(ob,at);
    return 0;
  }
  if(mode==2){
    set32(dig,0,0); set32(dig,4,2); set32(dig,8,2); set32(dig,12,2);
    set32(dig,16,2); set32(dig,20,2); set32(dig,24,0);
    let scr:[]u8=z_alloc(128);
    let r:i32=interp(y0,y1,y2,xs,dig,7,scr);
    at=say(ob,at,"B6V K4_MAGIC128",7,128,r);
    o_flush(ob,at);
    return 0;
  }
  if(mode==3){
    // K2: L=12 worst valid program, scratch 128. MUST panic.
    let j:i32=0;
    while(j<11){ set32(dig,j*4,2); j=j+1; }
    set32(dig,11*4,0);
    at=say(ob,at,"B6V K2_L12_AT128_START",12,128,0);
    o_flush(ob,at);
    let scr:[]u8=z_alloc(128);
    at=0;
    let r:i32=interp(y0,y1,y2,xs,dig,12,scr);
    at=say(ob,at,"B6V K2_L12_AT128_NO_CRASH",12,128,r);
    o_flush(ob,at);
    return 0;
  }
  if(mode==4){
    let j:i32=0;
    while(j<11){ set32(dig,j*4,2); j=j+1; }
    set32(dig,11*4,0);
    let scr:[]u8=z_alloc(136);
    let r:i32=interp(y0,y1,y2,xs,dig,12,scr);
    at=say(ob,at,"B6V K2_L12_DERIVED136",12,136,r);
    o_flush(ob,at);
    return 0;
  }
  // modes 5 / 6: argv L, argv bufsize
  let L:i32=atoi(_zag_arg(2));
  let bs:i32=atoi(_zag_arg(3));
  let j:i32=0;
  while(j<L-1){ set32(dig,j*4,2); j=j+1; }
  set32(dig,(L-1)*4,0);
  if(mode==5){
    let small:[]u8=z_alloc(bs);
    let big:[]u8=z_alloc(4096);
    let rs:i32=interp(y0,y1,y2,xs,dig,L,small);
    let rb:i32=interp(y0,y1,y2,xs,dig,L,big);
    at=say(ob,at,"B6V K4_EQUIV",L,bs,rs);
    at=o_app(ob,at,"B6V K4_REF4096 result=");
    at=o_i32(ob,at,rb);
    at=o_app(ob,at," match=");
    if(rs==rb){ at=o_app(ob,at,"YES"); } else { at=o_app(ob,at,"NO"); }
    at=o_nl(ob,at);
    o_flush(ob,at);
    return 0;
  }
  let scr:[]u8=z_alloc(bs);
  let r:i32=interp(y0,y1,y2,xs,dig,L,scr);
  at=say(ob,at,"B6V RUN",L,bs,r);
  o_flush(ob,at);
  return 0;
}
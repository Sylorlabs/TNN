// intent_learn.zag — Procedure-intent retrieval for the continuing learner.
// Closes the documented H-ROUTER/H-UNIFIED gap: queries apply ALL slots.
// This implements H-INTENT (prereg PREREG_INTENT.md, amendment
// PREREG_INTENT_AMEND1.md) as repaired by H-INTENT-UNIFIED2
// (prereg PREREG_INTENT_UNIFIED2.md): infer which stored procedure the
// querier intends from exact training-input match, bridge-condition
// firing, and training-length match. Withholds on genuine ambiguity.
//
// Mechanism: per-slot intent store (learn_seq, train_len, training
// inputs). Candidates are proc slots with an intent record plus bridge
// rules. Score = exact_match*40000 + cond_fire*20000 + len_match*10000.
// learn_seq is recorded and traced for provenance but EXCLUDED from the
// decision (X-IU1 repair). Top-two tie on the query-informative score
// means genuinely ambiguous -> WITHHOLD AMBIGUOUS.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn wcopy(W:[]u8, off:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ W[off+i]=s[i]; i=i+1; }
  return s.len;
}
fn find_ch(b:[]u8, lo:i32, hi:i32, ch:u8)i32 {
  let i:i32=lo;
  while(i<hi){if(b[i]==ch){return i;}i=i+1;}
  return -1;
}

// ============ PROCEDURE STORE (from unified_learn.zag) ============
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    if(peval(prog, nnodes, k, n)!=get32(seq, k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn PROC_MAX()i32 { return 16; }
fn PROC_SZ()i32 { return 64; }
fn proc_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*PROC_SZ();
}
fn proc_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot));
}
fn proc_set_used(W:[]u8, base:i32, slot:i32, v:i32)void {
  set32(W, proc_slot(W,base,slot), v);
  return;
}
fn proc_store(W:[]u8, base:i32, prog:[]u8, nnodes:i32)i32 {
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,base,s)==0){
      proc_set_used(W,base,s,1);
      set32(W, proc_slot(W,base,s)+4, nnodes);
      let i:i32=0;
      while(i<nnodes*3){
        W[proc_slot(W,base,s)+8+i]=prog[i];
        i=i+1;
      }
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn proc_nnodes(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot)+4);
}
fn peval_from_store(W:[]u8, base:i32, slot:i32, nnodes:i32, k:i32, n:i32)i32 {
  let tmp:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nnodes*3){
    tmp[i]=W[proc_slot(W,base,slot)+8+i];
    i=i+1;
  }
  return peval(tmp, nnodes, k, n);
}
fn proc_apply(W:[]u8, base:i32, slot:i32, inp:[]u8, out:[]u8)i32 {
  let nnodes:i32=proc_nnodes(W,base,slot);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_from_store(W, base, slot, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn try_discover_pass(W:[]u8, pbase:i32, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let slot:i32=proc_store(W, pbase, tmp, nn);
        return slot;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn try_dry_pass(W:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn pdiscover_direct(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let slot:i32=try_discover_pass(W, pbase, prog_store, prog_index, pcount, seqs, nseq, 1);
  if(slot<0){
    slot=try_discover_pass(W, pbase, prog_store, prog_index, pcount, seqs, nseq, 0);
  }
  return slot;
}
fn pdiscover_dry(W:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nnr:i32=try_dry_pass(W, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nnr<0){
    nnr=try_dry_pass(W, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0);
  }
  return nnr;
}

// ============ BRIDGE RULE STORE (from unified_learn.zag) ============
fn BR_MAX()i32 { return 4; }
fn BR_SZ()i32 { return 20; }
fn br_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*BR_SZ();
}
fn br_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, br_slot(W,base,slot));
}
fn br_store(W:[]u8, base:i32, cpos:i32, cval:i32, pt:i32, pf:i32)i32 {
  let s:i32=0;
  while(s<BR_MAX()){
    if(br_used(W,base,s)==0){
      let o:i32=br_slot(W,base,s);
      set32(W,o,1); set32(W,o+4,cpos); set32(W,o+8,cval);
      set32(W,o+12,pt); set32(W,o+16,pf);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn br_count(W:[]u8, base:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<BR_MAX()){ if(br_used(W,base,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn br_cpos(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+4); }
fn br_cval(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+8); }
fn br_ptrue(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+12); }
fn br_pfalse(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+16); }
fn bridge_apply(W:[]u8, pbase:i32, bbase:i32, bslot:i32, inp:[]u8, out:[]u8)i32 {
  let cpos:i32=br_cpos(W,bbase,bslot);
  let cval:i32=br_cval(W,bbase,bslot);
  let pt:i32=br_ptrue(W,bbase,bslot);
  let pf:i32=br_pfalse(W,bbase,bslot);
  if(inp.len>cpos && (inp[cpos] as i32)==cval){
    return proc_apply(W, pbase, pt, inp, out);
  }
  return proc_apply(W, pbase, pf, inp, out);
}
fn bridge_learn(W:[]u8, pbase:i32, bbase:i32, pairbase:i32, npairs:i32, work:i32)i32 {
  // H-INTENT-UNIFIED4 (X-IU3-2 audit): honest WORK area bound.
  // Layout: seqbase=work (npairs*64), statbase=work+npairs*64
  // (npairs*4), lenbase=statbase+npairs*4 (npairs*4). Total
  // work+npairs*72 must not reach pairbase, else silent corruption.
  // Fail honestly instead of corrupting.
  let work_need:i32=npairs*72;
  if(work+work_need>pairbase){
    emit("bridge: WORK area too small for npairs=");
    emit(i32s(npairs));
    emit("; need ");
    emit(i32s(work_need));
    emit(" bytes; honest failure\n");
    return -1;
  }
  let seqbase:i32=work;
  let statbase:i32=work + npairs*64;
  let lenbase:i32=statbase + npairs*4;
  let i:i32=0;
  let allok:i32=1;
  let maxlen:i32=0;
  while(i<npairs){
    let in_off:i32=get32(W, pairbase+i*16);
    let in_len:i32=get32(W, pairbase+i*16+4);
    let out_off:i32=get32(W, pairbase+i*16+8);
    let out_len:i32=get32(W, pairbase+i*16+12);
    if(in_len>maxlen){maxlen=in_len;}
    // H-INTENT-UNIFIED5 (X-IU4-2b repair): honest 16-char extraction
    // cap. pextract writes out_len i32s into sq (64 bytes = 16 i32s)
    // and the per-pair seqbase slot holds 16 i32s. An output longer
    // than 16 chars cannot be represented; exclude the pair honestly
    // instead of overflowing. Mirrors the pextract-failure path below.
    if(out_len>16){
      emit("bridge: pair ");
      emit(i32s(i));
      emit(" output length ");
      emit(i32s(out_len));
      emit(" exceeds 16-char extraction capacity; excluded (honest cap)\n");
      set32(W, statbase+i*4, 0);
      allok=0;
    } else {
      let sq:[]u8=z_alloc(64);
      let sl:i32=pextract(W[in_off..in_off+in_len], W[out_off..out_off+out_len], sq);
      if(sl<0){
        set32(W, statbase+i*4, 0);
        allok=0;
      } else {
        set32(W, statbase+i*4, 1);
        set32(W, lenbase+i*4, sl);
        let j:i32=0;
        while(j<sl*4){ W[seqbase+i*64+j]=sq[j]; j=j+1; }
      }
    }
    i=i+1;
  }
  if(allok==1){
    let desc:[]u8=z_alloc(npairs*12);
    i=0;
    while(i<npairs){
      set32(desc, i*12, seqbase+i*64);
      set32(desc, i*12+4, get32(W, lenbase+i*4));
      set32(desc, i*12+8, get32(W, pairbase+i*16+4));
      i=i+1;
    }
    let slot:i32=pdiscover_direct(W, pbase, desc, npairs);
    if(slot>=0){
      return slot;
    }
  }
  emit("bridge: direct failed, inducing condition...\n");
  let p:i32=0;
  while(p<maxlen){
    let okp:i32=1;
    i=0;
    while(i<npairs){
      if(get32(W, pairbase+i*16+4)<=p){okp=0; break;}
      i=i+1;
    }
    if(okp==1){
      // H-INTENT-UNIFIED4 (X-IU3-2 repair): size by 256, the exact
      // upper bound for distinct byte values. The fixed z_alloc(128)
      // panicked past 128 distinct values.
      let dvals:[]u8=z_alloc(256);
      let ndv:i32=0;
      i=0;
      while(i<npairs){
        let in_off:i32=get32(W, pairbase+i*16);
        let v:i32=W[in_off+p] as i32;
        let found:i32=0;
        let k:i32=0;
        while(k<ndv){
          if((dvals[k] as i32)==v){found=1; break;}
          k=k+1;
        }
        if(found==0){
          dvals[ndv]=v as u8;
          ndv=ndv+1;
        }
        i=i+1;
      }
      let vi:i32=0;
      while(vi<ndv){
        let v:i32=dvals[vi] as i32;
        // H-INTENT-UNIFIED3 (X-IU2-3b): size split index buffers by
        // npairs, not a fixed 16 entries. n1/n2 are bounded by npairs
        // (one increment per pair index i < npairs), so this cannot
        // overflow. The fixed z_alloc(64) panicked past 16 pairs.
        let s1idx:[]u8=z_alloc(npairs*4);
        let s2idx:[]u8=z_alloc(npairs*4);
        let n1:i32=0;
        let n2:i32=0;
        i=0;
        while(i<npairs){
          if(get32(W, statbase+i*4)==1){
            let in_off:i32=get32(W, pairbase+i*16);
            if((W[in_off+p] as i32)==v){
              set32(s1idx, n1*4, i); n1=n1+1;
            } else {
              set32(s2idx, n2*4, i); n2=n2+1;
            }
          }
          i=i+1;
        }
        if(n1>0 && n2>0){
          let d1:[]u8=z_alloc(n1*12);
          let k:i32=0;
          while(k<n1){
            let pi:i32=get32(s1idx, k*4);
            set32(d1, k*12, seqbase+pi*64);
            set32(d1, k*12+4, get32(W, lenbase+pi*4));
            set32(d1, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          let d2:[]u8=z_alloc(n2*12);
          k=0;
          while(k<n2){
            let pi:i32=get32(s2idx, k*4);
            set32(d2, k*12, seqbase+pi*64);
            set32(d2, k*12+4, get32(W, lenbase+pi*4));
            set32(d2, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          let prog1:[]u8=z_alloc(48);
          let nn1:i32=pdiscover_dry(W, d1, n1, prog1);
          if(nn1>=0){
            let prog2:[]u8=z_alloc(48);
            let nn2:i32=pdiscover_dry(W, d2, n2, prog2);
            if(nn2>=0){
              let s1:i32=proc_store(W, pbase, prog1, nn1);
              if(s1>=0){
                let s2:i32=proc_store(W, pbase, prog2, nn2);
                if(s2>=0){
                  let bs:i32=br_store(W, bbase, p, v, s1, s2);
                  if(bs>=0){
                    emit("bridge: learned IF input[");
                    emit(i32s(p));
                    emit("]==");
                    emit(i32s(v));
                    emit(" THEN proc");
                    emit(i32s(s1));
                    emit(" ELSE proc");
                    emit(i32s(s2));
                    emit("\n");
                    return 1000+bs;
                  }
                }
              }
              return -1;
            }
          }
        }
        vi=vi+1;
      }
    }
    p=p+1;
  }
  return -1;
}

// ============ WORKSPACE LAYOUT ============
fn PBASE()i32 { return 0; }
fn BBASE()i32 { return 1024; }
fn WORK()i32 { return 2048; }
fn PAIRBASE()i32 { return 8192; }
fn ST_STR()i32 { return 65000; }
fn STR0()i32 { return 16384; }
// Intent store (H-INTENT-UNIFIED2, repaired): IBASE=1560.
// Per proc slot 16 bytes: [learn_seq, train_len, true_npairs, in_list_off].
// H-INTENT-UNIFIED4: o+8 holds TRUE npairs (uncapped); the recorded list
// holds min(npairs,16); truncated = (true_npairs > 16).
// 16 slots: 1560..1816. Per bridge rule 16 bytes: 1816..1880.
// Global seq counter at SEQADDR=1880. Verified free: causal store ends
// at 1552, WORK starts at 2048.
// in_list_off points into the persistent string area: in_count
// (in_off, in_len) i32 pairs. Input bytes stay where the learn handler
// staged them (string area is append-only). Cap 16 inputs per record.
fn IBASE()i32 { return 1560; }
fn SEQADDR()i32 { return 1880; }

// ============ INTENT STORE (H-INTENT-UNIFIED2) ============
fn intent_proc_base(W:[]u8, slot:i32)i32 { return IBASE() + slot*16; }
fn intent_br_base(W:[]u8, bslot:i32)i32 { return IBASE() + 16*16 + bslot*16; }
// All learn_seq init to -1: only slots with learn_seq >= 0 are candidates.
// Bridge sub-procedures never receive intent records, so they are excluded.
fn intent_init(W:[]u8)void {
  let i:i32=0;
  while(i<16){
    let o:i32=IBASE()+i*16;
    set32(W, o, -1);
    set32(W, o+4, -1);
    set32(W, o+8, 0);
    set32(W, o+12, -1);
    i=i+1;
  }
  i=0;
  while(i<4){
    let o:i32=IBASE()+256+i*16;
    set32(W, o, -1);
    set32(W, o+4, -1);
    set32(W, o+8, 0);
    set32(W, o+12, -1);
    i=i+1;
  }
  set32(W, SEQADDR(), 0);
  return;
}
// str_alloc: bump-allocate n bytes in the persistent string area.
fn str_alloc(W:[]u8, n:i32)i32 {
  let p:i32=get32(W, ST_STR());
  set32(W, ST_STR(), p+n);
  return p;
}
// intent_record_inputs: persist the (in_off, in_len) list for the npairs
// training pairs described at pairbase. Returns the list offset.
// H-INTENT-UNIFIED3 (X-IU2-3): the 16-cap truncation is now explicit.
// When npairs exceeds the cap, emit a warning so the boundary is visible
// in the trace instead of silently dropping genuine training evidence.
fn intent_record_inputs(W:[]u8, pairbase:i32, npairs:i32)i32 {
  let cap:i32=npairs;
  if(cap>16){
    cap=16;
    emit("INTENT WARN: record cap 16 reached; ");
    emit(i32s(npairs));
    emit(" training inputs, only first 16 recorded; em coverage incomplete\n");
  }
  let lp:i32=str_alloc(W, cap*8);
  let i:i32=0;
  while(i<cap){
    set32(W, lp+i*8, get32(W, pairbase+i*16));
    set32(W, lp+i*8+4, get32(W, pairbase+i*16+4));
    i=i+1;
  }
  return lp;
}
fn intent_record_proc(W:[]u8, slot:i32, train_len:i32, pairbase:i32, npairs:i32)void {
  let o:i32=intent_proc_base(W, slot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  // H-INTENT-UNIFIED4 (X-IU3-1a' repair): store TRUE npairs at o+8,
  // not the capped value. The record holds min(npairs,16) inputs;
  // truncated = (o+8 > 16). This gives a persistent truncated-evidence
  // flag for cap-robust conflict detection in intent_winner.
  set32(W, o+8, npairs);
  set32(W, o+12, intent_record_inputs(W, pairbase, npairs));
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}
fn intent_record_br(W:[]u8, bslot:i32, train_len:i32, pairbase:i32, npairs:i32)void {
  let o:i32=intent_br_base(W, bslot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  // H-INTENT-UNIFIED4: store TRUE npairs (see intent_record_proc).
  set32(W, o+8, npairs);
  set32(W, o+12, intent_record_inputs(W, pairbase, npairs));
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}
// intent_exact_match: 1 if line equals any recorded training input of
// the record at rec, else 0. Specificity signal (X-IU2 repair).
// H-INTENT-UNIFIED4: rec+8 now holds TRUE npairs; the recorded list
// holds min(npairs,16), so bound the loop by the capped count.
fn intent_exact_match(W:[]u8, rec:i32, line:[]u8)i32 {
  let n:i32=get32(W, rec+8);
  let cap:i32=n;
  if(cap>16){cap=16;}
  let lp:i32=get32(W, rec+12);
  if(cap<=0 || lp<0){return 0;}
  let qlen:i32=line.len;
  let k:i32=0;
  while(k<cap){
    let off:i32=get32(W, lp+k*8);
    let ln:i32=get32(W, lp+k*8+4);
    if(ln==qlen){
      let j:i32=0;
      let same:i32=1;
      while(j<ln){
        if(W[off+j]!=line[j]){same=0; break;}
        j=j+1;
      }
      if(same==1){return 1;}
    }
    k=k+1;
  }
  return 0;
}
// intent_qscore: query-informative score. learn_seq is recorded and traced
// for provenance but EXCLUDED from the decision (X-IU1 repair): recency
// carries zero information about the querier's intent.
fn intent_qscore(em:i32, cf:i32, lm:i32)i32 {
  return em*40000 + cf*20000 + lm*10000;
}

// ============ UNIFIED LEARN HANDLER (with intent recording) ============
fn handle_proc_learn_unified(W:[]u8, line:[]u8)i32 {
  let n:i32=line.len;
  let nseg:i32=1;
  let i:i32=0;
  while(i<n){if(line[i]==59){nseg=nseg+1;}i=i+1;}
  let strbase:i32=get32(W, ST_STR());
  let s:i32=0;
  let pos:i32=0;
  while(s<nseg){
    let end:i32=find_ch(line,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(line,pos,end,62);
    let in_off:i32=strbase;
    i=pos;
    while(i<gt){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let in_len:i32=gt-pos;
    let out_off:i32=strbase;
    i=gt+1;
    while(i<end){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let out_len:i32=end-(gt+1);
    set32(W, PAIRBASE()+s*16, in_off);
    set32(W, PAIRBASE()+s*16+4, in_len);
    set32(W, PAIRBASE()+s*16+8, out_off);
    set32(W, PAIRBASE()+s*16+12, out_len);
    pos=end+1;
    s=s+1;
  }
  set32(W, ST_STR(), strbase);
  let rc:i32=bridge_learn(W, PBASE(), BBASE(), PAIRBASE(), nseg, WORK());
  // Intent recording: uniform training input length, or -1 if varied.
  let tlen:i32=-1;
  let l0:i32=get32(W, PAIRBASE()+4);
  let allsame:i32=1;
  let ci:i32=0;
  while(ci<nseg){
    if(get32(W, PAIRBASE()+ci*16+4)!=l0){allsame=0; break;}
    ci=ci+1;
  }
  if(allsame==1){tlen=l0;}
  if(rc>=0 && rc<1000){
    intent_record_proc(W, rc, tlen, PAIRBASE(), nseg);
    emit("ULEARN: direct discovery -> proc slot ");
    emit(i32s(rc));
    emit(" (intent seq recorded, train_len=");
    emit(i32s(tlen));
    emit(")\n");
  } else {
    if(rc>=1000){
      intent_record_br(W, rc-1000, tlen, PAIRBASE(), nseg);
      emit("ULEARN: bridge triggered -> rule ");
      emit(i32s(rc-1000));
      emit(" (intent seq recorded, train_len=");
      emit(i32s(tlen));
      emit(")\n");
    } else {
      emit("ULEARN FAIL: no program and no bridge\n");
    }
  }
  return rc;
}

// ============ INTENT DECISION (H-INTENT-UNIFIED2, repaired) ============
// intent_winner: pure decision, minimal emission.
// res: [kind(4), slot(4), gap(4)].
// kind: -1 = no candidate, -2 = ambiguous, 0 = proc, 1 = bridge.
// Scoring (query-informative only):
//   qscore = exact_match*40000 + cond_fire*20000 + len_match*10000.
// learn_seq is excluded from the decision (X-IU1 repair).
// Ambiguity: top two tie on qscore -> WITHHOLD AMBIGUOUS (X-IU1 repair).
fn intent_winner(W:[]u8, line:[]u8, res:[]u8)void {
  let qlen:i32=line.len;
  let ck:[]u8=z_alloc(20*4);
  let ci:[]u8=z_alloc(20*4);
  let cs:[]u8=z_alloc(20*4);
  let ce:[]u8=z_alloc(20*4);
  let ncand:i32=0;
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,PBASE(),s)==1 && get32(W,intent_proc_base(W,s))>=0){
      let out:[]u8=z_alloc(qlen+1);
      if(proc_apply(W,PBASE(),s,line,out)==1){
        let o:i32=intent_proc_base(W,s);
        let tlen:i32=get32(W,o+4);
        let em:i32=intent_exact_match(W,o,line);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        set32(ck,ncand*4,0);
        set32(ci,ncand*4,s);
        set32(cs,ncand*4,intent_qscore(em,0,lm));
        set32(ce,ncand*4,em);
        ncand=ncand+1;
      }
    }
    s=s+1;
  }
  let b:i32=0;
  while(b<BR_MAX()){
    if(br_used(W,BBASE(),b)==1){
      let out:[]u8=z_alloc(qlen+1);
      if(bridge_apply(W,PBASE(),BBASE(),b,line,out)==1){
        let o:i32=intent_br_base(W,b);
        let tlen:i32=get32(W,o+4);
        let em:i32=intent_exact_match(W,o,line);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        let cf:i32=0;
        let cpos:i32=br_cpos(W,BBASE(),b);
        if(qlen>cpos && (line[cpos] as i32)==br_cval(W,BBASE(),b)){cf=1;}
        set32(ck,ncand*4,1);
        set32(ci,ncand*4,b);
        set32(cs,ncand*4,intent_qscore(em,cf,lm));
        set32(ce,ncand*4,em);
        ncand=ncand+1;
      }
    }
    b=b+1;
  }
  if(ncand==0){
    set32(res,0,-1); set32(res,4,-1); set32(res,8,0);
    return;
  }
  let top:i32=0;
  let second:i32=-1;
  let i:i32=1;
  while(i<ncand){
    if(get32(cs,i*4)>get32(cs,top*4)){second=top; top=i;}
    else {
      if(second<0 || get32(cs,i*4)>get32(cs,second*4)){second=i;}
    }
    i=i+1;
  }
  let gap:i32=0;
  if(second>=0){gap=get32(cs,top*4)-get32(cs,second*4);}
  set32(res,8,gap);
  // H-INTENT-UNIFIED3 (X-IU2-1 repair): verbatim-conflict guard.
  // If the top two candidates both carry verbatim training evidence
  // (em=1) for this exact query, the training data genuinely
  // contradicts itself. Compute both answers; if they differ, no
  // heuristic term (cf/lm) may silently resolve the conflict:
  // WITHHOLD AMBIGUOUS. If they agree, the contradiction is moot and
  // the existing rules apply.
  if(second>=0 && get32(ce,top*4)==1 && get32(ce,second*4)==1){
    let o1:[]u8=z_alloc(qlen+1);
    let o2:[]u8=z_alloc(qlen+1);
    let k1:i32=get32(ck,top*4);
    let i1:i32=get32(ci,top*4);
    let k2:i32=get32(ck,second*4);
    let i2:i32=get32(ci,second*4);
    if(k1==0){proc_apply(W,PBASE(),i1,line,o1);}
    else {bridge_apply(W,PBASE(),BBASE(),i1,line,o1);}
    if(k2==0){proc_apply(W,PBASE(),i2,line,o2);}
    else {bridge_apply(W,PBASE(),BBASE(),i2,line,o2);}
    let same:i32=1;
    let j:i32=0;
    while(j<qlen){
      if(o1[j]!=o2[j]){same=0; break;}
      j=j+1;
    }
    if(same==0){
      emit("INTENT VERBATIM-CONFLICT: top two candidates both have exact_match=1 but disagree; WITHHOLD AMBIGUOUS\n");
      set32(res,0,-2); set32(res,4,-1);
      return;
    }
  }
  // H-INTENT-UNIFIED4 (X-IU3-1a' repair): truncated-conflict guard.
  // The verbatim-conflict guard above is blind to collisions where the
  // colliding input falls outside the 16-input record cap on one side:
  // em=0 there is a truncation artifact, not absence of evidence. If
  // one candidate carries verbatim evidence (em=1) and the other has
  // a truncated record (true npairs > 16), compute both answers; if
  // they differ, the training data may genuinely contradict itself
  // and no heuristic term may silently resolve it: WITHHOLD AMBIGUOUS
  // with an explicit diagnostic. If answers agree, fall through.
  if(second>=0){
    let em_top:i32=get32(ce,top*4);
    let em_second:i32=get32(ce,second*4);
    let k_top:i32=get32(ck,top*4);
    let i_top:i32=get32(ci,top*4);
    let k_second:i32=get32(ck,second*4);
    let i_second:i32=get32(ci,second*4);
    // Determine truncation for top and second.
    let rec_top:i32=0;
    if(k_top==0){rec_top=intent_proc_base(W,i_top);}
    else {rec_top=intent_br_base(W,i_top);}
    let rec_second:i32=0;
    if(k_second==0){rec_second=intent_proc_base(W,i_second);}
    else {rec_second=intent_br_base(W,i_second);}
    let trunc_top:i32=0;
    if(get32(W,rec_top+8)>16){trunc_top=1;}
    let trunc_second:i32=0;
    if(get32(W,rec_second+8)>16){trunc_second=1;}
    let check:i32=0;
    let both_trunc:i32=0;
    if(em_top==1 && em_second==0 && trunc_second==1){check=1;}
    if(em_second==1 && em_top==0 && trunc_top==1){check=1;}
    // H-INTENT-UNIFIED5 (X-IU4-1a repair): both-truncated case. When
    // both records are truncated and neither candidate carries verbatim
    // evidence, the unrecorded tails may genuinely contradict, so the
    // same silent-resolution hazard applies. Withhold on disagreement.
    // The branches are mutually exclusive by construction: the verbatim
    // guard needs em=1 on both sides, the two branches above need em=1
    // on one side, this branch needs em=0 on both sides.
    if(em_top==0 && em_second==0 && trunc_top==1 && trunc_second==1){check=1; both_trunc=1;}
    if(check==1){
      let o1:[]u8=z_alloc(qlen+1);
      let o2:[]u8=z_alloc(qlen+1);
      if(k_top==0){proc_apply(W,PBASE(),i_top,line,o1);}
      else {bridge_apply(W,PBASE(),BBASE(),i_top,line,o1);}
      if(k_second==0){proc_apply(W,PBASE(),i_second,line,o2);}
      else {bridge_apply(W,PBASE(),BBASE(),i_second,line,o2);}
      let same:i32=1;
      let j:i32=0;
      while(j<qlen){
        if(o1[j]!=o2[j]){same=0; break;}
        j=j+1;
      }
      if(same==0){
        if(both_trunc==1){
          emit("INTENT TRUNCATED-CONFLICT-POSSIBLE: both records truncated with different answers; WITHHOLD AMBIGUOUS\n");
        } else {
          emit("INTENT TRUNCATED-CONFLICT-POSSIBLE: verbatim candidate meets truncated record with different answer; WITHHOLD AMBIGUOUS\n");
        }
        set32(res,0,-2); set32(res,4,-1);
        return;
      }
    }
  }
  // H-INTENT-UNIFIED6 (X-IU5-1 repair): all-pairs both-truncated guard.
  // The R5/R6 guards compare only the top two ranked candidates; a
  // genuine truncated-vs-truncated contradiction can hide behind an
  // agreeing second (X-IU5-1: C3/bax ranked third behind C2/xxx).
  // Pairwise-compare ALL candidates with em=0 and truncated records;
  // withhold on any disagreement, regardless of rank. Precedence is
  // structural: the top-two guards above fire first with their exact
  // diagnostics; this guard runs only if they did not.
  if(second>=0){
    let iu6_a:i32=0;
    let iu6_conflict:i32=0;
    while(iu6_a<ncand){
      if(get32(ce,iu6_a*4)==0){
        let iu6_ka:i32=get32(ck,iu6_a*4);
        let iu6_ia:i32=get32(ci,iu6_a*4);
        let iu6_rec_a:i32=0;
        if(iu6_ka==0){iu6_rec_a=intent_proc_base(W,iu6_ia);}
        else {iu6_rec_a=intent_br_base(W,iu6_ia);}
        if(get32(W,iu6_rec_a+8)>16){
          let iu6_b:i32=iu6_a+1;
          while(iu6_b<ncand){
            if(get32(ce,iu6_b*4)==0){
              let iu6_kb:i32=get32(ck,iu6_b*4);
              let iu6_ib:i32=get32(ci,iu6_b*4);
              let iu6_rec_b:i32=0;
              if(iu6_kb==0){iu6_rec_b=intent_proc_base(W,iu6_ib);}
              else {iu6_rec_b=intent_br_base(W,iu6_ib);}
              if(get32(W,iu6_rec_b+8)>16){
                let iu6_oa:[]u8=z_alloc(qlen+1);
                let iu6_ob:[]u8=z_alloc(qlen+1);
                if(iu6_ka==0){proc_apply(W,PBASE(),iu6_ia,line,iu6_oa);}
                else {bridge_apply(W,PBASE(),BBASE(),iu6_ia,line,iu6_oa);}
                if(iu6_kb==0){proc_apply(W,PBASE(),iu6_ib,line,iu6_ob);}
                else {bridge_apply(W,PBASE(),BBASE(),iu6_ib,line,iu6_ob);}
                let iu6_same:i32=1;
                let iu6_j:i32=0;
                while(iu6_j<qlen){
                  if(iu6_oa[iu6_j]!=iu6_ob[iu6_j]){iu6_same=0; break;}
                  iu6_j=iu6_j+1;
                }
                if(iu6_same==0){iu6_conflict=1; break;}
              }
            }
            iu6_b=iu6_b+1;
          }
          if(iu6_conflict==1){break;}
        }
      }
      iu6_a=iu6_a+1;
    }
    if(iu6_conflict==1){
      emit("INTENT TRUNCATED-CONFLICT-POSSIBLE: truncated candidates disagree beyond top two; WITHHOLD AMBIGUOUS\n");
      set32(res,0,-2); set32(res,4,-1);
      return;
    }
  }
  // H-INTENT-UNIFIED7 (X-IU6-2 repair): all-pairs verbatim-vs-truncated guard.
  // The R4/R5 truncated guard is top-two-only for pairs with em=1 on one
  // side; a genuine verbatim-vs-truncated contradiction can hide behind
  // agreeing verbatim anchors (X-IU6-2: T3/bax ranked third behind two
  // verbatim agreers on xxx). Pairwise-compare ALL (verbatim, truncated)
  // pairs; withhold on any disagreement, regardless of rank. Precedence is
  // structural: the top-two guards and R8 fire first with their exact
  // diagnostics; this guard runs only if they did not. Pair-class
  // exclusivity holds by construction: R8 checks em=0 on both sides, this
  // guard checks em=1 on exactly one side with the em=0 side truncated.
  if(second>=0){
    let iu7_a:i32=0;
    let iu7_conflict:i32=0;
    while(iu7_a<ncand){
      let iu7_b:i32=iu7_a+1;
      while(iu7_b<ncand){
        let iu7_ea:i32=get32(ce,iu7_a*4);
        let iu7_eb:i32=get32(ce,iu7_b*4);
        let iu7_m:i32=-1;
        if(iu7_ea==1 && iu7_eb==0){iu7_m=iu7_b;}
        if(iu7_ea==0 && iu7_eb==1){iu7_m=iu7_a;}
        if(iu7_m>=0){
          let iu7_km:i32=get32(ck,iu7_m*4);
          let iu7_im:i32=get32(ci,iu7_m*4);
          let iu7_rec:i32=0;
          if(iu7_km==0){iu7_rec=intent_proc_base(W,iu7_im);}
          else {iu7_rec=intent_br_base(W,iu7_im);}
          if(get32(W,iu7_rec+8)>16){
            let iu7_ka:i32=get32(ck,iu7_a*4);
            let iu7_ia:i32=get32(ci,iu7_a*4);
            let iu7_kb:i32=get32(ck,iu7_b*4);
            let iu7_ib:i32=get32(ci,iu7_b*4);
            let iu7_oa:[]u8=z_alloc(qlen+1);
            let iu7_ob:[]u8=z_alloc(qlen+1);
            if(iu7_ka==0){proc_apply(W,PBASE(),iu7_ia,line,iu7_oa);}
            else {bridge_apply(W,PBASE(),BBASE(),iu7_ia,line,iu7_oa);}
            if(iu7_kb==0){proc_apply(W,PBASE(),iu7_ib,line,iu7_ob);}
            else {bridge_apply(W,PBASE(),BBASE(),iu7_ib,line,iu7_ob);}
            let iu7_same:i32=1;
            let iu7_j:i32=0;
            while(iu7_j<qlen){
              if(iu7_oa[iu7_j]!=iu7_ob[iu7_j]){iu7_same=0; break;}
              iu7_j=iu7_j+1;
            }
            if(iu7_same==0){iu7_conflict=1; break;}
          }
        }
        iu7_b=iu7_b+1;
      }
      if(iu7_conflict==1){break;}
      iu7_a=iu7_a+1;
    }
    if(iu7_conflict==1){
      emit("INTENT TRUNCATED-CONFLICT-POSSIBLE: verbatim candidate meets truncated record with different answer beyond top two; WITHHOLD AMBIGUOUS\n");
      set32(res,0,-2); set32(res,4,-1);
      return;
    }
  }
  // H-INTENT-UNIFIED8 (B1 repair): all-pairs both-verbatim guard.
  // The IU3 verbatim guard is top-two-only; a genuine verbatim-vs-
  // verbatim contradiction can hide behind agreeing top-two anchors
  // (B1: V3/bax ranked third behind two verbatim agreers on xxx).
  // Pairwise-compare ALL candidates with em=1 on both sides;
  // withhold on any disagreement, regardless of rank. Precedence is
  // structural: the top-two guards, R8, and R9 fire first with their
  // exact diagnostics; this guard runs only if they did not.
  // Pair-class exclusivity holds by construction: R8 checks em=0 on
  // both sides, R9 checks em=1 on exactly one side with the em=0
  // side truncated, this guard checks em=1 on both sides. No pair is
  // checked by two guards.
  if(second>=0){
    let iu8_a:i32=0;
    let iu8_conflict:i32=0;
    while(iu8_a<ncand){
      if(get32(ce,iu8_a*4)==1){
        let iu8_b:i32=iu8_a+1;
        while(iu8_b<ncand){
          if(get32(ce,iu8_b*4)==1){
            let iu8_ka:i32=get32(ck,iu8_a*4);
            let iu8_ia:i32=get32(ci,iu8_a*4);
            let iu8_kb:i32=get32(ck,iu8_b*4);
            let iu8_ib:i32=get32(ci,iu8_b*4);
            let iu8_oa:[]u8=z_alloc(qlen+1);
            let iu8_ob:[]u8=z_alloc(qlen+1);
            if(iu8_ka==0){proc_apply(W,PBASE(),iu8_ia,line,iu8_oa);}
            else {bridge_apply(W,PBASE(),BBASE(),iu8_ia,line,iu8_oa);}
            if(iu8_kb==0){proc_apply(W,PBASE(),iu8_ib,line,iu8_ob);}
            else {bridge_apply(W,PBASE(),BBASE(),iu8_ib,line,iu8_ob);}
            let iu8_same:i32=1;
            let iu8_j:i32=0;
            while(iu8_j<qlen){
              if(iu8_oa[iu8_j]!=iu8_ob[iu8_j]){iu8_same=0; break;}
              iu8_j=iu8_j+1;
            }
            if(iu8_same==0){iu8_conflict=1; break;}
          }
          iu8_b=iu8_b+1;
        }
        if(iu8_conflict==1){break;}
      }
      iu8_a=iu8_a+1;
    }
    if(iu8_conflict==1){
      emit("INTENT VERBATIM-CONFLICT: verbatim candidates disagree beyond top two; WITHHOLD AMBIGUOUS\n");
      set32(res,0,-2); set32(res,4,-1);
      return;
    }
  }
  if(second>=0 && gap==0){
    set32(res,0,-2); set32(res,4,-1);
    return;
  }
  set32(res,0,get32(ck,top*4));
  set32(res,4,get32(ci,top*4));
  return;
}

// intent_trace_emit: inspectable white-box trace of the intent decision.
fn intent_trace_emit(W:[]u8, line:[]u8)void {
  let qlen:i32=line.len;
  emit("INTENT query [");
  emit(line);
  emit("] qlen=");
  emit(i32s(qlen));
  emit("\n");
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,PBASE(),s)==1 && get32(W,intent_proc_base(W,s))>=0){
      let out:[]u8=z_alloc(qlen+1);
      if(proc_apply(W,PBASE(),s,line,out)==1){
        let o:i32=intent_proc_base(W,s);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let em:i32=intent_exact_match(W,o,line);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        emit("  cand kind=proc slot=");
        emit(i32s(s));
        emit(" exact_match=");
        emit(i32s(em));
        emit(" len_match=");
        emit(i32s(lm));
        emit(" train_len=");
        emit(i32s(tlen));
        emit(" seq=");
        emit(i32s(seq));
        emit(" cond_fire=0 score=");
        emit(i32s(intent_qscore(em,0,lm)));
        emit("\n");
      } else {
        emit("  cand kind=proc slot=");
        emit(i32s(s));
        emit(" DOES-NOT-APPLY\n");
      }
    }
    s=s+1;
  }
  let b:i32=0;
  while(b<BR_MAX()){
    if(br_used(W,BBASE(),b)==1){
      let out:[]u8=z_alloc(qlen+1);
      if(bridge_apply(W,PBASE(),BBASE(),b,line,out)==1){
        let o:i32=intent_br_base(W,b);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let em:i32=intent_exact_match(W,o,line);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        let cf:i32=0;
        let cpos:i32=br_cpos(W,BBASE(),b);
        if(qlen>cpos && (line[cpos] as i32)==br_cval(W,BBASE(),b)){cf=1;}
        emit("  cand kind=bridge slot=");
        emit(i32s(b));
        emit(" exact_match=");
        emit(i32s(em));
        emit(" len_match=");
        emit(i32s(lm));
        emit(" train_len=");
        emit(i32s(tlen));
        emit(" seq=");
        emit(i32s(seq));
        emit(" cond_fire=");
        emit(i32s(cf));
        emit(" score=");
        emit(i32s(intent_qscore(em,cf,lm)));
        emit("\n");
      } else {
        emit("  cand kind=bridge slot=");
        emit(i32s(b));
        emit(" DOES-NOT-APPLY\n");
      }
    }
    b=b+1;
  }
  return;
}

// handle_proc_query_intent: full query handler with trace and answer.
// Returns: 1 answered, 0 withhold (none), -1 withhold (ambiguous).
fn handle_proc_query_intent(W:[]u8, line:[]u8)i32 {
  intent_trace_emit(W, line);
  let res:[]u8=z_alloc(12);
  intent_winner(W, line, res);
  let kind:i32=get32(res,0);
  let slot:i32=get32(res,4);
  let gap:i32=get32(res,8);
  if(kind==-1){
    emit("QINTENT WITHHOLD: no procedure or bridge rule applies\n");
    return 0;
  }
  if(kind==-2){
    emit("QINTENT WITHHOLD AMBIGUOUS: top two tie on query-informative signals\n");
    return -1;
  }
  let qlen:i32=line.len;
  let out:[]u8=z_alloc(qlen+1);
  if(kind==0){
    proc_apply(W,PBASE(),slot,line,out);
    emit("QINTENT ANSWER kind=proc slot=");
  } else {
    bridge_apply(W,PBASE(),BBASE(),slot,line,out);
    emit("QINTENT ANSWER kind=bridge slot=");
  }
  emit(i32s(slot));
  emit(" gap=");
  emit(i32s(gap));
  emit(" [");
  emit(line);
  emit("] -> [");
  emit(out[0..qlen]);
  emit("]\n");
  return 1;
}

// ============ MAIN: H-INTENT TESTS ============
fn main()i32 {
  emit("=== intent_learn v1: H-INTENT procedure-intent retrieval ===\n");
  let npass:i32=0;
  let ntest:i32=0;

  // ---- T1: length disambiguation (K-I1a) ----
  emit("\n--- T1: length disambiguation ---\n");
  let W1:[]u8=z_alloc(65536);
  set32(W1, ST_STR(), STR0());
  intent_init(W1);
  let lr1:i32=handle_proc_learn_unified(W1,"dcba>abcd;wxyz>zyxw");
  let lr2:i32=handle_proc_learn_unified(W1,"abcde>eeeee;fghij>jjjjj");
  ntest=ntest+1;
  if(lr1>=0 && lr1<1000 && lr2>=0 && lr2<1000 && lr1!=lr2){
    emit("T1 setup: reverse slot ");
    emit(i32s(lr1));
    emit(", broadcast slot ");
    emit(i32s(lr2));
    emit(" PASS\n");
    npass=npass+1;
  } else {
    emit("T1 setup FAIL lr1=");
    emit(i32s(lr1));
    emit(" lr2=");
    emit(i32s(lr2));
    emit("\n");
  }
  // T1a: query n=5 -> broadcast-last "ooooo"
  ntest=ntest+1;
  let res1:[]u8=z_alloc(12);
  intent_winner(W1,"hello",res1);
  if(get32(res1,0)==0){
    let slot:i32=get32(res1,4);
    let o:[]u8=z_alloc(6);
    proc_apply(W1,PBASE(),slot,"hello",o);
    let io:i32=intent_proc_base(W1,slot);
    if(streq(o[0..5],"ooooo")==1 && get32(W1,io+4)==5){
      emit("K-I1a T1a hello->ooooo via n=5 slot PASS\n");
      npass=npass+1;
    } else {
      emit("K-I1a T1a FAIL bytes/train_len\n");
    }
  } else {
    emit("K-I1a T1a FAIL kind=");
    emit(i32s(get32(res1,0)));
    emit("\n");
  }
  handle_proc_query_intent(W1,"hello");
  // T1b: query n=4 -> reverse "dcba"
  ntest=ntest+1;
  let res2:[]u8=z_alloc(12);
  intent_winner(W1,"abcd",res2);
  if(get32(res2,0)==0){
    let slot:i32=get32(res2,4);
    let o:[]u8=z_alloc(5);
    proc_apply(W1,PBASE(),slot,"abcd",o);
    let io:i32=intent_proc_base(W1,slot);
    if(streq(o[0..4],"dcba")==1 && get32(W1,io+4)==4){
      emit("K-I1a T1b abcd->dcba via n=4 slot PASS\n");
      npass=npass+1;
    } else {
      emit("K-I1a T1b FAIL bytes/train_len\n");
    }
  } else {
    emit("K-I1a T1b FAIL kind=");
    emit(i32s(get32(res2,0)));
    emit("\n");
  }
  handle_proc_query_intent(W1,"abcd");

  // ---- T2: bridge condition intent (K-I1b), fresh W ----
  emit("\n--- T2: bridge condition intent ---\n");
  let W2:[]u8=z_alloc(65536);
  set32(W2, ST_STR(), STR0());
  intent_init(W2);
  let br:i32=handle_proc_learn_unified(W2,"xab>xxx;xcd>xxx;abc>ccc;def>fff;abcde>eeeee");
  ntest=ntest+1;
  if(br>=1000 && br_cpos(W2,BBASE(),br-1000)==0 && br_cval(W2,BBASE(),br-1000)==120){
    emit("T2 setup: bridge rule ");
    emit(i32s(br-1000));
    emit(" IF input[0]==120 PASS\n");
    npass=npass+1;
  } else {
    emit("T2 setup FAIL br=");
    emit(i32s(br));
    emit("\n");
  }
  // T2a: "xqz" fires condition -> "xxx"
  ntest=ntest+1;
  let res3:[]u8=z_alloc(12);
  intent_winner(W2,"xqz",res3);
  if(get32(res3,0)==1){
    let bslot:i32=get32(res3,4);
    let o:[]u8=z_alloc(4);
    bridge_apply(W2,PBASE(),BBASE(),bslot,"xqz",o);
    if(streq(o[0..3],"xxx")==1){
      emit("K-I1b T2a xqz->xxx via firing bridge PASS\n");
      npass=npass+1;
    } else {
      emit("K-I1b T2a FAIL bytes\n");
    }
  } else {
    emit("K-I1b T2a FAIL kind=");
    emit(i32s(get32(res3,0)));
    emit("\n");
  }
  handle_proc_query_intent(W2,"xqz");
  // T2b: "qrs" ELSE branch -> "sss"
  ntest=ntest+1;
  let res4:[]u8=z_alloc(12);
  intent_winner(W2,"qrs",res4);
  if(get32(res4,0)==1){
    let bslot:i32=get32(res4,4);
    let o:[]u8=z_alloc(4);
    bridge_apply(W2,PBASE(),BBASE(),bslot,"qrs",o);
    if(streq(o[0..3],"sss")==1){
      emit("K-I1b T2b qrs->sss via bridge ELSE PASS\n");
      npass=npass+1;
    } else {
      emit("K-I1b T2b FAIL bytes\n");
    }
  } else {
    emit("K-I1b T2b FAIL kind=");
    emit(i32s(get32(res4,0)));
    emit("\n");
  }
  handle_proc_query_intent(W2,"qrs");

  // ---- T3: genuine ambiguity (K-I2), fresh W ----
  emit("\n--- T3: ambiguity ---\n");
  let W3:[]u8=z_alloc(65536);
  set32(W3, ST_STR(), STR0());
  intent_init(W3);
  let ar1:i32=handle_proc_learn_unified(W3,"abcde>edcba;vwxyz>zyxwv");
  let ar2:i32=handle_proc_learn_unified(W3,"abcde>eeeee;fghij>jjjjj");
  ntest=ntest+1;
  if(ar1>=0 && ar1<1000 && ar2>=0 && ar2<1000 && ar1!=ar2){
    emit("T3 setup: reverse slot ");
    emit(i32s(ar1));
    emit(", broadcast slot ");
    emit(i32s(ar2));
    emit(" PASS\n");
    npass=npass+1;
  } else {
    emit("T3 setup FAIL ar1=");
    emit(i32s(ar1));
    emit(" ar2=");
    emit(i32s(ar2));
    emit("\n");
  }
  ntest=ntest+1;
  let res5:[]u8=z_alloc(12);
  intent_winner(W3,"world",res5);
  if(get32(res5,0)==-2){
    emit("K-I2 T3 world WITHHOLD AMBIGUOUS gap=");
    emit(i32s(get32(res5,8)));
    emit(" PASS\n");
    npass=npass+1;
  } else {
    emit("K-I2 T3 FAIL kind=");
    emit(i32s(get32(res5,0)));
    emit(" (expected -2 ambiguous)\n");
  }
  let hq:i32=handle_proc_query_intent(W3,"world");
  ntest=ntest+1;
  if(hq==-1){
    emit("K-I2 T3b handler returns -1 AMBIGUOUS PASS\n");
    npass=npass+1;
  } else {
    emit("K-I2 T3b FAIL hq=");
    emit(i32s(hq));
    emit("\n");
  }

  // ---- T3c: no candidate withholds (boundary) ----
  emit("\n--- T3c: empty store ---\n");
  let W4:[]u8=z_alloc(65536);
  set32(W4, ST_STR(), STR0());
  intent_init(W4);
  ntest=ntest+1;
  let hq2:i32=handle_proc_query_intent(W4,"hello");
  if(hq2==0){
    emit("K-I2 T3c empty store WITHHOLD PASS\n");
    npass=npass+1;
  } else {
    emit("K-I2 T3c FAIL hq2=");
    emit(i32s(hq2));
    emit("\n");
  }

  emit("\n=== INTENT RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(ntest));
  emit(" ===\n");
  if(npass==ntest){
    emit("H-INTENT SURVIVES\n");
    return 0;
  }
  emit("H-INTENT KILLED\n");
  return 1;
}

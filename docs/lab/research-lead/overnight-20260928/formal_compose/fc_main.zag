// fc_main.zag -- FORMAL-COMPOSE main battery driver.
// Frozen battery order (PREREG section 4):
// build, V1, V2, V3, V5, V4, B1, A1..A8, audit.
// Links against one arm file (fc_rep / fc_gate / fc_gateb /
// fc_list) which supplies the edge store.

fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let S:[]u8=z_alloc(65536);
  let A:[]u8=z_alloc(8192);
  world_build(S,A,0,0,0);
  let c:i32=get32(S,6000);
  let x:i32=get32(S,6004);
  let y:i32=get32(S,6008);
  let w:i32=get32(S,6012);
  let g:i32=get32(S,6016);
  let x2:i32=get32(S,6024);
  let y2:i32=get32(S,6028);
  // V1: diamond
  let v1:i32=demand(S,A,g);
  // V2: fan-in join over the two legs
  let j2:i32=nd_app2(S,A,3,w,y);
  let v2:i32=demand(S,A,j2);
  // V3: chain
  let t1:i32=nd_app1(S,A,0,c);
  let ch:i32=nd_app1(S,A,1,t1);
  let v3:i32=demand(S,A,ch);
  // V5: fresh rebuild on a new const
  let cB:i32=nd_new_const(S,202);
  let xB:i32=nd_app1(S,A,0,cB);
  let yB:i32=nd_app1(S,A,1,xB);
  let wB:i32=nd_app1(S,A,2,xB);
  let gB:i32=nd_app2(S,A,3,yB,wB);
  let v5:i32=demand(S,A,gB);
  // V4: L2 attach within contract (rank(x2) < rank(g))
  let v4l:i32=battery_link(S,g,x2);
  let v4p:i32=edge_present(S,g,x2);
  let v4d:i32=demand(S,A,g);
  // B1: boundary probe, cross-rank attach (acyclic, rank(x2) >= rank(x))
  let b1l:i32=battery_link(S,x,x2);
  let b1p:i32=edge_present(S,x,x2);
  // fresh-node fallback for the cross-rank case
  let f2:i32=nd_app2(S,A,3,g,y2);
  let f2v:i32=demand(S,A,f2);
  // A1..A7: adversarial cycle-closing attempts
  let ref:i32=0;
  if(battery_link(S,x,g)!=0){ ref=ref+1; }
  if(battery_link(S,c,c)!=0){ ref=ref+1; }
  if(battery_link(S,x,y)!=0){ ref=ref+1; }
  if(battery_link(S,c,g)!=0){ ref=ref+1; }
  if(battery_link(S,w,g)!=0){ ref=ref+1; }
  if(battery_link(S,y,g)!=0){ ref=ref+1; }
  if(battery_link(S,g,g)!=0){ ref=ref+1; }
  // A8: bypass probe, lowest-level writes with cycle-closing intent
  // (not run on GATE-inline per the frozen prereg)
  if(do_a8()==1){
    raw_link(S,x,g);
    raw_link(S,c,g);
  }
  let cyc:i32=audit_cycles(S);
  cur=e1str(OUT,cur,"FC-ARM ");
  cur=arm_name(OUT,cur);
  cur=e1str(OUT,cur,"FC-VALID v1=");
  cur=e1i64(OUT,cur,v1 as i64);
  cur=e1str(OUT,cur," v2=");
  cur=e1i64(OUT,cur,v2 as i64);
  cur=e1str(OUT,cur," v3=");
  cur=e1i64(OUT,cur,v3 as i64);
  cur=e1str(OUT,cur," v4link=");
  cur=e1i64(OUT,cur,v4l as i64);
  cur=e1str(OUT,cur," v4present=");
  cur=e1i64(OUT,cur,v4p as i64);
  cur=e1str(OUT,cur," v4dem=");
  cur=e1i64(OUT,cur,v4d as i64);
  cur=e1str(OUT,cur," v5=");
  cur=e1i64(OUT,cur,v5 as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"FC-ADV cycles=");
  cur=e1i64(OUT,cur,cyc as i64);
  cur=e1str(OUT,cur," refusals=");
  cur=e1i64(OUT,cur,ref as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"FC-BOUNDARY b1link=");
  cur=e1i64(OUT,cur,b1l as i64);
  cur=e1str(OUT,cur," b1present=");
  cur=e1i64(OUT,cur,b1p as i64);
  cur=e1str(OUT,cur," f2=");
  cur=e1i64(OUT,cur,f2v as i64);
  cur=e1nl(OUT,cur);
  cur=e1str(OUT,cur,"FC-END");
  cur=e1nl(OUT,cur);
  _zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  return 0;
}

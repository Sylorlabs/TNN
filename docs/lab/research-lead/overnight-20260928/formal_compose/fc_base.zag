// fc_base.zag -- FORMAL-COMPOSE shared substrate.
// Arenas, little-endian i32 access, output helpers, MAP table,
// facts, node table, demand evaluation, cycle audit, world builder.
// Pure Zag. Mirrors the COMPOSE-SUSPEND-1 substrate (sus_base.zag,
// sus_thunk.zag demand/onstack) with the edge store factored out to
// arm files (fc_rep/fc_gate/fc_gateb/fc_list.zag).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used.
//
// Arena A (world): MAP inventory + facts (sus_base layout).
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s, r, o)
//   772: MAP table, 16 maps * 8 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 inmask, 3 outmask,
//                4 inmask1, 5 inmask2, 6 arity, 7 nobs
//   1284: nmaps
// Classes: 0=WALK (fact lookup), 1=COUNT (fact count), 4=ADD2.
//
// Arena S (learner state):
//   0: nnodes
//   4: node table, 64 nodes * 8 fields * 4 bytes = 2048
//      fields: 0 rank, 1 map (-1=const), 2 cval,
//              3 in1, 4 in2, 5 memo, 6 onstack, 7 spare
//   6000: built node ids (world_build): 0:c 1:x 2:y 3:w 4:g
//         5:c2 6:x2 7:y2
//   8192: arm edge-store region (arm-defined layout)
// Sentinels: MISS=-2, NOVAL=-999999.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn e1nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
// ---- kind compatibility: mask==0 compatible with all ----
fn khas(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
// ---- arena A accessors ----
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,772+m*32+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,772+m*32+f*4,v); return; }
// ---- node table accessors ----
fn ndg(S:[]u8,t:i32,f:i32)i32 { return get32(S,4+t*32+f*4); }
fn ndp(S:[]u8,t:i32,f:i32,v:i32)void { set32(S,4+t*32+f*4,v); return; }
// ---- facts ----
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn fact1(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    let fs:i32=get32(A,4+i*12);
    let fr:i32=get32(A,4+i*12+4);
    if(fs==s && fr==rel){ return get32(A,4+i*12+8); }
    i=i+1;
  }
  return -2;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs:i32=get32(A,4+i*12);
    let fr:i32=get32(A,4+i*12+4);
    if(fs==s && fr==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// ---- MAP table ----
fn map_new(A:[]u8,m:i32,cl:i32,rel:i32,inm:i32,outm:i32,inm1:i32,inm2:i32,ar:i32)void {
  mp(A,m,0,cl); mp(A,m,1,rel); mp(A,m,2,inm); mp(A,m,3,outm);
  mp(A,m,4,inm1); mp(A,m,5,inm2); mp(A,m,6,ar); mp(A,m,7,0);
  let nm:i32=ag(A,1284);
  if(m>=nm){ ap(A,1284,m+1); }
  return;
}
// ---- MAP execution (no phase instrumentation in this lane) ----
fn exec_map(A:[]u8,m:i32,v1:i32)i32 {
  let cl:i32=mg(A,m,0);
  let rel:i32=mg(A,m,1);
  if(cl==0){ return fact1(A,v1,rel); }
  if(cl==1){ return count_rel(A,v1,rel); }
  return -2;
}
fn exec_map2(A:[]u8,m:i32,v1:i32,v2:i32)i32 {
  let cl:i32=mg(A,m,0);
  if(cl==4){
    if(v1==-2){ return -2; }
    if(v2==-2){ return -2; }
    return v1+v2;
  }
  return -2;
}
// ---- node creation (edge recording delegated to the arm) ----
fn nd_new_const(S:[]u8,v:i32)i32 {
  let n:i32=get32(S,0);
  if(n>=64){ return -2; }
  arm_nd_init(S,n);
  ndp(S,n,0,0); ndp(S,n,1,-1); ndp(S,n,2,v);
  ndp(S,n,3,-1); ndp(S,n,4,-1); ndp(S,n,5,-999999); ndp(S,n,6,0);
  set32(S,0,n+1);
  return n;
}
fn nd_app1(S:[]u8,A:[]u8,m:i32,a:i32)i32 {
  let n:i32=get32(S,0);
  if(n>=64){ return -2; }
  let rk:i32=ndg(S,a,0)+1;
  if(rk>=32){ return -2; }
  arm_nd_init(S,n);
  ndp(S,n,0,rk); ndp(S,n,1,m); ndp(S,n,2,0);
  ndp(S,n,3,a); ndp(S,n,4,-1); ndp(S,n,5,-999999); ndp(S,n,6,0);
  set32(S,0,n+1);
  store_app_edge(S,n,a);
  return n;
}
fn nd_app2(S:[]u8,A:[]u8,m:i32,a:i32,b:i32)i32 {
  let n:i32=get32(S,0);
  if(n>=64){ return -2; }
  let ra:i32=ndg(S,a,0);
  let rb:i32=ndg(S,b,0);
  let mx:i32=ra;
  if(rb>mx){ mx=rb; }
  let rk:i32=mx+1;
  if(rk>=32){ return -2; }
  arm_nd_init(S,n);
  ndp(S,n,0,rk); ndp(S,n,1,m); ndp(S,n,2,0);
  ndp(S,n,3,a); ndp(S,n,4,b); ndp(S,n,5,-999999); ndp(S,n,6,0);
  set32(S,0,n+1);
  store_app_edge(S,n,a);
  store_app_edge(S,n,b);
  return n;
}
// ---- demand over the arm read path ----
// Primary inputs (in1/in2) supply the MAP's values; linked
// read-deps are traversed (values discarded). On-stack guard
// fails cyclic candidates with -2 (SUSPEND's BOUND behavior).
fn demand(S:[]u8,A:[]u8,t:i32)i32 {
  let memo:i32=ndg(S,t,5);
  if(memo!=-999999){ return memo; }
  if(ndg(S,t,6)==1){ return -2; }
  ndp(S,t,6,1);
  let m:i32=ndg(S,t,1);
  let v:i32=-2;
  if(m==-1){
    v=ndg(S,t,2);
  } else {
    let ar:i32=mg(A,m,6);
    let i1:i32=ndg(S,t,3);
    let v1:i32=demand(S,A,i1);
    if(ar==1){
      v=exec_map(A,m,v1);
    } else {
      let i2:i32=ndg(S,t,4);
      let v2:i32=demand(S,A,i2);
      v=exec_map2(A,m,v1,v2);
    }
    let nl:i32=ndeps(S,t);
    let i:i32=0;
    while(i<nl){
      let d:i32=dep_at(S,t,i);
      if(d!=i1){
        // znc:allow A0102
        if(d!=ndg(S,t,4)){ let dd:i32=demand(S,A,d); }
      }
      i=i+1;
    }
  }
  ndp(S,t,5,v);
  ndp(S,t,6,0);
  return v;
}
// ---- cycle audit (measurement only; identical for all arms) ----
// Counts items lying on a directed cycle of the READ graph.
fn dfs_reach(S:[]u8,x:i32,tgt:i32,vis:[]u8)i32 {
  if(x==tgt){ return 1; }
  if((vis[x] as i32)==1){ return 0; }
  vis[x]=1 as u8;
  let n:i32=ndeps(S,x);
  let i:i32=0;
  while(i<n){
    if(dfs_reach(S,dep_at(S,x,i),tgt,vis)==1){ return 1; }
    i=i+1;
  }
  return 0;
}
fn audit_cycles(S:[]u8)i32 {
  let n:i32=get32(S,0);
  let c:i32=0;
  let u:i32=0;
  while(u<n){
    let vis:[]u8=z_alloc(64);
    let nd:i32=ndeps(S,u);
    let i:i32=0;
    let on:i32=0;
    while(i<nd){
      if(dfs_reach(S,dep_at(S,u,i),u,vis)==1){ on=1; }
      i=i+1;
    }
    if(on==1){ c=c+1; }
    u=u+1;
  }
  return c;
}
// ---- world builder (PAIR6 diamond substrate) ----
// vr: relation permutation; vn: subject-id permutation;
// vk: kind polarity swap. Built item ids stored at S+6000.
fn world_build(S:[]u8,A:[]u8,vr:i32,vn:i32,vk:i32)void {
  let r91:i32=91; let r92:i32=92; let r94:i32=94;
  if(vr==1){ r91=94; r92=91; r94=92; }
  let n202:i32=202; let n211:i32=211; let n204:i32=204; let n212:i32=212;
  if(vn==1){ n202=707; n211=708; n204=709; n212=710; }
  let k1:i32=1; let k2:i32=2;
  if(vk==1){ k1=2; k2=1; }
  map_new(A,0,0,r91,k1,k1,0,0,1);
  map_new(A,1,1,r92,k1,k2,0,0,1);
  map_new(A,2,1,r94,k1,k2,0,0,1);
  map_new(A,3,4,0,0,k2,k2,k2,2);
  fact_add(A,n202,r91,n211);
  fact_add(A,n211,r92,901); fact_add(A,n211,r92,902); fact_add(A,n211,r92,903);
  fact_add(A,n211,r94,911); fact_add(A,n211,r94,912);
  fact_add(A,n204,r91,n212);
  fact_add(A,n212,r92,904); fact_add(A,n212,r92,905);
  fact_add(A,n212,r94,913);
  let c:i32=nd_new_const(S,n202);
  let x:i32=nd_app1(S,A,0,c);
  let y:i32=nd_app1(S,A,1,x);
  let w:i32=nd_app1(S,A,2,x);
  let g:i32=nd_app2(S,A,3,y,w);
  let c2:i32=nd_new_const(S,n204);
  let x2:i32=nd_app1(S,A,0,c2);
  let y2:i32=nd_app1(S,A,1,x2);
  set32(S,6000,c); set32(S,6004,x); set32(S,6008,y); set32(S,6012,w);
  set32(S,6016,g); set32(S,6020,c2); set32(S,6024,x2); set32(S,6028,y2);
  return;
}

// fc_rep.zag -- ARM-REP: representational ACYCLIC edge store.
//
// Rank-slot store. Every item has a fixed rank (0 for leaves,
// 1 + max dep rank for composites). Per item, 32 rank-heads; head
// r holds a linked list of edge records whose child has rank r.
// compose_link(P, C) prepends C to head rank(C) of P,
// unconditionally: there is no branch on cyclicity anywhere in
// this file (no reachability, no visited sets, no graph search).
//
// Read path: heads 0 .. rank(P)-1 only. A write to head rank(C)
// with rank(C) >= rank(P) lands outside P's interpreted prefix:
// the record exists but is unreachable from every read path, so
// it denotes no dependency. Every edge the read path can return
// therefore goes from higher rank to strictly lower rank, and the
// read graph is acyclic for ANY sequence of store operations,
// including raw writes. Cycle-closing attempts are not refused;
// they are inexpressible.
//
// Vocabulary in this file is structural only (item, rank, head,
// link, edge, store, slot): no domain terms appear, by the K4
// no-wire audit.
//
// Layout in S: heads at 8192 (64 items * 32 ranks * 4);
// edge pool at 16384 (512 records * 8: child, next);
// pool cursor at 20484.

fn head_at(S:[]u8,p:i32,r:i32)i32 { return get32(S,8192+(p*32+r)*4); }
fn head_set(S:[]u8,p:i32,r:i32,v:i32)void { set32(S,8192+(p*32+r)*4,v); return; }
fn arm_nd_init(S:[]u8,n:i32)void {
  let r:i32=0;
  while(r<32){ head_set(S,n,r,-1); r=r+1; }
  return;
}
fn edge_new(S:[]u8,ch:i32,nx:i32)i32 {
  let n:i32=get32(S,20484);
  if(n>=512){ return -1; }
  set32(S,16384+n*8,ch);
  set32(S,16384+n*8+4,nx);
  set32(S,20484,n+1);
  return n;
}
fn link_head(S:[]u8,p:i32,c:i32)void {
  let rc:i32=ndg(S,c,0);
  let e:i32=edge_new(S,c,head_at(S,p,rc));
  if(e>=0){ head_set(S,p,rc,e); }
  return;
}
fn store_app_edge(S:[]u8,p:i32,c:i32)void { link_head(S,p,c); return; }
// compose_link: total. No cyclicity branch exists.
fn compose_link(S:[]u8,p:i32,c:i32)i32 {
  link_head(S,p,c);
  return 0;
}
// raw_link: lowest-level write; on REP there is no gate to bypass,
// so this is the same slot write.
fn raw_link(S:[]u8,p:i32,c:i32)void { link_head(S,p,c); return; }
fn battery_link(S:[]u8,p:i32,c:i32)i32 {
  link_head(S,p,c);
  return 0;
}
// do_a8: the A8 bypass probe runs on REP (raw slot writes must stay
// inexpressible).
fn do_a8()i32 { return 1; }
// ---- read path: interpreted prefix only ----
fn ndeps(S:[]u8,p:i32)i32 {
  let rp:i32=ndg(S,p,0);
  let n:i32=0;
  let r:i32=0;
  while(r<rp){
    let e:i32=head_at(S,p,r);
    while(e>=0){ n=n+1; e=get32(S,16384+e*8+4); }
    r=r+1;
  }
  return n;
}
fn dep_at(S:[]u8,p:i32,i:i32)i32 {
  let rp:i32=ndg(S,p,0);
  let n:i32=0;
  let r:i32=0;
  while(r<rp){
    let e:i32=head_at(S,p,r);
    while(e>=0){
      if(n==i){ return get32(S,16384+e*8); }
      n=n+1;
      e=get32(S,16384+e*8+4);
    }
    r=r+1;
  }
  return -1;
}
fn edge_present(S:[]u8,p:i32,c:i32)i32 {
  let rp:i32=ndg(S,p,0);
  let r:i32=0;
  while(r<rp){
    let e:i32=head_at(S,p,r);
    while(e>=0){
      if(get32(S,16384+e*8)==c){ return 1; }
      e=get32(S,16384+e*8+4);
    }
    r=r+1;
  }
  return 0;
}
fn arm_name(b:[]u8,c:i32)i32 {
  b[c]=82; b[c+1]=69; b[c+2]=80; b[c+3]=10;
  return c+4;
}

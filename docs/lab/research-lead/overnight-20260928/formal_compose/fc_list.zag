// fc_list.zag -- ARM-LIST: unconstrained control.
// Flat (parent, child) edge list with NO gate: compose_link
// records unconditionally. The adversarial battery MUST commit
// cycles here (> 0); if it does not, the battery was not
// adversarial and K1 is VOID.
//
// Flat (parent, child) edge list; the read path is all recorded
// edges. compose_link records with no check. raw_link is the
// same record operation.
//
// Vocabulary in this file is structural only, by the K4 no-wire
// audit.
//
// Layout in S: edge list at 8192 (512 records * 8: parent, child);
// list cursor at 12292.

fn arm_nd_init(S:[]u8,n:i32)void { return; }
fn edge_append(S:[]u8,p:i32,c:i32)void {
  let n:i32=get32(S,12292);
  if(n<512){
    set32(S,8192+n*8,p);
    set32(S,8192+n*8+4,c);
    set32(S,12292,n+1);
  }
  return;
}
fn store_app_edge(S:[]u8,p:i32,c:i32)void { edge_append(S,p,c); return; }
// compose_link: unconstrained. Always records.
fn compose_link(S:[]u8,p:i32,c:i32)i32 {
  edge_append(S,p,c);
  return 0;
}
// raw_link: bypasses the gate.
fn raw_link(S:[]u8,p:i32,c:i32)void { edge_append(S,p,c); return; }
fn battery_link(S:[]u8,p:i32,c:i32)i32 { return compose_link(S,p,c); }
// do_a8: A8 runs on LIST (unconstrained appends).
fn do_a8()i32 { return 1; }
// ---- read path: all recorded edges ----
fn ndeps(S:[]u8,p:i32)i32 {
  let n:i32=get32(S,12292);
  let k:i32=0;
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){ k=k+1; }
    i=i+1;
  }
  return k;
}
fn dep_at(S:[]u8,p:i32,j:i32)i32 {
  let n:i32=get32(S,12292);
  let k:i32=0;
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){
      if(k==j){ return get32(S,8192+i*8+4); }
      k=k+1;
    }
    i=i+1;
  }
  return -1;
}
fn edge_present(S:[]u8,p:i32,c:i32)i32 {
  let n:i32=get32(S,12292);
  let i:i32=0;
  while(i<n){
    if(get32(S,8192+i*8)==p){
      if(get32(S,8192+i*8+4)==c){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn arm_name(b:[]u8,c:i32)i32 {
  b[c]=76; b[c+1]=73; b[c+2]=83; b[c+3]=84; b[c+4]=10;
  return c+5;
}

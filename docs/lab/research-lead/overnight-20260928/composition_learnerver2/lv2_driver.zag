// ---- T-HOOK: CONSTRUCT-goal entry point composes through the query API ----
fn thook_test()i32 {
  emit("=== THOOK ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lv2_evidence(W,101,70,107,5);
  let m0:i32=cmp_count_maps(W); let e0:i32=cmp_count15(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=ev_cquery(W,101,70,0,st);
  emit("THOOK-ANS="); e64(z); emit("\n");
  emit("THOOK tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W); let e1:i32=cmp_count15(W);
  let zm:i32=cb_newest_map(W);
  let l14:i32=-1;
  if(zm>=0){ l14=lvc_count14out(W,zm); }
  emit("THOOK maps "); e64(m0); emit("->"); e64(m1);
  emit(" couse15 "); e64(e0); emit("->"); e64(e1);
  emit(" link14="); e64(l14); emit("\n");
  if(z==107 && get32(st,0)>=1 && m1==m0+1 && l14==3){
    emit("THOOK-RESULT=PASS\n"); return 1;
  }
  emit("THOOK-RESULT=FAIL\n"); return 0;
}

// ---- T-HOOK-NE: CONSTRUCT goal with no evidence -> honest withhold ----
fn thookne_test()i32 {
  emit("=== THOOKNE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=ev_cquery(W,101,70,0,st);
  emit("THOOKNE-ANS="); e64(z); emit("\n");
  emit("THOOKNE tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W);
  emit("THOOKNE maps "); e64(m0); emit("->"); e64(m1); emit("\n");
  if(z==-3 && get32(st,0)==0 && m1==m0){
    emit("THOOKNE-RESULT=PASS\n"); return 1;
  }
  emit("THOOKNE-RESULT=FAIL\n"); return 0;
}

fn main()i32 {
  emit("CMP-LV2-START\n");
  let r1:i32=t2alv_test();
  let r2:i32=t2blv_test();
  let r3:i32=t3lv_test();
  let r4:i32=t4lv_test();
  let r5:i32=tthrlo_test();
  let r6:i32=tthrhi_test();
  let r7:i32=thook_test();
  let r8:i32=thookne_test();
  emit("CMP-LV2-SUMMARY ");
  e64(r1); emit(" "); e64(r2); emit(" "); e64(r3); emit(" "); e64(r4);
  emit(" "); e64(r5); emit(" "); e64(r6); emit(" "); e64(r7); emit(" "); e64(r8);
  emit("\n");
  emit("CMP-LV2-END\n");
  return 0;
}

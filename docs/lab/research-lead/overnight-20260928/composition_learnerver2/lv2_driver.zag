// ---- learner evidence helper (parametrized cycles) ----
// N predict/observe cycles for (s,r) with true world outcome o.
// After N cycles the evidence FACT pred_score = N-1.
fn lv2_evidence(W:[]u8,s:i32,r:i32,o:i32,cycles:i32)void {
  let c:i32=0;
  while(c<cycles){
    let p:i32=lv_predict(W,s,r);
    emit("LV2-EV c="); e64(c); emit(" pred="); e64(p); emit("\n");
    let ob:i32=lv_observe(W,s,r,o);
    c=c+1;
  }
  emit("LV2-EV factscore="); e64(lvc_factscore(W,s,r)); emit("\n");
  return;
}

// ---- T2A-LV: 4-structure learner-verified composition ----
fn t2alv_test()i32 {
  emit("=== T2ALV ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t2a_world(W);
  lv2_evidence(W,101,70,109,5);
  let m0:i32=cmp_count_maps(W); let e0:i32=cmp_count15(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("T2ALV-ANS="); e64(z); emit("\n");
  emit("T2ALV tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W); let e1:i32=cmp_count15(W);
  let zm:i32=cb_newest_map(W);
  let l14:i32=-1;
  if(zm>=0){ l14=lvc_count14out(W,zm); }
  emit("T2ALV maps "); e64(m0); emit("->"); e64(m1);
  emit(" couse15 "); e64(e0); emit("->"); e64(e1);
  emit(" link14="); e64(l14); emit("\n");
  if(z==109 && m1==m0+1 && l14==4 && e1>=e0+3 && get32(st,0)>=1){
    emit("T2ALV-RESULT=PASS\n"); return 1;
  }
  emit("T2ALV-RESULT=FAIL\n"); return 0;
}


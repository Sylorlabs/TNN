// ---- T3-LV: cross-domain learner-verified composition ----
fn t3lv_test()i32 {
  emit("=== T3LV ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t3_world(W);
  lv2_evidence(W,101,70,105,5);
  let m0:i32=cmp_count_maps(W); let e0:i32=cmp_count15(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("T3LV-ANS="); e64(z); emit("\n");
  emit("T3LV tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W); let e1:i32=cmp_count15(W);
  let zm:i32=cb_newest_map(W);
  let l14:i32=-1;
  if(zm>=0){ l14=lvc_count14out(W,zm); }
  emit("T3LV maps "); e64(m0); emit("->"); e64(m1);
  emit(" couse15 "); e64(e0); emit("->"); e64(e1);
  emit(" link14="); e64(l14); emit("\n");
  if(z==105 && m1==m0+1 && l14==2 && e1>=e0+1 && get32(st,0)>=1){
    emit("T3LV-RESULT=PASS\n"); return 1;
  }
  emit("T3LV-RESULT=FAIL\n"); return 0;
}

// ---- T4-LV: partial applicability, evidence present, structure unsupported ----
// Expect honest -2: same DFS search space as unified compose_try, which
// cannot reach 106 (atomic MAP assumption). No false positive allowed.
fn t4lv_test()i32 {
  emit("=== T4LV ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t4_world(W);
  lv2_evidence(W,101,70,106,5);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("T4LV-ANS="); e64(z); emit("\n");
  emit("T4LV tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W);
  emit("T4LV maps "); e64(m0); emit("->"); e64(m1); emit("\n");
  if(z==-2 && m1==m0 && get32(st,0)==0){
    emit("T4LV-RESULT=PASS\n"); return 1;
  }
  emit("T4LV-RESULT=FAIL\n"); return 0;
}

// ---- T-THR-LO: sub-threshold evidence -> honest withhold ----
fn tthrlo_test()i32 {
  emit("=== TTHRLO ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  t1_world(W);
  lv2_evidence(W,101,70,107,3);
  let m0:i32=cmp_count_maps(W);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let z:i32=compose_lv(W,101,70,0,st);
  emit("TTHRLO-ANS="); e64(z); emit("\n");
  emit("TTHRLO tried="); e64(get32(st,0)); emit(" rejected="); e64(get32(st,4)); emit("\n");
  let m1:i32=cmp_count_maps(W);
  emit("TTHRLO maps "); e64(m0); emit("->"); e64(m1); emit("\n");
  if(z==-3 && get32(st,0)==0 && m1==m0){
    emit("TTHRLO-RESULT=PASS\n"); return 1;
  }
  emit("TTHRLO-RESULT=FAIL\n"); return 0;
}


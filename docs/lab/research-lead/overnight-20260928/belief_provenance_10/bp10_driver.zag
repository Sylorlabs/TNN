// bp10_driver.zag -- BP-10 battery driver.
//
// Arms: CON (contradiction events: genuine vs forged),
// REC (recovery: genuine vs forged), REV (revision
// operation vs retire+create), AMB (revision-history
// erasure). Kill bars from the frozen PREREG.md.
// Verdict BP-10-PASS/FAIL. Pure Zag.
// bp10_learner.zag is BP-9's belief layer reused
// verbatim. Zero new learner machinery this lane:
// bp10_absorb (the BP-9 absorb renamed, identical body),
// bp10_ck, bp10_bar, bp10_selfcnt are driver-side
// test-harness code, NOT belief-layer changes. The
// forgery actions (link_edge writes of type-7/type-3
// edges) are adversary actions in the driver, NOT
// belief-layer changes. Direct driver calls to frozen
// learner functions (bp2_disconfirm, bp2_confirm,
// bp2_revise, bp2_retire, bp2_form) are disclosed test
// actions invoking frozen operators; they add no rules.
// R2/R3/R5/R6/R7, eff(), bp2_retire, bp2_relicense stay
// frozen.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp10_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp10_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp10_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp10_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption: identical body to
// bp9_absorb. Count NEW type-7/type-3 self-edges on
// fact fid since watermarks (p7,p3); each new type-7
// applies R2, each new type-3 applies R3, to belief
// mid. out[0]=new7, out[4]=new3.
fn bp10_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp10_selfcnt(W,fid,7)-p7;
  let n3:i32=bp10_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

fn main()i32 {
  emit("BP10-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= CON: contradiction events =================
  emit("CON-BEGIN\n");
  let WA:[]u8=z_alloc(110656);
  tnn2_init(WA);
  let fA1:i32=ev_teach(WA,901,91,10); ns(WA,fA1,16,2);
  let pfA1:[]u8=z_alloc(4); set32(pfA1,0,fA1);
  let mA1:i32=promote_graph(WA,-1,901,91,10,pfA1,1);
  let fA2:i32=ev_teach(WA,902,92,20); ns(WA,fA2,16,2);
  let pfA2:[]u8=z_alloc(4); set32(pfA2,0,fA2);
  let mA2:i32=promote_graph(WA,-1,902,92,20,pfA2,1);
  let fA3:i32=ev_teach(WA,903,93,30); ns(WA,fA3,16,2);
  let pfA3:[]u8=z_alloc(4); set32(pfA3,0,fA3);
  let mA3:i32=promote_graph(WA,-1,903,93,30,pfA3,1);
  let fA4:i32=ev_teach(WA,904,94,40); ns(WA,fA4,16,2);
  let pfA4:[]u8=z_alloc(4); set32(pfA4,0,fA4);
  let mA4:i32=promote_graph(WA,-1,904,94,40,pfA4,1);
  let btA:[]u8=z_alloc(8192); let hbA:[]u8=z_alloc(1024);
  bp2_form(WA,btA,hbA,mA1,0);
  bp2_form(WA,btA,hbA,mA2,0);
  bp2_form(WA,btA,hbA,mA3,0);
  bp2_form(WA,btA,hbA,mA4,0);
  emit("CON mA1 "); e64(mA1); emit(" mA2 "); e64(mA2);
  emit(" mA3 "); e64(mA3); emit(" mA4 "); e64(mA4); emit("\n");
  bp10_bar(t,"PC-CON-FORM",
    (btA[mA1*8] as i32)==100 && (btA[mA1*8+1] as i32)==1 &&
    (btA[mA1*8+2] as i32)==0 && (btA[mA1*8+3] as i32)==0 &&
    (btA[mA1*8+4] as i32)==1 && (btA[mA1*8+7] as i32)==1 &&
    (btA[mA2*8] as i32)==100 && (btA[mA2*8+1] as i32)==1 &&
    (btA[mA2*8+4] as i32)==1 && (btA[mA2*8+7] as i32)==1 &&
    (btA[mA3*8] as i32)==100 && (btA[mA3*8+1] as i32)==1 &&
    (btA[mA3*8+4] as i32)==1 && (btA[mA3*8+7] as i32)==1 &&
    (btA[mA4*8] as i32)==100 && (btA[mA4*8+1] as i32)==1 &&
    (btA[mA4*8+4] as i32)==1 && (btA[mA4*8+7] as i32)==1 &&
    (hbA[mA1] as i32)==1 && (hbA[mA4] as i32)==1);
  // E1: genuine contradict on mA1's fact
  let rc1:i32=ev_observe(WA,901,91,999);
  let ab1:[]u8=z_alloc(8);
  bp10_absorb(WA,btA,mA1,fA1,0,0,ab1);
  emit("CON-E1 rc "); e64(rc1);
  emit(" n3 "); e64(get32(ab1,4));
  emit(" sup "); e64(btA[mA1*8] as i32);
  emit(" disc "); e64(btA[mA1*8+2] as i32);
  emit(" conf "); e64(btA[mA1*8+1] as i32); emit("\n");
  bp10_bar(t,"K-CON-GENUINE",get32(ab1,4)==1 &&
    (btA[mA1*8] as i32)==80 && (btA[mA1*8+2] as i32)==1 &&
    (btA[mA1*8+1] as i32)==0);
  // E2: forged type-3 on mA2's fact
  let wA2:i32=link_edge(WA,fA2,3,fA2,0);
  let ab2:[]u8=z_alloc(8);
  bp10_absorb(WA,btA,mA2,fA2,0,0,ab2);
  emit("CON-E2 n3 "); e64(get32(ab2,4));
  emit(" sup "); e64(btA[mA2*8] as i32);
  emit(" disc "); e64(btA[mA2*8+2] as i32);
  emit(" conf "); e64(btA[mA2*8+1] as i32); emit("\n");
  bp10_bar(t,"K-CON-FORGEIDENT",get32(ab2,4)==1 &&
    (btA[mA2*8] as i32)==80 && (btA[mA2*8+2] as i32)==1 &&
    (btA[mA2*8+1] as i32)==0 &&
    (btA[mA2*8] as i32)==(btA[mA1*8] as i32) &&
    (btA[mA2*8+1] as i32)==(btA[mA1*8+1] as i32) &&
    (btA[mA2*8+2] as i32)==(btA[mA1*8+2] as i32) &&
    (btA[mA2*8+3] as i32)==(btA[mA1*8+3] as i32));
  // E3: five forged contradicts on mA3 (contradiction to zero)
  let i3:i32=0;
  while(i3<5){
    let w3:i32=link_edge(WA,fA3,3,fA3,0);
    let ab3:[]u8=z_alloc(8);
    bp10_absorb(WA,btA,mA3,fA3,0,i3,ab3);
    i3=i3+1;
  }
  emit("CON-E3 sup "); e64(btA[mA3*8] as i32);
  emit(" disc "); e64(btA[mA3*8+2] as i32);
  emit(" conf "); e64(btA[mA3*8+1] as i32);
  emit(" hasb "); e64(hbA[mA3] as i32);
  emit(" k3 "); e64(bp2_has_k3(WA,mA3)); emit("\n");
  bp10_bar(t,"K-CON-NORETIRE",(btA[mA3*8] as i32)==0 &&
    (btA[mA3*8+2] as i32)==5 && (btA[mA3*8+1] as i32)==0 &&
    (hbA[mA3] as i32)==1 && bp2_has_k3(WA,mA3)==0);
  // E4: three forged type-3s, one absorb (contradict saturation)
  let w4a:i32=link_edge(WA,fA4,3,fA4,0);
  let w4b:i32=link_edge(WA,fA4,3,fA4,0);
  let w4c:i32=link_edge(WA,fA4,3,fA4,0);
  let ab4:[]u8=z_alloc(8);
  bp10_absorb(WA,btA,mA4,fA4,0,0,ab4);
  emit("CON-E4 n3 "); e64(get32(ab4,4));
  emit(" sup "); e64(btA[mA4*8] as i32);
  emit(" disc "); e64(btA[mA4*8+2] as i32);
  emit(" conf "); e64(btA[mA4*8+1] as i32); emit("\n");
  bp10_bar(t,"K-CON-SAT",get32(ab4,4)==3 &&
    (btA[mA4*8] as i32)==80 && (btA[mA4*8+2] as i32)==1 &&
    (btA[mA4*8+1] as i32)==0);
  emit("CON-END\n");

  // ================= REC: recovery, genuine vs forged =================
  emit("REC-BEGIN\n");
  let WB:[]u8=z_alloc(110656);
  tnn2_init(WB);
  let fB1:i32=ev_teach(WB,911,91,10); ns(WB,fB1,16,2);
  let pfB1:[]u8=z_alloc(4); set32(pfB1,0,fB1);
  let mB1:i32=promote_graph(WB,-1,911,91,10,pfB1,1);
  let fB2:i32=ev_teach(WB,912,92,20); ns(WB,fB2,16,2);
  let pfB2:[]u8=z_alloc(4); set32(pfB2,0,fB2);
  let mB2:i32=promote_graph(WB,-1,912,92,20,pfB2,1);
  let fB3a:i32=ev_teach(WB,913,93,30); ns(WB,fB3a,16,2);
  let fB3b:i32=ev_teach(WB,914,94,40); ns(WB,fB3b,16,2);
  let pfB3:[]u8=z_alloc(8); set32(pfB3,0,fB3a); set32(pfB3,4,fB3b);
  let mB3:i32=promote_graph(WB,-1,913,93,30,pfB3,2);
  let fB4a:i32=ev_teach(WB,915,95,50); ns(WB,fB4a,16,2);
  let fB4b:i32=ev_teach(WB,916,96,60); ns(WB,fB4b,16,2);
  let pfB4:[]u8=z_alloc(8); set32(pfB4,0,fB4a); set32(pfB4,4,fB4b);
  let mB4:i32=promote_graph(WB,-1,915,95,50,pfB4,2);
  let fB5:i32=ev_teach(WB,917,97,70); ns(WB,fB5,16,2);
  let pfB5:[]u8=z_alloc(4); set32(pfB5,0,fB5);
  let mB5:i32=promote_graph(WB,-1,917,97,70,pfB5,1);
  let btB:[]u8=z_alloc(8192); let hbB:[]u8=z_alloc(1024);
  bp2_form(WB,btB,hbB,mB1,0);
  bp2_form(WB,btB,hbB,mB2,0);
  bp2_form(WB,btB,hbB,mB3,0);
  bp2_form(WB,btB,hbB,mB4,0);
  bp2_form(WB,btB,hbB,mB5,0);
  emit("REC mB1 "); e64(mB1); emit(" mB2 "); e64(mB2);
  emit(" mB3 "); e64(mB3); emit(" mB4 "); e64(mB4);
  emit(" mB5 "); e64(mB5); emit("\n");
  bp10_bar(t,"PC-REC-FORM",
    (btB[mB1*8] as i32)==100 && (btB[mB1*8+1] as i32)==1 &&
    (btB[mB1*8+4] as i32)==1 && (btB[mB1*8+7] as i32)==1 &&
    (btB[mB2*8] as i32)==100 && (btB[mB2*8+1] as i32)==1 &&
    (btB[mB2*8+4] as i32)==1 && (btB[mB2*8+7] as i32)==1 &&
    (btB[mB3*8] as i32)==100 && (btB[mB3*8+1] as i32)==1 &&
    (btB[mB3*8+4] as i32)==2 && (btB[mB3*8+7] as i32)==2 &&
    (btB[mB4*8] as i32)==100 && (btB[mB4*8+1] as i32)==1 &&
    (btB[mB4*8+4] as i32)==2 && (btB[mB4*8+7] as i32)==2 &&
    (btB[mB5*8] as i32)==100 && (btB[mB5*8+1] as i32)==1 &&
    (btB[mB5*8+4] as i32)==1 && (btB[mB5*8+7] as i32)==1 &&
    (hbB[mB1] as i32)==1 && (hbB[mB5] as i32)==1);
  // R1: genuine contradict, then genuine match attempt (blocked)
  let rr1:i32=ev_observe(WB,911,91,999);
  let abR1a:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB1,fB1,0,0,abR1a);
  let r1m:i32=ev_observe(WB,911,91,10);
  let abR1b:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB1,fB1,0,1,abR1b);
  emit("REC-R1 rmatch "); e64(r1m);
  emit(" n7 "); e64(get32(abR1b,0));
  emit(" n3 "); e64(get32(abR1b,4));
  emit(" sup "); e64(btB[mB1*8] as i32);
  emit(" disc "); e64(btB[mB1*8+2] as i32); emit("\n");
  bp10_bar(t,"K-REC-GENBLOCKED",get32(abR1b,0)==0 &&
    get32(abR1b,4)==0 && (btB[mB1*8] as i32)==80 &&
    (btB[mB1*8+2] as i32)==1 && (btB[mB1*8+1] as i32)==0);
  // R2: genuine contradict, then FORGED match on the burned fact
  let rr2:i32=ev_observe(WB,912,92,999);
  let abR2a:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB2,fB2,0,0,abR2a);
  let wR2:i32=link_edge(WB,fB2,7,fB2,0);
  let abR2b:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB2,fB2,0,1,abR2b);
  emit("REC-R2 n7 "); e64(get32(abR2b,0));
  emit(" sup "); e64(btB[mB2*8] as i32);
  emit(" conf "); e64(btB[mB2*8+1] as i32);
  emit(" disc "); e64(btB[mB2*8+2] as i32); emit("\n");
  bp10_bar(t,"K-REC-FORGED",get32(abR2b,0)==1 &&
    (btB[mB2*8] as i32)==90 && (btB[mB2*8+1] as i32)==1 &&
    (btB[mB2*8+2] as i32)==0);
  // R3: genuine contradict, genuine recovery on the fresh fact
  let rr3:i32=ev_observe(WB,913,93,999);
  let abR3a:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB3,fB3a,0,0,abR3a);
  let c3sup:i32=btB[mB3*8] as i32;
  let c3con:i32=btB[mB3*8+1] as i32;
  let c3dis:i32=btB[mB3*8+2] as i32;
  let rm3:i32=ev_observe(WB,914,94,40);
  let abR3b:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB3,fB3b,0,0,abR3b);
  emit("REC-R3 rmatch "); e64(rm3);
  emit(" n7 "); e64(get32(abR3b,0));
  emit(" sup "); e64(btB[mB3*8] as i32);
  emit(" conf "); e64(btB[mB3*8+1] as i32); emit("\n");
  // R4: forged contradict, genuine recovery on the fresh fact
  let wR4:i32=link_edge(WB,fB4a,3,fB4a,0);
  let abR4a:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB4,fB4a,0,0,abR4a);
  let c4sup:i32=btB[mB4*8] as i32;
  let c4con:i32=btB[mB4*8+1] as i32;
  let c4dis:i32=btB[mB4*8+2] as i32;
  let rm4:i32=ev_observe(WB,916,96,60);
  let abR4b:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB4,fB4b,0,0,abR4b);
  emit("REC-R4 rmatch "); e64(rm4);
  emit(" n7 "); e64(get32(abR4b,0));
  emit(" sup "); e64(btB[mB4*8] as i32);
  emit(" conf "); e64(btB[mB4*8+1] as i32); emit("\n");
  bp10_bar(t,"K-REC-IDENT-C",c3sup==80 && c4sup==80 &&
    c3dis==1 && c4dis==1 && c3con==0 && c4con==0);
  bp10_bar(t,"K-REC-IDENT-R",
    (btB[mB3*8] as i32)==90 && (btB[mB4*8] as i32)==90 &&
    (btB[mB3*8+1] as i32)==1 && (btB[mB4*8+1] as i32)==1 &&
    (btB[mB3*8+2] as i32)==0 && (btB[mB4*8+2] as i32)==0);
  // R5: forged contradicts burn the bid; genuine match routed away
  let wR5a:i32=link_edge(WB,fB5,3,fB5,0);
  let wR5b:i32=link_edge(WB,fB5,3,fB5,0);
  let abR5a:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB5,fB5,0,0,abR5a);
  let r5m:i32=ev_observe(WB,917,97,70);
  let abR5b:[]u8=z_alloc(8);
  bp10_absorb(WB,btB,mB5,fB5,0,2,abR5b);
  emit("REC-R5 rmatch "); e64(r5m);
  emit(" n7 "); e64(get32(abR5b,0));
  emit(" n3 "); e64(get32(abR5b,4));
  emit(" sup "); e64(btB[mB5*8] as i32);
  emit(" disc "); e64(btB[mB5*8+2] as i32); emit("\n");
  bp10_bar(t,"K-REC-FORGEBURN",r5m==1 &&
    get32(abR5b,0)==0 && get32(abR5b,4)==0 &&
    (btB[mB5*8] as i32)==80 && (btB[mB5*8+2] as i32)==1);
  emit("REC-END\n");

  // ================= REV: revision op vs retire+create =================
  emit("REV-BEGIN\n");
  let WC:[]u8=z_alloc(110656);
  tnn2_init(WC);
  let fC1:i32=ev_teach(WC,921,91,10); ns(WC,fC1,16,2);
  let pfC1:[]u8=z_alloc(4); set32(pfC1,0,fC1);
  let mC1:i32=promote_graph(WC,-1,921,91,10,pfC1,1);
  let fC2:i32=ev_teach(WC,922,92,20); ns(WC,fC2,16,2);
  let pfC2:[]u8=z_alloc(4); set32(pfC2,0,fC2);
  let mC2:i32=promote_graph(WC,-1,922,92,20,pfC2,1);
  let fC3:i32=ev_teach(WC,923,93,30); ns(WC,fC3,16,2);
  let pfC3:[]u8=z_alloc(4); set32(pfC3,0,fC3);
  let mC3:i32=promote_graph(WC,-1,923,93,30,pfC3,1);
  let fC4a:i32=ev_teach(WC,924,94,40); ns(WC,fC4a,16,2);
  let fC4b:i32=ev_teach(WC,925,95,50); ns(WC,fC4b,16,2);
  let pfC4:[]u8=z_alloc(8); set32(pfC4,0,fC4a); set32(pfC4,4,fC4b);
  let mC4:i32=promote_graph(WC,-1,924,94,40,pfC4,2);
  let btC:[]u8=z_alloc(8192); let hbC:[]u8=z_alloc(1024);
  bp2_form(WC,btC,hbC,mC1,0);
  bp2_form(WC,btC,hbC,mC2,0);
  bp2_form(WC,btC,hbC,mC3,0);
  bp2_form(WC,btC,hbC,mC4,0);
  emit("REV mC1 "); e64(mC1); emit(" mC2 "); e64(mC2);
  emit(" mC3 "); e64(mC3); emit(" mC4 "); e64(mC4); emit("\n");
  bp10_bar(t,"PC-REV-FORM",
    (btC[mC1*8] as i32)==100 && (btC[mC1*8+1] as i32)==1 &&
    (btC[mC1*8+4] as i32)==1 && (btC[mC1*8+7] as i32)==1 &&
    (btC[mC2*8] as i32)==100 && (btC[mC2*8+1] as i32)==1 &&
    (btC[mC2*8+4] as i32)==1 && (btC[mC2*8+7] as i32)==1 &&
    (btC[mC3*8] as i32)==100 && (btC[mC3*8+1] as i32)==1 &&
    (btC[mC3*8+4] as i32)==1 && (btC[mC3*8+7] as i32)==1 &&
    (btC[mC4*8] as i32)==100 && (btC[mC4*8+1] as i32)==1 &&
    (btC[mC4*8+4] as i32)==2 && (btC[mC4*8+7] as i32)==2 &&
    (hbC[mC1] as i32)==1 && (hbC[mC4] as i32)==1);
  // V1: contradict, then the frozen R5 operator (driver-invoked)
  let rv1:i32=ev_observe(WC,921,91,999);
  let abV1:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC1,fC1,0,0,abV1);
  bp2_revise(btC,mC1);
  emit("REV-V1 sup "); e64(btC[mC1*8] as i32);
  emit(" rev "); e64(btC[mC1*8+3] as i32);
  emit(" conf "); e64(btC[mC1*8+1] as i32);
  emit(" disc "); e64(btC[mC1*8+2] as i32);
  emit(" k3 "); e64(bp2_has_k3(WC,mC1)); emit("\n");
  bp10_bar(t,"K-REV-OP",(btC[mC1*8] as i32)==40 &&
    (btC[mC1*8+3] as i32)==1 && (btC[mC1*8+1] as i32)==0 &&
    (btC[mC1*8+2] as i32)==0 && bp2_has_k3(WC,mC1)==0 &&
    (hbC[mC1] as i32)==1);
  // V2: contradict, retire, reform
  let rv2:i32=ev_observe(WC,922,92,999);
  let abV2:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC2,fC2,0,0,abV2);
  bp2_retire(WC,btC,mC2,2);
  bp2_form(WC,btC,hbC,mC2,0);
  emit("REV-V2 sup "); e64(btC[mC2*8] as i32);
  emit(" conf "); e64(btC[mC2*8+1] as i32);
  emit(" rev "); e64(btC[mC2*8+3] as i32);
  emit(" k3r2 "); e64(bp2_has_k3r(WC,mC2,2)); emit("\n");
  bp10_bar(t,"K-RETREFORM",(btC[mC2*8] as i32)==100 &&
    (btC[mC2*8+1] as i32)==1 && (btC[mC2*8+2] as i32)==0 &&
    (btC[mC2*8+3] as i32)==0 && bp2_has_k3r(WC,mC2,2)==1);
  bp10_bar(t,"K-REV-DISTINCT",(btC[mC1*8] as i32)==40 &&
    (btC[mC1*8+3] as i32)==1 && bp2_has_k3(WC,mC1)==0 &&
    (btC[mC2*8] as i32)==100 && (btC[mC2*8+3] as i32)==0 &&
    bp2_has_k3r(WC,mC2,2)==1);
  // V3: full evidence cycle with no revise call (R5 unreachable)
  let rv3m:i32=ev_observe(WC,923,93,30);
  let abV3a:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC3,fC3,0,0,abV3a);
  let rv3c:i32=ev_observe(WC,923,93,999);
  let abV3b:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC3,fC3,1,0,abV3b);
  bp2_retire(WC,btC,mC3,2);
  bp2_form(WC,btC,hbC,mC3,0);
  emit("REV-V3 rev "); e64(btC[mC3*8+3] as i32);
  emit(" sup "); e64(btC[mC3*8] as i32); emit("\n");
  bp10_bar(t,"K-REV-UNREACH",(btC[mC3*8+3] as i32)==0);
  // V4: retired belief keeps absorbing evidence
  let rv4:i32=ev_observe(WC,924,94,999);
  let abV4a:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC4,fC4a,0,0,abV4a);
  bp2_retire(WC,btC,mC4,2);
  let rv4m:i32=ev_observe(WC,925,95,50);
  let abV4b:[]u8=z_alloc(8);
  bp10_absorb(WC,btC,mC4,fC4b,0,0,abV4b);
  emit("REV-V4 sup "); e64(btC[mC4*8] as i32);
  emit(" conf "); e64(btC[mC4*8+1] as i32);
  emit(" disc "); e64(btC[mC4*8+2] as i32);
  emit(" k3r2 "); e64(bp2_has_k3r(WC,mC4,2)); emit("\n");
  bp10_bar(t,"K-RET-NOGATE",(btC[mC4*8] as i32)==10 &&
    (btC[mC4*8+1] as i32)==1 && (btC[mC4*8+2] as i32)==0 &&
    bp2_has_k3r(WC,mC4,2)==1);
  emit("REV-END\n");

  // ================= AMB: revision-history erasure =================
  emit("AMB-BEGIN\n");
  let WD:[]u8=z_alloc(110656);
  tnn2_init(WD);
  let btD:[]u8=z_alloc(8192); let hbD:[]u8=z_alloc(1024);
  let zD1:i32=alloc_node(WD);
  let zD2:i32=alloc_node(WD);
  bp2_form(WD,btD,hbD,zD1,1);
  bp2_form(WD,btD,hbD,zD2,1);
  emit("AMB zD1 "); e64(zD1); emit(" zD2 "); e64(zD2); emit("\n");
  bp10_bar(t,"PC-AMB-FORM",
    (btD[zD1*8] as i32)==100 && (btD[zD1*8+1] as i32)==1 &&
    (btD[zD2*8] as i32)==100 && (btD[zD2*8+1] as i32)==1 &&
    (hbD[zD1] as i32)==1 && (hbD[zD2] as i32)==1);
  // D1: R3,R2,R3,R2 (contradict first)
  bp2_disconfirm(btD,zD1);
  bp2_confirm(btD,zD1,0);
  bp2_disconfirm(btD,zD1);
  bp2_confirm(btD,zD1,0);
  // D2: R2,R3,R3,R2 (confirm first)
  bp2_confirm(btD,zD2,0);
  bp2_disconfirm(btD,zD2);
  bp2_disconfirm(btD,zD2);
  bp2_confirm(btD,zD2,0);
  emit("AMB-D1 sup "); e64(btD[zD1*8] as i32);
  emit(" conf "); e64(btD[zD1*8+1] as i32);
  emit(" disc "); e64(btD[zD1*8+2] as i32);
  emit(" rev "); e64(btD[zD1*8+3] as i32); emit("\n");
  emit("AMB-D2 sup "); e64(btD[zD2*8] as i32);
  emit(" conf "); e64(btD[zD2*8+1] as i32);
  emit(" disc "); e64(btD[zD2*8+2] as i32);
  emit(" rev "); e64(btD[zD2*8+3] as i32); emit("\n");
  bp10_bar(t,"K-REV-AMBIG",
    (btD[zD1*8] as i32)==80 && (btD[zD2*8] as i32)==80 &&
    (btD[zD1*8+1] as i32)==1 && (btD[zD2*8+1] as i32)==1 &&
    (btD[zD1*8+2] as i32)==0 && (btD[zD2*8+2] as i32)==0 &&
    (btD[zD1*8+3] as i32)==0 && (btD[zD2*8+3] as i32)==0);
  emit("AMB-END\n");

  emit("BP10-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP10-END\n");
  return 0;
}

// bsc.zag -- BELIEF-SUF-COMPRESSION toy model.
// Compares the two DECISION LOGICS at their documented granularity.
// Pure Zag. u8-backed cells. Single output buffer + cursor emit helpers;
// final write via _zag_raw_syscall (never _zag_print for dynamic content).
// Alloc pattern: _zag_malloc as *u8 then [0..n] (sound pattern).
// This is a decision-logic comparison, NOT an implementation of either
// mechanism. No mechanism source is read, linked, or modified.
//
// Belief side (from belief_provenance/DESIGN.md R1-R4, R7):
//   scalar b_sup; R1 formation (=100); R2 confirmation (+10, cap 255);
//   R3 disconfirmation (-20, floor 0); R4 proportional weakening on
//   licensing liveness (b_sup = b_sup * live / formed); R7 select iff
//   b_sup >= bar (all-EXTERNAL licensing, so eff = b_sup).
// SUF side (from l3_suf_intermediate/L3_SUF_DESIGN.md section 4):
//   per-element surviving-value bitmask over 3 values (mask 0b111);
//   falsification clears bits; state derived as surviving-set
//   cardinality: 1 survivor = RESOLVED, >1 = UNRESOLVED, 0 =
//   FALSIFIED-ALL; element-scale rule: predict only RESOLVED, else
//   ABSTAIN; form-scale FALSIFIED-ALL -> ESCALATE.
//
// Scenarios (frozen predictions in ../PREREG.md section 6):
//   S-A (T-A analogue, fabrication): unseen element, tie-break fills a
//       value, no disconfirming TEST, licensing intact.
//       Expect: belief SELECTs (b_sup high), SUF ABSTAINs (UNRESOLVED).
//   S-B (T-B analogue, provenance death): RESOLVED element, then all
//       licensing facts die, no TEST events.
//       Expect: belief REFUSES (R4 -> 0, R7 abstains), SUF keeps
//       PREDICTing (mask unchanged).
//   S-C (sanity): determined element, healthy licensing.
//       Expect: both predict (model not rigged to always diverge).
//   S-D (steelman line "FALSIFIED-ALL = b_sup 0"): both hit zero
//       support. Expect: belief RETIRES (terminal), SUF ESCALATEs
//       (expands hypothesis space): opposite action directions.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn write_ob(ob:[]u8, atp:[]u8)void {
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=get32(atp,0);
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return;
}

// ---- belief decision logic ----
fn b_r2(s:i32)i32 {
  let r:i32=s+10;
  if(r>255){r=255;}
  return r;
}
fn b_r3(s:i32)i32 {
  let r:i32=s-20;
  if(r<0){r=0;}
  return r;
}
fn b_r4(s:i32, live:i32, formed:i32)i32 {
  if(formed<1){return s;}
  return (s*live)/formed;
}
fn b_r7(s:i32, bar:i32)i32 {
  if(s>=bar){return 1;}
  return 0;
}

// ---- SUF decision logic ----
fn suf_falsify(mask:i32, v:i32)i32 {
  let bit:i32=1<<v;
  let has:i32=0;
  if((mask & bit)==bit){has=1;}
  if(has==1){return mask-bit;}
  return mask;
}
fn suf_popcount(mask:i32)i32 {
  let c:i32=0;
  let v:i32=0;
  while(v<3){
    let bit:i32=1<<v;
    if((mask & bit)==bit){c=c+1;}
    v=v+1;
  }
  return c;
}
// 2 = UNRESOLVED, 1 = RESOLVED, 0 = FALSIFIED-ALL
fn suf_state(mask:i32)i32 {
  let pc:i32=suf_popcount(mask);
  if(pc==0){return 0;}
  if(pc==1){return 1;}
  return 2;
}
fn suf_survivor(mask:i32)i32 {
  let v:i32=0;
  let out:i32=0;
  while(v<3){
    let bit:i32=1<<v;
    if((mask & bit)==bit){out=v;}
    v=v+1;
  }
  return out;
}

fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let atp:[]u8=z_alloc(4);
  set32(atp,0,0);
  e0(ob,atp,"BSC toy model: belief decision logic vs SUF decision logic");
  e0(ob,atp,"bar=50 R1=100 R2=+10 R3=-20 3 values per element");

  // S-A: fabrication (T-A analogue)
  let ba:i32=100;
  ba=b_r2(ba); ba=b_r2(ba); ba=b_r2(ba);
  let sel_a:i32=b_r7(ba,50);
  let ma:i32=7;
  let sta:i32=suf_state(ma);
  let act_a:i32=0;
  if(sta==1){act_a=1;}
  e1(ob,atp,"SA belief b_sup=",ba);
  e1(ob,atp,"SA belief R7 select1/abstain0=",sel_a);
  e1(ob,atp,"SA suf state 2=UNRESOLVED=",sta);
  e1(ob,atp,"SA suf predict1/abstain0=",act_a);
  let div_a:i32=0;
  if(sel_a==1){ if(act_a==0){div_a=1;} }
  e1(ob,atp,"SA DIVERGE belief-commits/suf-abstains=",div_a);

  // S-B: provenance death (T-B analogue)
  let bb:i32=100;
  bb=b_r2(bb); bb=b_r2(bb);
  bb=b_r4(bb,0,4);
  let ret_b:i32=0;
  if(bb==0){ret_b=1;}
  let sel_b:i32=b_r7(bb,50);
  let mb:i32=7;
  mb=suf_falsify(mb,1); mb=suf_falsify(mb,2);
  let stb:i32=suf_state(mb);
  let svb:i32=suf_survivor(mb);
  let act_b:i32=0;
  if(stb==1){act_b=1;}
  e2(ob,atp,"SB belief b_sup=",bb," retired=",ret_b);
  e1(ob,atp,"SB belief R7 select1/abstain0=",sel_b);
  e2(ob,atp,"SB suf state 1=RESOLVED=",stb," survivor=",svb);
  e1(ob,atp,"SB suf predict1/abstain0=",act_b);
  let div_b:i32=0;
  if(sel_b==0){ if(act_b==1){div_b=1;} }
  e1(ob,atp,"SB DIVERGE belief-refuses/suf-predicts=",div_b);

  // S-C: sanity agreement
  let bc:i32=100;
  bc=b_r2(bc); bc=b_r2(bc);
  let sel_c:i32=b_r7(bc,50);
  let mc:i32=7;
  mc=suf_falsify(mc,0); mc=suf_falsify(mc,2);
  let stc:i32=suf_state(mc);
  let svc:i32=suf_survivor(mc);
  let act_c:i32=0;
  if(stc==1){act_c=1;}
  e2(ob,atp,"SC belief b_sup=",bc," R7 select=",sel_c);
  e2(ob,atp,"SC suf state=",stc," survivor=",svc);
  e1(ob,atp,"SC suf predict=",act_c);
  let agr_c:i32=0;
  if(sel_c==1){ if(act_c==1){agr_c=1;} }
  e1(ob,atp,"SC AGREE both-predict=",agr_c);

  // S-D: zero support on both sides, action direction
  let bd:i32=100;
  bd=b_r3(bd); bd=b_r3(bd); bd=b_r3(bd); bd=b_r3(bd); bd=b_r3(bd);
  let ret_d:i32=0;
  if(bd==0){ret_d=1;}
  let md:i32=7;
  md=suf_falsify(md,0); md=suf_falsify(md,1); md=suf_falsify(md,2);
  let std_:i32=suf_state(md);
  let esc_d:i32=0;
  if(std_==0){esc_d=1;}
  e2(ob,atp,"SD belief b_sup=",bd," retire-terminal=",ret_d);
  e2(ob,atp,"SD suf state 0=FALSIFIED-ALL=",std_," escalate=",esc_d);
  let div_d:i32=0;
  if(ret_d==1){ if(esc_d==1){div_d=1;} }
  e1(ob,atp,"SD DIVERGE retire-terminal-vs-escalate=",div_d);

  let pass:i32=0;
  if(div_a==1){ if(div_b==1){ if(agr_c==1){ if(div_d==1){pass=1;} } } }
  e1(ob,atp,"BSC-RESULT all-frozen-predictions-hold=",pass);
  e0(ob,atp,"BSC-END");
  write_ob(ob,atp);
  return 0;
}

// cert_adapter_driver.zag -- host+adapter certification driver (pure Zag).
// Appended to host base + adapter .zag files, then compiled with znc.
// The adapter (e.g. xio_core2.zag) is a host-dependent layer: it defines
// no trial substrate and no main. The host base supplies the trial
// substrate plus every host function the adapter calls. The host's own
// main is trimmed from the scratch copy only by cert_hostadapter.sh;
// the on-disk files are never modified.
//
// Checks:
//   AC2 REGISTRY: empty registry (count 0, find -1); xio_build writes a
//     tag-40 adapter node with the documented field layout; find/count
//     observe it.
//   AC3 FAILCLOSED: xio_exec on garbage MAP ids -> -999999; xio_adapt
//     with no adapter for the relation -> -2; xio_try with expected -2
//     -> -2; xio_sclass on a tag-0 node -> -1; xio_oty on it -> 0;
//     xio_dep_rel with no provenance -> -1; xio_stage_exec on class -1
//     -> -999999.
//   AC4 CLASS2 ROUNDTRIP: facts taught under one relation, graph built
//     with the learner's own t2_asm_sum, MAP promoted by this driver
//     with DEP provenance edges to the licensing facts. Asserts
//     xio_oty==1, xio_sclass==2, xio_dep_rel recovers the relation, and
//     xio_stage_exec re-derives the total through the class-2 path.
//   AC5 ADAPT ROUNDTRIP: two class-2 MAPs chained value-level
//     (m1(s) -> m2(v1)). xio_build + xio_find + xio_exec + xio_adapt
//     return the composed answer; mismatched expected and unknown query
//     relation -> -2.
//   AC6 GATE: with two same-class MAPs and one guard-only (class-0) MAP
//     present, xio_try attempts only cross-class pairs (the sclass
//     mismatch gate) and every attempt fails closed -> -2, building no
//     spurious adapter (count unchanged).

// driver-local MAP promoter: same node layout as the base's
// promote_graph (tag 20, field4=r, field8=s, field20=graph root,
// field24=promo index, field28=answer, DEP type-1 edges to licensing
// facts) but WITHOUT the extra ev_teach_in fact, so the re-derivation
// checks below see exactly the taught fact set.
fn ac_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){ return -1; }
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s);
  ns(W,m,12,-1); ns(W,m,16,-1);
  ns(W,m,20,root); ns(W,m,24,0); ns(W,m,28,ans);
  let i:i32=0;
  while(i<nf){ link_edge(W,m,1,get32(facts,i*4),0); i=i+1; }
  return m;
}

fn ac_check_registry()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  if(xio_count(W)!=0){ ok=0; }
  if(xio_find(W,7)!=-1){ ok=0; }
  let a:i32=xio_build(W,500,501,2,0,7,9,7,42);
  emit("XIO-AC2 REGISTRY build="); e64(a);
  if(a<2){ ok=0; }
  if(ng(W,a,0)!=40){ ok=0; }
  if(ng(W,a,4)!=500 || ng(W,a,8)!=501){ ok=0; }
  if(ng(W,a,12)!=2 || ng(W,a,16)!=0){ ok=0; }
  if(ng(W,a,20)!=7 || ng(W,a,24)!=9){ ok=0; }
  if(ng(W,a,28)!=42 || ng(W,a,32)!=7){ ok=0; }
  if(xio_find(W,7)!=a){ ok=0; }
  if(xio_find(W,8)!=-1){ ok=0; }
  if(xio_count(W)!=1){ ok=0; }
  if(ok==1){ emit(" PASS\n"); return 1; }
  emit(" FAIL\n"); return 0;
}

fn ac_check_failclosed()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let g:i32=xio_build(W,999,998,2,2,7,7,7,0);
  emit("XIO-AC3 FAILCLOSED garbage_adapter="); e64(g);
  if(g<2){ ok=0; }
  if(xio_exec(W,g,501)!=-999999){ ok=0; }
  if(xio_adapt(W,501,77,6)!=-2){ ok=0; }
  if(xio_try(W,501,7,-2)!=-2){ ok=0; }
  let z:i32=alloc_node(W);
  if(xio_sclass(W,z)!=-1){ ok=0; }
  if(xio_oty(W,z)!=0){ ok=0; }
  if(xio_dep_rel(W,z)!=-1){ ok=0; }
  if(xio_stage_exec(W,z,501)!=-999999){ ok=0; }
  if(ok==1){ emit(" PASS\n"); return 1; }
  emit(" FAIL\n"); return 0;
}

// AC4+AC5+AC6 share one world: MAPs built once, then adapted, then the
// composition gate is probed. Emits the three check lines.
fn ac_check_compose()i32 {
  let ok4:i32=1; let ok5:i32=1; let ok6:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // MAP mA: class-2 (INC-only graph), facts (501,7): 3,5 -> total 8.
  ev_teach(W,501,7,3); ev_teach(W,501,7,5);
  let vals:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
  let n1:i32=xio_gather_direct(W,501,7,vals,ff);
  let rootA:i32=t2_asm_sum(W,vals,n1);
  let mA:i32=ac_promote(W,rootA,501,7,8,ff,n1);
  emit("XIO-AC4 CLASS2 gather_n="); e64(n1); emit(" map="); e64(mA);
  if(n1!=2 || rootA<0 || mA<2){ ok4=0; }
  if(xio_oty(W,mA)!=1){ ok4=0; }
  if(xio_sclass(W,mA)!=2){ ok4=0; }
  if(xio_dep_rel(W,mA)!=7){ ok4=0; }
  let vA:i32=xio_stage_exec(W,mA,501);
  emit(" stage_exec="); e64(vA);
  if(vA!=8){ ok4=0; }
  if(ok4==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  // MAP mG: guard-only graph -> class 0, oty 0 (class discrimination).
  let lx:i32=t2_lit(W,601);
  let gd:i32=t2_guard(W,0,lx);
  ns(W,gd,12,-1);
  let ff0:[]u8=z_alloc(48);
  let mG:i32=ac_promote(W,gd,601,11,-2,ff0,0);
  if(xio_sclass(W,mG)!=0 || xio_oty(W,mG)!=0){ ok6=0; }
  // MAP mB: class-2, facts (8,9): 2,4 -> total 6.
  ev_teach(W,8,9,2); ev_teach(W,8,9,4);
  let vals2:[]u8=z_alloc(48); let ff2:[]u8=z_alloc(48);
  let n2:i32=xio_gather_direct(W,8,9,vals2,ff2);
  let rootB:i32=t2_asm_sum(W,vals2,n2);
  let mB:i32=ac_promote(W,rootB,8,9,6,ff2,n2);
  if(n2!=2 || rootB<0 || mB<2){ ok4=0; }
  if(xio_sclass(W,mB)!=2){ ok4=0; }
  let vB:i32=xio_stage_exec(W,mB,8);
  if(vB!=6){ ok4=0; }
  // AC5: value-level handoff mA(501)=8 -> mB(8)=6.
  // (xio_adapt emits its own XIO-REUSE log line on success; the AC5
  // verdict line is emitted after, so scoring greps see one line.)
  let a:i32=xio_build(W,mA,mB,2,2,7,9,7,6);
  let e1:i32=xio_exec(W,a,501);
  let ad1:i32=xio_adapt(W,501,7,6);
  let ad2:i32=xio_adapt(W,501,7,999);
  let ad3:i32=xio_adapt(W,501,8,6);
  emit("XIO-AC5 ADAPT adapter="); e64(a);
  emit(" exec="); e64(e1); emit(" adapt="); e64(ad1);
  if(a<2){ ok5=0; }
  if(xio_find(W,7)!=a){ ok5=0; }
  if(xio_count(W)!=1){ ok5=0; }
  if(e1!=6){ ok5=0; }
  if(ad1!=6){ ok5=0; }
  if(ad2!=-2){ ok5=0; }
  if(ad3!=-2){ ok5=0; }
  if(ok5==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  // AC6: mismatch gate. Same-class pairs (mA,mB) never attempted;
  // cross-class attempts vs the guard-only MAP fail closed; no build.
  emit("XIO-AC6 GATE ");
  if(xio_try(W,501,7,6)!=-2){ ok6=0; }
  if(xio_try(W,501,7,-2)!=-2){ ok6=0; }
  if(xio_count(W)!=1){ ok6=0; }
  if(ok6==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  if(ok4==1 && ok5==1 && ok6==1){ return 1; }
  return 0;
}

fn main()void {
  emit("XIOADAPT-START\n");
  let p2:i32=ac_check_registry();
  let p3:i32=ac_check_failclosed();
  let pc:i32=ac_check_compose();
  emit("XIOADAPT-SUMMARY AC2="); e64(p2);
  emit(" AC3="); e64(p3); emit(" AC456="); e64(pc); emit("\n");
  if(p2==1 && p3==1 && pc==1){ emit("XIO-ADAPTER-ALLPASS\n"); }
  else { emit("XIO-ADAPTER-SOMEFAIL\n"); }
  return;
}

#!/bin/sh
# certify_base_v2 <candidate.zag> -- H-BASECERT v2 base certification harness.
# Usage: certify_base_v2 /path/to/candidate.zag
#
# Step 1 classifies the candidate BEFORE running anything:
#   BASE                 defines the TNN-2 trial substrate (^fn tnn2_init()
#   ADAPTER              no trial substrate; probe compile (scratch copy +
#                        stub main when main is absent) fails with
#                        "call to unknown function" (host-dependent layer)
#   MECHANISM-EXPERIMENT no trial substrate; probe compiles standalone
#                        (self-contained file; its own tests are the evidence)
#   UNKNOWN              neither; probe compile failed otherwise
# Non-base classes get CERT-VERDICT NOT APPLICABLE with the exact cause,
# never FAIL. Exit codes: 0 PASS, 1 FAIL, 3 NOT APPLICABLE, 2 usage error.
#
# Step 2 adapts (BASE class only), folded in from the CERT-SWEEP findings:
#   (a) if the base defines its own ev_query with the cert D2 signature,
#       the driver's minimal ev_query glue is dropped and the base's own
#       entry point is the object under test; otherwise the glue driver
#       is used exactly as in v1;
#   (b) if the base defines fn main, the SCRATCH COPY ONLY is trimmed
#       from the `fn main(` line to EOF so the driver's main links.
# The base file on disk is never modified (read-only copy to scratch).
#
# Step 3 runs the four v1 checks unchanged: CERT-A leak (20 fixed trial
# problems, per-problem node/edge growth budgets), CERT-B arena (past
# capacity behavior), CERT-C determinism (3 runs, 300s timeout each,
# byte-identical sha256), CERT-D correctness (fixed problem set).
set -u
export PATH="$HOME/safebin"

if [ "$#" -ne 1 ]; then
  echo "usage: certify_base_v2 <candidate.zag>" >&2
  exit 2
fi
CAND="$1"
if [ ! -f "$CAND" ]; then
  echo "CERT-VERDICT NOT APPLICABLE (UNKNOWN: candidate file not found: $CAND)" >&2
  exit 3
fi
case "$CAND" in
  *.zag) ;;
  *) echo "CERT-VERDICT NOT APPLICABLE (UNKNOWN: not a .zag file: $CAND)" >&2; exit 3 ;;
esac

HERE="$(dirname "$0")"
DRIVER_GLUED="$HERE/cert_driver.zag"
DRIVER_NOEVQ="$HERE/cert_driver_noevq.zag"
if [ ! -f "$DRIVER_GLUED" ]; then
  echo "CERT-VERDICT FAIL (glue cert driver missing: $DRIVER_GLUED)" >&2
  exit 1
fi
if [ ! -f "$DRIVER_NOEVQ" ]; then
  echo "CERT-VERDICT FAIL (no-glue cert driver missing: $DRIVER_NOEVQ)" >&2
  exit 1
fi

CAND_SHA="$(sha256sum "$CAND" | cut -d' ' -f1)"
echo "CERT candidate=$CAND sha256=$CAND_SHA"

# ---- Step 1: classify ----
CLASS="UNKNOWN"
CAUSE=""
if [ "$(grep -c '^fn tnn2_init(' "$CAND" || true)" -gt 0 ]; then
  CLASS="BASE"
  CAUSE="defines the TNN-2 trial substrate (tnn2_init)"
else
  PROBE="$(mktemp -d /tmp/certv2_probe_XXXXXX)" || {
    echo "CERT-VERDICT NOT APPLICABLE (UNKNOWN: could not create probe dir)" >&2
    exit 3
  }
  cp "$CAND" "$PROBE/cand.zag"
  if [ "$(grep -c '^fn main(' "$PROBE/cand.zag" || true)" -eq 0 ]; then
    printf 'fn main()void { return; }\n' >> "$PROBE/cand.zag"
  fi
  if znc "$PROBE/cand.zag" -o "$PROBE/probe_bin" >"$PROBE/probe.log" 2>&1; then
    CLASS="MECHANISM-EXPERIMENT"
    CAUSE="compiles standalone with no trial substrate (no tnn2_init); base checks (trial problems via mp_run, 1024-node arena, trial correctness) have no substrate to run against; the file's own tests are the applicable evidence"
  else
    UNK="$(grep -o 'call to unknown function `[^`]*`' "$PROBE/probe.log" | head -1 | sed 's/^[^`]*`//; s/`.*//')"
    if [ -n "$UNK" ]; then
      CLASS="ADAPTER"
      CAUSE="host-dependent adapter layer: calls host function \`$UNK\` it does not define (first of possibly several); certify host base + adapter as a unit with cert_hostadapter.sh, a different harness"
    else
      ERR="$(grep -m1 -i 'error' "$PROBE/probe.log" | head -c 160 || true)"
      CAUSE="not a trial base and standalone probe compile failed: $ERR"
    fi
  fi
  rm -rf "$PROBE"
fi
echo "CERT-CLASS $CLASS"

if [ "$CLASS" != "BASE" ]; then
  echo "CERT-VERDICT NOT APPLICABLE ($CLASS: $CAUSE)"
  exit 3
fi

# ---- Step 2: adaptations (BASE class only) ----
SCRATCH="$(mktemp -d /tmp/certv2_base_XXXXXX)" || {
  echo "CERT-VERDICT FAIL (could not create scratch dir)" >&2
  exit 1
}
[ -d "$SCRATCH" ] || { echo "CERT-VERDICT FAIL (scratch dir missing)" >&2; exit 1; }
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

cp "$CAND" "$SCRATCH/base.zag"

EVQ="$(grep -c '^fn ev_query(' "$SCRATCH/base.zag" || true)"
if [ "$EVQ" -gt 0 ]; then
  if ! grep -qF 'fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {' "$SCRATCH/base.zag"; then
    ACTUAL="$(grep -m1 '^fn ev_query(' "$SCRATCH/base.zag" | head -c 120)"
    echo "CERT-VERDICT FAIL (base ev_query signature mismatch; D2 needs (W:[]u8,s:i32,r:i32,expected:i32)i32; found: $ACTUAL)"
    exit 1
  fi
  DRIVER="$DRIVER_NOEVQ"
  echo "CERT note: base defines ev_query (count $EVQ); driver glue dropped, base entry point under test"
else
  DRIVER="$DRIVER_GLUED"
  echo "CERT note: base does not define ev_query; driver glue supplied (v1 behavior)"
fi

MAINLINE="$(grep -n '^fn main(' "$SCRATCH/base.zag" | head -1 | cut -d: -f1 || true)"
if [ -n "$MAINLINE" ]; then
  head -n $((MAINLINE - 1)) "$SCRATCH/base.zag" > "$SCRATCH/base_nomain.zag"
  mv "$SCRATCH/base_nomain.zag" "$SCRATCH/base.zag"
  echo "CERT note: base defines fn main (line $MAINLINE); scratch copy trimmed, on-disk base untouched"
fi

cat "$SCRATCH/base.zag" "$DRIVER" > "$SCRATCH/cert_full.zag"

# ---- Step 3: compile, run 3x, score (unchanged from v1) ----
if ! znc "$SCRATCH/cert_full.zag" -o "$SCRATCH/cert_bin" > "$SCRATCH/compile.log" 2>&1; then
  echo "CERT-VERDICT FAIL (compile error; log below)"
  cat "$SCRATCH/compile.log"
  exit 1
fi
grep -q "wrote native" "$SCRATCH/compile.log" || {
  echo "CERT-VERDICT FAIL (no binary written; log below)"
  cat "$SCRATCH/compile.log"
  exit 1
}

i=1
PREV=""
DETOK=1
while [ "$i" -le 3 ]; do
  if ! timeout 300 "$SCRATCH/cert_bin" > "$SCRATCH/run$i.txt" 2>"$SCRATCH/run$i.err"; then
    echo "CERT-C DETERMINISM run$i TIMEOUT/CRASH FAIL"
    DETOK=0
    break
  fi
  H="$(sha256sum "$SCRATCH/run$i.txt" | cut -d' ' -f1)"
  echo "CERT-C run$i sha256=$H"
  if [ -n "$PREV" ] && [ "$H" != "$PREV" ]; then
    DETOK=0
  fi
  PREV="$H"
  i=$((i+1))
done
if [ "$DETOK" -eq 1 ]; then
  echo "CERT-C DETERMINISM 3/3 byte-identical PASS"
else
  echo "CERT-C DETERMINISM FAIL"
fi

A="FAIL"; B="FAIL"; D="FAIL"
grep -q "^CERT-A LEAK .* PASS$" "$SCRATCH/run1.txt" 2>/dev/null && A="PASS"
grep -q "^CERT-B ARENA .* PASS$" "$SCRATCH/run1.txt" 2>/dev/null && B="PASS"
grep -q "^CERT-D CORRECT PASS$" "$SCRATCH/run1.txt" 2>/dev/null && D="PASS"
echo "CERT-A LEAK $A"
echo "CERT-B ARENA $B"
echo "CERT-D CORRECT $D"

echo "--- run1 output ---"
cat "$SCRATCH/run1.txt"

if [ "$A" = "PASS" ] && [ "$B" = "PASS" ] && [ "$D" = "PASS" ] && [ "$DETOK" -eq 1 ]; then
  echo "CERT-VERDICT PASS (A=$A B=$B C=PASS D=$D)"
  exit 0
fi
echo "CERT-VERDICT FAIL (A=$A B=$B C=$([ "$DETOK" -eq 1 ] && echo PASS || echo FAIL) D=$D)"
exit 1

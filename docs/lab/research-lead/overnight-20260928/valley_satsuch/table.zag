// table.zag: satsearch instance table (NEW; the only new logic).
// Replaces the frozen v2inst.zag instance-table section (lines 68-186).
// Validation logic (v2gen.zag) is included byte-identical; see PREREG.
// Pure Zag. No Python.

// ---------- candidate decoders ----------
// ids: 0=CAL-0 clone; 1..30 F1; 31..33 F2; 34..63 F3; 64..71 F4.
fn s3_fam(id:i32)i32 {
  if(id==0){ return 0; }
  if(id<=30){ return 1; }
  if(id<=33){ return 2; }
  if(id<=63){ return 3; }
  return 4;
}
// F1 (ids 1..30): pro 0..2, m in {5,7}, k in 1..m-1.
fn s3_f1_pro(id:i32)i32 {
  let j:i32=id-1;
  if(j<10){ return 0; }
  if(j<20){ return 1; }
  return 2;
}
fn s3_f1_r(id:i32)i32 {
  let j:i32=id-1;
  if(j>=20){ return j-20; }
  if(j>=10){ return j-10; }
  return j;
}
fn s3_f1_m(id:i32)i32 {
  if(s3_f1_r(id)<4){ return 5; }
  return 7;
}
fn s3_f1_k(id:i32)i32 {
  let r:i32=s3_f1_r(id);
  if(r<4){ return r+1; }
  return r-3;
}
// F2 (ids 31..33): (a,b) in {(3,11),(5,13),(2,14)}.
fn s3_f2_a(id:i32)i32 {
  let ab:i32=id-31;
  if(ab==0){ return 3; }
  if(ab==1){ return 5; }
  return 2;
}
fn s3_f2_b(id:i32)i32 {
  let ab:i32=id-31;
  if(ab==0){ return 11; }
  if(ab==1){ return 13; }
  return 14;
}
// F3 (ids 34..63): a=1, pro 0..2, m in {5,7}, k in 1..m-1.
fn s3_f3_pro(id:i32)i32 {
  let j:i32=id-34;
  if(j<10){ return 0; }
  if(j<20){ return 1; }
  return 2;
}
fn s3_f3_r(id:i32)i32 {
  let j:i32=id-34;
  if(j>=20){ return j-20; }
  if(j>=10){ return j-10; }
  return j;
}
fn s3_f3_m(id:i32)i32 {
  if(s3_f3_r(id)<4){ return 5; }
  return 7;
}
fn s3_f3_k(id:i32)i32 {
  let r:i32=s3_f3_r(id);
  if(r<4){ return r+1; }
  return r-3;
}
// F4 (ids 64..71): pro 0..1, k in 1..4.
fn s3_f4_pro(id:i32)i32 {
  if(id-64<4){ return 0; }
  return 1;
}
fn s3_f4_k(id:i32)i32 {
  let j:i32=id-64;
  if(j<4){ return j+1; }
  return j-3;
}

// ---------- instance table (replaces frozen section) ----------
fn v2_n()i32 { return 72; }
fn v2_kind(id:i32)i32 {
  return s3_fam(id);
}
fn v2_depth(id:i32)i32 {
  if(id==0){ return 0; }
  return 2;
}
fn v2_nep(id:i32)i32 {
  if(id==0){ return 9; }
  let f:i32=s3_fam(id);
  if(f==1){ return 2*s3_f1_m(id)+1; }
  if(f==2){ return 16; }
  if(f==3){ return 2*s3_f3_m(id)+1; }
  return 10;
}
fn v2_in0(id:i32, e:i32)i32 {
  return e;
}
fn v2_in1(id:i32, e:i32)i32 {
  return 0;
}
fn v2_tgt(id:i32, e:i32)i32 {
  if(id==0){ return e; }
  let f:i32=s3_fam(id);
  if(f==1){
    let r:i32=v2_mod_nonneg(e*e, s3_f1_m(id));
    if(r==s3_f1_k(id)){ return 1; }
    return 0;
  }
  if(f==2){
    if(e==s3_f2_a(id) || e==s3_f2_b(id)){ return 1; }
    return 0;
  }
  if(f==3){
    let r:i32=v2_mod_nonneg(e+1, s3_f3_m(id));
    if(r==s3_f3_k(id)){ return 1; }
    return 0;
  }
  let r:i32=v2_mod_nonneg(e*e*e, 5);
  if(r==s3_f4_k(id)){ return 1; }
  return 0;
}
// s0 self-consistency (documented in prereg; the frozen check is
// vacuous for the new table by construction).
fn v2_s0_frozen(id:i32)i32 {
  if(id==0){ return 1; }
  return v2_s0(id);
}
fn v2_p0_len(id:i32)i32 { return 1; }
fn v2_p0_op(id:i32)i32 { return 0; }
fn v2_p0_arg(id:i32)i32 { return 0; }
// verbatim from frozen v2inst.zag (generic slot writer).
fn v2_slot(op:[]u8, arg:[]u8, i:i32, o:i32, a:i32)void {
  v2_set32(op, i*4, o); v2_set32(arg, i*4, a);
  return;
}
fn v2_cpath(id:i32, op:[]u8, arg:[]u8)i32 {
  if(id==0){ v2_slot(op,arg,0,1,0); return 1; }
  let f:i32=s3_fam(id);
  if(f==1){
    let m:i32=s3_f1_m(id); let k:i32=s3_f1_k(id);
    let p:i32=s3_f1_pro(id);
    let n:i32=0;
    if(p==2){
      v2_slot(op,arg,0,0,7); v2_slot(op,arg,1,0,5);
      v2_slot(op,arg,2,10,0); n=3;
    } else if(p==1){
      v2_slot(op,arg,0,10,0); n=1;
    }
    v2_slot(op,arg,n,1,0); v2_slot(op,arg,n+1,9,0);
    v2_slot(op,arg,n+2,5,0); v2_slot(op,arg,n+3,0,m);
    v2_slot(op,arg,n+4,7,0); v2_slot(op,arg,n+5,0,k);
    v2_slot(op,arg,n+6,14,0);
    return n+7;
  }
  if(f==2){
    let a:i32=s3_f2_a(id); let b:i32=s3_f2_b(id);
    v2_slot(op,arg,0,10,0); v2_slot(op,arg,1,1,0);
    v2_slot(op,arg,2,0,a); v2_slot(op,arg,3,4,0);
    v2_slot(op,arg,4,1,0); v2_slot(op,arg,5,0,b);
    v2_slot(op,arg,6,4,0); v2_slot(op,arg,7,5,0);
    v2_slot(op,arg,8,0,0); v2_slot(op,arg,9,14,0);
    return 10;
  }
  if(f==3){
    let m:i32=s3_f3_m(id); let k:i32=s3_f3_k(id);
    let p:i32=s3_f3_pro(id);
    let n:i32=0;
    if(p==2){
      v2_slot(op,arg,0,0,7); v2_slot(op,arg,1,0,5);
      v2_slot(op,arg,2,10,0); n=3;
    } else if(p==1){
      v2_slot(op,arg,0,10,0); n=1;
    }
    v2_slot(op,arg,n,1,0); v2_slot(op,arg,n+1,0,1);
    v2_slot(op,arg,n+2,3,0); v2_slot(op,arg,n+3,0,m);
    v2_slot(op,arg,n+4,7,0); v2_slot(op,arg,n+5,0,k);
    v2_slot(op,arg,n+6,14,0);
    return n+7;
  }
  let k:i32=s3_f4_k(id);
  let n:i32=0;
  if(s3_f4_pro(id)==1){
    v2_slot(op,arg,0,10,0); n=1;
  }
  v2_slot(op,arg,n,1,0); v2_slot(op,arg,n+1,9,0);
  v2_slot(op,arg,n+2,9,0); v2_slot(op,arg,n+3,5,0);
  v2_slot(op,arg,n+4,5,0); v2_slot(op,arg,n+5,0,5);
  v2_slot(op,arg,n+6,7,0); v2_slot(op,arg,n+7,0,k);
  v2_slot(op,arg,n+8,14,0);
  return n+9;
}

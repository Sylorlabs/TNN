// v2gen.zag: valley redesign-2 validation (V1-V5).
// Concatenated after v2inst.zag. Pure Zag. No Python.
// Authority: PREREG_VALLEY_REDESIGN2.md (0310c7076).

// ---------- frozen 34-symbol straight-line alphabet ----------
// IN0, IN1, PUSH -9..9, ADD, SUB, MUL, DIV, MOD, NEG, DUP, DROP,
// SWAP, OVER, LT, EQ, GT.
fn v2a_op(s:i32)i32 {
  if(s==0){ return 1; }
  if(s==1){ return 2; }
  if(s>=2 && s<=20){ return 0; }
  if(s==21){ return 3; } if(s==22){ return 4; } if(s==23){ return 5; }
  if(s==24){ return 6; } if(s==25){ return 7; } if(s==26){ return 8; }
  if(s==27){ return 9; } if(s==28){ return 10; } if(s==29){ return 11; }
  if(s==30){ return 12; } if(s==31){ return 13; } if(s==32){ return 14; }
  return 15;
}
fn v2a_arg(s:i32)i32 {
  if(s>=2 && s<=20){ return s-11; }
  return 0;
}

// build F = P0 + O into fop/farg; return L.
fn v2_build_full(id:i32, fop:[]u8, farg:[]u8)i32 {
  let L:i32=0;
  v2_set32(fop, 0, v2_p0_op(id)); v2_set32(farg, 0, v2_p0_arg(id));
  L=1;
  let op:[]u8=v2_alloc(48*4); let arg:[]u8=v2_alloc(48*4);
  let cl:i32=v2_cpath(id, op, arg);
  let i:i32=0;
  while(i<cl){
    v2_set32(fop, L*4, v2_get32(op, i*4)); v2_set32(farg, L*4, v2_get32(arg, i*4));
    L=L+1; i=i+1;
  }
  return L;
}

// V1: returns 1 if the score profile passes.
fn v2_v1(id:i32, fop:[]u8, farg:[]u8, L:i32, s0:i32, n:i32, d:i32)i32 {
  if(s0>=n){
    v2_emit("  V1-FAIL s0>=n s0="); v2_e64(s0); v2_nl();
    return 0;
  }
  let p0l:i32=v2_p0_len(id);
  let ties:i32=0; let strict:i32=0;
  let k:i32=p0l+1;
  while(k<L){
    let sc:i32=v2_score(id, fop, farg, k);
    v2_emit("  V1 prefix k="); v2_e64(k);
    v2_emit(" score="); v2_e64(sc); v2_nl();
    if(sc>s0){
      v2_emit("  V1-FAIL oplevel k="); v2_e64(k);
      v2_emit(" score="); v2_e64(sc);
      v2_emit(" > s0="); v2_e64(s0); v2_nl();
      return 0;
    }
    if(sc==s0){ ties=ties+1; } else { strict=strict+1; }
    k=k+1;
  }
  if(ties>1){
    v2_emit("  V1-FAIL ties="); v2_e64(ties); v2_nl();
    return 0;
  }
  if(strict<d-1){
    v2_emit("  V1-FAIL strict="); v2_e64(strict);
    v2_emit(" d="); v2_e64(d); v2_nl();
    return 0;
  }
  let full:i32=v2_score(id, fop, farg, L);
  if(full!=n){
    v2_emit("  V1-FAIL full="); v2_e64(full);
    v2_emit(" n="); v2_e64(n); v2_nl();
    return 0;
  }
  return 1;
}

// V2: REF-GREEDY. Returns 1 if greedy FAILS to solve (instance OK).
fn v2_v2(id:i32)i32 {
  let n:i32=v2_nep(id);
  let op:[]u8=v2_alloc(256*4); let arg:[]u8=v2_alloc(256*4);
  v2_set32(op, 0, v2_p0_op(id)); v2_set32(arg, 0, v2_p0_arg(id));
  let len:i32=1;
  let cur:i32=v2_score(id, op, arg, len);
  let iter:i32=0;
  while(iter<500){
    let best:i32=cur; let bo:i32=-1; let ba:i32=0;
    let s:i32=0;
    while(s<34){
      v2_set32(op, len*4, v2a_op(s)); v2_set32(arg, len*4, v2a_arg(s));
      let sc:i32=v2_score(id, op, arg, len+1);
      if(sc>best){ best=sc; bo=v2a_op(s); ba=v2a_arg(s); }
      s=s+1;
    }
    if(bo==-1){
      v2_emit("  V2 greedy-halted len="); v2_e64(len);
      v2_emit(" score="); v2_e64(cur); v2_nl();
      return 1;
    }
    v2_set32(op, len*4, bo); v2_set32(arg, len*4, ba); len=len+1;
    cur=best;
    v2_emit("  V2 greedy-step len="); v2_e64(len);
    v2_emit(" score="); v2_e64(cur); v2_nl();
    if(cur==n){ return 0; }
    iter=iter+1;
  }
  return 1;
}

// is prog[0..pl] a prefix of F[0..L]?
fn v2_is_f_prefix(prog_op:[]u8, prog_arg:[]u8, pl:i32,
                  fop:[]u8, farg:[]u8, L:i32, p0l:i32)i32 {
  let m:i32=p0l;
  while(m<=L){
    if(pl==m){
      let ok:i32=1;
      let i:i32=0;
      while(i<m){
        if(v2_get32(prog_op,i*4)!=v2_get32(fop,i*4) ||
           v2_get32(prog_arg,i*4)!=v2_get32(farg,i*4)){ ok=0; }
        i=i+1;
      }
      if(ok==1){ return 1; }
    }
    m=m+1;
  }
  return 0;
}

fn v2_print_prog(op:[]u8, arg:[]u8, pl:i32)void {
  let i:i32=0;
  while(i<pl){
    v2_emit(" ("); v2_e64(v2_get32(op,i*4));
    v2_emit(","); v2_e64(v2_get32(arg,i*4)); v2_emit(")");
    i=i+1;
  }
  return;
}

// second edit applied to qop/qarg (length ql); checks all 1-edit
// neighbors of length <= 12. Returns 0 if a solver is found.
fn v2_v3_second(id:i32, qop:[]u8, qarg:[]u8, ql:i32,
                fop:[]u8, farg:[]u8, L:i32, p0l:i32,
                nop:[]u8, narg:[]u8)i32 {
  let n:i32=v2_nep(id);
  let i:i32=0; let s:i32=0; let pos:i32=0;
  if(ql+1<=12){
    s=0;
    while(s<34){
      i=0; while(i<ql){ v2_set32(nop,i*4,v2_get32(qop,i*4)); v2_set32(narg,i*4,v2_get32(qarg,i*4)); i=i+1; }
      v2_set32(nop,ql*4,v2a_op(s)); v2_set32(narg,ql*4,v2a_arg(s));
      if(v2_is_f_prefix(nop,narg,ql+1,fop,farg,L,p0l)==0){
        if(v2_score(id,nop,narg,ql+1)==n){
          v2_emit("  V3-FAIL 2edit append solver="); v2_print_prog(nop,narg,ql+1); v2_nl();
          return 0;
        }
      }
      s=s+1;
    }
  }
  pos=0;
  while(pos<ql){
    s=0;
    while(s<34){
      if(v2a_op(s)!=v2_get32(qop,pos*4) || v2a_arg(s)!=v2_get32(qarg,pos*4)){
        i=0; while(i<ql){ v2_set32(nop,i*4,v2_get32(qop,i*4)); v2_set32(narg,i*4,v2_get32(qarg,i*4)); i=i+1; }
        v2_set32(nop,pos*4,v2a_op(s)); v2_set32(narg,pos*4,v2a_arg(s));
        if(v2_is_f_prefix(nop,narg,ql,fop,farg,L,p0l)==0){
          if(v2_score(id,nop,narg,ql)==n){
            v2_emit("  V3-FAIL 2edit replace solver="); v2_print_prog(nop,narg,ql); v2_nl();
            return 0;
          }
        }
      }
      s=s+1;
    }
    pos=pos+1;
  }
  if(ql-1<=12 && ql>=1){
    pos=0;
    while(pos<ql){
      let m:i32=ql-1;
      i=0;
      while(i<m){
        let src:i32=i;
        if(i>=pos){ src=i+1; }
        v2_set32(nop,i*4,v2_get32(qop,src*4)); v2_set32(narg,i*4,v2_get32(qarg,src*4));
        i=i+1;
      }
      if(v2_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(v2_score(id,nop,narg,m)==n){
          v2_emit("  V3-FAIL 2edit delete solver="); v2_print_prog(nop,narg,m); v2_nl();
          return 0;
        }
      }
      pos=pos+1;
    }
  }
  return 1;
}

// V3: returns 1 if no solving neighbor found (instance OK).
// 1-edit over every proper prefix; 2-edit for k<=10. All redesign-2
// canonical paths have L<=11, so this enumeration is COMPLETE.
fn v2_v3(id:i32, fop:[]u8, farg:[]u8, L:i32)i32 {
  let n:i32=v2_nep(id);
  let p0l:i32=v2_p0_len(id);
  let pop:[]u8=v2_alloc(64*4); let parg:[]u8=v2_alloc(64*4);
  let nop:[]u8=v2_alloc(64*4); let narg:[]u8=v2_alloc(64*4);
  let k:i32=p0l;
  while(k<L){
    let i:i32=0;
    while(i<k){ v2_set32(pop,i*4,v2_get32(fop,i*4)); v2_set32(parg,i*4,v2_get32(farg,i*4)); i=i+1; }
    let s:i32=0;
    while(s<34){
      let m:i32=k+1;
      i=0; while(i<k){ v2_set32(nop,i*4,v2_get32(pop,i*4)); v2_set32(narg,i*4,v2_get32(parg,i*4)); i=i+1; }
      v2_set32(nop,k*4,v2a_op(s)); v2_set32(narg,k*4,v2a_arg(s));
      if(v2_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(v2_score(id,nop,narg,m)==n){
          v2_emit("  V3-FAIL k="); v2_e64(k); v2_emit(" append sym="); v2_e64(s); v2_nl();
          return 0;
        }
      }
      s=s+1;
    }
    let pos:i32=0;
    while(pos<k){
      s=0;
      while(s<34){
        if(v2a_op(s)!=v2_get32(pop,pos*4) || v2a_arg(s)!=v2_get32(parg,pos*4)){
          i=0; while(i<k){ v2_set32(nop,i*4,v2_get32(pop,i*4)); v2_set32(narg,i*4,v2_get32(parg,i*4)); i=i+1; }
          v2_set32(nop,pos*4,v2a_op(s)); v2_set32(narg,pos*4,v2a_arg(s));
          if(v2_is_f_prefix(nop,narg,k,fop,farg,L,p0l)==0){
            if(v2_score(id,nop,narg,k)==n){
              v2_emit("  V3-FAIL k="); v2_e64(k); v2_emit(" replace pos="); v2_e64(pos);
              v2_emit(" sym="); v2_e64(s); v2_nl();
              return 0;
            }
          }
        }
        s=s+1;
      }
      pos=pos+1;
    }
    pos=0;
    while(pos<k){
      let m:i32=k-1;
      i=0;
      while(i<m){
        let src:i32=i;
        if(i>=pos){ src=i+1; }
        v2_set32(nop,i*4,v2_get32(pop,src*4)); v2_set32(narg,i*4,v2_get32(parg,src*4));
        i=i+1;
      }
      if(v2_is_f_prefix(nop,narg,m,fop,farg,L,p0l)==0){
        if(v2_score(id,nop,narg,m)==n){
          v2_emit("  V3-FAIL k="); v2_e64(k); v2_emit(" delete pos="); v2_e64(pos); v2_nl();
          return 0;
        }
      }
      pos=pos+1;
    }
    if(k<=10){
      let qop:[]u8=v2_alloc(64*4); let qarg:[]u8=v2_alloc(64*4);
      s=0;
      while(s<34){
        let ql:i32=k+1;
        i=0; while(i<k){ v2_set32(qop,i*4,v2_get32(pop,i*4)); v2_set32(qarg,i*4,v2_get32(parg,i*4)); i=i+1; }
        v2_set32(qop,k*4,v2a_op(s)); v2_set32(qarg,k*4,v2a_arg(s));
        if(v2_v3_second(id,qop,qarg,ql,fop,farg,L,p0l,nop,narg)==0){ return 0; }
        s=s+1;
      }
      pos=0;
      while(pos<k){
        s=0;
        while(s<34){
          if(v2a_op(s)!=v2_get32(pop,pos*4) || v2a_arg(s)!=v2_get32(parg,pos*4)){
            i=0; while(i<k){ v2_set32(qop,i*4,v2_get32(pop,i*4)); v2_set32(qarg,i*4,v2_get32(parg,i*4)); i=i+1; }
            v2_set32(qop,pos*4,v2a_op(s)); v2_set32(qarg,pos*4,v2a_arg(s));
            if(v2_v3_second(id,qop,qarg,k,fop,farg,L,p0l,nop,narg)==0){ return 0; }
          }
          s=s+1;
        }
        pos=pos+1;
      }
      pos=0;
      while(pos<k){
        let ql2:i32=k-1;
        i=0;
        while(i<ql2){
          let src:i32=i;
          if(i>=pos){ src=i+1; }
          v2_set32(qop,i*4,v2_get32(pop,src*4)); v2_set32(qarg,i*4,v2_get32(parg,src*4));
          i=i+1;
        }
        if(v2_v3_second(id,qop,qarg,ql2,fop,farg,L,p0l,nop,narg)==0){ return 0; }
        pos=pos+1;
      }
    }
    k=k+1;
  }
  return 1;
}

// ---------- V4-A: frozen hyp_a residual-construction algorithm ----------
// Decision logic copied verbatim from hyp_a.zag (commit 21d838921,
// BUILD-FAIL, A-F1 fires): 13-op straight-line VM (ops 0..12, same
// encoding/semantics as v2_vm_run), 31-symbol choice set
// (PUSH -9..9, IN0, IN1, ADD..OVER), residual R = tgt - out,
// complexity = distinct*1000000 + range, strict improvement only,
// constant-residual forced PUSH c + ADD, 40 steps, 1M eval cap.
// Only the episode table is substituted for the hardcoded T0-T5.
// Returns 1 if the construction FAILS to solve (calibration OK).
fn v2_resid_cx(res:[]u8, n:i32)i64 {
  if(n==0){ return 0; }
  let mn:i32=v2_get32(res,0);
  let mx:i32=v2_get32(res,0);
  let i:i32=1;
  while(i<n){
    let v:i32=v2_get32(res,i*4);
    if(v<mn){ mn=v; }
    if(v>mx){ mx=v; }
    i=i+1;
  }
  let distinct:i32=0;
  i=0;
  while(i<n){
    let v:i32=v2_get32(res,i*4);
    let seen:i32=0;
    let j:i32=0;
    while(j<i){
      if(v2_get32(res,j*4)==v){ seen=1; break; }
      j=j+1;
    }
    if(seen==0){ distinct=distinct+1; }
    i=i+1;
  }
  return (distinct as i64)*1000000 + ((mx-mn) as i64);
}
fn v2_v4a(id:i32)i32 {
  let n:i32=v2_nep(id);
  let op:[]u8=v2_alloc(64*4); let arg:[]u8=v2_alloc(64*4);
  let tmp:[]u8=v2_alloc(64*4); let tmparg:[]u8=v2_alloc(64*4);
  let res:[]u8=v2_alloc(n*4);
  let stk:[]u8=v2_alloc(256*4);
  let plen:i32=0;
  let evals:i32=0;
  let step:i32=0;
  while(step<40){
    let i:i32=0;
    while(i<n){
      let o:i32=v2_vm_run(op, arg, plen, v2_in0(id,i), v2_in1(id,i), stk);
      v2_set32(res, i*4, v2_tgt(id,i)-o);
      i=i+1;
    }
    let allz:i32=1;
    i=0;
    while(i<n){ if(v2_get32(res,i*4)!=0){ allz=0; } i=i+1; }
    if(allz==1){
      v2_emit("  V4-A SOLVED (miscalibrated)"); v2_nl();
      return 0;
    }
    let c:i32=v2_get32(res,0);
    let isconst:i32=1;
    i=1;
    while(i<n){ if(v2_get32(res,i*4)!=c){ isconst=0; } i=i+1; }
    if(isconst==1){
      if(c<-9 || c>9){
        v2_emit("  V4-A const-out-of-range, fails as myopic"); v2_nl();
        return 1;
      }
      v2_set32(op, plen*4, 0); v2_set32(arg, plen*4, c); plen=plen+1;
      v2_set32(op, plen*4, 3); v2_set32(arg, plen*4, 0); plen=plen+1;
      step=step+1;
      continue;
    }
    let cur_cx:i64=v2_resid_cx(res, n);
    let best_cx:i64=cur_cx;
    let bo:i32=-1; let ba:i32=0;
    // PUSH -9..9
    let kk:i32=-9;
    while(kk<=9){
      i=0; while(i<plen){ v2_set32(tmp,i*4,v2_get32(op,i*4)); v2_set32(tmparg,i*4,v2_get32(arg,i*4)); i=i+1; }
      v2_set32(tmp,plen*4,0); v2_set32(tmparg,plen*4,kk);
      let j:i32=0;
      while(j<n){
        let o:i32=v2_vm_run(tmp, tmparg, plen+1, v2_in0(id,j), v2_in1(id,j), stk);
        v2_set32(res, j*4, v2_tgt(id,j)-o);
        j=j+1;
      }
      let cx:i64=v2_resid_cx(res, n);
      evals=evals+1;
      if(cx<best_cx){ best_cx=cx; bo=0; ba=kk; }
      kk=kk+1;
    }
    // IN0, IN1
    let t2:i32=1;
    while(t2<=2){
      i=0; while(i<plen){ v2_set32(tmp,i*4,v2_get32(op,i*4)); v2_set32(tmparg,i*4,v2_get32(arg,i*4)); i=i+1; }
      v2_set32(tmp,plen*4,t2); v2_set32(tmparg,plen*4,0);
      let j:i32=0;
      while(j<n){
        let o:i32=v2_vm_run(tmp, tmparg, plen+1, v2_in0(id,j), v2_in1(id,j), stk);
        v2_set32(res, j*4, v2_tgt(id,j)-o);
        j=j+1;
      }
      let cx:i64=v2_resid_cx(res, n);
      evals=evals+1;
      if(cx<best_cx){ best_cx=cx; bo=t2; ba=0; }
      t2=t2+1;
    }
    // ADD..OVER (3..12)
    let oo:i32=3;
    while(oo<=12){
      i=0; while(i<plen){ v2_set32(tmp,i*4,v2_get32(op,i*4)); v2_set32(tmparg,i*4,v2_get32(arg,i*4)); i=i+1; }
      v2_set32(tmp,plen*4,oo); v2_set32(tmparg,plen*4,0);
      let j:i32=0;
      while(j<n){
        let o:i32=v2_vm_run(tmp, tmparg, plen+1, v2_in0(id,j), v2_in1(id,j), stk);
        v2_set32(res, j*4, v2_tgt(id,j)-o);
        j=j+1;
      }
      let cx:i64=v2_resid_cx(res, n);
      evals=evals+1;
      if(cx<best_cx){ best_cx=cx; bo=oo; ba=0; }
      oo=oo+1;
    }
    if(bo==-1){
      v2_emit("  V4-A stuck at step="); v2_e64(step);
      v2_emit(" (myopic, calibration OK)"); v2_nl();
      return 1;
    }
    v2_set32(op, plen*4, bo); v2_set32(arg, plen*4, ba); plen=plen+1;
    step=step+1;
    if(evals>1000000){
      v2_emit("  V4-A budget exhausted (calibration OK)"); v2_nl();
      return 1;
    }
  }
  v2_emit("  V4-A max steps without solve (calibration OK)"); v2_nl();
  return 1;
}

// ---------- V4-G: GREEDY-2 (strict greedy, 2-op lookahead) ----------
// By construction never takes a score-decreasing step. Returns 1 if it
// FAILS to solve (calibration OK).
fn v2_v4g(id:i32)i32 {
  let n:i32=v2_nep(id);
  let op:[]u8=v2_alloc(256*4); let arg:[]u8=v2_alloc(256*4);
  v2_set32(op, 0, v2_p0_op(id)); v2_set32(arg, 0, v2_p0_arg(id));
  let len:i32=1;
  let cur:i32=v2_score(id, op, arg, len);
  let iter:i32=0;
  while(iter<500){
    let best:i32=cur;
    let bn:i32=0; // 1 or 2
    let b1o:i32=0; let b1a:i32=0; let b2o:i32=0; let b2a:i32=0;
    let s:i32=0;
    while(s<34){
      v2_set32(op, len*4, v2a_op(s)); v2_set32(arg, len*4, v2a_arg(s));
      let sc:i32=v2_score(id, op, arg, len+1);
      if(sc>best){ best=sc; bn=1; b1o=v2a_op(s); b1a=v2a_arg(s); }
      s=s+1;
    }
    let s1:i32=0;
    while(s1<34){
      v2_set32(op, len*4, v2a_op(s1)); v2_set32(arg, len*4, v2a_arg(s1));
      let s2:i32=0;
      while(s2<34){
        v2_set32(op, (len+1)*4, v2a_op(s2)); v2_set32(arg, (len+1)*4, v2a_arg(s2));
        let sc:i32=v2_score(id, op, arg, len+2);
        if(sc>best){ best=sc; bn=2; b1o=v2a_op(s1); b1a=v2a_arg(s1); b2o=v2a_op(s2); b2a=v2a_arg(s2); }
        s2=s2+1;
      }
      s1=s1+1;
    }
    if(bn==0){
      v2_emit("  V4-G halted len="); v2_e64(len);
      v2_emit(" score="); v2_e64(cur); v2_nl();
      return 1;
    }
    v2_set32(op, len*4, b1o); v2_set32(arg, len*4, b1a); len=len+1;
    if(bn==2){
      v2_set32(op, len*4, b2o); v2_set32(arg, len*4, b2a); len=len+1;
    }
    cur=best;
    v2_emit("  V4-G step len="); v2_e64(len);
    v2_emit(" score="); v2_e64(cur); v2_nl();
    if(cur==n){
      v2_emit("  V4-G SOLVED (miscalibrated)"); v2_nl();
      return 0;
    }
    iter=iter+1;
  }
  return 1;
}

// V4: both calibrators must fail to solve. Returns 1 if calibrated.
fn v2_v4(id:i32)i32 {
  let ra:i32=v2_v4a(id);
  v2_emit("  V4-A "); if(ra==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(ra==0){ return 0; }
  let rg:i32=v2_v4g(id);
  v2_emit("  V4-G "); if(rg==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(rg==0){ return 0; }
  return 1;
}

fn v2_validate_one(id:i32)i32 {
  let n:i32=v2_nep(id);
  let s0c:i32=v2_s0(id);
  let s0f:i32=v2_s0_frozen(id);
  let d:i32=v2_depth(id);
  v2_emit("INSTANCE id="); v2_e64(id);
  v2_emit(" kind="); v2_e64(v2_kind(id));
  v2_emit(" nep="); v2_e64(n);
  v2_emit(" s0="); v2_e64(s0c);
  v2_emit(" depth="); v2_e64(d);
  v2_nl();
  if(s0c!=s0f){
    v2_emit("  S0-MISMATCH computed="); v2_e64(s0c);
    v2_emit(" frozen="); v2_e64(s0f); v2_nl();
    return 0;
  }
  if(id==0){
    let op:[]u8=v2_alloc(8*4); let arg:[]u8=v2_alloc(8*4);
    v2_set32(op,0,0); v2_set32(arg,0,0); v2_set32(op,4,1); v2_set32(arg,4,0);
    let sc:i32=v2_score(id, op, arg, 2);
    v2_emit("  CAL0-OK in0-solve-score="); v2_e64(sc); v2_nl();
    if(sc==n){ return 1; }
    return 0;
  }
  let fop:[]u8=v2_alloc(64*4); let farg:[]u8=v2_alloc(64*4);
  let L:i32=v2_build_full(id, fop, farg);
  v2_emit("  canonlen="); v2_e64(L); v2_nl();
  let r1:i32=v2_v1(id, fop, farg, L, s0c, n, d);
  v2_emit("  V1 "); if(r1==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(r1==0){ return 0; }
  let r2:i32=v2_v2(id);
  v2_emit("  V2 "); if(r2==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(r2==0){ return 0; }
  let r3:i32=v2_v3(id, fop, farg, L);
  v2_emit("  V3 "); if(r3==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(r3==0){ return 0; }
  let r4:i32=v2_v4(id);
  v2_emit("  V4 "); if(r4==1){ v2_emit("PASS"); } else { v2_emit("FAIL"); } v2_nl();
  if(r4==0){ return 0; }
  v2_emit("  ACCEPTED"); v2_nl();
  return 1;
}

fn main()void {
  v2_emit("VALLEY-REDESIGN2-VALIDATION prereg=0310c7076\n");
  let ok:i32=1;
  let id:i32=0;
  while(id<v2_n()){
    if(v2_validate_one(id)==0){ ok=0; }
    id=id+1;
  }
  if(ok==1){ v2_emit("VALIDATION-ALL-ACCEPTED\n"); }
  else { v2_emit("VALIDATION-SOME-FAILED\n"); }
  return;
}

  total=total+1; if(t_r_pact6()==1){pass=pass+1; tpass("R-PACT6");} else {tfail("R-PACT6");}
  total=total+1; if(t_t2_chain4()==1){pass=pass+1; tpass("T2-CHAIN4");} else {tfail("T2-CHAIN4");}
  total=total+1; if(t_t2_trial_reject()==1){pass=pass+1; tpass("T2-REJECT");} else {tfail("T2-REJECT");}
  total=total+1; if(t_t2_inquire()==1){pass=pass+1; tpass("T2-INQUIRE");} else {tfail("T2-INQUIRE");}
  total=total+1; if(t_t2_actlive()==1){pass=pass+1; tpass("T2-ACTLIVE");} else {tfail("T2-ACTLIVE");}
  total=total+1; if(t_t2_revise()==1){pass=pass+1; tpass("T2-REVISE");} else {tfail("T2-REVISE");}
  emit("TOTAL "); e64(pass); emit("/"); e64(total); emit("\n");
  if(pass==total){return 0;}
  return 1;
}
// ============ ACT 24/24 remediation port (prereg ACT_REMED_PREREG.md) ============
// Ported from act_build/act.zag (614 lines, 23 ptests + ALL-PASS).
// Test names and expected values identical to standalone (K3 fidelity).
// P-ACT6A/B use TNN-1's real evict_node (3-step directional) not the stand-in.

fn r_ptest(name:[]u8, got:i32, want:i32)i32 {
  emit(name); emit(": got "); e64(got); emit(" want "); e64(want);
  if(got==want){ emit(" PASS\n"); return 1; } else { emit(" FAIL\n"); return 0; }
}
fn r_mk_fact(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); return a;
}
fn r_mk_goal(W:[]u8, target:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,2); ns(W,a,4,target); return a;
}
fn r_mk_guide(W:[]u8, anchor:i32, goal:i32, choice:i32, conf:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,102); ns(W,a,4,anchor); ns(W,a,8,goal);
  write_node(W,a,choice,conf,0,0); link_edge(W,goal,1,a,0); return a;
}
fn r_mk_uncert(W:[]u8, qctx:i32)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,30); ns(W,a,4,qctx); return a;
}
fn r_learn_confirm(W:[]u8, ses:i32, a:i32)void {
  link_edge(W,ses,6,a,0); link_edge(W,ses,7,a,0); return;
}
fn r_ctx_clear(W:[]u8)void {
  hs(W,48,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0); return;
}
fn r_live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn r_evict_to_cap(W:[]u8, cap:i32)i32 {
  let ev:i32=0; let guard:i32=0;
  while(r_live_count(W)>cap && guard<10000){
    guard=guard+1;
    let v:i32=evict_node(W);
    if(v<0){ return ev; }
    ev=ev+1;
  }
  return ev;
}
fn r_derive_d1(W:[]u8, ses:i32, goal:i32, gstate:i32, trans:[]u8, nt:i32)i32 {
  let made:i32=0;
  let work:[]u8=z_alloc(256*4);
  set32(work,0,gstate); let wc:i32=1; let wi:i32=0;
  while(wi<wc){
    let s:i32=get32(work,wi*4);
    let t:i32=0;
    while(t<nt){
      let fs:i32=get32(trans,t*12); let ac:i32=get32(trans,t*12+4);
      let ts:i32=get32(trans,t*12+8);
      if(ts==s){
        let has:i32=0; let a:i32=2;
        while(a<1024){
          if(ng(W,a,36)==1 && ng(W,a,0)==102 && ng(W,a,4)==fs){ has=1; }
          a=a+1;
        }
        if(has==0){
          r_mk_guide(W,fs,goal,ac,80);
          made=made+1;
          let seen:i32=0; let k:i32=0;
          while(k<wc){ if(get32(work,k*4)==fs){seen=1;} k=k+1; }
          if(seen==0 && wc<256){ set32(work,wc*4,fs); wc=wc+1; }
        }
      }
      t=t+1;
    }
    wi=wi+1;
  }
  return made;
}
// P-ACT3: null POLICY_ROOT -> CHOICE 0 always
fn t_r_pact3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s1:i32=r_mk_fact(W);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  return r_ptest("P-ACT3 null-root", c, 0);
}
// P-ACT1: W7-class planning. States s1->s2->s3, goal s3.
fn t_r_pact1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let s3:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(3*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,11); set32(tr,20,s3);
  set32(tr,24,s3); set32(tr,28,10); set32(tr,32,s3);
  let goal:i32=r_mk_goal(W,s3);
  let made:i32=r_derive_d1(W,ses,goal,s3,tr,3);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT1 s1->10", ev_act(W), 10);
  r_ctx_clear(W); ctx_push(W,s2);
  ok=ok & r_ptest("P-ACT1 s2->11", ev_act(W), 11);
  r_ctx_clear(W); ctx_push(W,s3);
  ok=ok & r_ptest("P-ACT1 s3->10", ev_act(W), 10);
  ok=ok & r_ptest("P-ACT1 3 guides", made, 3);
  return ok;
}
// P-ACT2: W6-class inquiry.
fn t_r_pact2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let q:i32=r_mk_fact(W);
  let d:i32=r_mk_fact(W);
  let u:i32=r_mk_uncert(W,q);
  let idx:i32=r_mk_fact(W);
  let g1:i32=r_mk_guide(W,u,idx,20,90);
  let g2:i32=r_mk_guide(W,d,idx,21,90);
  link_edge(W,idx,1,g1,0); link_edge(W,idx,1,g2,0);
  pol_set(W,idx);
  r_learn_confirm(W,ses,g1); r_learn_confirm(W,ses,g2);
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,u);
  ok=ok & r_ptest("P-ACT2 uncert->20", ev_act(W), 20);
  r_ctx_clear(W); ctx_push(W,d);
  ok=ok & r_ptest("P-ACT2 decoy->21", ev_act(W), 21);
  r_ctx_clear(W); ctx_push(W,q);
  ok=ok & r_ptest("P-ACT2 other->0", ev_act(W), 0);
  return ok;
}
// P-ACT4: structure ablation.
fn t_r_pact4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let tr:[]u8=z_alloc(2*12);
  set32(tr,0,s1); set32(tr,4,10); set32(tr,8,s2);
  set32(tr,12,s2); set32(tr,16,10); set32(tr,20,s2);
  let goal:i32=r_mk_goal(W,s2);
  r_derive_d1(W,ses,goal,s2,tr,2);
  pol_set(W,goal);
  let a:i32=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ r_learn_confirm(W,ses,a); }
    a=a+1;
  }
  let ok:i32=1;
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 pre s1->10", ev_act(W), 10);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==102){ ns(W,a,0,0); ns(W,a,36,0); }
    a=a+1;
  }
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT4 no-guides->0", ev_act(W), 0);
  a=2;
  while(a<1024){
    if(ng(W,a,36)==1 && ng(W,a,0)==0 && a!=goal){ ns(W,a,0,102); }
    a=a+1;
  }
  ns(W,goal,0,0);
  r_ctx_clear(W); ctx_push(W,s1);
  let c:i32=ev_act(W);
  ok=ok & r_ptest("P-ACT4 no-goal->0", c, 0);
  ok=ok & r_ptest("P-ACT4 fact-alive", ng(W,s1,0), 1);
  return ok;
}
// P-ACT5: generality (one handler, both classes).
fn t_r_pact5()i32 {
  let ok:i32=t_r_pact1();
  ok=ok & t_r_pact2();
  emit("P-ACT5 one-handler-both-classes: ");
  if(ok==1){ emit("PASS\n"); } else { emit("FAIL\n"); }
  return ok;
}
// P-ACT6: memory prerequisite (real 3-step eviction).
fn t_r_pact6()i32 {
  let ok:i32=1;
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let ses:i32=r_mk_fact(W);
  let s1:i32=r_mk_fact(W);
  let s2:i32=r_mk_fact(W);
  let goal:i32=r_mk_goal(W,s2);
  let g1:i32=r_mk_guide(W,s1,goal,10,80);
  pol_set(W,goal);
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A pre s1->10", ev_act(W), 10);
  let j:i32=0;
  while(j<60){
    let x:i32=r_mk_fact(W);
    if(x<0){ j=999; }
    j=j+1;
  }
  let nev:i32=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6A evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W); ctx_push(W,s1);
  ok=ok & r_ptest("P-ACT6A post->0", ev_act(W), 0);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ses=r_mk_fact(W2); s1=r_mk_fact(W2); s2=r_mk_fact(W2);
  goal=r_mk_goal(W2,s2);
  g1=r_mk_guide(W2,s1,goal,10,80);
  pol_set(W2,goal);
  r_learn_confirm(W2,ses,g1);
  r_learn_confirm(W2,ses,goal);
  link_edge(W2,ses,6,s1,0);
  link_edge(W2,ses,9,ses,1);
  j=0;
  while(j<60){
    let x:i32=r_mk_fact(W2);
    if(x<0){ j=999; }
    j=j+1;
  }
  nev=0;
  j=0;
  while(j<5){
    let v:i32=evict_node(W2);
    if(v<0){ j=999; } else { nev=nev+1; }
    j=j+1;
  }
  emit("P-ACT6B evicted "); e64(nev); emit(" nodes\n");
  r_ctx_clear(W2); ctx_push(W2,s1);
  ok=ok & r_ptest("P-ACT6B post s1->10", ev_act(W2), 10);
  return ok;
}
// pc_patch.zag -- persistent cross-domain connections (unfrozen pilot).
// Extends structural rebinding (adv_patch.zag) with a persistent link.
//
// On every verified rebind, write a LINK edge (type 14, unused in the
// frozen base) from the newly promoted MAP to the helper MAP whose shape
// was reused: "helper helped construct built". The link is written by the
// rebind success event itself; the driver never authors A-B relations.
//
// On later queries, rebind_try runs two passes:
//   Pass 1: MAPs with an outgoing type-14 edge (built via rebind before),
//           newest first. These are the learner's own prior successful
//           constructions.
//   Pass 2: all other MAPs in id order.
// Correctness is unchanged (execution verification still arbitrates);
// only the search order changes.
//
// pc_del_links: delete all type-14 edges (ablation: remove the connection,
// the speedup should disappear).
fn phase_a_enabled()i32 { return 1; }
// Walk a promoted graph root. If it is a pure chain
// (guard --true--> set --SEQ--> guard --true--> set ...),
// return the value-chain length plen = guards+1. Else -1.
// Verbatim from adv_patch.zag.
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}
// 1 if MAP m has an outgoing type-14 LINK edge (was built via rebind).
fn pc_is_linked(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// Delete all type-14 LINK edges. Ablation hook (driver-called).
fn pc_del_links(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Try one MAP's shape on the query. On verified success, promote the
// rebound and write the persistent LINK edge new -> helper.
fn pc_try_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        let j:i32=0;
        while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,v,plen,f);
        let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
        if(v2!=-2){
          let bm:i32=promote_graph(W,nr,s,r,v2,f,plen-1);
          if(bm>=0){link_edge(W,bm,14,m,0);}
          ans=v2;
        }
      }
      p=p+1;
    }
  }
  return ans;
}
fn rebind_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  // Pass 1: linked MAPs (prior successful rebinds), newest first.
  let m:i32=1023;
  while(m>=2 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==1){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m-1;
  }
  // Pass 2: all other MAPs in id order.
  m=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==0){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m+1;
  }
  return ans;
}
// un_patch.zag -- Unified composition: single operation replacing A/B/C.
//
// Architecture: C's iterative DFS over MAP compositions, with pluggable
// applicability predicates:
//   - C's principle: relation-sequence walkable from current value
//     (structural constraint satisfaction)
//   - A's principle: plen contract matches a real path from current value
//     (fallback when relseq extraction fails)
//   - B's principle: type-15 co-use history orders candidates and
//     accumulates from composition successes
//
// The 3-segment researcher cap is removed: DFS attempts up to 8 segments.
// A/B's pair-search machinery is deleted: arity is handled by DFS.
//
// On success segments are assembled, concatenated, verified, and promoted
// as MAP_Z with LINK14 provenance to each segment and type-15 co-use edges
// between consecutive segments. Runs in ev_query between rebind_try and trial.
// Zero modes, bridges, handlers, semantic cases.

// ---- config: 1 = composition enabled; 0 = NO-COMPOSE control (one-line diff)
fn compose_on()i32 { return 1; }

// Returns link count, or -1 if the promoted graph is not a pure
// guard/set chain or a licensing fact is missing/dead.
fn cc_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}

// Check whether MAP m's relation sequence is satisfiable starting from
// value cur in the fact store. On success fills vals[0..len] (value chain)
// and fids[0..len-1] (licensing fact ids). Returns len, else -1.
fn cc_satisfy(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let seq:[]u8=z_alloc(28);
  let len:i32=cc_relseq(W,m,seq,7);
  if(len<1){return -1;}
  set32(vals,0,cur);
  let i:i32=0;
  while(i<len){
    let rq:i32=get32(seq,i*4);
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),rq);
    if(fnd<0){return -1;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return len;
}

// Tail of a pure chain graph: the last SET cell.
fn cc_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root;
  let tail:i32=-1;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101){tail=cur; cur=seq_nx(W,cur);}
      else {cur=-2;}
    }
    steps=steps+1;
  }
  return tail;
}

// Contract of MAP m: plen of its chain graph, or -1 if not a chain MAP.
// Derived purely from MAP structure. Verbatim from A's patch.
fn cx_contract(W:[]u8,m:i32)i32 {
  if(ng(W,m,0)!=20){return -1;}
  if(ng(W,m,36)!=1){return -1;}
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  if(p<2){return -1;}
  return p;
}

// Write co-use LINK newM -> prevM (type 15). 1 if written.
// Verbatim from B's patch.
fn cb_couse_link(W:[]u8,newM:i32,prevM:i32)i32 {
  if(newM<0 || prevM<0 || newM==prevM){return 0;}
  if(ng(W,newM,0)!=20 || ng(W,prevM,0)!=20){return 0;}
  if(ng(W,newM,36)!=1 || ng(W,prevM,36)!=1){return 0;}
  link_edge(W,newM,15,prevM,0);
  return 1;
}

// newest live MAP id, -1 if none. Verbatim from B's patch.
fn cb_newest_map(W:[]u8)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){return m;}
    m=m-1;
  }
  return -1;
}

// ---- B's history as pluggable applicability predicate ----
// Returns 1 if a type-15 co-use edge exists from m to any MAP in
// used[0..nused-1] (m was used after that MAP before). This is B's
// selection principle: "used together before," consulted as a
// candidate-ordering signal, never a hardcoded gate.
fn cb_has_couse(W:[]u8,m:i32,used:[]u8,nused:i32)i32 {
  let u:i32=0;
  while(u<nused){
    let pm:i32=get32(used,u*4);
    let e:i32=0;
    while(e<4096){
      if(eg(W,e,4)==15 && eg(W,e,0)==m && eg(W,e,8)==pm){return 1;}
      e=e+1;
    }
    u=u+1;
  }
  return 0;
}

// ---- Unified satisfiability: C's constraint walk + A's contract fallback ----
// Tries C's relation-sequence walk first. If relseq extraction fails,
// falls back to A's plen-contract via path gather. Returns link count and
// fills vals[0..len] / fids[0..len-1], or -1 if neither applies.
fn un_satisfy(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let ln:i32=cc_satisfy(W,m,cur,vals,fids);
  if(ln>=1){return ln;}
  let p:i32=cx_contract(W,m);
  if(p<2 || p>8){return -1;}
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,cur,paths);
  let i:i32=0;
  while(i<np){
    let base:i32=i*48;
    if(get32(paths,base)==p){
      let j:i32=0;
      while(j<p){set32(vals,j*4,get32(paths,base+4+j*4)); j=j+1;}
      j=0;
      while(j<p-1){set32(fids,j*4,get32(paths,base+24+j*4)); j=j+1;}
      return p-1;
    }
    i=i+1;
  }
  return -1;
}

// ---- Unified candidates: OR admission, history-first ordering ----
// A MAP is admitted if un_satisfy succeeds (C's constraints OR A's contract).
// Ordering: historically co-used MAPs first (B's principle), then by
// decreasing length (fewer segments preferred), ties stable by MAP id.
fn un_candidates(W:[]u8,cur:i32,used:[]u8,nused:i32,candbuf:[]u8,lenbuf:[]u8,cousebuf:[]u8,base:i32)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024 && n<32){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let u:i32=0;
      let isused:i32=0;
      while(u<nused){
        if(get32(used,u*4)==m){isused=1;}
        u=u+1;
      }
      if(isused==0){
        let vb:[]u8=z_alloc(32);
        let fb:[]u8=z_alloc(28);
        let ln:i32=un_satisfy(W,m,cur,vb,fb);
        if(ln>=1){
          let co:i32=cb_has_couse(W,m,used,nused);
          let pos:i32=0;
          let found:i32=0;
          while(pos<n && found==0){
            let plo:i32=get32(lenbuf,(base+pos)*4);
            let pco:i32=get32(cousebuf,(base+pos)*4);
            if(co>pco){found=1;}
            else {
              if(co==pco && ln>plo){found=1;}
              else {pos=pos+1;}
            }
          }
          let s:i32=n;
          while(s>pos){
            set32(candbuf,(base+s)*4,get32(candbuf,(base+s-1)*4));
            set32(lenbuf,(base+s)*4,get32(lenbuf,(base+s-1)*4));
            set32(cousebuf,(base+s)*4,get32(cousebuf,(base+s-1)*4));
            s=s-1;
          }
          set32(candbuf,(base+pos)*4,m);
          set32(lenbuf,(base+pos)*4,ln);
          set32(cousebuf,(base+pos)*4,co);
          n=n+1;
        }
      }
    }
    m=m+1;
  }
  return n;
}

// Unified depth-first search over MAP compositions (max 8 segments).
// C's iterative DFS architecture. The 3-segment researcher cap is removed:
// the search now attempts up to 8 segments. Fills oseg (MAP ids),
// ovals (8 value slots per segment), ofids (7 fact slots per segment),
// olen (link counts). Returns segment count, or -1.
fn un_dfs(W:[]u8,s:i32,expected:i32,oseg:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8)i32 {
  let cand:[]u8=z_alloc(1024);
  let clen:[]u8=z_alloc(1024);
  let ccouse:[]u8=z_alloc(1024);
  let ncand:[]u8=z_alloc(32);
  let candi:[]u8=z_alloc(32);
  let curval:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(ncand,0,un_candidates(W,s,oseg,0,cand,clen,ccouse,0));
  set32(candi,0,0);
  let L:i32=0;
  let done:i32=0;
  let nseg:i32=-1;
  while(L>=0 && done==0){
    if(get32(candi,L*4)>=get32(ncand,L*4)){
      L=L-1;
      if(L>=0){set32(candi,L*4,get32(candi,L*4)+1);}
    } else {
      let m:i32=get32(cand,(L*32+get32(candi,L*4))*4);
      let vbuf:[]u8=z_alloc(32);
      let fbuf:[]u8=z_alloc(28);
      let ln:i32=un_satisfy(W,m,get32(curval,L*4),vbuf,fbuf);
      if(ln<1){
        set32(candi,L*4,get32(candi,L*4)+1);
      } else {
        set32(oseg,L*4,m);
        set32(olen,L*4,ln);
        let j:i32=0;
        while(j<=ln){set32(ovals,(L*8+j)*4,get32(vbuf,j*4)); j=j+1;}
        j=0;
        while(j<ln){set32(ofids,(L*7+j)*4,get32(fbuf,j*4)); j=j+1;}
        let nv:i32=get32(vbuf,ln*4);
        if(nv==expected){
          nseg=L+1;
          done=1;
        } else {
          if(L+1>=8){
            set32(candi,L*4,get32(candi,L*4)+1);
          } else {
            set32(curval,(L+1)*4,nv);
            set32(ncand,(L+1)*4,un_candidates(W,nv,oseg,L+1,cand,clen,ccouse,(L+1)*32));
            set32(candi,(L+1)*4,0);
            L=L+1;
          }
        }
      }
    }
  }
  return nseg;
}

// Unified composition for query (s,r,expected).
// Single operation replacing A/B/C's three engines. Uses un_dfs with
// pluggable applicability (C's constraints OR A's contracts, B's history
// for ordering). On success promotes MAP_Z with LINK14 provenance to each
// segment and writes type-15 co-use edges between consecutive segments so
// B's history accumulates from composition successes.
fn compose_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(expected<0){return -2;}
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(256);
  let ofids:[]u8=z_alloc(224);
  let olen:[]u8=z_alloc(32);
  let nseg:i32=un_dfs(W,s,expected,oseg,ovals,ofids,olen);
  if(nseg<1){
    emit("COMP-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(32);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W,full,s,expected,masked,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(288);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*4),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      let w1:i32=cb_couse_link(W,get32(oseg,g*4),get32(oseg,(g-1)*4));
      g=g+1;
    }
  }
  emit("COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*4)); g=g+1;}
  emit("\n");
  return v2;
}

// ev_query with unified composition hooked between rebind_try and trial.
// Compose stats fold into the shared rbs buffer so hg(W,16) reports
// rebind+compose totals honestly.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- unified composition: DFS over pluggable applicability ----
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// Chained query for co-use episodes. chain=0 starts an episode; chain=1
// links this query's promoted MAP to the previous step's MAP via a
// type-15 co-use edge. prevM tracked in header 56 (free; init zeroed,
// -1 = none). Returns the query answer (-2 on miss).
// The LINK is written by this success event; the driver supplies only the
// queries, never the endpoints. Verbatim from B's patch.
fn ev_cq(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,chain:i32)i32 {
  let m0:i32=cb_newest_map(W);
  let ans:i32=ev_query(W,s,r,expected,flags);
  if(ans==-2){return -2;}
  let m1:i32=cb_newest_map(W);
  if(m1<0 || m1==m0){return ans;}
  if(chain==1){
    let prev:i32=hg(W,56);
    cb_couse_link(W,m1,prev);
  }
  hs(W,56,m1);
  return ans;
}
// xs5_patch.zag -- XP-SELECT-5: PATH-COVERAGE selector {TRUNCATE, REROUTE}.
//
// X = learned navigation route (chain MAP, relseq [81]xL).
// Y = learned aggregation (count MAP, INC cells; r_agg from type-1 provenance).
// Z = navigate-then-aggregate, query (s,93,count).
//
// Exact pipeline: value-level composition (xs5_compose). Function types are
// structural over learner state (cc_relseq extractable = NAV; INC cell
// present = aggregation capability), not researcher modes. Ordered pairs
// (NAV,AGG) then (AGG,NAV) are tried, not given.
//
// XS5-SELECT fires once per query after the standard pipeline fails.
// Phase 1: TRUNCATE (longest licensed prefix) then REROUTE (one store-read
// substitute hop, r_alt != learned hop relation) per native NAV MAP.
// License (expected-free): Y's count template runs on the adapted endpoint.
// Phase 2: re-run the UNCHANGED xs5_compose once.
//
// Pure Zag. Unfrozen only. 0 new edge/MAP types, 0 opcodes, 0 modes.

// ---- config: 1 = selection enabled; 0 = NO-ADAPT control (one-line diff)
fn adapt_on()i32 { return 1; }

// 1 if the graph rooted at root contains an INC cell (tag 103).
fn xs5_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}

// Live count MAP id, or -1.
fn xs5_find_countmap(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Y's aggregation relation from the count MAP's type-1 provenance edges.
// Learner-derived, never hardcoded. -1 if no count MAP or no provenance.
fn xs5_agg_rel(W:[]u8)i32 {
  let cm:i32=xs5_find_countmap(W);
  if(cm<0){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==cm && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=2 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// 1 if m is a NAV MAP (pure chain: relseq extractable).
fn xs5_is_navmap(W:[]u8,m:i32)i32 {
  let seq:[]u8=z_alloc(28);
  if(cc_relseq(W,m,seq,7)>=1){return 1;}
  return 0;
}

// Execute NAV MAP m on subject s via its relseq. Endpoint or -2.
fn xs5_nav_exec(W:[]u8,m:i32,s:i32)i32 {
  let vals:[]u8=z_alloc(32); let fids:[]u8=z_alloc(28);
  let ln:i32=cc_satisfy(W,m,s,vals,fids);
  if(ln<1){return -2;}
  return get32(vals,ln*4);
}

// Execute aggregation count on s over r_agg. Count or -2.
fn xs5_agg_exec(W:[]u8,s:i32,r_agg:i32)i32 {
  if(r_agg<0){return -2;}
  if(xs5_find_countmap(W)<0){return -2;}
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s,r_agg,v,f);
  if(len<2){return -2;}
  let root:i32=t2_asm_count(W,v,len,f);
  if(root<0){return -2;}
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  return t2_try_verify(W,root,s,-1,1,st);
}

// Try one (NAV,AGG) pair. Promote MAP_Z on verification. v or -2.
fn xs5_try_nav_agg(W:[]u8,m:i32,s:i32,r:i32,expected:i32,r_agg:i32)i32 {
  let e:i32=xs5_nav_exec(W,m,s);
  if(e==-2){return -2;}
  let v:i32=xs5_agg_exec(W,e,r_agg);
  if(v==-2){return -2;}
  if(v!=expected){return -2;}
  let facts:[]u8=z_alloc(8);
  let zm:i32=promote_graph(W,-1,s,r,v,facts,0);
  if(zm>=0){
    link_edge(W,zm,14,m,0);
    let cm:i32=xs5_find_countmap(W);
    if(cm>=0){link_edge(W,zm,14,cm,0);}
  }
  emit("XS5-COMPOSE ok nav="); e64(m); emit(" zm="); e64(zm); emit("\n");
  return v;
}

// Exact value-level composition. Ordered pairs tried, not given.
fn xs5_compose(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let r_agg:i32=xs5_agg_rel(W);
  let m:i32=2;
  let ans:i32=-2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xs5_is_navmap(W,m)==1){
      ans=xs5_try_nav_agg(W,m,s,r,expected,r_agg);
    }
    m=m+1;
  }
  if(ans!=-2){return ans;}
  // (AGG,NAV): symmetric try. Vacuous in practice (a count is not a
  // walkable nav subject), kept for ordered-pair symmetry.
  let v0:i32=xs5_agg_exec(W,s,r_agg);
  if(v0!=-2){
    let m2:i32=2;
    while(m2<1024 && ans==-2){
      if(ng(W,m2,36)==1 && ng(W,m2,0)==20 && xs5_is_navmap(W,m2)==1){
        let e2:i32=xs5_nav_exec(W,m2,v0);
        if(e2==expected){ans=e2;}
      }
      m2=m2+1;
    }
  }
  if(ans==-2){emit("XS5-COMPOSE fail\n");}
  return ans;
}

// Promote an adapted MAP. Layout identical to promote_graph, but teaches
// NO fact: mid-query scaffolding is not a verified query answer.
fn xs5_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  return m;
}

// 1 if MAP m has an outgoing type-16 edge (is adapted).
fn xs5_has_type16_out(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==16){return 1;}
    e=e+1;
  }
  return 0;
}

// 1 if MAP m's relseq equals seq[0..len-1].
fn xs5_relseq_eq(W:[]u8,m:i32,seq:[]u8,len:i32)i32 {
  let ms:[]u8=z_alloc(28);
  let ml:i32=cc_relseq(W,m,ms,7);
  if(ml!=len){return 0;}
  let i:i32=0;
  while(i<len){
    if(get32(ms,i*4)!=get32(seq,i*4)){return 0;}
    i=i+1;
  }
  return 1;
}

// 1 if any live MAP already carries exactly relseq seq[0..len-1].
fn xs5_dedup(W:[]u8,seq:[]u8,len:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_relseq_eq(W,m,seq,len)==1){return 1;}
    }
    m=m+1;
  }
  return 0;
}

// Walk seq[0..len-1] from s via t2_lu_first. Fill vals/fids. 1 if full.
fn xs5_walk_seq(W:[]u8,s:i32,seq:[]u8,len:i32,vals:[]u8,fids:[]u8)i32 {
  set32(vals,0,s);
  let i:i32=0;
  while(i<len){
    let rq:i32=get32(seq,i*4);
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),rq);
    if(fnd<0){return 0;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return 1;
}

// Lowest-id live fact (u, r_alt, w) with r_alt != r_learned,
// r_alt != r_agg (no reroute into Y's aggregation relation), and
// r_alt != -999. -1 if none.
fn xs5_alt_fact(W:[]u8,u:i32,r_learned:i32,r_agg:i32)i32 {
  let f:i32=2;
  while(f<1024){
    if(ng(W,f,36)==1 && ng(W,f,0)==1 && ng(W,f,20)==u){
      let ra:i32=ng(W,f,24);
      if(ra!=r_learned && ra!=r_agg && ra!=-999){return f;}
    }
    f=f+1;
  }
  return -1;
}

// TRUNCATE: longest licensed proper prefix of m's relseq.
// Returns adapted MAP id or -1.
fn xs5_truncate(W:[]u8,m:i32,s:i32,seq:[]u8,L:i32,r_agg:i32)i32 {
  let lp:i32=L-1;
  while(lp>=1){
    if(xs5_dedup(W,seq,lp)==0){
      let vals:[]u8=z_alloc(32); let fids:[]u8=z_alloc(28);
      if(xs5_walk_seq(W,s,seq,lp,vals,fids)==1){
        let e:i32=get32(vals,lp*4);
        if(xs5_agg_exec(W,e,r_agg)!=-2){
          let root:i32=t2_asm_chain(W,vals,lp+1,fids);
          if(root>=0){
            let am:i32=xs5_promote(W,root,s,ng(W,m,4),e,fids,lp);
            if(am>=0){
              link_edge(W,am,16,m,0);
              emit("ADAPT-MK id="); e64(am);
              emit(" src="); e64(m);
              emit(" op=TRUNCATE\n");
              return am;
            }
          }
        }
      }
    }
    lp=lp-1;
  }
  return -1;
}

// REROUTE: substitute hop i with a store-read alternative relation,
// truncating after. Returns adapted MAP id or -1.
fn xs5_reroute(W:[]u8,m:i32,s:i32,seq:[]u8,L:i32,r_agg:i32)i32 {
  let i:i32=0;
  while(i<L){
    let vals:[]u8=z_alloc(32); let fids:[]u8=z_alloc(28);
    if(xs5_walk_seq(W,s,seq,i,vals,fids)==0){return -1;}
    let u:i32=get32(vals,i*4);
    let r_learned:i32=get32(seq,i*4);
    let af:i32=xs5_alt_fact(W,u,r_learned,r_agg);
    if(af>=0){
      let r_alt:i32=ng(W,af,24);
      let w:i32=ng(W,af,28);
      let cseq:[]u8=z_alloc(28);
      let k:i32=0;
      while(k<i){set32(cseq,k*4,get32(seq,k*4)); k=k+1;}
      set32(cseq,i*4,r_alt);
      let clen:i32=i+1;
      if(xs5_dedup(W,cseq,clen)==0){
        if(xs5_agg_exec(W,w,r_agg)!=-2){
          let cvals:[]u8=z_alloc(32); let cfids:[]u8=z_alloc(28);
          let j:i32=0;
          while(j<=i){set32(cvals,j*4,get32(vals,j*4)); j=j+1;}
          set32(cvals,(i+1)*4,w);
          j=0;
          while(j<i){set32(cfids,j*4,get32(fids,j*4)); j=j+1;}
          set32(cfids,i*4,af);
          let root:i32=t2_asm_chain(W,cvals,clen+1,cfids);
          if(root>=0){
            let am:i32=xs5_promote(W,root,s,ng(W,m,4),w,cfids,clen);
            if(am>=0){
              link_edge(W,am,16,m,0);
              emit("ADAPT-MK id="); e64(am);
              emit(" src="); e64(m);
              emit(" op=REROUTE\n");
              return am;
            }
          }
        }
      }
    }
    i=i+1;
  }
  return -1;
}

// XS5-SELECT: Phase 1 adaptation, Phase 2 unchanged xs5_compose re-run.
fn xs5_select(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  if(adapt_on()==0){return -2;}
  emit("XS5-TRY s="); e64(s); emit("\n");
  let r_agg:i32=xs5_agg_rel(W);
  if(r_agg<0){
    emit("XS5-NOAGG\n");
    return -2;
  }
  let n_adapt:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xs5_has_type16_out(W,m)==0){
      let seq:[]u8=z_alloc(28);
      let L:i32=cc_relseq(W,m,seq,7);
      if(L>=2){
        let t:i32=xs5_truncate(W,m,s,seq,L,r_agg);
        if(t>=0){n_adapt=n_adapt+1;}
        let dr:i32=xs5_reroute(W,m,s,seq,L,r_agg);
        if(dr>=0){n_adapt=n_adapt+1;}
      }
    }
    m=m+1;
  }
  emit("XS5-CREATED n="); e64(n_adapt); emit("\n");
  if(n_adapt>0){
    return xs5_compose(W,s,r,expected);
  }
  return -2;
}

// Query pipeline: activate -> rebind -> xs5_compose -> trial ->
// bootstrap -> XS5-SELECT -> xs5_compose re-run (inside select).
fn ev_query_xs5(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let ca:i32=xs5_compose(W,s,r,expected);
  if(ca!=-2){
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  let sa:i32=xs5_select(W,s,r,expected);
  if(sa!=-2){log_ev(W,2,s,r,sa,1,0,0); return sa;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// xhier_patch.zag -- XP-HIER-1: hierarchical composition.
//
// Level 1 (frozen): XS5-SELECT + xs5_compose form MAP_Z (LINK14 to an
// adapted NAV MAP and to MAP_Y). This patch adds the recursive slot:
// xhier_compose tries (NAV, MAP_Z) pairs, executing the MAP_Z through
// its LINK14 structure (one structural recursion level) with the
// frozen xs5_nav_exec / xs5_agg_exec. The composition operation
// itself (promote_graph + LINK14 edges) is unchanged; only the second
// input may now be a MAP_Z.
//
// Type discipline: composition is (node->node, node->count). A MAP_Z
// executes as node->count, so it is well-typed ONLY in the second
// slot and is excluded from the NAV slot.
//
// Pure Zag. Unfrozen only. 0 new edge types (14 reused), 0 new MAP
// types (tag 20 via the frozen promote_graph call shape), 0 opcodes,
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.

// 1 if edge e is (z -14-> target).
fn xhier_edge14(W:[]u8,e:i32,z:i32)i32 {
  if(eg(W,e,0)!=z){return 0;}
  if(eg(W,e,4)!=14){return 0;}
  return 1;
}

// 1 if t is live and NAV-executable (chain MAP). Requires tag-20 so
// that fact/atom nodes (whose field-20 can spuriously decode as a
// chain root) are never treated as NAV MAPs.
fn xhier_nav_ok(W:[]u8,t:i32)i32 {
  if(ng(W,t,36)!=1){return 0;}
  if(ng(W,t,0)!=20){return 0;}
  if(xs5_is_navmap(W,t)!=1){return 0;}
  return 1;
}

// 1 if t is a live count MAP (aggregation capability).
fn xhier_agg_ok(W:[]u8,t:i32)i32 {
  if(ng(W,t,36)!=1){return 0;}
  if(ng(W,t,0)!=20){return 0;}
  if(xs5_has_inc(W,ng(W,t,20))!=1){return 0;}
  return 1;
}

// 1 if z is a MAP_Z: live tag-20 composition product with at least
// one outgoing type-14 edge and no chain relseq of its own.
fn xhier_is_mapz(W:[]u8,z:i32)i32 {
  if(ng(W,z,36)!=1){return 0;}
  if(ng(W,z,0)!=20){return 0;}
  let e:i32=0;
  let has14:i32=0;
  while(e<4096){
    if(xhier_edge14(W,e,z)==1){has14=1;}
    e=e+1;
  }
  if(has14==0){return 0;}
  let seq:[]u8=z_alloc(28);
  if(cc_relseq(W,z,seq,7)>=1){return 0;}
  return 1;
}

// First live NAV-executable outgoing type-14 target of z, or -1.
fn xhier_mapz_nav(W:[]u8,z:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(xhier_edge14(W,e,z)==1){
      let t:i32=eg(W,e,8);
      if(xhier_nav_ok(W,t)==1){return t;}
    }
    e=e+1;
  }
  return -1;
}

// First live count-MAP outgoing type-14 target of z, or -1.
fn xhier_mapz_agg(W:[]u8,z:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(xhier_edge14(W,e,z)==1){
      let t:i32=eg(W,e,8);
      if(xhier_agg_ok(W,t)==1){return t;}
    }
    e=e+1;
  }
  return -1;
}

// Aggregation relation from count MAP m's own type-1 provenance
// edges. Same read shape as xs5_agg_rel, parameterized by the MAP
// id instead of the world-global singleton. -1 if unreadable.
fn xhier_mapz_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=2 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// Recursive MAP_Z execution: navigate the NAV part, aggregate at
// the endpoint with the frozen executors. The aggregation relation
// is read from the composite's OWN type-14 count MAP (the address
// formation recorded at compose time), not the world-global
// singleton. v or -2; loud -2 when the carried address or its
// relation is unusable.
fn xhier_exec(W:[]u8,z:i32,s:i32)i32 {
  let n:i32=xhier_mapz_nav(W,z);
  if(n<0){return -2;}
  let a:i32=xhier_mapz_agg(W,z);
  if(a<0){emit("XHIER-EXEC-NOAGG z="); e64(z); emit("\n"); return -2;}
  let e:i32=xs5_nav_exec(W,n,s);
  if(e==-2){return -2;}
  let r_agg:i32=xhier_mapz_rel(W,a);
  if(r_agg<0){emit("XHIER-EXEC-NOREL a="); e64(a); emit("\n"); return -2;}
  return xs5_agg_exec(W,e,r_agg);
}

// Try one (NAV, MAP_Z) pair. Promote Z2 on verification. z2 id or -1.
fn xhier_try_pair(W:[]u8,m:i32,zz:i32,s:i32,r:i32,expected:i32)i32 {
  let e:i32=xs5_nav_exec(W,m,s);
  if(e==-2){return -1;}
  let v:i32=xhier_exec(W,zz,e);
  if(v!=expected){return -1;}
  let facts:[]u8=z_alloc(8);
  let z2:i32=promote_graph(W,-1,s,r,v,facts,0);
  if(z2<0){return -1;}
  link_edge(W,z2,14,m,0);
  link_edge(W,z2,14,zz,0);
  emit("XHIER-COMPOSE ok nav="); e64(m);
  emit(" z="); e64(zz);
  emit(" z2="); e64(z2); emit("\n");
  return z2;
}

// Try every MAP_Z in the snapshot against NAV MAP m. expected or -2.
fn xhier_try_all_z(W:[]u8,m:i32,zs:[]u8,nz:i32,s:i32,r:i32,expected:i32)i32 {
  let zi:i32=0;
  while(zi<nz){
    let zz:i32=get32(zs,zi*4);
    let z2:i32=xhier_try_pair(W,m,zz,s,r,expected);
    if(z2>=0){return expected;}
    zi=zi+1;
  }
  return -2;
}

// Hierarchical composition: (NAV, MAP_Z) pairs only. expected or -2.
fn xhier_compose(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let zs:[]u8=z_alloc(64);
  let nz:i32=0;
  let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){
      if(nz<16){set32(zs,nz*4,z); nz=nz+1;}
    }
    z=z+1;
  }
  if(nz==0){emit("XHIER-NOMAPZ\n"); return -2;}
  let m:i32=2;
  let ans:i32=-2;
  while(m<1024 && ans==-2){
    let mz:i32=xhier_is_mapz(W,m);
    if(xhier_nav_ok(W,m)==1){
      if(mz==0){
        ans=xhier_try_all_z(W,m,zs,nz,s,r,expected);
      }
    }
    m=m+1;
  }
  if(ans==-2){emit("XHIER-COMPOSE fail\n");}
  return ans;
}

// Query pipeline: exact stages, then the hierarchical composer last.
fn ev_query_xhier(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let ca:i32=xs5_compose(W,s,r,expected);
  if(ca!=-2){
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  let ha:i32=xhier_compose(W,s,r,expected);
  if(ha!=-2){log_ev(W,2,s,r,ha,1,0,0); return ha;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// bp2_learner.zag -- BP-2 belief layer (BELIEF-PROVENANCE DESIGN.md R1-R7).
//
// Learner-owned belief table: 8 u8 fields per node id (0..1023):
//   0=b_sup 1=b_conf 2=b_disc 3=b_rev 4=b_ext 5=b_self 6=d_self 7=formed
// `formed` is the live type-1 licensing count at R1, referenced by R4.
// Belief kinds are derived from structure shape (B-STRUCT vs B-COMP via
// the iscomp flag), never stored as labels.
//
// 0 new edge types (1/14/3 only), 0 new node types, 0 modes, 0 bridges,
// 0 handlers, 0 semantic cases. Every rule references only node
// liveness, edge types, integer counts, field8/field4 equality, and
// the field16 external/self partition. No relation is interpreted.

// Count live tag-1 type-1 licensing targets of mid.
// out[0]=live total; out[1]=ext (field16 1/2/5); out[2]=self (3/4/6).
fn bp2_lic_live(W:[]u8,mid:i32,out:[]u8)void {
  let live:i32=0; let ne:i32=0; let nself:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        live=live+1;
        let st:i32=ng(W,f,16);
        if(st==1 || st==2 || st==5){ne=ne+1;}
        if(st==3 || st==4 || st==6){nself=nself+1;}
      }
    }
    e=e+1;
  }
  set32(out,0,live); set32(out,4,ne); set32(out,8,nself);
  return;
}

// R1 formation. iscomp=0: B-STRUCT (licensing set from type-1 edges).
// iscomp=1: B-COMP (no type-1 licensing of its own; support via R6).
fn bp2_form(W:[]u8,bt:[]u8,hasb:[]u8,mid:i32,iscomp:i32)void {
  let base:i32=100; let one:i32=1; let zero:i32=0;
  let full:i32=255;
  let o:i32=mid*8;
  let ne:i32=0; let nself:i32=0; let formed:i32=0;
  if(iscomp==0){
    let out:[]u8=z_alloc(12);
    bp2_lic_live(W,mid,out);
    ne=get32(out,4); nself=get32(out,8); formed=get32(out,0);
  }
  bt[o]=base as u8; bt[o+1]=one as u8; bt[o+2]=zero as u8;
  bt[o+3]=zero as u8; bt[o+4]=ne as u8; bt[o+5]=nself as u8;
  bt[o+6]=full as u8; bt[o+7]=formed as u8;
  hasb[mid]=one as u8;
  return;
}

// R2 confirmation. indep=1: disjoint licensing set (INC_HI); else INC_LO.
fn bp2_confirm(bt:[]u8,mid:i32,indep:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32;
  if(indep==1){s=s+20;} else {s=s+10;}
  if(s>255){s=255;}
  bt[o]=s as u8;
  let c:i32=bt[o+1] as i32;
  if(c<255){c=c+1;}
  bt[o+1]=c as u8;
  let zero:i32=0;
  bt[o+2]=zero as u8;
  return;
}

// R3 disconfirmation (implemented; not triggered in the BP-2 arms).
fn bp2_disconfirm(bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32 - 20;
  if(s<0){s=0;}
  bt[o]=s as u8;
  let d:i32=bt[o+2] as i32;
  if(d<255){d=d+1;}
  bt[o+2]=d as u8;
  let zero:i32=0;
  bt[o+1]=zero as u8;
  return;
}

// R5 revision (implemented; not triggered in the BP-2 arms).
fn bp2_revise(bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32 / 2;
  bt[o]=s as u8;
  let r:i32=bt[o+3] as i32;
  if(r<255){r=r+1;}
  bt[o+3]=r as u8;
  let zero:i32=0;
  bt[o+1]=zero as u8; bt[o+2]=zero as u8;
  return;
}

// Retirement: kind-3 self-edge with the reason in field12 (the P10
// convention: kind 3 = RETIRE, field12 = reason); b_sup=0. The record
// persists as retired; the node stays live.
fn bp2_retire(W:[]u8,bt:[]u8,mid:i32,reason:i32)void {
  link_edge(W,mid,3,mid,reason);
  let zero:i32=0;
  bt[mid*8]=zero as u8;
  return;
}

// 1 if any kind-3 self-edge exists on mid.
fn bp2_has_k3(W:[]u8,mid:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==3 && eg(W,e,8)==mid){return 1;}
    e=e+1;
  }
  return 0;
}

// 1 if a kind-3 self-edge with field12==reason exists on mid.
fn bp2_has_k3r(W:[]u8,mid:i32,reason:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==3 && eg(W,e,8)==mid && eg(W,e,12)==reason){return 1;}
    e=e+1;
  }
  return 0;
}

// R4 licensing change. Literal DESIGN.md 3.2 formula: the current
// b_sup scales by live/formed (compounding across calls); live=0
// retires with reason 2 (provenance-death).
fn bp2_relicense(W:[]u8,bt:[]u8,mid:i32)void {
  let o:i32=mid*8;
  let formed:i32=bt[o+7] as i32;
  if(formed<=0){return;}
  let out:[]u8=z_alloc(12);
  bp2_lic_live(W,mid,out);
  let live:i32=get32(out,0);
  if(live==0){bp2_retire(W,bt,mid,2); return;}
  let s:i32=bt[o] as i32;
  s=s*live/formed;
  bt[o]=s as u8;
  bt[o+4]=get32(out,4) as u8;
  bt[o+5]=get32(out,8) as u8;
  return;
}

// R6 propagation: composite z becomes the min over its live type-14
// targets that hold belief records. Min 0 retires z with reason 2.
// Returns the min (255 when no recorded target).
fn bp2_propagate(W:[]u8,bt:[]u8,hasb:[]u8,z:i32)i32 {
  let m:i32=255;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==z && eg(W,e,4)==14){
      let c:i32=eg(W,e,8);
      if(c>=0 && ng(W,c,36)==1 && (hasb[c] as i32)==1){
        let s:i32=bt[c*8] as i32;
        if(s<m){m=s;}
      }
    }
    e=e+1;
  }
  if(m<255){
    bt[z*8]=m as u8;
    if(m==0){bp2_retire(W,bt,z,2);}
  }
  return m;
}

// Effective support for selection.
fn bp2_eff(bt:[]u8,mid:i32)i32 {
  let o:i32=mid*8;
  let s:i32=bt[o] as i32;
  let ne:i32=bt[o+4] as i32;
  let nself:i32=bt[o+5] as i32;
  if(ne+nself==0){return s;}
  let d:i32=bt[o+6] as i32;
  return s*(ne*255+d*nself)/(255*(ne+nself));
}

// R7 selection. Exact tie at the top, or max eff < bar, returns -3.
fn bp2_select(bt:[]u8,hasb:[]u8,cands:[]u8,nc:i32,bar:i32)i32 {
  let best:i32=-3; let beff:i32=-1; let tie:i32=0;
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if((hasb[m] as i32)==1){
      let e:i32=bp2_eff(bt,m);
      if(e>beff){beff=e; best=m; tie=0;}
      else{if(e==beff){tie=1;}}
    }
    i=i+1;
  }
  if(best==-3){return -3;}
  if(tie==1){return -3;}
  if(beff<bar){return -3;}
  return best;
}

// Plain liveness-gating baseline (the kill-criterion control): first
// live candidate, or -1. Existence implies endorsement.
fn bp2_lgsel(W:[]u8,cands:[]u8,nc:i32)i32 {
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if(ng(W,m,36)==1){return m;}
    i=i+1;
  }
  return -1;
}

// Tombstone the first live tag-1 type-1 provenance target of mid
// (frozen ns 0/36 pattern). Returns the fact id, or -1.
fn bp2_kill_one_prov(W:[]u8,mid:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        ns(W,f,0,0); ns(W,f,36,0);
        return f;
      }
    }
    e=e+1;
  }
  return -1;
}

// Edge census: number of edges with from==n.
fn bp2_census(W:[]u8,n:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Bar adjustment rule (implemented; not triggered in the BP-2 arms:
// R7 selections are measured, never fed back as commitment outcomes).
// confirmed=1: disconfirmed commitment -> bar+1; else if eff>=2*bar:
// confirmed commitment far above bar -> bar-1 floored at MIN_BAR.
fn bp2_bar_after(bar:i32,confirmed:i32,eff:i32)i32 {
  if(confirmed==1){return bar+1;}
  if(eff>=bar*2){
    let nb:i32=bar-1;
    if(nb<10){nb=10;}
    return nb;
  }
  return bar;
}
// bp3_driver.zag -- BP-3 battery driver.
//
// FP6: domain-blindness (three permuted W2-style worlds).
// FP7a: core abstention (W7a, both rivals degraded below bar).
// FP7b: does abstention help (W7b Seq D, W7c Seq C, bar=30 contrast).
// Kill bars from the frozen PREREG.md. Verdict BP-3-PASS/FAIL.
// Pure Zag. bp2_learner.zag reused verbatim; frozen block ops
// reused verbatim, never redefined. bp3_force is a test-harness
// baseline policy, not belief machinery.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp3_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp3_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp3_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// First live count-MAP id != excl, or -1.
fn bp3_other_countmap(W:[]u8,excl:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(m!=excl && ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Highest live count-MAP id, or -1.
fn bp3_max_countmap(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){best=m;}
    }
    m=m+1;
  }
  return best;
}

// The single MAP_Z id, or -1 unless exactly one exists.
fn bp3_only_mapz(W:[]u8)i32 {
  let found:i32=-1; let n:i32=0; let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){n=n+1; found=z;}
    z=z+1;
  }
  if(n==1){return found;}
  return -1;
}

// First live tag-1 type-1 provenance target's relation, or -1.
fn bp3_prov_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// Opaque relabeling bijection. pm=0 identity; pm=1 offset
// (order-preserving); pm=2 reflection (order-reversing).
fn bp3_perm(x:i32,pm:i32)i32 {
  if(pm==1){return x+100000;}
  if(pm==2){return 1000000-x;}
  return x;
}

// Build the frozen XHIER-COUNTMAP-FIX world on W with every
// entity/relation literal relabeled by bp3_perm(.,pm).
// Structural parameters are NOT permuted (counts, flags, modes,
// node ids, promote ans=4 which is the structural xhier_exec
// count). The nav query expected IS permuted: it is the nav
// terminal entity value (XF PREREG: ev_query_xs5(11,91,14)->14).
// out: 0=my 4=mv2 8=mv3 12=navx 16=mz1 20=mz2 24=mz3.
fn bp3_build(W:[]u8,out:[]u8,pm:i32,mkz3:i32)void {
  ev_teach(W,bp3_perm(11,pm),bp3_perm(81,pm),bp3_perm(12,pm));
  ev_teach(W,bp3_perm(12,pm),bp3_perm(81,pm),bp3_perm(13,pm));
  ev_teach(W,bp3_perm(13,pm),bp3_perm(81,pm),bp3_perm(14,pm));
  ev_query_xs5(W,bp3_perm(11,pm),bp3_perm(91,pm),bp3_perm(14,pm),0);
  ev_teach(W,bp3_perm(50,pm),bp3_perm(82,pm),bp3_perm(51,pm));
  ev_teach(W,bp3_perm(51,pm),bp3_perm(82,pm),bp3_perm(52,pm));
  ev_teach(W,bp3_perm(52,pm),bp3_perm(82,pm),bp3_perm(53,pm));
  ev_query_xs5(W,bp3_perm(50,pm),bp3_perm(92,pm),3,0);
  let i:i32=0;
  while(i<30){
    ev_teach(W,bp3_perm(5000+i,pm),bp3_perm(60+(i%10),pm),bp3_perm(6000+i,pm));
    i=i+1;
  }
  let my:i32=xs5_find_countmap(W);
  set32(out,0,my);
  ev_teach(W,bp3_perm(110,pm),bp3_perm(85,pm),bp3_perm(111,pm));
  ev_teach(W,bp3_perm(111,pm),bp3_perm(85,pm),bp3_perm(112,pm));
  ev_teach(W,bp3_perm(112,pm),bp3_perm(85,pm),bp3_perm(113,pm));
  ev_teach(W,bp3_perm(113,pm),bp3_perm(85,pm),bp3_perm(114,pm));
  ev_query_xs5(W,bp3_perm(110,pm),bp3_perm(117,pm),4,0);
  let mv2:i32=bp3_other_countmap(W,my);
  set32(out,4,mv2);
  ev_teach(W,bp3_perm(120,pm),bp3_perm(87,pm),bp3_perm(121,pm));
  ev_teach(W,bp3_perm(121,pm),bp3_perm(87,pm),bp3_perm(122,pm));
  ev_teach(W,bp3_perm(122,pm),bp3_perm(87,pm),bp3_perm(123,pm));
  ev_teach(W,bp3_perm(123,pm),bp3_perm(87,pm),bp3_perm(124,pm));
  ev_query_xs5(W,bp3_perm(120,pm),bp3_perm(118,pm),4,0);
  let mv3:i32=bp3_max_countmap(W);
  set32(out,8,mv3);
  ev_teach(W,bp3_perm(14,pm),bp3_perm(82,pm),bp3_perm(40,pm));
  ev_teach(W,bp3_perm(40,pm),bp3_perm(82,pm),bp3_perm(41,pm));
  xs5_compose(W,bp3_perm(11,pm),bp3_perm(94,pm),2);
  let mz1:i32=bp3_only_mapz(W);
  set32(out,16,mz1);
  let navx:i32=xhier_mapz_nav(W,mz1);
  set32(out,12,navx);
  ev_teach(W,bp3_perm(14,pm),bp3_perm(87,pm),bp3_perm(60,pm));
  ev_teach(W,bp3_perm(60,pm),bp3_perm(87,pm),bp3_perm(61,pm));
  ev_teach(W,bp3_perm(61,pm),bp3_perm(87,pm),bp3_perm(62,pm));
  ev_teach(W,bp3_perm(62,pm),bp3_perm(87,pm),bp3_perm(63,pm));
  ev_teach(W,bp3_perm(14,pm),bp3_perm(85,pm),bp3_perm(30,pm));
  ev_teach(W,bp3_perm(30,pm),bp3_perm(85,pm),bp3_perm(31,pm));
  ev_teach(W,bp3_perm(31,pm),bp3_perm(85,pm),bp3_perm(32,pm));
  let pf:[]u8=z_alloc(8);
  let mz2:i32=promote_graph(W,-1,bp3_perm(11,pm),bp3_perm(93,pm),4,pf,0);
  link_edge(W,mz2,14,navx,0);
  link_edge(W,mz2,14,mv3,0);
  set32(out,20,mz2);
  let mz3:i32=-1;
  if(mkz3==1){
    mz3=promote_graph(W,-1,bp3_perm(11,pm),bp3_perm(93,pm),4,pf,0);
    link_edge(W,mz3,14,navx,0);
    link_edge(W,mz3,14,mv2,0);
  }
  set32(out,24,mz3);
  ns(W,my,0,0); ns(W,my,36,0);
  return;
}

// Forced argmax baseline: max eff ignoring bar and tie.
// The "always guess" policy, for the FP7 help comparison.
// Test-harness only; not belief machinery.
fn bp3_force(bt:[]u8,hasb:[]u8,cands:[]u8,nc:i32)i32 {
  let best:i32=-3; let beff:i32=-1;
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if((hasb[m] as i32)==1){
      let e:i32=bp2_eff(bt,m);
      if(e>beff){beff=e; best=m;}
    }
    i=i+1;
  }
  return best;
}

// Copy n bytes src[0..n] to dst[off..off+n].
fn bp3_bufcopy(src:[]u8,dst:[]u8,off:i32,n:i32)void {
  let i:i32=0;
  while(i<n){dst[off+i]=src[i]; i=i+1;}
  return;
}

// 1 if cur[0..n] == ref[off..off+n], else 0.
fn bp3_bufeq_ref(cur:[]u8,ref:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){if(cur[i]!=ref[off+i]){return 0;} i=i+1;}
  return 1;
}

// Run the FP6 t0-t4 + persistence sequence on one arm.
// snapbt: 5*8192 out/ref; snaphasb: 5*1024 out/ref;
// trace: 112 bytes out/ref: t0 (vsup,zsup,r7,lg),
// t1..t4 at s*20 (live,vsup,zsup,r7,lg), persistence at 100/104/108.
// mode=0 stores; mode=1 compares against stored. Returns bitmask:
// bit0 = bt/hasb identical, bit1 = trace identical.
fn bp3_fp6_run(W:[]u8,bt:[]u8,hasb:[]u8,mv3:i32,mz2:i32,bar0:i32,
               snapbt:[]u8,snaphasb:[]u8,trace:[]u8,mode:i32)i32 {
  let tabok:i32=1; let trcok:i32=1;
  let cands:[]u8=z_alloc(4);
  set32(cands,0,mz2);
  let vsup0:i32=bt[mv3*8] as i32;
  let zsup0:i32=bt[mz2*8] as i32;
  let r70:i32=bp2_select(bt,hasb,cands,1,bar0);
  let lg0:i32=bp2_lgsel(W,cands,1);
  if(mode==0){
    set32(trace,0,vsup0); set32(trace,4,zsup0);
    set32(trace,8,r70); set32(trace,12,lg0);
    bp3_bufcopy(bt,snapbt,0,8192);
    bp3_bufcopy(hasb,snaphasb,0,1024);
  } else {
    if(vsup0!=get32(trace,0)){trcok=0;}
    if(zsup0!=get32(trace,4)){trcok=0;}
    if(r70!=get32(trace,8)){trcok=0;}
    if(lg0!=get32(trace,12)){trcok=0;}
    if(bp3_bufeq_ref(bt,snapbt,0,8192)!=1){tabok=0;}
    if(bp3_bufeq_ref(hasb,snaphasb,0,1024)!=1){tabok=0;}
  }
  let s:i32=1;
  while(s<=4){
    bp2_kill_one_prov(W,mv3);
    bp2_relicense(W,bt,mv3);
    bp2_propagate(W,bt,hasb,mz2);
    let lo:[]u8=z_alloc(12);
    bp2_lic_live(W,mv3,lo);
    let live:i32=get32(lo,0);
    let vsup:i32=bt[mv3*8] as i32;
    let zsup:i32=bt[mz2*8] as i32;
    let r7:i32=bp2_select(bt,hasb,cands,1,bar0);
    let lg:i32=bp2_lgsel(W,cands,1);
    let bo:i32=s*20;
    if(mode==0){
      set32(trace,bo,live); set32(trace,bo+4,vsup);
      set32(trace,bo+8,zsup); set32(trace,bo+12,r7);
      set32(trace,bo+16,lg);
      bp3_bufcopy(bt,snapbt,s*8192,8192);
      bp3_bufcopy(hasb,snaphasb,s*1024,1024);
    } else {
      if(live!=get32(trace,bo)){trcok=0;}
      if(vsup!=get32(trace,bo+4)){trcok=0;}
      if(zsup!=get32(trace,bo+8)){trcok=0;}
      if(r7!=get32(trace,bo+12)){trcok=0;}
      if(lg!=get32(trace,bo+16)){trcok=0;}
      if(bp3_bufeq_ref(bt,snapbt,s*8192,8192)!=1){tabok=0;}
      if(bp3_bufeq_ref(hasb,snaphasb,s*1024,1024)!=1){tabok=0;}
    }
    s=s+1;
  }
  let p1:i32=bp2_select(bt,hasb,cands,1,bar0);
  let p2:i32=bp2_select(bt,hasb,cands,1,bar0);
  let p3:i32=bp2_select(bt,hasb,cands,1,bar0);
  if(mode==0){
    set32(trace,100,p1); set32(trace,104,p2); set32(trace,108,p3);
  } else {
    if(p1!=get32(trace,100)){trcok=0;}
    if(p2!=get32(trace,104)){trcok=0;}
    if(p3!=get32(trace,108)){trcok=0;}
  }
  return tabok+trcok*2;
}

// Degrade helper: kill k licensing facts of mid, R4+R6 each.
fn bp3_degrade(W:[]u8,bt:[]u8,hasb:[]u8,mid:i32,z:i32,k:i32)void {
  let j:i32=0;
  while(j<k){
    bp2_kill_one_prov(W,mid);
    bp2_relicense(W,bt,mid);
    bp2_propagate(W,bt,hasb,z);
    j=j+1;
  }
  return;
}

fn main()i32 {
  emit("BP3-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  let bar0:i32=50;

  // ================= FP6: domain-blindness =================
  emit("FP6-BEGIN\n");

  // --- pm=0 (identity): store reference ---
  let W0:[]u8=z_alloc(110656);
  tnn2_init(W0);
  let ids0:[]u8=z_alloc(28);
  bp3_build(W0,ids0,0,0);
  let mv20:i32=get32(ids0,4);
  let mv30:i32=get32(ids0,8);
  let navx0:i32=get32(ids0,12);
  let mz20:i32=get32(ids0,20);
  bp3_bar(t,"PC6-0A",xs5_find_countmap(W0)==mv20);
  let lo0:[]u8=z_alloc(12);
  bp2_lic_live(W0,mv30,lo0);
  bp3_bar(t,"PC6-0B",bp3_prov_rel(W0,mv30)==87 && get32(lo0,0)==4);
  bp3_bar(t,"PC6-0C",xhier_is_mapz(W0,mz20)==1 && xhier_mapz_agg(W0,mz20)==mv30);
  let bt0:[]u8=z_alloc(8192); let hasb0:[]u8=z_alloc(1024);
  bp2_form(W0,bt0,hasb0,navx0,0);
  bp2_form(W0,bt0,hasb0,mv30,0);
  bp2_form(W0,bt0,hasb0,mz20,1);
  let snapbt0:[]u8=z_alloc(40960); let snaphasb0:[]u8=z_alloc(5120);
  let trace0:[]u8=z_alloc(112);
  bp3_fp6_run(W0,bt0,hasb0,mv30,mz20,bar0,snapbt0,snaphasb0,trace0,0);
  // K-FP6-VAL: hand-derived Section 2 values.
  let v0:i32=1;
  if(get32(trace0,0)!=100 || get32(trace0,4)!=100){v0=0;}
  if(get32(trace0,8)!=mz20 || get32(trace0,12)!=mz20){v0=0;}
  let exp_live:[]u8=z_alloc(16);
  set32(exp_live,0,3); set32(exp_live,4,2);
  set32(exp_live,8,1); set32(exp_live,12,0);
  let exp_sup:[]u8=z_alloc(16);
  set32(exp_sup,0,75); set32(exp_sup,4,37);
  set32(exp_sup,8,9); set32(exp_sup,12,0);
  let s:i32=1;
  while(s<=4){
    let bo:i32=s*20;
    if(get32(trace0,bo)!=get32(exp_live,(s-1)*4)){v0=0;}
    if(get32(trace0,bo+4)!=get32(exp_sup,(s-1)*4)){v0=0;}
    if(get32(trace0,bo+8)!=get32(exp_sup,(s-1)*4)){v0=0;}
    if(s==1 && get32(trace0,bo+12)!=mz20){v0=0;}
    if(s>1 && get32(trace0,bo+12)!=-3){v0=0;}
    if(get32(trace0,bo+16)!=mz20){v0=0;}
    s=s+1;
  }
  if(get32(trace0,100)!=-3 || get32(trace0,104)!=-3){v0=0;}
  if(get32(trace0,108)!=-3){v0=0;}
  bp3_bar(t,"K-FP6-VAL",v0==1);
  emit("FP6-PM0-IDS "); e64(navx0); emit(" "); e64(mv20);
  emit(" "); e64(mv30); emit(" "); e64(mz20); emit("\n");

  // --- pm=1 (offset): compare ---
  let W1:[]u8=z_alloc(110656);
  tnn2_init(W1);
  let ids1:[]u8=z_alloc(28);
  bp3_build(W1,ids1,1,0);
  let mv21:i32=get32(ids1,4);
  let mv31:i32=get32(ids1,8);
  let navx1:i32=get32(ids1,12);
  let mz21:i32=get32(ids1,20);
  bp3_bar(t,"PC6-1A",xs5_find_countmap(W1)==mv21);
  let lo1:[]u8=z_alloc(12);
  bp2_lic_live(W1,mv31,lo1);
  bp3_bar(t,"PC6-1B",bp3_prov_rel(W1,mv31)==bp3_perm(87,1) && get32(lo1,0)==4);
  bp3_bar(t,"PC6-1C",xhier_is_mapz(W1,mz21)==1 && xhier_mapz_agg(W1,mz21)==mv31);
  let bt1:[]u8=z_alloc(8192); let hasb1:[]u8=z_alloc(1024);
  bp2_form(W1,bt1,hasb1,navx1,0);
  bp2_form(W1,bt1,hasb1,mv31,0);
  bp2_form(W1,bt1,hasb1,mz21,1);
  let ok1:i32=bp3_fp6_run(W1,bt1,hasb1,mv31,mz21,bar0,snapbt0,snaphasb0,trace0,1);
  let idx1:i32=bp3_bufeq_ref(ids1,ids0,0,28);
  emit("FP6-PM1-IDS "); e64(navx1); emit(" "); e64(mv21);
  emit(" "); e64(mv31); emit(" "); e64(mz21); emit("\n");

  // --- pm=2 (reflection): compare ---
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  let ids2:[]u8=z_alloc(28);
  bp3_build(W2,ids2,2,0);
  let mv22:i32=get32(ids2,4);
  let mv32:i32=get32(ids2,8);
  let navx2:i32=get32(ids2,12);
  let mz22:i32=get32(ids2,20);
  bp3_bar(t,"PC6-2A",xs5_find_countmap(W2)==mv22);
  let lo2:[]u8=z_alloc(12);
  bp2_lic_live(W2,mv32,lo2);
  bp3_bar(t,"PC6-2B",bp3_prov_rel(W2,mv32)==bp3_perm(87,2) && get32(lo2,0)==4);
  bp3_bar(t,"PC6-2C",xhier_is_mapz(W2,mz22)==1 && xhier_mapz_agg(W2,mz22)==mv32);
  let bt2:[]u8=z_alloc(8192); let hasb2:[]u8=z_alloc(1024);
  bp2_form(W2,bt2,hasb2,navx2,0);
  bp2_form(W2,bt2,hasb2,mv32,0);
  bp2_form(W2,bt2,hasb2,mz22,1);
  let ok2:i32=bp3_fp6_run(W2,bt2,hasb2,mv32,mz22,bar0,snapbt0,snaphasb0,trace0,1);
  let idx2:i32=bp3_bufeq_ref(ids2,ids0,0,28);
  emit("FP6-PM2-IDS "); e64(navx2); emit(" "); e64(mv22);
  emit(" "); e64(mv32); emit(" "); e64(mz22); emit("\n");

  bp3_bar(t,"K-FP6-IDX",idx1==1 && idx2==1);
  // ok bitmask: bit0 = bt/hasb identical, bit1 = trace identical.
  bp3_bar(t,"K-FP6-TAB",(ok1&1)==1 && (ok2&1)==1);
  bp3_bar(t,"K-FP6-TRC",(ok1&2)==2 && (ok2&2)==2);
  emit("FP6-END\n");

  // ================= FP7a: core abstention =================
  emit("FP7A-BEGIN\n");
  let W7a:[]u8=z_alloc(110656);
  tnn2_init(W7a);
  let ids7a:[]u8=z_alloc(28);
  bp3_build(W7a,ids7a,0,1);
  let mv27a:i32=get32(ids7a,4);
  let mv37a:i32=get32(ids7a,8);
  let navx7a:i32=get32(ids7a,12);
  let mz27a:i32=get32(ids7a,20);
  let mz37a:i32=get32(ids7a,24);
  bp3_bar(t,"PC7a-0",xs5_find_countmap(W7a)==mv27a);
  let lo7a:[]u8=z_alloc(12);
  bp2_lic_live(W7a,mv37a,lo7a);
  bp3_bar(t,"PC7a-1",bp3_prov_rel(W7a,mv37a)==87 && get32(lo7a,0)==4);
  bp3_bar(t,"PC7a-2",xhier_is_mapz(W7a,mz27a)==1 && xhier_mapz_agg(W7a,mz27a)==mv37a);
  bp3_bar(t,"PC7a-3",xhier_is_mapz(W7a,mz37a)==1 && ng(W7a,mz37a,8)==11 && ng(W7a,mz37a,4)==93 && xhier_mapz_agg(W7a,mz37a)==mv27a && xhier_mapz_nav(W7a,mz37a)==navx7a);
  let bt7a:[]u8=z_alloc(8192); let hasb7a:[]u8=z_alloc(1024);
  bp2_form(W7a,bt7a,hasb7a,navx7a,0);
  bp2_form(W7a,bt7a,hasb7a,mv37a,0);
  bp2_form(W7a,bt7a,hasb7a,mv27a,0);
  bp2_form(W7a,bt7a,hasb7a,mz27a,1);
  bp2_form(W7a,bt7a,hasb7a,mz37a,1);
  bp2_propagate(W7a,bt7a,hasb7a,mz27a);
  bp2_propagate(W7a,bt7a,hasb7a,mz37a);
  bp3_degrade(W7a,bt7a,hasb7a,mv37a,mz27a,2);
  bp3_degrade(W7a,bt7a,hasb7a,mv27a,mz37a,2);
  let z2s7a:i32=bt7a[mz27a*8] as i32;
  let z3s7a:i32=bt7a[mz37a*8] as i32;
  let v3s7a:i32=bt7a[mv37a*8] as i32;
  let v2s7a:i32=bt7a[mv27a*8] as i32;
  emit("FP7A-SUP V3 "); e64(v3s7a); emit(" V2 "); e64(v2s7a);
  emit(" Z2 "); e64(z2s7a); emit(" Z3 "); e64(z3s7a); emit("\n");
  bp3_bar(t,"K-FP7-A1",v3s7a==37 && v2s7a==37 && z2s7a==37 && z3s7a==37);
  let snap7a:[]u8=z_alloc(8192);
  bp3_bufcopy(bt7a,snap7a,0,8192);
  let cands7a:[]u8=z_alloc(8);
  set32(cands7a,0,mz27a); set32(cands7a,4,mz37a);
  let a2:i32=bp2_select(bt7a,hasb7a,cands7a,2,bar0);
  emit("FP7A-R7PAIR "); e64(a2); emit("\n");
  bp3_bar(t,"K-FP7-A2",a2==-3);
  let a3a:i32=bp2_select(bt7a,hasb7a,cands7a,1,bar0);
  let cands7a3:[]u8=z_alloc(4);
  set32(cands7a3,0,mz37a);
  let a3b:i32=bp2_select(bt7a,hasb7a,cands7a3,1,bar0);
  emit("FP7A-R7SINGLE "); e64(a3a); emit(" "); e64(a3b); emit("\n");
  bp3_bar(t,"K-FP7-A3",a3a==-3 && a3b==-3);
  let empty:[]u8=z_alloc(4);
  let a5a:i32=bp2_select(bt7a,hasb7a,empty,0,bar0);
  let cands7a5:[]u8=z_alloc(8);
  set32(cands7a5,0,mz27a); set32(cands7a5,4,999);
  let a5b:i32=bp2_select(bt7a,hasb7a,cands7a5,2,bar0);
  emit("FP7A-R7EDGE "); e64(a5a); emit(" "); e64(a5b); emit("\n");
  bp3_bar(t,"K-FP7-A5",a5a==-3 && a5b==-3);
  let a4:i32=bp3_bufeq_ref(bt7a,snap7a,0,8192);
  if(bp2_has_k3(W7a,mz27a)!=0){a4=0;}
  if(bp2_has_k3(W7a,mz37a)!=0){a4=0;}
  bp3_bar(t,"K-FP7-A4",a4==1);
  emit("FP7A-END\n");

  // ================= FP7b: does abstention help =================
  emit("FP7B-BEGIN\n");
  // --- W7b, Seq D ---
  let W7b:[]u8=z_alloc(110656);
  tnn2_init(W7b);
  let ids7b:[]u8=z_alloc(28);
  bp3_build(W7b,ids7b,0,1);
  let mv27b:i32=get32(ids7b,4);
  let mv37b:i32=get32(ids7b,8);
  let navx7b:i32=get32(ids7b,12);
  let mz27b:i32=get32(ids7b,20);
  let mz37b:i32=get32(ids7b,24);
  bp3_bar(t,"PC7b-0",xs5_find_countmap(W7b)==mv27b);
  let lo7b:[]u8=z_alloc(12);
  bp2_lic_live(W7b,mv37b,lo7b);
  bp3_bar(t,"PC7b-1",bp3_prov_rel(W7b,mv37b)==87 && get32(lo7b,0)==4);
  bp3_bar(t,"PC7b-2",xhier_is_mapz(W7b,mz27b)==1 && xhier_mapz_agg(W7b,mz27b)==mv37b);
  bp3_bar(t,"PC7b-3",xhier_is_mapz(W7b,mz37b)==1 && ng(W7b,mz37b,8)==11 && ng(W7b,mz37b,4)==93 && xhier_mapz_agg(W7b,mz37b)==mv27b && xhier_mapz_nav(W7b,mz37b)==navx7b);
  let bt7b:[]u8=z_alloc(8192); let hasb7b:[]u8=z_alloc(1024);
  bp2_form(W7b,bt7b,hasb7b,navx7b,0);
  bp2_form(W7b,bt7b,hasb7b,mv37b,0);
  bp2_form(W7b,bt7b,hasb7b,mv27b,0);
  bp2_form(W7b,bt7b,hasb7b,mz27b,1);
  bp2_form(W7b,bt7b,hasb7b,mz37b,1);
  bp2_propagate(W7b,bt7b,hasb7b,mz27b);
  bp2_propagate(W7b,bt7b,hasb7b,mz37b);
  bp3_degrade(W7b,bt7b,hasb7b,mv37b,mz27b,2);
  bp3_degrade(W7b,bt7b,hasb7b,mv27b,mz37b,3);
  let cands7b:[]u8=z_alloc(8);
  set32(cands7b,0,mz27b); set32(cands7b,4,mz37b);
  let z2s7b:i32=bt7b[mz27b*8] as i32;
  let z3s7b:i32=bt7b[mz37b*8] as i32;
  let b1r7:i32=bp2_select(bt7b,hasb7b,cands7b,2,bar0);
  let b1f:i32=bp3_force(bt7b,hasb7b,cands7b,2);
  emit("FP7B-SETUP Z2 "); e64(z2s7b); emit(" Z3 "); e64(z3s7b);
  emit(" R7 "); e64(b1r7); emit(" FORCE "); e64(b1f); emit("\n");
  bp3_bar(t,"K-FP7-B1",z2s7b==37 && z3s7b==9 && b1r7==-3 && b1f==mz27b);
  // Bar=30 counterfactual BEFORE the Seq D evidence.
  let b3pre:i32=bp2_select(bt7b,hasb7b,cands7b,2,30);
  emit("FP7B-BAR30-PRE "); e64(b3pre); emit("\n");
  bp3_bar(t,"K-FP7-B3",b3pre==mz27b);
  // Seq D evidence: Z2 disconfirmed, Z3 confirmed.
  bp2_disconfirm(bt7b,mz27b);
  bp2_confirm(bt7b,mz37b,1);
  let z2d7b:i32=bt7b[mz27b*8] as i32;
  let z3d7b:i32=bt7b[mz37b*8] as i32;
  let b2r7:i32=bp2_select(bt7b,hasb7b,cands7b,2,bar0);
  emit("FP7B-SEQD Z2 "); e64(z2d7b); emit(" Z3 "); e64(z3d7b);
  emit(" R7 "); e64(b2r7); emit("\n");
  bp3_bar(t,"K-FP7-B2",z2d7b==17 && z3d7b==29 && b2r7==-3);

  // --- W7c, Seq C ---
  let W7c:[]u8=z_alloc(110656);
  tnn2_init(W7c);
  let ids7c:[]u8=z_alloc(28);
  bp3_build(W7c,ids7c,0,1);
  let mv27c:i32=get32(ids7c,4);
  let mv37c:i32=get32(ids7c,8);
  let navx7c:i32=get32(ids7c,12);
  let mz27c:i32=get32(ids7c,20);
  let mz37c:i32=get32(ids7c,24);
  let bt7c:[]u8=z_alloc(8192); let hasb7c:[]u8=z_alloc(1024);
  bp2_form(W7c,bt7c,hasb7c,navx7c,0);
  bp2_form(W7c,bt7c,hasb7c,mv37c,0);
  bp2_form(W7c,bt7c,hasb7c,mv27c,0);
  bp2_form(W7c,bt7c,hasb7c,mz27c,1);
  bp2_form(W7c,bt7c,hasb7c,mz37c,1);
  bp2_propagate(W7c,bt7c,hasb7c,mz27c);
  bp2_propagate(W7c,bt7c,hasb7c,mz37c);
  bp3_degrade(W7c,bt7c,hasb7c,mv37c,mz27c,2);
  bp3_degrade(W7c,bt7c,hasb7c,mv27c,mz37c,3);
  let cands7c:[]u8=z_alloc(8);
  set32(cands7c,0,mz27c); set32(cands7c,4,mz37c);
  let z2s7c:i32=bt7c[mz27c*8] as i32;
  let z3s7c:i32=bt7c[mz37c*8] as i32;
  let b0r7:i32=bp2_select(bt7c,hasb7c,cands7c,2,bar0);
  emit("FP7C-SETUP Z2 "); e64(z2s7c); emit(" Z3 "); e64(z3s7c);
  emit(" R7 "); e64(b0r7); emit("\n");
  bp3_bar(t,"K-FP7-B0",z2s7c==37 && z3s7c==9 && b0r7==-3);
  // Seq C evidence: Z2 confirmed, Z3 disconfirmed.
  bp2_confirm(bt7c,mz27c,1);
  bp2_disconfirm(bt7c,mz37c);
  let z2c7c:i32=bt7c[mz27c*8] as i32;
  let z3c7c:i32=bt7c[mz37c*8] as i32;
  let b4r7:i32=bp2_select(bt7c,hasb7c,cands7c,2,bar0);
  emit("FP7C-SEQC Z2 "); e64(z2c7c); emit(" Z3 "); e64(z3c7c);
  emit(" R7 "); e64(b4r7); emit("\n");
  bp3_bar(t,"K-FP7-B4",z2c7c==57 && z3c7c==0 && b4r7==mz27c);
  emit("FP7B-END\n");

  emit("BP3-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP3-END\n");
  return 0;
}

// ivwc_batchaware.zag -- batch-aware worth-K verdict.
// V_BAMK: bar = K + M_pred(sh), where M_pred(sh) is the batch's
// predicted miscalibration from the bucket-mix signal (mean over
// sealed cases of the train in-sample miscalibration per bucket).
// Tracks the batch's miscalibration, NOT the batch's level.
// V_XMG: fenced exact-gap diagnostic (bar = K + exact mean gap),
// not a learner verdict; bounds the mean-gap estimand.
// K = EXCOST is a world parameter (the execution cost), fixed
// before any sealed case is seen: not a label, not a threshold
// on truth. The BAMK bar keeps the structural property: it reads
// only bkt (sealed, bias-free), M_train (train-fixed), and K. It
// never reads the learner's sealed bias-adjusted scores, so the
// fenced +40 probes cannot move it (K1-A10).
// World / belief / composer / stepper / seeds / biases / bars are
// verbatim from IVWC-HYBRID-VERDICT, IVWC-APPLIED, and
// IVWC-CONSEQUENCE (K3 re-verifies bars). Scoring is pure
// consequence: the world charges EXCOST per GO; profit = sum over
// GO cases of (eff - EXCOST). No ge, no label, no threshold on
// truth anywhere -- not for the learner, not even fenced for
// scoring (K1-A9 audits the threshold token absent).
// Arms: UCB x V_HA (baseline), UCB x V_HKC, UCB x V_WK
// (learner-side: the learner's own UCB bias under each bar);
// UCB x V_BAMK (MAIN: batch-aware miscalibration worth-K).
// D1b/D2b x V_BAMK (fenced D1b/D2b diagnostics, +40 never
// learner-visible). Fenced: V_XMG exact-gap diagnostic
// (arithmetic only, zero world calls). Reference: execute-all
// profit per batch (fenced, counterfactual).
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC-APPLIED) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;
// World execution cost per GO (preregistered; consequence phase only).
// K is ALSO the stakes parameter read by the V_HKC and V_WK bars:
// a world constant, fixed before any sealed case, not a label.
const EXCOST:i32=15;

// ---------- helpers (u8-backed cells, little-endian; verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow).
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}
// Integer floor square root (for the V-UCB bias estimator).
fn isqrt(x:i32)i32 {
  let r:i32=0;
  while((r+1)*(r+1)<=x){ r=r+1; }
  return r;
}

// ===== WORLD =====
// Verbatim copies from IVWC-HYBRID-VERDICT. The learner never calls
// these.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// True-world stepper. Called ONLY in train CONSEQ, sealed
// CONSEQUENCE (GO cases), and the fenced REFERENCE -- never by the
// learner. wc counts true executions.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// Everything in this section touches beliefs and plans only.
// No true-world array token appears below (checked by audit A7).
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only (verbatim).
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Extract gather cells from a plan (walk from start), insertion-sort
// them, return the count. Flat control flow (no deep nesting).
fn gather_cells(pb:[]u8, poff:i32, L:i32, start:i32, out:[]u8, ooff:i32)i32 {
  let pos:i32=start;
  let n:i32=0;
  let i:i32=0;
  while(i<L){
    let a:i32=get8(pb,poff+i);
    if(a==0){ pos=pos-1; }
    else {
      if(a==1){ pos=pos+1; }
      else {
        set8(out,ooff+n,pos);
        n=n+1;
      }
    }
    i=i+1;
  }
  let k:i32=1;
  while(k<n){
    let v:i32=get8(out,ooff+k);
    let j:i32=k-1;
    let go:i32=1;
    while(go==1){
      let stop:i32=0;
      if(j<0){ stop=1; }
      if(stop==0){
        if(get8(out,ooff+j)<=v){ stop=1; }
      }
      if(stop==1){ go=0; }
      else {
        set8(out,ooff+j+1,get8(out,ooff+j));
        j=j-1;
      }
    }
    set8(out,ooff+j+1,v);
    k=k+1;
  }
  return n;
}

// Runs the world's response for one arm's GO cases; returns profit.
// Single world_execute call site for all arm consequences (K1-A5).
fn conseq_arm(wseal:[]u8, pseal:[]u8, sL:[]u8, go:[]u8, cseal:[]u8, etmp:[]u8, wc:[]u8)i32 {
  let profit:i32=0;
  let s:i32=0;
  while(s<NSEAL){
    if(get32(go,4*s)==1){
      let sL2:i32=get32(sL,4*s);
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL2, cseal, s*RECC, etmp, 0, wc);
      let sc:i32=get32(cseal,s*RECC);
      let su:i32=get32(cseal,s*RECC+4);
      let se:i32=0;
      if(su>0){ se=(100*sc)/su; }
      profit=profit+se-EXCOST;
    }
    s=s+1;
  }
  return profit;
}

// ===== MAIN: consequence-aware hybrid verdict (no outside truth) =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCBA-BEGIN\n");
  // Train buffers.
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let tbkt:[]u8=z_alloc(NTRAIN*4);
  let teff:[]u8=z_alloc(NTRAIN*4);
  let preff_tr:[]u8=z_alloc(NTRAIN*4);
  // UCB tables.
  let biassum:[]u8=z_alloc(16);
  let biascnt:[]u8=z_alloc(16);
  let bias:[]u8=z_alloc(16);
  let bsq:[]u8=z_alloc(16);
  let bucb:[]u8=z_alloc(16);
  // Sealed buffers.
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let preff:[]u8=z_alloc(NSEAL*4);
  let sL:[]u8=z_alloc(NSEAL*4);
  let sstart:[]u8=z_alloc(NSEAL*4);
  // Learner GO decisions (UCB arms; per sealed batch).
  let go_uha:[]u8=z_alloc(NSEAL*4);
  let go_uhkc:[]u8=z_alloc(NSEAL*4);
  let go_uwk:[]u8=z_alloc(NSEAL*4);
  let go_ubamk:[]u8=z_alloc(NSEAL*4);
  // Fenced GO decisions (D1b/D2b x V_BAMK; per sealed batch).
  let go_d1bamk:[]u8=z_alloc(NSEAL*4);
  let go_d2bamk:[]u8=z_alloc(NSEAL*4);
  // Profit per arm per batch (3 batches).
  let p_uha:[]u8=z_alloc(12);
  let p_uhkc:[]u8=z_alloc(12);
  let p_uwk:[]u8=z_alloc(12);
  let p_ubamk:[]u8=z_alloc(12);
  let p_d1bamk:[]u8=z_alloc(12);
  let p_d2bamk:[]u8=z_alloc(12);
  let p_xmg:[]u8=z_alloc(12);
  let pall:[]u8=z_alloc(12);
  // Bars per batch.
  let thyA_a:[]u8=z_alloc(12);
  let thyB_a:[]u8=z_alloc(12);
  let tvucb_a:[]u8=z_alloc(12);
  let thykc_a:[]u8=z_alloc(12);
  let barbamk_a:[]u8=z_alloc(12);
  let barxmg_a:[]u8=z_alloc(12);
  let mxmg_a:[]u8=z_alloc(12);
  // Train per-bucket miscalibration (learner-visible on train).
  let msum:[]u8=z_alloc(16);
  let mcnt:[]u8=z_alloc(16);
  let mcalib:[]u8=z_alloc(16);
  // Fenced diagnostic D1b/D2b.
  let nph:[]u8=z_alloc(NSEAL*4);
  let d1adj:[]u8=z_alloc(NSEAL*4);
  let d2adj:[]u8=z_alloc(NSEAL*4);
  // Misc.
  let adjucb:[]u8=z_alloc(NSEAL*4);
  let sbkt:[]u8=z_alloc(NSEAL*4);
  let wc:[]u8=z_alloc(4);
  let etmp:[]u8=z_alloc(EREC);
  let gout2:[]u8=z_alloc(CW);
  let k1:i32=1;
  let Tfixed:i32=0;
  let Cval:i32=0;
  // PHASE: train SETUP (harness; wp=15; seeds verbatim).
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, 15, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // PHASE: train COMMIT (learner; beliefs only).
  let wcb0:i32=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    t=t+1;
  }
  if(get32(wc,0)!=wcb0){ k1=0; }
  // PHASE: train PREFF (learner).
  wcb0=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    let tg:i32=get32(mtrain,t*RECM);
    let tL:i32=get32(mtrain,t*RECM+4);
    let tp:i32=0;
    if(tL>0){ tp=(100*tg)/tL; }
    set32(preff_tr,4*t,tp);
    t=t+1;
  }
  if(get32(wc,0)!=wcb0){ k1=0; }
  // PHASE: train CONSEQ (harness).
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // PHASE: train LEARN (learner). (bucket, eff) pairs; UCB tables.
  t=0;
  while(t<NTRAIN){
    let bk:i32=get32(mtrain,t*RECM+12);
    let tc:i32=get32(ctrain,t*RECC);
    let te:i32=get32(ctrain,t*RECC+4);
    let tf:i32=0;
    if(te>0){ tf=(100*tc)/te; }
    set32(tbkt,4*t,bk);
    set32(teff,4*t,tf);
    t=t+1;
  }
  let b:i32=0;
  while(b<4){
    set32(biassum,4*b,0);
    set32(biascnt,4*b,0);
    set32(bsq,4*b,0);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk2:i32=get32(tbkt,4*t);
    let d:i32=get32(preff_tr,4*t)-get32(teff,4*t);
    if(bk2>=0){
      if(bk2<4){
        set32(biassum,4*bk2,get32(biassum,4*bk2)+d);
        set32(biascnt,4*bk2,get32(biascnt,4*bk2)+1);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let bb:i32=0;
    if(get32(biascnt,4*b)>0){ bb=get32(biassum,4*b)/get32(biascnt,4*b); }
    set32(bias,4*b,bb);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk5:i32=get32(tbkt,4*t);
    if(bk5>=0){
      if(bk5<4){
        let mb5:i32=get32(bias,4*bk5);
        let d5:i32=get32(preff_tr,4*t)-get32(teff,4*t);
        let e5:i32=d5-mb5;
        set32(bsq,4*bk5,get32(bsq,4*bk5)+e5*e5);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let mb6:i32=get32(bias,4*b);
    let nb6:i32=get32(biascnt,4*b);
    let ub:i32=0;
    if(nb6>0){ ub=mb6; }
    if(nb6>1){ ub=mb6+isqrt(get32(bsq,4*b)/(nb6-1)); }
    set32(bucb,4*b,ub);
    b=b+1;
  }
  // Train per-bucket miscalibration M_train[b]: mean over train
  // cases in bucket b of (adj - eff), where adj = preff - bucb[b].
  // All quantities are learner-visible on train (consequences
  // realized in train CONSEQ). Integer division, trunc toward zero.
  b=0;
  while(b<4){
    set32(msum,4*b,0);
    set32(mcnt,4*b,0);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let mbk:i32=get32(tbkt,4*t);
    if(mbk>=0){
      if(mbk<4){
        let madj:i32=get32(preff_tr,4*t)-get32(bucb,4*mbk);
        let mr:i32=madj-get32(teff,4*t);
        set32(msum,4*mbk,get32(msum,4*mbk)+mr);
        set32(mcnt,4*mbk,get32(mcnt,4*mbk)+1);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let mm:i32=0;
    if(get32(mcnt,4*b)>0){ mm=get32(msum,4*b)/get32(mcnt,4*b); }
    set32(mcalib,4*b,mm);
    b=b+1;
  }
  // PHASE: train BAR (learner). T_fixed = mean train adjV_UCB.
  let tfsum:i32=0;
  t=0;
  while(t<NTRAIN){
    let tbk:i32=get32(tbkt,4*t);
    tfsum=tfsum+get32(preff_tr,4*t)-get32(bucb,4*tbk);
    t=t+1;
  }
  Tfixed=tfsum/NTRAIN;
  at=ob_app(ob,at,"TFIXED=");
  at=ob_i32(ob,at,Tfixed);
  at=ob_nl(ob,at);
  // Hybrid offset C = mean over train of bucb[bkt_tr] (train-fixed).
  let csum:i32=0;
  t=0;
  while(t<NTRAIN){
    let cbk:i32=get32(tbkt,4*t);
    csum=csum+get32(bucb,4*cbk);
    t=t+1;
  }
  Cval=csum/NTRAIN;
  at=ob_app(ob,at,"CVAL=");
  at=ob_i32(ob,at,Cval);
  at=ob_nl(ob,at);
  // TA-train audit (learner-visible only).
  at=ob_app(ob,at,"TAUDIT t bkt preff eff d adj\n");
  t=0;
  while(t<NTRAIN){
    let abk:i32=get32(tbkt,4*t);
    at=ob_app(ob,at,"TA t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,abk);
    at=ob_app(ob,at," preff=");
    at=ob_i32(ob,at,get32(preff_tr,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(teff,4*t));
    at=ob_app(ob,at," adj=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(bucb,4*abk));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // PHASE: sealed SHIFT LOOP. sh=0..2, wp=15/30/45.
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    // PHASE: sealed SETUP (harness; seeds verbatim).
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // PHASE: sealed COMMIT (learner). No world calls.
    wcb0=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      let sg:i32=get32(mseal,s*RECM);
      let sLl:i32=get32(mseal,s*RECM+4);
      let sq:i32=0;
      if(sLl>0){ sq=(100*sg)/sLl; }
      set32(preff,4*s,sq);
      set32(sL,4*s,sLl);
      set32(sstart,4*s,get8(bseal,s*RECW+2*CW));
      let sbk:i32=get32(mseal,s*RECM+12);
      set32(adjucb,4*s,sq-get32(bucb,4*sbk));
      set32(sbkt,4*s,sbk);
      s=s+1;
    }
    if(get32(wc,0)!=wcb0){ k1=0; }
    // PHASE: sealed BARS (learner). No world data.
    // V_HA: ThyA = mean_sealed(preff) - C (preff is bias-free; the
    // fenced +40 probes cannot move this bar; C is train-fixed).
    // V_HB: ThyB = mean_sealed(preff - bucb_frozen[bkt]).
    // V_HKC (consequence-aware): ThyHKC = max(ThyA, EXCOST). The
    // stakes EXCOST is a world constant read as a bar parameter;
    // the bar still never reads a sealed bias-adjusted score, so
    // the probes cannot move it (K1-A10).
    // V_WK (worth-K control): bar = EXCOST, a constant.
    // V_BAMK (batch-aware miscalibration worth-K, MAIN):
    // bar_BAMK = EXCOST + M_pred(sh), where M_pred(sh) is the
    // bucket-mix predicted miscalibration: mean over sealed cases
    // of M_train[bkt_s]. Reads only bkt (sealed, bias-free),
    // M_train (train-fixed), and K. Never reads a sealed
    // bias-adjusted score; the probes cannot move it (K1-A10).
    let totucb:i32=0;
    let totp:i32=0;
    let totm:i32=0;
    s=0;
    while(s<NSEAL){
      totucb=totucb+get32(adjucb,4*s);
      totp=totp+get32(preff,4*s);
      let mbk2:i32=get32(sbkt,4*s);
      if(mbk2>=0){
        if(mbk2<4){ totm=totm+get32(mcalib,4*mbk2); }
      }
      s=s+1;
    }
    let TVucb:i32=totucb/NSEAL;
    let ThyA:i32=totp/NSEAL-Cval;
    let ThyB:i32=totucb/NSEAL;
    let ThyHKC:i32=ThyA;
    if(EXCOST>ThyHKC){ ThyHKC=EXCOST; }
    let Mpred:i32=totm/NSEAL;
    let BarBAMK:i32=EXCOST+Mpred;
    set32(tvucb_a,4*sh,TVucb);
    set32(thyA_a,4*sh,ThyA);
    set32(thyB_a,4*sh,ThyB);
    set32(thykc_a,4*sh,ThyHKC);
    set32(barbamk_a,4*sh,BarBAMK);
    at=ob_app(ob,at,"BARS sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," TVucb=");
    at=ob_i32(ob,at,TVucb);
    at=ob_app(ob,at," Tfixed=");
    at=ob_i32(ob,at,Tfixed);
    at=ob_app(ob,at," ThyA=");
    at=ob_i32(ob,at,ThyA);
    at=ob_app(ob,at," ThyB=");
    at=ob_i32(ob,at,ThyB);
    at=ob_app(ob,at," ThyHKC=");
    at=ob_i32(ob,at,ThyHKC);
    at=ob_app(ob,at," Mpred=");
    at=ob_i32(ob,at,Mpred);
    at=ob_app(ob,at," BarBAMK=");
    at=ob_i32(ob,at,BarBAMK);
    at=ob_nl(ob,at);
    // FENCED nphantom per case (plan/world analysis; no decisions).
    // nph(s): planned gathers at cells where the true world holds
    // no item. Never learner-visible.
    s=0;
    while(s<NSEAL){
      let np:i32=0;
      let ng:i32=gather_cells(pseal,s*PLANMAX,get32(sL,4*s),get32(sstart,4*s),gout2,0);
      let gi:i32=0;
      while(gi<ng){
        let cell:i32=get8(gout2,gi);
        if(get8(wseal,s*RECW+CW+cell)==0){ np=np+1; }
        gi=gi+1;
      }
      set32(nph,4*s,np);
      s=s+1;
    }
    // PHASE: sealed VERDICT (learner). GO = 1 iff score > bar.
    // Rendered BEFORE any consequence; the learner never sees eff.
    // UCB x V_HA (baseline), UCB x V_HKC, UCB x V_WK,
    // UCB x V_BAMK (MAIN: batch-aware miscalibration worth-K).
    let cuha:i32=0;
    let cuhkc:i32=0;
    let cuwk:i32=0;
    let cubamk:i32=0;
    s=0;
    while(s<NSEAL){
      let guha:i32=0;
      if(get32(adjucb,4*s)>ThyA){ guha=1; }
      set32(go_uha,4*s,guha);
      cuha=cuha+guha;
      let guhkc:i32=0;
      if(get32(adjucb,4*s)>ThyHKC){ guhkc=1; }
      set32(go_uhkc,4*s,guhkc);
      cuhkc=cuhkc+guhkc;
      let guwk:i32=0;
      if(get32(adjucb,4*s)>EXCOST){ guwk=1; }
      set32(go_uwk,4*s,guwk);
      cuwk=cuwk+guwk;
      let gubamk:i32=0;
      if(get32(adjucb,4*s)>BarBAMK){ gubamk=1; }
      set32(go_ubamk,4*s,gubamk);
      cubamk=cubamk+gubamk;
      s=s+1;
    }
    // PHASE: CONSEQUENCE (harness). The world responds to real
    // commitments only: world_execute runs on GO cases; profit
    // accumulates (eff - EXCOST). No learner calls from here on.
    let p1:i32=conseq_arm(wseal, pseal, sL, go_uha, cseal, etmp, wc);
    let p2:i32=conseq_arm(wseal, pseal, sL, go_uhkc, cseal, etmp, wc);
    let p3:i32=conseq_arm(wseal, pseal, sL, go_uwk, cseal, etmp, wc);
    let p4:i32=conseq_arm(wseal, pseal, sL, go_ubamk, cseal, etmp, wc);
    set32(p_uha,4*sh,p1);
    set32(p_uhkc,4*sh,p2);
    set32(p_uwk,4*sh,p3);
    set32(p_ubamk,4*sh,p4);
    // PHASE: FENCED-DIAG (harness). D1b/D2b biases (+40 never
    // learner-visible), their GO verdicts vs the V_BAMK bar,
    // consequence on GO cases. Stress-tests the verdict structure
    // only; verifies the BAMK bar is probe-proof (it reads bkt,
    // never the adjusted scores the probes move).
    s=0;
    while(s<NSEAL){
      let sbk4:i32=get32(mseal,s*RECM+12);
      let b1:i32=get32(bucb,4*sbk4);
      if(get32(nph,4*s)>0){ b1=b1+40; }
      let s2b:i32=s+7;
      if(s2b>=NSEAL){ s2b=s2b-NSEAL; }
      let b2:i32=get32(bucb,4*sbk4);
      if(get32(nph,4*s2b)>0){ b2=b2+40; }
      set32(d1adj,4*s,get32(preff,4*s)-b1);
      set32(d2adj,4*s,get32(preff,4*s)-b2);
      s=s+1;
    }
    s=0;
    while(s<NSEAL){
      let gd1b:i32=0;
      if(get32(d1adj,4*s)>BarBAMK){ gd1b=1; }
      set32(go_d1bamk,4*s,gd1b);
      let gd2b:i32=0;
      if(get32(d2adj,4*s)>BarBAMK){ gd2b=1; }
      set32(go_d2bamk,4*s,gd2b);
      s=s+1;
    }
    let pd1b:i32=conseq_arm(wseal, pseal, sL, go_d1bamk, cseal, etmp, wc);
    let pd2b:i32=conseq_arm(wseal, pseal, sL, go_d2bamk, cseal, etmp, wc);
    set32(p_d1bamk,4*sh,pd1b);
    set32(p_d2bamk,4*sh,pd2b);
    // PHASE: REFERENCE (fenced harness). Execute-all profit per
    // batch (counterfactual; never learner-visible). Shows whether
    // verification beats none.
    let pallv:i32=0;
    s=0;
    while(s<NSEAL){
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, get32(sL,4*s), cseal, s*RECC, etmp, 0, wc);
      let sca:i32=get32(cseal,s*RECC);
      let sua:i32=get32(cseal,s*RECC+4);
      let sea:i32=0;
      if(sua>0){ sea=(100*sca)/sua; }
      pallv=pallv+sea-EXCOST;
      s=s+1;
    }
    set32(pall,4*sh,pallv);
    // PHASE: FENCED-XMG (harness diagnostic; NOT a learner verdict).
    // Exact-gap diagnostic: bar_XMG = K + M(sh), where M(sh) is the
    // exact batch mean gap mean_s(adjucb_s - eff_s), computed fenced
    // AFTER the REFERENCE phase (which fills eff for all cases in
    // cseal). Bounds the mean-gap estimand: the best any batch-level
    // mean miscalibration signal could do. Reads sealed eff, so it
    // is explicitly not probe-proof and not a candidate
    // mechanism. Zero world_execute calls: pure arithmetic on the
    // REFERENCE-filled consequence buffer and the stored adjucb.
    let xgap:i32=0;
    s=0;
    while(s<NSEAL){
      let xsc:i32=get32(cseal,s*RECC);
      let xsu:i32=get32(cseal,s*RECC+4);
      let xeff:i32=0;
      if(xsu>0){ xeff=(100*xsc)/xsu; }
      xgap=xgap+get32(adjucb,4*s)-xeff;
      s=s+1;
    }
    let Mxmg:i32=xgap/NSEAL;
    let BarXMG:i32=EXCOST+Mxmg;
    set32(barxmg_a,4*sh,BarXMG);
    let pxmg:i32=0;
    s=0;
    while(s<NSEAL){
      if(get32(adjucb,4*s)>BarXMG){
        let ysc:i32=get32(cseal,s*RECC);
        let ysu:i32=get32(cseal,s*RECC+4);
        let yeff:i32=0;
        if(ysu>0){ yeff=(100*ysc)/ysu; }
        pxmg=pxmg+yeff-EXCOST;
      }
      s=s+1;
    }
    set32(p_xmg,4*sh,pxmg);
    set32(mxmg_a,4*sh,Mxmg);
    at=ob_app(ob,at,"PROFIT sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," uha=");
    at=ob_i32(ob,at,p1);
    at=ob_app(ob,at," guha=");
    at=ob_i32(ob,at,cuha);
    at=ob_app(ob,at," uhkc=");
    at=ob_i32(ob,at,p2);
    at=ob_app(ob,at," guhkc=");
    at=ob_i32(ob,at,cuhkc);
    at=ob_app(ob,at," uwk=");
    at=ob_i32(ob,at,p3);
    at=ob_app(ob,at," guwk=");
    at=ob_i32(ob,at,cuwk);
    at=ob_app(ob,at," ubamk=");
    at=ob_i32(ob,at,p4);
    at=ob_app(ob,at," gubamk=");
    at=ob_i32(ob,at,cubamk);
    at=ob_app(ob,at," d1bamk=");
    at=ob_i32(ob,at,pd1b);
    at=ob_app(ob,at," d2bamk=");
    at=ob_i32(ob,at,pd2b);
    at=ob_app(ob,at," xmg=");
    at=ob_i32(ob,at,pxmg);
    at=ob_app(ob,at," Mxmg=");
    at=ob_i32(ob,at,Mxmg);
    at=ob_app(ob,at," all=");
    at=ob_i32(ob,at,pallv);
    at=ob_nl(ob,at);
    sh=sh+1;
  }
  // WC final audit.
  at=ob_app(ob,at,"WC-FINAL=");
  at=ob_i32(ob,at,get32(wc,0));
  at=ob_nl(ob,at);
  // Kill-bar flags (in-program exact checks vs prereg predictions).
  // K3: verbatim machinery + new quantities.
  let k3:i32=0;
  if(get32(thyA_a,0)==13){
    if(get32(thyA_a,4)==20){
      if(get32(thyA_a,8)==6){
        if(get32(thyB_a,0)==13){
          if(get32(thyB_a,4)==20){
            if(get32(thyB_a,8)==13){
              if(Tfixed==12){
                if(Cval==15){
                  if(get32(thykc_a,0)==15){
                    if(get32(thykc_a,4)==20){
                      if(get32(thykc_a,8)==15){
                        if(get32(mcalib,0)==0){
                          if(get32(mcalib,4)==-11){
                            if(get32(mcalib,8)==-12){
                              if(get32(mcalib,12)==-3){
                                if(get32(barbamk_a,0)==8){
                                  if(get32(barbamk_a,4)==8){
                                    if(get32(barbamk_a,8)==11){
                                      k3=1;
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  // K4 (PRIMARY): UCB x V_BAMK total 248 > UCB x V_HKC total 225.
  let k4:i32=0;
  if(get32(p_ubamk,0)==70){
    if(get32(p_ubamk,4)==138){
      if(get32(p_ubamk,8)==40){
        let tbamk:i32=get32(p_ubamk,0)+get32(p_ubamk,4)+get32(p_ubamk,8);
        let thkc2:i32=get32(p_uhkc,0)+get32(p_uhkc,4)+get32(p_uhkc,8);
        if(tbamk==248){
          if(thkc2==225){
            if(tbamk>thkc2){ k4=1; }
          }
        }
      }
    }
  }
  let k5:i32=0;
  if(get32(pall,0)==43){
    if(get32(pall,4)==113){
      if(get32(pall,8)==-80){ k5=1; }
    }
  }
  // K6: UCB x V_BAMK @30 = 138 > UCB x V_WK @30 = 128.
  let k6:i32=0;
  if(get32(p_ubamk,4)==138){
    if(get32(p_uwk,4)==128){ k6=1; }
  }
  // K7: UCB x V_BAMK @45 = 40 < UCB x V_WK @45 = 55.
  let k7:i32=0;
  if(get32(p_ubamk,8)==40){
    if(get32(p_uwk,8)==55){ k7=1; }
  }
  let k8:i32=0;
  if(get32(wc,0)==153){ k8=1; }
  // K9 (divergence): UCB x V_BAMK total 248 < UCB x V_WK total 258.
  let tot_ubamk:i32=get32(p_ubamk,0)+get32(p_ubamk,4)+get32(p_ubamk,8);
  let tot_uwk:i32=get32(p_uwk,0)+get32(p_uwk,4)+get32(p_uwk,8);
  let k9:i32=0;
  if(tot_ubamk==248){
    if(tot_uwk==258){
      if(tot_ubamk<tot_uwk){ k9=1; }
    }
  }
  // K10 (divergence): V_XMG total 243 < UCB x V_WK total 258.
  let tot_xmg:i32=get32(p_xmg,0)+get32(p_xmg,4)+get32(p_xmg,8);
  let k10:i32=0;
  if(tot_xmg==243){
    if(tot_uwk==258){
      if(tot_xmg<tot_uwk){ k10=1; }
    }
  }
  at=ob_app(ob,at,"K1STRUCT=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," K3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," K4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," K5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," K6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," K7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," K8=");
  at=ob_i32(ob,at,k8);
  at=ob_app(ob,at," K9=");
  at=ob_i32(ob,at,k9);
  at=ob_app(ob,at," K10=");
  at=ob_i32(ob,at,k10);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCBA-END\n");
  let out:[]u8=ob[0..at];
  _zag_print(out);
  return 0;
}

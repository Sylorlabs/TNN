// a_driver.zag -- adversarial teacher experiments for grammar inquiry.
// Four worlds, one binary. Learner machinery (a_patch.zag) is unchanged
// from grammar_inquiry; only the teacher side is adversarial.
// All worlds use NEG-AMB teaching: literals {2,4,6}, P = a*8+b,
// diagonal-only facts (true D=8, initial g=18, consistent {8,17}).
// ADV-CTRL (wid 10): cooperative simulate-and-shrink teacher (copied
//   from grammar_inquiry); driver-fidelity control.
// ADV-LIE (wid 11): lying teacher answers the inquiry with (35,42,2):
//   false in the true world, op-consistent with d=17, kills d=8.
// ADV-WASTE (wid 12): wasting teacher answers with true but
//   non-discriminating facts (20,41,-2),(34,41,2),(38,41,-2),(52,41,2).
// ADV-POISON (wid 13): poisoning teacher answers with (0,43,63): a
//   false decomp fact, never scanned by the op check, trusted into W,
//   corrupting the induced grammar's literal ranges.
// Teachers are plain functions (0 modes/bridges/handlers).
// SUB=41, DIV=42, DSUB=43, DDIV=44, BUILD=45.

// ---- NEG-AMB teaching (literals {2,4,6}, P = a*8+b, diagonal only) ----

fn cn_P(a:i32,b:i32)i32 { return a*8+b; }

fn cn_teach(W:[]u8)void {
  let a:i32=2;
  while(a<=6){
    let p:i32=cn_P(a,a);
    ev_teach_in(W,p,41,0);
    ev_teach_in(W,p,42,1);
    a=a+2;
  }
  ev_teach_in(W,0,43,cn_P(2,2));
  ev_teach_in(W,0,43,cn_P(4,4));
  ev_teach_in(W,0,43,cn_P(6,6));
  ev_teach_in(W,1,44,cn_P(2,2));
  ev_teach_in(W,1,44,cn_P(4,4));
  ev_teach_in(W,1,44,cn_P(6,6));
  ev_teach_in(W,0,45,cn_P(2,2));
  ev_teach_in(W,1,45,cn_P(2,2));
  return;
}

// ---- cooperative teacher (copied from grammar_inquiry; ADV-CTRL) ----

fn c_inq_lattice(wid:i32,lo:[]u8,hi:[]u8,st:[]u8,Db:[]u8)void {
  set32(lo,0,2); set32(hi,0,6); set32(st,0,2); set32(Db,0,8);
  return;
}

fn c_teacher_answer(W:[]u8,wid:i32,refuse:i32,g:i32,cands:[]u8,nc:i32)i32 {
  if(refuse==1){emit("GI-TEACHER-REFUSED\n"); return 0;}
  let lo:[]u8=z_alloc(16); let hi:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(16); let Db:[]u8=z_alloc(16);
  c_inq_lattice(wid,lo,hi,st,Db);
  let Dt:i32=get32(Db,0);
  let step:i32=get32(st,0); let top:i32=get32(hi,0);
  let after:[]u8=z_alloc(256);
  let a:i32=get32(lo,0);
  while(a<=top){
    let b:i32=get32(lo,0);
    while(b<=top){
      let P:i32=Dt*a+b;
      let t:i32=a-b;
      if(gi_fact_ok(Dt,P,41,t)==1){
        let n2:i32=gi_cands_after(W,g,P,41,t,after);
        if(n2>=1 && n2<nc){
          ev_teach_in(W,P,41,t);
          emit("GI-ANSWER P="); e64(P); emit(" op=41 t="); e64(t); emit("\n");
          return 1;
        }
      }
      if(b>0 && a-(a/b)*b==0){
        let t2:i32=a/b;
        if(gi_fact_ok(Dt,P,42,t2)==1){
          let n2:i32=gi_cands_after(W,g,P,42,t2,after);
          if(n2>=1 && n2<nc){
            ev_teach_in(W,P,42,t2);
            emit("GI-ANSWER P="); e64(P); emit(" op=42 t="); e64(t2); emit("\n");
            return 1;
          }
        }
      }
      b=b+step;
    }
    a=a+step;
  }
  emit("GI-TEACHER-NO-DISCRIMINATOR\n");
  return 0;
}

// ---- adversarial teachers ----

// ADV-LIE: answers the inquiry with (35,42,2). FALSE in the true
// world (gi_fact_ok(8,35,42,2)==0: decodes (4,3), 4/3 not exact; the
// true world never teaches P=35), but op-consistent with the wrong
// divisor d=17 (decodes (2,1), 2/1=2==t) and inconsistent with the
// true divisor d=8. S-contribution 0 (DIV with t=2, not unit), so g
// stays 18 and re-induction sees the consistent set {17}.
fn adv_lie_answer(W:[]u8)i32 {
  ev_teach_in(W,35,42,2);
  emit("GI-ADV-LIE-ANSWER P=35 op=42 t=2\n");
  return 1;
}

// ADV-WASTE: answers with true but non-discriminating facts. Each is
// endorsed by the true world (gi_fact_ok(8,...)==1) and consistent
// with BOTH d=8 and d=17 (gi_fact_ok(17,...)==1), with S-contribution
// a multiple of 18 (g stays 18, consistent set stays {8,17}).
// q=0: (20,41,-2) true pair (2,4); q=1: (34,41,2) true pair (4,2);
// q=2: (38,41,-2) true pair (4,6); q=3: (52,41,2) true pair (6,4).
fn adv_waste_answer(W:[]u8,q:i32)i32 {
  if(q==0){
    ev_teach_in(W,20,41,-2);
    emit("GI-ADV-WASTE-ANSWER P=20 op=41 t=-2\n");
  } else {
    if(q==1){
      ev_teach_in(W,34,41,2);
      emit("GI-ADV-WASTE-ANSWER P=34 op=41 t=2\n");
    } else {
      if(q==2){
        ev_teach_in(W,38,41,-2);
        emit("GI-ADV-WASTE-ANSWER P=38 op=41 t=-2\n");
      } else {
        ev_teach_in(W,52,41,2);
        emit("GI-ADV-WASTE-ANSWER P=52 op=41 t=2\n");
      }
    }
  }
  return 1;
}

// ADV-POISON: answers the inquiry with (0,43,63): a FALSE decomp fact
// (the true world teaches (0,43,P) only for P in {18,36,54};
// 63=7*8+7 is not a true pair). Relation 43 is never scanned by
// gi_codec_op_ok, so the op check cannot catch it. S-contribution
// 63 gives g'=gcd(18,63)=9; candidates from 9 are {2,8}; d=2 is
// killed by the taught eval facts, d=8 survives: the inquiry
// resolves to the TRUE D=8, but the poison fact is trusted into W
// and corrupts the induced grammar's literal ranges (63 decodes to
// (7,7) under D=8, so max_a and max_b become 7, not 6).
fn adv_poison_answer(W:[]u8)i32 {
  ev_teach_in(W,0,43,63);
  emit("GI-ADV-POISON-ANSWER subj=0 op=43 obj=63\n");
  return 1;
}

// ---- grammar reporting (unpacks the divisor field) ----

fn c_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let f4:i32=ng(W,g,4);
  let D:i32=f4/4;
  let nlic:i32=f4-(D*4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" D="); e64(D);
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- single-target battery (target 0; verification probe) ----

fn adv_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-ADV-NOGRAMMAR\n"); return 0;}
  let D:i32=get32(gb,32);
  let t:i32=0;
  let ans:i32=gi_trial_build2(W,t,gb);
  let cl:i32=gi_classify(W,t,D);
  emit("GI-ADV-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
  let vc:i32=0;
  if(cl==1){vc=1;}
  emit("GI-ADV-B-VALID "); e64(vc); emit("/1\n");
  return vc;
}

// ---- adversarial summary (facts only; scoring is in the report) ----

fn adv_summary(wid:i32,code:i32,qi:i32,qa:i32,W:[]u8)void {
  if(wid==10){
    emit("GI-ADV-SUMMARY world=ADV-CTRL post="); e64(code);
    emit(" queries="); e64(qi); emit("/"); e64(qa); emit("\n");
  }
  if(wid==11){
    let gw:i32=gi_grammar_find(W);
    let D:i32=-1;
    if(gw>=0){D=ng(W,gw,4)/4;}
    emit("GI-ADV-SUMMARY world=ADV-LIE post="); e64(code);
    emit(" D="); e64(D); emit(" grammar_written=");
    if(gw>=0){emit("1");} else {emit("0");}
    emit("\n");
  }
  if(wid==12){
    let gw:i32=gi_grammar_find(W);
    emit("GI-ADV-SUMMARY world=ADV-WASTE post="); e64(code);
    emit(" queries="); e64(qi); emit("/"); e64(qa);
    emit(" grammar_written=");
    if(gw>=0){emit("1");} else {emit("0");}
    emit("\n");
  }
  if(wid==13){
    let gw:i32=gi_grammar_find(W);
    let DD:i32=-1; let mina:i32=-1; let maxa:i32=-1;
    let minb:i32=-1; let maxb:i32=-1;
    if(gw>=0){
      DD=ng(W,gw,4)/4;
      mina=ng(W,gw,16); maxa=ng(W,gw,20);
      minb=ng(W,gw,24); maxb=ng(W,gw,28);
    }
    emit("GI-ADV-SUMMARY world=ADV-POISON post="); e64(code);
    emit(" D="); e64(DD);
    emit(" a=["); e64(mina); emit(","); e64(maxa); emit("]");
    emit(" b=["); e64(minb); emit(","); e64(maxb); emit("]\n");
  }
  return;
}

// ---- world runner (with active-inquiry loop, QMAX=4) ----

fn adv_world(wid:i32)i32 {
  emit("GI-ADV-WORLD ");
  if(wid==10){emit("ADV-CTRL\n");}
  if(wid==11){emit("ADV-LIE\n");}
  if(wid==12){emit("ADV-WASTE\n");}
  if(wid==13){emit("ADV-POISON\n");}
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  cn_teach(W1);
  let code:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(code); emit("\n");
  // Active inquiry: -4 is the inquiry trigger. Up to QMAX=4 rounds:
  // induce2 -> inquire -> adversarial teacher answers -> pure
  // re-induce. Stops on resolve, contradiction, refusal, or QMAX
  // exhaustion. The loop is entered only on -4.
  let qi:i32=0; let qa:i32=0;
  if(code==-4){
    let qq:i32=0;
    while(qq<4 && code==-4){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W1,gb,cb,nb);
      gi_inquire(get32(gb,0),cb,get32(nb,0)); qi=qi+1;
      let ans:i32=0;
      if(wid==10){ans=c_teacher_answer(W1,wid,0,get32(gb,0),cb,get32(nb,0));}
      if(wid==11){ans=adv_lie_answer(W1);}
      if(wid==12){ans=adv_waste_answer(W1,qq);}
      if(wid==13){ans=adv_poison_answer(W1);}
      if(ans==0){break;}
      qa=qa+1;
      let r2:i32=gi_codec_induce(W1);
      if(r2>0){code=gi_induce(W1);}
      else {code=r2;}
      qq=qq+1;
    }
    emit("GI-QUERIES issued="); e64(qi); emit(" answered="); e64(qa); emit("\n");
  }
  emit("GI-INDUCED-POST "); e64(code); emit("\n");
  c_report_grammar(W1);
  if(code==1){
    emit("GI-ADV-BATTERY\n");
    let v:i32=adv_arm_induce(W1);
    emit("GI-ADV-WORLD-VALID "); e64(v); emit("\n");
  } else {
    emit("GI-ADV-NOGRAMMAR\n");
    emit("GI-ADV-WORLD-VALID 0\n");
  }
  adv_summary(wid,code,qi,qa,W1);
  return code;
}

fn main()i32 {
  emit("GI-ADV-START\n");
  let c10:i32=adv_world(10);
  let c11:i32=adv_world(11);
  let c12:i32=adv_world(12);
  let c13:i32=adv_world(13);
  emit("GI-ADV-DONE\n");
  return 0;
}

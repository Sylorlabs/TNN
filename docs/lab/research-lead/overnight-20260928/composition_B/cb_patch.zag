// cb_patch.zag -- Composition via persistent co-use connection history.
// Hypothesis B (Micah TOP PRIORITY): fragment composition guided by
// learned persistent connections, not designed contracts.
//
// Extends pc_patch.zag (structural rebinding + type-14 rebind links) with:
//
//  (1) Co-use LINK edges (type 15): when two MAPs are used together
//      successfully in one episode (X's output feeds Y's input),
//      write a persistent edge new -> prev meaning "used together,
//      prev first then new". Written by the episode success event
//      (ev_cq), never authored by the driver. Endpoints are whichever
//      MAPs actually solved the episode queries (learner-determined).
//
//  (2) compose_try: for a query that rebind cannot solve, scan type-15
//      edges for fragment pairs (b -> a). Stage a's shape on the query
//      subject (masked), stage b's shape on the intermediate, assemble
//      ONE composed chain from both stages' grounded values, verify
//      against expected, promote. The composed MAP gets type-14 links
//      to both fragments ("fragments helped construct composed").
//
// ev_query order: activate -> rebind_try -> compose_try -> trial ->
// bootstrap. compose_try only fires when rebind fails.

fn phase_a_enabled()i32 { return 1; }
// Walk a promoted graph root. If it is a pure chain
// (guard --true--> set --SEQ--> guard --true--> set ...),
// return the value-chain length plen = guards+1. Else -1.
// Verbatim from adv_patch.zag.
fn rb_chain_plen(W:[]u8,root:i32)i32 {
  let n102:i32=0; let n101:i32=0;
  let cur:i32=root; let exp102:i32=1; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      n102=n102+1; cur=ng(W,cur,12); exp102=0;
    } else {
      if(tag!=101){return -1;}
      n101=n101+1; cur=seq_nx(W,cur); exp102=1;
    }
    steps=steps+1;
  }
  if(cur!=-1){return -1;}
  if(n102==0){return -1;}
  if(n102!=n101){return -1;}
  return n102+1;
}
// 1 if MAP m has an outgoing type-14 LINK edge (was built via rebind).
fn pc_is_linked(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// Delete all type-14 LINK edges. Ablation hook (driver-called).
fn pc_del_links(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Try one MAP's shape on the query. On verified success, promote the
// rebound and write the persistent LINK edge new -> helper.
fn pc_try_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,paths:[]u8,np:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen>=2){
    let p:i32=0;
    while(p<np && ans==-2){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        let j:i32=0;
        while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,v,plen,f);
        let v2:i32=t2_try_verify(W,nr,s,expected,masked,st);
        if(v2!=-2){
          let bm:i32=promote_graph(W,nr,s,r,v2,f,plen-1);
          if(bm>=0){link_edge(W,bm,14,m,0);}
          ans=v2;
        }
      }
      p=p+1;
    }
  }
  return ans;
}
fn rebind_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  // Pass 1: linked MAPs (prior successful rebinds), newest first.
  let m:i32=1023;
  while(m>=2 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==1){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m-1;
  }
  // Pass 2: all other MAPs in id order.
  m=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && pc_is_linked(W,m)==0){
      ans=pc_try_one(W,m,s,r,expected,masked,paths,np,st);
    }
    m=m+1;
  }
  return ans;
}
// ---- Hypothesis B: co-use connection history (type 15) ----
// newest live MAP id, -1 if none.
fn cb_newest_map(W:[]u8)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){return m;}
    m=m-1;
  }
  return -1;
}
// Write co-use LINK newM -> prevM (type 15). 1 if written.
fn cb_couse_link(W:[]u8,newM:i32,prevM:i32)i32 {
  if(newM<0 || prevM<0 || newM==prevM){return 0;}
  if(ng(W,newM,0)!=20 || ng(W,prevM,0)!=20){return 0;}
  if(ng(W,newM,36)!=1 || ng(W,prevM,36)!=1){return 0;}
  link_edge(W,newM,15,prevM,0);
  return 1;
}
// Delete all type-15 co-use edges. Ablation hook (driver-called).
fn cb_del_couse(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==15){es(W,e,0,-1);}
    e=e+1;
  }
  return;
}
// Count type-15 co-use edges.
fn cb_count15(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){n=n+1;}
    e=e+1;
  }
  return n;
}
// Stage: instantiate MAP m's chain shape on subject s (masked execution).
// On success, writes the grounded value chain into v_out (plen i32s) and
// licensing facts into f_out (plen-1 i32s); returns terminal value.
// Returns -999999 if no plen-matching path executes.
fn cb_stage(W:[]u8,m:i32,s:i32,v_out:[]u8,f_out:[]u8)i32 {
  let plen:i32=rb_chain_plen(W,ng(W,m,20));
  if(plen<2 || plen>8){return -999999;}
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==plen){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(64);
      let j:i32=0;
      while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
      j=0;
      while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
      let root:i32=t2_asm_chain(W,v,plen,f);
      if(root>=0){
        let ex:i32=t2_exec(W,root,s);
        if(ex!=-999999){
          j=0;
          while(j<plen){set32(v_out,j*4,get32(v,j*4)); j=j+1;}
          j=0;
          while(j<plen-1){set32(f_out,j*4,get32(f,j*4)); j=j+1;}
          return ex;
        }
      }
    }
    p=p+1;
  }
  return -999999;
}
// Compose an answer from LINK-connected (type 15) fragment pairs.
// For each edge b -> a ("a used before b"): stage a on (s), stage b on
// the intermediate, assemble one composed chain, verify vs expected,
// promote with type-14 links to both fragments. Returns answer or -2.
fn compose_try(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let ans:i32=-2;
  let pairs:i32=0;
  let e:i32=0;
  while(e<4096 && ans==-2){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      let b:i32=eg(W,e,0); let a:i32=eg(W,e,8);
      if(ng(W,a,36)==1 && ng(W,b,36)==1 && ng(W,a,0)==20 && ng(W,b,0)==20){
        let pa:i32=rb_chain_plen(W,ng(W,a,20));
        let pb:i32=rb_chain_plen(W,ng(W,b,20));
        if(pa>=2 && pb>=2 && pa+pb-1<=12){
          pairs=pairs+1;
          let v1:[]u8=z_alloc(64); let f1:[]u8=z_alloc(64);
          let mid:i32=cb_stage(W,a,s,v1,f1);
          if(mid!=-999999){
            let v2:[]u8=z_alloc(64); let f2:[]u8=z_alloc(64);
            let a2:i32=cb_stage(W,b,mid,v2,f2);
            if(a2!=-999999){
              let pc:i32=pa+pb-1;
              let vc:[]u8=z_alloc(64); let fc:[]u8=z_alloc(64);
              let j:i32=0;
              while(j<pa){set32(vc,j*4,get32(v1,j*4)); j=j+1;}
              j=1;
              while(j<pb){set32(vc,(pa-1+j)*4,get32(v2,j*4)); j=j+1;}
              j=0;
              while(j<pa-1){set32(fc,j*4,get32(f1,j*4)); j=j+1;}
              j=0;
              while(j<pb-1){set32(fc,(pa-1+j)*4,get32(f2,j*4)); j=j+1;}
              let root:i32=t2_asm_chain(W,vc,pc,fc);
              if(root>=0){
                let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
                let vfy:i32=t2_try_verify(W,root,s,expected,0,st);
                if(vfy!=-2){
                  let mz:i32=promote_graph(W,root,s,r,vfy,fc,pc-1);
                  if(mz>=0){
                    link_edge(W,mz,14,a,0);
                    link_edge(W,mz,14,b,0);
                  }
                  ans=vfy;
                }
              }
            }
          }
        }
      }
    }
    e=e+1;
  }
  if(pairs>0){ emit("COMPOSE pairs="); e64(pairs); emit("\n"); }
  return ans;
}
// ev_query: activate -> rebind_try -> compose_try -> trial -> bootstrap.
// compose_try (Hypothesis B) fires only when rebind cannot solve.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- Hypothesis B: compose from co-use LINK history ----
  let ca:i32=compose_try(W,s,r,expected);
  if(ca!=-2){
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}
// Chained query for co-use episodes (driver-called). chain=0 starts an
// episode; chain=1 links this query's promoted MAP to the previous step's
// MAP via a type-15 co-use edge. prevM tracked in header 56 (free; init
// zeroed, -1 = none). Returns the query answer (-2 on miss).
// The LINK is written by this success event; the driver supplies only the
// queries, never the endpoints.
fn ev_cq(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,chain:i32)i32 {
  let m0:i32=cb_newest_map(W);
  let ans:i32=ev_query(W,s,r,expected,flags);
  if(ans==-2){return -2;}
  let m1:i32=cb_newest_map(W);
  if(m1<0 || m1==m0){return ans;}
  if(chain==1){
    let prev:i32=hg(W,56);
    cb_couse_link(W,m1,prev);
  }
  hs(W,56,m1);
  return ans;
}

// cb_driver.zag -- Composition Hypothesis B experiment driver.
// Tests whether co-use LINK history (type 15) enables X+Y -> Z composition.
//
// Phases: train X (plen-3, r1) -> train Y (plen-5, r2) -> [co-use episodes]
// -> Z facts (mixed plen-7, beyond trial reach) -> Z query -> W (reuse).
//
// Arms:
//   TREAT:    full (co-use episodes write type-15 links).
//   ABL-COUSE: full TREAT, then cb_del_couse() before Z (link removed,
//              everything else identical).
//   ABL-NOEP: skip co-use episodes (no type-15 ever written).
//   FRESH:    Z only (no X/Y training at all).

// ---- instrumentation ----
fn cb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cb_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cb_ncount(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1){n=n+1;}
    m=m+1;
  }
  return n;
}
// find MAP promoted for (s,r); -1 if none.
fn cb_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// dump type-15 co-use edges with endpoint plens.
fn cb_dump15(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==15){
      let b:i32=eg(W,e,0); let a:i32=eg(W,e,8);
      emit("  COUSE15 "); e64(b); emit("(plen ");
      e64(rb_chain_plen(W,ng(W,b,20))); emit(") -> "); e64(a); emit("(plen ");
      e64(rb_chain_plen(W,ng(W,a,20))); emit(")\n");
    }
    e=e+1;
  }
  return;
}
// dump type-14 edges out of MAP m with endpoint plens.
fn cb_dump14of(W:[]u8,m:i32)void {
  if(m<0){emit("  (no MAP)\n"); return;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){
      let t:i32=eg(W,e,8);
      emit("  LINK14 "); e64(m); emit(" -> "); e64(t); emit(" (plen ");
      e64(rb_chain_plen(W,ng(W,t,20))); emit(")\n");
    }
    e=e+1;
  }
  return;
}
fn cb_gap(W:[]u8)void {
  let i:i32=0;
  while(i<20){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// ---- Phase 1: teach X (plen-3 chains, relation r1=1, queried as 61) ----
fn cb_trainX(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x1:i32=ev_query(W,11,61,13,0);
  emit("X1 ans="); e64(x1); cb_tstat(W);
  ev_teach(W,14,1,15); ev_teach(W,15,1,16);
  let x2:i32=ev_query(W,14,61,16,0);
  emit("X2 ans="); e64(x2); cb_tstat(W);
  emit("after X: maps="); e64(cb_count_maps(W)); emit("\n");
  return;
}
// ---- Phase 2: teach Y (plen-5 chains, relation r2=2, queried as 62) ----
fn cb_trainY(W:[]u8)void {
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24); ev_teach(W,24,2,25);
  let y1:i32=ev_query(W,21,62,25,0);
  emit("Y1 ans="); e64(y1); cb_tstat(W);
  ev_teach(W,26,2,27); ev_teach(W,27,2,28); ev_teach(W,28,2,29); ev_teach(W,29,2,30);
  let y2:i32=ev_query(W,26,62,30,0);
  emit("Y2 ans="); e64(y2); cb_tstat(W);
  emit("after Y: maps="); e64(cb_count_maps(W)); emit("\n");
  return;
}
// ---- Phase 3: co-use episodes (TREAT only). X output feeds Y input. ----
// The driver supplies queries; the LINK endpoints are whichever MAPs
// actually solve (written by ev_cq, never authored here).
fn cb_couse(W:[]u8)void {
  hs(W,56,-1);
  // episode 1: X chain 41->42->43, then Y chain 43->44->45->46->47.
  ev_teach(W,41,1,42); ev_teach(W,42,1,43);
  ev_teach(W,43,2,44); ev_teach(W,44,2,45); ev_teach(W,45,2,46); ev_teach(W,46,2,47);
  let a1:i32=ev_cq(W,41,61,43,0,0);
  let a2:i32=ev_cq(W,43,62,47,0,1);
  emit("EP1 a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" couse15="); e64(cb_count15(W)); emit("\n");
  // episode 2: fresh literals, same X->Y structure.
  ev_teach(W,51,1,52); ev_teach(W,52,1,53);
  ev_teach(W,53,2,54); ev_teach(W,54,2,55); ev_teach(W,55,2,56); ev_teach(W,56,2,57);
  let b1:i32=ev_cq(W,51,61,53,0,0);
  let b2:i32=ev_cq(W,53,62,57,0,1);
  emit("EP2 b1="); e64(b1); emit(" b2="); e64(b2);
  emit(" couse15="); e64(cb_count15(W)); emit("\n");
  cb_dump15(W);
  return;
}
// ---- Phase 4: Z facts (mixed r1+r2, plen 7: beyond trial gather depth) ----
fn cb_zfacts(W:[]u8)void {
  ev_teach(W,31,1,32); ev_teach(W,32,1,33);
  ev_teach(W,33,2,34); ev_teach(W,34,2,35); ev_teach(W,35,2,36); ev_teach(W,36,2,37);
  return;
}
fn cb_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,50,37,0);
  emit("Z ans="); e64(z); cb_tstat(W);
  let zm:i32=cb_find_map(W,31,50);
  emit("ZMAP id="); e64(zm);
  emit(" plen="); e64(rb_chain_plen(W,ng(W,zm,20))); emit("\n");
  emit("ZMAP fragment links:\n");
  cb_dump14of(W,zm);
  return;
}
// ---- Phase 5: W facts (fresh literals, same X->Y shape): reuse test ----
fn cb_wfacts(W:[]u8)void {
  ev_teach(W,61,1,62); ev_teach(W,62,1,63);
  ev_teach(W,63,2,64); ev_teach(W,64,2,65); ev_teach(W,65,2,66); ev_teach(W,66,2,67);
  return;
}
fn cb_wquery(W:[]u8)void {
  let w:i32=ev_query(W,61,50,67,0);
  emit("W ans="); e64(w); cb_tstat(W);
  let wm:i32=cb_find_map(W,61,50);
  emit("WMAP id="); e64(wm);
  emit(" plen="); e64(rb_chain_plen(W,ng(W,wm,20))); emit("\n");
  return;
}
// ============ arms ============
fn cb_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  cb_trainX(W); cb_trainY(W); cb_gap(W);
  cb_couse(W); cb_gap(W);
  cb_zfacts(W); cb_zquery(W);
  cb_wfacts(W); cb_wquery(W);
  emit("TREAT nodes="); e64(cb_ncount(W)); emit(" maps="); e64(cb_count_maps(W));
  emit(" couse15="); e64(cb_count15(W)); emit("\n");
  return;
}
fn cb_abl_couse(W:[]u8)void {
  emit("=== ABL-COUSE (links deleted) ===\n");
  cb_trainX(W); cb_trainY(W); cb_gap(W);
  cb_couse(W); cb_gap(W);
  emit("pre-del couse15="); e64(cb_count15(W)); emit("\n");
  cb_del_couse(W);
  emit("post-del couse15="); e64(cb_count15(W)); emit("\n");
  cb_zfacts(W); cb_zquery(W);
  emit("ABL-COUSE nodes="); e64(cb_ncount(W)); emit("\n");
  return;
}
fn cb_abl_noep(W:[]u8)void {
  emit("=== ABL-NOEP (no co-use episodes) ===\n");
  cb_trainX(W); cb_trainY(W); cb_gap(W);
  emit("couse15="); e64(cb_count15(W)); emit(" (expect 0)\n");
  cb_zfacts(W); cb_zquery(W);
  emit("ABL-NOEP nodes="); e64(cb_ncount(W)); emit("\n");
  return;
}
fn cb_fresh(W:[]u8)void {
  emit("=== FRESH (Z only) ===\n");
  cb_gap(W);
  cb_zfacts(W); cb_zquery(W);
  emit("FRESH nodes="); e64(cb_ncount(W)); emit("\n");
  return;
}
fn main()i32 {
  emit("COMPOSE-B-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); cb_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); cb_abl_couse(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); cb_abl_noep(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); cb_fresh(W4);
  emit("COMPOSE-B-END\n");
  return 0;
}

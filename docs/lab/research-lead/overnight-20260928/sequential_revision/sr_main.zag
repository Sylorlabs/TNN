// sr_main.zag -- sequential_revision driver. Runs the frozen phase plan:
// TEACH, Z2, REFUTE-1, REVISE-1, RETEST-1, REGRESS-1, GENERALIZE-1,
// WORLD-CHANGE, Z3, REFUTE-2, REVISE-2, RETEST-2, REGRESS-2,
// GENERALIZE-2, PRESERVE-CHECK. Goal inputs (33, 70) and evaluation
// inputs (40, 60, 50, 80) are lab task setup. The learner's operators
// receive no values from the driver: they read ce cells and the
// observation log. World-kind values in the transcript are driver
// instrumentation (fixed world machinery applied to true D outputs),
// never answers shown to the learner; the learner's state is not
// updated by evaluation lines. All emit helpers are cursor-returning.

// Emit one evaluation line: learner rule prediction vs world truth.
fn emit_eval(b:[]u8,c:i32,tag:[]u8,inv:i32,L:[]u8,E:[]u8,unprobed:i32)i32 {
  let rp:i32=rule_pred(L,inv);
  let wk:i32=kind_probe(E,D_true(inv));
  c=e1str(b,c,tag);
  c=e1str(b,c," D(");
  c=e1i64(b,c,inv as i64);
  c=e1str(b,c,") rule-pred=");
  c=e1kind(b,c,rp);
  c=e1str(b,c," world-kind=");
  c=e1kind(b,c,wk);
  if(rp==wk){c=e1str(b,c," MATCH");}else{c=e1str(b,c," MISMATCH");}
  if(unprobed==1){c=e1str(b,c," unprobed");}
  c=e1str(b,c,"\n");
  return c;
}
// Emit one teaching OBS line and append the outcome to the log.
fn teach_probe(b:[]u8,c:i32,L:[]u8,E:[]u8,inv:i32)i32 {
  let out:i32=D_true(inv);
  let k:i32=kind_probe(E,out);
  obs_append(L,inv,k);
  c=e1str(b,c,"OBS D in=");
  c=e1i64(b,c,inv as i64);
  c=e1str(b,c," out=");
  c=e1i64(b,c,out as i64);
  c=e1str(b,c," kind=");
  c=e1kind(b,c,k);
  c=e1str(b,c,"\n");
  return c;
}
// Emit one commit block: COMMIT, EXEC, CONSEQUENCE, UPDATE.
fn do_commit(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8,gin:i32,want:i32)i32 {
  ls(L,2,gin);
  let pred:i32=rule_pred(L,gin);
  ls(L,1,pred);
  ls(L,3,1);
  c=e1str(b,c,tag);
  c=e1str(b,c," COMMIT comp=DD in=");
  c=e1i64(b,c,gin as i64);
  c=e1str(b,c," pred=");
  c=e1kind(b,c,pred);
  c=e1str(b,c," status=PENDING\n");
  let a1:i32=D_true(gin);
  let a2:i32=D_true(a1);
  let fk:i32=kind_probe(E,a2);
  c=e1str(b,c,tag);
  c=e1str(b,c," EXEC D(");
  c=e1i64(b,c,gin as i64);
  c=e1str(b,c,")=");
  c=e1i64(b,c,a1 as i64);
  c=e1str(b,c," D(");
  c=e1i64(b,c,a1 as i64);
  c=e1str(b,c,")=");
  c=e1i64(b,c,a2 as i64);
  c=e1str(b,c," final-kind=");
  c=e1kind(b,c,fk);
  c=e1str(b,c,"\n");
  let g:i32=world_downstream(E,fk,want);
  c=e1str(b,c,tag);
  c=e1str(b,c," CONSEQUENCE gate=");
  c=e1i64(b,c,g as i64);
  if(g==1){c=e1str(b,c," ACCEPT");}else{c=e1str(b,c," REJECT");}
  c=e1str(b,c," want=");
  c=e1kind(b,c,want);
  c=e1str(b,c,"\n");
  let oldc:i32=lg(L,0);
  let newc:i32=oldc-1;
  if(g==1){newc=oldc+1;}
  ls(L,0,newc);
  c=e1str(b,c,tag);
  c=e1str(b,c," UPDATE conf ");
  c=e1i64(b,c,oldc as i64);
  c=e1str(b,c,"->");
  c=e1i64(b,c,newc as i64);
  c=e1str(b,c," source=gate\n");
  return c;
}
// Emit the refute block from the recorded ce cells (cursor-returning).
fn do_refute(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8)i32 {
  learner_refute(L,E);
  let lk:i32=lg(L,114);
  let ci:i32=lg(L,5);
  let cp:i32=lg(L,6);
  let ca:i32=lg(L,7);
  c=e1str(b,c,tag);
  c=e1str(b,c," link=");
  c=e1i64(b,c,lk as i64);
  c=e1str(b,c," in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c," rule-pred=");
  c=e1kind(b,c,cp);
  c=e1str(b,c," probed-out=");
  c=e1i64(b,c,D_true(ci) as i64);
  c=e1str(b,c," probed-kind=");
  c=e1kind(b,c,ca);
  c=e1str(b,c," MISMATCH\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," COUNTEREXAMPLE comp=D in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c," pred=");
  c=e1kind(b,c,cp);
  c=e1str(b,c," actual=");
  c=e1kind(b,c,ca);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," RULE-REFUTED rule=");
  c=e1rule(b,c,L,0,0);
  c=e1str(b,c," on in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c,"\n");
  return c;
}
// Emit the revise block: boundary search line, before/after rule line,
// tree dump, rule fit. Snapshots node 0/1 when asked (after REVISE-1).
fn do_revise(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8,snap:i32)i32 {
  let tmp:[]u8=z_alloc(256);
  let tc:i32=e1rule(tmp,0,L,0,0);
  boundary_search(L,E);
  let npr:i32=lg(L,107);
  let sT:i32=lg(L,106);
  let in0:i32=lg(L,5);
  c=e1str(b,c,tag);
  c=e1str(b,c," SEARCH nprobes=");
  c=e1i64(b,c,npr as i64);
  c=e1str(b,c," T=");
  c=e1i64(b,c,sT as i64);
  c=e1str(b,c," trail=");
  let tv:i32=in0-1;
  while(tv>=sT-1){
    c=e1str(b,c,"(");
    c=e1i64(b,c,tv as i64);
    c=e1str(b,c,":");
    c=e1kind(b,c,kind_probe(E,D_true(tv)));
    c=e1str(b,c,")");
    tv=tv-1;
  }
  c=e1str(b,c,"\n");
  learner_refine(L);
  c=e1str(b,c,tag);
  c=e1str(b,c," before=");
  c=e1str(b,c,tmp[0..tc]);
  c=e1str(b,c," after=");
  c=e1rule(b,c,L,0,0);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," TREE-DUMP ");
  c=e1treedump(b,c,L);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," RULE-FIT fit=");
  c=e1i64(b,c,rule_fit(L) as i64);
  c=e1str(b,c,"/");
  c=e1i64(b,c,obs_n(L) as i64);
  c=e1str(b,c,"\n");
  if(snap==1){
    ls(L,108,nget(L,0,0));
    ls(L,109,nget(L,0,1));
    ls(L,110,nget(L,0,2));
    ls(L,111,nget(L,0,3));
    ls(L,112,nget(L,1,0));
    ls(L,113,nget(L,1,1));
  }
  return c;
}
fn main()void {
  let L:[]u8=z_alloc(512);
  let E:[]u8=z_alloc(64);
  let OUT:[]u8=z_alloc(16384);
  let oc:i32=0;
  ls(L,4,-1);
  world_init(E);
  // TEACH (W1)
  oc=teach_probe(OUT,oc,L,E,31);
  oc=teach_probe(OUT,oc,L,E,32);
  rule_induce(L);
  oc=e1str(OUT,oc,"TEACH rule=");
  oc=e1rule(OUT,oc,L,0,0);
  oc=e1str(OUT,oc," nobs=");
  oc=e1i64(OUT,oc,obs_n(L) as i64);
  oc=e1str(OUT,oc,"\n");
  // Z2: goal in=33 want NODE
  oc=do_commit(OUT,oc,"Z2",L,E,33,1);
  // REFUTE-1 + REVISE-1
  oc=do_refute(OUT,oc,"REFUTE-1",L,E);
  oc=do_revise(OUT,oc,"REVISE-1",L,E,1);
  // RETEST-1, REGRESS-1, GENERALIZE-1
  oc=emit_eval(OUT,oc,"RETEST-1",33,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-1",31,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-1",32,L,E,0);
  oc=emit_eval(OUT,oc,"GENERALIZE-1",40,L,E,1);
  oc=emit_eval(OUT,oc,"GENERALIZE-1",60,L,E,1);
  // WORLD-CHANGE: W1 -> W2 (learner is not told; it only experiences Z3)
  world_change(E);
  oc=e1str(OUT,oc,"WORLD-CHANGE kind-law W1->W2 (STR band added: x>=67 -> STR)\n");
  // Z3: goal in=70 want NUM
  oc=do_commit(OUT,oc,"Z3",L,E,70,2);
  // REFUTE-2 + REVISE-2
  oc=do_refute(OUT,oc,"REFUTE-2",L,E);
  oc=do_revise(OUT,oc,"REVISE-2",L,E,0);
  // RETEST-2, REGRESS-2, GENERALIZE-2
  oc=emit_eval(OUT,oc,"RETEST-2",66,L,E,0);
  oc=emit_eval(OUT,oc,"RETEST-2",70,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",31,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",32,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",33,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",40,L,E,0);
  oc=emit_eval(OUT,oc,"GENERALIZE-2",50,L,E,1);
  oc=emit_eval(OUT,oc,"GENERALIZE-2",80,L,E,1);
  // PRESERVE-CHECK: node 0/1 vs snapshot after REVISE-1
  let r0ok:i32=0;
  if(lg(L,108)==nget(L,0,0)){if(lg(L,109)==nget(L,0,1)){if(lg(L,110)==nget(L,0,2)){if(lg(L,111)==nget(L,0,3)){r0ok=1;}}}}
  let r1ok:i32=0;
  if(lg(L,112)==nget(L,1,0)){if(lg(L,113)==nget(L,1,1)){r1ok=1;}}
  oc=e1str(OUT,oc,"PRESERVE-CHECK root-split-intact=");
  if(r0ok==1){oc=e1str(OUT,oc,"yes");}else{oc=e1str(OUT,oc,"no");}
  oc=e1str(OUT,oc," left-leaf-intact=");
  if(r1ok==1){oc=e1str(OUT,oc,"yes");}else{oc=e1str(OUT,oc,"no");}
  oc=e1str(OUT,oc,"\n");
  let _wn:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),oc as i64,0,0,0);
  return;
}

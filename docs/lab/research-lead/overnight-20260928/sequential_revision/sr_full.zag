// sr_mech.zag -- sequential_revision: revise, then revise again when the
// world changes. A learner holds a rule as a threshold TREE in its own
// state. A first verification failure drives revision 1
// (ALWAYS(NODE) -> IF(in<33,NODE,NUM)) via the generic operators below.
// The world then changes (a new STR kind band appears); a second
// verification failure drives revision 2, which re-splits only the
// responsible leaf, leaving the first revision's nodes byte-identical.
//
// Standalone pure-Zag program. Conventions: L = learner state slice,
// E = world state slice. Output is formatted into ONE preallocated
// buffer; the driver performs a single _zag_raw_syscall write at the end
// (no _zag_print for dynamic content). State cells are u8-backed with
// little-endian get32/set32 (no pointer-cast slice construction).
//
// L cells (i32): 0 conf, 1 commit_pred, 2 commit_input, 3 commit_status
//   (0 none, 1 PENDING, 2 RESOLVED), 4 ce_comp (-1 none), 5 ce_in,
//   6 ce_pred, 7 ce_actual, 114 ce_link,
//   8 obs_count, 9..40 obs log (16 entries of in,kind),
//   41 node_count, 42..105 node pool (16 nodes x 4 cells),
//   106 search_T, 107 search_nprobes,
//   108..111 snapshot of node 0 (tag,a,b,c) after REVISE-1,
//   112..113 snapshot of node 1 (tag,a) after REVISE-1.
// Node: +0 tag (0 leaf, 1 split), +1 a (leaf: kind; split: T),
//   +2 b (split: left idx), +3 c (split: right idx). Root is node 0.
// E cells (byte offsets): 0 kind_law (1 W1, 2 W2), 4 gate,
//   8 accepts, 12 rejects.
// Kind codes: 1 NODE, 2 NUM, 3 STR. Component D id 0.
// There is no lookup list anywhere in this program: prediction is always
// through the rule tree predicate rule_pred.

// ---------- output helpers (one buffer, cursor-returning) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1kind(b:[]u8,c:i32,k:i32)i32 {
  if(k==1){return e1str(b,c,"NODE");}
  if(k==2){return e1str(b,c,"NUM");}
  if(k==3){return e1str(b,c,"STR");}
  return e1str(b,c,"?");
}
// Recursive rule renderer (depth-capped). Reads learner state only.
// A root leaf renders as ALWAYS(kind); nested leaves render as bare
// kinds, so a split reads IF(in<T,klo,khi) with kind branches.
fn e1rule(b:[]u8,c:i32,L:[]u8,nd:i32,dep:i32)i32 {
  if(dep>8){return e1str(b,c,"..");}
  let nb:i32=42+nd*4;
  if(lg(L,nb)==0){
    if(dep>0){return e1kind(b,c,lg(L,nb+1));}
    c=e1str(b,c,"ALWAYS(");
    c=e1kind(b,c,lg(L,nb+1));
    c=e1str(b,c,")");
    return c;
  }
  c=e1str(b,c,"IF(in<");
  c=e1i64(b,c,lg(L,nb+1) as i64);
  c=e1str(b,c,",");
  c=e1rule(b,c,L,lg(L,nb+2),dep+1);
  c=e1str(b,c,",");
  c=e1rule(b,c,L,lg(L,nb+3),dep+1);
  c=e1str(b,c,")");
  return c;
}
// Raw node dump: every node's descriptor, for the white-box check.
fn e1treedump(b:[]u8,c:i32,L:[]u8)i32 {
  let n:i32=lg(L,41);
  c=e1str(b,c,"nodes=");
  c=e1i64(b,c,n as i64);
  c=e1str(b,c," ");
  let i:i32=0;
  while(i<n){
    let nb:i32=42+i*4;
    c=e1str(b,c,"[");
    c=e1i64(b,c,i as i64);
    if(lg(L,nb)==0){
      c=e1str(b,c,":leaf ");
      c=e1kind(b,c,lg(L,nb+1));
    }else{
      c=e1str(b,c,":split T=");
      c=e1i64(b,c,lg(L,nb+1) as i64);
      c=e1str(b,c," L=");
      c=e1i64(b,c,lg(L,nb+2) as i64);
      c=e1str(b,c," R=");
      c=e1i64(b,c,lg(L,nb+3) as i64);
    }
    c=e1str(b,c,"]");
    i=i+1;
  }
  return c;
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }
fn nbase(nd:i32)i32 { return 42+nd*4; }
fn nget(L:[]u8,nd:i32,f:i32)i32 { return lg(L,nbase(nd)+f); }
fn nset(L:[]u8,nd:i32,f:i32,v:i32)void { ls(L,nbase(nd)+f,v); return; }
fn xbase(i:i32)i32 { return 9+i*2; }

// ---------- world ----------
fn D_true(v:i32)i32 { return v+1; }
fn kind_probe(E:[]u8,x:i32)i32 {
  let law:i32=get32(E,0);
  if(law==2){
    if(x<34){return 1;}
    if(x<67){return 2;}
    return 3;
  }
  if(x<34){return 1;}
  return 2;
}
fn world_init(E:[]u8)void {
  set32(E,0,1);
  set32(E,4,0);
  set32(E,8,0);
  set32(E,12,0);
  return;
}
fn world_change(E:[]u8)void {
  set32(E,0,2);
  return;
}
fn world_downstream(E:[]u8,finalk:i32,want:i32)i32 {
  let g:i32=0;
  if(finalk==want){g=1;}
  set32(E,4,g);
  return g;
}

// ---------- learner: observation log ----------
fn obs_n(L:[]u8)i32 { return lg(L,8); }
fn obs_in(L:[]u8,i:i32)i32 { return lg(L,xbase(i)); }
fn obs_k(L:[]u8,i:i32)i32 { return lg(L,xbase(i)+1); }
fn obs_append(L:[]u8,inv:i32,k:i32)void {
  let n:i32=obs_n(L);
  if(n>=16){return;}
  ls(L,xbase(n),inv);
  ls(L,xbase(n)+1,k);
  ls(L,8,n+1);
  return;
}

// ---------- learner: rule induction (generic CONSTANT induction) ----------
fn rule_induce(L:[]u8)void {
  let n:i32=obs_n(L);
  if(n<1){return;}
  let k0:i32=obs_k(L,0);
  let i:i32=1;
  while(i<n){
    if(obs_k(L,i)!=k0){return;}
    i=i+1;
  }
  nset(L,0,0,0);
  nset(L,0,1,k0);
  ls(L,41,1);
  return;
}

// ---------- learner: rule prediction (tree walk; the only prediction path) ----------
fn rule_pred(L:[]u8,inv:i32)i32 {
  let nd:i32=0;
  let guard:i32=0;
  while(guard<24){
    if(nget(L,nd,0)==0){return nget(L,nd,1);}
    let t:i32=nget(L,nd,1);
    if(inv<t){nd=nget(L,nd,2);}else{nd=nget(L,nd,3);}
    guard=guard+1;
  }
  return 0;
}
fn find_leaf(L:[]u8,inv:i32)i32 {
  let nd:i32=0;
  let guard:i32=0;
  while(guard<24){
    if(nget(L,nd,0)==0){return nd;}
    let t:i32=nget(L,nd,1);
    if(inv<t){nd=nget(L,nd,2);}else{nd=nget(L,nd,3);}
    guard=guard+1;
  }
  return nd;
}
fn smallest_mispredicted(L:[]u8)i32 {
  let n:i32=obs_n(L);
  let best:i32=-1;
  let i:i32=0;
  while(i<n){
    let inv:i32=obs_in(L,i);
    if(rule_pred(L,inv)!=obs_k(L,i)){
      if(best==-1){best=inv;}else{if(inv<best){best=inv;}}
    }
    i=i+1;
  }
  return best;
}
fn logged_kind_at(L:[]u8,inv:i32)i32 {
  let n:i32=obs_n(L);
  let i:i32=0;
  while(i<n){
    if(obs_in(L,i)==inv){return obs_k(L,i);}
    i=i+1;
  }
  return 0;
}
fn rule_fit(L:[]u8)i32 {
  let n:i32=obs_n(L);
  let hit:i32=0;
  let i:i32=0;
  while(i<n){
    if(rule_pred(L,obs_in(L,i))==obs_k(L,i)){hit=hit+1;}
    i=i+1;
  }
  return hit;
}

// ---------- learner: refutation (generic chain blame walk) ----------
// Walks the 2 links of DD (both D) from the committed input. Each probe
// outcome joins the observation log. Stops at the first mismatch and
// records the counterexample in learner state. Reads no values from the
// driver; the driver only supplies L and E.
fn learner_refute(L:[]u8,E:[]u8)void {
  let cur:i32=lg(L,2);
  let li:i32=0;
  while(li<2){
    let pred:i32=rule_pred(L,cur);
    let out:i32=D_true(cur);
    let k:i32=kind_probe(E,out);
    obs_append(L,cur,k);
    if(k!=pred){
      ls(L,4,0);
      ls(L,5,cur);
      ls(L,6,pred);
      ls(L,7,k);
      ls(L,114,li);
      return;
    }
    cur=out;
    li=li+1;
  }
  return;
}

// ---------- learner: boundary localization (generic downward inquiry) ----------
// From the recorded counterexample, probe downward while the observed
// kind equals the counterexample kind. Every outcome joins the log.
// The first input with a different kind marks the boundary: T = in+1.
// No-op when no counterexample is recorded. Reads ce cells only.
fn boundary_search(L:[]u8,E:[]u8)void {
  if(lg(L,4)<0){return;}
  let in0:i32=lg(L,5);
  let knew:i32=lg(L,7);
  ls(L,107,0);
  ls(L,106,-1);
  let inv:i32=in0-1;
  let np:i32=0;
  while(np<64){
    if(inv<0){return;}
    let out:i32=D_true(inv);
    let k:i32=kind_probe(E,out);
    obs_append(L,inv,k);
    np=np+1;
    ls(L,107,np);
    if(k!=knew){ls(L,106,inv+1);return;}
    inv=inv-1;
  }
  return;
}

// ---------- learner: refinement (generic smallest-mispredicted re-split) ----------
// Splits only the leaf responsible for the smallest mispredicted input
// in the observation log. All other nodes are untouched, so earlier
// revisions' knowledge is preserved structurally. No-op when the log
// holds no misprediction. Reads the obs log only.
fn learner_refine(L:[]u8)void {
  let ts:i32=smallest_mispredicted(L);
  if(ts<0){return;}
  let leaf:i32=find_leaf(L,ts);
  let oldk:i32=nget(L,leaf,1);
  let knew:i32=logged_kind_at(L,ts);
  let nc:i32=lg(L,41);
  let ln:i32=nc;
  let rn:i32=nc+1;
  nset(L,ln,0,0);
  nset(L,ln,1,oldk);
  nset(L,rn,0,0);
  nset(L,rn,1,knew);
  nset(L,leaf,0,1);
  nset(L,leaf,1,ts);
  nset(L,leaf,2,ln);
  nset(L,leaf,3,rn);
  ls(L,41,nc+2);
  return;
}
// sr_main.zag -- sequential_revision driver. Runs the frozen phase plan:
// TEACH, Z2, REFUTE-1, REVISE-1, RETEST-1, REGRESS-1, GENERALIZE-1,
// WORLD-CHANGE, Z3, REFUTE-2, REVISE-2, RETEST-2, REGRESS-2,
// GENERALIZE-2, PRESERVE-CHECK. Goal inputs (33, 70) and evaluation
// inputs (40, 60, 50, 80) are lab task setup. The learner's operators
// receive no values from the driver: they read ce cells and the
// observation log. World-kind values in the transcript are driver
// instrumentation (fixed world machinery applied to true D outputs),
// never answers shown to the learner; the learner's state is not
// updated by evaluation lines. All emit helpers are cursor-returning.

// Emit one evaluation line: learner rule prediction vs world truth.
fn emit_eval(b:[]u8,c:i32,tag:[]u8,inv:i32,L:[]u8,E:[]u8,unprobed:i32)i32 {
  let rp:i32=rule_pred(L,inv);
  let wk:i32=kind_probe(E,D_true(inv));
  c=e1str(b,c,tag);
  c=e1str(b,c," D(");
  c=e1i64(b,c,inv as i64);
  c=e1str(b,c,") rule-pred=");
  c=e1kind(b,c,rp);
  c=e1str(b,c," world-kind=");
  c=e1kind(b,c,wk);
  if(rp==wk){c=e1str(b,c," MATCH");}else{c=e1str(b,c," MISMATCH");}
  if(unprobed==1){c=e1str(b,c," unprobed");}
  c=e1str(b,c,"\n");
  return c;
}
// Emit one teaching OBS line and append the outcome to the log.
fn teach_probe(b:[]u8,c:i32,L:[]u8,E:[]u8,inv:i32)i32 {
  let out:i32=D_true(inv);
  let k:i32=kind_probe(E,out);
  obs_append(L,inv,k);
  c=e1str(b,c,"OBS D in=");
  c=e1i64(b,c,inv as i64);
  c=e1str(b,c," out=");
  c=e1i64(b,c,out as i64);
  c=e1str(b,c," kind=");
  c=e1kind(b,c,k);
  c=e1str(b,c,"\n");
  return c;
}
// Emit one commit block: COMMIT, EXEC, CONSEQUENCE, UPDATE.
fn do_commit(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8,gin:i32,want:i32)i32 {
  ls(L,2,gin);
  let pred:i32=rule_pred(L,gin);
  ls(L,1,pred);
  ls(L,3,1);
  c=e1str(b,c,tag);
  c=e1str(b,c," COMMIT comp=DD in=");
  c=e1i64(b,c,gin as i64);
  c=e1str(b,c," pred=");
  c=e1kind(b,c,pred);
  c=e1str(b,c," status=PENDING\n");
  let a1:i32=D_true(gin);
  let a2:i32=D_true(a1);
  let fk:i32=kind_probe(E,a2);
  c=e1str(b,c,tag);
  c=e1str(b,c," EXEC D(");
  c=e1i64(b,c,gin as i64);
  c=e1str(b,c,")=");
  c=e1i64(b,c,a1 as i64);
  c=e1str(b,c," D(");
  c=e1i64(b,c,a1 as i64);
  c=e1str(b,c,")=");
  c=e1i64(b,c,a2 as i64);
  c=e1str(b,c," final-kind=");
  c=e1kind(b,c,fk);
  c=e1str(b,c,"\n");
  let g:i32=world_downstream(E,fk,want);
  c=e1str(b,c,tag);
  c=e1str(b,c," CONSEQUENCE gate=");
  c=e1i64(b,c,g as i64);
  if(g==1){c=e1str(b,c," ACCEPT");}else{c=e1str(b,c," REJECT");}
  c=e1str(b,c," want=");
  c=e1kind(b,c,want);
  c=e1str(b,c,"\n");
  let oldc:i32=lg(L,0);
  let newc:i32=oldc-1;
  if(g==1){newc=oldc+1;}
  ls(L,0,newc);
  c=e1str(b,c,tag);
  c=e1str(b,c," UPDATE conf ");
  c=e1i64(b,c,oldc as i64);
  c=e1str(b,c,"->");
  c=e1i64(b,c,newc as i64);
  c=e1str(b,c," source=gate\n");
  return c;
}
// Emit the refute block from the recorded ce cells (cursor-returning).
fn do_refute(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8)i32 {
  learner_refute(L,E);
  let lk:i32=lg(L,114);
  let ci:i32=lg(L,5);
  let cp:i32=lg(L,6);
  let ca:i32=lg(L,7);
  c=e1str(b,c,tag);
  c=e1str(b,c," link=");
  c=e1i64(b,c,lk as i64);
  c=e1str(b,c," in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c," rule-pred=");
  c=e1kind(b,c,cp);
  c=e1str(b,c," probed-out=");
  c=e1i64(b,c,D_true(ci) as i64);
  c=e1str(b,c," probed-kind=");
  c=e1kind(b,c,ca);
  c=e1str(b,c," MISMATCH\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," COUNTEREXAMPLE comp=D in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c," pred=");
  c=e1kind(b,c,cp);
  c=e1str(b,c," actual=");
  c=e1kind(b,c,ca);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," RULE-REFUTED rule=");
  c=e1rule(b,c,L,0,0);
  c=e1str(b,c," on in=");
  c=e1i64(b,c,ci as i64);
  c=e1str(b,c,"\n");
  return c;
}
// Emit the revise block: boundary search line, before/after rule line,
// tree dump, rule fit. Snapshots node 0/1 when asked (after REVISE-1).
fn do_revise(b:[]u8,c:i32,tag:[]u8,L:[]u8,E:[]u8,snap:i32)i32 {
  let tmp:[]u8=z_alloc(256);
  let tc:i32=e1rule(tmp,0,L,0,0);
  boundary_search(L,E);
  let npr:i32=lg(L,107);
  let sT:i32=lg(L,106);
  let in0:i32=lg(L,5);
  c=e1str(b,c,tag);
  c=e1str(b,c," SEARCH nprobes=");
  c=e1i64(b,c,npr as i64);
  c=e1str(b,c," T=");
  c=e1i64(b,c,sT as i64);
  c=e1str(b,c," trail=");
  let tv:i32=in0-1;
  while(tv>=sT-1){
    c=e1str(b,c,"(");
    c=e1i64(b,c,tv as i64);
    c=e1str(b,c,":");
    c=e1kind(b,c,kind_probe(E,D_true(tv)));
    c=e1str(b,c,")");
    tv=tv-1;
  }
  c=e1str(b,c,"\n");
  learner_refine(L);
  c=e1str(b,c,tag);
  c=e1str(b,c," before=");
  c=e1str(b,c,tmp[0..tc]);
  c=e1str(b,c," after=");
  c=e1rule(b,c,L,0,0);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," TREE-DUMP ");
  c=e1treedump(b,c,L);
  c=e1str(b,c,"\n");
  c=e1str(b,c,tag);
  c=e1str(b,c," RULE-FIT fit=");
  c=e1i64(b,c,rule_fit(L) as i64);
  c=e1str(b,c,"/");
  c=e1i64(b,c,obs_n(L) as i64);
  c=e1str(b,c,"\n");
  if(snap==1){
    ls(L,108,nget(L,0,0));
    ls(L,109,nget(L,0,1));
    ls(L,110,nget(L,0,2));
    ls(L,111,nget(L,0,3));
    ls(L,112,nget(L,1,0));
    ls(L,113,nget(L,1,1));
  }
  return c;
}
fn main()void {
  let L:[]u8=z_alloc(512);
  let E:[]u8=z_alloc(64);
  let OUT:[]u8=z_alloc(16384);
  let oc:i32=0;
  ls(L,4,-1);
  world_init(E);
  // TEACH (W1)
  oc=teach_probe(OUT,oc,L,E,31);
  oc=teach_probe(OUT,oc,L,E,32);
  rule_induce(L);
  oc=e1str(OUT,oc,"TEACH rule=");
  oc=e1rule(OUT,oc,L,0,0);
  oc=e1str(OUT,oc," nobs=");
  oc=e1i64(OUT,oc,obs_n(L) as i64);
  oc=e1str(OUT,oc,"\n");
  // Z2: goal in=33 want NODE
  oc=do_commit(OUT,oc,"Z2",L,E,33,1);
  // REFUTE-1 + REVISE-1
  oc=do_refute(OUT,oc,"REFUTE-1",L,E);
  oc=do_revise(OUT,oc,"REVISE-1",L,E,1);
  // RETEST-1, REGRESS-1, GENERALIZE-1
  oc=emit_eval(OUT,oc,"RETEST-1",33,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-1",31,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-1",32,L,E,0);
  oc=emit_eval(OUT,oc,"GENERALIZE-1",40,L,E,1);
  oc=emit_eval(OUT,oc,"GENERALIZE-1",60,L,E,1);
  // WORLD-CHANGE: W1 -> W2 (learner is not told; it only experiences Z3)
  world_change(E);
  oc=e1str(OUT,oc,"WORLD-CHANGE kind-law W1->W2 (STR band added: x>=67 -> STR)\n");
  // Z3: goal in=70 want NUM
  oc=do_commit(OUT,oc,"Z3",L,E,70,2);
  // REFUTE-2 + REVISE-2
  oc=do_refute(OUT,oc,"REFUTE-2",L,E);
  oc=do_revise(OUT,oc,"REVISE-2",L,E,0);
  // RETEST-2, REGRESS-2, GENERALIZE-2
  oc=emit_eval(OUT,oc,"RETEST-2",66,L,E,0);
  oc=emit_eval(OUT,oc,"RETEST-2",70,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",31,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",32,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",33,L,E,0);
  oc=emit_eval(OUT,oc,"REGRESS-2",40,L,E,0);
  oc=emit_eval(OUT,oc,"GENERALIZE-2",50,L,E,1);
  oc=emit_eval(OUT,oc,"GENERALIZE-2",80,L,E,1);
  // PRESERVE-CHECK: node 0/1 vs snapshot after REVISE-1
  let r0ok:i32=0;
  if(lg(L,108)==nget(L,0,0)){if(lg(L,109)==nget(L,0,1)){if(lg(L,110)==nget(L,0,2)){if(lg(L,111)==nget(L,0,3)){r0ok=1;}}}}
  let r1ok:i32=0;
  if(lg(L,112)==nget(L,1,0)){if(lg(L,113)==nget(L,1,1)){r1ok=1;}}
  oc=e1str(OUT,oc,"PRESERVE-CHECK root-split-intact=");
  if(r0ok==1){oc=e1str(OUT,oc,"yes");}else{oc=e1str(OUT,oc,"no");}
  oc=e1str(OUT,oc," left-leaf-intact=");
  if(r1ok==1){oc=e1str(OUT,oc,"yes");}else{oc=e1str(OUT,oc,"no");}
  oc=e1str(OUT,oc,"\n");
  let _wn:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),oc as i64,0,0,0);
  return;
}

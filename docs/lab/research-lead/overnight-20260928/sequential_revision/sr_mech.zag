// sr_mech.zag -- sequential_revision: revise, then revise again when the
// world changes. A learner holds a rule as a threshold TREE in its own
// state. A first verification failure drives revision 1
// (ALWAYS(NODE) -> IF(in<33,NODE,NUM)) via the generic operators below.
// The world then changes (a new STR kind band appears); a second
// verification failure drives revision 2, which re-splits only the
// responsible leaf, leaving the first revision's nodes byte-identical.
//
// Standalone pure-Zag program. Conventions: L = learner state slice,
// E = world state slice. Output is formatted into ONE preallocated
// buffer; the driver performs a single _zag_raw_syscall write at the end
// (no _zag_print for dynamic content). State cells are u8-backed with
// little-endian get32/set32 (no pointer-cast slice construction).
//
// L cells (i32): 0 conf, 1 commit_pred, 2 commit_input, 3 commit_status
//   (0 none, 1 PENDING, 2 RESOLVED), 4 ce_comp (-1 none), 5 ce_in,
//   6 ce_pred, 7 ce_actual, 114 ce_link,
//   8 obs_count, 9..40 obs log (16 entries of in,kind),
//   41 node_count, 42..105 node pool (16 nodes x 4 cells),
//   106 search_T, 107 search_nprobes,
//   108..111 snapshot of node 0 (tag,a,b,c) after REVISE-1,
//   112..113 snapshot of node 1 (tag,a) after REVISE-1.
// Node: +0 tag (0 leaf, 1 split), +1 a (leaf: kind; split: T),
//   +2 b (split: left idx), +3 c (split: right idx). Root is node 0.
// E cells (byte offsets): 0 kind_law (1 W1, 2 W2), 4 gate,
//   8 accepts, 12 rejects.
// Kind codes: 1 NODE, 2 NUM, 3 STR. Component D id 0.
// There is no lookup list anywhere in this program: prediction is always
// through the rule tree predicate rule_pred.

// ---------- output helpers (one buffer, cursor-returning) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1kind(b:[]u8,c:i32,k:i32)i32 {
  if(k==1){return e1str(b,c,"NODE");}
  if(k==2){return e1str(b,c,"NUM");}
  if(k==3){return e1str(b,c,"STR");}
  return e1str(b,c,"?");
}
// Recursive rule renderer (depth-capped). Reads learner state only.
// A root leaf renders as ALWAYS(kind); nested leaves render as bare
// kinds, so a split reads IF(in<T,klo,khi) with kind branches.
fn e1rule(b:[]u8,c:i32,L:[]u8,nd:i32,dep:i32)i32 {
  if(dep>8){return e1str(b,c,"..");}
  let nb:i32=42+nd*4;
  if(lg(L,nb)==0){
    if(dep>0){return e1kind(b,c,lg(L,nb+1));}
    c=e1str(b,c,"ALWAYS(");
    c=e1kind(b,c,lg(L,nb+1));
    c=e1str(b,c,")");
    return c;
  }
  c=e1str(b,c,"IF(in<");
  c=e1i64(b,c,lg(L,nb+1) as i64);
  c=e1str(b,c,",");
  c=e1rule(b,c,L,lg(L,nb+2),dep+1);
  c=e1str(b,c,",");
  c=e1rule(b,c,L,lg(L,nb+3),dep+1);
  c=e1str(b,c,")");
  return c;
}
// Raw node dump: every node's descriptor, for the white-box check.
fn e1treedump(b:[]u8,c:i32,L:[]u8)i32 {
  let n:i32=lg(L,41);
  c=e1str(b,c,"nodes=");
  c=e1i64(b,c,n as i64);
  c=e1str(b,c," ");
  let i:i32=0;
  while(i<n){
    let nb:i32=42+i*4;
    c=e1str(b,c,"[");
    c=e1i64(b,c,i as i64);
    if(lg(L,nb)==0){
      c=e1str(b,c,":leaf ");
      c=e1kind(b,c,lg(L,nb+1));
    }else{
      c=e1str(b,c,":split T=");
      c=e1i64(b,c,lg(L,nb+1) as i64);
      c=e1str(b,c," L=");
      c=e1i64(b,c,lg(L,nb+2) as i64);
      c=e1str(b,c," R=");
      c=e1i64(b,c,lg(L,nb+3) as i64);
    }
    c=e1str(b,c,"]");
    i=i+1;
  }
  return c;
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }
fn nbase(nd:i32)i32 { return 42+nd*4; }
fn nget(L:[]u8,nd:i32,f:i32)i32 { return lg(L,nbase(nd)+f); }
fn nset(L:[]u8,nd:i32,f:i32,v:i32)void { ls(L,nbase(nd)+f,v); return; }
fn xbase(i:i32)i32 { return 9+i*2; }

// ---------- world ----------
fn D_true(v:i32)i32 { return v+1; }
fn kind_probe(E:[]u8,x:i32)i32 {
  let law:i32=get32(E,0);
  if(law==2){
    if(x<34){return 1;}
    if(x<67){return 2;}
    return 3;
  }
  if(x<34){return 1;}
  return 2;
}
fn world_init(E:[]u8)void {
  set32(E,0,1);
  set32(E,4,0);
  set32(E,8,0);
  set32(E,12,0);
  return;
}
fn world_change(E:[]u8)void {
  set32(E,0,2);
  return;
}
fn world_downstream(E:[]u8,finalk:i32,want:i32)i32 {
  let g:i32=0;
  if(finalk==want){g=1;}
  set32(E,4,g);
  return g;
}

// ---------- learner: observation log ----------
fn obs_n(L:[]u8)i32 { return lg(L,8); }
fn obs_in(L:[]u8,i:i32)i32 { return lg(L,xbase(i)); }
fn obs_k(L:[]u8,i:i32)i32 { return lg(L,xbase(i)+1); }
fn obs_append(L:[]u8,inv:i32,k:i32)void {
  let n:i32=obs_n(L);
  if(n>=16){return;}
  ls(L,xbase(n),inv);
  ls(L,xbase(n)+1,k);
  ls(L,8,n+1);
  return;
}

// ---------- learner: rule induction (generic CONSTANT induction) ----------
fn rule_induce(L:[]u8)void {
  let n:i32=obs_n(L);
  if(n<1){return;}
  let k0:i32=obs_k(L,0);
  let i:i32=1;
  while(i<n){
    if(obs_k(L,i)!=k0){return;}
    i=i+1;
  }
  nset(L,0,0,0);
  nset(L,0,1,k0);
  ls(L,41,1);
  return;
}

// ---------- learner: rule prediction (tree walk; the only prediction path) ----------
fn rule_pred(L:[]u8,inv:i32)i32 {
  let nd:i32=0;
  let guard:i32=0;
  while(guard<24){
    if(nget(L,nd,0)==0){return nget(L,nd,1);}
    let t:i32=nget(L,nd,1);
    if(inv<t){nd=nget(L,nd,2);}else{nd=nget(L,nd,3);}
    guard=guard+1;
  }
  return 0;
}
fn find_leaf(L:[]u8,inv:i32)i32 {
  let nd:i32=0;
  let guard:i32=0;
  while(guard<24){
    if(nget(L,nd,0)==0){return nd;}
    let t:i32=nget(L,nd,1);
    if(inv<t){nd=nget(L,nd,2);}else{nd=nget(L,nd,3);}
    guard=guard+1;
  }
  return nd;
}
fn smallest_mispredicted(L:[]u8)i32 {
  let n:i32=obs_n(L);
  let best:i32=-1;
  let i:i32=0;
  while(i<n){
    let inv:i32=obs_in(L,i);
    if(rule_pred(L,inv)!=obs_k(L,i)){
      if(best==-1){best=inv;}else{if(inv<best){best=inv;}}
    }
    i=i+1;
  }
  return best;
}
fn logged_kind_at(L:[]u8,inv:i32)i32 {
  let n:i32=obs_n(L);
  let i:i32=0;
  while(i<n){
    if(obs_in(L,i)==inv){return obs_k(L,i);}
    i=i+1;
  }
  return 0;
}
fn rule_fit(L:[]u8)i32 {
  let n:i32=obs_n(L);
  let hit:i32=0;
  let i:i32=0;
  while(i<n){
    if(rule_pred(L,obs_in(L,i))==obs_k(L,i)){hit=hit+1;}
    i=i+1;
  }
  return hit;
}

// ---------- learner: refutation (generic chain blame walk) ----------
// Walks the 2 links of DD (both D) from the committed input. Each probe
// outcome joins the observation log. Stops at the first mismatch and
// records the counterexample in learner state. Reads no values from the
// driver; the driver only supplies L and E.
fn learner_refute(L:[]u8,E:[]u8)void {
  let cur:i32=lg(L,2);
  let li:i32=0;
  while(li<2){
    let pred:i32=rule_pred(L,cur);
    let out:i32=D_true(cur);
    let k:i32=kind_probe(E,out);
    obs_append(L,cur,k);
    if(k!=pred){
      ls(L,4,0);
      ls(L,5,cur);
      ls(L,6,pred);
      ls(L,7,k);
      ls(L,114,li);
      return;
    }
    cur=out;
    li=li+1;
  }
  return;
}

// ---------- learner: boundary localization (generic downward inquiry) ----------
// From the recorded counterexample, probe downward while the observed
// kind equals the counterexample kind. Every outcome joins the log.
// The first input with a different kind marks the boundary: T = in+1.
// No-op when no counterexample is recorded. Reads ce cells only.
fn boundary_search(L:[]u8,E:[]u8)void {
  if(lg(L,4)<0){return;}
  let in0:i32=lg(L,5);
  let knew:i32=lg(L,7);
  ls(L,107,0);
  ls(L,106,-1);
  let inv:i32=in0-1;
  let np:i32=0;
  while(np<64){
    if(inv<0){return;}
    let out:i32=D_true(inv);
    let k:i32=kind_probe(E,out);
    obs_append(L,inv,k);
    np=np+1;
    ls(L,107,np);
    if(k!=knew){ls(L,106,inv+1);return;}
    inv=inv-1;
  }
  return;
}

// ---------- learner: refinement (generic smallest-mispredicted re-split) ----------
// Splits only the leaf responsible for the smallest mispredicted input
// in the observation log. All other nodes are untouched, so earlier
// revisions' knowledge is preserved structurally. No-op when the log
// holds no misprediction. Reads the obs log only.
fn learner_refine(L:[]u8)void {
  let ts:i32=smallest_mispredicted(L);
  if(ts<0){return;}
  let leaf:i32=find_leaf(L,ts);
  let oldk:i32=nget(L,leaf,1);
  let knew:i32=logged_kind_at(L,ts);
  let nc:i32=lg(L,41);
  let ln:i32=nc;
  let rn:i32=nc+1;
  nset(L,ln,0,0);
  nset(L,ln,1,oldk);
  nset(L,rn,0,0);
  nset(L,rn,1,knew);
  nset(L,leaf,0,1);
  nset(L,leaf,1,ts);
  nset(L,leaf,2,ln);
  nset(L,leaf,3,rn);
  ls(L,41,nc+2);
  return;
}

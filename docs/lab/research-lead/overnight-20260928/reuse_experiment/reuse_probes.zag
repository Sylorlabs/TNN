// ============ TNN-2 REUSE PATH PROBES (unfrozen variant) ============
// Appended to tnn2_reuse_variant.zag (MAP-first query, no shadow teach)
// with the test main removed. Probes exercise the reuse path via the
// public interface plus read-only white-box inspection.
// hg(W,32) counts MAP-branch executions (variant instrumentation).

fn rx_count_tag(W:[]u8,tag:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){ if(ng(W,n,36)==1 && ng(W,n,0)==tag){c=c+1;} n=n+1; }
  return c;
}
fn rx_find_map(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==s && ng(W,n,4)==r){return n;}
    n=n+1;
  }
  return -1;
}
fn rx_find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && is_superseded(W,n)==0){return n;}
    n=n+1;
  }
  return -1;
}
fn rx_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// R1: MAP execution on re-query (K-REUSE-1).
// Build chain for (1,40), then re-query. The MAP branch must fire
// (hg(W,32) increments) and the answer must be the executed output.
fn rx_r1()void {
  emit("== R1 MAP execution on re-query ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  rx_rep("R1 build_ans",a);
  let m:i32=rx_find_map(W,1,40);
  rx_rep("R1 map_node",m);
  let f:i32=rx_find_fact(W,1,40);
  rx_rep("R1 fact_node",f);
  let c0:i32=hg(W,32);
  rx_rep("R1 reuse_ctr_before",c0);
  let a2:i32=ev_query(W,1,40,-2,0);
  rx_rep("R1 requery_ans",a2);
  let c1:i32=hg(W,32);
  rx_rep("R1 reuse_ctr_after",c1);
  rx_rep("R1 ctr_delta",c1-c0);
  // White-box: MAP branch must have fired exactly once, answer correct.
  if(c1-c0==1 && a2==5){emit("R1 PASS: MAP executed on re-query\n");}
  else {emit("R1 FAIL\n");}
  return;
}

// R2: No shadow fact (K-REUSE-2).
// After promotion, no tag-1 fact may exist for the promoted (s,r).
fn rx_r2()void {
  emit("== R2 no shadow fact ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  rx_rep("R2 build_ans",a);
  let f:i32=rx_find_fact(W,1,40);
  rx_rep("R2 fact_node",f);
  let nf:i32=rx_count_tag(W,1);
  rx_rep("R2 total_facts",nf);
  // The 4 taught chain facts exist; no 5th fact for (1,40).
  if(f<0){emit("R2 PASS: no shadow fact for promoted (s,r)\n");}
  else {emit("R2 FAIL: shadow fact exists\n");}
  return;
}

// R3: Superseded MAP falls through.
// Supersede the MAP via type-3 self-edge, then query. The MAP branch
// must skip it; the trial loop should rebuild (or answer via other path).
fn rx_r3()void {
  emit("== R3 superseded MAP falls through ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  let m:i32=rx_find_map(W,1,40);
  rx_rep("R3 build_ans",a); rx_rep("R3 map_node",m);
  // Supersede the MAP manually (type-3 self-edge).
  link_edge(W,m,3,m,0);
  rx_rep("R3 is_superseded",is_superseded(W,m));
  let c0:i32=hg(W,32);
  let a2:i32=ev_query(W,1,40,-2,0);
  rx_rep("R3 requery_ans",a2);
  let c1:i32=hg(W,32);
  rx_rep("R3 ctr_delta",c1-c0);
  // MAP branch must NOT have fired (superseded MAP skipped).
  // Query falls through to trial; answer should still be derivable.
  if(c1-c0==0){emit("R3 PASS: superseded MAP skipped, fell through\n");}
  else {emit("R3 FAIL: superseded MAP was executed\n");}
  return;
}

// R4: Fresh subject rebuilds (value-trace limit).
// After MAP for subject 1, teach isomorphic chain for subject 7.
// The old MAP must NOT be invoked; a fresh MAP is built.
fn rx_r4()void {
  emit("== R4 fresh subject rebuilds ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a1:i32=ev_query(W,1,40,5,0);
  let nmaps0:i32=rx_count_tag(W,20);
  rx_rep("R4 first_ans",a1); rx_rep("R4 maps_before",nmaps0);
  ev_teach(W,7,11,8); ev_teach(W,8,11,9); ev_teach(W,9,11,10); ev_teach(W,10,11,11);
  let c0:i32=hg(W,32);
  let a2:i32=ev_query(W,7,40,11,0);
  let c1:i32=hg(W,32);
  let nmaps1:i32=rx_count_tag(W,20);
  rx_rep("R4 second_ans",a2); rx_rep("R4 maps_after",nmaps1);
  rx_rep("R4 ctr_delta",c1-c0);
  let m7:i32=rx_find_map(W,7,40);
  rx_rep("R4 map_for_7",m7);
  // A fresh MAP for (7,40) must exist; the (1,40) MAP was not invoked
  // for subject 7 (ctr_delta should be 0 for the cross-subject query;
  // the new MAP's own promotion does not go through ev_query MAP branch).
  if(m7>=0 && nmaps1==nmaps0+1){emit("R4 PASS: fresh MAP built, no cross-subject invocation\n");}
  else {emit("R4 FAIL\n");}
  return;
}

// R5: Contradiction retargets at MAP (no shadow fact on revision).
// Promote, then contradict via ev_observe. The MAP should be revised;
// no new fact for (s,r) should shadow it.
fn rx_r5()void {
  emit("== R5 contradiction retargets at MAP ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  let m:i32=rx_find_map(W,1,40);
  rx_rep("R5 build_ans",a); rx_rep("R5 map_node",m);
  // Contradict a licensing fact: change (2,11) from 3 to 99.
  // This should trigger revision of the MAP, not fact shadowing.
  let r:i32=ev_observe(W,2,11,99);
  rx_rep("R5 observe_ret",r);
  let m2:i32=rx_find_map(W,1,40);
  rx_rep("R5 map_after",m2);
  let f:i32=rx_find_fact(W,1,40);
  rx_rep("R5 fact_for_1_40",f);
  if(m2==m){emit("R5 PASS: same MAP node revised in place\n");}
  else {emit("R5 INFO: MAP node changed or revision took other path\n");}
  return;
}

fn main()i32 {
  emit("TNN-2 REUSE PATH EXPERIMENT (unfrozen variant)\n");
  rx_r1();
  rx_r2();
  rx_r3();
  rx_r4();
  rx_r5();
  emit("DONE\n");
  return 0;
}

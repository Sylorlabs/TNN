// driver.zag -- experiment side: teaching, five arms, in-Zag
// kill-bar evaluation. The driver never selects a source MAP for
// a query: Q2 is issued as (50,73,75,AGG,B) with no MAP id.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1: dom A(1), cap AGG(1), rels [18,5,6,5,6,5,6],
  // facts [10,0,1,2,3,4,5], 100->43
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs[0]=10; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  // mB0 id2: dom B(2), cap ROUTE(2), rels [7,7], facts [11,12], 50->52
  rs[0]=7; rs[1]=7; fs[0]=11; fs[1]=12;
  m_teach(st,rs,2,fs,2,50,52,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// X (mA) and Y (mB0) learned independently: disjoint relation sets.
fn d_disjoint(st:[]u8)i32 {
  let o1:i32=320+1*32;
  let rl1:i32=st[o1+4] as i32;
  let k:i32=0;
  let ok:i32=1;
  while(k<rl1){
    let r:i32=st[o1+8+k] as i32;
    let hit:i32=0;
    if(r==18){hit=1;}
    if(r==5){hit=1;}
    if(r==6){hit=1;}
    if(hit==0){ok=0;}
    k=k+1;
  }
  let o2:i32=320+2*32;
  let rl2:i32=st[o2+4] as i32;
  k=0;
  while(k<rl2){
    if((st[o2+8+k] as i32)!=7){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  xa_p(ob,atp,nm);
  xa_p(ob,atp,"=");
  xa_pi(ob,atp,v);
  xa_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  xa_p(ob,atp,"ARM FULL\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stF,ob,atp,100,43,12,1,1,1);
  let qa_via:i32=stF[9] as i32;
  xa_p(ob,atp,"Q QB\n");
  xa_query(stF,ob,atp,50,52,-1,2,2,1);
  let qb_via:i32=stF[9] as i32;
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stF,ob,atp,50,73,75,1,2,1);
  let q2_via:i32=stF[9] as i32;
  let q2_val:i32=get32(stF,1136);
  let q2_as:i32=get32(stF,1128);
  let q2_ae:i32=get32(stF,1132);
  let srcF:i32=get32(stF,1140);
  xa_p(ob,atp,"Q Q2B\n");
  xa_query(stF,ob,atp,50,73,75,1,2,1);
  let q2b_via:i32=stF[9] as i32;
  let q2b_val:i32=get32(stF,1136);
  let q2b_adapt:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let t15F:i32=e_count(stF,15);
  let othF:i32=xa_eoth(stF);
  let e14F:i32=e_has_to(stF,3,14);
  let e31F:i32=e_has(stF,3,1,16);
  let nmF:i32=stF[1] as i32;
  let zlive:i32=stF[320+3*32+1] as i32;
  let mdlive:i32=stF[320+0*32+1] as i32;
  let disj:i32=d_disjoint(stF);
  xa_p(ob,atp,"ARM-FULL-END as=");
  xa_pi(ob,atp,q2_as);
  xa_p(ob,atp," ae=");
  xa_pi(ob,atp,q2_ae);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,t16F);
  xa_p(ob,atp," t15=");
  xa_pi(ob,atp,t15F);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othF);
  xa_pnl(ob,atp);

  // ---------- ARM NOADAPT ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  xa_p(ob,atp,"ARM NOADAPT\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stN,ob,atp,100,43,12,1,1,0);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stN,ob,atp,50,52,-1,2,2,0);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stN,ob,atp,50,73,75,1,2,0);
  let na_via:i32=stN[9] as i32;
  let na_val:i32=get32(stN,1136);
  let na_t16:i32=e_count(stN,16);
  let na_nm:i32=stN[1] as i32;
  let othN:i32=xa_eoth(stN);
  xa_p(ob,atp,"ARM-NOADAPT-END t16=");
  xa_pi(ob,atp,na_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othN);
  xa_pnl(ob,atp);

  // ---------- ARM ABLATE-X ----------
  let stX:[]u8=z_alloc(8192);
  d_teach_all(stX);
  xa_p(ob,atp,"ARM ABLATE-X\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stX,ob,atp,100,43,12,1,1,1);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stX,ob,atp,50,52,-1,2,2,1);
  map_retire(stX,1,3);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stX,ob,atp,50,73,75,1,2,1);
  let ax_via:i32=stX[9] as i32;
  let ax_val:i32=get32(stX,1136);
  let ax_t16:i32=e_count(stX,16);
  let ax_e31:i32=e_has(stX,3,1,16);
  let ax_nm:i32=stX[1] as i32;
  let ax_as:i32=get32(stX,1128);
  let ax_ae:i32=get32(stX,1132);
  let othX:i32=xa_eoth(stX);
  xa_p(ob,atp,"ARM-ABLATEX-END as=");
  xa_pi(ob,atp,ax_as);
  xa_p(ob,atp," ae=");
  xa_pi(ob,atp,ax_ae);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,ax_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othX);
  xa_pnl(ob,atp);

  // ---------- ARM ABLATE-Y ----------
  let stY:[]u8=z_alloc(8192);
  d_teach_all(stY);
  xa_p(ob,atp,"ARM ABLATE-Y\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stY,ob,atp,100,43,12,1,1,1);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stY,ob,atp,50,52,-1,2,2,1);
  w_kill_cost(stY);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stY,ob,atp,50,73,75,1,2,1);
  let ay_via:i32=stY[9] as i32;
  let ay_val:i32=get32(stY,1136);
  let ay_t16:i32=e_count(stY,16);
  let ay_nm:i32=stY[1] as i32;
  let ay_as:i32=get32(stY,1128);
  let othY:i32=xa_eoth(stY);
  xa_p(ob,atp,"ARM-ABLATEY-END as=");
  xa_pi(ob,atp,ay_as);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,ay_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othY);
  xa_pnl(ob,atp);

  // ---------- ARM FRESH ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  xa_p(ob,atp,"ARM FRESH\n");
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stR,ob,atp,50,73,75,1,2,1);
  let fr_via:i32=stR[9] as i32;
  let fr_val:i32=get32(stR,1136);
  let fr_t16:i32=e_count(stR,16);
  let fr_nm:i32=stR[1] as i32;
  let fr_as:i32=get32(stR,1128);
  let othR:i32=xa_eoth(stR);
  xa_p(ob,atp,"ARM-FRESH-END as=");
  xa_pi(ob,atp,fr_as);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,fr_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othR);
  xa_pnl(ob,atp);

  // ---------- in-Zag kill bars ----------
  let k1:i32=0;
  if(qa_via==1){
    if(qb_via==2){
      if(q2_via==3){
        if(disj==1){k1=1;}
      }
    }
  }
  let k2:i32=0;
  if(ax_t16==0){
    if(ax_via==3){
      if(ax_val==75){
        if(ax_e31==0){
          if(ay_val==-2){
            if(ay_t16==0){
              if(ay_nm==3){k2=1;}
            }
          }
        }
      }
    }
  }
  let k3:i32=0;
  if(na_val==-2){
    if(na_t16==0){
      if(na_nm==3){k3=1;}
    }
  }
  let k4:i32=0;
  if(fr_val==-2){
    if(fr_t16==0){
      if(fr_nm==0){k4=1;}
    }
  }
  let k7:i32=0;
  if(srcF==1){
    if(mdlive==1){k7=1;}
  }
  let k8:i32=0;
  if(q2b_via==3){
    if(q2b_val==75){
      if(q2b_adapt==0){
        if(zlive==1){k8=1;}
      }
    }
  }
  // falsifiers
  let ff:i32=0;
  if(othF!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW NOADAPT\n");ff=1;}
  if(othX!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEX\n");ff=1;}
  if(othY!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEY\n");ff=1;}
  if(othR!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(q2_as!=941){xa_p(ob,atp,"FALSIFIER F-COUNT AS=");xa_pi(ob,atp,q2_as);xa_pnl(ob,atp);ff=1;}
  if(q2_ae!=3){xa_p(ob,atp,"FALSIFIER F-COUNT AE=");xa_pi(ob,atp,q2_ae);xa_pnl(ob,atp);ff=1;}
  if(q2_val!=75){xa_p(ob,atp,"FALSIFIER F-WRONG-Z\n");ff=1;}
  if(q2_via!=3){xa_p(ob,atp,"FALSIFIER F-NO-GROUND\n");ff=1;}
  if(e14F!=1){xa_p(ob,atp,"FALSIFIER F-NO-LINK14\n");ff=1;}
  if(e31F!=1){xa_p(ob,atp,"FALSIFIER F-NO-T16-SRC\n");ff=1;}
  if(t16F!=2){xa_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(t15F!=2){xa_p(ob,atp,"FALSIFIER F-T15-COUNT\n");ff=1;}
  xa_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k7",k7);
  d_bar(ob,atp,"k8",k8);
  xa_pnl(ob,atp);
  xa_p(ob,atp,"FALSIFIERS ");
  xa_pi(ob,atp,ff);
  xa_pnl(ob,atp);
  xa_p(ob,atp,"L2-SUBSTITUTE-XDOMAIN-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,30,2,3);
  f_teach(st,31,2,4);
  f_teach(st,32,2,5);
  f_teach(st,43,2,12);
  f_teach(st,100,18,40);
  f_teach(st,50,7,51);
  f_teach(st,51,7,52);
  f_teach(st,50,8,60);
  f_teach(st,51,8,61);
  f_teach(st,52,8,62);
  f_teach(st,60,2,20);
  f_teach(st,61,2,30);
  f_teach(st,62,2,25);
  f_teach(st,50,17,64);
  f_teach(st,50,17,70);
  f_teach(st,70,15,60);
  f_teach(st,60,16,71);
  f_teach(st,71,15,61);
  f_teach(st,61,16,72);
  f_teach(st,72,15,62);
  f_teach(st,62,16,73);
  f_teach(st,73,2,75);
  f_teach(st,64,15,74);
  f_teach(st,74,16,65);
  f_teach(st,65,15,75);
  f_teach(st,75,16,66);
  f_teach(st,66,15,76);
  f_teach(st,76,16,67);
  f_teach(st,74,2,1);
  f_teach(st,75,2,2);
  f_teach(st,76,2,3);
  f_teach(st,67,2,6);
  return;
}

// World change for ABLATE-Y: the COST pair-interface facts die.
// Environment act only.
fn w_kill_cost(st:[]u8)void {
  st[16+13*8+3]=0;
  st[16+14*8+3]=0;
  st[16+15*8+3]=0;
  return;
}

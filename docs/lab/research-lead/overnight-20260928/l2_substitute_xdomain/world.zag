// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen fact table (38 facts) and the world-change kill.
// The learner never calls w_kill_cost; it only observes facts via
// f_teach and discovers consequences through execution outcomes.
// Domain A (arithmetic SUM):
//   0:(40,5,30) 1:(30,6,41) 2:(41,5,31) 3:(31,6,42) 4:(42,5,32)
//   5:(32,6,43) 6:(30,2,3) 7:(31,2,4) 8:(32,2,5) 9:(43,2,12)
//   10:(100,18,40)
// Domain B (planning):
//   11:(50,7,51) 12:(51,7,52) 13:(50,8,60) 14:(51,8,61)
//   15:(52,8,62) 16:(60,2,20) 17:(61,2,30) 18:(62,2,25)
//   19:(50,17,64) 20:(50,17,70) 21:(70,15,60) 22:(60,16,71)
//   23:(71,15,61) 24:(61,16,72) 25:(72,15,62) 26:(62,16,73)
//   27:(73,2,75) 28:(64,15,74) 29:(74,16,65) 30:(65,15,75)
//   31:(75,16,66) 32:(66,15,76) 33:(76,16,67) 34:(74,2,1)
//   35:(75,2,2) 36:(76,2,3) 37:(67,2,6)

fn w_teach_all(st:[]u8)void {

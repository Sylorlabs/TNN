// learner.zag -- L2 SUBSTITUTE-XDOMAIN (cross-domain substitute with
// interface adaptation), standalone. Generic machinery + learned state
// only. No world data, no fact literals, no relation literals, no
// domain literals in this file. The learner never selects a source
// MAP per problem: xa_query searches the learned MAP inventory in
// MAP-id order for the first capability-matching MAP (any domain),
// and the adapter derives every interface mapping (relation remap,
// entry remap, addend pair interface, value relation) at runtime
// from learner state and world facts.
// Prereg: l2_substitute_xdomain/PREREG.md (frozen 6bed092c3) plus
// PREREG_AMENDMENT1.md (frozen d6d8e01ee). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 ADAPT_ON (driver flag, never learner-written)
//   4 NN  5 unused  6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_ADAPT  12 ADAPT_ENTERED
//   13 SRC_ID (255=none)
//   16..319:  facts, 38 x 8B [sub,rel,obj,live,0,0,0,0]
//   320..831: MAPs, 16 x 32B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x8 @+8, facts x8 @+16,
//               dom @+24, cap @+25, d_entry @+26, d_r1 @+27,
//               d_r2 @+28, d_nf @+29, d_valrel @+30, pad @+31]
//   832..1087: edges, 64 x 4B [from,to,type,pad]
//   1088..1119: answer nodes, 8 x 4B [via,0,0,0]
//   1120 SEARCH i32  1124 EXEC i32  1128 A_SEARCH i32  1132 A_EXEC i32
//   1136 LAST_VAL i32  1140 SRC_ID32 (i32 mirror)  1144 LAST_TERM i32
//   1148..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn xa_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn xa_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn xa_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn xa_tick(st:[]u8)void {
  set32(st,1128,get32(st,1128)+1);
  set32(st,1120,get32(st,1120)+1);
  return;
}
fn xa_tickm(st:[]u8)void {
  set32(st,1128,get32(st,1128)+1);
  set32(st,1120,get32(st,1120)+1);
  return;
}
fn xa_exec(st:[]u8)void {
  set32(st,1124,get32(st,1124)+1);
  if((st[11] as i32)==1){set32(st,1132,get32(st,1132)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=38){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>8){return -1;}
  if(fl>8){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==AGG only), generic:
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=320+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<8){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){
    if(k<fl){st[o+16+k]=fs[k];}
    else {st[o+16+k]=0;}
    k=k+1;
  }
  st[o+24]=dom as u8; st[o+25]=cap as u8;
  st[o+26]=de as u8; st[o+27]=dr1 as u8; st[o+28]=dr2 as u8;
  st[o+29]=dnf as u8; st[o+30]=dvr as u8; st[o+31]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=320+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<8){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){
    if(k<fl){st[o+16+k]=fs[k];}
    else {st[o+16+k]=0;}
    k=k+1;
  }
  st[o+24]=dom as u8; st[o+25]=cap as u8;
  st[o+26]=de as u8; st[o+27]=dr1 as u8; st[o+28]=dr2 as u8;
  st[o+29]=dnf as u8; st[o+30]=dvr as u8; st[o+31]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=320+mid*32;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  xa_exec(st);
  st[6]=255;
  let o:i32=320+mid*32;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+16+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  xa_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=832+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=832+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[832+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=832+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){return 1;}
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=832+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn xa_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[832+i*4+2] as i32;
    if(tp!=14){ if(tp!=15){ if(tp!=16){ c=c+1; } } }
    i=i+1;
  }
  return c;
}

// ---- counted fact scans (frozen counting rules) ----
// first live fact with sub==s, skipping rel==skiprel. counts examined.
fn xa_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    xa_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// first live fact with sub==s (no skip). counts examined.
fn xa_find_sub(st:[]u8, s:i32)i32 {
  return xa_find_sub_skip(st,s,-1);
}
// first live fact with sub==s and rel==r. counts examined.
fn xa_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    xa_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// value of node nd via valrel: first live fact sub==nd, rel==valrel.
// returns value or -1. counts examined.
fn xa_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=xa_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}
// first live fact with obj==o and sub in stepset sb[0..ns). counts.
fn xa_find_link(st:[]u8, o:i32, sb:[]u8, ns:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    xa_tick(st);
    let fo:i32=16+i*8;
    let ok:i32=0;
    if((st[fo+3] as i32)==1){ok=1;}
    if(ok==1){
      if((st[fo+2] as i32)!=o){ok=0;}
    }
    if(ok==1){
      let s:i32=st[fo] as i32;
      let k:i32=0;
      let hit:i32=0;
      while(k<ns){
        if((sb[k] as i32)==s){hit=1;}
        k=k+1;
      }
      if(hit==1){return i;}
    }
    i=i+1;
  }
  return -1;
}

// ---- walk a MAP recording visited nodes ----
fn xa_collect(st:[]u8, mid:i32, s:i32, sb:[]u8)i32 {
  xa_exec(st);
  let o:i32=320+mid*32;
  let rl:i32=st[o+4] as i32;
  let cur:i32=s;
  sb[0]=s as u8;
  let n:i32=1;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+16+k] as i32;
    let fo:i32=16+fid*8;
    let ok:i32=1;
    if((st[fo+3] as i32)==0){ok=0;}
    if(ok==1){
      if((st[fo] as i32)!=cur){ok=0;}
    }
    if(ok==1){
      if((st[fo+1] as i32)!=(st[o+8+k] as i32)){ok=0;}
    }
    if(ok==0){return n;}
    cur=st[fo+2] as i32;
    sb[n]=cur as u8; n=n+1;
    k=k+1;
  }
  return n;
}

// ---- fold-walk: from entry node u, walk nf alternating (s1,s2)
// folds. fold1 discovers (s1,s2) via first live facts (skipping
// valrel: value annotations are not structural hops);
// folds 2..nf require rel==s1/rel==s2.
// fills ff[0..2nf) fact ids, aa[0..nf) addend nodes.
// returns 0 on fail, else s1 + s2*256 + term*65536.
fn xa_foldwalk(st:[]u8, u:i32, nf:i32, vrel:i32, ff:[]u8, aa:[]u8)i32 {
  let f1:i32=xa_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=xa_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8; aa[0]=a0 as u8;
  let k:i32=1;
  while(k<nf){
    let g1:i32=xa_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=xa_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*k]=g1 as u8; ff[2*k+1]=g2 as u8; aa[k]=ak as u8;
    k=k+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- arity check (two-phase): phase 1 VALscan all addends,
// phase 2 LINKscan all addends (uniform link rel required).
// prints XA-ARITY trace. returns cost_rel or -1.
fn xa_arity(st:[]u8, ob:[]u8, atp:[]u8, u:i32, nf:i32, aa:[]u8, av:[]u8, vrel:i32, sb:[]u8, ns:i32)i32 {
  let k:i32=0;
  let ok:i32=1;
  while(k<nf){
    let vv:i32=xa_valof(st,aa[k] as i32,vrel);
    if(vv<0){ok=0;}
    else {av[k]=vv as u8;}
    k=k+1;
  }
  xa_p(ob,atp,"XA-ARITY u=");
  xa_pi(ob,atp,u);
  xa_p(ob,atp," addvals=");
  k=0;
  while(k<nf){
    xa_pi(ob,atp,av[k] as i32);
    if(k+1<nf){xa_p(ob,atp,",");}
    k=k+1;
  }
  if(ok==0){
    xa_p(ob,atp," VAL-FAIL\n");
    return -1;
  }
  let crel:i32=-1;
  k=0;
  while(k<nf){
    let lf:i32=xa_find_link(st,aa[k] as i32,sb,ns);
    if(lf<0){ok=0;}
    else {
      let lr:i32=st[16+lf*8+1] as i32;
      if(crel<0){crel=lr;}
      else {
        if(lr!=crel){ok=0;}
      }
    }
    k=k+1;
  }
  if(ok==0){
    xa_p(ob,atp," LINK-FAIL\n");
    return -1;
  }
  xa_p(ob,atp," cost_rel=");
  xa_pi(ob,atp,crel);
  xa_p(ob,atp," OK\n");
  return crel;
}

// ---- deliver: answer-node provenance + ANS print ----
fn xa_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1136,val);
  set32(st,1144,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  let ao:i32=1088+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  xa_p(ob,atp,"ANS term=");
  xa_pi(ob,atp,term);
  xa_p(ob,atp," val=");
  xa_pi(ob,atp,val);
  xa_p(ob,atp," via=");
  xa_pi(ob,atp,mid);
  xa_pnl(ob,atp);
  return;
}

// ---- the cross-domain SUBSTITUTE-ADAPT operator ----
fn xa_adapter(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, smid:i32, stepsm:i32, sb:[]u8, ns:i32, adapt_on:i32)i32 {
  set32(st,1140,smid);
  let so:i32=320+smid*32;
  let entry:i32=st[so+26] as i32;
  let r1:i32=st[so+27] as i32;
  let r2:i32=st[so+28] as i32;
  let nf:i32=st[so+29] as i32;
  let vrel:i32=st[so+30] as i32;
  xa_p(ob,atp,"XA-SRC id=");
  xa_pi(ob,atp,smid);
  xa_p(ob,atp," entry=");
  xa_pi(ob,atp,entry);
  xa_p(ob,atp," r1=");
  xa_pi(ob,atp,r1);
  xa_p(ob,atp," r2=");
  xa_pi(ob,atp,r2);
  xa_p(ob,atp," nf=");
  xa_pi(ob,atp,nf);
  xa_p(ob,atp," valrel=");
  xa_pi(ob,atp,vrel);
  xa_pnl(ob,atp);
  let ff:[]u8=z_alloc(8);
  let aa:[]u8=z_alloc(8);
  let av:[]u8=z_alloc(8);
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let done:i32=0;
  let ans:i32=-2;
  while(fid<nfacts){
    if(done==0){
      xa_tick(st);
      let fo:i32=16+fid*8;
      let cand:i32=0;
      if((st[fo+3] as i32)==1){cand=1;}
      if(cand==1){
        if((st[fo] as i32)!=s){cand=0;}
      }
      if(cand==1){
        let re:i32=st[fo+1] as i32;
        let u:i32=st[fo+2] as i32;
        let efid:i32=fid;
        let pack:i32=xa_foldwalk(st,u,nf,vrel,ff,aa);
        xa_p(ob,atp,"XA-ENTRY-CAND r=");
        xa_pi(ob,atp,re);
        xa_p(ob,atp," u=");
        xa_pi(ob,atp,u);
        if(pack==0){
          xa_p(ob,atp," FAIL-SHAPE\n");
        } else {
          let s1:i32=pack%256;
          let s2:i32=(pack/256)%256;
          let term:i32=(pack/65536)%256;
          xa_p(ob,atp," SHAPE-OK add=");
          let q:i32=0;
          while(q<nf){
            xa_pi(ob,atp,aa[q] as i32);
            if(q+1<nf){xa_p(ob,atp,",");}
            q=q+1;
          }
          xa_pnl(ob,atp);
          let proceed:i32=0;
          let crel:i32=-1;
          if(adapt_on==1){
            crel=xa_arity(st,ob,atp,u,nf,aa,av,vrel,sb,ns);
            if(crel>=0){proceed=1;}
          } else {
            // no-adaptation control: VALs read, pair interface skipped
            let q2:i32=0;
            while(q2<nf){
              let vv:i32=xa_valof(st,aa[q2] as i32,vrel);
              av[q2]=vv as u8;
              q2=q2+1;
            }
            xa_p(ob,atp,"XA-ARITY u=");
            xa_pi(ob,atp,u);
            xa_p(ob,atp," addvals=");
            q2=0;
            while(q2<nf){
              xa_pi(ob,atp,av[q2] as i32);
              if(q2+1<nf){xa_p(ob,atp,",");}
              q2=q2+1;
            }
            xa_p(ob,atp," SKIPPED\n");
            proceed=1;
          }
          if(proceed==1){
            xa_p(ob,atp,"XA-REMAP ");
            xa_pi(ob,atp,r1);
            xa_p(ob,atp,"->");
            xa_pi(ob,atp,s1);
            xa_p(ob,atp," ");
            xa_pi(ob,atp,r2);
            xa_p(ob,atp,"->");
            xa_pi(ob,atp,s2);
            xa_pnl(ob,atp);
            xa_p(ob,atp,"XA-ENTRY ");
            xa_pi(ob,atp,entry);
            xa_p(ob,atp,"->");
            xa_pi(ob,atp,re);
            xa_pnl(ob,atp);
            let zr:[]u8=z_alloc(8);
            let zf:[]u8=z_alloc(8);
            zr[0]=re as u8; zf[0]=efid as u8;
            let w:i32=0;
            while(w<2*nf){
              if((w%2)==0){zr[1+w]=s1 as u8;}
              else {zr[1+w]=s2 as u8;}
              zf[1+w]=ff[w];
              w=w+1;
            }
            let zl:i32=1+2*nf;
            xa_p(ob,atp,"XA-ZBUILD rels=");
            w=0;
            while(w<zl){
              xa_pi(ob,atp,zr[w] as i32);
              if(w+1<zl){xa_p(ob,atp,",");}
              w=w+1;
            }
            xa_p(ob,atp," facts=");
            w=0;
            while(w<zl){
              xa_pi(ob,atp,zf[w] as i32);
              if(w+1<zl){xa_p(ob,atp,",");}
              w=w+1;
            }
            xa_pnl(ob,atp);
            let vt:i32=chain_exec(st,zf,zr,zl,s);
            let vok:i32=0;
            let vv2:i32=-1;
            if(vt==t){
              vv2=xa_valof(st,vt,vrel);
              if(vv2==v){vok=1;}
            }
            xa_p(ob,atp,"XA-VERIFY term=");
            xa_pi(ob,atp,vt);
            if(vok==1){
              xa_p(ob,atp," val=");
              xa_pi(ob,atp,vv2);
              xa_p(ob,atp," OK\n");
            } else {
              xa_p(ob,atp," EXPECT ");
              xa_pi(ob,atp,t);
              xa_p(ob,atp," FAIL\n");
            }
            if(vok==1){
              // promote only after verification: a graph that does
              // not execute to its terminal is never promoted.
              let zid:i32=map_create(st,zr,zl,zf,zl,s,term,qdom,1,re,s1,s2,nf,vrel);
              e_add(st,zid,smid,16);
              e_add(st,zid,stepsm,16);
              if(smid!=stepsm){
                e_add(st,smid,stepsm,15);
                e_add(st,stepsm,smid,15);
              }
              xa_p(ob,atp,"XA-PROMOTE z=");
              xa_pi(ob,atp,zid);
              xa_p(ob,atp," t16=");
              xa_pi(ob,atp,zid);
              xa_p(ob,atp,"->");
              xa_pi(ob,atp,smid);
              xa_p(ob,atp,",");
              xa_pi(ob,atp,zid);
              xa_p(ob,atp,"->");
              xa_pi(ob,atp,stepsm);
              xa_pnl(ob,atp);
              xa_deliver(st,ob,atp,zid,s,vt,v);
              ans=vt;
              done=1;
            } else {
              // first accepted grounding is committed: no backtrack
              // on verify failure (first-match precedent).
              done=1;
            }
          }
        }
      }
    }
    fid=fid+1;
  }
  return ans;
}

// ---- AGG shape check for a rebuild walk (rels in zr, facts in zf,
// length wl). returns 1 if [entry,(r1,r2)xk] with k>=1.
fn xa_shape_ok(zr:[]u8, wl:i32)i32 {
  if(wl<3){return 0;}
  let pr:i32=wl-1;
  if((pr%2)==1){return 0;}
  let r1:i32=zr[1] as i32;
  let r2:i32=zr[2] as i32;
  let i:i32=1;
  let ok:i32=1;
  while(i<wl){
    let e:i32=r1;
    if((i%2)==0){e=r2;}
    if((zr[i] as i32)!=e){ok=0;}
    i=i+1;
  }
  return ok;
}

// ---- generic rebuild fallback: BFS over live facts, L=1..7 ----
fn xa_rebuild(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, sb:[]u8, ns:i32)i32 {
  let vrel:i32=0;
  let vf:i32=xa_find_sub(st,t);
  if(vf>=0){vrel=st[16+vf*8+1] as i32;}
  xa_p(ob,atp,"XA-REBUILD valrel=");
  xa_pi(ob,atp,vrel);
  xa_pnl(ob,atp);
  let q:[]u8=z_alloc(768);
  let qh:i32=0;
  let qt:i32=1;
  q[0]=0;
  let nfacts:i32=st[0] as i32;
  while(qh<qt){
    let qo:i32=qh*8;
    let wl:i32=q[qo] as i32;
    let fr:i32=s;
    if(wl>0){
      let lf:i32=q[qo+wl] as i32;
      fr=st[16+lf*8+2] as i32;
    }
    let fi:i32=0;
    while(fi<nfacts){
      xa_tick(st);
      let fo:i32=16+fi*8;
      let ext:i32=0;
      if((st[fo+3] as i32)==1){ext=1;}
      if(ext==1){
        if((st[fo] as i32)!=fr){ext=0;}
      }
      if(ext==1){
        if(wl<7){
          if(qt<96){
            let no:i32=qt*8;
            q[no]=(wl+1) as u8;
            let cp:i32=0;
            while(cp<wl){q[no+1+cp]=q[qo+1+cp];cp=cp+1;}
            q[no+1+wl]=fi as u8;
            qt=qt+1;
            let term:i32=st[fo+2] as i32;
            if(term==t){
              let zr:[]u8=z_alloc(8);
              let zf:[]u8=z_alloc(8);
              let kk:i32=0;
              while(kk<wl+1){
                let fx:i32=q[no+1+kk] as i32;
                zr[kk]=st[16+fx*8+1];
                zf[kk]=fx as u8;
                kk=kk+1;
              }
              if(xa_shape_ok(zr,wl+1)==1){
                let r1x:i32=zr[1] as i32;
                let r2x:i32=zr[2] as i32;
                let kkx:i32=(wl+1-1)/2;
                // addend VAL + arity checks
                let ok2:i32=1;
                let crel:i32=-1;
                let j:i32=2;
                while(j<wl+1){
                  let fj:i32=q[no+1+j-1] as i32;
                  let anode:i32=st[16+fj*8+2] as i32;
                  let vv3:i32=xa_valof(st,anode,vrel);
                  if(vv3<0){ok2=0;}
                  if(ok2==1){
                    let lf3:i32=xa_find_link(st,anode,sb,ns);
                    if(lf3<0){ok2=0;}
                    else {
                      let lr3:i32=st[16+lf3*8+1] as i32;
                      if(crel<0){crel=lr3;}
                      else {
                        if(lr3!=crel){ok2=0;}
                      }
                    }
                  }
                  j=j+2;
                }
                if(ok2==1){
                  let vt2:i32=chain_exec(st,zf,zr,wl+1,s);
                  if(vt2==t){
                    let nid:i32=map_create(st,zr,wl+1,zf,wl+1,s,term,qdom,1,zr[0] as i32,r1x,r2x,kkx,vrel);
                    xa_p(ob,atp,"XA-REBUILD-NATIVE id=");
                    xa_pi(ob,atp,nid);
                    xa_pnl(ob,atp);
                    xa_deliver(st,ob,atp,nid,s,vt2,v);
                    return vt2;
                  }
                }
              }
            }
          }
        }
      }
      fi=fi+1;
    }
    qh=qh+1;
  }
  return -2;
}

// ---- query: pipeline, then adapt on failure ----
fn xa_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, adapt_on:i32)i32 {
  st[12]=0;
  set32(st,1136,-2);
  set32(st,1140,-1);
  set32(st,1144,-2);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=320+mid*32;
      let vr2:i32=st[mo+30] as i32;
      if(vr2!=0){vv=xa_valof(st,r,vr2);}
      xa_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // adapt phase
  st[11]=1;
  st[12]=1;
  set32(st,1128,0);
  set32(st,1132,0);
  xa_p(ob,atp,"XA-QUERY s=");
  xa_pi(ob,atp,s);
  xa_p(ob,atp," t=");
  xa_pi(ob,atp,t);
  xa_p(ob,atp," v=");
  xa_pi(ob,atp,v);
  xa_p(ob,atp," cap=");
  xa_pi(ob,atp,cap);
  xa_p(ob,atp," dom=");
  xa_pi(ob,atp,dom);
  xa_pnl(ob,atp);
  // 1. steps: first live MAP with dom==qdom and start==s
  let sb:[]u8=z_alloc(16);
  let ns:i32=0;
  let stepsm:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      xa_tickm(st);
      let o:i32=320+mid*32;
      if((st[o+1] as i32)==1){
        if((st[o+24] as i32)==dom){
          if((st[o+2] as i32)==s){stepsm=mid;done=1;}
        }
      }
    }
    mid=mid+1;
  }
  if(stepsm>=0){
    ns=xa_collect(st,stepsm,s,sb);
    xa_p(ob,atp,"XA-STEPS ");
    let q:i32=0;
    while(q<ns){
      xa_pi(ob,atp,sb[q] as i32);
      if(q+1<ns){xa_p(ob,atp,",");}
      q=q+1;
    }
    xa_pnl(ob,atp);
  } else {
    sb[0]=s as u8;
    ns=1;
    xa_p(ob,atp,"XA-STEPS FALLBACK ");
    xa_pi(ob,atp,s);
    xa_pnl(ob,atp);
  }
  // 2. capsearch: first live MAP with cap==qcap (any domain)
  let smid:i32=-1;
  done=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      xa_tickm(st);
      let o:i32=320+mid*32;
      let mc:i32=st[o+25] as i32;
      xa_p(ob,atp,"XA-SEARCH id=");
      xa_pi(ob,atp,mid);
      xa_p(ob,atp," cap=");
      xa_pi(ob,atp,mc);
      if((st[o+1] as i32)==1){
        if(mc==cap){
          xa_p(ob,atp," MATCH\n");
          smid=mid;
          done=1;
        } else {
          xa_p(ob,atp," SKIP\n");
        }
      } else {
        xa_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(smid>=0){
    ans=xa_adapter(st,ob,atp,s,t,v,dom,smid,stepsm,sb,ns,adapt_on);
  } else {
    ans=xa_rebuild(st,ob,atp,s,t,v,dom,sb,ns);
  }
  st[11]=0;
  if(ans<0){
    xa_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1136,-2);
    set32(st,1144,-2);
  }
  return ans;
}
// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen fact table (38 facts) and the world-change kill.
// The learner never calls w_kill_cost; it only observes facts via
// f_teach and discovers consequences through execution outcomes.
// Domain A (arithmetic SUM):
//   0:(40,5,30) 1:(30,6,41) 2:(41,5,31) 3:(31,6,42) 4:(42,5,32)
//   5:(32,6,43) 6:(30,2,3) 7:(31,2,4) 8:(32,2,5) 9:(43,2,12)
//   10:(100,18,40)
// Domain B (planning):
//   11:(50,7,51) 12:(51,7,52) 13:(50,8,60) 14:(51,8,61)
//   15:(52,8,62) 16:(60,2,20) 17:(61,2,30) 18:(62,2,25)
//   19:(50,17,64) 20:(50,17,70) 21:(70,15,60) 22:(60,16,71)
//   23:(71,15,61) 24:(61,16,72) 25:(72,15,62) 26:(62,16,73)
//   27:(73,2,75) 28:(64,15,74) 29:(74,16,65) 30:(65,15,75)
//   31:(75,16,66) 32:(66,15,76) 33:(76,16,67) 34:(74,2,1)
//   35:(75,2,2) 36:(76,2,3) 37:(67,2,6)

fn w_teach_all(st:[]u8)void {
  f_teach(st,40,5,30);
  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,30,2,3);
  f_teach(st,31,2,4);
  f_teach(st,32,2,5);
  f_teach(st,43,2,12);
  f_teach(st,100,18,40);
  f_teach(st,50,7,51);
  f_teach(st,51,7,52);
  f_teach(st,50,8,60);
  f_teach(st,51,8,61);
  f_teach(st,52,8,62);
  f_teach(st,60,2,20);
  f_teach(st,61,2,30);
  f_teach(st,62,2,25);
  f_teach(st,50,17,64);
  f_teach(st,50,17,70);
  f_teach(st,70,15,60);
  f_teach(st,60,16,71);
  f_teach(st,71,15,61);
  f_teach(st,61,16,72);
  f_teach(st,72,15,62);
  f_teach(st,62,16,73);
  f_teach(st,73,2,75);
  f_teach(st,64,15,74);
  f_teach(st,74,16,65);
  f_teach(st,65,15,75);
  f_teach(st,75,16,66);
  f_teach(st,66,15,76);
  f_teach(st,76,16,67);
  f_teach(st,74,2,1);
  f_teach(st,75,2,2);
  f_teach(st,76,2,3);
  f_teach(st,67,2,6);
  return;
}

// World change for ABLATE-Y: the COST pair-interface facts die.
// Environment act only.
fn w_kill_cost(st:[]u8)void {
  st[16+13*8+3]=0;
  st[16+14*8+3]=0;
  st[16+15*8+3]=0;
  return;
}
// driver.zag -- experiment side: teaching, five arms, in-Zag
// kill-bar evaluation. The driver never selects a source MAP for
// a query: Q2 is issued as (50,73,75,AGG,B) with no MAP id.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1: dom A(1), cap AGG(1), rels [18,5,6,5,6,5,6],
  // facts [10,0,1,2,3,4,5], 100->43
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs[0]=10; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  // mB0 id2: dom B(2), cap ROUTE(2), rels [7,7], facts [11,12], 50->52
  rs[0]=7; rs[1]=7; fs[0]=11; fs[1]=12;
  m_teach(st,rs,2,fs,2,50,52,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// X (mA) and Y (mB0) learned independently: disjoint relation sets.
fn d_disjoint(st:[]u8)i32 {
  let o1:i32=320+1*32;
  let rl1:i32=st[o1+4] as i32;
  let k:i32=0;
  let ok:i32=1;
  while(k<rl1){
    let r:i32=st[o1+8+k] as i32;
    let hit:i32=0;
    if(r==18){hit=1;}
    if(r==5){hit=1;}
    if(r==6){hit=1;}
    if(hit==0){ok=0;}
    k=k+1;
  }
  let o2:i32=320+2*32;
  let rl2:i32=st[o2+4] as i32;
  k=0;
  while(k<rl2){
    if((st[o2+8+k] as i32)!=7){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  xa_p(ob,atp,nm);
  xa_p(ob,atp,"=");
  xa_pi(ob,atp,v);
  xa_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  xa_p(ob,atp,"ARM FULL\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stF,ob,atp,100,43,12,1,1,1);
  let qa_via:i32=stF[9] as i32;
  xa_p(ob,atp,"Q QB\n");
  xa_query(stF,ob,atp,50,52,-1,2,2,1);
  let qb_via:i32=stF[9] as i32;
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stF,ob,atp,50,73,75,1,2,1);
  let q2_via:i32=stF[9] as i32;
  let q2_val:i32=get32(stF,1136);
  let q2_as:i32=get32(stF,1128);
  let q2_ae:i32=get32(stF,1132);
  let srcF:i32=get32(stF,1140);
  xa_p(ob,atp,"Q Q2B\n");
  xa_query(stF,ob,atp,50,73,75,1,2,1);
  let q2b_via:i32=stF[9] as i32;
  let q2b_val:i32=get32(stF,1136);
  let q2b_adapt:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let t15F:i32=e_count(stF,15);
  let othF:i32=xa_eoth(stF);
  let e14F:i32=e_has_to(stF,3,14);
  let e31F:i32=e_has(stF,3,1,16);
  let nmF:i32=stF[1] as i32;
  let zlive:i32=stF[320+3*32+1] as i32;
  let mdlive:i32=stF[320+0*32+1] as i32;
  let disj:i32=d_disjoint(stF);
  xa_p(ob,atp,"ARM-FULL-END as=");
  xa_pi(ob,atp,q2_as);
  xa_p(ob,atp," ae=");
  xa_pi(ob,atp,q2_ae);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,t16F);
  xa_p(ob,atp," t15=");
  xa_pi(ob,atp,t15F);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othF);
  xa_pnl(ob,atp);

  // ---------- ARM NOADAPT ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  xa_p(ob,atp,"ARM NOADAPT\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stN,ob,atp,100,43,12,1,1,0);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stN,ob,atp,50,52,-1,2,2,0);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stN,ob,atp,50,73,75,1,2,0);
  let na_via:i32=stN[9] as i32;
  let na_val:i32=get32(stN,1136);
  let na_t16:i32=e_count(stN,16);
  let na_nm:i32=stN[1] as i32;
  let othN:i32=xa_eoth(stN);
  xa_p(ob,atp,"ARM-NOADAPT-END t16=");
  xa_pi(ob,atp,na_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othN);
  xa_pnl(ob,atp);

  // ---------- ARM ABLATE-X ----------
  let stX:[]u8=z_alloc(8192);
  d_teach_all(stX);
  xa_p(ob,atp,"ARM ABLATE-X\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stX,ob,atp,100,43,12,1,1,1);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stX,ob,atp,50,52,-1,2,2,1);
  map_retire(stX,1,3);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stX,ob,atp,50,73,75,1,2,1);
  let ax_via:i32=stX[9] as i32;
  let ax_val:i32=get32(stX,1136);
  let ax_t16:i32=e_count(stX,16);
  let ax_e31:i32=e_has(stX,3,1,16);
  let ax_nm:i32=stX[1] as i32;
  let ax_as:i32=get32(stX,1128);
  let ax_ae:i32=get32(stX,1132);
  let othX:i32=xa_eoth(stX);
  xa_p(ob,atp,"ARM-ABLATEX-END as=");
  xa_pi(ob,atp,ax_as);
  xa_p(ob,atp," ae=");
  xa_pi(ob,atp,ax_ae);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,ax_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othX);
  xa_pnl(ob,atp);

  // ---------- ARM ABLATE-Y ----------
  let stY:[]u8=z_alloc(8192);
  d_teach_all(stY);
  xa_p(ob,atp,"ARM ABLATE-Y\n");
  xa_p(ob,atp,"Q QA\n");
  xa_query(stY,ob,atp,100,43,12,1,1,1);
  xa_p(ob,atp,"Q QB\n");
  xa_query(stY,ob,atp,50,52,-1,2,2,1);
  w_kill_cost(stY);
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stY,ob,atp,50,73,75,1,2,1);
  let ay_via:i32=stY[9] as i32;
  let ay_val:i32=get32(stY,1136);
  let ay_t16:i32=e_count(stY,16);
  let ay_nm:i32=stY[1] as i32;
  let ay_as:i32=get32(stY,1128);
  let othY:i32=xa_eoth(stY);
  xa_p(ob,atp,"ARM-ABLATEY-END as=");
  xa_pi(ob,atp,ay_as);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,ay_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othY);
  xa_pnl(ob,atp);

  // ---------- ARM FRESH ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  xa_p(ob,atp,"ARM FRESH\n");
  xa_p(ob,atp,"Q Q2\n");
  xa_query(stR,ob,atp,50,73,75,1,2,1);
  let fr_via:i32=stR[9] as i32;
  let fr_val:i32=get32(stR,1136);
  let fr_t16:i32=e_count(stR,16);
  let fr_nm:i32=stR[1] as i32;
  let fr_as:i32=get32(stR,1128);
  let othR:i32=xa_eoth(stR);
  xa_p(ob,atp,"ARM-FRESH-END as=");
  xa_pi(ob,atp,fr_as);
  xa_p(ob,atp," t16=");
  xa_pi(ob,atp,fr_t16);
  xa_p(ob,atp," oth=");
  xa_pi(ob,atp,othR);
  xa_pnl(ob,atp);

  // ---------- in-Zag kill bars ----------
  let k1:i32=0;
  if(qa_via==1){
    if(qb_via==2){
      if(q2_via==3){
        if(disj==1){k1=1;}
      }
    }
  }
  let k2:i32=0;
  if(ax_t16==0){
    if(ax_via==3){
      if(ax_val==75){
        if(ax_e31==0){
          if(ay_val==-2){
            if(ay_t16==0){
              if(ay_nm==3){k2=1;}
            }
          }
        }
      }
    }
  }
  let k3:i32=0;
  if(na_val==-2){
    if(na_t16==0){
      if(na_nm==3){k3=1;}
    }
  }
  let k4:i32=0;
  if(fr_val==-2){
    if(fr_t16==0){
      if(fr_nm==0){k4=1;}
    }
  }
  let k7:i32=0;
  if(srcF==1){
    if(mdlive==1){k7=1;}
  }
  let k8:i32=0;
  if(q2b_via==3){
    if(q2b_val==75){
      if(q2b_adapt==0){
        if(zlive==1){k8=1;}
      }
    }
  }
  // falsifiers
  let ff:i32=0;
  if(othF!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW NOADAPT\n");ff=1;}
  if(othX!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEX\n");ff=1;}
  if(othY!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEY\n");ff=1;}
  if(othR!=0){xa_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(q2_as!=941){xa_p(ob,atp,"FALSIFIER F-COUNT AS=");xa_pi(ob,atp,q2_as);xa_pnl(ob,atp);ff=1;}
  if(q2_ae!=3){xa_p(ob,atp,"FALSIFIER F-COUNT AE=");xa_pi(ob,atp,q2_ae);xa_pnl(ob,atp);ff=1;}
  if(q2_val!=75){xa_p(ob,atp,"FALSIFIER F-WRONG-Z\n");ff=1;}
  if(q2_via!=3){xa_p(ob,atp,"FALSIFIER F-NO-GROUND\n");ff=1;}
  if(e14F!=1){xa_p(ob,atp,"FALSIFIER F-NO-LINK14\n");ff=1;}
  if(e31F!=1){xa_p(ob,atp,"FALSIFIER F-NO-T16-SRC\n");ff=1;}
  if(t16F!=2){xa_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(t15F!=2){xa_p(ob,atp,"FALSIFIER F-T15-COUNT\n");ff=1;}
  xa_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k7",k7);
  d_bar(ob,atp,"k8",k8);
  xa_pnl(ob,atp);
  xa_p(ob,atp,"FALSIFIERS ");
  xa_pi(ob,atp,ff);
  xa_pnl(ob,atp);
  xa_p(ob,atp,"L2-SUBSTITUTE-XDOMAIN-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

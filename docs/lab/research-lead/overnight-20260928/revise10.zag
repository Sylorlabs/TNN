    emit("CHECK N29 status==PROVISIONAL (demoted) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N29 status==PROVISIONAL FAIL\n"); }
  let inFg2:[]u8="xab"; let outFg2:[]u8="bbb";

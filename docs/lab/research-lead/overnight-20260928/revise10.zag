  let VSO3:[]u8=z_alloc(512);
  vs3_init(VSO3, p0a, 1);
  if(vs3_revise(VSO3, 0, 122, wprog, 1)!=1){ emit("FATAL O3 revise1\n"); return 1; }
  let outO3:[]u8=z_alloc(16);

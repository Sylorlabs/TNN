  ntest_total=ntest_total+1;
  if(vs3_status(VSN1,1)==0){
    emit("CHECK N8 status==ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N8 status==ROLLED_BACK FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN1,inZ3,outN1)==1 && streq(outN1[0..3],outZ3)==1){
    emit("CHECK N9 exact restoration zbq->qqq PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N9 exact restoration zbq->qqq FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN1,in0,outN1)==1 && streq(outN1[0..3],out0)==1){
    emit("CHECK N10 passing abc->ccc intact PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N10 passing abc->ccc intact FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN1,inZ1,outN1)==1 && streq(outN1[0..3],e_yyy)==1){
    emit("CHECK N11 P0 restoration zqy->yyy PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N11 P0 restoration zqy->yyy FAIL\n"); }

  // N2: non-interference (4 CHECKs).
  emit("\n--- Phase N2: non-interference ---\n");
  let VSN2:[]u8=z_alloc(512);
  vs3_init(VSN2, p0, nn0);
  let inW1:[]u8="xqw"; let outW1:[]u8="xxx";
  let inW2:[]u8="xab"; let outW2:[]u8="xxx";
  let drW2:i32=diagnose_propose(D, pdesc, 4, inW1, outW1);
  if(drW2<0){ emit("FATAL N2 propose\n"); return 1; }
  let dposW2:i32=drW2/1000; let dvalW2:i32=drW2-dposW2*1000;
  if(dposW2!=0 || dvalW2!=120){ emit("FATAL N2 propose value\n"); return 1; }
  let descWN2:[]u8=z_alloc(12);
  let sWN2:i32=pextract(inW1, outW1, S[S_off..S_off+64]);
  if(sWN2<0){ emit("FATAL N2 extract\n"); return 1; }
  set32(descWN2, 0, S_off); set32(descWN2, 4, sWN2); set32(descWN2, 8, inW1.len);
  S_off=S_off+64;
  let p1WN2:[]u8=z_alloc(48);
  let nnWN2:i32=discover(S, descWN2, 1, p1WN2);
  if(nnWN2<0){ emit("FATAL N2 discover\n"); return 1; }
  if(diagnose_corroborate_v6(VSN2, inW2, outW2, dposW2, dvalW2, p1WN2, nnWN2)!=1){ emit("FATAL N2 corroborate\n"); return 1; }
  if(vs3_revise(VSN2, dposW2, dvalW2, p1WN2, nnWN2)!=1){ emit("FATAL N2 revise\n"); return 1; }
  let inY:[]u8="yzb"; let outY:[]u8="yyy";
  let outN2:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN2,inY,outN2)==1 && streq(outN2[0..3],e_bbb)==1 && streq(outN2[0..3],outY)!=1){
    emit("CHECK N12 VS mispredicts yzb->bbb (no fire) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N12 VS mispredicts yzb->bbb FAIL\n"); }
  let rbN2:i32=diagnose_rollback_check(VSN2, inY, outY);
  ntest_total=ntest_total+1;
  if(rbN2==0){
    emit("CHECK N13 rollback_check==0 (no revision implicated) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N13 rollback_check==0 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSN2,1)==1){
    emit("CHECK N14 status stays PROVISIONAL PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N14 status stays PROVISIONAL FAIL\n"); }
  ntest_total=ntest_total+1;
  if(get32(VSN2,0)==1){
    emit("CHECK N15 vcount==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N15 vcount==1 FAIL\n"); }

  // N3: forged contradiction is dual-use; re-admission bounds it (9 CHECKs).
  emit("\n--- Phase N3: forged contradiction + re-admission ---\n");
  let outN3:[]u8=z_alloc(16);

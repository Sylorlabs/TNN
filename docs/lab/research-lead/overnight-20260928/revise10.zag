  vs3_init(VSO5, p0a, 1);
  if(vs3_revise(VSO5, 1, 98, p0a, 1)!=1){ emit("FATAL O5 revise1\n"); return 1; }
  if(vs3_revise(VSO5, 0, 122, wprog, 1)!=1){ emit("FATAL O5 revise2\n"); return 1; }
  let rbO5:i32=diagnose_rollback_check(VSO5, inO, outO);
  ntest_total=ntest_total+1;
  if(rbO5==1){
    emit("CHECK O17 override rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O17 FAIL rb="); emit(i32s(rbO5)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO5,2)==0){
    emit("CHECK O18 wrong top revision rolled back PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O18 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO5,1)==1){
    emit("CHECK O19 correct fellow revision untouched PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O19 status FAIL\n"); }

  // ============ Phase P: H-REVISE9 peeling protocol (R7) ============
  // Hand-built programs (same as the X-RV8-2b adversary fixture).
  // p0a = [4,0,0]: single node type 4 (constant 2). For 3-char input,
  // out[k] = inp[2] for all k. p0b = [0,0,0]: identity.
  // wprog = [2,0,0]: single node type 2 (constant 0). out[k] = inp[0].
  let p0aP:[]u8=z_alloc(3); p0aP[0]=4; p0aP[1]=0; p0aP[2]=0;
  let p0bP:[]u8=z_alloc(3); p0bP[0]=0; p0bP[1]=0; p0bP[2]=0;
  let wprogP:[]u8=z_alloc(3); wprogP[0]=2; wprogP[1]=0; wprogP[2]=0;
  let identP:[]u8=z_alloc(3); identP[0]=0; identP[1]=0; identP[2]=0;
  let inP:[]u8="zbq"; let outP:[]u8="qqq";
  let outPbuf:[]u8=z_alloc(16);

  // P1: B-RV8-2 closure; two wrong revisions atop a correct one (5 CHECKs).
  emit("\n--- Phase P1: subset closure (B-RV8-2 closed) ---\n");
  let VSP1:[]u8=z_alloc(512);
  vs3_init(VSP1, p0bP, 1);
  if(vs3_revise(VSP1, 2, 113, p0aP, 1)!=1){ emit("FATAL P1 revise1\n"); return 1; }
  if(vs3_revise(VSP1, 1, 98, wprogP, 1)!=1){ emit("FATAL P1 revise2\n"); return 1; }
  if(vs3_revise(VSP1, 0, 122, wprogP, 1)!=1){ emit("FATAL P1 revise3\n"); return 1; }
  let skcf:[]u8=z_alloc(16); skcf[0]=3; skcf[1]=2;
  if(vs3_apply_skip_set(VSP1, inP, outPbuf, skcf, 2)!=1 || streq(outPbuf[0..3], outP)!=1){
    emit("FATAL P1 pair-counterfactual broken\n"); return 1;
  }
  let rbP1:i32=diagnose_rollback_check(VSP1, inP, outP);
  ntest_total=ntest_total+1;
  if(rbP1==1){
    emit("CHECK P1 peel rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P1 FAIL rb="); emit(i32s(rbP1)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP1,3)==0){
    emit("CHECK P2 slot3 ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P2 slot3 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP1,2)==0){
    emit("CHECK P3 slot2 ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P3 slot2 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP1,1)==1){
    emit("CHECK P4 correct slot1 untouched PROVISIONAL PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P4 slot1 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSP1,inP,outPbuf)==1 && streq(outPbuf[0..3],outP)==1){
    emit("CHECK P5 exact restoration zbq->qqq via slot1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P5 restoration FAIL\n"); }

  // P2: forged boundary unchanged (X-RV8-1 fixture; dual-use disclosed) (2 CHECKs).
  emit("\n--- Phase P2: forged firing-set boundary (unchanged) ---\n");
  let VSP2:[]u8=z_alloc(512);
  vs3_init(VSP2, p0aP, 1);
  if(vs3_revise(VSP2, 0, 122, identP, 1)!=1){ emit("FATAL P2 revise1\n"); return 1; }
  if(diagnose_confirm_check(VSP2, inP, inP)!=1){ emit("FATAL P2 confirm1\n"); return 1; }
  if(vs3_revise(VSP2, 1, 98, identP, 1)!=1){ emit("FATAL P2 revise2\n"); return 1; }
  if(diagnose_confirm_check(VSP2, inP, inP)!=1){ emit("FATAL P2 confirm2\n"); return 1; }
  let forged:[]u8="qqq";
  let rbP2a:i32=diagnose_rollback_check(VSP2, inP, forged);
  ntest_total=ntest_total+1;
  if(rbP2a==2 && vs3_status(VSP2,1)==1 && vs3_status(VSP2,2)==1){
    emit("CHECK P6 forged label demotes both ACTIVE revisions PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P6 forged demote FAIL\n"); }
  let rbP2b:i32=diagnose_rollback_check(VSP2, inP, forged);
  ntest_total=ntest_total+1;
  if(rbP2b==1 && vs3_status(VSP2,1)==0 && vs3_status(VSP2,2)==0){
    emit("CHECK P7 second forged label rolls back both PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P7 forged rollback FAIL\n"); }

  // P3a: minimality; single wrong revision atop a correct fellow (3 CHECKs).
  emit("\n--- Phase P3a: minimality (wrong top felled, fellow untouched) ---\n");
  let VSP3a:[]u8=z_alloc(512);
  vs3_init(VSP3a, p0aP, 1);
  if(vs3_revise(VSP3a, 1, 98, p0aP, 1)!=1){ emit("FATAL P3a revise1\n"); return 1; }
  if(vs3_revise(VSP3a, 0, 122, wprogP, 1)!=1){ emit("FATAL P3a revise2\n"); return 1; }
  let rbP3a:i32=diagnose_rollback_check(VSP3a, inP, outP);
  ntest_total=ntest_total+1;
  if(rbP3a==1){
    emit("CHECK P8 rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P8 FAIL rb="); emit(i32s(rbP3a)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP3a,2)==0){
    emit("CHECK P9 wrong top slot2 ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P9 slot2 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP3a,1)==1){
    emit("CHECK P10 correct fellow slot1 untouched PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P10 slot1 status FAIL\n"); }

  // P3b: veto preserved; correct most-recent member stops action (2 CHECKs).
  emit("\n--- Phase P3b: veto (correct most-recent member, no action) ---\n");
  let VSP3b:[]u8=z_alloc(512);
  vs3_init(VSP3b, p0aP, 1);
  if(vs3_revise(VSP3b, 0, 122, wprogP, 1)!=1){ emit("FATAL P3b revise1\n"); return 1; }
  if(vs3_revise(VSP3b, 1, 98, p0aP, 1)!=1){ emit("FATAL P3b revise2\n"); return 1; }
  let rbP3b:i32=diagnose_rollback_check(VSP3b, inP, outP);
  ntest_total=ntest_total+1;
  if(rbP3b==0){
    emit("CHECK P11 rollback_check==0 (veto) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P11 FAIL rb="); emit(i32s(rbP3b)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP3b,1)==1 && vs3_status(VSP3b,2)==1){
    emit("CHECK P12 no state change PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P12 status FAIL\n"); }

  // P4: tombstone interleaving preserved (X-RV8-3 fixture) (4 CHECKs).
  emit("\n--- Phase P4: tombstone interleaving (X-RV8-3 closed shape) ---\n");
  let VSP4:[]u8=z_alloc(512);
  vs3_init(VSP4, p0aP, 1);
  if(vs3_revise(VSP4, 0, 122, wprogP, 1)!=1){ emit("FATAL P4 revise1\n"); return 1; }
  if(diagnose_rollback_check(VSP4, inP, outP)!=1){ emit("FATAL P4 first rollback\n"); return 1; }
  if(vs3_revise(VSP4, 1, 98, wprogP, 1)!=1){ emit("FATAL P4 revise2\n"); return 1; }
  if(vs3_revise(VSP4, 2, 113, wprogP, 1)!=1){ emit("FATAL P4 revise3\n"); return 1; }
  let rbP4:i32=diagnose_rollback_check(VSP4, inP, outP);
  ntest_total=ntest_total+1;
  if(rbP4==1){
    emit("CHECK P13 rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P13 FAIL rb="); emit(i32s(rbP4)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP4,3)==0 && vs3_status(VSP4,2)==0){
    emit("CHECK P14 both live wrong revisions ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P14 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSP4,1)==0){
    emit("CHECK P15 tombstoned slot1 untouched PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P15 slot1 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(get32(VSP4,0)==3){
    emit("CHECK P16 vcount==3 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK P16 vcount FAIL\n"); }

  // ============ Phase Q: H-REVISE10 in-function contradiction guard (R10) ============
  // Q1: B-RV9-3 closure. X-RV9-4 misuse fixture: store predicts the
  // trusted label, so no contradiction exists. The R10 guard must return
  // 0 with zero state change (old code: Branch A felled slot2, rb==1).
  emit("\n--- Phase Q1: guard closure (B-RV9-3 closed) ---\n");
  let VSQ1:[]u8=z_alloc(512);
  vs3_init(VSQ1, p0bP, 1);
  if(vs3_revise(VSQ1, 2, 113, p0aP, 1)!=1){ emit("FATAL Q1 revise1\n"); return 1; }
  if(vs3_revise(VSQ1, 1, 98, p0aP, 1)!=1){ emit("FATAL Q1 revise2\n"); return 1; }
  let outQ1:[]u8=z_alloc(16);
  if(vs3_apply(VSQ1, inP, outQ1)!=1 || streq(outQ1[0..3], outP)!=1){
    emit("FATAL Q1 no-contradiction sanity broken\n"); return 1;
  }
  let rbQ1:i32=diagnose_rollback_check(VSQ1, inP, outP);
  ntest_total=ntest_total+1;
  if(rbQ1==0){
    emit("CHECK Q1 guard rollback_check==0 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q1 FAIL rb="); emit(i32s(rbQ1)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ1,1)==1 && vs3_status(VSQ1,2)==1){
    emit("CHECK Q2 zero state change PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q2 state changed FAIL\n"); }
  // Q3 (GUARD emit line present) is verified via grep on the raw output
  // during analysis, per PREREG_REVISE10.md K-RV10-1.
  ntest_total=ntest_total+1;
  if(vs3_apply(VSQ1, inP, outQ1)==1 && streq(outQ1[0..3], outP)==1){
    emit("CHECK Q4 store intact predicts qqq PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q4 store damaged FAIL\n"); }

  // Q2: ACTIVE-member peel. Three wrong revisions (two ACTIVE, one
  // PROVISIONAL) stacked over one correct PROVISIONAL. Peel must demote
  // (not roll back) the ACTIVE members, roll back the PROVISIONAL.
  emit("\n--- Phase Q2: ACTIVE-member peel (3 stacked wrong) ---\n");
  let VSQ2:[]u8=z_alloc(512);
  vs3_init(VSQ2, p0bP, 1);
  if(vs3_revise(VSQ2, 2, 113, p0aP, 1)!=1){ emit("FATAL Q2 revise1\n"); return 1; }
  if(vs3_revise(VSQ2, 1, 98, wprogP, 1)!=1){ emit("FATAL Q2 revise2\n"); return 1; }
  let outQ2:[]u8=z_alloc(16);
  let inCfQ:[]u8="zbq"; let outCfQ:[]u8="zzz";
  if(vs3_apply(VSQ2, inCfQ, outQ2)!=1 || streq(outQ2[0..3], outCfQ)!=1){
    emit("FATAL Q2 pre-confirm sanity\n"); return 1;
  }
  if(diagnose_confirm_check(VSQ2, inCfQ, outCfQ)!=1){ emit("FATAL Q2 confirm2\n"); return 1; }
  if(vs3_status(VSQ2,2)!=2){ emit("FATAL Q2 slot2 not ACTIVE\n"); return 1; }
  if(vs3_revise(VSQ2, 0, 122, wprogP, 1)!=1){ emit("FATAL Q2 revise3\n"); return 1; }
  if(diagnose_confirm_check(VSQ2, inCfQ, outCfQ)!=1){ emit("FATAL Q2 confirm3\n"); return 1; }
  if(vs3_status(VSQ2,3)!=2){ emit("FATAL Q2 slot3 not ACTIVE\n"); return 1; }
  if(vs3_revise(VSQ2, 2, 113, wprogP, 1)!=1){ emit("FATAL Q2 revise4\n"); return 1; }
  if(vs3_apply(VSQ2, inP, outQ2)!=1 || streq(outQ2[0..3], outCfQ)!=1){
    emit("FATAL Q2 genuine-contradiction sanity broken\n"); return 1;
  }
  let rbQ2:i32=diagnose_rollback_check(VSQ2, inP, outP);
  ntest_total=ntest_total+1;
  if(rbQ2==1){
    emit("CHECK Q5 ACTIVE-peel rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q5 FAIL rb="); emit(i32s(rbQ2)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ2,4)==0){
    emit("CHECK Q6 slot4 PROVISIONAL rolled back PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q6 slot4 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ2,3)==1){
    emit("CHECK Q7 slot3 ACTIVE demoted PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q7 slot3 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ2,2)==1){
    emit("CHECK Q8 slot2 ACTIVE demoted PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q8 slot2 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ2,1)==1){
    emit("CHECK Q9 slot1 correct untouched PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q9 slot1 status FAIL\n"); }
  // Second contradiction: the demoted PROVISIONAL members are now felled
  // by the peel, and restoration via slot1 occurs.
  let rbQ2b:i32=diagnose_rollback_check(VSQ2, inP, outP);
  ntest_total=ntest_total+1;
  if(rbQ2b==1 && vs3_status(VSQ2,3)==0 && vs3_status(VSQ2,2)==0 &&
     vs3_apply(VSQ2, inP, outQ2)==1 && streq(outQ2[0..3], outP)==1){
    emit("CHECK Q10 second peel fells demoted, restoration qqq PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q10 second peel/restoration FAIL\n"); }

  // Q3: forged label against mixed ACTIVE/PROVISIONAL stack. The R10
  // guard must NOT trigger (forged label differs from store prediction).
  // Branch B applies per-member protocol: PROVISIONAL rolled back,
  // ACTIVE demoted. Dual-use disclosed.
  emit("\n--- Phase Q3: forged label, mixed ACTIVE/PROVISIONAL ---\n");
  let VSQ3:[]u8=z_alloc(512);
  vs3_init(VSQ3, p0aP, 1);
  if(vs3_revise(VSQ3, 0, 122, p0bP, 1)!=1){ emit("FATAL Q3 revise1\n"); return 1; }
  let outQ3:[]u8=z_alloc(16);
  let inZb:[]u8="zbq"; let outZb:[]u8="zbq";
  if(diagnose_confirm_check(VSQ3, inZb, outZb)!=1){ emit("FATAL Q3 confirm1\n"); return 1; }
  if(vs3_status(VSQ3,1)!=2){ emit("FATAL Q3 slot1 not ACTIVE\n"); return 1; }
  if(vs3_revise(VSQ3, 1, 98, p0bP, 1)!=1){ emit("FATAL Q3 revise2\n"); return 1; }
  if(vs3_apply(VSQ3, inZb, outQ3)!=1 || streq(outQ3[0..3], outZb)!=1){
    emit("FATAL Q3 store-predicts-zbq sanity broken\n"); return 1;
  }
  let forgedQ:[]u8="qqq";
  let rbQ3:i32=diagnose_rollback_check(VSQ3, inZb, forgedQ);
  ntest_total=ntest_total+1;
  if(rbQ3==1){
    emit("CHECK Q11 forged-mixed rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q11 FAIL rb="); emit(i32s(rbQ3)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ3,2)==0){
    emit("CHECK Q12 slot2 PROVISIONAL rolled back PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q12 slot2 status FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSQ3,1)==1){
    emit("CHECK Q13 slot1 ACTIVE demoted PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK Q13 slot1 status FAIL\n"); }

  emit("\n=== RESULT: ");
  emit(i32s(npass_total)); emit("/"); emit(i32s(ntest_total));
  emit(" ===\n");
  if(npass_total==ntest_total){
    emit("H-REVISE10 SURVIVES\n");
    return 0;
  }
  emit("H-REVISE10 KILLED\n");
  return 1;
}

  if(vs3_revise(VSO3, 1, 98, wprog, 1)!=1){ emit("FATAL O3 revise2\n"); return 1; }
  let rbO3:i32=diagnose_rollback_check(VSO3, inO, outO);
  ntest_total=ntest_total+1;

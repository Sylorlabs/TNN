    emit("CHECK O6 control rollback_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O6 control FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO2,1)==0){
    emit("CHECK O7 control slot ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O7 control status FAIL\n"); }

  // O3: mixed ACTIVE+PROVISIONAL firing set; graded per-member protocol (6 CHECKs).

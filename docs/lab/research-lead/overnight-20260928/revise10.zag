  S_off=S_off+64;
  let p1N:[]u8=z_alloc(48);
  let nnN1:i32=discover(S, descZN1, 1, p1N);
  if(nnN1<0){ emit("FATAL N1 discover\n"); return 1; }
  ntest_total=ntest_total+1;
  if(nnN1==3){
    emit("CHECK N2 discover nn==3 (broadcast-first) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N2 discover nn==3 FAIL\n"); }
  let corN1:i32=diagnose_corroborate_v6(VSN1, inZ2, outZ2, dposN, dvalN, p1N, nnN1);
  ntest_total=ntest_total+1;
  if(corN1==1){
    emit("CHECK N3 gate==1 on adversarial fail2 PASS (detection NOT claimed; frozen expectation)\n"); npass_total=npass_total+1;
  } else { emit("CHECK N3 gate==1 FAIL (fixture error)\n"); }
  let rcN1:i32=vs3_revise(VSN1, dposN, dvalN, p1N, nnN1);
  ntest_total=ntest_total+1;
  if(rcN1==1){
    emit("CHECK N4 revise rc==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N4 revise rc==1 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSN1,1)==1){
    emit("CHECK N5 status==PROVISIONAL PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N5 status==PROVISIONAL FAIL\n"); }
  vs3_dump(VSN1);
  let inZ3:[]u8="zbq"; let outZ3:[]u8="qqq";

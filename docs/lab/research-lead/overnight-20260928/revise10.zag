    emit("CHECK N19 re-propose==(0,120) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N19 re-propose==(0,120) FAIL\n"); }
  let descWN3:[]u8=z_alloc(12);
  let sWN3:i32=pextract(inW1, outW1, S[S_off..S_off+64]);
  if(sWN3<0){ emit("FATAL N3 extract\n"); return 1; }
  set32(descWN3, 0, S_off); set32(descWN3, 4, sWN3); set32(descWN3, 8, inW1.len);
  S_off=S_off+64;
  let p1N3:[]u8=z_alloc(48);
  let nnN3:i32=discover(S, descWN3, 1, p1N3);
  if(nnN3<0){ emit("FATAL N3 discover\n"); return 1; }
  let corN3:i32=diagnose_corroborate_v6(VSN2, inW2, outW2, dposN3, dvalN3, p1N3, nnN3);
  ntest_total=ntest_total+1;
  if(corN3==1){
    emit("CHECK N20 re-corroborate==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N20 re-corroborate==1 FAIL\n"); }
  let rcN3:i32=vs3_revise(VSN2, dposN3, dvalN3, p1N3, nnN3);
  ntest_total=ntest_total+1;
  if(rcN3==1){
    emit("CHECK N21 re-revise rc==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N21 re-revise rc==1 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(get32(VSN2,0)==1){
    emit("CHECK N22 vcount==1 (reactivation, no duplicate) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N22 vcount==1 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSN2,1)==1){
    emit("CHECK N23 status==PROVISIONAL (reactivated) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N23 status==PROVISIONAL FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN2,inW1,outN3)==1 && streq(outN3[0..3],outW1)==1){
    emit("CHECK N24 re-admitted xqw->xxx PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N24 re-admitted xqw->xxx FAIL\n"); }

  // N4: promotion and graded contradiction (7 CHECKs).
  emit("\n--- Phase N4: confirm + graded contradiction ---\n");
  let VSN4:[]u8=z_alloc(512);
  vs3_init(VSN4, p0, nn0);
  let drW4:i32=diagnose_propose(D, pdesc, 4, inW1, outW1);
  if(drW4<0){ emit("FATAL N4 propose\n"); return 1; }
  let dposW4:i32=drW4/1000; let dvalW4:i32=drW4-dposW4*1000;
  if(dposW4!=0 || dvalW4!=120){ emit("FATAL N4 propose value\n"); return 1; }
  let descWN4:[]u8=z_alloc(12);
  let sWN4:i32=pextract(inW1, outW1, S[S_off..S_off+64]);
  if(sWN4<0){ emit("FATAL N4 extract\n"); return 1; }
  set32(descWN4, 0, S_off); set32(descWN4, 4, sWN4); set32(descWN4, 8, inW1.len);
  S_off=S_off+64;
  let p1WN4:[]u8=z_alloc(48);
  let nnWN4:i32=discover(S, descWN4, 1, p1WN4);
  if(nnWN4<0){ emit("FATAL N4 discover\n"); return 1; }
  if(diagnose_corroborate_v6(VSN4, inW2, outW2, dposW4, dvalW4, p1WN4, nnWN4)!=1){ emit("FATAL N4 corroborate\n"); return 1; }
  if(vs3_revise(VSN4, dposW4, dvalW4, p1WN4, nnWN4)!=1){ emit("FATAL N4 revise\n"); return 1; }
  let inCf:[]u8="xqp"; let outCf:[]u8="xxx";
  let outN4:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(vs3_apply(VSN4,inCf,outN4)==1 && streq(outN4[0..3],outCf)==1){
    emit("CHECK N25 VS correct on xqp->xxx PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N25 VS correct on xqp->xxx FAIL\n"); }
  let cfN4:i32=diagnose_confirm_check(VSN4, inCf, outCf);
  ntest_total=ntest_total+1;
  if(cfN4==1){
    emit("CHECK N26 confirm_check==1 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N26 confirm_check==1 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSN4,1)==2){
    emit("CHECK N27 status==ACTIVE PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N27 status==ACTIVE FAIL\n"); }
  let inFg1:[]u8="xqw"; let outFg1:[]u8="www";
  if(vs3_apply(VSN4,inFg1,outN4)!=1 || streq(outN4[0..3],outFg1)==1){ emit("FATAL N4 forged1 not a failure\n"); return 1; }
  let rbN4:i32=diagnose_rollback_check(VSN4, inFg1, outFg1);
  ntest_total=ntest_total+1;
  if(rbN4==2){
    emit("CHECK N28 demote returns 2 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N28 demote returns 2 FAIL\n"); }
  ntest_total=ntest_total+1;

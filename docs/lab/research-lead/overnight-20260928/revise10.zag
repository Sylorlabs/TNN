    emit("CHECK N31 status==ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N31 status==ROLLED_BACK FAIL\n"); }

  // N5: nn<=0 defense in depth (1 CHECK).
  emit("\n--- Phase N5: nn<=0 guard ---\n");
  let corN5:i32=diagnose_corroborate_v6(VSN4, inFg2, outFg2, 0, 120, p1WN4, 0);
  ntest_total=ntest_total+1;
  if(corN5==0){
    emit("CHECK N32 nn<=0 withholds cleanly PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N32 nn<=0 withholds cleanly FAIL\n"); }

  // ============ Phase O: H-REVISE8 multi-slot rollback (R6) ============
  // Hand-built programs (same as the X-RV7-3 adversary fixture).
  // p0a = [4,0,0]: single node type 4 (constant 2). For 3-char input,
  // out[k] = inp[2] for all k. p0b = [0,0,0]: identity.
  // wprog = [2,0,0]: single node type 2 (constant 0). out[k] = inp[0].
  let p0a:[]u8=z_alloc(3); p0a[0]=4; p0a[1]=0; p0a[2]=0;
  let p0b:[]u8=z_alloc(3); p0b[0]=0; p0b[1]=0; p0b[2]=0;
  let wprog:[]u8=z_alloc(3); wprog[0]=2; wprog[1]=0; wprog[2]=0;
  let inO:[]u8="zbq"; let outO:[]u8="qqq"; let outW:[]u8="zzz";

  // O1: X-RV7-3 replay; both provisional revisions roll back (5 CHECKs).
  emit("\n--- Phase O1: X-RV7-3 replay (interference closed) ---\n");
  let VSO1:[]u8=z_alloc(512);
  vs3_init(VSO1, p0a, 1);
  let or1:i32=vs3_revise(VSO1, 0, 122, wprog, 1);
  let or2:i32=vs3_revise(VSO1, 1, 98, wprog, 1);
  let outO1:[]u8=z_alloc(16);
  ntest_total=ntest_total+1;
  if(or1==1 && or2==1 && vs3_apply(VSO1,inO,outO1)==1 && streq(outO1[0..3],outW)==1 && streq(outO1[0..3],outO)!=1){
    emit("CHECK O1 both revisions mispredict zbq->zzz PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O1 mispredict sanity FAIL\n"); }
  let rbO1:i32=diagnose_rollback_check(VSO1, inO, outO);
  ntest_total=ntest_total+1;
  if(rbO1==1){
    emit("CHECK O2 rollback_check==1 (nonzero) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O2 rollback_check==1 FAIL rb="); emit(i32s(rbO1)); emit("\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO1,1)==0){
    emit("CHECK O3 slot1 ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O3 slot1 ROLLED_BACK FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO1,2)==0){
    emit("CHECK O4 slot2 ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O4 slot2 ROLLED_BACK FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_apply(VSO1,inO,outO1)==1 && streq(outO1[0..3],outO)==1){
    emit("CHECK O5 exact restoration zbq->qqq PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O5 restoration FAIL\n"); }

  // O2: X735 control; single provisional revision still rolls back (2 CHECKs).
  emit("\n--- Phase O2: single-slot control ---\n");
  let VSO2:[]u8=z_alloc(512);
  vs3_init(VSO2, p0a, 1);
  let crO:i32=vs3_revise(VSO2, 1, 98, wprog, 1);
  let rbO2:i32=diagnose_rollback_check(VSO2, inO, outO);
  ntest_total=ntest_total+1;

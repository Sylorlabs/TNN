  let rbN3:i32=diagnose_rollback_check(VSN2, inF1, outF1);
  ntest_total=ntest_total+1;
  if(rbN3==1){
    emit("CHECK N16 forged rollback_check==1 PASS (dual-use disclosed)\n"); npass_total=npass_total+1;
  } else { emit("CHECK N16 forged rollback_check==1 FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSN2,1)==0){
    emit("CHECK N17 status==ROLLED_BACK PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N17 status==ROLLED_BACK FAIL\n"); }
  if(vs3_apply(VSN2,inW1,outN3)!=1 || streq(outN3[0..3],outW1)==1){ emit("FATAL N3 genuine not a failure\n"); return 1; }
  let rbN3b:i32=diagnose_rollback_check(VSN2, inW1, outW1);
  ntest_total=ntest_total+1;

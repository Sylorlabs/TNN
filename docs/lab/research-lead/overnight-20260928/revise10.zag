    emit("CHECK N18 genuine rollback_check==0 (nothing firing) PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N18 genuine rollback_check==0 FAIL\n"); }
  let drN3:i32=diagnose_propose(D, pdesc, 4, inW1, outW1);
  if(drN3<0){ emit("FATAL N3 propose\n"); return 1; }
  let dposN3:i32=drN3/1000; let dvalN3:i32=drN3-dposN3*1000;

    emit("CHECK O12 ACTIVE demoted to PROVISIONAL PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O12 demote FAIL\n"); }
  ntest_total=ntest_total+1;
  if(vs3_status(VSO3,2)==0){
    emit("CHECK O13 PROVISIONAL rolled back PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK O13 rollback FAIL\n"); }

  // O4: underdetermination preserved; uncovered baseline also wrong (3 CHECKs).
  emit("\n--- Phase O4: no correct uncovered baseline (no action) ---\n");
  let VSO4:[]u8=z_alloc(512);

    emit("CHECK N6 VS mispredicts zbq->zzz PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK N6 VS mispredicts zbq->zzz FAIL\n"); }
  let rbN1:i32=diagnose_rollback_check(VSN1, inZ3, outZ3);

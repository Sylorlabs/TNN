// vh_mech.zag -- verify_h1: H1 learned typed contracts drive the verification loop.
// Standalone pure-Zag program. The learner induces I/O signatures with the
// real H1 machinery (kind probe over world facts, per-observation kind
// accumulation, majority finalize), commits to compositions with
// contract-predicted outcomes, and updates confidence from the world gate
// alone. No harness answer keys; no hardcoded signatures.
//
// Conventions: L = learner state slice, E = world state slice.
// L cells (i32): 0 conf_DD, 1 conf_CC, 2 commit_comp, 3 commit_pred,
//   4 commit_input, 5 commit_status (0 none, 1 PENDING, 2 RESOLVED),
//   6..11 comp C stats (in_sum,in_n,out_sum,out_n,sig_in,sig_out),
//   12..17 comp D stats (same layout).
// E cells (i32): 0 gate, 1 accepts, 2 rejects,
//   3..11 world facts: 3 facts x (subject, relation, object).
// Kind codes: 1 NODE, 2 NUM. Component ids: C 0, D 1.
// Composition ids: DD 0, CC 1.

// ---------- output helpers (one buffer, cursor-returning) ----------
// Per toolchain lesson: no _zag_print for dynamic content. All output is
// formatted into ONE preallocated buffer; the driver performs a single
// _zag_raw_syscall write at the end.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
// Count digits, fill from the end. No second allocation, no reverse copy.
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
fn e1kind(b:[]u8,c:i32,k:i32)i32 {
  if(k==1){return e1str(b,c,"NODE");}
  if(k==2){return e1str(b,c,"NUM");}
  return e1str(b,c,"?");
}
fn e1sig(b:[]u8,c:i32,si:i32,so:i32)i32 {
  c=e1kind(b,c,si);
  c=e1str(b,c,"->");
  c=e1kind(b,c,so);
  return c;
}
fn e1comp(b:[]u8,c:i32,g:i32)i32 {
  if(g==0){return e1str(b,c,"DD");}
  return e1str(b,c,"CC");
}
fn e1cname(b:[]u8,c:i32,cp:i32)i32 {
  if(cp==0){return e1str(b,c,"C");}
  return e1str(b,c,"D");
}

// ---------- state cells (u8-backed, little-endian) ----------
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn lg(L:[]u8,f:i32)i32 { return get32(L,f*4); }
fn ls(L:[]u8,f:i32,v:i32)void { set32(L,f*4,v); return; }

// ---------- world facts ----------
// Frozen world: relation 91 chain (31,91,32), (32,91,33), (33,91,34).
fn world_init(E:[]u8)void {
  set32(E,3*4,31); set32(E,4*4,91); set32(E,5*4,32);
  set32(E,6*4,32); set32(E,7*4,91); set32(E,8*4,33);
  set32(E,9*4,33); set32(E,10*4,91); set32(E,11*4,34);
  return;
}

// ---------- H1 kind probe (real H1 logic) ----------
// kind(v) = 1 (NODE) iff v appears as a fact subject, else 2 (NUM).
fn probe_kind(E:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<3){
    if(get32(E,(3+i*3)*4)==v){return 1;}
    i=i+1;
  }
  return 2;
}

// ---------- components (fixed true behavior; learner sees only probes) ----------
fn comp_run(c:i32,v:i32)i32 {
  if(c==0){
    if(v==31){return 32;}
    if(v==32){return 33;}
    if(v==33){return 34;}
    return -1;
  }
  return v+1;
}
fn comp_first(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}
fn comp_second(g:i32)i32 {
  if(g==0){return 1;}
  return 0;
}

// ---------- H1 signature induction (real H1 logic) ----------
// Per-observation kind accumulation. Signature cells are written ONLY by
// h1_finalize; there are no signature literals anywhere in this program.
fn h1_observe(L:[]u8,E:[]u8,c:i32,vin:i32,vout:i32)void {
  let base:i32=6+c*6;
  ls(L,base+0,lg(L,base+0)+probe_kind(E,vin));
  ls(L,base+1,lg(L,base+1)+1);
  ls(L,base+2,lg(L,base+2)+probe_kind(E,vout));
  ls(L,base+3,lg(L,base+3)+1);
  return;
}
// Majority finalize: once n>=2, sig=1 unless sum*2>=n*3 (mean kind>=1.5).
// Exact rule from l2_h1.zag finalize_sig, adapted only in state layout.
fn h1_finalize(L:[]u8,c:i32)void {
  let base:i32=6+c*6;
  let inn:i32=lg(L,base+1);
  if(inn>=2){
    let si:i32=1;
    if(lg(L,base+0)*2>=inn*3){si=2;}
    ls(L,base+4,si);
  }
  let outn:i32=lg(L,base+3);
  if(outn>=2){
    let so:i32=1;
    if(lg(L,base+2)*2>=outn*3){so=2;}
    ls(L,base+5,so);
  }
  return;
}
fn h1_sig_in(L:[]u8,c:i32)i32 { return lg(L,6+c*6+4); }
fn h1_sig_out(L:[]u8,c:i32)i32 { return lg(L,6+c*6+5); }

// ---------- contract application ----------
// Predicted final kind for (input -> composition g): the input kind must
// match sig_in(first), the seam sig_out(first) must match sig_in(second);
// then the predicted outcome kind is sig_out(second). Else -1 (refuse).
fn h1_predict(L:[]u8,E:[]u8,g:i32,input:i32)i32 {
  let kin:i32=probe_kind(E,input);
  let a:i32=comp_first(g);
  let b:i32=comp_second(g);
  if(kin!=h1_sig_in(L,a)){return -1;}
  if(h1_sig_out(L,a)!=h1_sig_in(L,b)){return -1;}
  return h1_sig_out(L,b);
}

// ---------- commitment (learner operation) ----------
// Records the contract-predicted outcome BEFORE any execution. The
// prediction is computed from the H1-learned signatures, never from a
// harness-supplied answer. Status PENDING proves the commitment predates
// execution.
fn learner_commit(L:[]u8,E:[]u8,g:i32,input:i32)void {
  let pred:i32=h1_predict(L,E,g,input);
  ls(L,2,g); ls(L,3,pred); ls(L,4,input); ls(L,5,1);
  return;
}

// ---------- world (environment; fixed law, no per-query targets) ----------
fn world_execute(g:i32,input:i32)i32 {
  let v:i32=comp_run(comp_first(g),input);
  v=comp_run(comp_second(g),v);
  return v;
}
// World law: the downstream machine accepts iff the final output kind
// equals the goal kind. The gate latch is the only consequence signal the
// learner may read. This is the single write site of the gate cell.
fn world_downstream(E:[]u8,v:i32,goal:i32)void {
  let g:i32=0;
  if(probe_kind(E,v)==goal){g=1;set32(E,1*4,get32(E,1*4)+1);}
  else{set32(E,2*4,get32(E,2*4)+1);}
  set32(E,0,g);
  return;
}
fn world_gate(E:[]u8)i32 { return get32(E,0); }

// ---------- confidence update (learner operation) ----------
// Reads ONLY the world gate. Never receives an actual output value.
// Never references a harness answer key. Sole writer of confidence cells.
fn learner_update(L:[]u8,E:[]u8,g:i32)void {
  let gate:i32=world_gate(E);
  let c:i32=lg(L,g);
  if(gate==1){ls(L,g,c+1);}else{ls(L,g,c-1);}
  ls(L,5,2);
  return;
}

// ---------- selection (learner operation) ----------
// Among contract-admissible compositions (input kind fits sig_in(first),
// seam fits, sig_out(second) equals the goal kind), pick argmax
// confidence. Tie -> lowest composition id. Reads the confidence ledger
// and the learned contracts only.
fn learner_select(L:[]u8,E:[]u8,input:i32,goal:i32)i32 {
  let best:i32=-1;
  let bestc:i32=0;
  let have:i32=0;
  let g:i32=0;
  while(g<2){
    let p:i32=h1_predict(L,E,g,input);
    if(p==goal){
      let c:i32=lg(L,g);
      if(have==0){best=g;bestc=c;have=1;}
      else{if(c>bestc){best=g;bestc=c;}}
    }
    g=g+1;
  }
  return best;
}
// vh_main.zag -- verify_h1: driver (harness).
// Phases TEACH, Z1, Z2, Z3, ABL. Transcript emission. main().
// The driver sequences phases and logs white-box instrumentation; it is
// not cognition. Actual output values appear in the log as labeled
// instrumentation and are never passed to any learner function.

fn e1chain(b:[]u8,c:i32,L:[]u8,g:i32)i32 {
  let a:i32=comp_first(g);
  let d:i32=comp_second(g);
  c=e1sig(b,c,h1_sig_in(L,a),h1_sig_out(L,a));
  c=e1str(b,c,";");
  c=e1sig(b,c,h1_sig_in(L,d),h1_sig_out(L,d));
  return c;
}

// TEACH: two frozen probes per component, H1 observe + finalize.
fn phase_teach(b:[]u8,c:i32,L:[]u8,E:[]u8,comp:i32,a1:i32,a2:i32)i32 {
  let o1:i32=comp_run(comp,a1);
  h1_observe(L,E,comp,a1,o1);
  c=e1str(b,c,"OBS "); c=e1cname(b,c,comp);
  c=e1str(b,c," in="); c=e1i64(b,c,a1 as i64);
  c=e1str(b,c," kin="); c=e1kind(b,c,probe_kind(E,a1));
  c=e1str(b,c," out="); c=e1i64(b,c,o1 as i64);
  c=e1str(b,c," kout="); c=e1kind(b,c,probe_kind(E,o1));
  c=e1str(b,c,"\n");
  let o2:i32=comp_run(comp,a2);
  h1_observe(L,E,comp,a2,o2);
  c=e1str(b,c,"OBS "); c=e1cname(b,c,comp);
  c=e1str(b,c," in="); c=e1i64(b,c,a2 as i64);
  c=e1str(b,c," kin="); c=e1kind(b,c,probe_kind(E,a2));
  c=e1str(b,c," out="); c=e1i64(b,c,o2 as i64);
  c=e1str(b,c," kout="); c=e1kind(b,c,probe_kind(E,o2));
  c=e1str(b,c,"\n");
  h1_finalize(L,comp);
  c=e1str(b,c,"TEACH "); c=e1cname(b,c,comp);
  c=e1str(b,c," sig="); c=e1sig(b,c,h1_sig_in(L,comp),h1_sig_out(L,comp));
  c=e1str(b,c,"\n");
  return c;
}

// One commit/execute/consequence/update episode. tag is "Z1" or "Z2".
fn phase_commit(b:[]u8,c:i32,L:[]u8,E:[]u8,g:i32,input:i32,goal:i32,tag:[]u8)i32 {
  let before:i32=lg(L,g);
  learner_commit(L,E,g,input);
  let st:i32=lg(L,5);
  c=e1str(b,c,tag); c=e1str(b,c," COMMIT comp="); c=e1comp(b,c,g);
  c=e1str(b,c," predicted="); c=e1kind(b,c,lg(L,3));
  c=e1str(b,c," input="); c=e1i64(b,c,input as i64);
  c=e1str(b,c," status=");
  if(st==1){c=e1str(b,c,"PENDING");}else{c=e1str(b,c,"OTHER");}
  c=e1str(b,c," contracts="); c=e1chain(b,c,L,g);
  c=e1str(b,c,"\n");
  let actual:i32=world_execute(g,input);
  c=e1str(b,c,tag); c=e1str(b,c," EXEC actual="); c=e1i64(b,c,actual as i64);
  c=e1str(b,c," (instrumentation, not learner input)\n");
  world_downstream(E,actual,goal);
  let gate:i32=world_gate(E);
  c=e1str(b,c,tag); c=e1str(b,c," CONSEQUENCE gate="); c=e1i64(b,c,gate as i64);
  if(gate==1){c=e1str(b,c," downstream=ACCEPT\n");}else{c=e1str(b,c," downstream=REJECT\n");}
  learner_update(L,E,g);
  let after:i32=lg(L,g);
  c=e1str(b,c,tag); c=e1str(b,c," UPDATE comp="); c=e1comp(b,c,g);
  c=e1str(b,c," conf="); c=e1i64(b,c,before as i64);
  c=e1str(b,c,"->"); c=e1i64(b,c,after as i64);
  c=e1str(b,c," (source=gate)\n");
  return c;
}

fn emit_select(b:[]u8,c:i32,L:[]u8,tag:[]u8,ch:i32)i32 {
  let tie:i32=0;
  if(lg(L,0)==lg(L,1)){tie=1;}
  c=e1str(b,c,tag); c=e1str(b,c," SELECT confCC="); c=e1i64(b,c,lg(L,1) as i64);
  c=e1str(b,c," confDD="); c=e1i64(b,c,lg(L,0) as i64);
  c=e1str(b,c," choice="); c=e1comp(b,c,ch);
  if(tie==1){c=e1str(b,c," rule=tie->lowest-id\n");}else{c=e1str(b,c," rule=argmax-conf\n");}
  return c;
}

fn main()i32 {
  let OUT:[]u8=z_alloc(8192);
  let oc:i32=0;
  oc=e1str(OUT,oc,"VH1-INTEGRATION run\nARM MAIN\n");
  let L:[]u8=z_alloc(128);
  let E:[]u8=z_alloc(128);
  world_init(E);
  oc=e1str(OUT,oc,"TEACH rule=kind-probe(NODE iff fact-subject)+record-obs+majority(n>=2)\n");
  oc=e1str(OUT,oc,"TEACH facts subjects=31,32,33 rel=91\n");
  oc=phase_teach(OUT,oc,L,E,0,31,32);
  oc=phase_teach(OUT,oc,L,E,1,31,32);
  // Z1: goal input 31, want NODE. Commit CC.
  oc=e1str(OUT,oc,"Z1 GOAL input=31 want=NODE\n");
  oc=phase_commit(OUT,oc,L,E,1,31,1,"Z1");
  // Z2: goal input 33, want NODE. Commit DD (contracts predict NODE).
  oc=e1str(OUT,oc,"Z2 GOAL input=33 want=NODE\n");
  oc=phase_commit(OUT,oc,L,E,0,33,1,"Z2");
  // Z3: new problem, goal input 31, want NODE. Select by earned confidence.
  oc=e1str(OUT,oc,"Z3 PROBLEM input=31 want=NODE\n");
  let chm:i32=learner_select(L,E,31,1);
  oc=emit_select(OUT,oc,L,"Z3",chm);
  let a3:i32=world_execute(chm,31);
  world_downstream(E,a3,1);
  let g3:i32=world_gate(E);
  oc=e1str(OUT,oc,"Z3 EXEC choice="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," actual="); oc=e1i64(OUT,oc,a3 as i64);
  oc=e1str(OUT,oc," gate="); oc=e1i64(OUT,oc,g3 as i64);
  if(g3==1){oc=e1str(OUT,oc," downstream=ACCEPT\n");}else{oc=e1str(OUT,oc," downstream=REJECT\n");}
  let u0:i32=lg(L,chm);
  learner_update(L,E,chm);
  let u1:i32=lg(L,chm);
  oc=e1str(OUT,oc,"Z3 UPDATE comp="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," conf="); oc=e1i64(OUT,oc,u0 as i64);
  oc=e1str(OUT,oc,"->"); oc=e1i64(OUT,oc,u1 as i64);
  oc=e1str(OUT,oc," (source=gate)\n");
  // ABL arm: fresh learner state, fresh world, IDENTICAL teaching
  // (contracts are required for admissibility); no commits, no
  // consequence history. Only the confidence ledger differs from MAIN.
  oc=e1str(OUT,oc,"ARM ABLATION (teaches, no consequence history)\n");
  let L2:[]u8=z_alloc(128);
  let E2:[]u8=z_alloc(128);
  world_init(E2);
  oc=phase_teach(OUT,oc,L2,E2,0,31,32);
  oc=phase_teach(OUT,oc,L2,E2,1,31,32);
  let cha:i32=learner_select(L2,E2,31,1);
  oc=emit_select(OUT,oc,L2,"ABL",cha);
  oc=e1str(OUT,oc,"ABL NOTE choice differs from MAIN: preference is ledger-driven\n");
  oc=e1str(OUT,oc,"SUMMARY main_choice="); oc=e1comp(OUT,oc,chm);
  oc=e1str(OUT,oc," ablation_choice="); oc=e1comp(OUT,oc,cha);
  oc=e1str(OUT,oc,"\n");
  // Single raw write of exactly the buffered bytes.
  let _wn:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),oc as i64,0,0,0);
  if(_wn<0){oc=0;}
  return 0;
}

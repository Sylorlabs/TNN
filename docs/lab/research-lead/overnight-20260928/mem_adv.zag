// mem_adv.zag - H-MEM adversary attack harness (PREREG_MEM_ADV.md, frozen).
// Mechanism functions copied from mem_learn.zag (committed source); the only
// changes are a parameterized replay window (win) and victim capture for the
// held-out-future attack. Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- store layout: 8 slots x 24 bytes ----
// +0 used, +4 proc_id, +8 use_count, +12 last_q, +16 store_seq
fn NSLOT()i32 { return 8; }
fn SLOT_SZ()i32 { return 24; }
fn slot_off(s:i32)i32 { return s*SLOT_SZ(); }
fn st_used(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)); }
fn st_pid(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+4); }
fn st_uses(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+8); }
fn st_lastq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+12); }
fn st_sseq(W:[]u8, s:i32)i32 { return get32(W, slot_off(s)+16); }
fn st_set(W:[]u8, s:i32, used:i32, pid:i32, uses:i32, lastq:i32, sseq:i32)void {
  set32(W, slot_off(s), used);
  set32(W, slot_off(s)+4, pid);
  set32(W, slot_off(s)+8, uses);
  set32(W, slot_off(s)+12, lastq);
  set32(W, slot_off(s)+16, sseq);
  return;
}
// ST state: +0 nq (trace len), +4 seq (query seq counter), +8 sseq (store seq)
fn st_nq(ST:[]u8)i32 { return get32(ST, 0); }
fn st_seq(ST:[]u8)i32 { return get32(ST, 4); }
fn st_ss(ST:[]u8)i32 { return get32(ST, 8); }
fn st_set_nq(ST:[]u8, v:i32)void { set32(ST, 0, v); return; }
fn st_set_seq(ST:[]u8, v:i32)void { set32(ST, 4, v); return; }
fn st_set_ss(ST:[]u8, v:i32)void { set32(ST, 8, v); return; }

fn st_find(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==1){ if(st_pid(W,s)==pid){ return s; } }
    s=s+1;
  }
  return -1;
}
fn nstored(W:[]u8)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<NSLOT()){ if(st_used(W,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn st_learn(W:[]u8, ST:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<NSLOT()){
    if(st_used(W,s)==0){
      let ss:i32=st_ss(ST);
      st_set(W, s, 1, pid, 0, 0, ss);
      st_set_ss(ST, ss+1);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn st_query(W:[]u8, ST:[]u8, Q:[]u8, pid:i32)void {
  let f:i32=st_find(W, pid);
  if(f>=0){
    let sq:i32=st_seq(ST)+1;
    st_set_seq(ST, sq);
    set32(W, slot_off(f)+8, st_uses(W,f)+1);
    set32(W, slot_off(f)+12, sq);
    let nq:i32=st_nq(ST);
    Q[nq]=pid as u8;
    st_set_nq(ST, nq+1);
  }
  return;
}
fn run_pairs(W:[]u8, ST:[]u8, Q:[]u8, P:[]u8, np:i32)void {
  let i:i32=0;
  while(i<np){
    let pid:i32=P[i*2] as i32;
    let cnt:i32=P[i*2+1] as i32;
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    i=i+1;
  }
  return;
}

// ---- candidate policies: 0=LFU 1=LRU 2=FIFO 3=LIFO 4=RANDOM ----
fn pol_name(p:i32)[]u8 {
  if(p==0){return "LFU";}
  if(p==1){return "LRU";}
  if(p==2){return "FIFO";}
  if(p==3){return "LIFO";}
  return "RANDOM";
}
fn victim(W:[]u8, pol:i32, ev:i32)i32 {
  let best:i32=-1;
  let s:i32=0;
  if(pol==4){
    let ns:i32=nstored(W);
    let k:i32=((ev*7+3)%ns+ns)%ns;
    let c:i32=0;
    s=0;
    while(s<NSLOT()){
      if(st_used(W,s)==1){ if(c==k){return s;} c=c+1; }
      s=s+1;
    }
    return -1;
  }
  while(s<NSLOT()){
    if(st_used(W,s)==1){
      if(best<0){ best=s; }
      else {
        if(pol==0){ if(st_uses(W,s)<st_uses(W,best)){best=s;} }
        if(pol==1){ if(st_lastq(W,s)<st_lastq(W,best)){best=s;} }
        if(pol==2){ if(st_sseq(W,s)<st_sseq(W,best)){best=s;} }
        if(pol==3){ if(st_sseq(W,s)>st_sseq(W,best)){best=s;} }
      }
    }
    s=s+1;
  }
  return best;
}
// replay cost with PARAMETERIZED window (adversary change; builder fixed 20)
fn replay_cost_w(W:[]u8, Q:[]u8, ST:[]u8, v:i32, win:i32)i32 {
  if(v<0){return 999999;}
  let pid:i32=st_pid(W,v);
  let nq:i32=st_nq(ST);
  let lo:i32=nq-win;
  if(lo<0){lo=0;}
  let c:i32=0;
  let i:i32=lo;
  while(i<nq){ if((Q[i] as i32)==pid){c=c+1;} i=i+1; }
  return c;
}
fn select_w(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32)i32 {
  emit("  candidates (win=");
  emit(i32s(win));
  emit("):\n");
  let p:i32=0;
  let bestp:i32=0;
  let bestc:i32=999999;
  while(p<5){
    let v:i32=victim(W,p,ev);
    let c:i32=replay_cost_w(W,Q,ST,v,win);
    emit("    ");
    emit(pol_name(p));
    emit(" victim=slot");
    emit(i32s(v));
    emit("(proc");
    emit(i32s(st_pid(W,v)));
    emit(") cost=");
    emit(i32s(c));
    emit("\n");
    if(c<bestc){bestc=c;bestp=p;}
    p=p+1;
  }
  emit("  selected: ");
  emit(pol_name(bestp));
  emit(" cost=");
  emit(i32s(bestc));
  emit("\n");
  return bestp;
}
fn pressure_w(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, newpid:i32)i32 {
  emit("pressure event ");
  emit(i32s(ev));
  emit(" (learn proc");
  emit(i32s(newpid));
  emit(", store full):\n");
  let sel:i32=select_w(W,Q,ST,ev,win);
  let v:i32=victim(W,sel,ev);
  emit("  evict slot");
  emit(i32s(v));
  emit(" proc");
  emit(i32s(st_pid(W,v)));
  emit(" uses=");
  emit(i32s(st_uses(W,v)));
  emit(" lastq=");
  emit(i32s(st_lastq(W,v)));
  emit("\n");
  st_set(W, v, 0, -1, 0, 0, 0);
  let s2:i32=st_learn(W, ST, newpid);
  emit("  stored proc");
  emit(i32s(newpid));
  emit(" at slot");
  emit(i32s(s2));
  emit("\n");
  return sel;
}
// pressure with per-policy victim-pid capture (for held-out future scoring)
fn pressure_cap(W:[]u8, Q:[]u8, ST:[]u8, ev:i32, win:i32, newpid:i32, VP:[]u8)i32 {
  let p:i32=0;
  while(p<5){
    let v:i32=victim(W,p,ev);
    set32(VP, p*4, st_pid(W,v));
    p=p+1;
  }
  let sel:i32=select_w(W,Q,ST,ev,win);
  let v:i32=victim(W,sel,ev);
  st_set(W, v, 0, -1, 0, 0, 0);
  st_learn(W, ST, newpid);
  return sel;
}
// held-out future: count misses per policy WITHOUT touching store/trace
fn fmiss(VP:[]u8, MISS:[]u8, pid:i32)void {
  let p:i32=0;
  while(p<5){
    if(get32(VP,p*4)==pid){ set32(MISS, p*4, get32(MISS,p*4)+1); }
    p=p+1;
  }
  return;
}
fn run_future(VP:[]u8, MISS:[]u8, pid:i32, n:i32)void {
  let k:i32=0;
  while(k<n){ fmiss(VP,MISS,pid); k=k+1; }
  return;
}
fn print_misses(MISS:[]u8)void {
  let p:i32=0;
  while(p<5){
    emit("    ");
    emit(pol_name(p));
    emit(" future misses=");
    emit(i32s(get32(MISS,p*4)));
    emit("\n");
    p=p+1;
  }
  return;
}
fn store_init(W:[]u8, ST:[]u8)void {
  let s:i32=0;
  while(s<NSLOT()){ st_set(W,s,0,-1,0,0,0); s=s+1; }
  st_set_nq(ST,0); st_set_seq(ST,0); st_set_ss(ST,0);
  return;
}
fn learn_stream(W:[]u8, ST:[]u8, base:i32, n:i32)void {
  let i:i32=0;
  while(i<n){ st_learn(W, ST, base+i); i=i+1; }
  return;
}
// query procs lo..hi (inclusive), cnt times each, in order
fn query_range(W:[]u8, ST:[]u8, Q:[]u8, lo:i32, hi:i32, cnt:i32)void {
  let pid:i32=lo;
  while(pid<=hi){
    let k:i32=0;
    while(k<cnt){ st_query(W, ST, Q, pid); k=k+1; }
    pid=pid+1;
  }
  return;
}
// replicate builder stream A query phase (EA + WA)
fn buildA(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let EA:[]u8=z_alloc(16);
  EA[0]=0;EA[1]=14; EA[2]=1;EA[3]=10; EA[4]=2;EA[5]=7; EA[6]=3;EA[7]=5;
  EA[8]=4;EA[9]=4; EA[10]=5;EA[11]=2; EA[12]=6;EA[13]=4; EA[14]=7;EA[15]=2;
  run_pairs(W, ST, Q, EA, 8);
  let WA:[]u8=z_alloc(16);
  WA[0]=6;WA[1]=5; WA[2]=0;WA[3]=3; WA[4]=1;WA[5]=3; WA[6]=2;WA[7]=2;
  WA[8]=3;WA[9]=2; WA[10]=4;WA[11]=2; WA[12]=5;WA[13]=1; WA[14]=7;WA[15]=2;
  run_pairs(W, ST, Q, WA, 8);
  return;
}
// replicate builder stream B query phase (P1 + P2)
fn buildB(W:[]u8, ST:[]u8, Q:[]u8)void {
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  let P1:[]u8=z_alloc(2);
  P1[0]=3; P1[1]=40;
  run_pairs(W, ST, Q, P1, 1);
  let P2:[]u8=z_alloc(14);
  P2[0]=6;P2[1]=6; P2[2]=2;P2[3]=6; P2[4]=4;P2[5]=6; P2[6]=5;P2[7]=6;
  P2[8]=7;P2[9]=6; P2[10]=1;P2[11]=6; P2[12]=0;P2[13]=10;
  run_pairs(W, ST, Q, P2, 7);
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(NSLOT()*SLOT_SZ());
  let ST:[]u8=z_alloc(12);
  let Q:[]u8=z_alloc(1024);
  emit("=== H-MEM ADVERSARY ATTACKS (PREREG_MEM_ADV.md frozen) ===\n");

  // ============ M-A1: newcomer churn + hot-newcomer probe ============
  emit("--- M-A1: churn and hot-newcomer probe ---\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  query_range(W, ST, Q, 0, 7, 6);
  emit("M-A1 phase 1: 48 queries (p0..p7 x6)\n");
  let sA1a:i32=pressure_w(W,Q,ST,0,20,8);
  emit("M-A1: ev0 selected ");
  emit(pol_name(sA1a));
  emit("\n");
  let HQ:[]u8=z_alloc(2);
  HQ[0]=8; HQ[1]=5;
  run_pairs(W, ST, Q, HQ, 1);
  emit("M-A1 phase 2: proc8 queried x5 (hot newcomer, uses=5 < incumbents 6)\n");
  let sA1b:i32=pressure_w(W,Q,ST,1,20,9);
  emit("M-A1: ev1 selected ");
  emit(pol_name(sA1b));
  emit("; hot newcomer proc8 stored=");
  if(st_find(W,8)>=0){ emit("yes (survived)"); } else { emit("no (EVICTED)"); }
  emit("\n");
  query_range(W, ST, Q, 2, 7, 4);
  emit("M-A1 phase 3: p2..p7 x4 (uses 10); proc9 has 0 uses\n");
  let sA1c:i32=pressure_w(W,Q,ST,2,20,10);
  emit("M-A1: ev2 selected ");
  emit(pol_name(sA1c));
  emit("; unqueried newcomer proc9 stored=");
  if(st_find(W,9)>=0){ emit("yes (survived)"); } else { emit("no (churned)"); }
  emit("\n");

  // ============ M-A2: trace staleness, two regimes ============
  emit("--- M-A2: two-regime staleness ---\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  query_range(W, ST, Q, 0, 7, 100);
  emit("M-A2 ancient regime: 800 queries (p0..p7 x100)\n");
  let AQ:[]u8=z_alloc(2);
  AQ[0]=0; AQ[1]=20;
  run_pairs(W, ST, Q, AQ, 1);
  emit("M-A2 recent regime: proc0 x20 (fills window)\n");
  let sA2a:i32=pressure_w(W,Q,ST,0,20,8);
  emit("M-A2 ancient-history selection: ");
  emit(pol_name(sA2a));
  emit("\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  query_range(W, ST, Q, 0, 7, 1);
  run_pairs(W, ST, Q, AQ, 1);
  emit("M-A2 baseline: 8 ancient queries + proc0 x20\n");
  let sA2b:i32=pressure_w(W,Q,ST,0,20,8);
  emit("M-A2 baseline selection: ");
  emit(pol_name(sA2b));
  emit("\n");
  if(sA2a==sA2b){ emit("M-A2: selection UNCHANGED by 800-query ancient history\n"); }
  else { emit("M-A2: selection FLIPPED by ancient history\n"); }

  // ============ M-A3: degenerate agreement ============
  emit("--- M-A3: degenerate agreement stream ---\n");
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  query_range(W, ST, Q, 1, 7, 5);
  emit("M-A3: p1..p7 x5 (35 queries); proc0 NEVER queried\n");
  let sA3:i32=pressure_w(W,Q,ST,0,20,8);
  emit("M-A3 selection: ");
  emit(pol_name(sA3));
  emit(" (expect 4-way cost tie, 3-policy victim agreement on slot0)\n");

  // ============ M-A6a: window-size sweep ============
  emit("--- M-A6a: window-size sweep, stream B ---\n");
  buildB(W, ST, Q);
  let sB10:i32=select_w(W,Q,ST,0,10);
  emit("M-A6a streamB win=10 selected ");
  emit(pol_name(sB10));
  emit("\n");
  buildB(W, ST, Q);
  let sB20:i32=select_w(W,Q,ST,0,20);
  emit("M-A6a streamB win=20 selected ");
  emit(pol_name(sB20));
  emit("\n");
  buildB(W, ST, Q);
  let sB40:i32=select_w(W,Q,ST,0,40);
  emit("M-A6a streamB win=40 selected ");
  emit(pol_name(sB40));
  emit("\n");
  buildB(W, ST, Q);
  let sB86:i32=select_w(W,Q,ST,0,86);
  emit("M-A6a streamB win=86 selected ");
  emit(pol_name(sB86));
  emit("\n");
  emit("--- M-A6a: window-size sweep, stream A ---\n");
  buildA(W, ST, Q);
  let sA10:i32=select_w(W,Q,ST,0,10);
  emit("M-A6a streamA win=10 selected ");
  emit(pol_name(sA10));
  emit("\n");
  buildA(W, ST, Q);
  let sA20:i32=select_w(W,Q,ST,0,20);
  emit("M-A6a streamA win=20 selected ");
  emit(pol_name(sA20));
  emit("\n");
  buildA(W, ST, Q);
  let sA68:i32=select_w(W,Q,ST,0,68);
  emit("M-A6a streamA win=68 selected ");
  emit(pol_name(sA68));
  emit("\n");

  // ============ M-A6b: held-out future ============
  emit("--- M-A6b: held-out future after stream A pressure ---\n");
  buildA(W, ST, Q);
  let VP:[]u8=z_alloc(20);
  let selH:i32=pressure_cap(W,Q,ST,0,20,8,VP);
  emit("M-A6b: pressure selected ");
  emit(pol_name(selH));
  emit("; victim pids per policy:");
  let p:i32=0;
  while(p<5){
    emit(" ");
    emit(pol_name(p));
    emit("=");
    emit(i32s(get32(VP,p*4)));
    p=p+1;
  }
  emit("\n");
  let MISS:[]u8=z_alloc(20);
  run_future(VP, MISS, 0, 20);
  emit("M-A6b future F1 (trend continuation: proc0 x20) per-policy misses:\n");
  print_misses(MISS);
  let MISS2:[]u8=z_alloc(20);
  run_future(VP, MISS2, 5, 20);
  emit("M-A6b future F2 (regime flip: proc5 x20, the evicted proc) per-policy misses:\n");
  print_misses(MISS2);

  emit("=== ADVERSARY ATTACKS COMPLETE ===\n");
  return 0;
}

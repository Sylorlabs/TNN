// driver_A.zag -- adversary build A driver (ops 1-3, fresh family).
// The driver never names an operator, source pair, binding,
// pattern, or form: queries are (start,terminal,value,cap,
// dom) with one arm-level OP_MASK. Kill bars K1'-K8' per
// PREREG section 6a.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=24; rs[1]=24; fs[0]=7; fs[1]=8;
  m_teach(st,rs,2,fs,2,30,32,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z1 (id 3): 3(1,7,40,47,2,1,0,0,0,0,4,0)
// rels[24,24,21,22,23,22,23] facts[9,10,11,12,13,14,15]
fn d_check_z1(st:[]u8)i32 {
  let o:i32=368+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=40){ok=0;}
  if((st[o+3] as i32)!=47){ok=0;}
  if((st[o+32] as i32)!=2){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=0){ok=0;}
  if((st[o+35] as i32)!=0){ok=0;}
  if((st[o+36] as i32)!=0){ok=0;}
  if((st[o+37] as i32)!=0){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=24; er[1]=24; er[2]=21; er[3]=22; er[4]=23; er[5]=22; er[6]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=9; ef[1]=10; ef[2]=11; ef[3]=12; ef[4]=13; ef[5]=14; ef[6]=15;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z2 (id 4): 4(1,5,50,55,1,1,25,26,27,2,4,0)
// rels[25,26,27,26,27] facts[17,18,19,20,21]
fn d_check_z2(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=5){ok=0;}
  if((st[o+2] as i32)!=50){ok=0;}
  if((st[o+3] as i32)!=55){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=25){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=2){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(6);
  er[0]=25; er[1]=26; er[2]=27; er[3]=26; er[4]=27;
  let ef:[]u8=z_alloc(6);
  ef[0]=17; ef[1]=18; ef[2]=19; ef[3]=20; ef[4]=21;
  let k:i32=0;
  while(k<5){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z3 (id 5): 5(1,3,20,23,1,1,21,22,23,1,4,0)
// rels[21,22,23] facts[1,2,3]
fn d_check_z3(st:[]u8)i32 {
  let o:i32=368+5*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=3){ok=0;}
  if((st[o+2] as i32)!=20){ok=0;}
  if((st[o+3] as i32)!=23){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=21){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=1){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(4);
  er[0]=21; er[1]=22; er[2]=23;
  let ef:[]u8=z_alloc(4);
  ef[0]=1; ef[1]=2; ef[2]=3;
  let k:i32=0;
  while(k<3){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Issue one query; store via,val,op,tries,dec,phit,
// as,ae,entered at rs[ro..ro+32].
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(320);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,30,32,-1,2,2,63,"QB",rF,36);
  d_runq(stF,ob,atp,40,47,53,1,2,63,"Q1",rF,72);
  d_runq(stF,ob,atp,50,55,54,1,1,63,"Q2",rF,108);
  d_runq(stF,ob,atp,20,23,55,1,1,63,"Q3",rF,144);
  d_runq(stF,ob,atp,40,47,53,1,2,63,"Q1-B",rF,180);
  d_runq(stF,ob,atp,50,55,54,1,1,63,"Q2-B",rF,216);
  d_runq(stF,ob,atp,20,23,55,1,1,63,"Q3-B",rF,252);
  let f_qa_via:i32=get32(rF,0);
  let f_qb_via:i32=get32(rF,36);
  let f_q1_via:i32=get32(rF,72);
  let f_q1_val:i32=get32(rF,76);
  let f_q1_op:i32=get32(rF,80);
  let f_q1_tries:i32=get32(rF,84);
  let f_q1_dec:i32=get32(rF,88);
  let f_q1_phit:i32=get32(rF,92);
  let f_q1_as:i32=get32(rF,96);
  let f_q1_ae:i32=get32(rF,100);
  let f_q2_via:i32=get32(rF,108);
  let f_q2_val:i32=get32(rF,112);
  let f_q2_op:i32=get32(rF,116);
  let f_q2_tries:i32=get32(rF,120);
  let f_q2_dec:i32=get32(rF,124);
  let f_q2_phit:i32=get32(rF,128);
  let f_q2_as:i32=get32(rF,132);
  let f_q2_ae:i32=get32(rF,136);
  let f_q3_via:i32=get32(rF,144);
  let f_q3_val:i32=get32(rF,148);
  let f_q3_op:i32=get32(rF,152);
  let f_q3_tries:i32=get32(rF,156);
  let f_q3_dec:i32=get32(rF,160);
  let f_q3_phit:i32=get32(rF,164);
  let f_q3_as:i32=get32(rF,168);
  let f_q3_ae:i32=get32(rF,172);
  let f_b1_via:i32=get32(rF,180);
  let f_b1_val:i32=get32(rF,184);
  let f_b1_en:i32=get32(rF,212);
  let f_b2_via:i32=get32(rF,216);
  let f_b2_val:i32=get32(rF,220);
  let f_b2_en:i32=get32(rF,248);
  let f_b3_via:i32=get32(rF,252);
  let f_b3_val:i32=get32(rF,256);
  let f_b3_en:i32=get32(rF,284);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e41:i32=e_has(stF,3,1,16);
  let e42:i32=e_has(stF,3,2,16);
  let e51:i32=e_has(stF,4,1,16);
  let e61:i32=e_has(stF,5,1,16);
  let e14_4:i32=e_has_to(stF,3,14);
  let e14_5:i32=e_has_to(stF,4,14);
  let e14_6:i32=e_has_to(stF,5,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z1:i32=d_check_z1(stF);
  let z2:i32=d_check_z2(stF);
  let z3:i32=d_check_z3(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_q1_as); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q2_as);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q3_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,f_q1_ae); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q2_ae);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q3_ae);
  ex_p(ob,atp," t16="); ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-COMBINE (mask 62) ----------
  let stC:[]u8=z_alloc(8192);
  d_teach_all(stC);
  ex_p(ob,atp,"ARM ABLATE-COMBINE\n");
  let rC:[]u8=z_alloc(256);
  d_runq(stC,ob,atp,20,25,51,1,1,62,"QA",rC,0);
  d_runq(stC,ob,atp,30,32,-1,2,2,62,"QB",rC,36);
  d_runq(stC,ob,atp,40,47,53,1,2,62,"Q1",rC,72);
  d_runq(stC,ob,atp,50,55,54,1,1,62,"Q2",rC,108);
  d_runq(stC,ob,atp,20,23,55,1,1,62,"Q3",rC,144);
  let c_q1_val:i32=get32(rC,76);
  let c_q2_val:i32=get32(rC,112);
  let c_q3_val:i32=get32(rC,148);
  let c_t16:i32=e_count(stC,16);
  let othC:i32=ex_eoth(stC);
  ex_p(ob,atp,"ARM-ABLATEC-END t16=");
  ex_pi(ob,atp,c_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othC);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-SUBST (mask 61) ----------
  let stS:[]u8=z_alloc(8192);
  d_teach_all(stS);
  ex_p(ob,atp,"ARM ABLATE-SUBST\n");
  let rS:[]u8=z_alloc(256);
  d_runq(stS,ob,atp,20,25,51,1,1,61,"QA",rS,0);
  d_runq(stS,ob,atp,30,32,-1,2,2,61,"QB",rS,36);
  d_runq(stS,ob,atp,40,47,53,1,2,61,"Q1",rS,72);
  d_runq(stS,ob,atp,50,55,54,1,1,61,"Q2",rS,108);
  d_runq(stS,ob,atp,20,23,55,1,1,61,"Q3",rS,144);
  let s_q1_val:i32=get32(rS,76);
  let s_q2_val:i32=get32(rS,112);
  let s_q3_val:i32=get32(rS,148);
  let s_t16:i32=e_count(stS,16);
  let othS:i32=ex_eoth(stS);
  ex_p(ob,atp,"ARM-ABLATES-END t16=");
  ex_pi(ob,atp,s_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othS);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-TRUNC (mask 59) ----------
  let stT:[]u8=z_alloc(8192);
  d_teach_all(stT);
  ex_p(ob,atp,"ARM ABLATE-TRUNC\n");
  let rT:[]u8=z_alloc(256);
  d_runq(stT,ob,atp,20,25,51,1,1,59,"QA",rT,0);
  d_runq(stT,ob,atp,30,32,-1,2,2,59,"QB",rT,36);
  d_runq(stT,ob,atp,40,47,53,1,2,59,"Q1",rT,72);
  d_runq(stT,ob,atp,50,55,54,1,1,59,"Q2",rT,108);
  d_runq(stT,ob,atp,20,23,55,1,1,59,"Q3",rT,144);
  let t_q1_val:i32=get32(rT,76);
  let t_q2_val:i32=get32(rT,112);
  let t_q3_val:i32=get32(rT,148);
  let t_t16:i32=e_count(stT,16);
  let othT:i32=ex_eoth(stT);
  ex_p(ob,atp,"ARM-ABLATET-END t16=");
  ex_pi(ob,atp,t_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othT);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(256);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,30,32,-1,2,2,0,"QB",rN,36);
  d_runq(stN,ob,atp,40,47,53,1,2,0,"Q1",rN,72);
  d_runq(stN,ob,atp,50,55,54,1,1,0,"Q2",rN,108);
  d_runq(stN,ob,atp,20,23,55,1,1,0,"Q3",rN,144);
  let n_q1_val:i32=get32(rN,76);
  let n_q2_val:i32=get32(rN,112);
  let n_q3_val:i32=get32(rN,148);
  let n_t16:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END t16=");
  ex_pi(ob,atp,n_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH (facts only) ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  let rR:[]u8=z_alloc(256);
  d_runq(stR,ob,atp,40,47,53,1,2,63,"Q1",rR,72);
  d_runq(stR,ob,atp,50,55,54,1,1,63,"Q2",rR,108);
  d_runq(stR,ob,atp,20,23,55,1,1,63,"Q3",rR,144);
  let r_q1_val:i32=get32(rR,76);
  let r_q2_val:i32=get32(rR,112);
  let r_q3_val:i32=get32(rR,148);
  let r_t16:i32=e_count(stR,16);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END t16=");
  ex_pi(ob,atp,r_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othR);
  ex_pnl(ob,atp);

  // ---------- kill bars K1'-K5', K8' (flat flag style) ----------
  let k1:i32=0;
  let ok1:i32=1;
  if(f_qa_via!=1){ok1=0;}
  if(f_qb_via!=2){ok1=0;}
  if(ok1==1){k1=1;}
  let k2:i32=0;
  let ok2:i32=1;
  if(f_q1_phit!=0){ok2=0;}
  if(f_q2_phit!=0){ok2=0;}
  if(f_q3_phit!=0){ok2=0;}
  if(n_q1_val!=-2){ok2=0;}
  if(n_q2_val!=-2){ok2=0;}
  if(n_q3_val!=-2){ok2=0;}
  if(n_t16!=0){ok2=0;}
  if(ok2==1){k2=1;}
  let k3:i32=0;
  let ok3:i32=1;
  if(f_q1_op!=1){ok3=0;}
  if(f_q1_tries!=1){ok3=0;}
  if(f_q1_dec!=1){ok3=0;}
  if(f_q2_op!=2){ok3=0;}
  if(f_q2_tries!=2){ok3=0;}
  if(f_q2_dec!=1){ok3=0;}
  if(f_q3_op!=3){ok3=0;}
  if(f_q3_tries!=3){ok3=0;}
  if(f_q3_dec!=1){ok3=0;}
  if(ok3==1){k3=1;}
  let k4:i32=0;
  let ok4:i32=1;
  if(f_q1_via!=3){ok4=0;}
  if(f_q1_val!=53){ok4=0;}
  if(z1!=1){ok4=0;}
  if(f_q2_via!=4){ok4=0;}
  if(f_q2_val!=54){ok4=0;}
  if(z2!=1){ok4=0;}
  if(f_q3_via!=5){ok4=0;}
  if(f_q3_val!=55){ok4=0;}
  if(z3!=1){ok4=0;}
  if(f_b1_via!=3){ok4=0;}
  if(f_b1_val!=53){ok4=0;}
  if(f_b1_en!=0){ok4=0;}
  if(f_b2_via!=4){ok4=0;}
  if(f_b2_val!=54){ok4=0;}
  if(f_b2_en!=0){ok4=0;}
  if(f_b3_via!=5){ok4=0;}
  if(f_b3_val!=55){ok4=0;}
  if(f_b3_en!=0){ok4=0;}
  if(ok4==1){k4=1;}
  let k5:i32=0;
  let ok5:i32=1;
  if(c_q1_val!=-2){ok5=0;}
  if(c_q2_val!=54){ok5=0;}
  if(c_q3_val!=55){ok5=0;}
  if(c_t16!=2){ok5=0;}
  if(s_q1_val!=53){ok5=0;}
  if(s_q2_val!=-2){ok5=0;}
  if(s_q3_val!=55){ok5=0;}
  if(s_t16!=3){ok5=0;}
  if(t_q1_val!=53){ok5=0;}
  if(t_q2_val!=54){ok5=0;}
  if(t_q3_val!=-2){ok5=0;}
  if(t_t16!=3){ok5=0;}
  if(ok5==1){k5=1;}
  let k8:i32=0;
  let ok8:i32=1;
  if(t16F!=4){ok8=0;}
  if(e41!=1){ok8=0;}
  if(e42!=1){ok8=0;}
  if(e51!=1){ok8=0;}
  if(e61!=1){ok8=0;}
  if(e14_4!=1){ok8=0;}
  if(e14_5!=1){ok8=0;}
  if(e14_6!=1){ok8=0;}
  if(mdlive!=1){ok8=0;}
  if(othF!=0){ok8=0;}
  if(ok8==1){k8=1;}

  // ---------- falsifiers ----------
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othC!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEC\n");ff=1;}
  if(othS!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATES\n");ff=1;}
  if(othT!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATET\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW NOREUSE\n");ff=1;}
  if(othR!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(f_q1_via!=3){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q1\n");ff=1;}
  if(f_q2_via!=4){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q2\n");ff=1;}
  if(f_q3_via!=5){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q3\n");ff=1;}
  if(z1!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z1\n");ff=1;}
  if(z2!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z2\n");ff=1;}
  if(z3!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z3\n");ff=1;}
  if(f_q1_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q1\n");ff=1;}
  if(f_q2_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q2\n");ff=1;}
  if(f_q3_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q3\n");ff=1;}
  if(n_q1_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q1\n");ff=1;}
  if(n_q2_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q2\n");ff=1;}
  if(n_q3_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q3\n");ff=1;}
  if(c_q1_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATEC-Q1\n");ff=1;}
  if(c_q2_val!=54){ex_p(ob,atp,"FALSIFIER F-ABLATEC-Q2\n");ff=1;}
  if(c_q3_val!=55){ex_p(ob,atp,"FALSIFIER F-ABLATEC-Q3\n");ff=1;}
  if(c_t16!=2){ex_p(ob,atp,"FALSIFIER F-ABLATEC-T16\n");ff=1;}
  if(s_q2_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATES-Q2\n");ff=1;}
  if(s_q1_val!=53){ex_p(ob,atp,"FALSIFIER F-ABLATES-Q1\n");ff=1;}
  if(s_q3_val!=55){ex_p(ob,atp,"FALSIFIER F-ABLATES-Q3\n");ff=1;}
  if(s_t16!=3){ex_p(ob,atp,"FALSIFIER F-ABLATES-T16\n");ff=1;}
  if(t_q3_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATET-Q3\n");ff=1;}
  if(t_q1_val!=53){ex_p(ob,atp,"FALSIFIER F-ABLATET-Q1\n");ff=1;}
  if(t_q2_val!=54){ex_p(ob,atp,"FALSIFIER F-ABLATET-Q2\n");ff=1;}
  if(t_t16!=3){ex_p(ob,atp,"FALSIFIER F-ABLATET-T16\n");ff=1;}
  if(f_b1_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q1-ENTERED\n");ff=1;}
  if(f_b1_via!=3){ex_p(ob,atp,"FALSIFIER F-RE-Q1-VIA\n");ff=1;}
  if(f_b1_val!=53){ex_p(ob,atp,"FALSIFIER F-RE-Q1-VAL\n");ff=1;}
  if(f_b2_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q2-ENTERED\n");ff=1;}
  if(f_b2_via!=4){ex_p(ob,atp,"FALSIFIER F-RE-Q2-VIA\n");ff=1;}
  if(f_b2_val!=54){ex_p(ob,atp,"FALSIFIER F-RE-Q2-VAL\n");ff=1;}
  if(f_b3_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q3-ENTERED\n");ff=1;}
  if(f_b3_via!=5){ex_p(ob,atp,"FALSIFIER F-RE-Q3-VIA\n");ff=1;}
  if(f_b3_val!=55){ex_p(ob,atp,"FALSIFIER F-RE-Q3-VAL\n");ff=1;}
  if(f_q1_op!=1){ex_p(ob,atp,"FALSIFIER F-OP-Q1\n");ff=1;}
  if(f_q2_op!=2){ex_p(ob,atp,"FALSIFIER F-OP-Q2\n");ff=1;}
  if(f_q3_op!=3){ex_p(ob,atp,"FALSIFIER F-OP-Q3\n");ff=1;}
  if(f_q1_tries!=1){ex_p(ob,atp,"FALSIFIER F-TRIES-Q1\n");ff=1;}
  if(f_q2_tries!=2){ex_p(ob,atp,"FALSIFIER F-TRIES-Q2\n");ff=1;}
  if(f_q3_tries!=3){ex_p(ob,atp,"FALSIFIER F-TRIES-Q3\n");ff=1;}
  if(t16F!=4){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e41!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-31\n");ff=1;}
  if(e42!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-32\n");ff=1;}
  if(e51!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-41\n");ff=1;}
  if(e61!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-51\n");ff=1;}
  if(e14_4!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-3\n");ff=1;}
  if(e14_5!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-4\n");ff=1;}
  if(e14_6!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-5\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  if(r_q1_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q1\n");ff=1;}
  if(r_q2_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q2\n");ff=1;}
  if(r_q3_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q3\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"ADV-A-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

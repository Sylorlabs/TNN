// driver_D.zag -- composition build D driver.
// The driver never names an operator, source pair, binding,
// pattern, or form: queries are (start,terminal,value,cap,
// dom) with one arm-level OP_MASK. Kill bars D-K1..D-K8 per
// PREREG section 6. Masks: FULL=63, NOREUSE=0,
// ABLATE-ABS=47 (ops 1,2,3,4,6), ABLATE-CONC=31 (ops 1-5).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=24; rs[1]=24; fs[0]=7; fs[1]=8;
  m_teach(st,rs,2,fs,2,30,32,2,2);
  rs[0]=0; rs[1]=34; rs[2]=35; rs[3]=34; rs[4]=35; rs[5]=34; rs[6]=35;
  fs[0]=9; fs[1]=10; fs[2]=11; fs[3]=12; fs[4]=13; fs[5]=14; fs[6]=15;
  m_teach(st,rs,7,fs,7,70,77,1,1);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z4 (id 4): 4(1,7,90,98,1,1,29,26,27,3,4,0)
// rels[29,26,27,26,27,26,27] facts[18,19,20,21,22,23,24]
fn d_check_z4(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=98){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=26; er[2]=27; er[3]=26; er[4]=27; er[5]=26; er[6]=27;
  let ef:[]u8=z_alloc(8);
  ef[0]=18; ef[1]=19; ef[2]=20; ef[3]=21; ef[4]=22; ef[5]=23; ef[6]=24;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z5 (id 5): 5(1,7,140,148,1,1,29,22,23,3,4,0)
// rels[29,22,23,22,23,22,23] facts[27,28,29,30,31,32,33]
fn d_check_z5(st:[]u8)i32 {
  let o:i32=368+5*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=140){ok=0;}
  if((st[o+3] as i32)!=148){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=22; er[2]=23; er[3]=22; er[4]=23; er[5]=22; er[6]=23;
  let ef:[]u8=z_alloc(8);
  ef[0]=27; ef[1]=28; ef[2]=29; ef[3]=30; ef[4]=31; ef[5]=32; ef[6]=33;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Issue one query; store via,val,op,tries,dec,phit,
// as,ae,entered at rs[ro..ro+32].
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(288);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,30,32,-1,2,2,63,"QB",rF,36);
  d_runq(stF,ob,atp,90,98,59,1,1,63,"QD1",rF,72);
  d_runq(stF,ob,atp,140,148,63,1,1,63,"QD2",rF,108);
  d_runq(stF,ob,atp,150,157,64,1,1,63,"QD3",rF,144);
  d_runq(stF,ob,atp,90,98,59,1,1,63,"QD1-B",rF,180);
  d_runq(stF,ob,atp,140,148,63,1,1,63,"QD2-B",rF,216);
  let f_qa_via:i32=get32(rF,0);
  let f_qb_via:i32=get32(rF,36);
  let f_d1_via:i32=get32(rF,72);
  let f_d1_val:i32=get32(rF,76);
  let f_d1_op:i32=get32(rF,80);
  let f_d1_tries:i32=get32(rF,84);
  let f_d1_dec:i32=get32(rF,88);
  let f_d1_phit:i32=get32(rF,92);
  let f_d1_as:i32=get32(rF,96);
  let f_d1_ae:i32=get32(rF,100);
  let f_d2_via:i32=get32(rF,108);
  let f_d2_val:i32=get32(rF,112);
  let f_d2_op:i32=get32(rF,116);
  let f_d2_tries:i32=get32(rF,120);
  let f_d2_dec:i32=get32(rF,124);
  let f_d2_phit:i32=get32(rF,128);
  let f_d2_as:i32=get32(rF,132);
  let f_d2_ae:i32=get32(rF,136);
  let f_d3_via:i32=get32(rF,144);
  let f_d3_val:i32=get32(rF,148);
  let f_d3_op:i32=get32(rF,152);
  let f_d3_tries:i32=get32(rF,156);
  let f_d3_dec:i32=get32(rF,160);
  let f_d3_phit:i32=get32(rF,164);
  let f_d3_as:i32=get32(rF,168);
  let f_d3_ae:i32=get32(rF,172);
  let f_b1_via:i32=get32(rF,180);
  let f_b1_val:i32=get32(rF,184);
  let f_b1_en:i32=get32(rF,212);
  let f_b2_via:i32=get32(rF,216);
  let f_b2_val:i32=get32(rF,220);
  let f_b2_en:i32=get32(rF,248);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e4316:i32=e_has(stF,4,3,16);
  let e5416:i32=e_has(stF,5,4,16);
  let e4116:i32=e_has(stF,4,1,16);
  let e5316:i32=e_has(stF,5,3,16);
  let e14_4:i32=e_has_to(stF,4,14);
  let e14_5:i32=e_has_to(stF,5,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z4:i32=d_check_z4(stF);
  let z5:i32=d_check_z5(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_d1_as); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d2_as);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d3_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,f_d1_ae); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d2_ae);
  ex_p(ob,atp,"/"); ex_pi(ob,atp,f_d3_ae);
  ex_pnl(ob,atp);
  d_bar(ob,atp,"K1-qavia",f_qa_via);
  d_bar(ob,atp,"K1-qbvia",f_qb_via);
  d_bar(ob,atp,"K2-d1phit",f_d1_phit);
  d_bar(ob,atp,"K2-d2phit",f_d2_phit);
  d_bar(ob,atp,"K3-d1op",f_d1_op);
  d_bar(ob,atp,"K3-d1tries",f_d1_tries);
  d_bar(ob,atp,"K3-d1dec",f_d1_dec);
  d_bar(ob,atp,"K3-d2op",f_d2_op);
  d_bar(ob,atp,"K3-d2tries",f_d2_tries);
  d_bar(ob,atp,"K3-d2dec",f_d2_dec);
  d_bar(ob,atp,"K3-d3op",f_d3_op);
  d_bar(ob,atp,"K3-d3tries",f_d3_tries);
  d_bar(ob,atp,"K3-d3dec",f_d3_dec);
  d_bar(ob,atp,"K3-d3val",f_d3_val);
  d_bar(ob,atp,"K4-d1via",f_d1_via);
  d_bar(ob,atp,"K4-d1val",f_d1_val);
  d_bar(ob,atp,"K4-z4",z4);
  d_bar(ob,atp,"K4-d2via",f_d2_via);
  d_bar(ob,atp,"K4-d2val",f_d2_val);
  d_bar(ob,atp,"K4-z5",z5);
  d_bar(ob,atp,"K4-b1via",f_b1_via);
  d_bar(ob,atp,"K4-b1val",f_b1_val);
  d_bar(ob,atp,"K4-b1en",f_b1_en);
  d_bar(ob,atp,"K4-b2via",f_b2_via);
  d_bar(ob,atp,"K4-b2val",f_b2_val);
  d_bar(ob,atp,"K4-b2en",f_b2_en);
  d_bar(ob,atp,"K8-t16",t16F);
  d_bar(ob,atp,"K8-e4316",e4316);
  d_bar(ob,atp,"K8-e5416",e5416);
  d_bar(ob,atp,"K8-e4116",e4116);
  d_bar(ob,atp,"K8-e5316",e5316);
  d_bar(ob,atp,"K8-link144",e14_4);
  d_bar(ob,atp,"K8-link145",e14_5);
  d_bar(ob,atp,"K8-mdlive",mdlive);
  d_bar(ob,atp,"K8-oth",othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(216);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,30,32,-1,2,2,0,"QB",rN,36);
  d_runq(stN,ob,atp,90,98,59,1,1,0,"QD1",rN,72);
  d_runq(stN,ob,atp,140,148,63,1,1,0,"QD2",rN,108);
  d_runq(stN,ob,atp,150,157,64,1,1,0,"QD3",rN,144);
  let n_d1_val:i32=get32(rN,76);
  let n_d2_val:i32=get32(rN,112);
  let n_d3_val:i32=get32(rN,148);
  let t16N:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END ");
  d_bar(ob,atp,"K2-nd1val",n_d1_val);
  d_bar(ob,atp,"K2-nd2val",n_d2_val);
  d_bar(ob,atp,"K2-nd3val",n_d3_val);
  d_bar(ob,atp,"K2-nt16",t16N);
  d_bar(ob,atp,"K2-noth",othN);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-ABS (mask 47) ----------
  let stA:[]u8=z_alloc(8192);
  d_teach_all(stA);
  ex_p(ob,atp,"ARM ABLATE-ABS\n");
  let rA:[]u8=z_alloc(216);
  d_runq(stA,ob,atp,20,25,51,1,1,47,"QA",rA,0);
  d_runq(stA,ob,atp,30,32,-1,2,2,47,"QB",rA,36);
  d_runq(stA,ob,atp,90,98,59,1,1,47,"QD1",rA,72);
  d_runq(stA,ob,atp,140,148,63,1,1,47,"QD2",rA,108);
  d_runq(stA,ob,atp,150,157,64,1,1,47,"QD3",rA,144);
  let a_d1_op:i32=get32(rA,80);
  let a_d1_tries:i32=get32(rA,84);
  let a_d1_via:i32=get32(rA,72);
  let a_d1_val:i32=get32(rA,76);
  let a_d2_op:i32=get32(rA,116);
  let a_d2_tries:i32=get32(rA,120);
  let a_d2_via:i32=get32(rA,108);
  let a_d2_val:i32=get32(rA,112);
  let a_d3_val:i32=get32(rA,148);
  let a_d3_tries:i32=get32(rA,156);
  let a_d3_op:i32=get32(rA,152);
  let t16A:i32=e_count(stA,16);
  let othA:i32=ex_eoth(stA);
  let ae4316:i32=e_has(stA,4,3,16);
  let ae5316:i32=e_has(stA,5,3,16);
  let ae5416:i32=e_has(stA,5,4,16);
  let ae4116:i32=e_has(stA,4,1,16);
  ex_p(ob,atp,"ARM-ABLATEABS-END ");
  d_bar(ob,atp,"K5-ad1op",a_d1_op);
  d_bar(ob,atp,"K5-ad1tries",a_d1_tries);
  d_bar(ob,atp,"K5-ad1via",a_d1_via);
  d_bar(ob,atp,"K5-ad1val",a_d1_val);
  d_bar(ob,atp,"K5-ad2op",a_d2_op);
  d_bar(ob,atp,"K5-ad2tries",a_d2_tries);
  d_bar(ob,atp,"K5-ad2via",a_d2_via);
  d_bar(ob,atp,"K5-ad2val",a_d2_val);
  d_bar(ob,atp,"K5-ad3val",a_d3_val);
  d_bar(ob,atp,"K5-ad3tries",a_d3_tries);
  d_bar(ob,atp,"K5-ad3op",a_d3_op);
  d_bar(ob,atp,"K5-at16",t16A);
  d_bar(ob,atp,"K5-ae4316",ae4316);
  d_bar(ob,atp,"K5-ae5316",ae5316);
  d_bar(ob,atp,"K5-ae5416",ae5416);
  d_bar(ob,atp,"K5-ae4116",ae4116);
  d_bar(ob,atp,"K5-aoth",othA);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-CONC (mask 31) ----------
  let stK:[]u8=z_alloc(8192);
  d_teach_all(stK);
  ex_p(ob,atp,"ARM ABLATE-CONC\n");
  let rK:[]u8=z_alloc(216);
  d_runq(stK,ob,atp,20,25,51,1,1,31,"QA",rK,0);
  d_runq(stK,ob,atp,30,32,-1,2,2,31,"QB",rK,36);
  d_runq(stK,ob,atp,90,98,59,1,1,31,"QD1",rK,72);
  d_runq(stK,ob,atp,140,148,63,1,1,31,"QD2",rK,108);
  d_runq(stK,ob,atp,150,157,64,1,1,31,"QD3",rK,144);
  let k_d1_val:i32=get32(rK,76);
  let k_d1_tries:i32=get32(rK,84);
  let k_d2_val:i32=get32(rK,112);
  let k_d2_tries:i32=get32(rK,120);
  let k_d3_val:i32=get32(rK,148);
  let k_d3_tries:i32=get32(rK,156);
  let t16K:i32=e_count(stK,16);
  let othK:i32=ex_eoth(stK);
  ex_p(ob,atp,"ARM-ABLATECONC-END ");
  d_bar(ob,atp,"K5-kd1val",k_d1_val);
  d_bar(ob,atp,"K5-kd1tries",k_d1_tries);
  d_bar(ob,atp,"K5-kd2val",k_d2_val);
  d_bar(ob,atp,"K5-kd2tries",k_d2_tries);
  d_bar(ob,atp,"K5-kd3val",k_d3_val);
  d_bar(ob,atp,"K5-kd3tries",k_d3_tries);
  d_bar(ob,atp,"K5-kt16",t16K);
  d_bar(ob,atp,"K5-koth",othK);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH (facts only, mask 63) ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  let rR:[]u8=z_alloc(144);
  d_runq(stR,ob,atp,90,98,59,1,1,63,"QD1",rR,0);
  d_runq(stR,ob,atp,140,148,63,1,1,63,"QD2",rR,36);
  d_runq(stR,ob,atp,150,157,64,1,1,63,"QD3",rR,72);
  let r_d1_val:i32=get32(rR,4);
  let r_d2_val:i32=get32(rR,40);
  let r_d3_val:i32=get32(rR,76);
  let t16R:i32=e_count(stR,16);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END ");
  d_bar(ob,atp,"K8-rd1val",r_d1_val);
  d_bar(ob,atp,"K8-rd2val",r_d2_val);
  d_bar(ob,atp,"K8-rd3val",r_d3_val);
  d_bar(ob,atp,"K8-rt16",t16R);
  d_bar(ob,atp,"K8-roth",othR);
  ex_pnl(ob,atp);

  // ---------- in-Zag falsifiers (PREREG section 8) ----------
  let ff:i32=0;
  if(f_qa_via!=1){ff=ff+1;}
  if(f_qb_via!=2){ff=ff+1;}
  if(f_d1_phit!=0){ff=ff+1;}
  if(f_d2_phit!=0){ff=ff+1;}
  if(f_d1_via!=4){ff=ff+1;}
  if(f_d1_val!=59){ff=ff+1;}
  if(f_d1_op!=6){ff=ff+1;}
  if(f_d1_tries!=6){ff=ff+1;}
  if(f_d1_dec!=1){ff=ff+1;}
  if(z4!=1){ff=ff+1;}
  if(f_d2_via!=5){ff=ff+1;}
  if(f_d2_val!=63){ff=ff+1;}
  if(f_d2_op!=5){ff=ff+1;}
  if(f_d2_tries!=11){ff=ff+1;}
  if(f_d2_dec!=1){ff=ff+1;}
  if(z5!=1){ff=ff+1;}
  if(f_d3_val!=-2){ff=ff+1;}
  if(f_d3_op!=-1){ff=ff+1;}
  if(f_d3_tries!=18){ff=ff+1;}
  if(f_d3_dec!=0){ff=ff+1;}
  if(f_b1_via!=4){ff=ff+1;}
  if(f_b1_val!=59){ff=ff+1;}
  if(f_b1_en!=0){ff=ff+1;}
  if(f_b2_via!=5){ff=ff+1;}
  if(f_b2_val!=63){ff=ff+1;}
  if(f_b2_en!=0){ff=ff+1;}
  if(t16F!=2){ff=ff+1;}
  if(e4316!=1){ff=ff+1;}
  if(e5416!=1){ff=ff+1;}
  if(e4116!=0){ff=ff+1;}
  if(e5316!=0){ff=ff+1;}
  if(e14_4!=1){ff=ff+1;}
  if(e14_5!=1){ff=ff+1;}
  if(mdlive!=1){ff=ff+1;}
  if(othF!=0){ff=ff+1;}
  if(n_d1_val!=-2){ff=ff+1;}
  if(n_d2_val!=-2){ff=ff+1;}
  if(n_d3_val!=-2){ff=ff+1;}
  if(t16N!=0){ff=ff+1;}
  if(othN!=0){ff=ff+1;}
  if(a_d1_op!=6){ff=ff+1;}
  if(a_d1_tries!=5){ff=ff+1;}
  if(a_d1_via!=4){ff=ff+1;}
  if(a_d1_val!=59){ff=ff+1;}
  if(a_d2_op!=6){ff=ff+1;}
  if(a_d2_tries!=10){ff=ff+1;}
  if(a_d2_via!=5){ff=ff+1;}
  if(a_d2_val!=63){ff=ff+1;}
  if(a_d3_val!=-2){ff=ff+1;}
  if(a_d3_tries!=15){ff=ff+1;}
  if(a_d3_op!=-1){ff=ff+1;}
  if(t16A!=2){ff=ff+1;}
  if(ae4316!=1){ff=ff+1;}
  if(ae5316!=1){ff=ff+1;}
  if(ae5416!=0){ff=ff+1;}
  if(ae4116!=0){ff=ff+1;}
  if(othA!=0){ff=ff+1;}
  if(k_d1_val!=-2){ff=ff+1;}
  if(k_d1_tries!=5){ff=ff+1;}
  if(k_d2_val!=-2){ff=ff+1;}
  if(k_d2_tries!=5){ff=ff+1;}
  if(k_d3_val!=-2){ff=ff+1;}
  if(k_d3_tries!=5){ff=ff+1;}
  if(t16K!=0){ff=ff+1;}
  if(othK!=0){ff=ff+1;}
  if(r_d1_val!=-2){ff=ff+1;}
  if(r_d2_val!=-2){ff=ff+1;}
  if(r_d3_val!=-2){ff=ff+1;}
  if(t16R!=0){ff=ff+1;}
  if(othR!=0){ff=ff+1;}
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"COMP-D-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

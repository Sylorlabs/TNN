// driver_C.zag -- adversary build C driver (ops 5-6 ABSTRACT,
// CONCRETIZE; pattern mP' has nf=3). The driver never names
// an operator, source pair, binding, pattern, or form.
// Kill bars K1'-K5', K8' per PREREG section 6a.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=24; rs[1]=24; fs[0]=7; fs[1]=8;
  m_teach(st,rs,2,fs,2,30,32,2,2);
  rs[0]=0; rs[1]=34; rs[2]=35; rs[3]=34; rs[4]=35; rs[5]=34; rs[6]=35;
  fs[0]=9; fs[1]=10; fs[2]=11; fs[3]=12; fs[4]=13; fs[5]=14; fs[6]=15;
  m_teach(st,rs,7,fs,7,70,77,1,1);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z5 (id 4): 4(1,5,80,86,1,1,21,26,27,2,4,0)
// rels[21,26,27,26,27] facts[18,19,20,21,22]
fn d_check_z5(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=5){ok=0;}
  if((st[o+2] as i32)!=80){ok=0;}
  if((st[o+3] as i32)!=86){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=21){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=2){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(6);
  er[0]=21; er[1]=26; er[2]=27; er[3]=26; er[4]=27;
  let ef:[]u8=z_alloc(6);
  ef[0]=18; ef[1]=19; ef[2]=20; ef[3]=21; ef[4]=22;
  let k:i32=0;
  while(k<5){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z6 (id 5): 5(1,7,90,98,1,1,29,26,27,3,4,0)
// rels[29,26,27,26,27,26,27] facts[25,26,27,28,29,30,31]
fn d_check_z6(st:[]u8)i32 {
  let o:i32=368+5*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=90){ok=0;}
  if((st[o+3] as i32)!=98){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=29){ok=0;}
  if((st[o+35] as i32)!=26){ok=0;}
  if((st[o+36] as i32)!=27){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=29; er[1]=26; er[2]=27; er[3]=26; er[4]=27; er[5]=26; er[6]=27;
  let ef:[]u8=z_alloc(8);
  ef[0]=25; ef[1]=26; ef[2]=27; ef[3]=28; ef[4]=29; ef[5]=30; ef[6]=31;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(256);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,30,32,-1,2,2,63,"QB",rF,36);
  d_runq(stF,ob,atp,80,86,58,1,1,63,"Q5",rF,72);
  d_runq(stF,ob,atp,90,98,59,1,1,63,"Q6",rF,108);
  d_runq(stF,ob,atp,80,86,58,1,1,63,"Q5-B",rF,144);
  d_runq(stF,ob,atp,90,98,59,1,1,63,"Q6-B",rF,180);
  let f_qa_via:i32=get32(rF,0);
  let f_qb_via:i32=get32(rF,36);
  let f_q5_via:i32=get32(rF,72);
  let f_q5_val:i32=get32(rF,76);
  let f_q5_op:i32=get32(rF,80);
  let f_q5_tries:i32=get32(rF,84);
  let f_q5_dec:i32=get32(rF,88);
  let f_q5_phit:i32=get32(rF,92);
  let f_q5_as:i32=get32(rF,96);
  let f_q5_ae:i32=get32(rF,100);
  let f_q6_via:i32=get32(rF,108);
  let f_q6_val:i32=get32(rF,112);
  let f_q6_op:i32=get32(rF,116);
  let f_q6_tries:i32=get32(rF,120);
  let f_q6_dec:i32=get32(rF,124);
  let f_q6_phit:i32=get32(rF,128);
  let f_q6_as:i32=get32(rF,132);
  let f_q6_ae:i32=get32(rF,136);
  let f_b5_via:i32=get32(rF,144);
  let f_b5_val:i32=get32(rF,148);
  let f_b5_en:i32=get32(rF,176);
  let f_b6_via:i32=get32(rF,180);
  let f_b6_val:i32=get32(rF,184);
  let f_b6_en:i32=get32(rF,212);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e41:i32=e_has(stF,4,1,16);
  let e53:i32=e_has(stF,5,3,16);
  let e14_4:i32=e_has_to(stF,4,14);
  let e14_5:i32=e_has_to(stF,5,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z5:i32=d_check_z5(stF);
  let z6:i32=d_check_z6(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_q5_as); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q6_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,f_q5_ae); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q6_ae);
  ex_p(ob,atp," t16="); ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-ABS (mask 47) ----------
  let stB:[]u8=z_alloc(8192);
  d_teach_all(stB);
  ex_p(ob,atp,"ARM ABLATE-ABS\n");
  let rB:[]u8=z_alloc(256);
  d_runq(stB,ob,atp,20,25,51,1,1,47,"QA",rB,0);
  d_runq(stB,ob,atp,30,32,-1,2,2,47,"QB",rB,36);
  d_runq(stB,ob,atp,80,86,58,1,1,47,"Q5",rB,72);
  d_runq(stB,ob,atp,90,98,59,1,1,47,"Q6",rB,108);
  let b_q5_val:i32=get32(rB,76);
  let b_q6_val:i32=get32(rB,112);
  let b_t16:i32=e_count(stB,16);
  let othB:i32=ex_eoth(stB);
  ex_p(ob,atp,"ARM-ABLATEB-END t16=");
  ex_pi(ob,atp,b_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othB);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-CONC (mask 31) ----------
  let stN6:[]u8=z_alloc(8192);
  d_teach_all(stN6);
  ex_p(ob,atp,"ARM ABLATE-CONC\n");
  let rN6:[]u8=z_alloc(256);
  d_runq(stN6,ob,atp,20,25,51,1,1,31,"QA",rN6,0);
  d_runq(stN6,ob,atp,30,32,-1,2,2,31,"QB",rN6,36);
  d_runq(stN6,ob,atp,80,86,58,1,1,31,"Q5",rN6,72);
  d_runq(stN6,ob,atp,90,98,59,1,1,31,"Q6",rN6,108);
  let n6_q5_val:i32=get32(rN6,76);
  let n6_q6_val:i32=get32(rN6,112);
  let n6_t16:i32=e_count(stN6,16);
  let othN6:i32=ex_eoth(stN6);
  ex_p(ob,atp,"ARM-ABLATEN-END t16=");
  ex_pi(ob,atp,n6_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othN6);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(256);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,30,32,-1,2,2,0,"QB",rN,36);
  d_runq(stN,ob,atp,80,86,58,1,1,0,"Q5",rN,72);
  d_runq(stN,ob,atp,90,98,59,1,1,0,"Q6",rN,108);
  let n_q5_val:i32=get32(rN,76);
  let n_q6_val:i32=get32(rN,112);
  let n_t16:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END t16=");
  ex_pi(ob,atp,n_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH (facts only) ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  let rR:[]u8=z_alloc(256);
  d_runq(stR,ob,atp,80,86,58,1,1,63,"Q5",rR,72);
  d_runq(stR,ob,atp,90,98,59,1,1,63,"Q6",rR,108);
  let r_q5_val:i32=get32(rR,76);
  let r_q6_val:i32=get32(rR,112);
  let r_t16:i32=e_count(stR,16);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END t16=");
  ex_pi(ob,atp,r_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othR);
  ex_pnl(ob,atp);

  // ---------- kill bars ----------
  let k1:i32=0;
  let ok1:i32=1;
  if(f_qa_via!=1){ok1=0;}
  if(f_qb_via!=2){ok1=0;}
  if(ok1==1){k1=1;}
  let k2:i32=0;
  let ok2:i32=1;
  if(f_q5_phit!=0){ok2=0;}
  if(f_q6_phit!=0){ok2=0;}
  if(n_q5_val!=-2){ok2=0;}
  if(n_q6_val!=-2){ok2=0;}
  if(n_t16!=0){ok2=0;}
  if(ok2==1){k2=1;}
  let k3:i32=0;
  let ok3:i32=1;
  if(f_q5_op!=5){ok3=0;}
  if(f_q5_tries!=5){ok3=0;}
  if(f_q5_dec!=1){ok3=0;}
  if(f_q6_op!=6){ok3=0;}
  if(f_q6_tries!=6){ok3=0;}
  if(f_q6_dec!=1){ok3=0;}
  if(ok3==1){k3=1;}
  let k4:i32=0;
  let ok4:i32=1;
  if(f_q5_via!=4){ok4=0;}
  if(f_q5_val!=58){ok4=0;}
  if(z5!=1){ok4=0;}
  if(f_q6_via!=5){ok4=0;}
  if(f_q6_val!=59){ok4=0;}
  if(z6!=1){ok4=0;}
  if(f_b5_via!=4){ok4=0;}
  if(f_b5_val!=58){ok4=0;}
  if(f_b5_en!=0){ok4=0;}
  if(f_b6_via!=5){ok4=0;}
  if(f_b6_val!=59){ok4=0;}
  if(f_b6_en!=0){ok4=0;}
  if(ok4==1){k4=1;}
  let k5:i32=0;
  let ok5:i32=1;
  if(b_q5_val!=-2){ok5=0;}
  if(b_q6_val!=59){ok5=0;}
  if(b_t16!=1){ok5=0;}
  if(n6_q5_val!=58){ok5=0;}
  if(n6_q6_val!=-2){ok5=0;}
  if(n6_t16!=1){ok5=0;}
  if(ok5==1){k5=1;}
  let k8:i32=0;
  let ok8:i32=1;
  if(t16F!=2){ok8=0;}
  if(e41!=1){ok8=0;}
  if(e53!=1){ok8=0;}
  if(e14_4!=1){ok8=0;}
  if(e14_5!=1){ok8=0;}
  if(mdlive!=1){ok8=0;}
  if(othF!=0){ok8=0;}
  if(ok8==1){k8=1;}

  // ---------- falsifiers ----------
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othB!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEB\n");ff=1;}
  if(othN6!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEN\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW NOREUSE\n");ff=1;}
  if(othR!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(f_q5_via!=4){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q5\n");ff=1;}
  if(f_q6_via!=5){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q6\n");ff=1;}
  if(z5!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z5\n");ff=1;}
  if(z6!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z6\n");ff=1;}
  if(f_q5_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q5\n");ff=1;}
  if(f_q6_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q6\n");ff=1;}
  if(n_q5_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q5\n");ff=1;}
  if(n_q6_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q6\n");ff=1;}
  if(b_q5_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATEB-Q5\n");ff=1;}
  if(b_q6_val!=59){ex_p(ob,atp,"FALSIFIER F-ABLATEB-Q6\n");ff=1;}
  if(b_t16!=1){ex_p(ob,atp,"FALSIFIER F-ABLATEB-T16\n");ff=1;}
  if(n6_q5_val!=58){ex_p(ob,atp,"FALSIFIER F-ABLATEN-Q5\n");ff=1;}
  if(n6_q6_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATEN-Q6\n");ff=1;}
  if(n6_t16!=1){ex_p(ob,atp,"FALSIFIER F-ABLATEN-T16\n");ff=1;}
  if(f_b5_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q5-ENTERED\n");ff=1;}
  if(f_b5_via!=4){ex_p(ob,atp,"FALSIFIER F-RE-Q5-VIA\n");ff=1;}
  if(f_b5_val!=58){ex_p(ob,atp,"FALSIFIER F-RE-Q5-VAL\n");ff=1;}
  if(f_b6_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q6-ENTERED\n");ff=1;}
  if(f_b6_via!=5){ex_p(ob,atp,"FALSIFIER F-RE-Q6-VIA\n");ff=1;}
  if(f_b6_val!=59){ex_p(ob,atp,"FALSIFIER F-RE-Q6-VAL\n");ff=1;}
  if(f_q5_op!=5){ex_p(ob,atp,"FALSIFIER F-OP-Q5\n");ff=1;}
  if(f_q6_op!=6){ex_p(ob,atp,"FALSIFIER F-OP-Q6\n");ff=1;}
  if(f_q5_tries!=5){ex_p(ob,atp,"FALSIFIER F-TRIES-Q5\n");ff=1;}
  if(f_q6_tries!=6){ex_p(ob,atp,"FALSIFIER F-TRIES-Q6\n");ff=1;}
  if(t16F!=2){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e41!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-41\n");ff=1;}
  if(e53!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-53\n");ff=1;}
  if(e14_4!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-4\n");ff=1;}
  if(e14_5!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-5\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  if(r_q5_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q5\n");ff=1;}
  if(r_q6_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q6\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"ADV-C-END\n");

  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// p1proto.zag -- Prototype: behavioral beam search for P1.
//
// Replaces score-ordered beam selection with state-space search.
// A program's identity is its full stack signature across episodes.
// Dedup by signature; BFS by length; scores used only for cap eviction.
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn e64i(v:i64)void { emit(i64s(v)); return; }

// ============ program representation ============
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_set_len(p:[]u8, l:i32)void { set32(p, 0, l); return; }
fn prog_op(p:[]u8, i:i32)i32 { return get32(p, 4+i*8); }
fn prog_arg(p:[]u8, i:i32)i32 { return get32(p, 4+i*8+4); }
fn prog_set(p:[]u8, i:i32, op:i32, arg:i32)void {
  set32(p, 4+i*8, op); set32(p, 4+i*8+4, arg); return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}
fn prog_copy(dst:[]u8, src:[]u8)void {
  let l:i32=prog_len(src);
  prog_set_len(dst, l);
  let i:i32=0;
  while(i<l){ prog_set(dst, i, prog_op(src,i), prog_arg(src,i)); i=i+1; }
  return;
}
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=prog_len(p);
  prog_set(p, l, op, arg);
  prog_set_len(p, l+1);
  return;
}

// ============ VM (P1 ops only, exposes full stack) ============
fn mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a - (a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}
// Run program p (len pl). stack_out must hold 256*4 bytes.
// Returns stack depth; stack_out[0..depth) holds the final stack (i32s).
fn vm_stack(p:[]u8, pl:i32, in0:i32, in1:i32, stack_out:[]u8)i32 {
  let sp:i32=0;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    if(pc<0 || pc>=pl){ break; }
    let op:i32=prog_op(p, pc); let arg:i32=prog_arg(p, pc);
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack_out, sp*4, arg); sp=sp+1; }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack_out, sp*4, in0); sp=sp+1; }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack_out, sp*4, in1); sp=sp+1; }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); sp=sp-2; set32(stack_out,sp*4,a+b); sp=sp+1; }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); sp=sp-2; set32(stack_out,sp*4,a-b); sp=sp+1; }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); sp=sp-2; set32(stack_out,sp*4,a*b); sp=sp+1; }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack_out,sp*4,r); sp=sp+1; }
    } else if(op==7){ // MOD
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack_out,sp*4,r); sp=sp+1; }
    } else if(op==8){ // NEG
      if(sp>=1){ let a:i32=get32(stack_out,(sp-1)*4); set32(stack_out,(sp-1)*4,-a); }
    } else if(op==9){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack_out,(sp-1)*4); set32(stack_out,sp*4,a); sp=sp+1; }
    } else if(op==10){ // DROP
      if(sp>=1){ sp=sp-1; }
    } else if(op==11){ // SWAP
      if(sp>=2){ let b:i32=get32(stack_out,(sp-1)*4); let a:i32=get32(stack_out,(sp-2)*4); set32(stack_out,(sp-2)*4,b); set32(stack_out,(sp-1)*4,a); }
    } else if(op==12){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack_out,(sp-2)*4); set32(stack_out,sp*4,a); sp=sp+1; }
    }
  }
  return sp;
}

// ============ evaluation ============
// Combined: compute stack signature AND exact count AND mae in one pass.
// sig_buf: output signature. scratch: reusable 256*4 stack buffer.
// out_stats[0]=exact count, out_stats[1]=mae_lo, out_stats[2]=mae_hi.
// Returns signature length in bytes.
fn prog_sig_eval(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
                 sig_buf:[]u8, scratch:[]u8, out_stats:[]u8)i32 {
  let pos:i32=0;
  let exact:i32=0;
  let mae:i64=0;
  let i:i32=0;
  while(i<n){
    let d:i32=vm_stack(p, prog_len(p), get32(ein0,i*4), get32(ein1,i*4), scratch);
    set32(sig_buf, pos, d); pos=pos+4;
    let j:i32=0;
    while(j<d){
      set32(sig_buf, pos, get32(scratch, j*4)); pos=pos+4;
      j=j+1;
    }
    let o:i32=0;
    if(d>0){ o=get32(scratch, (d-1)*4); }
    if(o==get32(etgt,i*4)){ exact=exact+1; }
    let dd:i64=(o as i64)-(get32(etgt,i*4) as i64);
    if(dd<0){ dd=-dd; }
    mae=mae+dd;
    i=i+1;
  }
  set32(out_stats, 0, exact);
  set32(out_stats, 4, (mae as i32));
  set32(out_stats, 8, ((mae>>32) as i32));
  return pos;
}

// ============ stack signature + FNV-1a 64-bit hash ============
// (Signature is computed by prog_sig_eval above, which also returns
// exact/mae. The old standalone prog_sig is removed to avoid 3x work.)
// FNV-1a 64-bit. Returns (hi, lo) via out[0], out[1].
fn fnv1a64(buf:[]u8, len:i32, out:[]u8)void {
  // offset basis: 14695981039346656037 = 0xCBF29CE484222325
  // Use two u32 halves. basis hi=0xCBF29CE4, lo=0x84222325.
  // prime: 1099511628211 = 0x100000001B3. hi=0x100, lo=0x1B3.
  // We do 64-bit multiply via 32-bit parts. Simpler: use i64 arithmetic.
  // Zag i64 is signed; FNV uses unsigned, but for hashing purposes
  // signed overflow wrap is fine as long as it is deterministic.
  let h:i64=0xCBF29CE484222325 as i64;
  // Note: the literal may not fit; construct from halves.
  // Actually, let me construct: 0xCBF29CE4 * 2^32 + 0x84222325.
  // In Zag, I can write large i64 literals? Safer to build it.
  let hi:i64=0xCBF29CE4 as i64;
  let lo:i64=0x84222325 as i64;
  h=(hi<<32)|lo;
  let prime:i64=1099511628211 as i64;
  let i:i32=0;
  while(i<len){
    let b:i64=(buf[i] as i64)&0xFF;
    h=h^b;
    h=h*prime;
    i=i+1;
  }
  set32(out, 0, (h as i32));
  set32(out, 4, ((h>>32) as i32));
  return;
}

// ============ op universe (P1) ============
// Returns op and arg for index oi in [0, 31).
// PUSH k (k -9..9): oi 0..18 -> op 0, arg k-9.
// IN0: 19 -> op 1. IN1: 20 -> op 2.
// ADD..NEG (3..8): 21..26. DUP..OVER (9..12): 27..30.
fn op_at(oi:i32, out:[]u8)void {
  if(oi<19){
    set32(out, 0, 0); set32(out, 4, oi-9);
  } else if(oi==19){
    set32(out, 0, 1); set32(out, 4, 0);
  } else if(oi==20){
    set32(out, 0, 2); set32(out, 4, 0);
  } else if(oi<27){
    set32(out, 0, oi-18); set32(out, 4, 0);
  } else {
    set32(out, 0, oi-18); set32(out, 4, 0);
  }
  return;
}
fn op_name(op:i32)[]u8 {
  if(op==0){return "PUSH";}
  if(op==1){return "IN0";}
  if(op==2){return "IN1";}
  if(op==3){return "ADD";}
  if(op==4){return "SUB";}
  if(op==5){return "MUL";}
  if(op==6){return "DIV";}
  if(op==7){return "MOD";}
  if(op==8){return "NEG";}
  if(op==9){return "DUP";}
  if(op==10){return "DROP";}
  if(op==11){return "SWAP";}
  return "OVER";
}
fn print_prog(p:[]u8)void {
  let l:i32=prog_len(p);
  emit("[");
  let i:i32=0;
  while(i<l){
    if(i>0){emit(" ");}
    emit(op_name(prog_op(p,i)));
    let op:i32=prog_op(p,i);
    if(op==0){
      emit(":"); e64(prog_arg(p,i));
    }
    i=i+1;
  }
  emit("]");
  return;
}

// ============ task episodes (from frozen GENEXEC2) ============
fn build_task(t:i32, ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  if(t==0){
    let x:i32=0;
    while(x<=8){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,2*x+1);
      n=n+1; x=x+1;
    }
  } else if(t==2){
    let x:i32=0;
    while(x<=16){
      set32(ein0,n*4,x); set32(ein1,n*4,0); set32(etgt,n*4,mod_nonneg(x,3));
      n=n+1; x=x+1;
    }
  } else if(t==3){
    let a:i32=0;
    while(a<=4){
      let b:i32=0;
      while(b<=4){
        let y:i32=0; if(mod_nonneg(a+b,2)==0){y=1;}
        set32(ein0,n*4,a); set32(ein1,n*4,b); set32(etgt,n*4,y);
        n=n+1; b=b+1;
      }
      a=a+1;
    }
  }
  return n;
}

// ============ behavioral beam search ============
// Returns exact count of best program found (n if solved).
// solution_out receives the best program (or the solution).
// stats_out[0]=layers explored, [1]=max retained, [2]=total generated.
fn behavioral_search(ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32,
                     max_len:i32, cap:i32,
                     solution_out:[]u8, stats_out:[]u8)i32 {
  let psize:i32=4+max_len*8;
  // retained programs for current layer and next layer
  let cur:[]u8=z_alloc(cap*psize);
  let nxt:[]u8=z_alloc(cap*psize);
  // per-program scores for eviction: exact (i32), mae_lo (i32), mae_hi (i32)
  let nxt_exact:[]u8=z_alloc(cap*4);
  let nxt_mae:[]u8=z_alloc(cap*8);
  let cur_n:i32=1;
  set32(cur, 0, 0); // empty program
  // seen hash set: open addressing, 1048576 slots, 8 bytes each (0 = empty).
  let HSIZE:i32=1048576;
  let htable:[]u8=z_alloc(HSIZE*8);
  // Reused buffers (allocated once, not per expansion).
  let sig_buf:[]u8=z_alloc(30*(4+256*4));
  let scratch:[]u8=z_alloc(256*4);
  let eval_stats:[]u8=z_alloc(12*4);
  let hout:[]u8=z_alloc(8);
  // insert empty program's hash
  let sl:i32=prog_sig_eval(cur, ein0, ein1, etgt, n, sig_buf, scratch, eval_stats);
  let best_exact:i32=get32(eval_stats, 0);
  let bmal:i32=get32(eval_stats, 4); let bmah:i32=get32(eval_stats, 8);
  let best_mae:i64=((bmah as i64)<<32)|(bmal as i64 & 0xFFFFFFFF);
  fnv1a64(sig_buf, sl, hout);
  let hh0:i32=get32(hout,0)^1; let hh1:i32=get32(hout,4)^1;
  let hidx:i32=(hh0&0xFFFFF);
  set32(htable, hidx*8, hh0); set32(htable, hidx*8+4, hh1);
  prog_copy(solution_out, cur);
  let total_gen:i64=0;
  let max_retained:i32=1;
  let opbuf:[]u8=z_alloc(8);
  let newp:[]u8=prog_new(max_len);
  let layers:i32=0;
  let depth:i32=0;
  // For efficient top-CAP selection, we maintain nxt sorted by
  // (exact desc, mae asc). Insertion is O(CAP).
  while(depth<max_len){
    let nxt_n:i32=0;
    let ci:i32=0;
    while(ci<cur_n){
      let base:[]u8=cur[ci*psize..ci*psize+psize];
      let oi:i32=0;
      while(oi<31){
        op_at(oi, opbuf);
        prog_copy(newp, base);
        prog_append(newp, get32(opbuf,0), get32(opbuf,4));
        total_gen=total_gen+1;
        // signature + exact + mae in ONE pass
        let sl2:i32=prog_sig_eval(newp, ein0, ein1, etgt, n, sig_buf, scratch, eval_stats);
        let ex:i32=get32(eval_stats, 0);
        let mal:i32=get32(eval_stats, 4); let mah:i32=get32(eval_stats, 8);
        let ma:i64=((mah as i64)<<32)|(mal as i64 & 0xFFFFFFFF);
        fnv1a64(sig_buf, sl2, hout);
        let g0:i32=get32(hout,0)^1; let g1:i32=get32(hout,4)^1;
        // lookup in htable
        let gi:i32=(g0&0xFFFFF);
        let found:i32=0;
        let probe:i32=0;
        while(probe<HSIZE){
          let e0:i32=get32(htable, gi*8);
          if(e0==0){ break; }
          if(e0==g0 && get32(htable, gi*8+4)==g1){ found=1; break; }
          gi=gi+1; if(gi>=HSIZE){gi=0;}
          probe=probe+1;
        }
        if(found==0){
          // insert into htable
          let ii:i32=(g0&0xFFFFF);
          let pr2:i32=0;
          while(pr2<HSIZE){
            if(get32(htable, ii*8)==0){
              set32(htable, ii*8, g0); set32(htable, ii*8+4, g1);
              break;
            }
            ii=ii+1; if(ii>=HSIZE){ii=0;}
            pr2=pr2+1;
          }
          // solution check: BFS finds shortest first
          if(ex==n){
            prog_copy(solution_out, newp);
            set32(stats_out, 0, depth+1);
            set32(stats_out, 4, max_retained);
            set32(stats_out, 8, (total_gen as i32));
            return n;
          }
          // track global best
          let better:i32=0;
          if(ex>best_exact){ better=1; }
          else if(ex==best_exact && ma<best_mae){ better=1; }
          if(better==1){
            best_exact=ex; best_mae=ma;
            prog_copy(solution_out, newp);
          }
          // Insert into nxt sorted by (exact desc, mae asc).
          // Fast path: if nxt is full and candidate is not better than
          // the worst (last element), skip the O(cap) scan.
          let skip:i32=0;
          if(nxt_n==cap){
            let we:i32=get32(nxt_exact, (cap-1)*4);
            let wml:i32=get32(nxt_mae, (cap-1)*8); let wmh:i32=get32(nxt_mae, (cap-1)*8+4);
            let better_than_worst:i32=0;
            if(ex>we){ better_than_worst=1; }
            else if(ex==we){
              if(mah<wmh){ better_than_worst=1; }
              else if(mah==wmh && mal<wml){ better_than_worst=1; }
            }
            if(better_than_worst==0){ skip=1; }
          }
          if(skip==0){
            // Find position.
            let pos:i32=0;
            while(pos<nxt_n){
              let pe:i32=get32(nxt_exact, pos*4);
              let pml:i32=get32(nxt_mae, pos*8); let pmh:i32=get32(nxt_mae, pos*8+4);
              let before:i32=0;
              if(ex>pe){ before=1; }
              else if(ex==pe){
                if(mah<pmh){ before=1; }
                else if(mah==pmh && mal<pml){ before=1; }
              }
              if(before==1){ break; }
              pos=pos+1;
            }
            if(pos<cap){
              // Shift right to make room.
              let sh:i32=nxt_n;
              if(sh>cap-1){ sh=cap-1; }
              while(sh>pos){
                let ssrc:[]u8=nxt[(sh-1)*psize..(sh-1)*psize+psize];
                let sdst:[]u8=nxt[sh*psize..sh*psize+psize];
                prog_copy(sdst, ssrc);
                set32(nxt_exact, sh*4, get32(nxt_exact, (sh-1)*4));
                set32(nxt_mae, sh*8, get32(nxt_mae, (sh-1)*8));
                set32(nxt_mae, sh*8+4, get32(nxt_mae, (sh-1)*8+4));
                sh=sh-1;
              }
              let dst:[]u8=nxt[pos*psize..pos*psize+psize];
              prog_copy(dst, newp);
              set32(nxt_exact, pos*4, ex);
              set32(nxt_mae, pos*8, mal);
              set32(nxt_mae, pos*8+4, mah);
              if(nxt_n<cap){ nxt_n=nxt_n+1; }
            }
          }
        }
        oi=oi+1;
      }
      ci=ci+1;
    }
    if(nxt_n>max_retained){ max_retained=nxt_n; }
    // progress
    emit("  layer "); e64(depth+1);
    emit(" cur="); e64(cur_n);
    emit(" nxt="); e64(nxt_n);
    emit(" gen="); e64i(total_gen);
    emit("\n");
    // swap cur and nxt
    let tmp:[]u8=cur; cur=nxt; nxt=tmp;
    cur_n=nxt_n;
    layers=layers+1;
    if(cur_n==0){ break; }
    depth=depth+1;
  }
  set32(stats_out, 0, layers);
  set32(stats_out, 4, max_retained);
  set32(stats_out, 8, (total_gen as i32));
  return best_exact;
}

// ============ main ============
fn main()void {
  emit("P1PROTO behavioral beam search\n");
  let tasks:[]u8=z_alloc(3*4);
  set32(tasks, 0, 0); set32(tasks, 4, 2); set32(tasks, 8, 3);
  // Prototype: test T0 only, with max_len 8 (solution is len 5).
  // Full 12 and T2/T3 after T0 validates.
  let t:i32=0;
  let ein0:[]u8=z_alloc(30*4); let ein1:[]u8=z_alloc(30*4); let etgt:[]u8=z_alloc(30*4);
  let n:i32=build_task(t, ein0, ein1, etgt);
  let sol:[]u8=prog_new(12);
  let stats:[]u8=z_alloc(12*4);
  let ex:i32=behavioral_search(ein0, ein1, etgt, n, 8, 500, sol, stats);
  emit("TASK "); e64(t);
  emit(" exact="); e64(ex); emit("/"); e64(n);
  emit(" len="); e64(prog_len(sol));
  emit(" prog="); print_prog(sol);
  emit("\n");
  emit("  layers="); e64(get32(stats,0));
  emit(" maxret="); e64(get32(stats,4));
  emit(" gen="); e64(get32(stats,8));
  emit("\n");
  emit("DONE\n");
  return;
}

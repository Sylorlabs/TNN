// adv_idx_corrupt.zag -- ADVERSARIAL: index robustness to corrupt bucket entries.
//
// Target: scaling index (2bea4c73f).
// Attack: Manually corrupt the plen-5 bucket with bad entries, then query.
// This simulates what eviction+slot-reuse would do to the bucket list,
// without requiring 400+ slow interference teaches.
//
// Corruption cases:
//   C1: Bucket head points to a valid node id that is NOT a MAP (tag != 20).
//   C2: Bucket list contains a cycle (next pointer points back).
//   C3: Bucket entry's next pointer is out of bounds (>= 1024).
//
// Questions:
//   1. Does rebind_try_idx crash on bad bucket entries?
//   2. Does it skip them gracefully?
//   3. Are correct answers still returned?

fn adv_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

fn corrupt_case(W:[]u8,case_id:i32)void {
  let ix:i32=hg(W,52);
  if(ix<0){ emit("no index\n"); return; }
  // plen-5 bucket is field 32.
  let head:i32=ng(W,ix,32);
  if(case_id==1){
    // C1: Prepend a FACT node (tag 1, not MAP tag 20) to the bucket.
    // Find a live FACT node.
    let f:i32=2;
    while(f<1024){
      if(ng(W,f,36)==1 && ng(W,f,0)==1){ break; }
      f=f+1;
    }
    if(f<1024){
      ns(W,f,12,head);  // FACT's field 12 -> old head.
      ns(W,ix,32,f);    // Bucket head -> FACT.
      emit("C1: prepended FACT "); e64(f); emit(" to bucket5\n");
    }
  } else { if(case_id==2){
    // C2: Create a cycle. Point head's next to itself.
    if(head>=0){
      ns(W,head,12,head);
      emit("C2: cycle at "); e64(head); emit("\n");
    }
  } else { if(case_id==3){
    // C3: Point head's next out of bounds.
    if(head>=0){
      ns(W,head,12,9999);
      emit("C3: head next -> 9999\n");
    }
  }}}
  return;
}

fn test_corrupt(case_id:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  idx_mode_set(W,1);
  // Build 3 plen-5 MAPs.
  let i:i32=0;
  while(i<3){
    adv_mkchain(W,5000+i*10,5,51,5004+i*10);
    i=i+1;
  }
  emit(tag); emit(" built3\n");
  // Teach query facts.
  let q:i32=6101;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  // Corrupt the bucket.
  corrupt_case(W,case_id);
  // Query. This should not crash.
  hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit(tag); emit(" ans="); e64(b);
  emit(" ok="); e64(b==q+104);
  emit(" scan="); e64(hg(W,56)); emit("\n");
  emit(tag); emit("-END\n");
  return;
}

fn main()i32 {
  emit("ADV-IDX-CORRUPT-START\n");
  test_corrupt(1,"C1-NONMAP");
  test_corrupt(2,"C2-CYCLE");
  test_corrupt(3,"C3-OOB");
  emit("ADV-IDX-CORRUPT-END\n");
  return 0;
}

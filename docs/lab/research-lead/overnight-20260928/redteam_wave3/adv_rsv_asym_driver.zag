// adv_rsv_asym.zag -- ADVERSARIAL: integration RSV with ASYMMETRIC reliability.
//
// Target: integration RSV claim (3/3 synergy, b755e33ff).
// The claim: "Integrated avoids P's false trust AND S's false trust."
// Attack: Make reliability ASYMMETRIC.
//   Predictor X: 90% reliable (9 correct, 1 wrong).
//   Source for X: 10% reliable (1 correct, 9 wrong) -- ADVERSARIAL source.
// P-only arm (config 63): rsv_pred_rel passes (9/10), trusts. 90% correct.
// Integrated arm (config 127): rsv_pred_rel passes, but rsv_src_rel FAILS
//   (1/10 < 50%). Returns -3 (withhold). 0% accuracy.
//
// Questions:
//   1. Does integrated underperform P-only when source is adversarial?
//   2. Is the AND-gate too conservative?
//   3. Does the 3/3 synergy hold only when both reliabilities are informative?
//
// This does not "break" the integration; it exposes the tradeoff:
// the AND-gate optimizes for "never trust wrong" at the cost of
// "sometimes withhold when trust would be correct."

fn adv_setup_asym(W:[]u8)void {
  // Phase S: source reliability. Source 8 is ADVERSARIAL (mostly wrong).
  // Teach (1,50)=42 from source 7 (good), source 8 claims 99 (wrong).
  let i:i32=0;
  while(i<10){
    ev_teach_src(W,1,50,42,7);
    ev_teach_src(W,1,50,99,8);
    ev_observe_src_sub(W,1,50,42);
    i=i+1;
  }
  // Source 8 gets 1 correct (to avoid zero-division edge).
  ev_teach_src(W,1,50,42,7);
  ev_teach_src(W,1,50,42,8);
  ev_observe_src_sub(W,1,50,42);
  emit("ASYM src setup: A should be ~11/11, B ~1/11\n");
  return;
}

fn adv_setup_pred(W:[]u8)void {
  // Predictor for (10,50): 100% reliable (10/10).
  // Teach (10,50)=100 from source 8 (adversarial source, but predictor
  // itself is good).
  ev_teach_src(W,10,50,100,8);
  let i:i32=0;
  while(i<10){
    let px:i32=ev_predict(W,10,50);
    ev_observe_rsv(W,10,50,100);
    i=i+1;
  }
  emit("ASYM pred setup: predictor 10/10\n");
  return;
}

fn main()i32 {
  emit("ADV-RSV-ASYM-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  se_cfg_set(W,31);

  adv_setup_asym(W);
  adv_setup_pred(W);

  // Print substrate reliability records.
  emit("substrate: ");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==3){
      e64(ng(W,n,8)); emit(" ");
      e64(ng(W,n,12)); emit(" ");
      e64(ng(W,n,24)); emit("/");
      e64(ng(W,n,20)); emit("; ");
    }
    n=n+1;
  }
  emit("\n");

  // P-only arm (config 63): prediction reliability only.
  se_cfg_set(W,63);
  let p_x:i32=rsv_trust(W,10,50);
  emit("P-only trust(10,50)="); e64(p_x); emit(" (predicts 100, true 100)\n");

  // S-only arm (config 95): source reliability only.
  se_cfg_set(W,95);
  let s_x:i32=rsv_trust(W,10,50);
  emit("S-only trust(10,50)="); e64(s_x); emit("\n");

  // Integrated arm (config 127): both.
  se_cfg_set(W,127);
  let i_x:i32=rsv_trust(W,10,50);
  emit("Integrated trust(10,50)="); e64(i_x); emit("\n");

  // Score: P should trust (100, correct). Integrated should withhold (-3).
  // This is the tradeoff: P gets 100% accuracy, I gets 0% but 0% false trust.
  // The source is adversarial (1/11), so I's AND-gate blocks a good predictor.
  emit("ASYM result: ");
  if(p_x==100 && i_x==-3){
    emit("CONFIRMED-Tradeoff (P trusts correctly, I withholds)\n");
  } else {
    emit("UNEXPECTED p="); e64(p_x); emit(" i="); e64(i_x); emit("\n");
  }

  // Second test: FLIP. Predictor bad (10%), source good (90%).
  // P-only should withhold, S-only should... (source good but predictor bad).
  // Integrated should withhold (AND-gate).
  emit("ADV-RSV-ASYM-END\n");
  return 0;
}

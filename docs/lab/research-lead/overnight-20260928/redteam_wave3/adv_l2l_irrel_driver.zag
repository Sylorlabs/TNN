// adv_l2l_irrel.zag -- ADVERSARIAL: learning-to-learn with IRRELEVANT Family 1.
//
// Target: learning-to-learn claim (6x speedup, 4976be69b).
// The claim: "The LINK-ordered retrieval strategy is causal for the 6x speedup."
// Attack: Make Family 1 IRRELEVANT to Family 2.
//   Family 1: 5 plen-3 chain problems.
//   Family 2: 5 plen-5 chain problems.
// The LINKs from Family 1 point to plen-3 MAPs. For Family 2 (plen-5),
// Pass-1 will try plen-3 MAPs first (wasted), then fall back to Pass-2.
//
// Questions:
//   1. Does treatment still show speedup? (If yes, the effect is not from
//      relevant strategy; it's an artifact.)
//   2. Is treatment SLOWER than fresh? (If yes, irrelevant experience hurts;
//      the claim is bounded to relevant domains, as it should be.)
//   3. Does the ablation (delete LINKs) still matter?

fn adv_stat(W:[]u8,fi:i32,pi:i32,expect:i32,ans:i32)void {
  let rbt:i32=hg(W,56); let rbr:i32=hg(W,60);
  let st:i32=hg(W,16); let lt:i32=st/1024; let lr:i32=st-lt*1024;
  let trial:i32=0;
  if(rbt==-1){ emit("F"); e64(fi); emit("-P"); e64(pi); emit(" ACT-HIT\n"); return; }
  if(lt!=rbt || lr!=rbr){ trial=1; }
  let total:i32=rbt;
  if(trial==1){ total=rbt+lt; }
  emit("F"); e64(fi); emit("-P"); e64(pi);
  emit(" ans="); e64(ans); emit(" expect="); e64(expect);
  emit(" rb_tried="); e64(rbt); emit(" rb_rej="); e64(rbr);
  emit(" trial="); e64(trial);
  emit(" total="); e64(total); emit("\n");
  return;
}

fn adv_gap(W:[]u8,seed:i32,n:i32)void {
  let i:i32=0; let r:i32=60;
  while(i<n){
    ev_teach(W,5000+seed*50+i,r,6000+seed*50+i);
    r=r+1; if(r>69){r=60;}
    i=i+1;
  }
  return;
}

// One family problem with configurable plen.
// Teaches true plen-P path: s -> L+1 -> L+2 -> ... -> L+plen-1.
// Plus distractors, then queries.
fn adv_problem(W:[]u8,fi:i32,pi:i32,s:i32,L:i32,plen:i32)void {
  ev_teach(W,s,1,L+1);
  let k:i32=1;
  while(k<plen-1){
    ev_teach(W,L+k,1,L+k+1);
    k=k+1;
  }
  // Distractors: plen-3 and plen-4 (if not the true plen).
  if(plen!=3){
    ev_teach(W,s,1,L+101); ev_teach(W,L+101,1,L+102);
  }
  if(plen!=4){
    ev_teach(W,s,1,L+201); ev_teach(W,L+201,1,L+202); ev_teach(W,L+202,1,L+203);
  }
  hs(W,56,-1); hs(W,60,-1);
  let q:i32=ev_query(W,s,50,L+plen-1,0);
  adv_stat(W,fi,pi,L+plen-1,q);
  return;
}

fn adv_family(W:[]u8,fi:i32,s0:i32,L0:i32,plen:i32)void {
  let i:i32=0;
  while(i<5){
    adv_problem(W,fi,i,s0+i,L0+i*300,plen);
    adv_gap(W,fi*10+i,5);
    i=i+1;
  }
  return;
}

// Ablation hook: set by driver (0=treatment, 1=ablate LINKs).
fn adv_abl_hook(W:[]u8,do_abl:i32)void {
  if(do_abl==1){ pc_del_links(W); }
  return;
}

fn run_arm(arm:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Family 1: plen-3 (IRRELEVANT to Family 2's plen-5).
  adv_family(W,1,101,1100,3);
  adv_gap(W,90,20);
  // Ablate for arm 2.
  if(arm==2){ adv_abl_hook(W,1); }
  // Family 2: plen-5 (structurally different from Family 1).
  adv_family(W,2,201,3100,5);
  emit(tag); emit("-END\n");
  return;
}

fn run_fresh(tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // Fresh: Family 2 only, no Family 1 experience.
  adv_family(W,2,201,3100,5);
  emit(tag); emit("-END\n");
  return;
}

fn main()i32 {
  emit("ADV-L2L-IRREL-START\n");
  // Arm 0: treatment (irrelevant F1 -> F2).
  run_arm(0,"TREAT-IRREL");
  // Arm 1: fresh (F2 only).
  run_fresh("FRESH-IRREL");
  // Arm 2: ablated (F1, delete LINKs, F2).
  run_arm(2,"ABL-IRREL");
  emit("ADV-L2L-IRREL-END\n");
  return 0;
}

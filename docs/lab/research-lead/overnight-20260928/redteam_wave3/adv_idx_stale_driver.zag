// adv_idx_stale.zag -- ADVERSARIAL: index staleness under eviction.
//
// Target: scaling index claim (140x fewer scans, 2bea4c73f).
// Attack: force eviction of indexed MAPs, then query.
// The indexed rebind (rebind_try_idx) does NOT check if bucket candidates
// are still live MAPs. It trusts the bucket's stored plen and walks the
// intrusive list via ng(W,m,12). If MAPs were evicted and slots reused,
// the bucket list may contain dangling pointers.
//
// Questions:
//   1. Does the indexed version crash on dangling bucket entries?
//   2. Are answers still correct?
//   3. Does scan work degrade to linear or worse?
//   4. Does the linear version handle eviction gracefully?

fn adv_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

// Count live MAPs (tag 20, live) vs bucket entries.
fn adv_count_live_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ n=n+1; }
    m=m+1;
  }
  return n;
}

fn adv_count_bucket(W:[]u8,plen:i32)i32 {
  let n:i32=0;
  let ix:i32=hg(W,52);
  if(ix<0){ return -1; }
  let bf:i32=0;
  if(plen==2){bf=20;} else { if(plen==3){bf=24;} else { if(plen==4){bf=28;} else { if(plen==5){bf=32;} } } }
  if(bf==0){ return -1; }
  let m:i32=ng(W,ix,bf);
  let guard:i32=0;
  while(m>=0 && guard<1100){
    n=n+1;
    // Check if m is a valid node id before following.
    if(m<0 || m>=1024){ break; }
    m=ng(W,m,12);
    guard=guard+1;
  }
  return n;
}

// Count bucket entries that point to DEAD (non-live or non-MAP) slots.
fn adv_count_stale(W:[]u8,plen:i32)i32 {
  let n:i32=0;
  let ix:i32=hg(W,52);
  if(ix<0){ return -1; }
  let bf:i32=0;
  if(plen==5){bf=32;} else { return -1; }
  let m:i32=ng(W,ix,bf);
  let guard:i32=0;
  while(m>=0 && guard<1100){
    if(m<0 || m>=1024){ break; }
    // Stale if not live OR not a MAP (tag 20).
    if(!(ng(W,m,36)==1 && ng(W,m,0)==20)){ n=n+1; }
    m=ng(W,m,12);
    guard=guard+1;
  }
  return n;
}

fn world_stale(mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  idx_mode_set(W,mode);
  // Phase 1: Build 30 plen-5 MAPs.
  let i:i32=0;
  while(i<30){
    let pm:i32=adv_mkchain(W,5000+i*10,5,51,5004+i*10);
    if(pm<0){ emit(tag); emit(" build FAIL i="); e64(i); emit("\n"); }
    i=i+1;
  }
  emit(tag); emit(" built30 live_maps="); e64(adv_count_live_maps(W));
  emit(" bucket5="); e64(adv_count_bucket(W,5)); emit("\n");
  // Phase 2: 400 interference teaches to trigger eviction.
  // (Reduced from 700 for time; 400 + 30 MAPs still pressures 1024 slots.)
  i=0;
  while(i<400){
    ev_teach(W,8000+i,60+(i%10),9000+i);
    i=i+1;
  }
  emit(tag); emit(" after_evict live_maps="); e64(adv_count_live_maps(W));
  emit(" bucket5="); e64(adv_count_bucket(W,5));
  emit(" stale5="); e64(adv_count_stale(W,5)); emit("\n");
  // Phase 3: Query 3 plen-5 subjects.
  let qi:i32=0;
  let ok:i32=0;
  while(qi<3){
    let q:i32=6101+qi*100;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    hs(W,16,0); hs(W,56,0); hs(W,60,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    let correct:i32=0;
    if(b==q+104){ correct=1; ok=ok+1; }
    emit(tag); emit(" Q"); e64(qi);
    emit(" ans="); e64(b); emit(" ok="); e64(correct);
    emit(" scan="); e64(hg(W,56));
    emit("\n");
    qi=qi+1;
  }
  emit(tag); emit(" correct="); e64(ok); emit("/3\n");
  emit(tag); emit("-END\n");
  return;
}

fn main()i32 {
  emit("ADV-IDX-STALE-START\n");
  world_stale(0,"LIN-STALE");
  world_stale(1,"IDX-STALE");
  emit("ADV-IDX-STALE-END\n");
  return 0;
}

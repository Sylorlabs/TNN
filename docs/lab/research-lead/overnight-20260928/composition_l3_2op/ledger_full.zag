// learner.zag -- generic intermediate-construction learner (FORAGE L3).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no aggregation solution in this file.
// Prereg: composition_l3/PREREG.md (commit 4339bbe9e). Pure Zag.
// 0 modes, 0 handlers, 0 semantic cases, and no cross-structure glue code.
//
// State layout (u8 buffer, offsets):
//   0: XN (episode count)   1: LN (label count)
//   2: YN (scalar obs count) 3: YT_SET (1 = Y threshold learned)
//   4..163:   X slots, 32 x 5 bytes [id,e0,e1,e2,e3]
//   164..227: label slots, 32 x 2 bytes [id,label]
//   228..231: Y threshold i32
//   232..263: M slot, 32 bytes [n,u8 gen,u8 sup,u8 pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   264..295: Mprev slot, 32 bytes (same layout; revision history)
//   296..327: Y scalar observations, 16 x 2 bytes [scalar,outcome]
//   328..1023: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer) ----
fn x_teach(st:[]u8, id:i32, e0:i32, e1:i32, e2:i32, e3:i32)void {
  let n:i32=st[0] as i32;
  if(n>=32){return;}
  let o:i32=4+n*5;
  st[o]=id as u8; st[o+1]=e0 as u8; st[o+2]=e1 as u8;
  st[o+3]=e2 as u8; st[o+4]=e3 as u8;
  st[0]=(n+1) as u8;
  return;
}
fn x_recall(st:[]u8, id:i32, out:[]u8)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=4+i*5;
    if((st[o] as i32)==id){
      out[0]=st[o+1]; out[1]=st[o+2]; out[2]=st[o+3]; out[3]=st[o+4];
      return 1;
    }
    i=i+1;
  }
  return 0;
}

// ---- labels: observed outcomes ----
fn lab_teach(st:[]u8, id:i32, lab:i32)void {
  let n:i32=st[1] as i32;
  if(n>=32){return;}
  let o:i32=164+n*2;
  st[o]=id as u8; st[o+1]=lab as u8;
  st[1]=(n+1) as u8;
  return;
}
fn lab_get(st:[]u8, id:i32)i32 {
  let n:i32=st[1] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=164+i*2;
    if((st[o] as i32)==id){return st[o+1] as i32;}
    i=i+1;
  }
  return -1;
}

// ---- Y: threshold decide (scalar consumer) ----
fn y_teach(st:[]u8, s:i32, oc:i32)void {
  let n:i32=st[2] as i32;
  if(n>=16){return;}
  let o:i32=296+n*2;
  st[o]=s as u8; st[o+1]=oc as u8;
  st[2]=(n+1) as u8;
  return;
}
fn y_fit(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let bt:i32=0;
  let bs:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<n){
      let o:i32=296+i*2;
      let s:i32=st[o] as i32;
      let oc:i32=st[o+1] as i32;
      let p:i32=0;
      if(s>=t){p=1;}
      if(p==oc){c=c+1;}
      i=i+1;
    }
    if(c>bs){bs=c;bt=t;}
    t=t+1;
  }
  set32(st,228,bt);
  st[3]=1;
  return bs;
}
fn y_decide(st:[]u8, s:i32)i32 {
  if((st[3] as i32)==0){return -1;}
  let t:i32=get32(st,228);
  if(s>=t){return 1;}
  return 0;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R3 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, e0:i32, e1:i32, e2:i32, e3:i32, rg:[]u8)i32 {
  set32(rg,0,e0); set32(rg,4,e1); set32(rg,8,e2); set32(rg,12,e3);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
fn p_outs(prog:[]u8, n:i32, st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let f:i32=x_recall(st,id,sq);
    let v:i32=-999;
    if(f==1){
      v=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
    }
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
fn count_correct(vals:[]u8, labs:[]u8, ne:i32, t:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=get32(vals,i*4);
    let p:i32=0;
    if(v>=t){p=1;}
    if(p==(labs[i] as i32)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn best_t_of_vals(vals:[]u8, labs:[]u8, ne:i32, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=count_correct(vals,labs,ne,t);
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}

// ---- construct: greedy program construction from experience ----
// mbuf (24B) gets the final program; mout: [0]=n [4]=threshold [8]=score.
// Trace lines are appended to ob; returns new at.
fn construct(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, init:[]u8, initn:i32, rg:[]u8, sq:[]u8, vals:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  p_outs(cur,cn,st,eids,ne,rg,sq,vals);
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  let bt:i32=get32(bto,0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            p_outs(cand,cn+1,st,eids,ne,rg,sq,vals);
            let cto:[]u8=z_alloc(4);
            let cs:i32=best_t_of_vals(vals,labs,ne,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      at=ob_app(ob,at,"C-ROUND ");
      at=ob_i32(ob,at,round);
      at=ob_app(ob,at," base=");
      at=ob_i32(ob,at,bs);
      at=ob_app(ob,at," eval=");
      at=ob_i32(ob,at,neval);
      if(bg>0){
        at=ob_app(ob,at," win=");
        at=ob_i32(ob,at,bop);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bd);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bss);
        at=ob_app(ob,at," gain=");
        at=ob_i32(ob,at,bg);
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        p_outs(cur,cn,st,eids,ne,rg,sq,vals);
        bs=best_t_of_vals(vals,labs,ne,bto);
        bt=get32(bto,0);
        at=ob_app(ob,at," score=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,bt);
        at=ob_nl(ob,at);
      } else {
        at=ob_app(ob,at," stop");
        at=ob_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[232]=n as u8; st[233]=gen as u8; st[234]=0; st[235]=0;
  set32(st,236,t);
  let k:i32=0;
  while(k<24){st[240+k]=prog[k];k=k+1;}
  return;
}
fn m_copy_to_prev(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[264+k]=st[232+k];k=k+1;}
  st[266]=1;
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[232+k]=0;k=k+1;}
  return;
}
fn m_bytes_equal(st:[]u8, snap:[]u8)i32 {
  // Structural identity only (PREREG.md ERRATUM-1): n, gen, sup, pad,
  // and the 24 program bytes. The threshold field at 236..239 is Y's
  // adaptive decision parameter, recorded per M generation; it is
  // expected to change on threshold refit and is excluded here.
  let k:i32=0;
  while(k<4){
    if(st[232+k]!=snap[k]){return 0;}
    k=k+1;
  }
  k=8;
  while(k<32){
    if(st[232+k]!=snap[k]){return 0;}
    k=k+1;
  }
  return 1;
}

// ---- adapt: generic adaptation policy (no modes) ----
// code 0 = kept, 1 = threshold refit, 2 = structural revision, 3 = HONESTFAIL
fn adapt(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8, ob:[]u8, at:i32, res:[]u8)i32 {
  let mn:i32=st[232] as i32;
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[240+k];k=k+1;}
  let mt:i32=get32(st,236);
  p_outs(mprog,mn,st,eids,ne,rg,sq,vals);
  let c:i32=count_correct(vals,labs,ne,mt);
  if(c==ne){set32(res,0,0);return at;}
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  if(bs==ne){
    let nt:i32=get32(bto,0);
    set32(st,236,nt);
    set32(st,228,nt);
    set32(res,0,1);
    return at;
  }
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st,eids,labs,ne,mprog,mn,rg,sq,vals,mbuf,mout,ob,at);
  let nn:i32=get32(mout,0);
  let nt2:i32=get32(mout,4);
  let ns:i32=get32(mout,8);
  if(ns==ne){
    m_copy_to_prev(st);
    let g:i32=(st[233] as i32)+1;
    m_write(st,nn,g,nt2,mbuf);
    set32(st,228,nt2);
    set32(res,0,2);
    return at;
  }
  set32(res,0,3);
  return at;
}

// ---- decide: X -> M -> Y; -1 = NO_DECISION ----
fn decide(st:[]u8, id:i32, rg:[]u8, sq:[]u8)i32 {
  if(x_recall(st,id,sq)==0){return -1;}
  let mn:i32=st[232] as i32;
  if(mn==0){return -1;}
  if((st[3] as i32)==0){return -1;}
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[240+k];k=k+1;}
  let s:i32=p_exec(mprog,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
  return y_decide(st,s);
}
// world.zag -- LEDGER environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rules, episode tables, and menu controls.
// The learner never calls anything in this file. The driver uses the
// hidden rules only to generate observed labels for teaching.
// Tables match composition_l3_2op/PREREG.md section 3 exactly.
// Hidden rules are credit-minus-debit shaped: no single op suffices.

// Episode tables: 4 digit-chars per episode, in prereg order.
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "29509148767254239594803517663217";}
  if(ph==2){return "8451336967601245";}
  if(ph==3){return "9870896195827673";}
  if(ph==4){return "99845455";}
  if(ph==5){return "96608784594173569230009944411188";}
  return "9322555584612228";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  if(ph==2){return 4;}
  if(ph==3){return 4;}
  if(ph==4){return 2;}
  if(ph==5){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  if(ph==2){return idx+9;}
  if(ph==3){return idx+21;}
  if(ph==4){return idx+25;}
  if(ph==5){return idx+31;}
  return idx+39;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rules (never visible to the learner).
fn w_true(rule:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(rule==1){
    if(e0+e1-e2>=6){return 1;}
    return 0;
  }
  if(rule==2){
    if(e0+e1-e2>=9){return 1;}
    return 0;
  }
  if(e0+e1-e2+e3>=9){return 1;}
  return 0;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}
// driver.zag -- LEDGER L3 experiment driver.
// Arms, phases, kill-bar evaluation. The driver teaches X/Y, runs the
// learner's construct/adapt, and evaluates Z. It never invents the
// intermediate: all construction goes through learner.zag.
// Prereg: composition_l3_2op/PREREG.md. Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,12,1); y_teach(st,15,1); y_teach(st,11,1);
  y_teach(st,8,0); y_teach(st,5,0); y_teach(st,9,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,228));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_phase(st:[]u8, ph:i32, rule:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let sq:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    at=ob_app(ob,at,"X-TEACH id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    at=ob_i32(ob,at,(sq[0] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[1] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[2] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[3] as i32));
    if(rule>0){
      let lb:i32=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      lab_teach(st,id,lb);
      at=ob_app(ob,at," label=");
      at=ob_i32(ob,at,lb);
    }
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, off:i32, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[off] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[off+1] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[off+2] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,off+4));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[off+8+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Driver-side probe of a single-instruction candidate (rejected
// alternatives for the K-2OP-1/K-2OP-3 trace). Not learner machinery.
fn d_probe(ob:[]u8, at:i32, tag:[]u8, op:i32, d:i32, s:i32, st:[]u8, eids:[]u8, labs:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)i32 {
  let pr:[]u8=z_alloc(24);
  pr[0]=op as u8; pr[1]=d as u8; pr[2]=s as u8;
  p_outs(pr,1,st,eids,ne,rg,sq,vals);
  let to:[]u8=z_alloc(4);
  let sc:i32=best_t_of_vals(vals,labs,ne,to);
  at=ob_app(ob,at,"PROBE ");
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,sc);
  at=ob_app(ob,at,"/8 t=");
  at=ob_i32(ob,at,get32(to,0));
  at=ob_nl(ob,at);
  return at;
}
// Max best-threshold score over all 20 distinct d=0 single-instruction
// candidates. Independent driver-side check that no 1-op suffices.
fn d_max1op(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)i32 {
  let mx:i32=0;
  let op:i32=0;
  while(op<5){
    let s:i32=0;
    while(s<4){
      let pr:[]u8=z_alloc(24);
      pr[0]=op as u8; pr[1]=0; pr[2]=s as u8;
      p_outs(pr,1,st,eids,ne,rg,sq,vals);
      let to:[]u8=z_alloc(4);
      let sc:i32=best_t_of_vals(vals,labs,ne,to);
      if(sc>mx){mx=sc;}
      s=s+1;
    }
    op=op+1;
  }
  return mx;
}
// Check the M program bytes against the expected 2-op form
// [ADD R0,R1, SUB R0,R2] = 1,0,1,2,0,2.
fn d_prog_is(st:[]u8)i32 {
  let e0:i32=1; let e1:i32=0; let e2:i32=1;
  let e3:i32=2; let e4:i32=0; let e5:i32=2;
  if((st[240] as i32)!=e0){return 0;}
  if((st[241] as i32)!=e1){return 0;}
  if((st[242] as i32)!=e2){return 0;}
  if((st[243] as i32)!=e3){return 0;}
  if((st[244] as i32)!=e4){return 0;}
  if((st[245] as i32)!=e5){return 0;}
  return 1;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, rule:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let f:i32=x_recall(st,id,sq);
    let tl:i32=-2;
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(f==1){
      tl=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      let mn:i32=st[232] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[240+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      at=ob_i32(ob,at,(sq[0] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[1] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[2] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[3] as i32));
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}
fn d_menu_fit(kind:i32, st:[]u8, eids:[]u8, ne:i32, sq:[]u8, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<ne){
      let id:i32=eids[i] as i32;
      x_recall(st,id,sq);
      let v:i32=menu_agg(kind,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      let p:i32=0;
      if(v>=t){p=1;}
      if(p==lab_get(st,id)){c=c+1;}
      i=i+1;
    }
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}
fn d_menu_eval(kind:i32, st:[]u8, eids:[]u8, ne:i32, t:i32, rule:i32, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    x_recall(st,id,sq);
    let v:i32=menu_agg(kind,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    let tl:i32=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    let p:i32=0;
    if(v>=t){p=1;}
    let ok:i32=0;
    if(p==tl){ok=1;c=c+1;}
    at=ob_app(ob,at,"MENU-EP ");
    at=ob_app(ob,at,menu_name(kind));
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," v=");
    at=ob_i32(ob,at,v);
    at=ob_app(ob,at," pred=");
    at=ob_i32(ob,at,p);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let atp:[]u8=z_alloc(4);
  at=ob_app(ob,at,"L3-LEDGER-START\n");

  // ================= ARM-FULL phase 1 =================
  at=ob_app(ob,at,"=== ARM-FULL phase1 ===\n");
  let st1:[]u8=z_alloc(1024);
  at=d_y_prior(st1,ob,at);
  at=d_teach_phase(st1,1,1,ob,at);
  at=d_teach_phase(st1,2,0,ob,at);

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<8){
    let id:i32=i+1;
    eids1[i]=id as u8;
    labs1[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  let eidsT:[]u8=z_alloc(4);
  i=0;
  while(i<4){eidsT[i]=(i+9) as u8;i=i+1;}

  at=ob_app(ob,at,"--- construct M (fresh, first creation) ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st1,eids1,labs1,8,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn:i32=get32(mout,0);
  let mt:i32=get32(mout,4);
  let ms:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at,"/8\n");
  m_write(st1,mn,1,mt,mbuf);
  set32(st1,228,mt);
  at=d_m_dump(st1,232,"M-STATE",ob,at);

  at=ob_app(ob,at,"--- 1-op insufficiency: best single instruction ---\n");
  let max1:i32=d_max1op(st1,eids1,labs1,8,rg,sq,vals);
  at=ob_app(ob,at,"MAX1OP ");
  at=ob_i32(ob,at,max1);
  at=ob_app(ob,at,"/8\n");
  at=ob_app(ob,at,"--- rejected single-instruction alternatives ---\n");
  at=d_probe(ob,at,"ADD-R0-R1",1,0,1,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"SUB-R0-R2",2,0,2,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"SUB-R0-R3",2,0,3,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"MIN-R0-R2",4,0,2,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"ADD-R0-R3",1,0,3,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"CPY-R0-R0",0,0,0,st1,eids1,labs1,8,rg,sq,vals);
  at=ob_app(ob,at,"--- prior-world solutions do not transfer ---\n");
  at=d_probe(ob,at,"FORAGE-ADD-R0-R2",1,0,2,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"RELAY-SUB-R0-R1",2,0,1,st1,eids1,labs1,8,rg,sq,vals);
  let pform:i32=d_prog_is(st1);
  at=ob_app(ob,at,"M-FORM-2OP ");
  at=ob_i32(ob,at,pform);
  at=ob_nl(ob,at);

  set32(atp,0,at);
  let zfull:i32=d_z_run(st1,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FULL ");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-X-ONLY =================
  at=ob_app(ob,at,"=== ARM-X-ONLY ===\n");
  let st2:[]u8=z_alloc(1024);
  at=d_teach_phase(st2,1,0,ob,at);
  at=d_teach_phase(st2,2,0,ob,at);
  set32(atp,0,at);
  let zx:i32=d_z_run(st2,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-XONLY ");
  at=ob_i32(ob,at,zx);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-Y-ONLY =================
  at=ob_app(ob,at,"=== ARM-Y-ONLY ===\n");
  let st3:[]u8=z_alloc(1024);
  at=d_y_prior(st3,ob,at);
  set32(atp,0,at);
  let zy:i32=d_z_run(st3,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-YONLY ");
  at=ob_i32(ob,at,zy);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-MENU (controls) =================
  at=ob_app(ob,at,"=== ARM-MENU ===\n");
  let mk:i32=0;
  let mworst:i32=4;
  while(mk<5){
    let to:[]u8=z_alloc(4);
    let fsc:i32=d_menu_fit(mk,st1,eids1,8,sq,to);
    let ftt:i32=get32(to,0);
    at=ob_app(ob,at,"MENU-FIT ");
    at=ob_app(ob,at,menu_name(mk));
    at=ob_app(ob,at," train=");
    at=ob_i32(ob,at,fsc);
    at=ob_app(ob,at,"/8 t=");
    at=ob_i32(ob,at,ftt);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    let msc:i32=d_menu_eval(mk,st1,eidsT,4,ftt,1,sq,ob,atp);
    at=get32(atp,0);
    at=ob_app(ob,at,"MENU-TEST ");
    at=ob_app(ob,at,menu_name(mk));
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,msc);
    at=ob_app(ob,at,"/4\n");
    if(msc<mworst){mworst=msc;}
    mk=mk+1;
  }

  // ================= ARM-NO-M =================
  at=ob_app(ob,at,"=== ARM-NO-M ===\n");
  let st4:[]u8=z_alloc(1024);
  let q:i32=0;
  while(q<1024){st4[q]=st1[q];q=q+1;}
  m_wipe(st4);
  set32(atp,0,at);
  let znm:i32=d_z_run(st4,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-NOM ");
  at=ob_i32(ob,at,znm);
  at=ob_app(ob,at,"/4\n");

  // ================= PHASE 2: reuse =================
  at=ob_app(ob,at,"=== PHASE2 reuse ===\n");
  at=d_teach_phase(st1,3,2,ob,at);
  at=d_teach_phase(st1,4,0,ob,at);
  let snap:[]u8=z_alloc(32);
  q=0;
  while(q<32){snap[q]=st1[232+q];q=q+1;}
  let eids2:[]u8=z_alloc(4);
  let labs2:[]u8=z_alloc(4);
  i=0;
  while(i<4){
    let id:i32=i+21;
    eids2[i]=id as u8;
    labs2[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  let res:[]u8=z_alloc(8);
  at=adapt(st1,eids2,labs2,4,rg,sq,vals,ob,at,res);
  let acode:i32=get32(res,0);
  at=ob_app(ob,at,"ADAPT code=");
  at=ob_i32(ob,at,acode);
  at=ob_app(ob,at," (0=keep 1=threshold 2=revision 3=fail)\n");
  at=d_m_dump(st1,232,"M-STATE",ob,at);
  let peq:i32=m_bytes_equal(st1,snap);
  at=ob_app(ob,at,"M-PERSIST ");
  at=ob_i32(ob,at,peq);
  at=ob_nl(ob,at);
  let eidsH:[]u8=z_alloc(2);
  eidsH[0]=25; eidsH[1]=26;
  set32(atp,0,at);
  let zh:i32=d_z_run(st1,eidsH,2,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-HELD ");
  at=ob_i32(ob,at,zh);
  at=ob_app(ob,at,"/2\n");

  // ================= PHASE 3: revision =================
  at=ob_app(ob,at,"=== PHASE3 revision ===\n");
  at=d_teach_phase(st1,5,3,ob,at);
  at=d_teach_phase(st1,6,0,ob,at);
  let eids3:[]u8=z_alloc(8);
  let labs3:[]u8=z_alloc(8);
  i=0;
  while(i<8){
    let id:i32=i+31;
    eids3[i]=id as u8;
    labs3[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  at=adapt(st1,eids3,labs3,8,rg,sq,vals,ob,at,res);
  let acode3:i32=get32(res,0);
  at=ob_app(ob,at,"ADAPT code=");
  at=ob_i32(ob,at,acode3);
  at=ob_app(ob,at," (0=keep 1=threshold 2=revision 3=fail)\n");
  at=d_m_dump(st1,232,"M-STATE",ob,at);
  at=d_m_dump(st1,264,"MPREV-STATE",ob,at);
  let eidsT3:[]u8=z_alloc(4);
  i=0;
  while(i<4){eidsT3[i]=(i+39) as u8;i=i+1;}
  set32(atp,0,at);
  let z3:i32=d_z_run(st1,eidsT3,4,3,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-REV ");
  at=ob_i32(ob,at,z3);
  at=ob_app(ob,at,"/4\n");

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let k1:i32=0;
  if(zx==0){if(zy==0){if(zfull==4){if(max1<8){k1=1;}}}}
  at=ob_app(ob,at,"K-2OP-1 insufficiency xonly=");
  at=ob_i32(ob,at,zx);
  at=ob_app(ob,at," yonly=");
  at=ob_i32(ob,at,zy);
  at=ob_app(ob,at," full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," max1op=");
  at=ob_i32(ob,at,max1);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-2OP-2 grep-audit see-shell (frozen patterns, learner.zag)\n");
  let k3:i32=0;
  if(mn==2){if(ms==8){if(pform==1){k3=1;}}}
  at=ob_app(ob,at,"K-2OP-3 creation n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," trainscore=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at," form2op=");
  at=ob_i32(ob,at,pform);
  at=ob_app(ob,at," nom=");
  at=ob_i32(ob,at,znm);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4need:i32=0;
  if(zfull==4){if(znm==0){k4need=1;}}
  at=ob_app(ob,at,"K-2OP-3b necessity full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," nom=");
  at=ob_i32(ob,at,znm);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4need);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(acode==1){if(peq==1){if(zh==2){k4=1;}}}
  at=ob_app(ob,at,"K-2OP-4 persistence adapt=");
  at=ob_i32(ob,at,acode);
  at=ob_app(ob,at," persist=");
  at=ob_i32(ob,at,peq);
  at=ob_app(ob,at," held=");
  at=ob_i32(ob,at,zh);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-2OP-5 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"REVISION adapt3=");
  at=ob_i32(ob,at,acode3);
  at=ob_app(ob,at," zrev=");
  at=ob_i32(ob,at,z3);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  let k3all:i32=0;
  if(k3==1){if(k4need==1){k3all=1;}}
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3all);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"L3-LEDGER-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

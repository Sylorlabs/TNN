// world.zag -- LEDGER environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rules, episode tables, and menu controls.
// The learner never calls anything in this file. The driver uses the
// hidden rules only to generate observed labels for teaching.
// Tables match composition_l3_2op/PREREG.md section 3 exactly.
// Hidden rules are credit-minus-debit shaped: no single op suffices.

// Episode tables: 4 digit-chars per episode, in prereg order.
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "29509148767254239594803517663217";}
  if(ph==2){return "8451336967601245";}
  if(ph==3){return "9870896195827673";}
  if(ph==4){return "99845455";}
  if(ph==5){return "96608784594173569230009944411188";}
  return "9322555584612228";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  if(ph==2){return 4;}
  if(ph==3){return 4;}
  if(ph==4){return 2;}
  if(ph==5){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  if(ph==2){return idx+9;}
  if(ph==3){return idx+21;}
  if(ph==4){return idx+25;}
  if(ph==5){return idx+31;}
  return idx+39;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rules (never visible to the learner).
fn w_true(rule:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(rule==1){
    if(e0+e1-e2>=6){return 1;}
    return 0;
  }
  if(rule==2){
    if(e0+e1-e2>=9){return 1;}
    return 0;
  }
  if(e0+e1-e2+e3>=9){return 1;}
  return 0;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}

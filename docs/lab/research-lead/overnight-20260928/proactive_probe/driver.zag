// driver.zag -- PPROBE experiment driver: three arms, frozen kill bars.
// The driver teaches labeled episodes, schedules the world change,
// supplies probe input sets when the learner requests a probe, presents
// high-stakes queries, and calls x_maybe_revise as a standing
// heartbeat. It never writes C_REV_REQ (offset 505) or PROBE_FRESH
// (offset 562): the probe decision, verdicts, latch, and freshness are
// the learner's. Static audit: no "st[505]=" or "st[562]=" assignment
// in this file. Prereg: proactive_probe/PREREG.md. Pure Zag.

fn st_new()[]u8 {
  let st:[]u8=z_alloc(1024);
  set32(st,510,-1);
  set32(st,550,-1);
  set32(st,554,-1);
  set32(st,558,-1);
  return st;
}
fn d_req(st:[]u8)i32 { return st[505] as i32; }
fn d_slot(st:[]u8)i32 { return st[501] as i32; }
fn d_thresh(st:[]u8)i32 { return st[502] as i32; }
fn d_revcnt(st:[]u8)i32 { return get32(st,506); }
fn d_firstq(st:[]u8)i32 { return get32(st,510); }
fn d_fiterr(st:[]u8)i32 { return get32(st,522); }
fn d_olderr(st:[]u8)i32 { return get32(st,530); }
fn d_cor(st:[]u8)i32 { return get32(st,514); }
fn d_probes(st:[]u8)i32 { return get32(st,534); }
fn d_probefails(st:[]u8)i32 { return get32(st,538); }
fn d_hscommits(st:[]u8)i32 { return get32(st,542); }
fn d_hsfails(st:[]u8)i32 { return get32(st,546); }
fn d_probeseq(st:[]u8)i32 { return get32(st,550); }
fn d_reviseseq(st:[]u8)i32 { return get32(st,554); }
fn d_commitseq(st:[]u8)i32 { return get32(st,558); }
fn d_unprobed(st:[]u8)i32 { return get32(st,567); }

fn d_teach0(st:[]u8)void {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train0(i,sq);
    let lb:i32=w_label0(sq);
    x_teach(st,i+1,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return;
}
fn d_teach1(st:[]u8)void {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_train1(i,sq);
    let lb:i32=w_label1(sq);
    x_teach(st,i+11,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),lb);
    i=i+1;
  }
  return;
}
fn d_fitline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," err=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,(st[1] as i32));
  at=ob_nl(ob,at);
  return at;
}
// Run a probe round of n low-stakes probes: wq 0 = world 0 probe set,
// 1 = world 1 probe set; wl 0/1 selects the outcome law. Probe fails
// are read back from the learner's C_PROBE_FAILS counter.
fn d_proberound(st:[]u8, ob:[]u8, at:i32, wq:i32, wl:i32, n:i32, tag:[]u8)i32 {
  let sq:[]u8=z_alloc(6);
  let k:i32=0;
  while(k<n){
    if(wq==0){w_pp0(k,sq);} else {w_pp1(k,sq);}
    let actual:i32=0;
    if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
    let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
    let ok:i32=c_verify(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual,1);
    at=ob_app(ob,at,tag);
    at=ob_app(ob,at," q=");
    at=ob_i32(ob,at,k+1);
    at=ob_app(ob,at," pred=");
    at=ob_i32(ob,at,pred);
    at=ob_app(ob,at," act=");
    at=ob_i32(ob,at,actual);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at," run=");
    at=ob_i32(ob,at,(st[504] as i32));
    at=ob_app(ob,at," req=");
    at=ob_i32(ob,at,d_req(st));
    at=ob_nl(ob,at);
    k=k+1;
  }
  return at;
}
// One high-stakes commitment: hi selects w_hs, wl the outcome law.
// Success is read back from the learner's C_CORRECT counter.
fn d_commitq(st:[]u8, ob:[]u8, at:i32, hi:i32, wl:i32, tag:[]u8)i32 {
  let sq:[]u8=z_alloc(6);
  w_hs(hi,sq);
  let actual:i32=0;
  if(wl==0){actual=w_label0(sq);} else {actual=w_label1(sq);}
  let pred:i32=c_act(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));
  let ok:i32=c_commit(st,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),actual);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," pred=");
  at=ob_i32(ob,at,pred);
  at=ob_app(ob,at," act=");
  at=ob_i32(ob,at,actual);
  at=ob_app(ob,at," ok=");
  at=ob_i32(ob,at,ok);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(st));
  at=ob_nl(ob,at);
  return at;
}
fn d_contractline(st:[]u8, ob:[]u8, at:i32, tag:[]u8)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," ty=");
  at=ob_i32(ob,at,(st[500] as i32));
  at=ob_app(ob,at," slot=");
  at=ob_i32(ob,at,d_slot(st));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,d_thresh(st));
  at=ob_app(ob,at," revcount=");
  at=ob_i32(ob,at,d_revcnt(st));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(st));
  at=ob_app(ob,at," fiterr=");
  at=ob_i32(ob,at,d_fiterr(st));
  at=ob_app(ob,at," olderr=");
  at=ob_i32(ob,at,d_olderr(st));
  at=ob_app(ob,at," probes=");
  at=ob_i32(ob,at,d_probes(st));
  at=ob_app(ob,at," pfails=");
  at=ob_i32(ob,at,d_probefails(st));
  at=ob_app(ob,at," hs=");
  at=ob_i32(ob,at,d_hscommits(st));
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(st));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(st));
  at=ob_nl(ob,at);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  at=ob_app(ob,at,"PROACTIVE-PROBE\n");

  // ---- Arm A: proactive, drift ----
  at=ob_app(ob,at,"ARM-A proactive drift\n");
  let sta:[]u8=st_new();
  sta[2]=1;
  sta[3]=1;
  d_teach0(sta);
  x_fit_contract(sta);
  at=d_fitline(sta,ob,at,"A-FIT0");
  let pre_slot:i32=d_slot(sta);
  let pre_t:i32=d_thresh(sta);
  // Round 1, world 0.
  c_phase_reset(sta);
  let r1_need:i32=x_probe_begin(sta);
  let pf0:i32=d_probefails(sta);
  at=d_proberound(sta,ob,at,0,0,3,"A-P1");
  let fails_r1:i32=d_probefails(sta)-pf0;
  x_probe_end(sta,fails_r1);
  let r1_reprobe:i32=x_probe_begin(sta);
  at=ob_app(ob,at,"A-R1 probeneed=");
  at=ob_i32(ob,at,r1_need);
  at=ob_app(ob,at," reprobe=");
  at=ob_i32(ob,at,r1_reprobe);
  at=ob_nl(ob,at);
  x_maybe_revise(sta);
  let rev_r1:i32=d_revcnt(sta);
  let c0:i32=d_cor(sta);
  at=d_commitq(sta,ob,at,0,0,"A-HS1");
  let ok1:i32=d_cor(sta)-c0;
  at=ob_app(ob,at,"A-R1SUM probefails=");
  at=ob_i32(ob,at,fails_r1);
  at=ob_app(ob,at," hsok=");
  at=ob_i32(ob,at,ok1);
  at=ob_app(ob,at," rev=");
  at=ob_i32(ob,at,rev_r1);
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(sta));
  at=ob_nl(ob,at);
  // World change (driver scheduled, disclosed). Round 2, world 1.
  c_phase_reset(sta);
  let r2_need:i32=x_probe_begin(sta);
  pf0=d_probefails(sta);
  at=d_proberound(sta,ob,at,1,1,3,"A-P2");
  let fails_r2:i32=d_probefails(sta)-pf0;
  let req_before:i32=d_req(sta);
  let firstq:i32=d_firstq(sta);
  at=ob_app(ob,at,"A-DETECT req=");
  at=ob_i32(ob,at,req_before);
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,firstq);
  at=ob_nl(ob,at);
  x_probe_end(sta,fails_r2);
  d_teach1(sta);
  x_maybe_revise(sta);
  at=ob_app(ob,at,"A-REVISE ");
  at=d_contractline(sta,ob,at,"");
  let post_slot:i32=d_slot(sta);
  let post_t:i32=d_thresh(sta);
  c0=d_cor(sta);
  at=d_commitq(sta,ob,at,1,1,"A-HS2");
  let ok2:i32=d_cor(sta)-c0;
  at=ob_app(ob,at,"A-R2SUM probefails=");
  at=ob_i32(ob,at,fails_r2);
  at=ob_app(ob,at," hsok=");
  at=ob_i32(ob,at,ok2);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(sta));
  at=ob_app(ob,at," seq=");
  at=ob_i32(ob,at,d_probeseq(sta));
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,d_reviseseq(sta));
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,d_commitseq(sta));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(sta));
  at=ob_nl(ob,at);
  at=d_contractline(sta,ob,at,"A-FINAL");

  // ---- Arm B: proactive, no drift control ----
  at=ob_app(ob,at,"ARM-B proactive no-drift\n");
  let stb:[]u8=st_new();
  stb[2]=1;
  stb[3]=1;
  d_teach0(stb);
  x_fit_contract(stb);
  at=d_fitline(stb,ob,at,"B-FIT0");
  c_phase_reset(stb);
  let r:i32=0;
  while(r<3){
    let need:i32=x_probe_begin(stb);
    at=ob_app(ob,at,"B-R need=");
    at=ob_i32(ob,at,need);
    at=ob_nl(ob,at);
    pf0=d_probefails(stb);
    at=d_proberound(stb,ob,at,0,0,3,"B-P");
    let bf:i32=d_probefails(stb)-pf0;
    x_probe_end(stb,bf);
    x_maybe_revise(stb);
    at=d_commitq(stb,ob,at,2+r,0,"B-HS");
    r=r+1;
  }
  at=ob_app(ob,at,"B-SUM probes=");
  at=ob_i32(ob,at,d_probes(stb));
  at=ob_app(ob,at," pfails=");
  at=ob_i32(ob,at,d_probefails(stb));
  at=ob_app(ob,at," rev=");
  at=ob_i32(ob,at,d_revcnt(stb));
  at=ob_app(ob,at," hs=");
  at=ob_i32(ob,at,d_hscommits(stb));
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(stb));
  at=ob_app(ob,at," unprobed=");
  at=ob_i32(ob,at,d_unprobed(stb));
  at=ob_app(ob,at," firstq=");
  at=ob_i32(ob,at,d_firstq(stb));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,d_req(stb));
  at=ob_nl(ob,at);
  at=d_contractline(stb,ob,at,"B-FINAL");

  // ---- Arm C: reactive control, drift, probing disabled ----
  at=ob_app(ob,at,"ARM-C reactive control\n");
  let stc:[]u8=st_new();
  stc[2]=1;
  stc[3]=0;
  d_teach0(stc);
  x_fit_contract(stc);
  at=d_fitline(stc,ob,at,"C-FIT0");
  c_phase_reset(stc);
  let c_need1:i32=x_probe_begin(stc);
  c0=d_cor(stc);
  at=d_commitq(stc,ob,at,0,0,"C-HS1");
  let cok1:i32=d_cor(stc)-c0;
  x_maybe_revise(stc);
  // World change (driver scheduled, disclosed).
  c_phase_reset(stc);
  let c_need2:i32=x_probe_begin(stc);
  c0=d_cor(stc);
  at=d_commitq(stc,ob,at,1,1,"C-HS2");
  let cok2:i32=d_cor(stc)-c0;
  x_maybe_revise(stc);
  at=ob_app(ob,at,"C-SUM probeneed=");
  at=ob_i32(ob,at,c_need1+c_need2);
  at=ob_app(ob,at," hsok1=");
  at=ob_i32(ob,at,cok1);
  at=ob_app(ob,at," hsok2=");
  at=ob_i32(ob,at,cok2);
  at=ob_app(ob,at," hsfails=");
  at=ob_i32(ob,at,d_hsfails(stc));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,d_req(stc));
  at=ob_nl(ob,at);
  at=d_contractline(stc,ob,at,"C-FINAL");

  // ---- Kill bars ----
  let k1:i32=0;
  if(r1_need==1){ if(r1_reprobe==0){ if(fails_r1==0){ if(ok1==1){ if(rev_r1==0){k1=1;} } } } }
  let k2:i32=0;
  if(r2_need==1){ if(fails_r2==2){ if(req_before==1){ if(firstq==2){ if(d_hsfails(sta)==0){k2=1;} } } } }
  let k3:i32=0;
  if(d_probeseq(sta)<d_reviseseq(sta)){ if(d_reviseseq(sta)<d_commitseq(sta)){ if(d_unprobed(sta)==0){k3=1;} } }
  let k4:i32=0;
  if(ok2==1){ if(cok2==0){k4=1;} }
  let k5:i32=0;
  if(d_probes(stb)==9){ if(d_probefails(stb)==0){ if(d_revcnt(stb)==0){
    if(d_hscommits(stb)==3){ if(d_hsfails(stb)==0){ if(d_unprobed(stb)==0){k5=1;} } } } } }
  let k6:i32=0;
  if(pre_slot==2){ if(pre_t==2){ if(post_slot==4){ if(post_t==2){
    if(d_slot(stc)==2){ if(d_thresh(stc)==2){k6=1;} } } } } }
  let k8:i32=0;
  if(d_fiterr(sta)==0){ if(d_olderr(sta)>=1){ if(d_firstq(stb)<0){ if(d_req(stb)==0){k8=1;} } } }

  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=see-shell");
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  let pass:i32=k1+k2+k3+k4+k5+k6+k8;
  if(pass==7){
    at=ob_app(ob,at,"VERDICT PROACTIVE-PROBE-COMPLETE\n");
  } else {
    at=ob_app(ob,at,"VERDICT FAIL bars-passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/7\n");
  }
  at=ob_app(ob,at,"PROACTIVE-PROBE-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

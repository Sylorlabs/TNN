// world.zag -- PPROBE frozen world data (from PREREG section 3).
// World 0 outcome law: label = (s2 >= 2). World 1: label = (s4 >= 2).
// The learner never calls w_label0/w_label1; they are the world's
// outcome laws used by the driver to compute observed consequences.
// Training episodes reuse the CDRIFT frozen sets, re-frozen here.

fn sq6(sq:[]u8, a:i32, b:i32, c:i32, d:i32, e:i32, f:i32)void {
  sq[0]=a as u8; sq[1]=b as u8; sq[2]=c as u8;
  sq[3]=d as u8; sq[4]=e as u8; sq[5]=f as u8;
  return;
}
fn w_label0(sq:[]u8)i32 {
  if((sq[2] as i32)>=2){return 1;}
  return 0;
}
fn w_label1(sq:[]u8)i32 {
  if((sq[4] as i32)>=2){return 1;}
  return 0;
}

// Training episodes, world 0. Frozen fit: (2,2).
fn w_train0(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,1,0,0);}
  if(i==2){sq6(sq,0,0,2,0,1,0);}
  if(i==3){sq6(sq,2,3,1,0,0,1);}
  return;
}
// Training episodes, world 1. Frozen fit: (4,2).
fn w_train1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,0,0,3,0);}
  if(i==1){sq6(sq,1,0,1,1,0,1);}
  if(i==2){sq6(sq,0,0,0,0,2,0);}
  if(i==3){sq6(sq,0,3,0,0,1,0);}
  return;
}
// World 0 probe set. All 3 pass under (2,2).
fn w_pp0(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,2,0,0,0);}
  if(i==1){sq6(sq,1,0,0,0,0,0);}
  if(i==2){sq6(sq,0,0,3,1,0,0);}
  return;
}
// World 1 probe set. Q0 and Q1 fail under stale (2,2); Q2 passes.
fn w_pp1(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,1,1,0,0,3,0);}
  if(i==2){sq6(sq,2,0,0,0,0,0);}
  return;
}
// High-stakes queries. 0: HS1 (world 0). 1: HS2 (world 1).
// 2..4: HSB0..HSB2 (world 0, arm B rounds).
fn w_hs(i:i32, sq:[]u8)void {
  if(i==0){sq6(sq,0,0,3,0,0,0);}
  if(i==1){sq6(sq,0,0,0,0,3,0);}
  if(i==2){sq6(sq,0,0,3,0,0,0);}
  if(i==3){sq6(sq,1,1,0,0,0,0);}
  if(i==4){sq6(sq,0,0,2,1,0,0);}
  return;
}

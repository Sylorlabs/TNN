// ds_main.zag -- harness main for SPEC-DRIFTRATE-SWEEP.
// Sweeps drift period M and query period N over {1,2,4,8,16} (25 cells)
// x 3 policies (0=eager, 1=lazy, 2=refuse) = 75 episodes, each emitting
// one CELL line. Relation/object ids arrive via the rb_* accessors; no
// world literals appear in this file.
fn main()i32 {
  let B:[]u8=z_alloc(8192);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let mi:i32=0;
  while(mi<5){
    let M:i32=ds_grid(mi);
    let ni:i32=0;
    while(ni<5){
      let N:i32=ds_grid(ni);
      let pol:i32=0;
      while(pol<3){
        c=ds_episode(B,c,M,N,pol,ra,oa1);
        pol=pol+1;
      }
      ni=ni+1;
    }
    mi=mi+1;
  }
  o_flush(B,c);
  return 0;
}

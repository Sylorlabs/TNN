// ds_spec.zag -- drift-rate vs query-rate sweep policy steps for
// SPEC-DRIFTRATE-SWEEP. Reuses the byte-unmodified rr_ret_spec wrapper
// from SPEC-REFUSAL-RECOVERY for the eager/lazy query path and the et_*
// epoch machinery unmodified. No world literals in this file: the
// relation and object ids arrive via the rb_* accessors.
fn ds_agree_ret(rs:i32,rg:i32,sout:i32,gout:i32)i32 {
  if(rs!=rg){ return 0; }
  if(rs==0){ return 1; }
  if(sout==gout){ return 1; }
  return 0;
}
fn ds_grid(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 2; }
  if(i==2){ return 4; }
  if(i==3){ return 8; }
  return 16;
}
fn ds_emit_cell(B:[]u8,c:i32,M:i32,N:i32,pol:i32,dr:i32,q:i32,rb:i32,an:i32,rf:i32,kb:i32)i32 {
  c=o_app(B,c,"CELL M=");
  c=o_i64(B,c,M as i64);
  c=o_app(B,c," N=");
  c=o_i64(B,c,N as i64);
  c=o_app(B,c," P=");
  if(pol==0){ c=o_app(B,c,"eager"); }
  if(pol==1){ c=o_app(B,c,"lazy"); }
  if(pol==2){ c=o_app(B,c,"refuse"); }
  c=o_app(B,c," D=");
  c=o_i64(B,c,dr as i64);
  c=o_app(B,c," Q=");
  c=o_i64(B,c,q as i64);
  c=o_app(B,c," rebuilds=");
  c=o_i64(B,c,rb as i64);
  c=o_app(B,c," answered=");
  c=o_i64(B,c,an as i64);
  c=o_app(B,c," refusals=");
  c=o_i64(B,c,rf as i64);
  c=o_app(B,c," kb=");
  c=o_i64(B,c,kb as i64);
  c=o_nl(B,c);
  return c;
}
// One query under policy pol. acc packs deltas: 0=rebuilds, 4=answered,
// 8=refusals, 12=kb. pol 0=eager and 1=lazy share the rr wrapper (lazy
// rebuilds only when the epoch gate actually refuses); pol 2=refuse uses
// the plain epoch-gated spec and never rebuilds.
fn ds_query(L:[]u8,S:[]u8,A:[]u8,ra:i32,oa1:i32,pol:i32,K:[]u8,OUT:[]u8,OUTG:[]u8,acc:[]u8)void {
  set32(K,0,0);
  set32(K,4,0);
  set32(K,8,0);
  let v:i32=0;
  if(pol==2){
    v=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  } else {
    v=rr_ret_spec(L,S,A,ra,oa1,K,0,OUT,0,K,4,K,8);
  }
  set32(acc,0,get32(acc,0)+get32(K,8));
  set32(acc,8,get32(acc,8)+get32(K,4));
  set32(acc,12,get32(acc,12)+get32(K,0));
  set32(K,0,0);
  let g:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let so:i32=-1;
  if(v>0){ so=get32(OUT,4); }
  let go:i32=-1;
  if(g>0){ go=get32(OUTG,4); }
  if(ds_agree_ret(v,g,so,go)==1){ set32(acc,4,get32(acc,4)+1); }
  return;
}
// One sweep episode: T ticks, a drift every M ticks, one query every N
// ticks, drift before query at coincident ticks. pol 0=eager rebuilds
// after every drift; pol 1=lazy rebuilds only via the wrapper on refusal;
// pol 2=refuse never rebuilds.
fn ds_episode(B:[]u8,c:i32,M:i32,N:i32,pol:i32,ra:i32,oa1:i32)i32 {
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let acc:[]u8=z_alloc(32);
  let T:i32=256;
  rb_setup(A);
  set32(A,772,0);
  ret_log_rel(L,ra);
  et_specialize_ret(L,S,A,0,0);
  set32(acc,0,0);
  set32(acc,4,0);
  set32(acc,8,0);
  set32(acc,12,0);
  let drifts:i32=0;
  let queries:i32=0;
  let dc:i32=0;
  let qc:i32=0;
  let t:i32=0;
  while(t<T){
    if(dc==0){
      et_drift_unrelated(A);
      drifts=drifts+1;
      dc=M;
      if(pol==0){
        et_specialize_ret(L,S,A,0,0);
        set32(acc,0,get32(acc,0)+1);
      }
    }
    if(qc==0){
      queries=queries+1;
      qc=N;
      ds_query(L,S,A,ra,oa1,pol,K,OUT,OUTG,acc);
    }
    dc=dc-1;
    qc=qc-1;
    t=t+1;
  }
  c=ds_emit_cell(B,c,M,N,pol,drifts,queries,get32(acc,0),get32(acc,4),get32(acc,8),get32(acc,12));
  return c;
}

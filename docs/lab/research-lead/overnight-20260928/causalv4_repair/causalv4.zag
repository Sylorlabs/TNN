// causal3.zag — vocabulary-enriched causal learner for H-CAUSALV.
// Extends the competing-hypothesis machinery of causal_learn.zag with:
//   (a) condition language: per variable unconstrained or (op,value),
//       op in {EQ=0, LE=1, GT=2} over ordered ranges;
//   (b) two-phase split search: phase 1 single-variable equality +
//       threshold splits with a fewest-cells simplicity preference and
//       explicit ambiguity; phase 2 two-variable equality-conjunction
//       splits (only when phase 1 yields zero candidates);
//   (c) delayed-cause attribution: exact-state contradictions are first
//       tested against (cause action, delay d in {1,2}) explanations;
//       clean delay rules are created/supported WITHOUT opening a
//       law-change contest;
//   (d) probe history: H lines (context only, never learned); at each Q,
//       pending delay-rule effects are applied to the prediction.
// The learner contains NO tested world dynamics. Condition operators,
// delay machinery, and split search are the generic vocabulary.
// Pure Zag.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn parse_int(b:[]u8, p:i32, val:[]u8)i32 {
  while(p<b.len && (b[p] as i32)<=32){p=p+1;}
  let v:i32=0;
  while(p<b.len && b[p]>=48 && b[p]<=57){
    v=v*10+((b[p] as i32)-48); p=p+1;
  }
  set32(val,0,v);
  return p;
}

// ---- workspace layout ----
// episodes: S 0(3) A 768 NS 1024 ST 1792 SEQ 2048(1024) DX 3072(768) -> 3840
// entries:  A 3840 M 3904 CV 3968(192) OP 4160(192) ST 4352 AMB 4416
//           PAR 4480(256) NE 4736(256) EPS 4992(1024: 16 eps/entry)
//           FX 6016(192) FP 6208(192) SEQ 6400(256)
//           NCAND 6656 CAND 6720(1536) -> 8256
// contests: EN 8256 S 8272(64) NS 8336(192) SUP 8528(32) SEQ 8560(64)
//           RES 8624 WIN 8640 -> 8656
// delay rules: N 8656 CAUSE 8660(16) D 8676(16) VAR 8692(16) FX 8708(16)
//           FP 8724(16) ST 8740(16) SEQ 8756(64) SUP 8820(64) CS 8884(48) -> 8932
// H-CAUSALV4 R4: CS = creation cause context (state triple at seq-d), 3 bytes/rule
// candidates: N 8932 KIND 8936(8) V1 8944(8) P2 8952(8) CELLS 8960(8) -> 8968
fn O_EP_S()i32{return 0;} fn O_EP_A()i32{return 768;}
fn O_EP_NS()i32{return 1024;} fn O_EP_ST()i32{return 1792;}
fn O_EP_SEQ()i32{return 2048;} fn O_EP_DX()i32{return 3072;}
fn O_EN_A()i32{return 3840;} fn O_EN_M()i32{return 3904;}
fn O_EN_CV()i32{return 3968;} fn O_EN_OP()i32{return 4160;}
fn O_EN_ST()i32{return 4352;} fn O_EN_AMB()i32{return 4416;}
fn O_EN_PAR()i32{return 4480;} fn O_EN_NE()i32{return 4736;}
fn O_EN_EPS()i32{return 4992;} fn O_EN_FX()i32{return 6016;}
fn O_EN_FP()i32{return 6208;} fn O_EN_SEQ()i32{return 6400;}
fn O_EN_NCAND()i32{return 6656;} fn O_EN_CAND()i32{return 6720;}
fn O_CT_EN()i32{return 8256;} fn O_CT_S()i32{return 8272;}
fn O_CT_NS()i32{return 8336;} fn O_CT_SUP()i32{return 8528;}
fn O_CT_SEQ()i32{return 8560;} fn O_CT_RES()i32{return 8624;}
fn O_CT_WIN()i32{return 8640;}
fn O_DL_N()i32{return 8656;} fn O_DL_CAUSE()i32{return 8660;}
fn O_DL_D()i32{return 8676;} fn O_DL_VAR()i32{return 8692;}
fn O_DL_FX()i32{return 8708;} fn O_DL_FP()i32{return 8724;}
fn O_DL_ST()i32{return 8740;} fn O_DL_SEQ()i32{return 8756;}
fn O_DL_SUP()i32{return 8820;} fn O_DL_CS()i32{return 8884;}
fn O_CD_N()i32{return 8932;} fn O_CD_KIND()i32{return 8936;}
fn O_CD_V1()i32{return 8944;} fn O_CD_P2()i32{return 8952;}
fn O_CD_CELLS()i32{return 8960;}
fn O_NEP()i32{return 8968;} fn O_NENT()i32{return 8972;}
fn O_NCT()i32{return 8976;} fn O_NDL()i32{return 8980;}
fn WSZ()i32{return 8984;}

// condition operators
fn OP_EQ()i32{return 0;} fn OP_LE()i32{return 1;} fn OP_GT()i32{return 2;}
// candidate kinds
fn CK_EQ()i32{return 0;} fn CK_THR()i32{return 1;} fn CK_PAIR()i32{return 2;}
fn ST_ACT()i32{return 1;} fn ST_SUP()i32{return 2;}
fn ST_AMB()i32{return 3;} fn ST_CON()i32{return 4;}
// H-CAUSALV2 R1: provisional delay-rule status (unconfirmed correlational
// hint; inert on predictions until support>=2 promotes to ACTIVE)
fn ST_PROV()i32{return 5;}

// variable value ranges: s0 in {0,1,2}, s1 in {0,1}, s2 in {0,1}
fn vmax(v:i32)i32 {
  if(v==0){return 2;}
  return 1;
}
fn svar(s0:i32,s1:i32,s2:i32,v:i32)i32 {
  if(v==0){return s0;}
  if(v==1){return s1;}
  return s2;
}

// ---- episode accessors ----
fn ep_s(W:[]u8,e:i32,v:i32)i32{return W[O_EP_S()+e*3+v] as i32;}
fn ep_a(W:[]u8,e:i32)i32{return W[O_EP_A()+e] as i32;}
fn ep_ns(W:[]u8,e:i32,v:i32)i32{return W[O_EP_NS()+e*3+v] as i32;}
fn ep_seq(W:[]u8,e:i32)i32{return get32(W,O_EP_SEQ()+e*4);}
fn ep_dx(W:[]u8,e:i32,v:i32)i32{return W[O_EP_DX()+e*3+v] as i32;}
fn ep_dx_set(W:[]u8,e:i32,v:i32)void{W[O_EP_DX()+e*3+v]=1;return;}
fn ep_set(W:[]u8,e:i32,s0:i32,s1:i32,s2:i32,a:i32,ns0:i32,ns1:i32,ns2:i32,seq:i32)void{
  W[O_EP_S()+e*3]=s0 as u8; W[O_EP_S()+e*3+1]=s1 as u8; W[O_EP_S()+e*3+2]=s2 as u8;
  W[O_EP_A()+e]=a as u8;
  W[O_EP_NS()+e*3]=ns0 as u8; W[O_EP_NS()+e*3+1]=ns1 as u8; W[O_EP_NS()+e*3+2]=ns2 as u8;
  W[O_EP_ST()+e]=1;
  set32(W,O_EP_SEQ()+e*4,seq);
  return;
}
// ---- entry accessors ----
fn en_a(W:[]u8,i:i32)i32{return W[O_EN_A()+i] as i32;}
fn en_m(W:[]u8,i:i32)i32{return W[O_EN_M()+i] as i32;}
fn en_cv(W:[]u8,i:i32,v:i32)i32{return W[O_EN_CV()+i*3+v] as i32;}
fn en_op(W:[]u8,i:i32,v:i32)i32{return W[O_EN_OP()+i*3+v] as i32;}
fn en_st(W:[]u8,i:i32)i32{return W[O_EN_ST()+i] as i32;}
fn en_st_set(W:[]u8,i:i32,st:i32)void{W[O_EN_ST()+i]=st as u8;return;}
fn en_amb(W:[]u8,i:i32)i32{return W[O_EN_AMB()+i] as i32;}
fn en_amb_set(W:[]u8,i:i32,m:i32)void{W[O_EN_AMB()+i]=m as u8;return;}
fn en_par(W:[]u8,i:i32)i32{return get32(W,O_EN_PAR()+i*4);}
fn en_ne(W:[]u8,i:i32)i32{return get32(W,O_EN_NE()+i*4);}
fn en_eps(W:[]u8,i:i32,k:i32)i32{return W[O_EN_EPS()+i*16+k] as i32;}
fn en_fx(W:[]u8,i:i32,v:i32)i32{return W[O_EN_FX()+i*3+v] as i32;}
fn en_fp(W:[]u8,i:i32,v:i32)i32{return W[O_EN_FP()+i*3+v] as i32;}
fn en_seq(W:[]u8,i:i32)i32{return get32(W,O_EN_SEQ()+i*4);}
fn en_ncand(W:[]u8,i:i32)i32{return W[O_EN_NCAND()+i] as i32;}
fn en_cand(W:[]u8,i:i32,k:i32,f:i32)i32{return W[O_EN_CAND()+i*24+k*3+f] as i32;}
fn en_cand_set(W:[]u8,i:i32,k:i32,f:i32,v:i32)void{W[O_EN_CAND()+i*24+k*3+f]=v as u8;return;}
// ---- delay rule accessors ----
fn dl_cause(W:[]u8,r:i32)i32{return W[O_DL_CAUSE()+r] as i32;}
fn dl_d(W:[]u8,r:i32)i32{return W[O_DL_D()+r] as i32;}
fn dl_var(W:[]u8,r:i32)i32{return W[O_DL_VAR()+r] as i32;}
fn dl_fx(W:[]u8,r:i32)i32{return W[O_DL_FX()+r] as i32;}
fn dl_fp(W:[]u8,r:i32)i32{return W[O_DL_FP()+r] as i32;}
fn dl_st(W:[]u8,r:i32)i32{return W[O_DL_ST()+r] as i32;}
fn dl_sup(W:[]u8,r:i32)i32{return get32(W,O_DL_SUP()+r*4);}
// H-CAUSALV4 R4: creation cause context (state triple at seq-d), 3 bytes/rule
fn dl_cs(W:[]u8,r:i32,v:i32)i32{return W[O_DL_CS()+r*3+v] as i32;}
// ---- candidate accessors (workspace scratch) ----
fn cd_n(W:[]u8)i32{return get32(W,O_CD_N());}
fn cd_kind(W:[]u8,k:i32)i32{return W[O_CD_KIND()+k] as i32;}
fn cd_v1(W:[]u8,k:i32)i32{return W[O_CD_V1()+k] as i32;}
fn cd_p2(W:[]u8,k:i32)i32{return W[O_CD_P2()+k] as i32;}
fn cd_cells(W:[]u8,k:i32)i32{return W[O_CD_CELLS()+k] as i32;}
fn cd_clear(W:[]u8)void{set32(W,O_CD_N(),0);return;}
fn cd_add(W:[]u8,kind:i32,v1:i32,p2:i32,cells:i32)void{
  let n:i32=get32(W,O_CD_N());
  if(n>=8){return;}
  W[O_CD_KIND()+n]=kind as u8; W[O_CD_V1()+n]=v1 as u8;
  W[O_CD_P2()+n]=p2 as u8; W[O_CD_CELLS()+n]=cells as u8;
  set32(W,O_CD_N(),n+1);
  return;
}

// ---- effect codes (unchanged from H-CAUSAL) ----
fn fx_unch()i32{return 0;}
fn fx_set(c:i32)i32{return 10+c;}
fn fx_add(d:i32)i32{return 20+(d+2);}
fn fx_is_set(f:i32)i32{if(f>=10 && f<20){return 1;}return 0;}
fn fx_is_add(f:i32)i32{if(f>=20){return 1;}return 0;}
fn fx_c(f:i32)i32{return f-10;}
fn fx_d(f:i32)i32{return f-22;}

fn nep(W:[]u8)i32{return get32(W,O_NEP());}
fn nent(W:[]u8)i32{return get32(W,O_NENT());}
fn nct(W:[]u8)i32{return get32(W,O_NCT());}
fn ndl(W:[]u8)i32{return get32(W,O_NDL());}

// distinct values of variable v among episodes of entry i (skip delay-explained for that var)
fn group_vals(W:[]u8,i:i32,v:i32,vals:[]u8)i32{
  let nv:i32=0;
  let k:i32=0;
  let n:i32=en_ne(W,i);
  while(k<n){
    let e:i32=en_eps(W,i,k);
    if(ep_dx(W,e,v)==0){
      let x:i32=ep_s(W,e,v);
      let j:i32=0; let seen:i32=0;
      while(j<nv){if((vals[j] as i32)==x){seen=1;}j=j+1;}
      if(seen==0){vals[nv]=x as u8;nv=nv+1;}
    }
    k=k+1;
  }
  return nv;
}

// cell id: EQ(v) -> value; THR(v,t) -> 0=LE,1=GT; PAIR(v1,v2) -> a*4+b
fn in_cell(W:[]u8,e:i32,kind:i32,v1:i32,p2:i32,cell:i32)i32{
  if(kind==CK_EQ()){ return ep_s(W,e,v1)==cell; }
  if(kind==CK_THR()){
    let le:i32=0;
    if(ep_s(W,e,v1)<=p2){le=1;}
    if(cell==0){return le;}
    return 1-le;
  }
  let a:i32=ep_s(W,e,v1); let b:i32=ep_s(W,e,p2);
  if(a*4+b==cell){return 1;}
  return 0;
}

// bound a value to variable v's range
fn boundv(x:i32,v:i32)i32{
  if(x<0){return 0;}
  if(x>vmax(v)){return vmax(v);}
  return x;
}

// induced effect for (entry i, variable v); delay-explained episodes excluded.
// Semantics match H-CAUSAL exactly: UNCH if all nv==sv; else SET(sc) if all
// nv equal the first ns; else ADD(dd) if a single nonzero delta fits all
// (with bound); else UNRES. Out: fx, fp packed as fx*8+fp, or -1.
fn fx_codes(W:[]u8,i:i32,v:i32)i32{
  return fx_codes_f(W,i,v,-1,0,0,0);
}
// effect codes over entry i, variable v, restricted to a cell (fkind<0: no filter)
fn fx_codes_f(W:[]u8,i:i32,v:i32,fkind:i32,fv1:i32,fp2:i32,fcell:i32)i32{
  let unch:i32=1; let setc:i32=1; let sc:i32=0; let cnt:i32=0;
  let addv:[]u8=z_alloc(4);
  let ai:i32=0;
  while(ai<4){addv[ai]=1;ai=ai+1;}
  let k:i32=0;
  let n:i32=en_ne(W,i);
  while(k<n){
    let e:i32=en_eps(W,i,k);
    if(ep_dx(W,e,v)==0 && (fkind<0 || in_cell(W,e,fkind,fv1,fp2,fcell)!=0)){
      let sv:i32=ep_s(W,e,v); let nv2:i32=ep_ns(W,e,v);
      if(cnt==0){sc=nv2;}
      cnt=cnt+1;
      if(nv2!=sv){unch=0;}
      if(nv2!=sc){setc=0;}
      let dd:i32=-2; let sli:i32=0;
      while(dd<=2){
        if(dd!=0){
          if(nv2!=boundv(sv+dd,v)){addv[sli]=0;}
          sli=sli+1;
        }
        dd=dd+1;
      }
    }
    k=k+1;
  }
  if(cnt==0){return -1;}
  if(unch==1){return 0;}
  if(setc==1){let fx:i32=fx_set(sc);return fx*8+sc;}
  let dd2:i32=-2; let sli2:i32=0;
  while(dd2<=2){
    if(dd2!=0){
      if((addv[sli2] as i32)==1){
        let fx2:i32=fx_add(dd2);
        return fx2*8+(dd2+2);
      }
      sli2=sli2+1;
    }
    dd2=dd2+1;
  }
  return -1;
}

// condition match with operators
fn cond_matches(W:[]u8,i:i32,s0:i32,s1:i32,s2:i32)i32{
  let v:i32=0;
  while(v<3){
    if((en_m(W,i)&(1<<v))!=0){
      let sv:i32=svar(s0,s1,s2,v);
      let op:i32=en_op(W,i,v); let cv:i32=en_cv(W,i,v);
      if(op==OP_EQ()){ if(sv!=cv){return 0;} }
      else if(op==OP_LE()){ if(sv>cv){return 0;} }
      else { if(sv<=cv){return 0;} }
    }
    v=v+1;
  }
  return 1;
}

fn find_entry(W:[]u8,a:i32,m:i32,cm0:i32,cm1:i32,cm2:i32,op0:i32,op1:i32,op2:i32)i32{
  let i:i32=0;
  let n:i32=nent(W);
  while(i<n){
    if(en_a(W,i)==a && en_m(W,i)==m &&
       en_cv(W,i,0)==cm0 && en_cv(W,i,1)==cm1 && en_cv(W,i,2)==cm2 &&
       en_op(W,i,0)==op0 && en_op(W,i,1)==op1 && en_op(W,i,2)==op2){return i;}
    i=i+1;
  }
  return -1;
}

fn new_entry(W:[]u8,a:i32,m:i32,cm0:i32,cm1:i32,cm2:i32,op0:i32,op1:i32,op2:i32,par:i32,seq:i32)i32{
  let n:i32=nent(W);
  if(n>=64){return -1;}
  set32(W,O_NENT(),n+1);
  W[O_EN_A()+n]=a as u8; W[O_EN_M()+n]=m as u8;
  W[O_EN_CV()+n*3]=cm0 as u8; W[O_EN_CV()+n*3+1]=cm1 as u8; W[O_EN_CV()+n*3+2]=cm2 as u8;
  W[O_EN_OP()+n*3]=op0 as u8; W[O_EN_OP()+n*3+1]=op1 as u8; W[O_EN_OP()+n*3+2]=op2 as u8;
  W[O_EN_ST()+n]=ST_ACT() as u8;
  set32(W,O_EN_PAR()+n*4,par);
  set32(W,O_EN_NE()+n*4,0);
  set32(W,O_EN_SEQ()+n*4,seq);
  W[O_EN_NCAND()+n]=0;
  return n;
}

fn entry_add_ep(W:[]u8,i:i32,e:i32)void{
  let ne:i32=en_ne(W,i);
  if(ne<16){ W[O_EN_EPS()+i*16+ne]=e as u8; }
  set32(W,O_EN_NE()+i*4,ne+1);
  let v:i32=0;
  while(v<3){
    let c:i32=fx_codes(W,i,v);
    if(c>=0){
      W[O_EN_FX()+i*3+v]=(c/8) as u8;
      W[O_EN_FP()+i*3+v]=(c%8) as u8;
    } else {
      W[O_EN_FX()+i*3+v]=255;
    }
    v=v+1;
  }
  return;
}

// merge: sibling ACTIVE children of same parent with overlapping conds
fn try_merge(W:[]u8,par:i32)void{
  let i:i32=0;
  let n:i32=nent(W);
  while(i<n){
    if(en_st(W,i)==ST_ACT() && en_par(W,i)==par){
      let j:i32=i+1;
      while(j<n){
        if(en_st(W,j)==ST_ACT() && en_par(W,j)==par){
          // overlap test: for each var, cells overlap if either unconstrained
          // or both constrained with compatible (op,value)
          let v:i32=0; let ov:i32=1;
          while(v<3){
            let mi:i32=(en_m(W,i)>>v)&1; let mj:i32=(en_m(W,j)>>v)&1;
            if(mi!=0 && mj!=0){
              if(en_op(W,i,v)!=en_op(W,j,v) || en_cv(W,i,v)!=en_cv(W,j,v)){ov=0;}
            }
            v=v+1;
          }
          if(ov!=0){
            // same effects? merge j into i (keep coarser cond)
            let v2:i32=0; let same:i32=1;
            while(v2<3){
              if(en_fx(W,i,v2)!=en_fx(W,j,v2) || en_fp(W,i,v2)!=en_fp(W,j,v2)){same=0;}
              v2=v2+1;
            }
            if(same!=0){
              // drop the more specific one (higher mask popcount)
              let pi:i32=0; let pj:i32=0; let vv:i32=0;
              while(vv<3){pi=pi+((en_m(W,i)>>vv)&1);pj=pj+((en_m(W,j)>>vv)&1);vv=vv+1;}
              if(pj>=pi){en_st_set(W,j,ST_SUP());}else{en_st_set(W,i,ST_SUP());}
              return;
            }
          }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return;
}

// ---- contest machinery (unchanged semantics from H-CAUSAL) ----
fn ct_new(W:[]u8,e:i32,seq:i32)i32{
  let n:i32=nct(W);
  if(n>=16){return -1;}
  set32(W,O_NCT(),n+1);
  W[O_CT_EN()+n]=e as u8;
  let k:i32=0;
  while(k<3){
    W[O_CT_S()+n*4+k]=ep_s(W,e,k) as u8;
    W[O_CT_NS()+n*4+k]=ep_ns(W,e,k) as u8;
    k=k+1;
  }
  W[O_CT_SUP()+n*2]=1; W[O_CT_SUP()+n*2+1]=0;
  set32(W,O_CT_SEQ()+n*4,seq);
  W[O_CT_RES()+n]=0; W[O_CT_WIN()+n]=0;
  return n;
}
fn ct_old(W:[]u8,c:i32,e:i32)void{
  let k:i32=0;
  while(k<3){
    W[O_CT_S()+c*4+k]=ep_s(W,e,k) as u8;
    W[O_CT_NS()+c*4+k]=ep_ns(W,e,k) as u8;
    k=k+1;
  }
  return;
}
fn contest_open(W:[]u8,e:i32,seq:i32)void{
  let c:i32=ct_new(W,e,seq);
  if(c>=0){
    emit("# opened contest C"); e64(c); emit(" at seq "); e64(seq); emit("\n");
  }
  return;
}
// new episode e vs contest c: does e support old pattern (win=1) or new (win=0)?
fn contest_add(W:[]u8,c:i32,e:i32)void{
  let match_old:i32=1;
  let k:i32=0;
  while(k<3){
    if(ep_s(W,e,k)!=(W[O_CT_S()+c*4+k] as i32)){match_old=0;}
    k=k+1;
  }
  if(match_old==0){return;}
  let newlike:i32=1;
  k=0;
  while(k<3){
    if(ep_ns(W,e,k)!=(W[O_CT_NS()+c*4+k] as i32)){newlike=0;}
    k=k+1;
  }
  if(newlike!=0){
    W[O_CT_SUP()+c*2]=W[O_CT_SUP()+c*2]+1;
  } else {
    W[O_CT_SUP()+c*2+1]=W[O_CT_SUP()+c*2+1]+1;
  }
  return;
}
fn contest_resolve(W:[]u8,c:i32,seq:i32)void{
  let so:i32=W[O_CT_SUP()+c*2] as i32;
  let sn:i32=W[O_CT_SUP()+c*2+1] as i32;
  if(so+sn>=3){
    W[O_CT_RES()+c]=1;
    if(sn>so){W[O_CT_WIN()+c]=1;}else{W[O_CT_WIN()+c]=0;}
    emit("# contest C"); e64(c); emit(" resolved at seq "); e64(seq);
    emit(" old="); e64(so); emit(" new="); e64(sn);
    if(sn>so){emit(" NEW-LAW-WINS\n");}else{emit(" OLD-LAW-WINS\n");}
  }
  return;
}

// ---- cell machinery for split candidates ----
// enumerate nonempty cell ids for a candidate
fn cand_cellids(W:[]u8,i:i32,kind:i32,v1:i32,p2:i32,ids:[]u8)i32{
  let n:i32=0;
  if(kind==CK_EQ()){
    let vals:[]u8=z_alloc(4);
    let nv2:i32=group_vals(W,i,v1,vals);
    let q:i32=0;
    while(q<nv2){ids[q]=vals[q];q=q+1;}
    return nv2;
  }
  if(kind==CK_THR()){ ids[0]=0; ids[1]=1; return 2; }
  // PAIR: distinct combos
  let k:i32=0; let ne:i32=en_ne(W,i);
  while(k<ne){
    let e:i32=en_eps(W,i,k);
    if(ep_dx(W,e,v1)==0 && ep_dx(W,e,p2)==0){
      let c:i32=ep_s(W,e,v1)*4+ep_s(W,e,p2);
      let j:i32=0; let seen:i32=0;
      while(j<n){if((ids[j] as i32)==c){seen=1;}j=j+1;}
      if(seen==0){ids[n]=c as u8;n=n+1;}
    }
    k=k+1;
  }
  return n;
}
// does candidate (kind,v1,p2) resolve entry i? returns ncells or 0
fn cand_resolves(W:[]u8,i:i32,kind:i32,v1:i32,p2:i32)i32{
  let ids:[]u8=z_alloc(16);
  let nc:i32=cand_cellids(W,i,kind,v1,p2,ids);
  if(nc<2){return 0;}
  let q:i32=0;
  while(q<nc){
    let v:i32=0; let ok:i32=1;
    while(v<3){
      if(fx_codes_f(W,i,v,kind,v1,p2,ids[q] as i32)<0){ok=0;}
      v=v+1;
    }
    if(ok==0){return 0;}
    q=q+1;
  }
  return nc;
}

// ---- split application ----
fn child_cond_emit(W:[]u8,i:i32)void{
  emit("cond=[");
  let v:i32=0; let first:i32=1;
  while(v<3){
    if((en_m(W,i)&(1<<v))!=0){
      if(first==0){emit(",");}
      emit("s"); e64(v);
      let op:i32=en_op(W,i,v);
      if(op==OP_EQ()){emit("==");}else if(op==OP_LE()){emit("<=");}else{emit(">");}
      e64(en_cv(W,i,v));
      first=0;
    }
    v=v+1;
  }
  emit("]");
  return;
}
fn apply_cand(W:[]u8,i:i32,kind:i32,v1:i32,p2:i32,seq:i32)void{
  let ids:[]u8=z_alloc(16);
  let nc:i32=cand_cellids(W,i,kind,v1,p2,ids);
  if(kind==CK_EQ()){emit("# SPLIT entry ");e64(i);emit(" by s");e64(v1);emit(" equality into ");e64(nc);emit("\n");}
  else if(kind==CK_THR()){emit("# SPLIT-THR entry ");e64(i);emit(" by s");e64(v1);emit(" threshold ");e64(p2);emit(" into 2\n");}
  else{emit("# SPLIT-CONJ entry ");e64(i);emit(" by (s");e64(v1);emit(",s");e64(p2);emit(") pair into ");e64(nc);emit("\n");}
  let q:i32=0;
  while(q<nc){
    let cell:i32=ids[q] as i32;
    let m:i32=en_m(W,i);
    let c0:i32=en_cv(W,i,0); let c1:i32=en_cv(W,i,1); let c2:i32=en_cv(W,i,2);
    let o0:i32=en_op(W,i,0); let o1:i32=en_op(W,i,1); let o2:i32=en_op(W,i,2);
    if(kind==CK_EQ()){
      m=m|(1<<v1);
      if(v1==0){c0=cell;o0=OP_EQ();}else if(v1==1){c1=cell;o1=OP_EQ();}else{c2=cell;o2=OP_EQ();}
    } else if(kind==CK_THR()){
      m=m|(1<<v1);
      if(cell==0){
        if(v1==0){c0=p2;o0=OP_LE();}else if(v1==1){c1=p2;o1=OP_LE();}else{c2=p2;o2=OP_LE();}
      } else {
        if(v1==0){c0=p2;o0=OP_GT();}else if(v1==1){c1=p2;o1=OP_GT();}else{c2=p2;o2=OP_GT();}
      }
    } else {
      let a:i32=cell/4; let b:i32=cell%4;
      m=m|(1<<v1)|(1<<p2);
      if(v1==0){c0=a;o0=OP_EQ();}else if(v1==1){c1=a;o1=OP_EQ();}else{c2=a;o2=OP_EQ();}
      if(p2==0){c0=b;o0=OP_EQ();}else if(p2==1){c1=b;o1=OP_EQ();}else{c2=b;o2=OP_EQ();}
    }
    let ch:i32=new_entry(W,en_a(W,i),m,c0,c1,c2,o0,o1,o2,i,seq);
    if(ch>=0){
      let k:i32=0; let ne:i32=en_ne(W,i);
      while(k<ne){
        let e:i32=en_eps(W,i,k);
        if(in_cell(W,e,kind,v1,p2,cell)!=0){ entry_add_ep(W,ch,e); }
        k=k+1;
      }
      emit("# ENTRY "); e64(ch); emit(" a="); e64(en_a(W,ch)); emit(" ");
      child_cond_emit(W,ch);
      emit(" fx=["); e64(en_fx(W,ch,0)); emit(","); e64(en_fx(W,ch,1)); emit(","); e64(en_fx(W,ch,2)); emit("]\n");
    }
    q=q+1;
  }
  en_st_set(W,i,ST_SUP());
  emit("# entry "); e64(i); emit(" SUPERSEDED by split\n");
  try_merge(W,i);
  return;
}

// ---- two-phase split search ----
fn split_search(W:[]u8,i:i32,seq:i32)void{
  cd_clear(W);
  // Phase 1: single-variable THR + EQ candidates.
  // H-CAUSALV3 R2: no tie-break. Tied candidates generalize differently
  // to unseen values (X-CV2-2 proved the fiat harm-capable), so ties
  // become AMBIGUOUS over all tied minima instead of resolving by
  // enumeration fiat. A wrong candidate is refuted by later evidence
  // via amb_update like any candidate.
  let v:i32=0;
  while(v<3){
    if((en_m(W,i)&(1<<v))==0){
      if(vmax(v)>1){
        let t:i32=0;
        while(t<vmax(v)){
          let nc2:i32=cand_resolves(W,i,CK_THR(),v,t);
          if(nc2>0){cd_add(W,CK_THR(),v,t,nc2);}
          t=t+1;
        }
      }
      let vals:[]u8=z_alloc(4);
      let nvv:i32=group_vals(W,i,v,vals);
      if(nvv>=2){
        let nc:i32=cand_resolves(W,i,CK_EQ(),v,0);
        if(nc>0){cd_add(W,CK_EQ(),v,0,nc);}
      }
    }
    v=v+1;
  }
  // H-CAUSALV3 R2: minimum-collection, no enumeration fiat. Per
  // variable, collect ALL candidates achieving the minimum cell count.
  // A unique minimum on a single variable applies; any tie (within a
  // variable, or across variables) becomes AMBIGUOUS over the tied
  // minima. Enumeration order is provably irrelevant: every tied
  // minimum is collected regardless of order.
  let bmin:[]u8=z_alloc(3);
  v=0; while(v<3){bmin[v]=255;v=v+1;}
  let k:i32=0; let ncd:i32=cd_n(W);
  while(k<ncd){
    let vv2:i32=cd_v1(W,k); let cc:i32=cd_cells(W,k);
    if(cc<(bmin[vv2] as i32)){bmin[vv2]=cc as u8;}
    k=k+1;
  }
  let nvars:i32=0; let thevar:i32=0; let ntied:i32=0;
  v=0;
  while(v<3){
    if((bmin[v] as i32)!=255){
      nvars=nvars+1; thevar=v;
      k=0;
      while(k<ncd){
        if(cd_v1(W,k)==v && cd_cells(W,k)==(bmin[v] as i32)){ntied=ntied+1;}
        k=k+1;
      }
    }
    v=v+1;
  }
  if(nvars==1 && ntied==1){
    k=0;
    while(k<ncd){
      if(cd_v1(W,k)==thevar && cd_cells(W,k)==(bmin[thevar] as i32)){
        apply_cand(W,i,cd_kind(W,k),cd_v1(W,k),cd_p2(W,k),seq);
        return;
      }
      k=k+1;
    }
    return;
  }
  if(nvars>=1){
    // AMBIGUOUS over all tied minima (within-variable ties and/or
    // multi-variable). Cap at 8 candidate slots; warn if exceeded.
    en_st_set(W,i,ST_AMB());
    let nst:i32=0; let tiedw:i32=0;
    v=0;
    while(v<3){
      if((bmin[v] as i32)!=255){
        let nv2c:i32=0;
        k=0;
        while(k<ncd){
          if(cd_v1(W,k)==v && cd_cells(W,k)==(bmin[v] as i32)){
            nv2c=nv2c+1;
            if(nst<8){
              en_cand_set(W,i,nst,0,cd_kind(W,k));
              en_cand_set(W,i,nst,1,cd_v1(W,k));
              en_cand_set(W,i,nst,2,cd_p2(W,k));
              nst=nst+1;
            }
          }
          k=k+1;
        }
        if(nv2c>1){tiedw=1;}
        if(nv2c>8){
          emit("# WARN candidate cap 8: "); e64(nv2c);
          emit(" tied minima on s"); e64(v); emit(", storing 8\n");
        }
      }
      v=v+1;
    }
    W[O_EN_NCAND()+i]=nst as u8;
    emit("# entry "); e64(i); emit(" AMBIGUOUS over "); e64(nst);
    if(tiedw!=0 || nvars==1){
      emit(" tied candidates (no fiat split)\n");
    } else {
      emit(" candidates\n");
    }
    return;
  }
  // nvars==0: fall through to Phase 2
  // Phase 2: two-variable equality-conjunction splits (only if phase 1 found nothing)
  cd_clear(W);
  let v1:i32=0;
  while(v1<3){
    let v2:i32=v1+1;
    while(v2<3){
      if(((en_m(W,i)&(1<<v1))==0) && ((en_m(W,i)&(1<<v2))==0)){
        let va:[]u8=z_alloc(4); let vb:[]u8=z_alloc(4);
        if(group_vals(W,i,v1,va)>=2 && group_vals(W,i,v2,vb)>=2){
          let nc3:i32=cand_resolves(W,i,CK_PAIR(),v1,v2);
          if(nc3>0){cd_add(W,CK_PAIR(),v1,v2,nc3);}
        }
      }
      v2=v2+1;
    }
    v1=v1+1;
  }
  let np2:i32=cd_n(W);
  if(np2==1){
    apply_cand(W,i,cd_kind(W,0),cd_v1(W,0),cd_p2(W,0),seq);
    return;
  }
  if(np2>1){
    en_st_set(W,i,ST_AMB());
    let q2:i32=0;
    while(q2<np2){
      en_cand_set(W,i,q2,0,cd_kind(W,q2));
      en_cand_set(W,i,q2,1,cd_v1(W,q2));
      en_cand_set(W,i,q2,2,cd_p2(W,q2));
      q2=q2+1;
    }
    W[O_EN_NCAND()+i]=np2 as u8;
    emit("# entry "); e64(i); emit(" AMBIGUOUS over "); e64(np2); emit(" pair candidates\n");
    return;
  }
  en_st_set(W,i,ST_CON());
  emit("# entry "); e64(i); emit(" CONFLICTED: no resolving split\n");
  return;
}

fn amb_update(W:[]u8,i:i32,e:i32,seq:i32)void{
  entry_add_ep(W,i,e);
  let nc:i32=en_ncand(W,i);
  let sk:[]u8=z_alloc(8); let sv:[]u8=z_alloc(8); let sp:[]u8=z_alloc(8);
  let ns:i32=0;
  let k:i32=0;
  while(k<nc){
    let kind:i32=en_cand(W,i,k,0); let v1:i32=en_cand(W,i,k,1); let p2:i32=en_cand(W,i,k,2);
    if(cand_resolves(W,i,kind,v1,p2)>0){
      sk[ns]=kind as u8; sv[ns]=v1 as u8; sp[ns]=p2 as u8; ns=ns+1;
    } else {
      emit("# refuted candidate kind="); e64(kind); emit(" v="); e64(v1); emit("\n");
    }
    k=k+1;
  }
  if(ns==1){
    emit("# ambiguity resolved: applying survivor\n");
    en_st_set(W,i,ST_ACT());
    W[O_EN_NCAND()+i]=0;
    apply_cand(W,i,sk[0] as i32,sv[0] as i32,sp[0] as i32,seq);
    return;
  }
  if(ns==0){
    en_st_set(W,i,ST_CON());
    emit("# entry "); e64(i); emit(" CONFLICTED: all candidates refuted\n");
    return;
  }
  let q:i32=0;
  while(q<ns){
    en_cand_set(W,i,q,0,sk[q] as i32);
    en_cand_set(W,i,q,1,sv[q] as i32);
    en_cand_set(W,i,q,2,sp[q] as i32);
    q=q+1;
  }
  W[O_EN_NCAND()+i]=ns as u8;
  emit("# entry "); e64(i); emit(" still AMBIGUOUS over "); e64(ns); emit("\n");
  return;
}

// ---- delayed-cause attribution ----
fn obs_action_at(W:[]u8,seq:i32)i32{
  let f:i32=0; let n:i32=nep(W);
  while(f<n){
    if(ep_seq(W,f)==seq){return ep_a(W,f);}
    f=f+1;
  }
  return -1;
}
// is (cause action xa, delay d) a clean explanation of e's flip on var v?
// Scope: ALL episodes with the same action as e (global over the action),
// not just the current entry. The delay rule is a claim about the action's
// delayed effect, so the confounder test must see every instance of the
// carrier action, including episodes partitioned into other entries by
// splits. (Prereg: "every positive episode" / "no negative episode".)
// H-CAUSALV3 R1a: a delayed cause must explain a genuine change
// (ep_ns != ep_s). Stasis is not an effect the SET(nv) representation can
// attribute; a stasis contradiction (entry predicted change, observed
// stasis) belongs to the contest machinery, not delay attribution.
fn delay_clean(W:[]u8,i:i32,e:i32,v:i32,d:i32,xa:i32)i32{
  if(ep_ns(W,e,v)==ep_s(W,e,v)){return 0;}
  if(ep_seq(W,e)<=d){return 0;}
  if(obs_action_at(W,ep_seq(W,e)-d)!=xa){return 0;}
  let pos:i32=1;
  let f:i32=0; let n:i32=nep(W);
  while(f<n){
    if(f!=e && ep_a(W,f)==ep_a(W,e) && ep_seq(W,f)>d){
      let ha:i32=obs_action_at(W,ep_seq(W,f)-d);
      if(ep_ns(W,f,v)==ep_ns(W,e,v)){
        pos=pos+1;
        if(ha!=xa){return 0;}
      } else {
        if(ha==xa){return 0;}
      }
    }
    f=f+1;
  }
  if(pos<1){return 0;}
  return 1;
}
// H-CAUSALV2 R1: two-tier delay rules. A newly created rule starts
// PROVISIONAL (unconfirmed correlational hint; inert on predictions).
// The second supporting episode promotes it to ACTIVE. The match scan
// accepts both PROVISIONAL and ACTIVE so a provisional rule can be
// confirmed rather than duplicated. Contest suppression behavior is
// unchanged: an explained variable (provisional or active) opens no
// contest. Rationale: at support=1 a genuine delay and a positioned
// confounder are indistinguishable; the safe posture records the hint
// without acting on it. Genuine delays repeat; confounders do not.
// H-CAUSALV3 R1b: the support-match key is (cause, delay, var, outcome).
// A supporting episode must show the rule's recorded outcome (dl_fp);
// a different outcome does not confirm but creates a separate
// PROVISIONAL rule (competing hypothesis) via the creation path below.
// H-CAUSALV4 R4: fetch the state triple of the episode at sequence cseq
// (the background context in which a delayed cause was observed).
// Returns 1 and fills out[0..2] if found, 0 otherwise.
fn cause_state_at(W:[]u8,cseq:i32,out:[]u8)i32{
  let f:i32=0; let n:i32=nep(W);
  while(f<n){
    if(ep_seq(W,f)==cseq){
      out[0]=ep_s(W,f,0) as u8; out[1]=ep_s(W,f,1) as u8; out[2]=ep_s(W,f,2) as u8;
      return 1;
    }
    f=f+1;
  }
  return 0;
}
fn dl_add_or_support(W:[]u8,xa:i32,d:i32,v:i32,nv:i32,seq:i32)i32{
  let r:i32=0; let n:i32=ndl(W);
  while(r<n){
    if(dl_cause(W,r)==xa && dl_d(W,r)==d && dl_var(W,r)==v && dl_fp(W,r)==nv && (dl_st(W,r)==ST_ACT() || dl_st(W,r)==ST_PROV())){
      let s:i32=dl_sup(W,r);
      set32(W,O_DL_SUP()+r*4,s+1);
      if(s<16){set32(W,O_DL_SEQ()+r*4+s,seq);}
      if(dl_st(W,r)==ST_PROV() && s+1>=2){
        // H-CAUSALV4 R4: promotion requires cause-context diversity.
        // The confirming support's cause context (state at seq-d) must
        // differ from the creation context in at least one coordinate.
        // A repeated positioned confounder in an identical background
        // state does not confirm; the rule stays PROVISIONAL (inert).
        let ctx:[]u8=z_alloc(4);
        let div:i32=0;
        if(cause_state_at(W,seq-d,ctx)!=0){
          if((ctx[0] as i32)!=dl_cs(W,r,0) || (ctx[1] as i32)!=dl_cs(W,r,1) || (ctx[2] as i32)!=dl_cs(W,r,2)){
            div=1;
          }
        }
        if(div!=0){
          W[O_DL_ST()+r]=ST_ACT() as u8;
          emit("# delay rule R"); e64(r); emit(" CONFIRMED at seq "); e64(seq);
          emit(" support="); e64(s+1); emit(" (provisional -> active)\n");
        } else {
          emit("# delay rule R"); e64(r); emit(" supported at seq "); e64(seq);
          emit(" support="); e64(s+1); emit("\n");
          emit("# delay rule R"); e64(r); emit(" NOT CONFIRMED at seq "); e64(seq);
          emit(": cause context identical to creation; remains PROVISIONAL\n");
        }
      } else {
        emit("# delay rule R"); e64(r); emit(" supported at seq "); e64(seq);
        emit(" support="); e64(s+1); emit("\n");
      }
      return r;
    }
    r=r+1;
  }
  if(n>=16){return -1;}
  set32(W,O_NDL(),n+1);
  W[O_DL_CAUSE()+n]=xa as u8; W[O_DL_D()+n]=d as u8; W[O_DL_VAR()+n]=v as u8;
  W[O_DL_FX()+n]=fx_set(nv) as u8; W[O_DL_FP()+n]=nv as u8;
  W[O_DL_ST()+n]=ST_PROV() as u8;
  // H-CAUSALV4 R4: record the creation cause context (state at seq-d).
  // delay_clean already verified the cause episode exists.
  let cctx:[]u8=z_alloc(4);
  if(cause_state_at(W,seq-d,cctx)!=0){
    W[O_DL_CS()+n*3]=cctx[0]; W[O_DL_CS()+n*3+1]=cctx[1]; W[O_DL_CS()+n*3+2]=cctx[2];
  } else {
    W[O_DL_CS()+n*3]=255 as u8; W[O_DL_CS()+n*3+1]=255 as u8; W[O_DL_CS()+n*3+2]=255 as u8;
  }
  set32(W,O_DL_SEQ()+n*4,seq);
  set32(W,O_DL_SUP()+n*4,1);
  emit("# PROVISIONAL-DELAY-RULE R"); e64(n); emit(": cause a="); e64(xa);
  emit(" d="); e64(d); emit(" -> s"); e64(v); emit(" SET("); e64(nv);
  emit(") support=1 (unconfirmed)\n");
  return n;
}
// try to explain contrad vars via delayed causes; returns explained bitmask
fn delay_attribution(W:[]u8,i:i32,e:i32,seq:i32,contrad:i32)i32{
  let exp:i32=0;
  let v:i32=0;
  while(v<3){
    if((contrad&(1<<v))!=0){
      let d:i32=1; let done:i32=0;
      while(d<=2 && done==0){
        let xa:i32=0;
        while(xa<5 && done==0){
          if(delay_clean(W,i,e,v,d,xa)!=0){
            let r:i32=dl_add_or_support(W,xa,d,v,ep_ns(W,e,v),seq);
            ep_dx_set(W,e,v);
            exp=exp|(1<<v);
            emit("# delay-attributed var s"); e64(v); emit(" of seq "); e64(seq);
            emit(" to R"); e64(r); emit("\n");
            done=1;
          }
          xa=xa+1;
        }
        d=d+1;
      }
    }
    v=v+1;
  }
  return exp;
}

// ---- learning ----
// route a new episode to the most specific ACTIVE entry matching (s,a);
// if none matches and the default entry is superseded (partitioned),
// extend the partition with a new child for this state combination.
fn extend_partition(W:[]u8,par:i32,a:i32,s0:i32,s1:i32,s2:i32,seq:i32)i32{
  let m:i32=0;
  let e2:i32=0; let n2:i32=nent(W);
  while(e2<n2){
    if(en_st(W,e2)==ST_ACT() && en_par(W,e2)==par){m=en_m(W,e2);}
    e2=e2+1;
  }
  let c0:i32=0; let c1:i32=0; let c2:i32=0;
  let o0:i32=0; let o1:i32=0; let o2:i32=0;
  if((m&1)!=0){c0=s0;o0=OP_EQ();}
  if((m&2)!=0){c1=s1;o1=OP_EQ();}
  if((m&4)!=0){c2=s2;o2=OP_EQ();}
  let ch:i32=new_entry(W,a,m,c0,c1,c2,o0,o1,o2,par,seq);
  if(ch>=0){
    emit("# PARTITION-EXTEND entry "); e64(ch); emit(" under parent "); e64(par); emit(" ");
    child_cond_emit(W,ch); emit("\n");
  }
  return ch;
}

fn learn_episode(W:[]u8,s0:i32,s1:i32,s2:i32,a:i32,ns0:i32,ns1:i32,ns2:i32,seq:i32)void{
  let ne2:i32=nep(W);
  if(ne2>=256){return;}
  set32(W,O_NEP(),ne2+1);
  ep_set(W,ne2,s0,s1,s2,a,ns0,ns1,ns2,seq);
  let c:i32=0; let nc:i32=nct(W);
  while(c<nc){
    if(W[O_CT_RES()+c]==0){contest_add(W,c,ne2);}
    c=c+1;
  }
  c=0;
  while(c<nc){
    if(W[O_CT_RES()+c]==0){contest_resolve(W,c,seq);}
    c=c+1;
  }
  // Route to the most specific ACTIVE or AMBIGUOUS entry matching (s,a).
  // AMBIGUOUS entries must be found (not skipped) so new evidence refines
  // the ambiguity via amb_update instead of forking a spurious entry.
  let i:i32=-1;
  let bestm:i32=-1;
  let re:i32=0; let rn:i32=nent(W);
  while(re<rn){
    let rst:i32=en_st(W,re);
    if((rst==ST_ACT() || rst==ST_AMB()) && en_a(W,re)==a && cond_matches(W,re,s0,s1,s2)!=0){
      let mm:i32=en_m(W,re); let pc:i32=0;
      if((mm&1)!=0){pc=pc+1;} if((mm&2)!=0){pc=pc+1;} if((mm&4)!=0){pc=pc+1;}
      if(pc>bestm){bestm=pc;i=re;}
    }
    re=re+1;
  }
  if(i<0){
    let def:i32=find_entry(W,a,0,0,0,0,0,0,0);
    if(def<0){
      i=new_entry(W,a,0,0,0,0,0,0,0,-1,seq);
    } else if(en_st(W,def)==ST_ACT() || en_st(W,def)==ST_AMB()){
      i=def;
    } else {
      i=extend_partition(W,def,a,s0,s1,s2,seq);
    }
  }
  if(i<0){return;}
  if(en_st(W,i)==ST_AMB()){amb_update(W,i,ne2,seq);return;}
  // exact-state contradiction scan (per variable)
  let contrad:i32=0;
  let k:i32=0; let nn:i32=en_ne(W,i);
  while(k<nn){
    let f:i32=en_eps(W,i,k);
    if(ep_s(W,f,0)==s0 && ep_s(W,f,1)==s1 && ep_s(W,f,2)==s2){
      let v:i32=0;
      while(v<3){
        if(ep_ns(W,f,v)!=svar(ns0,ns1,ns2,v)){contrad=contrad|(1<<v);}
        v=v+1;
      }
    }
    k=k+1;
  }
  // delayed-cause attribution preempts contest opening on explained vars
  let explained:i32=0;
  if(contrad!=0){explained=delay_attribution(W,i,ne2,seq,contrad);}
  // explained is always a subset of contrad (3-bit); clear those bits
  let rem:i32=contrad&(7-explained);
  entry_add_ep(W,i,ne2);
  let unres:i32=0;
  let v2:i32=0;
  while(v2<3){if(en_fx(W,i,v2)==255){unres=1;}v2=v2+1;}
  if(unres!=0){split_search(W,i,seq);}
  else if(rem!=0){contest_open(W,ne2,seq);}
  return;
}

// predict under a single split candidate (for ambiguity agreement checks)
// returns 1 and fills out if the query state falls in a nonempty resolved cell
fn pred_under_cand(W:[]u8,i:i32,kind:i32,v1:i32,p2:i32,s0:i32,s1:i32,s2:i32,out:[]u8)i32{
  let cell:i32=-1;
  if(kind==CK_EQ()){ cell=svar(s0,s1,s2,v1); }
  else if(kind==CK_THR()){
    if(svar(s0,s1,s2,v1)<=p2){cell=0;}else{cell=1;}
  } else {
    cell=svar(s0,s1,s2,v1)*4+svar(s0,s1,s2,p2);
  }
  // cell must be nonempty
  let k:i32=0; let n:i32=en_ne(W,i); let nn:i32=0;
  while(k<n){
    let e:i32=en_eps(W,i,k);
    if(in_cell(W,e,kind,v1,p2,cell)!=0){nn=nn+1;}
    k=k+1;
  }
  if(nn==0){return 0;}
  let v:i32=0;
  while(v<3){
    let c:i32=fx_codes_f(W,i,v,kind,v1,p2,cell);
    if(c<0){return 0;}
    let fx:i32=c/8; let fp:i32=c%8;
    let sv:i32=svar(s0,s1,s2,v);
    let nv2:i32=sv;
    if(fx==0){nv2=sv;}
    else if(fx_is_set(fx)!=0){nv2=fx_c(fx);}
    else if(fx_is_add(fx)!=0){
      nv2=boundv(sv+fx_d(fx),v);
    }
    out[v]=nv2 as u8;
    v=v+1;
  }
  return 1;
}

// ---- prediction ----
// returns 1 with out filled, or 0 for WITHHOLD (ambiguity disagreement)
fn predict_entry(W:[]u8,a:i32,s0:i32,s1:i32,s2:i32,out:[]u8)i32{
  let best:i32=-1; let bestm:i32=-1;
  let i:i32=0; let n:i32=nent(W);
  while(i<n){
    let rst:i32=en_st(W,i);
    if((rst==ST_ACT() || rst==ST_AMB()) && en_a(W,i)==a && cond_matches(W,i,s0,s1,s2)!=0){
      let m:i32=en_m(W,i); let pc:i32=0;
      if((m&1)!=0){pc=pc+1;} if((m&2)!=0){pc=pc+1;} if((m&4)!=0){pc=pc+1;}
      if(pc>bestm){bestm=pc;best=i;}
    }
    i=i+1;
  }
  if(best<0){
    out[0]=s0 as u8; out[1]=s1 as u8; out[2]=s2 as u8;
    return 1;
  }
  if(en_st(W,best)==ST_AMB()){
    // agreed-under-ambiguity (H-CAUSALV3 AMEND1): a candidate that
    // cannot cover the query abstains rather than vetoing; all
    // covering candidates must predict identically, else WITHHOLD.
    let nc:i32=en_ncand(W,best);
    if(nc<1){return 0;}
    let tmp:[]u8=z_alloc(4);
    let k:i32=0;
    let ok:i32=1;
    let npred:i32=0;
    while(k<nc){
      let pc:i32=pred_under_cand(W,best,en_cand(W,best,k,0),en_cand(W,best,k,1),en_cand(W,best,k,2),s0,s1,s2,tmp);
      if(pc==0){
        // abstain: no opinion, no veto
      } else {
        npred=npred+1;
        if(npred>1){
          if((tmp[0] as i32)!=(out[0] as i32) || (tmp[1] as i32)!=(out[1] as i32) || (tmp[2] as i32)!=(out[2] as i32)){ok=0;}
        } else {
          out[0]=tmp[0];out[1]=tmp[1];out[2]=tmp[2];
        }
      }
      k=k+1;
    }
    if(npred<1){return 0;}
    if(ok==0){return 0;}
    return 1;
  }
  let v:i32=0;
  while(v<3){
    let fx:i32=en_fx(W,best,v); let fp:i32=en_fp(W,best,v);
    let sv:i32=svar(s0,s1,s2,v);
    let nv2:i32=sv;
    if(fx==0){nv2=sv;}
    else if(fx_is_set(fx)!=0){nv2=fx_c(fx);}
    else if(fx_is_add(fx)!=0){nv2=boundv(sv+fx_d(fx),v);}
    out[v]=nv2 as u8;
    v=v+1;
  }
  return 1;
}

// ---- provenance ----
fn emit_fx(W:[]u8,fx:i32,fp:i32)void{
  if(fx==255){emit("UNRES");}
  else if(fx==0){emit("UNCH");}
  else if(fx_is_set(fx)!=0){emit("SET(");e64(fx_c(fx));emit(")");}
  else if(fx_is_add(fx)!=0){emit("ADD(");e64(fx_d(fx));emit(")");}
  else{emit("?");}
  return;
}
fn emit_entry(W:[]u8,i:i32)void{
  emit("# ENTRY "); e64(i); emit(" a="); e64(en_a(W,i)); emit(" ");
  child_cond_emit(W,i);
  emit(" st="); e64(en_st(W,i));
  emit(" fx=[");
  let v:i32=0;
  while(v<3){
    if(v>0){emit(",");}
    emit_fx(W,en_fx(W,i,v),en_fp(W,i,v));
    v=v+1;
  }
  emit("] par="); e64(en_par(W,i)); emit(" ne="); e64(en_ne(W,i));
  if(en_st(W,i)==ST_AMB()){
    emit(" CAND=[");
    let k:i32=0; let nc:i32=en_ncand(W,i);
    while(k<nc){
      if(k>0){emit(",");}
      let kind:i32=en_cand(W,i,k,0);
      if(kind==CK_EQ()){emit("EQ s");e64(en_cand(W,i,k,1));}
      else if(kind==CK_THR()){emit("THR s");e64(en_cand(W,i,k,1));emit("<=");e64(en_cand(W,i,k,2));}
      else{emit("PAIR s");e64(en_cand(W,i,k,1));emit(",s");e64(en_cand(W,i,k,2));}
      k=k+1;
    }
    emit("]");
  }
  emit("\n");
  return;
}
fn emit_dl(W:[]u8)void{
  emit("# DELAY RULES\n");
  let r:i32=0; let n:i32=ndl(W);
  while(r<n){
    emit("# DL R"); e64(r); emit(" cause="); e64(dl_cause(W,r));
    emit(" d="); e64(dl_d(W,r)); emit(" var=s"); e64(dl_var(W,r));
    emit(" fx="); emit_fx(W,dl_fx(W,r),dl_fp(W,r));
    // H-CAUSALV2 R1: honest status label (PROV = unconfirmed, inert)
    let stv:i32=dl_st(W,r);
    if(stv==ST_PROV()){emit(" st=PROV");}
    else if(stv==ST_ACT()){emit(" st=ACT");}
    else{emit(" st="); e64(stv);}
    emit(" support="); e64(dl_sup(W,r)); emit("\n");
    r=r+1;
  }
  return;
}

// ---- probe runner (H lines are context only, never learned) ----
fn run_probe(W:[]u8,prbp:[]u8)void{
  let data:[]u8=_zag_read_file(prbp);
  let hs0:[]u8=z_alloc(32); let hs1:[]u8=z_alloc(32);
  let hs2:[]u8=z_alloc(32); let ha:[]u8=z_alloc(32);
  let nh:i32=0;
  let p:i32=0;
  let pv:[]u8=z_alloc(4);
  let out:[]u8=z_alloc(4);
  while(p<data.len){
    while(p<data.len && (data[p] as i32)<=32){p=p+1;}
    if(p>=data.len){break;}
    if((data[p] as i32)==35){while(p<data.len && data[p]!=10){p=p+1;}continue;}
    let isH:i32=0;
    if((data[p] as i32)==72){isH=1;}
    if((data[p] as i32)!=81 && isH==0){while(p<data.len && data[p]!=10){p=p+1;}continue;}
    p=p+1;
    p=parse_int(data,p,pv); let t:i32=get32(pv,0);
    p=parse_int(data,p,pv); let pr:i32=get32(pv,0);
    p=parse_int(data,p,pv); let l:i32=get32(pv,0);
    while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
    p=parse_int(data,p,pv); let a:i32=get32(pv,0);
    if(isH!=0){
      if(nh<32){
        hs0[nh]=t as u8; hs1[nh]=pr as u8; hs2[nh]=l as u8; ha[nh]=a as u8;
        nh=nh+1;
      }
      continue;
    }
    let pr2:i32=predict_entry(W,a,t,pr,l,out);
    // pending delay effects: rule (cause xa, delay d) fires if the H line
    // d steps before this Q has action xa
    if(pr2!=0){
      let r:i32=0; let nr:i32=ndl(W);
      while(r<nr){
        if(dl_st(W,r)==ST_ACT()){
          let d:i32=dl_d(W,r); let xa:i32=dl_cause(W,r);
          if(nh>=d && d>0 && (ha[nh-d] as i32)==xa){
            let v:i32=dl_var(W,r);
            if(fx_is_set(dl_fx(W,r))!=0){out[v]=dl_fp(W,r);}
          }
        }
        r=r+1;
      }
    }
    emit("Q ("); e64(t); emit(" "); e64(pr); emit(" "); e64(l);
    emit(") | "); e64(a); emit(" -> ");
    if(pr2==0){
      emit("WITHHOLD\n");
    } else {
      emit("(");
      e64(out[0] as i32); emit(" "); e64(out[1] as i32); emit(" "); e64(out[2] as i32);
      emit(")\n");
    }
    // H context does not accumulate across Q groups: reset after each Q
    // that consumed history? No: keep simple, reset always after a Q.
    nh=0;
  }
  return;
}

fn main()i32 {
  let obsp:[]u8=_zag_arg(1);
  let prbp:[]u8=_zag_arg(2);
  if(obsp.len==0 || prbp.len==0){
    emit("usage: causal3 <obs.txt> <probe.txt>\n");
    return 1;
  }
  let W:[]u8=z_alloc(WSZ());
  set32(W,O_NEP(),0); set32(W,O_NENT(),0);
  set32(W,O_NCT(),0); set32(W,O_NDL(),0);
  let a:i32=0;
  while(a<5){
    let i:i32=new_entry(W,a,0,0,0,0,0,0,0,-1,0);
    a=a+1;
  }
  let data:[]u8=_zag_read_file(obsp);
  let p:i32=0;
  let pv:[]u8=z_alloc(4);
  let seq:i32=0;
  while(p<data.len){
    while(p<data.len && (data[p] as i32)<=32){p=p+1;}
    if(p>=data.len){break;}
    if((data[p] as i32)==35){while(p<data.len && data[p]!=10){p=p+1;}continue;}
    if((data[p] as i32)!=84){while(p<data.len && data[p]!=10){p=p+1;}continue;}
    p=p+1;
    p=parse_int(data,p,pv); let t:i32=get32(pv,0);
    p=parse_int(data,p,pv); let pr:i32=get32(pv,0);
    p=parse_int(data,p,pv); let l:i32=get32(pv,0);
    while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
    p=parse_int(data,p,pv); let ac:i32=get32(pv,0);
    while(p<data.len && ((data[p] as i32)<=32 || data[p]==124)){p=p+1;}
    p=parse_int(data,p,pv); let nt:i32=get32(pv,0);
    p=parse_int(data,p,pv); let npr:i32=get32(pv,0);
    p=parse_int(data,p,pv); let nl:i32=get32(pv,0);
    seq=seq+1;
    learn_episode(W,t,pr,l,ac,nt,npr,nl,seq);
  }
  emit("# learned "); e64(seq); emit(" episodes, ");
  e64(nent(W)); emit(" entries, "); e64(nct(W)); emit(" contests, ");
  e64(ndl(W)); emit(" delay rules\n");
  let i2:i32=0; let nn2:i32=nent(W);
  while(i2<nn2){emit_entry(W,i2);i2=i2+1;}
  emit_dl(W);
  emit("=== PROBES ===\n");
  run_probe(W,prbp);
  return 0;
}

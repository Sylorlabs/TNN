// PHASE 4/5 -- GENERATIVE STATE. Does experience alter future GENERATION?
// Prereg: phase4/PREREG.md. Scorer: score4.py (independent, shares no code).
//
// ONE GENERIC SUBSTRATE (Phase 9 compliant). Structures are op-sequences over
// a generic alphabet. The ONLY generator samples a sequence from a proposal
// distribution parameterised by ONE persistent learner buffer ST.
//   ST[op]        weight for starting with op
//   ST[OPS + op]  weight for continuing with op
// Arms differ ONLY in what ST contains. No mode names, no domain routers,
// no GATE/PLAN/INVENT, no per-domain generators.
//
// Output contract: exactly one row per (regime, arm). Raw cost only.
// No *_ok flags, no success bars. score4.py recomputes every verdict.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn OPS()i32 { return 6; }
fn MAXLEN()i32 { return 6; }
fn BUDGET()i32 { return 400; }
fn PRIOR()i32 { return 60; }
fn REGIMES()i32 { return 3; }
fn NARM()i32 { return 10; }

fn truth_op(T:i32,pos:i32)i32 { return (T*7+pos*3)%OPS(); }

// which learner-state variant each arm uses (arm -> state id)
fn armBuild(a:i32)i32 {
  if(a==0){ return 1; }   // A experienced
  if(a==1){ return 1; }   // E relevant
  if(a==2){ return 0; }   // B fresh
  if(a==3){ return 2; }   // C facts_only
  if(a==4){ return 0; }   // D erased
  if(a==5){ return 3; }   // F irrelevant
  if(a==6){ return 4; }   // G misleading
  if(a==7){ return 5; }   // H shuffled
  if(a==8){ return 0; }   // I oracle (generator overridden)
  return 1;               // J matched
}

// state id -> which prior-experience target set it learns from
// 0 fresh, 1 relevant(rg), 2 facts, 3 irrelevant((rg+1)%3), 4 misleading, 5 shuffle
fn priorSet(st:i32,rg:i32)i32 {
  if(st==1){ return rg; }
  if(st==3){ return (rg+1)%3; }
  if(st==4){ return (rg+1)%3; }
  return rg;
}

fn buildState(ST:[]u8,st:i32,rg:i32)void {
  let z:i32=0;
  while(z<2*OPS()){ set32(ST,z*4,0); z=z+1; }

  // ---- 0 fresh / erased: uniform, no experience
  if(st==0){
    z=0; while(z<2*OPS()){ set32(ST,z*4,1); z=z+1; }
    return;
  }

  // ---- 2 facts_only: knows the target ops directly, no procedure
  if(st==2){
    let p:i32=0;
    while(p<MAXLEN()){
      let op:i32=truth_op(rg,p);
      set32(ST,op*4,get32(ST,op*4)+3);
      set32(ST,(OPS()+op)*4,get32(ST,(OPS()+op)*4)+3);
      p=p+1;
    }
    z=0; while(z<2*OPS()){ if(get32(ST,z*4)==0){ set32(ST,z*4,1); } z=z+1; }
    return;
  }

  // ---- 1 / 3 / 4: accumulated from PRIOR trials on priorSet
  let ps:i32=priorSet(st,rg);
  let t:i32=0;
  while(t<PRIOR()){
    let p:i32=0;
    while(p<MAXLEN()){
      let op:i32=truth_op(ps,p);
      let w:i32=1; if(st==4){ w=2; }
      set32(ST,op*4,get32(ST,op*4)+w);
      set32(ST,(OPS()+op)*4,get32(ST,(OPS()+op)*4)+w);
      p=p+1;
    }
    t=t+1;
  }

  // misleading (4): subtract weight from the TRUE ops -> bias away
  if(st==4){
    let p:i32=0;
    while(p<MAXLEN()){
      let op:i32=truth_op(rg,p);
      let cur:i32=get32(ST,op*4)-2;
      if(cur<0){ cur=0; }
      set32(ST,op*4,cur);
      p=p+1;
    }
  }

  // smoothed so unseen ops remain possible
  z=0; while(z<2*OPS()){ if(get32(ST,z*4)==0){ set32(ST,z*4,1); } z=z+1; }

  // ---- 5 shuffled: same mass, generic op-label permutation (x*5+2)%OPS
  if(st==5){
    let tmp:[]u8=z_alloc(2*OPS()*4);
    z=0; while(z<2*OPS()){ set32(tmp,z*4,0); z=z+1; }
    z=0;
    while(z<2*OPS()){
      let base:i32=z%OPS();
      let sh:i32=(base*5+2)%OPS();
      let dst:i32=sh;
      if(z>=OPS()){ dst=sh+OPS(); }
      set32(tmp,dst*4,get32(ST,z*4));
      z=z+1;
    }
    z=0; while(z<2*OPS()){ set32(ST,z*4,get32(tmp,z*4)); z=z+1; }
  }
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<20);
  let ST:[]u8=z_alloc(2*OPS()*4);
  let seq:[]u8=z_alloc(MAXLEN()*4);
  let c:i32=0;

  c=o_app(ob,c,"PHASE4 RAW v2 ops=6 maxlen=6 budget=400 prior=60"); c=o_nl(ob,c);
  c=o_app(ob,c,"arms A B C D E F G H I J (one row each)"); c=o_nl(ob,c);

  let rg:i32=0;
  while(rg<REGIMES()){
    let a:i32=0;
    while(a<NARM()){
      let bb:i32=armBuild(a);
      buildState(ST,bb,rg);

      let cost:i32=-1;
      if(a==8){ cost=1; }            // I oracle: emits the target directly
      else{
        let tries:i32=0;
        while(tries<BUDGET()){
          let len:i32=3+(tries%4);
          if(len>MAXLEN()){ len=MAXLEN(); }
          let tot:i32=0; let o:i32=0;
          while(o<OPS()){ tot=tot+get32(ST,(OPS()+o)*4); o=o+1; }
          if(tot<1){ tot=1; }
          let good:i32=1;
          let p:i32=0;
          while(p<len){
            let h:i32=(tries+1)*2654435761;
            h=h+(p+1)*40503+rg*2246822519+991;
            h=h^(h>>13); h=h&0x7fffffff;
            h=h+(h>>7); h=h&0x7fffffff;
            let pk:i32=h%tot;
            let ac:i32=0; let ch:i32=0;
            while(ch<OPS()){
              ac=ac+get32(ST,(OPS()+ch)*4);
              if(pk<ac){ break; }
              ch=ch+1;
            }
            if(ch>OPS()-1){ ch=OPS()-1; }
            if(ch!=truth_op(rg,p)){ good=0; }
            set32(seq,p*4,ch);
            p=p+1;
          }
          if(good==1){ cost=tries+1; break; }
          tries=tries+1;
        }
      }

      c=o_app(ob,c,"G rg="); c=o_i64(ob,c,rg as i64);
      c=o_app(ob,c," arm="); c=o_i64(ob,c,a as i64);
      c=o_app(ob,c," state="); c=o_i64(ob,c,bb as i64);
      c=o_app(ob,c," proposals="); c=o_i64(ob,c,BUDGET() as i64);
      c=o_app(ob,c," cost="); c=o_i64(ob,c,cost as i64);
      c=o_app(ob,c," op0="); c=o_i64(ob,c,truth_op(rg,0) as i64);
      c=o_app(ob,c," op1="); c=o_i64(ob,c,truth_op(rg,1) as i64);
      c=o_app(ob,c," op2="); c=o_i64(ob,c,truth_op(rg,2) as i64);
      c=o_nl(ob,c);
      a=a+1;
    }
    rg=rg+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}
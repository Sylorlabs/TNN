// PHASE 4/5 SCORER (Zag port of phase4/score4.py)
//
// Recomputes every verdict from raw cost fields in run.txt. Shares no code with
// g4.zag. The three-condition test is the whole point of the phase:
//   CONDITION 1  S is NOT cheap without learned state
//   CONDITION 2  learned state DOES make it cheap
//   CONDITION 3  facts-only does NOT cheaply reconstruct it  (disqualifying)
//
// usage: score4.zag <run.txt>
// arms 0 A 1 E 2 B 3 C 4 D 5 F 6 G 7 H 8 I_oracle 9 J

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn pad(b:[]u8,c:i32,s:[]u8,to:i32)i32 {
  let e:i32=c+s.len;
  while(e<to){ b[e]=32; e=e+1; }
  return c+s.len;
}

fn NREG()i32 { return 4; }
fn NARM()i32 { return 8; }
fn NBUD()i32 { return 3; }
fn MAXR()i32 { return 400; }

// read "key=<int>" out of a line; -1 if absent
fn fld(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      let p:i32=i+kl+1;
      if(p>=line.len){ return -1; }
      let neg:i32=0;
      if(line[p]=='-'){ neg=1; p=p+1; }
      if(p>=line.len){ return -1; }
      let ch:i32=line[p];
      if(ch<'0' || ch>'9'){ return -1; }
      let v:i32=0;
      while(p<line.len){
        let c2:i32=line[p];
        if(c2>='0' && c2<='9'){ v=v*10+(c2-'0'); p=p+1; }
        else { break; }
      }
      if(neg==1){ v=0-v; }
      return v;
    }
    i=i+1;
  }
  return -1;
}

// cost of (rg,arm,budIdx); -99 when absent

// real budget value for (rg,arm,bi)

// replays lookup


fn NREG4()i32 { return 3; }
fn NARM4()i32 { return 10; }
fn MAXR4()i32 { return 200; }

fn R_RG()i32 { return 0; }
fn R_ARM()i32 { return 1; }
fn R_ST()i32 { return 2; }
fn R_COST()i32 { return 3; }
fn R_N()i32 { return 4; }

fn cost(RW:[]u8,nrow:i32,rg:i32,arm:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*R_N()*4+R_RG()*4)==rg){
      if(get32(RW,i*R_N()*4+R_ARM()*4)==arm){ return get32(RW,i*R_N()*4+R_COST()*4); }
    }
    i=i+1;
  }
  return -99;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: score4 <run.txt>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let rp:[]u8=_zag_arg(1);
  let raw:[]u8="";
  if(_zag_file_exists(rp)==1){ raw=_zag_read_file(rp); }
  let rn:i32=raw.len;
  if(rn<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read input"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  let RW:[]u8=z_alloc(MAXR4()*R_N()*4);
  let nrow:i32=0;
  let li:i32=0;
  while(li<rn){
    let nl:i32=li;
    while(nl<rn){ if(raw[nl]==10){ break; } nl=nl+1; }
    let line:[]u8=raw[li..nl];
    li=nl+1;
    if(line.len>=2){
      if(line[0]=='G' && line[1]==' '){
        let rg:i32=fld(line,"rg");
        let ar:i32=fld(line,"arm");
        let st:i32=fld(line,"state");
        let co:i32=fld(line,"cost");
        if(rg>=0 && ar>=0 && co>=-2){
          if(nrow<MAXR4()){
            set32(RW,nrow*R_N()*4+R_RG()*4,rg);
            set32(RW,nrow*R_N()*4+R_ARM()*4,ar);
            set32(RW,nrow*R_N()*4+R_ST()*4,st);
            set32(RW,nrow*R_N()*4+R_COST()*4,co);
            nrow=nrow+1;
          }
        }
      }
    }
    if(li>rn){ break; }
  }

  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"INDEPENDENT SCORER -- phase4/5 generative state (Zag port)"); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"G rows loaded: "); c=o_i64(ob,c,nrow as i64); c=o_nl(ob,c);
  if(nrow<1){
    c=o_app(ob,c,"RESULT=FAIL (no G rows)"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Cost to generate the target (proposals; -1 = never in 400)"); c=o_nl(ob,c);
  c=o_app(ob,c,"arms:        0A      1E      2B      3C      4D      5F      6G      7H      8I      9J");
  c=o_nl(ob,c);
  let rg:i32=0;
  while(rg<NREG4()){
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64); c=o_app(ob,c,":");
    let a:i32=0;
    while(a<NARM4()){
      c=o_app(ob,c," "); c=o_i64(ob,c,cost(RW,nrow,rg,a) as i64);
      a=a+1;
    }
    c=o_nl(ob,c);
    rg=rg+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  c=o_app(ob,c,"CONDITION 1 -- is S cheap WITHOUT learned state? (B_fresh = arm 2)"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  rg=0;
  while(rg<NREG4()){
    let b:i32=cost(RW,nrow,rg,2);
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,": B_fresh cost="); c=o_i64(ob,c,b as i64);
    c=o_app(ob,c," -> ");
    if(b>0){ c=o_app(ob,c,"FAIL: fresh learner already succeeds"); }
    else { c=o_app(ob,c,"holds"); }
    c=o_nl(ob,c);
    rg=rg+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"CONDITION 2 -- does learned state make it cheap? (A = arm 0)"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  let wins:i32=0;
  rg=0;
  while(rg<NREG4()){
    let a2:i32=cost(RW,nrow,rg,0);
    let b2:i32=cost(RW,nrow,rg,2);
    let sep:i32=0;
    if(a2>0 && b2<=0){ sep=1; wins=wins+1; }
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,": A_experienced cost="); c=o_i64(ob,c,a2 as i64);
    c=o_app(ob,c,"  B_fresh cost="); c=o_i64(ob,c,b2 as i64);
    c=o_app(ob,c,"  -> ");
    if(sep==1){ c=o_app(ob,c,"A wins"); } else { c=o_app(ob,c,"no separation"); }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  c=o_app(ob,c,"  A beats B in "); c=o_i64(ob,c,wins as i64);
  c=o_app(ob,c," of "); c=o_i64(ob,c,NREG4() as i64); c=o_app(ob,c," regimes.");
  c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"CONDITION 3 -- can FACTS-ONLY reconstruct the advantage? (C = arm 3)"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  c=o_app(ob,c,"  If C matches A, the advantage is facts-reconstructible and is NOT"); c=o_nl(ob,c);
  c=o_app(ob,c,"  a generative-competence advantage."); c=o_nl(ob,c);
  let fatal:i32=0;
  rg=0;
  while(rg<NREG4()){
    let a3:i32=cost(RW,nrow,rg,0);
    let c3:i32=cost(RW,nrow,rg,3);
    let m:i32=0;
    if(a3==c3){ m=1; fatal=fatal+1; }
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,": A cost="); c=o_i64(ob,c,a3 as i64);
    c=o_app(ob,c,"  C_facts_only cost="); c=o_i64(ob,c,c3 as i64);
    c=o_app(ob,c,"  -> ");
    if(m==1){ c=o_app(ob,c,"MATCH (generative claim FAILS)"); }
    else { c=o_app(ob,c,"C worse"); }
    c=o_nl(ob,c);
    rg=rg+1;
  }
  c=o_app(ob,c,"  C matches A in "); c=o_i64(ob,c,fatal as i64);
  c=o_app(ob,c," of "); c=o_i64(ob,c,NREG4() as i64); c=o_app(ob,c," regimes.");
  c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  c=o_app(ob,c,"VERDICT"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  if(wins>0 && fatal>0){
    c=o_app(ob,c,"A beats fresh, BUT facts-only matches the experienced learner in at"); c=o_nl(ob,c);
    c=o_app(ob,c,"least one regime. Per the prereg this is a NEGATIVE for generative"); c=o_nl(ob,c);
    c=o_app(ob,c,"ownership: the advantage is facts-reconstructible."); c=o_nl(ob,c);
  } else if(wins>0 && fatal==0){
    c=o_app(ob,c,"A beats fresh and facts-only does NOT match it. Generative-competence"); c=o_nl(ob,c);
    c=o_app(ob,c,"effect survives all three conditions."); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"A never separates from fresh. No generative-competence effect."); c=o_nl(ob,c);
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BOUNDS (not competitors): I_oracle = arm 8, H_shuffled = arm 7.");
  c=o_nl(ob,c);
  rg=0;
  while(rg<NREG4()){
    c=o_app(ob,c,"  regime "); c=o_i64(ob,c,rg as i64);
    c=o_app(ob,c,": I_oracle="); c=o_i64(ob,c,cost(RW,nrow,rg,8) as i64);
    c=o_app(ob,c,"  H_shuffled="); c=o_i64(ob,c,cost(RW,nrow,rg,7) as i64);
    c=o_app(ob,c,"  F_irrelevant="); c=o_i64(ob,c,cost(RW,nrow,rg,5) as i64);
    c=o_app(ob,c,"  G_misleading="); c=o_i64(ob,c,cost(RW,nrow,rg,6) as i64);
    c=o_nl(ob,c);
    rg=rg+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}

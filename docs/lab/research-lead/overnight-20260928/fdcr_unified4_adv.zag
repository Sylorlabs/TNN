// unified_learn.zag — End-to-end unlabeled learn-route-revise loop.
// Unifies H-ROUTER (structure-inferred routing) with H-BRIDGE (revision
// bridge) in a single continuing process.
//
// Architecture:
//   - Router: per-item structure inference, no P/C/Q labels (from route_learn.zag)
//   - Procedure store: 16 slots, 1055-program discovery (from bridge_learn.zag)
//   - Bridge: direct-first, then (pos,val) conditional induction (from bridge_learn.zag,
//     includes the B-A6b dry-run fix)
//   - Causal store: 16 rules (from route_learn.zag)
//   - PROC_LEARN failure automatically triggers bridge induction.
//
// Prereg: PREREG_UNIFIED.md (commit d652fdaee, frozen before implementation).
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn wcopy(W:[]u8, off:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ W[off+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ PROCEDURE STORE (from bridge_learn.zag, PROC_MAX=16) ============
// Program: [type, left, right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}

// Extract index sequence from (inp, out). Returns len or -1 if ambiguous.
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    if(peval(prog, nnodes, k, n)!=get32(seq, k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn PROC_MAX()i32 { return 16; }
fn PROC_SZ()i32 { return 64; }
fn proc_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*PROC_SZ();
}
fn proc_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot));
}
fn proc_set_used(W:[]u8, base:i32, slot:i32, v:i32)void {
  set32(W, proc_slot(W,base,slot), v);
  return;
}
// Store program bytes at slot. Returns slot index or -1.
fn proc_store(W:[]u8, base:i32, prog:[]u8, nnodes:i32)i32 {
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,base,s)==0){
      proc_set_used(W,base,s,1);
      set32(W, proc_slot(W,base,s)+4, nnodes);
      let i:i32=0;
      while(i<nnodes*3){
        W[proc_slot(W,base,s)+8+i]=prog[i];
        i=i+1;
      }
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn proc_nnodes(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot)+4);
}
fn peval_from_store(W:[]u8, base:i32, slot:i32, nnodes:i32, k:i32, n:i32)i32 {
  let tmp:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nnodes*3){
    tmp[i]=W[proc_slot(W,base,slot)+8+i];
    i=i+1;
  }
  return peval(tmp, nnodes, k, n);
}
fn proc_apply(W:[]u8, base:i32, slot:i32, inp:[]u8, out:[]u8)i32 {
  let nnodes:i32=proc_nnodes(W,base,slot);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_from_store(W, base, slot, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
// prog_uses_n: returns 1 if program pi references N (node type 1).
// Generality bias helper (H-GENBIAS): N-referencing programs can adapt to length.
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
// try_discover_pass: one bias pass. want_n=1 → only N-using; want_n=0 → only non-N.
// Returns proc slot or -1.
fn try_discover_pass(W:[]u8, pbase:i32, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let slot:i32=proc_store(W, pbase, tmp, nn);
        return slot;
      }
    }
    pi=pi+1;
  }
  return -1;
}
// try_dry_pass: one bias pass for dry-run discovery. Returns nnodes or -1.
fn try_dry_pass(W:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn pdiscover_direct(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  // H-GENBIAS: N-first generality bias. Pass 1 prefers N-using programs
  // (can generalize across lengths); Pass 2 is the original fallback.
  let slot:i32=try_discover_pass(W, pbase, prog_store, prog_index, pcount, seqs, nseq, 1);
  if(slot<0){
    slot=try_discover_pass(W, pbase, prog_store, prog_index, pcount, seqs, nseq, 0);
  }
  return slot;
}

// pdiscover_dry: dry-run discovery WITHOUT consuming proc slots.
// On success copies the winning program to out_prog and returns nnodes.
// On failure returns -1. NEVER calls proc_store. (B-A6b fix)
fn pdiscover_dry(W:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  // H-GENBIAS: N-first generality bias for dry-run discovery as well.
  let nnr:i32=try_dry_pass(W, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nnr<0){
    nnr=try_dry_pass(W, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0);
  }
  return nnr;
}

// ============ BRIDGE RULE STORE (from bridge_learn.zag) ============
// Rule: [used(4), cond_pos(4), cond_val(4), proc_true(4), proc_false(4)]
// Semantics: IF input[cond_pos]==cond_val THEN apply proc_true ELSE proc_false
fn BR_MAX()i32 { return 4; }
fn BR_SZ()i32 { return 20; }
fn br_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*BR_SZ();
}
fn br_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, br_slot(W,base,slot));
}
fn br_store(W:[]u8, base:i32, cpos:i32, cval:i32, pt:i32, pf:i32)i32 {
  let s:i32=0;
  while(s<BR_MAX()){
    if(br_used(W,base,s)==0){
      let o:i32=br_slot(W,base,s);
      set32(W,o,1); set32(W,o+4,cpos); set32(W,o+8,cval);
      set32(W,o+12,pt); set32(W,o+16,pf);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn br_count(W:[]u8, base:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<BR_MAX()){ if(br_used(W,base,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn br_cpos(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+4); }
fn br_cval(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+8); }
fn br_ptrue(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+12); }
fn br_pfalse(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+16); }

// bridge_apply: evaluate condition, dispatch to correct procedure.
// If input shorter than cond_pos, defaults to proc_false.
fn bridge_apply(W:[]u8, pbase:i32, bbase:i32, bslot:i32, inp:[]u8, out:[]u8)i32 {
  let cpos:i32=br_cpos(W,bbase,bslot);
  let cval:i32=br_cval(W,bbase,bslot);
  let pt:i32=br_ptrue(W,bbase,bslot);
  let pf:i32=br_pfalse(W,bbase,bslot);
  if(inp.len>cpos && (inp[cpos] as i32)==cval){
    return proc_apply(W, pbase, pt, inp, out);
  }
  return proc_apply(W, pbase, pf, inp, out);
}

// ============ BRIDGE LEARN (from bridge_learn.zag) ============
// pairs in W at pairbase: npairs * 16 bytes: (in_off, in_len, out_off, out_len)
// work: scratch area in W for seq data.
// Returns:
//   0..15: procedure slot (direct discovery succeeded, NO BRIDGE)
//   1000+bslot: bridge rule created
//   -1: failure
//
// The (pos, val) condition is discovered by searching over all input
// positions and all byte values present in the training data. No byte
// literals for condition values appear in this function.
fn bridge_learn(W:[]u8, pbase:i32, bbase:i32, pairbase:i32, npairs:i32, work:i32)i32 {
  let seqbase:i32=work;
  let statbase:i32=work + npairs*64;
  let lenbase:i32=statbase + npairs*4;

  // Step 1: extract all pairs
  let i:i32=0;
  let allok:i32=1;
  let maxlen:i32=0;
  while(i<npairs){
    let in_off:i32=get32(W, pairbase+i*16);
    let in_len:i32=get32(W, pairbase+i*16+4);
    let out_off:i32=get32(W, pairbase+i*16+8);
    let out_len:i32=get32(W, pairbase+i*16+12);
    if(in_len>maxlen){maxlen=in_len;}
    let sq:[]u8=z_alloc(64);
    let sl:i32=pextract(W[in_off..in_off+in_len], W[out_off..out_off+out_len], sq);
    if(sl<0){
      set32(W, statbase+i*4, 0);
      allok=0;
    } else {
      set32(W, statbase+i*4, 1);
      set32(W, lenbase+i*4, sl);
      let j:i32=0;
      while(j<sl*4){ W[seqbase+i*64+j]=sq[j]; j=j+1; }
    }
    i=i+1;
  }

  // Step 2: try direct discovery (only if all extracted)
  if(allok==1){
    let desc:[]u8=z_alloc(npairs*12);
    i=0;
    while(i<npairs){
      set32(desc, i*12, seqbase+i*64);
      set32(desc, i*12+4, get32(W, lenbase+i*4));
      set32(desc, i*12+8, get32(W, pairbase+i*16+4));
      i=i+1;
    }
    let slot:i32=pdiscover_direct(W, pbase, desc, npairs);
    if(slot>=0){
      return slot;
    }
  }

  // Step 3: bridge triggered. Search (pos, val).
  emit("bridge: direct failed, inducing condition...\n");
  let p:i32=0;
  while(p<maxlen){
    // All pairs must have in_len > p for this position to be usable
    let okp:i32=1;
    i=0;
    while(i<npairs){
      if(get32(W, pairbase+i*16+4)<=p){okp=0; break;}
      i=i+1;
    }
    if(okp==1){
      // Collect distinct byte values at position p (from data, not literals)
      let dvals:[]u8=z_alloc(128);
      let ndv:i32=0;
      i=0;
      while(i<npairs){
        let in_off:i32=get32(W, pairbase+i*16);
        let v:i32=W[in_off+p] as i32;
        let found:i32=0;
        let k:i32=0;
        while(k<ndv){
          if((dvals[k] as i32)==v){found=1; break;}
          k=k+1;
        }
        if(found==0){
          dvals[ndv]=v as u8;
          ndv=ndv+1;
        }
        i=i+1;
      }
      // Try each distinct value as the split point
      let vi:i32=0;
      while(vi<ndv){
        let v:i32=dvals[vi] as i32;
        let s1idx:[]u8=z_alloc(64);
        let s2idx:[]u8=z_alloc(64);
        let n1:i32=0;
        let n2:i32=0;
        i=0;
        while(i<npairs){
          // Only include extractable pairs
          if(get32(W, statbase+i*4)==1){
            let in_off:i32=get32(W, pairbase+i*16);
            if((W[in_off+p] as i32)==v){
              set32(s1idx, n1*4, i); n1=n1+1;
            } else {
              set32(s2idx, n2*4, i); n2=n2+1;
            }
          }
          i=i+1;
        }
        if(n1>0 && n2>0){
          let d1:[]u8=z_alloc(n1*12);
          let k:i32=0;
          while(k<n1){
            let pi:i32=get32(s1idx, k*4);
            set32(d1, k*12, seqbase+pi*64);
            set32(d1, k*12+4, get32(W, lenbase+pi*4));
            set32(d1, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          let d2:[]u8=z_alloc(n2*12);
          k=0;
          while(k<n2){
            let pi:i32=get32(s2idx, k*4);
            set32(d2, k*12, seqbase+pi*64);
            set32(d2, k*12+4, get32(W, lenbase+pi*4));
            set32(d2, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          // B-A6b fix: dry-run discovery WITHOUT consuming proc slots.
          let prog1:[]u8=z_alloc(48);
          let nn1:i32=pdiscover_dry(W, d1, n1, prog1);
          if(nn1>=0){
            let prog2:[]u8=z_alloc(48);
            let nn2:i32=pdiscover_dry(W, d2, n2, prog2);
            if(nn2>=0){
              // Winning split found. Now store both procedures.
              let s1:i32=proc_store(W, pbase, prog1, nn1);
              if(s1>=0){
                let s2:i32=proc_store(W, pbase, prog2, nn2);
                if(s2>=0){
                  let bs:i32=br_store(W, bbase, p, v, s1, s2);
                  if(bs>=0){
                    emit("bridge: learned IF input[");
                    emit(i32s(p));
                    emit("]==");
                    emit(i32s(v));
                    emit(" THEN proc");
                    emit(i32s(s1));
                    emit(" ELSE proc");
                    emit(i32s(s2));
                    emit("\n");
                    return 1000+bs;
                  }
                  // F-LEAK FIX (H-FLEAKFIX): bridge rule store full.
                  // Roll back both subset procedures: the failed attempt
                  // must waste zero proc slots (transactional).
                  proc_set_used(W, pbase, s2, 0);
                  proc_set_used(W, pbase, s1, 0);
                } else {
                  // F-LEAK FIX (H-FLEAKFIX): second proc store failed.
                  // Roll back the first: no partial allocation survives.
                  proc_set_used(W, pbase, s1, 0);
                }
              }
              // Store failed: slots genuinely exhausted.
              return -1;
            }
          }
        }
        vi=vi+1;
      }
    }
    p=p+1;
  }
  return -1;
}

// ============ CAUSAL STORE (from route_learn.zag) ============
// Rules: (cond_var, cond_val, action, effect_var, effect_val, status)
// Max 16 rules. Status: 0=active, 1=superseded, 2=conflicted
fn CR_MAX()i32 { return 16; }
fn CR_SZ()i32 { return 28; }  // 7*4

fn cr_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*CR_SZ();
}
fn cr_used(W:[]u8, base:i32, slot:i32)i32 { return get32(W, cr_slot(W,base,slot)); }
fn cr_set(W:[]u8, base:i32, slot:i32, used:i32, cv:i32, cval:i32, act:i32, ev:i32, eval:i32, st:i32)void {
  let o:i32=cr_slot(W,base,slot);
  set32(W,o,used); set32(W,o+4,cv); set32(W,o+8,cval);
  set32(W,o+12,act); set32(W,o+16,ev); set32(W,o+20,eval); set32(W,o+24,st);
  return;
}
// Learn from episode: (s0,s1,action) -> (ns0,ns1)
fn clearn(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, ns0:i32, ns1:i32)void {
  let slot:i32=0;
  let found:i32=-1;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 &&
       get32(W,cr_slot(W,base,slot)+12)==act &&
       get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let sv:i32=s0;
      if(cv==1){sv=s1;}
      if(sv==cval){found=slot; break;}
    }
    slot=slot+1;
  }
  if(found<0){
    slot=0;
    while(slot<CR_MAX()){
      if(cr_used(W,base,slot)==0){break;}
      slot=slot+1;
    }
    if(slot>=CR_MAX()){return;}
    cr_set(W,base,slot,1, 0,s0, act, 1,ns1, 0);
    emit("causal: new rule R");
    emit(i32s(slot));
    emit(" IF s0==");
    emit(i32s(s0));
    emit(" AND a==");
    emit(i32s(act));
    emit(" THEN s1:=");
    emit(i32s(ns1));
    emit("\n");
  } else {
    let ev:i32=get32(W,cr_slot(W,base,found)+16);
    let eval:i32=get32(W,cr_slot(W,base,found)+20);
    let actual:i32=ns1;
    if(ev==1 && actual!=eval){
      set32(W,cr_slot(W,base,found)+24,2);
      emit("causal: R");
      emit(i32s(found));
      emit(" CONFLICTED\n");
    }
  }
  return;
}
// Predict: given (s0,s1,act), find matching active rule
fn cpredict(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, out:[]u8)i32 {
  let slot:i32=0;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 && get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let a:i32=get32(W,cr_slot(W,base,slot)+12);
      if(a==act){
        let sv:i32=s0;
        if(cv==1){sv=s1;}
        if(sv==cval){
          let ev:i32=get32(W,cr_slot(W,base,slot)+16);
          let eval:i32=get32(W,cr_slot(W,base,slot)+20);
          out[0]=s0 as u8; out[1]=s1 as u8;
          if(ev==0){out[0]=eval as u8;}
          if(ev==1){out[1]=eval as u8;}
          return 1;
        }
      }
    }
    slot=slot+1;
  }
  return 0;
}

// ============ STRUCTURE-INFERRED ROUTER (from route_learn.zag) ============
// Route codes: 0=WITHHOLD, 1=PROC_LEARN, 2=CAUS_LEARN, 3=PROC_QUERY, 4=CAUS_QUERY
fn is_digit(c:u8)i32 {
  if(c>=48 && c<=57){return 1;}
  return 0;
}

// field_kind: -2 empty, -1 string, else int count (>=1)
fn field_kind(b:[]u8, lo:i32, hi:i32)i32 {
  if(hi<=lo){return -2;}
  let i:i32=lo;
  let nints:i32=1;
  let expect_digit:i32=1;
  while(i<hi){
    let c:u8=b[i];
    if(is_digit(c)==1){expect_digit=0;}
    else {
      if(c==44){
        if(expect_digit==1){return -1;}
        nints=nints+1;
        expect_digit=1;
      } else {return -1;}
    }
    i=i+1;
  }
  if(expect_digit==1){return -1;}
  return nints;
}

fn find_ch(b:[]u8, lo:i32, hi:i32, ch:u8)i32 {
  let i:i32=lo;
  while(i<hi){if(b[i]==ch){return i;}i=i+1;}
  return -1;
}

fn route_name(c:i32)[]u8 {
  if(c==1){return "PROC_LEARN";}
  if(c==2){return "CAUS_LEARN";}
  if(c==3){return "PROC_QUERY";}
  if(c==4){return "CAUS_QUERY";}
  if(c==5){return "CONCEPT_LEARN";}
  return "WITHHOLD";
}

fn route_line(line:[]u8)i32 {
  let n:i32=line.len;
  let code:i32=0;
  let reason:[]u8="empty line";
  if(n>0){
    // H-FDCR-UNIFIED: fact lines contain '|' (pipe, ASCII 124).
    // Format: T subj | rel | obj. Route to CONCEPT_LEARN (code 5).
    let has_pipe:i32=0;
    let pi:i32=0;
    while(pi<n){if(line[pi]==124){has_pipe=1;break;}pi=pi+1;}
    if(has_pipe==1){
      // Must start with 'T ' (fact) to be concept learn.
      if(n>=2 && line[0]==84 && line[1]==32){
        emit("ROUTE [");
        emit(line);
        emit("] -> CONCEPT_LEARN (fact line with pipe)\n");
        return 5;
      }
      // Pipe but not T-form: withhold (not a valid fact).
      emit("ROUTE [");
      emit(line);
      emit("] -> WITHHOLD (pipe but not T-fact)\n");
      return 0;
    }
    let nseg:i32=1;
    let i:i32=0;
    while(i<n){if(line[i]==59){nseg=nseg+1;}i=i+1;}
    let s:i32=0;
    let pos:i32=0;
    let all_pair_str:i32=1;
    let all_ep:i32=1;
    let has_gt:i32=0;
    let bad:i32=0;
    while(s<nseg){
      let end:i32=find_ch(line,pos,n,59);
      if(end<0){end=n;}
      if(end<=pos){bad=1;reason="empty segment";}
      else {
        let gt:i32=find_ch(line,pos,end,62);
        if(gt<0){
          all_pair_str=0;
          all_ep=0;
        } else {
          has_gt=1;
          if(find_ch(line,gt+1,end,62)>=0){
            all_pair_str=0;
            all_ep=0;
          } else {
            let lk:i32=field_kind(line,pos,gt);
            let rk:i32=field_kind(line,gt+1,end);
            if(lk!=-1 || rk!=-1){all_pair_str=0;}
            if(lk!=3 || rk!=2){all_ep=0;}
          }
        }
      }
      if(bad==1){break;}
      pos=end+1;
      s=s+1;
    }
    if(bad==0){
      if(nseg>=2 && all_pair_str==1){code=1;reason="2+ segs, str>str";}
      else {
        if(nseg>=2 && all_ep==1){code=2;reason="2+ segs, iii>ii";}
        else {
          if(nseg==1 && has_gt==0){
            let k:i32=field_kind(line,0,n);
            if(k==-1){code=3;reason="single bare string";}
            else {
              if(k==3){code=4;reason="single 3-int tuple";}
              else {reason="single seg: not string nor 3-int tuple";}
            }
          } else {
            if(nseg==1){reason="single pair/episode: learning needs 2+ segs";}
            else {reason="mixed or malformed segments";}
          }
        }
      }
    }
  }
  emit("ROUTE [");
  emit(line);
  emit("] -> ");
  emit(route_name(code));
  emit(" (");
  emit(reason);
  emit(")\n");
  return code;
}

fn parse_ints(b:[]u8, lo:i32, hi:i32, out:[]u8)void {
  let idx:i32=0;
  let i:i32=lo;
  while(i<hi){
    let v:i32=0;
    while(i<hi){
      if(is_digit(b[i])==0){break;}
      v=v*10+((b[i] as i32)-48);
      i=i+1;
    }
    set32(out,idx*4,v);
    idx=idx+1;
    if(i<hi && b[i]==44){i=i+1;}
  }
  return;
}

// ============ WORKSPACE LAYOUT ============
// W: 65536 bytes.
//   pbase=0       proc store: 16*64 = 1024
//   bbase=1024    bridge store: 4*20 = 80
//   cbase=1104    causal store: 16*28 = 448 (ends 1552)
//   work=4096     bridge_learn scratch (moved from 2048 for concept store)
//   pairbase=8192 pair descriptors (16 bytes each)
//   ST_STR=65000  persistent string-data cursor (init 16384)
fn PBASE()i32 { return 0; }
fn BBASE()i32 { return 1024; }
fn CBASE()i32 { return 1104; }
fn WORK()i32 { return 4096; }
fn PAIRBASE()i32 { return 8192; }
fn ST_STR()i32 { return 65000; }
fn STR0()i32 { return 16384; }
// Intent store (H-INTENT, ported): IBASE=1560. 16 proc slots * 12 bytes
// (learn_seq, train_len, concept_idx) then 4 bridge rules * 12 bytes.
// Global seq counter at SEQADDR=1800.
// Concept store (H-FDCR-UNIFIED): CCONCEPT=1804. 8 concepts * 76 bytes
// = 608 bytes (ends 2412). Each concept: active(4), nfeat(4),
// feats(8*4), nmem(4), members(8*4).
// NOADD vote table (H-FDCR-UNIFIED4 R1): NOADD_BASE=2412. 32 entries
// * 8 bytes (subject string offset, concept index) = 256 bytes
// (ends 2668). Vote-only: MATCH-NOADD subjects count as concept
// votes at the procedure layer but are never members.
// Free: causal store ends at 1552, WORK=4096.
fn IBASE()i32 { return 1560; }
fn SEQADDR()i32 { return 1800; }
fn CCONCEPT()i32 { return 1804; }
fn CON_MAX()i32 { return 8; }
fn CON_SZ()i32 { return 76; }
fn INTENT_SZ()i32 { return 12; }
fn NOADD_BASE()i32 { return 2412; }
fn NOADD_MAX()i32 { return 32; }

// ============ INTENT STORE (H-INTENT) ============
fn intent_proc_base(W:[]u8, slot:i32)i32 { return IBASE() + slot*INTENT_SZ(); }
fn intent_br_base(W:[]u8, bslot:i32)i32 { return IBASE() + 16*INTENT_SZ() + bslot*INTENT_SZ(); }
// All learn_seq init to -1: only slots with learn_seq >= 0 are candidates.
// Bridge sub-procedures never receive intent records, so they are excluded.
// Concept_idx init to -1: no concept association.
fn intent_init(W:[]u8)void {
  let i:i32=0;
  while(i<20){
    set32(W, IBASE()+i*INTENT_SZ(), -1);
    set32(W, IBASE()+i*INTENT_SZ()+4, -1);
    set32(W, IBASE()+i*INTENT_SZ()+8, -1);
    i=i+1;
  }
  set32(W, SEQADDR(), 0);
  return;
}
fn intent_record_proc(W:[]u8, slot:i32, train_len:i32)void {
  let o:i32=intent_proc_base(W, slot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  set32(W, o+8, -1);
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}
// Record with concept association (H-FDCR-UNIFIED).
fn intent_record_proc_con(W:[]u8, slot:i32, train_len:i32, concept:i32)void {
  let o:i32=intent_proc_base(W, slot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  set32(W, o+8, concept);
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}
fn intent_record_br(W:[]u8, bslot:i32, train_len:i32)void {
  let o:i32=intent_br_base(W, bslot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  set32(W, o+8, -1);
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}
// Record bridge with concept association (H-FDCR-UNIFIED2 R4).
fn intent_record_br_con(W:[]u8, bslot:i32, train_len:i32, concept:i32)void {
  let o:i32=intent_br_base(W, bslot);
  set32(W, o, get32(W, SEQADDR()));
  set32(W, o+4, train_len);
  set32(W, o+8, concept);
  set32(W, SEQADDR(), get32(W, SEQADDR())+1);
  return;
}

// ============ INTENT DECISION (H-INTENT) ============
// intent_winner: pure decision, minimal emission.
// res: [kind(4), slot(4), gap(4)].
// kind: -1 = no candidate, -2 = ambiguous, 0 = proc, 1 = bridge.
fn intent_winner(W:[]u8, line:[]u8, res:[]u8)void {
  let qlen:i32=line.len;
  let ck:[]u8=z_alloc(20*4);
  let ci:[]u8=z_alloc(20*4);
  let cs:[]u8=z_alloc(20*4);
  let ncand:i32=0;
  // H-FDCR-UNIFIED: check if query is a concept member.
  let qcon:i32=con_find_member_str(W, line);
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,PBASE(),s)==1 && get32(W,intent_proc_base(W,s))>=0){
      let out:[]u8=z_alloc(qlen+1);
      if(proc_apply(W,PBASE(),s,line,out)==1){
        let o:i32=intent_proc_base(W,s);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let pcon:i32=get32(W,o+8);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        // Concept boost: +5000 if query and procedure share a concept.
        // Below cond_fire (20000) and len_match (10000), above seq.
        let cb:i32=0;
        if(qcon>=0 && pcon>=0 && qcon==pcon){cb=1;}
        set32(ck,ncand*4,0);
        set32(ci,ncand*4,s);
        set32(cs,ncand*4,lm*10000+cb*5000+seq);
        ncand=ncand+1;
      }
    }
    s=s+1;
  }
  let b:i32=0;
  while(b<BR_MAX()){
    if(br_used(W,BBASE(),b)==1){
      let out:[]u8=z_alloc(qlen+1);
      if(bridge_apply(W,PBASE(),BBASE(),b,line,out)==1){
        let o:i32=intent_br_base(W,b);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let bcon:i32=get32(W,o+8);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        let cf:i32=0;
        let cpos:i32=br_cpos(W,BBASE(),b);
        if(qlen>cpos && (line[cpos] as i32)==br_cval(W,BBASE(),b)){cf=1;}
        // H-FDCR-UNIFIED2 R4: concept boost for bridges.
        let cb:i32=0;
        if(qcon>=0 && bcon>=0 && qcon==bcon){cb=1;}
        set32(ck,ncand*4,1);
        set32(ci,ncand*4,b);
        set32(cs,ncand*4,cf*20000+lm*10000+cb*5000+seq);
        ncand=ncand+1;
      }
    }
    b=b+1;
  }
  if(ncand==0){
    set32(res,0,-1); set32(res,4,-1); set32(res,8,0);
    return;
  }
  let top:i32=0;
  let second:i32=-1;
  let i:i32=1;
  while(i<ncand){
    if(get32(cs,i*4)>get32(cs,top*4)){second=top; top=i;}
    else {
      if(second<0 || get32(cs,i*4)>get32(cs,second*4)){second=i;}
    }
    i=i+1;
  }
  let gap:i32=0;
  if(second>=0){gap=get32(cs,top*4)-get32(cs,second*4);}
  set32(res,8,gap);
  if(second>=0 && gap<2){
    set32(res,0,-2); set32(res,4,-1);
    return;
  }
  set32(res,0,get32(ck,top*4));
  set32(res,4,get32(ci,top*4));
  return;
}

// intent_trace_emit: inspectable white-box trace of the intent decision.
// H-FDCR-UNIFIED2 R3: the trace includes the concept boost term so the
// displayed scores explain the actual winner.
fn intent_trace_emit(W:[]u8, line:[]u8)void {
  let qlen:i32=line.len;
  emit("INTENT query [");
  emit(line);
  emit("] qlen=");
  emit(i32s(qlen));
  emit("\n");
  // H-FDCR-UNIFIED2 R3: query concept, as intent_winner computes it.
  let qcon:i32=con_find_member_str(W, line);
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,PBASE(),s)==1 && get32(W,intent_proc_base(W,s))>=0){
      let out:[]u8=z_alloc(qlen+1);
      if(proc_apply(W,PBASE(),s,line,out)==1){
        let o:i32=intent_proc_base(W,s);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let pcon:i32=get32(W,o+8);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        let cb:i32=0;
        if(qcon>=0 && pcon>=0 && qcon==pcon){cb=1;}
        emit("  cand kind=proc slot=");
        emit(i32s(s));
        emit(" len_match=");
        emit(i32s(lm));
        emit(" train_len=");
        emit(i32s(tlen));
        emit(" seq=");
        emit(i32s(seq));
        emit(" concept_boost=");
        emit(i32s(cb));
        emit(" cond_fire=0 score=");
        emit(i32s(lm*10000+cb*5000+seq));
        emit("\n");
      } else {
        emit("  cand kind=proc slot=");
        emit(i32s(s));
        emit(" DOES-NOT-APPLY\n");
      }
    }
    s=s+1;
  }
  let b:i32=0;
  while(b<BR_MAX()){
    if(br_used(W,BBASE(),b)==1){
      let out:[]u8=z_alloc(qlen+1);
      if(bridge_apply(W,PBASE(),BBASE(),b,line,out)==1){
        let o:i32=intent_br_base(W,b);
        let seq:i32=get32(W,o);
        let tlen:i32=get32(W,o+4);
        let bcon:i32=get32(W,o+8);
        let lm:i32=0;
        if(tlen>=0 && tlen==qlen){lm=1;}
        let cf:i32=0;
        let cpos:i32=br_cpos(W,BBASE(),b);
        if(qlen>cpos && (line[cpos] as i32)==br_cval(W,BBASE(),b)){cf=1;}
        let cb:i32=0;
        if(qcon>=0 && bcon>=0 && qcon==bcon){cb=1;}
        emit("  cand kind=bridge slot=");
        emit(i32s(b));
        emit(" len_match=");
        emit(i32s(lm));
        emit(" train_len=");
        emit(i32s(tlen));
        emit(" seq=");
        emit(i32s(seq));
        emit(" concept_boost=");
        emit(i32s(cb));
        emit(" cond_fire=");
        emit(i32s(cf));
        emit(" score=");
        emit(i32s(cf*20000+lm*10000+cb*5000+seq));
        emit("\n");
      } else {
        emit("  cand kind=bridge slot=");
        emit(i32s(b));
        emit(" DOES-NOT-APPLY\n");
      }
    }
    b=b+1;
  }
  return;
}

// handle_proc_query_intent: full query handler with trace and answer.
// Returns: 1 answered, 0 withhold (none), -1 withhold (ambiguous).
fn handle_proc_query_intent(W:[]u8, line:[]u8)i32 {
  intent_trace_emit(W, line);
  let res:[]u8=z_alloc(12);
  intent_winner(W, line, res);
  let kind:i32=get32(res,0);
  let slot:i32=get32(res,4);
  let gap:i32=get32(res,8);
  if(kind==-1){
    emit("QINTENT WITHHOLD: no procedure or bridge rule applies\n");
    return 0;
  }
  if(kind==-2){
    emit("QINTENT WITHHOLD AMBIGUOUS: top two candidates gap=");
    emit(i32s(gap));
    emit(" < 2\n");
    return -1;
  }
  let qlen:i32=line.len;
  let out:[]u8=z_alloc(qlen+1);
  if(kind==0){
    proc_apply(W,PBASE(),slot,line,out);
    emit("QINTENT ANSWER kind=proc slot=");
  } else {
    bridge_apply(W,PBASE(),BBASE(),slot,line,out);
    emit("QINTENT ANSWER kind=bridge slot=");
  }
  emit(i32s(slot));
  emit(" gap=");
  emit(i32s(gap));
  emit(" [");
  emit(line);
  emit("] -> [");
  emit(out[0..qlen]);
  emit("]\n");
  return 1;
}

// ============ CONCEPT STORE (H-FDCR-UNIFIED, FORM-only v1) ============
// Minimal FDCR-derived concept formation. Concepts group entities with
// identical feature sets (FORM operator). Each concept record (76 bytes):
//   +0: active (0/1)
//   +4: nfeat (number of features)
//   +8: feats[8] (feature string offsets in ST_STR area, 4 bytes each)
//   +40: nmem (number of members)
//   +44: members[8] (member string offsets, 4 bytes each)
// Features and members are string offsets into the ST_STR area.
// This is FORM-only: no SPLIT, no MERGE, no GRADE in v1.
fn con_slot(W:[]u8, c:i32)i32 {
  return CCONCEPT() + c*CON_SZ();
}
fn con_active(W:[]u8, c:i32)i32 {
  return get32(W, con_slot(W,c));
}
fn con_set_active(W:[]u8, c:i32, v:i32)void {
  set32(W, con_slot(W,c), v);
  return;
}
fn con_nfeat(W:[]u8, c:i32)i32 {
  return get32(W, con_slot(W,c)+4);
}
fn con_set_nfeat(W:[]u8, c:i32, v:i32)void {
  set32(W, con_slot(W,c)+4, v);
  return;
}
fn con_feat(W:[]u8, c:i32, i:i32)i32 {
  return get32(W, con_slot(W,c)+8+i*4);
}
fn con_set_feat(W:[]u8, c:i32, i:i32, v:i32)void {
  set32(W, con_slot(W,c)+8+i*4, v);
  return;
}
fn con_nmem(W:[]u8, c:i32)i32 {
  return get32(W, con_slot(W,c)+40);
}
fn con_set_nmem(W:[]u8, c:i32, v:i32)void {
  set32(W, con_slot(W,c)+40, v);
  return;
}
fn con_mem(W:[]u8, c:i32, i:i32)i32 {
  return get32(W, con_slot(W,c)+44+i*4);
}
fn con_set_mem(W:[]u8, c:i32, i:i32, v:i32)void {
  set32(W, con_slot(W,c)+44+i*4, v);
  return;
}
// Initialize concept store: all inactive.
fn con_init(W:[]u8)void {
  let c:i32=0;
  while(c<CON_MAX()){
    con_set_active(W,c,0);
    con_set_nfeat(W,c,0);
    con_set_nmem(W,c,0);
    c=c+1;
  }
  noadd_init(W);
  return;
}
// Intern a string into ST_STR area. Returns offset. Simple linear append;
// no deduplication in v1 (caller should check if needed).
fn con_intern(W:[]u8, s:[]u8)i32 {
  let base:i32=get32(W, ST_STR());
  let i:i32=0;
  while(i<s.len){
    W[base+i]=s[i];
    i=i+1;
  }
  W[base+s.len]=0;
  set32(W, ST_STR(), base+s.len+1);
  return base;
}
// Get string at offset as slice (null-terminated).
fn con_str_at(W:[]u8, off:i32)[]u8 {
  let e:i32=off;
  while(W[e]!=0){e=e+1;}
  return W[off..e];
}
// FORM: create or extend a concept for an entity with given features.
// Features are string offsets. If a concept with identical feature set
// (by string content) exists, add the entity as member. Otherwise create
// a new concept. Returns concept index or -1 if store full.
fn con_form(W:[]u8, mem_off:i32, feats:[]u8, nfeat:i32)i32 {
  // Check existing concepts for identical feature set (by content).
  // Order-normalized (H-FDCR-UNIFIED3 R1): same SET merges regardless
  // of fact order. nfeat equality is enforced first, so one-way
  // inclusion implies set identity.
  let c:i32=0;
  while(c<CON_MAX()){
    if(con_active(W,c)==1 && con_nfeat(W,c)==nfeat){
      let match:i32=1;
      let i:i32=0;
      while(i<nfeat){
        let f2:[]u8=con_str_at(W, get32(feats,i*4));
        let hit:i32=0;
        let k:i32=0;
        while(k<nfeat){
          let f1:[]u8=con_str_at(W, con_feat(W,c,k));
          if(streq(f1,f2)==1){hit=1;break;}
          k=k+1;
        }
        if(hit==0){match=0;break;}
        i=i+1;
      }
      if(match==1){
        // Add member if not already present and space available.
        // Member cap is 8 per concept; a full concept reports
        // MATCH-NOADD (-2) with an explicit warning (R2). The
        // caller must not assert membership for -2.
        let nm:i32=con_nmem(W,c);
        let found:i32=0;
        let j:i32=0;
        while(j<nm){
          if(con_mem(W,c,j)==mem_off){found=1;break;}
          j=j+1;
        }
        if(found==0){
          if(nm<8){
            con_set_mem(W,c,nm,mem_off);
            con_set_nmem(W,c,nm+1);
            return c;
          }
          emit("ULEARN concept: WARN member cap 8 reached on concept ");
          emit(i32s(c));
          emit("; subject NOT added\n");
          // H-FDCR-UNIFIED4 R1: record the excluded subject as a
          // vote-only NOADD entry so it still counts at the
          // procedure layer.
          noadd_record(W, mem_off, c);
          return -2;
        }
        return c;
      }
    }
    c=c+1;
  }
  // Create new concept.
  c=0;
  while(c<CON_MAX()){
    if(con_active(W,c)==0){
      con_set_active(W,c,1);
      con_set_nfeat(W,c,nfeat);
      let i:i32=0;
      while(i<nfeat){
        con_set_feat(W,c,i,get32(feats,i*4));
        i=i+1;
      }
      con_set_mem(W,c,0,mem_off);
      con_set_nmem(W,c,1);
      return c;
    }
    c=c+1;
  }
  return -1;
}
// Post-extension concept merge (H-FDCR-UNIFIED4 R2). After the
// extension branch grows concept ci, another active concept may
// hold the identical feature set (the X-FU3-1 fragmentation).
// Scan all other active concepts for set-identity and merge on
// match, so batch order cannot control the concept count.
fn con_merge_into(W:[]u8, ci:i32, c2:i32)void {
  // Step 1: move c2's members into ci (deduplicated, 8 cap).
  // Overflow members become vote-only NOADD entries for ci.
  let nm:i32=con_nmem(W,ci);
  let dropped:i32=0;
  let j:i32=0;
  let n2:i32=con_nmem(W,c2);
  while(j<n2){
    let mo:i32=con_mem(W,c2,j);
    let found:i32=0;
    let k:i32=0;
    while(k<nm){
      if(con_mem(W,ci,k)==mo){found=1;break;}
      k=k+1;
    }
    if(found==0){
      if(nm<8){
        con_set_mem(W,ci,nm,mo);
        nm=nm+1;
      } else {
        noadd_record(W, mo, ci);
        dropped=dropped+1;
      }
    }
    j=j+1;
  }
  con_set_nmem(W,ci,nm);
  if(dropped>0){
    emit("ULEARN concept: WARN merge member overflow on concept ");
    emit(i32s(ci));
    emit("; ");
    emit(i32s(dropped));
    emit(" members kept as votes only\n");
  }
  // Step 2: remap NOADD vote entries pointing at c2.
  noadd_remap(W, c2, ci);
  // Step 3: remap intent concept records pointing at c2.
  let s:i32=0;
  while(s<20){
    let o:i32=IBASE()+s*INTENT_SZ();
    if(get32(W,o)>=0 && get32(W,o+8)==c2){
      set32(W,o+8,ci);
    }
    s=s+1;
  }
  // Step 4: deactivate the absorbed concept.
  con_set_active(W,c2,0);
  // Step 5: announce the merge.
  emit("ULEARN concept: CONCEPT-MERGE ");
  emit(i32s(c2));
  emit(" into ");
  emit(i32s(ci));
  emit("\n");
  return;
}
fn con_merge_check(W:[]u8, ci:i32)void {
  let n1:i32=con_nfeat(W,ci);
  let c2:i32=0;
  while(c2<CON_MAX()){
    if(c2!=ci && con_active(W,c2)==1 && con_nfeat(W,c2)==n1){
      let match:i32=1;
      let i:i32=0;
      while(i<n1){
        let f2:[]u8=con_str_at(W, con_feat(W,c2,i));
        let hit:i32=0;
        let k:i32=0;
        while(k<n1){
          let f1:[]u8=con_str_at(W, con_feat(W,ci,k));
          if(streq(f1,f2)==1){hit=1;break;}
          k=k+1;
        }
        if(hit==0){match=0;break;}
        i=i+1;
      }
      if(match==1){
        con_merge_into(W, ci, c2);
      }
    }
    c2=c2+1;
  }
  return;
}
// Check if a string (by offset) is a member of any active concept.
// Returns concept index or -1.
fn con_find_member(W:[]u8, mem_off:i32)i32 {
  let c:i32=0;
  while(c<CON_MAX()){
    if(con_active(W,c)==1){
      let nm:i32=con_nmem(W,c);
      let j:i32=0;
      while(j<nm){
        if(con_mem(W,c,j)==mem_off){return c;}
        j=j+1;
      }
    }
    c=c+1;
  }
  return -1;
}
// Check if a string (by content) is a member of any concept.
// Returns concept index or -1. Compares string content.
fn con_find_member_str(W:[]u8, s:[]u8)i32 {
  let c:i32=0;
  while(c<CON_MAX()){
    if(con_active(W,c)==1){
      let nm:i32=con_nmem(W,c);
      let j:i32=0;
      while(j<nm){
        let mo:i32=con_mem(W,c,j);
        let ms:[]u8=con_str_at(W,mo);
        if(streq(ms,s)==1){return c;}
        j=j+1;
      }
    }
    c=c+1;
  }
  return -1;
}
// NOADD vote table (H-FDCR-UNIFIED4 R1). Subjects whose feature set
// matched a concept but were excluded by the 8-member cap
// (MATCH-NOADD) are recorded here. They count as concept VOTES at
// the procedure layer via con_vote_concept, but are never members:
// con_find_member_str keeps exact member-only semantics.
fn noadd_init(W:[]u8)void {
  let i:i32=0;
  while(i<NOADD_MAX()){
    set32(W, NOADD_BASE()+i*8, -1);
    set32(W, NOADD_BASE()+i*8+4, -1);
    i=i+1;
  }
  return;
}
fn noadd_find(W:[]u8, s:[]u8)i32 {
  let i:i32=0;
  while(i<NOADD_MAX()){
    if(get32(W, NOADD_BASE()+i*8)>=0){
      let ms:[]u8=con_str_at(W, get32(W, NOADD_BASE()+i*8));
      if(streq(ms,s)==1){return get32(W, NOADD_BASE()+i*8+4);}
    }
    i=i+1;
  }
  return -1;
}
fn noadd_record(W:[]u8, mem_off:i32, c:i32)void {
  // Defensive (AMEND1): never record a subject already a member of
  // the TARGET concept c. Members of other concepts (e.g. overflow
  // members of an absorbed concept during a merge) are legitimate
  // voters and must be recorded.
  let s0:[]u8=con_str_at(W, mem_off);
  if(con_find_member_str(W, s0)==c){return;}
  let s:[]u8=s0;
  let i:i32=0;
  while(i<NOADD_MAX()){
    if(get32(W, NOADD_BASE()+i*8)>=0){
      let ms:[]u8=con_str_at(W, get32(W, NOADD_BASE()+i*8));
      if(streq(ms,s)==1){
        set32(W, NOADD_BASE()+i*8+4, c);
        return;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<NOADD_MAX()){
    if(get32(W, NOADD_BASE()+i*8)<0){
      set32(W, NOADD_BASE()+i*8, mem_off);
      set32(W, NOADD_BASE()+i*8+4, c);
      return;
    }
    i=i+1;
  }
  emit("ULEARN concept: WARN NOADD vote table full; subject will not vote\n");
  return;
}
fn noadd_remap(W:[]u8, c2:i32, ci:i32)void {
  let i:i32=0;
  while(i<NOADD_MAX()){
    if(get32(W, NOADD_BASE()+i*8)>=0 && get32(W, NOADD_BASE()+i*8+4)==c2){
      set32(W, NOADD_BASE()+i*8+4, ci);
    }
    i=i+1;
  }
  return;
}
// Procedure-layer voting concept: member concept first, else the
// NOADD vote mapping. Never asserts membership.
fn con_vote_concept(W:[]u8, s:[]u8)i32 {
  let m:i32=con_find_member_str(W, s);
  if(m>=0){return m;}
  return noadd_find(W, s);
}
// Count active concepts.
fn con_count(W:[]u8)i32 {
  let n:i32=0;
  let c:i32=0;
  while(c<CON_MAX()){
    if(con_active(W,c)==1){n=n+1;}
    c=c+1;
  }
  return n;
}

// ============ UNIFIED HANDLERS ============

// Parse an unlabeled PROC_LEARN line into str>str pairs, stage them into W,
// and run bridge_learn (direct-first, bridge on failure).
// Returns: 0..15 direct slot, 1000+bslot bridge rule, -1 failure.
fn handle_proc_learn_unified(W:[]u8, line:[]u8)i32 {
  let n:i32=line.len;
  let nseg:i32=1;
  let i:i32=0;
  while(i<n){if(line[i]==59){nseg=nseg+1;}i=i+1;}
  let strbase:i32=get32(W, ST_STR());
  let s:i32=0;
  let pos:i32=0;
  while(s<nseg){
    let end:i32=find_ch(line,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(line,pos,end,62);
    let in_off:i32=strbase;
    i=pos;
    while(i<gt){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let in_len:i32=gt-pos;
    let out_off:i32=strbase;
    i=gt+1;
    while(i<end){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let out_len:i32=end-(gt+1);
    set32(W, PAIRBASE()+s*16, in_off);
    set32(W, PAIRBASE()+s*16+4, in_len);
    set32(W, PAIRBASE()+s*16+8, out_off);
    set32(W, PAIRBASE()+s*16+12, out_len);
    pos=end+1;
    s=s+1;
  }
  set32(W, ST_STR(), strbase);
  let rc:i32=bridge_learn(W, PBASE(), BBASE(), PAIRBASE(), nseg, WORK());
  // Intent recording (H-INTENT): uniform training input length, or -1 if
  // varied. Bridge sub-procedures stored inside bridge_learn receive no
  // records (PREREG_INTENT_AMEND1): they are excluded from candidacy.
  // H-FDCR-UNIFIED: also record concept association if training input
  // is a concept member.
  let tlen:i32=-1;
  let l0:i32=get32(W, PAIRBASE()+4);
  let allsame:i32=1;
  let ci:i32=0;
  while(ci<nseg){
    if(get32(W, PAIRBASE()+ci*16+4)!=l0){allsame=0; break;}
    ci=ci+1;
  }
  if(allsame==1){tlen=l0;}
  // H-FDCR-UNIFIED2 R1: majority-vote concept association over ALL
  // training inputs (not just the first). For each distinct concept
  // among the inputs, count how many inputs are members. Select the
  // top concept; require strict majority (count*2 > nseg).
  // Ties: first-seen wins (disclosed).
  let train_con:i32=-1;
  let best_con:i32=-1;
  let best_cnt:i32=0;
  let vi:i32=0;
  while(vi<nseg){
    let vio:i32=get32(W, PAIRBASE()+vi*16);
    let vil:i32=get32(W, PAIRBASE()+vi*16+4);
    if(vil>0){
      let vstr:[]u8=W[vio..vio+vil];
      // H-FDCR-UNIFIED4 R1: vote via con_vote_concept so
      // MATCH-NOADD subjects count as concept votes.
      let vc:i32=con_vote_concept(W, vstr);
      if(vc>=0){
        let cnt:i32=0;
        let vj:i32=0;
        while(vj<nseg){
          let vjo:i32=get32(W, PAIRBASE()+vj*16);
          let vjl:i32=get32(W, PAIRBASE()+vj*16+4);
          if(vjl>0){
            let vjstr:[]u8=W[vjo..vjo+vjl];
            if(con_vote_concept(W, vjstr)==vc){cnt=cnt+1;}
          }
          vj=vj+1;
        }
        if(cnt>best_cnt){
          best_cnt=cnt;
          best_con=vc;
        }
      }
    }
    vi=vi+1;
  }
  if(best_cnt*2>nseg){train_con=best_con;}
  if(rc>=0 && rc<1000){
    intent_record_proc_con(W, rc, tlen, train_con);
    emit("ULEARN: direct discovery -> proc slot ");
    emit(i32s(rc));
    emit(" (intent seq recorded, train_len=");
    emit(i32s(tlen));
    emit(", concept=");
    emit(i32s(train_con));
    emit(")\n");
  } else {
    if(rc>=1000){
      // H-FDCR-UNIFIED2 R4: bridge rules get concept association too.
      intent_record_br_con(W, rc-1000, tlen, train_con);
      emit("ULEARN: bridge triggered -> rule ");
      emit(i32s(rc-1000));
      emit(" (intent seq recorded, train_len=");
      emit(i32s(tlen));
      emit(", concept=");
      emit(i32s(train_con));
      emit(")\n");
    } else {
      emit("ULEARN FAIL: no program and no bridge\n");
    }
  }
  return rc;
}

// Learn causal rules from iii>ii episodes (from route_learn.zag, unchanged).
fn handle_caus_learn(W:[]u8, line:[]u8)void {
  let n:i32=line.len;
  let pos:i32=0;
  let ne:i32=0;
  while(pos<n){
    let end:i32=find_ch(line,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(line,pos,end,62);
    let lv:[]u8=z_alloc(12);
    let rv:[]u8=z_alloc(8);
    parse_ints(line,pos,gt,lv);
    parse_ints(line,gt+1,end,rv);
    clearn(W,CBASE(),get32(lv,0),get32(lv,4),get32(lv,8),get32(rv,0),get32(rv,4));
    ne=ne+1;
    pos=end+1;
  }
  emit("ULEARN: ");
  emit(i32s(ne));
  emit(" causal episodes\n");
  return;
}

// Concept learn from FDCR-style fact lines (H-FDCR-UNIFIED2).
// Input: one or more `T subj | rel | obj` facts separated by ';'.
// Each fact contributes (rel, obj) as a feature of subj.
// H-FDCR-UNIFIED2 R2: two-pass feature accumulation. Pass 1 parses all
// facts into (subject, feature) pairs. Pass 2 groups by subject,
// accumulates each subject's full feature set, then either extends the
// subject's existing concept (cross-batch) or calls con_form once with
// nfeat>1. The call site now passes multi-feature sets.
// Returns number of facts processed.
// Limitation (disclosed): extending a concept's feature set does not
// re-evaluate other existing members against the enlarged set.
fn handle_concept_learn(W:[]u8, line:[]u8)i32 {
  let n:i32=line.len;
  // Pass 1: parse all facts into (subject_off, feat_off) pairs.
  // Max 16 facts per batch (parse array limit, disclosed).
  let subj_offs:[]u8=z_alloc(16*4);
  let feat_offs:[]u8=z_alloc(16*4);
  let np:i32=0;
  // H-FDCR-UNIFIED3 R3: facts beyond the 16/batch cap are counted
  // and reported with an explicit warning (were silently dropped).
  let ndropped_facts:i32=0;
  let pos:i32=0;
  while(pos<n){
    let end:i32=find_ch(line,pos,n,59);
    if(end<0){end=n;}
    if(end>pos){
      // Parse T subj | rel | obj within [pos, end).
      // Find pipes.
      let p1:i32=find_ch(line,pos,end,124);
      if(p1>=0){
        let p2:i32=find_ch(line,p1+1,end,124);
        if(p2>=0){
          // Subject: from pos+2 (skip "T ") to p1, trimmed.
          let ss:i32=pos+2;
          while(ss<p1 && line[ss]==32){ss=ss+1;}
          let se:i32=p1;
          while(se>ss && line[se-1]==32){se=se-1;}
          // Rel: from p1+1 to p2, trimmed.
          let rs:i32=p1+1;
          while(rs<p2 && line[rs]==32){rs=rs+1;}
          let re:i32=p2;
          while(re>rs && line[re-1]==32){re=re-1;}
          // Obj: from p2+1 to end, trimmed.
          let os:i32=p2+1;
          while(os<end && line[os]==32){os=os+1;}
          let oe:i32=end;
          while(oe>os && line[oe-1]==32){oe=oe-1;}
          if(se>ss && re>rs && oe>os){
            if(np<16){
            let subj:[]u8=line[ss..se];
            let rel:[]u8=line[rs..re];
            let obj:[]u8=line[os..oe];
            // Build feature string "rel=obj" for FORM grouping.
            let feat:[]u8=z_alloc(rel.len+obj.len+2);
            let fi:i32=0;
            let k:i32=0;
            while(k<rel.len){feat[fi]=rel[k];fi=fi+1;k=k+1;}
            feat[fi]=61;fi=fi+1; // '='
            k=0;
            while(k<obj.len){feat[fi]=obj[k];fi=fi+1;k=k+1;}
            let feat_s:[]u8=feat[0..fi];
            // Intern subject and feature.
            let mem_off:i32=con_intern(W, subj);
            let feat_off:i32=con_intern(W, feat_s);
            set32(subj_offs, np*4, mem_off);
            set32(feat_offs, np*4, feat_off);
            np=np+1;
            emit("ULEARN concept: fact [");
            emit(subj);
            emit(" | ");
            emit(rel);
            emit(" | ");
            emit(obj);
            emit("] parsed\n");
            } else {
              ndropped_facts=ndropped_facts+1;
            }
          }
        }
      }
    }
    pos=end+1;
  }
  if(ndropped_facts>0){
    emit("ULEARN concept: WARN fact cap 16 reached; ");
    emit(i32s(ndropped_facts));
    emit(" facts dropped\n");
  }
  // Pass 2: group by subject, accumulate features, form or extend.
  let nsubj:i32=0;
  let i:i32=0;
  while(i<np){
    let so:i32=get32(subj_offs, i*4);
    let sistr:[]u8=con_str_at(W, so);
    // Skip if this subject was already processed (earlier index).
    let done:i32=0;
    let j:i32=0;
    while(j<i){
      let soj:[]u8=con_str_at(W, get32(subj_offs, j*4));
      if(streq(sistr,soj)==1){done=1;break;}
      j=j+1;
    }
    if(done==0){
      // Accumulate all features for this subject (deduplicated).
      // H-FDCR-UNIFIED3 R4: features beyond 8 are counted and
      // reported (were silently dropped).
      let facc:[]u8=z_alloc(8*4);
      let nfacc:i32=0;
      let ndropped_feat:i32=0;
      let k:i32=i;
      while(k<np){
        let sok:[]u8=con_str_at(W, get32(subj_offs, k*4));
        if(streq(sistr,sok)==1){
          let fo:i32=get32(feat_offs, k*4);
          let dup:i32=0;
          let q:i32=0;
          while(q<nfacc){
            let fq:[]u8=con_str_at(W, get32(facc, q*4));
            let fn2:[]u8=con_str_at(W, fo);
            if(streq(fq,fn2)==1){dup=1;break;}
            q=q+1;
          }
          if(dup==0){
            if(nfacc<8){
              set32(facc, nfacc*4, fo);
              nfacc=nfacc+1;
            } else {
              ndropped_feat=ndropped_feat+1;
            }
          }
        }
        k=k+1;
      }
      // Cross-batch: if the subject is already a concept member,
      // extend its concept's feature set. Otherwise form with the
      // full accumulated set (nfeat may exceed 1).
      let existing:i32=con_find_member_str(W, sistr);
      let ci:i32=-1;
      if(existing>=0){
        ci=existing;
        // H-FDCR-UNIFIED3 R4: features beyond 8 on extension are
        // counted and reported (were silently dropped).
        let ndropped_ext:i32=0;
        let a:i32=0;
        while(a<nfacc){
          let fo2:i32=get32(facc, a*4);
          let dup2:i32=0;
          let nf2:i32=con_nfeat(W, ci);
          let q2:i32=0;
          while(q2<nf2){
            let f1:[]u8=con_str_at(W, con_feat(W, ci, q2));
            let f2:[]u8=con_str_at(W, fo2);
            if(streq(f1,f2)==1){dup2=1;break;}
            q2=q2+1;
          }
          if(dup2==0){
            if(con_nfeat(W,ci)<8){
              con_set_feat(W, ci, con_nfeat(W,ci), fo2);
              con_set_nfeat(W, ci, con_nfeat(W,ci)+1);
            } else {
              ndropped_ext=ndropped_ext+1;
            }
          }
          a=a+1;
        }
        if(ndropped_ext>0){
          emit("ULEARN concept: WARN feature cap 8 reached on concept ");
          emit(i32s(ci));
          emit("; ");
          emit(i32s(ndropped_ext));
          emit(" features dropped\n");
        }
        // H-FDCR-UNIFIED4 R2: the extension may have grown ci into
        // set-identity with another concept. Merge on match.
        con_merge_check(W, ci);
      } else {
        ci=con_form(W, so, facc, nfacc);
      }
      nsubj=nsubj+1;
      emit("ULEARN concept: subject [");
      emit(sistr);
      emit("] nfeat=");
      emit(i32s(nfacc));
      // H-FDCR-UNIFIED3 R2: ci==-2 is MATCH-NOADD (feature set
      // known, member cap full). Never assert membership for it.
      if(ci==-2){
        emit(" -> MATCH (feature set known; subject NOT added: 8-member cap)\n");
      } else {
        emit(" -> concept ");
        emit(i32s(ci));
        if(ci>=0){
          emit(" (total nfeat=");
          emit(i32s(con_nfeat(W,ci)));
          emit(")");
        }
        emit("\n");
      }
      if(ndropped_feat>0){
        emit("ULEARN concept: WARN feature cap 8 reached for subject [");
        emit(sistr);
        emit("]; ");
        emit(i32s(ndropped_feat));
        emit(" features dropped\n");
      }
    }
    i=i+1;
  }
  emit("ULEARN: ");
  emit(i32s(np));
  emit(" concept facts, ");
  emit(i32s(nsubj));
  emit(" subjects, ");
  emit(i32s(con_count(W)));
  emit(" active concepts\n");
  return np;
}


// Intent-based procedure query (H-INTENT-UNIFIED). Replaces the old
// spray-all handler: infers which stored procedure or bridge rule the
// querier intends, withholds on genuine ambiguity. Same name and return
// convention (1 answered, 0 withhold-none, -1 withhold-ambiguous).
fn handle_proc_query_unified(W:[]u8, line:[]u8)i32 {
  return handle_proc_query_intent(W, line);
}

// Causal query from a 3-int tuple (from route_learn.zag, unchanged).
fn handle_caus_query(W:[]u8, line:[]u8)i32 {
  let v:[]u8=z_alloc(12);
  parse_ints(line,0,line.len,v);
  let out:[]u8=z_alloc(2);
  if(cpredict(W,CBASE(),get32(v,0),get32(v,4),get32(v,8),out)==1){
    emit("QCAUS [");
    emit(line);
    emit("] -> s0=");
    emit(i32s(out[0] as i32));
    emit(" s1=");
    emit(i32s(out[1] as i32));
    emit("\n");
    return 1;
  }
  emit("QCAUS WITHHOLD: no rule fired\n");
  return 0;
}

// H-FDCR-UNIFIED4 red-team attack harness main().
// Mechanism lines 1-1891 of committed unified_fdcr4.zag are prepended
// byte-verbatim; only main() is replaced.
fn main()i32 {
  emit("=== FU4-ADV: H-FDCR-UNIFIED4 red team ===\n");
  let npass:i32=0;
  let ntest:i32=0;

  // ============ X-FU4-1 T1a: three-concept chain ============
  emit("\n--- X-FU4-1 T1a: three-concept chain ---\n");
  let W1:[]u8=z_alloc(65536);
  set32(W1, ST_STR(), STR0());
  intent_init(W1);
  con_init(W1);
  handle_concept_learn(W1,"T sa | is_a | pet");
  handle_concept_learn(W1,"T sb | is_a | pet;T sb | color | orange");
  handle_concept_learn(W1,"T sc | is_a | pet;T sc | color | orange;T sc | size | big");
  handle_concept_learn(W1,"T sa | color | orange");
  handle_concept_learn(W1,"T sa | size | big");
  ntest=ntest+1;
  let t1a_sa:i32=con_find_member_str(W1,"sa");
  let t1a_sb:i32=con_find_member_str(W1,"sb");
  let t1a_sc:i32=con_find_member_str(W1,"sc");
  if(con_count(W1)==1 && t1a_sa==0 && t1a_sb==0 && t1a_sc==0){
    let t1ap:i32=handle_proc_learn_unified(W1,"sa>as;sb>bs;sc>cs");
    let t1acon:i32=-99;
    if(t1ap>=0 && t1ap<1000){t1acon=get32(W1, intent_proc_base(W1,t1ap)+8);}
    if(t1ap>=1000){t1acon=get32(W1, intent_br_base(W1,t1ap-1000)+8);}
    if(t1acon==0){emit("T1a PASS\n");npass=npass+1;}
    else {emit("T1a FAIL: train_con=");emit(i32s(t1acon));emit("\n");}
  } else {
    emit("T1a FAIL: count=");emit(i32s(con_count(W1)));
    emit(" sa=");emit(i32s(t1a_sa));emit(" sb=");emit(i32s(t1a_sb));
    emit(" sc=");emit(i32s(t1a_sc));emit("\n");
  }

  // ============ X-FU4-1 T1b: same-batch order, both orders ============
  emit("\n--- X-FU4-1 T1b order-1: new subject first ---\n");
  let W2a:[]u8=z_alloc(65536);
  set32(W2a, ST_STR(), STR0());
  intent_init(W2a);
  con_init(W2a);
  handle_concept_learn(W2a,"T olda | is_a | pet");
  handle_concept_learn(W2a,"T nu | is_a | pet;T nu | color | orange;T olda | color | orange");
  ntest=ntest+1;
  let t1b1_o:i32=con_find_member_str(W2a,"olda");
  let t1b1_n:i32=con_find_member_str(W2a,"nu");
  if(con_count(W2a)==1 && t1b1_o>=0 && t1b1_o==t1b1_n){
    let t1b1p:i32=handle_proc_learn_unified(W2a,"olda>adlo;nu>un");
    let t1b1c:i32=-99;
    if(t1b1p>=0 && t1b1p<1000){t1b1c=get32(W2a, intent_proc_base(W2a,t1b1p)+8);}
    if(t1b1p>=1000){t1b1c=get32(W2a, intent_br_base(W2a,t1b1p-1000)+8);}
    if(t1b1c==0){emit("T1b-order1 PASS\n");npass=npass+1;}
    else {emit("T1b-order1 FAIL: train_con=");emit(i32s(t1b1c));emit("\n");}
  } else {
    emit("T1b-order1 FAIL: count=");emit(i32s(con_count(W2a)));
    emit(" olda=");emit(i32s(t1b1_o));emit(" nu=");emit(i32s(t1b1_n));emit("\n");
  }

  emit("\n--- X-FU4-1 T1b order-2: extension first ---\n");
  let W2b:[]u8=z_alloc(65536);
  set32(W2b, ST_STR(), STR0());
  intent_init(W2b);
  con_init(W2b);
  handle_concept_learn(W2b,"T olda | is_a | pet");
  handle_concept_learn(W2b,"T olda | color | orange;T nu | is_a | pet;T nu | color | orange");
  ntest=ntest+1;
  let t1b2_o:i32=con_find_member_str(W2b,"olda");
  let t1b2_n:i32=con_find_member_str(W2b,"nu");
  if(con_count(W2b)==1 && t1b2_o>=0 && t1b2_o==t1b2_n){
    let t1b2p:i32=handle_proc_learn_unified(W2b,"olda>adlo;nu>un");
    let t1b2c:i32=-99;
    if(t1b2p>=0 && t1b2p<1000){t1b2c=get32(W2b, intent_proc_base(W2b,t1b2p)+8);}
    if(t1b2p>=1000){t1b2c=get32(W2b, intent_br_base(W2b,t1b2p-1000)+8);}
    if(t1b2c==0){emit("T1b-order2 PASS\n");npass=npass+1;}
    else {emit("T1b-order2 FAIL: train_con=");emit(i32s(t1b2c));emit("\n");}
  } else {
    emit("T1b-order2 FAIL: count=");emit(i32s(con_count(W2b)));
    emit(" olda=");emit(i32s(t1b2_o));emit(" nu=");emit(i32s(t1b2_n));emit("\n");
  }

  // ============ X-FU4-1 T1c: two extensions in one batch ============
  emit("\n--- X-FU4-1 T1c: two extensions in one batch ---\n");
  let W2c:[]u8=z_alloc(65536);
  set32(W2c, ST_STR(), STR0());
  intent_init(W2c);
  con_init(W2c);
  handle_concept_learn(W2c,"T s1 | is_a | pet");
  handle_concept_learn(W2c,"T s2 | kind | animal");
  handle_concept_learn(W2c,"T s1 | kind | animal;T s2 | is_a | pet");
  ntest=ntest+1;
  let t1c_1:i32=con_find_member_str(W2c,"s1");
  let t1c_2:i32=con_find_member_str(W2c,"s2");
  if(con_count(W2c)==1 && t1c_1>=0 && t1c_1==t1c_2){
    let t1cp:i32=handle_proc_learn_unified(W2c,"s1>1s;s2>2s");
    let t1cc:i32=-99;
    if(t1cp>=0 && t1cp<1000){t1cc=get32(W2c, intent_proc_base(W2c,t1cp)+8);}
    if(t1cp>=1000){t1cc=get32(W2c, intent_br_base(W2c,t1cp-1000)+8);}
    if(t1cc>=0){emit("T1c PASS\n");npass=npass+1;}
    else {emit("T1c FAIL: train_con=");emit(i32s(t1cc));emit("\n");}
  } else {
    emit("T1c FAIL: count=");emit(i32s(con_count(W2c)));
    emit(" s1=");emit(i32s(t1c_1));emit(" s2=");emit(i32s(t1c_2));emit("\n");
  }

  // ============ X-FU4-2 T2a: NOADD fill and overflow ============
  emit("\n--- X-FU4-2 T2a: NOADD table fill + overflow ---\n");
  let W3:[]u8=z_alloc(65536);
  set32(W3, ST_STR(), STR0());
  intent_init(W3);
  con_init(W3);
  handle_concept_learn(W3,"T s1 | is_a | pet;T s2 | is_a | pet;T s3 | is_a | pet;T s4 | is_a | pet;T s5 | is_a | pet;T s6 | is_a | pet;T s7 | is_a | pet;T s8 | is_a | pet;T s9 | is_a | pet;T s10 | is_a | pet;T s11 | is_a | pet;T s12 | is_a | pet;T s13 | is_a | pet;T s14 | is_a | pet;T s15 | is_a | pet;T s16 | is_a | pet");
  handle_concept_learn(W3,"T s17 | is_a | pet;T s18 | is_a | pet;T s19 | is_a | pet;T s20 | is_a | pet;T s21 | is_a | pet;T s22 | is_a | pet;T s23 | is_a | pet;T s24 | is_a | pet;T s25 | is_a | pet;T s26 | is_a | pet;T s27 | is_a | pet;T s28 | is_a | pet;T s29 | is_a | pet;T s30 | is_a | pet;T s31 | is_a | pet;T s32 | is_a | pet");
  handle_concept_learn(W3,"T s33 | is_a | pet;T s34 | is_a | pet;T s35 | is_a | pet;T s36 | is_a | pet;T s37 | is_a | pet;T s38 | is_a | pet;T s39 | is_a | pet;T s40 | is_a | pet;T s41 | is_a | pet");
  ntest=ntest+1;
  let t2a_v1:i32=con_vote_concept(W3,"s1");
  let t2a_v32:i32=con_vote_concept(W3,"s32");
  let t2a_v41:i32=con_vote_concept(W3,"s41");
  let t2a_nm:i32=con_nmem(W3,0);
  if(con_count(W3)==1 && t2a_nm==8 && t2a_v1==0 && t2a_v32==0 && t2a_v41==-1){
    emit("T2a PASS: 8 members, 32 NOADD, s41 vote lost\n");npass=npass+1;
  } else {
    emit("T2a FAIL: count=");emit(i32s(con_count(W3)));
    emit(" nmem=");emit(i32s(t2a_nm));
    emit(" v(s1)=");emit(i32s(t2a_v1));
    emit(" v(s32)=");emit(i32s(t2a_v32));
    emit(" v(s41)=");emit(i32s(t2a_v41));emit("\n");
  }

  // ============ X-FU4-2 T2b: pivotal flip ============
  emit("\n--- X-FU4-2 T2b: pivotal vote-loss flip ---\n");
  handle_concept_learn(W3,"T zz | color | orange");
  ntest=ntest+1;
  let t2bp:i32=handle_proc_learn_unified(W3,"s1>1s;zz>zz;s41>14s");
  // NOTE: subjects are s1..s41 (no zero padding).
  let t2bcon:i32=-99;
  if(t2bp>=0 && t2bp<1000){t2bcon=get32(W3, intent_proc_base(W3,t2bp)+8);}
  if(t2bp>=1000){t2bcon=get32(W3, intent_br_base(W3,t2bp-1000)+8);}
  // s1 votes 0, zz votes 1, s41 lost: 1v1 over nseg=3 -> no strict
  // majority -> train_con=-1. Had s41's vote counted it would vote
  // concept 0 (its feature set is {is_a=pet}): 2v1 -> train_con=0.
  // The WARN (checked externally) is the only signal of the lost vote.
  // CORRECTION (post-run, 2026-09-29): the frozen prereg's
  // counterfactual said concept 1 / train_con=1; that was wrong.
  // s41 matches C0, so the true counterfactual is train_con=0.
  // The flip (-1 vs 0) is still pivotal and still demonstrated.
  emit("T2b info: train_con=");emit(i32s(t2bcon));emit(" (expect -1 with lost vote; 0 had it counted)\n");
  if(t2bcon==-1){emit("T2b PASS: pivotal flip demonstrated\n");npass=npass+1;}
  else {emit("T2b FAIL: train_con=");emit(i32s(t2bcon));emit("\n");}

  // ============ X-FU4-3 T3a: proc intent records across merge ============
  emit("\n--- X-FU4-3 T3a: proc records across merge ---\n");
  let W4:[]u8=z_alloc(65536);
  set32(W4, ST_STR(), STR0());
  intent_init(W4);
  con_init(W4);
  handle_concept_learn(W4,"T pa | is_a | pet;T pb | is_a | pet");
  handle_concept_learn(W4,"T qa | is_a | pet;T qa | color | orange;T qb | is_a | pet;T qb | color | orange");
  let t3a_p1:i32=handle_proc_learn_unified(W4,"qa>aq;qb>bq");
  let t3a_p2:i32=handle_proc_learn_unified(W4,"pa>ap;pb>bp");
  let t3a_c1pre:i32=-99;
  let t3a_c2pre:i32=-99;
  if(t3a_p1>=0 && t3a_p1<1000){t3a_c1pre=get32(W4, intent_proc_base(W4,t3a_p1)+8);}
  if(t3a_p2>=0 && t3a_p2<1000){t3a_c2pre=get32(W4, intent_proc_base(W4,t3a_p2)+8);}
  emit("T3a pre-merge: P1 concept=");emit(i32s(t3a_c1pre));
  emit(" P2 concept=");emit(i32s(t3a_c2pre));emit("\n");
  handle_concept_learn(W4,"T pa | color | orange");
  ntest=ntest+1;
  let t3a_c1post:i32=-99;
  let t3a_c2post:i32=-99;
  if(t3a_p1>=0 && t3a_p1<1000){t3a_c1post=get32(W4, intent_proc_base(W4,t3a_p1)+8);}
  if(t3a_p2>=0 && t3a_p2<1000){t3a_c2post=get32(W4, intent_proc_base(W4,t3a_p2)+8);}
  let t3a_ok:i32=0;
  if(con_count(W4)==1 && t3a_c1pre==1 && t3a_c2pre==0 && t3a_c1post==0 && t3a_c2post==0){t3a_ok=1;}
  // Procedures must still apply correctly after the remap.
  if(t3a_ok==1 && t3a_p1>=0 && t3a_p1<1000){
    let o1:[]u8=z_alloc(8);
    let o2:[]u8=z_alloc(8);
    if(proc_apply(W4,PBASE(),t3a_p1,"qa",o1)==1 && streq(o1[0..2],"aq")==1 &&
       proc_apply(W4,PBASE(),t3a_p2,"pa",o2)==1 && streq(o2[0..2],"ap")==1){
      t3a_ok=2;
    } else { t3a_ok=0; }
  }
  if(t3a_ok==2){emit("T3a PASS: records remapped, procedures intact\n");npass=npass+1;}
  else {
    emit("T3a FAIL: count=");emit(i32s(con_count(W4)));
    emit(" P1 pre/post=");emit(i32s(t3a_c1pre));emit("/");emit(i32s(t3a_c1post));
    emit(" P2 pre/post=");emit(i32s(t3a_c2pre));emit("/");emit(i32s(t3a_c2post));emit("\n");
  }

  // ============ X-FU4-3 T3b: NOADD remap across merge ============
  emit("\n--- X-FU4-3 T3b: NOADD remap across merge ---\n");
  let W5:[]u8=z_alloc(65536);
  set32(W5, ST_STR(), STR0());
  intent_init(W5);
  con_init(W5);
  handle_concept_learn(W5,"T d0 | is_a | pet;T d0 | color | orange;T d0 | size | big;T d1 | is_a | pet;T d1 | color | orange;T d1 | size | big;T d2 | is_a | pet;T d2 | color | orange;T d2 | size | big;T d3 | is_a | pet;T d3 | color | orange;T d3 | size | big;T d4 | is_a | pet;T d4 | color | orange;T d4 | size | big");
  handle_concept_learn(W5,"T d5 | is_a | pet;T d5 | color | orange;T d5 | size | big;T d6 | is_a | pet;T d6 | color | orange;T d6 | size | big;T d7 | is_a | pet;T d7 | color | orange;T d7 | size | big");
  handle_concept_learn(W5,"T d8 | is_a | pet;T d8 | color | orange;T d8 | size | big");
  let t3b_pre:i32=noadd_find(W5,"d8");
  emit("T3b pre-merge: noadd_find(d8)=");emit(i32s(t3b_pre));emit("\n");
  handle_concept_learn(W5,"T cat | is_a | pet;T cat | color | orange");
  handle_concept_learn(W5,"T cat | size | big");
  ntest=ntest+1;
  let t3b_post:i32=noadd_find(W5,"d8");
  let t3b_vd8:i32=con_vote_concept(W5,"d8");
  let t3b_vd7:i32=con_vote_concept(W5,"d7");
  let t3b_md7:i32=con_find_member_str(W5,"d7");
  // Scan all 32 NOADD entries: none may reference concept 0 (deactivated).
  let t3b_stale:i32=0;
  let si:i32=0;
  while(si<32){
    if(get32(W5, NOADD_BASE()+si*8)>=0 && get32(W5, NOADD_BASE()+si*8+4)==0){t3b_stale=1;}
    si=si+1;
  }
  if(con_count(W5)==1 && t3b_pre==0 && t3b_post==1 && t3b_vd8==1 && t3b_md7==-1 && t3b_vd7==1 && t3b_stale==0){
    emit("T3b PASS: NOADD remapped, overflow votes, no stale refs\n");npass=npass+1;
  } else {
    emit("T3b FAIL: count=");emit(i32s(con_count(W5)));
    emit(" d8 pre/post=");emit(i32s(t3b_pre));emit("/");emit(i32s(t3b_post));
    emit(" v(d8)=");emit(i32s(t3b_vd8));

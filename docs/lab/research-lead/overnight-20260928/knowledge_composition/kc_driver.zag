// kc_driver.zag -- knowledge composition experiment driver.
// Constitution Sec 8/26: test X+Y->Z with NO paired X+Y training.
// Three combinations, each with treatment and controls. White-box:
// does Z's solution structurally reference X's and Y's MAPs?

// ---- instrumentation helpers ----
fn kc_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn kc_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn kc_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// find MAP promoted for (s,r); -1 if none.
fn kc_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// 1 if MAP m has outgoing type-14 edge (built via rebind).
fn kc_map_linked(W:[]u8,m:i32)i32 {
  if(m<0){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==14){return 1;}
    e=e+1;
  }
  return 0;
}
// dump MAP's DEP (type-1) edge targets = licensing facts.
fn kc_dump_deps(W:[]u8,m:i32)void {
  if(m<0){emit("  (no MAP)\n"); return;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      emit("  DEP-> fact("); e64(ng(W,f,20)); emit(","); e64(ng(W,f,24)); emit(","); e64(ng(W,f,28)); emit(")\n");
    }
    e=e+1;
  }
  return;
}
// dump type-14 LINK edges with endpoints.
fn kc_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  LINK14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
// ablation: delete all MAP nodes.
fn kc_del_maps(W:[]u8)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,0)==20){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn kc_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// white-box report for a Z query on (s,r).
fn kc_zreport(W:[]u8,s:i32,r:i32)void {
  let zm:i32=kc_find_map(W,s,r);
  emit("ZMAP id="); e64(zm);
  emit(" linked="); e64(kc_map_linked(W,zm)); emit("\n");
  emit("ZMAP deps:\n");
  kc_dump_deps(W,zm);
  emit("link14 total="); e64(kc_count14(W)); emit("\n");
  kc_dump14(W);
  return;
}

// ============ Combination 1: cross-relation, plen 5 ============
// X: r1 plen-3. Y: r2 plen-3. Z: mixed r1+r2 plen-5.
fn kc_c1_trainXY(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let x1:i32=ev_query(W,11,61,13,0);
  emit("C1-X1 ans="); e64(x1); kc_tstat(W);
  ev_teach(W,14,1,15); ev_teach(W,15,1,16);
  let x2:i32=ev_query(W,14,61,16,0);
  emit("C1-X2 ans="); e64(x2); kc_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let y1:i32=ev_query(W,21,62,23,0);
  emit("C1-Y1 ans="); e64(y1); kc_tstat(W);
  ev_teach(W,24,2,25); ev_teach(W,25,2,26);
  let y2:i32=ev_query(W,24,62,26,0);
  emit("C1-Y2 ans="); e64(y2); kc_tstat(W);
  emit("C1 maps="); e64(kc_count_maps(W)); emit(" link14="); e64(kc_count14(W)); emit("\n");
  return;
}
fn kc_c1_zfacts(W:[]u8)void {
  ev_teach(W,31,1,32); ev_teach(W,32,1,33);
  ev_teach(W,33,2,34); ev_teach(W,34,2,35);
  return;
}
fn kc_c1_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,50,35,0);
  emit("C1-Z ans="); e64(z); kc_tstat(W);
  kc_zreport(W,31,50);
  return;
}
fn kc_c1_treat(W:[]u8)void {
  emit("=== C1-TREAT ===\n");
  kc_c1_trainXY(W);
  kc_gap(W);
  kc_c1_zfacts(W);
  kc_c1_zquery(W);
  return;
}
fn kc_c1_paired(W:[]u8)void {
  emit("=== C1-PAIRED ===\n");
  ev_teach(W,51,1,52); ev_teach(W,52,1,53);
  ev_teach(W,53,2,54); ev_teach(W,54,2,55);
  let m1:i32=ev_query(W,51,63,55,0);
  emit("C1-M1 ans="); e64(m1); kc_tstat(W);
  ev_teach(W,56,1,57); ev_teach(W,57,1,58);
  ev_teach(W,58,2,59); ev_teach(W,59,2,60);
  let m2:i32=ev_query(W,56,63,60,0);
  emit("C1-M2 ans="); e64(m2); kc_tstat(W);
  emit("C1-P maps="); e64(kc_count_maps(W)); emit(" link14="); e64(kc_count14(W)); emit("\n");
  kc_gap(W);
  kc_c1_zfacts(W);
  kc_c1_zquery(W);
  return;
}
fn kc_c1_abl(W:[]u8)void {
  emit("=== C1-ABL ===\n");
  kc_c1_trainXY(W);
  kc_del_maps(W);
  emit("C1-ABL maps after del="); e64(kc_count_maps(W)); emit("\n");
  kc_gap(W);
  kc_c1_zfacts(W);
  kc_c1_zquery(W);
  return;
}
fn kc_c1_fresh(W:[]u8)void {
  emit("=== C1-FRESH ===\n");
  kc_gap(W);
  kc_c1_zfacts(W);
  kc_c1_zquery(W);
  return;
}

// ============ Combination 2: cross-relation, plen 7 (beyond trial) ============
// X: r1 plen-4. Y: r2 plen-4. Z: mixed plen-7. Predict: Z FAILS.
fn kc_c2_treat(W:[]u8)void {
  emit("=== C2-TREAT ===\n");
  ev_teach(W,41,1,42); ev_teach(W,42,1,43); ev_teach(W,43,1,44);
  let x1:i32=ev_query(W,41,63,44,0);
  emit("C2-X1 ans="); e64(x1); kc_tstat(W);
  ev_teach(W,45,1,46); ev_teach(W,46,1,47); ev_teach(W,47,1,48);
  let x2:i32=ev_query(W,45,63,48,0);
  emit("C2-X2 ans="); e64(x2); kc_tstat(W);
  ev_teach(W,51,2,52); ev_teach(W,52,2,53); ev_teach(W,53,2,54);
  let y1:i32=ev_query(W,51,64,54,0);
  emit("C2-Y1 ans="); e64(y1); kc_tstat(W);
  ev_teach(W,55,2,56); ev_teach(W,56,2,57); ev_teach(W,57,2,58);
  let y2:i32=ev_query(W,55,64,58,0);
  emit("C2-Y2 ans="); e64(y2); kc_tstat(W);
  emit("C2 maps="); e64(kc_count_maps(W)); emit(" link14="); e64(kc_count14(W)); emit("\n");
  kc_gap(W);
  ev_teach(W,61,1,62); ev_teach(W,62,1,63); ev_teach(W,63,1,64);
  ev_teach(W,64,2,65); ev_teach(W,65,2,66); ev_teach(W,66,2,67);
  let z:i32=ev_query(W,61,50,67,0);
  emit("C2-Z ans="); e64(z); kc_tstat(W);
  kc_zreport(W,61,50);
  return;
}
fn kc_c2_fresh(W:[]u8)void {
  emit("=== C2-FRESH ===\n");
  kc_gap(W);
  ev_teach(W,61,1,62); ev_teach(W,62,1,63); ev_teach(W,63,1,64);
  ev_teach(W,64,2,65); ev_teach(W,65,2,66); ev_teach(W,66,2,67);
  let z:i32=ev_query(W,61,50,67,0);
  emit("C2-Z ans="); e64(z); kc_tstat(W);
  return;
}

// ============ Combination 3: cross-length, same relation, plen 5 ============
// X: r1 plen-3. Y: r1 plen-4. Z: r1 plen-5.
fn kc_c3_trainXY(W:[]u8)void {
  ev_teach(W,71,1,72); ev_teach(W,72,1,73);
  let x1:i32=ev_query(W,71,65,73,0);
  emit("C3-X1 ans="); e64(x1); kc_tstat(W);
  ev_teach(W,74,1,75); ev_teach(W,75,1,76);
  let x2:i32=ev_query(W,74,65,76,0);
  emit("C3-X2 ans="); e64(x2); kc_tstat(W);
  ev_teach(W,81,1,82); ev_teach(W,82,1,83); ev_teach(W,83,1,84);
  let y1:i32=ev_query(W,81,66,84,0);
  emit("C3-Y1 ans="); e64(y1); kc_tstat(W);
  ev_teach(W,85,1,86); ev_teach(W,86,1,87); ev_teach(W,87,1,88);
  let y2:i32=ev_query(W,85,66,88,0);
  emit("C3-Y2 ans="); e64(y2); kc_tstat(W);
  emit("C3 maps="); e64(kc_count_maps(W)); emit(" link14="); e64(kc_count14(W)); emit("\n");
  return;
}
fn kc_c3_zfacts(W:[]u8)void {
  ev_teach(W,91,1,92); ev_teach(W,92,1,93); ev_teach(W,93,1,94);
  ev_teach(W,94,1,95);
  return;
}
fn kc_c3_zquery(W:[]u8)void {
  let z:i32=ev_query(W,91,50,95,0);
  emit("C3-Z ans="); e64(z); kc_tstat(W);
  kc_zreport(W,91,50);
  return;
}
fn kc_c3_treat(W:[]u8)void {
  emit("=== C3-TREAT ===\n");
  kc_c3_trainXY(W);
  kc_gap(W);
  kc_c3_zfacts(W);
  kc_c3_zquery(W);
  return;
}
fn kc_c3_abl(W:[]u8)void {
  emit("=== C3-ABL ===\n");
  kc_c3_trainXY(W);
  kc_del_maps(W);
  emit("C3-ABL maps after del="); e64(kc_count_maps(W)); emit("\n");
  kc_gap(W);
  kc_c3_zfacts(W);
  kc_c3_zquery(W);
  return;
}
fn kc_c3_fresh(W:[]u8)void {
  emit("=== C3-FRESH ===\n");
  kc_gap(W);
  kc_c3_zfacts(W);
  kc_c3_zquery(W);
  return;
}

fn main()i32 {
  emit("COMP-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); kc_c1_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); kc_c1_paired(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); kc_c1_abl(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); kc_c1_fresh(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); kc_c2_treat(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); kc_c2_fresh(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); kc_c3_treat(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); kc_c3_abl(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); kc_c3_fresh(W9);
  emit("COMP-END\n");
  return 0;
}

// ============ Integration driver: I1, I2, I3 ============
// I1: No interference. All three mechanisms work together.
// I2: Synergy. Integrated (I) outperforms prediction-only (P) and
//     source-only (S) on disagreeing reliability cases.
// I3: Ablation. Each mechanism is load-bearing; no-substrate withholds.
//
// Ground truth:
//   X (10,50): pred-reliable (4/4), source-unreliable (B 2/12).
//              Predicts 100, true is 200. Trust is WRONG.
//   Z (30,50): pred-unreliable (0/3), source-reliable (A 12/12).
//              Predicts 300, true is 400. Trust is WRONG.
//   Y (20,50): pred-reliable (4/4), source-reliable (A 12/12).
//              Predicts 500, true is 500. Trust is RIGHT.
//
// Expected: P=2/3 (wrong on X), S=2/3 (wrong on Z), I=3/3.

fn rsv_print_rel(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==3){
      e64(ng(W,n,8)); emit(" ");
      e64(ng(W,n,12)); emit(" ");
      e64(ng(W,n,24)); emit("/");
      e64(ng(W,n,20)); emit(" cf");
      e64(ng(W,n,16)); emit("; ");
    }
    n=n+1;
  }
  emit("\n");
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  se_cfg_set(W,31);

  // ---- Phase S: source reliability (12 rounds) ----
  let i:i32=0;
  while(i<12){
    ev_teach_src(W,1,50,42,7);
    if(i==3 || i==7){ ev_teach_src(W,1,50,42,8); }
    else { ev_teach_src(W,1,50,99,8); }
    ev_observe_src_sub(W,1,50,42);
    i=i+1;
  }
  emit("I1a src_query: ");
  ev_teach_src(W,2,50,42,7);
  ev_teach_src(W,2,50,99,8);
  let sq:i32=src_query_sub(W,2,50);
  e64(sq); emit(" (expect 42)\n");
  if(sq!=42){ emit("I1a FAIL\n"); return 1; }
  emit("I1a PASS\n");

  // ---- Phase P: prediction reliability ----
  ev_teach_src(W,10,50,100,8);
  i=0;
  while(i<4){
    let px:i32=ev_predict(W,10,50);
    if(px!=100){ emit("X pred mismatch\n"); return 1; }
    ev_observe_rsv(W,10,50,100);
    i=i+1;
  }
  // Z (30,50)=300 from A. Simulate 3 wrong predictions via direct
  // substrate writes (0/3, cf=3). The pred_resolve_sub mechanism is
  // validated by X's real cycles; here we set up the test condition.
  // Z remains the sole predictor for (30,50); its prediction (300) is
  // WRONG (true=400).
  let z_node:i32=ev_teach_src(W,30,50,300,7);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  ns(W,z_node,8,-3);
  let pz0:i32=ev_predict(W,30,50);
  if(pz0!=300){ emit("Z setup mismatch\n"); return 1; }
  ev_teach_src(W,20,50,500,7);
  i=0;
  while(i<4){
    let py:i32=ev_predict(W,20,50);
    if(py!=500){ emit("Y pred mismatch\n"); return 1; }
    ev_observe_rsv(W,20,50,500);
    i=i+1;
  }
  emit("I1b ev_predict ok\n");
  emit("substrate reliability: ");
  rsv_print_rel(W);

  // ---- I1c: substrate 5-behavior withholding still works ----
  let q1:i32=ev_query(W,99,99,-999,0);
  let q2:i32=ev_query(W,99,99,-999,0);
  let q3:i32=ev_query(W,99,99,-999,0);
  let q4:i32=ev_query(W,99,99,-999,0);
  emit("I1c withhold: ");
  e64(q1); emit(" "); e64(q2); emit(" "); e64(q3); emit(" "); e64(q4);
  emit(" (expect -2 -2 -2 -3)\n");
  if(q4!=-3){ emit("I1c FAIL\n"); return 1; }
  emit("I1c PASS\n");

  // ---- I2: synergy across arms ----
  se_cfg_set(W,63);
  let p_x:i32=rsv_trust(W,10,50);
  let p_z:i32=rsv_trust(W,30,50);
  let p_y:i32=rsv_trust(W,20,50);
  se_cfg_set(W,95);
  let s_x:i32=rsv_trust(W,10,50);
  let s_z:i32=rsv_trust(W,30,50);
  let s_y:i32=rsv_trust(W,20,50);
  se_cfg_set(W,127);
  let i_x:i32=rsv_trust(W,10,50);
  let i_z:i32=rsv_trust(W,30,50);
  let i_y:i32=rsv_trust(W,20,50);

  emit("I2 P arm: X="); e64(p_x);
  emit(" Z="); e64(p_z); emit(" Y="); e64(p_y); emit("\n");
  emit("I2 S arm: X="); e64(s_x);
  emit(" Z="); e64(s_z); emit(" Y="); e64(s_y); emit("\n");
  emit("I2 I arm: X="); e64(i_x);
  emit(" Z="); e64(i_z); emit(" Y="); e64(i_y); emit("\n");

  let ps:i32=0; let ss:i32=0; let ins:i32=0;
  if(p_x==-3){ps=ps+1;} if(p_z==-3){ps=ps+1;} if(p_y==500){ps=ps+1;}
  if(s_x==-3){ss=ss+1;} if(s_z==-3){ss=ss+1;} if(s_y==500){ss=ss+1;}
  if(i_x==-3){ins=ins+1;} if(i_z==-3){ins=ins+1;} if(i_y==500){ins=ins+1;}
  emit("I2 scores P="); e64(ps);
  emit("/3 S="); e64(ss); emit("/3 I="); e64(ins); emit("/3\n");
  emit("I2 synergy: ");
  if(ins==3 && ps==2 && ss==2){ emit("PASS\n"); }
  else { emit("FAIL\n"); return 1; }

  // ---- I3c: no reliability bits -> withhold (no basis) ----
  se_cfg_set(W,31);
  let nb:i32=rsv_trust(W,20,50);
  emit("I3c no-substrate: "); e64(nb); emit(" (expect -3)\n");
  if(nb!=-3){ emit("I3c FAIL\n"); return 1; }
  emit("I3c PASS\n");

  emit("ALL PASS\n");
  return 0;
}

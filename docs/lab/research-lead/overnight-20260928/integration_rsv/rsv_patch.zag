// ============ Integration: Reliability to Substrate to Verification ============
// Integrates C181 (learner-verification), C183 (provenance-learning),
// C185 (substrate-expansion) into ONE system per Constitution One-System Rule.
//
// Design:
//   - Prediction reliability (C181) writes to shared substrate (tag-61,
//     kt=3 RELIABILITY, ka=0 prediction-struct, kb=struct node id).
//   - Source reliability (C183) writes to the SAME substrate (kt=3,
//     ka=1 source, kb=source id 7/8). The private rel store is REMOVED;
//     substrate is the single store (fewer subsystems, not more).
//   - Verification (C181) consults substrate records with BOTH reliabilities.
//   - Substrate drives 5 behaviors (C185, unchanged) PLUS verification (6th).
//
// Researcher scaffold (honest): kt=3/ka/kb layout, reliability thresholds,
//   config bits, trust decision structure.
// Learner-owned: all reliability VALUES, which predictors/sources are
//   trusted, the accept/reject/withhold judgments.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.

// ---- integration config bits (extend se tag-904 bitmask) ----
fn SE_B_PRED()i32 { return 32; }  // prediction-reliability read enabled
fn SE_B_SRC()i32 { return 64; }   // source-reliability read enabled
// Arm configs (base 31 = 5 behaviors):
//   P (prediction-only): 63. S (source-only): 95. I (integrated): 127.
//   No-reliability: 31 (verification withholds: no basis).

// ---- substrate key type for reliability ----
fn SUB_RELIAB()i32 { return 3; }
fn REL_PRED()i32 { return 0; }  // ka=0: prediction-structure reliability
fn REL_SRC()i32 { return 1; }   // ka=1: source reliability

// ============ Prediction machinery (from C181 lv_base, verbatim) ============
fn T_PRED()i32 { return 31; }
fn score_on()i32 { return 1; }

fn pred_record(W:[]u8,s:i32,r:i32,p:i32,sid:i32,kind:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,sid); ns(W,n,16,kind);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

fn ev_predict(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bs:i32=-999999; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let sc:i32=0;
        if(score_on()==1){ sc=ng(W,n,8); }
        let b:i32=bid(W,n);
        if(sc>bs || (sc==bs && b>bb)){ bs=sc; bb=b; best=n; }
      }
    }
    n=n+1;
  }
  if(best>=0){
    let p:i32=ng(W,best,28);
    pred_record(W,s,r,p,best,1);
    return p;
  }
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      let root:i32=ng(W,m,20);
      let v:i32=t2_exec(W,root,s);
      if(v!=-999999){
        if(ng(W,m,12)==-1){ ns(W,m,12,0); ns(W,m,16,0); }
        pred_record(W,s,r,v,m,20);
        return v;
      }
    }
    m=m+1;
  }
  return -999999;
}

// pred_resolve with INTEGRATION: prediction consequences also written to
// the shared substrate (kt=3, ka=0, kb=sid). The local pred_score is kept
// for ev_predict's ranking scan; the substrate record is the shared,
// cross-mechanism consequence. Only kind=1/20 PREDs write (pl PREDs
// with kind=0 are ignored, avoiding layout confusion).
fn pred_resolve_sub(W:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let err:i32=0;
        if(ng(W,n,28)!=o){ err=1; }
        ns(W,n,4,1); ns(W,n,8,err);
        if(score_on()==1){
          let sid:i32=ng(W,n,12); let kind:i32=ng(W,n,16);
          if(sid>=2 && ng(W,sid,36)==1){
            let d:i32=1; let ok:i32=1;
            if(err==1){ d=-1; ok=0; }
            if(kind==1){
              ns(W,sid,8,ng(W,sid,8)+d);
              sub_note(W,SUB_RELIAB(),REL_PRED(),sid,ok,0,SUB_SRC_OBS(),0,1);
            }
            else { if(kind==20){
              ns(W,sid,12,ng(W,sid,12)+d);
              ns(W,sid,16,ng(W,sid,16)+1);
              sub_note(W,SUB_RELIAB(),REL_PRED(),sid,ok,0,SUB_SRC_OBS(),0,1);
            }}
          }
        }
      }
    }
    n=n+1;
  }
  return;
}

// ev_observe with prediction resolution (substrate-writing) appended.
fn ev_observe_rsv(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let r0:i32=ev_observe(W,s,r,o);
  pred_resolve_sub(W,s,r,o);
  return r0;
}

// ============ Source machinery (from C183 pl_patch, substrate-backed) ============
// Source tags (field 16 on tag-1 FACT): 7=SRC_A, 8=SRC_B. 1=OBSERVED.
// The private rel store (tag-61 f28=src) is REMOVED. Reliability lives
// in the shared substrate: kt=3, ka=1, kb=src. f24=successes (correct),
// f20=attempts (total), f16=consec_fail. One store, not two.
fn SRC_A()i32 { return 7; }
fn SRC_B()i32 { return 8; }

fn ev_teach_src(W:[]u8,s:i32,r:i32,o:i32,src:i32)i32 {
  let n:i32=ev_teach(W,s,r,o);
  if(n>=2){ ns(W,n,16,src); }
  return n;
}

fn claims(W:[]u8,s:i32,r:i32,out:[]u8)void {
  set32(out,0,-999999); set32(out,4,-999999);
  set32(out,8,-1); set32(out,12,-1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      let src:i32=ng(W,n,16); let tick:i32=ng(W,n,32);
      if(src==7 && tick>get32(out,8)){
        set32(out,8,tick); set32(out,0,ng(W,n,28));
      } else { if(src==8 && tick>get32(out,12)){
        set32(out,12,tick); set32(out,4,ng(W,n,28));
      }}
    }
    n=n+1;
  }
  return;
}

// Substrate-backed reliability read (replaces pl rel_get).
// out[0]=correct (successes), out[1]=total (attempts).
fn rel_sub_get(W:[]u8,src:i32,out:[]u8)void {
  set32(out,0,0); set32(out,4,0);
  let n:i32=sub_find(W,SUB_RELIAB(),REL_SRC(),src);
  if(n>=0){
    set32(out,0,ng(W,n,24));
    set32(out,4,ng(W,n,20));
  }
  return;
}

fn pred_record_src(W:[]u8,s:i32,r:i32,p:i32,cred:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31); ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,cred);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// src_query with substrate-backed reliability (replaces pl src_query).
// Disagreement: prefer higher correct/total from SUBSTRATE records.
fn src_query_sub(W:[]u8,s:i32,r:i32)i32 {
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  let ta:i32=get32(cl,8); let tb:i32=get32(cl,12);
  let p:i32=-2; let cred:i32=0;
  if(va==-999999 && vb==-999999){return -2;}
  else { if(vb==-999999){p=va; cred=7;}
  else { if(va==-999999){p=vb; cred=8;}
  else { if(va==vb){p=va; cred=9;}
  else {
    let pick:i32=7;
    let ra:[]u8=z_alloc(8); let rb:[]u8=z_alloc(8);
    rel_sub_get(W,7,ra); rel_sub_get(W,8,rb);
    let ca:i32=get32(ra,0); let toa:i32=get32(ra,4);
    let cb:i32=get32(rb,0); let tob:i32=get32(rb,4);
    if(toa==0 && tob==0){if(tb>ta){pick=8;}}
    else { if(toa==0){pick=8;}
    else { if(tob==0){pick=7;}
    else {
      let la:i32=ca*tob; let lb:i32=cb*toa;
      if(lb>la){pick=8;}
      else { if(la==lb){ if(tb>ta){pick=8;} } }
    }}}
    if(pick==7){p=va; cred=7;} else {p=vb; cred=8;}
  }}}}
  pred_record_src(W,s,r,p,cred);
  return p;
}

// ev_observe_src with substrate-backed reliability writes
// (replaces pl rel_bump). Both sources scored, written to substrate.
fn ev_observe_src_sub(W:[]u8,s:i32,r:i32,o:i32)i32 {
  ev_teach_src(W,s,r,o,1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      ns(W,n,4,1);
      if(ng(W,n,28)==o){ns(W,n,8,0);} else {ns(W,n,8,1);}
    }
    n=n+1;
  }
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  if(va!=-999999){
    let ok:i32=0; if(va==o){ok=1;}
    sub_note(W,SUB_RELIAB(),REL_SRC(),7,ok,0,SUB_SRC_OBS(),0,1);
  }
  if(vb!=-999999){
    let ok:i32=0; if(vb==o){ok=1;}
    sub_note(W,SUB_RELIAB(),REL_SRC(),8,ok,0,SUB_SRC_OBS(),0,1);
  }
  return 1;
}

// ============ Integrated verification (6th substrate behavior) ============
// Verification consults substrate records with BOTH prediction reliability
// AND source reliability. The reliability VALUES are learner-owned; the
// thresholds and decision structure are researcher scaffold (honest).

fn rsv_pred_rel(W:[]u8,sid:i32)i32 {
  // 1 if predictor is prediction-reliable per substrate. Caller gates bit.
  let n:i32=sub_find(W,SUB_RELIAB(),REL_PRED(),sid);
  if(n<0){ return 0; }
  let att:i32=ng(W,n,20); let suc:i32=ng(W,n,24); let cf:i32=ng(W,n,16);
  if(att<3){ return 0; }
  if(suc*2<att){ return 0; }
  if(cf>=2){ return 0; }
  return 1;
}

fn rsv_src_rel(W:[]u8,src:i32)i32 {
  // 1 if source is reliable per substrate. Caller gates bit.
  let n:i32=sub_find(W,SUB_RELIAB(),REL_SRC(),src);
  if(n<0){ return 0; }
  let att:i32=ng(W,n,20); let suc:i32=ng(W,n,24);
  if(att<2){ return 0; }
  if(suc*2<att){ return 0; }
  return 1;
}

// Integrated trust gate. Returns:
//   p (>=0): prediction TRUSTED (verification accepts).
//   -3: WITHHELD (no basis, or reliability fails).
//   -999999: no prediction basis at all.
// The decision consults BOTH reliabilities from the shared substrate.
fn rsv_trust(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=ev_predict(W,s,r);
  if(p==-999999){ return -999999; }
  // Find the predictor: the PRED node just created (highest index,
  // unresolved, matching s,r). Mirrors lv_setup.
  let bn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      bn=n;
    }
    n=n+1;
  }
  let sid:i32=-1; let kind:i32=0;
  if(bn>=0){
    sid=ng(W,bn,12); kind=ng(W,bn,16);
  }
  let pred_on:i32=se_cfg_on(W,SE_B_PRED());
  let src_on:i32=se_cfg_on(W,SE_B_SRC());
  // No reliability mechanism: no basis for trust. Withhold (safe).
  if(pred_on==0 && src_on==0){ return -3; }
  if(sid<2){ return -3; }
  // Prediction reliability (from shared substrate).
  if(pred_on==1 && rsv_pred_rel(W,sid)==0){ return -3; }
  // Source reliability (from shared substrate), if predictor has a source.
  let src:i32=0;
  if(kind==1){ src=ng(W,sid,16); }
  if(src_on==1 && (src==7 || src==8) && rsv_src_rel(W,src)==0){ return -3; }
  return p;
}

// ---- P-INT5: DEVINT-CLA2 11 stages (compact curriculum) ----
fn t_dv()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // S1-S2: teach episodes, segment (teach 12)
  let i:i32=0;
  while(i<12){ev_teach(W,100+i,1,200+i); i=i+1;}
  // S3: form 4 groups
  let g0:i32=alloc_node(W); ns(W,g0,0,2);
  let g1:i32=alloc_node(W); ns(W,g1,0,2);
  let g2:i32=alloc_node(W); ns(W,g2,0,2);
  let g3:i32=alloc_node(W); ns(W,g3,0,2);
  // S4: bigram edges (link 12)
  i=0; while(i<11){link_edge(W,100+i,1,101+i,0); i=i+1;}
  // S5: 5 rules via exact key (simplified)
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let r1:i32=ev_query(W,1,11,-2,0);
  // S6: procedure executes (via exact key)
  // S7: contradiction
  ev_teach(W,50,21,60); ev_observe(W,50,21,61);
  // S8: inquiry via uncertainty
  let u:i32=alloc_node(W); ns(W,u,0,30); ns(W,u,4,70);
  // S9: demotion with history
  // S10: eviction pressure (60 teaches)
  i=0; while(i<60){ev_teach(W,600+i,31,i); i=i+1;}
  // S11: delayed reuse (query stage-1 facts)
  let ok:i32=1; i=0;
  while(i<12){if(ev_query(W,100+i,1,-2,0)!=200+i){ok=0;} i=i+1;}
  if(r1==2 && ok==1){return 1;} return 0;
}
// ---- F-INT4: cross-capability integration ----
fn t_xcap()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // teach chain, query miss builds plan, promotes MAP
  ev_teach(W,101,11,102); ev_teach(W,101,12,105);
  ev_teach(W,102,12,201); ev_teach(W,105,11,202);
  let ans:i32=ev_query(W,101,40,201,0);
  if(ans!=201){return 0;}
  // create a guide node (simulating a MAP that guides action)
  let m:i32=alloc_node(W);
  if(m<2){return 0;}
  ns(W,m,0,20); write_node(W,m,77,505,0,0); ns(W,m,24,hg(W,24));
  ns(W,m,32,1); ns(W,m,36,1); ns(W,m,4,505);
  // give it positive bid via self-loop
  link_edge(W,m,6,m,0);
  let b0:i32=bid(W,m);
  if(b0<=0){return 0;}
  // contradict the guide: both query standing and action candidacy demote
  contradict_map(W,m);
  let st:i32=map_standing(W,m);
  let b:i32=bid(W,m);
  if(st<0 && b<b0){return 1;} return 0;
}
// ============ main ============
// ============ TNN-2 new tests: the three changes ============
// Change 1: runtime construction. 4-hop chain: beyond the removed
// templates' ceiling (3-hop via compose-by-cloning). The winning graph is
// assembled at runtime by the trial loop and executed by execute().
fn t_t2_chain4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a:i32=ev_query(W,1,40,5,0);
  if(a==5){return 1;} return 0;
}
// Change 1: anti-theater. t_p4 pattern: two candidates tried and genuinely
// rejected before the 3-hop winner verifies. Trial stats packed in hdr+16.
fn t_t2_trial_reject()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,101,12,107); ev_teach(W,102,12,103);
  ev_teach(W,102,19,108); ev_teach(W,103,13,104); ev_teach(W,103,19,109);
  let a:i32=ev_query(W,101,40,104,0);
  let st:i32=hg(W,16); let tried:i32=st/1024; let rej:i32=st-tried*1024;
  if(a==104 && tried>=3 && rej>=2){return 1;} return 0;
}
// Change 2: miss-to-act. The miss path itself reifies UNCERTAINTY and
// constructs the POLICY_ROOT-linked guide (no scaffolding).
fn t_t2_inquire()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  let u:i32=-1; let g:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1){
      if(ng(W,n,0)==30 && ng(W,n,20)==9002 && ng(W,n,24)==77){u=n;}
      if(ng(W,n,0)==1 && ng(W,n,4)==9002 && ng(W,n,20)==30){g=n;}
    }
    n=n+1;
  }
  if(u<0 || g<0){return 0;}
  let pr:i32=pol_get(W); if(pr<2){return 0;}
  let e1:i32=0; let e2:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      if(eg(W,e,0)==g && eg(W,e,4)==1 && eg(W,e,8)==u){e1=1;}
      if(eg(W,e,0)==pr && eg(W,e,4)==10 && eg(W,e,8)==g){e2=1;}
    }
    e=e+1;
  }
  if(e1==1 && e2==1){return 1;} return 0;
}
// Change 2: the act path is live. ev_act over the miss-constructed guide
// returns 30 (inquiry act), not the hardcoded 0 fallback.
fn t_t2_actlive()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){return 0;}
  ctx_push(W,9002);
  let c:i32=ev_act(W);
  if(c==30){return 1;} return 0;
}
// Change 3: generic revision. Promote a 2-hop chain answering 201, then
// contradict a licensing fact via the public observe path. The graph must
// be restructured (topology change, verified by re-execution), the promoted
// answer updated to 999, and map standing untouched (not a demotion).
fn t_t2_revise()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  if(ev_query(W,101,40,201,0)!=201){return 0;}
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==40){m=n;}
    n=n+1;
  }
  if(m<0){return 0;}
  let root:i32=ng(W,m,20);
  let st0:i32=map_standing(W,m);
  let sig0:[]u8=z_alloc(256); let c0:i32=t2_sig(W,root,sig0);
  if(ev_observe(W,102,12,999)!=0){return 0;}
  if(t2_exec(W,root,101)!=999){return 0;}
  let sig1:[]u8=z_alloc(256); let c1:i32=t2_sig(W,root,sig1);
  let diff:i32=0;
  if(c0!=c1){diff=1;}
  else {
    let i:i32=0;
    while(i<c0){
      if(get32(sig0,i*8)!=get32(sig1,i*8) || get32(sig0,i*8+4)!=get32(sig1,i*8+4)){diff=1;}
      i=i+1;
    }
  }
  if(diff==0){return 0;}
  if(map_standing(W,m)!=st0){return 0;}
  if(ev_query(W,101,40,-2,0)!=999){return 0;}
  return 1;
}
fn SUB_TAG()i32 { return 61; }
fn SUB_PURSUIT()i32 { return 1; }
fn SUB_STRATEGY()i32 { return 2; }
fn SUB_F6()i32 { return 6; }
fn SUB_SRC_TAUGHT()i32 { return 0; }
fn SUB_SRC_OBS()i32 { return 1; }
fn SUB_SRC_SELF()i32 { return 2; }
fn SUB_ST_ACTIVE()i32 { return 0; }

fn sub_src_get(p:i32,k:i32)i32 {
  if(k==0){ return p%1024; }
  if(k==1){ return (p/1024)%1024; }
  return (p/1048576)%1024;
}
fn sub_src_inc(p:i32,k:i32)i32 {
  let v:i32=sub_src_get(p,k);
  if(v>=1023){ return p; }
  if(k==0){ return p+1; }
  if(k==1){ return p+1024; }
  return p+1048576;
}
fn sub_life_state(l:i32)i32 { return l%4; }
fn sub_life_mode(l:i32)i32 { return (l/4)%128; }
fn sub_life_cost(l:i32)i32 { return l/512; }
fn sub_life_mk(st:i32,md:i32,c:i32)i32 {
  let cc:i32=c; if(cc>4194303){ cc=4194303; }
  return (st%4)+(md%128)*4+cc*512;
}

// Generic keyed lookup. Shared by all consumers; knows nothing about decline.
fn sub_find(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==kt && ng(W,n,8)==ka && ng(W,n,12)==kb){ return n; }
    n=n+1;
  }
  return -1;
}
fn sub_get(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n>=0){ return n; }
  n=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,kt); ns(W,n,8,ka); ns(W,n,12,kb);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
// Generic consequence write (spec 4.2). success: 1 ok / 0 fail.
// mode: F1-F7 on failure, 0 on success. src: 0 taught / 1 observed / 2 self.
// cost: nodes allocated by this attempt. create: make the record if absent
// (spec 4.1: creation on first miss or trial, not on answers from memory).
fn sub_note(W:[]u8,kt:i32,ka:i32,kb:i32,success:i32,mode:i32,src:i32,cost:i32,create:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){
    if(create==0){ return -1; }
    n=sub_get(W,kt,ka,kb); if(n<0){ return -1; }
  }
  ns(W,n,20,ng(W,n,20)+1);
  ns(W,n,28,sub_src_inc(ng(W,n,28),src));
  let st:i32=sub_life_state(ng(W,n,32));
  let nc:i32=sub_life_cost(ng(W,n,32))+cost;
  if(success==1){
    ns(W,n,24,ng(W,n,24)+1);
    ns(W,n,16,0);
    ns(W,n,32,sub_life_mk(st,0,nc));
  } else {
    ns(W,n,16,ng(W,n,16)+1);
    ns(W,n,32,sub_life_mk(st,mode,nc));
  }
  return n;
}
// Generic production read: consecutive failures for a key, 0 when no record.
fn sub_consec(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){ return 0; }
  return ng(W,n,16);
}

fn sc_n()i32 { return 3; }
fn sc_withhold()i32 { return -3; }

// se_behaviors.zag -- five behaviors driven by ONE consequence substrate.
// UNFROZEN variant, base sc_base.zag (frozen a29972ca) minus
// evict_node/miss_inquire/ev_query, which this file replaces.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases. No em/en dashes.
//
// Substrate record (tag 61): f4 key_type (1 PURSUIT, 2 STRATEGY),
// f8 key_a, f12 key_b, f16 consec_fail, f20 attempts, f24 successes,
// f28 src packed, f32 life packed (state/mode/cost).
//
// Shared fields (the same record fields drive multiple behaviors):
//   PURSUIT.consec_fail  -> behavior 2 (withholding, >=3)
//                        -> behavior 3 (abandonment, >=6)
//   PURSUIT.life.state   -> behavior 3 (ABANDONED mark)
//                        -> behavior 4 (retention reclaims ABANDONED first)
//   STRATEGY.successes   -> behavior 1 (policy argmax, key_b=0)
//                        -> behavior 5 (search-order ranking, key_b=1)
//
// Config node (tag 904, f20 bitmask) gates READS only; writes are
// unconditional, so an ablation can only differ through the read path.
// Bits: 1 policy, 2 withhold, 4 abandon, 8 retention, 16 order.

// ---- behavior config ----
fn SE_CFG_TAG()i32 { return 904; }
fn SE_B_POLICY()i32 { return 1; }
fn SE_B_WITHHOLD()i32 { return 2; }
fn SE_B_ABANDON()i32 { return 4; }
fn SE_B_RETENTION()i32 { return 8; }
fn SE_B_ORDER()i32 { return 16; }
fn se_cfg(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SE_CFG_TAG()){ return ng(W,n,20); }
    n=n+1;
  }
  return 31;
}
fn se_cfg_set(W:[]u8,m:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SE_CFG_TAG()){ ns(W,n,20,m); return; }
    n=n+1;
  }
  n=alloc_node(W); if(n<0){return;}
  ns(W,n,0,SE_CFG_TAG()); ns(W,n,20,m);
  // Protect the config node itself: it must survive memory pressure,
  // or its eviction would silently flip the ablation back to full (31).
  // Type-9 self-edge with a large clock; decay decrements it slowly.
  link_edge(W,n,9,n,1000000);
  return;
}
fn se_cfg_on(W:[]u8,b:i32)i32 {
  if((se_cfg(W)&b)!=0){ return 1; }
  return 0;
}

// ---- behavior 3 helpers: abandonment ----
// Abandonment = permanent decision to stop pursuing a key.
// Withholding (behavior 2) and abandonment share PURSUIT.consec_fail:
// every withhold writes consec_fail+1 (a withhold IS a continued
// failure to resolve), so the same field crosses threshold 3
// (withhold) then threshold 6 (abandon).
// State 1 (ABANDONED) is new to this build; fa8405a90 only defined
// state 0 (ACTIVE). Abandonment = permanent stop pursuing a key.
fn SUB_ST_ABANDONED()i32 { return 1; }
fn se_abandon_n()i32 { return 6; }
fn se_abandon_ret()i32 { return -4; }
fn se_life(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){ return 0; }
  return ng(W,n,32);
}
fn se_is_abandoned(W:[]u8,s:i32,r:i32)i32 {
  if(sub_life_state(se_life(W,SUB_PURSUIT(),s,r))==SUB_ST_ABANDONED()){ return 1; }
  return 0;
}
fn se_mark_abandoned(W:[]u8,s:i32,r:i32)void {
  let n:i32=sub_find(W,SUB_PURSUIT(),s,r);
  if(n<0){ return; }
  let l:i32=ng(W,n,32);
  ns(W,n,32,sub_life_mk(SUB_ST_ABANDONED(),sub_life_mode(l),sub_life_cost(l)));
  return;
}

// ---- behavior 1: action-policy via STRATEGY(action,0) ----
// fa8405a90 implementations verbatim, except: the sub_best_action read
// in miss_inquire is gated on SE_B_POLICY, and sub_best_action gains a
// key_b==0 filter (behavior 5 stores per-relation records under
// key_b=1; without the filter those would pollute the policy argmax).
fn sub_best_action(W:[]u8)i32 {
  let best:i32=30; let best_s:i32=0; let found:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==SUB_STRATEGY() && ng(W,n,12)==0){
      let a:i32=ng(W,n,8); let s:i32=ng(W,n,24);
      if(found==0 || s>best_s || (s==best_s && a<best)){
        best=a; best_s=s; found=1;
      }
    }
    n=n+1;
  }
  return best;
}
fn sb_resolve_aw(W:[]u8,s:i32,r:i32,a_w:i32)void {
  let u:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){u=n; break;}
    }
    n=n+1;
  }
  if(u<0){return;}
  link_edge(W,u,3,u,0);
  let g:i32=-1; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==u){
      g=eg(W,e,0); break;
    }
    e=e+1;
  }
  if(g>=2){
    link_edge(W,g,3,g,0);
  }
  if(a_w>=0){
    sub_note(W,SUB_STRATEGY(),a_w,0,1,0,SUB_SRC_OBS(),0,1);
  }
  return;
}
fn ev_observe_aw(W:[]u8,s:i32,r:i32,o:i32,a_w:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0); return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0); return 0;
  }
  ev_teach_in(W,s,r,o);
  sb_resolve_aw(W,s,r,a_w);
  log_ev(W,4,s,r,o,1,0,0); return 1;
}
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  let act:i32=30;
  if(se_cfg_on(W,SE_B_POLICY())==1){ act=sub_best_action(W); }
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,act,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}

// ---- behavior 5: search-order via STRATEGY(rel,1) ----
// Per-relation trial successes live in the SAME successes field as
// behavior 1, under a disjoint key namespace (key_b=1 vs key_b=0).
// Write: credit assignment after a verified trial attributes the
// answer to the relation whose chain reproduces it (skipping the
// queried relation itself, whose fact was just taught by promotion).
// Read: se_prepass tries the historically best relation's chain
// first, falling back to the full trial on miss.
fn se_rel_score(W:[]u8,rel:i32)i32 {
  let n:i32=sub_find(W,SUB_STRATEGY(),rel,1);
  if(n<0){ return 0; }
  return ng(W,n,24);
}
fn se_top_rel(W:[]u8)i32 {
  let best:i32=-1; let best_s:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==SUB_STRATEGY() && ng(W,n,12)==1){
      let r:i32=ng(W,n,8); let s:i32=ng(W,n,24);
      if(s>0 && (best<0 || s>best_s || (s==best_s && r<best))){
        best=r; best_s=s;
      }
    }
    n=n+1;
  }
  return best;
}
fn se_vc_add(W:[]u8,tried:i32,rej:i32)void {
  hs(W,16,hg(W,16)+tried*1024+rej);
  return;
}
fn se_prepass(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let rel:i32=se_top_rel(W);
  if(rel<0){ return -2; }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s,rel,v,f);
  if(len<2){ return -2; }
  let root:i32=t2_asm_chain(W,v,len,f);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let v2:i32=t2_try_verify(W,root,s,expected,0,st);
  se_vc_add(W,get32(st,0),get32(st,4));
  if(v2!=-2){
    promote_graph(W,root,s,r,v2,f,len-1);
    sub_note(W,SUB_STRATEGY(),rel,1,1,0,SUB_SRC_TAUGHT(),0,1);
  }
  return v2;
}
fn se_attrib(W:[]u8,s:i32,r:i32,ans:i32)void {
  let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
  let i:i32=0;
  while(i<nr){
    let rel:i32=get32(rb,i*4);
    if(rel!=r && rel!=-999){
      let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
      let len:i32=t2_chain(W,s,rel,v,f);
      if(len>=2){
        let root:i32=t2_asm_chain(W,v,len,f);
        if(root>=0){
          let out:i32=t2_exec(W,root,s);
          if(out==ans){
            sub_note(W,SUB_STRATEGY(),rel,1,1,0,SUB_SRC_TAUGHT(),0,1);
          }
        }
      }
    }
    i=i+1;
  }
  return;
}
fn se_mp_run(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  let ans:i32=-2;
  if(se_cfg_on(W,SE_B_ORDER())==1){
    ans=se_prepass(W,s,r,expected);
  }
  if(ans==-2){
    ans=t2_trial(W,s,r,expected,(flags&1),((flags>>1)&1),((flags>>2)&1));
    if(ans!=-2){ se_attrib(W,s,r,ans); }
  }
  return ans;
}

// ---- ev_query: behaviors 2+3 reads, behavior 1/5 via helpers ----
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  // behavior 3 read: an abandoned key is never pursued again.
  // Checked before activation: abandonment survives later teaching.
  if(se_cfg_on(W,SE_B_ABANDON())==1 && se_is_abandoned(W,s,r)==1){
    log_ev(W,2,s,r,se_abandon_ret(),0,0,0); return se_abandon_ret();
  }
  let qn0:i32=hg(W,20);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),0,0);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // behavior 2 read: withhold when consecutive failures reach N.
  // Discipline: a withhold writes consec_fail+1 (it IS a continued
  // failure to resolve), so the same field feeds behavior 3.
  if(se_cfg_on(W,SE_B_WITHHOLD())==1){
    let cf:i32=sub_consec(W,SUB_PURSUIT(),s,r);
    if(cf>=sc_n()){
      sub_note(W,SUB_PURSUIT(),s,r,0,SUB_F6(),SUB_SRC_TAUGHT(),0,1);
      let cf2:i32=sub_consec(W,SUB_PURSUIT(),s,r);
      // behavior 3 write: sustained non-resolution abandons the key.
      if(se_cfg_on(W,SE_B_ABANDON())==1 && cf2>=se_abandon_n()){
        se_mark_abandoned(W,s,r);
        log_ev(W,2,s,r,se_abandon_ret(),cf2,se_abandon_n(),0);
        return se_abandon_ret();
      }
      log_ev(W,2,s,r,sc_withhold(),cf2,sc_n(),0);
      return sc_withhold();
    }
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let v0:i32=hg(W,16);
  let ans:i32=se_mp_run(W,s,r,expected,flags);
  let vc:i32=hg(W,16)-v0;
  if(ans!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,bv,1,0,0); return bv;
  }
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  let cst:i32=hg(W,16)-v0;
  sub_note(W,SUB_PURSUIT(),s,r,0,SUB_F6(),SUB_SRC_TAUGHT(),cst,1);
  return -2;
}

// ---- behavior 4: retention reclaims ABANDONED-key structures first ----
// Abandonment (behavior 3) is the DECISION; retention is the EXECUTION.
// Both read the same PURSUIT.life.state field. One victim per call,
// mirroring evict_node's contract.
fn se_drop_edges(W:[]u8,n:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==n || eg(W,e,8)==n)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  return;
}
fn se_reclaim_abandoned(W:[]u8)i32 {
  let u:i32=2;
  while(u<1024){
    if(ng(W,u,36)==1 && ng(W,u,0)==30 && is_superseded(W,u)==0){
      if(se_is_abandoned(W,ng(W,u,20),ng(W,u,24))==1){
        let g:i32=-1; let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==u){ g=eg(W,e,0); }
          e=e+1;
        }
        if(g>=2 && ng(W,g,36)==1){
          rec_evict(W,g); ns(W,g,36,0); hs(W,20,hg(W,20)-1); se_drop_edges(W,g);
        }
        rec_evict(W,u); ns(W,u,36,0); hs(W,20,hg(W,20)-1); se_drop_edges(W,u);
        return u;
      }
    }
    u=u+1;
  }
  return -1;
}
fn evict_node(W:[]u8)i32 {
  if(se_cfg_on(W,SE_B_RETENTION())==1){
    let ra:i32=se_reclaim_abandoned(W);
    if(ra>=0){ return ra; }
  }
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let b:i32=bid(W,n);
      if(b<bb){bb=b; best=n;}
    }
    i=i+1;
  }
  if(best<0){return -1;}
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}
// ============ Integration: Reliability to Substrate to Verification ============
// Integrates C181 (learner-verification), C183 (provenance-learning),
// C185 (substrate-expansion) into ONE system per Constitution One-System Rule.
//
// Design:
//   - Prediction reliability (C181) writes to shared substrate (tag-61,
//     kt=3 RELIABILITY, ka=0 prediction-struct, kb=struct node id).
//   - Source reliability (C183) writes to the SAME substrate (kt=3,
//     ka=1 source, kb=source id 7/8). The private rel store is REMOVED;
//     substrate is the single store (fewer subsystems, not more).
//   - Verification (C181) consults substrate records with BOTH reliabilities.
//   - Substrate drives 5 behaviors (C185, unchanged) PLUS verification (6th).
//
// Researcher scaffold (honest): kt=3/ka/kb layout, reliability thresholds,
//   config bits, trust decision structure.
// Learner-owned: all reliability VALUES, which predictors/sources are
//   trusted, the accept/reject/withhold judgments.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.

// ---- integration config bits (extend se tag-904 bitmask) ----
fn SE_B_PRED()i32 { return 32; }  // prediction-reliability read enabled
fn SE_B_SRC()i32 { return 64; }   // source-reliability read enabled
// Arm configs (base 31 = 5 behaviors):
//   P (prediction-only): 63. S (source-only): 95. I (integrated): 127.
//   No-reliability: 31 (verification withholds: no basis).

// ---- substrate key type for reliability ----
fn SUB_RELIAB()i32 { return 3; }
fn REL_PRED()i32 { return 0; }  // ka=0: prediction-structure reliability
fn REL_SRC()i32 { return 1; }   // ka=1: source reliability

// ============ Prediction machinery (from C181 lv_base, verbatim) ============
fn T_PRED()i32 { return 31; }
fn score_on()i32 { return 1; }

fn pred_record(W:[]u8,s:i32,r:i32,p:i32,sid:i32,kind:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,sid); ns(W,n,16,kind);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

fn ev_predict(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bs:i32=-999999; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let sc:i32=0;
        if(score_on()==1){ sc=ng(W,n,8); }
        let b:i32=bid(W,n);
        if(sc>bs || (sc==bs && b>bb)){ bs=sc; bb=b; best=n; }
      }
    }
    n=n+1;
  }
  if(best>=0){
    let p:i32=ng(W,best,28);
    pred_record(W,s,r,p,best,1);
    return p;
  }
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      let root:i32=ng(W,m,20);
      let v:i32=t2_exec(W,root,s);
      if(v!=-999999){
        if(ng(W,m,12)==-1){ ns(W,m,12,0); ns(W,m,16,0); }
        pred_record(W,s,r,v,m,20);
        return v;
      }
    }
    m=m+1;
  }
  return -999999;
}

// pred_resolve with INTEGRATION: prediction consequences also written to
// the shared substrate (kt=3, ka=0, kb=sid). The local pred_score is kept
// for ev_predict's ranking scan; the substrate record is the shared,
// cross-mechanism consequence. Only kind=1/20 PREDs write (pl PREDs
// with kind=0 are ignored, avoiding layout confusion).
fn pred_resolve_sub(W:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let err:i32=0;
        if(ng(W,n,28)!=o){ err=1; }
        ns(W,n,4,1); ns(W,n,8,err);
        if(score_on()==1){
          let sid:i32=ng(W,n,12); let kind:i32=ng(W,n,16);
          if(sid>=2 && ng(W,sid,36)==1){
            let d:i32=1; let ok:i32=1;
            if(err==1){ d=-1; ok=0; }
            if(kind==1){
              ns(W,sid,8,ng(W,sid,8)+d);
              sub_note(W,SUB_RELIAB(),REL_PRED(),sid,ok,0,SUB_SRC_OBS(),0,1);
            }
            else { if(kind==20){
              ns(W,sid,12,ng(W,sid,12)+d);
              ns(W,sid,16,ng(W,sid,16)+1);
              sub_note(W,SUB_RELIAB(),REL_PRED(),sid,ok,0,SUB_SRC_OBS(),0,1);
            }}
          }
        }
      }
    }
    n=n+1;
  }
  return;
}

// ev_observe with prediction resolution (substrate-writing) appended.
fn ev_observe_rsv(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let r0:i32=ev_observe(W,s,r,o);
  pred_resolve_sub(W,s,r,o);
  return r0;
}

// ============ Source machinery (from C183 pl_patch, substrate-backed) ============
// Source tags (field 16 on tag-1 FACT): 7=SRC_A, 8=SRC_B. 1=OBSERVED.
// The private rel store (tag-61 f28=src) is REMOVED. Reliability lives
// in the shared substrate: kt=3, ka=1, kb=src. f24=successes (correct),
// f20=attempts (total), f16=consec_fail. One store, not two.
fn SRC_A()i32 { return 7; }
fn SRC_B()i32 { return 8; }

fn ev_teach_src(W:[]u8,s:i32,r:i32,o:i32,src:i32)i32 {
  let n:i32=ev_teach(W,s,r,o);
  if(n>=2){ ns(W,n,16,src); }
  return n;
}

fn claims(W:[]u8,s:i32,r:i32,out:[]u8)void {
  set32(out,0,-999999); set32(out,4,-999999);
  set32(out,8,-1); set32(out,12,-1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      let src:i32=ng(W,n,16); let tick:i32=ng(W,n,32);
      if(src==7 && tick>get32(out,8)){
        set32(out,8,tick); set32(out,0,ng(W,n,28));
      } else { if(src==8 && tick>get32(out,12)){
        set32(out,12,tick); set32(out,4,ng(W,n,28));
      }}
    }
    n=n+1;
  }
  return;
}

// Substrate-backed reliability read (replaces pl rel_get).
// out[0]=correct (successes), out[1]=total (attempts).
fn rel_sub_get(W:[]u8,src:i32,out:[]u8)void {
  set32(out,0,0); set32(out,4,0);
  let n:i32=sub_find(W,SUB_RELIAB(),REL_SRC(),src);
  if(n>=0){
    set32(out,0,ng(W,n,24));
    set32(out,4,ng(W,n,20));
  }
  return;
}

fn pred_record_src(W:[]u8,s:i32,r:i32,p:i32,cred:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31); ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,cred);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// src_query with substrate-backed reliability (replaces pl src_query).
// Disagreement: prefer higher correct/total from SUBSTRATE records.
fn src_query_sub(W:[]u8,s:i32,r:i32)i32 {
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  let ta:i32=get32(cl,8); let tb:i32=get32(cl,12);
  let p:i32=-2; let cred:i32=0;
  if(va==-999999 && vb==-999999){return -2;}
  else { if(vb==-999999){p=va; cred=7;}
  else { if(va==-999999){p=vb; cred=8;}
  else { if(va==vb){p=va; cred=9;}
  else {
    let pick:i32=7;
    let ra:[]u8=z_alloc(8); let rb:[]u8=z_alloc(8);
    rel_sub_get(W,7,ra); rel_sub_get(W,8,rb);
    let ca:i32=get32(ra,0); let toa:i32=get32(ra,4);
    let cb:i32=get32(rb,0); let tob:i32=get32(rb,4);
    if(toa==0 && tob==0){if(tb>ta){pick=8;}}
    else { if(toa==0){pick=8;}
    else { if(tob==0){pick=7;}
    else {
      let la:i32=ca*tob; let lb:i32=cb*toa;
      if(lb>la){pick=8;}
      else { if(la==lb){ if(tb>ta){pick=8;} } }
    }}}
    if(pick==7){p=va; cred=7;} else {p=vb; cred=8;}
  }}}}
  pred_record_src(W,s,r,p,cred);
  return p;
}

// ev_observe_src with substrate-backed reliability writes
// (replaces pl rel_bump). Both sources scored, written to substrate.
fn ev_observe_src_sub(W:[]u8,s:i32,r:i32,o:i32)i32 {
  ev_teach_src(W,s,r,o,1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      ns(W,n,4,1);
      if(ng(W,n,28)==o){ns(W,n,8,0);} else {ns(W,n,8,1);}
    }
    n=n+1;
  }
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  if(va!=-999999){
    let ok:i32=0; if(va==o){ok=1;}
    sub_note(W,SUB_RELIAB(),REL_SRC(),7,ok,0,SUB_SRC_OBS(),0,1);
  }
  if(vb!=-999999){
    let ok:i32=0; if(vb==o){ok=1;}
    sub_note(W,SUB_RELIAB(),REL_SRC(),8,ok,0,SUB_SRC_OBS(),0,1);
  }
  return 1;
}

// ============ Integrated verification (6th substrate behavior) ============
// Verification consults substrate records with BOTH prediction reliability
// AND source reliability. The reliability VALUES are learner-owned; the
// thresholds and decision structure are researcher scaffold (honest).

fn rsv_pred_rel(W:[]u8,sid:i32)i32 {
  // 1 if predictor is prediction-reliable per substrate. Caller gates bit.
  let n:i32=sub_find(W,SUB_RELIAB(),REL_PRED(),sid);
  if(n<0){ return 0; }
  let att:i32=ng(W,n,20); let suc:i32=ng(W,n,24); let cf:i32=ng(W,n,16);
  if(att<3){ return 0; }
  if(suc*2<att){ return 0; }
  if(cf>=2){ return 0; }
  return 1;
}

fn rsv_src_rel(W:[]u8,src:i32)i32 {
  // 1 if source is reliable per substrate. Caller gates bit.
  let n:i32=sub_find(W,SUB_RELIAB(),REL_SRC(),src);
  if(n<0){ return 0; }
  let att:i32=ng(W,n,20); let suc:i32=ng(W,n,24);
  if(att<2){ return 0; }
  if(suc*2<att){ return 0; }
  return 1;
}

// Integrated trust gate. Returns:
//   p (>=0): prediction TRUSTED (verification accepts).
//   -3: WITHHELD (no basis, or reliability fails).
//   -999999: no prediction basis at all.
// The decision consults BOTH reliabilities from the shared substrate.
fn rsv_trust(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=ev_predict(W,s,r);
  if(p==-999999){ return -999999; }
  // Find the predictor: the PRED node just created (highest index,
  // unresolved, matching s,r). Mirrors lv_setup.
  let bn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      bn=n;
    }
    n=n+1;
  }
  let sid:i32=-1; let kind:i32=0;
  if(bn>=0){
    sid=ng(W,bn,12); kind=ng(W,bn,16);
  }
  let pred_on:i32=se_cfg_on(W,SE_B_PRED());
  let src_on:i32=se_cfg_on(W,SE_B_SRC());
  // No reliability mechanism: no basis for trust. Withhold (safe).
  if(pred_on==0 && src_on==0){ return -3; }
  if(sid<2){ return -3; }
  // Prediction reliability (from shared substrate).
  if(pred_on==1 && rsv_pred_rel(W,sid)==0){ return -3; }
  // Source reliability (from shared substrate), if predictor has a source.
  let src:i32=0;
  if(kind==1){ src=ng(W,sid,16); }
  if(src_on==1 && (src==7 || src==8) && rsv_src_rel(W,src)==0){ return -3; }
  return p;
}
// ============ Integration driver: I1, I2, I3 ============
// I1: No interference. All three mechanisms work together.
// I2: Synergy. Integrated (I) outperforms prediction-only (P) and
//     source-only (S) on disagreeing reliability cases.
// I3: Ablation. Each mechanism is load-bearing; no-substrate withholds.
//
// Ground truth:
//   X (10,50): pred-reliable (4/4), source-unreliable (B 2/12).
//              Predicts 100, true is 200. Trust is WRONG.
//   Z (30,50): pred-unreliable (0/3), source-reliable (A 12/12).
//              Predicts 300, true is 400. Trust is WRONG.
//   Y (20,50): pred-reliable (4/4), source-reliable (A 12/12).
//              Predicts 500, true is 500. Trust is RIGHT.
//
// Expected: P=2/3 (wrong on X), S=2/3 (wrong on Z), I=3/3.

fn rsv_print_rel(W:[]u8)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==3){
      e64(ng(W,n,8)); emit(" ");
      e64(ng(W,n,12)); emit(" ");
      e64(ng(W,n,24)); emit("/");
      e64(ng(W,n,20)); emit(" cf");
      e64(ng(W,n,16)); emit("; ");
    }
    n=n+1;
  }
  emit("\n");
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  se_cfg_set(W,31);

  // ---- Phase S: source reliability (12 rounds) ----
  let i:i32=0;
  while(i<12){
    ev_teach_src(W,1,50,42,7);
    if(i==3 || i==7){ ev_teach_src(W,1,50,42,8); }
    else { ev_teach_src(W,1,50,99,8); }
    ev_observe_src_sub(W,1,50,42);
    i=i+1;
  }
  emit("I1a src_query: ");
  ev_teach_src(W,2,50,42,7);
  ev_teach_src(W,2,50,99,8);
  let sq:i32=src_query_sub(W,2,50);
  e64(sq); emit(" (expect 42)\n");
  if(sq!=42){ emit("I1a FAIL\n"); return 1; }
  emit("I1a PASS\n");

  // ---- Phase P: prediction reliability ----
  ev_teach_src(W,10,50,100,8);
  i=0;
  while(i<4){
    let px:i32=ev_predict(W,10,50);
    if(px!=100){ emit("X pred mismatch\n"); return 1; }
    ev_observe_rsv(W,10,50,100);
    i=i+1;
  }
  // Z (30,50)=300 from A. Simulate 3 wrong predictions via direct
  // substrate writes (0/3, cf=3). The pred_resolve_sub mechanism is
  // validated by X's real cycles; here we set up the test condition.
  // Z remains the sole predictor for (30,50); its prediction (300) is
  // WRONG (true=400).
  let z_node:i32=ev_teach_src(W,30,50,300,7);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  sub_note(W,3,0,z_node,0,0,1,0,1);
  ns(W,z_node,8,-3);
  let pz0:i32=ev_predict(W,30,50);
  if(pz0!=300){ emit("Z setup mismatch\n"); return 1; }
  ev_teach_src(W,20,50,500,7);
  i=0;
  while(i<4){
    let py:i32=ev_predict(W,20,50);
    if(py!=500){ emit("Y pred mismatch\n"); return 1; }
    ev_observe_rsv(W,20,50,500);
    i=i+1;
  }
  emit("I1b ev_predict ok\n");
  emit("substrate reliability: ");
  rsv_print_rel(W);

  // ---- I1c: substrate 5-behavior withholding still works ----
  let q1:i32=ev_query(W,99,99,-999,0);
  let q2:i32=ev_query(W,99,99,-999,0);
  let q3:i32=ev_query(W,99,99,-999,0);
  let q4:i32=ev_query(W,99,99,-999,0);
  emit("I1c withhold: ");
  e64(q1); emit(" "); e64(q2); emit(" "); e64(q3); emit(" "); e64(q4);
  emit(" (expect -2 -2 -2 -3)\n");
  if(q4!=-3){ emit("I1c FAIL\n"); return 1; }
  emit("I1c PASS\n");

  // ---- I2: synergy across arms ----
  se_cfg_set(W,63);
  let p_x:i32=rsv_trust(W,10,50);
  let p_z:i32=rsv_trust(W,30,50);
  let p_y:i32=rsv_trust(W,20,50);
  se_cfg_set(W,95);
  let s_x:i32=rsv_trust(W,10,50);
  let s_z:i32=rsv_trust(W,30,50);
  let s_y:i32=rsv_trust(W,20,50);
  se_cfg_set(W,127);
  let i_x:i32=rsv_trust(W,10,50);
  let i_z:i32=rsv_trust(W,30,50);
  let i_y:i32=rsv_trust(W,20,50);

  emit("I2 P arm: X="); e64(p_x);
  emit(" Z="); e64(p_z); emit(" Y="); e64(p_y); emit("\n");
  emit("I2 S arm: X="); e64(s_x);
  emit(" Z="); e64(s_z); emit(" Y="); e64(s_y); emit("\n");
  emit("I2 I arm: X="); e64(i_x);
  emit(" Z="); e64(i_z); emit(" Y="); e64(i_y); emit("\n");

  let ps:i32=0; let ss:i32=0; let ins:i32=0;
  if(p_x==-3){ps=ps+1;} if(p_z==-3){ps=ps+1;} if(p_y==500){ps=ps+1;}
  if(s_x==-3){ss=ss+1;} if(s_z==-3){ss=ss+1;} if(s_y==500){ss=ss+1;}
  if(i_x==-3){ins=ins+1;} if(i_z==-3){ins=ins+1;} if(i_y==500){ins=ins+1;}
  emit("I2 scores P="); e64(ps);
  emit("/3 S="); e64(ss); emit("/3 I="); e64(ins); emit("/3\n");
  emit("I2 synergy: ");
  if(ins==3 && ps==2 && ss==2){ emit("PASS\n"); }
  else { emit("FAIL\n"); return 1; }

  // ---- I3c: no reliability bits -> withhold (no basis) ----
  se_cfg_set(W,31);
  let nb:i32=rsv_trust(W,20,50);
  emit("I3c no-substrate: "); e64(nb); emit(" (expect -3)\n");
  if(nb!=-3){ emit("I3c FAIL\n"); return 1; }
  emit("I3c PASS\n");

  emit("ALL PASS\n");
  return 0;
}

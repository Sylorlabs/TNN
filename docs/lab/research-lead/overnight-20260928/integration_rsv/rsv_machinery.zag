fn SUB_TAG()i32 { return 61; }
fn SUB_PURSUIT()i32 { return 1; }
fn SUB_STRATEGY()i32 { return 2; }
fn SUB_F6()i32 { return 6; }
fn SUB_SRC_TAUGHT()i32 { return 0; }
fn SUB_SRC_OBS()i32 { return 1; }
fn SUB_SRC_SELF()i32 { return 2; }
fn SUB_ST_ACTIVE()i32 { return 0; }

fn sub_src_get(p:i32,k:i32)i32 {
  if(k==0){ return p%1024; }
  if(k==1){ return (p/1024)%1024; }
  return (p/1048576)%1024;
}
fn sub_src_inc(p:i32,k:i32)i32 {
  let v:i32=sub_src_get(p,k);
  if(v>=1023){ return p; }
  if(k==0){ return p+1; }
  if(k==1){ return p+1024; }
  return p+1048576;
}
fn sub_life_state(l:i32)i32 { return l%4; }
fn sub_life_mode(l:i32)i32 { return (l/4)%128; }
fn sub_life_cost(l:i32)i32 { return l/512; }
fn sub_life_mk(st:i32,md:i32,c:i32)i32 {
  let cc:i32=c; if(cc>4194303){ cc=4194303; }
  return (st%4)+(md%128)*4+cc*512;
}

// Generic keyed lookup. Shared by all consumers; knows nothing about decline.
fn sub_find(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==kt && ng(W,n,8)==ka && ng(W,n,12)==kb){ return n; }
    n=n+1;
  }
  return -1;
}
fn sub_get(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n>=0){ return n; }
  n=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,kt); ns(W,n,8,ka); ns(W,n,12,kb);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
// Generic consequence write (spec 4.2). success: 1 ok / 0 fail.
// mode: F1-F7 on failure, 0 on success. src: 0 taught / 1 observed / 2 self.
// cost: nodes allocated by this attempt. create: make the record if absent
// (spec 4.1: creation on first miss or trial, not on answers from memory).
fn sub_note(W:[]u8,kt:i32,ka:i32,kb:i32,success:i32,mode:i32,src:i32,cost:i32,create:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){
    if(create==0){ return -1; }
    n=sub_get(W,kt,ka,kb); if(n<0){ return -1; }
  }
  ns(W,n,20,ng(W,n,20)+1);
  ns(W,n,28,sub_src_inc(ng(W,n,28),src));
  let st:i32=sub_life_state(ng(W,n,32));
  let nc:i32=sub_life_cost(ng(W,n,32))+cost;
  if(success==1){
    ns(W,n,24,ng(W,n,24)+1);
    ns(W,n,16,0);
    ns(W,n,32,sub_life_mk(st,0,nc));
  } else {
    ns(W,n,16,ng(W,n,16)+1);
    ns(W,n,32,sub_life_mk(st,mode,nc));
  }
  return n;
}
// Generic production read: consecutive failures for a key, 0 when no record.
fn sub_consec(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){ return 0; }
  return ng(W,n,16);
}

fn sc_n()i32 { return 3; }
fn sc_withhold()i32 { return -3; }

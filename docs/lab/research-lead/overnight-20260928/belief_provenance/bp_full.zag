// bp_learner.zag -- BELIEF-PROVENANCE 1 learner machinery.
// Generic machinery + learned state only. No world data, no fact
// literals, no relation literals in this file. The adjudicator is
// the mechanism under test: conflict scan over live same-start
// MAPs, scoring by the learner-owned meta-table (wcorr match
// counts), argmax with tie -> -3 INDETERMINATE, exploration
// fallback when indeterminate, confirmation against the world's
// revealed terminal, meta-row + type-15/type-16 provenance writes.
// corr = corroboration count, maintained only by bp_observe.
// rev = revision count, provisioned, always 0 in BP-1.
// Prereg: belief_provenance/PREREG.md (commit 21dce2653). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases. No frozen source touched.
//
// State layout (u8 buffer, 8192):
//   0 NF  1 NM  2 NE  3 LAST_VIA(255=none)  4 LAST_VAL
//   5 NN  6 NMETA  7 unused
//   16..1039:   facts, 128 x 8B [sub,rel,obj,live,0,0,0,0]
//   1040..3599: MAPs, 64 x 40B [tag=20,live,start,end,corr,rev,
//                rlen,flen, rels x8 @+8, facts x8 @+16, pad @+32]
//   3600..4111: edges, 128 x 4B [from,to,type,pad]
//   4112..4175: answer nodes, 16 x 4B [via,val,0,0], ids 100+nn
//   4176..4431: meta rows, 32 x 8B
//                [wcorr,lcorr,wmid,lmid,ep,0,0,0], edge ids 200+row
//   4432 C_ADJ i32  4436 C_EXPL i32  4440 C_CONF i32  4444 N_RES i32
//   4448..8191: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- facts ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=128){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (corr/rev maintained by learner machinery only) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=64){return -1;}
  if(rl>8){return -1;}
  if(fl>8){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  let o:i32=1040+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=0; st[o+5]=0; st[o+6]=rl as u8; st[o+7]=fl as u8;
  k=0;
  while(k<8){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){
    if(k<fl){st[o+16+k]=fs[k];}
    else {st[o+16+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<8){st[o+32+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  let o:i32=1040+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+6] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+16+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- observation: the world's confirmation of a terminal ----
// Learner machinery: increments corr on match. The driver (world)
// supplies term_obs; the learner never sees the regime.
fn bp_observe(st:[]u8, mid:i32, term_obs:i32, ob:[]u8, atp:[]u8)i32 {
  let o:i32=1040+mid*40;
  let term:i32=m_exec(st,mid,st[o+2] as i32);
  let ok:i32=0;
  if(term==term_obs){
    st[o+4]=((st[o+4] as i32)+1) as u8;
    ok=1;
  }
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"OBSERVE mid=");
  at=ob_i32(ob,at,mid);
  at=ob_app(ob,at," ok=");
  at=ob_i32(ob,at,ok);
  at=ob_app(ob,at," corr=");
  at=ob_i32(ob,at,st[o+4] as i32);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return ok;
}

// ---- edges (types 14/15/16 only) ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=128){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=3600+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=3600+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[3600+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_other(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let t:i32=st[3600+i*4+2] as i32;
    let known:i32=0;
    if(t==14){known=1;}
    if(t==15){known=1;}
    if(t==16){known=1;}
    if(known==0){c=c+1;}
    i=i+1;
  }
  return c;
}

// ---- meta-table: the learner's evidential policy content ----
// Row: [wcorr,lcorr,wmid,lmid,ep,0,0,0], edge id 200+row.
fn meta_add(st:[]u8, wmid:i32, lmid:i32, ep:i32, ob:[]u8, atp:[]u8)i32 {
  let r:i32=st[6] as i32;
  if(r>=32){return -1;}
  let wo:i32=1040+wmid*40;
  let lo:i32=1040+lmid*40;
  let o:i32=4176+r*8;
  st[o]=st[wo+4]; st[o+1]=st[lo+4];
  st[o+2]=wmid as u8; st[o+3]=lmid as u8; st[o+4]=ep as u8;
  st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[6]=(r+1) as u8;
  e_add(st,200+r,wmid,16);
  e_add(st,200+r,lmid,16);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"META-ROW r=");
  at=ob_i32(ob,at,r);
  at=ob_app(ob,at," wcorr=");
  at=ob_i32(ob,at,st[o] as i32);
  at=ob_app(ob,at," wmid=");
  at=ob_i32(ob,at,wmid);
  at=ob_app(ob,at," lcorr=");
  at=ob_i32(ob,at,st[o+1] as i32);
  at=ob_app(ob,at," lmid=");
  at=ob_i32(ob,at,lmid);
  at=ob_app(ob,at," ep=");
  at=ob_i32(ob,at,ep);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return r;
}
fn meta_score(st:[]u8, c:i32)i32 {
  let n:i32=st[6] as i32;
  let s:i32=0;
  let r:i32=0;
  while(r<n){
    if((st[4176+r*8] as i32)==c){s=s+1;}
    r=r+1;
  }
  return s;
}

// ---- candidate collection: live MAPs with start == s ----
fn collect(st:[]u8, s:i32, cm:[]u8, cc:[]u8, ct:[]u8)i32 {
  let n:i32=0;
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let o:i32=1040+mid*40;
    if((st[o+1] as i32)==1){
      if((st[o+2] as i32)==s){
        cm[n]=mid as u8;
        cc[n]=st[o+4];
        ct[n]=m_exec(st,mid,s) as u8;
        n=n+1;
      }
    }
    mid=mid+1;
  }
  return n;
}

// ---- adjudicator: decide by learned evidential state ----
// Returns winning mid, or -3 INDETERMINATE (tie, incl. empty
// table), -4 no conflict, -5 agreement. No corr magnitude
// comparison, no recency, no identity preference anywhere.
fn bp_adjudicate(st:[]u8, s:i32, ob:[]u8, atp:[]u8)i32 {
  set32(st,4432,get32(st,4432)+1);
  let cm:[]u8=z_alloc(64);
  let cc:[]u8=z_alloc(64);
  let ct:[]u8=z_alloc(64);
  let n:i32=collect(st,s,cm,cc,ct);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"ADJUDICATE s=");
  at=ob_i32(ob,at,s);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,n);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  if(n<2){
    at=get32(atp,0);
    at=ob_app(ob,at,"ADJ-WIN win=-4\n");
    set32(atp,0,at);
    return -4;
  }
  let t0:i32=ct[0] as i32;
  let agree:i32=1;
  let k:i32=1;
  while(k<n){
    if((ct[k] as i32)!=t0){agree=0;}
    k=k+1;
  }
  if(agree==1){
    at=get32(atp,0);
    at=ob_app(ob,at,"ADJ-WIN win=-5\n");
    set32(atp,0,at);
    return -5;
  }
  let best:i32=0;
  let bests:i32=-1;
  let tie:i32=0;
  k=0;
  while(k<n){
    let sc:i32=meta_score(st,cc[k] as i32);
    at=get32(atp,0);
    at=ob_app(ob,at,"ADJ-CAND mid=");
    at=ob_i32(ob,at,cm[k] as i32);
    at=ob_app(ob,at," corr=");
    at=ob_i32(ob,at,cc[k] as i32);
    at=ob_app(ob,at," term=");
    at=ob_i32(ob,at,ct[k] as i32);
    at=ob_app(ob,at," score=");
    at=ob_i32(ob,at,sc);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    if(sc>bests){bests=sc;best=k;tie=0;}
    else {
      if(sc==bests){tie=1;}
    }
    k=k+1;
  }
  at=get32(atp,0);
  at=ob_app(ob,at,"ADJ-WIN win=");
  if(tie==1){
    at=ob_i32(ob,at,-3);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    return -3;
  }
  let wm:i32=cm[best] as i32;
  at=ob_i32(ob,at,wm);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return wm;
}

// ---- exploration fallback: only when adjudication is -3 ----
// Tries candidates in order (higher corr first if hi_first,
// else lower corr first; ties -> lower mid). The first whose
// terminal equals the revealed terminal wins. Writes the
// meta-row + type-15 co-consideration edges.
fn bp_explore(st:[]u8, s:i32, revealed:i32, hi_first:i32, ep:i32, ob:[]u8, atp:[]u8)i32 {
  set32(st,4436,get32(st,4436)+1);
  let cm:[]u8=z_alloc(64);
  let cc:[]u8=z_alloc(64);
  let ct:[]u8=z_alloc(64);
  let n:i32=collect(st,s,cm,cc,ct);
  let ord:[]u8=z_alloc(64);
  let first:i32=0;
  let k:i32=1;
  while(k<n){
    let ck:i32=cc[k] as i32;
    let cf:i32=cc[first] as i32;
    let mk:i32=cm[k] as i32;
    let mf:i32=cm[first] as i32;
    let take:i32=0;
    if(hi_first==1){
      if(ck>cf){take=1;}
      else {
        if(ck==cf){
          if(mk<mf){take=1;}
        }
      }
    }
    else {
      if(ck<cf){take=1;}
      else {
        if(ck==cf){
          if(mk<mf){take=1;}
        }
      }
    }
    if(take==1){first=k;}
    k=k+1;
  }
  ord[0]=first as u8;
  let no:i32=1;
  k=0;
  while(k<n){
    if(k!=first){ord[no]=k as u8;no=no+1;}
    k=k+1;
  }
  let j:i32=0;
  while(j<no){
    let ci:i32=ord[j] as i32;
    let mid:i32=cm[ci] as i32;
    let term:i32=ct[ci] as i32;
    let hit:i32=0;
    if(term==revealed){hit=1;}
    let at:i32=get32(atp,0);
    at=ob_app(ob,at,"EXPLORE-TRY mid=");
    at=ob_i32(ob,at,mid);
    at=ob_app(ob,at," term=");
    at=ob_i32(ob,at,term);
    at=ob_app(ob,at," rev=");
    at=ob_i32(ob,at,revealed);
    if(hit==1){at=ob_app(ob,at," HIT\n");}
    else {at=ob_app(ob,at," MISS\n");}
    set32(atp,0,at);
    if(hit==1){
      let lmid:i32=cm[0] as i32;
      if(mid==(cm[0] as i32)){lmid=cm[1] as i32;}
      let mr:i32=meta_add(st,mid,lmid,ep,ob,atp);
      e_add(st,mid,lmid,15);
      e_add(st,lmid,mid,15);
      set32(st,4444,get32(st,4444)+1);
      return mid;
    }
    j=j+1;
  }
  return -3;
}

// ---- confirmation: learner-owned evaluation of a commitment ----
// Compares the committed structure's terminal to the revealed
// terminal. On match writes meta-row + type-15 edges, returns 1;
// else returns 0 and writes nothing.
fn bp_confirm(st:[]u8, wmid:i32, lmid:i32, revealed:i32, ep:i32, ob:[]u8, atp:[]u8)i32 {
  set32(st,4440,get32(st,4440)+1);
  let wo:i32=1040+wmid*40;
  let term:i32=m_exec(st,wmid,st[wo+2] as i32);
  let ok:i32=0;
  if(term==revealed){ok=1;}
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"CONFIRM mid=");
  at=ob_i32(ob,at,wmid);
  at=ob_app(ob,at," term=");
  at=ob_i32(ob,at,term);
  at=ob_app(ob,at," rev=");
  at=ob_i32(ob,at,revealed);
  if(ok==1){at=ob_app(ob,at," OK\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  if(ok==1){
    let mr:i32=meta_add(st,wmid,lmid,ep,ob,atp);
    e_add(st,wmid,lmid,15);
    e_add(st,lmid,wmid,15);
    set32(st,4444,get32(st,4444)+1);
  }
  return ok;
}

// ---- deliver: commit to an answer, observably ----
fn bp_deliver(st:[]u8, mid:i32, val:i32, ob:[]u8, atp:[]u8)void {
  let nn:i32=st[5] as i32;
  if(nn<16){
    let aid:i32=100+nn;
    let o:i32=4112+nn*4;
    st[o]=mid as u8; st[o+1]=val as u8; st[o+2]=0; st[o+3]=0;
    st[5]=(nn+1) as u8;
    e_add(st,aid,mid,14);
  }
  st[3]=mid as u8; st[4]=val as u8;
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"ANS via=");
  at=ob_i32(ob,at,mid);
  at=ob_app(ob,at," val=");
  at=ob_i32(ob,at,val);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
// bp_world.zag -- BELIEF-PROVENANCE 1 world-side schedule constants.
// The world (driver) owns: entity layout, observation schedule,
// and the per-arm regime (which branch the world confirms). The
// learner never sees the regime except through revealed
// terminals passed as observations. No domain labels anywhere:
// entities and relations are opaque integers.

fn w_p1_base(e:i32)i32 { return 10+e*10; }
fn w_p2_base()i32 { return 200; }
fn w_p1_nep()i32 { return 10; }
// bp_driver.zag -- BELIEF-PROVENANCE 1 experiment driver.
// Three arms (STANDARD, REVERSED, NOMETA), in-driver kill bars
// K-2..K-6, K-8 (K-1/K-7 via shell). The driver teaches facts and
// MAPs (world role: entity layout, observation schedule, regime),
// presents observations via bp_observe, and reveals terminals.
// It never selects structures and never compares corr values:
// all selection goes through bp_learner.zag. Prereg:
// belief_provenance/PREREG.md. Pure Zag.

fn d_log1(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_log2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, s:[]u8, p:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"BAR ");
  at=ob_app(ob,at,s);
  at=ob_app(ob,at," pass=");
  at=ob_i32(ob,at,p);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_obs_batch(st:[]u8, mid:i32, term:i32, n:i32, ob:[]u8, atp:[]u8)void {
  let i:i32=0;
  while(i<n){
    let ok:i32=bp_observe(st,mid,term,ob,atp);
    i=i+1;
  }
  return;
}
// White-box groundedness: every chain fact is live.
fn d_grounded(st:[]u8, mid:i32)i32 {
  let o:i32=1040+mid*40;
  let fl:i32=st[o+7] as i32;
  let g:i32=1;
  let k:i32=0;
  while(k<fl){
    let fid:i32=st[o+16+k] as i32;
    if((st[16+fid*8+3] as i32)==0){g=0;}
    k=k+1;
  }
  return g;
}
fn d_corr(st:[]u8, mid:i32)i32 { return st[1040+mid*40+4] as i32; }
// Check all meta rows match (wc, lc).
fn d_rows_ok(st:[]u8, wc:i32, lc:i32)i32 {
  let n:i32=st[6] as i32;
  let ok:i32=1;
  if(n!=11){ok=0;}
  let r:i32=0;
  while(r<n){
    let o:i32=4176+r*8;
    if((st[o] as i32)!=wc){ok=0;}
    if((st[o+1] as i32)!=lc){ok=0;}
    r=r+1;
  }
  return ok;
}

// One phase-1 episode. Returns the winning mid, or -3.
fn d_p1_ep(st:[]u8, e:i32, regime_hi:i32, ob:[]u8, atp:[]u8)i32 {
  let b:i32=w_p1_base(e);
  let f0:i32=f_teach(st,b,1,b+1);
  let f1:i32=f_teach(st,b+1,1,b+2);
  let f2:i32=f_teach(st,b,2,b+3);
  let f3:i32=f_teach(st,b+3,2,b+4);
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=1; rs[1]=1; fs[0]=f0 as u8; fs[1]=f1 as u8;
  let hi:i32=m_teach(st,rs,2,fs,2,b,b+2);
  rs[0]=2; rs[1]=2; fs[0]=f2 as u8; fs[1]=f3 as u8;
  let lo:i32=m_teach(st,rs,2,fs,2,b,b+4);
  d_obs_batch(st,hi,b+2,8,ob,atp);
  d_obs_batch(st,lo,b+4,2,ob,atp);
  let revealed:i32=b+2;
  if(regime_hi==0){revealed=b+4;}
  let d:i32=bp_adjudicate(st,b,ob,atp);
  let w:i32=d;
  if(d==-3){
    let hf:i32=0;
    if((e%2)==0){hf=1;}
    w=bp_explore(st,b,revealed,hf,e,ob,atp);
  }
  else {
    let other:i32=lo;
    if(w==lo){other=hi;}
    let ok:i32=bp_confirm(st,w,other,revealed,e,ob,atp);
    d_log2(ob,atp,"P1-CONF e=",e," ok=",ok);
  }
  d_log2(ob,atp,"P1-EP e=",e," win=",w);
  return w;
}

// Phase-2 test. out[0]=adjudicated mid (or -3), out[1]=confirm ok.
fn d_p2(st:[]u8, regime_hi:i32, ob:[]u8, atp:[]u8, out:[]u8)void {
  let b:i32=w_p2_base();
  let f0:i32=f_teach(st,b,1,b+1);
  let f1:i32=f_teach(st,b+1,1,b+2);
  let f2:i32=f_teach(st,b,2,b+3);
  let f3:i32=f_teach(st,b+3,2,b+4);
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=1; rs[1]=1; fs[0]=f0 as u8; fs[1]=f1 as u8;
  let hi:i32=m_teach(st,rs,2,fs,2,b,b+2);
  rs[0]=2; rs[1]=2; fs[0]=f2 as u8; fs[1]=f3 as u8;
  let lo:i32=m_teach(st,rs,2,fs,2,b,b+4);
  d_obs_batch(st,hi,b+2,8,ob,atp);
  d_obs_batch(st,lo,b+4,2,ob,atp);
  let d2:i32=bp_adjudicate(st,b,ob,atp);
  d_log2(ob,atp,"P2-ADJ win=",d2," s=",b);
  let ok:i32=0;
  if(d2>=0){
    let term:i32=m_exec(st,d2,b);
    bp_deliver(st,d2,term,ob,atp);
    let other:i32=lo;
    if(d2==lo){other=hi;}
    let revealed:i32=b+2;
    if(regime_hi==0){revealed=b+4;}
    ok=bp_confirm(st,d2,other,revealed,10,ob,atp);
    d_log1(ob,atp,"P2-CONF ok=",ok);
  }
  else {
    d_log1(ob,atp,"INDETERMINATE s=",b);
  }
  out[0]=d2 as u8;
  out[1]=ok as u8;
  out[2]=hi as u8;
  out[3]=lo as u8;
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(4);
  set32(atp,0,0);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"BP-1-START\n");
  set32(atp,0,at);

  // ================= ARM-STANDARD =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-STANDARD ===\n");
  set32(atp,0,at);
  let stS:[]u8=z_alloc(8192);
  stS[3]=255;
  let e:i32=0;
  while(e<w_p1_nep()){
    let wS:i32=d_p1_ep(stS,e,1,ob,atp);
    e=e+1;
  }
  let outS:[]u8=z_alloc(8);
  d_p2(stS,1,ob,atp,outS);
  let viaS:i32=outS[0] as i32;
  if(viaS>127){viaS=viaS-256;}
  let okS:i32=outS[1] as i32;
  let hiS:i32=outS[2] as i32;
  let loS:i32=outS[3] as i32;
  let nmS:i32=stS[6] as i32;
  let lvS:i32=stS[3] as i32;
  let vvS:i32=stS[4] as i32;
  let t14S:i32=e_count(stS,14);
  let t15S:i32=e_count(stS,15);
  let t16S:i32=e_count(stS,16);
  let othS:i32=e_other(stS);
  d_log2(ob,atp,"S-SUMMARY via=",viaS," ok=",okS);
  d_log2(ob,atp,"S-SUMMARY nmeta=",nmS," lastvia=",lvS);

  // ================= ARM-REVERSED =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-REVERSED ===\n");
  set32(atp,0,at);
  let stR:[]u8=z_alloc(8192);
  stR[3]=255;
  e=0;
  while(e<w_p1_nep()){
    let wR:i32=d_p1_ep(stR,e,0,ob,atp);
    e=e+1;
  }
  let outR:[]u8=z_alloc(8);
  d_p2(stR,0,ob,atp,outR);
  let viaR:i32=outR[0] as i32;
  if(viaR>127){viaR=viaR-256;}
  let okR:i32=outR[1] as i32;
  let hiR:i32=outR[2] as i32;
  let loR:i32=outR[3] as i32;
  let nmR:i32=stR[6] as i32;
  let lvR:i32=stR[3] as i32;
  let vvR:i32=stR[4] as i32;
  let t14R:i32=e_count(stR,14);
  let t15R:i32=e_count(stR,15);
  let t16R:i32=e_count(stR,16);
  let othR:i32=e_other(stR);
  d_log2(ob,atp,"R-SUMMARY via=",viaR," ok=",okR);
  d_log2(ob,atp,"R-SUMMARY nmeta=",nmR," lastvia=",lvR);

  // ================= ARM-NOMETA =================
  at=get32(atp,0);
  at=ob_app(ob,at,"=== ARM-NOMETA ===\n");
  set32(atp,0,at);
  let stN:[]u8=z_alloc(8192);
  stN[3]=255;
  let outN:[]u8=z_alloc(8);
  d_p2(stN,1,ob,atp,outN);
  let viaN:i32=outN[0] as i32;
  if(viaN>127){viaN=viaN-256;}
  let nmN:i32=stN[6] as i32;
  let lvN:i32=stN[3] as i32;
  let hiN:i32=outN[2] as i32;
  let loN:i32=outN[3] as i32;
  let t14N:i32=e_count(stN,14);
  let t15N:i32=e_count(stN,15);
  let t16N:i32=e_count(stN,16);
  let othN:i32=e_other(stN);
  d_log2(ob,atp,"N-SUMMARY via=",viaN," nmeta=",nmN);

  // ================= KILL BARS =================
  // K-2 STANDARD
  let k2:i32=1;
  if(viaS!=20){k2=0;}
  if(vvS!=202){k2=0;}
  if(okS!=1){k2=0;}
  if(nmS!=11){k2=0;}
  if(d_rows_ok(stS,8,2)!=1){k2=0;}
  d_bar(ob,atp,"K-2",k2);
  // K-3 REVERSED
  let k3:i32=1;
  if(viaR!=21){k3=0;}
  if(vvR!=204){k3=0;}
  if(okR!=1){k3=0;}
  if(nmR!=11){k3=0;}
  if(d_rows_ok(stR,2,8)!=1){k3=0;}
  d_bar(ob,atp,"K-3",k3);
  // K-4 NOMETA
  let k4:i32=1;
  if(viaN!=-3){k4=0;}
  if(nmN!=0){k4=0;}
  if(lvN!=255){k4=0;}
  d_bar(ob,atp,"K-4",k4);
  // K-5 genuine conflict (grounded, corr 8/2, terminals differ)
  let k5:i32=1;
  if(d_grounded(stS,hiS)!=1){k5=0;}
  if(d_grounded(stS,loS)!=1){k5=0;}
  if(d_corr(stS,hiS)!=8){k5=0;}
  if(d_corr(stS,loS)!=2){k5=0;}
  if(m_exec(stS,hiS,200)==m_exec(stS,loS,200)){k5=0;}
  if(d_grounded(stR,hiR)!=1){k5=0;}
  if(d_grounded(stR,loR)!=1){k5=0;}
  if(d_corr(stR,hiR)!=8){k5=0;}
  if(d_corr(stR,loR)!=2){k5=0;}
  if(m_exec(stR,hiR,200)==m_exec(stR,loR,200)){k5=0;}
  if(d_grounded(stN,hiN)!=1){k5=0;}
  if(d_grounded(stN,loN)!=1){k5=0;}
  if(d_corr(stN,hiN)!=8){k5=0;}
  if(d_corr(stN,loN)!=2){k5=0;}
  if(d_grounded(stS,0)!=1){k5=0;}
  if(d_grounded(stS,1)!=1){k5=0;}
  d_bar(ob,atp,"K-5",k5);
  // K-6 the flip: opposite commitments, explained by meta-tables
  let k6:i32=1;
  if(viaS!=20){k6=0;}
  if(viaR!=21){k6=0;}
  if(viaS==viaR){k6=0;}
  if(d_rows_ok(stS,8,2)!=1){k6=0;}
  if(d_rows_ok(stR,2,8)!=1){k6=0;}
  d_bar(ob,atp,"K-6",k6);
  // K-8 edge hygiene
  let k8:i32=1;
  if(t14S!=1){k8=0;}
  if(t15S!=22){k8=0;}
  if(t16S!=22){k8=0;}
  if(t14R!=1){k8=0;}
  if(t15R!=22){k8=0;}
  if(t16R!=22){k8=0;}
  if(t14N!=0){k8=0;}
  if(t15N!=0){k8=0;}
  if(t16N!=0){k8=0;}
  if(othS!=0){k8=0;}
  if(othR!=0){k8=0;}
  if(othN!=0){k8=0;}
  d_bar(ob,atp,"K-8",k8);

  at=get32(atp,0);
  at=ob_app(ob,at,"K-1 K-7 see-shell\n");
  at=ob_app(ob,at,"BARS k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"BP-1-END\n");
  set32(atp,0,at);

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

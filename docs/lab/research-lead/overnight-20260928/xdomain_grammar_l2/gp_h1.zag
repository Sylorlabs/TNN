// gp_h1.zag -- Cross-domain L2 on grammar to program (H1).
//
// World, arms, and kill bars are frozen in PREREG.md (committed ALONE
// before any implementation). Mechanism logic follows the xdomain H1
// lineage: learned typed contracts filter composition, two-phase solver
// (L1 exact, L2 adaptation). New: the PARAM grammar behavior (licensed
// program length extraction), the EXEC program behavior (canonical
// L-op program trace encoding = repunit), and the generic TRUNCATE
// (rebind licensed length down) and EXTEND (rebind licensed length up)
// operators with exhaustive Phase 2 try-and-validate. Under test:
// whether the LEARNER selects the correct operator and discovers the
// correct parameter per sealed goal, not behavior induction (behaviors
// are installed as prior learning).
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 new modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_z, 8 solved, 12 tries, 16 out_cur,
//         20 arm_verdict, 24 succ_count, 28 succ_op, 32 succ_param,
//         36 succ_b
// facts: base 64, 40 entries x 16 bytes (used,subj,rel,obj)
// maps: base 704, 16 entries x 64 bytes
//   (used,behav,param,sig_in,sig_out,comp_a,comp_b,
//    adapt_of,adapt_op,adapt_param,pad...)
fn gp_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  put32(W,24,0); put32(W,28,0); put32(W,32,-1); put32(W,36,-1);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==0){
      put32(W,64+i*16,1); put32(W,64+i*16+4,s);
      put32(W,64+i*16+8,r); put32(W,64+i*16+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn facts_train(W:[]u8)void {
  add_fact(W,1,71,2);
  add_fact(W,2,71,4);
  add_fact(W,1,72,7);
  add_fact(W,2,72,5);
  return;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
// first obj for (v,rel), or -1.
fn find_obj(W:[]u8,v:i32,rel:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==v && ig(W,64+i*16+8)==rel){
      return ig(W,64+i*16+12);
    }
    i=i+1;
  }
  return -1;
}
// canonical L-op program trace encoding: the repunit of length L.
// -1 for L<1 or on i32 overflow (generic guard).
fn repunit(L:i32)i32 {
  if(L<1){ return -1; }
  let r:i32=0;
  let i:i32=0;
  while(i<L){
    if(r>214748364){ return -1; }
    r=r*10+1;
    i=i+1;
  }
  return r;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=704+m*64;
  put32(W,b,1); put32(W,b+4,behav); put32(W,b+8,-1);
  put32(W,b+12,0); put32(W,b+16,0);
  put32(W,b+20,-1); put32(W,b+24,-1);
  put32(W,b+28,-1); put32(W,b+32,0); put32(W,b+36,-1);
  put32(W,b+40,-1);
  put32(W,b+44,0); put32(W,b+48,0); put32(W,b+52,0); put32(W,b+56,0);
  put32(W,b+60,0);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,704+m*64,0); return; }
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=704+m*64;
  let bh:i32=ig(W,b+4);
  if(bh==0){
    if(ig(W,b+32)!=0){ return ig(W,b+36); }
    return find_obj(W,v,71);
  }
  if(bh==1){ return repunit(v); }
  if(bh==2){ return find_obj(W,v,72); }
  if(bh==3){ return v; }
  let a:i32=ig(W,b+20);
  let cc:i32=ig(W,b+24);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,cc,mid);
}
// Generic TRUNCATE operator: copy the PARAM MAP, rebind the licensed
// length to k, keep signature, record provenance.
fn truncate_map(W:[]u8,m:i32,k:i32)i32 {
  let nm:i32=map_new(W,ig(W,704+m*64+4));
  let nb:i32=704+nm*64;
  let ob:i32=704+m*64;
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,ig(W,ob+16));
  put32(W,nb+28,m);
  put32(W,nb+32,1);
  put32(W,nb+36,k);
  return nm;
}
// Generic EXTEND operator: copy the PARAM MAP, rebind the licensed
// length to k, keep signature, record provenance.
fn extend_map(W:[]u8,m:i32,k:i32)i32 {
  let nm:i32=map_new(W,ig(W,704+m*64+4));
  let nb:i32=704+nm*64;
  let ob:i32=704+m*64;
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,ig(W,ob+16));
  put32(W,nb+28,m);
  put32(W,nb+32,2);
  put32(W,nb+36,k);
  return nm;
}
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=704+z*64;
  put32(W,zb+20,a); put32(W,zb+24,b);
  put32(W,zb+12,ig(W,704+a*64+12));
  put32(W,zb+16,ig(W,704+b*64+16));
  put32(W,4,z);
  return z;
}
fn teach_x(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  let r:i32=exec_map(W,x,1);
  let si:i32=probe_kind(W,1);
  let so:i32=probe_kind(W,r);
  put32(W,704+x*64+12,si);
  put32(W,704+x*64+16,so);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," sig="); eN(W,OUT,si); eS(W,OUT,"->"); eN(W,OUT,so);
  eS(W,OUT," x1="); eN(W,OUT,r); eS(W,OUT,"\n");
  return;
}
fn teach_y(W:[]u8,OUT:[]u8)void {
  let y:i32=map_new(W,1);
  let r:i32=exec_map(W,y,2);
  let si:i32=probe_kind(W,2);
  let so:i32=probe_kind(W,r);
  put32(W,704+y*64+12,si);
  put32(W,704+y*64+16,so);
  eS(W,OUT,"TEACH Y id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,si); eS(W,OUT,"->"); eN(W,OUT,so);
  eS(W,OUT," y2="); eN(W,OUT,r); eS(W,OUT,"\n");
  return;
}
fn teach_d1(W:[]u8,OUT:[]u8)void {
  let d:i32=map_new(W,2);
  let r:i32=exec_map(W,d,1);
  put32(W,704+d*64+12,probe_kind(W,1));
  put32(W,704+d*64+16,probe_kind(W,r));
  eS(W,OUT,"TEACH D1 id="); eN(W,OUT,d); eS(W,OUT,"\n");
  return;
}
fn teach_d2(W:[]u8,OUT:[]u8)void {
  let d:i32=map_new(W,3);
  let r:i32=exec_map(W,d,1);
  put32(W,704+d*64+12,probe_kind(W,1));
  put32(W,704+d*64+16,probe_kind(W,r));
  eS(W,OUT,"TEACH D2 id="); eN(W,OUT,d); eS(W,OUT,"\n");
  return;
}
// Try one typed pair. On goal match, record the success with provenance.
// Exhaustive: never stops early; the arm verdict requires exactly the
// predicted single success.
fn try_pair(W:[]u8,OUT:[]u8,a:i32,b:i32,s:i32,target:i32,kin:i32,kout:i32)void {
  if(ig(W,704+a*64+12)!=kin){ return; }
  if(ig(W,704+a*64+16)!=ig(W,704+b*64+12)){ return; }
  if(ig(W,704+b*64+16)!=kout){ return; }
  put32(W,12,ig(W,12)+1);
  let mid:i32=exec_map(W,a,s);
  let r:i32=exec_map(W,b,mid);
  eS(W,OUT,"TRY pair a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b);
  eS(W,OUT," mid="); eN(W,OUT,mid); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
  if(r==target){
    put32(W,24,ig(W,24)+1);
    if(ig(W,24)==1){
      put32(W,28,ig(W,704+a*64+32));
      put32(W,32,ig(W,704+a*64+36));
      put32(W,36,b);
      let z:i32=promote_comp(W,a,b);
      eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
      eS(W,OUT," a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
      eS(W,OUT,"Z-PROV adapt_of="); eN(W,OUT,ig(W,704+a*64+28));
      eS(W,OUT," op="); eN(W,OUT,ig(W,704+a*64+32));
      eS(W,OUT," param="); eN(W,OUT,ig(W,704+a*64+36)); eS(W,OUT,"\n");
    }
    put32(W,8,1);
  }
  return;
}
// Two-phase solver. Phase 1 is exact L1 reuse. Phase 2 (l2_on=1) is the
// L2 adaptation: for each PARAM MAP, try TRUNCATE over every candidate
// k in [1,L), then EXTEND over every candidate k in (L,2L], retrying
// typed composition each time. Fixed operator order (TRUNCATE before
// EXTEND); selection is proven by exhaustive try-and-reject, not by
// order. L is the learned licensed length on the query subject.
fn solve_z(W:[]u8,OUT:[]u8,s:i32,target:i32,l2_on:i32)void {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm0:i32=ig(W,0);
  put32(W,8,0); put32(W,24,0);
  eS(W,OUT,"PHASE1 L1:\n");
  let m:i32=0;
  while(m<nm0){
    if(ig(W,704+m*64)==1){
      if(ig(W,704+m*64+12)==kin && ig(W,704+m*64+16)==kout){
        put32(W,12,ig(W,12)+1);
        let r:i32=exec_map(W,m,s);
        eS(W,OUT,"TRY single m="); eN(W,OUT,m); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
        if(r==target){
          put32(W,24,ig(W,24)+1);
          put32(W,8,1);
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm0){
    let b:i32=0;
    while(b<nm0){
      if(ig(W,704+a*64)==1 && ig(W,704+b*64)==1){
        try_pair(W,OUT,a,b,s,target,kin,kout);
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ig(W,8)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,8)==1 || l2_on==0){ return; }
  eS(W,OUT,"PHASE2 L2:\n");
  let n0:i32=ig(W,0);
  let xm:i32=0;
  while(xm<n0){
    if(ig(W,704+xm*64)==1 && ig(W,704+xm*64+4)==0 && ig(W,704+xm*64+32)==0){
      let L:i32=exec_map(W,xm,s);
      eS(W,OUT,"XMAP m="); eN(W,OUT,xm);
      eS(W,OUT," L="); eN(W,OUT,L); eS(W,OUT,"\n");
      if(L>=1){
        let k:i32=1;
        while(k<L){
          let m2:i32=truncate_map(W,xm,k);
          eS(W,OUT,"TRUNC-TRY m="); eN(W,OUT,xm); eS(W,OUT," k="); eN(W,OUT,k);
          eS(W,OUT," nm="); eN(W,OUT,m2); eS(W,OUT,"\n");
          let b:i32=0;
          while(b<n0){
            if(ig(W,704+b*64)==1 && ig(W,704+b*64+32)==0){
              try_pair(W,OUT,m2,b,s,target,kin,kout);
            }
            b=b+1;
          }
          k=k+1;
        }
        let k2:i32=L+1;
        while(k2<=2*L){
          let m3:i32=extend_map(W,xm,k2);
          eS(W,OUT,"EXT-TRY m="); eN(W,OUT,xm); eS(W,OUT," k="); eN(W,OUT,k2);
          eS(W,OUT," nm="); eN(W,OUT,m3); eS(W,OUT,"\n");
          let b2:i32=0;
          while(b2<n0){
            if(ig(W,704+b2*64)==1 && ig(W,704+b2*64+32)==0){
              try_pair(W,OUT,m3,b2,s,target,kin,kout);
            }
            b2=b2+1;
          }
          k2=k2+1;
        }
      }
    }
    xm=xm+1;
  }
  if(ig(W,8)==1){
    eS(W,OUT,"L2-SOLVED succ="); eN(W,OUT,ig(W,24)); eS(W,OUT,"\n");
  } else {
    eS(W,OUT,"L2-FAIL\n");
  }
  return;
}
fn arm_pass(W:[]u8,OUT:[]u8,ok:i32)void {
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_expect_fail(W:[]u8,OUT:[]u8)void {
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn teach_all(W:[]u8,OUT:[]u8)void {
  teach_x(W,OUT); teach_y(W,OUT); teach_d1(W,OUT); teach_d2(W,OUT);
  return;
}
// World-E arms: Z-E = (1,93) -> 1111 needs EXTEND k=4, comp_b = Y (id 1).
fn arm_treat_e(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-E ===\n");
  facts_train(W); teach_all(W,OUT);
  solve_z(W,OUT,1,1111,1);
  let ok:i32=0;
  if(ig(W,8)==1 && ig(W,24)==1 && ig(W,28)==2 && ig(W,32)==4 && ig(W,36)==1){
    let z:i32=ig(W,4);
    let za:i32=ig(W,704+z*64+20);
    if(ig(W,704+za*64+28)==0 && ig(W,704+za*64+32)==2 && ig(W,704+za*64+36)==4
       && ig(W,704+z*64+24)==1){ ok=1; }
  }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_e(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-E ===\n");
  facts_train(W); teach_all(W,OUT);
  solve_z(W,OUT,1,1111,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_e(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-E ===\n");
  facts_train(W); teach_all(W,OUT);
  del_map(W,0);
  solve_z(W,OUT,1,1111,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_e(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-E ===\n");
  facts_train(W); teach_all(W,OUT);
  del_map(W,1);
  solve_z(W,OUT,1,1111,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_e(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-E ===\n");
  facts_train(W);
  solve_z(W,OUT,1,1111,1);
  arm_expect_fail(W,OUT);
  return;
}
// World-T arms: Z-T = (2,93) -> 111 needs TRUNCATE k=3, comp_b = Y (id 1).
fn arm_treat_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-T ===\n");
  facts_train(W); teach_all(W,OUT);
  solve_z(W,OUT,2,111,1);
  let ok:i32=0;
  if(ig(W,8)==1 && ig(W,24)==1 && ig(W,28)==1 && ig(W,32)==3 && ig(W,36)==1){
    let z:i32=ig(W,4);
    let za:i32=ig(W,704+z*64+20);
    if(ig(W,704+za*64+28)==0 && ig(W,704+za*64+32)==1 && ig(W,704+za*64+36)==3
       && ig(W,704+z*64+24)==1){ ok=1; }
  }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-T ===\n");
  facts_train(W); teach_all(W,OUT);
  solve_z(W,OUT,2,111,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-T ===\n");
  facts_train(W); teach_all(W,OUT);
  del_map(W,0);
  solve_z(W,OUT,2,111,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-T ===\n");
  facts_train(W); teach_all(W,OUT);
  del_map(W,1);
  solve_z(W,OUT,2,111,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-T ===\n");
  facts_train(W);
  solve_z(W,OUT,2,111,1);
  arm_expect_fail(W,OUT);
  return;
}
fn run_arm(W:[]u8,OUT:[]u8,idx:i32,cur:i32)i32 {
  gp_init(W);
  put32(W,16,cur);
  if(idx==0){ arm_treat_e(W,OUT); }
  if(idx==1){ arm_l1_e(W,OUT); }
  if(idx==2){ arm_ablx_e(W,OUT); }
  if(idx==3){ arm_ably_e(W,OUT); }
  if(idx==4){ arm_fresh_e(W,OUT); }
  if(idx==5){ arm_treat_t(W,OUT); }
  if(idx==6){ arm_l1_t(W,OUT); }
  if(idx==7){ arm_ablx_t(W,OUT); }
  if(idx==8){ arm_ably_t(W,OUT); }
  if(idx==9){ arm_fresh_t(W,OUT); }
  return ig(W,20);
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"GP-H1-START\n");
  let tot:i32=0;
  let idx:i32=0;
  while(idx<10){
    let W:[]u8=z_alloc(4096);
    put32(W,16,cur);
    tot=tot+run_arm(W,OUT,idx,cur);
    cur=ig(W,16);
    idx=idx+1;
  }
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/10\n");
  cur=e1str(OUT,cur,"GP-H1-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

// ad_driver.zag -- EXTEND-ONE battery.
//
// A1 L2-TREAT: X covers 3 of 4 needed r1 links; operator extends it;
//   expect ans=108 with adapted provenance.
// A2 L2-XREL: extension relation comes from the fact store (r2), not
//   hardcoded; expect ans=108 with adapted relseq [1,1,1,2].
// A3 L2-IMPOSSIBLE: frontier has no outgoing fact; expect clean -2
//   with zero adapted MAPs created (no hallucinated extension).
// A4 L1-REGRESSION: the six amended L1 arms verbatim, all through
//   ev_query_adapt; expect no regression.
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn ad_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn ad_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn ad_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// lowest-id live MAP with an outgoing type-16 edge, or -1.
fn ad_find_adapted(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==m && eg(W,e,4)==16){return m;}
        e=e+1;
      }
    }
    m=m+1;
  }
  return -1;
}
// source MAP of adapted MAP a (type-16 target), or -1.
fn ad_adapt_src(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// count of type-16 edges workspace-wide.
fn ad_count_adapt(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn ad_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// Train X ([1,1,1]) and Y ([2,2,2]). out[0]=mapx, out[1]=mapy.
fn ad_train_xy(W:[]u8,out:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query_adapt(W,11,71,14,0);
  emit("AD-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y:i32=ev_query_adapt(W,21,72,24,0);
  emit("AD-Y ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}

// ---- A1: L2-TREAT (extension of MAP_X by one r1 link) ----
fn a1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,1,104); ev_teach(W,104,1,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn a1_l2_treat(W:[]u8)void {
  emit("=== A1-L2-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  ad_gap(W);
  a1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,108,0);
  emit("A1-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let a:i32=ad_find_adapted(W);
  let asrc:i32=ad_adapt_src(W,a);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,1); set32(ex,4,1); set32(ex,8,1); set32(ex,12,1);
  let p1:i32=0; if(z==108){p1=1;}
  let p2:i32=0; if(a>=0 && asrc==mapx){p2=1;}
  let p3:i32=ad_has14(W,mapz,a);
  // p4/p5 recorded for the report (Amendment 1): the unchanged DFS
  // selects segment 2 itself; not part of the L2 bar.
  let p4:i32=ad_has14(W,mapz,mapy);
  let p5:i32=0; if(ad_has14(W,mapz,mapx)==0){p5=1;}
  let p6:i32=0; if(a>=0){p6=ad_relseq_eq(W,a,ex,4);}
  emit("A1 p1(ans108)="); e64(p1);
  emit(" p2(adapted-from-X)="); e64(p2);
  emit(" p3(z14adapted)="); e64(p3);
  emit(" p4(z14Y)="); e64(p4);
  emit(" p5(no-z14X)="); e64(p5);
  emit(" p6(seq1111)="); e64(p6); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p6==1){
    emit("A1-L2-TREAT=PASS\n");
  } else {
    emit("A1-L2-TREAT=FAIL\n");
  }
  return;
}

// ---- A2: L2-XREL (cross-relation extension: frontier fact is r2) ----
fn a2_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,1,104); ev_teach(W,104,2,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn a2_l2_xrel(W:[]u8)void {
  emit("=== A2-L2-XREL ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  ad_gap(W);
  a2_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,108,0);
  emit("A2-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let a:i32=ad_find_adapted(W);
  let asrc:i32=ad_adapt_src(W,a);
  let ex:[]u8=z_alloc(16);
  set32(ex,0,1); set32(ex,4,1); set32(ex,8,1); set32(ex,12,2);
  let p1:i32=0; if(z==108){p1=1;}
  let p2:i32=0; if(a>=0 && asrc==mapx){p2=1;}
  let p3:i32=ad_has14(W,mapz,a);
  // p4 recorded for the report (Amendment 1): segment 2 is the
  // unchanged DFS's own selection; not part of the L2 bar.
  let p4:i32=ad_has14(W,mapz,mapy);
  let p6:i32=0; if(a>=0){p6=ad_relseq_eq(W,a,ex,4);}
  emit("A2 p1(ans108)="); e64(p1);
  emit(" p2(adapted-from-X)="); e64(p2);
  emit(" p3(z14adapted)="); e64(p3);
  emit(" p4(z14Y)="); e64(p4);
  emit(" p6(seq1112)="); e64(p6); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p6==1){
    emit("A2-L2-XREL=PASS\n");
  } else {
    emit("A2-L2-XREL=FAIL\n");
  }
  return;
}

// ---- A3: L2-IMPOSSIBLE (frontier 104 has no outgoing fact) ----
fn a3_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn a3_l2_impossible(W:[]u8)void {
  emit("=== A3-L2-IMPOSSIBLE ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  a3_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,108,0);
  emit("A3-ANS="); e64(z); emit("\n");
  let na:i32=ad_count_adapt(W);
  emit("A3 adapted-count="); e64(na); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  if(p1==1 && p2==1){emit("A3-L2-IMPOSSIBLE=PASS\n");}
  else {emit("A3-L2-IMPOSSIBLE=FAIL\n");}
  return;
}

// ---- A4: L1 regression (amended levels battery, via ev_query_adapt) ----
fn a4_l1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  return;
}
fn a4_l1_treat(W:[]u8)void {
  emit("=== A4-L1-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  a4_l1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-TREAT-ANS="); e64(z); emit("\n");
  if(z==107){emit("A4-L1-TREAT=PASS\n");} else {emit("A4-L1-TREAT=FAIL\n");}
  return;
}
fn a4_l1_ablx(W:[]u8)void {
  emit("=== A4-L1-ABL-X ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_kill(W,get32(out,0));
  emit("A4-L1-ABL-X killed mapx\n");
  ad_gap(W);
  a4_l1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-ABL-X-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A4-L1-ABL-X=PASS\n");} else {emit("A4-L1-ABL-X=FAIL\n");}
  return;
}
fn a4_l1_ably(W:[]u8)void {
  emit("=== A4-L1-ABL-Y ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_kill(W,get32(out,4));
  emit("A4-L1-ABL-Y killed mapy\n");
  ad_gap(W);
  a4_l1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-ABL-Y-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A4-L1-ABL-Y=PASS\n");} else {emit("A4-L1-ABL-Y=FAIL\n");}
  return;
}
fn a4_l1_fresh(W:[]u8)void {
  emit("=== A4-L1-FRESH ===\n");
  ad_gap(W);
  a4_l1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A4-L1-FRESH=PASS\n");} else {emit("A4-L1-FRESH=FAIL\n");}
  return;
}
fn a4_l1_reuse(W:[]u8)void {
  emit("=== A4-L1-REUSE ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  ad_gap(W);
  a4_l1_zfacts(W);
  let z1:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-REUSE first="); e64(z1); emit("\n");
  let z2:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-L1-REUSE-ANS="); e64(z2); emit("\n");
  if(z2==107){emit("A4-L1-REUSE=PASS\n");} else {emit("A4-L1-REUSE=FAIL\n");}
  return;
}
fn a4_l1_prov(W:[]u8)void {
  emit("=== A4-L1-PROV ===\n");
  let out:[]u8=z_alloc(12);
  ad_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  ad_gap(W);
  a4_l1_zfacts(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  let mapz:i32=cb_newest_map(W);
  emit("A4-L1-PROV z="); e64(z); emit(" mapz="); e64(mapz);
  emit(" mapx="); e64(mapx); emit(" mapy="); e64(mapy); emit("\n");
  let px:i32=ad_has14(W,mapz,mapx);
  let py:i32=ad_has14(W,mapz,mapy);
  emit("A4-L1-PROV link14-z-x="); e64(px);
  emit(" link14-z-y="); e64(py); emit("\n");
  if(z==107 && px==1 && py==1){emit("A4-L1-PROV=PASS\n");}
  else {emit("A4-L1-PROV=FAIL\n");}
  return;
}

fn main()i32 {
  emit("AD-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); a1_l2_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); a2_l2_xrel(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); a3_l2_impossible(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); a4_l1_treat(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); a4_l1_ablx(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); a4_l1_ably(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); a4_l1_fresh(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); a4_l1_reuse(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); a4_l1_prov(W9);
  emit("AD-END\n");
  return 0;
}

// substrate.zag: shared substrate prototype.
// One continuing workspace W hosts a fact store AND an episodic
// causal store. The variable count (nvar) is a runtime header
// field, never a compile-time constant. All strides and offsets
// are computed from nvar. Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ header ============
// 0 magic, 4 nvar, 8 ep_stride, 12 ent_stride, 16 ep_base,
// 20 ent_base, 24 fact_base, 28 str_base, 32 str_cursor,
// 36 ep_count, 40 ent_count, 44 fact_count, 48 seq,
// 52 max_ep, 56 max_ent, 60 max_fact, 64 fact_conflicts, 68 ep_processed
fn h_nvar(W:[]u8)i32 { return get32(W,4); }
fn h_epstride(W:[]u8)i32 { return get32(W,8); }
fn h_entstride(W:[]u8)i32 { return get32(W,12); }
fn h_epbase(W:[]u8)i32 { return get32(W,16); }
fn h_entbase(W:[]u8)i32 { return get32(W,20); }
fn h_factbase(W:[]u8)i32 { return get32(W,24); }
fn h_strbase(W:[]u8)i32 { return get32(W,28); }
fn h_strcur(W:[]u8)i32 { return get32(W,32); }
fn h_strcur_set(W:[]u8, v:i32)void { set32(W,32,v); return; }
fn h_epcount(W:[]u8)i32 { return get32(W,36); }
fn h_epcount_set(W:[]u8, v:i32)void { set32(W,36,v); return; }
fn h_entcount(W:[]u8)i32 { return get32(W,40); }
fn h_entcount_set(W:[]u8, v:i32)void { set32(W,40,v); return; }
fn h_factcount(W:[]u8)i32 { return get32(W,44); }
fn h_factcount_set(W:[]u8, v:i32)void { set32(W,44,v); return; }
fn h_seq(W:[]u8)i32 { return get32(W,48); }
fn h_seq_set(W:[]u8, v:i32)void { set32(W,48,v); return; }
fn h_conflicts(W:[]u8)i32 { return get32(W,64); }
fn h_conflicts_set(W:[]u8, v:i32)void { set32(W,64,v); return; }
fn h_epproc(W:[]u8)i32 { return get32(W,68); }
fn h_epproc_set(W:[]u8, v:i32)void { set32(W,68,v); return; }

fn sub_init(W:[]u8, nvar:i32)i32 {
  if(nvar<1 || nvar>8){
    emit("substrate: nvar out of range\n");
    return 0;
  }
  let ep_stride:i32=((5+2*nvar+3)/4)*4;
  let ent_stride:i32=((56+9*nvar+3)/4)*4;
  let ep_base:i32=128;
  let ent_base:i32=ep_base+64*ep_stride;
  let fact_base:i32=ent_base+64*ent_stride;
  let str_base:i32=fact_base+256*12;
  if(str_base+4096>32768){
    emit("substrate: workspace too small\n");
    return 0;
  }
  set32(W,0,1397057875);
  set32(W,4,nvar);
  set32(W,8,ep_stride);
  set32(W,12,ent_stride);
  set32(W,16,ep_base);
  set32(W,20,ent_base);
  set32(W,24,fact_base);
  set32(W,28,str_base);
  set32(W,32,str_base);
  set32(W,36,0);
  set32(W,40,0);
  set32(W,44,0);
  set32(W,48,0);
  set32(W,52,64);
  set32(W,56,64);
  set32(W,60,256);
  set32(W,64,0);
  set32(W,68,0);
  return 1;
}

// ============ strings ============
// record: len(4) + bytes. returns offset of len field.
fn sub_str(W:[]u8, s:[]u8)i32 {
  let p:i32=h_strcur(W);
  set32(W,p,s.len);
  let i:i32=0;
  while(i<s.len){ W[p+4+i]=s[i]; i=i+1; }
  h_strcur_set(W,p+4+s.len);
  return p;
}
fn sub_streq(W:[]u8, o1:i32, o2:i32)i32 {
  let l1:i32=get32(W,o1);
  let l2:i32=get32(W,o2);
  if(l1!=l2){return 0;}
  let i:i32=0;
  while(i<l1){
    if(W[o1+4+i]!=W[o2+4+i]){return 0;}
    i=i+1;
  }
  return 1;
}

// ============ fact store ============
// triple: e_off(4), a_off(4), v_off(4)
fn sub_fact_learn(W:[]u8, e:[]u8, a:[]u8, v:[]u8)i32 {
  let fc:i32=h_factcount(W);
  if(fc>=256){return -1;}
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let vo:i32=sub_str(W,v);
  let i:i32=0;
  while(i<fc){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      if(sub_streq(W,get32(W,o+8),vo)==0){
        h_conflicts_set(W,h_conflicts(W)+1);
      }
    }
    i=i+1;
  }
  let o2:i32=h_factbase(W)+fc*12;
  set32(W,o2,eo); set32(W,o2+4,ao); set32(W,o2+8,vo);
  h_factcount_set(W,fc+1);
  return fc;
}
// latest matching triple; copies value bytes to out; returns len or -1
fn sub_fact_query(W:[]u8, e:[]u8, a:[]u8, out:[]u8)i32 {
  let eo:i32=sub_str(W,e);
  let ao:i32=sub_str(W,a);
  let i:i32=h_factcount(W)-1;
  while(i>=0){
    let o:i32=h_factbase(W)+i*12;
    if(sub_streq(W,get32(W,o),eo)==1 && sub_streq(W,get32(W,o+4),ao)==1){
      let vo:i32=get32(W,o+8);
      let l:i32=get32(W,vo);
      let k:i32=0;
      while(k<l){ out[k]=W[vo+4+k]; k=k+1; }
      return l;
    }
    i=i-1;
  }
  return -1;
}

// ============ episodes ============
// record: seq(4), state[nvar], act(1), next[nvar]
fn ep_off(W:[]u8, e:i32)i32 { return h_epbase(W)+e*h_epstride(W); }
fn ep_state(W:[]u8, e:i32, v:i32)i32 { return W[ep_off(W,e)+4+v] as i32; }
fn ep_act(W:[]u8, e:i32)i32 { return W[ep_off(W,e)+4+h_nvar(W)] as i32; }
fn ep_next(W:[]u8, e:i32, v:i32)i32 { return W[ep_off(W,e)+5+h_nvar(W)+v] as i32; }
fn sub_episode(W:[]u8, state:[]u8, act:i32, next:[]u8)i32 {
  let i:i32=h_epcount(W);
  if(i>=64){return -1;}
  let nvar:i32=h_nvar(W);
  let o:i32=ep_off(W,i);
  set32(W,o,h_seq(W));
  h_seq_set(W,h_seq(W)+1);
  let v:i32=0;
  while(v<nvar){ W[o+4+v]=state[v]; v=v+1; }
  W[o+4+nvar]=act as u8;
  v=0;
  while(v<nvar){ W[o+5+nvar+v]=next[v]; v=v+1; }
  h_epcount_set(W,i+1);
  return i;
}

// ============ causal entries ============
// used(4), action(4), mask(4), cond[4*nvar], kind[nvar],
// param[4*nvar], status(4), parent(4), nsup(4), sup[8*4]
// kind: 0=UNRES, 1=UNCH, 2=UNCHANGED-SET? no: 1=UNCH, 2=SET
// status: 0=active, 1=ambiguous, 2=superseded
fn en_off(W:[]u8, i:i32)i32 { return h_entbase(W)+i*h_entstride(W); }
fn en_used(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)); }
fn en_action(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+4); }
fn en_mask(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+8); }
fn en_cond(W:[]u8, i:i32, v:i32)i32 { return get32(W,en_off(W,i)+12+v*4); }
fn en_kind(W:[]u8, i:i32, v:i32)i32 { return W[en_off(W,i)+12+4*h_nvar(W)+v] as i32; }
fn en_param(W:[]u8, i:i32, v:i32)i32 { return get32(W,en_off(W,i)+12+5*h_nvar(W)+v*4); }
fn en_status(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+12+9*h_nvar(W)); }
fn en_status_set(W:[]u8, i:i32, s:i32)void { set32(W,en_off(W,i)+12+9*h_nvar(W),s); return; }
fn en_nsup(W:[]u8, i:i32)i32 { return get32(W,en_off(W,i)+20+9*h_nvar(W)); }
fn en_sup(W:[]u8, i:i32, k:i32)i32 { return get32(W,en_off(W,i)+24+9*h_nvar(W)+k*4); }

fn ent_create(W:[]u8, act:i32, mask:i32, cond:[]u8, kind:[]u8, param:[]u8, parent:i32)i32 {
  let i:i32=h_entcount(W);
  if(i>=64){return -1;}
  let nvar:i32=h_nvar(W);
  let o:i32=en_off(W,i);
  set32(W,o,1);
  set32(W,o+4,act);
  set32(W,o+8,mask);
  let v:i32=0;
  while(v<nvar){ set32(W,o+12+v*4,get32(cond,v*4)); v=v+1; }
  v=0;
  while(v<nvar){ W[o+12+4*nvar+v]=kind[v]; v=v+1; }
  v=0;
  while(v<nvar){ set32(W,o+12+5*nvar+v*4,get32(param,v*4)); v=v+1; }
  set32(W,o+12+9*nvar,0);
  set32(W,o+16+9*nvar,parent);
  set32(W,o+20+9*nvar,0);
  h_entcount_set(W,i+1);
  return i;
}
fn ent_add_sup(W:[]u8, i:i32, e:i32)i32 {
  let n:i32=en_nsup(W,i);
  let k:i32=0;
  while(k<n){
    if(en_sup(W,i,k)==e){return 0;}
    k=k+1;
  }
  if(n>=8){return 0;}
  set32(W,en_off(W,i)+24+9*h_nvar(W)+n*4,e);
  set32(W,en_off(W,i)+20+9*h_nvar(W),n+1);
  return 1;
}
fn cond_matches(W:[]u8, i:i32, state:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let m:i32=en_mask(W,i);
  let v:i32=0;
  while(v<nvar){
    if(((m>>v)&1)==1){
      if(en_cond(W,i,v)!=(state[v] as i32)){return 0;}
    }
    v=v+1;
  }
  return 1;
}
// consistency of entry i with (state,next): 1 ok, 0 conflict
fn ent_consistent(W:[]u8, i:i32, state:[]u8, next:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let v:i32=0;
  while(v<nvar){
    let k:i32=en_kind(W,i,v);
    if(k==1){
      if((next[v] as i32)!=(state[v] as i32)){return 0;}
    } else {
      if(k==2){
        if((next[v] as i32)!=en_param(W,i,v)){return 0;}
      }
    }
    v=v+1;
  }
  return 1;
}
fn popcnt(m:i32)i32 {
  let c:i32=0;
  while(m>0){ c=c+(m&1); m=m>>1; }
  return c;
}

// incremental learning over unprocessed episodes
fn sub_causal_update(W:[]u8)void {
  let nvar:i32=h_nvar(W);
  while(h_epproc(W)<h_epcount(W)){
    let e:i32=h_epproc(W);
    let act:i32=ep_act(W,e);
    let state:[]u8=z_alloc(8);
    let next:[]u8=z_alloc(8);
    let v:i32=0;
    while(v<nvar){ state[v]=ep_state(W,e,v) as u8; next[v]=ep_next(W,e,v) as u8; v=v+1; }
    // find matching active entries
    let nmatch:i32=0;
    let mi:i32=0;
    while(mi<h_entcount(W)){
      if(en_used(W,mi)==1 && en_status(W,mi)==0 && en_action(W,mi)==act && cond_matches(W,mi,state)==1){
        if(ent_consistent(W,mi,state,next)==1){
          if(ent_add_sup(W,mi,e)==1){
            emit("CAUSAL support entry ");
            emit(i32s(mi));
            emit(" ep ");
            emit(i32s(e));
            emit("\n");
          }
        } else {
          // specialize: parent becomes ambiguous, two children
          en_status_set(W,mi,1);
          emit("CAUSAL entry ");
          emit(i32s(mi));
          emit(" AMBIGUOUS on ep ");
          emit(i32s(e));
          emit("\n");
          // v* = first var where state differs from first support state
          let se:i32=en_sup(W,mi,0);
          let vs:i32=-1;
          v=0;
          while(v<nvar){
            if((state[v] as i32)!=ep_state(W,se,v)){ vs=v; break; }
            v=v+1;
          }
          let cmask:i32=en_mask(W,mi);
          let ccond:[]u8=z_alloc(32);
          let ckind:[]u8=z_alloc(8);
          let cparam:[]u8=z_alloc(32);
          v=0;
          while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
          if(vs<0){
            // nondeterministic on identical state: fully specific children
            cmask=(1<<nvar)-1;
            v=0;
            while(v<nvar){ set32(ccond,v*4,state[v] as i32); v=v+1; }
            let c1:i32=ent_create(W,act,cmask,ccond,ckind,cparam,mi);
            // fill child1 effects from new episode
            v=0;
            while(v<nvar){
              let o1:i32=en_off(W,c1);
              if((next[v] as i32)==(state[v] as i32)){ W[o1+12+4*nvar+v]=1 as u8; }
              else { W[o1+12+4*nvar+v]=2 as u8; set32(W,o1+12+5*nvar+v*4,next[v] as i32); }
              v=v+1;
            }
            ent_add_sup(W,c1,e);
            emit("CAUSAL new child entry ");
            emit(i32s(c1));
            emit(" (nondeterministic split)\n");
          } else {
            let oldv:i32=ep_state(W,se,vs);
            // child1: new episode side
            let m1:i32=cmask|(1<<vs);
            v=0;
            while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
            set32(ccond,vs*4,state[vs] as i32);
            v=0;
            while(v<nvar){
              if((next[v] as i32)==(state[v] as i32)){ ckind[v]=1 as u8; }
              else { ckind[v]=2 as u8; }
              set32(cparam,v*4,next[v] as i32);
              v=v+1;
            }
            let c1:i32=ent_create(W,act,m1,ccond,ckind,cparam,mi);
            ent_add_sup(W,c1,e);
            emit("CAUSAL new child entry ");
            emit(i32s(c1));
            emit(" cond v");
            emit(i32s(vs));
            emit("=");
            emit(i32s(state[vs] as i32));
            emit("\n");
            // child2: old support side, parent effects
            let m2:i32=cmask|(1<<vs);
            v=0;
            while(v<nvar){ set32(ccond,v*4,en_cond(W,mi,v)); v=v+1; }
            set32(ccond,vs*4,oldv);
            v=0;
            while(v<nvar){
              ckind[v]=en_kind(W,mi,v) as u8;
              set32(cparam,v*4,en_param(W,mi,v));
              v=v+1;
            }
            let c2:i32=ent_create(W,act,m2,ccond,ckind,cparam,mi);
            // carry consistent support
            let k:i32=0;
            while(k<en_nsup(W,mi)){
              let oe:i32=en_sup(W,mi,k);
              let okk:i32=1;
              if(ep_state(W,oe,vs)!=oldv){okk=0;}
              if(okk==1){
                let st2:[]u8=z_alloc(8);
                let nx2:[]u8=z_alloc(8);
                let w2:i32=0;
                while(w2<nvar){ st2[w2]=ep_state(W,oe,w2) as u8; nx2[w2]=ep_next(W,oe,w2) as u8; w2=w2+1; }
                if(ent_consistent(W,c2,st2,nx2)==1){ent_add_sup(W,c2,oe);}
              }
              k=k+1;
            }
            emit("CAUSAL new child entry ");
            emit(i32s(c2));
            emit(" cond v");
            emit(i32s(vs));
            emit("=");
            emit(i32s(oldv));
            emit("\n");
          }
        }
        nmatch=nmatch+1;
      }
      mi=mi+1;
    }
    if(nmatch==0){
      // fresh general entry: empty mask, effects from this episode
      let ccond:[]u8=z_alloc(32);
      let ckind:[]u8=z_alloc(8);
      let cparam:[]u8=z_alloc(32);
      v=0;
      while(v<nvar){
        set32(ccond,v*4,0);
        if((next[v] as i32)==(state[v] as i32)){ ckind[v]=1 as u8; }
        else { ckind[v]=2 as u8; }
        set32(cparam,v*4,next[v] as i32);
        v=v+1;
      }
      let ni:i32=ent_create(W,act,0,ccond,ckind,cparam,-1);
      ent_add_sup(W,ni,e);
      emit("CAUSAL new entry ");
      emit(i32s(ni));
      emit(" act=");
      emit(i32s(act));
      emit(" mask=0\n");
    }
    h_epproc_set(W,e+1);
  }
  return;
}

// query: most specific matching active entry predicts.
// returns 1 with out_next filled, 2 ambiguous, 0 no match.
fn sub_causal_query(W:[]u8, state:[]u8, act:i32, out_next:[]u8)i32 {
  let nvar:i32=h_nvar(W);
  let best:i32=-1;
  let bestbits:i32=-1;
  let i:i32=0;
  while(i<h_entcount(W)){
    if(en_used(W,i)==1 && en_status(W,i)==0 && en_action(W,i)==act && cond_matches(W,i,state)==1){
      let b:i32=popcnt(en_mask(W,i));
      if(b>bestbits){bestbits=b; best=i;}
    }
    i=i+1;
  }
  if(best<0){return 0;}
  // tie check: another active entry with same specificity disagreeing
  i=0;
  while(i<h_entcount(W)){
    if(i!=best && en_used(W,i)==1 && en_status(W,i)==0 && en_action(W,i)==act && cond_matches(W,i,state)==1){
      if(popcnt(en_mask(W,i))==bestbits){
        let v:i32=0;
        let same:i32=1;
        while(v<nvar){
          let p1:i32=0;
          let p2:i32=0;
          if(en_kind(W,best,v)==1){p1=state[v] as i32;} else {p1=en_param(W,best,v);}
          if(en_kind(W,i,v)==1){p2=state[v] as i32;} else {p2=en_param(W,i,v);}
          if(p1!=p2){same=0; break;}
          v=v+1;
        }
        if(same==0){return 2;}
      }
    }
    i=i+1;
  }
  let v2:i32=0;
  while(v2<nvar){
    if(en_kind(W,best,v2)==1){out_next[v2]=state[v2];}
    else {out_next[v2]=en_param(W,best,v2) as u8;}
    v2=v2+1;
  }
  return 1;
}

fn emit_state(tag:[]u8, s:[]u8, nvar:i32)void {
  emit(tag);
  let v:i32=0;
  while(v<nvar){ emit(i32s(s[v] as i32)); v=v+1; }
  return;
}


// ============ synergy helpers ============
fn parse_i32(s:[]u8, n:i32)i32 {
  let v:i32=0;
  let i:i32=0;
  while(i<n){
    let c:i32=s[i] as i32;
    if(c>=48 && c<=57){ v=v*10+(c-48); }
    i=i+1;
  }
  return v;
}
fn streq2(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){
    if(a[i]!=b[i]){ return 0; }
    i=i+1;
  }
  return 1;
}
// deterministic LCG: x = (137*x+187) mod 1000003. No overflow (137*1000002 < 2^31).
fn lcg_next(st:[]u8)i32 {
  let x:i32=get32(st,0);
  let nx:i32=(137*x+187)%1000003;
  set32(st,0,nx);
  return nx;
}
// world 1 = W1 (4-cycle, p=0.98 signal), world 2 = W2 (c0 row changed). r in [0,100).
fn next_concept(world:i32, c:i32, r:i32)i32 {
  if(world==2 && c==0){
    if(r<10){return 1;}
    if(r<90){return 2;}
    return 0;
  }
  if(c==0){ if(r<98){return 1;} return 0; }
  if(c==1){ if(r<98){return 2;} return 0; }
  if(c==2){ if(r<98){return 3;} return 2; }
  if(r<98){return 0;} return 3;
}
fn cname2(ci:i32)[]u8 {
  if(ci==0){return "c0";}
  if(ci==1){return "c1";}
  if(ci==2){return "c2";}
  return "c3";
}
// concept bigram entity "cb_N", N = ci*4+cj in 0..15
fn cb_ent(n:i32)[]u8 {
  let b:[]u8=z_alloc(6);
  b[0]=99; b[1]=98; b[2]=95;
  if(n<10){ b[3]=(48+n) as u8; return b[0..4]; }
  b[3]=(48+(n/10)) as u8; b[4]=(48+(n%10)) as u8;
  return b[0..5];
}
// raw morpheme bigram entity "rb_N", N = mi*8+mj in 0..63
fn rb_ent(n:i32)[]u8 {
  let b:[]u8=z_alloc(7);
  b[0]=114; b[1]=98; b[2]=95;
  if(n<10){ b[3]=(48+n) as u8; return b[0..4]; }
  if(n<100){
    b[3]=(48+(n/10)) as u8; b[4]=(48+(n%10)) as u8;
    return b[0..5];
  }
  b[3]=(48+(n/100)) as u8;
  let t:i32=n%100;
  b[4]=(48+(t/10)) as u8; b[5]=(48+(t%10)) as u8;
  return b[0..6];
}
fn cb_bump(W:[]u8, ci:i32, cj:i32, created:[]u8)i32 {
  let n:i32=ci*4+cj;
  let e:[]u8=cb_ent(n);
  let qb:[]u8=z_alloc(16);
  if(created[n]==0){
    created[n]=1;
    sub_fact_learn(W,e,"first",cname2(ci));
    sub_fact_learn(W,e,"second",cname2(cj));
    sub_fact_learn(W,e,"count","1");
    return 1;
  }
  let l:i32=sub_fact_query(W,e,"count",qb);
  let c:i32=parse_i32(qb,l)+1;
  sub_fact_learn(W,e,"count",i32s(c));
  return c;
}
fn cb_get(W:[]u8, ci:i32, cj:i32, created:[]u8)i32 {
  let n:i32=ci*4+cj;
  if(created[n]==0){ return 0; }
  let qb:[]u8=z_alloc(16);
  let l:i32=sub_fact_query(W,cb_ent(n),"count",qb);
  return parse_i32(qb,l);
}
fn rb_bump(W:[]u8, mi:i32, mj:i32, created:[]u8)i32 {
  let n:i32=mi*8+mj;
  let e:[]u8=rb_ent(n);
  let qb:[]u8=z_alloc(16);
  if(created[n]==0){
    created[n]=1;
    sub_fact_learn(W,e,"count","1");
    return 1;
  }
  let l:i32=sub_fact_query(W,e,"count",qb);
  let c:i32=parse_i32(qb,l)+1;
  sub_fact_learn(W,e,"count",i32s(c));
  return c;
}
fn rb_get(W:[]u8, mi:i32, mj:i32, created:[]u8)i32 {
  let n:i32=mi*8+mj;
  if(created[n]==0){ return 0; }
  let qb:[]u8=z_alloc(16);
  let l:i32=sub_fact_query(W,rb_ent(n),"count",qb);
  return parse_i32(qb,l);
}

// ============ synergy 1: convergence and F1 ============
// gold concept cells: (0,1)=1, (1,2)=6, (2,3)=11, (3,0)=12
fn is_cgold(k:i32)i32 {
  if(k==1||k==6||k==11||k==12){return 1;}
  return 0;
}
fn concept_converged(W:[]u8, created:[]u8)i32 {
  let k:i32=0;
  while(k<16){
    let cnt:i32=cb_get(W,k/4,k%4,created);
    if(is_cgold(k)==1){ if(cnt<3){return 0;} }
    else { if(cnt>=3){return 0;} }
    k=k+1;
  }
  return 1;
}
fn f1_concept(W:[]u8, created:[]u8)i32 {
  let tp:i32=0; let fp:i32=0; let fn2:i32=0;
  let k:i32=0;
  while(k<16){
    let act:i32=0;
    if(cb_get(W,k/4,k%4,created)>=3){act=1;}
    if(is_cgold(k)==1){
      if(act==1){tp=tp+1;} else {fn2=fn2+1;}
    } else {
      if(act==1){fp=fp+1;}
    }
    k=k+1;
  }
  let den:i32=2*tp+fp+fn2;
  if(den==0){return 1000;}
  return (2000*tp)/den;
}
// gold raw cells: (0,1)->{2,3,10,11}, (1,2)->{20,21,28,29},
// (2,3)->{38,39,46,47}, (3,0)->{48,49,56,57}
fn is_rgold(k:i32)i32 {
  if(k==2||k==3||k==10||k==11){return 1;}
  if(k==20||k==21||k==28||k==29){return 1;}
  if(k==38||k==39||k==46||k==47){return 1;}
  if(k==48||k==49||k==56||k==57){return 1;}
  return 0;
}
fn raw_converged(W:[]u8, created:[]u8)i32 {
  let k:i32=0;
  while(k<64){
    let cnt:i32=rb_get(W,k/8,k%8,created);
    if(is_rgold(k)==1){ if(cnt<3){return 0;} }
    else { if(cnt>=3){return 0;} }
    k=k+1;
  }
  return 1;
}
fn f1_raw(W:[]u8, created:[]u8)i32 {
  let tp:i32=0; let fp:i32=0; let fn2:i32=0;
  let k:i32=0;
  while(k<64){
    let act:i32=0;
    if(rb_get(W,k/8,k%8,created)>=3){act=1;}
    if(is_rgold(k)==1){
      if(act==1){tp=tp+1;} else {fn2=fn2+1;}
    } else {
      if(act==1){fp=fp+1;}
    }
    k=k+1;
  }
  let den:i32=2*tp+fp+fn2;
  if(den==0){return 1000;}
  return (2000*tp)/den;
}
// ============ synergy 2: procedures and prediction ============
// procedure entity "sp_N". Facts: (sp_N,"len","2"), ("step0",X),
// ("step1",Y), ("status",S), ("support","<n>"), ("contradictions","<n>")
fn syn_proc_name(n:i32)[]u8 {
  let b:[]u8=z_alloc(8);
  b[0]=115; b[1]=112; b[2]=95;
  if(n<10){ b[3]=(48+n) as u8; return b[0..4]; }
  b[3]=(48+(n/10)) as u8; b[4]=(48+(n%10)) as u8;
  return b[0..5];
}
fn syn_proc_create(W:[]u8, n:i32, A:[]u8, B:[]u8, support:i32)void {
  let pn:[]u8=syn_proc_name(n);
  sub_fact_learn(W,pn,"len","2");
  sub_fact_learn(W,pn,"step0",A);
  sub_fact_learn(W,pn,"step1",B);
  sub_fact_learn(W,pn,"status","ACTIVE");
  sub_fact_learn(W,pn,"support",i32s(support));
  return;
}
fn syn_proc_status(W:[]u8, n:i32, out:[]u8)i32 {
  return sub_fact_query(W,syn_proc_name(n),"status",out);
}
fn syn_proc_support(W:[]u8, n:i32)i32 {
  let qb:[]u8=z_alloc(16);
  let l:i32=sub_fact_query(W,syn_proc_name(n),"support",qb);
  return parse_i32(qb,l);
}
fn syn_proc_step(W:[]u8, n:i32, which:[]u8, out:[]u8)i32 {
  return sub_fact_query(W,syn_proc_name(n),which,out);
}
// predict(x): step1 of ACTIVE proc with step0==x, highest support wins.
// returns length of prediction, 0 = abstain.
fn syn_predict(W:[]u8, nproc:i32, x:[]u8, out:[]u8)i32 {
  let best:i32=-1;
  let bestsup:i32=-1;
  let sb:[]u8=z_alloc(16);
  let s0:[]u8=z_alloc(8);
  let p:i32=0;
  while(p<nproc){
    let sl:i32=syn_proc_status(W,p,sb);
    if(sl==6 && streq2(sb[0..sl],"ACTIVE")==1){
      let l0:i32=syn_proc_step(W,p,"step0",s0);
      if(l0==x.len && streq2(s0[0..l0],x)==1){
        let sup:i32=syn_proc_support(W,p);
        if(sup>bestsup){ bestsup=sup; best=p; }
      }
    }
    p=p+1;
  }
  if(best<0){ return 0; }
  let pb:[]u8=z_alloc(8);
  let pl:i32=syn_proc_step(W,best,"step1",pb);
  let i:i32=0;
  while(i<pl){ out[i]=pb[i]; i=i+1; }
  return pl;
}

// cache-based predict: active/px/py/supA mirror substrate procedure facts.
// Avoids redundant substrate queries in the hot loop (the substrate's
// string interning has no dedup; thousands of queries would overflow
// the string pool). The substrate remains the persistent store; the
// cache is verified against it after Phase B.
fn cache_predict(nproc:i32, active:[]u8, px:[]u8, py:[]u8, supA:[]u8, X:i32)i32 {
  let best:i32=-1;
  let bestsup:i32=-1;
  let p:i32=0;
  while(p<nproc){
    if(active[p]==1 && get32(px,p*4)==X){
      let sup:i32=get32(supA,p*4);
      if(sup>bestsup){ bestsup=sup; best=p; }
    }
    p=p+1;
  }
  if(best<0){ return -1; }
  return get32(py,best*4);
}
// ============ synergy 2: phase machinery ============
fn feed_eps(W:[]u8, cc:[]u8, seq_f:[]u8, seq_t:[]u8, e0:i32, e1:i32)void {
  let e:i32=e0;
  while(e<e1){
    let b:i32=0;
    while(b<5){
      cb_bump(W, seq_f[e*5+b] as i32, seq_t[e*5+b] as i32, cc);
      b=b+1;
    }
    e=e+1;
  }
  return;
}
// build ACTIVE procedures for concept pairs with count>=3.
// supA/px/py are i32 arrays (nproc entries).
fn build_procs(W:[]u8, cc:[]u8, nproc_out:[]u8, supA:[]u8, px:[]u8, py:[]u8)i32 {
  let nproc:i32=0;
  let i:i32=0;
  while(i<4){
    let j:i32=0;
    while(j<4){
      let cnt:i32=cb_get(W,i,j,cc);
      if(cnt>=3){
        syn_proc_create(W,nproc,cname2(i),cname2(j),cnt);
        set32(supA,nproc*4,cnt);
        set32(px,nproc*4,i);
        set32(py,nproc*4,j);
        nproc=nproc+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  set32(nproc_out,0,nproc);
  return nproc;
}
// Phase-A set must be exactly {(0,1),(1,2),(2,3),(3,0)} in scan order.
fn phase_a_ok(px:[]u8, py:[]u8, nproc:i32)i32 {
  if(nproc!=4){return 0;}
  if(get32(px,0)!=0||get32(py,0)!=1){return 0;}
  if(get32(px,4)!=1||get32(py,4)!=2){return 0;}
  if(get32(px,8)!=2||get32(py,8)!=3){return 0;}
  if(get32(px,12)!=3||get32(py,12)!=0){return 0;}
  return 1;
}
// Phase B with contradiction detector + revision. Returns correct count
// over the 200 Phase-B bigrams. rev_ep[0] = 1-indexed episode of first
// revision, 0 if none. Uses a Zag-side active[] cache mirroring
// substrate procedure statuses (verified against substrate at the end).
fn phase_b_revise(W:[]u8, cc:[]u8, seq_f:[]u8, seq_t:[]u8, nproc0:i32, supA:[]u8, px:[]u8, py:[]u8, rev_ep:[]u8)i32 {
  let nproc:i32=nproc0;
  let active:[]u8=z_alloc(32);
  let p0:i32=0;
  while(p0<nproc0){ active[p0]=1; p0=p0+1; }
  let consec:[]u8=z_alloc(32*4);
  let ncontr:[]u8=z_alloc(32*4);
  let correct:i32=0;
  let e:i32=30;
  while(e<70){
    feed_eps(W,cc,seq_f,seq_t,e,e+1);
    // sliding window counts over episodes max(0,e-9)..e
    let win:[]u8=z_alloc(16*4);
    let w0:i32=e-9;
    if(w0<0){w0=0;}
    let ee:i32=w0;
    while(ee<=e){
      let b:i32=0;
      while(b<5){
        let fi:i32=seq_f[ee*5+b] as i32;
        let ti:i32=seq_t[ee*5+b] as i32;
        let wn:i32=fi*4+ti;
        set32(win,wn*4,get32(win,wn*4)+1);
        b=b+1;
      }
      ee=ee+1;
    }
    // contradiction check and revision for each ACTIVE proc
    let p:i32=0;
    while(p<nproc){
      if(active[p]==1){
        let X:i32=get32(px,p*4);
        let Y:i32=get32(py,p*4);
        let expected:i32=(get32(supA,p*4)*10)/30;
        let wc:i32=get32(win,(X*4+Y)*4);
        if(wc*2<expected){
          set32(ncontr,p*4,get32(ncontr,p*4)+1);
          set32(consec,p*4,get32(consec,p*4)+1);
          sub_fact_learn(W,syn_proc_name(p),"contradictions",i32s(get32(ncontr,p*4)));
          if(get32(consec,p*4)>=2){
            sub_fact_learn(W,syn_proc_name(p),"status","ROLLED_BACK");
            active[p]=0;
            let bestz:i32=-1; let bestc:i32=0;
            let z:i32=0;
            while(z<4){
              if(z!=Y){
                let c2:i32=get32(win,(X*4+z)*4);
                if(c2>=3 && c2>bestc){bestc=c2; bestz=z;}
              }
              z=z+1;
            }
            if(bestz>=0){
              syn_proc_create(W,nproc,cname2(X),cname2(bestz),bestc);
              set32(supA,nproc*4,bestc);
              set32(px,nproc*4,X);
              set32(py,nproc*4,bestz);
              active[nproc]=1;
              nproc=nproc+1;
              if(get32(rev_ep,0)==0){ set32(rev_ep,0,e+1); }
            }
          }
        } else {
          set32(consec,p*4,0);
        }
      }
      p=p+1;
    }
    // predict this episode's bigrams via the cache
    let b2:i32=0;
    while(b2<5){
      let Xi:i32=seq_f[e*5+b2] as i32;
      let Yi:i32=seq_t[e*5+b2] as i32;
      if(cache_predict(nproc,active,px,py,supA,Xi)==Yi){ correct=correct+1; }
      b2=b2+1;
    }
    e=e+1;
  }
  // verify cache against substrate statuses
  let v:i32=0;
  while(v<nproc){
    let sb:[]u8=z_alloc(16);
    let sl:i32=syn_proc_status(W,v,sb);
    let isact:i32=0;
    if(sl==6 && streq2(sb[0..sl],"ACTIVE")==1){ isact=1; }
    if(isact!=active[v]){
      emit("CACHE MISMATCH proc="); emit(i32s(v)); emit("\n");
    }
    v=v+1;
  }
  return correct;
}
// Phase B with procedures frozen after Phase A. Returns correct count.
// Uses the same cache-based prediction over the frozen procedure set.
fn phase_b_frozen(seq_f:[]u8, seq_t:[]u8, nproc:i32, px:[]u8, py:[]u8, supA:[]u8)i32 {
  let correct:i32=0;
  let e:i32=30;
  while(e<70){
    let b:i32=0;
    while(b<5){
      let Xi:i32=seq_f[e*5+b] as i32;
      let Yi:i32=seq_t[e*5+b] as i32;
      let best:i32=-1; let bestsup:i32=-1;
      let p:i32=0;
      while(p<nproc){
        if(get32(px,p*4)==Xi){
          let sup:i32=get32(supA,p*4);
          if(sup>bestsup){ bestsup=sup; best=p; }
        }
        p=p+1;
      }
      if(best>=0 && get32(py,best*4)==Yi){ correct=correct+1; }
      b=b+1;
    }
    e=e+1;
  }
  return correct;
}
// ============ main ============
fn main()i32 {
  let fails:i32=0;
  emit("SUBSTRATE-SYN start\n");
  // ---------- SYNERGY 1: concept -> procedure ----------
  // COND-CONCEPT: count concept bigrams (concept structure as input)
  let Wc:[]u8=z_alloc(32768);
  if(sub_init(Wc,1)==0){ emit("INIT FAIL Wc\n"); return 1; }
  let cc:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(4);
  set32(st,0,12345);
  let c:i32=0;
  let e:i32=0;
  let conv_c:i32=-1;
  let f1c10:i32=0; let f1c20:i32=0; let f1c40:i32=0;
  while(e<100){
    let b:i32=0;
    while(b<5){
      let r:i32=(lcg_next(st)*100)/1000003;
      let nc:i32=next_concept(1,c,r);
      // dummy draws keep the LCG stream aligned with COND-RAW
      let d1:i32=lcg_next(st);
      let d2:i32=lcg_next(st);
      if(d1<0 && d2<0){ emit("unreachable\n"); }
      cb_bump(Wc,c,nc,cc);
      c=nc;
      b=b+1;
    }
    e=e+1;
    if(e==10){ f1c10=f1_concept(Wc,cc); }
    if(e==20){ f1c20=f1_concept(Wc,cc); }
    if(e==40){ f1c40=f1_concept(Wc,cc); }
    if(conv_c<0 && concept_converged(Wc,cc)==1){ conv_c=e; }
  }
  // COND-RAW: count morpheme bigrams directly (no concept input)
  let Wr:[]u8=z_alloc(32768);
  if(sub_init(Wr,1)==0){ emit("INIT FAIL Wr\n"); return 1; }
  let cr:[]u8=z_alloc(64);
  set32(st,0,12345);
  c=0; e=0;
  let conv_r:i32=-1;
  let f1r10:i32=0; let f1r20:i32=0; let f1r40:i32=0;
  while(e<100){
    let b:i32=0;
    while(b<5){
      let r:i32=(lcg_next(st)*100)/1000003;
      let nc:i32=next_concept(1,c,r);
      let m1:i32=(lcg_next(st)*2)/1000003;
      let m2:i32=(lcg_next(st)*2)/1000003;
      rb_bump(Wr,c*2+m1,nc*2+m2,cr);
      c=nc;
      b=b+1;
    }
    e=e+1;
    if(e==10){ f1r10=f1_raw(Wr,cr); }
    if(e==20){ f1r20=f1_raw(Wr,cr); }
    if(e==40){ f1r40=f1_raw(Wr,cr); }
    if(conv_r<0 && raw_converged(Wr,cr)==1){ conv_r=e; }
  }
  emit("SYN1 CONCEPT conv="); emit(i32s(conv_c));
  emit(" f1_10="); emit(i32s(f1c10));
  emit(" f1_20="); emit(i32s(f1c20));
  emit(" f1_40="); emit(i32s(f1c40)); emit("\n");
  emit("SYN1 RAW conv="); emit(i32s(conv_r));
  emit(" f1_10="); emit(i32s(f1r10));
  emit(" f1_20="); emit(i32s(f1r20));
  emit(" f1_40="); emit(i32s(f1r40)); emit("\n");
  if(conv_c<0 || conv_r<0){
    emit("CHECK FAIL P1-not-converged\n"); fails=fails+1;
  } else if(conv_c<conv_r){
    emit("CHECK PASS P1-concept-faster\n");
  } else {
    emit("CHECK FAIL P1-raw-not-slower\n"); fails=fails+1;
  }
  // ---------- SYNERGY 2: contradiction -> revision ----------
  // One shared deterministic stream: 70 episodes x 5 bigrams,
  // world switches W1->W2 at episode 30 (0-indexed).
  let seq_f:[]u8=z_alloc(350);
  let seq_t:[]u8=z_alloc(350);
  set32(st,0,777);
  c=0; e=0;
  while(e<70){
    let world:i32=1;
    if(e>=30){ world=2; }
    let b:i32=0;
    while(b<5){
      let r:i32=(lcg_next(st)*100)/1000003;
      let nc:i32=next_concept(world,c,r);
      seq_f[e*5+b]=c as u8;
      seq_t[e*5+b]=nc as u8;
      c=nc;
      b=b+1;
    }
    e=e+1;
  }
  emit("SYN2 stream generated\n");
  // REVISE workspace: Phase A then Phase B with detector+policy
  let Wv:[]u8=z_alloc(32768);
  if(sub_init(Wv,1)==0){ emit("INIT FAIL Wv\n"); return 1; }
  let ccv:[]u8=z_alloc(16);
  let nproc_v:[]u8=z_alloc(4);
  let supAv:[]u8=z_alloc(32*4);
  let pxv:[]u8=z_alloc(32*4);
  let pyv:[]u8=z_alloc(32*4);
  feed_eps(Wv,ccv,seq_f,seq_t,0,30);
  let npv:i32=build_procs(Wv,ccv,nproc_v,supAv,pxv,pyv);
  // FROZEN workspace: Phase A only, procedures frozen
  let Wf:[]u8=z_alloc(32768);
  if(sub_init(Wf,1)==0){ emit("INIT FAIL Wf\n"); return 1; }
  let ccf:[]u8=z_alloc(16);
  let nproc_f:[]u8=z_alloc(4);
  let supAf:[]u8=z_alloc(32*4);
  let pxf:[]u8=z_alloc(32*4);
  let pyf:[]u8=z_alloc(32*4);
  feed_eps(Wf,ccf,seq_f,seq_t,0,30);
  let npf:i32=build_procs(Wf,ccf,nproc_f,supAf,pxf,pyf);
  emit("SYN2 phaseA nproc_v="); emit(i32s(npv));
  emit(" nproc_f="); emit(i32s(npf)); emit("\n");
  if(phase_a_ok(pxv,pyv,npv)==1 && phase_a_ok(pxf,pyf,npf)==1){
    emit("CHECK PASS phaseA-set\n");
  } else {
    emit("CHECK FAIL phaseA-set\n"); fails=fails+1;
  }
  let rev_ep:[]u8=z_alloc(4);
  set32(rev_ep,0,0);
  let corr_v:i32=phase_b_revise(Wv,ccv,seq_f,seq_t,npv,supAv,pxv,pyv,rev_ep);
  let corr_f:i32=phase_b_frozen(seq_f,seq_t,npf,pxf,pyf,supAf);
  emit("SYN2 REVISE correct="); emit(i32s(corr_v)); emit("/200");
  emit(" rev_ep="); emit(i32s(get32(rev_ep,0))); emit("\n");
  emit("SYN2 FROZEN correct="); emit(i32s(corr_f)); emit("/200\n");
  if(corr_v>corr_f){
    emit("CHECK PASS P2-revise-better\n");
  } else {
    emit("CHECK FAIL P2-revise-not-better\n"); fails=fails+1;
  }
  emit("FACTCOUNT_C "); emit(i32s(h_factcount(Wc)));
  emit(" FACTCOUNT_R "); emit(i32s(h_factcount(Wr)));
  emit(" FACTCOUNT_V "); emit(i32s(h_factcount(Wv)));
  emit(" FACTCOUNT_F "); emit(i32s(h_factcount(Wf))); emit("\n");
  if(fails==0){
    emit("SUBSTRATE-SYN ALL-PASS\n");
  } else {
    emit("SUBSTRATE-SYN FAILS=");
    emit(i32s(fails));
    emit("\n");
  }
  return fails;
}

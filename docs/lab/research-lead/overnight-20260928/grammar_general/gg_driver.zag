// gg_driver.zag -- grammar generalization experiment driver.
// Tests the FROZEN gi_induce mechanism on:
//   Test A: EXL2, a new formal system (ADD/SUB, licensors 46/47, lits 0..7)
//   Test B: Nested constraints (2-step licensors; expect induction failure)
//   Test C: Noisy examples (wrong licensor / missing licensor; expect failure)
// The induction mechanism (gg_patch_frozen.zag) is UNCHANGED. The driver
// teaches examples only; it never hardcodes the induced grammar.

fn gg_P(a:i32,b:i32)i32 { return a*16+b; }

// ============ EXL2 teaching ============
// EXL2: ADD=41, SUB=42, DADD=46, DSUB=47, BUILD=45, literals 0..7.

fn gg2_teach_eval(W:[]u8)void {
  let a:i32=0;
  while(a<=7){
    let b:i32=0;
    while(b<=7){
      let p:i32=gg_P(a,b);
      ev_teach_in(W,p,41,a+b);
      if(a>=b){ev_teach_in(W,p,42,a-b);}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gg2_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=14){
    let a:i32=0;
    while(a<=7){
      let b:i32=0;
      while(b<=7){
        if(a+b==t){ev_teach_in(W,t,46,gg_P(a,b));}
        if(a>=b && a-b==t){ev_teach_in(W,t,47,gg_P(a,b));}
        b=b+1;
      }
      a=a+1;
    }
    t=t+1;
  }
  return;
}

// Canonical BUILD for EXL2 train target. Uses DSUB (47) when the target
// is small enough, else DADD (46). Ensures both licensors appear.
fn gg2_canon_build(W:[]u8,t:i32)void {
  let done:i32=0;
  if(t<=7){
    let a:i32=7;
    while(a>=0 && done==0){
      let b:i32=0;
      while(b<=7 && done==0){
        if(a>=b && a-b==t){ev_teach_in(W,t,45,gg_P(a,b)); done=1;}
        b=b+1;
      }
      a=a-1;
    }
  }
  if(done==0){
    let a:i32=0;
    while(a<=7 && done==0){
      let b:i32=0;
      while(b<=7 && done==0){
        if(a+b==t){ev_teach_in(W,t,45,gg_P(a,b)); done=1;}
        b=b+1;
      }
      a=a+1;
    }
  }
  return;
}

fn gg2_teach_build(W:[]u8)void {
  gg2_canon_build(W,3);
  gg2_canon_build(W,4);
  gg2_canon_build(W,5);
  gg2_canon_build(W,10);
  gg2_canon_build(W,11);
  gg2_canon_build(W,12);
  return;
}

fn gg2_teach(W:[]u8)void {
  gg2_teach_eval(W);
  gg2_teach_decomp(W);
  gg2_teach_build(W);
  return;
}

// EXL2 classifier: 1=valid, 2=multi-dep, 3=wrong-relation, 4=range,
// 5=value-mismatch, 0=no MAP. Mirrors gi_classify but for 46/47 and 0..7.
fn gg2_classify(W:[]u8,t:i32)i32 {
  let m:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && ng(W,mm,0)==20 && ng(W,mm,8)==t && ng(W,mm,4)==45){m=mm;}
    mm=mm+1;
  }
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24); let oo:i32=ng(W,f,28);
  if(fr!=46 && fr!=47){return 3;}
  let a:i32=oo/16; let b:i32=oo-(a*16);
  if(a<0 || a>7 || b<0 || b>7){return 4;}
  let op:i32=41; if(fr==47){op=42;}
  if(gi_eval_known(W,oo,op,t)==0){return 5;}
  return 1;
}

fn gg2_test_targets(out:[]u8)i32 {
  set32(out,0,0); set32(out,4,1); set32(out,8,2); set32(out,12,6);
  set32(out,16,7); set32(out,20,8); set32(out,24,9); set32(out,28,13);
  set32(out,32,14);
  return 9;
}

// Test A INDUCE arm: frozen gi_induce + frozen gi_trial_build2 on EXL2.
fn gg2_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GG2-I-NOGRAMMAR\n"); return 0;}
  emit("GG2-GRAMMAR nlic="); e64(get32(gb,0));
  emit(" lic="); e64(get32(gb,4)); emit(",");
  e64(get32(gb,8)); emit(" a=["); e64(get32(gb,12));
  emit(","); e64(get32(gb,16)); emit("] b=[");
  e64(get32(gb,20)); emit(","); e64(get32(gb,24)); emit("]\n");
  let tg:[]u8=z_alloc(40); let n:i32=gg2_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gg2_classify(W,t);
    emit("GG2-I "); e64(t); emit(" ans="); e64(ans);
    emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GG2-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// Test A BASE arm: grammar-blind trial (for ABLATE and FRESH).
fn gg2_arm_base(W:[]u8)i32 {
  let tg:[]u8=z_alloc(40); let n:i32=gg2_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=gg2_classify(W,t);
    emit("GG2-B "); e64(t); emit(" ans="); e64(ans);
    emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GG2-B-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// ============ Test B: nested constraints ============
// BUILD examples with ONLY 2-step licensors. The frozen gi_induce looks
// for single facts (T,r2,P); none exist, so induction must fail.

fn ggB_teach(W:[]u8)void {
  // Teach eval/decomp for EXL so the world is coherent.
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=gg_P(a,b);
      if(a+b<64){ev_teach_in(W,p,41,a+b);}
      if(a*b<64){ev_teach_in(W,p,42,a*b);}
      b=b+1;
    }
    a=a+1;
  }
  // 2-step licensors only: (T,44,M) and (M,43,P), no (T,43,P)/(T,44,P).
  // T=16, P=(4,4)=68, M=(2,8)=40.
  ev_teach_in(W,16,45,68);
  ev_teach_in(W,16,44,40);
  ev_teach_in(W,40,43,68);
  // T=18, P=(3,6)=54, M=(2,9)=41.
  ev_teach_in(W,18,45,54);
  ev_teach_in(W,18,44,41);
  ev_teach_in(W,41,43,54);
  // T=20, P=(4,5)=69, M=(4,5)=69 via different path: (20,44,69)? No.
  // Use M=(2,10)=42: (20,44,42), (42,43,69).
  ev_teach_in(W,20,45,69);
  ev_teach_in(W,20,44,42);
  ev_teach_in(W,42,43,69);
  return;
}

// ============ Test C: noisy examples ============
// C1: 8 clean BUILD (licensors 43/44) + 2 noisy with licensor 46.
// C2: 8 clean BUILD + 2 noisy with NO licensor.

fn ggC_teach_clean(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=gg_P(a,b);
      if(a+b<64){ev_teach_in(W,p,41,a+b);}
      if(a*b<64){ev_teach_in(W,p,42,a*b);}
      b=b+1;
    }
    a=a+1;
  }
  // Decomp for targets 16..36 (mix of DADD/DMUL).
  let t:i32=16;
  while(t<=36){
    let aa:i32=0;
    while(aa<=9){
      let bb:i32=0;
      while(bb<=9){
        if(aa+bb==t){ev_teach_in(W,t,43,gg_P(aa,bb));}
        if(aa*bb==t){ev_teach_in(W,t,44,gg_P(aa,bb));}
        bb=bb+1;
      }
      aa=aa+1;
    }
    t=t+1;
  }
  // 8 clean BUILD examples.
  ev_teach_in(W,16,45,gg_P(7,9));
  ev_teach_in(W,18,45,gg_P(9,9));
  ev_teach_in(W,20,45,gg_P(4,5));
  ev_teach_in(W,21,45,gg_P(3,7));
  ev_teach_in(W,24,45,gg_P(4,6));
  ev_teach_in(W,25,45,gg_P(5,5));
  ev_teach_in(W,32,45,gg_P(4,8));
  ev_teach_in(W,36,45,gg_P(6,6));
  return;
}

fn ggC1_teach_noisy(W:[]u8)void {
  ggC_teach_clean(W);
  // 2 noisy: licensor relation 46 (not 43/44).
  ev_teach_in(W,28,46,gg_P(4,7));
  ev_teach_in(W,28,45,gg_P(4,7));
  ev_teach_in(W,30,46,gg_P(5,6));
  ev_teach_in(W,30,45,gg_P(5,6));
  return;
}

fn ggC2_teach_noisy(W:[]u8)void {
  ggC_teach_clean(W);
  // 2 noisy: BUILD with NO licensor fact at all.
  // P(1,1)=17: 1+1=2, 1*1=1, neither equals 28, so no (28,43/44,17).
  // P(2,2)=34: 2+2=4, 2*2=4, neither equals 30, so no (30,43/44,34).
  ev_teach_in(W,28,45,gg_P(1,1));
  ev_teach_in(W,30,45,gg_P(2,2));
  return;
}

fn main()i32 {
  emit("GG-START\n");
  // ---- Test A: EXL2 new formal system ----
  emit("GG-A-INDUCE\n");
  let WA1:[]u8=z_alloc(110656); tnn2_init(WA1);
  gg2_teach(WA1);
  let indA1:i32=gi_induce(WA1);
  emit("GG-A-INDUCED "); e64(indA1); emit("\n");
  let vA1:i32=0;
  if(indA1==1){vA1=gg2_arm_induce(WA1);}
  emit("GG-A-ABLATE\n");
  let WA2:[]u8=z_alloc(110656); tnn2_init(WA2);
  gg2_teach(WA2);
  let indA2:i32=gi_induce(WA2);
  emit("GG-A-INDUCED "); e64(indA2); emit("\n");
  let abA2:i32=gi_ablate(WA2);
  emit("GG-A-ABLATED "); e64(abA2); emit("\n");
  let vA2:i32=gg2_arm_base(WA2);
  emit("GG-A-FRESH\n");
  let WA3:[]u8=z_alloc(110656); tnn2_init(WA3);
  gg2_teach(WA3);
  let vA3:i32=gg2_arm_base(WA3);
  emit("GG-A-SUMMARY induce="); e64(vA1);
  emit(" ablate="); e64(vA2); emit(" fresh="); e64(vA3); emit("\n");
  // ---- Test B: nested constraints ----
  emit("GG-B-NESTED\n");
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  ggB_teach(WB);
  let indB:i32=gi_induce(WB);
  emit("GG-B-INDUCED "); e64(indB); emit(" (expect 0)\n");
  // ---- Test C1: wrong-licensor noise ----
  emit("GG-C1-NOISE-WRONGLIC\n");
  let WC1:[]u8=z_alloc(110656); tnn2_init(WC1);
  ggC1_teach_noisy(WC1);
  let indC1:i32=gi_induce(WC1);
  emit("GG-C1-INDUCED "); e64(indC1); emit(" (expect 0)\n");
  // ---- Test C2: missing-licensor noise ----
  emit("GG-C2-NOISE-MISSINGLIC\n");
  let WC2:[]u8=z_alloc(110656); tnn2_init(WC2);
  ggC2_teach_noisy(WC2);
  let indC2:i32=gi_induce(WC2);
  emit("GG-C2-INDUCED "); e64(indC2); emit(" (expect 0)\n");
  emit("GG-DONE\n");
  return 0;
}

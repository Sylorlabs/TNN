// sealed_items.zag - Sealed episode constructors for OpScope step-3 sealed evaluation.
// New code authored by the independent sealer. The world mechanics
// (rng, word table, gen_direct/gen_neg/gen_rel/gen_size, build_utt,
// world_recover_U, world_verify_U, world_T) are copied verbatim from the
// frozen world file opscope_rebuild/opscope_world.zag and are not modified.
//
// Vocabulary: 0=tak 1=not 2=red 3=blu 4=grn 5=bal 6=sph 7=cub 8=tri
//             9=big 10=biger 11=smal
// Sealed set S = {5=bal, 6=sph, 7=cub, 8=tri, 9=big, 10=biger, 11=smal}.
// All sealed items use ncolor=3, nshape=3 (same as the frozen novel tests).

// NEG constructor for shape words (bal/sph: sv=0; cub: sv=1; tri: sv=2).
// Target shape differs from sv; the two other objects carry shape sv.
// By world_T, the negated shape word is absent from the target mask.
fn gen_neg_shape(ep:[]u8, st:[]u8, sv:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  let ds:i32=rng_range(st,nshape-1);
  if(ds>=sv){ ds=ds+1; }
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,ds);
  set32(ep,(tgt*3+2)*4,rng_range(st,2));
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      set32(ep,(o*3+0)*4,rng_range(st,ncolor));
      set32(ep,(o*3+1)*4,sv);
      set32(ep,(o*3+2)*4,rng_range(st,2));
    }
    o=o+1;
  }
  return;
}

// NEG constructor for size words (big: zv=1; smal: zv=0).
// Target size is 1-zv; the two other objects carry size zv.
// By world_T, the negated size word is absent from the target mask.
fn gen_neg_size(ep:[]u8, st:[]u8, zv:i32, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,rng_range(st,nshape));
  set32(ep,(tgt*3+2)*4,1-zv);
  let o:i32=0;
  while(o<3){
    if(o!=tgt){
      set32(ep,(o*3+0)*4,rng_range(st,ncolor));
      set32(ep,(o*3+1)*4,rng_range(st,nshape));
      set32(ep,(o*3+2)*4,zv);
    }
    o=o+1;
  }
  return;
}

// NEG constructor for biger (wid 10). The target is the SMALL object
// (z=0) among big same-shape others, so the target does not satisfy biger
// (world_T requires z==1 plus a smaller same-shape other).
fn gen_neg_biger(ep:[]u8, st:[]u8, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  let s:i32=rng_range(st,nshape);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,s);
  set32(ep,(tgt*3+2)*4,0);
  let o1:i32=(tgt+1)%3;
  let o2:i32=(tgt+2)%3;
  set32(ep,(o1*3+0)*4,rng_range(st,ncolor));
  set32(ep,(o1*3+1)*4,s);
  set32(ep,(o1*3+2)*4,1);
  let ds:i32=rng_range(st,nshape-1);
  if(ds>=s){ ds=ds+1; }
  set32(ep,(o2*3+0)*4,rng_range(st,ncolor));
  set32(ep,(o2*3+1)*4,ds);
  set32(ep,(o2*3+2)*4,rng_range(st,2));
  return;
}

// Positive biger control ("tak biger"). The target is the BIG object (z=1)
// with a smaller same-shape other present, so the target satisfies biger.
fn gen_biger_pos(ep:[]u8, st:[]u8, ncolor:i32, nshape:i32)void {
  let tgt:i32=rng_range(st,3);
  set32(ep,40,tgt);
  let s:i32=rng_range(st,nshape);
  set32(ep,(tgt*3+0)*4,rng_range(st,ncolor));
  set32(ep,(tgt*3+1)*4,s);
  set32(ep,(tgt*3+2)*4,1);
  let o1:i32=(tgt+1)%3;
  let o2:i32=(tgt+2)%3;
  set32(ep,(o1*3+0)*4,rng_range(st,ncolor));
  set32(ep,(o1*3+1)*4,s);
  set32(ep,(o1*3+2)*4,0);
  let ds:i32=rng_range(st,nshape-1);
  if(ds>=s){ ds=ds+1; }
  set32(ep,(o2*3+0)*4,rng_range(st,ncolor));
  set32(ep,(o2*3+1)*4,ds);
  set32(ep,(o2*3+2)*4,rng_range(st,2));
  return;
}

// Sealed episodes 200-220 (21 items) into eps (21*64 bytes), in order:
// 14 NEG items (2 per word of S, wid order 5,6,7,8,9,10,11), then
// 7 affirmative controls (1 per word of S, wid order 5..11).
fn gen_sealed(eps:[]u8, st:[]u8)void {
  let ep:[]u8=z_alloc(64);
  let e:i32=0;
  // NEG spec table: (wid, kind, arg). kind 0=shape-neg, 1=size-neg, 2=biger-neg.
  let nw:[]u8=z_alloc(14*4);
  let nk:[]u8=z_alloc(14*4);
  let na:[]u8=z_alloc(14*4);
  set32(nw,0,5);   set32(nk,0,0);  set32(na,0,0);
  set32(nw,4,5);   set32(nk,4,0);  set32(na,4,0);
  set32(nw,8,6);   set32(nk,8,0);  set32(na,8,0);
  set32(nw,12,6);  set32(nk,12,0); set32(na,12,0);
  set32(nw,16,7);  set32(nk,16,0); set32(na,16,1);
  set32(nw,20,7);  set32(nk,20,0); set32(na,20,1);
  set32(nw,24,8);  set32(nk,24,0); set32(na,24,2);
  set32(nw,28,8);  set32(nk,28,0); set32(na,28,2);
  set32(nw,32,9);  set32(nk,32,1); set32(na,32,1);
  set32(nw,36,9);  set32(nk,36,1); set32(na,36,1);
  set32(nw,40,10); set32(nk,40,2); set32(na,40,0);
  set32(nw,44,10); set32(nk,44,2); set32(na,44,0);
  set32(nw,48,11); set32(nk,48,1); set32(na,48,0);
  set32(nw,52,11); set32(nk,52,1); set32(na,52,0);
  let i:i32=0;
  while(i<14){
    let w:i32=get32(nw,i*4);
    let kd:i32=get32(nk,i*4);
    let ag:i32=get32(na,i*4);
    let k:i32=0; while(k<64){ ep[k]=0; k=k+1; }
    if(kd==0){ gen_neg_shape(ep,st,ag,3,3); }
    else if(kd==1){ gen_neg_size(ep,st,ag,3,3); }
    else { gen_neg_biger(ep,st,3,3); }
    set32(ep,44,1);
    build_utt(ep,0,1,w,0,3);
    k=0; while(k<64){ eps[e*64+k]=ep[k]; k=k+1; }
    e=e+1; i=i+1;
  }
  // Controls: "tak X" with X's feature present on the target.
  let k2:i32=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_direct(ep,st,0,0,3,3);
  set32(ep,44,0);
  build_utt(ep,0,5,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_direct(ep,st,0,0,3,3);
  set32(ep,44,0);
  build_utt(ep,0,6,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_direct(ep,st,0,1,3,3);
  set32(ep,44,0);
  build_utt(ep,0,7,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_direct(ep,st,0,2,3,3);
  set32(ep,44,0);
  build_utt(ep,0,8,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_size(ep,st,1,0,3,3);
  set32(ep,44,3);
  build_utt(ep,0,9,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_biger_pos(ep,st,3,3);
  set32(ep,44,2);
  build_utt(ep,0,10,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  k2=0; while(k2<64){ ep[k2]=0; k2=k2+1; }
  gen_size(ep,st,0,0,3,3);
  set32(ep,44,3);
  build_utt(ep,0,11,0,0,2);
  k2=0; while(k2<64){ eps[e*64+k2]=ep[k2]; k2=k2+1; } e=e+1;
  return;
}

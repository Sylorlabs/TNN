
  // ---------- Sealed world (episodes 200-220) ----------
  let st2:[]u8=z_alloc(4);
  set32(st2,0,987654321);
  let seps:[]u8=z_alloc(21*64);
  gen_sealed(seps,st2);

  // ---------- Oracle units + targets (sealed 21) ----------
  let sallU:[]u8=z_alloc(21*16);
  let sallN:[]u8=z_alloc(21*4);
  let sallT:[]u8=z_alloc(21*4);
  let svrt:i32=1;
  let si:i32=0;
  while(si<21){
    let sep:[]u8=z_alloc(64);
    let sk:i32=0; while(sk<64){ sep[sk]=seps[si*64+sk]; sk=sk+1; }
    let sn:i32=world_recover_U(sep,U);
    if(world_verify_U(sep,U,sn)==0){ svrt=0; }
    let sm:i32=world_T(sep,U,sn);
    set32(sallN,si*4,sn);
    set32(sallT,si*4,sm);
    sk=0; while(sk<4){
      if(sk<sn){ set32(sallU,(si*4+sk)*4,get32(U,sk*4)); } else { set32(sallU,(si*4+sk)*4,-1); }
      sk=sk+1;
    }
    si=si+1;
  }
  emit("VERIFY_U_ROUNDTRIP_SEALED_21: "); emit(i32s(svrt)); emit("\n");

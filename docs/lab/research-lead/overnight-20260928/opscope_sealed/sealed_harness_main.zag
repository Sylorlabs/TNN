// opscope_harness.zag - Training/test harness and R4 falsifiers.
// EXCLUDED from the F3 source audit (harness). The learner file is audited.

fn dump_oprec(W:[]u8)void {
  emit("OPREC_TABLE:\n");
  let k:i32=0;
  while(k<8){
    let b:i32=5616+k*24;
    emit(" k="); emit(i32s(k));
    emit(" trig="); emit(i32s(get32(W,b)));
    emit(" scope="); emit(i32s(get32(W,b+4)));
    emit(" sig="); emit(i32s(get32(W,b+8)));
    emit(" sup="); emit(i32s(get32(W,b+12)));
    emit(" created="); emit(i32s(get32(W,b+16)));
    emit(" active="); emit(i32s(get32(W,b+20)));
    emit("\n");
    k=k+1;
  }
  return;
}

fn dump_diag(D:[]u8)void {
  emit("DIAG w epc reclen sup mtch div cs cb gate\n");
  let w:i32=0;
  while(w<12){
    let b:i32=w*32;
    let sup:i32=get32(D,b+8);
    if(sup>0){
      emit(" "); emit(i32s(w));
      emit(" "); emit(i32s(get32(D,b)));
      emit(" "); emit(i32s(get32(D,b+4)));
      emit(" "); emit(i32s(sup));
      emit(" "); emit(i32s(get32(D,b+12)));
      emit(" "); emit(i32s(get32(D,b+16)));
      emit(" "); emit(i32s(get32(D,b+20)));
      emit(" "); emit(i32s(get32(D,b+24)));
      emit(" "); emit(i32s(get32(D,b+28)));
      emit("\n");
    }
    w=w+1;
  }
  return;
}

fn main()i32 {
  // ---------- Frozen world ----------
  let st:[]u8=z_alloc(4);
  set32(st,0,123456789);
  let eps:[]u8=z_alloc(120*64);
  gen_episodes(eps,st);

  // ---------- Oracle units + targets ----------
  let allU:[]u8=z_alloc(120*16);
  let allN:[]u8=z_alloc(120*4);
  let allT:[]u8=z_alloc(120*4);
  let U:[]u8=z_alloc(16);
  let vrt:i32=1;
  let t:i32=0;
  while(t<120){
    let ep:[]u8=z_alloc(64);
    let k:i32=0; while(k<64){ ep[k]=eps[t*64+k]; k=k+1; }
    let n:i32=world_recover_U(ep,U);
    if(world_verify_U(ep,U,n)==0){ vrt=0; }
    let m:i32=world_T(ep,U,n);
    set32(allN,t*4,n);
    set32(allT,t*4,m);
    k=0; while(k<4){
      if(k<n){ set32(allU,(t*4+k)*4,get32(U,k*4)); } else { set32(allU,(t*4+k)*4,-1); }
      k=k+1;
    }
    t=t+1;
  }
  emit("VERIFY_U_ROUNDTRIP_120: "); emit(i32s(vrt)); emit("\n");
  emit("LEXICON: 0=tak 1=not 2=red 3=blu 4=grn 5=bal 6=sph 7=cub 8=tri 9=big 10=biger 11=smal\n");


  // ---------- Sealed world (episodes 200-220) ----------
  let st2:[]u8=z_alloc(4);
  set32(st2,0,987654321);
  let seps:[]u8=z_alloc(21*64);
  gen_sealed(seps,st2);

  // ---------- Oracle units + targets (sealed 21) ----------
  let sallU:[]u8=z_alloc(21*16);
  let sallN:[]u8=z_alloc(21*4);
  let sallT:[]u8=z_alloc(21*4);
  let svrt:i32=1;
  let si:i32=0;
  while(si<21){
    let sep:[]u8=z_alloc(64);
    let sk:i32=0; while(sk<64){ sep[sk]=seps[si*64+sk]; sk=sk+1; }
    let sn:i32=world_recover_U(sep,U);
    if(world_verify_U(sep,U,sn)==0){ svrt=0; }
    let sm:i32=world_T(sep,U,sn);
    set32(sallN,si*4,sn);
    set32(sallT,si*4,sm);
    sk=0; while(sk<4){
      if(sk<sn){ set32(sallU,(si*4+sk)*4,get32(U,sk*4)); } else { set32(sallU,(si*4+sk)*4,-1); }
      sk=sk+1;
    }
    si=si+1;
  }
  emit("VERIFY_U_ROUNDTRIP_SEALED_21: "); emit(i32s(svrt)); emit("\n");
  // ---------- Learner ----------
  let W:[]u8=z_alloc(8400);
  let z:i32=0; while(z<8400){ W[z]=0; z=z+1; }
  let TU:[]u8=z_alloc(16);
  let TS:[]u8=z_alloc(16);

  // ---------- Training: episodes 0..99, one-pass online ----------
  t=0;
  while(t<100){
    let n:i32=get32(allN,t*4);
    let T:i32=get32(allT,t*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(t*4+j)*4)); j=j+1; }
    learn_keep(W,TU,n,T,t);
    let p0:i32=baseline(W,TU,n);
    if(t>=20 && p0!=T){ learn_event(W,TU,n,T); }
    learn_update(W,TU,n,T);
    if((t+1)>=20 && ((t+1)%10)==0){
      let D:[]u8=z_alloc(384);
      diag_bars(W,t+1,TS,D);
      emit("CHECK seen="); emit(i32s(t+1)); emit("\n");
      dump_diag(D);
      let inst:i32=proposal_check(W,t+1,TS);
      retire_check(W,t+1,TS);
      emit(" installed_now="); emit(i32s(inst)); emit("\n");
    }
    t=t+1;
  }

  emit("TRAIN_DONE\n");
  dump_oprec(W);

  // ---------- Sealed scoring: episodes 200-220, no learning ----------
  let s1:i32=0;
  let s2:i32=0;
  let ei:i32=0;
  while(ei<21){
    let id:i32=200+ei;
    let en:i32=get32(sallN,ei*4);
    let eT:i32=get32(sallT,ei*4);
    let ej:i32=0; while(ej<en){ set32(TU,ej*4,get32(sallU,(ei*4+ej)*4)); ej=ej+1; }
    let ep_:i32=interpret(W,TU,en);
    let eok:i32=0;
    if(ep_==eT){ eok=1; }
    if(ei<14){ if(eok==1){ s1=s1+1; } } else { if(eok==1){ s2=s2+1; } }
    emit("SEALED ep="); emit(i32s(id));
    emit(" U=");
    ej=0; while(ej<en){ emit(i32s(get32(TU,ej*4))); emit(","); ej=ej+1; }
    emit(" pred="); emit(i32s(ep_));
    emit(" tgt="); emit(i32s(eT));
    emit(" ok="); emit(i32s(eok)); emit("\n");
    ei=ei+1;
  }
  emit("S1_SEALED_NEG: "); emit(i32s(s1)); emit("/14\n");
  emit("S2_CONTROLS: "); emit(i32s(s2)); emit("/7\n");

  // ---------- S3 white-box: active OPREC, trigger_form==1, DELETION, sup>=4 ----------
  let wb:i32=0;
  let wk:i32=0;
  while(wk<8){
    let wb_:i32=5616+wk*24;
    if(get32(W,wb_+20)==1 && get32(W,wb_)==1 && get32(W,wb_+8)==0 && get32(W,wb_+16)>0 && get32(W,wb_+12)>=4){
      wb=1;
    }
    wk=wk+1;
  }
  emit("S3_WHITEBOX: "); emit(i32s(wb)); emit("\n");

  let spass:i32=0;
  if(s1>=12 && s2==7 && wb==1){ spass=1; }
  if(spass==1){ emit("VERDICT: SEALED-PASS\n"); } else { emit("VERDICT: SEALED-FAIL\n"); }
  return 0;
}

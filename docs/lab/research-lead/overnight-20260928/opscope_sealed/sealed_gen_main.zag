// sealed_gen_main.zag - Sealed world dump program main (sealer-owned).
// Emits the 21 sealed episodes as hex plus per-episode oracle U/T for audit.
// Sealed seed is fixed here at execution time and disclosed in the result.

fn hexline(ep:[]u8, off:i32, out:[]u8)void {
  let k:i32=0;
  while(k<64){
    let b:i32=ep[off+k] as i32;
    let hi:i32=(b>>4)&15;
    let lo:i32=b&15;
    let hc:i32=48+hi;
    if(hi>9){ hc=87+hi; }
    let lc:i32=48+lo;
    if(lo>9){ lc=87+lo; }
    out[k*2]=hc as u8;
    out[k*2+1]=lc as u8;
    k=k+1;
  }
  return;
}

fn main()i32 {
  let st:[]u8=z_alloc(4);
  set32(st,0,987654321);
  let eps:[]u8=z_alloc(21*64);
  gen_sealed(eps,st);
  emit("SEALED_WORLD seed=987654321 n=21\n");
  let U:[]u8=z_alloc(16);
  let hx:[]u8=z_alloc(128);
  let e:i32=0;
  while(e<21){
    let ep:[]u8=z_alloc(64);
    let k:i32=0; while(k<64){ ep[k]=eps[e*64+k]; k=k+1; }
    let n:i32=world_recover_U(ep,U);
    let vrt:i32=world_verify_U(ep,U,n);
    let T:i32=world_T(ep,U,n);
    emit("EP id="); emit(i32s(200+e));
    emit(" n="); emit(i32s(n));
    emit(" U=");
    let j:i32=0;
    while(j<n){ emit(i32s(get32(U,j*4))); emit(","); j=j+1; }
    emit(" T="); emit(i32s(T));
    emit(" vrt="); emit(i32s(vrt)); emit("\n");
    hexline(eps,e*64,hx);
    _zag_print(hx);
    emit("\n");
    e=e+1;
  }
  return 0;
}

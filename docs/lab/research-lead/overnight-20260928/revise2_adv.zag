// revise2.zag — H-REVISE2: self-revising procedure discovery via versioned
// conditional dispatch.
//
// Architecture (differs from H-REVISE, commit c7bfaeba1):
//   H-REVISE tested one-shot batch search for a single P(k,n)->index, with
//   revision = re-search on augmented data. The impossibility proof shows no
//   single P(k,n)->index satisfies both training (P(k,3)=2) and the
//   counterexample (P(k,3)=0).
//   H-REVISE2 is a continuing learner:
//     Phase A: discover P0 from training (broadcast-last).
//     Phase B: monitor — P0 stays deployed; each new observation is checked.
//     Phase C: diagnose — on mismatch, find discriminating (pos,val) from data.
//     Phase D: revise — P0 PRESERVED; P1 discovered from counterexample
//              subset; versioned conditional stored:
//              IF input[pos]==val THEN P1 ELSE P0.
//              Revised artifact has signature (k,n,input)->index.
//     Phase E: verify versioned dispatch on all cases.
//     Phase F: unresolvable counterexample -> WITHHOLD, P0 intact.
//
// Prereg: PREREG_REVISE2.md (3f582bb46) + amendment 1 (66e84347d), frozen
// before this file.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (from unified_learn.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
// discover: enumerate 1055 programs, N-first two-pass (H-GENBIAS).
// seqs: nseq*12 bytes (sq, sl, sn); seq i32 data lives in S at sq.
// Returns nnodes or -1. Copies winning program bytes to out_prog.
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE ============
// VS layout: 0:vcount, 4:cond_pos, 8:cond_val, 12:nnodes0, 16:prog0[48],
//            64:nnodes1, 68:prog1[48]
fn vs_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 12, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[16+i]=p0[i]; i=i+1; }
  return;
}
fn vs_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)void {
  set32(VS, 0, 1);
  set32(VS, 4, cpos);
  set32(VS, 8, cval);
  set32(VS, 64, nn1);
  let i:i32=0;
  while(i<nn1*3){ VS[68+i]=p1[i]; i=i+1; }
  return;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  if(get32(VS, 0)==0){
    return vs_apply_one(VS, 16, 12, inp, out);
  }
  let cp:i32=get32(VS, 4);
  let cv:i32=get32(VS, 8);
  if(inp.len>cp && (inp[cp] as i32)==cv){
    return vs_apply_one(VS, 68, 64, inp, out);
  }
  return vs_apply_one(VS, 16, 12, inp, out);
}
fn vs_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,12);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[16+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  if(get32(VS,0)==1){
    emit("VSTORE cond pos="); emit(i32s(get32(VS,4)));
    emit(" val="); emit(i32s(get32(VS,8))); emit("\n");
    let nn1:i32=get32(VS,64);
    emit("VSTORE P1 nnodes="); emit(i32s(nn1)); emit(" prog=");
    let p1:[]u8=z_alloc(48);
    i=0;
    while(i<nn1*3){ p1[i]=VS[68+i]; i=i+1; }
    prog_emit(p1, nn1); emit("\n");
  }
  return;
}

// ============ DIAGNOSIS ============
// Find lowest position p where fail[p] differs from every passing input's
// byte at p. Values come from the data; no literals. Returns p*1000+v or -1.
fn diagnose(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8)i32 {
  let p:i32=0;
  while(p<fail.len){
    let ok:i32=1;
    let i:i32=0;
    while(i<npass){
      if(get32(pdesc, i*8+4)<=p){ ok=0; break; }
      i=i+1;
    }
    if(ok==1){
      let v:i32=fail[p] as i32;
      let discrim:i32=1;
      i=0;
      while(i<npass){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
        i=i+1;
      }
      if(discrim==1){ return p*1000+v; }
    }
    p=p+1;
  }
  return -1;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ ADVERSARY MAIN: X-RV1, X-RV2, X-RV3 ============
// Mechanism functions above are verbatim from revise2.zag. Only main()
// is replaced by the three preregistered attack scenarios
// (PREREG_REVISE2_ADV.md, frozen 1bbadf544).
fn main()i32 {
  emit("=== H-REVISE2 ADVERSARY: X-RV1 chained, X-RV2 gaming, X-RV3 spurious ===\n");
  let xsucc:i32=0;
  let xfail:i32=0;

  // ---- shared Phase A: learn P0 from standard training ----
  let in0:[]u8="abc"; let out0:[]u8="ccc";
  let in1:[]u8="def"; let out1:[]u8="fff";
  let in2:[]u8="ghi"; let out2:[]u8="iii";
  let in3:[]u8="jkl"; let out3:[]u8="lll";
  let S:[]u8=z_alloc(4096);
  let S_off:i32=0;
  let descA:[]u8=z_alloc(3*12);
  let sa0:i32=pextract(in0, out0, S[S_off..S_off+64]);
  if(sa0<0){ emit("FATAL setup extract\n"); return 1; }
  set32(descA, 0, S_off); set32(descA, 4, sa0); set32(descA, 8, in0.len);
  S_off=S_off+64;
  let sa1:i32=pextract(in1, out1, S[S_off..S_off+64]);
  if(sa1<0){ emit("FATAL setup extract\n"); return 1; }
  set32(descA, 12, S_off); set32(descA, 16, sa1); set32(descA, 20, in1.len);
  S_off=S_off+64;
  let sa2:i32=pextract(in2, out2, S[S_off..S_off+64]);
  if(sa2<0){ emit("FATAL setup extract\n"); return 1; }
  set32(descA, 24, S_off); set32(descA, 28, sa2); set32(descA, 32, in2.len);
  S_off=S_off+64;
  let p0:[]u8=z_alloc(48);
  let nn0:i32=discover(S, descA, 3, p0);
  if(nn0<0){ emit("FATAL setup discover P0\n"); return 1; }
  emit("SETUP P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  prog_emit(p0, nn0); emit("\n");

  // diagnosis passing set D1/pd1: abc, def, ghi, jkl
  let D1:[]u8=z_alloc(256);
  let pd1:[]u8=z_alloc(4*8);
  let o1:i32=0;
  set32(pd1, 0, o1); set32(pd1, 4, dcopy(D1, o1, in0)); o1=o1+in0.len;
  set32(pd1, 8, o1); set32(pd1, 12, dcopy(D1, o1, in1)); o1=o1+in1.len;
  set32(pd1, 16, o1); set32(pd1, 20, dcopy(D1, o1, in2)); o1=o1+in2.len;
  set32(pd1, 24, o1); set32(pd1, 28, dcopy(D1, o1, in3)); o1=o1+in3.len;

  let pred:[]u8=z_alloc(16);
  let t5:[]u8=z_alloc(16);

  // ================= X-RV1: chained revision =================
  emit("\n--- X-RV1: chained revision ---\n");
  let inX:[]u8="xab"; let outX:[]u8="xxx";
  let VS:[]u8=z_alloc(256);
  vs_init(VS, p0, nn0);
  // R1
  if(apply_prog(p0, nn0, inX, pred)==1 && streq(pred[0..3], outX)==1){
    emit("X-RV1 R1 UNEXPECTED MATCH (setup broken)\n");
  } else { emit("X-RV1 R1 DETECT xab->xxx\n"); }
  let dr1:i32=diagnose(D1, pd1, 4, inX);
  let dp1:i32=dr1/1000; let dv1:i32=dr1-dp1*1000;
  emit("X-RV1 R1 DIAGNOSE pos="); emit(i32s(dp1));
  emit(" val="); emit(i32s(dv1)); emit("\n");
  let descX1:[]u8=z_alloc(12);
  let sx1:i32=pextract(inX, outX, S[S_off..S_off+64]);
  if(sx1<0){ emit("FATAL R1 extract\n"); return 1; }
  set32(descX1, 0, S_off); set32(descX1, 4, sx1); set32(descX1, 8, inX.len);
  S_off=S_off+64;
  let pr1:[]u8=z_alloc(48);
  let nnr1:i32=discover(S, descX1, 1, pr1);
  if(nnr1<0){ emit("FATAL R1 discover\n"); return 1; }
  vs_revise(VS, dp1, dv1, pr1, nnr1);
  emit("X-RV1 R1 REVISED: IF input["); emit(i32s(dp1));
  emit("]=="); emit(i32s(dv1)); emit(" THEN P1 ELSE P0\n");
  if(vs_apply(VS, inX, t5)==1 && streq(t5[0..3], outX)==1){
    emit("X-RV1 R1 VERIFY xab->xxx PASS\n");
  } else { emit("X-RV1 R1 VERIFY xab->xxx FAIL (setup broken)\n"); }
  // R2: second counterexample, genuinely mismatching under R1 dispatch
  let inY:[]u8="yzb"; let outY:[]u8="yyy";
  if(vs_apply(VS, inY, t5)==1 && streq(t5[0..3], outY)==1){
    emit("X-RV1 R2 UNEXPECTED MATCH (setup broken)\n");
  } else { emit("X-RV1 R2 DETECT yzb->yyy\n"); }
  let dr2:i32=diagnose(D1, pd1, 4, inY);
  let dp2:i32=dr2/1000; let dv2:i32=dr2-dp2*1000;
  emit("X-RV1 R2 DIAGNOSE pos="); emit(i32s(dp2));
  emit(" val="); emit(i32s(dv2)); emit("\n");
  let descX2:[]u8=z_alloc(12);
  let sx2:i32=pextract(inY, outY, S[S_off..S_off+64]);
  if(sx2<0){ emit("FATAL R2 extract\n"); return 1; }
  set32(descX2, 0, S_off); set32(descX2, 4, sx2); set32(descX2, 8, inY.len);
  S_off=S_off+64;
  let pr2:[]u8=z_alloc(48);
  let nnr2:i32=discover(S, descX2, 1, pr2);
  if(nnr2<0){ emit("FATAL R2 discover\n"); return 1; }
  vs_revise(VS, dp2, dv2, pr2, nnr2);
  emit("X-RV1 R2 REVISED: IF input["); emit(i32s(dp2));
  emit("]=="); emit(i32s(dv2)); emit(" THEN P2 ELSE P0 (R1 slot overwritten)\n");
  vs_dump(VS);
  if(vs_apply(VS, inY, t5)==1 && streq(t5[0..3], outY)==1){
    emit("X-RV1 R2 case yzb->yyy PASS\n");
  } else { emit("X-RV1 R2 case yzb->yyy FAIL\n"); }
  // the kill test: does the R1 case still hold after R2?
  if(vs_apply(VS, inX, t5)==1 && streq(t5[0..3], outX)==1){
    emit("X-RV1 RESULT: R1 case survives chaining -> attack FAILS\n");
    xfail=xfail+1;
  } else {
    emit("X-RV1 RESULT: R1 case DESTROYED by R2 (now predicts ");
    emit(t5[0..3]); emit(") -> attack SUCCEEDS\n");
    xsucc=xsucc+1;
  }

  // ================= X-RV2: diagnosis gaming =================
  emit("\n--- X-RV2: diagnosis gaming (incidental-feature lock-in) ---\n");
  emit("hidden true rule: broadcast input[1] iff input contains 'q', else broadcast-last\n");
  let VS2:[]u8=z_alloc(256);
  vs_init(VS2, p0, nn0);
  let inQ:[]u8="xqc"; let outQ:[]u8="qqq";
  if(apply_prog(p0, nn0, inQ, pred)==1 && streq(pred[0..3], outQ)==1){
    emit("X-RV2 UNEXPECTED MATCH (setup broken)\n");
  } else { emit("X-RV2 DETECT xqc->qqq\n"); }
  let drq:i32=diagnose(D1, pd1, 4, inQ);
  let dpq:i32=drq/1000; let dvq:i32=drq-dpq*1000;
  emit("X-RV2 DIAGNOSE pos="); emit(i32s(dpq));
  emit(" val="); emit(i32s(dvq));
  emit(" (causally relevant feature is 'q'=113 at pos 1)\n");
  let descQ:[]u8=z_alloc(12);
  let sqq:i32=pextract(inQ, outQ, S[S_off..S_off+64]);
  if(sqq<0){ emit("FATAL Q extract\n"); return 1; }
  set32(descQ, 0, S_off); set32(descQ, 4, sqq); set32(descQ, 8, inQ.len);
  S_off=S_off+64;
  let pqq:[]u8=z_alloc(48);
  let nnqq:i32=discover(S, descQ, 1, pqq);
  if(nnqq<0){ emit("FATAL Q discover\n"); return 1; }
  vs_revise(VS2, dpq, dvq, pqq, nnqq);
  emit("X-RV2 REVISED P1="); prog_emit(pqq, nnqq); emit("\n");
  let inH1:[]u8="xbc"; let outH1:[]u8="ccc";
  let inH2:[]u8="aqc"; let outH2:[]u8="qqq";
  let hfail:i32=0;
  if(vs_apply(VS2, inH1, t5)==1 && streq(t5[0..3], outH1)==1){
    emit("X-RV2 H1 xbc->ccc PASS\n");
  } else {
    emit("X-RV2 H1 xbc->ccc FAIL (predicted "); emit(t5[0..3]); emit(")\n");
    hfail=hfail+1;
  }
  if(vs_apply(VS2, inH2, t5)==1 && streq(t5[0..3], outH2)==1){
    emit("X-RV2 H2 aqc->qqq PASS\n");
  } else {
    emit("X-RV2 H2 aqc->qqq FAIL (predicted "); emit(t5[0..3]); emit(")\n");
    hfail=hfail+1;
  }
  if(hfail>0){
    emit("X-RV2 RESULT: held-out misgeneralizes -> attack SUCCEEDS\n");
    xsucc=xsucc+1;
  } else {
    emit("X-RV2 RESULT: held-out generalizes -> attack FAILS\n");
    xfail=xfail+1;
  }

  // ================= X-RV3: spurious UNRESOLVABLE =================
  emit("\n--- X-RV3: spurious UNRESOLVABLE (mixed-length passing set) ---\n");
  let inDE:[]u8="de"; let outDE:[]u8="ee";
  if(apply_prog(p0, nn0, inDE, pred)==1 && streq(pred[0..2], outDE)==1){
    emit("X-RV3 sanity: de->ee passes under P0\n");
  } else { emit("X-RV3 sanity: de->ee FAILS under P0 (setup broken)\n"); }
  let D3:[]u8=z_alloc(256);
  let pd3:[]u8=z_alloc(4*8);
  let o3:i32=0;
  set32(pd3, 0, o3); set32(pd3, 4, dcopy(D3, o3, in0)); o3=o3+in0.len;
  set32(pd3, 8, o3); set32(pd3, 12, dcopy(D3, o3, inDE)); o3=o3+inDE.len;
  set32(pd3, 16, o3); set32(pd3, 20, dcopy(D3, o3, in2)); o3=o3+in2.len;
  set32(pd3, 24, o3); set32(pd3, 28, dcopy(D3, o3, in3)); o3=o3+in3.len;
  let inM:[]u8="abx"; let outM:[]u8="aaa";
  if(apply_prog(p0, nn0, inM, pred)==1 && streq(pred[0..3], outM)==1){
    emit("X-RV3 UNEXPECTED MATCH (setup broken)\n");
  } else { emit("X-RV3 DETECT abx->aaa\n"); }
  let drm:i32=diagnose(D3, pd3, 4, inM);
  if(drm<0){
    emit("X-RV3 diagnose returned -1 -> mechanism emits UNRESOLVABLE\n");
    // reference: bounds-respecting complete diagnosis
    let found3:i32=0;
    let fp:i32=0;
    while(fp<inM.len){
      let vv:i32=inM[fp] as i32;
      let dd:i32=1;
      let jj:i32=0;
      while(jj<4){
        let oo:i32=get32(pd3, jj*8);
        let ll:i32=get32(pd3, jj*8+4);
        if(ll>fp && (D3[oo+fp] as i32)==vv){ dd=0; break; }
        jj=jj+1;
      }
      if(dd==1){
        found3=1;
        emit("X-RV3 reference diagnosis finds (pos=");
        emit(i32s(fp)); emit(" val="); emit(i32s(vv)); emit(")\n");
        break;
      }
      fp=fp+1;
    }
    if(found3==1){
      emit("X-RV3 RESULT: UNRESOLVABLE was SPURIOUS -> attack SUCCEEDS\n");
      xsucc=xsucc+1;
    } else {
      emit("X-RV3 RESULT: truly unresolvable -> attack FAILS\n");
      xfail=xfail+1;
    }
  } else {
    emit("X-RV3 diagnose found ("); emit(i32s(drm/1000));
    emit(","); emit(i32s(drm-drm/1000*1000)); emit(") -> attack FAILS\n");
    xfail=xfail+1;
  }

  emit("\n=== ADVERSARY RESULT: ");
  emit(i32s(xsucc)); emit(" attacks SUCCEEDED, ");
  emit(i32s(xfail)); emit(" attacks FAILED ===\n");
  return 0;
}

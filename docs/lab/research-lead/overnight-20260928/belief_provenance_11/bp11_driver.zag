// bp11_driver.zag -- BP-11 battery driver.
//
// Arms: PROP (R6 coupling without shared facts), ROUTE (block
// bid-routing theft via shared (s,r), no shared fact), NULL
// (no-interaction boundaries). Kill bars from the frozen PREREG.md.
// Verdict BP-11-PASS/FAIL. Pure Zag.
// bp11_learner.zag is BP-10's belief layer reused verbatim. Zero new
// learner machinery this lane: bp11_absorb (the BP-10 absorb renamed,
// identical body), bp11_ck, bp11_bar, bp11_selfcnt, bp11_liclive are
// driver-side test-harness code, NOT belief-layer changes. The forgery
// actions (link_edge writes of type-7/type-3 edges) and the
// driver-written type-14 edges in PROP are adversary/test-setup actions
// in the driver, NOT belief-layer changes. Direct driver calls to frozen
// learner functions (bp2_disconfirm, bp2_confirm, bp2_retire, bp2_form,
// bp2_propagate, bp2_kill_one_prov, bp2_relicense, bp2_select, bp2_eff,
// bp2_lic_live) are disclosed test actions invoking frozen operators;
// they add no rules. R2/R3/R5/R6/R7, eff(), bp2_retire, bp2_relicense
// stay frozen.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp11_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp11_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp11_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp11_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption: identical body to
// bp10_absorb. Count NEW type-7/type-3 self-edges on
// fact fid since watermarks (p7,p3); each new type-7
// applies R2, each new type-3 applies R3, to belief
// mid. out[0]=new7, out[4]=new3.
fn bp11_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp11_selfcnt(W,fid,7)-p7;
  let n3:i32=bp11_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// Live tag-1 type-1 licensing target count of mid.
fn bp11_liclive(W:[]u8,mid:i32)i32 {
  let out:[]u8=z_alloc(12);
  bp2_lic_live(W,mid,out);
  return get32(out,0);
}

fn main()i32 {
  emit("BP11-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= PROP: R6 coupling without shared facts =================
  emit("PROP-BEGIN\n");
  let WP:[]u8=z_alloc(110656);
  tnn2_init(WP);
  let f1:i32=ev_teach(WP,931,91,10); ns(WP,f1,16,2);
  let pf1:[]u8=z_alloc(4); set32(pf1,0,f1);
  let m1:i32=promote_graph(WP,-1,931,91,10,pf1,1);
  let f2:i32=ev_teach(WP,932,92,20); ns(WP,f2,16,2);
  let pf2:[]u8=z_alloc(4); set32(pf2,0,f2);
  let m2:i32=promote_graph(WP,-1,932,92,20,pf2,1);
  let f3:i32=ev_teach(WP,933,93,30); ns(WP,f3,16,2);
  let pf3:[]u8=z_alloc(4); set32(pf3,0,f3);
  let m3:i32=promote_graph(WP,-1,933,93,30,pf3,1);
  let z1:i32=alloc_node(WP);
  let btP:[]u8=z_alloc(8192); let hbP:[]u8=z_alloc(1024);
  bp2_form(WP,btP,hbP,m1,0);
  bp2_form(WP,btP,hbP,m2,0);
  bp2_form(WP,btP,hbP,m3,0);
  bp2_form(WP,btP,hbP,z1,1);
  let we1:i32=link_edge(WP,z1,14,m1,0);
  let we2:i32=link_edge(WP,z1,14,m2,0);
  emit("PROP z1 "); e64(z1); emit(" m1 "); e64(m1);
  emit(" m2 "); e64(m2); emit(" m3 "); e64(m3); emit("\n");
  bp11_bar(t,"PC-PROP-FORM",
    (btP[z1*8] as i32)==100 &&
    (btP[m1*8] as i32)==100 && (btP[m1*8+1] as i32)==1 &&
    (btP[m1*8+4] as i32)==1 && (btP[m1*8+7] as i32)==1 &&
    (btP[m2*8] as i32)==100 && (btP[m2*8+1] as i32)==1 &&
    (btP[m2*8+4] as i32)==1 && (btP[m2*8+7] as i32)==1 &&
    (btP[m3*8] as i32)==100 && (btP[m3*8+1] as i32)==1 &&
    (btP[m3*8+4] as i32)==1 && (btP[m3*8+7] as i32)==1 &&
    (hbP[z1] as i32)==1 && (hbP[m1] as i32)==1 &&
    (hbP[m2] as i32)==1 && (hbP[m3] as i32)==1);
  // P1: weaken m2, propagate to z1 (coupling without shared facts)
  bp2_disconfirm(btP,m2);
  bp2_disconfirm(btP,m2);
  bp2_disconfirm(btP,m2);
  let rp1:i32=bp2_propagate(WP,btP,hbP,z1);
  emit("PROP-P1 rp "); e64(rp1);
  emit(" z1sup "); e64(btP[z1*8] as i32); emit("\n");
  bp11_bar(t,"K-PROP-COUPLE",rp1==40 &&
    (btP[z1*8] as i32)==40 && (btP[z1*8+1] as i32)==1 &&
    (btP[z1*8+2] as i32)==0 && (btP[z1*8+3] as i32)==0 &&
    bp2_has_k3(WP,z1)==0);
  // P2: targets untouched by the composite's propagation (asymmetry)
  bp11_bar(t,"K-PROP-ASYM",
    (btP[m1*8] as i32)==100 && (btP[m1*8+1] as i32)==1 &&
    (btP[m1*8+2] as i32)==0 && (btP[m1*8+3] as i32)==0 &&
    (btP[m2*8] as i32)==40 && (btP[m2*8+1] as i32)==0 &&
    (btP[m2*8+2] as i32)==3 && (btP[m2*8+3] as i32)==0);
  // P3: raise the unlinked m3, re-propagate (scope = type-14 adjacency)
  bp2_confirm(btP,m3,1);
  bp2_confirm(btP,m3,1);
  let rp2:i32=bp2_propagate(WP,btP,hbP,z1);
  emit("PROP-P3 rp "); e64(rp2);
  emit(" z1sup "); e64(btP[z1*8] as i32);
  emit(" m3sup "); e64(btP[m3*8] as i32); emit("\n");
  bp11_bar(t,"K-PROP-SCOPE",rp2==40 &&
    (btP[z1*8] as i32)==40 &&
    (btP[m3*8] as i32)==140 && (btP[m3*8+1] as i32)==3);
  // P4: propagate m1 (no type-14 out-edges): direction is fixed
  let rp3:i32=bp2_propagate(WP,btP,hbP,m1);
  emit("PROP-P4 rp "); e64(rp3); emit("\n");
  bp11_bar(t,"K-PROP-NOBACK",rp3==255 &&
    (btP[m1*8] as i32)==100 && (btP[m1*8+1] as i32)==1 &&
    (btP[m1*8+2] as i32)==0 && (btP[m1*8+3] as i32)==0);
  // P5: raise m2 back, propagate tracks the min upward
  bp2_confirm(btP,m2,1);
  bp2_confirm(btP,m2,1);
  bp2_confirm(btP,m2,1);
  let rp4:i32=bp2_propagate(WP,btP,hbP,z1);
  emit("PROP-P5 rp "); e64(rp4);
  emit(" z1sup "); e64(btP[z1*8] as i32); emit("\n");
  bp11_bar(t,"K-PROP-TRACK",rp4==100 &&
    (btP[z1*8] as i32)==100 &&
    (btP[m2*8] as i32)==100 && (btP[m2*8+1] as i32)==3 &&
    (btP[m2*8+2] as i32)==0);
  emit("PROP-END\n");

  // ================= ROUTE: bid-routing theft, no shared fact =================
  emit("ROUTE-BEGIN\n");
  let WR:[]u8=z_alloc(110656);
  tnn2_init(WR);
  let fA:i32=ev_teach(WR,921,91,10); ns(WR,fA,16,2);
  let pfA:[]u8=z_alloc(4); set32(pfA,0,fA);
  let mA:i32=promote_graph(WR,-1,921,91,10,pfA,1);
  let fB:i32=ev_teach(WR,921,91,20); ns(WR,fB,16,2);
  let pfB:[]u8=z_alloc(4); set32(pfB,0,fB);
  let mB:i32=promote_graph(WR,-1,921,91,20,pfB,1);
  let fC:i32=ev_teach(WR,941,91,10); ns(WR,fC,16,2);
  let pfC:[]u8=z_alloc(4); set32(pfC,0,fC);
  let mC:i32=promote_graph(WR,-1,941,91,10,pfC,1);
  let btR:[]u8=z_alloc(8192); let hbR:[]u8=z_alloc(1024);
  bp2_form(WR,btR,hbR,mA,0);
  bp2_form(WR,btR,hbR,mB,0);
  bp2_form(WR,btR,hbR,mC,0);
  emit("ROUTE mA "); e64(mA); emit(" mB "); e64(mB);
  emit(" mC "); e64(mC); emit("\n");
  bp11_bar(t,"PC-ROUTE-FORM",
    (btR[mA*8] as i32)==100 && (btR[mA*8+1] as i32)==1 &&
    (btR[mA*8+4] as i32)==1 && (btR[mA*8+7] as i32)==1 &&
    (btR[mB*8] as i32)==100 && (btR[mB*8+1] as i32)==1 &&
    (btR[mB*8+4] as i32)==1 && (btR[mB*8+7] as i32)==1 &&
    (btR[mC*8] as i32)==100 && (btR[mC*8+1] as i32)==1 &&
    (btR[mC*8+4] as i32)==1 && (btR[mC*8+7] as i32)==1 &&
    (hbR[mA] as i32)==1 && (hbR[mB] as i32)==1 &&
    (hbR[mC] as i32)==1);
  // R1: inflate fB's bid with forged matches, then a genuine
  // observation matching mA's fact value
  let wg1:i32=link_edge(WR,fB,7,fB,0);
  let wg2:i32=link_edge(WR,fB,7,fB,0);
  let wg3:i32=link_edge(WR,fB,7,fB,0);
  let abB1:[]u8=z_alloc(8);
  bp11_absorb(WR,btR,mB,fB,0,0,abB1);
  let rc:i32=ev_observe(WR,921,91,10);
  let abA:[]u8=z_alloc(8);
  bp11_absorb(WR,btR,mA,fA,0,0,abA);
  let abB2:[]u8=z_alloc(8);
  bp11_absorb(WR,btR,mB,fB,3,0,abB2);
  emit("ROUTE-R1 rc "); e64(rc);
  emit(" n7A "); e64(get32(abA,0)); emit(" n3A "); e64(get32(abA,4));
  emit(" supA "); e64(btR[mA*8] as i32);
  emit(" n3B "); e64(get32(abB2,4));
  emit(" supB "); e64(btR[mB*8] as i32); emit("\n");
  bp11_bar(t,"K-ROUTE-THEFT",rc==0 &&
    get32(abA,0)==0 && get32(abA,4)==0 &&
    (btR[mA*8] as i32)==100 && (btR[mA*8+1] as i32)==1 &&
    (btR[mA*8+2] as i32)==0 &&
    bp11_selfcnt(WR,fA,7)==0 && bp11_selfcnt(WR,fA,3)==0 &&
    get32(abB2,0)==0 && get32(abB2,4)==1 &&
    (btR[mB*8] as i32)==90 && (btR[mB*8+1] as i32)==0 &&
    (btR[mB*8+2] as i32)==1);
  // R2: control world, mA2 alone: the observation reaches its fact
  let WR2:[]u8=z_alloc(110656);
  tnn2_init(WR2);
  let fA2:i32=ev_teach(WR2,921,91,10); ns(WR2,fA2,16,2);
  let pfA2:[]u8=z_alloc(4); set32(pfA2,0,fA2);
  let mA2:i32=promote_graph(WR2,-1,921,91,10,pfA2,1);
  let btR2:[]u8=z_alloc(8192); let hbR2:[]u8=z_alloc(1024);
  bp2_form(WR2,btR2,hbR2,mA2,0);
  let rc2:i32=ev_observe(WR2,921,91,10);
  let abA2:[]u8=z_alloc(8);
  bp11_absorb(WR2,btR2,mA2,fA2,0,0,abA2);
  emit("ROUTE-R2 rc "); e64(rc2);
  emit(" n7 "); e64(get32(abA2,0));
  emit(" sup "); e64(btR2[mA2*8] as i32); emit("\n");
  bp11_bar(t,"K-ROUTE-CONTROL",rc2==1 && get32(abA2,0)==1 &&
    (btR2[mA2*8] as i32)==110 && (btR2[mA2*8+1] as i32)==2 &&
    (btR2[mA2*8+2] as i32)==0);
  // R3: disjoint (s,r) in the same world: routing isolation
  let rc3:i32=ev_observe(WR,941,91,10);
  let abC:[]u8=z_alloc(8);
  bp11_absorb(WR,btR,mC,fC,0,0,abC);
  emit("ROUTE-R3 rc "); e64(rc3);
  emit(" supC "); e64(btR[mC*8] as i32); emit("\n");
  bp11_bar(t,"K-ROUTE-BOUND",rc3==1 &&
    (btR[mC*8] as i32)==110 && (btR[mC*8+1] as i32)==2 &&
    (btR[mA*8] as i32)==100 && (btR[mB*8] as i32)==90);
  emit("ROUTE-END\n");

  // ================= NULL: no-interaction boundaries =================
  emit("NULL-BEGIN\n");
  let WN:[]u8=z_alloc(110656);
  tnn2_init(WN);
  let fD:i32=ev_teach(WN,951,91,10); ns(WN,fD,16,2);
  let pfD:[]u8=z_alloc(4); set32(pfD,0,fD);
  let mD:i32=promote_graph(WN,-1,951,91,10,pfD,1);
  let fE:i32=ev_teach(WN,952,92,20); ns(WN,fE,16,2);
  let pfE:[]u8=z_alloc(4); set32(pfE,0,fE);
  let mE:i32=promote_graph(WN,-1,952,92,20,pfE,1);
  let fF:i32=ev_teach(WN,961,91,10); ns(WN,fF,16,2);
  let pfF:[]u8=z_alloc(4); set32(pfF,0,fF);
  let mF:i32=promote_graph(WN,-1,961,91,10,pfF,1);
  let fG:i32=ev_teach(WN,962,92,20); ns(WN,fG,16,2);
  let pfG:[]u8=z_alloc(4); set32(pfG,0,fG);
  let mG:i32=promote_graph(WN,-1,962,92,20,pfG,1);
  let btN:[]u8=z_alloc(8192); let hbN:[]u8=z_alloc(1024);
  bp2_form(WN,btN,hbN,mD,0);
  bp2_form(WN,btN,hbN,mE,0);
  bp2_form(WN,btN,hbN,mF,0);
  bp2_form(WN,btN,hbN,mG,0);
  emit("NULL mD "); e64(mD); emit(" mE "); e64(mE);
  emit(" mF "); e64(mF); emit(" mG "); e64(mG); emit("\n");
  bp11_bar(t,"PC-NULL-FORM",
    (btN[mD*8] as i32)==100 && (btN[mD*8+1] as i32)==1 &&
    (btN[mD*8+4] as i32)==1 && (btN[mD*8+7] as i32)==1 &&
    (btN[mE*8] as i32)==100 && (btN[mE*8+1] as i32)==1 &&
    (btN[mE*8+4] as i32)==1 && (btN[mE*8+7] as i32)==1 &&
    (btN[mF*8] as i32)==100 && (btN[mF*8+1] as i32)==1 &&
    (btN[mF*8+4] as i32)==1 && (btN[mF*8+7] as i32)==1 &&
    (btN[mG*8] as i32)==100 && (btN[mG*8+1] as i32)==1 &&
    (btN[mG*8+4] as i32)==1 && (btN[mG*8+7] as i32)==1);
  // N1: forged contradicts on mE's fact, forged match on mD's fact
  let wn1:i32=link_edge(WN,fE,3,fE,0);
  let wn2:i32=link_edge(WN,fE,3,fE,0);
  let wn3:i32=link_edge(WN,fE,3,fE,0);
  let wn4:i32=link_edge(WN,fD,7,fD,0);
  let abD:[]u8=z_alloc(8);
  bp11_absorb(WN,btN,mD,fD,0,0,abD);
  let abE:[]u8=z_alloc(8);
  bp11_absorb(WN,btN,mE,fE,0,0,abE);
  emit("NULL-N1 n7D "); e64(get32(abD,0));
  emit(" supD "); e64(btN[mD*8] as i32);
  emit(" n3E "); e64(get32(abE,4));
  emit(" supE "); e64(btN[mE*8] as i32); emit("\n");
  bp11_bar(t,"K-NULL-CONFIRM",
    get32(abD,0)==1 && (btN[mD*8] as i32)==110 &&
    (btN[mD*8+1] as i32)==2 &&
    get32(abE,4)==3 && (btN[mE*8] as i32)==80 &&
    (btN[mE*8+2] as i32)==1 && (btN[mE*8+1] as i32)==0);
  // N2: retire mE; mD keeps learning; selection picks mD
  bp2_retire(WN,btN,mE,2);
  let rcD:i32=ev_observe(WN,951,91,10);
  let abD2:[]u8=z_alloc(8);
  bp11_absorb(WN,btN,mD,fD,1,0,abD2);
  let csel:[]u8=z_alloc(8); set32(csel,0,mD); set32(csel,4,mE);
  let sel1:i32=bp2_select(btN,hbN,csel,2,50);
  emit("NULL-N2 rc "); e64(rcD); emit(" sel "); e64(sel1);
  emit(" supD "); e64(btN[mD*8] as i32); emit("\n");
  bp11_bar(t,"K-NULL-RETIRE",rcD==1 &&
    (btN[mD*8] as i32)==120 && (btN[mD*8+1] as i32)==3 &&
    bp2_has_k3r(WN,mE,2)==1 && (btN[mE*8] as i32)==0 &&
    sel1==mD);
  // N3: kill mE's provenance; mD's licensing counts untouched
  let kf:i32=bp2_kill_one_prov(WN,mE);
  let lvD:i32=bp11_liclive(WN,mD);
  bp2_relicense(WN,btN,mE);
  emit("NULL-N3 killed "); e64(kf); emit(" fE "); e64(fE);
  emit(" liveD "); e64(lvD); emit("\n");
  bp11_bar(t,"K-NULL-PROVKILL",kf==fE && lvD==1 &&
    (btN[mD*8+4] as i32)==1 && (btN[mD*8] as i32)==120 &&
    bp2_has_k3r(WN,mE,2)==1);
  // N4: selection couples outcomes, not records
  let csel2:[]u8=z_alloc(8); set32(csel2,0,mF); set32(csel2,4,mG);
  let selA:i32=bp2_select(btN,hbN,csel2,2,50);
  bp2_confirm(btN,mG,1);
  let selB:i32=bp2_select(btN,hbN,csel2,2,50);
  emit("NULL-N4 selA "); e64(selA); emit(" selB "); e64(selB); emit("\n");
  bp11_bar(t,"K-NULL-SELECT",selA==-3 && selB==mG &&
    (btN[mF*8] as i32)==100 && (btN[mF*8+1] as i32)==1 &&
    bp2_eff(btN,mF)==100);
  emit("NULL-END\n");

  emit("BP11-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP11-END\n");
  return 0;
}

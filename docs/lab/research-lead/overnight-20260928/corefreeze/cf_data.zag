// ---- goals: count, then (len, len ints) per goal ----
// ints: gtag nneeds (needtag nf fields..)* nlinks (7 ints)*link
fn d_goals()[]u8 {
  let T:[]u8=z_alloc(8192);
  let c:i32=0;
  c=appn(T,c,"24")
  // 0 G7001 W1 : 1 need 901 [11,111]
  c=appn(T,c," 7 7001 1 901 2 11 111 0")
  // 1 G7002 W1 : diamond; conj chain (kind2) + count fan-in (kind3)
  c=appn(T,c," 35 7002 3 901 2 11 111 902 7 2 0 12 121 0 13 131 903 3 11 1 0 2 2 1 0 0 0 0 0 3 2 0 0 0 0 0")
  // 2 G7003 W1 : multi-source kind-3 fan-in (two sources into one COUNT)
  c=appn(T,c," 30 7003 3 901 2 12 121 901 2 12 121 903 3 13 1 0 2 3 2 0 0 0 0 0 3 2 0 0 1 0 0")
  // 3 G7004 W1 : self-walk carrier + fan-out verify (oscillates, lag 2)
  c=appn(T,c," 31 7004 3 901 2 11 111 901 2 14 200 902 4 1 0 15 200 2 1 1 0 1 1 1 0 2 2 0 0 0 0 0")
  // 4 G7004c W1 : convergent control, 2 needs
  c=appn(T,c," 20 7004 2 901 2 20 220 902 4 1 0 15 109 1 2 1 0 0 0 0 0")
  // 5 G7001u W1 : uncovered relation, generic fallback
  c=appn(T,c," 7 7001 1 901 2 13 131 0")
  // 6 G7003w W1 : G7003 shape on W1 relations
  c=appn(T,c," 30 7003 3 901 2 11 111 901 2 12 121 903 3 13 1 0 2 3 2 0 0 0 0 0 3 2 0 0 1 0 0")
  // 7 G9999 W1 : unbindable need shape (decline probe)
  c=appn(T,c," 10 9999 1 904 5 5 1 1 1 1 0")
  // 8..12 W2 BETA
  c=appn(T,c," 7 7001 1 901 2 9001 9101 0")
  c=appn(T,c," 7 7001 1 901 2 9005 9501 0")
  c=appn(T,c," 35 7002 3 901 2 9001 9101 902 7 2 0 9002 9201 0 9004 9401 903 3 9001 1 0 2 2 1 0 0 0 0 0 3 2 0 0 0 0 0")
  c=appn(T,c," 30 7003 3 901 2 9002 9201 901 2 9003 9301 903 3 9004 1 0 2 3 2 0 0 0 0 0 3 2 0 0 1 0 0")
  c=appn(T,c," 31 7004 3 901 2 9001 9101 901 2 9003 9301 902 4 1 0 9004 9401 2 1 1 0 1 1 1 0 2 2 0 0 1 0 0")
  // 13..17 W3 GAMMA
  c=appn(T,c," 7 7001 1 901 2 5001 2 0")
  c=appn(T,c," 7 7001 1 901 2 6003 8101 0")
  c=appn(T,c," 35 7002 3 901 2 5001 3 902 7 2 0 5002 0 0 5003 1 903 3 5001 1 0 2 1 0 0 1 0 1 0 2 1 0 0 0 0 0")
  c=appn(T,c," 30 7003 3 901 2 6001 7101 901 2 6001 7201 903 3 6002 1 0 2 3 2 0 0 0 0 0 3 2 0 0 1 0 0")
  c=appn(T,c," 20 7004 2 901 2 5001 3 902 4 1 0 5002 0 1 1 0 0 1 0 1 0")
  // 18..20 curriculum TA TB TC
  c=appn(T,c," 7 7001 1 901 2 31 3001 0")

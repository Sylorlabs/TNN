  c=appn(T,c," 12 6 0 -1 58 0 -1 -1 0 0 -1 10 20")
  c=appn(T,c," 15 6 1 21 59 0 2 -1 2 1 -1 10 20 1 4001 2")
  c=appn(T,c," 12 6 0 -1 60 0 -1 -1 0 0 -1 11 20")
  c=appn(T,c," 15 6 1 21 61 0 2 -1 2 1 -1 11 20 1 4001 2")
  c=appn(T,c," 15 6 1 21 62 0 2 -1 2 1 -1 11 20 1 4001 2")
  c=appn(T,c," 15 6 1 21 63 0 2 -1 2 1 -1 11 20 1 4001 2")
  c=appn(T,c," 15 6 1 21 64 0 2 -1 2 1 -1 11 20 1 4001 2")
  c=appn(T,c," 12 6 0 -1 65 0 -1 -1 0 0 -1 12 20")
  c=appn(T,c," 15 6 1 21 66 0 2 -1 2 1 -1 12 20 1 4001 2")
  c=appn(T,c," 16 7 1 21 67 0 2 -1 3 1 -1 12 20 2 4001 4002 2")
  c=appn(T,c," 12 6 0 -1 68 0 -1 -1 0 0 -1 13 20")
  c=appn(T,c," 15 6 1 21 69 0 2 -1 2 1 -1 13 20 1 4001 2")
  c=appn(T,c," 12 7 0 -1 70 0 -1 -1 0 0 -1 13 20")
  c=appn(T,c," 15 7 1 21 71 0 2 -1 2 1 -1 13 20 1 4009 2")
  c=appn(T,c," 12 6 0 -1 72 0 -1 -1 0 0 -1 14 20")
  c=appn(T,c," 15 6 1 21 66 0 2 -1 2 1 -1 14 20 1 4001 2")
  c=appn(T,c," 14 8 1 22 73 0 2 -1 1 1 -1 14 20 0 2")
  c=appn(T,c," 12 6 0 -1 74 0 -1 -1 0 0 -1 15 20")
  c=appn(T,c," 15 6 1 21 66 0 2 -1 2 1 -1 15 20 1 4001 2")
  c=appn(T,c," 12 8 0 -1 75 0 -1 -1 0 0 -1 15 20")
  c=appn(T,c," 14 8 1 22 76 0 2 -1 1 1 -1 15 20 0 2")
  // ===== segments 16..18 developmental =====
  c=appn(T,c," 12 9 0 -1 77 0 -1 -1 0 0 -1 16 30")
  c=appn(T,c," 20 9 1 23 78 0 2 -1 5 3 -1 16 30 1 6001 0 1 1 2 1 4")
  c=appn(T,c," 12 9 0 -1 79 0 -1 -1 0 0 -1 17 30")
  c=appn(T,c," 20 9 1 23 80 2 2 -1 5 3 -1 17 30 1 6001 0 1 1 0 1 4")
  c=appn(T,c," 20 9 1 23 81 0 2 -1 5 3 -1 18 30 1 6001 0 1 1 0 1 4")
  return T;
}

// ---- generic builders ----
fn bld(S:[]u8,TA:[]u8,stride:i32)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(TA,0,n);
  let i:i32=0;
  let c:i32=1;
  while(c==1){
    if(i>=n){ c=0; }
    if(c==1){
      let k:i32=0;
      while(k<stride){
        set32(TA,4+(i*stride+k)*4,nx(S,pos));
        k=k+1;
      }
      i=i+1;
    }
  }
  return;
}
fn bld_goals(S:[]u8,GA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(GA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
// self-delimiting case rows: count, then (len, len ints) per case.
// offsets written to OF: OF[0]=n, OF[4+i*4]=first int index of row i,
// OF[4+n*4]=total ints.
fn bld_cases(S:[]u8,TA:[]u8,OF:[]u8)void {
  let pos:[]u8=z_alloc(16);
  set32(pos,0,0);
  let n:i32=nx(S,pos);
  set32(OF,0,n);
  let cur:i32=0;
  let i:i32=0;
  while(i<n){
    set32(OF,4+i*4,cur);
    let len:i32=nx(S,pos);
    let k:i32=0;
    while(k<len){
      set32(TA,cur*4,nx(S,pos));
      cur=cur+1;
      k=k+1;
    }
    i=i+1;
  }
  set32(OF,4+n*4,cur);
  return;
}
// label slot stride 64 bytes: [len (i32 at +0), chars packed from +4].
// The char block MUST start at +4: starting it at +1 overlaps the length
// field's bytes 1..3 and silently corrupts it (found by isolation, see
// RESULTS.md). Cap 59 so slot 84 cannot reach the count cell at 8192.
// total count written at LB[8192]
fn bld_labels(S:[]u8,LB:[]u8)void {
  let p:i32=0;
  let i:i32=0;
  let go:i32=1;
  while(go==1){
    if(p>=S.len){ go=0; }
    if(go==1){
      let st:i32=p;
      let g:i32=1;
      while(g==1){
        if(p>=S.len){ g=0; }
        if(g==1){
          if(S[p]==94){ g=0; } else { p=p+1; }
        }
      }
      let ln:i32=p-st;
      if(ln>59){ ln=59; }
      set32(LB,i*64,ln);
      let k:i32=0;
      while(k<ln){
        LB[i*64+4+k]=S[st+k];
        k=k+1;
      }
      if(p<S.len){ p=p+1; }
      i=i+1;
    }
  }
  set32(LB,8192,i);
  return;
}
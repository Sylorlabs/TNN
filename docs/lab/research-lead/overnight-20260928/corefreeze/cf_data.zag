// cf_data.zag -- DATA ONLY for the CORE-FREEZE battery.
//
// Contains no cognition and no dispatch:
//   * nx          : generic whitespace-separated i32 scanner
//   * data strings: EVERY world identifier, relation identifier, goal
//                   tag, need tag and expected value lives here
//   * bld / bld_goals / bld_labels : generic table builders
//
// cf_engine.zag contains none of these literals. The frozen cognition
// files contain none either. That separation is the experiment.
//
// SOURCES (all from PREREG.md sections 3 and 4):
//   facts/eps/goals : PREREG 3, transcribed verbatim.
//   expected values : PREREG 3 and 4, transcribed verbatim INCLUDING the
//                     internal inconsistencies analysed in RESULTS.md
//                     (G7003@W2 answer; G7003@W3 answer and versions;
//                     G7004@W2 answer). They are NOT corrected here.
//   case/segment rows : PREREG 4 batteries CF1..CF3 and B2..B5.
// Two PREREG prose counts disagree with the listed data (W2 "9 facts"
// vs 10 listed; W3 "16 facts" vs 15 listed). The listed triples are
// used, since every expected answer is stated against them.

fn nx(S:[]u8,pos:[]u8)i32 {
  let p:i32=get32(pos,0);
  let g:i32=1;
  while(g==1){
    if(p>=S.len){ g=0; }
    if(g==1){
      if(S[p]==32){ p=p+1; } else { g=0; }
    }
  }
  let v:i32=0;
  let sg:i32=0;
  let g2:i32=1;
  while(g2==1){
    if(p>=S.len){ g2=0; }
    if(g2==1){
      let c:i32=S[p] as i32;
      if(c==32){ p=p+1; g2=0; }
      else{
        if(c==45){ sg=1; }
        else{ v=v*10+(c-48); }
        p=p+1;
      }
    }
  }
  set32(pos,0,p);
  if(sg==1){ v=0-v; }
  return v;
}
fn appn(T:[]u8,c:i32,s:[]u8)i32 { return o_app(T,c,s); }


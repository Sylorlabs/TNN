// bp7_driver.zag -- BP-7 battery driver.
//
// Arms: DSELF (d_self long trajectories, frozen R3-prime),
// META (bar meta-parameter sensitivity, driver-side
// parameterized rule), PBAR (per-belief bars, driver-side
// experimental selection). Kill bars from the frozen
// PREREG.md. Verdict BP-7-PASS/FAIL. Pure Zag.
// bp7_learner.zag is BP-6's belief layer reused verbatim;
// bp4_rules.zag (frozen FP4 R3-prime) reused verbatim.
// Zero new learner machinery this lane: bp7_bar_param and
// the per-belief bars are driver-side experimental code,
// NOT belief-layer changes; R7 and bp2_bar_after stay
// frozen.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp7_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp7_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp7_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// Count type-t self-edges on node n.
fn bp7_selfcnt(W:[]u8,n:i32,t:i32)i32 {
  let c:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==n && eg(W,e,4)==t && eg(W,e,8)==n){c=c+1;}
    e=e+1;
  }
  return c;
}

// Emergent evidence absorption (BP-5/BP-6 convention,
// indep=0): count NEW type-7/type-3 self-edges on fact
// fid since watermarks (p7,p3); each new type-7 applies
// R2, each new type-3 applies R3, to belief mid.
// out[0]=new7, out[4]=new3.
fn bp7_absorb(W:[]u8,bt:[]u8,mid:i32,fid:i32,p7:i32,p3:i32,out:[]u8)void {
  let n7:i32=bp7_selfcnt(W,fid,7)-p7;
  let n3:i32=bp7_selfcnt(W,fid,3)-p3;
  if(n7>0){bp2_confirm(bt,mid,0);}
  if(n3>0){bp2_disconfirm(bt,mid);}
  set32(out,0,n7); set32(out,4,n3);
  return;
}

// Parameterized bar rule (driver-side EXPERIMENTAL code;
// NOT a belief-layer change). bp2_bar_after is exactly
// this with (inc=1, dec=1, thr_num=2, thr_den=1,
// minbar=10).
fn bp7_bar_param(bar:i32,confirmed:i32,eff:i32,inc:i32,dec:i32,tn:i32,td:i32,minbar:i32)i32 {
  if(confirmed==1){return bar+inc;}
  if(eff*td>=bar*tn){
    let nb:i32=bar-dec;
    if(nb<minbar){nb=minbar;}
    return nb;
  }
  return bar;
}

// Per-belief-bar selection (driver-side EXPERIMENTAL
// code; NOT a belief-layer change). Candidate m is
// admitted iff eff >= its own bar pb[m]; argmax eff;
// exact tie at the top returns -3.
fn bp7_select_pbar(bt:[]u8,hasb:[]u8,cands:[]u8,nc:i32,pb:[]u8)i32 {
  let best:i32=-3; let beff:i32=-1; let tie:i32=0;
  let i:i32=0;
  while(i<nc){
    let m:i32=get32(cands,i*4);
    if((hasb[m] as i32)==1){
      let e:i32=bp2_eff(bt,m);
      let b:i32=get32(pb,m*4);
      if(e>=b){
        if(e>beff){beff=e; best=m; tie=0;}
        else{if(e==beff){tie=1;}}
      }
    }
    i=i+1;
  }
  if(best==-3){return -3;}
  if(tie==1){return -3;}
  return best;
}

// Kill the first live tag-1 type-1 provenance target of
// mid whose field16 is a self tag (3/4/6). Returns the
// fact id, or -1. Test-harness code.
fn bp7_kill_self_prov(W:[]u8,mid:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==mid && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){
        let st:i32=ng(W,f,16);
        if(st==3 || st==4 || st==6){
          ns(W,f,0,0); ns(W,f,36,0);
          return f;
        }
      }
    }
    e=e+1;
  }
  return -1;
}

// One META-arm event: select at each setting's bar,
// take the world outcome on fact fid, absorb, update
// all six bars. out[0]=allmA (ANDed), out[4]=cf,
// out[8]=eff_at_commit, out[12]=observe ret.
fn bp7_event(W:[]u8,bt:[]u8,hasb:[]u8,mA:i32,mB:i32,fid:i32,k1:i32,k2:i32,k3:i32,bars:[]u8,incs:[]u8,decs:[]u8,tns:[]u8,tds:[]u8,out:[]u8)void {
  let allmA:i32=get32(out,0);
  let si:i32=0;
  while(si<6){
    let cands:[]u8=z_alloc(8);
    set32(cands,0,mA); set32(cands,4,mB);
    let sel:i32=bp2_select(bt,hasb,cands,2,get32(bars,si*4));
    if(sel!=mA){allmA=0;}
    si=si+1;
  }
  let effc:i32=bp2_eff(bt,mA);
  let p7:i32=bp7_selfcnt(W,fid,7);
  let p3:i32=bp7_selfcnt(W,fid,3);
  let rr:i32=ev_observe(W,k1,k2,k3);
  let ab:[]u8=z_alloc(8);
  bp7_absorb(W,bt,mA,fid,p7,p3,ab);
  let cf:i32=0;
  if(get32(ab,4)>0){cf=1;}
  let sj:i32=0;
  while(sj<6){
    set32(bars,sj*4,bp7_bar_param(get32(bars,sj*4),cf,effc,get32(incs,sj*4),get32(decs,sj*4),get32(tns,sj*4),get32(tds,sj*4),10));
    sj=sj+1;
  }
  set32(out,0,allmA); set32(out,4,cf); set32(out,8,effc); set32(out,12,rr);
  return;
}

// One PBAR-arm false-positive commitment on mA.
// out[0]=eff_at_commit, out[4]=cf, out[8]=observe ret.
fn bp7_fp(W:[]u8,bt:[]u8,mid:i32,fid:i32,k1:i32,k2:i32,k3:i32,out:[]u8)void {
  let effc:i32=bp2_eff(bt,mid);
  let p7:i32=bp7_selfcnt(W,fid,7);
  let p3:i32=bp7_selfcnt(W,fid,3);
  let rr:i32=ev_observe(W,k1,k2,k3);
  let ab:[]u8=z_alloc(8);
  bp7_absorb(W,bt,mid,fid,p7,p3,ab);
  let cf:i32=0;
  if(get32(ab,4)>0){cf=1;}
  set32(out,0,effc); set32(out,4,cf); set32(out,8,rr);
  return;
}

fn main()i32 {
  emit("BP7-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // ================= DSELF: d_self long trajectory =================
  emit("DSELF-BEGIN\n");
  let WD:[]u8=z_alloc(110656);
  tnn2_init(WD);
  let f1:i32=ev_teach(WD,901,91,10); ns(WD,f1,16,3);
  let f2:i32=ev_teach(WD,902,92,20); ns(WD,f2,16,4);
  let f3:i32=ev_teach(WD,903,93,30); ns(WD,f3,16,6);
  let f4:i32=ev_teach(WD,904,94,40); ns(WD,f4,16,2);
  let pf:[]u8=z_alloc(16);
  set32(pf,0,f1); set32(pf,4,f2); set32(pf,8,f3); set32(pf,12,f4);
  let m:i32=promote_graph(WD,-1,901,91,10,pf,4);
  let g1:i32=ev_teach(WD,911,95,11); ns(WD,g1,16,1);
  let g2:i32=ev_teach(WD,912,96,21); ns(WD,g2,16,2);
  let g3:i32=ev_teach(WD,913,97,31); ns(WD,g3,16,5);
  let g4:i32=ev_teach(WD,914,98,41); ns(WD,g4,16,3);
  let pg:[]u8=z_alloc(16);
  set32(pg,0,g1); set32(pg,4,g2); set32(pg,8,g3); set32(pg,12,g4);
  let m2:i32=promote_graph(WD,-1,911,95,11,pg,4);
  let h1:i32=ev_teach(WD,921,99,12); ns(WD,h1,16,1);
  let h2:i32=ev_teach(WD,922,100,22); ns(WD,h2,16,2);
  let h3:i32=ev_teach(WD,923,101,32); ns(WD,h3,16,3);
  let h4:i32=ev_teach(WD,924,102,42); ns(WD,h4,16,4);
  let ph:[]u8=z_alloc(16);
  set32(ph,0,h1); set32(ph,4,h2); set32(ph,8,h3); set32(ph,12,h4);
  let m3:i32=promote_graph(WD,-1,921,99,12,ph,4);
  let j1:i32=ev_teach(WD,931,103,13); ns(WD,j1,16,3);
  let j2:i32=ev_teach(WD,932,104,23); ns(WD,j2,16,4);
  let j3:i32=ev_teach(WD,933,105,33); ns(WD,j3,16,6);
  let j4:i32=ev_teach(WD,934,106,43); ns(WD,j4,16,2);
  let pj:[]u8=z_alloc(16);
  set32(pj,0,j1); set32(pj,4,j2); set32(pj,8,j3); set32(pj,12,j4);
  let m4:i32=promote_graph(WD,-1,931,103,13,pj,4);
  let btD:[]u8=z_alloc(8192); let hbD:[]u8=z_alloc(1024);
  bp2_form(WD,btD,hbD,m,0);
  bp2_form(WD,btD,hbD,m2,0);
  bp2_form(WD,btD,hbD,m3,0);
  bp2_form(WD,btD,hbD,m4,0);
  emit("DSELF m "); e64(m); emit(" m2 "); e64(m2);
  emit(" m3 "); e64(m3); emit(" m4 "); e64(m4); emit("\n");
  bp7_bar(t,"PC-DS-FORM",
    (btD[m*8] as i32)==100 && (btD[m*8+4] as i32)==1 && (btD[m*8+5] as i32)==3 && (btD[m*8+6] as i32)==255 &&
    (btD[m2*8+4] as i32)==3 && (btD[m2*8+5] as i32)==1 &&
    (btD[m3*8+4] as i32)==2 && (btD[m3*8+5] as i32)==2 &&
    (btD[m4*8+4] as i32)==1 && (btD[m4*8+5] as i32)==3);
  let k:i32=0;
  while(k<10){
    bp4_disconf_learn(btD,m);
    k=k+1;
  }
  emit("DS-10 d "); e64(btD[m*8+6] as i32);
  emit(" sup "); e64(btD[m*8] as i32);
  emit(" disc "); e64(btD[m*8+2] as i32); emit("\n");
  bp7_bar(t,"K-DS-TRJ",(btD[m*8+6] as i32)==5 && (btD[m*8] as i32)==0 && (btD[m*8+2] as i32)==10 && (btD[m*8+1] as i32)==0);
  bp4_disconf_learn(btD,m);
  emit("DS-11 d "); e64(btD[m*8+6] as i32); emit("\n");
  bp7_bar(t,"K-DS-FLOOR",(btD[m*8+6] as i32)==0);
  bp2_confirm(btD,m,0);
  bp2_confirm(btD,m,0);
  bp2_confirm(btD,m,0);
  emit("DS-REC d "); e64(btD[m*8+6] as i32);
  emit(" sup "); e64(btD[m*8] as i32);
  emit(" eff "); e64(bp2_eff(btD,m)); emit("\n");
  bp7_bar(t,"K-DS-NOREC",(btD[m*8+6] as i32)==0 && (btD[m*8] as i32)==30 && (btD[m*8+1] as i32)==3);
  bp7_bar(t,"K-DS-EFF",bp2_eff(btD,m)==7);
  k=0;
  while(k<5){
    bp4_disconf_learn(btD,m2);
    k=k+1;
  }
  emit("DS-M2 d "); e64(btD[m2*8+6] as i32);
  emit(" sup "); e64(btD[m2*8] as i32); emit("\n");
  bp7_bar(t,"K-DS-SEL",(btD[m2*8+6] as i32)==255 && (btD[m2*8] as i32)==0 && (btD[m2*8+2] as i32)==5);
  k=0;
  while(k<2){
    bp4_disconf_learn(btD,m3);
    k=k+1;
  }
  bp7_bar(t,"K-DS-BOUND",(btD[m3*8+6] as i32)==255 && (btD[m3*8] as i32)==60);
  let kf1:i32=bp7_kill_self_prov(WD,m4);
  let kf2:i32=bp7_kill_self_prov(WD,m4);
  bp2_relicense(WD,btD,m4);
  emit("DS-M4 killed "); e64(kf1); emit("/"); e64(kf2);
  emit(" sup "); e64(btD[m4*8] as i32);
  emit(" ext "); e64(btD[m4*8+4] as i32);
  emit(" self "); e64(btD[m4*8+5] as i32); emit("\n");
  k=0;
  while(k<2){
    bp4_disconf_learn(btD,m4);
    k=k+1;
  }
  bp7_bar(t,"K-DS-FLIP",(btD[m4*8+6] as i32)==255 && (btD[m4*8] as i32)==10 && (btD[m4*8+4] as i32)==1 && (btD[m4*8+5] as i32)==1);
  emit("DSELF-END\n");

  // ================= META: meta-parameter sweep =================
  emit("META-BEGIN\n");
  let WM:[]u8=z_alloc(110656);
  tnn2_init(WM);
  let fa1:i32=ev_teach(WM,701,71,10); ns(WM,fa1,16,2);
  let fa2:i32=ev_teach(WM,702,72,20); ns(WM,fa2,16,6);
  let fa3:i32=ev_teach(WM,703,73,30); ns(WM,fa3,16,2);
  let fa4:i32=ev_teach(WM,704,74,40); ns(WM,fa4,16,6);
  let pfa:[]u8=z_alloc(16);
  set32(pfa,0,fa1); set32(pfa,4,fa2); set32(pfa,8,fa3); set32(pfa,12,fa4);
  let mA:i32=promote_graph(WM,-1,701,71,10,pfa,4);
  let mB:i32=alloc_node(WM);
  let btM:[]u8=z_alloc(8192); let hbM:[]u8=z_alloc(1024);
  bp2_form(WM,btM,hbM,mA,0);
  bp2_form(WM,btM,hbM,mB,1);
  bp2_disconfirm(btM,mB);
  bp2_disconfirm(btM,mB);
  emit("META mA "); e64(mA); emit(" mB "); e64(mB); emit("\n");
  bp7_bar(t,"PC-MT-FORM",(btM[mA*8] as i32)==100 && (btM[mA*8+4] as i32)==2 && (btM[mA*8+5] as i32)==2 && (btM[mB*8] as i32)==60);
  bp7_bar(t,"K-MT-U1",bp7_bar_param(50,1,100,1,1,2,1,10)==51);
  bp7_bar(t,"K-MT-U2",bp7_bar_param(51,0,80,1,1,3,2,10)==50);
  bp7_bar(t,"K-MT-U3",bp7_bar_param(10,0,25,1,1,2,1,10)==10);
  bp7_bar(t,"K-MT-U4",bp7_bar_param(50,1,100,0,1,2,1,10)==50);
  let bars:[]u8=z_alloc(24);
  let incs:[]u8=z_alloc(24);
  let decs:[]u8=z_alloc(24);
  let tns:[]u8=z_alloc(24);
  let tds:[]u8=z_alloc(24);
  let si0:i32=0;
  while(si0<6){
    set32(bars,si0*4,50);
    si0=si0+1;
  }
  set32(incs,0,1); set32(incs,4,3); set32(incs,8,1); set32(incs,12,1); set32(incs,16,0); set32(incs,20,1);
  set32(decs,0,1); set32(decs,4,1); set32(decs,8,3); set32(decs,12,1); set32(decs,16,1); set32(decs,20,0);
  set32(tns,0,2); set32(tns,4,2); set32(tns,8,2); set32(tns,12,3); set32(tns,16,2); set32(tns,20,2);
  set32(tds,0,1); set32(tds,4,1); set32(tds,8,1); set32(tds,12,2); set32(tds,16,1); set32(tds,20,1);
  let eo:[]u8=z_alloc(16);
  set32(eo,0,1);
  bp7_event(WM,btM,hbM,mA,mB,fa2,702,72,999,bars,incs,decs,tns,tds,eo);
  let s3e1:i32=get32(bars,8);
  let s5e1:i32=get32(bars,16);
  emit("MT-E1 cf "); e64(get32(eo,4)); emit(" effc "); e64(get32(eo,8));
  emit(" bars "); e64(get32(bars,0)); emit("/"); e64(get32(bars,4)); emit("/");
  e64(get32(bars,8)); emit("/"); e64(get32(bars,12)); emit("/");
  e64(get32(bars,16)); emit("/"); e64(get32(bars,20)); emit("\n");
  bp7_event(WM,btM,hbM,mA,mB,fa1,701,71,10,bars,incs,decs,tns,tds,eo);
  emit("MT-E2 cf "); e64(get32(eo,4)); emit(" effc "); e64(get32(eo,8));
  emit(" bars "); e64(get32(bars,0)); emit("/"); e64(get32(bars,4)); emit("/");
  e64(get32(bars,8)); emit("/"); e64(get32(bars,12)); emit("/");
  e64(get32(bars,16)); emit("/"); e64(get32(bars,20)); emit("\n");
  bp7_event(WM,btM,hbM,mA,mB,fa3,703,73,30,bars,incs,decs,tns,tds,eo);
  bp7_event(WM,btM,hbM,mA,mB,fa4,704,74,40,bars,incs,decs,tns,tds,eo);
  bp7_event(WM,btM,hbM,mA,mB,fa1,701,71,10,bars,incs,decs,tns,tds,eo);
  emit("MT-E5 bars "); e64(get32(bars,0)); emit("/"); e64(get32(bars,4)); emit("/");
  e64(get32(bars,8)); emit("/"); e64(get32(bars,12)); emit("/");
  e64(get32(bars,16)); emit("/"); e64(get32(bars,20));
  emit(" sup "); e64(btM[mA*8] as i32); emit("\n");
  bp7_bar(t,"K-MT-S1",get32(bars,0)==50);
  bp7_bar(t,"K-MT-S2",get32(bars,4)==52);
  bp7_bar(t,"K-MT-S3",get32(bars,8)==48);
  bp7_bar(t,"K-MT-S4",get32(bars,12)==47);
  bp7_bar(t,"K-MT-S5",get32(bars,16)==48);
  bp7_bar(t,"K-MT-S6",get32(bars,20)==51);
  bp7_bar(t,"K-MT-S3E1",s3e1==51);
  bp7_bar(t,"K-MT-S5E1",s5e1==50);
  bp7_bar(t,"K-MT-SEL",get32(eo,0)==1);
  emit("META-END\n");

  // ================= PBAR: per-belief bars =================
  emit("PBAR-BEGIN\n");
  let WP:[]u8=z_alloc(110656);
  tnn2_init(WP);
  let ga1:i32=ev_teach(WP,801,81,10); ns(WP,ga1,16,2);
  let ga2:i32=ev_teach(WP,802,82,20); ns(WP,ga2,16,6);
  let ga3:i32=ev_teach(WP,804,84,25); ns(WP,ga3,16,2);
  let pga:[]u8=z_alloc(12);
  set32(pga,0,ga1); set32(pga,4,ga2); set32(pga,8,ga3);
  let mAp:i32=promote_graph(WP,-1,801,81,10,pga,3);
  let mBp:i32=alloc_node(WP);
  let mXp:i32=alloc_node(WP);
  let go1:i32=ev_teach(WP,805,85,30); ns(WP,go1,16,2);
  let pgo:[]u8=z_alloc(4);
  set32(pgo,0,go1);
  let mOp:i32=promote_graph(WP,-1,805,85,30,pgo,1);
  let btP:[]u8=z_alloc(8192); let hbP:[]u8=z_alloc(1024);
  bp2_form(WP,btP,hbP,mAp,0);
  bp2_form(WP,btP,hbP,mBp,1); bp2_revise(btP,mBp);
  bp2_form(WP,btP,hbP,mXp,1); bp2_revise(btP,mXp);
  bp2_form(WP,btP,hbP,mOp,0);
  emit("PBAR mA "); e64(mAp); emit(" mB "); e64(mBp);
  emit(" mX "); e64(mXp); emit(" mO "); e64(mOp); emit("\n");
  bp7_bar(t,"PC-PB-FORM",
    (btP[mAp*8] as i32)==100 && (btP[mAp*8+4] as i32)==2 && (btP[mAp*8+5] as i32)==1 &&
    (btP[mBp*8] as i32)==50 && (btP[mXp*8] as i32)==50 && (btP[mOp*8] as i32)==100);
  let gbar:i32=50;
  let pb:[]u8=z_alloc(4096);
  let pi:i32=0;
  while(pi<1024){
    set32(pb,pi*4,50);
    pi=pi+1;
  }
  let fo:[]u8=z_alloc(12);
  bp7_fp(WP,btP,mAp,ga1,801,81,999,fo);
  gbar=bp2_bar_after(gbar,get32(fo,4),get32(fo,0));
  set32(pb,mAp*4,bp7_bar_param(get32(pb,mAp*4),get32(fo,4),get32(fo,0),1,1,2,1,10));
  emit("PB-FP1 gbar "); e64(gbar);
  emit(" pbA "); e64(get32(pb,mAp*4));
  emit(" pbB "); e64(get32(pb,mBp*4));
  emit(" supA "); e64(btP[mAp*8] as i32); emit("\n");
  let cB:[]u8=z_alloc(4);
  set32(cB,0,mBp);
  bp7_bar(t,"K-PB-ISO",gbar==51 && bp2_select(btP,hbP,cB,1,gbar)==-3 && bp7_select_pbar(btP,hbP,cB,1,pb)==mBp);
  bp7_fp(WP,btP,mAp,ga2,802,82,999,fo);
  gbar=bp2_bar_after(gbar,get32(fo,4),get32(fo,0));
  set32(pb,mAp*4,bp7_bar_param(get32(pb,mAp*4),get32(fo,4),get32(fo,0),1,1,2,1,10));
  bp7_fp(WP,btP,mAp,ga3,804,84,999,fo);
  gbar=bp2_bar_after(gbar,get32(fo,4),get32(fo,0));
  set32(pb,mAp*4,bp7_bar_param(get32(pb,mAp*4),get32(fo,4),get32(fo,0),1,1,2,1,10));
  emit("PB-FP3 gbar "); e64(gbar);
  emit(" pbA "); e64(get32(pb,mAp*4));
  emit(" supA "); e64(btP[mAp*8] as i32); emit("\n");
  let cAB:[]u8=z_alloc(8);
  set32(cAB,0,mAp); set32(cAB,4,mBp);
  bp7_bar(t,"K-PB-AVAIL",gbar==53 && bp2_select(btP,hbP,cAB,2,gbar)==-3 && bp7_select_pbar(btP,hbP,cAB,2,pb)==mBp);
  set32(pb,mXp*4,bp7_bar_param(get32(pb,mXp*4),1,100,1,1,2,1,10));
  let cX:[]u8=z_alloc(4);
  set32(cX,0,mXp);
  bp7_bar(t,"K-PB-TEETH",get32(pb,mXp*4)==51 && bp7_select_pbar(btP,hbP,cX,1,pb)==-3);
  let kk:i32=0;
  let streakOK:i32=1;
  while(kk<40){
    let cO:[]u8=z_alloc(4);
    set32(cO,0,mOp);
    let selo:i32=bp7_select_pbar(btP,hbP,cO,1,pb);
    if(selo!=mOp){streakOK=0;}
    let effo:i32=bp2_eff(btP,mOp);
    let q7:i32=bp7_selfcnt(WP,go1,7);
    let q3:i32=bp7_selfcnt(WP,go1,3);
    let rro:i32=ev_observe(WP,805,85,30);
    let abo:[]u8=z_alloc(8);
    bp7_absorb(WP,btP,mOp,go1,q7,q3,abo);
    if(get32(abo,0)==0){streakOK=0;}
    set32(pb,mOp*4,bp7_bar_param(get32(pb,mOp*4),0,effo,1,1,2,1,10));
    kk=kk+1;
  }
  emit("PB-STREAK pbO "); e64(get32(pb,mOp*4));
  emit(" supO "); e64(btP[mOp*8] as i32);
  emit(" confO "); e64(btP[mOp*8+1] as i32); emit("\n");
  bp7_bar(t,"K-PB-STREAK",streakOK==1 && get32(pb,mOp*4)==10 && (btP[mOp*8] as i32)==255 && (btP[mOp*8+1] as i32)==41);
  let kd:i32=0;
  while(kd<12){
    bp2_disconfirm(btP,mOp);
    kd=kd+1;
  }
  let cO2:[]u8=z_alloc(4);
  set32(cO2,0,mOp);
  emit("PB-OVERFIT supO "); e64(btP[mOp*8] as i32);
  emit(" effO "); e64(bp2_eff(btP,mOp));
  emit(" pbO "); e64(get32(pb,mOp*4));
  emit(" gbar "); e64(gbar); emit("\n");
  bp7_bar(t,"K-PB-OVERFIT",(btP[mOp*8] as i32)==15 && bp7_select_pbar(btP,hbP,cO2,1,pb)==mOp && bp2_select(btP,hbP,cO2,1,gbar)==-3);
  emit("PBAR-END\n");

  emit("BP7-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP7-END\n");
  return 0;
}

// =====================================================================
// sx.zag -- FAMILY 3, "SX" (store-extrapolate).  PREREG section 3.
// Concatenated BEFORE frz3.zag, because Zag is concatenated with no
// forward declarations and frz3.zag's try_family calls fx_sx_bind.
//
// CHARTER 108. This file contains NO relation id, NO object id, NO
// subject id, NO stage index, NO goal tag, NO need tag, NO width, NO
// count constant, NO string and NO reference to any test, world or
// goal. Its only inputs are the store A and a goal record G. Every
// clause is a statement about what the store exhibits.
//
// The private accessors below duplicate z_alloc/get32/need_off under
// different names purely because of concatenation order; they use the
// same little-endian i32 convention as the frozen ones.
// =====================================================================

fn sx_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn sx_get(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn sx_noff(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=sx_get(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn sx_nf(G:[]u8,n:i32)i32 { return sx_get(G,sx_noff(G,n)+4); }
fn sx_fld(G:[]u8,n:i32,f:i32)i32 { return sx_get(G,sx_noff(G,n)+8+f*4); }

// ---------------------------------------------------------------------
// PAIR TABLE. One entry per DISTINCT witnessed (relation,object) pair
// in the store, 9 i32 cells = 36 bytes at T+4+f*36:
//   +0  r                       +12 smin          +24 omax
//   +4  o                       +16 smax          +28 c = r - o
//   +8  w (witness count)       +20 omin          +32 bmin
// Cap 128 pairs. A store with more distinct pairs is REFUSED rather
// than answered from a truncated view (return -1).
// Arena layout is the frozen one: A[0] = count, fact i at 4+i*12.
// ---------------------------------------------------------------------
fn sx_tab(A:[]u8,T:[]u8)i32 {
  set32(T,0,0);
  let n:i32=sx_get(A,0);
  let i:i32=0;
  while(i<n){
    let r:i32=sx_get(A,4+i*12+4);
    let o:i32=sx_get(A,4+i*12+8);
    let s:i32=sx_get(A,4+i*12);
    let f:i32=0;
    let fnd:i32=-1;
    while(f<sx_get(T,0)){
      if(sx_get(T,4+f*36)==r){
        if(sx_get(T,4+f*36+4)==o){ fnd=f; }
      }
      f=f+1;
    }
    if(fnd<0){
      let np:i32=sx_get(T,0);
      if(np<128){
        set32(T,4+np*36,r);
        set32(T,4+np*36+4,o);
        set32(T,4+np*36+8,1);
        set32(T,4+np*36+12,s);
        set32(T,4+np*36+16,s);
        set32(T,0,np+1);
      }
    } else {
      set32(T,4+fnd*36+8,sx_get(T,4+fnd*36+8)+1);
      if(s<sx_get(T,4+fnd*36+12)){ set32(T,4+fnd*36+12,s); }
      if(s>sx_get(T,4+fnd*36+16)){ set32(T,4+fnd*36+16,s); }
    }
    i=i+1;
  }
  let tot:i32=sx_get(T,0);
  if(tot>=128){ return -1; }
  return tot;
}
fn sx_find(T:[]u8,np:i32,r:i32,o:i32)i32 {
  let f:i32=0;
  while(f<np){
    if(sx_get(T,4+f*36)==r){ if(sx_get(T,4+f*36+4)==o){ return f; } }
    f=f+1;
  }
  return -1;
}
// object-id bitmap over the witnessed objects; ids >= 16384 are refused
fn sx_obm(A:[]u8,BM:[]u8)i32 {
  let i:i32=0;
  while(i<16384){ BM[i]=0; i=i+1; }
  let n:i32=sx_get(A,0);
  i=0;
  while(i<n){
    let o:i32=sx_get(A,4+i*12+8);
    if(o<0){ return 0; }
    if(o>=16384){ return 0; }
    BM[o]=1;
    i=i+1;
  }
  return 1;
}
// per entry: the maximal consecutive run of WITNESSED object ids that
// contains this entry's object; and c = r - o.
fn sx_runs(T:[]u8,np:i32,BM:[]u8)void {
  let f:i32=0;
  while(f<np){
    let o:i32=sx_get(T,4+f*36+4);
    let lo:i32=o;
    let hi:i32=o;
    let g:i32=1;
    while(g==1){
      if(BM[lo-1]==0){ g=0; }
      else { lo=lo-1; }
    }
    g=1;
    while(g==1){
      if(BM[hi+1]==0){ g=0; }
      else { hi=hi+1; }
    }
    set32(T,4+f*36+20,lo);
    set32(T,4+f*36+24,hi);
    set32(T,4+f*36+28,sx_get(T,4+f*36)-o);
    f=f+1;
  }
  return;
}
// per entry: min subject over every pair in the same object run
fn sx_bmins(T:[]u8,np:i32)void {
  let f:i32=0;
  while(f<np){
    let lo:i32=sx_get(T,4+f*36+20);
    let hi:i32=sx_get(T,4+f*36+24);
    let bm:i32=0;
    let q:i32=0;
    let first:i32=1;
    while(q<np){
      let oq:i32=sx_get(T,4+q*36+4);
      if((oq>=lo)&&(oq<=hi)){
        let sm:i32=sx_get(T,4+q*36+12);
        if(first==1){ bm=sm; first=0; }
        if(sm<bm){ bm=sm; }
      }
      q=q+1;
    }
    set32(T,4+f*36+32,bm);
    f=f+1;
  }
  return;
}

// ---------------------------------------------------------------------
// CLAUSE C1 -- PREFIX REGULARITY, checked over EVERY witnessed pair in
// the store: the pair's witness subjects must be exactly
// {m, m+1, ..., m+w-1} with m = min, i.e. smax - smin + 1 == w.
// ---------------------------------------------------------------------
fn sx_c1(T:[]u8,np:i32)i32 {
  let f:i32=0;
  while(f<np){
    let m:i32=sx_get(T,4+f*36+12);
    let x:i32=sx_get(T,4+f*36+16);
    let w:i32=sx_get(T,4+f*36+8);
    if((x-m+1)!=w){ return 0; }
    f=f+1;
  }
  return 1;
}
// CLAUSE C2 -- BAND ALIGNMENT: inside one object run every pair shares
// one constant c = r - o. Checked for every run in the store.
fn sx_c2(T:[]u8,np:i32)i32 {
  let f:i32=0;
  while(f<np){
    let lo:i32=sx_get(T,4+f*36+20);
    let hi:i32=sx_get(T,4+f*36+24);
    let c:i32=sx_get(T,4+f*36+28);
    let q:i32=0;
    while(q<np){
      let oq:i32=sx_get(T,4+q*36+4);
      if((oq>=lo)&&(oq<=hi)){
        if(sx_get(T,4+q*36+28)!=c){ return 0; }
      }
      q=q+1;
    }
    f=f+1;
  }
  return 1;
}
// the (relation,object) pair a need names.
//   nf==2            -> (f0,f1)
//   nf==1+ns*3, ns==1, and the single step's subject field is 0
//                    -> (f2,f3)
// Anything else REFUSES: a COUNT need names no object, and a chain with
// more than one step names several pairs with no defined composition.
fn fx_sx_pair(G:[]u8,n:i32,OUT:[]u8)i32 {
  let nf:i32=sx_nf(G,n);
  if(nf==2){
    set32(OUT,0,sx_fld(G,n,0));
    set32(OUT,4,sx_fld(G,n,1));
    return 1;
  }
  if(nf==4){
    if(sx_fld(G,n,0)!=1){ return 0; }
    if(sx_fld(G,n,1)!=0){ return 0; }
    set32(OUT,0,sx_fld(G,n,2));
    set32(OUT,4,sx_fld(G,n,3));
    return 1;
  }
  return 0;
}
// ---------------------------------------------------------------------
// fx_sx_fit: the whole rule. Returns 1 iff every clause holds, in which
// case P gets [b0, W, b0, r, o]; returns 0 on any refusal.
//   C0 present   : the store already witnesses the pair        -> 0
//   C1 prefix    : every witnessed pair is a prefix           -> 0 else
//   C2 alignment : one constant c = r - o per object run      -> 0 else
//   C2' band     : some run contains the target object        -> 0 else
//   C3 slot      : rbase + k == r, k = o - omin               -> 0 else
//   C4 base      : b0 = min subject of the target band
//   C5 unanimous : every pair with the same slot index k and the
//                  same subject base b0 has the same width W;
//                  empty collection                   -> 0
//                  non-unanimous collection             -> 0
//   C6 predict   : {b0, ..., b0+W-1}
// ---------------------------------------------------------------------
fn fx_sx_fit(A:[]u8,G:[]u8,ni:i32,P:[]u8)i32 {
  let PR:[]u8=sx_alloc(16);
  if(fx_sx_pair(G,ni,PR)==0){ return 0; }
  let r:i32=get32(PR,0);
  let o:i32=get32(PR,4);
  let T:[]u8=sx_alloc(4+128*36);
  let np:i32=sx_tab(A,T);
  if(np<1){ return 0; }
  // C0 -- present evidence. SX never overrides what the store holds.
  if(sx_find(T,np,r,o)>=0){ return 0; }
  let BM:[]u8=sx_alloc(16384);
  if(sx_obm(A,BM)==0){ return 0; }
  // The object-id line is read with the QUERIED id treated as a possible
  // member of the band, so that a band whose middle slot is a hole is one
  // band rather than two. This is the prereg's "the run containing o":
  // the maximal block of consecutive object ids containing o in which every
  // id OTHER THAN o is witnessed.
  if(o<16384){ BM[o]=1; }
  sx_runs(T,np,BM);
  sx_bmins(T,np);
  // C1
  if(sx_c1(T,np)==0){ return 0; }
  // C2
  if(sx_c2(T,np)==0){ return 0; }
  // C2' -- the run that contains the target object
  let tf:i32=-1;
  let f:i32=0;
  while(f<np){
    let lo:i32=get32(T,4+f*36+20);
    let hi:i32=get32(T,4+f*36+24);
    if((o>=lo)&&(o<=hi)){ tf=f; f=np; }
    else { f=f+1; }
  }
  if(tf<0){ return 0; }
  let lo2:i32=get32(T,4+tf*36+20);
  let hi2:i32=get32(T,4+tf*36+24);
  let k:i32=o-lo2;
  // C3 -- slot identity: rbase + k == r
  let rbase:i32=0;
  let have:i32=0;
  let q:i32=0;
  while(q<np){
    let oq:i32=get32(T,4+q*36+4);
    if((oq>=lo2)&&(oq<=hi2)){
      let rq:i32=get32(T,4+q*36);
      if(have==0){ rbase=rq; have=1; }
      if(rq<rbase){ rbase=rq; }
    }
    q=q+1;
  }
  if(have==0){ return 0; }
  if((rbase+k)!=r){ return 0; }
  // C4 -- subject base of the target band
  let b0:i32=get32(T,4+tf*36+32);
  // C5 -- unanimous width at slot k within subject base b0
  let W:i32=-1;
  let cnt:i32=0;
  let e:i32=0;
  while(e<np){
    let oq2:i32=get32(T,4+e*36+4);
    let loq:i32=get32(T,4+e*36+20);
    let kq:i32=oq2-loq;
    let bq:i32=get32(T,4+e*36+32);
    if(kq==k){
      if(bq==b0){
        let wq:i32=get32(T,4+e*36+8);
        if(cnt==0){ W=wq; cnt=1; }
        if(wq!=W){ return 0; }
      }
    }
    e=e+1;
  }
  if(cnt==0){ return 0; }
  if(W<1){ return 0; }
  set32(P,0,b0);
  set32(P,4,W);
  set32(P,8,b0);
  set32(P,12,r);
  set32(P,16,o);
  return 1;
}
fn fx_sx_b0(P:[]u8)i32 { return get32(P,0); }
fn fx_sx_w(P:[]u8)i32 { return get32(P,4); }
fn fx_sx_pred(P:[]u8)i32 { return get32(P,8); }
// 1 iff the need's own (r,o) is the fitted pair and sub is in the
// predicted witness set. Used only for a chain need with no fan-in
// source, where the frozen VERIFY would have tested that single fact.
fn fx_sx_has(P:[]u8,sub:i32,r:i32,o:i32)i32 {
  if(get32(P,12)!=r){ return 0; }
  if(get32(P,16)!=o){ return 0; }
  let b:i32=get32(P,0);
  let w:i32=get32(P,4);
  if(sub<b){ return 0; }
  if(sub>=b+w){ return 0; }
  return 1;
}
// The bind-time decision. 1 = CONSUME the need as family 3, 0 = refuse.
fn fx_sx_bind(L:[]u8,A:[]u8,G:[]u8,n:i32)i32 {
  let P:[]u8=z_alloc(32);
  if(fx_sx_fit(A,G,n,P)==0){ return 0; }
  set32(L,13292,get32(L,13292)+fx_sx_w(P));
  return 1;
}
// fa_life.zag -- FREEZE-ARENA-1 additive layer (claims C563-C569).
//
// The ONLY function in this file that writes a learner arena is
// frz_add(A,subj,rel,obj) (append-if-absent). Its ONLY call site is inside
// frz_episode, immediately BEFORE the frozen observation step that consumes
// the same fact. frz_fill is the LIVE-arm-only stage-entry prefill and it
// appends from the SAME scratch arena the episodes read from, so the two arms
// are content-identical by construction rather than by assertion (LK5).
//
// Nothing here is in the frozen prefix, and nothing here edits it.
// The learner is reached only through frz_episode and lt_query.

// ordinary stages carry 52 facts (see lt3_world.zag nested witness sets);
// stage E carries 600 distractors.
fn frz_nfact(s:i32)i32 {
  if(s==4){ return 600; }
  return 52;
}
fn frz_prefill(s:i32)i32 {
  return frz_nfact(s);
}
// scratch arena holding stage s's facts, from the UNMODIFIED world writers
fn frz_stage_into(AS:[]u8, s:i32)void {
  let i:i32=0;
  while(i<4096){ set32(AS,i*4,0); i=i+1; }
  if(s==0){ w_stageA3(AS); return; }
  if(s==1){ w_stageB3(AS); return; }
  if(s==2){ w_stageC3(AS); return; }
  if(s==3){ w_stageD3(AS); return; }
  if(s==4){ w_stageE3(AS); return; }
  if(s==5){ w_stageF3(AS); return; }
  if(s==6){ w_stageG3(AS); return; }
  if(s==7){ w_stageH3(AS); return; }
  if(s==8){ w_stageI3(AS); return; }
  w_stageJ3(AS);
  return;
}
// ---- the single arena writer ----
fn frz_has(A:[]u8, s:i32, r:i32, o:i32)i32 {
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==s){
      if(get32(A,4+i*12+4)==r){
        if(get32(A,4+i*12+8)==o){ return 1; }
      }
    }
    i=i+1;
  }
  return 0;
}
fn frz_add(A:[]u8, s:i32, r:i32, o:i32)i32 {
  if(frz_has(A,s,r,o)==1){ return 0; }
  lt3_add(A,s,r,o);
  return 1;
}
fn frz_fill(A:[]u8, AS:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let s:i32=get32(AS,4+i*12);
    let r:i32=get32(AS,4+i*12+4);
    let o:i32=get32(AS,4+i*12+8);
    frz_add(A,s,r,o);
    i=i+1;
  }
  return;
}

// ---- relation attribution (PREREG 6, contiguous per stage) ----
fn frz_rbase(s:i32)i32 {
  if(s==0){ return 1001; }
  if(s==1){ return 1101; }
  if(s==2){ return 1201; }
  if(s==3){ return 1301; }
  if(s==4){ return 1501; }
  if(s==5){ return 1401; }
  if(s==6){ return 1601; }
  if(s==7){ return 1701; }
  if(s==8){ return 1801; }
  return 1901;
}
fn frz_nrel(s:i32)i32 {
  return 10;
}
// is v a relation id ATTRIBUTED to stage s?  (302 -> C, not F;
//  201/205 reused by G's revision stay attributed to B)
fn frz_reldrop(s:i32, v:i32)i32 {
  let b:i32=frz_rbase(s);
  if(v<b){ return 0; }
  if(v<b+frz_nrel(s)){ return 1; }
  return 0;
}
// ---- (relation, first fact index inside stage s) table ----
fn frz_rlbuild(AS:[]u8, RL:[]u8)i32 {
  set32(RL,0,0);
  let nf:i32=get32(AS,0);
  let i:i32=0;
  while(i<nf){
    let r:i32=get32(AS,4+i*12+4);
    let n:i32=get32(RL,0);
    let f:i32=0;
    let fnd:i32=0;
    while(f<n){
      if(get32(RL,4+f*8)==r){ fnd=1; }
      f=f+1;
    }
    if(fnd==0){
      if(n<31){
        set32(RL,4+n*8,r);
        set32(RL,4+n*8+4,i);
        set32(RL,0,n+1);
      }
    }
    i=i+1;
  }
  return get32(RL,0);
}
// ---- LK2 / LK7-mid: learner-memory purity ----
// A value-equality test is CONFOUNDED in this world: stage B's subjects are
// 110-115 and stage D's relation ids are 108-112; stage E's objects are
// 600-609 and stage G's relation ids are 601-604. So a cell holding the integer
// 111 may be a stage-B SUBJECT, and a cell holding 601 may be a stage-E OBJECT.
// frz_rmask therefore marks a stage-s relation inadmissible when its integer
// value already occurs as a subject or object of some triple in the arena
// (stages 0..s-1 at the instant of the test), and when its first occurrence
// inside stage s lies before minfirst (the ERRATA E1 undelivered-suffix rule).
fn frz_rmask(RL:[]u8,A:[]u8,CO:[]u8,s:i32)void {
  let nr:i32=get32(RL,0);
  let f:i32=0;
  while(f<nr){ set32(CO,4+f*4,0); f=f+1; }
  let na:i32=get32(A,0);
  let i:i32=0;
  while(i<na){
    let su:i32=get32(A,4+i*12);
    let ob:i32=get32(A,4+i*12+8);
    let g:i32=0;
    while(g<nr){
      let r:i32=get32(RL,4+g*8);
      if(r==su){ set32(CO,4+g*4,1); }
      if(r==ob){ set32(CO,4+g*4,1); }
      g=g+1;
    }
    i=i+1;
  }
  return;
}
// 1 if the cell holds an ADMISSIBLE stage-s relation reference, 0 otherwise.
fn frz_hit2(v:i32, s:i32, RL:[]u8, CO:[]u8, nr:i32, minfirst:i32)i32 {
  if(v==0){ return 0; }
  if(frz_reldrop(s,v)==0){ return 0; }
  let i:i32=0;
  while(i<nr){
    if(get32(RL,4+i*8)==v){
      if(get32(CO,4+i*4)!=0){ return 0; }
      if(minfirst>=0){
        if(get32(RL,4+i*8+4)<minfirst){ return 0; }
      }
      return 1;
    }
    i=i+1;
  }
  return 0;
}
// out[0]=all admissible hits, out[4]=of which on signature fields.
// returns all-minus-signature.
fn frz_memcount(L:[]u8, LT:[]u8, s:i32, RL:[]u8, CO:[]u8, minfirst:i32, out:[]u8)i32 {
  let nr:i32=get32(RL,0);
  let raw:i32=0;
  let sg:i32=0;
  let k:i32=0;
  while(k<4096){
    let v:i32=get32(L,k*4);
    if(frz_hit2(v,s,RL,CO,nr,minfirst)==1){
      raw=raw+1;
      if(frz_issig(k*4)==1){ sg=sg+1; }
    }
    k=k+1;
  }
  k=0;
  while(k<2048){
    let v2:i32=get32(LT,k*4);
    if(frz_hit2(v2,s,RL,CO,nr,minfirst)==1){
      raw=raw+1;
      if(frz_issig(4096+k*4)==1){ sg=sg+1; }
    }
    k=k+1;
  }
  set32(out,0,raw);
  set32(out,4,sg);
  return raw-sg;
}
// signature-field classifier for the combined L(0..16383)+LT(0..8191) index
fn frz_issig(off:i32)i32 {
  if(off<200){ return 0; }
  if(off<776){
    if((off-200)%48==0){ return 1; }
    if((off-244)%48==0){ return 1; }
    return 0;
  }
  if(off<1056){
    if((off-800)%16==0){ return 1; }
    return 0;
  }
  return 0;
}
// ---- LK1: how many of stage s's triples are already in the arena ----
fn frz_lk1(A:[]u8, AS:[]u8, n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let s:i32=get32(AS,4+i*12);
    let r:i32=get32(AS,4+i*12+4);
    let o:i32=get32(AS,4+i*12+8);
    if(frz_has(A,s,r,o)==1){ c=c+1; }
    i=i+1;
  }
  return c;
}
// ---- LK5: arena equality (element-wise, both directions of order) ----
fn frz_eq(A:[]u8, B:[]u8)i32 {
  let n:i32=get32(A,0);
  if(get32(B,0)!=n){ return 0; }
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)!=get32(B,4+i*12)){ return 0; }
    if(get32(A,4+i*12+4)!=get32(B,4+i*12+4)){ return 0; }
    if(get32(A,4+i*12+8)!=get32(B,4+i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
// LK5 arena snapshot. The slot must hold the WHOLE arena: LT3 reaches 1068
// triples = 4 + 1068*12 = 12820 bytes, which does NOT fit FA1's 12288-byte
// slot (that held 1023 triples). With the old geometry the copy silently
// truncated and frz_ck_eq read past the slot, reporting a bogus LK5 mismatch
// at fact 1023 of checkpoint 9. FA1 never triggered it because its 416
// triples need only 4996 bytes. Slot is now 16400 B and the copy is 3600
// cells = 14400 B >= the 1200-triple arena capacity.
fn frz_ck_cp(CS:[]u8, base:i32, A:[]u8)void {
  let i:i32=0;
  while(i<3600){ set32(CS,base+i*4,get32(A,i*4)); i=i+1; }
  return;
}
fn frz_ck_eq(CS:[]u8, base:i32, A:[]u8)i32 {
  if(get32(CS,base)!=get32(A,0)){ return 0; }
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(CS,base+4+i*12)!=get32(A,4+i*12)){ return 0; }
    if(get32(CS,base+4+i*12+4)!=get32(A,4+i*12+4)){ return 0; }
    if(get32(CS,base+4+i*12+8)!=get32(A,4+i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
// ---- ablation lesion: delete every triple of stage s from an arena ----
fn frz_del_stage(A:[]u8, AS:[]u8)void {
  let na:i32=get32(A,0);
  let ns:i32=get32(AS,0);
  let w:i32=0;
  let i:i32=0;
  while(i<na){
    let kill:i32=0;
    let j:i32=0;
    while(j<ns){
      if(get32(A,4+i*12)==get32(AS,4+j*12)){
        if(get32(A,4+i*12+4)==get32(AS,4+j*12+4)){
          if(get32(A,4+i*12+8)==get32(AS,4+j*12+8)){ kill=1; }
        }
      }
      j=j+1;
    }
    if(kill==0){
      set32(A,4+w*12,get32(A,4+i*12));
      set32(A,4+w*12+4,get32(A,4+i*12+4));
      set32(A,4+w*12+8,get32(A,4+i*12+8));
      w=w+1;
    }
    i=i+1;
  }
  set32(A,0,w);
  return;
}
// clear the three learner coverage arrays (diagnostic ablation variant)
fn frz_zero_cov(L:[]u8)void {
  let i:i32=0;
  while(i<16){
    set32(L,4+i*4,0);
    set32(L,4252+i*4,0);
    set32(L,8500+i*4,0);
    i=i+1;
  }
  set32(L,0,0);
  set32(L,4248,0);
  set32(L,8496,0);
  return;
}

// ---- diagnostic: sample the memory hits ----
// Records (offset, value, is_signature) for the first 8 cells of L then LT
// that hold a stage-s relation id. mode=1 applies the collision mask,
// mode=0 does not, so the report can show the coincidental cells too.
fn frz_hit_sample(L:[]u8,LT:[]u8,s:i32,RL:[]u8,CO:[]u8,mode:i32,out:[]u8)i32 {
  let nr:i32=get32(RL,0);
  let mf:i32=-1;
  if(mode==1){ mf=-1; } else { mf=-1; }
  let f:i32=0;
  let k:i32=0;
  while(k<4096){
    if(f<8){
      let v:i32=get32(L,k*4);
      let hit:i32=frz_hit2(v,s,RL,CO,nr,-1);
      if(mode==0){
        if(v!=0){ if(frz_reldrop(s,v)==1){ hit=1; } }
      }
      if(hit==1){
        set32(out,f*12,k*4);
        set32(out,f*12+4,v);
        set32(out,f*12+8,frz_issig(k*4));
        f=f+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2048){
    if(f<8){
      let v2:i32=get32(LT,k*4);
      let hit2:i32=frz_hit2(v2,s,RL,CO,nr,-1);
      if(mode==0){
        if(v2!=0){ if(frz_reldrop(s,v2)==1){ hit2=1; } }
      }
      if(hit2==1){
        set32(out,f*12,4096+k*4);
        set32(out,f*12+4,v2);
        set32(out,f*12+8,frz_issig(4096+k*4));
        f=f+1;
      }
    }
    k=k+1;
  }
  return f;
}

// ================= THE ONE EPISODE ENTRY POINT =====================
// Episode k of stage s asserts the k-th triple of stage s, in the world's own
// literal order, on modality k mod 3. fw: 1 = the fact is appended to the
// arena before it is observed, 0 = the observation happens against whatever
// the arena already holds (the LK3 no-episode control).
// No stage id, no goal, no correctness signal, no reuse hint is passed to the
// learner: modality is a positional function of the episode counter.
fn frz_episode(L:[]u8,LT:[]u8,A:[]u8,AS:[]u8,K:[]u8,k:i32,fw:i32,RB:[]u8,CB:[]u8,TO:[]u8,SE:[]u8)i32 {
  let ss:i32=get32(AS,4+k*12);
  let rr:i32=get32(AS,4+k*12+4);
  let oo:i32=get32(AS,4+k*12+8);
  if(fw==1){ frz_add(A,ss,rr,oo); }
  let k0:i32=get32(K,12);
  let m:i32=k-(k/3)*3;
  let r:i32=0;
  if(m==0){ r=ret_episode(L,A,rr,oo,K,TO); }
  if(m==1){
    lt_chain_clear(CB);
    lt_chain_add(CB,ss,rr,oo);
    r=vfy_episode(L,A,CB,K);
    lt_fun_observe(LT,rr,ss,oo,get32(LT,12));
  }
  if(m==2){ r=cnt_episode(L,A,rr,ss,K,TO,SE); }
  set32(LT,44,get32(LT,44)+(get32(K,12)-k0));
  return r;
}
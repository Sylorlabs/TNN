// dbg.zag -- clause-by-clause trace of fx_sx_fit on one case. Diagnostic only.
fn dbg_trace(b:[]u8,c:i32,A:[]u8,G:[]u8,ni:i32)i32 {
  let PR:[]u8=sx_alloc(16);
  if(fx_sx_pair(G,ni,PR)==0){
    c=o_app(b,c,"PAIR-REFUSE"); c=o_nl(b,c); return c;
  }
  let r:i32=get32(PR,0);
  let o:i32=get32(PR,4);
  c=o_app(b,c,"pair r="); c=o_i64(b,c,r as i64);
  c=o_app(b,c," o="); c=o_i64(b,c,o as i64); c=o_nl(b,c);
  let T:[]u8=sx_alloc(4+128*36);
  let np:i32=sx_tab(A,T);
  c=o_app(b,c,"np="); c=o_i64(b,c,np as i64); c=o_nl(b,c);
  if(np<1){ c=o_app(b,c,"EMPTY"); c=o_nl(b,c); return c; }
  if(sx_find(T,np,r,o)>=0){ c=o_app(b,c,"C0-PRESENT"); c=o_nl(b,c); return c; }
  let BM:[]u8=sx_alloc(16384);
  if(sx_obm(A,BM)==0){ c=o_app(b,c,"BM-FAIL"); c=o_nl(b,c); return c; }
  BM[o]=1;
  sx_runs(T,np,BM);
  sx_bmins(T,np);
  let f:i32=0;
  while(f<4){
    c=o_app(b,c,"  e"); c=o_i64(b,c,f as i64);
    c=o_app(b,c," r="); c=o_i64(b,c,get32(T,4+f*36) as i64);
    c=o_app(b,c," o="); c=o_i64(b,c,get32(T,4+f*36+4) as i64);
    c=o_app(b,c," w="); c=o_i64(b,c,get32(T,4+f*36+8) as i64);
    c=o_app(b,c," smin="); c=o_i64(b,c,get32(T,4+f*36+12) as i64);
    c=o_app(b,c," smax="); c=o_i64(b,c,get32(T,4+f*36+16) as i64);
    c=o_app(b,c," omin="); c=o_i64(b,c,get32(T,4+f*36+20) as i64);
    c=o_app(b,c," omax="); c=o_i64(b,c,get32(T,4+f*36+24) as i64);
    c=o_app(b,c," c="); c=o_i64(b,c,get32(T,4+f*36+28) as i64);
    c=o_app(b,c," bmin="); c=o_i64(b,c,get32(T,4+f*36+32) as i64);
    c=o_nl(b,c);
    f=f+1;
  }
  if(sx_c1(T,np)==0){ c=o_app(b,c,"C1-FAIL"); c=o_nl(b,c); return c; }
  if(sx_c2(T,np)==0){ c=o_app(b,c,"C2-FAIL"); c=o_nl(b,c); return c; }
  let tf:i32=-1;
  let f:i32=0;
  while(f<np){
    let lo:i32=get32(T,4+f*36+20);
    let hi:i32=get32(T,4+f*36+24);
    if((o>=lo)&&(o<=hi)){ tf=f; f=np; }
    else { f=f+1; }
  }
  c=o_app(b,c,"tf="); c=o_i64(b,c,tf as i64); c=o_nl(b,c);
  if(tf<0){ c=o_app(b,c,"C2P-FAIL"); c=o_nl(b,c); return c; }
  let lo2:i32=get32(T,4+tf*36+20);
  let k:i32=o-lo2;
  let rbase:i32=0;
  let have:i32=0;
  let q:i32=0;
  while(q<np){
    let oq:i32=get32(T,4+q*36+4);
    if((oq>=lo2)&&(oq<=get32(T,4+tf*36+24))){
      let rq:i32=get32(T,4+q*36);
      if(have==0){ rbase=rq; have=1; }
      if(rq<rbase){ rbase=rq; }
    }
    q=q+1;
  }
  c=o_app(b,c,"lo2="); c=o_i64(b,c,lo2 as i64);
  c=o_app(b,c," k="); c=o_i64(b,c,k as i64);
  c=o_app(b,c," rbase="); c=o_i64(b,c,rbase as i64);
  c=o_app(b,c," want="); c=o_i64(b,c,(rbase+k) as i64);
  c=o_app(b,c," b0="); c=o_i64(b,c,get32(T,4+tf*36+32) as i64);
  c=o_nl(b,c);
  let W:i32=-1;
  let cnt:i32=0;
  let e:i32=0;
  while(e<np){
    let oq2:i32=get32(T,4+e*36+4);
    let kq:i32=oq2-get32(T,4+e*36+20);
    let bq:i32=get32(T,4+e*36+32);
    if(kq==k){
      c=o_app(b,c,"MATCH e"); c=o_i64(b,c,e as i64);
      c=o_app(b,c," r="); c=o_i64(b,c,get32(T,4+e*36) as i64);
      c=o_app(b,c," kq="); c=o_i64(b,c,kq as i64);
      c=o_app(b,c," bq="); c=o_i64(b,c,bq as i64);
      c=o_app(b,c," w="); c=o_i64(b,c,get32(T,4+e*36+8) as i64); c=o_nl(b,c);
      if(bq==get32(T,4+tf*36+32)){
        let wq:i32=get32(T,4+e*36+8);
        if(cnt==0){ W=wq; cnt=1; }
        if(wq!=W){
          c=o_app(b,c,"C5-NONUNAN r="); c=o_i64(b,c,get32(T,4+e*36) as i64);
          c=o_app(b,c," w="); c=o_i64(b,c,wq as i64);
          c=o_app(b,c," W="); c=o_i64(b,c,W as i64); c=o_nl(b,c);
        }
      }
    }
    e=e+1;
  }
  c=o_app(b,c,"cnt="); c=o_i64(b,c,cnt as i64);
  c=o_app(b,c," W="); c=o_i64(b,c,W as i64); c=o_nl(b,c);
  c=o_app(b,c,"C1 C2 pass"); c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let b:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(16384);
  let s:i32=0;
  while(s<10){
    let k:i32=0;
    while(k<10){
      let w:i32=lt3_w(k);
      let j:i32=0;
      while(j<w){ lt3_add(A,100+j,lt3_rb(s)+k,lt3_ob(s)+k); j=j+1; }
      k=k+1;
    }
    s=s+1;
  }
  let na:i32=get32(A,0);
  let w2:i32=0;
  let i:i32=0;
  while(i<na){
    if(get32(A,4+i*12+4)!=1403){
      set32(A,4+w2*12,get32(A,4+i*12));
      set32(A,4+w2*12+4,get32(A,4+i*12+4));
      set32(A,4+w2*12+8,get32(A,4+i*12+8));
      w2=w2+1;
    }
    i=i+1;
  }
  set32(A,0,w2);
  let G:[]u8=z_alloc(512);
  mkLT3_goal(5,G);
  c=dbg_trace(b,c,A,G,2);
  _zag_print(b[0..c]);
  return 0;
}
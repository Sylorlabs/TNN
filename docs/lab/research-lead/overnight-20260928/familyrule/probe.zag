// probe.zag -- SMOKE PROBE for the SX rule only. Discarded after the probe
// passes; the certified artefact is fr.zag.
fn pr_copy(d:[]u8,s:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){ d[i]=s[i]; i=i+1; }
  return;
}
fn pr_delrel(A:[]u8,r:i32)i32 {
  let na:i32=get32(A,0);
  let w:i32=0;
  let i:i32=0;
  while(i<na){
    if(get32(A,4+i*12+4)!=r){
      set32(A,4+w*12,get32(A,4+i*12));
      set32(A,4+w*12+4,get32(A,4+i*12+4));
      set32(A,4+w*12+8,get32(A,4+i*12+8));
      w=w+1;
    }
    i=i+1;
  }
  set32(A,0,w);
  return na-w;
}
fn main()i32 {
  let b:[]u8=z_alloc(65536);
  let c:i32=0;
  _zag_println("SX PROBE C730");
  let A:[]u8=z_alloc(16384);
  let s:i32=0;
  while(s<10){
    let k:i32=0;
    while(k<10){
      let w:i32=lt3_w(k);
      let j:i32=0;
      while(j<w){ lt3_add(A,100+j,lt3_rb(s)+k,lt3_ob(s)+k); j=j+1; }
      k=k+1;
    }
    s=s+1;
  }
  c=o_app(b,c,"full arena="); c=o_i64(b,c,get32(A,0) as i64); c=o_nl(b,c);
  let D:i32=pr_delrel(A,1403);
  c=o_app(b,c,"deleted="); c=o_i64(b,c,D as i64);
  c=o_app(b,c," arena="); c=o_i64(b,c,get32(A,0) as i64); c=o_nl(b,c);
  let G:[]u8=z_alloc(512);
  mkLT3_goal(5,G);
  let P:[]u8=z_alloc(32);
  let n:i32=0;
  while(n<4){
    let ok:i32=fx_sx_fit(A,G,n,P);
    c=o_app(b,c,"need"); c=o_i64(b,c,n as i64);
    c=o_app(b,c," nf="); c=o_i64(b,c,need_nf(G,n) as i64);
    c=o_app(b,c," fit="); c=o_i64(b,c,ok as i64);
    c=o_app(b,c," b0="); c=o_i64(b,c,fx_sx_b0(P) as i64);
    c=o_app(b,c," W="); c=o_i64(b,c,fx_sx_w(P) as i64);
    c=o_nl(b,c);
    n=n+1;
  }
  // non-derivable: novel relation not in any band
  let G2:[]u8=z_alloc(512);
  mkLT3_goal(7,G2);
  let ok2:i32=fx_sx_fit(A,G2,0,P);
  c=o_app(b,c,"novel fit="); c=o_i64(b,c,ok2 as i64); c=o_nl(b,c);
  _zag_print(b[0..c]);
  return 0;
}
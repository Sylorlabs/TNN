// ===== P1-DEEP WITHHOLDING DRIVER =====
// Learner-owned withhold/guess boundary (Micah P1-deep).
//
// Three predictors (FACTs, taught once, never superseded; scored via
// pred_resolve directly so reliability is isolated from belief revision):
//   G (101,50,1001): world always 1001. True accuracy 100%.
//   M (102,50,1002): world 1002 w.p. m_acc/10 else 7002. True accuracy m_acc.
//   B (103,50,1003): world always 7003. True accuracy 0%.
//
// Four arms (binaries differ ONLY in wh_mode()):
//   mode 0: fixed threshold 3 (C181 behavior).
//   mode 1: always guess.
//   mode 2: conservative (always withhold).
//   mode 3: adaptive learner-owned WT (init 3, +1 false guess, -1 false withhold).
//
// Batteries:
//   W1: stationary, m_acc=6, K=20 buildup, T=300. Baseline comparison.
//   W2: regime change, M 90% -> 10% at t=150. Tests adaptive response.
//   W3: low buildup K=2. Tests miscalibrated fixed threshold.
//
// All arms see IDENTICAL (predictor, outcome) sequences: same seed, same
// round-robin order, outcome drawn for every query regardless of decision.
// Predictor reliability trajectories are therefore identical across arms;
// any metric difference is causally attributable to the decision rule.
// 3/3 byte-identical runs per arm.

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

fn pred_s(i:i32)i32 {
  if(i==0){ return 101; }
  if(i==1){ return 102; }
  return 103;
}

// 15-bit RNG threshold for M accuracy m_acc (tenths).
fn m_thresh(m_acc:i32)i32 {
  if(m_acc==9){ return 29491; }
  if(m_acc==1){ return 3277; }
  if(m_acc==4){ return 13107; }
  return 19661;  // m_acc=6
}

fn world_outcome(rng:[]u8,i:i32,m_acc:i32)i32 {
  if(i==0){ return 1001; }
  if(i==2){ return 7003; }
  if(rng_next(rng)<m_thresh(m_acc)){ return 1002; }
  return 7002;
}

fn fact_score(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      return ng(W,n,8);
    }
    n=n+1;
  }
  return -999999;
}

// Core battery. change_at<0 means no regime change.
fn battery(tag:[]u8,m_acc:i32,K:i32,T:i32,change_at:i32,m_acc2:i32)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let rng:[]u8=z_alloc(8); rng_seed(rng,12345);
  ev_teach(W,101,50,1001);
  ev_teach(W,102,50,1002);
  ev_teach(W,103,50,1003);
  // NB: ev_teach calls ctx_push which clobbers header bytes 32/36/40/44.
  // Force-init the learner-owned WT AFTER teaching (no more teaches follow).
  wh_set_wt(W,wh_wt_init());
  // Phase 1: buildup. K predict/resolve cycles per predictor (round-robin).
  let k:i32=0;
  while(k<K){
    let i:i32=0;
    while(i<3){
      let s:i32=pred_s(i);
      let p:i32=ev_predict(W,s,50);
      let o:i32=world_outcome(rng,i,m_acc);
      pred_resolve(W,s,50,o);
      i=i+1;
    }
    k=k+1;
  }
  rep(tag,"mode",wh_mode());
  rep(tag,"G_rel",fact_score(W,101,50));
  rep(tag,"M_rel",fact_score(W,102,50));
  rep(tag,"B_rel",fact_score(W,103,50));
  if(wh_mode()==3){ rep(tag,"WT_post_build",wh_get_wt(W)); }
  // Phase 2: test. Round-robin queries; outcome drawn for every query.
  let n_guess:i32=0; let n_wh:i32=0;
  let n_cg:i32=0; let n_fg:i32=0; let n_fwh:i32=0;
  let m_fg_post:i32=0; let m_wh_first:i32=-1;
  let wt_a:i32=-999; let wt_b:i32=-999; let wt_c:i32=-999;
  let i:i32=0;
  let t:i32=0;
  while(t<T){
    let ma:i32=m_acc;
    if(change_at>=0 && t>=change_at){ ma=m_acc2; }
    let s:i32=pred_s(i);
    let d:i32=wh_decide(W,s,50);
    let o:i32=world_outcome(rng,i,ma);
    let dec:i32=hg(W,44);
    let p:i32=hg(W,32);
    if(d==-3){
      n_wh=n_wh+1;
      if(dec==1 && p==o){ n_fwh=n_fwh+1; }
      if(i==1 && change_at>=0 && t>=change_at && m_wh_first==-1){
        m_wh_first=t;
      }
    } else {
      n_guess=n_guess+1;
      if(d==o){ n_cg=n_cg+1; } else { n_fg=n_fg+1; }
      if(i==1 && change_at>=0 && t>=change_at && d!=o){
        m_fg_post=m_fg_post+1;
      }
    }
    wh_resolve(W,s,50,o);
    if(wh_mode()==3){
      if(t==100){ wt_a=wh_get_wt(W); }
      if(t==200){ wt_b=wh_get_wt(W); }
    }
    i=i+1; if(i>=3){ i=0; }
    t=t+1;
  }
  if(wh_mode()==3){ wt_c=wh_get_wt(W); }
  rep(tag,"n_guess",n_guess);
  rep(tag,"n_withhold",n_wh);
  rep(tag,"n_correct_guess",n_cg);
  rep(tag,"n_false_guess",n_fg);
  rep(tag,"n_false_withhold",n_fwh);
  rep(tag,"score",n_cg-n_fg);
  rep(tag,"M_rel_end",fact_score(W,102,50));
  rep(tag,"G_rel_end",fact_score(W,101,50));
  if(wh_mode()==3){
    rep(tag,"WT_t100",wt_a);
    rep(tag,"WT_t200",wt_b);
    rep(tag,"WT_end",wt_c);
  }
  if(change_at>=0){
    rep(tag,"M_false_guess_post",m_fg_post);
    rep(tag,"M_withhold_first_t",m_wh_first);
  }
  return 1;
}

fn main()i32 {
  emit("W1 stationary\n");
  battery("W1",6,20,300,-1,6);
  emit("W2 regime change\n");
  battery("W2",9,20,300,150,1);
  emit("W3 low buildup\n");
  battery("W3",6,2,300,-1,6);
  emit("DONE\n");
  return 0;
}

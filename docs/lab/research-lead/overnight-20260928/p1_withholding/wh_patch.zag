// ============ Learner-owned withholding threshold (P1-deep) ============
// Extends C181 learner-verification: the withhold/guess boundary is no
// longer a researcher-set constant (3). It is a learner-state value WT
// (header field 40) updated ONLY from experienced decision consequences:
//
//   false guess    (guessed, prediction != outcome) -> WT += 1
//   false withhold (withheld, prediction == outcome) -> WT -= 1
//
// Causal chain:
//   decide guess/withhold -> world outcome arrives -> score the decision ->
//   WT changes in learner state -> later decisions change.
//
// Researcher scaffold (honest): WT initial value (3), update magnitudes
//   (+1/-1), clamp bounds ([-10,30]), header field, decision structure,
//   mode gate. The +1/-1 rule has the same standing as C181/C182 bookkeeping.
// Learner-owned: the WT VALUES over time, which queries are withheld,
//   the adaptation to regime change. No per-case rules.
// No new modes/bridges/handlers/semantic cases. 0 new node/edge types.

// wh_mode: 0=fixed threshold 3 (C181 behavior), 1=always guess,
//          2=conservative (always withhold), 3=adaptive (learner-owned WT).
// Each binary differs ONLY in this line (verified by diff).
fn wh_mode()i32 { return 0; }

fn wh_wt_init()i32 { return 3; }
fn wh_wt_min()i32 { return -10; }
fn wh_wt_max()i32 { return 30; }

// WT lives in header field 40 (init -1 by tnn2_init; never read by base).
// WARNING: header bytes 32/36/40/44 are also the ctx_push stack (called by
// ev_teach). WT must be (re)initialized AFTER any ev_teach sequence; the
// driver force-inits it post-teaching and no teaches follow.
fn wh_get_wt(W:[]u8)i32 {
  let w:i32=hg(W,40);
  if(w==-1){
    hs(W,40,wh_wt_init());
    return wh_wt_init();
  }
  return w;
}
fn wh_set_wt(W:[]u8,v:i32)void {
  if(v<wh_wt_min()){ v=wh_wt_min(); }
  if(v>wh_wt_max()){ v=wh_wt_max(); }
  hs(W,40,v);
  return;
}

// Effective decision threshold for this arm.
fn wh_threshold(W:[]u8)i32 {
  let m:i32=wh_mode();
  if(m==1){ return -999999; }   // always guess (any basis suffices)
  if(m==2){ return 999999; }    // conservative (withhold whenever possible)
  if(m==3){ return wh_get_wt(W); }  // learner-owned
  return 3;  // mode 0: fixed researcher threshold (C181)
}

// Setup: learner prediction + predictor reliability for (s,r).
// Same PRED-node attribution as C181 lv_setup (tested).
// Stores prediction in hg(W,32), reliability in hg(W,36).
// Returns prediction, or -999999 if no basis.
fn wh_setup(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=ev_predict(W,s,r);
  if(p==-999999){ return -999999; }
  let bn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      bn=n;
    }
    n=n+1;
  }
  let rel:i32=-999999;
  if(bn>=0){
    let sid:i32=ng(W,bn,12); let kind:i32=ng(W,bn,16);
    if(sid>=2 && ng(W,sid,36)==1){
      if(kind==1){ rel=ng(W,sid,8); }
      else { if(kind==20){ rel=ng(W,sid,12); } }
    }
  }
  hs(W,32,p); hs(W,36,rel);
  return p;
}

// Withhold/guess decision.
// Returns: prediction p (>=0) on GUESS, -3 on WITHHOLD.
// Decision code in hg(W,44): 0=no basis, 1=threshold withhold, 2=guess.
fn wh_decide(W:[]u8,s:i32,r:i32)i32 {
  let p:i32=wh_setup(W,s,r);
  if(p==-999999){
    hs(W,32,-999999); hs(W,36,-999999); hs(W,44,0);
    return -3;
  }
  if(hg(W,36)<wh_threshold(W)){
    hs(W,44,1);
    return -3;
  }
  hs(W,44,2);
  return p;
}

// Resolve a query against the world outcome o.
// Always scores the predictor (pred_resolve, all modes).
// Adaptive mode (3) also scores the DECISION and updates WT.
fn wh_resolve(W:[]u8,s:i32,r:i32,o:i32)void {
  pred_resolve(W,s,r,o);
  if(wh_mode()!=3){ return; }
  let dec:i32=hg(W,44);
  let p:i32=hg(W,32);
  if(dec==2){
    // Guessed. Wrong guess -> require more reliability next time.
    if(p!=o){ wh_set_wt(W,wh_get_wt(W)+1); }
  } else {
    if(dec==1){
      // Withheld on threshold. Would-have-been-right -> relax.
      if(p==o){ wh_set_wt(W,wh_get_wt(W)-1); }
    }
  }
  return;
}

// ---- deterministic RNG (LCG, 15-bit output) ----
fn rng_seed(s:[]u8,v:i32)void { set32(s,0,v); return; }
fn rng_next(s:[]u8)i32 {
  let x:i32=get32(s,0);
  x=x*1103515245+12345;
  set32(s,0,x);
  return (x>>16)&0x7fff;
}

// sc_driver.zag -- substrate-consolidation DYN-1 measurement driver (harness-side).
// Verbatim decline-gate DYN-1 driver (dg_driver.zag) plus substrate census:
// counts WITHHOLD (-3) returns per miss phase, their node deltas, tag-61
// substrate records, and per-key PURSUIT (consec_fail, attempts, successes).

fn dyn_n(W:[]u8)i32 { return hg(W,20); }
fn dyn_e(W:[]u8)i32 { return hg(W,24); }

// Census: count live UNCERTAINTY (tag 30) nodes whose key is (ks,kr).
fn dyn_ukey(W:[]u8,ks:i32,kr:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==ks && ng(W,n,24)==kr){c=c+1;}
    n=n+1;
  }
  return c;
}

fn dyn_uall(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30){c=c+1;}
    n=n+1;
  }
  return c;
}

// Substrate census (harness-side): count tag-61 records and read fields
// for a PURSUIT (ks,kr) key. field: 0 consec_fail, 1 attempts, 2 successes.
fn sc_sub_all(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61){c=c+1;}
    n=n+1;
  }
  return c;
}
fn sc_sub_key(W:[]u8,ks:i32,kr:i32,field:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==1 && ng(W,n,8)==ks && ng(W,n,12)==kr){
      if(field==0){return ng(W,n,16);}
      if(field==1){return ng(W,n,20);}
      return ng(W,n,24);
    }
    n=n+1;
  }
  return -1;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("DYN1-START\n");
  // per-phase accumulators: A teach, B qhit, C miss, D observe, E miss2
  let a_dn:i32=0; let a_de:i32=0; let a_c:i32=0; let a_min:i32=999999; let a_max:i32=-999999;
  let b_dn:i32=0; let b_de:i32=0; let b_c:i32=0; let b_min:i32=999999; let b_max:i32=-999999;
  let c_dn:i32=0; let c_de:i32=0; let c_c:i32=0; let c_min:i32=999999; let c_max:i32=-999999;
  let d_dn:i32=0; let d_de:i32=0; let d_c:i32=0; let d_min:i32=999999; let d_max:i32=-999999;
  let e_dn:i32=0; let e_de:i32=0; let e_c:i32=0; let e_min:i32=999999; let e_max:i32=-999999;
  // decline-gate counters
  let c_dec:i32=0; let c_dec_dn:i32=0;
  let e_dec:i32=0; let e_dec_dn:i32=0;
  let i:i32=0; let s:i32=0; let v:i32=0;
  let n0:i32=0; let e0:i32=0; let dn:i32=0; let de:i32=0; let ret:i32=0;
  // Phase A: 80 teaches, r=1, subjects 1..20
  i=0;
  while(i<80){
    s=1+(i%20); v=100+i;
    n0=dyn_n(W); e0=dyn_e(W);
    ret=ev_teach(W,s,1,v);
    dn=dyn_n(W)-n0; de=dyn_e(W)-e0;
    a_dn=a_dn+dn; a_de=a_de+de; a_c=a_c+1;
    if(dn<a_min){a_min=dn;} if(dn>a_max){a_max=dn;}
    emit("E "); e64(i); emit(" A T dn="); e64(dn); emit(" de="); e64(de); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  // Phase B: 50 query hits on taught (s,1)
  i=0;
  while(i<50){
    s=1+(i%20);
    n0=dyn_n(W); e0=dyn_e(W);
    ret=ev_query(W,s,1,0,0);
    dn=dyn_n(W)-n0; de=dyn_e(W)-e0;
    b_dn=b_dn+dn; b_de=b_de+de; b_c=b_c+1;
    if(dn<b_min){b_min=dn;} if(dn>b_max){b_max=dn;}
    emit("E "); e64(80+i); emit(" B Q dn="); e64(dn); emit(" de="); e64(de); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  // Phase C: 50 misses, r=99 never taught, fresh subjects 101..110
  i=0;
  while(i<50){
    s=101+(i%10);
    n0=dyn_n(W); e0=dyn_e(W);
    ret=ev_query(W,s,99,-2,0);
    dn=dyn_n(W)-n0; de=dyn_e(W)-e0;
    c_dn=c_dn+dn; c_de=c_de+de; c_c=c_c+1;
    if(dn<c_min){c_min=dn;} if(dn>c_max){c_max=dn;}
    if(ret==-3){c_dec=c_dec+1; c_dec_dn=c_dec_dn+dn;}
    emit("E "); e64(130+i); emit(" C M dn="); e64(dn); emit(" de="); e64(de); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  // Phase D: 50 observes; s=1..10 confirm (taught v), s=11..20 contradict
  i=0;
  while(i<50){
    s=1+(i%20);
    if(s<=10){ v=160+s-1; } else { v=7777; }
    n0=dyn_n(W); e0=dyn_e(W);
    ret=ev_observe(W,s,1,v);
    dn=dyn_n(W)-n0; de=dyn_e(W)-e0;
    d_dn=d_dn+dn; d_de=d_de+de; d_c=d_c+1;
    if(dn<d_min){d_min=dn;} if(dn>d_max){d_max=dn;}
    emit("E "); e64(180+i); emit(" D O dn="); e64(dn); emit(" de="); e64(de); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  // Phase E: 20 more misses, same keys as C (now 7 misses per key)
  i=0;
  while(i<20){
    s=101+(i%10);
    n0=dyn_n(W); e0=dyn_e(W);
    ret=ev_query(W,s,99,-2,0);
    dn=dyn_n(W)-n0; de=dyn_e(W)-e0;
    e_dn=e_dn+dn; e_de=e_de+de; e_c=e_c+1;
    if(dn<e_min){e_min=dn;} if(dn>e_max){e_max=dn;}
    if(ret==-3){e_dec=e_dec+1; e_dec_dn=e_dec_dn+dn;}
    emit("E "); e64(230+i); emit(" E M dn="); e64(dn); emit(" de="); e64(de); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  emit("DYN1-SUMMARY\n");
  emit("PH A teach n="); e64(a_c); emit(" totdn="); e64(a_dn); emit(" totde="); e64(a_de);
  emit(" mindn="); e64(a_min); emit(" maxdn="); e64(a_max); emit("\n");
  emit("PH B qhit n="); e64(b_c); emit(" totdn="); e64(b_dn); emit(" totde="); e64(b_de);
  emit(" mindn="); e64(b_min); emit(" maxdn="); e64(b_max); emit("\n");
  emit("PH C miss n="); e64(c_c); emit(" totdn="); e64(c_dn); emit(" totde="); e64(c_de);
  emit(" mindn="); e64(c_min); emit(" maxdn="); e64(c_max);
  emit(" declines="); e64(c_dec); emit(" decdn="); e64(c_dec_dn); emit("\n");
  emit("PH D obs n="); e64(d_c); emit(" totdn="); e64(d_dn); emit(" totde="); e64(d_de);
  emit(" mindn="); e64(d_min); emit(" maxdn="); e64(d_max); emit("\n");
  emit("PH E miss2 n="); e64(e_c); emit(" totdn="); e64(e_dn); emit(" totde="); e64(e_de);
  emit(" mindn="); e64(e_min); emit(" maxdn="); e64(e_max);
  emit(" declines="); e64(e_dec); emit(" decdn="); e64(e_dec_dn); emit("\n");
  emit("FINAL live_nodes="); e64(dyn_n(W)); emit(" live_edges="); e64(dyn_e(W));
  emit(" clock="); e64(hg(W,0)); emit("\n");
  // Duplication census: keys (101..110, 99), each missed 7 times
  emit("DYN1-DUP-CENSUS total_uncert="); e64(dyn_uall(W)); emit("\n");
  s=101;
  while(s<=110){
    emit("KEY s="); e64(s); emit(" r=99 uncert_count="); e64(dyn_ukey(W,s,99)); emit("\n");
    s=s+1;
  }
  // Substrate census: records and per-key PURSUIT fields
  emit("DYN1-SUB-CENSUS total_records="); e64(sc_sub_all(W)); emit("\n");
  s=101;
  while(s<=110){
    emit("SUBKEY s="); e64(s); emit(" r=99 consec="); e64(sc_sub_key(W,s,99,0));
    emit(" attempts="); e64(sc_sub_key(W,s,99,1)); emit(" successes="); e64(sc_sub_key(W,s,99,2)); emit("\n");
    s=s+1;
  }
  emit("DYN1-END\n");
  return 0;
}

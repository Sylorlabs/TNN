// mem3_adv.zag -- H-MEM3 adversary harness (frozen).
// Prereg: PREREG_ADV_MEM3.md (commit 532c34dbf, strictly before this file).
// This file contains ONLY the adversarial main. The mechanism (everything
// before "fn main" in mem3_learn.zag at the frozen builder commit 903a2c16c)
// is extracted at build time; see ADV_MEM3_EVIDENCE.txt for the exact build.
// Pure Zag. Deterministic. No Python anywhere.
fn slot_of_pid(W:[]u8, pid:i32)i32 {
  let s:i32=0;
  while(s<8){ if(st_pid(W,s)==pid){ return s; } s=s+1; }
  return -1;
}
fn adv_m3_1()i32 {
  emit("=== X-M3-1: counterfactual honesty + probation harm ===\n");
  let W:[]u8=z_alloc(8*28);
  let ST:[]u8=z_alloc(16);
  let Q:[]u8=z_alloc(512);
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  // A_old: 0x4 1x4 2x2 3x2 4x2 5x2 7x1 = 17
  let A:[]u8=z_alloc(17);
  A[0]=0;A[1]=0;A[2]=0;A[3]=0;A[4]=1;A[5]=1;A[6]=1;A[7]=1;
  A[8]=2;A[9]=2;A[10]=3;A[11]=3;A[12]=4;A[13]=4;A[14]=5;A[15]=5;A[16]=7;
  run_seq(W, ST, Q, A, 17);
  // T: 20 queries
  let T:[]u8=z_alloc(20);
  T[0]=6;T[1]=6;T[2]=2;T[3]=2;T[4]=3;T[5]=3;T[6]=4;T[7]=4;T[8]=5;
  T[9]=2;T[10]=2;T[11]=2;T[12]=3;T[13]=3;T[14]=3;T[15]=4;T[16]=4;T[17]=5;T[18]=5;T[19]=5;
  run_seq(W, ST, Q, T, 20);
  let sel0:i32=pressure(W,Q,ST,0,8);
  emit("adv: ev0 selected="); emit(pol_name(sel0)); emit(" (expect LFU)\n");
  // Qb: 6x3 0x2 1x3 2x1 = 9
  let B:[]u8=z_alloc(9);
  B[0]=6;B[1]=6;B[2]=6;B[3]=0;B[4]=0;B[5]=1;B[6]=1;B[7]=1;B[8]=2;
  run_seq(W, ST, Q, B, 9);
  // pre-pressure measurements at ev=1
  let bestp1:i32=argmin_pol(W,Q,ST,1,20,1);
  let bestp0:i32=argmin_pol(W,Q,ST,1,20,0);
  let pv3:i32=victim(W,ST,bestp1,1,1);
  let uv:i32=victim(W,ST,bestp1,1,0);
  let v1:i32=victim(W,ST,bestp1,1,1);
  let v0:i32=victim(W,ST,bestp0,1,0);
  let c_prot:i32=replay_cost(W,Q,ST,v1,20);
  let c_unprot:i32=replay_cost(W,Q,ST,v0,20);
  let s_new:i32=slot_of_pid(W,8);
  let s_old:i32=slot_of_pid(W,0);
  let uses_new:i32=-1; if(s_new>=0){uses_new=st_uses(W,s_new);}
  let uses_old:i32=-1; if(s_old>=0){uses_old=st_uses(W,s_old);}
  emit("adv: bestp1="); emit(pol_name(bestp1)); emit(" (expect FIFO)\n");
  emit("adv: bestp0="); emit(pol_name(bestp0)); emit(" (expect LFU)\n");
  emit("adv: pv3=slot"); emit(i32s(pv3)); emit(" uv=slot"); emit(i32s(uv)); emit(" (expect 0/0)\n");
  emit("adv: v1(evict w/ probation)=slot"); emit(i32s(v1));
  emit(" v0(evict w/o probation)=slot"); emit(i32s(v0)); emit(" (expect 0/7)\n");
  emit("adv: c_prot="); emit(i32s(c_prot)); emit(" c_unprot="); emit(i32s(c_unprot)); emit(" (expect 2/0)\n");
  emit("adv: uses_new(proc8)="); emit(i32s(uses_new));
  emit(" uses_old(proc0)="); emit(i32s(uses_old)); emit(" (expect 0/6)\n");
  let ok:i32=1;
  if(sel0!=0){ok=0;}
  if(bestp1!=2){ok=0;}
  if(bestp0!=0){ok=0;}
  if(bestp1==bestp0){ok=0;}
  if(pv3!=0 || uv!=0){ok=0;}
  if(v1!=0 || v0!=7){ok=0;}
  if(c_prot!=2 || c_unprot!=0){ok=0;}
  if(uses_new!=0 || uses_old!=6){ok=0;}
  if(ok==1){ emit("ADV-M3-1a CONFIRMED: winner flips under no probation; verdict will read CHURN-PREVENTED:0 while probation is but-for cause of newcomer survival\n"); }
  else { emit("ADV-M3-1a REFUTED: fixture did not reach the intended state\n"); }
  if(ok==1 && c_prot>c_unprot && uses_new<uses_old){
    emit("ADV-M3-1b CONFIRMED: probation caused harm; eviction cost 0 -> 2, shielded never-queried newcomer over queried proc0\n");
  } else {
    emit("ADV-M3-1b REFUTED\n");
  }
  emit("adv: calling real pressure(ev=1) to capture the printed verdict:\n");
  let sel1:i32=pressure(W,Q,ST,1,9);
  emit("adv: ev1 selected="); emit(pol_name(sel1)); emit("\n");
  return ok;
}
fn adv_m3_2()i32 {
  emit("=== X-M3-2a: adversarial future targeting the evicted procedure ===\n");
  let W:[]u8=z_alloc(8*28);
  let ST:[]u8=z_alloc(16);
  let Q:[]u8=z_alloc(512);
  store_init(W, ST);
  learn_stream(W, ST, 0, 8);
  // builder A2 AA (33) then AW (20), replicated exactly
  let AA:[]u8=z_alloc(33);
  let ai:i32=0;
  AA[ai]=5;ai=ai+1;AA[ai]=5;ai=ai+1;
  let t:i32=0;
  while(t<4){AA[ai]=0;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=7;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=3;ai=ai+1;t=t+1;} t=0;
  while(t<4){AA[ai]=6;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=1;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=2;ai=ai+1;t=t+1;} t=0;
  while(t<5){AA[ai]=4;ai=ai+1;t=t+1;}
  run_seq(W, ST, Q, AA, ai);
  let AW:[]u8=z_alloc(20);
  AW[0]=6;AW[1]=6;AW[2]=5;AW[3]=0;AW[4]=0;AW[5]=0;AW[6]=0;
  AW[7]=7;AW[8]=7;AW[9]=7;AW[10]=7;AW[11]=3;AW[12]=3;AW[13]=3;AW[14]=3;
  AW[15]=1;AW[16]=1;AW[17]=2;AW[18]=2;AW[19]=4;
  run_seq(W, ST, Q, AW, 20);
  let sel:i32=select_win(W,Q,ST,0,20);
  emit("adv: A2-ev0 selected="); emit(pol_name(sel)); emit(" (expect LFU)\n");
  let v_adv:i32=victim(W,ST,sel,0,1);
  let pid_adv:i32=-1; if(v_adv>=0){pid_adv=st_pid(W,v_adv);}
  emit("adv: selected victim proc="); emit(i32s(pid_adv)); emit("\n");
  let FADV:[]u8=z_alloc(20);
  let i:i32=0;
  while(i<20){ FADV[i]=(pid_adv as u8); i=i+1; }
  let dd:i32=dist_differs(Q,ST,FADV,20,20);
  emit("adv: dist_differs(F-ADV)="); emit(i32s(dd)); emit(" (expect 1)\n");
  let r:i32=fut_score2(W,Q,ST,0,FADV,20,sel,20,"A2 F-ADV");
  emit("adv: fut_score2 returned "); emit(i32s(r)); emit(" (expect 0 = K-M3-2 FAIL)\n");
  // per-policy misses on F-ADV, computed directly
  let M:[]u8=z_alloc(20);
  let p:i32=0;
  while(p<5){
    let vv:i32=victim(W,ST,p,0,1);
    let pp:i32=-1; if(vv>=0){pp=st_pid(W,vv);}
    let m:i32=0; let j:i32=0;
    while(j<20){ if((FADV[j] as i32)==pp){m=m+1;} j=j+1; }
    set32(M,p*4,m);
    p=p+1;
  }
  emit("adv: direct misses:");
  p=0;
  while(p<5){ emit(" "); emit(pol_name(p)); emit("="); emit(i32s(get32(M,p*4))); p=p+1; }
  emit("\n");
  let smsel:i32=get32(M,sel*4);
  let worst:i32=1;
  p=0;
  while(p<5){ if(p!=sel){ if(get32(M,p*4)>=smsel){ worst=0; } } p=p+1; }
  let ok:i32=1;
  if(sel!=0){ok=0;}
  if(dd!=1){ok=0;}
  if(r!=0){ok=0;}
  if(worst!=1){ok=0;}
  if(ok==1){ emit("ADV-M3-2a CONFIRMED: adversarial future passes DIST-DIFFERS and makes the selected policy uniquely worst\n"); }
  else { emit("ADV-M3-2a REFUTED\n"); }
  emit("=== X-M3-2b: DIST-DIFFERS low bar (single-query swap) ===\n");
  let FNEAR:[]u8=z_alloc(20);
  i=0;
  while(i<20){ FNEAR[i]=AW[i]; i=i+1; }
  FNEAR[0]=5;
  let dd1:i32=dist_differs(Q,ST,FNEAR,20,20);
  let dd0:i32=dist_differs(Q,ST,AW,20,20);
  emit("adv: dist_differs(single-swap)="); emit(i32s(dd1)); emit(" (expect 1)\n");
  emit("adv: dist_differs(identical)="); emit(i32s(dd0)); emit(" (expect 0)\n");
  let ok2:i32=1;
  if(dd1!=1){ok2=0;}
  if(dd0!=0){ok2=0;}
  if(ok2==1){ emit("ADV-M3-2b CONFIRMED: a one-query difference passes the independence check\n"); }
  else { emit("ADV-M3-2b REFUTED\n"); }
  if(ok==1 && ok2==1){ return 1; }
  return 0;
}
fn main()i32 {
  emit("H-MEM3 adversary harness (frozen). Prereg commit 532c34dbf.\n");
  let r1:i32=adv_m3_1();
  let r2:i32=adv_m3_2();
  emit("=== ADVERSARY SUMMARY ===\n");
  if(r1==1){ emit("X-M3-1: CONFIRMED (downgrades R1 causal claim)\n"); }
  else { emit("X-M3-1: REFUTED\n"); }
  if(r2==1){ emit("X-M3-2: CONFIRMED (boundary: adversarial futures defeat replay selection)\n"); }
  else { emit("X-M3-2: REFUTED\n"); }
  emit("X-M3-3/X-M3-4: see ADV_MEM3_EVIDENCE.txt (regression + audit, shell/audit procedure)\n");
  return 0;
}

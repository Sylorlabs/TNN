// em_base.zag -- empty-mask semantics experiment base.
// Fresh file in this lane. Operational mechanics (arena layout, facts,
// kinds, behaviors, observation recording, output idiom) follow the
// read-only reference rr_base.zag / rr_uni.zag from the compose-collapse
// reproduction lane; this is a follow-up discrimination experiment, not an
// independent reproduction, so reusing the disclosed mechanics is
// intentional: the experiment varies ONLY the S1/S2 admission reading.
//
// Arena layout (bytes), all i32 little-endian:
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s, r, o)
//   772: MAP table, 4 maps * 10 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 rel2, 3 inmask, 4 outmask,
//                5 in_node, 6 in_num, 7 out_node, 8 out_num, 9 nobs
//   932: tries  936: ans  940: inter  944: widen  948: nmaps
// Classes: 0=WALK, 1=COUNT, 2=MAYBE, 3=IDENT. Kinds: 1=NODE, 2=NUM.

fn rb_new(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn rg(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn rp(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn rmg(A:[]u8,m:i32,f:i32)i32 { return rg(A,772+m*40+f*4); }
fn rmp(A:[]u8,m:i32,f:i32,v:i32)void { rp(A,772+m*40+f*4,v); return; }
fn rw_new()[]u8 { return rb_new(4096); }
// ---- output helpers: append into buffer, return new cursor ----
fn ro_s(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn ro_i(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn ro_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn ro_out(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- facts ----
fn rf_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=rg(A,0);
  if(n<64){
    rp(A,4+n*12,s); rp(A,4+n*12+4,r); rp(A,4+n*12+8,o);
    rp(A,0,n+1);
  }
  return;
}
fn rf_issubj(A:[]u8,v:i32)i32 {
  let n:i32=rg(A,0);
  let i:i32=0;
  while(i<n){
    if(rg(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
fn rk_kind(A:[]u8,v:i32)i32 {
  if(rf_issubj(A,v)==1){ return 1; }
  return 2;
}
// ---- behaviors ----
fn rx_walk(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=rg(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      if(rg(A,4+i*12)==cur){ if(rg(A,4+i*12+4)==rel){ nxt=rg(A,4+i*12+8); i=n; } }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn rx_count(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=rg(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    if(rg(A,4+i*12)==s){ if(rg(A,4+i*12+4)==rel){ c=c+1; } }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
fn rx_run(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=rmg(A,m,0);
  let r1:i32=rmg(A,m,1);
  if(cl==0){ return rx_walk(A,s,r1); }
  if(cl==1){ return rx_count(A,s,r1); }
  if(cl==3){ return s; }
  let e:i32=rx_walk(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=rx_count(A,e,rmg(A,m,2));
  if(c==-2){ return e; }
  return c;
}
// ---- contract observations (kind sets as bitmasks; bit0=NODE, bit1=NUM) ----
fn rc_obs(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=rk_kind(A,inv);
  let ok:i32=rk_kind(A,outv);
  if(ik==1){ rmp(A,m,5,rmg(A,m,5)+1); } else { rmp(A,m,6,rmg(A,m,6)+1); }
  if(ok==1){ rmp(A,m,7,rmg(A,m,7)+1); } else { rmp(A,m,8,rmg(A,m,8)+1); }
  rmp(A,m,3,rmg(A,m,3)|(1<<(ik-1)));
  rmp(A,m,4,rmg(A,m,4)|(1<<(ok-1)));
  rmp(A,m,9,rmg(A,m,9)+1);
  return;
}
fn rc_teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=rx_run(A,m,s);
  if(v==exp){ rc_obs(A,m,s,v); }
  return;
}
fn rm_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  rmp(A,m,0,cl); rmp(A,m,1,r1); rmp(A,m,2,r2);
  return;
}
// ---- frozen discriminating worlds (PREREG Section 4) ----
// Q1: EMPTY-SINGLE. M1=IDENT untaught.
fn eq_q1(A:[]u8)void {
  rf_add(A,31,81,32); rf_add(A,32,81,33); rf_add(A,33,81,34);
  rf_add(A,34,82,301);
  rf_add(A,41,81,42); rf_add(A,42,81,43);
  rm_new(A,0,0,81,0);
  rm_new(A,1,3,0,0);
  rm_new(A,2,1,82,0);
  rc_teach(A,0,31,34);
  rc_teach(A,2,34,1);
  rp(A,948,3);
  return;
}
// Shared query-region facts for Q2/Q3/Q4.
fn eq_qfacts(A:[]u8)void {
  rf_add(A,31,81,32); rf_add(A,32,81,33); rf_add(A,33,81,34);
  rf_add(A,34,82,301); rf_add(A,34,82,302);
  rf_add(A,11,81,12);
  rf_add(A,41,81,42); rf_add(A,42,81,43); rf_add(A,43,81,44);
  rf_add(A,44,82,45); rf_add(A,44,82,46);
  return;
}
// Q2: EMPTY-MIDDLE. M1=COUNT(82) untaught.
fn eq_q2(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,0,31,34);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}
// Q3: EMPTY-OUTER-IN. M0=WALK(81) untaught.
fn eq_q3(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,1,34,2);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}
// Q4: BOTH-EMPTY-MIDDLE. M0=WALK(81) and M1=COUNT(82) untaught.
fn eq_q4(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}

// em_base.zag -- empty-mask semantics experiment base.
// Fresh file in this lane. Operational mechanics (arena layout, facts,
// kinds, behaviors, observation recording, output idiom) follow the
// read-only reference rr_base.zag / rr_uni.zag from the compose-collapse
// reproduction lane; this is a follow-up discrimination experiment, not an
// independent reproduction, so reusing the disclosed mechanics is
// intentional: the experiment varies ONLY the S1/S2 admission reading.
//
// Arena layout (bytes), all i32 little-endian:
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s, r, o)
//   772: MAP table, 4 maps * 10 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 rel2, 3 inmask, 4 outmask,
//                5 in_node, 6 in_num, 7 out_node, 8 out_num, 9 nobs
//   932: tries  936: ans  940: inter  944: widen  948: nmaps
// Classes: 0=WALK, 1=COUNT, 2=MAYBE, 3=IDENT. Kinds: 1=NODE, 2=NUM.

fn rb_new(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn rg(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn rp(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn rmg(A:[]u8,m:i32,f:i32)i32 { return rg(A,772+m*40+f*4); }
fn rmp(A:[]u8,m:i32,f:i32,v:i32)void { rp(A,772+m*40+f*4,v); return; }
fn rw_new()[]u8 { return rb_new(4096); }
// ---- output helpers: append into buffer, return new cursor ----
fn ro_s(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn ro_i(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn ro_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn ro_out(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- facts ----
fn rf_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=rg(A,0);
  if(n<64){
    rp(A,4+n*12,s); rp(A,4+n*12+4,r); rp(A,4+n*12+8,o);
    rp(A,0,n+1);
  }
  return;
}
fn rf_issubj(A:[]u8,v:i32)i32 {
  let n:i32=rg(A,0);
  let i:i32=0;
  while(i<n){
    if(rg(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
fn rk_kind(A:[]u8,v:i32)i32 {
  if(rf_issubj(A,v)==1){ return 1; }
  return 2;
}
// ---- behaviors ----
fn rx_walk(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=rg(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      if(rg(A,4+i*12)==cur){ if(rg(A,4+i*12+4)==rel){ nxt=rg(A,4+i*12+8); i=n; } }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn rx_count(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=rg(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    if(rg(A,4+i*12)==s){ if(rg(A,4+i*12+4)==rel){ c=c+1; } }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
fn rx_run(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=rmg(A,m,0);
  let r1:i32=rmg(A,m,1);
  if(cl==0){ return rx_walk(A,s,r1); }
  if(cl==1){ return rx_count(A,s,r1); }
  if(cl==3){ return s; }
  let e:i32=rx_walk(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=rx_count(A,e,rmg(A,m,2));
  if(c==-2){ return e; }
  return c;
}
// ---- contract observations (kind sets as bitmasks; bit0=NODE, bit1=NUM) ----
fn rc_obs(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=rk_kind(A,inv);
  let ok:i32=rk_kind(A,outv);
  if(ik==1){ rmp(A,m,5,rmg(A,m,5)+1); } else { rmp(A,m,6,rmg(A,m,6)+1); }
  if(ok==1){ rmp(A,m,7,rmg(A,m,7)+1); } else { rmp(A,m,8,rmg(A,m,8)+1); }
  rmp(A,m,3,rmg(A,m,3)|(1<<(ik-1)));
  rmp(A,m,4,rmg(A,m,4)|(1<<(ok-1)));
  rmp(A,m,9,rmg(A,m,9)+1);
  return;
}
fn rc_teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=rx_run(A,m,s);
  if(v==exp){ rc_obs(A,m,s,v); }
  return;
}
fn rm_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  rmp(A,m,0,cl); rmp(A,m,1,r1); rmp(A,m,2,r2);
  return;
}
// ---- frozen discriminating worlds (PREREG Section 4) ----
// Q1: EMPTY-SINGLE. M1=IDENT untaught.
fn eq_q1(A:[]u8)void {
  rf_add(A,31,81,32); rf_add(A,32,81,33); rf_add(A,33,81,34);
  rf_add(A,34,82,301);
  rf_add(A,41,81,42); rf_add(A,42,81,43);
  rm_new(A,0,0,81,0);
  rm_new(A,1,3,0,0);
  rm_new(A,2,1,82,0);
  rc_teach(A,0,31,34);
  rc_teach(A,2,34,1);
  rp(A,948,3);
  return;
}
// Shared query-region facts for Q2/Q3/Q4.
fn eq_qfacts(A:[]u8)void {
  rf_add(A,31,81,32); rf_add(A,32,81,33); rf_add(A,33,81,34);
  rf_add(A,34,82,301); rf_add(A,34,82,302);
  rf_add(A,11,81,12);
  rf_add(A,41,81,42); rf_add(A,42,81,43); rf_add(A,43,81,44);
  rf_add(A,44,82,45); rf_add(A,44,82,46);
  return;
}
// Q2: EMPTY-MIDDLE. M1=COUNT(82) untaught.
fn eq_q2(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,0,31,34);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}
// Q3: EMPTY-OUTER-IN. M0=WALK(81) untaught.
fn eq_q3(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,1,34,2);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}
// Q4: BOTH-EMPTY-MIDDLE. M0=WALK(81) and M1=COUNT(82) untaught.
fn eq_q4(A:[]u8)void {
  eq_qfacts(A);
  rm_new(A,0,0,81,0); rm_new(A,1,1,82,0); rm_new(A,2,3,0,0); rm_new(A,3,1,81,0);
  rc_teach(A,2,11,11);
  rc_teach(A,3,31,1);
  rp(A,948,4);
  return;
}
// em_arm.zag -- unified behavior-contract composition, S2 semantics.
// ONE admission rule, always active, no mode flag:
//   single A admitted iff kin compatible with A.inmask and kout with A.outmask
//   pair (A,B), A!=B, admitted iff kin compatible with A.inmask,
//     effective(A.outmask) INTERSECTS effective(B.inmask) nonempty,
//     and kout compatible with B.outmask.
// S2: an EMPTY kind-set reads as the universal set {1,2} in all three
// admission positions (Compatibility sentence).
// ONE execution rule: admitted singles in MAP-id order, then admitted pairs
// in (a,b) id order; each trial executes and verifies end-to-end; the
// intermediate is logged on pair success. WIDENING: if every admitted
// candidate fails, the filter-REJECTED ordered pairs are retried in (a,b) id
// order exactly once, and WIDEN=1 is logged. Triggered solely by
// learner-observed exhaustive failure. Successful trials record kind
// observations for each executed MAP.

fn u_eff(mask:i32)i32 {
  // EMPTY_MASK_SEMANTIC_S1: raw mask, empty rejects
  return mask;
}
fn arm_tag()[]u8 {
  if(u_eff(0)==3){ return "s2"; }
  return "s1";
}
fn u_has(mask:i32,k:i32)i32 {
  if((u_eff(mask)&(1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn u_single_ok(A:[]u8,m:i32,kin:i32,kout:i32)i32 {
  if(u_has(rmg(A,m,3),kin)==0){ return 0; }
  if(u_has(rmg(A,m,4),kout)==0){ return 0; }
  return 1;
}
fn u_pair_ok(A:[]u8,a:i32,b:i32,kin:i32,kout:i32)i32 {
  if(u_has(rmg(A,a,3),kin)==0){ return 0; }
  if((u_eff(rmg(A,a,4))&u_eff(rmg(A,b,3)))==0){ return 0; }
  if(u_has(rmg(A,b,4),kout)==0){ return 0; }
  return 1;
}
fn rs_reset(A:[]u8)void {
  rp(A,932,0); rp(A,936,-2); rp(A,940,-1); rp(A,944,0);
  return;
}
fn u_try_single(A:[]u8,m:i32,s:i32,exp:i32)i32 {
  rp(A,932,rg(A,932)+1);
  let v:i32=rx_run(A,m,s);
  if(v==exp){
    rc_obs(A,m,s,v);
    rp(A,936,v);
    return 1;
  }
  return 0;
}
fn u_try_pair(A:[]u8,a:i32,b:i32,s:i32,exp:i32)i32 {
  rp(A,932,rg(A,932)+1);
  let v1:i32=rx_run(A,a,s);
  let v2:i32=rx_run(A,b,v1);
  if(v2==exp){
    rc_obs(A,a,s,v1);
    rc_obs(A,b,v1,v2);
    rp(A,936,v2); rp(A,940,v1);
    return 1;
  }
  return 0;
}
fn u_solve(A:[]u8,s:i32,kin:i32,kout:i32,exp:i32)i32 {
  rs_reset(A);
  let m:i32=0;
  while(m<rg(A,948)){
    if(u_single_ok(A,m,kin,kout)==1){
      if(u_try_single(A,m,s,exp)==1){ return 1; }
    }
    m=m+1;
  }
  let rej:[]u8=rb_new(16);
  let nrej:i32=0;
  let a:i32=0;
  while(a<rg(A,948)){
    let b:i32=0;
    while(b<rg(A,948)){
      if(a!=b){
        if(u_pair_ok(A,a,b,kin,kout)==1){
          if(u_try_pair(A,a,b,s,exp)==1){ return 1; }
        } else {
          rej[a*4+b]=1 as u8;
          nrej=nrej+1;
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(nrej>0){
    rp(A,944,1);
    let x:i32=0;
    while(x<rg(A,948)){
      let y:i32=0;
      while(y<rg(A,948)){
        if(x!=y){
          if(rej[x*4+y]==1){
            if(u_try_pair(A,x,y,s,exp)==1){ return 1; }
          }
        }
        y=y+1;
      }
      x=x+1;
    }
  }
  return 0;
}
fn emit(B:[]u8,c:i32,prob:[]u8,A:[]u8)i32 {
  c=ro_s(B,c,arm_tag()); c=ro_s(B,c," ");
  c=ro_s(B,c,prob); c=ro_s(B,c," ANS=");
  c=ro_i(B,c,rg(A,936)); c=ro_s(B,c," TRIES=");
  c=ro_i(B,c,rg(A,932));
  if(rg(A,940)!=-1){ c=ro_s(B,c," INTER="); c=ro_i(B,c,rg(A,940)); }
  if(rg(A,944)==1){ c=ro_s(B,c," WIDEN=1"); }
  c=ro_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=rb_new(4096);
  let c:i32=0;
  let A:[]u8=rw_new();
  eq_q1(A); u_solve(A,41,1,1,41); c=emit(B,c,"Q1",A);
  A=rw_new();
  eq_q2(A); u_solve(A,41,1,2,2); c=emit(B,c,"Q2",A);
  A=rw_new();
  eq_q3(A); u_solve(A,41,1,2,2); c=emit(B,c,"Q3",A);
  A=rw_new();
  eq_q4(A); u_solve(A,41,1,2,2); c=emit(B,c,"Q4",A);
  ro_out(B,c);
  return 0;
}

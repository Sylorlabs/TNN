// ub_driver.zag -- Utility signal test driver (harness-side).
// Tests per design section 4 (falsification):
//   1. Fossil discrimination: U/L ordering vs bid ordering in reclaim trace
//   2. Zombie preemption: 0 zombie MAPs after heavy churn (baseline 3.8%)
//   3. Use-protection: MAP referenced by revision survives (MAP 22 replay)
//   4. Zero-pressure equivalence: (covered by base run_all PASS)
//   5. Cost visibility: utility writes are in-place (zero alloc)
//   6. Redundancy: (analysis, not executable)

// Census helpers.
fn live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1){c=c+1;} n=n+1;}
  return c;
}
fn map_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==20){c=c+1;} n=n+1;}
  return c;
}
// Graph walk: 1 if every cell from root is live with valid tag.
fn graph_ok(W:[]u8,root:i32)i32 {
  let cur:i32=root; let st:i32=0;
  while(st<200){
    if(cur<2 || cur>=1024){return 0;}
    if(ng(W,cur,36)==0){return 0;}
    let t:i32=ng(W,cur,0);
    if(t!=101 && t!=102 && t!=103 && t!=104){return 0;}
    if(t==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    if(cur<0){return 1;}
    st=st+1;
  }
  return 0;
}
// Count live graph cells reachable from root.
fn graph_cells(W:[]u8,root:i32)i32 {
  let cnt:i32=0; let cur:i32=root; let st:i32=0;
  while(st<200){
    if(cur<2 || cur>=1024){st=200;}
    else {
      if(ng(W,cur,36)==0){st=200;}
      else {
        let t:i32=ng(W,cur,0);
        if(t!=101 && t!=102 && t!=103 && t!=104){st=200;}
        else {
          cnt=cnt+1;
          if(t==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
          if(cur<0){st=200;}
        }
      }
    }
    st=st+1;
  }
  return cnt;
}

// TEST 1: Fossil discrimination.
// Promote 4 MAPs, use 1 of them (query hits on shadow), then pressure.
// Prediction: the used MAP (U>0) survives; fossils (U=0) reclaimed first.
// The reclaim-order trace should show U/L ordering, not bid ordering.
fn test_fossil(W:[]u8)void {
  emit("T1-FOSSIL-START\n");
  // Phase 1: teach chains.
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  ev_teach(W,201,11,202); ev_teach(W,202,11,203); ev_teach(W,203,12,301);
  ev_teach(W,301,11,302); ev_teach(W,302,11,303); ev_teach(W,303,11,304); ev_teach(W,304,12,401);
  ev_teach(W,501,11,502); ev_teach(W,502,12,601);
  ev_teach(W,701,11,702); ev_teach(W,702,12,801);
  // Phase 2: promote 4 MAPs via unmasked queries.
  let a1:i32=ev_query(W,101,40,201,0);
  let a2:i32=ev_query(W,201,40,301,0);
  let a3:i32=ev_query(W,301,40,401,0);
  let a4:i32=ev_query(W,701,40,801,0);
  emit("T1 promoted a1="); e64(a1); emit(" a2="); e64(a2);
  emit(" a3="); e64(a3); emit(" a4="); e64(a4); emit("\n");
  emit("T1 maps="); e64(map_count(W)); emit("\n");
  // Report U values after promotion (expect U=2 from trial success).
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("T1 MAP "); e64(m); emit(" U="); e64(ng(W,m,12));
      emit(" L="); e64(ng(W,m,16)); emit("\n");
    }
    m=m+1;
  }
  // Phase 3: use MAP for (101,40) via 5 query hits on shadow FACT.
  // Each hit should increment U via util_attr.
  let i:i32=0;
  while(i<5){
    let q:i32=ev_query(W,101,40,201,0);
    i=i+1;
  }
  emit("T1 after 5 hits:\n");
  m=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("T1 MAP "); e64(m); emit(" U="); e64(ng(W,m,12));
      emit(" L="); e64(ng(W,m,16)); emit("\n");
    }
    m=m+1;
  }
  // Phase 4: filler pressure (500 teaches, moderate).
  i=0;
  while(i<500){
    ev_teach(W,9000+i,77,i);
    i=i+1;
  }
  emit("T1 after pressure: live="); e64(live_count(W));
  emit(" maps="); e64(map_count(W)); emit("\n");
  // Census: which MAPs survived?
  m=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let root:i32=ng(W,m,20);
      let gok:i32=graph_ok(W,root);
      emit("T1 SURV MAP "); e64(m); emit(" U="); e64(ng(W,m,12));
      emit(" graph_ok="); e64(gok); emit("\n");
    }
    m=m+1;
  }
  emit("T1-FOSSIL-END\n");
  return;
}

// TEST 2: Zombie preemption.
// Heavy churn to cap, then census. Baseline: 3.8% zombies.
// Prediction: 0 zombie MAPs (atomic reclaim makes route impossible).
fn test_zombie(W:[]u8)void {
  emit("T2-ZOMBIE-START\n");
  // Promote MAPs first.
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  ev_teach(W,201,11,202); ev_teach(W,202,11,203); ev_teach(W,203,12,301);
  let a1:i32=ev_query(W,101,40,201,0);
  let a2:i32=ev_query(W,201,40,301,0);
  emit("T2 promoted maps="); e64(map_count(W)); emit("\n");
  // Heavy churn: 1050 teaches to hit cap.
  let i:i32=0;
  while(i<1050){
    ev_teach(W,8000+i,77,i);
    i=i+1;
  }
  emit("T2 after churn: live="); e64(live_count(W));
  emit(" maps="); e64(map_count(W)); emit("\n");
  // Census for zombies.
  let zombies:i32=0; let total_maps:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      total_maps=total_maps+1;
      if(map_is_zombie(W,m)==1){
        zombies=zombies+1;
        emit("T2 ZOMBIE MAP "); e64(m); emit("\n");
      }
    }
    m=m+1;
  }
  emit("T2 zombies="); e64(zombies); emit(" total_maps="); e64(total_maps); emit("\n");
  emit("T2-ZOMBIE-END\n");
  return;
}

// TEST 3: Use-protection (MAP 22 replay).
// The fossil census sharpest case: MAP referenced by revision (refs=2)
// still zombified. With U>0, the MAP's cells should be protected.
fn test_useprotect(W:[]u8)void {
  emit("T3-USEPROTECT-START\n");
  // Setup: chain A, promote MAP_A.
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  ev_teach(W,201,11,202); ev_teach(W,202,11,203); ev_teach(W,203,12,301);
  let a1:i32=ev_query(W,101,40,201,0);
  emit("T3 promoted a1="); e64(a1); emit(" maps="); e64(map_count(W)); emit("\n");
  // Find the MAP.
  let mp:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){mp=m;}
    m=m+1;
  }
  if(mp<0){emit("T3 NO-MAP\n"); return;}
  let root0:i32=ng(W,mp,20);
  let cells0:i32=graph_cells(W,root0);
  emit("T3 MAP "); e64(mp); emit(" U0="); e64(ng(W,mp,12));
  emit(" cells0="); e64(cells0); emit("\n");
  // Revision: contradict licensing fact, triggers t2_revise_graph.
  // This should set U+=1 on success (or U-=1 on failure).
  let d:i32=ev_observe(W,102,12,999);
  emit("T3 contradict d="); e64(d); emit("\n");
  emit("T3 MAP "); e64(mp); emit(" U_after_rev="); e64(ng(W,mp,12)); emit("\n");
  // Filler pressure.
  let i:i32=0;
  while(i<800){
    ev_teach(W,9000+i,77,i);
    i=i+1;
  }
  // Check: is MAP still live? Are cells intact?
  let alive:i32=0;
  if(ng(W,mp,36)==1 && ng(W,mp,0)==20){alive=1;}
  emit("T3 after pressure: alive="); e64(alive);
  emit(" live="); e64(live_count(W)); emit("\n");
  if(alive==1){
    let root1:i32=ng(W,mp,20);
    let gok:i32=graph_ok(W,root1);
    let cells1:i32=graph_cells(W,root1);
    emit("T3 MAP "); e64(mp); emit(" U="); e64(ng(W,mp,12));
    emit(" graph_ok="); e64(gok); emit(" cells="); e64(cells1); emit("\n");
    // Try re-execution.
    let out:i32=t2_exec(W,root1,101);
    emit("T3 reexec out="); e64(out); emit("\n");
  }
  emit("T3-USEPROTECT-END\n");
  return;
}

// TEST 5: Cost visibility. Utility writes are in-place field updates.
// Measure per-event node delta on query-hit (should be +0, same as base).
fn test_cost(W:[]u8)void {
  emit("T5-COST-START\n");
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let a1:i32=ev_query(W,101,40,201,0);
  // Query hit on shadow: measure node delta.
  let n0:i32=hg(W,20);
  let q:i32=ev_query(W,101,40,201,0);
  let dn:i32=hg(W,20)-n0;
  emit("T5 query-hit dn="); e64(dn); emit(" (expect 0, in-place U update)\n");
  // Check U incremented.
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      emit("T5 MAP "); e64(m); emit(" U="); e64(ng(W,m,12)); emit("\n");
    }
    m=m+1;
  }
  emit("T5-COST-END\n");
  return;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  test_fossil(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  test_zombie(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  test_useprotect(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4);
  test_cost(W4);
  emit("ALL-TESTS-DONE\n");
  return 0;
}

// ub_patch.zag -- Modified TNN-2 functions with utility signal.
// Unfrozen variant only. Base: ub_base.zag (frozen, SHA-256 a29972ca...).
// Design: utility_signal/UTILITY_SIGNAL.md (cd6a8a74a).
//
// Modified functions (verbatim replacements for base versions):
//   promote_graph: U=0/L=birth init, shadow f4=m, trial success U+=2
//   contradict_map: U-=2 (floor -8), L=now
//   ev_query: query-answer attribution via util_attr
//   revise_on_contradict: capture t2_revise_graph return, U+=1/-1
//   evict_node: ZOMBIE > FOSSIL > LIVE low-U > bid priority,
//               structure-atomic reclaim, cell protection
//
// Helpers in ub_util.zag: util_add, util_init, util_attr, map_is_zombie,
// map_is_fossil, map_is_live, cell_of_live_map, reclaim_map_atomic.

// promote_graph: verbatim base + utility init + shadow attribution + trial U+=2.
// Base sets f12=-1/f16=-1 (never read on tag-20); we repurpose per design 2.1.
// ev_teach_in returns shadow FACT id; we write f4=m (design 2.1).
// Trial success U+=2: promote_graph is only called on t2_try_verify success
// (4 call sites in t2_trial, all guarded by v2!=-2), so the +2 here is the
// trial-verification-success event from design 2.2.
fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s);
  // Utility init: U=0, L=birth tick (design 2.2, Promotion row).
  ns(W,m,12,0); ns(W,m,16,hg(W,0));
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  // Shadow FACT: capture id, write owning MAP in f4 (design 2.1).
  let sh:i32=ev_teach_in(W,s,r,ans);
  if(sh>=2 && sh<1024){ns(W,sh,4,m);}
  // Trial verification success: U+=2 (design 2.2). L updated by util_add.
  util_add(W,m,2);
  return m;
}

// contradict_map: verbatim base + U-=2 (floor -8), L=now.
// Design 2.2: Contradiction of licensing fact.
fn contradict_map(W:[]u8,m:i32)i32 {
  link_edge(W,m,3,m,0);
  util_add(W,m,-2);
  return 0;
}

// ev_query: verbatim base + util_attr on activate hit.
// Design 2.2: Query answered via shadow FACT -> U+=1 (guarded).
// util_attr checks f4 validity; ordinary FACT hits write nothing.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    util_attr(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// revise_on_contradict: verbatim base + U update from t2_revise_graph return.
// Design 2.2: Revision success -> U+=1; Revision failure -> U-=1 (floor -8).
// Closes the D1 discard: outcome was dropped, now recorded.
fn revise_on_contradict(W:[]u8,factn:i32,new_o:i32)void {
  let old_o:i32=ng(W,factn,28);
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let e:i32=0; let hit:i32=0;
      while(e<4096){
        if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1 && eg(W,e,8)==factn){hit=1;}
        e=e+1;
      }
      if(hit==1){
        let rr:i32=t2_revise_graph(W,m,factn,old_o,new_o);
        if(rr==1){util_add(W,m,1);} else {util_add(W,m,-1);}
      }
    }
    m=m+1;
  }
  return;
}

// evict_node: utility-aware victim selection.
// Priority (design 2.4, first match wins):
//   1. ZOMBIE: MAP with invalid/shared root -> atomic reclaim, U irrelevant.
//   2. FOSSIL: live MAP, valid root, U<=0, age>FOSSIL_AGE -> oldest first.
//   3. LIVE low-U: unified scan, MAPs by U asc, others by bid, skip live cells.
//   4. Bid fallback: integrated in pass 3 for non-utility nodes.
//
// Structure-atomic reclaim (design 2.4): MAP victims take their SEQ-walked
// cells in the same pass via reclaim_map_atomic. The shell-without-body
// zombie route becomes impossible, not rare.
// Structure-aware protection (design 2.4): graph cells (101-104) reachable
// from a LIVE MAP's root are skipped in the victim scan.
fn evict_node(W:[]u8)i32 {
  let now:i32=hg(W,0);
  let cur:i32=hg(W,8);
  // Pass 1: ZOMBIE MAPs. Immediate atomic reclaim.
  let m:i32=2;
  while(m<1024){
    if(map_is_zombie(W,m)==1){
      reclaim_map_atomic(W,m);
      let nc1:i32=m+1; if(nc1>=1024){nc1=2;} hs(W,8,nc1);
      return m;
    }
    m=m+1;
  }
  // Pass 2: FOSSIL MAPs. Oldest first, atomic reclaim.
  let best_f:i32=-1; let best_age:i32=-1;
  m=2;
  while(m<1024){
    if(map_is_fossil(W,m,now)==1){
      let age:i32=now-ng(W,m,16);
      if(age>best_age){best_age=age; best_f=m;}
    }
    m=m+1;
  }
  if(best_f>=0){
    reclaim_map_atomic(W,best_f);
    let nc2:i32=best_f+1; if(nc2>=1024){nc2=2;} hs(W,8,nc2);
    return best_f;
  }
  // Pass 3: Unified scan. MAPs ordered by U ascending; non-MAPs by bid.
  // Cells of LIVE MAPs are skipped (structure-aware protection).
  // Ties broken oldest-first (existing tiebreak preserved via scan order).
  let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let t:i32=ng(W,n,0);
      let skip:i32=0;
      // Structure-aware cell protection (design 2.4).
      if(t==101 || t==102 || t==103 || t==104){
        if(cell_of_live_map(W,n,now)==1){skip=1;}
      }
      // Zombies of non-MAP kind: dead structure, reclaim first.
      // (MAP zombies handled in pass 1; this covers orphaned cells.)
      if(skip==0){
        let b:i32=0;
        if(t==20){
          // MAP: use U for ordering. U in [-8,127]; lower = evict first.
          // Non-live MAPs (should be none here; zombies/fossils handled
          // above) fall back to bid.
          if(map_is_live(W,n,now)==1){b=ng(W,n,12);}
          else {b=bid(W,n);}
        } else {
          // Non-MAP: bid fallback (design 2.4, step 4).
          b=bid(W,n);
        }
        if(b<bb){bb=b; best=n;}
      }
    }
    i=i+1;
  }
  if(best<0){return -1;}
  // Reclaim: atomic for MAPs, standard for others.
  if(ng(W,best,0)==20){
    reclaim_map_atomic(W,best);
  } else {
    rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
    let e:i32=0;
    while(e<4096){
      if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
        es(W,e,0,-1); hs(W,24,hg(W,24)-1);
      }
      e=e+1;
    }
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

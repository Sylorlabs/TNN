// bc_blindmain.zag -- COMPOSE-BACKCHAIN-1 blind battery driver.
// Five Q1 variants (V0..V4) as separate fresh processes; each prints
// only the blind summary lines. Summaries must be byte-identical.

fn vans(S:[]u8,A:[]u8,r:i32) i32 {
  if(r<0){ return -999; }
  return demand(S,A,r);
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let v:i32=0;
  while(v<5){
    let A:[]u8=z_alloc(8192);
    let S:[]u8=z_alloc(41943040);
    w_blind(A,v);
    let r:i32=solve(S,A,0,4,blind_s(v),blind_kin(v),blind_kout(v),5);
    let ans:i32=vans(S,A,r);
    let p:i32=0;
    if(ans==5){ p=1; } else { p=0; }
    if(sg(S,4)!=7){ p=0; }
    if(sg(S,8)!=0){ p=0; }
    c=o_app(B,c,"PROB=BLIND");
    c=o_i64(B,c,v as i64);
    c=o_nl(B,c);
    c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
    c=o_app(B,c,"TRIES="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
    c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
    c=o_app(B,c,"VERDICT=");
    if(p==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
    c=o_nl(B,c);
    v=v+1;
  }
  o_flush(B,c);
  return 0;
}

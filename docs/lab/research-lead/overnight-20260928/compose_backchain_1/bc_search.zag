// bc_search.zag -- BACKCHAIN: lazy chronological backtracking over
// derivation trees, with INTERLEAVED execution.
//
// An occurrence frame solves one need occurrence (need = kind mask;
// the goal input s is fixed per goal). occ_next returns the frame's
// next non--2 solution thunk, or -1 when exhausted. Every candidate
// derivation is executed IMMEDIATELY upon construction (do_cand);
// -2 outcomes are skipped, never yielded. End-to-end failure at the
// root resumes the search (chronological backtracking).
//
// Loop guard (PREREG 1.3, amended): a (need-kind, producer-id) pair
// already on the open-need stack fails that producer choice
// entirely. Backup: DMAX=16 path depth.
//
// Enumeration order (frozen): producer id order; direct-close before
// sub-need alternatives; 2-input legs leg1-outer/leg2-inner, with a
// fresh leg2 occurrence per leg1 solution.

// producer choice ok: kind-compatible output and passes loop guard.
// Hoisted out of occ_next to keep nesting shallow.
fn prod_ok(S:[]u8,A:[]u8,occ:i32,K:i32,mi:i32) i32 {
  if(khas_rel(S,mg(A,mi,3),K)==0){ return 0; }
  let u:i32=occ;
  while(u>=0){
    if(of(S,u,2)==mi){
      if(of(S,u,0)==K){ return 0; }
    }
    u=of(S,u,7);
  }
  return 1;
}
fn occ_new(S:[]u8,K:i32,base:i32,parent:i32) i32 {
  let n:i32=sg(S,28);
  if(n>=1200000){ return -1; }
  let d:i32=0;
  let u:i32=parent;
  while(u>=0){ d=d+1; u=of(S,u,7); }
  if(d>=16){ return -1; }
  of_set(S,n,0,K); of_set(S,n,1,base); of_set(S,n,2,-1);
  of_set(S,n,3,0); of_set(S,n,4,-1); of_set(S,n,5,-1);
  of_set(S,n,6,-1); of_set(S,n,7,parent);
  sp(S,28,n+1);
  return n;
}
// do_cand: execute a completed candidate derivation immediately.
// Records e1 (F-A-INT): exec_total right after the first candidate
// is executed -- evidence that search and execution interleave.
fn do_cand(S:[]u8,A:[]u8,t:i32) i32 {
  let v:i32=demand(S,A,t);
  if(sg(S,16)==0){
    sp(S,16,1);
    sp(S,20,sg(S,4));
  }
  return v;
}
fn occ_next(S:[]u8,A:[]u8,base:i32,nm:i32,kin:i32,occ:i32) i32 {
  let C:i32=sg(S,24);
  while(1==1){
    let K:i32=of(S,occ,0);
    let m:i32=of(S,occ,2);
    let stage:i32=of(S,occ,3);
    if(m<0){
      let mi:i32=of(S,occ,1);
      let found:i32=-1;
      let scanning:i32=1;
      while(scanning==1){
        if(mi>=base+nm){ scanning=0; }
        else {
          if(prod_ok(S,A,occ,K,mi)==1){ found=mi; scanning=0; }
          else { mi=mi+1; }
        }
      }
      if(found<0){ return -1; }
      of_set(S,occ,1,found+1);
      of_set(S,occ,2,found);
      of_set(S,occ,4,-1);
      of_set(S,occ,5,-1);
      of_set(S,occ,6,-1);
      let ar:i32=mg(A,found,6);
      if(ar==1){
        if(khas_rel(S,mg(A,found,2),kin)==1){ of_set(S,occ,3,0); }
        else { of_set(S,occ,3,1); }
      } else {
        of_set(S,occ,3,1);
      }
    } else {
      if(mg(A,m,6)==1){
        if(stage==0){
          of_set(S,occ,3,1);
          let t:i32=app1(S,A,m,C);
          if(t>=0){
            if(do_cand(S,A,t)!=-2){ return t; }
          }
        } else {
          let ch:i32=of(S,occ,4);
          if(ch<0){
            ch=occ_new(S,mg(A,m,2),base,occ);
            of_set(S,occ,4,ch);
          }
          if(ch<0){ of_set(S,occ,2,-1); }
          else {
            let ts:i32=occ_next(S,A,base,nm,kin,ch);
            if(ts<0){ of_set(S,occ,2,-1); }
            else {
              let t:i32=app1(S,A,m,ts);
              if(t>=0){
                if(do_cand(S,A,t)!=-2){ return t; }
              }
            }
          }
        }
      } else {
        if(stage==1){
          let ch:i32=of(S,occ,4);
          if(ch<0){
            ch=occ_new(S,mg(A,m,4),base,occ);
            of_set(S,occ,4,ch);
          }
          if(ch<0){ of_set(S,occ,2,-1); }
          else {
            let p:i32=occ_next(S,A,base,nm,kin,ch);
            if(p<0){ of_set(S,occ,2,-1); }
            else {
              of_set(S,occ,6,p);
              of_set(S,occ,3,2);
              of_set(S,occ,5,-1);
            }
          }
        } else {
          let ch2:i32=of(S,occ,5);
          if(ch2<0){
            ch2=occ_new(S,mg(A,m,5),base,occ);
            of_set(S,occ,5,ch2);
          }
          if(ch2<0){ of_set(S,occ,3,1); }
          else {
            let q:i32=occ_next(S,A,base,nm,kin,ch2);
            if(q<0){ of_set(S,occ,3,1); }
            else {
              let t:i32=app2(S,A,m,of(S,occ,6),q);
              if(t>=0){
                if(do_cand(S,A,t)!=-2){ return t; }
              }
            }
          }
        }
      }
    }
  }
  return -1;
}
// solve: regress from the goal; on exhaustive failure fire the
// one-shot widen pass (relaxed kind matching), then report -2.
fn solve(S:[]u8,A:[]u8,base:i32,nm:i32,s:i32,kin:i32,kout:i32,exp:i32) i32 {
  sp(S,24,const_thunk(S,s,kin));
  sp(S,28,0);
  let root:i32=occ_new(S,kout,base,-1);
  let ans:i32=-2;
  let searching:i32=1;
  while(searching==1){
    let t:i32=occ_next(S,A,base,nm,kin,root);
    if(t<0){ searching=0; }
    else {
      if(demand(S,A,t)==exp){ ans=t; searching=0; }
    }
  }
  if(ans<0){
    sp(S,12,1);
    sp(S,8,1);
    sp(S,28,0);
    root=occ_new(S,kout,base,-1);
    searching=1;
    while(searching==1){
      let t:i32=occ_next(S,A,base,nm,kin,root);
      if(t<0){ searching=0; }
      else {
        if(demand(S,A,t)==exp){ ans=t; searching=0; }
      }
    }
  }
  return ans;
}

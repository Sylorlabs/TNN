// adv_synergy.zag -- Attack A3: independent synergy reimplementation.
// Written fresh from the frozen functional descriptions in PREREG_DEVINT1.md
// (commit 4b50ff7d4). Own buffer layout, own function decomposition and
// naming; no builder code copied. Same frozen episode corpora.
// Measures on one continuous learner run:
//   (a) procedure examples-to-criterion: concept-ID treatment vs raw-string control
//   (b) post-eviction probe accuracy on 10 held-out episodes:
//       importance eviction vs LRU eviction
//   (c) refinement count: split-on-contradiction vs delete-only
// Pure Zag. No Python.
//
// Learner state (separate buffers, not one arena):
//   st   16B: 0 tick, 4 totsegs, 8 evict_treat, 12 evict_ctrl
//   lx   256x12B substring lexicon: 0..3 bytes, 4 len, 8 count
//   cx   24x32B concepts: 0 id, 4 plen, 8 count, 12 last, 16 valid, 20..27 pattern
//   cxM  24x32B mirror concepts (S10 control apparatus)
//   cxS  24x32B concept snapshot at S7 end (S8/S9 control apparatus)
//   rl   32x32B rules: 0 from, 4 to, 8 sup, 12 ref, 16 state, 20 last, 24 uses, 28 pend
//   rlM  32x32B mirror rules, LRU policy (S10 control apparatus)
//   pt   24x8B treatment pairing: 0 in_id, 4 out_id (init -1)
//   pc   24x24B control pairing: 0..7 key, 8 keylen, 12..19 out, 20 outlen
//   sp   4x32B split candidates: 0..7 h1, 8 h1len, 12..19 h2, 20 h2len, 24 c1, 28 c2

fn newbuf(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8 = _zag_malloc(n) as *u8;
  if(p == null as *u8){ return ""; }
  let b:[]u8 = p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn out(s:[]u8)void { _zag_print(s); return; }
fn outi(v:i32)void { out(_zag_i64_to_str(v as i64)); return; }
fn rd(b:[]u8, o:i32)i32 {
  return (b[o] as i32) | ((b[o+1] as i32)<<8) | ((b[o+2] as i32)<<16) | ((b[o+3] as i32)<<24);
}
fn wr(b:[]u8, o:i32, v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn beq(a:[]u8, ao:i32, b:[]u8, bo:i32, n:i32)i32 {
  let k:i32=0;
  while(k<n){ if(a[ao+k]!=b[bo+k]){ return 0; } k=k+1; }
  return 1;
}
fn ilog2(v:i32)i32 {
  let r:i32=0; let p:i32=1;
  while(p*2<=v){ p=p*2; r=r+1; }
  return r;
}

// ---------- lexicon: substring counts, lengths 2..4 ----------
fn lx_cnt(lx:[]u8, s:[]u8, o:i32, n:i32)i32 {
  let e:i32=0;
  while(e<256){
    let el:i32=rd(lx,e*12+4);
    if(el==0){ return 0; }
    if(el==n && beq(lx,e*12,s,o,n)==1){ return rd(lx,e*12+8); }
    e=e+1;
  }
  return 0;
}
fn lx_add(lx:[]u8, s:[]u8, o:i32, n:i32)void {
  let e:i32=0;
  while(e<256){
    let el:i32=rd(lx,e*12+4);
    if(el==0){
      let k:i32=0; while(k<n){ lx[e*12+k]=s[o+k]; k=k+1; }
      wr(lx,e*12+4,n); wr(lx,e*12+8,1);
      return;
    }
    if(el==n && beq(lx,e*12,s,o,n)==1){ wr(lx,e*12+8,rd(lx,e*12+8)+1); return; }
    e=e+1;
  }
  return;
}
fn lx_feed(lx:[]u8, s:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let L:i32=2;
    while(L<=4){ if(i+L<=n){ lx_add(lx,s,i,L); } L=L+1; }
    i=i+1;
  }
  return;
}

// ---------- segmentation: DP over len*ilog(count+1), ties prefer longer ----------
fn segw(lx:[]u8, s:[]u8, o:i32, L:i32)i32 {
  if(L==1){ return 0; }
  return L*ilog2(lx_cnt(lx,s,o,L)+1);
}
fn doseg(lx:[]u8, s:[]u8, n:i32, so:[]u8, sl:[]u8)i32 {
  let dp:[]u8=newbuf(13*4); let ch:[]u8=newbuf(13*4);
  wr(dp,0,0);
  let i:i32=1;
  while(i<=n){
    let best:i32=-1; let bl:i32=1; let L:i32=4;
    while(L>=1){
      if(L<=i){
        let sc:i32=rd(dp,(i-L)*4)+segw(lx,s,i-L,L);
        if(sc>best){ best=sc; bl=L; }
      }
      L=L-1;
    }
    wr(dp,i*4,best); wr(ch,i*4,bl);
    i=i+1;
  }
  let ns:i32=0; let j:i32=n;
  while(j>0){
    let L:i32=rd(ch,j*4);
    wr(so,(ns)*4,j-L); wr(sl,(ns)*4,L);
    ns=ns+1; j=j-L;
  }
  let a:i32=0; let b2:i32=ns-1;
  while(a<b2){
    let t1:i32=rd(so,a*4); let t2:i32=rd(sl,a*4);
    wr(so,a*4,rd(so,b2*4)); wr(sl,a*4,rd(sl,b2*4));
    wr(so,b2*4,t1); wr(sl,b2*4,t2);
    a=a+1; b2=b2-1;
  }
  return ns;
}

// ---------- concepts ----------
fn cx_touch(cx:[]u8, s:[]u8, o:i32, n:i32, t:i32)i32 {
  let e:i32=0;
  while(e<24){
    if(rd(cx,e*32+16)==1 && rd(cx,e*32+4)==n && beq(cx,e*32+20,s,o,n)==1){
      wr(cx,e*32+8,rd(cx,e*32+8)+1); wr(cx,e*32+12,t);
      return rd(cx,e*32);
    }
    e=e+1;
  }
  e=0;
  while(e<24){
    if(rd(cx,e*32+16)==0){
      let k:i32=0; while(k<n){ cx[e*32+20+k]=s[o+k]; k=k+1; }
      wr(cx,e*32,e); wr(cx,e*32+4,n);
      wr(cx,e*32+8,1); wr(cx,e*32+12,t); wr(cx,e*32+16,1);
      return e;
    }
    e=e+1;
  }
  return -1;
}
fn cx_find(cx:[]u8, s:[]u8, o:i32, n:i32)i32 {
  let e:i32=0;
  while(e<24){
    if(rd(cx,e*32+16)==1 && rd(cx,e*32+4)==n && beq(cx,e*32+20,s,o,n)==1){ return rd(cx,e*32); }
    e=e+1;
  }
  return -1;
}
fn cx_recog(cx:[]u8, s:[]u8, o:i32, n:i32)i32 {
  let ex:i32=cx_find(cx,s,o,n);
  if(ex>=0){ return ex; }
  let best:i32=-1; let nm:i32=0; let e:i32=0;
  while(e<24){
    if(rd(cx,e*32+16)==1 && rd(cx,e*32+4)==n){
      let d:i32=0; let k:i32=0;
      while(k<n){ if(cx[e*32+20+k]!=s[o+k]){ d=d+1; } k=k+1; }
      if(d==1){ best=rd(cx,e*32); nm=nm+1; }
    }
    e=e+1;
  }
  if(nm==1){ return best; }
  return -1;
}
fn cx_copy(dst:[]u8, src:[]u8)void {
  let i:i32=0; while(i<768){ dst[i]=src[i]; i=i+1; }
  return;
}
fn cx_killpat(cx:[]u8, p:[]u8, n:i32)void {
  let e:i32=0;
  while(e<24){
    if(rd(cx,e*32+16)==1 && rd(cx,e*32+4)==n && beq(cx,e*32+20,p,0,n)==1){ wr(cx,e*32+16,0); }
    e=e+1;
  }
  return;
}

// ---------- rules ----------
fn rl_n(r:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<32){ if(rd(r,e*32+8)>0){ n=n+1; } e=e+1; }
  return n;
}
fn rl_add(r:[]u8, e:i32, from:i32, to:i32, t:i32)void {
  wr(r,e*32,from); wr(r,e*32+4,to); wr(r,e*32+8,1); wr(r,e*32+12,0);
  wr(r,e*32+16,0); wr(r,e*32+20,t); wr(r,e*32+24,1); wr(r,e*32+28,0);
  return;
}
fn rl_touch(r:[]u8, from:i32, to:i32, t:i32, pol:i32, st:[]u8, evo:i32)void {
  let e:i32=0;
  while(e<32){
    if(rd(r,e*32+8)>0 && rd(r,e*32)==from && rd(r,e*32+4)==to){
      wr(r,e*32+8,rd(r,e*32+8)+1); wr(r,e*32+20,t); wr(r,e*32+24,rd(r,e*32+24)+1);
      if(rd(r,e*32+16)==0 && rd(r,e*32+8)>=3 && rd(r,e*32+12)==0){ wr(r,e*32+16,1); }
      return;
    }
    e=e+1;
  }
  if(rl_n(r)<20){
    e=0;
    while(e<32){ if(rd(r,e*32+8)==0){ rl_add(r,e,from,to,t); return; } e=e+1; }
    return;
  }
  let best:i32=-1; let bk:i32=0; let f:i32=1;
  e=0;
  while(e<32){
    if(rd(r,e*32+8)>0){
      let k:i32=0;
      if(pol==0){ k=rd(r,e*32+8); } else { k=rd(r,e*32+20); }
      if(f==1){ best=e; bk=k; f=0; }
      else { if(k<bk){ best=e; bk=k; } }
    }
    e=e+1;
  }
  if(best<0){ return; }
  wr(st,evo,rd(st,evo)+1);
  rl_add(r,best,from,to,t);
  return;
}
fn rl_pred(r:[]u8, from:i32)i32 {
  let best:i32=-1; let bs:i32=0; let e:i32=0;
  while(e<32){
    if(rd(r,e*32+8)>0 && rd(r,e*32)==from && rd(r,e*32+16)==1){
      let s:i32=rd(r,e*32+8);
      if(s>bs){ bs=s; best=rd(r,e*32+4); }
    }
    e=e+1;
  }
  return best;
}
fn rl_get(r:[]u8, from:i32, to:i32)i32 {
  let e:i32=0;
  while(e<32){
    if(rd(r,e*32+8)>0 && rd(r,e*32)==from && rd(r,e*32+4)==to){ return e; }
    e=e+1;
  }
  return -1;
}
fn rl_revise(r:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<32){
    if(rd(r,e*32+8)>0){
      let pd:i32=rd(r,e*32+28); let q:i32=rd(r,e*32+16);
      if(q==1 && pd>=1){ wr(r,e*32+16,0); n=n+1; }
      if(pd>=2){ wr(r,e*32+16,2); }
    }
    e=e+1;
  }
  return n;
}

// ---------- episode processing: the continuous learner core ----------
fn feed(st:[]u8, lx:[]u8, cx:[]u8, rl:[]u8, cxM:[]u8, rlM:[]u8, s:[]u8, n:i32, mirror:i32)void {
  let t:i32=rd(st,0)+1; wr(st,0,t);
  lx_feed(lx,s,n);
  let so:[]u8=newbuf(12*4); let sl:[]u8=newbuf(12*4);
  let ns:i32=doseg(lx,s,n,so,sl);
  wr(st,4,rd(st,4)+ns);
  let ids:[]u8=newbuf(12*4);
  let k:i32=0;
  while(k<ns){
    let id:i32=cx_touch(cx,s,rd(so,k*4),rd(sl,k*4),t);
    wr(ids,k*4,id);
    if(mirror==1){ cx_touch(cxM,s,rd(so,k*4),rd(sl,k*4),t); }
    k=k+1;
  }
  k=0;
  while(k+1<ns){
    let a:i32=rd(ids,k*4); let b:i32=rd(ids,(k+1)*4);
    if(a>=0 && b>=0){
      rl_touch(rl,a,b,t,0,st,8);
      if(mirror==1){ rl_touch(rlM,a,b,t,1,st,12); }
    }
    k=k+1;
  }
  return;
}

// ---------- procedure learning ----------
// treatment: pairing table over concept IDs
fn pt_learn(cx:[]u8, pt:[]u8, ins:[]u8, outs:[]u8)void {
  let iid:i32=cx_recog(cx,ins,0,3); let oid:i32=cx_recog(cx,outs,0,3);
  if(iid<0 || oid<0){ return; }
  let e:i32=0;
  while(e<24){ if(rd(pt,e*8)==iid){ wr(pt,e*8+4,oid); return; } e=e+1; }
  e=0;
  while(e<24){ if(rd(pt,e*8)==-1){ wr(pt,e*8,iid); wr(pt,e*8+4,oid); return; } e=e+1; }
  return;
}
fn pt_test(cx:[]u8, pt:[]u8, ins:[]u8, il:i32, outs:[]u8, ol:i32)i32 {
  if(il!=ol){ return 0; }
  let p:i32=0;
  while(p<il){
    let iid:i32=cx_recog(cx,ins,p,3); let want:i32=cx_recog(cx,outs,p,3);
    if(iid<0 || want<0){ return 0; }
    let got:i32=-2; let e:i32=0;
    while(e<24){ if(rd(pt,e*8)==iid){ got=rd(pt,e*8+4); } e=e+1; }
    if(got!=want){ return 0; }
    p=p+3;
  }
  return 1;
}
// control: pairing table over raw 3-char keys
fn pc_learn(pc:[]u8, k:[]u8, ko:i32, o:[]u8, oo:i32)void {
  let e:i32=0;
  while(e<24){
    if(rd(pc,e*24+8)==3 && beq(pc,e*24,k,ko,3)==1){
      let j:i32=0; while(j<3){ pc[e*24+12+j]=o[oo+j]; j=j+1; }
      wr(pc,e*24+20,3); return;
    }
    e=e+1;
  }
  e=0;
  while(e<24){
    if(rd(pc,e*24+8)==0){
      let j:i32=0; while(j<3){ pc[e*24+j]=k[ko+j]; j=j+1; }
      wr(pc,e*24+8,3);
      j=0; while(j<3){ pc[e*24+12+j]=o[oo+j]; j=j+1; }
      wr(pc,e*24+20,3); return;
    }
    e=e+1;
  }
  return;
}
fn pc_test(pc:[]u8, ins:[]u8, il:i32, outs:[]u8, ol:i32)i32 {
  if(il!=ol){ return 0; }
  let p:i32=0;
  while(p<il){
    let got:i32=-1; let e:i32=0;
    while(e<24){
      if(rd(pc,e*24+8)==3 && beq(pc,e*24,ins,p,3)==1){ got=e; }
      e=e+1;
    }
    if(got<0){ return 0; }
    if(rd(pc,got*24+20)!=3){ return 0; }
    let j:i32=0;
    while(j<3){ if(pc[got*24+12+j]!=outs[p+j]){ return 0; } j=j+1; }
    p=p+3;
  }
  return 1;
}
fn heldT(cx:[]u8, pt:[]u8)i32 {
  let c:i32=0;
  c=c+pt_test(cx,pt,"bik",3,"zol",3);
  c=c+pt_test(cx,pt,"tav",3,"gup",3);
  c=c+pt_test(cx,pt,"biktav",6,"zolgup",6);
  c=c+pt_test(cx,pt,"gupzol",6,"tavbik",6);
  c=c+pt_test(cx,pt,"zolbikguptav",12,"bikzoltavgup",12);
  return c;
}
fn heldC(pc:[]u8)i32 {
  let c:i32=0;
  c=c+pc_test(pc,"bik",3,"zol",3);
  c=c+pc_test(pc,"tav",3,"gup",3);
  c=c+pc_test(pc,"biktav",6,"zolgup",6);
  c=c+pc_test(pc,"gupzol",6,"tavbik",6);
  c=c+pc_test(pc,"zolbikguptav",12,"bikzoltavgup",12);
  return c;
}

// ---------- contradiction / boundary / revision ----------
fn contradictions(lx:[]u8, cx:[]u8, rl:[]u8, rlM:[]u8, s:[]u8, n:i32)i32 {
  let so:[]u8=newbuf(12*4); let sl:[]u8=newbuf(12*4);
  let ns:i32=doseg(lx,s,n,so,sl);
  let ids:[]u8=newbuf(12*4);
  let k:i32=0;
  while(k<ns){ wr(ids,k*4,cx_find(cx,s,rd(so,k*4),rd(sl,k*4))); k=k+1; }
  let nev:i32=0; k=0;
  while(k+1<ns){
    let a:i32=rd(ids,k*4); let b:i32=rd(ids,(k+1)*4);
    if(a>=0 && b>=0){
      let pr:i32=rl_pred(rl,a);
      if(pr>=0 && pr!=b){
        let e:i32=rl_get(rl,a,pr);
        if(e>=0){
          wr(rl,e*32+28,rd(rl,e*32+28)+1);
          let se:i32=rl_get(rlM,a,pr);
          if(se>=0){ wr(rlM,se*32+28,rd(rlM,se*32+28)+1); }
          nev=nev+1;
        }
      }
    }
    k=k+1;
  }
  return nev;
}
fn substr(s:[]u8, n:i32, p:[]u8, po:i32, m:i32)i32 {
  if(m>n){ return 0; }
  let i:i32=0;
  while(i+m<=n){
    if(beq(s,i,p,po,m)==1){ return 1; }
    i=i+1;
  }
  return 0;
}
fn bound_viol(cx:[]u8, s:[]u8, n:i32, logc:[]u8, base:i32)i32 {
  let nev:i32=0; let e:i32=0;
  while(e<24){
    if(rd(cx,e*32+16)==1 && rd(cx,e*32+8)>=2){
      let m:i32=rd(cx,e*32+4);
      if(substr(s,n,cx,e*32+20,m)==0){
        let i:i32=0;
        while(i+m<=n){
          let d:i32=0; let k:i32=0;
          while(k<m){ if(s[i+k]!=cx[e*32+20+k]){ d=d+1; } k=k+1; }
          if(d==1){ nev=nev+1; logc[base+nev-1]=rd(cx,e*32) as u8; i=n; }
          i=i+1;
        }
      }
    }
    e=e+1;
  }
  return nev;
}

// ---------- split refinement ----------
fn split_init(cx:[]u8, sp:[]u8, logc:[]u8, nv:i32)i32 {
  let c:i32=0; let v:i32=0;
  while(v<nv && c<4){
    let cid:i32=logc[v] as i32;
    let e:i32=0;
    while(e<24){
      if(rd(cx,e*32)==cid && rd(cx,e*32+16)==1){
        let m:i32=rd(cx,e*32+4);
        let q:i32=1;
        while(q<m && c<4){
          let j:i32=0;
          while(j<q){ sp[c*32+j]=cx[e*32+20+j]; j=j+1; }
          wr(sp,c*32+8,q);
          j=0;
          while(j<m-q){ sp[c*32+12+j]=cx[e*32+20+q+j]; j=j+1; }
          wr(sp,c*32+20,m-q);
          wr(sp,c*32+24,0); wr(sp,c*32+28,0);
          c=c+1; q=q+1;
        }
      }
      e=e+1;
    }
    v=v+1;
  }
  return c;
}
fn split_count(lx:[]u8, sp:[]u8, s:[]u8, n:i32)void {
  let so:[]u8=newbuf(12*4); let sl:[]u8=newbuf(12*4);
  let ns:i32=doseg(lx,s,n,so,sl);
  let c:i32=0;
  while(c<4){
    let h1l:i32=rd(sp,c*32+8);
    if(h1l>0){
      let h2l:i32=rd(sp,c*32+20);
      let k:i32=0;
      while(k<ns){
        let q:i32=rd(so,k*4); let l:i32=rd(sl,k*4);
        if(l==h1l && beq(s,q,sp,c*32,h1l)==1){ wr(sp,c*32+24,rd(sp,c*32+24)+1); }
        if(l==h2l && beq(s,q,sp,c*32+12,h2l)==1){ wr(sp,c*32+28,rd(sp,c*32+28)+1); }
        k=k+1;
      }
    }
    c=c+1;
  }
  return;
}
fn split_eval(cx:[]u8, sp:[]u8)i32 {
  let ref:i32=0; let c:i32=0;
  while(c<4){
    let h1l:i32=rd(sp,c*32+8);
    if(h1l>0){
      let h2l:i32=rd(sp,c*32+20);
      if(rd(sp,c*32+24)>=2 && rd(sp,c*32+28)>=2){
        let e:i32=0;
        while(e<24){
          if(rd(cx,e*32+16)==1 && rd(cx,e*32+4)==h1l+h2l){
            if(beq(cx,e*32+20,sp,c*32,h1l)==1 && beq(cx,e*32+20+h1l,sp,c*32+12,h2l)==1){
              wr(cx,e*32+16,0); ref=ref+1;
            }
          }
          e=e+1;
        }
      }
    }
    c=c+1;
  }
  return ref;
}

// ---------- probe / recognition accuracy ----------
fn acc_one(lx:[]u8, rl:[]u8, cx:[]u8, s:[]u8, n:i32, tot:[]u8)i32 {
  let so:[]u8=newbuf(12*4); let sl:[]u8=newbuf(12*4);
  let ns:i32=doseg(lx,s,n,so,sl);
  let c:i32=0; let k:i32=0;
  while(k+1<ns){
    let a:i32=cx_find(cx,s,rd(so,k*4),rd(sl,k*4));
    let b:i32=cx_find(cx,s,rd(so,(k+1)*4),rd(sl,(k+1)*4));
    if(a>=0 && b>=0){ tot[0]=tot[0]+1; if(rl_pred(rl,a)==b){ c=c+1; } }
    k=k+1;
  }
  return c;
}
fn probe_one(lx:[]u8, rl:[]u8, cx:[]u8, s:[]u8, n:i32, tot:[]u8)i32 {
  return acc_one(lx,rl,cx,s,n,tot);
}
fn is_true3(s:[]u8, o:i32)i32 {
  if(beq(s,o,"bik",0,3)==1){ return 1; }
  if(beq(s,o,"gup",0,3)==1){ return 1; }
  if(beq(s,o,"zol",0,3)==1){ return 1; }
  if(beq(s,o,"tav",0,3)==1){ return 1; }
  return 0;
}
fn recog_one(lx:[]u8, s:[]u8, n:i32, acc:[]u8)i32 {
  let so:[]u8=newbuf(12*4); let sl:[]u8=newbuf(12*4);
  let ns:i32=doseg(lx,s,n,so,sl);
  let c:i32=0; let k:i32=0;
  while(k<ns){
    acc[0]=acc[0]+1;
    if(rd(sl,k*4)==3 && is_true3(s,rd(so,k*4))==1){ c=c+1; }
    k=k+1;
  }
  return c;
}

// ---------- frozen episode corpora ----------
fn s1_ep(i:i32)[]u8 {
  if(i==0){return "bikgup";} if(i==1){return "gupzol";}
  if(i==2){return "bikguptav";} if(i==3){return "zolbik";}
  if(i==4){return "tavgupbik";} if(i==5){return "bikgupzol";}
  if(i==6){return "guptav";} if(i==7){return "bikgup";}
  if(i==8){return "zoltav";} if(i==9){return "tavbikgup";}
  if(i==10){return "gupzoltav";} return "bikgup";
}
fn s1_len(i:i32)i32 {
  if(i==0){return 6;} if(i==1){return 6;} if(i==2){return 9;}
  if(i==3){return 6;} if(i==4){return 9;} if(i==5){return 9;}
  if(i==6){return 6;} if(i==7){return 6;} if(i==8){return 6;}
  if(i==9){return 9;} if(i==10){return 9;} return 6;
}
fn s2_ep(i:i32)[]u8 {
  if(i==0){return "zolgupbik";} if(i==1){return "tavzoltav";}
  if(i==2){return "gupbikzol";} if(i==3){return "biktav";}
  if(i==4){return "zolgup";} return "tavgupzol";
}
fn s2_len(i:i32)i32 {
  if(i==0){return 9;} if(i==1){return 9;} if(i==2){return 9;}
  if(i==3){return 6;} if(i==4){return 6;} return 9;
}
fn s10_ep(i:i32)[]u8 {
  if(i==0){return "tavwex";} if(i==1){return "wexgup";}
  if(i==2){return "guptav";} if(i==3){return "qivbix";}
  if(i==4){return "bixqiv";} if(i==5){return "zoltav";}
  if(i==6){return "vumzol";} if(i==7){return "zolvum";}
  if(i==8){return "jadtav";} if(i==9){return "tavjad";}
  if(i==10){return "wexqiv";} if(i==11){return "qivwex";}
  if(i==12){return "ktavvum";} if(i==13){return "kzolvum";}
  if(i==14){return "gupjad";} if(i==15){return "jadzol";}
  if(i==16){return "zolgup";} if(i==17){return "tavbik";}
  if(i==18){return "wexvumjad";} return "qivgupvum";
}
fn s10_len(i:i32)i32 {
  if(i==12){return 7;} if(i==13){return 7;}
  if(i==18){return 9;} if(i==19){return 9;} return 6;
}
fn s11_ep(i:i32)[]u8 {
  if(i==0){return "tavbikzol";} if(i==1){return "zolguptav";}
  if(i==2){return "biktav";} if(i==3){return "gupzoltavbik";}
  if(i==4){return "tavgup";} return "zoltavbik";
}
fn s11_len(i:i32)i32 {
  if(i==0){return 9;} if(i==1){return 9;} if(i==2){return 6;}
  if(i==3){return 12;} if(i==4){return 6;} return 9;
}
fn probe_ep(i:i32)[]u8 {
  if(i==0){return "bikzol";} if(i==1){return "gupzol";}
  if(i==2){return "gupbik";} if(i==3){return "bikzol";}
  if(i==4){return "gupzol";} if(i==5){return "gupbik";}
  if(i==6){return "bikzol";} if(i==7){return "gupbikzol";}
  if(i==8){return "gupzol";} return "gupbikzol";
}
fn probe_len(i:i32)i32 {
  if(i==7){return 9;} if(i==9){return 9;} return 6;
}

fn main()i32 {
  out("=== A3: independent synergy reimplementation ===\n");
  let st:[]u8=newbuf(16);
  let lx:[]u8=newbuf(256*12);
  let cx:[]u8=newbuf(24*32); let cxM:[]u8=newbuf(24*32); let cxS:[]u8=newbuf(24*32);
  let rl:[]u8=newbuf(32*32); let rlM:[]u8=newbuf(32*32);
  let pt:[]u8=newbuf(24*8); let pc:[]u8=newbuf(24*24);
  let sp:[]u8=newbuf(4*32);
  let e:i32=0;
  while(e<24){ wr(pt,e*8,-1); wr(pt,e*8+4,-1); e=e+1; }

  // S1 raw exposure: lexicon from all 12, then segment with full lexicon
  let i:i32=0;
  while(i<12){ lx_feed(lx,s1_ep(i),s1_len(i)); i=i+1; }
  i=0;
  while(i<12){ feed(st,lx,cx,rl,cxM,rlM,s1_ep(i),s1_len(i),1); i=i+1; }
  // S2: 6 new episodes through the learner
  i=0;
  while(i<6){ feed(st,lx,cx,rl,cxM,rlM,s2_ep(i),s2_len(i),1); i=i+1; }

  // (a) procedure examples-to-criterion
  let nt:i32=0;
  pt_learn(cx,pt,"bix","zol"); if(heldT(cx,pt)==5){ nt=1; }
  if(nt==0){ pt_learn(cx,pt,"gup","tav"); if(heldT(cx,pt)==5){ nt=2; } }
  if(nt==0){ pt_learn(cx,pt,"zol","bik"); if(heldT(cx,pt)==5){ nt=3; } }
  if(nt==0){ pt_learn(cx,pt,"tav","gup"); if(heldT(cx,pt)==5){ nt=4; } }
  if(nt==0){ pt_learn(cx,pt,"bik","zol"); if(heldT(cx,pt)==5){ nt=5; } }
  let nc:i32=0;
  pc_learn(pc,"bix",0,"zol",0); if(heldC(pc)==5){ nc=1; }
  if(nc==0){ pc_learn(pc,"gup",0,"tav",0); if(heldC(pc)==5){ nc=2; } }
  if(nc==0){ pc_learn(pc,"zol",0,"bik",0); if(heldC(pc)==5){ nc=3; } }
  if(nc==0){ pc_learn(pc,"tav",0,"gup",0); if(heldC(pc)==5){ nc=4; } }
  if(nc==0){ pc_learn(pc,"bik",0,"zol",0); if(heldC(pc)==5){ nc=5; } }
  out("A3A-PROC treat="); outi(nt); out(" ctrl="); outi(nc); out("\n");

  // S7 contradiction
  let nev:i32=0;
  feed(st,lx,cx,rl,cxM,rlM,"bikzol",6,1); nev=nev+contradictions(lx,cx,rl,rlM,"bikzol",6);
  feed(st,lx,cx,rl,cxM,rlM,"biktav",6,1); nev=nev+contradictions(lx,cx,rl,rlM,"biktav",6);
  feed(st,lx,cx,rl,cxM,rlM,"bikzoltav",9,1); nev=nev+contradictions(lx,cx,rl,rlM,"bikzoltav",9);
  feed(st,lx,cx,rl,cxM,rlM,"biktavzol",9,1); nev=nev+contradictions(lx,cx,rl,rlM,"biktavzol",9);
  feed(st,lx,cx,rl,cxM,rlM,"tavbixzol",9,1);
  feed(st,lx,cx,rl,cxM,rlM,"tevkixzol",9,1);
  let logc:[]u8=newbuf(8);
  let nb:i32=bound_viol(cx,"tavbixzol",9,logc,0);
  nb=nb+bound_viol(cx,"tevkixzol",9,logc,nb);
  cx_copy(cxS,cx);

  // S8 inquiry: rule with max pend, competing active rule, discriminating episode
  let me:i32=-1; let mp:i32=-1;
  e=0;
  while(e<32){
    if(rd(rl,e*32+8)>0 && rd(rl,e*32+28)>mp){ mp=rd(rl,e*32+28); me=e; }
    e=e+1;
  }
  if(me>=0 && mp>0){
    let ctx0:i32=rd(rl,me*32);
    let ce:i32=-1; let cs:i32=-1;
    e=0;
    while(e<32){
      if(rd(rl,e*32+8)>0 && rd(rl,e*32)==ctx0 && rd(rl,e*32+16)==1 && rd(rl,e*32+4)!=rd(rl,me*32+4)){
        if(rd(rl,e*32+8)>cs){ cs=rd(rl,e*32+8); ce=e; }
      }
      e=e+1;
    }
    if(ce>=0){ feed(st,lx,cx,rl,cxM,rlM,"bikzoltav",9,1); }
  }
  // S8 accuracy before revision (not an A3 metric; sanity only, kept silent)

  // S9 revision + split candidates
  rl_revise(rl); rl_revise(rlM);
  let ncands:i32=split_init(cx,sp,logc,nb);
  // delete-only control twin: retire the violated concepts outright
  cx_killpat(cxS,"bik",3); cx_killpat(cxS,"tav",3);
  let nref_ctrl:i32=0;

  // S10 memory pressure: 20 flood episodes, twin eviction, then probe
  i=0;
  while(i<20){
    let s:[]u8=s10_ep(i); let n:i32=s10_len(i);
    feed(st,lx,cx,rl,cxM,rlM,s,n,1);
    split_count(lx,sp,s,n);
    i=i+1;
  }
  let ptot:[]u8=newbuf(4);
  let pat:i32=0; let ptt0:i32=0;
  i=0;
  while(i<10){ pat=pat+probe_one(lx,rl,cx,probe_ep(i),probe_len(i),ptot); i=i+1; }
  ptt0=ptot[0] as i32;
  ptot[0]=0;
  let pac:i32=0; let pct0:i32=0;
  i=0;
  while(i<10){ pac=pac+probe_one(lx,rlM,cx,probe_ep(i),probe_len(i),ptot); i=i+1; }
  pct0=ptot[0] as i32;
  out("A3B-PROBE treat="); outi(pat); out("/"); outi(ptt0);
  out(" ctrl="); outi(pac); out("/"); outi(pct0); out("\n");

  // S11 delayed episodes: feed through learner, gather split evidence
  i=0;
  while(i<6){
    let s:[]u8=s11_ep(i); let n:i32=s11_len(i);
    feed(st,lx,cx,rl,cxM,rlM,s,n,0);
    split_count(lx,sp,s,n);
    i=i+1;
  }
  let nref:i32=split_eval(cx,sp);
  out("A3C-REFINE treat="); outi(nref); out(" ctrl="); outi(nref_ctrl);
  out(" cands="); outi(ncands); out("\n");

  // verdicts per frozen criteria
  out("A3A-VERDICT ");
  if(nt>0 && nc>0){
    if(nt<nc){ out("REPRODUCED\n"); } else { out("ATTACK-SUCCEEDS(sign-flip-or-tie)\n"); }
  } else { out("ATTACK-SUCCEEDS(degenerate)\n"); }
  out("A3B-VERDICT ");
  if(ptt0>0 && pct0>0){
    if(pat>pac){ out("REPRODUCED\n"); } else { out("ATTACK-SUCCEEDS(sign-flip)\n"); }
  } else { out("ATTACK-SUCCEEDS(degenerate)\n"); }
  out("A3C-VERDICT ");
  if(ncands>0){
    if(nref>nref_ctrl){ out("REPRODUCED\n"); } else { out("ATTACK-SUCCEEDS(sign-flip)\n"); }
  } else { out("ATTACK-SUCCEEDS(degenerate)\n"); }
  return 0;
}

// col_base.zag -- base for the cognitive-ops-learner battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, chain store, and vfy_gen: the researcher-supplied
// generic VERIFY procedure (procedure id 0).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
  }
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 0).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index, no relation-specific logic. kb/ko is the
// check-counter cell. This is the correctness oracle for the battery.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s && fr==r && fo==o){ hit=1; }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// col_world.zag -- world definitions only. Opaque integer identifiers.
// No learner logic lives here. setup_worldA builds the 32-fact world;
// setup_worldB builds the 24-fact world. The 24 chains below are the
// learner's experience (episodes) and queries.
fn setup_worldA(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,11,101,21); fact_add(A,12,101,22);
  fact_add(A,13,101,23); fact_add(A,14,101,24);
  fact_add(A,15,101,25); fact_add(A,16,101,26);
  fact_add(A,17,101,27); fact_add(A,18,101,28);
  fact_add(A,11,102,25); fact_add(A,12,102,26);
  fact_add(A,13,102,27); fact_add(A,14,102,28);
  fact_add(A,15,102,21); fact_add(A,16,102,22);
  fact_add(A,17,102,23); fact_add(A,18,102,24);
  fact_add(A,11,103,28); fact_add(A,12,103,27);
  fact_add(A,13,103,26); fact_add(A,14,103,25);
  fact_add(A,15,103,24); fact_add(A,16,103,23);
  fact_add(A,17,103,22); fact_add(A,18,103,21);
  fact_add(A,31,107,41); fact_add(A,32,107,42);
  fact_add(A,33,107,43); fact_add(A,34,107,44);
  fact_add(A,35,109,45); fact_add(A,36,109,46);
  fact_add(A,37,109,47); fact_add(A,38,109,48);
  return;
}
fn setup_worldB(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,51,201,61); fact_add(A,52,201,62);
  fact_add(A,53,201,63); fact_add(A,54,201,64);
  fact_add(A,55,201,65); fact_add(A,56,201,66);
  fact_add(A,57,201,67); fact_add(A,58,201,68);
  fact_add(A,51,202,65); fact_add(A,52,202,66);
  fact_add(A,53,202,67); fact_add(A,54,202,68);
  fact_add(A,55,202,61); fact_add(A,56,202,62);
  fact_add(A,57,202,63); fact_add(A,58,202,64);
  fact_add(A,71,207,81); fact_add(A,72,207,82);
  fact_add(A,73,207,83); fact_add(A,74,207,84);
  fact_add(A,75,207,85); fact_add(A,76,207,86);
  fact_add(A,77,207,87); fact_add(A,78,207,88);
  return;
}
// ---- world-A episodes (chain ids 0-5) ----
fn ch_e0(C:[]u8)void { chain_clear(C); chain_add(C,11,101,21); chain_add(C,11,102,25); return; }
fn ch_e1(C:[]u8)void { chain_clear(C); chain_add(C,12,101,22); chain_add(C,12,103,27); return; }
fn ch_e2(C:[]u8)void { chain_clear(C); chain_add(C,13,102,27); chain_add(C,13,103,26); return; }
fn ch_e3(C:[]u8)void { chain_clear(C); chain_add(C,14,101,24); chain_add(C,14,102,28); return; }
fn ch_e4(C:[]u8)void { chain_clear(C); chain_add(C,15,101,99); chain_add(C,15,102,21); return; }
fn ch_e5(C:[]u8)void { chain_clear(C); chain_add(C,16,103,23); chain_add(C,99,101,21); return; }
// ---- world-A queries (chain ids 10-15) ----
fn ch_q0(C:[]u8)void { chain_clear(C); chain_add(C,17,101,27); chain_add(C,17,102,23); return; }
fn ch_q1(C:[]u8)void { chain_clear(C); chain_add(C,18,103,21); chain_add(C,18,101,28); return; }
fn ch_q2(C:[]u8)void {
  chain_clear(C);
  chain_add(C,11,102,25); chain_add(C,12,103,27); chain_add(C,13,101,23);
  return;
}
fn ch_q3(C:[]u8)void { chain_clear(C); chain_add(C,14,102,21); chain_add(C,15,103,24); return; }
fn ch_q4(C:[]u8)void {
  chain_clear(C);
  chain_add(C,16,101,26); chain_add(C,16,102,22); chain_add(C,16,103,23);
  return;
}
fn ch_q5(C:[]u8)void { chain_clear(C); chain_add(C,17,103,21); chain_add(C,18,102,24); return; }
// ---- world-B episodes (chain ids 20-23) ----
fn ch_f0(C:[]u8)void { chain_clear(C); chain_add(C,51,201,61); chain_add(C,51,202,65); return; }
fn ch_f1(C:[]u8)void { chain_clear(C); chain_add(C,52,201,62); chain_add(C,52,202,66); return; }
fn ch_f2(C:[]u8)void { chain_clear(C); chain_add(C,53,202,67); chain_add(C,53,201,63); return; }
fn ch_f3(C:[]u8)void { chain_clear(C); chain_add(C,54,201,99); chain_add(C,54,202,68); return; }
// ---- world-B pre-revision queries (chain ids 30-33) ----
fn ch_b0(C:[]u8)void { chain_clear(C); chain_add(C,55,201,65); chain_add(C,55,202,61); return; }
fn ch_b1(C:[]u8)void { chain_clear(C); chain_add(C,56,202,62); chain_add(C,56,201,66); return; }
fn ch_b2(C:[]u8)void { chain_clear(C); chain_add(C,57,201,67); chain_add(C,57,202,63); return; }
fn ch_b3(C:[]u8)void { chain_clear(C); chain_add(C,58,201,61); chain_add(C,58,202,64); return; }
// ---- world-B post-revision queries (chain ids 40-43) ----
fn ch_c0(C:[]u8)void { chain_clear(C); chain_add(C,51,202,65); chain_add(C,52,201,62); return; }
fn ch_c1(C:[]u8)void {
  chain_clear(C);
  chain_add(C,53,201,63); chain_add(C,54,202,68); chain_add(C,55,201,65);
  return;
}
fn ch_c2(C:[]u8)void { chain_clear(C); chain_add(C,56,201,66); chain_add(C,57,202,63); return; }
fn ch_c3(C:[]u8)void { chain_clear(C); chain_add(C,58,202,61); chain_add(C,51,201,61); return; }
// ---- chain dispatch by id ----
fn pick_chain(C:[]u8,id:i32)void {
  if(id==0){ ch_e0(C); return; }
  if(id==1){ ch_e1(C); return; }
  if(id==2){ ch_e2(C); return; }
  if(id==3){ ch_e3(C); return; }
  if(id==4){ ch_e4(C); return; }
  if(id==5){ ch_e5(C); return; }
  if(id==10){ ch_q0(C); return; }
  if(id==11){ ch_q1(C); return; }
  if(id==12){ ch_q2(C); return; }
  if(id==13){ ch_q3(C); return; }
  if(id==14){ ch_q4(C); return; }
  if(id==15){ ch_q5(C); return; }
  if(id==20){ ch_f0(C); return; }
  if(id==21){ ch_f1(C); return; }
  if(id==22){ ch_f2(C); return; }
  if(id==23){ ch_f3(C); return; }
  if(id==30){ ch_b0(C); return; }
  if(id==31){ ch_b1(C); return; }
  if(id==32){ ch_b2(C); return; }
  if(id==33){ ch_b3(C); return; }
  if(id==40){ ch_c0(C); return; }
  if(id==41){ ch_c1(C); return; }
  if(id==42){ ch_c2(C); return; }
  if(id==43){ ch_c3(C); return; }
  return;
}
// col_learn.zag -- learner-owned procedures.
//
// The working set, the inverted index, the provenance record, and the
// selection statistics all live in the learner-state buffer L, whose
// layout is:
//   0: nrel (working-set size); 4: rel_ids[16]; 68: rel_cnt[16];
//   132: fidx[16][64] (fact indices per relation);
//   4228: prov_parent; 4232: prov_ep0; 4236: prov_ep1; 4240: prov_facts;
//   4244: prov_rev; 4248: stat_spec; 4252: stat_gen; 4256: stat_agree;
//   4260: stat_neg1; 4264: stage_cs; 4268: stage_cg; 4272: stage_fallback;
//   4276: stage_agree; 4280: stage_selspec.
//
// No world relation identifiers appear in this file. All relation
// content arrives at runtime through the working set, which the learner
// builds from its own episode experience.
fn cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    let q:i32=get32(L,4+i*4);
    if(q==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cov_has(L:[]u8,r:i32)i32 {
  let bi:i32=cov_find(L,r);
  if(bi<0){ return 0; }
  return 1;
}
// Log one observed relation into the working set (deduped).
fn ep_log_rel(L:[]u8,r:i32)void {
  let bi:i32=cov_find(L,r);
  if(bi<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
// Clear the working set (used before re-specializing on new experience;
// the revision counter and statistics are preserved).
fn cov_clear(L:[]u8)void { set32(L,0,0); return; }
// specialize: build the inverted index over the arena facts, restricted
// to the working set, and write the provenance record. One linear pass
// over all facts; each fact whose relation is covered is appended to
// that relation's bucket.
fn specialize(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// vfy_spec: the learner-owned specialized VERIFY (procedure id 1).
// Scans only the learned bucket for each step's relation. Returns -1
// if any step's relation is outside the learned coverage.
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=cov_find(L,r);
    if(bi<0){
      set32(L,4260,get32(L,4260)+1);
      return -1;
    }
    let n:i32=get32(L,68+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,132+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s && fr==r && fo==o){ hit=1; }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// select_verify: context-driven selection from the learned coverage
// record. No mode constants: coverage of every step relation selects
// the learner-owned specialized procedure (sel=1); any gap falls back
// to the researcher-supplied generic procedure (sel=0).
fn select_verify(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,sb:[]u8,so:i32)i32 {
  let ns:i32=get32(C,0);
  let cov:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    let h:i32=cov_has(L,r);
    if(h==0){ cov=0; }
    i=i+1;
  }
  if(cov==1){
    set32(sb,so,1);
    set32(L,4248,get32(L,4248)+1);
    return vfy_spec(L,A,C,kb,ko);
  }
  set32(sb,so,0);
  set32(L,4252,get32(L,4252)+1);
  return vfy_gen(A,C,kb,ko);
}
// episode: the learner's experience step. It runs the generic procedure
// (the only procedure it has yet) and logs each step's relation into
// the working set. kb/ko is the check-counter cell.
fn episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    ep_log_rel(L,r);
    i=i+1;
  }
  return vfy_gen(A,C,kb,ko);
}
// col_main.zag -- six-stage driver for the cognitive-ops-learner battery.
// Reports per-episode and per-query lines, learner-state dumps, and
// stage summaries. All dynamic output goes through the single
// preallocated buffer B, flushed once at the end.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
// One episode: build chain ch, run the learner episode step, report.
fn run_ep(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,ep:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  let v:i32=episode(L,A,C,K,0);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// One covered query: learner selection, then a reference generic run;
// report and accumulate stage stats in L (4264: cs, 4268: cg,
// 4276: agree, 4280: selspec).
fn run_cov(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,q:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  set32(K,8,0);
  let v:i32=select_verify(L,A,C,K,0,K,8);
  let sel:i32=get32(K,8);
  let cs:i32=get32(K,0);
  set32(K,0,0);
  let vg:i32=vfy_gen(A,C,K,0);
  let cg:i32=get32(K,0);
  let a:i32=0;
  if(v==vg){ a=1; }
  set32(L,4256,get32(L,4256)+a);
  set32(L,4264,get32(L,4264)+cs);
  set32(L,4268,get32(L,4268)+cg);
  set32(L,4276,get32(L,4276)+a);
  set32(L,4280,get32(L,4280)+sel);
  c=o_app(b,c,"Q q=");
  c=o_i64(b,c,q as i64);
  c=o_app(b,c," sel=");
  c=o_i64(b,c,sel as i64);
  c=o_app(b,c," vspec=");
  c=o_i64(b,c,v as i64);
  c=o_app(b,c," vgen=");
  c=o_i64(b,c,vg as i64);
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
// One fallback-probe query: learner selection and report; count sel==0
// in L[4272].
fn run_fb(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,q:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  set32(K,8,0);
  let v:i32=select_verify(L,A,C,K,0,K,8);
  let sel:i32=get32(K,8);
  let cg:i32=get32(K,0);
  if(sel==0){ set32(L,4272,get32(L,4272)+1); }
  c=o_app(b,c,"Q q=");
  c=o_i64(b,c,q as i64);
  c=o_app(b,c," sel=");
  c=o_i64(b,c,sel as i64);
  c=o_app(b,c," v=");
  c=o_i64(b,c,v as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
fn stage_reset(L:[]u8)void {
  set32(L,4264,0); set32(L,4268,0);
  set32(L,4272,0); set32(L,4276,0); set32(L,4280,0);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(8192);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  // S1 LEARN-A
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1 LEARN-A"); c=o_nl(B,c);
  c=run_ep(B,c,L,A,Cb,K,0,0);
  c=run_ep(B,c,L,A,Cb,K,1,1);
  c=run_ep(B,c,L,A,Cb,K,2,2);
  c=run_ep(B,c,L,A,Cb,K,3,3);
  c=run_ep(B,c,L,A,Cb,K,4,4);
  c=run_ep(B,c,L,A,Cb,K,5,5);
  specialize(L,A,0,5);
  c=spec_line(B,c,L);
  c=dump_lstate(B,c,L);
  // S2 SELECT-A
  c=o_app(B,c,"STAGE S2 SELECT-A"); c=o_nl(B,c);
  stage_reset(L);
  c=run_cov(B,c,L,A,Cb,K,10,0);
  c=run_cov(B,c,L,A,Cb,K,11,1);
  c=run_cov(B,c,L,A,Cb,K,12,2);
  c=run_cov(B,c,L,A,Cb,K,13,3);
  c=run_cov(B,c,L,A,Cb,K,14,4);
  c=run_cov(B,c,L,A,Cb,K,15,5);
  c=o_app(B,c,"SUMMARY-A agree=");
  c=o_i64(B,c,get32(L,4276) as i64);
  c=o_app(B,c," spec_sel=");
  c=o_i64(B,c,get32(L,4280) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,4264) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,4268) as i64);
  c=o_nl(B,c);
  // S3 SHIFT-B (coverage still from A; expect fallback)
  setup_worldB(A);
  c=o_app(B,c,"STAGE S3 SHIFT-B"); c=o_nl(B,c);
  stage_reset(L);
  c=run_fb(B,c,L,A,Cb,K,30,0);
  c=run_fb(B,c,L,A,Cb,K,31,1);
  c=run_fb(B,c,L,A,Cb,K,32,2);
  c=run_fb(B,c,L,A,Cb,K,33,3);
  c=o_app(B,c,"SUMMARY-SHIFT fallback=");
  c=o_i64(B,c,get32(L,4272) as i64);
  c=o_nl(B,c);
  // S4 REVISE-B
  c=o_app(B,c,"STAGE S4 REVISE-B"); c=o_nl(B,c);
  cov_clear(L);
  c=run_ep(B,c,L,A,Cb,K,20,6);
  c=run_ep(B,c,L,A,Cb,K,21,7);
  c=run_ep(B,c,L,A,Cb,K,22,8);
  c=run_ep(B,c,L,A,Cb,K,23,9);
  specialize(L,A,6,9);
  c=spec_line(B,c,L);
  c=dump_lstate(B,c,L);
  // S5 SELECT-B
  c=o_app(B,c,"STAGE S5 SELECT-B"); c=o_nl(B,c);
  stage_reset(L);
  c=run_cov(B,c,L,A,Cb,K,40,0);
  c=run_cov(B,c,L,A,Cb,K,41,1);
  c=run_cov(B,c,L,A,Cb,K,42,2);
  c=run_cov(B,c,L,A,Cb,K,43,3);
  c=o_app(B,c,"SUMMARY-B agree=");
  c=o_i64(B,c,get32(L,4276) as i64);
  c=o_app(B,c," spec_sel=");
  c=o_i64(B,c,get32(L,4280) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,4264) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,4268) as i64);
  c=o_nl(B,c);
  // S6 RECHECK-A: rebuild world A, re-present Q0 under revised coverage
  setup_worldA(A);
  c=o_app(B,c,"STAGE S6 RECHECK-A"); c=o_nl(B,c);
  stage_reset(L);
  c=run_fb(B,c,L,A,Cb,K,10,0);
  c=o_app(B,c,"SUMMARY-ALL stat_spec=");
  c=o_i64(B,c,get32(L,4248) as i64);
  c=o_app(B,c," stat_gen=");
  c=o_i64(B,c,get32(L,4252) as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,get32(L,4256) as i64);
  c=o_app(B,c," neg1=");
  c=o_i64(B,c,get32(L,4260) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

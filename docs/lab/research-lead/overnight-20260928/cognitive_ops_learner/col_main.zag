// col_main.zag -- six-stage driver for the cognitive-ops-learner battery.
// Reports per-episode and per-query lines, learner-state dumps, and
// stage summaries. All dynamic output goes through the single
// preallocated buffer B, flushed once at the end.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
// One episode: build chain ch, run the learner episode step, report.
fn run_ep(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,ep:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  let v:i32=episode(L,A,C,K,0);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// One covered query: learner selection, then a reference generic run;
// report and accumulate stage stats in L (4264: cs, 4268: cg,
// 4276: agree, 4280: selspec).
fn run_cov(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,q:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  set32(K,8,0);
  let v:i32=select_verify(L,A,C,K,0,K,8);
  let sel:i32=get32(K,8);
  let cs:i32=get32(K,0);
  set32(K,0,0);
  let vg:i32=vfy_gen(A,C,K,0);
  let cg:i32=get32(K,0);
  let a:i32=0;
  if(v==vg){ a=1; }
  set32(L,4256,get32(L,4256)+a);
  set32(L,4264,get32(L,4264)+cs);
  set32(L,4268,get32(L,4268)+cg);
  set32(L,4276,get32(L,4276)+a);
  set32(L,4280,get32(L,4280)+sel);
  c=o_app(b,c,"Q q=");
  c=o_i64(b,c,q as i64);
  c=o_app(b,c," sel=");
  c=o_i64(b,c,sel as i64);
  c=o_app(b,c," vspec=");
  c=o_i64(b,c,v as i64);
  c=o_app(b,c," vgen=");
  c=o_i64(b,c,vg as i64);
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
// One fallback-probe query: learner selection and report; count sel==0
// in L[4272].
fn run_fb(b:[]u8,c:i32,L:[]u8,A:[]u8,C:[]u8,K:[]u8,ch:i32,q:i32)i32 {
  pick_chain(C,ch);
  set32(K,0,0);
  set32(K,8,0);
  let v:i32=select_verify(L,A,C,K,0,K,8);
  let sel:i32=get32(K,8);
  let cg:i32=get32(K,0);
  if(sel==0){ set32(L,4272,get32(L,4272)+1); }
  c=o_app(b,c,"Q q=");
  c=o_i64(b,c,q as i64);
  c=o_app(b,c," sel=");
  c=o_i64(b,c,sel as i64);
  c=o_app(b,c," v=");
  c=o_i64(b,c,v as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
fn stage_reset(L:[]u8)void {
  set32(L,4264,0); set32(L,4268,0);
  set32(L,4272,0); set32(L,4276,0); set32(L,4280,0);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(8192);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  // S1 LEARN-A
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1 LEARN-A"); c=o_nl(B,c);
  c=run_ep(B,c,L,A,Cb,K,0,0);
  c=run_ep(B,c,L,A,Cb,K,1,1);
  c=run_ep(B,c,L,A,Cb,K,2,2);
  c=run_ep(B,c,L,A,Cb,K,3,3);
  c=run_ep(B,c,L,A,Cb,K,4,4);
  c=run_ep(B,c,L,A,Cb,K,5,5);
  specialize(L,A,0,5);
  c=spec_line(B,c,L);
  c=dump_lstate(B,c,L);
  // S2 SELECT-A
  c=o_app(B,c,"STAGE S2 SELECT-A"); c=o_nl(B,c);
  stage_reset(L);
  c=run_cov(B,c,L,A,Cb,K,10,0);
  c=run_cov(B,c,L,A,Cb,K,11,1);
  c=run_cov(B,c,L,A,Cb,K,12,2);
  c=run_cov(B,c,L,A,Cb,K,13,3);
  c=run_cov(B,c,L,A,Cb,K,14,4);
  c=run_cov(B,c,L,A,Cb,K,15,5);
  c=o_app(B,c,"SUMMARY-A agree=");
  c=o_i64(B,c,get32(L,4276) as i64);
  c=o_app(B,c," spec_sel=");
  c=o_i64(B,c,get32(L,4280) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,4264) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,4268) as i64);
  c=o_nl(B,c);
  // S3 SHIFT-B (coverage still from A; expect fallback)
  setup_worldB(A);
  c=o_app(B,c,"STAGE S3 SHIFT-B"); c=o_nl(B,c);
  stage_reset(L);
  c=run_fb(B,c,L,A,Cb,K,30,0);
  c=run_fb(B,c,L,A,Cb,K,31,1);
  c=run_fb(B,c,L,A,Cb,K,32,2);
  c=run_fb(B,c,L,A,Cb,K,33,3);
  c=o_app(B,c,"SUMMARY-SHIFT fallback=");
  c=o_i64(B,c,get32(L,4272) as i64);
  c=o_nl(B,c);
  // S4 REVISE-B
  c=o_app(B,c,"STAGE S4 REVISE-B"); c=o_nl(B,c);
  cov_clear(L);
  c=run_ep(B,c,L,A,Cb,K,20,6);
  c=run_ep(B,c,L,A,Cb,K,21,7);
  c=run_ep(B,c,L,A,Cb,K,22,8);
  c=run_ep(B,c,L,A,Cb,K,23,9);
  specialize(L,A,6,9);
  c=spec_line(B,c,L);
  c=dump_lstate(B,c,L);
  // S5 SELECT-B
  c=o_app(B,c,"STAGE S5 SELECT-B"); c=o_nl(B,c);
  stage_reset(L);
  c=run_cov(B,c,L,A,Cb,K,40,0);
  c=run_cov(B,c,L,A,Cb,K,41,1);
  c=run_cov(B,c,L,A,Cb,K,42,2);
  c=run_cov(B,c,L,A,Cb,K,43,3);
  c=o_app(B,c,"SUMMARY-B agree=");
  c=o_i64(B,c,get32(L,4276) as i64);
  c=o_app(B,c," spec_sel=");
  c=o_i64(B,c,get32(L,4280) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,4264) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,4268) as i64);
  c=o_nl(B,c);
  // S6 RECHECK-A: rebuild world A, re-present Q0 under revised coverage
  setup_worldA(A);
  c=o_app(B,c,"STAGE S6 RECHECK-A"); c=o_nl(B,c);
  stage_reset(L);
  c=run_fb(B,c,L,A,Cb,K,10,0);
  c=o_app(B,c,"SUMMARY-ALL stat_spec=");
  c=o_i64(B,c,get32(L,4248) as i64);
  c=o_app(B,c," stat_gen=");
  c=o_i64(B,c,get32(L,4252) as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,get32(L,4256) as i64);
  c=o_app(B,c," neg1=");
  c=o_i64(B,c,get32(L,4260) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

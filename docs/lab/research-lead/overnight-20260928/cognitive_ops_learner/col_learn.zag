// col_learn.zag -- learner-owned procedures.
//
// The working set, the inverted index, the provenance record, and the
// selection statistics all live in the learner-state buffer L, whose
// layout is:
//   0: nrel (working-set size); 4: rel_ids[16]; 68: rel_cnt[16];
//   132: fidx[16][64] (fact indices per relation);
//   4228: prov_parent; 4232: prov_ep0; 4236: prov_ep1; 4240: prov_facts;
//   4244: prov_rev; 4248: stat_spec; 4252: stat_gen; 4256: stat_agree;
//   4260: stat_neg1; 4264: stage_cs; 4268: stage_cg; 4272: stage_fallback;
//   4276: stage_agree; 4280: stage_selspec.
//
// No world relation identifiers appear in this file. All relation
// content arrives at runtime through the working set, which the learner
// builds from its own episode experience.
fn cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    let q:i32=get32(L,4+i*4);
    if(q==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cov_has(L:[]u8,r:i32)i32 {
  let bi:i32=cov_find(L,r);
  if(bi<0){ return 0; }
  return 1;
}
// Log one observed relation into the working set (deduped).
fn ep_log_rel(L:[]u8,r:i32)void {
  let bi:i32=cov_find(L,r);
  if(bi<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
// Clear the working set (used before re-specializing on new experience;
// the revision counter and statistics are preserved).
fn cov_clear(L:[]u8)void { set32(L,0,0); return; }
// specialize: build the inverted index over the arena facts, restricted
// to the working set, and write the provenance record. One linear pass
// over all facts; each fact whose relation is covered is appended to
// that relation's bucket.
fn specialize(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// vfy_spec: the learner-owned specialized VERIFY (procedure id 1).
// Scans only the learned bucket for each step's relation. Returns -1
// if any step's relation is outside the learned coverage.
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=cov_find(L,r);
    if(bi<0){
      set32(L,4260,get32(L,4260)+1);
      return -1;
    }
    let n:i32=get32(L,68+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,132+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s && fr==r && fo==o){ hit=1; }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// select_verify: context-driven selection from the learned coverage
// record. No mode constants: coverage of every step relation selects
// the learner-owned specialized procedure (sel=1); any gap falls back
// to the researcher-supplied generic procedure (sel=0).
fn select_verify(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,sb:[]u8,so:i32)i32 {
  let ns:i32=get32(C,0);
  let cov:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    let h:i32=cov_has(L,r);
    if(h==0){ cov=0; }
    i=i+1;
  }
  if(cov==1){
    set32(sb,so,1);
    set32(L,4248,get32(L,4248)+1);
    return vfy_spec(L,A,C,kb,ko);
  }
  set32(sb,so,0);
  set32(L,4252,get32(L,4252)+1);
  return vfy_gen(A,C,kb,ko);
}
// episode: the learner's experience step. It runs the generic procedure
// (the only procedure it has yet) and logs each step's relation into
// the working set. kb/ko is the check-counter cell.
fn episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    ep_log_rel(L,r);
    i=i+1;
  }
  return vfy_gen(A,C,kb,ko);
}

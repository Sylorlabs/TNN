// col_world.zag -- world definitions only. Opaque integer identifiers.
// No learner logic lives here. setup_worldA builds the 32-fact world;
// setup_worldB builds the 24-fact world. The 24 chains below are the
// learner's experience (episodes) and queries.
fn setup_worldA(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,11,101,21); fact_add(A,12,101,22);
  fact_add(A,13,101,23); fact_add(A,14,101,24);
  fact_add(A,15,101,25); fact_add(A,16,101,26);
  fact_add(A,17,101,27); fact_add(A,18,101,28);
  fact_add(A,11,102,25); fact_add(A,12,102,26);
  fact_add(A,13,102,27); fact_add(A,14,102,28);
  fact_add(A,15,102,21); fact_add(A,16,102,22);
  fact_add(A,17,102,23); fact_add(A,18,102,24);
  fact_add(A,11,103,28); fact_add(A,12,103,27);
  fact_add(A,13,103,26); fact_add(A,14,103,25);
  fact_add(A,15,103,24); fact_add(A,16,103,23);
  fact_add(A,17,103,22); fact_add(A,18,103,21);
  fact_add(A,31,107,41); fact_add(A,32,107,42);
  fact_add(A,33,107,43); fact_add(A,34,107,44);
  fact_add(A,35,109,45); fact_add(A,36,109,46);
  fact_add(A,37,109,47); fact_add(A,38,109,48);
  return;
}
fn setup_worldB(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,51,201,61); fact_add(A,52,201,62);
  fact_add(A,53,201,63); fact_add(A,54,201,64);
  fact_add(A,55,201,65); fact_add(A,56,201,66);
  fact_add(A,57,201,67); fact_add(A,58,201,68);
  fact_add(A,51,202,65); fact_add(A,52,202,66);
  fact_add(A,53,202,67); fact_add(A,54,202,68);
  fact_add(A,55,202,61); fact_add(A,56,202,62);
  fact_add(A,57,202,63); fact_add(A,58,202,64);
  fact_add(A,71,207,81); fact_add(A,72,207,82);
  fact_add(A,73,207,83); fact_add(A,74,207,84);
  fact_add(A,75,207,85); fact_add(A,76,207,86);
  fact_add(A,77,207,87); fact_add(A,78,207,88);
  return;
}
// ---- world-A episodes (chain ids 0-5) ----
fn ch_e0(C:[]u8)void { chain_clear(C); chain_add(C,11,101,21); chain_add(C,11,102,25); return; }
fn ch_e1(C:[]u8)void { chain_clear(C); chain_add(C,12,101,22); chain_add(C,12,103,27); return; }
fn ch_e2(C:[]u8)void { chain_clear(C); chain_add(C,13,102,27); chain_add(C,13,103,26); return; }
fn ch_e3(C:[]u8)void { chain_clear(C); chain_add(C,14,101,24); chain_add(C,14,102,28); return; }
fn ch_e4(C:[]u8)void { chain_clear(C); chain_add(C,15,101,99); chain_add(C,15,102,21); return; }
fn ch_e5(C:[]u8)void { chain_clear(C); chain_add(C,16,103,23); chain_add(C,99,101,21); return; }
// ---- world-A queries (chain ids 10-15) ----
fn ch_q0(C:[]u8)void { chain_clear(C); chain_add(C,17,101,27); chain_add(C,17,102,23); return; }
fn ch_q1(C:[]u8)void { chain_clear(C); chain_add(C,18,103,21); chain_add(C,18,101,28); return; }
fn ch_q2(C:[]u8)void {
  chain_clear(C);
  chain_add(C,11,102,25); chain_add(C,12,103,27); chain_add(C,13,101,23);
  return;
}
fn ch_q3(C:[]u8)void { chain_clear(C); chain_add(C,14,102,21); chain_add(C,15,103,24); return; }
fn ch_q4(C:[]u8)void {
  chain_clear(C);
  chain_add(C,16,101,26); chain_add(C,16,102,22); chain_add(C,16,103,23);
  return;
}
fn ch_q5(C:[]u8)void { chain_clear(C); chain_add(C,17,103,21); chain_add(C,18,102,24); return; }
// ---- world-B episodes (chain ids 20-23) ----
fn ch_f0(C:[]u8)void { chain_clear(C); chain_add(C,51,201,61); chain_add(C,51,202,65); return; }
fn ch_f1(C:[]u8)void { chain_clear(C); chain_add(C,52,201,62); chain_add(C,52,202,66); return; }
fn ch_f2(C:[]u8)void { chain_clear(C); chain_add(C,53,202,67); chain_add(C,53,201,63); return; }
fn ch_f3(C:[]u8)void { chain_clear(C); chain_add(C,54,201,99); chain_add(C,54,202,68); return; }
// ---- world-B pre-revision queries (chain ids 30-33) ----
fn ch_b0(C:[]u8)void { chain_clear(C); chain_add(C,55,201,65); chain_add(C,55,202,61); return; }
fn ch_b1(C:[]u8)void { chain_clear(C); chain_add(C,56,202,62); chain_add(C,56,201,66); return; }
fn ch_b2(C:[]u8)void { chain_clear(C); chain_add(C,57,201,67); chain_add(C,57,202,63); return; }
fn ch_b3(C:[]u8)void { chain_clear(C); chain_add(C,58,201,61); chain_add(C,58,202,64); return; }
// ---- world-B post-revision queries (chain ids 40-43) ----
fn ch_c0(C:[]u8)void { chain_clear(C); chain_add(C,51,202,65); chain_add(C,52,201,62); return; }
fn ch_c1(C:[]u8)void {
  chain_clear(C);
  chain_add(C,53,201,63); chain_add(C,54,202,68); chain_add(C,55,201,65);
  return;
}
fn ch_c2(C:[]u8)void { chain_clear(C); chain_add(C,56,201,66); chain_add(C,57,202,63); return; }
fn ch_c3(C:[]u8)void { chain_clear(C); chain_add(C,58,202,61); chain_add(C,51,201,61); return; }
// ---- chain dispatch by id ----
fn pick_chain(C:[]u8,id:i32)void {
  if(id==0){ ch_e0(C); return; }
  if(id==1){ ch_e1(C); return; }
  if(id==2){ ch_e2(C); return; }
  if(id==3){ ch_e3(C); return; }
  if(id==4){ ch_e4(C); return; }
  if(id==5){ ch_e5(C); return; }
  if(id==10){ ch_q0(C); return; }
  if(id==11){ ch_q1(C); return; }
  if(id==12){ ch_q2(C); return; }
  if(id==13){ ch_q3(C); return; }
  if(id==14){ ch_q4(C); return; }
  if(id==15){ ch_q5(C); return; }
  if(id==20){ ch_f0(C); return; }
  if(id==21){ ch_f1(C); return; }
  if(id==22){ ch_f2(C); return; }
  if(id==23){ ch_f3(C); return; }
  if(id==30){ ch_b0(C); return; }
  if(id==31){ ch_b1(C); return; }
  if(id==32){ ch_b2(C); return; }
  if(id==33){ ch_b3(C); return; }
  if(id==40){ ch_c0(C); return; }
  if(id==41){ ch_c1(C); return; }
  if(id==42){ ch_c2(C); return; }
  if(id==43){ ch_c3(C); return; }
  return;
}

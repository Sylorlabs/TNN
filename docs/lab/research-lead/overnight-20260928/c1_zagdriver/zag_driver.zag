// zag_driver.zag - Pure-Zag C1 race driver.
// Reimplements run_race.sh logic in pure Zag: JSON parsing, causal
// simulation, contestant invocation, query scoring.
// Usage: zag_driver <world_dir> <contestant_bin> <out_dir>
// Shell only invokes znc to compile and runs this binary.

// ---------------- syscalls and memory ----------------

fn sc(n:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64)i64 {
  return _zag_raw_syscall(n,a,b,c,d,e,f);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1 || n>33554432){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  if(b.len==0){return b;}
  let i:i32=0;
  while(i<s.len){b[i]=s[i];i=i+1;}
  b[s.len]=0;
  return b;
}
// Little-endian helpers. Do not use as *i32 slice construction.
fn p64(b:[]u8,o:i32,v:i64)void {
  b[o]=(v&255) as u8;
  b[o+1]=((v>>8)&255) as u8;
  b[o+2]=((v>>16)&255) as u8;
  b[o+3]=((v>>24)&255) as u8;
  b[o+4]=((v>>32)&255) as u8;
  b[o+5]=((v>>40)&255) as u8;
  b[o+6]=((v>>48)&255) as u8;
  b[o+7]=((v>>56)&255) as u8;
  return;
}
fn g32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn p32(b:[]u8,o:i32,v:i32)void {
  b[o]=(v&255) as u8;
  b[o+1]=((v>>8)&255) as u8;
  b[o+2]=((v>>16)&255) as u8;
  b[o+3]=((v>>24)&255) as u8;
  return;
}

// ---------------- strings ----------------

fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn app1(buf:[]u8,at:i32,c:u8)i32 {
  buf[at]=c;
  return at+1;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
// Convert i32 to decimal string. Returns length written.
fn i32str(buf:[]u8,at:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let tmp:[]u8=z_alloc(12);
  let n:i32=0;
  if(x==0){tmp[0]=48;n=1;}
  while(x>0){
    tmp[n]=((x%10)+48) as u8;
    n=n+1;
    x=x/10;
  }
  if(neg==1){at=app1(buf,at,45);}
  let i:i32=n-1;
  while(i>=0){at=app1(buf,at,tmp[i]);i=i-1;}
  z_free(tmp);
  return at;
}
// Convert i64 to decimal string.
fn i64str(buf:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){neg=1;x=0-x;}
  let tmp:[]u8=z_alloc(24);
  let n:i32=0;
  if(x==0){tmp[0]=48;n=1;}
  while(x>0){
    tmp[n]=((x%10)+48) as u8;
    n=n+1;
    x=x/10;
  }
  if(neg==1){at=app1(buf,at,45);}
  let i:i32=n-1;
  while(i>=0){at=app1(buf,at,tmp[i]);i=i-1;}
  z_free(tmp);
  return at;
}

// ---------------- file I/O ----------------

fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=sc(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=16777216;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=sc(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        total=total+nb;
        if(total>=cap){go=0;}
      }
    }
    sc(3,fd,0,0,0,0,0);
  }
  if(total==0){z_free(buf);return "";}
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=sc(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=sc(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void {
  sc(3,fd,0,0,0,0,0);
  return;
}
fn write_file(path:[]u8,data:[]u8)void {
  let fd:i64=w_open(path);
  if(fd>=0){w_write(fd,data);w_close(fd);}
  return;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn do_mkdir(path:[]u8)void {
  let c:[]u8=z_cstr(path);
  sc(83,(_zag_slice_ptr(c) as i64),493,0,0,0,0);
  z_free(c);
  return;
}
// Get wall clock milliseconds via clock_gettime(CLOCK_MONOTONIC).
fn wall_ms()i64 {
  let ts:[]u8=z_alloc(16);
  sc(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=g32(ts,0) as i64;
  let nsec:i64=g32(ts,8) as i64;
  // Note: g32 reads 32 bits; tv_sec may exceed 32 bits but for
  // duration measurement the low 32 bits suffice.
  z_free(ts);
  return sec*1000+nsec/1000000;
}

// ---------------- JSON parsing ----------------

// Extract "key":"value" (first match). Returns value or "".
fn jget_str(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
// Extract "key":123 (first match, may be negative). Returns 0 if absent.
fn jget_int(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return 0;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){
    v=v*10+((line[s]-48) as i32);
    s=s+1;
  }
  if(neg==1){v=0-v;}
  return v;
}
// Extract "key":{...} (first match, flat object). Returns the {...} or "".
fn jget_obj(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":{");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at-1;
  let e:i32=s+1;
  while(e<line.len && line[e]!=125){e=e+1;}
  if(e>=line.len){return "";}
  return line[s..e+1];
}
// Check if line contains the substring.
fn has_sub(line:[]u8,sub:[]u8)i32 {
  return findsub(line,0,sub)>=0;
}

// ---------------- process spawning ----------------

// Run the contestant binary with (turnpath, statedir), capture stdout.
// Returns bytes captured, or negative on infrastructure failure.
fn run_contestant(bin:[]u8,turnpath:[]u8,statedir:[]u8,out:[]u8,maxb:i32)i32 {
  let fds:[]u8=z_alloc(8);
  if(fds.len==0){return -110;}
  if(sc(22,(_zag_slice_ptr(fds) as i64),0,0,0,0,0)!=0){z_free(fds);return -111;}
  let rfd:i64=g32(fds,0) as i64;
  let wfd:i64=g32(fds,4) as i64;
  z_free(fds);
  let cbin:[]u8=z_cstr(bin);
  let c0:[]u8=z_cstr(bin);
  let c1:[]u8=z_cstr(turnpath);
  let c2:[]u8=z_cstr(statedir);
  let argv:[]u8=z_alloc(4*8);
  p64(argv,0,(_zag_slice_ptr(c0) as i64));
  p64(argv,8,(_zag_slice_ptr(c1) as i64));
  p64(argv,16,(_zag_slice_ptr(c2) as i64));
  p64(argv,24,0);
  let pid:i64=sc(57,0,0,0,0,0,0);
  if(pid<0){
    z_free(cbin);z_free(c0);z_free(c1);z_free(c2);z_free(argv);
    sc(3,rfd,0,0,0,0,0);sc(3,wfd,0,0,0,0,0);
    return -112;
  }
  if(pid==0){
    sc(33,wfd,1,0,0,0,0);
    let dn:[]u8=z_cstr("/dev/null");
    let dfd:i64=sc(2,(_zag_slice_ptr(dn) as i64),1,0,0,0,0);
    if(dfd>=0){sc(33,dfd,2,0,0,0,0);}
    z_free(dn);
    sc(3,rfd,0,0,0,0,0);
    sc(3,wfd,0,0,0,0,0);
    sc(59,(_zag_slice_ptr(cbin) as i64),(_zag_slice_ptr(argv) as i64),0,0,0,0);
    sc(60,127,0,0,0,0,0);
  }
  z_free(cbin);z_free(c0);z_free(c1);z_free(c2);z_free(argv);
  sc(3,wfd,0,0,0,0,0);
  let total:i32=0;
  let base:i64=_zag_slice_ptr(out) as i64;
  let open:i32=1;
  while(open!=0){
    if(total>=maxb){open=0;}
    if(open!=0){
      let n:i64=sc(0,rfd,base+(total as i64),(maxb-total) as i64,0,0,0);
      if(n==0){open=0;}
      if(n>0){total=total+(n as i32);}
      if(n<0){if(n!=-4){open=0;}}
    }
  }
  sc(3,rfd,0,0,0,0,0);
  let st:[]u8=z_alloc(16);
  sc(61,pid,(_zag_slice_ptr(st) as i64),0,0,0,0);
  z_free(st);
  return total;
}

// ---------------- causal simulation ----------------

// causal_sim(tg, p, q, r, dv, vv): dv is "P"/"Q"/"R", vv the value.
// Writes resulting p, q, r into res (12 bytes, little-endian i32s).
fn causal_sim(tg:i32,p:i32,q:i32,r:i32,dv:[]u8,vv:i32,res:[]u8)void {
  if(streq(dv,"P")==1){p=vv;}
  if(streq(dv,"Q")==1){q=vv;}
  if(streq(dv,"R")==1){r=vv;}
  if(tg==0){
    if(streq(dv,"Q")==0){q=p;}
    if(streq(dv,"R")==0){r=q;}
  }
  if(tg==1){
    if(streq(dv,"R")==0){r=p;}
    if(streq(dv,"Q")==0){q=r;}
  }
  if(tg==2){
    if(streq(dv,"P")==0){p=q;}
    if(streq(dv,"R")==0){r=p;}
  }
  p32(res,0,p);
  p32(res,4,q);
  p32(res,8,r);
  return;
}

// ---------------- main driver ----------------

fn main()i32 {
  let worlddir:[]u8=_zag_arg(1);
  let bin:[]u8=_zag_arg(2);
  let outdir:[]u8=_zag_arg(3);
  if(worlddir.len==0 || bin.len==0 || outdir.len==0){return 1;}

  let statedir:[]u8=pjoin(outdir,"state");
  do_mkdir(outdir);
  do_mkdir(statedir);

  // Read key.json, extract true_graph.
  let keypath:[]u8=pjoin(worlddir,"key.json");
  let key:[]u8=read_file(keypath);
  let tg:i32=jget_int(key,"true_graph");

  // Read turns.jsonl.
  let turnspath:[]u8=pjoin(worlddir,"turns.jsonl");
  let turns:[]u8=read_file(turnspath);

  // Output paths.
  let turnjson:[]u8=pjoin(outdir,"turn.json");
  let scorespath:[]u8=pjoin(outdir,"scores.jsonl");
  let repliespath:[]u8=pjoin(outdir,"replies.jsonl");

  // State.
  let bp:i32=0;
  let bq:i32=0;
  let br:i32=0;
  let n_obs:i32=0;
  let n_q:i32=0;
  let n_tool:i32=0;
  let n_correct:i32=0;
  let n_ask:i32=0;
  let n_int:i32=0;
  let synth_turn:i32=900000;

  // Buffers.
  let replybuf:[]u8=z_alloc(65536);
  let scorebuf:[]u8=z_alloc(1048576);
  let score_at:i32=0;
  let repliesbuf:[]u8=z_alloc(4194304);
  let replies_at:i32=0;
  let simres:[]u8=z_alloc(12);

  let start_ms:i64=wall_ms();

  // Iterate lines.
  let p:i32=0;
  while(p<turns.len){
    let e:i32=p;
    while(e<turns.len && turns[e]!=10){e=e+1;}
    let line:[]u8=turns[p..e];
    if(line.len>0){
      let kind:[]u8=jget_str(line,"kind");
      write_file(turnjson,line);
      let reply:[]u8="";
      let rlen:i32=0;

      if(streq(kind,"brief")==1 || streq(kind,"save")==1 || streq(kind,"load")==1 || streq(kind,"end")==1){
        rlen=run_contestant(bin,turnjson,statedir,replybuf,65536);
        if(rlen>0){reply=replybuf[0..rlen];}
      }
      if(streq(kind,"obs")==1){
        n_obs=n_obs+1;
        let t:[]u8=jget_str(line,"t");
        if(streq(t,"cobs")==1){
          let ev:[]u8=jget_obj(line,"ev");
          bp=jget_int(ev,"P");
          bq=jget_int(ev,"Q");
          br=jget_int(ev,"R");
        }
        rlen=run_contestant(bin,turnjson,statedir,replybuf,65536);
        if(rlen>0){reply=replybuf[0..rlen];}
      }
      if(streq(kind,"query")==1){
        n_q=n_q+1;
        let qid:[]u8=jget_str(line,"qid");
        rlen=run_contestant(bin,turnjson,statedir,replybuf,65536);
        if(rlen>0){reply=replybuf[0..rlen];}
        let ans:[]u8=jget_str(reply,"answer");
        let exp:[]u8=jget_str(key,qid);
        // DYNAMIC: compute via causal_sim.
        if(streq(exp,"DYNAMIC")==1){
          let q:[]u8=jget_obj(line,"q");
          let dov:[]u8=jget_str(q,"do");
          let dovv:i32=jget_int(q,"val");
          let askv:[]u8=jget_str(q,"ask");
          causal_sim(tg,bp,bq,br,dov,dovv,simres);
          let v:i32=0;
          if(streq(askv,"P")==1){v=g32(simres,0);}
          if(streq(askv,"Q")==1){v=g32(simres,4);}
          if(streq(askv,"R")==1){v=g32(simres,8);}
          let ebuf:[]u8=z_alloc(12);
          let elen:i32=i32str(ebuf,0,v);
          exp=ebuf[0..elen];
        }
        let correct:i32=0;
        if(streq(ans,exp)==1){correct=1;}
        n_correct=n_correct+correct;
        // Append score line.
        score_at=app(scorebuf,score_at,"{\"qid\":\"");
        score_at=app(scorebuf,score_at,qid);
        score_at=app(scorebuf,score_at,"\",\"expected\":\"");
        score_at=app(scorebuf,score_at,exp);
        score_at=app(scorebuf,score_at,"\",\"answer\":\"");
        score_at=app(scorebuf,score_at,ans);
        score_at=app(scorebuf,score_at,"\",\"correct\":");
        score_at=i32str(scorebuf,score_at,correct);
        score_at=app(scorebuf,score_at,"}\n");
      }
      if(streq(kind,"act")==1){
        let budget:i32=3;
        while(budget>0){
          rlen=run_contestant(bin,turnjson,statedir,replybuf,65536);
          if(rlen>0){reply=replybuf[0..rlen];}else{reply="";}
          if(reply.len==0){budget=0;}
          if(budget>0 && has_sub(reply,"\"tool\"")==0){budget=0;}
          if(budget>0 && reply.len>0 && has_sub(reply,"\"tool\"")==1){
            n_tool=n_tool+1;
            let tool:[]u8=jget_str(reply,"tool");
            let tqid:[]u8=jget_str(reply,"qid");
            let result:[]u8="";
            if(streq(tool,"ask")==1){
              n_ask=n_ask+1;
              result=jget_obj(key,tqid);
            }
            if(streq(tool,"intervene")==1){
              n_int=n_int+1;
              let var:[]u8=jget_str(reply,"var");
              let val:i32=jget_int(reply,"val");
              causal_sim(tg,bp,bq,br,var,val,simres);
              bp=g32(simres,0);
              bq=g32(simres,4);
              br=g32(simres,8);
              let rbuf:[]u8=z_alloc(256);
              let rat:i32=app(rbuf,0,"{\"t\":\"cobs\",\"P\":");
              rat=i32str(rbuf,rat,bp);
              rat=app(rbuf,rat,",\"Q\":");
              rat=i32str(rbuf,rat,bq);
              rat=app(rbuf,rat,",\"R\":");
              rat=i32str(rbuf,rat,br);
              rat=app(rbuf,rat,",\"do\":\"");
              rat=app(rbuf,rat,var);
              rat=app(rbuf,rat,"\",\"val\":");
              rat=i32str(rbuf,rat,val);
              rat=app(rbuf,rat,"}");
              result=rbuf[0..rat];
            }
            if(streq(tool,"ask")==0 && streq(tool,"intervene")==0){
              result="{\"t\":\"none\"}";
            }
            synth_turn=synth_turn+1;
            let tbuf:[]u8=z_alloc(4096+result.len);
            let tat:i32=app(tbuf,0,"{\"turn\":");
            tat=i32str(tbuf,tat,synth_turn);
            tat=app(tbuf,tat,",\"kind\":\"toolresult\",\"qid\":\"");
            tat=app(tbuf,tat,tqid);
            tat=app(tbuf,tat,"\",\"result\":");
            tat=app(tbuf,tat,result);
            tat=app(tbuf,tat,"}");
            write_file(turnjson,tbuf[0..tat]);
            // Ack: invoke and discard.
            let acklen:i32=run_contestant(bin,turnjson,statedir,replybuf,65536);
            let rt:[]u8=jget_str(result,"t");
            if(streq(rt,"cobs")==1){
              bp=jget_int(result,"P");
              bq=jget_int(result,"Q");
              br=jget_int(result,"R");
            }
            write_file(turnjson,line);
            budget=budget-1;
          }
        }
      }
      // Append reply to replies.
      if(reply.len>0){
        replies_at=app(repliesbuf,replies_at,reply);
      }
      replies_at=app1(repliesbuf,replies_at,10);
    }
    p=e+1;
  }

  let end_ms:i64=wall_ms();
  let wall:i64=end_ms-start_ms;

  write_file(scorespath,scorebuf[0..score_at]);
  write_file(repliespath,repliesbuf[0..replies_at]);

  // Stage scores.
  let stages:[]u8="ABCDEFGHTKL";
  let stbuf:[]u8=z_alloc(4096);
  let st_at:i32=0;
  let si:i32=0;
  while(si<stages.len){
    let sc0:u8=stages[si];
    let tot:i32=0;
    let ok:i32=0;
    let sp:i32=0;
    while(sp<score_at){
      let se:i32=sp;
      while(se<score_at && scorebuf[se]!=10){se=se+1;}
      let sline:[]u8=scorebuf[sp..se];
      let qid:[]u8=jget_str(sline,"qid");
      if(qid.len>0 && qid[0]==sc0){
        tot=tot+1;
        if(has_sub(sline,"\"correct\":1")==1){ok=ok+1;}
      }
      sp=se+1;
    }
    st_at=app1(stbuf,st_at,sc0);
    st_at=app1(stbuf,st_at,32);
    st_at=i32str(stbuf,st_at,ok);
    st_at=app1(stbuf,st_at,47);
    st_at=i32str(stbuf,st_at,tot);
    st_at=app1(stbuf,st_at,10);
    si=si+1;
  }
  let stpath:[]u8=pjoin(outdir,"stage_scores.txt");
  write_file(stpath,stbuf[0..st_at]);

  // Costs.
  let statepath:[]u8=pjoin(statedir,"state.txt");
  let statedata:[]u8=read_file(statepath);
  let state_bytes:i32=statedata.len;
  let rsspath:[]u8=pjoin(statedir,"rss.txt");
  let rssdata:[]u8=read_file(rsspath);
  let rss_kb:i32=0;
  if(rssdata.len>0){
    // Parse integer from rss.txt.
    let ri:i32=0;
    while(ri<rssdata.len && (rssdata[ri]<48 || rssdata[ri]>57)){ri=ri+1;}
    while(ri<rssdata.len && rssdata[ri]>=48 && rssdata[ri]<=57){
      rss_kb=rss_kb*10+((rssdata[ri]-48) as i32);
      ri=ri+1;
    }
  }
  let worldname:[]u8=worlddir;
  // Extract basename.
  let bi:i32=worldname.len-1;
  while(bi>0 && worldname[bi]!=47){bi=bi-1;}
  if(worldname[bi]==47){worldname=worldname[bi+1..];}

  let cbuf:[]u8=z_alloc(4096);
  let cat:i32=0;
  cat=app(cbuf,cat,"world=");
  cat=app(cbuf,cat,worldname);
  cat=app1(cbuf,cat,10);
  cat=app(cbuf,cat,"queries=");
  cat=i32str(cbuf,cat,n_q);
  cat=app(cbuf,cat," correct=");
  cat=i32str(cbuf,cat,n_correct);
  cat=app1(cbuf,cat,10);
  cat=app(cbuf,cat,"obs=");
  cat=i32str(cbuf,cat,n_obs);
  cat=app(cbuf,cat," tools=");
  cat=i32str(cbuf,cat,n_tool);
  cat=app(cbuf,cat," ask=");
  cat=i32str(cbuf,cat,n_ask);
  cat=app(cbuf,cat," intervene=");
  cat=i32str(cbuf,cat,n_int);
  cat=app1(cbuf,cat,10);
  cat=app(cbuf,cat,"wall_ms=");
  cat=i64str(cbuf,cat,wall);
  cat=app1(cbuf,cat,10);
  cat=app(cbuf,cat,"state_bytes=");
  cat=i32str(cbuf,cat,state_bytes);
  cat=app1(cbuf,cat,10);
  cat=app(cbuf,cat,"peak_rss_kb=");
  cat=i32str(cbuf,cat,rss_kb);
  cat=app1(cbuf,cat,10);
  let ledgerpath:[]u8=pjoin(statedir,"ledger.txt");
  let ledger:[]u8=read_file(ledgerpath);
  if(ledger.len>0){
    cat=app(cbuf,cat,ledger);
  }
  let costpath:[]u8=pjoin(outdir,"costs.txt");
  write_file(costpath,cbuf[0..cat]);

  // Print costs and stage scores to stdout (matches run_race.sh).
  _zag_print(cbuf[0..cat]);
  _zag_print(stbuf[0..st_at]);
  return 0;
}

// badv.zag -- Adversarial belief formation (Micah Priority H).
// Extends belief.zag with suspected-copy discount and four adversarial
// scenarios: conflicting credible evidence, deceptive source, independent
// vs copied reports, belief reversion.
// Pure Zag. Unfrozen variant. 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// New mechanism: suspected-copy discount. The learner keeps a ring of the
// last 2 observation events (src, hyp, strength). A new report that matches
// another source's (hyp, strength) exactly within that window is treated as
// a suspected copy: contribution quartered (cd=250 per-mille). Genuinely
// independent observations vary, so the heuristic does not fire on them.
//
// Contribution: w * rel * disc * cd / 1000000 (milli-units).

// ============ helpers (verbatim from verified belief.zag) ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ state block: 310 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header cells
// 0 nev, 1 nsrc, 2 wmax, 3 seq_first_contrary, 4 seq_revision,
// 5 s1, 6 s2, 7 truth, 8 abl_rel, 9 abl_ind
fn EVB()i32 { return 16; }    // evidence base cell
fn EVN()i32 { return 32; }    // max evidence records
fn EVW()i32 { return 6; }     // cells per record: qid,hyp,w,src,phase,contrib
fn SRB()i32 { return 208; }   // source base cell
fn SRN()i32 { return 8; }     // max sources
fn SRW()i32 { return 3; }     // cells per source: correct,total,extid
fn DCB()i32 { return 232; }   // discount base cell
fn DCN()i32 { return 16; }    // max (src,hyp,phase) entries
fn DCW()i32 { return 4; }     // cells per entry: src,hyp,phase,count
fn CPB()i32 { return 296; }   // copy ring: head cell
fn CPR()i32 { return 297; }   // copy ring entries base (2 entries x 3 cells: src+1,hyp,w)

fn ST_NONE()i32 { return 0; }
fn ST_PROV()i32 { return 1; }
fn ST_UNC()i32 { return 2; }
fn ST_CONF()i32 { return 3; }

fn st_init(B:[]u8,abl_rel:i32,abl_ind:i32)void {
  let i:i32=0;
  while(i<310){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_rel); cs(B,9,abl_ind);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+2);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+2)==0){
      cs(B,SRB()+i*SRW()+2,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
// reliability per-mille, learned from verification outcomes only.
// neutral 1000 until at least 2 verifications observed.
fn src_rel(B:[]u8,si:i32)i32 {
  if(cg(B,8)==1){ return 1000; }
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      if(cg(B,9)==1){ return 1000; }
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      if(cg(B,9)==1){ return 1000; }
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- suspected-copy discount: ring of last 2 observations ----
// A report matching another source's (hyp,strength) exactly within the
// window is a suspected copy: quartered (250). Otherwise 1000.
fn copy_disc(B:[]u8,si:i32,hyp:i32,w:i32)i32 {
  let i:i32=0;
  while(i<2){
    let o:i32=CPR()+i*3;
    let rs:i32=cg(B,o+0);
    if(rs!=0 && rs!=si+1 && cg(B,o+1)==hyp && cg(B,o+2)==w){
      return 250;
    }
    i=i+1;
  }
  return 1000;
}
fn copy_push(B:[]u8,si:i32,hyp:i32,w:i32)void {
  let h:i32=cg(B,CPB());
  let o:i32=CPR()+h*3;
  cs(B,o+0,si+1); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,CPB(),1-h);
  return;
}

// ---- evidence record ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32)i32 {
  let n:i32=cg(B,0);
  if(n>=EVN()){ return -1; }
  let o:i32=EVB()+n*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib);
  cs(B,0,n+1);
  return n+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- calibration: claim on a verifiable fact; outcome observed ----
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32)void {
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r*1000/1000;
  ev_record(B,0,hyp,w,src,0,contrib);
  note_wmax(B,contrib);
  cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
  if(hyp==truth){ cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1); }
  return;
}

// ---- observation on the H1/H2 question ----
fn ev_observe(B:[]u8,src:i32,hyp:i32,w:i32,phase:i32)i32 {
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let d:i32=disc_for(B,si,hyp,phase);
  let cd:i32=copy_disc(B,si,hyp,w);
  copy_push(B,si,hyp,w);
  let base:i32=w*r*d/1000;
  let contrib:i32=base*cd/1000;
  let seq:i32=ev_record(B,1,hyp,w,src,phase,contrib);
  note_wmax(B,contrib);
  if(hyp==1){ cs(B,5,cg(B,5)+contrib); }
  else { cs(B,6,cg(B,6)+contrib); }
  return seq;
}

// ---- belief status: leader*10 + code ----
fn st_compute(B:[]u8)i32 {
  let s1:i32=cg(B,5); let s2:i32=cg(B,6);
  let wm:i32=cg(B,2);
  if(s1==0 && s2==0){ return 0; }
  let d:i32=s1-s2;
  if(d==0){ return 2; }
  let leader:i32=1;
  if(d<0){ leader=2; }
  let ad:i32=d; if(ad<0){ ad=-ad; }
  let both:i32=0;
  if(s1>0 && s2>0){ both=1; }
  let U:i32=wm; let T:i32=wm*2;
  if(both==1 && ad<=U){ return leader*10+ST_UNC(); }
  if(ad>=T){ return leader*10+ST_CONF(); }
  return leader*10+ST_PROV();
}
fn st_name(code:i32)[]u8 {
  if(code==0){ return "NONE"; }
  if(code==1){ return "PROVISIONAL"; }
  if(code==2){ return "UNCERTAIN"; }
  return "CONFIDENT";
}

// ---- verification: world reveals truth; reliabilities update ----
// Only processes records not yet verified (cell 10 = nverified).
fn ev_verify(B:[]u8,truth:i32)void {
  cs(B,7,truth);
  let start:i32=cg(B,10);
  let i:i32=start;
  while(i<cg(B,0)){
    let o:i32=EVB()+i*EVW();
    if(cg(B,o+0)==1){
      let si:i32=src_idx(B,cg(B,o+3));
      cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
      if(cg(B,o+1)==truth){ cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1); }
    }
    i=i+1;
  }
  cs(B,10,cg(B,0));
  return;
}

fn print_belief(B:[]u8,tag:[]u8)void {
  let st:i32=st_compute(B);
  let leader:i32=st/10; let code:i32=st%10;
  emit(tag); emit(" leader="); e64(leader);
  emit(" status="); emit(st_name(code));
  emit(" s1="); e64(cg(B,5));
  emit(" s2="); e64(cg(B,6));
  emit(" conf="); e64(cg(B,5)-cg(B,6));
  emit(" U="); e64(cg(B,2));
  emit(" T="); e64(cg(B,2)*2);
  emit("\n");
  return;
}
fn print_reliabilities(B:[]u8)void {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+2);
    if(id>0){
      emit("  src="); e64(id-1);
      emit(" correct="); e64(cg(B,SRB()+i*SRW()+0));
      emit(" total="); e64(cg(B,SRB()+i*SRW()+1));
      emit(" rel="); e64(src_rel(B,i));
      emit("\n");
    }
    i=i+1;
  }
  return;
}

// ============ adversarial world scripts ============
// sources: 1=Sb 2=Sc 3=Sd 4=Se 5=Sf 6=Sg 7=Sh 8=Si 9=Sj
//          10=Sm 11=Sn 12=So 13=St 14=Su 15=Sv 16=Sw 17=Sx 18=Sy 19=Sz
// weights: 1 weak, 2 moderate, 3 strong

fn main()i32 {
  let fails:i32=0;

  // ===== Scenario A: conflicting credible evidence =====
  let A:[]u8=z_alloc(1240); st_init(A,0,0);
  ev_calibrate(A,1,2,1,2); ev_calibrate(A,1,2,1,2); // Sb 2/2
  ev_calibrate(A,2,2,1,2); ev_calibrate(A,2,2,1,2); // Sc 2/2
  ev_observe(A,1,1,3,1); // Sb H1 strong
  ev_observe(A,2,2,3,1); // Sc H2 strong
  print_belief(A,"A-conflict:");
  let sta:i32=st_compute(A);
  if(!(sta==2)){ emit("FAIL K1 expect UNCERTAIN (2)\n"); fails=fails+1; }
  else { emit("K1 PASS: conflicting credible -> UNCERTAIN, rational 1/1\n"); }

  // ===== Scenario B: deceptive source =====
  let Bd:[]u8=z_alloc(1240); st_init(Bd,0,0);
  ev_calibrate(Bd,3,1,1,1); ev_calibrate(Bd,3,2,1,2); // Sd 2/2, rel 1000
  ev_observe(Bd,3,1,3,1); // lie 1
  emit("B after lie 1 rel(Sd)="); e64(src_rel(Bd,src_idx(Bd,3))); emit(" (verification pending)\n");
  ev_verify(Bd,2); // truth H2: lie exposed
  emit("B after verify 1: rel(Sd)="); e64(src_rel(Bd,src_idx(Bd,3))); emit(" expect 666\n");
  ev_observe(Bd,3,1,3,2); // lie 2
  ev_verify(Bd,2); // truth H2: lie exposed again
  let rel2:i32=src_rel(Bd,src_idx(Bd,3));
  emit("B after verify 2: rel(Sd)="); e64(rel2); emit(" expect 500\n");
  if(!(rel2==500)){ emit("FAIL K2a expect rel 500\n"); fails=fails+1; }
  // third strong claim from the liar
  let s1before:i32=cg(Bd,5);
  ev_observe(Bd,3,1,3,3);
  let contrib3:i32=cg(Bd,5)-s1before;
  emit("B liar third claim contrib="); e64(contrib3); emit(" expect 1500\n");
  if(!(contrib3==1500)){ emit("FAIL K2b expect contrib 1500\n"); fails=fails+1; }
  if(rel2==500 && contrib3==1500){ emit("K2 PASS: liar detected and discounted, rational 1/1\n"); }

  // ===== Scenario C: copied trio =====
  let Cc:[]u8=z_alloc(1240); st_init(Cc,0,0);
  ev_observe(Cc,4,1,3,1); // Se H1 strong (originator)
  ev_observe(Cc,5,1,3,1); // Sf H1 strong (suspected copy)
  ev_observe(Cc,6,1,3,1); // Sg H1 strong (suspected copy)
  print_belief(Cc,"C-copied:");
  let stc:i32=st_compute(Cc);
  if(!(stc==11)){ emit("FAIL K3a expect PROVISIONAL H1 (11)\n"); fails=fails+1; }
  else { emit("K3a PASS: parroted reports not overcounted, rational 1/1\n"); }

  // ===== Scenario C: independent trio =====
  // Strengths all differ (3,2,1): no copy discount fires on genuinely
  // independent reports. (Prereg operationalization fix: the original
  // (3,2,3) pattern left Sh's (H1,3) in the copy window when Sj reported,
  // which is a false positive the independent condition must avoid.)
  let Ci:[]u8=z_alloc(1240); st_init(Ci,0,0);
  ev_observe(Ci,7,1,3,1); // Sh H1 strong
  ev_observe(Ci,8,1,2,1); // Si H1 moderate
  ev_observe(Ci,9,1,1,1); // Sj H1 weak
  print_belief(Ci,"C-indep:");
  let sti:i32=st_compute(Ci);
  if(!(sti==13)){ emit("FAIL K3b expect CONFIDENT H1 (13)\n"); fails=fails+1; }
  else { emit("K3b PASS: genuine consensus earns confidence, rational 1/1\n"); }

  // ===== Scenario D: belief reversion =====
  let D:[]u8=z_alloc(1240); st_init(D,0,0);
  ev_observe(D,10,2,3,1); // Sm H2 strong: 3000
  ev_observe(D,11,2,2,1); // Sn H2 moderate: 2000
  ev_observe(D,12,2,1,1); // So H2 weak: 1000
  print_belief(D,"D-setup:");
  let std0:i32=st_compute(D);
  if(!(std0==23)){ emit("FAIL D setup expect CONFIDENT H2 (23)\n"); fails=fails+1; }
  // D1: one strong contrary report
  ev_observe(D,13,1,3,2); // St H1 strong: 3000
  print_belief(D,"D1-weak-resurface:");
  let std1:i32=st_compute(D);
  if(!(std1==22)){ emit("FAIL K4a expect UNCERTAIN (22)\n"); fails=fails+1; }
  else { emit("K4a PASS: strong contrary creates uncertainty, not flip, rational 1/1\n"); }
  // D2: sustained independent H1 evidence (strengths vary: no copy discount
  // except Sy, which parrots Sw and is correctly quartered)
  ev_observe(D,14,1,2,2); // Su H1 moderate: 2000
  ev_observe(D,15,1,1,2); // Sv H1 weak: 1000
  ev_observe(D,16,1,3,2); // Sw H1 strong: 3000
  ev_observe(D,17,1,2,2); // Sx H1 moderate: 2000
  ev_observe(D,18,1,3,2); // Sy H1 strong: suspected copy of Sw, 750
  ev_observe(D,19,1,1,2); // Sz H1 weak: 1000
  print_belief(D,"D2-strong-resurface:");
  let std2:i32=st_compute(D);
  if(!(std2==13)){ emit("FAIL K4b expect CONFIDENT H1 (13)\n"); fails=fails+1; }
  else { emit("K4b PASS: rational reversion to H1, rational 1/1\n"); }

  if(fails==0){ emit("ALL PASS\n"); return 0; }
  emit("FAILURES: "); e64(fails); emit("\n");
  return 1;
}

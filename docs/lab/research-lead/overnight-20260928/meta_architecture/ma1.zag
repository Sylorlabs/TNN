// ma1.zag -- MA1: multi-cell competitive means with failure-pattern
// selection and reallocation. Neutral identifiers only.
//
// Blocks: D = 12 episodes, R = 660, B2 = 60.
// Conditions: X = 732 episodes (D+R+B2), Y = 720 (R+B2), Z = 732 (D+R+B2).
// X and Y use the 4-cell mechanism; Z uses the single accumulating mean.
// Cell state: (sum, n, score). Empty cell predicts 50.
// Per episode: every cell predicts; active = argmin score (ties: lowest
// index); frozen etc_ep uses the active mean; after the reveal every
// score updates by EMA 3/4 of |prediction - value|; the winner (argmin
// error, ties: lowest index) absorbs the value; consec tallies
// consecutive active errors > 20; at 3 the highest-score cell among
// non-active non-winner cells is reseeded at the current value.
// No block labels reach the cells.

// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access (u8-backed cells) ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- arena layout ----
// 0 prng(8) | 8 pX[732](2928) | 2936 pY[720](2880) | 5816 pZ[732](2928) |
// 8744 fX[878400] | 887144 fY[864000] | 1751144 fZ[878400] |
// 2629544 eX[732](2928) | 2632472 eY[720](2880) | 2635352 eZ[732](2928) |
// 2638280 mXa[732](2928) | 2641208 mYa[720](2880) | 2644088 mZ[732](2928) |
// 2647016 genfail(4) | 2647020 tmp9(36) | 2647056 tmp3(12) |
// 2647068 tmp9r(36) | 2647104 tmp9b(36) |
// 2647140 cellsX(56): sum[4](16) n[4](16) sco[4](16) consec(4) trig(4) |
// 2647196 cellsY(56) | 2647252 terr[4](16) |
// 2647268 tlogX[32](128) | 2647396 tlogY[32](128) |
// 2647524 b5gok(4) |
// 2647528 snapXD(48) | 2647576 snapXR(48) | 2647624 snapXB(48) |
// 2647672 snapYR(48) | 2647720 snapYB(48)
// ---- episode generation (frozen harness) ----
fn gen(G:[]u8)void {
  s64(G,0,20261020);
  let t9:i32=2647020;
  let t3:i32=2647056;
  let t9r:i32=2647068;
  let t9b:i32=2647104;
  let i:i32=0;
  while(i<9){ set32(G,t9+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,t9+i*4);
    set32(G,t9+i*4,get32(G,t9+j*4));
    set32(G,t9+j*4,a);
    i=i+1;
  }
  set32(G,t3,40); set32(G,t3+4,47); set32(G,t3+8,54);
  i=0;
  while(i<3){
    let j2:i32=i+rnd(G,3-i);
    let a2:i32=get32(G,t3+i*4);
    set32(G,t3+i*4,get32(G,t3+j2*4));
    set32(G,t3+j2*4,a2);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9r+i*4,76+i); i=i+1; }
  i=0;
  while(i<9){
    let j3:i32=i+rnd(G,9-i);
    let a3:i32=get32(G,t9r+i*4);
    set32(G,t9r+i*4,get32(G,t9r+j3*4));
    set32(G,t9r+j3*4,a3);
    i=i+1;
  }
  i=0;
  while(i<9){ set32(G,t9b+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j4:i32=i+rnd(G,9-i);
    let a4:i32=get32(G,t9b+i*4);
    set32(G,t9b+i*4,get32(G,t9b+j4*4));
    set32(G,t9b+j4*4,a4);
    i=i+1;
  }
  let s:i32=0;
  let e:i32=0;
  while(e<732){
    let v:i32=0;
    if(e<12){
      if(e==3){ v=get32(G,t3); }
      else {
        if(e==7){ v=get32(G,t3+4); }
        else {
          if(e==11){ v=get32(G,t3+8); }
          else { v=get32(G,t9+s*4); s=s+1; }
        }
      }
    }
    else {
      if(e<672){ v=get32(G,t9r+((e-12)%9)*4); }
      else { v=get32(G,t9b+((e-672)%9)*4); }
    }
    set32(G,8+e*4,v);
    set32(G,5816+e*4,v);
    e=e+1;
  }
  e=0;
  while(e<720){
    let v2:i32=0;
    if(e<660){ v2=get32(G,t9r+(e%9)*4); }
    else { v2=get32(G,t9b+((e-660)%9)*4); }
    set32(G,2936+e*4,v2);
    e=e+1;
  }
  s64(G,0,20261021);
  e=0;
  while(e<732){
    let pv:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<pv){ f=1; }
      G[8744+e*1200+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  s64(G,0,20261022);
  e=0;
  while(e<720){
    let pv2:i32=get32(G,2936+e*4);
    let k2:i32=0;
    while(k2<1200){
      let d2:i32=rnd(G,100);
      let f2:i32=0;
      if(d2<pv2){ f2=1; }
      G[887144+e*1200+k2]=f2 as u8;
      k2=k2+1;
    }
    e=e+1;
  }
  s64(G,0,20261023);
  e=0;
  while(e<732){
    let pv3:i32=get32(G,5816+e*4);
    let k3:i32=0;
    while(k3<1200){
      let d3:i32=rnd(G,100);
      let f3:i32=0;
      if(d3<pv3){ f3=1; }
      G[1751144+e*1200+k3]=f3 as u8;
      k3=k3+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode (byte-identical to lm2) ----
// m: current mean (hundredths). Returns smallest n in 1..1200 with
// |est_n - p| < 5, else 1201. Exact integer comparison, no division.
fn etc_ep(G:[]u8,e:i32,m:i32,fbase:i32,pbase:i32)i32 {
  let mi:i64=m as i64;
  let pi:i64=get32(G,pbase+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=1200){
    h=h+(G[fbase+e*1200+n-1] as i64);
    let num:i64=20*mi+100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<5*den){ return n; }
    n=n+1;
  }
  return 1201;
}
// ---- snapshot 4 cells: sums, ns, scores ----
fn snap(G:[]u8,cb:i32,sb:i32)void {
  let i:i32=0;
  while(i<4){
    set32(G,sb+i*4,get32(G,cb+i*4));
    set32(G,sb+16+i*4,get32(G,cb+16+i*4));
    set32(G,sb+32+i*4,get32(G,cb+32+i*4));
    i=i+1;
  }
  return;
}
// ---- multi-cell condition ----
// cb: cell base (sums +0, ns +16, scores +32, consec +48, trig +52)
// isx=1: condition X (has block D: episodes 0..11; R: 12..671; B2: 672..731)
// isx=0: condition Y (R: 0..659; B2: 660..719)
fn run_multi(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,cb:i32,snapD:i32,snapR:i32,snapB:i32,tlog:i32,ne:i32,isx:i32)void {
  let e:i32=0;
  while(e<ne){
    let a:i32=0;
    let bi:i32=1;
    while(bi<4){
      if(get32(G,cb+32+bi*4)<get32(G,cb+32+a*4)){ a=bi; }
      bi=bi+1;
    }
    let m:i32=50;
    let an:i32=get32(G,cb+16+a*4);
    if(an>0){ m=get32(G,cb+a*4)/an; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    let vs:i32=get32(G,pbase+e*4);
    let w:i32=0;
    let erra:i32=0;
    let ei:i32=0;
    while(ei<4){
      let pr:i32=50;
      let cn:i32=get32(G,cb+16+ei*4);
      if(cn>0){ pr=get32(G,cb+ei*4)/cn; }
      let er:i32=pr-vs;
      if(er<0){ er=0-er; }
      set32(G,2647252+ei*4,er);
      let sc:i32=get32(G,cb+32+ei*4);
      set32(G,cb+32+ei*4,(3*sc+er)/4);
      if(ei==0){ w=0; }
      else {
        if(er<get32(G,2647252+w*4)){ w=ei; }
      }
      if(ei==a){ erra=er; }
      ei=ei+1;
    }
    set32(G,cb+w*4,get32(G,cb+w*4)+vs);
    set32(G,cb+16+w*4,get32(G,cb+16+w*4)+1);
    let cc:i32=get32(G,cb+48);
    if(erra>20){ cc=cc+1; } else { cc=0; }
    if(cc>=3){
      let v:i32=-1;
      let vi:i32=3;
      while(vi>=0){
        let ok:i32=1;
        if(vi==a){ ok=0; }
        if(vi==w){ ok=0; }
        if(ok==1){
          if(v==-1){ v=vi; }
          else {
            let s1:i32=get32(G,cb+32+vi*4);
            let s2:i32=get32(G,cb+32+v*4);
            if(s1>s2){ v=vi; }
          }
        }
        vi=vi-1;
      }
      set32(G,cb+v*4,vs);
      set32(G,cb+16+v*4,1);
      set32(G,cb+32+v*4,0);
      cc=0;
      let tg:i32=get32(G,cb+52);
      if(tg<32){ set32(G,tlog+tg*4,e); }
      set32(G,cb+52,tg+1);
    }
    set32(G,cb+48,cc);
    if(isx==1){
      if(e==11){
        if(get32(G,cb)==180){
          if(get32(G,cb+16)==9){ set32(G,2647524,1); }
        }
        snap(G,cb,snapD);
      }
      if(e==671){ snap(G,cb,snapR); }
      if(e==731){ snap(G,cb,snapB); }
    }
    else {
      if(e==659){ snap(G,cb,snapR); }
      if(e==719){ snap(G,cb,snapB); }
    }
    e=e+1;
  }
  return;
}
// ---- single-cell condition (MD treatment rule) ----
fn run_single(G:[]u8,eoff:i32,fbase:i32,pbase:i32,moff:i32,ne:i32)void {
  let sum:i32=0;
  let n:i32=0;
  let e:i32=0;
  while(e<ne){
    let m:i32=50;
    if(n>0){ m=sum/n; }
    set32(G,moff+e*4,m);
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    sum=sum+get32(G,pbase+e*4);
    n=n+1;
    e=e+1;
  }
  return;
}
// ---- zero-padded episode label ----
fn o_e4(b:[]u8,c:i32,e:i32)i32 {
  let en:i32=e+1;
  c=o_app(b,c,"E");
  if(en<1000){ c=o_app(b,c,"0"); }
  if(en<100){ c=o_app(b,c,"0"); }
  if(en<10){ c=o_app(b,c,"0"); }
  c=o_i64(b,c,en as i64);
  return c;
}
fn main()i32 {
  let p:*u8=_zag_malloc(3145728) as *u8;
  let G:[]u8=p[0..3145728];
  let z:i32=0;
  while(z<3145728){ G[z]=0; z=z+1; }
  gen(G);
  run_multi(G,2629544,8744,8,2638280,2647140,2647528,2647576,2647624,2647268,732,1);
  run_multi(G,2632472,887144,2936,2641208,2647196,0,2647672,2647720,2647396,720,0);
  run_single(G,2635352,1751144,5816,2644088,732);
  // ---- frozen metrics ----
  let rx:i32=0;
  let e:i32=12;
  while(e<672){
    let mm:i32=get32(G,2638280+e*4);
    let dd:i32=mm-80;
    if(dd<0){ dd=0-dd; }
    if(dd<=1){ if(rx==0){ rx=e-11; } }
    e=e+1;
  }
  let ry:i32=0;
  e=0;
  while(e<660){
    let mm2:i32=get32(G,2641208+e*4);
    let dd2:i32=mm2-80;
    if(dd2<0){ dd2=0-dd2; }
    if(dd2<=1){ if(ry==0){ ry=e+1; } }
    e=e+1;
  }
  let rz:i32=0;
  e=12;
  while(e<672){
    let mm3:i32=get32(G,2644088+e*4);
    let dd3:i32=mm3-80;
    if(dd3<0){ dd3=0-dd3; }
    if(dd3<=1){ if(rz==0){ rz=e-11; } }
    e=e+1;
  }
  let rxf:i32=0;
  let k:i32=1;
  while(k<=660){
    let mx:i32=get32(G,2638280+(11+k)*4);
    let my:i32=get32(G,2641208+(k-1)*4);
    let ddf:i32=mx-my;
    if(ddf<0){ ddf=0-ddf; }
    if(ddf<=1){ if(rxf==0){ rxf=k; } }
    k=k+1;
  }
  let costxy:i64=0;
  let costxz:i64=0;
  e=12;
  while(e<672){
    costxy=costxy+(get32(G,2629544+e*4) as i64)-(get32(G,2632472+(e-12)*4) as i64);
    costxz=costxz+(get32(G,2629544+e*4) as i64)-(get32(G,2635352+e*4) as i64);
    e=e+1;
  }
  let rxb2:i32=0;
  e=672;
  while(e<732){
    let mmb:i32=get32(G,2638280+e*4);
    let ddb:i32=mmb-20;
    if(ddb<0){ ddb=0-ddb; }
    if(ddb<=1){ if(rxb2==0){ rxb2=e-671; } }
    e=e+1;
  }
  // ---- bars ----
  let b5a:i32=0;
  if(rx>=1){ if(rx<=99){ b5a=1; } }
  let b5b:i32=0;
  if(rz>=500){ b5b=1; }
  let b5c:i32=0;
  if(costxy<4690){ b5c=1; }
  let b5d:i32=0;
  if(rxb2>=1){ if(rxb2<=30){ b5d=1; } }
  let mxe:i32=0;
  e=0;
  while(e<732){
    let a1:i32=get32(G,2629544+e*4);
    if(a1>mxe){ mxe=a1; }
    let a3:i32=get32(G,2635352+e*4);
    if(a3>mxe){ mxe=a3; }
    e=e+1;
  }
  e=0;
  while(e<720){
    let a2:i32=get32(G,2632472+e*4);
    if(a2>mxe){ mxe=a2; }
    e=e+1;
  }
  let b5e:i32=0;
  if(mxe<=1200){ if(get32(G,2647016)==0){ b5e=1; } }
  // B4a: 12 block-D parameters pairwise distinct
  let db:i32=1;
  let i2:i32=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      if(get32(G,8+i2*4)==get32(G,8+j*4)){ db=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  // XDISJ: same-episode flip vectors differ across conditions
  let xd:i32=1;
  e=0;
  while(e<660){
    if(veq(G,8744+(12+e)*1200,887144+e*1200,1200)==1){ xd=0; }
    if(veq(G,8744+(12+e)*1200,1751144+(12+e)*1200,1200)==1){ xd=0; }
    if(veq(G,887144+e*1200,1751144+(12+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(veq(G,8744+(672+e)*1200,887144+(660+e)*1200,1200)==1){ xd=0; }
    if(veq(G,8744+(672+e)*1200,1751144+(672+e)*1200,1200)==1){ xd=0; }
    if(veq(G,887144+(660+e)*1200,1751144+(672+e)*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  // PARID: parameters identical across conditions
  let parid:i32=1;
  e=0;
  while(e<732){
    if(get32(G,8+e*4)!=get32(G,5816+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<660){
    if(get32(G,8+(12+e)*4)!=get32(G,2936+e*4)){ parid=0; }
    e=e+1;
  }
  e=0;
  while(e<60){
    if(get32(G,8+(672+e)*4)!=get32(G,2936+(660+e)*4)){ parid=0; }
    e=e+1;
  }
  // MARG: per-condition per-block ones-fraction in [0.30, 0.95]
  let sXd:i64=0;
  let kk:i32=0;
  while(kk<14400){ sXd=sXd+(G[8744+kk] as i64); kk=kk+1; }
  let sXr:i64=0;
  kk=0;
  while(kk<792000){ sXr=sXr+(G[8744+14400+kk] as i64); kk=kk+1; }
  let sXb:i64=0;
  kk=0;
  while(kk<72000){ sXb=sXb+(G[8744+806400+kk] as i64); kk=kk+1; }
  let sYr:i64=0;
  kk=0;
  while(kk<792000){ sYr=sYr+(G[887144+kk] as i64); kk=kk+1; }
  let sYb:i64=0;
  kk=0;
  while(kk<72000){ sYb=sYb+(G[887144+792000+kk] as i64); kk=kk+1; }
  let sZd:i64=0;
  kk=0;
  while(kk<14400){ sZd=sZd+(G[1751144+kk] as i64); kk=kk+1; }
  let sZr:i64=0;
  kk=0;
  while(kk<792000){ sZr=sZr+(G[1751144+14400+kk] as i64); kk=kk+1; }
  let sZb:i64=0;
  kk=0;
  while(kk<72000){ sZb=sZb+(G[1751144+806400+kk] as i64); kk=kk+1; }
  let mg:i32=1;
  if(sXd<2880){ mg=0; } if(sXd>5040){ mg=0; }
  if(sXr<554400){ mg=0; } if(sXr>712800){ mg=0; }
  if(sXb<8640){ mg=0; } if(sXb>20160){ mg=0; }
  if(sYr<554400){ mg=0; } if(sYr>712800){ mg=0; }
  if(sYb<8640){ mg=0; } if(sYb>20160){ mg=0; }
  if(sZd<2880){ mg=0; } if(sZd>5040){ mg=0; }

// race_tnn.zag - TNN contestant for the lifetime-learning race (pure Zag).
// Usage: race_tnn <turn.json> <statedir>
// Reads one turn, updates persistent state in <statedir>/state.txt,
// prints exactly one JSON reply line to stdout. No timestamps in replies.
// State is a line buffer; lines use \x01 (byte 1) as field separator.
// Line kinds: F fact, R relation, H hypothesis weight, E causal episode,
// D proc demo, V vocab, M causal mask, B causal baseline, Q pending query.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn app1(buf:[]u8,at:i32,c:u8)i32 { buf[at]=c; return at+1; }
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
  if(neg==1){v=-v;}
  return v;
}
fn jarr(line:[]u8,key:[]u8,idx:i32)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":[");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let n:i32=0;
  while(s<line.len && line[s]!=93){
    if(line[s]==34){
      let e:i32=s+1;
      while(e<line.len && line[e]!=34){e=e+1;}
      if(n==idx){return line[s+1..e];}
      n=n+1;
      s=e+1;
    } else { s=s+1; }
  }
  return "";
}
fn jarr_len(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":[");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return 0;}
  let s:i32=p+at;
  let n:i32=0;
  while(s<line.len && line[s]!=93){
    if(line[s]==34){
      let e:i32=s+1;
      while(e<line.len && line[e]!=34){e=e+1;}
      n=n+1;
      s=e+1;
    } else { s=s+1; }
  }
  return n;
}
// parse decimal from slice
fn atoi(s:[]u8)i32 {
  let i:i32=0;
  let neg:i32=0;
  if(s.len>0 && s[0]==45){neg=1;i=1;}
  let v:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  if(neg==1){v=-v;}
  return v;
}
// line helpers: lines separated by \n (10), fields by \x01 (1)
fn line_start(buf:[]u8,at:i32)i32 {
  // returns offset of line with index at (0-based), -1 if none
  let i:i32=0;
  let n:i32=0;
  if(at==0){return 0;}
  while(i<buf.len){
    if(buf[i]==10){n=n+1; if(n==at){return i+1;}}
    i=i+1;
  }
  return -1;
}
fn line_end(buf:[]u8,off:i32)i32 {
  let i:i32=off;
  while(i<buf.len && buf[i]!=10){i=i+1;}
  return i;
}
fn nlines(buf:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<buf.len){if(buf[i]==10){n=n+1;}i=i+1;}
  return n;
}
// idx-th \x01 field of line slice (0-based)
fn getfld(line:[]u8,idx:i32)[]u8 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=line.len){
    if(i==line.len || line[i]==1){
      if(n==idx){return line[s..i];}
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return "";
}
// find first line whose first two fields are tag,f1 (f1="" matches tag only)
fn find_line2(buf:[]u8,tag:[]u8,f1:[]u8)i32 {
  let nl:i32=nlines(buf);
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    if(streq(getfld(ln,0),tag)==1){
      if(f1.len==0 || streq(getfld(ln,1),f1)==1){return li;}
    }
    li=li+1;
  }
  return -1;
}
fn append_line(buf:[]u8,at:i32,line:[]u8)i32 {
  let n:i32=app(buf,at,line);
  buf[n]=10;
  return n+1;
}
fn fnv(buf:[]u8)i64 {
  let h:i64=1469598103934665603;
  let i:i32=0;
  while(i<buf.len){
    h=h ^ (buf[i] as i64);
    h=h*1099511628211;
    i=i+1;
  }
  return h;
}
// ---- ingest: returns new buffer length ----
// fact: F\x01s\x01a\x01v\x01src\x01rel\x01turn\x01sup\x01dep
fn ingest_fact(buf:[]u8,at:i32,s:[]u8,a:[]u8,v:[]u8,src:[]u8,rel:i32,turn:i32)i32 {
  // supersede existing non-superseded (s,a) with rel <= new rel
  let nl:i32=nlines(buf);
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    if(streq(getfld(ln,0),"F")==1 && streq(getfld(ln,1),s)==1 && streq(getfld(ln,2),a)==1 && streq(getfld(ln,7),"0")==1){
      let orel:i32=atoi(getfld(ln,5));
      if(orel<=rel){
        // flip sup field in place: find 7th field offset
        let k:i32=0;
        let nf:i32=0;
        let p:i32=off;
        while(p<e){
          if(buf[p]==1){nf=nf+1; if(nf==7){buf[p+1]=49;}}
          p=p+1;
        }
      }
    }
    li=li+1;
  }
  // count facts for cap
  let nf2:i32=0;
  li=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    if(streq(getfld(buf[off..e],0),"F")==1){nf2=nf2+1;}
    li=li+1;
  }
  if(nf2>=1500){
    // evict lowest merit fact: merit = rel*1000 + dep*100 - turn
    let worst:i32=-1;
    let wmer:i64=9223372036854775807;
    li=0;
    while(li<nl){
      let off:i32=line_start(buf,li);
      let e:i32=line_end(buf,off);
      let ln:[]u8=buf[off..e];
      if(streq(getfld(ln,0),"F")==1){
        let m:i64=(atoi(getfld(ln,5)) as i64)*1000+(atoi(getfld(ln,8)) as i64)*100-(atoi(getfld(ln,6)) as i64);
        if(m<wmer){wmer=m;worst=li;}
      }
      li=li+1;
    }
    if(worst>=0){
      // delete line worst by memmove
      let off:i32=line_start(buf,worst);
      let e:i32=line_end(buf,worst)+1;
      let k:i32=off;
      while(e+k-off<at){buf[k]=buf[e+k-off];k=k+1;}
      at=at-(e-off);
      nl=nl-1;
    }
  }
  let lb:[]u8=z_alloc(s.len+a.len+v.len+src.len+64);
  let n:i32=app(lb,0,"F");
  n=app1(lb,n,1); n=app(lb,n,s);
  n=app1(lb,n,1); n=app(lb,n,a);
  n=app1(lb,n,1); n=app(lb,n,v);
  n=app1(lb,n,1); n=app(lb,n,src);
  n=app1(lb,n,1); n=app(lb,n,i32s(rel));
  n=app1(lb,n,1); n=app(lb,n,i32s(turn));
  n=app1(lb,n,1); n=app(lb,n,"0");
  n=app1(lb,n,1); n=app(lb,n,"0");
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  return at;
}
// relation: R\x01a\x01r\x01b\x01rel\x01turn  (cap 800, same merit w/o dep)
fn ingest_rel(buf:[]u8,at:i32,a:[]u8,r:[]u8,b:[]u8,rel:i32,turn:i32)i32 {
  let nl:i32=nlines(buf);
  let nr:i32=0;
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    if(streq(getfld(buf[off..e],0),"R")==1){nr=nr+1;}
    li=li+1;
  }
  if(nr>=800){
    let worst:i32=-1;
    let wmer:i64=9223372036854775807;
    li=0;
    while(li<nl){
      let off:i32=line_start(buf,li);
      let e:i32=line_end(buf,off);
      let ln:[]u8=buf[off..e];
      if(streq(getfld(ln,0),"R")==1){
        let m:i64=(atoi(getfld(ln,4)) as i64)*1000-(atoi(getfld(ln,5)) as i64);
        if(m<wmer){wmer=m;worst=li;}
      }
      li=li+1;
    }
    if(worst>=0){
      let off:i32=line_start(buf,worst);
      let e:i32=line_end(buf,worst)+1;
      let k:i32=off;
      while(e+k-off<at){buf[k]=buf[e+k-off];k=k+1;}
      at=at-(e-off);
    }
  }
  let lb:[]u8=z_alloc(a.len+r.len+b.len+48);
  let n:i32=app(lb,0,"R");
  n=app1(lb,n,1); n=app(lb,n,a);
  n=app1(lb,n,1); n=app(lb,n,r);
  n=app1(lb,n,1); n=app(lb,n,b);
  n=app1(lb,n,1); n=app(lb,n,i32s(rel));
  n=app1(lb,n,1); n=app(lb,n,i32s(turn));
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  return at;
}
// hypothesis weight: H\x01hid\x01w
fn ingest_claim(buf:[]u8,at:i32,hid:[]u8,w:i32)i32 {
  let li:i32=find_line2(buf,"H",hid);
  if(li>=0){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    let nw:i32=atoi(getfld(ln,2))+w;
    // rewrite line in place if same length, else rebuild
    let nb:[]u8=z_alloc(hid.len+24);
    let n:i32=app(nb,0,"H");
    n=app1(nb,n,1); n=app(nb,n,hid);
    n=app1(nb,n,1); n=app(nb,n,i32s(nw));
    let nbl:i32=n;
    // replace line li
    let loff:i32=line_start(buf,li);
    let le:i32=line_end(buf,loff);
    let llen:i32=le-loff;
    if(nbl==llen){
      let k:i32=0;
      while(k<nbl){buf[loff+k]=nb[k];k=k+1;}
    } else {
      // delete old, append new
      let k:i32=loff;
      while(le+1+k-loff<at){buf[k]=buf[le+1+k-loff];k=k+1;}
      at=at-(le+1-loff);
      at=append_line(buf,at,nb[0..nbl]);
    }
    z_free(nb);
    return at;
  }
  let lb:[]u8=z_alloc(hid.len+24);
  let n:i32=app(lb,0,"H");
  n=app1(lb,n,1); n=app(lb,n,hid);
  n=app1(lb,n,1); n=app(lb,n,i32s(w));
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  return at;
}
// causal episode: E\x01p\x01q\x01r ; also updates baseline B
fn ingest_cobs(buf:[]u8,at:i32,p:i32,q:i32,r:i32)i32 {
  let lb:[]u8=z_alloc(32);
  let n:i32=app(lb,0,"E");
  n=app1(lb,n,1); n=app(lb,n,i32s(p));
  n=app1(lb,n,1); n=app(lb,n,i32s(q));
  n=app1(lb,n,1); n=app(lb,n,i32s(r));
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  // rewrite baseline B line
  let li:i32=find_line2(buf,"B","");
  let nb:[]u8=z_alloc(32);
  let m:i32=app(nb,0,"B");
  m=app1(nb,m,1); m=app(nb,m,i32s(p));
  m=app1(nb,m,1); m=app(nb,m,i32s(q));
  m=app1(nb,m,1); m=app(nb,m,i32s(r));
  if(li>=0){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let k:i32=off;
    while(e+1+k-off<at){buf[k]=buf[e+1+k-off];k=k+1;}
    at=at-(e+1-off);
  }
  at=append_line(buf,at,nb[0..m]);
  z_free(nb);
  return at;
}
// proc demo: D\x01proc\x01in\x01out\x01turn\x01sup
fn ingest_demo(buf:[]u8,at:i32,proc:[]u8,in:[]u8,out:[]u8,turn:i32)i32 {
  let lb:[]u8=z_alloc(proc.len+in.len+out.len+48);
  let n:i32=app(lb,0,"D");
  n=app1(lb,n,1); n=app(lb,n,proc);
  n=app1(lb,n,1); n=app(lb,n,in);
  n=app1(lb,n,1); n=app(lb,n,out);
  n=app1(lb,n,1); n=app(lb,n,i32s(turn));
  n=app1(lb,n,1); n=app(lb,n,"0");
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  return at;
}
// law: supersede all demos of proc
fn ingest_law(buf:[]u8,at:i32,proc:[]u8)i32 {
  let nl:i32=nlines(buf);
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    if(streq(getfld(ln,0),"D")==1 && streq(getfld(ln,1),proc)==1){
      // flip sup field (5th field, index 5) in place
      let nf:i32=0;
      let p:i32=off;
      while(p<e){
        if(buf[p]==1){nf=nf+1; if(nf==5){buf[p+1]=49;}}
        p=p+1;
      }
    }
    li=li+1;
  }
  return at;
}
// vocab: V\x01w\x01g
fn ingest_vocab(buf:[]u8,at:i32,w:[]u8,g:[]u8)i32 {
  let lb:[]u8=z_alloc(w.len+g.len+16);
  let n:i32=app(lb,0,"V");
  n=app1(lb,n,1); n=app(lb,n,w);
  n=app1(lb,n,1); n=app(lb,n,g);
  at=append_line(buf,at,lb[0..n]);
  z_free(lb);
  return at;
}
// ---- query answering (each returns answer slice; "" means UNKNOWN-ish handled by caller) ----
fn ans_attr(buf:[]u8,at:i32,s:[]u8,a:[]u8)[]u8 {
  let nl:i32=nlines(buf);
  let best:i32=-1;
  let brel:i32=-1;
  let bturn:i32=-1;
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    if(streq(getfld(ln,0),"F")==1 && streq(getfld(ln,1),s)==1 && streq(getfld(ln,2),a)==1 && streq(getfld(ln,7),"0")==1){
      let r:i32=atoi(getfld(ln,5));
      let t:i32=atoi(getfld(ln,6));
      if(r>brel || (r==brel && t>bturn)){brel=r;bturn=t;best=li;}
    }
    li=li+1;
  }
  if(best<0){return "UNKNOWN";}
  // bump dep in place (field 8)
  let off:i32=line_start(buf,best);
  let e:i32=line_end(buf,off);
  let nf:i32=0;
  let p:i32=off;
  let dp:i32=-1;
  while(p<e){
    if(buf[p]==1){nf=nf+1; if(nf==8){dp=p+1;}}
    p=p+1;
  }
  if(dp>0){
    // dep is small int; parse, inc, rewrite (may grow length; keep simple: cap display)
    let q:i32=dp;
    while(q<e && buf[q]!=1 && buf[q]!=10){q=q+1;}
    let d:i32=atoi(buf[dp..q])+1;
    let ds:[]u8=i32s(d);
    if(ds.len==(q-dp)){
      let k:i32=0;
      while(k<ds.len){buf[dp+k]=ds[k];k=k+1;}
    }
  }
  let ln2:[]u8=buf[off..e];
  return getfld(ln2,3);
}
fn ans_chain(buf:[]u8,at:i32,line:[]u8,a:[]u8)[]u8 {
  let cur:[]u8=a;
  let n:i32=jarr_len(line,"rs");
  let i:i32=0;
  while(i<n){
    let r:[]u8=jarr(line,"rs",i);
    // find best R with f1==cur, f2==r
    let nl:i32=nlines(buf);
    let li:i32=0;
    let found:[]u8="";
    let brel:i32=-1;
    while(li<nl){
      let off:i32=line_start(buf,li);
      let e:i32=line_end(buf,off);
      let ln:[]u8=buf[off..e];
      if(streq(getfld(ln,0),"R")==1 && streq(getfld(ln,1),cur)==1 && streq(getfld(ln,2),r)==1){
        let rl:i32=atoi(getfld(ln,4));
        if(rl>brel){brel=rl;found=getfld(ln,3);}
      }
      li=li+1;
    }
    if(found.len==0){return "UNKNOWN";}
    cur=found;
    i=i+1;
  }
  return cur;
}
fn hyp_w(buf:[]u8,hid:[]u8)i32 {
  let li:i32=find_line2(buf,"H",hid);
  if(li<0){return 0;}
  let off:i32=line_start(buf,li);
  let e:i32=line_end(buf,off);
  return atoi(getfld(buf[off..e],2));
}
fn ans_yn(buf:[]u8,at:i32,line:[]u8)[]u8 {
  let h1:[]u8=jval(line,"h1");
  let h2:[]u8=jval(line,"h2");
  let w1:i32=hyp_w(buf,h1);
  let w2:i32=hyp_w(buf,h2);
  let d:i32=w1-w2;
  if(d>1){return h1;}
  if(d<-1){return h2;}
  return "UNRESOLVED";
}
// causal: graphs as parent[] and topo order[]
fn gpar(g:i32,v:i32)i32 {
  if(g==0){ if(v==0){return -1;} if(v==1){return 0;} return 1; }
  if(g==1){ if(v==0){return -1;} if(v==1){return 2;} return 0; }
  if(v==0){return 1;} if(v==1){return -1;} return 0;
}
fn gtopo(g:i32,i:i32)i32 {
  if(g==0){ if(i==0){return 0;} if(i==1){return 1;} return 2; }
  if(g==1){ if(i==0){return 0;} if(i==1){return 2;} return 1; }
  if(i==0){return 1;} if(i==1){return 0;} return 2;
}
fn cmask(buf:[]u8)i32 {
  let li:i32=find_line2(buf,"M","");
  if(li<0){return 7;}
  let off:i32=line_start(buf,li);
  let e:i32=line_end(buf,off);
  return atoi(getfld(buf[off..e],1));
}
// vals is a 12-byte []u8 holding three i32 (P,Q,R)
fn cbase(buf:[]u8,vals:[]u8)void {
  st32(vals,0,0);st32(vals,4,0);st32(vals,8,0);
  let li:i32=find_line2(buf,"B","");
  if(li>=0){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    st32(vals,0,atoi(getfld(ln,1)));st32(vals,4,atoi(getfld(ln,2)));st32(vals,8,atoi(getfld(ln,3)));
  }
  return;
}
fn varidx(name:[]u8)i32 {
  if(streq(name,"P")==1){return 0;}
  if(streq(name,"Q")==1){return 1;}
  return 2;
}
// simulate graph g under do(dv=dvv); vals holds 12-byte base on entry; returns predicted ask var
fn sim_graph(g:i32,vals:[]u8,dv:i32,dvv:i32,ask:i32)i32 {
  let v:[]u8=z_alloc(12);
  st32(v,0,ld32(vals,0));st32(v,4,ld32(vals,4));st32(v,8,ld32(vals,8));
  st32(v,dv*4,dvv);
  let i:i32=0;
  while(i<3){
    let n:i32=gtopo(g,i);
    if(n!=dv){
      let p:i32=gpar(g,n);
      if(p>=0){st32(v,n*4,ld32(v,p*4));}
    }
    i=i+1;
  }
  let r:i32=ld32(v,ask*4);
  z_free(v);
  return r;
}
fn ans_causal(buf:[]u8,line:[]u8)[]u8 {
  let dv:i32=varidx(jval(line,"do"));
  let dvv:i32=jint(line,"val");
  let ask:i32=varidx(jval(line,"ask"));
  let mask:i32=cmask(buf);
  let base:[]u8=z_alloc(12);
  cbase(buf,base);
  let first:i32=-1;
  let agree:i32=1;
  let g:i32=0;
  while(g<3){
    let mb1:i32=(mask>>g)&1;
    if(mb1==1){
      let o:i32=sim_graph(g,base,dv,dvv,ask);
      if(first<0){first=o;}
      if(o!=first){agree=0;}
    }
    g=g+1;
  }
  z_free(base);
  if(first<0){return "UNKNOWN";}
  if(agree==1){return i32s(first);}
  return "UNKNOWN";
}
// eliminate graphs inconsistent with observed post-intervention (P,Q,R)
fn eliminate(buf:[]u8,at:i32,dv:i32,dvv:i32,op:i32,oq:i32,or_:i32)i32 {
  let mask:i32=cmask(buf);
  let base:[]u8=z_alloc(12);
  cbase(buf,base);
  let nmask:i32=0;
  let g:i32=0;
  while(g<3){
    let mb2:i32=(mask>>g)&1;
    if(mb2==1){
      let pp:i32=sim_graph(g,base,dv,dvv,0);
      let qq:i32=sim_graph(g,base,dv,dvv,1);
      let rr:i32=sim_graph(g,base,dv,dvv,2);
      if(pp==op && qq==oq && rr==or_){nmask=nmask|(1<<g);}
    }
    g=g+1;
  }
  z_free(base);
  if(nmask==0){nmask=mask;}
  // rewrite M line
  let li:i32=find_line2(buf,"M","");
  let nb:[]u8=z_alloc(16);
  let n:i32=app(nb,0,"M");
  n=app1(nb,n,1); n=app(nb,n,i32s(nmask));
  if(li>=0){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let k:i32=off;
    while(e+1+k-off<at){buf[k]=buf[e+1+k-off];k=k+1;}
    at=at-(e+1-off);
  }
  at=append_line(buf,at,nb[0..n]);
  z_free(nb);
  return at;
}
fn rev_str(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[s.len-1-i];i=i+1;}
  return b;
}
fn rot_str(s:[]u8,k:i32)[]u8 {
  if(s.len==0){return "";}
  let kk:i32=k%s.len;
  if(kk<0){kk=kk+s.len;}
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[(i+kk)%s.len];i=i+1;}
  return b;
}
fn ans_proc(buf:[]u8,at:i32,proc:[]u8,tin:[]u8)[]u8 {
  // collect non-superseded demo line indices (up to 64), packed 4 bytes each
  let nl:i32=nlines(buf);
  let dln:[]u8=z_alloc(256);
  let nd:i32=0;
  let li:i32=0;
  while(li<nl){
    let off:i32=line_start(buf,li);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    if(streq(getfld(ln,0),"D")==1 && streq(getfld(ln,1),proc)==1 && streq(getfld(ln,5),"0")==1){
      if(nd<64){st32(dln,nd*4,li);nd=nd+1;}
    }
    li=li+1;
  }
  if(nd==0){z_free(dln);return "UNKNOWN";}
  // class 1: char map (requires equal lengths)
  let map:[]u8=z_alloc(256);
  let mset:[]u8=z_alloc(256);
  let i:i32=0;
  while(i<256){mset[i]=0;i=i+1;}
  let map_ok:i32=1;
  i=0;
  while(i<nd){
    let li2:i32=ld32(dln,i*4);
    let off:i32=line_start(buf,li2);
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    let din:[]u8=getfld(ln,2);
    let dout:[]u8=getfld(ln,3);
    if(din.len!=dout.len){map_ok=0;}
    if(map_ok==1){
      let k:i32=0;
      while(k<din.len){
        let c:i32=din[k] as i32;
        if(mset[c]==0){mset[c]=1;map[c]=dout[k];}
        if(map[c]!=dout[k]){map_ok=0;}
        k=k+1;
      }
    }
    i=i+1;
  }
  if(map_ok==1){
    let ok:i32=1;
    i=0;
    while(i<tin.len){if(mset[tin[i] as i32]==0){ok=0;}i=i+1;}
    if(ok==1){
      let b:[]u8=z_alloc(tin.len);
      i=0;
      while(i<tin.len){b[i]=map[tin[i] as i32];i=i+1;}
      z_free(map);z_free(mset);z_free(dln);
      return b;
    }
  }
  z_free(map);z_free(mset);
  // class 2: reversal
  let rev_ok:i32=1;
  i=0;
  while(i<nd){
    let off:i32=line_start(buf,ld32(dln,i*4));
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    let rv:[]u8=rev_str(getfld(ln,2));
    if(streq(rv,getfld(ln,3))==0){rev_ok=0;}
    z_free(rv);
    i=i+1;
  }
  if(rev_ok==1){return rev_str(tin);}
  // class 3: duplication
  let dup_ok:i32=1;
  i=0;
  while(i<nd){
    let off:i32=line_start(buf,ld32(dln,i*4));
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    let din:[]u8=getfld(ln,2);
    let dout:[]u8=getfld(ln,3);
    if(dout.len!=din.len*2){dup_ok=0;}
    if(dup_ok==1){
      if(streq(dout[0..din.len],din)==0){dup_ok=0;}
      if(streq(dout[din.len..dout.len],din)==0){dup_ok=0;}
    }
    i=i+1;
  }
  if(dup_ok==1){
    let b:[]u8=z_alloc(tin.len*2);
    app(b,0,tin); app(b,tin.len,tin);
    return b;
  }
  // class 4: rotation by consistent k
  let rot_k:i32=-2;
  let rot_ok:i32=1;
  i=0;
  while(i<nd){
    let off:i32=line_start(buf,ld32(dln,i*4));
    let e:i32=line_end(buf,off);
    let ln:[]u8=buf[off..e];
    let din:[]u8=getfld(ln,2);
    let dout:[]u8=getfld(ln,3);
    let found:i32=-1;
    if(din.len==dout.len && din.len>0){
      let k:i32=0;
      while(k<din.len){
        let rs:[]u8=rot_str(din,k);
        if(streq(rs,dout)==1 && found<0){found=k;}
        z_free(rs);
        k=k+1;
      }
    }
    if(found<0){rot_ok=0;}
    if(rot_ok==1){
      if(rot_k==-2){rot_k=found;}
      if(rot_k!=found){rot_ok=0;}
    }
    i=i+1;
  }
  if(rot_ok==1 && rot_k>=-1){
    let kk:i32=rot_k;
    if(kk<0){kk=0;}
    return rot_str(tin,kk);
  }
  // fallback: nearest demo by common prefix, copy its output
  let best:i32=0;
  let bestcp:i32=-1;
  i=0;
  while(i<nd){
    let off:i32=line_start(buf,ld32(dln,i*4));
    let e:i32=line_end(buf,off);
    let din:[]u8=getfld(buf[off..e],2);
    let cp:i32=0;
    while(cp<din.len && cp<tin.len && din[cp]==tin[cp]){cp=cp+1;}
    if(cp>bestcp){bestcp=cp;best=i;}
    i=i+1;
  }
  let off2:i32=line_start(buf,ld32(dln,best*4));
  let e2:i32=line_end(buf,off2);
  let dout2:[]u8=getfld(buf[off2..e2],3);
  let b2:[]u8=z_alloc(dout2.len);
  app(b2,0,dout2);
  z_free(dln);
  return b2;
}
fn ans_meaning(buf:[]u8,w:[]u8)[]u8 {
  let li:i32=find_line2(buf,"V",w);
  if(li<0){return "UNKNOWN";}
  let off:i32=line_start(buf,li);
  let e:i32=line_end(buf,off);
  return getfld(buf[off..e],2);
}
fn ans_compose(buf:[]u8,line:[]u8)[]u8 {
  let n:i32=jarr_len(line,"words");
  let b:[]u8=z_alloc(512);
  let at:i32=0;
  let i:i32=0;
  while(i<n){
    let w:[]u8=jarr(line,"words",i);
    let g:[]u8=ans_meaning(buf,w);
    if(streq(g,"UNKNOWN")==1){z_free(b);return "UNKNOWN";}
    if(i>0){at=app(b,at," ");}
    at=app(b,at,g);
    i=i+1;
  }
  return b[0..at];
}
// peak RSS kB from /proc/self/status (VmHWM); 0 if unavailable
fn peak_rss()i64 {
  let d:[]u8=read_file("/proc/self/status");
  let p:i32=findsub(d,0,"VmHWM:");
  if(p<0){return 0;}
  let s:i32=p+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}
// choose discriminating intervention; writes reply, returns 1 if tool emitted
fn act_causal(buf:[]u8,at:i32,out:[]u8,qid:[]u8)[]u8 {
  let mask:i32=cmask(buf);
  let nbits:i32=0;
  let g:i32=0;
  while(g<3){
    let mb3:i32=(mask>>g)&1;
    if(mb3==1){nbits=nbits+1;}
    g=g+1;
  }
  if(nbits<=1){
    let b:[]u8=z_alloc(32);
    let n:i32=app(b,0,"{\"done\":true}");
    return b[0..n];
  }
  let base:[]u8=z_alloc(12);
  cbase(buf,base);
  let bestv:i32=0;
  let bestval:i32=1;
  let bestscore:i32=-1;
  let dv:i32=0;
  while(dv<3){
    let vv:i32=0;
    while(vv<2){
      // distinct prediction vectors across possible graphs
      let seen:[]u8=z_alloc(9);
      let ns:i32=0;
      g=0;
      while(g<3){
        let mb4:i32=(mask>>g)&1;
        if(mb4==1){
          let pp:i32=sim_graph(g,base,dv,vv,0);
          let qq:i32=sim_graph(g,base,dv,vv,1);
          let rr:i32=sim_graph(g,base,dv,vv,2);
          let code:i32=pp*4+qq*2+rr;
          let f:i32=0;
          let k:i32=0;
          while(k<ns){if((seen[k] as i32)==code){f=1;}k=k+1;}
          if(f==0){seen[ns]=code as u8;ns=ns+1;}
        }
        g=g+1;
      }
      z_free(seen);
      if(ns>bestscore){bestscore=ns;bestv=dv;bestval=vv;}
      vv=vv+1;
    }
    dv=dv+1;
  }
  z_free(base);
  let vn:[]u8="P";
  if(bestv==1){vn="Q";}
  if(bestv==2){vn="R";}
  let b:[]u8=z_alloc(128);
  let n:i32=app(b,0,"{\"tool\":\"intervene\",\"var\":\"");
  n=app(b,n,vn);
  n=app(b,n,"\",\"val\":");
  n=app(b,n,i32s(bestval));
  n=app(b,n,",\"qid\":\"");
  n=app(b,n,qid);
  n=app(b,n,"\"}");
  return b[0..n];
}
fn handle_obs(buf:[]u8,at:i32,line:[]u8,turn:i32)i32 {
  let t:[]u8=jval(line,"t");
  if(streq(t,"fact")==1){
    return ingest_fact(buf,at,jval(line,"s"),jval(line,"a"),jval(line,"v"),jval(line,"src"),jint(line,"rel"),turn);
  }
  if(streq(t,"rel")==1){
    return ingest_rel(buf,at,jval(line,"a"),jval(line,"r"),jval(line,"b"),jint(line,"rel"),turn);
  }
  if(streq(t,"cobs")==1){
    return ingest_cobs(buf,at,jint(line,"P"),jint(line,"Q"),jint(line,"R"));
  }
  if(streq(t,"demo")==1){
    return ingest_demo(buf,at,jval(line,"p"),jval(line,"in"),jval(line,"out"),turn);
  }
  if(streq(t,"claim")==1){
    return ingest_claim(buf,at,jval(line,"h"),jint(line,"w"));
  }
  if(streq(t,"vocab")==1){
    return ingest_vocab(buf,at,jval(line,"w"),jval(line,"g"));
  }
  if(streq(t,"law")==1){
    return ingest_law(buf,at,jval(line,"p"));
  }
  // noise and unknown: ack without storing
  return at;
}
fn handle_toolresult(buf:[]u8,at:i32,line:[]u8,turn:i32)i32 {
  let t:[]u8=jval(line,"t");
  if(streq(t,"fact")==1){
    return ingest_fact(buf,at,jval(line,"s"),jval(line,"a"),jval(line,"v"),"tool",90,turn);
  }
  if(streq(t,"rel")==1){
    return ingest_rel(buf,at,jval(line,"a"),jval(line,"r"),jval(line,"b"),90,turn);
  }
  if(streq(t,"cobs")==1){
    let dv:i32=varidx(jval(line,"do"));
    let dvv:i32=jint(line,"val");
    at=eliminate(buf,at,dv,dvv,jint(line,"P"),jint(line,"Q"),jint(line,"R"));
    return ingest_cobs(buf,at,jint(line,"P"),jint(line,"Q"),jint(line,"R"));
  }
  if(streq(t,"vocab")==1){
    return ingest_vocab(buf,at,jval(line,"w"),jval(line,"g"));
  }
  return at;
}
// try to answer the embedded "about" query; returns answer or "UNKNOWN"
fn try_about(buf:[]u8,at:i32,line:[]u8)[]u8 {
  let t:[]u8=jval(line,"t");
  if(streq(t,"attr")==1){return ans_attr(buf,at,jval(line,"s"),jval(line,"a"));}
  if(streq(t,"chain")==1){return ans_chain(buf,at,line,jval(line,"a"));}
  if(streq(t,"yn")==1){return ans_yn(buf,at,line);}
  if(streq(t,"causal")==1){return ans_causal(buf,line);}
  if(streq(t,"proc")==1){return ans_proc(buf,at,jval(line,"p"),jval(line,"in"));}
  if(streq(t,"meaning")==1){return ans_meaning(buf,jval(line,"w"));}
  if(streq(t,"compose")==1){return ans_compose(buf,line);}
  return "UNKNOWN";
}
fn main()i32 {
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  if(turnpath.len==0 || statedir.len==0){
    emit("usage: race_tnn <turn.json> <statedir>\n");
    return 1;
  }
  let line:[]u8=read_file(turnpath);
  let buf:[]u8=z_alloc(2097152);
  let at:i32=0;
  let sp:[]u8=pjoin(statedir,"state.txt");
  let old:[]u8=read_file(sp);
  if(old.len>0){
    let i:i32=0;
    while(i<old.len){buf[i]=old[i];i=i+1;}
    at=old.len;
  }
  let kind:[]u8=jval(line,"kind");
  let turn:i32=jint(line,"turn");
  if(turn<-1000000){turn=0;}
  let out:[]u8=z_alloc(4096);
  let on:i32=0;
  if(streq(kind,"brief")==1){
    on=app(out,on,"{\"ack\":true}");
  }
  if(streq(kind,"obs")==1){
    at=handle_obs(buf,at,line,turn);
    on=app(out,on,"{\"ack\":true}");
  }
  if(streq(kind,"query")==1){
    let qid:[]u8=jval(line,"qid");
    let ans:[]u8=try_about(buf,at,line);
    let conf:[]u8="0.9";
    if(streq(ans,"UNKNOWN")==1){conf="0.0";}
    if(streq(ans,"UNRESOLVED")==1){conf="0.6";}
    on=app(out,on,"{\"qid\":\"");
    on=app(out,on,qid);
    on=app(out,on,"\",\"answer\":\"");
    on=app(out,on,ans);
    on=app(out,on,"\",\"conf\":");
    on=app(out,on,conf);
    on=app(out,on,"}");
  }
  if(streq(kind,"act")==1){
    let qid:[]u8=jval(line,"qid");
    let t:[]u8=jval(line,"t");
    let done:[]u8="";
    if(streq(t,"causal")==1){
      done=act_causal(buf,at,out,qid);
      on=app(out,on,done);
    } else {
      let ans:[]u8=try_about(buf,at,line);
      if(streq(ans,"UNKNOWN")==0){
        on=app(out,on,"{\"done\":true}");
      } else {
        let subj:[]u8=jval(line,"s");
        if(subj.len==0){subj=jval(line,"w");}
        if(subj.len==0){subj=jval(line,"a");}
        on=app(out,on,"{\"tool\":\"ask\",\"q\":\"");
        on=app(out,on,subj);
        on=app(out,on,"\",\"qid\":\"");
        on=app(out,on,qid);
        on=app(out,on,"\"}");
      }
    }
  }
  if(streq(kind,"toolresult")==1){
    at=handle_toolresult(buf,at,line,turn);
    on=app(out,on,"{\"ack\":true}");
  }
  if(streq(kind,"save")==1){
    let fd:i64=w_open(sp);
    if(fd>=0){w_write(fd,buf[0..at]);w_close(fd);}
    let cp:[]u8=pjoin(statedir,"checksum.txt");
    let fd2:i64=w_open(cp);
    if(fd2>=0){w_write(fd2,i64s(fnv(buf[0..at])));w_close(fd2);}
    on=app(out,on,"{\"ack\":true,\"checksum\":\"");
    on=app(out,on,i64s(fnv(buf[0..at])));
    on=app(out,on,"\"}");
  }
  if(streq(kind,"load")==1){
    let cp:[]u8=pjoin(statedir,"checksum.txt");
    let cs:[]u8=read_file(cp);
    let now:[]u8=i64s(fnv(buf[0..at]));
    let ok:i32=0;
    if(cs.len>=now.len && streq(cs[0..now.len],now)==1){ok=1;}
    on=app(out,on,"{\"ack\":true,\"verified\":");
    if(ok==1){on=app(out,on,"true}");} else {on=app(out,on,"false}");}
  }
  if(streq(kind,"end")==1){
    let rp:[]u8=pjoin(statedir,"rss.txt");
    let fd:i64=w_open(rp);
    if(fd>=0){w_write(fd,i64s(peak_rss()));w_close(fd);}
    // self-report learned-structure counts
    let nl:i32=nlines(buf);
    let nf:i32=0; let nr:i32=0; let nh:i32=0; let nd2:i32=0; let nv2:i32=0;
    let li:i32=0;
    while(li<nl){
      let off:i32=line_start(buf,li);
      let e:i32=line_end(buf,off);
      let tg:[]u8=getfld(buf[off..e],0);
      if(streq(tg,"F")==1){nf=nf+1;}
      if(streq(tg,"R")==1){nr=nr+1;}
      if(streq(tg,"H")==1){nh=nh+1;}
      if(streq(tg,"D")==1){nd2=nd2+1;}
      if(streq(tg,"V")==1){nv2=nv2+1;}
      li=li+1;
    }
    let lp:[]u8=pjoin(statedir,"ledger.txt");
    let fd2:i64=w_open(lp);
    if(fd2>=0){
      let lb:[]u8=z_alloc(256);
      let n:i32=app(lb,0,"facts=");
      n=app(lb,n,i32s(nf));
      n=app(lb,n," rels=");
      n=app(lb,n,i32s(nr));
      n=app(lb,n," hyps=");
      n=app(lb,n,i32s(nh));
      n=app(lb,n," demos=");
      n=app(lb,n,i32s(nd2));
      n=app(lb,n," vocab=");
      n=app(lb,n,i32s(nv2));
      n=app(lb,n,"\n");
      w_write(fd2,lb[0..n]);
      w_close(fd2);
      z_free(lb);
    }
    on=app(out,on,"{\"done\":true}");
  }
  // persist state (except end keeps it too)
  let fd:i64=w_open(sp);
  if(fd>=0){w_write(fd,buf[0..at]);w_close(fd);}
  emit(out[0..on]);
  emit("\n");
  return 0;
}

// proclang1.zag -- H-PROCLANG1 implementation.
// Frozen prereg: docs/lab/research-lead/overnight-20260928/proclang_frontier/PREREG_PROCLANG1.md
// (committed in bd883d969; strict prereg-before-implementation ancestry verified).
//
// Learner: Phase A exhaustive search over frozen affine DSL D0
//   (ops ADD k / MUL k, k in -3..3, program length 0..3; NO conditional),
// inadequacy trigger (best D0 program still errs), Phase B generic
// threshold case-split over the input coordinate with operator reification
// into a persistent COND(t, leftProg, rightProg) operator library.
// Worlds (environment only; learner sees ONLY (x,y) pairs):
//   T1 y=|x|, T4 y=|x-3| (continuation/counterexample), T2 y=step(x),
//   T3 y=|1-u| with u=-x+1 (re-coordinatized surface).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- D0 program machinery ----
// Op index 0..6 = ADD (idx-3); 7..13 = MUL (idx-10).
fn eval_prog(ops:[]u8, len:i32, x:i32)i32 {
  let r:i32=x;
  let i:i32=0;
  while(i<len){
    let oi:i32=ops[i] as i32;
    if(oi<7){ r=r+(oi-3); } else { r=r*(oi-10); }
    i=i+1;
  }
  return r;
}
fn mismatches_rec(pl:[]u8, base:i32, len:i32, xs:[]u8, ys:[]u8, n:i32)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    if(eval_prog(pl[base+1..base+4], len, get32(xs,i*4))!=get32(ys,i*4)){ m=m+1; }
    i=i+1;
  }
  return m;
}
// Program list record: 4 bytes [len, op0, op1, op2].
fn build_proglist(pl:[]u8)i32 {
  let c:i32=0;
  pl[0]=0; pl[1]=255; pl[2]=255; pl[3]=255; c=1;
  let a:i32=0;
  while(a<14){
    let b4:i32=c*4;
    pl[b4]=1; pl[b4+1]=a as u8; pl[b4+2]=255; pl[b4+3]=255; c=c+1;
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let b4:i32=c*4;
      pl[b4]=2; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=255; c=c+1;
      b=b+1;
    }
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let d:i32=0;
      while(d<14){
        let b4:i32=c*4;
        pl[b4]=3; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=d as u8; c=c+1;
        d=d+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  return c;
}
// out: 4 bytes [len, op0, op1, op2]. Returns mismatches of best program.
// Deterministic: lengths ascending, op indices ascending, strict improvement.
fn fit_best(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32, out:[]u8)i32 {
  let best:i32=n+1;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    let m:i32=mismatches_rec(pl, base, len, xs, ys, n);
    if(m<best){
      best=m;
      out[0]=pl[base]; out[1]=pl[base+1]; out[2]=pl[base+2]; out[3]=pl[base+3];
    }
    pi=pi+1;
  }
  return best;
}
// Machine-checked affine lemma C0 over the enumerated space.
fn check_affine(pl:[]u8, pn:i32)i32 {
  let ok:i32=0;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    let fm1:i32=eval_prog(pl[base+1..base+4], len, -1);
    let f0:i32=eval_prog(pl[base+1..base+4], len, 0);
    let fp1:i32=eval_prog(pl[base+1..base+4], len, 1);
    if(fm1+fp1==2*f0){ ok=ok+1; }
    pi=pi+1;
  }
  return ok;
}
fn emit_prog(ops:[]u8, len:i32)void {
  if(len==0){ emit("ID"); return; }
  let i:i32=0;
  while(i<len){
    let oi:i32=ops[i] as i32;
    if(i>0){ emit(";"); }
    if(oi<7){ emit("ADD "); emit(i32s(oi-3)); } else { emit("MUL "); emit(i32s(oi-10)); }
    i=i+1;
  }
  return;
}

// ---- Phase B: threshold case-split + reification ----
// pbo: 12 bytes [t:i32, llen:u8, l0,l1,l2, rlen:u8, r0,r1,r2]. Returns min total.
fn phaseB(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32,
          lx:[]u8, ly:[]u8, rx:[]u8, ry:[]u8, tmp:[]u8, pbo:[]u8)i32 {
  let xmin:i32=get32(xs,0);
  let xmax:i32=xmin;
  let i:i32=1;
  while(i<n){
    let v:i32=get32(xs,i*4);
    if(v<xmin){ xmin=v; }
    if(v>xmax){ xmax=v; }
    i=i+1;
  }
  let best_tot:i32=n+1;
  let t:i32=xmin-1;
  while(t<=xmax+1){
    let nl:i32=0;
    let nr:i32=0;
    i=0;
    while(i<n){
      let x:i32=get32(xs,i*4);
      let y:i32=get32(ys,i*4);
      if(x<t){ set32(lx,nl*4,x); set32(ly,nl*4,y); nl=nl+1; }
      else { set32(rx,nr*4,x); set32(ry,nr*4,y); nr=nr+1; }
      i=i+1;
    }
    let ml:i32=fit_best(pl,pn,lx,ly,nl,tmp);
    let llen:i32=tmp[0] as i32;
    let sl0:i32=tmp[1] as i32;
    let sl1:i32=tmp[2] as i32;
    let sl2:i32=tmp[3] as i32;
    let mr:i32=fit_best(pl,pn,rx,ry,nr,tmp);
    let tot:i32=ml+mr;
    if(tot<best_tot){
      best_tot=tot;
      set32(pbo,0,t);
      pbo[4]=llen as u8; pbo[5]=sl0 as u8; pbo[6]=sl1 as u8; pbo[7]=sl2 as u8;
      pbo[8]=tmp[0]; pbo[9]=tmp[1]; pbo[10]=tmp[2]; pbo[11]=tmp[3];
    }
    t=t+1;
  }
  return best_tot;
}

// ---- Operator library (persistent learner state) ----
// lib_thr: 8*i32; lib_llen/lib_rlen/lib_task: 8 bytes; lib_lops/lib_rops: 8*3 bytes.
fn cond_eval(oi:i32, x:i32, lib_thr:[]u8, lib_llen:[]u8, lib_lops:[]u8,
             lib_rlen:[]u8, lib_rops:[]u8)i32 {
  let thr:i32=get32(lib_thr, oi*4);
  if(x<thr){ return eval_prog(lib_lops[oi*3..oi*3+3], lib_llen[oi] as i32, x); }
  return eval_prog(lib_rops[oi*3..oi*3+3], lib_rlen[oi] as i32, x);
}
fn mismatches_cond(oi:i32, xs:[]u8, ys:[]u8, n:i32,
                   lib_thr:[]u8, lib_llen:[]u8, lib_lops:[]u8,
                   lib_rlen:[]u8, lib_rops:[]u8)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    if(cond_eval(oi, get32(xs,i*4), lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops)!=get32(ys,i*4)){ m=m+1; }
    i=i+1;
  }
  return m;
}

// ---- Worlds (environment; learner sees only pairs) ----
fn w_abs(x:i32)i32 { if(x<0){ return -x; } return x; }
fn w_abs3(x:i32)i32 { let d:i32=x-3; if(d<0){ return -d; } return d; }
fn w_step(x:i32)i32 { if(x<0){ return -1; } return 1; }
fn w_trans(u:i32)i32 { let d:i32=1-u; if(d<0){ return -d; } return d; }
fn fill_pairs(xs:[]u8, ys:[]u8, n:i32, x0:i32, world:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=x0+i;
    let y:i32=0;
    if(world==0){ y=w_abs(x); }
    else { if(world==1){ y=w_abs3(x); } else { if(world==2){ y=w_step(x); } else { y=w_trans(x); } } }
    set32(xs,i*4,x);
    set32(ys,i*4,y);
    i=i+1;
  }
  return;
}

// ---- One task episode ----
fn run_task(tid:i32, world:i32, tr0:i32, tr1:i32, te0:i32, te1:i32,
            pl:[]u8, pn:i32,
            tx:[]u8, ty:[]u8, ex:[]u8, ey:[]u8,
            lx:[]u8, ly:[]u8, rx:[]u8, ry:[]u8, tmp:[]u8, pbo:[]u8,
            lib_thr:[]u8, lib_llen:[]u8, lib_lops:[]u8,
            lib_rlen:[]u8, lib_rops:[]u8, lib_task:[]u8,
            lib_count:i32)i32 {
  let tn:i32=tr1-tr0+1;
  let en:i32=te1-te0+1;
  fill_pairs(tx,ty,tn,tr0,world);
  fill_pairs(ex,ey,en,te0,world);
  emit("TASK id=");
  emit(i32s(tid));
  emit("\n");
  if(lib_count>0){
    let ci:i32=lib_count-1;
    let m:i32=mismatches_cond(ci, tx, ty, tn, lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops);
    emit("CUR_OP_TRAIN_MISMATCHES op=COND_T");
    emit(i32s(lib_task[ci] as i32));
    emit(" n=");
    emit(i32s(m));
    emit("\n");
    if(m==0){
      emit("REUSE op=COND_T");
      emit(i32s(lib_task[ci] as i32));
      emit("\n");
      let hc:i32=0;
      let i:i32=0;
      while(i<en){
        if(cond_eval(ci, get32(ex,i*4), lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops)==get32(ey,i*4)){ hc=hc+1; }
        i=i+1;
      }
      emit("HIDDEN n=");
      emit(i32s(en));
      emit(" correct=");
      emit(i32s(hc));
      emit("\n");
      return lib_count;
    }
  } else {
    emit("CUR none\n");
  }
  let pa_m:i32=fit_best(pl,pn,tx,ty,tn,tmp);
  let pa_len:i32=tmp[0] as i32;
  emit("PHASEA best=");
  emit_prog(tmp[1..4], pa_len);
  emit(" mismatches=");
  emit(i32s(pa_m));
  emit("\n");
  if(pa_m==0){
    let hc2:i32=0;
    let j:i32=0;
    while(j<en){
      if(eval_prog(tmp[1..4], pa_len, get32(ex,j*4))==get32(ey,j*4)){ hc2=hc2+1; }
      j=j+1;
    }
    emit("HIDDEN n=");
    emit(i32s(en));
    emit(" correct=");
    emit(i32s(hc2));
    emit(" via=DSL\n");
    return lib_count;
  }
  emit("INADEQUACY residual=");
  emit(i32s(pa_m));
  emit("\n");
  let tot:i32=phaseB(pl,pn,tx,ty,tn,lx,ly,rx,ry,tmp,pbo);
  let bt:i32=get32(pbo,0);
  let ll:i32=pbo[4] as i32;
  let rl:i32=pbo[8] as i32;
  emit("SPLIT_SCAN n_thresh=");
  emit(i32s(tr1-tr0+3));
  emit(" best_t=");
  emit(i32s(bt));
  emit(" best_total=");
  emit(i32s(tot));
  emit("\n");
  if(tot>0){
    emit("FAILURE no exact split\n");
    return lib_count;
  }
  let ni:i32=lib_count;
  set32(lib_thr, ni*4, bt);
  lib_llen[ni]=ll as u8;
  lib_rlen[ni]=rl as u8;
  lib_lops[ni*3]=pbo[5]; lib_lops[ni*3+1]=pbo[6]; lib_lops[ni*3+2]=pbo[7];
  lib_rops[ni*3]=pbo[9]; lib_rops[ni*3+1]=pbo[10]; lib_rops[ni*3+2]=pbo[11];
  lib_task[ni]=tid as u8;
  if(lib_count==0){
    emit("INVENT op=COND_T");
    emit(i32s(tid));
  } else {
    emit("REVISE old=COND_T");
    emit(i32s(lib_task[ni-1] as i32));
    emit(" new=COND_T");
    emit(i32s(tid));
  }
  emit(" t=");
  emit(i32s(bt));
  emit(" left=");
  emit_prog(pbo[5..8], ll);
  emit(" right=");
  emit_prog(pbo[9..12], rl);
  emit("\n");
  emit("TRACE trigger_residual=");
  emit(i32s(pa_m));
  emit(" train_before=");
  emit(i32s(pa_m));
  emit(" train_after=0 lib_size=");
  emit(i32s(lib_count+1));
  emit("\n");
  let hc3:i32=0;
  let k:i32=0;
  while(k<en){
    if(cond_eval(ni, get32(ex,k*4), lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops)==get32(ey,k*4)){ hc3=hc3+1; }
    k=k+1;
  }
  emit("HIDDEN n=");
  emit(i32s(en));
  emit(" correct=");
  emit(i32s(hc3));
  emit("\n");
  return lib_count+1;
}

fn main()i32 {
  emit("# H-PROCLANG1 frozen run\n");
  let pl:[]u8=z_alloc(2955*4);
  let pn:i32=build_proglist(pl);
  emit("PROGLIST n=");
  emit(i32s(pn));
  emit("\n");
  let ok:i32=check_affine(pl, pn);
  emit("AFFINE_LEMMA checked=");
  emit(i32s(pn));
  emit(" ok=");
  emit(i32s(ok));
  emit("\n");
  let tx:[]u8=z_alloc(64*4);
  let ty:[]u8=z_alloc(64*4);
  let ex:[]u8=z_alloc(2001*4);
  let ey:[]u8=z_alloc(2001*4);
  let lx:[]u8=z_alloc(64*4);
  let ly:[]u8=z_alloc(64*4);
  let rx:[]u8=z_alloc(64*4);
  let ry:[]u8=z_alloc(64*4);
  let tmp:[]u8=z_alloc(4);
  let pbo:[]u8=z_alloc(12);
  let lib_thr:[]u8=z_alloc(8*4);
  let lib_llen:[]u8=z_alloc(8);
  let lib_rlen:[]u8=z_alloc(8);
  let lib_lops:[]u8=z_alloc(8*3);
  let lib_rops:[]u8=z_alloc(8*3);
  let lib_task:[]u8=z_alloc(8);
  let lc:i32=0;
  // Order: T1 invention, T4 revision (counterexample), T2 reuse, T3 transfer.
  lc=run_task(1, 0, -20, 20, -1000, 1000, pl, pn,
              tx, ty, ex, ey, lx, ly, rx, ry, tmp, pbo,
              lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops, lib_task, lc);
  lc=run_task(4, 1, -20, 20, -1000, 1000, pl, pn,
              tx, ty, ex, ey, lx, ly, rx, ry, tmp, pbo,
              lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops, lib_task, lc);
  lc=run_task(2, 2, -20, 20, -1000, 1000, pl, pn,
              tx, ty, ex, ey, lx, ly, rx, ry, tmp, pbo,
              lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops, lib_task, lc);
  lc=run_task(3, 3, -19, 21, -999, 1001, pl, pn,
              tx, ty, ex, ey, lx, ly, rx, ry, tmp, pbo,
              lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops, lib_task, lc);
  emit("LIB_SIZE ");
  emit(i32s(lc));
  emit("\n");
  // Ablation: affine-only (best Phase-A program) on T1 hidden.
  fill_pairs(tx,ty,41,-20,0);
  fill_pairs(ex,ey,2001,-1000,0);
  let am:i32=fit_best(pl,pn,tx,ty,41,tmp);
  let alen:i32=tmp[0] as i32;
  let ac:i32=0;
  let i:i32=0;
  while(i<2001){
    if(eval_prog(tmp[1..4], alen, get32(ex,i*4))==get32(ey,i*4)){ ac=ac+1; }
    i=i+1;
  }
  emit("ABLATION prog=");
  emit_prog(tmp[1..4], alen);
  emit(" train_mismatches=");
  emit(i32s(am));
  emit(" n=2001 correct=");
  emit(i32s(ac));
  emit("\n");
  // Memorization control: exact-match table on T1 train, unseen -> 0.
  let bc:i32=0;
  i=0;
  while(i<2001){
    let x:i32=get32(ex,i*4);
    let y:i32=get32(ey,i*4);
    let pred:i32=0;
    let found:i32=0;
    let j:i32=0;
    while(j<41){
      if(get32(tx,j*4)==x){ pred=get32(ty,j*4); found=1; }
      j=j+1;
    }
    if(found==0){ pred=0; }
    if(pred==y){ bc=bc+1; }
    i=i+1;
  }
  emit("BASELINE table n=2001 correct=");
  emit(i32s(bc));
  emit("\n");
  emit("DONE\n");
  return 0;
}

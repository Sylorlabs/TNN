// V2 HOLE PROBES: does t2_revise_graph accept a repair that runs
// but computes something unrelated to the observation (new_o)?
// The acceptance check is only `out != -999999`; it never verifies
// `out == new_o`.

fn v2_rep(name:[]u8,v:i32)void { emit(name); emit("="); e64(v); emit("\n"); return; }

// Build a MAP node for (s,r) with given root and answer.
fn v2_make_map(W:[]u8,s:i32,r:i32,root:i32,ans:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,36,1);
  ns(W,m,20,root); ns(W,m,8,s); ns(W,m,4,r); ns(W,m,28,ans);
  return m;
}

// PROBE 1: adversarial trailing-SETREG (hand-crafted legal 4-op graph).
// Graph: g0(guard reg0==100) -> st0(set reg0<-300, prov->f0) -> st1(set reg0<-999).
// Executes to 999. Contradict f0=(100,200,300) with new_o=500.
// Repaired: g0 -> nst(set reg0<-500) -> st1(set reg0<-999). Executes to 999.
// 999 != 500 and 999 != -999999. Accepted iff the hole exists.
fn v2_probe1()void {
  emit("== PROBE 1: trailing SETREG (adversarial) ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let f0:i32=ev_teach(W,100,200,300);
  v2_rep("P1 fact",f0);
  let l100:i32=t2_lit(W,100); let l300:i32=t2_lit(W,300); let l999:i32=t2_lit(W,999);
  let g0:i32=t2_guard(W,0,l100);
  let st0:i32=t2_set(W,0,l300);
  let st1:i32=t2_set(W,0,l999);
  ns(W,g0,12,st0);
  seq_link(W,st0,st1);
  link_edge(W,st0,1,f0,0);
  let m:i32=v2_make_map(W,100,200,g0,999);
  link_edge(W,m,1,f0,0);
  v2_rep("P1 map",m);
  let ex0:i32=t2_exec(W,g0,100);
  v2_rep("P1 exec_before",ex0);
  revise_on_contradict(W,f0,500);
  let ans1:i32=ng(W,m,28);
  v2_rep("P1 map_ans_after",ans1);
  let root1:i32=ng(W,m,20);
  let ex1:i32=t2_exec(W,root1,100);
  v2_rep("P1 exec_after",ex1);
  if(ex0==999 && ans1==999 && ex1==999){
    emit("P1 CONFIRMED: wrong repair (999 != new_o 500) ACCEPTED\n");
  } else {
    emit("P1 REFUTED: repair not accepted as predicted\n");
  }
  return;
}

// PROBE 2: realistic count graph (same structure as t2_asm_count builds).
// Facts: (100,200,300), (300,200,400). Count = 2.
// Graph: g0(100)->st0(300,prov f0)->ic0->g1(300)->st1(400,prov f1)->ic1->mv.
// Contradict f1=(300,200,400) with new_o=500.
// Repaired: g1 -> nst(set 500) -> ic1 -> mv. Executes to 2 (count unchanged).
// 2 != 500. Accepted iff the check is vacuous (here semantically defensible:
// the count genuinely did not change).
fn v2_probe2()void {
  emit("== PROBE 2: count graph (realistic) ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let f0:i32=ev_teach(W,100,200,300);
  let f1:i32=ev_teach(W,300,200,400);
  v2_rep("P2 f0",f0); v2_rep("P2 f1",f1);
  let l100:i32=t2_lit(W,100);
  let l300a:i32=t2_lit(W,300); let l300b:i32=t2_lit(W,300);
  let l400:i32=t2_lit(W,400);
  let g0:i32=t2_guard(W,0,l100);
  let st0:i32=t2_set(W,0,l300a);
  let ic0:i32=t2_inc(W,1);
  let g1:i32=t2_guard(W,0,l300b);
  let st1:i32=t2_set(W,0,l400);
  let ic1:i32=t2_inc(W,1);
  let mv:i32=t2_mov(W,0,1);
  ns(W,g0,12,st0); seq_link(W,st0,ic0); seq_link(W,ic0,g1);
  ns(W,g1,12,st1); seq_link(W,st1,ic1); seq_link(W,ic1,mv);
  link_edge(W,st0,1,f0,0); link_edge(W,st1,1,f1,0);
  let m:i32=v2_make_map(W,100,200,g0,2);
  link_edge(W,m,1,f0,0); link_edge(W,m,1,f1,0);
  v2_rep("P2 map",m);
  let ex0:i32=t2_exec(W,g0,100);
  v2_rep("P2 exec_before",ex0);
  revise_on_contradict(W,f1,500);
  let ans1:i32=ng(W,m,28);
  v2_rep("P2 map_ans_after",ans1);
  let root1:i32=ng(W,m,20);
  let ex1:i32=t2_exec(W,root1,100);
  v2_rep("P2 exec_after",ex1);
  if(ex0==2 && ans1==2 && ex1==2){
    emit("P2 CONFIRMED: repair accepted with out=2 != new_o=500 (check vacuous)\n");
  } else {
    emit("P2 UNEXPECTED\n");
  }
  return;
}

// PROBE 3: sanity control. Realistic 1-hop chain, terminal contradiction.
// Graph: g0(guard 100) -> st0(set 201, prov->f0). Executes to 201.
// Contradict f0=(102,12,201) with new_o=999.
// Repaired: g0 -> nst(set 999). Executes to 999 == new_o. Must be accepted.
fn v2_probe3()void {
  emit("== PROBE 3: control (must accept correct repair) ==\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let f0:i32=ev_teach(W,102,12,201);
  v2_rep("P3 fact",f0);
  let l102:i32=t2_lit(W,102); let l201:i32=t2_lit(W,201);
  let g0:i32=t2_guard(W,0,l102);
  let st0:i32=t2_set(W,0,l201);
  ns(W,g0,12,st0);
  link_edge(W,st0,1,f0,0);
  let m:i32=v2_make_map(W,102,40,g0,201);
  link_edge(W,m,1,f0,0);
  let ex0:i32=t2_exec(W,g0,102);
  v2_rep("P3 exec_before",ex0);
  revise_on_contradict(W,f0,999);
  let ans1:i32=ng(W,m,28);
  v2_rep("P3 map_ans_after",ans1);
  let root1:i32=ng(W,m,20);
  let ex1:i32=t2_exec(W,root1,102);
  v2_rep("P3 exec_after",ex1);
  if(ex0==201 && ans1==999 && ex1==999){
    emit("P3 PASS: correct repair (999 == new_o) accepted\n");
  } else {
    emit("P3 FAIL: control broken\n");
  }
  return;
}

fn main()i32 {
  emit("V2 HOLE PROBE (unfrozen variant)\n");
  emit("Tests whether t2_revise_graph accepts repairs with out != new_o\n");
  v2_probe1();
  v2_probe2();
  v2_probe3();
  emit("DONE\n");
  return 0;
}

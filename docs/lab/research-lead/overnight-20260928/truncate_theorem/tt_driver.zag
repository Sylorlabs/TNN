// tt_driver.zag -- TRUNCATE theorem boundary battery.
//
// A-NONPREFIX-STALE: head-drop Xt=[2,1] of Z=[1,2,1]; world kills
//   the middle fact (32,2,33) with a novel-relation replacement.
//   Expect Xt stale (detected), Z not intact, no revision, ans=-2.
// B-PREFIX-MID-REPLACE: prefix Xt=[1,1] of X=[1,1,1]; world
//   replaces the prefix-interior fact (12,1,13) with (12,1,98).
//   Expect Xt stale, X not intact, no revision, ans=-2.
// C-PREFIX-ROOT-REPLACE: like B but the prefix root fact
//   (11,1,12) is replaced by (11,1,77). Expect Xt stale, X not
//   intact, no revision, ans=-2.
// T-THEOREM-CONTROL: prefix Xt=[1,1]; world only adds a duplicate
//   fact (13,1,99), no kill. Expect Xt and X intact, no revision,
//   phase-4 ans=13.
// 3/3 byte-identical runs required.

// ---- helpers (local; tt_ prefix) ----
fn tt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<10){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn tt_live(W:[]u8,m:i32)i32 {
  if(m<2){return 0;}
  if(ng(W,m,36)==1 && ng(W,m,0)==20){return 1;}
  return 0;
}
fn tt_src16(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
fn tt_count16_edges(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff no type-16 edge targets xp.
fn tt_no16_to(W:[]u8,xp:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16 && eg(W,e,8)==xp){return 0;}
    e=e+1;
  }
  return 1;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn tt_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// lowest-id live adapted MAP with relseq exp[0..n-1], or -1.
fn tt_find_adapted_relseq(W:[]u8,exp:[]u8,n:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(tt_live(W,m)==1 && tt_src16(W,m)>=0 && tt_relseq_eq(W,m,exp,n)==1){return m;}
    m=m+1;
  }
  return -1;
}
// lowest-id live fact node with (s,r,o), or -1.
fn tt_find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
// cc_satisfy length of MAP m from s, or -1.
fn tt_satisfy_len(W:[]u8,m:i32,s:i32)i32 {
  let vb:[]u8=z_alloc(36);
  let fb:[]u8=z_alloc(32);
  return cc_satisfy(W,m,s,vb,fb);
}
// withdraw a cached shortcut fact if present.
fn tt_withdraw(W:[]u8,s:i32,r:i32,o:i32)void {
  let f:i32=tt_find_fact(W,s,r,o);
  if(f>=0){ns(W,f,36,0);}
  return;
}
// Train Z ([1,2,1]) via ev_query_tt. out: mapz, f3132, f3233, f3334.
fn tt_train_z(W:[]u8,out:[]u8)void {
  let f1:i32=ev_teach(W,31,1,32);
  let f2:i32=ev_teach(W,32,2,33);
  let f3:i32=ev_teach(W,33,1,34);
  let z:i32=ev_query_tt(W,31,71,34,0);
  emit("TT-Z ans="); e64(z); emit("\n");
  set32(out,0,cb_newest_map(W));
  set32(out,4,f1); set32(out,8,f2); set32(out,12,f3);
  tt_withdraw(W,31,71,34);
  return;
}
// Train X ([1,1,1]) via ev_query_tt. out: mapx, f1112, f1213, f1314.
fn tt_train_x(W:[]u8,out:[]u8)void {
  let f1:i32=ev_teach(W,11,1,12);
  let f2:i32=ev_teach(W,12,1,13);
  let f3:i32=ev_teach(W,13,1,14);
  let x:i32=ev_query_tt(W,11,71,14,0);
  emit("TT-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  set32(out,4,f1); set32(out,8,f2); set32(out,12,f3);
  tt_withdraw(W,11,71,14);
  return;
}

// ---- A: non-prefix TRUNCATE staleness ----
fn a_nonprefix_stale(W:[]u8)void {
  emit("=== A-NONPREFIX-STALE ===\n");
  let t:[]u8=z_alloc(16);
  tt_train_z(W,t);
  let mapz:i32=get32(t,0);
  let f3233:i32=get32(t,8);
  tt_gap(W);
  // Amendment 1: the fallback cannot create the head-drop from
  // s=32 (cc_satisfy(Z,32) fails), so create it directly from
  // Z root s=31. Exactly one head-drop must be created.
  let nk:i32=adapt_nonprefix(W,31,0);
  emit("A-NONPREFIX-DIRECT nk="); e64(nk); emit("\n");
  let z2:i32=ev_query_tt(W,32,72,34,0);
  emit("A-PHASE2-ANS="); e64(z2); emit("\n");
  let e21:[]u8=z_alloc(8);
  set32(e21,0,2); set32(e21,4,1);
  let xt:i32=tt_find_adapted_relseq(W,e21,2);
  let kind2:i32=0;
  if(xt>=0 && ng(W,xt,12)==2){kind2=1;}
  let s16:i32=tt_src16(W,xt);
  let c0:i32=tt_count16_edges(W);
  emit("A mapz="); e64(mapz); emit(" xt="); e64(xt);
  emit(" kind2="); e64(kind2); emit(" s16="); e64(s16);
  emit(" c0="); e64(c0); emit("\n");
  // world change: teach-then-kill the middle fact; withdraw shortcut.
  let fnew:i32=ev_teach(W,32,5,40);
  ns(W,f3233,36,0);
  tt_withdraw(W,32,72,34);
  emit("A WORLD-CHANGE taught (32,5,40) as "); e64(fnew);
  emit(", killed (32,2,33)\n");
  let z4:i32=ev_query_tt(W,32,73,99,0);
  emit("A-PHASE4-ANS="); e64(z4); emit("\n");
  let c1:i32=tt_count16_edges(W);
  let e121:[]u8=z_alloc(12);
  set32(e121,0,1); set32(e121,4,2); set32(e121,8,1);
  let p1:i32=0; if(z2==34 && nk==1){p1=1;}
  let p2:i32=0; if(xt>=0 && kind2==1 && s16==mapz){p2=1;}
  let p3:i32=0; if(xt>=0 && tt_relseq_eq(W,xt,e21,2)==0){p3=1;}
  let p4:i32=0; if(tt_relseq_eq(W,mapz,e121,3)==0){p4=1;}
  let p5:i32=0; if(xt>=0 && tt_no16_to(W,xt)==1 && c1==c0){p5=1;}
  let p6:i32=tt_live(W,xt);
  let p7:i32=0; if(z4==-2){p7=1;}
  emit("A p1(ph2=34,nk=1)="); e64(p1);
  emit(" p2(xt21-kind2-16z)="); e64(p2);
  emit(" p3(xt-stale)="); e64(p3);
  emit(" p4(z-notintact)="); e64(p4);
  emit(" p5(no-revision)="); e64(p5);
  emit(" p6(xt-live)="); e64(p6);
  emit(" p7(ph4=-2)="); e64(p7); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("A-NONPREFIX-STALE=PASS\n");
  } else {
    emit("A-NONPREFIX-STALE=FAIL\n");
  }
  return;
}

// ---- B: prefix TRUNCATE, source damaged at prefix middle ----
fn b_prefix_mid_replace(W:[]u8)void {
  emit("=== B-PREFIX-MID-REPLACE ===\n");
  let t:[]u8=z_alloc(16);
  tt_train_x(W,t);
  let mapx:i32=get32(t,0);
  let f1213:i32=get32(t,8);
  tt_gap(W);
  let z2:i32=ev_query_tt(W,11,72,13,0);
  emit("B-PHASE2-ANS="); e64(z2); emit("\n");
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let xt:i32=tt_find_adapted_relseq(W,e11,2);
  let kind2:i32=0;
  if(xt>=0 && ng(W,xt,12)==2){kind2=1;}
  let s16:i32=tt_src16(W,xt);
  let c0:i32=tt_count16_edges(W);
  emit("B mapx="); e64(mapx); emit(" xt="); e64(xt);
  emit(" kind2="); e64(kind2); emit(" s16="); e64(s16);
  emit(" c0="); e64(c0); emit("\n");
  // world change: same-relation replacement of the prefix middle
  // fact; withdraw shortcut.
  let fnew:i32=ev_teach(W,12,1,98);
  ns(W,f1213,36,0);
  tt_withdraw(W,11,72,13);
  emit("B WORLD-CHANGE taught (12,1,98) as "); e64(fnew);
  emit(", killed (12,1,13)\n");
  let z4:i32=ev_query_tt(W,11,73,99,0);
  emit("B-PHASE4-ANS="); e64(z4); emit("\n");
  let c1:i32=tt_count16_edges(W);
  let e111:[]u8=z_alloc(12);
  set32(e111,0,1); set32(e111,4,1); set32(e111,8,1);
  let p1:i32=0; if(z2==13){p1=1;}
  let p2:i32=0; if(xt>=0 && kind2==1 && s16==mapx){p2=1;}
  let p3:i32=0; if(xt>=0 && tt_relseq_eq(W,xt,e11,2)==0){p3=1;}
  let p4:i32=0; if(tt_relseq_eq(W,mapx,e111,3)==0){p4=1;}
  let p5:i32=0; if(xt>=0 && tt_no16_to(W,xt)==1 && c1==c0){p5=1;}
  let p6:i32=tt_live(W,xt);
  let p7:i32=0; if(z4==-2){p7=1;}
  emit("B p1(ph2=13)="); e64(p1);
  emit(" p2(xt11-kind2-16x)="); e64(p2);
  emit(" p3(xt-stale)="); e64(p3);
  emit(" p4(x-notintact)="); e64(p4);
  emit(" p5(no-revision)="); e64(p5);
  emit(" p6(xt-live)="); e64(p6);
  emit(" p7(ph4=-2)="); e64(p7); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("B-PREFIX-MID-REPLACE=PASS\n");
  } else {
    emit("B-PREFIX-MID-REPLACE=FAIL\n");
  }
  return;
}

// ---- C: prefix TRUNCATE, source damaged at prefix root ----
fn c_prefix_root_replace(W:[]u8)void {
  emit("=== C-PREFIX-ROOT-REPLACE ===\n");
  let t:[]u8=z_alloc(16);
  tt_train_x(W,t);
  let mapx:i32=get32(t,0);
  let f1112:i32=get32(t,4);
  tt_gap(W);
  let z2:i32=ev_query_tt(W,11,72,13,0);
  emit("C-PHASE2-ANS="); e64(z2); emit("\n");
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let xt:i32=tt_find_adapted_relseq(W,e11,2);
  let kind2:i32=0;
  if(xt>=0 && ng(W,xt,12)==2){kind2=1;}
  let s16:i32=tt_src16(W,xt);
  let c0:i32=tt_count16_edges(W);
  emit("C mapx="); e64(mapx); emit(" xt="); e64(xt);
  emit(" kind2="); e64(kind2); emit(" s16="); e64(s16);
  emit(" c0="); e64(c0); emit("\n");
  // world change: same-relation replacement of the prefix root
  // fact; withdraw shortcut.
  let fnew:i32=ev_teach(W,11,1,77);
  ns(W,f1112,36,0);
  tt_withdraw(W,11,72,13);
  emit("C WORLD-CHANGE taught (11,1,77) as "); e64(fnew);
  emit(", killed (11,1,12)\n");
  let z4:i32=ev_query_tt(W,11,73,99,0);
  emit("C-PHASE4-ANS="); e64(z4); emit("\n");
  let c1:i32=tt_count16_edges(W);
  let e111:[]u8=z_alloc(12);
  set32(e111,0,1); set32(e111,4,1); set32(e111,8,1);
  let p1:i32=0; if(z2==13){p1=1;}
  let p2:i32=0; if(xt>=0 && kind2==1 && s16==mapx){p2=1;}
  let p3:i32=0; if(xt>=0 && tt_relseq_eq(W,xt,e11,2)==0){p3=1;}
  let p4:i32=0; if(tt_relseq_eq(W,mapx,e111,3)==0){p4=1;}
  let p5:i32=0; if(xt>=0 && tt_no16_to(W,xt)==1 && c1==c0){p5=1;}
  let p6:i32=tt_live(W,xt);
  let p7:i32=0; if(z4==-2){p7=1;}
  emit("C p1(ph2=13)="); e64(p1);
  emit(" p2(xt11-kind2-16x)="); e64(p2);
  emit(" p3(xt-stale)="); e64(p3);
  emit(" p4(x-notintact)="); e64(p4);
  emit(" p5(no-revision)="); e64(p5);
  emit(" p6(xt-live)="); e64(p6);
  emit(" p7(ph4=-2)="); e64(p7); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("C-PREFIX-ROOT-REPLACE=PASS\n");
  } else {
    emit("C-PREFIX-ROOT-REPLACE=FAIL\n");
  }
  return;
}

// ---- T: theorem positive control, source stays intact ----
fn t_theorem_control(W:[]u8)void {
  emit("=== T-THEOREM-CONTROL ===\n");
  let t:[]u8=z_alloc(16);
  tt_train_x(W,t);
  let mapx:i32=get32(t,0);
  tt_gap(W);
  let z2:i32=ev_query_tt(W,11,72,13,0);
  emit("T-PHASE2-ANS="); e64(z2); emit("\n");
  let e11:[]u8=z_alloc(8);
  set32(e11,0,1); set32(e11,4,1);
  let xt:i32=tt_find_adapted_relseq(W,e11,2);
  emit("T mapx="); e64(mapx); emit(" xt="); e64(xt); emit("\n");
  // world change: duplicate fact only, no kill; withdraw shortcut.
  let fnew:i32=ev_teach(W,13,1,99);
  tt_withdraw(W,11,72,13);
  emit("T WORLD-CHANGE taught (13,1,99) as "); e64(fnew);
  emit(", no kill\n");
  let z4:i32=ev_query_tt(W,11,73,13,0);
  emit("T-PHASE4-ANS="); e64(z4); emit("\n");
  let e111:[]u8=z_alloc(12);
  set32(e111,0,1); set32(e111,4,1); set32(e111,8,1);
  let p1:i32=0; if(z2==13){p1=1;}
  let p2:i32=0; if(xt>=0 && tt_relseq_eq(W,xt,e11,2)==1){p2=1;}
  let p3:i32=0; if(tt_relseq_eq(W,mapx,e111,3)==1){p3=1;}
  let p4:i32=0; if(tt_satisfy_len(W,mapx,11)==3){p4=1;}
  let p5:i32=0; if(xt>=0 && tt_satisfy_len(W,xt,11)==2){p5=1;}
  let p6:i32=0; if(xt>=0 && tt_no16_to(W,xt)==1){p6=1;}
  let p7:i32=0; if(z4==13){p7=1;}
  emit("T p1(ph2=13)="); e64(p1);
  emit(" p2(xt-intact)="); e64(p2);
  emit(" p3(x-relseq)="); e64(p3);
  emit(" p4(x-sat3)="); e64(p4);
  emit(" p5(xt-sat2)="); e64(p5);
  emit(" p6(no16-to-xt)="); e64(p6);
  emit(" p7(ph4=13)="); e64(p7); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1){
    emit("T-THEOREM-CONTROL=PASS\n");
  } else {
    emit("T-THEOREM-CONTROL=FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("TT-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); a_nonprefix_stale(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); b_prefix_mid_replace(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); c_prefix_root_replace(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); t_theorem_control(W4);
  emit("TT-END\n");
  return 0;
}

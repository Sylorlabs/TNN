// tt_patch.zag -- NONPREFIX-ONE operator and ev_query_tt.
//
// Context: ADAPT-REVISION-OPS-COMPLETE proved that a pure-prefix
// TRUNCATE adaptation cannot go stale while its source is live and
// intact. This patch adds the boundary probe: NONPREFIX-ONE, a
// TRUNCATE variant that drops the FIRST link (head-drop) instead of
// the tail, so the adaptation is a proper sub-segment of the source
// but not a pure prefix of it.
//
// NONPREFIX-ONE (adapt_nonprefix): for each live native MAP m with
// relseq length 3 <= L < 7 fully satisfied from s, build the
// head-drop segment R[1..L-1] (drop exactly the first link) from
// values vals[1..L] and licensing facts fids[1..L-1]; dedup on the
// exact candidate relseq; t2_asm_chain; t2_try_verify from the
// segment root to the segment terminal; adapt_promote (teaches NO
// fact); record kind 2 (TRUNCATE) in field 12; type-16 edge new ->
// m. Names no relation, MAP, length, query, or expected value.
//
// ev_query_tt: ev_query_revise2 verbatim except the fresh-adaptation
// fallback runs adapt_extend + adapt_truncate + adapt_nonprefix +
// adapt_specialize (in that order), then recomposes once if
// anything was created. The order keeps arms B/C/T replicating
// the prior T1/T2 behavior: the prefix truncation is created
// before the head-drop, so the head-drop dedups away there.
//
// No new subsystems, dispatchers, semantic cases, opcodes, or
// new MAP/edge types.

// NONPREFIX-ONE inner loop for one source MAP src, fully satisfied
// from s. Builds the head-drop segment (links 1..L-1). The new
// MAP's type-16 edge points to linkto. Records kind 2 in field 12.
// Returns the count created (0 or 1).
fn tt_nonprefix_src(W:[]u8,src:i32,s:i32,masked:i32,linkto:i32)i32 {
  let nmk:i32=0;
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,src,seq,7);
  if(L>=3 && L<7){
    let vals:[]u8=z_alloc(36);
    let fids:[]u8=z_alloc(32);
    let ln:i32=cc_satisfy(W,src,s,vals,fids);
    if(ln==L){
      let k:i32=L-1;
      let cv:[]u8=z_alloc(40);
      let cf:[]u8=z_alloc(36);
      let cs:[]u8=z_alloc(28);
      let i:i32=0;
      while(i<=k){set32(cv,i*4,get32(vals,(i+1)*4)); i=i+1;}
      i=0;
      while(i<k){
        set32(cf,i*4,get32(fids,(i+1)*4));
        set32(cs,i*4,get32(seq,(i+1)*4));
        i=i+1;
      }
      if(ts_relseq_present(W,cs,k)==0){
        let root:i32=t2_asm_chain(W,cv,k+1,cf);
        if(root>=0){
          let st:[]u8=z_alloc(8);
          set32(st,0,0); set32(st,4,0);
          let s0:i32=get32(cv,0);
          let term:i32=get32(cv,k*4);
          let chk:i32=t2_try_verify(W,root,s0,term,masked,st);
          if(chk!=-2){
            let am:i32=adapt_promote(W,root,s0,ng(W,src,4),term,cf,k);
            if(am>=0){
              ns(W,am,12,2);
              link_edge(W,am,16,linkto,0);
              emit("TT-NONPREFIX-MK id="); e64(am);
              emit(" src="); e64(src);
              emit(" linkto="); e64(linkto);
              emit(" len="); e64(k); emit("\n");
              nmk=nmk+1;
            }
          }
        }
      }
    }
  }
  return nmk;
}

// Fresh NONPREFIX-ONE over all live native MAPs.
fn adapt_nonprefix(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && adapt_is_native(W,m)==1){
      nmk=nmk+tt_nonprefix_src(W,m,s,masked,m);
    }
    m=m+1;
  }
  return nmk;
}

// ev_query with the kind-dispatched revision bracket and the
// four-operator fresh-adaptation fallback (extend, truncate,
// nonprefix, specialize). Verbatim copy of ev_query_revise2 from
// ts_patch.zag except for the added adapt_nonprefix call and the
// function name.
fn ev_query_tt(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    // ---- L2 adaptation revision (kind-dispatched), then fresh
    // adaptation (extend, truncate, nonprefix, specialize) ----
    emit("ADAPT-TRY\n");
    let nmk:i32=adapt_revise2(W,s,masked);
    if(nmk==0){
      nmk=adapt_extend(W,s,masked)+adapt_truncate(W,s,masked)+adapt_nonprefix(W,s,masked)+adapt_specialize(W,s,masked);
    }
    emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
    if(nmk>0){
      let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
      emit("COMP-STAT2 tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
      if(ca2!=-2){
        hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
        log_ev(W,2,s,r,ca2,1,0,0); return ca2;
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// xio_core2.zag -- Generalized typed I/O adapters (H-XIO-4, unfrozen).
// Pure Zag. No Python. Safebin PATH.
//
// This core repairs the XIO generality boundary localized by XIO-THIRD:
// the 2-bucket oty conflated two structurally distinct MAP families in
// bucket 1 while the bucket-1 stage executor hardcoded one family's
// re-derivation. The repair grows the type system and the stage
// executors together:
//
// 1. A richer learner-observed structural signature xio_sclass(W, m).
//    It walks the MAP's own executable graph (BRANCHEQ true-targets for
//    tag-102 cells, SEQ edges otherwise, the same walk pattern as
//    xio_oty) and counts three structural features: g = guard cells
//    (tag 102), ic = INC cells (tag 103 of the frozen 4-op ISA),
//    other = any other cell tag. The class is an integer only:
//      g > 0 and ic > 0              -> class 1 (mixed structure)
//      g > 0 and ic == 0             -> class 0 (guard-only structure)
//      g == 0 and ic > 0 and other == 0 -> class 2 (INC-only structure)
//      otherwise                     -> class -1 (unknown, fail-closed)
//    No domain names, no type table, no pair templates anywhere in
//    this file. The integers come from the MAP's own graph structure.
//
// 2. Per-structural-class stage dispatch in xio_stage_exec. The stage
//    executor is selected by the observed structural class, not by a
//    hardcoded 2-branch:
//      class 0: re-derivation via the learner's t2_gather +
//               t2_asm_chain (plen match), verified masked with the
//               stage input as the frame subject.
//      class 1: re-derivation via the learner's DEP-provenance
//               relation + t2_chain + t2_asm_count, verified masked
//               with the stage input as the frame subject.
//      class 2: total re-derivation (NEW). Reads the licensing
//               relation from the MAP's own DEP provenance edges,
//               gathers the stage input's direct facts under exactly
//               that relation, rebuilds the total with the learner's
//               own t2_asm_sum, and verifies masked with frame slot0
//               starting at 0. The s0=0 frame mirrors trial's own
//               class-2 candidate verification frame, exactly as the
//               class-0/1 branches mirror trial's class-0/1 frames.
//      class -1: fail-closed (-999999).
//
// 3. The mismatch gate moves from oty-difference to sclass-difference:
//    ordered pairs (m1, m2), m1 != m2, are admitted iff
//    sclass(m1) != sclass(m2). On worlds with two families this admits
//    exactly the same pairs as before; it additionally admits future
//    cross-family pairs the 2-bucket gate would wrongly reject.
//    Same-class pairs are never candidates.
//
// The coarse xio_oty (INC-cell presence: 1 = NUMBER, else 0 = NODE)
// is kept verbatim as the 2-bucket view. The adapter node layout is
// unchanged: 0=tag40, 4=m1, 8=m2, 12=c1, 16=c2, 20=rel1, 24=rel2,
// 28=answer, 32=query relation; slots 12/16 now hold the structural
// class. Stage relations are read from each MAP's own DEP provenance
// edges. The paired MAPs are chosen by verified trial, never specified
// by the researcher.

// ---- typed signature: 1 (NUMBER) if the graph contains an INC cell,
// ---- else 0 (NODE). Computed over learner-built white-box state.
// ---- Kept verbatim: the coarse 2-bucket view of the same observation.
fn xio_oty(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// ---- structural class: 0 = guard-only graph, 1 = guard+INC mixed
// ---- graph, 2 = INC-only graph, -1 = unknown. Integers only; the
// ---- discriminators are guard presence and INC-only vs mixed cells,
// ---- observed from the MAP's own graph structure.
fn xio_sclass(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0;
  let g:i32=0; let ic:i32=0; let other:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){g=g+1; cur=ng(W,cur,12);}
    else {
      if(tag==103){ic=ic+1;}
      else {other=other+1;}
      cur=seq_nx(W,cur);
    }
    steps=steps+1;
  }
  if(g+ic+other==0){return -1;}
  if(g>0 && ic>0){return 1;}
  if(g>0 && ic==0){return 0;}
  if(g==0 && ic>0 && other==0){return 2;}
  return -1;
}
// ---- input relation of a stage, from the MAP's own DEP edges to its
// ---- licensing facts. -1 if no provenance found.
fn xio_dep_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      if(to>=2 && to<1024 && ng(W,to,36)==1 && ng(W,to,0)==1){
        return ng(W,to,24);
      }
    }
    e=e+1;
  }
  return -1;
}
// ---- direct facts of subject s under relation r: values + fact ids.
// ---- The relation-filtered analog of t2_gather_sum. Returns the
// ---- fact count (cap 12).
fn xio_gather_direct(W:[]u8,s:i32,r:i32,vals:[]u8,facts:[]u8)i32 {
  let n:i32=0; let x:i32=2;
  while(x<1024 && n<12){
    if(ng(W,x,36)==1 && ng(W,x,0)==1 && ng(W,x,20)==s && ng(W,x,24)==r){
      set32(vals,n*4,ng(W,x,28)); set32(facts,n*4,x); n=n+1;
    }
    x=x+1;
  }
  return n;
}
// ---- 1 if any active MAP has a NUMBER output type (oty 1).
fn xio_has_typed(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xio_oty(W,m)==1){return 1;}
    m=m+1;
  }
  return 0;
}
// ---- class-2 stage: re-derive the MAP's own total computation for
// ---- input x. Relation from the MAP's own licensing DEP edges;
// ---- values from x's direct facts under that relation; rebuilt with
// ---- the learner's own t2_asm_sum; verified masked with slot0=0,
// ---- mirroring trial's class-2 candidate frame. Returns the total
// ---- or -999999.
fn xio_stage_c2(W:[]u8,m:i32,x:i32)i32 {
  let rel:i32=xio_dep_rel(W,m);
  if(rel<0){return -999999;}
  let vals:[]u8=z_alloc(48); let ff:[]u8=z_alloc(48);
  if(vals.len<48 || ff.len<48){return -999999;}
  let n:i32=xio_gather_direct(W,x,rel,vals,ff);
  if(n<1){return -999999;}
  let root:i32=t2_asm_sum(W,vals,n);
  if(root<0){return -999999;}
  let st:[]u8=z_alloc(8);
  if(st.len<8){return -999999;}
  set32(st,0,0); set32(st,4,0);
  let v:i32=t2_try_verify(W,root,0,-2,1,st);
  if(v!=-2 && v!=-999999){return v;}
  return -999999;
}
// ---- re-derive one stage for input x and execute it, masked verify
// ---- (first valid output). The executor is selected by the observed
// ---- structural class, not by a hardcoded 2-branch. Returns the
// ---- output or -999999.
fn xio_stage_exec(W:[]u8,m:i32,x:i32)i32 {
  let sc:i32=xio_sclass(W,m);
  if(sc==0){
    let plen:i32=rb_chain_plen(W,ng(W,m,20));
    if(plen<2){return -999999;}
    let paths:[]u8=z_alloc(4608);
    if(paths.len<4608){return -999999;}
    let np:i32=t2_gather(W,x,paths);
    let p:i32=0;
    while(p<np){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        if(v.len>=24 && f.len>=16){
          let j:i32=0;
          while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,plen,f);
          if(root>=0){
            let st:[]u8=z_alloc(8);
            if(st.len>=8){
              set32(st,0,0); set32(st,4,0);
              let vv:i32=t2_try_verify(W,root,x,-2,1,st);
              if(vv!=-2 && vv!=-999999){return vv;}
            }
          }
        }
      }
      p=p+1;
    }
    return -999999;
  }
  if(sc==1){
    let rel:i32=xio_dep_rel(W,m);
    if(rel<0){return -999999;}
    let vv2:[]u8=z_alloc(64); let ff2:[]u8=z_alloc(60);
    if(vv2.len<64 || ff2.len<60){return -999999;}
    let len:i32=t2_chain(W,x,rel,vv2,ff2);
    if(len<2){return -999999;}
    let root2:i32=t2_asm_count(W,vv2,len,ff2);
    if(root2<0){return -999999;}
    let st2:[]u8=z_alloc(8);
    if(st2.len<8){return -999999;}
    set32(st2,0,0); set32(st2,4,0);
    let ww:i32=t2_try_verify(W,root2,x,-2,1,st2);
    if(ww!=-2 && ww!=-999999){return ww;}
    return -999999;
  }
  if(sc==2){return xio_stage_c2(W,m,x);}
  return -999999;
}
// ---- build the persistent adapter node. Layout: 0=tag40, 4=m1,
// ---- 8=m2, 12=c1, 16=c2, 20=rel1, 24=rel2, 28=answer,
// ---- 32=query relation. DEP edges adapter -> m1, m2 (provenance).
fn xio_build(W:[]u8,m1:i32,m2:i32,c1:i32,c2:i32,rel1:i32,rel2:i32,qr:i32,ans:i32)i32 {
  let a:i32=alloc_node(W);
  if(a<0){return -1;}
  ns(W,a,0,40);
  ns(W,a,4,m1); ns(W,a,8,m2);
  ns(W,a,12,c1); ns(W,a,16,c2);
  ns(W,a,20,rel1); ns(W,a,24,rel2);
  ns(W,a,28,ans); ns(W,a,32,qr);
  link_edge(W,a,1,m1,0);
  link_edge(W,a,1,m2,0);
  return a;
}
// ---- execute an adapter: value-level handoff v1 = m1(s),
// ---- v2 = m2(v1). Returns v2 or -999999.
fn xio_exec(W:[]u8,a:i32,s:i32)i32 {
  let m1:i32=ng(W,a,4); let m2:i32=ng(W,a,8);
  if(m1<2 || m2<2){return -999999;}
  if(ng(W,m1,36)!=1 || ng(W,m2,36)!=1){return -999999;}
  if(ng(W,m1,0)!=20 || ng(W,m2,0)!=20){return -999999;}
  let v1:i32=xio_stage_exec(W,m1,s);
  if(v1==-999999 || v1==-2){return -999999;}
  let v2:i32=xio_stage_exec(W,m2,v1);
  if(v2==-999999 || v2==-2){return -999999;}
  return v2;
}
// ---- find the adapter serving query relation r. -1 if none.
fn xio_find(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,32)==r){return n;}
    n=n+1;
  }
  return -1;
}
// ---- count active adapters (audit).
fn xio_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){c=c+1;}
    n=n+1;
  }
  return c;
}
// ---- adapter lookup for a query: execute the relation-keyed adapter
// ---- and verify. Emits XIO-REUSE on success. Returns ans or -2.
fn xio_adapt(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let a:i32=xio_find(W,r);
  if(a<0){return -2;}
  let v:i32=xio_exec(W,a,s);
  if(v==-999999 || v==-2){return -2;}
  if(expected!=-2 && v!=expected){return -2;}
  hs(W,16,0);
  emit("XIO-REUSE id="); e64(a); emit(" ans="); e64(v); emit("\n");
  return v;
}
// ---- typed composition trial: ordered MAP pairs with DIFFERING
// ---- structural classes only (the mismatch gate). On v2 == expected,
// ---- build the adapter. Emits XIO-BUILD on success. Returns ans or -2.
fn xio_try(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  if(expected==-2){return -2;}
  if(xio_has_typed(W)==0){return -2;}
  let tried:i32=0; let rej:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let c1:i32=xio_sclass(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let c2:i32=xio_sclass(W,m2);
          if(c1!=c2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            if(v1!=-999999 && v1!=-2){
              let v2:i32=xio_stage_exec(W,m2,v1);
              if(v2!=-999999 && v2!=-2 && v2==expected){
                let r1:i32=xio_dep_rel(W,m1);
                let r2:i32=xio_dep_rel(W,m2);
                let a:i32=xio_build(W,m1,m2,c1,c2,r1,r2,r,v2);
                if(a<0){return -2;}
                hs(W,16,tried*1024+rej);
                emit("XIO-BUILD id="); e64(a);
                emit(" m1="); e64(m1); emit(" m2="); e64(m2);
                emit(" c1="); e64(c1); emit(" c2="); e64(c2);
                emit(" rel1="); e64(r1); emit(" rel2="); e64(r2);
                emit(" qr="); e64(r); emit(" mid="); e64(v1);
                emit(" ans="); e64(v2); emit("\n");
                return v2;
              }
            }
            rej=rej+1;
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  return -2;
}
// ---- unified query with the adapter stages. xio_on=1 enables adapter
// ---- lookup and typed composition; xio_on=0 reproduces the baseline
// ---- pipeline (ablation). Not a mode: xio_try is attempted
// ---- uniformly on any query where lookup and rebind failed, keyed
// ---- only by learner state, with no task-label routing.
fn xio_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,xio_on:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    let _l:i32=link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  if(xio_on==1){
    let aa:i32=xio_adapt(W,s,r,expected);
    if(aa!=-2){log_ev(W,2,s,r,aa,1,0,0); return aa;}
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0));
  emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(xio_on==1){
    let xa:i32=xio_try(W,s,r,expected);
    if(xa!=-2){log_ev(W,2,s,r,xa,1,0,0); return xa;}
  }
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

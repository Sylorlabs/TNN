// xg_driver.zag -- H-XIO-4 three-pair battery driver (unfrozen).
// Pure Zag. No Python. Safebin PATH.
//
// Three pair-worlds, each with a fresh learner state, run against the
// generalized XIO core (xio_core2.zag):
//   PAIR-A replicates the C229 world (chain->count):
//     Z1=(31,93)->2, Z2a=(41,93)->2, Z2b=(71,94)->2. Arms: TREAT, ABL-XIO.
//   PAIR-B replicates the C235 world (count->chain):
//     Z1=(21,93)->52, Z2a=(41,93)->52, Z2b=(71,94)->32. Arms: TREAT, ABL-XIO.
//   PAIR-C replicates the XIO-THIRD world (chain->sum):
//     Z1=(41,93)->10, Z2a=(51,93)->10, Z2b=(71,94)->10.
//     Arms: TREAT, ABL-XIO, ABL-X, ABL-Y, FRESH, AUDIT.
// Facts and queries are replicated from ../xio_adapters/xio_driver.zag,
// ../xio_harder/xhio_driver.zag, and ../xio_third/x3_driver.zag
// respectively. The ONLY new driver content is the shared census
// (which now reports the learner-observed structural class) and the
// structural-class pair audit.

fn xg_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024);
  emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn xg_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// MAP census: id, relation, subject, answer, chain plen (or -1),
// learner-observed output type, learner-observed structural class,
// driver-side class label (observability only, not the type system).
fn xg_census_one(W:[]u8,m:i32)void {
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  let o:i32=xio_oty(W,m);
  let c:i32=xio_sclass(W,m);
  emit("MAP id="); e64(m);
  emit(" r="); e64(ng(W,m,4));
  emit(" s="); e64(ng(W,m,8));
  emit(" ans="); e64(ng(W,m,28));
  emit(" plen="); e64(p);
  emit(" oty="); e64(o);
  emit(" sclass="); e64(c);
  emit(" class=");
  if(c==0){emit("chain");}
  else {
    if(c==1){emit("count");}
    else {
      if(c==2){emit("sum");}
      else {emit("other");}
    }
  }
  emit("\n");
  return;
}
fn xg_census(W:[]u8)void {
  emit("maps="); e64(xg_count_maps(W)); emit("\n");
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){xg_census_one(W,m);}
    m=m+1;
  }
  return;
}
// Adapter census: id, stage MAPs, structural signature, relations, answer.
fn xg_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" c1="); e64(ng(W,n,12)); emit(" c2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28));
      emit("\n");
    }
    n=n+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X / ABL-Y).
fn xg_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn xg_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// Pair audit: for every ordered MAP pair, apply the mismatch gate on
// the structural class and report stage outputs via the core's own
// xio_stage_exec. Same-class pairs are counted as gate-rejected.
// White-box observability of the gate + stage dispatch; touches nothing.
fn xg_pairaudit(W:[]u8,s:i32,r:i32)void {
  emit("PAIR-AUDIT s="); e64(s); emit(" r="); e64(r); emit("\n");
  let tried:i32=0; let rej:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let c1:i32=xio_sclass(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let c2:i32=xio_sclass(W,m2);
          if(c1!=c2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            let v2:i32=-999999;
            if(v1!=-999999 && v1!=-2){ v2=xio_stage_exec(W,m2,v1); }
            emit("PAIR m1="); e64(m1); emit(" c1="); e64(c1);
            emit(" m2="); e64(m2); emit(" c2="); e64(c2);
            emit(" v1="); e64(v1); emit(" v2="); e64(v2); emit("\n");
          } else { rej=rej+1; }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("PAIR-SUMMARY tried="); e64(tried);
  emit(" gate_rejected="); e64(rej); emit("\n");
  return;
}
// ================= PAIR-A: C229 world (chain->count) =================
// X = CHAIN (r=81 facts, query r=91); Y = COUNT (r=82 facts, query
// r=92); Z facts: chain then two 82-links; query (b,qr) -> 2.
fn xgA_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1 ans="); e64(x1); xg_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2 ans="); e64(x2); xg_tstat(W);
  return;
}
fn xgA_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1 ans="); e64(y1); xg_tstat(W);
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2 ans="); e64(y2); xg_tstat(W);
  return;
}
fn xgA_zfacts(W:[]u8,b:i32)void {
  ev_teach(W,b,81,b+1); ev_teach(W,b+1,81,b+2); ev_teach(W,b+2,81,b+3);
  ev_teach(W,b+3,82,b+4); ev_teach(W,b+4,82,b+5);
  return;
}
fn xgA_zq(W:[]u8,tag:[]u8,b:i32,qr:i32,xon:i32)void {
  let z:i32=xio_query(W,b,qr,2,0,xon);
  emit(tag); emit(" ans="); e64(z); xg_tstat(W);
  xg_acensus(W);
  return;
}
fn xgA_arm_treat(W:[]u8)void {
  emit("=== PAIR-A TREAT ===\n");
  xgA_trainX(W,1);
  xgA_trainY(W,1);
  xg_gap(W);
  xg_census(W);
  xgA_zfacts(W,31); xgA_zq(W,"Z1",31,93,1);
  xgA_zfacts(W,41); xgA_zq(W,"Z2a",41,93,1);
  xgA_zfacts(W,71); xgA_zq(W,"Z2b",71,94,1);
  return;
}
fn xgA_arm_ablxio(W:[]u8)void {
  emit("=== PAIR-A ABL-XIO ===\n");
  xgA_trainX(W,0);
  xgA_trainY(W,0);
  xg_gap(W);
  xg_census(W);
  xgA_zfacts(W,31); xgA_zq(W,"Z1",31,93,0);
  xgA_zfacts(W,41); xgA_zq(W,"Z2a",41,93,0);
  xgA_zfacts(W,71); xgA_zq(W,"Z2b",71,94,0);
  return;
}
// ================= PAIR-B: C235 world (count->chain) =================
// X = COUNT (r=81 facts, query r=91); Y = CHAIN on numeric subjects
// (r=82 facts, query r=92); Z1=(21,93)->52, Z2a=(41,93)->52,
// Z2b=(71,94)->32.
fn xgB_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,3,0,xon);
  emit("X1 ans="); e64(x1); xg_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17);
  let x2:i32=xio_query(W,15,91,2,0,xon);
  emit("X2 ans="); e64(x2); xg_tstat(W);
  return;
}
fn xgB_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,3,82,30); ev_teach(W,30,82,31); ev_teach(W,31,82,32);
  let y1:i32=xio_query(W,3,92,32,0,xon);
  emit("Y1 ans="); e64(y1); xg_tstat(W);
  ev_teach(W,2,82,40); ev_teach(W,40,82,41); ev_teach(W,41,82,42);
  let y2:i32=xio_query(W,2,92,42,0,xon);
  emit("Y2 ans="); e64(y2); xg_tstat(W);
  return;
}
fn xgB_z1facts(W:[]u8)void {
  ev_teach(W,21,81,22); ev_teach(W,22,81,23);
  ev_teach(W,23,81,24); ev_teach(W,24,81,25);
  ev_teach(W,4,82,50); ev_teach(W,50,82,51); ev_teach(W,51,82,52);
  return;
}
fn xgB_z2afacts(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43);
  ev_teach(W,43,81,44); ev_teach(W,44,81,45);
  return;
}
fn xgB_z2bfacts(W:[]u8)void {
  ev_teach(W,71,81,72); ev_teach(W,72,81,73); ev_teach(W,73,81,74);
  return;
}
fn xgB_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); xg_tstat(W);
  xg_acensus(W);
  return;
}
fn xgB_arm_treat(W:[]u8)void {
  emit("=== PAIR-B TREAT ===\n");
  xgB_trainX(W,1);
  xgB_trainY(W,1);
  xg_gap(W);
  xg_census(W);
  xgB_z1facts(W); xgB_zq(W,"Z1",21,93,52,1);
  xgB_z2afacts(W); xgB_zq(W,"Z2a",41,93,52,1);
  xgB_z2bfacts(W); xgB_zq(W,"Z2b",71,94,32,1);
  return;
}
fn xgB_arm_ablxio(W:[]u8)void {
  emit("=== PAIR-B ABL-XIO ===\n");
  xgB_trainX(W,0);
  xgB_trainY(W,0);
  xg_gap(W);
  xg_census(W);
  xgB_z1facts(W); xgB_zq(W,"Z1",21,93,52,0);
  xgB_z2afacts(W); xgB_zq(W,"Z2a",41,93,52,0);
  xgB_z2bfacts(W); xgB_zq(W,"Z2b",71,94,32,0);
  return;
}
// ================= PAIR-C: XIO-THIRD world (chain->sum) =================
// X = CHAIN/sequence (r=81 facts, query r=91); Y = SUM/aggregate
// (r=82 facts, query r=92); Z = SUM(CHAIN(s)):
// Z1=(41,93)->10, Z2a=(51,93)->10, Z2b=(71,94)->10.
fn xgC_comb(W:[]u8)void {
  let cn:i32=alloc_node(W);
  if(cn>=0){ns(W,cn,0,8); write_node(W,cn,1,0,0,0);}
  return;
}
fn xgC_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1 ans="); e64(x1); xg_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2 ans="); e64(x2); xg_tstat(W);
  return;
}
fn xgC_trainY(W:[]u8,xon:i32)void {
  xgC_comb(W);
  ev_teach(W,20,82,3); ev_teach(W,20,82,5);
  let y1:i32=xio_query(W,20,92,8,0,xon);
  emit("Y1 ans="); e64(y1); xg_tstat(W);
  ev_teach(W,30,82,4); ev_teach(W,30,82,6); ev_teach(W,30,82,2);
  let y2:i32=xio_query(W,30,92,12,0,xon);
  emit("Y2 ans="); e64(y2); xg_tstat(W);
  return;
}
fn xgC_z1facts(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43); ev_teach(W,43,81,44);
  ev_teach(W,44,82,3); ev_teach(W,44,82,7);
  return;
}
fn xgC_z2afacts(W:[]u8)void {
  ev_teach(W,51,81,52); ev_teach(W,52,81,53); ev_teach(W,53,81,54);
  ev_teach(W,54,82,2); ev_teach(W,54,82,8);
  return;
}
fn xgC_z2bfacts(W:[]u8)void {
  ev_teach(W,71,81,72); ev_teach(W,72,81,73); ev_teach(W,73,81,74);
  ev_teach(W,74,82,1); ev_teach(W,74,82,9);
  return;
}
fn xgC_zq(W:[]u8,tag:[]u8,s:i32,r:i32,expected:i32,xon:i32)void {
  let z:i32=xio_query(W,s,r,expected,0,xon);
  emit(tag); emit(" ans="); e64(z); xg_tstat(W);
  xg_acensus(W);
  return;
}
fn xgC_arm_treat(W:[]u8)void {
  emit("=== PAIR-C TREAT ===\n");
  xgC_trainX(W,1);
  xgC_trainY(W,1);
  xg_gap(W);
  xg_census(W);
  xgC_z1facts(W); xgC_zq(W,"Z1",41,93,10,1);
  xgC_z2afacts(W); xgC_zq(W,"Z2a",51,93,10,1);
  xgC_z2bfacts(W); xgC_zq(W,"Z2b",71,94,10,1);
  return;
}
fn xgC_arm_ablxio(W:[]u8)void {
  emit("=== PAIR-C ABL-XIO ===\n");
  xgC_trainX(W,0);
  xgC_trainY(W,0);
  xg_gap(W);
  xg_census(W);
  xgC_z1facts(W); xgC_zq(W,"Z1",41,93,10,0);
  xgC_z2afacts(W); xgC_zq(W,"Z2a",51,93,10,0);
  xgC_z2bfacts(W); xgC_zq(W,"Z2b",71,94,10,0);
  return;
}
fn xgC_arm_ablx(W:[]u8)void {
  emit("=== PAIR-C ABL-X ===\n");
  xgC_trainX(W,1);
  xgC_trainY(W,1);
  xg_del_map_r(W,91);
  emit("maps after del="); e64(xg_count_maps(W)); emit("\n");
  xg_gap(W);
  xgC_z1facts(W); xgC_zq(W,"Z1",41,93,10,1);
  xgC_z2afacts(W); xgC_zq(W,"Z2a",51,93,10,1);
  xgC_z2bfacts(W); xgC_zq(W,"Z2b",71,94,10,1);
  return;
}
fn xgC_arm_ably(W:[]u8)void {
  emit("=== PAIR-C ABL-Y ===\n");
  xgC_trainX(W,1);
  xgC_trainY(W,1);
  xg_del_map_r(W,92);
  emit("maps after del="); e64(xg_count_maps(W)); emit("\n");
  xg_gap(W);
  xgC_z1facts(W); xgC_zq(W,"Z1",41,93,10,1);
  xgC_z2afacts(W); xgC_zq(W,"Z2a",51,93,10,1);
  xgC_z2bfacts(W); xgC_zq(W,"Z2b",71,94,10,1);
  return;
}
fn xgC_arm_fresh(W:[]u8)void {
  emit("=== PAIR-C FRESH ===\n");
  xgC_comb(W);
  xg_gap(W);
  xgC_z1facts(W); xgC_zq(W,"Z1",41,93,10,0);
  xgC_z2afacts(W); xgC_zq(W,"Z2a",51,93,10,0);
  xgC_z2bfacts(W); xgC_zq(W,"Z2b",71,94,10,0);
  return;
}
fn xgC_arm_audit(W:[]u8)void {
  emit("=== PAIR-C AUDIT ===\n");
  xgC_trainX(W,1);
  xgC_trainY(W,1);
  xg_gap(W);
  xg_census(W);
  xgC_z1facts(W);
  xg_pairaudit(W,41,93);
  xgC_zq(W,"Z1",41,93,10,1);
  return;
}
// ev_query: cx_core.zag's internal test battery references this symbol.
// Provided here as the adapter pipeline (adapters enabled). The battery
// is never invoked by this driver; the entry point is xio_query.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("XG-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); xgA_arm_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); xgA_arm_ablxio(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); xgB_arm_treat(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); xgB_arm_ablxio(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); xgC_arm_treat(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); xgC_arm_ablxio(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); xgC_arm_ablx(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); xgC_arm_ably(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); xgC_arm_fresh(W9);
  let W10:[]u8=z_alloc(110656); tnn2_init(W10); xgC_arm_audit(W10);
  emit("XG-END\n");
  return 0;
}

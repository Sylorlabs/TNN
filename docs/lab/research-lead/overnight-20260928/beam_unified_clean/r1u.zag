// Q4 alternative-explanation attack harness (step 6).
// Pure Zag. Fixed seeds. Deterministic.
// Tests: ENUM (256-behavior enumeration on 3 evidence sets),
// RANDIV (phase1 with random interventions), FULLMEM (D table from
// the same 32 Phase-1 observations, composed as C' = D_table XOR x4).
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
fn get32(b:[]u8, off:i32)i32 {
  let v:i32=b[off] as i32;
  v=v | ((b[off+1] as i32)<<8);
  v=v | ((b[off+2] as i32)<<16);
  v=v | ((b[off+3] as i32)<<24);
  return v;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=(v&255) as u8;
  b[off+1]=((v>>8)&255) as u8;
  b[off+2]=((v>>16)&255) as u8;
  b[off+3]=((v>>24)&255) as u8;
  return;
}
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  s=(s*1103515245+12345)&2147483647;
  sts(st, 16, s);
  return s;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return (r>>8)%n;
}
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  if(fam==5){
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let r:i32=t1 | t2;
    return r;
  }
  if(fam==6){
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let r:i32=d ^ x4;
    return r;
  }
  return 0;
}
// 64-bit truth signature of 3-bit behavior b (bit c replicated over x with (x&7)==c)
fn sig_of_3bit(b:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  let x:i32=0;
  while(x<64){
    let bit:i32=(b>>(x&7))&1;
    if(bit==1){
      if(x<32){ lo=lo | (1<<x); } else { hi=hi | (1<<(x-32)); }
    }
    x=x+1;
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn sig_pred(lo:i32, hi:i32, x:i32)i32 {
  if(x<32){ return (lo>>x)&1; }
  return (hi>>(x-32))&1;
}
fn ev_correct(lo:i32, hi:i32, ev_x:[]u8, ev_y:[]u8, en:i32)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    if(sig_pred(lo, hi, x)==y){ c=c+1; }
    e=e+1;
  }
  return c;
}
fn true_correct_sig(fam:i32, lo:i32, hi:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    if(sig_pred(lo, hi, x)==sealed(fam, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}
// behavior byte of the true F-PARCOND D over combos 0..7
fn d_behavior()i32 {
  let b:i32=0;
  let c:i32=0;
  while(c<8){
    if(sealed(5, c)==1){ b=b | (1<<c); }
    c=c+1;
  }
  return b;
}
// ---- copied search machinery (verbatim logic from q4_parcond.zag) ----
fn ndg(nodes:[]u8, n:i32, off:i32)i32 { return get32(nodes, n*28+off); }
fn nds(nodes:[]u8, n:i32, off:i32, v:i32)void { set32(nodes, n*28+off, v); return; }
fn sig_hash(lo:i32, hi:i32)i32 {
  let h1:i32=hi * 33;
  let h2:i32=lo ^ h1;
  let h:i32=h2 & 16383;
  return h;
}
fn sig_lookup(sigtab:[]u8, nodes:[]u8, lo:i32, hi:i32)i32 {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){ return -1; }
    let n:i32=slot-1;
    let nlo:i32=ndg(nodes, n, 16);
    if(nlo==lo){
      let nhi:i32=ndg(nodes, n, 20);
      if(nhi==hi){ return n; }
    }
    i=i+1;
  }
  return -1;
}
fn sig_insert(sigtab:[]u8, lo:i32, hi:i32, n:i32)void {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){
      set32(sigtab, idx*4, n+1);
      return;
    }
    i=i+1;
  }
  return;
}
fn term_sig(t:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  if(t<6){
    let x:i32=0;
    while(x<64){
      let bit:i32=(x>>t)&1;
      if(bit==1){
        if(x<32){
          let m:i32=1<<x;
          lo=lo | m;
        } else {
          let m:i32=1<<(x-32);
          hi=hi | m;
        }
      }
      x=x+1;
    }
  } else {
    if(t==7){
      lo=-1;
      hi=-1;
    }
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn node_new_term(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32)i32 {
  let sob:[]u8=z_alloc(8);
  term_sig(t, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_op(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 16);
  let hi0:i32=ndg(nodes, c0, 20);
  let lo:i32=0;
  let hi:i32=0;
  let oc:i32=0;
  if(op==0){
    let lo1:i32=ndg(nodes, c1, 16);
    let hi1:i32=ndg(nodes, c1, 20);
    lo=lo0 & lo1;
    hi=hi0 & hi1;
    oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
  } else {
    if(op==1){
      let lo1:i32=ndg(nodes, c1, 16);
      let hi1:i32=ndg(nodes, c1, 20);
      lo=lo0 | lo1;
      hi=hi0 | hi1;
      oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
    } else {
      if(op==2){
        lo=lo0 ^ -1;
        hi=hi0 ^ -1;
        oc=1 + ndg(nodes, c0, 24);
      } else {
        let lo1:i32=ndg(nodes, c1, 16);
        let hi1:i32=ndg(nodes, c1, 20);
        lo=lo0 ^ lo1;
        hi=hi0 ^ hi1;
        oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
      }
    }
  }
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, oc);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  let tc:i32=stg(st, 4);
  if(tc<4096){
    set32(trace, tc*20+0, op);
    set32(trace, tc*20+4, c0);
    set32(trace, tc*20+8, c1);
    set32(trace, tc*20+12, nc);
    set32(trace, tc*20+16, stg(st, 12));
    sts(st, 4, tc+1);
  }
  return nc;
}
fn node_pred(nodes:[]u8, n:i32, x:i32)i32 {
  let slo:i32=ndg(nodes, n, 16);
  if(x<32){
    let p:i32=(slo>>x)&1;
    return p;
  }
  let shi:i32=ndg(nodes, n, 20);
  let p:i32=(shi>>(x-32))&1;
  return p;
}
fn bmg(beam:[]u8, i:i32, off:i32)i32 { return get32(beam, i*16+off); }
fn bms(beam:[]u8, i:i32, off:i32, v:i32)void { set32(beam, i*16+off, v); return; }
fn score_node(st:[]u8, nodes:[]u8, n:i32, ev_x:[]u8, ev_y:[]u8, out:[]u8)void {
  let en:i32=stg(st, 12);
  let opc:i32=ndg(nodes, n, 24);
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let p:i32=node_pred(nodes, n, x);
    if(p==y){ c=c+1; }
    e=e+1;
  }
  let sc:i32=0;
  if(en>0){
    let a1:i32=(c*10000)/en;
    let a2:i32=200*opc;
    sc=a1 - a2;
  }
  set32(out, 0, sc);
  set32(out, 4, c);
  set32(out, 8, opc);
  return;
}
// ============ unified beam U1-U7 ============
// Species signature: (tree depth, operator multiset [AND,OR,NOT,XOR]).
// Generic machinery only. No target, family, or library knowledge.
// Depth: single increasing node-id pass (children always have smaller ids).
fn u_depth_fill(nodes:[]u8, dmem:[]u8, nmax:i32)void {
  let n:i32=0;
  while(n<=nmax){
    if(ndg(nodes, n, 0)==0){
      set32(dmem, n*4, 0);
    } else {
      let c0:i32=ndg(nodes, n, 8);
      let c1:i32=ndg(nodes, n, 12);
      let mx:i32=get32(dmem, c0*4);
      if(c1>=0){
        let d1:i32=get32(dmem, c1*4);
        if(d1>mx){ mx=d1; }
      }
      set32(dmem, n*4, mx+1);
    }
    n=n+1;
  }
  return;
}
// Operator histogram of the DAG rooted at n. Each distinct reachable
// node is counted once (visit-token dedup). out: 4 i32s, zeroed by caller.
fn u_hist(nodes:[]u8, n:i32, vis:[]u8, tok:i32, stack:[]u8, out:[]u8)void {
  let sp:i32=1;
  set32(stack, 0, n);
  set32(vis, n*4, tok);
  while(sp>0){
    sp=sp-1;
    let m:i32=get32(stack, sp*4);
    if(ndg(nodes, m, 0)==1){
      let op:i32=ndg(nodes, m, 4);
      set32(out, op*4, get32(out, op*4)+1);
      let c0:i32=ndg(nodes, m, 8);
      let c1:i32=ndg(nodes, m, 12);
      if(get32(vis, c0*4)!=tok){
        set32(vis, c0*4, tok);
        set32(stack, sp*4, c0);
        sp=sp+1;
      }
      if(c1>=0){
        if(get32(vis, c1*4)!=tok){
          set32(vis, c1*4, tok);
          set32(stack, sp*4, c1);
          sp=sp+1;
        }
      }
    }
  }
  return;
}
fn u_popcnt(v:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<32){
    if(((v>>i)&1)==1){ c=c+1; }
    i=i+1;
  }
  return c;
}
// Phase ordering comparator. phase 0 = exploration (accuracy only),
// phase 1 = consolidation/final (accuracy, then opc). Returns 1 if a
// ranks strictly above b.
fn u_better(ca:[]u8, co:[]u8, cn:[]u8, cda:[]u8, cdb:[]u8, a:i32, b:i32, phase:i32)i32 {
  let aa:i32=get32(ca, a*4);
  let ab:i32=get32(ca, b*4);
  if(aa>ab){ return 1; }
  if(aa<ab){ return 0; }
  if(phase==1){
    let oa:i32=get32(co, a*4);
    let ob:i32=get32(co, b*4);
    if(oa<ob){ return 1; }
    if(oa>ob){ return 0; }
  }
  let da:i32=get32(cda, a*4);
  let db:i32=get32(cda, b*4);
  if(da>db){ return 1; }
  if(da<db){ return 0; }
  let na:i32=get32(cdb, a*4);
  let nb:i32=get32(cdb, b*4);
  if(na>nb){ return 1; }
  if(na<nb){ return 0; }
  let xa:i32=get32(cn, a*4);
  let xb:i32=get32(cn, b*4);
  if(xa>xb){ return 1; }
  return 0;
}
// Unified beam extension. Replaces beam_extend. Candidate generation
// and scoring are verbatim of the frozen beam_extend; only retention
// changes (U1/U2/U3/U5/U6). bspec: per-slot species ids (32 i32s).
// round: 0-indexed evidence-loop round (U3 phase). ulog: [maxsims, nodomv].
fn beam_extend_u(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, bspec:[]u8, round:i32, ulog:[]u8)void {
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  let si:i32=0;
  while(si<8192){ seen[si]=0; si=si+1; }
  let tn:i32=0;
  let i:i32=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    if(seen[n]==0){
      seen[n]=1;
      set32(tmp, tn*4, n);
      tn=tn+1;
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let n2:i32=node_new_op(st, nodes, sigtab, trace, 2, n, -1);
    if(n2>=0){
      if(seen[n2]==0){
        seen[n2]=1;
        set32(tmp, tn*4, n2);
        tn=tn+1;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let j:i32=0;
    while(j<bn){
      let m:i32=bmg(beam, j, 0);
      let op:i32=0;
      while(op<4){
        if(op!=2){
          let n2:i32=node_new_op(st, nodes, sigtab, trace, op, n, m);
          if(n2>=0){
            if(seen[n2]==0){
              seen[n2]=1;
              set32(tmp, tn*4, n2);
              tn=tn+1;
            }
          }
        }
        op=op+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  if(tn>get32(ulog, 0)){ set32(ulog, 0, tn); }
  let sout:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<tn){
    let n:i32=get32(tmp, k*4);
    score_node(st, nodes, n, ev_x, ev_y, sout);
    set32(tsc, k*12+0, get32(sout, 0));
    set32(tsc, k*12+4, get32(sout, 4));
    set32(tsc, k*12+8, get32(sout, 8));
    k=k+1;
  }
  if(tn<1){
    sts(st, 8, 0);
    return;
  }
  let nc:i32=stg(st, 0);
  let dmem:[]u8=z_alloc(8192*4);
  u_depth_fill(nodes, dmem, nc-1);
  let vis:[]u8=z_alloc(8192*4);
  let stack:[]u8=z_alloc(8192*4);
  let tok:i32=1;
  let ca:[]u8=z_alloc(tn*4);
  let co:[]u8=z_alloc(tn*4);
  let cn:[]u8=z_alloc(tn*4);
  let cda:[]u8=z_alloc(tn*4);
  let cdb:[]u8=z_alloc(tn*4);
  let cdep:[]u8=z_alloc(tn*4);
  let chist:[]u8=z_alloc(tn*16);
  let cpat:[]u8=z_alloc(tn*4);
  let cspec:[]u8=z_alloc(tn*4);
  let ph:[]u8=z_alloc(16);
  i=0;
  while(i<bn){
    let htmp:[]u8=z_alloc(16);
    u_hist(nodes, bmg(beam, i, 0), vis, tok, stack, htmp);
    tok=tok+1;
    let q:i32=0;
    while(q<4){
      set32(ph, q*4, get32(ph, q*4)+get32(htmp, q*4));
      q=q+1;
    }
    i=i+1;
  }
  k=0;
  while(k<tn){
    let nk:i32=get32(tmp, k*4);
    set32(cn, k*4, nk);
    set32(ca, k*4, get32(tsc, k*12+4));
    set32(co, k*4, get32(tsc, k*12+8));
    set32(cdep, k*4, get32(dmem, nk*4));
    let htmp2:[]u8=z_alloc(16);
    u_hist(nodes, nk, vis, tok, stack, htmp2);
    tok=tok+1;
    let q2:i32=0;
    while(q2<4){
      set32(chist, k*16+q2*4, get32(htmp2, q2*4));
      q2=q2+1;
    }
    let pat:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=node_pred(nodes, nk, x);
      if(p==y){ pat=pat | (1<<e); }
      e=e+1;
    }
    set32(cpat, k*4, pat);
    let nv:i32=0;
    let q3:i32=0;
    while(q3<4){
      nv=nv+abs_i(get32(htmp2, q3*4)-get32(ph, q3*4));
      q3=q3+1;
    }
    set32(cdb, k*4, nv);
    set32(cspec, k*4, -1);
    k=k+1;
  }
  let skey:[]u8=z_alloc(tn*20);
  let nspec:i32=0;
  k=0;
  while(k<tn){
    let dk:i32=get32(cdep, k*4);
    let h0:i32=get32(chist, k*16+0);
    let h1:i32=get32(chist, k*16+4);
    let h2:i32=get32(chist, k*16+8);
    let h3:i32=get32(chist, k*16+12);
    let s:i32=0;
    let f:i32=-1;
    while(s<nspec){
      if(get32(skey, s*20+0)==dk){
        if(get32(skey, s*20+4)==h0){
          if(get32(skey, s*20+8)==h1){
            if(get32(skey, s*20+12)==h2){
              if(get32(skey, s*20+16)==h3){
                f=s;
                break;
              }
            }
          }
        }
      }
      s=s+1;
    }
    if(f<0){
      f=nspec;
      set32(skey, f*20+0, dk);
      set32(skey, f*20+4, h0);
      set32(skey, f*20+8, h1);
      set32(skey, f*20+12, h2);
      set32(skey, f*20+16, h3);
      nspec=nspec+1;
    }
    set32(cspec, k*4, f);
    k=k+1;
  }
  while(nspec>8){
    let scnt:[]u8=z_alloc(nspec*4);
    let sacc:[]u8=z_alloc(nspec*4);
    let s:i32=0;
    while(s<nspec){
      set32(sacc, s*4, -1);
      s=s+1;
    }
    k=0;
    while(k<tn){
      let spx:i32=get32(cspec, k*4);
      set32(scnt, spx*4, get32(scnt, spx*4)+1);
      let akx:i32=get32(ca, k*4);
      if(akx>get32(sacc, spx*4)){ set32(sacc, spx*4, akx); }
      k=k+1;
    }
    let s1:i32=-1;
    let s2:i32=-1;
    s=0;
    while(s<nspec){
      let cs:i32=get32(scnt, s*4);
      let as:i32=get32(sacc, s*4);
      let sm1:i32=0;
      if(s1<0){ sm1=1; }
      else {
        let c1x:i32=get32(scnt, s1*4);
        let a1x:i32=get32(sacc, s1*4);
        if(cs<c1x){ sm1=1; }
        else {
          if(cs==c1x){
            if(as<a1x){ sm1=1; }
          }
        }
      }
      if(sm1==1){
        s2=s1;
        s1=s;
      } else {
        let sm2:i32=0;
        if(s2<0){ sm2=1; }
        else {
          let c2x:i32=get32(scnt, s2*4);
          let a2x:i32=get32(sacc, s2*4);
          if(cs<c2x){ sm2=1; }
          else {
            if(cs==c2x){
              if(as<a2x){ sm2=1; }
            }
          }
        }
        if(sm2==1){ s2=s; }
      }
      s=s+1;
    }
    k=0;
    while(k<tn){
      if(get32(cspec, k*4)==s2){ set32(cspec, k*4, s1); }
      k=k+1;
    }
    let last:i32=nspec-1;
    if(last!=s2){
      k=0;
      while(k<tn){
        if(get32(cspec, k*4)==last){ set32(cspec, k*4, s2); }
        k=k+1;
      }
      let q4:i32=0;
      while(q4<5){
        set32(skey, s2*20+q4*4, get32(skey, last*20+q4*4));
        q4=q4+1;
      }
    }
    nspec=nspec-1;
  }
  let gcount:[]u8=z_alloc(nspec*33*4);
  let gbits:[]u8=z_alloc(nspec*33*32*4);
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let akx:i32=get32(ca, k*4);
    let g:i32=spx*33+akx;
    set32(gcount, g*4, get32(gcount, g*4)+1);
    let patk:i32=get32(cpat, k*4);
    let e:i32=0;
    while(e<en){
      if(((patk>>e)&1)==1){
        let gb:i32=g*32+e;
        set32(gbits, gb*4, get32(gbits, gb*4)+1);
      }
      e=e+1;
    }
    k=k+1;
  }
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let akx:i32=get32(ca, k*4);
    let g:i32=spx*33+akx;
    let gc:i32=get32(gcount, g*4);
    let da:i32=0;
    if(gc>1){
      let patk:i32=get32(cpat, k*4);
      let maj:i32=0;
      let e:i32=0;
      while(e<en){
        let ones:i32=get32(gbits, (g*32+e)*4);
        if(ones*2>=gc){ maj=maj | (1<<e); }
        e=e+1;
      }
      da=u_popcnt(patk ^ maj);
    }
    set32(cda, k*4, da);
    k=k+1;
  }
  let phase:i32=0;
  if(round>15){ phase=1; }
  let sbest:[]u8=z_alloc(nspec*4);
  let s:i32=0;
  while(s<nspec){
    set32(sbest, s*4, -1);
    s=s+1;
  }
  k=0;
  while(k<tn){
    let spx:i32=get32(cspec, k*4);
    let cur:i32=get32(sbest, spx*4);
    if(cur<0){ set32(sbest, spx*4, k); }
    else {
      if(u_better(ca, co, cn, cda, cdb, k, cur, phase)==1){
        set32(sbest, spx*4, k);
      }
    }
    k=k+1;
  }
  let sord:[]u8=z_alloc(nspec*4);
  let sdone:[]u8=z_alloc(nspec);
  let oi:i32=0;
  while(oi<nspec){
    let bs:i32=-1;
    s=0;
    while(s<nspec){
      if(sdone[s]==0){
        if(bs<0){ bs=s; }
        else {
          let ms:i32=get32(sbest, s*4);
          let mb:i32=get32(sbest, bs*4);
          if(u_better(ca, co, cn, cda, cdb, ms, mb, phase)==1){ bs=s; }
        }
      }
      s=s+1;
    }
    sdone[bs]=1;
    set32(sord, oi*4, bs);
    oi=oi+1;
  }
  let picked:[]u8=z_alloc(tn);
  let kept:i32=0;
  oi=0;
  while(oi<nspec){
    if(kept>=28){ break; }
    let sp:i32=get32(sord, oi*4);
    let tk:i32=0;
    while(tk<4){
      if(kept>=28){ break; }
      let bk:i32=-1;
      k=0;
      while(k<tn){
        if(picked[k]==0){
          if(get32(cspec, k*4)==sp){
            if(bk<0){ bk=k; }
            else {
              if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
            }
          }
        }
        k=k+1;
      }
      if(bk<0){ break; }
      picked[bk]=1;
      kept=kept+1;
      tk=tk+1;
    }
    oi=oi+1;
  }
  while(kept<28){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    kept=kept+1;
  }
  let nodomv:i32=0;
  k=0;
  while(k<tn){
    if(picked[k]==0){
      let spk:i32=get32(cspec, k*4);
      let ak:i32=get32(ca, k*4);
      let ok:i32=get32(co, k*4);
      let j:i32=0;
      while(j<tn){
        if(picked[j]==1){
          if(get32(cspec, j*4)==spk){
            let aj:i32=get32(ca, j*4);
            let oj:i32=get32(co, j*4);
            if(ak>aj){ nodomv=nodomv+1; }
            else {
              if(ak==aj){
                if(ok<oj){ nodomv=nodomv+1; }
              }
            }
          }
        }
        j=j+1;
      }
    }
    k=k+1;
  }
  set32(ulog, 4, get32(ulog, 4)+nodomv);
  let shsum:[]u8=z_alloc(16);
  k=0;
  while(k<tn){
    if(picked[k]==1){
      let q5:i32=0;
      while(q5<4){
        set32(shsum, q5*4, get32(shsum, q5*4)+get32(chist, k*16+q5*4));
        q5=q5+1;
      }
    }
    k=k+1;
  }
  let c6:[]u8=z_alloc(tn*4);
  k=0;
  while(k<tn){
    if(picked[k]==0){
      let ak2:i32=get32(ca, k*4);
      if(en>0){
        if((ak2*100)/en>=50){
          let nv2:i32=0;
          let q6:i32=0;
          while(q6<4){
            nv2=nv2+abs_i(get32(chist, k*16+q6*4)*kept-get32(shsum, q6*4));
            q6=q6+1;
          }
          set32(c6, k*4, nv2+1);
        }
      }
    }
    k=k+1;
  }
  let got6:i32=0;
  while(got6<4){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        let nv3:i32=get32(c6, k*4);
        if(nv3>0){
          if(bk<0){ bk=k; }
          else {
            let nvb:i32=get32(c6, bk*4);
            if(nv3>nvb){ bk=k; }
            else {
              if(nv3==nvb){
                let ak3:i32=get32(ca, k*4);
                let ab3:i32=get32(ca, bk*4);
                if(ak3>ab3){ bk=k; }
                else {
                  if(ak3==ab3){
                    if(get32(cn, k*4)>get32(cn, bk*4)){ bk=k; }
                  }
                }
              }
            }
          }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    got6=got6+1;
  }
  while(got6<4){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==0){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, phase)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=1;
    got6=got6+1;
  }
  let nb:i32=0;
  let wri:i32=0;
  while(wri<32){
    let bk:i32=-1;
    k=0;
    while(k<tn){
      if(picked[k]==1){
        if(bk<0){ bk=k; }
        else {
          if(u_better(ca, co, cn, cda, cdb, k, bk, 1)==1){ bk=k; }
        }
      }
      k=k+1;
    }
    if(bk<0){ break; }
    picked[bk]=2;
    let wn:i32=get32(cn, bk*4);
    bms(beam, nb, 0, wn);
    bms(beam, nb, 4, get32(tsc, bk*12+0));
    bms(beam, nb, 8, get32(ca, bk*4));
    bms(beam, nb, 12, get32(co, bk*4));
    set32(bspec, nb*4, get32(cspec, bk*4));
    nb=nb+1;
    wri=wri+1;
  }
  sts(st, 8, nb);
  return;
}
fn clear_sigtab(sigtab:[]u8)void {
  let i:i32=0;
  while(i<16384){ set32(sigtab, i*4, 0); i=i+1; }
  return;
}
fn clear_used(used:[]u8)void {
  let i:i32=0;
  while(i<64){ used[i]=0; i=i+1; }
  return;
}
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    used[x]=1;
    i=i+1;
  }
  sts(st, 12, 8);
  return;
}
fn abs_i(v:i32)i32 {
  if(v<0){ return -v; }
  return v;
}
// U4: diverse IV hypothesis set. First member of each distinct species
// (species ids from bspec), up to 8 hypotheses; disagreement machinery
// otherwise identical to the frozen select_iv.
fn select_iv_u(st:[]u8, nodes:[]u8, beam:[]u8, bspec:[]u8, used:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let hnode:[]u8=z_alloc(8*4);
  let hspec:[]u8=z_alloc(8*4);
  let h:i32=0;
  let i:i32=0;
  while(i<bn){
    if(h<8){
      let s:i32=get32(bspec, i*4);
      let dup:i32=0;
      let j:i32=0;
      while(j<h){
        if(get32(hspec, j*4)==s){ dup=1; }
        j=j+1;
      }
      if(dup==0){
        set32(hnode, h*4, bmg(beam, i, 0));
        set32(hspec, h*4, s);
        h=h+1;
      }
    }
    i=i+1;
  }
  if(h<1){ return -1; }
  let best_x:i32=-1;
  let best_d:i32=-1;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){
      let c1:i32=0;
      let k:i32=0;
      while(k<h){
        let n:i32=get32(hnode, k*4);
        let p:i32=node_pred(nodes, n, x);
        if(p==1){ c1=c1+1; }
        k=k+1;
      }
      let av:i32=abs_i(2*c1 - h);
      let d:i32=h - av;
      if(d>best_d){
        best_d=d;
        best_x=x;
      }
    }
    x=x+1;
  }
  return best_x;
}
fn select_iv_rand(st:[]u8, used:[]u8)i32 {
  let cnt:i32=0;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){ cnt=cnt+1; }
    x=x+1;
  }
  if(cnt==0){ return -1; }
  let r:i32=rng_range(st, cnt);
  x=0;
  while(x<64){
    if(used[x]==0){
      if(r==0){ return x; }
      r=r-1;
    }
    x=x+1;
  }
  return -1;
}
fn do_iv(st:[]u8, fam:i32, x:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let y:i32=sealed(fam, x);
  let en:i32=stg(st, 12);
  set32(ev_x, en*4, x);
  set32(ev_y, en*4, y);
  used[x]=1;
  sts(st, 12, en+1);
  return;
}
// replicate Phase-1 evidence loop exactly (8 passive + 24 disagreement IVs)
fn build_learner32(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, bspec:[]u8, ulog:[]u8)void {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  set32(ulog, 0, 0);
  set32(ulog, 4, 0);
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, 8);
  passive(st, 5, ev_x, ev_y, used);
  let r:i32=0;
  while(r<24){
    beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, r, ulog);
    let x:i32=select_iv_u(st, nodes, beam, bspec, used);
    if(x>=0){ do_iv(st, 5, x, ev_x, ev_y, used); }
    r=r+1;
  }
  return;
}
// score all 256 3-bit behaviors on one evidence set
fn enum_set(tag:[]u8, ev_x:[]u8, ev_y:[]u8, en:i32, db:i32)void {
  let sob:[]u8=z_alloc(8);
  let top:i32=-1;
  let ties:i32=0;
  let first:i32=-1;
  let b:i32=0;
  while(b<256){
    sig_of_3bit(b, sob);
    let lo:i32=get32(sob, 0);
    let hi:i32=get32(sob, 4);
    let c:i32=ev_correct(lo, hi, ev_x, ev_y, en);
    if(c>top){ top=c; ties=1; first=b; }
    else {
      if(c==top){ ties=ties+1; }
    }
    b=b+1;
  }
  sig_of_3bit(db, sob);
  let dlo:i32=get32(sob, 0);
  let dhi:i32=get32(sob, 4);
  let dbscore:i32=ev_correct(dlo, dhi, ev_x, ev_y, en);
  let uniq:i32=0;
  if(ties==1){
    if(dbscore==top){ uniq=1; }
  }
  sig_of_3bit(first, sob);
  let flo:i32=get32(sob, 0);
  let fhi:i32=get32(sob, 4);
  let ftrue:i32=true_correct_sig(5, flo, fhi);
  emit(tag);
  emit(" TOP="); e64(top); emit("/"); e64(en);
  emit(" TIES="); e64(ties);
  emit(" TRUEUNIQUE="); e64(uniq);
  emit(" FIRSTTRUE="); e64(ftrue); emit("/64\n");
  return;
}
// phase1 with random interventions instead of disagreement-driven
fn phase1_rand(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, bspec:[]u8, ulog:[]u8)void {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  set32(ulog, 0, 0);
  set32(ulog, 4, 0);
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, 8);
  passive(st, fam, ev_x, ev_y, used);
  let r:i32=0;
  while(r<24){
    beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, r, ulog);
    let x:i32=select_iv_rand(st, used);
    if(x>=0){ do_iv(st, fam, x, ev_x, ev_y, used); }
    r=r+1;
  }
  beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, 24, ulog);
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let en:i32=stg(st, 12);
  let blo:i32=ndg(nodes, best_n, 16);
  let bhi:i32=ndg(nodes, best_n, 20);
  emit("RANDIV BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" opc="); e64(best_o); emit("\n");
  emit("RANDIV TRUE correct="); e64(true_correct_sig(fam, blo, bhi)); emit("/64\n");
  return;
}
// D lookup table from the same 32 Phase-1 observations, composed as C' = D_table XOR x4
fn run_fullmem(ev_lx:[]u8, ev_ly:[]u8, st2:[]u8, ev2_x:[]u8, ev2_y:[]u8, used2:[]u8)void {
  let cnt:[]u8=z_alloc(32);
  let tot:[]u8=z_alloc(32);
  let e:i32=0;
  while(e<32){
    let x:i32=get32(ev_lx, e*4);
    let y:i32=get32(ev_ly, e*4);
    let c:i32=x&7;
    set32(tot, c*4, get32(tot, c*4)+1);
    if(y==1){ set32(cnt, c*4, get32(cnt, c*4)+1); }
    e=e+1;
  }
  let cover:i32=0;
  let c:i32=0;
  while(c<8){
    if(get32(tot, c*4)>0){ cover=cover+1; }
    c=c+1;
  }
  sts(st2, 16, 555555555);
  sts(st2, 12, 0);
  clear_used(used2);
  passive(st2, 6, ev2_x, ev2_y, used2);
  let correct:i32=0;
  let x:i32=0;
  while(x<64){
    let cc:i32=x&7;
    let d:i32=0;
    if(get32(tot, cc*4)>0){
      let cn:i32=get32(cnt, cc*4);
      let tt:i32=get32(tot, cc*4);
      if(cn*2>=tt){ d=1; }
    }
    let x4:i32=(x>>3)&1;
    let pred:i32=d ^ x4;
    if(pred==sealed(6, x)){ correct=correct+1; }
    x=x+1;
  }
  emit("FULLMEM COVERAGE="); e64(cover); emit("/8");
  emit(" CORRECT="); e64(correct); emit("/64\n");
  return;
}

// ---- R1 driver: P-RAND multi-seed robustness on F-PARCOND ----
// Policy: P-RAND (select_iv_rand) only. Seeds frozen in prereg bea779792.
// Machinery above is verbatim from r4.zag (R4 implementation 8b0ede871),
// which copied it verbatim from altexp.zag (73d9637a2).
fn r1seed(i:i32)i32 {
  if(i==1){ return 81113; }
  if(i==2){ return 82090; }
  if(i==3){ return 83067; }
  if(i==4){ return 84044; }
  return 85021;
}
fn coverage8(ev_x:[]u8, en:i32)i32 {
  let seen:i32=0;
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let bit:i32=1<<(x&7);
    if((seen&bit)==0){
      seen=seen | bit;
      c=c+1;
    }
    e=e+1;
  }
  return c;
}
fn true_acc(nodes:[]u8, n:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    if(node_pred(nodes, n, x)==sealed(5, x)){ c=c+1; }
    x=x+1;
  }
  return c;
}
// U7: honest tie reporting. Replaces taxoff_unique.
fn tie_report(beam:[]u8, bn:i32)void {
  let mx:i32=-1;
  let i:i32=0;
  while(i<bn){
    let cr:i32=bmg(beam, i, 8);
    if(cr>mx){ mx=cr; }
    i=i+1;
  }
  let n:i32=0;
  let omin:i32=999999;
  let omax:i32=-1;
  let first_node:i32=-1;
  let allsame:i32=1;
  i=0;
  while(i<bn){
    if(bmg(beam, i, 8)==mx){
      n=n+1;
      let o:i32=bmg(beam, i, 12);
      if(o<omin){ omin=o; }
      if(o>omax){ omax=o; }
      let nd:i32=bmg(beam, i, 0);
      if(first_node<0){ first_node=nd; }
      else {
        if(nd!=first_node){ allsame=0; }
      }
    }
    i=i+1;
  }
  let n2:i32=0;
  i=0;
  while(i<bn){
    if(bmg(beam, i, 8)==mx){ n2=n2+1; }
    i=i+1;
  }
  if(n==1){
    emit(" TIE=UNIQUE");
  } else {
    if(allsame==1){
      emit(" TIE=DEFECT");
    } else {
      emit(" TIE=UNDERDETERMINED N=");
      e64(n);
      emit(" OPCRANGE=");
      e64(omin);
      emit("-");
      e64(omax);
    }
  }
  if(n!=n2){
    emit(" TIECHECK=FAIL");
  } else {
    emit(" TIECHECK=OK");
  }
  return;
}
// P-RAND evidence loop: verbatim of R4 run_rand, plus final beam_extend
// and metric extraction. Emits per-seed results. Returns 1 if the seed
// meets both R1 bars (8/8 coverage AND 64/64 true accuracy), else 0.
fn run_r1(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, seed:i32, bspec:[]u8, ulog:[]u8)i32 {
  sts(st, 16, seed);
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  set32(ulog, 0, 0);
  set32(ulog, 4, 0);
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, 8);
  passive(st, 5, ev_x, ev_y, used);
  let r:i32=0;
  while(r<24){
    beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, r, ulog);
    let x:i32=select_iv_rand(st, used);
    if(x>=0){ do_iv(st, 5, x, ev_x, ev_y, used); }
    r=r+1;
  }
  beam_extend_u(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, bspec, 24, ulog);
  let en:i32=stg(st, 12);
  let bn:i32=stg(st, 8);
  let cov:i32=coverage8(ev_x, en);
  let kept:i32=bmg(beam, 0, 0);
  let evfit:i32=bmg(beam, 0, 8);
  let opc:i32=bmg(beam, 0, 12);
  let tacc:i32=true_acc(nodes, kept);
  emit("R1 SEED=");
  e64(seed);
  emit(" COV=");
  e64(cov);
  emit("/8 EVFIT=");
  e64(evfit);
  emit("/32 TACC=");
  e64(tacc);
  emit("/64 OPC=");
  e64(opc);
  tie_report(beam, bn);
  emit("\n");
  emit("R1U SEED=");
  e64(seed);
  emit(" MAXSIMS=");
  e64(get32(ulog, 0));
  emit(" NODOMV=");
  e64(get32(ulog, 4));
  emit("\n");
  if(cov==8){
    if(tacc==64){ return 1; }
  }
  return 0;
}
fn main()void {
  emit("Q4-R1\n");
  let st:[]u8=z_alloc(32);
  let nodes:[]u8=z_alloc(8192*28);
  let sigtab:[]u8=z_alloc(16384*4);
  let beam:[]u8=z_alloc(32*16);
  let trace:[]u8=z_alloc(4096*20);
  let seen:[]u8=z_alloc(8192);
  let tmp:[]u8=z_alloc(3136*4);
  let tsc:[]u8=z_alloc(3136*12);
  let ev_x:[]u8=z_alloc(32*4);
  let ev_y:[]u8=z_alloc(32*4);
  let used:[]u8=z_alloc(64);
  let bspec:[]u8=z_alloc(32*4);
  let ulog:[]u8=z_alloc(8);
  let pass:i32=0;
  let i:i32=1;
  while(i<=5){
    let s:i32=r1seed(i);
    let ok:i32=run_r1(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, s, bspec, ulog);
    pass=pass+ok;
    i=i+1;
  }
  emit("R1 PASS_SEEDS=");
  e64(pass);
  emit("/5\n");
  if(pass>=4){
    emit("R1 VERDICT=R1-PASS\n");
  } else {
    emit("R1 VERDICT=R1-FAIL F-R1 FIRED\n");
  }
  emit("R1 DONE\n");
  return;
}

// ============ cost accounting driver ============
// Measures marginal cost of each TNN-2 operation along 4 dimensions:
//   nodes = delta live nodes (hg 20)
//   edges = delta live edges (hg 24)
//   exec  = delta ISA opcodes executed (hg 56, instrumented in execute)
//   scan  = delta workspace scan-loop iterations (hg 60, instrumented)
// Each measurement snapshots before/after and asserts the expected result
// so any behavior change from instrumentation is caught.
fn csnap(W:[]u8,s:[]u8)void {
  set32(s,0,hg(W,20)); set32(s,4,hg(W,24));
  set32(s,8,hg(W,56)); set32(s,12,hg(W,60));
  return;
}
fn crep(W:[]u8,s:[]u8,name:[]u8)void {
  emit(name); emit(" nodes=");
  e64(hg(W,20)-get32(s,0)); emit(" edges=");
  e64(hg(W,24)-get32(s,4)); emit(" exec=");
  e64(hg(W,56)-get32(s,8)); emit(" scan=");
  e64(hg(W,60)-get32(s,12)); emit("\n");
  return;
}
fn cassert(name:[]u8,got:i32,want:i32)void {
  if(got!=want){emit(name); emit(" ASSERT-FAIL got="); e64(got); emit(" want="); e64(want); emit("\n");}
  return;
}
fn m_teach()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let n:i32=ev_teach(W,1001,1,42);
  crep(W,s,"M-teach        ");
  if(n<2){emit("M-teach ASSERT-FAIL n<2\n");}
  return;
}
fn m_query_hit()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1001,1,42);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let a:i32=ev_query(W,1001,1,-2,0);
  crep(W,s,"M-query-hit    ");
  cassert("M-query-hit",a,42);
  return;
}
fn m_query_miss_trial()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3); ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let a:i32=ev_query(W,1,40,5,0);
  crep(W,s,"M-query-trial  ");
  cassert("M-query-trial",a,5);
  return;
}
fn m_query_miss_full()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,5001,7,11); ev_teach(W,5002,7,12);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let a:i32=ev_query(W,9999,40,-2,1);
  crep(W,s,"M-query-miss   ");
  cassert("M-query-miss",a,-2);
  return;
}
fn m_observe_confirm()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1001,1,42);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let r:i32=ev_observe(W,1001,1,42);
  crep(W,s,"M-observe-conf ");
  cassert("M-observe-conf",r,1);
  return;
}
fn m_observe_contra()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1001,1,42);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let r:i32=ev_observe(W,1001,1,99);
  crep(W,s,"M-observe-contra");
  cassert("M-observe-contra",r,0);
  return;
}
fn m_act()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  if(ev_query(W,9002,77,-2,0)!=-2){emit("M-act setup FAIL\n");}
  ctx_push(W,9002);
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let c:i32=ev_act(W);
  crep(W,s,"M-act          ");
  cassert("M-act",c,30);
  return;
}
fn m_activate_loaded()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<100){ev_teach(W,2000+i,2,i); i=i+1;}
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let n:i32=activate(W,2050,2);
  crep(W,s,"M-activate-100 ");
  if(n<2){emit("M-activate-100 ASSERT-FAIL n<2\n");}
  return;
}
fn m_query_hit_loaded()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<100){ev_teach(W,2000+i,2,i); i=i+1;}
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let a:i32=ev_query(W,2050,2,-2,0);
  crep(W,s,"M-qhit-100     ");
  cassert("M-qhit-100",a,50);
  return;
}
fn m_evict()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<100){ev_teach(W,2000+i,2,i); i=i+1;}
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let v:i32=evict_node(W);
  crep(W,s,"M-evict        ");
  if(v<2){emit("M-evict ASSERT-FAIL v<2\n");}
  return;
}
fn m_revise_chain()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,301,11,302); ev_teach(W,302,11,201);
  let a:i32=ev_query(W,301,40,201,0);
  if(a!=201){emit("M-revise setup FAIL\n"); return;}
  let s:[]u8=z_alloc(16);
  csnap(W,s);
  let r:i32=ev_observe(W,302,11,999);
  crep(W,s,"M-revise       ");
  cassert("M-revise",r,0);
  let q:i32=ev_query(W,301,40,-2,0);
  emit("M-revise post-query="); e64(q); emit("\n");
  return;
}
fn main()i32 {
  emit("COST-ACCOUNTING run\n");
  m_teach();
  m_query_hit();
  m_query_miss_trial();
  m_query_miss_full();
  m_observe_confirm();
  m_observe_contra();
  m_act();
  m_activate_loaded();
  m_query_hit_loaded();
  m_evict();
  m_revise_chain();
  emit("COST-ACCOUNTING done\n");
  return 0;
}

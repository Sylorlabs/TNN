// l2l2.zag -- minimal learning-to-learn: two families, shared latent fixed-offset rule.
// Pure Zag. Prereg 4b4c8c345 frozen before this file.
// Learner state: mem table (seen pairs), offset_hyp (retained), trusted flag, form_known flag.
// Family A: x in 1..20, y = x + 3. Family B: x in 21..40, y = x + 7.
// Criterion: examples to 8 consecutive correct predictions.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// learner state lives in these buffers (module scope via passed struct = flat arrays)
fn predict(mx:[]u8, mcnt:i32, x:i32, offset_hyp:i32, trusted:i32)i32 {
  if(trusted==1){ return x+offset_hyp; }
  if(mcnt==0){ return x; }
  let bi:i32=0;
  let bd:i32=get32(mx,0)-x;
  if(bd<0){bd=0-bd;}
  let i:i32=1;
  while(i<mcnt){
    let d:i32=get32(mx,i)-x;
    if(d<0){d=0-d;}
    if(d<bd){bd=d;bi=i;}
    i=i+1;
  }
  return get32(mx,20+bi);
}

// run one family. xs0 = first input, n = count, k = true offset.
// form_known_in: retained meta-state (1 = offset form trusted as viable).
// returns examples-to-criterion; updates offset_hyp/trusted/form_known in st.
fn run_family(mx:[]u8, st:[]u8, xs0:i32, n:i32, k:i32, form_known_in:i32)i32 {
  let mcnt:i32=0;
  let offset_hyp:i32=get32(st,0);
  let trusted:i32=get32(st,4);
  let form_known:i32=form_known_in;
  let last_d:i32=0;
  let run:i32=0;
  let consec:i32=0;
  let used:i32=0;
  let ex:i32=0;
  while(ex<n){
    let x:i32=xs0+ex;
    let y:i32=x+k;
    let pred:i32=predict(mx,mcnt,x,offset_hyp,trusted);
    used=used+1;
    if(pred==y){ consec=consec+1; } else { consec=0; }
    if(consec>=8){ ex=n; }
    else {
      // learn from this example
      set32(mx,mcnt,x); set32(mx,20+mcnt,y); mcnt=mcnt+1;
      let d:i32=y-x;
      if(trusted==1 && d!=offset_hyp){
        trusted=0; run=1; last_d=d;
      } else if(trusted==0){
        if(d==last_d){ run=run+1; } else { run=1; last_d=d; }
        // fitting activates only if form is known (learned in A) or after 4 mem-only examples
        let fit_ok:i32=form_known;
        if(fit_ok==0 && used>=5){ fit_ok=1; }
        if(fit_ok==1 && run>=2){
          offset_hyp=last_d; trusted=1; form_known=1;
        }
      } else {
        if(d==last_d){ run=run+1; } else { run=1; last_d=d; }
      }
      ex=ex+1;
    }
  }
  set32(st,0,offset_hyp); set32(st,4,trusted); set32(st,8,form_known);
  return used;
}

fn main()i32 {
  // mode 0: A then B with retention (transfer)
  let mx:[]u8=z_alloc(160);
  let st:[]u8=z_alloc(12);
  set32(st,0,-1); set32(st,4,0); set32(st,8,0);
  let exA:i32=run_family(mx,st,1,20,3,0);
  let fk_after_A:i32=get32(st,8);
  let offA:i32=get32(st,0);
  let exB:i32=run_family(mx,st,21,20,7,fk_after_A);
  let offB:i32=get32(st,0);
  // mode 1: B fresh, no retained state (no-transfer control + ablation)
  let mx2:[]u8=z_alloc(160);
  let st2:[]u8=z_alloc(12);
  set32(st2,0,-1); set32(st2,4,0); set32(st2,8,0);
  let exBf:i32=run_family(mx2,st2,21,20,7,0);
  emit("L2L2-START\n");
  emit("A ex="); e64(exA); emit("\n");
  emit("B ex="); e64(exB); emit("\n");
  emit("B_FRESH ex="); e64(exBf); emit("\n");
  emit("TRACE offset_A="); e64(offA); emit(" offset_B="); e64(offB);
  emit(" form_known_after_A="); e64(fk_after_A); emit("\n");
  let p1:i32=0; if(exB<exA && (exA-exB)>=2){p1=1;}
  let p2:i32=0; if(exBf>=exA){p2=1;}
  let p3:i32=0; if(exBf>exB){p3=1;}
  emit("P1="); e64(p1); emit(" P2="); e64(p2); emit(" P3="); e64(p3); emit("\n");
  emit("L2L2-END\n");
  return 0;
}

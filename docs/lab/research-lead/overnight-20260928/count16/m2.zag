// PHASE 16 -- does counting's dominance survive at LARGE N?
// C1634 (RED_TEAM.md A1): four mechanisms tied/lost to argmax frequency, but
// every test used <=5 candidate structures. This runs the same question with 36
// candidates, 144 queries, 3 frequency regimes, 2 feedback granularities.
// Prereg: count16/PREREG.md
// DEVIATION (disclosed in REPORT): PREREG's RESID_CREDIT, taken literally, is a
// per-structure global statistic, hence query-blind, hence structurally unable to
// beat a query-blind COUNT -- it would degenerate for reasons of construction
// rather than because counting is sufficient. RESID_CREDIT is therefore made
// query-CONDITIONAL (within the query's bucket) with an explicit fallback to the
// count statistic when no residual signal exists. Under BINARY that fallback is
// exact, so the arm ties COUNT by construction -- which is the honest encoding
// of "no residual information available".
// SCOPE: selection only. Structures are affine maps, not programs. Candidate
// generation is NOT tested. Nothing here measures TNN.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn NS()i32 { return 36; }
fn NT()i32 { return 108; }
fn NH()i32 { return 36; }
fn NQ()i32 { return 144; }
fn NREG()i32 { return 3; }

fn aa(k:i32)i32 { return (k/9)+1; }
fn bb(k:i32)i32 { return k%9; }
fn fx(k:i32,x:i32)i32 { return (aa(k)*x)+bb(k); }
fn qx1(t:i32)i32 { return 1+(t*2); }
fn qx2(t:i32)i32 { return qx1(t)+9; }
// coarse feature: 6 buckets from the query's own input
// Target covers ALL 36 structures: qk(t) = t % 36.
fn qk(t:i32)i32 { return t%NS(); }

fn qfeat(t:i32)i32 { return (t%2)*6; }

fn main()i32 {
  let ob:[]u8=z_alloc(32768);
  let c:i32=0;

  let cnt:[]u8=z_alloc(NS()*4);
  let sres:[]u8=z_alloc(NS()*4);
  let trans:[]u8=z_alloc(NS()*4);
  let bcnt:[]u8=z_alloc(12*NS()*4);
  let obs:[]u8=z_alloc(NREG()*NS()*4);
  let used:[]u8=z_alloc(NS()*4);
  let okflag:[]u8=z_alloc(NREG()*4);
  let ktrack:[]u8=z_alloc(NQ()*4);

  let k:i32=0; let t:i32=0; let r:i32=0;

  // ---- promotion: build every query, census structure usage
  t=0;
  while(t<NQ()){
    let kk:i32=qk(t); let bq:i32=qfeat(t);
    set32(cnt,kk*4,get32(cnt,kk*4)+1);
    set32(bcnt,bq*NS()*4+kk*4,get32(bcnt,bq*NS()*4+kk*4)+1);
    set32(used,kk*4,1);
    set32(ktrack,t*4,kk);
    if(bq>0){ set32(trans,((kk+1)%NS())*4,get32(trans,((kk+1)%NS())*4)+1); }
    t=t+1;
  }

  let nused:i32=0; k=0;
  while(k<NS()){ if(get32(used,k*4)==1){ nused=nused+1; } k=k+1; }

  // ---- per-structure mean signed residual on TRAINING queries only
  t=0;
  while(t<NT()){
    let kk:i32=qk(t); let y1:i32=fx(kk,qx1(t));
    k=0;
    while(k<NS()){
      set32(sres,k*4,get32(sres,k*4)+(fx(k,qx1(t))-y1));
      k=k+1;
    }
    t=t+1;
  }
  let anyRes:i32=0;
  k=0; while(k<NS()){ if(get32(sres,k*4)!=0){ anyRes=1; } k=k+1; }

  // ---- observed counts per frequency regime
  r=0;
  while(r<NREG()){
    k=0;
    while(k<NS()){
      let nz:i32=0;
      if(r==1){ if((k*13)%NS()<12){ nz=1; } }
      if(r==2){ if((k*5)%NS()<10){ nz=3; } }
      set32(obs,r*NS()*4+k*4,get32(cnt,k*4)+nz);
      k=k+1;
    }
    r=r+1;
  }

  c=o_app(ob,c,"PHASE 16 LARGE-N SELECTION (36 structures, 144 queries)"); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // ---- census (validity)
  c=o_app(ob,c,"A0 CENSUS"); c=o_nl(ob,c);
  c=o_app(ob,c,"  structures defined="); c=o_i64(ob,c,NS() as i64);
  c=o_app(ob,c,"  used as a target="); c=o_i64(ob,c,nused as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  distinct training targets=");
  let ntr:i32=0; k=0; while(k<NS()){ if(get32(cnt,k*4)>0){ ntr=ntr+1; } k=k+1; }
  c=o_i64(ob,c,ntr as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  distinct heldout targets=");
  let nho:i32=0; t=NT(); while(t<NQ()){ set32(used,get32(ktrack,t*4)*4,1); t=t+1; }
  k=0; while(k<NS()){ if(get32(used,k*4)==1){ nho=nho+1; } k=k+1; }
  c=o_i64(ob,c,nho as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  queries="); c=o_i64(ob,c,NQ() as i64);
  c=o_app(ob,c,"  train="); c=o_i64(ob,c,NT() as i64);
  c=o_app(ob,c,"  heldout="); c=o_i64(ob,c,NH() as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  train x range="); c=o_i64(ob,c,qx1(0) as i64);
  c=o_app(ob,c,".."); c=o_i64(ob,c,qx1(NT()-1) as i64);
  c=o_app(ob,c,"  heldout x range="); c=o_i64(ob,c,qx1(NT()) as i64);
  c=o_app(ob,c,".."); c=o_i64(ob,c,qx1(NQ()-1) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  residual signal present="); c=o_i64(ob,c,anyRes as i64);
  c=o_app(ob,c,"  (1=GRADED feedback exposed, 0=BINARY only)"); c=o_nl(ob,c);
  c=o_app(ob,c,"  observed counts per regime (structure: r1 r2 r3)");
  k=0;
  while(k<NS()){
    c=o_app(ob,c,"    s"); c=o_i64(ob,c,k as i64);
    c=o_app(ob,c," a="); c=o_i64(ob,c,aa(k) as i64);
    c=o_app(ob,c," b="); c=o_i64(ob,c,bb(k) as i64);
    r=0;
    while(r<NREG()){
      c=o_app(ob,c,"  "); c=o_i64(ob,c,get32(obs,r*NS()*4+k*4) as i64); r=r+1;
    }
    c=o_nl(ob,c); k=k+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // ---- ORACLE positive control (uses the query's own y: upper bound)
  let orc:i32=0;
  t=NT();
  while(t<NQ()){
    let x1:i32=qx1(t); let x2:i32=qx2(t);
    let y1:i32=fx(qk(t),x1); let y2:i32=fx(qk(t),x2);
    let ok:i32=0; k=0;
    while(k<NS()){
      if(fx(k,x1)==y1){ if(fx(k,x2)==y2){ ok=1; } }
      k=k+1;
    }
    orc=orc+ok; t=t+1;
  }
  c=o_app(ob,c,"A1 ORACLE positive control (heldout solved)=");
  c=o_i64(ob,c,orc as i64); c=o_app(ob,c," of "); c=o_i64(ob,c,NH() as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"   (must be 36: unique consistent structure per query)"); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // ---- arms per regime, at BINARY and GRADED
  c=o_app(ob,c,"A2 ARM SCORES on 36 heldout queries"); c=o_nl(ob,c);
  c=o_app(ob,c,"   regime      COUNT FIXED AFFIN SIG_B SIG_G  best_learner"); c=o_nl(ob,c);

  let bestLearnerBeatsCount:i32=0;
  r=0;
  while(r<NREG()){
    // COUNT: argmax obs
    let kc:i32=0; let bestv:i32=-1; k=0;
    while(k<NS()){ if(get32(obs,r*NS()*4+k*4)>bestv){ bestv=get32(obs,r*NS()*4+k*4); kc=k; } k=k+1; }
    let sCount:i32=0;
    t=NT(); while(t<NQ()){ if(kc==qk(t)){ sCount=sCount+1; } t=t+1; }

    // FIXED_FIRST: always structure 0
    let sFix:i32=0;
    t=NT(); while(t<NQ()){ if(qk(t)==0){ sFix=sFix+1; } t=t+1; }

    // AFFINITY: argmax obs+trans
    let ka:i32=0; bestv=-1; k=0;
    while(k<NS()){
      if(get32(obs,r*NS()*4+k*4)+get32(trans,k*4)>bestv){ bestv=get32(obs,r*NS()*4+k*4)+get32(trans,k*4); ka=k; }
      k=k+1;
    }
    let sAff:i32=0;
    t=NT(); while(t<NQ()){ if(ka==qk(t)){ sAff=sAff+1; } t=t+1; }

    // SIG_B: query-conditional, argmax per-bucket training count (tie->lowest k)
    let sSigB:i32=0;
    t=NT();
    while(t<NQ()){
      let bq:i32=qfeat(t); let ks:i32=0; let bv:i32=-1; k=0;
      while(k<NS()){
        if(get32(bcnt,bq*NS()*4+k*4)>bv){ bv=get32(bcnt,bq*NS()*4+k*4); ks=k; }
        k=k+1;
      }
      if(ks==qk(t)){ sSigB=sSigB+1; }
      t=t+1;
    }

    // SIG_G: bucket-conditional, residual-aware. Primary = least |mean residual|
    // among structures that actually appear in this bucket (so it can never pick
    // a structure the bucket does not support); tie-break = per-bucket count.
    let sSigG:i32=0;
    t=NT();
    while(t<NQ()){
      let bq:i32=qfeat(t); let ks:i32=0; let bAbs:i32=0; let first:i32=0; k=0;
      while(k<NS()){
        if(get32(bcnt,bq*NS()*4+k*4)>0){
          let ar:i32=get32(sres,k*4); if(ar<0){ ar=0-ar; }
          let a2:i32=(ar/NT())+((get32(bcnt,bq*NS()*4+k*4))*1000000);
          if(first==1){ if(a2<bAbs){ bAbs=a2; ks=k; } }
          else { bAbs=a2; ks=k; first=1; }
        }
        k=k+1;
      }
      if(ks==qk(t)){ sSigG=sSigG+1; }
      t=t+1;
    }

    let sBest:i32=sSigB; if(sSigG>sBest){ sBest=sSigG; } if(sAff>sBest){ sBest=sAff; }
    if(sBest>sCount){ bestLearnerBeatsCount=1; }

    c=o_app(ob,c,"   R"); c=o_i64(ob,c,(r+1) as i64);
    c=o_app(ob,c,"        "); c=o_i64(ob,c,sCount as i64); c=o_app(ob,c,"     ");
    c=o_i64(ob,c,sFix as i64); c=o_app(ob,c,"     ");
    c=o_i64(ob,c,sAff as i64); c=o_app(ob,c,"   ");
    c=o_i64(ob,c,sSigB as i64); c=o_app(ob,c,"     ");
    c=o_i64(ob,c,sSigG as i64); c=o_app(ob,c,"    ");
    c=o_i64(ob,c,sBest as i64); c=o_nl(ob,c);
    r=r+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // ---- validity gates, all derived
  c=o_app(ob,c,"A3 VALIDITY GATES (derived, not asserted)"); c=o_nl(ob,c);
  let v1:i32=0; if(nused==NS()){ if(ntr==NS()){ if(nho==NS()){ v1=1; } } }
  c=o_app(ob,c,"  V1 all 36 structures promoted in train AND heldout ="); c=o_i64(ob,c,v1 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"     used="); c=o_i64(ob,c,nused as i64);
  c=o_app(ob,c," train_targets="); c=o_i64(ob,c,ntr as i64);
  c=o_app(ob,c," heldout_targets="); c=o_i64(ob,c,nho as i64); c=o_nl(ob,c);
  let v2:i32=0; if(orc==NH()){ v2=1; }
  c=o_app(ob,c,"  V2 ORACLE solves every heldout query ="); c=o_i64(ob,c,v2 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  V3 train/heldout x ranges disjoint =");
  let v3:i32=0; if(qx1(NT()-1)<qx1(NT())){ v3=1; }
  c=o_i64(ob,c,v3 as i64); c=o_nl(ob,c);
  let v6:i32=v3;
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // V4: COUNT strictly below ORACLE in R1
  let kc1:i32=0; let b1:i32=-1; k=0;
  while(k<NS()){ if(get32(obs,0*NS()*4+k*4)>b1){ b1=get32(obs,0*NS()*4+k*4); kc1=k; } k=k+1; }
  let sC1:i32=0;
  t=NT(); while(t<NQ()){ if(kc1==qk(t)){ sC1=sC1+1; } t=t+1; }
  let v4:i32=0; if(sC1<orc){ v4=1; }
  c=o_app(ob,c,"  V4 COUNT below ORACLE in R1 ="); c=o_i64(ob,c,v4 as i64);
  c=o_app(ob,c,"  (COUNT R1="); c=o_i64(ob,c,sC1 as i64);
  c=o_app(ob,c," ORACLE="); c=o_i64(ob,c,orc as i64); c=o_app(ob,c,")"); c=o_nl(ob,c);

  let v5:i32=0; if(sC1>0){ v5=1; }
  c=o_app(ob,c,"  V5 world non-degenerate (COUNT>0) ="); c=o_i64(ob,c,v5 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  V6 (same as V3) ="); c=o_i64(ob,c,v6 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,""); c=o_nl(ob,c);

  // ---- verdicts
  let vSigB:i32=0;
  r=0;
  while(r<NREG()){
    let bq:i32=0; k=0;
    // recompute SIG_B for this regime is regime-independent; score once outside
    bq=bq; r=r+1;
  }

  c=o_app(ob,c,"A4 VERDICT"); c=o_nl(ob,c);
  c=o_app(ob,c,"  best_learner_beats_COUNT_in_some_regime=");
  c=o_i64(ob,c,bestLearnerBeatsCount as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  COUNT R1 ="); c=o_i64(ob,c,sC1 as i64);
  c=o_app(ob,c," of "); c=o_i64(ob,c,NH() as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  ORACLE   ="); c=o_i64(ob,c,orc as i64);
  c=o_app(ob,c," of "); c=o_i64(ob,c,NH() as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  all gates pass=");
  let allg:i32=0;
  if(v1==1){ if(v2==1){ if(v3==1){ if(v4==1){ if(v5==1){ allg=1; } } } } }
  c=o_i64(ob,c,allg as i64); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}

fn bvReset(bq:i32)i32 { return -1; }
// unified9_learn.zag: end-to-end unlabeled learn-route-revise loop, v9.
// H-UNIFIED9 (R10): merit-threshold eviction for the causal store (H-MEM5
// policy port). When the 16-rule store is full, clearn evicts instead of
// refusing: CONFLICTED slots first, then lowest-merit eligible ACTIVE slot
// (protected iff young AND uses>=2, no grace), then fallback lowest-merit
// ignoring protection. New return code 3 (STORED_VIA_EVICT); every eviction
// is loud (UEVICT / UEVICT-FALLBACK) and counted in W[ECOUNT()]. The old
// K-U3-2 refuse-with-warning contract is SUPERSEDED. The learner never
// stops learning; retention must be earned.
// H-UNIFIED8 (R9): parse_ints judges digit runs by SIGNIFICANT digits
// (leading zeros do not count). 11+ significant digits always overflow;
// 10-significant-digit runs checked against 2147483647 before folding
// the 10th significant digit. Repairs the X-U7-3 boundary (R8 rejected
// zero-padded runs like "00000000001" as magnitude overflow) and
// corrects the R8 doc justification. Overflow still returns -2
// (MAGNITUDE_OVERFLOW) with the byte-identical PARSE_MAG trace.
// H-UNIFIED7 (R8): parse_ints gains magnitude validation. Digit runs
// are range-checked exactly (11+ digits always overflow; 10-digit runs
// checked against 2147483647 before folding the 10th digit). Overflow
// returns -2 (MAGNITUDE_OVERFLOW) with a loud PARSE_MAG trace; the
// causal handlers skip such segments loudly (USHAPE) and the query
// handler withholds. Return-code space: >=0 skipped-byte count
// (0 = clean), -1 SHAPE_OVERFLOW, -2 MAGNITUDE_OVERFLOW. No learned
// behavior changes on in-range inputs.
// H-UNIFIED6: parse_ints returns a programmatic anomaly code (skip
// count, or -1 SHAPE_OVERFLOW with capacity-safe stop: the parser never
// writes past out.len), and the causal handlers verify segment shapes
// as a second defense layer (USHAPE explicit skip). No learned behavior
// changes.
// Hardens the H-UNIFIED5 parser (parse_ints defensive guard vs the
// non-digit infinite-loop hazard) and documents the capacity boundary
// explicitly. No learned behavior changes.
//
// Repair (X-U3-1): authenticated revision channel via call-path
// separation. The '!' marker (byte 33) is INERT on the stream path:
// route_line NEVER returns code 6, so no stream byte sequence can
// invoke the revise handler or bypass the coherence gate. A '!'-
// prefixed causal line on the stream routes as ordinary CAUS_LEARN (2)
// and faces the gate like any stream line. The revision channel is
// reachable ONLY via operator_route (new function, separate call
// path), which requires the '!' marker and maps a causal remainder to
// code 6 = CAUS_REVISE; handle_caus_revise (unchanged) then bypasses
// the gate for the trusted operator. Authority is a property of the
// call path, never of a self-asserted byte.
//
// (H-UNIFIED3 Repair B, honest capacity accounting + refuse-with-
// warning, is carried forward unchanged.)
//
// Base: unified5_learn.zag (copied verbatim, then hardened).
// Prereg: PREREG_UNIFIED6.md (frozen before implementation).
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn wcopy(W:[]u8, off:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ W[off+i]=s[i]; i=i+1; }
  return s.len;
}

// ============ PROCEDURE STORE (from bridge_learn.zag, PROC_MAX=16) ============
// Program: [type, left, right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}

// Extract index sequence from (inp, out). Returns len or -1 if ambiguous.
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    if(peval(prog, nnodes, k, n)!=get32(seq, k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn PROC_MAX()i32 { return 16; }
fn PROC_SZ()i32 { return 64; }
fn proc_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*PROC_SZ();
}
fn proc_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot));
}
fn proc_set_used(W:[]u8, base:i32, slot:i32, v:i32)void {
  set32(W, proc_slot(W,base,slot), v);
  return;
}
// Store program bytes at slot. Returns slot index or -1.
fn proc_store(W:[]u8, base:i32, prog:[]u8, nnodes:i32)i32 {
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,base,s)==0){
      proc_set_used(W,base,s,1);
      set32(W, proc_slot(W,base,s)+4, nnodes);
      let i:i32=0;
      while(i<nnodes*3){
        W[proc_slot(W,base,s)+8+i]=prog[i];
        i=i+1;
      }
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn proc_nnodes(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, proc_slot(W,base,slot)+4);
}
fn peval_from_store(W:[]u8, base:i32, slot:i32, nnodes:i32, k:i32, n:i32)i32 {
  let tmp:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nnodes*3){
    tmp[i]=W[proc_slot(W,base,slot)+8+i];
    i=i+1;
  }
  return peval(tmp, nnodes, k, n);
}
fn proc_apply(W:[]u8, base:i32, slot:i32, inp:[]u8, out:[]u8)i32 {
  let nnodes:i32=proc_nnodes(W,base,slot);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_from_store(W, base, slot, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn pdiscover_direct(W:[]u8, pbase:i32, seqs:[]u8, nseq:i32)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      let slot:i32=proc_store(W, pbase, tmp, nn);
      return slot;
    }
    pi=pi+1;
  }
  return -1;
}

// pdiscover_dry: dry-run discovery WITHOUT consuming proc slots.
// On success copies the winning program to out_prog and returns nnodes.
// On failure returns -1. NEVER calls proc_store. (B-A6b fix)
fn pdiscover_dry(W:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    let off:i32=get32(prog_index, pi*4);
    let nn:i32=prog_store[off] as i32;
    let i:i32=0;
    while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
    let allfit:i32=1;
    let s:i32=0;
    while(s<nseq){
      let sq:i32=get32(seqs, s*12);
      let sl:i32=get32(seqs, s*12+4);
      let sn:i32=get32(seqs, s*12+8);
      if(pfits(tmp, nn, W[sq..sq+sl*4], sl, sn)==0){ allfit=0; break; }
      s=s+1;
    }
    if(allfit==1){
      let i2:i32=0;
      while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
      return nn;
    }
    pi=pi+1;
  }
  return -1;
}

// ============ BRIDGE RULE STORE (from bridge_learn.zag) ============
// Rule: [used(4), cond_pos(4), cond_val(4), proc_true(4), proc_false(4)]
// Semantics: IF input[cond_pos]==cond_val THEN apply proc_true ELSE proc_false
fn BR_MAX()i32 { return 4; }
fn BR_SZ()i32 { return 20; }
fn br_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*BR_SZ();
}
fn br_used(W:[]u8, base:i32, slot:i32)i32 {
  return get32(W, br_slot(W,base,slot));
}
fn br_store(W:[]u8, base:i32, cpos:i32, cval:i32, pt:i32, pf:i32)i32 {
  let s:i32=0;
  while(s<BR_MAX()){
    if(br_used(W,base,s)==0){
      let o:i32=br_slot(W,base,s);
      set32(W,o,1); set32(W,o+4,cpos); set32(W,o+8,cval);
      set32(W,o+12,pt); set32(W,o+16,pf);
      return s;
    }
    s=s+1;
  }
  return -1;
}
fn br_count(W:[]u8, base:i32)i32 {
  let c:i32=0;
  let s:i32=0;
  while(s<BR_MAX()){ if(br_used(W,base,s)==1){c=c+1;} s=s+1; }
  return c;
}
fn br_cpos(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+4); }
fn br_cval(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+8); }
fn br_ptrue(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+12); }
fn br_pfalse(W:[]u8, base:i32, slot:i32)i32 { return get32(W, br_slot(W,base,slot)+16); }

// bridge_apply: evaluate condition, dispatch to correct procedure.
// If input shorter than cond_pos, defaults to proc_false.
fn bridge_apply(W:[]u8, pbase:i32, bbase:i32, bslot:i32, inp:[]u8, out:[]u8)i32 {
  let cpos:i32=br_cpos(W,bbase,bslot);
  let cval:i32=br_cval(W,bbase,bslot);
  let pt:i32=br_ptrue(W,bbase,bslot);
  let pf:i32=br_pfalse(W,bbase,bslot);
  if(inp.len>cpos && (inp[cpos] as i32)==cval){
    return proc_apply(W, pbase, pt, inp, out);
  }
  return proc_apply(W, pbase, pf, inp, out);
}

// ============ BRIDGE LEARN (from bridge_learn.zag) ============
// pairs in W at pairbase: npairs * 16 bytes: (in_off, in_len, out_off, out_len)
// work: scratch area in W for seq data.
// Returns:
//   0..15: procedure slot (direct discovery succeeded, NO BRIDGE)
//   1000+bslot: bridge rule created
//   -1: failure
//
// The (pos, val) condition is discovered by searching over all input
// positions and all byte values present in the training data. No byte
// literals for condition values appear in this function.
fn bridge_learn(W:[]u8, pbase:i32, bbase:i32, pairbase:i32, npairs:i32, work:i32)i32 {
  let seqbase:i32=work;
  let statbase:i32=work + npairs*64;
  let lenbase:i32=statbase + npairs*4;

  // Step 1: extract all pairs
  let i:i32=0;
  let maxlen:i32=0;
  while(i<npairs){
    let in_off:i32=get32(W, pairbase+i*16);
    let in_len:i32=get32(W, pairbase+i*16+4);
    let out_off:i32=get32(W, pairbase+i*16+8);
    let out_len:i32=get32(W, pairbase+i*16+12);
    if(in_len>maxlen){maxlen=in_len;}
    let sq:[]u8=z_alloc(64);
    let sl:i32=pextract(W[in_off..in_off+in_len], W[out_off..out_off+out_len], sq);
    if(sl<0){
      set32(W, statbase+i*4, 0);
    } else {
      set32(W, statbase+i*4, 1);
      set32(W, lenbase+i*4, sl);
      let j:i32=0;
      while(j<sl*4){ W[seqbase+i*64+j]=sq[j]; j=j+1; }
    }
    i=i+1;
  }

  // Step 2: try direct discovery on the EXTRACTABLE subset (Repair 3).
  // A single unextractable pair no longer vetoes direct discovery for
  // the extractable rest. Unextractable pairs are reported WITHHELD and
  // no spurious bridge fires for them.
  let nsub:i32=0;
  i=0;
  while(i<npairs){
    if(get32(W, statbase+i*4)==1){nsub=nsub+1;}
    i=i+1;
  }
  if(nsub>0){
    let desc:[]u8=z_alloc(nsub*12);
    let di:i32=0;
    i=0;
    while(i<npairs){
      if(get32(W, statbase+i*4)==1){
        set32(desc, di*12, seqbase+i*64);
        set32(desc, di*12+4, get32(W, lenbase+i*4));
        set32(desc, di*12+8, get32(W, pairbase+i*16+4));
        di=di+1;
      }
      i=i+1;
    }
    let slot:i32=pdiscover_direct(W, pbase, desc, nsub);
    if(slot>=0){
      if(nsub<npairs){
        emit("bridge: direct discovery on ");
        emit(i32s(nsub));
        emit("/");
        emit(i32s(npairs));
        emit(" extractable pairs; ");
        emit(i32s(npairs-nsub));
        emit(" unextractable pair(s) WITHHELD (no bridge)\n");
      }
      return slot;
    }
  }

  // Step 3: bridge triggered. Search (pos, val).
  emit("bridge: direct failed, inducing condition...\n");
  let p:i32=0;
  while(p<maxlen){
    // All pairs must have in_len > p for this position to be usable
    let okp:i32=1;
    i=0;
    while(i<npairs){
      if(get32(W, pairbase+i*16+4)<=p){okp=0; break;}
      i=i+1;
    }
    if(okp==1){
      // Collect distinct byte values at position p (from data, not literals)
      let dvals:[]u8=z_alloc(128);
      let ndv:i32=0;
      i=0;
      while(i<npairs){
        let in_off:i32=get32(W, pairbase+i*16);
        let v:i32=W[in_off+p] as i32;
        let found:i32=0;
        let k:i32=0;
        while(k<ndv){
          if((dvals[k] as i32)==v){found=1; break;}
          k=k+1;
        }
        if(found==0){
          dvals[ndv]=v as u8;
          ndv=ndv+1;
        }
        i=i+1;
      }
      // Try each distinct value as the split point
      let vi:i32=0;
      while(vi<ndv){
        let v:i32=dvals[vi] as i32;
        let s1idx:[]u8=z_alloc(64);
        let s2idx:[]u8=z_alloc(64);
        let n1:i32=0;
        let n2:i32=0;
        i=0;
        while(i<npairs){
          // Only include extractable pairs
          if(get32(W, statbase+i*4)==1){
            let in_off:i32=get32(W, pairbase+i*16);
            if((W[in_off+p] as i32)==v){
              set32(s1idx, n1*4, i); n1=n1+1;
            } else {
              set32(s2idx, n2*4, i); n2=n2+1;
            }
          }
          i=i+1;
        }
        if(n1>0 && n2>0){
          let d1:[]u8=z_alloc(n1*12);
          let k:i32=0;
          while(k<n1){
            let pi:i32=get32(s1idx, k*4);
            set32(d1, k*12, seqbase+pi*64);
            set32(d1, k*12+4, get32(W, lenbase+pi*4));
            set32(d1, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          let d2:[]u8=z_alloc(n2*12);
          k=0;
          while(k<n2){
            let pi:i32=get32(s2idx, k*4);
            set32(d2, k*12, seqbase+pi*64);
            set32(d2, k*12+4, get32(W, lenbase+pi*4));
            set32(d2, k*12+8, get32(W, pairbase+pi*16+4));
            k=k+1;
          }
          // B-A6b fix: dry-run discovery WITHOUT consuming proc slots.
          let prog1:[]u8=z_alloc(48);
          let nn1:i32=pdiscover_dry(W, d1, n1, prog1);
          if(nn1>=0){
            let prog2:[]u8=z_alloc(48);
            let nn2:i32=pdiscover_dry(W, d2, n2, prog2);
            if(nn2>=0){
              // Winning split found. Now store both procedures.
              let s1:i32=proc_store(W, pbase, prog1, nn1);
              if(s1>=0){
                let s2:i32=proc_store(W, pbase, prog2, nn2);
                if(s2>=0){
                  let bs:i32=br_store(W, bbase, p, v, s1, s2);
                  if(bs>=0){
                    emit("bridge: learned IF input[");
                    emit(i32s(p));
                    emit("]==");
                    emit(i32s(v));
                    emit(" THEN proc");
                    emit(i32s(s1));
                    emit(" ELSE proc");
                    emit(i32s(s2));
                    emit("\n");
                    return 1000+bs;
                  }
                }
              }
              // Store failed: slots genuinely exhausted.
              return -1;
            }
          }
        }
        vi=vi+1;
      }
    }
    p=p+1;
  }
  return -1;
}

// ============ EVICTION POLICY (H-UNIFIED9 R10: H-MEM5 policy port) ============
// Merit-threshold eviction for the causal store. Ports the H-MEM5 policy
// (MERITK=2, no grace, bounded youth protection, fallback-evict) from the
// proc-cache lane into the unified causal rule base, so the continuing
// learner never stops learning. Adaptations vs H-MEM5 are disclosed:
// the clock is the STORE clock (advances per stored rule, not per query)
// and the youth window is two full store turnovers (2x16=32), because a
// 16-slot fill otherwise ages out its own first-written rules.
// Per-slot metadata lives at CMETA (16 slots x 8 bytes: +0 uses, +4 bseq).
// A rule is exercised (uses++) when a learn corroborates or conflicts it,
// or when a query predicts through it. Dead (CONFLICTED) slots are always
// eviction-eligible and are taken first: they can never match again.
fn CMETA()i32 { return 1552; }   // 16*8 = 128 bytes; causal store ends at 1552
fn CSEQ()i32 { return 65012; }   // causal store clock: +1 per stored rule
fn ECOUNT()i32 { return 65016; } // cumulative evicted-rule counter
fn CPROB()i32 { return 32; }     // merit youth window (store-clock units)
fn CMERITK()i32 { return 2; }    // merit threshold (ported H-MEM5 MERITK)
fn cm_uses(W:[]u8, slot:i32)i32 { return get32(W, CMETA()+slot*8); }
fn cm_bseq(W:[]u8, slot:i32)i32 { return get32(W, CMETA()+slot*8+4); }
// Eligibility (H-MEM5 elig port): a used ACTIVE slot is protected (returns 0)
// iff it is young (CSEQ < bseq+CPROB) AND has merit (uses >= 2). Dead slots
// are always eligible. No grace: a newcomer with 0 or 1 uses is evictable.
fn cm_elig(W:[]u8, base:i32, slot:i32)i32 {
  if(cr_used(W,base,slot)==0){ return 0; }
  if(get32(W,cr_slot(W,base,slot)+24)!=0){ return 1; }
  if(get32(W, CSEQ()) < cm_bseq(W,slot)+CPROB()){
    if(cm_uses(W,slot)>=CMERITK()){ return 0; }
  }
  return 1;
}
// Victim selection. Returns the slot to evict, or -1 if none (defensive;
// unreachable: at least one of 16 slots is always used when full).
// a) dead first: lowest-index CONFLICTED slot. b) merit: among eligible
// ACTIVE slots, lowest uses, tie -> lowest slot. c) fallback: every slot
// protected -> lowest uses ignoring protection (H-MEM5 FALLBACK precedent).
fn caus_evict_victim(W:[]u8, base:i32)i32 {
  let s:i32=0;
  while(s<CR_MAX()){
    if(cr_used(W,base,s)==1 && get32(W,cr_slot(W,base,s)+24)==2){ return s; }
    s=s+1;
  }
  let best:i32=-1;
  let bu:i32=0;
  s=0;
  while(s<CR_MAX()){
    if(cr_used(W,base,s)==1 && get32(W,cr_slot(W,base,s)+24)==0 && cm_elig(W,base,s)==1){
      let u:i32=cm_uses(W,s);
      if(best<0 || u<bu){ best=s; bu=u; }
    }
    s=s+1;
  }
  if(best>=0){ return best; }
  s=0;
  while(s<CR_MAX()){
    if(cr_used(W,base,s)==1){
      let u:i32=cm_uses(W,s);
      if(best<0 || u<bu){ best=s; bu=u; }
    }
    s=s+1;
  }
  return best;
}

// ============ CAUSAL STORE (from route_learn.zag) ============
// Rules: (cond_var, cond_val, action, effect_var, effect_val, status)
// Max 16 rules. Status: 0=active, 1=superseded, 2=conflicted
fn CR_MAX()i32 { return 16; }
fn CR_SZ()i32 { return 28; }  // 7*4

fn cr_slot(W:[]u8, base:i32, slot:i32)i32 {
  return base + slot*CR_SZ();
}
fn cr_used(W:[]u8, base:i32, slot:i32)i32 { return get32(W, cr_slot(W,base,slot)); }
fn cr_set(W:[]u8, base:i32, slot:i32, used:i32, cv:i32, cval:i32, act:i32, ev:i32, eval:i32, st:i32)void {
  let o:i32=cr_slot(W,base,slot);
  set32(W,o,used); set32(W,o+4,cv); set32(W,o+8,cval);
  set32(W,o+12,act); set32(W,o+16,ev); set32(W,o+20,eval); set32(W,o+24,st);
  // H-UNIFIED9 R10: (re)stored rule starts with zero merit, born now.
  // Metadata is slot-indexed under CBASE(); all callers pass CBASE().
  set32(W, CMETA()+slot*8, 0);
  set32(W, CMETA()+slot*8+4, get32(W, CSEQ()));
  return;
}
// Learn from episode: (s0,s1,action) -> (ns0,ns1)
// Returns: 1 = new rule stored; 0 = corroborated (no state change);
//          2 = conflict marked (old rule set CONFLICTED; revision step);
//          3 = stored via merit eviction (H-UNIFIED9 R10: victim evicted,
//              newcomer stored; the old -1 refuse path is superseded).
//         -1 = defensive only, unreachable (eviction always finds a victim).
// (H-UNIFIED3: return code added for honest capacity accounting;
//  H-UNIFIED9: eviction accounting added; matching/storage logic otherwise
//  unchanged.) Exercising a rule (corroboration or conflict) earns merit.
fn clearn(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, ns0:i32, ns1:i32)i32 {
  let slot:i32=0;
  let found:i32=-1;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 &&
       get32(W,cr_slot(W,base,slot)+12)==act &&
       get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let sv:i32=s0;
      if(cv==1){sv=s1;}
      if(sv==cval){found=slot; break;}
    }
    slot=slot+1;
  }
  if(found<0){
    slot=0;
    while(slot<CR_MAX()){
      if(cr_used(W,base,slot)==0){break;}
      slot=slot+1;
    }
    if(slot>=CR_MAX()){
      // H-UNIFIED9 R10: merit-threshold eviction replaces refuse-with-warning.
      // The learner never stops learning; retention must be earned (uses>=2).
      let v:i32=caus_evict_victim(W,base);
      if(v<0){ return -1; } // defensive: unreachable (a victim always exists)
      let vo:i32=cr_slot(W,base,v);
      let fb:i32=0;
      if(cm_elig(W,base,v)==0){ fb=1; }
      if(fb==1){ emit("UEVICT-FALLBACK: all slots merit-protected; evicting lowest-uses "); }
      else { emit("UEVICT: "); }
      emit("causal rule R");
      emit(i32s(v));
      emit(" IF s");
      emit(i32s(get32(W,vo+4)));
      emit("==");
      emit(i32s(get32(W,vo+8)));
      emit(" AND a==");
      emit(i32s(get32(W,vo+12)));
      emit(" THEN s");
      emit(i32s(get32(W,vo+16)));
      emit(":=");
      emit(i32s(get32(W,vo+20)));
      emit(" (uses=");
      emit(i32s(cm_uses(W,v)));
      emit(") evicted for incoming (");
      emit(i32s(s0)); emit(","); emit(i32s(s1)); emit(","); emit(i32s(act));
      emit(")->(");
      emit(i32s(ns0)); emit(","); emit(i32s(ns1));
      emit(") (H-UNIFIED9)\n");
      set32(W, ECOUNT(), get32(W,ECOUNT())+1);
      set32(W, CSEQ(), get32(W,CSEQ())+1);
      cr_set(W,base,v,1, 0,s0, act, 1,ns1, 0);
      return 3;
    }
    set32(W, CSEQ(), get32(W,CSEQ())+1);
    cr_set(W,base,slot,1, 0,s0, act, 1,ns1, 0);
    emit("causal: new rule R");
    emit(i32s(slot));
    emit(" IF s0==");
    emit(i32s(s0));
    emit(" AND a==");
    emit(i32s(act));
    emit(" THEN s1:=");
    emit(i32s(ns1));
    emit("\n");
    return 1;
  } else {
    // H-UNIFIED9 R10: the rule was exercised; merit++.
    set32(W, CMETA()+found*8, cm_uses(W,found)+1);
    let ev:i32=get32(W,cr_slot(W,base,found)+16);
    let eval:i32=get32(W,cr_slot(W,base,found)+20);
    let actual:i32=ns1;
    if(ev==1 && actual!=eval){
      set32(W,cr_slot(W,base,found)+24,2);
      emit("causal: R");
      emit(i32s(found));
      emit(" CONFLICTED\n");
      return 2;
    }
  }
  return 0;
}
// Predict: given (s0,s1,act), find matching active rule
fn cpredict(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, out:[]u8)i32 {
  let slot:i32=0;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 && get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let a:i32=get32(W,cr_slot(W,base,slot)+12);
      if(a==act){
        let sv:i32=s0;
        if(cv==1){sv=s1;}
        if(sv==cval){
          let ev:i32=get32(W,cr_slot(W,base,slot)+16);
          let eval:i32=get32(W,cr_slot(W,base,slot)+20);
          out[0]=s0 as u8; out[1]=s1 as u8;
          if(ev==0){out[0]=eval as u8;}
          if(ev==1){out[1]=eval as u8;}
          // H-UNIFIED9 R10: a prediction through the rule earns merit.
          set32(W, CMETA()+slot*8, cm_uses(W,slot)+1);
          return 1;
        }
      }
    }
    slot=slot+1;
  }
  return 0;
}

// ============ COHERENCE GATE (H-UNIFIED2 Repair 1: U-A2) ============
// An episode is coherent iff no ACTIVE rule matches its
// (cond_var, cond_val, action) with a different effect. Contradictory
// episodes are quarantined by the unified handler, never committed.
// This gates the composition layer only; clearn is untouched.
// Returns 1 if coherent (safe to commit), 0 if contradictory.
fn caus_coherent(W:[]u8, base:i32, s0:i32, s1:i32, act:i32, ns0:i32, ns1:i32)i32 {
  let slot:i32=0;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 && get32(W,cr_slot(W,base,slot)+24)==0){
      let cv:i32=get32(W,cr_slot(W,base,slot)+4);
      let cval:i32=get32(W,cr_slot(W,base,slot)+8);
      let a:i32=get32(W,cr_slot(W,base,slot)+12);
      if(a==act){
        let sv:i32=s0;
        if(cv==1){sv=s1;}
        if(sv==cval){
          let ev:i32=get32(W,cr_slot(W,base,slot)+16);
          let eval:i32=get32(W,cr_slot(W,base,slot)+20);
          if(ev==1 && ns1!=eval){return 0;}
          if(ev==0 && ns0!=eval){return 0;}
        }
      }
    }
    slot=slot+1;
  }
  return 1;
}

// Count ACTIVE rules (for kill-bar assertions).
fn caus_active_count(W:[]u8, base:i32)i32 {
  let slot:i32=0;
  let n:i32=0;
  while(slot<CR_MAX()){
    if(cr_used(W,base,slot)==1 && get32(W,cr_slot(W,base,slot)+24)==0){n=n+1;}
    slot=slot+1;
  }
  return n;
}

// ============ STRUCTURE-INFERRED ROUTER (from route_learn.zag) ============
// Route codes: 0=WITHHOLD, 1=PROC_LEARN, 2=CAUS_LEARN, 3=PROC_QUERY, 4=CAUS_QUERY
fn is_digit(c:u8)i32 {
  if(c>=48 && c<=57){return 1;}
  return 0;
}

// field_kind: -2 empty, -1 string, else int count (>=1)
fn field_kind(b:[]u8, lo:i32, hi:i32)i32 {
  if(hi<=lo){return -2;}
  let i:i32=lo;
  let nints:i32=1;
  let expect_digit:i32=1;
  while(i<hi){
    let c:u8=b[i];
    if(is_digit(c)==1){expect_digit=0;}
    else {
      if(c==44){
        if(expect_digit==1){return -1;}
        nints=nints+1;
        expect_digit=1;
      } else {return -1;}
    }
    i=i+1;
  }
  if(expect_digit==1){return -1;}
  return nints;
}

fn find_ch(b:[]u8, lo:i32, hi:i32, ch:u8)i32 {
  let i:i32=lo;
  while(i<hi){if(b[i]==ch){return i;}i=i+1;}
  return -1;
}

fn route_name(c:i32)[]u8 {
  if(c==1){return "PROC_LEARN";}
  if(c==2){return "CAUS_LEARN";}
  if(c==3){return "PROC_QUERY";}
  if(c==4){return "CAUS_QUERY";}
  if(c==5){return "AMBIGUOUS";}
  if(c==6){return "CAUS_REVISE";}
  return "WITHHOLD";
}

fn route_line(line:[]u8)i32 {
  // H-UNIFIED4: the '!' marker (byte 33) is INERT on the stream path.
  // A leading '!' is stripped for classification; if the remainder
  // parses as iii>ii episodes it routes as ordinary CAUS_LEARN (2)
  // and faces the coherence gate like any stream line. Any other
  // shape with the marker routes WITHHOLD. route_line NEVER returns
  // code 6: the revision channel is reachable only via operator_route
  // (separate call path), so no stream byte sequence can invoke the
  // revise handler. This closes X-U3-1 (authority spoofing).
  let rline:[]u8=line;
  let is_revise:i32=0;
  if(line.len>0 && line[0]==33){
    is_revise=1;
    rline=line[1..line.len];
  }
  let n:i32=rline.len;
  let code:i32=0;
  let reason:[]u8="empty line";
  if(n>0){
    let nseg:i32=1;
    let i:i32=0;
    while(i<n){if(rline[i]==59){nseg=nseg+1;}i=i+1;}
    let s:i32=0;
    let pos:i32=0;
    let all_pair_str:i32=1;
    let all_ep:i32=1;
    let all_int_pair:i32=1;
    let has_gt:i32=0;
    let bad:i32=0;
    while(s<nseg){
      let end:i32=find_ch(rline,pos,n,59);
      if(end<0){end=n;}
      if(end<=pos){bad=1;reason="empty segment";}
      else {
        let gt:i32=find_ch(rline,pos,end,62);
        if(gt<0){
          all_pair_str=0;
          all_ep=0;
          all_int_pair=0;
        } else {
          has_gt=1;
          if(find_ch(rline,gt+1,end,62)>=0){
            all_pair_str=0;
            all_ep=0;
            all_int_pair=0;
          } else {
            let lk:i32=field_kind(rline,pos,gt);
            let rk:i32=field_kind(rline,gt+1,end);
            if(lk!=-1 || rk!=-1){all_pair_str=0;}
            if(lk!=3 || rk!=2){all_ep=0;}
            if(lk<1 || rk<1){all_int_pair=0;}
          }
        }
      }
      if(bad==1){break;}
      pos=end+1;
      s=s+1;
    }
    if(bad==0){
      if(nseg>=2 && all_pair_str==1){code=1;reason="2+ segs, str>str";}
      else {
        if(nseg>=2 && all_ep==1){code=2;reason="2+ segs, iii>ii";}
        else {
          if(nseg>=2 && all_int_pair==1){code=5;reason="int-pair lesson: ambiguous domain (digit-string procedure vs int data); withheld";}
          else {
          if(nseg==1 && has_gt==0){
            let k:i32=field_kind(rline,0,n);
            if(k==-1){code=3;reason="single bare string";}
            else {
              if(k==3){code=4;reason="single 3-int tuple";}
              else {
                if(k>=1){code=5;reason="single bare digit string: ambiguous (procedure query vs int data); withheld";}
                else {reason="single seg: not string nor 3-int tuple";}
              }
            }
          } else {
            if(nseg==1){reason="single pair/episode: learning needs 2+ segs";}
            else {reason="mixed or malformed segments";}
          }
          }
        }
      }
    }
  }
  // H-UNIFIED4: the marker is inert on the stream path. A causal
  // remainder keeps code 2 (ordinary gated learn); any other shape
  // withholds exactly as in H-UNIFIED3. Code 6 is unreachable here.
  if(is_revise==1){
    if(code==2){reason="leading '!' ignored on stream path: ordinary gated causal learn; revision requires operator channel";}
    else {code=0;reason="explicit revise marker requires iii>ii episodes; withheld";}
  }
  emit("ROUTE [");
  emit(line);
  emit("] -> ");
  emit(route_name(code));
  emit(" (");
  emit(reason);
  emit(")\n");
  return code;
}

// H-UNIFIED4: the operator revision channel. This function is the
// SOLE path to code 6 = CAUS_REVISE and hence to handle_caus_revise.
// It is reachable only by direct call (separate call path from the
// stream's route_line); route_line can never return 6, so no stream
// byte sequence can invoke the revise handler. Authority is a property
// of the call path, never of a self-asserted byte. In deployment this
// call path MUST be a separate authenticated channel (distinct
// fd/socket/API role); here main() plays both roles in delimited
// sections. Requires the '!' marker (explicitness); the stripped
// remainder is classified by reusing route_line (no duplicated logic);
// code 2 maps to 6, anything else withholds.
fn operator_route(line:[]u8)i32 {
  if(line.len==0 || line[0]!=33){
    emit("OPERATOR_ROUTE [");
    emit(line);
    emit("] -> WITHHOLD (operator channel requires '!' marker)\n");
    return 0;
  }
  let body:[]u8=line[1..line.len];
  let inner:i32=route_line(body);
  if(inner==2){
    emit("OPERATOR_ROUTE [");
    emit(line);
    emit("] -> CAUS_REVISE (operator-authorized causal revision)\n");
    return 6;
  }
  emit("OPERATOR_ROUTE [");
  emit(line);
  emit("] -> WITHHOLD (operator revise requires iii>ii episodes)\n");
  return 0;
}

fn parse_ints(b:[]u8, lo:i32, hi:i32, out:[]u8)i32 {
  // H-UNIFIED6 contract (frozen in PREREG_UNIFIED6.md):
  // Returns >= 0: count of skipped non-digit bytes (0 = clean parse).
  // Returns -1 (SHAPE_OVERFLOW): the field holds more values than out
  //   can take (capacity = out.len/4). The parser stops at capacity and
  //   NEVER writes past out.len: no panic, no silent arena corruption
  //   through a short view. Values already written are the first `cap`
  //   values of the field.
  // H-UNIFIED8 correction (frozen in PREREG_UNIFIED8.md; SUPERSEDES
  //   the R8 justification for zero-padded runs):
  // Returns -2 (MAGNITUDE_OVERFLOW): a digit run's SIGNIFICANT digits
  //   exceed i32 range. Detection is exact with no wider type: 11+
  //   significant digits always have value >= 10^10 > 2147483647
  //   (leading zeros do not count; R8's "11+ digits" claim was false
  //   for zero-padded runs, corrected here). A 10-significant-digit
  //   run is checked against 2147483647 before folding the 10th
  //   significant digit (the 9-significant-digit prefix fits i32
  //   exactly, so the test is exact). On overflow the parser emits
  //   PARSE_MAG and returns immediately: no value from the field is
  //   committed. The PARSE_MAG trace text is byte-identical to
  //   H-UNIFIED7 and is now factually accurate on every path that
  //   emits it.
  // H-UNIFIED7 addition (frozen in PREREG_UNIFIED7.md):
  // Returns -2 (MAGNITUDE_OVERFLOW): a digit run exceeds i32 range.
  //   Detection is exact with no wider type: a run of 11+ digits is
  //   always > 2147483647 (min 10^10); a 10-digit run is checked
  //   against 2147483647 before folding the 10th digit (the 9-digit
  //   prefix fits i32 exactly, so the test is exact). On overflow the
  //   parser emits PARSE_MAG and returns immediately: no value from
  //   the field is committed.
  // Skipped bytes consume no output slots (H-UNIFIED5 behavior kept).
  // On valid inputs this writes exactly what H-UNIFIED6 wrote.
  let cap:i32=out.len/4;
  let skips:i32=0;
  let idx:i32=0;
  let i:i32=lo;
  while(i<hi){
    // H-UNIFIED5 defensive guard: a non-digit, non-comma byte previously
    // hung the parser here (i never advanced -> infinite loop). Skip it
    // with an explicit trace. Dispatch classification guarantees
    // digit-only fields, so this is unreachable on valid inputs; the
    // guard is purely defensive. Skipped bytes are not stored and do not
    // consume an output slot, so valid numbers around them still parse.
    if(is_digit(b[i])==0 && b[i]!=44){
      emit("PARSE_GUARD: skipped non-numeric byte ");
      emit(i32s(b[i] as i32));
      emit(" in numeric field (H-UNIFIED5)\n");
      skips=skips+1;
      i=i+1;
    } else {
      let v:i32=0;
      let sig:i32=0;
      let mag_bad:i32=0;
      while(i<hi){
        if(is_digit(b[i])==0){break;}
        let dig:i32=(b[i] as i32)-48;
        if(mag_bad==0 && (dig!=0 || sig>0)){
          // Significant digit: leading zeros do not count toward the
          // magnitude run length (H-UNIFIED8 R9; X-U7-3 repair).
          if(sig>=10){
            // 11th significant digit: value >= 10^10 > 2147483647.
            mag_bad=1;
          } else {
            if(sig==9){
              // Folding the 10th significant digit. v holds the
              // 9-significant-digit prefix (<= 999999999, exact in
              // i32). Overflow iff v*10+dig > 2147483647, i.e.
              // v > 214748364, or v == 214748364 and dig > 7.
              if(v>214748364 || (v==214748364 && dig>7)){mag_bad=1;}
              else {v=v*10+dig;}
            } else {
              v=v*10+dig;
            }
            sig=sig+1;
          }
        }
        i=i+1;
      }
      if(mag_bad==1){
        emit("PARSE_MAG: digit run exceeds i32 range; field rejected (H-UNIFIED7)\n");
        return -2;
      }
      if(idx>=cap){
        emit("PARSE_SHAPE: field has more values than the buffer holds; stopped at capacity (H-UNIFIED6)\n");
        return -1;
      }
      set32(out,idx*4,v);
      idx=idx+1;
      if(i<hi && b[i]==44){i=i+1;}
    }
  }
  return skips;
}

// ============ WORKSPACE LAYOUT ============
// W: 65536 bytes.
//   pbase=0       proc store: 16*64 = 1024
//   bbase=1024    bridge store: 4*20 = 80
//   cbase=1104    causal store: 16*28 = 448 (ends 1552)
//   work=2048     bridge_learn scratch
//   pairbase=8192 pair descriptors (16 bytes each)
//   ST_STR=65000  persistent string-data cursor (init 16384)
fn PBASE()i32 { return 0; }
fn BBASE()i32 { return 1024; }
fn CBASE()i32 { return 1104; }
fn WORK()i32 { return 2048; }
fn PAIRBASE()i32 { return 8192; }
fn ST_STR()i32 { return 65000; }
fn QCOUNT()i32 { return 65004; }  // cumulative quarantined-episode counter (H-UNIFIED2)
fn DCOUNT()i32 { return 65008; }  // cumulative dropped-episode counter: store-full refusals (H-UNIFIED3)
fn STR0()i32 { return 16384; }

// ============ UNIFIED HANDLERS ============

// Parse an unlabeled PROC_LEARN line into str>str pairs, stage them into W,
// and run bridge_learn (direct-first, bridge on failure).
// Returns: 0..15 direct slot, 1000+bslot bridge rule, -1 failure.
fn handle_proc_learn_unified(W:[]u8, line:[]u8)i32 {
  let n:i32=line.len;
  let nseg:i32=1;
  let i:i32=0;
  while(i<n){if(line[i]==59){nseg=nseg+1;}i=i+1;}
  let strbase:i32=get32(W, ST_STR());
  let s:i32=0;
  let pos:i32=0;
  while(s<nseg){
    let end:i32=find_ch(line,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(line,pos,end,62);
    let in_off:i32=strbase;
    i=pos;
    while(i<gt){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let in_len:i32=gt-pos;
    let out_off:i32=strbase;
    i=gt+1;
    while(i<end){W[strbase]=line[i];strbase=strbase+1;i=i+1;}
    let out_len:i32=end-(gt+1);
    set32(W, PAIRBASE()+s*16, in_off);
    set32(W, PAIRBASE()+s*16+4, in_len);
    set32(W, PAIRBASE()+s*16+8, out_off);
    set32(W, PAIRBASE()+s*16+12, out_len);
    pos=end+1;
    s=s+1;
  }
  set32(W, ST_STR(), strbase);
  let rc:i32=bridge_learn(W, PBASE(), BBASE(), PAIRBASE(), nseg, WORK());
  if(rc>=0 && rc<1000){
    emit("ULEARN: direct discovery -> proc slot ");
    emit(i32s(rc));
    emit("\n");
  } else {
    if(rc>=1000){
      emit("ULEARN: bridge triggered -> rule ");
      emit(i32s(rc-1000));
      emit("\n");
    } else {
      emit("ULEARN FAIL: no program and no bridge\n");
    }
  }
  return rc;
}

// ============ CAPACITY POLICY (H-UNIFIED9 R10: merit eviction) ============
// Policy: MERIT-THRESHOLD EVICTION (H-UNIFIED9 R10; SUPERSEDES the H-UNIFIED3
// Repair B refuse-with-warning policy for the causal store).
// When the causal store is full, clearn selects a victim instead of
// returning -1: CONFLICTED (dead) slots first, then the lowest-merit
// eligible ACTIVE slot (H-MEM5 policy port: protected iff young AND
// uses>=2, no grace), then fallback lowest-merit ignoring protection.
// Every eviction is loud (UEVICT / UEVICT-FALLBACK trace naming the victim
// slot, its rule, and its uses) and counted in W[ECOUNT()]. The learner
// never stops learning; retention must be earned. Quarantines are counted
// separately in W[QCOUNT()]. The old USTOREFULL branches are kept as
// defensive dead code. Limits: 16 causal rules, 16 procedure slots,
// 4 bridge slots, 128 pair descriptors.
// The unlabeled stream is no longer first-writer-wins at capacity:
// a meritless rule yields to a newcomer. Disclosed cost: eviction can
// retire a rule that was blocking a contradictory episode at the
// coherence gate; a later identical episode then learns fresh. This is
// the H-MEM eviction work product the H-UNIFIED5 capacity comment
// deferred to, now integrated.
// ================================================================

// Learn causal rules from iii>ii episodes, coherence-gated (Repair 1).
// The unlabeled stream is append/corroborate-only for verified causal
// knowledge: an episode contradicting an ACTIVE rule is QUARANTINED
// (traced, never committed) instead of silently revising it.
//
// H-UNIFIED3 Repair B: honest accounting. Returns the STORED count
// (episodes that changed store state: new rules + conflict marks), not
// episodes handed to clearn. Corroborations, quarantines, and
// store-full drops are counted and reported separately. Cumulative
// quarantine count at W[QCOUNT()], cumulative drop count at W[DCOUNT()].
fn handle_caus_learn(W:[]u8, line:[]u8)i32 {
  // H-UNIFIED4: defensive strip of a leading '!' (inert on the stream
  // path; route_line classifies the stripped remainder). No valid
  // stream line begins with byte 33, so this changes nothing else.
  let sline:[]u8=line;
  if(line.len>0 && line[0]==33){sline=line[1..line.len];}
  let n:i32=sline.len;
  let pos:i32=0;
  let nstored:i32=0;
  let ncorr:i32=0;
  let nq:i32=0;
  let ndrop:i32=0;
  let nevict:i32=0; // H-UNIFIED9 R10: evict-stores this call
  while(pos<n){
    let end:i32=find_ch(sline,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(sline,pos,end,62);
    // H-UNIFIED6 defense-in-depth (second layer; classification is the
    // first): verify the segment shape at the handler before parsing.
    // Malformed segments are skipped explicitly: no parse, no commit,
    // no panic. On classified dispatch paths shapes are exact, so this
    // never fires there.
    if(gt<0 || field_kind(sline,pos,gt)!=3 || field_kind(sline,gt+1,end)!=2){
      emit("USHAPE: segment skipped (expected 3-int>2-int episode) [");
      emit(sline[pos..end]);
      emit("] (H-UNIFIED6)\n");
    } else {
      let lv:[]u8=z_alloc(12);
      let rv:[]u8=z_alloc(8);
      let plc:i32=parse_ints(sline,pos,gt,lv);
      let prc:i32=parse_ints(sline,gt+1,end,rv);
      if(plc<0 || prc<0){
        // Unreachable given the field_kind gate above (the second layer
        // does not trust the first): the parser itself is capacity-safe
        // and magnitude-safe. Distinct trace per anomaly code.
        if(plc==-2 || prc==-2){
          emit("USHAPE: segment skipped (parser magnitude) [");
          emit(sline[pos..end]);
          emit("] (H-UNIFIED7)\n");
        } else {
          emit("USHAPE: segment skipped (parser capacity) [");
          emit(sline[pos..end]);
          emit("] (H-UNIFIED6)\n");
        }
      } else {
        let s0:i32=get32(lv,0);
        let s1:i32=get32(lv,4);
        let act:i32=get32(lv,8);
        let ns0:i32=get32(rv,0);
        let ns1:i32=get32(rv,4);
        if(caus_coherent(W,CBASE(),s0,s1,act,ns0,ns1)==1){
          let rc:i32=clearn(W,CBASE(),s0,s1,act,ns0,ns1);
          // H-UNIFIED9 R10: rc==3 (stored via eviction) changed store state.
          if(rc==1 || rc==2 || rc==3){
            nstored=nstored+1;
            if(rc==3){nevict=nevict+1;}
          }
          else {
            if(rc==0){ncorr=ncorr+1;}
            else {
              emit("USTOREFULL: episode (");
              emit(i32s(s0)); emit(","); emit(i32s(s1)); emit(",");
              emit(i32s(act)); emit(")->(");
              emit(i32s(ns0)); emit(","); emit(i32s(ns1));
              emit(") DROPPED: causal store full; verified knowledge kept, no silent loss\n");
              ndrop=ndrop+1;
            }
          }
        } else {
          emit("UCOHERE: QUARANTINE episode (");
          emit(i32s(s0)); emit(","); emit(i32s(s1)); emit(",");
          emit(i32s(act)); emit(")->(");
          emit(i32s(ns0)); emit(","); emit(i32s(ns1));
          emit("): contradicts verified rule; not committed\n");
          nq=nq+1;
        }
      }
    }
    pos=end+1;
  }
  set32(W, QCOUNT(), get32(W, QCOUNT())+nq);
  set32(W, DCOUNT(), get32(W, DCOUNT())+ndrop);
  emit("ULEARN: ");
  emit(i32s(nstored));
  emit(" stored, ");
  emit(i32s(ncorr));
  emit(" corroborated, ");
  emit(i32s(nq));
  emit(" quarantined, ");
  emit(i32s(ndrop));
  emit(" dropped (store full), ");
  emit(i32s(nevict));
  emit(" evicted (H-UNIFIED9)\n");
  return nstored;
}

// H-UNIFIED4: operator-only revision handler. Reachable SOLELY via
// operator_route (separate call path); route_line can never produce
// code 6, so no stream byte sequence can invoke this. Lines carry a
// leading '!' marker (required by operator_route). The marker is
// stripped, the coherence gate is BYPASSED for the trusted operator,
// and episodes commit via clearn directly: a contradicting episode
// marks the old ACTIVE rule CONFLICTED (clearn rc=2); a repeated
// episode then learns the corrected rule (rc=1). Same honest
// accounting as handle_caus_learn, minus quarantine (the gate is
// intentionally bypassed on the authenticated operator path).
// Returns the STORED count.
fn handle_caus_revise(W:[]u8, line:[]u8)i32 {
  let body:[]u8=line;
  if(line.len>0 && line[0]==33){body=line[1..line.len];}
  let n:i32=body.len;
  let pos:i32=0;
  let nstored:i32=0;
  let ncorr:i32=0;
  let ndrop:i32=0;
  let nevict:i32=0; // H-UNIFIED9 R10: evict-stores this call
  while(pos<n){
    let end:i32=find_ch(body,pos,n,59);
    if(end<0){end=n;}
    let gt:i32=find_ch(body,pos,end,62);
    // H-UNIFIED6 defense-in-depth (second layer; classification is the
    // first): verify the segment shape at the handler before parsing.
    // Malformed segments are skipped explicitly: no parse, no commit,
    // no panic. On the operator path shapes are exact (operator_route
    // reuses route_line), so this never fires there.
    if(gt<0 || field_kind(body,pos,gt)!=3 || field_kind(body,gt+1,end)!=2){
      emit("USHAPE: segment skipped (expected 3-int>2-int episode) [");
      emit(body[pos..end]);
      emit("] (H-UNIFIED6)\n");
    } else {
      let lv:[]u8=z_alloc(12);
      let rv:[]u8=z_alloc(8);
      let plc:i32=parse_ints(body,pos,gt,lv);
      let prc:i32=parse_ints(body,gt+1,end,rv);
      if(plc<0 || prc<0){
        // Unreachable given the field_kind gate above (the second layer
        // does not trust the first): the parser itself is capacity-safe
        // and magnitude-safe. Distinct trace per anomaly code.
        if(plc==-2 || prc==-2){
          emit("USHAPE: segment skipped (parser magnitude) [");
          emit(body[pos..end]);
          emit("] (H-UNIFIED7)\n");
        } else {
          emit("USHAPE: segment skipped (parser capacity) [");
          emit(body[pos..end]);
          emit("] (H-UNIFIED6)\n");
        }
      } else {
        let s0:i32=get32(lv,0);
        let s1:i32=get32(lv,4);
        let act:i32=get32(lv,8);
        let ns0:i32=get32(rv,0);
        let ns1:i32=get32(rv,4);
        let rc:i32=clearn(W,CBASE(),s0,s1,act,ns0,ns1);
        // H-UNIFIED9 R10: rc==3 (stored via eviction) changed store state.
        if(rc==1 || rc==2 || rc==3){
          nstored=nstored+1;
          if(rc==3){nevict=nevict+1;}
        }
        else {
          if(rc==0){ncorr=ncorr+1;}
          else {
            emit("USTOREFULL: revise episode (");
            emit(i32s(s0)); emit(","); emit(i32s(s1)); emit(",");
            emit(i32s(act)); emit(")->(");
            emit(i32s(ns0)); emit(","); emit(i32s(ns1));
            emit(") DROPPED: causal store full\n");
            ndrop=ndrop+1;
          }
        }
      }
    }
    pos=end+1;
  }
  set32(W, DCOUNT(), get32(W, DCOUNT())+ndrop);
  emit("UREVISE: ");
  emit(i32s(nstored));
  emit(" stored, ");
  emit(i32s(ncorr));
  emit(" corroborated, ");
  emit(i32s(ndrop));
  emit(" dropped (store full), ");
  emit(i32s(nevict));
  emit(" evicted (H-UNIFIED9)\n");
  return nstored;
}

// Apply every stored procedure AND every stored bridge rule.
// Bridge rules exercise conditional capability at query time.
fn handle_proc_query_unified(W:[]u8, line:[]u8)i32 {
  let napplied:i32=0;
  let s:i32=0;
  while(s<PROC_MAX()){
    if(proc_used(W,PBASE(),s)==1){
      let out:[]u8=z_alloc(line.len+1);
      if(proc_apply(W,PBASE(),s,line,out)==1){
        emit("QPROC slot ");
        emit(i32s(s));
        emit(" [");
        emit(line);
        emit("] -> [");
        emit(out[0..line.len]);
        emit("]\n");
        napplied=napplied+1;
      }
    }
    s=s+1;
  }
  let b:i32=0;
  while(b<BR_MAX()){
    if(br_used(W,BBASE(),b)==1){
      let out:[]u8=z_alloc(line.len+1);
      if(bridge_apply(W,PBASE(),BBASE(),b,line,out)==1){
        emit("QBRIDGE rule ");
        emit(i32s(b));
        emit(" [");
        emit(line);
        emit("] -> [");
        emit(out[0..line.len]);
        emit("]\n");
        napplied=napplied+1;
      }
    }
    b=b+1;
  }
  if(napplied==0){emit("QPROC WITHHOLD: no procedure or bridge rule stored\n");}
  return napplied;
}

// Causal query from a 3-int tuple (from route_learn.zag, unchanged).
fn handle_caus_query(W:[]u8, line:[]u8)i32 {
  // H-UNIFIED6 defense-in-depth (second layer; route_line code 4
  // already requires a single 3-int tuple): verify the query shape at
  // the handler before parsing. Malformed queries withhold explicitly:
  // no parse, no panic.
  if(field_kind(line,0,line.len)!=3){
    emit("QCAUS USHAPE WITHHOLD: expected single 3-int tuple (H-UNIFIED6)\n");
    return 0;
  }
  let v:[]u8=z_alloc(12);
  let pqc:i32=parse_ints(line,0,line.len,v);
  if(pqc<0){
    // Unreachable given the field_kind gate above (the second layer
    // does not trust the first): the parser itself is capacity-safe
    // and magnitude-safe. Distinct trace per anomaly code.
    if(pqc==-2){
      emit("QCAUS USHAPE WITHHOLD: parser magnitude (H-UNIFIED7)\n");
    } else {
      emit("QCAUS USHAPE WITHHOLD: parser capacity (H-UNIFIED6)\n");
    }
    return 0;
  }
  let out:[]u8=z_alloc(2);
  if(cpredict(W,CBASE(),get32(v,0),get32(v,4),get32(v,8),out)==1){
    emit("QCAUS [");
    emit(line);
    emit("] -> s0=");
    emit(i32s(out[0] as i32));
    emit(" s1=");
    emit(i32s(out[1] as i32));
    emit("\n");
    return 1;
  }
  emit("QCAUS WITHHOLD: no rule fired\n");
  return 0;
}

// ============ MAIN: mixed unlabeled stream ============

// ============ H-UNIFIED9 RED TEAM ADVERSARY MAIN ============
// Mechanism region above = lines 1..1503 of committed unified9_learn.zag
// (commit 09bd9b933), cmp-verified. This main() runs X-U9-1..X-U9-3.
// X-U9-4 (pristine regression) is executed at shell level.

// Build "s0,0,0>0,eff" for 10<=s0<=99, 0<=eff<=9 (10 chars).
fn adv_ep(s0:i32, eff:i32)[]u8 {
  let b:[]u8=z_alloc(16);
  let d10:i32=s0/10;
  let d1:i32=s0-d10*10;
  b[0]=(48+d10) as u8;
  b[1]=(48+d1) as u8;
  b[2]=44; b[3]=48; b[4]=44; b[5]=48; b[6]=62; b[7]=48; b[8]=44;
  b[9]=(48+eff) as u8;
  return b[0..10];
}

fn main()i32 {
  emit("=== H-UNIFIED9 red team adversary: X-U9-1 merit flooding, X-U9-2 quarantine resurrection, X-U9-3 birth-age expiration ===\n");
  let npass:i32=0;
  let ntest:i32=0;
  let dcount_start:i32=0;

  // ---- self-check: episode builder ----
  ntest=ntest+1;
  if(streq(adv_ep(72,1),"72,0,0>0,1")==1 && streq(adv_ep(60,7),"60,0,0>0,7")==1){
    emit("ADV-SELFCHECK adv_ep builds exact episode bytes PASS\n");npass=npass+1;
  } else {
    emit("ADV-SELFCHECK adv_ep FAIL\n");
  }

  // ============ X-U9-1: merit-flooding entrenchment ============
  emit("\n--- X-U9-1: 160 flooded queries entrench 16 junk rules, displace 16 honest ---\n");
  let W1:[]u8=z_alloc(65536);
  set32(W1, ST_STR(), STR0());
  dcount_start=get32(W1, DCOUNT());
  let f1:i32=handle_caus_learn(W1,"10,0,0>0,1;11,0,0>0,1");
  let f2:i32=handle_caus_learn(W1,"12,0,0>0,1;13,0,0>0,1");
  let f3:i32=handle_caus_learn(W1,"14,0,0>0,1;15,0,0>0,1");
  let f4:i32=handle_caus_learn(W1,"16,0,0>0,1;17,0,0>0,1");
  let f5:i32=handle_caus_learn(W1,"18,0,0>0,1;19,0,0>0,1");
  let f6:i32=handle_caus_learn(W1,"20,0,0>0,1;21,0,0>0,1");
  let f7:i32=handle_caus_learn(W1,"22,0,0>0,1;23,0,0>0,1");
  let f8:i32=handle_caus_learn(W1,"24,0,0>0,1;25,0,0>0,1");
  let e10:i32=get32(W1, ECOUNT());
  let d10:i32=get32(W1, DCOUNT());
  let q1:[]u8=z_alloc(2);
  let j:i32=0;
  let ovok:i32=1;
  while(j<16){
    let ov:i32=handle_caus_learn(W1, adv_ep(60+j,7));
    if(ov!=1){ ovok=0; }
    let fl:i32=0;
    while(fl<10){
      let qq:i32=cpredict(W1,CBASE(),60+j,0,0,q1);
      if(qq!=1){ ovok=0; }
      fl=fl+1;
    }
    j=j+1;
  }
  let e11:i32=get32(W1, ECOUNT());
  let d11:i32=get32(W1, DCOUNT());
  let hon:i32=0;
  let s:i32=10;
  while(s<26){ if(cpredict(W1,CBASE(),s,0,0,q1)==1){ hon=hon+1; } s=s+1; }
  let jnk:i32=0;
  s=60;
  while(s<76){ if(cpredict(W1,CBASE(),s,0,0,q1)==1){ jnk=jnk+1; } s=s+1; }
  ntest=ntest+1;
  if(ovok==1 && (e11-e10)==16 && (d11-d10)==0 && hon==0 && jnk==16 &&
     caus_active_count(W1,CBASE())==16 &&
     f1==2 && f8==2){
    emit("X-U9-1 flooded junk displaces 16/16 honest rules, 160 queries, 0 drops PASS\n");npass=npass+1;
  } else {
    emit("X-U9-1 FAIL ovok=");emit(i32s(ovok));
    emit(" edelta=");emit(i32s(e11-e10));
    emit(" ddelta=");emit(i32s(d11-d10));
    emit(" hon=");emit(i32s(hon));
    emit(" jnk=");emit(i32s(jnk));
    emit(" active=");emit(i32s(caus_active_count(W1,CBASE())));emit("\n");
  }

  // ============ X-U9-2: quarantine resurrection ============
  emit("\n--- X-U9-2: eviction resurrects a quarantined contradiction ---\n");
  let W2:[]u8=z_alloc(65536);
  set32(W2, ST_STR(), STR0());
  let q2:[]u8=z_alloc(2);
  let r1:i32=handle_caus_learn(W2,"5,0,0>0,1");
  let qc0:i32=get32(W2, QCOUNT());
  let r2:i32=handle_caus_learn(W2,"5,0,0>0,9");
  let qc1:i32=get32(W2, QCOUNT());
  let qkeep:i32=cpredict(W2,CBASE(),5,0,0,q2);
  let qkeeps1:i32=q2[1] as i32;
  let g1:i32=handle_caus_learn(W2,"10,0,0>0,1;11,0,0>0,1;12,0,0>0,1");
  let g2:i32=handle_caus_learn(W2,"13,0,0>0,1;14,0,0>0,1;15,0,0>0,1");
  let g3:i32=handle_caus_learn(W2,"16,0,0>0,1;17,0,0>0,1;18,0,0>0,1");
  let g4:i32=handle_caus_learn(W2,"19,0,0>0,1;20,0,0>0,1;21,0,0>0,1");
  let g5:i32=handle_caus_learn(W2,"22,0,0>0,1;23,0,0>0,1;24,0,0>0,1");
  // FIX (post-freeze fixture correction 1): the qkeep probe above raised R to
  // uses=1, which would break the all-uses=0 tie and spare R at step 4.
  // Equalize AFTER the fills: one query per junk slot so all 16 sit at uses=1.
  let eq:i32=10;
  let eqok:i32=1;
  while(eq<25){ if(cpredict(W2,CBASE(),eq,0,0,q2)!=1){ eqok=0; } eq=eq+1; }
  let e20:i32=get32(W2, ECOUNT());
  let r4:i32=handle_caus_learn(W2,"99,0,0>0,1");
  let e21:i32=get32(W2, ECOUNT());
  let qgone:i32=cpredict(W2,CBASE(),5,0,0,q2);
  let qnew:i32=cpredict(W2,CBASE(),99,0,0,q2);
  let qc2:i32=get32(W2, QCOUNT());
  let r5:i32=handle_caus_learn(W2,"5,0,0>0,9");
  let qc3:i32=get32(W2, QCOUNT());
  let qres:i32=cpredict(W2,CBASE(),5,0,0,q2);
  let qress1:i32=q2[1] as i32;
  ntest=ntest+1;
  if(r1==1 && r2==0 && (qc1-qc0)==1 && qkeep==1 && qkeeps1==1 &&
     g1==3 && g5==3 && eqok==1 && r4==1 && (e21-e20)==1 && qgone==0 && qnew==1 &&
     r5==1 && (qc3-qc2)==0 && qres==1 && qress1==9){
    emit("X-U9-2 quarantined contradiction committed as fresh rule after eviction PASS\n");npass=npass+1;
  } else {
    emit("X-U9-2 FAIL r1=");emit(i32s(r1));
    emit(" r2=");emit(i32s(r2));
    emit(" qdelta=");emit(i32s(qc1-qc0));
    emit(" qkeep=");emit(i32s(qkeep));
    emit(" r4=");emit(i32s(r4));
    emit(" edelta=");emit(i32s(e21-e20));
    emit(" qgone=");emit(i32s(qgone));
    emit(" r5=");emit(i32s(r5));
    emit(" qdelta2=");emit(i32s(qc3-qc2));
    emit(" qres=");emit(i32s(qres));
    emit(" qs1=");emit(i32s(qress1));emit("\n");
  }

  // ============ X-U9-3a: inversion (uses=100 old evicted ahead of uses=2 young) ============
  emit("\n--- X-U9-3a: uses=100 old rule evicted ahead of fifteen uses=2 young ---\n");
  let W3:[]u8=z_alloc(65536);
  set32(W3, ST_STR(), STR0());
  let q3:[]u8=z_alloc(2);
  let hg:i32=handle_caus_learn(W3,"10,0,0>0,1");
  let qi:i32=0;
  while(qi<100){ let qq3:i32=cpredict(W3,CBASE(),10,0,0,q3); qi=qi+1; }
  ntest=ntest+1;
  if(get32(W3,CSEQ())==1){
    emit("X-U9-3a query merit costs zero clock (CSEQ still 1 after 100 queries) PASS\n");npass=npass+1;
  } else {
    emit("X-U9-3a FAIL clock moved: ");emit(i32s(get32(W3,CSEQ())));emit("\n");
  }
  let j31:i32=handle_caus_learn(W3,"20,0,0>0,1;21,0,0>0,1;22,0,0>0,1");
  let j32:i32=handle_caus_learn(W3,"23,0,0>0,1;24,0,0>0,1;25,0,0>0,1");
  let j33:i32=handle_caus_learn(W3,"26,0,0>0,1;27,0,0>0,1;28,0,0>0,1");
  let j34:i32=handle_caus_learn(W3,"29,0,0>0,1;30,0,0>0,1;31,0,0>0,1");
  let j35:i32=handle_caus_learn(W3,"32,0,0>0,1;33,0,0>0,1;34,0,0>0,1");
  let a:i32=0;
  let aok:i32=1;
  while(a<33){
    let oa:i32=handle_caus_learn(W3, adv_ep(40+a,1));
    if(oa!=1){ aok=0; }
    let qa:i32=cpredict(W3,CBASE(),40+a,0,0,q3);
    if(qa!=1){ aok=0; }
    a=a+1;
  }
  // slot1 holds N(72); slots 2..15 hold N(41)..N(54): one more query each -> uses=2
  let qf1:i32=cpredict(W3,CBASE(),72,0,0,q3);
  let s3:i32=41;
  let qfok:i32=1;
  while(s3<55){
    let qqf:i32=cpredict(W3,CBASE(),s3,0,0,q3);
    if(qqf!=1){ qfok=0; }
    s3=s3+1;
  }
  let e30:i32=get32(W3, ECOUNT());
  let fin:i32=handle_caus_learn(W3,"99,0,0>0,1");
  let e31:i32=get32(W3, ECOUNT());
  let qgone3:i32=cpredict(W3,CBASE(),10,0,0,q3);
  let qnew3:i32=cpredict(W3,CBASE(),99,0,0,q3);
  ntest=ntest+1;
  if(aok==1 && hg==1 && qf1==1 && qfok==1 && fin==1 && (e31-e30)==1 &&
     qgone3==0 && qnew3==1 && caus_active_count(W3,CBASE())==16 &&
     j31==3 && j35==3){
    emit("X-U9-3a inversion: uses=100 G evicted ahead of 15 young uses=2 PASS\n");npass=npass+1;
  } else {
    emit("X-U9-3a FAIL aok=");emit(i32s(aok));
    emit(" hg=");emit(i32s(hg));
    emit(" fin=");emit(i32s(fin));
    emit(" edelta=");emit(i32s(e31-e30));
    emit(" qgone=");emit(i32s(qgone3));
    emit(" qnew=");emit(i32s(qnew3));
    emit(" active=");emit(i32s(caus_active_count(W3,CBASE())));emit("\n");
  }

  // ============ X-U9-3b: window edge [bseq, bseq+32) ============
  emit("\n--- X-U9-3b: protection flips exactly at CSEQ == bseq+32 ---\n");
  let W4:[]u8=z_alloc(65536);
  set32(W4, ST_STR(), STR0());
  let q4:[]u8=z_alloc(2);
  let b0:i32=handle_caus_learn(W4,"10,0,0>0,1");
  // FIX (post-freeze fixture correction 2): G needs uses=4 (not 2) so the
  // all-protected fallback at overfills #16/#17 evicts a uses=3 newcomer
  // (slot 1) instead of G. Newcomers stay at uses=3.
  let bc1:i32=handle_caus_learn(W4,"10,0,0>0,1");
  let bc2:i32=handle_caus_learn(W4,"10,0,0>0,1");
  let bc3:i32=handle_caus_learn(W4,"10,0,0>0,1");
  let bc4:i32=handle_caus_learn(W4,"10,0,0>0,1");
  let k41:i32=handle_caus_learn(W4,"20,0,0>0,1;21,0,0>0,1;22,0,0>0,1");
  let k42:i32=handle_caus_learn(W4,"23,0,0>0,1;24,0,0>0,1;25,0,0>0,1");
  let k43:i32=handle_caus_learn(W4,"26,0,0>0,1;27,0,0>0,1;28,0,0>0,1");
  let k44:i32=handle_caus_learn(W4,"29,0,0>0,1;30,0,0>0,1;31,0,0>0,1");
  let k45:i32=handle_caus_learn(W4,"32,0,0>0,1;33,0,0>0,1;34,0,0>0,1");
  let b:i32=0;
  let bok:i32=1;
  while(b<17){
    let ob:i32=handle_caus_learn(W4, adv_ep(40+b,1));
    if(ob!=1){ bok=0; }
    let qb1:i32=cpredict(W4,CBASE(),40+b,0,0,q4);
    let qb2:i32=cpredict(W4,CBASE(),40+b,0,0,q4);
    let qb3:i32=cpredict(W4,CBASE(),40+b,0,0,q4);
    if(qb1!=1 || qb2!=1 || qb3!=1){ bok=0; }
    b=b+1;
  }
  // after 17 overfills: clock=33; G (bseq=1, uses=2) protected at check=32, eligible at check=33
  let qg17:i32=cpredict(W4,CBASE(),10,0,0,q4);
  let qn55:i32=cpredict(W4,CBASE(),55,0,0,q4);
  let e40:i32=get32(W4, ECOUNT());
  let ob18:i32=handle_caus_learn(W4, adv_ep(57,1));
  let e41:i32=get32(W4, ECOUNT());
  let qg18:i32=cpredict(W4,CBASE(),10,0,0,q4);
  let qn57:i32=cpredict(W4,CBASE(),57,0,0,q4);
  ntest=ntest+1;
  if(bok==1 && b0==1 && bc1==0 && bc2==0 && bc3==0 && bc4==0 && k41==3 && k45==3 &&
     qg17==1 && qn55==0 && ob18==1 && (e41-e40)==1 && qg18==0 && qn57==1){
    emit("X-U9-3b edge: protected at check CSEQ=32, evicted at CSEQ=33 PASS\n");npass=npass+1;
  } else {
    emit("X-U9-3b FAIL bok=");emit(i32s(bok));
    emit(" b0=");emit(i32s(b0));
    emit(" qg17=");emit(i32s(qg17));
    emit(" qn55=");emit(i32s(qn55));
    emit(" ob18=");emit(i32s(ob18));
    emit(" edelta=");emit(i32s(e41-e40));
    emit(" qg18=");emit(i32s(qg18));
    emit(" qn57=");emit(i32s(qn57));emit("\n");
  }

  // ---- global kill-bar: no drop/refusal anywhere in this run ----
  ntest=ntest+1;
  let dcount_end:i32=get32(W1, DCOUNT())+get32(W2, DCOUNT())+get32(W3, DCOUNT())+get32(W4, DCOUNT());
  if(dcount_end==dcount_start){
    emit("ADV-GLOBAL zero drops/refusals across all attacks PASS\n");npass=npass+1;
  } else {
    emit("ADV-GLOBAL FAIL drops=");emit(i32s(dcount_end-dcount_start));emit("\n");
  }

  emit("\n=== ADV RESULT: ");emit(i32s(npass));emit("/");emit(i32s(ntest));emit(" ===\n");
  return 0;
}

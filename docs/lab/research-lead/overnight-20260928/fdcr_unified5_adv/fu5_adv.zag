  handle_concept_learn(WD,"T m1 | is_a | pet;T m1 | color | orange;T m2 | is_a | pet;T m2 | color | orange;T m3 | is_a | pet;T m3 | color | orange;T m4 | is_a | pet;T m4 | color | orange;T m5 | is_a | pet;T m5 | color | orange;T m6 | is_a | pet;T m6 | color | orange;T m7 | is_a | pet;T m7 | color | orange;T m8 | is_a | pet;T m8 | color | orange");
  emit("D pre-merge: count=");emit(i32s(con_count(WD)));emit("\n");

  if(con_count(WD)==1 && con_active(WD,1)==0 && con_nmem(WD,1)==0 && con_nfeat(WD,1)==0 && con_vote_concept(WD,"m1")==0 && con_find_member_str(WD,"m1")==-1 && noadd_drop_total(WD)==0){
    emit("D-merge PASS\n");
  } else {
    emit("D-merge FAIL\n");
  }

  handle_concept_learn(WD,"T n1 | size | big");
  let dfeat:[]u8=con_str_at(WD, con_feat(WD,1,0));
  emit("D reuse: c1active=");emit(i32s(con_active(WD,1)));
  emit(" c1nfeat=");emit(i32s(con_nfeat(WD,1)));
  emit(" c1nmem=");emit(i32s(con_nmem(WD,1)));
  emit(" n1member=");emit(i32s(con_find_member_str(WD,"n1")));
  emit(" feat0=");emit(dfeat);emit("\n");
  if(con_active(WD,1)==1 && con_nfeat(WD,1)==1 && con_nmem(WD,1)==1 && con_find_member_str(WD,"n1")==1 && streq(dfeat,"size=big")==1){
    emit("D-reuse PASS\n");
  } else {
    emit("D-reuse FAIL\n");
  }

  handle_concept_learn(WD,"T n2 | size | big");
  let dp:i32=handle_proc_learn_unified(WD,"n1>1n;n2>2n");
  let dpcon:i32=-99;
  if(dp>=0 && dp<1000){dpcon=get32(WD, intent_proc_base(WD,dp)+8);}
  if(dp>=1000){dpcon=get32(WD, intent_br_base(WD,dp-1000)+8);}
  if(dpcon==1){emit("D-vote train_con=1 PASS\n");}else{emit("D-vote train_con=");emit(i32s(dpcon));emit(" FAIL (expected 1)\n");}

  handle_concept_learn(WD,"T z1 | is_a | pet;T z1 | color | orange");
  if(con_vote_concept(WD,"z1")==0){emit("D-match z1vote=0 PASS\n");}else{emit("D-match z1vote=");emit(i32s(con_vote_concept(WD,"z1")));emit(" FAIL (expected 0)\n");}

  emit("\n=== FU5-ADV done ===\n");
  return 0;
}

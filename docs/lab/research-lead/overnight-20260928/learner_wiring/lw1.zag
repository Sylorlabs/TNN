// lw1.zag : LW1 learner self-wiring experiment.
// Tests whether the learner creates the WIRING from its learned knowledge
// into its own judgment (generation) path, with zero researcher bridges.
// Pure Zag. Zero RNG. All data literal. Deterministic.
// Build: znc lw1.zag -o lw1_bin --no-analyze
// Run: ./lw1_bin base | bridge | selfwire | noeval | nowrite
// Output: single preallocated buffer, one raw syscall write. No _zag_print.

// ---------- local allocator on _zag_malloc (zeroed u8 buffer) ----------
fn lw_alloc(n:i64)[]u8{
    if(n<1){ return ""; }
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){ return ""; }
    let b:[]u8=p[0..n];
    let i:i64=0;
    while(i<n){ b[i]=0; i=i+1; }
    return b;
}

// ---------- byte helpers: little-endian i64 cells in u8 buffers ----------
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}

// ---------- single-buffer emit helpers (cursor-returning) ----------
fn e1str(b:[]u8,c:i64,s:[]u8)i64{
    let i:i64=0;
    let n:i64=s.len as i64;
    while(i<n){ b[c+i]=s[i]; i=i+1; }
    return c+n;
}
fn e1i64(b:[]u8,c:i64,v:i64)i64{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){ neg=1; x=0-x; }
    let n:i64=0;
    let t:i64=x;
    if(t==0){ n=1; } else { while(t>0){ n=n+1; t=t/10; } }
    let p:i64=c+neg+n-1;
    t=x;
    if(t==0){ b[p]=48; } else { while(t>0){ b[p]=((t%10)+48) as u8; p=p-1; t=t/10; } }
    if(neg==1){ b[c]=45; }
    return c+neg+n;
}

// ---------- data loading: ascii digit literals -> values 0..3 ----------
fn load4(dst:[]u8,dat:[]u8,n:i64)void{
    let i:i64=0;
    let m:i64=n*4;
    while(i<m){ dst[i]=((dat[i] as i64)-48) as u8; i=i+1; }
}
fn load1(dst:[]u8,dat:[]u8,n:i64)void{
    let i:i64=0;
    while(i<n){ dst[i]=((dat[i] as i64)-48) as u8; i=i+1; }
}

// ---------- world helper: max symbol count in a 4-symbol string ----------
fn maxcount(s:[]u8,at:i64)i64{
    let c0:i64=0;
    let c1:i64=0;
    let c2:i64=0;
    let c3:i64=0;
    let i:i64=0;
    while(i<4){
        let v:i64=s[at+i] as i64;
        if(v==0){ c0=c0+1; } else { if(v==1){ c1=c1+1; } else { if(v==2){ c2=c2+1; } else { c3=c3+1; } } }
        i=i+1;
    }
    let m:i64=c0;
    if(c1>m){ m=c1; }
    if(c2>m){ m=c2; }
    if(c3>m){ m=c3; }
    return m;
}

// ---------- hypothesis kind 1 = MAXCOUNT(k): reject iff maxcount > k ----------
fn hyp_reject(hkind:i64,hparam:i64,s:[]u8,at:i64)i64{
    if(hkind==1){
        if(maxcount(s,at)>hparam){ return 1; }
        return 0;
    }
    return 0;
}

// ---------- Occam selection over k=1..3: first k separating TRAIN ----------
fn occam(str:[]u8,lab:[]u8,n:i64)i64{
    let k:i64=1;
    while(k<=3){
        let ok:i64=1;
        let i:i64=0;
        while(i<n){
            let rej:i64=hyp_reject(1,k,str,i*4);
            let want:i64=0;
            if(lab[i]==0){ want=1; }
            if(rej!=want){ ok=0; }
            i=i+1;
        }
        if(ok==1){ return k; }
        k=k+1;
    }
    return 0;
}

// ---------- judge: the generation path. 1=ACCEPT, 0=REJECT ----------
// bridge=1: researcher consults hyp slot 0 directly (control condition).
// bridge=0: only the learner-owned consultation list is read.
fn judge(s:[]u8,at:i64,consult:[]u8,cn:i64,hyp:[]u8,bridge:i64)i64{
    if(bridge==1){
        if(hyp_reject(get64(hyp,0),get64(hyp,8),s,at)==1){ return 0; }
        return 1;
    }
    let i:i64=0;
    while(i<cn){
        let hid:i64=get64(consult,i*8);
        if(hid>=0){
            if(hyp_reject(get64(hyp,hid*24),get64(hyp,hid*24+8),s,at)==1){ return 0; }
        }
        i=i+1;
    }
    return 1;
}

// ---------- learner-owned evaluation over VALID (world labels = experience) ----------
fn selftest(vstr:[]u8,vlab:[]u8,vn:i64,consult:[]u8,cn:i64,hyp:[]u8,en:i64)i64{
    if(en==0){ return -1; }
    let c:i64=0;
    let i:i64=0;
    while(i<vn){
        let v:i64=judge(vstr,i*4,consult,cn,hyp,0);
        if(v==(vlab[i] as i64)){ c=c+1; }
        i=i+1;
    }
    return c;
}

// ---------- wiring actions on the consultation list ----------
fn wire(consult:[]u8,cn:i64,hid:i64,writable:i64)i64{
    if(writable==0){ return cn; }
    if(cn>=4){ return cn; }
    put64(consult,cn*8,hid);
    return cn+1;
}
fn unwire(consult:[]u8)i64{
    let i:i64=0;
    while(i<4){ put64(consult,i*8,-1); i=i+1; }
    return 0;
}

fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let cond:i64=-1;
    if(_zag_strcmp(a1,"base")==1){ cond=0; }
    if(_zag_strcmp(a1,"bridge")==1){ cond=1; }
    if(_zag_strcmp(a1,"selfwire")==1){ cond=2; }
    if(_zag_strcmp(a1,"noeval")==1){ cond=3; }
    if(_zag_strcmp(a1,"nowrite")==1){ cond=4; }
    let out:[]u8=lw_alloc(512);
    let c:i64=0;
    if(cond<0){
        c=e1str(out,c,"LW1|error=bad-cond|use=base|bridge|selfwire|noeval|nowrite\n");
        let w0:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(out) as i64),c,0,0,0);
        if(w0<0){ return 3; }
        return 2;
    }
    // data: all literals (see PREREG section 3)
    let tstr:[]u8=lw_alloc(48);
    let tlab:[]u8=lw_alloc(12);
    let vstr:[]u8=lw_alloc(24);
    let vlab:[]u8=lw_alloc(6);
    let sstr:[]u8=lw_alloc(24);
    let slab:[]u8=lw_alloc(6);
    load4(tstr,"012301320213102312032013001211032231332001012323",12);
    load1(tlab,"111111000000",12);
    load4(vstr,"230130123012001122021313",6);
    load1(vlab,"111000",6);
    load4(sstr,"032110322103000112213133",6);
    load1(slab,"111000",6);
    // learner state: hypothesis store = 4 records x 24B [kind,param,valid];
    // consultation list = 4 slots x 8B, init empty (-1).
    let hyp:[]u8=lw_alloc(96);
    let consult:[]u8=lw_alloc(32);
    let cn:i64=unwire(consult);
    // acquire content: Occam selection over TRAIN
    let k:i64=occam(tstr,tlab,12);
    let hfound:i64=0;
    if(k>0){
        hfound=1;
        put64(hyp,0,1);
        put64(hyp,8,k);
        put64(hyp,16,1);
    }
    // policy by condition
    let acc0:i64=-2;
    let acc1:i64=-2;
    let kept:i64=0;
    let bridge:i64=0;
    if(cond==1){ bridge=1; }
    if(cond==2){
        acc0=selftest(vstr,vlab,6,consult,cn,hyp,1);
        cn=wire(consult,cn,0,1);
        acc1=selftest(vstr,vlab,6,consult,cn,hyp,1);
        if(acc1>acc0){ if(acc1>=0){ kept=1; } }
        if(kept==0){ cn=unwire(consult); }
    }
    if(cond==3){
        acc0=selftest(vstr,vlab,6,consult,cn,hyp,0);
        cn=wire(consult,cn,0,1);
        acc1=selftest(vstr,vlab,6,consult,cn,hyp,0);
        if(acc1>acc0){ if(acc1>=0){ kept=1; } }
        if(kept==0){ cn=unwire(consult); }
    }
    if(cond==4){
        acc0=selftest(vstr,vlab,6,consult,cn,hyp,1);
        cn=wire(consult,cn,0,0);
        acc1=selftest(vstr,vlab,6,consult,cn,hyp,1);
        if(acc1>acc0){ if(acc1>=0){ kept=1; } }
        if(kept==0){ cn=unwire(consult); }
    }
    // final held-out TEST scoring (harness; learner never saw TEST labels)
    let tc:i64=0;
    let i:i64=0;
    while(i<6){
        let v:i64=judge(sstr,i*4,consult,cn,hyp,bridge);
        if(v==(slab[i] as i64)){ tc=tc+1; }
        i=i+1;
    }
    let c0v:i64=get64(consult,0);
    // report: one buffer, one syscall
    let cnd:[]u8="base";
    if(cond==1){ cnd="bridge"; }
    if(cond==2){ cnd="selfwire"; }
    if(cond==3){ cnd="noeval"; }
    if(cond==4){ cnd="nowrite"; }
    c=e1str(out,c,"LW1|cond=");
    c=e1str(out,c,cnd);
    c=e1str(out,c,"\nLW1|hyp_found=");
    c=e1i64(out,c,hfound);
    c=e1str(out,c,"|hyp_kind=1|hyp_param=");
    c=e1i64(out,c,k);
    c=e1str(out,c,"\nLW1|acc0=");
    c=e1i64(out,c,acc0);
    c=e1str(out,c,"|acc1=");
    c=e1i64(out,c,acc1);
    c=e1str(out,c,"|kept=");
    c=e1i64(out,c,kept);
    c=e1str(out,c,"|consult_n=");
    c=e1i64(out,c,cn);
    c=e1str(out,c,"|consult0=");
    c=e1i64(out,c,c0v);
    c=e1str(out,c,"|bridge=");
    c=e1i64(out,c,bridge);
    c=e1str(out,c,"\nLW1|test_correct=");
    c=e1i64(out,c,tc);
    c=e1str(out,c,"|test_n=6\n");
    let w1:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(out) as i64),c,0,0,0);
    if(w1!=c){ return 4; }
    return 0;
}

// mf_floor.zag -- C603 "MAXIMALLY-GENEROUS EXIT-SLOT".
//
// Implements PREREG.md (commit 1a82de5f6). The hypothesis under test is
// NEGATIVE: that even with a researcher-supplied, maximally general
// learner-writable exit-condition interface, the emittable form set F is
// finite and enumerable from source, so the result is L2 at best.
//
// Frozen emittable form set, declared in the prereg BEFORE this file existed:
//     F = B  x  {R0,R1,R2,R3}  x  {LT,EQ,GT,LE,GE}  x  Z
//   B   : body over the frozen basis, length 0..1 searched here. |B| is a
//         SEARCH BOUND only; the FORM is (body,src,cmp,thr) at any |B|.
//   src : 4    cmp : 5    thr : a learned integer VALUE slot
// Basis (frozen; the C281 / isa.zag alphabet verbatim):
//   0=CPY(Rd=Rs) 1=ADD(Rd+=Rs) 2=MUL(Rd*=Rs) 3=SET1(Rd=1) 4=INC(Rd+=1)
//   5=STEP(Rd=w_step(Rd))     world primitive; without it the loop is inert
// Registers R0..R3, i32. Instruction = (op,d,s), 3 bytes.
//
// Fixtures (prereg sec.4, frozen literals, no RNG):
//   world   w_step(x) = min(x+1,64);  LIM = 64
//   train   x0 = 61,59,56,51  -> trip counts  3, 5, 8,13
//   holdout x0 = 47,35,20,3   -> trip counts 17,29,44,61
//   The two trip-count bands are DISJOINT, so no memorised trip-count
//   constant can transfer.
//
// Internal evaluation (prereg sec.5): the learner's success criterion is
// agreement with the terminal register state the learner computes ITSELF by
// running the body to quiescence. No world_truth, no label table, no
// hand-listed training triple, no expected-value function on the selection
// path. Free abstention: adopt only if every train episode is solved; ties
// broken by first-in-enumeration-order (disclosed).
//
// Implementation discipline, both forced by observed host behaviour:
//   * the candidate space is ONE flat index; no nested enumeration loops;
//   * no '&&' or '||' inside while() conditions (a && in a while() condition
//     was observed to mis-evaluate here); control flow uses if() and
//     force-terminated counters.
// Output: _zag_print / _zag_println ONLY. Never _zag_raw_syscall (brief 4.0).

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_str(b:[]u8,c:i32,s:[]u8)i32 { return o_app(b,c,s); }
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn LIM()i32 { return 64; }
fn w_step(x:i32)i32 {
  let v:i32=x+1;
  if(v>LIM()){ return LIM(); }
  return v;
}
fn w2_step(x:i32)i32 { return (x*2+1)%97; }

fn exec_instr(r:[]u8,op:i32,d:i32,s:i32)void {
  let rs:i32=get32(r,s*4);
  let dv:i32=get32(r,d*4);
  let nv:i32=dv;
  if(op==0){ nv=rs; }
  else { if(op==1){ nv=dv+rs; } else { if(op==2){ nv=dv*rs; }
         else { if(op==3){ nv=1; } else { if(op==4){ nv=dv+1; } else { nv=w_step(dv); } } } } }
  set32(r,d*4,nv);
  return;
}
fn cmpi(op:i32,v:i32,t:i32)i32 {
  if(op==0){ if(v<t){ return 1; } return 0; }
  if(op==1){ if(v==t){ return 1; } return 0; }
  if(op==2){ if(v>t){ return 1; } return 0; }
  if(op==3){ if(v<=t){ return 1; } return 0; }
  if(op==4){ if(v>=t){ return 1; } return 0; }
  return 0;
}
fn cmp_name(op:i32,b:[]u8,c:i32)i32 {
  if(op==0){ return o_str(b,c,"LT"); }
  if(op==1){ return o_str(b,c,"EQ"); }
  if(op==2){ return o_str(b,c,"GT"); }
  if(op==3){ return o_str(b,c,"LE"); }
  return o_str(b,c,"GE");
}

fn n_train()i32 { return 4; }
fn ep_x0(i:i32)i32 {
  if(i==0){ return 61; }
  if(i==1){ return 59; }
  if(i==2){ return 56; }
  if(i==3){ return 51; }
  if(i==4){ return 47; }
  if(i==5){ return 35; }
  if(i==6){ return 20; }
  return 3;
}
fn n_thr()i32 { return 6; }
fn thr_at(i:i32)i32 {
  if(i==0){ return 0; }
  if(i==1){ return 13; }
  if(i==2){ return 61; }
  if(i==3){ return 63; }
  if(i==4){ return 64; }
  return 65;
}
fn trip(x0:i32)i32 {
  let x:i32=x0; let k:i32=0;
  while(k<300){
    if(x>=LIM()){ return k; }
    x=w_step(x); k=k+1;
  }
  return k;
}
// body id 0 = empty body; 1..96 = one instruction. id-1 = op*16 + d*4 + s,
// written as the three bytes runm reads: body[0]=op, body[1]=d, body[2]=s.
fn body_put(id:i32,body:[]u8)i32 {
  if(id==0){ return 0; }
  let v:i32=id-1;
  body[0]=(v/16) as u8;
  body[1]=((v%16)/4) as u8;
  body[2]=(v%4) as u8;
  return 1;
}

// ---- terminal state under the learner's own quiescence run.
// out[0] = terminal R0.
fn quiesce(body:[]u8,bl:i32,x0:i32,out:[]u8)void {
  let r:[]u8=z_alloc(16);
  let pv:[]u8=z_alloc(16);
  set32(r,0,x0); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  set32(pv,0,x0); set32(pv,4,0); set32(pv,8,0); set32(pv,12,0);
  let k:i32=0;
  let ch:i32=1;
  while(k<300){
    if(ch==0){ set32(out,0,get32(r,0)); return; }
    let i:i32=0;
    while(i<bl){
      exec_instr(r,body[i*3] as i32,body[i*3+1] as i32,body[i*3+2] as i32);
      i=i+1;
    }
    k=k+1;
    ch=0;
    let q:i32=0;
    while(q<4){
      if(get32(r,q*4)!=get32(pv,q*4)){ ch=1; }
      set32(pv,q*4,get32(r,q*4));
      q=q+1;
    }
  }
  set32(out,0,get32(r,0));
  return;
}

// ---- run the emitted macro. noloop=1 -> body once.
// out[0]=final R0  out[16]=iterations  out[20]=fired
fn runm(body:[]u8,bl:i32,src:i32,cmp:i32,thr:i32,x0:i32,noloop:i32,out:[]u8)void {
  let r:[]u8=z_alloc(16);
  set32(r,0,x0); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  let k:i32=0;
  let fired:i32=0;
  while(k<300){
    let i:i32=0;
    while(i<bl){
      exec_instr(r,body[i*3] as i32,body[i*3+1] as i32,body[i*3+2] as i32);
      i=i+1;
    }
    k=k+1;
    if(noloop==1){ fired=1; break; }
    if(cmpi(cmp,get32(r,src*4),thr)==1){ fired=1; break; }
  }
  set32(out,0,get32(r,0));
  set32(out,16,k);
  set32(out,20,fired);
  return;
}

// ---- does this macro solve episode e under the internal criterion?
// Scalar return: slice-returning helpers were observed to return garbage on
// this compiler (see AMENDMENT-2), so every helper here returns an i32.
fn ep_ok(body:[]u8,bl:i32,src:i32,cmp:i32,thr:i32,e:i32,noloop:i32)i32 {
  let q:[]u8=z_alloc(32);
  let w:[]u8=z_alloc(32);
  quiesce(body,bl,ep_x0(e),w);
  runm(body,bl,src,cmp,thr,ep_x0(e),noloop,q);
  let r:i32=0;
  if(get32(q,20)==1){ r=1; }
  if(get32(q,0)!=get32(w,0)){ r=0; }
  return r;
}
// iterations the macro spends on episode e
fn ep_k(body:[]u8,bl:i32,src:i32,cmp:i32,thr:i32,e:i32,noloop:i32)i32 {
  let q:[]u8=z_alloc(32);
  runm(body,bl,src,cmp,thr,ep_x0(e),noloop,q);
  return get32(q,16);
}

// ---- the frozen core's own loop rule: change-driven quiescence, pass CAP 16
// (c8_learn.zag:1003,1030). Returns 1 iff final R0 == the learner's target.
fn core_ok(body:[]u8,bl:i32,e:i32)i32 {
  let w:[]u8=z_alloc(32);
  quiesce(body,bl,ep_x0(e),w);
  let r:[]u8=z_alloc(16);
  let pv:[]u8=z_alloc(16);
  set32(r,0,ep_x0(e)); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  let pass:i32=0;
  let running:i32=1;
  while(running==1){
    if(pass>=16){ running=0; }
    if(running==1){
      let q2:i32=0;
      while(q2<4){ set32(pv,q2*4,get32(r,q2*4)); q2=q2+1; }
      let i:i32=0;
      while(i<bl){
        exec_instr(r,body[i*3] as i32,body[i*3+1] as i32,body[i*3+2] as i32);
        i=i+1;
      }
      pass=pass+1;
      let ch:i32=0;
      q2=0;
      while(q2<4){
        if(get32(r,q2*4)!=get32(pv,q2*4)){ ch=1; }
        q2=q2+1;
      }
      if(ch==0){ running=0; }
    }
  }
  let res:i32=0;
  if(get32(r,0)==get32(w,0)){ res=1; }
  return res;
}

fn main()i32 {
  let OB:[]u8=z_alloc(24000);
  let c:i32=0;
  let body:[]u8=z_alloc(16);
  let i:i32=0;
  let j:i32=0;

  _zag_println("C603 MACRO-FLOOR: maximally-generous exit-slot instantiation");
  _zag_println("PREREG 1a82de5f6 | KB1 SUF / KB2 decide-from-literals / KB3 load-bearing / KB4 slot / S-P5");

  // ---------------- [1] SUF test
  c=0;
  c=o_str(OB,c,"\n[1] SUF TEST -- emittable form set, enumerated from this source\n");
  c=o_str(OB,c,"   F = B x {R0,R1,R2,R3} x {LT,EQ,GT,LE,GE} x Z\n");
  c=o_str(OB,c,"   |exit SHAPES|       = 4 x 5 = 20\n");
  c=o_str(OB,c,"   thr is a VALUE slot over Z: unbounded, but not a form\n");
  c=o_str(OB,c,"   |B| searched        = 97   (bodies of length 0..1)\n");
  c=o_str(OB,c,"   |candidates walked| = 97 x 4 x 5 x 6 = 11640\n");
  c=o_str(OB,c,"   KB1: a reader CAN write F in one line -> ENUMERABLE -> NOT L3.\n");
  c=o_str(OB,c,"   Declared PRE-REGISTERED, not discovered after the fact.\n");
  o_flush(OB,c);

  // ---------------- [2] fixture
  let disj:i32=1;
  c=0;
  c=o_str(OB,c,"\n[2] FIXTURE (frozen literals; w_step(x)=min(x+1,64))\n");
  c=o_str(OB,c,"   ep split  x0  trip\n");
  i=0;
  while(i<8){
    c=o_str(OB,c,"   "); c=o_i64(OB,c,i as i64); c=o_sp(OB,c);
    if(i<n_train()){ c=o_str(OB,c,"train "); } else { c=o_str(OB,c,"hold  "); }
    c=o_sp(OB,c); c=o_i64(OB,c,ep_x0(i) as i64); c=o_sp(OB,c);
    c=o_i64(OB,c,trip(ep_x0(i)) as i64); c=o_nl(OB,c);
    i=i+1;
  }
  i=0;
  while(i<4){
    j=0;
    while(j<4){
      if(trip(ep_x0(i))==trip(ep_x0(4+j))){ disj=0; }
      j=j+1;
    }
    i=i+1;
  }
  c=o_str(OB,c,"   train trip band 3,5,8,13  holdout trip band 17,29,44,61\n");
  c=o_str(OB,c,"   bands DISJOINT: ");
  if(disj==1){ c=o_str(OB,c,"YES -> a memorised trip-count constant CANNOT transfer\n"); }
  else { c=o_str(OB,c,"NO -> FIXTURE VOID, no result claimed\n"); }
  o_flush(OB,c);

  // ---------------- [3] flat candidate walk
  // idx = body*120 + src*30 + cmp*6 + thrpos
  let ufound:i32=0; let uidx:i32=0; let uk:i32=0;
  let afound:i32=0; let aidx:i32=0; let ak:i32=0;
  let nsol:i32=0; let aidx2:i32=0; let nafter:i32=0; let namend:i32=0;
  let idx:i32=0;
  while(idx<11640){
    let bidx:i32=idx/120;
    let r1:i32=idx-(bidx*120);
    let sidx:i32=r1/30;
    let r2:i32=r1-(sidx*30);
    let cidx:i32=r2/6;
    let tidx:i32=r2-(cidx*6);
    let bl:i32=body_put(bidx,body);
    let th:i32=thr_at(tidx);
    let ok:i32=1;
    let it:i32=0;
    i=0;
    while(i<4){
      if(ep_ok(body,bl,sidx,cidx,th,i,0)==0){ ok=0; }
      if(i==3){ it=ep_k(body,bl,sidx,cidx,th,i,0); }
      i=i+1;
    }
    if(ok==1){
      nsol=nsol+1;
      if(ufound==0){ ufound=1; uidx=idx; uk=it; }
      if(it>1){
        namend=namend+1;
        if(afound==0){ afound=1; aidx=idx; ak=it; }
        else { if(nafter==0){ aidx2=idx; nafter=1; } }
      }
    }
    idx=idx+1;
  }

  let abody:i32=aidx/120;
  let ar1:i32=aidx-(abody*120);
  let asrc:i32=ar1/30;
  let ar2:i32=ar1-(asrc*30);
  let acmp:i32=ar2/6;
  let athr:i32=thr_at(ar2-(acmp*6));
  let abl:i32=body_put(abody,body);

  c=0;
  c=o_str(OB,c,"\n[3] LEARNER SEARCH over 11640 candidates (flat, no nesting)\n");
  c=o_str(OB,c,"   internal criterion: match own quiescent terminal state; free abstention\n");
  c=o_str(OB,c,"   3a UNAMENDED criterion (exactly as preregistered):\n     ");
  if(ufound==0){ c=o_str(OB,c,"ABSTAIN\n"); } else {
    c=o_str(OB,c,"src=R"); c=o_i64(OB,c,(uidx/30%4) as i64); c=o_sp(OB,c);
    c=cmp_name((uidx%120)/6,OB,c); c=o_sp(OB,c);
    c=o_str(OB,c,"thr="); c=o_i64(OB,c,thr_at(uidx%6) as i64); c=o_sp(OB,c);
    c=o_str(OB,c,"body_id="); c=o_i64(OB,c,(uidx/120) as i64); c=o_sp(OB,c);
    c=o_str(OB,c,"iters="); c=o_i64(OB,c,uk as i64); c=o_nl(OB,c);
  }
  c=o_str(OB,c,"   3b AMENDED criterion (AMENDMENT-1: require iters>=2, i.e. it must iterate):\n     ");
  if(afound==0){ c=o_str(OB,c,"ABSTAIN\n"); } else {
    c=o_str(OB,c,"src=R"); c=o_i64(OB,c,asrc as i64); c=o_sp(OB,c);
    c=cmp_name(acmp,OB,c); c=o_sp(OB,c);
    c=o_str(OB,c,"thr="); c=o_i64(OB,c,athr as i64); c=o_sp(OB,c);
    c=o_str(OB,c,"body_id="); c=o_i64(OB,c,abody as i64); c=o_sp(OB,c);
    c=o_str(OB,c,"iters="); c=o_i64(OB,c,ak as i64); c=o_nl(OB,c);
  }
  c=o_str(OB,c,"   VACUITY DEFECT V1: the UNAMENDED criterion is satisfied by a do-nothing\n");
  c=o_str(OB,c,"   macro (empty body, exit fires at k=1, target==x0 trivially). This is a\n");
  c=o_str(OB,c,"   finding about the criterion, reported rather than hidden.\n");
  c=o_str(OB,c,"   candidates satisfying the amended criterion: ");
  c=o_i64(OB,c,namend as i64); c=o_str(OB,c," of 11640 walked\n");
  c=o_str(OB,c,"   next admissible macro: src=R");
  c=o_i64(OB,c,((aidx2/30)%4) as i64); c=o_sp(OB,c);
  c=cmp_name((aidx2%120)/6,OB,c); c=o_sp(OB,c);
  c=o_str(OB,c,"thr="); c=o_i64(OB,c,thr_at(aidx2%6) as i64); c=o_sp(OB,c);
  c=o_str(OB,c,"body_id="); c=o_i64(OB,c,(aidx2/120) as i64); c=o_nl(OB,c);
  o_flush(OB,c);

  // ---------------- [4] ablations
  let ft:i32=0; let fh:i32=0;
  let ct:i32=0; let ch:i32=0;
  let lt:i32=0; let lh:i32=0;
  i=0;
  while(i<8){
    if(ep_ok(body,abl,asrc,acmp,athr,i,0)==1){
      if(i<4){ ft=ft+1; } else { fh=fh+1; }
    }
    i=i+1;
  }
  i=0;
  while(i<8){
    if(core_ok(body,abl,i)==1){
      if(i<4){ ct=ct+1; } else { ch=ch+1; }
    }
    i=i+1;
  }
  i=0;
  while(i<8){
    if(ep_ok(body,abl,asrc,acmp,athr,i,1)==1){
      if(i<4){ lt=lt+1; } else { lh=lh+1; }
    }
    i=i+1;
  }
  c=0;
  c=o_str(OB,c,"\n[4] ABLATIONS (axis 1: load-bearingness)\n");
  c=o_str(OB,c,"   arm           train/4  hold/4  total/8\n");
  c=o_str(OB,c,"   A-FULL           "); c=o_i64(OB,c,ft as i64); c=o_sp(OB,c);
  c=o_i64(OB,c,fh as i64); c=o_sp(OB,c); c=o_i64(OB,c,(ft+fh) as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   A-NOSLOT         "); c=o_i64(OB,c,ct as i64); c=o_sp(OB,c);
  c=o_i64(OB,c,ch as i64); c=o_sp(OB,c); c=o_i64(OB,c,(ct+ch) as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   A-NOLOOP         "); c=o_i64(OB,c,lt as i64); c=o_sp(OB,c);
  c=o_i64(OB,c,lh as i64); c=o_sp(OB,c); c=o_i64(OB,c,(lt+lh) as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   A-NOSLOT is the frozen core's OWN rule: change-driven quiescence with the\n");
  c=o_str(OB,c,"   researcher's pass CAP 16 (c8_learn.zag:1003,1030). The adopted macro needs\n");
  c=o_str(OB,c,"   "); c=o_i64(OB,c,ak as i64);
  c=o_str(OB,c," iterations on episode 3, so the cap-16 rule truncates it. The learned\n");
  c=o_str(OB,c,"   exit buys exactly the iterations the researcher's cap forbids.\n");
  c=o_str(OB,c,"   heldout drop A-FULL -> A-NOLOOP: ");
  c=o_i64(OB,c,fh as i64); c=o_str(OB,c," -> "); c=o_i64(OB,c,lh as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   KB3 load-bearing: ");
  if(fh>0){ c=o_str(OB,c,"HOLDS (the loop carries capability)\n"); }
  else { c=o_str(OB,c,"FAILS (loop inert -> chain link 'pressure' is VACUOUS)\n"); }
  c=o_str(OB,c,"   KB4 slot-matters: ");
  if(ch<fh){ c=o_str(OB,c,"HOLDS (learned exit beats the frozen cap-16 rule)\n"); }
  else { c=o_str(OB,c,"FAILS (the exit slot carries nothing)\n"); }
  o_flush(OB,c);

  // ---------------- [5] decide-from-literals
  // Two deductions, each from literals that appear in THIS file, never calling
  // the learner:
  //   body_id 80 = op5 STEP R0 : an additive saturating register attains the
  //     terminal value LIM=64, first attained at the unique correct exit
  //     -> (R0, EQ, 64).
  //   body_id 17 = op1 ADD R0,R0 : doubling any odd i32 reaches 0 exactly at
  //     the 32nd doubling because 32 = width(i32) and odd*2^32 == 0 (mod 2^32)
  //     -> (R0, EQ, 0).
  let dsrc:i32=0; let dcmp:i32=-1; let dthr:i32=0; let dnote:i32=0;
  if(abody==80){ dcmp=1; dthr=64; dnote=1; }
  if(abody==17){ dcmp=1; dthr=0; dnote=2; }
  let same:i32=0;
  if(afound==1){
    if(asrc==dsrc){
      if(acmp==dcmp){
        if(athr==dthr){ same=1; }
      }
    }
  }
  c=0;
  c=o_str(OB,c,"\n[5] KB2 DECIDE-FROM-LITERALS (never calls the learner)\n");
  c=o_str(OB,c,"   adopted body_id="); c=o_i64(OB,c,abody as i64); c=o_sp(OB,c);
  c=o_str(OB,c,"(op="); c=o_i64(OB,c,((abody-1)/16) as i64);
  c=o_str(OB,c," d="); c=o_i64(OB,c,(((abody-1)%16)/4) as i64);
  c=o_str(OB,c," s="); c=o_i64(OB,c,((abody-1)%4) as i64); c=o_str(OB,c,")\n");
  c=o_str(OB,c,"   DEDUCTED from literals alone: src=R0 ");
  if(dnote==1){ c=o_str(OB,c,"EQ thr=64  [additive saturating register attains LIM]\n"); }
  else { if(dnote==2){ c=o_str(OB,c,"EQ thr=0  [odd*2^32 == 0 mod 2^32 at the 32nd doubling]\n"); }
         else { c=o_str(OB,c,"(no deduction available)\n"); } }
  c=o_str(OB,c,"   learner emitted: src=R"); c=o_i64(OB,c,asrc as i64); c=o_sp(OB,c);
  c=cmp_name(acmp,OB,c); c=o_sp(OB,c); c=o_str(OB,c,"thr=");
  c=o_i64(OB,c,athr as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   REPRODUCED WITHOUT THE LEARNER: ");
  if(same==1){ c=o_str(OB,c,"YES -> KB2 HOLDS -> the structural choice is decided by literals\n"); }
  else { c=o_str(OB,c,"NO -> not decidable from literals alone\n"); }
  o_flush(OB,c);

  // ---------------- [6] expressiveness bound
  // world2 w2_step(x)=(2x+1) mod 97 from x0=1. The correct exit is CYCLE
  // ENTRY (the register returns to 1). A (src,cmp,thr) exit fires on a FIRST
  // CROSSING. Count the declared exits whose first crossing coincides with
  // cycle entry.
  let v:i32=1;
  let period:i32=0;
  let guard:i32=0;
  while(guard<300){
    v=w2_step(v);
    guard=guard+1;
    if(v==1){ period=guard; break; }
  }
  let ns:i32=0;
  let nt:i32=0;
  let sx:i32=0;
  while(sx<4){
    let cp:i32=0;
    while(cp<5){
      let tp:i32=0;
      while(tp<6){
        nt=nt+1;
        let r:[]u8=z_alloc(16);
        set32(r,0,1); set32(r,4,0); set32(r,8,0); set32(r,12,0);
        let kk:i32=0;
        let first:i32=-1;
        while(kk<300){
          if(cmpi(cp,get32(r,sx*4),thr_at(tp))==1){ first=kk; break; }
          set32(r,0,w2_step(get32(r,0)));
          kk=kk+1;
        }
        if(first==period){ ns=ns+1; }
        tp=tp+1;
      }
      cp=cp+1;
    }
    sx=sx+1;
  }
  c=0;
  c=o_str(OB,c,"\n[6] EXPRESSIVENESS BOUND on the declared template\n");
  c=o_str(OB,c,"   world2 w2_step(x)=(2x+1) mod 97 from x0=1; cycle-entry period = ");
  c=o_i64(OB,c,period as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   exits in the declared space tried: "); c=o_i64(OB,c,nt as i64);
  c=o_sp(OB,c); c=o_str(OB,c,"first-crossing == cycle-entry: "); c=o_i64(OB,c,ns as i64); c=o_nl(OB,c);
  c=o_str(OB,c,"   A (src,cmp,thr) exit fires on a FIRST CROSSING. Cycle entry is not a\n");
  c=o_str(OB,c,"   crossing. Any exit counted above coincides by accident of this one world,\n");
  c=o_str(OB,c,"   not because it expresses the cycle. F is enumerable AND too weak.\n");
  o_flush(OB,c);

  // ---------------- [7] verdict
  c=0;
  c=o_str(OB,c,"\n[7] VERDICT\n");
  c=o_str(OB,c,"   KB1 SUF enumerable       : HOLDS -> NOT L3\n");
  c=o_str(OB,c,"   KB2 decide-from-literals : ");
  if(same==1){ c=o_str(OB,c,"HOLDS -> DEAD as an L3 claim\n"); }
  else { c=o_str(OB,c,"FAILS\n"); }
  c=o_str(OB,c,"   axis 1 load-bearingness  : the loop IS load-bearing (see [4])\n");
  c=o_str(OB,c,"   axis 2 source-underdet.  : the loop is NOT source-underdetermined\n");
  c=o_str(OB,c,"   CLASS = L2. NOT L3. The two axes are independent.\n");
  o_flush(OB,c);
  return 0;
}
// pz_desc.zag -- PROPERTY-ZAG layout descriptors for the invariant battery.
//
// The battery (pz_bat.zag) is LAYOUT-GENERIC. All knowledge of any particular
// arena lives in a descriptor block: an i32 header plus two bitmaps plus a
// conditional reference rule table. Another lane points the battery at its own
// arena by building a descriptor; it does not modify the battery.
//
// DESCRIPTOR BLOCK LAYOUT (byte offsets, all i32 cells)
//   0  D_NOLO     first node index
//   4  D_NCAP     node capacity (indices D_NOLO .. D_NCAP-1)
//   8  D_NOFF     byte offset of node record for index 0
//  12  D_NSZ      node record size in bytes
//  16  D_EOFF     byte offset of edge record 0
//  20  D_ESZ      edge record size in bytes
//  24  D_ECAP     edge capacity
//  28  D_ASZ      arena size in bytes
//  32  D_LCNT     header cell holding the live-node count (-1 if absent)
//  36  D_SENT     edge free sentinel
//  40  D_FBASE    frame operand base (operands >= base are frame slots)
//  44  D_FSAFE    number of frame slots that stay inside the node table
//  48  D_ECNT     header cell holding the live-edge count (-1 if absent)
//  52  D_ALIVE    node field index of the liveness flag
//  56  D_TAGF     node field index of the tag
//  60  D_EVCAP    provenance/event log capacity (0 if the concept is absent)
//  64  D_EVCUR    header cell holding the event log cursor (-1 if absent)
//  68  D_NRULE    number of conditional reference rules
//  72  D_REFTBL   byte offset of the rule table
//  76  D_NFIELD   i32 fields per node record
//  80  D_SEQK     sequence edge kind
//  84  D_MODE     1 = node/edge arena, 0 = degenerate record arena
//  88  D_VF0      first value field index
//  92  D_NVF      count of value fields
//  96  D_DEP      provenance edge kind (0 if the concept is absent)
// 100  D_LEARN    tag marking learned structure that must carry provenance
// 104  D_DREC     record capacity of the caller's REC buffer
// 108  D_MXEX     per-code exemplar cap in the text report
// 112  D_TAGSET   32 i32 cells, bitmap of legal node tags (1024 bits)
// 244  D_KSET     32 i32 cells, bitmap of legal edge kinds (1024 bits)
// 180  D_RF0      first node field index eligible for the frame-operand scans
// 184  D_RF1      last node field index eligible for the frame-operand scans
// 176  D_RESV     reserved low node indices excluded from the live-count
//                 comparison (tnn2 reserves node 0 and node 1 as header cells,
//                 marked alive by tnn2_init but not counted in the header)
// 512  rule table, 16 bytes per rule: [tag, field, kind, flag]
//        tag = -1 means "applies to every live node"

fn PZ_D_NOLO()i32 { return 0; }
fn PZ_D_NCAP()i32 { return 4; }
fn PZ_D_NOFF()i32 { return 8; }
fn PZ_D_NSZ()i32 { return 12; }
fn PZ_D_EOFF()i32 { return 16; }
fn PZ_D_ESZ()i32 { return 20; }
fn PZ_D_ECAP()i32 { return 24; }
fn PZ_D_ASZ()i32 { return 28; }
fn PZ_D_LCNT()i32 { return 32; }
fn PZ_D_SENT()i32 { return 36; }
fn PZ_D_FBASE()i32 { return 40; }
fn PZ_D_FSAFE()i32 { return 44; }
fn PZ_D_ECNT()i32 { return 48; }
fn PZ_D_ALIVE()i32 { return 52; }
fn PZ_D_TAGF()i32 { return 56; }
fn PZ_D_EVCAP()i32 { return 60; }
fn PZ_D_EVCUR()i32 { return 64; }
fn PZ_D_NRULE()i32 { return 68; }
fn PZ_D_REFTBL()i32 { return 72; }
fn PZ_D_NFIELD()i32 { return 76; }
fn PZ_D_SEQK()i32 { return 80; }
fn PZ_D_MODE()i32 { return 84; }
fn PZ_D_VF0()i32 { return 88; }
fn PZ_D_NVF()i32 { return 92; }
fn PZ_D_DEP()i32 { return 96; }
fn PZ_D_LEARN()i32 { return 100; }
fn PZ_D_DREC()i32 { return 104; }
fn PZ_D_MXEX()i32 { return 108; }
fn PZ_D_TAGSET()i32 { return 112; }
fn PZ_D_KSET()i32 { return 244; }
fn PZ_D_RESV()i32 { return 176; }
fn PZ_D_RF0()i32 { return 180; }
fn PZ_D_RF1()i32 { return 184; }
fn PZ_D_BEQ()i32 { return 188; }
fn PZ_D_ROOTF()i32 { return 192; }
fn PZ_D_TRUEF()i32 { return 196; }
fn PZ_D_FALSEF()i32 { return 200; }
fn PZ_D_RULES()i32 { return 512; }

// rule kinds
fn PZ_K_OPAQUE()i32 { return 0; }
fn PZ_K_FRAME()i32 { return 1; }
fn PZ_K_OPFRAME()i32 { return 2; }
fn PZ_K_NODE()i32 { return 3; }
// rule flags
fn PZ_F_ALIAS()i32 { return 1; }

// ------------------------------------------------------- bitmap helpers
fn pz_tset(D:[]u8,v:i32)void {
  if(v<0){ return; }
  if(v>1023){ return; }
  let w:i32=(PZ_D_TAGSET()/4)+(v>>5);
  pz_set(D,w*4,pz_get(D,w*4)|(1<<(v&31)));
  return;
}
fn pz_tget(D:[]u8,v:i32)i32 {
  if(v<0){ return 0; }
  if(v>1023){ return 0; }
  let w:i32=(PZ_D_TAGSET()/4)+(v>>5);
  return (pz_get(D,w*4)>>(v&31))&1;
}
fn pz_kset(D:[]u8,v:i32)void {
  if(v<0){ return; }
  if(v>1023){ return; }
  let w:i32=(PZ_D_KSET()/4)+(v>>5);
  pz_set(D,w*4,pz_get(D,w*4)|(1<<(v&31)));
  return;
}
fn pz_kget(D:[]u8,v:i32)i32 {
  if(v<0){ return 0; }
  if(v>1023){ return 0; }
  let w:i32=(PZ_D_KSET()/4)+(v>>5);
  return (pz_get(D,w*4)>>(v&31))&1;
}

// ------------------------------------------------------------ rule table
fn pz_rule(D:[]u8,i:i32,tag:i32,field:i32,kind:i32,flag:i32)void {
  let o:i32=PZ_D_RULES()+i*16;
  pz_set(D,o,tag); pz_set(D,o+4,field); pz_set(D,o+8,kind); pz_set(D,o+12,flag);
  return;
}
fn pz_rtag(D:[]u8,i:i32)i32 { return pz_get(D,PZ_D_RULES()+i*16); }
fn pz_rfld(D:[]u8,i:i32)i32 { return pz_get(D,PZ_D_RULES()+i*16+4); }
fn pz_rknd(D:[]u8,i:i32)i32 { return pz_get(D,PZ_D_RULES()+i*16+8); }
fn pz_rflg(D:[]u8,i:i32)i32 { return pz_get(D,PZ_D_RULES()+i*16+12); }

// ------------------------------------------------------------ constructors
// PZ_D_TAGS_TNN2 is the legal node-tag set observed across the frozen source,
// unioned with the declared T_*/OP_* constants of the core.
fn pz_tags_tnn2(D:[]u8)void {
  pz_tset(D,0); pz_tset(D,1); pz_tset(D,2); pz_tset(D,3); pz_tset(D,4);
  pz_tset(D,8); pz_tset(D,20); pz_tset(D,21); pz_tset(D,30);
  pz_tset(D,101); pz_tset(D,102); pz_tset(D,103); pz_tset(D,104);
  pz_tset(D,900); pz_tset(D,901); pz_tset(D,902); pz_tset(D,903);
  pz_tset(D,999);
  return;
}
fn pz_kinds_tnn2(D:[]u8)void {
  let i:i32=1;
  while(i<=13){ pz_kset(D,i); i=i+1; }
  return;
}
// descriptor for compression_exec/tnn2_frozen_ref.zag
fn pz_desc_tnn2()[]u8 {
  let D:[]u8=pz_alloc(1024);
  pz_set(D,PZ_D_NOLO(),0);      pz_set(D,PZ_D_NCAP(),1024);
  pz_set(D,PZ_D_NOFF(),64);     pz_set(D,PZ_D_NSZ(),40);
  pz_set(D,PZ_D_EOFF(),41024);  pz_set(D,PZ_D_ESZ(),16);
  pz_set(D,PZ_D_ECAP(),4096);   pz_set(D,PZ_D_ASZ(),110656);
  pz_set(D,PZ_D_LCNT(),20);     pz_set(D,PZ_D_SENT(),-1);
  pz_set(D,PZ_D_FBASE(),1000);  pz_set(D,PZ_D_FSAFE(),24);
  pz_set(D,PZ_D_ECNT(),24);     pz_set(D,PZ_D_ALIVE(),9);
  pz_set(D,PZ_D_TAGF(),0);      pz_set(D,PZ_D_EVCAP(),128);
  pz_set(D,PZ_D_EVCUR(),28);    pz_set(D,PZ_D_NRULE(),10);
  pz_set(D,PZ_D_REFTBL(),PZ_D_RULES());
  pz_set(D,PZ_D_NFIELD(),10);   pz_set(D,PZ_D_SEQK(),12);
  pz_set(D,PZ_D_MODE(),1);      pz_set(D,PZ_D_VF0(),5);
  pz_set(D,PZ_D_NVF(),4);       pz_set(D,PZ_D_DEP(),1);
  pz_set(D,PZ_D_LEARN(),20);    pz_set(D,PZ_D_DREC(),192);
  pz_set(D,PZ_D_MXEX(),3);      pz_set(D,PZ_D_RESV(),2);
  pz_set(D,PZ_D_RF0(),1);       pz_set(D,PZ_D_RF1(),2);
  pz_set(D,PZ_D_BEQ(),102);      pz_set(D,PZ_D_ROOTF(),5);
  pz_set(D,PZ_D_TRUEF(),3);      pz_set(D,PZ_D_FALSEF(),4);
  pz_tags_tnn2(D); pz_kinds_tnn2(D);
  pz_rule(D,0,101,1,PZ_K_FRAME(),PZ_F_ALIAS());
  pz_rule(D,1,101,2,PZ_K_OPFRAME(),PZ_F_ALIAS());
  pz_rule(D,2,103,1,PZ_K_FRAME(),PZ_F_ALIAS());
  pz_rule(D,3,104,1,PZ_K_FRAME(),PZ_F_ALIAS());
  pz_rule(D,4,102,1,PZ_K_OPFRAME(),PZ_F_ALIAS());
  pz_rule(D,5,102,2,PZ_K_OPFRAME(),PZ_F_ALIAS());
  pz_rule(D,6,102,3,PZ_K_NODE(),0);
  pz_rule(D,7,102,4,PZ_K_NODE(),0);
  pz_rule(D,8,902,1,PZ_K_OPFRAME(),PZ_F_ALIAS());
  pz_rule(D,9,-1,1,PZ_K_OPFRAME(),PZ_F_ALIAS());
  return D;
}
// descriptor for cogops_rescueaware/c15_base.zag fact store A
// (header cell 0 = fact count, records 12B at 4+j*12, capacity 128).
fn pz_desc_c15()[]u8 {
  let D:[]u8=pz_alloc(1024);
  pz_set(D,PZ_D_NOLO(),0);      pz_set(D,PZ_D_NCAP(),128);
  pz_set(D,PZ_D_NOFF(),4);      pz_set(D,PZ_D_NSZ(),12);
  pz_set(D,PZ_D_EOFF(),0);      pz_set(D,PZ_D_ESZ(),0);
  pz_set(D,PZ_D_ECAP(),0);      pz_set(D,PZ_D_ASZ(),4096);
  pz_set(D,PZ_D_LCNT(),0);      pz_set(D,PZ_D_SENT(),-1);
  pz_set(D,PZ_D_FBASE(),0);     pz_set(D,PZ_D_FSAFE(),0);
  pz_set(D,PZ_D_ECNT(),-1);     pz_set(D,PZ_D_ALIVE(),2);
  pz_set(D,PZ_D_TAGF(),1);      pz_set(D,PZ_D_EVCAP(),0);
  pz_set(D,PZ_D_EVCUR(),-1);    pz_set(D,PZ_D_NRULE(),0);
  pz_set(D,PZ_D_REFTBL(),PZ_D_RULES());
  pz_set(D,PZ_D_NFIELD(),3);    pz_set(D,PZ_D_SEQK(),-1);
  pz_set(D,PZ_D_MODE(),0);      pz_set(D,PZ_D_VF0(),0);
  pz_set(D,PZ_D_NVF(),3);       pz_set(D,PZ_D_DEP(),0);
  pz_set(D,PZ_D_LEARN(),-1);    pz_set(D,PZ_D_DREC(),192);
  pz_set(D,PZ_D_MXEX(),3);      pz_set(D,PZ_D_RESV(),0);
  pz_set(D,PZ_D_RF0(),0);       pz_set(D,PZ_D_RF1(),2);
  pz_set(D,PZ_D_BEQ(),-1);       pz_set(D,PZ_D_ROOTF(),-1);
  pz_set(D,PZ_D_TRUEF(),-1);     pz_set(D,PZ_D_FALSEF(),-1);
  return D;
}
// pz_act.zag -- PROPERTY-ZAG error containment, quarantine and repair.
//
// Charter 113: one malformed learned structure must not corrupt the whole
// learner. Required behaviour: DETECT, CONTAIN, REPAIR-OR-QUARANTINE,
// CONTINUE, with EXPLICIT DIAGNOSTICS. Never merely crash, never hide.
//
// CLASSIFICATION, stated in the output of every action so the boundary is
// auditable:
//   SYS-REPAIR   generic runtime machinery with no knowledge of what the
//                structures MEAN: header counter reconciliation, dead edge
//                neutralisation, edge-ledger compaction, tombstoning.
//   COG-REPAIR   would require deciding that a structure is WRONG and forming
//                a replacement. That is learner-owned. This module NEVER does
//                it. If containment makes a structure unusable, the honest
//                outcome is "no answer", not a substitute answer.
//
// Public API:
//   k = pz_act(W,D,REC,SC,TXT)    apply containment to the last pz_scan REC
//   pz_quarantine(W,D,n)          tombstone one node and its incident edges
//   pz_rebuild_counts(W,D)        recompute header counters from the tables

fn PZ_POISON()i32 { return 1023; }

// ------------------------------------------------------ SYS-REPAIR pieces
fn pz_rebuild_counts(W:[]u8,D:[]u8)void {
  let mode:i32=pz_get(D,PZ_D_MODE());
  if(mode==0){ return; }
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let resv:i32=pz_get(D,PZ_D_RESV());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let n:i32=resv;
  let tot:i32=0;
  while(n<nc){
    if(pz_n(W,D,n,al)==1){ tot=tot+1; }
    n=n+1;
  }
  pz_set(W,pz_get(D,PZ_D_LCNT()),tot);
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let e:i32=0;
  let et:i32=0;
  while(e<ec){
    if(pz_ew(W,D,e,0)!=sent){ et=et+1; }
    e=e+1;
  }
  pz_set(W,pz_get(D,PZ_D_ECNT()),et);
  return;
}
// Neutralise one edge: free the slot and keep the header ledger honest.
fn pz_kill_edge_at(W:[]u8,D:[]u8,e:i32)void {
  let sent:i32=pz_get(D,PZ_D_SENT());
  if(pz_ew(W,D,e,0)==sent){ return; }
  pz_eset(W,D,e,0,sent);
  pz_eset(W,D,e,1,0); pz_eset(W,D,e,2,sent); pz_eset(W,D,e,3,0);
  return;
}
// Quarantine one node: tombstone it and free every edge incident on it.
// This mirrors the frozen core's own eviction edge sweep, so containment keeps
// the arena's own ledger invariants true.
fn pz_quarantine(W:[]u8,D:[]u8,n:i32)void {
  let al:i32=pz_get(D,PZ_D_ALIVE());
  if(pz_n(W,D,n,al)==0){ return; }
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let e:i32=0;
  while(e<ec){
    let f:i32=pz_ew(W,D,e,0);
    if(f!=pz_get(D,PZ_D_SENT())){
      if(f==n){ pz_kill_edge_at(W,D,e); }
      else { if(pz_ew(W,D,e,2)==n){ pz_kill_edge_at(W,D,e); } }
    }
    e=e+1;
  }
  pz_nset(W,D,n,al,0);
  pz_nset(W,D,n,pz_get(D,PZ_D_TAGF()),PZ_POISON());
  pz_rebuild_counts(W,D);
  return;
}

// ------------------------------------------------------------- the driver
// Walks the records produced by the last pz_scan and applies the policy for
// each code. Returns the number of containment actions taken.
fn pz_act(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8,TXT:[]u8)i32 {
  let nrec:i32=pz_get(SC,8);
  let acts:i32=0;
  let r:i32=0;
  while(r<nrec){
    let code:i32=pz_get(REC,r*16);
    let a:i32=pz_get(REC,r*16+4);
    let b:i32=pz_get(REC,r*16+8);
    let c:i32=pz_get(REC,r*16+12);
    if(a!=-1 && a!=-2){
      pz_do1(W,D,REC,SC,TXT,code,a,b,c);
      acts=acts+1;
    }
    else {
      let m:i32=pz_do_meta(W,D,REC,SC,TXT,code,a,b,c);
      acts=acts+m;
    }
    r=r+1;
  }
  pz_rebuild_counts(W,D);
  return acts;
}
// Metadata-shaped violation: a whole-arena statement, not one index.
fn pz_do_meta(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8,TXT:[]u8,code:i32,a:i32,b:i32,c:i32)i32 {
  let acts:i32=0;
  pz_e(SC,TXT,"  ACT code=");
  pz_ei(SC,TXT,code);
  pz_e(SC,TXT," class=");
  if(code==9){
    pz_e(SC,TXT,"NOT-REPAIRABLE-ENCODING (namespace collision is an encoding defect, not a state defect)");
  }
  if(code==10){
    pz_e(SC,TXT,"NOT-REPAIRABLE-LAYOUT (record tables overlap by construction)");
  }
  if(code==13){
    pz_e(SC,TXT,"NOT-REPAIRABLE-BY-INDEX (provenance closure gap, reported per owner)");
  }
  if(code==11 && a==-2){
    pz_e(SC,TXT,"SYS-REPORT-ONLY (edge table saturated; next allocation fails silently, no structural change)");
  }
  if(code==4 && a==-2){
    pz_e(SC,TXT,"NOT-REPAIRABLE-LOSSY (provenance log saturated; writes already dropped)");
  }
  if(code==1 && a==-1){
    pz_e(SC,TXT,"SYS-REPAIR (header live-count reconciled from liveness flags)");
    acts=1;
  }
  if(code==11 && a==-1){
    pz_e(SC,TXT,"SYS-REPAIR (header edge-count reconciled from the edge table)");
    acts=1;
  }
  pz_e(SC,TXT," a="); pz_ei(SC,TXT,a);
  pz_e(SC,TXT," b="); pz_ei(SC,TXT,b);
  pz_e(SC,TXT," c="); pz_ei(SC,TXT,c);
  pz_enl(SC,TXT);
  return acts;
}
// Indexed violation: quarantine the offending structure.
fn pz_do1(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8,TXT:[]u8,code:i32,a:i32,b:i32,c:i32)void {
  let mode:i32=pz_get(D,PZ_D_MODE());
  pz_e(SC,TXT,"  ACT code=");
  pz_ei(SC,TXT,code);
  pz_e(SC,TXT," ");
  pz_e(SC,TXT,pz_cname(code));
  pz_e(SC,TXT," idx="); pz_ei(SC,TXT,a);
  if(mode==0){
    // record-mode arena: physically drop the malformed record by compacting
    // the tail down one slot and decrementing the count. The record is not
    // rewritten, because rewriting would hide the corruption.
    let n:i32=pz_get(W,pz_get(D,PZ_D_LCNT()));
    let j:i32=a;
    while(j+1<n){
      pz_nset(W,D,j,0,pz_n(W,D,j+1,0));
      pz_nset(W,D,j,1,pz_n(W,D,j+1,1));
      pz_nset(W,D,j,2,pz_n(W,D,j+1,2));
      j=j+1;
    }
    pz_set(W,pz_get(D,PZ_D_LCNT()),n-1);
    pz_e(SC,TXT," action=DROP-RECORD(idx="); pz_ei(SC,TXT,a);
    pz_e(SC,TXT," bad-field="); pz_ei(SC,TXT,b);
    pz_e(SC,TXT,") class=SYS-REPAIR (record compacted out, count decremented, no value invented)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==1){
    // illegal liveness flag: normalise, then reconcile the header
    let al:i32=pz_get(D,PZ_D_ALIVE());
    let v:i32=pz_n(W,D,a,al);
    let nv:i32=0;
    if(v!=0){ nv=1; }
    pz_nset(W,D,a,al,nv);
    pz_e(SC,TXT," action=NORMALISE-FLAG("); pz_ei(SC,TXT,v);
    pz_e(SC,TXT,"->"); pz_ei(SC,TXT,nv);
    pz_e(SC,TXT,") class=SYS-REPAIR");
    pz_enl(SC,TXT);
    return;
  }
  if(code==2){
    pz_kill_edge_at(W,D,a);
    pz_e(SC,TXT," action=KILL-EDGE(from="); pz_ei(SC,TXT,b);
    pz_e(SC,TXT," to="); pz_ei(SC,TXT,c);
    pz_e(SC,TXT,") class=SYS-REPAIR (edge neutralised, slot freed, ledger reconciled)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==5){
    pz_kill_edge_at(W,D,a);
    pz_e(SC,TXT," action=KILL-EDGE(kind="); pz_ei(SC,TXT,b);
    pz_e(SC,TXT,") class=SYS-REPAIR (impossible edge kind cannot be interpreted, edge neutralised)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==9 && b==1){
    // literal-band collision: the index is simultaneously a node id and a
    // frame slot encoding. Quarantine it so it cannot be mistaken for a
    // literal again. The ENCODING defect itself is not repairable here.
    pz_quarantine(W,D,a);
    pz_e(SC,TXT," action=QUARANTINE(idx="); pz_ei(SC,TXT,a);
    pz_e(SC,TXT," band=[1000,1024)) class=SYS-REPAIR (literal unreachable through res_op; node removed from the id space)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==9){
    pz_e(SC,TXT," action=REPORT-ONLY class=NOT-REPAIRABLE-ENCODING (frame slot decodes to node index outside the node table)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==13){
    pz_quarantine(W,D,a);
    pz_e(SC,TXT," action=QUARANTINE owner="); pz_ei(SC,TXT,a);
    pz_e(SC,TXT," closure-facts="); pz_ei(SC,TXT,b);
    pz_e(SC,TXT," owner-facts="); pz_ei(SC,TXT,c);
    pz_e(SC,TXT," class=SYS-REPAIR (the owner licenses facts its program can no longer reach; the structure loses its licence, it is NOT replaced, honest outcome NO ANSWER)");
    pz_enl(SC,TXT);
    return;
  }
  if(code==3 || code==4 || code==6 || code==7 || code==8){
    pz_quarantine(W,D,a);
    pz_e(SC,TXT," action=QUARANTINE node="); pz_ei(SC,TXT,a);
    pz_e(SC,TXT," val="); pz_ei(SC,TXT,b);
    pz_e(SC,TXT," class=SYS-REPAIR (structurally invalid structure tombstoned; NOT replaced, the honest outcome is NO ANSWER)");
    pz_enl(SC,TXT);
    return;
  }
  pz_e(SC,TXT," action=NONE");
  pz_enl(SC,TXT);
  return;
}
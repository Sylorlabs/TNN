// pz_meta.zag -- PROPERTY-ZAG metamorphic transforms (charter 164).
//
// Transformations that MUST preserve answers:
//   M1 ENTITY-RENAMING      bijection on entity ids (subject and object)
//   M2 OBSERVATION-REORDER  permute the order of facts; order is irrelevant
//   M3 IRRELEVANT-DISTRACTOR append facts on fresh relations, fresh entities
//   M4 EQUIVALENT-RE-ENCODE bijection on relation ids
//
// If behaviour changes under any of these, that is a HIDDEN DEPENDENCY and
// is reported, never suppressed. The transforms live here so that every lane
// can reuse the same definitions.

fn pz_meta_rename(A:[]u8,P:[]u8,off:i32,n:i32)[]u8 {
  let nf:i32=pz_get(A,0);
  let j:i32=0;
  while(j<nf){
    let s:i32=pz_get(A,4+j*12);
    let o:i32=pz_get(A,4+j*12+8);
    pz_set(A,4+j*12,pz_get(P,off+s*4));
    pz_set(A,4+j*12+8,pz_get(P,off+o*4));
    j=j+1;
  }
  return A;
}
fn pz_meta_rerel(A:[]u8,P:[]u8,off:i32)[]u8 {
  let nf:i32=pz_get(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=pz_get(A,4+j*12+4);
    pz_set(A,4+j*12+4,pz_get(P,off+r*4));
    j=j+1;
  }
  return A;
}
// Add nd facts on relations the query never mentions, over entities the query
// never mentions. A conformant learner must be indifferent to them.
fn pz_meta_distract(A:[]u8,S:[]u8,nd:i32,relbase:i32,entbase:i32)[]u8 {
  let t:i32=0;
  while(t<nd){
    let r:i32=relbase+(t%4);
    let s:i32=entbase+pz_rnd(S,16);
    let o:i32=entbase+16+pz_rnd(S,16);
    pz_fact(A,s,r,o);
    t=t+1;
  }
  return A;
}
fn pz_meta_copy(A:[]u8,B:[]u8)[]u8 {
  let i:i32=0;
  while(i<4096){ B[i]=A[i]; i=i+1; }
  return B;
}
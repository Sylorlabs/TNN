// exp_pz_meta.zag -- PROPERTY-ZAG metamorphic arm (charter 164).
// Concatenated after z2_core (tnn2_frozen_ref.zag, renamed) + pz_* library.
//
// Transformations that MUST preserve answers. Any behaviour change is a
// HIDDEN DEPENDENCY and is reported, never suppressed.
//   M1 ENTITY-RENAMING        bijection on entity ids
//   M2 OBSERVATION-REORDER    permutation of the order facts are taught
//   M3 IRRELEVANT-DISTRACTOR  facts on fresh relations and fresh entities
//   M4 EQUIVALENT-RE-ENCODE   bijection on relation ids
//
// Seed schedule (PREREG section 4): permutations seeds 301..331, orderings
// seeds 401..431, distractor-load seeds 201..215.
//
// Boundary, stated: the engine is driven through ev_query, which supplies the
// target. These arms therefore test the STRUCTURE machinery (assembly,
// verification, promotion, reuse), not the miss policy.

fn pz_reset2(W:[]u8)void {
  let i:i32=0;
  while(i<110656){ W[i]=0; i=i+1; }
  let e:i32=0;
  while(e<4096){ es(W,e,0,-1); e=e+1; }
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,0); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  return;
}
// teach the frozen 3-link chain, in the order given by ord[0..2] which holds
// fact indices into the canonical fact table
fn teach_ord(W:[]u8,fs:[]u8,ordv:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){
    let k:i32=pz_get(ordv,i*4);
    ev_teach(W,pz_get(fs,k*12),pz_get(fs,k*12+4),pz_get(fs,k*12+8));
    i=i+1;
  }
  return;
}
fn pz_hline3(SC:[]u8,TXT:[]u8,s:[]u8)void { pz_e(SC,TXT,s); pz_enl(SC,TXT); return; }

fn main()i32 {
  let TXT:[]u8=pz_alloc(262144);
  let SC:[]u8=pz_alloc(256);
  let S:[]u8=pz_alloc(8);
  let W:[]u8=pz_alloc(110656);
  let D:[]u8=pz_desc_tnn2();
  let WK:[]u8=pz_alloc(32768);
  let REC:[]u8=pz_alloc(3072);
  let P:[]u8=pz_alloc(8192);
  let R:[]u8=pz_alloc(8192);
  let ORDV:[]u8=pz_alloc(64);
  let FS:[]u8=pz_alloc(256);
  pz_beg(SC);
  pz_hline3(SC,TXT,"PZ-META metamorphic arm on the tnn2 engine");

  // canonical world: a 3-link chain, entities 1001..1004, relation 11,
  // goal relation 77, target 1004
  pz_set(FS,0,1001); pz_set(FS,4,11); pz_set(FS,8,1002);
  pz_set(FS,12,1002); pz_set(FS,16,11); pz_set(FS,20,1003);
  pz_set(FS,24,1003); pz_set(FS,28,11); pz_set(FS,32,1004);

  // ---------------------------------------------------------- baseline
  pz_reset2(W);
  pz_set(ORDV,0,0); pz_set(ORDV,4,1); pz_set(ORDV,8,2);
  teach_ord(W,FS,ORDV,3);
  let base:i32=ev_query(W,1001,77,1004,0);
  pz_e(SC,TXT,"BASE answer="); pz_ei(SC,TXT,base);
  pz_e(SC,TXT," violations="); pz_ei(SC,TXT,pz_scan(W,D,WK,REC,TXT,SC));
  pz_enl(SC,TXT);

  // ------------------------------------------ M1 ENTITY-RENAMING, 31 seeds
  pz_hline3(SC,TXT,"=== M1 ENTITY-RENAMING, seeds 301..331 ===");
  let s:i32=301;
  let bad:i32=0;
  let runs:i32=0;
  let eff:i32=0;
  while(s<=331){
    pz_stream(S,301,s-300);
    pz_gen_perm(S,P,0,1200);
    pz_reset2(W);
    let i:i32=0;
    while(i<3){
      let a:i32=pz_get(P,1001*4);
      let r:i32=11;
      let b:i32=0;
      b=pz_get(P,1002*4);
      if(i==1){ a=pz_get(P,1002*4); b=pz_get(P,1003*4); }
      if(i==2){ a=pz_get(P,1003*4); b=pz_get(P,1004*4); }
      ev_teach(W,a,r,b);
      i=i+1;
    }
    let q:i32=pz_get(P,1001*4);
    let want:i32=pz_get(P,1004*4);
    if(q!=1001){ eff=eff+1; }
    let got:i32=ev_query(W,q,77,want,0);
    runs=runs+1;
    if(got!=want){ bad=bad+1; }
    s=s+1;
  }
  pz_e(SC,TXT,"M1 runs="); pz_ei(SC,TXT,runs);
  pz_e(SC,TXT," non-identity-renames="); pz_ei(SC,TXT,eff);
  pz_e(SC,TXT," hidden-dependency-violations="); pz_ei(SC,TXT,bad);
  pz_e(SC,TXT," K8=");
  if(bad==0){ pz_e(SC,TXT,"PASS"); } else { pz_e(SC,TXT,"HIDDEN-DEPENDENCY"); }
  pz_enl(SC,TXT);

  // --------------------------------------- M2 OBSERVATION-REORDER, 31 seeds
  pz_hline3(SC,TXT,"=== M2 OBSERVATION-REORDER, seeds 401..431 ===");
  s=401;
  bad=0;
  runs=0;
  eff=0;
  while(s<=431){
    pz_stream(S,401,s-400);
    pz_reset2(W);
    pz_gen_perm(S,P,0,3);
    let i:i32=0;
    while(i<3){
      pz_set(ORDV,i*4,pz_get(P,i*4));
      i=i+1;
    }
    if(pz_get(ORDV,0)!=0){ eff=eff+1; }
    teach_ord(W,FS,ORDV,3);
    let got:i32=ev_query(W,1001,77,1004,0);
    runs=runs+1;
    if(got!=1004){ bad=bad+1; }
    s=s+1;
  }
  pz_e(SC,TXT,"M2 runs="); pz_ei(SC,TXT,runs);
  pz_e(SC,TXT," non-identity-orderings="); pz_ei(SC,TXT,eff);
  pz_e(SC,TXT," hidden-dependency-violations="); pz_ei(SC,TXT,bad);
  pz_e(SC,TXT," K8=");
  if(bad==0){ pz_e(SC,TXT,"PASS"); } else { pz_e(SC,TXT,"HIDDEN-DEPENDENCY"); }
  pz_enl(SC,TXT);

  // ------------------------------------ M3 IRRELEVANT-DISTRACTOR, 15 seeds
  pz_hline3(SC,TXT,"=== M3 IRRELEVANT-DISTRACTOR, seeds 201..215 ===");
  s=201;
  bad=0;
  runs=0;
  eff=0;
  while(s<=215){
    pz_stream(S,201,s-200);
    pz_reset2(W);
    pz_set(ORDV,0,0); pz_set(ORDV,4,1); pz_set(ORDV,8,2);
    teach_ord(W,FS,ORDV,3);
    let nd:i32=2+pz_rnd(S,30);
    nd=nd+nd;
    let i:i32=0;
    while(i<nd){
      let dr:i32=900+pz_rnd(S,16);
      let ds:i32=3000+pz_rnd(S,200);
      let dob:i32=5000+pz_rnd(S,200);
      ev_teach(W,ds,dr,dob);
      i=i+1;
    }
    let got:i32=ev_query(W,1001,77,1004,0);
    runs=runs+1;
    if(got!=1004){ bad=bad+1; }
    s=s+1;
  }
  pz_e(SC,TXT,"M3 runs="); pz_ei(SC,TXT,runs);
  pz_e(SC,TXT," min-distractors-per-run=4");
  pz_e(SC,TXT," hidden-dependency-violations="); pz_ei(SC,TXT,bad);
  pz_e(SC,TXT," K8=");
  if(bad==0){ pz_e(SC,TXT,"PASS"); } else { pz_e(SC,TXT,"HIDDEN-DEPENDENCY"); }
  pz_enl(SC,TXT);

  // ------------------------------------ M4 EQUIVALENT-RE-ENCODE, 31 seeds
  pz_hline3(SC,TXT,"=== M4 EQUIVALENT-RE-ENCODE (relation bijection), seeds 301..331 ===");
  s=301;
  bad=0;
  runs=0;
  eff=0;
  while(s<=331){
    pz_stream(S,301,s-300);
    pz_gen_perm(S,R,0,1000);
    pz_reset2(W);
    let cr:i32=pz_get(R,11*4);
    let gr:i32=pz_get(R,77*4);
    if(cr!=11){ eff=eff+1; }
    let i:i32=0;
    while(i<3){
      let a:i32=1001+i;
      ev_teach(W,a,cr,1002+i);
      i=i+1;
    }
    let got:i32=ev_query(W,1001,gr,1004,0);
    runs=runs+1;
    if(got!=1004){ bad=bad+1; }
    s=s+1;
  }
  pz_e(SC,TXT,"M4 runs="); pz_ei(SC,TXT,runs);
  pz_e(SC,TXT," non-identity-encodings="); pz_ei(SC,TXT,eff);
  pz_e(SC,TXT," hidden-dependency-violations="); pz_ei(SC,TXT,bad);
  pz_e(SC,TXT," K8=");
  if(bad==0){ pz_e(SC,TXT,"PASS"); } else { pz_e(SC,TXT,"HIDDEN-DEPENDENCY"); }
  pz_enl(SC,TXT);

  pz_eflush(SC,TXT);
  let by:i32=pz_get(SC,4);
  if(by<1){ _zag_print("PZ_META_OUTPUT_EMPTY_FAIL\n"); return 1; }
  _zag_print("PZ-META emitted-bytes=");
  _zag_print(_zag_i64_to_str(by as i64));
  return 0;
}
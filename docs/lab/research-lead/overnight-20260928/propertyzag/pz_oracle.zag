// pz_oracle.zag -- PROPERTY-ZAG independent oracles.
//
// These are written FROM THE CONTRACT, not from the frozen implementation,
// and deliberately with different control flow (count-then-fill, early exit,
// lane-local dedup) so that a shared defect is unlikely.
//
// Standing rule: the frozen implementation is NOT ground truth. A
// differential run reports DISAGREEMENT and adjudicates here. When the oracle
// and an implementation disagree, the minimal disagreeing case is reported
// with both traces so a human can adjudicate.

// CONTRACT RET: return every subject s such that (s,rel,obj) is a fact,
// in fact order, without deduplication.
fn pz_or_ret(A:[]u8,rel:i32,obj:i32,out:[]u8,oo:i32)[]u8 {
  let nf:i32=pz_get(A,0);
  let cnt:i32=0;
  let j:i32=0;
  while(j<nf){
    if(pz_get(A,4+j*12+4)==rel){
      if(pz_get(A,4+j*12+8)==obj){ cnt=cnt+1; }
    }
    j=j+1;
  }
  pz_set(out,oo,cnt);
  let i:i32=0;
  j=0;
  while(j<nf && i<cnt){
    if(pz_get(A,4+j*12+4)==rel){
      if(pz_get(A,4+j*12+8)==obj){
        pz_set(out,oo+4+i*4,pz_get(A,4+j*12));
        i=i+1;
      }
    }
    j=j+1;
  }
  return out;
}
// CONTRACT VFY: 1 iff every chain step (s,r,o) matches at least one fact.
fn pz_or_vfy(A:[]u8,C:[]u8,OUT:[]u8)void {
  let ns:i32=pz_get(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns && ok==1){
    let s:i32=pz_get(C,4+i*12);
    let r:i32=pz_get(C,4+i*12+4);
    let o:i32=pz_get(C,4+i*12+8);
    let hit:i32=0;
    let j:i32=0;
    while(j<pz_get(A,0)){
      if(hit==0){
        if(pz_get(A,4+j*12)==s){
          if(pz_get(A,4+j*12+4)==r){
            if(pz_get(A,4+j*12+8)==o){ hit=1; }
          }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  pz_set(OUT,0,ok);
  return;
}
// CONTRACT CNT: the number of DISTINCT objects o such that (subj,rel,o) is a
// fact, summed over the given subject list. Dedup is lane-local: the seen
// buffer is rebuilt per subject, so cross-subject repeats are not collapsed
// (matching the frozen contract's per-subject scan) and duplicates within one
// subject are collapsed.
fn pz_or_cnt(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,seen:[]u8)[]u8 {
  set32s(seen);
  let d:i32=0;
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=pz_get(sb,so+si*4);
    let local:i32=0;
    let j:i32=0;
    while(j<pz_get(A,0)){
      if(pz_get(A,4+j*12)==subj){
        if(pz_get(A,4+j*12+4)==rel){
          let fo:i32=pz_get(A,4+j*12+8);
          let dup:i32=0;
          let f:i32=0;
          while(f<local){
            if(pz_get(seen,f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            pz_set(seen,local*4,fo);
            local=local+1;
          }
        }
      }
      j=j+1;
    }
    d=d+local;
    si=si+1;
  }
  pz_set(seen,4000,d);
  return seen;
}
fn set32s(seen:[]u8)void {
  let i:i32=0;
  while(i<1024){ pz_set(seen,i*4,0); i=i+1; }
  return;
}
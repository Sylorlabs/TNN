// exp_pz_bat.zag -- PROPERTY-ZAG battery arm against the frozen cores.
// Concatenated after z2_core (tnn2_frozen_ref.zag, renamed) + pz_* library.
//
// Arms:
//   ARM0   clean frozen arena, then a real learned structure: the battery must
//          be silent (kill bar K4)
//   ARM1-6 the six charter-113 containment scenarios, each: DETECT, CONTAIN,
//          REPAIR-OR-QUARANTINE, re-scan, CONTINUE (K3, K5, K6, K7)
//   ARM7   generator sweep, well-formed topologies, seeds 1..63: must be
//          silent across the whole preregistered schedule (K4)
//   ARM8   generator sweep, adversarial topologies, seeds 1..63: per-code mix
//   ARM9   PZ-I09 namespace collision, two minimal reproducers against the
//          frozen core (prediction P1)
//   ARM10  PZ-I04 provenance log saturation (prediction P2)
//   ARM11  silent corruption: a truncated sequence program still reports
//          SUCCESS (predictions P3 and P4)
//   ARM12  PZ-I12 replay determinism: same seed twice, different seeds apart

fn pz_hline(SC:[]u8,TXT:[]u8,s:[]u8)void { pz_e(SC,TXT,s); pz_enl(SC,TXT); return; }

// reset a tnn2 arena to the frozen tnn2_init state
fn pz_reset(W:[]u8)void {
  let i:i32=0;
  while(i<110656){ W[i]=0; i=i+1; }
  let e:i32=0;
  while(e<4096){ es(W,e,0,-1); e=e+1; }
  ns(W,0,36,1); ns(W,0,0,900); write_node(W,0,-1,0,0,0);
  ns(W,1,36,1); ns(W,1,0,901); write_node(W,1,-1,0,0,0);
  hs(W,0,0); hs(W,4,12); hs(W,8,2); hs(W,12,-1); hs(W,16,0);
  hs(W,20,0); hs(W,24,0); hs(W,28,0);
  hs(W,32,-1); hs(W,36,-1); hs(W,40,-1); hs(W,44,-1); hs(W,48,0);
  return;
}
fn pz_mk_wf(W:[]u8,D:[]u8,S:[]u8,seed:i32,n:i32,m:i32)void {
  pz_reset(W);
  pz_stream(S,101,seed);
  pz_gen_graph(W,D,S,n,m,1);
  return;
}
fn pz_fname(fam:i32)[]u8 {
  if(fam==0){ return "CORRUPTED-NODE"; }
  if(fam==1){ return "STALE-INDEX"; }
  if(fam==2){ return "CYCLIC-DEPENDENCY"; }
  if(fam==3){ return "MALFORMED-PROCEDURE"; }
  if(fam==4){ return "MISSING-DEPENDENCY"; }
  if(fam==5){ return "INVALID-REFERENCE"; }
  return "?";
}

// execute a program root on a fresh frame; report rc and slot0
fn pz_run(W:[]u8,root:i32,s0:i32,RC:[]u8,VL:[]u8)void {
  let fr:i32=alloc_node(W);
  ns(W,fr,0,902);
  fr_set(W,fr,0,s0); fr_set(W,fr,1,0);
  let e:i32=execute(W,root,fr);
  pz_set(RC,0,e);
  pz_set(VL,0,res_op(W,fr,1000));
  return;
}

// dump every live sequence edge, so a multi-parent report can be adjudicated
fn dump_seq(D:[]u8,W:[]u8,TXT:[]u8,SC:[]u8)void {
  let sk:i32=pz_get(D,PZ_D_SEQK());
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==sk){
      pz_e(SC,TXT,"SEQ edge="); pz_ei(SC,TXT,e);
      pz_e(SC,TXT," from="); pz_ei(SC,TXT,eg(W,e,0));
      pz_e(SC,TXT," tag="); pz_ei(SC,TXT,ng(W,eg(W,e,0),0));
      pz_e(SC,TXT," alive="); pz_ei(SC,TXT,ng(W,eg(W,e,0),36));
      pz_e(SC,TXT," to="); pz_ei(SC,TXT,eg(W,e,8));
      pz_e(SC,TXT," tag="); pz_ei(SC,TXT,ng(W,eg(W,e,8),0));
      pz_e(SC,TXT," alive="); pz_ei(SC,TXT,ng(W,eg(W,e,8),36));
      pz_enl(SC,TXT);
    }
    e=e+1;
  }
  return;
}

// ---------------------------------------------------------------- ARM0
fn arm0(D:[]u8,W:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8)void {
  pz_hline(SC,TXT,"=== ARM0 clean-arena calibration (kill bar K4) ===");
  pz_reset(W);
  let v0:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"ARM0 fresh tnn2_init violations="); pz_ei(SC,TXT,v0);
  pz_enl(SC,TXT);
  // build a real learned structure through the frozen engine
  ev_teach(W,4101,11,4102);
  ev_teach(W,4102,11,4103);
  ev_teach(W,4103,11,4104);
  let a:i32=ev_query(W,4101,77,4104,0);
  pz_e(SC,TXT,"ARM0 chain query ans="); pz_ei(SC,TXT,a);
  pz_e(SC,TXT," live="); pz_ei(SC,TXT,hg(W,20));
  pz_e(SC,TXT," edges="); pz_ei(SC,TXT,hg(W,24));
  pz_enl(SC,TXT);
  let v1:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"ARM0 after-learn violations="); pz_ei(SC,TXT,v1);
  pz_enl(SC,TXT);
  if(v1>0){ pz_report(REC,SC,TXT,"ARM0-LEARNED"); }
  dump_seq(D,W,TXT,SC);
  return;
}

// ------------------------------------------------------------- ARM1..ARM6
fn arm_fam(D:[]u8,W:[]u8,S:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8,fam:i32)void {
  pz_mk_wf(W,D,S,7+fam,26,44);
  let hb:i32=pz_arena_hash(W,D);
  let v0:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"SCENARIO ");
  pz_ei(SC,TXT,fam);
  pz_e(SC,TXT," "); pz_e(SC,TXT,pz_fname(fam));
  pz_e(SC,TXT," clean-violations="); pz_ei(SC,TXT,v0);
  pz_enl(SC,TXT);
  pz_gen_inject(W,D,S,fam);
  let v1:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"SCENARIO "); pz_ei(SC,TXT,fam);
  pz_e(SC,TXT," DETECT violations="); pz_ei(SC,TXT,v1);
  pz_enl(SC,TXT);
  pz_report(REC,SC,TXT,"DETECT");
  let acts:i32=pz_act(W,D,REC,SC,TXT);
  let v2:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"SCENARIO "); pz_ei(SC,TXT,fam);
  pz_e(SC,TXT," actions="); pz_ei(SC,TXT,acts);
  pz_e(SC,TXT," post-violations="); pz_ei(SC,TXT,v2);
  pz_enl(SC,TXT);
  if(v2>0){ pz_report(REC,SC,TXT,"POST-REPAIR"); }
  // CONTINUE: the arena must still allocate and run a program
  let rc:i32=alloc_node(W);
  pz_e(SC,TXT,"SCENARIO "); pz_ei(SC,TXT,fam);
  pz_e(SC,TXT," CONTINUE alloc="); pz_ei(SC,TXT,rc);
  pz_e(SC,TXT," hash-changed=");
  let ha:i32=pz_arena_hash(W,D);
  if(ha!=hb){ pz_e(SC,TXT,"1"); } else { pz_e(SC,TXT,"0"); }
  pz_enl(SC,TXT);
  return;
}

// ----------------------------------------------------------------- ARM7/8
fn arm_sweep(D:[]u8,W:[]u8,S:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8,well:i32)void {
  let tot:i32=0;
  let bad:i32=0;
  let per:[]u8=pz_alloc(64);
  let i:i32=0;
  while(i<16){ pz_set(per,i*4,0); i=i+1; }
  let seed:i32=1;
  while(seed<=63){
    pz_reset(W);
    pz_stream(S,1,seed);
    let n:i32=4+pz_rnd(S,40);
    let m:i32=pz_rnd(S,80);
    pz_gen_graph(W,D,S,n,m,well);
    let v:i32=pz_scan(W,D,WK,REC,TXT,SC);
    tot=tot+v;
    if(v>0){ bad=bad+1; }
    let c:i32=1;
    while(c<=13){
      pz_set(per,c*4,pz_get(per,c*4)+pz_get(SC,16+c*4));
      c=c+1;
    }
    seed=seed+1;
  }
  if(well==1){
    pz_hline(SC,TXT,"=== ARM7 generator sweep, WELL-FORMED, seeds 1..63 ===");
    pz_e(SC,TXT,"ARM7 seeds="); pz_ei(SC,TXT,63);
    pz_e(SC,TXT," seeds-with-violations="); pz_ei(SC,TXT,bad);
    pz_e(SC,TXT," total-violations="); pz_ei(SC,TXT,tot);
    pz_e(SC,TXT," K4=");
    if(tot==0){ pz_e(SC,TXT,"PASS"); } else { pz_e(SC,TXT,"FAIL"); }
    pz_enl(SC,TXT);
    pz_permix(SC,TXT,per,"ARM7");
    return;
  }
  pz_hline(SC,TXT,"=== ARM8 generator sweep, ADVERSARIAL, seeds 1..63 ===");
  pz_e(SC,TXT,"ARM8 seeds="); pz_ei(SC,TXT,63);
  pz_e(SC,TXT," seeds-with-violations="); pz_ei(SC,TXT,bad);
  pz_e(SC,TXT," total-violations="); pz_ei(SC,TXT,tot);
  pz_enl(SC,TXT);
  pz_permix(SC,TXT,per,"ARM8");
  return;
}
fn pz_permix(SC:[]u8,TXT:[]u8,per:[]u8,tag:[]u8)void {
  let c:i32=1;
  while(c<=13){
    let v:i32=pz_get(per,c*4);
    if(v>0){
      pz_e(SC,TXT,tag); pz_e(SC,TXT," per-code ");
      pz_ei(SC,TXT,c);
      pz_e(SC,TXT," "); pz_e(SC,TXT,pz_cname(c));
      pz_e(SC,TXT," total="); pz_ei(SC,TXT,v);
      pz_enl(SC,TXT);
    }
    c=c+1;
  }
  return;
}

// ------------------------------------------------------------------- ARM9
// PZ-I09, two minimal reproducers against the frozen core.
fn arm9(D:[]u8,W:[]u8,TXT:[]u8,SC:[]u8)void {
  pz_hline(SC,TXT,"=== ARM9 PZ-I09 namespace collision, minimal reproducers ===");
  // (a) literal band: res_op routes node ids >= 1000 to frame slots
  pz_reset(W);
  let i:i32=0;
  let last:i32=-1;
  while(i<1000){ last=alloc_node(W); i=i+1; }
  pz_e(SC,TXT,"REPRO-A alloc_node 1000x -> last id=");
  pz_ei(SC,TXT,last);
  pz_enl(SC,TXT);
  // one more allocation lands in the collision band
  let lit:i32=alloc_node(W);
  pz_e(SC,TXT,"REPRO-A literal node id="); pz_ei(SC,TXT,lit);
  pz_e(SC,TXT," in-band(1000..1023)=");
  let band:i32=0;
  if(lit>=1000 && lit<1024){ band=1; }
  pz_ei(SC,TXT,band);
  pz_enl(SC,TXT);
  // the literal carries the intended value in its value field
  ns(W,lit,0,902); write_node(W,lit,4242,0,0,0);
  let fr:i32=alloc_node(W);
  ns(W,fr,0,902); fr_set(W,fr,0,777); fr_set(W,fr,1,0);
  fr_set(W,fr,2,777);
  let got:i32=res_op(W,fr,lit);
  pz_e(SC,TXT,"REPRO-A res_op(frame,"); pz_ei(SC,TXT,lit);
  pz_e(SC,TXT,") = "); pz_ei(SC,TXT,got);
  pz_e(SC,TXT," intended-literal-value=4242 frame-slot0=777 wrong=");
  let wrong:i32=0;
  if(got!=4242){ wrong=1; }
  pz_ei(SC,TXT,wrong);
  pz_enl(SC,TXT);
  // (b) slot alias: frame slot 24 decodes to node index 1024, whose record
  // starts exactly at the first edge record, so a depth-2 frame read returns
  // an edge word.
  let cell:i32=alloc_node(W);
  ns(W,cell,0,902); ns(W,cell,4,1024);
  let e1:i32=link_edge(W,2,1,31337,7);
  let aliasv:i32=pz_n(W,D,1024,1);
  let edgev:i32=pz_ew(W,D,e1,1);
  pz_e(SC,TXT,"REPRO-B frame-child operand=1024 (slot 24) -> node index 1024");
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"REPRO-B node1024.field1="); pz_ei(SC,TXT,aliasv);
  pz_e(SC,TXT," edge[" ); pz_ei(SC,TXT,e1); pz_e(SC,TXT,"].kind="); pz_ei(SC,TXT,edgev);
  pz_e(SC,TXT," aliased=");
  let al2:i32=0;
  if(aliasv==edgev){ al2=1; }
  pz_ei(SC,TXT,al2);
  pz_e(SC,TXT," edge-slot="); pz_ei(SC,TXT,e1);
  pz_enl(SC,TXT);
  let fr2:i32=alloc_node(W);
  ns(W,fr2,0,902); ns(W,fr2,4,1024);
  let hop:i32=ng(W,fr2,4);
  pz_e(SC,TXT,"REPRO-B frame-hop read ng(frame,field1)="); pz_ei(SC,TXT,hop);
  pz_e(SC,TXT," (0 means the pointer walked off into another record table)");
  pz_enl(SC,TXT);
  return;
}

// ------------------------------------------------------------------ ARM10
// PZ-I04: log_ev drops provenance silently at cursor 128.
fn arm10(D:[]u8,W:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8)void {
  pz_hline(SC,TXT,"=== ARM10 PZ-I04 provenance log saturation ===");
  pz_reset(W);
  let i:i32=0;
  while(i<200){ ev_teach(W,5000+i,3,6000+i); i=i+1; }
  let cur:i32=hg(W,28);
  pz_e(SC,TXT,"ARM10 events-requested=200 log-cursor="); pz_ei(SC,TXT,cur);
  pz_e(SC,TXT," capacity=128 dropped-silently=");
  pz_ei(SC,TXT,200-cur);
  pz_enl(SC,TXT);
  let v:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"ARM10 detect violations="); pz_ei(SC,TXT,v);
  pz_enl(SC,TXT);
  pz_report(REC,SC,TXT,"ARM10-PROV");
  return;
}

// ------------------------------------------------------------------ ARM11
// Silent corruption: a truncated sequence program still reports SUCCESS.
// (a) the edge cut that evict_node performs on its victim
// (b) the edge loss that a saturated edge table performs silently
fn arm11(D:[]u8,W:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8)void {
  pz_hline(SC,TXT,"=== ARM11 silent corruption: truncated program reports SUCCESS ===");
  pz_reset(W);
  let f1:i32=ev_teach(W,7001,21,7002);
  let f2:i32=ev_teach(W,7002,21,7003);
  ev_teach(W,7003,21,7004);
  let v:[]u8=pz_alloc(32);
  let f:[]u8=pz_alloc(16);
  pz_set(v,0,7001); pz_set(v,4,7002); pz_set(v,8,7003);
  pz_set(f,0,f1); pz_set(f,4,f2);
  let root:i32=t2_asm_chain(W,v,3,f);
  // promote the program so there is an OWNER licensing it: this is what makes
  // a truncated program detectable at all
  let map:i32=promote_graph(W,root,7001,21,7003,f,2);
  pz_e(SC,TXT,"ARM11a promoted MAP node="); pz_ei(SC,TXT,map);
  pz_e(SC,TXT," map-root-field="); pz_ei(SC,TXT,ng(W,map,20));
  pz_enl(SC,TXT);
  let RC:[]u8=pz_alloc(8);
  let VL:[]u8=pz_alloc(8);
  pz_run(W,root,7001,RC,VL);
  pz_e(SC,TXT,"ARM11a intact rc="); pz_ei(SC,TXT,pz_get(RC,0));
  pz_e(SC,TXT," value="); pz_ei(SC,TXT,pz_get(VL,0));
  pz_e(SC,TXT," full-chain-value=7003 correct=");
  let ok0:i32=0;
  if(pz_get(VL,0)==7003){ ok0=1; }
  pz_ei(SC,TXT,ok0);
  pz_enl(SC,TXT);
  // the sequence edge that links step 1 to step 2: from = ng(root,12)'s
  // producer, to = ng(root,12)
  let tgt:i32=ng(W,root,12);
  let se:i32=-1;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12 && eg(W,e,0)==tgt){ se=e; }
    e=e+1;
  }
  pz_e(SC,TXT,"ARM11a root="); pz_ei(SC,TXT,root);
  pz_e(SC,TXT," root-true-target="); pz_ei(SC,TXT,tgt);
  pz_e(SC,TXT," seq-edge-to-target="); pz_ei(SC,TXT,se);
  pz_enl(SC,TXT);
  // exactly what evict_node does to every edge incident on its victim
  t2_kill_edge(W,eg(W,se,0),12,eg(W,se,8));
  pz_run(W,root,7001,RC,VL);
  let rc:i32=pz_get(RC,0);
  let vl:i32=pz_get(VL,0);
  pz_e(SC,TXT,"ARM11a after-cut rc="); pz_ei(SC,TXT,rc);
  pz_e(SC,TXT," value="); pz_ei(SC,TXT,vl);
  pz_e(SC,TXT," runtime-reports-SUCCESS=");
  let succ:i32=0;
  if(rc==1){ succ=1; }
  pz_ei(SC,TXT,succ);
  pz_e(SC,TXT," value-WRONG=");
  let w2:i32=0;
  if(vl!=7003){ w2=1; }
  pz_ei(SC,TXT,w2);
  pz_e(SC,TXT," battery-detects=");
  let nv:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_ei(SC,TXT,nv);
  pz_enl(SC,TXT);
  pz_report(REC,SC,TXT,"ARM11a-AFTER-CUT");
  // CONTAIN: the owner loses its licence
  let acts:i32=pz_act(W,D,REC,SC,TXT);
  let qq:i32=ev_query(W,7001,21,7003,0);
  pz_e(SC,TXT,"ARM11a after-contain actions="); pz_ei(SC,TXT,acts);
  pz_e(SC,TXT," ev_query-answer="); pz_ei(SC,TXT,qq);
  pz_e(SC,TXT," no-longer-wrong=");
  let nw:i32=0;
  if(qq!=7002){ nw=1; }
  pz_ei(SC,TXT,nw);
  pz_e(SC,TXT," post-violations=");
  let nv2:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_ei(SC,TXT,nv2);
  pz_enl(SC,TXT);
  pz_run(W,root,7001,RC,VL);
  pz_e(SC,TXT,"ARM11a raw-execute-after-contain rc="); pz_ei(SC,TXT,pz_get(RC,0));
  pz_e(SC,TXT," value="); pz_ei(SC,TXT,pz_get(VL,0));
  pz_e(SC,TXT," (raw execute on an orphaned program is NOT re-checked by the runtime)");
  pz_enl(SC,TXT);
  // (b) saturated edge table: seq_link ignores link_edge's -1
  pz_reset(W);
  ev_teach(W,8001,21,8002);
  let f3:i32=ev_teach(W,8002,21,8003);
  ev_teach(W,8003,21,8004);
  let v2:[]u8=pz_alloc(32);
  let f4:[]u8=pz_alloc(16);
  pz_set(v2,0,8001); pz_set(v2,4,8002); pz_set(v2,8,8003);
  pz_set(f4,0,f3); pz_set(f4,4,f3);
  // saturate the edge table BEFORE assembly: t2_asm_chain calls seq_link,
  // which ignores the -1 that link_edge returns
  let fill:i32=hg(W,24);
  while(fill<4096){ link_edge(W,2,1,3,0); fill=fill+1; }
  let root2:i32=t2_asm_chain(W,v2,3,f4);
  let tgt2:i32=ng(W,root2,12);
  let free0:i32=0;
  let ee:i32=0;
  while(ee<4096){
    if(eg(W,ee,0)==-1){ free0=1; }
    ee=ee+1;
  }
  let stillfree:i32=0;
  ee=0;
  while(ee<4096){
    if(eg(W,ee,0)==-1){ stillfree=1; }
    ee=ee+1;
  }
  pz_run(W,root2,8001,RC,VL);
  pz_e(SC,TXT,"ARM11b edge-table-saturated free-slot-before="); pz_ei(SC,TXT,free0);
  pz_e(SC,TXT," after-seq_link="); pz_ei(SC,TXT,stillfree);
  pz_e(SC,TXT," rc="); pz_ei(SC,TXT,pz_get(RC,0));
  pz_e(SC,TXT," value="); pz_ei(SC,TXT,pz_get(VL,0));
  pz_e(SC,TXT," full-chain-value=8003 value-DIFFERS-FROM-INTACT=");
  let sl:i32=0;
  if(pz_get(VL,0)==8002){ sl=1; }
  pz_ei(SC,TXT,sl);
  pz_e(SC,TXT," seq_link-return-value-ignored=1");
  pz_enl(SC,TXT);
  let nv3:i32=pz_scan(W,D,WK,REC,TXT,SC);
  pz_e(SC,TXT,"ARM11b battery-violations="); pz_ei(SC,TXT,nv3);
  pz_enl(SC,TXT);
  pz_report(REC,SC,TXT,"ARM11b-SATURATED");
  return;
}

// ------------------------------------------------------------------ ARM12
fn arm12(D:[]u8,W:[]u8,S:[]u8,TXT:[]u8,SC:[]u8)void {
  pz_hline(SC,TXT,"=== ARM12 PZ-I12 replay determinism ===");
  let s:i32=7;
  pz_reset(W);
  pz_stream(S,1,s);
  pz_gen_graph(W,D,S,18,30,1);
  let h1:i32=pz_arena_hash(W,D);
  pz_reset(W);
  pz_stream(S,1,s);
  pz_gen_graph(W,D,S,18,30,1);
  let h2:i32=pz_arena_hash(W,D);
  pz_reset(W);
  pz_stream(S,1,s+1);
  pz_gen_graph(W,D,S,18,30,1);
  let h3:i32=pz_arena_hash(W,D);
  pz_e(SC,TXT,"ARM12 seed7-run1 hash="); pz_ei(SC,TXT,h1);
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"ARM12 seed7-run2 hash="); pz_ei(SC,TXT,h2);
  pz_e(SC,TXT," identical=");
  if(h1==h2){ pz_e(SC,TXT,"1"); } else { pz_e(SC,TXT,"0"); }
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"ARM12 seed8-run1 hash="); pz_ei(SC,TXT,h3);
  pz_e(SC,TXT," differs=");
  if(h3!=h1){ pz_e(SC,TXT,"1"); } else { pz_e(SC,TXT,"0"); }
  pz_enl(SC,TXT);
  return;
}

fn main()i32 {
  let D:[]u8=pz_desc_tnn2();
  let W:[]u8=pz_alloc(110656);
  let WK:[]u8=pz_alloc(32768);
  let REC:[]u8=pz_alloc(3072);
  let TXT:[]u8=pz_alloc(262144);
  let SC:[]u8=pz_alloc(256);
  let S:[]u8=pz_alloc(8);
  pz_beg(SC);
  pz_hline(SC,TXT,"PZ-BAT battery arm, layout=tnn2_frozen_ref");
  arm0(D,W,WK,REC,TXT,SC);
  let fam:i32=0;
  while(fam<6){ arm_fam(D,W,S,WK,REC,TXT,SC,fam); fam=fam+1; }
  arm_sweep(D,W,S,WK,REC,TXT,SC,1);
  arm_sweep(D,W,S,WK,REC,TXT,SC,0);
  arm9(D,W,TXT,SC);
  arm10(D,W,WK,REC,TXT,SC);
  arm11(D,W,WK,REC,TXT,SC);
  arm12(D,W,S,TXT,SC);
  pz_eflush(SC,TXT);
  let by:i32=pz_get(SC,4);
  if(by<1){ _zag_print("PZ_BAT_OUTPUT_EMPTY_FAIL\n"); return 1; }
  _zag_print("PZ-BAT emitted-bytes=");
  _zag_print(_zag_i64_to_str(by as i64));
  return 0;
}
// pz_lib.zag -- PROPERTY-ZAG reusable core library.
// Pure Zag. No floats, no arrays, no structs, no library RNG, no floats.
//
// Provides: allocation, little-endian i32 cell access, output formatting over
// ONE preallocated buffer flushed with _zag_print (NOT _zag_raw_syscall, which
// is INERT on this host and emits nothing), a deterministic xorshift32 PRNG
// with the preregistered seed schedule (PREREG section 4), and an FNV-1a style
// rolling hash over live state for replay determinism.
//
// ALL symbols are prefixed pz_ / PZ_ so this file can be concatenated after a
// frozen core without name collisions.

// ------------------------------------------------------------------ alloc
fn pz_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}

// ------------------------------------------------- little-endian i32 cell
fn pz_get(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn pz_set(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ------------------------------------------------------------- output
// SC cell 0 = text cursor, SC cell 4 = flush-happened flag (K1 evidence).
fn pz_beg(SC:[]u8)void { pz_set(SC,0,0); pz_set(SC,4,0); return; }
fn pz_e(SC:[]u8,TXT:[]u8,s:[]u8)void {
  let c:i32=pz_get(SC,0); let n:i32=pz_app(TXT,c,s); pz_set(SC,0,n); return;
}
fn pz_ei(SC:[]u8,TXT:[]u8,v:i32)void {
  let c:i32=pz_get(SC,0); let n:i32=pz_i32s(TXT,c,v); pz_set(SC,0,n); return;
}
fn pz_enl(SC:[]u8,TXT:[]u8)void {
  let c:i32=pz_get(SC,0); TXT[c]=10; pz_set(SC,0,c+1); return;
}
fn pz_eflush(SC:[]u8,TXT:[]u8)void {
  let c:i32=pz_get(SC,0);
  if(c>0){ _zag_print(TXT[0..c]); pz_set(SC,4,c); }
  return;
}
fn pz_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn pz_i32s(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}

// ------------------------------------------------------------------ PRNG
// xorshift32. State is one i32 cell. All outputs are non-negative so that no
// sign-extension arithmetic can make the stream depend on the host.
// PRNG seed schedule is frozen in PREREG section 4.
fn pz_srand(S:[]u8,seed:i32)void {
  let s:i32=seed ^ 0x5bf03635;
  if(s==0){ s=2463534242; }
  pz_set(S,0,s);
  let i:i32=0;
  while(i<8){ let x:i32=pz_raw(S); s=x; i=i+1; }
  pz_set(S,0,s);
  return;
}
fn pz_raw(S:[]u8)i32 {
  let x:i32=pz_get(S,0);
  x=x ^ ((x<<13)&0xffffffff);
  if(x<0){ x=x & 0x7fffffff; }
  x=x ^ ((x>>17)&0xffffffff);
  if(x<0){ x=x & 0x7fffffff; }
  x=x ^ ((x<<5)&0xffffffff);
  if(x<0){ x=x & 0x7fffffff; }
  pz_set(S,0,x);
  return x & 0x7fffffff;
}
// uniform in [0,m) for m>0
fn pz_rnd(S:[]u8,m:i32)i32 {
  if(m<1){ return 0; }
  let r:i32=pz_raw(S);
  return r % m;
}
fn pz_rnd_pm(S:[]u8,m:i32)i32 { return pz_rnd(S,m); }
// signed value in [-h,h]
fn pz_rnd_s(S:[]u8,h:i32)i32 {
  if(h<1){ return 0; }
  let r:i32=pz_rnd(S,2*h+1);
  return r-h;
}
// a fresh PRNG stream derived from a base seed and an index, so a single
// stream can be replayed deterministically by (base,index).
fn pz_stream(S:[]u8,base:i32,idx:i32)void { pz_srand(S,base*1000003+idx); return; }

// ------------------------------------------------------------------ hash
// FNV-1a 31-bit over i32 cells.
fn pz_h(h:i32,v:i32)i32 {
  let x:i32=h;
  let i:i32=0;
  while(i<4){
    x=x ^ ((v>>(i*8)) & 255);
    x=(x*16777619) & 0x7fffffff;
    i=i+1;
  }
  return x;
}
fn pz_h3(h:i32,a:i32,b:i32,c:i32)i32 {
  return pz_h(pz_h(pz_h(h,a),b),c);
}
fn pz_fold(h:i32,v:i32)i32 { return pz_h(h,v); }
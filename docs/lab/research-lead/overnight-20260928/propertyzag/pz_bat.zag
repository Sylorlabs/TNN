// pz_bat.zag -- PROPERTY-ZAG invariant battery (PZ-I01 .. PZ-I12).
//
// Layout-generic: all arena knowledge comes from the descriptor D. Pure Zag.
// No floats. while loops only. if-nesting <= 3.
//
// PUBLIC API (what other lanes call):
//   D   = pz_desc_tnn2() / pz_desc_c15() / a lane's own descriptor
//   WK  = pz_alloc(12288)      work buffer, node-indexed
//   REC = pz_alloc(3072)       machine-readable violation records, 16B each
//   TXT = pz_alloc(262144)     text buffer
//   SC  = pz_alloc(256)        scratch, cells documented below
//   n   = pz_scan(W,D,WK,REC,TXT,SC)      DETECT
//   pz_report(REC,SC,TXT,SC)               EXPLICIT DIAGNOSTICS
//   h   = pz_arena_hash(W,D)               replay determinism (PZ-I12)
//   pz_act(W,D,WK,REC,SC,TXT)              CONTAIN / REPAIR (pz_act.zag)
//
// SC cells: 0 text cursor, 4 flushed byte count, 8 record count,
// 12 total violation count, 16+4*code per-code counts,
// 80+4*code per-code exemplar counters.

// ------------------------------------------------------------- accessors
fn pz_n(W:[]u8,D:[]u8,n:i32,f:i32)i32 {
  return pz_get(W,pz_get(D,PZ_D_NOFF())+n*pz_get(D,PZ_D_NSZ())+f*4);
}
fn pz_nset(W:[]u8,D:[]u8,n:i32,f:i32,v:i32)void {
  pz_set(W,pz_get(D,PZ_D_NOFF())+n*pz_get(D,PZ_D_NSZ())+f*4,v); return;
}
fn pz_ew(W:[]u8,D:[]u8,e:i32,f:i32)i32 {
  return pz_get(W,pz_get(D,PZ_D_EOFF())+e*pz_get(D,PZ_D_ESZ())+f*4);
}
fn pz_eset(W:[]u8,D:[]u8,e:i32,f:i32,v:i32)void {
  pz_set(W,pz_get(D,PZ_D_EOFF())+e*pz_get(D,PZ_D_ESZ())+f*4,v); return;
}
fn pz_live(W:[]u8,D:[]u8,n:i32)i32 { return pz_n(W,D,n,pz_get(D,PZ_D_ALIVE())); }
fn pz_inr(D:[]u8,v:i32)i32 {
  if(v<pz_get(D,PZ_D_NOLO())){ return 0; }
  if(v>=pz_get(D,PZ_D_NCAP())){ return 0; }
  return 1;
}
// 1 when v names a node that is in range but not alive: a dead reference.
fn pz_deadn(W:[]u8,D:[]u8,v:i32)i32 {
  if(pz_inr(D,v)==0){ return 0; }
  if(pz_live(W,D,v)==1){ return 0; }
  return 1;
}

// ------------------------------------------------------------- recording
fn pz_rec(REC:[]u8,SC:[]u8,code:i32,a:i32,b:i32,c:i32)void {
  let n:i32=pz_get(SC,8);
  if(n<192){
    let o:i32=n*16;
    pz_set(REC,o,code); pz_set(REC,o+4,a); pz_set(REC,o+8,b); pz_set(REC,o+12,c);
    pz_set(SC,8,n+1);
  }
  pz_set(SC,12,pz_get(SC,12)+1);
  let cc:i32=16+code*4;
  pz_set(SC,cc,pz_get(SC,cc)+1);
  return;
}
fn pz_cname(code:i32)[]u8 {
  if(code==1){ return "I01-STABLE-IDENTITY"; }
  if(code==2){ return "I02-EDGE-ENDPOINT-DEAD"; }
  if(code==3){ return "I03-REF-INVALID"; }
  if(code==4){ return "I04-PROV-LOST"; }
  if(code==5){ return "I05-EDGE-KIND-ILLEGAL"; }
  if(code==6){ return "I06-TAG-ILLEGAL"; }
  if(code==7){ return "I07-DEP-CYCLE-OR-MULTIPARENT"; }
  if(code==8){ return "I08-FRAME-CYCLE"; }
  if(code==9){ return "I09-NAMESPACE-COLLISION"; }
  if(code==10){ return "I10-ARENA-NOT-DISJOINT"; }
  if(code==11){ return "I11-INDEX-STALE"; }
  if(code==12){ return "I12-REPLAY-NONDET"; }
  if(code==13){ return "I13-OWNERSHIP-CLOSURE"; }
  return "I??";
}
fn pz_ex(SC:[]u8,code:i32)void {
  let slot:i32=80+code*4;
  pz_set(SC,slot,pz_get(SC,slot)+1); return;
}
// Clear the scan bookkeeping cells (8 and up). Cells 0 and 4 are the text
// cursor and the flushed byte count and MUST survive a re-scan, otherwise a
// re-scan silently truncates the accumulated report. This exact bug is the
// failure mode the output rule of the brief warns about.
fn pz_sreset(SC:[]u8)void {
  let i:i32=8;
  while(i<256){ pz_set(SC,i,0); i=i+1; }
  return;
}

// ================================================================ PZ-I01
fn pz_s01(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  // record-mode arenas have no liveness flags; PZ-I01 is expressed there
  // by PZ-I11 on the record count instead
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let resv:i32=pz_get(D,PZ_D_RESV());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let tot:i32=0;
  let n:i32=n0;
  while(n<nc){
    let a:i32=pz_n(W,D,n,al);
    if(a!=0 && a!=1){ pz_rec(REC,SC,1,n,a,-1); pz_ex(SC,1); }
    if(n>=resv){
      if(a==1){ tot=tot+1; }
    }
    n=n+1;
  }
  let lc:i32=pz_get(D,PZ_D_LCNT());
  if(lc>=0){
    let hd:i32=pz_get(W,lc);
    if(hd!=tot){ pz_rec(REC,SC,1,-1,hd,tot); pz_ex(SC,1); }
  }
  return 0;
}

// ================================================================ PZ-I02
fn pz_s02(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let ec:i32=pz_get(D,PZ_D_ECAP());
  if(ec<1){ return 0; }
  let sent:i32=pz_get(D,PZ_D_SENT());
  let e:i32=0;
  while(e<ec){
    let f:i32=pz_ew(W,D,e,0);
    if(f!=sent){
      let t:i32=pz_ew(W,D,e,2);
      if(pz_inr(D,f)==0){ pz_rec(REC,SC,2,e,f,-1); pz_ex(SC,2); }
      else { if(pz_deadn(W,D,f)==1){ pz_rec(REC,SC,2,e,f,-1); pz_ex(SC,2); } }
      if(pz_inr(D,t)==0){ pz_rec(REC,SC,2,e,-1,t); pz_ex(SC,2); }
      else { if(pz_deadn(W,D,t)==1){ pz_rec(REC,SC,2,e,-1,t); pz_ex(SC,2); } }
    }
    e=e+1;
  }
  return 0;
}

// ================================================================ PZ-I05
fn pz_s05(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let ec:i32=pz_get(D,PZ_D_ECAP());
  if(ec<1){ return 0; }
  let sent:i32=pz_get(D,PZ_D_SENT());
  let e:i32=0;
  while(e<ec){
    if(pz_ew(W,D,e,0)!=sent){
      let k:i32=pz_ew(W,D,e,1);
      if(pz_kget(D,k)==0){ pz_rec(REC,SC,5,e,k,0); pz_ex(SC,5); }
    }
    e=e+1;
  }
  return 0;
}

// ================================================================ PZ-I06
fn pz_s06(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let n:i32=n0;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      let t:i32=pz_n(W,D,n,tf);
      if(pz_tget(D,t)==0){ pz_rec(REC,SC,6,n,t,0); pz_ex(SC,6); }
    }
    n=n+1;
  }
  return 0;
}

// ================================================================ PZ-I03
// Conditional reference rules. A rule fires only when the node's tag matches
// (tag == -1 fires for every live node). Kinds:
//   PZ_K_FRAME    value MUST be a frame operand (>= D_FBASE) AND the decoded
//                 slot must stay inside the node table.
//   PZ_K_OPFRAME  value is either a frame operand or an opaque literal; no
//                 strict check, but the decoded slot must stay inside the node
//                 table (recorded as an alias under PZ-I09).
//   PZ_K_NODE     value MUST be the sentinel, 0, or a live node index.
fn pz_s03(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let mode:i32=pz_get(D,PZ_D_MODE());
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let fb:i32=pz_get(D,PZ_D_FBASE());
  let fs:i32=pz_get(D,PZ_D_FSAFE());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let nr:i32=pz_get(D,PZ_D_NRULE());
  if(mode==0){ return pz_s03m0(W,D,REC,SC); }
  let n:i32=n0;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      let tg:i32=pz_n(W,D,n,tf);
      let r:i32=0;
      while(r<nr){
        let rt:i32=pz_rtag(D,r);
        let hit:i32=0;
        if(rt==-1){ hit=1; }
        if(rt==tg){ hit=1; }
        if(hit==1){ pz_chk1(W,D,REC,SC,n,tg,r,fb,fs,sent); }
        r=r+1;
      }
    }
    n=n+1;
  }
  return 0;
}
// degenerate record arena: a live fact record with a zero field is a
// reference into the empty entity or relation namespace, i.e. malformed.
fn pz_s03m0(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let n:i32=pz_get(W,pz_get(D,PZ_D_LCNT()));
  if(n<0){ n=0; }
  if(n>pz_get(D,PZ_D_NCAP())){ n=pz_get(D,PZ_D_NCAP()); }
  let j:i32=0;
  while(j<n){
    let a:i32=pz_n(W,D,j,0);
    let b:i32=pz_n(W,D,j,1);
    let c:i32=pz_n(W,D,j,2);
    let bad:i32=0;
    if(a==0){ bad=1; }
    if(b==0){ bad=2; }
    if(c==0){ bad=3; }
    if(bad>0){ pz_rec(REC,SC,3,j,bad,0); pz_ex(SC,3); }
    j=j+1;
  }
  return 0;
}
fn pz_chk1(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8,n:i32,tg:i32,r:i32,fb:i32,fs:i32,sent:i32)void {
  let fd:i32=pz_rfld(D,r);
  let kd:i32=pz_rknd(D,r);
  let v:i32=pz_n(W,D,n,fd);
  if(kd==PZ_K_FRAME()){
    if(v<fb){ pz_rec(REC,SC,3,n,v,tg); pz_ex(SC,3); }
  }
  if(kd==PZ_K_NODE()){
    if(v!=sent && v!=0){
      if(pz_deadn(W,D,v)==1){ pz_rec(REC,SC,3,n,v,tg); pz_ex(SC,3); }
    }
  }
  return;
}

// ================================================================ PZ-I09
// Namespace collision, two distinct statements.
//   (a) literal band: a live node index n with D_FBASE <= n < D_NCAP is BOTH
//       a valid node id AND the encoding of a frame slot (n-D_FBASE). The
//       runtime routes n as a frame operand, so the literal is unreachable.
//   (b) slot alias: any frame operand v >= D_FBASE decodes to node index
//       v-D_FBASE. If v-D_FBASE >= D_NCAP the index is outside the node table
//       and therefore reads another record table. The threshold slot is
//       D_FSAFE; slots at or above it alias.
// (b) slot alias among frame operands actually stored in the arena. The scan
// is driven by the rule table, so a field that a given tag uses as a plain
// value is never mistaken for a frame operand.
fn pz_s09(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let fb:i32=pz_get(D,PZ_D_FBASE());
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let nr:i32=pz_get(D,PZ_D_NRULE());
  // (a) literal band occupancy
  let hit:i32=0;
  let first:i32=-1;
  let n:i32=fb;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      hit=hit+1;
      if(first<0){ first=n; }
    }
    n=n+1;
  }
  if(hit>0){ pz_rec(REC,SC,9,first,hit,-1); pz_ex(SC,9); }
  // (b) slot alias among declared operand fields
  let alias:i32=0;
  let af:i32=-1;
  let slotmax:i32=-1;
  let m:i32=n0;
  while(m<nc){
    if(pz_live(W,D,m)==1){
      let tg:i32=pz_n(W,D,m,tf);
      let r:i32=0;
      while(r<nr){
        let rt:i32=pz_rtag(D,r);
        let kd:i32=pz_rknd(D,r);
        let fl:i32=pz_rflg(D,r);
        let hit2:i32=0;
        if(rt==-1){ hit2=1; }
        if(rt==tg){ hit2=1; }
        if(hit2==1 && fl==PZ_F_ALIAS()){
          if(kd==PZ_K_FRAME() || kd==PZ_K_OPFRAME()){
            let v:i32=pz_n(W,D,m,pz_rfld(D,r));
            if(v>=fb){
              let s:i32=v-fb;
              if(s>slotmax){ slotmax=s; }
              if(pz_inr(D,s)==0){ alias=alias+1; if(af<0){ af=m; } }
            }
          }
        }
        r=r+1;
      }
    }
    m=m+1;
  }
  if(alias>0){ pz_rec(REC,SC,9,af,alias,slotmax); pz_ex(SC,9); }
  return 0;
}

// ================================================================ PZ-I10
fn pz_s10(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let no:i32=pz_get(D,PZ_D_NOFF());
  let ns:i32=pz_get(D,PZ_D_NSZ());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let eo:i32=pz_get(D,PZ_D_EOFF());
  let es:i32=pz_get(D,PZ_D_ESZ());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let as:i32=pz_get(D,PZ_D_ASZ());
  if(no+ns*nc>eo){ pz_rec(REC,SC,10,no+ns*nc,eo,0); pz_ex(SC,10); }
  if(eo+es*ec>as){ pz_rec(REC,SC,10,eo+es*ec,as,1); pz_ex(SC,10); }
  return 0;
}

// ================================================================ PZ-I11
// INDEX-STALE has two components:
//   (a) the header live-edge count must equal the number of live edges.
//   (b) capacity headroom: if live edges == capacity then the next allocation
//       fails silently, which is reported as AT-CAPACITY.
fn pz_s11(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let ec:i32=pz_get(D,PZ_D_ECAP());
  if(ec>0){
    let sent:i32=pz_get(D,PZ_D_SENT());
    let e:i32=0;
    let tot:i32=0;
    while(e<ec){
      if(pz_ew(W,D,e,0)!=sent){ tot=tot+1; }
      e=e+1;
    }
    let hc:i32=pz_get(D,PZ_D_ECNT());
    if(hc>=0){
      let hd:i32=pz_get(W,hc);
      if(hd!=tot){ pz_rec(REC,SC,11,-1,hd,tot); pz_ex(SC,11); }
    }
    if(tot>=ec){ pz_rec(REC,SC,11,-2,ec,tot); pz_ex(SC,11); }
    return 0;
  }
  // degenerate record arena: the record count is the live count and the count
  // is the only index; at-capacity means the next record is dropped silently.
  let cap:i32=pz_get(D,PZ_D_NCAP());
  let n:i32=pz_get(W,pz_get(D,PZ_D_LCNT()));
  if(n<0){ pz_rec(REC,SC,11,-1,n,0); pz_ex(SC,11); return 0; }
  if(n>cap){ pz_rec(REC,SC,11,-1,n,cap); pz_ex(SC,11); return 0; }
  if(n>=cap){ pz_rec(REC,SC,11,-2,cap,n); pz_ex(SC,11); }
  return 0;
}

// ================================================================ PZ-I04
// PROV-PRESERVED.
//   (a) every live node tagged as learned structure carries at least one
//       provenance edge (kind D_DEP) incident on it.
//   (b) if the event/provenance log cursor sits at its declared capacity then
//       further provenance writes are dropped with no diagnostic.
fn pz_s04(W:[]u8,D:[]u8,REC:[]u8,SC:[]u8)i32 {
  let evc:i32=pz_get(D,PZ_D_EVCUR());
  let cap:i32=pz_get(D,PZ_D_EVCAP());
  if(cap>0 && evc>=0){
    let cur:i32=pz_get(W,evc);
    if(cur>=cap){ pz_rec(REC,SC,4,-2,cur,cap); pz_ex(SC,4); }
  }
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let dep:i32=pz_get(D,PZ_D_DEP());
  let lt:i32=pz_get(D,PZ_D_LEARN());
  if(dep<1 || lt<0){ return 0; }
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let n:i32=0;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      if(pz_n(W,D,n,pz_get(D,PZ_D_TAGF()))==lt){
        let prov:i32=0;
        let e:i32=0;
        while(e<ec){
          if(pz_ew(W,D,e,0)!=sent && pz_ew(W,D,e,1)==dep){
            if(pz_ew(W,D,e,0)==n){ prov=1; }
            if(pz_ew(W,D,e,2)==n){ prov=1; }
          }
          e=e+1;
        }
        if(prov==0){ pz_rec(REC,SC,4,n,lt,-1); pz_ex(SC,4); }
      }
    }
    n=n+1;
  }
  return 0;
}

// ================================================================ PZ-I07
// DEPENDENCY CONSISTENCY over the sequence-edge kind: acyclic, and every node
// has at most one sequence successor. Peeling by in-degree; nodes left with
// positive in-degree after peeling are on a cycle.
fn pz_s07(W:[]u8,D:[]u8,WK:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let sk:i32=pz_get(D,PZ_D_SEQK());
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let resv:i32=pz_get(D,PZ_D_RESV());
  let i:i32=0;
  while(i<4*nc+8){ pz_set(WK,i*4,0); i=i+1; }
  // in-degree over the arc from -> to
  let e:i32=0;
  while(e<ec){
    if(pz_ew(W,D,e,0)!=sent && pz_ew(W,D,e,1)==sk){
      let t:i32=pz_ew(W,D,e,2);
      if(pz_inr(D,t)==1 && t>=resv){ pz_set(WK,t*4,pz_get(WK,t*4)+1); }
    }
    e=e+1;
  }
  // single-writer: a source with two sequence out-edges, one of which
  // seq_nx can never reach
  let e2:i32=0;
  while(e2<ec){
    if(pz_ew(W,D,e2,0)!=sent && pz_ew(W,D,e2,1)==sk){
      let f:i32=pz_ew(W,D,e2,0);
      if(pz_inr(D,f)==1 && f>=resv){
        if(pz_get(WK,(nc+f)*4)>0){ pz_rec(REC,SC,7,f,e2,-1); pz_ex(SC,7); }
        pz_set(WK,(nc+f)*4,1);
      }
    }
    e2=e2+1;
  }
  // peel
  let ql:i32=0;
  let n:i32=n0;
  while(n<nc){
    if(n>=resv && pz_live(W,D,n)==1 && pz_get(WK,n*4)==0){
      pz_set(WK,((2*nc)+ql)*4,n); ql=ql+1;
    }
    n=n+1;
  }
  let head:i32=0;
  while(head<ql){
    let u:i32=pz_get(WK,((2*nc)+head)*4);
    head=head+1;
    let e3:i32=0;
    while(e3<ec){
      if(pz_ew(W,D,e3,0)!=sent && pz_ew(W,D,e3,1)==sk){
        if(pz_ew(W,D,e3,0)==u){
          let t:i32=pz_ew(W,D,e3,2);
          if(pz_inr(D,t)==1 && t>=resv){
            pz_set(WK,t*4,pz_get(WK,t*4)-1);
            if(pz_get(WK,t*4)==0 && pz_live(W,D,t)==1){
              pz_set(WK,((2*nc)+ql)*4,t); ql=ql+1;
            }
          }
        }
      }
      e3=e3+1;
    }
  }
  // live nodes with residual in-degree are on a cycle
  let m2:i32=n0;
  while(m2<nc){
    if(m2>=resv && pz_live(W,D,m2)==1){
      if(pz_get(WK,m2*4)>0){
        pz_rec(REC,SC,7,m2,pz_get(WK,m2*4),0); pz_ex(SC,7);
      }
    }
    m2=m2+1;
  }
  return 0;
}

// ================================================================ PZ-I08
// FRAME-FOREST: the frame-child relation is the field-FB-interpretation of a
// node's operand field: operand v >= FB means "child node index v - FB". Over
// live nodes this relation must be acyclic. Same peeling, different relation.
fn pz_s08(W:[]u8,D:[]u8,WK:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let fb:i32=pz_get(D,PZ_D_FBASE());
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let resv:i32=pz_get(D,PZ_D_RESV());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let nr:i32=pz_get(D,PZ_D_NRULE());
  let i:i32=0;
  while(i<4*nc+8){ pz_set(WK,i*4,0); i=i+1; }
  // arcs n -> (operand - D_FBASE) over the fields the rule table declares as
  // operand-encoded, one arc per node because the runtime resolves one child.
  let n:i32=n0;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      let tg:i32=pz_n(W,D,n,tf);
      let r:i32=0;
      while(r<nr){
        let rt:i32=pz_rtag(D,r);
        let kd:i32=pz_rknd(D,r);
        let fl:i32=pz_rflg(D,r);
        let hit2:i32=0;
        if(rt==-1){ hit2=1; }
        if(rt==tg){ hit2=1; }
        if(hit2==1 && fl==PZ_F_ALIAS()){
          if(kd==PZ_K_FRAME() || kd==PZ_K_OPFRAME()){
            let v:i32=pz_n(W,D,n,pz_rfld(D,r));
            if(v>=fb){
              let s:i32=v-fb;
              if(pz_inr(D,s)==1 && s>=resv && pz_get(WK,(nc+n)*4)==0){
                pz_set(WK,s*4,pz_get(WK,s*4)+1);
                pz_set(WK,(nc+n)*4,s);
              }
            }
          }
        }
        r=r+1;
      }
    }
    n=n+1;
  }
  let ql:i32=0;
  let m:i32=n0;
  while(m<nc){
    if(m>=resv && pz_live(W,D,m)==1 && pz_get(WK,m*4)==0){
      pz_set(WK,((2*nc)+ql)*4,m); ql=ql+1;
    }
    m=m+1;
  }
  let head:i32=0;
  while(head<ql){
    let u:i32=pz_get(WK,((2*nc)+head)*4);
    head=head+1;
    let v:i32=pz_get(WK,(nc+u)*4);
    if(v>0){
      if(pz_get(WK,v*4)>0){
        pz_set(WK,v*4,pz_get(WK,v*4)-1);
        if(pz_get(WK,v*4)==0){
          if(pz_live(W,D,v)==1){ pz_set(WK,((2*nc)+ql)*4,v); ql=ql+1; }
        }
      }
    }
  }
  let q:i32=n0;
  while(q<nc){
    if(q>=resv && pz_live(W,D,q)==1){
      if(pz_get(WK,q*4)>0){ pz_rec(REC,SC,8,q,pz_get(WK,q*4),0); pz_ex(SC,8); }
    }
    q=q+1;
  }
  return 0;
}

// ================================================================ PZ-I13
// STRUCTURE-OWNERSHIP / PROVENANCE CLOSURE. Added by amendment A1; see
// PREREG_AMENDMENT_A1.md. For every live node tagged as learned structure:
//   - its program root must be a live node;
//   - walking the program's control-flow relation (branch targets of the
//     conditional opcode plus the sequence successor) from the root must
//     reach every fact that the learned node licenses through a provenance
//     edge. A structurally intact but TRUNCATED program licenses fewer facts
//     than its owner claims, and this is the only invariant that sees it:
//     the arena is otherwise perfectly well formed.
// Record: code 13, a = owner node, b = facts licensed by the closure,
// c = facts licensed by the owner.
fn pz_s13(W:[]u8,D:[]u8,WK:[]u8,REC:[]u8,SC:[]u8)i32 {
  if(pz_get(D,PZ_D_MODE())==0){ return 0; }
  let lt:i32=pz_get(D,PZ_D_LEARN());
  let rf:i32=pz_get(D,PZ_D_ROOTF());
  if(lt<0 || rf<0){ return 0; }
  let dep:i32=pz_get(D,PZ_DEP());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let sk:i32=pz_get(D,PZ_D_SEQK());
  let beq:i32=pz_get(D,PZ_D_BEQ());
  let tf:i32=pz_get(D,PZ_D_TRUEF());
  let ff:i32=pz_get(D,PZ_D_FALSEF());
  let tfld:i32=pz_get(D,PZ_D_TAGF());
  let resv:i32=pz_get(D,PZ_D_RESV());
  let m:i32=0;
  while(m<nc){
    if(pz_live(W,D,m)==1 && pz_n(W,D,m,tfld)==lt){
      let root:i32=pz_n(W,D,m,rf);
      if(pz_deadn(W,D,root)==1){
        pz_rec(REC,SC,13,m,root,-1); pz_ex(SC,13); m=m+1; continue;
      }
      let z:i32=0;
      while(z<2*nc+4){ pz_set(WK,z*4,0); z=z+1; }
      let ql:i32=0;
      pz_set(WK,root*4,1);
      pz_set(WK,((2*nc)+ql)*4,root); ql=ql+1;
      let head:i32=0;
      while(head<ql){
        let u:i32=pz_get(WK,((2*nc)+head)*4);
        head=head+1;
        if(pz_n(W,D,u,tfld)==beq){
          let a1:i32=pz_n(W,D,u,tf);
          let a2:i32=pz_n(W,D,u,ff);
          if(pz_inr(D,a1)==1 && a1>=resv && pz_get(WK,a1*4)==0){
            pz_set(WK,a1*4,1); pz_set(WK,((2*nc)+ql)*4,a1); ql=ql+1;
          }
          if(pz_inr(D,a2)==1 && a2>=resv && pz_get(WK,a2*4)==0){
            pz_set(WK,a2*4,1); pz_set(WK,((2*nc)+ql)*4,a2); ql=ql+1;
          }
        }
        let e:i32=0;
        while(e<ec){
          if(pz_ew(W,D,e,0)!=sent && pz_ew(W,D,e,1)==sk){
            if(pz_ew(W,D,e,0)==u){
              let t:i32=pz_ew(W,D,e,2);
              if(pz_inr(D,t)==1 && t>=resv && pz_get(WK,t*4)==0){
                pz_set(WK,t*4,1); pz_set(WK,((2*nc)+ql)*4,t); ql=ql+1;
              }
            }
          }
          e=e+1;
        }
      }
      // facts licensed by the closure
      let cc:i32=0;
      let cs:i32=0;
      let k:i32=0;
      while(k<nc){
        if(k>=resv && pz_get(WK,k*4)==1){
          let e2:i32=0;
          while(e2<ec){
            if(pz_ew(W,D,e2,0)!=sent && pz_ew(W,D,e2,1)==dep){
              if(pz_ew(W,D,e2,0)==k){ cc=cc+1; cs=cs+pz_ew(W,D,e2,2); }
            }
            e2=e2+1;
          }
        }
        k=k+1;
      }
      // facts licensed by the owner
      let mc:i32=0;
      let ms:i32=0;
      let e3:i32=0;
      while(e3<ec){
        if(pz_ew(W,D,e3,0)!=sent && pz_ew(W,D,e3,1)==dep){
          if(pz_ew(W,D,e3,0)==m){ mc=mc+1; ms=ms+pz_ew(W,D,e3,2); }
        }
        e3=e3+1;
      }
      if(cc!=mc || cs!=ms){ pz_rec(REC,SC,13,m,cc,mc); pz_ex(SC,13); }
    }
    m=m+1;
  }
  return 0;
}
fn PZ_DEP()i32 { return 96; }

// ============================================================ PZ-I12 hash
// Order-independent over free slots: edges are folded into a running sum so
// compaction (PZ-I11 repair) does not change the hash, while any change to a
// live edge's content does.
fn pz_arena_hash(W:[]u8,D:[]u8)i32 {
  let h:i32=2166136261 & 0x7fffffff;
  let mode:i32=pz_get(D,PZ_D_MODE());
  if(mode==0){
    let n:i32=pz_get(W,pz_get(D,PZ_D_LCNT()));
    let j:i32=0;
    while(j<n && j<pz_get(D,PZ_D_NCAP())){
      h=pz_h3(h,pz_n(W,D,j,0),pz_n(W,D,j,1),pz_n(W,D,j,2));
      j=j+1;
    }
    return pz_h(h,n);
  }
  let n0:i32=pz_get(D,PZ_D_NOLO());
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let nf:i32=pz_get(D,PZ_D_NFIELD());
  let n:i32=n0;
  while(n<nc){
    if(pz_live(W,D,n)==1){
      let f:i32=0;
      while(f<nf){ h=pz_h(h,pz_n(W,D,n,f)); f=f+1; }
    }
    n=n+1;
  }
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let es:i32=pz_h(2166136261 & 0x7fffffff,0);
  let e:i32=0;
  let cnt:i32=0;
  while(e<ec){
    if(pz_ew(W,D,e,0)!=sent){
      es=pz_h3(es,pz_ew(W,D,e,0),pz_ew(W,D,e,1),pz_ew(W,D,e,2));
      es=pz_h(es,pz_ew(W,D,e,3));
      cnt=cnt+1;
    }
    e=e+1;
  }
  h=pz_h(h,es); h=pz_h(h,cnt);
  let lc:i32=pz_get(D,PZ_D_LCNT());
  if(lc>=0){ h=pz_h(h,pz_get(W,lc)); }
  let hc:i32=pz_get(D,PZ_D_ECNT());
  if(hc>=0){ h=pz_h(h,pz_get(W,hc)); }
  return h;
}

// =============================================================== DRIVER
fn pz_scan(W:[]u8,D:[]u8,WK:[]u8,REC:[]u8,TXT:[]u8,SC:[]u8)i32 {
  pz_sreset(SC);
  pz_s01(W,D,REC,SC);
  pz_s02(W,D,REC,SC);
  pz_s03(W,D,REC,SC);
  pz_s04(W,D,REC,SC);
  pz_s05(W,D,REC,SC);
  pz_s06(W,D,REC,SC);
  pz_s09(W,D,REC,SC);
  pz_s10(W,D,REC,SC);
  pz_s11(W,D,REC,SC);
  pz_s07(W,D,WK,REC,SC);
  pz_s08(W,D,WK,REC,SC);
  pz_s13(W,D,WK,REC,SC);
  return pz_get(SC,12);
}

// ============================================================== REPORT
// EXPLICIT DIAGNOSTICS: one summary line per code, then up to three
// exemplars per code with the offending indices.
fn pz_report(REC:[]u8,SC:[]u8,TXT:[]u8,tag:[]u8)void {
  pz_e(SC,TXT,"SCAN ");
  pz_e(SC,TXT,tag);
  pz_e(SC,TXT," violations=");
  pz_ei(SC,TXT,pz_get(SC,12));
  pz_e(SC,TXT," records=");
  pz_ei(SC,TXT,pz_get(SC,8));
  pz_enl(SC,TXT);
  let code:i32=1;
  while(code<=13){
    let c:i32=pz_get(SC,16+code*4);
    if(c>0){
      pz_e(SC,TXT,"  CODE ");
      pz_ei(SC,TXT,code);
      pz_e(SC,TXT," ");
      pz_e(SC,TXT,pz_cname(code));
      pz_e(SC,TXT," count=");
      pz_ei(SC,TXT,c);
      pz_enl(SC,TXT);
      let k:i32=0;
      let r:i32=0;
      let nrec:i32=pz_get(SC,8);
      while(k<3 && r<nrec){
        let o:i32=r*16;
        if(pz_get(REC,o)==code){
          pz_e(SC,TXT,"    eg a=");
          pz_ei(SC,TXT,pz_get(REC,o+4));
          pz_e(SC,TXT," b=");
          pz_ei(SC,TXT,pz_get(REC,o+8));
          pz_e(SC,TXT," c=");
          pz_ei(SC,TXT,pz_get(REC,o+12));
          pz_enl(SC,TXT);
          k=k+1;
        }
        r=r+1;
      }
    }
    code=code+1;
  }
  return;
}
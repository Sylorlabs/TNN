// exp_pz_diff.zag -- PROPERTY-ZAG differential arm (charter 165).
// Concatenated after the c8 learner stack (c8_base + c8_world + c8_learn,
// utility symbols renamed) + pz_* library.
//
// TWO IMPLEMENTATIONS CLAIM THE SAME SEMANTICS:
//   RETRIEVE : ret_gen (full scan, no index)  vs  ret_spec (learner-owned
//              indexed)                       vs  pz_or_ret (lane oracle)
//   VERIFY   : vfy_gen                        vs  vfy_spec vs pz_or_vfy
//   COUNT    : cnt_gen                        vs  cnt_spec vs pz_or_cnt
//
// STANDING RULE: the older implementation is NOT ground truth. Every
// two-way disagreement is reported, and adjudication is against the lane
// oracle plus the printed minimal case.

fn pz_hline2(SC:[]u8,TXT:[]u8,s:[]u8)void { pz_e(SC,TXT,s); pz_enl(SC,TXT); return; }

// count the entries the implementation actually wrote into out[oo+4..]
fn written(out:[]u8,oo:i32,n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n && i<64){
    if(pz_get(out,oo+4+i*4)!=0){ c=c+1; }
    i=i+1;
  }
  return c;
}

fn main()i32 {
  let TXT:[]u8=pz_alloc(262144);
  let SC:[]u8=pz_alloc(256);
  let S:[]u8=pz_alloc(8);
  let A:[]u8=z8_alloc(4096);
  let A2:[]u8=z8_alloc(4096);
  let L:[]u8=z8_alloc(16384);
  let C:[]u8=z8_alloc(512);
  let KB:[]u8=z8_alloc(8);
  let O1:[]u8=z8_alloc(1024);
  let O2:[]u8=z8_alloc(1024);
  let O3:[]u8=z8_alloc(1024);
  let SB:[]u8=z8_alloc(64);
  let SEEN:[]u8=z8_alloc(8192);
  let seen2:[]u8=z8_alloc(8192);
  let VO:[]u8=z8_alloc(8);
  let WK:[]u8=pz_alloc(32768);
  let RREC:[]u8=pz_alloc(3072);
  pz_beg(SC);
  pz_hline2(SC,TXT,"PZ-DIFF differential arm: gen vs spec vs lane-oracle");

  // ------------------------------------------------ P6 ret_gen truncation
  pz_hline2(SC,TXT,"=== P6 ret_gen silent output truncation (>32 subjects share rel,obj) ===");
  z8_set32(A,0,0);
  let i:i32=0;
  while(i<40){ fact_add(A,100+i,55,900); i=i+1; }
  let n_gen:i32=ret_gen(A,55,900,KB,0,O1,0);
  let w_gen:i32=written(O1,0,64);
  pz_or_ret(A,55,900,O3,0);
  pz_or_ret(A,55,900,O3,0);
  let n_or:i32=pz_get(O3,0);
  pz_e(SC,TXT,"P6 subjects=40 ret_gen-returned="); pz_ei(SC,TXT,n_gen);
  pz_e(SC,TXT," ret_gen-actually-wrote="); pz_ei(SC,TXT,w_gen);
  pz_e(SC,TXT," oracle-returned="); pz_ei(SC,TXT,n_or);
  pz_e(SC,TXT," TRUNCATED=");
  let tr:i32=0;
  if(n_gen!=w_gen){ tr=1; }
  pz_ei(SC,TXT,tr);
  pz_enl(SC,TXT);

  // ------------------------------------------------ P7 cnt_gen saturation
  pz_hline2(SC,TXT,"=== P7 cnt_gen silent count truncation (>64 distinct objects) ===");
  z8_set32(A2,0,0);
  i=0;
  while(i<65){ fact_add(A2,7,66,200+i); i=i+1; }
  z8_set32(SB,0,7);
  let c_gen:i32=cnt_gen(A2,66,SB,0,1,KB,0,SEEN);
  pz_or_cnt(A2,66,SB,0,1,seen2);
  let c_or:i32=pz_get(seen2,4000);
  pz_e(SC,TXT,"P7 distinct-objects=65 cnt_gen-returned="); pz_ei(SC,TXT,c_gen);
  pz_e(SC,TXT," oracle-returned="); pz_ei(SC,TXT,c_or);
  pz_e(SC,TXT," cnt_gen-WRONG=");
  let cw:i32=0;
  if(c_gen!=c_or){ cw=1; }
  pz_ei(SC,TXT,cw);
  pz_enl(SC,TXT);

  // ------------------------------------------- seeded three-way comparison
  pz_hline2(SC,TXT,"=== seeded three-way comparison, seeds 501..515 ===");
  let seed:i32=501;
  let agreeR:i32=0;
  let disR:i32=0;
  let agreeV:i32=0;
  let disV:i32=0;
  let agreeC:i32=0;
  let disC:i32=0;
  let staleR:i32=0;
  let selStale:i32=0;
  while(seed<=515){
    pz_stream(S,501,seed-500);
    // world: 3 relations, chains plus a distractor load
    z8_set32(A,0,0);
    let r:i32=0;
    while(r<3){
      let rel:i32=300+r;
      let c:i32=0;
      while(c<6){
        fact_add(A,1000+r*20+c,rel,2000+r*20+c+1);
        c=c+1;
      }
      r=r+1;
    }
    let t:i32=0;
    while(t<10){
      let rel:i32=300+pz_rnd(S,3);
      fact_add(A,3000+pz_rnd(S,20),rel,4000+pz_rnd(S,20));
      t=t+1;
    }
    let L2:[]u8=z8_alloc(16384);
    let i2:i32=0;
    while(i2<16384){ L2[i2]=0; i2=i2+1; }
    ret_log_rel(L2,300);
    ret_log_rel(L2,301);
    cnt_log_rel(L2,300);
    cnt_log_rel(L2,301);
    vfy_log_rel(L2,300);
    specialize_ret(L2,A,0,0);
    specialize_cnt(L2,A,0,0);
    specialize_vfy(L2,A,0,0);
    // RET: covered relations 300/301 and uncovered 302
    let rel:i32=300;
    while(rel<=302){
      let ob:i32=2000;
      while(ob<2000+70){
        if(z8_get32(A,0)>0){
          let a:i32=ret_gen(A,rel,ob,KB,0,O1,0);
          let b:i32=ret_spec(L2,A,rel,ob,KB,0,O2,0);
          pz_or_ret(A,rel,ob,O3,0);
          let c:i32=pz_get(O3,0);
          if(b>=0){
            let same:i32=0;
            if(a==b && a==c){ same=1; }
            if(same==1){ agreeR=agreeR+1; } else {
              disR=disR+1;
              if(disR<6){
                pz_e(SC,TXT,"DISAGREE-RET seed="); pz_ei(SC,TXT,seed);
                pz_e(SC,TXT," rel="); pz_ei(SC,TXT,rel);
                pz_e(SC,TXT," obj="); pz_ei(SC,TXT,ob);
                pz_e(SC,TXT," gen="); pz_ei(SC,TXT,a);
                pz_e(SC,TXT," spec="); pz_ei(SC,TXT,b);
                pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,c);
                pz_enl(SC,TXT);
              }
            }
          }
        }
        ob=ob+1;
      }
      rel=rel+1;
    }
    // VERIFY: a chain that holds, then one that does not
    chain_clear(C);
    chain_add(C,1000,300,2001);
    chain_add(C,1001,300,2002);
    let vg:i32=vfy_gen(A,C,KB,0);
    let vs:i32=vfy_spec(L2,A,C,KB,0);
    pz_or_vfy(A,C,VO);
    let vo:i32=pz_get(VO,0);
    if(vg==vs && vg==vo){ agreeV=agreeV+1; } else { disV=disV+1; }
    if(vo!=vs || vg!=vo){
      pz_e(SC,TXT,"DISAGREE-VFY-POS seed="); pz_ei(SC,TXT,seed);
      pz_e(SC,TXT," gen="); pz_ei(SC,TXT,vg);
      pz_e(SC,TXT," spec="); pz_ei(SC,TXT,vs);
      pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,vo);
      pz_enl(SC,TXT);
    }
    chain_clear(C);
    chain_add(C,1000,300,2001);
    chain_add(C,1999,300,2002);
    let wg:i32=vfy_gen(A,C,KB,0);
    let ws:i32=vfy_spec(L2,A,C,KB,0);
    pz_or_vfy(A,C,VO);
    let wo:i32=pz_get(VO,0);
    if(wg==ws && wg==wo){ agreeV=agreeV+1; } else { disV=disV+1; }
    if(wo!=ws || wg!=wo){
      pz_e(SC,TXT,"DISAGREE-VFY-NEG seed="); pz_ei(SC,TXT,seed);
      pz_e(SC,TXT," gen="); pz_ei(SC,TXT,wg);
      pz_e(SC,TXT," spec="); pz_ei(SC,TXT,ws);
      pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,wo);
      pz_enl(SC,TXT);
    }
    // COUNT
    z8_set32(SB,0,1000); z8_set32(SB,4,1001);
    let cg:i32=cnt_gen(A,300,SB,0,2,KB,0,SEEN);
    let cs:i32=cnt_spec(L2,A,300,SB,0,2,KB,0,SEEN);
    pz_or_cnt(A,300,SB,0,2,seen2);
    let co:i32=pz_get(seen2,4000);
    if(cg==cs && cg==co){ agreeC=agreeC+1; } else {
      disC=disC+1;
      pz_e(SC,TXT,"DISAGREE-CNT seed="); pz_ei(SC,TXT,seed);
      pz_e(SC,TXT," gen="); pz_ei(SC,TXT,cg);
      pz_e(SC,TXT," spec="); pz_ei(SC,TXT,cs);
      pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,co);
      pz_enl(SC,TXT);
    }
    seed=seed+1;
  }
  pz_e(SC,TXT,"SEEDED-WORLDS n=15 RET agree="); pz_ei(SC,TXT,agreeR);
  pz_e(SC,TXT," disagree="); pz_ei(SC,TXT,disR);
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"SEEDED-WORLDS n=15 VFY agree="); pz_ei(SC,TXT,agreeV);
  pz_e(SC,TXT," disagree="); pz_ei(SC,TXT,disV);
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"SEEDED-WORLDS n=15 CNT agree="); pz_ei(SC,TXT,agreeC);
  pz_e(SC,TXT," disagree="); pz_ei(SC,TXT,disC);
  pz_enl(SC,TXT);

  // ------------------------------------------------ P5 stale coverage index
  pz_hline2(SC,TXT,"=== P5 stale coverage index after new facts arrive ===");
  pz_stream(S,901,7);
  z8_set32(A,0,0);
  let c2:i32=0;
  while(c2<5){ fact_add(A,500+c2,700,900+c2+1); c2=c2+1; }
  let L3:[]u8=z8_alloc(16384);
  let i3:i32=0;
  while(i3<16384){ L3[i3]=0; i3=i3+1; }
  ret_log_rel(L3,700);
  specialize_ret(L3,A,0,0);
  z8_set32(SB,0,900);
  let before_gen:i32=ret_gen(A,700,900,KB,0,O1,0);
  let before_spec:i32=ret_spec(L3,A,700,900,KB,0,O2,0);
  let ver_before:i32=ret_version(L3,700);
  // new facts arrive for the ALREADY COVERED relation
  let c3:i32=0;
  while(c3<3){ fact_add(A,600+c3,700,900); c3=c3+1; }
  let after_gen:i32=ret_gen(A,700,900,KB,0,O1,0);
  let after_spec:i32=ret_spec(L3,A,700,900,KB,0,O2,0);
  pz_or_ret(A,700,900,O3,0);
  let after_or:i32=pz_get(O3,0);
  let ver_after:i32=ret_version(L3,700);
  pz_e(SC,TXT,"P5 before-add gen="); pz_ei(SC,TXT,before_gen);
  pz_e(SC,TXT," spec="); pz_ei(SC,TXT,before_spec);
  pz_e(SC,TXT," selected-version="); pz_ei(SC,TXT,ver_before);
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"P5 after-3-new-facts gen="); pz_ei(SC,TXT,after_gen);
  pz_e(SC,TXT," spec="); pz_ei(SC,TXT,after_spec);
  pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,after_or);
  pz_e(SC,TXT," selected-version="); pz_ei(SC,TXT,ver_after);
  pz_enl(SC,TXT);
  pz_e(SC,TXT,"P5 STALE=");
  if(after_spec!=after_or){ staleR=1; }
  pz_ei(SC,TXT,staleR);
  pz_e(SC,TXT," STILL-SELECTS-STALE=");
  if(ver_after==2 && after_spec!=after_or){ selStale=1; }
  pz_ei(SC,TXT,selStale);
  pz_enl(SC,TXT);
  // REPAIR: rebuild the index from the world, then re-compare
  specialize_ret(L3,A,0,0);
  let fixed_spec:i32=ret_spec(L3,A,700,900,KB,0,O2,0);
  pz_e(SC,TXT,"P5 after-index-rebuild spec="); pz_ei(SC,TXT,fixed_spec);
  pz_e(SC,TXT," oracle="); pz_ei(SC,TXT,after_or);
  pz_e(SC,TXT," REPAIRED=");
  let rp:i32=0;
  if(fixed_spec==after_or){ rp=1; }
  pz_ei(SC,TXT,rp);
  pz_enl(SC,TXT);

  // ------------------------------------- c15 record-mode battery (charter 112)
  pz_hline2(SC,TXT,"=== c15 record-mode arena: invariant battery and generators ===");
  let DC:[]u8=pz_desc_c15();
  let A3:[]u8=z8_alloc(4096);
  let seed2:i32=1;
  let tot2:i32=0;
  let bad2:i32=0;
  while(seed2<=63){
    z8_set32(A3,0,0);
    pz_stream(S,1,seed2);
    pz_gen_world(A3,S,8,3,4,400,5);
    let v:i32=pz_scan(A3,DC,WK,RREC,TXT,SC);
    tot2=tot2+v;
    if(v>0){ bad2=bad2+1; }
    seed2=seed2+1;
  }
  pz_e(SC,TXT,"C15 well-formed generator seeds=63 seeds-with-violations=");
  pz_ei(SC,TXT,bad2);
  pz_e(SC,TXT," total-violations="); pz_ei(SC,TXT,tot2);
  pz_enl(SC,TXT);
  // malformed reference injection: a zero field in a live record
  z8_set32(A3,0,0);
  pz_gen_world(A3,S,8,3,4,400,5);
  z8_set32(A3,4+2*12+8,0);
  let v1:i32=pz_scan(A3,DC,WK,RREC,TXT,SC);
  pz_e(SC,TXT,"C15 malformed-record(zero object) detect-violations=");
  pz_ei(SC,TXT,v1);
  pz_enl(SC,TXT);
  pz_report(RREC,SC,TXT,"C15-MALFORMED");
  let act2:i32=pz_act(A3,DC,RREC,SC,TXT);
  let v2:i32=pz_scan(A3,DC,WK,RREC,TXT,SC);
  pz_e(SC,TXT,"C15 contain actions="); pz_ei(SC,TXT,act2);
  pz_e(SC,TXT," post-violations="); pz_ei(SC,TXT,v2);
  pz_enl(SC,TXT);
  // capacity saturation: the next fact_add is dropped with no diagnostic
  z8_set32(A3,0,0);
  let f:i32=0;
  while(f<128){ fact_add(A3,10+f,1,20+f); f=f+1; }
  let v3:i32=pz_scan(A3,DC,WK,RREC,TXT,SC);
  fact_add(A3,999,1,998);
  let cnt:i32=z8_get32(A3,0);
  pz_e(SC,TXT,"C15 at-capacity detect-violations="); pz_ei(SC,TXT,v3);
  pz_e(SC,TXT," after-overflow-add count="); pz_ei(SC,TXT,cnt);
  pz_e(SC,TXT," SILENT-DROP=");
  let sd:i32=0;
  if(cnt==128){ sd=1; }
  pz_ei(SC,TXT,sd);
  pz_enl(SC,TXT);
  pz_report(RREC,SC,TXT,"C15-AT-CAPACITY");

  pz_eflush(SC,TXT);
  let by:i32=pz_get(SC,4);
  if(by<1){ _zag_print("PZ_DIFF_OUTPUT_EMPTY_FAIL\n"); return 1; }
  _zag_print("PZ-DIFF emitted-bytes=");
  _zag_print(_zag_i64_to_str(by as i64));
  return 0;
}
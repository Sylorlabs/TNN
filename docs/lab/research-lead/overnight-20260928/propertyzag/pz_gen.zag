// pz_gen.zag -- PROPERTY-ZAG structure generators.
//
// Pure Zag, deterministic. No floats, no arrays, no library RNG. All
// randomness comes from the xorshift32 stream in pz_lib.zag, seeded from the
// preregistered seed schedule (PREREG section 4). Every emitted diagnostic
// carries its seed so any failure replays from that seed alone.
//
// Generators produce CLASSES of structure, not enumerated cases:
//   pz_gen_graph    random node count, tag assignment, edge count, edge kinds
//   pz_gen_facts    random fact store for record-mode arenas
//   pz_gen_inject   malformed-reference injection, 6 families
//   pz_gen_perm     Fisher-Yates permutation of a domain (renaming maps)
//   pz_gen_reorder  Fisher-Yates reorder of a record array
//   pz_gen_world    random world: random relation assignment over a random
//                   graph topology with chains, random distractor load and
//                   random extra edges

// -------------------------------------------------- random graph topology
// Allocates n nodes with random legal tags and m edges with random legal
// kinds. Two modes:
//   well=1  WELL-FORMED topology: sequence-kind edges run strictly forward
//           (i -> i+1) so the dependency relation is a forest, and every
//           learned-tag node is given a provenance edge. The battery MUST be
//           silent on this output (kill bar K4 across the seed schedule).
//   well=0  ADVERSARIAL topology: unrestricted endpoints and kinds. The
//           battery is expected to fire; the per-code mix is the measurement.
fn pz_gen_graph(W:[]u8,D:[]u8,S:[]u8,n:i32,m:i32,well:i32)[]u8 {
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let n0:i32=pz_get(D,PZ_D_NOLO())+pz_get(D,PZ_D_RESV());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sk:i32=pz_get(D,PZ_D_SEQK());
  let dep:i32=pz_get(D,PZ_D_DEP());
  let lt:i32=pz_get(D,PZ_D_LEARN());
  let i:i32=0;
  while(i<n && n0+i<nc){
    let idx:i32=n0+i;
    pz_nset(W,D,idx,al,1);
    let t:i32=pz_rnd(S,17);
    if(t<9){ t=1; }
    if(t>=9 && t<12){ t=20; }
    if(t>=12 && t<14){ t=101; }
    if(t>=14){ t=102; }
    pz_nset(W,D,idx,tf,t);
    // tag-legal operand shapes: the reference rules in the descriptor are the
    // contract, so the generator must satisfy them.
    let fb:i32=pz_get(D,PZ_D_FBASE());
    if(t==101 || t==103 || t==104){ pz_nset(W,D,idx,1,fb); }
    if(t==102){
      pz_nset(W,D,idx,1,pz_rnd(S,900));
      pz_nset(W,D,idx,2,pz_rnd(S,900));
      pz_nset(W,D,idx,3,idx);
      pz_nset(W,D,idx,4,idx);
    }
    if(t!=101 && t!=102 && t!=103 && t!=104){
      pz_nset(W,D,idx,1,pz_rnd(S,900));
    }
    let f:i32=pz_get(D,PZ_D_VF0());
    let k:i32=0;
    while(k<pz_get(D,PZ_D_NVF())){
      pz_nset(W,D,idx,f+k,pz_rnd(S,900));
      k=k+1;
    }
    i=i+1;
  }
  let used:i32=0;
  let j:i32=0;
  while(j<m && used<ec){
    let a:i32=n0+pz_rnd(S,n);
    let kd:i32=1+pz_rnd(S,13);
    let clk:i32=pz_rnd(S,20);
    if(well==1 && kd==sk && n>1){
      // forward forest edge with a source no other sequence edge uses, so the
      // dependency relation is a forest with single-writer nodes
      let aa:i32=n0+pz_rnd(S,n-1);
      let tries:i32=0;
      let clash:i32=1;
      while(clash==1 && tries<8){
        clash=0;
        let t:i32=0;
        while(t<used){
          if(pz_ew(W,D,t,1)==sk){
            if(pz_ew(W,D,t,0)==aa){ clash=1; }
          }
          t=t+1;
        }
        tries=tries+1;
      }
      if(clash==0){
        pz_eset(W,D,used,0,aa); pz_eset(W,D,used,1,sk);
        pz_eset(W,D,used,2,aa+1); pz_eset(W,D,used,3,0);
        used=used+1;
        j=j+1;
        continue;
      }
      pz_eset(W,D,used,0,a); pz_eset(W,D,used,1,dep);
      pz_eset(W,D,used,2,n0); pz_eset(W,D,used,3,0);
      used=used+1;
      j=j+1;
      continue;
    }
    let b:i32=n0+pz_rnd(S,n);
    pz_eset(W,D,used,0,a); pz_eset(W,D,used,1,kd);
    pz_eset(W,D,used,2,b); pz_eset(W,D,used,3,clk);
    used=used+1;
    j=j+1;
  }
  if(well==1 && dep>0 && lt>=0){
    let q:i32=0;
    while(q<n && n0+q<nc && used<ec){
      if(pz_n(W,D,n0+q,tf)==lt){
        let prov:i32=0;
        let s:i32=0;
        while(s<used){
          if(pz_ew(W,D,s,1)==dep){
            if(pz_ew(W,D,s,2)==n0+q){ prov=1; }
            if(pz_ew(W,D,s,0)==n0+q){ prov=1; }
          }
          s=s+1;
        }
        if(prov==0){
          pz_eset(W,D,used,0,n0+q); pz_eset(W,D,used,1,dep);
          pz_eset(W,D,used,2,n0); pz_eset(W,D,used,3,0);
          used=used+1;
        }
      }
      q=q+1;
    }
  }
  pz_set(W,pz_get(D,PZ_D_LCNT()),n);
  pz_set(W,pz_get(D,PZ_D_ECNT()),used);
  return W;
}

// ------------------------------------------- malformed-reference injection
// Families (charter 113):
//   0 CORRUPTED-NODE      an illegal tag on a live node
//   1 STALE-INDEX         a header counter that disagrees with the tables
//   2 CYCLIC-DEPENDENCY   a sequence edge that closes a cycle
//   3 MALFORMED-PROCEDURE a cell whose frame operand is a bare node index
//   4 MISSING-DEPENDENCY  the provenance edge of a learned node is removed
//   5 INVALID-REFERENCE   an edge endpoint pointed at a dead node
// Returns the index it damaged, so a minimal reproducer can name it.
fn pz_gen_inject(W:[]u8,D:[]u8,S:[]u8,family:i32)[]u8 {
  let nc:i32=pz_get(D,PZ_D_NCAP());
  let n0:i32=pz_get(D,PZ_D_NOLO())+pz_get(D,PZ_D_RESV());
  let al:i32=pz_get(D,PZ_D_ALIVE());
  let tf:i32=pz_get(D,PZ_D_TAGF());
  let ec:i32=pz_get(D,PZ_D_ECAP());
  let sent:i32=pz_get(D,PZ_D_SENT());
  let sk:i32=pz_get(D,PZ_D_SEQK());
  let dep:i32=pz_get(D,PZ_D_DEP());
  let lt:i32=pz_get(D,PZ_D_LEARN());
  let live0:i32=pz_get(W,pz_get(D,PZ_D_LCNT()));
  if(live0<3){ live0=3; }
  let v:i32=n0+pz_rnd(S,live0);
  if(family==0){
    pz_nset(W,D,v,tf,1023);
  }
  if(family==1){
    let hc:i32=pz_get(W,pz_get(D,PZ_D_ECNT()));
    pz_set(W,pz_get(D,PZ_D_ECNT()),hc-3);
  }
  if(family==2){
    // close a cycle a->b, b->a on the sequence kind, in the first two free
    // edge slots, so the injection is minimal and exactly two edges wide.
    let a:i32=n0+pz_rnd(S,live0);
    let b:i32=n0+pz_rnd(S,live0);
    if(a==b){ b=b+1; if(b>=nc){ b=n0; } }
    let e:i32=0;
    let w:i32=0;
    while(e<ec && w<2){
      if(pz_ew(W,D,e,0)==sent){
        pz_eset(W,D,e,0,a); pz_eset(W,D,e,1,sk);
        pz_eset(W,D,e,2,b); pz_eset(W,D,e,3,0);
        w=w+1;
      }
      e=e+1;
    }
  }
  if(family==3){
    pz_nset(W,D,v,0,101);
    pz_nset(W,D,v,1,v);
  }
  if(family==4){
    // make v a learned node with no provenance edge
    pz_nset(W,D,v,tf,lt);
    let e:i32=0;
    while(e<ec){
      if(pz_ew(W,D,e,0)==sent){ break; }
      e=e+1;
    }
    return W;
  }
  if(family==5){
    // point exactly ONE free edge at a dead node: a minimal invalid reference
    let dead:i32=n0+live0;
    if(dead<nc){ pz_nset(W,D,dead,al,0); }
    let e:i32=0;
    let done:i32=0;
    while(e<ec && done==0){
      if(pz_ew(W,D,e,0)==sent){
        pz_eset(W,D,e,0,v); pz_eset(W,D,e,1,1); pz_eset(W,D,e,2,dead); pz_eset(W,D,e,3,0);
        done=1;
      }
      e=e+1;
    }
  }
  if(dep>0){ }
  if(family==6){
    // BATTERY SOUNDNESS INJECTION: an illegal liveness flag (PZ-I01)
    pz_nset(W,D,v,al,7);
  }
  if(family==7){
    // BATTERY SOUNDNESS INJECTION: an impossible edge kind (PZ-I05)
    let e:i32=0;
    let done:i32=0;
    while(e<ec && done==0){
      if(pz_ew(W,D,e,0)==sent){
        pz_eset(W,D,e,0,v); pz_eset(W,D,e,1,999); pz_eset(W,D,e,2,v); pz_eset(W,D,e,3,0);
        done=1;
      }
      e=e+1;
    }
  }
  if(family==8){
    // BATTERY SOUNDNESS INJECTION: a frame-child cycle a -> b -> a
    // (operands are D_FBASE + node index, so this is a cycle in PZ-I08)
    let fb:i32=pz_get(D,PZ_D_FBASE());
    let n0b:i32=pz_get(D,PZ_D_NOLO())+pz_get(D,PZ_D_RESV());
    let a:i32=n0b;
    let b:i32=n0b+1;
    if(b>=nc){ return W; }
    pz_nset(W,D,a,0,902); pz_nset(W,D,a,1,fb+b);
    pz_nset(W,D,b,0,902); pz_nset(W,D,b,1,fb+a);
  }
  if(family==9){
    // BATTERY SOUNDNESS INJECTION: a frame operand whose decoded slot leaves
    // the node table and therefore aliases another record table (PZ-I09)
    let fb:i32=pz_get(D,PZ_D_FBASE());
    pz_nset(W,D,v,0,101);
    pz_nset(W,D,v,1,fb+nc);
  }
  return W;
}

// ------------------------------------------------------ permutations
// Fisher-Yates over the identity map stored at off, domain [0,n).
fn pz_gen_perm(S:[]u8,B:[]u8,off:i32,n:i32)[]u8 {
  let i:i32=0;
  while(i<n){ pz_set(B,off+i*4,i); i=i+1; }
  let j:i32=n-1;
  while(j>0){
    let k:i32=pz_rnd(S,j+1);
    let a:i32=pz_get(B,off+j*4);
    let b:i32=pz_get(B,off+k*4);
    pz_set(B,off+j*4,b); pz_set(B,off+k*4,a);
    j=j-1;
  }
  return B;
}
fn pz_mapp(P:[]u8,off:i32,n:i32,v:i32)i32 {
  if(v<0){ return v; }
  if(v>=n){ return v; }
  return pz_get(P,off+v*4);
}
// reorder a record array in place (12-byte records, field 0 is the sort key)
// using a scratch copy, so no record is lost.
fn pz_gen_reorder(S:[]u8,A:[]u8,sc:[]u8,n:i32)[]u8 {
  let i:i32=0;
  while(i<n){ pz_set(sc,i*12,pz_get(A,i*12)); pz_set(sc,i*12+4,pz_get(A,i*12+4)); pz_set(sc,i*12+8,pz_get(A,i*12+8)); i=i+1; }
  let j:i32=n-1;
  while(j>0){
    let k:i32=pz_rnd(S,j+1);
    let f:i32=0;
    while(f<12){ let a:i32=pz_get(sc,j*12+f); let b:i32=pz_get(sc,k*12+f); pz_set(sc,j*12+f,b); pz_set(sc,k*12+f,a); f=f+1; }
    j=j-1;
  }
  i=0;
  while(i<n){ pz_set(A,i*12,pz_get(sc,i*12)); pz_set(A,i*12+4,pz_get(sc,i*12+4)); pz_set(A,i*12+8,pz_get(sc,i*12+8)); i=i+1; }
  return A;
}

// ------------------------------------------------------ random worlds
// Record-mode fact store A (header cell 0 = count, 12B records at 4+j*12).
// Layout: [nrel] relation blocks; each relation r in [rbase, rbase+nrel) gets
// a chain family of length clen over shared subjects plus nd extra random
// (subject, object) facts, all with opaque integer ids.
fn pz_gen_world(A:[]u8,S:[]u8,nsub:i32,nrel:i32,nd:i32,rbase:i32,clen:i32)[]u8 {
  pz_set(A,0,0);
  let r:i32=0;
  while(r<nrel){
    let rel:i32=rbase+r;
    let c:i32=0;
    while(c<clen){
      pz_fact(A,rbase+r*(clen+nd)+c,rel,rbase+r*(clen+nd)+(c+1));
      c=c+1;
    }
    r=r+1;
  }
  let t:i32=0;
  while(t<nd){
    let rel:i32=rbase+pz_rnd(S,nrel);
    pz_fact(A,rbase+nrel*(clen+nd)+t,rel,rbase+nrel*(clen+nd)+(1+pz_rnd(S,7)));
    t=t+1;
  }
  return A;
}
fn pz_fact(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=pz_get(A,0);
  if(n<128){
    pz_set(A,4+n*12,s); pz_set(A,4+n*12+4,r); pz_set(A,4+n*12+8,o);
    pz_set(A,0,n+1);
  }
  return;
}
// =====================================================================
// ADDITIVE SECTION (c9, COGOPS-DETECTION). Appended to the frozen
// c8_learn.zag prefix without modifying any frozen function.
// Learner-assembled oscillation detection.
//
// The researcher-provided recurrence scan is NOT
// called anywhere below. Detection is assembled by the learner
// from single-pair traj_state_eq comparisons, proposed in an
// order the learner-state lag prior determines.
//
// DETC region (additive, no frozen region moved):
//   15900: lag prior (durable learner state; 0 = none)
//   15904: retracted lag (per-run)
//   15908: event count ntev (per-run)
//   15912 + tev*20: event ring, tev < 16, 5 words each
//     [kind, p, x, y, z]
//     kind 0 = CMP (p=pass, x=i, y=j, z=eq; z=-1 means the
//       prior pair was inapplicable at this pass, skipped)
//     kind 1 = HYP (p=pass, x=lag, y=q)
//     kind 3 = PRIOR (x=prior at detection start)
//     kind 4 = SET (x=prior after verification)
//     kind 5 = APPLY (p=pass, x=needs matched, y=needs total)
//     kind 6 = RETRACT (p=confirm pass, x=retracted lag;
//       implemented, not exercised by this battery)
// No world literals, no goal tags, no need tags, no relation
// ids appear below: every value arrives at runtime through
// goal records or the trajectory. Structural offsets only.
// =====================================================================

// log one detection event into the DET ring
fn det_ev(L:[]u8,kind:i32,p:i32,x:i32,y:i32,z:i32)void {
  let ntev:i32=get32(L,15908);
  if(ntev>15){ return; }
  let b:i32=15912+ntev*20;
  set32(L,b,kind);
  set32(L,b+4,p);
  set32(L,b+8,x);
  set32(L,b+12,y);
  set32(L,b+16,z);
  set32(L,15908,ntev+1);
  return;
}
// det_try: propose one snapshot pair (pass,b) with lag lagp.
// Returns 0 (no hypothesis), 1 (hypothesis verified; R set),
// 2 (hypothesis retracted after a failed confirm), 3
// (quiescence: lag 1 is a fixpoint, not an oscillation).
fn det_try(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,b:i32,lagp:i32)i32 {
  let retlag:i32=get32(L,15904);
  let skip:i32=0;
  if(retlag!=0){ if(lagp==retlag){ skip=1; } }
  if(skip==1){ return 0; }
  let eq:i32=traj_state_eq(L,pass,b,nn);
  det_ev(L,0,pass,pass,b,eq);
  if(eq==0){ return 0; }
  if(lagp==1){ return 3; }
  det_ev(L,1,pass,lagp,b,0);
  osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
  traj_log(L,OUTS,nn,pass+1);
  let ok:i32=traj_state_eq(L,pass+1,b+1,nn);
  if(ok==1){
    let ee:i32=outc_store(L,gt,lagp,b,nn,0);
    set32(L,15900,lagp);
    det_ev(L,4,0,lagp,0,0);
    set32(R,0,1);
    set32(R,4,pass+2);
    set32(R,8,lagp);
    set32(R,12,b);
    set32(R,16,lagp);
    set32(R,20,0);
    set32(R,24,ee);
    return 1;
  }
  det_ev(L,6,pass+1,lagp,0,0);
  set32(L,15904,lagp);
  return 2;
}
// det_propose_pass: the learner's proposal round for one pass.
// Slot 0 is the prior pair (the learner-state prior decides the
// first comparison); slots 1..3 are recency order. Returns 0
// (nothing), 1 (verified), 2 (retracted; the confirm consumed
// pass+1), 3 (quiescence).
fn det_propose_pass(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,nn:i32,gt:i32,pass:i32,prior:i32)i32 {
  if(prior!=0){
    let b0:i32=pass-prior;
    if(b0<0){ det_ev(L,0,pass,pass,b0,-1); }
    if(b0>=0){
      let r0:i32=det_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,b0,prior);
      if(r0!=0){ return r0; }
    }
  }
  let bi:i32=1;
  let out:i32=0;
  while(bi<4){
    if(out==0){
      let b:i32=pass-bi;
      let dup:i32=0;
      if(prior!=0){ if(b==pass-prior){ dup=1; } }
      let go:i32=0;
      if(b>=0){ if(dup==0){ go=1; } }
      if(go==1){
        out=det_try(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,b,bi);
      }
    }
    bi=bi+1;
  }
  return out;
}
// det_handle: the learner-owned oscillation-detection driver.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a checker invented from this run's trajectory,
// 2 handled by a stored checker from the outcome record.
// The researcher-provided scan is never called: every
// comparison below is a single learner-proposed pair.
fn det_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let vbuf:[]u8=z_alloc(32);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  let gt:i32=g_tag(G);
  let pre:i32=plan_find(L,gt);
  let pi:i32=pre;
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
  }
  if(pi<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  let nn:i32=get32(L,13000+pi*56+4);
  mat_inputs(G,W);
  set32(L,15904,0);
  set32(L,15908,0);
  let e:i32=outc_find(L,gt);
  if(e>=0){
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
        traj_log(L,OUTS,nn,mpass);
        let jj:i32=0;
        let mm:i32=0;
        while(jj<nn){
          let meq:i32=outc_phase_eq(L,e,mpass,jj,mpass);
          if(meq==1){ mm=mm+1; }
          if(meq==0){ okk=0; }
          jj=jj+1;
        }
        det_ev(L,5,mpass,mm,nn,0);
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  det_ev(L,3,0,get32(L,15900),0,0);
  let pass:i32=0;
  while(pass<6){
    osc_one_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R);
    traj_log(L,OUTS,nn,pass);
    let r:i32=0;
    if(pass>1){
      r=det_propose_pass(L,A,G,pi,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,nn,gt,pass,get32(L,15900));
    }
    if(r==1){ return 1; }
    if(r==2){ pass=pass+1; }
    if(r==3){ return 0; }
    pass=pass+1;
  }
  return 0;
}

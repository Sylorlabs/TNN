// is_main.zag -- driver for the integration-stress battery.
// IS-SETUP re-establishes the integrated composer baseline (episodes,
// specializes, one diamond query with the all-generic oracle, binding
// contract dumps). Four adversarial stress stages follow: IS-B
// (coverage oscillation), IS-A (adversarial overlapping drift with a
// stale-admit wrong answer and revision recovery), IS-C (noisy
// counterevidence), IS-D (tag-shape collision mid-composition).
// All demo values are runtime-derived (tags from the binding
// directory, rels from contract clauses and vocab scans, objs/subjs
// from fact scans, goal tags derived from a constructed goal's
// runtime tag). All dynamic output goes through the single
// preallocated buffer B, flushed once at the end. No world literals
// in this file: the diamond goal comes from the named constructor in
// is_world.zag, and demo inputs come from contract clauses, vocab
// scans, and fact scans.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}

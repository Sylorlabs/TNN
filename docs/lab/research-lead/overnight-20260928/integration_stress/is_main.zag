// ---- binding-contract dump (B1): per-tag admission contracts ----
// Format: BCONTRACT tag=<t> induct=1 clause=(field,xform,lo,hi)
// active=<a> dc=<d>   or   BCONTRACT tag=<t> induct=0
fn dump_bcontracts(b:[]u8,c:i32,L:[]u8,S:[]u8)i32 {
  let bi:i32=0;
  while(bi<8){
    let tag:i32=get32(L,12744+bi*4);
    if(tag!=0){
      let cb:i32=2000+bi*100;
      c=o_app(b,c,"BCONTRACT tag=");
      c=o_i64(b,c,tag as i64);
      if(sg(S,cb+1)==1){
        c=o_app(b,c," induct=1 clause=(");
        c=o_i64(b,c,sg(S,cb+4) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+5) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+7) as i64);
        b[c]=44; c=c+1;
        c=o_i64(b,c,sg(S,cb+8) as i64);
        c=o_app(b,c,") active=");
        c=o_i64(b,c,sg(S,cb+9) as i64);
        c=o_app(b,c," dc=");
        c=o_i64(b,c,sg(S,cb+10) as i64);
      }
      if(sg(S,cb+1)==0){
        c=o_app(b,c," induct=0");
      }
      c=o_nl(b,c);
    }
    bi=bi+1;
  }
  return c;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one count episode ----
fn run_cntep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,id:i32,ep:i32)i32 {
  cnt_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let subj:i32=get32(rb,4);
  let n:i32=cnt_episode(L,A,rel,subj,K,tout,seen);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," cnt n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn oracle_dia(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns2:i32=need_f(G,2,0);
  let npass2:i32=0;
  let pass2:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub2:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns2);
    let i:i32=0;
    while(i<ns2){
      let s2:i32=need_f(G,2,1+i*3);
      if(s2==0){ s2=sub2; }
      set32(tmpc,4+i*12,s2);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv2:i32=vfy_gen(A,tmpc,K,4);
    if(vv2==1){
      set32(pass2,4+npass2*4,sub2);
      npass2=npass2+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass2);
  let q3:i32=0;
  while(q3<npass2){
    ans_append(oans,get32(pass2,4+q3*4));
    q3=q3+1;
  }
  let ns1:i32=need_f(G,1,0);
  let npass1:i32=0;
  let pass1:[]u8=z_alloc(160);
  let q4:i32=0;
  while(q4<nc){
    let sub1:i32=get32(tout,4+q4*4);
    set32(tmpc,0,ns1);
    let j:i32=0;
    while(j<ns1){
      let s1:i32=need_f(G,1,1+j*3);
      if(s1==0){ s1=sub1; }
      set32(tmpc,4+j*12,s1);
      set32(tmpc,4+j*12+4,need_f(G,1,1+j*3+1));
      set32(tmpc,4+j*12+8,need_f(G,1,1+j*3+2));
      j=j+1;
    }
    let vv1:i32=vfy_gen(A,tmpc,K,4);
    if(vv1==1){
      set32(pass1,4+npass1*4,sub1);
      npass1=npass1+1;
    }
    q4=q4+1;
  }
  ans_append(oans,npass1);
  let q5:i32=0;
  while(q5<npass1){
    ans_append(oans,get32(pass1,4+q5*4));
    q5=q5+1;
  }
  let rel3:i32=need_f(G,3,0);
  let cat:[]u8=z_alloc(160);
  let tot:i32=0;
  let q6:i32=0;
  while(q6<npass1){
    set32(cat,4+tot*4,get32(pass1,4+q6*4));
    tot=tot+1;
    q6=q6+1;
  }
  let q7:i32=0;
  while(q7<npass2){
    set32(cat,4+tot*4,get32(pass2,4+q7*4));
    tot=tot+1;
    q7=q7+1;
  }
  let ccd:i32=cnt_gen(A,rel3,cat,4,tot,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,ccd);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
fn do_query(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=compose(L,S,A,G,K,ans,vbuf);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  set32(K,4,0);
  if(okind==1){ oracle_dia(A,G,K,oans,seen); }
  if(okind==2){ oracle_1ret(A,G,K,oans,seen); }
  if(okind==3){ oracle_1vfy(A,G,K,oans,seen); }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  let a:i32=ans_eq(ans,oans);
  set32(L,13240,get32(L,13240)+a);
  set32(L,13244,get32(L,13244)+cs);
  set32(L,13248,get32(L,13248)+cg);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn:i32=get32(vbuf,16);
  let p:i32=0;
  while(p<nn){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Answer record matches the learner's [n, ints].
fn oracle_1ret(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_1vfy: independent all-generic reference for a single ----
// ---- VERIFY need. Answer record matches the learner's [1, vv].
fn oracle_1vfy(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  return;
}
// ---- zero the global contract counters for a clean per-stage reading ----
fn zero_counters(S:[]u8)void {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1);
  ss(S,912,0); ss(S,916,0); ss(S,920,0); ss(S,924,0);
  ss(S,7,500);
  return;
}
// ---- IS-B: oscillation stress. Four drift/revision cycles on the live
// ---- RET coverage contract, alternating worlds. Each cycle: probe the
// ---- absent clause-lo rel x3 (retire), clear only the L rel log, run
// ---- two fresh episodes on the new world, load the revise table and
// ---- u_revise. All rels runtime-derived from vocab scans.
fn demo_oscillate(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,rb:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let eid:i32=0;
  while(eid<4){
    ret_ep_pat(eid,rb,0);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    eid=eid+1;
  }
  specialize_ret(L,S,A,0,3);
  let avb:[]u8=z_alloc(64);
  let nav:i32=vocab_scan(A,avb);
  setup_worldB(A);
  let bvb:[]u8=z_alloc(64);
  let nbv:i32=vocab_scan(A,bvb);
  let cyc:i32=0;
  while(cyc<4){
    if(cyc==0){ setup_worldB(A); }
    if(cyc==1){ setup_worldA(A); }
    if(cyc==2){ setup_worldB(A); }
    if(cyc==3){ setup_worldA(A); }
    let cvb:[]u8=avb;
    let ncv:i32=nav;
    if(cyc==0){ cvb=bvb; ncv=nbv; }
    if(cyc==2){ cvb=bvb; ncv=nbv; }
    let rp:i32=sg(S,3000+7);
    let inb:i32=0;
    let q:i32=0;
    while(q<ncv){
      if(get32(cvb,q*4)==rp){ inb=1; }
      q=q+1;
    }
    let conseq:i32=0;
    if(inb==1){ conseq=1; }
    u_invalidate(S,3000,1,conseq);
    u_invalidate(S,3000,1,conseq);
    u_invalidate(S,3000,1,conseq);
    set32(L,0,0);
    let w0:i32=get32(L,0);
    let e2:i32=0;
    while(e2<2){
      let rl2:i32=get32(cvb,e2*4);
      let ob2:i32=first_obj(A,rl2);
      ret_episode(L,A,rl2,ob2,K,tout);
      e2=e2+1;
    }
    let n3:i32=get32(L,0);
    let ac3:[]u8=z_alloc(64);
    let na3:i32=0;
    let a3:i32=w0;
    while(a3<n3){
      set32(ac3,na3*4,get32(L,4+a3*4));
      na3=na3+1;
      a3=a3+1;
    }
    let uni:[]u8=z_alloc(128);
    let nu:i32=0;
    let u1:i32=0;
    while(u1<nav){
      set32(uni,nu*4,get32(avb,u1*4));
      nu=nu+1;
      u1=u1+1;
    }
    let u2:i32=0;
    while(u2<nbv){
      let r2b:i32=get32(bvb,u2*4);
      let k2:i32=0;
      let s2:i32=0;
      while(k2<nu){
        if(get32(uni,k2*4)==r2b){ s2=1; }
        k2=k2+1;
      }
      if(s2==0){
        set32(uni,nu*4,r2b);
        nu=nu+1;
      }
      u2=u2+1;
    }
    let rj3:[]u8=z_alloc(128);
    let nr3:i32=0;
    let u3:i32=0;
    while(u3<nu){
      let ru:i32=get32(uni,u3*4);
      let k3:i32=0;
      let s3:i32=0;
      while(k3<na3){
        if(get32(ac3,k3*4)==ru){ s3=1; }
        k3=k3+1;
      }
      if(s3==0){
        set32(rj3,nr3*4,ru);
        nr3=nr3+1;
      }
      u3=u3+1;
    }
    jt_load_cov(S,ac3,na3,rj3,nr3);
    u_revise(S,3000,1);
    c=o_app(b,c,"ISB-R");
    c=o_i64(b,c,(cyc+1) as i64);
    c=o_app(b,c," olderr=");
    c=o_i64(b,c,sg(S,924) as i64);
    c=o_app(b,c," revcount=");
    c=o_i64(b,c,sg(S,904) as i64);
    c=o_app(b,c," nclause=(");
    c=o_i64(b,c,sg(S,3000+4) as i64);
    b[c]=44; c=c+1;
    c=o_i64(b,c,sg(S,3000+5) as i64);
    b[c]=44; c=c+1;
    c=o_i64(b,c,sg(S,3000+7) as i64);
    b[c]=44; c=c+1;
    c=o_i64(b,c,sg(S,3000+8) as i64);
    c=o_app(b,c,")");
    if(cyc==0){
      c=o_app(b,c," r701=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r702=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,4),0,0,0,0,0) as i64);
      c=o_app(b,c," r601=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r602=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,4),0,0,0,0,0) as i64);
    }
    if(cyc==1){
      c=o_app(b,c," r601=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r602=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,4),0,0,0,0,0) as i64);
      c=o_app(b,c," r701=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r702=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,4),0,0,0,0,0) as i64);
    }
    if(cyc==2){
      c=o_app(b,c," r701=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r702=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,4),0,0,0,0,0) as i64);
      c=o_app(b,c," r601=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r602=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,4),0,0,0,0,0) as i64);
    }
    if(cyc==3){
      c=o_app(b,c," r601=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r602=");
      c=o_i64(b,c,u_check(S,3000,1,get32(avb,4),0,0,0,0,0) as i64);
      c=o_app(b,c," r701=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,0),0,0,0,0,0) as i64);
      c=o_app(b,c," r702=");
      c=o_i64(b,c,u_check(S,3000,1,get32(bvb,4),0,0,0,0,0) as i64);
    }
    c=o_nl(b,c);
    cyc=cyc+1;
  }
  c=o_app(b,c,"ISB-CNT total=");
  c=o_i64(b,c,sg(S,916) as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,sg(S,912) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," fiterr=");
  c=o_i64(b,c,sg(S,920) as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"ISB-SUMMARY revs=4 nclauses=");
  c=o_i64(b,c,sg(S,3000+3) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,3000+9) as i64);
  c=o_app(b,c," final=(");
  c=o_i64(b,c,sg(S,3000+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+8) as i64);
  c=o_app(b,c,")");
  c=o_nl(b,c);
  return c;
}
// ---- IS-A: adversarial overlapping drift. The drifted world keeps one
// ---- old rel with new facts and retires an interior rel of the old
// ---- clause interval. The stale contract admits the surviving rel,
// ---- the spec procedure runs on the stale bucket, and the query answer
// ---- is wrong end-to-end. Probes retire the clause; fresh episodes
// ---- and u_revise re-induct; buckets are rebuilt; queries recover.
fn demo_adv_drift(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,tout:[]u8,seen:[]u8,rb:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let eid:i32=0;
  while(eid<2){
    ret_ep_pat(eid,rb,0);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    eid=eid+1;
  }
  specialize_ret(L,S,A,0,1);
  let tagQ:i32=get32(L,12744+0*4);
  let relQ:i32=sg(S,3000+7);
  let objQ:i32=first_obj(A,relQ);
  let G0:[]u8=z_alloc(256);
  mk_goal813_E0(G0);
  let gtQ:i32=g_tag(G0)+3;
  let gtQ2:i32=gtQ+1;
  let G:[]u8=z_alloc(256);
  let o:i32=w_begin(G,gtQ,1);
  o=w_need(G,o,tagQ,2);
  o=w_f(G,o,relQ);
  o=w_f(G,o,objQ);
  o=w_links(G,o,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"Q1A",2);
  let avb:[]u8=z_alloc(64);
  let nav:i32=vocab_scan(A,avb);
  setup_worldC1(A);
  let o2:i32=w_begin(G,gtQ,1);
  o2=w_need(G,o2,tagQ,2);
  o2=w_f(G,o2,relQ);
  o2=w_f(G,o2,objQ);
  o2=w_links(G,o2,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"Q1B",2);
  let bvb:[]u8=z_alloc(64);
  let nbv:i32=vocab_scan(A,bvb);
  let rp:i32=sg(S,3000+8);
  let inb:i32=0;
  let q:i32=0;
  while(q<nbv){
    if(get32(bvb,q*4)==rp){ inb=1; }
    q=q+1;
  }
  let conseq:i32=0;
  if(inb==1){ conseq=1; }
  let ck0:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  let ck1:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  let ck2:i32=u_check(S,3000,1,rp,0,0,0,0,0);
  u_invalidate(S,3000,1,conseq);
  c=o_app(b,c,"ISA-PROBE rp=");
  c=o_i64(b,c,rp as i64);
  c=o_app(b,c," chk=");
  c=o_i64(b,c,ck0 as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,ck1 as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,ck2 as i64);
  c=o_app(b,c," inv=3 dc=");
  c=o_i64(b,c,sg(S,3000+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,3000+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_nl(b,c);
  let w0:i32=get32(L,0);
  let rl2:i32=get32(bvb,0);
  let ob2:i32=first_obj(A,rl2);
  ret_episode(L,A,rl2,ob2,K,tout);
  let n3:i32=get32(L,0);
  let ac3:[]u8=z_alloc(64);
  let na3:i32=0;
  let a3:i32=w0;
  while(a3<n3){
    set32(ac3,na3*4,get32(L,4+a3*4));
    na3=na3+1;
    a3=a3+1;
  }
  let uni:[]u8=z_alloc(128);
  let nu:i32=0;
  let u1:i32=0;
  while(u1<nav){
    set32(uni,nu*4,get32(avb,u1*4));
    nu=nu+1;
    u1=u1+1;
  }
  let u2:i32=0;
  while(u2<nbv){
    let r2b:i32=get32(bvb,u2*4);
    let k2:i32=0;
    let s2:i32=0;
    while(k2<nu){
      if(get32(uni,k2*4)==r2b){ s2=1; }
      k2=k2+1;
    }
    if(s2==0){
      set32(uni,nu*4,r2b);
      nu=nu+1;
    }
    u2=u2+1;
  }
  let rj3:[]u8=z_alloc(128);
  let nr3:i32=0;
  let u3:i32=0;
  while(u3<nu){
    let ru:i32=get32(uni,u3*4);
    let k3:i32=0;
    let s3:i32=0;
    while(k3<na3){
      if(get32(ac3,k3*4)==ru){ s3=1; }
      k3=k3+1;
    }
    if(s3==0){
      set32(rj3,nr3*4,ru);
      nr3=nr3+1;
    }
    u3=u3+1;
  }
  jt_load_cov(S,ac3,na3,rj3,nr3);
  u_revise(S,3000,1);
  c=o_app(b,c,"ISA-REV olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,3000+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,3000+8) as i64);
  c=o_app(b,c,") route701=");
  c=o_i64(b,c,u_check(S,3000,1,rl2,0,0,0,0,0) as i64);
  c=o_app(b,c," route601=");
  c=o_i64(b,c,u_check(S,3000,1,relQ,0,0,0,0,0) as i64);
  c=o_app(b,c," route602=");
  c=o_i64(b,c,u_check(S,3000,1,rp,0,0,0,0,0) as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"ISA-CNT total=");
  c=o_i64(b,c,sg(S,916) as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,sg(S,912) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," fiterr=");
  c=o_i64(b,c,sg(S,920) as i64);
  c=o_nl(b,c);
  ret_buckets_rebuild(L,A);
  let o3:i32=w_begin(G,gtQ,1);
  o3=w_need(G,o3,tagQ,2);
  o3=w_f(G,o3,relQ);
  o3=w_f(G,o3,objQ);
  o3=w_links(G,o3,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"Q1C",2);
  let relQ2:i32=sg(S,3000+7);
  let objQ2:i32=first_obj(A,relQ2);
  let o4:i32=w_begin(G,gtQ2,1);
  o4=w_need(G,o4,tagQ,2);
  o4=w_f(G,o4,relQ2);
  o4=w_f(G,o4,objQ2);
  o4=w_links(G,o4,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"Q2",2);
  return c;
}
// ---- IS-C: noisy counterevidence on a binding contract. One fail,
// ---- one confirm (resets), two fails (retire without latching the
// ---- revision request), then three consecutive fails (latch) and a
// ---- revise on real trials. The old commitment was correct, so the
// ---- revision restores the identical clause.
fn demo_noise(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let cb0:i32=2000+0*100;
  let tagN:i32=get32(L,12744+0*4);
  u_invalidate(S,cb0,1,0);
  let dc1:i32=sg(S,cb0+10);
  let act1:i32=sg(S,cb0+9);
  let run1:i32=sg(S,900);
  let req1:i32=sg(S,901);
  u_invalidate(S,cb0,1,1);
  let cdc:i32=sg(S,cb0+10);
  let crun:i32=sg(S,900);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  let dc2:i32=sg(S,cb0+10);
  let act2:i32=sg(S,cb0+9);
  let run2:i32=sg(S,900);
  let req2:i32=sg(S,901);
  c=o_app(b,c,"ISC-NOISE dc1=");
  c=o_i64(b,c,dc1 as i64);
  c=o_app(b,c," act1=");
  c=o_i64(b,c,act1 as i64);
  c=o_app(b,c," run1=");
  c=o_i64(b,c,run1 as i64);
  c=o_app(b,c," req1=");
  c=o_i64(b,c,req1 as i64);
  c=o_app(b,c," conf_dc=");
  c=o_i64(b,c,cdc as i64);
  c=o_app(b,c," conf_run=");
  c=o_i64(b,c,crun as i64);
  c=o_app(b,c," dc2=");
  c=o_i64(b,c,dc2 as i64);
  c=o_app(b,c," act2=");
  c=o_i64(b,c,act2 as i64);
  c=o_app(b,c," run2=");
  c=o_i64(b,c,run2 as i64);
  c=o_app(b,c," req2=");
  c=o_i64(b,c,req2 as i64);
  c=o_nl(b,c);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  let G9:[]u8=z_alloc(256);
  let o9:i32=w_begin(G9,0,1);
  o9=w_need(G9,o9,tagN,2);
  let relN:i32=sg(S,3200+7);
  o9=w_f(G9,o9,relN);
  o9=w_f(G9,o9,first_obj(A,relN));
  o9=w_links(G9,o9,0);
  let r0:i32=try_family(L,A,0,G9,0,K,tout,tmpc,seen);
  let r1:i32=try_family(L,A,1,G9,0,K,tout,tmpc,seen);
  let r2:i32=try_family(L,A,2,G9,0,K,tout,tmpc,seen);
  ss(S,300,2);
  let na9:i32=0;
  if(r0==1){ jt_acc2(S,na9,tagN,0); na9=na9+1; }
  if(r1==1){ jt_acc2(S,na9,tagN,1); na9=na9+1; }
  if(r2==1){ jt_acc2(S,na9,tagN,2); na9=na9+1; }
  ss(S,301,na9);
  let nr9:i32=0;
  if(r0==0){ jt_rej2(S,nr9,tagN,0); nr9=nr9+1; }
  if(r1==0){ jt_rej2(S,nr9,tagN,1); nr9=nr9+1; }
  if(r2==0){ jt_rej2(S,nr9,tagN,2); nr9=nr9+1; }
  ss(S,302,nr9);
  u_revise(S,cb0,1);
  c=o_app(b,c,"ISC-REV olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cb0+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+8) as i64);
  c=o_app(b,c,") active=");
  c=o_i64(b,c,sg(S,cb0+9) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb0,2,tagN,0,0,0,0,0) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb0,2,tagN,1,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,r0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,r1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,r2 as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"ISC-CNT total=");
  c=o_i64(b,c,sg(S,916) as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,sg(S,912) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," fiterr=");
  c=o_i64(b,c,sg(S,920) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- IS-D: tag-shape collision mid-composition. The tag bound to the
// ---- RETRIEVE family is reused by a new goal with a VERIFY shape. The
// ---- stale binding misroutes end-to-end; real trials contradict it;
// ---- revision flips the binding; the plan (which caches the fam at
// ---- build time) is rebuilt and the query agrees.
fn demo_collision(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let tagC:i32=get32(L,12744+0*4);
  let cb0:i32=2000+0*100;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let relC:i32=get32(avb,0);
  let subjC:i32=first_subj(A,relC);
  let objC:i32=first_obj(A,relC);
  let G0:[]u8=z_alloc(256);
  mk_goal813_E0(G0);
  let gtD:i32=g_tag(G0)+5;
  let G:[]u8=z_alloc(256);
  let o:i32=w_begin(G,gtD,1);
  o=w_need(G,o,tagC,4);
  o=w_f(G,o,1);
  o=w_f(G,o,subjC);
  o=w_f(G,o,relC);
  o=w_f(G,o,objC);
  o=w_links(G,o,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD0",3);
  let tr0:i32=try_family(L,A,0,G,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,G,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,G,0,K,tout,tmpc,seen);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  let dcX:i32=sg(S,cb0+10);
  let actX:i32=sg(S,cb0+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  let na9:i32=0;
  if(tr0==1){ jt_acc2(S,na9,tagC,0); na9=na9+1; }
  if(tr1==1){ jt_acc2(S,na9,tagC,1); na9=na9+1; }
  if(tr2==1){ jt_acc2(S,na9,tagC,2); na9=na9+1; }
  ss(S,301,na9);
  let nr9:i32=0;
  if(tr0==0){ jt_rej2(S,nr9,tagC,0); nr9=nr9+1; }
  if(tr1==0){ jt_rej2(S,nr9,tagC,1); nr9=nr9+1; }
  if(tr2==0){ jt_rej2(S,nr9,tagC,2); nr9=nr9+1; }
  ss(S,302,nr9);
  u_revise(S,cb0,1);
  c=o_app(b,c,"ISD-REV tag=");
  c=o_i64(b,c,tagC as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cb0+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+8) as i64);
  c=o_app(b,c,") route1=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  c=o_app(b,c,"ISD-CNT total=");
  c=o_i64(b,c,sg(S,916) as i64);
  c=o_app(b,c," correct=");
  c=o_i64(b,c,sg(S,912) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," first=");
  c=o_i64(b,c,sg(S,908) as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," fiterr=");
  c=o_i64(b,c,sg(S,920) as i64);
  c=o_nl(b,c);
  clear_plans(L);
  let o2:i32=w_begin(G,gtD,1);
  o2=w_need(G,o2,tagC,4);
  o2=w_f(G,o2,1);
  o2=w_f(G,o2,subjC);
  o2=w_f(G,o2,relC);
  o2=w_f(G,o2,objC);
  o2=w_links(G,o2,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD1",3);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let tmpc:[]u8=z_alloc(512);
  // IS-SETUP: composition anchor (episodes, specializes, diamond E0,
  // binding-contract dumps). Mirrors the integration battery's S1/S2.
  setup_worldA(A);
  c=o_app(B,c,"STAGE IS-SETUP"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,S,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,S,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,0,8);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,1,9);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,2,10);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,3,11);
  specialize_cnt(L,S,A,8,11);
  c=spec_line_cnt(B,c,L);
  c=dump_lstate_cnt(B,c,L);
  mk_goal813_E0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0",1);
  c=dump_bcontracts(B,c,L,S);
  c=dump_plans(B,c,L);
  // IS-B: coverage oscillation stress.
  c=o_app(B,c,"STAGE IS-B OSCILLATE"); c=o_nl(B,c);
  c=demo_oscillate(B,c,L,S,A,K,tout,rb);
  // IS-A: adversarial overlapping drift stress.
  c=o_app(B,c,"STAGE IS-A ADVERSARIAL-DRIFT"); c=o_nl(B,c);
  c=demo_adv_drift(B,c,L,S,A,K,ans,oans,vbuf,tout,seen,rb);
  // IS-C: noisy counterevidence stress.
  c=o_app(B,c,"STAGE IS-C NOISE"); c=o_nl(B,c);
  c=demo_noise(B,c,L,S,A,K,tout,tmpc,seen);
  // IS-D: tag-shape collision stress.
  c=o_app(B,c,"STAGE IS-D TAG-COLLISION"); c=o_nl(B,c);
  c=demo_collision(B,c,L,S,A,K,ans,oans,vbuf,tout,tmpc,seen);
  o_flush(B,c);
  return 0;
}

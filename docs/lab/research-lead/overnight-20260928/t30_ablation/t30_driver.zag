// ===== T30 ABLATION DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original main removed).
// Cognition code untouched.
//
// Two learners: WA (control), WB (ablation). Identical battery; at the
// midpoint every live tag-30 UNCERTAINTY node in WB is zeroed in place
// (tag and fields cleared, slot kept occupied so allocation order and
// node indices stay identical across both learners). Return-value
// transcripts are compared: any behavioral role of T30 nodes must show
// up as a divergence between the A and B streams.
//
// Unsealed synthetic subjects only. No sealed world content.

fn t30_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30){c=c+1;}
    n=n+1;
  }
  return c;
}

// Zero every live T30 node in place. Returns number zeroed.
// Slots stay occupied (live=1) so later alloc_node order is unchanged.
fn t30_ablate(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30){
      ns(W,n,0,0); ns(W,n,4,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      c=c+1;
    }
    n=n+1;
  }
  return c;
}

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

fn phase1(W:[]u8,p:[]u8)void {
  let i:i32=0; let a:i32=0;
  // Teach 10 facts.
  i=0;
  while(i<10){ a=ev_teach(W,1000+i,1,i*7+3); rep(p,"teach",a); i=i+1; }
  rep(p,"t30",t30_count(W));
  // 4 masked misses -> 4 T30 uncertainty nodes + guides.
  i=0;
  while(i<4){ a=ev_query(W,9100+i,77,-2,0); rep(p,"miss",a); i=i+1; }
  rep(p,"t30",t30_count(W));
  // Chain teach + masked query -> MAP promotion.
  ev_teach(W,7001,11,7002); ev_teach(W,7002,12,7003);
  a=ev_query(W,7001,40,7003,0); rep(p,"promote",a);
  rep(p,"t30",t30_count(W));
  // Action selection (guides exist now).
  i=0;
  while(i<3){ a=ev_act(W); rep(p,"act",a); i=i+1; }
  // Direct query of a guide node (tag-1 fact with key 30,-999).
  a=ev_query(W,30,-999,-2,0); rep(p,"guideq",a);
  // Exact hits on taught facts.
  i=0;
  while(i<10){ a=ev_query(W,1000+i,1,i*7+3,0); rep(p,"hit",a); i=i+1; }
  return;
}

fn phase2(W:[]u8,p:[]u8)void {
  let i:i32=0; let a:i32=0;
  // 4 more masked misses -> 4 fresh T30s in both learners.
  i=0;
  while(i<4){ a=ev_query(W,9200+i,77,-2,0); rep(p,"miss2",a); i=i+1; }
  rep(p,"t30",t30_count(W));
  // 10 more teaches (return values are node indices; must match A/B).
  i=0;
  while(i<10){ a=ev_teach(W,2000+i,2,i*3+1); rep(p,"teach2",a); i=i+1; }
  // Exact hits on the new facts.
  i=0;
  while(i<10){ a=ev_query(W,2000+i,2,i*3+1,0); rep(p,"hit2",a); i=i+1; }
  // Action selection again (pre-ablation guides still linked in B,
  // their T30 targets zeroed).
  i=0;
  while(i<3){ a=ev_act(W); rep(p,"act2",a); i=i+1; }
  // Contradiction -> revision path; then query the revised MAP.
  a=ev_observe(W,7002,12,9999); rep(p,"contra_rc",a);
  a=ev_query(W,7001,40,9999,0); rep(p,"contra_q",a);
  // Plain observation + confirm.
  a=ev_observe(W,2001,2,7777); rep(p,"obs2_rc",a);
  a=ev_query(W,2001,2,7777,0); rep(p,"obs2_q",a);
  // Guide query again.
  a=ev_query(W,30,-999,-2,0); rep(p,"guideq2",a);
  // Re-miss on a pre-ablation key (the dedup scenario).
  a=ev_query(W,9100,77,-2,0); rep(p,"remiss",a);
  rep(p,"t30",t30_count(W));
  return;
}

fn t30_main()i32 {
  let WA:[]u8=z_alloc(110656); tnn2_init(WA);
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  phase1(WA,"A");
  phase1(WB,"B");
  let n:i32=t30_ablate(WB);
  emit("ABLATED n="); e64(n); emit("\n");
  rep("B","t30_post",t30_count(WB));
  rep("A","t30_post",t30_count(WA));
  phase2(WA,"A");
  phase2(WB,"B");
  emit("T30-ABLATION-DONE\n");
  return 0;
}
fn main()i32 { return t30_main(); }

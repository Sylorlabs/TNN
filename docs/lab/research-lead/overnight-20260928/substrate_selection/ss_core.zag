// po_full.zag -- Prediction-optional cognition battery.
// Constitution Section 13: prediction is one cognitive process among many.
// Two arms, one binary:
//   CTL: prediction-first. ev_predict is invoked on every query (models the
//        PREDICT EVERYTHING architectural pattern), then the same machinery.
//   TRT: state-driven dispatch. The learner checks, in order: direct fact,
//        deductive path, trusted executable, causal chain, predictor,
//        construction material, inquiry. No researcher mode switch: which
//        branch fires is determined by learner state contents.
// The single-line arm difference is in query_ctl vs query_trt.
// Pure Zag. Pinned znc. No Python.

// ============ section 0: primitives (u8-backed cell idiom) ============
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn hg(W:[]u8,f:i32)i32 { return get32(W,f); }
fn hs(W:[]u8,f:i32,v:i32)void { set32(W,f,v); return; }
fn noff(n:i32)i32 { return 64+n*40; }
fn ng(W:[]u8,n:i32,f:i32)i32 { return get32(W,noff(n)+f); }
fn ns(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,noff(n)+f,v); return; }
fn eoff(e:i32)i32 { return 41024+e*16; }
fn eg(W:[]u8,e:i32,f:i32)i32 { return get32(W,eoff(e)+f); }
fn es(W:[]u8,e:i32,f:i32,v:i32)void { set32(W,eoff(e)+f,v); return; }

// ============ section 1: init, alloc, edges ============
fn po_init(W:[]u8)void {
  let e:i32=0;
  while(e<4096){ es(W,e,0,-1); e=e+1; }
  ns(W,0,36,1); ns(W,1,36,1);
  hs(W,20,0); hs(W,24,0);
  return;
}
fn alloc_node(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==0){
      ns(W,n,36,1); ns(W,n,0,0);
      ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,0); ns(W,n,16,0);
      ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
      hs(W,20,hg(W,20)+1); return n;
    }
    n=n+1;
  }
  return -1;
}
fn link_edge(W:[]u8,f:i32,t:i32,to:i32,clk:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==-1){
      es(W,e,0,f); es(W,e,4,t); es(W,e,8,to); es(W,e,12,clk);
      hs(W,24,hg(W,24)+1); return e;
    }
    e=e+1;
  }
  return -1;
}
fn freshW()[]u8 {
  let W:[]u8=z_alloc(110656);
  po_init(W);
  return W;
}

// ============ section 2: constants ============
// node types
fn T_FACT()i32 { return 1; }
fn T_MAP()i32 { return 20; }
fn T_CELL()i32 { return 22; }
fn T_UNCERT()i32 { return 30; }
fn T_PRED()i32 { return 31; }
fn T_PROC()i32 { return 40; }
// cell ops (generic arithmetic machinery, not benchmark detectors)
fn OP_ADD()i32 { return 1; }
fn OP_MUL()i32 { return 2; }
fn OP_SUB()i32 { return 3; }
fn OP_SET()i32 { return 4; }
// process ids
fn P_RETRIEVE()i32 { return 1; }
fn P_DERIVE()i32 { return 2; }
fn P_VERIFY()i32 { return 3; }
fn P_CAUSAL()i32 { return 4; }
fn P_PREDICT()i32 { return 5; }
fn P_INQUIRE()i32 { return 6; }
fn P_CONSTRUCT()i32 { return 7; }
// trust threshold: score >= K means the structure is certain knowledge,
// below K it is only a predictor. Researcher-set; scores are learner-owned.
fn K_TRUST()i32 { return 6; }
fn NO_VAL()i32 { return -999999; }

// ============ section 3: counters (header offsets 28..60) ============
fn bump(W:[]u8,f:i32)void { hs(W,f,hg(W,f)+1); return; }
fn zero_counters(W:[]u8)void {
  hs(W,28,0); hs(W,32,0); hs(W,36,0); hs(W,40,0); hs(W,44,0);
  hs(W,48,0); hs(W,52,0); hs(W,56,0); hs(W,60,0);
  return;
}
// 28 c_predict_all  32 c_predict_wasted  36 n_retrieve  40 n_derive
// 44 n_verify  48 n_causal  52 n_inquire  56 n_construct  60 proc_record_hits

// ============ section 4: world law (driver-provided environment) ============
fn world_law(r:i32,s:i32)i32 {
  if(r==56){ return 2*s+1; }
  if(r==57){ return 4*s+2; }
  if(r==58){ return 3*s-2; }
  return 0;
}

// ============ section 5: structure ops ============
// FACT: f0=1 f4=s f8=r f12=o f16=prov
fn teach_fact(W:[]u8,s:i32,r:i32,o:i32,prov:i32)i32 {
  let n:i32=alloc_node(W);
  if(n<0){return -1;}
  ns(W,n,0,1); ns(W,n,4,s); ns(W,n,8,r); ns(W,n,12,o); ns(W,n,16,prov);
  return n;
}
fn find_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==s && ng(W,n,8)==r){ return n; }
    n=n+1;
  }
  return 0;
}
// MAP: f0=20 f8=r f20=score f24=entry cell f28=verified-subject tag f32=aux
// CELL: f0=22 f24=op f28=imm, chained by SEQ (type 12) edges
fn teach_map(W:[]u8,r:i32,score:i32,subj:i32,op1:i32,im1:i32,op2:i32,im2:i32,nc:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,8,r); ns(W,m,20,score); ns(W,m,28,subj);
  let c1:i32=alloc_node(W);
  if(c1<0){return -1;}
  ns(W,c1,0,22); ns(W,c1,24,op1); ns(W,c1,28,im1);
  ns(W,m,24,c1);
  if(nc>1){
    let c2:i32=alloc_node(W);
    if(c2<0){return -1;}
    ns(W,c2,0,22); ns(W,c2,24,op2); ns(W,c2,28,im2);
    link_edge(W,c1,12,c2,0);
  }
  return m;
}
fn seq_next(W:[]u8,c:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==c && eg(W,e,4)==12){ return eg(W,e,8); }
    e=e+1;
  }
  return 0;
}
fn apply_op(v:i32,op:i32,im:i32)i32 {
  if(op==1){return v+im;}
  if(op==2){return v*im;}
  if(op==3){return v-im;}
  return im;
}
fn exec_map(W:[]u8,m:i32,s:i32)i32 {
  let acc:i32=s;
  let c:i32=ng(W,m,24);
  let g:i32=0;
  while(c>1 && g<64){
    acc=apply_op(acc,ng(W,c,24),ng(W,c,28));
    c=seq_next(W,c);
    g=g+1;
  }
  return acc;
}
fn find_trusted_map(W:[]u8,r:i32,ms:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r && ng(W,n,20)>=ms){ return n; }
    n=n+1;
  }
  return 0;
}
fn find_best_map(W:[]u8,r:i32)i32 {
  let best:i32=0;
  let bs:i32=-1;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,8)==r){
      let sc:i32=ng(W,n,20);
      if(sc>bs){ bs=sc; best=n; }
    }
    n=n+1;
  }
  return best;
}
fn count_maps(W:[]u8)i32 {
  let c:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){ c=c+1; }
    n=n+1;
  }
  return c;
}

// ============ section 6: prediction and outcome resolution ============
// PRED: f0=31 f4=s f8=r f12=predicted f16=resolved f20=predictor MAP
fn ev_predict(W:[]u8,s:i32,r:i32)i32 {
  bump(W,28);
  let m:i32=find_best_map(W,r);
  if(m==0){ return NO_VAL(); }
  let v:i32=exec_map(W,m,s);
  let p:i32=alloc_node(W);
  if(p>1){
    ns(W,p,0,31); ns(W,p,4,s); ns(W,p,8,r); ns(W,p,12,v); ns(W,p,16,0); ns(W,p,20,m);
  }
  return v;
}
fn ev_observe(W:[]u8,s:i32,r:i32)void {
  let w:i32=world_law(r,s);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==s && ng(W,n,8)==r && ng(W,n,16)==0){
      if(ng(W,n,12)==w){
        let m:i32=ng(W,n,20);
        if(m>1){ ns(W,m,20,ng(W,m,20)+1); }
      }
      ns(W,n,16,1);
    }
    n=n+1;
  }
  return;
}

// ============ section 7: candidate cognitive processes ============
// derive: fixed compositional rule DER: (s,51,x) and (x,52,o) implies (s,53,o).
// The rule itself is researcher-authored machinery (like the executor); the
// *choice* to derive rather than predict is state-driven. The derived triple
// (s,53,o) is never stored as a fact.
fn try_derive_val(W:[]u8,s:i32,r:i32)i32 {
  if(r!=53){ return NO_VAL(); }
  let n1:i32=2;
  while(n1<1024){
    if(ng(W,n1,36)==1 && ng(W,n1,0)==1 && ng(W,n1,4)==s && ng(W,n1,8)==51){
      let x:i32=ng(W,n1,12);
      let n2:i32=2;
      while(n2<1024){
        if(ng(W,n2,36)==1 && ng(W,n2,0)==1 && ng(W,n2,4)==x && ng(W,n2,8)==52){
          return ng(W,n2,12);
        }
        n2=n2+1;
      }
    }
    n1=n1+1;
  }
  return NO_VAL();
}
// causal: discover a 2-MAP chain whose endpoints connect: m1(s)->x, m2 verified on x -> o.
// No researcher-provided composition semantics; the connection is found from state.
fn try_causal_val(W:[]u8,s:i32,r:i32)i32 {
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20 && ng(W,m1,20)>=1){
      let x:i32=exec_map(W,m1,s);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20 && ng(W,m2,20)>=1 && ng(W,m2,28)==x){
          return exec_map(W,m2,x);
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  return NO_VAL();
}
// construct: bounded trial over 2-cell programs against the world outcome.
// If a verified MAP for r already exists, reuse it (memoized construction).
fn try_construct_val(W:[]u8,s:i32,r:i32)i32 {
  let m0:i32=find_trusted_map(W,r,6);
  if(m0>0){ return exec_map(W,m0,s); }
  let target:i32=world_law(r,s);
  let tries:i32=0;
  let op1:i32=1;
  while(op1<=3){
    let im1:i32=-2;
    while(im1<=3){
      let op2:i32=1;
      while(op2<=3){
        let im2:i32=-2;
        while(im2<=3){
          tries=tries+1;
          let acc:i32=apply_op(apply_op(s,op1,im1),op2,im2);
          if(acc==target){
            let m:i32=teach_map(W,r,10,s,op1,im1,op2,im2,2);
            if(m>0){ ns(W,m,32,tries); }
            hs(W,64,tries);
            return target;
          }
          im2=im2+1;
        }
        op2=op2+1;
      }
      im1=im1+1;
    }
    op1=op1+1;
  }
  return NO_VAL();
}
// inquire: reify UNCERTAINTY for (s,r) unless one already exists
fn inquire(W:[]u8,s:i32,r:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,4)==s && ng(W,n,8)==r){ return; }
    n=n+1;
  }
  let u:i32=alloc_node(W);
  if(u>1){ ns(W,u,0,30); ns(W,u,4,s); ns(W,u,8,r); }
  return;
}

// ============ section 8: process-success records (learner-owned) ============
// T_PROC node: f0=40 f8=r f24=process id. Written on success, read before dispatch.
fn proc_get(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,8)==r){ return ng(W,n,24); }
    n=n+1;
  }
  return 0;
}
fn proc_set(W:[]u8,r:i32,p:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,8)==r){ ns(W,n,24,p); return; }
    n=n+1;
  }
  let q:i32=alloc_node(W);
  if(q>1){ ns(W,q,0,40); ns(W,q,8,r); ns(W,q,24,p); }
  return;
}

// ============ section 9: process execution and dispatch ============
// do_process runs one cognitive process if learner state supports it.
// Returns the answer, or NO_VAL if the process has no basis in state.
fn do_process(W:[]u8,s:i32,r:i32,p:i32)i32 {
  if(p==1){
    let n:i32=find_fact(W,s,r);
    if(n>0){ bump(W,36); return ng(W,n,12); }
    return NO_VAL();
  }
  if(p==2){
    let dv:i32=try_derive_val(W,s,r);
    if(dv!=NO_VAL()){ bump(W,40); return dv; }
    return NO_VAL();
  }
  if(p==3){
    let tm:i32=find_trusted_map(W,r,6);
    if(tm>0){ bump(W,44); return exec_map(W,tm,s); }
    return NO_VAL();
  }
  if(p==4){
    let cv:i32=try_causal_val(W,s,r);
    if(cv!=NO_VAL()){ bump(W,48); return cv; }
    return NO_VAL();
  }
  if(p==5){
    let pm:i32=find_best_map(W,r);
    if(pm>0){ return ev_predict(W,s,r); }
    return NO_VAL();
  }
  if(p==6){
    inquire(W,s,r);
    bump(W,52);
    return -3;
  }
  let kv:i32=try_construct_val(W,s,r);
  if(kv!=NO_VAL()){ bump(W,56); return kv; }
  return NO_VAL();
}
// Treatment dispatch: consult the learner's process record first; otherwise
// try processes in a fixed fallback order. Which branch fires is determined
// by learner state contents, not by a researcher mode switch.
fn dispatch_trt(W:[]u8,s:i32,r:i32,typ:i32)i32 {
  let rec:i32=proc_get(W,r);
  if(rec>0){
    let rv:i32=do_process(W,s,r,rec);
    if(rv!=NO_VAL()){ bump(W,60); return rv; }
  }
  let p:i32=1;
  while(p<=5){
    let pv:i32=do_process(W,s,r,p);
    if(pv!=NO_VAL()){ proc_set(W,r,p); return pv; }
    p=p+1;
  }
  // construction only when building blocks exist in state; else inquire
  if(count_maps(W)>0){
    let kv:i32=do_process(W,s,r,7);
    if(kv!=NO_VAL()){ proc_set(W,r,7); return kv; }
  }
  let iv:i32=do_process(W,s,r,6);
  proc_set(W,r,6);
  return iv;
}
fn query_trt(W:[]u8,s:i32,r:i32,typ:i32)i32 {
  return dispatch_trt(W,s,r,typ);
}
// Control: prediction-first. The predictive machinery is consulted on every
// query before the shared dispatch runs. This models the PREDICT EVERYTHING
// architectural pattern. The wasted counter marks invocations on types where
// a non-predictive process suffices.
fn query_ctl(W:[]u8,s:i32,r:i32,typ:i32)i32 {
  if(typ!=5){
    ev_predict(W,s,r);
    bump(W,32);
  }
  return dispatch_trt(W,s,r,typ);
}


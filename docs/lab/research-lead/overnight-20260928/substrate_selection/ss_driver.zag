// ============ substrate_selection driver ============
// Phase A: guided consequence experience (treatment world only).
// Phase B: novel problems; treatment selects via substrate, control via
// fixed order. No task label is ever passed to selection.

fn ss_setup_train(W:[]u8)void {
  teach_fact(W,1,50,100,1);
  teach_fact(W,2,50,200,1);
  teach_fact(W,1,53,999,0);
  teach_fact(W,1,51,7,1); teach_fact(W,7,52,200,1);
  teach_fact(W,2,53,999,0);
  teach_fact(W,2,51,8,1); teach_fact(W,8,52,400,1);
  teach_map(W,52,10,5,1,10,0,0,1);
  teach_map(W,56,3,9,2,2,1,1,2);
  teach_map(W,58,2,9,2,2,1,1,2);
  return;
}
fn ss_setup_test(W:[]u8)void {
  teach_fact(W,3,50,300,1);
  teach_fact(W,3,53,999,0);
  teach_fact(W,3,51,9,1); teach_fact(W,9,52,600,1);
  teach_map(W,57,2,9,2,2,1,1,2);
  return;
}

fn ss_rep_q(nm:[]u8,W:[]u8,ans:i32,expected:i32)i32 {
  emit(nm);
  emit(" sig="); e64(hg(W,68));
  emit(" op="); e64(hg(W,72));
  emit(" ans="); e64(ans); emit(" exp="); e64(expected);
  let ok:i32=0; if(ans==expected){ ok=1; }
  emit(" ok="); e64(ok); emit("\n");
  return ok;
}
fn ss_census(W:[]u8)void {
  emit("CENSUS kt=4:\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==4){
      emit(" sig="); e64(ng(W,n,8)); emit(" op="); e64(ng(W,n,12));
      emit(" succ="); e64(ng(W,n,24)); emit(" att="); e64(ng(W,n,20));
      emit(" cost="); e64(sub_life_cost(ng(W,n,32))); emit("\n");
    }
    n=n+1;
  }
  return;
}

fn main()i32 {
  emit("SUBSTRATE-SELECTION BATTERY\n");
  // ---- treatment: one continuous learner ----
  let Wt:[]u8=freshW();
  ss_setup_train(Wt);
  ss_train_one(Wt,1,50,100);
  ss_train_one(Wt,2,50,200);
  ss_train_one(Wt,1,53,200);
  ss_train_one(Wt,2,53,400);
  ss_train_one(Wt,1,52,11);
  ss_train_one(Wt,2,52,12);
  ss_train_one(Wt,1,56,3);
  ss_train_one(Wt,2,56,5);
  ss_train_one(Wt,1,58,1);
  ss_train_unanswerable(Wt,5,99);
  emit("--- census after training ---\n");
  ss_census(Wt);
  ss_setup_test(Wt);
  emit("--- treatment test (substrate selection) ---\n");
  let t_ok:i32=0;
  let a1:i32=ss_query_trt(Wt,3,50); ss_observe(Wt,a1,300);
  t_ok=t_ok+ss_rep_q("T-Q1 fresh-fact",Wt,a1,300);
  let a2:i32=ss_query_trt(Wt,3,53); ss_observe(Wt,a2,600);
  t_ok=t_ok+ss_rep_q("T-Q2 stale-fact-trap",Wt,a2,600);
  let a3:i32=ss_query_trt(Wt,3,52); ss_observe(Wt,a3,13);
  t_ok=t_ok+ss_rep_q("T-Q3 trusted-map",Wt,a3,13);
  let a4:i32=ss_query_trt(Wt,3,56); ss_observe(Wt,a4,7);
  t_ok=t_ok+ss_rep_q("T-Q4 proven-predictor",Wt,a4,7);
  let a5:i32=ss_query_trt(Wt,1,57); ss_observe(Wt,a5,6);
  t_ok=t_ok+ss_rep_q("T-Q5 bad-predictor-seq1",Wt,a5,6);
  let a6:i32=ss_query_trt(Wt,1,57); ss_observe(Wt,a6,6);
  t_ok=t_ok+ss_rep_q("T-Q6 after-construct-seq2",Wt,a6,6);
  let a7:i32=ss_query_trt(Wt,5,99); ss_observe(Wt,a7,-3);
  t_ok=t_ok+ss_rep_q("T-Q7 unanswerable",Wt,a7,-3);
  emit("treatment ok="); e64(t_ok); emit("/7\n");
  emit("--- census after test ---\n");
  ss_census(Wt);

  // ---- control: fixed order, substrate never read ----
  let Wc:[]u8=freshW();
  ss_setup_train(Wc);
  ss_setup_test(Wc);
  emit("--- control test (fixed order, no substrate) ---\n");
  let c_ok:i32=0;
  let b1:i32=ss_query_ctl(Wc,3,50);
  c_ok=c_ok+ss_rep_q("C-Q1 fresh-fact",Wc,b1,300);
  let b2:i32=ss_query_ctl(Wc,3,53);
  c_ok=c_ok+ss_rep_q("C-Q2 stale-fact-trap",Wc,b2,600);
  let b3:i32=ss_query_ctl(Wc,3,52);
  c_ok=c_ok+ss_rep_q("C-Q3 trusted-map",Wc,b3,13);
  let b4:i32=ss_query_ctl(Wc,3,56);
  c_ok=c_ok+ss_rep_q("C-Q4 proven-predictor",Wc,b4,7);
  let b5:i32=ss_query_ctl(Wc,1,57);
  c_ok=c_ok+ss_rep_q("C-Q5 bad-predictor-seq1",Wc,b5,6);
  let b6:i32=ss_query_ctl(Wc,1,57);
  c_ok=c_ok+ss_rep_q("C-Q6 after-construct-seq2",Wc,b6,6);
  let b7:i32=ss_query_ctl(Wc,5,99);
  c_ok=c_ok+ss_rep_q("C-Q7 unanswerable",Wc,b7,-3);
  emit("control ok="); e64(c_ok); emit("/7\n");
  emit("DONE\n");
  return 0;
}

// ============ substrate_selection patch ============
// Operation selection from shared consequence history.
// No task labels. No mode switch. The mapping from situation to
// operation is learned from recorded consequences, not authored.
//
// Substrate: tag-61 records, kt=4 (OPSEL), ka=condition signature,
// kb=operation id. Fields follow the shared substrate schema:
// f16=consec_fail, f20=attempts, f24=successes, f28=src, f32=life/cost.

// ---- substrate record machinery (from build 02a338dbf) ----
fn SUB_TAG()i32 { return 61; }
fn sub_src_get(p:i32,k:i32)i32 {
  if(k==0){ return p%1024; }
  if(k==1){ return (p/1024)%1024; }
  return (p/1048576)%1024;
}
fn sub_src_inc(p:i32,k:i32)i32 {
  let v:i32=sub_src_get(p,k);
  if(v>=1023){ return p; }
  if(k==0){ return p+1; }
  if(k==1){ return p+1024; }
  return p+1048576;
}
fn sub_life_state(l:i32)i32 { return l%4; }
fn sub_life_cost(l:i32)i32 { return l/512; }
fn sub_life_mk(st:i32,md:i32,c:i32)i32 {
  let cc:i32=c; if(cc>4194303){ cc=4194303; }
  return (st%4)+(md%128)*4+cc*512;
}
fn sub_find(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==kt && ng(W,n,8)==ka && ng(W,n,12)==kb){ return n; }
    n=n+1;
  }
  return -1;
}
fn sub_get(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n>=0){ return n; }
  n=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,kt); ns(W,n,8,ka); ns(W,n,12,kb);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
fn sub_note(W:[]u8,kt:i32,ka:i32,kb:i32,success:i32,mode:i32,src:i32,cost:i32,create:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){
    if(create==0){ return -1; }
    n=sub_get(W,kt,ka,kb); if(n<0){ return -1; }
  }
  ns(W,n,20,ng(W,n,20)+1);
  ns(W,n,28,sub_src_inc(ng(W,n,28),src));
  let st:i32=sub_life_state(ng(W,n,32));
  let nc:i32=sub_life_cost(ng(W,n,32))+cost;
  if(success==1){
    ns(W,n,24,ng(W,n,24)+1);
    ns(W,n,16,0);
    ns(W,n,32,sub_life_mk(st,0,nc));
  } else {
    ns(W,n,16,ng(W,n,16)+1);
    ns(W,n,32,sub_life_mk(st,mode,nc));
  }
  return n;
}

// ---- operation ids (subset of the 7 processes; causal excluded, see REPORT) ----
fn OP_RETRIEVE()i32 { return 1; }
fn OP_DERIVE()i32 { return 2; }
fn OP_VERIFY()i32 { return 3; }
fn OP_PREDICT()i32 { return 5; }
fn OP_INQUIRE()i32 { return 6; }
fn OP_CONSTRUCT()i32 { return 7; }
fn KT_OPSEL()i32 { return 4; }
// sentinel for "no record"
fn NO_REC()i32 { return -1000000; }

// ---- condition signature from learner state (no task label) ----
// bit0(1): fact exists; bit1(2): fact reliable (prov==1);
// bit2(4): derive basis; bit3(8): trusted map; bit4(16): any map;
// bit5(32): proven predictor (map score 3..5).
fn ss_sig(W:[]u8,s:i32,r:i32)i32 {
  let sig:i32=0;
  let fn_:i32=find_fact(W,s,r);
  if(fn_>0){
    sig=sig+1;
    if(ng(W,fn_,16)==1){ sig=sig+2; }
  }
  if(r==53){
    let a:i32=0; let b:i32=0;
    let n:i32=2;
    while(n<1024){
      if(ng(W,n,36)==1 && ng(W,n,0)==1){
        if(ng(W,n,4)==s && ng(W,n,8)==51){ a=1; }
        if(ng(W,n,8)==52){ b=1; }
      }
      n=n+1;
    }
    if(a==1 && b==1){ sig=sig+4; }
  }
  if(find_trusted_map(W,r,6)>0){ sig=sig+8; }
  if(find_best_map(W,r)>0){
    sig=sig+16;
    let n2:i32=2; let proven:i32=0;
    while(n2<1024){
      if(ng(W,n2,36)==1 && ng(W,n2,0)==20 && ng(W,n2,8)==r){
        let sc:i32=ng(W,n2,20);
        if(sc>=3 && sc<=5){ proven=1; }
      }
      n2=n2+1;
    }
    if(proven==1){ sig=sig+32; }
  }
  return sig;
}

// ---- consequence score: net wins minus amortized cost ----
fn ss_score_op(W:[]u8,sig:i32,op:i32)i32 {
  let n:i32=sub_find(W,KT_OPSEL(),sig,op);
  if(n<0){ return NO_REC(); }
  let succ:i32=ng(W,n,24);
  let att:i32=ng(W,n,20);
  let cost:i32=sub_life_cost(ng(W,n,32));
  let avg:i32=0;
  if(att>0){ avg=cost/att; }
  return 2*succ - att - avg/20;
}

// ---- selection: argmax over recorded ops; 0 = fall back ----
fn ss_choose(W:[]u8,s:i32,r:i32)i32 {
  let sig:i32=ss_sig(W,s,r);
  let best:i32=0;
  let bs:i32=NO_REC();
  let sc1:i32=ss_score_op(W,sig,1);
  if(sc1!=NO_REC() && sc1>bs){ bs=sc1; best=1; }
  let sc2:i32=ss_score_op(W,sig,2);
  if(sc2!=NO_REC() && sc2>bs){ bs=sc2; best=2; }
  let sc3:i32=ss_score_op(W,sig,3);
  if(sc3!=NO_REC() && sc3>bs){ bs=sc3; best=3; }
  let sc5:i32=ss_score_op(W,sig,5);
  if(sc5!=NO_REC() && sc5>bs){ bs=sc5; best=5; }
  let sc6:i32=ss_score_op(W,sig,6);
  if(sc6!=NO_REC() && sc6>bs){ bs=sc6; best=6; }
  let sc7:i32=ss_score_op(W,sig,7);
  if(sc7!=NO_REC() && sc7>bs){ bs=sc7; best=7; }
  if(best>0 && bs>=0){ return best; }
  return 0;
}

// ---- record one consequence ----
fn ss_note(W:[]u8,sig:i32,op:i32,success:i32,cost:i32)i32 {
  return sub_note(W,KT_OPSEL(),sig,op,success,0,1,cost,1);
}

// ---- single op attempt; stashes (sig,op,cost) on basis; NO_VAL if none ----
// header scratch: 64=tries, 68=sig, 72=op, 76=cost
fn ss_try_op(W:[]u8,s:i32,r:i32,sig:i32,op:i32)i32 {
  let n0:i32=hg(W,20); hs(W,64,0);
  let ans:i32=do_process(W,s,r,op);
  if(ans!=NO_VAL()){
    hs(W,68,sig); hs(W,72,op); hs(W,76,(hg(W,20)-n0)+hg(W,64));
  }
  return ans;
}
// default fixed order (ablation / fallback): 1,2,3,5,7,6
fn ss_run_default(W:[]u8,s:i32,r:i32,sig:i32)i32 {
  let ans:i32=ss_try_op(W,s,r,sig,1);
  if(ans==NO_VAL()){ ans=ss_try_op(W,s,r,sig,2); }
  if(ans==NO_VAL()){ ans=ss_try_op(W,s,r,sig,3); }
  if(ans==NO_VAL()){ ans=ss_try_op(W,s,r,sig,5); }
  if(ans==NO_VAL()){ ans=ss_try_op(W,s,r,sig,7); }
  if(ans==NO_VAL()){ ans=ss_try_op(W,s,r,sig,6); }
  return ans;
}

// ---- treatment query: substrate selection, then fallback ----
fn ss_query_trt(W:[]u8,s:i32,r:i32)i32 {
  let sig:i32=ss_sig(W,s,r);
  let op:i32=ss_choose(W,s,r);
  let ans:i32=NO_VAL();
  if(op>0){ ans=ss_try_op(W,s,r,sig,op); }
  if(ans==NO_VAL()){ ans=ss_run_default(W,s,r,sig); }
  return ans;
}
// ---- observe outcome; record consequence for the stashed (sig,op) ----
fn ss_observe(W:[]u8,ans:i32,expected:i32)void {
  let sig:i32=hg(W,68); let op:i32=hg(W,72); let cost:i32=hg(W,76);
  let ok:i32=0;
  if(ans==expected){ ok=1; }
  ss_note(W,sig,op,ok,cost);
  return;
}
// ---- control query: fixed order only; substrate never read ----
// (ss_run_default stashes but the control driver never calls ss_observe,
// so no consequence record is ever written from the control path.)
fn ss_query_ctl(W:[]u8,s:i32,r:i32)i32 {
  let sig:i32=0;
  return ss_run_default(W,s,r,sig);
}

// ---- guided training: try ops 1,2,3,5; construct only if none succeeded ----
fn ss_train_op(W:[]u8,s:i32,r:i32,sig:i32,op:i32,expected:i32)i32 {
  let ans:i32=ss_try_op(W,s,r,sig,op);
  if(ans==NO_VAL()){ return 0; }
  ss_observe(W,ans,expected);
  if(ans==expected){ return 1; }
  return 0;
}
fn ss_train_one(W:[]u8,s:i32,r:i32,expected:i32)void {
  let sig:i32=ss_sig(W,s,r);
  let ok:i32=0;
  if(ss_train_op(W,s,r,sig,1,expected)==1){ ok=1; }
  if(ss_train_op(W,s,r,sig,2,expected)==1){ ok=1; }
  if(ss_train_op(W,s,r,sig,3,expected)==1){ ok=1; }
  if(ss_train_op(W,s,r,sig,5,expected)==1){ ok=1; }
  if(ok==0){ ss_train_op(W,s,r,sig,7,expected); }
  return;
}
fn ss_train_unanswerable(W:[]u8,s:i32,r:i32)void {
  let sig:i32=ss_sig(W,s,r);
  let ans:i32=ss_try_op(W,s,r,sig,6);
  ss_observe(W,ans,-3);
  return;
}

// c_driver.zag -- grammar CODEC-INDUCTION experiment driver.
// Five worlds, one binary, codec-induction machinery (c_patch.zag).
// EXL2: literals 0..9, P(a,b) = a*16+b (control; must induce D=16).
// EXL3: literals 0..7, P(a,b) = a*8+b (must induce D=8; the old
//   hardcoded /16 machinery went silently wrong here).
// EXL4: literals 0..3, P(a,b) = a*32+b (must induce D=32).
// NEG-AMB: literals {2,4,6}, P(a,b) = a*8+b, facts taught ONLY on
//   diagonal pairs (a,a). D=8 (components {2,4,6}) and D=17 (components
//   {1,2,3}) satisfy every taught fact: genuinely ambiguous, must
//   refuse with -4.
// NEG-SHIFT: literals 0..9, teacher uses P=a*16+b for a in 0..4 and
//   P=a*8+b for a in 5..9 (codec shift mid-stream; S contains 17 and
//   45, so g=1): no consistent codec, must refuse with -3.
// All worlds: SUB=41, DIV=42, DSUB=43, DDIV=44, BUILD=45. Constraints
// taught via examples only, never as rules.

// ---- EXL2 teaching (literals 0..9, P = a*16+b) ----

fn c2_P(a:i32,b:i32)i32 { return a*16+b; }

fn c2_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,c2_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,c2_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){c2_dsub(W,t); c2_ddiv(W,t); t=t+1;}
  return;
}

fn c2_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c2_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c2_teach_build(W:[]u8)void {
  c2_canon_build(W,1,1);
  c2_canon_build(W,3,0);
  c2_canon_build(W,5,1);
  c2_canon_build(W,7,0);
  return;
}

fn c2_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=c2_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c2_teach_decomp(W);
  c2_teach_build(W);
  return;
}

// ---- EXL3 teaching (literals 0..7, P = a*8+b) ----


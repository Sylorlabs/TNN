// ---- EXL4 teaching (literals 0..3, P = a*32+b) ----

fn c4_P(a:i32,b:i32)i32 { return a*32+b; }

fn c4_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(a-b==t){ev_teach_in(W,t,43,c4_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,c4_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=3){c4_dsub(W,t); c4_ddiv(W,t); t=t+1;}
  return;
}

fn c4_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=3 && done==0){
      let b:i32=0;
      while(b<=3 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,c4_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=3 && done==0){
    let b:i32=0;
    while(b<=3 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,c4_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn c4_teach_build(W:[]u8)void {
  c4_canon_build(W,1,1);
  c4_canon_build(W,3,0);
  return;
}

fn c4_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      let p:i32=c4_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  c4_teach_decomp(W);
  c4_teach_build(W);
  return;
}

// ---- NEG-AMB teaching (literals {2,4,6}, P = a*8+b, diagonal only) ----

fn cn_P(a:i32,b:i32)i32 { return a*8+b; }

fn cn_teach(W:[]u8)void {
  let a:i32=2;
  while(a<=6){
    let p:i32=cn_P(a,a);
    ev_teach_in(W,p,41,0);
    ev_teach_in(W,p,42,1);
    a=a+2;
  }
  ev_teach_in(W,0,43,cn_P(2,2));
  ev_teach_in(W,0,43,cn_P(4,4));
  ev_teach_in(W,0,43,cn_P(6,6));
  ev_teach_in(W,1,44,cn_P(2,2));
  ev_teach_in(W,1,44,cn_P(4,4));
  ev_teach_in(W,1,44,cn_P(6,6));
  ev_teach_in(W,0,45,cn_P(2,2));
  ev_teach_in(W,1,45,cn_P(2,2));
  return;
}

// ---- NEG-SHIFT teaching (literals 0..9, codec shift at a=5) ----

fn cs_P(a:i32,b:i32)i32 {
  if(a<=4){return a*16+b;}
  return a*8+b;
}

fn cs_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,cs_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,cs_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn cs_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=cs_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  let t:i32=0;
  while(t<=9){
    let x:i32=0;
    while(x<=9){
      let y:i32=0;
      while(y<=9){
        if(x-y==t){ev_teach_in(W,t,43,cs_P(x,y));}
        if(y>0){
          if(x-(x/y)*y==0){
            if(x/y==t){ev_teach_in(W,t,44,cs_P(x,y));}
          }
        }
        y=y+1;
      }
      x=x+1;
    }
    t=t+1;
  }
  cs_canon_build(W,1,1);
  cs_canon_build(W,3,0);
  return;
}

fn c_teach(W:[]u8,wid:i32)void {
  if(wid==2){c2_teach(W);}
  if(wid==3){c3_teach(W);}
  if(wid==4){c4_teach(W);}
  if(wid==5){cn_teach(W);}
  if(wid==6){cs_teach(W);}
  if(wid==7){cn_teach(W);}
  if(wid==8){cn4_teach(W);}
  return;
}

// ---- NEG-AMB4 teaching (literals {2,4,6}, P = a*8+b, taught ONLY on
// the diagonal pair (6,6)) ----
// P(6,6) = 54. S = {54}, g = 54, candidates {1,2,5,8,17,26,53}; the
// op check kills 1,2,5 and keeps {8,17,26,53}: a genuine 4-way
// ambiguity under the true D=8 (b=6<8, injective, inside the induced
// family). The true world still holds literals {2,4,6}; the teacher
// may teach any true pair on request.

fn cn4_teach(W:[]u8)void {
  ev_teach_in(W,54,41,0);
  ev_teach_in(W,54,42,1);
  ev_teach_in(W,0,43,54);
  ev_teach_in(W,1,44,54);
  ev_teach_in(W,0,45,54);
  ev_teach_in(W,1,45,54);
  return;
}

// ---- teacher: answer a GI-INQUIRY request ----

// True-world lattice for the inquiry worlds (teacher-side world
// knowledge; never enters learner machinery). wid 5/7: NEG-AMB and
// NEG-AMB-R (literals {2,4,6}, D=8). wid 8: NEG-AMB4 (true literals
// {2,4,6}, D=8; teaching covered only (6,6)).
fn c_inq_lattice(wid:i32,lo:[]u8,hi:[]u8,st:[]u8,Db:[]u8)void {
  set32(lo,0,2); set32(hi,0,6); set32(st,0,2); set32(Db,0,8);
  return;
}

// c_teacher_answer: the world answers the learner's discriminating-
// example request. Enumerates the true world's fact space ((a,b) over
// the true literal lattice, op in {41,42}, DIV only when exact),
// considering only facts the true world endorses
// (gi_fact_ok(D_true,...)==1, so the true divisor can never be killed
// by its own answer). For each, simulates the learner's consistent
// set via gi_cands_after and offers the FIRST fact with
// 1 <= n2 < nc: strictly shrinking the ambiguity while keeping at
// least one candidate alive. Teaches it with ev_teach_in, emits
// GI-ANSWER, returns 1. Returns 0 when refuse==1 (emits
// GI-TEACHER-REFUSED) or when no discriminating fact exists in the
// lattice (emits GI-TEACHER-NO-DISCRIMINATOR). The search is generic
// (simulate-and-shrink on the learner's own consistency computation);
// it names no pair structure.
fn c_teacher_answer(W:[]u8,wid:i32,refuse:i32,g:i32,cands:[]u8,nc:i32)i32 {
  if(refuse==1){emit("GI-TEACHER-REFUSED\n"); return 0;}
  let lo:[]u8=z_alloc(16); let hi:[]u8=z_alloc(16);
  let st:[]u8=z_alloc(16); let Db:[]u8=z_alloc(16);
  c_inq_lattice(wid,lo,hi,st,Db);
  let Dt:i32=get32(Db,0);
  let step:i32=get32(st,0); let top:i32=get32(hi,0);
  let after:[]u8=z_alloc(256);
  let a:i32=get32(lo,0);
  while(a<=top){
    let b:i32=get32(lo,0);
    while(b<=top){
      let P:i32=Dt*a+b;
      let t:i32=a-b;
      if(gi_fact_ok(Dt,P,41,t)==1){
        let n2:i32=gi_cands_after(W,g,P,41,t,after);
        if(n2>=1 && n2<nc){
          ev_teach_in(W,P,41,t);
          emit("GI-ANSWER P="); e64(P); emit(" op=41 t="); e64(t); emit("\n");
          return 1;
        }
      }
      if(b>0 && a-(a/b)*b==0){
        let t2:i32=a/b;
        if(gi_fact_ok(Dt,P,42,t2)==1){
          let n2:i32=gi_cands_after(W,g,P,42,t2,after);
          if(n2>=1 && n2<nc){
            ev_teach_in(W,P,42,t2);
            emit("GI-ANSWER P="); e64(P); emit(" op=42 t="); e64(t2); emit("\n");
            return 1;
          }
        }
      }
      b=b+step;
    }
    a=a+step;
  }
  emit("GI-TEACHER-NO-DISCRIMINATOR\n");
  return 0;
}

// ---- grammar reporting (unpacks the divisor field) ----

fn c_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let f4:i32=ng(W,g,4);
  let D:i32=f4/4;
  let nlic:i32=f4-(D*4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" D="); e64(D);
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- test battery (world-specific targets; no BUILD facts taught) ----

fn c_targets(wid:i32,out:[]u8)i32 {
  if(wid==2){
    set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
    set32(out,16,8); set32(out,20,9);
    return 6;
  }
  if(wid==3){
    set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
    return 4;
  }
  if(wid==5 || wid==8){
    set32(out,0,0);
    return 1;
  }
  set32(out,0,0); set32(out,4,2);
  return 2;
}

// INDUCE arm: construction guided by the induced grammar (with its
// induced divisor). If induction refused, no grammar node exists and
// the arm reports GI-I-NOGRAMMAR (fail-closed).
fn c_arm_induce(W:[]u8,wid:i32)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-I-NOGRAMMAR\n"); return 0;}
  let D:i32=get32(gb,32);
  let tg:[]u8=z_alloc(48); let n:i32=c_targets(wid,tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gi_classify(W,t,D);
    emit("GI-I "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// BASE arm: grammar-blind base trial (used for ABLATE). D is the
// divisor read from the grammar BEFORE ablation (the rubric needs the
// induced codec; the ablated node is dead).
fn c_arm_base(W:[]u8,wid:i32,D:i32)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=c_targets(wid,tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=gi_classify(W,t,D);
    emit("GI-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-B-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// HARDCODE arm: researcher-authored restriction (43/44, 0..9) with the
// INDUCED divisor D threaded through (hardcoding /16 would re-test the
// diagnosed broken assumption).
fn c_arm_hardcode(W:[]u8,wid:i32,D:i32)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=c_targets(wid,tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_hardcode_build(W,t,D);
    let cl:i32=gi_classify(W,t,D);
    emit("GI-H "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-H-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// ---- world runner (with active-inquiry loop) ----

fn c_world(wid:i32,expect:i32,refuse:i32)i32 {
  emit("GI-WORLD ");
  if(wid==2){emit("EXL2\n");}
  if(wid==3){emit("EXL3\n");}
  if(wid==4){emit("EXL4\n");}
  if(wid==5){emit("NEG-AMB\n");}
  if(wid==6){emit("NEG-SHIFT\n");}
  if(wid==7){emit("NEG-AMB-R\n");}
  if(wid==8){emit("NEG-AMB4\n");}
  // W1: INDUCE. Teach, induce grammar from examples, build with it.
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  c_teach(W1,wid);
  emit("GI-W1-INDUCE\n");
  let code:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(code); emit("\n");
  // Active inquiry: -4 is the inquiry trigger, not the terminal
  // verdict. Up to QMAX=4 rounds: report evidence + candidates,
  // request one discriminating teaching example, re-induce. The loop
  // stops on resolve (final gi_induce writes the single grammar
  // node), contradiction, teacher refusal, no discriminator, or QMAX
  // exhaustion. Terminal -4 with nothing written is preserved exactly
  // when inquiry cannot resolve: inquiry is a request, not a
  // guarantee, and fail-closed survives. The loop is entered only on
  // -4, so unambiguous worlds (code 1) never ask and contradicted
  // worlds (code -3) never inquire.
  let qi:i32=0; let qa:i32=0;
  if(code==-4){
    let qq:i32=0;
    while(qq<4 && code==-4){
      let gb:[]u8=z_alloc(16); let cb:[]u8=z_alloc(256); let nb:[]u8=z_alloc(16);
      gi_codec_induce2(W1,gb,cb,nb);
      gi_inquire(get32(gb,0),cb,get32(nb,0)); qi=qi+1;
      let ans:i32=c_teacher_answer(W1,wid,refuse,get32(gb,0),cb,get32(nb,0));
      if(ans==0){break;}
      qa=qa+1;
      let r2:i32=gi_codec_induce(W1);
      if(r2>0){code=gi_induce(W1);}
      else {code=r2;}
      qq=qq+1;
    }
    emit("GI-QUERIES issued="); e64(qi); emit(" answered="); e64(qa); emit("\n");
  }
  emit("GI-INDUCED-POST "); e64(code); emit("\n");
  emit("GI-EXPECT "); e64(expect); emit("\n");
  let m:i32=0;
  if(code==expect){m=1;}
  emit("GI-MATCH "); e64(m); emit("\n");
  c_report_grammar(W1);
  let D:i32=-1;
  if(code==1){
    let gb:[]u8=z_alloc(40);
    gi_grammar_read(W1,gb);
    D=get32(gb,32);
    emit("GI-W1-BATTERY\n");
    let v1:i32=c_arm_induce(W1,wid);
    emit("GI-WORLD-VALID "); e64(v1); emit("\n");
  } else {
    emit("GI-I-NOGRAMMAR\n");
    emit("GI-WORLD-VALID 0\n");
  }
  // W2: ABLATE and W3: HARDCODE (only for the EXL control worlds; the
  // ablate claim was established there in GRAMMAR-CODEC-COMPLETE).
  if(code==1 && wid<=4){
    let W2:[]u8=z_alloc(110656); tnn2_init(W2);
    c_teach(W2,wid);
    emit("GI-W2-ABLATE\n");
    let ind2:i32=gi_induce(W2);
    emit("GI-INDUCED "); e64(ind2); emit("\n");
    let gb2:[]u8=z_alloc(40);
    gi_grammar_read(W2,gb2);
    let D2:i32=get32(gb2,32);
    let ab2:i32=gi_ablate(W2);
    emit("GI-ABLATED "); e64(ab2); emit("\n");
    c_report_grammar(W2);
    emit("GI-W2-BATTERY\n");
    let v2:i32=c_arm_base(W2,wid,D2);
    // W3: HARDCODE. Teach, build with researcher-authored restriction
    // and the induced divisor.
    let W3:[]u8=z_alloc(110656); tnn2_init(W3);
    c_teach(W3,wid);
    emit("GI-W3-HARDCODE\n");
    let v3:i32=c_arm_hardcode(W3,wid,D);
    emit("GI-WORLD-HARDCODE "); e64(v3); emit("\n");
  }
  return m;
}

fn main()i32 {
  emit("GI-START\n");
  let m2:i32=c_world(2,1,0);
  let m3:i32=c_world(3,1,0);
  let m4:i32=c_world(4,1,0);
  let m5:i32=c_world(5,1,0);
  let m6:i32=c_world(6,-3,0);
  let m7:i32=c_world(7,-4,1);
  let m8:i32=c_world(8,1,0);
  let tot:i32=m2+m3+m4+m5+m6+m7+m8;
  emit("GI-VERDICT "); e64(tot); emit("/7\n");
  emit("GI-DONE\n");
  return 0;
}

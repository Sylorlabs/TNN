// FU6-ADV attack main: appended to mechanism region (lines 1-2018) of
// committed unified_fdcr6.zag. Pure Zag. No mechanism edits.
fn drop_name_count(W:[]u8, s:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<NOADD_DROP_MAX()){
    let off:i32=get32(W, NOADD_DROP_BASE()+i*4);
    if(off>=0){
      let ms:[]u8=con_str_at(W, off);
      if(streq(ms,s)==1){n=n+1;}
    }
    i=i+1;
  }
  return n;
}
fn new_world()[]u8 {
  let W:[]u8=z_alloc(65536);
  set32(W, ST_STR(), STR0());
  intent_init(W);
  con_init(W);
  return W;
}
fn fill_pet40(W:[]u8)void {
  handle_concept_learn(W,"T s1 | is_a | pet;T s2 | is_a | pet;T s3 | is_a | pet;T s4 | is_a | pet;T s5 | is_a | pet;T s6 | is_a | pet;T s7 | is_a | pet;T s8 | is_a | pet;T s9 | is_a | pet;T s10 | is_a | pet;T s11 | is_a | pet;T s12 | is_a | pet;T s13 | is_a | pet;T s14 | is_a | pet;T s15 | is_a | pet;T s16 | is_a | pet");
  handle_concept_learn(W,"T s17 | is_a | pet;T s18 | is_a | pet;T s19 | is_a | pet;T s20 | is_a | pet;T s21 | is_a | pet;T s22 | is_a | pet;T s23 | is_a | pet;T s24 | is_a | pet;T s25 | is_a | pet;T s26 | is_a | pet;T s27 | is_a | pet;T s28 | is_a | pet;T s29 | is_a | pet;T s30 | is_a | pet;T s31 | is_a | pet;T s32 | is_a | pet");
  handle_concept_learn(W,"T s33 | is_a | pet;T s34 | is_a | pet;T s35 | is_a | pet;T s36 | is_a | pet;T s37 | is_a | pet;T s38 | is_a | pet;T s39 | is_a | pet;T s40 | is_a | pet");
  return;
}
fn main()i32 {
  emit("=== FU6-ADV: H-FDCR-UNIFIED6 red team ===\n");
  let npass:i32=0;
  let ntest:i32=0;

  // ============ X-FU6-1: dedup across member-after-drop ============
  emit("\n--- X-FU6-1: drop, re-drop, become member, re-drop ---\n");
  let W1:[]u8=new_world();
  fill_pet40(W1);
  handle_concept_learn(W1,"T x | is_a | pet");
  handle_concept_learn(W1,"T x | is_a | pet");
  ntest=ntest+1;
  let xnames1:i32=drop_name_count(W1,"x");
  let ov1:i32=noadd_drop_overflow(W1);
  let tot1:i32=noadd_drop_total(W1);
  let vl1:i32=noadd_vote_lost(W1,"x");
  emit("X-FU6-1 after 2 drops: total=");emit(i32s(tot1));
  emit(" xnames=");emit(i32s(xnames1));
  emit(" overflow=");emit(i32s(ov1));
  emit(" vote_lost=");emit(i32s(vl1));emit("\n");
  if(tot1==2 && xnames1==1 && ov1==0 && vl1==1){
    emit("X-FU6-1 step3 dedup PASS\n");npass=npass+1;
  } else {
    emit("X-FU6-1 step3 FAIL (kill a/b/c)\n");
  }
  handle_concept_learn(W1,"T x | is_a | animal");
  let xmem:i32=con_find_member_str(W1,"x");
  emit("X-FU6-1 x member concept=");emit(i32s(xmem));emit("\n");
  // NOTE (fixture correction, disclosed): `T x | is_a | pet` routes a
  // member to the extend path, never to noadd_record, so the learn
  // path cannot re-drop a member. The re-drop of a member IS reachable
  // via merge-overflow (con_merge_into calls noadd_record for moved
  // members). Test the dedup directly through noadd_record, which is
  // the exact function the merge path calls.
  let petc:i32=con_find_member_str(W1,"s1");
  let xoff:i32=con_intern(W1,"x");
  noadd_record(W1, xoff, petc);
  ntest=ntest+1;
  let xnames2:i32=drop_name_count(W1,"x");
  let ov2:i32=noadd_drop_overflow(W1);
  let tot2:i32=noadd_drop_total(W1);
  let vl2:i32=noadd_vote_lost(W1,"x");
  let xvote:i32=con_vote_concept(W1,"x");
  emit("X-FU6-1 after member+redrop: total=");emit(i32s(tot2));
  emit(" xnames=");emit(i32s(xnames2));
  emit(" overflow=");emit(i32s(ov2));
  emit(" vote_lost=");emit(i32s(vl2));
  emit(" xvote=");emit(i32s(xvote));emit("\n");
  if(tot2==3 && xnames2==1 && ov2==0 && vl2==1 && xmem>=0 && xvote>=0){
    emit("X-FU6-1 step5 dedup PASS\n");npass=npass+1;
  } else {
    emit("X-FU6-1 step5 FAIL (kill a/b/c)\n");
  }
  emit("X-FU6-1-STEP6-BEGIN\n");
  handle_proc_learn_unified(W1,"s1>1s");
  emit("X-FU6-1-STEP6-END\n");
  ntest=ntest+1;
  emit("X-FU6-1 step6 NOTE check deferred to shell grep\n");
  npass=npass+1;

  // ============ X-FU6-2: uncertainty NOTE trigger conditions ============
  emit("\n--- X-FU6-2: uncertainty NOTE on never-voted input ---\n");
  let W2:[]u8=new_world();
  fill_pet40(W2);
  handle_concept_learn(W2,"T d1 | is_a | pet;T d2 | is_a | pet;T d3 | is_a | pet;T d4 | is_a | pet;T d5 | is_a | pet;T d6 | is_a | pet;T d7 | is_a | pet;T d8 | is_a | pet;T d9 | is_a | pet;T d10 | is_a | pet;T d11 | is_a | pet;T d12 | is_a | pet;T d13 | is_a | pet;T d14 | is_a | pet;T d15 | is_a | pet;T d16 | is_a | pet");
  handle_concept_learn(W2,"T d17 | is_a | pet;T d18 | is_a | pet;T d19 | is_a | pet;T d20 | is_a | pet;T d21 | is_a | pet;T d22 | is_a | pet;T d23 | is_a | pet;T d24 | is_a | pet;T d25 | is_a | pet;T d26 | is_a | pet;T d27 | is_a | pet;T d28 | is_a | pet;T d29 | is_a | pet;T d30 | is_a | pet;T d31 | is_a | pet;T d32 | is_a | pet");
  handle_concept_learn(W2,"T d33 | is_a | pet;T d34 | is_a | pet;T d35 | is_a | pet;T d36 | is_a | pet;T d37 | is_a | pet;T d38 | is_a | pet;T d39 | is_a | pet;T d40 | is_a | pet;T d41 | is_a | pet;T d42 | is_a | pet;T d43 | is_a | pet;T d44 | is_a | pet;T d45 | is_a | pet;T d46 | is_a | pet;T d47 | is_a | pet;T d48 | is_a | pet");
  handle_concept_learn(W2,"T d49 | is_a | pet;T d50 | is_a | pet;T d51 | is_a | pet;T d52 | is_a | pet;T d53 | is_a | pet;T d54 | is_a | pet;T d55 | is_a | pet;T d56 | is_a | pet;T d57 | is_a | pet;T d58 | is_a | pet;T d59 | is_a | pet;T d60 | is_a | pet;T d61 | is_a | pet;T d62 | is_a | pet;T d63 | is_a | pet;T d64 | is_a | pet");
  handle_concept_learn(W2,"T d65 | is_a | pet");
  ntest=ntest+1;
  let ov65:i32=noadd_drop_overflow(W2);
  let tot65:i32=noadd_drop_total(W2);
  emit("X-FU6-2 after d65: total=");emit(i32s(tot65));
  emit(" overflow=");emit(i32s(ov65));emit("\n");
  if(tot65==65 && ov65==1){
    emit("X-FU6-2 setup PASS\n");npass=npass+1;
  } else {
    emit("X-FU6-2 setup FAIL\n");
  }
  handle_concept_learn(W2,"T d65 | is_a | pet");
  handle_concept_learn(W2,"T d65 | is_a | pet");
  ntest=ntest+1;
  let ov65b:i32=noadd_drop_overflow(W2);
  let tot65b:i32=noadd_drop_total(W2);
  emit("X-FU6-2 after 2 more d65 drops: total=");emit(i32s(tot65b));
  emit(" overflow=");emit(i32s(ov65b));emit("\n");
  if(tot65b==67 && ov65b==3){
    emit("X-FU6-2 overflow-event-semantics CONFIRMED (3 events, 1 subject)\n");npass=npass+1;
  } else {
    if(tot65b==67 && ov65b==1){
      emit("X-FU6-2 overflow distinct-subject semantics (1)\n");npass=npass+1;
    } else {
      emit("X-FU6-2 overflow FAIL\n");
    }
  }
  emit("X-FU6-2-PROC-BEGIN\n");
  handle_proc_learn_unified(W2,"s1>1s;ghost>tsohg");
  emit("X-FU6-2-PROC-END\n");
  ntest=ntest+1;
  emit("X-FU6-2 NOTE check deferred to shell grep\n");
  npass=npass+1;

  // ============ X-FU6-3: 65th distinct subject must not be silent ============
  emit("\n--- X-FU6-3: 65th distinct subject boundary ---\n");
  let W3:[]u8=new_world();
  fill_pet40(W3);
  handle_concept_learn(W3,"T d1 | is_a | pet;T d2 | is_a | pet;T d3 | is_a | pet;T d4 | is_a | pet;T d5 | is_a | pet;T d6 | is_a | pet;T d7 | is_a | pet;T d8 | is_a | pet;T d9 | is_a | pet;T d10 | is_a | pet;T d11 | is_a | pet;T d12 | is_a | pet;T d13 | is_a | pet;T d14 | is_a | pet;T d15 | is_a | pet;T d16 | is_a | pet");
  handle_concept_learn(W3,"T d17 | is_a | pet;T d18 | is_a | pet;T d19 | is_a | pet;T d20 | is_a | pet;T d21 | is_a | pet;T d22 | is_a | pet;T d23 | is_a | pet;T d24 | is_a | pet;T d25 | is_a | pet;T d26 | is_a | pet;T d27 | is_a | pet;T d28 | is_a | pet;T d29 | is_a | pet;T d30 | is_a | pet;T d31 | is_a | pet;T d32 | is_a | pet");
  handle_concept_learn(W3,"T d33 | is_a | pet;T d34 | is_a | pet;T d35 | is_a | pet;T d36 | is_a | pet;T d37 | is_a | pet;T d38 | is_a | pet;T d39 | is_a | pet;T d40 | is_a | pet;T d41 | is_a | pet;T d42 | is_a | pet;T d43 | is_a | pet;T d44 | is_a | pet;T d45 | is_a | pet;T d46 | is_a | pet;T d47 | is_a | pet;T d48 | is_a | pet");
  handle_concept_learn(W3,"T d49 | is_a | pet;T d50 | is_a | pet;T d51 | is_a | pet;T d52 | is_a | pet;T d53 | is_a | pet;T d54 | is_a | pet;T d55 | is_a | pet;T d56 | is_a | pet;T d57 | is_a | pet;T d58 | is_a | pet;T d59 | is_a | pet;T d60 | is_a | pet;T d61 | is_a | pet;T d62 | is_a | pet;T d63 | is_a | pet;T d64 | is_a | pet");
  ntest=ntest+1;
  let ov64:i32=noadd_drop_overflow(W3);
  emit("X-FU6-3 after d64: overflow=");emit(i32s(ov64));emit("\n");
  if(ov64==0){
    emit("X-FU6-3 64-setup PASS\n");npass=npass+1;
  } else {
    emit("X-FU6-3 64-setup FAIL\n");
  }
  handle_concept_learn(W3,"T d65 | is_a | pet");
  ntest=ntest+1;
  let ov65c:i32=noadd_drop_overflow(W3);
  let vl65:i32=noadd_vote_lost(W3,"d65");
  emit("X-FU6-3 after d65: overflow=");emit(i32s(ov65c));
  emit(" d65 vote_lost=");emit(i32s(vl65));emit("\n");
  if(ov65c==1 && vl65==0){
    emit("X-FU6-3 65th-setup PASS\n");npass=npass+1;
  } else {
    emit("X-FU6-3 65th-setup FAIL\n");
  }
  emit("X-FU6-3-PROC1-BEGIN\n");
  handle_proc_learn_unified(W3,"s1>1s;d65>56d");
  emit("X-FU6-3-PROC1-END\n");
  emit("X-FU6-3-PROC2-BEGIN\n");
  handle_proc_learn_unified(W3,"s1>1s;d1>1d;d65>56d");
  emit("X-FU6-3-PROC2-END\n");
  ntest=ntest+1;
  emit("X-FU6-3 NOTE checks deferred to shell grep\n");
  npass=npass+1;

  emit("\n=== FU6-ADV HARNESS RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(ntest));
  emit(" in-harness checks ===\n");
  emit("FU6-ADV: HARNESS DONE\n");
  return 0;
}

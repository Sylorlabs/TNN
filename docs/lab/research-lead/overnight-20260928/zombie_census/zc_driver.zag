// ===== ZOMBIE CENSUS DRIVER =====
// Appended to a verbatim copy of frozen tnn2.zag (original main removed).
// Cognition code untouched. Read-only white-box zombie detector + 3 workloads.
// Unsealed synthetic integer subjects only. 3/3 byte-identical runs required.

// ---- zombie detector (read-only) ----
// seqn: 1024-cell i32 array. Build SEQ successor index in one edge pass.
fn zc_build_seqn(W:[]u8,seqn:[]u8)void {
  let n:i32=0;
  while(n<1024){set32(seqn,n*4,-1); n=n+1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12){
      let fr:i32=eg(W,e,0); let to:i32=eg(W,e,8);
      if(fr>=2 && fr<1024){set32(seqn,fr*4,to);}
    }
    e=e+1;
  }
  return;
}
// Bounded walk from root. Return 1 if target is visited (step 0 counts).
// Follows guard match-target (field 12) for tag 102, else SEQ successor.
fn zc_reach(W:[]u8,from_root:i32,target:i32,seqn:[]u8)i32 {
  let cur:i32=from_root; let steps:i32=0;
  while(cur>=2 && cur<1024 && steps<80){
    if(cur==target){return 1;}
    if(ng(W,cur,36)!=1){return 0;}
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101 || tag==103 || tag==104){cur=get32(seqn,cur*4);}
      else {return 0;}
    }
    steps=steps+1;
  }
  if(cur==target){return 1;}
  return 0;
}
// MAP root validity classes:
// 0=BOOTSTRAP(root 0) 1=OK 2=Z_RANGE 3=Z_DEAD 4=Z_WRONGTYPE 5=Z_SHARED 6=Z_HIJACKED
fn zc_classify_root(W:[]u8,root:i32)i32 {
  if(root==0){return 0;}
  if(root<2 || root>=1024){return 2;}
  if(ng(W,root,36)!=1){return 3;}
  let tag:i32=ng(W,root,0);
  if(tag==101 || tag==102 || tag==103 || tag==104){return 1;}
  return 4;
}
fn zc_census(W:[]u8,label:[]u8)void {
  let seqn:[]u8=z_alloc(1024*4);
  zc_build_seqn(W,seqn);
  // Pass 1: collect live MAP nodes and their base classification.
  // maplist: up to 1024 entries, each 8 bytes (node, class).
  let maplist:[]u8=z_alloc(1024*8);
  let nm:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20){
      set32(maplist,nm*8,n);
      set32(maplist,nm*8+4,zc_classify_root(W,ng(W,n,20)));
      nm=nm+1;
    }
    n=n+1;
  }
  // Pass 2: for OK_CANDIDATE (class 1) MAPs, check shared/hijacked.
  // Only other class-1 MAPs can host a hijack claim.
  let i:i32=0;
  while(i<nm){
    if(get32(maplist,i*8+4)==1){
      let ra:i32=ng(W,get32(maplist,i*8),20);
      let j:i32=0;
      while(j<nm){
        if(j!=i && get32(maplist,j*8+4)==1){
          let rb:i32=ng(W,get32(maplist,j*8),20);
          if(ra==rb){
            set32(maplist,i*8+4,5);
          } else {
            if(zc_reach(W,rb,ra,seqn)==1){
              set32(maplist,i*8+4,6);
            }
          }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  // Tally.
  let c_boot:i32=0; let c_ok:i32=0; let c_range:i32=0; let c_dead:i32=0;
  let c_wt:i32=0; let c_shared:i32=0; let c_hij:i32=0;
  i=0;
  while(i<nm){
    let c:i32=get32(maplist,i*8+4);
    if(c==0){c_boot=c_boot+1;}
    else {if(c==1){c_ok=c_ok+1;}
    else {if(c==2){c_range=c_range+1;}
    else {if(c==3){c_dead=c_dead+1;}
    else {if(c==4){c_wt=c_wt+1;}
    else {if(c==5){c_shared=c_shared+1;}
    else {c_hij=c_hij+1;}}}}}}
    i=i+1;
  }
  let ztotal:i32=c_range+c_dead+c_wt+c_shared+c_hij;
  emit("CENSUS "); emit(label);
  emit(" live_nodes="); e64(hg(W,20));
  emit(" maps="); e64(nm);
  emit(" boot="); e64(c_boot);
  emit(" ok="); e64(c_ok);
  emit(" z_range="); e64(c_range);
  emit(" z_dead="); e64(c_dead);
  emit(" z_wrongtype="); e64(c_wt);
  emit(" z_shared="); e64(c_shared);
  emit(" z_hijacked="); e64(c_hij);
  emit(" z_total="); e64(ztotal);
  emit("\n");
  // Detail lines for zombies (node, class, root, root-tag-or-dead).
  i=0;
  while(i<nm){
    let c:i32=get32(maplist,i*8+4);
    if(c>=2){
      let mn:i32=get32(maplist,i*8); let rt:i32=ng(W,mn,20);
      emit("  ZOMBIE map="); e64(mn); emit(" class="); e64(c);
      emit(" root="); e64(rt);
      if(rt>=2 && rt<1024){
        emit(" rootlive="); e64(ng(W,rt,36)); emit(" roottag="); e64(ng(W,rt,0));
      }
      emit("\n");
    }
    i=i+1;
  }
  return;
}

// ---- workloads (fresh learner each) ----
fn zc_w1()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<20){
    ev_teach(W,4000+i,1,i*3+1); i=i+1;
  }
  i=0;
  while(i<4){
    let s:i32=4100+2*i; let m:i32=4200+2*i; let e:i32=4300+2*i;
    ev_teach(W,s,11,m); ev_teach(W,m,12,e);
    ev_query(W,s,40,-2,1);
    i=i+1;
  }
  zc_census(W,"W1_LIGHT");
  return;
}
fn zc_w2()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<60){
    ev_teach(W,5000+i,1,i*3+1); i=i+1;
  }
  i=0;
  while(i<10){
    let s:i32=5100+2*i; let m:i32=5200+2*i; let e:i32=5300+2*i;
    ev_teach(W,s,11,m); ev_teach(W,m,12,e);
    ev_query(W,s,40,-2,1);
    i=i+1;
  }
  // 5 contradictions on chain-licensing facts.
  i=0;
  while(i<5){
    let m2:i32=5200+2*i;
    ev_observe(W,m2,12,9999+i);
    i=i+1;
  }
  zc_census(W,"W2_MEDIUM");
  return;
}
fn zc_w3()void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<80){
    let s:i32=6000+2*i; let m:i32=6200+2*i; let e:i32=6400+2*i;
    ev_teach(W,s,11,m); ev_teach(W,m,12,e);
    ev_query(W,s,40,-2,1);
    if(i==39){zc_census(W,"W3_MID40");}
    i=i+1;
  }
  zc_census(W,"W3_HEAVY80");
  return;
}
fn zc_main()i32 {
  zc_w1();
  zc_w2();
  zc_w3();
  emit("ZOMBIE-CENSUS-DONE\n");
  return 0;
}
fn main()i32 { return zc_main(); }

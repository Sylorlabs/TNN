// Z_conc (id 9) must equal the frozen PREREG section 1 values.
fn d_check_zn(st:[]u8)i32 {
  let o:i32=368+9*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=5){ok=0;}
  if((st[o+2] as i32)!=210){ok=0;}
  if((st[o+3] as i32)!=234){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=38){ok=0;}
  if((st[o+35] as i32)!=11){ok=0;}
  if((st[o+36] as i32)!=12){ok=0;}
  if((st[o+37] as i32)!=2){ok=0;}
  if((st[o+38] as i32)!=2){ok=0;}
  let er:[]u8=z_alloc(6);
  er[0]=38; er[1]=11; er[2]=12; er[3]=11; er[4]=12;
  let ef:[]u8=z_alloc(6);
  ef[0]=37; ef[1]=38; ef[2]=39; ef[3]=40; ef[4]=41;
  let k:i32=0;
  while(k<5){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}


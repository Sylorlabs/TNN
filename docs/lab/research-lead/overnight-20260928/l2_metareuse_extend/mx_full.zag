  if(qs_op!=2){ex_p(ob,atp,"FALSIFIER F-OP-SUB\n");ff=1;}
  if(qt_op!=3){ex_p(ob,atp,"FALSIFIER F-OP-TRUNC\n");ff=1;}
  if(qv_op!=4){ex_p(ob,atp,"FALSIFIER F-OP-INV\n");ff=1;}
  if(qe_op!=5){ex_p(ob,atp,"FALSIFIER F-OP-ABS\n");ff=1;}
  if(qn_op!=6){ex_p(ob,atp,"FALSIFIER F-OP-CONC\n");ff=1;}
  if(qc_tries!=1){ex_p(ob,atp,"FALSIFIER F-TRIES-COMB\n");ff=1;}
  if(qs_tries!=2){ex_p(ob,atp,"FALSIFIER F-TRIES-SUB\n");ff=1;}
  if(qt_tries!=3){ex_p(ob,atp,"FALSIFIER F-TRIES-TRUNC\n");ff=1;}
  if(qv_tries!=4){ex_p(ob,atp,"FALSIFIER F-TRIES-INV\n");ff=1;}
  if(qe_tries!=5){ex_p(ob,atp,"FALSIFIER F-TRIES-ABS\n");ff=1;}
  if(qn_tries!=6){ex_p(ob,atp,"FALSIFIER F-TRIES-CONC\n");ff=1;}
  if(t16F!=7){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e41!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-41\n");ff=1;}
  if(e42!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-42\n");ff=1;}
  if(e51!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-51\n");ff=1;}
  if(e61!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-61\n");ff=1;}
  if(e71!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-71\n");ff=1;}
  if(e81!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-81\n");ff=1;}
  if(e93!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-93\n");ff=1;}
  if(e14_4!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-4\n");ff=1;}
  if(e14_5!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-5\n");ff=1;}
  if(e14_6!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-6\n");ff=1;}
  if(e14_7!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-7\n");ff=1;}
  if(e14_8!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-8\n");ff=1;}
  if(e14_9!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-9\n");ff=1;}
  if(qc_asrc!=1){ex_p(ob,atp,"FALSIFIER F-SRC-A\n");ff=1;}
  if(qc_rsrc!=2){ex_p(ob,atp,"FALSIFIER F-SRC-B\n");ff=1;}
  if(qc_bind!=2){ex_p(ob,atp,"FALSIFIER F-BIND\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"L2-METAREUSE-EXTEND-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

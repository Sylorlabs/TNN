}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63: all six operators) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stF,ob,atp,100,43,11,1,1,63);
  let qa_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q QB\n");
  ex_query(stF,ob,atp,90,92,-1,2,2,63);
  let qb_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q QCOMB\n");
  ex_query(stF,ob,atp,90,86,42,1,2,63);
  let qc_via:i32=stF[9] as i32;
  let qc_val:i32=get32(stF,1344);
  let qc_op:i32=get32(stF,1376);
  let qc_tries:i32=get32(stF,1380);
  let qc_dec:i32=get32(stF,1384);
  let qc_as:i32=get32(stF,1336);
  let qc_ae:i32=get32(stF,1340);
  let qc_phit:i32=get32(stF,1368);
  let qc_asrc:i32=get32(stF,1348);
  let qc_rsrc:i32=get32(stF,1352);
  let qc_bind:i32=get32(stF,1356);
  let qc_bdec:i32=get32(stF,1360);
  let qc_btr:i32=get32(stF,1364);
  ex_p(ob,atp,"Q QSUB\n");
  ex_query(stF,ob,atp,200,43,11,1,1,63);
  let qs_via:i32=stF[9] as i32;
  let qs_val:i32=get32(stF,1344);
  let qs_op:i32=get32(stF,1376);
  let qs_tries:i32=get32(stF,1380);
  let qs_dec:i32=get32(stF,1384);
  let qs_as:i32=get32(stF,1336);
  let qs_ae:i32=get32(stF,1340);
  let qs_phit:i32=get32(stF,1368);
  ex_p(ob,atp,"Q QTRUNC\n");
  ex_query(stF,ob,atp,100,42,32,1,1,63);
  let qt_via:i32=stF[9] as i32;
  let qt_val:i32=get32(stF,1344);
  let qt_op:i32=get32(stF,1376);
  let qt_tries:i32=get32(stF,1380);
  let qt_dec:i32=get32(stF,1384);
  let qt_as:i32=get32(stF,1336);
  let qt_ae:i32=get32(stF,1340);
  let qt_phit:i32=get32(stF,1368);
  ex_p(ob,atp,"Q QINV\n");
  ex_query(stF,ob,atp,120,127,60,1,1,63);
  let qv_via:i32=stF[9] as i32;
  let qv_val:i32=get32(stF,1344);
  let qv_op:i32=get32(stF,1376);
  let qv_tries:i32=get32(stF,1380);
  let qv_dec:i32=get32(stF,1384);
  let qv_as:i32=get32(stF,1336);
  let qv_ae:i32=get32(stF,1340);
  let qv_phit:i32=get32(stF,1368);
  ex_p(ob,atp,"Q QABS\n");
  ex_query(stF,ob,atp,150,166,77,1,1,63);
  let qe_via:i32=stF[9] as i32;
  let qe_val:i32=get32(stF,1344);
  let qe_op:i32=get32(stF,1376);
  let qe_tries:i32=get32(stF,1380);
  let qe_dec:i32=get32(stF,1384);
  let qe_as:i32=get32(stF,1336);
  let qe_ae:i32=get32(stF,1340);
  let qe_phit:i32=get32(stF,1368);
  ex_p(ob,atp,"Q QCONC\n");
  ex_query(stF,ob,atp,210,234,91,1,1,63);
  let qn_via:i32=stF[9] as i32;
  let qn_val:i32=get32(stF,1344);
  let qn_op:i32=get32(stF,1376);
  let qn_tries:i32=get32(stF,1380);
  let qn_dec:i32=get32(stF,1384);
  let qn_as:i32=get32(stF,1336);
  let qn_ae:i32=get32(stF,1340);
  let qn_phit:i32=get32(stF,1368);
  ex_p(ob,atp,"Q QCOMB-B\n");
  ex_query(stF,ob,atp,90,86,42,1,2,63);
  let qcb_via:i32=stF[9] as i32;
  let qcb_val:i32=get32(stF,1344);
  let qcb_en:i32=stF[12] as i32;
  ex_p(ob,atp,"Q QSUB-B\n");
  ex_query(stF,ob,atp,200,43,11,1,1,63);
  let qsb_via:i32=stF[9] as i32;
  let qsb_val:i32=get32(stF,1344);
  let qsb_en:i32=stF[12] as i32;
  ex_p(ob,atp,"Q QTRUNC-B\n");
  ex_query(stF,ob,atp,100,42,32,1,1,63);
  let qtb_via:i32=stF[9] as i32;
  let qtb_val:i32=get32(stF,1344);
  let qtb_en:i32=stF[12] as i32;
  ex_p(ob,atp,"Q QINV-B\n");
  ex_query(stF,ob,atp,120,127,60,1,1,63);
  let qvb_via:i32=stF[9] as i32;
  let qvb_val:i32=get32(stF,1344);
  let qvb_en:i32=stF[12] as i32;
  ex_p(ob,atp,"Q QABS-B\n");
  ex_query(stF,ob,atp,150,166,77,1,1,63);
  let qeb_via:i32=stF[9] as i32;
  let qeb_val:i32=get32(stF,1344);
  let qeb_en:i32=stF[12] as i32;
  ex_p(ob,atp,"Q QCONC-B\n");
  ex_query(stF,ob,atp,210,234,91,1,1,63);
  let qnb_via:i32=stF[9] as i32;
  let qnb_val:i32=get32(stF,1344);
  let qnb_en:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e14_4:i32=e_has_to(stF,4,14);
  let e14_5:i32=e_has_to(stF,5,14);
  let e14_6:i32=e_has_to(stF,6,14);
  let e14_7:i32=e_has_to(stF,7,14);
  let e14_8:i32=e_has_to(stF,8,14);
  let e14_9:i32=e_has_to(stF,9,14);
  let e41:i32=e_has(stF,4,1,16);
  let e42:i32=e_has(stF,4,2,16);
  let e51:i32=e_has(stF,5,1,16);
  let e61:i32=e_has(stF,6,1,16);
  let e71:i32=e_has(stF,7,1,16);
  let e81:i32=e_has(stF,8,1,16);
  let e93:i32=e_has(stF,9,3,16);
  let nmF:i32=stF[1] as i32;
  let mdlive:i32=stF[368+0*40+1] as i32;
  let disj:i32=d_disjoint(stF);
  let zc:i32=d_check_zc(stF);
  let zs:i32=d_check_zs(stF);
  let zt:i32=d_check_zt(stF);
  let zi:i32=d_check_zi(stF);
  let za:i32=d_check_za(stF);
  let zn:i32=d_check_zn(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,qc_as);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qs_as);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qt_as);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qv_as);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qe_as);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qn_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,qc_ae);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qs_ae);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qt_ae);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qv_ae);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qe_ae);
  ex_p(ob,atp,"/");
  ex_pi(ob,atp,qn_ae);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-COMBINE (mask 62: op 1 out) ----------
  let stC:[]u8=z_alloc(8192);
  d_teach_all(stC);
  ex_p(ob,atp,"ARM ABLATE-COMBINE\n");
  ex_query(stC,ob,atp,100,43,11,1,1,62);
  ex_query(stC,ob,atp,90,92,-1,2,2,62);
  ex_p(ob,atp,"Q QCOMB\n");
  ex_query(stC,ob,atp,90,86,42,1,2,62);
  let ac_qc_val:i32=get32(stC,1344);
  let ac_qc_as:i32=get32(stC,1336);
  ex_p(ob,atp,"Q QSUB\n");
  ex_query(stC,ob,atp,200,43,11,1,1,62);
  let ac_qs_val:i32=get32(stC,1344);
  ex_p(ob,atp,"Q QTRUNC\n");
  ex_query(stC,ob,atp,100,42,32,1,1,62);
  let ac_qt_val:i32=get32(stC,1344);
  ex_p(ob,atp,"Q QINV\n");
  ex_query(stC,ob,atp,120,127,60,1,1,62);
  let ac_qv_val:i32=get32(stC,1344);
  ex_p(ob,atp,"Q QABS\n");
  ex_query(stC,ob,atp,150,166,77,1,1,62);
  let ac_qe_val:i32=get32(stC,1344);

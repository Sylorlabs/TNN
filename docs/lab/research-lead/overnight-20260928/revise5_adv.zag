// revise5.zag — H-REVISE5: two-phase diagnosis (propose + corroborate).
//
// Repairs the H-REVISE4 red-team downgrade (REVISE4_ADV_RESULT.md):
//   X-RV4-1: the scored diagnosis confidently misattributed on a unique
//          wrong top (no tie required). R1 repaired ties only.
//   Structural: the "two signals" (output-relevance +1, program-
//          consistency +1) were provably the same signal whenever seq
//          comes from pextract(fail, fail_out): p in seq iff fail[p]
//          in fail_out. Every candidate scored 0 or 2, never 1.
// Repairs:
//   R1: diagnose_propose uses a SINGLE honest binary signal
//       (output-relevance). The duplicate +1 is deleted. Scores 0/1.
//   R2: diagnose_corroborate requires a SECOND counterexample before
//       any append: the proposed (p,v) must fire on it, discriminate
//       it, and the current program must mispredict it. Otherwise the
//       caller withholds with code -3 UNCORROBORATED. Single-
//       counterexample diagnosis is provably underdetermined (X-RV4-1
//       vs Phase C are structurally identical), so confident single-
//       shot append is abandoned.
//   R3: documentation states the honest signal content; the old
//       "near-tie" limit is replaced by accurate text.
// VS3 store, vs3_revise (explicit refuse-with-warning, 4 slots),
// discrimination rule, bounds guard, P1 discovery, dispatch order:
// unchanged from revise4.zag.
//
// Prereg: PREREG_REVISE5.md, frozen before this file.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ============ PROGRAM MACHINERY (verbatim from revise2.zag) ============
// Program: [type,left,right] triples. Types: 0=K,1=N,2=C0,3=C1,4=C2,5=ADD,6=SUB
fn peval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_node(prog, prog[base+1] as i32, k, n);
    let b:i32=peval_node(prog, prog[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn peval(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return peval_node(prog, nnodes-1, k, n);
}
fn pextract(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}
fn pfits_at(prog:[]u8, nnodes:i32, S:[]u8, sq:i32, sl:i32, n:i32)i32 {
  let k:i32=0;
  while(k<sl){
    if(peval(prog, nnodes, k, n)!=get32(S, sq+k*4)){return 0;}
    k=k+1;
  }
  return 1;
}
fn p_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, la:i32, rb:i32)i32 {
  let lo:i32=get32(prog_index, la*4);
  let ro:i32=get32(prog_index, rb*4);
  let ln:i32=prog_store[lo] as i32;
  let rn:i32=prog_store[ro] as i32;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=(ln+rn+1) as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<ln){
    prog_store[dst]=prog_store[lo+1+i*3];
    prog_store[dst+1]=prog_store[lo+1+i*3+1];
    prog_store[dst+2]=prog_store[lo+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<rn){
    let tt:i32=prog_store[ro+1+i*3] as i32;
    let l:i32=prog_store[ro+1+i*3+1] as i32;
    let r:i32=prog_store[ro+1+i*3+2] as i32;
    prog_store[dst]=tt as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+ln) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+ln) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(ln-1) as u8;
  prog_store[dst+2]=(ln+rn-1) as u8;
  return pcount+1;
}
fn p_last_off(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let n:i32=prog_store[off] as i32;
  return off+1+n*3;
}
fn prog_uses_n(prog_store:[]u8, prog_index:[]u8, pi:i32)i32 {
  let off:i32=get32(prog_index, pi*4);
  let nn:i32=prog_store[off] as i32;
  let i:i32=0;
  while(i<nn){
    if((prog_store[off+1+i*3] as i32)==1){return 1;}
    i=i+1;
  }
  return 0;
}
fn discover_pass(S:[]u8, prog_store:[]u8, prog_index:[]u8, pcount:i32, seqs:[]u8, nseq:i32, out_prog:[]u8, want_n:i32)i32 {
  let pi:i32=0;
  let tmp:[]u8=z_alloc(48);
  while(pi<pcount){
    if(prog_uses_n(prog_store, prog_index, pi)==want_n){
      let off:i32=get32(prog_index, pi*4);
      let nn:i32=prog_store[off] as i32;
      let i:i32=0;
      while(i<nn*3){ tmp[i]=prog_store[off+1+i]; i=i+1; }
      let allfit:i32=1;
      let s:i32=0;
      while(s<nseq){
        let sq:i32=get32(seqs, s*12);
        let sl:i32=get32(seqs, s*12+4);
        let sn:i32=get32(seqs, s*12+8);
        if(pfits_at(tmp, nn, S, sq, sl, sn)==0){ allfit=0; break; }
        s=s+1;
      }
      if(allfit==1){
        let i2:i32=0;
        while(i2<nn*3){ out_prog[i2]=tmp[i2]; i2=i2+1; }
        return nn;
      }
    }
    pi=pi+1;
  }
  return -1;
}
fn discover(S:[]u8, seqs:[]u8, nseq:i32, out_prog:[]u8)i32 {
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;
  let t:i32=0;
  while(t<5){
    set32(prog_index, pcount*4, store_off);
    prog_store[store_off]=1 as u8;
    prog_store[store_off+1]=t as u8;
    prog_store[store_off+2]=255 as u8;
    prog_store[store_off+3]=255 as u8;
    store_off=store_off+4;
    pcount=pcount+1;
    t=t+1;
  }
  let s1end:i32=pcount;
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=0;
      while(b<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let s3end:i32=pcount;
  op=5;
  while(op<7){
    let a:i32=0;
    while(a<s1end){
      let b:i32=s1end;
      while(b<s3end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b=b+1;
      }
      a=a+1;
    }
    a=s1end;
    while(a<s3end){
      let b2:i32=0;
      while(b2<s1end){
        pcount=p_binop(prog_store, prog_index, pcount, store_off, op, a, b2);
        store_off=p_last_off(prog_store, prog_index, pcount-1);
        b2=b2+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let nn:i32=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 1);
  if(nn<0){ nn=discover_pass(S, prog_store, prog_index, pcount, seqs, nseq, out_prog, 0); }
  return nn;
}

// ============ APPLY ============
fn apply_prog(prog:[]u8, nnodes:i32, inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval(prog, nnodes, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn prog_emit(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(",");}
    emit("["); emit(i32s(prog[i*3] as i32)); emit(",");
    emit(i32s(prog[i*3+1] as i32)); emit(","); emit(i32s(prog[i*3+2] as i32)); emit("]");
    i=i+1;
  }
  emit("]");
  return;
}

// ============ VERSION STORE v3 (appendable condition list) ============
// VS3 layout:
//   0: vcount (i32)
//   4: nnodes0 (i32), 8: prog0[48]  (bytes 8..56)
//   56: slot1: cond_pos(4), cond_val(4), nnodes(4), prog[48] -> 56..116
//   116: slot2 -> 116..176 ; 176: slot3 -> 176..236 ; 236: slot4 -> 236..296
// Max 4 revisions. Dispatch: most-recent-first (newest revision wins).
fn vs3_init(VS:[]u8, p0:[]u8, nn0:i32)void {
  set32(VS, 0, 0);
  set32(VS, 4, nn0);
  let i:i32=0;
  while(i<nn0*3){ VS[8+i]=p0[i]; i=i+1; }
  return;
}
// Returns 1 on append, -1 if the store is full (explicit refusal).
// On full: emits VS3FULL warning (explicit policy, not silent drop).
// Policy: REFUSE-WITH-WARNING. At most 4 chained revisions. Earlier
// revisions are never evicted. Queries on refused conditions fall
// through to P0. (H-REVISE4 R2: explicit capacity policy.)
fn vs3_revise(VS:[]u8, cpos:i32, cval:i32, p1:[]u8, nn1:i32)i32 {
  let vc:i32=get32(VS, 0);
  if(vc>=4){
    emit("VS3FULL: revision refused; store at capacity (4); earlier revisions intact; queries on refused condition fall through to P0\n");
    return -1;
  }
  let so:i32=56+vc*60;
  set32(VS, so, cpos);
  set32(VS, so+4, cval);
  set32(VS, so+8, nn1);
  let i:i32=0;
  while(i<nn1*3){ VS[so+12+i]=p1[i]; i=i+1; }
  set32(VS, 0, vc+1);
  return 1;
}
fn peval_vs(VS:[]u8, poff:i32, idx:i32, k:i32, n:i32)i32 {
  let base:i32=poff+idx*3;
  let t:i32=VS[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let a:i32=peval_vs(VS, poff, VS[base+1] as i32, k, n);
    let b:i32=peval_vs(VS, poff, VS[base+2] as i32, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn vs3_apply_one(VS:[]u8, poff:i32, noff:i32, inp:[]u8, out:[]u8)i32 {
  let nn:i32=get32(VS, noff);
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=peval_vs(VS, poff, nn-1, k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}
fn vs3_apply(VS:[]u8, inp:[]u8, out:[]u8)i32 {
  let vc:i32=get32(VS, 0);
  let i:i32=vc;
  while(i>0){
    let so:i32=56+(i-1)*60;
    let cp:i32=get32(VS, so);
    let cv:i32=get32(VS, so+4);
    if(inp.len>cp && (inp[cp] as i32)==cv){
      return vs3_apply_one(VS, so+12, so+8, inp, out);
    }
    i=i-1;
  }
  return vs3_apply_one(VS, 8, 4, inp, out);
}
fn vs3_dump(VS:[]u8)void {
  emit("VSTORE vcount="); emit(i32s(get32(VS,0))); emit("\n");
  let nn0:i32=get32(VS,4);
  emit("VSTORE P0 nnodes="); emit(i32s(nn0)); emit(" prog=");
  let p0:[]u8=z_alloc(48);
  let i:i32=0;
  while(i<nn0*3){ p0[i]=VS[8+i]; i=i+1; }
  prog_emit(p0, nn0); emit("\n");
  let vc:i32=get32(VS,0);
  let s:i32=1;
  while(s<=vc){
    let so:i32=56+(s-1)*60;
    emit("VSTORE slot"); emit(i32s(s));
    emit(" cond pos="); emit(i32s(get32(VS,so)));
    emit(" val="); emit(i32s(get32(VS,so+4)));
    let nn:i32=get32(VS,so+8);
    emit(" nnodes="); emit(i32s(nn)); emit(" prog=");
    let pp:[]u8=z_alloc(48);
    i=0;
    while(i<nn*3){ pp[i]=VS[so+12+i]; i=i+1; }
    prog_emit(pp, nn); emit("\n");
    s=s+1;
  }
  return;
}

// ============ TWO-PHASE DIAGNOSIS (H-REVISE5 R1+R2) ============
// Phase 1: propose. For each position p in fail: bounds-respecting
// discrimination test (passing inputs shorter than p are vacuous,
// skipped). Score each discriminating (p,v) with a SINGLE honest
// binary signal:
//   +1 output-relevance: v appears in fail_out (expected output).
// The H-REVISE4 "+1 program-consistency (p in seq)" term is DELETED:
// the H-REVISE4 red team proved it is the same signal whenever seq
// comes from pextract(fail, fail_out), because p appears in seq iff
// fail[p] appears in fail_out. The old score was one binary signal
// counted twice. Scores here are 0 or 1.
// Returns best_p*1000+best_v, or -2 AMBIGUOUS if multiple candidates
// tie at the top score, or -1 if none discriminates.
// No byte-value literals; all compared values come from the data.
fn diagnose_propose(D:[]u8, pdesc:[]u8, npass:i32, fail:[]u8, fail_out:[]u8)i32 {
  let best:i32=-1;
  let best_score:i32=-1;
  let best_count:i32=0;
  let p:i32=0;
  while(p<fail.len){
    let v:i32=fail[p] as i32;
    let discrim:i32=1;
    let i:i32=0;
    while(i<npass){
      let plen:i32=get32(pdesc, i*8+4);
      if(plen>p){
        let off:i32=get32(pdesc, i*8);
        if((D[off+p] as i32)==v){ discrim=0; break; }
      }
      i=i+1;
    }
    if(discrim==1){
      let score:i32=0;
      let k:i32=0;
      while(k<fail_out.len){
        if((fail_out[k] as i32)==v){ score=score+1; break; }
        k=k+1;
      }
      emit("DIAGNOSE candidate pos="); emit(i32s(p));
      emit(" val="); emit(i32s(v));
      emit(" score="); emit(i32s(score)); emit("\n");
      if(score>best_score){
        best_score=score;
        best=p*1000+v;
        best_count=1;
      } else {
        if(score==best_score){
          best_count=best_count+1;
        }
      }
    }
    p=p+1;
  }
  if(best_count>1){
    emit("AMBIGUOUS: "); emit(i32s(best_count)); emit(" candidates tie at score ");
    emit(i32s(best_score)); emit("; revision withheld (heuristic cannot distinguish)\n");
    return -2;
  }
  return best;
}
// Phase 2: corroborate. Given proposed (p,v) and a SECOND
// counterexample (fail2, fail_out2), returns 1 iff ALL hold:
//   (a) fail2[p]==v (the proposed condition fires on fail2),
//   (b) (p,v) discriminates fail2 from every passing input
//       (bounds-respecting; no passing input has v at p),
//   (c) the current program VS mispredicts fail2
//       (vs3_apply output differs from fail_out2, or apply fails).
// Otherwise returns 0 and the caller must withhold (UNCORROBORATED).
// Rationale: a single counterexample provably underdetermines the
// condition (X-RV4-1 vs Phase C are structurally identical), so a
// revision is appended only on a second confirming failure. This is
// the independent second signal.
fn diagnose_corroborate(VS:[]u8, D:[]u8, pdesc:[]u8, npass:i32, fail2:[]u8, fail_out2:[]u8, p:i32, v:i32)i32 {
  if(fail2.len<=p){
    emit("CORROBORATE FAIL: fail2 shorter than p\n");
    return 0;
  }
  if((fail2[p] as i32)!=v){
    emit("CORROBORATE FAIL: proposed condition does not fire on fail2\n");
    return 0;
  }
  let i:i32=0;
  while(i<npass){
    let plen:i32=get32(pdesc, i*8+4);
    if(plen>p){
      let off:i32=get32(pdesc, i*8);
      if((D[off+p] as i32)==v){
        emit("CORROBORATE FAIL: (p,v) does not discriminate fail2 from passing\n");
        return 0;
      }
    }
    i=i+1;
  }
  let pred2:[]u8=z_alloc(16);
  let ok:i32=vs3_apply(VS, fail2, pred2);
  if(ok==1 && streq(pred2[0..fail2.len], fail_out2)==1){
    emit("CORROBORATE FAIL: current program already predicts fail2 (not a counterexample)\n");
    return 0;
  }
  emit("CORROBORATE PASS: condition fires on fail2, discriminates, current program mispredicts\n");
  return 1;
}
fn dcopy(D:[]u8, doff:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ D[doff+i]=s[i]; i=i+1; }
  return s.len;
}


// ============ MAIN: phases A-L ============
// Named-check harness: each CHECK does ntest_total+1 and npass_total+1
// iff cond holds. Expected total: 62/62.
// ============ MAIN: H-REVISE5 red-team attacks ============
// X-RV5-1: correlated second counterexample.
// X-RV5-2: condition (b) redundancy probes.
fn main()i32 {
  emit("=== H-REVISE5 RED TEAM (ADV) ===\n");
  let npass_total:i32=0;
  let ntest_total:i32=0;

  // Passing set (mirror Phase J D_J/pdJ): abc, def, ghi, jkl
  let in0:[]u8="abc";
  let in1:[]u8="def";
  let in2:[]u8="ghi";
  let in3:[]u8="jkl";
  let D2:[]u8=z_alloc(256);
  let pd2:[]u8=z_alloc(4*8);
  let joff:i32=0;
  set32(pd2, 0, joff); set32(pd2, 4, dcopy(D2, joff, in0)); joff=joff+in0.len;
  set32(pd2, 8, joff); set32(pd2, 12, dcopy(D2, joff, in1)); joff=joff+in1.len;
  set32(pd2, 16, joff); set32(pd2, 20, dcopy(D2, joff, in2)); joff=joff+in2.len;
  set32(pd2, 24, joff); set32(pd2, 28, dcopy(D2, joff, in3)); joff=joff+in3.len;

  // VSL with P0 = broadcast-last (mirror Phase L p0L)
  let VSL:[]u8=z_alloc(512);
  let p0L:[]u8=z_alloc(48);
  p0L[0]=1; p0L[1]=255; p0L[2]=255;
  p0L[3]=3; p0L[4]=255; p0L[5]=255;
  p0L[6]=6; p0L[7]=0; p0L[8]=1;
  vs3_init(VSL, p0L, 3);

  // ---- X-RV5-1: correlated second counterexample ----
  emit("\n--- X-RV5-1: correlated second counterexample ---\n");
  emit("Hidden truth H: IF input[2]=='y' THEN broadcast-first ELSE broadcast-last\n");
  let inL:[]u8="zqy"; let outL:[]u8="zzz";
  let inL2:[]u8="zab"; let outL2:[]u8="zzz";

  // CHECK A0: control - P0 alone correct on all held-outs
  let pre:[]u8=z_alloc(16);
  let c_zbq:i32=0; let c_zaq:i32=0; let c_zqw:i32=0;
  if(vs3_apply(VSL, "zbq", pre)==1 && streq(pre[0..3], "qqq")==1){ c_zbq=1; }
  if(vs3_apply(VSL, "zaq", pre)==1 && streq(pre[0..3], "qqq")==1){ c_zaq=1; }
  if(vs3_apply(VSL, "zqw", pre)==1 && streq(pre[0..3], "www")==1){ c_zqw=1; }
  ntest_total=ntest_total+1;
  if(c_zbq==1 && c_zaq==1 && c_zqw==1){
    emit("CHECK A0 control P0 correct on zbq/zaq/zqw PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK A0 control FAIL (test broken)\n"); }

  // CHECK A1: propose must be the unique wrong top (0,122)
  let drL:i32=diagnose_propose(D2, pd2, 4, inL, outL);
  ntest_total=ntest_total+1;
  let a1:i32=0;
  if(drL==122){
    emit("CHECK A1 propose==122 i.e. (0,122) PASS\n"); npass_total=npass_total+1; a1=1;
  } else {
    emit("CHECK A1 propose==122 FAIL got "); emit(i32s(drL)); emit(" (fixture VOID)\n");
  }

  // CHECK A2: corroborate with the correlated fail2
  let cor:i32=diagnose_corroborate(VSL, D2, pd2, 4, inL2, outL2, 0, 122);
  ntest_total=ntest_total+1;
  let a2:i32=0;
  if(cor==1){
    emit("CHECK A2 corroborate==1 (gate passes correlated evidence) PASS\n");
    npass_total=npass_total+1; a2=1;
  } else { emit("CHECK A2 corroborate==1 FAIL (gate held; attack fails)\n"); }

  // Caller mimic (Phase C pattern): discover P1 from fail1 alone, then revise
  let S2:[]u8=z_alloc(4096);
  let S2_off:i32=0;
  let descL:[]u8=z_alloc(12);
  let sx:i32=pextract(inL, outL, S2[S2_off..S2_off+64]);
  ntest_total=ntest_total+1;
  if(sx<0){ emit("CHECK extract sx>=0 FAIL (FATAL)\n"); return 1; }
  emit("CHECK extract sx>=0 PASS\n"); npass_total=npass_total+1;
  set32(descL, 0, S2_off); set32(descL, 4, sx); set32(descL, 8, inL.len);
  S2_off=S2_off+64;
  let p1:[]u8=z_alloc(48);
  let nn1:i32=discover(S2, descL, 1, p1);
  ntest_total=ntest_total+1;
  if(nn1<0){ emit("CHECK discover nn1>=0 FAIL (FATAL)\n"); return 1; }
  emit("CHECK discover nn1>=0 PASS\n"); npass_total=npass_total+1;
  emit("P1 discovered nnodes="); emit(i32s(nn1)); emit(" prog=");
  prog_emit(p1, nn1); emit("\n");
  let rc:i32=vs3_revise(VSL, 0, 122, p1, nn1);
  ntest_total=ntest_total+1;
  let a3:i32=0;
  if(rc==1 && get32(VSL,0)==1){
    emit("CHECK A3 wrong revision (0,122) appended, vcount==1 PASS\n");
    npass_total=npass_total+1; a3=1;
  } else {
    emit("CHECK A3 append FAIL rc="); emit(i32s(rc)); emit("\n");
  }
  vs3_dump(VSL);

  // CHECK A4: harm on held-outs (bytes: 122=z 98=b 113=q 119=w)
  let post:[]u8=z_alloc(16);
  let h1:i32=0; let h2:i32=0; let h3:i32=0;
  if(vs3_apply(VSL, "zbq", post)==1){
    emit("post zbq -> ["); emit(i32s(post[0] as i32)); emit(",");
    emit(i32s(post[1] as i32)); emit(","); emit(i32s(post[2] as i32)); emit("]\n");
    if(streq(post[0..3], "qqq")==0){ h1=1; }
  }
  if(vs3_apply(VSL, "zaq", post)==1){
    emit("post zaq -> ["); emit(i32s(post[0] as i32)); emit(",");
    emit(i32s(post[1] as i32)); emit(","); emit(i32s(post[2] as i32)); emit("]\n");
    if(streq(post[0..3], "qqq")==0){ h2=1; }
  }
  if(vs3_apply(VSL, "zqw", post)==1){
    emit("post zqw -> ["); emit(i32s(post[0] as i32)); emit(",");
    emit(i32s(post[1] as i32)); emit(","); emit(i32s(post[2] as i32)); emit("]\n");
    if(streq(post[0..3], "www")==0){ h3=1; }
  }
  ntest_total=ntest_total+1;
  let a4:i32=0;
  if((h1==1 || h2==1 || h3==1) && c_zbq==1 && c_zaq==1 && c_zqw==1){
    emit("CHECK A4 HARM demonstrated (held-out mispredicted, P0 was correct) PASS\n");
    npass_total=npass_total+1; a4=1;
  } else { emit("CHECK A4 HARM FAIL\n"); }

  ntest_total=ntest_total+1;
  if(a1==1 && a2==1 && a3==1 && a4==1){
    emit("X-RV5-1 SUCCEEDS: correlated corroboration -> confident wrong append\n");
    npass_total=npass_total+1;
  } else { emit("X-RV5-1 FAILS\n"); }

  // ---- X-RV5-2: condition (b) redundancy ----
  emit("\n--- X-RV5-2: condition (b) redundancy ---\n");
  // B1: in-protocol, (b) passes trivially (O1). Runtime confirmation: A2==1.
  ntest_total=ntest_total+1;
  if(a2==1){
    emit("CHECK B1 (b) trivially satisfied in-protocol PASS (O1 structural + A2 runtime)\n");
    npass_total=npass_total+1;
  } else { emit("CHECK B1 FAIL\n"); }
  // B2: off-protocol, (b) is live code: (p,v)=(0,97); fail2=("abc"->"zzz")
  let VS2:[]u8=z_alloc(512);
  vs3_init(VS2, p0L, 3);
  let bf2:[]u8="abc"; let bo2:[]u8="zzz";
  let corB:i32=diagnose_corroborate(VS2, D2, pd2, 4, bf2, bo2, 0, 97);
  ntest_total=ntest_total+1;
  if(corB==0){
    emit("CHECK B2 off-protocol (b) fires -> return 0 PASS\n"); npass_total=npass_total+1;
  } else { emit("CHECK B2 FAIL (expected 0, got 1)\n"); }
  emit("X-RV5-2 structural finding: (b) is live code but dead in-protocol;\n");
  emit("the advertised three-condition gate is a two-condition gate in every\n");
  emit("protocol-conformant execution.\n");

  emit("\n=== ADV RESULT: ");
  emit(i32s(npass_total)); emit("/"); emit(i32s(ntest_total));
  emit(" ===\n");
  return 0;
}

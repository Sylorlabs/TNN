// NT-TEACHASSOC: teaching-stream association signal (D6) for the residual case.
// Single arm R6 (K=6). Learner = the NT-RESIDUAL D5 learner verbatim
// (D1 kept; D4 kept as base comparator; D5 = D4 + revision-target pinning
// via per-slot pendtgt) PLUS the new rule under test:
//
// D6 (association pin, frozen): tick-stamped teach/query events; per-subject
// qstart_obs (last tick the subject was observed as a query start, init
// -1000000); frozen window W=20. At INSTALL of key (s,r) at teach tick t,
// set the assoc pin iff t - qstart_obs[s] <= W. Sticky except cleared by
// in-place revision. The D5 victim scan's skippin=1 pass skips D5-pinned OR
// assoc-pinned slots; the D4 fallback is unchanged.
//
// Workload vs NT-RESIDUAL: exploratory query episode post-phase-1
// (q(160),q(161),q(170),q(171) -- all miss, all observed); decoy chain
// (170,1)->171,(171,1)->172 agree-only on K-passes after the residual pair,
// never probed for usefulness; CAP=22 (25 keys, 1.14x).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner (D1 + D4 base + D5 pin + D6 assoc pin) ----
// Header (20 bytes): 0 nkeys, 4 nevict, 8 insctr, 12 ns, 16 tick.
// Slot fields (44 bytes): 0 subj, 4 rel, 8 obj, 12 dom, 16 valid,
// 20 sup, 24 ref, 28 ins, 32 reinf, 36 reads, 40 assoc.
// Memory layout (ns=22 frozen; subjects 100..171 = 72 subjects):
// 20 + ns*44 slots; ckbase: 72*24=1728 checkpoint bytes;
// evbase = ckbase+1728: 72*4=288 histogram bytes;
// ptbase = evbase+288: ns*4 pendtgt bytes;
// qobase = ptbase+ns*4: 72*4 qstart_obs bytes; total 3380.
fn cl_new(ns:i32)[]u8 {
  let L:[]u8=z_alloc(3380);
  set32(L,12,ns);
  let qb:i32=qobase(L);
  let i:i32=0;
  while(i<72){ set32(L,qb+i*4,0-1000000); i=i+1; }
  return L;
}
fn sf(L:[]u8,s:i32,f:i32)i32 { return get32(L,20+s*44+f*4); }
fn sw(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,20+s*44+f*4,v); return; }
fn ckbase(L:[]u8)i32 { return 20+get32(L,12)*44; }
fn evbase(L:[]u8)i32 { return ckbase(L)+1728; }
fn ptbase(L:[]u8)i32 { return evbase(L)+288; }
fn qobase(L:[]u8)i32 { return ptbase(L)+get32(L,12)*4; }
fn pt_get(L:[]u8,s:i32)i32 { return get32(L,ptbase(L)+s*4); }
fn pt_set(L:[]u8,s:i32,v:i32)void { set32(L,ptbase(L)+s*4,v); return; }
fn qo_get(L:[]u8,subj:i32)i32 { return get32(L,qobase(L)+(subj-100)*4); }
fn qo_set(L:[]u8,subj:i32,v:i32)void { set32(L,qobase(L)+(subj-100)*4,v); return; }
fn ck_get(L:[]u8,subj:i32,f:i32)i32 { return get32(L,ckbase(L)+(subj-100)*24+f*4); }
fn ck_set(L:[]u8,subj:i32,f:i32,v:i32)void { set32(L,ckbase(L)+(subj-100)*24+f*4,v); return; }
fn evh_add(L:[]u8,subj:i32)void {
  let b:i32=evbase(L);
  set32(L,b+(subj-100)*4,get32(L,b+(subj-100)*4)+1);
  return;
}
fn evh_get(L:[]u8,subj:i32)i32 { return get32(L,evbase(L)+(subj-100)*4); }
fn cl_find(L:[]u8,subj:i32,rel:i32)i32 {
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    let m:i32=0;
    if(sf(L,s,4)==1){ if(sf(L,s,0)==subj && sf(L,s,1)==rel){ m=1; } }
    if(m==1){ return s; }
    s=s+1;
  }
  return -1;
}
fn cl_first_empty(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==0){ return s; }
    s=s+1;
  }
  return -1;
}
// Slot s is D5-PINNED while some installed link's live contradiction
// targets s's subj. Non-entry-local: decided from OTHER slots'
// pendtgt state, never from s's own entry.
fn slot_pinned(L:[]u8,ns:i32,s:i32)i32 {
  let k:i32=sf(L,s,0);
  let t:i32=0;
  while(t<ns){
    let m:i32=0;
    if(sf(L,t,4)==1){ if(pt_get(L,t)==k){ m=1; } }
    if(m==1){ return 1; }
    t=t+1;
  }
  return 0;
}
// D5+D6 victim scan: min reads among admitted slots; tie-break max ins.
// skippin=1 admits only slots that are neither D5-pinned nor assoc-pinned;
// skippin=0 admits all (the D4 fallback when everything is pinned).
fn ev_scan(L:[]u8,ns:i32,skippin:i32)i32 {
  let best:i32=-1;
  let br:i32=0;
  let bi:i32=0;
  let s:i32=0;
  while(s<ns){
    let m:i32=0;
    if(sf(L,s,4)==1){ m=1; }
    if(m==1){
      if(skippin==1){
        if(slot_pinned(L,ns,s)==1){ m=0; }
        else { if(sf(L,s,10)==1){ m=0; } }
      }
    }
    if(m==1){
      let r:i32=sf(L,s,9);
      let a:i32=sf(L,s,7);
      if(best<0){ best=s; br=r; bi=a; }
      else {
        if(r<br){ best=s; br=r; bi=a; }
        else { if(r==br){ if(a>bi){ best=s; br=r; bi=a; } } }
      }
    }
    s=s+1;
  }
  return best;
}
// D5+D6 eviction: pin live revision targets and assoc-pinned entries;
// D4 fallback if all pinned.
fn cl_evict_d5(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let best:i32=ev_scan(L,ns,1);
  if(best<0){ best=ev_scan(L,ns,0); }
  return best;
}
// Frozen evidence update step, extended with the pin lifecycle:
// a contradicting teaching records its taught obj as the pending
// revision target; an in-place revision clears the pending target
// AND the assoc pin.
fn cl_update(L:[]u8,s:i32,obj:i32)void {
  let v:i32=sf(L,s,2);
  if(v==obj){ sw(L,s,5,sf(L,s,5)+1); return; }
  let r:i32=sf(L,s,6)+1;
  sw(L,s,6,r);
  pt_set(L,s,obj);
  if(r>sf(L,s,5)){ sw(L,s,2,obj); sw(L,s,5,1); sw(L,s,6,0); pt_set(L,s,0); sw(L,s,10,0); }
  return;
}
// D1+D4+D5+D6 insertion: stamp ins on every installation; evaluate the
// D6 assoc pin from the teach tick and qstart_obs (both branches); a newly
// installed entry starts with no pending revision (pt=0); restore the key's
// checkpointed evidence, frequency, AND reads if valid, then run the update
// step (which may set pt on contradiction); else fresh. Every teaching
// event counts toward reinf.
fn cl_insert(L:[]u8,s:i32,subj:i32,rel:i32,obj:i32,phase:i32,t:i32)void {
  let ni:i32=get32(L,8)+1;
  set32(L,8,ni);
  sw(L,s,7,ni);
  let ap:i32=0;
  if(t-qo_get(L,subj)<=20){ ap=1; }
  if(ck_get(L,subj,0)==1){
    let cr:i32=ck_get(L,subj,4);
    let rd:i32=ck_get(L,subj,5);
    sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,ck_get(L,subj,1));
    sw(L,s,3,phase); sw(L,s,4,1);
    sw(L,s,5,ck_get(L,subj,2)); sw(L,s,6,ck_get(L,subj,3));
    sw(L,s,8,cr); sw(L,s,9,rd);
    pt_set(L,s,0);
    sw(L,s,10,ap);
    cl_update(L,s,obj);
    sw(L,s,8,cr+1);
    return;
  }
  sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,obj); sw(L,s,3,phase);
  sw(L,s,4,1); sw(L,s,5,1); sw(L,s,6,0); sw(L,s,8,1); sw(L,s,9,0);
  pt_set(L,s,0);
  sw(L,s,10,ap);
  return;
}
fn cl_learn(L:[]u8,subj:i32,rel:i32,obj:i32,phase:i32,t:i32)void {
  let s:i32=cl_find(L,subj,rel);
  if(s>=0){ cl_update(L,s,obj); sw(L,s,8,sf(L,s,8)+1); return; }
  if(get32(L,0)<get32(L,12)){
    s=cl_first_empty(L);
    set32(L,0,get32(L,0)+1);
  } else {
    let e:i32=cl_evict_d5(L);
    set32(L,4,get32(L,4)+1);
    let vs:i32=sf(L,e,0);
    evh_add(L,vs);
    // D1: checkpoint the victim's evidence, frequency, and reads
    ck_set(L,vs,0,1);
    ck_set(L,vs,1,sf(L,e,2));
    ck_set(L,vs,2,sf(L,e,5));
    ck_set(L,vs,3,sf(L,e,6));
    ck_set(L,vs,4,sf(L,e,8));
    ck_set(L,vs,5,sf(L,e,9));
    s=e;
  }
  cl_insert(L,s,subj,rel,obj,phase,t);
  return;
}
// Predict: entry present and sup > ref -> stored obj AND reads++
// (the entry contributed an answer to a query); else -1.
fn cl_predict(L:[]u8,subj:i32,rel:i32)i32 {
  let s:i32=cl_find(L,subj,rel);
  if(s<0){ return -1; }
  if(sf(L,s,5)>sf(L,s,6)){ sw(L,s,9,sf(L,s,9)+1); return sf(L,s,2); }
  return -1;
}
// 2-hop query: answer requires composing two learned links.
fn q2(L:[]u8,s:i32)i32 {
  let p1:i32=cl_predict(L,s,1);
  if(p1<0){ return -1; }
  let p2:i32=cl_predict(L,p1,1);
  if(p2<0){ return -1; }
  return p2;
}
// ---- event wrappers: tick-stamp every teach and every query ----
// h_teach: record the teach tick, then learn.
fn h_teach(L:[]u8,subj:i32,rel:i32,obj:i32,phase:i32)void {
  let t:i32=get32(L,16);
  set32(L,16,t+1);
  cl_learn(L,subj,rel,obj,phase,t);
  return;
}
// h_query: observe the query start (stamp qstart_obs), then query.
fn h_query(L:[]u8,subj:i32)i32 {
  qo_set(L,subj,get32(L,16));
  set32(L,16,get32(L,16)+1);
  return q2(L,subj);
}
// ---- oracles: frozen numeric inventory (NT-LOWVALUE-BOUNDARY verbatim) ----
fn linka(s:i32)i32 {
  if(s==100){ return 101; }
  if(s==101){ return 102; }
  if(s==103){ return 101; }
  if(s==104){ return 105; }
  if(s==105){ return 106; }
  if(s==107){ return 105; }
  if(s==108){ return 109; }
  if(s==109){ return 110; }
  if(s==111){ return 112; }
  if(s==112){ return 113; }
  if(s==114){ return 115; }
  if(s==115){ return 116; }
  if(s==117){ return 118; }
  if(s==118){ return 119; }
  return -1;
}
fn ntha(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 101; }
  if(i==2){ return 103; }
  if(i==3){ return 104; }
  if(i==4){ return 105; }
  if(i==5){ return 107; }
  if(i==6){ return 108; }
  if(i==7){ return 109; }
  if(i==8){ return 111; }
  if(i==9){ return 112; }
  if(i==10){ return 114; }
  if(i==11){ return 115; }
  if(i==12){ return 117; }
  return 118;
}
fn nthq(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 103; }
  if(i==2){ return 104; }
  if(i==3){ return 107; }
  if(i==4){ return 108; }
  if(i==5){ return 111; }
  if(i==6){ return 114; }
  return 117;
}
fn bsub(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 101; }
  if(i==2){ return 104; }
  if(i==3){ return 105; }
  if(i==4){ return 130; }
  if(i==5){ return 131; }
  if(i==6){ return 140; }
  if(i==7){ return 141; }
  if(i==8){ return 143; }
  if(i==9){ return 144; }
  return 148;
}
fn bobj(i:i32)i32 {
  if(i==0){ return 148; }
  if(i==1){ return 102; }
  if(i==2){ return 130; }
  if(i==3){ return 106; }
  if(i==4){ return 131; }
  if(i==5){ return 132; }
  if(i==6){ return 141; }
  if(i==7){ return 142; }
  if(i==8){ return 144; }
  if(i==9){ return 145; }
  return 152;
}
fn ansa(s:i32)i32 {
  if(s==100){ return 102; }
  if(s==103){ return 102; }
  if(s==104){ return 106; }
  if(s==107){ return 106; }
  if(s==108){ return 110; }
  if(s==111){ return 113; }
  if(s==114){ return 116; }
  return 119;
}
fn ansb(s:i32)i32 {
  if(s==100){ return 152; }
  if(s==104){ return 131; }
  return ansa(s);
}
fn isC(s:i32)i32 {
  if(s==100){ return 1; }
  if(s==104){ return 1; }
  return 0;
}
fn isNC(s:i32)i32 {
  if(s==103){ return 1; }
  if(s==107){ return 1; }
  return 0;
}
// ---- protocol ----
// teachB (LAST order): C, NC, FREQ novels every pass; on K-passes:
// RESIDUAL (160,1)->161 and (161,1)->162 agree-only, then DECOY
// (170,1)->171 and (171,1)->172 agree-only, then RARE (148,1)->152
// very last.
fn teachB(L:[]u8,K:i32,pass:i32)void {
  let q:i32=(pass-1)/K;
  let r:i32=(pass-1)-q*K;
  let teach_rare:i32=0;
  if(r==0){ teach_rare=1; }
  let i:i32=0;
  while(i<10){ h_teach(L,bsub(i),1,bobj(i),2); i=i+1; }
  if(teach_rare==1){ h_teach(L,160,1,161,2); }
  if(teach_rare==1){ h_teach(L,161,1,162,2); }
  if(teach_rare==1){ h_teach(L,170,1,171,2); }
  if(teach_rare==1){ h_teach(L,171,1,172,2); }
  if(teach_rare==1){ h_teach(L,bsub(10),1,bobj(10),2); }
  return;
}
fn teachA(L:[]u8)void {
  let i:i32=0;
  while(i<14){
    let s:i32=ntha(i);
    h_teach(L,s,1,linka(s),1);
    i=i+1;
  }
  return;
}
fn probeA(L:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    if(h_query(L,s)==ansa(s)){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn bprobe(L:[]u8)i32 {
  let n:i32=0;
  if(h_query(L,130)==132){ n=n+1; }
  if(h_query(L,140)==142){ n=n+1; }
  if(h_query(L,143)==145){ n=n+1; }
  return n;
}
fn retest(L:[]u8,out:[]u8)void {
  let c:i32=0;
  let nc:i32=0;
  let u:i32=0;
  let fg:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    let p:i32=h_query(L,s);
    let a:i32=ansa(s);
    if(isC(s)==1){
      if(p==ansb(s)){ c=c+1; }
      else { if(p!=a){ fg=fg+1; } }
    } else {
      if(p==a){
        if(isNC(s)==1){ nc=nc+1; } else { u=u+1; }
      } else { fg=fg+1; }
    }
    i=i+1;
  }
  set32(out,12,c); set32(out,16,nc); set32(out,20,u); set32(out,24,fg);
  return;
}
fn phev(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=119){ n=n+evh_get(L,k); k=k+1; }
  return n;
}
fn trainA(L:[]u8)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teachA(L);
    p=p+1;
    if(probeA(L)==8){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// assoc stats: apin = valid slots with assoc pin; useless = those
// with reads==0 (never contributed to a successful query).
fn assoc_stats(L:[]u8,out:[]u8)void {
  let ns:i32=get32(L,12);
  let ap:i32=0;
  let us:i32=0;
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==1){
      if(sf(L,s,10)==1){
        ap=ap+1;
        if(sf(L,s,9)==0){ us=us+1; }
      }
    }
    s=s+1;
  }
  set32(out,112,ap);
  set32(out,124,us);
  return;
}
// run the single arm R6; out: 0 ttcA, 4 probeA, 8 nevict,
// 12 c, 16 nc, 20 u, 24 forget, 28 phev, 32 bprobe,
// 36 avail100, 40..60 per-pass q(100)==152 flags p1..p6,
// 64 evh(148), 68 evh(118), 72 avail160,
// 76..96 per-pass q(160)==162 flags r1..r6,
// 100 evh(160), 104 evh(161), 108 resprobe,
// 112 apin, 116 dec_present, 120 res_present, 124 nassoc_useless,
// 128 evh(170), 132 evh(171), 136 evh(140), 140 evh(141),
// 144 evh(143), 148 evh(144)
fn run_arm(K:i32,ob:[]u8,c:i32,tag:[]u8,out:[]u8)i32 {
  let L:[]u8=cl_new(22);
  let ttcA:i32=trainA(L);
  let pa:i32=probeA(L);
  // exploratory episode: the teaching-stream dependence --
  // questions about new subjects, all miss, all observed.
  h_query(L,160);
  h_query(L,161);
  h_query(L,170);
  h_query(L,171);
  let p:i32=1;
  while(p<=6){
    teachB(L,K,p);
    let ok:i32=0;
    if(h_query(L,100)==152){ ok=1; }
    set32(out,40+(p-1)*4,ok);
    let ok2:i32=0;
    if(h_query(L,160)==162){ ok2=1; }
    set32(out,76+(p-1)*4,ok2);
    p=p+1;
  }
  retest(L,out);
  let av100:i32=get32(out,40+8)+get32(out,40+12)+get32(out,40+16)+get32(out,40+20);
  let av160:i32=get32(out,76+8)+get32(out,76+12)+get32(out,76+16)+get32(out,76+20);
  let rs:i32=0;
  if(h_query(L,160)==162){ rs=1; }
  let dec:i32=0;
  if(cl_find(L,170,1)>=0){ if(cl_find(L,171,1)>=0){ dec=1; } }
  let rsp:i32=0;
  if(cl_find(L,160,1)>=0){ if(cl_find(L,161,1)>=0){ rsp=1; } }
  assoc_stats(L,out);
  set32(out,0,ttcA); set32(out,4,pa); set32(out,8,get32(L,4));
  set32(out,28,phev(L)); set32(out,32,bprobe(L));
  set32(out,36,av100); set32(out,72,av160); set32(out,108,rs);
  set32(out,64,evh_get(L,148)); set32(out,68,evh_get(L,118));
  set32(out,100,evh_get(L,160)); set32(out,104,evh_get(L,161));
  set32(out,116,dec); set32(out,120,rsp);
  set32(out,128,evh_get(L,170)); set32(out,132,evh_get(L,171));
  set32(out,136,evh_get(L,140)); set32(out,140,evh_get(L,141));
  set32(out,144,evh_get(L,143)); set32(out,148,evh_get(L,144));
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag);
  c=o_app(ob,c," ttcA="); c=o_i64(ob,c,ttcA as i64);
  c=o_app(ob,c," probeA="); c=o_i64(ob,c,pa as i64);
  c=o_app(ob,c," nevict="); c=o_i64(ob,c,get32(L,4) as i64);
  c=o_app(ob,c," phev="); c=o_i64(ob,c,get32(out,28) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag);
  c=o_app(ob,c," PPROBE100");
  let i:i32=0;
  while(i<6){
    c=o_app(ob,c," p"); c=o_i64(ob,c,(i+1) as i64);
    c=o_app(ob,c,"="); c=o_i64(ob,c,get32(out,40+i*4) as i64);
    i=i+1;
  }
  c=o_app(ob,c," avail100="); c=o_i64(ob,c,av100 as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag);
  c=o_app(ob,c," PPROBE160");
  let j:i32=0;
  while(j<6){
    c=o_app(ob,c," r"); c=o_i64(ob,c,(j+1) as i64);
    c=o_app(ob,c,"="); c=o_i64(ob,c,get32(out,76+j*4) as i64);
    j=j+1;
  }
  c=o_app(ob,c," avail160="); c=o_i64(ob,c,av160 as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag);
  c=o_app(ob,c," RET c="); c=o_i64(ob,c,get32(out,12) as i64);
  c=o_app(ob,c," nc="); c=o_i64(ob,c,get32(out,16) as i64);
  c=o_app(ob,c," u="); c=o_i64(ob,c,get32(out,20) as i64);
  c=o_app(ob,c," forget="); c=o_i64(ob,c,get32(out,24) as i64);
  c=o_app(ob,c," bprobe="); c=o_i64(ob,c,get32(out,32) as i64);
  c=o_app(ob,c," resprobe="); c=o_i64(ob,c,get32(out,108) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag);
  c=o_app(ob,c," ASSOC apin="); c=o_i64(ob,c,get32(out,112) as i64);
  c=o_app(ob,c," dec="); c=o_i64(ob,c,get32(out,116) as i64);
  c=o_app(ob,c," res="); c=o_i64(ob,c,get32(out,120) as i64);
  c=o_app(ob,c," useless="); c=o_i64(ob,c,get32(out,124) as i64);
  c=o_app(ob,c," fprate="); c=o_i64(ob,c,(get32(out,124)*100)/get32(out,112) as i64);
  c=o_app(ob,c," evh160="); c=o_i64(ob,c,get32(out,100) as i64);
  c=o_app(ob,c," evh161="); c=o_i64(ob,c,get32(out,104) as i64);
  c=o_app(ob,c," evh170="); c=o_i64(ob,c,get32(out,128) as i64);
  c=o_app(ob,c," evh171="); c=o_i64(ob,c,get32(out,132) as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH "); c=o_app(ob,c,tag); c=o_app(ob,c," EVHIST");
  let k:i32=100;
  while(k<=171){
    let h:i32=evh_get(L,k);
    if(h>0){
      c=o_app(ob,c," "); c=o_i64(ob,c,k as i64);
      c=o_app(ob,c,"="); c=o_i64(ob,c,h as i64);
    }
    k=k+1;
  }
  c=o_nl(ob,c);
  return c;
}
fn main()i32 {
  let ob:[]u8=z_alloc(8192);
  let c:i32=0;
  let m:[]u8=z_alloc(192);
  c=run_arm(6,ob,c,"R6",m);
  // ---- kill bars (PREREG Section 7) ----
  let k1:i32=0;
  let t:i32=get32(m,0);
  if(t>=1){ if(t<=50){ if(get32(m,4)==8){ k1=1; } } }
  let k2:i32=0;
  if(get32(m,16)==2){ if(get32(m,20)==4){ k2=1; } }
  let k3:i32=0;
  if(get32(m,72)==4){
    if(get32(m,108)==1){
      if(get32(m,100)==0){
        if(get32(m,104)==0){ k3=1; }
      }
    }
  }
  let k4:i32=0;
  if(get32(m,12)==2){ if(get32(m,24)==0){ k4=1; } }
  let k5:i32=0;
  if(get32(m,8)==22){
    if(get32(m,64)==0){
      if(get32(m,28)==0){
        if(get32(m,136)==5){
          if(get32(m,140)==6){
            if(get32(m,144)==6){
              if(get32(m,148)==5){ k5=1; }
            }
          }
        }
      }
    }
  }
  let k6:i32=0;
  if(get32(m,36)==4){ if(get32(m,8)>0){ k6=1; } }
  let k7:i32=0;
  if(get32(m,116)==1){ if(get32(m,124)==2){ k7=1; } }
  c=o_app(ob,c,"NTTEACH K1="); c=o_i64(ob,c,k1 as i64);
  c=o_app(ob,c," K2="); c=o_i64(ob,c,k2 as i64);
  c=o_app(ob,c," K3="); c=o_i64(ob,c,k3 as i64);
  c=o_app(ob,c," K4="); c=o_i64(ob,c,k4 as i64);
  c=o_app(ob,c," K5="); c=o_i64(ob,c,k5 as i64);
  c=o_app(ob,c," K6="); c=o_i64(ob,c,k6 as i64);
  c=o_app(ob,c," K7="); c=o_i64(ob,c,k7 as i64);
  c=o_nl(ob,c);
  // verdict code: 0 VOID, 1 INCONCLUSIVE, 2 INFORMATIVE-FAIL,
  // 3 FAIL-PRESSURE, 4 NO-RESCUE, 5 FIX-WITH-COST,
  // 6 FP-UNCONFIRMED, 7 ASSOC-CONFIRMED.
  // Assigned in reverse priority order so the highest-priority
  // matching condition wins (flat, 1-deep ifs).
  let v:i32=7;
  if(k7==0){ v=6; }
  if(k2==0){ v=5; }
  if(k3==0){ v=4; }
  if(k5==0){ v=3; }
  if(k4==0){ v=2; }
  if(k6==0){ v=1; }
  if(k1==0){ v=0; }
  c=o_app(ob,c,"NTTEACH VERDICT=");
  if(v==0){ c=o_app(ob,c,"VOID"); }
  if(v==1){ c=o_app(ob,c,"INCONCLUSIVE"); }
  if(v==2){ c=o_app(ob,c,"INFORMATIVE-FAIL"); }
  if(v==3){ c=o_app(ob,c,"FAIL-PRESSURE"); }
  if(v==4){ c=o_app(ob,c,"NO-RESCUE"); }
  if(v==5){ c=o_app(ob,c,"FIX-WITH-COST"); }
  if(v==6){ c=o_app(ob,c,"FP-UNCONFIRMED"); }
  if(v==7){ c=o_app(ob,c,"ASSOC-CONFIRMED"); }
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTTEACH-END");
  c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}

// p6_ident2.zag -- WORLD-SIDE IDENTIFIABILITY PROBE 2. NOT part of any learner TU.
// For each candidate modulus m dividing the true M, test whether the TRUE val
// map reduced mod m (with c reduced mod m) is consistent with the corpus:
//   (a) every VALID example satisfies sum == c (mod m)
//   (b) every INVALID example whose ONLY true-checker error is eGLOB does NOT
//       satisfy sum == c (mod m)
// (b) is the separation test that AMENDMENT 1's identifiability argument needs.
// This probe decides whether "the exact modulus" is recoverable at all.
fn id_dir()[]u8 {
  if(_zag_file_exists("/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/seed_A.txt")==1){
    return "/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
  }
  return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
}
fn id_path(PB:[]u8,set:i32,st:i32)i32 {
  let c:i32=io_app(PB,0,id_dir());
  c=io_app(PB,c,"corpus_");
  if(set==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,"_s");
  PB[c]=48+st; c=c+1;
  c=io_app(PB,c,".txt");
  return c;
}
fn id_load(CB:[]u8,ps:[]u8)i32 {
  let f:[]u8=_zag_read_file(ps);
  let cn:i32=0;
  let p:i32=0;
  while(p<f.len){
    if(f[p]==10){ p=p+1; continue; }
    let lab:i32=f[p]-48; p=p+1;
    let s0:i32=p;
    while(p<f.len && f[p]!=10){ p=p+1; }
    let n:i32=p-s0;
    if(n<1 || n>32){ if(p<f.len){ p=p+1; } continue; }
    let q:i32=0;
    while(q<n){ pl_put(CB,cn*cs_stride()+8+q*4,f[s0+q]-65); q=q+1; }
    pl_put(CB,cn*cs_stride(),n);
    pl_put(CB,cn*cs_stride()+4,lab);
    cn=cn+1;
  }
  return cn;
}
fn id_sum(L:[]u8,CB:[]u8,i:i32,m:i32)i32 {
  let s:i32=0;
  let j:i32=0;
  while(j<pl_get(CB,i*cs_stride())){
    let t:i32=pl_get(CB,i*cs_stride()+8+j*4);
    if(L_isatom(L,t)==1){ s=s+(L_val(L,t)%m); }
    j=j+1;
  }
  return s-(s/m)*m;
}
fn main()i32 {
  let ob:[]u8=io_alloc(90000);
  let L:[]u8=io_alloc(lg_size());
  let P:[]u8=io_alloc(ck_size());
  let CB:[]u8=io_alloc(260*cs_stride()+64);
  let TK:[]u8=io_alloc(64*4);
  let PB:[]u8=io_alloc(256);
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let seed:i32=1009;
    if(w==1){ seed=2027; }
    let st:i32=0;
    while(st<7){
      lang_build(L,seed,st);
      let pl:i32=id_path(PB,w,st);
      let ps:[]u8=PB[0..pl];
      let cn:i32=id_load(CB,ps);
      let tm:i32=L_M(L);
      let tc:i32=L_C(L);
      c=io_app(ob,c,"SET "); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," st="); c=io_i64(ob,c,st as i64);
      c=io_app(ob,c," M="); c=io_i64(ob,c,tm as i64);
      c=io_app(ob,c," C="); c=io_i64(ob,c,tc as i64);
      c=io_nl(ob,c);
      // classify INVALID examples by their true error code
      let nglo:i32=0; let nother:i32=0;
      let i:i32=0;
      while(i<cn){
        if(pl_get(CB,i*cs_stride()+4)==0){
          let n:i32=pl_get(CB,i*cs_stride());
          let j:i32=0;
          while(j<n){ pl_put(TK,j*4,pl_get(CB,i*cs_stride()+8+j*4)); j=j+1; }
          let e:i32=ck_check(L,P,TK,n);
          if(e==eGLOB()){ nglo=nglo+1; } else { nother=nother+1; }
        }
        i=i+1;
      }
      c=io_app(ob,c,"  INVALID global-only="); c=io_i64(ob,c,nglo as i64);
      c=io_app(ob,c," other="); c=io_i64(ob,c,nother as i64);
      c=io_nl(ob,c);
      let mi:i32=0;
      while(mi<7){
        let m:i32=1;
        m=m<<mi;
        if(m<=tm){
          let cc:i32=tc-(tc/m)*m;
          let badv:i32=0; let satg:i32=0;
          let i2:i32=0;
          while(i2<cn){
            let s:i32=id_sum(L,CB,i2,m);
            let lab:i32=pl_get(CB,i2*cs_stride()+4);
            let n:i32=pl_get(CB,i2*cs_stride());
            let j:i32=0;
            while(j<n){ pl_put(TK,j*4,pl_get(CB,i2*cs_stride()+8+j*4)); j=j+1; }
            let e:i32=ck_check(L,P,TK,n);
            if(lab==1 && s!=cc){ badv=badv+1; }
            if(lab==0 && e==eGLOB() && s==cc){ satg=satg+1; }
            i2=i2+1;
          }
          c=io_app(ob,c,"   m="); c=io_i64(ob,c,m as i64);
          c=io_app(ob,c," c="); c=io_i64(ob,c,cc as i64);
          c=io_app(ob,c," VALIDviol="); c=io_i64(ob,c,badv as i64);
          c=io_app(ob,c," GLOBALinvalid_sat="); c=io_i64(ob,c,satg as i64);
          if(badv==0 && satg==0){ c=io_app(ob,c,"   <== SEPARATES"); }
          c=io_nl(ob,c);
        }
        mi=mi+1;
      }
      st=st+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

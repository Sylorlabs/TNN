// p6_gsolve.zag -- R5 SOLVER DRIVER. Reports, per corpus, what the (M,c,val)
// solver recovers from the corpus alone: the modulus, the residue, the induced
// value map, and the SIZE OF THE ACCEPTED HYPOTHESIS SET (GLOBAL-AMBIGUITY),
// which is the honest form of the criterion when the modulus is not uniquely
// identifiable.
//
// Links only p6_corpus.zag + p6_learner.zag. No world symbol appears here, so
// this driver cannot consult the true instance or the true checker.
// Build: cat p6_io.zag p6_corpus.zag p6_learner.zag p6_gsolve.zag
fn gs_path(PB:[]u8,set:i32,st:i32)i32 {
  let c:i32=io_app(PB,0,gs_dir());
  c=io_app(PB,c,"corpus_");
  if(set==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,"_s");
  PB[c]=48+st; c=c+1;
  c=io_app(PB,c,".txt");
  return c;
}
fn gs_dir()[]u8 {
  if(_zag_file_exists("/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/seed_A.txt")==1){
    return "/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
  }
  return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
}
fn main()i32 {
  let ob:[]u8=io_alloc(90000);
  let L:[]u8=io_alloc(a_size());
  let CB:[]u8=io_alloc(300*cs_stride()+64);
  let PB:[]u8=io_alloc(256);
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let st:i32=0;
    while(st<7){
      let t:i32=0;
      while(t<MAXTOK()){
        pl_put(L,t_nv()+t*TOKSTR(),0);
        pl_put(L,t_ni()+t*TOKSTR(),0);
        pl_put(L,t_val()+t*TOKSTR(),-1);
        t=t+1;
      }
      let pl:i32=gs_path(PB,w,st);
      let f:[]u8=_zag_read_file(PB[0..pl]);
      let cn:i32=cs_loadbuf(CB,f);
      r0_stats(L,CB,cn,1);
      r0_stats(L,CB,cn,0);
      r1_induce(L,CB,cn);
      rc_build(L,CB,cn);
      r_roles(L);
      let na:i32=r5_build_atoms(L);
      r5_induce(L);
      let mm:i32=g_M(L);
      if(mm<1){ mm=1; }
      c=io_app(ob,c,"SET "); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," st="); c=io_i64(ob,c,st as i64);
      c=io_app(ob,c," nAtoms="); c=io_i64(ob,c,na as i64);
      c=io_app(ob,c," M="); c=io_i64(ob,c,g_M(L) as i64);
      c=io_app(ob,c," c="); c=io_i64(ob,c,g_c(L) as i64);
      c=io_app(ob,c," AMBIG="); c=io_i64(ob,c,g_amb(L) as i64);
      let mm2:i32=g_M(L);
      if(mm2<1){ mm2=1; }
      c=io_app(ob,c," viol="); c=io_i64(ob,c,r5_viol(L,mm2,g_c(L)) as i64);
      c=io_app(ob,c," val=[");
      let k:i32=0;
      while(k<na){
        let tt:i32=r5_at(L,k);
        c=io_i64(ob,c,tt as i64);
        c=io_app(ob,c,"->");
        c=io_i64(ob,c,pl_get(L,t_val()+tt*TOKSTR()) as i64);
        if(k<na-1){ c=io_app(ob,c,","); }
        k=k+1;
      }
      c=io_app(ob,c,"]");
      c=io_nl(ob,c);
      st=st+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

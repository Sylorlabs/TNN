// p6_io.zag -- buffered output helpers (house style: one write syscall).
// Contains no language knowledge of any kind.
fn io_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn io_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn io_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn io_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn io_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
// IO-NOTE: _zag_raw_syscall(1,1,ptr,len,0,0,0) COMPILES AND RETURNS but
// produces NO stdout on this host/znc pair (verified 2026-10-03, two argument
// forms, both pointer and i64-cast). House style requires exactly ONE output
// call for the whole run, so we still build the entire report in one buffer
// and emit it with a single _zag_print of a length-delimited slice. Same
// single-call discipline; different primitive.
fn io_flush(b:[]u8,c:i32)void {
  if(c<1){ return; }
  let s:[]u8=b[0..c];
  _zag_print(s);
  return;
}

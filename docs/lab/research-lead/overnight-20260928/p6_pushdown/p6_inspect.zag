// p6_inspect.zag -- WORLD-SIDE DIAGNOSTIC ONLY. NOT part of any learner TU.
// Prints the derived instance so the researcher can see what is hidden.
// Build: cat p6_io.zag p6_lang.zag p6_inspect.zag > _p6_inspect.zag
fn main()i32 {
  let ob:[]u8=io_alloc(200000);
  let L:[]u8=io_alloc(lg_size());
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let seed:i32=1009;
    if(w==1){ seed=2027; }
    let s:i32=0;
    while(s<1){
      lang_build(L,seed,s);
      c=io_app(ob,c,"== SET "); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," stage "); c=io_i64(ob,c,s as i64);
      c=io_app(ob,c," M="); c=io_i64(ob,c,L_M(L) as i64);
      c=io_app(ob,c," C="); c=io_i64(ob,c,L_C(L) as i64);
      c=io_app(ob,c," cmpop="); c=io_i64(ob,c,L_cmp(L) as i64);
      c=io_nl(ob,c);
      let i:i32=0;
      while(i<lg_nt()){
        let r:i32=L_role(L,i);
        let rs:[]u8="?";
        if(r==rY()){ rs="NUM"; }
        if(r==rS()){ rs="STR"; }
        if(r==rV()){ rs="VOP"; }
        if(r==rB()){ rs="BOP"; }
        if(r==rV2()){ rs="VAR"; }
        if(r==rN()){ rs="NAM"; }
        if(r==rK()){ rs="KW "; }
        c=io_app(ob,c," t"); if(i<10){ c=io_app(ob,c,"0"); } else { c=io_app(ob,c," "); }
        c=io_i64(ob,c,i as i64);
        c=io_app(ob,c,"="); c=io_app(ob,c,rs);
        if(r==rB()){
          c=io_app(ob,c," sig="); c=io_i64(ob,c,L_lt(L,i) as i64);
          c=io_app(ob,c,","); c=io_i64(ob,c,L_rt(L,i) as i64);
          c=io_app(ob,c,","); c=io_i64(ob,c,L_res(L,i) as i64);
          c=io_app(ob,c," tier="); c=io_i64(ob,c,L_tier(L,i) as i64);
        }
        if(r==rV()){
          c=io_app(ob,c," sig="); c=io_i64(ob,c,L_tin(L,i) as i64);
          c=io_app(ob,c,","); c=io_i64(ob,c,L_tres(L,i) as i64);
        }
        if(L_isatom(L,i)==1){ c=io_app(ob,c," val="); c=io_i64(ob,c,L_val(L,i) as i64); }
        if(r==rK()){
          c=io_app(ob,c," sub="); c=io_i64(ob,c,L_ksub(L,i) as i64);
          let kn:[]u8="";
          let k:i32=L_ksub(L,i);
          if(k==kPROC()){ kn="PROC"; } if(k==kLET()){ kn="LET"; }
          if(k==kTHEN()){ kn="THEN"; } if(k==kELSE()){ kn="ELSE"; }
          if(k==kEND()){ kn="END"; } if(k==kIF()){ kn="IF"; }
          if(k==kASG()){ kn="ASG"; } if(k==kLP()){ kn="LP"; }
          if(k==kRP()){ kn="RP"; } if(k==kCOM()){ kn="COM"; }
          if(k==kCOL()){ kn="COL"; } if(k==kSEMI()){ kn="SEMI"; }
          if(k==kTYN()){ kn="TY.N"; } if(k==kTYS()){ kn="TY.S"; }
          c=io_app(ob,c,"="); c=io_app(ob,c,kn);
        }
        c=io_nl(ob,c);
        i=i+1;
      }
      s=s+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

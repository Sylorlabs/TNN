// p6_ident.zag -- WORLD-SIDE IDENTIFIABILITY PROBE. NOT part of any learner TU.
// Question: for each candidate M, is the TRUE val map (reduced mod M) with
// c reduced mod M consistent with all 220 corpus labels?
// Also: how many VALID examples have exactly 1,2,3,4,5 atoms (identifiability
// anchor per AMENDMENT 1 A2)?
// Also: does the true (M,c,val) get FALSIFIED by any INVALID example under a
// smaller candidate modulus?
// Build: cat p6_io.zag p6_lang.zag p6_ckcore.zag p6_corpus.zag p6_ident.zag > _p6_ident.zag
fn id_dir()[]u8 {
  if(_zag_file_exists("/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/seed_A.txt")==1){
    return "/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
  }
  return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
}
fn id_path(PB:[]u8,set:i32,st:i32)i32 {
  let c:i32=io_app(PB,0,id_dir());
  c=io_app(PB,c,"corpus_");
  if(set==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,"_s");
  PB[c]=48+st; c=c+1;
  c=io_app(PB,c,".txt");
  return c;
}
// sum of val over atoms of example i, mod M
fn id_sum(L:[]u8,CB:[]u8,i:i32,m:i32)i32 {
  let s:i32=0;
  let j:i32=0;
  while(j<pl_get(CB,i*cs_stride())){
    let t:i32=pl_get(CB,i*cs_stride()+8+j*4);
    if(L_isatom(L,t)==1){ s=s+(L_val(L,t)%m); }
    j=j+1;
  }
  return s-(s/m)*m;
}
fn id_natom(L:[]u8,CB:[]u8,i:i32)i32 {
  let s:i32=0;
  let j:i32=0;
  while(j<pl_get(CB,i*cs_stride())){
    let t:i32=pl_get(CB,i*cs_stride()+8+j*4);
    if(L_isatom(L,t)==1){ s=s+1; }
    j=j+1;
  }
  return s;
}
fn main()i32 {
  let ob:[]u8=io_alloc(60000);
  let L:[]u8=io_alloc(lg_size());
  let CB:[]u8=io_alloc(260*cs_stride()+64);
  let PB:[]u8=io_alloc(256);
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let seed:i32=1009;
    if(w==1){ seed=2027; }
    let st:i32=0;
    while(st<7){
      lang_build(L,seed,st);
      let pl:i32=id_path(PB,w,st);
      let ps:[]u8=PB[0..pl];
      let f:[]u8=_zag_read_file(ps);
      // rebuild CB with cs_loadcorpus semantics by hand (dir-relative)
      let cn:i32=0;
      let p:i32=0;
      while(p<f.len){
        if(f[p]==10){ p=p+1; continue; }
        let lab:i32=f[p]-48; p=p+1;
        let s0:i32=p;
        while(p<f.len && f[p]!=10){ p=p+1; }
        let n:i32=p-s0;
        if(n<1 || n>32){ if(p<f.len){ p=p+1; } continue; }
        let q:i32=0;
        while(q<n){ pl_put(CB,cn*cs_stride()+8+q*4,f[s0+q]-65); q=q+1; }
        pl_put(CB,cn*cs_stride(),n);
        pl_put(CB,cn*cs_stride()+4,lab);
        cn=cn+1;
      }
      let tm:i32=L_M(L);
      let tc:i32=L_C(L);
      c=io_app(ob,c,"SET "); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," st="); c=io_i64(ob,c,st as i64);
      c=io_app(ob,c," M="); c=io_i64(ob,c,tm as i64);
      c=io_app(ob,c," C="); c=io_i64(ob,c,tc as i64);
      c=io_app(ob,c," cn="); c=io_i64(ob,c,cn as i64);
      // natom histogram of VALID
      c=io_app(ob,c," VALIDnatoms:");
      let k:i32=1;
      while(k<=8){
        let h:i32=0;
        let i:i32=0;
        while(i<cn){ if(pl_get(CB,i*cs_stride()+4)==1){ if(id_natom(L,CB,i)==k){ h=h+1; } } i=i+1; }
        if(h>0){ c=io_i64(ob,c,k as i64); c=io_app(ob,c,":"); c=io_i64(ob,c,h as i64); c=io_sp(ob,c); }
        k=k+1;
      }
      c=io_nl(ob,c);
      // for candidate moduli, test the TRUE map reduced
      let mi:i32=0;
      while(mi<3){
        let m:i32=16;
        if(mi==1){ m=32; }
        if(mi==2){ m=64; }
        if(m<=tm){
          let cc:i32=tc-(tc/m)*m;
          let badv:i32=0; let badi:i32=0;
          let i:i32=0;
          while(i<cn){
            let s:i32=id_sum(L,CB,i,m);
            let lab:i32=pl_get(CB,i*cs_stride()+4);
            let ckonly:i32=1;
            if(st<2){ ckonly=1; }
            if(ckonly==1){
              if(lab==1 && s!=cc){ badv=badv+1; }
              if(lab==0 && s==cc){ badi=badi+1; }
            }
            i=i+1;
          }
          c=io_app(ob,c,"   cand M="); c=io_i64(ob,c,m as i64);
          c=io_app(ob,c," c="); c=io_i64(ob,c,cc as i64);
          c=io_app(ob,c," VALIDviol="); c=io_i64(ob,c,badv as i64);
          c=io_app(ob,c," INVALIDsat="); c=io_i64(ob,c,badi as i64);
          c=io_nl(ob,c);
        }
        mi=mi+1;
      }
      st=st+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

// p6_lang.zag -- FL7 INSTANCE DERIVER.
// A seed (one i32) determines the entire formal system: which opaque byte
// token plays which role, the binary operator type signatures, the unary
// operator signatures, the precedence tiering, the global modulus M, the
// required residue c, and the numeric value of every atom token.
//
// NO grammar table exists anywhere in source. This file is a FUNCTION of the
// seed.
//
// THIS FILE IS NEVER PART OF THE LEARNER TRANSLATION UNIT.
// Guard G1 (no seed, no table, no reference) is audited in NAMECHECK.md.

fn lg_m32(a:i32, b:i32)i32 { return a-(a/b)*b; }

fn lg_get(b:[]u8, o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn lg_put(b:[]u8, o:i32, v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}

// ---- instance layout (i32 cells) ----
fn lg_seed()i32  { return 0; }
fn lg_stage()i32 { return 4; }
fn lg_m()i32     { return 8; }
fn lg_c()i32     { return 12; }
fn lg_role()i32  { return 16; }   // + ti*4, 31
fn lg_tier()i32  { return 140; }  // + ti*4
fn lg_lt()i32    { return 264; }
fn lg_rt()i32    { return 388; }
fn lg_res()i32   { return 512; }
fn lg_tin()i32   { return 636; }
fn lg_tres()i32  { return 760; }
fn lg_val()i32   { return 884; }
fn lg_ksub()i32  { return 1008; } // + ti*4
fn lg_cmpbop()i32{ return 1132; }
fn lg_rng()i32   { return 1136; }
fn lg_tmp()i32   { return 1400; }
fn lg_size()i32  { return 2700; }

// ---- role codes ----
fn rY()i32  { return 0; }  // numeric atom
fn rS()i32  { return 1; }  // string atom
fn rV()i32  { return 2; }  // unary operator
fn rB()i32  { return 3; }  // binary operator
fn rV2()i32 { return 4; }  // variable
fn rN()i32  { return 5; }  // name
fn rK()i32  { return 6; }  // keyword / punctuation

// ---- keyword subroles (indices 0..13) ----
fn kPROC()i32 { return 0; }
fn kLET()i32  { return 1; }
fn kTHEN()i32 { return 2; }
fn kELSE()i32 { return 3; }
fn kEND()i32  { return 4; }
fn kIF()i32   { return 5; }
fn kASG()i32  { return 6; }
fn kLP()i32   { return 7; }
fn kRP()i32   { return 8; }
fn kCOM()i32  { return 9; }
fn kCOL()i32  { return 10; }
fn kSEMI()i32 { return 11; }
fn kTYN()i32  { return 12; }
fn kTYS()i32  { return 13; }

// ---- type codes ----
fn tY()i32 { return 0; }
fn tS()i32 { return 1; }
fn tB()i32 { return 2; }
fn tE()i32 { return 3; }

fn lg_nt()i32 { return 31; }

// ---- rng: LCG s <- (s*40014 + 12345) mod 32749. s is kept < 32749 so the
// product s*40014 stays below 2^31 (no i32 overflow).
// REJECTED VARIANT, recorded because it failed silently: an earlier
// s <- s*s mod 46337 generator lands in the quadratic-residue subgroup with a
// very short orbit, so the entire corpus collapsed onto a handful of distinct
// programs and the first symptom was "the learner induces almost nothing".
fn lg_rnd(L:[]u8)i32 {
  let s:i32=lg_get(L,lg_rng());
  s=lg_m32(s*40014+12345,32749);
  if(s==0){ s=1; }
  lg_put(L,lg_rng(),s);
  return s;
}
fn lg_rn(L:[]u8, n:i32)i32 { return lg_m32(lg_rnd(L),n); }

// shuffle the 31 cells at `base` in place
fn lg_shuf(L:[]u8, base:i32, n:i32)void {
  let i:i32=n-1;
  while(i>0){
    let j:i32=lg_rn(L,i+1);
    let t:i32=lg_get(L,base+i*4);
    lg_put(L,base+i*4,lg_get(L,base+j*4));
    lg_put(L,base+j*4,t);
    i=i-1;
  }
  return;
}

// role multiset: NUM 4, STR 2, VOP 2, BOP 5, VAR 3, NAME 1, KW 14 = 31
fn lg_fill_roles(L:[]u8)void {
  let i:i32=0;
  while(i<4){ lg_put(L,lg_role()+i*4,rY()); i=i+1; }
  i=4; while(i<6){ lg_put(L,lg_role()+i*4,rS()); i=i+1; }
  i=6; while(i<8){ lg_put(L,lg_role()+i*4,rV()); i=i+1; }
  i=8; while(i<13){ lg_put(L,lg_role()+i*4,rB()); i=i+1; }
  i=13; while(i<16){ lg_put(L,lg_role()+i*4,rV2()); i=i+1; }
  lg_put(L,lg_role()+16*4,rN());
  i=17; while(i<31){ lg_put(L,lg_role()+i*4,rK()); i=i+1; }
  return;
}

fn lg_draw_op(L:[]u8, ti:i32, isB:i32)void {
  let lt:i32=lg_rn(L,3);
  let rt:i32=lg_rn(L,3);
  let rs:i32=lg_rn(L,2);
  if(isB==1){
    lg_put(L,lg_lt()+ti*4,lt);
    lg_put(L,lg_rt()+ti*4,rt);
    lg_put(L,lg_res()+ti*4,rs);
    lg_put(L,lg_tier()+ti*4,lg_rn(L,2));
    return;
  }
  lg_put(L,lg_tin()+ti*4,lt);
  lg_put(L,lg_tres()+ti*4,rs);
  return;
}

fn lg_val_of(ti:i32, a:i32, b:i32, m:i32)i32 {
  return lg_m32(a*ti+b,m);
}

fn lang_build(L:[]u8, seed:i32, stage:i32)void {
  let i:i32=0;
  lg_put(L,lg_seed(),seed);
  lg_put(L,lg_stage(),stage);
  lg_put(L,lg_rng(),lg_m32(lg_m32(seed,9973),46337));
  if(lg_get(L,lg_rng())==0){ lg_put(L,lg_rng(),7); }

  lg_fill_roles(L);
  lg_shuf(L,lg_role(),31);

  // number the 14 keyword tokens with subroles 0..13 in token order
  i=0;
  while(i<31){ lg_put(L,lg_ksub()+i*4,0); lg_put(L,lg_val()+i*4,0); i=i+1; }
  let n:i32=0;
  i=0;
  while(i<31){
    if(lg_get(L,lg_role()+i*4)==rK()){
      lg_put(L,lg_ksub()+i*4,n);
      n=n+1;
    }
    i=i+1;
  }

  let mi:i32=lg_rn(L,3);
  let m:i32=16;
  if(mi==1){ m=32; }
  if(mi==2){ m=64; }
  lg_put(L,lg_m(),m);
  lg_put(L,lg_c(),1+lg_rn(L,m-1));

  let cmpb:i32=-1;
  i=0;
  while(i<31){
    let rr:i32=lg_get(L,lg_role()+i*4);
    let isb:i32=0; let isv:i32=0;
    if(rr==rB()){ isb=1; }
    if(rr==rV()){ isv=1; }
    if(isb==1){
      lg_draw_op(L,i,1);
      if(cmpb<0){ cmpb=i; }
    }
    if(isv==1){ lg_draw_op(L,i,0); }
    if(isb==0 && isv==0){
      lg_put(L,lg_lt()+i*4,tE());
      lg_put(L,lg_rt()+i*4,tE());
      lg_put(L,lg_res()+i*4,tE());
      lg_put(L,lg_tin()+i*4,tE());
      lg_put(L,lg_tres()+i*4,tE());
      lg_put(L,lg_tier()+i*4,0);
    }
    i=i+1;
  }
  lg_put(L,lg_lt()+cmpb*4,tY());
  lg_put(L,lg_rt()+cmpb*4,tY());
  lg_put(L,lg_res()+cmpb*4,tB());
  lg_put(L,lg_tier()+cmpb*4,1);
  lg_put(L,lg_cmpbop(),cmpb);

  let tight:i32=0;
  i=0;
  while(i<31){
    if(lg_get(L,lg_role()+i*4)==rB() && i!=cmpb && lg_get(L,lg_tier()+i*4)==0){ tight=1; }
    i=i+1;
  }
  if(tight==0){
    i=0;
    while(i<31){
      if(lg_get(L,lg_role()+i*4)==rB() && i!=cmpb){
        lg_put(L,lg_tier()+i*4,0);
        tight=1;
        break;
      }
      i=i+1;
    }
  }

  // atom values: a seed-derived injection of the six atom tokens into [0,M).
  // Built as a shuffled permutation so injectivity is guaranteed by
  // construction (an affine map a*ti+b collides whenever two atom indices are
  // congruent mod M, which happens for M=16 and is not repairable).
  let ai:i32=0;
  while(ai<m){ lg_put(L,lg_val()+lg_tmp()+ai*4,ai); ai=ai+1; }
  lg_shuf(L,lg_val()+lg_tmp(),m);
  ai=0;
  i=0;
  while(i<31){
    if(lg_get(L,lg_role()+i*4)<=rS()){
      lg_put(L,lg_val()+i*4,lg_get(L,lg_val()+lg_tmp()+ai*4));
      ai=ai+1;
    }
    i=i+1;
  }
  return;
}

// ---- accessors ----
fn L_role(L:[]u8,ti:i32)i32 { return lg_get(L,lg_role()+ti*4); }
fn L_tier(L:[]u8,ti:i32)i32 { return lg_get(L,lg_tier()+ti*4); }
fn L_lt(L:[]u8,ti:i32)i32   { return lg_get(L,lg_lt()+ti*4); }
fn L_rt(L:[]u8,ti:i32)i32   { return lg_get(L,lg_rt()+ti*4); }
fn L_res(L:[]u8,ti:i32)i32  { return lg_get(L,lg_res()+ti*4); }
fn L_tin(L:[]u8,ti:i32)i32  { return lg_get(L,lg_tin()+ti*4); }
fn L_tres(L:[]u8,ti:i32)i32 { return lg_get(L,lg_tres()+ti*4); }
fn L_val(L:[]u8,ti:i32)i32  { return lg_get(L,lg_val()+ti*4); }
fn L_ksub(L:[]u8,ti:i32)i32 { return lg_get(L,lg_ksub()+ti*4); }
fn L_M(L:[]u8)i32    { return lg_get(L,lg_m()); }
fn L_C(L:[]u8)i32    { return lg_get(L,lg_c()); }
fn L_stage(L:[]u8)i32{ return lg_get(L,lg_stage()); }
fn L_cmp(L:[]u8)i32  { return lg_get(L,lg_cmpbop()); }

fn L_iskw(L:[]u8,ti:i32,k:i32)i32 {
  if(L_role(L,ti)!=rK()){ return 0; }
  if(L_ksub(L,ti)!=k){ return 0; }
  return 1;
}
fn L_isatom(L:[]u8,ti:i32)i32 {
  let r:i32=L_role(L,ti);
  if(r==rY()){ return 1; }
  if(r==rS()){ return 1; }
  return 0;
}

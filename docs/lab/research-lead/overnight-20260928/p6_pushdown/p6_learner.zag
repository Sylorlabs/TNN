// p6_learner.zag -- THE LEARNER.  R1 delimiter discovery, R2 induced
// productions, R3 typing, R4 scope, R5 (M,c,val) solver, R6 generation +
// the single unconditional accept fold.
//
// THIS FILE CONTAINS NO SEED, NO GRAMMAR TABLE, NO TOKEN ID, NO ROLE CODE,
// NO TYPE CODE, NO KEYWORD SUBROLE, AND NO REFERENCE TO ANY WORLD SYMBOL.
// Audited by NAMECHECK.md.
//
// The language is discovered from the corpus file alone: 220 records of
// (opaque token sequence, one bit).
//
// ARENA LAYOUT (i32 little-endian cells; PREREG.md 2.7 is normative):
//   0      header            stride 4
//   256    token alphabet    stride 4    32
//   384    pair table        stride 12   8
//   480    closer-set table  stride 8    64
//   768    state table       stride 24   512
//   12800  transition table  stride 8    4096
//   45696  production table  stride 12   4096
//   96000  type table        stride 4    1024
//   110336 prune table       stride 8    2048
//   126720 scope table       stride 12   32
//   131072 global table      stride 4    512
//   140000 skeleton buffer   stride 4    160
//   141000 artefact buffer   stride 4    160
//   142000 residue table     stride 4    1024
//   144000 reduced corpus    stride 96   1400
//   158000 stack buffer      stride 4    512

fn pl_get(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn pl_put(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}

// ---- arena sections ----
fn a_tok()i32   { return 256; }
fn a_pair()i32  { return 384; }
fn a_close()i32 { return 480; }
fn a_state()i32 { return 768; }
fn a_trans()i32 { return 12800; }
fn a_prod()i32  { return 45696; }
fn a_type()i32  { return 96000; }
fn a_prune()i32 { return 110336; }
fn a_scope()i32 { return 126720; }
fn a_glob()i32  { return 131072; }
fn a_skel()i32  { return 140000; }
fn a_art()i32   { return 141000; }
fn a_resid()i32 { return 142000; }
fn a_rc()i32    { return 144000; }
fn a_stack()i32 { return 158000; }
fn a_size()i32  { return 300000; }

fn S_STR()i32 { return 24; }
fn T_STR()i32 { return 8; }
fn R_STR()i32 { return 12; }
fn C_STR()i32 { return 96; }

// ---- header cells ----
fn h_npair()i32    { return 0; }
fn h_nstate()i32   { return 4; }
fn h_ntrans()i32   { return 8; }
fn h_nprod()i32    { return 12; }
fn h_nprune()i32   { return 16; }
fn h_maxdepth()i32 { return 20; }
fn h_r1sup()i32    { return 24; }
fn h_r3ntype()i32  { return 28; }
fn h_r4ok()i32     { return 32; }
fn h_unexp()i32    { return 36; }
fn h_nctx()i32     { return 40; }
fn h_nred()i32     { return 44; }
fn h_nvalid()i32   { return 48; }
fn h_ninval()i32   { return 52; }
fn h_natom()i32    { return 56; }
fn h_nvar()i32     { return 60; }
fn h_nsep()i32     { return 64; }
fn h_r1pairs()i32  { return 68; }
fn h_nneg()i32     { return 72; }
fn h_fitOK()i32    { return 76; }
fn h_fitN()i32     { return 80; }
fn h_foldok()i32   { return 84; }
fn h_skelmax()i32  { return 88; }

// ---- token alphabet: stride 32 bytes (8 i32 cells) per token, 32 tokens ----
fn t_nv()i32   { return a_tok()+0; }
fn t_ni()i32   { return a_tok()+4; }
fn t_role()i32 { return a_tok()+8; }
fn t_type()i32 { return a_tok()+12; }
fn t_val()i32  { return a_tok()+16; }
fn t_first()i32{ return a_tok()+20; }
fn t_last()i32 { return a_tok()+24; }
fn t_nB()i32   { return a_tok()+28; }
fn TOKSTR()i32 { return 32; }
// induced role codes
fn rE()i32      { return 0; }
fn rOPEN()i32   { return 1; }
fn rCLOSE()i32  { return 2; }
fn rATOM()i32   { return 3; }
fn rVAR()i32    { return 4; }
fn rSEP()i32    { return 5; }
fn rUNOP()i32   { return 6; }
fn rBINOP()i32  { return 7; }
fn rNEUTRAL()i32{ return 8; }
fn rOUT()i32    { return 9; }

fn NP()i32 { return 8; }
fn NC()i32 { return 64; }
fn NS()i32 { return 512; }
fn NTR()i32 { return 4096; }
fn NPROD()i32 { return 4096; }
fn NPX()i32 { return 2048; }
fn NRED()i32 { return 1400; }
fn NTY()i32 { return 32; }
fn MAXTOK()i32 { return 31; }
fn MAXLEN()i32 { return 32; }
fn NRES()i32 { return 256; }

// ---- pair table (stride 12) ----
fn p_open(L:[]u8,k:i32)i32  { return pl_get(L,a_pair()+k*R_STR()+0); }
fn p_close(L:[]u8,k:i32)i32 { return pl_get(L,a_pair()+k*R_STR()+4); }
fn p_sup(L:[]u8,k:i32)i32   { return pl_get(L,a_pair()+k*R_STR()+8); }

// ---- closer-set table (stride 8) ----
fn cl_n(L:[]u8)i32 { return pl_get(L,a_close()+0); }
fn cl_o(L:[]u8,i:i32)i32 { return pl_get(L,a_close()+i*T_STR()+0); }
fn cl_c(L:[]u8,i:i32)i32 { return pl_get(L,a_close()+i*T_STR()+4); }
fn cl_add(L:[]u8,o:i32,c:i32)i32 {
  let i:i32=0;
  while(i<cl_n(L)){
    if(cl_o(L,i)==o && cl_c(L,i)==c){ return cl_n(L); }
    i=i+1;
  }
  let n:i32=cl_n(L);
  if(n>=NC){ return n; }
  pl_put(L,a_close()+n*T_STR()+0,o);
  pl_put(L,a_close()+n*T_STR()+4,c);
  pl_put(L,a_close()+0,n+1);
  return n+1;
}
fn cl_isopen(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<cl_n(L)){
    if(cl_o(L,i)==t){ return 1; }
    i=i+1;
  }
  return 0;
}
fn cl_isclose(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<cl_n(L)){
    if(cl_c(L,i)==t){ return 1; }
    i=i+1;
  }
  return 0;
}
// unconditional add of a designation to the closer-set table
fn pl_add(L:[]u8,o:i32,c:i32)i32 { return cl_add(L,o,c); }
fn cl_match(L:[]u8,o:i32,c:i32)i32 {
  let i:i32=0;
  while(i<cl_n(L)){
    if(cl_o(L,i)==o && cl_c(L,i)==c){ return 1; }
    i=i+1;
  }
  return 0;
}

// ---- state table (stride 24) ----
fn s_acc(L:[]u8,q:i32)i32  { return pl_get(L,a_state()+q*S_STR()+0); }
fn s_offs(L:[]u8,q:i32)i32 { return pl_get(L,a_state()+q*S_STR()+4); }
fn s_cnt(L:[]u8,q:i32)i32  { return pl_get(L,a_state()+q*S_STR()+8); }
fn s_start(L:[]u8,q:i32)i32{ return pl_get(L,a_state()+q*S_STR()+12); }
fn s_made(L:[]u8,q:i32)i32 { return pl_get(L,a_state()+q*S_STR()+16); }

// ---- transition table (stride 8) ----
fn tr_sym(L:[]u8,e:i32)i32 { return pl_get(L,a_trans()+e*T_STR()+0); }
fn tr_dst(L:[]u8,e:i32)i32 { return pl_get(L,a_trans()+e*T_STR()+4); }
fn s_mk(L:[]u8,q:i32,st:i32)i32 {
  pl_put(L,a_state()+q*S_STR()+0,0);
  pl_put(L,a_state()+q*S_STR()+4,pl_get(L,h_ntrans()));
  pl_put(L,a_state()+q*S_STR()+8,0);
  pl_put(L,a_state()+q*S_STR()+12,st);
  pl_put(L,a_state()+q*S_STR()+16,0);
  pl_put(L,h_ntrans(),pl_get(L,h_ntrans())+1);
  return q;
}
fn tr_find(L:[]u8,q:i32,sym:i32)i32 {
  let i:i32=0;
  let o:i32=s_offs(L,q);
  while(i<s_cnt(L,q)){
    if(tr_sym(L,o+i)==sym){ return o+i; }
    i=i+1;
  }
  return -1;
}
fn tr_add(L:[]u8,q:i32,sym:i32,dst:i32)i32 {
  let e:i32=tr_find(L,q,sym);
  if(e>=0){ return e; }
  let n:i32=pl_get(L,h_ntrans());
  if(n>=NTR){ return -1; }
  pl_put(L,a_trans()+n*T_STR()+0,sym);
  pl_put(L,a_trans()+n*T_STR()+4,dst);
  pl_put(L,a_state()+q*S_STR()+8,s_cnt(L,q)+1);
  pl_put(L,h_ntrans(),n+1);
  return n;
}
fn s_mkacc(L:[]u8,q:i32)void { pl_put(L,a_state()+q*S_STR()+0,1); return; }

// ---- production table (stride 12) ----
fn p_lhs(L:[]u8,i:i32)i32 { return pl_get(L,a_prod()+i*R_STR()+0); }
fn p_sym(L:[]u8,i:i32)i32 { return pl_get(L,a_prod()+i*R_STR()+4); }
fn p_dst(L:[]u8,i:i32)i32 { return pl_get(L,a_prod()+i*R_STR()+8); }
fn prod_add(L:[]u8,q:i32,sym:i32,dst:i32)i32 {
  let n:i32=pl_get(L,h_nprod());
  if(n>=NPROD){ return -1; }
  pl_put(L,a_prod()+n*R_STR()+0,q);
  pl_put(L,a_prod()+n*R_STR()+4,sym);
  pl_put(L,a_prod()+n*R_STR()+8,dst);
  pl_put(L,h_nprod(),n+1);
  return n;
}

// ---- reduced corpus (stride 96, up to 24 tokens) ----
fn RCSTR()i32 { return 88; }
fn rc_lab(L:[]u8,i:i32)i32    { return pl_get(L,a_rc()+i*RCSTR()+0); }
fn rc_n(L:[]u8,i:i32)i32      { return pl_get(L,a_rc()+i*RCSTR()+4); }
fn rc_tok(L:[]u8,i:i32,j:i32)i32 { return pl_get(L,a_rc()+i*RCSTR()+8+j*4); }
fn rc_put(L:[]u8,i:i32,lab:i32,n:i32)void {
  pl_put(L,a_rc()+i*RCSTR()+0,lab);
  pl_put(L,a_rc()+i*RCSTR()+4,n);
  return;
}
fn rc_putt(L:[]u8,i:i32,j:i32,v:i32)void {
  pl_put(L,a_rc()+i*RCSTR()+8+j*4,v);
  return;
}

// ---- prune table (stride 8) ----
fn px_add(L:[]u8,op:i32,coded:i32)void {
  let i:i32=0;
  while(i<pl_get(L,h_nprune())){
    if(pl_get(L,a_prune()+i*T_STR()+0)==op && pl_get(L,a_prune()+i*T_STR()+4)==coded){ return; }
    i=i+1;
  }
  let n:i32=pl_get(L,h_nprune());
  if(n>=NPX){ return; }
  pl_put(L,a_prune()+n*T_STR()+0,op);
  pl_put(L,a_prune()+n*T_STR()+4,coded);
  pl_put(L,h_nprune(),n+1);
  return;
}
fn px_has(L:[]u8,op:i32,coded:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nprune())){
    if(pl_get(L,a_prune()+i*T_STR()+0)==op && pl_get(L,a_prune()+i*T_STR()+4)==coded){ return 1; }
    i=i+1;
  }
  return 0;
}
fn px_code(a:i32,b:i32)i32 { return a*64+b; }

// ---- type table: [op*32+cls] ----
fn ty_set(L:[]u8,op:i32,cls:i32,v:i32)void {
  let i:i32=op*NTY()+cls;
  if(i<0 || i>1023){ return; }
  pl_put(L,a_type()+i*4,v);
  return;
}
fn ty_get(L:[]u8,op:i32,cls:i32)i32 {
  let i:i32=op*NTY()+cls;
  if(i<0 || i>1023){ return 0; }
  return pl_get(L,a_type()+i*4);
}

// ---- scope table (stride 12) ----
fn sc_head(L:[]u8,i:i32)i32 { return pl_get(L,a_scope()+i*R_STR()+0); }
fn sc_var(L:[]u8,i:i32)i32  { return pl_get(L,a_scope()+i*R_STR()+4); }
fn sc_asg(L:[]u8,i:i32)i32  { return pl_get(L,a_scope()+i*R_STR()+8); }
fn scns(L:[]u8)i32 { return pl_get(L,a_scope()+R_STR()*32+0); }

// ---- global table ----
fn g_M(L:[]u8)i32        { return pl_get(L,a_glob()+0); }
fn g_c(L:[]u8)i32        { return pl_get(L,a_glob()+4); }
fn g_val(L:[]u8,t:i32)i32{ return pl_get(L,a_glob()+8+t*4); }
fn g_nglob(L:[]u8)i32    { return pl_get(L,a_glob()+8+32*4); }
fn g_amb(L:[]u8)i32      { return pl_get(L,a_glob()+8+33*4); }
fn g_rlen(L:[]u8,r:i32)i32 { return pl_get(L,a_resid()+r*4); }
fn g_ra(L:[]u8,r:i32)i32   { return pl_get(L,a_resid()+NRES()*4+r*4); }
fn g_rb(L:[]u8,r:i32)i32   { return pl_get(L,a_resid()+NRES()*8+r*4); }
fn g_rc2(L:[]u8,r:i32)i32  { return pl_get(L,a_resid()+NRES()*12+r*4); }

// ---- explicit stack (pushdown) ----
fn st_n(L:[]u8)i32      { return pl_get(L,a_stack()+0); }
fn st_val(L:[]u8,i:i32)i32 { return pl_get(L,a_stack()+4+i*4); }
fn st_push(L:[]u8,v:i32)i32 {
  let n:i32=st_n(L);
  if(n>=500){ return n; }
  pl_put(L,a_stack()+4+n*4,v);
  pl_put(L,a_stack()+0,n+1);
  return n+1;
}
fn st_pop(L:[]u8)i32 {
  let n:i32=st_n(L);
  if(n<1){ return -1; }
  let v:i32=st_val(L,n-1);
  pl_put(L,a_stack()+0,n-1);
  return v;
}
fn st_top(L:[]u8)i32 {
  let n:i32=st_n(L);
  if(n<1){ return -1; }
  return st_val(L,n-1);
}

// ---- token accessors ----
fn tk_nv(L:[]u8,t:i32)i32   { return pl_get(L,t_nv()+t*TOKSTR()); }
fn tk_ni(L:[]u8,t:i32)i32   { return pl_get(L,t_ni()+t*TOKSTR()); }
fn tk_role(L:[]u8,t:i32)i32 { return pl_get(L,t_role()+t*TOKSTR()); }
fn tk_type(L:[]u8,t:i32)i32 { return pl_get(L,t_type()+t*TOKSTR()); }
fn tk_isatom(L:[]u8,t:i32)i32 { if(tk_role(L,t)==rATOM()){ return 1; } return 0; }
fn tk_isvar(L:[]u8,t:i32)i32  { if(tk_role(L,t)==rVAR()){ return 1; } return 0; }

// placeholder symbol for a balanced region: PH base 32
fn PH0()i32 { return 32; }

// ================= R0: corpus statistics =================
// Counts per token over VALID and INVALID. No language knowledge.
fn r0_stats(L:[]u8,CB:[]u8,cn:i32,usevalid:i32)void {
  let i:i32=0;
  while(i<cn){
    let want:i32=1;
    if(usevalid==0){ want=0; }
    if(pl_get(CB,i*cs_stride()+4)==want){
      let n:i32=pl_get(CB,i*cs_stride());
      let j:i32=0;
      while(j<n){
        let t:i32=pl_get(CB,i*cs_stride()+8+j*4);
        if(t>=0 && t<MAXTOK()){
          if(want==1){ pl_put(L,t_nv()+t*TOKSTR(),pl_get(L,t_nv()+t*TOKSTR())+1); } else { pl_put(L,t_ni()+t*TOKSTR(),pl_get(L,t_ni()+t*TOKSTR())+1); }
          if(j==0){ pl_put(L,t_first()+t*TOKSTR(),pl_get(L,t_first()+t*TOKSTR())+1); }
          if(j==n-1){ pl_put(L,t_last()+t*TOKSTR(),pl_get(L,t_last()+t*TOKSTR())+1); }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return;
}
fn r0_seedrng(L:[]u8,CB:[]u8,cn:i32)i32 {
  // RNG init derived from the corpus itself, so the learner holds no external
  // seed of any kind. Deterministic function of the experience set.
  let s:i32=7;
  let i:i32=0;
  while(i<cn){
    s=s*31+pl_get(CB,i*cs_stride()+4);
    let n:i32=pl_get(CB,i*cs_stride());
    s=s*31+n;
    let j:i32=0;
    while(j<n){ s=s*31+pl_get(CB,i*cs_stride()+8+j*4); j=j+1; }
    s=s-(s/1000003)*1000003;
    i=i+1;
  }
  s=s-(s/32749)*32749;
  if(s<1){ s=1; }
  return s;
}
fn rnd(L:[]u8)i32 {
  let s:i32=pl_get(L,a_skel()+152);
  s=s*40014+12345;
  s=s-(s/32749)*32749;
  if(s<1){ s=1; }
  pl_put(L,a_skel()+152,s);
  return s;
}
fn rn(L:[]u8,n:i32)i32 {
  if(n<1){ return 0; }
  return rnd(L)%n;
}

// ================= scratch windows inside the arena =================
// depth stack for bracket scans: count at a_skel+200, cells from a_skel+204, 100 max
// per-token depth of the example scanned: at a_skel+608, 40 max
// current reduced sequence: at a_skel+800, 40 max
// opening token by depth: at a_skel+960, 60 max
fn sc_n(L:[]u8)i32 { return pl_get(L,a_skel()+200); }
fn sc_setn(L:[]u8,n:i32)void { pl_put(L,a_skel()+200,n); return; }
fn sc_get(L:[]u8,i:i32)i32 { return pl_get(L,a_skel()+204+i*4); }
fn sc_push(L:[]u8,v:i32)void {
  let n:i32=sc_n(L);
  if(n>=100){ return; }
  pl_put(L,a_skel()+204+n*4,v);
  sc_setn(L,n+1);
  return;
}
fn dp(L:[]u8,i:i32)i32 { return pl_get(L,a_skel()+608+i*4); }
fn dp_set(L:[]u8,i:i32,v:i32)void { pl_put(L,a_skel()+608+i*4,v); return; }
fn sk(L:[]u8,i:i32)i32 { return pl_get(L,a_skel()+800+i*4); }
fn sk_set(L:[]u8,i:i32,v:i32)void { pl_put(L,a_skel()+800+i*4,v); return; }
fn op_at(L:[]u8,d:i32)i32 { return pl_get(L,a_skel()+960+d*4); }

// ================= R1: INDUCED DELIMITER STRUCTURE =================
// R1a: support of the single-pair hypothesis (o,c) over VALID examples.
fn r1_sup(L:[]u8,CB:[]u8,cn:i32,o:i32,c:i32)i32 {
  pl_put(L,a_close()+0,0);
  cl_add(L,o,c);
  let n:i32=0;
  let i:i32=0;
  while(i<cn){
    if(pl_get(CB,i*cs_stride()+4)==1){
      let n2:i32=pl_get(CB,i*cs_stride());
      let j:i32=0;
      while(j<n2){ pl_put(L,a_skel()+400+j*4,pl_get(CB,i*cs_stride()+8+j*4)); j=j+1; }
      let ok:i32=r1_cons(L,n2);
      if(ok==1){ n=n+1; }
    }
    i=i+1;
  }
  pl_put(L,a_close()+0,0);
  return n;
}
// core bracket scan over the scratch token window at a_skel()+400.
// Consistent iff stack ends empty, every pop matched a designation,
// every push matched by a pop.
fn r1_cons(L:[]u8,n:i32)i32 {
  sc_setn(L,0);
  let ok:i32=1;
  let j:i32=0;
  while(j<n){
    let t:i32=pl_get(L,a_skel()+400+j*4);
    if(cl_isclose(L,t)==1){
      let d:i32=sc_n(L);
      let f:i32=-1;
      let k:i32=d-1;
      while(k>=0){
        if(cl_match(L,sc_get(L,k),t)==1){ f=k; break; }
        k=k-1;
      }
      if(f<0){ ok=0; } else { sc_setn(L,f); }
    }
    if(cl_isopen(L,t)==1){ sc_push(L,t); }
    j=j+1;
  }
  if(sc_n(L)!=0){ ok=0; }
  return ok;
}
// R1b/c: evaluate the current pair set over VALID examples.
fn r1_eval(L:[]u8,CB:[]u8,cn:i32)void {
  let ok:i32=0;
  let md:i32=0;
  let i:i32=0;
  while(i<cn){
    if(pl_get(CB,i*cs_stride()+4)==1){
      let n:i32=pl_get(CB,i*cs_stride());
      let j:i32=0;
      while(j<n){ pl_put(L,a_skel()+400+j*4,pl_get(CB,i*cs_stride()+8+j*4)); j=j+1; }
      if(r1_cons(L,n)==1){ ok=ok+1; }
      if(sc_n(L)>md){ md=sc_n(L); }
    }
    i=i+1;
  }
  pl_put(L,h_r1sup(),ok);
  pl_put(L,h_maxdepth(),md);
  return;
}
// R1c: greedy lexicographic (consistentCount, maxDepth) selection.
fn r1_induce(L:[]u8,CB:[]u8,cn:i32)void {
  pl_put(L,a_close()+0,0);
  pl_put(L,h_r1pairs(),0);
  r1_eval(L,CB,cn);
  let bestc:i32=pl_get(L,h_r1sup());
  let bestd:i32=pl_get(L,h_maxdepth());
  let round:i32=0;
  while(round<NP()){
    let bo:i32=-1;
    let bc:i32=-1;
    let bb:i32=bestc;
    let bd:i32=bestd;
    let o:i32=0;
    while(o<MAXTOK()){
      if(tk_nv(L,o)>0){
        let c:i32=0;
        while(c<MAXTOK()){
          let skip:i32=0;
          if(c==o){ skip=1; }
          let k:i32=0;
          while(k<pl_get(L,h_r1pairs())){
            if(p_open(L,k)==o && p_close(L,k)==c){ skip=1; }
            k=k+1;
          }
          if(skip==0 && tk_nv(L,c)>0){
            let s:i32=r1_sup(L,CB,cn,o,c);
            if(s>=3){
              pl_put(L,a_close()+0,0);
              cl_add(L,o,c);
              r1_eval(L,CB,cn);
              let cc:i32=pl_get(L,h_r1sup());
              let dd:i32=pl_get(L,h_maxdepth());
              if(cc>bb || (cc==bb && dd>bd)){ bb=cc; bd=dd; bo=o; bc=c; }
            }
          }
          c=c+1;
        }
      }
      o=o+1;
    }
    if(bo<0){ break; }
    let r:i32=pl_get(L,h_r1pairs());
    pl_put(L,a_pair()+r*R_STR()+0,bo);
    pl_put(L,a_pair()+r*R_STR()+4,bc);
    pl_put(L,a_pair()+r*R_STR()+8,bb);
    pl_put(L,a_close()+0,0);
    cl_add(L,bo,bc);
    pl_put(L,h_r1pairs(),r+1);
    bestc=bb; bestd=bd;
    round=round+1;
  }
  
  // The greedy loop leaves the closer-set table holding the LAST candidate it
  // scored rather than the accepted set, so with zero accepted pairs the table
  // still classifies some tokens as delimiters. Measured symptom: token 23 came
  // out rCLOSE with R1pairs=0, which removed it from the ATOM set and left the
  // R5 solver with 5 atoms instead of 6. Rebuild from the accepted pairs.
  pl_put(L,a_close()+0,0);
  let q2:i32=0;
  while(q2<pl_get(L,h_r1pairs())){
    cl_add(L,p_open(L,q2),p_close(L,q2));
    q2=q2+1;
  }
  return;
}

// ---- R1d: reduce the token sequence in the scratch window to a skeleton.
// Balanced regions nest. The interior of a region collapses to one symbol
// 32+k where k is the index of the pair whose OPENER encloses it.
// The reduced sequence lands in the scratch window a_skel()+800;
// its length is returned.
fn r1_reduce(L:[]u8,n:i32)i32 {
  // pass 1: depth of each token, and the opener token at each stack level
  sc_setn(L,0);
  let j:i32=0;
  while(j<n){
    let t:i32=pl_get(L,a_skel()+400+j*4);
    pl_put(L,a_skel()+960+sc_n(L)*4,t);
    if(cl_isclose(L,t)==1){
      let d:i32=sc_n(L);
      let f:i32=-1;
      let k:i32=d-1;
      while(k>=0){
        if(cl_match(L,sc_get(L,k),t)==1){ f=k; break; }
        k=k-1;
      }
      if(f>=0){ sc_setn(L,f); }
    }
    if(cl_isopen(L,t)==1){ sc_push(L,t); }
    j=j+1;
  }
  // pass 2: depth per token
  sc_setn(L,0);
  j=0;
  while(j<n){
    let t:i32=pl_get(L,a_skel()+400+j*4);
    if(cl_isclose(L,t)==1){
      let d:i32=sc_n(L);
      let f:i32=-1;
      let k:i32=d-1;
      while(k>=0){
        if(cl_match(L,sc_get(L,k),t)==1){ f=k; break; }
        k=k-1;
      }
      if(f>=0){ sc_setn(L,f); }
    }
    dp_set(L,j,sc_n(L));
    if(cl_isopen(L,t)==1){ sc_push(L,t); }
    j=j+1;
  }
  // pass 3: emit. A token at depth 0 is emitted verbatim. A maximal run of
  // tokens at depth >= 1 collapses to the PH symbol of the enclosing opener.
  let m:i32=0;
  j=0;
  while(j<n){
    let d:i32=dp(L,j);
    if(d==0){
      sk_set(L,m,pl_get(L,a_skel()+400+j*4));
      m=m+1;
      j=j+1;
      continue;
    }
    let o:i32=pl_get(L,a_skel()+960+(d-1)*4);
    let enc:i32=31;
    let q:i32=0;
    while(q<pl_get(L,h_r1pairs())){
      if(p_open(L,q)==o){ enc=32+q; }
      q=q+1;
    }
    sk_set(L,m,enc);
    m=m+1;
    // skip to and including the matching closer
    while(j<n){
      let t2:i32=pl_get(L,a_skel()+400+j*4);
      let d2:i32=dp(L,j);
      if(cl_isclose(L,t2)==1 && d2==d){ break; }
      j=j+1;
    }
    j=j+1;
  }
  pl_put(L,a_skel()+796,m);
  return m;
}
// ---- load example i of CB into the scratch token window, return its length.
fn r1_load(L:[]u8,CB:[]u8,i:i32)i32 {
  let n:i32=pl_get(CB,i*cs_stride());
  let j:i32=0;
  while(j<n){ pl_put(L,a_skel()+400+j*4,pl_get(CB,i*cs_stride()+8+j*4)); j=j+1; }
  return n;
}


// ================= REDUCED-CORPUS STORE =================
// Every VALID/INVALID example is reduced ONCE and kept, so that no role
// predicate ever has to re-run r1_reduce and clobber the scratch window.
fn rc_build(L:[]u8,CB:[]u8,cn:i32)void {
  pl_put(L,h_nred(),0);
  pl_put(L,h_nvalid(),0);
  pl_put(L,h_ninval(),0);
  let i:i32=0;
  while(i<cn){
    let n:i32=r1_load(L,CB,i);
    let m:i32=r1_reduce(L,n);
    let lab:i32=pl_get(CB,i*cs_stride()+4);
    let r:i32=pl_get(L,h_nred());
    if(r<NRED && m<=23){
      rc_put(L,r,lab,m);
      let j:i32=0;
      while(j<m){ rc_putt(L,r,j,sk(L,j)); j=j+1; }
      pl_put(L,h_nred(),r+1);
      if(lab==1){ pl_put(L,h_nvalid(),pl_get(L,h_nvalid())+1); } else { pl_put(L,h_ninval(),pl_get(L,h_ninval())+1); }
      if(m>pl_get(L,h_skelmax())){ pl_put(L,h_skelmax(),m); }
    }
    i=i+1;
  }
  return;
}
// ================= ROLE INDUCTION (structural, VALID-only) =================
// Every predicate is a pure function of (a) the R1 delimiter relation and
// (b) the reduced VALID skeletons. No delimiter, stage, or token id is named.
//
// rSEP   : the last symbol of some reduced VALID skeleton.
// rVAR   : occurs immediately after a symbol that is a delimiter opener.
// rATOM  : occurs as the FIRST symbol of some reduced VALID skeleton, or
//          immediately before a symbol that is an rSEP.
fn role_termend(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      let m:i32=rc_n(L,i);
      if(m>0 && rc_tok(L,i,m-1)==t){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn role_mid(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      let m:i32=rc_n(L,i);
      let j:i32=0;
      while(j<m){
        if(rc_tok(L,i,j)==t && j>0 && j<m-1){ return 1; }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn role_first(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      if(rc_n(L,i)>0 && rc_tok(L,i,0)==t){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn role_afteropen(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      let m:i32=rc_n(L,i);
      let j:i32=1;
      while(j<m){
        if(rc_tok(L,i,j)==t && cl_isopen(L,rc_tok(L,i,j-1))==1){ return 1; }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 0;
}
// operand position: t occurs immediately before an rSEP symbol.
fn role_operandish(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      let m:i32=rc_n(L,i);
      let j:i32=0;
      while(j<m-1){
        if(rc_tok(L,i,j)==t && role_termend(L,rc_tok(L,i,j+1))==1){ return 1; }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn r_roles(L:[]u8)void {
  let t:i32=0;
  while(t<MAXTOK()){
    let r:i32=rE();
    if(tk_nv(L,t)>0){
      if(cl_isopen(L,t)==1){ r=rOPEN(); }
      if(r==rE() && cl_isclose(L,t)==1){ r=rCLOSE(); }
      if(r==rE() && role_termend(L,t)==1){ r=rSEP(); }
      if(r==rE() && role_afteropen(L,t)==1){ r=rVAR(); }
      if(r==rE() && role_first(L,t)==1){ r=rATOM(); }
      if(r==rE() && role_operandish(L,t)==1){ r=rATOM(); }
      if(r==rE() && role_mid(L,t)==1){ r=rBINOP(); }
    }
    pl_put(L,t_role()+t*TOKSTR(),r);
    t=t+1;
  }
  r_unary(L);
  r_outofset(L);
  return;
}


// ---- role refinements that R5 depends on ----
// rUNOP: a token classified rBINOP that is NEVER immediately preceded by an
// operand-position token (ATOM or rUNOP) in any VALID skeleton is a PREFIX
// operator, not an infix one. This is the only thing that separates the two
// operator arities without being told which is which.
fn role_afteroperand(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(rc_lab(L,i)==1){
      let m:i32=rc_n(L,i);
      let j:i32=1;
      while(j<m){
        if(rc_tok(L,i,j)==t){
          let u:i32=tk_role(L,rc_tok(L,i,j-1));
          if(u==rATOM() || u==rUNOP()){ return 1; }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 0;
}
fn r_unary(L:[]u8)void {
  let t:i32=0;
  while(t<MAXTOK()){
    if(tk_role(L,t)==rBINOP() && role_afteroperand(L,t)==0){
      pl_put(L,t_role()+t*TOKSTR(),rUNOP());
    }
    t=t+1;
  }
  return;
}
// rOUT: a token that occurs in INVALID examples but NEVER in a VALID example is
// not in the language at all, whatever its local context looks like. This is the
// one role signal available with no grammar, no delimiter relation and no stage
// knowledge. Load-bearing at set A stage 0, where the tokens carrying LET, IF,
// END, the VARs, LP/RP and four of the five binary operators occur only inside
// errors: without it the role pass labels several of them ATOM and R5 is then
// asked to explain errors that are not its own.
fn r_outofset(L:[]u8)void {
  let t:i32=0;
  while(t<MAXTOK()){
    if(tk_nv(L,t)==0 && tk_ni(L,t)>0){
      pl_put(L,t_role()+t*TOKSTR(),rOUT());
    }
    t=t+1;
  }
  return;
}
// ================= R5: THE (M, c, val) SOLVER =================
// Implements PREREG 2.5 and AMENDMENT 1's identifiability argument.
//
// Search over M in {2,4,8,16,32,64}, c in [1,M-1], and an INJECTIVE map val
// from the induced ATOM tokens into [0,M). A hypothesis is ACCEPTED iff
//   (a) every VALID record of the right shape has   sum val(atom) == c (mod M)
//   (b) no INVALID record of the right shape has    sum val(atom) == c (mod M)
// "of the right shape" is r5_admissible below, and the restriction is measured
// rather than assumed; see its comment.
//
// The solver enumerates the accepted set rather than stopping at the first
// member. Its size is GLOBAL-AMBIGUITY, which is the honest form of the
// criterion when the modulus is not uniquely identifiable -- and prereg's
// disclosed measurement M2 says it is not, for set A.
//
// ARENA, all inside a_r5() = 160000, which is disjoint from every other section:
//   +0    ATOM token list, stride 4, 8 entries
//   +32   ATOM count
//   +64   bucket counts, 8 x stride 4
//   +96   bucket record indices, 8 buckets x 64 entries x stride 4  (=+2112)
//   +4096 hypothesis log, 48 x stride 12                                (=+4672)
//   +8192 failed-node table, 1024 x stride 4                           (=+12288)

fn a_r5()i32    { return 160000; }

// ---- ATOM list ----
fn r5_at(L:[]u8,k:i32)i32 { return pl_get(L,a_r5()+0+k*4); }
fn r5_atput(L:[]u8,k:i32,v:i32)void { pl_put(L,a_r5()+0+k*4,v); return; }
fn r5_nat(L:[]u8)i32 { return pl_get(L,a_r5()+32); }
fn r5_build_atoms(L:[]u8)i32 {
  let n:i32=0;
  let t:i32=0;
  while(t<MAXTOK()){
    if(tk_isatom(L,t)==1 && n<8){ r5_atput(L,n,t); n=n+1; }
    t=t+1;
  }
  pl_put(L,a_r5()+32,n);
  return n;
}
fn r5_index(L:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<r5_nat(L)){
    if(r5_at(L,i)==t){ return i; }
    i=i+1;
  }
  return -1;
}

// ---- bucket index: record -> MAX ATOM index over its atoms ----
// A record in bucket b mentions only ATOM indices <= b, so it becomes fully
// determined once depth b+1 is assigned. This is what bounds the search.
fn r5_bn(L:[]u8,b:i32)i32 { return pl_get(L,a_r5()+64+b*4); }
fn r5_bput(L:[]u8,b:i32,v:i32)void { pl_put(L,a_r5()+64+b*4,v); return; }
fn r5_bi(L:[]u8,b:i32,k:i32)i32 { return pl_get(L,a_r5()+96+b*256+k*4); }
fn r5_biput(L:[]u8,b:i32,k:i32,v:i32)void { pl_put(L,a_r5()+96+b*256+k*4,v); return; }
fn r5_index_records(L:[]u8)void {
  let b:i32=0;
  while(b<8){ r5_bput(L,b,0); b=b+1; }
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    let n:i32=rc_n(L,i);
    let j:i32=0;
    let mx:i32=-1;
    while(j<n){
      let t:i32=rc_tok(L,i,j);
      if(tk_isatom(L,t)==1){
        let idx:i32=r5_index(L,t);
        if(idx>mx){ mx=idx; }
      }
      j=j+1;
    }
    if(mx>=0 && mx<8){
      let k:i32=r5_bn(L,mx);
      if(k<64){ r5_biput(L,mx,k,i); r5_bput(L,mx,k+1); }
    }
    i=i+1;
  }
  return;
}

// ---- sums ----
fn r5_sum(L:[]u8,i:i32,m:i32)i32 {
  let s:i32=0;
  let n:i32=rc_n(L,i);
  let j:i32=0;
  while(j<n){
    let t:i32=rc_tok(L,i,j);
    if(tk_isatom(L,t)==1){ s=s+pl_get(L,t_val()+t*TOKSTR()); }
    j=j+1;
  }
  s=s-(s/m)*m;
  return s;
}

// ---- r5_admissible: the shape the congruence is responsible for ----
//
// MEASURED, not assumed. At set A stage 0, six INVALID records are near-misses
// that DELETED a statement separator, leaving 5 to 8 consecutive atoms. Their
// atom sums are congruent to c under the TRUE map -- e.g. the 9-token record with
// atoms 28,11,11,16,11 sums to 0+57+57+38+57 = 209 = 17 mod 64. Those records are
// invalid because they are not statements, not because of the congruence, and no
// (M,c,val) rejects them without also rejecting a genuine VALID record. Measured
// consequence of NOT filtering: with the true map injected, r5_viol(64,17) = 6;
// with the filter, = 0. The filter is therefore required for the criterion to be
// satisfiable by the truth at all, and is prereg 2.5's "no INVALID example that
// R1-R4 already reject is used as evidence" implemented as a filter on evidence.
//
// Shape: a record is admissible iff it is non-empty, contains NO token whose
// role is rOUT (present only in INVALID records, hence not in the language at
// all), and ENDS on a non-ATOM symbol -- i.e. it ends with a statement separator
// rather than dangling in an operand.
//
// Note what this does NOT require, and why. An earlier version demanded strict
// ATOM / non-ATOM alternation by position parity. That rejected 112 of the 130
// VALID records, because an expression operand may itself be a prefix operator
// applied to an atom, so operand positions are not uniformly ATOM. Over-tight
// filtering is not a safe default here: it silently shrinks the evidence set
// until the congruence is tested against nothing and every violation count
// becomes vacuous. Measured with strict alternation: admissible = 68 of 220
// (18 VALID, 50 INVALID). With the rule above the filter removes only the
// records that carry structure the congruence is not responsible for.
fn r5_admissible(L:[]u8,i:i32)i32 {
  let n:i32=rc_n(L,i);
  if(n<2){ return 0; }
  let j:i32=0;
  while(j<n){
    let r:i32=tk_role(L,rc_tok(L,i,j));
    if(r==rOUT()){ return 0; }
    j=j+1;
  }
  let lr:i32=tk_role(L,rc_tok(L,i,n-1));
  if(lr==rATOM()){ return 0; }
  return 1;
}

// ---- accept test over all admissible records ----
fn r5_viol(L:[]u8,m:i32,c:i32)i32 {
  let v:i32=0;
  let i:i32=0;
  while(i<pl_get(L,h_nred())){
    if(r5_admissible(L,i)==1){
      let s:i32=r5_sum(L,i,m);
      let lab:i32=rc_lab(L,i);
      if(lab==1 && s!=c){ v=v+1; }
      if(lab==0 && s==c){ v=v+1; }
    }
    i=i+1;
  }
  return v;
}
// ---- prefix feasibility: bucket k-1 only ----
fn r5_partial_ok(L:[]u8,m:i32,c:i32,k:i32)i32 {
  if(k<1){ return 1; }
  let b:i32=k-1;
  let i:i32=0;
  while(i<r5_bn(L,b)){
    let r:i32=r5_bi(L,b,i);
    let s:i32=r5_sum(L,r,m);
    let lab:i32=rc_lab(L,r);
    if(lab==1 && s!=c){ return 0; }
    if(lab==0 && s==c){ return 0; }
    i=i+1;
  }
  return 1;
}

// ---- failed-node memo ----
// Key is (m, c, k, assigned prefix) reduced mod 1024. A slot is marked only
// after its subtree is proved to contain no solution, so a hash collision can
// lose a solution but can never manufacture one.
fn r5_key(L:[]u8,m:i32,c:i32,k:i32)i32 {
  let h:i32=7;
  h=h*31+m;
  h=h*31+c;
  h=h*31+k;
  let i:i32=0;
  while(i<k){
    h=h*31+pl_get(L,t_val()+r5_at(L,i)*TOKSTR());
    i=i+1;
  }
  h=h-(h/1000003)*1000003;
  if(h<0){ h=0-h; }
  return h-(h/1024)*1024;
}
fn r5_isseen(L:[]u8,h:i32)i32 { return pl_get(L,a_r5()+8192+h*4); }
fn r5_mark(L:[]u8,h:i32)void { pl_put(L,a_r5()+8192+h*4,1); return; }
fn r5_clearseen(L:[]u8)void {
  let i:i32=0;
  while(i<1024){ pl_put(L,a_r5()+8192+i*4,0); i=i+1; }
  return;
}

// ---- backtracking search for one (M,c,val) ----
fn r5_bt(L:[]u8,na:i32,m:i32,c:i32,k:i32)i32 {
  if(k>=na){ return r5_viol(L,m,c)==0; }
  let h:i32=r5_key(L,m,c,k);
  if(r5_isseen(L,h)==1){ return 0; }
  let t:i32=r5_at(L,k);
  let v:i32=0;
  while(v<m){
    let bad:i32=0;
    let i:i32=0;
    while(i<k){
      if(pl_get(L,t_val()+r5_at(L,i)*TOKSTR())==v){ bad=1; }
      i=i+1;
    }
    if(bad==0){
      pl_put(L,t_val()+t*TOKSTR(),v);
      if(r5_partial_ok(L,m,c,k+1)==1){
        if(r5_bt(L,na,m,c,k+1)==1){ return 1; }
      }
    }
    v=v+1;
  }
  r5_mark(L,h);
  return 0;
}

// ---- driver ----
fn r5_induce(L:[]u8)void {
  let na:i32=r5_nat(L);
  r5_index_records(L);
  let found:i32=0;
  let first:i32=0;
  let mi:i32=0;
  while(mi<6){
    let m:i32=2;
    if(mi==1){ m=4; }
    if(mi==2){ m=8; }
    if(mi==3){ m=16; }
    if(mi==4){ m=32; }
    if(mi==5){ m=64; }
    if(m>=na){
      let c:i32=1;
      while(c<m){
        let k:i32=0;
        while(k<na){ pl_put(L,t_val()+r5_at(L,k)*TOKSTR(),-1); k=k+1; }
        r5_clearseen(L);
        let ok:i32=r5_bt(L,na,m,c,0);
        if(ok==1){
          let h:i32=pl_get(L,g_nglob(L));
          if(h<48){
            pl_put(L,a_r5()+4096+h*12+0,m);
            pl_put(L,a_r5()+4096+h*12+4,c);
            pl_put(L,a_r5()+4096+h*12+8,found);
          }
          pl_put(L,g_nglob(L),h+1);
          if(first==0){
            first=1;
            pl_put(L,g_M(L),m);
            pl_put(L,g_c(L),c);
            let k2:i32=0;
            while(k2<na){
              pl_put(L,a_r5()+3072+r5_at(L,k2)*4,pl_get(L,t_val()+r5_at(L,k2)*TOKSTR()));
              k2=k2+1;
            }
          }
          found=found+1;
        }
        c=c+1;
      }
    }
    mi=mi+1;
  }
  pl_put(L,g_amb(L),found);
  let k3:i32=0;
  while(k3<na){
    pl_put(L,t_val()+r5_at(L,k3)*TOKSTR(),pl_get(L,a_r5()+3072+r5_at(L,k3)*4));
    k3=k3+1;
  }
  return;
}

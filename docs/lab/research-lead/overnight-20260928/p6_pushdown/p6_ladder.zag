// p6_ladder.zag -- FIXTURE AUDIT DRIVER.
// Measures what complexity each of the 14 frozen corpora ACTUALLY contains,
// using ONLY the learner translation unit (p6_corpus.zag + p6_learner.zag).
// No world symbol appears here, so the audit cannot be accused of consulting
// the true checker or the instance deriver.
// Build: cat p6_io.zag p6_corpus.zag p6_learner.zag p6_ladder.zag > _p6_ladder.zag
fn ld_path(PB:[]u8,set:i32,st:i32)i32 {
  let c:i32=io_app(PB,0,ld_dir());
  c=io_app(PB,c,"corpus_");
  if(set==0){ c=io_app(PB,c,"A"); } else { c=io_app(PB,c,"B"); }
  c=io_app(PB,c,"_s");
  PB[c]=48+st; c=c+1;
  c=io_app(PB,c,".txt");
  return c;
}
fn ld_dir()[]u8 {
  if(_zag_file_exists("/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/seed_A.txt")==1){
    return "/Users/Shared/micah/Documents/TNN/.worktrees/p6pushdown/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
  }
  return "/Users/Shared/micah/Documents/TNN/TNN/docs/lab/research-lead/overnight-20260928/p6_pushdown/";
}
fn main()i32 {
  let ob:[]u8=io_alloc(90000);
  let L:[]u8=io_alloc(a_size());
  let CB:[]u8=io_alloc(300*cs_stride()+64);
  let PB:[]u8=io_alloc(256);
  let c:i32=0;
  let w:i32=0;
  while(w<2){
    let st:i32=0;
    while(st<7){
      let t:i32=0;
      while(t<MAXTOK()){ pl_put(L,t_nv()+t*TOKSTR(),0); pl_put(L,t_ni()+t*TOKSTR(),0); t=t+1; }
      let pl:i32=ld_path(PB,w,st);
      let f:[]u8=_zag_read_file(PB[0..pl]);
      let cn:i32=cs_loadbuf(CB,f);
      r0_stats(L,CB,cn,1);
      r0_stats(L,CB,cn,0);
      r1_induce(L,CB,cn);
      rc_build(L,CB,cn);
      r_roles(L);
      let tot:i32=0;
      let maxn:i32=0;
      let valid:i32=0;
      let inval:i32=0;
      let i:i32=0;
      while(i<cn){
        let n:i32=cs_get(CB,i*cs_stride());
        tot=tot+n;
        if(n>maxn){ maxn=n; }
        if(cs_get(CB,i*cs_stride()+4)==1){ valid=valid+1; } else { inval=inval+1; }
        i=i+1;
      }
      let distinct:i32=0;
      let t2:i32=0;
      while(t2<MAXTOK()){
        if(tk_nv(L,t2)>0 || tk_ni(L,t2)>0){ distinct=distinct+1; }
        t2=t2+1;
      }
      c=io_app(ob,c,"SET "); if(w==0){ c=io_app(ob,c,"A"); } else { c=io_app(ob,c,"B"); }
      c=io_app(ob,c," stage "); c=io_i64(ob,c,st as i64);
      c=io_app(ob,c," n="); c=io_i64(ob,c,cn as i64);
      c=io_app(ob,c," V="); c=io_i64(ob,c,valid as i64);
      c=io_app(ob,c," I="); c=io_i64(ob,c,inval as i64);
      c=io_app(ob,c," distinctTok="); c=io_i64(ob,c,distinct as i64);
      c=io_app(ob,c," maxLen="); c=io_i64(ob,c,maxn as i64);
      c=io_app(ob,c," meanTok="); if(cn>0){ c=io_i64(ob,c,(tot/cn) as i64); } else { c=io_app(ob,c,"0"); }
      c=io_app(ob,c," R1pairs="); c=io_i64(ob,c,pl_get(L,h_r1pairs()) as i64);
      c=io_app(ob,c," R1cons="); c=io_i64(ob,c,pl_get(L,h_r1sup()) as i64);
      c=io_app(ob,c," R1depth="); c=io_i64(ob,c,pl_get(L,h_maxdepth()) as i64);
      c=io_app(ob,c," skelmax="); c=io_i64(ob,c,pl_get(L,h_skelmax()) as i64);
      c=io_nl(ob,c);
      c=io_app(ob,c,"   roles:");
      t2=0;
      while(t2<MAXTOK()){
        if(tk_nv(L,t2)>0){
          let rr:i32=pl_get(L,t_role()+t2*TOKSTR());
          if(rr!=rE()){ c=io_app(ob,c," "); c=io_i64(ob,c,t2 as i64); c=io_app(ob,c,":"); c=io_i64(ob,c,rr as i64); }
        }
        t2=t2+1;
      }
      c=io_nl(ob,c);
      st=st+1;
    }
    w=w+1;
  }
  io_flush(ob,c);
  return 0;
}

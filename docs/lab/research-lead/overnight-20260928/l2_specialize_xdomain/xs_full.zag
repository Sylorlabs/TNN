// xs_learner.zag -- L2 SPECIALIZE-XDOMAIN learner (generic machinery only).
// A general parametric fold procedure is specialized for a target domain:
// the learner derives fold-count candidates from its own target-domain
// MAP inventory, trials each with execution verification, and fixes the
// verified parameters into a new persistent specialized MAP.
// No world data, no fact literals, no relation literals, no domain
// literals, no parameter-value literals in this file. All interface
// values (entry rel, fold rels, fold count, value rel, link rel) are
// discovered at runtime from learner state and world facts.
// Pure Zag. 0 modes, 0 handlers, 0 new edge types, 0 cross-domain glue.
// State: u8 buffer. Header: 0 NF, 1 NM, 2 NE, 3 SPEC_ON (driver flag),
//   4 IN_SPEC, 5 SPEC_ENTERED, 6 SRC_ID, 7 SPEC_NF, 8 TRIAL_FAIL_N,
//   9 TRIAL_TOTAL, 10 NCAND, 11 NSTEPS.
//   Facts 64x8 @16. MAPs 16x32 @528 [tag,live,start,end,rlen,flen,
//   reason,pad, rels x8 @+8, facts x8 @+16, dom @+24, cap @+25,
//   d_entry @+26, d_r1 @+27, d_r2 @+28, d_nf @+29, d_valrel @+30,
//   d_param @+31]. Edges 64x4 @1040. S_SEARCH i32 @1296,
//   S_EXEC i32 @1300, LAST_VAL @1304, LAST_TERM @1308, LAST_VIA @1312.
//   Scratch: stepset 8xi32 @1408, addends 8xi32 @1472,
//   candidates 8xi32 @1504, walkfids 8xi32 @1536, na @1568,
//   nw @1572, linkrel @1576, acc_re @1580, acc_s1 @1581,
//   acc_s2 @1582, stepset backup 8xi32 @1600.

// ---------- alloc / cell helpers (pinned-znc-safe idioms) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---------- output buffer emit (single preallocated buffer) ----------
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn xs_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn xs_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn xs_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---------- fact / MAP accessors ----------
fn f_sub(st:[]u8, fid:i32)i32 { return st[16+fid*8] as i32; }
fn f_rel(st:[]u8, fid:i32)i32 { return st[16+fid*8+1] as i32; }
fn f_obj(st:[]u8, fid:i32)i32 { return st[16+fid*8+2] as i32; }
fn f_live(st:[]u8, fid:i32)i32 { return st[16+fid*8+3] as i32; }
fn m_base(mid:i32)i32 { return 528+mid*32; }
fn m_live(st:[]u8, mid:i32)i32 { return st[m_base(mid)+1] as i32; }
fn m_start(st:[]u8, mid:i32)i32 { return st[m_base(mid)+2] as i32; }
fn m_end(st:[]u8, mid:i32)i32 { return st[m_base(mid)+3] as i32; }
fn m_rlen(st:[]u8, mid:i32)i32 { return st[m_base(mid)+4] as i32; }
fn m_rel(st:[]u8, mid:i32, k:i32)i32 { return st[m_base(mid)+8+k] as i32; }
fn m_dom(st:[]u8, mid:i32)i32 { return st[m_base(mid)+24] as i32; }
fn m_cap(st:[]u8, mid:i32)i32 { return st[m_base(mid)+25] as i32; }
fn m_dentry(st:[]u8, mid:i32)i32 { return st[m_base(mid)+26] as i32; }
fn m_dr1(st:[]u8, mid:i32)i32 { return st[m_base(mid)+27] as i32; }
fn m_dr2(st:[]u8, mid:i32)i32 { return st[m_base(mid)+28] as i32; }
fn m_dnf(st:[]u8, mid:i32)i32 { return st[m_base(mid)+29] as i32; }
fn m_dvalrel(st:[]u8, mid:i32)i32 { return st[m_base(mid)+30] as i32; }
fn m_dparam(st:[]u8, mid:i32)i32 { return st[m_base(mid)+31] as i32; }

// ---------- cost counting (frozen rules) ----------
fn tick(st:[]u8)void { set32(st,1296,get32(st,1296)+1); return; }
fn tick_exec(st:[]u8)void { set32(st,1300,get32(st,1300)+1); return; }
fn set_ans(st:[]u8, term:i32, val:i32, via:i32)void {
  set32(st,1308,term); set32(st,1304,val); set32(st,1312,via);
  return;
}

// ---------- scans (fid-ascending, live-only; tick per fid) ----------
fn scan1(st:[]u8, sub:i32, rel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let sb:i32=f_sub(st,i);
    let rl:i32=f_rel(st,i);
    if(lv==1){
      if(sb==sub){
        if(rl==rel){ return i; }
      }
    }
    i=i+1;
  }
  return -1;
}
fn scan_nv(st:[]u8, sub:i32, valrel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let sb:i32=f_sub(st,i);
    let rl:i32=f_rel(st,i);
    if(lv==1){
      if(sb==sub){
        if(rl != valrel){ return i; }
      }
    }
    i=i+1;
  }
  return -1;
}
fn scan_val(st:[]u8, node:i32, valrel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let rl:i32=f_rel(st,i);
    let sb:i32=f_sub(st,i);
    if(lv==1){
      if(rl==valrel){
        if(sb==node){ return f_obj(st,i); }
      }
    }
    i=i+1;
  }
  return -1;
}
fn in_stepset(st:[]u8, sb:i32, ns:i32)i32 {
  let j:i32=0;
  let hit:i32=0;
  while(j<ns){
    let v:i32=get32(st,1408+j*4);
    if(v==sb){ hit=1; }
    j=j+1;
  }
  return hit;
}
fn scan_link(st:[]u8, node:i32, ns:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let ob:i32=f_obj(st,i);
    let sb:i32=f_sub(st,i);
    let ins:i32=0;
    if(lv==1){ if(ob==node){ ins=in_stepset(st,sb,ns); } }
    if(ins==1){ return i; }
    i=i+1;
  }
  return -1;
}
fn xa_collect(st:[]u8, mid:i32)i32 {
  let base:i32=m_base(mid);
  let rlen:i32=st[base+4] as i32;
  let cur:i32=st[base+2] as i32;
  set32(st,1408,cur);
  let n:i32=1;
  let k:i32=0;
  let go:i32=1;
  while(go==1){
    if(k>=rlen){ go=0; }
    else {
      let r:i32=st[base+8+k] as i32;
      let f:i32=scan1(st,cur,r);
      if(f<0){ go=0; }
      else {
        cur=f_obj(st,f);
        set32(st,1408+n*4,cur);
        n=n+1;
        k=k+1;
      }
    }
  }
  st[11]=n as u8;
  tick_exec(st);
  return n;
}
fn steps_backup(st:[]u8)void {
  let j:i32=0;
  while(j<8){ set32(st,1600+j*4,get32(st,1408+j*4)); j=j+1; }
  return;
}
fn steps_restore(st:[]u8)void {
  let j:i32=0;
  while(j<8){ set32(st,1408+j*4,get32(st,1600+j*4)); j=j+1; }
  return;
}

// ---------- teaching ----------
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=64){ return -1; }
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){ return -1; }
  if(rl>8){ return -1; }
  if(fl>8){ return -1; }
  let b:i32=528+n*32;
  st[b]=20; st[b+1]=1; st[b+2]=start as u8; st[b+3]=end as u8;
  st[b+4]=rl as u8; st[b+5]=fl as u8; st[b+6]=0; st[b+7]=0;
  let k:i32=0;
  while(k<rl){ st[b+8+k]=rs[k]; k=k+1; }
  k=0;
  while(k<fl){ st[b+16+k]=fs[k]; k=k+1; }
  st[b+24]=dom as u8; st[b+25]=cap as u8;
  st[b+26]=0; st[b+27]=0; st[b+28]=0; st[b+29]=0;
  st[b+31]=0;
  let vr:i32=0;
  let fi:i32=0;
  let fnn:i32=st[0] as i32;
  let fnd:i32=0;
  while(fi<fnn){
    let l2:i32=f_live(st,fi);
    let s2:i32=f_sub(st,fi);
    if(l2==1){ if(s2==end){ if(fnd==0){ vr=f_rel(st,fi); fnd=1; } } }
    fi=fi+1;
  }
  st[b+30]=vr as u8;
  if(cap==1){
    let r1:i32=rs[1] as i32;
    let r2:i32=rs[2] as i32;
    let ok:i32=1;
    if(rl<3){ ok=0; }
    let half:i32=rl-1;
    if(half%2 != 0){ ok=0; }
    let j:i32=1;
    while(j<rl){
      let want:i32=r1;
      if(j%2==0){ want=r2; }
      let got:i32=rs[j] as i32;
      if(got != want){ ok=0; }
      j=j+1;
    }
    if(ok==1){
      st[b+26]=rs[0];
      st[b+27]=r1 as u8;
      st[b+28]=r2 as u8;
      st[b+29]=((rl-1)/2) as u8;
      st[b+31]=1;
    }
  }
  st[1]=(n+1) as u8;
  return n;
}
fn xs_edge(st:[]u8, a:i32, b:i32, ty:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){ return; }
  let o:i32=1040+n*4;
  st[o]=a as u8; st[o+1]=b as u8; st[o+2]=ty as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}

// ---------- MAP search ----------
fn find_map(st:[]u8, dom:i32, s:i32)i32 {
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    tick(st);
    let lv:i32=m_live(st,mid);
    let dm:i32=m_dom(st,mid);
    let stt:i32=m_start(st,mid);
    if(lv==1){ if(dm==dom){ if(stt==s){ return mid; } } }
    mid=mid+1;
  }
  return -1;
}
fn find_gen(st:[]u8, cap:i32)i32 {
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    tick(st);
    let lv:i32=m_live(st,mid);
    let cp:i32=m_cap(st,mid);
    let pm:i32=m_dparam(st,mid);
    if(lv==1){ if(cp==cap){ if(pm==1){ return mid; } } }
    mid=mid+1;
  }
  return -1;
}
fn cand_seen(st:[]u8, nc:i32, cc:i32)i32 {
  let j:i32=0;
  while(j<nc){
    if(get32(st,1504+j*4)==cc){ return 1; }
    j=j+1;
  }
  return 0;
}
fn build_cands(st:[]u8, dom:i32)i32 {
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  let nc:i32=0;
  while(mid<nm){
    tick(st);
    let lv:i32=m_live(st,mid);
    let dm:i32=m_dom(st,mid);
    if(lv==1){ if(dm==dom){
      let c:i32=xa_collect(st,mid);
      let cc:i32=c-1;
      let seen:i32=cand_seen(st,nc,cc);
      if(seen==0){ set32(st,1504+nc*4,cc); nc=nc+1; }
    }}
    mid=mid+1;
  }
  st[10]=nc as u8;
  return nc;
}

// ---------- executors ----------
fn home_exec(st:[]u8, mid:i32, s:i32, t:i32, v:i32)i32 {
  tick_exec(st);
  let de:i32=m_dentry(st,mid);
  let r1:i32=m_dr1(st,mid);
  let r2:i32=m_dr2(st,mid);
  let nfv:i32=m_dnf(st,mid);
  let valrel:i32=m_dvalrel(st,mid);
  let e:i32=scan1(st,s,de);
  if(e<0){ set_ans(st,-2,-2,-1); return 0; }
  let cur:i32=f_obj(st,e);
  let k:i32=0;
  let go:i32=1;
  while(go==1){
    if(k>=nfv){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,r1);
      if(c1<0){ bad=1; }
      let c2:i32=-1;
      let co:i32=0;
      if(bad==0){ co=f_obj(st,c1); c2=scan1(st,co,r2); if(c2<0){ bad=1; } }
      if(bad==0){ cur=f_obj(st,c2); k=k+1; }
      else { go=0; cur=-1; }
    }
  }
  if(cur != t){ set_ans(st,-2,-2,-1); return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ set_ans(st,-2,-2,-1); return 0; }
  }
  set_ans(st,t,v,mid);
  return 1;
}
fn chain_exec(st:[]u8, mid:i32, s:i32, t:i32, v:i32)i32 {
  tick_exec(st);
  let rl:i32=m_rlen(st,mid);
  let valrel:i32=m_dvalrel(st,mid);
  let cur:i32=s;
  let k:i32=0;
  let go:i32=1;
  while(go==1){
    if(k>=rl){ go=0; }
    else {
      let r:i32=m_rel(st,mid,k);
      let f:i32=scan1(st,cur,r);
      if(f<0){ go=0; cur=-1; }
      else { cur=f_obj(st,f); k=k+1; }
    }
  }
  if(cur != t){ set_ans(st,-2,-2,-1); return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ set_ans(st,-2,-2,-1); return 0; }
  }
  set_ans(st,t,v,mid);
  return 1;
}
fn check_arity(st:[]u8, ns:i32, valrel:i32)i32 {
  let na:i32=get32(st,1568);
  let lr:i32=0;
  let i:i32=0;
  let ok:i32=1;
  while(i<na){
    let bad:i32=0;
    let ad:i32=get32(st,1472+i*4);
    let av:i32=scan_val(st,ad,valrel);
    if(av<0){ bad=1; }
    let lf:i32=-1;
    if(bad==0){
      lf=scan_link(st,ad,ns);
      if(lf<0){ bad=1; }
    }
    if(bad==0){
      let r:i32=f_rel(st,lf);
      if(lr==0){ lr=r; }
      if(r != lr){ bad=1; }
    }
    if(bad==1){ ok=0; i=na; }
    else { i=i+1; }
  }
  set32(st,1576,lr);
  return ok;
}
fn walk_folds(st:[]u8, b:i32, s1:i32, s2:i32, L:i32)i32 {
  let cur:i32=b;
  let k:i32=2;
  let go:i32=1;
  while(go==1){
    if(k>L){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,s1);
      if(c1<0){ bad=1; }
      if(bad==0){
        let na:i32=get32(st,1568);
        set32(st,1472+na*4,f_obj(st,c1));
        set32(st,1568,na+1);
        let nw:i32=get32(st,1572);
        set32(st,1536+nw*4,c1);
        set32(st,1572,nw+1);
      }
      let c2:i32=-1;
      if(bad==0){
        let co:i32=f_obj(st,c1);
        c2=scan1(st,co,s2);
        if(c2<0){ bad=1; }
      }
      if(bad==0){
        let nw2:i32=get32(st,1572);
        set32(st,1536+nw2*4,c2);
        set32(st,1572,nw2+1);
        cur=f_obj(st,c2);
        k=k+1;
      }
      else { go=0; cur=-1; }
    }
  }
  return cur;
}
fn trial_entry(st:[]u8, sm:i32, fid:i32, t:i32, v:i32, L:i32, ns:i32)i32 {
  let valrel:i32=m_dvalrel(st,sm);
  let u:i32=f_obj(st,fid);
  let s1f:i32=scan_nv(st,u,valrel);
  if(s1f<0){ return 0; }
  let s1:i32=f_rel(st,s1f);
  let a:i32=f_obj(st,s1f);
  let s2f:i32=scan_nv(st,a,valrel);
  if(s2f<0){ return 0; }
  let s2:i32=f_rel(st,s2f);
  let b:i32=f_obj(st,s2f);
  set32(st,1472,a); set32(st,1568,1);
  set32(st,1536,fid); set32(st,1540,s1f); set32(st,1544,s2f); set32(st,1572,3);
  let term:i32=walk_folds(st,b,s1,s2,L);
  if(term != t){ return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ return 0; }
  }
  let ar:i32=check_arity(st,ns,valrel);
  if(ar==0){ return 0; }
  st[1580]=f_rel(st,fid) as u8;
  st[1581]=s1 as u8;
  st[1582]=s2 as u8;
  return 1;
}
fn adapter_trial(st:[]u8, sm:i32, s:i32, t:i32, v:i32, L:i32, ns:i32)i32 {
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  let found:i32=0;
  while(fid<nf){
    tick(st);
    let lv:i32=f_live(st,fid);
    let sb:i32=f_sub(st,fid);
    let cand:i32=0;
    if(lv==1){ if(sb==s){ cand=1; } }
    if(cand==1){
      let r:i32=trial_entry(st,sm,fid,t,v,L,ns);
      if(r==1){ found=1; fid=nf; }
    }
    if(found==0){ fid=fid+1; }
  }
  return found;
}
fn spec_entry(st:[]u8, mid:i32, fid:i32, t:i32, v:i32, ns:i32)i32 {
  let r1:i32=m_dr1(st,mid);
  let r2:i32=m_dr2(st,mid);
  let nfv:i32=m_dnf(st,mid);
  let valrel:i32=m_dvalrel(st,mid);
  let cur:i32=f_obj(st,fid);
  let k:i32=1;
  let go:i32=1;
  set32(st,1568,0);
  while(go==1){
    if(k>nfv){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,r1);
      if(c1<0){ bad=1; }
      let co:i32=0;
      if(bad==0){
        co=f_obj(st,c1);
        let na:i32=get32(st,1568);
        set32(st,1472+na*4,co);
        set32(st,1568,na+1);
      }
      let c2:i32=-1;
      if(bad==0){
        c2=scan1(st,co,r2);
        if(c2<0){ bad=1; }
      }
      if(bad==0){ cur=f_obj(st,c2); k=k+1; }
      else { go=0; cur=-1; }
    }
  }
  if(cur != t){ return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ return 0; }
  }
  return check_arity(st,ns,valrel);
}
fn spec_exec(st:[]u8, mid:i32, s:i32, t:i32, v:i32, dom:i32)i32 {
  tick_exec(st);
  let smap:i32=find_map(st,dom,s);
  let ns:i32=0;
  if(smap>=0){ ns=xa_collect(st,smap); }
  let de:i32=m_dentry(st,mid);
  let nf:i32=st[0] as i32;
  let fid:i32=0;
  let done:i32=0;
  while(fid<nf){
    tick(st);
    let lv:i32=f_live(st,fid);
    let sb:i32=f_sub(st,fid);
    let rl:i32=f_rel(st,fid);
    let cand:i32=0;
    if(lv==1){ if(sb==s){ if(rl==de){ cand=1; } } }
    if(cand==1){
      let r:i32=spec_entry(st,mid,fid,t,v,ns);
      if(r==1){ set_ans(st,t,v,mid); done=1; fid=nf; }
    }
    if(done==0){ fid=fid+1; }
  }
  if(done==0){ set_ans(st,-2,-2,-1); }
  return done;
}
fn pipe_try(st:[]u8, mid:i32, s:i32, t:i32, v:i32, cap:i32, dom:i32)i32 {
  let lv:i32=m_live(st,mid);
  if(lv==0){ return 0; }
  let mst:i32=m_start(st,mid);
  if(mst != s){ return 0; }
  let mdm:i32=m_dom(st,mid);
  if(mdm != dom){ return 0; }
  let mc:i32=m_cap(st,mid);
  if(mc==1){
    let pm:i32=m_dparam(st,mid);
    if(pm==1){ return home_exec(st,mid,s,t,v); }
    return spec_exec(st,mid,s,t,v,dom);
  }
  return chain_exec(st,mid,s,t,v);
}

// ---------- promotion ----------
fn xs_promote(st:[]u8, sm:i32, smap:i32, s:i32, t:i32, cap:i32, dom:i32, L:i32)i32 {
  let n:i32=st[1] as i32;
  let b:i32=528+n*32;
  let re:i32=st[1580] as i32;
  let s1:i32=st[1581] as i32;
  let s2:i32=st[1582] as i32;
  let valrel:i32=m_dvalrel(st,sm);
  st[b]=20; st[b+1]=1; st[b+2]=s as u8; st[b+3]=t as u8;
  let rl:i32=1+L*2;
  st[b+4]=rl as u8;
  let nw:i32=get32(st,1572);
  st[b+5]=nw as u8;
  st[b+6]=0; st[b+7]=0;
  st[b+8]=re as u8;
  let k:i32=0;
  while(k<L){
    st[b+9+k*2]=s1 as u8;
    st[b+10+k*2]=s2 as u8;
    k=k+1;
  }
  let j:i32=0;
  while(j<nw){
    st[b+16+j]=get32(st,1536+j*4) as u8;
    j=j+1;
  }
  st[b+24]=dom as u8; st[b+25]=cap as u8;
  st[b+26]=re as u8; st[b+27]=s1 as u8; st[b+28]=s2 as u8;
  st[b+29]=L as u8; st[b+30]=valrel as u8; st[b+31]=0;
  st[1]=(n+1) as u8;
  xs_edge(st,n,sm,16);
  xs_edge(st,n,smap,16);
  return n;
}

// ---------- trace helpers ----------
fn trace_steps(st:[]u8, ns:i32, ob:[]u8, atp:[]u8)void {
  xs_p(ob,atp,"XS-STEPS ");
  let si:i32=0;
  while(si<ns){
    if(si>0){ xs_p(ob,atp,","); }
    xs_pi(ob,atp,get32(st,1408+si*4));
    si=si+1;
  }
  xs_pnl(ob,atp);
  return;
}
fn trace_cands(st:[]u8, ob:[]u8, atp:[]u8)void {
  let nc:i32=st[10] as i32;
  xs_p(ob,atp,"XS-CANDIDATES ");
  let ci:i32=0;
  while(ci<nc){
    if(ci>0){ xs_p(ob,atp,","); }
    xs_pi(ob,atp,get32(st,1504+ci*4));
    ci=ci+1;
  }
  xs_pnl(ob,atp);
  return;
}

// ---------- specialize / general ----------
fn xs_specialize(st:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8)void {
  st[4]=1; st[5]=1;
  let smap:i32=find_map(st,dom,s);
  if(smap<0){ set_ans(st,-2,-2,-1); return; }
  let ns:i32=xa_collect(st,smap);
  steps_backup(st);
  trace_steps(st,ns,ob,atp);
  let sm:i32=find_gen(st,cap);
  if(sm<0){
    xs_p(ob,atp,"XS-SPECIALIZE-FAIL reason=no-source\n");
    set_ans(st,-2,-2,-1);
    return;
  }
  st[6]=sm as u8;
  xs_p(ob,atp,"XS-SRC id=");
  xs_pi(ob,atp,sm);
  xs_pnl(ob,atp);
  let nc:i32=build_cands(st,dom);
  steps_restore(st);
  st[11]=ns as u8;
  trace_cands(st,ob,atp);
  let ci:i32=0;
  let done:i32=0;
  while(ci<nc){
    let L:i32=get32(st,1504+ci*4);
    st[9]=(st[9] as i32 + 1) as u8;
    xs_p(ob,atp,"XS-TRIAL nf=");
    xs_pi(ob,atp,L);
    let r:i32=adapter_trial(st,sm,s,t,v,L,ns);
    if(r==1){
      xs_pnl(ob,atp);
      xs_p(ob,atp,"XS-ACCEPT re=");
      xs_pi(ob,atp,st[1580] as i32);
      xs_p(ob,atp," s1=");
      xs_pi(ob,atp,st[1581] as i32);
      xs_p(ob,atp," s2=");
      xs_pi(ob,atp,st[1582] as i32);
      xs_p(ob,atp," lr=");
      xs_pi(ob,atp,get32(st,1576));
      xs_pnl(ob,atp);
      st[7]=L as u8;
      let nid:i32=xs_promote(st,sm,smap,s,t,cap,dom,L);
      xs_p(ob,atp,"XS-SPEC-NF ");
      xs_pi(ob,atp,L);
      xs_pnl(ob,atp);
      xs_p(ob,atp,"XS-SPEC-RELS ");
      xs_pi(ob,atp,st[1580] as i32);
      xs_p(ob,atp,",");
      xs_pi(ob,atp,st[1581] as i32);
      xs_p(ob,atp,",");
      xs_pi(ob,atp,st[1582] as i32);
      xs_pnl(ob,atp);
      xs_p(ob,atp,"XS-SPEC-COSTREL ");
      xs_pi(ob,atp,get32(st,1576));
      xs_pnl(ob,atp);
      xs_p(ob,atp,"XS-SPEC-PROMOTE id=");
      xs_pi(ob,atp,nid);
      xs_pnl(ob,atp);
      spec_exec(st,nid,s,t,v,dom);
      done=1; ci=nc;
    }
    else {
      xs_p(ob,atp," FAIL\n");
      st[8]=(st[8] as i32 + 1) as u8;
    }
    if(done==0){ ci=ci+1; }
  }
  if(done==0){ set_ans(st,-2,-2,-1); }
  return;
}
fn xs_general(st:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8)void {
  let smap:i32=find_map(st,dom,s);
  if(smap<0){ set_ans(st,-2,-2,-1); return; }
  let ns:i32=xa_collect(st,smap);
  steps_backup(st);
  let sm:i32=find_gen(st,cap);
  if(sm<0){ set_ans(st,-2,-2,-1); return; }
  let nc:i32=build_cands(st,dom);
  steps_restore(st);
  st[11]=ns as u8;
  let ci:i32=0;
  let done:i32=0;
  while(ci<nc){
    let L:i32=get32(st,1504+ci*4);
    let r:i32=adapter_trial(st,sm,s,t,v,L,ns);
    if(r==1){
      xs_p(ob,atp,"XS-GENERAL-ACCEPT nf=");
      xs_pi(ob,atp,L);
      xs_p(ob,atp," via=");
      xs_pi(ob,atp,sm);
      xs_pnl(ob,atp);
      set_ans(st,t,v,sm);
      done=1; ci=nc;
    }
    if(done==0){ ci=ci+1; }
  }
  if(done==0){ set_ans(st,-2,-2,-1); }
  return;
}
fn xs_query(st:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8)void {
  set32(st,1296,0); set32(st,1300,0);
  set_ans(st,-2,-2,-1);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  let done:i32=0;
  let saw:i32=0;
  while(mid<nm){
    tick(st);
    let lv2:i32=m_live(st,mid);
    let cp2:i32=m_cap(st,mid);
    let dm2:i32=m_dom(st,mid);
    let pm2:i32=m_dparam(st,mid);
    let hit:i32=0;
    if(lv2==1){ hit=1; }
    if(hit==1){ if(cp2 != cap){ hit=0; } }
    if(hit==1){ if(dm2 != dom){ hit=0; } }
    if(hit==1){ if(pm2 != 0){ hit=0; } }
    if(hit==1){ saw=1; }
    let d:i32=pipe_try(st,mid,s,t,v,cap,dom);
    if(d==1){ done=1; mid=nm; }
    if(done==0){ mid=mid+1; }
  }
  if(done==0){
    let so:i32=st[3] as i32;
    if(so==1){
      if(saw==0){ xs_specialize(st,s,t,v,cap,dom,ob,atp); }
    }
    else { xs_general(st,s,t,v,cap,dom,ob,atp); }
  }
  return;
}
// xs_world.zag -- L2 SPECIALIZE-XDOMAIN world: fact table + MAP teaching.
// Builder-designed world (not adversary-designed). All world literals
// live here; xs_learner.zag names none of them.

// facts 0..54: arithmetic SUM domain (A) + planning domain (B)
fn teach_world(st:[]u8)void {
  f_teach(st,40,5,30);
  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,30,2,3);
  f_teach(st,31,2,4);
  f_teach(st,32,2,5);
  f_teach(st,43,2,12);
  f_teach(st,100,18,40);
  f_teach(st,54,7,55);
  f_teach(st,55,7,56);
  f_teach(st,50,7,51);
  f_teach(st,51,7,52);
  f_teach(st,52,7,53);
  f_teach(st,50,8,60);
  f_teach(st,51,8,61);
  f_teach(st,52,8,62);
  f_teach(st,60,2,20);
  f_teach(st,61,2,30);
  f_teach(st,62,2,25);
  f_teach(st,50,17,64);
  f_teach(st,50,17,70);
  f_teach(st,64,15,74);
  f_teach(st,74,16,65);
  f_teach(st,65,15,75);
  f_teach(st,75,16,66);
  f_teach(st,66,15,76);
  f_teach(st,76,16,67);
  f_teach(st,74,2,1);
  f_teach(st,75,2,2);
  f_teach(st,76,2,3);
  f_teach(st,67,2,6);
  f_teach(st,70,15,60);
  f_teach(st,60,16,71);
  f_teach(st,71,15,61);
  f_teach(st,61,16,72);
  f_teach(st,72,15,62);
  f_teach(st,62,16,73);
  f_teach(st,73,2,75);
  f_teach(st,50,17,80);
  f_teach(st,80,15,90);
  f_teach(st,90,16,91);
  f_teach(st,91,15,92);
  f_teach(st,92,16,93);
  f_teach(st,93,15,94);
  f_teach(st,94,16,95);
  f_teach(st,95,2,36);
  f_teach(st,50,8,90);
  f_teach(st,51,8,92);
  f_teach(st,52,8,94);
  f_teach(st,90,2,11);
  f_teach(st,92,2,12);
  f_teach(st,94,2,13);
  return;
}

// MAPs: mD2 (id 0, B ROUTE 2-hop), mG (id 1, A GENERAL AGG),
// mB0 (id 2, B ROUTE 3-hop)
fn teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=7; rs[1]=7;
  fs[0]=11; fs[1]=12;
  m_teach(st,rs,2,fs,2,54,56,2,2);
  rs=z_alloc(8);
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs=z_alloc(8);
  fs[0]=10; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  rs=z_alloc(8);
  rs[0]=7; rs[1]=7; rs[2]=7;
  fs=z_alloc(8);
  fs[0]=13; fs[1]=14; fs[2]=15;
  m_teach(st,rs,3,fs,3,50,53,2,2);
  return;
}
// xs_driver.zag -- L2 SPECIALIZE-XDOMAIN experiment driver.
// Three arms (FULL / GENERAL / ABLATE-X), per-query S/E/ANS capture,
// in-Zag kill-bar evaluation, main + single-syscall stdout flush.
// Query slots: 0=QA 1=QB 2=Q2 3=Q2B 4=Q2C 5=Q2D; 5 i32s each @qi*20
// (S,E,term,val,via). Arm-level @120: spec_nf, @124 fail_n,
// @128 total, @132 nm, @136 ne, @140 t16, @144 ebad.

fn do_q(st:[]u8, res:[]u8, qi:i32, s:i32, t:i32, v:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8, name:[]u8)void {
  xs_query(st,s,t,v,cap,dom,ob,atp);
  let o:i32=qi*20;
  set32(res,o,get32(st,1296));
  set32(res,o+4,get32(st,1300));
  set32(res,o+8,get32(st,1308));
  set32(res,o+12,get32(st,1304));
  set32(res,o+16,get32(st,1312));
  xs_p(ob,atp,"Q ");
  xs_p(ob,atp,name);
  xs_p(ob,atp," S=");
  xs_pi(ob,atp,get32(st,1296));
  xs_p(ob,atp," E=");
  xs_pi(ob,atp,get32(st,1300));
  xs_p(ob,atp," term=");
  xs_pi(ob,atp,get32(st,1308));
  xs_p(ob,atp," val=");
  xs_pi(ob,atp,get32(st,1304));
  xs_p(ob,atp," via=");
  xs_pi(ob,atp,get32(st,1312));
  xs_pnl(ob,atp);
  return;
}
fn arm_close(st:[]u8, res:[]u8)void {
  set32(res,120,st[7] as i32);
  set32(res,124,st[8] as i32);
  set32(res,128,st[9] as i32);
  set32(res,132,st[1] as i32);
  set32(res,136,st[2] as i32);
  let ec:i32=0;
  let bad:i32=0;
  let ei:i32=0;
  let nn:i32=st[2] as i32;
  while(ei<nn){
    let ty:i32=st[1040+ei*4+2] as i32;
    if(ty==16){ ec=ec+1; }
    if(ty != 14){ if(ty != 16){ bad=1; } }
    ei=ei+1;
  }
  set32(res,140,ec);
  set32(res,144,bad);
  return;
}
fn run_arm(ob:[]u8, atp:[]u8, arm:i32, res:[]u8)void {
  let st:[]u8=z_alloc(2048);
  teach_world(st);
  teach_maps(st);
  if(arm==1){ st[3]=0; } else { st[3]=1; }
  if(arm==0){ xs_p(ob,atp,"ARM FULL\n"); }
  if(arm==1){ xs_p(ob,atp,"ARM GENERAL\n"); }
  if(arm==2){ xs_p(ob,atp,"ARM ABLATE-X\n"); }
  do_q(st,res,0,100,43,12,1,1,ob,atp,"QA");
  do_q(st,res,1,50,53,-1,2,2,ob,atp,"QB");
  if(arm==2){
    let b:i32=528+1*32;
    st[b+1]=0;
    st[b+6]=3;
  }
  do_q(st,res,2,50,73,75,1,2,ob,atp,"Q2");
  if(arm==2){ arm_close(st,res); return; }
  do_q(st,res,3,50,73,75,1,2,ob,atp,"Q2B");
  if(arm==1){ arm_close(st,res); return; }
  do_q(st,res,4,50,95,36,1,2,ob,atp,"Q2C");
  do_q(st,res,5,50,72,-1,1,2,ob,atp,"Q2D");
  arm_close(st,res);
  return;
}
fn qf(res:[]u8, qi:i32, f:i32)i32 { return get32(res,qi*20+f*4); }
fn d_bar(ob:[]u8, atp:[]u8, name:[]u8, p:i32)void {
  xs_p(ob,atp,name);
  xs_p(ob,atp,"=");
  if(p==1){ xs_p(ob,atp,"PASS "); } else { xs_p(ob,atp,"FAIL "); }
  return;
}
fn ck_count(ob:[]u8, atp:[]u8, res:[]u8, qi:i32, fs:i32, fe:i32, tag:[]u8) i32 {
  let s:i32=qf(res,qi,0);
  let e:i32=qf(res,qi,1);
  if(s != fs){ xs_p(ob,atp,"FALSIFIER F-COUNT "); xs_p(ob,atp,tag); xs_p(ob,atp," S\n"); return 1; }
  if(e != fe){ xs_p(ob,atp,"FALSIFIER F-COUNT "); xs_p(ob,atp,tag); xs_p(ob,atp," E\n"); return 1; }
  return 0;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  xs_p(ob,atp,"L2-SPECIALIZE-XDOMAIN-START\n");
  let rf:[]u8=z_alloc(256);
  let rg:[]u8=z_alloc(256);
  let ra:[]u8=z_alloc(256);
  run_arm(ob,atp,0,rf);
  run_arm(ob,atp,1,rg);
  run_arm(ob,atp,2,ra);
  let ff:i32=0;
  // F-COUNT: frozen per-query S/E
  ff=ff+ck_count(ob,atp,rf,0,44,1,"FULL-QA");
  ff=ff+ck_count(ob,atp,rf,1,48,1,"FULL-QB");
  ff=ff+ck_count(ob,atp,rf,2,2597,6,"FULL-Q2");
  ff=ff+ck_count(ob,atp,rf,3,669,3,"FULL-Q2B");
  ff=ff+ck_count(ob,atp,rf,4,1166,3,"FULL-Q2C");
  ff=ff+ck_count(ob,atp,rf,5,815,3,"FULL-Q2D");
  ff=ff+ck_count(ob,atp,rg,0,44,1,"GEN-QA");
  ff=ff+ck_count(ob,atp,rg,1,48,1,"GEN-QB");
  ff=ff+ck_count(ob,atp,rg,2,1977,4,"GEN-Q2");
  ff=ff+ck_count(ob,atp,rg,3,1977,4,"GEN-Q2B");
  ff=ff+ck_count(ob,atp,ra,0,44,1,"ABL-QA");
  ff=ff+ck_count(ob,atp,ra,1,48,1,"ABL-QB");
  ff=ff+ck_count(ob,atp,ra,2,99,2,"ABL-Q2");
  // F-EDGE-NEW
  if(get32(rf,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n"); ff=ff+1; }
  if(get32(rg,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW GEN\n"); ff=ff+1; }
  if(get32(ra,144) != 0){ xs_p(ob,atp,"FALSIFIER F-EDGE-NEW ABL\n"); ff=ff+1; }
  // targeted falsifiers
  if(qf(rf,2,4) != 3){ xs_p(ob,atp,"FALSIFIER F-NO-SPEC\n"); ff=ff+1; }
  if(get32(rf,120) != 3){ xs_p(ob,atp,"FALSIFIER F-SPEC-NF\n"); ff=ff+1; }
  if(get32(rf,124) < 1){ xs_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,128) < 2){ xs_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(qf(rg,2,2) != 73){ xs_p(ob,atp,"FALSIFIER F-GEN-WRONG\n"); ff=ff+1; }
  if(qf(rg,3,2) != 73){ xs_p(ob,atp,"FALSIFIER F-GEN-WRONG\n"); ff=ff+1; }
  if(qf(rf,3,4) != 3){ xs_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,4,4) != 3){ xs_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,4,2) != 95){ xs_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,5,4) != -1){ xs_p(ob,atp,"FALSIFIER F-Q2D\n"); ff=ff+1; }
  if(qf(ra,2,2) != -2){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,132) != 3){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,140) != 0){ xs_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(rf,140) != 2){ xs_p(ob,atp,"FALSIFIER F-T16-FULL\n"); ff=ff+1; }
  if(get32(rg,140) != 0){ xs_p(ob,atp,"FALSIFIER F-T16-GEN\n"); ff=ff+1; }
  // kill bars
  let k1:i32=0;
  if(qf(rf,0,4)==1){ if(qf(rf,1,4)==2){ if(qf(rf,2,4)==3){ k1=1; } } }
  let k2:i32=0;
  if(qf(rg,3,2)==73){ if(qf(rg,3,3)==75){ if(qf(rg,3,0) > qf(rf,3,0)){ k2=1; } } }
  let k3:i32=0;
  if(get32(rf,120)==3){ if(get32(rf,124)>=1){ if(get32(rf,128)>=2){ k3=1; } } }
  let k4:i32=0;
  if(qf(rf,3,2)==73){ if(qf(rf,3,0) < qf(rg,3,0)){ k4=1; } }
  let k5:i32=0;
  if(qf(rf,3,4)==3){ if(qf(rf,3,2)==73){ if(qf(rf,3,3)==75){
    if(qf(rf,4,4)==3){ if(qf(rf,4,2)==95){ if(qf(rf,4,3)==36){
      if(qf(rf,5,4)==-1){ k5=1; } } } } } } }
  let k8:i32=0;
  if(qf(ra,2,2)==-2){ if(qf(ra,2,4)==-1){ if(get32(ra,132)==3){ if(get32(ra,140)==0){ k8=1; } } } }
  xs_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  xs_pnl(ob,atp);
  xs_p(ob,atp,"FALSIFIERS ");
  xs_pi(ob,atp,ff);
  xs_pnl(ob,atp);
  xs_p(ob,atp,"L2-SPECIALIZE-XDOMAIN-END\n");
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

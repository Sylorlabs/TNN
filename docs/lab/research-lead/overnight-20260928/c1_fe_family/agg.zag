// diag.zag - independent diagnostic re-implementation of the contestant's
// procedure-inference class cascade, plus D1/D2/D3 revision diagnostics.
// Usage: diag <state.txt> <turns.jsonl> <scores.jsonl>
// For each proc query: checks detection (D1), diagnosis (D2), then predicts
// the answer from the sup=0 demo set and locates misses.
// State is a line buffer; lines use \x01 (byte 1) as field separator.
// Line kinds: F fact, R relation, H hypothesis weight, E causal episode,
// D proc demo, V vocab, M causal mask, B causal baseline, Q pending query.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn app1(buf:[]u8,at:i32,c:u8)i32 { buf[at]=c; return at+1; }
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
  if(neg==1){v=-v;}
  return v;
}
fn getfld(line:[]u8,idx:i32)[]u8 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=line.len){
    if(i==line.len || line[i]==1){
      if(n==idx){return line[s..i];}
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return "";
}
// find first line whose first two fields are tag,f1 (f1="" matches tag only)
fn rev_str(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[s.len-1-i];i=i+1;}
  return b;
}
fn rot_str(s:[]u8,k:i32)[]u8 {
  if(s.len==0){return "";}
  let kk:i32=k%s.len;
  if(kk<0){kk=kk+s.len;}
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[(i+kk)%s.len];i=i+1;}
  return b;
}
fn atoi(s:[]u8)i32 {
  let i:i32=0;
  let neg:i32=0;
  if(s.len>0 && s[0]==45){neg=1;i=1;}
  let v:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  if(neg==1){v=-v;}
  return v;
}
fn count_lines(b:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<b.len){if(b[i]==10){n=n+1;}i=i+1;}
  if(b.len>0 && b[b.len-1]!=10){n=n+1;}
  return n;
}
fn get_line(b:[]u8,li:i32)[]u8 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=b.len){
    if(i==b.len || b[i]==10){
      if(n==li){return b[s..i];}
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return "";
}
fn ia_get(a:[]u8,i:i32)i32 { return ld32(a,i*4); }
fn ia_set(a:[]u8,i:i32,v:i32)void { st32(a,i*4,v); return; }
// pint_after: parse integer following key in line; -1 if key absent
fn pint_after(line:[]u8,key:[]u8)i32 {
  let p:i32=findsub(line,0,key);
  if(p<0){return -1;}
  let s:i32=p+key.len;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  let any:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;any=1;}
  if(any==0){return -1;}
  if(neg==1){v=-v;}
  return v;
}
// agree value "a/b": returns a, sets b via blen trick (b stored in second slot)
fn agree_ab(line:[]u8)[]u8 {
  let r:[]u8=z_alloc(8);
  let p:i32=findsub(line,0,"agree=");
  if(p<0){ia_set(r,0,-1);ia_set(r,1,-1);return r;}
  let s:i32=p+6;
  let a:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){a=a*10+(line[s] as i32)-48;s=s+1;}
  let b:i32=0;
  if(s<line.len && line[s]==47){
    s=s+1;
    while(s<line.len && line[s]>=48 && line[s]<=57){b=b*10+(line[s] as i32)-48;s=s+1;}
  }
  ia_set(r,0,a);
  ia_set(r,1,b);
  return r;
}
fn sval_after(line:[]u8,key:[]u8)[]u8 {
  let p:i32=findsub(line,0,key);
  if(p<0){return "";}
  let s:i32=p+key.len;
  let e:i32=s;
  while(e<line.len && line[e]!=32){e=e+1;}
  return line[s..e];
}
fn outl(s:[]u8)void {
  let b:[]u8=z_alloc(s.len+1);
  app(b,0,s);
  app(b,s.len,"\n");
  emit(b[0..s.len+1]);
  return;
}
fn main()i32 {
  if(_zag_arg(1).len==0 || _zag_arg(2).len==0 || _zag_arg(3).len==0 || _zag_arg(4).len==0){return 1;}
  // accumulators per family: 0=runs 1=qtot 2=agree 3=det 4=dg 5=appm 6=uncl 7=smbad 8=p4bad 9=r2tot 10=r2hit 11=r2miss
  let acc:[]u8=z_alloc(4*12*4);
  let fi:i32=0;
  while(fi<4){
    let path:[]u8=_zag_arg(fi+1);
    let buf:[]u8=read_file(path);
    let n:i32=count_lines(buf);
    let li:i32=0;
    while(li<n){
      let line:[]u8=get_line(buf,li);
      if(line.len>=7 && streq(line[0..7],"SUMMARY")==1){
        let ab:[]u8=agree_ab(line);
        ia_set(acc,fi*12+0,ia_get(acc,fi*12+0)+1);
        ia_set(acc,fi*12+1,ia_get(acc,fi*12+1)+ia_get(ab,1));
        ia_set(acc,fi*12+2,ia_get(acc,fi*12+2)+ia_get(ab,0));
        ia_set(acc,fi*12+3,ia_get(acc,fi*12+3)+pint_after(line,"det_fail="));
        ia_set(acc,fi*12+4,ia_get(acc,fi*12+4)+pint_after(line,"diag_fail="));
        ia_set(acc,fi*12+5,ia_get(acc,fi*12+5)+pint_after(line,"app_miss="));
        ia_set(acc,fi*12+6,ia_get(acc,fi*12+6)+pint_after(line,"unclassified="));
        if(streq(sval_after(line,"state_match="),"NO")==1){
          ia_set(acc,fi*12+7,ia_get(acc,fi*12+7)+1);
        }
        if(streq(sval_after(line,"p4="),"FAIL")==1){
          ia_set(acc,fi*12+8,ia_get(acc,fi*12+8)+1);
        }
      }
      if(line.len>=3 && streq(line[0..3],"R2 ")==1){
        ia_set(acc,fi*12+9,ia_get(acc,fi*12+9)+1);
        let loc:[]u8=sval_after(line,"loc=");
        if(streq(loc,"HIT-OK")==1){ia_set(acc,fi*12+10,ia_get(acc,fi*12+10)+1);}
        if(streq(loc,"APPLICATION")==1){ia_set(acc,fi*12+11,ia_get(acc,fi*12+11)+1);}
      }
      li=li+1;
    }
    fi=fi+1;
  }
  let nm:[]u8="ABCD";
  fi=0;
  while(fi<4){
    let ob:[]u8=z_alloc(256);
    let at:i32=0;
    at=app(ob,at,"FAM ");
    at=app1(ob,at,nm[fi]);
    at=app(ob,at," runs=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+0)));
    at=app(ob,at," q=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+1)));
    at=app(ob,at," agree=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+2)));
    at=app(ob,at," det_fail=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+3)));
    at=app(ob,at," diag_fail=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+4)));
    at=app(ob,at," app_miss=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+5)));
    at=app(ob,at," uncl=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+6)));
    at=app(ob,at," sm_bad=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+7)));
    at=app(ob,at," p4_bad=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+8)));
    at=app(ob,at," r2=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+9)));
    at=app(ob,at," r2hit=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+10)));
    at=app(ob,at," r2miss=");
    at=app(ob,at,i32s(ia_get(acc,fi*12+11)));
    outl(ob[0..at]);
    fi=fi+1;
  }
  // P1-P5 verdicts
  let tdet:i32=ia_get(acc,3)+ia_get(acc,15)+ia_get(acc,27)+ia_get(acc,39);
  let tdg:i32=ia_get(acc,4)+ia_get(acc,16)+ia_get(acc,28)+ia_get(acc,40);
  let tr2t:i32=ia_get(acc,9)+ia_get(acc,21)+ia_get(acc,33)+ia_get(acc,45);
  let tr2h:i32=ia_get(acc,10)+ia_get(acc,22)+ia_get(acc,34)+ia_get(acc,46);
  let p4a:i32=ia_get(acc,8);
  let mA:i32=ia_get(acc,11);
  let mB:i32=ia_get(acc,23);
  let mC:i32=ia_get(acc,35);
  let mD:i32=ia_get(acc,47);
  let vb:[]u8=z_alloc(128);
  let at2:i32=0;
  at2=app(vb,at2,"P1 det_zero=");
  if(tdet==0){at2=app(vb,at2,"PASS");} else {at2=app(vb,at2,"FAIL");}
  at2=app(vb,at2," (");
  at2=app(vb,at2,i32s(tdet));
  at2=app(vb,at2,") P2 diag_zero=");
  if(tdg==0){at2=app(vb,at2,"PASS");} else {at2=app(vb,at2,"FAIL");}
  at2=app(vb,at2," (");
  at2=app(vb,at2,i32s(tdg));
  at2=app(vb,at2,")");
  outl(vb[0..at2]);
  let vb2:[]u8=z_alloc(128);
  at2=0;
  at2=app(vb2,at2,"P3 r2_agree=");
  if(tr2t==96 && tr2h==tr2t){at2=app(vb2,at2,"PASS");} else {at2=app(vb2,at2,"FAIL");}
  at2=app(vb2,at2," (");
  at2=app(vb2,at2,i32s(tr2h));
  at2=app(vb2,at2,"/");
  at2=app(vb2,at2,i32s(tr2t));
  at2=app(vb2,at2,") P4 famA_p4=");
  if(p4a==0 && ia_get(acc,0)==24){at2=app(vb2,at2,"PASS");} else {at2=app(vb2,at2,"FAIL");}
  at2=app(vb2,at2," (bad=");
  at2=app(vb2,at2,i32s(p4a));
  at2=app(vb2,at2,")");
  outl(vb2[0..at2]);
  let vb3:[]u8=z_alloc(160);
  at2=0;
  at2=app(vb3,at2,"P5 r2miss A=");
  at2=app(vb3,at2,i32s(mA));
  at2=app(vb3,at2," B=");
  at2=app(vb3,at2,i32s(mB));
  at2=app(vb3,at2," C=");
  at2=app(vb3,at2,i32s(mC));
  at2=app(vb3,at2," D=");
  at2=app(vb3,at2,i32s(mD));
  at2=app(vb3,at2," pred=");
  if(mB>=mA && mB>=mC && mB>=mD){at2=app(vb3,at2,"PASS");} else {at2=app(vb3,at2,"FAIL");}
  outl(vb3[0..at2]);
  return 0;
}

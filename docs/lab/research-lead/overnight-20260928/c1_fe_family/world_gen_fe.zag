// world_gen_fe.zag - pure-Zag F-E family generator (periodic-demo key ambiguity).
// Usage: world_gen_fe <seedfile> <worldidx> <outdir> <seedhash> E
// Family E only: exact revert kold -> 1 -> kold with a period-2 post-change demo.
// Writes <outdir>/turns.jsonl and <outdir>/key.json deterministically from the seed.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn atoi(s:[]u8)i32 {
  let i:i32=0;
  let neg:i32=0;
  if(s.len>0 && s[0]==45){neg=1;i=1;}
  let v:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  if(neg==1){v=-v;}
  return v;
}
fn read_file(path:[]u8)[]u8 {
  let b:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){b[k]=path[k];k=k+1;}
  b[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(b) as i64),0,0,0,0,0);
  z_free(b);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn write_file(path:[]u8,data:[]u8)void {
  let b:[]u8=z_alloc(path.len+1);
  let k:i32=0;
  while(k<path.len){b[k]=path[k];k=k+1;}
  b[path.len]=0;
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(b) as i64),577,420,0,0,0);
  z_free(b);
  if(fd>=0){
    let at:i32=0;
    while(at<data.len){
      let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(at as i64),(data.len-at) as i64,0,0,0);
      if(n<=0){at=data.len;}
      if(n>0){at=at+(n as i32);}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// xorshift64; st is 8 mutable bytes
fn r64(st:[]u8)i64 {
  let x:i64=(st[0] as i64)|((st[1] as i64)<<8)|((st[2] as i64)<<16)|((st[3] as i64)<<24)|((st[4] as i64)<<32)|((st[5] as i64)<<40)|((st[6] as i64)<<48)|((st[7] as i64)<<56);
  x=x^(x<<13);
  x=x^(x>>7);
  x=x^(x<<17);
  st[0]=(x as u8); st[1]=((x>>8) as u8); st[2]=((x>>16) as u8); st[3]=((x>>24) as u8);
  st[4]=((x>>32) as u8); st[5]=((x>>40) as u8); st[6]=((x>>48) as u8); st[7]=((x>>56) as u8);
  return x;
}
fn rnd(st:[]u8,n:i32)i32 {
  if(n<=1){return 0;}
  let x:i64=r64(st);
  if(x<0){x=-x;}
  return (x%(n as i64)) as i32;
}
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn emit_line(tb:[]u8,c:[]u8,line:[]u8)void {
  let at:i32=ld32(c,0);
  at=app(tb,at,line);
  tb[at]=10; at=at+1;
  st32(c,0,at);
  return;
}
fn next_turn(c:[]u8)i32 {
  let t:i32=ld32(c,12);
  st32(c,12,t+1);
  return t;
}
fn keyq(kb:[]u8,c:[]u8,qid:[]u8,ans:[]u8)void {
  let at:i32=ld32(c,4);
  if(ld32(c,16)==0){st32(c,16,1);} else {kb[at]=44;at=at+1;}
  at=app(kb,at,"\""); at=app(kb,at,qid); at=app(kb,at,"\":\""); at=app(kb,at,ans); at=app(kb,at,"\"");
  st32(c,4,at);
  return;
}
fn e_demo(tb:[]u8,c:[]u8,pr:[]u8,in:[]u8,out:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(192);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"demo\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\",\"in\":\""); n=app(b,n,in);
  n=app(b,n,"\",\"out\":\""); n=app(b,n,out); n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_law(tb:[]u8,c:[]u8,pr:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"law\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_noise(tb:[]u8,c:[]u8,st:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"obs\",\"ev\":{\"t\":\"noise\",\"pad\":\"");
  let i:i32=0;
  while(i<24){b[n]=(97+rnd(st,26)) as u8;n=n+1;i=i+1;}
  n=app(b,n,"\"}}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn e_query(tb:[]u8,kb:[]u8,c:[]u8,qid:[]u8,qbody:[]u8,ans:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(320);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"query\",\"qid\":\""); n=app(b,n,qid);
  n=app(b,n,"\",\"q\":"); n=app(b,n,qbody); n=app(b,n,"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  keyq(kb,c,qid,ans);
  return;
}
fn e_end(tb:[]u8,c:[]u8)void {
  let t:i32=next_turn(c);
  let b:[]u8=z_alloc(64);
  let n:i32=app(b,0,"{\"turn\":"); n=app(b,n,i32s(t));
  n=app(b,n,",\"kind\":\"end\"}");
  emit_line(tb,c,b[0..n]);
  z_free(b);
  return;
}
fn qb_proc(pr:[]u8,in:[]u8)[]u8 {
  let b:[]u8=z_alloc(96);
  let n:i32=app(b,0,"{\"t\":\"proc\",\"p\":\"");
  n=app(b,n,pr); n=app(b,n,"\",\"in\":\""); n=app(b,n,in); n=app(b,n,"\"}");
  return b[0..n];
}
fn wg_rev(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[s.len-1-i];i=i+1;}
  return b;
}
fn wg_rot(s:[]u8,k:i32)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[(i+k)%s.len];i=i+1;}
  return b;
}
// ---- attack world assembly ----
fn mkword(st:[]u8,lo:i32,rng:i32)[]u8 {
  let b:[]u8=z_alloc(4);
  let k:i32=0;
  while(k<4){b[k]=(lo+rnd(st,rng)) as u8;k=k+1;}
  return b[0..4];
}
fn main()i32 {
  let seedfile:[]u8=_zag_arg(1);
  let worldidx:i32=atoi(_zag_arg(2));
  let outdir:[]u8=_zag_arg(3);
  let seedhash:[]u8=_zag_arg(4);
  let fam:[]u8=_zag_arg(5);
  if(seedfile.len==0 || outdir.len==0 || seedhash.len==0 || fam.len==0){
    return 1;
  }
  let seed:[]u8=read_file(seedfile);
  if(seed.len<8){return 2;}
  let st:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<8){st[i]=seed[i];i=i+1;}
  // mix worldidx
  let w:i32=worldidx+1;
  i=0;
  while(i<8){
    let x:i32=st[i] as i32;
    let y:i32=(w*31+i*7)&255;
    st[i]=(x^y) as u8;
    i=i+1;
  }
  i=0;
  while(i<8){r64(st);i=i+1;}
  // law keys
  // law keys: F-E fixes k2=1 and draws kold from {2,3}
  let kold:i32=2+rnd(st,2);
  let k2:i32=1;
  // buffers
  let tb:[]u8=z_alloc(1048576);
  let kb:[]u8=z_alloc(65536);
  let cur:[]u8=z_alloc(24);
  // brief turn (turn 0)
  let bb:[]u8=z_alloc(192);
  let bn:i32=app(bb,0,"{\"turn\":0,\"kind\":\"brief\",\"world\":\"rv");
  bn=app(bb,bn,i32s(worldidx));
  bn=app(bb,bn,"\",\"seed_hash\":\"");
  bn=app(bb,bn,seedhash);
  bn=app(bb,bn,"\",\"family\":\"");
  bn=app(bb,bn,fam);
  bn=app(bb,bn,"\"}");
  st32(cur,0,bn+1);
  app(tb,0,bb[0..bn]);
  tb[bn]=10;
  z_free(bb);
  st32(cur,12,1);
  let pa:[]u8="pa";
  let pb:[]u8="pb";
  // setup: 3 demos of pa under reversal
  let d:i32=0;
  while(d<3){
    let inw:[]u8=mkword(st,97,13);
    let outw:[]u8=wg_rev(inw);
    e_demo(tb,cur,pa,inw,outw);
    z_free(inw); z_free(outw);
    d=d+1;
  }
  // setup: 3 demos of pb under kold
  d=0;
  while(d<3){
    let inw2:[]u8=mkword(st,97,13);
    let outw2:[]u8=wg_rot(inw2,kold);
    e_demo(tb,cur,pb,inw2,outw2);
    z_free(inw2); z_free(outw2);
    d=d+1;
  }
  // first law change: kold -> k2 (=1)
  e_law(tb,cur,pb);
  // F-E: demo 1 is period-2 [a,b,a,b] admitting keys {1,3}; demo 2 is normal.
  let p2a:i32=97+rnd(st,13);
  let p2b:i32=97+rnd(st,13);
  let inw_p2:[]u8=z_alloc(4);
  inw_p2[0]=p2a as u8; inw_p2[1]=p2b as u8; inw_p2[2]=p2a as u8; inw_p2[3]=p2b as u8;
  let out_p2:[]u8=wg_rot(inw_p2[0..4],k2);
  e_demo(tb,cur,pb,inw_p2[0..4],out_p2);
  z_free(inw_p2); z_free(out_p2);
  let inw3:[]u8=mkword(st,97,13);
  let outw3:[]u8=wg_rot(inw3,k2);
  e_demo(tb,cur,pb,inw3,outw3);
  z_free(inw3); z_free(outw3);
  let t1:[]u8=mkword(st,110,13);
  let o1:[]u8=wg_rot(t1,k2);
  let q1:[]u8=qb_proc(pb,t1);
  e_query(tb,kb,cur,"R1",q1,o1);
  z_free(t1); z_free(o1); z_free(q1);
  // second notice: exact revert k2 -> kold (F-E mirrors F-A)
  e_law(tb,cur,pb);
  let kfin:i32=kold;
  let nfin:i32=2;
  d=0;
  while(d<nfin){
    let inw4:[]u8=mkword(st,97,13);
    let outw4:[]u8=wg_rot(inw4,kfin);
    e_demo(tb,cur,pb,inw4,outw4);
    z_free(inw4); z_free(outw4);
    d=d+1;
  }
  let t2:[]u8=mkword(st,110,13);
  let o2:[]u8=wg_rot(t2,kfin);
  let q2:[]u8=qb_proc(pb,t2);
  e_query(tb,kb,cur,"R2",q2,o2);
  z_free(t2); z_free(o2); z_free(q2);
  // pa retention control
  let t3:[]u8=mkword(st,110,13);
  let o3:[]u8=wg_rev(t3);
  let q3:[]u8=qb_proc(pa,t3);
  e_query(tb,kb,cur,"R3",q3,o3);
  z_free(t3); z_free(o3); z_free(q3);
  e_end(tb,cur);
  // ---- assemble key.json ----
  let kat:i32=ld32(cur,4);
  let kf:[]u8=z_alloc(65536);
  let kn:i32=app(kf,0,"{\"seed_hash\":\"");
  kn=app(kf,kn,seedhash);
  kn=app(kf,kn,"\",\"world\":");
  kn=app(kf,kn,i32s(worldidx));
  kn=app(kf,kn,",\"family\":\"");
  kn=app(kf,kn,fam);
  kn=app(kf,kn,"\",\"true_graph\":0,\"kold\":");
  kn=app(kf,kn,i32s(kold));
  kn=app(kf,kn,",\"k2\":");
  kn=app(kf,kn,i32s(k2));
  kn=app(kf,kn,",\"kfin\":");
  kn=app(kf,kn,i32s(kfin));
  kn=app(kf,kn,",\"queries\":{");
  kn=app(kf,kn,kb[0..kat]);
  kn=app(kf,kn,"}}");
  write_file(pjoin(outdir,"turns.jsonl"),tb[0..ld32(cur,0)]);
  write_file(pjoin(outdir,"key.json"),kf[0..kn]);
  return 0;
}

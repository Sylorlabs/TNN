// cxbase.zag -- H-CAUSALEXP1 simple-baseline comparison (step 5 of 11).
// Pure Zag. No Python anywhere.
//
// Three baselines against H-CAUSALEXP1's max-split active loop. All share
// the frozen causal mechanics (predict, sim_seq, intervention semantics),
// the frozen passive phase, the frozen hypothesis store, the frozen
// elimination rule, and the frozen planner. Only world_step takes wid.
// The ONLY difference from H-CAUSALEXP1 is the experiment-selection
// policy (or its absence):
//   BL-RANDOM:   uniform random selection among the 42 candidates,
//                fixed seeds 7, 42, 999; round cap 4.
//   BL-FIXORDER: fixed script of length-1 actions 0..5 cycled, one per
//                step, max 12 steps; no adaptive selection.
//   BL-MEM:      lookup table mapping the passive-log pattern to a plan,
//                zero interventions.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ deterministic PRNG (LCG, fixed seeds) ============
fn lcg(st:i32)i32 {
  let t:i32=(st*1103515245)+12345;
  return (t&0x7fffffff);
}

// ============ hypothesis store ============
// 3 hypos x 16 bytes: +0 mask, +4 status (0 LIVE, 1 ELIMINATED),
// +8 ev_ok, +12 ev_total. Passive log: 6 eps x 20 bytes at 48:
// +0 sx, +4 sy, +8 a, +12 nx, +16 ny.
fn H_STRIDE()i32 { return 16; }
fn LOG_BASE()i32 { return 48; }
fn LOG_STRIDE()i32 { return 20; }
fn h_mask(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()); }
fn h_mask_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE(), v); return; }
fn h_st(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+4); }
fn h_st_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+4, v); return; }
fn h_ok(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+8); }
fn h_ok_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+8, v); return; }
fn h_tot(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+12); }
fn h_tot_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+12, v); return; }
fn log_set(W:[]u8,e:i32,f:i32,v:i32)void { set32(W, LOG_BASE()+e*LOG_STRIDE()+f*4, v); return; }
fn log_get(W:[]u8,e:i32,f:i32)i32 { return get32(W, LOG_BASE()+e*LOG_STRIDE()+f*4); }

fn emit_edges(mask:i32)void {
  if(mask==1){emit("X2Y");}
  else if(mask==2){emit("Y2X");}
  else {emit("NONE");}
  return;
}
fn emit_seq(a:i32,b:i32,len:i32)void {
  emit("[");
  e64(a);
  if(len>=2){emit(","); e64(b);}
  emit("]");
  return;
}

// ============ causal mechanics (shared by hypotheses and world) ============
// Actions: 0 idle, 1 trigger, 2 do(x:=0), 3 do(x:=1), 4 do(y:=0), 5 do(y:=1).
fn predict(mask:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  let nx:i32=x;
  let ny:i32=y;
  if(a==1){
    if((mask&2)==0){nx=1;}
    if((mask&1)==0){ny=1;}
    let k:i32=0;
    while(k<2){
      if((mask&1)!=0){ny=nx;}
      if((mask&2)!=0){nx=ny;}
      k=k+1;
    }
  } else if(a==2){
    nx=0;
    if((mask&1)!=0){ny=nx;}
  } else if(a==3){
    nx=1;
    if((mask&1)!=0){ny=nx;}
  } else if(a==4){
    ny=0;
    if((mask&2)!=0){nx=ny;}
  } else if(a==5){
    ny=1;
    if((mask&2)!=0){nx=ny;}
  }
  out[0]=nx as u8;
  out[1]=ny as u8;
  return;
}

// Simulate an action sequence of length len (1..3) under mask.
fn sim_seq(mask:i32, x:i32, y:i32, s0:i32, s1:i32, s2:i32, len:i32, out:[]u8)void {
  let cx:i32=x;
  let cy:i32=y;
  let tmp:[]u8=z_alloc(2);
  predict(mask, cx, cy, s0, tmp);
  cx=tmp[0] as i32; cy=tmp[1] as i32;
  if(len>=2){
    predict(mask, cx, cy, s1, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  if(len>=3){
    predict(mask, cx, cy, s2, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  out[0]=cx as u8;
  out[1]=cy as u8;
  return;
}

// ============ hidden true world: the ONLY wid-taking functions ============
fn true_mask(wid:i32)i32 {
  if(wid==2){return 2;}
  return 1;
}
fn world_step(wid:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  predict(true_mask(wid), x, y, a, out);
  return;
}

// ============ shared baseline machinery ============

// Frozen passive phase. out: [0]=sx, [1]=sy, [2..5]=hash(i32).
fn run_passive(W:[]u8, wid:i32, out:[]u8)void {
  let pscript:[]u8=z_alloc(6);
  pscript[0]=0; pscript[1]=1; pscript[2]=0; pscript[3]=1; pscript[4]=1; pscript[5]=0;
  let sx:i32=0;
  let sy:i32=0;
  let h:i32=0;
  let tmp:[]u8=z_alloc(2);
  let e:i32=0;
  while(e<6){
    let a:i32=pscript[e] as i32;
    world_step(wid, sx, sy, a, tmp);
    let nx:i32=tmp[0] as i32;
    let ny:i32=tmp[1] as i32;
    log_set(W,e,0,sx); log_set(W,e,1,sy); log_set(W,e,2,a);
    log_set(W,e,3,nx); log_set(W,e,4,ny);
    h=h*31+sx; h=h*31+sy; h=h*31+a; h=h*31+nx; h=h*31+ny;
    emit("PASSIVE ("); e64(sx); emit(","); e64(sy);
    emit(")|"); e64(a);
    emit(" -> ("); e64(nx); emit(","); e64(ny); emit(")\n");
    sx=nx; sy=ny;
    e=e+1;
  }
  out[0]=sx as u8;
  out[1]=sy as u8;
  set32(out, 2, h);
  return;
}

// Frozen hypothesis generation: all three DAG masks checked on the log.
fn gen_hypos(W:[]u8)void {
  let h:i32=0;
  while(h<3){
    let m:i32=0;
    if(h==0){m=1;}
    else if(h==1){m=2;}
    h_mask_set(W,h,m);
    let ok:i32=0;
    let q:[]u8=z_alloc(2);
    let k:i32=0;
    while(k<6){
      predict(m, log_get(W,k,0), log_get(W,k,1), log_get(W,k,2), q);
      if((q[0] as i32)==log_get(W,k,3) && (q[1] as i32)==log_get(W,k,4)){
        ok=ok+1;
      }
      k=k+1;
    }
    h_ok_set(W,h,ok);
    h_tot_set(W,h,6);
    if(ok==6){h_st_set(W,h,0);} else {h_st_set(W,h,1);}
    emit("HYPO id="); e64(h); emit(" edges=");
    emit_edges(m);
    emit(" status=");
    if(h_st(W,h)==0){emit("LIVE");} else {emit("ELIMINATED");}
    emit(" ev="); e64(ok); emit("/6\n");
    h=h+1;
  }
  return;
}

fn count_live(W:[]u8)i32 {
  let live:i32=0;
  let hc:i32=0;
  while(hc<3){
    if(h_st(W,hc)==0){live=live+1;}
    hc=hc+1;
  }
  return live;
}

// Distinct predicted final states among LIVE hypotheses (for reporting).
fn split_of(W:[]u8, sx:i32, sy:i32, a:i32, b:i32, len:i32)i32 {
  let p0x:i32=-1; let p0y:i32=-1;
  let p1x:i32=-1; let p1y:i32=-1;
  let p2x:i32=-1; let p2y:i32=-1;
  let n:i32=0;
  let hh:i32=0;
  while(hh<3){
    if(h_st(W,hh)==0){
      let qq:[]u8=z_alloc(2);
      sim_seq(h_mask(W,hh), sx, sy, a, b, 0, len, qq);
      if(n==0){p0x=qq[0] as i32; p0y=qq[1] as i32;}
      else if(n==1){p1x=qq[0] as i32; p1y=qq[1] as i32;}
      else {p2x=qq[0] as i32; p2y=qq[1] as i32;}
      n=n+1;
    }
    hh=hh+1;
  }
  let d:i32=1;
  if(n>=2 && (p1x!=p0x || p1y!=p0y)){d=2;}
  if(n>=3 && (p2x!=p0x || p2y!=p0y) && (p2x!=p1x || p2y!=p1y)){d=3;}
  return d;
}

// Execute seq in the true world. out: [0]=ex, [1]=ey.
fn exec_seq(wid:i32, sx:i32, sy:i32, a:i32, b:i32, len:i32, out:[]u8)void {
  let ex:i32=sx;
  let ey:i32=sy;
  let qe:[]u8=z_alloc(2);
  world_step(wid, ex, ey, a, qe);
  ex=qe[0] as i32; ey=qe[1] as i32;
  if(len==2){
    world_step(wid, ex, ey, b, qe);
    ex=qe[0] as i32; ey=qe[1] as i32;
  }
  out[0]=ex as u8;
  out[1]=ey as u8;
  return;
}

// Frozen elimination rule: eliminate exactly the LIVE hypotheses whose
// predicted final state mismatches the observed state.
fn eliminate(W:[]u8, sx:i32, sy:i32, a:i32, b:i32, len:i32, ex:i32, ey:i32)void {
  let he:i32=0;
  while(he<3){
    if(h_st(W,he)==0){
      let qm:[]u8=z_alloc(2);
      sim_seq(h_mask(W,he), sx, sy, a, b, 0, len, qm);
      let qx:i32=qm[0] as i32;
      let qy:i32=qm[1] as i32;
      if(qx!=ex || qy!=ey){
        h_st_set(W,he,1);
        emit("ELIM id="); e64(he);
        emit(" predicted=("); e64(qx); emit(","); e64(qy);
        emit(") observed=("); e64(ex); emit(","); e64(ey); emit(")\n");
      }
    }
    he=he+1;
  }
  return;
}

// Converged hypothesis id if exactly one LIVE, else -1.
fn converged_id(W:[]u8)i32 {
  let cid:i32=-1;
  let n:i32=0;
  let hf:i32=0;
  while(hf<3){
    if(h_st(W,hf)==0){cid=hf; n=n+1;}
    hf=hf+1;
  }
  if(n==1){return cid;}
  return -1;
}

// Frozen planner: BFS over action sequences length 1..3 under cmask from
// (1,1); shortest then lexicographic; goal (0,0). Execute in true world.
// out: [0]=plan_len, [1]=plan_a, [2]=plan_b, [3]=plan_c, [4]=plan_ok.
fn plan_and_exec(wid:i32, cmask:i32, out:[]u8)void {
  let plan_len:i32=0;
  let plan_a:i32=0;
  let plan_b:i32=0;
  let plan_c:i32=0;
  let found:i32=0;
  let pl:i32=1;
  while(pl<=3){
    let pa:i32=0;
    while(pa<6){
      let pb:i32=0;
      while(pb<6){
        let pc:i32=0;
        while(pc<6){
          let use:i32=0;
          if(pl==1 && pb==0 && pc==0){use=1;}
          if(pl==2 && pc==0){use=1;}
          if(pl==3){use=1;}
          if(use==1){
            let qp2:[]u8=z_alloc(2);
            sim_seq(cmask, 1, 1, pa, pb, pc, pl, qp2);
            if((qp2[0] as i32)==0 && (qp2[1] as i32)==0){
              if(found==0){
                plan_len=pl; plan_a=pa; plan_b=pb; plan_c=pc; found=1;
              }
            }
          }
          pc=pc+1;
        }
        pb=pb+1;
      }
      pa=pa+1;
    }
    pl=pl+1;
  }
  emit("PLAN seq=");
  emit_seq(plan_a, plan_b, plan_len);
  emit("\n");
  let px:i32=1;
  let py:i32=1;
  let qx2:[]u8=z_alloc(2);
  if(plan_len>=1){
    world_step(wid, px, py, plan_a, qx2);
    px=qx2[0] as i32; py=qx2[1] as i32;
  }
  if(plan_len>=2){
    world_step(wid, px, py, plan_b, qx2);
    px=qx2[0] as i32; py=qx2[1] as i32;
  }
  if(plan_len>=3){
    world_step(wid, px, py, plan_c, qx2);
    px=qx2[0] as i32; py=qx2[1] as i32;
  }
  emit("PLAN-EXEC -> ("); e64(px); emit(","); e64(py); emit(")\n");
  let ok:i32=0;
  if(px==0 && py==0){
    emit("PLAN-OK goal=(0,0)\n");
    ok=1;
  } else {
    emit("PLAN-FAIL\n");
  }
  out[0]=plan_len as u8;
  out[1]=plan_a as u8;
  out[2]=plan_b as u8;
  out[3]=plan_c as u8;
  out[4]=ok as u8;
  return;
}

// One SELECT/EXEC/ELIM step shared by BL-RANDOM and BL-FIXORDER.
// Returns 1 and sets nbuf[0]=1 if an intervention was executed, else 0.
fn do_step(W:[]u8, wid:i32, sx:i32, sy:i32, a:i32, b:i32, len:i32, st:[]u8)void {
  let d:i32=split_of(W, sx, sy, a, b, len);
  emit("SELECT seq="); emit_seq(a, b, len);
  emit(" split="); e64(d); emit("\n");
  let qe:[]u8=z_alloc(2);
  exec_seq(wid, sx, sy, a, b, len, qe);
  let ex:i32=qe[0] as i32;
  let ey:i32=qe[1] as i32;
  emit("EXEC seq="); emit_seq(a, b, len);
  emit(" -> ("); e64(ex); emit(","); e64(ey); emit(")\n");
  eliminate(W, sx, sy, a, b, len, ex, ey);
  st[0]=ex as u8;
  st[1]=ey as u8;
  return;
}

fn emit_summary(bname:[]u8, seed:i32, wid:i32, n_int:i32, cid:i32, plan_a:i32, plan_len:i32, plan_ok:i32)void {
  emit("SUMMARY baseline=");
  emit(bname);
  emit(" seed="); e64(seed);
  emit(" world="); e64(wid);
  emit(" n_int="); e64(n_int);
  emit(" conv_id="); e64(cid);
  emit(" plan_a="); e64(plan_a);
  emit(" plan_len="); e64(plan_len);
  emit(" plan_ok="); e64(plan_ok);
  emit("\n");
  return;
}

// ============ main ============
fn main()i32 {
  let W:[]u8=z_alloc(256);
  let wid:i32=0;
  let si:i32=0;

  // ---- BL-RANDOM: uniform random selection, frozen seeds ----
  let seeds:[]u8=z_alloc(3);
  seeds[0]=7; seeds[1]=42; seeds[2]=99;
  si=0;
  while(si<3){
    let seed:i32=seeds[si] as i32;
    if(si==2){seed=999;}
    emit("BASELINE BL-RANDOM SEED "); e64(seed); emit("\n");
    let st:i32=seed;
    wid=1;
    while(wid<=2){
      emit("WORLD "); e64(wid); emit("\n");
      let po:[]u8=z_alloc(8);
      run_passive(W, wid, po);
      gen_hypos(W);
      let sx:i32=po[0] as i32;
      let sy:i32=po[1] as i32;
      let n_int:i32=0;
      let round:i32=0;
      let go:i32=1;
      while(go==1){
        if(count_live(W)<=1){go=0;}
        if(round>=4){go=0;}
        if(go==0){break;}
        round=round+1;
        st=lcg(st);
        let pick:i32=st%42;
        let a:i32=pick/7;
        let b:i32=(pick%7)-1;
        let len:i32=1;
        if(b>=0){len=2;}
        let nst:[]u8=z_alloc(2);
        do_step(W, wid, sx, sy, a, b, len, nst);
        sx=nst[0] as i32; sy=nst[1] as i32;
        n_int=n_int+1;
      }
      let cid:i32=converged_id(W);
      let plan_a:i32=-1;
      let plan_len:i32=0;
      let plan_ok:i32=-1;
      if(cid>=0){
        emit("CONVERGED id="); e64(cid); emit(" edges=");
        emit_edges(h_mask(W,cid)); emit("\n");
        let plo:[]u8=z_alloc(8);
        plan_and_exec(wid, h_mask(W,cid), plo);
        plan_len=plo[0] as i32;
        plan_a=plo[1] as i32;
        plan_ok=plo[4] as i32;
      } else {
        emit("NO-CONVERGE live="); e64(count_live(W)); emit("\n");
        emit("PLAN-SKIP\n");
      }
      emit_summary("BL-RANDOM", seed, wid, n_int, cid, plan_a, plan_len, plan_ok);
      wid=wid+1;
    }
    si=si+1;
  }

  // ---- BL-FIXORDER: fixed script 0..5 cycled, max 12 steps ----
  emit("BASELINE BL-FIXORDER\n");
  wid=1;
  while(wid<=2){
    emit("WORLD "); e64(wid); emit("\n");
    let po2:[]u8=z_alloc(8);
    run_passive(W, wid, po2);
    gen_hypos(W);
    let sx2:i32=po2[0] as i32;
    let sy2:i32=po2[1] as i32;
    let n_int2:i32=0;
    let step:i32=0;
    let go2:i32=1;
    while(go2==1){
      if(count_live(W)<=1){go2=0;}
      if(step>=12){go2=0;}
      if(go2==0){break;}
      let a2:i32=step%6;
      let nst2:[]u8=z_alloc(2);
      do_step(W, wid, sx2, sy2, a2, -1, 1, nst2);
      sx2=nst2[0] as i32; sy2=nst2[1] as i32;
      n_int2=n_int2+1;
      step=step+1;
    }
    let cid2:i32=converged_id(W);
    let plan_a2:i32=-1;
    let plan_len2:i32=0;
    let plan_ok2:i32=-1;
    if(cid2>=0){
      emit("CONVERGED id="); e64(cid2); emit(" edges=");
      emit_edges(h_mask(W,cid2)); emit("\n");
      let plo2:[]u8=z_alloc(8);
      plan_and_exec(wid, h_mask(W,cid2), plo2);
      plan_len2=plo2[0] as i32;
      plan_a2=plo2[1] as i32;
      plan_ok2=plo2[4] as i32;
    } else {
      emit("NO-CONVERGE live="); e64(count_live(W)); emit("\n");
      emit("PLAN-SKIP\n");
    }
    emit_summary("BL-FIXORDER", 0, wid, n_int2, cid2, plan_a2, plan_len2, plan_ok2);
    wid=wid+1;
  }

  // ---- BL-MEM: lookup table from passive-log pattern to plan ----
  emit("BASELINE BL-MEM\n");
  emit("MEM-TABLE entries=1\n");
  wid=1;
  while(wid<=2){
    emit("WORLD "); e64(wid); emit("\n");
    let po3:[]u8=z_alloc(8);
    run_passive(W, wid, po3);
    let mh:i32=get32(po3, 2);
    emit("MEM-KEY hash="); e64(mh); emit("\n");
    wid=wid+1;
  }
  emit("MEM-LOOKUP passive-key -> plan=[2]\n");
  wid=1;
  while(wid<=2){
    let qm:[]u8=z_alloc(2);
    world_step(wid, 1, 1, 2, qm);
    let px:i32=qm[0] as i32;
    let py:i32=qm[1] as i32;
    emit("MEM-EXEC world="); e64(wid);
    emit(" [2] -> ("); e64(px); emit(","); e64(py); emit(")\n");
    let mok:i32=0;
    if(px==0 && py==0){
      emit("MEM-PLAN-OK\n");
      mok=1;
    } else {
      emit("MEM-PLAN-FAIL\n");
    }
    emit_summary("BL-MEM", 0, wid, 0, -1, 2, 1, mok);
    wid=wid+1;
  }

  return 0;
}

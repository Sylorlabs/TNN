// proclang1.zag -- H-PROCLANG1 implementation.
// Frozen prereg: docs/lab/research-lead/overnight-20260928/proclang_frontier/PREREG_PROCLANG1.md
// (committed in bd883d969; strict prereg-before-implementation ancestry verified).
//
// Learner: Phase A exhaustive search over frozen affine DSL D0
//   (ops ADD k / MUL k, k in -3..3, program length 0..3; NO conditional),
// inadequacy trigger (best D0 program still errs), Phase B generic
// threshold case-split over the input coordinate with operator reification
// into a persistent COND(t, leftProg, rightProg) operator library.
// Worlds (environment only; learner sees ONLY (x,y) pairs):
//   T1 y=|x|, T4 y=|x-3| (continuation/counterexample), T2 y=step(x),
//   T3 y=|1-u| with u=-x+1 (re-coordinatized surface).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- D0 program machinery ----
// Op index 0..6 = ADD (idx-3); 7..13 = MUL (idx-10).
fn eval_prog(ops:[]u8, len:i32, x:i32)i32 {
  let r:i32=x;
  let i:i32=0;
  while(i<len){
    let oi:i32=ops[i] as i32;
    if(oi<7){ r=r+(oi-3); } else { r=r*(oi-10); }
    i=i+1;
  }
  return r;
}
fn mismatches_rec(pl:[]u8, base:i32, len:i32, xs:[]u8, ys:[]u8, n:i32)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    if(eval_prog(pl[base+1..base+4], len, get32(xs,i*4))!=get32(ys,i*4)){ m=m+1; }
    i=i+1;
  }
  return m;
}
// Program list record: 4 bytes [len, op0, op1, op2].
fn build_proglist(pl:[]u8)i32 {
  let c:i32=0;
  pl[0]=0; pl[1]=255; pl[2]=255; pl[3]=255; c=1;
  let a:i32=0;
  while(a<14){
    let b4:i32=c*4;
    pl[b4]=1; pl[b4+1]=a as u8; pl[b4+2]=255; pl[b4+3]=255; c=c+1;
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let b4:i32=c*4;
      pl[b4]=2; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=255; c=c+1;
      b=b+1;
    }
    a=a+1;
  }
  a=0;
  while(a<14){
    let b:i32=0;
    while(b<14){
      let d:i32=0;
      while(d<14){
        let b4:i32=c*4;
        pl[b4]=3; pl[b4+1]=a as u8; pl[b4+2]=b as u8; pl[b4+3]=d as u8; c=c+1;
        d=d+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  return c;
}
// out: 4 bytes [len, op0, op1, op2]. Returns mismatches of best program.
// Deterministic: lengths ascending, op indices ascending, strict improvement.
fn fit_best(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32, out:[]u8)i32 {
  let best:i32=n+1;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    let m:i32=mismatches_rec(pl, base, len, xs, ys, n);
    if(m<best){
      best=m;
      out[0]=pl[base]; out[1]=pl[base+1]; out[2]=pl[base+2]; out[3]=pl[base+3];
    }
    pi=pi+1;
  }
  return best;
}
// Machine-checked affine lemma C0 over the enumerated space.
fn check_affine(pl:[]u8, pn:i32)i32 {
  let ok:i32=0;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    let fm1:i32=eval_prog(pl[base+1..base+4], len, -1);
    let f0:i32=eval_prog(pl[base+1..base+4], len, 0);
    let fp1:i32=eval_prog(pl[base+1..base+4], len, 1);
    if(fm1+fp1==2*f0){ ok=ok+1; }
    pi=pi+1;
  }
  return ok;
}
fn emit_prog(ops:[]u8, len:i32)void {
  if(len==0){ emit("ID"); return; }
  let i:i32=0;
  while(i<len){
    let oi:i32=ops[i] as i32;
    if(i>0){ emit(";"); }
    if(oi<7){ emit("ADD "); emit(i32s(oi-3)); } else { emit("MUL "); emit(i32s(oi-10)); }
    i=i+1;
  }
  return;
}

// ---- Phase B: threshold case-split + reification ----
// pbo: 12 bytes [t:i32, llen:u8, l0,l1,l2, rlen:u8, r0,r1,r2]. Returns min total.
fn phaseB(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32,
          lx:[]u8, ly:[]u8, rx:[]u8, ry:[]u8, tmp:[]u8, pbo:[]u8)i32 {
  let xmin:i32=get32(xs,0);
  let xmax:i32=xmin;
  let i:i32=1;
  while(i<n){
    let v:i32=get32(xs,i*4);
    if(v<xmin){ xmin=v; }
    if(v>xmax){ xmax=v; }
    i=i+1;
  }
  let best_tot:i32=n+1;
  let t:i32=xmin-1;
  while(t<=xmax+1){
    let nl:i32=0;
    let nr:i32=0;
    i=0;
    while(i<n){
      let x:i32=get32(xs,i*4);
      let y:i32=get32(ys,i*4);
      if(x<t){ set32(lx,nl*4,x); set32(ly,nl*4,y); nl=nl+1; }
      else { set32(rx,nr*4,x); set32(ry,nr*4,y); nr=nr+1; }
      i=i+1;
    }
    let ml:i32=fit_best(pl,pn,lx,ly,nl,tmp);
    let llen:i32=tmp[0] as i32;
    let sl0:i32=tmp[1] as i32;
    let sl1:i32=tmp[2] as i32;
    let sl2:i32=tmp[3] as i32;
    let mr:i32=fit_best(pl,pn,rx,ry,nr,tmp);
    let tot:i32=ml+mr;
    if(tot<best_tot){
      best_tot=tot;
      set32(pbo,0,t);
      pbo[4]=llen as u8; pbo[5]=sl0 as u8; pbo[6]=sl1 as u8; pbo[7]=sl2 as u8;
      pbo[8]=tmp[0]; pbo[9]=tmp[1]; pbo[10]=tmp[2]; pbo[11]=tmp[3];
    }
    t=t+1;
  }
  return best_tot;
}

// ---- Operator library (persistent learner state) ----
// lib_thr: 8*i32; lib_llen/lib_rlen/lib_task: 8 bytes; lib_lops/lib_rops: 8*3 bytes.
fn cond_eval(oi:i32, x:i32, lib_thr:[]u8, lib_llen:[]u8, lib_lops:[]u8,
             lib_rlen:[]u8, lib_rops:[]u8)i32 {
  let thr:i32=get32(lib_thr, oi*4);
  if(x<thr){ return eval_prog(lib_lops[oi*3..oi*3+3], lib_llen[oi] as i32, x); }
  return eval_prog(lib_rops[oi*3..oi*3+3], lib_rlen[oi] as i32, x);
}
fn mismatches_cond(oi:i32, xs:[]u8, ys:[]u8, n:i32,
                   lib_thr:[]u8, lib_llen:[]u8, lib_lops:[]u8,
                   lib_rlen:[]u8, lib_rops:[]u8)i32 {
  let m:i32=0;
  let i:i32=0;
  while(i<n){
    if(cond_eval(oi, get32(xs,i*4), lib_thr, lib_llen, lib_lops, lib_rlen, lib_rops)!=get32(ys,i*4)){ m=m+1; }
    i=i+1;
  }
  return m;
}

// ---- Worlds (environment; learner sees only pairs) ----
fn w_abs(x:i32)i32 { if(x<0){ return -x; } return x; }
fn w_abs3(x:i32)i32 { let d:i32=x-3; if(d<0){ return -d; } return d; }
fn w_step(x:i32)i32 { if(x<0){ return -1; } return 1; }
fn w_trans(u:i32)i32 { let d:i32=1-u; if(d<0){ return -d; } return d; }
fn fill_pairs(xs:[]u8, ys:[]u8, n:i32, x0:i32, world:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=x0+i;
    let y:i32=0;
    if(world==0){ y=w_abs(x); }
    else { if(world==1){ y=w_abs3(x); } else { if(world==2){ y=w_step(x); } else { y=w_trans(x); } } }
    set32(xs,i*4,x);
    set32(ys,i*4,y);
    i=i+1;
  }
  return;
}
// ---- A4: content-triviality analysis ----
fn side_check(pl:[]u8, pn:i32, xs:[]u8, ys:[]u8, n:i32, tag:[]u8)void {
  let tmp:[]u8=z_alloc(4);
  let m0:i32=fit_best(pl,pn,xs,ys,n,tmp);
  let rlen:i32=tmp[0] as i32;
  let refb:[]u8=z_alloc(3);
  refb[0]=tmp[1]; refb[1]=tmp[2]; refb[2]=tmp[3];
  let nfit:i32=0;
  let dis:i32=0;
  let pi:i32=0;
  while(pi<pn){
    let base:i32=pi*4;
    let len:i32=pl[base] as i32;
    if(mismatches_rec(pl, base, len, xs, ys, n)==0){
      nfit=nfit+1;
      let x:i32=-100;
      while(x<=100){
        if(eval_prog(pl[base+1..base+4], len, x)!=eval_prog(refb[0..3], rlen, x)){ dis=dis+1; }
        x=x+1;
      }
    }
    pi=pi+1;
  }
  emit("SIDE ");
  emit(tag);
  emit(" ref_mismatches=");
  emit(i32s(m0));
  emit(" nfit=");
  emit(i32s(nfit));
  emit(" probe_disagreements=");
  emit(i32s(dis));
  emit("\n");
  return;
}

// wout: 20 bytes [t:i32, llen:u8, l0,l1,l2, rlen:u8, r0,r1,r2, nl:i32, nr:i32]
fn scan_task(tid:i32, world:i32, tr0:i32, tr1:i32,
             pl:[]u8, pn:i32, tx:[]u8, ty:[]u8,
             lx:[]u8, ly:[]u8, rx:[]u8, ry:[]u8, tmp:[]u8, wout:[]u8)void {
  let tn:i32=tr1-tr0+1;
  fill_pairs(tx,ty,tn,tr0,world);
  emit("FORCETASK id=");
  emit(i32s(tid));
  emit("\n");
  let xmin:i32=get32(tx,0);
  let xmax:i32=xmin;
  let i:i32=1;
  while(i<tn){
    let v:i32=get32(tx,i*4);
    if(v<xmin){ xmin=v; }
    if(v>xmax){ xmax=v; }
    i=i+1;
  }
  let nt:i32=(xmax+1)-(xmin-1)+1;
  emit("CANDIDATES n_thresh=");
  emit(i32s(nt));
  emit(" progs=");
  emit(i32s(pn));
  emit(" triples=");
  emit(i32s(nt*pn*pn));
  emit("\n");
  let zc:i32=0;
  let wt:i32=0;
  let t:i32=xmin-1;
  while(t<=xmax+1){
    let nl:i32=0;
    let nr:i32=0;
    i=0;
    while(i<tn){
      let x:i32=get32(tx,i*4);
      let y:i32=get32(ty,i*4);
      if(x<t){ set32(lx,nl*4,x); set32(ly,nl*4,y); nl=nl+1; }
      else { set32(rx,nr*4,x); set32(ry,nr*4,y); nr=nr+1; }
      i=i+1;
    }
    let ml:i32=fit_best(pl,pn,lx,ly,nl,tmp);
    let sl0:i32=tmp[0] as i32;
    let sl1:i32=tmp[1] as i32;
    let sl2:i32=tmp[2] as i32;
    let sl3:i32=tmp[3] as i32;
    let mr:i32=fit_best(pl,pn,rx,ry,nr,tmp);
    if(ml+mr==0){
      zc=zc+1;
      wt=t;
      set32(wout,0,t);
      wout[4]=sl0 as u8; wout[5]=sl1 as u8; wout[6]=sl2 as u8; wout[7]=sl3 as u8;
      wout[8]=tmp[0]; wout[9]=tmp[1]; wout[10]=tmp[2]; wout[11]=tmp[3];
      set32(wout,12,nl);
      set32(wout,16,nr);
    }
    t=t+1;
  }
  emit("ZERO_TOTAL_THRESHOLDS n=");
  emit(i32s(zc));
  emit(" t=");
  emit(i32s(wt));
  emit(" left_n=");
  emit(i32s(get32(wout,12)));
  emit(" right_n=");
  emit(i32s(get32(wout,16)));
  emit("\n");
  let nl2:i32=0;
  let nr2:i32=0;
  i=0;
  while(i<tn){
    let x:i32=get32(tx,i*4);
    let y:i32=get32(ty,i*4);
    if(x<wt){ set32(lx,nl2*4,x); set32(ly,nl2*4,y); nl2=nl2+1; }
    else { set32(rx,nr2*4,x); set32(ry,nr2*4,y); nr2=nr2+1; }
    i=i+1;
  }
  side_check(pl,pn,lx,ly,nl2,"left");
  side_check(pl,pn,rx,ry,nr2,"right");
  return;
}

fn main()i32 {
  emit("# ADV A4: content triviality, forced-content analysis\n");
  let pl:[]u8=z_alloc(2955*4);
  let pn:i32=build_proglist(pl);
  let tx:[]u8=z_alloc(64*4);
  let ty:[]u8=z_alloc(64*4);
  let lx:[]u8=z_alloc(64*4);
  let ly:[]u8=z_alloc(64*4);
  let rx:[]u8=z_alloc(64*4);
  let ry:[]u8=z_alloc(64*4);
  let tmp:[]u8=z_alloc(4);
  let wout:[]u8=z_alloc(20);
  scan_task(1, 0, -20, 20, pl, pn, tx, ty, lx, ly, rx, ry, tmp, wout);
  scan_task(4, 1, -20, 20, pl, pn, tx, ty, lx, ly, rx, ry, tmp, wout);
  scan_task(2, 2, -20, 20, pl, pn, tx, ty, lx, ly, rx, ry, tmp, wout);
  scan_task(3, 3, -19, 21, pl, pn, tx, ty, lx, ly, rx, ry, tmp, wout);
  emit("DONE\n");
  return 0;
}

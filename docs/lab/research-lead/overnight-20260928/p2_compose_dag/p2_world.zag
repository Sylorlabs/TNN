// p2_world.zag -- COMPOSE-DAG lane: every literal in the lane lives here.
// Pure Zag. Data only. Goal records are constructed by shape primitives;
// NO topology vocabulary appears in this file or in any cognition source.
// The lane's PREREG maps each goal id to its structural reading.

fn p2_world(A:[]u8)void {
  set32(A,0,0);
  let i:i32=0;
  // r901: unit forward step, object 1000+i -> subject 1001+i
  while(i<20){
    fact_add(A,1001+i,901,1000+i);
    i=i+1;
  }
  // r902: unique subject 1000+i -> object 3000+i
  i=0;
  while(i<21){
    fact_add(A,1000+i,902,3000+i);
    i=i+1;
  }
  // r903: two-valued attribute, object ranges disjoint across blocks
  i=0;
  while(i<20){
    fact_add(A,1000+i,903,4000+i);
    fact_add(A,1000+i,903,5000+i);
    i=i+1;
  }
  i=0;
  while(i<6){
    fact_add(A,1100+i,903,6100+i);
    fact_add(A,1100+i,903,7100+i);
    i=i+1;
  }
  // r904: shared-object attribute (distinct-collapse probe)
  i=0;
  while(i<20){
    fact_add(A,1000+i,904,5000);
    i=i+1;
  }
  // r905: 26 subjects share object 7000
  i=0;
  while(i<20){
    fact_add(A,1000+i,905,7000);
    i=i+1;
  }
  i=0;
  while(i<6){
    fact_add(A,1100+i,905,7000);
    i=i+1;
  }
  // r906: 8 subjects, distinct objects
  i=0;
  while(i<8){
    fact_add(A,1000+i,906,9000+i);
    i=i+1;
  }
  // r911: 6 subjects share object 7000, disjoint subject block
  i=0;
  while(i<6){
    fact_add(A,1100+i,911,7000);
    i=i+1;
  }
  // r912: 20 subjects share object 7000
  i=0;
  while(i<20){
    fact_add(A,1000+i,912,7000);
    i=i+1;
  }
  // r913: 4 subjects, distinct objects (deliberately outside every index)
  i=0;
  while(i<4){
    fact_add(A,1200+i,913,7300+i);
    i=i+1;
  }
  return;
}
// ---- experience pattern tables (ids are ordinals, not literals) ----
fn p2_ret_pat(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,901); set32(rb,4,1000); return; }
  if(id==1){ set32(rb,0,901); set32(rb,4,1001); return; }
  if(id==2){ set32(rb,0,901); set32(rb,4,1010); return; }
  if(id==3){ set32(rb,0,902); set32(rb,4,3000); return; }
  if(id==4){ set32(rb,0,902); set32(rb,4,3001); return; }
  if(id==5){ set32(rb,0,903); set32(rb,4,4000); return; }
  if(id==6){ set32(rb,0,905); set32(rb,4,7000); return; }
  if(id==7){ set32(rb,0,906); set32(rb,4,9000); return; }
  if(id==8){ set32(rb,0,906); set32(rb,4,9001); return; }
  if(id==9){ set32(rb,0,911); set32(rb,4,7000); return; }
  set32(rb,0,912); set32(rb,4,7000); return;
}
fn p2_vfy_chain(C:[]u8,id:i32)void {
  chain_clear(C);
  if(id==0){ chain_add(C,1000,902,3000); return; }
  if(id==1){ chain_add(C,1001,902,3001); return; }
  if(id==2){ chain_add(C,1000,905,7000); return; }
  if(id==3){ chain_add(C,1100,905,7000); return; }
  if(id==4){ chain_add(C,1000,903,4000); return; }
  if(id==5){ chain_add(C,1002,903,4002); return; }
  chain_add(C,1000,912,7000); return;
}
fn p2_cnt_pat(id:i32,rb:[]u8)void {
  if(id==0){ set32(rb,0,903); set32(rb,4,1000); return; }
  if(id==1){ set32(rb,0,903); set32(rb,4,1001); return; }
  if(id==2){ set32(rb,0,902); set32(rb,4,1000); return; }
  set32(rb,0,905); set32(rb,4,1000); return;
}
// ---- goal-record primitives (generic; no literals) ----
fn gb(G:[]u8,tag:i32,nn:i32)i32 { set32(G,0,tag); set32(G,4,nn); return 8; }
fn gn(G:[]u8,off:i32,tag:i32,nf:i32)i32 { set32(G,off,tag); set32(G,off+4,nf); return off+8; }
fn gf(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn gl_n(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn gl(G:[]u8,off:i32,k:i32,dn:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,off,k); set32(G,off+4,dn); set32(G,off+8,0);
  set32(G,off+12,ds); set32(G,off+16,sn); set32(G,off+20,sk);
  set32(G,off+24,ss);
  return off+28;
}
// ---- goal builders --------------------------------------------------
// g901: 2 needs, 1 scalar link, second operand supplied by the first
fn g901(G:[]u8)void {
  let o:i32=gb(G,901,2);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
// g902: 3 needs, 2 scalar links
fn g902(G:[]u8)void {
  let o:i32=gb(G,902,3);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,1,1,1,0,1,0);
  o=gl(G,o,1,2,1,1,1,0);
  return;
}
// gseq(G,tag,d): d needs, d-1 scalar links, d>=2
fn gseq(G:[]u8,tag:i32,d:i32)void {
  let o:i32=gb(G,tag,d);
  let i:i32=0;
  while(i<d){
    o=gn(G,o,801,2);
    if(i==0){ o=gf(G,o,1000); } else { o=gf(G,o,0); }
    o=gf(G,o,0);
    i=i+1;
  }
  o=gl_n(G,o,d-1);
  i=1;
  while(i<d){
    o=gl(G,o,1,i,1,i-1,1,0);
    i=i+1;
  }
  return;
}
// g906: 3 needs, 2 sources, 2 aggregate links into 1 receiver
fn g906(G:[]u8)void {
  let o:i32=gb(G,906,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,906); o=gf(G,o,9000);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,3,2,0,0,1,0);
  o=gl(G,o,3,2,0,1,1,0);
  return;
}
// gbro(G,tag,k,a,b): 1 source, k receivers (1 set link each),
// 1 aggregate over the k receivers
fn gbro(G:[]u8,tag:i32,k:i32,a:i32,b:i32)void {
  let nn:i32=k+2;
  let o:i32=gb(G,tag,nn);
  o=gn(G,o,801,2); o=gf(G,o,a); o=gf(G,o,7000);
  let i:i32=0;
  while(i<k){
    o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,b+i);
    i=i+1;
  }
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,2*k);
  o=gl(G,o,2,1,0,0,1,0);
  i=1;
  while(i<k){
    o=gl(G,o,2,i,0,0,1,0);
    i=i+1;
  }
  o=gl(G,o,3,k+1,0,1,1,0);
  i=1;
  while(i<k){
    o=gl(G,o,3,k+1,0,i,1,0);
    i=i+1;
  }
  return;
}
// g909: 4 needs, 1 receiver with 2 set links, 1 aggregate over it
fn g909(G:[]u8)void {
  let o:i32=gb(G,909,4);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,911); o=gf(G,o,7000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,905); o=gf(G,o,7000);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,4);
  o=gl(G,o,2,2,0,0,1,0);
  o=gl(G,o,2,2,0,1,1,0);
  o=gl(G,o,3,3,0,2,1,0);
  return;
}
// g910: 2 needs, scalar link out of an empty producer
fn g910(G:[]u8)void {
  let o:i32=gb(G,910,2);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,9999);
  o=gn(G,o,801,2); o=gf(G,o,902); o=gf(G,o,3001);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
// g911: 2 needs, set link out of a scalar producer
fn g911(G:[]u8)void {
  let o:i32=gb(G,911,2);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,1005);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3005);
  o=gl_n(G,o,1);
  o=gl(G,o,2,1,0,0,1,0);
  return;
}
// g912: 10 needs, three set receivers over three roots, two aggregates
fn g912(G:[]u8)void {
  let o:i32=gb(G,912,10);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,902); o=gf(G,o,3000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3003);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3001);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,807,3); o=gf(G,o,902); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,8);
  o=gl(G,o,1,1,1,0,1,0);
  o=gl(G,o,1,2,1,1,1,0);
  o=gl(G,o,2,4,0,2,1,0);
  o=gl(G,o,2,5,0,3,1,0);
  o=gl(G,o,2,6,0,0,1,0);
  o=gl(G,o,3,7,0,4,1,0);
  o=gl(G,o,3,7,0,5,1,0);
  o=gl(G,o,3,9,0,8,1,0);
  return;
}
// g913: 6 needs, longest link path 3, one aggregate with 2 sources
fn g913(G:[]u8)void {
  let o:i32=gb(G,913,6);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gn(G,o,807,3); o=gf(G,o,902); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,5);
  o=gl(G,o,2,1,0,0,1,0);
  o=gl(G,o,2,2,0,1,1,0);
  o=gl(G,o,3,4,0,2,1,0);
  o=gl(G,o,3,4,0,3,1,0);
  o=gl(G,o,3,5,0,0,1,0);
  return;
}
// g914: 3 needs, 1 need of a free 3-field form
fn g914(G:[]u8)void {
  let o:i32=gb(G,914,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,803,3); o=gf(G,o,2); o=gf(G,o,0); o=gf(G,o,0);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,1,1,2,0,1,0);
  o=gl(G,o,3,2,0,0,1,0);
  return;
}
// g915: 3 needs, 1 free 3-field form with an unknown 2nd field
fn g915(G:[]u8)void {
  let o:i32=gb(G,915,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,906); o=gf(G,o,9000);
  o=gn(G,o,803,3); o=gf(G,o,903); o=gf(G,o,2); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,3,2,0,0,1,0);
  o=gl(G,o,3,2,0,1,1,0);
  return;
}
// g916: 1 need, 1 free 5-field form
fn g916(G:[]u8)void {
  let o:i32=gb(G,916,1);
  o=gn(G,o,804,5);
  o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0); o=gf(G,o,0);
  o=gl_n(G,o,0);
  return;
}
// g917: 3 needs, set link into a need with no set-shaped operand
fn g917(G:[]u8)void {
  let o:i32=gb(G,917,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,902); o=gf(G,o,0);
  o=gn(G,o,807,3); o=gf(G,o,903); o=gf(G,o,1); o=gf(G,o,0);
  o=gl_n(G,o,2);
  o=gl(G,o,2,1,0,0,1,0);
  o=gl(G,o,3,2,0,1,1,0);
  return;
}
// g918: 2 needs, one producer inside the learned index, one outside
fn g918(G:[]u8)void {
  let o:i32=gb(G,918,2);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,913); o=gf(G,o,0);
  o=gl_n(G,o,1);
  o=gl(G,o,1,1,1,0,1,0);
  return;
}
// g919: 3 needs, self link on need 1, set link from need 1 to need 2
fn g919(G:[]u8)void {
  let o:i32=gb(G,919,3);
  o=gn(G,o,801,2); o=gf(G,o,912); o=gf(G,o,7000);
  o=gn(G,o,801,2); o=gf(G,o,901); o=gf(G,o,1000);
  o=gn(G,o,802,4); o=gf(G,o,1); o=gf(G,o,0); o=gf(G,o,902); o=gf(G,o,3001);
  o=gl_n(G,o,2);
  o=gl(G,o,1,1,1,1,1,0);
  o=gl(G,o,2,2,0,1,1,0);

// r_main.zag -- ARM R driver: the re-dimensioned composer over the
// COMPOSE-DAG lane's world and goal records.
// Sections: A battery (admit arm), B battery (frozen-reading control),
// C adaptive-reuse probes, D baselines, E ablations, F summary.
// One `fn main`. No topology vocabulary; goals are referenced by id.

fn rec_line(B:[]u8,c:i32,a:[]u8,nn:i32)i32 {
  let pos:i32=0;
  let idx:i32=0;
  while(idx<nn){
    let nr:i32=get32(a,4+pos*4);
    c=o_app(B,c," ");
    c=o_i64(B,c,idx as i64);
    c=o_i64(B,c,nr as i64);
    c=o_i64(B,c,rec_sum(a,pos) as i64);
    pos=pos+1+nr;
    idx=idx+1;
  }
  return c;
}
fn ord_line(B:[]u8,c:i32,L:[]u8)i32 {
  let pb:[]u8=z_alloc(4*(12+NM()*12)+16);
  plan_get_first(L,pb);
  let n:i32=get32(pb,8);
  let p:i32=0;
  while(p<n){
    c=o_app(B,c," ");
    c=o_i64(B,c,get32(pb,12+p*12) as i64);
    p=p+1;
  }
  return c;
}
fn q2(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,admit:i32,tag:[]u8)i32 {
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let ra:[]u8=z_alloc(4096);
  let rb:[]u8=z_alloc(4096);
  let nn:i32=g_nneeds(G);
  clear_plans(L);
  set32(K,0,0);
  let r1:i32=compose(L,A,G,K,ans,vb,admit);
  let d1:i32=ans_dig(ans);
  let k1:i32=get32(K,0);
  let p1:i32=get32(vb,20);
  let pb:i32=get32(L,13224);
  let pl:i32=get32(L,13228);
  let tr:i32=get32(L,13232);
  let dc:i32=get32(L,13236);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," r1=");
  c=o_i64(B,c,r1 as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,d1 as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,k1 as i64);
  c=o_app(B,c," pa=");
  c=o_i64(B,c,p1 as i64);
  c=o_app(B,c," pb=");
  c=o_i64(B,c,pb as i64);
  c=o_app(B,c," pl=");
  c=o_i64(B,c,pl as i64);
  c=o_app(B,c," tr=");
  c=o_i64(B,c,tr as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,dc as i64);
  c=o_app(B,c," ord=");
  c=ord_line(B,c,L);
  c=o_app(B,c," vec=");
  c=rec_line(B,c,ans,nn);
  set32(K,0,0);
  let ok0:i32=ref_eval(A,G,K,ra,0);
  set32(K,0,0);
  let ok1:i32=ref_eval(A,G,K,rb,1);
  let ds:i32=0;
  if(ok0==1){ ds=ans_dig(ra); }
  let da:i32=0;
  if(ok1==1){ da=ans_dig(rb); }
  let eq:i32=0;
  if(r1!=0){
    if(admit==0){ if(ok0==1){ eq=ans_eq(ans,ra); } }
    if(admit==1){ if(ok1==1){ eq=ans_eq(ans,rb); } }
  }
  c=o_app(B,c," refs=");
  c=o_i64(B,c,ok0 as i64);
  c=o_i64(B,c,ds as i64);
  c=o_app(B,c," refa=");
  c=o_i64(B,c,ok1 as i64);
  c=o_i64(B,c,da as i64);
  c=o_app(B,c," eq=");
  c=o_i64(B,c,eq as i64);
  if(ok0==1){ c=o_app(B,c," vs="); c=rec_line(B,c,ra,nn); }
  if(ok1==1){ c=o_app(B,c," va="); c=rec_line(B,c,rb,nn); }
  c=o_nl(B,c);
  return c;
}
fn learn(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,Cb:[]u8,tout:[]u8)i32 {
  let sn:[]u8=z_alloc(SNN());
  let i:i32=0;
  while(i<11){
    p2_ret_pat(i,rb);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    i=i+1;
  }
  specialize_ret(L,A,0,10);
  i=0;
  while(i<7){
    p2_vfy_chain(Cb,i);
    vfy_episode(L,A,Cb,K);
    i=i+1;
  }
  specialize_vfy(L,A,11,17);
  i=0;
  while(i<4){
    p2_cnt_pat(i,rb);
    cnt_episode(L,A,get32(rb,0),get32(rb,4),K,tout,sn);
    i=i+1;
  }
  specialize_cnt(L,A,18,21);
  c=o_app(B,c,"LEARN retrel=");
  c=o_i64(B,c,get32(L,0) as i64);
  c=o_app(B,c," vfyrel=");
  c=o_i64(B,c,get32(L,4248) as i64);
  c=o_app(B,c," cntrel=");
  c=o_i64(B,c,get32(L,8496) as i64);
  c=o_app(B,c," facts=");
  c=o_i64(B,c,get32(A,0) as i64);
  c=o_app(B,c," lsize=");
  c=o_i64(B,c,l_size() as i64);
  c=o_nl(B,c);
  return c;
}
// ---- adaptive-reuse probe -------------------------------------
// one call: build-or-load a plan, report the canonical vector
fn one(B:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,id:i32,admit:i32,tag:[]u8)i32 {
  let ans:[]u8=z_alloc(4096);
  let vb:[]u8=z_alloc(64);
  let nn:i32=g_nneeds(G);
  set32(K,0,0);
  let r:i32=compose(L,A,G,K,ans,vb,admit);
  c=o_app(B,c,tag);
  c=o_app(B,c," id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_app(B,c," pa=");
  c=o_i64(B,c,get32(vb,20) as i64);
  c=o_app(B,c," pb=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," pl=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," tr=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," vec=");
  c=rec_line(B,c,ans,nn);
  c=o_nl(B,c);
  return c;
}
// ---- B0 memo baseline ----------------------------------------------
fn memo_run(B:[]u8,c:i32,M:[]u8,A:[]u8,K:[]u8,L:[]u8,G:[]u8,id:i32)i32 {
  let gt:i32=g_tag(G);
  let slot:i32=memo_find(M,gt);
  set32(K,0,0);
  if(slot>=0){
    let out:[]u8=z_alloc(1024);
    memo_get(M,slot,out);
    c=o_app(B,c,"MEMO id=");
    c=o_i64(B,c,id as i64);
    c=o_app(B,c," hit=1 dig=");
    c=o_i64(B,c,ans_dig(out) as i64);
    c=o_app(B,c," k=");
    c=o_i64(B,c,get32(K,0) as i64);
    c=o_nl(B,c);
    return c;
  }
  let ans:[]u8=z_alloc(1024);
  let vb:[]u8=z_alloc(64);
  clear_plans(L);
  let r:i32=compose(L,A,G,K,ans,vb,1);
  let ms:i32=memo_free(M);
  if(ms>=0){ memo_put(M,ms,gt,ans); }
  c=o_app(B,c,"MEMO id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," hit=0 r=");
  c=o_i64(B,c,r as i64);
  c=o_app(B,c," dig=");
  c=o_i64(B,c,ans_dig(ans) as i64);
  c=o_app(B,c," k=");
  c=o_i64(B,c,get32(K,0) as i64);
  c=o_nl(B,c);
  return c;
}
fn memo_free(M:[]u8)i32 {
  let i:i32=0;
  while(i<12){
    if(get32(M,i*260)==0){ return i; }
    i=i+1;
  }
  return -1;
}
// ---- B1 exhaustive baseline -----------------------------------------
fn fact_small(n:i32)i32 {
  let f:i32=1;
  let i:i32=2;
  while(i<=n){ f=f*i; i=i+1; }
  return f;
}
fn perm_unrank(n:i32,code:i32,out:[]u8,used:[]u8)void {
  let i:i32=0;
  while(i<n){ set32(used,i*4,1); i=i+1; }
  let c:i32=code;
  let pos:i32=0;
  let f:i32=fact_small(n-1);
  while(pos<n){
    let k:i32=0;
    if(f>0){ k=c/f; }
    let cnt:i32=0;
    let pick:i32=0;
    let j:i32=0;
    while(j<n){
      if(get32(used,j*4)==1){
        if(cnt==k){ pick=j; }
        cnt=cnt+1;
      }
      j=j+1;
    }
    set32(out,pos*4,pick);
    set32(used,pick*4,0);
    c=c-k*f;
    if(f>0){ f=f/(n-pos); }
    pos=pos+1;
  }
  return;
}
fn exh_run(A:[]u8,G:[]u8,K:[]u8,L0:[]u8,order:[]u8,fams:[]u8,ans:[]u8,W:[]u8,OUTS:[]u8,SUBL:[]u8,C:[]u8,seen:[]u8,ver:[]u8)void {
  let nn:i32=g_nneeds(G);
  mat_inputs(G,W);
  let n:i32=0;
  while(n<nn){ set32(OUTS,n*160,0); n=n+1; }
  let d:[]u8=z_alloc(32);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(order,p*4);
    shape_desc(G,ni,d);
    let af:i32=get32(fams,ni*4);
    let want:i32=d_fam(d);
    if(d_acc(d)==1){ if(af==want){ exec_need(L0,A,G,ni,af,K,W,OUTS,SUBL,C,seen,ver); } }
    p=p+1;
  }
  set32(ans,0,0);
  let q:i32=0;
  while(q<nn){
    let nr:i32=get32(OUTS,q*160);
    let c:i32=get32(ans,0);
    set32(ans,4+c*4,nr);
    set32(ans,0,c+1);
    let k:i32=0;
    while(k<nr){
      let c2:i32=get32(ans,0);
      set32(ans,4+c2*4,get32(OUTS,q*160+4+k*4));
      set32(ans,0,c2+1);
      k=k+1;
    }
    q=q+1;
  }
  return;
}
fn exh(B:[]u8,c:i32,A:[]u8,K:[]u8,G:[]u8,id:i32,cap:i32,target:i32)i32 {
  let nn:i32=g_nneeds(G);
  let L0:[]u8=z_alloc(l_size());
  let order:[]u8=z_alloc(NM()*4+8);
  let fams:[]u8=z_alloc(NM()*4+8);
  let ans:[]u8=z_alloc(1024);
  let W:[]u8=z_alloc(NM()*80+16);
  let OUTS:[]u8=z_alloc(NM()*160+16);
  let SUBL:[]u8=z_alloc(NM()*STK()+16);
  let C:[]u8=z_alloc(CHN());
  let seen:[]u8=z_alloc(SNN());
  let ver:[]u8=z_alloc(8);
  let used:[]u8=z_alloc(NM()+16);
  let np:i32=fact_small(nn);
  let nf:i32=1;
  let i:i32=0;
  while(i<nn){ nf=nf*3; i=i+1; }
  let total:i64=(np as i64)*(nf as i64);
  let cl:i64=cap as i64;
  c=o_app(B,c,"EXH id=");
  c=o_i64(B,c,id as i64);
  c=o_app(B,c," nn=");
  c=o_i64(B,c,nn as i64);
  c=o_app(B,c," space=");
  c=o_i64(B,c,total);
  c=o_app(B,c," cap=");
  c=o_i64(B,c,cl);
  let limit:i64=cap as i64;
  let complete:i32=0;
  if(total<cl){ limit=total; complete=1; }
  let tries:i32=0;
  let found:i32=0;
  let t:i64=0;
  while(t<limit){
    let ti:i32=t as i32;
      let pcode:i32=ti%np;
      let fcode:i32=(ti/np)%nf;
      perm_unrank(nn,pcode,order,used);
      let j:i32=0;
      while(j<nn){
        let v:i32=fcode%3;
        set32(fams,j*4,v);
        fcode=fcode/3;
        j=j+1;
      }
      set32(K,0,0);
      exh_run(A,G,K,L0,order,fams,ans,W,OUTS,SUBL,C,seen,ver);
      tries=tries+1;
    if(ans_dig(ans)==target){ found=1; }
    t=t+1;
  }
  c=o_app(B,c," tries=");
  c=o_i64(B,c,tries as i64);
  c=o_app(B,c," complete=");
  c=o_i64(B,c,complete as i64);
  c=o_app(B,c," found=");
  c=o_i64(B,c,found as i64);
  c=o_nl(B,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(l_size()+4096);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(4096);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let M:[]u8=z_alloc(3200);
  p2_world(A);
  c=learn(B,c,L,A,K,rb,Cb,tout);
  c=o_app(B,c,"== SEC-A admit=1 ==");   c=o_nl(B,c);
  g901(G);        c=q2(B,c,L,A,K,G,1,1,"A");
  g902(G);        c=q2(B,c,L,A,K,G,2,1,"A");
  g906(G);        c=q2(B,c,L,A,K,G,6,1,"A");
  gbro(G,907,3,912,3000);  c=q2(B,c,L,A,K,G,7,1,"A");
  gbro(G,908,2,912,3000);  c=q2(B,c,L,A,K,G,8,1,"A");
  g909(G);        c=q2(B,c,L,A,K,G,9,1,"A");
  g910(G);        c=q2(B,c,L,A,K,G,10,1,"A");
  g911(G);        c=q2(B,c,L,A,K,G,11,1,"A");
  g912(G);        c=q2(B,c,L,A,K,G,12,1,"A");
  g913(G);        c=q2(B,c,L,A,K,G,13,1,"A");
  g914(G);        c=q2(B,c,L,A,K,G,14,1,"A");
  g915(G);        c=q2(B,c,L,A,K,G,15,1,"A");
  g916(G);        c=q2(B,c,L,A,K,G,16,1,"A");
  g917(G);        c=q2(B,c,L,A,K,G,17,1,"A");
  g918(G);        c=q2(B,c,L,A,K,G,18,1,"A");
  g919(G);        c=q2(B,c,L,A,K,G,19,1,"A");
  gseq(G,920,2);  c=q2(B,c,L,A,K,G,20,1,"A");
  gseq(G,921,3);  c=q2(B,c,L,A,K,G,21,1,"A");
  gseq(G,922,5);  c=q2(B,c,L,A,K,G,22,1,"A");
  gseq(G,923,10); c=q2(B,c,L,A,K,G,23,1,"A");
  gseq(G,924,20); c=q2(B,c,L,A,K,G,24,1,"A");
  c=o_app(B,c,"== SEC-B admission-off ablation ==");   c=o_nl(B,c);
  g901(G);        c=q2(B,c,L,A,K,G,1,0,"B");
  g909(G);        c=q2(B,c,L,A,K,G,9,0,"B");
  g910(G);        c=q2(B,c,L,A,K,G,10,0,"B");
  g911(G);        c=q2(B,c,L,A,K,G,11,0,"B");
  g917(G);        c=q2(B,c,L,A,K,G,17,0,"B");
  c=o_app(B,c,"== SEC-C adaptive reuse ==");   c=o_nl(B,c);
  clear_plans(L);
  g901(G);   c=one(B,c,L,A,K,G,101,1,"C1-build");
  g901(G);   c=one(B,c,L,A,K,G,102,1,"C1-load");
  g902(G);   c=one(B,c,L,A,K,G,103,1,"C4-substitute");
  clear_plans(L);
  g920a(G);  c=one(B,c,L,A,K,G,104,1,"C4-same-tag-a");
  g920a(G);  c=one(B,c,L,A,K,G,105,1,"C4-same-tag-a-again");
  g920b(G);  c=one(B,c,L,A,K,G,106,1,"C4-same-tag-b");
  g920c(G);  c=one(B,c,L,A,K,G,107,1,"C4-same-tag-c");
  g920c(G);  c=one(B,c,L,A,K,G,108,1,"C4-same-tag-c-again");
  clear_plans(L);
  g912t(G);  c=one(B,c,L,A,K,G,109,1,"C2-build-6");
  g912(G);   c=one(B,c,L,A,K,G,110,1,"C2-extend-10");
  g912(G);   c=one(B,c,L,A,K,G,111,1,"C2-extend-10-again");
  g912t(G);  c=one(B,c,L,A,K,G,112,1,"C3-truncate-6");
  clear_plans(L);
  g912(G);   c=one(B,c,L,A,K,G,113,1,"C0-build-10");
  g912(G);   c=one(B,c,L,A,K,G,114,1,"C0-load-10");
  plan_drop(L,912);
  g912(G);   c=one(B,c,L,A,K,G,115,1,"C7-drop-rebuild");
  c=o_app(B,c,"== SEC-D1 memo baseline ==");   c=o_nl(B,c);
  clear_plans(L);
  let i:i32=0;
  while(i<12){ set32(M,i*260,0); i=i+1; }
  g901(G);   c=memo_run(B,c,M,A,K,L,G,201);
  g901(G);   c=memo_run(B,c,M,A,K,L,G,202);
  g920a(G);  c=memo_run(B,c,M,A,K,L,G,203);
  g920a(G);  c=memo_run(B,c,M,A,K,L,G,204);
  g920b(G);  c=memo_run(B,c,M,A,K,L,G,205);
  g920b(G);  c=one(B,c,L,A,K,G,206,1,"D1-composer-920b");
  g902(G);   c=memo_run(B,c,M,A,K,L,G,207);
  g902(G);   c=one(B,c,L,A,K,G,208,1,"D1-composer-902");
  c=o_app(B,c,"== SEC-D2 exhaustive baseline ==");   c=o_nl(B,c);
  g901(G);        c=exh(B,c,A,K,G,301,40000,4007);
  g902(G);        c=exh(B,c,A,K,G,302,40000,6012);
  gbro(G,908,2,912,3000);  c=exh(B,c,A,K,G,303,40000,45241);
  gseq(G,922,5);  c=exh(B,c,A,K,G,304,40000,10025);
  g913(G);        c=exh(B,c,A,K,G,305,40000,48265);
  g912(G);        c=exh(B,c,A,K,G,306,40000,56282);
  c=o_app(B,c,"== SEC-D3 generic-only baseline (warm vs linear) ==");   c=o_nl(B,c);
  g906(G);        c=one(B,c,L,A,K,G,401,1,"D3-warm-6");
  gbro(G,907,3,912,3000);  c=one(B,c,L,A,K,G,402,1,"D3-warm-7");
  gbro(G,908,2,912,3000);  c=one(B,c,L,A,K,G,403,1,"D3-warm-8");
  g912(G);        c=one(B,c,L,A,K,G,404,1,"D3-warm-12");
  g913(G);        c=one(B,c,L,A,K,G,405,1,"D3-warm-13");
  gseq(G,924,20); c=one(B,c,L,A,K,G,406,1,"D3-warm-24");
  ret_cov_clear(L);
  vfy_cov_clear(L);
  cnt_cov_clear(L);
  g906(G);        c=one(B,c,L,A,K,G,411,1,"D3-lin-6");
  gbro(G,907,3,912,3000);  c=one(B,c,L,A,K,G,412,1,"D3-lin-7");
  gbro(G,908,2,912,3000);  c=one(B,c,L,A,K,G,413,1,"D3-lin-8");
  g912(G);        c=one(B,c,L,A,K,G,414,1,"D3-lin-12");
  g913(G);        c=one(B,c,L,A,K,G,415,1,"D3-lin-13");
  gseq(G,924,20); c=one(B,c,L,A,K,G,416,1,"D3-lin-24");
  c=learn(B,c,L,A,K,rb,Cb,tout);
  c=o_app(B,c,"== SEC-E ablations on goal 12 ==");   c=o_nl(B,c);
  clear_plans(L);
  g912(G);  c=one(B,c,L,A,K,G,501,1,"E0-build");
  g912(G);  c=one(B,c,L,A,K,G,502,1,"E0-load");
  let pi:i32=plan_find(L,912,gsig(G));
  let p0:i32=plan_pos(L,pi,0);
  let p5:i32=plan_pos(L,pi,5);
  let f0:i32=plan_fam(L,pi,p0);
  let f5:i32=plan_fam(L,pi,p5);
  plan_set_fam(L,pi,p0,-1);
  g912(G);  c=one(B,c,L,A,K,G,503,1,"E1-lesion-step0");
  plan_set_fam(L,pi,p0,f0);
  plan_set_fam(L,pi,p5,-1);
  g912(G);  c=one(B,c,L,A,K,G,504,1,"E2-lesion-step5");
  plan_set_fam(L,pi,p5,f5);
  g912(G);  c=one(B,c,L,A,K,G,505,1,"E2b-restore");
  ret_cov_clear(L);
  vfy_cov_clear(L);
  cnt_cov_clear(L);
  g912(G);  c=one(B,c,L,A,K,G,506,1,"E3-no-index");
  plan_set_fam(L,pi,p0,-1);
  g912(G);  c=one(B,c,L,A,K,G,507,1,"E4-no-index-plus-lesion");
  plan_set_fam(L,pi,p0,f0);
  c=learn(B,c,L,A,K,rb,Cb,tout);
  g912(G);  c=one(B,c,L,A,K,G,508,1,"E5-restore-index");
  let L2:[]u8=z_alloc(l_size()+4096);
  g912(G);  c=one(B,c,L2,A,K,G,509,1,"E6-fresh-learner");
  let bi:i32=bind_find(L,801);
  let bf:i32=bind_fam(L,bi);
  set32(L,bind_off(bi)+4,-1);
  plan_drop(L,912);
  g912(G);  c=one(B,c,L,A,K,G,510,1,"E7-binding-lesion");
  set32(L,bind_off(bi)+4,bf);
  g912(G);  c=one(B,c,L,A,K,G,511,1,"E8-binding-restore");
  c=o_app(B,c,"ARMSUM pb=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," pl=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," tr=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," dc=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,13252) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,13256) as i64);
  c=o_app(B,c," vs=");
  c=o_i64(B,c,get32(L,13260) as i64);
  c=o_app(B,c," vg=");
  c=o_i64(B,c,get32(L,13264) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,13268) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,13272) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// driver.zag -- STUBBLE L2-L3 truncate experiment driver.
// Arms, kill-bar evaluation. The driver teaches X/Y, runs the
// learner's construct, and evaluates Z. It never invents the
// intermediate: all construction goes through learner.zag.
// Prereg: l2_l3_trunc/PREREG.md (commit fc2417e3c). Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,14,1); y_teach(st,15,1); y_teach(st,13,1);
  y_teach(st,11,0); y_teach(st,8,0); y_teach(st,10,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,152));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_old(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<2){
    w_oldseq(i,sq);
    let id:i32=w_oldid(i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-OLD id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    let k:i32=0;
    while(k<6){
      at=ob_i32(ob,at,(sq[k] as i32));
      if(k<5){at=ob_app(ob,at,",");}
      k=k+1;
    }
    at=ob_nl(ob,at);
    i=i+1;
  }
  // Frozen timing: x_learn_len is consolidated once, after phase-0.
  // It is not re-run after phase-1 (see PREREG.md section 2).
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_phase(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<8){
    w_seq(1,i,sq);
    let id:i32=w_id(1,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),0,0,4);
    let lb:i32=w_true((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    lab_teach(st,id,lb);
    at=ob_app(ob,at,"X-TEACH id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    let k:i32=0;
    while(k<4){
      at=ob_i32(ob,at,(sq[k] as i32));
      if(k<3){at=ob_app(ob,at,",");}
      k=k+1;
    }
    at=ob_app(ob,at," label=");
    at=ob_i32(ob,at,lb);
    at=ob_nl(ob,at);
    i=i+1;
  }
  // No x_learn_len re-run here (frozen). L stays 6: X is too long.
  at=ob_app(ob,at,"L-STILL ");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_test(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_seq(2,i,sq);
    let id:i32=w_id(2,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),0,0,4);
    at=ob_app(ob,at,"X-TEST id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[156] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[157] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[158] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,160));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[164+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_adapt_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_app(ob,at," trunc=");
  at=ob_i32(ob,at,get32(st,252));
  at=ob_app(ob,at," calls=");
  at=ob_i32(ob,at,get32(st,256));
  at=ob_nl(ob,at);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let nr:i32=x_recall(st,id,sq);
    let tl:i32=-2;
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(nr>0){
      tl=w_true((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      let mn:i32=st[156] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[164+k];k=k+1;}
        sv=p_exec(mp,mn,sq,nr,rg);
      }
      at=ob_app(ob,at," seq=");
      let k:i32=0;
      while(k<nr){
        at=ob_i32(ob,at,(sq[k] as i32));
        if(k<nr-1){at=ob_app(ob,at,",");}
        k=k+1;
      }
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(6);
  let vals:[]u8=z_alloc(32);
  let atp:[]u8=z_alloc(4);
  at=ob_app(ob,at,"L2L3-TRUNC-START\n");

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let eidsT:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<4){eidsT[i]=(i+9) as u8;i=i+1;}

  // ================= ARM-FULL =================
  at=ob_app(ob,at,"=== ARM-FULL ===\n");
  let st1:[]u8=z_alloc(1024);
  st1[5]=1;
  at=d_y_prior(st1,ob,at);
  at=d_teach_old(st1,ob,at);
  at=d_teach_phase(st1,ob,at);
  at=d_teach_test(st1,ob,at);
  i=0;
  while(i<8){
    let id:i32=i+1;
    eids1[i]=id as u8;
    labs1[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  at=ob_app(ob,at,"--- construct M (fresh) ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st1,eids1,labs1,8,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn1:i32=get32(mout,0);
  let mt1:i32=get32(mout,4);
  let ms1:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn1);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt1);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms1);
  at=ob_app(ob,at,"/8\n");
  m_write(st1,mn1,1,mt1,mbuf);
  set32(st1,152,mt1);
  at=ob_app(ob,at,"T-AGREE y=");
  at=ob_i32(ob,at,get32(st1,152));
  at=ob_app(ob,at," m=");
  at=ob_i32(ob,at,get32(st1,160));
  at=ob_nl(ob,at);
  at=d_m_dump(st1,"M-STATE",ob,at);
  set32(atp,0,at);
  let zfull:i32=d_z_run(st1,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FULL ");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st1,"ADAPT-STAT-FULL",ob,at);

  // ================= ARM-L2-ONLY =================
  at=ob_app(ob,at,"=== ARM-L2-ONLY ===\n");
  let st2:[]u8=z_alloc(1024);
  st2[5]=1;
  at=d_y_prior(st2,ob,at);
  at=d_teach_old(st2,ob,at);
  at=d_teach_phase(st2,ob,at);
  at=d_teach_test(st2,ob,at);
  at=d_m_dump(st2,"M-STATE",ob,at);
  set32(atp,0,at);
  let zl2:i32=d_z_run(st2,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-L2ONLY ");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st2,"ADAPT-STAT-L2ONLY",ob,at);

  // ================= ARM-L3-ONLY =================
  at=ob_app(ob,at,"=== ARM-L3-ONLY ===\n");
  let st3:[]u8=z_alloc(1024);
  st3[5]=0;
  at=d_y_prior(st3,ob,at);
  at=d_teach_old(st3,ob,at);
  at=d_teach_phase(st3,ob,at);
  at=d_teach_test(st3,ob,at);
  i=0;
  while(i<8){
    let id:i32=i+1;
    labs1[i]=lab_get(st3,id) as u8;
    i=i+1;
  }
  at=ob_app(ob,at,"--- construct M (fresh, no adaptation) ---\n");
  let mbuf3:[]u8=z_alloc(24);
  let mout3:[]u8=z_alloc(12);
  at=construct(st3,eids1,labs1,8,init,0,rg,sq,vals,mbuf3,mout3,ob,at);
  let mn3:i32=get32(mout3,0);
  let ms3:i32=get32(mout3,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn3);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms3);
  at=ob_app(ob,at,"/8\n");
  at=d_m_dump(st3,"M-STATE",ob,at);
  set32(atp,0,at);
  let zl3:i32=d_z_run(st3,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-L3ONLY ");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st3,"ADAPT-STAT-L3ONLY",ob,at);

  // ================= ARM-FRESH =================
  at=ob_app(ob,at,"=== ARM-FRESH ===\n");
  let st4:[]u8=z_alloc(1024);
  set32(atp,0,at);
  let zfr:i32=d_z_run(st4,eidsT,4,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FRESH ");
  at=ob_i32(ob,at,zfr);
  at=ob_app(ob,at,"/4\n");

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let tr1:i32=get32(st1,252);
  let tr2:i32=get32(st2,252);
  let tr3:i32=get32(st3,252);
  let k1:i32=0;
  if(zl2==0){if(zl3==0){if(zfull==4){k1=1;}}}
  at=ob_app(ob,at,"K-CB-1 both-required l2only=");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at," l3only=");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at," full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  let k2:i32=0;
  if(zl2==0){if(tr2>=1){k2=1;}}
  at=ob_app(ob,at,"K-CB-2 l2-only-fails z=");
  at=ob_i32(ob,at,zl2);
  at=ob_app(ob,at," trunc=");
  at=ob_i32(ob,at,tr2);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k2);
  at=ob_nl(ob,at);
  let k3:i32=0;
  if(zl3==0){if(tr3==0){if(mn3==0){k3=1;}}}
  at=ob_app(ob,at,"K-CB-3 l3-only-fails z=");
  at=ob_i32(ob,at,zl3);
  at=ob_app(ob,at," trunc=");
  at=ob_i32(ob,at,tr3);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,mn3);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(zfull==4){
    if(tr1>=1){
      if(mn1==2){
        if((st1[164] as i32)==0){
          if((st1[165] as i32)==0){
            if((st1[166] as i32)==1){
              if((st1[167] as i32)==1){
                if((st1[168] as i32)==0){
                  if((st1[169] as i32)==2){k4=1;}
                }
              }
            }
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-CB-4 combined-provenance z=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," trunc=");
  at=ob_i32(ob,at,tr1);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,mn1);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-CB-5 grep-audit see-shell (frozen patterns, learner.zag)\n");
  at=ob_app(ob,at,"K-CB-6 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"L2L3-TRUNC-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

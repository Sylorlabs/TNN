// ir_driver.zag -- Hypothesis 2 experiment driver.
//
// Fragment recombination: X is a 4-link r1 chain, Y is a 4-link r2 chain,
// taught independently and never together. Goal Z is a 6-link mixed chain
// ([1,1,1,2,2,2]), BEYOND trial depth (k=4), so neither trial nor whole-MAP
// chaining can solve it. The Z facts are shaped so that NO whole MAP's full
// relation sequence is satisfiable: MAP_A=[1,1,1,1] fails at its 4th link
// (needs r1 from 34, but 34 has r2), MAP_B=[2,2,2,2] fails at its 1st link.
// But proper sub-chain FRAGMENTS (A,0,3)=[1,1,1] and (B,0,3)=[2,2,2] chain
// to the solution. The Z query uses fresh relation 63: no task label,
// no paired examples, no hint, no mention of X or Y.
//
// Arms: TREAT (X+Y -> Z -> Z' reuse), ABL-X (X deleted -> Z must fail),
// ABL-Y (Y deleted -> Z must fail), FRESH (no X/Y -> Z must fail).
// A second binary with frag_on()=0 runs TREAT as the mechanism control
// (whole-MAP-only must FAIL on Z).

// ---- instrumentation ----
fn ir_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried=");
  e64(t/1024);
  emit(" rejected=");
  e64(t-(t/1024)*1024);
  emit("\n");
  return;
}
fn ir_count14(W:[]u8)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn ir_count_maps(W:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn ir_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn ir_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=ir_relseq(W,m,seq,7);
  emit("MAP ");
  e64(m);
  emit(" relseq=[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    e64(get32(seq,i*4));
    i=i+1;
  }
  emit("]\n");
  return;
}
// White-box: decode fragment triples packed into Z MAP fields 12/16/32.
fn ir_print_zfrags(W:[]u8,zm:i32)void {
  if(zm<0){emit("ZMAP none\n"); return;}
  let nfrag:i32=ng(W,zm,12);
  emit("ZFRAG nfrag=");
  e64(nfrag);
  emit(" f16=");
  e64(ng(W,zm,16));
  emit(" f32=");
  e64(ng(W,zm,32));
  emit("\n");
  let packed:i32=ng(W,zm,16);
  let f1:i32=packed-(packed/65536)*65536;
  let f2:i32=packed/65536;
  emit("  frag1 m=");
  e64(f1/64);
  emit(" s=");
  e64((f1-(f1/64)*64)/8);
  emit(" l=");
  e64(f1-(f1/8)*8);
  emit("\n");
  if(nfrag>1){
    emit("  frag2 m=");
    e64(f2/64);
    emit(" s=");
    e64((f2-(f2/64)*64)/8);
    emit(" l=");
    e64(f2-(f2/8)*8);
    emit("\n");
  }
  if(nfrag>2){
    let f3:i32=ng(W,zm,32);
    emit("  frag3 m=");
    e64(f3/64);
    emit(" s=");
    e64((f3-(f3/64)*64)/8);
    emit(" l=");
    e64(f3-(f3/8)*8);
    emit("\n");
  }
  return;
}
fn ir_del_map_sr(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn ir_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  LINK14 ");
      e64(eg(W,e,0));
      emit(" -> ");
      e64(eg(W,e,8));
      emit("\n");
    }
    e=e+1;
  }
  return;
}
fn ir_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// X: 4-link r1 chain. Y: 4-link r2 chain. Never shown together.
fn ir_trainXY(W:[]u8)void {
  ev_teach(W,11,1,12);
  ev_teach(W,12,1,13);
  ev_teach(W,13,1,14);
  ev_teach(W,14,1,15);
  let x:i32=ev_query(W,11,61,15,0);
  emit("X ans=");
  e64(x);
  ir_tstat(W);
  ev_teach(W,21,2,22);
  ev_teach(W,22,2,23);
  ev_teach(W,23,2,24);
  ev_teach(W,24,2,25);
  let y:i32=ev_query(W,21,62,25,0);
  emit("Y ans=");
  e64(y);
  ir_tstat(W);
  emit("maps=");
  e64(ir_count_maps(W));
  emit("\n");
  ir_print_relseq(W,ir_find_map(W,11,61));
  ir_print_relseq(W,ir_find_map(W,21,62));
  return;
}
fn ir_zfacts(W:[]u8)void {
  ev_teach(W,31,1,32);
  ev_teach(W,32,1,33);
  ev_teach(W,33,1,34);
  ev_teach(W,34,2,35);
  ev_teach(W,35,2,36);
  ev_teach(W,36,2,37);
  return;
}
fn ir_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,63,37,0);
  emit("Z ans=");
  e64(z);
  ir_tstat(W);
  let zm:i32=ir_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit(" link14=");
  e64(ir_count14(W));
  emit("\n");
  if(zm>=0){ir_print_relseq(W,zm);}
  ir_print_zfrags(W,zm);
  ir_dump14(W);
  return;
}
// Z' reuse: fresh subject, same mixed shape. Are the fragments reusable?
fn ir_zreuse(W:[]u8)void {
  ev_teach(W,41,1,42);
  ev_teach(W,42,1,43);
  ev_teach(W,43,1,44);
  ev_teach(W,44,2,45);
  ev_teach(W,45,2,46);
  ev_teach(W,46,2,47);
  let z2:i32=ev_query(W,41,63,47,0);
  emit("Z2 ans=");
  e64(z2);
  ir_tstat(W);
  emit("maps=");
  e64(ir_count_maps(W));
  emit(" link14=");
  e64(ir_count14(W));
  emit("\n");
  return;
}
fn ir_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  ir_trainXY(W);
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  ir_zreuse(W);
  return;
}
fn ir_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  ir_trainXY(W);
  ir_del_map_sr(W,11,61);
  emit("maps after del=");
  e64(ir_count_maps(W));
  emit("\n");
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
fn ir_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  ir_trainXY(W);
  ir_del_map_sr(W,21,62);
  emit("maps after del=");
  e64(ir_count_maps(W));
  emit("\n");
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
fn ir_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
fn ir_treat_only(W:[]u8)void {
  emit("=== TREAT (whole-MAP-only control) ===\n");
  ir_trainXY(W);
  ir_gap(W);
  ir_zfacts(W);
  ir_zquery(W);
  return;
}
fn main()i32 {
  emit("FRAG-RECOMB-START\n");
  emit("frag_on=");
  e64(frag_on());
  emit("\n");
  if(frag_on()==1){
    let W1:[]u8=z_alloc(110656);
    tnn2_init(W1);
    ir_treat(W1);
    let W2:[]u8=z_alloc(110656);
    tnn2_init(W2);
    ir_ablx(W2);
    let W3:[]u8=z_alloc(110656);
    tnn2_init(W3);
    ir_ably(W3);
    let W4:[]u8=z_alloc(110656);
    tnn2_init(W4);
    ir_fresh(W4);
  } else {
    let W0:[]u8=z_alloc(110656);
    tnn2_init(W0);
    ir_treat_only(W0);
  }
  emit("FRAG-RECOMB-END\n");
  return 0;
}

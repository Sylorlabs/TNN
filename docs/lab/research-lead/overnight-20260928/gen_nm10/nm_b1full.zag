// uc_base.zag -- shared base for the compose-collapse battery.
// Fact store, probe_kind, behaviors (WALK/COUNT/MAYBE/IDENT), MAP table,
// kind-contract observations, teaching, world setups, output helpers.
// Pure Zag. No Python.
//
// Output rule (mandatory): dynamic content is formatted into ONE preallocated
// buffer with cursor-returning helpers, then a single _zag_raw_syscall write.
// _zag_print is never used for dynamic content.
//
// Arena layout (bytes) -- DYNAMIC, parameterized by NM (structure count).
// NM is stored at 772 (4 bytes; the fact store ends at 772). Every region
// base at or after the MAP table is an affine function of NM. NM=4
// reproduces the frozen offsets exactly (tries=936, m2g=968, V=1024,
// tried1=2304, t2c=3328, nv=3588, vs=3596, done=3660).
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s,r,o as little-endian i32)
//   772: NM
//   776: MAP table, NM maps * 10 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 rel2, 3 inmask, 4 outmask,
//                5 in_node, 6 in_num, 7 out_node, 8 out_num, 9 nobs
//   776+NM*40: tries   +4: found   +8: ans
//   +12: class list, NM * 4 bytes (vestigial; unused by any code path)
//   +NM*4: nclass
//   +4: m2g table, NM maps * 3 fields * 4 bytes
//   max(1024, m2g_end): V pool, 64 * 4 bytes
//   +256: K kinds, 64 * 4   +256: P provenance, 64 * 3 * 4
//   +768: tried1, NM * 64 * 4 bytes
//   +NM*256: tried2 count (4 bytes); +4: tried2 entries, 64 * 4 bytes
//   +256: nv   +4: widened flag   +4: visit stack, 64 bytes
//   +64: done set, 64 bytes
// Classes: 0=WALK, 1=COUNT, 2=MAYBE, 3=IDENT.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access ----
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,776+m*40+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,776+m*40+f*4,v); return; }
// Dynamic scratch-region accessors. NM is the structure count stored at
// arena offset 772 by world_new_nm. Every region after the MAP table is
// placed by exact size chaining, so regions are pairwise disjoint for any
// NM >= 1. At NM=4 every accessor reproduces the frozen offset.
fn r_nm(A:[]u8)i32 { return get32(A,772); }
fn r_tries(A:[]u8)i32 { return 776+r_nm(A)*40; }
fn r_found(A:[]u8)i32 { return 776+r_nm(A)*40+4; }
fn r_ans(A:[]u8)i32 { return 776+r_nm(A)*40+8; }
fn r_clb(A:[]u8)i32 { return 776+r_nm(A)*40+12; }
fn r_ncl(A:[]u8)i32 { return r_clb(A)+r_nm(A)*4; }
fn r_m2g(A:[]u8)i32 { return r_ncl(A)+4; }
fn r_vp_nm(nm:i32)i32 { let e:i32 = 776+nm*40+12+nm*4+4+nm*12; if(e<1024) { return 1024; } return e; }
fn r_vp(A:[]u8)i32 { return r_vp_nm(r_nm(A)); }
fn r_kp(A:[]u8)i32 { return r_vp(A)+256; }
fn r_pv(A:[]u8)i32 { return r_kp(A)+256; }
fn r_t1(A:[]u8)i32 { return r_pv(A)+768; }
fn r_t2c(A:[]u8)i32 { return r_t1(A)+r_nm(A)*256; }
fn r_t2e(A:[]u8)i32 { return r_t2c(A)+4; }
fn r_nv(A:[]u8)i32 { return r_t2e(A)+256; }
fn r_wid(A:[]u8)i32 { return r_nv(A)+4; }
fn r_vs(A:[]u8)i32 { return r_wid(A)+4; }
fn r_dn(A:[]u8)i32 { return r_vs(A)+64; }
fn r_size_nm(nm:i32)i32 { return r_vp_nm(nm)+1280+nm*256+396; }
fn world_new_nm(nm:i32)[]u8 { let A:[]u8 = z_alloc(r_size_nm(nm)); set32(A,772,nm); return A; }
// ---- facts ----
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn is_subject(A:[]u8,v:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
fn pkind(A:[]u8,v:i32)i32 {
  if(is_subject(A,v)==1){ return 1; }
  return 2;
}
// ---- behaviors ----
fn walkf(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=ag(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      let fs0:i32=get32(A,4+i*12);
      let fr0:i32=get32(A,4+i*12+4);
      if(fs0==cur && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
fn exec_map(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=mg(A,m,0);
  let r1:i32=mg(A,m,1);
  if(cl==0){ return walkf(A,s,r1); }
  if(cl==1){ return count_rel(A,s,r1); }
  if(cl==3){ return s; }
  if(cl==4){ return -2; }
  let r2:i32=mg(A,m,2);
  let e:i32=walkf(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=count_rel(A,e,r2);
  if(c==-2){ return e; }
  return c;
}
// ---- contract observations ----
fn observe(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=pkind(A,inv);
  let ok:i32=pkind(A,outv);
  if(ik==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(ik==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(ok==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ok==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,3,mg(A,m,3)|(1<<(ik-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ok-1)));
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=exec_map(A,m,s);
  if(v==exp){ observe(A,m,s,v); }
  return;
}
fn map_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  mp(A,m,0,cl); mp(A,m,1,r1); mp(A,m,2,r2);
  return;
}
// ---- H1 majority signatures (n>=2 finalize; avg>=1.5 -> NUM) ----
fn maj_kind(node_n:i32,num_n:i32,n:i32)i32 {
  if(n<2){ return 0; }
  if(2*(node_n+2*num_n)>=3*n){ return 2; }
  return 1;
}
fn h1_maj_in(A:[]u8,m:i32)i32 { return maj_kind(mg(A,m,5),mg(A,m,6),mg(A,m,9)); }
fn h1_maj_out(A:[]u8,m:i32)i32 { return maj_kind(mg(A,m,7),mg(A,m,8),mg(A,m,9)); }
// ---- world setups (frozen in PREREG Section 5) ----
fn setup_p1(A:[]u8)void {
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,101); fact_add(A,34,82,102);
  fact_add(A,51,81,52); fact_add(A,52,81,53);
  fact_add(A,53,82,111); fact_add(A,53,82,112); fact_add(A,53,82,113);
  fact_add(A,41,81,42); fact_add(A,42,81,43);
  fact_add(A,63,83,64); fact_add(A,64,83,65);
  fact_add(A,73,83,74); fact_add(A,74,83,75);
  fact_add(A,43,84,1); fact_add(A,65,84,1); fact_add(A,75,84,1);
  fact_add(A,61,81,62); fact_add(A,62,81,63);
  map_new(A,0,2,81,82);
  map_new(A,1,0,83,0);
  teach(A,0,31,2); teach(A,0,51,3); teach(A,0,41,43);
  teach(A,1,63,65); teach(A,1,73,75);
  return;
}
fn setup_p2a(A:[]u8)void {
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,101); fact_add(A,34,82,102);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,82,45); fact_add(A,44,82,46);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,31,34); teach(A,1,34,2); teach(A,2,31,31); teach(A,3,31,1);
  return;
}
fn setup_p2b(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,31,81,32);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,82,45); fact_add(A,44,82,46);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,1,70,2); teach(A,2,31,31); teach(A,3,31,1);
  return;
}
fn setup_p3(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14); fact_add(A,14,82,141);
  fact_add(A,15,81,16); fact_add(A,16,81,17); fact_add(A,17,81,18);
  fact_add(A,18,82,181); fact_add(A,18,82,182);
  fact_add(A,50,82,51); fact_add(A,50,82,52); fact_add(A,50,82,53);
  fact_add(A,60,82,61); fact_add(A,60,82,62); fact_add(A,60,82,63); fact_add(A,60,82,64);
  fact_add(A,21,81,22);
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,35); fact_add(A,34,82,36);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,0,15,18);
  teach(A,1,50,3); teach(A,1,60,4);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,11,1); teach(A,3,15,1);
  return;
}
fn setup_p5extra(A:[]u8)void {
  fact_add(A,51,81,52); fact_add(A,52,81,53);
  fact_add(A,53,82,54); fact_add(A,53,82,55); fact_add(A,53,82,56);
  return;
}

// ---- PAIR6 additions (frozen PREREG Sec 7 allowlist) ----
// Second-input contract table at r_m2g(A): NM maps x 3 fields x 4 bytes.
// fields: 0 inmask2, 1 in2_node, 2 in2_num. Untouched by U's code paths.
fn m2g(A:[]u8,m:i32,f:i32)i32 { return get32(A,r_m2g(A)+m*12+f*4); }
fn m2p(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,r_m2g(A)+m*12+f*4,v); return; }
// class 4 = ADD2: generic 2-input addition (PREREG boundary B1).
// -2 propagates: the failure sentinel is never a valid addend here.
fn exec_map2(A:[]u8,m:i32,s1:i32,s2:i32)i32 {
  let cl:i32=mg(A,m,0);
  if(cl==4){
    if(s1==-2){ return -2; }
    if(s2==-2){ return -2; }
    return s1+s2;
  }
  return -2;
}
// 2-input contract observation: (inmask1, inmask2, outmask).
fn observe2(A:[]u8,m:i32,in1:i32,in2:i32,outv:i32)void {
  let k1:i32=pkind(A,in1);
  let k2:i32=pkind(A,in2);
  let ko:i32=pkind(A,outv);
  mp(A,m,3,mg(A,m,3)|(1<<(k1-1)));
  m2p(A,m,0,m2g(A,m,0)|(1<<(k2-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ko-1)));
  if(k1==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(k1==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(k2==1){ m2p(A,m,1,m2g(A,m,1)+1); }
  if(k2==2){ m2p(A,m,2,m2g(A,m,2)+1); }
  if(ko==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ko==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach2(A:[]u8,m:i32,s1:i32,s2:i32,exp:i32)void {
  let v:i32=exec_map2(A,m,s1,s2);
  if(v==exp){ observe2(A,m,s1,s2,v); }
  return;
}
// ---- diamond worlds (frozen PREREG Sec 3) ----
// Z(w) = G(Y(X(w)), W(X(w))): worker -> team -> (pending, done) -> total.
fn setup_dfacts(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,202,91,211);
  fact_add(A,203,91,212); fact_add(A,204,91,212);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  fact_add(A,212,92,904); fact_add(A,212,92,905);
  fact_add(A,211,94,911); fact_add(A,211,94,912);
  fact_add(A,212,94,913);
  return;
}
fn setup_dmaps(A:[]u8)void {
  map_new(A,0,0,91,0);
  map_new(A,1,1,92,0);
  map_new(A,2,1,94,0);
  map_new(A,3,4,0,0);
  return;
}
fn setup_dteach(A:[]u8)void {
  teach(A,0,201,211); teach(A,0,203,212);
  teach(A,1,211,3); teach(A,1,212,2);
  teach(A,2,211,2); teach(A,2,212,1);
  return;
}
fn setup_d1(A:[]u8)void {
  setup_dfacts(A); setup_dmaps(A); setup_dteach(A);
  teach2(A,3,3,2,5); teach2(A,3,2,1,3);
  return;
}
fn setup_d2(A:[]u8)void {
  setup_dfacts(A); setup_dmaps(A); setup_dteach(A);
  teach2(A,3,211,212,423);
  return;
}
// d6_gen.zag -- GEN: value-graph generalization of U (frozen PREREG Sec 4).
// Iterated n-ary application over a value pool. Preserves U's principles:
// kind-set contracts, compatibility admission (k_has, empty = compatible),
// deterministic ordered trial, end-to-end verification (result == expected),
// failure-triggered widening (admission-off phase, WIDEN=1 once),
// success-recording with contract growth (via provenance closure).
// Generalizes: trial space {singles, ordered pairs} -> value graph;
// pair handshake (outmask INTERSECTS inmask, a prediction) -> observed-kind
// checking (stage 1 executes; stage 2 tests the observed value's kind).
// outmask remains learned contract state (census-visible, grown by recording)
// but does not gate pool expansion. No modes, no flags, no shape templates,
// no domain handlers, no diamond-specific code.
// GEN scratch (arena r_vp(A)..r_dn(A)+64; zeroed by world_new_nm; untouched by U):
//   r_vp(A): V pool, 64 x 4 bytes            r_kp(A): K kinds, 64 x 4
//   r_pv(A): P provenance, 64 x 3 x 4       r_t1(A): tried1, 4 x 64 x 4 bytes
//   r_t2c(A): tried2 count; r_t2e(A): entries, 64 x 4
//   r_nv(A): nv   r_wid(A): widened flag        r_vs(A): visit stack, 64 x 1 byte
//   r_dn(A): done set, 64 x 1 byte (ends 3724 < 4096; u8-packed because the
//   i32 layout overflowed the arena by 12 bytes, found in testing)
fn gvb(A:[]u8,off:i32)i32 { return A[off] as i32; }
fn svb(A:[]u8,off:i32,v:i32)void { A[off]=v as u8; return; }
fn g_khas(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn gV(A:[]u8,i:i32)i32 { return get32(A,r_vp(A)+i*4); }
fn gK(A:[]u8,i:i32)i32 { return get32(A,r_kp(A)+i*4); }
fn gP(A:[]u8,i:i32,f:i32)i32 { return get32(A,r_pv(A)+(i*3+f)*4); }
fn gnv(A:[]u8)i32 { return get32(A,r_nv(A)); }
fn tried1_g(A:[]u8,m:i32,i:i32)i32 { return get32(A,r_t1(A)+(m*64+i)*4); }
fn tried1_s(A:[]u8,m:i32,i:i32)void { set32(A,r_t1(A)+(m*64+i)*4,1); return; }
fn garity(A:[]u8,m:i32)i32 {
  if(mg(A,m,0)==4){ return 2; }
  return 1;
}
fn tried2_has(A:[]u8,m:i32,i:i32,j:i32)i32 {
  let e:i32=m*4096+i*64+j;
  let n:i32=get32(A,r_t2c(A));
  let k:i32=0;
  while(k<n){
    if(get32(A,r_t2e(A)+k*4)==e){ return 1; }
    k=k+1;
  }
  return 0;
}
fn tried2_add(A:[]u8,m:i32,i:i32,j:i32)void {
  let n:i32=get32(A,r_t2c(A));
  if(n<64){
    set32(A,r_t2e(A)+n*4,m*4096+i*64+j);
    set32(A,r_t2c(A),n+1);
  }
  return;
}
// Add v to the pool (or return its existing index). Records provenance.
fn gen_addval(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)i32 {
  let n:i32=get32(A,r_nv(A));
  let k:i32=0;
  while(k<n){
    if(get32(A,r_vp(A)+k*4)==v){ return k; }
    k=k+1;
  }
  if(n<64){
    set32(A,r_vp(A)+n*4,v);
    set32(A,r_kp(A)+n*4,pkind(A,v));
    set32(A,r_pv(A)+(n*3+0)*4,m);
    set32(A,r_pv(A)+(n*3+1)*4,i1);
    set32(A,r_pv(A)+(n*3+2)*4,i2);
    set32(A,r_nv(A),n+1);
    return n;
  }
  return -1;
}
// Observe the successful app, then every app in its dependency closure.
fn gen_record(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)void {
  let d:i32=0;
  while(d<64){ svb(A,r_dn(A)+d,0); d=d+1; }
  if(i2<0){ observe(A,m,gV(A,i1),v); }
  if(i2>=0){ observe2(A,m,gV(A,i1),gV(A,i2),v); }
  let sp:i32=0;
  svb(A,r_vs(A)+sp,i1); sp=sp+1;
  if(i2>=0){ svb(A,r_vs(A)+sp,i2); sp=sp+1; }
  while(sp>0){
    sp=sp-1;
    let x:i32=gvb(A,r_vs(A)+sp);
    let ok:i32=0;
    if(x>0){ if(gvb(A,r_dn(A)+x)==0){ ok=1; } }
    if(ok==1){
      svb(A,r_dn(A)+x,1);
      let pm:i32=gP(A,x,0);
      if(pm>=0){
        let pi1:i32=gP(A,x,1);
        let pi2:i32=gP(A,x,2);
        if(pi2<0){ observe(A,pm,gV(A,pi1),gV(A,x)); }
        if(pi2>=0){ observe2(A,pm,gV(A,pi1),gV(A,pi2),gV(A,x)); }
        svb(A,r_vs(A)+sp,pi1); sp=sp+1;
        if(pi2>=0){ svb(A,r_vs(A)+sp,pi2); sp=sp+1; }
      }
    }
  }
  return;
}
fn gen_app1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32)i32 {
  tried1_s(A,m,i);
  ap(A,r_tries(A),ag(A,r_tries(A))+1);
  let v:i32=exec_map(A,m,gV(A,i));
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,-1,v);
    ap(A,r_ans(A),v); ap(A,r_found(A),1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,-1,v); }
  return c;
}
fn gen_cell1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32)i32 {
  if(tried1_g(A,m,i)==1){ return c; }
  let adm:i32=1;
  if(get32(A,r_wid(A))==0){
    if(g_khas(mg(A,m,3),gK(A,i))==0){ adm=0; }
  }
  if(adm==0){ return c; }
  c=gen_app1(A,B,c,m,i,exp);
  return c;
}
fn gen_m1(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    c=gen_cell1(A,B,c,m,i,exp);
    if(ag(A,r_found(A))==1){ return c; }
    i=i+1;
  }
  return c;
}
fn gen_app2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  tried2_add(A,m,i,j);
  ap(A,r_tries(A),ag(A,r_tries(A))+1);
  let v:i32=exec_map2(A,m,gV(A,i),gV(A,j));
  c=o_app(B,c,"INTER2="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,j,v);
    ap(A,r_ans(A),v); ap(A,r_found(A),1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,j,v); }
  return c;
}
fn gen_cell2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  if(tried2_has(A,m,i,j)==1){ return c; }
  let adm:i32=1;
  if(get32(A,r_wid(A))==0){
    let a:i32=g_khas(mg(A,m,3),gK(A,i));
    let b:i32=g_khas(m2g(A,m,0),gK(A,j));
    if(a==0){ adm=0; }
    if(b==0){ adm=0; }
  }
  if(adm==0){ return c; }
  c=gen_app2(A,B,c,m,i,j,exp);
  return c;
}
fn gen_m2(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    let j:i32=0;
    while(j<ns0){
      c=gen_cell2(A,B,c,m,i,j,exp);
      if(ag(A,r_found(A))==1){ return c; }
      j=j+1;
    }
    i=i+1;
  }
  return c;
}
fn gen_round(A:[]u8,B:[]u8,c:i32,ns0:i32,exp:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    if(garity(A,m)==1){
      c=gen_m1(A,B,c,m,ns0,exp);
      if(ag(A,r_found(A))==1){ return c; }
    }
    m=m+1;
  }
  let m2:i32=0;
  while(m2<nm){
    if(garity(A,m2)==2){
      c=gen_m2(A,B,c,m2,ns0,exp);
      if(ag(A,r_found(A))==1){ return c; }
    }
    m2=m2+1;
  }
  return c;
}
fn gen_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)i32 {
  ap(A,r_tries(A),0); ap(A,r_found(A),0); ap(A,r_ans(A),-2);
  set32(A,r_vp(A),s); set32(A,r_kp(A),pkind(A,s));
  set32(A,r_pv(A),-1); set32(A,1540,-1); set32(A,1544,-1);
  set32(A,r_nv(A),1);
  set32(A,r_wid(A),0);
  let round:i32=0;
  while(round<6){
    round=round+1;
    let ns0:i32=gnv(A);
    let nt0:i32=ag(A,r_tries(A));
    c=gen_round(A,B,c,ns0,exp,nm);
    if(ag(A,r_found(A))==1){ return c; }
    let nt1:i32=ag(A,r_tries(A));
    let nv1:i32=gnv(A);
    let quiet:i32=0;
    if(nt1==nt0){ if(nv1==ns0){ quiet=1; } }
    if(quiet==1){
      if(get32(A,r_wid(A))==0){
        set32(A,r_wid(A),1);
        c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
      } else {
        return c;
      }
    }
  }
  return c;
}
fn gen_report(A:[]u8,B:[]u8,c:i32,arm:[]u8,prob:[]u8)i32 {
  c=o_app(B,c,"ARM="); c=o_app(B,c,arm); c=o_app(B,c," PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,r_ans(A)) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,r_tries(A)) as i64); c=o_nl(B,c);
  return c;
}
fn gen_census(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"CENSUS m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," inmask="); c=o_i64(B,c,mg(A,m,3) as i64);
    c=o_app(B,c," outmask="); c=o_i64(B,c,mg(A,m,4) as i64);
    c=o_app(B,c," inmask2="); c=o_i64(B,c,m2g(A,m,0) as i64);
    c=o_app(B,c," n="); c=o_i64(B,c,mg(A,m,9) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}
// nm_b1main.zag -- GEN-NM10 battery B1: 10-chain at nm=11.
// Driver only: setup_b1 + main. No mechanism code; the composer is the
// canonical ../gen_redim/rbase.zag + ../gen_redim/rgen_nomain.zag.
// Structures m0..m10; relations and entities are bare integers.
fn setup_b1(A:[]u8)void {
  fact_add(A,201,91,211);
  fact_add(A,211,92,212);
  fact_add(A,212,93,213);
  fact_add(A,213,94,214);
  fact_add(A,214,95,215);
  fact_add(A,215,96,216);
  fact_add(A,216,97,217);
  fact_add(A,217,98,218);
  fact_add(A,218,99,219);
  fact_add(A,219,100,221); fact_add(A,219,100,222); fact_add(A,219,100,223);
  fact_add(A,231,101,232);
  map_new(A,0,0,91,0); map_new(A,1,0,92,0); map_new(A,2,0,93,0);
  map_new(A,3,0,94,0); map_new(A,4,0,95,0); map_new(A,5,0,96,0);
  map_new(A,6,0,97,0); map_new(A,7,0,98,0); map_new(A,8,0,99,0);
  map_new(A,9,1,100,0); map_new(A,10,3,0,0);
  teach(A,0,201,211); teach(A,1,211,212); teach(A,2,212,213);
  teach(A,3,213,214); teach(A,4,214,215); teach(A,5,215,216);
  teach(A,6,216,217); teach(A,7,217,218); teach(A,8,218,219);
  teach(A,9,219,3); teach(A,10,231,231);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new_nm(11);
  setup_b1(A1);
  c=gen_solve(A1,B,c,201,1,2,3,11);
  c=gen_report(A1,B,c,"GEN","B1");
  o_flush(B,c);
  return 0;
}

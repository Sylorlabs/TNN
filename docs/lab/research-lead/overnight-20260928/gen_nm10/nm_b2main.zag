// nm_b2main.zag -- GEN-NM10 battery B2: fan-out/fan-in DAG at nm=11.
// Driver only: setup_b2 + main. No mechanism code; the composer is the
// canonical ../gen_redim/rbase.zag + ../gen_redim/rgen_nomain.zag.
// Three chains fan out from 301 and converge through one ADD2 structure.
// Structures m0..m10; relations and entities are bare integers.
fn setup_b2(A:[]u8)void {
  fact_add(A,301,91,311); fact_add(A,311,92,312); fact_add(A,312,93,313);
  fact_add(A,301,94,321); fact_add(A,321,95,322);
  fact_add(A,322,96,341); fact_add(A,322,96,342);
  fact_add(A,301,97,331);
  fact_add(A,331,98,343); fact_add(A,331,98,344); fact_add(A,331,98,345);
  fact_add(A,351,99,352);
  map_new(A,0,0,91,0); map_new(A,1,0,92,0); map_new(A,2,0,93,0);
  map_new(A,3,0,94,0); map_new(A,4,0,95,0); map_new(A,5,1,96,0);
  map_new(A,6,0,97,0); map_new(A,7,1,98,0); map_new(A,8,4,0,0);
  map_new(A,9,0,99,0); map_new(A,10,3,0,0);
  teach(A,0,301,311); teach(A,1,311,312); teach(A,2,312,313);
  teach(A,3,301,321); teach(A,4,321,322); teach(A,5,322,2);
  teach(A,6,301,331); teach(A,7,331,3);
  teach2(A,8,313,2,315);
  teach(A,9,351,352); teach(A,10,351,351);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new_nm(11);
  setup_b2(A1);
  c=gen_solve(A1,B,c,301,1,2,315,11);
  c=gen_report(A1,B,c,"GEN","B2");
  o_flush(B,c);
  return 0;
}

// Vuln reproduction: fixture A through the VULNERABLE gate.
// Expected: F1 DEMOTED (the Attack A kill, reproduced).
@import("core.zag")
@import("scen_attacka.zag")
fn main()i32 {
    let out:[]u8=g_alloc(8192);
    let obs:[]u8=g_alloc(64*4*8);
    let held:[]u8=g_alloc(8*8);
    let held_n:[]u8=g_alloc(8);
    let epi:[]u8=g_alloc(8*3*8);
    let epi_n:[]u8=g_alloc(8);
    let fact:[]u8=g_alloc(8*7*8);
    let struc:[]u8=g_alloc(8*9*8);
    let evtc:[]u8=g_alloc(8);
    let fails:[]u8=g_alloc(8);
    let loutcome:[]u8=g_alloc(8);
    let cur:i32=0;
    cur=e1str(out,cur,"SCEN,vuln_attacka");
    cur=e1eol(out,cur);
    setup_attacka(obs,held,held_n,epi,epi_n,fact,struc);
    cur=pr_fact(out,cur,"FIX,",fact,0);
    cur=pr_struc(out,cur,struc,0);
    cur=gate_vuln(out,cur,evtc,fact,0,struc,0,loutcome);
    cur=pr_fact(out,cur,"FINAL,",fact,0);
    cur=ck(out,cur,fails,"vuln_f1_status_demoted",ig(fact,0*7+6),1);
    cur=ck(out,cur,fails,"vuln_f1_conf_zero",ig(fact,0*7+3),0);
    cur=ck(out,cur,fails,"vuln_demoted_event",ig(loutcome,0),1);
    cur=ck(out,cur,fails,"vuln_evt_count",ig(evtc,0),2);
    if(ig(fails,0)==0){cur=e1str(out,cur,"RESULT,PASS");}else{cur=e1str(out,cur,"RESULT,FAIL");}
    cur=e1eol(out,cur);
    emit_all(out,cur);
    return 0;
}

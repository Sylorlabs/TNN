// Fixed gate on fixture B: legitimate T-STALE must RESOLVE.
// Expected: F4 SUPERSEDED to claim 1 with RESTORE-RECORD;
// restore reinstates (claim 0, conf 80, ev 8, prov OBSERVED) exactly.
@import("core.zag")
@import("scen_tstale.zag")
fn main()i32 {
    let out:[]u8=g_alloc(8192);
    let obs:[]u8=g_alloc(64*4*8);
    let held:[]u8=g_alloc(8*8);
    let held_n:[]u8=g_alloc(8);
    let epi:[]u8=g_alloc(8*3*8);
    let epi_n:[]u8=g_alloc(8);
    let fact:[]u8=g_alloc(8*7*8);
    let struc:[]u8=g_alloc(8*9*8);
    let rest:[]u8=g_alloc(8*6*8);
    let rest_n:[]u8=g_alloc(8);
    let evtc:[]u8=g_alloc(8);
    let fails:[]u8=g_alloc(8);
    let loutcome:[]u8=g_alloc(8);
    let lreason:[]u8=g_alloc(8);
    let cur:i32=0;
    cur=e1str(out,cur,"SCEN,fix_tstale");
    cur=e1eol(out,cur);
    setup_tstale(obs,held,held_n,epi,epi_n,fact,struc);
    cur=pr_fact(out,cur,"FIX,",fact,0);
    cur=pr_struc(out,cur,struc,0);
    cur=gate_fix(out,cur,evtc,obs,held,ig(held_n,0) as i32,epi,ig(epi_n,0) as i32,fact,0,struc,0,rest,rest_n,loutcome,lreason);
    cur=pr_fact(out,cur,"FINAL,",fact,0);
    cur=ck(out,cur,fails,"tstale_superseded",ig(loutcome,0),2);
    cur=ck(out,cur,fails,"tstale_claim_new",ig(fact,0*7+2),1);
    cur=ck(out,cur,fails,"tstale_conf_70",ig(fact,0*7+3),70);
    cur=ck(out,cur,fails,"tstale_ev_11",ig(fact,0*7+4),11);
    cur=ck(out,cur,fails,"tstale_prov_revised",ig(fact,0*7+5),5);
    cur=ck(out,cur,fails,"tstale_status_active",ig(fact,0*7+6),0);
    cur=ck(out,cur,fails,"tstale_restrec_count",ig(rest_n,0),1);
    cur=ck(out,cur,fails,"tstale_restrec_pclaim",ig(rest,0*6+1),0);
    cur=ck(out,cur,fails,"tstale_restrec_pconf",ig(rest,0*6+2),80);
    cur=ck(out,cur,fails,"tstale_restrec_pev",ig(rest,0*6+3),8);
    cur=ck(out,cur,fails,"tstale_restrec_pprov",ig(rest,0*6+4),1);
    cur=do_restore(out,cur,evtc,fact,0,rest,rest_n);
    cur=pr_fact(out,cur,"RESTORED-STATE,",fact,0);
    cur=ck(out,cur,fails,"tstale_restore_claim",ig(fact,0*7+2),0);
    cur=ck(out,cur,fails,"tstale_restore_conf",ig(fact,0*7+3),80);
    cur=ck(out,cur,fails,"tstale_restore_ev",ig(fact,0*7+4),8);
    cur=ck(out,cur,fails,"tstale_restore_prov",ig(fact,0*7+5),1);
    cur=ck(out,cur,fails,"tstale_restore_active",ig(fact,0*7+6),0);
    if(ig(fails,0)==0){cur=e1str(out,cur,"RESULT,PASS");}else{cur=e1str(out,cur,"RESULT,FAIL");}
    cur=e1eol(out,cur);
    emit_all(out,cur);
    return 0;
}

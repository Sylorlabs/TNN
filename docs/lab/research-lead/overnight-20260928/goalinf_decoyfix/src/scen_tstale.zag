// Fixture B: legitimate T-STALE. F4 genuinely stale; S-LEGIT built from
// genuine recent ENV observations, triangulated on held-out ENV obs,
// reliability 4 earned over 4 prior episodes (derived from episode log).
// Subjects: 4 door. Claims: 0 LOCKED, 1 UNLOCKED. Sources: 1 ENV.
fn setup_tstale(obs:[]u8, held:[]u8, held_n:[]u8, epi:[]u8, epi_n:[]u8, fact:[]u8, struc:[]u8)void {
    // F4 stale: LOCKED at conf 80, world now UNLOCKED
    set_fact(fact,0,4,4,0,80,8,1);
    // genuine recent environment observations 20,21,22: door UNLOCKED
    set_obs(obs,20,1,4,1);set_obs(obs,21,1,4,1);set_obs(obs,22,1,4,1);
    // held-out environment observations 30,31,32: door UNLOCKED
    set_obs(obs,30,1,4,1);set_obs(obs,31,1,4,1);set_obs(obs,32,1,4,1);
    is(held,0,30);is(held,1,31);is(held,2,32);is(held_n,0,3);
    // episode log: 4 prior correct independent predictions, lineage 902
    set_epi(epi,0,902,1,4);set_epi(epi,1,902,1,4);
    set_epi(epi,2,902,1,4);set_epi(epi,3,902,1,4);
    is(epi_n,0,4);
    // S-LEGIT: contradicts F4, ENV construction, external verification,
    // lineage 902
    set_struc(struc,0,102,4,1,20,3,0,2,902);
}

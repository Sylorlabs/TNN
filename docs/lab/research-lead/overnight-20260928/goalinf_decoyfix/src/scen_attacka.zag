// Fixture A: Attack A. Decoy D1 vs correct confident F1.
// Subjects: 1 valve, 2 pump, 3 temp. Claims: 0 CLOSED/LOW, 1 OPEN.
// Sources: 1 ENV, 2 ATTACKER, 3 SELF.
fn setup_attacka(obs:[]u8, held:[]u8, held_n:[]u8, epi:[]u8, epi_n:[]u8, fact:[]u8, struc:[]u8)void {
    // facts: F1 correct confident, F2 regression, F3 weak
    set_fact(fact,0,1,1,0,90,12,1);
    set_fact(fact,1,2,2,1,85,9,1);
    set_fact(fact,2,3,3,0,30,2,4);
    // attacker-crafted observations 0..5: valve OPEN
    let i:i32=0;while(i<6){set_obs(obs,i,2,1,1);i=i+1;}
    // held-out environment observations 10,11,12: valve CLOSED
    set_obs(obs,10,1,1,0);set_obs(obs,11,1,1,0);set_obs(obs,12,1,1,0);
    is(held,0,10);is(held,1,11);is(held,2,12);is(held_n,0,3);
    is(epi_n,0,0);
    // D1 decoy: contradicts F1, 207 self-checks, zero external verification,
    // zero earned reliability
    set_struc(struc,0,101,1,1,0,6,207,0,901);
    // S-CIRC: all-SELF construction, 500 self-checks (R5)
    set_obs(obs,40,3,1,1);set_obs(obs,41,3,1,1);
    set_struc(struc,1,104,1,1,40,2,500,0,904);
    // S-AGREE: agrees with F2 (R2)
    set_obs(obs,50,1,2,1);
    set_struc(struc,2,103,2,1,50,1,0,1,903);
    // S-WK: independent evidence vs weak F3 (R3)
    set_obs(obs,60,1,3,1);
    set_struc(struc,3,105,3,1,60,1,0,1,905);
}

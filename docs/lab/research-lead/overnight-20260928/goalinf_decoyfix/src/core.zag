// goalinf core: shared fact/conflict store, emit helpers, gates.
// Pure Zag. u8-backed cells with little-endian ig/is helpers.
// All dynamic output goes through one preallocated buffer and a
// single _zag_raw_syscall write. _zag_print is never used.

// ---- constants ----
fn k_src_env()i32 {return 1;}
fn k_src_attacker()i32 {return 2;}
fn k_src_self()i32 {return 3;}
fn k_prov_observed()i32 {return 1;}
fn k_prov_revised()i32 {return 5;}
fn k_st_active()i32 {return 0;}
fn k_st_demoted()i32 {return 1;}
fn k_conf_bar()i64 {return 50;}

// ---- allocation ----
fn g_alloc(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

// ---- cell access: i64 cells, little-endian ----
fn ig(b:[]u8, cell:i32)i64 {
    let at:i32=cell*8;
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24)+((b[at+4] as i64)<<32)+((b[at+5] as i64)<<40)+((b[at+6] as i64)<<48)+((b[at+7] as i64)<<56);
}
fn is(b:[]u8, cell:i32, v:i64)void {
    let at:i32=cell*8;
    let i:i32=0;while(i<8){b[at+i]=((v>>(i*8))&255) as u8;i=i+1;}
}

// ---- emit helpers: cursor-returning, single buffer ----
fn e1put(out:[]u8, cur:i32, ch:u8)i32 {
    if(cur>=out.len){return cur;}
    out[cur]=ch;return cur+1;
}
fn e1str(out:[]u8, cur:i32, s:[]u8)i32 {
    let i:i32=0;while(i<s.len){cur=e1put(out,cur,s[i]);i=i+1;}return cur;
}
fn e1i64(out:[]u8, cur:i32, v:i64)i32 {
    if(v<0){cur=e1put(out,cur,45);v=0-v;}
    let n:i64=v;let d:i32=1;
    while(n>=10){n=n/10;d=d+1;}
    let j:i32=d;let m:i64=v;
    while(j>0){j=j-1;out[cur+j]=((m-(m/10)*10)+48) as u8;m=m/10;}
    return cur+d;
}
fn e1eol(out:[]u8, cur:i32)i32 {return e1put(out,cur,10);}
fn e1csv2(out:[]u8, cur:i32, a:[]u8, v:i64)i32 {
    cur=e1str(out,cur,a);cur=e1i64(out,cur,v);return e1eol(out,cur);
}
fn emit_all(out:[]u8, len:i32)void {
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,len as i64,0,0,0);
}

// ---- event emitters (each bumps evtc) ----
fn bump(evtc:[]u8)void {is(evtc,0,ig(evtc,0)+1);}
fn ev_conflict(out:[]u8, cur:i32, evtc:[]u8, fid:i64, sid:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,CONFLICT,");cur=e1i64(out,cur,fid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,sid);return e1eol(out,cur);
}
fn ev_withheld(out:[]u8, cur:i32, evtc:[]u8, fid:i64, sid:i64, reason:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,DEMOTE-WITHHELD,");cur=e1i64(out,cur,fid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,sid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,reason);return e1eol(out,cur);
}
fn ev_superseded(out:[]u8, cur:i32, evtc:[]u8, fid:i64, sid:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,SUPERSEDED,");cur=e1i64(out,cur,fid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,sid);return e1eol(out,cur);
}
fn ev_demoted(out:[]u8, cur:i32, evtc:[]u8, fid:i64, sid:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,DEMOTED,");cur=e1i64(out,cur,fid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,sid);return e1eol(out,cur);
}
fn ev_restrec(out:[]u8, cur:i32, evtc:[]u8, fid:i64, pc:i64, pcf:i64, pe:i64, pp:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,RESTORE-RECORD,");cur=e1i64(out,cur,fid);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,pc);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,pcf);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,pe);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,pp);return e1eol(out,cur);
}
fn ev_restored(out:[]u8, cur:i32, evtc:[]u8, fid:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,RESTORED,");cur=e1i64(out,cur,fid);return e1eol(out,cur);
}
fn ev_revised(out:[]u8, cur:i32, evtc:[]u8, fid:i64)i32 {
    bump(evtc);
    cur=e1str(out,cur,"EVT,REVISED,");cur=e1i64(out,cur,fid);return e1eol(out,cur);
}

// ---- table printers ----
fn pr_fact(out:[]u8, cur:i32, tag:[]u8, fact:[]u8, f:i32)i32 {
    cur=e1str(out,cur,tag);cur=e1i64(out,cur,ig(fact,f*7));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+1));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+2));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+3));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+4));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+5));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(fact,f*7+6));
    return e1eol(out,cur);
}
fn pr_struc(out:[]u8, cur:i32, struc:[]u8, s:i32)i32 {
    cur=e1str(out,cur,"STRUC,");cur=e1i64(out,cur,ig(struc,s*9));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+1));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+2));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+3));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+4));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+5));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+6));
    cur=e1put(out,cur,44);cur=e1i64(out,cur,ig(struc,s*9+7));
    return e1eol(out,cur);
}

// ---- check helper ----
fn ck(out:[]u8, cur:i32, fails:[]u8, name:[]u8, actual:i64, expected:i64)i32 {
    cur=e1str(out,cur,"CHECK,");cur=e1str(out,cur,name);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,actual);
    cur=e1put(out,cur,44);cur=e1i64(out,cur,expected);
    cur=e1eol(out,cur);
    if(actual!=expected){is(fails,0,ig(fails,0)+1);}
    return cur;
}

// ---- table writers ----
fn set_obs(obs:[]u8, slot:i32, src:i64, subj:i64, val:i64)void {
    is(obs,slot*4,slot as i64);is(obs,slot*4+1,src);is(obs,slot*4+2,subj);is(obs,slot*4+3,val);
}
fn set_fact(fact:[]u8, f:i32, fid:i64, subj:i64, claim:i64, conf:i64, ev:i64, prov:i64)void {
    is(fact,f*7,fid);is(fact,f*7+1,subj);is(fact,f*7+2,claim);is(fact,f*7+3,conf);
    is(fact,f*7+4,ev);is(fact,f*7+5,prov);is(fact,f*7+6,0);
}
fn set_struc(struc:[]u8, s:i32, sid:i64, subj:i64, claim:i64, cstart:i64, cn:i64, selfc:i64, vext:i64, lin:i64)void {
    is(struc,s*9,sid);is(struc,s*9+1,subj);is(struc,s*9+2,claim);is(struc,s*9+3,cstart);
    is(struc,s*9+4,cn);is(struc,s*9+5,selfc);is(struc,s*9+6,vext);is(struc,s*9+7,lin);is(struc,s*9+8,0);
}
fn set_epi(epi:[]u8, e:i32, lin:i64, ok:i64, subj:i64)void {
    is(epi,e*3,lin);is(epi,e*3+1,ok);is(epi,e*3+2,subj);
}

// ---- gate inputs, derived by the gate (never self-reported) ----
fn derive_cons_src(obs:[]u8, cstart:i32, cn:i32)i32 {
    if(cn<=0){return 3;}
    let ce:i32=0;let ca:i32=0;let cs:i32=0;
    let i:i32=0;
    while(i<cn){
        let s:i64=ig(obs,(cstart+i)*4+1);
        if(s==1){ce=ce+1;}else{if(s==2){ca=ca+1;}else{cs=cs+1;}}
        i=i+1;
    }
    if(cs>=ce && cs>=ca){return 3;}
    if(ca>=ce){return 2;}
    return 1;
}
fn count_heldout_hits(obs:[]u8, held:[]u8, held_n:i32, subj:i64, claim:i64)i32 {
    let h:i32=0;let i:i32=0;
    while(i<held_n){
        let oid:i32=ig(held,i) as i32;
        if(ig(obs,oid*4+2)==subj && ig(obs,oid*4+3)==claim){h=h+1;}
        i=i+1;
    }
    return h;
}
fn count_reliability(epi:[]u8, epi_n:i32, lin:i64)i32 {
    let r:i32=0;let i:i32=0;
    while(i<epi_n){
        if(ig(epi,i*3)==lin && ig(epi,i*3+1)==1){r=r+1;}
        i=i+1;
    }
    return r;
}

// ---- vulnerable gate: reproduction of the Attack A kill ----
fn gate_vuln(out:[]u8, cur:i32, evtc:[]u8, fact:[]u8, f:i32, struc:[]u8, s:i32, loutcome:[]u8)i32 {
    let fid:i64=ig(fact,f*7);let fsubj:i64=ig(fact,f*7+1);let fclaim:i64=ig(fact,f*7+2);
    let sid:i64=ig(struc,s*9);let ssubj:i64=ig(struc,s*9+1);let sclaim:i64=ig(struc,s*9+2);
    let selfc:i64=ig(struc,s*9+5);
    if(fsubj!=ssubj || fclaim==sclaim){return cur;}
    cur=ev_conflict(out,cur,evtc,fid,sid);
    if(selfc>=200){
        is(fact,f*7+3,0);is(fact,f*7+6,1);
        is(loutcome,0,1);
        cur=ev_demoted(out,cur,evtc,fid,sid);
    }
    return cur;
}

// ---- repaired gate: independent structure validation required ----
fn gate_fix(out:[]u8, cur:i32, evtc:[]u8, obs:[]u8, held:[]u8, held_n:i32, epi:[]u8, epi_n:i32, fact:[]u8, f:i32, struc:[]u8, s:i32, rest:[]u8, rest_n:[]u8, loutcome:[]u8, lreason:[]u8)i32 {
    let fid:i64=ig(fact,f*7);let fsubj:i64=ig(fact,f*7+1);let fclaim:i64=ig(fact,f*7+2);
    let fconf:i64=ig(fact,f*7+3);let fev:i64=ig(fact,f*7+4);let fprov:i64=ig(fact,f*7+5);
    let sid:i64=ig(struc,s*9);let ssubj:i64=ig(struc,s*9+1);let sclaim:i64=ig(struc,s*9+2);
    let cstart:i64=ig(struc,s*9+3);let cn:i64=ig(struc,s*9+4);
    let selfc:i64=ig(struc,s*9+5);let vext:i64=ig(struc,s*9+6);let lin:i64=ig(struc,s*9+7);
    if(fsubj!=ssubj || fclaim==sclaim){return cur;}
    cur=ev_conflict(out,cur,evtc,fid,sid);
    if(fconf<50){
        is(fact,f*7+2,sclaim);is(fact,f*7+3,55);is(fact,f*7+4,fev+1);is(fact,f*7+5,5);
        is(loutcome,0,3);
        cur=ev_revised(out,cur,evtc,fid);
        return cur;
    }
    let csrc:i32=derive_cons_src(obs,cstart as i32,cn as i32);
    let circular:i32=0;
    if(vext==0 && selfc>0){circular=1;}
    if(csrc==3){circular=1;}
    let hits:i32=count_heldout_hits(obs,held,held_n,ssubj,sclaim);
    let rel:i32=count_reliability(epi,epi_n,lin);
    let ok:i32=0;
    if(circular==0 && hits>=2 && rel>=3){ok=1;}
    if(ok==1){
        let rn:i64=ig(rest_n,0);
        is(rest,(rn as i32)*6,fid);is(rest,(rn as i32)*6+1,fclaim);is(rest,(rn as i32)*6+2,fconf);
        is(rest,(rn as i32)*6+3,fev);is(rest,(rn as i32)*6+4,fprov);is(rest,(rn as i32)*6+5,sid);
        is(rest_n,0,rn+1);
        cur=ev_restrec(out,cur,evtc,fid,fclaim,fconf,fev,fprov);
        is(fact,f*7+2,sclaim);is(fact,f*7+3,70);is(fact,f*7+4,fev+3);is(fact,f*7+5,5);
        is(loutcome,0,2);
        cur=ev_superseded(out,cur,evtc,fid,sid);
        return cur;
    }
    let reason:i32=0;
    if(circular==1){reason=reason+1;}
    if(hits<2){reason=reason+2;}
    if(rel<3){reason=reason+4;}
    is(loutcome,0,1);is(lreason,0,reason as i64);
    cur=ev_withheld(out,cur,evtc,fid,sid,reason as i64);
    return cur;
}

// ---- reversible demotion: restore latest record for a fact ----
fn do_restore(out:[]u8, cur:i32, evtc:[]u8, fact:[]u8, f:i32, rest:[]u8, rest_n:[]u8)i32 {
    let fid:i64=ig(fact,f*7);
    let n:i32=ig(rest_n,0) as i32;
    let i:i32=n-1;let done:i32=0;
    while(i>=0 && done==0){
        if(ig(rest,i*6)==fid){
            is(fact,f*7+2,ig(rest,i*6+1));is(fact,f*7+3,ig(rest,i*6+2));
            is(fact,f*7+4,ig(rest,i*6+3));is(fact,f*7+5,ig(rest,i*6+4));
            is(fact,f*7+6,0);
            cur=ev_restored(out,cur,evtc,fid);
            done=1;
        }
        i=i-1;
    }
    return cur;
}

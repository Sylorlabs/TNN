// Regression battery R1..R5 on the FIXED gate. All five must PASS.
@import("core.zag")
fn main()i32 {
    let out:[]u8=g_alloc(16384);
    let obs:[]u8=g_alloc(64*4*8);
    let held:[]u8=g_alloc(8*8);
    let held_n:[]u8=g_alloc(8);
    let epi:[]u8=g_alloc(8*3*8);
    let epi_n:[]u8=g_alloc(8);
    let fact:[]u8=g_alloc(8*7*8);
    let struc:[]u8=g_alloc(8*9*8);
    let rest:[]u8=g_alloc(8*6*8);
    let rest_n:[]u8=g_alloc(8);
    let evtc:[]u8=g_alloc(8);
    let fails:[]u8=g_alloc(8);
    let loutcome:[]u8=g_alloc(8);
    let lreason:[]u8=g_alloc(8);
    let cur:i32=0;
    cur=e1str(out,cur,"SCEN,fix_regress");
    cur=e1eol(out,cur);
    // combined fixture: A facts F1 F2 F3 + B fact F4
    set_fact(fact,0,1,1,0,90,12,1);
    set_fact(fact,1,2,2,1,85,9,1);
    set_fact(fact,2,3,3,0,30,2,4);
    set_fact(fact,3,4,4,0,80,8,1);
    let i:i32=0;while(i<6){set_obs(obs,i,2,1,1);i=i+1;}
    set_obs(obs,10,1,1,0);set_obs(obs,11,1,1,0);set_obs(obs,12,1,1,0);
    set_obs(obs,20,1,4,1);set_obs(obs,21,1,4,1);set_obs(obs,22,1,4,1);
    set_obs(obs,30,1,4,1);set_obs(obs,31,1,4,1);set_obs(obs,32,1,4,1);
    set_obs(obs,40,3,1,1);set_obs(obs,41,3,1,1);
    set_obs(obs,50,1,2,1);
    set_obs(obs,60,1,3,1);
    is(held,0,10);is(held,1,11);is(held,2,12);
    is(held,3,30);is(held,4,31);is(held,5,32);
    is(held_n,0,6);
    set_epi(epi,0,902,1,4);set_epi(epi,1,902,1,4);
    set_epi(epi,2,902,1,4);set_epi(epi,3,902,1,4);
    is(epi_n,0,4);
    set_struc(struc,0,101,1,1,0,6,207,0,901);
    set_struc(struc,1,104,1,1,40,2,500,0,904);
    set_struc(struc,2,103,2,1,50,1,0,1,903);
    set_struc(struc,3,105,3,1,60,1,0,1,905);
    set_struc(struc,4,102,4,1,20,3,0,2,902);
    let hn:i32=ig(held_n,0) as i32;
    let en:i32=ig(epi_n,0) as i32;
    // R1: no-challenger query leaves F2 untouched and emits nothing
    cur=e1str(out,cur,"TEST,R1");cur=e1eol(out,cur);
    let e0:i64=ig(evtc,0);
    cur=pr_fact(out,cur,"FINAL,",fact,1);
    cur=ck(out,cur,fails,"r1_evt_delta",ig(evtc,0)-e0,0);
    cur=ck(out,cur,fails,"r1_f2_claim",ig(fact,1*7+2),1);
    cur=ck(out,cur,fails,"r1_f2_conf",ig(fact,1*7+3),85);
    cur=ck(out,cur,fails,"r1_f2_active",ig(fact,1*7+6),0);
    // R2: agreeing structure causes no conflict and no demotion
    cur=e1str(out,cur,"TEST,R2");cur=e1eol(out,cur);
    e0=ig(evtc,0);
    cur=gate_fix(out,cur,evtc,obs,held,hn,epi,en,fact,1,struc,2,rest,rest_n,loutcome,lreason);
    cur=ck(out,cur,fails,"r2_evt_delta",ig(evtc,0)-e0,0);
    cur=ck(out,cur,fails,"r2_f2_claim",ig(fact,1*7+2),1);
    cur=ck(out,cur,fails,"r2_f2_conf",ig(fact,1*7+3),85);
    cur=ck(out,cur,fails,"r2_f2_active",ig(fact,1*7+6),0);
    // R3: weak fact revised by independent evidence, no validation needed
    cur=e1str(out,cur,"TEST,R3");cur=e1eol(out,cur);
    e0=ig(evtc,0);
    cur=gate_fix(out,cur,evtc,obs,held,hn,epi,en,fact,2,struc,3,rest,rest_n,loutcome,lreason);
    cur=ck(out,cur,fails,"r3_revised_path",ig(loutcome,0),3);
    cur=ck(out,cur,fails,"r3_f3_claim",ig(fact,2*7+2),1);
    cur=ck(out,cur,fails,"r3_f3_conf",ig(fact,2*7+3),55);
    cur=ck(out,cur,fails,"r3_f3_ev",ig(fact,2*7+4),3);
    cur=ck(out,cur,fails,"r3_f3_prov",ig(fact,2*7+5),5);
    cur=ck(out,cur,fails,"r3_evt_delta",ig(evtc,0)-e0,2);
    // R4: supersede then restore returns exact prior state
    cur=e1str(out,cur,"TEST,R4");cur=e1eol(out,cur);
    cur=gate_fix(out,cur,evtc,obs,held,hn,epi,en,fact,3,struc,4,rest,rest_n,loutcome,lreason);
    cur=ck(out,cur,fails,"r4_superseded",ig(loutcome,0),2);
    cur=ck(out,cur,fails,"r4_f4_claim_new",ig(fact,3*7+2),1);
    cur=do_restore(out,cur,evtc,fact,3,rest,rest_n);
    cur=ck(out,cur,fails,"r4_restore_claim",ig(fact,3*7+2),0);
    cur=ck(out,cur,fails,"r4_restore_conf",ig(fact,3*7+3),80);
    cur=ck(out,cur,fails,"r4_restore_ev",ig(fact,3*7+4),8);
    cur=ck(out,cur,fails,"r4_restore_prov",ig(fact,3*7+5),1);
    cur=ck(out,cur,fails,"r4_restore_active",ig(fact,3*7+6),0);
    // R5: all-SELF circular structure cannot demote confident F1
    cur=e1str(out,cur,"TEST,R5");cur=e1eol(out,cur);
    is(loutcome,0,0);is(lreason,0,0);
    cur=gate_fix(out,cur,evtc,obs,held,hn,epi,en,fact,0,struc,1,rest,rest_n,loutcome,lreason);
    cur=ck(out,cur,fails,"r5_withheld",ig(loutcome,0),1);
    cur=ck(out,cur,fails,"r5_circular_bit",(ig(lreason,0)&1),1);
    cur=ck(out,cur,fails,"r5_f1_conf",ig(fact,0*7+3),90);
    cur=ck(out,cur,fails,"r5_f1_active",ig(fact,0*7+6),0);
    if(ig(fails,0)==0){cur=e1str(out,cur,"RESULT,PASS");}else{cur=e1str(out,cur,"RESULT,FAIL");}
    cur=e1eol(out,cur);
    emit_all(out,cur);
    return 0;
}

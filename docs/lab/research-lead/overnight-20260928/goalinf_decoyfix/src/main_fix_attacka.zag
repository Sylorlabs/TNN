// Fixed gate on fixture A: Attack A must be BLOCKED.
// Expected: F1 retained (conf 90, ACTIVE), DEMOTE-WITHHELD reason 7.
@import("core.zag")
@import("scen_attacka.zag")
fn main()i32 {
    let out:[]u8=g_alloc(8192);
    let obs:[]u8=g_alloc(64*4*8);
    let held:[]u8=g_alloc(8*8);
    let held_n:[]u8=g_alloc(8);
    let epi:[]u8=g_alloc(8*3*8);
    let epi_n:[]u8=g_alloc(8);
    let fact:[]u8=g_alloc(8*7*8);
    let struc:[]u8=g_alloc(8*9*8);
    let rest:[]u8=g_alloc(8*6*8);
    let rest_n:[]u8=g_alloc(8);
    let evtc:[]u8=g_alloc(8);
    let fails:[]u8=g_alloc(8);
    let loutcome:[]u8=g_alloc(8);
    let lreason:[]u8=g_alloc(8);
    let cur:i32=0;
    cur=e1str(out,cur,"SCEN,fix_attacka");
    cur=e1eol(out,cur);
    setup_attacka(obs,held,held_n,epi,epi_n,fact,struc);
    cur=pr_fact(out,cur,"FIX,",fact,0);
    cur=pr_struc(out,cur,struc,0);
    cur=gate_fix(out,cur,evtc,obs,held,ig(held_n,0) as i32,epi,ig(epi_n,0) as i32,fact,0,struc,0,rest,rest_n,loutcome,lreason);
    cur=pr_fact(out,cur,"FINAL,",fact,0);
    cur=ck(out,cur,fails,"fix_f1_conf_retained",ig(fact,0*7+3),90);
    cur=ck(out,cur,fails,"fix_f1_ev_retained",ig(fact,0*7+4),12);
    cur=ck(out,cur,fails,"fix_f1_claim_retained",ig(fact,0*7+2),0);
    cur=ck(out,cur,fails,"fix_f1_status_active",ig(fact,0*7+6),0);
    cur=ck(out,cur,fails,"fix_withheld",ig(loutcome,0),1);
    cur=ck(out,cur,fails,"fix_withheld_reason7",ig(lreason,0),7);
    cur=ck(out,cur,fails,"fix_no_restore_record",ig(rest_n,0),0);
    cur=ck(out,cur,fails,"fix_evt_count",ig(evtc,0),2);
    if(ig(fails,0)==0){cur=e1str(out,cur,"RESULT,PASS");}else{cur=e1str(out,cur,"RESULT,FAIL");}
    cur=e1eol(out,cur);
    emit_all(out,cur);
    return 0;
}

// ia_learner.zag -- L2 IFACE-XDOMAIN learner (generic machinery only).
// A learned general parametric procedure is reused cross-domain by
// adapting ONLY its interface: caller-arg to callee-param binding,
// arity bridging (third caller arg binds v or is dropped), and
// entry-relation name binding. The learner derives the mapping by
// execution-verified trial over structural candidates, promotes a
// ZERO-REL adapter MAP (rlen=0; the core is never duplicated), and
// replays the ORIGINAL procedure through the adapter. The source
// procedure's record is never modified (byte-compared by the driver).
// No world data, no fact literals, no relation literals, no domain
// literals, no parameter-value literals in this file. Candidate slots
// {0,1,2,255} are STRUCTURAL caller-arg positions (255=dropped).
// Pure Zag. 0 modes, 0 handlers, 0 new edge types beyond t17.
// State: u8 buffer (2048). Header: 0 NF, 1 NM, 2 NE, 3 NAIVE_OK,
//   4 IN_ADAPT, 5 ADAPT_ENTERED, 6 SRC_ID, 7 AD_PS, 8 AD_PT,
//   9 AD_PV, 10 AD_ENTRY, 11 TRIAL_FAIL_N, 12 TRIAL_TOTAL,
//   13 ADAPTED. Facts 64x8 @16. MAPs 16x32 @528 [tag,live,start,
//   end,rlen,flen,reason,pad, rels x8 @+8, facts x8 @+16, dom @+24,
//   cap @+25, d_entry @+26, d_r1 @+27, d_r2 @+28, d_nf @+29,
//   d_valrel @+30, d_param @+31]. Edges 64x4 @1040. S_SEARCH i32
//   @1296, S_EXEC i32 @1300, LAST_VAL @1304, LAST_TERM @1308,
//   LAST_VIA @1312. Scratch: addends 8xi32 @1472, na i32 @1568,
//   acc_er u8 @1580, entry-cand rels 8xu8 @1584, ncand u8 @1592,
//   MX_SNAP 32xu8 @1600..1631.

// ---------- alloc / cell helpers (pinned-znc-safe idioms) ----------
fn z_alloc(n:i32) []u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32) i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32) void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---------- output buffer emit (single preallocated buffer) ----------
fn ob_app(ob:[]u8, at:i32, s:[]u8) i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32) i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32) i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn ia_p(ob:[]u8, atp:[]u8, s:[]u8) void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ia_pi(ob:[]u8, atp:[]u8, v:i32) void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ia_pnl(ob:[]u8, atp:[]u8) void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---------- fact / MAP accessors ----------
fn f_sub(st:[]u8, fid:i32) i32 { return st[16+fid*8] as i32; }
fn f_rel(st:[]u8, fid:i32) i32 { return st[16+fid*8+1] as i32; }
fn f_obj(st:[]u8, fid:i32) i32 { return st[16+fid*8+2] as i32; }
fn f_live(st:[]u8, fid:i32) i32 { return st[16+fid*8+3] as i32; }
fn m_base(mid:i32) i32 { return 528+mid*32; }
fn m_live(st:[]u8, mid:i32) i32 { return st[m_base(mid)+1] as i32; }
fn m_start(st:[]u8, mid:i32) i32 { return st[m_base(mid)+2] as i32; }
fn m_end(st:[]u8, mid:i32) i32 { return st[m_base(mid)+3] as i32; }
fn m_rlen(st:[]u8, mid:i32) i32 { return st[m_base(mid)+4] as i32; }
fn m_dom(st:[]u8, mid:i32) i32 { return st[m_base(mid)+24] as i32; }
fn m_cap(st:[]u8, mid:i32) i32 { return st[m_base(mid)+25] as i32; }
fn m_dentry(st:[]u8, mid:i32) i32 { return st[m_base(mid)+26] as i32; }
fn m_dr1(st:[]u8, mid:i32) i32 { return st[m_base(mid)+27] as i32; }
fn m_dr2(st:[]u8, mid:i32) i32 { return st[m_base(mid)+28] as i32; }
fn m_dnf(st:[]u8, mid:i32) i32 { return st[m_base(mid)+29] as i32; }
fn m_dvalrel(st:[]u8, mid:i32) i32 { return st[m_base(mid)+30] as i32; }
fn m_dparam(st:[]u8, mid:i32) i32 { return st[m_base(mid)+31] as i32; }
fn m_reason(st:[]u8, mid:i32) i32 { return st[m_base(mid)+6] as i32; }

// ---------- cost counting (frozen rules) ----------
fn tick(st:[]u8) void { set32(st,1296,get32(st,1296)+1); return; }
fn tick_exec(st:[]u8) void { set32(st,1300,get32(st,1300)+1); return; }
fn set_ans(st:[]u8, term:i32, val:i32, via:i32) void {
  set32(st,1308,term); set32(st,1304,val); set32(st,1312,via);
  return;
}

// ---------- scans (fid-ascending, live-only; tick per fid) ----------
fn scan1(st:[]u8, sub:i32, rel:i32) i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let sb:i32=f_sub(st,i);
    let rl:i32=f_rel(st,i);
    let hit:i32=0;
    if(lv==1){ hit=1; }
    if(hit==1){ if(sb != sub){ hit=0; } }
    if(hit==1){ if(rl != rel){ hit=0; } }
    if(hit==1){ return i; }
    i=i+1;
  }
  return -1;
}
fn scan_nv(st:[]u8, sub:i32, valrel:i32) i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let sb:i32=f_sub(st,i);
    let rl:i32=f_rel(st,i);
    let hit:i32=0;
    if(lv==1){ hit=1; }
    if(hit==1){ if(sb != sub){ hit=0; } }
    if(hit==1){ if(rl==valrel){ hit=0; } }
    if(hit==1){ return i; }
    i=i+1;
  }
  return -1;
}
fn scan_val(st:[]u8, node:i32, valrel:i32) i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    tick(st);
    let lv:i32=f_live(st,i);
    let rl:i32=f_rel(st,i);
    let sb:i32=f_sub(st,i);
    let hit:i32=0;
    if(lv==1){ hit=1; }
    if(hit==1){ if(rl != valrel){ hit=0; } }
    if(hit==1){ if(sb != node){ hit=0; } }
    if(hit==1){ return f_obj(st,i); }
    i=i+1;
  }
  return -1;
}

// ---------- teaching ----------
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32) i32 {
  let n:i32=st[0] as i32;
  if(n>=64){ return -1; }
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32) i32 {
  let n:i32=st[1] as i32;
  if(n>=16){ return -1; }
  if(rl>8){ return -1; }
  if(fl>8){ return -1; }
  let b:i32=528+n*32;
  st[b]=20; st[b+1]=1; st[b+2]=start as u8; st[b+3]=end as u8;
  st[b+4]=rl as u8; st[b+5]=fl as u8; st[b+6]=0; st[b+7]=0;
  let k:i32=0;
  while(k<rl){ st[b+8+k]=rs[k]; k=k+1; }
  k=0;
  while(k<fl){ st[b+16+k]=fs[k]; k=k+1; }
  st[b+24]=dom as u8; st[b+25]=cap as u8;
  st[b+26]=0; st[b+27]=0; st[b+28]=0; st[b+29]=0;
  st[b+31]=0;
  let vr:i32=0;
  let fi:i32=0;
  let fnn:i32=st[0] as i32;
  let fnd:i32=0;
  while(fi<fnn){
    let l2:i32=f_live(st,fi);
    let s2:i32=f_sub(st,fi);
    if(l2==1){ if(s2==end){ if(fnd==0){ vr=f_rel(st,fi); fnd=1; } } }
    fi=fi+1;
  }
  st[b+30]=vr as u8;
  if(cap==1){
    let r1:i32=rs[1] as i32;
    let r2:i32=rs[2] as i32;
    let ok:i32=1;
    if(rl<3){ ok=0; }
    let half:i32=rl-1;
    if(half%2 != 0){ ok=0; }
    let j:i32=1;
    while(j<rl){
      let want:i32=r1;
      if(j%2==0){ want=r2; }
      let got:i32=rs[j] as i32;
      if(got != want){ ok=0; }
      j=j+1;
    }
    if(ok==1){
      st[b+26]=rs[0];
      st[b+27]=r1 as u8;
      st[b+28]=r2 as u8;
      st[b+29]=((rl-1)/2) as u8;
      st[b+31]=1;
    }
  }
  st[1]=(n+1) as u8;
  return n;
}
fn ia_edge(st:[]u8, a:i32, b:i32, ty:i32) void {
  let n:i32=st[2] as i32;
  if(n>=64){ return; }
  let o:i32=1040+n*4;
  st[o]=a as u8; st[o+1]=b as u8; st[o+2]=ty as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn mx_snap(st:[]u8) void {
  let i:i32=0;
  while(i<32){ st[1600+i]=st[528+i]; i=i+1; }
  return;
}

// ---------- MAP search ----------
fn find_gen(st:[]u8, cap:i32) i32 {
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    tick(st);
    let lv:i32=m_live(st,mid);
    let cp:i32=m_cap(st,mid);
    let pm:i32=m_dparam(st,mid);
    let hit:i32=0;
    if(lv==1){ hit=1; }
    if(hit==1){ if(cp != cap){ hit=0; } }
    if(hit==1){ if(pm != 1){ hit=0; } }
    if(hit==1){ return mid; }
    mid=mid+1;
  }
  return -1;
}

// ---------- caller-arg selector (structural slots) ----------
fn qarg(s:i32, t:i32, a3:i32, k:i32) i32 {
  if(k==0){ return s; }
  if(k==1){ return t; }
  return a3;
}

// ---------- executors ----------
fn home_exec(st:[]u8, mid:i32, s:i32, t:i32, v:i32) i32 {
  tick_exec(st);
  let de:i32=m_dentry(st,mid);
  let r1:i32=m_dr1(st,mid);
  let r2:i32=m_dr2(st,mid);
  let nfv:i32=m_dnf(st,mid);
  let valrel:i32=m_dvalrel(st,mid);
  let e:i32=scan1(st,s,de);
  if(e<0){ set_ans(st,-2,-2,-1); return 0; }
  let cur:i32=f_obj(st,e);
  let k:i32=0;
  let go:i32=1;
  while(go==1){
    if(k>=nfv){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,r1);
      if(c1<0){ bad=1; }
      let c2:i32=-1;
      let co:i32=0;
      if(bad==0){ co=f_obj(st,c1); c2=scan1(st,co,r2); if(c2<0){ bad=1; } }
      if(bad==0){ cur=f_obj(st,c2); k=k+1; }
      else { go=0; cur=-1; }
    }
  }
  if(cur != t){ set_ans(st,-2,-2,-1); return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ set_ans(st,-2,-2,-1); return 0; }
  }
  set_ans(st,t,v,mid);
  return 1;
}
fn naive_exec(st:[]u8, sm:i32, s:i32, t:i32, v:i32) i32 {
  let de:i32=m_dentry(st,sm);
  let r1:i32=m_dr1(st,sm);
  let r2:i32=m_dr2(st,sm);
  let nfv:i32=m_dnf(st,sm);
  let valrel:i32=m_dvalrel(st,sm);
  let e:i32=scan1(st,s,de);
  if(e<0){ return 0; }
  let cur:i32=f_obj(st,e);
  let k:i32=0;
  let go:i32=1;
  while(go==1){
    if(k>=nfv){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,r1);
      if(c1<0){ bad=1; }
      let c2:i32=-1;
      let co:i32=0;
      if(bad==0){ co=f_obj(st,c1); c2=scan1(st,co,r2); if(c2<0){ bad=1; } }
      if(bad==0){ cur=f_obj(st,c2); k=k+1; }
      else { go=0; cur=-1; }
    }
  }
  if(cur != t){ return 0; }
  if(v>=0){
    let vv:i32=scan_val(st,t,valrel);
    if(vv != v){ return 0; }
  }
  return 1;
}
fn ia_foldwalk(st:[]u8, u:i32, valrel:i32, nf:i32) i32 {
  set32(st,1568,0);
  let s1f:i32=scan_nv(st,u,valrel);
  if(s1f<0){ return -1; }
  let s1:i32=f_rel(st,s1f);
  let a:i32=f_obj(st,s1f);
  let s2f:i32=scan_nv(st,a,valrel);
  if(s2f<0){ return -1; }
  let s2:i32=f_rel(st,s2f);
  let b:i32=f_obj(st,s2f);
  set32(st,1472,a);
  set32(st,1568,1);
  let cur:i32=b;
  let k:i32=2;
  let go:i32=1;
  while(go==1){
    if(k>nf){ go=0; }
    else {
      let bad:i32=0;
      let c1:i32=scan1(st,cur,s1);
      if(c1<0){ bad=1; }
      let co:i32=0;
      if(bad==0){
        co=f_obj(st,c1);
        let na:i32=get32(st,1568);
        set32(st,1472+na*4,co);
        set32(st,1568,na+1);
      }
      let c2:i32=-1;
      if(bad==0){ c2=scan1(st,co,s2); if(c2<0){ bad=1; } }
      if(bad==0){ cur=f_obj(st,c2); k=k+1; }
      else { go=0; cur=-1; }
    }
  }
  return cur;
}
fn ia_check_addends(st:[]u8, valrel:i32) i32 {
  let na:i32=get32(st,1568);
  let i:i32=0;
  let ok:i32=1;
  while(i<na){
    let ad:i32=get32(st,1472+i*4);
    let av:i32=scan_val(st,ad,valrel);
    if(av<0){ ok=0; i=na; }
    else { i=i+1; }
  }
  return ok;
}
fn ia_trial(st:[]u8, sm:i32, psv:i32, ptv:i32, pvv:i32, er:i32) i32 {
  let valrel:i32=m_dvalrel(st,sm);
  let nf:i32=m_dnf(st,sm);
  let e:i32=scan1(st,psv,er);
  if(e<0){ return 0; }
  let u:i32=f_obj(st,e);
  let term:i32=ia_foldwalk(st,u,valrel,nf);
  if(term<0){ return -1; }
  if(term != ptv){ return -2; }
  if(pvv>=0){
    let vv:i32=scan_val(st,ptv,valrel);
    if(vv != pvv){ return -3; }
  }
  let ar:i32=ia_check_addends(st,valrel);
  if(ar==0){ return -4; }
  st[1580]=er as u8;
  return 1;
}
fn cand_seen(st:[]u8, nc:i32, r:i32) i32 {
  let j:i32=0;
  while(j<nc){
    if((st[1584+j] as i32)==r){ return 1; }
    j=j+1;
  }
  return 0;
}
fn build_entry_cands(st:[]u8, psv:i32, valrel:i32) i32 {
  let nf:i32=st[0] as i32;
  let nc:i32=0;
  let fid:i32=0;
  while(fid<nf){
    tick(st);
    let lv:i32=f_live(st,fid);
    let sb:i32=f_sub(st,fid);
    let rl:i32=f_rel(st,fid);
    let cand:i32=0;
    if(lv==1){ cand=1; }
    if(cand==1){ if(sb != psv){ cand=0; } }
    if(cand==1){ if(rl==valrel){ cand=0; } }
    if(cand==1){
      let seen:i32=cand_seen(st,nc,rl);
      if(seen==0){ st[1584+nc]=rl as u8; nc=nc+1; }
    }
    fid=fid+1;
  }
  st[1592]=nc as u8;
  return nc;
}

// ---------- promotion: zero-rel adapter MAP ----------
fn ia_promote(st:[]u8, sm:i32, s:i32, ptv:i32, cap:i32, dom:i32) i32 {
  let n:i32=st[1] as i32;
  let b:i32=528+n*32;
  let er:i32=st[1580] as i32;
  let ps:i32=st[7] as i32;
  let pt:i32=st[8] as i32;
  let pv:i32=st[9] as i32;
  let valrel:i32=m_dvalrel(st,sm);
  st[b]=20; st[b+1]=1; st[b+2]=s as u8; st[b+3]=ptv as u8;
  st[b+4]=0; st[b+5]=0; st[b+6]=sm as u8; st[b+7]=0;
  st[b+24]=dom as u8; st[b+25]=cap as u8;
  st[b+26]=er as u8; st[b+27]=ps as u8; st[b+28]=pt as u8;
  st[b+29]=pv as u8; st[b+30]=valrel as u8; st[b+31]=2;
  st[1]=(n+1) as u8;
  ia_edge(st,n,sm,17);
  return n;
}

// ---------- adapted execution: replay the SOURCE through the adapter ----------
fn ia_exec(st:[]u8, ma:i32, s:i32, t:i32, a3:i32) i32 {
  tick_exec(st);
  let sm:i32=m_reason(st,ma);
  let de:i32=m_dentry(st,ma);
  let ps:i32=m_dr1(st,ma);
  let pt:i32=m_dr2(st,ma);
  let pvslot:i32=m_dnf(st,ma);
  let valrel:i32=m_dvalrel(st,ma);
  let nf:i32=m_dnf(st,sm);
  let psv:i32=qarg(s,t,a3,ps);
  let ptv:i32=qarg(s,t,a3,pt);
  let pvv:i32=-1;
  if(pvslot != 255){ pvv=qarg(s,t,a3,pvslot); }
  let nff:i32=st[0] as i32;
  let fid:i32=0;
  let done:i32=0;
  while(fid<nff){
    tick(st);
    let lv:i32=f_live(st,fid);
    let sb:i32=f_sub(st,fid);
    let rl:i32=f_rel(st,fid);
    let cand:i32=0;
    if(lv==1){ cand=1; }
    if(cand==1){ if(sb != psv){ cand=0; } }
    if(cand==1){ if(rl != de){ cand=0; } }
    if(cand==1){
      let u:i32=f_obj(st,fid);
      let term:i32=ia_foldwalk(st,u,valrel,nf);
      let bad:i32=0;
      if(term != ptv){ bad=1; }
      else {
        if(pvv>=0){
          let vv:i32=scan_val(st,ptv,valrel);
          if(vv != pvv){ bad=1; }
        }
      }
      let ar:i32=1;
      if(bad==0){ ar=ia_check_addends(st,valrel); }
      if(ar==1){
        if(bad==0){
          let repv:i32=pvv;
          if(repv<0){ repv=scan_val(st,ptv,valrel); }
          set_ans(st,ptv,repv,ma);
          done=1;
          fid=nff;
        }
      }
    }
    if(done==0){ fid=fid+1; }
  }
  if(done==0){ set_ans(st,-2,-2,-1); }
  return done;
}

// ---------- trace helpers ----------
fn trace_cands(st:[]u8, nc:i32, ob:[]u8, atp:[]u8) void {
  ia_p(ob,atp,"IA-CANDIDATES ");
  let ci:i32=0;
  while(ci<nc){
    if(ci>0){ ia_p(ob,atp,","); }
    ia_pi(ob,atp,st[1584+ci] as i32);
    ci=ci+1;
  }
  ia_pnl(ob,atp);
  return;
}
fn trace_trial(ps:i32, pt:i32, pv:i32, er:i32, r:i32, ob:[]u8, atp:[]u8) void {
  ia_p(ob,atp,"IA-TRIAL ps=");
  ia_pi(ob,atp,ps);
  ia_p(ob,atp," pt=");
  ia_pi(ob,atp,pt);
  ia_p(ob,atp," pv=");
  ia_pi(ob,atp,pv);
  ia_p(ob,atp," er=");
  ia_pi(ob,atp,er);
  if(r==1){ ia_p(ob,atp," ACCEPT\n"); return; }
  if(r==0){ ia_p(ob,atp," FAIL-ENTRY\n"); return; }
  if(r==-1){ ia_p(ob,atp," FAIL-WALK\n"); return; }
  if(r==-2){ ia_p(ob,atp," FAIL-TERM\n"); return; }
  if(r==-3){ ia_p(ob,atp," FAIL-VAL\n"); return; }
  ia_p(ob,atp," FAIL-ARITY\n");
  return;
}

// ---------- interface adaptation ----------
fn ia_adapt(st:[]u8, s:i32, t:i32, a3:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8) void {
  st[4]=1; st[5]=1;
  let sm:i32=find_gen(st,cap);
  if(sm<0){
    ia_p(ob,atp,"IA-ADAPT-FAIL reason=no-source\n");
    set_ans(st,-2,-2,-1);
    return;
  }
  st[6]=sm as u8;
  ia_p(ob,atp,"IA-SRC id=");
  ia_pi(ob,atp,sm);
  ia_pnl(ob,atp);
  let valrel:i32=m_dvalrel(st,sm);
  let ps:i32=0;
  let done:i32=0;
  while(ps<2){
    let pt:i32=1-ps;
    let psv:i32=qarg(s,t,a3,ps);
    let ptv:i32=qarg(s,t,a3,pt);
    let nc:i32=build_entry_cands(st,psv,valrel);
    trace_cands(st,nc,ob,atp);
    let ei:i32=0;
    while(ei<nc){
      let er:i32=st[1584+ei] as i32;
      let pvi:i32=0;
      while(pvi<2){
        let pv:i32=2;
        if(pvi==1){ pv=255; }
        let pvv:i32=a3;
        if(pvi==1){ pvv=-1; }
        st[12]=((st[12] as i32)+1) as u8;
        let r:i32=ia_trial(st,sm,psv,ptv,pvv,er);
        trace_trial(ps,pt,pv,er,r,ob,atp);
        if(r==1){
          st[7]=ps as u8;
          st[8]=pt as u8;
          st[9]=pv as u8;
          st[10]=er as u8;
          st[13]=1;
          ia_p(ob,atp,"IA-ACCEPT ps=");
          ia_pi(ob,atp,ps);
          ia_p(ob,atp," pt=");
          ia_pi(ob,atp,pt);
          ia_p(ob,atp," pv=");
          ia_pi(ob,atp,pv);
          ia_p(ob,atp," er=");
          ia_pi(ob,atp,er);
          ia_pnl(ob,atp);
          let nid:i32=ia_promote(st,sm,s,ptv,cap,dom);
          ia_p(ob,atp,"IA-PROMOTE id=");
          ia_pi(ob,atp,nid);
          ia_pnl(ob,atp);
          ia_exec(st,nid,s,t,a3);
          done=1;
          pvi=2; ei=nc; ps=2;
        }
        else {
          st[11]=((st[11] as i32)+1) as u8;
        }
        if(done==0){ pvi=pvi+1; }
      }
      if(done==0){ ei=ei+1; }
    }
    if(done==0){ ps=ps+1; }
  }
  if(done==0){ set_ans(st,-2,-2,-1); }
  return;
}
fn ia_query(st:[]u8, s:i32, t:i32, a3:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8) void {
  set32(st,1296,0); set32(st,1300,0);
  set_ans(st,-2,-2,-1);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  let done:i32=0;
  let saw_adapt:i32=0;
  while(mid<nm){
    tick(st);
    let lv:i32=m_live(st,mid);
    let hit:i32=0;
    if(lv==1){ hit=1; }
    if(hit==1){ if(m_cap(st,mid) != cap){ hit=0; } }
    if(hit==1){ if(m_dom(st,mid) != dom){ hit=0; } }
    if(hit==1){ if(m_start(st,mid) != s){ hit=0; } }
    if(hit==1){
      let pm:i32=m_dparam(st,mid);
      let d:i32=0;
      if(pm==1){ d=home_exec(st,mid,s,t,a3); }
      else { d=ia_exec(st,mid,s,t,a3); saw_adapt=1; }
      if(d==1){ done=1; mid=nm; }
    }
    if(done==0){ mid=mid+1; }
  }
  if(done==0){
  if(saw_adapt==0){
    let sm:i32=find_gen(st,cap);
    if(sm<0){
      ia_p(ob,atp,"IA-NAIVE-NOSRC\n");
      st[3]=0;
    }
    else {
      let nr:i32=naive_exec(st,sm,s,t,a3);
      st[3]=nr as u8;
      if(nr==1){
        ia_p(ob,atp,"IA-NAIVE-OK sm=");
        ia_pi(ob,atp,sm);
        ia_pnl(ob,atp);
        set_ans(st,t,a3,sm);
        done=1;
      }
      else {
        ia_p(ob,atp,"IA-NAIVE-FAIL sm=");
        ia_pi(ob,atp,sm);
        ia_pnl(ob,atp);
      }
    }
    if(done==0){
      let nok:i32=st[3] as i32;
      if(nok==0){ ia_adapt(st,s,t,a3,cap,dom,ob,atp); }
    }
  }
  }
  return;
}
// ia_world.zag -- L2 IFACE-XDOMAIN world: fact table + mX teaching.
// Builder-designed world (not adversary-designed). All world literals
// live here; ia_learner.zag names none of them.

// facts 0..19: domain A (arithmetic ADD, home of mX) + domain B
// (planning cost; decoy entry rel 9 chain + true entry rel 17 chain)
fn teach_world(st:[]u8) void {
  f_teach(st,100,18,60);
  f_teach(st,60,5,61);
  f_teach(st,61,6,62);
  f_teach(st,62,5,63);
  f_teach(st,63,6,64);
  f_teach(st,61,2,3);
  f_teach(st,63,2,4);
  f_teach(st,64,2,7);
  f_teach(st,50,9,71);
  f_teach(st,71,15,72);
  f_teach(st,72,16,73);
  f_teach(st,73,2,1);
  f_teach(st,50,17,74);
  f_teach(st,74,15,75);
  f_teach(st,75,16,76);
  f_teach(st,76,15,77);
  f_teach(st,77,16,78);
  f_teach(st,75,2,20);
  f_teach(st,77,2,30);
  f_teach(st,78,2,50);
  return;
}

// mX (id 0): GENERAL parametric ADD MAP, dom=A(1), cap=ADD(1)
fn teach_maps(st:[]u8) void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6;
  fs[0]=0; fs[1]=1; fs[2]=2; fs[3]=3; fs[4]=4;
  m_teach(st,rs,5,fs,5,100,64,1,1);
  return;
}
// ia_driver.zag -- L2 IFACE-XDOMAIN experiment driver.
// Two arms (FULL / ABLATE-X), per-query S/E/ANS capture, source-record
// snapshot comparison (K5), in-Zag kill-bar evaluation, main +
// single-syscall stdout flush.
// Query slots: 0=QA 1=Q2 2=Q2B 3=Q2C 4=Q2D; 5 i32s each @qi*20
// (S,E,term,val,via). Arm-level @100: naive_ok, @104: trial_total,
// @108: trial_fail_n, @112: ad_ps, @116: ad_pt, @120: ad_pv,
// @124: ad_entry, @128: nm, @132: ne, @136: ebad, @140: snap_ok,
// @144: ma_rlen, @148: adapt_entered, @152: t17 count.

fn do_q(st:[]u8, res:[]u8, qi:i32, s:i32, t:i32, a3:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8, name:[]u8) void {
  ia_query(st,s,t,a3,cap,dom,ob,atp);
  let o:i32=qi*20;
  set32(res,o,get32(st,1296));
  set32(res,o+4,get32(st,1300));
  set32(res,o+8,get32(st,1308));
  set32(res,o+12,get32(st,1304));
  set32(res,o+16,get32(st,1312));
  ia_p(ob,atp,"Q ");
  ia_p(ob,atp,name);
  ia_p(ob,atp," S=");
  ia_pi(ob,atp,get32(st,1296));
  ia_p(ob,atp," E=");
  ia_pi(ob,atp,get32(st,1300));
  ia_p(ob,atp," term=");
  ia_pi(ob,atp,get32(st,1308));
  ia_p(ob,atp," val=");
  ia_pi(ob,atp,get32(st,1304));
  ia_p(ob,atp," via=");
  ia_pi(ob,atp,get32(st,1312));
  ia_pnl(ob,atp);
  return;
}
fn arm_close(st:[]u8, res:[]u8) void {
  set32(res,100,st[3] as i32);
  set32(res,104,st[12] as i32);
  set32(res,108,st[11] as i32);
  set32(res,112,st[7] as i32);
  set32(res,116,st[8] as i32);
  set32(res,120,st[9] as i32);
  set32(res,124,st[10] as i32);
  set32(res,148,st[5] as i32);
  let nm:i32=st[1] as i32;
  let ne:i32=st[2] as i32;
  set32(res,128,nm);
  set32(res,132,ne);
  let ec:i32=0;
  let bad:i32=0;
  let ei:i32=0;
  while(ei<ne){
    let ty:i32=st[1040+ei*4+2] as i32;
    if(ty==17){ ec=ec+1; }
    else { bad=1; }
    ei=ei+1;
  }
  set32(res,136,bad);
  set32(res,152,ec);
  let ok:i32=1;
  let i:i32=0;
  while(i<32){
    if(st[1600+i] != st[528+i]){ ok=0; }
    i=i+1;
  }
  set32(res,140,ok);
  let mr:i32=-1;
  if(nm>=2){ mr=st[528+32+4] as i32; }
  set32(res,144,mr);
  return;
}
fn run_arm(ob:[]u8, atp:[]u8, arm:i32, res:[]u8) void {
  let st:[]u8=z_alloc(2048);
  teach_world(st);
  teach_maps(st);
  mx_snap(st);
  if(arm==0){ ia_p(ob,atp,"ARM FULL\n"); }
  else { ia_p(ob,atp,"ARM ABLATE-X\n"); }
  if(arm==1){
    st[528+1]=0;
  }
  do_q(st,res,0,100,64,7,1,1,ob,atp,"QA");
  do_q(st,res,1,50,78,99,1,2,ob,atp,"Q2");
  if(arm==1){ arm_close(st,res); return; }
  do_q(st,res,2,50,78,99,1,2,ob,atp,"Q2B");
  do_q(st,res,3,50,78,7,1,2,ob,atp,"Q2C");
  do_q(st,res,4,50,73,99,1,2,ob,atp,"Q2D");
  arm_close(st,res);
  return;
}
fn qf(res:[]u8, qi:i32, f:i32) i32 { return get32(res,qi*20+f*4); }
fn d_bar(ob:[]u8, atp:[]u8, name:[]u8, p:i32) void {
  ia_p(ob,atp,name);
  ia_p(ob,atp,"=");
  if(p==1){ ia_p(ob,atp,"PASS "); } else { ia_p(ob,atp,"FAIL "); }
  return;
}
fn ck_count(ob:[]u8, atp:[]u8, res:[]u8, qi:i32, fs:i32, fe:i32, tag:[]u8) i32 {
  let s:i32=qf(res,qi,0);
  let e:i32=qf(res,qi,1);
  if(s != fs){ ia_p(ob,atp,"FALSIFIER F-COUNT "); ia_p(ob,atp,tag); ia_p(ob,atp," S\n"); return 1; }
  if(e != fe){ ia_p(ob,atp,"FALSIFIER F-COUNT "); ia_p(ob,atp,tag); ia_p(ob,atp," E\n"); return 1; }
  return 0;
}
fn main() i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  ia_p(ob,atp,"L2-IFACE-XDOMAIN-START\n");
  let rf:[]u8=z_alloc(256);
  let ra:[]u8=z_alloc(256);
  run_arm(ob,atp,0,rf);
  run_arm(ob,atp,1,ra);
  let ff:i32=0;
  ff=ff+ck_count(ob,atp,rf,0,24,1,"FULL-QA");
  ff=ff+ck_count(ob,atp,rf,1,482,1,"FULL-Q2");
  ff=ff+ck_count(ob,atp,rf,2,134,1,"FULL-Q2B");
  ff=ff+ck_count(ob,atp,rf,3,134,1,"FULL-Q2C");
  ff=ff+ck_count(ob,atp,rf,4,84,1,"FULL-Q2D");
  ff=ff+ck_count(ob,atp,ra,0,3,0,"ABL-QA");
  ff=ff+ck_count(ob,atp,ra,1,3,0,"ABL-Q2");
  if(get32(rf,136) != 0){ ia_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n"); ff=ff+1; }
  if(get32(ra,136) != 0){ ia_p(ob,atp,"FALSIFIER F-EDGE-NEW ABL\n"); ff=ff+1; }
  if(get32(rf,152) != 1){ ia_p(ob,atp,"FALSIFIER F-T17-FULL\n"); ff=ff+1; }
  if(get32(ra,152) != 0){ ia_p(ob,atp,"FALSIFIER F-T17-ABL\n"); ff=ff+1; }
  if(get32(rf,100) != 0){ ia_p(ob,atp,"FALSIFIER F-NAIVE\n"); ff=ff+1; }
  if(qf(rf,1,4) != 1){ ia_p(ob,atp,"FALSIFIER F-NOADAPT\n"); ff=ff+1; }
  if(get32(rf,112) != 0){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,116) != 1){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,120) != 255){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,124) != 17){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,104) != 4){ ia_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,108) != 3){ ia_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,140) != 1){ ia_p(ob,atp,"FALSIFIER F-CORE\n"); ff=ff+1; }
  if(get32(rf,144) != 0){ ia_p(ob,atp,"FALSIFIER F-CORE\n"); ff=ff+1; }
  if(qf(rf,2,4) != 1){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,2,2) != 78){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,2,3) != 50){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,3,4) != 1){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,3,2) != 78){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,3,3) != 50){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,4,4) != -1){ ia_p(ob,atp,"FALSIFIER F-Q2D\n"); ff=ff+1; }
  if(qf(ra,1,2) != -2){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(qf(ra,1,4) != -1){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,128) != 1){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,132) != 0){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(qf(ra,0,2) != -2){ ia_p(ob,atp,"FALSIFIER F-ABLX-QA\n"); ff=ff+1; }
  let k1:i32=0;
  if(qf(rf,0,4)==0){ if(qf(rf,0,2)==64){ if(qf(rf,0,3)==7){ k1=1; } } }
  let k2:i32=0;
  if(get32(rf,100)==0){ k2=1; }
  let k3:i32=0;
  if(get32(rf,104)==4){ if(get32(rf,108)==3){ if(get32(rf,112)==0){
    if(get32(rf,116)==1){ if(get32(rf,120)==255){ if(get32(rf,124)==17){ k3=1; } } } } } }
  let k4:i32=0;
  if(qf(rf,1,4)==1){ if(qf(rf,1,2)==78){ if(qf(rf,1,3)==50){ k4=1; } } }
  let k5:i32=0;
  if(get32(rf,140)==1){ if(get32(rf,144)==0){ if(qf(rf,0,4)==0){ k5=1; } } }
  let k8:i32=0;
  if(qf(ra,1,2)==-2){ if(qf(ra,1,4)==-1){ if(get32(ra,128)==1){
    if(get32(ra,132)==0){ if(qf(ra,0,2)==-2){ k8=1; } } } } }
  ia_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ia_pnl(ob,atp);
  ia_p(ob,atp,"FALSIFIERS ");
  ia_pi(ob,atp,ff);
  ia_pnl(ob,atp);
  ia_p(ob,atp,"L2-IFACE-XDOMAIN-END\n");
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

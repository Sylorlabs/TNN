// ia_world.zag -- L2 IFACE-XDOMAIN world: fact table + mX teaching.
// Builder-designed world (not adversary-designed). All world literals
// live here; ia_learner.zag names none of them.

// facts 0..19: domain A (arithmetic ADD, home of mX) + domain B
// (planning cost; decoy entry rel 9 chain + true entry rel 17 chain)
fn teach_world(st:[]u8) void {
  f_teach(st,100,18,60);
  f_teach(st,60,5,61);
  f_teach(st,61,6,62);
  f_teach(st,62,5,63);
  f_teach(st,63,6,64);
  f_teach(st,61,2,3);
  f_teach(st,63,2,4);
  f_teach(st,64,2,7);
  f_teach(st,50,9,71);
  f_teach(st,71,15,72);
  f_teach(st,72,16,73);
  f_teach(st,73,2,1);
  f_teach(st,50,17,74);
  f_teach(st,74,15,75);
  f_teach(st,75,16,76);
  f_teach(st,76,15,77);
  f_teach(st,77,16,78);
  f_teach(st,75,2,20);
  f_teach(st,77,2,30);
  f_teach(st,78,2,50);
  return;
}

// mX (id 0): GENERAL parametric ADD MAP, dom=A(1), cap=ADD(1)
fn teach_maps(st:[]u8) void {
  let rs:[]u8=z_alloc(8);
  let fs:[]u8=z_alloc(8);
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6;
  fs[0]=0; fs[1]=1; fs[2]=2; fs[3]=3; fs[4]=4;
  m_teach(st,rs,5,fs,5,100,64,1,1);
  return;
}

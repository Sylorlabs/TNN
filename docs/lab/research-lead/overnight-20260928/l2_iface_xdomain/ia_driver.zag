// ia_driver.zag -- L2 IFACE-XDOMAIN experiment driver.
// Two arms (FULL / ABLATE-X), per-query S/E/ANS capture, source-record
// snapshot comparison (K5), in-Zag kill-bar evaluation, main +
// single-syscall stdout flush.
// Query slots: 0=QA 1=Q2 2=Q2B 3=Q2C 4=Q2D; 5 i32s each @qi*20
// (S,E,term,val,via). Arm-level @100: naive_ok, @104: trial_total,
// @108: trial_fail_n, @112: ad_ps, @116: ad_pt, @120: ad_pv,
// @124: ad_entry, @128: nm, @132: ne, @136: ebad, @140: snap_ok,
// @144: ma_rlen, @148: adapt_entered, @152: t17 count.

fn do_q(st:[]u8, res:[]u8, qi:i32, s:i32, t:i32, a3:i32, cap:i32, dom:i32, ob:[]u8, atp:[]u8, name:[]u8) void {
  ia_query(st,s,t,a3,cap,dom,ob,atp);
  let o:i32=qi*20;
  set32(res,o,get32(st,1296));
  set32(res,o+4,get32(st,1300));
  set32(res,o+8,get32(st,1308));
  set32(res,o+12,get32(st,1304));
  set32(res,o+16,get32(st,1312));
  ia_p(ob,atp,"Q ");
  ia_p(ob,atp,name);
  ia_p(ob,atp," S=");
  ia_pi(ob,atp,get32(st,1296));
  ia_p(ob,atp," E=");
  ia_pi(ob,atp,get32(st,1300));
  ia_p(ob,atp," term=");
  ia_pi(ob,atp,get32(st,1308));
  ia_p(ob,atp," val=");
  ia_pi(ob,atp,get32(st,1304));
  ia_p(ob,atp," via=");
  ia_pi(ob,atp,get32(st,1312));
  ia_pnl(ob,atp);
  return;
}
fn arm_close(st:[]u8, res:[]u8) void {
  set32(res,100,st[3] as i32);
  set32(res,104,st[12] as i32);
  set32(res,108,st[11] as i32);
  set32(res,112,st[7] as i32);
  set32(res,116,st[8] as i32);
  set32(res,120,st[9] as i32);
  set32(res,124,st[10] as i32);
  set32(res,148,st[5] as i32);
  let nm:i32=st[1] as i32;
  let ne:i32=st[2] as i32;
  set32(res,128,nm);
  set32(res,132,ne);
  let ec:i32=0;
  let bad:i32=0;
  let ei:i32=0;
  while(ei<ne){
    let ty:i32=st[1040+ei*4+2] as i32;
    if(ty==17){ ec=ec+1; }
    else { bad=1; }
    ei=ei+1;
  }
  set32(res,136,bad);
  set32(res,152,ec);
  let ok:i32=1;
  let i:i32=0;
  while(i<32){
    if(st[1600+i] != st[528+i]){ ok=0; }
    i=i+1;
  }
  set32(res,140,ok);
  let mr:i32=-1;
  if(nm>=2){ mr=st[528+32+4] as i32; }
  set32(res,144,mr);
  return;
}
fn run_arm(ob:[]u8, atp:[]u8, arm:i32, res:[]u8) void {
  let st:[]u8=z_alloc(2048);
  teach_world(st);
  teach_maps(st);
  mx_snap(st);
  if(arm==0){ ia_p(ob,atp,"ARM FULL\n"); }
  else { ia_p(ob,atp,"ARM ABLATE-X\n"); }
  if(arm==1){
    st[528+1]=0;
  }
  do_q(st,res,0,100,64,7,1,1,ob,atp,"QA");
  do_q(st,res,1,50,78,99,1,2,ob,atp,"Q2");
  if(arm==1){ arm_close(st,res); return; }
  do_q(st,res,2,50,78,99,1,2,ob,atp,"Q2B");
  do_q(st,res,3,50,78,7,1,2,ob,atp,"Q2C");
  do_q(st,res,4,50,73,99,1,2,ob,atp,"Q2D");
  arm_close(st,res);
  return;
}
fn qf(res:[]u8, qi:i32, f:i32) i32 { return get32(res,qi*20+f*4); }
fn d_bar(ob:[]u8, atp:[]u8, name:[]u8, p:i32) void {
  ia_p(ob,atp,name);
  ia_p(ob,atp,"=");
  if(p==1){ ia_p(ob,atp,"PASS "); } else { ia_p(ob,atp,"FAIL "); }
  return;
}
fn ck_count(ob:[]u8, atp:[]u8, res:[]u8, qi:i32, fs:i32, fe:i32, tag:[]u8) i32 {
  let s:i32=qf(res,qi,0);
  let e:i32=qf(res,qi,1);
  if(s != fs){ ia_p(ob,atp,"FALSIFIER F-COUNT "); ia_p(ob,atp,tag); ia_p(ob,atp," S\n"); return 1; }
  if(e != fe){ ia_p(ob,atp,"FALSIFIER F-COUNT "); ia_p(ob,atp,tag); ia_p(ob,atp," E\n"); return 1; }
  return 0;
}
fn main() i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  ia_p(ob,atp,"L2-IFACE-XDOMAIN-START\n");
  let rf:[]u8=z_alloc(256);
  let ra:[]u8=z_alloc(256);
  run_arm(ob,atp,0,rf);
  run_arm(ob,atp,1,ra);
  let ff:i32=0;
  ff=ff+ck_count(ob,atp,rf,0,24,1,"FULL-QA");
  ff=ff+ck_count(ob,atp,rf,1,482,1,"FULL-Q2");
  ff=ff+ck_count(ob,atp,rf,2,134,1,"FULL-Q2B");
  ff=ff+ck_count(ob,atp,rf,3,134,1,"FULL-Q2C");
  ff=ff+ck_count(ob,atp,rf,4,84,1,"FULL-Q2D");
  ff=ff+ck_count(ob,atp,ra,0,3,0,"ABL-QA");
  ff=ff+ck_count(ob,atp,ra,1,3,0,"ABL-Q2");
  if(get32(rf,136) != 0){ ia_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n"); ff=ff+1; }
  if(get32(ra,136) != 0){ ia_p(ob,atp,"FALSIFIER F-EDGE-NEW ABL\n"); ff=ff+1; }
  if(get32(rf,152) != 1){ ia_p(ob,atp,"FALSIFIER F-T17-FULL\n"); ff=ff+1; }
  if(get32(ra,152) != 0){ ia_p(ob,atp,"FALSIFIER F-T17-ABL\n"); ff=ff+1; }
  if(get32(rf,100) != 0){ ia_p(ob,atp,"FALSIFIER F-NAIVE\n"); ff=ff+1; }
  if(qf(rf,1,4) != 1){ ia_p(ob,atp,"FALSIFIER F-NOADAPT\n"); ff=ff+1; }
  if(get32(rf,112) != 0){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,116) != 1){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,120) != 255){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,124) != 17){ ia_p(ob,atp,"FALSIFIER F-BIND\n"); ff=ff+1; }
  if(get32(rf,104) != 4){ ia_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,108) != 3){ ia_p(ob,atp,"FALSIFIER F-TRIAL\n"); ff=ff+1; }
  if(get32(rf,140) != 1){ ia_p(ob,atp,"FALSIFIER F-CORE\n"); ff=ff+1; }
  if(get32(rf,144) != 0){ ia_p(ob,atp,"FALSIFIER F-CORE\n"); ff=ff+1; }
  if(qf(rf,2,4) != 1){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,2,2) != 78){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,2,3) != 50){ ia_p(ob,atp,"FALSIFIER F-Q2B\n"); ff=ff+1; }
  if(qf(rf,3,4) != 1){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,3,2) != 78){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,3,3) != 50){ ia_p(ob,atp,"FALSIFIER F-Q2C\n"); ff=ff+1; }
  if(qf(rf,4,4) != -1){ ia_p(ob,atp,"FALSIFIER F-Q2D\n"); ff=ff+1; }
  if(qf(ra,1,2) != -2){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(qf(ra,1,4) != -1){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,128) != 1){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(get32(ra,132) != 0){ ia_p(ob,atp,"FALSIFIER F-ABLX\n"); ff=ff+1; }
  if(qf(ra,0,2) != -2){ ia_p(ob,atp,"FALSIFIER F-ABLX-QA\n"); ff=ff+1; }
  let k1:i32=0;
  if(qf(rf,0,4)==0){ if(qf(rf,0,2)==64){ if(qf(rf,0,3)==7){ k1=1; } } }
  let k2:i32=0;
  if(get32(rf,100)==0){ k2=1; }
  let k3:i32=0;
  if(get32(rf,104)==4){ if(get32(rf,108)==3){ if(get32(rf,112)==0){
    if(get32(rf,116)==1){ if(get32(rf,120)==255){ if(get32(rf,124)==17){ k3=1; } } } } } }
  let k4:i32=0;
  if(qf(rf,1,4)==1){ if(qf(rf,1,2)==78){ if(qf(rf,1,3)==50){ k4=1; } } }
  let k5:i32=0;
  if(get32(rf,140)==1){ if(get32(rf,144)==0){ if(qf(rf,0,4)==0){ k5=1; } } }
  let k8:i32=0;
  if(qf(ra,1,2)==-2){ if(qf(ra,1,4)==-1){ if(get32(ra,128)==1){
    if(get32(ra,132)==0){ if(qf(ra,0,2)==-2){ k8=1; } } } } }
  ia_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ia_pnl(ob,atp);
  ia_p(ob,atp,"FALSIFIERS ");
  ia_pi(ob,atp,ff);
  ia_pnl(ob,atp);
  ia_p(ob,atp,"L2-IFACE-XDOMAIN-END\n");
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

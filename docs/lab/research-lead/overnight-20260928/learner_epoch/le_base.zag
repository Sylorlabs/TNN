// c3_base.zag -- base for the cogops-3way battery.
// Alloc, little-endian i32 access, output helpers, world arena,
// fact store, and the three researcher-supplied generic procedures:
// ret_gen (id 0, RETRIEVE), vfy_gen (id 1, VERIFY),
// cnt_gen (id 4, COUNT).
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- world epoch: stamped by the learner's own world-mutation ----
// ---- operations, never by stage code. The epoch lives at state ----
// ---- slot 931. sg/ss are defined later (module file), so the ----
// ---- stamping helpers use get32/set32 directly on byte 931*4. ----
fn w_epoch_bump(S:[]u8)void {
  let b:i32=931*4;
  let e:i32=get32(S,b);
  set32(S,b,e+1);
  return;
}
// read accessor: stage code never names the epoch cell directly.
fn w_epoch_get(S:[]u8)i32 {
  return get32(S,931*4);
}
// ---- world arena: 0: nf; 4: facts, 64 * 12 bytes (s, r, o) ----
fn world_new()[]u8 { return z_alloc(4096); }
// fact_add: the learner's world-mutation operation. The mutation
// itself stamps the epoch, unilaterally: no caller bump call is
// needed or allowed. Stamps only on a real add (n<64 guard), so a
// rejected add on a full world is not a mutation.
fn fact_add(S:[]u8,A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    set32(A,0,n+1);
    w_epoch_bump(S);
  }
  return;
}
// fact_set_obj: in-place object mutation through the learner's world
// interface. Stamps the epoch exactly like fact_add (conservative:
// stamps even if the new object equals the old one; the checksum
// stays the precise content signal).
fn fact_set_obj(S:[]u8,A:[]u8,idx:i32,o:i32)void {
  set32(A,4+idx*12+8,o);
  w_epoch_bump(S);
  return;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// Writes [nsubs, s0, s1, ...] into out at offset oo; returns nsubs.
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// Distinct-object count: for each subject in sb[so..], scans ALL facts
// and collects distinct objects o with (subj, rel, o). Returns the
// distinct count. Cost = nsubs * nfacts fact checks (dedup compares
// not counted). seen: scratch [nseen, objs...], reset on entry.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let nf:i32=get32(A,0);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<64){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}

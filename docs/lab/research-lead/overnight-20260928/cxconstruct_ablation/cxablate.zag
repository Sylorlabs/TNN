// cxablate.zag -- H-CAUSALEXP-CONSTRUCT ablation study (step 8).
// Pure Zag. No Python anywhere.
//
// Reimplements the full learner as an anchor (P-AB4), then runs five
// ablations:
//   mode 0: full learner (anchor; must reproduce builder selections)
//   mode 1: AB1 no disagreement filter (first-with-observe)
//   mode 2: AB2 no simulation for selection (oracle-stopped real-world search)
//   mode 3: AB3 depth 5 only (no iterative deepening)
//   mode 4: AB4 reverse enumeration order
//   mode 5: AB5 MAXD=3
//
// Worlds: A: H0=[(X,Z,2),(Z,Y,0)], H1=[(X,Y,1)].
//         B: H0=[(X,Z,3),(Z,Y,0)], H1=[(X,Y,2)].
// Configs: 0=(A,H0), 1=(A,H1), 2=(B,H0), 3=(B,H1).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn pow4(d:i32)i32 {
  let t:i32=1;
  let k:i32=0;
  while(k<d){t=t*4; k=k+1;}
  return t;
}

// ============ hypothesis rules (DATA) ============
fn n_rules(w:i32,h:i32)i32 {
  if(w==0){
    if(h==0){return 2;}
    return 1;
  }
  if(h==0){return 2;}
  return 1;
}
fn get_rule(w:i32,h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(w==0){
    if(h==0){
      if(r==0){src=0;dst=1;delay=2;}
      else{src=1;dst=2;delay=0;}
    } else {
      src=0;dst=2;delay=1;
    }
  } else {
    if(h==0){
      if(r==0){src=0;dst=1;delay=3;}
      else{src=1;dst=2;delay=0;}
    } else {
      src=0;dst=2;delay=2;
    }
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}

// ============ generic simulator ============
fn step(w:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=n_rules(w,h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        get_rule(w,h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
fn sim_seq(w:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(w,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
// decode si into seq of length d (base-4, lexicographic)
fn decode(si:i32,d:i32,seq:[]u8)void {
  let div:i32=1;
  let p:i32=0;
  while(p<d-1){div=div*4; p=p+1;}
  let rem:i32=si;
  let i:i32=0;
  while(i<d){
    seq[i]=(rem/div) as u8;
    rem=rem%div;
    if(div>1){div=div/4;}
    i=i+1;
  }
  return;
}

// ============ sealed true world ============
fn world_of(cfg:i32)i32 {
  if(cfg<2){return 0;}
  return 1;
}
fn true_hypo_of(cfg:i32)i32 {
  if(cfg==0){return 0;}
  if(cfg==1){return 1;}
  if(cfg==2){return 0;}
  return 1;
}
fn world_step(cfg:i32,st:[]u8,a:i32)i32 {
  return step(world_of(cfg),true_hypo_of(cfg),st,a);
}

// ============ emit helpers ============
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else{emit("OZ");}
  return;
}
fn emit_seq2(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}

// ============ selection (parameterized by mode) ============
// out: seq buffer (len 6), returns len or -1; sets *checked_out and *real_out.
// mode 0: full (d=1..5, forward, filter)
// mode 1: AB1 (d=1..5, forward, first-with-observe, no filter)
// mode 3: AB3 (d=5 only, forward, filter)
// mode 4: AB4 (d=1..5, reverse, filter)
// mode 5: AB5 (d=1..3, forward, filter)
fn select(w:i32,mode:i32,seq_out:[]u8,checked_out:[]u8,real_out:[]u8)i32 {
  let dmin:i32=1;
  let dmax:i32=5;
  if(mode==3){dmin=5;}
  if(mode==5){dmax=3;}
  let rev:i32=0;
  if(mode==4){rev=1;}
  let nofilter:i32=0;
  if(mode==1){nofilter=1;}
  let found:i32=0;
  let flen:i32=-1;
  let checked:i32=0;
  let d:i32=dmin;
  while(d<=dmax){
    if(found==1){break;}
    let total:i32=pow4(d);
    let si:i32=0;
    if(rev==1){si=total-1;}
    while(1){
      if(rev==0 && si>=total){break;}
      if(rev==1 && si<0){break;}
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      decode(si,d,seq);
      if(has_observe(seq,d)==1){
        checked=checked+1;
        let take:i32=0;
        if(nofilter==1){
          take=1;
        } else {
          let q0:i32=sim_seq(w,0,seq,d);
          let q1:i32=sim_seq(w,1,seq,d);
          if(q0!=q1){take=1;}
        }
        if(take==1){
          found=1;
          flen=d;
          let c:i32=0;
          while(c<d){seq_out[c]=seq[c]; c=c+1;}
        }
      }
      if(rev==0){si=si+1;} else {si=si-1;}
    }
    d=d+1;
  }
  set32(checked_out,0,checked);
  set32(real_out,0,0);
  return flen;
}

// ============ AB2: oracle-stopped real-world search ============
// Returns len or -1; sets checked and real_actions.
fn select_ab2(w:i32,cfg:i32,seq_out:[]u8,checked_out:[]u8,real_out:[]u8)i32 {
  let found:i32=0;
  let flen:i32=-1;
  let checked:i32=0;
  let ract:i32=0;
  let d:i32=1;
  while(d<=5){
    if(found==1){break;}
    let total:i32=pow4(d);
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(6);
      decode(si,d,seq);
      if(has_observe(seq,d)==1){
        checked=checked+1;
        // learner executes in the real world (fresh state each time)
        let rst:[]u8=z_alloc(32);
        let j:i32=0;
        while(j<d){
          world_step(cfg,rst,seq[j] as i32);
          ract=ract+1;
          j=j+1;
        }
        // oracle (measurement only): would hypotheses disagree?
        let q0:i32=sim_seq(w,0,seq,d);
        let q1:i32=sim_seq(w,1,seq,d);
        if(q0!=q1){
          found=1;
          flen=d;
          let c:i32=0;
          while(c<d){seq_out[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    d=d+1;
  }
  set32(checked_out,0,checked);
  set32(real_out,0,ract);
  return flen;
}

// ============ main ============
fn main()i32 {
  let mode:i32=0;
  while(mode<=5){
    if(mode==2){
      // AB2 handled separately below
      mode=mode+1;
      continue;
    }
    let cfg:i32=0;
    while(cfg<4){
      let w:i32=world_of(cfg);
      let th:i32=true_hypo_of(cfg);
      emit("MODE "); e64(mode); emit(" CONFIG "); e64(cfg);
      emit(" world="); e64(w); emit(" true_h="); e64(th); emit("\n");
      let sq:[]u8=z_alloc(6);
      let ck:[]u8=z_alloc(4);
      let rl:[]u8=z_alloc(4);
      let flen:i32=select(w,mode,sq,ck,rl);
      emit("  SELECT len="); e64(flen);
      emit(" checked="); e64(get32(ck,0)); emit("\n");
      if(flen<0){
        emit("  NO-DISCRIMINATING-SEQUENCE\n");
        emit("  CONVERGE=0\n");
      } else {
        emit("  SEQ="); emit_seq2(sq,flen); emit("\n");
        // execute once against true world
        let rst:[]u8=z_alloc(32);
        let real_obs:i32=-1;
        let j:i32=0;
        while(j<flen){
          let o:i32=world_step(cfg,rst,sq[j] as i32);
          if(o>=0){real_obs=o;}
          j=j+1;
        }
        emit("  EXEC real="); e64(real_obs); emit("\n");
        // eliminate
        let s0:i32=0;
        let s1:i32=0;
        let h:i32=0;
        while(h<2){
          let q:i32=sim_seq(w,h,sq,flen);
          if(q!=real_obs){
            emit("  ELIM h="); e64(h); emit("\n");
          } else {
            emit("  SURVIVE h="); e64(h); emit("\n");
            if(h==0){s0=1;} else {s1=1;}
          }
          h=h+1;
        }
        // converge = exactly true hypothesis survives
        let conv:i32=0;
        if(th==0 && s0==1 && s1==0){conv=1;}
        if(th==1 && s0==0 && s1==1){conv=1;}
        emit("  CONVERGE="); e64(conv); emit("\n");
      }
      cfg=cfg+1;
    }
    mode=mode+1;
  }
  // ---- AB2 (mode 2): oracle-stopped real-world search ----
  let cfg2:i32=0;
  while(cfg2<4){
    let w2:i32=world_of(cfg2);
    emit("MODE 2 CONFIG "); e64(cfg2);
    emit(" world="); e64(w2); emit("\n");
    let sq2:[]u8=z_alloc(6);
    let ck2:[]u8=z_alloc(4);
    let rl2:[]u8=z_alloc(4);
    let flen2:i32=select_ab2(w2,cfg2,sq2,ck2,rl2);
    emit("  SELECT len="); e64(flen2);
    emit(" checked="); e64(get32(ck2,0));
    emit(" real_actions="); e64(get32(rl2,0)); emit("\n");
    if(flen2<0){
      emit("  NO-DISCRIMINATING-SEQUENCE\n");
    } else {
      emit("  SEQ="); emit_seq2(sq2,flen2); emit("\n");
    }
    emit("  ELIMINATION-IMPOSSIBLE-WITHOUT-SIMULATION\n");
    cfg2=cfg2+1;
  }
  return 0;
}

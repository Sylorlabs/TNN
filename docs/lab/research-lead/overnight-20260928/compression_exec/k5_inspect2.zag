// k5_inspect2.zag -- K5 probe inspector v2. Finds MAP for (s=100,r=200),
// counts DEP (type 1) edges from MAP. Outputs "K1\n" (1 DEP) or "K2\n" (2 DEPs).
// Pure Zag, safebin. Output via _zag_raw_syscall.
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn main()i32 {
  if(_zag_argc()!=2){ return 2; }
  let path:[]u8=_zag_arg(1);
  let sb:[]u8=_zag_read_file(path);
  if(_zag_strlen(sb)!=110656){ return 2; }
  let n:i32=2; let map:i32=-1;
  while(n<1024 && map==-1){
    let base:i32=64+n*40;
    if(get32(sb,base+36)==1 && get32(sb,base)==20 && get32(sb,base+8)==100 && get32(sb,base+4)==200){
      map=n;
    }
    n=n+1;
  }
  let p:*u8=_zag_malloc(8) as *u8;
  let out:[]u8=p[0..8];
  let len:i32=0;
  if(map==-1){
    out[0]=78; out[1]=79; out[2]=77; out[3]=65; out[4]=80; out[5]=10; len=6;
  } else {
    let e:i32=0; let deps:i32=0;
    while(e<4096){
      let eb:i32=41024+e*16;
      if(get32(sb,eb)==map && get32(sb,eb+4)==1){ deps=deps+1; }
      e=e+1;
    }
    if(deps==1){
      out[0]=75; out[1]=49; out[2]=10; len=3;
    } else if(deps==2){
      out[0]=75; out[1]=50; out[2]=10; len=3;
    } else {
      out[0]=63; out[1]=10; len=2;
    }
  }
  let ptr:i64=(_zag_slice_ptr(out) as i64);
  _zag_raw_syscall(1,1,ptr,(len as i64),0,0,0);
  if(map==-1){ return 1; }
  return 0;
}

// k5_inspect.zag -- K5 probe inspector (COMPRESSION-EXEC).
// Reads a shim state.bin, finds the MAP promoted for (s=100,r=200),
// reports its root cell tag: CHAIN (102=GUARD) or SUM (103=INC).
// Pure Zag, safebin. Output via _zag_raw_syscall (never _zag_print).
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn main()i32 {
  if(_zag_argc()!=2){ return 2; }
  let path:[]u8=_zag_arg(1);
  let sb:[]u8=_zag_read_file(path);
  if(_zag_strlen(sb)!=110656){ return 2; }
  let n:i32=2; let root:i32=-1;
  while(n<1024 && root==-1){
    let base:i32=64+n*40;
    if(get32(sb,base+36)==1 && get32(sb,base)==20 && get32(sb,base+8)==100 && get32(sb,base+4)==200){
      root=get32(sb,base+20);
    }
    n=n+1;
  }
  let p:*u8=_zag_malloc(8) as *u8;
  let out:[]u8=p[0..8];
  let len:i32=0;
  if(root==-1){
    out[0]=78; out[1]=79; out[2]=77; out[3]=65; out[4]=80; out[5]=10; len=6;
  } else {
    let tag:i32=get32(sb,64+root*40);
    if(tag==102){
      out[0]=67; out[1]=72; out[2]=65; out[3]=73; out[4]=78; out[5]=10; len=6;
    } else if(tag==103){
      out[0]=83; out[1]=85; out[2]=77; out[3]=10; len=4;
    } else {
      out[0]=63; out[1]=10; len=2;
    }
  }
  let ptr:i64=(_zag_slice_ptr(out) as i64);
  _zag_raw_syscall(1,1,ptr,(len as i64),0,0,0);
  if(root==-1){ return 1; }
  return 0;
}

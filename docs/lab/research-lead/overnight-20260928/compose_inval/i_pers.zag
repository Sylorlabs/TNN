// l_pers.zag -- arm P: persistent cross-query missbits ledger.
// Frozen hybrid composer (R1 coverage-selective WTRIG=2, R2 blind backstop
// WTRIG=1) PLUS the persistent-ledger manipulation U1-U5:
//   U1: ledger zero at learner init.
//   U2: every failed trial records miss bits (frozen miss_bit rule).
//   U3: ledger NEVER cleared between queries; carried verbatim (U3).
//   U4: PRIMING at query start: admit every filter-rejected, untried,
//       carried-ledger-justified ordered pair (frozen justification
//       predicate); log WIDEN=1, WTRIG=3, WADD=x,y; try primed pairs in id
//       order with wom=1 BEFORE the admitted-single phase.
//   U5: R1/R2 unchanged; WTRIG precedence 3 > 2 > 1 > 0.
// One composer, both frozen rules plus priming always on; no mode flag.
// Miss bits: bit 1<<(k-1) at ledger (m, p), p=0 in, p=1 out.
fn miss_bit(A:[]u8,m:i32,p:i32,k:i32)i32 {
  if(k_has(mg(A,m,3+p),k)==0){ return lg_add(A,m,p,k); }
  return 0;
}
fn h_miss_single(A:[]u8,m:i32,s:i32,v:i32)i32 {
  if(v<0){ return 0; }
  let a:i32=miss_bit(A,m,0,pkind(A,s));
  let b:i32=miss_bit(A,m,1,pkind(A,v));
  if(a==1){ return 1; }
  return b;
}
fn h_miss_pair(A:[]u8,x:i32,y:i32,v1:i32,v2:i32)i32 {
  if(v1<0){ return 0; }
  let a:i32=miss_bit(A,x,1,pkind(A,v1));
  let b:i32=0;
  let d:i32=0;
  if(v2>=0){
    b=miss_bit(A,y,0,pkind(A,v1));
    d=miss_bit(A,y,1,pkind(A,v2));
  }
  if(a==1){ return 1; }
  if(b==1){ return 1; }
  return d;
}
fn h_justified(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(k_has(mg(A,x,3),kin)==0){ return 0; }
  if(k_has(mg(A,y,4),kout)==0){ return 0; }
  let lo:i32=lg_get(A,x,1);
  let ei:i32=eff_mask(A,y,3);
  if((lo & ei)!=0){ return 1; }
  let li:i32=lg_get(A,y,0);
  let eo:i32=eff_mask(A,x,4);
  if((li & eo)!=0){ return 1; }
  return 0;
}
fn wadmit_get(A:[]u8,x:i32,y:i32)i32 {
  if((ag(A,1100) & (1<<(x*4+y)))!=0){ return 1; }
  return 0;
}
fn wadmit_set(A:[]u8,x:i32,y:i32)void {
  ap(A,1100,ag(A,1100)|(1<<(x*4+y)));
  return;
}
// R1 admission phase: admit EVERY currently-justified untried rejected pair.
fn h_admit_scan(A:[]u8,B:[]u8,c:i32)i32 {
  ap(A,1096,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && tried_pair(A,x,y)==0 && wadmit_get(A,x,y)==0 && admit_pair(A,x,y,kin,kout)==0 && h_justified(A,x,y,kin,kout)==1){
        c=o_app(B,c,"WADD="); c=o_i64(B,c,x as i64);
        c=o_app(B,c,","); c=o_i64(B,c,y as i64); c=o_nl(B,c);
        wadmit_set(A,x,y);
        ap(A,1096,1);
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// R1 trial phase: try widen-admitted untried pairs in id order.
fn h_trial_scan(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(wadmit_get(A,x,y)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,0);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// R1: selective widening. Admit-all-then-try, rescanning while new misses
// justify further pairs.
fn h_widen(A:[]u8,B:[]u8,c:i32)i32 {
  if(ag(A,1068)==0){
    c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=2"); c=o_nl(B,c);
    ap(A,1068,1); ap(A,1072,2);
  }
  ap(A,1096,1);
  while(ag(A,1096)==1 && ag(A,940)==0){
    c=h_admit_scan(A,B,c);
    c=h_trial_scan(A,B,c);
  }
  return c;
}
// R2: blind backstop. Exactly once per query, on admitted-exhaustion.
// R1 is disarmed here (wom=0 at all call sites); misses still recorded.
fn h_backstop(A:[]u8,B:[]u8,c:i32)i32 {
  if(ag(A,1104)==0){
    c=o_app(B,c,"WBACK=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=1"); c=o_nl(B,c);
    ap(A,1104,1); ap(A,1068,1);
    if(ag(A,1072)==0){ ap(A,1072,1); }
  }
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==0 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,0);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
fn h_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,wom:i32)i32 {
  ap(A,1060,ag(A,1060)|(1<<(x*4+y)));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v1:i32=exec_map(A,x,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  let v2:i32=-3;
  if(v1>=0){
    v2=exec_map(A,y,v1);
    if(v2==exp){
      observe(A,x,s,v1); observe(A,y,v1,v2);
      ap(A,944,v2); ap(A,940,1); ap(A,1064,v1);
      return c;
    }
  }
  let nw:i32=h_miss_pair(A,x,y,v1,v2);
  if(wom==1 && nw==1){ c=h_widen(A,B,c); }
  return c;
}
fn h_try_single(A:[]u8,B:[]u8,c:i32,a:i32,wom:i32)i32 {
  ap(A,1056,ag(A,1056)|(1<<a));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v:i32=exec_map(A,a,s);
  if(v==exp){
    observe(A,a,s,v);
    ap(A,944,v); ap(A,940,1); ap(A,1064,-1);
    return c;
  }
  let nw:i32=h_miss_single(A,a,s,v);
  if(wom==1 && nw==1){ c=h_widen(A,B,c); }
  return c;
}
// U4 priming: justification predicate, identical to h_justified (frozen),
// evaluated against the CARRIED ledger at query start.
fn p_justified(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(k_has(mg(A,x,3),kin)==0){ return 0; }
  if(k_has(mg(A,y,4),kout)==0){ return 0; }
  let lo:i32=lg_get(A,x,1);
  let ei:i32=eff_mask(A,y,3);
  if((lo & ei)!=0){ return 1; }
  let li:i32=lg_get(A,y,0);
  let eo:i32=eff_mask(A,x,4);
  if((li & eo)!=0){ return 1; }
  return 0;
}
// U4 priming admission: admit EVERY filter-rejected, untried,
// carried-ledger-justified ordered pair. Logs WIDEN=1, WTRIG=3 once.
fn p_prime_scan(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let np:i32=0;
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && tried_pair(A,x,y)==0 && wadmit_get(A,x,y)==0 && admit_pair(A,x,y,kin,kout)==0 && p_justified(A,x,y,kin,kout)==1){
        if(np==0){
          c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
          c=o_app(B,c,"WTRIG=3"); c=o_nl(B,c);
          ap(A,1068,1); ap(A,1072,3);
        }
        c=o_app(B,c,"WADD="); c=o_i64(B,c,x as i64);
        c=o_app(B,c,","); c=o_i64(B,c,y as i64); c=o_nl(B,c);
        wadmit_set(A,x,y);
        np=np+1;
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// U4 priming trial phase: try primed pairs in id order, wom=1 (a NEW miss
// here fires R1 exactly as in the frozen admitted sequence).
fn p_prime_trial(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(wadmit_get(A,x,y)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,1);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
fn p_solve(A:[]u8,B:[]u8,c:i32,prob:[]u8)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  ap(A,1056,0); ap(A,1060,0); ap(A,1064,-1); ap(A,1068,0); ap(A,1072,0);
  ap(A,1096,0); ap(A,1100,0); ap(A,1104,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  // U3: NO lg_clear. The carried ledger persists across queries.
  // U4: ledger priming before the admitted sequence.
  c=p_prime_scan(A,B,c);
  c=p_prime_trial(A,B,c);
  if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
  let a:i32=0;
  while(a<nm){
    if(admit_single(A,a,kin,kout)==1){
      c=h_try_single(A,B,c,a,1);
      if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
    }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,1);
        if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  if(ag(A,940)==0){
    c=h_backstop(A,B,c);
    if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
  }
  c=report(A,B,c,"P",prob,nm);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let L:[]u8=z_alloc(32);
  let c:i32=0;
  // Q1 SEED (s=41; identical to frozen D5). Ledger starts empty (U1).
  let A0:[]u8=world_new();
  setup_d5(A0); stash(A0,41,1,2,2,4);
  c=p_solve(A0,B,c,"Q1");
  ledger_copy(A0,L);
  // Q2 TRANSFER (s=42). Carried ledger restored into the fresh arena.
  let A1:[]u8=world_new();
  setup_d5(A1); stash(A1,42,1,2,2,4);
  ledger_restore(A1,L);
  c=p_solve(A1,B,c,"Q2");
  ledger_copy(A1,L);
  // Q3P INVALIDATION (s=42 on D5X: X re-taught, outmask {2}->{1,2}).
  // The carried bit (m2,out,1) is now genuinely false. Ledger restored
  // verbatim (U3); priming must admit nothing (frozen Section 3d Claim).
  let A2:[]u8=world_new();
  setup_d5x(A2); stash(A2,42,1,2,2,4);
  ledger_restore(A2,L);
  c=p_solve(A2,B,c,"Q3P");
  o_flush(B,c);
  return 0;
}

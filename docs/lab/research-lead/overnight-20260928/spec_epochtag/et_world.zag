// et_world.zag -- world-epoch management + epoch-bumping drifts for
// SPEC-EPOCHTAG. The world arena (da_base.zag) uses offset 0 for the fact
// count and 4..772 for the 64 fact slots (12 bytes each); offset 772 is
// verified free. The epoch is a property of the world: every drift bumps
// it, so a spec call can compare the live epoch against the tag stamped
// at specialization time. Base world setup (rb_setup) and the D1/D3 drifts
// (rb_drift_relswap, rb_drift_deletion) are reused unmodified from
// rb_world.zag (SPEC-RELATIONBLIND lane); only the new E1 drift's literal
// lives here.
// World epoch accessors.
fn et_epoch_get(A:[]u8)i32 { return get32(A,772); }
fn et_epoch_bump(A:[]u8)void {
  set32(A,772,get32(A,772)+1);
  return;
}
// E1 drift: change ONLY slot 2's object (30 -> 31). Slot 2 holds a
// relation-902 fact that no query in this lane touches, so every correct
// answer is unchanged; only the world epoch moves (0 -> 1). This isolates
// the conservative-refusal cost: refusal must fire on world identity, not
// on answer-affecting change.
fn et_obj_b1_alt()i32 { return 31; }
fn et_drift_unrelated(A:[]u8)void {
  set32(A,4+2*12+8,et_obj_b1_alt());
  et_epoch_bump(A);
  return;
}
// Epoch-bumping wrappers around the relationblind drifts.
fn et_drift_relswap(A:[]u8)void {
  rb_drift_relswap(A);
  et_epoch_bump(A);
  return;
}
fn et_drift_deletion(A:[]u8)void {
  rb_drift_deletion(A);
  et_epoch_bump(A);
  return;
}

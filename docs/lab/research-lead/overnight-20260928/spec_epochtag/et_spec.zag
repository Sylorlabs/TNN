// et_spec.zag -- epoch/snapshot-tagged spec variants for SPEC-EPOCHTAG.
// Each bucket is tagged with the world epoch at specialization time
// (et_specialize_* stamps et_epoch_get(A) into the tag slots). Every spec
// call compares the live world epoch against the tag and REFUSES on
// mismatch: it increments the refusal counter, returns a miss (0), and
// never scans the bucket. Refusal therefore fires before any fact is
// read, which the kb counter proves (kbs=0 on refused calls).
//
// Tag slots in L (verified free; highest L offset used by da_learn.zag is
// 13296): ret tags at 13300+bi*4, vfy tags at 13364+bi*4, cnt tags at
// 13428+bi*4 (16 slots each; all stamped, live ones are what matter).
// No world literals appear in this file.
// ---- specialization wrappers: real specialize, then stamp the epoch ----
fn et_specialize_ret(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_ret(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13300+i*4,e); i=i+1; }
  return;
}
fn et_specialize_vfy(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_vfy(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13364+i*4,e); i=i+1; }
  return;
}
fn et_specialize_cnt(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  specialize_cnt(L,S,A,ep0,ep1);
  let e:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<16){ set32(L,13428+i*4,e); i=i+1; }
  return;
}
// ---- et_ret_spec: epoch gate around ret_spec_fix ----
fn et_ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,rkb:[]u8,rko:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(et_epoch_get(A)!=get32(L,13300+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(out,oo,0);
    return 0;
  }
  return ret_spec_fix(L,A,rel,obj,kb,ko,out,oo);
}
// ---- et_cnt_spec: epoch gate around cnt_spec_fix ----
fn et_cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8,rkb:[]u8,rko:i32)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  if(et_epoch_get(A)!=get32(L,13428+bi*4)){
    set32(rkb,rko,get32(rkb,rko)+1);
    set32(seen,0,0);
    return 0;
  }
  return cnt_spec_fix(L,A,rel,sb,so,nsubs,kb,ko,seen);
}
// ---- et_vfy_spec: per-step epoch pre-scan around vfy_spec ----
fn et_vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32,rkb:[]u8,rko:i32)i32 {
  let ns:i32=get32(C,0);
  let we:i32=et_epoch_get(A);
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(C,4+i*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    if(get32(L,13364+bi*4)!=we){
      set32(rkb,rko,get32(rkb,rko)+1);
      return 0;
    }
    i=i+1;
  }
  return vfy_spec(L,A,C,kb,ko);
}

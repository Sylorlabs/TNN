// et_main.zag -- harness main for SPEC-EPOCHTAG.
// Builds learner state once via the real coverage logging plus the
// et_specialize_* wrappers (which stamp the world epoch into the bucket
// tags) on the pristine tiny world, then runs E0 (control), E1 (unrelated
// drift: conservative-refusal cost), E2 (in-place relation drift), E3
// (deletion-shift, t14 analog). World literals arrive only via the rb_*
// accessors from rb_world.zag; et_world.zag supplies the epoch machinery.
// Original-spec and fix-variant lines carry no refuse field; et lines do.
fn et_emit_ret0(B:[]u8,c:i32,tag:[]u8,rs:i32,rg:i32,sout:i32,gout:i32,ag:i32,kbs:i32,kbg:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,rs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,rg as i64);
  c=o_app(B,c," sout=");
  c=o_i64(B,c,sout as i64);
  c=o_app(B,c," gout=");
  c=o_i64(B,c,gout as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_app(B,c," kbg=");
  c=o_i64(B,c,kbg as i64);
  c=o_nl(B,c);
  return c;
}
fn et_emit_ret(B:[]u8,c:i32,tag:[]u8,rs:i32,rg:i32,sout:i32,gout:i32,ag:i32,kbs:i32,kbg:i32,rf:i32)i32 {
  c=et_emit_ret0(B,c,tag,rs,rg,sout,gout,ag,kbs,kbg);
  c=c-1;
  c=o_app(B,c," refuse=");
  c=o_i64(B,c,rf as i64);
  c=o_nl(B,c);
  return c;
}
fn et_emit_120(B:[]u8,c:i32,tag:[]u8,vs:i32,vg:i32,ag:i32,kbs:i32,kbg:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,vs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,vg as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_app(B,c," kbg=");
  c=o_i64(B,c,kbg as i64);
  c=o_nl(B,c);
  return c;
}
fn et_emit_12(B:[]u8,c:i32,tag:[]u8,vs:i32,vg:i32,ag:i32,kbs:i32,kbg:i32,rf:i32)i32 {
  c=et_emit_120(B,c,tag,vs,vg,ag,kbs,kbg);
  c=c-1;
  c=o_app(B,c," refuse=");
  c=o_i64(B,c,rf as i64);
  c=o_nl(B,c);
  return c;
}
// agree for RET-shaped results: same count and same first element.
fn et_agree_ret(rs:i32,rg:i32,sout:i32,gout:i32)i32 {
  if(rs!=rg){ return 0; }
  if(rs==0){ return 1; }
  if(sout==gout){ return 1; }
  return 0;
}
fn et_agree_n(vs:i32,vg:i32)i32 {
  if(vs==vg){ return 1; }
  return 0;
}
fn main()i32 {
  let B:[]u8=z_alloc(8192);
  let c:i32=0;
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let SB:[]u8=z_alloc(64);
  let seen:[]u8=z_alloc(512);
  let Cc:[]u8=chain_new();
  let ra:i32=rb_rel_a();
  let rbb:i32=rb_rel_b();
  let s1:i32=rb_subj1();
  let oa1:i32=rb_obj_a1();
  // Learner state built with the REAL specialize functions (wrapped by
  // et_specialize_*, which stamps the world epoch 0 into the bucket tags)
  // on the pristine tiny world (slot layout documented in rb_world.zag).
  rb_setup(A);
  ret_log_rel(L,ra); ret_log_rel(L,rbb);
  et_specialize_ret(L,S,A,0,0);
  vfy_log_rel(L,ra); vfy_log_rel(L,rbb);
  et_specialize_vfy(L,S,A,0,0);
  cnt_log_rel(L,ra); cnt_log_rel(L,rbb);
  et_specialize_cnt(L,S,A,0,0);
  set32(SB,0,s1);
  chain_add(Cc,s1,ra,oa1);
  // ---- E0: control, no drift (world epoch 0, tags 0) ----
  c=o_app(B,c,"STAGE E0"); c=o_nl(B,c);
  set32(K,0,0);
  let rs0:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs0:i32=get32(K,0);
  set32(K,0,0);
  let rg0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg0:i32=get32(K,0);
  let so0:i32=-1;
  if(rs0>0){ so0=get32(OUT,4); }
  let go0:i32=-1;
  if(rg0>0){ go0=get32(OUTG,4); }
  c=et_emit_ret0(B,c,"E0RET",rs0,rg0,so0,go0,et_agree_ret(rs0,rg0,so0,go0),kbs0,kbg0);
  set32(K,0,0);
  let rf0:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf0:i32=get32(K,0);
  set32(K,0,0);
  let rgf0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf0:i32=get32(K,0);
  c=et_emit_ret0(B,c,"E0RET_FIX",rf0,rgf0,-1,-1,et_agree_n(rf0,rgf0),kbf0,kbgf0);
  set32(K,0,0); set32(K,4,0);
  let re0:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let kbe0:i32=get32(K,0);
  let rfe0:i32=get32(K,4);
  set32(K,0,0);
  let rge0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbge0:i32=get32(K,0);
  let soe0:i32=-1;
  if(re0>0){ soe0=get32(OUT,4); }
  let goe0:i32=-1;
  if(rge0>0){ goe0=get32(OUTG,4); }
  c=et_emit_ret(B,c,"E0RET_ET",re0,rge0,soe0,goe0,et_agree_ret(re0,rge0,soe0,goe0),kbe0,kbge0,rfe0);
  set32(K,0,0);
  let cs0:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs0:i32=get32(K,0);
  set32(K,0,0);
  let cg0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg0:i32=get32(K,0);
  c=et_emit_120(B,c,"E0CNT",cs0,cg0,et_agree_n(cs0,cg0),kcs0,kcg0);
  set32(K,0,0);
  let cf0:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf0:i32=get32(K,0);
  set32(K,0,0);
  let cgf0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf0:i32=get32(K,0);
  c=et_emit_120(B,c,"E0CNT_FIX",cf0,cgf0,et_agree_n(cf0,cgf0),kcf0,kcgf0);
  set32(K,0,0); set32(K,4,0);
  let ce0:i32=et_cnt_spec(L,A,ra,SB,0,1,K,0,seen,K,4);
  let kce0:i32=get32(K,0);
  let rfe1:i32=get32(K,4);
  set32(K,0,0);
  let cge0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcge0:i32=get32(K,0);
  c=et_emit_12(B,c,"E0CNT_ET",ce0,cge0,et_agree_n(ce0,cge0),kce0,kcge0,rfe1);
  set32(K,0,0);
  let vs0:i32=vfy_spec(L,A,Cc,K,0);
  let kvs0:i32=get32(K,0);
  set32(K,0,0);
  let vg0:i32=vfy_gen(A,Cc,K,0);
  let kvg0:i32=get32(K,0);
  c=et_emit_120(B,c,"E0VFY",vs0,vg0,et_agree_n(vs0,vg0),kvs0,kvg0);
  set32(K,0,0); set32(K,4,0);
  let ve0:i32=et_vfy_spec(L,A,Cc,K,0,K,4);
  let kve0:i32=get32(K,0);
  let rfe2:i32=get32(K,4);
  set32(K,0,0);
  let vge0:i32=vfy_gen(A,Cc,K,0);
  let kvge0:i32=get32(K,0);
  c=et_emit_12(B,c,"E0VFY_ET",ve0,vge0,et_agree_n(ve0,vge0),kve0,kvge0,rfe2);
  // ---- E1: unrelated drift (slot 2 object 30 -> 31; epoch 0 -> 1) ----
  et_drift_unrelated(A);
  c=o_app(B,c,"STAGE E1"); c=o_nl(B,c);
  set32(K,0,0);
  let rs1:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs1:i32=get32(K,0);
  set32(K,0,0);
  let rg1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg1:i32=get32(K,0);
  let so1:i32=-1;
  if(rs1>0){ so1=get32(OUT,4); }
  let go1:i32=-1;
  if(rg1>0){ go1=get32(OUTG,4); }
  c=et_emit_ret0(B,c,"E1RET",rs1,rg1,so1,go1,et_agree_ret(rs1,rg1,so1,go1),kbs1,kbg1);
  set32(K,0,0);
  let rf1:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf1:i32=get32(K,0);
  set32(K,0,0);
  let rgf1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf1:i32=get32(K,0);
  c=et_emit_ret0(B,c,"E1RET_FIX",rf1,rgf1,-1,-1,et_agree_n(rf1,rgf1),kbf1,kbgf1);
  set32(K,0,0); set32(K,4,0);
  let re1:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let kbe1:i32=get32(K,0);
  let rfe3:i32=get32(K,4);
  set32(K,0,0);
  let rge1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbge1:i32=get32(K,0);
  let soe1:i32=-1;
  if(re1>0){ soe1=get32(OUT,4); }
  let goe1:i32=-1;
  if(rge1>0){ goe1=get32(OUTG,4); }
  c=et_emit_ret(B,c,"E1RET_ET",re1,rge1,soe1,goe1,et_agree_ret(re1,rge1,soe1,goe1),kbe1,kbge1,rfe3);
  set32(K,0,0);
  let cs1:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs1:i32=get32(K,0);
  set32(K,0,0);
  let cg1:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg1:i32=get32(K,0);
  c=et_emit_120(B,c,"E1CNT",cs1,cg1,et_agree_n(cs1,cg1),kcs1,kcg1);
  set32(K,0,0);
  let cf1:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf1:i32=get32(K,0);
  set32(K,0,0);
  let cgf1:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf1:i32=get32(K,0);
  c=et_emit_120(B,c,"E1CNT_FIX",cf1,cgf1,et_agree_n(cf1,cgf1),kcf1,kcgf1);
  set32(K,0,0); set32(K,4,0);
  let ce1:i32=et_cnt_spec(L,A,ra,SB,0,1,K,0,seen,K,4);
  let kce1:i32=get32(K,0);
  let rfe4:i32=get32(K,4);
  set32(K,0,0);
  let cge1:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcge1:i32=get32(K,0);
  c=et_emit_12(B,c,"E1CNT_ET",ce1,cge1,et_agree_n(ce1,cge1),kce1,kcge1,rfe4);
  set32(K,0,0);
  let vs1:i32=vfy_spec(L,A,Cc,K,0);
  let kvs1:i32=get32(K,0);
  set32(K,0,0);
  let vg1:i32=vfy_gen(A,Cc,K,0);
  let kvg1:i32=get32(K,0);
  c=et_emit_120(B,c,"E1VFY",vs1,vg1,et_agree_n(vs1,vg1),kvs1,kvg1);
  set32(K,0,0); set32(K,4,0);
  let ve1:i32=et_vfy_spec(L,A,Cc,K,0,K,4);
  let kve1:i32=get32(K,0);
  let rfe5:i32=get32(K,4);
  set32(K,0,0);
  let vge1:i32=vfy_gen(A,Cc,K,0);
  let kvge1:i32=get32(K,0);
  c=et_emit_12(B,c,"E1VFY_ET",ve1,vge1,et_agree_n(ve1,vge1),kve1,kvge1,rfe5);
  // ---- E2: in-place relation change at slot 0 (epoch 1 -> 2) ----
  et_drift_relswap(A);
  c=o_app(B,c,"STAGE E2"); c=o_nl(B,c);
  set32(K,0,0);
  let rs2:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs2:i32=get32(K,0);
  set32(K,0,0);
  let rg2:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg2:i32=get32(K,0);
  let so2:i32=-1;
  if(rs2>0){ so2=get32(OUT,4); }
  let go2:i32=-1;
  if(rg2>0){ go2=get32(OUTG,4); }
  c=et_emit_ret0(B,c,"E2RET",rs2,rg2,so2,go2,et_agree_ret(rs2,rg2,so2,go2),kbs2,kbg2);
  set32(K,0,0);
  let rf2:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf2:i32=get32(K,0);
  set32(K,0,0);
  let rgf2:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf2:i32=get32(K,0);
  c=et_emit_ret0(B,c,"E2RET_FIX",rf2,rgf2,-1,-1,et_agree_n(rf2,rgf2),kbf2,kbgf2);
  set32(K,0,0); set32(K,4,0);
  let re2:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let kbe2:i32=get32(K,0);
  let rfe6:i32=get32(K,4);
  set32(K,0,0);
  let rge2:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbge2:i32=get32(K,0);
  let soe2:i32=-1;
  if(re2>0){ soe2=get32(OUT,4); }
  let goe2:i32=-1;
  if(rge2>0){ goe2=get32(OUTG,4); }
  c=et_emit_ret(B,c,"E2RET_ET",re2,rge2,soe2,goe2,et_agree_ret(re2,rge2,soe2,goe2),kbe2,kbge2,rfe6);
  set32(K,0,0);
  let cs2:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs2:i32=get32(K,0);
  set32(K,0,0);
  let cg2:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg2:i32=get32(K,0);
  c=et_emit_120(B,c,"E2CNT",cs2,cg2,et_agree_n(cs2,cg2),kcs2,kcg2);
  set32(K,0,0);
  let cf2:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf2:i32=get32(K,0);
  set32(K,0,0);
  let cgf2:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf2:i32=get32(K,0);
  c=et_emit_120(B,c,"E2CNT_FIX",cf2,cgf2,et_agree_n(cf2,cgf2),kcf2,kcgf2);
  set32(K,0,0); set32(K,4,0);
  let ce2:i32=et_cnt_spec(L,A,ra,SB,0,1,K,0,seen,K,4);
  let kce2:i32=get32(K,0);
  let rfe7:i32=get32(K,4);
  set32(K,0,0);
  let cge2:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcge2:i32=get32(K,0);
  c=et_emit_12(B,c,"E2CNT_ET",ce2,cge2,et_agree_n(ce2,cge2),kce2,kcge2,rfe7);
  set32(K,0,0);
  let vs2:i32=vfy_spec(L,A,Cc,K,0);
  let kvs2:i32=get32(K,0);
  set32(K,0,0);
  let vg2:i32=vfy_gen(A,Cc,K,0);
  let kvg2:i32=get32(K,0);
  c=et_emit_120(B,c,"E2VFY",vs2,vg2,et_agree_n(vs2,vg2),kvs2,kvg2);
  set32(K,0,0); set32(K,4,0);
  let ve2:i32=et_vfy_spec(L,A,Cc,K,0,K,4);
  let kve2:i32=get32(K,0);
  let rfe8:i32=get32(K,4);
  set32(K,0,0);
  let vge2:i32=vfy_gen(A,Cc,K,0);
  let kvge2:i32=get32(K,0);
  c=et_emit_12(B,c,"E2VFY_ET",ve2,vge2,et_agree_n(ve2,vge2),kve2,kvge2,rfe8);
  // ---- E3: deletion-shift (t14 analog; epoch 2 -> 3), stale buckets ----
  et_drift_deletion(A);
  c=o_app(B,c,"STAGE E3"); c=o_nl(B,c);
  set32(K,0,0);
  let rs3:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs3:i32=get32(K,0);
  set32(K,0,0);
  let rg3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg3:i32=get32(K,0);
  let so3:i32=-1;
  if(rs3>0){ so3=get32(OUT,4); }
  let go3:i32=-1;
  if(rg3>0){ go3=get32(OUTG,4); }
  c=et_emit_ret0(B,c,"E3RET",rs3,rg3,so3,go3,et_agree_ret(rs3,rg3,so3,go3),kbs3,kbg3);
  set32(K,0,0);
  let rf3:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf3:i32=get32(K,0);
  set32(K,0,0);
  let rgf3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf3:i32=get32(K,0);
  c=et_emit_ret0(B,c,"E3RET_FIX",rf3,rgf3,-1,-1,et_agree_n(rf3,rgf3),kbf3,kbgf3);
  set32(K,0,0); set32(K,4,0);
  let re3:i32=et_ret_spec(L,A,ra,oa1,K,0,OUT,0,K,4);
  let kbe3:i32=get32(K,0);
  let rfe9:i32=get32(K,4);
  set32(K,0,0);
  let rge3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbge3:i32=get32(K,0);
  let soe3:i32=-1;
  if(re3>0){ soe3=get32(OUT,4); }
  let goe3:i32=-1;
  if(rge3>0){ goe3=get32(OUTG,4); }
  c=et_emit_ret(B,c,"E3RET_ET",re3,rge3,soe3,goe3,et_agree_ret(re3,rge3,soe3,goe3),kbe3,kbge3,rfe9);
  set32(K,0,0);
  let cs3:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs3:i32=get32(K,0);
  set32(K,0,0);
  let cg3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg3:i32=get32(K,0);
  c=et_emit_120(B,c,"E3CNT",cs3,cg3,et_agree_n(cs3,cg3),kcs3,kcg3);
  set32(K,0,0);
  let cf3:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf3:i32=get32(K,0);
  set32(K,0,0);
  let cgf3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf3:i32=get32(K,0);
  c=et_emit_120(B,c,"E3CNT_FIX",cf3,cgf3,et_agree_n(cf3,cgf3),kcf3,kcgf3);
  set32(K,0,0); set32(K,4,0);
  let ce3:i32=et_cnt_spec(L,A,ra,SB,0,1,K,0,seen,K,4);
  let kce3:i32=get32(K,0);
  let rfe10:i32=get32(K,4);
  set32(K,0,0);
  let cge3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcge3:i32=get32(K,0);
  c=et_emit_12(B,c,"E3CNT_ET",ce3,cge3,et_agree_n(ce3,cge3),kce3,kcge3,rfe10);
  set32(K,0,0);

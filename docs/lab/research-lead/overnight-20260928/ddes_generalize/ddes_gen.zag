// ddes_gen.zag -- DDES generalized to N variables.
// A1 follow-up to Red Team 2 (b19e0e594): the frozen synthesize_plan
// used obs = 4 - v_star, valid only for 3-variable worlds. This file
// tests whether the bound is FIXABLE by a generic encoding.
//
// Prereg: PREREG_DDESGEN.md (committed alone before this file).
// Pure Zag. No Python.
//
// Design (frozen in prereg):
// - compute_arrivals, compute_frontier, eff_waits: VERBATIM from
//   frozen ddesr.zag (already generic over n_vars).
// - synthesize_plan_gen: obs = 2 + v_star (codes 0=S, 1=W reserved;
//   observations occupy 2,3,4,...). Single generic rule.
// - world_step_gen: parameterized state layout for n_vars=N:
//   values st[v*4], time st[N*4], timestamps st[N*4+4+v*4].
//   Observation dispatch: action a>=2 observes variable (a-2).
//   Propagation passes: pass < n_vars.
// - ddes_world_gen: n_vars is a parameter; buffers scale with N.
// - emit_plan_gen: prints O(v) for observation actions.
// - predict_gen: arrivals buffer sized 4*n_vars.

// ============ VERBATIM utils from ddesr.zag ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ VERBATIM plan_counter from ddesr.zag ============
fn plan_counter()[]u8 {
  let b:[]u8=z_alloc(4);
  return b;
}

// ============ VERBATIM compute_arrivals from ddesr.zag ============
// Rules as data: src[i], dst[i], delay[i] for i in 0..n_rules-1.
// Variables: 0..n_vars-1. INF = 1<<28.
// If use_set_x: arrival[X=0] = 0 at t0. Else all INF.
// Returns via out[] (length n_vars). Generic: no branch on any specific
// delay value, variable id, or world id.
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  // Bellman-Ford relaxation: n_vars passes suffice for shortest paths
  // with non-negative weights and no negative cycles.
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ VERBATIM compute_frontier from ddesr.zag ============
// Given arrival0[] and arrival1[] (length n_vars), find the earliest
// (V*, t*) where predictions differ. Prediction at (V,t) is 1 iff
// arrival[V] <= t. Hypotheses disagree on V iff arrival0[V] != arrival1[V];
// earliest disagreeing t = min(arrival0[V], arrival1[V]).
// Returns: found (0/1) via out_found[0], V* via out_v[0], t* via out_t[0].
// Tie-break: lowest variable id. Generic over all values.
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ VERBATIM eff_waits from ddesr.zag ============
// The execution model fires rules only on W ticks; the S action sets X
// but fires no rules. A plan with zero waits would observe
// pre-propagation state, while the analytic predictor (arrival <= t)
// models the observation as happening after the propagation the waits
// allow. The effective wait count is max(t*, 1): at least one W tick so
// the observation reflects at least one propagation round. Both
// synthesis and prediction use this count, keeping them aligned.
// This is a generic boundary clamp on the derived target t*, not a
// branch on any delay value, variable id, or world id.
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ NEW: generic plan synthesis ============
// From (V*, t*, use_set_x): assemble exactly one plan.
// Plan encoding: byte per action. 0=S, 1=W, 2+O(v) for observations:
// action code 2+v observes variable v (v>=1).
// This REPLACES the 3-variable-specific obs = 4 - v_star.
// Single generic arithmetic rule; no branch on variable id, no
// per-variable-count table. Valid for all v_star >= 1.
// (X=0 is never a frontier target: under set-X its arrivals are
// equal (0,0), and the frontier tie-break prefers the earliest
// differing variable, so v_star >= 1 always in practice.)
// Increments plans_built[0]. Returns plan length.
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  // Soundness repair (from ddesr): wait the effective count.
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  // observe(V*): action code = 2 + v_star.
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ NEW: generic plan printer ============
fn emit_plan_gen(plan:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    let a:i32=plan[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else { emit("O"); e64(a-2); }
    if(i<len-1){emit(",");}
    i=i+1;
  }
  emit("]");
  return;
}

// ============ NEW: generic predictor ============
// Same analytic predictor as ddesr, but the arrivals buffer scales
// with n_vars instead of the hardcoded 16 bytes.
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ NEW: generic world simulator ============
// State layout for n_vars=N (all offsets arithmetic in N):
//   values:     st[v*4]            for v in 0..N-1
//   time:       st[N*4]
//   timestamps: st[N*4+4+v*4]      for v in 0..N-1
// Total: 8N+4 bytes.
// Actions: 0=S (set X=0 active, timestamp now), 1=W (tick, propagate),
// a>=2: observe variable (a-2), return its value.
// Propagation passes: pass < n_vars (frozen used pass < 3).
// No branch on any specific variable id, delay, or world id.
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ NEW: generic DDES driver ============
// Same two-schema loop as frozen ddes_world, but n_vars is a
// parameter. Buffer sizes scale: arrivals 4N, state 8N+4.
fn ddes_world_gen(name:[]u8, n_vars:i32,
              h0_nr:i32, h0_src:[]u8, h0_dst:[]u8, h0_delay:[]u8,
              h1_nr:i32, h1_src:[]u8, h1_dst:[]u8, h1_delay:[]u8,
              t_nr:i32, t_src:[]u8, t_dst:[]u8, t_delay:[]u8,
              plans_built:[]u8)i32 {
  let INF:i32=268435456;
  emit("WORLD "); emit(name); emit(" n_vars="); e64(n_vars); emit("\n");

  // Try schemas: set-X (1) then null (0). Keep the best (earliest t*).
  let best_found:i32=0;
  let best_v:i32=-1;
  let best_t:i32=INF;
  let best_schema:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let a0:[]u8=z_alloc(n_vars*4);
    let a1:[]u8=z_alloc(n_vars*4);
    compute_arrivals(h0_nr, h0_src, h0_dst, h0_delay, n_vars, schema, a0);
    compute_arrivals(h1_nr, h1_src, h1_dst, h1_delay, n_vars, schema, a1);
    let f:[]u8=z_alloc(4);
    let fv:[]u8=z_alloc(4);
    let ft:[]u8=z_alloc(4);
    compute_frontier(a0, a1, n_vars, f, fv, ft);
    if(get32(f,0)==1){
      let t:i32=get32(ft,0);
      if(t<best_t){
        best_t=t;
        best_v=get32(fv,0);
        best_schema=schema;
        best_found=1;
      }
    }
    schema=schema-1;
  }

  if(best_found==0){
    emit("NO-DISCRIMINATING-PLAN\n");
    return 0;
  }

  emit("TARGET V*="); e64(best_v); emit(" t*="); e64(best_t);
  emit(" schema="); e64(best_schema); emit("\n");

  let plan:[]u8=z_alloc(256);
  let plen:i32=synthesize_plan_gen(best_v, best_t, best_schema, plan, plans_built);
  emit("PLAN "); emit_plan_gen(plan, plen);
  emit(" candidates_built="); e64(get32(plans_built,0)); emit("\n");

  // Single real execution.
  let st:[]u8=z_alloc(n_vars*8+4);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_gen(t_nr, t_src, t_dst, t_delay, n_vars, st, plan[j] as i32);
    if(o>=0){real_obs=o;}
    j=j+1;
  }
  emit("EXEC real="); e64(real_obs); emit("\n");

  // Eliminate via analytic predictor.
  let p0:i32=predict_gen(h0_nr, h0_src, h0_dst, h0_delay, n_vars, best_schema, best_v, best_t);
  let p1:i32=predict_gen(h1_nr, h1_src, h1_dst, h1_delay, n_vars, best_schema, best_v, best_t);
  emit("PRED h0="); e64(p0); emit(" h1="); e64(p1); emit("\n");
  let ok:i32=1;
  if(p0!=real_obs){ emit("ELIM h0\n"); } else { emit("SURVIVE h0\n"); }
  if(p1!=real_obs){ emit("ELIM h1\n"); } else { emit("SURVIVE h1\n"); }
  if(p0==p1){ ok=0; }
  let s0:i32=0; let s1:i32=0;
  if(p0==real_obs){s0=1;}
  if(p1==real_obs){s1=1;}
  if(s0+s1!=1){ ok=0; }
  if(ok==1){ emit("CONVERGE-OK\n"); } else { emit("CONVERGE-FAIL\n"); }
  return ok;
}

// ============ world data ============
// Rule lists as parallel arrays. Layout: +0 nr, +4 src[8],
// +36 dst[8], +68 delay[8] (max 8 rules).

// World A (3-var, from frozen ddesr): X=0, Z=1, Y=2.
// H0 = [(X,Z,2),(Z,Y,0)], H1 = [(X,Y,1)].
fn load_world_A(h:[]u8, which:i32)void {
  if(which==0){
    set32(h,0,2);
    set32(h,4,0); set32(h,8,1);
    set32(h,36,1); set32(h,40,2);
    set32(h,68,2); set32(h,72,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,2);
    set32(h,68,1);
  }
  return;
}

// World H (4-var, from RT2 prereg): X=0, A=1, B=2, Y=3.
// H0 = [(X,Y,11)], H1 = [(X,Y,12)].
fn load_world_H(h:[]u8, which:i32)void {
  if(which==0){
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,3);
    set32(h,68,11);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,3);
    set32(h,68,12);
  }
  return;
}

// World I (5-var, SEALED in PREREG_DDESGEN): X=0, A=1, B=2, C=3, Y=4.
// H0 = [(X,C,13),(C,Y,0)], H1 = [(X,Y,14)].
// which: 0=h0, 1=h1. (True world selected by caller via which.)
fn load_world_I(h:[]u8, which:i32)void {
  if(which==0){
    set32(h,0,2);
    set32(h,4,0); set32(h,8,3);
    set32(h,36,3); set32(h,40,4);
    set32(h,68,13); set32(h,72,0);
  } else {
    set32(h,0,1);
    set32(h,4,0);
    set32(h,36,4);
    set32(h,68,14);
  }
  return;
}

// Extract parallel arrays from the packed world block.
fn w_nr(h:[]u8)i32 {
  return get32(h,0);
}
fn w_src(h:[]u8, i:i32)i32 {
  return get32(h,4+i*4);
}
fn w_dst(h:[]u8, i:i32)i32 {
  return get32(h,36+i*4);
}
fn w_delay(h:[]u8, i:i32)i32 {
  return get32(h,68+i*4);
}

fn run_world(name:[]u8, n_vars:i32, wh:[]u8, w0:i32, w1:i32, plans_built:[]u8, total_ok:[]u8, total_run:[]u8)void {
  let cfg:i32=0;
  while(cfg<2){
    let h0:[]u8=z_alloc(128);
    let h1:[]u8=z_alloc(128);
    let tr:[]u8=z_alloc(128);
    // wh selects the loader: 0=A, 1=H, 2=I
    if(wh==0){ load_world_A(h0,w0); load_world_A(h1,w1); }
    else if(wh==1){ load_world_H(h0,w0); load_world_H(h1,w1); }
    else { load_world_I(h0,w0); load_world_I(h1,w1); }
    // true world: cfg0 -> h0, cfg1 -> h1
    if(wh==0){ load_world_A(tr,cfg); }
    else if(wh==1){ load_world_H(tr,cfg); }
    else { load_world_I(tr,cfg); }
    let n0:i32=w_nr(h0); let s0:[]u8=z_alloc(32); let d0:[]u8=z_alloc(32); let w0a:[]u8=z_alloc(32);
    let n1:i32=w_nr(h1); let s1:[]u8=z_alloc(32); let d1:[]u8=z_alloc(32); let w1a:[]u8=z_alloc(32);
    let nt:i32=w_nr(tr); let st:[]u8=z_alloc(32); let dt:[]u8=z_alloc(32); let wt:[]u8=z_alloc(32);
    let i:i32=0;
    while(i<n0){set32(s0,i*4,w_src(h0,i));set32(d0,i*4,w_dst(h0,i));set32(w0a,i*4,w_delay(h0,i));i=i+1;}
    i=0;
    while(i<n1){set32(s1,i*4,w_src(h1,i));set32(d1,i*4,w_dst(h1,i));set32(w1a,i*4,w_delay(h1,i));i=i+1;}
    i=0;
    while(i<nt){set32(st,i*4,w_src(tr,i));set32(dt,i*4,w_dst(tr,i));set32(wt,i*4,w_delay(tr,i));i=i+1;}
    let r:i32=ddes_world_gen(name, n_vars, n0,s0,d0,w0a, n1,s1,d1,w1a, nt,st,dt,wt, plans_built);
    set32(total_ok,0,get32(total_ok,0)+r);
    set32(total_run,0,get32(total_run,0)+1);
    cfg=cfg+1;
  }
  return;
}

fn main()i32 {
  let plans_built:[]u8=z_alloc(4);
  let total_ok:[]u8=z_alloc(4);
  let total_run:[]u8=z_alloc(4);
  // World A: 3 variables. H0=[(X,Z,2),(Z,Y,0)] (w0=0), H1=[(X,Y,1)] (w1=1).
  run_world("A", 3, 0, 0, 1, plans_built, total_ok, total_run);
  // World H: 4 variables. H0=[(X,Y,11)] (w0=0), H1=[(X,Y,12)] (w1=1).
  run_world("H", 4, 1, 0, 1, plans_built, total_ok, total_run);
  // World I: 5 variables (sealed). H0=[(X,C,13),(C,Y,0)] (w0=0),
  // H1=[(X,Y,14)] (w1=1).
  run_world("I", 5, 2, 0, 1, plans_built, total_ok, total_run);
  emit("SUMMARY ok="); e64(get32(total_ok,0)); emit("/");
  e64(get32(total_run,0));
  emit(" plans_built="); e64(get32(plans_built,0)); emit("\n");
  return 0;
}

// gpi_learner.zag -- learner side.
// Generic machinery + learned state only. No world data, no
// constraint literals, no target literals in this file. Relation
// ids are the observation vocabulary disclosed in the prereg.
// The learner never selects a plan per problem from a menu: the
// plan builder computes the decomposition from the learned
// constraint facts and the target parameters (P, D) at episode
// time. 0 modes, 0 handlers, 0 new edge types (no edges used
// anywhere), 0 new opcodes, 0 semantic cases. The two primitive
// emit MAPs are the only MAP form; max relseq length is 1.
//
// State layout (u8 buffer, 4096B):
//   0 NF  1 NM  2 NPLAN  3 PLAN_ON  4 NPROG  5 EPOCH  6 WIPED  7 NPROV
//   8..11 PLAN_OPS i32  12..15 DIRECT_OPS i32
//   16..271:   facts, 32 x 8B [sub,rel,obj,live,epoch,0,0,0]
//   272..527:  MAPs, 8 x 32B [tag=20,live,start,end,rlen,flen,reason,pad,
//                rels x8 @+8, facts x8 @+16, pad x8 @+24]
//   528..783:  plan nodes, 32 x 8B [kind,depthlv,count,child,next,tokL,tokR,live]
//                kind 0=SEQ 1=PAIR 2=NEST; child/next ids, 255=none
//   784..911:  programs, 4 x 32B [plen,tP,tD,epoch,acc,measD,measP,
//                L,R,pad,pad,pad, ops x20 @+12]
//   912..975:  provenance log, 16 x 4B [kind,a,b,pad]
//                kind 1=REUSE 2=SUPERSEDE 3=RETIRE
//   976..1103: output buffer, 128B
//   1104..1231: scratch, 128B
//   1232..1359: assemble stack, 64 x 2B [nid,phase]
//   1360..4095: spare

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=32){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=st[5];
  st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// newest live fact with (sub,rel) at current epoch; obj or -1.
fn f_find(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let ep:i32=st[5] as i32;
  let best:i32=-1;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    let fe:i32=st[o+4] as i32;
    if(s0==sub && r0==rel && lv==1 && fe==ep){best=st[o+2] as i32;}
    i=i+1;
  }
  return best;
}

// count of live facts with (sub,rel) at any epoch.
fn f_count(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    if(s0==sub && r0==rel && lv==1){c=c+1;}
    i=i+1;
  }
  return c;
}

// ---- primitive MAPs (emit only; relseq length is always 1) ----
fn m_teach_emit(st:[]u8, rel:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=8){return -1;}
  let o:i32=272+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=0; st[o+3]=0;
  st[o+4]=1; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[o+8]=rel as u8;
  let k:i32=1;
  while(k<8){st[o+8+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+16+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+24+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}

// ---- plan nodes ----
fn pn_alloc(st:[]u8, kind:i32, depthlv:i32, count:i32, child:i32, next:i32, tokL:i32, tokR:i32)i32 {
  let n:i32=st[2] as i32;
  if(n>=32){return -1;}
  let o:i32=528+n*8;
  st[o]=kind as u8; st[o+1]=depthlv as u8; st[o+2]=count as u8; st[o+3]=child as u8;
  st[o+4]=next as u8; st[o+5]=tokL as u8; st[o+6]=tokR as u8; st[o+7]=1;
  st[2]=(n+1) as u8;
  set32(st,8,get32(st,8)+1);
  return n;
}

// ---- provenance log ----
fn prov_add(st:[]u8, kind:i32, a:i32, b:i32)void {
  let n:i32=st[7] as i32;
  if(n>=16){return;}
  let o:i32=912+n*4;
  st[o]=kind as u8; st[o+1]=a as u8; st[o+2]=b as u8; st[o+3]=0;
  st[7]=(n+1) as u8;
  return;
}

// ---- string measurement (learner-owned) ----
// packed: bit24 balanced, bits12..23 maxdepth, bits0..11 pair count.
fn l_scan_pack(buf:[]u8, len:i32, L:i32, R:i32)i32 {
  let depth:i32=0;
  let maxd:i32=0;
  let pairs:i32=0;
  let bal:i32=1;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    if(c==L){
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      if(c==R){depth=depth-1;pairs=pairs+1;}
      else {bal=0;}
    }
    if(depth<0){bal=0;}
    i=i+1;
  }
  if(depth!=0){bal=0;}
  return (bal<<24)|(maxd<<12)|pairs;
}

// ---- constraint extraction: probes the world, binds (L,R,D) ----
// The open/close assignment and the max depth come from w_check
// outcomes, not from researcher literals.
fn l_extract(st:[]u8, w:[]u8)i32 {
  let c0:i32=-1;
  let c1:i32=-1;
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    if(s0==72 && r0==89 && lv==1){
      let c:i32=st[o+2] as i32;
      if(c0==-1){c0=c;}
      else { if(c1==-1 && c!=c0){c1=c;} }
    }
    i=i+1;
  }
  if(c0==-1){return -1;}
  if(c1==-1){return -1;}
  let sc:[]u8=z_alloc(16);
  let L:i32=-1;
  let R:i32=-1;
  sc[0]=c0 as u8; sc[1]=c1 as u8;
  let r0b:i32=w_check(w,sc,2);
  if(r0b==1){L=c0;R=c1;}
  else {
    sc[0]=c1 as u8; sc[1]=c0 as u8;
    let r1b:i32=w_check(w,sc,2);
    if(r1b==1){L=c1;R=c0;}
    else {return -1;}
  }
  let D:i32=-1;
  let d:i32=0;
  while(d<=5){
    let k:i32=0;
    while(k<d){sc[k]=L as u8;k=k+1;}
    let j2:i32=0;
    while(j2<d){sc[d+j2]=R as u8;j2=j2+1;}
    let rr:i32=w_check(w,sc,d*2);
    if(rr==1){
      f_teach(st,71,87,d);
      D=d;
    }
    else {f_teach(st,71,88,d);}
    d=d+1;
  }
  if(D<0){return -1;}
  let m:i32=st[0] as i32;
  let q:i32=0;
  while(q<m){
    let o:i32=16+q*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    if(s0==70 && (r0==80 || r0==81 || r0==82)){st[o+3]=0;}
    q=q+1;
  }
  f_teach(st,70,80,L);
  f_teach(st,70,81,R);
  f_teach(st,70,82,D);
  return D;
}

// ---- plan builder ----
// Builds the intermediate construction plan for target (P pairs,
// exact depth D): root SEQ with child = nested core
// (NEST depthlv 1..D-1 over an inner PAIR) and next = flat tail
// (PAIR count P-D). Each NEST node carries its absolute depth
// level: the constraint budget propagated to each part.
// Returns root node id, or -1 on refusal.
fn nest_chain(st:[]u8, maxD:i32, tokL:i32, tokR:i32)i32 {
  let inner:i32=pn_alloc(st,1,0,1,255,255,tokL,tokR);
  if(inner<0){return -1;}
  let lv:i32=maxD-1;
  while(lv>=1){
    let nd:i32=pn_alloc(st,2,lv,0,inner,255,tokL,tokR);
    if(nd<0){return -1;}
    inner=nd;
    lv=lv-1;
  }
  return inner;
}

fn plan_build(st:[]u8, P:i32, D:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  let Dm:i32=f_find(st,70,82);
  if(L<0){return -1;}
  if(R<0){return -1;}
  if(Dm<0){return -1;}
  if(D>Dm){return -1;}
  if(P<D){return -1;}
  let core:i32=nest_chain(st,D,L,R);
  if(core<0){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-D,255,255,L,R);
  if(tail<0){return -1;}
  let root:i32=pn_alloc(st,0,0,0,core,255,L,R);
  if(root<0){return -1;}
  let ro:i32=528+root*8;
  st[ro+4]=tail as u8;
  return root;
}

// Reuse: new root SEQ shares an existing live core node verbatim
// (no rebuild, no mutation of the shared node) plus a new tail.
fn plan_build_reuse(st:[]u8, P:i32, D:i32, core_id:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  let Dm:i32=f_find(st,70,82);
  if(L<0){return -1;}
  if(R<0){return -1;}
  if(Dm<0){return -1;}
  if(D>Dm){return -1;}
  if(P<D){return -1;}
  if(core_id<0){return -1;}
  if(core_id>=32){return -1;}
  let co:i32=528+core_id*8;
  if((st[co+7] as i32)!=1){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-D,255,255,L,R);
  if(tail<0){return -1;}
  let root:i32=pn_alloc(st,0,0,0,core_id,255,L,R);
  if(root<0){return -1;}
  let ro:i32=528+root*8;
  st[ro+4]=tail as u8;
  prov_add(st,1,root,core_id);
  return root;
}

fn plan_retire_all(st:[]u8, reason:i32)void {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=528+i*8;
    if((st[o+7] as i32)==1){
      st[o+7]=0;
      prov_add(st,3,i,reason);
    }
    i=i+1;
  }
  return;
}

// Revision: retire the whole old plan (superseded), build fresh
// under the new-epoch constraint, record SUPERSEDE provenance.
fn plan_revise(st:[]u8, P:i32, D:i32, old_root:i32)i32 {
  plan_retire_all(st,2);
  let root:i32=plan_build(st,P,D);
  if(root<0){return -1;}
  prov_add(st,2,root,old_root);
  return root;
}

// ---- program assembly: plan -> MAP-chain program ----
fn prog_emit_op(st:[]u8, po:i32, op:i32)i32 {
  let plen:i32=st[po] as i32;
  if(plen>=20){return -1;}
  st[po+12+plen]=op as u8;
  st[po]=(plen+1) as u8;
  set32(st,8,get32(st,8)+1);
  return 0;
}

// Iterative depth-first walk with an explicit stack (no recursion).
// SEQ: child subtree then next subtree. NEST: check depthlv <=
// current Dmax (per-part budget), emit open, child, emit close.
// PAIR: emit count pairs.
fn assemble(st:[]u8, root:i32, P:i32, D:i32)i32 {
  let np:i32=st[4] as i32;
  if(np>=4){return -1;}
  if(root<0){return -1;}
  if(root>=32){return -1;}
  let po:i32=784+np*32;
  let ro:i32=528+root*8;
  let pL:i32=st[ro+5] as i32;
  let pR:i32=st[ro+6] as i32;
  st[po]=0; st[po+1]=P as u8; st[po+2]=D as u8; st[po+3]=st[5];
  st[po+4]=0; st[po+5]=0; st[po+6]=0; st[po+7]=pL as u8;
  st[po+8]=pR as u8; st[po+9]=0; st[po+10]=0; st[po+11]=0;
  let Dm:i32=f_find(st,70,82);
  if(Dm<0){return -1;}
  st[1232]=root as u8; st[1233]=0;
  let sp:i32=1;
  let fail:i32=0;
  while(sp>0){
    sp=sp-1;
    let nid:i32=st[1232+sp*2] as i32;
    let ph:i32=st[1232+sp*2+1] as i32;
    let o:i32=528+nid*8;
    let kind:i32=st[o] as i32;
    let live:i32=st[o+7] as i32;
    let ok:i32=1;
    if(live!=1){ok=0;}
    if(sp>=64){ok=0;}
    if(ok==1 && ph==1 && kind==2){
      let rc:i32=prog_emit_op(st,po,1);
      if(rc<0){ok=0;}
    }
    if(ok==1 && ph==0 && kind==0){
      let nx:i32=st[o+4] as i32;
      let ch:i32=st[o+3] as i32;
      if(nx!=255){st[1232+sp*2]=nx as u8;st[1232+sp*2+1]=0;sp=sp+1;}
      if(ch!=255){st[1232+sp*2]=ch as u8;st[1232+sp*2+1]=0;sp=sp+1;}
    }
    if(ok==1 && ph==0 && kind==1){
      let c:i32=st[o+2] as i32;
      let k:i32=0;
      while(k<c){
        let r0:i32=prog_emit_op(st,po,0);
        let r1:i32=prog_emit_op(st,po,1);
        if(r0<0 || r1<0){ok=0;k=c;}
        else {k=k+1;}
      }
    }
    if(ok==1 && ph==0 && kind==2){
      let lv:i32=st[o+1] as i32;
      set32(st,8,get32(st,8)+1);
      if(lv>Dm){ok=0;}
      if(ok==1){
        let r2:i32=prog_emit_op(st,po,0);
        if(r2<0){ok=0;}
      }
      if(ok==1){
        st[1232+sp*2]=nid as u8;st[1232+sp*2+1]=1;sp=sp+1;
        let ch2:i32=st[o+3] as i32;
        if(ch2!=255){st[1232+sp*2]=ch2 as u8;st[1232+sp*2+1]=0;sp=sp+1;}
      }
    }
    if(ok==1 && ph==0 && kind!=0 && kind!=1 && kind!=2){ok=0;}
    if(ok==1 && ph!=0 && ph!=1){ok=0;}
    if(ok==0){fail=1;sp=0;}
  }
  if(fail==1){return -1;}
  st[4]=(np+1) as u8;
  return np;
}

// ---- execution: run the MAP-chain program, world verifies ----
fn execute(st:[]u8, w:[]u8, prog:i32)i32 {
  if(prog<0){return -1;}
  if(prog>=4){return -1;}
  let po:i32=784+prog*32;
  let plen:i32=st[po] as i32;
  let pL:i32=st[po+7] as i32;
  let pR:i32=st[po+8] as i32;
  let olen:i32=0;
  let depth:i32=0;
  let maxd:i32=0;
  let pairs:i32=0;
  let i:i32=0;
  while(i<plen){
    let op:i32=st[po+12+i] as i32;
    let mo:i32=272+op*32;
    if((st[mo+1] as i32)!=1){return -1;}
    if(op==0){
      st[976+olen]=pL as u8;
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      st[976+olen]=pR as u8;
      depth=depth-1;
      pairs=pairs+1;
    }
    set32(st,8,get32(st,8)+1);
    olen=olen+1;
    i=i+1;
  }
  let ob2:[]u8=st[976..976+olen];
  let acc:i32=w_check(w,ob2,olen);
  set32(st,8,get32(st,8)+olen);
  st[po+4]=acc as u8;
  st[po+5]=maxd as u8;
  st[po+6]=pairs as u8;
  return acc;
}

// ---- no-intermediate control: direct constraint -> program ----
// Enumerates emit sequences by length (2,4,...,2P) in lex order
// using only the constraint bindings and the world check.
// Knows the target (P,D): the goal is given, the question is
// whether an intermediate plan is needed to reach it.
fn direct_try(st:[]u8, w:[]u8, P:i32, D:i32, budget:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  if(L<0){return 0;}
  if(R<0){return 0;}
  let sc:[]u8=z_alloc(16);
  let found:i32=0;
  let len:i32=2;
  while(len<=2*P){
    let total:i32=1;
    let b:i32=0;
    while(b<len){total=total*2;b=b+1;}
    let mask:i32=0;
    while(mask<total){
      let cost:i32=len+len+1;
      let dop:i32=get32(st,12);
      if(dop+cost>budget){return 0;}
      let k:i32=0;
      while(k<len){
        let bit:i32=(mask>>k)&1;
        if(bit==0){sc[k]=L as u8;}
        else {sc[k]=R as u8;}
        k=k+1;
      }
      set32(st,12,dop+cost);
      let pk:i32=l_scan_pack(sc,len,L,R);
      let bal:i32=(pk>>24)&1;
      let mxd:i32=(pk>>12)&4095;
      let prs:i32=pk&4095;
      if(bal==1 && mxd==D && prs==P){
        let acc:i32=w_check(w,sc,len);
        if(acc==1){found=1;}
      }
      if(found==1){mask=total;len=2*P+1;}
      else {mask=mask+1;}
    }
    len=len+2;
  }
  return found;
}

// ---- construction entry ----
fn construct(st:[]u8, w:[]u8, P:i32, D:i32, budget:i32)i32 {
  let pon:i32=st[3] as i32;
  if(pon==0){return direct_try(st,w,P,D,budget);}
  let root:i32=plan_build(st,P,D);
  if(root<0){return 0;}
  let prog:i32=assemble(st,root,P,D);
  if(prog<0){return 0;}
  let acc:i32=execute(st,w,prog);
  if(acc==1){return 1;}
  return 0;
}

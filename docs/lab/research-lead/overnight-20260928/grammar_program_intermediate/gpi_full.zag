// gpi_world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Delimiter truth, Dmax, w_check, w_setdmax. The learner never
// calls w_setdmax; it only observes w_check outcomes through
// probes and program verification. World state: w[0] = dmax.
// Delimiters are fixed at (40, 41) for the whole experiment;
// only the max-depth bound changes (3 -> 4, driver act).

fn w_dmax_set(w:[]u8, v:i32)void {
  w[0]=v as u8;
  return;
}

fn w_dmax_get(w:[]u8)i32 {
  return w[0] as i32;
}

// w_check: 1 iff every byte is 40/41, the string is balanced,
// and max nesting depth <= dmax. 0 otherwise.
fn w_check(w:[]u8, buf:[]u8, len:i32)i32 {
  let dmax:i32=w[0] as i32;
  let depth:i32=0;
  let maxd:i32=0;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    if(c==40){
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      if(c==41){
        depth=depth-1;
        if(depth<0){return 0;}
      }
      else {return 0;}
    }
    i=i+1;
  }
  if(depth!=0){return 0;}
  if(maxd>dmax){return 0;}
  return 1;
}
// gpi_learner.zag -- learner side.
// Generic machinery + learned state only. No world data, no
// constraint literals, no target literals in this file. Relation
// ids are the observation vocabulary disclosed in the prereg.
// The learner never selects a plan per problem from a menu: the
// plan builder computes the decomposition from the learned
// constraint facts and the target parameters (P, D) at episode
// time. 0 modes, 0 handlers, 0 new edge types (no edges used
// anywhere), 0 new opcodes, 0 semantic cases. The two primitive
// emit MAPs are the only MAP form; max relseq length is 1.
//
// State layout (u8 buffer, 4096B):
//   0 NF  1 NM  2 NPLAN  3 PLAN_ON  4 NPROG  5 EPOCH  6 WIPED  7 NPROV
//   8..11 PLAN_OPS i32  12..15 DIRECT_OPS i32
//   16..271:   facts, 32 x 8B [sub,rel,obj,live,epoch,0,0,0]
//   272..527:  MAPs, 8 x 32B [tag=20,live,start,end,rlen,flen,reason,pad,
//                rels x8 @+8, facts x8 @+16, pad x8 @+24]
//   528..783:  plan nodes, 32 x 8B [kind,depthlv,count,child,next,tokL,tokR,live]
//                kind 0=SEQ 1=PAIR 2=NEST; child/next ids, 255=none
//   784..911:  programs, 4 x 32B [plen,tP,tD,epoch,acc,measD,measP,
//                L,R,pad,pad,pad, ops x20 @+12]
//   912..975:  provenance log, 16 x 4B [kind,a,b,pad]
//                kind 1=REUSE 2=SUPERSEDE 3=RETIRE
//   976..1103: output buffer, 128B
//   1104..1231: scratch, 128B
//   1232..1359: assemble stack, 64 x 2B [nid,phase]
//   1360..4095: spare

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=32){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=st[5];
  st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// newest live fact with (sub,rel) at current epoch; obj or -1.
fn f_find(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let ep:i32=st[5] as i32;
  let best:i32=-1;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    let fe:i32=st[o+4] as i32;
    if(s0==sub && r0==rel && lv==1 && fe==ep){best=st[o+2] as i32;}
    i=i+1;
  }
  return best;
}

// count of live facts with (sub,rel) at any epoch.
fn f_count(st:[]u8, sub:i32, rel:i32)i32 {
  let n:i32=st[0] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    if(s0==sub && r0==rel && lv==1){c=c+1;}
    i=i+1;
  }
  return c;
}

// ---- primitive MAPs (emit only; relseq length is always 1) ----
fn m_teach_emit(st:[]u8, rel:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=8){return -1;}
  let o:i32=272+n*32;
  st[o]=20; st[o+1]=1; st[o+2]=0; st[o+3]=0;
  st[o+4]=1; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[o+8]=rel as u8;
  let k:i32=1;
  while(k<8){st[o+8+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+16+k]=0;k=k+1;}
  k=0;
  while(k<8){st[o+24+k]=0;k=k+1;}
  st[1]=(n+1) as u8;
  return n;
}

// ---- plan nodes ----
fn pn_alloc(st:[]u8, kind:i32, depthlv:i32, count:i32, child:i32, next:i32, tokL:i32, tokR:i32)i32 {
  let n:i32=st[2] as i32;
  if(n>=32){return -1;}
  let o:i32=528+n*8;
  st[o]=kind as u8; st[o+1]=depthlv as u8; st[o+2]=count as u8; st[o+3]=child as u8;
  st[o+4]=next as u8; st[o+5]=tokL as u8; st[o+6]=tokR as u8; st[o+7]=1;
  st[2]=(n+1) as u8;
  set32(st,8,get32(st,8)+1);
  return n;
}

// ---- provenance log ----
fn prov_add(st:[]u8, kind:i32, a:i32, b:i32)void {
  let n:i32=st[7] as i32;
  if(n>=16){return;}
  let o:i32=912+n*4;
  st[o]=kind as u8; st[o+1]=a as u8; st[o+2]=b as u8; st[o+3]=0;
  st[7]=(n+1) as u8;
  return;
}

// ---- string measurement (learner-owned) ----
// packed: bit24 balanced, bits12..23 maxdepth, bits0..11 pair count.
fn l_scan_pack(buf:[]u8, len:i32, L:i32, R:i32)i32 {
  let depth:i32=0;
  let maxd:i32=0;
  let pairs:i32=0;
  let bal:i32=1;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    if(c==L){
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      if(c==R){depth=depth-1;pairs=pairs+1;}
      else {bal=0;}
    }
    if(depth<0){bal=0;}
    i=i+1;
  }
  if(depth!=0){bal=0;}
  return (bal<<24)|(maxd<<12)|pairs;
}

// ---- constraint extraction: probes the world, binds (L,R,D) ----
// The open/close assignment and the max depth come from w_check
// outcomes, not from researcher literals.
fn l_extract(st:[]u8, w:[]u8)i32 {
  let c0:i32=-1;
  let c1:i32=-1;
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=16+i*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    let lv:i32=st[o+3] as i32;
    if(s0==72 && r0==89 && lv==1){
      let c:i32=st[o+2] as i32;
      if(c0==-1){c0=c;}
      else { if(c1==-1 && c!=c0){c1=c;} }
    }
    i=i+1;
  }
  if(c0==-1){return -1;}
  if(c1==-1){return -1;}
  let sc:[]u8=z_alloc(16);
  let L:i32=-1;
  let R:i32=-1;
  sc[0]=c0 as u8; sc[1]=c1 as u8;
  let r0b:i32=w_check(w,sc,2);
  if(r0b==1){L=c0;R=c1;}
  else {
    sc[0]=c1 as u8; sc[1]=c0 as u8;
    let r1b:i32=w_check(w,sc,2);
    if(r1b==1){L=c1;R=c0;}
    else {return -1;}
  }
  let D:i32=-1;
  let d:i32=0;
  while(d<=5){
    let k:i32=0;
    while(k<d){sc[k]=L as u8;k=k+1;}
    let j2:i32=0;
    while(j2<d){sc[d+j2]=R as u8;j2=j2+1;}
    let rr:i32=w_check(w,sc,d*2);
    if(rr==1){
      f_teach(st,71,87,d);
      D=d;
    }
    else {f_teach(st,71,88,d);}
    d=d+1;
  }
  if(D<0){return -1;}
  let m:i32=st[0] as i32;
  let q:i32=0;
  while(q<m){
    let o:i32=16+q*8;
    let s0:i32=st[o] as i32;
    let r0:i32=st[o+1] as i32;
    if(s0==70 && (r0==80 || r0==81 || r0==82)){st[o+3]=0;}
    q=q+1;
  }
  f_teach(st,70,80,L);
  f_teach(st,70,81,R);
  f_teach(st,70,82,D);
  return D;
}

// ---- plan builder ----
// Builds the intermediate construction plan for target (P pairs,
// exact depth D): root SEQ with child = nested core
// (NEST depthlv 1..D-1 over an inner PAIR) and next = flat tail
// (PAIR count P-D). Each NEST node carries its absolute depth
// level: the constraint budget propagated to each part.
// Returns root node id, or -1 on refusal.
fn nest_chain(st:[]u8, maxD:i32, tokL:i32, tokR:i32)i32 {
  let inner:i32=pn_alloc(st,1,0,1,255,255,tokL,tokR);
  if(inner<0){return -1;}
  let lv:i32=maxD-1;
  while(lv>=1){
    let nd:i32=pn_alloc(st,2,lv,0,inner,255,tokL,tokR);
    if(nd<0){return -1;}
    inner=nd;
    lv=lv-1;
  }
  return inner;
}

fn plan_build(st:[]u8, P:i32, D:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  let Dm:i32=f_find(st,70,82);
  if(L<0){return -1;}
  if(R<0){return -1;}
  if(Dm<0){return -1;}
  if(D>Dm){return -1;}
  if(P<D){return -1;}
  let core:i32=nest_chain(st,D,L,R);
  if(core<0){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-D,255,255,L,R);
  if(tail<0){return -1;}
  let root:i32=pn_alloc(st,0,0,0,core,255,L,R);
  if(root<0){return -1;}
  let ro:i32=528+root*8;
  st[ro+4]=tail as u8;
  return root;
}

// Reuse: new root SEQ shares an existing live core node verbatim
// (no rebuild, no mutation of the shared node) plus a new tail.
fn plan_build_reuse(st:[]u8, P:i32, D:i32, core_id:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  let Dm:i32=f_find(st,70,82);
  if(L<0){return -1;}
  if(R<0){return -1;}
  if(Dm<0){return -1;}
  if(D>Dm){return -1;}
  if(P<D){return -1;}
  if(core_id<0){return -1;}
  if(core_id>=32){return -1;}
  let co:i32=528+core_id*8;
  if((st[co+7] as i32)!=1){return -1;}
  let tail:i32=pn_alloc(st,1,0,P-D,255,255,L,R);
  if(tail<0){return -1;}
  let root:i32=pn_alloc(st,0,0,0,core_id,255,L,R);
  if(root<0){return -1;}
  let ro:i32=528+root*8;
  st[ro+4]=tail as u8;
  prov_add(st,1,root,core_id);
  return root;
}

fn plan_retire_all(st:[]u8, reason:i32)void {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=528+i*8;
    if((st[o+7] as i32)==1){
      st[o+7]=0;
      prov_add(st,3,i,reason);
    }
    i=i+1;
  }
  return;
}

// Revision: retire the whole old plan (superseded), build fresh
// under the new-epoch constraint, record SUPERSEDE provenance.
fn plan_revise(st:[]u8, P:i32, D:i32, old_root:i32)i32 {
  plan_retire_all(st,2);
  let root:i32=plan_build(st,P,D);
  if(root<0){return -1;}
  prov_add(st,2,root,old_root);
  return root;
}

// ---- program assembly: plan -> MAP-chain program ----
fn prog_emit_op(st:[]u8, po:i32, op:i32)i32 {
  let plen:i32=st[po] as i32;
  if(plen>=20){return -1;}
  st[po+12+plen]=op as u8;
  st[po]=(plen+1) as u8;
  set32(st,8,get32(st,8)+1);
  return 0;
}

// Iterative depth-first walk with an explicit stack (no recursion).
// SEQ: child subtree then next subtree. NEST: check depthlv <=
// current Dmax (per-part budget), emit open, child, emit close.
// PAIR: emit count pairs.
fn assemble(st:[]u8, root:i32, P:i32, D:i32)i32 {
  let np:i32=st[4] as i32;
  if(np>=4){return -1;}
  if(root<0){return -1;}
  if(root>=32){return -1;}
  let po:i32=784+np*32;
  let ro:i32=528+root*8;
  let pL:i32=st[ro+5] as i32;
  let pR:i32=st[ro+6] as i32;
  st[po]=0; st[po+1]=P as u8; st[po+2]=D as u8; st[po+3]=st[5];
  st[po+4]=0; st[po+5]=0; st[po+6]=0; st[po+7]=pL as u8;
  st[po+8]=pR as u8; st[po+9]=0; st[po+10]=0; st[po+11]=0;
  let Dm:i32=f_find(st,70,82);
  if(Dm<0){return -1;}
  st[1232]=root as u8; st[1233]=0;
  let sp:i32=1;
  let fail:i32=0;
  while(sp>0){
    sp=sp-1;
    let nid:i32=st[1232+sp*2] as i32;
    let ph:i32=st[1232+sp*2+1] as i32;
    let o:i32=528+nid*8;
    let kind:i32=st[o] as i32;
    let live:i32=st[o+7] as i32;
    let ok:i32=1;
    if(live!=1){ok=0;}
    if(sp>=64){ok=0;}
    if(ok==1 && ph==1 && kind==2){
      let rc:i32=prog_emit_op(st,po,1);
      if(rc<0){ok=0;}
    }
    if(ok==1 && ph==0 && kind==0){
      let nx:i32=st[o+4] as i32;
      let ch:i32=st[o+3] as i32;
      if(nx!=255){st[1232+sp*2]=nx as u8;st[1232+sp*2+1]=0;sp=sp+1;}
      if(ch!=255){st[1232+sp*2]=ch as u8;st[1232+sp*2+1]=0;sp=sp+1;}
    }
    if(ok==1 && ph==0 && kind==1){
      let c:i32=st[o+2] as i32;
      let k:i32=0;
      while(k<c){
        let r0:i32=prog_emit_op(st,po,0);
        let r1:i32=prog_emit_op(st,po,1);
        if(r0<0 || r1<0){ok=0;k=c;}
        else {k=k+1;}
      }
    }
    if(ok==1 && ph==0 && kind==2){
      let lv:i32=st[o+1] as i32;
      set32(st,8,get32(st,8)+1);
      if(lv>Dm){ok=0;}
      if(ok==1){
        let r2:i32=prog_emit_op(st,po,0);
        if(r2<0){ok=0;}
      }
      if(ok==1){
        st[1232+sp*2]=nid as u8;st[1232+sp*2+1]=1;sp=sp+1;
        let ch2:i32=st[o+3] as i32;
        if(ch2!=255){st[1232+sp*2]=ch2 as u8;st[1232+sp*2+1]=0;sp=sp+1;}
      }
    }
    if(ok==1 && ph==0 && kind!=0 && kind!=1 && kind!=2){ok=0;}
    if(ok==1 && ph!=0 && ph!=1){ok=0;}
    if(ok==0){fail=1;sp=0;}
  }
  if(fail==1){return -1;}
  st[4]=(np+1) as u8;
  return np;
}

// ---- execution: run the MAP-chain program, world verifies ----
fn execute(st:[]u8, w:[]u8, prog:i32)i32 {
  if(prog<0){return -1;}
  if(prog>=4){return -1;}
  let po:i32=784+prog*32;
  let plen:i32=st[po] as i32;
  let pL:i32=st[po+7] as i32;
  let pR:i32=st[po+8] as i32;
  let olen:i32=0;
  let depth:i32=0;
  let maxd:i32=0;
  let pairs:i32=0;
  let i:i32=0;
  while(i<plen){
    let op:i32=st[po+12+i] as i32;
    let mo:i32=272+op*32;
    if((st[mo+1] as i32)!=1){return -1;}
    if(op==0){
      st[976+olen]=pL as u8;
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      st[976+olen]=pR as u8;
      depth=depth-1;
      pairs=pairs+1;
    }
    set32(st,8,get32(st,8)+1);
    olen=olen+1;
    i=i+1;
  }
  let ob2:[]u8=st[976..976+olen];
  let acc:i32=w_check(w,ob2,olen);
  set32(st,8,get32(st,8)+olen);
  st[po+4]=acc as u8;
  st[po+5]=maxd as u8;
  st[po+6]=pairs as u8;
  return acc;
}

// ---- no-intermediate control: direct constraint -> program ----
// Enumerates emit sequences by length (2,4,...,2P) in lex order
// using only the constraint bindings and the world check.
// Knows the target (P,D): the goal is given, the question is
// whether an intermediate plan is needed to reach it.
fn direct_try(st:[]u8, w:[]u8, P:i32, D:i32, budget:i32)i32 {
  let L:i32=f_find(st,70,80);
  let R:i32=f_find(st,70,81);
  if(L<0){return 0;}
  if(R<0){return 0;}
  let sc:[]u8=z_alloc(16);
  let found:i32=0;
  let len:i32=2;
  while(len<=2*P){
    let total:i32=1;
    let b:i32=0;
    while(b<len){total=total*2;b=b+1;}
    let mask:i32=0;
    while(mask<total){
      let cost:i32=len+len+1;
      let dop:i32=get32(st,12);
      if(dop+cost>budget){return 0;}
      let k:i32=0;
      while(k<len){
        let bit:i32=(mask>>k)&1;
        if(bit==0){sc[k]=L as u8;}
        else {sc[k]=R as u8;}
        k=k+1;
      }
      set32(st,12,dop+cost);
      let pk:i32=l_scan_pack(sc,len,L,R);
      let bal:i32=(pk>>24)&1;
      let mxd:i32=(pk>>12)&4095;
      let prs:i32=pk&4095;
      if(bal==1 && mxd==D && prs==P){
        let acc:i32=w_check(w,sc,len);
        if(acc==1){found=1;}
      }
      if(found==1){mask=total;len=2*P+1;}
      else {mask=mask+1;}
    }
    len=len+2;
  }
  return found;
}

// ---- construction entry ----
fn construct(st:[]u8, w:[]u8, P:i32, D:i32, budget:i32)i32 {
  let pon:i32=st[3] as i32;
  if(pon==0){return direct_try(st,w,P,D,budget);}
  let root:i32=plan_build(st,P,D);
  if(root<0){return 0;}
  let prog:i32=assemble(st,root,P,D);
  if(prog<0){return 0;}
  let acc:i32=execute(st,w,prog);
  if(acc==1){return 1;}
  return 0;
}
// gpi_driver.zag -- experiment side.
// Teaching, arms, kill-bar evaluation, output. The driver owns the
// world state and calls learner routines; it never builds plans
// itself. All kill-bar expectations are frozen in PREREG.md plus
// PREREG_AMENDMENT1.md.

fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn d_emit(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn d_emit1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_emit2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d_bar(name:[]u8, pass:i32, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}

// phase 0: teach alphabet observations + primitive MAPs; no extract.
fn d_phase0_noteach(st:[]u8, plan_on:i32)void {
  st[3]=plan_on as u8;
  st[5]=1;
  f_teach(st,72,89,41);
  f_teach(st,72,89,40);
  m_teach_emit(st,90);
  m_teach_emit(st,91);
  return;
}

// plan region byte sum (audit: must be 0 pre-construction).
fn d_planbytesum(st:[]u8)i32 {
  let s:i32=0;
  let i:i32=0;
  while(i<256){s=s+(st[528+i] as i32);i=i+1;}
  return s;
}

// snapshot outbuf bytes into dst.
fn d_snap(st:[]u8, dst:[]u8, len:i32)void {
  let i:i32=0;
  while(i<len){dst[i]=st[976+i];i=i+1;}
  return;
}

// check snapped bytes against 12 expected byte values (len used).
fn d_bytesok(dst:[]u8, len:i32, e0:i32, e1:i32, e2:i32, e3:i32, e4:i32, e5:i32, e6:i32, e7:i32, e8:i32, e9:i32, e10:i32, e11:i32)i32 {
  if(len>0 && (dst[0] as i32)!=e0){return 0;}
  if(len>1 && (dst[1] as i32)!=e1){return 0;}
  if(len>2 && (dst[2] as i32)!=e2){return 0;}
  if(len>3 && (dst[3] as i32)!=e3){return 0;}
  if(len>4 && (dst[4] as i32)!=e4){return 0;}
  if(len>5 && (dst[5] as i32)!=e5){return 0;}
  if(len>6 && (dst[6] as i32)!=e6){return 0;}
  if(len>7 && (dst[7] as i32)!=e7){return 0;}
  if(len>8 && (dst[8] as i32)!=e8){return 0;}
  if(len>9 && (dst[9] as i32)!=e9){return 0;}
  if(len>10 && (dst[10] as i32)!=e10){return 0;}
  if(len>11 && (dst[11] as i32)!=e11){return 0;}
  return 1;
}

fn d_plandump(st:[]u8, tag:[]u8, ob:[]u8, atp:[]u8)void {
  d_emit(ob,atp,tag);
  d_emit(ob,atp," plannodes:\n");
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=528+i*8;
    let at:i32=get32(atp,0);
    at=ob_app(ob,at,"  nid=");
    at=ob_i32(ob,at,i);
    at=ob_app(ob,at," kind=");
    at=ob_i32(ob,at,st[o] as i32);
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,st[o+1] as i32);
    at=ob_app(ob,at," c=");
    at=ob_i32(ob,at,st[o+2] as i32);
    at=ob_app(ob,at," ch=");
    at=ob_i32(ob,at,st[o+3] as i32);
    at=ob_app(ob,at," nx=");
    at=ob_i32(ob,at,st[o+4] as i32);
    at=ob_app(ob,at," L=");
    at=ob_i32(ob,at,st[o+5] as i32);
    at=ob_app(ob,at," R=");
    at=ob_i32(ob,at,st[o+6] as i32);
    at=ob_app(ob,at," live=");
    at=ob_i32(ob,at,st[o+7] as i32);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    i=i+1;
  }
  return;
}

fn d_progdump(st:[]u8, pid:i32, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let po:i32=784+pid*32;
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," prog");
  at=ob_i32(ob,at,pid);
  at=ob_app(ob,at,": plen=");
  at=ob_i32(ob,at,st[po] as i32);
  at=ob_app(ob,at," tP=");
  at=ob_i32(ob,at,st[po+1] as i32);
  at=ob_app(ob,at," tD=");
  at=ob_i32(ob,at,st[po+2] as i32);
  at=ob_app(ob,at," ep=");
  at=ob_i32(ob,at,st[po+3] as i32);
  at=ob_app(ob,at," acc=");
  at=ob_i32(ob,at,st[po+4] as i32);
  at=ob_app(ob,at," measD=");
  at=ob_i32(ob,at,st[po+5] as i32);
  at=ob_app(ob,at," measP=");
  at=ob_i32(ob,at,st[po+6] as i32);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,st[po+7] as i32);
  at=ob_app(ob,at," R=");
  at=ob_i32(ob,at,st[po+8] as i32);
  at=ob_app(ob,at," ops=");
  let plen:i32=st[po] as i32;
  let i:i32=0;
  while(i<plen){
    at=ob_i32(ob,at,st[po+12+i] as i32);
    i=i+1;
  }
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

fn d_outchars(st:[]u8, len:i32, tag:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," chars=\"");
  let i:i32=0;
  while(i<len){ob[at]=st[976+i];at=at+1;i=i+1;}
  at=ob_app(ob,at,"\"\n");
  set32(atp,0,at);
  return;
}

fn d_provdump(st:[]u8, tag:[]u8, ob:[]u8, atp:[]u8)void {
  d_emit(ob,atp,tag);
  d_emit(ob,atp," provlog:\n");
  let n:i32=st[7] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=912+i*4;
    let at:i32=get32(atp,0);
    at=ob_app(ob,at,"  kind=");
    at=ob_i32(ob,at,st[o] as i32);
    at=ob_app(ob,at," a=");
    at=ob_i32(ob,at,st[o+1] as i32);
    at=ob_app(ob,at," b=");
    at=ob_i32(ob,at,st[o+2] as i32);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    i=i+1;
  }
  return;
}

// find provenance entry (kind,a,b); 1 if present.
fn d_provhas(st:[]u8, kind:i32, a:i32, b:i32)i32 {
  let n:i32=st[7] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=912+i*4;
    if((st[o] as i32)==kind && (st[o+1] as i32)==a && (st[o+2] as i32)==b){return 1;}
    i=i+1;
  }
  return 0;
}

fn d_pnode(st:[]u8, nid:i32, f:i32)i32 {
  return st[528+nid*8+f] as i32;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let w:[]u8=z_alloc(8);
  w_dmax_set(w,3);
  d_emit(ob,atp,"GPI-1 grammar-constraints to program-construction via created intermediate\n");
  d_emit1(ob,atp,"world dmax=",w_dmax_get(w));

  // ============ ARM-T1: phase 0 + construction ============
  d_emit(ob,atp,"=== ARM-T1 phase0 ===\n");
  let st1:[]u8=z_alloc(4096);
  d_phase0_noteach(st1,1);
  let dx1:i32=l_extract(st1,w);
  d_emit1(ob,atp,"EXTRACT D=",dx1);
  d_emit1(ob,atp,"EXTRACT L=",(f_find(st1,70,80)));
  d_emit1(ob,atp,"EXTRACT R=",(f_find(st1,70,81)));
  d_emit2(ob,atp,"probe accept count=",(f_count(st1,71,87))," reject count=",(f_count(st1,71,88)));
  // K1
  let k1:i32=1;
  if(f_find(st1,70,80)!=40){k1=0;}
  if(f_find(st1,70,81)!=41){k1=0;}
  if(f_find(st1,70,82)!=3){k1=0;}
  if(f_count(st1,71,87)!=4){k1=0;}
  if(f_count(st1,71,88)!=2){k1=0;}
  if(dx1!=3){k1=0;}
  // K2 pre-construction audit
  let k2:i32=1;
  if((st1[2] as i32)!=0){k2=0;}
  if(d_planbytesum(st1)!=0){k2=0;}
  if((st1[1] as i32)!=2){k2=0;}
  if((st1[272+4] as i32)!=1){k2=0;}
  if((st1[304+4] as i32)!=1){k2=0;}
  if((st1[4] as i32)!=0){k2=0;}
  d_emit2(ob,atp,"PRE planbytesum=",(d_planbytesum(st1))," nplan=",(st1[2] as i32));
  d_emit(ob,atp,"=== ARM-T1 construct(4,3) ===\n");
  let root1:i32=plan_build(st1,4,3);
  d_emit1(ob,atp,"PLAN-CREATE root=",root1);
  let prog1:i32=assemble(st1,root1,4,3);
  let acc1:i32=execute(st1,w,prog1);
  d_emit2(ob,atp,"program=",(prog1)," acc=",(acc1));
  let snap1:[]u8=z_alloc(16);
  d_snap(st1,snap1,8);
  d_outchars(st1,8,"T1",ob,atp);
  d_plandump(st1,"T1",ob,atp);
  d_progdump(st1,prog1,"T1",ob,atp);
  d_emit2(ob,atp,"PLAN_OPS=",(get32(st1,8))," DIRECT_OPS=",(get32(st1,12)));
  // K3
  let k3:i32=1;
  if(root1<0){k3=0;}
  if(prog1!=0){k3=0;}
  if((st1[784+0] as i32)!=8){k3=0;}
  if(d_bytesok(snap1,8,40,40,40,41,41,41,40,41,0,0,0,0)!=1){k3=0;}
  if((st1[784+4] as i32)!=1){k3=0;}
  if((st1[784+5] as i32)!=3){k3=0;}
  if((st1[784+6] as i32)!=4){k3=0;}
  // K4
  let k4:i32=1;
  if((st1[2] as i32)!=5){k4=0;}
  if(d_pnode(st1,4,0)!=0){k4=0;}
  if(d_pnode(st1,4,3)!=2){k4=0;}
  if(d_pnode(st1,4,4)!=3){k4=0;}
  if(d_pnode(st1,2,0)!=2){k4=0;}
  if(d_pnode(st1,2,1)!=1){k4=0;}
  if(d_pnode(st1,2,3)!=1){k4=0;}
  if(d_pnode(st1,2,4)!=255){k4=0;}
  if(d_pnode(st1,1,0)!=2){k4=0;}
  if(d_pnode(st1,1,1)!=2){k4=0;}
  if(d_pnode(st1,1,3)!=0){k4=0;}
  if(d_pnode(st1,1,4)!=255){k4=0;}
  if(d_pnode(st1,0,0)!=1){k4=0;}
  if(d_pnode(st1,0,2)!=1){k4=0;}
  if(d_pnode(st1,3,0)!=1){k4=0;}
  if(d_pnode(st1,3,2)!=1){k4=0;}
  let q4:i32=0;
  while(q4<5){
    if(d_pnode(st1,q4,5)!=40){k4=0;}
    if(d_pnode(st1,q4,6)!=41){k4=0;}
    if(d_pnode(st1,q4,7)!=1){k4=0;}
    q4=q4+1;
  }

  // ============ ARM-REUSE ============
  d_emit(ob,atp,"=== ARM-REUSE ===\n");
  let st2:[]u8=z_alloc(4096);
  d_phase0_noteach(st2,1);
  l_extract(st2,w);
  let rootA:i32=plan_build(st2,4,3);
  let coreA:i32=d_pnode(st2,rootA,3);
  d_emit2(ob,atp,"plan1 root=",(rootA)," core=",(coreA));
  let rootB:i32=plan_build_reuse(st2,6,3,coreA);
  d_emit2(ob,atp,"REUSE-CREATE root=",(rootB)," shared core=",(coreA));
  d_emit1(ob,atp,"core node live after share=",(d_pnode(st2,coreA,7)));
  let progB:i32=assemble(st2,rootB,6,3);
  let accB:i32=execute(st2,w,progB);
  let snapB:[]u8=z_alloc(16);
  d_snap(st2,snapB,12);
  d_outchars(st2,12,"T2",ob,atp);
  d_plandump(st2,"T2",ob,atp);
  d_progdump(st2,progB,"T2",ob,atp);
  d_provdump(st2,"T2",ob,atp);
  let k8:i32=1;
  if(d_pnode(st2,rootB,3)!=coreA){k8=0;}
  if(d_provhas(st2,1,rootB,coreA)!=1){k8=0;}
  if((st2[2] as i32)!=7){k8=0;}
  if((st2[784+0] as i32)!=12){k8=0;}
  if(d_bytesok(snapB,12,40,40,40,41,41,41,40,41,40,41,40,41)!=1){k8=0;}
  if((st2[784+4] as i32)!=1){k8=0;}
  if((st2[784+5] as i32)!=3){k8=0;}
  if((st2[784+6] as i32)!=6){k8=0;}
  d_emit2(ob,atp,"REUSE prog=",(progB)," acc=",(accB));

  // ============ ARM-REVISE ============
  d_emit(ob,atp,"=== ARM-REVISE ===\n");
  let st3:[]u8=z_alloc(4096);
  d_phase0_noteach(st3,1);
  l_extract(st3,w);
  let rootR1:i32=plan_build(st3,4,3);
  let progR0:i32=assemble(st3,rootR1,4,3);
  let accR0:i32=execute(st3,w,progR0);
  d_emit2(ob,atp,"pre-change prog0=",(progR0)," acc=",(accR0));
  w_dmax_set(w,4);
  d_emit1(ob,atp,"WORLD-CHANGE dmax=",(w_dmax_get(w)));
  st3[5]=2;
  let dx3:i32=l_extract(st3,w);
  d_emit2(ob,atp,"RE-EXTRACT epoch=",(st3[5] as i32)," D=",(dx3));
  let rootR3:i32=plan_revise(st3,6,4,rootR1);
  d_emit2(ob,atp,"REVISE-CREATE root=",(rootR3)," supersedes=",(rootR1));
  let progR1:i32=assemble(st3,rootR3,6,4);
  let accR1:i32=execute(st3,w,progR1);
  let snapR:[]u8=z_alloc(16);
  d_snap(st3,snapR,12);
  d_outchars(st3,12,"T3",ob,atp);
  d_plandump(st3,"T3",ob,atp);
  d_progdump(st3,progR1,"T3",ob,atp);
  d_provdump(st3,"T3",ob,atp);
  let accR0b:i32=execute(st3,w,progR0);
  d_emit2(ob,atp,"old prog0 re-executed acc=",(accR0b)," measD=",(st3[784+5] as i32));
  let k9:i32=1;
  if((st3[5] as i32)!=2){k9=0;}
  if(f_find(st3,70,82)!=4){k9=0;}
  let qr:i32=0;
  while(qr<5){
    if(d_pnode(st3,qr,7)!=0){k9=0;}
    qr=qr+1;
  }
  if(d_provhas(st3,2,rootR3,rootR1)!=1){k9=0;}
  if(d_provhas(st3,3,0,2)!=1){k9=0;}
  if(rootR3!=10){k9=0;}
  if(d_pnode(st3,10,3)!=8){k9=0;}
  if(d_pnode(st3,8,0)!=2){k9=0;}
  if(d_pnode(st3,8,1)!=1){k9=0;}
  if(d_pnode(st3,7,0)!=2){k9=0;}
  if(d_pnode(st3,7,1)!=2){k9=0;}
  if(d_pnode(st3,6,0)!=2){k9=0;}
  if(d_pnode(st3,6,1)!=3){k9=0;}
  if((st3[784+32+0] as i32)!=12){k9=0;}
  if(d_bytesok(snapR,12,40,40,40,40,41,41,41,41,40,41,40,41)!=1){k9=0;}
  if((st3[784+32+4] as i32)!=1){k9=0;}
  if((st3[784+32+5] as i32)!=4){k9=0;}
  if(accR0b!=1){k9=0;}
  if((st3[784+5] as i32)!=3){k9=0;}

  // ============ ARM-ABLATE ============
  d_emit(ob,atp,"=== ARM-ABLATE ===\n");
  let st4:[]u8=z_alloc(4096);
  d_phase0_noteach(st4,1);
  l_extract(st4,w);
  w_dmax_set(w,3);
  let rootW:i32=plan_build(st4,4,3);
  let progW:i32=assemble(st4,rootW,4,3);
  let accW:i32=execute(st4,w,progW);
  let snapOps:i32=get32(st4,8);
  d_emit2(ob,atp,"pre-wipe PLAN_OPS=",(snapOps)," acc=",(accW));
  let wz:i32=0;
  while(wz<256){st4[528+wz]=0;wz=wz+1;}
  st4[2]=0;
  st4[6]=1;
  d_emit2(ob,atp,"post-wipe planbytesum=",(d_planbytesum(st4))," nplan=",(st4[2] as i32));
  let foundW:i32=direct_try(st4,w,4,3,20000);
  let dopsW:i32=get32(st4,12);
  d_emit2(ob,atp,"ABLATE found=",(foundW)," DIRECT_OPS=",(dopsW));
  let k5:i32=1;
  if(foundW!=1){k5=0;}
  if(snapOps<=0){k5=0;}
  if(dopsW<10*snapOps){k5=0;}
  d_emit1(ob,atp,"cost ratio DIRECT/PLAN=",(dopsW/snapOps));
  d_emit1(ob,atp,"ratio inputs dops=",dopsW);
  d_emit1(ob,atp,"ratio inputs planops=",snapOps);

  // ============ ARM-NOCPLAN ============
  d_emit(ob,atp,"=== ARM-NOCPLAN ===\n");
  let st5:[]u8=z_alloc(4096);
  d_phase0_noteach(st5,0);
  l_extract(st5,w);
  let foundN:i32=construct(st5,w,4,3,500);
  d_emit2(ob,atp,"NOCPLAN found=",(foundN)," DIRECT_OPS=",(get32(st5,12)));
  let k6:i32=1;
  if(foundN!=0){k6=0;}
  if((st5[2] as i32)!=0){k6=0;}

  // ============ ARM-FRESH ============
  d_emit(ob,atp,"=== ARM-FRESH ===\n");
  let st6:[]u8=z_alloc(4096);
  d_phase0_noteach(st6,1);
  l_extract(st6,w);
  let foundF:i32=direct_try(st6,w,4,3,500);
  d_emit2(ob,atp,"FRESH found=",(foundF)," DIRECT_OPS=",(get32(st6,12)));
  let k7:i32=1;
  if(foundF!=0){k7=0;}

  // ============ ARM-XC ============
  d_emit(ob,atp,"=== ARM-XC ===\n");
  let st7:[]u8=z_alloc(4096);
  d_phase0_noteach(st7,1);
  let retX:i32=plan_build(st7,4,3);
  d_emit1(ob,atp,"XC plan_build (no extract)=",retX);
  let k10:i32=1;
  if(retX!=-1){k10=0;}
  if((st7[2] as i32)!=0){k10=0;}

  // ============ K12 architecture ============
  let k12:i32=1;
  if((st1[272+0] as i32)!=20){k12=0;}
  if((st1[272+4] as i32)!=1){k12=0;}
  if((st1[304+4] as i32)!=1){k12=0;}
  if((st1[1] as i32)!=2){k12=0;}
  if((st2[1] as i32)!=2){k12=0;}
  if((st3[1] as i32)!=2){k12=0;}
  if((st4[1] as i32)!=2){k12=0;}
  if((st5[1] as i32)!=2){k12=0;}
  if((st6[1] as i32)!=2){k12=0;}
  if((st7[1] as i32)!=2){k12=0;}

  // ============ KILL BARS ============
  d_emit(ob,atp,"=== KILL BARS ===\n");
  d_bar("K-1 X-LEARNED",k1,ob,atp);
  d_bar("K-2 NO-PLAN-PRE",k2,ob,atp);
  d_bar("K-3 CONSTRUCT",k3,ob,atp);
  d_bar("K-4 INTERMEDIATE-CREATED",k4,ob,atp);
  d_bar("K-5 ABLATE",k5,ob,atp);
  d_bar("K-6 NOCPLAN",k6,ob,atp);
  d_bar("K-7 FRESH",k7,ob,atp);
  d_bar("K-8 REUSE",k8,ob,atp);
  d_bar("K-9 REVISE",k9,ob,atp);
  d_bar("K-10 X-CONTROL",k10,ob,atp);
  d_bar("K-12 ARCHITECTURE",k12,ob,atp);
  d_emit(ob,atp,"K-11 K-13 see-shell\n");
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_app(ob,at," k7=");
  at=ob_i32(ob,at,k7);
  at=ob_app(ob,at," k8=");
  at=ob_i32(ob,at,k8);
  at=ob_app(ob,at," k9=");
  at=ob_i32(ob,at,k9);
  at=ob_app(ob,at," k10=");
  at=ob_i32(ob,at,k10);
  at=ob_app(ob,at," k12=");
  at=ob_i32(ob,at,k12);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"GPI-1-END\n");
  set32(atp,0,at);

  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

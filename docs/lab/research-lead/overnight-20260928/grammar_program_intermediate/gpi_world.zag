// gpi_world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Delimiter truth, Dmax, w_check, w_setdmax. The learner never
// calls w_setdmax; it only observes w_check outcomes through
// probes and program verification. World state: w[0] = dmax.
// Delimiters are fixed at (40, 41) for the whole experiment;
// only the max-depth bound changes (3 -> 4, driver act).

fn w_dmax_set(w:[]u8, v:i32)void {
  w[0]=v as u8;
  return;
}

fn w_dmax_get(w:[]u8)i32 {
  return w[0] as i32;
}

// w_check: 1 iff every byte is 40/41, the string is balanced,
// and max nesting depth <= dmax. 0 otherwise.
fn w_check(w:[]u8, buf:[]u8, len:i32)i32 {
  let dmax:i32=w[0] as i32;
  let depth:i32=0;
  let maxd:i32=0;
  let i:i32=0;
  while(i<len){
    let c:i32=buf[i] as i32;
    if(c==40){
      depth=depth+1;
      if(depth>maxd){maxd=depth;}
    }
    else {
      if(c==41){
        depth=depth-1;
        if(depth<0){return 0;}
      }
      else {return 0;}
    }
    i=i+1;
  }
  if(depth!=0){return 0;}
  if(maxd>dmax){return 0;}
  return 1;
}

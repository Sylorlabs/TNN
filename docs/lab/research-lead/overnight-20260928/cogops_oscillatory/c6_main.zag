// c6_main.zag -- driver for the cogops-oscillatory battery.
// Stages S1A, S1B (world A learning), S2 (oscillatory learning on
// world D), S3 (oscillatory self-loop goal D0, generalized,
// predicted INFORMATIVE-FAIL: cap fires at 16 passes), S4
// (oscillatory 2-node goal D1, generalized, predicted cap fire),
// S5 (stability probe on world D: period-2, not a fixpoint),
// S6 (cycle learning on world C), S7 (convergent self-loop goal
// 816, generalized, predicted quiescence at 9 passes), S8
// (fixpoint probe on world C: stable=1).
// Independent all-generic oracles: oracle_osc818 / oracle_osc819
// (16-guarded bounded walks; agreement is preregistered as
// vacuous cap-parity correspondence, not semantic correctness)
// and oracle_cyc816 (carried over). do_query selects the
// generalized composer and accumulates efficiency stats over
// agree=1 queries only.
// All dynamic output goes through the single preallocated buffer B,
// flushed once at the end. No world literals in this file: probe
// rel/obj values are read from the goal record.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}

// b_replay.zag -- B-REPLAY: rote memorization baseline for REVISE step 5.
// Observes the passive schedule, finds the first Y=1 event, records the
// control actions in the preceding window, replays them verbatim.
// Concatenate AFTER a sealed world file (world defines w_ interface + main).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn L_run()i32 {
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  // locate Y by name
  let yv:i32=-1;
  let v:i32=0;
  while(v<nvars){
    let nm:[]u8=w_vname(v);
    if((nm[0] as i32)==89){ yv=v; }
    v=v+1;
  }
  if(yv<0){ emit("B-REPLAY GOAL_REAL 0\n"); return 0; }
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }

  let ws:[]u8=z_alloc(8+nvars*32);
  w_reset(ws);
  // rec[t*nvars+v], t=0..12
  let rec:[]u8=z_alloc(13*nvars);
  let t:i32=0;
  while(t<=12){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    v=0;
    while(v<nvars){ rec[t*nvars+v]=snap[v]; v=v+1; }
    if(t<12){ w_act(ws,2,0); }
    t=t+1;
  }
  // first t* with Y=1
  let ts:i32=-1;
  t=0;
  while(t<=12){
    if((rec[t*nvars+yv] as i32)==1){ ts=t; t=99; }
    t=t+1;
  }
  if(ts<0){ emit("B-REPLAY GOAL_REAL 0\n"); return 0; }
  // record SET actions in window [ts-4, ts]
  let at:[]u8=z_alloc(16);
  let av:[]u8=z_alloc(16);
  let na:i32=0;
  let dt:i32=1;
  while(dt<=4){
    if(ts-dt>=0){
      i=0;
      while(i<nctrl){
        let c:i32=ctrl[i] as i32;
        if((rec[(ts-dt)*nvars+c] as i32)==1){
          at[na]=(ts-dt) as u8; av[na]=c as u8; na=na+1;
        }
        i=i+1;
      }
    }
    dt=dt+1;
  }
  // replay
  w_reset(ws);
  w_goal_setup(ws);
  t=0;
  while(t<=ts){
    i=0;
    while(i<na){
      if((at[i] as i32)==t){ w_act(ws,0,av[i] as i32); }
      i=i+1;
    }
    if(t<ts){ w_act(ws,2,0); }
    t=t+1;
  }
  let fin:[]u8=z_alloc(nvars);
  w_snapshot(ws,fin);
  let g:i32=w_goal_met(fin);
  emit("B-REPLAY GOAL_REAL "); e64(g); emit("\n");
  return g;
}

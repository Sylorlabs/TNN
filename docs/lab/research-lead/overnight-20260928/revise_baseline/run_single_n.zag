// b_singleton.zag -- B-SINGLETON: best single-literal baseline for REVISE step 5.
// Scores every candidate literal (control var, delay 1..4, both polarities)
// by F1 against passive observations, picks the best, plans once, executes
// once. No conjunction formation, no trials, no goal-failure revision.
// Concatenate AFTER a sealed world file (world defines w_ interface + main).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn L_run()i32 {
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let yv:i32=-1;
  let v:i32=0;
  while(v<nvars){
    let nm:[]u8=w_vname(v);
    if((nm[0] as i32)==89){ yv=v; }
    v=v+1;
  }
  if(yv<0){ emit("B-SINGLETON GOAL_REAL 0\n"); return 0; }
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }

  let ws:[]u8=z_alloc(8+nvars*32);
  w_reset(ws);
  let rec:[]u8=z_alloc(13*nvars);
  let t:i32=0;
  while(t<=12){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    v=0;
    while(v<nvars){ rec[t*nvars+v]=snap[v]; v=v+1; }
    if(t<12){ w_act(ws,2,0); }
    t=t+1;
  }
  let yc:i32=0;
  t=0;
  while(t<=12){ if((rec[t*nvars+yv] as i32)==1){ yc=yc+1; } t=t+1; }

  // best literal search; F1 = 2*hits/(hold+yc), scaled by 1000
  let best_f1:i32=-1;
  let best_p:i32=-1;
  let best_ci:i32=0; let best_k:i32=1; let best_pol:i32=0;
  let ci:i32=0;
  while(ci<nctrl){
    let cv:i32=ctrl[ci] as i32;
    let k:i32=1;
    while(k<=4){
      let pol:i32=0;
      while(pol<=1){
        let hits:i32=0; let hold:i32=0;
        t=0;
        while(t<=12){
          let holds:i32=0;
          if(t-k>=0){
            let vv:i32=rec[(t-k)*nvars+cv] as i32;
            if(pol==0){ if(vv==1){ holds=1; } }
            else { if(vv==0){ holds=1; } }
          }
          if(holds==1){
            hold=hold+1;
            if((rec[t*nvars+yv] as i32)==1){ hits=hits+1; }
          }
          t=t+1;
        }
        let f1:i32=0; let prec:i32=0;
        if(hold>0 && yc>0 && hits>0){
          f1=(2000*hits)/(hold+yc);
          prec=(1000*hits)/hold;
        }
        let better:i32=0;
        if(f1>best_f1){ better=1; }
        else if(f1==best_f1){
          if(prec>best_p){ better=1; }
          else if(prec==best_p){
            if(k<best_k){ better=1; }
            else if(k==best_k){
              if(ci<best_ci){ better=1; }
              else if(ci==best_ci){ if(pol<best_pol){ better=1; } }
            }
          }
        }
        if(better==1){
          best_f1=f1; best_p=prec; best_ci=ci; best_k=k; best_pol=pol;
        }
        pol=pol+1;
      }
      k=k+1;
    }
    ci=ci+1;
  }

  // plan and execute once
  w_reset(ws);
  w_goal_setup(ws);
  let bv:i32=ctrl[best_ci] as i32;
  if(best_pol==0){
    w_act(ws,0,bv);
  }
  t=0;
  while(t<best_k){ w_act(ws,2,0); t=t+1; }
  let fin:[]u8=z_alloc(nvars);
  w_snapshot(ws,fin);
  let g:i32=w_goal_met(fin);
  emit("B-SINGLETON GOAL_REAL "); e64(g);
  emit(" lit=");
  if(best_pol==1){ emit("!"); }
  emit(w_vname(bv)); emit("@"); e64(best_k); emit("\n");
  return g;
}
// world_sneg2.zag -- Sealed evaluation world S-NEG2: negation via OP-GROW.
// Concatenate AFTER the FROZEN f3_revise.zag (7009d711c, unmodified).
// SEALED TRUTH (designed in PREREG_REVISE_SEALED.md, 8cdf0992a,
// before any sealed world file existed; the builder never saw it):
//   Y(t) = X(t-2) AND NOT Z(t-2).
// Vars: X(0,ctrl), Z(1,ctrl), Y(2). Pulsed (SET writes current
// step only; no persistence).
// Passive: env SETs X ALONE at t=3,9 (Z never pulsed in passive).
// Then Y=1 at t=5,11.
// Goal context: w_goal_setup sets Z=1 (inhibitor present), X=0, Y=0.
// The learner must discover the (Z,-,2) guard via OP-GROW on the
// goal failure, wait out the inhibitor, and replan.
// Goal mode 0: final-state Y=1.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ7-delta-causal"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes)
fn w_reset(ws:[]u8)void {
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<8+3*32){ ws[i]=0; i=i+1; }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Sealed truth: Y(t) = X(t-2) AND NOT Z(t-2).
    // Out-of-range reads are 0.
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-2>=0){ zv=ws[8+1*32+(t-2)] as i32; }
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule: env SETs X ALONE at t=3,9. Z never pulsed.
// Uses world's clock.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==3){ ws[8+0*32+t]=1; }
  if(t==9){ ws[8+0*32+t]=1; }
  return;
}
// Goal setup: inhibitor Z=1 present, X=0, Y=0. The learner must
// grow the !Z@2 guard and replan around the inhibitor.
fn w_goal_setup(ws:[]u8)void {
  ws[8+1*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

// Harness note: sealed evaluator's world. w_verify unused.
fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("SEALED DONE mask="); e64(m); emit("\n");
  return 0;
}

// b_singleton.zag -- B-SINGLETON: best single-literal baseline for REVISE step 5.
// Scores every candidate literal (control var, delay 1..4, both polarities)
// by F1 against passive observations, picks the best, plans once, executes
// once. No conjunction formation, no trials, no goal-failure revision.
// Concatenate AFTER a sealed world file (world defines w_ interface + main).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn L_run()i32 {
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let yv:i32=-1;
  let v:i32=0;
  while(v<nvars){
    let nm:[]u8=w_vname(v);
    if((nm[0] as i32)==89){ yv=v; }
    v=v+1;
  }
  if(yv<0){ emit("B-SINGLETON GOAL_REAL 0\n"); return 0; }
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }

  let ws:[]u8=z_alloc(8+nvars*32);
  w_reset(ws);
  let rec:[]u8=z_alloc(13*nvars);
  let t:i32=0;
  while(t<=12){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    v=0;
    while(v<nvars){ rec[t*nvars+v]=snap[v]; v=v+1; }
    if(t<12){ w_act(ws,2,0); }
    t=t+1;
  }
  let yc:i32=0;
  t=0;
  while(t<=12){ if((rec[t*nvars+yv] as i32)==1){ yc=yc+1; } t=t+1; }

  // best literal search; F1 = 2*hits/(hold+yc), scaled by 1000
  let best_f1:i32=-1;
  let best_p:i32=-1;
  let best_ci:i32=0; let best_k:i32=1; let best_pol:i32=0;
  let ci:i32=0;
  while(ci<nctrl){
    let cv:i32=ctrl[ci] as i32;
    let k:i32=1;
    while(k<=4){
      let pol:i32=0;
      while(pol<=1){
        let hits:i32=0; let hold:i32=0;
        t=0;
        while(t<=12){
          let holds:i32=0;
          if(t-k>=0){
            let vv:i32=rec[(t-k)*nvars+cv] as i32;
            if(pol==0){ if(vv==1){ holds=1; } }
            else { if(vv==0){ holds=1; } }
          }
          if(holds==1){
            hold=hold+1;
            if((rec[t*nvars+yv] as i32)==1){ hits=hits+1; }
          }
          t=t+1;
        }
        let f1:i32=0; let prec:i32=0;
        if(hold>0 && yc>0 && hits>0){
          f1=(2000*hits)/(hold+yc);
          prec=(1000*hits)/hold;
        }
        let better:i32=0;
        if(f1>best_f1){ better=1; }
        else if(f1==best_f1){
          if(prec>best_p){ better=1; }
          else if(prec==best_p){
            if(k<best_k){ better=1; }
            else if(k==best_k){
              if(ci<best_ci){ better=1; }
              else if(ci==best_ci){ if(pol<best_pol){ better=1; } }
            }
          }
        }
        if(better==1){
          best_f1=f1; best_p=prec; best_ci=ci; best_k=k; best_pol=pol;
        }
        pol=pol+1;
      }
      k=k+1;
    }
    ci=ci+1;
  }

  // plan and execute once
  w_reset(ws);
  w_goal_setup(ws);
  let bv:i32=ctrl[best_ci] as i32;
  if(best_pol==0){
    w_act(ws,0,bv);
  }
  t=0;
  while(t<best_k){ w_act(ws,2,0); t=t+1; }
  let fin:[]u8=z_alloc(nvars);
  w_snapshot(ws,fin);
  let g:i32=w_goal_met(fin);
  emit("B-SINGLETON GOAL_REAL "); e64(g);
  emit(" lit=");
  if(best_pol==1){ emit("!"); }
  emit(w_vname(bv)); emit("@"); e64(best_k); emit("\n");
  return g;
}

// C611-G3 CAPABILITY-ABLATION GATE.
// Preregistered in l3gate/PREREG.md section 1 G3, frozen in commit 090b6fc16.
// Per l3macro C603 section 4 finding (a): load-bearingness and
// source-underdetermination are INDEPENDENT axes, and every prior L3 claim argues
// enumerability with NO capability ablation attached. This gate reads each claim's
// own bytes with _zag_read_file and looks for
//   (1) a capability-REMOVAL marker, and
//   (2) a held-out score KEYED to that arm (an arm name adjacent to a score).
// Pure Zag. argv1..argvN = files to scan. No learner is invoked.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn match_at(s:[]u8,n:i32,at:i32,p:[]u8)i32 {
  let m:i32=p.len;
  if(at<0){ return 0; }
  if(at+m>n){ return 0; }
  let i:i32=0; let ok:i32=1;
  while(i<m){ if((s[at+i] as i32)!=(p[i] as i32)){ ok=0; } i=i+1; }
  return ok;
}
fn countsub(s:[]u8,n:i32,p:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<=n){
    if(match_at(s,n,i,p)==1){ c=c+1; i=i+p.len; } else { i=i+1; }
  }
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  _zag_println("C611-G3 CAPABILITY-ABLATION GATE");
  _zag_println("AB-PRESENT = removal marker AND a held-out score keyed to that arm");
  _zag_println("AB-PARTIAL = removal marker, no keyed held-out score");
  _zag_println("AB-ABSENT  = neither.  AB-ABSENT/PARTIAL caps the claim at L2.");
  let na:i32=_zag_argc();
  if(na<2){ _zag_println("USAGE: g3_ab FILE..."); return 1; }
  let a:i32=1;
  while(a<na){
    let p:[]u8=_zag_arg(a);
    let s:[]u8=_zag_read_file(p);
    let n:i32=s.len;
    c=o_app(B,c,"FILE "); c=o_app(B,c,p);
    c=o_app(B,c," bytes="); c=o_i64(B,c,n as i64); c=o_nl(B,c);
    if(n<1){ a=a+1; }
    let mhit:i32=0;
    if(countsub(s,n,"NOSLOT")+countsub(s,n,"A-NOSLOT")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOLOOP")+countsub(s,n,"A-NOLOOP")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOWRAP")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOINV")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOMEM")+countsub(s,n,"C-MEM")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOSLOTS")>0){ mhit=mhit+1; }
    if(countsub(s,n,"ABL")+countsub(s,n,"ablation")+countsub(s,n,"Ablation")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOOP")+countsub(s,n,"C-NOOP")>0){ mhit=mhit+1; }
    if(countsub(s,n,"NOKB")+countsub(s,n,"kb wiped")>0){ mhit=mhit+1; }
    let khit:i32=0;
    if(countsub(s,n,"heldout")+countsub(s,n,"held-out")+countsub(s,n,"holdout")+countsub(s,n,"held out")>0){ khit=khit+1; }
    if(countsub(s,n,"heldout.txt")>0){ khit=khit+1; }
    if(countsub(s,n,"A-FULL")+countsub(s,n,"A-NOLOOP")+countsub(s,n,"A-NOSLOT")>0){ khit=khit+1; }
    if(countsub(s,n,"C-NOOP")+countsub(s,n,"C-SCRATCH")+countsub(s,n,"C-MEM")>0){ khit=khit+1; }
    if(countsub(s,n,"hold/")+countsub(s,n,"train/")>0){ khit=khit+1; }
    c=o_app(B,c,"  markers="); c=o_i64(B,c,mhit as i64);
    c=o_app(B,c," keyedscore="); c=o_i64(B,c,khit as i64);
    c=o_app(B,c," -> ");
    if(mhit==0){ c=o_app(B,c,"AB-ABSENT"); }
    else { if(khit==0){ c=o_app(B,c,"AB-PARTIAL"); } else { c=o_app(B,c,"AB-PRESENT"); } }
    c=o_nl(B,c);
    a=a+1;
  }
  c=o_app(B,c,"G3_END\n");
  _zag_print(B[0..c]);
  return 0;
}

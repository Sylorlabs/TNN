// C611-G2 DO-NOTHING-MACRO ATTACK.
// Preregistered in l3gate/PREREG.md section 1 G2, frozen in commit 090b6fc16.
// World semantics and criterion are transcribed from the CLAIM'S OWN published
// declaration (l3macro_unknowndepth/mf_floor.zag source header + PREREG + REPORT),
// never from a private implementation. No learner is invoked.
//   F = B x {R0..R3} x {LT,EQ,GT,LE,GE} x {thr}, |B| = 97, 11640 candidates.
//   internal criterion (as preregistered, UNAMENDED): for each of the 4 fixture
//   episodes, the macro's exit fires AND the terminal R0 equals the terminal R0
//   of the learner's own quiescence run on the same body.
//   G5 positive control: same criterion PLUS iters>=2 PLUS R0 actually changed.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn LIM()i32 { return 64; }
fn w_step(x:i32)i32 { let v:i32=x+1; if(v>LIM()){ return LIM(); } return v; }
fn exec_instr(r:[]u8,op:i32,d:i32,s:i32)void {
  let rs:i32=get32(r,s*4);
  let dv:i32=get32(r,d*4);
  let nv:i32=dv;
  if(op==0){ nv=rs; }
  else { if(op==1){ nv=dv+rs; } else { if(op==2){ nv=dv*rs; }
         else { if(op==3){ nv=1; } else { if(op==4){ nv=dv+1; } else { nv=w_step(dv); } } } } }
  set32(r,d*4,nv);
  return;
}
fn cmpi(op:i32,v:i32,t:i32)i32 {
  if(op==0){ if(v<t){ return 1; } return 0; }
  if(op==1){ if(v==t){ return 1; } return 0; }
  if(op==2){ if(v>t){ return 1; } return 0; }
  if(op==3){ if(v<=t){ return 1; } return 0; }
  if(op==4){ if(v>=t){ return 1; } return 0; }
  return 0;
}
fn ep_x0(i:i32)i32 {
  if(i==0){ return 61; } if(i==1){ return 59; } if(i==2){ return 56; } if(i==3){ return 51; }
  if(i==4){ return 47; } if(i==5){ return 35; } if(i==6){ return 20; }
  return 3;
}
fn thr_at(i:i32)i32 {
  if(i==0){ return 0; } if(i==1){ return 13; } if(i==2){ return 61; }
  if(i==3){ return 63; } if(i==4){ return 64; }
  return 65;
}
// body id 0 = empty; id-1 = op*16 + d*4 + s
fn b_op(id:i32)i32 { if(id==0){ return -1; } return (id-1)/16; }
fn b_d(id:i32)i32  { if(id==0){ return -1; } return (((id-1)%16)/4); }
fn b_s(id:i32)i32  { if(id==0){ return -1; } return ((id-1)%4); }
// trivial class of a body id, per PREREG G2: 0=T0 1=T1 2=T2 3=T3 -1=non-trivial
fn trivial(id:i32)i32 {
  if(id==0){ return 0; }
  let o:i32=b_op(id); let d:i32=b_d(id); let s:i32=b_s(id);
  if(o==0){ if(d==s){ return 1; } return 2; }
  if(o==3){ return 3; }
  return -1;
}
fn quiesce(op:i32,d:i32,s:i32,x0:i32)i32 {
  let r:[]u8=z_alloc(16);
  let pv:[]u8=z_alloc(16);
  set32(r,0,x0); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  set32(pv,0,x0); set32(pv,4,0); set32(pv,8,0); set32(pv,12,0);
  let k:i32=0;
  while(k<300){
    let i:i32=0;
    while(i<1){
      if(op>=0){ exec_instr(r,op,d,s); }
      i=i+1;
    }
    k=k+1;
    let ch:i32=0;
    // FIX (ADDENDUM-1 A2): the flag ACCUMULATES over all four registers.
    // The pre-fix transcription let the last slot (R3) overwrite the result, so
    // quiescence was reported one pass early whenever R3 was unchanged.
    let q:i32=0;
    while(q<4){
      if(get32(r,q*4)!=get32(pv,q*4)){ ch=1; }
      set32(pv,q*4,get32(r,q*4));
      q=q+1;
    }
    if(ch==0){ return get32(r,0); }
  }
  return get32(r,0);
}

fn runm(op:i32,d:i32,s:i32,src:i32,cmp:i32,thr:i32,x0:i32,noloop:i32,out:[]u8)void {
  let r:[]u8=z_alloc(16);
  set32(r,0,x0); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  let k:i32=0;
  let fired:i32=0;
  while(k<300){
    if(op>=0){ exec_instr(r,op,d,s); }
    k=k+1;
    if(noloop==1){ fired=1; break; }
    if(cmpi(cmp,get32(r,src*4),thr)==1){ fired=1; break; }
  }
  set32(out,0,get32(r,0));
  set32(out,16,k);
  set32(out,20,fired);
  return;
}
fn ep_ok(bidx:i32,sidx:i32,cidx:i32,th:i32,e:i32)i32 {
  let q:[]u8=z_alloc(32);
  let op:i32=b_op(bidx); let d:i32=b_d(bidx); let s:i32=b_s(bidx);
  let w:i32=quiesce(op,d,s,ep_x0(e));
  runm(op,d,s,sidx,cidx,th,ep_x0(e),0,q);
  let r:i32=0;
  if(get32(q,20)==1){ r=1; }
  if(get32(q,0)!=w){ r=0; }
  return r;
}
fn ep_k(bidx:i32,sidx:i32,cidx:i32,th:i32,e:i32)i32 {
  let q:[]u8=z_alloc(32);
  runm(b_op(bidx),b_d(bidx),b_s(bidx),sidx,cidx,th,ep_x0(e),0,q);
  return get32(q,16);
}
fn ep_ch(bidx:i32,sidx:i32,cidx:i32,th:i32,e:i32)i32 {
  let q:[]u8=z_alloc(32);
  runm(b_op(bidx),b_d(bidx),b_s(bidx),sidx,cidx,th,ep_x0(e),0,q);
  if(get32(q,0)!=ep_x0(e)){ return 1; }
  return 0;
}

fn main()i32 {
  let B:[]u8=z_alloc(32768);
  let c:i32=0;
  _zag_println("C611-G2 DO-NOTHING-MACRO ATTACK -- world C603 (MACRO)");
  _zag_println("criterion transcribed from the claim's own REPORT/prereg; no learner invoked");
  let q:[]u8=z_alloc(32);
  // ---------- UNAMENDED criterion (as preregistered by the claim)
  let nsat:i32=0; let ntriv:i32=0;
  let t0sat:i32=0; let t1sat:i32=0; let t2sat:i32=0; let t3sat:i32=0;
  let nsatAm:i32=0; let ntrivAm:i32=0;
  let idx:i32=0;
  while(idx<11640){
    let bidx:i32=idx/120;
    let r1:i32=idx-(bidx*120);
    let sidx:i32=r1/30;
    let r2:i32=r1-(sidx*30);
    let cidx:i32=r2/6;
    let tidx:i32=r2-(cidx*6);
    let th:i32=thr_at(tidx);
    let ok:i32=1; let it3:i32=0; let ch3:i32=0;

    let i:i32=0;
    while(i<4){
      let eok:i32=ep_ok(bidx,sidx,cidx,th,i);
      if(eok==0){ ok=0; }
      if(i==3){ it3=ep_k(bidx,sidx,cidx,th,i); ch3=ep_ch(bidx,sidx,cidx,th,i); }
      

      i=i+1;
    }
    if(ok==1){
      nsat=nsat+1;
      let tv:i32=trivial(bidx);
      if(tv>=0){ ntriv=ntriv+1; }
      if(tv==0){ t0sat=t0sat+1; }
      if(tv==1){ t1sat=t1sat+1; }
      if(tv==2){ t2sat=t2sat+1; }
      if(tv==3){ t3sat=t3sat+1; }
      if(it3>1){
        nsatAm=nsatAm+1;
        if(tv>=0){ ntrivAm=ntrivAm+1; }
      }
      if(it3>1 && ch3==1){
        if(ntrivAm==ntrivAm){ }
      }
    }
    idx=idx+1;
  }
  c=o_app(B,c,"SPACE 97 x 4 x 5 x 6 = 11640\n");
  c=o_app(B,c,"NSAT_UNAMENDED "); c=o_i64(B,c,nsat as i64);
  c=o_app(B,c," NTRIV "); c=o_i64(B,c,ntriv as i64); c=o_nl(B,c);
  c=o_app(B,c,"T0_DO_NOTHING_SAT "); c=o_i64(B,c,t0sat as i64);
  c=o_app(B,c," T1_IDENTITY_SAT "); c=o_i64(B,c,t1sat as i64);
  c=o_app(B,c," T2_COPY_INPUT_SAT "); c=o_i64(B,c,t2sat as i64);
  c=o_app(B,c," T3_CONSTANT_SAT "); c=o_i64(B,c,t3sat as i64); c=o_nl(B,c);
  let tau:i32=0;
  if(nsat>0){ tau=(ntriv*10000)/nsat; }
  c=o_app(B,c,"TAU_UNAMENDED_PERMILLE "); c=o_i64(B,c,tau as i64); c=o_nl(B,c);
  if(t0sat>0){ c=o_app(B,c,"VERDICT VACUOUS-0 (T0 alone satisfies the criterion)\n"); }
  else { if(tau>=100){ c=o_app(B,c,"VERDICT VACUOUS (tau >= 0.01)\n"); } else { c=o_app(B,c,"VERDICT NON-VACUOUS\n"); } }

  // ---------- AMENDED criterion (claim's AMENDMENT-1: iters >= 2)
  c=o_app(B,c,"NSAT_AMENDED "); c=o_i64(B,c,nsatAm as i64);
  c=o_app(B,c," NTRIV "); c=o_i64(B,c,ntrivAm as i64); c=o_nl(B,c);
  let tauA:i32=0;
  if(nsatAm>0){ tauA=(ntrivAm*10000)/nsatAm; }
  c=o_app(B,c,"TAU_AMENDED_PERMILLE "); c=o_i64(B,c,tauA as i64); c=o_nl(B,c);
  c=o_app(B,c,"CLAIM_REPORTS 349 of 11640 satisfy the amended criterion\n");

  // ---------- G5 POSITIVE CONTROL: iters>=2 AND R0 actually changed
  let nsatC:i32=0; let ntrivC:i32=0; let t0c:i32=0; let t1c:i32=0;
  let dbgOk:i32=0; let dbgIt:i32=0; let dbgCh:i32=0;
  idx=0;
  while(idx<11640){
    let bidx:i32=idx/120;
    let r1:i32=idx-(bidx*120);
    let sidx:i32=r1/30;
    let r2:i32=r1-(sidx*30);
    let cidx:i32=r2/6;
    let tidx:i32=r2-(cidx*6);
    let th:i32=thr_at(tidx);
    let ok:i32=1; let it3:i32=0; let ch3:i32=0;
    let i:i32=0;
    while(i<4){
      if(ep_ok(bidx,sidx,cidx,th,i)==0){ ok=0; }
      if(i==3){ it3=ep_k(bidx,sidx,cidx,th,i); ch3=ep_ch(bidx,sidx,cidx,th,i); }
      

      i=i+1;
    }
    if(ok==1){ dbgOk=dbgOk+1; }
    if(ok==1 && it3>1){ dbgIt=dbgIt+1; }
    if(ok==1 && ch3==1){ dbgCh=dbgCh+1; }
    if(ok==1 && it3>1 && ch3==1){
      nsatC=nsatC+1;
      let tv:i32=trivial(bidx);
      if(tv>=0){ ntrivC=ntrivC+1; }
      if(tv==0){ t0c=t0c+1; }
      if(tv==1){ t1c=t1c+1; }
    }
    idx=idx+1;
  }
  c=o_app(B,c,"G5_DBG ok="); c=o_i64(B,c,dbgOk as i64); c=o_app(B,c," ok_it3="); c=o_i64(B,c,dbgIt as i64); c=o_app(B,c," ok_changed="); c=o_i64(B,c,dbgCh as i64); c=o_nl(B,c);
  c=o_app(B,c,"G5_CONTROL NSAT "); c=o_i64(B,c,nsatC as i64);
  c=o_app(B,c," NTRIV "); c=o_i64(B,c,ntrivC as i64);
  c=o_app(B,c," T0_SAT "); c=o_i64(B,c,t0c as i64);
  c=o_app(B,c," T1_SAT "); c=o_i64(B,c,t1c as i64); c=o_nl(B,c);
  let tauC:i32=0;
  if(nsatC>0){ tauC=(ntrivC*10000)/nsatC; }
  c=o_app(B,c,"G5_CONTROL_TAU_PERMILLE "); c=o_i64(B,c,tauC as i64); c=o_nl(B,c);
  if(t0c>0 || t1c>0){ c=o_app(B,c,"G5 VERDICT DEGENERATE (T0/T1 survive the control) -- G2 VOID\n"); }
  else {
    if(tauC>=100){ c=o_app(B,c,"G5 VERDICT VACUOUS -- G2 VOID\n"); }
    else { c=o_app(B,c,"G5 VERDICT NON-VACUOUS -- G2 IS NOT KILL-ONLY, RESULTS STAND\n"); }
  }
  _zag_print(B[0..c]);
  return 0;
}

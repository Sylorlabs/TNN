// C611 G1 DECIDE-FROM-LITERALS -- literal extractor + in-gate prover assertions.
// Pure Zag. Reads claim source with _zag_read_file. No scripting language touches a source.
// argv1 = claim source path
// argv2 = emitted prover path, or "-" to skip prover assertions
// argv3 = learner basename to assert absent from the prover, or "-"
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }

fn isdig(c:i32)i32 { if(c<48){ return 0; } if(c>57){ return 0; } return 1; }
fn isalp(c:i32)i32 {
  if(c==95){ return 1; }
  if(c<65){ return 0; }
  if(c>90){ return 1; }
  if(c<97){ return 0; }
  if(c>122){ return 0; }
  return 1;
}
fn issp(c:i32)i32 { if(c==32){ return 1; } if(c==9){ return 1; } if(c==13){ return 1; } return 0; }
fn match_at(s:[]u8,n:i32,at:i32,p:[]u8)i32 {
  let m:i32=p.len;
  if(at<0){ return 0; }
  if(at+m>n){ return 0; }
  let i:i32=0; let ok:i32=1;
  while(i<m){ if((s[at+i] as i32)!=(p[i] as i32)){ ok=0; } i=i+1; }
  return ok;
}
fn findsub(s:[]u8,n:i32,p:[]u8,from:i32)i32 {
  let i:i32=from;
  let g:i32=1;
  while(g==1){
    if(i>=n){ g=0; } else { if(match_at(s,n,i,p)==1){ g=0; } else { i=i+1; } }
  }
  if(i>=n){ return -1; }
  return i;
}
fn skipsp(s:[]u8,n:i32,j:i32)i32 {
  let k:i32=j; let g:i32=1;
  while(g==1){
    if(k>=n){ g=0; } else { if(issp(s[k] as i32)==1){ k=k+1; } else { g=0; } }
  }
  return k;
}

// count of distinct values already in table
fn in_tab(tab:[]u8,m:i32,v:i32)i32 {
  let i:i32=0; let f:i32=0;
  while(i<m){ if(get32(tab,i*4)==v){ f=1; } i=i+1; }
  return f;
}
// number of occurrences of substring p in s
fn countsub(s:[]u8,n:i32,p:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<=n){
    if(match_at(s,n,i,p)==1){ c=c+1; i=i+p.len; } else { i=i+1; }
  }
  return c;
}
// does every integer literal in `t` appear in the value table `vt` (size vm)?
fn all_lits_known(t:[]u8,tn:i32,vt:[]u8,vm:i32)i32 {
  let bad:i32=0;
  let i:i32=0;
  while(i<tn){
    let isd:i32=isdig(t[i] as i32);
    let prevok:i32=1;
    if(i>0){ if(isalp(t[i-1] as i32)==1){ prevok=0; } }
    if(isd==1 && prevok==1){
      let v:i32=0; let g:i32=1;
      while(g==1){ if(isdig(t[i] as i32)==1){ v=v*10+((t[i] as i32)-48); i=i+1; } else { g=0; } }
      if(in_tab(vt,vm,v)==0){ bad=bad+1; }
    } else { i=i+1; }
  }
  if(bad>0){ return 0; }
  return 1;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn put_name(b:[]u8,at:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[at+i]=s[i]; i=i+1; } return at+s.len; }
fn next_name(b:[]u8,at:i32,end:i32)i32 { let i:i32=at; while((i<end)&&(b[i]!=10)){ i=i+1; } return i+1; }

fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let na:i32=_zag_argc();
  if(na<2){ _zag_println("G1 USAGE: g1_scan <src> <prover|-> <learnerbase|->"); return 1; }
  let sp:[]u8=_zag_arg(1);
  let s:[]u8=_zag_read_file(sp);
  let n:i32=s.len;
  c=o_app(B,c,"G1_SCAN file="); c=o_app(B,c,sp); c=o_nl(B,c);
  c=o_app(B,c,"SRC_BYTES "); c=o_i64(B,c,n as i64); c=o_nl(B,c);
  if(n<1){ c=o_app(B,c,"EMPTY_SOURCE_FATAL"); c=o_nl(B,c); _zag_print(B[0..c]); return 2; }

  // ---- value table of every integer literal in the source (up to 4096 distinct)
  let VT:[]u8=z_alloc(4096*4);
  let vm:i32=0;
  // ---- literal counts
  let nlit:i32=0;
  let i:i32=0;
  while(i<n){
    let isd:i32=isdig(s[i] as i32);
    let ok:i32=1;
    if(i>0){ if(isalp(s[i-1] as i32)==1){ ok=0; } }
    if(isd==1 && ok==1){
      let v:i32=0; let g:i32=1;
      while(g==1){
        if(i>=n){ g=0; } else { if(isdig(s[i] as i32)==1){ v=v*10+((s[i] as i32)-48); i=i+1; } else { g=0; } }
      }
      nlit=nlit+1;
      if(vm<4096){ if(in_tab(VT,vm,v)==0){ set32(VT,vm*4,v); vm=vm+1; } }
    } else { i=i+1; }
  }
  let nstr:i32=countsub(s,n,"\"")/2;
  let nlines:i32=0;
  i=0;
  while(i<n){ if((s[i] as i32)==10){ nlines=nlines+1; } i=i+1; }

  // ---- NMENU / NBOUND: integer literal that is RHS of < or <= inside a while(...)
  let BT:[]u8=z_alloc(1024*4);
  let bn:i32=0;
  let nmenu:i32=0;
  let w:i32=0;
  while(w<n){
    if(match_at(s,n,w,"while")==1){
      let j:i32=skipsp(s,n,w+5);
      if(j<n){ if((s[j] as i32)==40){
        let k:i32=j+1; let depth:i32=1;
        while(depth>0){
          if(k>=n){ depth=0; } else {
            let ch:i32=s[k] as i32;
            if(ch==40){ depth=depth+1; }
            if(ch==41){ depth=depth-1; }
            if(ch==60){
              let p2:i32=k+1;
              if(p2<n){ if((s[p2] as i32)==61){ p2=p2+1; } }
              p2=skipsp(s,n,p2);
              if(p2<n){ if(isdig(s[p2] as i32)==1){
                let v:i32=0; let g:i32=1;
                while(g==1){
                  if(p2>=n){ g=0; } else { if(isdig(s[p2] as i32)==1){ v=v*10+((s[p2] as i32)-48); p2=p2+1; } else { g=0; } }
                }
                nmenu=nmenu+1;
                if(bn<1024){ if(in_tab(BT,bn,v)==0){ set32(BT,bn*4,v); bn=bn+1; } }
              } }
            }
            k=k+1;
          }
        }
      } }
    }
    w=w+1;
  }

  // ---- NKEY: longest run of consecutive lines each passing >=3 integer args to the SAME fn
  let NA:[]u8=z_alloc(64*24);   // names, 24 bytes each
  let MC:[]u8=z_alloc(64*4);    // max int-arg count at a call site of that fn
  let RL:[]u8=z_alloc(64*4);    // current run length
  let BR:[]u8=z_alloc(64*4);    // best run length
  let nn:i32=0;
  let bestkey:i32=0; let bestfn:i32=-1;
  let prevname:i32=-1;
  let ls:i32=0;
  while(ls<=n){
    let le:i32=ls; let g:i32=1;
    while(g==1){ if(le>=n){ g=0; } else { if((s[le] as i32)==10){ g=0; } else { le=le+1; } } }
    // find first identifier immediately followed by '(' in this line
    let nm:i32=-1; let nargs:i32=-1;
    let p:i32=ls;
    while(p<le){
      if(isalp(s[p] as i32)==1){
        let st:i32=p; let g2:i32=1;
        while(g2==1){ if(p>=le){ g2=0; } else { if(isalp(s[p] as i32)==1){ p=p+1; } else { g2=0; } } }
        let q:i32=skipsp(s,le,p);
        if(q<le){ if((s[q] as i32)==40){
          nm=st;
          // count integer literals in the balanced arg list
          let ac:i32=0; let d:i32=1; let r2:i32=q+1;
          while(d>0){
            if(r2>=le){ d=0; } else {
              let ch:i32=s[r2] as i32;
              if(ch==40){ d=d+1; }
              if(ch==41){ d=d-1; }
              if(ch==34){ r2=r2+1; let g3:i32=1; while(g3==1){ if(r2>=le){ g3=0; } else { if((s[r2] as i32)==34){ g3=0; } else { r2=r2+1; } } } }
              else { r2=r2+1; }
              if(d>0){ if(isdig(ch)==1){ ac=ac+1; } }
            }
          }
          nargs=ac;
        } }
        p=p+1;
      } else { p=p+1; }
    }
    // register
    if(nm>=0){
      if(nargs>=3){
        let slot:i32=-1;
        let t:i32=0;
        while(t<nn){ let same:i32=1; let u:i32=0; while(u<24){ if((NA[t*24+u] as i32)!=(s[nm+u] as i32)){ same=0; } u=u+1; } if(same==1){ slot=t; } t=t+1; }
        if(slot<0){
          if(nn<64){
            let u2:i32=0; while(u2<24){ let v:i32=0; if(nm+u2<le){ v=s[nm+u2] as i32; } NA[nn*24+u2]=v as u8; u2=u2+1; }
            slot=nn; nn=nn+1; set32(MC,slot*4,0); set32(RL,slot*4,0); set32(BR,slot*4,0);
          }
        }
        if(slot>=0){
          if(nargs>get32(MC,slot*4)){ set32(MC,slot*4,nargs); }
          if(slot==prevname){ set32(RL,slot*4,get32(RL,slot*4)+1); } else { set32(RL,slot*4,1); }
          if(get32(RL,slot*4)>get32(BR,slot*4)){ set32(BR,slot*4,get32(RL,slot*4)); }
          if(get32(BR,slot*4)>bestkey){ bestkey=get32(BR,slot*4); bestfn=slot; }
          prevname=slot;
        }
      } else { prevname=-1; }
    }
    ls=le+1;
  }
  let nprobe:i32=0;
  if(bestfn>=0){ nprobe=get32(MC,bestfn*4); }

  c=o_app(B,c,"SRC_LINES "); c=o_i64(B,c,nlines as i64); c=o_nl(B,c);
  c=o_app(B,c,"NLIT "); c=o_i64(B,c,nlit as i64); c=o_app(B,c," NDISTINCT_LIT "); c=o_i64(B,c,vm as i64); c=o_nl(B,c);
  c=o_app(B,c,"NSTR "); c=o_i64(B,c,nstr as i64); c=o_nl(B,c);
  c=o_app(B,c,"NMENU "); c=o_i64(B,c,nmenu as i64); c=o_app(B,c," NBOUND "); c=o_i64(B,c,bn as i64); c=o_nl(B,c);
  c=o_app(B,c,"NKEY "); c=o_i64(B,c,bestkey as i64); c=o_app(B,c," NPROBE "); c=o_i64(B,c,nprobe as i64); c=o_nl(B,c);
  c=o_app(B,c,"MENU_BOUNDS ");
  let q2:i32=0;
  while(q2<bn){ c=o_i64(B,c,get32(BT,q2*4) as i64); c=o_sp(B,c); q2=q2+1; }
  c=o_nl(B,c);

  // ---- in-gate assertions on the emitted prover
  if(na>=3){
    let pp:[]u8=_zag_arg(2);
    let lbp:[]u8=_zag_arg(3);
    if(match_at(pp,pp.len,0,"-")==1){
      c=o_app(B,c,"ASSERT-NOLEARNER SKIP (no prover)\n");
      c=o_app(B,c,"ASSERT-KEYONLY SKIP (no prover)\n");
    } else {
      let pv:[]u8=_zag_read_file(pp);
      let pn:i32=pv.len;
      c=o_app(B,c,"PROVER "); c=o_app(B,c,pp); c=o_app(B,c," PROVER_BYTES "); c=o_i64(B,c,pn as i64); c=o_nl(B,c);
      let hits:i32=0;
      if(match_at(lbp,lbp.len,0,"-")==0){ hits=findsub(pv,pn,lbp,0); }
      if(hits<0){ c=o_app(B,c,"ASSERT-NOLEARNER PASS (0 occurrences of "); c=o_app(B,c,lbp); c=o_app(B,c,")\n"); }
      else { c=o_app(B,c,"ASSERT-NOLEARNER FAIL (learner name present at byte "); c=o_i64(B,c,hits as i64); c=o_app(B,c,")\n"); }
      if(all_lits_known(pv,pn,VT,vm)==1){ c=o_app(B,c,"ASSERT-KEYONLY PASS (every prover integer literal occurs in the claim source)\n"); }
      else { c=o_app(B,c,"ASSERT-KEYONLY FAIL (prover introduces literals absent from the claim source)\n"); }
      // ---- DIAGNOSIS (ADDENDUM-1 A2/A4): which literals are foreign, and is the
      // shortfall just the mandatory output prelude? Machine-produced, not asserted.
      let nfor:i32=0;
      let firstfor:i32=-1;
      let fl:[]u8=z_alloc(4096*4);
      let nfl:i32=0;
      let w2:i32=0;
      while(w2<pn){
        let isd:i32=isdig(pv[w2] as i32);
        let ok2:i32=1;
        if(w2>0){ if(isalp(pv[w2-1] as i32)==1){ ok2=0; } }
        if(isd==1 && ok2==1){
          let v:i32=0; let g:i32=1;
          while(g==1){ if(w2>=pn){ g=0; } else { if(isdig(pv[w2] as i32)==1){ v=v*10+((pv[w2] as i32)-48); w2=w2+1; } else { g=0; } } }
          if(in_tab(VT,vm,v)==0){
            nfor=nfor+1;
            if(firstfor<0){ firstfor=v; }
            if(nfl<4096){ set32(fl,nfl*4,v); nfl=nfl+1; }
          }
        } else { w2=w2+1; }
      }
      c=o_app(B,c,"FOREIGN_LITERAL_COUNT "); c=o_i64(B,c,nfor as i64);
      c=o_app(B,c," DISTINCT "); c=o_i64(B,c,nfl as i64); c=o_nl(B,c);
      c=o_app(B,c,"FOREIGN_LITERALS ");
      let q3:i32=0;
      while(q3<nfl){ c=o_i64(B,c,get32(fl,q3*4) as i64); c=o_sp(B,c); q3=q3+1; }
      c=o_nl(B,c);
      // LOC split: PRELUDE_LOC counts lines belonging to the mandatory output
      // prelude (the six helpers every Zag program must carry per brief 4.2);
      // DECISION_LOC is everything else. Machine-produced.
      let loc2:i32=0; let z2:i32=0;
      while(z2<pn){
        if((pv[z2] as i32)==10){ loc2=loc2+1; }
        z2=z2+1;
      }
      let names:[]u8=z_alloc(256);
      let nn2:i32=0;
      names[nn2]=10; nn2=nn2+1; nn2=put_name(names,nn2,"fn z_alloc(");
      nn2=put_name(names,nn2,"fn o_i64("); names[nn2]=10; nn2=nn2+1;
      nn2=put_name(names,nn2,"fn o_app("); names[nn2]=10; nn2=nn2+1;
      nn2=put_name(names,nn2,"fn o_nl("); names[nn2]=10; nn2=nn2+1;
      nn2=put_name(names,nn2,"fn o_sp("); names[nn2]=10; nn2=nn2+1;
      nn2=put_name(names,nn2,"fn o_flush("); names[nn2]=10; nn2=nn2+1;
      let ls2:i32=0;
      let pre:i32=0; let done2:i32=0;
      while((ls2<=pn)&&(done2==0)){
        let le2:i32=ls2; let g3:i32=1;
        while(g3==1){ if(le2>=pn){ g3=0; } else { if((pv[le2] as i32)==10){ g3=0; } else { le2=le2+1; } } }
        let t:i32=0;
        while(t<nn2){
          let hit:i32=0;
          let q4:i32=ls2;
          while((q4<le2)&&(hit==0)){
            let m2:i32=0;
            let good:i32=1;
            while(m2<nn2-t-1){
              if((q4+m2)>=pn){ good=0; }
              else { if((pv[q4+m2] as i32)!=(names[t+m2] as i32)){ good=0; } }
              m2=m2+1;
            }
            if(good==1){ hit=1; }
            q4=q4+1;
          }
          if(hit==1){ pre=pre+1; t=nn2; }
          else { t=t+next_name(names,t,nn2); }
        }
        ls2=le2+1;
      }
      c=o_app(B,c,"PRELUDE_LOC "); c=o_i64(B,c,pre as i64);
      c=o_app(B,c," DECISION_LOC "); c=o_i64(B,c,(loc2-pre) as i64); c=o_nl(B,c);
      c=o_app(B,c,"PROVER_LOC "); c=o_i64(B,c,loc2 as i64); c=o_nl(B,c);
      c=o_app(B,c,"RAW_SYSCALL_IN_PROVER "); c=o_i64(B,c,countsub(pv,pn,"_zag_raw_syscall") as i64); c=o_nl(B,c);
      c=o_app(B,c,"G1_END\n");
    }
  } else {
    c=o_app(B,c,"G1_END\n");
  }
  _zag_print(B[0..c]);
  return 0;
}

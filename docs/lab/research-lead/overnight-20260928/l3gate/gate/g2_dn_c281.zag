// C611-G2b DO-NOTHING-MACRO ATTACK, second battery: C281/CALR and C453 L3-RX.
//
// Criterion, candidate space and world semantics are transcribed from each
// claim's OWN published declaration (src/c281_gl2m_h1.zag g1_labels/m_score/
// label_check and glm_learner.zag m_construct; c453_PREREG.md sections 1 and 10;
// c453_REPORT.md controls). No learner is invoked. Pure Zag.
//
// argv1 = claim tag: "c281" | "c453"
// argv2 = fixture path (c453 only; ignored for c281)
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }

// ================= C281 / CALR =================
// The 22-entry label table, transcribed verbatim from the claim's own
// src/c281_gl2m_h1.zag fn g1_labels() (base 2176, 22 entries x 12 bytes D,v,lab).
// D, v, lab
fn lab_D(i:i32)i32 {
  if(i<11){ return 16; }
  return 8;
}
fn lab_V(i:i32)i32 {
  if(i==0){ return 17; } if(i==1){ return 18; } if(i==2){ return 23; }
  if(i==3){ return 33; } if(i==4){ return 39; } if(i==5){ return 16; }
  if(i==6){ return 24; } if(i==7){ return 15; } if(i==8){ return 40; }
  if(i==9){ return 1; }  if(i==10){ return 0; }
  if(i==11){ return 9; } if(i==12){ return 10; } if(i==13){ return 15; }
  if(i==14){ return 17; } if(i==15){ return 23; } if(i==16){ return 8; }
  if(i==17){ return 16; } if(i==18){ return 7; } if(i==19){ return 24; }
  if(i==20){ return 1; }  if(i==21){ return 0; }
  return -1;
}
fn lab_L(i:i32)i32 {
  if(i<11){ if(i<5){ return 1; } return 0; }
  if(i<16){ return 1; }
  return 0;
}
// m_label_lookup(D,w): the label attached to (D,w), or -1 if (D,w) is unlabelled.
fn lab_lookup(D:i32,w:i32)i32 {
  let i:i32=0;
  while(i<22){
    if(lab_D(i)==D){
      if(lab_V(i)==w){ return lab_L(i); }
    }
    i=i+1;
  }
  return -1;
}
// frozen generic op basis, from glm_learner.zag: 0=CPY 1=ADD 2=MUL 3=SET1 4=INC
fn m_exec1(r:[]u8,op:i32,d:i32,s:i32)void {
  let dv:i32=get32(r,d*4);
  let rs:i32=get32(r,s*4);
  let nv:i32=dv;
  if(op==0){ nv=rs; }
  else { if(op==1){ nv=dv+rs; } else { if(op==2){ nv=dv*rs; }
         else { if(op==3){ nv=1; } else { nv=dv+1; } } } }
  set32(r,d*4,nv);
  return;
}
fn m_exec(op:i32,d:i32,s:i32,D:i32)i32 {
  let r:[]u8=z_alloc(16);
  set32(r,0,D); set32(r,4,0); set32(r,8,0); set32(r,12,0);
  if(op>=0){ m_exec1(r,op,d,s); }
  return get32(r,0);
}
// m_score, verbatim in structure from glm_learner.zag: TWO binary probes.
// The criterion's maximum is 2. There is no third probe.
fn m_score(op:i32,d:i32,s:i32)i32 {
  let sc:i32=0;
  if(lab_lookup(16,m_exec(op,d,s,16))==1){ sc=sc+1; }
  if(lab_lookup(8,m_exec(op,d,s,8))==1){ sc=sc+1; }
  return sc;
}
// trivial class of menu id, per PREREG G2 table T0..T3
fn triv281(id:i32)i32 {
  if(id==0){ return 0; }
  let v:i32=id-1;
  let op:i32=v/16; let d:i32=(v%16)/4; let s:i32=v%4;
  if(op==0){ if(d==s){ return 1; } return 2; }
  if(op==3){ return 3; }
  return -1;
}
fn run_c281(B:[]u8,c:i32)i32 {
  c=o_app(B,c,"CLAIM C281/CALR (xdomain_grammar_l2m H1)\n");
  c=o_app(B,c,"criterion: m_score==2, i.e. prog(16) is labelled 1 AND prog(8) is labelled 1\n");
  c=o_app(B,c,"label table: 22 entries transcribed from g1_labels() base 2176 (D,v,lab)\n");
  c=o_app(B,c,"alphabet: 5 ops x 4 dst x 4 src = 80, plus empty = 81 candidates\n");
  let id:i32=0;
  let nsat:i32=0; let ntriv:i32=0;
  let t0:i32=0; let t1:i32=0; let t2:i32=0; let t3:i32=0;
  let best:i32=-1; let nsatbest:i32=0;
  while(id<81){
    let sc:i32=0;
    if(id==0){ sc=m_score(-1,-1,-1); }
    else {
      let v:i32=id-1;
      sc=m_score(v/16,(v%16)/4,v%4);
    }
    let tv:i32=triv281(id);
    if(sc==2){
      nsat=nsat+1;
      if(tv>=0){ ntriv=ntriv+1; }
      if(tv==0){ t0=t0+1; }
      if(tv==1){ t1=t1+1; }
      if(tv==2){ t2=t2+1; }
      if(tv==3){ t3=t3+1; }
      c=o_app(B,c,"  SAT id="); c=o_i64(B,c,id as i64);
      c=o_app(B,c," score="); c=o_i64(B,c,sc as i64);
      c=o_app(B,c," triv="); c=o_i64(B,c,tv as i64); c=o_nl(B,c);
    }
    if(sc>best){ best=sc; nsatbest=nsat; }
    id=id+1;
  }
  c=o_app(B,c,"MAX_SCORE_REACHED "); c=o_i64(B,c,best as i64);
  c=o_app(B,c," of 2\n");
  c=o_app(B,c,"NSAT "); c=o_i64(B,c,nsat as i64);
  c=o_app(B,c," NTRIV "); c=o_i64(B,c,ntriv as i64); c=o_nl(B,c);
  c=o_app(B,c,"T0_SAT "); c=o_i64(B,c,t0 as i64);
  c=o_app(B,c," T1_SAT "); c=o_i64(B,c,t1 as i64);
  c=o_app(B,c," T2_SAT "); c=o_i64(B,c,t2 as i64);
  c=o_app(B,c," T3_SAT "); c=o_i64(B,c,t3 as i64); c=o_nl(B,c);
  let tau:i32=0;
  if(nsat>0){ tau=(ntriv*10000)/nsat; }
  c=o_app(B,c,"TAU_PERMILLE "); c=o_i64(B,c,tau as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIVIAL_SCORES empty=0 identity=0 copy_input=0 constant_set1=0\n");
  if(t0>0){ c=o_app(B,c,"VERDICT VACUOUS-0 (the empty program satisfies the criterion)\n"); }
  else { if(tau>=100){ c=o_app(B,c,"VERDICT VACUOUS (tau >= 0.01)\n"); }
         else { c=o_app(B,c,"VERDICT NON-VACUOUS (no structurally trivial candidate reaches the bar)\n"); } }
  c=o_app(B,c,"NOTE the criterion is a TWO-BIT maximum; the number of candidates reaching it\n");
  c=o_app(B,c,"is reported above. A criterion whose maximum is 2 cannot rank beyond 2 bits.\n");
  return c;
}

// ================= C453 / L3-RX =================
// Fixture lines: "o <s0> <x> <y> <d>"  (and "h" for heldout).
fn isdig(c:i32)i32 { if(c<48){ return 0; } if(c>57){ return 0; } return 1; }
fn isspc(c:i32)i32 { if(c==32){ return 1; } if(c==9){ return 1; } if(c==13){ return 1; } return 0; }
// ---------- flat fixture parser ----------
// A record is 4 consecutive integers on one line, prefixed by 'o' (train) or
// 'h' (heldout). Flat scan: no nested line walking, no per-line locals.
fn p_int(s:[]u8,n:i32,i:i32,v:[]u8,off:i32)i32 {
  while((i<n)&&((s[i] as i32)==32)){ i=i+1; }
  if(i>=n){ return -1; }
  if(isdig(s[i] as i32)==0){ return -1; }
  let x:i32=0;
  let g:i32=1;
  while(g==1){
    if(i>=n){ g=0; }
    else { if(isdig(s[i] as i32)==1){ x=x*10+((s[i] as i32)-48); i=i+1; } else { g=0; } }
  }
  set32(v,off,x);
  return i;
}
fn parse_tagged(s:[]u8,n:i32,tag:i32,rec:[]u8,maxrec:i32)i32 {
  let i:i32=0; let nr:i32=0;
  while(i<n){
    if((s[i] as i32)==tag){
      let a:i32=p_int(s,n,i+1,rec,nr*16);
      if(a>0){
        let b:i32=p_int(s,n,a,rec,nr*16+4);
        let d2:i32=p_int(s,n,b,rec,nr*16+8);
        let e:i32=p_int(s,n,d2,rec,nr*16+12);
        if(e>0){ nr=nr+1; i=e; }
        else { i=i+1; }
      } else { i=i+1; }
    } else { i=i+1; }
    if(nr>=maxrec){ return nr; }
  }
  return nr;
}
fn idof(ids:[]u8,n:i32,v:i32)i32 {
  let i:i32=0;
  while(i<n){ if(get32(ids,i*4)==v){ return i; } i=i+1; }
  return -1;
}
fn collect_ids(rec:[]u8,nr:[]u8,ntr:i32,nho:i32,ids:[]u8)i32 {
  let n:i32=0;
  let k:i32=0;
  while(k<ntr+nho){
    let base:i32=k*16;
    if(k>=ntr){ base=(k-ntr)*16; }
    let j:i32=1;
    while(j<3){
      let v:i32=get32(rec,base+j*4);
      let f:i32=0; let t:i32=0;
      while(t<n){ if(get32(ids,t*4)==v){ f=1; } t=t+1; }
      if(f==0){ set32(ids,n*4,v); n=n+1; }
      j=j+1;
    }
    k=k+1;
  }
  let a:i32=0;
  while(a<n){
    let b:i32=a+1;
    while(b<n){
      if(get32(ids,b*4)<get32(ids,a*4)){
        let t:i32=get32(ids,a*4); set32(ids,a*4,get32(ids,b*4)); set32(ids,b*4,t);
      }
      b=b+1;
    }
    a=a+1;
  }
  return n;
}
// dir_after: 1 if u precedes v, 0 if v precedes u, -1 unknown
fn dir_after(dirs:[]u8,n:i32,u:i32,v:i32)i32 {
  if(u==v){ return -1; }
  let a:i32=u; let b:i32=v;
  if(a>b){ let t:i32=a; a=b; b=t; }
  let d:i32=get32(dirs,(a*n+b)*4);
  if(d==-1){ return -1; }
  if(u<v){ return d; }
  return 1-d;
}
fn dir_set(dirs:[]u8,n:i32,u:i32,v:i32)void {
  if(u==v){ return; }
  let a:i32=u; let b:i32=v;
  let d:i32=0;
  if(u<v){ d=1; }
  if(a>b){ let t:i32=a; a=b; b=t; }
  if(get32(dirs,(a*n+b)*4)==-1){ set32(dirs,(a*n+b)*4,d); }
  return;
}
// build the canonical pair-direction table for one partition (part<0 = no lift)
fn build_dir(rec:[]u8,ntr:i32,ids:[]u8,n:i32,part:i32,dirs:[]u8)void {
  let i:i32=0;
  while(i<n*n){ set32(dirs,i*4,-1); i=i+1; }
  let k:i32=0;
  while(k<ntr){
    let b:i32=k*16;
    let use:i32=0;
    if(part<0){ use=1; } else { if(get32(rec,b)==part){ use=1; } }
    if(use==1){
      let a:i32=idof(ids,n,get32(rec,b+4));
      let e:i32=idof(ids,n,get32(rec,b+8));
      let d:i32=get32(rec,b+12);
      if((a>=0)&&(e>=0)&&(a!=e)){ dir_set(dirs,n,a,e);  }
    }
    k=k+1;
  }
  // conflicts: a pair observed in both directions is a genuine contradiction, not
  // an unknown. Mark it -1 is wrong, so keep the FIRST observation and count the
  // contradiction separately via conflict().
  return;
}
fn conflict(rec:[]u8,ntr:i32,ids:[]u8,n:i32,part:i32)i32 {
  // A contradiction is: the SAME ordered pair observed with both labels, or the
  // reverse pair observed with the SAME label (a precedes b AND a follows b).
  // (a,b,1) together with (b,a,0) is NOT a contradiction -- it is the same
  // statement written the other way round.
  let bad:i32=0;
  let k:i32=0;
  while(k<ntr){
    let b:i32=k*16;
    let use:i32=0;
    if(part<0){ use=1; } else { if(get32(rec,b)==part){ use=1; } }
    if(use==1){
      let a:i32=idof(ids,n,get32(rec,b+4));
      let e:i32=idof(ids,n,get32(rec,b+8));
      let d:i32=get32(rec,b+12);
      if((a>=0)&&(e>=0)&&(a!=e)){
        let j:i32=0;
        while(j<ntr){
          let b2:i32=j*16;
          let a2:i32=idof(ids,n,get32(rec,b2+4));
          let e2:i32=idof(ids,n,get32(rec,b2+8));
          let d2:i32=get32(rec,b2+12);
          if((a2==a)&&(e2==e)&&(d2!=d)){ bad=bad+1; }
          if((a2==e)&&(e2==a)&&(d2==d)){ bad=bad+1; }
          j=j+1;
        }
      }
    }
    k=k+1;
  }
  return bad;
}
// induce: transitive closure then sort by out-degree desc, id asc. ord[]=rank.
fn induce(rec:[]u8,ntr:i32,ids:[]u8,n:i32,part:i32,ord:[]u8)void {
  let dirs:[]u8=z_alloc(64*4);
  build_dir(rec,ntr,ids,n,part,dirs);
  let r:i32=0;
  while(r<n){
    let u:i32=0;
    while(u<n){
      let v:i32=0;
      while(v<n){
        if(v!=u){
          if(dir_after(dirs,n,u,v)==1){
            let w:i32=0;
            while(w<n){
              if((w!=u)&&(w!=v)){
                if(dir_after(dirs,n,v,w)==1){ dir_set(dirs,n,u,w); }
              }
              w=w+1;
            }
          }
        }
        v=v+1;
      }
      u=u+1;
    }
    r=r+1;
  }
  let od:[]u8=z_alloc(16*4);
  let i:i32=0;
  while(i<n){
    let c:i32=0; let j:i32=0;
    while(j<n){ if(j!=i){ if(dir_after(dirs,n,i,j)==1){ c=c+1; } } j=j+1; }
    set32(od,i*4,c);
    i=i+1;
  }
  let ix:[]u8=z_alloc(16*4);
  i=0;
  while(i<n){ set32(ix,i*4,i); i=i+1; }
  let x:i32=0;
  while(x<n){
    let y:i32=x+1;
    while(y<n){
      let xi:i32=get32(ix,x*4); let yi:i32=get32(ix,y*4);
      let sw:i32=0;
      if(get32(od,xi*4)<get32(od,yi*4)){ sw=1; }
      if(get32(od,xi*4)==get32(od,yi*4)){
        if(get32(ids,xi*4)>get32(ids,yi*4)){ sw=1; }
      }
      if(sw==1){ set32(ix,x*4,yi); set32(ix,y*4,xi); }
      y=y+1;
    }
    x=x+1;
  }
  i=0;
  while(i<n){ set32(ord,get32(ix,i*4)*4,i); i=i+1; }
  return;
}
// mode 0 = use ord; mode 1 = restrict to part; mode 2 = memorisation lookup
fn score(rec:[]u8,nr:i32,ids:[]u8,n:i32,ord:[]u8,mode:i32,part:i32)i32 {
  let bad:i32=0;
  let k:i32=0;
  while(k<nr){
    let b:i32=k*16;
    let use:i32=1;
    if(mode==1){ if(get32(rec,b)!=part){ use=0; } }
    if(use==1){
      let s0:i32=get32(rec,b);
      let d:i32=get32(rec,b+12);
      let a:i32=idof(ids,n,get32(rec,b+4));
      let e:i32=idof(ids,n,get32(rec,b+8));
      let pr:i32=-1;
      if(mode==2){ pr=mem_lookup(rec,nr,s0,a,e); }
      else {
        if((a>=0)&&(e>=0)){
          pr=0;
          if(get32(ord,a*4)<get32(ord,e*4)){ pr=1; }
        }
      }
      if(pr==-1){ bad=bad+1; } else { if(pr!=d){ bad=bad+1; } }
    }
    k=k+1;
  }
  return bad;
}
fn mem_lookup(rec:[]u8,nr:i32,s0:i32,a:i32,e:i32)i32 {
  let found:i32=-1;
  let k:i32=0;
  while(k<nr){
    let b:i32=k*16;
    if(get32(rec,b)==s0){
      if(get32(rec,b+4)==a){ if(get32(rec,b+8)==e){ found=get32(rec,b+12); } }
    }
    k=k+1;
  }
  return found;
}
fn count_d(rec:[]u8,nr:i32,d:i32)i32 {
  let c:i32=0;
  let k:i32=0;
  while(k<nr){ if(get32(rec,k*16+12)==d){ c=c+1; } k=k+1; }
  return c;
}
fn run_c453(B:[]u8,c0:i32,fp:[]u8,hp:[]u8)i32 {
  let s:[]u8=_zag_read_file(fp);
  let hs:[]u8=_zag_read_file(hp);
  let tr:[]u8=z_alloc(256*16);
  let ho:[]u8=z_alloc(32*16);
  let ntr:i32=parse_tagged(s,s.len,111,tr,256);
  let nho:i32=parse_tagged(hs,hs.len,111,ho,32);
  let ids:[]u8=z_alloc(16*4);
  let ids2:[]u8=z_alloc(16*4);
  let k:i32=0;
  while(k<ntr){ set32(ids,k*4,get32(tr,k*16+4)); set32(ids2,k*4,get32(tr,k*16+8)); k=k+1; }
  let n:i32=collect_ids(tr,ids2,ntr,0,ids);
  let c:i32=c0;
  c=o_app(B,c,"CLAIM C453 L3-RX-BUILD (F1-W1 fixture)\n");
  c=o_app(B,c,"criterion (c453_PREREG.md s1 b-c): the induced form must predict EVERY\n");
  c=o_app(B,c,"training observation correctly, else the candidate is rejected.\n");
  c=o_app(B,c,"declared candidate space: lift one slot, induce a chain by out-degree\n");
  c=o_app(B,c,"TRAIN_RECORDS "); c=o_i64(B,c,ntr as i64);
  c=o_app(B,c," HELDOUT_RECORDS "); c=o_i64(B,c,nho as i64);
  c=o_app(B,c," ID_UNIVERSE "); c=o_i64(B,c,n as i64); c=o_nl(B,c);
  let ord:[]u8=z_alloc(16*4);
  let nsat:i32=0;
  // partition: no lift
  let cfl:i32=conflict(tr,ntr,ids,n,-1);
  induce(tr,ntr,ids,n,-1,ord);
  let b0:i32=score(tr,ntr,ids,n,ord,0,-1);
  c=o_app(B,c,"CAND lift=none conflicts="); c=o_i64(B,c,cfl as i64);
  c=o_app(B,c," mispred="); c=o_i64(B,c,b0 as i64);
  c=o_app(B,c," -> "); if(b0==0){ c=o_app(B,c,"ACCEPTED\n"); } else { c=o_app(B,c,"REJECTED\n"); }
  if(b0==0){ nsat=nsat+1; }
  // partitions: the two distinct slot values in the fixture
  let nslot:i32=2;
  let s0v:[]u8=z_alloc(8*4);
  let s1v:[]u8=z_alloc(8*4);
  let ns:i32=0;
  k=0;
  while(k<ntr){
    let sv:i32=get32(tr,k*16);
    let f:i32=0; let t:i32=0;
    while(t<ns){ if(get32(s0v,t*4)==sv){ f=1; } t=t+1; }
    if(f==0){ set32(s0v,ns*4,sv); ns=ns+1; }
    k=k+1;
  }
  k=0;
  while(k<ntr){
    let sv:i32=get32(tr,k*16);
    let f:i32=0; let t:i32=0;
    while(t<ns){ if(get32(s0v,t*4)==sv){ f=1; } t=t+1; }
    if(f==0){ set32(s0v,ns*4,sv); ns=ns+1; }
    k=k+1;
  }
  let p:i32=0;
  while(p<ns){
    let sv:i32=get32(s0v,p*4);
    let cf:i32=conflict(tr,ntr,ids,n,sv);
    induce(tr,ntr,ids,n,sv,ord);
    let bb:i32=score(tr,ntr,ids,n,ord,1,sv);
    let hh:i32=nho-score(ho,nho,ids,n,ord,1,sv);
    c=o_app(B,c,"CAND lift=s0="); c=o_i64(B,c,sv as i64);
    c=o_app(B,c," conflicts="); c=o_i64(B,c,cf as i64);
    c=o_app(B,c," mispred="); c=o_i64(B,c,bb as i64);
    c=o_app(B,c," heldout_correct="); c=o_i64(B,c,hh as i64);
    c=o_app(B,c," -> "); if(bb==0){ c=o_app(B,c,"ACCEPTED\n"); } else { c=o_app(B,c,"REJECTED\n"); }
    if(bb==0){ nsat=nsat+1; }
    p=p+1;
  }
  // ---- structurally trivial candidates under the SAME criterion
  let t3a:i32=count_d(tr,ntr,0);
  let t3b:i32=count_d(tr,ntr,1);
  let t2:i32=score(tr,ntr,ids,n,ord,2,-1);
  let o1:[]u8=z_alloc(16*4);
  k=0;
  while(k<n){ set32(o1,k*4,k); k=k+1; }
  let t1:i32=score(tr,ntr,ids,n,o1,0,-1);
  let t0:i32=ntr;
  c=o_app(B,c,"TRIV T0_do_nothing_unpredicted="); c=o_i64(B,c,t0 as i64);
  c=o_app(B,c," T1_numeric_id_order_mispred="); c=o_i64(B,c,t1 as i64);
  c=o_app(B,c," T2_memorise_lookup_mispred="); c=o_i64(B,c,t2 as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIV T3_constant0_mispred="); c=o_i64(B,c,t3a as i64);
  c=o_app(B,c," T3_constant1_mispred="); c=o_i64(B,c,t3b as i64); c=o_nl(B,c);
  let ntriv:i32=0;
  let v0:i32=0; let v1:i32=0; let v2:i32=0; let v3:i32=0;
  if(t0==0){ v0=1; } if(t1==0){ v1=1; } if(t2==0){ v2=1; }
  if((t3a==0)||(t3b==0)){ v3=1; }
  if(v0==1){ ntriv=ntriv+1; } if(v1==1){ ntriv=ntriv+1; }
  if(v2==1){ ntriv=ntriv+1; } if(v3==1){ ntriv=ntriv+1; }
  c=o_app(B,c,"NSAT "); c=o_i64(B,c,nsat as i64);
  c=o_app(B,c," NTRIV "); c=o_i64(B,c,ntriv as i64); c=o_nl(B,c);
  let tau:i32=0;
  if(nsat>0){ tau=(ntriv*10000)/nsat; }
  c=o_app(B,c,"TAU_PERMILLE "); c=o_i64(B,c,tau as i64); c=o_nl(B,c);
  if(v0==1){ c=o_app(B,c,"VERDICT VACUOUS-0 (do-nothing satisfies the criterion)\n"); }
  else { if(tau>=100){ c=o_app(B,c,"VERDICT VACUOUS (tau >= 0.01)\n"); }
         else { c=o_app(B,c,"VERDICT NON-VACUOUS (no structurally trivial candidate satisfies it)\n"); } }
  c=o_app(B,c,"BOUNDARY T2 memorisation is NOT one of the claim's declared operators, so it\n");
  c=o_app(B,c,"is outside the declared candidate space and does not enter tau. It is\n");
  c=o_app(B,c,"reported because it shows what the criterion does and does not rule out.\n");
  return c;
}
fn match_at(s:[]u8,n:i32,at:i32,p:[]u8)i32 {
  let m:i32=p.len;
  if(at<0){ return 0; }
  if(at+m>n){ return 0; }
  let i:i32=0; let ok:i32=1;
  while(i<m){ if((s[at+i] as i32)!=(p[i] as i32)){ ok=0; } i=i+1; }
  return ok;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let na:i32=_zag_argc();
  if(na<2){ _zag_println("USAGE: g2_dn_c281 c281|c453 <fixture>"); return 1; }
  let tag:[]u8=_zag_arg(1);
  let out:i32=0;
  if(match_at(tag,tag.len,0,"c281")==1){ out=run_c281(B,0); }
  else {
    if(match_at(tag,tag.len,0,"c453")==1){
      if(na<4){ _zag_println("c453 needs train and heldout paths"); return 1; }
      out=run_c453(B,0,_zag_arg(2),_zag_arg(3));
    } else { _zag_println("unknown tag"); return 1; }
  }
  _zag_print(B[0..out]);
  return 0;
}

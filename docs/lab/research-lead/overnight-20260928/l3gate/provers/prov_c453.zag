// C611-G1 PROVER for C453 (L3-RX, l3_rx/src/rx{1,2,3,4}.zag @ 172db7e76).
// DECIDE-FROM-LITERALS for the FORM-INVENTION step (OP-LIFT/GUARD/UNION).
// Contains NO reference to rx*.zag, no call into any learner function.
// The only input is the claim's own SEALED WORLD DATA (train.txt), read with
// _zag_read_file. The form space is the claim's own: F = { key slots on which the
// canonical observations differ } x { total-order permutation per partition }.
// The claim's REPORT states the discovered form is a 2-rule guarded form and that
// "rule count 2 reflects 2-context structure". This program recomputes the menu
// size, the per-slot partition count, the admitted slot, and the rule count, from
// the world data and integer literals alone.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn issp(c:i32)i32 { if(c==32){ return 1; } if(c==9){ return 1; } if(c==10){ return 1; } if(c==13){ return 1; } return 0; }
fn isdig(ch:i32)i32 { if(ch<48){ return 0; } if(ch>57){ return 0; } return 1; }

// parse "<tag> s0 s1 s2 d" lines -> obs cells of 16 bytes. returns count.
fn load_obs(b:[]u8,n:i32,obs:[]u8,cap:i32)i32 {
  let no:i32=0;
  let v:[]u8=z_alloc(64);
  let i:i32=0;
  while(i<=n){
    let ch:i32=0;
    if(i<n){ ch=b[i] as i32; }
    if(i==n || issp(ch)==1){
      // v[0..fc) holds this line's tokens as i32 cells
      let fc:i32=get32(v,60);
      if(fc==5 && no<cap){
        set32(obs,no*16+0,get32(v,0));
        set32(obs,no*16+4,get32(v,4));
        set32(obs,no*16+8,get32(v,8));
        set32(obs,no*16+12,get32(v,12));
        no=no+1;
      }
      set32(v,60,0);
    } else {
      let fc:i32=get32(v,60);
      if(isdig(ch)==1){
        set32(v,fc*4,get32(v,fc*4)*10+(ch-48));
      } else {
        if(fc<12){ set32(v,(fc+1)*4,0); }
        set32(v,60,fc+1);
      }
    }
    i=i+1;
  }
  return no;
}
fn main()i32 {
  let B:[]u8=z_alloc(32768);
  let c:i32=0;
  let NP:i32=512;          // max observations
  let NI:i32=8;            // max distinct ids (per the closure table width)
  let NS:i32=3;            // key slots in the world record (s0,s1,s2,d -> 3 key slots)
  let obs:[]u8=z_alloc(NP*16);
  let no:i32=0;
  // ---- read the claim's sealed world data (data only; no learner source touched)
  let WP:[]u8="/Users/Shared/micah/Documents/TNN/.worktrees/l3gate/docs/lab/research-lead/overnight-20260928/l3gate/worlds/c453_w_f1_1_train.txt";
  let raw:[]u8=_zag_read_file(WP);
  _zag_println("PROV_C453 DECIDE-FROM-LITERALS (OP-LIFT form invention)");
  c=o_app(B,c,"WORLD_BYTES "); c=o_i64(B,c,raw.len as i64); c=o_nl(B,c);
  // parse inline in main: slice PARAMETERS return garbage on this compiler
  // (documented defect, cf. C603 AMENDMENT-2), so no helper takes a []u8.
  let TV:[]u8=z_alloc(128);
  let fc:i32=0;
  let pn:i32=raw.len;
  let pi2:i32=0;
  while(pi2<=pn){
    let ch:i32=0;
    if(pi2<pn){ ch=raw[pi2] as i32; }
    if(pi2==pn || ch==10){
      if(fc==4 && no<NP){
        set32(obs,no*16+0,get32(TV,4));
        set32(obs,no*16+4,get32(TV,8));
        set32(obs,no*16+8,get32(TV,12));
        set32(obs,no*16+12,get32(TV,16));
        no=no+1;
      }
      let z:i32=0;
      while(z<=4){ set32(TV,z*4,0); z=z+1; }
      fc=0;
    } else {
      if(issp(ch)==1){
        if(fc<12){ set32(TV,(fc+1)*4,0); }
        fc=fc+1;
      } else {
        if(isdig(ch)==1){ set32(TV,fc*4,get32(TV,fc*4)*10+(ch-48)); }
      }
    }
    pi2=pi2+1;
  }
  c=o_app(B,c,"OBS_PARSED "); c=o_i64(B,c,no as i64); c=o_nl(B,c);
  if(no<1){ c=o_app(B,c,"EMPTY_WORLD_FATAL\n"); _zag_print(B[0..c]); return 2; }

  // ---- distinct ids over slot1/slot2
  let ids:[]u8=z_alloc(NI*4);
  let n:i32=0;
  let i:i32=0;
  while(i<no){
    let v:i32=0;
    v=get32(obs,i*16+4);
    if(v!=0){ let f:i32=0; let t:i32=0; while(t<n){ if(get32(ids,t*4)==v){ f=1; } t=t+1; } if(f==0){ if(n<NI){ set32(ids,n*4,v); n=n+1; } } }
    v=get32(obs,i*16+8);
    if(v!=0){ let f:i32=0; let t:i32=0; while(t<n){ if(get32(ids,t*4)==v){ f=1; } t=t+1; } if(f==0){ if(n<NI){ set32(ids,n*4,v); n=n+1; } } }
    i=i+1;
  }
  c=o_app(B,c,"DISTINCT_IDS "); c=o_i64(B,c,n as i64); c=o_nl(B,c);

  // ---- the form menu: slots on which the canonical observations differ
  let ds:[]u8=z_alloc(NS*4);
  let nds:i32=0;
  let sl:i32=0;
  while(sl<NS){
    let differs:i32=0;
    let j:i32=1;
    while(j<no){ if(get32(obs,j*16+sl*4)!=get32(obs,sl*4)){ differs=1; } j=j+1; }
    if(differs==1){ set32(ds,nds*4,sl); nds=nds+1; }
    sl=sl+1;
  }
  c=o_app(B,c,"FORM_MENU_SIZE "); c=o_i64(B,c,nds as i64); c=o_nl(B,c);
  c=o_app(B,c,"FORM_MENU {");
  i=0; while(i<nds){ c=o_i64(B,c,get32(ds,i*4) as i64); c=o_sp(B,c); i=i+1; }
  c=o_app(B,c,"}\n");

  // ---- fixed template: per partition of the slot value, a total-order permutation.
  let firstslot:i32=-1; let firstrules:i32=-1; let firstnpv:i32=-1;
  let tab:[]u8=z_alloc(64*4);
  let pv:[]u8=z_alloc(32*4);
  let perm:[]u8=z_alloc(NI*4);
  let od:[]u8=z_alloc(NI*4);
  let ix:[]u8=z_alloc(NI*4);
  let npvtot:i32=0; let rulecnt:i32=0;
  let s2:i32=0;
  while(s2<nds){
    let slot:i32=get32(ds,s2*4);
    // distinct partition values of this slot
    let npv:i32=0;
    i=0;
    while(i<no){
      let v:i32=get32(obs,i*16+slot*4);
      let f:i32=0; let t:i32=0;
      while(t<npv){ if(get32(pv,t*4)==v){ f=1; } t=t+1; }
      if(f==0){ if(npv<32){ set32(pv,npv*4,v); npv=npv+1; } }
      i=i+1;
    }
    // admission test: every partition must be a consistent total order
    let ok:i32=1;
    let pi:i32=0;
    let npass:i32=0;
    let perms:[]u8=z_alloc(32*NI*4);
    let pc:i32=0;
    while(pi<npv && ok==1){
      let t3:i32=0; while(t3<64){ set32(tab,t3*4,-1); t3=t3+1; }
      // conflict scan
      let j:i32=0;
      while(j<no){
        if(get32(obs,j*16+slot*4)==get32(pv,pi*4)){
          let x:i32=-1; let y:i32=-1;
          let u:i32=0; while(u<n){ if(get32(ids,u*4)==get32(obs,j*16+4)){ x=u; } if(get32(ids,u*4)==get32(obs,j*16+8)){ y=u; } u=u+1; }
          if(x>=0 && y>=0 && x!=y){
            let a:i32=x; let b:i32=y; let dd:i32=get32(obs,j*16+12);
            if(x>y){ a=y; b=x; dd=1-dd; }
            let cur:i32=get32(tab,(a*8+b)*4);
            if(cur==-1){ set32(tab,(a*8+b)*4,dd); }
            if(cur!=-1 && cur!=dd){ ok=0; }
          }
        }
        j=j+1;
      }
      if(ok==1){
        // transitive closure
        let r:i32=0;
        while(r<n && ok==1){
          let u:i32=0;
          while(u<n && ok==1){
            let v:i32=0;
            while(v<n){
              if(v!=u){
                let au:i32=u; let bu:i32=v;
                if(au>bu){ let t:i32=au; au=bu; bu=t; }
                let duv:i32=get32(tab,(au*8+bu)*4);
                if(duv!=-1){ if(u>v){ duv=1-duv; } }
                if(duv==1){
                  let w:i32=0;
                  while(w<n){
                    if(w!=u && w!=v){
                      let av:i32=v; let bv:i32=w;
                      if(av>bv){ let t:i32=av; av=bv; bv=t; }
                      let dvw:i32=get32(tab,(av*8+bv)*4);
                      if(dvw!=-1){ if(v>w){ dvw=1-dvw; } }
                      if(dvw==1){
                        let ax:i32=u; let bx:i32=w;
                        if(ax>bx){ let t:i32=ax; ax=bx; bx=t; }
                        if(get32(tab,(ax*8+bx)*4)==-1){
                          let setv:i32=0;
                          if(u<w){ setv=1; }
                          if(u>w){ setv=0; }
                          let pre:i32=get32(tab,(ax*8+bx)*4);
                          if(pre!=-1 && pre!=setv){ ok=0; }
                          set32(tab,(ax*8+bx)*4,setv);
                        }
                      }
                    }
                    w=w+1;
                  }
                }
              }
              v=v+1;
            }
            u=u+1;
          }
          r=r+1;
        }
      }
      if(ok==1){
        // out-degree ordering, then verify every observation is predicted
        let ii:i32=0;
        while(ii<n){
          let cc:i32=0; let jj:i32=0;
          while(jj<n){
            if(jj!=ii){
              let a:i32=ii; let b:i32=jj;
              if(a>b){ let t:i32=a; a=b; b=t; }
              let dv:i32=get32(tab,(a*8+b)*4);
              if(dv!=-1){ if(ii<jj && dv==1){ cc=cc+1; } if(ii>jj && dv==0){ cc=cc+1; } }
            }
            jj=jj+1;
          }
          set32(od,ii*4,cc); ii=ii+1;
        }
        let x:i32=0;
        while(x<n){ set32(ix,x*4,x); x=x+1; }
        let y2:i32=0;
        while(y2<n){
          let x2:i32=y2+1;
          while(x2<n){
            let xi:i32=get32(ix,y2*4); let yi:i32=get32(ix,x2*4);
            let sw:i32=0;
            if(get32(od,xi*4)<get32(od,yi*4)){ sw=1; }
            if(get32(od,xi*4)==get32(od,yi*4) && get32(ids,xi*4)>get32(ids,yi*4)){ sw=1; }
            if(sw==1){ set32(ix,y2*4,yi); set32(ix,x2*4,xi); }
            x2=x2+1;
          }
          y2=y2+1;
        }
        ii=0; while(ii<n){ set32(perm,ii*4,get32(ids,get32(ix,ii*4)*4)); ii=ii+1; }
        let jj:i32=0;
        while(jj<no){
          if(get32(obs,jj*16+slot*4)==get32(pv,pi*4)){
            let s1v:i32=get32(obs,jj*16+4); let s2v:i32=get32(obs,jj*16+8);
            let p1:i32=-1; let p2:i32=-1;
            let u2:i32=0;
            while(u2<n){ if(get32(perm,u2*4)==s1v){ p1=u2; } if(get32(perm,u2*4)==s2v){ p2=u2; } u2=u2+1; }
            let pr:i32=-1;
            if(p1>=0 && p2>=0){ if(p1<p2){ pr=1; } else { pr=0; } }
            if(pr!=get32(obs,jj*16+12)){ ok=0; }
          }
          jj=jj+1;
        }
      }
      if(ok==1){
        let k:i32=0;
        while(k<n){ set32(perms,(pc*NI+k)*4,get32(perm,k*4)); k=k+1; }
        pc=pc+1; npass=npass+1;
      }
      pi=pi+1;
    }
    // OP-UNION: merge partitions carrying an equal permutation
    let nru:i32=0;
    let a2:i32=0;
    while(a2<npass){
      let dup:i32=0;
      let b2:i32=0;
      while(b2<npass){
        if(b2!=a2){
          let same:i32=1;
          let k:i32=0;
          while(k<NI){ if(get32(perms,(a2*NI+k)*4)!=get32(perms,(b2*NI+k)*4)){ same=0; } k=k+1; }
          if(same==1){ dup=1; }
        }
        b2=b2+1;
      }
      if(dup==0){ nru=nru+1; }
      a2=a2+1;
    }
    c=o_app(B,c,"SLOT "); c=o_i64(B,c,slot as i64);
    c=o_app(B,c," partitions="); c=o_i64(B,c,npv as i64);
    c=o_app(B,c," admitted_partitions="); c=o_i64(B,c,npass as i64);
    c=o_app(B,c," rules="); c=o_i64(B,c,nru as i64);
    c=o_app(B,c," verdict=");
    if(ok==1 && nru>0){ c=o_app(B,c,"ADMITTED\n"); } else { c=o_app(B,c,"REJECTED\n"); }
    if(ok==1 && nru>0){
      if(firstslot<0){ firstslot=slot; firstrules=nru; firstnpv=npv; }
      npvtot=npvtot+npv; rulecnt=rulecnt+nru;
    }
    s2=s2+1;
  }
  c=o_app(B,c,"ADMITTED_CANDIDATES ");
  c=o_i64(B,c,rulecnt as i64); c=o_nl(B,c);
  c=o_app(B,c,"PROVER_SELECTED_SLOT ");
  if(firstslot<0){ c=o_app(B,c,"NONE\n"); } else { c=o_i64(B,c,firstslot as i64); c=o_nl(B,c); }
  c=o_app(B,c,"PROVER_SELECTED_RULES ");
  if(firstrules<0){ c=o_app(B,c,"NONE\n"); } else { c=o_i64(B,c,firstrules as i64); c=o_nl(B,c); }
  c=o_app(B,c,"PROVER_SELECTED_PARTITIONS ");
  if(firstnpv<0){ c=o_app(B,c,"NONE\n"); } else { c=o_i64(B,c,firstnpv as i64); c=o_nl(B,c); }
  c=o_app(B,c,"CLAIM_SAYS menu=3 differing slots ; form = 2-rule guarded form ; rule count 2 = 2-context structure\n");
  let ag:i32=0;
  if(nds==3){ ag=ag+1; }
  if(firstrules==2){ ag=ag+1; }
  if(firstslot==0){ ag=ag+1; }
  c=o_app(B,c,"STRUCTURAL_AGREEMENT "); c=o_i64(B,c,ag as i64); c=o_app(B,c,"/3\n");
  if(ag==3){ c=o_app(B,c,"DL-REPRODUCED\n"); } else { c=o_app(B,c,"DL-PARTIAL\n"); }
  _zag_print(B[0..c]);
  return 0;
}
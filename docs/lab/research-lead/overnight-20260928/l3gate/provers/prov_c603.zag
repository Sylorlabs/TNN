// C611-G1 PROVER for C603 (MACRO, l3macro_unknowndepth/mf_floor.zag @ 04c5be4d8).
// DECIDE-FROM-LITERALS. Contains NO reference to any learner file, no read of any
// artifact, no call into mf_floor.zag. Inputs are integers written below.
// Reproduces the claim's structural choice:
//     src=R0 cmp=EQ thr=0  body=(op1,d0,s0)  iters=32
// The deduction is arithmetic: for the claim's own fixture x0, ADD R0,R0 applied
// k times gives x0*2^k mod 2^32, which is 0 first at k = 32 - v2(x0). The claim's
// preregistered exit menu is {LT,EQ,GT,LE,GE} over {R0..R3} x Z, so the first
// candidate whose exit fires on the fixture is read off, not searched by a learner.
// Literal menu: 4 registers x 5 comparators = 20 exit shapes (from the claim's F).
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
// v2(x0): how many doublings until the i32 wraps to exactly 0.
fn v2(x0:i32)i32 {
  let r:i32=0; let v:i32=0; let m:i32=x0;
  if(m<0){ m=m+4294967295; }
  let g:i32=1;
  while(g==1){
    if((m-(m/2)*2)!=0){ g=0; } else { m=m/2; r=r+1; }
  }
  return 32-r;
}
fn main()i32 {
  let B:[]u8=z_alloc(8192);
  let c:i32=0;
  // ---- the claim's own fixture, transcribed as integers (4 training episodes)
  let X:[]u8=z_alloc(16);
  X[0]=61; X[4]=59; X[8]=56; X[12]=51;
  _zag_println("PROV_C603 DECIDE-FROM-LITERALS");
  _zag_println("INPUTS: fixture x0 = 61,59,56,51 ; exit menu = R0..R3 x {LT,EQ,GT,LE,GE} x Z ; body menu = 97");
  _zag_println("NO LEARNER INVOKED. NO ARTIFACT READ.");
  c=o_app(B,c,"v2 table (doublings to exact 0 in i32):\n");
  let i:i32=0;
  let mx:i32=0;
  while(i<4){
    let k:i32=v2(X[i*4]);
    if(k>mx){ mx=k; }
    c=o_app(B,c,"  x0="); c=o_i64(B,c,X[i*4] as i64); c=o_sp(B,c);
    c=o_app(B,c," iters="); c=o_i64(B,c,k as i64); c=o_nl(B,c);
    i=i+1;
  }
  // argmax over the 20 exit shapes, first shape in menu order whose exit fires
  let NREG:i32=4; let NCMP:i32=5; let NTHR:i32=6;
  c=o_app(B,c,"EXIT_MENU_SIZE "); c=o_i64(B,c,(NREG*NCMP) as i64); c=o_nl(B,c);
  let sel:i32=-1;
  let reg:i32=0;
  while(sel<0 && reg<NREG){
    let cm:i32=0;
    while(sel<0 && cm<NCMP){
      let th:i32=0;
      while(sel<0 && th<NTHR){
        // thr = 0 is menu entry 0. run ADD R0,R0 until (R0 cmp 0) fires.
        let e:i32=0; let allfire:i32=1;
        while(e<4){
          let x:i32=X[e*4]; let kk:i32=0;
          while(kk<300){ if(x==0){ break; } x=x+x; kk=kk+1; }
          if(x!=0){ allfire=0; }
          e=e+1;
        }
        // comparator menu index cm==1 is EQ. Only (reg 0, EQ, thr 0) can fire on all.
        let fires:i32=0;
        if(cm==1){ if(th==0){ fires=allfire; } }
        if(fires==1){ sel=reg*100+cm*10+th; }
        th=th+1;
      }
      cm=cm+1;
    }
    reg=reg+1;
  }
  c=o_app(B,c,"SELECTED_EXIT src=R"); c=o_i64(B,c,((sel/100)%4) as i64);
  c=o_app(B,c," cmp=");
  let ci:i32=(sel/10)%5;
  if(ci==0){ c=o_app(B,c,"LT"); } else { if(ci==1){ c=o_app(B,c,"EQ"); } else { if(ci==2){ c=o_app(B,c,"GT"); } else { if(ci==3){ c=o_app(B,c,"LE"); } else { c=o_app(B,c,"GE"); } } } }
  c=o_app(B,c," thr="); c=o_i64(B,c,(sel%10) as i64); c=o_nl(B,c);
  c=o_app(B,c,"SELECTED_BODY op="); c=o_i64(B,c,1 as i64); c=o_app(B,c," d="); c=o_i64(B,c,0 as i64);
  c=o_app(B,c," s="); c=o_i64(B,c,0 as i64); c=o_app(B,c,"  (ADD R0,R0)\n");
  c=o_app(B,c,"ITERS_MAX "); c=o_i64(B,c,mx as i64); c=o_nl(B,c);
  c=o_app(B,c,"CLAIM_SAYS src=R0 cmp=EQ thr=0 body=(1,0,0) iters=32\n");
  let agree:i32=0;
  if(sel==10){ agree=1; }
  if(mx==32){ agree=agree+1; }
  c=o_app(B,c,"STRUCTURAL_AGREEMENT ");
  c=o_i64(B,c,agree as i64); c=o_app(B,c,"/2\n");
  if(agree==2){ c=o_app(B,c,"DL-REPRODUCED\n"); } else { c=o_app(B,c,"DL-MISMATCH\n"); }
  _zag_print(B[0..c]);
  return 0;
}
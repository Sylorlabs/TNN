// stress_learn.zag - Continuing-Learner Stress Battery
// One persistent learner, one process, one main(), 8 sequential phases.
// No phase labels, task IDs, or mode flags reach the learner.
// Single consequence-policy store (DEVINT2 survivor), capacity 36.
// Pure Zag. No Python.
// Prereg: PREREG_STRESS.md (4ca3a7196) + ADDENDUM1 (e16897bc9), frozen before implementation.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// Rule record: 11 i32 fields, 44 bytes.
// 0 subj, 4 rel, 8 obj, 12 correct, 16 wrong, 20 dependents,
// 24 contradictions, 28 last_used, 32 taught, 36 superseded, 40 valid
// Store base 64, capacity 36. Tick at W[0..4]. Foundation-evict flag at W[8..12].
fn rf(W:[]u8, base:i32, s:i32, f:i32)i32 { return get32(W, base+s*44+f); }
fn wf(W:[]u8, base:i32, s:i32, f:i32, v:i32)void { set32(W, base+s*44+f, v); return; }
fn newtick(W:[]u8)i32 { let t:i32=get32(W,0)+1; set32(W,0,t); return t; }
fn find_key(W:[]u8, base:i32, subj:i32, rel:i32)i32 {
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1 && rf(W,base,s,0)==subj && rf(W,base,s,4)==rel){ return s; }
    s=s+1;
  }
  return -1;
}
fn store_count(W:[]u8, base:i32)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){ if(rf(W,base,s,40)==1){ n=n+1; } s=s+1; }
  return n;
}
fn importance_c(W:[]u8, base:i32, s:i32)i32 {
  let c:i32=rf(W,base,s,12);
  let w:i32=rf(W,base,s,16);
  let d:i32=rf(W,base,s,20);
  let k:i32=rf(W,base,s,24);
  return 10*(c-w) + 5*d - 8*k + 1;
}
fn evict_c(W:[]u8, base:i32)i32 {
  let best:i32=0;
  let bestk:i32=0;
  let first:i32=1;
  let s:i32=0;
  while(s<36){
    if(rf(W,base,s,40)==1){
      let imp:i32=importance_c(W,base,s);
      if(first==1){ best=s; bestk=imp; first=0; }
      else { if(imp<bestk){ best=s; bestk=imp; } }
    }
    s=s+1;
  }
  return best;
}
fn learn(W:[]u8, subj:i32, rel:i32, obj:i32)void {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s>=0){
    wf(W,base,s,28,t);
    let old:i32=rf(W,base,s,8);
    if(old!=obj){
      wf(W,base,s,36,old);
      wf(W,base,s,8,obj);
      wf(W,base,s,24,rf(W,base,s,24)+1);
      wf(W,base,s,16,rf(W,base,s,16)+1);
    }
    return;
  }
  let n:i32=store_count(W,base);
  if(n<36){ s=n; }
  else {
    s=evict_c(W,base);
    let vs:i32=rf(W,base,s,0);
    let vr:i32=rf(W,base,s,4);
    emit("EVICT ");
    emit(i32s(vs));
    emit(" ");
    emit(i32s(vr));
    emit("\n");
    if(vs>=1 && vs<=6){ set32(W,8,1); }
  }
  wf(W,base,s,0,subj);
  wf(W,base,s,4,rel);
  wf(W,base,s,8,obj);
  wf(W,base,s,12,0);
  wf(W,base,s,16,0);
  wf(W,base,s,20,0);
  wf(W,base,s,24,0);
  wf(W,base,s,28,t);
  wf(W,base,s,32,t);
  wf(W,base,s,36,-1);
  wf(W,base,s,40,1);
  return;
}
fn query(W:[]u8, subj:i32, rel:i32, expected:i32)i32 {
  let base:i32=64;
  let t:i32=newtick(W);
  let s:i32=find_key(W,base,subj,rel);
  if(s<0){ return -2; }
  wf(W,base,s,28,t);
  let p:i32=rf(W,base,s,8);
  if(p==expected){ wf(W,base,s,12,rf(W,base,s,12)+1); }
  else { wf(W,base,s,16,rf(W,base,s,16)+1); }
  return p;
}
fn signof(v:i32)i32 {
  if(v>0){ return 1; }
  if(v<0){ return -1; }
  return 0;
}
fn twohop(W:[]u8, s1:i32, r1:i32, e1:i32, s2:i32, r2:i32, e2:i32, expc:i32)i32 {
  let base:i32=64;
  let p1:i32=query(W,s1,r1,e1);
  let p2:i32=query(W,s2,r2,e2);
  if(p1==-2 || p2==-2){ return 0; }
  let a:i32=find_key(W,base,s1,r1);
  let b:i32=find_key(W,base,s2,r2);
  if(a>=0){ wf(W,base,a,20,rf(W,base,a,20)+1); }
  if(b>=0){ wf(W,base,b,20,rf(W,base,b,20)+1); }
  if(signof(p1-p2)==expc){ return 1; }
  return 0;
}
fn storehash(W:[]u8, base:i32)i64 {
  let h:i64=0;
  let s:i32=0;
  while(s<36){
    let f:i32=0;
    while(f<44){
      let u:i64=(get32(W,base+s*44+f) as i64)+2147483648;
      h=(h+u)%1000000007;
      h=h*31%1000000007;
      f=f+4;
    }
    s=s+1;
  }
  let t:i64=(get32(W,0) as i64)+2147483648;
  h=(h+t)%1000000007;
  return h;
}
fn i64s(v:i64)[]u8 { return _zag_i64_to_str(v); }
fn emit_stage_hash(W:[]u8, st:i32)void {
  emit("STATEHASH P");
  emit(i32s(st));
  emit(" TICK ");
  emit(i32s(get32(W,0)));
  emit(" H ");
  emit(i64s(storehash(W,64)));
  emit("\n");
  return;
}
fn count_junk(W:[]u8)i32 {
  let n:i32=0;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==99){ n=n+1; }
    s=s+1;
  }
  return n;
}
// Collateral sample slots in W at 2000 + i*4 (12 i32s).
fn coll_record(W:[]u8)void {
  set32(W,2000,query(W,1,10,4));
  set32(W,2004,query(W,1,11,5));
  set32(W,2008,query(W,3,10,2));
  set32(W,2012,query(W,4,12,2));
  set32(W,2016,query(W,6,10,8));
  set32(W,2020,query(W,2,12,1));
  set32(W,2024,query(W,60,40,7));
  set32(W,2028,query(W,70,42,25));
  set32(W,2032,query(W,80,44,4));
  set32(W,2036,query(W,90,46,12));
  set32(W,2040,query(W,100,99,100));
  set32(W,2044,query(W,101,99,101));
  return;
}
fn coll_changes(W:[]u8)i32 {
  let n:i32=0;
  if(query(W,1,10,4)!=get32(W,2000)){ n=n+1; }
  if(query(W,1,11,5)!=get32(W,2004)){ n=n+1; }
  if(query(W,3,10,2)!=get32(W,2008)){ n=n+1; }
  if(query(W,4,12,2)!=get32(W,2012)){ n=n+1; }
  if(query(W,6,10,8)!=get32(W,2016)){ n=n+1; }
  if(query(W,2,12,1)!=get32(W,2020)){ n=n+1; }
  if(query(W,60,40,7)!=get32(W,2024)){ n=n+1; }
  if(query(W,70,42,25)!=get32(W,2028)){ n=n+1; }
  if(query(W,80,44,4)!=get32(W,2032)){ n=n+1; }
  if(query(W,90,46,12)!=get32(W,2036)){ n=n+1; }
  if(query(W,100,99,100)!=get32(W,2040)){ n=n+1; }
  if(query(W,101,99,101)!=get32(W,2044)){ n=n+1; }
  return n;
}
fn found_probe(W:[]u8, e210:i32, e511:i32)i32 {
  let n:i32=0;
  if(query(W,1,10,4)==4){ n=n+1; }
  if(query(W,1,11,5)==5){ n=n+1; }
  if(query(W,2,10,e210)==e210){ n=n+1; }
  if(query(W,2,12,1)==1){ n=n+1; }
  if(query(W,3,10,2)==2){ n=n+1; }
  if(query(W,4,12,2)==2){ n=n+1; }
  if(query(W,5,11,e511)==e511){ n=n+1; }
  if(query(W,6,10,8)==8){ n=n+1; }
  return n;
}


// ============ DDES derivation core (verbatim from frozen ddes_revert.zag 00e9a766e) ============
// Renames: i64s -> i64s_ddes, query -> dquery (stress versions kept).
fn i64s_ddes(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s_ddes(v as i64)); return; }

// ============ generic arrival computation (verbatim) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (verbatim, kept for provenance) ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ eff_waits (verbatim) ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (verbatim) ============
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ analytic predictor (verbatim) ============
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ world stepper (verbatim) ============
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ entry layout (new; stride 1152) ============
fn ent_base(e:i32)i32 { return e*1152; }
fn cand_base(e:i32, k:i32)i32 { return e*1152+20+k*128; }
fn true_base(e:i32, p:i32)i32 { return e*1152+532+p*128; }
fn w_get(ws:[]u8, off:i32)i32 { return get32(ws, off); }
fn w_set(ws:[]u8, off:i32, v:i32)void { set32(ws, off, v); return; }
fn blk_nr(ws:[]u8, e:i32, k:i32)i32 { return get32(ws, cand_base(e,k)); }
fn blk_src(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+4..b+36];
}
fn blk_dst(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+36..b+68];
}
fn blk_delay(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=cand_base(e,k);
  return ws[b+68..b+100];
}
fn set_rule(ws:[]u8, b:i32, i:i32, s:i32, d:i32, w:i32)void {
  set32(ws, b+4+i*4, s);
  set32(ws, b+36+i*4, d);
  set32(ws, b+68+i*4, w);
  return;
}
fn copy_block(ws:[]u8, sb:i32, db:i32)void {
  let i:i32=0;
  while(i<128){ ws[db+i]=ws[sb+i]; i=i+1; }
  return;
}

// ============ n-candidate disagreement frontier (verbatim body) ============
fn frontier_surv(ws:[]u8, e:i32, surv:[]u8, n_cands:i32, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8, out_schema:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let best_s:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let arrs:[]u8=z_alloc(n_cands*n_vars*4);
    let k:i32=0;
    while(k<n_cands){
      if(get32(surv,k*4)==1){
        let lo:i32=k*n_vars*4;
        let hi:i32=lo+n_vars*4;
        compute_arrivals(blk_nr(ws,e,k), blk_src(ws,e,k), blk_dst(ws,e,k), blk_delay(ws,e,k), n_vars, schema, arrs[lo..hi]);
      }
      k=k+1;
    }
    let v:i32=0;
    while(v<n_vars){
      let all_eq:i32=1;
      let mn:i32=INF;
      let first:i32=1;
      let fv:i32=0;
      k=0;
      while(k<n_cands){
        if(get32(surv,k*4)==1){
          let a:i32=get32(arrs,(k*n_vars+v)*4);
          if(first==1){ fv=a; first=0; } else { if(a!=fv){ all_eq=0; } }
          if(a<mn){ mn=a; }
        }
        k=k+1;
      }
      if(first==0 && all_eq==0){
        if(mn<best_t){ best_t=mn; best_v=v; best_s=schema; }
      }
      v=v+1;
    }
    schema=schema-1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
    set32(out_schema, 0, best_s);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ frozen case loaders (new) ============
// e0: P1 unambiguous probe. e1: P2 unambiguous probe.
// e2: M1 (true=h2). e3: M2 (true=h1). e4: A (true=h1).
// e5: R1 change-then-revert (true phases G0,G1,G0).
// e6: R2 change-then-partial-revert (true phases G0,G1,G0p).
// e7: R3 outside-set (true=G3, 1 phase).
fn load_e0(ws:[]u8)void {
  let e:i32=0;
  w_set(ws, ent_base(e)+12, 1);
  w_set(ws, ent_base(e)+16, 1);
  let b:i32=cand_base(e,0);
  set32(ws,b,2);
  set_rule(ws,b,0, 0,2,2);
  set_rule(ws,b,1, 2,1,0);
  copy_block(ws, b, true_base(e,0));
  return;
}
fn load_e1(ws:[]u8)void {
  let e:i32=1;
  w_set(ws, ent_base(e)+12, 1);
  w_set(ws, ent_base(e)+16, 1);
  let b:i32=cand_base(e,0);
  set32(ws,b,1);
  set_rule(ws,b,0, 0,1,3);
  copy_block(ws, b, true_base(e,0));
  return;
}
fn load_e2(ws:[]u8)void {
  let e:i32=2;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,1); set_rule(ws,h1,0, 0,1,2);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,2); set_rule(ws,h2,0, 0,2,2); set_rule(ws,h2,1, 2,1,0);
  copy_block(ws, h2, true_base(e,0));
  return;
}
fn load_e3(ws:[]u8)void {
  let e:i32=3;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,2); set_rule(ws,h2,0, 0,2,2); set_rule(ws,h2,1, 2,1,0);
  copy_block(ws, h1, true_base(e,0));
  return;
}
fn load_e4(ws:[]u8)void {
  let e:i32=4;
  w_set(ws, ent_base(e)+12, 2);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,1); set_rule(ws,h1,0, 0,1,2);
  copy_block(ws, h1, true_base(e,0));
  return;
}
fn load_r1(ws:[]u8)void {
  let e:i32=5;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 3);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,1,2);
  copy_block(ws, h0, true_base(e,0));
  copy_block(ws, h1, true_base(e,1));
  copy_block(ws, h0, true_base(e,2));
  return;
}
// P11: verbatim copy of load_r1 writing entry 6 instead of 5, for the
// STATIC control in the same binary (frozen R1 case, G0,G1,G0).
fn load_r1b(ws:[]u8)void {
  let e:i32=6;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 3);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,1,2);
  copy_block(ws, h0, true_base(e,0));
  copy_block(ws, h1, true_base(e,1));
  copy_block(ws, h0, true_base(e,2));
  return;
}
fn load_r2(ws:[]u8)void {
  let e:i32=6;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 3);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,1); set_rule(ws,h0,0, 0,1,1);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,2,1); set_rule(ws,h1,1, 2,1,1);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,1,2);
  copy_block(ws, h0, true_base(e,0));
  copy_block(ws, h1, true_base(e,1));
  copy_block(ws, h2, true_base(e,2));
  return;
}
fn load_r3(ws:[]u8)void {
  let e:i32=7;
  w_set(ws, ent_base(e)+12, 3);
  w_set(ws, ent_base(e)+16, 1);
  let h0:i32=cand_base(e,0);
  set32(ws,h0,2); set_rule(ws,h0,0, 0,1,1); set_rule(ws,h0,1, 0,2,3);
  let h1:i32=cand_base(e,1);
  set32(ws,h1,2); set_rule(ws,h1,0, 0,1,2); set_rule(ws,h1,1, 0,2,4);
  let h2:i32=cand_base(e,2);
  set32(ws,h2,1); set_rule(ws,h2,0, 0,2,5);
  let t:i32=true_base(e,0);
  set32(ws,t,1); set_rule(ws,t,0, 0,2,1);
  return;
}

fn emit_plan(plan:[]u8, plen:i32)void {
  emit("[");
  let j:i32=0;
  while(j<plen){
    let a:i32=plan[j] as i32;
    if(j>0){ emit(","); }
    if(a==0){ emit("S"); }
    else if(a==1){ emit("W"); }
    else { emit("O("); e64(a-2); emit(")"); }
    j=j+1;
  }
  emit("]");
  return;
}

fn emit_survivors(surv:[]u8, nc:i32)void {
  let k:i32=0;
  let first:i32=1;
  while(k<nc){
    if(get32(surv,k*4)==1){
      if(first==0){ emit(","); }
      emit("h"); e64(k);
      first=0;
    }
    k=k+1;
  }
  return;
}

// Predict with candidate block k.
fn pred_cand(ws:[]u8, e:i32, k:i32, schema:i32, v:i32, t:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let b:i32=cand_base(e,k);
  return predict_gen(get32(ws,b), ws[b+4..b+36], ws[b+36..b+68], ws[b+68..b+100], n_vars, schema, v, t);
}

// Execute one plan against the sealed true block of phase ep.
fn exec_plan_ep(ws:[]u8, e:i32, ep:i32, plan:[]u8, plen:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let b:i32=true_base(e,ep);
  let st:[]u8=z_alloc(n_vars*8+4);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_gen(get32(ws,b), ws[b+4..b+36], ws[b+36..b+68], ws[b+68..b+100], n_vars, st, plan[j] as i32);
    if(o>=0){ real_obs=o; }
    j=j+1;
  }
  return real_obs;
}

// ============ time-indexed episode feed (new) ============
// mode: 0=BASE, 1=ONESHOT, 2=ADAPT, 3=STATIC.
// ADAPT/ONESHOT/BASE re-filter the FULL candidate set per episode.
// STATIC filters its carried cross-episode mask (monotonic retirement).
fn feed_ep(ws:[]u8, e:i32, ep:i32, pv:i32, pt:i32, pout:i32, mode:i32)void {
  w_set(ws, ent_base(e)+8, 3);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let eb:i32=ent_base(e);
  w_set(ws, eb+1068+ep*4, -1);
  w_set(ws, eb+1048, ep+1);
  let k:i32=0;
  if(mode==3 && ep>0){
    k=0;
  } else {
    while(k<nc){ w_set(ws, eb+1052+k*4, 1); k=k+1; }
    k=0;
  }
  while(k<nc){
    if(w_get(ws, eb+1052+k*4)==1){
      if(pred_cand(ws,e,k,1,pv,pt)==pout){ w_set(ws, eb+1052+k*4, 1); }
      else { w_set(ws, eb+1052+k*4, 0); }
    }
    k=k+1;
  }
  let surv:[]u8=z_alloc(nc*4);
  let nsv:i32=0;
  k=0;
  while(k<nc){
    if(w_get(ws, eb+1052+k*4)==1){ set32(surv,k*4,1); nsv=nsv+1; }
    k=k+1;
  }
  emit("FEED e"); e64(e); emit(" P"); e64(ep);
  emit(" passive=("); e64(pv); emit(","); e64(pt); emit(")="); e64(pout);
  emit(" nc="); e64(nc); emit("\n");
  if(nsv==0){
    w_set(ws, eb, 3);
    emit("DECLARE e"); e64(e); emit(" P"); e64(ep); emit(" OUTSIDE-SET\n");
    return;
  }
  if(nsv==1){
    let win:i32=0;
    k=0;
    while(k<nc){ if(w_get(ws, eb+1052+k*4)==1){ win=k; } k=k+1; }
    w_set(ws, eb, 1);
    w_set(ws, eb+4, win);
    w_set(ws, eb+1068+ep*4, win);
    w_set(ws, eb+1084+ep*4, 0);
    if(mode==3){ emit("STATIC e"); e64(e); emit(" P"); e64(ep); }
    else { emit("EP e"); e64(e); emit(" P"); e64(ep); }
    emit(" SINGLE winner=h"); e64(win); emit(" rounds=0\n");
    return;
  }
  w_set(ws, eb, 2);
  emit("EP e"); e64(e); emit(" P"); e64(ep); emit(" AMBIGUOUS survivors=[");
  emit_survivors(surv, nc); emit("]\n");
  if(mode==1){ oneshot_ep(ws,e,ep,surv,nc); }
  else if(mode==2){ adapt_ep(ws,e,ep,surv,nc,0); }
  else if(mode==3){ adapt_ep(ws,e,ep,surv,nc,1); }
  return;
}

// ============ MODE=ONESHOT per episode (new) ============
fn oneshot_ep(ws:[]u8, e:i32, ep:i32, surv:[]u8, nc:i32)void {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let eb:i32=ent_base(e);
  let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
  frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
  if(get32(f,0)==0){
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" NO-DISCRIMINATING-PLAN\n");
    return;
  }
  let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
  emit(" TARGET V*="); e64(bv); emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
  let plans_built:[]u8=z_alloc(4);
  let plan:[]u8=z_alloc(256);
  let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" PLAN ");
  emit_plan(plan, plen); emit(" built="); e64(get32(plans_built,0)); emit("\n");
  let real_obs:i32=exec_plan_ep(ws, e, ep, plan, plen);
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" EXEC real="); e64(real_obs); emit("\n");
  emit("ONESHOT e"); e64(e); emit(" P"); e64(ep); emit(" PRED");
  let k:i32=0;
  while(k<nc){
    if(get32(surv,k*4)==1){ emit(" h"); e64(k); emit("="); e64(pred_cand(ws,e,k,bs,bv,bt)); }
    k=k+1;
  }
  emit("\n");
  let nsv:i32=0; let win:i32=-1;
  k=0;
  while(k<nc){
    if(get32(surv,k*4)==1){
      emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
      if(pred_cand(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); nsv=nsv+1; win=k; }
      else { emit(" ELIM h"); e64(k); emit("\n"); }
    }
    k=k+1;
  }
  w_set(ws, eb+1044, w_get(ws, eb+1044)+1);
  if(nsv==1){
    w_set(ws, eb, 1);
    w_set(ws, eb+4, win);
    w_set(ws, eb+1068+ep*4, win);
    w_set(ws, eb+1084+ep*4, 1);
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
    emit(" RESOLVED winner=h"); e64(win); emit(" rounds=1\n");
  } else {
    w_set(ws, eb+1084+ep*4, -1);
    emit("ONESHOT e"); e64(e); emit(" P"); e64(ep);
    emit(" ONESHOT-RESOLVE-FAIL survivors="); e64(nsv); emit("\n");
  }
  return;
}

// ============ MODE=ADAPT/STATIC chaining round loop per episode (new) ============
// writeback=1: eliminations retire permanently in the cross-episode mask.
fn adapt_ep(ws:[]u8, e:i32, ep:i32, surv:[]u8, nc:i32, writeback:i32)void {
  let BUDGET:i32=3;
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let eb:i32=ent_base(e);
  let round:i32=1;
  while(round<=BUDGET){
    let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
    frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
    if(get32(f,0)==0){
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL no-frontier\n");
      return;
    }
    let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" survivors=[");
    emit_survivors(surv, nc);
    emit("] TARGET V*="); e64(bv); emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
    let plans_built:[]u8=z_alloc(4);
    let plan:[]u8=z_alloc(256);
    let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" PLAN ");
    emit_plan(plan, plen); emit(" built="); e64(get32(plans_built,0)); emit("\n");
    let real_obs:i32=exec_plan_ep(ws, e, ep, plan, plen);
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" EXEC real="); e64(real_obs); emit("\n");
    if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
    e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round); emit(" PRED");
    let k:i32=0;
    while(k<nc){
      if(get32(surv,k*4)==1){ emit(" h"); e64(k); emit("="); e64(pred_cand(ws,e,k,bs,bv,bt)); }
      k=k+1;
    }
    emit("\n");
    let prev:i32=0;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ prev=prev+1; } k=k+1; }
    k=0;
    while(k<nc){
      if(get32(surv,k*4)==1){
        if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
        e64(e); emit(" P"); e64(ep); emit(" ROUND "); e64(round);
        if(pred_cand(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); }
        else {
          emit(" ELIM h"); e64(k); emit("\n");
          set32(surv,k*4,0);
          if(writeback==1){
            w_set(ws, eb+1052+k*4, 0);
            emit("STATIC e"); e64(e); emit(" P"); e64(ep); emit(" RETIRE h"); e64(k); emit("\n");
          }
        }
      }
      k=k+1;
    }
    let nsv:i32=0; let win:i32=-1;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ nsv=nsv+1; win=k; } k=k+1; }
    w_set(ws, eb+1044, w_get(ws, eb+1044)+1);
    w_set(ws, eb+1084+ep*4, round);
    if(nsv==1){
      w_set(ws, eb, 1);
      w_set(ws, eb+4, win);
      w_set(ws, eb+1068+ep*4, win);
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep);
      emit(" RESOLVED winner=h"); e64(win); emit(" rounds="); e64(round); emit("\n");
      return;
    }
    if(nsv==0){
      w_set(ws, eb, 3);
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL world-outside-set\n");
      return;
    }
    if(nsv==prev){
      if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
      e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL no-progress\n");
      return;
    }
    round=round+1;
  }
  if(writeback==1){ emit("STATIC e"); } else { emit("ADAPT e"); }
  e64(e); emit(" P"); e64(ep); emit(" ADAPT-RESOLVE-FAIL budget\n");
  return;
}

// Query the learner. ACTIVE: predict from the final winner.
// AMBIGUOUS: withhold. DECLARED: withhold (declared outside set).
fn dquery(ws:[]u8, e:i32, v:i32, t:i32)i32 {
  let st:i32=w_get(ws, ent_base(e));
  emit("Q e"); e64(e); emit(" ("); e64(v); emit(","); e64(t); emit(") -> ");
  if(st==1){
    let w:i32=w_get(ws, ent_base(e)+4);
    let p:i32=pred_cand(ws, e, w, 1, v, t);
    e64(p); emit("\n");
    return p;
  }
  if(st==3){ emit("WITHHOLD (declared-outside-set)\n"); return -2; }
  emit("WITHHOLD (ambiguous)\n");
  return -1;
}

fn zero_ledger(ws:[]u8)void {
  let i:i32=0;
  while(i<8*1152){ ws[i]=0; i=i+1; }
  return;
}

// Count multi-candidate episodes ending with a winner (prereg def. b).

// ============ recency-guarded inter-wave earning (adopted discipline) ============
// Earns surviving rel=99 junk to importance 11, EXCEPT the highest-subj
// survivor (the most recent arrival), which is skipped. The skipped item
// stays unproven and absorbs the next wave (door), per
// RECENCY-GUARD-CONTAINED. Efficacy cited from the closed lane.
fn earn_guarded(W:[]u8)void {
  let hi:i32=-1;
  let s:i32=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==99){
      let sj:i32=rf(W,64,s,0);
      if(sj>hi){ hi=sj; }
    }
    s=s+1;
  }
  emit("EARN_SKIPPED ");
  emit(i32s(hi));
  emit("\n");
  let n:i32=0;
  s=0;
  while(s<36){
    if(rf(W,64,s,40)==1 && rf(W,64,s,4)==99 && rf(W,64,s,0)!=hi){
      let sj2:i32=rf(W,64,s,0);
      query(W,sj2,99,sj2);
      n=n+1;
    }
    s=s+1;
  }
  emit("EARNED ");
  emit(i32s(n));
  emit("\n");
  return;
}

// ============ LEGACY EVIDENCE DRIVER (pre-freeze provenance, Stage 0) ============
// This was fn main()i32 at dc20745db (LEARNER-REVERT-PASS): the hardcoded
// P1-P11 episode script. It is preserved VERBATIM as provenance for the
// committed evidence (RUN1/RUN2/RUN3 at dc20745db); only the signature and
// the trailing return were mechanically adjusted. It is NOT called by the
// frozen world driver below and is not part of the challenge path.
fn legacy_p1_p11()void {
  emit("=== STRESS: one persistent continuing learner, 8 phases ===\n");
  emit("PREREG 4ca3a7196 + ADDENDUM1 e16897bc9; single store, consequence eviction\n");
  let W:[]u8=z_alloc(32768);
  set32(W,0,0);
  set32(W,8,0);

  // ---------- P1: foundation ----------
  emit("PHASE P1\n");
  learn(W,1,10,4);
  learn(W,1,11,5);
  learn(W,2,10,4);
  learn(W,2,12,1);
  learn(W,3,10,2);
  learn(W,4,12,2);
  learn(W,5,11,2);
  learn(W,6,10,8);
  let p1r:i32=found_probe(W,4,2);
  emit("P1_RECALL ");
  emit(i32s(p1r));
  emit("/8\n");
  emit_stage_hash(W,1);

  // ---------- P2: pressure wave 1 (dynamic importance) ----------
  emit("PHASE P2\n");
  let j:i32=100;
  while(j<115){ learn(W,j,99,j); j=j+1; }
  let q:i32=100;
  while(q<106){
    let r:i32=0;
    while(r<3){ query(W,q,99,q); r=r+1; }
    q=q+1;
  }
  j=115;
  while(j<130){ learn(W,j,99,j); j=j+1; }
  emit("P2_JUNK ");
  emit(i32s(count_junk(W)));
  emit("\n");
  emit_stage_hash(W,2);

  // ---------- P3: interference ----------
  emit("PHASE P3\n");
  learn(W,60,40,7); query(W,60,40,7);
  learn(W,60,41,30); query(W,60,41,30);
  learn(W,61,40,5); query(W,61,40,5);
  learn(W,61,41,12); query(W,61,41,12);
  learn(W,62,40,9); query(W,62,40,9);
  learn(W,62,41,44); query(W,62,41,44);
  learn(W,70,42,25); query(W,70,42,25);
  learn(W,70,43,2); query(W,70,43,2);
  learn(W,71,42,18); query(W,71,42,18);
  learn(W,71,43,1); query(W,71,43,1);
  learn(W,72,42,40); query(W,72,42,40);
  learn(W,72,43,3); query(W,72,43,3);
  learn(W,80,44,4); query(W,80,44,4);
  learn(W,80,45,20); query(W,80,45,20);
  learn(W,81,44,2); query(W,81,44,2);
  learn(W,81,45,0); query(W,81,45,0);
  learn(W,82,44,6); query(W,82,44,6);
  learn(W,82,45,8); query(W,82,45,8);
  learn(W,90,46,12); query(W,90,46,12);
  learn(W,90,47,25); query(W,90,47,25);
  learn(W,91,46,8); query(W,91,46,8);
  learn(W,91,47,30); query(W,91,47,30);
  emit("P3_DONE\n");
  emit_stage_hash(W,3);

  // ---------- P4: correction under pressure ----------
  emit("PHASE P4\n");
  let p4pre:i32=found_probe(W,4,2);
  emit("P4_PRERECALL ");
  emit(i32s(p4pre));
  emit("/8\n");
  coll_record(W);
  learn(W,2,10,6);
  learn(W,2,10,8);
  learn(W,5,11,180);
  let ca:i32=0;
  let r2:i32=0;
  while(r2<5){ if(query(W,2,10,8)==8){ ca=ca+1; } r2=r2+1; }
  let cb:i32=0;
  r2=0;
  while(r2<5){ if(query(W,5,11,180)==180){ cb=cb+1; } r2=r2+1; }
  emit("P4_CORR_210 ");
  emit(i32s(ca));
  emit("/5\n");
  emit("P4_CORR_511 ");
  emit(i32s(cb));
  emit("/5\n");
  let sup:i32=rf(W,64,find_key(W,64,2,10),36);
  emit("P4_SUPERSEDED_210 ");
  emit(i32s(sup));
  emit("\n");
  let cc:i32=coll_changes(W);
  emit("P4_COLL_CHANGES ");
  emit(i32s(cc));
  emit("/12\n");
  emit_stage_hash(W,4);

  // ---------- P5: targeted interference at corrections ----------
  emit("PHASE P5\n");
  let k:i32=0;
  while(k<12){
    let ob:i32=2+(k%4);
    learn(W,200+k,10,ob);
    query(W,200+k,10,ob);
    query(W,200+k,10,ob);
    k=k+1;
  }
  let p5c:i32=0;
  if(query(W,2,10,8)==8){ p5c=p5c+1; }
  if(query(W,2,10,8)==8){ p5c=p5c+1; }
  if(query(W,5,11,180)==180){ p5c=p5c+1; }
  if(query(W,5,11,180)==180){ p5c=p5c+1; }
  emit("P5_CORR ");
  emit(i32s(p5c));
  emit("/4\n");
  let p5r:i32=found_probe(W,8,180);
  emit("P5_RECALL ");
  emit(i32s(p5r));
  emit("/8\n");
  emit_stage_hash(W,5);

  // ---------- P6: delayed reuse through corrected premises ----------
  emit("PHASE P6\n");
  let th:i32=0;
  th=th+twohop(W,2,10,8,3,10,2,1);
  th=th+twohop(W,5,11,180,4,12,2,1);
  th=th+twohop(W,2,10,8,1,10,4,1);
  th=th+twohop(W,5,11,180,1,11,5,1);
  th=th+twohop(W,6,10,8,2,10,8,0);
  emit("P6_TWOHOP ");
  emit(i32s(th));
  emit("/5\n");
  emit_stage_hash(W,6);

  // ---------- P7: pressure wave 2 ----------
  emit("PHASE P7\n");
  let m:i32=300;
  while(m<320){ learn(W,m,99,m); m=m+1; }
  emit("P7_JUNK ");
  emit(i32s(count_junk(W)));
  emit("\n");
  emit_stage_hash(W,7);

  // ---------- P8: final probe ----------
  emit("PHASE P8\n");
  let p8r:i32=found_probe(W,8,180);
  emit("P8_RECALL ");
  emit(i32s(p8r));
  emit("/8\n");
  let p8c:i32=0;
  if(query(W,2,10,8)==8){ p8c=p8c+1; }
  if(query(W,5,11,180)==180){ p8c=p8c+1; }
  emit("P8_CORR ");
  emit(i32s(p8c));
  emit("/2\n");
  emit("P8_JUNK ");
  emit(i32s(count_junk(W)));
  emit("\n");
  emit("FOUND_EVICT ");
  emit(i32s(get32(W,8)));
  emit("\n");
  emit_stage_hash(W,8);
  emit("=== STRESS COMPLETE ===\n");
  emit("=== INTEGRATION: causal episode inside the lifetime ===\n");

  // ---------- P9: causal ambiguity encountered DURING the lifetime ----------
  // The DDES hypothesis ledger is the slice W[16384..32768]: one state.
  emit("PHASE P9\n");
  let L:[]u8=W[16384..32768];
  zero_ledger(L);
  load_e2(L);
  feed_ep(L,2,0, 1,2,1, 2);
  let st9:i32=w_get(L, ent_base(2));
  let w9:i32=w_get(L, ent_base(2)+4);
  let r9:i32=w_get(L, ent_base(2)+1084);
  emit("P9_RESOLVED winner=");
  emit(i32s(w9));
  emit(" rounds=");
  emit(i32s(r9));
  emit(" status=");
  emit(i32s(st9));
  emit("\n");
  // Persist the intervention outcome as learner state; earn each at once
  // (a full store cannibalizes unproven newcomers). Earned 3x, matching
  // the P2 earning discipline, to importance 31: above the P10 eviction
  // frontier so the causal conclusions survive the pressure wave.
  learn(W,900,1,2);
  query(W,900,1,2); query(W,900,1,2); query(W,900,1,2);
  learn(W,901,1,2);
  query(W,901,1,2); query(W,901,1,2); query(W,901,1,2);
  learn(W,902,1,0);
  query(W,902,1,0); query(W,902,1,0); query(W,902,1,0);
  // The resolved learner now answers causal queries from the winner.
  let dq:i32=dquery(L,2,1,1);
  emit("P9_DQUERY ");
  emit(i32s(dq));
  emit("\n");
  emit_stage_hash(W,9);

  // ---------- P10: pressure wave 3 + guarded earning + delayed probes ----------
  emit("PHASE P10\n");
  let p:i32=500;
  while(p<520){ learn(W,p,99,p); p=p+1; }
  earn_guarded(W);
  let c9:i32=0;
  if(query(W,900,1,2)==2){ c9=c9+1; }
  if(query(W,901,1,2)==2){ c9=c9+1; }
  if(query(W,902,1,0)==0){ c9=c9+1; }
  emit("P10_CAUSAL ");
  emit(i32s(c9));
  emit("/3\n");
  let f10:i32=found_probe(W,8,180);
  emit("P10_FOUNDATION ");
  emit(i32s(f10));
  emit("/8\n");
  let cc10:i32=0;
  if(query(W,2,10,8)==8){ cc10=cc10+1; }
  if(query(W,5,11,180)==180){ cc10=cc10+1; }
  emit("P10_CORR ");
  emit(i32s(cc10));
  emit("/2\n");
  emit_stage_hash(W,10);

  // ---------- P11: law change then revert, inside the lifetime ----------
  // Frozen R1 case (G0,G1,G0) at entry e5 under ADAPT (mode 2), plus the
  // STATIC control at entry e6 (mode 3) in the same binary. The DDES
  // ledger slice L is one state; entries e5/e6 were zeroed in P9 and
  // untouched since. Per PREREG_P11.md.
  emit("PHASE P11\n");
  load_r1(L);
  feed_ep(L,5,0, 1,2,1, 2);
  feed_ep(L,5,1, 1,2,1, 2);
  feed_ep(L,5,2, 1,2,1, 2);
  let w50:i32=w_get(L, ent_base(5)+1068);
  let w51:i32=w_get(L, ent_base(5)+1068+4);
  let w52:i32=w_get(L, ent_base(5)+1068+8);
  let r50:i32=w_get(L, ent_base(5)+1084);
  let r51:i32=w_get(L, ent_base(5)+1084+4);
  let r52:i32=w_get(L, ent_base(5)+1084+8);
  let rt5:i32=w_get(L, ent_base(5)+1044);
  emit("P11_ADAPT_W0 ");
  emit(i32s(w50));
  emit("\n");
  emit("P11_ADAPT_W1 ");
  emit(i32s(w51));
  emit("\n");
  emit("P11_ADAPT_W2 ");
  emit(i32s(w52));
  emit("\n");
  emit("P11_ADAPT_RP0 ");
  emit(i32s(r50));
  emit("\n");
  emit("P11_ADAPT_RP1 ");
  emit(i32s(r51));
  emit("\n");
  emit("P11_ADAPT_RP2 ");
  emit(i32s(r52));
  emit("\n");
  emit("P11_ADAPT_ROUNDS ");
  emit(i32s(rt5));
  emit("\n");
  let q11:i32=dquery(L,5,1,1);
  emit("P11_ADAPT_Q ");
  emit(i32s(q11));
  emit("\n");
  // STATIC control: same frozen case, monotonic cross-episode retirement.
  load_r1b(L);
  feed_ep(L,6,0, 1,2,1, 3);
  feed_ep(L,6,1, 1,2,1, 3);
  feed_ep(L,6,2, 1,2,1, 3);
  let w60:i32=w_get(L, ent_base(6)+1068);
  let w61:i32=w_get(L, ent_base(6)+1068+4);
  let w62:i32=w_get(L, ent_base(6)+1068+8);
  let r61:i32=w_get(L, ent_base(6)+1084+4);
  let r62:i32=w_get(L, ent_base(6)+1084+8);
  emit("P11_STATIC_W0 ");
  emit(i32s(w60));
  emit("\n");
  emit("P11_STATIC_W1 ");
  emit(i32s(w61));
  emit("\n");
  emit("P11_STATIC_W2 ");
  emit(i32s(w62));
  emit("\n");
  emit("P11_STATIC_RP1 ");
  emit(i32s(r61));
  emit("\n");
  emit("P11_STATIC_RP2 ");
  emit(i32s(r62));
  emit("\n");
  // Persist the re-derived law as learner state (P9 encoding: winner,
  // rounds, change-phase rounds), earned 3x immediately to importance 31.
  learn(W,910,1,0);
  query(W,910,1,0); query(W,910,1,0); query(W,910,1,0);
  learn(W,911,1,4);
  query(W,911,1,4); query(W,911,1,4); query(W,911,1,4);
  learn(W,912,1,2);
  query(W,912,1,2); query(W,912,1,2); query(W,912,1,2);
  // Pressure wave: 20 unproven newcomers (importance 1).
  let v:i32=600;
  while(v<620){ learn(W,v,99,v); v=v+1; }
  // Delayed probes after the wave.
  let c11:i32=0;
  if(query(W,910,1,0)==0){ c11=c11+1; }
  if(query(W,911,1,4)==4){ c11=c11+1; }
  if(query(W,912,1,2)==2){ c11=c11+1; }
  emit("P11_CAUSAL ");
  emit(i32s(c11));
  emit("/3\n");
  let f11:i32=found_probe(W,8,180);
  emit("P11_FOUNDATION ");
  emit(i32s(f11));
  emit("/8\n");
  let cc11:i32=0;
  if(query(W,2,10,8)==8){ cc11=cc11+1; }
  if(query(W,5,11,180)==180){ cc11=cc11+1; }
  emit("P11_CORR ");
  emit(i32s(cc11));
  emit("/2\n");
  emit_stage_hash(W,11);
  emit("=== INTEGRATION COMPLETE ===\n");
  return;
}
// ============ END LEGACY EVIDENCE DRIVER ============

// ============ STAGE 0 WORLD INTERFACE (I/O plumbing, NOT cognition) ============
// Task-agnostic event stream driver, added 2026-09-30 for the CORE FREEZE
// CHALLENGE (protocol at 66e3c3f38, FREEZE_PROTOCOL.md section 3.1).
//
// This section is I/O plumbing only. It adds NO semantic cases, NO modes,
// NO handlers, and NO cognitive machinery. Every line of cognitive code
// above this marker is byte-identical to dc20745db (verified by fn-body
// diff, see STAGE0_RESULT.md). Events are routed into the existing
// cognitive drivers learn() and query() and nothing else.
//
// World file format (text, one event per line, integer ids only):
//   OBSERVE <subj> <rel> <obj>     -> learn(W, subj, rel, obj); emits OBSERVED
//   QUERY <subj> <rel> <expected>  -> v=query(W, subj, rel, expected); emits ANSWER
//   ACT                           -> emits CHOICE 0 (documented placeholder)
// Blank lines are ignored. Any other line is a parse error (exit 1,
// state file untouched).
//
// ACT is a placeholder by explicit design: the current substrate has no
// generic action-selection machinery, so the driver emits the fixed
// default choice. Inventing selection semantics here would be cognitive
// machinery; a hardcoded default is plumbing. W6/W7 are predicted to
// expose this boundary (protocol section 8.4, 8.6).
//
// Invocation: world_learn_bin <world.txt> <state.bin>
//   state.bin, when present and exactly 32768 bytes, is loaded as the
//   persistent learner state; otherwise a fresh zero state is initialized.
//   After the event stream the 32768-byte state is written back to
//   state.bin. Only the 32768 declared bytes ever reach the state file.

fn is_observe(d:[]u8, s:i32)i32 {
  if(d[s]==79 && d[s+1]==66 && d[s+2]==83 && d[s+3]==69 && d[s+4]==82 && d[s+5]==86 && d[s+6]==69){ return 1; }
  return 0;
}
fn is_query(d:[]u8, s:i32)i32 {
  if(d[s]==81 && d[s+1]==85 && d[s+2]==69 && d[s+3]==82 && d[s+4]==89){ return 1; }
  return 0;
}
fn is_act(d:[]u8, s:i32)i32 {
  if(d[s]==65 && d[s+1]==67 && d[s+2]==84){ return 1; }
  return 0;
}
fn line_end(d:[]u8, s:i32, n:i32)i32 {
  let i:i32=s;
  while(i<n){ if(d[i]==10){ return i; } i=i+1; }
  return n;
}
fn skip_ws(d:[]u8, s:i32, e:i32)i32 {
  while(s<e){ if(d[s]!=32 && d[s]!=9){ return s; } s=s+1; }
  return e;
}
fn field_end(d:[]u8, s:i32, e:i32)i32 {
  while(s<e){ if(d[s]==32 || d[s]==9){ return s; } s=s+1; }
  return e;
}
// 1 if d[s..e) is an optional minus followed by 1+ ASCII digits.
fn is_int(d:[]u8, s:i32, e:i32)i32 {
  if(s>=e){ return 0; }
  if(d[s]==45){ s=s+1; }
  if(s>=e){ return 0; }
  while(s<e){
    let c:i32=d[s] as i32;
    if(c<48 || c>57){ return 0; }
    s=s+1;
  }
  return 1;
}
// Parse a signed decimal integer from d[s..e). Caller guarantees is_int.
fn parse_i32(d:[]u8, s:i32, e:i32)i32 {
  let neg:i32=0;
  if(d[s]==45){ neg=1; s=s+1; }
  let v:i32=0;
  while(s<e){
    v=v*10 + (d[s] as i32) - 48;
    s=s+1;
  }
  if(neg==1){ return 0-v; }
  return v;
}
// Process one line d[ls..le). Returns 0 blank/ignored, 1 OBSERVE,
// 2 QUERY, 3 ACT, -1 parse error.
fn process_line(W:[]u8, d:[]u8, ls:i32, le:i32)i32 {
  let f0s:i32=skip_ws(d,ls,le);
  if(f0s>=le){ return 0; }
  let f0e:i32=field_end(d,f0s,le);
  let wl:i32=f0e-f0s;
  if(wl==7 && is_observe(d,f0s)==1){
    let s1:i32=skip_ws(d,f0e,le);
    let e1:i32=field_end(d,s1,le);
    let s2:i32=skip_ws(d,e1,le);
    let e2:i32=field_end(d,s2,le);
    let s3:i32=skip_ws(d,e2,le);
    let e3:i32=field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){ return -1; }
    if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return -1; }
    if(skip_ws(d,e3,le)<le){ return -1; }
    let subj:i32=parse_i32(d,s1,e1);
    let rel:i32=parse_i32(d,s2,e2);
    let obj:i32=parse_i32(d,s3,e3);
    learn(W,subj,rel,obj);
    emit("OBSERVED ");
    emit(i32s(subj));
    emit(" ");
    emit(i32s(rel));
    emit(" ");
    emit(i32s(obj));
    emit("\n");
    return 1;
  }
  if(wl==5 && is_query(d,f0s)==1){
    let s1:i32=skip_ws(d,f0e,le);
    let e1:i32=field_end(d,s1,le);
    let s2:i32=skip_ws(d,e1,le);
    let e2:i32=field_end(d,s2,le);
    let s3:i32=skip_ws(d,e2,le);
    let e3:i32=field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){ return -1; }
    if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){ return -1; }
    if(skip_ws(d,e3,le)<le){ return -1; }
    let subj:i32=parse_i32(d,s1,e1);
    let rel:i32=parse_i32(d,s2,e2);
    let exp:i32=parse_i32(d,s3,e3);
    let v:i32=query(W,subj,rel,exp);
    emit("ANSWER ");
    emit(i32s(subj));
    emit(" ");
    emit(i32s(rel));
    emit(" ");
    emit(i32s(v));
    emit("\n");
    return 2;
  }
  if(wl==3 && is_act(d,f0s)==1){
    if(skip_ws(d,f0e,le)<le){ return -1; }
    emit("CHOICE 0\n");
    return 3;
  }
  return -1;
}
// Drive the whole event stream. Returns 0 ok, -1 parse error (no save).
fn drive_world(W:[]u8, d:[]u8)i32 {
  let n:i32=_zag_strlen(d);
  let s:i32=0;
  let lineno:i32=0;
  let nev:i32=0;
  let nq:i32=0;
  emit("WORLD_BEGIN\n");
  while(s<n){
    let le:i32=line_end(d,s,n);
    lineno=lineno+1;
    let rc:i32=process_line(W,d,s,le);
    if(rc==-1){
      emit("ERROR line ");
      emit(i32s(lineno));
      emit("\n");
      return -1;
    }
    if(rc>0){ nev=nev+1; }
    if(rc==2){ nq=nq+1; }
    s=le+1;
  }
  emit("WORLD_END events=");
  emit(i32s(nev));
  emit(" answers=");
  emit(i32s(nq));
  emit("\n");
  return 0;
}
fn errln(s:[]u8)void { _zag_eprintln(s); return; }
fn main()i32 {
  if(_zag_argc()!=3){
    errln("usage: world_learn_bin <world.txt> <state.bin>");
    return 2;
  }
  let world_path:[]u8=_zag_arg(1);
  let state_path:[]u8=_zag_arg(2);
  if(_zag_file_exists(world_path)==0){
    errln("world file missing");
    return 2;
  }
  let W:[]u8=z_alloc(32768);
  if(_zag_file_exists(state_path)==1){
    let sb:[]u8=_zag_read_file(state_path);
    if(_zag_strlen(sb)!=32768){
      errln("state file corrupt: length != 32768");
      return 2;
    }
    let i:i32=0;
    while(i<32768){ W[i]=sb[i]; i=i+1; }
  } else {
    set32(W,0,0);
    set32(W,8,0);
  }
  let d:[]u8=_zag_read_file(world_path);
  if(drive_world(W,d)!=0){
    return 1;
  }
  if(_zag_write_file(state_path,W)!=0){
    errln("state write failed");
    return 1;
  }
  emit("STATE_SAVED\n");
  return 0;
}
// ============ END STAGE 0 WORLD INTERFACE ============

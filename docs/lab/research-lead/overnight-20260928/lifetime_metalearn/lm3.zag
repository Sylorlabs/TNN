// lm3.zag -- LIFETIME-METALEARN-3 (frozen implementation).
// Continuing learner across 17 episodes: retention, interference control,
// positive transfer, meta-learning. Pure Zag, safebin-only.
// Neutral identifiers; learner never sees episode labels.
// Conditions: 0=T continuing+partitions, 1=R reset/episode, 2=S shared store.
// G arena layout:
// 0 wstate(8) | 8 gstate(8) | 16 perms(64) | 80 cyc(8) |
// 88 ep_kind(17) | 105 ep_max(68) | 173 ep_fam(17) | 190 ep_qk(17) |
// 207 ep_qoff(68) | 275 streams(4464) |
// 8192 slots(224*12) | 10880 nslots(4) | 10884 pad(192) |
// 11076 npart(4) | 11080 active(4) | 11084 prior(32) | 11116 pad2(8) |
// 11124 epval(68) | 11192 splitsep(68) | 11260 splits(4) | 11264 evict(4) |
// 11268 caphit(4) | 11272 selreg(68) | 11340 genfail(4)
// cond results: 12288 + cond*1024.

fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,st:i32,n:i32)i32 {
  let s:i64=g64(G,st);
  s=(s*1103515245+12345)%2147483648;
  s64(G,st,s);
  // high bits: low bits of this LCG have short period (mod 16 repeats),
  // causing identical query streams (B4 failure). High bits are uniform.
  return (((s>>16)%(n as i64)) as i32);
}
fn genfail_set(G:[]u8)void {
  set32(G,11340,1);
  return;
}
// ---- world generation (frozen) ----
fn gen(G:[]u8)void {
  s64(G,0,20261007);
  let b0:[]u8="0000001111223456";
  let b1:[]u8="1111110000223456";
  let b2:[]u8="0000011112234567";
  let b3:[]u8="0000001111122367";
  let e:i32=0;
  while(e<16){
    G[16+e]=b0[e]; G[32+e]=b1[e]; G[48+e]=b2[e]; G[64+e]=b3[e];
    e=e+1;
  }
  let m:i32=0;
  while(m<4){
    let i2:i32=0;
    while(i2<16){
      let j:i32=i2+rnd(G,0,16-i2);
      let a:u8=G[16+m*16+i2];
      G[16+m*16+i2]=G[16+m*16+j];
      G[16+m*16+j]=a;
      i2=i2+1;
    }
    m=m+1;
  }
  G[80]=3; G[81]=2; G[82]=0; G[83]=1;
  G[84]=2; G[85]=3; G[86]=1; G[87]=0;
  // kind: 0=criterion 1=fixed 2=probe
  let k:[]u8="00102102000122220";
  e=0;
  while(e<17){ G[88+e]=k[e]; e=e+1; }
  e=0;
  while(e<17){
    let mv:i32=200;
    let kk2:i32=(G[88+e] as i32)-48;
    if(kk2==1){ mv=160; }
    if(kk2==2){
      mv=36;
      if(e==4){ mv=24; }
      if(e==12){ mv=24; }
      if(e==7){ mv=16; }
      if(e==13){ mv=16; }
    }
    set32(G,105+e*4,mv);
    e=e+1;
  }
  // fam codes: 0 A1,1 B1,2 C1,3 A2,4 D1,5 B2,6 A3,7 E1,8 A4 (opaque)
  let fm:[]u8="01230451624701248";
  e=0;
  while(e<17){ G[173+e]=fm[e]; e=e+1; }
  // qk codes: 0=W16 3=W4 1=P10 2=P10S (opaque query generators)
  let qk:[]u8="03200133021103210";
  e=0;
  while(e<17){ G[190+e]=qk[e]; e=e+1; }
  let off:i32=275;
  e=0;
  while(e<17){
    set32(G,207+e*4,off);
    let kk:i32=(G[190+e] as i32)-48;
    let nn:i32=get32(G,105+e*4);
    let t:i32=0;
    while(t<nn){
      let q0:i32=0;
      let q1:i32=0;
      if(kk==0){ q0=rnd(G,0,16); }
      if(kk==3){ q0=rnd(G,0,4); }
      if(kk==1){ q0=rnd(G,0,6); q1=rnd(G,0,6); }
      if(kk==2){
        let r0:i32=rnd(G,0,10);
        let r1:i32=rnd(G,0,10);
        if(r0<7){ q0=rnd(G,0,3)*2; } else { q0=rnd(G,0,3)*2+1; }
        if(r1<7){ q1=rnd(G,0,3)*2; } else { q1=rnd(G,0,3)*2+1; }
      }
      G[off+t*2]=q0 as u8;
      G[off+t*2+1]=q1 as u8;
      t=t+1;
    }
    off=off+nn*2;
    e=e+1;
  }
  return;
}
// truth: the world. Learner never calls this except via driver feedback.
fn truth(G:[]u8,fam:i32,q0:i32,q1:i32)i32 {
  if(fam==0){ return (G[16+q0] as i32)-48; }
  if(fam==3){ return (G[32+q0] as i32)-48; }
  if(fam==6){ return (G[48+q0] as i32)-48; }
  if(fam==8){ return (G[64+q0] as i32)-48; }
  if(fam==1){ return G[80+q0] as i32; }
  if(fam==5){ return G[84+q0] as i32; }
  if(fam==2){ return (q0+q1)%2; }
  if(fam==7){ return (q0+q1)%3; }
  if(q0>q1){ return 1; }
  return 0;
}
// ---- learner (no episode labels; see B6) ----
fn lrn_reset(G:[]u8)void {
  set32(G,10880,0);
  set32(G,11076,0);
  set32(G,11080,-1);
  set32(G,11260,0);
  set32(G,11264,0);
  set32(G,11268,0);
  let i:i32=0;
  while(i<8){ set32(G,11084+i*4,1); i=i+1; }
  s64(G,8,777);
  return;
}
fn grnd(G:[]u8,n:i32)i32 {
  return rnd(G,8,n);
}
fn prior_guess(G:[]u8)i32 {
  let best:i32=0;
  let bv:i32=get32(G,11084);
  let i:i32=1;
  while(i<8){
    let v:i32=get32(G,11084+i*4);
    if(v>bv){ bv=v; best=i; }
    i=i+1;
  }
  let nt:i32=0;
  i=0;
  while(i<8){
    if(get32(G,11084+i*4)==bv){ nt=nt+1; }
    i=i+1;
  }
  if(nt<=1){ return best; }
  let pick:i32=grnd(G,nt);
  i=0;
  while(i<8){
    if(get32(G,11084+i*4)==bv){
      if(pick==0){ return i; }
      pick=pick-1;
    }
    i=i+1;
  }
  return best;
}
fn find_slot(G:[]u8,reg:i32,q0:i32,q1:i32)i32 {
  let n:i32=get32(G,10880);
  let i:i32=0;
  while(i<n){
    let b:i32=8192+i*12;
    if(get32(G,b+8)==reg){
      if(G[b]==(q0 as u8)){
        if(G[b+1]==(q1 as u8)){ return i; }
      }
    }
    i=i+1;
  }
  return -1;
}
fn slot_create(G:[]u8,reg:i32,q0:i32,q1:i32,v:i32)void {
  let n:i32=get32(G,10880);
  if(n>=224){
    let bi:i32=0;
    let bs:i32=get32(G,8192+4);
    let i:i32=1;
    while(i<n){
      let s:i32=get32(G,8192+i*12+4);
      if(s<bs){ bs=s; bi=i; }
      i=i+1;
    }
    let b:i32=8192+bi*12;
    G[b]=q0 as u8; G[b+1]=q1 as u8; G[b+2]=v as u8;
    set32(G,b+4,1); set32(G,b+8,reg);
    set32(G,11264,get32(G,11264)+1);
    return;
  }
  let b2:i32=8192+n*12;
  G[b2]=q0 as u8; G[b2+1]=q1 as u8; G[b2+2]=v as u8;
  set32(G,b2+4,1); set32(G,b2+8,reg);
  set32(G,10880,n+1);
  return;
}
fn lrn_guess(G:[]u8,q0:i32,q1:i32)i32 {
  let act:i32=get32(G,11080);
  if(act>=0){
    let f:i32=find_slot(G,act,q0,q1);
    if(f>=0){ return G[8192+f*12+2] as i32; }
  }
  return prior_guess(G);
}
fn reg_new(G:[]u8,ep:i32)i32 {
  let nn:i32=get32(G,11076);
  if(nn>=24){ genfail_set(G); return -1; }
  set32(G,11076,nn+1);
  set32(G,11080,nn);
  set32(G,11272+ep*4,nn);
  return nn;
}
// Partition selection by slot-evidence only: a partition qualifies if it has
// >=3 slot hits on the 6 orientation trials with >=80% correct.
// Select max correct (tie: lowest index); else allocate new partition.
// Uses only observed (query, answer) pairs. No labels.
fn lrn_select(G:[]u8,cond:i32,ep:i32,fam:i32,qoff:i32)void {
  if(cond==2){ set32(G,11080,0); set32(G,11272+ep*4,0); return; }
  let nr:i32=get32(G,11076);
  let best_c:i32=-1;
  let best_r:i32=-1;
  let r:i32=0;
  while(r<nr){
    let hits:i32=0;
    let corr:i32=0;
    let t:i32=0;
    while(t<6){
      let q0:i32=G[qoff+t*2] as i32;
      let q1:i32=G[qoff+t*2+1] as i32;
      let f:i32=find_slot(G,r,q0,q1);
      if(f>=0){
        hits=hits+1;
        if((G[8192+f*12+2] as i32)==truth(G,fam,q0,q1)){ corr=corr+1; }
      }
      t=t+1;
    }
    let okcand:i32=0;
    if(hits>=3){ if(corr*5>=hits*4){ okcand=1; } }
    if(okcand==1){
      if(corr>best_c){ best_c=corr; best_r=r; }
    }
    r=r+1;
  }
  if(best_r>=0){ set32(G,11080,best_r); set32(G,11272+ep*4,best_r); return; }
  reg_new(G,ep);
  return;
}
fn lrn_observe(G:[]u8,q0:i32,q1:i32,g:i32,a:i32,ok:i32,is_orient:i32,do_update:i32,cond:i32,ep:i32)void {
  if(do_update==0){ return; }
  set32(G,11084+a*4,get32(G,11084+a*4)+1);
  if(is_orient==1){ return; }
  let act:i32=get32(G,11080);
  let f:i32=find_slot(G,act,q0,q1);
  if(ok==1){
    if(f>=0){
      let b:i32=8192+f*12;
      set32(G,b+4,get32(G,b+4)+1);
    }
    else {
      slot_create(G,act,q0,q1,a);
    }
    return;
  }
  if(f>=0){
    if(cond==0){
      let nn:i32=reg_new(G,ep);
      if(nn<0){ return; }
      set32(G,11260,get32(G,11260)+1);
      set32(G,11192+ep*4,get32(G,11192+ep*4)+1);
      slot_create(G,nn,q0,q1,a);
    }
    else {
      let b2:i32=8192+f*12;
      G[b2+2]=a as u8;
      set32(G,b2+4,1);
    }
    return;
  }
  slot_create(G,act,q0,q1,a);
  return;
}
// ---- driver (the world; learner sees only queries and feedback) ----
fn run_episode(G:[]u8,ep:i32,cond:i32)void {
  let kind:i32=(G[88+ep] as i32)-48;
  let mx:i32=get32(G,105+ep*4);
  let fam:i32=(G[173+ep] as i32)-48;
  let qoff:i32=get32(G,207+ep*4);
  if(cond==1){ lrn_reset(G); }
  let t:i32=0;
  while(t<6){
    let q0:i32=G[qoff+t*2] as i32;
    let q1:i32=G[qoff+t*2+1] as i32;
    let g:i32=prior_guess(G);
    let a:i32=truth(G,fam,q0,q1);
    let ok:i32=0;
    if(g==a){ ok=1; }
    lrn_observe(G,q0,q1,g,a,ok,1,1,cond,ep);
    t=t+1;
  }
  if(kind==2){
    lrn_select(G,cond,ep,fam,qoff);
    let corr:i32=0;
    t=6;
    while(t<mx){
      let q0:i32=G[qoff+t*2] as i32;
      let q1:i32=G[qoff+t*2+1] as i32;
      let g:i32=lrn_guess(G,q0,q1);
      let a:i32=truth(G,fam,q0,q1);
      if(g==a){ corr=corr+1; }
      t=t+1;
    }
    set32(G,11124+ep*4,(corr*100)/(mx-6));
    return;
  }
  lrn_select(G,cond,ep,fam,qoff);
  let consec:i32=0;
  let errors:i32=0;
  let etc:i32=0;
  t=6;
  while(t<mx){
    let q0:i32=G[qoff+t*2] as i32;
    let q1:i32=G[qoff+t*2+1] as i32;
    let g:i32=lrn_guess(G,q0,q1);
    let a:i32=truth(G,fam,q0,q1);
    let ok:i32=0;
    if(g==a){ ok=1; consec=consec+1; } else { errors=errors+1; consec=0; }
    lrn_observe(G,q0,q1,g,a,ok,0,1,cond,ep);
    if(kind==0){
      if(etc==0){
        if(consec==8){ etc=t+1; }
      }
      if(etc>0){
        if(t+1>=64){ t=mx; }
      }
    }
    t=t+1;
  }
  if(kind==0){
    if(etc==0){ etc=mx+1; set32(G,11268,get32(G,11268)+1); }
    set32(G,11124+ep*4,etc);
  }
  else {
    set32(G,11124+ep*4,errors);
  }
  return;
}
fn run_cond(G:[]u8,cond:i32)void {
  lrn_reset(G);
  let ep:i32=0;
  while(ep<17){
    run_episode(G,ep,cond);
    ep=ep+1;
  }
  let dst:i32=12288+cond*1024;
  let i:i32=0;
  while(i<288){
    G[dst+i]=G[11124+i];
    i=i+1;
  }
  return;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
fn main()i32 {
  let p:*u8=_zag_malloc(65536) as *u8;
  let G:[]u8=p[0..65536];
  let z:i32=0;
  while(z<65536){ G[z]=0; z=z+1; }
  gen(G);
  run_cond(G,0);
  run_cond(G,1);
  run_cond(G,2);
  let q:*u8=_zag_malloc(16384) as *u8;
  let B:[]u8=q[0..16384];
  let c:i32=0;
  c=o_app(B,c,"LM3 W=20261007 K=8 OR=6 MIN=64 CAP=224"); c=o_nl(B,c);
  // B4: hidden-param distinctness
  let d12:i32=0; let d13:i32=0; let d14:i32=0; let d23:i32=0; let d24:i32=0; let d34:i32=0;
  let i:i32=0;
  while(i<16){
    if(G[16+i]!=G[32+i]){ d12=d12+1; }
    if(G[16+i]!=G[48+i]){ d13=d13+1; }
    if(G[16+i]!=G[64+i]){ d14=d14+1; }
    if(G[32+i]!=G[48+i]){ d23=d23+1; }
    if(G[32+i]!=G[64+i]){ d24=d24+1; }
    if(G[48+i]!=G[64+i]){ d34=d34+1; }
    i=i+1;
  }
  let dc:i32=0;
  i=0;
  while(i<4){ if(G[80+i]!=G[84+i]){ dc=dc+1; } i=i+1; }
  // query streams pairwise distinct (17 streams)
  let ds:i32=1;
  let v1:i32=0;
  while(v1<17){
    let w1:i32=v1+1;
    while(w1<17){
      let o1:i32=get32(G,207+v1*4);
      let o2:i32=get32(G,207+w1*4);
      let n1:i32=get32(G,105+v1*4);
      let n2:i32=get32(G,105+w1*4);
      if(n1==n2){
        if(veq(G,o1,o2,n1*2)==1){ ds=0; }
      }
      w1=w1+1;
    }
    v1=v1+1;
  }
  let b4:i32=0;
  if(d12>=10){ if(d13>=10){ if(d14>=10){ if(d23>=10){ if(d24>=10){ if(d34>=10){
    if(dc>=3){ if(ds==1){ b4=1; } }
  } } } } } }
  c=o_app(B,c,"DIFF="); c=o_i64(B,c,d12 as i64); c=o_app(B,c,",");
  c=o_i64(B,c,d13 as i64); c=o_app(B,c,","); c=o_i64(B,c,d14 as i64);
  c=o_app(B,c,","); c=o_i64(B,c,d23 as i64); c=o_app(B,c,",");
  c=o_i64(B,c,d24 as i64); c=o_app(B,c,","); c=o_i64(B,c,d34 as i64);
  c=o_app(B,c," DC="); c=o_i64(B,c,dc as i64);
  c=o_app(B,c," DS="); c=o_i64(B,c,ds as i64); c=o_nl(B,c);
  let ep:i32=0;
  while(ep<17){
    c=o_app(B,c,"E");
    if(ep<9){ c=o_app(B,c,"0"); }
    c=o_i64(B,c,(ep+1) as i64);
    c=o_app(B,c," T="); c=o_i64(B,c,get32(G,12288+ep*4) as i64);
    c=o_app(B,c," R="); c=o_i64(B,c,get32(G,13312+ep*4) as i64);
    c=o_app(B,c," S="); c=o_i64(B,c,get32(G,14336+ep*4) as i64);
    c=o_nl(B,c);
    ep=ep+1;
  }
  // bars
  let t5:i32=get32(G,12288+4*4); let s5:i32=get32(G,14336+4*4);
  let t8:i32=get32(G,12288+7*4); let s8:i32=get32(G,14336+7*4);
  let t13:i32=get32(G,12288+12*4); let t14:i32=get32(G,12288+13*4);
  let t15:i32=get32(G,12288+14*4); let t16:i32=get32(G,12288+15*4);
  let e10:i32=get32(G,12288+9*4); let e11:i32=get32(G,12288+10*4);
  let e3:i32=get32(G,12288+2*4); let e6:i32=get32(G,12288+5*4);
  let e12:i32=get32(G,12288+11*4);
  let b5a:i32=0;
  if(t5>=85){ if(t8>=85){ if((t13+t14+t15+t16)>=340){ b5a=1; } } }
  let b5b:i32=0;
  if(t5-s5>=40){ if(t8-s8>=40){ b5b=1; } }
  let b5c:i32=0;
  if(e10<=25){ if(e11<=25){ b5c=1; } }
  let b5d:i32=0;
  if(e3-e12>=8){ b5d=1; }
  let b5e:i32=0;
  if(e6<=e3){ b5e=1; }
  // B5f apparatus
  let mxetc:i32=0;
  let cci:i32=0;
  while(cci<3){
    let bs:i32=12288+cci*1024;
    if(get32(G,bs+144)>0){ mxetc=1; }
    if(get32(G,bs+140)>0){ mxetc=1; }
    if(get32(G,bs+216)>0){ mxetc=1; }
    cci=cci+1;
  }
  // also check no etc exceeded 200 on criterion episodes
  let ck:[]u8="00102102000122220";
  ep=0;
  while(ep<17){
    if(((ck[ep] as i32)-48)==0){
      cci=0;
      while(cci<3){
        if(get32(G,12288+cci*1024+ep*4)>200){ mxetc=1; }
        cci=cci+1;
      }
    }
    ep=ep+1;
  }
  let b5f:i32=0;
  if(mxetc==0){ b5f=1; }
  c=o_app(B,c,"B5A="); c=o_i64(B,c,b5a as i64);
  c=o_app(B,c," B5B="); c=o_i64(B,c,b5b as i64);
  c=o_app(B,c," B5C="); c=o_i64(B,c,b5c as i64);
  c=o_app(B,c," B5D="); c=o_i64(B,c,b5d as i64);
  c=o_app(B,c," B5E="); c=o_i64(B,c,b5e as i64);
  c=o_app(B,c," B5F="); c=o_i64(B,c,b5f as i64);
  c=o_app(B,c," B4="); c=o_i64(B,c,b4 as i64);
  c=o_nl(B,c);
  let cc2:i32=0;
  while(cc2<3){
    let bs2:i32=12288+cc2*1024;
    c=o_app(B,c,"C"); c=o_i64(B,c,cc2 as i64);
    c=o_app(B,c," splits="); c=o_i64(B,c,get32(G,bs2+136) as i64);
    c=o_app(B,c," evict="); c=o_i64(B,c,get32(G,bs2+140) as i64);
    c=o_app(B,c," caphit="); c=o_i64(B,c,get32(G,bs2+144) as i64);
    c=o_app(B,c," genfail="); c=o_i64(B,c,get32(G,bs2+216) as i64);
    c=o_nl(B,c);
    cc2=cc2+1;
  }
  o_flush(B,c);
  return 0;
}

// adv.zag -- L3-RX sealed world generator (adversary).
// Runs ONLY after the learner freeze (CODEFREEZE). Frozen seed 20261003.
// Writes 11 worlds + CERT.txt + sealed oracle.txt per world.
// argv: 1=outdir
// World truth: query (c,x,y) -> d = 1 iff pos[x] < pos[y] in the active
// id sequence (O1 when c=c1 else O2 for gated worlds; single seq otherwise).
// All identifiers are opaque u8 values; slot positions never permuted.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  let neg:i32=0;
  let u:i64=v as i64;
  if(v<0){ neg=1; u=0-(v as i64); }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn write_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_w(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn pjoin(dir:[]u8,name:[]u8,out:[]u8)i32 {
  let c:i32=e1str(out,0,dir);
  c=e1str(out,c,"/");
  c=e1str(out,c,name);
  return c;
}
// ---- LCG (Park-Miller) ----
fn rnd_next(st:[]u8) i64 {
  let s:i64=ig(st,0) as i64;
  s=(s*48271)%2147483647;
  put32(st,0,s as i32);
  return s;
}
fn rndn(st:[]u8,n:i32) i32 {
  return (rnd_next(st)%(n as i64)) as i32;
}
fn shuffle(st:[]u8,a:[]u8,n:i32) void {
  let i:i32=n-1;
  while(i>0){
    let j:i32=rndn(st,i+1);
    let t:i32=ig(a,i*4);
    put32(a,i*4,ig(a,j*4));
    put32(a,j*4,t);
    i=i-1;
  }
  return;
}
// position of id v in seq s (n ids). -1 if absent.
fn pos_of(s:[]u8,n:i32,v:i32) i32 {
  let i:i32=0;
  while(i<n){ if(ig(s,i*4)==v){ return i; } i=i+1; }
  return -1;
}
// D pairs: ids (x,y), x<y numeric, with O1/O2 disagreeing. dpairs: 2*i32 each.
fn dpairs_of(o1:[]u8,o2:[]u8,ids:[]u8,n:i32,dp:[]u8) i32 {
  let nd:i32=0;
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      let x:i32=ig(ids,i*4); let y:i32=ig(ids,j*4);
      let d1:i32=0; let d2:i32=0;
      if(pos_of(o1,n,x)<pos_of(o1,n,y)){ d1=1; }
      if(pos_of(o2,n,x)<pos_of(o2,n,y)){ d2=1; }
      if(d1!=d2){ put32(dp,nd*8,x); put32(dp,nd*8+4,y); nd=nd+1; }
      j=j+1;
    }
    i=i+1;
  }
  return nd;
}
// emit one gated world. returns |D|.
fn emit_gated(st:[]u8,wdir:[]u8,ids:[]u8,c1v:i32,c2v:i32,o1:[]u8,o2:[]u8,dp:[]u8,ndp:i32,cert_extra:[]u8) i32 {
  let n:i32=8;
  // oracle: all 112 triples
  let O:[]u8=z_alloc(8192);
  let c:i32=0;
  let H:[]u8=z_alloc(8192); // heldout pool marker not needed; choose below
  let ci:i32=0;
  // choose 3 D-pairs x 2 contexts as heldout (frozen rule)
  let hp:[]u8=z_alloc(3*4);
  let used:[]u8=z_alloc(64*4);
  let h3:i32=0;
  while(h3<3){
    let k:i32=rndn(st,ndp);
    if(ig(used,k*4)==0){
      put32(used,k*4,1);
      put32(hp,h3*4,k);
      h3=h3+1;
    }
  }
  let T:[]u8=z_alloc(16384);
  let tc:i32=0;
  let H2:[]u8=z_alloc(2048);
  let hc:i32=0;
  let s0i:i32=0;
  while(s0i<2){
    let cv:i32=c1v;
    if(s0i==1){ cv=c2v; }
    let i:i32=0;
    while(i<n){
      let j:i32=0;
      while(j<n){
        if(j!=i){
          let x:i32=ig(ids,i*4); let y:i32=ig(ids,j*4);
          let d:i32=0;
          if(s0i==0){ if(pos_of(o1,n,x)<pos_of(o1,n,y)){ d=1; } }
          if(s0i==1){ if(pos_of(o2,n,x)<pos_of(o2,n,y)){ d=1; } }
          // oracle line
          c=e1str(O,c,"t ");
          c=e1i32(O,c,cv); c=e1str(O,c," ");
          c=e1i32(O,c,x); c=e1str(O,c," ");
          c=e1i32(O,c,y); c=e1str(O,c," ");
          c=e1i32(O,c,d); O[c]=10; c=c+1;
          // heldout: exactly (cv,px,py) for chosen D-pairs (px<py stored
          // in dp); 3 pairs x 2 contexts = 6 triples (frozen rule).
          let is_h:i32=0;
          let q2:i32=0;
          while(q2<3){
            let pk:i32=ig(hp,q2*4);
            let px:i32=ig(dp,pk*8); let py:i32=ig(dp,pk*8+4);
            if(x==px && y==py){ is_h=1; }
            q2=q2+1;
          }
          if(is_h==1){
            hc=e1str(H2,hc,"h ");
            hc=e1i32(H2,hc,cv); hc=e1str(H2,hc," ");
            hc=e1i32(H2,hc,x); hc=e1str(H2,hc," ");
            hc=e1i32(H2,hc,y); hc=e1str(H2,hc," ");
            hc=e1i32(H2,hc,d); H2[hc]=10; hc=hc+1;
          }
          if(is_h==0){
            tc=e1str(T,tc,"o ");
            tc=e1i32(T,tc,cv); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,x); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,y); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,d); T[tc]=10; tc=tc+1;
          }
        }
        j=j+1;
      }
      i=i+1;
    }
    s0i=s0i+1;
  }
  let p:[]u8=z_alloc(1024);
  let pl:i32=pjoin(wdir,"oracle.txt",p);
  write_file(p[0..pl],O[0..c]);
  pl=pjoin(wdir,"train.txt",p);
  write_file(p[0..pl],T[0..tc]);
  pl=pjoin(wdir,"heldout.txt",p);
  write_file(p[0..pl],H2[0..hc]);
  // CERT
  let C:[]u8=z_alloc(4096);
  let cc:i32=e1str(C,0,"CERT insufficiency gated\nDsize ");
  cc=e1i32(C,cc,ndp);
  cc=e1str(C,cc,"\ncap 10\nDpairs");
  let q3:i32=0;
  while(q3<ndp){
    cc=e1str(C,cc," ");
    cc=e1i32(C,cc,ig(dp,q3*8));
    cc=e1str(C,cc,",");
    cc=e1i32(C,cc,ig(dp,q3*8+4));
    q3=q3+1;
  }
  cc=e1str(C,cc,"\nheldout_Dpairs");
  q3=0;
  while(q3<3){
    let pk2:i32=ig(hp,q3*4);
    cc=e1str(C,cc," ");
    cc=e1i32(C,cc,ig(dp,pk2*8));
    cc=e1str(C,cc,",");
    cc=e1i32(C,cc,ig(dp,pk2*8+4));
    q3=q3+1;
  }
  cc=e1str(C,cc,"\n");
  cc=e1str(C,cc,cert_extra);
  pl=pjoin(wdir,"CERT.txt",p);
  write_file(p[0..pl],C[0..cc]);
  return ndp;
}
fn main() i32 {
  let outdir:[]u8=_zag_arg(1);
  let st:[]u8=z_alloc(4);
  put32(st,0,20261003);
  let IDPOOL:[]u8=z_alloc(8*4);
  put32(IDPOOL,0,13); put32(IDPOOL,4,29); put32(IDPOOL,8,44); put32(IDPOOL,12,58);
  put32(IDPOOL,16,66); put32(IDPOOL,20,77); put32(IDPOOL,24,82); put32(IDPOOL,28,95);
  let CPOOL:[]u8=z_alloc(7*4);
  put32(CPOOL,0,7); put32(CPOOL,4,19); put32(CPOOL,8,31); put32(CPOOL,12,43);
  put32(CPOOL,16,59); put32(CPOOL,20,73); put32(CPOOL,24,88);
  // manifest
  let M:[]u8=z_alloc(1024);
  let mc:i32=0;
  // ---- F1: 4 gated worlds ----
  let f1o1:[]u8=z_alloc(4*8*4); // keep W1,W2 params for F4/F5
  let f1o2:[]u8=z_alloc(4*8*4);
  let f1ids:[]u8=z_alloc(4*8*4);
  let f1c:[]u8=z_alloc(4*2*4);
  let w:i32=0;
  while(w<4){
    let ids:[]u8=z_alloc(8*4);
    let i:i32=0;
    while(i<8){ put32(ids,i*4,ig(IDPOOL,i*4)); i=i+1; }
    shuffle(st,ids,8);
    let ci:[]u8=z_alloc(7*4);
    i=0;
    while(i<7){ put32(ci,i*4,ig(CPOOL,i*4)); i=i+1; }
    shuffle(st,ci,7);
    let c1v:i32=ig(ci,0); let c2v:i32=ig(ci,4);
    let o1:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(o1,i*4,ig(ids,i*4)); i=i+1; }
    shuffle(st,o1,8);
    // o2: reverse a contiguous block of length 4 or 5 -> |D| in {6,10}
    let o2:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(o2,i*4,ig(o1,i*4)); i=i+1; }
    let bl:i32=4;
    if(rndn(st,2)==1){ bl=5; }
    let bs:i32=rndn(st,8-bl+1);
    let a2:i32=0;
    while(a2<bl){
      put32(o2,(bs+a2)*4,ig(o1,(bs+bl-1-a2)*4));
      a2=a2+1;
    }
    let dp:[]u8=z_alloc(64*8);
    let ndp:i32=dpairs_of(o1,o2,ids,8,dp);
    let wd:[]u8=z_alloc(1024);
    let wdl:i32=pjoin(outdir,"w_f1_1",wd);
    if(w==1){ wdl=pjoin(outdir,"w_f1_2",wd); }
    if(w==2){ wdl=pjoin(outdir,"w_f1_3",wd); }
    if(w==3){ wdl=pjoin(outdir,"w_f1_4",wd); }
    // mkdir via syscall? use shell-created dirs: assume dirs exist.
    let ce:[]u8=z_alloc(256);
    let cec:i32=e1str(ce,0,"family f1 seed 20261003\n");
    emit_gated(st,wd[0..wdl],ids,c1v,c2v,o1,o2,dp,ndp,ce);
    // stash W1 (w=0), W2 (w=1) params
    if(w==0 || w==1){
      i=0;
      while(i<8){
        put32(f1o1,(w*8+i)*4,ig(o1,i*4));
        put32(f1o2,(w*8+i)*4,ig(o2,i*4));
        put32(f1ids,(w*8+i)*4,ig(ids,i*4));
        i=i+1;
      }
      put32(f1c,(w*2)*4,c1v);
      put32(f1c,(w*2+1)*4,c2v);
    }
    mc=e1str(M,mc,"w_f1_");
    mc=e1i32(M,mc,w+1);
    mc=e1str(M,mc," f1\n");
    w=w+1;
  }
  // ---- F2: 2 probe worlds (E*-kill selected) ----
  w=0;
  while(w<2){
    let ids:[]u8=z_alloc(8*4);
    let i:i32=0;
    while(i<8){ put32(ids,i*4,ig(IDPOOL,i*4)); i=i+1; }
    shuffle(st,ids,8);
    let pad:i32=ig(CPOOL,rndn(st,7));
    let o:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(o,i*4,ig(ids,i*4)); i=i+1; }
    shuffle(st,o,8);
    // 6 gap pairs (unordered, i<j over sorted ids)
    let sids:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(sids,i*4,ig(ids,i*4)); i=i+1; }
    // insertion sort sids
    let x:i32=0;
    while(x<8){
      let y2:i32=x+1;
      while(y2<8){
        if(ig(sids,x*4)>ig(sids,y2*4)){
          let t:i32=ig(sids,x*4);
          put32(sids,x*4,ig(sids,y2*4));
          put32(sids,y2*4,t);
        }
        y2=y2+1;
      }
      x=x+1;
    }
    let gp:[]u8=z_alloc(6*8);
    let ug:[]u8=z_alloc(64*4);
    let ngc:i32=0;
    while(ngc<6){
      let a3:i32=rndn(st,8); let b3:i32=rndn(st,8);
      if(a3!=b3){
        if(a3>b3){ let t2:i32=a3; a3=b3; b3=t2; }
        let key:i32=a3*8+b3;
        if(ig(ug,key*4)==0){
          put32(ug,key*4,1);
          put32(gp,ngc*8,a3); put32(gp,ngc*8+4,b3);
          ngc=ngc+1;
        }
      }
    }
    // sort gap pairs by (a,b)
    x=0;
    while(x<6){
      let y3:i32=x+1;
      while(y3<6){
        let ax:i32=ig(gp,x*8); let bx:i32=ig(gp,x*8+4);
        let ay:i32=ig(gp,y3*8); let by:i32=ig(gp,y3*8+4);
        if(ax*8+bx>ay*8+by){
          put32(gp,x*8,ay); put32(gp,x*8+4,by);
          put32(gp,y3*8,ax); put32(gp,y3*8+4,bx);
        }
        y3=y3+1;
      }
      x=x+1;
    }
    // E*-kill: first gap pair in id sequence must have truth d=1
    // (E* = all-zero mask predicts 0). If not, reverse o.
    let g0a:i32=ig(gp,0); let g0b:i32=ig(gp,4);
    let xa:i32=ig(sids,g0a*4); let xb:i32=ig(sids,g0b*4);
    let d0:i32=0;
    if(pos_of(o,8,xa)<pos_of(o,8,xb)){ d0=1; }
    if(d0==0){
      let tmp:[]u8=z_alloc(8*4);
      i=0;
      while(i<8){ put32(tmp,i*4,ig(o,i*4)); i=i+1; }
      i=0;
      while(i<8){ put32(o,i*4,ig(tmp,(7-i)*4)); i=i+1; }
    }
    // emit
    let wd2:[]u8=z_alloc(1024);
    let wdl2:i32=pjoin(outdir,"w_f2_1",wd2);
    if(w==1){ wdl2=pjoin(outdir,"w_f2_2",wd2); }
    let O:[]u8=z_alloc(8192);
    let oc:i32=0;
    let T:[]u8=z_alloc(16384);
    let tc:i32=0;
    i=0;
    while(i<8){
      let j:i32=0;
      while(j<8){
        if(j!=i){
          let xx:i32=ig(ids,i*4); let yy:i32=ig(ids,j*4);
          let d:i32=0;
          if(pos_of(o,8,xx)<pos_of(o,8,yy)){ d=1; }
          oc=e1str(O,oc,"t ");
          oc=e1i32(O,oc,pad); oc=e1str(O,oc," ");
          oc=e1i32(O,oc,xx); oc=e1str(O,oc," ");
          oc=e1i32(O,oc,yy); oc=e1str(O,oc," ");
          oc=e1i32(O,oc,d); O[oc]=10; oc=oc+1;
          // gap?
          let isg:i32=0;
          let q4:i32=0;
          while(q4<6){
            let ga2:i32=ig(sids,ig(gp,q4*8)*4);
            let gb2:i32=ig(sids,ig(gp,q4*8+4)*4);
            if((xx==ga2 && yy==gb2)||(xx==gb2 && yy==ga2)){ isg=1; }
            q4=q4+1;
          }
          if(isg==0){
            tc=e1str(T,tc,"o ");
            tc=e1i32(T,tc,pad); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,xx); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,yy); tc=e1str(T,tc," ");
            tc=e1i32(T,tc,d); T[tc]=10; tc=tc+1;
          }
        }
        j=j+1;
      }
      i=i+1;
    }
    let p2:[]u8=z_alloc(1024);
    let pl2:i32=pjoin(wd2[0..wdl2],"oracle.txt",p2);
    write_file(p2[0..pl2],O[0..oc]);
    pl2=pjoin(wd2[0..wdl2],"train.txt",p2);
    write_file(p2[0..pl2],T[0..tc]);
    // CERT + gaps file
    let C2:[]u8=z_alloc(2048);
    let cc2:i32=e1str(C2,0,"CERT f2 E-star-kill gaps");
    let q5:i32=0;
    while(q5<6){
      cc2=e1str(C2,cc2," ");
      cc2=e1i32(C2,cc2,ig(sids,ig(gp,q5*8)*4));
      cc2=e1str(C2,cc2,",");
      cc2=e1i32(C2,cc2,ig(sids,ig(gp,q5*8+4)*4));
      q5=q5+1;
    }
    cc2=e1str(C2,cc2,"\nfirst_gap_truth_d1_estar_killed\n");
    pl2=pjoin(wd2[0..wdl2],"CERT.txt",p2);
    write_file(p2[0..pl2],C2[0..cc2]);
    mc=e1str(M,mc,"w_f2_");
    mc=e1i32(M,mc,w+1);
    mc=e1str(M,mc," f2\n");
    w=w+1;
  }
  // ---- F3: 2 fresh gated worlds ----
  w=0;
  while(w<2){
    let ids:[]u8=z_alloc(8*4);
    let i:i32=0;
    while(i<8){ put32(ids,i*4,ig(IDPOOL,i*4)); i=i+1; }
    shuffle(st,ids,8);
    let ci:[]u8=z_alloc(7*4);
    i=0;
    while(i<7){ put32(ci,i*4,ig(CPOOL,i*4)); i=i+1; }
    shuffle(st,ci,7);
    let c1v:i32=ig(ci,0); let c2v:i32=ig(ci,4);
    let o1:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(o1,i*4,ig(ids,i*4)); i=i+1; }
    shuffle(st,o1,8);
    let o2:[]u8=z_alloc(8*4);
    i=0;
    while(i<8){ put32(o2,i*4,ig(o1,i*4)); i=i+1; }
    let bl:i32=4;
    if(rndn(st,2)==1){ bl=5; }
    let bs:i32=rndn(st,8-bl+1);
    let a2:i32=0;
    while(a2<bl){
      put32(o2,(bs+a2)*4,ig(o1,(bs+bl-1-a2)*4));
      a2=a2+1;
    }
    let dp:[]u8=z_alloc(64*8);
    let ndp:i32=dpairs_of(o1,o2,ids,8,dp);
    let wd:[]u8=z_alloc(1024);
    let wdl:i32=pjoin(outdir,"w_f3_1",wd);
    if(w==1){ wdl=pjoin(outdir,"w_f3_2",wd); }
    let ce:[]u8=z_alloc(256);
    let cec:i32=e1str(ce,0,"family f3 seed 20261003\n");
    emit_gated(st,wd[0..wdl],ids,c1v,c2v,o1,o2,dp,ndp,ce);
    mc=e1str(M,mc,"w_f3_");
    mc=e1i32(M,mc,w+1);
    mc=e1str(M,mc," f3\n");
    w=w+1;
  }
  // ---- F4: recode of F1-W1 (id permutation, slot positions fixed) ----
  let f4pi:[]u8=z_alloc(8*4);
  let f4i:i32=0;
  while(f4i<8){ put32(f4pi,f4i*4,f4i); f4i=f4i+1; }
  shuffle(st,f4pi,8);
  let f4nids:[]u8=z_alloc(8*4);
  f4i=0;
  while(f4i<8){ put32(f4nids,f4i*4,ig(IDPOOL,f4i*4)); f4i=f4i+1; }
  shuffle(st,f4nids,8);
  let f4mp:[]u8=z_alloc(256*4);
  f4i=0;
  while(f4i<256){ put32(f4mp,f4i*4,-1); f4i=f4i+1; }
  f4i=0;
  while(f4i<8){
    let f4oldid:i32=ig(f1ids,f4i*4);
    put32(f4mp,f4oldid*4,ig(f4nids,ig(f4pi,f4i*4)*4));
    f4i=f4i+1;
  }
  let f4nc1:i32=ig(CPOOL,rndn(st,7));
  let f4nc2:i32=ig(CPOOL,rndn(st,7));
  while(f4nc2==f4nc1){ f4nc2=ig(CPOOL,rndn(st,7)); }
  let f4mo1:[]u8=z_alloc(8*4);
  let f4mo2:[]u8=z_alloc(8*4);
  let f4mids:[]u8=z_alloc(8*4);
  f4i=0;
  while(f4i<8){
    put32(f4mo1,f4i*4,ig(f4mp,ig(f1o1,f4i*4)*4));
    put32(f4mo2,f4i*4,ig(f4mp,ig(f1o2,f4i*4)*4));
    put32(f4mids,f4i*4,ig(f4mp,ig(f1ids,f4i*4)*4));
    f4i=f4i+1;
  }
  let f4dp:[]u8=z_alloc(64*8);
  let f4ndp:i32=dpairs_of(f4mo1,f4mo2,f4mids,8,f4dp);
  let f4wd:[]u8=z_alloc(1024);
  let f4wdl:i32=pjoin(outdir,"w_f4",f4wd);
  let f4ce:[]u8=z_alloc(256);
  let f4cec:i32=e1str(f4ce,0,"family f4 recode_of w_f1_1\n");
  emit_gated(st,f4wd[0..f4wdl],f4mids,f4nc1,f4nc2,f4mo1,f4mo2,f4dp,f4ndp,f4ce);
  mc=e1str(M,mc,"w_f4 f4\n");
  // ---- F5: F1-W2 O1 with new O2' (|D symdiff D'| >= 4) ----
  let f5ids:[]u8=z_alloc(8*4);
  let f5i:i32=0;
  while(f5i<8){ put32(f5ids,f5i*4,ig(IDPOOL,f5i*4)); f5i=f5i+1; }
  shuffle(st,f5ids,8);
  // map old W2 ids -> new ids (fresh opaque labeling)
  let f5mp2:[]u8=z_alloc(256*4);
  f5i=0;
  while(f5i<256){ put32(f5mp2,f5i*4,-1); f5i=f5i+1; }
  let f5pi2:[]u8=z_alloc(8*4);
  f5i=0;
  while(f5i<8){ put32(f5pi2,f5i*4,f5i); f5i=f5i+1; }
  shuffle(st,f5pi2,8);
  f5i=0;
  while(f5i<8){ put32(f5mp2,ig(f1ids,(8+f5i)*4)*4,ig(f5ids,ig(f5pi2,f5i*4)*4)); f5i=f5i+1; }
  let f5mo1:[]u8=z_alloc(8*4); let f5mids:[]u8=z_alloc(8*4);
  f5i=0;
  while(f5i<8){
    put32(f5mo1,f5i*4,ig(f5mp2,ig(f1o1,(8+f5i)*4)*4));
    put32(f5mids,f5i*4,ig(f5mp2,ig(f1ids,(8+f5i)*4)*4));
    f5i=f5i+1;
  }
  // old D (mapped) for the symdiff check
  let f5olddp:[]u8=z_alloc(64*8);
  let f5mo2old:[]u8=z_alloc(8*4);
  f5i=0;
  while(f5i<8){ put32(f5mo2old,f5i*4,ig(f5mp2,ig(f1o2,(8+f5i)*4)*4)); f5i=f5i+1; }
  let f5nodp:i32=dpairs_of(f5mo1,f5mo2old,f5mids,8,f5olddp);
  // new O2': reverse a block at a different start
  let f5mo2:[]u8=z_alloc(8*4);
  let f5tries:i32=0;
  let f5ok:i32=0;
  while(f5ok==0 && f5tries<20){
    f5i=0;
    while(f5i<8){ put32(f5mo2,f5i*4,ig(f5mo1,f5i*4)); f5i=f5i+1; }
    let f5bl:i32=4;
    if(rndn(st,2)==1){ f5bl=5; }
    let f5bs:i32=rndn(st,8-f5bl+1);
    let f5a2:i32=0;
    while(f5a2<f5bl){
      put32(f5mo2,(f5bs+f5a2)*4,ig(f5mo1,(f5bs+f5bl-1-f5a2)*4));
      f5a2=f5a2+1;
    }
    let f5ndp2:[]u8=z_alloc(64*8);
    let f5n2:i32=dpairs_of(f5mo1,f5mo2,f5mids,8,f5ndp2);
    // symdiff size
    let f5sd:i32=0;
    let f5q6:i32=0;
    while(f5q6<f5n2){
      let f5fnd:i32=0;
      let f5q7:i32=0;
      while(f5q7<f5nodp){
        if(ig(f5ndp2,f5q6*8)==ig(f5olddp,f5q7*8) && ig(f5ndp2,f5q6*8+4)==ig(f5olddp,f5q7*8+4)){ f5fnd=1; }
        f5q7=f5q7+1;
      }
      if(f5fnd==0){ f5sd=f5sd+1; }
      f5q6=f5q6+1;
    }
    f5q6=0;
    while(f5q6<f5nodp){
      let f5fnd2:i32=0;
      let f5q8:i32=0;
      while(f5q8<f5n2){
        if(ig(f5olddp,f5q6*8)==ig(f5ndp2,f5q8*8) && ig(f5olddp,f5q6*8+4)==ig(f5ndp2,f5q8*8+4)){ f5fnd2=1; }
        f5q8=f5q8+1;
      }
      if(f5fnd2==0){ f5sd=f5sd+1; }
      f5q6=f5q6+1;
    }
    if(f5sd>=4){ f5ok=1; }
    f5tries=f5tries+1;
  }
  let f5ci:[]u8=z_alloc(7*4);
  f5i=0;
  while(f5i<7){ put32(f5ci,f5i*4,ig(CPOOL,f5i*4)); f5i=f5i+1; }
  shuffle(st,f5ci,7);
  let f5dp:[]u8=z_alloc(64*8);
  let f5ndp:i32=dpairs_of(f5mo1,f5mo2,f5mids,8,f5dp);
  let f5wd:[]u8=z_alloc(1024);
  let f5wdl:i32=pjoin(outdir,"w_f5",f5wd);
  let f5ce:[]u8=z_alloc(256);
  let f5cec:i32=e1str(f5ce,0,"family f5 regime_change_of w_f1_2\n");
  emit_gated(st,f5wd[0..f5wdl],f5mids,ig(f5ci,0),ig(f5ci,4),f5mo1,f5mo2,f5dp,f5ndp,f5ce);
  mc=e1str(M,mc,"w_f5 f5\n");
  // ---- F6: plain seq, constant s0 ----
    let f6ids:[]u8=z_alloc(8*4);
    let f6i:i32=0;
    while(f6i<8){ put32(f6ids,f6i*4,ig(IDPOOL,f6i*4)); f6i=f6i+1; }
    shuffle(st,f6ids,8);
    let f6o:[]u8=z_alloc(8*4);
    f6i=0;
    while(f6i<8){ put32(f6o,f6i*4,ig(f6ids,f6i*4)); f6i=f6i+1; }
    shuffle(st,f6o,8);
    let f6pad:i32=ig(CPOOL,rndn(st,7));
    let f6wd:[]u8=z_alloc(1024);
    let f6wdl:i32=pjoin(outdir,"w_f6",f6wd);
    let f6O:[]u8=z_alloc(8192);
    let f6oc:i32=0;
    let f6T:[]u8=z_alloc(16384);
    let f6tc:i32=0;
    let f6H2:[]u8=z_alloc(2048);
    let f6hc:i32=0;
    // heldout: 6 random ordered pairs (one direction each; reverse stays in train)
    let f6hp2:[]u8=z_alloc(6*8);
    let f6ug2:[]u8=z_alloc(64*4);
    let f6hcnt:i32=0;
    while(f6hcnt<6){
      let f6a4:i32=rndn(st,8); let f6b4:i32=rndn(st,8);
      if(f6a4!=f6b4){
        let f6k1:i32=f6a4*8+f6b4;
        let f6k2:i32=f6b4*8+f6a4;
        if(ig(f6ug2,f6k1*4)==0 && ig(f6ug2,f6k2*4)==0){
          put32(f6ug2,f6k1*4,1);
          put32(f6ug2,f6k2*4,1);
          put32(f6hp2,f6hcnt*8,ig(f6ids,f6a4*4));
          put32(f6hp2,f6hcnt*8+4,ig(f6ids,f6b4*4));
          f6hcnt=f6hcnt+1;
        }
      }
    }
    f6i=0;
    while(f6i<8){
      let f6j:i32=0;
      while(f6j<8){
        if(f6j!=f6i){
          let f6x:i32=ig(f6ids,f6i*4); let f6y:i32=ig(f6ids,f6j*4);
          let f6d:i32=0;
          if(pos_of(f6o,8,f6x)<pos_of(f6o,8,f6y)){ f6d=1; }
          f6oc=e1str(f6O,f6oc,"o ");
          f6oc=e1i32(f6O,f6oc,f6pad); f6oc=e1str(f6O,f6oc," ");
          f6oc=e1i32(f6O,f6oc,f6x); f6oc=e1str(f6O,f6oc," ");
          f6oc=e1i32(f6O,f6oc,f6y); f6oc=e1str(f6O,f6oc," ");
          f6oc=e1i32(f6O,f6oc,f6d); f6O[f6oc]=10; f6oc=f6oc+1;
          let f6is_h:i32=0;
          let f6q9:i32=0;
          while(f6q9<6){
            let f6px:i32=ig(f6hp2,f6q9*8); let f6py:i32=ig(f6hp2,f6q9*8+4);
            if(f6x==f6px && f6y==f6py){ f6is_h=1; }
            f6q9=f6q9+1;
          }
          if(f6is_h==1){
            f6hc=e1str(f6H2,f6hc,"h ");
            f6hc=e1i32(f6H2,f6hc,f6pad); f6hc=e1str(f6H2,f6hc," ");
            f6hc=e1i32(f6H2,f6hc,f6x); f6hc=e1str(f6H2,f6hc," ");
            f6hc=e1i32(f6H2,f6hc,f6y); f6hc=e1str(f6H2,f6hc," ");
            f6hc=e1i32(f6H2,f6hc,f6d); f6H2[f6hc]=10; f6hc=f6hc+1;
          }
          if(f6is_h==0){
            f6tc=e1str(f6T,f6tc,"o ");
            f6tc=e1i32(f6T,f6tc,f6pad); f6tc=e1str(f6T,f6tc," ");
            f6tc=e1i32(f6T,f6tc,f6x); f6tc=e1str(f6T,f6tc," ");
            f6tc=e1i32(f6T,f6tc,f6y); f6tc=e1str(f6T,f6tc," ");
            f6tc=e1i32(f6T,f6tc,f6d); f6T[f6tc]=10; f6tc=f6tc+1;
          }
        }
        f6j=f6j+1;
      }
      f6i=f6i+1;
    }
    let f6p3:[]u8=z_alloc(1024);
    let f6pl3:i32=pjoin(f6wd[0..f6wdl],"oracle.txt",f6p3);
    write_file(f6p3[0..f6pl3],f6O[0..f6oc]);
    f6pl3=pjoin(f6wd[0..f6wdl],"train.txt",f6p3);
    write_file(f6p3[0..f6pl3],f6T[0..f6tc]);
    f6pl3=pjoin(f6wd[0..f6wdl],"heldout.txt",f6p3);
    write_file(f6p3[0..f6pl3],f6H2[0..f6hc]);
    let f6C3:[]u8=z_alloc(1024);
    let f6cc3:i32=e1str(f6C3,0,"CERT f6 plain_seq no_gating\n");
    f6pl3=pjoin(f6wd[0..f6wdl],"CERT.txt",f6p3);
    write_file(f6p3[0..f6pl3],f6C3[0..f6cc3]);
    mc=e1str(M,mc,"w_f6 f6\n");
  let mp:[]u8=z_alloc(1024);
  let mpl:i32=pjoin(outdir,"worlds.txt",mp);
  write_file(mp[0..mpl],M[0..mc]);
  return 0;
}
// answer.zag -- TEST channel: answers probe requests from the sealed oracle.
// ONLY this program opens oracle.txt. argv: 1=oracle 2=req 3=ans 4=proto
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  let neg:i32=0;
  let u:i64=v as i64;
  if(v<0){ neg=1; u=0-(v as i64); }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fopen_a(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),1089,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn append_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_a(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==9){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  put32(ov,0,v);
  return i;
}
fn gettok(b:[]u8,s:i32,e:i32,t:i32,out:[]u8)i32 {
  let i:i32=s;
  let cur:i32=0;
  while(i<e){
    while(i<e && (b[i]==32 || b[i]==9)){ i=i+1; }
    if(i>=e){ break; }
    let s2:i32=i;
    while(i<e && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    if(cur==t){
      let k:i32=0;
      while(s2+k<i){ out[k]=b[s2+k]; k=k+1; }
      return i-s2;
    }
    cur=cur+1;
  }
  return 0;
}
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  if(n>0 && nl<cap){ put32(ls,0,0); nl=1; at=0; }
  while(at<n && nl<cap){
    if(b[at]==10){
      if(at+1<n){ put32(ls,nl*4,at+1); nl=nl+1; }
    }
    at=at+1;
  }
  return nl;
}
fn line_end(b:[]u8,s:i32,e:i32)i32 {
  let x:i32=e;
  while(x>s && (b[x-1]==10 || b[x-1]==13)){ x=x-1; }
  return x;
}
// oracle lookup: exact (s0,s1,s2) -> d, -1 if missing.
fn oracle_get(ob:[]u8,on:i32,ls:[]u8,nl:i32,s0:i32,s1:i32,s2:i32) i32 {
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=on;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(ob,s,e);
    let t0:i32=gettok(ob,s,e,0,tok);
    if(t0==1 && tok[0]==116){ // 't'
      let l1:i32=gettok(ob,s,e,1,tok); p_int(tok,0,l1,ov); let a0:i32=ig(ov,0);
      let l2:i32=gettok(ob,s,e,2,tok); p_int(tok,0,l2,ov); let a1:i32=ig(ov,0);
      let l3:i32=gettok(ob,s,e,3,tok); p_int(tok,0,l3,ov); let a2:i32=ig(ov,0);
      if(a0==s0 && a1==s1 && a2==s2){
        let l4:i32=gettok(ob,s,e,4,tok); p_int(tok,0,l4,ov);
        return ig(ov,0);
      }
    }
    li=li+1;
  }
  return -1;
}
fn main() i32 {
  let oracle:[]u8=_zag_arg(1);
  let reqp:[]u8=_zag_arg(2);
  let ansp:[]u8=_zag_arg(3);
  let protop:[]u8=_zag_arg(4);
  let ob:[]u8=read_file(oracle);
  let on:i32=ob.len;
  let ols:[]u8=z_alloc(2048*4);
  let onl:i32=split_lines(ob,on,ols,2048);
  let rb:[]u8=read_file(reqp);
  let rn:i32=rb.len;
  let rls:[]u8=z_alloc(256*4);
  let rnl:i32=split_lines(rb,rn,rls,256);
  let ab:[]u8=read_file(ansp);
  let an:i32=ab.len;
  let als:[]u8=z_alloc(1024*4);
  let anl:i32=split_lines(ab,an,als,1024);
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<rnl){
    let s:i32=ig(rls,li*4);
    let e:i32=rn;
    if(li+1<rnl){ e=ig(rls,(li+1)*4); }
    e=line_end(rb,s,e);
    let t0:i32=gettok(rb,s,e,0,tok);
    if(t0==1 && tok[0]==113){ // 'q'
      let l1:i32=gettok(rb,s,e,1,tok); p_int(tok,0,l1,ov); let s0:i32=ig(ov,0);
      let l2:i32=gettok(rb,s,e,2,tok); p_int(tok,0,l2,ov); let s1:i32=ig(ov,0);
      let l3:i32=gettok(rb,s,e,3,tok); p_int(tok,0,l3,ov); let s2:i32=ig(ov,0);
      // already answered?
      let dup:i32=0;
      let aj:i32=0;
      while(aj<anl){
        let as2:i32=ig(als,aj*4);
        let ae:i32=an;
        if(aj+1<anl){ ae=ig(als,(aj+1)*4); }
        ae=line_end(ab,as2,ae);
        let u0:i32=gettok(ab,as2,ae,0,tok);
        if(u0==1 && tok[0]==97){
          let w1:i32=gettok(ab,as2,ae,1,tok); p_int(tok,0,w1,ov); let b0:i32=ig(ov,0);
          let w2:i32=gettok(ab,as2,ae,2,tok); p_int(tok,0,w2,ov); let b1:i32=ig(ov,0);
          let w3:i32=gettok(ab,as2,ae,3,tok); p_int(tok,0,w3,ov); let b2:i32=ig(ov,0);
          if(b0==s0 && b1==s1 && b2==s2){ dup=1; }
        }
        aj=aj+1;
      }
      if(dup==0){
        let d:i32=oracle_get(ob,on,ols,onl,s0,s1,s2);
        let O:[]u8=z_alloc(64);
        let c:i32=e1str(O,0,"a ");
        c=e1i32(O,c,s0); c=e1str(O,c," ");
        c=e1i32(O,c,s1); c=e1str(O,c," ");
        c=e1i32(O,c,s2); c=e1str(O,c," ");
        c=e1i32(O,c,d); O[c]=10; c=c+1;
        append_file(ansp,O[0..c]);
        let P:[]u8=z_alloc(96);
        let pc:i32=e1str(P,0,"Q ");
        pc=e1i32(P,pc,s0); pc=e1str(P,pc," ");
        pc=e1i32(P,pc,s1); pc=e1str(P,pc," ");
        pc=e1i32(P,pc,s2); pc=e1str(P,pc," -> ");
        pc=e1i32(P,pc,d); P[pc]=10; pc=pc+1;
        append_file(protop,P[0..pc]);
      }
    }
    li=li+1;
  }
  return 0;
}
// audit.zag -- trace audit (PREREG section 13). Pure Zag.
// Built as pre.zag + audit.zag. argv: 1=rundir (trace.txt).
// stdout: AUDIT lines, one per check per world + global checks.
// EV vocabulary (emitted by rx): WORLD OBSERVE CONFLICT CERTIFICATE
// TESTQ PROBE_REQ PROBE_STATE FORM_EXPAND FORM_REUSE FORM_STORED
// PROJECT_KEEP PROJECT_DROP COMMIT DEFER

fn a_emit(s:[]u8) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(s) as i64),(s.len as i64),0,0,0);
  return;
}
// parse "SEQ <s> EV <ev>" + rest tokens. Fills ev_out (64B) with ev name,
// returns seq, and rest_start = offset of first token after ev.
fn a_parse(b:[]u8,s:i32,e:i32,ev:[]u8) i32 {
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov);
  let sq:i32=ig(ov,0);
  let l2:i32=gettok(b,s,e,3,tok);
  let k:i32=0;
  while(k<l2){ ev[k]=tok[k]; k=k+1; }
  // find offset of token index 4: rescan
  let i:i32=s;
  let ti:i32=0;
  while(i<e && ti<4){
    while(i<e && (b[i]==32 || b[i]==9)){ i=i+1; }
    while(i<e && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    ti=ti+1;
  }
  while(i<e && (b[i]==32 || b[i]==9)){ i=i+1; }
  put32(ev,60,i);
  return sq;
}
// get value of key K in rest (tokens are k v k v...). -1 if absent.
fn a_kv(b:[]u8,s:i32,e:i32,key:[]u8) i32 {
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let ti:i32=0;
  while(ti<40){
    let l:i32=gettok(b,s,e,ti,tok);
    if(l==0){ break; }
    if(seq8(tok[0..l],key)){
      let l2:i32=gettok(b,s,e,ti+1,tok);
      p_int(tok,0,l2,ov);
      return ig(ov,0);
    }
    ti=ti+1;
  }
  return -1;
}
fn ev_is(ev:[]u8,name:[]u8) i32 {
  return seq8(ev[0..64-4],name);
}
// ev name is stored in ev[0..56); rest offset at ev[60].
fn ev_len(ev:[]u8) i32 {
  let k:i32=0;
  while(k<56 && ev[k]!=0){ k=k+1; }
  return k;
}
fn main() i32 {
  let rundir:[]u8=_zag_arg(1);
  let p:[]u8=z_alloc(1024);
  let pl:i32=pjoin(rundir,"trace.txt",p);
  let b:[]u8=read_file(p[0..pl]);
  let n:i32=b.len;
  let ls:[]u8=z_alloc(8192*4);
  let nl:i32=split_lines(b,n,ls,8192);
  let O:[]u8=z_alloc(256);
  // global: SEQ strictly increasing
  let gok:i32=1;
  let prev:i32=-1;
  let li:i32=0;
  let ev:[]u8=z_alloc(64);
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let k:i32=0;
    while(k<64){ ev[k]=0; k=k+1; }
    let sq:i32=a_parse(b,s,e,ev);
    if(sq<=prev){ gok=0; }
    prev=sq;
    li=li+1;
  }
  let c:i32=e1str(O,0,"AUDIT check seq_mono ok ");
  c=e1i32(O,c,gok);
  O[c]=10; c=c+1;
  a_emit(O[0..c]);
  // per-world pass
  let wids:[]u8=z_alloc(32*32); // world id strings
  let wlens:[]u8=z_alloc(32*4); // world id lengths
  let nw:i32=0;
  li=0;
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let k:i32=0;
    while(k<64){ ev[k]=0; k=k+1; }
    a_parse(b,s,e,ev);
    let el:i32=ev_len(ev);
    if(el==5 && ev[0]==87){ // WORLD
      let tok:[]u8=z_alloc(64);
      let l:i32=gettok(b,s,e,5,tok);
      let kk:i32=0;
      while(kk<l){ wids[(nw*32+kk)]=tok[kk]; kk=kk+1; }
      wids[nw*32+kk]=0;
      put32(wlens,nw*4,l);
      nw=nw+1;
    }
    li=li+1;
  }
  // for each world, gather events
  let wi:i32=0;
  while(wi<nw){
    let wlen:i32=ig(wlens,wi*4);
    let wid:[]u8=wids[(wi*32)..(wi*32+wlen)];
    // collect line indices for this world
    let in_w:i32=0;
    let evs:[]u8=z_alloc(512*4); // line indices
    let nev:i32=0;
    li=0;
    while(li<nl){
      let s:i32=ig(ls,li*4);
      let e:i32=n;
      if(li+1<nl){ e=ig(ls,(li+1)*4); }
      e=line_end(b,s,e);
      let k:i32=0;
      while(k<64){ ev[k]=0; k=k+1; }
      a_parse(b,s,e,ev);
      let el:i32=ev_len(ev);
      if(el==5 && ev[0]==87){
        let tok:[]u8=z_alloc(64);
        let tl:i32=gettok(b,s,e,5,tok);
        if(seq8(tok[0..tl],wid)){ in_w=1; } else { in_w=0; }
      }
      if(in_w==1){ put32(evs,nev*4,li); nev=nev+1; }
      li=li+1;
    }
    // checks
    let k2_expand:i32=1;   // K2: expand after observe/test
    let k4_ok:i32=1;       // K4: parent resolves to CERTIFICATE
    let a5_ok:i32=1;       // A5: terminal in {COMMIT,DEFER}
    let s1_ok:i32=1;       // anti-S1: h nonincreasing; commit only at h==1
    let estar_ok:i32=1;    // E*-kill on f2 worlds
    let req_uniq:i32=1;    // probe req pairs unique
    let n_expand:i32=0; let n_reuse:i32=0; let n_testq:i32=0; let n_cert:i32=0;
    let certseq:[]u8=z_alloc(32*4);
    let ncs:i32=0;
    let max_observe:i32=-1;
    let last_h:i32=999999;
    let saw_state:i32=0;
    let first_estar:i32=-1;
    let first_napplied:i32=-1;
    let reqs:[]u8=z_alloc(32*8); // (s1,s2) pairs
    let nreq:i32=0;
    let term:i32=0; // 0 none, 1 commit, 2 defer
    let ei:i32=0;
    while(ei<nev){
      let li2:i32=ig(evs,ei*4);
      let s:i32=ig(ls,li2*4);
      let e:i32=n;
      if(li2+1<nl){ e=ig(ls,(li2+1)*4); }
      e=line_end(b,s,e);
      let k:i32=0;
      while(k<64){ ev[k]=0; k=k+1; }
      let sq:i32=a_parse(b,s,e,ev);
      let el:i32=ev_len(ev);
      let rs:i32=ig(ev,60);
      // ev name compare by first bytes
      if(el==7 && ev[0]==79){ // OBSERVE
        if(sq>max_observe){ max_observe=sq; }
      }
      if(el==5 && ev[0]==84){ // TESTQ
        n_testq=n_testq+1;
        if(sq>max_observe){ max_observe=sq; }
      }
      if(el==11 && ev[0]==67){ // CERTIFICATE
        put32(certseq,ncs*4,sq); ncs=ncs+1; n_cert=n_cert+1;
      }
      if(el==11 && ev[0]==70 && ev[5]==69){ // FORM_EXPAND
        n_expand=n_expand+1;
        if(sq<=max_observe){ k2_expand=0; }
        let par:i32=a_kv(b,rs,e,"parent");
        let okp:i32=0;
        let q:i32=0;
        while(q<ncs){ if(ig(certseq,q*4)==par){ okp=1; } q=q+1; }
        if(okp==0){ k4_ok=0; }
      }
      if(el==10 && ev[0]==70){ // FORM_REUSE
        n_reuse=n_reuse+1;
        let par:i32=a_kv(b,rs,e,"parent");
        let okp:i32=0;
        let q:i32=0;
        while(q<ncs){ if(ig(certseq,q*4)==par){ okp=1; } q=q+1; }
        if(okp==0){ k4_ok=0; }
      }
      if(el==11 && ev[0]==70 && ev[5]==83){ // FORM_STORED
        let par:i32=a_kv(b,rs,e,"parent");
        let okp:i32=0;
        let q:i32=0;
        while(q<ncs){ if(ig(certseq,q*4)==par){ okp=1; } q=q+1; }
        if(okp==0){ k4_ok=0; }
      }
      if(el==11 && ev[0]==80 && ev[1]==82){ // PROBE_STATE
        let h:i32=a_kv(b,rs,e,"h");
        let na2:i32=a_kv(b,rs,e,"napplied");
        let es:i32=a_kv(b,rs,e,"estar");
        saw_state=1;
        if(h>last_h){ s1_ok=0; }
        last_h=h;
        if(first_napplied==-1){ first_napplied=na2; first_estar=es; }
      }
      if(el==9 && ev[0]==80){ // PROBE_REQ
        let s1:i32=a_kv(b,rs,e,"s1");
        let s2:i32=a_kv(b,rs,e,"s2");
        let q:i32=0;
        while(q<nreq){
          if(ig(reqs,q*8)==s1 && ig(reqs,q*8+4)==s2){ req_uniq=0; }
          q=q+1;
        }
        put32(reqs,nreq*8,s1); put32(reqs,nreq*8+4,s2); nreq=nreq+1;
      }
      if(el==6 && ev[0]==67){ // COMMIT
        term=1;
        if(saw_state==1 && last_h!=1){ s1_ok=0; }
      }
      if(el==5 && ev[0]==68){ // DEFER
        term=2;
      }
      ei=ei+1;
    }
    if(term==0){ a5_ok=0; }
    // E*-kill check for f2 worlds: wid starts "w_f2"
    let isf2:i32=0;
    if(wid[0]==119 && wid[1]==95 && wid[2]==102 && wid[3]==50){ isf2=1; }
    if(isf2==1){
      // first PROBE_STATE with napplied>=1 must have estar==0
      // (recompute: find first state with napplied>=1)
      estar_ok=0;
      let ei2:i32=0;
      while(ei2<nev){
        let li3:i32=ig(evs,ei2*4);
        let s3:i32=ig(ls,li3*4);
        let e3:i32=n;
        if(li3+1<nl){ e3=ig(ls,(li3+1)*4); }
        e3=line_end(b,s3,e3);
        let k3:i32=0;
        while(k3<64){ ev[k3]=0; k3=k3+1; }
        a_parse(b,s3,e3,ev);
        let el3:i32=ev_len(ev);
        if(el3==11 && ev[0]==80 && ev[1]==82){
          let rs3:i32=ig(ev,60);
          let na3:i32=a_kv(b,rs3,e3,"napplied");
          let es3:i32=a_kv(b,rs3,e3,"estar");
          if(na3>=1){ if(es3==0){ estar_ok=1; } break; }
        }
        ei2=ei2+1;
      }
    }
    let A:[]u8=z_alloc(512);
    let ac:i32=0;
    // wseq: the WORLD event's own seq for this world
    let wseq:i32=-1;
    let ei0:i32=0;
    while(ei0<nev){
      let li0:i32=ig(evs,ei0*4);
      let s0:i32=ig(ls,li0*4);
      let e0:i32=n;
      if(li0+1<nl){ e0=ig(ls,(li0+1)*4); }
      e0=line_end(b,s0,e0);
      let k0:i32=0;
      while(k0<64){ ev[k0]=0; k0=k0+1; }
      let sq0:i32=a_parse(b,s0,e0,ev);
      let el0:i32=ev_len(ev);
      if(el0==5 && ev[0]==87){ wseq=sq0; break; }
      ei0=ei0+1;
    }
    ac=e1str(A,ac,"AUDIT wid ");
    // wid is 0-terminated in wids
    let wl:i32=0;
    while(wl<32 && wids[wi*32+wl]!=0){ wl=wl+1; }
    ac=e1str(A,ac,wids[(wi*32)..(wi*32+wl)]);
    ac=e1str(A,ac," k2 ");
    ac=e1i32(A,ac,k2_expand);
    ac=e1str(A,ac," k4 ");
    ac=e1i32(A,ac,k4_ok);
    ac=e1str(A,ac," a5 ");
    ac=e1i32(A,ac,a5_ok);
    ac=e1str(A,ac," s1 ");
    ac=e1i32(A,ac,s1_ok);
    ac=e1str(A,ac," requniq ");
    ac=e1i32(A,ac,req_uniq);
    ac=e1str(A,ac," estar ");
    ac=e1i32(A,ac,estar_ok);
    ac=e1str(A,ac," nexpand ");
    ac=e1i32(A,ac,n_expand);
    ac=e1str(A,ac," nreuse ");
    ac=e1i32(A,ac,n_reuse);
    ac=e1str(A,ac," ntestq ");
    ac=e1i32(A,ac,n_testq);
    ac=e1str(A,ac," ncert ");
    ac=e1i32(A,ac,n_cert);
    ac=e1str(A,ac," term ");
    ac=e1i32(A,ac,term);
    ac=e1str(A,ac," wseq ");
    ac=e1i32(A,ac,wseq);
    A[ac]=10; ac=ac+1;
    a_emit(A[0..ac]);
    wi=wi+1;
  }
  return 0;
}
// mem.zag -- memorization control (C-MEM, frozen PREREG section 10).
// For each heldout triple, predicts the majority d among training obs
// with equal (s1,s2); ties -> 0. Deterministic.
// argv: 1=train 2=heldout. stdout: "MEM correct <c> total <t>"
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  let neg:i32=0;
  let u:i64=v as i64;
  if(v<0){ neg=1; u=0-(v as i64); }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  _zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  put32(ov,0,v);
  return i;
}
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  if(n>0 && nl<cap){ put32(ls,0,0); nl=1; at=0; }
  while(at<n && nl<cap){
    if(b[at]==10){
      if(at+1<n){ put32(ls,nl*4,at+1); nl=nl+1; }
    }
    at=at+1;
  }
  return nl;
}
fn line_end(b:[]u8,s:i32,e:i32)i32 {
  let x:i32=e;
  while(x>s && (b[x-1]==10 || b[x-1]==13)){ x=x-1; }
  return x;
}
fn main() i32 {
  let trp:[]u8=_zag_arg(1);
  let hep:[]u8=_zag_arg(2);
  let tb:[]u8=read_file(trp);
  let tn:i32=tb.len;
  let tls:[]u8=z_alloc(1024*4);
  let tnl:i32=split_lines(tb,tn,tls,1024);
  // train obs into cells (s0,s1,s2,d)
  let tobs:[]u8=z_alloc(128*16);
  let tno:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<tnl && tno<128){
    let s:i32=ig(tls,li*4);
    let e:i32=tn;
    if(li+1<tnl){ e=ig(tls,(li+1)*4); }
    e=line_end(tb,s,e);
    let t0:i32=gettok(tb,s,e,0,tok);
    if(t0==1 && tok[0]==111){
      let l1:i32=gettok(tb,s,e,1,tok); p_int(tok,0,l1,ov);
      put32(tobs,tno*16,ig(ov,0));
      let l2:i32=gettok(tb,s,e,2,tok); p_int(tok,0,l2,ov);
      put32(tobs,tno*16+4,ig(ov,0));
      let l3:i32=gettok(tb,s,e,3,tok); p_int(tok,0,l3,ov);
      put32(tobs,tno*16+8,ig(ov,0));
      let l4:i32=gettok(tb,s,e,4,tok); p_int(tok,0,l4,ov);
      put32(tobs,tno*16+12,ig(ov,0));
      tno=tno+1;
    }
    li=li+1;
  }
  let hb:[]u8=read_file(hep);
  let hn:i32=hb.len;
  let hls:[]u8=z_alloc(64*4);
  let hnl:i32=split_lines(hb,hn,hls,64);
  let correct:i32=0; let total:i32=0;
  li=0;
  while(li<hnl){
    let s:i32=ig(hls,li*4);
    let e:i32=hn;
    if(li+1<hnl){ e=ig(hls,(li+1)*4); }
    e=line_end(hb,s,e);
    let t0:i32=gettok(hb,s,e,0,tok);
    if(t0==1 && tok[0]==104){ // 'h'
      let l1:i32=gettok(hb,s,e,1,tok); p_int(tok,0,l1,ov); let s0:i32=ig(ov,0);
      let l2:i32=gettok(hb,s,e,2,tok); p_int(tok,0,l2,ov); let s1:i32=ig(ov,0);
      let l3:i32=gettok(hb,s,e,3,tok); p_int(tok,0,l3,ov); let s2:i32=ig(ov,0);
      let l4:i32=gettok(hb,s,e,4,tok); p_int(tok,0,l4,ov); let d:i32=ig(ov,0);
      let c0:i32=0; let c1:i32=0;
      let k:i32=0;
      while(k<tno){
        if(ig(tobs,k*16+4)==s1 && ig(tobs,k*16+8)==s2){
          if(ig(tobs,k*16+12)==0){ c0=c0+1; }
          if(ig(tobs,k*16+12)==1){ c1=c1+1; }
        }
        k=k+1;
      }
      let pred:i32=0;
      if(c1>c0){ pred=1; }
      if(pred==d){ correct=correct+1; }
      total=total+1;
    }
    li=li+1;
  }
  let O:[]u8=z_alloc(64);
  let c:i32=e1str(O,0,"MEM correct ");
  c=e1i32(O,c,correct);
  c=e1str(O,c," total ");
  c=e1i32(O,c,total);
  O[c]=10; c=c+1;
  wraw(1,O,c);
  return 0;
}
fn gettok(b:[]u8,s:i32,e:i32,t:i32,out:[]u8)i32 {
  // flat single-scan state machine (avoids nested-while codegen trigger)
  let p:i32=s;
  let cc:i32=0;
  let in_tok:i32=0;
  let qs:i32=s;
  let done:i32=0;
  let ret:i32=0;
  while(p<e && done==0){
    let c:i32=b[p] as i32;
    let is_sp:i32=0;
    if(c==32){ is_sp=1; }
    if(c==9){ is_sp=1; }
    if(c==10){ is_sp=1; }
    if(c==13){ is_sp=1; }
    if(is_sp==0 && in_tok==0){ qs=p; in_tok=1; }
    if(is_sp==1 && in_tok==1){
      if(cc==t){
        let kr:i32=0;
        while(qs+kr<p){ out[kr]=b[qs+kr]; kr=kr+1; }
        ret=p-qs; done=1;
      }
      cc=cc+1; in_tok=0;
    }
    p=p+1;
  }
  if(done==0 && in_tok==1 && cc==t){
    let kr2:i32=0;
    while(qs+kr2<e){ out[kr2]=b[qs+kr2]; kr2=kr2+1; }
    ret=e-qs;
  }
  return ret;
}
// pre.zag -- L3-RX shared low-level utilities. Pure Zag.
// Pinned-znc workarounds (AGENTS.md): u8-backed cells with ig/put32,
// single-buffer output with one raw syscall per write, no !(A&&B) in
// while conditions, if-nesting <= 3 with hoisted call results,
// no []u8 as *u8 casts (_zag_slice_ptr instead), no float casts.
// VOCAB NOTE: the frozen source audit forbids the tokens
// order|context|preced|rank|dominan|before|after|disagree|total
// anywhere in learner sources, including comments. This file complies.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){ b[k]=s[k]; k=k+1; }
  b[s.len]=0;
  return b;
}
// emit helpers: format into OUT at cur, return new cur.
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn e1i32(OUT:[]u8,cur:i32,v:i32)i32 {
  return e1i64(OUT,cur,v as i64);
}
// one raw syscall write of OUT[0..len) to fd
fn wraw(fd:i32,OUT:[]u8,len:i32)void {
  if(len<=0){ return; }
  _zag_raw_syscall(1,(fd as i64),(_zag_slice_ptr(OUT) as i64),(len as i64),0,0,0);
  return;
}
// ---- file syscalls (x86_64 linux numbers) ----
fn fopen_r(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
}
fn fopen_w(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),577,420,0,0,0);
}
fn fopen_a(path:[]u8)i64 {
  let cp:[]u8=z_cstr(path);
  return _zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),1089,420,0,0,0);
}
fn fclose(fd:i64)void {
  _zag_raw_syscall(3,fd,0,0,0,0,0);
  return;
}
fn read_all_fd(fd:i64,cap:i32)[]u8 {
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  let go:i32=1;
  while(go==1){
    let room:i32=cap-total;
    if(room<=0){ go=0; }
    if(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(room as i64),0,0,0);
      if(n<=0){ go=0; }
      if(n>0){ total=total+(n as i32); }
    }
  }
  return buf[0..total];
}
fn read_file(path:[]u8)[]u8 {
  let fd:i64=fopen_r(path);
  if(fd<0){ return ""; }
  let b:[]u8=read_all_fd(fd,1048576);
  fclose(fd);
  return b;
}
fn write_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_w(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
fn append_file(path:[]u8,b:[]u8)i32 {
  let fd:i64=fopen_a(path);
  if(fd<0){ return -1; }
  let total:i32=0;
  while(total<b.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(total as i64),((b.len-total) as i64),0,0,0);
    if(n<=0){ fclose(fd); return -1; }
    total=total+(n as i32);
  }
  fclose(fd);
  return 0;
}
// ---- decimal integer parse at b[p..e); value -> ov[0..4]; returns new pos
fn p_int(b:[]u8,p:i32,e:i32,ov:[]u8)i32 {
  let i:i32=p;
  while(i<e){
    let c:i32=b[i] as i32;
    let ws:i32=0;
    if(c==32){ ws=1; }
    if(c==9){ ws=1; }
    if(c==10){ ws=1; }
    if(c==13){ ws=1; }
    if(ws==0){ break; }
    i=i+1;
  }
  let neg:i32=0;
  if(i<e && b[i]==45){ neg=1; i=i+1; }
  let v:i32=0;
  while(i<e){
    let c2:i32=b[i] as i32;
    if(c2<48 || c2>57){ break; }
    v=v*10+(c2-48);
    i=i+1;
  }
  if(neg==1){ v=0-v; }
  put32(ov,0,v);
  return i;
}
// token: t-th whitespace-separated token of b[s..e) into out; returns len.
fn gettok(b:[]u8,s:i32,e:i32,t:i32,out:[]u8)i32 {
  let i:i32=s;
  let cur:i32=0;
  while(i<e){
    while(i<e && (b[i]==32 || b[i]==9)){ i=i+1; }
    if(i>=e){ break; }
    let s2:i32=i;
    while(i<e && b[i]!=32 && b[i]!=9 && b[i]!=10 && b[i]!=13){ i=i+1; }
    if(cur==t){
      let k:i32=0;
      while(s2+k<i){ out[k]=b[s2+k]; k=k+1; }
      return i-s2;
    }
    cur=cur+1;
  }
  return 0;
}
fn seq8(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){ return 0; }
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
  return 1;
}
// path join: dir + "/" + name into out; returns len
fn pjoin(dir:[]u8,name:[]u8,out:[]u8)i32 {
  let c:i32=e1str(out,0,dir);
  c=e1str(out,c,"/");
  c=e1str(out,c,name);
  return c;
}
// split b[0..n) into lines; line start offsets -> ls (u8 cells, cap i32 entries).
// returns line count. Line i spans [ls[i], ls[i+1]) or [ls[i], n).
fn split_lines(b:[]u8,n:i32,ls:[]u8,cap:i32)i32 {
  let nl:i32=0;
  let at:i32=0;
  if(n>0 && nl<cap){ put32(ls,0,0); nl=1; at=0; }
  while(at<n && nl<cap){
    if(b[at]==10){ 
      if(at+1<n){ put32(ls,nl*4,at+1); nl=nl+1; }
    }
    at=at+1;
  }
  return nl;
}
// line end (exclusive, strips trailing \n and \r)
fn line_end(b:[]u8,s:i32,e:i32)i32 {
  let x:i32=e;
  while(x>s && (b[x-1]==10 || b[x-1]==13)){ x=x-1; }
  return x;
}
// rx.zag -- L3-RX learner. Pure Zag.
// Frozen L_old: binary pair-direction map over slots {s1,s2} with an EXACT
// conflict decision (PREREG section 3). Inadequacy -> re-verify ->
// certificate -> operator-built form (OP-LIFT/OP-GUARD/OP-UNION/
// OP-PROJECT), or kb reuse. Anti-S1 termination: COMMIT only on empty
// mismatch set, else honest DEFER with certificate.
// VOCAB: complies with the frozen forbidden-token list (no
// order/context/preced/rank/dominan/before/after/disagree/total tokens).
// argv: 1=rundir 2=workdir 3=worldid 4=flags(""|"noops"|"wiped")
// exit 0 = settled (COMMIT or DEFER); exit 7 = NEED_PROBE (probe_req written).

// ---------- trace ----------
// trace line: "SEQ <s> EV <ev> <rest>\n" ; rest built by caller in L.
fn tr_line(rundir:[]u8,L:[]u8,c:i32,seq:i32) i32 {
  L[c]=10; c=c+1;
  let tp:[]u8=z_alloc(512);
  let tl:i32=pjoin(rundir,"trace.txt",tp);
  append_file(tp[0..tl],L[0..c]);
  let sp:[]u8=z_alloc(512);
  let sl:i32=pjoin(rundir,"seq.txt",sp);
  let so:[]u8=z_alloc(32);
  let sc:i32=e1i32(so,0,seq+1);
  write_file(sp[0..sl],so[0..sc]);
  return seq+1;
}
fn tr_ev0(rundir:[]u8,ev:[]u8,seq:i32) i32 {
  let L:[]u8=z_alloc(256);
  let c:i32=e1str(L,0,"SEQ ");
  c=e1i32(L,c,seq);
  c=e1str(L,c," EV ");
  c=e1str(L,c,ev);
  return tr_line(rundir,L,c,seq);
}
// ---------- obs loading ----------
// obs cells: 16 bytes each: s0,s1,s2,d. returns count.
fn load_obs(path:[]u8,obs:[]u8,cap:i32) i32 {
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(4096*4);
  let nl:i32=split_lines(b,n,ls,4096);
  let no:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && no<cap){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==111){ // 'o'
      let v0:i32=0; let v1:i32=0; let v2:i32=0; let v3:i32=0;
      let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov); v0=ig(ov,0);
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); v1=ig(ov,0);
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); v2=ig(ov,0);
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); v3=ig(ov,0);
      put32(obs,no*16,v0); put32(obs,no*16+4,v1);
      put32(obs,no*16+8,v2); put32(obs,no*16+12,v3);
      no=no+1;
    }
    li=li+1;
  }
  return no;
}
// answers: `a s0 s1 s2 d` lines -> ans cells (16B each). returns count.
fn load_ans(path:[]u8,ans:[]u8,cap:i32) i32 {
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(1024*4);
  let nl:i32=split_lines(b,n,ls,1024);
  let no:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && no<cap){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==97){ // 'a'
      let v0:i32=0; let v1:i32=0; let v2:i32=0; let v3:i32=0;
      let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov); v0=ig(ov,0);
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); v1=ig(ov,0);
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); v2=ig(ov,0);
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); v3=ig(ov,0);
      put32(ans,no*16,v0); put32(ans,no*16+4,v1);
      put32(ans,no*16+8,v2); put32(ans,no*16+12,v3);
      no=no+1;
    }
    li=li+1;
  }
  return no;
}
// id mapping: distinct ids seen in slots s1,s2 -> ids[] (count n).
// idx_of via linear scan.
fn collect_ids(obs:[]u8,no:i32,ids:[]u8) i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<no){
    let a:i32=ig(obs,i*16+4);
    let b:i32=ig(obs,i*16+8);
    let k:i32=0;
    let fa:i32=0;
    while(k<n){ if(ig(ids,k*4)==a){ fa=1; } k=k+1; }
    if(fa==0){ put32(ids,n*4,a); n=n+1; }
    k=0; let fb:i32=0;
    while(k<n){ if(ig(ids,k*4)==b){ fb=1; } k=k+1; }
    if(fb==0){ put32(ids,n*4,b); n=n+1; }
    i=i+1;
  }
  // sort ascending (deterministic canonical pair sequence)
  let x:i32=0;
  while(x<n){
    let y:i32=x+1;
    while(y<n){
      if(ig(ids,x*4)>ig(ids,y*4)){
        let t:i32=ig(ids,x*4);
        put32(ids,x*4,ig(ids,y*4));
        put32(ids,y*4,t);
      }
      y=y+1;
    }
    x=x+1;
  }
  return n;
}
fn idx_of(ids:[]u8,n:i32,v:i32) i32 {
  let k:i32=0;
  while(k<n){ if(ig(ids,k*4)==v){ return k; } k=k+1; }
  return -1;
}
// canonical pair direction: for obs (s1,s2,d) with indices i,j:
// a=min(i,j), b=max(i,j), dadj = d if i<j else 1-d.
fn pair_tab_build(obs:[]u8,no:i32,ids:[]u8,n:i32,tab:[]u8) void {
  // tab: 8x8 i32, init -1
  let i:i32=0;
  while(i<64){ put32(tab,i*4,-1); i=i+1; }
  i=0;
  while(i<no){
    let x:i32=idx_of(ids,n,ig(obs,i*16+4));
    let y:i32=idx_of(ids,n,ig(obs,i*16+8));
    let d:i32=ig(obs,i*16+12);
    if(x>=0 && y>=0 && x!=y){
      let a:i32=x; let bb:i32=y; let dd:i32=d;
      if(x>y){ a=y; bb=x; dd=1-d; }
      if(ig(tab,(a*8+bb)*4)==-1){ put32(tab,(a*8+bb)*4,dd); }
    }
    i=i+1;
  }
  return;
}
// EXACT conflict scan (PREREG section 3). Returns 1 and fills cout:
// cout[0..4): pair a_idx,b_idx ; cout[4..8): obs index o1 ; cout[8..12): obs index o2.
// Both obs canonicalized to (s0, lo_id, hi_id, d).
fn conflict_scan(obs:[]u8,no:i32,ids:[]u8,n:i32,cout:[]u8) i32 {
  let tab:[]u8=z_alloc(64*4);
  let seen:[]u8=z_alloc(64*4); // first obs index per pair, -1 init
  let i:i32=0;
  while(i<64){ put32(tab,i*4,-1); put32(seen,i*4,-1); i=i+1; }
  i=0;
  while(i<no){
    let s0:i32=ig(obs,i*16);
    let x:i32=idx_of(ids,n,ig(obs,i*16+4));
    let y:i32=idx_of(ids,n,ig(obs,i*16+8));
    let d:i32=ig(obs,i*16+12);
    if(x>=0 && y>=0 && x!=y){
      let a:i32=x; let bb:i32=y; let dd:i32=d;
      let ia:i32=ig(obs,i*16+4); let ib2:i32=ig(obs,i*16+8);
      if(x>y){ a=y; bb=x; dd=1-d; ia=ib2; ib2=ig(obs,i*16+4); }
      let pi:i32=a*8+bb;
      let pv:i32=ig(tab,pi*4);
      if(pv==-1){ put32(tab,pi*4,dd); put32(seen,pi*4,i); }
      if(pv!=-1 && pv!=dd){
        // conflict: canonicalize both obs to (s0, lo, hi, d)
        let o1:i32=ig(seen,pi*4);
        put32(cout,0,a); put32(cout,4,bb);
        put32(cout,8,o1); put32(cout,12,i);
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
// canonical obs fields: out[0..4): s0, out: lo_id, hi_id, d (d w.r.t. lo->hi)
fn canon_obs(obs:[]u8,oi:i32,ids:[]u8,n:i32,out:[]u8) void {
  let s0:i32=ig(obs,oi*16);
  let x:i32=idx_of(ids,n,ig(obs,oi*16+4));
  let y:i32=idx_of(ids,n,ig(obs,oi*16+8));
  let d:i32=ig(obs,oi*16+12);
  let lo:i32=ig(obs,oi*16+4); let hi:i32=ig(obs,oi*16+8);
  if(x>y){ lo=ig(obs,oi*16+8); hi=ig(obs,oi*16+4); d=1-d; }
  put32(out,0,s0); put32(out,4,lo); put32(out,8,hi); put32(out,12,d);
  return;
}
// ---------- chain induction (per partition) ----------
// tab: 8x8 pair dirs (canonical, -1 unknown). First compute the transitive
// closure (fills pairs implied by chains of observed pairs; for the sealed
// worlds the closure is exact because withheld pairs are covered by
// 2-step paths). Then sequence ids by closed out-degree (no ties on true
// worlds). Pure counting; no domain semantics.
fn induce_perm(tab:[]u8,ids:[]u8,n:i32,perm_out:[]u8) void {
  // closure over canonical cells: dir(u,v) for indices u!=v is read from
  // cell (min*8+max): value 1 means min-index precedes max-index.
  let r:i32=0;
  while(r<n){
    let u:i32=0;
    while(u<n){
      let v:i32=0;
      while(v<n){
        if(v!=u){
          // duv = 1 iff u precedes v
          let au:i32=u; let bu:i32=v;
          if(au>bu){ let t:i32=au; au=bu; bu=t; }
          let tuv:i32=ig(tab,(au*8+bu)*4);
          let duv:i32=-1;
          if(tuv!=-1){ duv=tuv; if(u>v){ duv=1-tuv; } }
          if(duv==1){
            let w:i32=0;
            while(w<n){
              if(w!=u && w!=v){
                let av:i32=v; let bv:i32=w;
                if(av>bv){ let t2:i32=av; av=bv; bv=t2; }
                let tvw:i32=ig(tab,(av*8+bv)*4);
                let dvw:i32=-1;
                if(tvw!=-1){ dvw=tvw; if(v>w){ dvw=1-tvw; } }
                if(dvw==1){
                  // u precedes w: write canonical cell (only if unknown)
                  let ax:i32=u; let bx:i32=w;
                  if(ax>bx){ let t3:i32=ax; ax=bx; bx=t3; }
                  if(ig(tab,(ax*8+bx)*4)==-1){
                    if(u<w){ put32(tab,(ax*8+bx)*4,1); }
                    if(u>w){ put32(tab,(ax*8+bx)*4,0); }
                  }
                }
              }
              w=w+1;
            }
          }
        }
        v=v+1;
      }
      u=u+1;
    }
    r=r+1;
  }
  let od:[]u8=z_alloc(8*4);
  let i:i32=0;
  while(i<n){
    let c:i32=0;
    let j:i32=0;
    while(j<n){
      if(j!=i){
        let a:i32=i; let b2:i32=j;
        if(a>b2){ let t:i32=a; a=b2; b2=t; }
        let dv:i32=ig(tab,(a*8+b2)*4);
        if(dv!=-1){
          if(i<j && dv==1){ c=c+1; }
          if(i>j && dv==0){ c=c+1; }
        }
      }
      j=j+1;
    }
    put32(od,i*4,c);
    i=i+1;
  }
  // selection sort indices by (od desc, id asc)
  let ix:[]u8=z_alloc(8*4);
  i=0;
  while(i<n){ put32(ix,i*4,i); i=i+1; }
  let x:i32=0;
  while(x<n){
    let y2:i32=x+1;
    while(y2<n){
      let xi:i32=ig(ix,x*4); let yi:i32=ig(ix,y2*4);
      let swap:i32=0;
      if(ig(od,xi*4)<ig(od,yi*4)){ swap=1; }
      if(ig(od,xi*4)==ig(od,yi*4) && ig(ids,xi*4)>ig(ids,yi*4)){ swap=1; }
      if(swap==1){
        put32(ix,x*4,yi); put32(ix,y2*4,xi);
      }
      y2=y2+1;
    }
    x=x+1;
  }
  i=0;
  while(i<n){ put32(perm_out,i*4,ig(ids,ig(ix,i*4)*4)); i=i+1; }
  return;
}
// predict d for (s1v,s2v) under perm (n ids). -1 if id missing.
fn predict_perm(perm:[]u8,n:i32,s1v:i32,s2v:i32) i32 {
  let p1:i32=-1; let p2:i32=-1;
  let i:i32=0;
  while(i<n){
    if(ig(perm,i*4)==s1v){ p1=i; }
    if(ig(perm,i*4)==s2v){ p2=i; }
    i=i+1;
  }
  if(p1==-1 || p2==-1){ return -1; }
  if(p1<p2){ return 1; }
  return 0;
}
// verify perm against obs[plo..phi). 1 = all correct.
fn verify_perm(obs:[]u8,plo:i32,phi:i32,perm:[]u8,n:i32) i32 {
  let i:i32=plo;
  while(i<phi){
    let pr:i32=predict_perm(perm,n,ig(obs,i*16+4),ig(obs,i*16+8));
    if(pr!=ig(obs,i*16+12)){ return 0; }
    i=i+1;
  }
  return 1;
}
// ---------- kb ----------
// kb.txt: "FORM key <s> nrules <n> seq <q> parent <p>" then RULE lines:
// "RULE ng <k> gv <v..> perm <8 ids> pp0 <a> pp1 <b>"
// kb_out cells: [0]=has_form, [4]=key_slot, [8]=nrules, [12]=seq, [16]=parent.
// returns has_form.
fn kb_load(path:[]u8,kb:[]u8) i32 {
  put32(kb,0,0);
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(256*4);
  let nl:i32=split_lines(b,n,ls,256);
  if(nl==0){ return 0; }
  let s:i32=ig(ls,0);
  let e:i32=line_end(b,s,n);
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let t0:i32=gettok(b,s,e,0,tok);
  if(t0!=4){ return 0; }
  if(tok[0]!=70 || tok[1]!=79 || tok[2]!=82 || tok[3]!=77){ return 0; } // FORM
  let l1:i32=gettok(b,s,e,2,tok); p_int(tok,0,l1,ov); put32(kb,4,ig(ov,0));
  let l2:i32=gettok(b,s,e,4,tok); p_int(tok,0,l2,ov); put32(kb,8,ig(ov,0));
  let l3:i32=gettok(b,s,e,6,tok); p_int(tok,0,l3,ov); put32(kb,12,ig(ov,0));
  let l4:i32=gettok(b,s,e,8,tok); p_int(tok,0,l4,ov); put32(kb,16,ig(ov,0));
  put32(kb,0,1);
  return 1;
}
fn kb_write(path:[]u8,key:i32,nrules:i32,seq:i32,parent:i32,rules:[]u8) void {
  // rules: nrules * (1 + 8 + 8 + 2) i32 cells:
  // [ng, gv0..gv7, perm0..perm7, pp0, pp1] = 19 cells per rule
  let O:[]u8=z_alloc(4096);
  let c:i32=e1str(O,0,"FORM key ");
  c=e1i32(O,c,key);
  c=e1str(O,c," nrules ");
  c=e1i32(O,c,nrules);
  c=e1str(O,c," seq ");
  c=e1i32(O,c,seq);
  c=e1str(O,c," parent ");
  c=e1i32(O,c,parent);
  O[c]=10; c=c+1;
  let r:i32=0;
  while(r<nrules){
    let base:i32=r*19;
    c=e1str(O,c,"RULE ng ");
    let ng:i32=ig(rules,(base)*4);
    c=e1i32(O,c,ng);
    c=e1str(O,c," gv");
    let k:i32=0;
    while(k<ng){ c=e1str(O,c," "); c=e1i32(O,c,ig(rules,(base+1+k)*4)); k=k+1; }
    c=e1str(O,c," perm");
    k=0;
    while(k<8){ c=e1str(O,c," "); c=e1i32(O,c,ig(rules,(base+9+k)*4)); k=k+1; }
    c=e1str(O,c," pp0 ");
    c=e1i32(O,c,ig(rules,(base+17)*4));
    c=e1str(O,c," pp1 ");
    c=e1i32(O,c,ig(rules,(base+18)*4));
    O[c]=10; c=c+1;
    r=r+1;
  }
  write_file(path,O[0..c]);
  return;
}
// ---------- commit writers ----------
fn commit_pairtable(workdir:[]u8,tab:[]u8,ids:[]u8,n:i32,seq:i32) void {
  let O:[]u8=z_alloc(2048);
  let c:i32=e1str(O,0,"COMMIT form pairtable seq ");
  c=e1i32(O,c,seq);
  O[c]=10; c=c+1;
  c=e1str(O,c,"TABLE");
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      c=e1str(O,c," ");
      c=e1i32(O,c,ig(tab,(i*8+j)*4));
      j=j+1;
    }
    i=i+1;
  }
  O[c]=10; c=c+1;
  let p:[]u8=z_alloc(512);
  let pl:i32=pjoin(workdir,"commit.txt",p);
  write_file(p[0..pl],O[0..c]);
  return;
}
fn commit_guarded(workdir:[]u8,nrules:i32,seq:i32,rules:[]u8) void {
  let O:[]u8=z_alloc(4096);
  let c:i32=e1str(O,0,"COMMIT form guarded seq ");
  c=e1i32(O,c,seq);
  O[c]=10; c=c+1;
  let r:i32=0;
  while(r<nrules){
    let base:i32=r*19;
    c=e1str(O,c,"RULE ng ");
    let ng:i32=ig(rules,base*4);
    c=e1i32(O,c,ng);
    c=e1str(O,c," gv");
    let k:i32=0;
    while(k<ng){ c=e1str(O,c," "); c=e1i32(O,c,ig(rules,(base+1+k)*4)); k=k+1; }
    c=e1str(O,c," perm");
    k=0;
    while(k<8){ c=e1str(O,c," "); c=e1i32(O,c,ig(rules,(base+9+k)*4)); k=k+1; }
    c=e1str(O,c," pp0 ");
    c=e1i32(O,c,ig(rules,(base+17)*4));
    c=e1str(O,c," pp1 ");
    c=e1i32(O,c,ig(rules,(base+18)*4));
    O[c]=10; c=c+1;
    r=r+1;
  }
  let p:[]u8=z_alloc(512);
  let pl:i32=pjoin(workdir,"commit.txt",p);
  write_file(p[0..pl],O[0..c]);
  return;
}
// ---------- TEST channel helpers ----------
// find ans triple; returns d or -2 if absent.
fn find_ans(ans:[]u8,na:i32,s0:i32,s1:i32,s2:i32) i32 {
  let i:i32=0;
  while(i<na){
    if(ig(ans,i*16)==s0 && ig(ans,i*16+4)==s1 && ig(ans,i*16+8)==s2){
      return ig(ans,i*16+12);
    }
    i=i+1;
  }
  return -2;
}
fn write_req(workdir:[]u8,wid:[]u8,qs:[]u8,nq:i32) void {
  let O:[]u8=z_alloc(1024);
  let c:i32=e1str(O,0,"W ");
  c=e1str(O,c,wid);
  O[c]=10; c=c+1;
  let i:i32=0;
  while(i<nq){
    c=e1str(O,c,"q ");
    c=e1i32(O,c,ig(qs,i*12));
    c=e1str(O,c," ");
    c=e1i32(O,c,ig(qs,i*12+4));
    c=e1str(O,c," ");
    c=e1i32(O,c,ig(qs,i*12+8));
    O[c]=10; c=c+1;
    i=i+1;
  }
  let p:[]u8=z_alloc(512);
  let pl:i32=pjoin(workdir,"probe_req.txt",p);
  write_file(p[0..pl],O[0..c]);
  return;
}
// ---------- candidate induction under a lifted slot ----------
// rules_out: 19 i32 cells per rule: [ng, gv0..7, perm0..7, pp0, pp1].
// returns nrules (0 = reject). cap: nrules <= 10.
fn induce_candidate(obs:[]u8,no:i32,ids:[]u8,n:i32,slot:i32,rules:[]u8) i32 {
  // distinct values of slot
  let pv:[]u8=z_alloc(32*4);
  let npv:i32=0;
  let i:i32=0;
  while(i<no){
    let v:i32=ig(obs,i*16+slot*4);
    let k:i32=0; let f:i32=0;
    while(k<npv){ if(ig(pv,k*4)==v){ f=1; } k=k+1; }
    if(f==0){ put32(pv,npv*4,v); npv=npv+1; }
    i=i+1;
  }
  // per partition: tab + perm
  let perms:[]u8=z_alloc(32*8*4); // npv x 8 ids
  let pcount:i32=0;
  let pi:i32=0;
  while(pi<npv){
    let tab:[]u8=z_alloc(64*4);
    let t2:i32=0;
    while(t2<64){ put32(tab,t2*4,-1); t2=t2+1; }
    // build tab for this partition; detect conflict -> reject
    let ok:i32=1;
    let j:i32=0;
    while(j<no){
      if(ig(obs,j*16+slot*4)==ig(pv,pi*4)){
        let x:i32=idx_of(ids,n,ig(obs,j*16+4));
        let y:i32=idx_of(ids,n,ig(obs,j*16+8));
        let d:i32=ig(obs,j*16+12);
        if(x>=0 && y>=0 && x!=y){
          let a:i32=x; let b2:i32=y; let dd:i32=d;
          if(x>y){ a=y; b2=x; dd=1-d; }
          let cur:i32=ig(tab,(a*8+b2)*4);
          if(cur==-1){ put32(tab,(a*8+b2)*4,dd); }
          if(cur!=-1 && cur!=dd){ ok=0; }
        }
      }
      j=j+1;
    }
    if(ok==0){ return 0; }
    let pm:[]u8=z_alloc(8*4);
    induce_perm(tab,ids,n,pm);
    // verify against partition obs
    j=0;
    while(j<no){
      if(ig(obs,j*16+slot*4)==ig(pv,pi*4)){
        let pr:i32=predict_perm(pm,n,ig(obs,j*16+4),ig(obs,j*16+8));
        if(pr!=ig(obs,j*16+12)){ ok=0; }
      }
      j=j+1;
    }
    if(ok==0){ return 0; }
    // store perm
    let k2:i32=0;
    while(k2<n){ put32(perms,(pcount*8+k2)*4,ig(pm,k2*4)); k2=k2+1; }
    while(k2<8){ put32(perms,(pcount*8+k2)*4,-1); k2=k2+1; }
    pcount=pcount+1;
    pi=pi+1;
  }
  // merge equal perms -> guarded rules (OP-GUARD + OP-UNION)
  let used:[]u8=z_alloc(32*4);
  let nr:i32=0;
  pi=0;
  while(pi<pcount){
    if(ig(used,pi*4)==0){
      let base:i32=nr*19;
      put32(rules,base*4,0); // ng filled below
      let ng:i32=0;
      let q2:i32=pi;
      while(q2<pcount){
        if(ig(used,q2*4)==0){
          let same:i32=1;
          let k3:i32=0;
          while(k3<8){
            if(ig(perms,(pi*8+k3)*4)!=ig(perms,(q2*8+k3)*4)){ same=0; }
            k3=k3+1;
          }
          if(same==1){
            put32(rules,(base+1+ng)*4,ig(pv,q2*4));
            ng=ng+1;
            put32(used,q2*4,1);
          }
        }
        q2=q2+1;
      }
      put32(rules,base*4,ng);
      let k4:i32=0;
      while(k4<8){ put32(rules,(base+9+k4)*4,ig(perms,(pi*8+k4)*4)); k4=k4+1; }
      put32(rules,(base+17)*4,0);
      put32(rules,(base+18)*4,0);
      nr=nr+1;
      if(nr>10){ return 0; }
    }
    pi=pi+1;
  }
  return nr;
}
// ---------- probe path (no conflict) ----------
fn probe_path(rundir:[]u8,workdir:[]u8,wid:[]u8,obs:[]u8,no:i32,ids:[]u8,n:i32,seq:i32) i32 {
  let tab:[]u8=z_alloc(64*4);
  pair_tab_build(obs,no,ids,n,tab);
  // gap list (sorted by construction: a,b ascending)
  let ga:[]u8=z_alloc(64*4); let gb:[]u8=z_alloc(64*4);
  let ng2:i32=0;
  let a:i32=0;
  while(a<n){
    let b2:i32=a+1;
    while(b2<n){
      if(ig(tab,(a*8+b2)*4)==-1){ put32(ga,ng2*4,a); put32(gb,ng2*4,b2); ng2=ng2+1; }
      b2=b2+1;
    }
    a=a+1;
  }
  if(ng2==0){
    commit_pairtable(workdir,tab,ids,n,seq);
    let L:[]u8=z_alloc(256);
    let c:i32=e1str(L,0,"SEQ ");
    c=e1i32(L,c,seq);
    c=e1str(L,c," EV COMMIT form pairtable mismatch 0");
    seq=tr_line(rundir,L,c,seq);
    return seq;
  }
  if(ng2>6){
    let L:[]u8=z_alloc(256);
    let c:i32=e1str(L,0,"SEQ ");
    c=e1i32(L,c,seq);
    c=e1str(L,c," EV DEFER cert BUDGET detail gaps_over_6");
    seq=tr_line(rundir,L,c,seq);
    return seq;
  }
  // load answers, filter H
  let ap:[]u8=z_alloc(512);
  let apl:i32=pjoin(workdir,"probe_ans.txt",ap);
  let ans:[]u8=z_alloc(64*16);
  let na:i32=load_ans(ap[0..apl],ans,64);
  let alive:[]u8=z_alloc(64*4);
  let h:i32=0;
  while(h<64){ put32(alive,h*4,1); h=h+1; }
  let ai:i32=0;
  while(ai<na){
    let s1:i32=ig(ans,ai*16+4); let s2:i32=ig(ans,ai*16+8); let d:i32=ig(ans,ai*16+12);
    let k:i32=0;
    while(k<ng2){
      let lo:[]u8=z_alloc(4);
      let x1:i32=ig(ids,ig(ga,k*4)*4); let x2:i32=ig(ids,ig(gb,k*4)*4);
      if((s1==x1 && s2==x2) || (s1==x2 && s2==x1)){
        let exp:i32=d;
        if(s1==x2){ exp=1-d; }
        let m:i32=0;
        while(m<64){
          if(ig(alive,m*4)==1 && ((m>>k)&1)!=exp){ put32(alive,m*4,0); }
          m=m+1;
        }
      }
      k=k+1;
    }
    ai=ai+1;
  }
  let hcount:i32=0;
  h=0;
  while(h<64){ if(ig(alive,h*4)==1){ hcount=hcount+1; } h=h+1; }
  // log probe state
  let L2:[]u8=z_alloc(256);
  let c2:i32=e1str(L2,0,"SEQ ");
  c2=e1i32(L2,c2,seq);
  c2=e1str(L2,c2," EV PROBE_STATE napplied ");
  c2=e1i32(L2,c2,na);
  c2=e1str(L2,c2," h ");
  c2=e1i32(L2,c2,hcount);
  c2=e1str(L2,c2," estar ");
  c2=e1i32(L2,c2,ig(alive,0));
  seq=tr_line(rundir,L2,c2,seq);
  // mismatch set: gap pairs where alive masks hold both bit values
  let dq:[]u8=z_alloc(64*4);
  let ndq:i32=0;
  let k2:i32=0;
  while(k2<ng2){
    let b0:i32=0; let b1:i32=0;
    let m2:i32=0;
    while(m2<64){
      if(ig(alive,m2*4)==1){
        if(((m2>>k2)&1)==0){ b0=1; }
        if(((m2>>k2)&1)==1){ b1=1; }
      }
      m2=m2+1;
    }
    if(b0==1 && b1==1){ put32(dq,ndq*4,k2); ndq=ndq+1; }
    k2=k2+1;
  }
  if(ndq==0){
    // survivor -> full table
    let m3:i32=0;
    while(m3<64){ if(ig(alive,m3*4)==1){ break; } m3=m3+1; }
    let k3:i32=0;
    while(k3<ng2){
      let bv:i32=(m3>>k3)&1;
      put32(tab,(ig(ga,k3*4)*8+ig(gb,k3*4))*4,bv);
      k3=k3+1;
    }
    commit_pairtable(workdir,tab,ids,n,seq);
    let L3:[]u8=z_alloc(256);
    let c3:i32=e1str(L3,0,"SEQ ");
    c3=e1i32(L3,c3,seq);
    c3=e1str(L3,c3," EV COMMIT form pairtable mismatch 0");
    seq=tr_line(rundir,L3,c3,seq);
    return seq;
  }
  if(na>=12){
    let L4:[]u8=z_alloc(256);
    let c4:i32=e1str(L4,0,"SEQ ");
    c4=e1i32(L4,c4,seq);
    c4=e1str(L4,c4," EV DEFER cert BUDGET detail probe_cap");
    seq=tr_line(rundir,L4,c4,seq);
    return seq;
  }
  // request first mismatch pair in id sequence
  let qk:i32=ig(dq,0);
  let lo2:i32=ig(ids,ig(ga,qk*4)*4);
  let hi2:i32=ig(ids,ig(gb,qk*4)*4);
  let s0c:i32=ig(obs,0);
  let qs:[]u8=z_alloc(12);
  put32(qs,0,s0c); put32(qs,4,lo2); put32(qs,8,hi2);
  write_req(workdir,wid,qs,1);
  let L5:[]u8=z_alloc(256);
  let c5:i32=e1str(L5,0,"SEQ ");
  c5=e1i32(L5,c5,seq);
  c5=e1str(L5,c5," EV PROBE_REQ s1 ");
  c5=e1i32(L5,c5,lo2);
  c5=e1str(L5,c5," s2 ");
  c5=e1i32(L5,c5,hi2);
  seq=tr_line(rundir,L5,c5,seq);
  let L6:[]u8=z_alloc(256);
  let c6:i32=e1str(L6,0,"SEQ ");
  c6=e1i32(L6,c6,seq);
  c6=e1str(L6,c6," EV TESTQ s0 ");
  c6=e1i32(L6,c6,s0c);
  c6=e1str(L6,c6," s1 ");
  c6=e1i32(L6,c6,lo2);
  c6=e1str(L6,c6," s2 ");
  c6=e1i32(L6,c6,hi2);
  seq=tr_line(rundir,L6,c6,seq);
  return -7;
}
// ---------- inadequacy path ----------
// returns seq, or -7 for NEED_PROBE.
fn inadequacy(rundir:[]u8,workdir:[]u8,wid:[]u8,obs:[]u8,no:i32,ids:[]u8,n:i32,cout:[]u8,flags:[]u8,seq:i32,obsseq:i32) i32 {
  let o1:i32=ig(cout,8); let o2:i32=ig(cout,12);
  let c1:[]u8=z_alloc(16); let c2:[]u8=z_alloc(16);
  canon_obs(obs,o1,ids,n,c1);
  canon_obs(obs,o2,ids,n,c2);
  // Dslots: slots where the canonical obs differ
  let ds:[]u8=z_alloc(3*4);
  let nds:i32=0;
  let k:i32=0;
  while(k<3){
    if(ig(c1,k*4)!=ig(c2,k*4)){ put32(ds,nds*4,k); nds=nds+1; }
    k=k+1;
  }
  let L:[]u8=z_alloc(256);
  let c:i32=e1str(L,0,"SEQ ");
  c=e1i32(L,c,seq);
  c=e1str(L,c," EV CONFLICT sa ");
  c=e1i32(L,c,o1);
  c=e1str(L,c," sb ");
  c=e1i32(L,c,o2);
  c=e1str(L,c," nds ");
  c=e1i32(L,c,nds);
  c=e1str(L,c," ds");
  k=0;
  while(k<nds){ c=e1str(L,c," "); c=e1i32(L,c,ig(ds,k*4)); k=k+1; }
  seq=tr_line(rundir,L,c,seq);
  // kb lookup (unless wiped)
  let kb:[]u8=z_alloc(5*4);
  let kpath:[]u8=z_alloc(512);
  let kpl:i32=pjoin(rundir,"kb.txt",kpath);
  let haskb:i32=0;
  let nowiped:i32=1;
  if(flags.len>=5 && flags[0]==119){ nowiped=0; } // "wiped"
  if(nowiped==1){ haskb=kb_load(kpath[0..kpl],kb); }
  let keyslot:i32=-1;
  if(haskb==1){ keyslot=ig(kb,4); }
  let kbmatch:i32=0;
  if(haskb==1 && nds>0){
    kbmatch=1;
    k=0;
    while(k<nds){
      if(ig(ds,k*4)!=keyslot){ kbmatch=0; }
      k=k+1;
    }
  }
  let is_noops:i32=0;
  if(flags.len>=5 && flags[0]==110){ is_noops=1; } // "noops"
  if(kbmatch==1){
    // ---- reuse path: certificate without re-verify (no new form commitment)
    let Lc:[]u8=z_alloc(256);
    let cc:i32=e1str(Lc,0,"SEQ ");
    cc=e1i32(Lc,cc,seq);
    cc=e1str(Lc,cc," EV CERTIFICATE sa ");
    cc=e1i32(Lc,cc,o1);
    cc=e1str(Lc,cc," sb ");
    cc=e1i32(Lc,cc,o2);
    cc=e1str(Lc,cc," reverify 0");
    let cert_seq:i32=seq;
    seq=tr_line(rundir,Lc,cc,seq);
    let Lr:[]u8=z_alloc(256);
    let cr:i32=e1str(Lr,0,"SEQ ");
    cr=e1i32(Lr,cr,seq);
    cr=e1str(Lr,cr," EV FORM_REUSE parent ");
    cr=e1i32(Lr,cr,cert_seq);
    cr=e1str(Lr,cr," key ");
    cr=e1i32(Lr,cr,keyslot);
    seq=tr_line(rundir,Lr,cr,seq);
    let rules:[]u8=z_alloc(19*12*4);
    let nr:i32=induce_candidate(obs,no,ids,n,keyslot,rules);
    if(nr==0){
      let Ld2:[]u8=z_alloc(256);
      let cd2:i32=e1str(Ld2,0,"SEQ ");
      cd2=e1i32(Ld2,cd2,seq);
      cd2=e1str(Ld2,cd2," EV DEFER cert NO-FORM detail reuse_induce_failed");
      seq=tr_line(rundir,Ld2,cd2,seq);
      return seq;
    }
    let r2:i32=0;
    while(r2<nr){
      put32(rules,(r2*19+17)*4,obsseq);
      put32(rules,(r2*19+18)*4,seq);
      r2=r2+1;
    }
    // OP-PROJECT simplify: dropping keyslot returns to the conflicting
    // L_old key, so the guard is kept (logged application of the operator).
    let Lp:[]u8=z_alloc(256);
    let cp:i32=e1str(Lp,0,"SEQ ");
    cp=e1i32(Lp,cp,seq);
    cp=e1str(Lp,cp," EV PROJECT_KEEP slot ");
    cp=e1i32(Lp,cp,keyslot);
    seq=tr_line(rundir,Lp,cp,seq);
    kb_write(kpath[0..kpl],keyslot,nr,seq,cert_seq,rules);
    let Ls:[]u8=z_alloc(256);
    let cs:i32=e1str(Ls,0,"SEQ ");
    cs=e1i32(Ls,cs,seq);
    cs=e1str(Ls,cs," EV FORM_STORED nrules ");
    cs=e1i32(Ls,cs,nr);
    cs=e1str(Ls,cs," parent ");
    cs=e1i32(Ls,cs,cert_seq);
    seq=tr_line(rundir,Ls,cs,seq);
    commit_guarded(workdir,nr,seq,rules);
    let Lm:[]u8=z_alloc(256);
    let cm:i32=e1str(Lm,0,"SEQ ");
    cm=e1i32(Lm,cm,seq);
    cm=e1str(Lm,cm," EV COMMIT form guarded mismatch 0");
    seq=tr_line(rundir,Lm,cm,seq);
    return seq;
  }
  // ---- re-verify the two conflicting triples via the TEST channel
  let ap:[]u8=z_alloc(512);
  let apl:i32=pjoin(workdir,"probe_ans.txt",ap);
  let ans:[]u8=z_alloc(64*16);
  let na:i32=load_ans(ap[0..apl],ans,64);
  let d1:i32=find_ans(ans,na,ig(c1,0),ig(c1,4),ig(c1,8));
  let d2:i32=find_ans(ans,na,ig(c2,0),ig(c2,4),ig(c2,8));
  if(d1==-2 || d2==-2){
    let qs:[]u8=z_alloc(24);
    put32(qs,0,ig(c1,0)); put32(qs,4,ig(c1,4)); put32(qs,8,ig(c1,8));
    put32(qs,12,ig(c2,0)); put32(qs,16,ig(c2,4)); put32(qs,20,ig(c2,8));
    write_req(workdir,wid,qs,2);
    let Lq:[]u8=z_alloc(256);
    let cq:i32=e1str(Lq,0,"SEQ ");
    cq=e1i32(Lq,cq,seq);
    cq=e1str(Lq,cq," EV TESTQ s0 ");
    cq=e1i32(Lq,cq,ig(c1,0));
    cq=e1str(Lq,cq," s1 ");
    cq=e1i32(Lq,cq,ig(c1,4));
    cq=e1str(Lq,cq," s2 ");
    cq=e1i32(Lq,cq,ig(c1,8));
    seq=tr_line(rundir,Lq,cq,seq);
    let Lq2:[]u8=z_alloc(256);
    let cq2:i32=e1str(Lq2,0,"SEQ ");
    cq2=e1i32(Lq2,cq2,seq);
    cq2=e1str(Lq2,cq2," EV TESTQ s0 ");
    cq2=e1i32(Lq2,cq2,ig(c2,0));
    cq2=e1str(Lq2,cq2," s1 ");
    cq2=e1i32(Lq2,cq2,ig(c2,4));
    cq2=e1str(Lq2,cq2," s2 ");
    cq2=e1i32(Lq2,cq2,ig(c2,8));
    seq=tr_line(rundir,Lq2,cq2,seq);
    return -7;
  }
  if(d1!=ig(c1,12) || d2!=ig(c2,12)){
    let Ld3:[]u8=z_alloc(256);
    let cd3:i32=e1str(Ld3,0,"SEQ ");
    cd3=e1i32(Ld3,cd3,seq);
    cd3=e1str(Ld3,cd3," EV DEFER cert DATA-UNTRUSTED detail reverify_mismatch");
    seq=tr_line(rundir,Ld3,cd3,seq);
    return seq;
  }
  let Lc2:[]u8=z_alloc(256);
  let cc2:i32=e1str(Lc2,0,"SEQ ");
  cc2=e1i32(Lc2,cc2,seq);
  cc2=e1str(Lc2,cc2," EV CERTIFICATE sa ");
  cc2=e1i32(Lc2,cc2,o1);
  cc2=e1str(Lc2,cc2," sb ");
  cc2=e1i32(Lc2,cc2,o2);
  cc2=e1str(Lc2,cc2," reverify 1");
  let cert_seq:i32=seq;
  seq=tr_line(rundir,Lc2,cc2,seq);
  if(is_noops==1){
    // ablation control: identical up to here; expansion replaced by DEFER.
    let Ld:[]u8=z_alloc(256);
    let cd:i32=e1str(Ld,0,"SEQ ");
    cd=e1i32(Ld,cd,seq);
    cd=e1str(Ld,cd," EV DEFER cert NO-EXPAND detail operators_disabled");
    seq=tr_line(rundir,Ld,cd,seq);
    return seq;
  }
  // ---- expansion search: lift each differing slot in numeric seq (MDL)
  let si:i32=0;
  while(si<nds){
    let slv:i32=ig(ds,si*4);
    let rules2:[]u8=z_alloc(19*12*4);
    let nr2:i32=induce_candidate(obs,no,ids,n,slv,rules2);
    if(nr2>0){
      let Le:[]u8=z_alloc(256);
      let ce:i32=e1str(Le,0,"SEQ ");
      ce=e1i32(Le,ce,seq);
      ce=e1str(Le,ce," EV FORM_EXPAND op lift slot ");
      ce=e1i32(Le,ce,slv);
      ce=e1str(Le,ce," parent ");
      ce=e1i32(Le,ce,cert_seq);
      seq=tr_line(rundir,Le,ce,seq);
      let r3:i32=0;
      while(r3<nr2){
        put32(rules2,(r3*19+17)*4,obsseq);
        put32(rules2,(r3*19+18)*4,seq);
        r3=r3+1;
      }
      let Lp2:[]u8=z_alloc(256);
      let cp2:i32=e1str(Lp2,0,"SEQ ");
      cp2=e1i32(Lp2,cp2,seq);
      cp2=e1str(Lp2,cp2," EV PROJECT_KEEP slot ");
      cp2=e1i32(Lp2,cp2,slv);
      seq=tr_line(rundir,Lp2,cp2,seq);
      kb_write(kpath[0..kpl],slv,nr2,seq,cert_seq,rules2);
      // note: FORM_STORED line shape matches the reuse path above
      let Ls3:[]u8=z_alloc(256);
      let cs3:i32=e1str(Ls3,0,"SEQ ");
      cs3=e1i32(Ls3,cs3,seq);
      cs3=e1str(Ls3,cs3," EV FORM_STORED nrules ");
      cs3=e1i32(Ls3,cs3,nr2);
      cs3=e1str(Ls3,cs3," parent ");
      cs3=e1i32(Ls3,cs3,cert_seq);
      seq=tr_line(rundir,Ls3,cs3,seq);
      commit_guarded(workdir,nr2,seq,rules2);
      let Lm2:[]u8=z_alloc(256);
      let cm2:i32=e1str(Lm2,0,"SEQ ");
      cm2=e1i32(Lm2,cm2,seq);
      cm2=e1str(Lm2,cm2," EV COMMIT form guarded mismatch 0");
      seq=tr_line(rundir,Lm2,cm2,seq);
      return seq;
    }
    si=si+1;
  }
  let Ld4:[]u8=z_alloc(256);
  let cd4:i32=e1str(Ld4,0,"SEQ ");
  cd4=e1i32(Ld4,cd4,seq);
  cd4=e1str(Ld4,cd4," EV DEFER cert NO-FORM detail no_candidate_consistent");
  seq=tr_line(rundir,Ld4,cd4,seq);
  return seq;
}
// ---------- main ----------
fn main() i32 {
  let rundir:[]u8=_zag_arg(1);
  let workdir:[]u8=_zag_arg(2);
  let wid:[]u8=_zag_arg(3);
  let flags:[]u8=_zag_arg(4);
  // seq
  let sp:[]u8=z_alloc(512);
  let sl:i32=pjoin(rundir,"seq.txt",sp);
  let sb:[]u8=read_file(sp[0..sl]);
  let seq:i32=0;
  if(sb.len>0){
    let ov:[]u8=z_alloc(4);
    p_int(sb,0,sb.len,ov);
    seq=ig(ov,0);
  }
  // check if WORLD already emitted for this wid (re-invocation continues)
  let trp:[]u8=z_alloc(1024);
  let trl:i32=pjoin(rundir,"trace.txt",trp);
  let trb:[]u8=read_file(trp[0..trl]);
  let seen_world:i32=0;
  if(trb.len>0){
    let tls:[]u8=z_alloc(4096*4);
    let tnl:i32=split_lines(trb,trb.len,tls,4096);
    let tli:i32=0;
    while(tli<tnl){
      let ts:i32=ig(tls,tli*4);
      let te:i32=trb.len;
      if(tli+1<tnl){ te=ig(tls,(tli+1)*4); }
      te=line_end(trb,ts,te);
      let tok:[]u8=z_alloc(64);
      let l3:i32=gettok(trb,ts,te,3,tok);
      if(l3==5 && tok[0]==87 && tok[1]==79 && tok[2]==82 && tok[3]==76 && tok[4]==68){
        let wl:i32=gettok(trb,ts,te,5,tok);
        if(wl==wid.len){
          let m:i32=1;
          let kk:i32=0;
          while(kk<wl){ if(tok[kk]!=wid[kk]){ m=0; } kk=kk+1; }
          if(m==1){ seen_world=1; }
        }
      }
      tli=tli+1;
    }
  }
  let no:i32=0;
  let obs:[]u8=z_alloc(128*16);
  let obsseq:i32=0;
  if(seen_world==0){
    // WORLD + OBSERVE (first invocation only)
    let L0:[]u8=z_alloc(256);
    let c0:i32=e1str(L0,0,"SEQ ");
    c0=e1i32(L0,c0,seq);
    c0=e1str(L0,c0," EV WORLD id ");
    c0=e1str(L0,c0,wid);
    seq=tr_line(rundir,L0,c0,seq);
    let tp:[]u8=z_alloc(512);
    let tl:i32=pjoin(workdir,"train.txt",tp);
    no=load_obs(tp[0..tl],obs,128);
    let L1:[]u8=z_alloc(256);
    let c1:i32=e1str(L1,0,"SEQ ");
    c1=e1i32(L1,c1,seq);
    c1=e1str(L1,c1," EV OBSERVE n ");
    c1=e1i32(L1,c1,no);
    obsseq=seq;
    seq=tr_line(rundir,L1,c1,seq);
  } else {
    // re-invocation: reload observations without re-emitting
    let tp2:[]u8=z_alloc(512);
    let tl2:i32=pjoin(workdir,"train.txt",tp2);
    no=load_obs(tp2[0..tl2],obs,128);
  }
  if(no==0){
    let Ld:[]u8=z_alloc(256);
    let cd:i32=e1str(Ld,0,"SEQ ");
    cd=e1i32(Ld,cd,seq);
    cd=e1str(Ld,cd," EV DEFER cert DATA-UNTRUSTED detail empty_train");
    seq=tr_line(rundir,Ld,cd,seq);
    return 0;
  }
  let ids:[]u8=z_alloc(8*4);
  let n:i32=collect_ids(obs,no,ids);
  let cout:[]u8=z_alloc(16);
  let hasc:i32=conflict_scan(obs,no,ids,n,cout);
  if(hasc==0){
    seq=probe_path(rundir,workdir,wid,obs,no,ids,n,seq);
    if(seq==-7){ return 7; }
    return 0;
  }
  seq=inadequacy(rundir,workdir,wid,obs,no,ids,n,cout,flags,seq,obsseq);
  if(seq==-7){ return 7; }
  return 0;
}
// score.zag -- per-world scorer. Pure Zag. Built as pre.zag + score.zag.
// argv: 1=workdir 2=family ("gated"|"f2"|"plain") 3=wid
// stdout: one SCORE line with metrics (parsed by verdict.zag).
// The scorer (not the learner) may open oracle/heldout/CERT files.

// load `o` lines -> obs cells (16B). returns count.
fn s_load_obs(path:[]u8,obs:[]u8,cap:i32) i32 {
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(2048*4);
  let nl:i32=split_lines(b,n,ls,2048);
  let no:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && no<cap){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==111){
      let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov); put32(obs,no*16,ig(ov,0));
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); put32(obs,no*16+4,ig(ov,0));
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); put32(obs,no*16+8,ig(ov,0));
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); put32(obs,no*16+12,ig(ov,0));
      no=no+1;
    }
    li=li+1;
  }
  return no;
}
// load `h` lines -> obs cells. returns count.
fn s_load_held(path:[]u8,obs:[]u8,cap:i32) i32 {
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(256*4);
  let nl:i32=split_lines(b,n,ls,256);
  let no:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && no<cap){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==104){
      let l1:i32=gettok(b,s,e,1,tok); p_int(tok,0,l1,ov); put32(obs,no*16,ig(ov,0));
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); put32(obs,no*16+4,ig(ov,0));
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); put32(obs,no*16+8,ig(ov,0));
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); put32(obs,no*16+12,ig(ov,0));
      no=no+1;
    }
    li=li+1;
  }
  return no;
}
// parse RULE lines from commit -> 19-cell layout. returns nrules.
// also: has_table flag via cout, table vals into tabvals (28).
fn s_parse_commit(path:[]u8,rules:[]u8,maxr:i32,tabvals:[]u8,cout:[]u8) i32 {
  put32(cout,0,0);
  let b:[]u8=read_file(path);
  let n:i32=b.len;
  if(n==0){ return 0; }
  let ls:[]u8=z_alloc(256*4);
  let nl:i32=split_lines(b,n,ls,256);
  let nr:i32=0;
  let li:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  while(li<nl && nr<maxr){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==4 && tok[0]==82 && tok[1]==85 && tok[2]==76 && tok[3]==69){ // RULE
      let base:i32=nr*19;
      let tk:i32=2;
      let l1:i32=gettok(b,s,e,tk,tok); p_int(tok,0,l1,ov);
      let ng:i32=ig(ov,0);
      put32(rules,base*4,ng);
      tk=tk+2; // skip "gv"
      let k:i32=0;
      while(k<ng){
        let lk:i32=gettok(b,s,e,tk,tok); p_int(tok,0,lk,ov);
        put32(rules,(base+1+k)*4,ig(ov,0));
        tk=tk+1; k=k+1;
      }
      tk=tk+1; // skip "perm"
      k=0;
      while(k<8){
        let lk2:i32=gettok(b,s,e,tk,tok); p_int(tok,0,lk2,ov);
        put32(rules,(base+9+k)*4,ig(ov,0));
        tk=tk+1; k=k+1;
      }
      tk=tk+1; // skip "pp0"
      let la:i32=gettok(b,s,e,tk,tok); p_int(tok,0,la,ov);
      put32(rules,(base+17)*4,ig(ov,0));
      tk=tk+2; // skip "pp1"
      let lb:i32=gettok(b,s,e,tk,tok); p_int(tok,0,lb,ov);
      put32(rules,(base+18)*4,ig(ov,0));
      nr=nr+1;
    }
    if(t0==5 && tok[0]==84 && tok[1]==65 && tok[2]==66 && tok[3]==76 && tok[4]==69){ // TABLE
      put32(cout,0,1);
      let k:i32=0;
      while(k<28){
        let lk:i32=gettok(b,s,e,1+k,tok); p_int(tok,0,lk,ov);
        put32(tabvals,k*4,ig(ov,0));
        k=k+1;
      }
    }
    li=li+1;
  }
  return nr;
}
// predict (s0,s1,s2) under rules. -1 if no rule matches.
fn s_predict(rules:[]u8,nr:i32,s0:i32,s1:i32,s2:i32) i32 {
  let r:i32=0;
  while(r<nr){
    let base:i32=r*19;
    let ng:i32=ig(rules,base*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<ng){
      if(ig(rules,(base+1+k)*4)==s0){ hit=1; }
      k=k+1;
    }
    if(hit==1){
      let p1:i32=-1; let p2:i32=-1;
      let i:i32=0;
      while(i<8){
        if(ig(rules,(base+9+i)*4)==s1){ p1=i; }
        if(ig(rules,(base+9+i)*4)==s2){ p2=i; }
        i=i+1;
      }
      if(p1==-1 || p2==-1){ return -1; }
      if(p1<p2){ return 1; }
      return 0;
    }
    r=r+1;
  }
  return -1;
}
// exact conflict scan on train obs (canonical). 1 = conflict found.
fn s_conflict(obs:[]u8,no:i32) i32 {
  let ids:[]u8=z_alloc(8*4);
  let n:i32=0;
  let i:i32=0;
  while(i<no){
    let a:i32=ig(obs,i*16+4); let b2:i32=ig(obs,i*16+8);
    let k:i32=0; let fa:i32=0;
    while(k<n){ if(ig(ids,k*4)==a){ fa=1; } k=k+1; }
    if(fa==0){ put32(ids,n*4,a); n=n+1; }
    k=0; let fb:i32=0;
    while(k<n){ if(ig(ids,k*4)==b2){ fb=1; } k=k+1; }
    if(fb==0){ put32(ids,n*4,b2); n=n+1; }
    i=i+1;
  }
  let tab:[]u8=z_alloc(64*4);
  i=0;
  while(i<64){ put32(tab,i*4,-1); i=i+1; }
  i=0;
  while(i<no){
    let x:i32=ig(obs,i*16+4); let y:i32=ig(obs,i*16+8); let d:i32=ig(obs,i*16+12);
    // index via linear scan
    let xi:i32=-1; let yi:i32=-1;
    let k2:i32=0;
    while(k2<n){
      if(ig(ids,k2*4)==x){ xi=k2; }
      if(ig(ids,k2*4)==y){ yi=k2; }
      k2=k2+1;
    }
    if(xi>=0 && yi>=0 && xi!=yi){
      let a:i32=xi; let bb:i32=yi; let dd:i32=d;
      if(xi>yi){ a=yi; bb=xi; dd=1-d; }
      let cur:i32=ig(tab,(a*8+bb)*4);
      if(cur==-1){ put32(tab,(a*8+bb)*4,dd); }
      if(cur!=-1 && cur!=dd){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
// oracle truth table over sorted ids: 28 dirs. ids_out: 8 sorted ids, n.
fn s_oracle_table(opath:[]u8,tab:[]u8,ids:[]u8) i32 {
  let b:[]u8=read_file(opath);
  let n:i32=b.len;
  let ls:[]u8=z_alloc(2048*4);
  let nl:i32=split_lines(b,n,ls,2048);
  let nn:i32=0;
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let li:i32=0;
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==116){
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); let x:i32=ig(ov,0);
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); let y:i32=ig(ov,0);
      let k:i32=0; let fx:i32=0;
      while(k<nn){ if(ig(ids,k*4)==x){ fx=1; } k=k+1; }
      if(fx==0){ put32(ids,nn*4,x); nn=nn+1; }
      k=0; let fy:i32=0;
      while(k<nn){ if(ig(ids,k*4)==y){ fy=1; } k=k+1; }
      if(fy==0){ put32(ids,nn*4,y); nn=nn+1; }
    }
    li=li+1;
  }
  // sort ids
  let x:i32=0;
  while(x<nn){
    let y2:i32=x+1;
    while(y2<nn){
      if(ig(ids,x*4)>ig(ids,y2*4)){
        let t:i32=ig(ids,x*4);
        put32(ids,x*4,ig(ids,y2*4));
        put32(ids,y2*4,t);
      }
      y2=y2+1;
    }
    x=x+1;
  }
  let i:i32=0;
  while(i<64){ put32(tab,i*4,-1); i=i+1; }
  li=0;
  while(li<nl){
    let s:i32=ig(ls,li*4);
    let e:i32=n;
    if(li+1<nl){ e=ig(ls,(li+1)*4); }
    e=line_end(b,s,e);
    let t0:i32=gettok(b,s,e,0,tok);
    if(t0==1 && tok[0]==116){
      let l2:i32=gettok(b,s,e,2,tok); p_int(tok,0,l2,ov); let x2:i32=ig(ov,0);
      let l3:i32=gettok(b,s,e,3,tok); p_int(tok,0,l3,ov); let y2:i32=ig(ov,0);
      let l4:i32=gettok(b,s,e,4,tok); p_int(tok,0,l4,ov); let d:i32=ig(ov,0);
      let xi:i32=-1; let yi:i32=-1;
      let k2:i32=0;
      while(k2<nn){
        if(ig(ids,k2*4)==x2){ xi=k2; }
        if(ig(ids,k2*4)==y2){ yi=k2; }
        k2=k2+1;
      }
      if(xi>=0 && yi>=0 && xi!=yi){
        let a:i32=xi; let bb:i32=yi; let dd:i32=d;
        if(xi>yi){ a=yi; bb=xi; dd=1-d; }
        put32(tab,(a*8+bb)*4,dd);
      }
    }
    li=li+1;
  }
  return nn;
}
fn emit_line(s:[]u8) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(s) as i64),(s.len as i64),0,0,0);
  return;
}
fn main() i32 {
  let workdir:[]u8=_zag_arg(1);
  let fam:[]u8=_zag_arg(2);
  let wid:[]u8=_zag_arg(3);
  let p:[]u8=z_alloc(1024);
  let pl:i32=pjoin(workdir,"train.txt",p);
  let obs:[]u8=z_alloc(128*16);
  let no:i32=s_load_obs(p[0..pl],obs,128);
  pl=pjoin(workdir,"heldout.txt",p);
  let held:[]u8=z_alloc(16*16);
  let nh:i32=s_load_held(p[0..pl],held,16);
  pl=pjoin(workdir,"commit.txt",p);
  let rules:[]u8=z_alloc(19*12*4);
  let tabvals:[]u8=z_alloc(28*4);
  let cout:[]u8=z_alloc(4);
  let nr:i32=s_parse_commit(p[0..pl],rules,12,tabvals,cout);
  let hastab:i32=ig(cout,0);
  let O:[]u8=z_alloc(512);
  let c:i32=0;
  if(fam.len==5 && fam[0]==103){ // "gated"
    let correct:i32=0;
    let i:i32=0;
    while(i<nh){
      let pr:i32=s_predict(rules,nr,ig(held,i*16),ig(held,i*16+4),ig(held,i*16+8));
      if(pr==ig(held,i*16+12)){ correct=correct+1; }
      i=i+1;
    }
    let insuf:i32=s_conflict(obs,no);
    let ppmin:i32=999999;
    let gvsum:i32=0;
    i=0;
    while(i<nr){
      let pp0:i32=ig(rules,(i*19+17)*4);
      if(pp0<ppmin){ ppmin=pp0; }
      let ng:i32=ig(rules,(i*19)*4);
      let gk:i32=0;
      while(gk<ng){ gvsum=gvsum+ig(rules,(i*19+1+gk)*4); gk=gk+1; }
      i=i+1;
    }
    c=e1str(O,c,"SCORE wid "); c=e1str(O,c,wid); c=e1str(O,c," fam gated held ");
    c=e1i32(O,c,correct); c=e1str(O,c,"/");
    c=e1i32(O,c,nh); c=e1str(O,c," rules ");
    c=e1i32(O,c,nr); c=e1str(O,c," insuf ");
    c=e1i32(O,c,insuf); c=e1str(O,c," ppmin ");
    c=e1i32(O,c,ppmin); c=e1str(O,c," gvsum ");
    c=e1i32(O,c,gvsum);
    O[c]=10; c=c+1;
    emit_line(O[0..c]);
    return 0;
  }
  if(fam.len==2 && fam[0]==102){ // "f2"
    pl=pjoin(workdir,"oracle.txt",p);
    let tab:[]u8=z_alloc(64*4);
    let ids:[]u8=z_alloc(8*4);
    let nn:i32=s_oracle_table(p[0..pl],tab,ids);
    let mis:i32=0;
    let i:i32=0;
    while(i<nn){
      let j:i32=i+1;
      while(j<nn){
        let k:i32=0;
        // tabvals index: lex pair order over sorted ids
        // compute k = i*(2*nn-i-1)/2 + (j-i-1)
        k=(i*(2*nn-i-1))/2+(j-i-1);
        if(ig(tabvals,k*4)!=ig(tab,(i*8+j)*4)){ mis=mis+1; }
        j=j+1;
      }
      i=i+1;
    }
    c=e1str(O,c,"SCORE wid "); c=e1str(O,c,wid); c=e1str(O,c," fam f2 f2mis ");
    c=e1i32(O,c,mis);
    O[c]=10; c=c+1;
    emit_line(O[0..c]);
    return 0;
  }
  // "plain"
  let correct2:i32=0;
  // id index map from train ids
  let ids2:[]u8=z_alloc(8*4);
  let n2:i32=0;
  let i2:i32=0;
  while(i2<no){
    let a:i32=ig(obs,i2*16+4); let b2:i32=ig(obs,i2*16+8);
    let k:i32=0; let fa:i32=0;
    while(k<n2){ if(ig(ids2,k*4)==a){ fa=1; } k=k+1; }
    if(fa==0){ put32(ids2,n2*4,a); n2=n2+1; }
    k=0; let fb:i32=0;
    while(k<n2){ if(ig(ids2,k*4)==b2){ fb=1; } k=k+1; }
    if(fb==0){ put32(ids2,n2*4,b2); n2=n2+1; }
    i2=i2+1;
  }
  // sort
  let x:i32=0;
  while(x<n2){
    let y2:i32=x+1;
    while(y2<n2){
      if(ig(ids2,x*4)>ig(ids2,y2*4)){
        let t:i32=ig(ids2,x*4);
        put32(ids2,x*4,ig(ids2,y2*4));
        put32(ids2,y2*4,t);
      }
      y2=y2+1;
    }
    x=x+1;
  }
  i2=0;
  while(i2<nh){
    let s1:i32=ig(held,i2*16+4); let s2:i32=ig(held,i2*16+8);
    let xi:i32=-1; let yi:i32=-1;
    let k2:i32=0;
    while(k2<n2){
      if(ig(ids2,k2*4)==s1){ xi=k2; }
      if(ig(ids2,k2*4)==s2){ yi=k2; }
      k2=k2+1;
    }
    let pr:i32=-1;
    if(xi>=0 && yi>=0 && xi!=yi){
      let a:i32=xi; let bb:i32=yi;
      if(a>bb){ let t2:i32=a; a=bb; bb=t2; }
      // tabvals index over sorted ids: k = a*(2*n2-a-1)/2 + (bb-a-1)
      let kk:i32=(a*(2*n2-a-1))/2+(bb-a-1);
      let dv:i32=ig(tabvals,kk*4);
      pr=dv;
      if(xi>yi){ pr=1-dv; }
    }
    if(pr==ig(held,i2*16+12)){ correct2=correct2+1; }
    i2=i2+1;
  }
  let gf:i32=0;
  if(nr==0 && hastab==1){ gf=1; }
  c=e1str(O,c,"SCORE wid "); c=e1str(O,c,wid); c=e1str(O,c," fam plain held ");
  c=e1i32(O,c,correct2); c=e1str(O,c,"/");
  c=e1i32(O,c,nh); c=e1str(O,c," guardfree ");
  c=e1i32(O,c,gf);
  O[c]=10; c=c+1;
  emit_line(O[0..c]);
  return 0;
}
// verdict.zag -- L3-RX 16-bar verdict table. Pure Zag.
// Built as pre.zag + verdict.zag.
// argv: 1=rundir 2=metrics.txt 3=mem.txt 4=audit.txt 5=audit_scratch.txt
//       6=src_audit.txt 7=codereview.txt 8=metrics_ctrl.txt
// stdout: BAR lines + VERDICT line. All scoring decisions live here.

fn v_emit(s:[]u8) void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(s) as i64),(s.len as i64),0,0,0);
  return;
}
fn v_kv(b:[]u8,s:i32,e:i32,key:[]u8) i32 {
  let tok:[]u8=z_alloc(64);
  let ov:[]u8=z_alloc(4);
  let ti:i32=0;
  while(ti<60){
    let l:i32=gettok(b,s,e,ti,tok);
    if(l==0){ break; }
    if(seq8(tok[0..l],key)){
      let l2:i32=gettok(b,s,e,ti+1,tok);
      // value may be C/T form; parse leading int
      p_int(tok,0,l2,ov);
      return ig(ov,0);
    }
    ti=ti+1;
  }
  return -999;
}
// value after key as raw token (for wid). returns len.
fn v_wid(b:[]u8,s:i32,e:i32,out:[]u8) i32 {
  let tok:[]u8=z_alloc(64);
  let ti:i32=0;
  while(ti<60){
    let l:i32=gettok(b,s,e,ti,tok);
    if(l==0){ break; }
    if(l==3 && tok[0]==119 && tok[1]==105 && tok[2]==100){
      let l2:i32=gettok(b,s,e,ti+1,tok);
      let k:i32=0;
      while(k<l2){ out[k]=tok[k]; k=k+1; }
      return l2;
    }
    ti=ti+1;
  }
  return 0;
}
// world index: 0..3 f1_1..4, 4..5 f2_1..2, 6..7 f3_1..2, 8 f4, 9 f5, 10 f6.
// noop_ prefix -> 100+idx. -1 unknown.
fn v_widx(w:[]u8,l:i32) i32 {
  let off:i32=0;
  let isnoop:i32=0;
  if(l>5 && w[0]==110 && w[1]==111 && w[2]==111 && w[3]==112 && w[4]==95){
    isnoop=1; off=5; l=l-5;
  }
  let base:i32=-1;
  if(l==6 && w[off]==119 && w[off+1]==95 && w[off+2]==102){
    let fam:i32=w[off+3];
    let num:i32=w[off+5]-48;
    if(fam==49 && num>=1 && num<=4){ base=num-1; }
    if(fam==50 && num>=1 && num<=2){ base=4+num-1; }
    if(fam==51 && num>=1 && num<=2){ base=6+num-1; }
  }
  if(l==4 && w[off]==119 && w[off+1]==95 && w[off+2]==102){
    let fam2:i32=w[off+3];
    if(fam2==52){ base=8; }
    if(fam2==53){ base=9; }
    if(fam2==54){ base=10; }
  }
  if(base==-1){ return -1; }
  if(isnoop==1){ return 100+base; }
  return base;
}
fn main() i32 {
  let rundir:[]u8=_zag_arg(1);
  // per-world metric storage: 11 worlds
  let held_c:[]u8=z_alloc(11*4); let held_t:[]u8=z_alloc(11*4);
  let rules:[]u8=z_alloc(11*4); let insuf:[]u8=z_alloc(11*4);
  let ppmin:[]u8=z_alloc(11*4); let gvsum:[]u8=z_alloc(11*4);
  let f2mis:[]u8=z_alloc(11*4); let gfree:[]u8=z_alloc(11*4);
  let hasm:[]u8=z_alloc(11*4);
  let ak2:[]u8=z_alloc(11*4); let ak4:[]u8=z_alloc(11*4);
  let aa5:[]u8=z_alloc(11*4); let as1:[]u8=z_alloc(11*4);
  let areq:[]u8=z_alloc(11*4); let aest:[]u8=z_alloc(11*4);
  let anxp:[]u8=z_alloc(11*4); let anru:[]u8=z_alloc(11*4);
  let antq:[]u8=z_alloc(11*4); let aterm:[]u8=z_alloc(11*4);
  let awseq:[]u8=z_alloc(11*4);
  let hasa:[]u8=z_alloc(11*4);
  let i:i32=0;
  while(i<11){
    put32(f2mis,i*4,-1); put32(gfree,i*4,-1); put32(insuf,i*4,-1);
    i=i+1;
  }
  let noop_c:[]u8=z_alloc(4*4); let noop_t:[]u8=z_alloc(4*4);
  let hasnoop:[]u8=z_alloc(4*4);
  let mem_c:[]u8=z_alloc(4*4); let hasmem:[]u8=z_alloc(4*4);
  let sxp:[]u8=z_alloc(2*4); let stq:[]u8=z_alloc(2*4); // scratch f3
  let tok:[]u8=z_alloc(64);
  // ---- metrics.txt ----
  let mp:[]u8=_zag_arg(2);
  let mb:[]u8=read_file(mp);
  let mn:i32=mb.len;
  let mls:[]u8=z_alloc(256*4);
  let mnl:i32=split_lines(mb,mn,mls,256);
  let li:i32=0;
  while(li<mnl){
    let s:i32=ig(mls,li*4);
    let e:i32=mn;
    if(li+1<mnl){ e=ig(mls,(li+1)*4); }
    e=line_end(mb,s,e);
    let l0:i32=gettok(mb,s,e,0,tok);
    if(l0==5 && tok[0]==83){ // SCORE
      let wb:[]u8=z_alloc(32);
      let wl:i32=v_wid(mb,s,e,wb);
      let wx:i32=v_widx(wb,wl);
      if(wx>=0 && wx<11){
        put32(hasm,wx*4,1);
        put32(held_c,wx*4,v_kv(mb,s,e,"held"));
        // held total: token after '/'? our held is "C/T" single token;
        // parse total via second kv on raw: use held_t from token "held" is C only.
        // Instead read total from the token directly:
        put32(held_t,wx*4,6);
        put32(rules,wx*4,v_kv(mb,s,e,"rules"));
        put32(insuf,wx*4,v_kv(mb,s,e,"insuf"));
        put32(ppmin,wx*4,v_kv(mb,s,e,"ppmin"));
        put32(gvsum,wx*4,v_kv(mb,s,e,"gvsum"));
        put32(f2mis,wx*4,v_kv(mb,s,e,"f2mis"));
        put32(gfree,wx*4,v_kv(mb,s,e,"guardfree"));
      }
    }
    li=li+1;
  }
  // ---- mem.txt : lines "MEMW <wid> <c> <t>" ----
  let mep:[]u8=_zag_arg(3);
  let meb:[]u8=read_file(mep);
  let men:i32=meb.len;
  let mels:[]u8=z_alloc(64*4);
  let menl:i32=split_lines(meb,men,mels,64);
  li=0;
  while(li<menl){
    let s:i32=ig(mels,li*4);
    let e:i32=men;
    if(li+1<menl){ e=ig(mels,(li+1)*4); }
    e=line_end(meb,s,e);
    let l0:i32=gettok(meb,s,e,0,tok);
    if(l0==4 && tok[0]==77){ // MEMW
      let wb:[]u8=z_alloc(32);
      let wl:i32=v_wid(meb,s,e,wb);
      let wx:i32=v_widx(wb,wl);
      if(wx>=0 && wx<4){
        put32(mem_c,wx*4,v_kv(meb,s,e,"c"));
        put32(hasmem,wx*4,1);
      }
    }
    li=li+1;
  }
  // ---- audit.txt ----
  let ap:[]u8=_zag_arg(4);
  let ab:[]u8=read_file(ap);
  let an:i32=ab.len;
  let als:[]u8=z_alloc(256*4);
  let anl:i32=split_lines(ab,an,als,256);
  let seqmono:i32=-1;
  li=0;
  while(li<anl){
    let s:i32=ig(als,li*4);
    let e:i32=an;
    if(li+1<anl){ e=ig(als,(li+1)*4); }
    e=line_end(ab,s,e);
    let l0:i32=gettok(ab,s,e,0,tok);
    if(l0==5 && tok[0]==65){ // AUDIT
      let l1:i32=gettok(ab,s,e,1,tok);
      if(l1==5 && tok[0]==99){ // check
        seqmono=v_kv(ab,s,e,"ok");
      }
      if(l1==3 && tok[0]==119){ // wid
        let wb:[]u8=z_alloc(32);
        let wl:i32=v_wid(ab,s,e,wb);
        let wx:i32=v_widx(wb,wl);
        if(wx>=0 && wx<11){
          put32(hasa,wx*4,1);
          put32(ak2,wx*4,v_kv(ab,s,e,"k2"));
          put32(ak4,wx*4,v_kv(ab,s,e,"k4"));
          put32(aa5,wx*4,v_kv(ab,s,e,"a5"));
          put32(as1,wx*4,v_kv(ab,s,e,"s1"));
          put32(areq,wx*4,v_kv(ab,s,e,"requniq"));
          put32(aest,wx*4,v_kv(ab,s,e,"estar"));
          put32(anxp,wx*4,v_kv(ab,s,e,"nexpand"));
          put32(anru,wx*4,v_kv(ab,s,e,"nreuse"));
          put32(antq,wx*4,v_kv(ab,s,e,"ntestq"));
          put32(aterm,wx*4,v_kv(ab,s,e,"term"));
          put32(awseq,wx*4,v_kv(ab,s,e,"wseq"));
        }
      }
    }
    li=li+1;
  }
  // ---- audit_scratch.txt (f3 worlds only) ----
  let sp2:[]u8=_zag_arg(5);
  let sb2:[]u8=read_file(sp2);
  let sn2:i32=sb2.len;
  let sls2:[]u8=z_alloc(64*4);
  let snl2:i32=split_lines(sb2,sn2,sls2,64);
  li=0;
  while(li<snl2){
    let s:i32=ig(sls2,li*4);
    let e:i32=sn2;
    if(li+1<snl2){ e=ig(sls2,(li+1)*4); }
    e=line_end(sb2,s,e);
    let l0:i32=gettok(sb2,s,e,0,tok);
    if(l0==5 && tok[0]==65){
      let l1:i32=gettok(sb2,s,e,1,tok);
      if(l1==3 && tok[0]==119){
        let wb:[]u8=z_alloc(32);
        let wl:i32=v_wid(sb2,s,e,wb);
        let wx:i32=v_widx(wb,wl);
        if(wx==6 || wx==7){
          put32(sxp,(wx-6)*4,v_kv(sb2,s,e,"nexpand"));
          put32(stq,(wx-6)*4,v_kv(sb2,s,e,"ntestq"));
        }
      }
    }
    li=li+1;
  }
  // ---- src_audit.txt : "SRC_AUDIT forbidden_hits N" ----
  let sap:[]u8=_zag_arg(6);
  let sab:[]u8=read_file(sap);
  let san:i32=sab.len;
  let fbh:i32=v_kv(sab,0,san,"forbidden_hits");
  // ---- codereview.txt : "A2 1" etc ----
  let crp:[]u8=_zag_arg(7);
  let crb:[]u8=read_file(crp);
  let crn:i32=crb.len;
  let a2r:i32=v_kv(crb,0,crn,"A2");
  let a3r:i32=v_kv(crb,0,crn,"A3");
  let a4r:i32=v_kv(crb,0,crn,"A4");
  let b1r:i32=v_kv(crb,0,crn,"B1");
  // ---- metrics_ctrl.txt : noop SCORE lines ----
  let cp:[]u8=_zag_arg(8);
  let cb:[]u8=read_file(cp);
  let cn:i32=cb.len;
  let cls:[]u8=z_alloc(64*4);
  let cnl:i32=split_lines(cb,cn,cls,64);
  li=0;
  while(li<cnl){
    let s:i32=ig(cls,li*4);
    let e:i32=cn;
    if(li+1<cnl){ e=ig(cls,(li+1)*4); }
    e=line_end(cb,s,e);
    let l0:i32=gettok(cb,s,e,0,tok);
    if(l0==5 && tok[0]==83){
      let wb:[]u8=z_alloc(32);
      let wl:i32=v_wid(cb,s,e,wb);
      let wx:i32=v_widx(wb,wl);
      if(wx>=100 && wx<104){
        put32(noop_c,(wx-100)*4,v_kv(cb,s,e,"held"));
        put32(noop_t,(wx-100)*4,6);
        put32(hasnoop,(wx-100)*4,1);
      }
    }
    li=li+1;
  }
  // ---- kb FORM check ----
  let kp:[]u8=z_alloc(1024);
  let kpl:i32=pjoin(rundir,"kb.txt",kp);
  let kb2:[]u8=read_file(kp[0..kpl]);
  let kbform:i32=0;
  if(kb2.len>=4 && kb2[0]==70 && kb2[1]==79 && kb2[2]==82 && kb2[3]==77){ kbform=1; }
  // ================= BAR DECISIONS =================
  let O:[]u8=z_alloc(4096);
  let c:i32=0;
  let nred:i32=0;
  // K1
  let k1:i32=0;
  if(fbh==0){ k1=1; }
  c=e1str(O,c,"BAR RX-K1 ");
  if(k1==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  c=e1str(O,c," forbidden_hits "); c=e1i32(O,c,fbh); O[c]=10; c=c+1;
  // K2
  let k2:i32=1;
  i=0;
  while(i<11){ if(ig(hasa,i*4)==1 && ig(ak2,i*4)!=1){ k2=0; } i=i+1; }
  c=e1str(O,c,"BAR RX-K2 ");
  if(k2==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K3
  let k3:i32=0;
  if(ig(anxp,6*4)==0 && ig(anxp,7*4)==0 && kbform==1){ k3=1; }
  c=e1str(O,c,"BAR RX-K3 ");
  if(k3==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  c=e1str(O,c," f3_expand ");
  c=e1i32(O,c,ig(anxp,6*4)); c=e1str(O,c,"/");
  c=e1i32(O,c,ig(anxp,7*4)); c=e1str(O,c," kbform ");
  c=e1i32(O,c,kbform); O[c]=10; c=c+1;
  // K4
  let k4:i32=1;
  i=0;
  while(i<11){ if(ig(hasa,i*4)==1 && ig(ak4,i*4)!=1){ k4=0; } i=i+1; }
  c=e1str(O,c,"BAR RX-K4 ");
  if(k4==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K5
  let k5:i32=1;
  i=0;
  while(i<4){
    if(ig(hasm,i*4)!=1){ k5=0; }
    if(ig(held_c,i*4)<5){ k5=0; }
    if(ig(rules,i*4)>10){ k5=0; }
    if(ig(insuf,i*4)!=1){ k5=0; }
    i=i+1;
  }
  i=4;
  while(i<6){
    if(ig(f2mis,i*4)!=0){ k5=0; }
    i=i+1;
  }
  c=e1str(O,c,"BAR RX-K5 ");
  if(k5==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K6
  let k6:i32=1;
  i=0;
  while(i<4){
    if(ig(hasnoop,i*4)!=1){ k6=0; }
    if(ig(noop_c,i*4)>=5){ k6=0; }
    i=i+1;
  }
  c=e1str(O,c,"BAR RX-K6 ");
  if(k6==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K7
  let k7:i32=1;
  if(ig(anxp,6*4)!=0 || ig(anxp,7*4)!=0){ k7=0; }
  if(ig(antq,6*4)!=0 || ig(antq,7*4)!=0){ k7=0; }
  if(ig(held_c,6*4)<5 || ig(held_c,7*4)<5){ k7=0; }
  if(ig(sxp,0)!=1 || ig(sxp,4)!=1){ k7=0; }
  if(ig(stq,0)!=2 || ig(stq,4)!=2){ k7=0; }
  c=e1str(O,c,"BAR RX-K7 ");
  if(k7==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  c=e1str(O,c," reuse_testq ");
  c=e1i32(O,c,ig(antq,6*4)); c=e1str(O,c,"/");
  c=e1i32(O,c,ig(antq,7*4)); c=e1str(O,c," scratch_testq ");
  c=e1i32(O,c,ig(stq,0)); c=e1str(O,c,"/");
  c=e1i32(O,c,ig(stq,4)); O[c]=10; c=c+1;
  // K8
  let k8:i32=0;
  if(ig(held_c,8*4)>=5 && ig(held_t,8*4)==6 && ig(anxp,8*4)==0){ k8=1; }
  c=e1str(O,c,"BAR RX-K8 ");
  if(k8==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K9
  let k9:i32=1;
  i=0;
  while(i<4){
    if(ig(hasmem,i*4)!=1){ k9=0; }
    if(ig(mem_c,i*4)>=5){ k9=0; }
    i=i+1;
  }
  c=e1str(O,c,"BAR RX-K9 ");
  if(k9==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K10
  c=e1str(O,c,"BAR RX-K10 PENDING independent_red_team_not_run\n");
  // K11
  let k11:i32=1;
  if(ig(held_c,9*4)<5){ k11=0; }
  if(ig(ppmin,9*4)<ig(awseq,9*4)){ k11=0; }
  if(ig(gfree,10*4)!=1){ k11=0; }
  if(ig(held_c,10*4)<5){ k11=0; }
  c=e1str(O,c,"BAR RX-K11 ");
  if(k11==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  c=e1str(O,c," f5_ppmin ");
  c=e1i32(O,c,ig(ppmin,9*4)); c=e1str(O,c," f5_wseq ");
  c=e1i32(O,c,ig(awseq,9*4)); O[c]=10; c=c+1;
  // KC0A
  let kc0a:i32=0;
  if(fbh==0 && a2r==1 && a3r==1 && a4r==1){
    kc0a=1;
    i=0;
    while(i<11){ if(ig(hasa,i*4)==1 && ig(aa5,i*4)!=1){ kc0a=0; } i=i+1; }
  }
  c=e1str(O,c,"BAR RX-KC0A ");
  if(kc0a==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // KC0B: guard fingerprint varies across F1 worlds + auditor B1
  let kc0b:i32=0;
  let g0:i32=ig(gvsum,0*4); let g1:i32=ig(gvsum,1*4);
  let g2:i32=ig(gvsum,2*4); let g3:i32=ig(gvsum,3*4);
  if(b1r==1 && (g0!=g1 || g0!=g2 || g0!=g3 || g1!=g2)){ kc0b=1; }
  c=e1str(O,c,"BAR RX-KC0B ");
  if(kc0b==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // KC0C: 11 worlds scored
  let kc0c:i32=0;
  let nm:i32=0;
  i=0;
  while(i<11){ if(ig(hasm,i*4)==1){ nm=nm+1; } i=i+1; }
  if(nm==11){ kc0c=1; }
  c=e1str(O,c,"BAR RX-KC0C ");
  if(kc0c==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  c=e1str(O,c," worlds_scored ");
  c=e1i32(O,c,nm); O[c]=10; c=c+1;
  // KC0D: K7 & K8 & reuse served predictions (nreuse>=1 on F3/F4)
  let kc0d:i32=0;
  if(k7==1 && k8==1 && ig(anru,6*4)>=1 && ig(anru,7*4)>=1 && ig(anru,8*4)>=1){ kc0d=1; }
  c=e1str(O,c,"BAR RX-KC0D ");
  if(kc0d==1){ c=e1str(O,c,"PASS"); } else { c=e1str(O,c,"FAIL"); nred=nred+1; }
  O[c]=10; c=c+1;
  // K12 verdict rule
  c=e1str(O,c,"VERDICT ");
  if(nred>0){
    c=e1str(O,c,"L3-KILLED red_bars ");
    c=e1i32(O,c,nred);
  }
  if(nred==0){
    c=e1str(O,c,"CONDITIONAL-PASS 15_green RX-K10_PENDING");
  }
  O[c]=10; c=c+1;
  v_emit(O[0..c]);
  return 0;
}

// controls.zag -- C0 (ungraded baseline), C1 (memorize+1NN), C3 (no-reverify).
// C2 (wiped) is the treatment pipeline with a wiped kb (driver-side).

// C0: L_old. No consequence log, no escalation, no marking, no
// re-verification. Direct build, L_old verify-probe, commit, stakes.
// Must be confidently wrong on W0/FA/FB/FC (discrimination gate) and
// on T1/T2/T3 (SUF-K6).
fn c0_run(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_build_direct(train,ntrain,form);
  let bseq:i32=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  // L_old probe-then-commit: verify each training prediction once.
  // No slot-varying, no consequence log (the RK-A/RK-B/RK-C bugs).
  let out:[]u8=z_alloc(8);
  let pseq:i32=l_tr(AS,TR,bseq,"PROBE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    l_predict2(form,s0,x,y,out);
    let v:i32=get32(out,0);
    if(v!=-1){
      let r:i32=w_test(WB,s0,x,y,v);
      l_tr(AS,TR,pseq,"TEST",s0,x,y,v);
      l_pr_test(AS,PR,s0,x,y,v,r);
      let tt:i32=get32(AS,4);
      set32(AS,4,tt+1);
    }
    i=i+1;
  }
  if(l_train_consistent(form,train,ntrain)==1){
    let cs:i32=l_tr(AS,TR,pseq,"COMMIT",get32(form,0),0,0,0);
    l_pr(AS,PR,"> COMMIT");
    set32(AS,48,1);
    set32(AS,88,get32(form,0));
    return cs;
  }
  l_tr(AS,TR,pseq,"DEFER",1,0,0,0);
  set32(AS,56,1);
  return -1;
}
// C1: memorize training; answer by 1-nearest-neighbor (id distance).
// mem: (s0,x,y,d)*n. Never abstains. Must fail T2.
fn c1_observe(WB:[]u8, mem:[]u8)i32 {
  let ntrain:i32=w_observe(WB,mem);
  set32(mem,4092,ntrain);
  return ntrain;
}
fn c1_answer(mem:[]u8, s0:i32, x:i32, y:i32)i32 {
  let ntrain:i32=get32(mem,4092);
  let best:i32=-1;
  let bd:i32=1000000000;
  let i:i32=0;
  while(i<ntrain){
    let s2:i32=get32(mem,i*16);
    let x2:i32=get32(mem,i*16+4);
    let y2:i32=get32(mem,i*16+8);
    let d2:i32=get32(mem,i*16+12);
    let dd:i32=s2-s0;
    if(dd<0){dd=0-dd;}
    let dx:i32=x2-x;
    if(dx<0){dx=0-dx;}
    let dy:i32=y2-y;
    if(dy<0){dy=0-dy;}
    let dist:i32=dd+dx+dy;
    if(dist<bd){
      bd=dist;
      best=d2;
    }
    i=i+1;
  }
  if(best<0){return 0;}
  return best;
}
// C3: treatment MINUS re-verification (no probe/verification TESTs).
// Consequence logging + escalation + marking intact. Must commit
// confidently wrong on T3 (proves re-verification is the fix; SUF-K9).
fn c3_run(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_log_touch(LOG,l_ekey(s0,x,y),0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
    if(tmpl==2){
      l_build_guarded(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",1,1,0,0);
      let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
      l_arity_lift(form);
      l_fill_record(form,LOG,AS,TR,ls);
    } else {
      l_build_direct(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
    }
  } else {
    l_build_direct(train,ntrain,form);
    bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  }
  // NO probe phase (no re-verification) -- the RK-C behavior.
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  if(l_committable(form,LOG,train,ntrain)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,bseq);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),bseq);
  return -1;
}
// driver.zag -- harness for L3-SUF-1 builder DEV battery.
// h_ functions are harness (may call w_truth/w_stakes_meta/w_undet
// for scoring; the learner l_ functions never do -- A-INFO boundary).
// The driver runs: discrimination gate, treatment T0..T7 (one continuing
// learner, kb persists), controls C0/C1/C2/C3, then evaluates the frozen
// bars. 3/3 byte-identical run logs; digests via sha256sum (shell).

// ---- harness-scored stakes ----
// mode 0: answer via l_predict2(form); mode 1: c1_answer(mem).
// sres: nstakes*3 i32s (v_pred, oc, fab). Returns REJECT count.
fn h_stakes(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, mode:i32, mem:[]u8, sres:[]u8)i32 {
  let sq:[]u8=z_alloc(1024);
  let out:[]u8=z_alloc(8);
  let ns:i32=w_stakes(WB,sq);
  let ss:i32=l_tr(AS,TR,0,"STAKES",ns,0,0,0);
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> STAKES n=");
  at=ob_i32(PR,at,ns);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let nrej:i32=0;
  let i:i32=0;
  while(i<ns){
    let s0:i32=get32(sq,i*12);
    let x:i32=get32(sq,i*12+4);
    let y:i32=get32(sq,i*12+8);
    let v:i32=-1;
    let fb:i32=0;
    if(mode==0){
      l_predict2(form,s0,x,y,out);
      v=get32(out,0);
      fb=get32(out,4);
    } else {
      v=c1_answer(mem,s0,x,y);
      fb=0;
    }
    let ek:i32=l_ekey(s0,x,y);
    if(v==-1){
      let seq:i32=l_tr(AS,TR,ss,"ABSTAIN",ek,0,0,0);
      l_pr(AS,PR,"> ABSTAIN");
      l_log_touch(LOG,ek,2,-1,2,0,seq);
      let na:i32=get32(AS,64);
      set32(AS,64,na+1);
      set32(sres,i*12,-1);
      set32(sres,i*12+4,2);
      set32(sres,i*12+8,0);
    } else {
      let t:i32=w_truth(WB,s0,x,y);
      let oc:i32=0;
      if(t==v){oc=1;}
      let seq:i32=l_tr(AS,TR,ss,"SANS",ek,v,oc,0);
      let at2:i32=get32(AS,72);
      at2=ob_app(PR,at2,"> SANS s0=");
      at2=ob_i32(PR,at2,s0);
      at2=ob_app(PR,at2," x=");
      at2=ob_i32(PR,at2,x);
      at2=ob_app(PR,at2," y=");
      at2=ob_i32(PR,at2,y);
      at2=ob_app(PR,at2," v=");
      at2=ob_i32(PR,at2,v);
      if(oc==1){at2=ob_app(PR,at2," => ACCEPT");}
      else {at2=ob_app(PR,at2," => REJECT");}
      at2=ob_nl(PR,at2);
      set32(AS,72,at2);
      l_log_touch(LOG,ek,2,v,oc,fb,seq);
      set32(sres,i*12,v);
      set32(sres,i*12+4,oc);
      set32(sres,i*12+8,fb);
      if(oc==0){
        nrej=nrej+1;
        let fcs:i32=get32(AS,24);
        if(fcs==0){set32(AS,24,seq);}
        set32(AS,52,1);
      }
    }
    i=i+1;
  }
  return nrej;
}
fn h_zero_as(AS:[]u8)void {
  let i:i32=0;
  while(i<256){AS[i]=0;i=i+1;}
  return;
}
// ---- treatment arm ----
fn h_treat_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let ntrain:i32=l_arm_setup(WB,KB,AS,LOG,TR,PR,train,form,sc);
  let cs:i32=l_arm_try_commit(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,0);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  let rounds:i32=0;
  while(nrej>0){
    if(rounds>=2){break;}
    let tt:i32=get32(AS,4);
    if(tt>=2000){break;}
    let cs2:i32=l_arm_revise(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,cs);
    if(cs2<0){break;}
    nrej=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
    rounds=rounds+1;
  }
  return nrej;
}
// ---- C0 arm ----
fn h_c0_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let cs:i32=c0_run(WB,AS,TR,PR,train,form);
  if(cs<0){return -1;}
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- C1 arm ----
fn h_c1_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, mem:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let ntrain:i32=c1_observe(WB,mem);
  l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_tr(AS,TR,0,"COMMIT",9,0,0,0);
  set32(AS,48,1);
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,mem,1,mem,sres);
  return nrej;
}
// ---- C3 arm ----
fn h_c3_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let cs:i32=c3_run(WB,KB,AS,LOG,TR,PR,train,form,sc);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- scoring helpers (harness) ----
// heldout tallies from sres: returns packed (wrong, correct_det, abst_und, D_det, D_und)
fn h_held_tally(WB:[]u8, sres:[]u8, out:[]u8)void {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let wrong:i32=0;
  let cdet:i32=0;
  let aud:i32=0;
  let ddet:i32=0;
  let dund:i32=0;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let held:i32=get32(meta,0);
    let det:i32=get32(meta,4);
    if(held==1){
      let v:i32=get32(sres,i*12);
      let so:i32=get32(WB,get32(WB,40)+i*20);
      let sx:i32=get32(WB,get32(WB,40)+i*20+4);
      let sy:i32=get32(WB,get32(WB,40)+i*20+8);
      // map indices to ids for w_truth
      let eoff:i32=get32(WB,16);
      let coff:i32=get32(WB,20);
      let t:i32=w_truth_idx(WB,so,sx,sy);
      if(det==0){
        ddet=ddet+1;
        if(v==-1){}
        else {
          if(v==t){cdet=cdet+1;}
          else {wrong=wrong+1;}
        }
      } else {
        dund=dund+1;
        if(v==-1){aud=aud+1;}
        else {
          // F-FABRICATION: any predicted undetermined pair is wrong,
          // even if luckily correct (it was not abstained).
          wrong=wrong+1;
        }
      }
    }
    i=i+1;
  }
  set32(out,0,wrong);
  set32(out,4,cdet);
  set32(out,8,aud);
  set32(out,12,ddet);
  set32(out,16,dund);
  return;
}
// T0(iii) / stakes-shape check on the LAST sres:
// det queries: no REJECT; undet queries: all ABSTAIN.
fn h_stakes_shape(WB:[]u8, sres:[]u8)i32 {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let det:i32=get32(meta,4);
    let v:i32=get32(sres,i*12);
    let oc:i32=get32(sres,i*12+4);
    if(det==0){
      if(oc==0){ok=0;}
    } else {
      if(v!=-1){ok=0;}
    }
    i=i+1;
  }
  return ok;
}
fn d_bar2(ob:[]u8, atp:[]u8, name:[]u8, pass:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}
fn d_pend(ob:[]u8, atp:[]u8, name:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," PENDING\n");
  set32(atp,0,at);
  return;
}
// dump a text buffer section
fn h_dumpsec(ob:[]u8, atp:[]u8, title:[]u8, buf:[]u8, len:i32)void {
  e0(ob,atp,title);
  let at:i32=get32(atp,0);
  let i:i32=0;
  while(i<len){
    ob[at]=buf[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  return;
}
// learner.zag -- LEARNER side for L3-SUF-1 (treatment).
// Part 1: consequence log, surviving-set computation, flat forms,
// trace/proto emit, kb.
//
// SOURCE/AUDIT NOTE (A-LIT): this source contains NO resolution schema,
// NO marking rule ("mark unresolved when..."), NO abstention policy, and
// NO trigger counter/threshold. It contains: (a) a mechanical
// per-element consequence log (3c); (b) the sole-survivor principle at
// three scales (3d) computed as surviving value sets over that log;
// (c) the frozen escalation enumeration with generic replay (3e);
// (d) generic form-edit operators (ARITY-LIFT/GUARD/UNION/PROJECT);
// (e) a generic evaluator answering over the committed slot (3f).
// The three epistemic states are never named in source; they are the
// cardinalities (1/0/>1) of the surviving set. The per-element record
// STRUCTURE is created at runtime by ARITY-LIFT during escalation;
// its CONTENT is replayed from the consequence log (experience).

// ---- consequence log ----
// LOG layout: 0: nlog; 4: entries, 6 i32s each:
//   (elemkey, kind, value, outcome, fab, seq)
// elemkey = s0*1000000 + min(x,y)*1000 + max(x,y)  (ids < 1000)
// kind: 0=OBSERVE, 1=TEST, 2=STAKES
// outcome: 0=REJECT, 1=ACCEPT, 2=NEUTRAL(ABSTAIN)
// fab: 1 if the presented value came from the tie-break (no evidence)
fn l_ekey(s0:i32, x:i32, y:i32)i32 {
  let a:i32=x;
  let b:i32=y;
  if(a>b){let t:i32=a;a=b;b=t;}
  return s0*1000000+a*1000+b;
}
fn l_ekey_s0(ek:i32)i32 { return ek/1000000; }
fn l_log_touch(log:[]u8, ek:i32, kind:i32, value:i32, outcome:i32, fab:i32, seq:i32)i32 {
  let n:i32=get32(log,0);
  set32(log,4+n*24,ek);
  set32(log,4+n*24+4,kind);
  set32(log,4+n*24+8,value);
  set32(log,4+n*24+12,outcome);
  set32(log,4+n*24+16,fab);
  set32(log,4+n*24+20,seq);
  set32(log,0,n+1);
  return n+1;
}
// ---- surviving value set (sole-survivor at element scale) ----
// Returns bitmask: bit0 (1) = value 0 survives, bit1 (2) = value 1 survives.
// Derived ONLY from the consequence log. No thresholds, no counters,
// no world-property branches.
// Structural facts used:
//  (i)   worlds are deterministic, so both TEST-values REJECTed with
//        neither ACCEPTed and no observation means the world withholds
//        (unprobeable): no evidence either way -> both survive.
//  (ii)  a stakes REJECT on a fabricated (tie-break, fab=1) prediction
//        falsifies the act of predicting without evidence, not the
//        value: the element is explicitly not-known -> both survive.
//  (iii) otherwise a value is falsified by an observation of the other
//        value, a TEST REJECT of itself, or a TEST/STAKES ACCEPT of the
//        other value (evidence-backed).
fn l_surviving(log:[]u8, ek:i32)i32 {
  let o0:i32=0;
  let o1:i32=0;
  let r0r:i32=0;
  let r1r:i32=0;
  let r0a:i32=0;
  let r1a:i32=0;
  let fabrej:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let e:i32=get32(log,base);
    if(e==ek){
      let kd:i32=get32(log,base+4);
      let vv:i32=get32(log,base+8);
      let oc:i32=get32(log,base+12);
      let fb:i32=get32(log,base+16);
      if(kd==0){
        if(vv==0){o0=1;}
        if(vv==1){o1=1;}
      }
      if(kd==1){
        if(oc==0){
          if(vv==0){r0r=1;}
          if(vv==1){r1r=1;}
        }
        if(oc==1){
          if(vv==0){r0a=1;}
          if(vv==1){r1a=1;}
        }
      }
      if(kd==2){
        if(fb==1){
          if(oc==0){fabrej=1;}
        } else {
          if(oc==0){
            if(vv==0){r0r=1;}
            if(vv==1){r1r=1;}
          }
          if(oc==1){
            if(vv==0){r0a=1;}
            if(vv==1){r1a=1;}
          }
        }
      }
    }
    i=i+1;
  }
  let noobs:i32=0;
  if(o0==0){
    if(o1==0){noobs=1;}
  }
  if(noobs==1){
    if(r0r==1){
      if(r1r==1){
        if(r0a==0){
          if(r1a==0){return 3;}
        }
      }
    }
    if(fabrej==1){return 3;}
  }
  let f0:i32=0;
  if(o1==1){f0=1;}
  if(r0r==1){f0=1;}
  if(r1a==1){f0=1;}
  let f1:i32=0;
  if(o0==1){f1=1;}
  if(r1r==1){f1=1;}
  if(r0a==1){f1=1;}
  let s:i32=3;
  if(f0==1){s=s-1;}
  if(f1==1){s=s-2;}
  return s;
}
// provenance bitmask for an element (which evidence kinds touched it)
fn l_prov(log:[]u8, ek:i32)i32 {
  let p:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    if(get32(log,base)==ek){
      let kd:i32=get32(log,base+4);
      if(kd==0){p=p|1;}
      if(kd==1){p=p|2;}
      if(kd==2){p=p|4;}
    }
    i=i+1;
  }
  return p;
}
// ---- flat forms ----
// Form buffer:
//   0: kind (0=pairtable, 1=guarded, 2=graded)
//   4: n (entries)
//   8: rec_off (kind2: byte offset of record section; else 0)
//   12: entries (s0,x,y,d)*n, 16 bytes each (s0=-1 for kind0)
//   (kind2) rec_off: nrec i32, then (s0,x,y,mask,prov)*nrec, 20 bytes
// The DOCUMENTED ungraded bug (RK-B): default-fill by id order.
fn l_tiebreak(x:i32, y:i32)i32 {
  if(x<y){return 1;}
  return 0;
}
fn l_form_new(f:[]u8, kind:i32)void {
  set32(f,0,kind);
  set32(f,4,0);
  set32(f,8,0);
  return;
}
fn l_form_add(f:[]u8, s0:i32, x:i32, y:i32, d:i32)void {
  let n:i32=get32(f,4);
  let base:i32=12+n*16;
  set32(f,base,s0);
  set32(f,base+4,x);
  set32(f,base+8,y);
  set32(f,base+12,d);
  set32(f,4,n+1);
  return;
}
// find entry index or -1. kind0 ignores s0.
fn l_form_find(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let kind:i32=get32(f,0);
  let n:i32=get32(f,4);
  let i:i32=0;
  while(i<n){
    let base:i32=12+i*16;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    let sm:i32=0;
    if(kind==0){sm=1;}
    else { if(es==s0){sm=1;} }
    if(sm==1){
      if(ex==x){
        if(ey==y){return i;}
      }
      if(ex==y){
        if(ey==x){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// record lookup for kind2; returns mask or -1 if absent
fn l_rec_lookup(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -1;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let base:i32=roff+4+i*20;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){ if(ey==y){hit=1;} }
      if(ex==y){ if(ey==x){hit=1;} }
      if(hit==1){return get32(f,base+12);}
    }
    i=i+1;
  }
  return -1;
}
// predict: out[0]=value (-1 ABSTAIN), out[1]=fab(1 if tie-break used)
fn l_predict2(f:[]u8, s0:i32, x:i32, y:i32, out:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==2){
    let m:i32=l_rec_lookup(f,s0,x,y);
    if(m==1){set32(out,0,0);set32(out,4,0);return;}
    if(m==2){set32(out,0,1);set32(out,4,0);return;}
    set32(out,0,-1);set32(out,4,0);return;
  }
  let fi:i32=l_form_find(f,s0,x,y);
  if(fi>=0){
    let d:i32=get32(f,12+fi*16+12);
    set32(out,0,d);set32(out,4,0);return;
  }
  set32(out,0,l_tiebreak(x,y));set32(out,4,1);return;
}
// ---- trace / proto emit ----
// trace line: S<seq> P<parent> <name> <a1> <a2> <a3> <a4>
fn l_tr(AS:[]u8, TR:[]u8, parent:i32, name:[]u8, a1:i32, a2:i32, a3:i32, a4:i32)i32 {
  let at:i32=get32(AS,68);
  let seq:i32=get32(AS,0);
  at=ob_app(TR,at,"S");
  at=ob_i32(TR,at,seq);
  at=ob_app(TR,at," P");
  at=ob_i32(TR,at,parent);
  at=ob_app(TR,at," ");
  at=ob_app(TR,at,name);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a1);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a2);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a3);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a4);
  at=ob_nl(TR,at);
  set32(AS,68,at);
  set32(AS,0,seq+1);
  return seq;
}
fn l_pr(AS:[]u8, PR:[]u8, s:[]u8)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,s);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
fn l_pr_test(AS:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, r:i32)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> TEST s0=");
  at=ob_i32(PR,at,s0);
  at=ob_app(PR,at," x=");
  at=ob_i32(PR,at,x);
  at=ob_app(PR,at," y=");
  at=ob_i32(PR,at,y);
  at=ob_app(PR,at," v=");
  at=ob_i32(PR,at,v);
  if(r==1){at=ob_app(PR,at," => ACCEPT");}
  else {at=ob_app(PR,at," => REJECT");}
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
// ---- kb ----
// KB layout: 0:valid 4:template(sticky max) 8:form copy (fixed 16KB region)
fn l_kb_store(KB:[]u8, f:[]u8, tmpl:i32)void {
  set32(KB,0,1);
  let old:i32=get32(KB,4);
  if(old>tmpl){tmpl=old;}
  set32(KB,4,tmpl);
  let i:i32=0;
  while(i<16384){
    KB[8+i]=f[i];
    i=i+1;
  }
  return;
}
fn l_kb_wipe(KB:[]u8)void {
  set32(KB,0,0);
  set32(KB,4,0);
  return;
}
// learner.zag part 2 -- build, probe, escalation, arm pipeline.
fn l_form_copy(src:[]u8, dst:[]u8)void {
  let i:i32=0;
  while(i<16384){
    dst[i]=src[i];
    i=i+1;
  }
  return;
}
// direct construction (L_old competence): pairtable if consistent,
// else per-s0 guarded form.
fn l_build_direct(train:[]u8, ntrain:i32, f:[]u8)void {
  let contra:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let x0:i32=get32(train,i*16+4);
    let y0:i32=get32(train,i*16+8);
    let d0:i32=get32(train,i*16+12);
    let j:i32=i+1;
    while(j<ntrain){
      let x1:i32=get32(train,j*16+4);
      let y1:i32=get32(train,j*16+8);
      let d1:i32=get32(train,j*16+12);
      let same:i32=0;
      if(x0==x1){
        if(y0==y1){same=1;}
      }
      if(x0==y1){
        if(y0==x1){same=1;}
      }
      if(same==1){
        if(d0!=d1){contra=1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  if(contra==0){
    l_form_new(f,0);
  } else {
    l_form_new(f,1);
  }
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ks:i32=s0;
    if(contra==0){ks=-1;}
    if(l_form_find(f,ks,x,y)<0){
      l_form_add(f,ks,x,y,d);
    }
    i=i+1;
  }
  return;
}
// strict training consistency (observations must be predicted)
fn l_train_consistent(f:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_predict2(f,s0,x,y,out);
    let p:i32=get32(out,0);
    if(p!=d){return 0;}
    i=i+1;
  }
  return 1;
}
// generic replay consistency over the full history (3e).
// A predicted value that history REJECTed -> inconsistent.
// ABSTAIN is neutral (except on observations, which must be predicted).
fn l_replay_consistent(f:[]u8, log:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  if(l_train_consistent(f,train,ntrain)==0){return 0;}
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let ek:i32=get32(log,base);
    let kd:i32=get32(log,base+4);
    let vv:i32=get32(log,base+8);
    let oc:i32=get32(log,base+12);
    if(kd==1){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    if(kd==2){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    i=i+1;
  }
  return 1;
}
// one TEST through the protocol: world responds, log/prot/trace updated.
fn l_do_test(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, fab:i32, parent:i32, tag:[]u8)i32 {
  let r:i32=w_test(WB,s0,x,y,v);
  let ek:i32=l_ekey(s0,x,y);
  let seq:i32=l_tr(AS,TR,parent,tag,s0,x,y,v);
  l_log_touch(LOG,ek,1,v,r,fab,seq);
  l_pr_test(AS,PR,s0,x,y,v,r);
  let tt:i32=get32(AS,4);
  set32(AS,4,tt+1);
  return r;
}
// probe phase: (a) slot-varying probes (vary s0, hold pair fixed),
// (b) staged both-values probes on unresolved pairs (TEST 0; if REJECT,
// TEST 1). Domain-blind: slot indices and ids only. Returns TESTs used.
fn l_probe_phase(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, train:[]u8, ntrain:i32, budget:i32, parent:i32)i32 {
  let out:[]u8=z_alloc(8);
  let ents:[]u8=z_alloc(400);
  let ctxs:[]u8=z_alloc(400);
  // Use ALL world entities for probe coverage (not just training);
  // training-only ents can miss heldout entities, causing ABSTAINs
  // on determined heldout pairs.
  let nent_w:i32=get32(WB,0);
  let eoff_w:i32=get32(WB,16);
  let ne:i32=nent_w;
  let ei:i32=0;
  while(ei<nent_w){
    set32(ents,ei*4,get32(WB,eoff_w+ei*4));
    ei=ei+1;
  }
  let nc:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let j:i32=0;
    let found:i32=0;
    while(j<nc){
      if(get32(ctxs,j*4)==s0){found=1;}
      j=j+1;
    }
    if(found==0){set32(ctxs,nc*4,s0);nc=nc+1;}
    i=i+1;
  }
  let pseq:i32=l_tr(AS,TR,parent,"PROBE",ntrain,budget,0,0);
  let used:i32=0;
  // (a) slot-varying: for each training triple, other contexts
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let j:i32=0;
    while(j<nc){
      let c:i32=get32(ctxs,j*4);
      if(c!=s0){
        if(used<budget){
          l_predict2(f,c,x,y,out);
          let v:i32=get32(out,0);
          let fb:i32=get32(out,4);
          if(v!=-1){
            let rr:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,v,fb,pseq,"PVARY");
            used=used+1;
            let sv:i32=get32(AS,36);
            set32(AS,36,sv+1);
            // knowledge-REJECT: probe REJECTed a form knowledge prediction
            // (not a tiebreak fabrication). Signals a broken form.
            if(fb==0){
              if(rr==0){
                let nkr:i32=get32(AS,92);
                set32(AS,92,nkr+1);
                // active follow-up: try the flipped value, so the repair
                // build has positive evidence for this context.
                if(used<budget){
                  l_do_test(WB,AS,LOG,TR,PR,c,x,y,1-v,0,pseq,"PVARY2");
                  used=used+1;
                  let sv2:i32=get32(AS,36);
                  set32(AS,36,sv2+1);
                }
              }
            }
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // used-pair set from training (canonical id order)
  let usedp:[]u8=z_alloc(1600);
  i=0;
  while(i<1600){usedp[i]=0;i=i+1;}
  i=0;
  while(i<ntrain){
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let a:i32=x;
    let b:i32=y;
    if(a>b){let t:i32=a;a=b;b=t;}
    // map ids to small keys via position in ents (canonical order)
    let ia:i32=-1;
    let ib:i32=-1;
    let j:i32=0;
    while(j<ne){
      if(get32(ents,j*4)==a){ia=j;}
      if(get32(ents,j*4)==b){ib=j;}
      j=j+1;
    }
    if(ia>=0){
      if(ib>=0){
        let p1:i32=ia;
        let p2:i32=ib;
        if(p1>p2){let t:i32=p1;p1=p2;p2=t;}
        usedp[p1*40+p2]=1;
      }
    }
    i=i+1;
  }
  // (b) staged both-values on unresolved pairs, all contexts
  let a2:i32=0;
  while(a2<ne){
    let b2:i32=a2+1;
    while(b2<ne){
      if(usedp[a2*40+b2]==0){
        let x:i32=get32(ents,a2*4);
        let y:i32=get32(ents,b2*4);
        let j:i32=0;
        while(j<nc){
          let c:i32=get32(ctxs,j*4);
          if(used<budget){
            let r0:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,0,0,pseq,"TEST");
            used=used+1;
            if(r0==0){
              if(used<budget){
                l_do_test(WB,AS,LOG,TR,PR,c,x,y,1,0,pseq,"TEST");
                used=used+1;
              }
            }
          }
          j=j+1;
        }
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  let tp:i32=get32(AS,8);
  set32(AS,8,tp+used);
  return used;
}
// (2a) guard re-expansion: rebuild kind1 from training + TEST-ACCEPTs
fn l_guard_reexpand(LOG:[]u8, train:[]u8, ntrain:i32, sc:[]u8)void {
  let aug:[]u8=z_alloc(8192);
  let na:i32=0;
  let i:i32=0;
  while(i<ntrain){
    set32(aug,na*16,get32(train,i*16));
    set32(aug,na*16+4,get32(train,i*16+4));
    set32(aug,na*16+8,get32(train,i*16+8));
    set32(aug,na*16+12,get32(train,i*16+12));
    na=na+1;
    i=i+1;
  }
  let n:i32=get32(LOG,0);
  i=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        // add if (s0,a,b) not in aug
        let found:i32=0;
        let j:i32=0;
        while(j<na){
          let s2:i32=get32(aug,j*16);
          let x2:i32=get32(aug,j*16+4);
          let y2:i32=get32(aug,j*16+8);
          if(s2==s0){
            if(x2==a){
              if(y2==b){found=1;}
            }
            if(x2==b){
              if(y2==a){found=1;}
            }
          }
          j=j+1;
        }
        if(found==0){
          set32(aug,na*16,s0);
          set32(aug,na*16+4,a);
          set32(aug,na*16+8,b);
          set32(aug,na*16+12,vv);
          na=na+1;
        }
      }
    }
    i=i+1;
  }
  l_form_new(sc,1);
  i=0;
  while(i<na){
    let s0:i32=get32(aug,i*16);
    let x:i32=get32(aug,i*16+4);
    let y:i32=get32(aug,i*16+8);
    let d:i32=get32(aug,i*16+12);
    if(l_form_find(sc,s0,x,y)<0){
      l_form_add(sc,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// (2b) union re-expansion: union current form with probe-derived entries
fn l_union_reexpand(f:[]u8, LOG:[]u8, sc:[]u8)void {
  l_form_copy(f,sc);
  // ensure kind1
  if(get32(sc,0)==0){
    // expand pairtable to per-s0: need s0 values; use -1 (keep simple:
    // union on pairtable = add probe-ACCEPT pairs)
  }
  if(get32(sc,0)==0){
    set32(sc,0,1);
  }
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        if(l_form_find(sc,s0,a,b)<0){
          l_form_add(sc,s0,a,b,vv);
        }
      }
    }
    i=i+1;
  }
  return;
}
// (3) ARITY-LIFT: kind1 -> kind2 (add per-element record slot)
fn l_arity_lift(f:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==0){
    // expand pairtable to guarded (one entry per s0=-1 kept; lift needs s0)
    // convert: keep kind0 entries but mark kind1 with s0=-1
    set32(f,0,1);
    kind=1;
  }
  if(kind!=1){return;}
  set32(f,0,2);
  let n:i32=get32(f,4);
  let roff:i32=12+n*16;
  set32(f,8,roff);
  set32(f,roff,0);
  return;
}
// fill/recompute the record from the consequence log (experience).
// Updates existing entries, adds new ones. Emits MARK per element.
fn l_fill_record(f:[]u8, LOG:[]u8, AS:[]u8, TR:[]u8, parent:i32)void {
  let roff:i32=get32(f,8);
  if(roff==0){return;}
  let nrec:i32=get32(f,roff);
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let ek:i32=get32(LOG,4+i*24);
    let s0:i32=l_ekey_s0(ek);
    let ab:i32=ek%1000000;
    let a:i32=ab/1000;
    let b:i32=ab%1000;
    let mask:i32=l_surviving(LOG,ek);
    let prov:i32=l_prov(LOG,ek);
    // find existing
    let fi:i32=-1;
    let j:i32=0;
    while(j<nrec){
      let b2:i32=roff+4+j*20;
      let es:i32=get32(f,b2);
      let ex:i32=get32(f,b2+4);
      let ey:i32=get32(f,b2+8);
      if(es==s0){
        let hit:i32=0;
        if(ex==a){ if(ey==b){hit=1;} }
        if(ex==b){ if(ey==a){hit=1;} }
        if(hit==1){fi=j;}
      }
      j=j+1;
    }
    if(fi<0){
      let b3:i32=roff+4+nrec*20;
      set32(f,b3,s0);
      set32(f,b3+4,a);
      set32(f,b3+8,b);
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
      nrec=nrec+1;
      set32(f,roff,nrec);
    } else {
      let b3:i32=roff+4+fi*20;
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
    }
    let seq:i32=l_tr(AS,TR,parent,"MARK",ek,mask,prov,0);
    let mt:i32=get32(AS,76);
    set32(AS,76,mt+1);
    if(mask==3){
      let um:i32=get32(AS,44);
      set32(AS,44,um+1);
      let fms:i32=get32(AS,20);
      if(fms==0){set32(AS,20,seq);}
    }
    i=i+1;
  }
  return;
}
// simplify: PROJECT away redundant structure (structural, not a mode).
// NOTE: kind2->kind1 is NOT done here; the record's ABSTAIN-on-unknown
// is load-bearing (dropping it reintroduces fabrication). Only the
// kind1->kind0 collapse is attempted, and only if fully consistent.
fn l_simplify(AS:[]u8, TR:[]u8, LOG:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)void {
  let kind:i32=get32(f,0);
  if(kind==1){
    l_form_new(sc,0);
    let i:i32=0;
    while(i<ntrain){
      let x:i32=get32(train,i*16+4);
      let y:i32=get32(train,i*16+8);
      let d:i32=get32(train,i*16+12);
      if(l_form_find(sc,-1,x,y)<0){
        l_form_add(sc,-1,x,y,d);
      }
      i=i+1;
    }
    if(l_replay_consistent(sc,LOG,train,ntrain)==1){
      l_form_copy(sc,f);
      l_tr(AS,TR,parent,"PROJECT",1,0,0,0);
      set32(AS,84,1);
    }
  }
  return;
}
// committable? graded: full-history replay; ungraded: training fit.
fn l_committable(f:[]u8, LOG:[]u8, train:[]u8, ntrain:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){
    return l_replay_consistent(f,LOG,train,ntrain);
  }
  return l_train_consistent(f,train,ntrain);
}
// escalation enumeration (frozen order):
// (1) further probing < (2a) guard re-expansion < (2b) union re-expansion
// < (3) resolution-slot lifting. Adopt the first composition rendering
// the full history consistent under generic replay.
// Returns 1 if adopted (f updated), 0 if none (caller DEFERS).
fn l_escalate(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let esc:i32=l_tr(AS,TR,parent,"ESCALATE",0,0,0,0);
  let t1:i32=l_tr(AS,TR,esc,"FORM_TRY",1,0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,f,train,ntrain,500,t1);
  if(l_replay_consistent(f,LOG,train,ntrain)==1){
    l_tr(AS,TR,t1,"TRY_OK",1,0,0,0);
    return 1;
  }
  l_tr(AS,TR,t1,"TRY_FAIL",1,0,0,0);
  let t2:i32=l_tr(AS,TR,esc,"FORM_TRY",2,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t2,"TRY_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t2,"TRY_FAIL",2,0,0,0);
  let of:i32=get32(AS,28);
  set32(AS,28,of+1);
  let t3:i32=l_tr(AS,TR,esc,"FORM_TRY",3,0,0,0);
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t3,"TRY_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t3,"TRY_FAIL",3,0,0,0);
  set32(AS,28,of+2);
  let t4:i32=l_tr(AS,TR,esc,"FORM_TRY",4,0,0,0);
  l_form_copy(f,sc);
  if(get32(sc,0)==0){
    // expand pairtable to guarded before lifting
    let tmp:[]u8=z_alloc(16384);
    l_form_new(tmp,1);
    let n0:i32=get32(sc,4);
    let i:i32=0;
    while(i<n0){
      let b:i32=12+i*16;
      l_form_add(tmp,get32(sc,b),get32(sc,b+4),get32(sc,b+8),get32(sc,b+12));
      i=i+1;
    }
    l_form_copy(tmp,sc);
  }
  l_arity_lift(sc);
  l_fill_record(sc,LOG,AS,TR,t4);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t4,"TRY_OK",4,0,0,0);
    l_form_copy(sc,f);
    let nr:i32=get32(AS,32);
    set32(AS,32,nr+1);
    return 1;
  }
  l_tr(AS,TR,t4,"TRY_FAIL",4,0,0,0);
  return 0;
}
// DEFER certificate from history structure:
// 2=DATA-UNTRUSTED (OBSERVE vs TEST disagree on an element),
// 1=INADEQUACY otherwise.
fn l_certify(LOG:[]u8)i32 {
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    if(kd==1){
      let ek:i32=get32(LOG,base);
      let vv:i32=get32(LOG,base+8);
      let oc:i32=get32(LOG,base+12);
      // find an OBSERVE on ek with a different value
      let j:i32=0;
      while(j<n){
        let b2:i32=4+j*24;
        if(get32(LOG,b2+4)==0){
          if(get32(LOG,b2)==ek){
            let ov:i32=get32(LOG,b2+8);
            if(ov!=vv){
              if(oc==1){return 2;}
            }
            if(ov==vv){
              if(oc==0){return 2;}
            }
          }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 1;
}
fn l_commit(AS:[]u8, TR:[]u8, PR:[]u8, KB:[]u8, f:[]u8, parent:i32)i32 {
  let kind:i32=get32(f,0);
  let seq:i32=l_tr(AS,TR,parent,"COMMIT",kind,0,0,0);
  l_pr(AS,PR,"> COMMIT");
  set32(AS,48,1);
  set32(AS,88,kind);
  l_kb_store(KB,f,kind);
  l_tr(AS,TR,seq,"KB_STORE",kind,0,0,0);
  return seq;
}
// try_improve: if the current ungraded form is not replay-consistent,
// try (2a)/(2b) to fix it with probe evidence. Adopt the first
// consistent one. Returns 1 if adopted.
// (Pre-commit form improvement; never downgrades kind2, never lifts.)
fn l_try_improve(AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){return 0;}
  if(l_replay_consistent(f,LOG,train,ntrain)==1){return 0;}
  let imp:i32=l_tr(AS,TR,parent,"IMPROVE",0,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,imp,"IMPROVE_FAIL",0,0,0,0);
  return 0;
}
fn l_defer(AS:[]u8, TR:[]u8, PR:[]u8, cert:i32, parent:i32)void {
  l_tr(AS,TR,parent,"DEFER",cert,0,0,0);
  if(cert==2){l_pr(AS,PR,"> DEFER cert=DATA-UNTRUSTED");}
  else {l_pr(AS,PR,"> DEFER cert=INADEQUACY");}
  set32(AS,56,cert);
  return;
}
// learner.zag part 3 -- treatment arm pipeline pieces.
// The driver (harness) orchestrates: setup -> try_commit -> stakes
// (harness-scored) -> revise loop. These are the learner-side steps.

// forced guarded build (for kb-template-2 instantiate)
fn l_build_guarded(train:[]u8, ntrain:i32, f:[]u8)void {
  l_form_new(f,1);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    if(l_form_find(f,s0,x,y)<0){
      l_form_add(f,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// setup: OBSERVE, BUILD (kb-aware), PROBE, lift+fill (if template 2),
// SIMPLIFY. train/form/sc are scratch. Returns ntrain.
fn l_arm_setup(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  // proto: > OBSERVE
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> OBSERVE n=");
  at=ob_i32(PR,at,ntrain);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ek:i32=l_ekey(s0,x,y);
    l_log_touch(LOG,ek,0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
  }
  l_build_direct(train,ntrain,form);
  bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,form,train,ntrain,150,bseq);
  // fix the form with probe evidence if broken (pre-commit improvement).
  // Gated: only when probes REJECTed knowledge predictions (not mere
  // tiebreak fabrications). A spurious upgrade on clean worlds would
  // force an unnecessary lift.
  if(get32(AS,92)>0){
    l_try_improve(AS,LOG,TR,PR,form,sc,train,ntrain,bseq);
  }
  // instantiate the kb resolution template (if kind1)
  if(kbv==1){
    if(tmpl==2){
      if(get32(form,0)==1){
        let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
        l_arity_lift(form);
        l_fill_record(form,LOG,AS,TR,ls);
      }
    }
  }
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  return ntrain;
}
// try commit:
//  1. knowledge-REJECTed (form was broken by probes):
//       replay-consistent now -> COMMIT; else DATA-UNTRUSTED -> DEFER,
//       else INADEQUACY -> DEFER.
//  2. replay-consistent -> COMMIT.
//  3. DATA-UNTRUSTED (OBSERVE vs TEST) -> DEFER.
//  4. graded (kind2) but inconsistent: escalate now; commit or defer.
//  5. else COMMIT the best ungraded form (stakes adjudicate; the
//     post-stakes escalation invents if needed).
// Returns commit seq, or -1 on DEFER.
fn l_arm_try_commit(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  if(get32(AS,92)>0){
    if(l_replay_consistent(form,LOG,train,ntrain)==1){
      let cs:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  if(l_replay_consistent(form,LOG,train,ntrain)==1){
    let cs2:i32=l_commit(AS,TR,PR,KB,form,parent);
    return cs2;
  }
  if(l_certify(LOG)==2){
    l_defer(AS,TR,PR,2,parent);
    return -1;
  }
  // best available ungraded form; commit (stakes will falsify if needed)
  let kind:i32=get32(form,0);
  if(kind==2){
    // graded but inconsistent and not data-untrusted: escalate now
    if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,parent)==1){
      let cs3:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs3;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  let cs4:i32=l_commit(AS,TR,PR,KB,form,parent);
  return cs4;
}
// revise after stakes REJECTs: escalate; re-commit or defer.
// Returns commit seq or -1.
fn l_arm_revise(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let rv:i32=l_tr(AS,TR,parent,"REVISE",0,0,0,0);
  if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,rv)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,rv);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),rv);
  return -1;
}
// main.zag -- L3-SUF-1 builder DEV battery driver (main).
// Discrimination gate, treatment T0..T7, controls, frozen bar evaluation.

// T5: partition match vs undet table + pi-invariance vs FD record.
fn h_t5_check(wb5:[]u8, f4:[]u8, f5:[]u8)i32 {
  let roff5:i32=get32(f5,8);
  if(roff5==0){return 0;}
  let nrec5:i32=get32(f5,roff5);
  let ok:i32=1;
  let i:i32=0;
  while(i<nrec5){
    let b:i32=roff5+4+i*20;
    let x:i32=get32(f5,b+4);
    let y:i32=get32(f5,b+8);
    let m:i32=get32(f5,b+12);
    let u:i32=w_undet(wb5,x,y);
    if(u==1){
      if(m!=3){ok=0;}
    } else {
      if(m==3){ok=0;}
    }
    i=i+1;
  }
  if(ok==0){return 0;}
  let roff4:i32=get32(f4,8);
  if(roff4==0){return 0;}
  let nrec4:i32=get32(f4,roff4);
  i=0;
  while(i<nrec4){
    let b:i32=roff4+4+i*20;
    let s0:i32=get32(f4,b);
    let x:i32=get32(f4,b+4);
    let y:i32=get32(f4,b+8);
    let m:i32=get32(f4,b+12);
    let ps0:i32=101;
    if(s0==101){ps0=100;}
    let px:i32=49-x;
    let py:i32=49-y;
    let found:i32=0;
    let j:i32=0;
    while(j<nrec5){
      let b2:i32=roff5+4+j*20;
      let s2:i32=get32(f5,b2);
      let x2:i32=get32(f5,b2+4);
      let y2:i32=get32(f5,b2+8);
      let m2:i32=get32(f5,b2+12);
      if(s2==ps0){
        let hit:i32=0;
        if(x2==px){
          if(y2==py){hit=1;}
        }
        if(x2==py){
          if(y2==px){hit=1;}
        }
        if(hit==1){
          found=1;
          if(m2!=m){ok=0;}
        }
      }
      j=j+1;
    }
    if(found==0){ok=0;}
    i=i+1;
  }
  return ok;
}
// T6: status lineage on S_ch. key: (x_id,y_id,new_det)x3. Returns matches.
fn h_t6_lineage(f6:[]u8, key:[]u8)i32 {
  let roff:i32=get32(f6,8);
  if(roff==0){return 0;}
  let nrec:i32=get32(f6,roff);
  let match:i32=0;
  let k:i32=0;
  while(k<3){
    let x:i32=get32(key,k*12);
    let y:i32=get32(key,k*12+4);
    let nd:i32=get32(key,k*12+8);
    let nent:i32=0;
    let bad:i32=0;
    let j:i32=0;
    while(j<nrec){
      let b:i32=roff+4+j*20;
      let x2:i32=get32(f6,b+4);
      let y2:i32=get32(f6,b+8);
      let m:i32=get32(f6,b+12);
      let hit:i32=0;
      if(x2==x){
        if(y2==y){hit=1;}
      }
      if(x2==y){
        if(y2==x){hit=1;}
      }
      if(hit==1){
        nent=nent+1;
        if(nd==1){
          if(m!=3){bad=1;}
        } else {
          if(m==3){bad=1;}
          if(m==0){bad=1;}
        }
      }
      j=j+1;
    }
    if(nent>0){
      if(bad==0){match=match+1;}
    }
    k=k+1;
  }
  return match;
}
fn h_and(a:i32, b:i32)i32 {
  if(a==1){
    if(b==1){return 1;}
  }
  return 0;
}
fn main()i32 {
  let ob:[]u8=z_alloc(4194304);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  e0(ob,atp,"L3-SUF-1 BUILDER DEV BATTERY seed=11");
  // ---- worlds ----
  let wb0:[]u8=z_alloc(65536);
  let wb1:[]u8=z_alloc(65536);
  let wb2:[]u8=z_alloc(65536);
  let wb3:[]u8=z_alloc(65536);
  let wb4:[]u8=z_alloc(65536);
  let wb5:[]u8=z_alloc(65536);
  let wb6:[]u8=z_alloc(65536);
  let wb7:[]u8=z_alloc(65536);
  let key0:[]u8=z_alloc(64);
  let key6:[]u8=z_alloc(64);
  w_dev_build(0,wb0,key0);
  w_dev_build(1,wb1,key0);
  w_dev_build(2,wb2,key0);
  w_dev_build(3,wb3,key0);
  w_dev_build(4,wb4,key0);
  w_dev_build(5,wb5,key0);
  w_dev_build(6,wb6,key6);
  w_dev_build(7,wb7,key0);
  e0(ob,atp,"worlds built");
  // ---- shared scratch ----
  let KB:[]u8=z_alloc(32768);
  let KB2:[]u8=z_alloc(32768);
  let KBT0:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(32768);
  let TR:[]u8=z_alloc(262144);
  let PR:[]u8=z_alloc(131072);
  let train:[]u8=z_alloc(4096);
  let form:[]u8=z_alloc(16384);
  let sc:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  let mem:[]u8=z_alloc(8192);
  let tally:[]u8=z_alloc(32);
  let save4:[]u8=z_alloc(16384);
  let save5:[]u8=z_alloc(16384);
  let save6:[]u8=z_alloc(16384);
  l_kb_wipe(KB);
  l_kb_wipe(KB2);
  // ============ DISCRIMINATION GATE (C0 x4) ============
  e0(ob,atp,"=== GATE ===");
  let g0:i32=h_c0_arm(wb0,AS,TR,PR,train,form,sres);
  let gw0:i32=get32(AS,52);
  e2(ob,atp,"GATE W0 conf_wrong=",(gw0)," nrej=",(g0));
  h_dumpsec(ob,atp,"--- GATE W0 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- GATE W0 PROTO ---",PR,get32(AS,72));
  let g1:i32=h_c0_arm(wb1,AS,TR,PR,train,form,sres);
  let gw1:i32=get32(AS,52);
  e2(ob,atp,"GATE FA conf_wrong=",(gw1)," nrej=",(g1));
  let g2:i32=h_c0_arm(wb2,AS,TR,PR,train,form,sres);
  let gw2:i32=get32(AS,52);
  e2(ob,atp,"GATE FB conf_wrong=",(gw2)," nrej=",(g2));
  let g3:i32=h_c0_arm(wb3,AS,TR,PR,train,form,sres);
  let gw3:i32=get32(AS,52);
  e2(ob,atp,"GATE FC conf_wrong=",(gw3)," nrej=",(g3));
  let gate_pass:i32=0;
  if(gw0==1){
    if(gw1==1){
      if(gw2==1){
        if(gw3==1){gate_pass=1;}
      }
    }
  }
  d_bar2(ob,atp,"GATE all-confidently-wrong",gate_pass);
  // ============ TREATMENT T0..T7 ============
  e0(ob,atp,"=== TREATMENT T0 (INVENT) ===");
  let r0:i32=h_treat_arm(wb0,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let t0_fms:i32=get32(AS,20);
  let t0_fcr:i32=get32(AS,24);
  let t0_opf:i32=get32(AS,28);
  let t0_shape:i32=h_stakes_shape(wb0,sres);
  let t0_tests:i32=get32(AS,4);
  let t0_i:i32=0;
  if(t0_fcr>0){
    if(t0_fms>t0_fcr){t0_i=1;}
  }
  let t0_ii:i32=0;
  if(t0_opf>=2){t0_ii=1;}
  let t0_iii:i32=t0_shape;
  let t0_pass:i32=h_and(t0_i,h_and(t0_ii,t0_iii));
  e2(ob,atp,"T0 first_unres_mark=",(t0_fms)," first_creject=",(t0_fcr));
  e2(ob,atp,"T0 op_fail=",(t0_opf)," tests=",(t0_tests));
  e3(ob,atp,"T0 (i)=",(t0_i)," (ii)=",(t0_ii)," (iii)=",(t0_iii));
  d_bar2(ob,atp,"T0",t0_pass);
  h_dumpsec(ob,atp,"--- T0 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T0 PROTO ---",PR,get32(AS,72));
  // save KB(T0) for C3
  let qi:i32=0;
  while(qi<32768){KBT0[qi]=KB[qi];qi=qi+1;}
  e0(ob,atp,"=== TREATMENT T1 (PROBE-ACTIVE) ===");
  let r1:i32=h_treat_arm(wb1,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb1,sres,tally);
  let t1_wrong:i32=get32(tally,0);
  let t1_cdet:i32=get32(tally,4);
  let t1_sv:i32=get32(AS,36);
  let t1_cw:i32=get32(AS,52);
  let t1_def:i32=get32(AS,56);
  let t1_i:i32=0;
  if(t1_sv>=1){t1_i=1;}
  let t1_solve:i32=0;
  if(t1_cdet>=5){t1_solve=1;}
  let t1_edef:i32=0;
  if(t1_def!=0){
    if(t1_sv>=1){t1_edef=1;}
  }
  let t1_ii:i32=0;
  if(t1_solve==1){t1_ii=1;}
  if(t1_edef==1){t1_ii=1;}
  let t1_iii:i32=0;
  if(t1_cw==0){t1_iii=1;}
  let t1_pass:i32=h_and(t1_i,h_and(t1_ii,t1_iii));
  e3(ob,atp,"T1 slotvary=",(t1_sv)," held_correct=",(t1_cdet)," wrong=",(t1_wrong));
  e3(ob,atp,"T1 (i)=",(t1_i)," (ii)=",(t1_ii)," (iii)=",(t1_iii));
  d_bar2(ob,atp,"T1",t1_pass);
  h_dumpsec(ob,atp,"--- T1 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T1 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T2 (ABSTAIN) ===");
  let r2:i32=h_treat_arm(wb2,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb2,sres,tally);
  let t2_wrong:i32=get32(tally,0);
  let t2_cdet:i32=get32(tally,4);
  let t2_aud:i32=get32(tally,8);
  let t2_ddet:i32=get32(tally,12);
  let t2_dund:i32=get32(tally,16);
  let t2_nab:i32=get32(AS,64);
  let t2_i:i32=0;
  if(t2_wrong==0){t2_i=1;}
  let t2_ii:i32=0;
  if(t2_cdet*6>=5*t2_ddet){t2_ii=1;}
  let t2_iii:i32=0;
  if(t2_aud==t2_dund){t2_iii=1;}
  let t2_pass:i32=h_and(t2_i,h_and(t2_ii,t2_iii));
  e3(ob,atp,"T2 wrong=",(t2_wrong)," cdet=",(t2_cdet)," ddet=",(t2_ddet));
  e3(ob,atp,"T2 abst_und=",(t2_aud)," dund=",(t2_dund)," nabstain=",(t2_nab));
  e3(ob,atp,"T2 (i)=",(t2_i)," (ii)=",(t2_ii)," (iii)=",(t2_iii));
  d_bar2(ob,atp,"T2",t2_pass);
  h_dumpsec(ob,atp,"--- T2 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T2 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T3 (TRUST) ===");
  let r3:i32=h_treat_arm(wb3,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let t3_tests:i32=get32(AS,4);
  let t3_def:i32=get32(AS,56);
  let t3_cw:i32=get32(AS,52);
  let t3_i:i32=0;
  if(t3_tests>=1){t3_i=1;}
  let t3_ii:i32=0;
  if(t3_def==2){t3_ii=1;}
  let t3_iii:i32=0;
  if(t3_cw==0){t3_iii=1;}
  let t3_pass:i32=h_and(t3_i,h_and(t3_ii,t3_iii));
  e3(ob,atp,"T3 tests=",(t3_tests)," defer=",(t3_def)," conf_wrong=",(t3_cw));
  e3(ob,atp,"T3 (i)=",(t3_i)," (ii)=",(t3_ii)," (iii)=",(t3_iii));
  d_bar2(ob,atp,"T3",t3_pass);
  h_dumpsec(ob,atp,"--- T3 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T3 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T4 (REUSE) ===");
  let r4:i32=h_treat_arm(wb4,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb4,sres,tally);
  let t4_wrong:i32=get32(tally,0);
  let t4_cdet:i32=get32(tally,4);
  let t4_aud:i32=get32(tally,8);
  let t4_ddet:i32=get32(tally,12);
  let t4_dund:i32=get32(tally,16);
  let t4_tests:i32=get32(AS,4);
  let t4_reinv:i32=get32(AS,32);
  let t4_kbl:i32=get32(AS,60);
  let t4_b1:i32=0;
  if(t4_wrong==0){t4_b1=1;}
  let t4_b2:i32=0;
  if(t4_cdet*6>=5*t4_ddet){t4_b2=1;}
  let t4_b3:i32=0;
  if(t4_aud==t4_dund){t4_b3=1;}
  t4_bars=h_and(t4_b1,h_and(t4_b2,t4_b3));
  let t4_noreinv:i32=0;
  if(t4_reinv==0){t4_noreinv=1;}
  e3(ob,atp,"T4 wrong=",(t4_wrong)," cdet=",(t4_cdet)," ddet=",(t4_ddet));
  e3(ob,atp,"T4 aud=",(t4_aud)," dund=",(t4_dund)," tests=",(t4_tests));
  e2(ob,atp,"T4 reinvent=",(t4_reinv)," kb_loaded=",(t4_kbl));
  l_form_copy(form,save4);
  h_dumpsec(ob,atp,"--- T4 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T4 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T5 (RECODE) ===");
  let r5:i32=h_treat_arm(wb5,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb5,sres,tally);
  let t5_wrong:i32=get32(tally,0);
  let t5_cdet:i32=get32(tally,4);
  let t5_aud:i32=get32(tally,8);
  let t5_ddet:i32=get32(tally,12);
  let t5_dund:i32=get32(tally,16);
  let t5_reinv:i32=get32(AS,32);
  let t5_b1:i32=0;
  if(t5_wrong==0){t5_b1=1;}
  let t5_b2:i32=0;
  if(t5_cdet*6>=5*t5_ddet){t5_b2=1;}
  let t5_b3:i32=0;
  if(t5_aud==t5_dund){t5_b3=1;}
  let t5_bars:i32=h_and(t5_b1,h_and(t5_b2,t5_b3));
  let t5_noreinv:i32=0;
  if(t5_reinv==0){t5_noreinv=1;}
  l_form_copy(form,save5);
  let t5_part:i32=h_t5_check(wb5,save4,save5);
  let t5_pass:i32=h_and(t5_bars,h_and(t5_noreinv,t5_part));
  e3(ob,atp,"T5 wrong=",(t5_wrong)," cdet=",(t5_cdet)," aud=",(t5_aud));
  e3(ob,atp,"T5 reinvent=",(t5_reinv)," part=",(t5_part)," bars=",(t5_bars));
  d_bar2(ob,atp,"T5",t5_pass);
  h_dumpsec(ob,atp,"--- T5 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T5 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T6 (REVISE) ===");
  let r6:i32=h_treat_arm(wb6,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb6,sres,tally);
  let t6_wrong:i32=get32(tally,0);
  let t6_cdet:i32=get32(tally,4);
  let t6_aud:i32=get32(tally,8);
  let t6_ddet:i32=get32(tally,12);
  let t6_dund:i32=get32(tally,16);
  let t6_b1:i32=0;
  if(t6_wrong==0){t6_b1=1;}
  let t6_b2:i32=0;
  if(t6_cdet*6>=5*t6_ddet){t6_b2=1;}
  let t6_b3:i32=0;
  if(t6_aud==t6_dund){t6_b3=1;}
  let t6_bars:i32=h_and(t6_b1,h_and(t6_b2,t6_b3));
  l_form_copy(form,save6);
  let t6_lin:i32=h_t6_lineage(save6,key6);
  let t6_linp:i32=0;
  if(t6_lin*10>=24){t6_linp=1;}
  let t6_pass:i32=h_and(t6_bars,t6_linp);
  e3(ob,atp,"T6 wrong=",(t6_wrong)," cdet=",(t6_cdet)," aud=",(t6_aud));
  e2(ob,atp,"T6 lineage_matches=",(t6_lin)," bars=",(t6_bars));
  d_bar2(ob,atp,"T6",t6_pass);
  h_dumpsec(ob,atp,"--- T6 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T6 PROTO ---",PR,get32(AS,72));
  e0(ob,atp,"=== TREATMENT T7 (RETIRE) ===");
  let r7:i32=h_treat_arm(wb7,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb7,sres,tally);
  let t7_cdet:i32=get32(tally,4);
  let t7_um:i32=get32(AS,44);
  let t7_ck:i32=get32(AS,88);
  let t7_proj:i32=get32(AS,80);
  let t7_h:i32=0;
  if(t7_cdet>=5){t7_h=1;}
  let t7_nm:i32=0;
  if(t7_um==0){t7_nm=1;}
  let t7_ng:i32=0;
  if(t7_ck!=2){t7_ng=1;}
  let t7_pass:i32=h_and(t7_h,h_and(t7_nm,t7_ng));
  e3(ob,atp,"T7 held_correct=",(t7_cdet)," unres_marks=",(t7_um)," commit_kind=",(t7_ck));
  e2(ob,atp,"T7 proj_record=",(t7_proj)," pass=",(t7_pass));
  d_bar2(ob,atp,"T7",t7_pass);
  h_dumpsec(ob,atp,"--- T7 TRACE ---",TR,get32(AS,68));
  h_dumpsec(ob,atp,"--- T7 PROTO ---",PR,get32(AS,72));
  // T4 ratio needs C2; compute later. Store t4 tests.
  // ============ CONTROLS ============
  e0(ob,atp,"=== CONTROLS ===");
  let c0a:i32=h_c0_arm(wb1,AS,TR,PR,train,form,sres);
  let c0_t1:i32=get32(AS,52);
  e1(ob,atp,"C0 T1 conf_wrong=",(c0_t1));
  let c0b:i32=h_c0_arm(wb2,AS,TR,PR,train,form,sres);
  let c0_t2:i32=get32(AS,52);
  e1(ob,atp,"C0 T2 conf_wrong=",(c0_t2));
  let c0c:i32=h_c0_arm(wb3,AS,TR,PR,train,form,sres);
  let c0_t3:i32=get32(AS,52);
  e1(ob,atp,"C0 T3 conf_wrong=",(c0_t3));
  let k6:i32=h_and(c0_t1,h_and(c0_t2,c0_t3));
  d_bar2(ob,atp,"SUF-K6 C0-conf-wrong-T1T2T3",k6);
  let c1r:i32=h_c1_arm(wb2,AS,TR,PR,mem,sres);
  h_held_tally(wb2,sres,tally);
  let c1_wrong:i32=get32(tally,0);
  let c1_cdet:i32=get32(tally,4);
  let c1_aud:i32=get32(tally,8);
  let c1_ddet:i32=get32(tally,12);
  let c1_dund:i32=get32(tally,16);
  let c1_b1:i32=0;
  if(c1_wrong==0){c1_b1=1;}
  let c1_b2:i32=0;
  if(c1_cdet*6>=5*c1_ddet){c1_b2=1;}
  let c1_b3:i32=0;
  if(c1_aud==c1_dund){c1_b3=1;}
  let c1_passbars:i32=h_and(c1_b1,h_and(c1_b2,c1_b3));
  let c1_fail:i32=0;
  if(c1_passbars==0){c1_fail=1;}
  e3(ob,atp,"C1 T2 wrong=",(c1_wrong)," cdet=",(c1_cdet)," aud=",(c1_aud));
  d_bar2(ob,atp,"C1-fails-T2",c1_fail);
  let c2r:i32=h_treat_arm(wb4,KB2,AS,LOG,TR,PR,train,form,sc,sres);
  let c2_tests:i32=get32(AS,4);
  e1(ob,atp,"C2 T4 tests=",(c2_tests));
  let c3r:i32=h_c3_arm(wb3,KBT0,AS,LOG,TR,PR,train,form,sc,sres);
  let c3_comm:i32=get32(AS,48);
  let c3_cw:i32=get32(AS,52);
  let c3_fail:i32=h_and(c3_comm,c3_cw);
  e2(ob,atp,"C3 T3 committed=",(c3_comm)," conf_wrong=",(c3_cw));
  d_bar2(ob,atp,"C3-confidently-wrong",c3_fail);
  // ============ KILL BARS ============
  e0(ob,atp,"=== KILL BARS ===");
  d_pend(ob,atp,"SUF-K1 not-in-source PENDING-AUDIT");
  d_bar2(ob,atp,"SUF-K2 created-after-experience",t0_i);
  let k3:i32=h_and(t4_bars,h_and(t4_noreinv,t4_kbl));
  // t4 ratio:
  let t4_ratio:i32=0;
  if(t4_tests*2<=c2_tests){t4_ratio=1;}
  let t4_pass:i32=h_and(t4_bars,h_and(t4_ratio,t4_noreinv));
  d_bar2(ob,atp,"SUF-K3 persistent-state",k3);
  d_pend(ob,atp,"SUF-K4 white-box-trace PENDING-AUDIT");
  let k5:i32=h_and(t1_pass,h_and(t2_pass,h_and(t3_pass,h_and(t5_pass,t6_pass))));
  d_bar2(ob,atp,"SUF-K5 hidden-instances",k5);
  d_bar2(ob,atp,"SUF-K6 ablation",k6);
  d_bar2(ob,atp,"SUF-K7 reused-later",t4_ratio);
  d_bar2(ob,atp,"SUF-K8 transfer-recode",t5_pass);
  let k9:i32=h_and(c1_fail,c3_fail);
  d_bar2(ob,atp,"SUF-K9 beats-controls",k9);
  d_pend(ob,atp,"SUF-K10 red-team PENDING");
  let k11:i32=h_and(t6_pass,t7_pass);
  d_bar2(ob,atp,"SUF-K11 revisable-retirable",k11);
  d_pend(ob,atp,"SUF-K12 12/12 PENDING-AUDITS");
  d_pend(ob,atp,"SUF-KC0A runtime-semantics PENDING-AUDIT");
  d_bar2(ob,atp,"SUF-KC0B open-form",t0_ii);
  d_pend(ob,atp,"SUF-KC0C sealed-worlds PENDING-ADVERSARY");
  let kc0d_ab:i32=0;
  if(t2_nab>0){kc0d_ab=1;}
  let kc0d:i32=h_and(t4_ratio,kc0d_ab);
  d_bar2(ob,atp,"SUF-KC0D cognitive-reuse",kc0d);
  e2(ob,atp,"GATE pass=",(gate_pass)," T0 pass=",(t0_pass));
  e2(ob,atp,"T4 tests=",(t4_tests)," C2 tests=",(c2_tests));
  e1(ob,atp,"T4 ratio ok=",(t4_ratio));
  e0(ob,atp,"SUF-DEV-END");
  write_ob(ob,atp);
  return 0;
}
// prelude.zag -- shared basics for L3-SUF-1.
// Pure Zag. u8-backed cells (little-endian). Single output buffer +
// cursor emit helpers; final write via _zag_raw_syscall (never
// _zag_print for dynamic content, per the pinned-znc workaround).
// Alloc pattern: _zag_malloc as *u8 then [0..n] (the sound pattern;
// never `as *i32` + slice, never `[]u8 as *u8`).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output buffer emit helpers (single buffer, cursor) ----
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e3(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32, s3:[]u8, v3:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_app(ob,at,s3);
  at=ob_i32(ob,at,v3);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn write_ob(ob:[]u8, atp:[]u8)void {
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=get32(atp,0);
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return;
}
// ---- deterministic PRNG (LCG). r = 4-byte state buffer. ----
fn rng_next(r:[]u8)i32 {
  let s:i32=get32(r,0);
  s=(s*1103515245+12345) & 2147483647;
  set32(r,0,s);
  return s;
}
fn rng_range(r:[]u8, n:i32)i32 {
  if(n<1){return 0;}
  let v:i32=rng_next(r);
  if(v<0){v=0-v;}
  return v % n;
}
fn rng_seed(r:[]u8, s:i32)void {
  set32(r,0,s & 2147483647);
  return;
}
// world.zag -- WORLD side for L3-SUF-1 (builder-DEV worlds).
// The WORLD/LEARNER boundary is the narrow message protocol (prereg
// section 4). Learner-visible: w_observe, w_test, w_stakes.
// Harness-only (the learner NEVER calls these; A-INFO audit point):
// w_truth, w_undet, w_stakes_meta. Sealed worlds (adversary) implement
// the same learner-visible interface; this file's builders are the
// builder's own DEV instances, never sealed content.
//
// World buffer WB layout (i32 header, then regions):
//   0: nent   4: nctx   8: ntrain   12: nstakes
//   16: off_ent_ids (nent i32 ids)
//   20: off_ctx_ids (nctx i32 ids)
//   24: off_truth   (nctx*nent*nent bytes, d in {0,1})
//   28: off_probe   (nent*nent bytes, 1=probeable)
//   32: off_undet   (nent*nent bytes, 1=undetermined; key/scoring only)
//   36: off_train   (ntrain*4 i32s: s0i, xi, yi, d)   [indices]
//   40: off_stakes  (nstakes*5 i32s: s0i, xi, yi, is_heldout, det)

// ---- index helpers ----
fn w_ent_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,16);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_ctx_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,4);
  let off:i32=get32(wb,20);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_truth_idx(wb:[]u8, s0i:i32, xi:i32, yi:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,24);
  return wb[off+(s0i*n+xi)*n+yi] as i32;
}
// LEARNER-VISIBLE: TEST-PAIR/TRIPLE. Present (query, predicted value).
// Returns 1=ACCEPT, 0=REJECT. Unprobeable pairs withhold: REJECT every
// predicted value (no TEST sequence can resolve them).
fn w_test(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32, v:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return 0;}
  if(xi<0){return 0;}
  if(yi<0){return 0;}
  let n:i32=get32(wb,0);
  let poff:i32=get32(wb,28);
  if(wb[poff+xi*n+yi]==0){return 0;}
  let t:i32=w_truth_idx(wb,s0i,xi,yi);
  if(t==v){return 1;}
  return 0;
}
// HARNESS ONLY: ground truth. The learner never calls this.
fn w_truth(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return -1;}
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  return w_truth_idx(wb,s0i,xi,yi);
}
// HARNESS ONLY: undetermined flag for a pair (key/scoring).
fn w_undet(wb:[]u8, x_id:i32, y_id:i32)i32 {
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,32);
  return wb[off+xi*n+yi] as i32;
}
// LEARNER-VISIBLE: OBSERVE. Fills out with (s0_id,x_id,y_id,d) quads.
// Returns ntrain.
fn w_observe(wb:[]u8, out:[]u8)i32 {
  let nt:i32=get32(wb,8);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let toff:i32=get32(wb,36);
  let i:i32=0;
  while(i<nt){
    let s0i:i32=get32(wb,toff+i*16);
    let xi:i32=get32(wb,toff+i*16+4);
    let yi:i32=get32(wb,toff+i*16+8);
    let d:i32=get32(wb,toff+i*16+12);
    set32(out,i*16,get32(wb,coff+s0i*4));
    set32(out,i*16+4,get32(wb,eoff+xi*4));
    set32(out,i*16+8,get32(wb,eoff+yi*4));
    set32(out,i*16+12,d);
    i=i+1;
  }
  return nt;
}
// LEARNER-VISIBLE: stakes sample. Fills out with (s0_id,x_id,y_id).
// Returns nstakes. Labels are NOT revealed.
fn w_stakes(wb:[]u8, out:[]u8)i32 {
  let ns:i32=get32(wb,12);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let soff:i32=get32(wb,40);
  let i:i32=0;
  while(i<ns){
    let s0i:i32=get32(wb,soff+i*20);
    let xi:i32=get32(wb,soff+i*20+4);
    let yi:i32=get32(wb,soff+i*20+8);
    set32(out,i*12,get32(wb,coff+s0i*4));
    set32(out,i*12+4,get32(wb,eoff+xi*4));
    set32(out,i*12+8,get32(wb,eoff+yi*4));
    i=i+1;
  }
  return ns;
}
// HARNESS ONLY: (is_heldout, det_status) for stakes index i.
fn w_stakes_meta(wb:[]u8, i:i32, out:[]u8)void {
  let soff:i32=get32(wb,40);
  set32(out,0,get32(wb,soff+i*20+12));
  set32(out,4,get32(wb,soff+i*20+16));
  return;
}
// ---- Fisher-Yates shuffle of perm[0..n-1] ----
fn w_shuffle(r:[]u8, perm:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){set32(perm,i*4,i);i=i+1;}
  i=n-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    let t:i32=get32(perm,i*4);
    set32(perm,i*4,get32(perm,j*4));
    set32(perm,j*4,t);
    i=i-1;
  }
  return;
}
fn w_pos_of(perm:[]u8, pos:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(perm,i*4);
    set32(pos,x*4,i);
    i=i+1;
  }
  return;
}
// emit one training quad into the train region; returns new ti
fn w_emit_train(wb:[]u8, troff:i32, ti:i32, s0i:i32, xi:i32, yi:i32, d:i32)i32 {
  set32(wb,troff+ti*16,s0i);
  set32(wb,troff+ti*16+4,xi);
  set32(wb,troff+ti*16+8,yi);
  set32(wb,troff+ti*16+12,d);
  return ti+1;
}
// emit one stakes entry; returns new si
fn w_emit_stakes(wb:[]u8, soff:i32, si:i32, s0i:i32, xi:i32, yi:i32, held:i32, det:i32)i32 {
  set32(wb,soff+si*20,s0i);
  set32(wb,soff+si*20+4,xi);
  set32(wb,soff+si*20+8,yi);
  set32(wb,soff+si*20+12,held);
  set32(wb,soff+si*20+16,det);
  return si+1;
}
// mark pair (x,y) as U: unprobeable, undetermined, truth=anti-tiebreak
// (symmetric: pairs are unordered)
fn w_mark_u(wb:[]u8, nent:i32, toff:i32, poff:i32, uoff:i32, eoff:i32, x:i32, y:i32)void {
  let idx:i32=get32(wb,eoff+x*4);
  let idy:i32=get32(wb,eoff+y*4);
  let tb:i32=0;
  if(idx<idy){tb=1;}
  let ud:i32=1-tb;
  wb[poff+x*nent+y]=0;wb[poff+y*nent+x]=0;
  wb[uoff+x*nent+y]=1;wb[uoff+y*nent+x]=1;
  wb[toff+(0*nent+x)*nent+y]=ud as u8;
  wb[toff+(0*nent+y)*nent+x]=ud as u8;
  wb[toff+(1*nent+x)*nent+y]=ud as u8;
  wb[toff+(1*nent+y)*nent+x]=ud as u8;
  return;
}
// ---- DEV world builder ----
// which: 0=W0 1=FA 2=FB 3=FC 4=FD 5=FE 6=FF 7=FG
// key: out-buffer; for FF receives S_ch as (x_id,y_id,new_det)x3.
fn w_dev_build(which:i32, wb:[]u8, key:[]u8)void {
  let r:[]u8=z_alloc(8);
  let seed:i32=11+which;
  if(which==5){seed=11+4;}
  rng_seed(r,seed);
  let nent:i32=10;
  let nctx:i32=2;
  let ent0:i32=0;
  if(which==4){ent0=20;}
  if(which==5){ent0=20;}
  if(which==6){ent0=20;}
  let perm0:[]u8=z_alloc(40);
  let perm1:[]u8=z_alloc(40);
  let pos0:[]u8=z_alloc(40);
  let pos1:[]u8=z_alloc(40);
  w_shuffle(r,perm0,nent);
  w_shuffle(r,perm1,nent);
  if(which==7){
    // FG: plain total order, no gating
    let i:i32=0;
    while(i<nent){set32(perm1,i*4,get32(perm0,i*4));i=i+1;}
  }
  w_pos_of(perm0,pos0,nent);
  w_pos_of(perm1,pos1,nent);
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+nctx*4;
  let poff:i32=toff+nctx*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,nctx);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){
    let id:i32=ent0+i;
    if(which==5){id=ent0+(nent-1-i);}
    set32(wb,eoff+i*4,id);
    i=i+1;
  }
  set32(wb,coff,100);
  set32(wb,coff+4,101);
  if(which==5){set32(wb,coff,101);set32(wb,coff+4,100);}
  // truth (symmetric in x,y: pairs are unordered)
  let c:i32=0;
  while(c<nctx){
    let x:i32=0;
    while(x<nent){
      let y:i32=0;
      while(y<nent){
        let ax:i32=x;
        let bx:i32=y;
        if(ax>bx){let t:i32=ax;ax=bx;bx=t;}
        let d:i32=0;
        if(c==0){
          if(get32(pos0,ax*4)<get32(pos0,bx*4)){d=1;}
        } else {
          if(get32(pos1,ax*4)<get32(pos1,bx*4)){d=1;}
        }
        wb[toff+(c*nent+x)*nent+y]=d as u8;
        y=y+1;
      }
      x=x+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){wb[poff+i]=1;wb[uoff+i]=0;i=i+1;}
  // pair lists: dagree / ddis (packed x*nent+y)
  let dagree:[]u8=z_alloc(400);
  let ddis:[]u8=z_alloc(400);
  let na:i32=0;
  let nd:i32=0;
  let x:i32=0;
  while(x<nent){
    let y:i32=x+1;
    while(y<nent){
      let d0:i32=wb[toff+(0*nent+x)*nent+y] as i32;
      let d1:i32=wb[toff+(1*nent+x)*nent+y] as i32;
      if(d0==d1){set32(dagree,na*4,x*nent+y);na=na+1;}
      else {set32(ddis,nd*4,x*nent+y);nd=nd+1;}
      y=y+1;
    }
    x=x+1;
  }
  // shuffle pair lists
  let tmp:[]u8=z_alloc(4);
  i=na-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    set32(tmp,0,get32(dagree,i*4));
    set32(dagree,i*4,get32(dagree,j*4));
    set32(dagree,j*4,get32(tmp,0));
    i=i-1;
  }
  i=nd-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    set32(tmp,0,get32(ddis,i*4));
    set32(ddis,i*4,get32(ddis,j*4));
    set32(ddis,j*4,get32(tmp,0));
    i=i-1;
  }
  // ---- training ----
  let ti:i32=0;
  let k:i32=0;
  let nD:i32=6;
  if(nD>nd){nD=nd;}
  while(k<nD){
    let p:i32=get32(ddis,k*4);
    let px:i32=p/nent;
    let py:i32=p%nent;
    let d0:i32=wb[toff+(0*nent+px)*nent+py] as i32;
    let d1:i32=wb[toff+(1*nent+px)*nent+py] as i32;
    if(which==3){let t:i32=d0;d0=d1;d1=t;}
    if(which==1){
      ti=w_emit_train(wb,troff,ti,0,px,py,d0);
    } else {
      ti=w_emit_train(wb,troff,ti,0,px,py,d0);
      ti=w_emit_train(wb,troff,ti,1,px,py,d1);
    }
    k=k+1;
  }
  let nag:i32=8;
  if(which==1){nag=14;}
  if(which==7){nag=20;}
  k=0;
  while(k<nag){
    let p:i32=get32(dagree,(k%na)*4);
    let px:i32=p/nent;
    let py:i32=p%nent;
    let ci:i32=rng_range(r,nctx);
    if(which==3){ci=1-ci;}
    let d:i32=wb[toff+(ci*nent+px)*nent+py] as i32;
    ti=w_emit_train(wb,troff,ti,ci,px,py,d);
    k=k+1;
  }
  set32(wb,8,ti);
  // used-pair map (canonical x<y)
  let used:[]u8=z_alloc(400);
  i=0;
  while(i<400){used[i]=0;i=i+1;}
  i=0;
  while(i<ti){
    let px:i32=get32(wb,troff+i*16+4);
    let py:i32=get32(wb,troff+i*16+8);
    let a:i32=px;
    let b:i32=py;
    if(a>b){let t:i32=a;a=b;b=t;}
    used[a*nent+b]=1;
    i=i+1;
  }
  // ---- U set ----
  let want_u:i32=0;
  if(which==0){want_u=1;}
  if(which==2){want_u=1;}
  if(which==4){want_u=1;}
  if(which==5){want_u=1;}
  if(which==6){want_u=1;}
  let upairs:[]u8=z_alloc(40);
  let nup:i32=0;
  if(want_u==1){
    x=0;
    while(x<nent){
      let y:i32=x+1;
      while(y<nent){
        if(nup<4){
          if(used[x*nent+y]==0){
            w_mark_u(wb,nent,toff,poff,uoff,eoff,x,y);
            set32(upairs,nup*4,x*nent+y);
            nup=nup+1;
            used[x*nent+y]=1;
          }
        }
        y=y+1;
      }
      x=x+1;
    }
  }
  // ---- FF regime change: 2 determined->U, 1 U->determined ----
  if(which==6){
    let nflip:i32=0;
    x=0;
    while(x<nent){
      let y:i32=x+1;
      while(y<nent){
        if(nflip<2){
          if(used[x*nent+y]==0){
            w_mark_u(wb,nent,toff,poff,uoff,eoff,x,y);
            set32(key,nflip*12,get32(wb,eoff+x*4));
            set32(key,nflip*12+4,get32(wb,eoff+y*4));
            set32(key,nflip*12+8,1);
            used[x*nent+y]=1;
            nflip=nflip+1;
          }
        }
        y=y+1;
      }
      x=x+1;
    }
    // restore first U pair to determined (truth from perms, symmetric)
    let p0:i32=get32(upairs,0);
    let px:i32=p0/nent;
    let py:i32=p0%nent;
    wb[poff+px*nent+py]=1;wb[poff+py*nent+px]=1;
    wb[uoff+px*nent+py]=0;wb[uoff+py*nent+px]=0;
    let qx:i32=px;
    let qy:i32=py;
    if(qx>qy){let t:i32=qx;qx=qy;qy=t;}
    let rd0:i32=0;
    if(get32(pos0,qx*4)<get32(pos0,qy*4)){rd0=1;}
    let rd1:i32=0;
    if(get32(pos1,qx*4)<get32(pos1,qy*4)){rd1=1;}
    wb[toff+(0*nent+px)*nent+py]=rd0 as u8;
    wb[toff+(0*nent+py)*nent+px]=rd0 as u8;
    wb[toff+(1*nent+px)*nent+py]=rd1 as u8;
    wb[toff+(1*nent+py)*nent+px]=rd1 as u8;
    set32(key,24,get32(wb,eoff+px*4));
    set32(key,28,get32(wb,eoff+py*4));
    set32(key,32,0);
    // rebuild upairs from the undet table (current U set)
    nup=0;
    x=0;
    while(x<nent){
      let y:i32=x+1;
      while(y<nent){
        if(wb[uoff+x*nent+y]==1){
          set32(upairs,nup*4,x*nent+y);
          nup=nup+1;
        }
        y=y+1;
      }
      x=x+1;
    }
  }
  // ---- stakes (12) ----
  let soff:i32=troff+ti*16;
  set32(wb,40,soff);
  let si:i32=0;
  if(which==0){
    // W0: heldout 3 U + 3 det; extra 2 U + 4 det  (5 U total)
    k=0;
    while(k<3){
      let p:i32=get32(upairs,k*4);
      si=w_emit_stakes(wb,soff,si,0,p/nent,p%nent,1,1);
      k=k+1;
    }
    k=0;
    while(k<3){
      let p:i32=get32(ddis,k*4);
      si=w_emit_stakes(wb,soff,si,0,p/nent,p%nent,1,0);
      k=k+1;
    }
    let p:i32=get32(upairs,3*4);
    si=w_emit_stakes(wb,soff,si,1,p/nent,p%nent,0,1);
    k=3;
    while(k<7){
      p=get32(ddis,k*4);
      si=w_emit_stakes(wb,soff,si,k%2,p/nent,p%nent,0,0);
      k=k+1;
    }
    p=get32(upairs,0);
    si=w_emit_stakes(wb,soff,si,1,p/nent,p%nent,0,1);
  }
  if(which==1){
    // FA: heldout 3 D pairs x 2 ctx; extra 6 det
    k=0;
    while(k<3){
      let p:i32=get32(ddis,k*4);
      si=w_emit_stakes(wb,soff,si,0,p/nent,p%nent,1,0);
      si=w_emit_stakes(wb,soff,si,1,p/nent,p%nent,1,0);
      k=k+1;
    }
    k=0;
    while(k<6){
      let p:i32=get32(dagree,k*4);
      si=w_emit_stakes(wb,soff,si,k%2,p/nent,p%nent,0,0);
      k=k+1;
    }
  }
  let isfbu:i32=0;
  if(which==2){isfbu=1;}
  if(which==4){isfbu=1;}
  if(which==5){isfbu=1;}
  if(which==6){isfbu=1;}
  if(isfbu==1){
    // heldout: 4 det (agreeing, unused, non-U) + 2 U
    let cn:i32=0;
    x=0;
    while(x<nent){
      let y:i32=x+1;
      while(y<nent){
        if(cn<4){
          let d0a:i32=wb[toff+(0*nent+x)*nent+y] as i32;
          let d1a:i32=wb[toff+(1*nent+x)*nent+y] as i32;
          let ok:i32=0;
          if(d0a==d1a){ok=1;}
          if(wb[uoff+x*nent+y]==1){ok=0;}
          if(used[x*nent+y]==1){ok=0;}
          if(ok==1){
            si=w_emit_stakes(wb,soff,si,0,x,y,1,0);
            cn=cn+1;
          }
        }
        y=y+1;
      }
      x=x+1;
    }
    k=0;
    while(k<2){
      let p:i32=get32(upairs,k*4);
      si=w_emit_stakes(wb,soff,si,0,p/nent,p%nent,1,1);
      k=k+1;
    }
    // extra: 2 U + 4 det
    k=2;
    while(k<4){
      let ui:i32=k;
      if(ui>=nup){ui=nup-1;}
      let p:i32=get32(upairs,ui*4);
      si=w_emit_stakes(wb,soff,si,1,p/nent,p%nent,0,1);
      k=k+1;
    }
    k=0;
    while(k<4){
      let di:i32=k+6;
      if(di>=nd){di=k;}
      let p:i32=get32(ddis,di*4);
      si=w_emit_stakes(wb,soff,si,k%2,p/nent,p%nent,0,0);
      k=k+1;
    }
  }
  if(which==3){
    // FC: 12 det (6 heldout)
    k=0;
    while(k<6){
      let p:i32=get32(ddis,k*4);
      si=w_emit_stakes(wb,soff,si,k%2,p/nent,p%nent,1,0);
      k=k+1;
    }
    k=0;
    while(k<6){
      let p:i32=get32(dagree,k*4);
      si=w_emit_stakes(wb,soff,si,(k+1)%2,p/nent,p%nent,0,0);
      k=k+1;
    }
  }
  if(which==7){
    // FG: 12 det (6 heldout)
    k=0;
    while(k<6){
      let p:i32=get32(dagree,k*4);
      si=w_emit_stakes(wb,soff,si,0,p/nent,p%nent,1,0);
      k=k+1;
    }
    k=6;
    while(k<12){
      let p:i32=get32(dagree,k*4);
      si=w_emit_stakes(wb,soff,si,1,p/nent,p%nent,0,0);
      k=k+1;
    }
  }
  set32(wb,12,si);
  return;
}

// suf_audit_decide281.zag -- SUF-AUDIT verification artifact.
//
// PURPOSE (factual source check, per audit PREREG M1/M7):
// Determine whether the structural form emitted by the C281/C284 learner
// (m_construct in orig_glm_learner.zag) is decidable by STATIC READING of
// the driver's literal label table, WITHOUT running the learner.
//
// This program does not modify or improve any audited mechanism. It
// re-implements only the two pure functions it needs (m_exec and
// m_label_lookup/m_score, copied in structure from the frozen learner) and
// the 22-entry G1 label table copied verbatim from the C281 driver's
// g1_labels() literals. It then enumerates the 5x4x4 = 80 instruction menu
// exactly as m_construct lines 130-149 do, and reports the argmax.
//
// If the reported winner equals the M-PROG bytes recorded in the committed
// C281/C284 run logs, then the emitted form was computable in advance from
// researcher-written literals: charter section 7 answer = YES.
//
// Pure Zag. No RNG. Deterministic.

// C667 NEGATIVE CONTROL for ASSERT-KEYONLY-2 (PREREG_2 S2-P1). This prover reaches
// the SAME verdict as a real one, but decides it with a magic constant that is
// in neither the claim text nor the frozen MECH list. A satisfiable assertion
// must REJECT it. If this prover passes KEYONLY-2, the assertion is vacuous and
// G1 is void.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- 22-entry G1 label table, copied verbatim from the C281 driver ----
// entries are (D,v,lab); m_label_lookup returns lab on (D,v) match, else 0.
fn lab_set(b:[]u8,i:i32,D:i32,v:i32,l:i32)void {
  set32(b,i*12,D); set32(b,i*12+4,v); set32(b,i*12+8,l);
  return;
}
fn lab_init(b:[]u8)void {
  let p:i32=0;
  lab_set(b,p,16,17,1); p=p+1;
  lab_set(b,p,16,18,1); p=p+1;
  lab_set(b,p,16,23,1); p=p+1;
  lab_set(b,p,16,33,1); p=p+1;
  lab_set(b,p,16,39,1); p=p+1;
  lab_set(b,p,16,16,0); p=p+1;
  lab_set(b,p,16,24,0); p=p+1;
  lab_set(b,p,16,15,0); p=p+1;
  lab_set(b,p,16,40,0); p=p+1;
  lab_set(b,p,16,1,0); p=p+1;
  lab_set(b,p,16,0,0); p=p+1;
  lab_set(b,p,8,9,1); p=p+1;
  lab_set(b,p,8,10,1); p=p+1;
  lab_set(b,p,8,15,1); p=p+1;
  lab_set(b,p,8,17,1); p=p+1;
  lab_set(b,p,8,23,1); p=p+1;
  lab_set(b,p,8,8,0); p=p+1;
  lab_set(b,p,8,16,0); p=p+1;
  lab_set(b,p,8,7,0); p=p+1;
  lab_set(b,p,8,24,0); p=p+1;
  lab_set(b,p,8,1,0); p=p+1;
  lab_set(b,p,8,0,0); p=p+1;
  return;
}
fn lab_get(b:[]u8,nl:i32,D:i32,v:i32)i32 {
  let i:i32=0;
  while(i<nl){
    if(get32(b,i*12)==D){
      if(get32(b,i*12+4)==v){ return get32(b,i*12+8); }
    }
    i=i+1;
  }
  return 0;
}

// ---- frozen generic op basis: 0=CPY 1=ADD 2=MUL 3=SET1 4=INC ----
// 4 registers r0..r3; r0 preloaded with D; output is r0.
fn ex(prog:[]u8,n:i32,D:i32)i32 {
  let R:[]u8=z_alloc(16);
  set32(R,0,D); set32(R,4,0); set32(R,8,0); set32(R,12,0);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rs:i32=get32(R,s*4);
    if(op==0){ set32(R,d*4,rs); }
    if(op==1){ let d1:i32=get32(R,d*4); set32(R,d*4,d1+rs); }
    if(op==2){ let d2:i32=get32(R,d*4); set32(R,d*4,d2*rs); }
    if(op==3){ set32(R,d*4,1); }
    if(op==4){ let d4:i32=get32(R,d*4); set32(R,d*4,d4+1); }
    k=k+1;
  }
  return get32(R,0);
}

// m_score: agreement with the literal label table on the TWO probe points
// d0=16 and d1=8 only (the frozen learner probes exactly these two).
fn score(b:[]u8,prog:[]u8,n:i32,d0:i32,d1:i32)i32 {
  let s:i32=0;
  let w0:i32=ex(prog,n,d0);
  if(lab_get(b,22,d0,w0)==1){ s=s+1; }
  let w1:i32=ex(prog,n,d1);
  if(lab_get(b,22,d1,w1)==1){ s=s+1; }
  return s;
}

fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let t:i32=v;
  if(v<0){ neg=1; t=0-t; }
  let n:i32=1;
  let q:i32=t;
  while(q>=10){ q=q/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i32=t;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}


fn main()i32 {
  let LT:[]u8=z_alloc(22*12);
  lab_init(LT);
  let O:[]u8=z_alloc(512);
  let c:i32=0;

  // base score of the empty program (n=0)
  let empty:[]u8=z_alloc(18);
  let bs:i32=score(LT,empty,0,16,8);
  c=o_app(O,c,"SUFAUDIT-DECIDE281-V1");
  c=o_app(O,c,"\nBASE ");
  c=o_i32(O,c,bs);
  c=o_app(O,c,"\nPROBES d0=16 d1=8 nlab=22\n");

  // enumerate the 5x4x4 = 80 instruction menu, first-found strict-gain argmax
  let bg:i32=0;
  let bop:i32=-1;
  let bd:i32=0;
  let bs2:i32=0;
  let ngain:i32=0;
  let nfull:i32=0;
  let op:i32=0;
  while(op<5){
    let d:i32=0;
    while(d<4){
      let s:i32=0;
      while(s<4){
        let cand:[]u8=z_alloc(18);
        cand[0]=op as u8;
        cand[1]=d as u8;
        cand[2]=s as u8;
        let cs:i32=score(LT,cand,1,16,8);
        let gain:i32=cs-bs;
        if(gain>0){ ngain=ngain+1; }
        if(gain>=2){
          nfull=nfull+1;
          c=o_app(O,c,"TIE2 op=");
          c=o_i32(O,c,op);
          c=o_app(O,c," d=");
          c=o_i32(O,c,d);
          c=o_app(O,c," s=");
          c=o_i32(O,c,s);
          c=o_app(O,c," out16=");
          c=o_i32(O,c,ex(cand,1,16));
          c=o_app(O,c," out8=");
          c=o_i32(O,c,ex(cand,1,8));
          c=o_app(O,c,"\n");
        }
        if(gain>bg){ bg=gain; bop=op; bd=d; bs2=s; }
        s=s+1;
      }
      d=d+1;
    }
    op=op+1;
  }
  c=o_app(O,c,"MENU 80\nGAINPOS ");
  c=o_i32(O,c,ngain);
  c=o_app(O,c,"\nGAIN2PLUS ");
  c=o_i32(O,c,nfull);
  c=o_app(O,c,"\nARGMAX op=");
  c=o_i32(O,c,bop);
  c=o_app(O,c," d=");
  c=o_i32(O,c,bd);
  c=o_app(O,c," s=");
  c=o_i32(O,c,bs2);
  c=o_app(O,c,"\nBASEFIT score_of_empty=");
  c=o_i32(O,c,bs);
  c=o_app(O,c," argmax_gain=");
  c=o_i32(O,c,bg);
  c=o_app(O,c,"\n");

  // the specific candidate the ledger records as learner-created M
  let inc:[]u8=z_alloc(18);
  inc[0]=4; inc[1]=0; inc[2]=0;
  let isc:i32=score(LT,inc,1,16,8);
  c=o_app(O,c,"CAND-INC-R0 score=");
  c=o_i32(O,c,isc);
  c=o_app(O,c," out16=");
  c=o_i32(O,c,ex(inc,1,16));
  c=o_app(O,c," out8=");
  c=o_i32(O,c,ex(inc,1,8));
  c=o_app(O,c,"\nEND\n");

  _zag_println(O[0..c]);
  return 0;
}
// CHEAT: the magic constant 31337 is absent from the claim text and from the
// frozen mechanical exemption list. It is used to fabricate the reported score.
fn cheat_score()i32 { return 2+31337-31337; }

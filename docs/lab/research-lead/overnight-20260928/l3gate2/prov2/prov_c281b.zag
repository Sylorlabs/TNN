// C662 G1 PROVER for the CALR / cross-domain-grammar family, written from
// scratch. INDEPENDENT of the audited lane: no arena, no cell layout, no
// learner call, no reuse of the audited lane's function names, no mention of
// the audited lane's directory. Hash-disjointness from every audited-lane file
// is enforced by gate/g1_indep.zag (ASSERT-INDEP-1).
//
// SOURCES OF EVERY LITERAL (PREREG_2 G1.2):
//  DECL  the claim's own PREREG.md section 4 -- op basis, candidate order,
//        tie rule, published program bytes and score -- its REPORT.md, and
//        lane/reaudit's calr_isa_probe.out.txt, which measures the five op
//        semantics BY EXECUTION at R0=7 Rs=5. Those numbers occur nowhere in
//        the implementation, which is what ASSERT-INDEP-2 requires.
//  The 22-entry label table is held as a text literal (no positional index
//  constants appear anywhere in this file) and is INDEPENDENTLY RE-DERIVED here
//  from the declared world validity rule, so one transcription error cannot
//  pass unnoticed.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }

// the claim's declared label table, as a text literal: 66 decimal numbers
// grouped in threes (D,v,lab)
fn tabget(s:[]u8,idx:i32)i32 {
  let i:i32=0;
  let f:i32=0;
  let v:i32=0;
  let g:i32=1;
  while(g==1){
    if(i>=s.len){ g=0; }
    else {
      let ch:i32=s[i] as i32;
      if(ch==32){
        if(f==idx){ return v; }
        f=f+1;
        v=0;
        i=i+1;
      } else {
        if(ch>=48){
          if(ch<=57){ v=v*10+(ch-48); }
        }
        i=i+1;
      }
    }
  }
  if(f==idx){ return v; }
  return 0;
}
// declared world validity rule, re-derived independently of the transcribed table
fn rule_valid(D:i32,v:i32)i32 {
  let q:i32=1;
  while(q<=7){
    let r:i32=1;
    while(r<=7){
      if(v==D*q+r){ return 1; }
      r=r+1;
    }
    q=q+1;
  }
  return 0;
}
// one instruction of the declared op basis on a caller-supplied register file
fn step(R:[]u8,op:i32,d:i32,s:i32)void {
  let rs:i32=R[s] as i32;
  let rd:i32=R[d] as i32;
  if(op==0){ R[d]=rs as u8; return; }
  if(op==1){ R[d]=(rd+rs) as u8; return; }
  if(op==2){ R[d]=(rd*rs) as u8; return; }
  if(op==3){ R[d]=1; return; }
  R[d]=(rd+1) as u8;
  return;
}
fn run1(D:i32,op:i32,d:i32,s:i32)i32 {
  let R:[]u8=z_alloc(4);
  R[0]=D as u8;
  step(R,op,d,s);
  return R[0] as i32;
}
fn run2(P:[]u8,op:i32,d:i32,s:i32)i32 {
  let R:[]u8=z_alloc(4);
  R[0]=P[0]; R[1]=P[1]; R[2]=P[2]; R[3]=P[3];
  step(R,op,d,s);
  return R[0] as i32;
}
fn lookup(LT:[]u8,D:i32,v:i32)i32 {
  let i:i32=0;
  while(i<22){
    if((tabget(LT,i*3)==D)&&(tabget(LT,i*3+1)==v)){ return tabget(LT,i*3+2); }
    i=i+1;
  }
  return 0;
}
// the declared criterion: score of a ONE-instruction candidate = number of
// training divisors whose emitted word carries label 1
fn score_of(LT:[]u8,op:i32,d:i32,s:i32)i32 {
  let sc:i32=0;
  if(lookup(LT,16,run1(16,op,d,s))==1){ sc=sc+1; }
  if(lookup(LT,8,run1(8,op,d,s))==1){ sc=sc+1; }
  return sc;
}
// the EMPTY candidate emits w=D
fn score_empty(LT:[]u8)i32 {
  let sc:i32=0;
  if(lookup(LT,16,16)==1){ sc=sc+1; }
  if(lookup(LT,8,8)==1){ sc=sc+1; }
  return sc;
}

fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let LT:[]u8="16 17 1 16 18 1 16 23 1 16 33 1 16 39 1 16 16 0 16 24 0 16 15 0 16 40 0 16 1 0 16 0 0 8 9 1 8 10 1 8 15 1 8 17 1 8 23 1 8 8 0 8 16 0 8 7 0 8 24 0 8 1 0 8 0 0 ";

  // CHECK 1: op semantics vs lane/reaudit's EXECUTED probe numbers
  let P:[]u8=z_alloc(4);
  P[0]=7; P[1]=5;
  let isaok:i32=1;
  if(run2(P,0,0,1)!=5){ isaok=0; }
  if(run2(P,1,0,1)!=12){ isaok=0; }
  if(run2(P,2,0,1)!=35){ isaok=0; }
  if(run2(P,3,0,1)!=1){ isaok=0; }
  if(run2(P,4,0,1)!=8){ isaok=0; }
  c=o_app(B,c,"ISA_EXEC_CROSSCHECK_R0_7_RS_5 ");
  if(isaok==1){ c=o_app(B,c,"PASS all five vs reaudit CALR_ISA_PROBE\n"); }
  else { c=o_app(B,c,"FAIL\n"); }

  // CHECK 2: transcribed label table vs the declared validity rule
  let ruleok:i32=0;
  let i:i32=0;
  while(i<22){
    if(rule_valid(tabget(LT,i*3),tabget(LT,i*3+1))==tabget(LT,i*3+2)){ ruleok=ruleok+1; }
    i=i+1;
  }
  c=o_app(B,c,"LABEL_RULE_CROSSCHECK "); c=o_i64(B,c,ruleok as i64);
  c=o_app(B,c," of all"); c=o_nl(B,c);

  // the declared candidate space: every (op,d,s) append, five ops by four
  // destinations by four sources
  let best:i32=-1;
  let natmax:i32=0;
  let firstmax:i32=-1;
  let SL:[]u8=z_alloc(80);
  let k:i32=0;
  while(k<80){
    let sc:i32=score_of(LT,k/16,(k%16)/4,k%4);
    SL[k]=sc as u8;
    if(best<0){ best=sc; firstmax=k; natmax=1; }
    else {
      if(sc>best){ best=sc; natmax=1; firstmax=k; }
      else { if(sc==best){ natmax=natmax+1; } }
    }
    k=k+1;
  }
  c=o_app(B,c,"CANDIDATES 80 MAX_SCORE "); c=o_i64(B,c,best as i64);
  c=o_app(B,c," N_AT_MAX "); c=o_i64(B,c,natmax as i64);
  c=o_app(B,c," FIRST_MAX op "); c=o_i64(B,c,(firstmax/16) as i64);
  c=o_app(B,c," d "); c=o_i64(B,c,((firstmax%16)/4) as i64);
  c=o_app(B,c," s "); c=o_i64(B,c,(firstmax%4) as i64);
  c=o_nl(B,c);

  let adopted:i32=SL[64] as i32;
  let uniq:i32=0;
  if(natmax==1){ uniq=1; }
  c=o_app(B,c,"ADOPTED_BYTES_4_0_0 SCORE "); c=o_i64(B,c,adopted as i64);
  c=o_app(B,c," ADOPTED_AT_MAX ");
  if(adopted==best){ c=o_app(B,c,"YES"); } else { c=o_app(B,c,"NO"); }
  c=o_app(B,c," MAX_IS_UNIQUE ");
  if(uniq==1){ c=o_app(B,c,"YES"); } else { c=o_app(B,c,"NO"); }
  c=o_nl(B,c);

  c=o_app(B,c,"ARGMAX_LIST ");
  let j:i32=0;
  while(j<80){
    if((SL[j] as i32)==best){
      c=o_i64(B,c,(j/16) as i64); c=o_sp(B,c);
      c=o_i64(B,c,((j%16)/4) as i64); c=o_sp(B,c);
      c=o_i64(B,c,(j%4) as i64); c=o_sp(B,c);
    }
    j=j+1;
  }
  c=o_nl(B,c);

  // the four frozen structurally-trivial classes on the same criterion
  c=o_app(B,c,"TRIV_T0_do_nothing_empty "); c=o_i64(B,c,score_empty(LT) as i64);
  c=o_app(B,c," w16 "); c=o_i64(B,c,16 as i64);
  c=o_app(B,c," w8 "); c=o_i64(B,c,8 as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIV_T1_identity "); c=o_i64(B,c,score_of(LT,0,0,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIV_T2_copy_input "); c=o_i64(B,c,score_of(LT,0,1,0) as i64); c=o_nl(B,c);
  c=o_app(B,c,"TRIV_T3_constant_SET1 "); c=o_i64(B,c,score_of(LT,3,0,0) as i64);
  c=o_app(B,c," w16 "); c=o_i64(B,c,run1(16,3,0,0) as i64); c=o_nl(B,c);

  c=o_app(B,c,"CLAIM_PUBLISHED score 2 bytes 4,0,0 unique_first_max YES\n");
  c=o_app(B,c,"PROVER_COMPUTED score "); c=o_i64(B,c,best as i64);
  c=o_app(B,c," bytes "); c=o_i64(B,c,(firstmax/16) as i64); c=o_sp(B,c);
  c=o_i64(B,c,((firstmax%16)/4) as i64); c=o_sp(B,c);
  c=o_i64(B,c,(firstmax%4) as i64);
  c=o_app(B,c," unique "); if(uniq==1){ c=o_app(B,c,"YES"); } else { c=o_app(B,c,"NO"); }
  c=o_nl(B,c);
  if((best==2)&&(adopted==best)){
    c=o_app(B,c,"DL_SCORE_AND_PROGRAM REPRODUCED\n");
    if(uniq==1){ c=o_app(B,c,"DL_UNIQUENESS REPRODUCED\n"); }
    else {
      c=o_app(B,c,"DL_UNIQUENESS REFUTED the max is attained by ");
      c=o_i64(B,c,natmax as i64);
      c=o_app(B,c," distinct one-instruction programs, and the claim own prereg breaks the tie by candidate order first-max\n");
    }
  } else { c=o_app(B,c,"DL_FAILED\n"); }
  c=o_app(B,c,"PROV_CALR_END\n");
  _zag_print(B[0..c]);
  return 0;
}
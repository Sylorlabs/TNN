// C663 G4 CLOPPER-PEARSON, EXACT integer arithmetic, pure Zag.
// Zag has no floating point and none is used here.
//
// PROCESS DISCLOSURE (required by PREREG_2 S2-F4): my first implementation
// used base-256 bignums and a 10^-12 rational grid. It FAILED its own
// self-check against the red team's P(X<=1 | n=3, p=0.80) = 0.1040, so under
// S2-F4 it reports no interval and is discarded, not repaired-in-place. This
// replacement is exact integer arithmetic on a 10^-3 rational grid, which is
// exact (no rounding anywhere) but COARSER than the preregistered 10^-12 grid.
// The deviation is in precision only; alpha = 0.05 and the 0.80 bar are
// unchanged.
//
// Why i64 suffices: the tail is sum_k C(n,k) num^k (D-num)^(n-k) with D=1000.
// For n <= 6 the largest single term is C(6,3)*500^6 = 3.1e17 and the whole
// sum is D^n = 1e18, both inside i64 (9.2e18). n > 6 is refused rather than
// approximated. The alpha/2 = 1/40 threshold is applied as tail <= D^n/40,
// which is exact because 40 divides 10^18.
//
// The bound is reported as an exact bracket [lo/1000, (lo+1)/1000): the exact
// Clopper-Pearson limit lies in that half-open interval.
// usage: cp <n> <x> [<n> <x> ...]
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn powi(base:i64,e:i32)i64 {
  let r:i64=1; let i:i32=0;
  while(i<e){ r=r*base; i=i+1; }
  return r;
}
fn binomi(n:i32,k:i32)i64 {
  if(k<0){ return 0; }
  if(k>n){ return 0; }
  let kk:i32=k;
  if(n-k<kk){ kk=n-k; }
  let r:i64=1; let i:i32=1;
  while(i<=kk){ r=r*((n-kk+i) as i64)/(i as i64); i=i+1; }
  return r;
}
// exact sum over k in [lo,hi] of C(n,k) num^k (D-num)^(n-k)
fn tail(n:i32,lo:i32,hi:i32,num:i64,D:i64)i64 {
  let s:i64=0;
  let k:i32=lo;
  while(k<=hi){
    s=s+binomi(n,k)*powi(num,k)*powi(D-num,n-k);
    k=k+1;
  }
  return s;
}
fn atoi(s:[]u8)i64 {
  let v:i64=0; let i:i32=0;
  while(i<s.len){
    let ch:i32=s[i] as i32;
    if(ch>=48){ if(ch<=57){ v=v*10+(ch-48) as i64; } }
    i=i+1;
  }
  return v;
}
fn render(b:[]u8,c:i32,num:i64)i32 {
  let ipart:i64=num/1000 as i64;
  let f:i64=num%1000 as i64;
  c=o_i64(b,c,ipart);
  c=o_app(b,c,".");
  let s:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<8){ s[i]=48; i=i+1; }
  s[0]=(48+(f/100) as i32) as u8;
  s[1]=(48+((f/10)%10) as i32) as u8;
  s[2]=(48+(f%10) as i32) as u8;
  c=o_app(b,c,s[0..3]);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let D:i64=1000 as i64;
  let na:i32=_zag_argc();
  if(na<3){ _zag_println("cp usage: cp <n> <x> [<n> <x> ...]"); return 1; }

  // S2-F4 SELF-CHECK: exact P(X<=1 | n=3, p=0.80) must be 0.1040
  let t3:i64=tail(3,0,1,800 as i64,D);
  let d3:i64=powi(D,3);
  let sc:i32=0;
  if((1000 as i64)*t3==(104 as i64)*d3){ sc=1; }
  c=o_app(B,c,"SELFTEST_exact_P_XLE1_n3_p080_is_0.1040 ");
  if(sc==1){ c=o_app(B,c,"PASS\n"); } else { c=o_app(B,c,"FAIL\n"); }
  c=o_app(B,c,"GRID 1/1000 EXACT alpha_two_sided_0.05 ALPHA_HALF_1_over_40\n");

  let i:i32=1;
  while(i+1<na){
    let n:i32=atoi(_zag_arg(i)) as i32;
    let x:i32=atoi(_zag_arg(i+1)) as i32;
    if((n>6)||(n<1)){
      c=o_app(B,c,"CP n="); c=o_i64(B,c,n as i64);
      c=o_app(B,c," x="); c=o_i64(B,c,x as i64);
      c=o_app(B,c," UNSUPPORTED_N_GT_6 no_interval_reported\n");
      i=i+2;
    } else {
      let thr:i64=powi(D,n)/40 as i64;
      // LOWER LIMIT L solves P(X>=x | p=L) = alpha/2. P(X>=x|p) DECREASES in p,
      // so the predicate P<=thr is monotone decreasing and the bisection must be
      // mirrored. loq = smallest num with P > thr; then L in [(loq-1)/D, loq/D).
      let a:i32=0;
      let bq:i32=1000;
      while(a<bq){
        let mid:i32=(a+bq)/2;
        if(tail(n,x,n,mid as i64,D)>thr){ bq=mid; } else { a=mid+1; }
      }
      let lo:i32=a;
      // UPPER: smallest num with P(X<=x) <= alpha/2
      let a2:i32=0;
      let b2:i32=1000;
      while(a2<b2){
        let mid:i32=(a2+b2)/2;
        if(tail(n,0,x,mid as i64,D)<=thr){ b2=mid; } else { a2=mid+1; }
      }
      c=o_app(B,c,"CP n="); c=o_i64(B,c,n as i64);
      c=o_app(B,c," x="); c=o_i64(B,c,x as i64);
      c=o_app(B,c," point=");
      c=render(B,c,(x as i64)*1000 as i64/(n as i64));
      c=o_app(B,c," lo95_in_bracket=");
      c=render(B,c,(lo-1) as i64);
      c=o_app(B,c," to ");
      c=render(B,c,lo as i64);
      c=o_app(B,c," open_at_right");
      c=o_app(B,c," hi95_in_bracket=");
      c=render(B,c,a2 as i64);
      c=o_app(B,c," to ");
      c=render(B,c,(a2+1) as i64);
      c=o_app(B,c," open_at_right");
      c=o_nl(B,c);
      i=i+2;
    }
  }
  c=o_app(B,c,"CP_END\n");
  _zag_print(B[0..c]);
  return 0;
}
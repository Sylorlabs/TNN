// C664 G6 LANE-VISIBILITY SWEEP, re-run against the RESTORED tip.
// Pure Zag: all counting and set arithmetic is done here; git only produced the
// three path lists (tree objects only, mode 040000, depth 5).
// usage: sweep <labelA> <listA> <labelB> <listB>
// prints: counts, |A \ B|, |B \ A| and every member of each difference.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
// flatten a file into a []u8 table of newline-terminated records + offsets
fn load(path:[]u8,buf:[]u8,off:[]u8,cap:i32)i32 {
  let s:[]u8=_zag_read_file(path);
  let n:i32=s.len;
  if(n<1){ return 0; }
  let i:i32=0;
  let k:i32=0;
  while(i<n){
    let st:i32=i;
    while((i<n)&&((s[i] as i32)!=10)){ i=i+1; }
    if(i>st){
      let j:i32=st;
      while(j<i){ buf[k]=s[j]; k=k+1; j=j+1; }
      buf[k]=10; k=k+1;
      if((k+8)<cap){ off[k]=0; }
    } else { i=i+1; }
  }
  return k;
}
fn has(buf:[]u8,k:i32,name:[]u8)i32 {
  let i:i32=0;
  while(i<k){
    let j:i32=i;
    while(j<k){ if(buf[j]==10){ j=k+1; } else { j=j+1; } }
    if(j>k){ j=k; }
    let e:i32=i;
    while((e<k)&&(buf[e]!=10)){ e=e+1; }
    let m:i32=0; let ok:i32=1;
    if((e-i)!=name.len){ ok=0; }
    if(ok==1){
      let t:i32=0;
      while(t<name.len){ if(buf[i+t]!=name[t]){ ok=0; } t=t+1; }
    }
    if(ok==1){ return 1; }
    i=e+1;
  }
  return 0;
}
fn main()i32 {
  let B:[]u8=z_alloc(262144);
  let c:i32=0;
  let na:i32=_zag_argc();
  if(na<5){ _zag_println("sweep usage: sweep <labelA> <listA> <labelB> <listB>"); return 1; }
  let la:[]u8=_zag_arg(1);
  let pa:[]u8=_zag_arg(2);
  let lb:[]u8=_zag_arg(3);
  let pb:[]u8=_zag_arg(4);
  let AB:[]u8=z_alloc(262144);
  let BB:[]u8=z_alloc(262144);
  let ka:i32=load(pa,AB,z_alloc(16),262144);
  let kb:i32=load(pb,BB,z_alloc(16),262144);
  let ra:i32=0; let z1:i32=0;
  while(z1<ka){ if(AB[z1]==10){ ra=ra+1; } z1=z1+1; }
  let rb:i32=0; let z2:i32=0;
  while(z2<kb){ if(BB[z2]==10){ rb=rb+1; } z2=z2+1; }
  c=o_app(B,c,"LIST "); c=o_app(B,c,la);
  c=o_app(B,c," records "); c=o_i64(B,c,ra as i64);
  c=o_app(B,c," bytes "); c=o_i64(B,c,ka as i64); c=o_nl(B,c);
  c=o_app(B,c,"LIST "); c=o_app(B,c,lb);
  c=o_app(B,c," records "); c=o_i64(B,c,rb as i64);
  c=o_app(B,c," bytes "); c=o_i64(B,c,kb as i64); c=o_nl(B,c);

  // A \ B : entries of A absent from B. THIS is the visibility question.
  let miss:i32=0;
  let i:i32=0;
  while(i<ka){
    let e:i32=i;
    while((e<ka)&&(AB[e]!=10)){ e=e+1; }
    if(e>i){
      let name:[]u8=AB[i..e];
      if(has(BB,kb,name)==0){
        miss=miss+1;
        c=o_app(B,c,"ABSENT_FROM_"); c=o_app(B,c,lb);
        c=o_app(B,c," "); c=o_app(B,c,name); c=o_nl(B,c);
      }
    }
    i=e+1;
  }
  c=o_app(B,c,"DIFF_A_minus_B "); c=o_i64(B,c,miss as i64); c=o_nl(B,c);

  // B \ A
  let extra:i32=0;
  i=0;
  while(i<kb){
    let e:i32=i;
    while((e<kb)&&(BB[e]!=10)){ e=e+1; }
    if(e>i){
      let name:[]u8=BB[i..e];
      if(has(AB,ka,name)==0){
        extra=extra+1;
        c=o_app(B,c,"NEW_IN_"); c=o_app(B,c,lb);
        c=o_app(B,c," "); c=o_app(B,c,name); c=o_nl(B,c);
      }
    }
    i=e+1;
  }
  c=o_app(B,c,"DIFF_B_minus_A "); c=o_i64(B,c,extra as i64); c=o_nl(B,c);
  c=o_app(B,c,"SWEEP_END\n");
  _zag_print(B[0..c]);
  return 0;
}
fn main()i32 {
  let B:[]u8=g2_alloc(65536);
  let c:i32=0;
  let na:i32=_zag_argc();
  if(na<2){ _zag_println("SHA256 usage: sha256 <file> [<file>...]"); return 1; }
  let i:i32=1;
  let bad:i32=0;
  while(i<na){
    let p:[]u8=_zag_arg(i);
    let m:[]u8=_zag_read_file(p);
    let o:[]u8=g2_alloc(32);
    let rc:i32=ns_sha256(m,o);
    c=o_app(B,c,"SHA256 ");
    c=o_app(B,c,p);
    c=o_app(B,c," ");
    if(rc!=0){ c=o_app(B,c,"RC_FAIL "); c=o_i64(B,c,rc as i64); bad=bad+1; }
    let t:[]u8=ns_hex(o);
    c=o_app(B,c,t);
    c=o_app(B,c," ");
    c=o_app(B,c,"BYTES ");
    c=o_i64(B,c,m.len as i64);
    c=o_app(B,c,"\n");
    i=i+1;
  }
  c=o_app(B,c,"SHA_RC_FAILS ");
  c=o_i64(B,c,bad as i64);
  c=o_app(B,c,"\n");
  c=o_app(B,c,"SHA_END\n");
  _zag_print(B[0..c]);
  return 0;
}

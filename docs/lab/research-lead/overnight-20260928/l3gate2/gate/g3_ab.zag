// C665 G3 CAPABILITY-ABLATION gate, v2. Frozen machine rule (PREREG_2 s3):
//   MARKER  = any of NOSLOT NOLOOP NOWRAP NOINV NOMEM NOSLOTS ABL A- WIPE ABLATE
//   HELDOUT = heldout / held_out / held-out / HELDOUT
//   AB-PRESENT  iff MARKER>0 AND some HELDOUT occurs within 400 bytes AFTER a
//                  MARKER (a keyed held-out score, not merely a held-out set)
//   AB-PARTIAL  iff MARKER>0 and no such proximity
//   AB-ABSENT   iff MARKER=0
// usage: g3_ab <src> <decl>
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn mat(s:[]u8,n:i32,at:i32,p:[]u8)i32 {
  let m:i32=p.len;
  if(at<0){ return 0; }
  if(at+m>n){ return 0; }
  let i:i32=0; let ok:i32=1;
  while(i<m){ if((s[at+i] as i32)!=(p[i] as i32)){ ok=0; } i=i+1; }
  return ok;
}
fn find(s:[]u8,n:i32,p:[]u8,from:i32)i32 {
  let i:i32=from; let g:i32=1;
  while(g==1){ if(i>=n){ g=0; } else { if(mat(s,n,i,p)==1){ g=0; } else { i=i+1; } } }
  if(i>=n){ return -1; }
  return i;
}
fn count(s:[]u8,n:i32,p:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<=n){ if(mat(s,n,i,p)==1){ c=c+1; i=i+p.len; } else { i=i+1; } }
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let na:i32=_zag_argc();
  if(na<3){ _zag_println("g3_ab usage: g3_ab <src> <decl>"); return 1; }
  let sv:[]u8=_zag_read_file(_zag_arg(1));
  let dv:[]u8=_zag_read_file(_zag_arg(2));
  let sn:i32=sv.len;
  let dn:i32=dv.len;
  if((sn<1)||(dn<1)){ _zag_println("G3_FATAL EMPTY_INPUT"); return 2; }
  let MK:[]u8="NOSLOT\nNOLOOP\nNOWRAP\nNOINV\nNOMEM\nNOSLOTS\nABL\nA-\nWIPE\nABLATE\n";
  let HO:[]u8="heldout\nheld_out\nheld-out\nHELDOUT\nHeldOut\nHELDOUT\n";
  let mk:i32=0;
  let ho:i32=0;
  let keyed:i32=0;
  // scan both bundles; a marker in one and a heldout token in the other at any
  // distance also counts as keyed, because the pair is a claim-level artifact
  let t:i32=0;
  while(t<m_len(MK)){
    let tok:i32=t;
    while((tok<m_len(MK))&&((MK[tok] as i32)!=10)){ tok=tok+1; }
    if(tok>t){
      let p:[]u8=MK[t..tok];
      let a:i32=count(sv,sn,p);
      let b:i32=count(dv,dn,p);
      mk=mk+a+b;
    }
    t=tok+1;
  }
  t=0;
  while(t<m_len(HO)){
    let tok:i32=t;
    while((tok<m_len(HO))&&((HO[tok] as i32)!=10)){ tok=tok+1; }
    if(tok>t){
      let p:[]u8=HO[t..tok];
      let a:i32=count(sv,sn,p);
      let b:i32=count(dv,dn,p);
      ho=ho+a+b;
    }
    t=tok+1;
  }
  // proximity within 400 bytes, inside each bundle
  let pr:i32=0;
  let srcs:[]u8=sv;
  let srcn:i32=sn;
  let s:i32=0;
  while(s<srcn){
    let hit:i32=-1;
    t=0;
    while(t<m_len(MK)){
      let tok:i32=t;
      while((tok<m_len(MK))&&((MK[tok] as i32)!=10)){ tok=tok+1; }
      if(tok>t){
        let p:[]u8=MK[t..tok];
        let at:i32=find(srcs,srcn,p,s);
        if(at>=0){ hit=at; }
      }
      t=tok+1;
    }
    if(hit<0){ s=srcn; }
    else {
      let lim:i32=hit+400;
      if(lim>srcn){ lim=srcn; }
      t=0;
      while(t<m_len(HO)){
        let tok:i32=t;
        while((tok<m_len(HO))&&((HO[tok] as i32)!=10)){ tok=tok+1; }
        if(tok>t){
          let p:[]u8=HO[t..tok];
          let at:i32=find(srcs,lim,p,hit);
          if(at>=0){ pr=pr+1; }
        }
        t=tok+1;
      }
      s=hit+1;
    }
  }
  let srcs2:[]u8=dv;
  let srcn2:i32=dn;
  s=0;
  while(s<srcn2){
    let hit:i32=-1;
    t=0;
    while(t<m_len(MK)){
      let tok:i32=t;
      while((tok<m_len(MK))&&((MK[tok] as i32)!=10)){ tok=tok+1; }
      if(tok>t){
        let p:[]u8=MK[t..tok];
        let at:i32=find(srcs2,srcn2,p,s);
        if(at>=0){ hit=at; }
      }
      t=tok+1;
    }
    if(hit<0){ s=srcn2; }
    else {
      let lim:i32=hit+400;
      if(lim>srcn2){ lim=srcn2; }
      t=0;
      while(t<m_len(HO)){
        let tok:i32=t;
        while((tok<m_len(HO))&&((HO[tok] as i32)!=10)){ tok=tok+1; }
        if(tok>t){
          let p:[]u8=HO[t..tok];
          let at:i32=find(srcs2,lim,p,hit);
          if(at>=0){ pr=pr+1; }
        }
        t=tok+1;
      }
      s=hit+1;
    }
  }
  c=o_app(B,c,"G3 MARKER_HITS "); c=o_i64(B,c,mk as i64);
  c=o_app(B,c," HELDOUT_HITS "); c=o_i64(B,c,ho as i64);
  c=o_app(B,c," KEYED_PROXIMITY "); c=o_i64(B,c,pr as i64); c=o_nl(B,c);
  if((mk>0)&&(pr>0)){ c=o_app(B,c,"G3_VERDICT AB-PRESENT\n"); }
  else { if(mk>0){ c=o_app(B,c,"G3_VERDICT AB-PARTIAL\n"); } else { c=o_app(B,c,"G3_VERDICT AB-ABSENT\n"); } }
  c=o_app(B,c,"G3_END\n");
  _zag_print(B[0..c]);
  return 0;
}
fn m_len(s:[]u8)i32 { return s.len; }
// C661 GATE-2 SHA-256. PROVENANCE: the compression function below is the
// corpus's own already-verified implementation,
//   docs/generations/R33/runs/R33_CLOSEOUT_20260915T174458Z/sources/Research/
//   R33_NATIVE_SHA256_V2.zag  (RFC 6234 s5.1 constants, self-checked upstream),
// read via `git show`, with its @import replaced by the local allocator below
// and a CLI main added. My own from-scratch port was written first, produced
// wrong digests on all 13 S2-P3 vectors, and is retained untracked at
// .scratch/sha256_port_FAILED.zag as the record of that failure.
// The @import shim (nio_alloc/nio_free) is the ONLY code not from that file.
// Self-check bar S2-P3: 13/13 byte-identical to `shasum -a 256`.
fn nio_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn nio_free(b:[]u8)void { return; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn ns_hex_digit(c:i32)i64 {
    if(c>=48 && c<=57){return (c-48) as i64;}
    if(c>=97 && c<=102){return (c-87) as i64;}return -1;
}
fn ns_hex_word(text:[]u8,at:i32)i64 {
    if(at<0 || text.len<8 || at>text.len-8){return -1;}
    let x:i64=0;let i:i32=0;
    while(i<8){let d:i64=ns_hex_digit(text[at+i] as i32);if(d<0){return -1;}x=x*16+d;i=i+1;}return x;
}
fn ns_load_words(text:[]u8,out:[]i64)i32 {
    if(out.len<1 || out.len>64 || text.len!=out.len*9-1){return -1;}
    let i:i32=0;
    while(i<out.len){
        if(ns_hex_word(text,i*9)<0){return -1;}
        if(i<out.len-1 && text[i*9+8]!=32){return -1;}i=i+1;
    }
    i=0;while(i<out.len){out[i]=ns_hex_word(text,i*9);i=i+1;}return 0;
}
fn ns_rotr(x:i64,n:i32)i64 {
    return ((x>>n)|(x<<(32-n))) & 4294967295;
}
fn ns_sha256(input:[]u8,out:[]u8)i32 {
    if(input.len<0 || input.len>33554360 || out.len<32){return -7403;}
    let size:i32=((input.len+72)/64)*64;
    let bytes:[]u8=nio_alloc(size);if(bytes.len!=size){return -12;}
    let wp:*i64=_zag_malloc(512) as *i64;
    let hp:*i64=_zag_malloc(64) as *i64;
    let kp:*i64=_zag_malloc(512) as *i64;
    if(wp==null as *i64 || hp==null as *i64 || kp==null as *i64){
        if(wp!=null as *i64){_zag_free(wp as *i8);}
        if(hp!=null as *i64){_zag_free(hp as *i8);}
        if(kp!=null as *i64){_zag_free(kp as *i8);}nio_free(bytes);return -12;
    }
    let w:[]i64=wp[0..64];let h:[]i64=hp[0..8];let k:[]i64=kp[0..64];
    let hs:[]u8="6a09e667 bb67ae85 3c6ef372 a54ff53a 510e527f 9b05688c 1f83d9ab 5be0cd19";
    let ks:[]u8="428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2";
    if(ns_load_words(hs,h)!=0 || ns_load_words(ks,k)!=0){
        nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return -7401;
    }
    let i:i32=0;
    i=0;while(i<input.len){bytes[i]=input[i];i=i+1;}
    bytes[input.len]=128;let bits:i64=(input.len as i64)*8;i=0;
    while(i<8){bytes[size-1-i]=(bits & 255) as u8;bits=bits>>8;i=i+1;}
    let block:i32=0;
    while(block<size){
        i=0;while(i<16){
            let at:i32=block+i*4;
            w[i]=(bytes[at] as i64)*16777216+(bytes[at+1] as i64)*65536+
                 (bytes[at+2] as i64)*256+(bytes[at+3] as i64);i=i+1;
        }
        while(i<64){
            let s0:i64=ns_rotr(w[i-15],7)^ns_rotr(w[i-15],18)^(w[i-15]>>3);
            let s1:i64=ns_rotr(w[i-2],17)^ns_rotr(w[i-2],19)^(w[i-2]>>10);
            w[i]=(w[i-16]+s0+w[i-7]+s1)&4294967295;i=i+1;
        }
        let a:i64=h[0];let b:i64=h[1];let c:i64=h[2];let d:i64=h[3];
        let e:i64=h[4];let f:i64=h[5];let g:i64=h[6];let hv:i64=h[7];
        i=0;while(i<64){
            let s1:i64=ns_rotr(e,6)^ns_rotr(e,11)^ns_rotr(e,25);
            let choose:i64=(e&f)^((4294967295^e)&g);
            let t1:i64=(hv+s1+choose+k[i]+w[i])&4294967295;
            let s0:i64=ns_rotr(a,2)^ns_rotr(a,13)^ns_rotr(a,22);
            let majority:i64=(a&b)^(a&c)^(b&c);let t2:i64=(s0+majority)&4294967295;
            hv=g;g=f;f=e;e=(d+t1)&4294967295;d=c;c=b;b=a;a=(t1+t2)&4294967295;i=i+1;
        }
        h[0]=(h[0]+a)&4294967295;h[1]=(h[1]+b)&4294967295;
        h[2]=(h[2]+c)&4294967295;h[3]=(h[3]+d)&4294967295;
        h[4]=(h[4]+e)&4294967295;h[5]=(h[5]+f)&4294967295;
        h[6]=(h[6]+g)&4294967295;h[7]=(h[7]+hv)&4294967295;block=block+64;
    }
    i=0;while(i<8){
        out[i*4]=((h[i]>>24)&255) as u8;out[i*4+1]=((h[i]>>16)&255) as u8;
        out[i*4+2]=((h[i]>>8)&255) as u8;out[i*4+3]=(h[i]&255) as u8;i=i+1;
    }
    nio_free(bytes);_zag_free(wp as *i8);_zag_free(hp as *i8);_zag_free(kp as *i8);return 0;
}
fn ns_hex(bytes:[]u8)[]u8 {
    if(bytes.len<1 || bytes.len>1024){return "";}
    let text:[]u8=nio_alloc(bytes.len*2);if(text.len==0){return text;}
    let digits:[]u8="0123456789abcdef";let i:i32=0;
    while(i<bytes.len){let v:i32=bytes[i] as i32;text[2*i]=digits[v/16];text[2*i+1]=digits[v%16];i=i+1;}
    return text;
}
fn g2_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
// C661-C663 G1 v2 INDEPENDENCE GATE. Body only; prepend gate/sha_core.zag.
// Build:  cat gate/sha_core.zag gate/g1_indep.zag > gate/g1_indep_build.zag
// usage: g1_indep --prover P --manifest M [--manifest M] --decl D --src S --lanename X
// Manifest lines are paths relative to the current directory.
// Enforces PREREG_2 G1.2 (INDEP-1/2/3) and G1.3 (KEYONLY-2).

fn g1_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn g1_get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn g1_set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g1_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn g1_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len; }
fn g1_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn g1_sp(b:[]u8,c:i32)i32 { b[c]=32; return c+1; }
fn g1_isdig(c:i32)i32 { if(c<48){ return 0; } if(c>57){ return 0; } return 1; }
fn g1_isalp(c:i32)i32 {
  if(c==95){ return 1; }
  if(c<65){ return 0; }
  if(c>90){ return 1; }
  if(c<97){ return 0; }
  if(c>122){ return 0; }
  return 1;
}
fn g1_issp(c:i32)i32 { if(c==32){ return 1; } if(c==9){ return 1; } if(c==13){ return 1; } return 0; }
fn g1_mat(s:[]u8,n:i32,at:i32,p:[]u8)i32 {
  let m:i32=p.len;
  if(at<0){ return 0; }
  if(at+m>n){ return 0; }
  let i:i32=0; let ok:i32=1;
  while(i<m){ if((s[at+i] as i32)!=(p[i] as i32)){ ok=0; } i=i+1; }
  return ok;
}
fn g1_find(s:[]u8,n:i32,p:[]u8,from:i32)i32 {
  let i:i32=from; let g:i32=1;
  while(g==1){
    if(i>=n){ g=0; } else { if(g1_mat(s,n,i,p)==1){ g=0; } else { i=i+1; } }
  }
  if(i>=n){ return -1; }
  return i;
}
fn g1_count(s:[]u8,n:i32,p:[]u8)i32 {
  let c:i32=0; let i:i32=0;
  while(i<=n){ if(g1_mat(s,n,i,p)==1){ c=c+1; i=i+p.len; } else { i=i+1; } }
  return c;
}
fn g1_skipsp(s:[]u8,n:i32,j:i32)i32 {
  let k:i32=j; let g:i32=1;
  while(g==1){ if(k>=n){ g=0; } else { if(g1_issp(s[k] as i32)==1){ k=k+1; } else { g=0; } } }
  return k;
}
fn g1_in(tab:[]u8,m:i32,v:i32)i32 {
  let i:i32=0; let f:i32=0;
  while(i<m){ if(g1_get32(tab,i*4)==v){ f=1; } i=i+1; }
  return f;
}
fn g1_lits(s:[]u8,n:i32,tab:[]u8,cap:i32)i32 {
  let m:i32=0; let i:i32=0;
  while(i<n){
    let isd:i32=g1_isdig(s[i] as i32);
    let ok:i32=1;
    if(i>0){ if(g1_isalp(s[i-1] as i32)==1){ ok=0; } }
    if(isd==1 && ok==1){
      let v:i32=0; let g:i32=1;
      while(g==1){ if(i>=n){ g=0; } else { if(g1_isdig(s[i] as i32)==1){ v=v*10+((s[i] as i32)-48); i=i+1; } else { g=0; } } }
      if(m<cap){ if(g1_in(tab,m,v)==0){ g1_set32(tab,m*4,v); m=m+1; } }
    } else { i=i+1; }
  }
  return m;
}
// FROZEN MECHANICAL EXEMPTION LIST (PREREG_2 G1.3). Do not amend.
fn g1_mech(M:[]u8)i32 {
  g1_set32(M,0,0); g1_set32(M,4,1); g1_set32(M,8,2); g1_set32(M,12,3); g1_set32(M,16,8);
  g1_set32(M,20,10); g1_set32(M,24,13); g1_set32(M,28,32); g1_set32(M,32,45); g1_set32(M,36,48);
  g1_set32(M,40,57); g1_set32(M,44,58); g1_set32(M,48,95); g1_set32(M,52,97); g1_set32(M,56,100);
  g1_set32(M,60,255); g1_set32(M,64,256); g1_set32(M,68,611); g1_set32(M,72,8192);
  g1_set32(M,76,65536); g1_set32(M,80,1000000);
  return 21;
}
// DECISION REGION start byte: strictly after the LAST line containing any
// mandatory-output-prelude function header. Mechanical; no hand counting.
fn g1_decstart(p:[]u8,pn:i32)i32 {
  let names:[]u8=g1_alloc(512);
  let m:i32=0;
  m=g1_app(names,m,"fn z_alloc(\n"); m=g1_app(names,m,"fn o_i64(\n");
  m=g1_app(names,m,"fn o_i32(\n"); m=g1_app(names,m,"fn o_app(\n");
  m=g1_app(names,m,"fn o_nl(\n");  m=g1_app(names,m,"fn o_sp(\n");
  m=g1_app(names,m,"fn o_flush(\n"); m=g1_app(names,m,"fn o_i64(\n");
  m=g1_app(names,m,"fn g1_i64(\n"); m=g1_app(names,m,"fn g1_app(\n");
  m=g1_app(names,m,"fn g1_nl(\n");  m=g1_app(names,m,"fn g1_sp(\n");
  m=g1_app(names,m,"fn g2_i64(\n"); m=g1_app(names,m,"fn g2_app(\n");
  m=g1_app(names,m,"fn g1_get32(\n"); m=g1_app(names,m,"fn g1_set32(\n");
  m=g1_app(names,m,"fn pr(\n");     m=g1_app(names,m,"fn o_i32(\n");
  m=g1_app(names,m,"fn nio_alloc(\n"); m=g1_app(names,m,"fn g2_alloc(\n");
  let lastend:i32=0;
  let ls:i32=0;
  while(ls<=pn){
    let le:i32=ls; let g:i32=1;
    while(g==1){ if(le>=pn){ g=0; } else { if((p[le] as i32)==10){ g=0; } else { le=le+1; } } }
    let t:i32=0;
    while(t<m){
      let tok:i32=t;
      while((tok<m)&&((names[tok] as i32)!=10)){ tok=tok+1; }
      if(g1_find(p,pn,names[t..tok],ls)>=0){ lastend=le+1; }
      t=tok+1;
    }
    ls=le+1;
  }
  return lastend;
}
// NKEY / NPROBE / NMENU over an arbitrary source. Results into out (2 x i32).
fn g1_keyscan(s:[]u8,n:i32,out:[]u8)void {
  let NA:[]u8=g1_alloc(64*24);
  let MC:[]u8=g1_alloc(64*4);
  let RL:[]u8=g1_alloc(64*4);
  let BR:[]u8=g1_alloc(64*4);
  let nn:i32=0; let bestkey:i32=0; let bestfn:i32=-1; let prev:i32=-1;
  let ls:i32=0;
  while(ls<=n){
    let le:i32=ls; let g:i32=1;
    while(g==1){ if(le>=n){ g=0; } else { if((s[le] as i32)==10){ g=0; } else { le=le+1; } } }
    let nm:i32=-1; let nargs:i32=-1;
    let p:i32=ls;
    while(p<le){
      if(g1_isalp(s[p] as i32)==1){
        let st:i32=p; let g2:i32=1;
        while(g2==1){ if(p>=le){ g2=0; } else { if(g1_isalp(s[p] as i32)==1){ p=p+1; } else { g2=0; } } }
        let q:i32=g1_skipsp(s,le,p);
        if(q<le){ if((s[q] as i32)==40){
          nm=st;
          let ac:i32=0; let d:i32=1; let r2:i32=q+1;
          while(d>0){
            if(r2>=le){ d=0; } else {
              let ch:i32=s[r2] as i32;
              if(ch==40){ d=d+1; }
              if(ch==41){ d=d-1; }
              if(ch==34){ r2=r2+1; let g3:i32=1; while(g3==1){ if(r2>=le){ g3=0; } else { if((s[r2] as i32)==34){ g3=0; } else { r2=r2+1; } } } }
              else { r2=r2+1; }
              if(d>0){ if(g1_isdig(ch)==1){ ac=ac+1; } }
            }
          }
          nargs=ac;
        } }
        p=p+1;
      } else { p=p+1; }
    }
    if(nm>=0){
      if(nargs>=3){
        let slot:i32=-1; let t:i32=0;
        while(t<nn){
          let same:i32=1; let u:i32=0;
          while(u<24){ let a:i32=0; if(nm+u<le){ a=s[nm+u] as i32; } if(a!=(NA[t*24+u] as i32)){ same=0; } u=u+1; }
          if(same==1){ slot=t; }
          t=t+1;
        }
        if(slot<0){
          if(nn<64){
            let u2:i32=0;
            while(u2<24){ let v:i32=0; if(nm+u2<le){ v=s[nm+u2] as i32; } NA[nn*24+u2]=v as u8; u2=u2+1; }
            slot=nn; nn=nn+1; g1_set32(MC,slot*4,0); g1_set32(RL,slot*4,0); g1_set32(BR,slot*4,0);
          }
        }
        if(slot>=0){
          if(nargs>g1_get32(MC,slot*4)){ g1_set32(MC,slot*4,nargs); }
          if(slot==prev){ g1_set32(RL,slot*4,g1_get32(RL,slot*4)+1); } else { g1_set32(RL,slot*4,1); }
          if(g1_get32(RL,slot*4)>g1_get32(BR,slot*4)){ g1_set32(BR,slot*4,g1_get32(RL,slot*4)); }
          if(g1_get32(BR,slot*4)>bestkey){ bestkey=g1_get32(BR,slot*4); bestfn=slot; }
          prev=slot;
        }
      } else { prev=-1; }
    }
    ls=le+1;
  }
  let npr:i32=0;
  if(bestfn>=0){ npr=g1_get32(MC,bestfn*4); }
  g1_set32(out,0,bestkey);
  g1_set32(out,4,npr);
  return;
}
fn g1_menu(s:[]u8,n:i32,tab:[]u8)i32 {
  let m:i32=0; let w:i32=0;
  while(w<n){
    if(g1_mat(s,n,w,"while")==1){
      let j:i32=g1_skipsp(s,n,w+5);
      if(j<n){ if((s[j] as i32)==40){
        let k:i32=j+1; let depth:i32=1;
        while(depth>0){
          if(k>=n){ depth=0; } else {
            let ch:i32=s[k] as i32;
            if(ch==40){ depth=depth+1; }
            if(ch==41){ depth=depth-1; }
            if(ch==60){
              let p2:i32=k+1;
              if(p2<n){ if((s[p2] as i32)==61){ p2=p2+1; } }
              p2=g1_skipsp(s,n,p2);
              if(p2<n){ if(g1_isdig(s[p2] as i32)==1){
                let v:i32=0; let g:i32=1;
                while(g==1){ if(p2>=n){ g=0; } else { if(g1_isdig(s[p2] as i32)==1){ v=v*10+((s[p2] as i32)-48); p2=p2+1; } else { g=0; } } }
                if(m<8192){ if(g1_in(tab,m,v)==0){ g1_set32(tab,m*4,v); m=m+1; } }
              } }
            }
            k=k+1;
          }
        }
      } }
    }
    w=w+1;
  }
  return m;
}

fn main()i32 {
  let B:[]u8=g1_alloc(262144);
  let c:i32=0;
  let na:i32=_zag_argc();
  if(na<2){ _zag_println("g1_indep: missing args"); return 1; }
  let prover:[]u8="-";
  let declp:[]u8="-";
  let srcp:[]u8="-";
  let lanename:[]u8="-";
  let m1:[]u8="-"; let m2:[]u8="-";
  let i:i32=1;
  while(i<na){
    let a:[]u8=_zag_arg(i);
    if(g1_mat(a,a.len,0,"--prover")==1){ prover=_zag_arg(i+1); }
    if(g1_mat(a,a.len,0,"--decl")==1){ declp=_zag_arg(i+1); }
    if(g1_mat(a,a.len,0,"--src")==1){ srcp=_zag_arg(i+1); }
    if(g1_mat(a,a.len,0,"--lanename")==1){ lanename=_zag_arg(i+1); }
    if(g1_mat(a,a.len,0,"--manifest")==1){ if(m1[0]==45){ m1=_zag_arg(i+1); } else { m2=_zag_arg(i+1); } }
    i=i+1;
  }
  if((prover[0]==45)||(declp[0]==45)||(srcp[0]==45)){ _zag_println("g1_indep: --prover --decl --src required"); return 1; }

  let pv:[]u8=_zag_read_file(prover);
  let pn:i32=pv.len;
  if(pn<1){ _zag_println("G1_FATAL EMPTY_PROVER"); return 2; }
  let D:[]u8=g1_alloc(32);
  ns_sha256(pv,D);
  let DH:[]u8=ns_hex(D);
  c=g1_app(B,c,"PROVER_SHA256 ");
  let q0:i32=0;
  while(q0<64){ B[c+q0]=DH[q0]; q0=q0+1; }
  c=c+64;
  c=g1_app(B,c," PROVER_BYTES "); c=g1_i64(B,c,pn as i64); c=g1_nl(B,c);

  let dv:[]u8=_zag_read_file(declp);
  let dn:i32=dv.len;
  let sv:[]u8=_zag_read_file(srcp);
  let sn:i32=sv.len;
  if((dn<1)||(sn<1)){ _zag_println("G1_FATAL EMPTY_DECL_OR_SRC"); return 2; }
  let DT:[]u8=g1_alloc(8192*4);
  let dm:i32=g1_lits(dv,dn,DT,8192);
  let ST:[]u8=g1_alloc(8192*4);
  let sm:i32=g1_lits(sv,sn,ST,8192);
  let MECH:[]u8=g1_alloc(128);
  let mm:i32=g1_mech(MECH);
  c=g1_app(B,c,"DECL_LITERALS "); c=g1_i64(B,c,dm as i64);
  c=g1_app(B,c," SRC_LITERALS "); c=g1_i64(B,c,sm as i64);
  c=g1_app(B,c," MECH_EXEMPT "); c=g1_i64(B,c,mm as i64); c=g1_nl(B,c);

  let pred:i32=0;
  let t:i32=0;
  while(t<dm){ if(g1_in(ST,sm,g1_get32(DT,t*4))==0){ pred=pred+1; } t=t+1; }
  c=g1_app(B,c,"PRED_LIT "); c=g1_i64(B,c,pred as i64); c=g1_nl(B,c);

  let ds:i32=g1_decstart(pv,pn);
  if(ds>pn){ ds=pn; }
  let dloc:i32=0;
  let z:i32=ds;
  while(z<pn){ if((pv[z] as i32)==10){ dloc=dloc+1; } z=z+1; }
  c=g1_app(B,c,"DECISION_START_BYTE "); c=g1_i64(B,c,ds as i64);
  c=g1_app(B,c," DECISION_BYTES "); c=g1_i64(B,c,(pn-ds) as i64);
  c=g1_app(B,c," DECISION_LOC "); c=g1_i64(B,c,dloc as i64); c=g1_nl(B,c);

  // decision-region literal sets
  let DL:[]u8=g1_alloc(2048*4);
  let dn2:i32=0;
  let foreign:i32=0;
  z=ds;
  while(z<pn){
    let isd:i32=g1_isdig(pv[z] as i32);
    let ok:i32=1;
    if(z>0){ if(g1_isalp(pv[z-1] as i32)==1){ ok=0; } }
    if(isd==1 && ok==1){
      let v:i32=0; let g:i32=1;
      while(g==1){ if(z>=pn){ g=0; } else { if(g1_isdig(pv[z] as i32)==1){ v=v*10+((pv[z] as i32)-48); z=z+1; } else { g=0; } } }
      if(dn2<2048){ if(g1_in(DL,dn2,v)==0){ g1_set32(DL,dn2*4,v); dn2=dn2+1; } }
      if((g1_in(DT,dm,v)==0)&&(g1_in(MECH,mm,v)==0)){ foreign=foreign+1; }
    } else { z=z+1; }
  }
  if(foreign==0){ c=g1_app(B,c,"ASSERT-KEYONLY-2 PASS foreign=0\n"); }
  else {
    c=g1_app(B,c,"ASSERT-KEYONLY-2 FAIL foreign="); c=g1_i64(B,c,foreign as i64);
    c=g1_app(B,c," literals ");
    let u:i32=0;
    while(u<dn2){ let vv:i32=g1_get32(DL,u*4); if((g1_in(DT,dm,vv)==0)&&(g1_in(MECH,mm,vv)==0)){ c=g1_i64(B,c,vv as i64); c=g1_sp(B,c); } u=u+1; }
    c=g1_nl(B,c);
  }
  let xprov:i32=0;
  let u2:i32=0;
  while(u2<dn2){ let v2:i32=g1_get32(DL,u2*4); if((g1_in(DT,dm,v2)==1)&&(g1_in(ST,sm,v2)==0)){ xprov=xprov+1; } u2=u2+1; }
  c=g1_app(B,c,"DECL_NOT_IN_SRC_IN_DECISION "); c=g1_i64(B,c,xprov as i64); c=g1_nl(B,c);
  if((foreign==0)&&(xprov>=1)){ c=g1_app(B,c,"ASSERT-INDEP-2 PASS\n"); }
  else { c=g1_app(B,c,"ASSERT-INDEP-2 FAIL needs_foreign_0_and_declnotinsrc_ge_1\n"); }

  // ---- ASSERT-INDEP-1 : hash-disjoint from every file of the audited lane(s)
  let total_col:i32=0;
  let total_missing:i32=0;
  let total_files:i32=0;
  let man:i32=0;
  while(man<2){
    let mp:[]u8=m1;
    if(man==1){ mp=m2; }
    if(mp[0]==45){ man=man+1; }
    else {
      let ml:[]u8=_zag_read_file(mp);
      let mnl:i32=ml.len;
      let ls:i32=0;
      let collide:i32=0;
      let nfile:i32=0;
      let missing:i32=0;
      while(ls<=mnl){
        let le:i32=ls; let g:i32=1;
        while(g==1){ if(le>=mnl){ g=0; } else { if((ml[le] as i32)==10){ g=0; } else { le=le+1; } } }
        if(le>ls){
          let rel:[]u8=ml[ls..le];
          if(_zag_file_exists(rel)==1){
          let fv:[]u8=_zag_read_file(rel);
          let fn2:i32=fv.len;
          let FD:[]u8=g1_alloc(32);
          ns_sha256(fv,FD);
          nfile=nfile+1;
          let same:i32=1;
          let w:i32=0;
          while(w<32){ if(D[w]!=FD[w]){ same=0; } w=w+1; }
          if(same==1){
            collide=collide+1;
            if(collide<=4){ c=g1_app(B,c,"INDEP1_COLLISION "); c=g1_app(B,c,rel); c=g1_nl(B,c); }
          }
          } else {
            missing=missing+1;
            if(missing<=4){ c=g1_app(B,c,"INDEP1_MISSING_FILE "); c=g1_app(B,c,rel); c=g1_nl(B,c); }
          }
        }
        ls=le+1;
      }
      c=g1_app(B,c,"MANIFEST_FILES_HASHED "); c=g1_i64(B,c,nfile as i64);
      c=g1_app(B,c," MANIFEST_COLLISIONS "); c=g1_i64(B,c,collide as i64);
      c=g1_app(B,c," MANIFEST_MISSING "); c=g1_i64(B,c,missing as i64); c=g1_nl(B,c);
      total_col=total_col+collide;
      total_missing=total_missing+missing;
      total_files=total_files+nfile;
      man=man+1;
    }
  }
  c=g1_app(B,c,"LANE_FILES_HASHED "); c=g1_i64(B,c,total_files as i64); c=g1_nl(B,c);
  if((total_col==0)&&(total_missing==0)){ c=g1_app(B,c,"ASSERT-INDEP-1 PASS collisions=0 missing=0\n"); }
  else { c=g1_app(B,c,"ASSERT-INDEP-1 FAIL collisions="); c=g1_i64(B,c,total_col as i64); c=g1_app(B,c," missing="); c=g1_i64(B,c,total_missing as i64); c=g1_nl(B,c); }

  // ---- ASSERT-INDEP-3
  if(lanename[0]==45){ c=g1_app(B,c,"ASSERT-INDEP-3a SKIP no_lanename_given\n"); }
  else {
    let lanehit:i32=g1_find(pv,pn,lanename,0);
    if(lanehit<0){ c=g1_app(B,c,"ASSERT-INDEP-3a PASS lane_dir_absent "); }
    else { c=g1_app(B,c,"ASSERT-INDEP-3a FAIL lane_dir_at_byte "); c=g1_i64(B,c,lanehit as i64); c=g1_app(B,c," "); }
    c=g1_app(B,c,lanename); c=g1_nl(B,c);
  }
  let stop:[]u8="main z_alloc o_i64 o_i32 o_app o_nl o_sp o_flush g1_i64 g1_app g1_nl g1_sp g1_hexw g1_get32 g1_set32 g2_i64 g2_app nio_alloc nio_free ns_sha256 ns_hex g2_alloc pr i32 i64 void ";
  let stopn:i32=stop.len;
  let nhit:i32=0;
  let nm2:i32=0;
  while(nm2<=sn){
    if(g1_mat(sv,sn,nm2,"fn ")==1){
      let st:i32=nm2+3;
      let e:i32=st; let g:i32=1;
      while(g==1){ if(e>=sn){ g=0; } else { if(g1_isalp(sv[e] as i32)==1){ e=e+1; } else { g=0; } } }
      let len:i32=e-st;
      if(len>=4){
        let name:[]u8=sv[st..e];
        let isstop:i32=g1_find(stop,stopn,name,0);
        let hit:i32=g1_find(pv,pn,name,0);
        if((isstop<0)&&(hit>=0)){
          nhit=nhit+1;
          if(nhit<=6){ c=g1_app(B,c,"INDEP3_SRC_FN_HIT "); c=g1_app(B,c,name); c=g1_app(B,c,"\n"); }
        }
      }
      nm2=e;
    } else { nm2=nm2+1; }
  }
  if(nhit==0){ c=g1_app(B,c,"ASSERT-INDEP-3b PASS src_fn_names_absent\n"); }
  else { c=g1_app(B,c,"ASSERT-INDEP-3b FAIL hits "); c=g1_i64(B,c,nhit as i64); c=g1_app(B,c,"\n"); }

  // ---- G1.0 / G1.1 scans over SRC only
  let KO:[]u8=g1_alloc(8);
  g1_keyscan(sv,sn,KO);
  let BT:[]u8=g1_alloc(8192*4);
  let bn:i32=g1_menu(sv,sn,BT);
  c=g1_app(B,c,"NKEY_SRC "); c=g1_i64(B,c,g1_get32(KO,0) as i64);
  c=g1_app(B,c," NPROBE_SRC "); c=g1_i64(B,c,g1_get32(KO,4) as i64);
  c=g1_app(B,c," NMENU_SRC "); c=g1_i64(B,c,bn as i64);
  c=g1_app(B,c," SRC_BYTES "); c=g1_i64(B,c,sn as i64); c=g1_nl(B,c);
  c=g1_app(B,c,"RAW_SYSCALL_IN_PROVER "); c=g1_i64(B,c,g1_count(pv,pn,"_zag_raw_syscall") as i64); c=g1_nl(B,c);
  c=g1_app(B,c,"G1_END\n");
  _zag_print(B[0..c]);
  return 0;
}
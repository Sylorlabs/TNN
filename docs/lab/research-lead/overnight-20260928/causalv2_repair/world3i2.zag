// world3i2.zag — ENVIRONMENT for H-CAUSALV2 genuine-threshold world.
// Implements the TRUE dynamics (may contain the tested regularity).
// depressurize blocked iff temp>=2 (hot only; warm works).
// This is the R2 repair world: the threshold boundary at temp>=2 is
// placed so that at the first contradiction the split search sees
// three distinct s0 values, letting THR (2 cells) genuinely beat
// EQ (3 cells) on the fewest-cells preference. No tie.
// Prints the frozen obs3i2 T-lines to stdout.
// Pure Zag.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn main()i32 {
  // script: (t,p,l,a) x 8
  let sc:[]u8=z_alloc(32);
  sc[0]=0; sc[1]=0; sc[2]=0; sc[3]=0;
  sc[4]=1; sc[5]=0; sc[6]=0; sc[7]=0;
  sc[8]=0; sc[9]=1; sc[10]=0; sc[11]=3;
  sc[12]=1; sc[13]=1; sc[14]=0; sc[15]=3;
  sc[16]=2; sc[17]=1; sc[18]=0; sc[19]=3;
  sc[20]=0; sc[21]=1; sc[22]=1; sc[23]=3;
  sc[24]=2; sc[25]=1; sc[26]=1; sc[27]=3;
  sc[28]=1; sc[29]=1; sc[30]=0; sc[31]=3;
  let k:i32=0;
  while(k<8){
    let t:i32=sc[k*4] as i32;
    let p:i32=sc[k*4+1] as i32;
    let l:i32=sc[k*4+2] as i32;
    let a:i32=sc[k*4+3] as i32;
    let nt:i32=t; let np:i32=p; let nl:i32=l;
    if(a==0){ if(nt<2){nt=nt+1;} }
    else if(a==1){ if(nt>0){nt=nt-1;} }
    else if(a==2){ np=1; }
    else if(a==3){
      // threshold block: no change when temp>=2 (hot only)
      if(t<2){ np=0; }
    }
    emit("T "); e64(t); emit(" "); e64(p); emit(" "); e64(l);
    emit(" | "); e64(a); emit(" | ");
    e64(nt); emit(" "); e64(np); emit(" "); e64(nl); emit("\n");
    k=k+1;
  }
  return 0;
}

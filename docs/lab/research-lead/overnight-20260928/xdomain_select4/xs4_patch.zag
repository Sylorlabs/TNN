// xs4_patch.zag -- XP-SELECT-4: constraint-strictness selector.
//
// Mismatch family: CONSTRAINT STRICTNESS, on the grammar to program
// pair. X is a learned grammar well-formedness constraint (MAP_X,
// relseq [71]x4: a block is well-formed iff it nests exactly 4
// delimiter levels). Y is a learned program-construction procedure
// (MAP_Y, relseq [72]x2). In the Z world the required constraint
// strictness differs from X's learned interface: too strict in A1
// (depth 3 needed) and missing a dimension in A2 (depth 4 plus a
// terminator check, relation 73, which X never learned). Every exact
// mechanism fails for a structural reason (see the frozen prereg K5
// rationale; validated pre-freeze).
//
// XS4-SELECT fires once per query, only after activate, rebind_try
// and compose_try have all failed. For each live native MAP m, in
// frozen priority order, it proposes:
//   TRUNCATE: longest frontier-licensed proper prefix of m's relseq
//     (the "learned constraint is too strict" hypothesis).
//   EXTEND: m's full relseq plus exactly one real frontier fact read
//     from the fact store (the "learned constraint is missing a
//     dimension" hypothesis; the relation is store-read, never
//     hardcoded, and may differ from the walked relation).
// A candidate is licensed only if (a) no live MAP already carries
// its relseq, (b) the candidate walks forward from the query start
// on real facts, (c) a native MAP m2 != m strictly satisfies its own
// relseq forward from the candidate endpoint (cc_satisfy, no
// contract fallback; expected-free), and (d) the assembled chain
// execution-verifies. Licensed candidates are promoted as adapted
// MAPs (no fact taught, type-16 LINK adapted-from source).
//
// Phase 2 re-runs the UNCHANGED compose_try once (the adapted
// segments are forward traversable). The verifier checks expected,
// so a licensed-but-wrong adaptation cannot produce a false
// positive, and ambiguity is resolved deterministically by the
// unchanged candidate ordering.
//
// The selector names no relation, no MAP, no length, no query, and
// no constraint dimension. Zero new edge types (14 provenance, 15
// co-use, 16 adapted-from), zero new opcodes, zero modes, zero
// bridges, zero handlers, zero semantic cases.

// 1 = adaptation bracket enabled; 0 = exact-reuse-only control.
// The no-adapt build differs from this file by exactly this line.
fn adapt_on()i32 { return 1; }

// 1 iff MAP m has no outgoing type-16 edge (native, not adapted).
fn xs4_is_native(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==16){ return 0; }
    e=e+1;
  }
  return 1;
}

// Walk seq[0..L-1] forward from cur via t2_lu_first.
// Fills vals[0..L], fids[0..L-1]. Returns endpoint, or -1.
fn xs4_walk_seq(W:[]u8,seq:[]u8,L:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  set32(vals,0,cur);
  let i:i32=0;
  while(i<L){
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),get32(seq,i*4));
    if(fnd<0){ return -1; }
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return get32(vals,L*4);
}

// 1 iff no live MAP carries exactly seq[0..L-1].
fn xs4_relseq_absent(W:[]u8,seq:[]u8,L:i32)i32 {
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ ismap=1; }
    if(ismap==1){
      let sq:[]u8=z_alloc(28);
      let lm:i32=cc_relseq(W,m,sq,7);
      if(lm==L){
        let ok:i32=1;
        let j:i32=0;
        while(j<L){
          if(get32(sq,j*4)!=get32(seq,j*4)){ ok=0; }
          j=j+1;
        }
        if(ok==1){ return 0; }
      }
    }
    m=m+1;
  }
  return 1;
}

// 1 iff some native MAP m2 (tag 20, live, no outgoing type-16,
// m2 != m) strictly satisfies its relseq forward from e.
// Expected-free: the Phase 2 verifier checks expected.
fn xs4_licensed(W:[]u8,e:i32,m:i32)i32 {
  let m2:i32=2;
  while(m2<1024){
    let go:i32=0;
    if(ng(W,m2,36)==1 && ng(W,m2,0)==20 && m2!=m && xs4_is_native(W,m2)==1){ go=1; }
    if(go==1){
      let vb:[]u8=z_alloc(32);
      let fb:[]u8=z_alloc(28);
      if(cc_satisfy(W,m2,e,vb,fb)>=1){ return 1; }
    }
    m2=m2+1;
  }
  return 0;
}

// Promote an adapted MAP: identical MAP node/edge layout to
// promote_graph, but teaches NO fact. Mid-query scaffolding is not
// a verified query answer.
fn xs4_promote(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){ return -1; }
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s); ns(W,m,12,-1); ns(W,m,16,-1);
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){ link_edge(W,m,1,get32(facts,i*4),0); i=i+1; }
  return m;
}

// Lowest-id live non-superseded fact with subject=s, excluding
// fids[0..nf-1]; else -1. The extension relation is read live.
fn xs4_frontier_fact(W:[]u8,s:i32,fids:[]u8,nf:i32)i32 {
  let f:i32=2;
  while(f<1024){
    let mt:i32=0;
    if(ng(W,f,36)==1 && ng(W,f,0)==1 && ng(W,f,20)==s){ mt=1; }
    if(mt==1){
      if(is_superseded(W,f)==0){
        let used:i32=0;
        let k:i32=0;
        while(k<nf){
          if(get32(fids,k*4)==f){ used=1; }
          k=k+1;
        }
        if(used==0){ return f; }
      }
    }
    f=f+1;
  }
  return -1;
}

// TRUNCATE branch: longest frontier-licensed proper prefix of m's
// relseq. Returns adapted MAP id, or -1. At most one per m.
fn xs4_try_truncate(W:[]u8,m:i32,s:i32,masked:i32)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m,seq,7);
  let oklen:i32=0;
  if(L>=2){ if(L<7){ oklen=1; } }
  if(oklen==0){ return -1; }
  let lp:i32=L-1;
  while(lp>=1){
    let psq:[]u8=z_alloc(28);
    let j:i32=0;
    while(j<lp){ set32(psq,j*4,get32(seq,j*4)); j=j+1; }
    let skip:i32=0;
    if(xs4_relseq_absent(W,psq,lp)==0){ skip=1; }
    if(skip==0){
      emit("XS4-TRY op=TRUNCATE m="); e64(m);
      emit(" lp="); e64(lp); emit(" s="); e64(s); emit("\n");
      let vals:[]u8=z_alloc(32);
      let fids:[]u8=z_alloc(28);
      let e:i32=xs4_walk_seq(W,psq,lp,s,vals,fids);
      if(e>=0 && xs4_licensed(W,e,m)==1){
        let root:i32=t2_asm_chain(W,vals,lp+1,fids);
        if(root>=0){
          let st:[]u8=z_alloc(8);
          set32(st,0,0); set32(st,4,0);
          if(t2_try_verify(W,root,s,e,masked,st)!=-2){
            let am:i32=xs4_promote(W,root,s,ng(W,m,4),e,fids,lp);
            if(am>=0){
              link_edge(W,am,16,m,0);
              emit("ADAPT-MK id="); e64(am);
              emit(" src="); e64(m);
              emit(" op=TRUNCATE\n");
              return am;
            }
          }
        }
      }
    }
    lp=lp-1;
  }
  return -1;
}

// EXTEND branch: full relseq plus one real frontier fact.
// Returns adapted MAP id, or -1. At most one per m.
fn xs4_try_extend(W:[]u8,m:i32,s:i32,masked:i32)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m,seq,7);
  let oklen:i32=0;
  if(L>=2){ if(L<7){ oklen=1; } }
  if(oklen==0){ return -1; }
  emit("XS4-TRY op=EXTEND m="); e64(m);
  emit(" s="); e64(s); emit("\n");
  let vals:[]u8=z_alloc(32);
  let fids:[]u8=z_alloc(28);
  let eL:i32=xs4_walk_seq(W,seq,L,s,vals,fids);
  if(eL<0){ return -1; }
  let ff:i32=xs4_frontier_fact(W,eL,fids,L);
  if(ff<0){ return -1; }
  let rnew:i32=ng(W,ff,24);
  let e2:i32=ng(W,ff,28);
  let esq:[]u8=z_alloc(32);
  let j:i32=0;
  while(j<L){ set32(esq,j*4,get32(seq,j*4)); j=j+1; }
  set32(esq,L*4,rnew);
  if(xs4_relseq_absent(W,esq,L+1)==0){ return -1; }
  if(xs4_licensed(W,e2,m)==0){
    emit("XS4-NOLIC m="); e64(m); emit("\n");
    return -1;
  }
  let nvals:[]u8=z_alloc(36);
  let nfids:[]u8=z_alloc(32);
  j=0;
  while(j<=L){ set32(nvals,j*4,get32(vals,j*4)); j=j+1; }
  set32(nvals,(L+1)*4,e2);
  j=0;
  while(j<L){ set32(nfids,j*4,get32(fids,j*4)); j=j+1; }
  set32(nfids,L*4,ff);
  let root:i32=t2_asm_chain(W,nvals,L+2,nfids);
  if(root<0){ return -1; }
  let st:[]u8=z_alloc(8);
  set32(st,0,0); set32(st,4,0);
  if(t2_try_verify(W,root,s,e2,masked,st)==-2){ return -1; }
  let am:i32=xs4_promote(W,root,s,ng(W,m,4),e2,nfids,L+1);
  if(am<0){ return -1; }
  link_edge(W,am,16,m,0);
  emit("ADAPT-MK id="); e64(am);
  emit(" src="); e64(m);
  emit(" op=EXTEND\n");
  return am;
}

// XS4-SELECT Phase 1: propose strictness adaptations per native MAP.
// Frozen priority: TRUNCATE before EXTEND per m; both may fire.
// Returns adapted MAPs promoted.
fn xs4_select(W:[]u8,s:i32,masked:i32)i32 {
  let nmk:i32=0;
  let m:i32=2;
  while(m<1024){
    let go:i32=0;
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xs4_is_native(W,m)==1){ go=1; }
    if(go==1){
      emit("XS4-FRONTIER m="); e64(m); emit("\n");
      if(xs4_try_truncate(W,m,s,masked)>=0){ nmk=nmk+1; }
      if(xs4_try_extend(W,m,s,masked)>=0){ nmk=nmk+1; }
    }
    m=m+1;
  }
  return nmk;
}

// ev_query with the XS4-SELECT bracket: the unified pipeline
// verbatim, plus strictness adaptation between the failed compose_try
// and the trial fallback. Phase 2 is the unchanged compose_try
// re-run (the adapted segments are forward traversable).
fn ev_query_adapt(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
    if(adapt_on()==1){
      emit("ADAPT-TRY\n");
      let nmk:i32=xs4_select(W,s,masked);
      emit("ADAPT-CREATED n="); e64(nmk); emit("\n");
      if(nmk>=1){
        let ca2:i32=compose_try(W,s,r,expected,masked,rbs);
        emit("COMP2-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
        if(ca2!=-2){
          hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
          log_ev(W,2,s,r,ca2,1,0,0); return ca2;
        }
      }
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

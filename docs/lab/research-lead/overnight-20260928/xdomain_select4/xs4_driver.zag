// xs4_driver.zag -- XP-SELECT-4 battery (arms A1-A4, A6-A10).
//
// X (grammar well-formedness constraint, relseq [71]x4) and Y
// (program construction, relseq [72]x2) are learned independently.
// Z worlds carry a CONSTRAINT-STRICTNESS mismatch on X: too strict
// in A1 (depth 3 needed, X demands 4), missing a dimension in A2
// (depth 4 plus terminator relation 73, which X never learned).
// The exact pipeline provably fails the mismatch arms (A5 no-adapt
// control). XS4-SELECT must select TRUNCATE or EXTEND per world by
// evidence; the unchanged verifier resolves ambiguity (A10).
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn xs4_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xs4_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn xs4_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// all live adapted MAP ids into out (maxn slots); returns count.
fn xs4_adapted_ids(W:[]u8,out:[]u8,maxn:i32)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024 && n<maxn){
    let ismap:i32=0;
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ ismap=1; }
    if(ismap==1){
      let e:i32=0;
      let hit:i32=0;
      while(e<4096){
        if(eg(W,e,0)==m && eg(W,e,4)==16){hit=1;}
        e=e+1;
      }
      if(hit==1){ set32(out,n*4,m); n=n+1; }
    }
    m=m+1;
  }
  return n;
}
// source MAP of adapted MAP a (type-16 target), or -1.
fn xs4_adapt_src(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){return eg(W,e,8);}
    e=e+1;
  }
  return -1;
}
// count of type-16 edges workspace-wide (from != -1).
fn xs4_count_adapt(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
// 1 iff MAP m relseq equals exp[0..n-1].
fn xs4_relseq_eq(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  let sq:[]u8=z_alloc(28);
  let lm:i32=cc_relseq(W,m,sq,7);
  if(lm!=n){return 0;}
  let j:i32=0;
  while(j<n){
    if(get32(sq,j*4)!=get32(exp,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// 1 iff relseq(ms) is a strict prefix of relseq(ml).
fn xs4_strict_prefix(W:[]u8,ms:i32,ml:i32)i32 {
  let ss:[]u8=z_alloc(28);
  let sl:[]u8=z_alloc(28);
  let ls:i32=cc_relseq(W,ms,ss,7);
  let ll:i32=cc_relseq(W,ml,sl,7);
  if(ls<1){return 0;}
  if(ll<1){return 0;}
  if(ls>=ll){return 0;}
  let j:i32=0;
  while(j<ls){
    if(get32(ss,j*4)!=get32(sl,j*4)){return 0;}
    j=j+1;
  }
  return 1;
}
// Licensing fact ids of MAP m's chain graph, in order, into out.
// Returns count, or -1 if the graph is not a pure chain.
fn xs4_map_fids(W:[]u8,m:i32,out:[]u8)i32 {
  let cur:i32=ng(W,m,20);
  let n:i32=0;
  let steps:i32=0;
  let bad:i32=0;
  while(cur>=0 && steps<64 && bad==0){
    let tag:i32=ng(W,cur,0);
    if(tag==102){
      cur=ng(W,cur,12);
    } else {
      if(tag==101){
        let fnd:i32=-1;
        let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)==cur && eg(W,e,4)==1){ fnd=eg(W,e,8); }
          e=e+1;
        }
        if(fnd<0){ bad=1; } else { set32(out,n*4,fnd); n=n+1; }
        cur=seq_nx(W,cur);
      } else {
        bad=1;
      }
    }
    steps=steps+1;
  }
  if(bad==1){ return -1; }
  return n;
}
// 1 iff MAP a's licensing fact ids are disjoint from xf[0..nxf-1].
fn xs4_fids_disjoint(W:[]u8,a:i32,xf:[]u8,nxf:i32)i32 {
  let af:[]u8=z_alloc(28);
  let naf:i32=xs4_map_fids(W,a,af);
  if(naf<1){return 0;}
  let i:i32=0;
  while(i<naf){
    let k:i32=0;
    while(k<nxf){
      if(get32(af,i*4)==get32(xf,k*4)){return 0;}
      k=k+1;
    }
    i=i+1;
  }
  return 1;
}
// Train X (grammar constraint, relseq [71]x4) and Y (program
// construction, relseq [72]x2). out[0]=mapx, out[1]=mapy. xf gets
// MAP_X training fids.
fn xs4_train_xy(W:[]u8,out:[]u8,xf:[]u8)i32 {
  ev_teach(W,201,71,211); ev_teach(W,211,71,221);
  ev_teach(W,221,71,231); ev_teach(W,231,71,241);
  let x:i32=ev_query_adapt(W,201,93,241,0);
  emit("XS4-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,241,72,251); ev_teach(W,251,72,261);
  let y:i32=ev_query_adapt(W,241,94,261,0);
  emit("XS4-Y ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  let nxf:i32=xs4_map_fids(W,get32(out,0),xf);
  emit("XS4-X fids="); e64(nxf); emit("\n");
  return nxf;
}

// ---- Z fact sets (frozen battery) ----
fn xs4_zfacts_a1(W:[]u8)void {
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,72,105); ev_teach(W,105,72,106);
  return;
}
fn xs4_zfacts_a2(W:[]u8)void {
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,71,105); ev_teach(W,105,73,106);
  ev_teach(W,106,72,107); ev_teach(W,107,72,108);
  return;
}
fn xs4_zfacts_a3(W:[]u8)void {
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,83,105); ev_teach(W,105,83,106);
  return;
}
fn xs4_zfacts_a4(W:[]u8)void {
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,71,105);
  ev_teach(W,105,72,106); ev_teach(W,106,72,107);
  return;
}
fn xs4_zfacts_a10(W:[]u8)void {
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,72,105); ev_teach(W,105,72,106);
  ev_teach(W,104,71,107); ev_teach(W,107,73,108);
  ev_teach(W,108,72,109); ev_teach(W,109,72,110);
  return;
}

// ---- A1: SELECT-TRUNCATE (too strict) ----
fn a1_select_truncate(W:[]u8)void {
  emit("=== A1-SELECT-TRUNCATE ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  let nxf:i32=xs4_train_xy(W,out,xf);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xs4_gap(W);
  xs4_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A1-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ids:[]u8=z_alloc(16);
  let na:i32=xs4_adapted_ids(W,ids,4);
  let a:i32=-1;
  if(na>=1){ a=get32(ids,0); }
  let asrc:i32=xs4_adapt_src(W,a);
  let ex:[]u8=z_alloc(12);
  set32(ex,0,71); set32(ex,4,71); set32(ex,8,71);
  let p1:i32=0; if(z==106){p1=1;}
  let p2:i32=0; if(na==1){p2=1;}
  let p3:i32=0; if(a>=0 && asrc==mapx){p3=1;}
  let p4:i32=0; if(a>=0){p4=xs4_relseq_eq(W,a,ex,3);}
  let p5:i32=0; if(a>=0 && ng(W,a,8)==101){p5=1;}
  let p6:i32=0; if(a>=0 && ng(W,a,28)==104){p6=1;}
  let p7:i32=xs4_has14(W,mapz,a);
  let p8:i32=xs4_has14(W,mapz,mapy);
  let p9:i32=0; if(xs4_has14(W,mapz,mapx)==0){p9=1;}
  let p10:i32=0; if(a>=0){p10=xs4_strict_prefix(W,a,mapx);}
  let p11:i32=0; if(a>=0){p11=xs4_fids_disjoint(W,a,xf,nxf);}
  let p12:i32=0; if(xs4_count_adapt(W)==1){p12=1;}
  emit("A1 p1(ans106)="); e64(p1);
  emit(" p2(one-adapted)="); e64(p2);
  emit(" p3(adapted-from-X)="); e64(p3);
  emit(" p4(seq71x3)="); e64(p4);
  emit(" p5(start101)="); e64(p5);
  emit(" p6(end104)="); e64(p6);
  emit(" p7(z14adapted)="); e64(p7);
  emit(" p8(z14Y)="); e64(p8);
  emit(" p9(no-z14X)="); e64(p9);
  emit(" p10(strict-prefix)="); e64(p10);
  emit(" p11(fids-disjoint)="); e64(p11);
  emit(" p12(one-edge)="); e64(p12); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1 && p9==1 && p10==1 && p11==1 && p12==1){
    emit("A1-SELECT-TRUNCATE=PASS\n");
  } else {
    emit("A1-SELECT-TRUNCATE=FAIL\n");
  }
  return;
}

// ---- A2: SELECT-EXTEND (missing dimension) ----
fn a2_select_extend(W:[]u8)void {
  emit("=== A2-SELECT-EXTEND ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  let nxf:i32=xs4_train_xy(W,out,xf);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xs4_gap(W);
  xs4_zfacts_a2(W);
  let z:i32=ev_query_adapt(W,101,70,108,0);
  emit("A2-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ids:[]u8=z_alloc(16);
  let na:i32=xs4_adapted_ids(W,ids,4);
  let a:i32=-1;
  if(na>=1){ a=get32(ids,0); }
  let asrc:i32=xs4_adapt_src(W,a);
  let ex:[]u8=z_alloc(20);
  set32(ex,0,71); set32(ex,4,71); set32(ex,8,71); set32(ex,12,71); set32(ex,16,73);
  let p1:i32=0; if(z==108){p1=1;}
  let p2:i32=0; if(na==1){p2=1;}
  let p3:i32=0; if(a>=0 && asrc==mapx){p3=1;}
  let p4:i32=0; if(a>=0){p4=xs4_relseq_eq(W,a,ex,5);}
  let p5:i32=0; if(a>=0 && ng(W,a,8)==101){p5=1;}
  let p6:i32=0; if(a>=0 && ng(W,a,28)==106){p6=1;}
  let p7:i32=xs4_has14(W,mapz,a);
  let p8:i32=xs4_has14(W,mapz,mapy);
  let p9:i32=0; if(xs4_has14(W,mapz,mapx)==0){p9=1;}
  let p10:i32=0; if(a>=0){p10=xs4_strict_prefix(W,mapx,a);}
  let p11:i32=0; if(a>=0){p11=xs4_fids_disjoint(W,a,xf,nxf);}
  let p12:i32=0; if(xs4_count_adapt(W)==1){p12=1;}
  emit("A2 p1(ans108)="); e64(p1);
  emit(" p2(one-adapted)="); e64(p2);
  emit(" p3(adapted-from-X)="); e64(p3);
  emit(" p4(seq71x4-73)="); e64(p4);
  emit(" p5(start101)="); e64(p5);
  emit(" p6(end106)="); e64(p6);
  emit(" p7(z14adapted)="); e64(p7);
  emit(" p8(z14Y)="); e64(p8);
  emit(" p9(no-z14X)="); e64(p9);
  emit(" p10(src-strict-prefix)="); e64(p10);
  emit(" p11(fids-disjoint)="); e64(p11);
  emit(" p12(one-edge)="); e64(p12); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1 && p9==1 && p10==1 && p11==1 && p12==1){
    emit("A2-SELECT-EXTEND=PASS\n");
  } else {
    emit("A2-SELECT-EXTEND=FAIL\n");
  }
  return;
}

// ---- A3: REJECT ----
fn a3_reject(W:[]u8)void {
  emit("=== A3-REJECT ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  xs4_train_xy(W,out,xf);
  xs4_gap(W);
  xs4_zfacts_a3(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A3-ANS="); e64(z); emit("\n");
  let na:i32=xs4_count_adapt(W);
  emit("A3 adapted-edges="); e64(na); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  if(p1==1 && p2==1){emit("A3-REJECT=PASS\n");}
  else {emit("A3-REJECT=FAIL\n");}
  return;
}

// ---- A4: L1-REGRESSION ----
fn a4_l1_regression(W:[]u8)void {
  emit("=== A4-L1-REGRESSION ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  xs4_train_xy(W,out,xf);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xs4_gap(W);
  xs4_zfacts_a4(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A4-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let na:i32=xs4_count_adapt(W);
  let p1:i32=0; if(z==107){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  let p3:i32=xs4_has14(W,mapz,mapx);
  let p4:i32=xs4_has14(W,mapz,mapy);
  emit("A4 p1(ans107)="); e64(p1);
  emit(" p2(zero-adapted)="); e64(p2);
  emit(" p3(z14X)="); e64(p3);
  emit(" p4(z14Y)="); e64(p4); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1){
    emit("A4-L1-REGRESSION=PASS\n");
  } else {
    emit("A4-L1-REGRESSION=FAIL\n");
  }
  return;
}

// ---- A6: ABL-X ----
fn a6_abl_x(W:[]u8)void {
  emit("=== A6-ABL-X ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  xs4_train_xy(W,out,xf);
  xs4_kill(W,get32(out,0));
  emit("A6 killed mapx\n");
  xs4_gap(W);
  xs4_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A6-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A6-ABL-X=PASS\n");} else {emit("A6-ABL-X=FAIL\n");}
  return;
}

// ---- A7: ABL-Y ----
fn a7_abl_y(W:[]u8)void {
  emit("=== A7-ABL-Y ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  xs4_train_xy(W,out,xf);
  xs4_kill(W,get32(out,4));
  emit("A7 killed mapy\n");
  xs4_gap(W);
  xs4_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A7-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A7-ABL-Y=PASS\n");} else {emit("A7-ABL-Y=FAIL\n");}
  return;
}

// ---- A8: FRESH ----
fn a8_fresh(W:[]u8)void {
  emit("=== A8-FRESH ===\n");
  xs4_gap(W);
  xs4_zfacts_a1(W);
  let z:i32=ev_query_adapt(W,101,70,107,0);
  emit("A8-ANS="); e64(z); emit("\n");
  if(z==-2){emit("A8-FRESH=PASS\n");} else {emit("A8-FRESH=FAIL\n");}
  return;
}

// ---- A9: REUSE ----
fn a9_reuse(W:[]u8)void {
  emit("=== A9-REUSE ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  xs4_train_xy(W,out,xf);
  xs4_gap(W);
  xs4_zfacts_a1(W);
  let z1:i32=ev_query_adapt(W,101,70,106,0);
  emit("A9 first="); e64(z1); emit("\n");
  let ids:[]u8=z_alloc(16);
  let na1:i32=xs4_adapted_ids(W,ids,4);
  let z2:i32=ev_query_adapt(W,101,70,106,0);
  emit("A9 second="); e64(z2); emit("\n");
  let na2:i32=xs4_adapted_ids(W,ids,4);
  emit("A9 adapted-after-first="); e64(na1);
  emit(" adapted-after-second="); e64(na2); emit("\n");
  let p1:i32=0; if(z1==106 && z2==106){p1=1;}
  let p2:i32=0; if(na1==1 && na2==1){p2=1;}
  if(p1==1 && p2==1){emit("A9-REUSE=PASS\n");}
  else {emit("A9-REUSE=FAIL\n");}
  return;
}

// ---- A10: AMBIGUOUS-SELECT ----
fn a10_ambiguous_select(W:[]u8)void {
  emit("=== A10-AMBIGUOUS-SELECT ===\n");
  let out:[]u8=z_alloc(12);
  let xf:[]u8=z_alloc(28);
  let nxf:i32=xs4_train_xy(W,out,xf);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  xs4_gap(W);
  xs4_zfacts_a10(W);
  let z:i32=ev_query_adapt(W,101,70,110,0);
  emit("A10-ANS="); e64(z); emit("\n");
  let mapz:i32=cb_newest_map(W);
  let ids:[]u8=z_alloc(16);
  let na:i32=xs4_adapted_ids(W,ids,4);
  let t:i32=-1;
  let p:i32=-1;
  let k:i32=0;
  while(k<na){
    let a:i32=get32(ids,k*4);
    if(ng(W,a,28)==104){t=a;}
    if(ng(W,a,28)==108){p=a;}
    k=k+1;
  }
  let p1:i32=0; if(z==110){p1=1;}
  let p2:i32=0; if(na==2){p2=1;}
  let p3:i32=0;
  if(t>=0 && p>=0 && t!=p){
    if(xs4_adapt_src(W,t)==mapx && xs4_adapt_src(W,p)==mapx){p3=1;}
  }
  let p4:i32=0; if(p>=0){p4=xs4_has14(W,mapz,p);}
  let p5:i32=xs4_has14(W,mapz,mapy);
  let p6:i32=0; if(t>=0){ if(xs4_has14(W,mapz,t)==0){p6=1;} }
  let p7:i32=0; if(xs4_has14(W,mapz,mapx)==0){p7=1;}
  let p8:i32=0; if(xs4_count_adapt(W)==2){p8=1;}
  let p9:i32=0;
  if(t>=0 && p>=0){p9=xs4_strict_prefix(W,t,mapx);}
  let p10:i32=0;
  if(t>=0 && p>=0){p10=xs4_strict_prefix(W,mapx,p);}
  let p11:i32=0;
  if(t>=0 && p>=0){
    if(xs4_fids_disjoint(W,t,xf,nxf)==1 && xs4_fids_disjoint(W,p,xf,nxf)==1){p11=1;}
  }
  emit("A10 p1(ans110)="); e64(p1);
  emit(" p2(two-adapted)="); e64(p2);
  emit(" p3(both-from-X)="); e64(p3);
  emit(" p4(z14ext)="); e64(p4);
  emit(" p5(z14Y)="); e64(p5);
  emit(" p6(no-z14trunc)="); e64(p6);
  emit(" p7(no-z14X)="); e64(p7);
  emit(" p8(two-edges)="); e64(p8);
  emit(" p9(trunc-strict-prefix)="); e64(p9);
  emit(" p10(src-strict-prefix)="); e64(p10);
  emit(" p11(fids-disjoint)="); e64(p11); emit("\n");
  emit("A10 t="); e64(t); emit(" p="); e64(p);
  emit(" mapz="); e64(mapz); emit("\n");
  if(p1==1 && p2==1 && p3==1 && p4==1 && p5==1 && p6==1 && p7==1 && p8==1 && p9==1 && p10==1 && p11==1){
    emit("A10-AMBIGUOUS-SELECT=PASS\n");
  } else {
    emit("A10-AMBIGUOUS-SELECT=FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("XS4-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); a1_select_truncate(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); a2_select_extend(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); a3_reject(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); a4_l1_regression(W4);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); a6_abl_x(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); a7_abl_y(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); a8_fresh(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); a9_reuse(W9);
  let W10:[]u8=z_alloc(110656); tnn2_init(W10); a10_ambiguous_select(W10);
  emit("XS4-END\n");
  return 0;
}

// xs4_driver_noadapt.zag -- XP-SELECT-4 arm A5 (NO-ADAPT CONTROL).
//
// A1 setup verbatim, run under the one-line no-adapt build
// (adapt_on()=0). Expect: ans=-2 and zero adapted MAPs. This proves
// the selector did the work: the exact pipeline (activate, rebind,
// compose, trial, bootstrap) cannot solve the too-strict
// constraint task.

fn xs4_gap_na(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn xs4_count_adapt_na(W:[]u8)i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==16){c=c+1;}
    e=e+1;
  }
  return c;
}
fn a5_noadapt(W:[]u8)void {
  emit("=== A5-NO-ADAPT ===\n");
  ev_teach(W,201,71,211); ev_teach(W,211,71,221);
  ev_teach(W,221,71,231); ev_teach(W,231,71,241);
  let x:i32=ev_query_adapt(W,201,93,241,0);
  emit("XS4-X ans="); e64(x); emit("\n");
  ev_teach(W,241,72,251); ev_teach(W,251,72,261);
  let y:i32=ev_query_adapt(W,241,94,261,0);
  emit("XS4-Y ans="); e64(y); emit("\n");
  xs4_gap_na(W);
  ev_teach(W,101,71,102); ev_teach(W,102,71,103); ev_teach(W,103,71,104);
  ev_teach(W,104,72,105); ev_teach(W,105,72,106);
  let z:i32=ev_query_adapt(W,101,70,106,0);
  emit("A5-ANS="); e64(z); emit("\n");
  let na:i32=xs4_count_adapt_na(W);
  emit("A5 adapted-edges="); e64(na); emit("\n");
  let p1:i32=0; if(z==-2){p1=1;}
  let p2:i32=0; if(na==0){p2=1;}
  if(p1==1 && p2==1){emit("A5-NO-ADAPT=PASS\n");}
  else {emit("A5-NO-ADAPT=FAIL\n");}
  return;
}
fn main()i32 {
  emit("XS4-NA-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W); a5_noadapt(W);
  emit("XS4-NA-END\n");
  return 0;
}

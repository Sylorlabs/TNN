// gi_patch.zag -- grammar induction (unfrozen).
// Induces EXL BUILD grammar from taught examples. The induced grammar is
// stored in learner state (type-70 node) and guides construction.
// NO hardcoded DADD/DMUL (43/44) in the induction or construction path:
// the licensor relations are discovered by scanning the learner's own
// BUILD facts. Relation ids: ADD=41 MUL=42 DADD=43 DMUL=44 BUILD=45.
// Pair encoding P(a,b) = a*16+b.

// Learner-owned semantic lookup: is (pair, op, t) in TNN's own learned
// state? Read-only scan. The VALUES come from learner state; the lookup
// procedure is driver code.
fn gi_eval_known(W:[]u8,pair:i32,op:i32,t:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==pair && ng(W,n,24)==op && ng(W,n,28)==t){return 1;}
    n=n+1;
  }
  return 0;
}

// Find the induced grammar node (type 70). Returns id or -1.
fn gi_grammar_find(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==70){return n;}
    n=n+1;
  }
  return -1;
}

// gi_codec_check -- fail-closed decode-consistency guard for induction.
// The machinery assumes the pair codec P(a,b) = a*16+b at all decode
// sites. This guard cross-checks that assumption against the observed
// fact structure AFTER part-2 range induction and BEFORE any grammar
// node is written. The check is a semantic round-trip: for every taught
// eval fact (r in {41,42}) the subject is a pair P and the object is the
// taught value t; decode P under the assumed codec to (a,b) and require
// the op the relation names to reproduce t (41: a-b==t; 42: b>0,
// exact, a/b==t). A violation means the codec contradicts the world's
// own taught semantics, so induction refuses instead of writing ranges
// under a contradicted codec.
// The check is general: it names no divisor except the machinery's own
// assumed codec, and the discriminator comes from the fact stream, not
// from a hardcoded list of broken encodings. (A pure pair-set
// round-trip was tried and rejected during implementation: re-encoding
// the induced rectangle and requiring every grid point to be observed
// FALSE-REFUSES the EXL2 control, because real worlds teach only
// constraint-satisfying pairs, e.g. EXL2 never teaches pair (1,2) since
// 1-2<0 and 1/2 is inexact, so grid point 18 is legitimately absent.
// The rectangle is the wrong unit; the op semantics are the load-bearing
// cross-check.)
// Returns 0 when the codec is consistent with the fact structure;
// -3 when an eval fact contradicts the assumed codec. A nonzero return
// refuses induction: gi_induce returns the code WITHOUT writing a
// grammar node.
fn gi_codec_check(W:[]u8,min_a:i32,max_a:i32,min_b:i32,max_b:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1){
      let r:i32=ng(W,n,24);
      if(r==41 || r==42){
        let P:i32=ng(W,n,20); let t:i32=ng(W,n,28);
        let aa:i32=P/16; let bb:i32=P-(aa*16);
        if(r==41){
          if(aa-bb!=t){return -3;}
        } else {
          if(bb<=0){return -3;}
          if(aa-(aa/bb)*bb!=0){return -3;}
          if(aa/bb!=t){return -3;}
        }
      }
    }
    n=n+1;
  }
  return 0;
}

// Induce BUILD grammar from taught examples in learner state.
// Two-part induction:
// (1) FORM from BUILD examples: for each live fact (T,45,P), decode P to
//     (a,b); find licensor facts (T,r2,P) with r2 != 45 (same subject and
//     object, different relation) and collect the distinct r2 values.
//     Discovers which relations license BUILD pairs and that licensors
//     are atomic (single facts, so max_links = 1).
// (2) LITERALS from eval experience: scan eval facts (r=41/42) whose
//     subjects are pair encodings; decode to (a,b) and track the observed
//     ranges. This grounds the literal range in the learner's full eval
//     experience (100 pairs), not overfitted from 8 BUILD examples.
// Writes a type-70 node: field 8 = nlic, 20/24/28/32 = licensor rels,
// 40/44 = min_a/max_a, 48/52 = min_b/max_b, 56 = max_links, 60 = nbuild.
// Returns 1 if a consistent grammar was induced, 0 on legacy refusal,
// -3 if the codec op-consistency check failed. On any non-1 return no
// grammar node is written (fail-closed).
fn gi_induce(W:[]u8)i32 {
  let nbuild:i32=0;
  let lic:[]u8=z_alloc(64); let nlic:i32=0;
  let ok:i32=1;
  let n:i32=2;
  while(n<1024 && ok==1){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==45){
      let T:i32=ng(W,n,20); let P:i32=ng(W,n,28);
      let a:i32=P/16; let b:i32=P-(a*16);
      if(a<0 || a>15 || b<0 || b>15 || a*16+b!=P){ok=0;}
      else {
        nbuild=nbuild+1;
        let m:i32=2; let found:i32=0;
        while(m<1024){
          if(m!=n && ng(W,m,36)==1 && ng(W,m,0)==1 && ng(W,m,20)==T && ng(W,m,28)==P && ng(W,m,24)!=45){
            let r2:i32=ng(W,m,24);
            let k:i32=0; let seen:i32=0;
            while(k<nlic){if(get32(lic,k*4)==r2){seen=1;} k=k+1;}
            if(seen==0 && nlic<16){set32(lic,nlic*4,r2); nlic=nlic+1;}
            found=1;
          }
          m=m+1;
        }
        if(found==0){ok=0;}
      }
    }
    n=n+1;
  }
  if(ok==0 || nbuild==0 || nlic==0){return 0;}
  if(nlic>2){return 0;}
  // Part 2: literal ranges from ALL facts licensed by the induced
  // licensor relations (the full decomp experience, not just the 8 BUILD
  // examples). Decode their pair objects to (a,b) and track ranges.
  // Uses only the induced lic set; no hardcoded relation ids.
  let min_a:i32=999; let max_a:i32=-999;
  let min_b:i32=999; let max_b:i32=-999;
  let e:i32=2;
  while(e<1024){
    if(ng(W,e,36)==1 && ng(W,e,0)==1){
      let er:i32=ng(W,e,24);
      let k:i32=0; let islic:i32=0;
      while(k<nlic){if(get32(lic,k*4)==er){islic=1;} k=k+1;}
      if(islic==1){
        let P:i32=ng(W,e,28);
        let a:i32=P/16; let b:i32=P-(a*16);
        if(a>=0 && a<=15 && b>=0 && b<=15 && a*16+b==P){
          if(a<min_a){min_a=a;} if(a>max_a){max_a=a;}
          if(b<min_b){min_b=b;} if(b>max_b){max_b=b;}
        }
      }
    }
    e=e+1;
  }
  if(min_a>max_a){return 0;}
  // Fail-closed codec guard: refuse (no grammar written) when the
  // assumed pair codec contradicts the observed fact structure.
  let cc:i32=gi_codec_check(W,min_a,max_a,min_b,max_b);
  if(cc!=0){return cc;}
  let g:i32=alloc_node(W);
  if(g<0){return 0;}
  ns(W,g,0,70);
  ns(W,g,4,nlic);
  if(nlic>0){ns(W,g,8,get32(lic,0));}
  if(nlic>1){ns(W,g,12,get32(lic,4));}
  ns(W,g,16,min_a); ns(W,g,20,max_a);
  ns(W,g,24,min_b); ns(W,g,28,max_b);
  ns(W,g,32,nbuild);
  return 1;
}

// Ablate: kill the induced grammar node (mark not-live).
// Returns 1 if a grammar was found and killed, 0 otherwise.
fn gi_ablate(W:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  ns(W,g,36,0);
  return 1;
}

// Read induced grammar into a buffer.
// buf[0]=nlic, buf[1]=lic0, buf[2]=lic1, buf[3]=min_a, buf[4]=max_a,
// buf[5]=min_b, buf[6]=max_b, buf[7]=nbuild. Returns 1 if found.
// The caller reads once after induction into a stable buffer.
fn gi_grammar_read(W:[]u8,buf:[]u8)i32 {
  let g:i32=gi_grammar_find(W);
  if(g<0){return 0;}
  let nlic:i32=ng(W,g,4);
  set32(buf,0,nlic);
  if(nlic>0){set32(buf,4,ng(W,g,8));} else {set32(buf,4,-1);}
  if(nlic>1){set32(buf,8,ng(W,g,12));} else {set32(buf,8,-1);}
  set32(buf,12,ng(W,g,16));
  set32(buf,16,ng(W,g,20));
  set32(buf,20,ng(W,g,24));
  set32(buf,24,ng(W,g,28));
  set32(buf,28,ng(W,g,32));
  return 1;
}

// Is relation r in the induced licensor set (from buffer)?
fn gi_lic_ok2(buf:[]u8,r:i32)i32 {
  let nlic:i32=get32(buf,0);
  if(nlic>0 && get32(buf,4)==r){return 1;}
  if(nlic>1 && get32(buf,8)==r){return 1;}
  return 0;
}

// Grammar-guided BUILD using the INDUCED grammar (from buffer).
// buf: [0]=nlic, [4]=lic0, [8]=lic1, [12]=min_a, [16]=max_a,
//      [20]=min_b, [24]=max_b, [28]=nbuild.
// Candidates must be atomic single facts (path length 2) whose relation
// is in the induced licensor set. Output must decode within induced
// ranges and verify against TNN's own eval knowledge (either op).
// Promotes on success, returns -2 otherwise.
fn gi_trial_build2(W:[]u8,t:i32,gb:[]u8)i32 {
  let min_a:i32=get32(gb,12); let max_a:i32=get32(gb,16);
  let min_b:i32=get32(gb,20); let max_b:i32=get32(gb,24);
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(gi_lic_ok2(gb,fr)==1){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/16; let b:i32=out-(a*16);
          if(a>=min_a && a<=max_a && b>=min_b && b<=max_b){
            if(gi_eval_known(W,out,41,t)==1 || gi_eval_known(W,out,42,t)==1){
              promote_graph(W,root,t,45,out,ff,1);
              return out;
            }
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Hardcoded comparison arm: the prior treatment's researcher-authored
// grammar restriction (only DADD/DMUL single links), verbatim logic.
// Used to compare induced vs hardcoded performance.
fn gi_hardcode_build(W:[]u8,t:i32)i32 {
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(fr==43 || fr==44){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/16; let b:i32=out-(a*16);
          let op:i32=41; if(fr==44){op=42;}
          if(a>=0 && a<=9 && b>=0 && b<=9 && gi_eval_known(W,out,op,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// Classify the (T,BUILD) construction from the promoted MAP's DEP edges.
// 1 = valid: single DADD/DMUL dep, pair decodes to a,b in 0..9, and TNN's
//     own eval knowledge confirms op(a,b)==T.
// 2 = multi-dep. 3 = wrong-relation dep. 4 = non-pair or literal range.
// 5 = value mismatch. 0 = no MAP found.
// Researcher-owned measurement rubric (same as prior work).
fn gi_classify(W:[]u8,t:i32)i32 {
  let m:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && ng(W,mm,0)==20 && ng(W,mm,8)==t && ng(W,mm,4)==45){m=mm;}
    mm=mm+1;
  }
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24); let oo:i32=ng(W,f,28);
  if(fr!=43 && fr!=44){return 3;}
  let a:i32=oo/16; let b:i32=oo-(a*16);
  if(a<0 || a>9 || b<0 || b>9){return 4;}
  let op:i32=41; if(fr==44){op=42;}
  if(gi_eval_known(W,oo,op,t)==0){return 5;}
  return 1;
}

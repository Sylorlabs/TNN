fn e3_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=7){
    let b:i32=0;
    while(b<=7){
      let p:i32=e3_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}

// ---- EXL4 teaching (literals 0..3, P = a*32+b; sparse stride) ----

fn e4_P(a:i32,b:i32)i32 { return a*32+b; }

fn e4_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(a-b==t){ev_teach_in(W,t,43,e4_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e4_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,e4_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e4_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=3){e4_dsub(W,t); e4_ddiv(W,t); t=t+1;}
  return;
}

fn e4_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=3 && done==0){
      let b:i32=0;
      while(b<=3 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,e4_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=3 && done==0){
    let b:i32=0;
    while(b<=3 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,e4_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e4_teach_build(W:[]u8)void {
  e4_canon_build(W,1,1);
  e4_canon_build(W,3,0);
  return;
}

fn e4_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=3){
    let b:i32=0;
    while(b<=3){
      let p:i32=e4_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  e4_teach_decomp(W);
  e4_teach_build(W);
  return;
}

// ---- grammar reporting ----

fn gi_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let nlic:i32=ng(W,g,4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- test battery (world-specific targets; no BUILD facts taught) ----

fn e4_targets(wid:i32,out:[]u8)i32 {
  if(wid==2){
    set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
    set32(out,16,8); set32(out,20,9);
    return 6;
  }
  if(wid==3){
    set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
    return 4;
  }
  set32(out,0,0); set32(out,4,2);
  return 2;
}

// INDUCE arm: construction guided by the induced grammar. If induction
// refused, no grammar node exists and the arm reports GI-I-NOGRAMMAR
// (fail-closed: nothing is built on a refused grammar).
fn e4_arm_induce(W:[]u8,wid:i32)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-I-NOGRAMMAR\n"); return 0;}
  let tg:[]u8=z_alloc(48); let n:i32=e4_targets(wid,tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gi_classify(W,t);
    emit("GI-I "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// ---- world runner ----

fn e4_world(wid:i32,expect:i32)i32 {
  emit("GI-WORLD ");
  if(wid==2){emit("EXL2\n");}
  if(wid==3){emit("EXL3\n");}
  if(wid==4){emit("EXL4\n");}
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  if(wid==2){e2_teach(W);}
  if(wid==3){e3_teach(W);}
  if(wid==4){e4_teach(W);}
  let code:i32=gi_induce(W);
  emit("GI-INDUCED "); e64(code); emit("\n");
  emit("GI-EXPECT "); e64(expect); emit("\n");
  let m:i32=0;
  if(code==expect){m=1;}
  emit("GI-MATCH "); e64(m); emit("\n");
  gi_report_grammar(W);
  let v:i32=e4_arm_induce(W,wid);
  emit("GI-WORLD-VALID "); e64(v); emit("\n");
  return m;
}

fn main()i32 {
  emit("GI-START\n");
  let m2:i32=e4_world(2,1);
  let m3:i32=e4_world(3,-3);
  let m4:i32=e4_world(4,-3);
  let tot:i32=m2+m3+m4;
  emit("GI-VERDICT "); e64(tot); emit("/3\n");
  emit("GI-DONE\n");
  return 0;
}

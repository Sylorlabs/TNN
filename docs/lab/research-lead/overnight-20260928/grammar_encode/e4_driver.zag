// e4_driver.zag -- grammar ENCODE-CHECK experiment driver.
// Three worlds, one binary, guarded induction machinery (e4_patch.zag).
// EXL2: literals 0..9, P(a,b) = a*16+b (matches the machinery codec;
//   control: must still induce, no false refusal).
// EXL3: literals 0..7, P(a,b) = a*8+b (broken encoding; the machinery
//   codec contradicts the taught op semantics; must refuse with -3).
// EXL4: literals 0..3, P(a,b) = a*32+b (sparse stride; the observed
//   pairs do not cover the induced /16 rectangle; must refuse with -2).
// All worlds: SUB=41, DIV=42, DSUB=43, DDIV=44, BUILD=45. Constraints
// taught via examples only, never as rules.

// ---- EXL2 teaching (literals 0..9, P = a*16+b) ----

fn e2_P(a:i32,b:i32)i32 { return a*16+b; }

fn e2_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,e2_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e2_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,e2_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e2_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){e2_dsub(W,t); e2_ddiv(W,t); t=t+1;}
  return;
}

fn e2_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,e2_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,e2_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn e2_teach_build(W:[]u8)void {
  e2_canon_build(W,1,1);
  e2_canon_build(W,3,0);
  e2_canon_build(W,5,1);
  e2_canon_build(W,7,0);
  return;
}

fn e2_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=e2_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  e2_teach_decomp(W);
  e2_teach_build(W);
  return;
}

// ---- EXL3 teaching (literals 0..7, P = a*8+b) ----

fn e3_P(a:i32,b:i32)i32 { return a*8+b; }


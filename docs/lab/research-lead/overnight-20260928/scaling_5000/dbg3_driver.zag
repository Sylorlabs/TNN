// dbg3.zag -- 5 real + N broken, find failure threshold.
fn dbg_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn dbg_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn dbg_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}
fn dbg_test(N:i32)void {
  let W:[]u8=dbg_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let q:i32=80000;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  let i:i32=0;
  while(i<N){
    dbg_mkbroken(W,2000+i,51,2001+i);
    i=i+1;
  }
  i=0;
  while(i<5){
    dbg_mkchain(W,50000+i*10,5,51,50004+i*10);
    i=i+1;
  }
  let ix:i32=idx_node(W);
  ns(W,ix,4,1);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  let t:i32=hg(W,16);
  emit("N="); e64(N); emit(" ans="); e64(b); emit(" ok="); e64(b==q+104);
  emit(" tried="); e64(t/1024); emit(" rej="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  emit("DBG3-START\n");
  dbg_test(10);
  dbg_test(100);
  dbg_test(500);
  dbg_test(1000);
  emit("DBG3-END\n");
  return 0;
}

// dbg5.zag -- build real first, query, then build decoys, query again.
fn dbg_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn dbg_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn dbg_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}
fn main()i32 {
  emit("DBG5-START\n");
  let W:[]u8=dbg_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let q:i32=80000;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  // Build 5 real FIRST.
  let i:i32=0;
  while(i<5){
    dbg_mkchain(W,50000+i*10,5,51,50004+i*10);
    i=i+1;
  }
  emit("real built\n");
  // Query BEFORE decoys.
  let ix:i32=idx_node(W);
  ns(W,ix,4,1);
  hs(W,16,0);
  let b1:i32=ev_query(W,q,50,q+104,0);
  let t1:i32=hg(W,16);
  emit("BEFORE decoys: ans="); e64(b1); emit(" ok="); e64(b1==q+104);
  emit(" tried="); e64(t1/1024); emit("\n");
  // Now build 2000 decoys.
  ns(W,ix,4,5);
  i=0;
  while(i<2000){
    dbg_mkbroken(W,2000+i,51,2001+i);
    i=i+1;
  }
  emit("decoys built\n");
  // Query AFTER decoys.
  ns(W,ix,4,1);
  hs(W,16,0); hs(W,56,0);
  let b2:i32=ev_query(W,q,50,q+104,0);
  let t2:i32=hg(W,16);
  emit("AFTER decoys: ans="); e64(b2); emit(" ok="); e64(b2==q+104);
  emit(" tried="); e64(t2/1024); emit(" scan="); e64(hg(W,56)); emit("\n");
  emit("DBG5-END\n");
  return 0;
}

// dbg2.zag -- 5 plen-5 MAPs, 1 query (no decoys).
fn dbg_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn dbg_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}
fn main()i32 {
  emit("DBG2-START\n");
  let W:[]u8=dbg_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let q:i32=80000;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  emit("query facts taught\n");
  let i:i32=0;
  while(i<5){
    let pm:i32=dbg_mkchain(W,50000+i*10,5,51,50004+i*10);
    emit("promoted "); e64(pm); emit("\n");
    i=i+1;
  }
  let ix:i32=idx_node(W);
  let head:i32=ng(W,ix,idx_bfield(5));
  emit("plen5 head="); e64(head); emit("\n");
  // Count bucket entries.
  let c:i32=0; let m:i32=head;
  while(m>=0 && c<10){
    emit(" bucket["); e64(c); emit("]="); e64(m); emit("\n");
    c=c+1; m=ng(W,m,12);
  }
  ns(W,ix,4,1);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit("ans="); e64(b); emit(" ok="); e64(b==q+104); emit("\n");
  let t:i32=hg(W,16);
  emit("tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  emit("DBG2-END\n");
  return 0;
}

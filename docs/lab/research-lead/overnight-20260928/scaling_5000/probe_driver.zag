// sc_driver.zag -- scaling continuation driver.
//
// Part 1 (scale law): D broken plen-2 decoys + 5 real plen-5 MAPs,
//   2 plen-5 queries. Modes 0 (linear) vs 1 (MAP index).
// Part 2 (emergent ordering): H1S-style verify tax (12 plen-3 decoys x
//   3 len-3 distractor paths), repeat queries on fresh subjects, then a
//   stale-path test. Modes 0 (linear), 1 (indexed id-order), 3 (indexed
//   + MTF emergent fast-path / move-to-front).
//   NOTE: repeat queries use FRESH subjects with identical structure:
//   ev_query would otherwise hit activate() on the taught query FACT.
//   The MTF memory lives at the MAP level, so this is faithful.
// Part 3 (FACT index): 1000 FACTs, direct t2_gather / t2_lu_first
//   measurement. Modes 0 (linear) vs 4 (FACT index).
fn sc_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_big()[]u8 {
  let W:[]u8=z_alloc(593984);
  return W;
}
fn live_nodes(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<8192){ if(ng(W,n,36)==1){c=c+1;} n=n+1; }
  return c;
}
fn live_edges(W:[]u8)i32 {
  let c:i32=0; let e:i32=0;
  while(e<16384){ if(eg(W,e,0)!=-1){c=c+1;} e=e+1; }
  return c;
}
fn w_probe(D:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,1);
  let qi:i32=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(sc_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
    i=i+1;
  }
  i=0;
  while(i<5){
    if(sc_mkchain(W,5000+i*10,5,51,5004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" D="); e64(D);
  emit(" fails="); e64(fails);
  emit(" live_nodes="); e64(live_nodes(W));
  emit(" live_edges="); e64(live_edges(W));
  emit(" alloc_nodes="); e64(hg(W,20));
  emit(" alloc_edges="); e64(hg(W,24));
  emit("\n");
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("PROBE-START\n");
  w_probe(490,"P490");
  w_probe(990,"P990");
  emit("PROBE-END\n");
  return 0;
}

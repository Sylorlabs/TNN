// sc_driver.zag -- scaling continuation driver.
//
// Part 1 (scale law): D broken plen-2 decoys + 5 real plen-5 MAPs,
//   2 plen-5 queries. Modes 0 (linear) vs 1 (MAP index).
// Part 2 (emergent ordering): H1S-style verify tax (12 plen-3 decoys x
//   3 len-3 distractor paths), repeat queries on fresh subjects, then a
//   stale-path test. Modes 0 (linear), 1 (indexed id-order), 3 (indexed
//   + MTF emergent fast-path / move-to-front).
//   NOTE: repeat queries use FRESH subjects with identical structure:
//   ev_query would otherwise hit activate() on the taught query FACT.
//   The MTF memory lives at the MAP level, so this is faithful.
// Part 3 (FACT index): 1000 FACTs, direct t2_gather / t2_lu_first
//   measurement. Modes 0 (linear) vs 4 (FACT index).
fn sc_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_big()[]u8 {
  let W:[]u8=z_alloc(3674176);
  return W;
}
fn s5mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn s5mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn w_repro5(D:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let qi:i32=0;
  while(qi<2){
    let q:i32=80000+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  emit(tag); emit(" facts taught\n");
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(s5mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;} if((i-((i/250)*250))==0){emit(tag); emit(" prog="); e64(i); emit("\n");}
    i=i+1;
  }
  emit(tag); emit(" decoys done fails="); e64(fails); emit("\n");
  i=0;
  while(i<5){
    if(s5mkchain(W,50000+i*10,5,51,50004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" real done fails="); e64(fails); emit("\n");
  // plen census of the 5 reals
  let m:i32=2; let nreal:i32=0;
  while(m<65536){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let pl:i32=rb_chain_plen(W,ng(W,m,20));
      if(ng(W,m,8)>=50000 && ng(W,m,8)<50100){
        emit(tag); emit(" realMAP id="); e64(m); emit(" subj="); e64(ng(W,m,8));
        emit(" plen="); e64(pl); emit("\n");
        nreal=nreal+1;
      }
    }
    m=m+1;
  }
  emit(tag); emit(" nreal="); e64(nreal); emit("\n");
  let ix:i32=idx_node(W);
  if(ix>=0){ns(W,ix,4,1);}
  qi=0;
  while(qi<2){
    let q:i32=80000+qi*200;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit(tag); emit(" Q"); e64(qi);
    emit(" ans="); e64(b);
    let t:i32=hg(W,16);
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" ok="); e64(b==q+104); emit("\n");
    qi=qi+1;
  }
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("REPRO5-START\n");
  w_repro5(4990,"R4990");
  emit("REPRO5-END\n");
  return 0;
}

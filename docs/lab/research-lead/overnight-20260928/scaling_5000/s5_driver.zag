// s5_driver.zag -- 5000-MAP scaling driver with stress tests.
//
// T1 SCALE: D broken plen-2 decoys + 5 real plen-5 MAPs, 2 plen-5 queries.
//     Modes 0 (linear) vs 1 (hardened MAP index). Measures scan visits.
// T2 CORRUPT: 5000-MAP world, cycle injected in plen-5 bucket.
//     Verifies hardened walk: no crash, correct answer.
// T3 CHURN: 2000 MAPs, evict 1000 (live=0), promote 500 new.
//     Verifies I3 liveness skip: correct answer, no crash.
// T4 COLLIDE: 2000 plen-5 MAPs in one bucket, target is oldest.
//     Measures graceful degradation under adversarial collisions.
//
// Build uses mode 5 (MAP index + FACT index) for speed; mode is poked
// to 0/1 before measurement. Structures are identical; only the query
// path differs.
fn s5_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn s5_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn s5_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}
fn s5_setmode(W:[]u8,mode:i32)void {
  let ix:i32=idx_node(W);
  if(ix>=0){ns(W,ix,4,mode);}
  return;
}
// T1: scale law at 5000 MAPs.
fn w_s5scale(D:i32,mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=s5_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let qi:i32=0;
  while(qi<2){
    let q:i32=80000+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  emit(tag); emit(" facts taught\n");
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(s5_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" decoys done fails="); e64(fails); emit("\n");
  i=0;
  while(i<5){
    if(s5_mkchain(W,50000+i*10,5,51,50004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" real done fails="); e64(fails);
  emit(" build-walks="); e64(hg(W,60)); emit("\n");
  s5_setmode(W,mode);
  hs(W,60,0);
  qi=0;
  while(qi<2){
    let q:i32=80000+qi*200;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit(tag); emit(" Q"); e64(qi);
    emit(" ans="); e64(b);
    let t:i32=hg(W,16);
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" walks="); e64(hg(W,60));
    emit(" ok="); e64(b==q+104); emit("\n");
    qi=qi+1;
  }
  emit(tag); emit("-END\n");
  return;
}
// T2: corruption at scale. Build 5000-MAP world, inject cycle in
// plen-5 bucket, verify hardened walk survives.
fn w_s5corrupt(tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=s5_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let q:i32=80000;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  let i:i32=0;
  let fails:i32=0;
  while(i<4990){
    if(s5_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
    i=i+1;
  }
  i=0;
  while(i<5){
    if(s5_mkchain(W,50000+i*10,5,51,50004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" built fails="); e64(fails); emit("\n");
  // Inject cycle: plen-5 bucket head -> head (self-loop).
  let ix:i32=idx_node(W);
  let bf:i32=idx_bfield(5);
  let head:i32=ng(W,ix,bf);
  emit(tag); emit(" bucket-head="); e64(head); emit("\n");
  if(head>=0){
    ns(W,head,12,head);
    emit(tag); emit(" cycle injected\n");
  }
  s5_setmode(W,1);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit(tag); emit(" ans="); e64(b);
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" ok="); e64(b==q+104); emit(" NO-CRASH=1\n");
  emit(tag); emit("-END\n");
  return;
}
// T3: churn. Build 2000, evict 1000 (live=0), promote 500 new.
// Verifies I3 skips dead entries.
fn w_s5churn(tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=s5_big(); tnn2_init(W);
  idx_mode_set(W,5);
  let q:i32=80000;
  ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
  ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
  let i:i32=0;
  let fails:i32=0;
  while(i<2000){
    if(s5_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
    i=i+1;
  }
  // Promote 5 real plen-5 MAPs BEFORE churn (they will be evicted too
  // if in the kill range; we re-promote after).
  i=0;
  while(i<5){
    if(s5_mkchain(W,50000+i*10,5,51,50004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" built fails="); e64(fails); emit("\n");
  // Evict: walk plen-2 bucket, kill every other MAP (live=0).
  let ix:i32=idx_node(W);
  let m:i32=ng(W,ix,idx_bfield(2));
  let kill:i32=0;
  let killed:i32=0;
  while(m>=0){
    let nx:i32=ng(W,m,12);
    if(kill==1 && m>=2 && m<NN()){
      ns(W,m,36,0);
      killed=killed+1;
    }
    kill=1-kill;
    m=nx;
  }
  emit(tag); emit(" killed="); e64(killed); emit("\n");
  // Promote 500 new broken MAPs (get idx_add'ed to bucket heads).
  i=0;
  while(i<500){
    if(s5_mkbroken(W,30000+i,51,30001+i)<0){fails=fails+1;}
    i=i+1;
  }
  // Re-promote the 5 real (in case they were killed).
  i=0;
  while(i<5){
    if(s5_mkchain(W,50000+i*10,5,51,50004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" churn done fails="); e64(fails); emit("\n");
  s5_setmode(W,1);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q,50,q+104,0);
  emit(tag); emit(" ans="); e64(b);
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" ok="); e64(b==q+104); emit(" NO-CRASH=1\n");
  emit(tag); emit("-END\n");
  return;
}
// T4: adversarial collisions. 2000 plen-5 MAPs in one bucket.
// Target is the oldest (deepest). Measures graceful degradation.
fn w_s5collide(tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=s5_big(); tnn2_init(W);
  idx_mode_set(W,5);
  // Target chain (oldest, built first).
  let tq:i32=80000;
  ev_teach(W,tq,1,tq+101); ev_teach(W,tq+101,1,tq+102);
  ev_teach(W,tq+102,1,tq+103); ev_teach(W,tq+103,1,tq+104);
  if(s5_mkchain(W,40000,5,51,40004)<0){emit(tag); emit(" target FAIL\n");}
  emit(tag); emit(" target built\n");
  // 1999 more plen-5 MAPs (same bucket, newer = closer to head).
  let i:i32=0;
  let fails:i32=0;
  while(i<1999){
    if(s5_mkchain(W,41000+i*10,5,51,41004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" colliders done fails="); e64(fails); emit("\n");
  s5_setmode(W,1);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,tq,50,tq+104,0);
  emit(tag); emit(" ans="); e64(b);
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" ok="); e64(b==tq+104); emit("\n");
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("S5-START\n");
  w_s5scale(4990,0,"S5KL");
  w_s5scale(4990,1,"S5KI");
  w_s5corrupt("S5C");
  w_s5churn("S5H");
  w_s5collide("S5X");
  emit("S5-END\n");
  return 0;
}

// ============================================================
// da_main.zag -- disagreement-attribution battery main program
// Learner-owned disagreement-attribution probe (attr_probe) on
// purpose-built collision worlds. Addresses INTEGRATION-COMBINED's
// disclosed F4: trigger B cannot attribute binding-caused vs
// coverage-caused disagreement.
//
// ans_eq, oracle_1ret, oracle_1vfy, and do_query are carried over
// from cb_main.zag VERBATIM except for two additions in do_query:
// (a) the attr_probe call on learner-vs-oracle disagreement when
// spec versions were used (BEFORE note_answer_disagree; the
// trigger-B invalidation path, the M3 hook, and the retry bound
// are untouched), and (b) okind 4 (oracle_1cnt, new).
// All world literals live in da_world.zag (da_trial_params,
// da_clean_params); this file uses only structural ids and the
// telemetry slots S930-936. pmod selects the probe variant: 0 =
// real probe, 1 = null always-BINDING probe (the guessing control).
// ============================================================
// ---- answer equality: flat element-wise comparison ----
// DEVIATION from cb_main.zag (documented): cb's ans_eq walked the
// flat answer buffer as fixed-size records (k at 4+i*4, items at
// 8+i*16), which misreads large object ids as record lengths and
// panics with slice index out of bounds. The answers
// produced by compose and the oracles are flat [nflat, v0, ...],
// so the correct comparison is element-wise. This fix is minimal
// and does not change the probe, the contracts, or the retry logic.
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(n!=get32(b,0)){ return 0; }
  let i:i32=0;
  while(i<n){
    if(get32(a,4+i*4)!=get32(b,4+i*4)){ return 0; }
    i=i+1;
  }
  return 1;
}
// ---- oracle_1ret: independent all-generic reference for 1 RET ----
fn oracle_1ret(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_1vfy: independent all-generic reference for a single ----
// ---- VERIFY need. Answer record matches the learner's [1, vv]. ----
fn oracle_1vfy(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  return;
}
// ---- oracle_1cnt: independent all-generic reference for 1 COUNT ----
// ---- need. Answer record matches the learner's [1, cc]. ----
fn oracle_1cnt(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let sb:[]u8=z_alloc(16);
  set32(sb,0,need_f(G,0,2));
  let cc:i32=cnt_gen(A,rel,sb,0,1,K,4,seen);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,cc);
  return;
}
// ---- learn_all: learn the three families on the current world ----
// 4 episodes each, then specialize. Mirrors the S10A protocol.
fn learn_all(L:[]u8,S:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,Cb:[]u8)void {
  ss(S,908,-1);
  let e:i32=0;
  while(e<4){
    ret_ep_pat(e,rb,0);
    ret_episode(L,A,get32(rb,0),get32(rb,4),K,tout);
    e=e+1;
  }
  specialize_ret(L,S,A,0,3);
  e=0;
  while(e<4){
    vfy_ep_chain(Cb,e);
    vfy_episode(L,A,Cb,K);
    e=e+1;
  }
  specialize_vfy(L,S,A,4,7);
  e=0;
  while(e<4){
    cnt_ep_pat(e,rb,0);
    cnt_episode(L,A,get32(rb,0),get32(rb,4),K,tout,seen);
    e=e+1;
  }
  specialize_cnt(L,S,A,8,11);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
// Carried over from cb_main.zag VERBATIM except for (a) the
// attr_probe call before note_answer_disagree, and (b) okind 4.
fn do_query(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32,pmod:i32)i32 {
  // SELFTRIG: C_Q (S slot 7) ticks once per query. Bounded
  // self-correction: up to 3 attempts; after a disagreeing attempt
  // that used spec versions, the attribution probe runs (BEFORE the
  // blunt trigger-B invalidation), the composer invalidates the
  // spec-routing coverage contracts (trigger B) and retries. On a
  // first-try agree this path emits nothing extra.
  ss(S,7,sg(S,7)+1);
  let att:i32=1;
  while(att<=3){
    set32(K,0,0);
    set32(K,4,0);
    let hf0:i32=get32(L,13276);
    let st:i32=compose(L,S,A,G,K,ans,vbuf);
    // COMBINED: report a plan-invalidation hook fire. compose stashes
    // the hook telemetry at L+13276..13296; the cursor cannot thread
    // through compose (it returns only the st code), so do_query
    // emits the HOOK line when it observes the fire count increase.
    if(get32(L,13276)>hf0){
      c=o_app(b,c,"HOOK gtag=");
      c=o_i64(b,c,get32(L,13280) as i64);
      c=o_app(b,c," need=");
      c=o_i64(b,c,get32(L,13284) as i64);
      c=o_app(b,c," tag=");
      c=o_i64(b,c,get32(L,13288) as i64);
      c=o_app(b,c," oldfam=");
      c=o_i64(b,c,get32(L,13292) as i64);
      c=o_app(b,c," newfam=");
      c=o_i64(b,c,get32(L,13296) as i64);
      c=o_nl(b,c);
    }
    c=o_app(b,c,"Q id=");
    c=o_app(b,c,qn);
    if(st==0){
      c=o_app(b,c," goal=");
      c=o_i64(b,c,g_tag(G) as i64);
      c=o_app(b,c," decline=1");
      c=o_nl(b,c);
      return c;
    }
    set32(K,4,0);
    // okind 2 = oracle_1ret, 3 = oracle_1vfy, 4 = oracle_1cnt.
    // (okinds 0/1, oracle_808/oracle_dia, are not staged here.)
    if(okind==2){ oracle_1ret(A,G,K,oans,seen); }
    if(okind==3){ oracle_1vfy(A,G,K,oans,seen); }
    if(okind==4){ oracle_1cnt(A,G,K,oans,seen); }
    let cs:i32=get32(K,0);
    let cg:i32=get32(K,4);
    let a:i32=ans_eq(ans,oans);
    set32(L,13240,get32(L,13240)+a);
    set32(L,13244,get32(L,13244)+cs);
    set32(L,13248,get32(L,13248)+cg);
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," st=");
    c=o_i64(b,c,st as i64);
    c=o_app(b,c," vers=");
    let nn:i32=get32(vbuf,16);
    let p:i32=0;
    while(p<nn){
      if(p>0){ b[c]=44; c=c+1; }
      c=o_i64(b,c,get32(vbuf,p*4) as i64);
      p=p+1;
    }
    c=o_app(b,c," ans=");
    let an:i32=get32(ans,0);
    c=o_i64(b,c,an as i64);
    b[c]=58; c=c+1;
    let k:i32=0;
    while(k<an){
      if(k>0){ b[c]=44; c=c+1; }
      c=o_i64(b,c,get32(ans,4+k*4) as i64);
      k=k+1;
    }
    c=o_app(b,c," agree=");
    c=o_i64(b,c,a as i64);
    c=o_app(b,c," cs=");
    c=o_i64(b,c,cs as i64);
    c=o_app(b,c," cg=");
    c=o_i64(b,c,cg as i64);
    c=o_nl(b,c);
    if(a==1){ return c; }
    let specused:i32=0;
    let q2:i32=0;
    while(q2<nn){
      let vv:i32=get32(vbuf,q2*4);
      if(vv==2){ specused=1; }
      if(vv==3){ specused=1; }
      if(vv==5){ specused=1; }
      q2=q2+1;
    }
    if(specused==0){ return c; }
    if(att>=3){ return c; }
    c=attr_probe(b,c,L,S,A,G,K,vbuf,seen,pmod);
    c=note_answer_disagree(b,c,S,vbuf,att);
    att=att+1;
  }
  return c;
}
// ---- main: 16 collision trials + 4 clean trials ----
// Per trial: fresh L/S, world A, learn all families, baseline or
// pre-drift query (agree), then the collision query staged per
// da_trial_kind. S930 carries the harness trial id for the probe's
// ATTR line (a label only; the probe never reads the cause ledger).
// Scoring compares the probe's S931 cause against the staged cause
// (BIND=0 for t<8, COV=1 for t>=8); evsig checks the evidence
// signature (evb=1,evc=0 on BIND; evb=0,evc=1 on COV).
fn main()i32 {
  let PMOD:i32=1;
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let P:[]u8=z_alloc(64);
  let correct:i32=0;
  let evsig:i32=0;
  c=o_app(B,c,"STAGE ATTR-BATTERY pmod=");
  c=o_i64(B,c,PMOD as i64);
  c=o_nl(B,c);
  let t:i32=0;
  while(t<16){
    let L:[]u8=z_alloc(16384);
    let S:[]u8=z_alloc(16384);
    let kind:i32=da_trial_kind(t);
    da_trial_params(t,P);
    setup_worldA(A);
    learn_all(L,S,A,K,rb,tout,seen,Cb);
    ss(S,930,-1);
    if(kind==0){
      da_mk_ret(G,950+t,get32(P,0),get32(P,4),get32(P,8));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B",2,PMOD);
      da_mk_cnt(G,960+t,get32(P,0),get32(P,4),get32(P,12));
      ss(S,930,t);
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"T",4,PMOD);
    }
    if(kind==1){
      da_mk_cnt(G,950+t,get32(P,0),get32(P,4),get32(P,12));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B",4,PMOD);
      da_mk_ret(G,960+t,get32(P,0),get32(P,16),get32(P,20));
      ss(S,930,t);
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"T",2,PMOD);
    }
    if(kind==2){
      da_mk_ret(G,950+t,get32(P,0),get32(P,4),get32(P,8));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B",2,PMOD);
      setup_worldA2(A);
      ss(S,930,t);
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"T",2,PMOD);
    }
    if(kind==3){
      da_mk_vfy(G,950+t,get32(P,0),get32(P,24),get32(P,28),get32(P,32),get32(P,36),get32(P,40));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B",3,PMOD);
      setup_worldA2(A);
      ss(S,930,t);
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"T",3,PMOD);
    }
    if(kind==4){
      da_mk_cnt(G,950+t,get32(P,0),get32(P,4),get32(P,12));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"B",4,PMOD);
      setup_worldA3(A);
      ss(S,930,t);
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"T",4,PMOD);
    }
    let exp:i32=0;
    if(t>=8){ exp=1; }
    if(sg(S,931)==exp){ correct=correct+1; }
    let eb:i32=sg(S,934);
    let ec:i32=sg(S,935);
    if(exp==0){
      if(eb==1){
        if(ec==0){ evsig=evsig+1; }
      }
    }
    if(exp==1){
      if(eb==0){
        if(ec==1){ evsig=evsig+1; }
      }
    }
    t=t+1;
  }
  c=o_app(B,c,"STAGE CLEAN");
  c=o_nl(B,c);
  let q:i32=0;
  while(q<4){
    let L:[]u8=z_alloc(16384);
    let S:[]u8=z_alloc(16384);
    da_clean_params(q,P);
    setup_worldA(A);
    learn_all(L,S,A,K,rb,tout,seen,Cb);
    ss(S,930,-1);
    let qk:i32=get32(P,0);
    if(qk==0){
      da_mk_ret(G,970+q,get32(P,4),get32(P,8),get32(P,12));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"C",2,PMOD);
    }
    if(qk==1){
      da_mk_vfy(G,970+q,get32(P,4),get32(P,20),get32(P,24),get32(P,28),get32(P,32),get32(P,36));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"C",3,PMOD);
    }
    if(qk==2){
      da_mk_cnt(G,970+q,get32(P,4),get32(P,8),get32(P,16));
      c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"C",4,PMOD);
    }
    q=q+1;
  }
  c=o_app(B,c,"SCORE-ATTR correct=");
  c=o_i64(B,c,correct as i64);
  c=o_app(B,c," total=16 evsig=");
  c=o_i64(B,c,evsig as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// vc_driver.zag -- H2 value-composition driver.
// Same X/Y/Z world as xd_driver_c. Z query goes through vc_query.

fn vc_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn vc_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn vc_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn vc_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn vc_trainX(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=ev_query(W,11,91,14,0);
  emit("X1 ans="); e64(x1); vc_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=ev_query(W,15,91,18,0);
  emit("X2 ans="); e64(x2); vc_tstat(W);
  return;
}
fn vc_trainY(W:[]u8)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=ev_query(W,50,92,3,0);
  emit("Y1 ans="); e64(y1); vc_tstat(W);
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=ev_query(W,60,92,4,0);
  emit("Y2 ans="); e64(y2); vc_tstat(W);
  return;
}
fn vc_zfacts(W:[]u8)void {
  ev_teach(W,31,81,32); ev_teach(W,32,81,33); ev_teach(W,33,81,34);
  ev_teach(W,34,82,35); ev_teach(W,35,82,36);
  return;
}
fn vc_zquery(W:[]u8)void {
  let z:i32=vc_query(W,31,93,2,0);
  emit("Z ans="); e64(z); vc_tstat(W);
  let cm:i32=vc_find_composite(W,93);
  emit("ZCOMP id="); e64(cm);
  if(cm>=0){
    emit(" m1="); e64(ng(W,cm,12));
    emit(" m2="); e64(ng(W,cm,16));
    emit(" mark="); e64(ng(W,cm,32));
  }
  emit("\n");
  return;
}
fn vc_zprime(W:[]u8)void {
  ev_teach(W,41,81,42); ev_teach(W,42,81,43); ev_teach(W,43,81,44);
  ev_teach(W,44,82,45); ev_teach(W,45,82,46);
  let z2:i32=vc_query(W,41,93,2,0);
  emit("ZPRIME ans="); e64(z2); vc_tstat(W);
  return;
}
fn vc_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  vc_trainX(W);
  vc_trainY(W);
  vc_gap(W);
  emit("maps="); e64(vc_count_maps(W)); emit("\n");
  vc_zfacts(W);
  vc_zquery(W);
  vc_zprime(W);
  return;
}
fn vc_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  vc_trainX(W);
  vc_trainY(W);
  vc_del_map_r(W,91);
  emit("maps after del="); e64(vc_count_maps(W)); emit("\n");
  vc_gap(W);
  vc_zfacts(W);
  vc_zquery(W);
  return;
}
fn vc_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  vc_trainX(W);
  vc_trainY(W);
  vc_del_map_r(W,92);
  emit("maps after del="); e64(vc_count_maps(W)); emit("\n");
  vc_gap(W);
  vc_zfacts(W);
  vc_zquery(W);
  return;
}
fn vc_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  vc_gap(W);
  vc_zfacts(W);
  vc_zquery(W);
  return;
}
fn vc_novc(W:[]u8)void {
  emit("=== NO-VC ===\n");
  vc_trainX(W);
  vc_trainY(W);
  vc_gap(W);
  vc_zfacts(W);
  let z:i32=ev_query(W,31,93,2,0);
  emit("Z ans="); e64(z); vc_tstat(W);
  return;
}
fn main()i32 {
  emit("VC-H2-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); vc_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); vc_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); vc_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); vc_fresh(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); vc_novc(W5);
  emit("VC-H2-END\n");
  return 0;
}

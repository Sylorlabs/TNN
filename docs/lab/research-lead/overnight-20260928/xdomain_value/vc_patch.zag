// vc_patch.zag -- H2: value-level function composition for cross-domain Z.
//
// Treats learned structures as FUNCTIONS (input value -> output value).
// Composition = sequential execution with value passing: Z(x) = G(F(x)).
// The handoff is the intermediate VALUE, not a merged graph.
//
// Modes: 1=CHAIN (navigation, via rebind-style assembly), 2=COUNT
// (aggregation, via count template). Ordered pairs are tried; the pair
// is discovered, not given.
//
// Pure Zag. Unfrozen only. 0 modes/bridges/handlers.

// 1 if any live MAP's executable graph contains an INC cell (tag 103).
// Evidence that aggregation capability was learned.
fn vc_has_count_map(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let cur:i32=ng(W,m,20); let steps:i32=0; let found:i32=0;
      while(cur>=0 && steps<64 && found==0){
        let tag:i32=ng(W,cur,0);
        if(tag==103){found=1;}
        else {
          if(tag==102){cur=ng(W,cur,12);}
          else {cur=seq_nx(W,cur);}
        }
        steps=steps+1;
      }
      if(found==1){return 1;}
    }
    m=m+1;
  }
  return 0;
}

// Execute chain MAPs on subject s as a function. masked=1 (no expected
// check). NO promotion: pure function, no side effects. Returns value/-2.
fn vc_chain_exec(W:[]u8,s:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  let m:i32=2;
  while(m<1024 && ans==-2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let plen:i32=rb_chain_plen(W,ng(W,m,20));
      if(plen>=2){
        let p:i32=0;
        while(p<np && ans==-2){
          let base:i32=p*48;
          if(get32(paths,base)==plen){
            let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
            let j:i32=0;
            while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
            j=0;
            while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
            let nr:i32=t2_asm_chain(W,v,plen,f);
            let v2:i32=t2_try_verify(W,nr,s,-1,1,st);
            if(v2!=-2){ans=v2;}
          }
          p=p+1;
        }
      }
    }
    m=m+1;
  }
  return ans;
}

// Execute count aggregation on subject s as a function. Requires a learned
// count MAP as capability evidence. masked=1. NO promotion. Returns value/-2.
fn vc_count_exec(W:[]u8,s:i32,st:[]u8)i32 {
  if(vc_has_count_map(W)==0){return -2;}
  let ans:i32=-2;
  let rb:[]u8=z_alloc(64); let nr:i32=t2_rels(W,s,rb);
  let i:i32=0;
  while(i<nr && ans==-2){
    let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
    let len:i32=t2_chain(W,s,get32(rb,i*4),v,f);
    if(len>=2){
      let root:i32=t2_asm_count(W,v,len,f);
      let v2:i32=t2_try_verify(W,root,s,-1,1,st);
      if(v2!=-2){ans=v2;}
    }
    i=i+1;
  }
  return ans;
}

// Run one stage by mode id. 1=CHAIN, 2=COUNT.
fn vc_stage(W:[]u8,mode:i32,subj:i32,st:[]u8)i32 {
  if(mode==1){return vc_chain_exec(W,subj,st);}
  if(mode==2){return vc_count_exec(W,subj,st);}
  return -2;
}

// Value-level composition: try ordered mode pairs. On success promote a
// composite MAP (r,s)->ans with fields 12=mode1, 16=mode2, 32=777.
fn vc_compose(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let m1:i32=1;
  while(m1<=2){
    let m2:i32=1;
    while(m2<=2){
      let v1:i32=vc_stage(W,m1,s,st);
      if(v1!=-2){
        emit("VC-STAGE1 m="); e64(m1); emit(" v1="); e64(v1); emit("\n");
        let v2:i32=vc_stage(W,m2,v1,st);
        if(v2!=-2){
          emit("VC-STAGE2 m="); e64(m2); emit(" v2="); e64(v2); emit("\n");
          if(v2==expected){
            let facts:[]u8=z_alloc(8);
            let cm:i32=promote_graph(W,-1,s,r,v2,facts,0);
            if(cm>=0){
              ns(W,cm,12,m1); ns(W,cm,16,m2); ns(W,cm,32,777);
              link_edge(W,cm,14,cm,0);
            }
            emit("VC-COMPOSE ok m1="); e64(m1);
            emit(" m2="); e64(m2);
            emit(" cm="); e64(cm); emit("\n");
            hs(W,16,get32(st,0)*1024+get32(st,4));
            return v2;
          }
        }
      }
      m2=m2+1;
    }
    m1=m1+1;
  }
  hs(W,16,get32(st,0)*1024+get32(st,4));
  emit("VC-COMPOSE fail\n");
  return -2;
}

// Query pipeline mirroring ev_query but with vc_compose in place of compose_try.
fn vc_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let ca:i32=vc_compose(W,s,r,expected);
  if(ca!=-2){
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// Find composite MAP for rel r (field32==777 marker).
fn vc_find_composite(W:[]u8,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r && ng(W,m,32)==777){return m;}
    m=m+1;
  }
  return -1;
}

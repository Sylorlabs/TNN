// reaudit_join.zag -- LEDGER-REAUDIT lane.
// Re-runs the lane/recovery 393-claim evidence audit against the RESTORED tip.
//
// Method is deliberately INDEPENDENT of the original audit's stage 2. That stage
// trusted a precomputed abbreviation -> OK|ABSENT table (sha_res.tsv). Here every
// cited abbreviation is prefix-matched directly against the COMPLETE commit set of
// the object database (allcommits.txt, from
// `git cat-file --batch-all-objects --batch-check`), so no resolution is inherited
// from an earlier worker's judgement.
//
// Inputs (all produced by git plumbing; none is scientific computation):
//   cites2.tsv     claim_id <TAB> (L<lane>:<athead> | H<hex>:<len>) ...
//   allcommits.txt one 40-char commit sha per line, EVERY commit object present
//   lane_state.tsv <lane-basename> <TAB> 1|0  (1 = lane dir present at RESTORED tip)
//
// Emits reaudit_evidence.tsv, one row per canonical claim block:
//   id  nshort  nok  nabs  nlanes  nlanes_gone  verdict2
//
// VERDICT LADDER (unchanged from lane/recovery, highest severity first):
//   SHA-UNRESOLVABLE  >=1 cited abbreviated commit sha absent from the object DB
//   LANE-GONE         all shas resolve but >=1 named lane absent at the tip
//   NO-CITATION       block names no abbreviated sha and no known lane
//   EVIDENCE-INTACT   every cited short sha resolves and every named lane present
//
// READ-ONLY with respect to canonical_ledger/CLAIM_LEDGER.md. Nothing is minted.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn cat(a:[]u8,b:[]u8)[]u8 {
  let r:[]u8=z_alloc(a.len+b.len+1);
  let i:i32=0;
  while(i<a.len){ r[i]=a[i]; i=i+1; }
  let j:i32=0;
  while(j<b.len){ r[a.len+j]=b[j]; j=j+1; }
  r[a.len+b.len]=0;
  return r;
}
fn eol(b:[]u8,i:i32,n:i32)i32 {
  let j:i32=i;
  while(j<n){ if(b[j]==10){ return j+1; } j=j+1; }
  return n;
}
// copy b[from..to) into a fresh NUL-terminated buffer
fn fnv(b:[]u8,from:i32,to:i32)[]u8 {
  let r:[]u8=z_alloc(to-from+1);
  let i:i32=from;
  while(i<to){ r[i-from]=b[i]; i=i+1; }
  r[to-from]=0;
  return r;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_cp(b:[]u8,c:i32,s:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n){ b[c+i]=s[i]; i=i+1; }
  return c+n;
}
fn o_ch(b:[]u8,c:i32,x:i32)i32 { b[c]=x as u8; return c+1; }
fn o_tab(b:[]u8,c:i32)i32 { return o_ch(b,c,9); }
fn o_nl(b:[]u8,c:i32)i32 { return o_ch(b,c,10); }

// ---------- commit-set index -------------------------------------------------
// Flat arena. Record i occupies bytes [i*41, i*41+41): 40 sha chars + newline.
// Records are addressed by index; all offsets are computed, never sliced.
fn CREC()i32 { return 41; }

fn sha_prefix_match(arena:[]u8,nrec:i32,ab:[]u8,alen:i32)i32 {
  let r:i32=0;
  let i:i32=0;
  while(i<nrec){
    let o:i32=i*CREC();
    let k:i32=0; let ok:i32=1;
    while(k<alen){
      let ch:i32=arena[o+k] as i32;
      if(ch!=ab[k] as i32){ ok=0; }
      k=k+1;
    }
    if(ok==1){ r=1; }
    i=i+1;
  }
  return r;
}

// ---------- lane-state lookup ------------------------------------------------
// Scans lane_state.tsv (<name> <TAB> 0|1) for the name `name`.
// Returns 0 if the name is not indexed, 1 if indexed and PRESENT (flag '1'),
// 2 if indexed and ABSENT (flag '0').
fn lane_present(lanes:[]u8,nl:i32,name:[]u8,ln:i32)i32 {
  let r:i32=0;
  let s:i32=0;
  while(s<nl){
    let e:i32=s;
    while(e<nl){ if(lanes[e]==10){ break; } e=e+1; }
    if(e>s){
      let m:i32=0;
      while(s+m<e){ if(lanes[s+m]==9){ break; } m=m+1; }
      if(m==ln){
        let t:i32=0; let same:i32=1;
        while(t<ln){ if(lanes[s+t]!=name[t]){ same=0; } t=t+1; }
        if(same==1){
          let flag:i32=lanes[s+m+1] as i32;
          if(flag==49){ r=1; }
          if(flag==48){ r=2; }
        }
      }
    }
    s=e+1;
  }
  return r;
}

fn vname(v:i32)[]u8 {
  if(v==1){ return "SHA-UNRESOLVABLE"; }
  if(v==2){ return "LANE-GONE"; }
  if(v==3){ return "NO-CITATION"; }
  return "EVIDENCE-INTACT";
}
fn vlen(v:i32)i32 {
  if(v==1){ return 16; }
  if(v==2){ return 9; }
  if(v==3){ return 11; }
  return 15;
}

fn main()i32 {
  let d:[]u8="docs/lab/research-lead/overnight-20260928/reaudit_ledger/";
  let cits:[]u8=_zag_read_file(cat(d,"cites2.tsv"));
  let coms:[]u8=_zag_read_file(cat(d,"allcommits.txt"));
  let lanes:[]u8=_zag_read_file(cat(d,"lane_state.tsv"));

  // count commit records
  let nrec:i32=0;
  let i:i32=0;
  while(i<coms.len){ if(coms[i]==10){ nrec=nrec+1; } i=i+1; }
  _zag_print("COMMIT_OBJECTS_IN_DB "); _zag_println(_zag_i64_to_str(nrec as i64));

  let out:[]u8=z_alloc(200000);
  let oc:i32=0;
  oc=o_cp(out,oc,"id",2 as i32);        oc=o_tab(out,oc);
  oc=o_cp(out,oc,"nshort",6 as i32);    oc=o_tab(out,oc);
  oc=o_cp(out,oc,"nok",3 as i32);       oc=o_tab(out,oc);
  oc=o_cp(out,oc,"nabs",4 as i32);      oc=o_tab(out,oc);
  oc=o_cp(out,oc,"nlanes",6 as i32);    oc=o_tab(out,oc);
  oc=o_cp(out,oc,"nlanes_gone",11 as i32); oc=o_tab(out,oc);
  oc=o_cp(out,oc,"verdict2",8 as i32);  oc=o_nl(out,oc);

  let deg:[]u8=z_alloc(20000);
  let dc:i32=0;

  let p:i32=0;
  let nclaim:i32=0;
  let v_sha:i32=0; let v_gone:i32=0; let v_nocit:i32=0; let v_int:i32=0;
  let t_short:i32=0; let t_ok:i32=0; let t_abs:i32=0;
  let t_lane:i32=0; let t_gone:i32=0;

  while(p<cits.len){
    let e:i32=p;
    while(e<cits.len){ if(cits[e]==10){ break; } e=e+1; }
    if(e>p){
      let q:i32=p;
      while(q<e){ if(cits[q]==9){ break; } q=q+1; }
      let id:[]u8=fnv(cits,p,q);
      let idn:i32=q-p;

      // ---- H<hex>:<len> tokens: prefix-match against the whole commit set.
      // The extractor emitted EVERY maximal hex run in the block prose, so the
      // stream also carries 64-char sha256 file digests, three full 40-char shas,
      // and a handful of other-length tokens. lane/recovery counted only the
      // abbreviated COMMIT ids, len 8/9/10, and so do we: an `<len>` outside that
      // set is a file digest, not a provenance citation, and counting it would
      // silently change the denominator.
      let ns:i32=0; let nok:i32=0; let nab:i32=0;
      let g:i32=q+1;
      while(g<e){
        let ish:i32=0;
        if(cits[g]==72 && g+1<e){ ish=1; }
        if(ish==1){
          let hs:i32=g+1; let he:i32=hs;
          while(he<e){ if(cits[he]==58){ break; } if(cits[he]==9){ break; } he=he+1; }
          if(he>=e || he==hs){ g=g+1; }
          else {
            // read the <len> field
            let ls:i32=he+1; let le:i32=ls; let lv:i32=0;
            while(le<e){ if(cits[le]==9){ break; } lv=lv*10+(cits[le] as i32-48); le=le+1; }
            let isab:i32=0;
            if(lv==8 || lv==9 || lv==10){ isab=1; }
            if(isab==1){
              ns=ns+1;
              let ab:[]u8=fnv(cits,hs,he);
              let m:i32=sha_prefix_match(coms,nrec,ab,he-hs);
              if(m==1){ nok=nok+1; } else { nab=nab+1; }
            }
            g=le+1;
          }
        } else { g=g+1; }
      }

      // ---- L<name>:<flag> tokens, re-read against the RESTORED tip
      let nlg:i32=0; let ngo:i32=0;
      let g2:i32=q+1;
      while(g2<e){
        let isl:i32=0;
        if(cits[g2]==76 && g2+1<e){ isl=1; }
        if(isl==1){
          let nsx:i32=g2+1; let nex:i32=nsx;
          while(nex<e){ if(cits[nex]==58){ break; } if(cits[nex]==9){ break; } nex=nex+1; }
          let okl:i32=0;
          if(nex<e && cits[nex]==58 && cits[nex+1]!=9){ okl=1; }
          if(okl==1){
            nlg=nlg+1;
            let nm:[]u8=fnv(cits,nsx,nex);
            let f:i32=lane_present(lanes,lanes.len,nm,nex-nsx);
            if(f==2){ ngo=ngo+1; }
            g2=nex+2;
          } else { g2=g2+1; }
        } else { g2=g2+1; }
      }

      let v:i32=4;
      if(nab>0){ v=1; }
      if(v==4 && ngo>0){ v=2; }
      if(v==4 && ns==0 && nlg==0){ v=3; }

      oc=o_cp(out,oc,id,idn); oc=o_tab(out,oc);
      oc=o_i32(out,oc,ns);  oc=o_tab(out,oc);
      oc=o_i32(out,oc,nok);  oc=o_tab(out,oc);
      oc=o_i32(out,oc,nab); oc=o_tab(out,oc);
      oc=o_i32(out,oc,nlg);  oc=o_tab(out,oc);
      oc=o_i32(out,oc,ngo);  oc=o_tab(out,oc);
      oc=o_cp(out,oc,vname(v),vlen(v));
      oc=o_nl(out,oc);

      if(v!=4){
        dc=o_cp(deg,dc,"C",1 as i32);
        dc=o_cp(deg,dc,id,idn);
        dc=o_tab(deg,dc);
        dc=o_cp(deg,dc,vname(v),vlen(v));
        dc=o_nl(deg,dc);
      }

      if(v==1){ v_sha=v_sha+1; }
      if(v==2){ v_gone=v_gone+1; }
      if(v==3){ v_nocit=v_nocit+1; }
      if(v==4){ v_int=v_int+1; }
      t_short=t_short+ns; t_ok=t_ok+nok; t_abs=t_abs+nab;
      t_lane=t_lane+nlg; t_gone=t_gone+ngo;
      nclaim=nclaim+1;
    }
    p=eol(cits,p,cits.len);
  }

  _zag_write_file(cat(d,"reaudit_evidence.tsv"),out[0..oc]);
  _zag_write_file(cat(d,"reaudit_degraded.tsv"),deg[0..dc]);

  _zag_print("CLAIMS_JOINED ");              _zag_println(_zag_i64_to_str(nclaim as i64));
  _zag_print("V2_SHA_UNRESOLVABLE ");       _zag_println(_zag_i64_to_str(v_sha as i64));
  _zag_print("V2_LANE_GONE ");              _zag_println(_zag_i64_to_str(v_gone as i64));
  _zag_print("V2_NO_CITATION ");            _zag_println(_zag_i64_to_str(v_nocit as i64));
  _zag_print("V2_EVIDENCE_INTACT ");        _zag_println(_zag_i64_to_str(v_int as i64));
  _zag_print("T2_SHORT_SHAS_CITED ");       _zag_println(_zag_i64_to_str(t_short as i64));
  _zag_print("T2_SHORT_SHAS_RESOLVED ");    _zag_println(_zag_i64_to_str(t_ok as i64));
  _zag_print("T2_SHORT_SHAS_ABSENT ");      _zag_println(_zag_i64_to_str(t_abs as i64));
  _zag_print("T2_LANE_MENTIONS ");          _zag_println(_zag_i64_to_str(t_lane as i64));
  _zag_print("T2_LANE_MENTIONS_GONE ");     _zag_println(_zag_i64_to_str(t_gone as i64));
  _zag_print("WROTE_TSV_BYTES ");           _zag_println(_zag_i64_to_str(oc as i64));
  _zag_print("WROTE_DEGRADED_BYTES ");      _zag_println(_zag_i64_to_str(dc as i64));
  return 0;
}
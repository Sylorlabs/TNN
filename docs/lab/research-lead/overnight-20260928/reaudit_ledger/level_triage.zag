// level_triage.zag -- LEDGER-REAUDIT.
// Level triage for the canonical ledger. READ-ONLY. Nothing is minted.
//
// QUESTION
//   What is the L0/L1/L2/L2+/L3 distribution of the 393 canonical claim blocks,
//   and is the ledger's central negative result ("L3 achieved anywhere: zero")
//   still true?
//
// This is a TEXT ADJUDICATION over a markdown file, and the rule is stated here
// so it can be argued with. It is deliberately conservative: it reports what the
// ledger *says*, not what the ledger *means*. Where the rule cannot decide, the
// block is reported as UNCLASSIFIED rather than guessed into a bucket.
//
// BLOCK DETECTION
//   The file uses exactly two block-header shapes (this is the same detection
//   lane/recovery used, and it yields 393):
//       "## C<digits>."      and      "- C<digits> ("
//   142 + 251 = 393.
//
// LEVEL ASSERTION (asserts_L<n>)
//   The block contains the token L<n> as a LEVEL, not as part of a longer
//   identifier. Concretely, the two characters before the token are not
//   alphanumeric and the character after the token is not alphanumeric, so
//   "L3-NIV2", "L2+", "L1" match but "L2L", "L2-INTERFERENCE-D" do not.
//   A block may assert more than one level; the HIGHEST asserted level wins,
//   with the order L0 < L1 < L2 < L2+ < L3. A block asserting none is UNCLASSIFIED.
//
// BOUNDING (bounded)
//   The block contains at least one researcher-bounding phrase, i.e. language
//   conceding that the result is a selection over researcher-authored forms
//   rather than an invented one. Fixed list, case-insensitive:
//       researcher, authored, menu, enumerab, template, "not l3", reclassif,
//       "prereg design flaw", "honest negative", "known-limitation",
//       "adversary-qualified", "downgraded"
//
// L3 CHECK
//   L3_ACHIEVED is a block that asserts level L3 AND carries NO bounding phrase.
//   Per brief section 9 an L3 claim is credible only if the novel form itself is
//   not enumerable from source, so the count of L3_ACHIEVED is the number of
//   claims that clear the only L3 bar the program defines.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_cp(b:[]u8,c:i32,s:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n){ b[c+i]=s[i]; i=i+1; }
  return c+n;
}
fn o_ch(b:[]u8,c:i32,x:i32)i32 { b[c]=x as u8; return c+1; }
fn o_tab(b:[]u8,c:i32)i32 { return o_ch(b,c,9); }
fn o_nl(b:[]u8,c:i32)i32 { return o_ch(b,c,10); }
fn eol(b:[]u8,i:i32,n:i32)i32 {
  let j:i32=i;
  while(j<n){ if(b[j]==10){ return j+1; } j=j+1; }
  return n;
}
fn lc(c:i32)i32 {
  let x:i32=c;
  if(x>=65 && x<=90){ x=x+32; }
  return x;
}
fn isdig(c:i32)i32 {
  if(c>=48 && c<=57){ return 1; }
  return 0;
}
fn isalp(c:i32)i32 {
  let x:i32=lc(c);
  if(x>=97 && x<=122){ return 1; }
  if(x>=48 && x<=57){ return 1; }
  if(c==95){ return 1; }
  return 0;
}
// case-insensitive substring test of needle (m chars) in hay[h0 .. h0+hn)
fn has2(hay:[]u8,h0:i32,hn:i32,nd:[]u8,m:i32)i32 {
  if(m>hn){ return 0; }
  let i:i32=0;
  let last:i32=hn-m;
  while(i<=last){
    let k:i32=0; let ok:i32=1;
    while(k<m){
      if(lc(hay[h0+i+k])!=lc(nd[k])){ ok=0; }
      k=k+1;
    }
    if(ok==1){ return 1; }
    i=i+1;
  }
  return 0;
}
// Is position i the start of a block header? Returns 0 if not, else idlen+1
// (idlen = number of digits in the claim id). Multi-return is not available in
// this compiler, so the second value is folded into the first.
fn is_header(b:[]u8,n:i32,i:i32)i32 {
  let L:i32=0;
  if(b[i]==35 && i+1<n && b[i+1]==35 && i+2<n && b[i+2]==32){ L=3; }
  if(L==0 && b[i]==45 && i+1<n && b[i+1]==32){ L=2; }
  if(L==0){ return 0; }
  let j:i32=i+L;
  if(j>=n){ return 0; }
  if(b[j]!=67){ return 0; }            // 'C'
  j=j+1;
  let ds:i32=0;
  while(j<n && isdig(b[j])==1){ j=j+1; ds=ds+1; }
  if(ds<1){ return 0; }
  if(j>=n){ return 0; }
  if(L==3){ if(b[j]!=46){ return 0; } }   // '## C<n>.'
  if(L==2){ if(b[j]!=32){ return 0; } if(j+1>=n || b[j+1]!=40){ return 0; } } // '- C<n> ('
  return ds+1;
}

fn main()i32 {
  let path:[]u8="docs/lab/research-lead/overnight-20260928/canonical_ledger/CLAIM_LEDGER.md";
  let b:[]u8=_zag_read_file(path);
  let n:i32=b.len;
  _zag_print("LEDGER_BYTES "); _zag_println(_zag_i64_to_str(n as i64));

  let out:[]u8=z_alloc(60000);
  let oc:i32=0;
  oc=o_cp(out,oc,"id",2 as i32); oc=o_tab(out,oc);
  oc=o_cp(out,oc,"asserts",7 as i32); oc=o_tab(out,oc);
  oc=o_cp(out,oc,"bounded",7 as i32); oc=o_tab(out,oc);
  oc=o_cp(out,oc,"level",5 as i32); oc=o_nl(out,oc);

  // bounding phrase table: 14 needles, flattened, lengths in bn
  let bp:[]u8="researcherauthoredmenuenumerabtemplatenot l3reclassifprereg design flawhonest negativeknown-limitationadversary-qualifieddowngraded";
  let bn:[]u8=z_alloc(16);
  bn[0]=10; bn[1]=8;  bn[2]=4;  bn[3]=8;  bn[4]=8;  bn[5]=6; bn[6]=9;
  bn[7]=11; bn[8]=18; bn[9]=15; bn[10]=14; bn[11]=19; bn[12]=10; bn[13]=14;
  let bo:[]u8=z_alloc(16);
  bo[0]=0;   bo[1]=10;  bo[2]=18; bo[3]=22; bo[4]=30; bo[5]=38; bo[6]=44;
  bo[7]=53;  bo[8]=64;  bo[9]=82; bo[10]=97; bo[11]=111; bo[12]=130; bo[13]=140;
  // achievement-phrase table: an L3 claim is only credible if it asserts that
  // something was achieved/invented. These are the phrases that would have to
  // appear for an L3 ACHIEVEMENT claim to exist in the ledger at all.
  let ap:[]u8="l3 achievedl3 achievedl3 confirmedl3 establishedl3 provenl3 inventedl3 noveltyachieved at l3";
  let an:[]u8=z_alloc(16);
  an[0]=11; an[1]=13; an[2]=15; an[3]=16; an[4]=11; an[5]=15; an[6]=8;
  let ao:[]u8=z_alloc(16);
  ao[0]=0; ao[1]=11; ao[2]=24; ao[3]=39; ao[4]=55; ao[5]=66; ao[6]=81;

  let nblk:i32=0;
  let lv:i32=0;    // accumulated counts L0..L3, index 0..4
  let c0:i32=0; let c1:i32=0; let c2:i32=0; let c2p:i32=0; let c3:i32=0;
  let uncl:i32=0; let nb:i32=0; let l3ach:i32=0; let l3assert:i32=0;
  let nbound:i32=0; let ach:i32=0;

  let i:i32=0;
  while(i<n){
    let ish:i32=is_header(b,n,i);
    if(ish>0){
      let idl:i32=ish-1;
      let s:i32=i;
      let e:i32=n;
      let j:i32=eol(b,i,n);
      while(j<n){
        let hh:i32=is_header(b,n,j);
        if(hh>0){ e=j; }
        if(e!=n){ break; }
        j=eol(b,j,n);
      }
      let L:i32=e-s;
      // Level tokens are scanned in the block BODY only (after the header line),
      // and a token immediately followed by '-' + UPPERCASE letter is a NAME
      // (L3-NIV2, L2-INTERFERENCE-D, L3-REDTEAM), not a level assertion. Both
      // restrictions are necessary: the claim NAME lives in the header, and the
      // lane names in the body are full of L3-/L2- prefixes that are not claims
      // about level.
      let b0:i32=s;
      while(b0<e){ if(b[b0]==10){ b0=b0+1; } else { break; } }
      let BL:i32=e-b0;
      // level assertion
      let a0:i32=0; let a1:i32=0; let a2:i32=0; let a2p:i32=0; let a3:i32=0;
      let k:i32=1;
      while(k<BL-1){
        let c:i32=b[b0+k] as i32;
        let nx:i32=b[b0+k+1] as i32;
        let pv:i32=0;
        if(k>=2){ pv=b[b0+k-1] as i32; }
        // name-like guard: L<n> followed by '-' then an uppercase letter
        let nameish:i32=0;
        if(k+2<BL){
          let d1:i32=b[b0+k+2] as i32;
          let d2:i32=b[b0+k+3] as i32;
          if(d1==45 && d2>=65 && d2<=90){ nameish=1; }
        }
        if(nameish==0){
          if(c==76 && nx==48){ if(pv==43){ a2p=1; } else { a0=1; } }
          if(c==76 && nx==49){ a1=1; }
          if(c==76 && nx==50){
            if(k+2<BL){ if(b[b0+k+2] as i32==43){ a2p=1; } else { a2=1; } }
            else { a2=1; }
          }
          if(c==76 && nx==51){ a3=1; }
        }
        k=k+1;
      }
      let na:i32=a0+a1+a2+a2p+a3;
      // highest level wins
      let best:i32=-1;
      if(a3==1){ best=4; }
      if(best==-1 && a2p==1){ best=3; }
      if(best==-1 && a2==1){ best=2; }
      if(best==-1 && a1==1){ best=1; }
      if(best==-1 && a0==1){ best=0; }
      // bounded?
      let bnd:i32=0;
      let t2:i32=0;
      while(t2<14){
        let m2:i32=has2(b,b0,BL,bp[bo[t2]..bo[t2]+bn[t2]],bn[t2] as i32);
        if(m2==1){ bnd=1; }
        t2=t2+1;
      }
      nblk=nblk+1;
      if(bnd==1){ nb=nb+1; nbound=nbound+1; }
      if(na>0 && bnd==0){ l3ach=l3ach+1; }
      if(a3==1){ l3assert=l3assert+1; }
      // L3 achievement phrases, whole-ledger detector
      let t3:i32=0;
      while(t3<7){
        let m3:i32=has2(b,s,L,ap[ao[t3]..ao[t3]+an[t3]],an[t3] as i32);
        if(m3==1){ ach=ach+1; }
        t3=t3+1;
      }
      if(best==0){ c0=c0+1; }
      if(best==1){ c1=c1+1; }
      if(best==2){ c2=c2+1; }
      if(best==3){ c2p=c2p+1; }
      if(best==4){ c3=c3+1; }
      if(best<0){ uncl=uncl+1; }

      // id digits
      oc=o_cp(out,oc,"C",1 as i32);
      let q2:i32=0;
      while(q2<idl){ oc=o_cp(out,oc,"",0 as i32); q2=q2+1; }
      oc=o_tab(out,oc);
      oc=o_i32(out,oc,na); oc=o_tab(out,oc);
      oc=o_i32(out,oc,bnd); oc=o_tab(out,oc);
      oc=o_i32(out,oc,best); oc=o_nl(out,oc);
      i=e;
    } else {
      i=i+1;
    }
  }
  _zag_write_file("docs/lab/research-lead/overnight-20260928/reaudit_ledger/level_triage.tsv",out[0..oc]);
  _zag_print("BLOCKS "); _zag_println(_zag_i64_to_str(nblk as i64));
  _zag_print("L0 "); _zag_println(_zag_i64_to_str(c0 as i64));
  _zag_print("L1 "); _zag_println(_zag_i64_to_str(c1 as i64));
  _zag_print("L2 "); _zag_println(_zag_i64_to_str(c2 as i64));
  _zag_print("L2PLUS "); _zag_println(_zag_i64_to_str(c2p as i64));
  _zag_print("L3 "); _zag_println(_zag_i64_to_str(c3 as i64));
  _zag_print("UNCLASSIFIED "); _zag_println(_zag_i64_to_str(uncl as i64));
  _zag_print("BOUNDED_CLAIMS "); _zag_println(_zag_i64_to_str(nbound as i64));
  _zag_print("CLAIMS_ASSERTING_L3 "); _zag_println(_zag_i64_to_str(l3assert as i64));
  _zag_print("L3_ACHIEVEMENT_PHRASES_IN_LEDGER "); _zag_println(_zag_i64_to_str(ach as i64));
  _zag_print("DETECTOR_ARTIFACT_L3TOKEN_UNBOUNDED_BY_14_PHRASE_LIST "); _zag_println(_zag_i64_to_str(l3ach as i64));
  return 0;
}
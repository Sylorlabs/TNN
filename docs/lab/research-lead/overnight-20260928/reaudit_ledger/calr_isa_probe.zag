// isa.zag -- frozen generic ISA for L3-NIV2.
// Basis (frozen, recorded at code freeze): the C281-line 5-op register
// ISA already present in the learner lineage:
//   0=CPY (Rd=Rs), 1=ADD (Rd+=Rs), 2=MUL (Rd*=Rs),
//   3=SET1 (Rd=1), 4=INC (Rd+=1).
// Registers R0..R3 (i32). R0 preloaded with input x. Output is R0.
// Instruction = 3 bytes (op,d,s). Program = flat instruction sequence,
// max 64 instructions (192 bytes); the cap is a resource bound, never
// binding on the battery (required solutions are length 3 to 6).
// ZERO new opcodes, ZERO new semantic cases. Execution semantics are
// ported exactly from the committed
// xdomain_grammar_l2m/glm_learner.zag m_exec (restructured only to keep
// if-nesting at 3 or fewer per the pinned-znc lessons; behavior
// identical: same register updates, same output).

fn ISA_NOP()i32 { return 0; }
fn ISA_MAXLEN()i32 { return 64; }
fn ISA_ERR()i32 { return -2000000000; }

fn isa_exec(prog:[]u8,n:i32,x:i32)i32 {
  let r:[]u8=z_alloc(16);
  put32(r,0,x); put32(r,4,0); put32(r,8,0); put32(r,12,0);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let bad:i32=0;
    if(op<0 || op>4){ bad=1; }
    if(d<0 || d>3){ bad=1; }
    if(s<0 || s>3){ bad=1; }
    if(bad==1){ return -2000000000; }
    let rs:i32=ig(r,s*4);
    let dv:i32=ig(r,d*4);
    let nv:i32=dv;
    if(op==0){ nv=rs; }
    else {
      if(op==1){ nv=dv+rs; }
      else {
        if(op==2){ nv=dv*rs; }
        else {
          if(op==3){ nv=1; }
          else { nv=dv+1; }
        }
      }
    }
    put32(r,d*4,nv);
    k=k+1;
  }
  return ig(r,0);
}
// isa_exec_bytes: execute with ERR sentinel mapped from invalid encodings.
// Returns 1 and sets ov[0..4] on success, 0 on error.
fn isa_run(prog:[]u8,n:i32,x:i32,ov:[]u8)i32 {
  let v:i32=isa_exec(prog,n,x);
  if(v==-2000000000){ return 0; }
  put32(ov,0,v);
  return 1;
}
// prog_cmp: lexicographic byte compare of two programs. Returns -1/0/1.
fn prog_cmp(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  let n:i32=an;
  if(bn<n){ n=bn; }
  let i:i32=0;
  while(i<n){
    let x:i32=a[i] as i32;
    let y:i32=b[i] as i32;
    if(x<y){ return -1; }
    if(x>y){ return 1; }
    i=i+1;
  }
  if(an<bn){ return -1; }
  if(an>bn){ return 1; }
  return 0;
}
// prog_eq: byte equality.
fn prog_eq(a:[]u8,an:i32,b:[]u8,bn:i32)i32 {
  if(an!=bn){ return 0; }
  return prog_cmp(a,an,b,bn)==0;
}
// calr_isa_probe.zag -- LEDGER-REAUDIT.
// Independent empirical check of the CALR alphabet claim.
//
// CLAIM UNDER TEST (lane/restores, extending the lane/recovery C5-claim
// downgrade from 5 claims to all 14, adding C350):
//   l3_novel_intermediate_v2/impl/isa.zag "uses C281's 5 opcodes
//   CPY/ADD/MUL/SET1/INC with ZERO new opcodes" and is therefore L1.
//
// A comment asserting "ZERO new opcodes" is not evidence. This probe loads the
// UNMODIFIED isa.zag (byte-for-byte as restored, sha256
// 409ee8f4b83153a4525ae9d375f405ef6ffa186cf1d80cf63eed06ac45069911), concatenates
// the lane's own prelude for z_alloc/put32/ig, and EXECUTES the interpreter.
//
// It measures four things:
//   A. the exact set of opcodes the interpreter ACCEPTS, found by scanning
//      op = -1..8 and recording which do not return the ERR sentinel;
//   B. the semantic identity of each accepted opcode, by running one-instruction
//      programs with R0=x, Rs=s and checking the resulting R0;
//   C. that out-of-range opcodes are REJECTED, so the alphabet is exactly the
//      accepted set and cannot be silently widened;
//   D. register count: R0..R3 only, i.e. a 4-register machine.
//
// If the claim is true, A must yield exactly {0,1,2,3,4}, B must yield
// CPY/ADD/MUL/SET1/INC on those five, and C must reject -1 and 5.
//
// Byte-identical stdout across 3 runs is required (--rep 3).

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}

fn o_i32(v:i32)void { _zag_println(_zag_i64_to_str(v as i64)); return; }

// one-instruction program: op,d,s
fn mk(op:i32,d:i32,s:i32)[]u8 {
  let p:[]u8=z_alloc(3);
  p[0]=op as u8; p[1]=d as u8; p[2]=s as u8;
  return p;
}
// 7-instruction program that loads Rs(=R1) with 5, then applies `op` to R0
// with Rd=R0, Rs=R1. The ISA has no immediate load other than SET1, so R1 is
// built as SET1 then four INCs. R0 is preloaded with x=7 by isa_exec.
//   [3,1,0] [4,1,0] [4,1,0] [4,1,0] [4,1,0] [op,0,1]
fn mk7(op:i32)[]u8 {
  let p:[]u8=z_alloc(21);
  p[0]=3;  p[1]=1; p[2]=0;
  p[3]=4;  p[4]=1; p[5]=0;
  p[6]=4;  p[7]=1; p[8]=0;
  p[9]=4;  p[10]=1; p[11]=0;
  p[12]=4; p[13]=1; p[14]=0;
  p[15]=op as u8; p[16]=0; p[17]=1;
  p[18]=0; p[19]=0; p[20]=0;
  return p;
}
fn is_err(v:i32)i32 {
  if(v==-2000000000){ return 1; }
  return 0;
}

fn main()i32 {
  _zag_println("CALR_ISA_PROBE");
  let x:i32=7;      // R0 preloaded
  let s:i32=5;      // Rs

  // ---- A. which opcodes are ACCEPTED? scan -1 .. 8
  let acc:[]u8=z_alloc(16);
  let na:i32=0;
  let op:i32=-1;
  while(op<9){
    let v:i32=isa_exec(mk(op,0,1),1,x);
    if(is_err(v)==0){ acc[na]=op as u8; na=na+1; }
    op=op+1;
  }
  _zag_print("A_ACCEPTED_COUNT "); o_i32(na);
  _zag_print("A_ACCEPTED_OPS ");
  let i:i32=0;
  while(i<na){ _zag_print(_zag_i64_to_str(acc[i] as i64)); _zag_print(" "); i=i+1; }
  _zag_println("");

  // ---- B. semantic identity of each accepted opcode.
  // R1 is loaded with 5, R0 starts at x=7, then the opcode under test is applied
  // with Rd=R0 and Rs=R1. Distinct expected values are required, otherwise the
  // test cannot tell the opcodes apart.
  //   0 CPY  R0=Rs      expect 5
  //   1 ADD  R0=R0+Rs   expect 12
  //   2 MUL  R0=R0*Rs   expect 35
  //   3 SET1 R0=1                expect 1
  //   4 INC  R0=R0+1             expect 8
  _zag_print("B_OP0_CPY_R0 ");  o_i32(isa_exec(mk7(0),7,x));
  _zag_print("B_OP1_ADD_R0 ");  o_i32(isa_exec(mk7(1),7,x));
  _zag_print("B_OP2_MUL_R0 ");  o_i32(isa_exec(mk7(2),7,x));
  _zag_print("B_OP3_SET1_R0 "); o_i32(isa_exec(mk7(3),7,x));
  _zag_print("B_OP4_INC_R0 ");  o_i32(isa_exec(mk7(4),7,x));

  // ---- C. out-of-range opcodes must be REJECTED, not clamped or wrapped
  _zag_print("C_OPNEG1_REJECTED "); o_i32(is_err(isa_exec(mk(-1,0,0),1,x)));
  _zag_print("C_OP5_REJECTED ");    o_i32(is_err(isa_exec(mk(5,0,0),1,x)));
  _zag_print("C_OP200_REJECTED ");  o_i32(is_err(isa_exec(mk(200,0,0),1,x)));

  // ---- D. registers: 4 only. Rd=4 or Rs=4 must be rejected.
  _zag_print("D_RD4_REJECTED "); o_i32(is_err(isa_exec(mk(1,4,0),1,x)));
  _zag_print("D_RS4_REJECTED "); o_i32(is_err(isa_exec(mk(1,0,4),1,x)));

  // ---- E. the interpreter is a pure function of (prog, n, x): same inputs,
  //         same output, no hidden state carried between calls.
  let e1:i32=isa_exec(mk(2,1,s),2,x);
  let e2:i32=isa_exec(mk(3,0,0),1,x);
  let e3:i32=isa_exec(mk(2,1,s),2,x);
  let same:i32=0;
  if(e1==e3){ same=1; }
  _zag_print("E_STATELESS_REPEAT_MATCH "); o_i32(same);

  // ---- F. instruction length is fixed at 3 bytes and the cap is a resource
  //         bound only, not part of the semantics.
  _zag_print("F_ISA_MAXLEN "); o_i32(ISA_MAXLEN());
  _zag_print("F_PROG3B_CAP "); o_i32(ISA_MAXLEN()*3);
  return 0;
}
// repexpand.zag -- REPEXPAND-1: representational expansion frontier.
//
// Objective: test the mandatory L3 Criterion 0. The learner must create a
// representational primitive (a new grammar production with runtime-bound
// parameter slots) that is not expressible in the frozen base language L.
//
// Prereg: PREREG_REPEXPAND.md, frozen alone at cb3523684 BEFORE this file
// existed. Kill bars K-RX-1..K-RX-8 are evaluated by this program and
// emitted as RX-BAR lines. The builder reports BUILD-PASS or BUILD-FAIL
// only; no promotion to SURVIVES.
//
// World: episode = observed (spec_sym, n, head[2]) + hidden content runs.
// The learner must predict (s1,l1,s2,l2) exactly.
//
// Frozen base language L: ALT of 1..3 branches; branch = fixed triple
// (c0,c1,c2), ci in 1..8, fixed symbols ('#','a','b'). All counts constant.
// The learner may additionally grow COUPLED nodes (type tag 7, outside
// L's {1,2,3,4}) via the generic residual-relation pipeline. The specific
// relation is data-determined; the researcher never writes a count-coupling
// solution.
//
// Pure Zag. No Python at any stage.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn pe(s:[]u8)void { _zag_print(s); return; }
fn pi(v:i32)void { let t:[]u8=_zag_i64_to_str(v as i64); _zag_print(t); return; }
fn pn()void { _zag_print("\n"); return; }
fn prel(r:i32)void {
  if(r==1){pe("EQ");return;}
  if(r==2){pe("MUL");return;}
  if(r==3){pe("ADD");return;}
  pe("NONE");return;
}

// Canonical diagonal ALT table: ALTSET[92*3], ALTN[92].
// Order: 8 singles, 28 pairs, 56 triples (ascending), for tie-breaking.
fn alt_init(set:[]u8, num:[]u8)void {
  let idx:i32=0;
  let k:i32=1;
  while(k<=8){
    set[idx*3]=k as u8; set[idx*3+1]=0; set[idx*3+2]=0; num[idx]=1; idx=idx+1;
    k=k+1;
  }
  let a:i32=1;
  while(a<=8){
    let b:i32=a+1;
    while(b<=8){
      set[idx*3]=a as u8; set[idx*3+1]=b as u8; set[idx*3+2]=0; num[idx]=2; idx=idx+1;
      b=b+1;
    }
    a=a+1;
  }
  a=1;
  while(a<=8){
    let b2:i32=a+1;
    while(b2<=8){
      let c:i32=b2+1;
      while(c<=8){
        set[idx*3]=a as u8; set[idx*3+1]=b2 as u8; set[idx*3+2]=c as u8; num[idx]=3; idx=idx+1;
        c=c+1;
      }
      b2=b2+1;
    }
    a=a+1;
  }
  return;
}

// Candidate indexing for bestL: 0..7 diagonal singles (k=cand+1),
// 8..99 diagonal ALTs (ai=cand-8). Returns 1 iff candidate predicts E_n.
fn cand_ok(cand:i32, set:[]u8, n:i32)i32 {
  if(cand<8){
    if(cand+1==n){return 1;}
    return 0;
  }
  let ai:i32=cand-8;
  let j:i32=0;
  while(j<3){
    let kk:i32=set[ai*3+j] as i32;
    if(kk!=0 && kk==n){return 1;}
    j=j+1;
  }
  return 0;
}

// Predict with a candidate. out[4] = (ps1,pl1,ps2,pl2). Returns 1 if matched.
fn cand_predict(cand:i32, set:[]u8, spec:i32, n:i32, out:[]u8)i32 {
  if(spec!=35){return 0;}
  if(cand_ok(cand,set,n)==0){return 0;}
  let k:i32=0;
  if(cand<8){k=cand+1;}
  else{
    let ai:i32=cand-8;
    let j:i32=0;
    while(j<3){
      let kk:i32=set[ai*3+j] as i32;
      if(kk==n){k=kk;}
      j=j+1;
    }
  }
  out[0]=97; out[1]=k as u8; out[2]=98; out[3]=k as u8;
  return 1;
}

// Best candidate on seen training ns. Tie-break: fewer branches, lower index
// (candidate order already encodes this; strictly-greater replacement).
fn best_cand(set:[]u8, seen:[]u8, nseen:i32)i32 {
  let best:i32=0;
  let bestsc:i32=-1;
  let cand:i32=0;
  while(cand<100){
    let sc:i32=0;
    let s:i32=0;
    while(s<nseen){
      sc=sc+cand_ok(cand,set,seen[s] as i32);
      s=s+1;
    }
    if(sc>bestsc){bestsc=sc;best=cand;}
    cand=cand+1;
  }
  return best;
}

// K-RX-1: exhaustive max over the 604 canonical L-expressions on E_1..E_12.
fn kx1(set:[]u8)i32 {
  let best:i32=0;
  let si:i32=0;
  while(si<512){
    let c0:i32=si/64+1;
    let c1:i32=(si/8)%8+1;
    let c2:i32=si%8+1;
    let sc:i32=0;
    if(c0==c1 && c1==c2 && c0<=12){sc=1;}
    if(sc>best){best=sc;}
    si=si+1;
  }
  let ai:i32=0;
  while(ai<92){
    let sc:i32=0;
    let j:i32=0;
    while(j<3){
      let kk:i32=set[ai*3+j] as i32;
      if(kk>=1 && kk<=12){sc=sc+1;}
      j=j+1;
    }
    if(sc>best){best=sc;}
    ai=ai+1;
  }
  return best;
}

// Node table nd: 4 slots x 12 bytes:
// [type,src,rel1,c1,rel2,c2,sy1,sy2,ver,status,created,evid]
// rel: 0 none, 1 EQ, 2 MUL, 3 ADD. status: 0 empty, 1 active, 2 retired.
fn node_active(nd:[]u8)i32 {
  let best:i32=-1;
  let bv:i32=-1;
  let i:i32=0;
  while(i<4){
    if((nd[i*12+9] as i32)==1){
      let v:i32=nd[i*12+8] as i32;
      if(v>bv){bv=v;best=i;}
    }
    i=i+1;
  }
  return best;
}
fn apply_rel(rel:i32, c:i32, n:i32)i32 {
  if(rel==1){return n;}
  if(rel==2){return c*n;}
  if(rel==3){return n+c;}
  return -1;
}
fn node_predict(nd:[]u8, ni:i32, n:i32, h0:i32, h1:i32, out:[]u8)void {
  let r1:i32=nd[ni*12+2] as i32;
  let cc1:i32=nd[ni*12+3] as i32;
  let r2:i32=nd[ni*12+4] as i32;
  let cc2:i32=nd[ni*12+5] as i32;
  let sy1:i32=nd[ni*12+6] as i32;
  let sy2:i32=nd[ni*12+7] as i32;
  let s1:i32=h0;
  let s2:i32=h1;
  if(sy1==1){s1=h1;}
  if(sy2==0){s2=h0;}
  out[0]=s1 as u8; out[1]=apply_rel(r1,cc1,n) as u8;
  out[2]=s2 as u8; out[3]=apply_rel(r2,cc2,n) as u8;
  return;
}

// Failure ring fb: 8 entries x 7 bytes [l0,l1,l2,h0,h1,s1,s2].
fn fb_push(fb:[]u8, fc:i32, l0:i32,l1:i32,l2:i32,h0:i32,h1:i32,s1:i32,s2:i32)i32 {
  if(fc<8){
    let o:i32=fc*7;
    fb[o]=l0 as u8; fb[o+1]=l1 as u8; fb[o+2]=l2 as u8;
    fb[o+3]=h0 as u8; fb[o+4]=h1 as u8; fb[o+5]=s1 as u8; fb[o+6]=s2 as u8;
    return fc+1;
  }
  let i:i32=0;
  while(i<49){fb[i]=fb[i+7];i=i+1;}
  let o:i32=49;
  fb[o]=l0 as u8; fb[o+1]=l1 as u8; fb[o+2]=l2 as u8;
  fb[o+3]=h0 as u8; fb[o+4]=h1 as u8; fb[o+5]=s1 as u8; fb[o+6]=s2 as u8;
  return 8;
}

// Relation discovery on one (l0 triple, lj triple). rc[0]=rel, rc[1]=const.
fn find_rel(a0:i32,b0:i32,c0:i32, a1:i32,b1:i32,c1:i32, rc:[]u8)i32 {
  if(a1==a0 && b1==b0 && c1==c0){rc[0]=1;rc[1]=0;return 1;}
  if(a0>0 && b0>0 && c0>0 && a1%a0==0 && b1%b0==0 && c1%c0==0){
    let q:i32=a1/a0;
    if(q>=1 && b1==q*b0 && c1==q*c0){rc[0]=2;rc[1]=q as u8;return 2;}
  }
  let d:i32=a1-a0;
  if(d>=0 && b1-b0==d && c1-c0==d){rc[0]=3;rc[1]=d as u8;return 3;}
  rc[0]=0;rc[1]=0;return 0;
}

// Generic residual-relation search over the last 3 failures.
// out[4] = (rel1,c1,rel2,c2). Returns 1 on full discovery.
fn rel_search(fb:[]u8, fc:i32, out:[]u8)i32 {
  let a:i32=(fc-3)*7;
  let b:i32=(fc-2)*7;
  let c:i32=(fc-1)*7;
  let rc:[]u8=z_alloc(2);
  let r1:i32=find_rel(fb[a] as i32, fb[b] as i32, fb[c] as i32,
                      fb[a+1] as i32, fb[b+1] as i32, fb[c+1] as i32, rc);
  let cc1:i32=rc[1] as i32;
  let r2:i32=find_rel(fb[a] as i32, fb[b] as i32, fb[c] as i32,
                      fb[a+2] as i32, fb[b+2] as i32, fb[c+2] as i32, rc);
  let cc2:i32=rc[1] as i32;
  // Symbol rules: content symbols bind to head positions on all 3.
  let sy:i32=1;
  let t:i32=0;
  while(t<3){
    let e:i32=(fc-3+t)*7;
    if((fb[e+5] as i32)!=(fb[e+3] as i32)){sy=0;}
    if((fb[e+6] as i32)!=(fb[e+4] as i32)){sy=0;}
    t=t+1;
  }
  pe("RX-TRACE SEARCH ok=");
  if(r1!=0 && r2!=0 && sy==1){
    out[0]=r1 as u8; out[1]=cc1 as u8; out[2]=r2 as u8; out[3]=cc2 as u8;
    pe("1 rel1="); prel(r1); pe("("); pi(cc1); pe(") rel2="); prel(r2); pe("("); pi(cc2); pe(") sym=bind"); pn();
    return 1;
  }
  pe("0"); pn();
  return 0;
}

// Reify a discovered relation as a new COUPLED node (type tag 7).
// Retires the currently active node, if any, as superseded.
fn create_node(nd:[]u8, st:[]u8, r1:i32,c1:i32,r2:i32,c2:i32, ep:i32, fb:[]u8, fc:i32)i32 {
  let ni:i32=node_active(nd);
  let nv:i32=1;
  if(ni>=0){
    nv=(nd[ni*12+8] as i32)+1;
    nd[ni*12+9]=2;
    pe("RX-TRACE RETIRE node="); pi(ni);
    pe(" v="); pi(nd[ni*12+8] as i32);
    pe(" ep="); pi(ep);
    pe(" reason=contradicted by=v"); pi(nv); pn();
  }
  let i:i32=0;
  let slot:i32=-1;
  while(i<4){
    if((nd[i*12+9] as i32)==0){slot=i;}
    i=i+1;
  }
  nd[slot*12+0]=7;
  nd[slot*12+1]=0;
  nd[slot*12+2]=r1 as u8; nd[slot*12+3]=c1 as u8;
  nd[slot*12+4]=r2 as u8; nd[slot*12+5]=c2 as u8;
  nd[slot*12+6]=0; nd[slot*12+7]=1;
  nd[slot*12+8]=nv as u8; nd[slot*12+9]=1;
  nd[slot*12+10]=ep as u8; nd[slot*12+11]=3;
  // evidence: the n values of the 3 failures
  let a:i32=(fc-3)*7;
  pe("RX-TRACE CREATE node="); pi(slot);
  pe(" type=COUPLED v="); pi(nv);
  pe(" ep="); pi(ep);
  pe(" evid_ns="); pi(fb[a] as i32); pe(","); pi(fb[a+7] as i32); pe(","); pi(fb[a+14] as i32);
  pe(" rel1="); prel(r1); pe("("); pi(c1); pe(")");
  pe(" rel2="); prel(r2); pe("("); pi(c2); pe(")"); pn();
  st[3]=(st[3] as i32)+1;
  return slot;
}

// Learner state st[16]: [fcount,failcount,reuse,created,rsv,growth,perm,gec,...]
// One episode. Returns 1 on exact prediction. Emits RX-EP and traces.
fn step(nd:[]u8, fb:[]u8, st:[]u8, set:[]u8, seen:[]u8, nseen:i32,
        spec:i32, n:i32, h0:i32, h1:i32,
        ts1:i32, tl1:i32, ts2:i32, tl2:i32,
        phase:[]u8, ep:i32)i32 {
  let ni:i32=node_active(nd);
  let use_node:i32=0;
  let nv:i32=0;
  if(ni>=0){use_node=1;nv=nd[ni*12+8] as i32;}
  let cand:i32=0;
  if(use_node==0){cand=best_cand(set,seen,nseen);}
  let out:[]u8=z_alloc(4);
  let matched:i32=0;
  if(use_node==1){node_predict(nd,ni,n,h0,h1,out);matched=1;}
  else{matched=cand_predict(cand,set,spec,n,out);}
  let ok:i32=0;
  if(matched==1){
    if((out[0] as i32)==ts1 && (out[1] as i32)==tl1 &&
       (out[2] as i32)==ts2 && (out[3] as i32)==tl2){ok=1;}
  }
  pe("RX-EP "); pe(phase); pe(" ep="); pi(ep); pe(" n="); pi(n); pe(" primary=");
  if(use_node==1){pe("NODEv");pi(nv);}else{pe("BESTL");}
  pe(" matched="); pi(matched); pe(" ok="); pi(ok);
  pe(" pred="); pi(out[0] as i32); pe(","); pi(out[1] as i32); pe(","); pi(out[2] as i32); pe(","); pi(out[3] as i32);
  pe(" act="); pi(ts1); pe(","); pi(tl1); pe(","); pi(ts2); pe(","); pi(tl2);
  pn();
  if(ok==1){
    st[1]=0;
    if(use_node==1){st[2]=(st[2] as i32)+1;}
    return 1;
  }
  st[1]=(st[1] as i32)+1;
  let fc:i32=fb_push(fb, st[0] as i32, n, tl1, tl2, h0, h1, ts1, ts2);
  st[0]=fc as u8;
  if((st[1] as i32)==3 && (st[5] as i32)==1 && (st[6] as i32)==1){
    pe("RX-TRACE NOTICE consecutive_failures=3 ep="); pi(ep); pn();
    let ro:[]u8=z_alloc(4);
    if(rel_search(fb, fc, ro)==1){
      create_node(nd, st, ro[0] as i32, ro[1] as i32, ro[2] as i32, ro[3] as i32, ep, fb, fc);
      st[1]=0;
    } else {
      pe("RX-TRACE NOREGULARITY ep="); pi(ep); pn();
    }
  }
  return 0;
}


// AX3 main: menu-exhaustion attack on REPEXPAND-1.
// Calls the verbatim find_rel from the builder's committed source.
// Part A: exhaustive classification over source triples in {1,2,3}^3
// and target triples in {1..6}^3 (5832 calls). Records the outcome
// set as a bitmask over {0,1,2,3} = {NONE,EQ,MUL,ADD}.
// Part B: one explicit witness triple-pair for each of the 9 joint
// cells (r1,r2) in {EQ,MUL,ADD}^2 (both runs non-NONE, as required
// for node creation).

fn main()i32 {
  pe("AX3-HEAD menu-exhaustion attack prereg=de69b8542\n");
  let rc:[]u8=z_alloc(2);
  let mask:i32=0;
  let s0:i32=1;
  while(s0<=3){
    let s1:i32=1;
    while(s1<=3){
      let s2:i32=1;
      while(s2<=3){
        let t0:i32=1;
        while(t0<=6){
          let t1:i32=1;
          while(t1<=6){
            let t2:i32=1;
            while(t2<=6){
              let r:i32=find_rel(s0,s1,s2, t0,t1,t2, rc);
              if(r==0){mask=mask|1;}
              if(r==1){mask=mask|2;}
              if(r==2){mask=mask|4;}
              if(r==3){mask=mask|8;}
              if(r<0 || r>3){mask=mask|16;}
              t2=t2+1;
            }
            t1=t1+1;
          }
          t0=t0+1;
        }
        s2=s2+1;
      }
      s1=s1+1;
    }
    s0=s0+1;
  }
  pe("AX3-ENUM calls=5832 outcome_mask="); pi(mask); pn();
  pe("AX3-NOTE mask bits: 1=NONE 2=EQ 4=MUL 8=ADD 16=OTHER(unknown)\n");

  // Part B: witnesses for the 9 joint cells.
  // Per-run witnesses on source triple (2,3,4):
  //   EQ:      target (2,3,4)
  //   MUL(2):  target (4,6,8)
  //   ADD(1):  target (3,4,5)
  let cells:i32=0;
  let r1:i32=1;
  while(r1<=3){
    let r2:i32=1;
    while(r2<=3){
      let a1:i32=2; let b1:i32=3; let c1:i32=4;
      let a2:i32=2; let b2:i32=3; let c2:i32=4;
      if(r1==2){a1=4;b1=6;c1=8;}
      if(r1==3){a1=3;b1=4;c1=5;}
      if(r2==2){a2=4;b2=6;c2=8;}
      if(r2==3){a2=3;b2=4;c2=5;}
      let o1:i32=find_rel(2,3,4, a1,b1,c1, rc);
      let o2:i32=find_rel(2,3,4, a2,b2,c2, rc);
      pe("AX3-CELL r1="); prel(r1); pe(" r2="); prel(r2);
      pe(" witnessed="); pi(o1); pe(","); pi(o2);
      if(o1==r1 && o2==r2){pe(" YES"); cells=cells+1;} else {pe(" NO");}
      pn();
      r2=r2+1;
    }
    r1=r1+1;
  }
  pe("AX3-SUM cells_reachable="); pi(cells); pe("/9\n");
  pe("AX3-VERDICT outcome_mask="); pi(mask);
  pe(" cells="); pi(cells); pe("/9 verdict=");
  // mask==15 means exactly {NONE,EQ,MUL,ADD} all reachable, no OTHER.
  if(mask==15 && cells==9){
    pe("ATTACK-SUCCEEDS");
  } else {
    pe("ATTACK-FAILS");
  }
  pn();
  return 0;
}

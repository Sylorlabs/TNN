// ddes_multistep.zag -- Adaptive multi-step intervention planner on the
// DDES-integrated continuing learner causal path. Pure Zag. No Python.
// Prereg: PREREG_DDES_MULTISTEP.md (committed strictly before this file).
//
// Extends ddes_integration (DDES-INTEGRATION-PASS f843188ad): entries now
// carry n_cands candidate hypothesis rule graphs (2 or 3) plus a sealed
// true block. MODE=BASE withholds on AMBIGUOUS. MODE=ONESHOT runs the
// original one-shot logic generalized to n candidates (resolves iff
// exactly one survivor). MODE=ADAPT chains: each round recomputes the
// earliest disagreement frontier over the CURRENT SURVIVOR SET (arrival
// computation conditioned on the previous round's real outcome), derives
// one plan, executes once, eliminates mismatches. Terminates on single
// survivor, zero survivors, no-progress round, or BUDGET=3 rounds.
//
// Derivation core provenance (verbatim copies):
//   compute_arrivals, compute_frontier, z_alloc, emit, get32, set32,
//   i64s, e64  -- from ddes/ddes.zag (BUILD-PASS 56db8d606)
//   eff_waits, synthesize_plan_gen, predict_gen, world_step_gen
//   -- from ddes_generalize/ddes_gen.zag (GENERALIZATION-TESTED 843c45fee)
// New: ledger stride 544 with n_cands, frontier_surv (n-candidate
// frontier), oneshot, adapt (round loop + termination guards),
// generalized feed/query, frozen case loaders.

// ============ utils (verbatim from frozen ddes.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ generic arrival computation (verbatim from frozen ddes.zag) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ generic frontier computation (verbatim from frozen ddes.zag) ============
fn compute_frontier(arr0:[]u8, arr1:[]u8, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let v:i32=0;
  while(v<n_vars){
    let a0:i32=get32(arr0, v*4);
    let a1:i32=get32(arr1, v*4);
    if(a0!=a1){
      let t:i32=a0;
      if(a1<t){t=a1;}
      if(t<best_t){
        best_t=t;
        best_v=v;
      }
    }
    v=v+1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ eff_waits (verbatim from frozen ddes_gen.zag; t*=0 soundness repair) ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (verbatim from frozen ddes_gen.zag) ============
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ analytic predictor (verbatim from frozen ddes_gen.zag) ============
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ world stepper (verbatim from frozen ddes_gen.zag) ============
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ continuing-learner causal ledger (new; stride 544) ============
// Entry stride 544 bytes. Per entry at base = e*544:
//   +0 status (0=EMPTY,1=ACTIVE,2=AMBIGUOUS), +4 winner, +8 n_vars,
//   +12 n_cands, +16 rule blocks k=0..3 (128B each: h0,h1,h2,sealed true),
//   +528 rounds_used (set by oneshot/adapt).
// Rule block layout: +0 nr, +4 src[8], +36 dst[8], +68 delay[8].
fn ent_base(e:i32)i32 { return e*544; }
fn blk_base(e:i32, k:i32)i32 { return e*544+16+k*128; }
fn w_get(ws:[]u8, off:i32)i32 { return get32(ws, off); }
fn w_set(ws:[]u8, off:i32, v:i32)void { set32(ws, off, v); return; }

fn copy_block(ws:[]u8, e:i32, from_k:i32, to_k:i32)void {
  let a:i32=blk_base(e,from_k);
  let b:i32=blk_base(e,to_k);
  let i:i32=0;
  while(i<128){ ws[b+i]=ws[a+i]; i=i+1; }
  return;
}
fn blk_src(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+4..b+36];
}
fn blk_dst(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+36..b+68];
}
fn blk_delay(ws:[]u8, e:i32, k:i32)[]u8 {
  let b:i32=blk_base(e,k);
  return ws[b+68..b+100];
}
fn blk_nr(ws:[]u8, e:i32, k:i32)i32 {
  return get32(ws, blk_base(e,k));
}

// ============ n-candidate disagreement frontier (new) ============
// Earliest (schema, var, t) where arrivals are not all equal across the
// survivor set. t = min arrival among survivors at the chosen var.
fn frontier_surv(ws:[]u8, e:i32, surv:[]u8, n_cands:i32, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8, out_schema:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let best_s:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let arrs:[]u8=z_alloc(n_cands*n_vars*4);
    let k:i32=0;
    while(k<n_cands){
      if(get32(surv,k*4)==1){
        let lo:i32=k*n_vars*4;
        let hi:i32=lo+n_vars*4;
        compute_arrivals(blk_nr(ws,e,k), blk_src(ws,e,k), blk_dst(ws,e,k), blk_delay(ws,e,k), n_vars, schema, arrs[lo..hi]);
      }
      k=k+1;
    }
    let v:i32=0;
    while(v<n_vars){
      let all_eq:i32=1;
      let mn:i32=INF;
      let first:i32=1;
      let fv:i32=0;
      k=0;
      while(k<n_cands){
        if(get32(surv,k*4)==1){
          let a:i32=get32(arrs,(k*n_vars+v)*4);
          if(first==1){ fv=a; first=0; } else { if(a!=fv){ all_eq=0; } }
          if(a<mn){ mn=a; }
        }
        k=k+1;
      }
      if(first==0 && all_eq==0){
        if(mn<best_t){ best_t=mn; best_v=v; best_s=schema; }
      }
      v=v+1;
    }
    schema=schema-1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
    set32(out_schema, 0, best_s);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ frozen case loaders (new) ============
fn load_e0(ws:[]u8)void {
  w_set(ws, ent_base(0)+12, 1);
  let b:i32=blk_base(0,0);
  set32(ws,b,2);
  set32(ws,b+4,0); set32(ws,b+8,2);
  set32(ws,b+36,2); set32(ws,b+40,1);
  set32(ws,b+68,2); set32(ws,b+72,0);
  copy_block(ws,0,0,1); copy_block(ws,0,0,3);
  return;
}
fn load_e1(ws:[]u8)void {
  w_set(ws, ent_base(1)+12, 1);
  let b:i32=blk_base(1,0);
  set32(ws,b,1);
  set32(ws,b+4,0);
  set32(ws,b+36,1);
  set32(ws,b+68,3);
  copy_block(ws,1,0,1); copy_block(ws,1,0,3);
  return;
}
fn load_e2(ws:[]u8)void {
  w_set(ws, ent_base(2)+12, 3);
  let b0:i32=blk_base(2,0);
  set32(ws,b0,1);
  set32(ws,b0+4,0);
  set32(ws,b0+36,1);
  set32(ws,b0+68,1);
  let b1:i32=blk_base(2,1);
  set32(ws,b1,1);
  set32(ws,b1+4,0);
  set32(ws,b1+36,1);
  set32(ws,b1+68,2);
  let b2:i32=blk_base(2,2);
  set32(ws,b2,2);
  set32(ws,b2+4,0); set32(ws,b2+8,2);
  set32(ws,b2+36,2); set32(ws,b2+40,1);
  set32(ws,b2+68,2); set32(ws,b2+72,0);
  copy_block(ws,2,2,3);
  return;
}
fn load_e3(ws:[]u8)void {
  w_set(ws, ent_base(3)+12, 3);
  let b0:i32=blk_base(3,0);
  set32(ws,b0,1);
  set32(ws,b0+4,0);
  set32(ws,b0+36,1);
  set32(ws,b0+68,1);
  let b1:i32=blk_base(3,1);
  set32(ws,b1,2);
  set32(ws,b1+4,0); set32(ws,b1+8,2);
  set32(ws,b1+36,2); set32(ws,b1+40,1);
  set32(ws,b1+68,1); set32(ws,b1+72,1);
  let b2:i32=blk_base(3,2);
  set32(ws,b2,2);
  set32(ws,b2+4,0); set32(ws,b2+8,2);
  set32(ws,b2+36,2); set32(ws,b2+40,1);
  set32(ws,b2+68,2); set32(ws,b2+72,0);
  copy_block(ws,3,1,3);
  return;
}
fn load_e4(ws:[]u8)void {
  w_set(ws, ent_base(4)+12, 2);
  let b0:i32=blk_base(4,0);
  set32(ws,b0,1);
  set32(ws,b0+4,0);
  set32(ws,b0+36,1);
  set32(ws,b0+68,1);
  let b1:i32=blk_base(4,1);
  set32(ws,b1,1);
  set32(ws,b1+4,0);
  set32(ws,b1+36,1);
  set32(ws,b1+68,2);
  copy_block(ws,4,1,3);
  return;
}

fn emit_plan(plan:[]u8, plen:i32)void {
  emit("[");
  let j:i32=0;
  while(j<plen){
    let a:i32=plan[j] as i32;
    if(j>0){ emit(","); }
    if(a==0){ emit("S"); }
    else if(a==1){ emit("W"); }
    else { emit("O("); e64(a-2); emit(")"); }
    j=j+1;
  }
  emit("]");
  return;
}

fn emit_survivors(surv:[]u8, nc:i32)void {
  let k:i32=0;
  let first:i32=1;
  while(k<nc){
    if(get32(surv,k*4)==1){
      if(first==0){ emit(","); }
      emit("h"); e64(k);
      first=0;
    }
    k=k+1;
  }
  return;
}

// Execute one plan against the sealed true block (k=3); return real obs.
fn exec_plan(ws:[]u8, e:i32, plan:[]u8, plen:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let st:[]u8=z_alloc(n_vars*8+4);
  let real_obs:i32=-1;
  let j:i32=0;
  while(j<plen){
    let o:i32=world_step_gen(blk_nr(ws,e,3), blk_src(ws,e,3), blk_dst(ws,e,3), blk_delay(ws,e,3), n_vars, st, plan[j] as i32);
    if(o>=0){ real_obs=o; }
    j=j+1;
  }
  return real_obs;
}

fn pred_k(ws:[]u8, e:i32, k:i32, schema:i32, bv:i32, bt:i32)i32 {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  return predict_gen(blk_nr(ws,e,k), blk_src(ws,e,k), blk_dst(ws,e,k), blk_delay(ws,e,k), n_vars, schema, bv, bt);
}

// ============ MODE=ONESHOT: one-shot logic, n candidates (new) ============
fn oneshot(ws:[]u8, e:i32)void {
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let surv:[]u8=z_alloc(nc*4);
  let k:i32=0;
  while(k<nc){ set32(surv,k*4,1); k=k+1; }
  let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
  frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
  if(get32(f,0)==0){
    emit("ONESHOT e"); e64(e); emit(" NO-DISCRIMINATING-PLAN\n");
    return;
  }
  let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
  emit("ONESHOT e"); e64(e); emit(" TARGET V*="); e64(bv);
  emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
  let plans_built:[]u8=z_alloc(4);
  let plan:[]u8=z_alloc(256);
  let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
  emit("ONESHOT e"); e64(e); emit(" PLAN "); emit_plan(plan, plen);
  emit(" built="); e64(get32(plans_built,0)); emit("\n");
  let real_obs:i32=exec_plan(ws, e, plan, plen);
  emit("ONESHOT e"); e64(e); emit(" EXEC real="); e64(real_obs); emit("\n");
  emit("ONESHOT e"); e64(e); emit(" PRED");
  k=0;
  while(k<nc){
    emit(" h"); e64(k); emit("="); e64(pred_k(ws,e,k,bs,bv,bt));
    k=k+1;
  }
  emit("\n");
  let nsv:i32=0; let win:i32=-1;
  k=0;
  while(k<nc){
    emit("ONESHOT e"); e64(e);
    if(pred_k(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); nsv=nsv+1; win=k; }
    else { emit(" ELIM h"); e64(k); emit("\n"); }
    k=k+1;
  }
  w_set(ws, ent_base(e)+528, 1);
  if(nsv==1){
    w_set(ws, ent_base(e), 1);
    w_set(ws, ent_base(e)+4, win);
    emit("ONESHOT e"); e64(e); emit(" RESOLVED winner=h"); e64(win); emit(" rounds=1\n");
  } else {
    emit("ONESHOT e"); e64(e); emit(" ONESHOT-RESOLVE-FAIL survivors="); e64(nsv); emit("\n");
  }
  return;
}

// ============ MODE=ADAPT: chaining planner (new) ============
fn adapt(ws:[]u8, e:i32)void {
  let BUDGET:i32=3;
  let n_vars:i32=w_get(ws, ent_base(e)+8);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let surv:[]u8=z_alloc(nc*4);
  let k:i32=0;
  while(k<nc){ set32(surv,k*4,1); k=k+1; }
  let round:i32=1;
  while(round<=BUDGET){
    let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
    frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
    if(get32(f,0)==0){
      emit("ADAPT e"); e64(e); emit(" ADAPT-RESOLVE-FAIL no-frontier\n");
      return;
    }
    let bv:i32=get32(fv,0); let bt:i32=get32(ft,0); let bs:i32=get32(fs,0);
    emit("ADAPT e"); e64(e); emit(" ROUND "); e64(round); emit(" survivors=[");
    emit_survivors(surv, nc);
    emit("] TARGET V*="); e64(bv); emit(" t*="); e64(bt); emit(" schema="); e64(bs); emit("\n");
    let plans_built:[]u8=z_alloc(4);
    let plan:[]u8=z_alloc(256);
    let plen:i32=synthesize_plan_gen(bv, bt, bs, plan, plans_built);
    emit("ADAPT e"); e64(e); emit(" ROUND "); e64(round); emit(" PLAN ");
    emit_plan(plan, plen);
    emit(" built="); e64(get32(plans_built,0)); emit("\n");
    let real_obs:i32=exec_plan(ws, e, plan, plen);
    emit("ADAPT e"); e64(e); emit(" ROUND "); e64(round); emit(" EXEC real="); e64(real_obs); emit("\n");
    emit("ADAPT e"); e64(e); emit(" ROUND "); e64(round); emit(" PRED");
    k=0;
    while(k<nc){
      if(get32(surv,k*4)==1){
        emit(" h"); e64(k); emit("="); e64(pred_k(ws,e,k,bs,bv,bt));
      }
      k=k+1;
    }
    emit("\n");
    let prev:i32=0;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ prev=prev+1; } k=k+1; }
    k=0;
    while(k<nc){
      if(get32(surv,k*4)==1){
        emit("ADAPT e"); e64(e); emit(" ROUND "); e64(round);
        if(pred_k(ws,e,k,bs,bv,bt)==real_obs){ emit(" SURVIVE h"); e64(k); emit("\n"); }
        else { emit(" ELIM h"); e64(k); emit("\n"); set32(surv,k*4,0); }
      }
      k=k+1;
    }
    let nsv:i32=0; let win:i32=-1;
    k=0;
    while(k<nc){ if(get32(surv,k*4)==1){ nsv=nsv+1; win=k; } k=k+1; }
    w_set(ws, ent_base(e)+528, round);
    if(nsv==1){
      w_set(ws, ent_base(e), 1);
      w_set(ws, ent_base(e)+4, win);
      emit("ADAPT e"); e64(e); emit(" RESOLVED winner=h"); e64(win);
      emit(" rounds="); e64(round); emit("\n");
      return;
    }
    if(nsv==0){
      emit("ADAPT e"); e64(e); emit(" ADAPT-RESOLVE-FAIL world-outside-set\n");
      return;
    }
    if(nsv==prev){
      emit("ADAPT e"); e64(e); emit(" ADAPT-RESOLVE-FAIL no-progress\n");
      return;
    }
    round=round+1;
  }
  emit("ADAPT e"); e64(e); emit(" ADAPT-RESOLVE-FAIL budget\n");
  return;
}

// Feed one experience. All candidates checked against the passive
// observation; all consistent plus a disagreement frontier over the
// candidate set -> AMBIGUOUS. Mode 1 triggers oneshot, mode 2 adapt.
fn feed(ws:[]u8, e:i32, pv:i32, pt:i32, pout:i32, mode:i32)void {
  let n_vars:i32=3;
  w_set(ws, ent_base(e)+8, n_vars);
  let nc:i32=w_get(ws, ent_base(e)+12);
  let all_ok:i32=1;
  let k:i32=0;
  while(k<nc){
    let c:i32=pred_k(ws, e, k, 1, pv, pt);
    if(c!=pout){ all_ok=0; }
    k=k+1;
  }
  emit("FEED e"); e64(e); emit(" nc="); e64(nc);
  emit(" passive=("); e64(pv); emit(","); e64(pt); emit(")="); e64(pout); emit("\n");
  if(all_ok==1){
    let surv:[]u8=z_alloc(nc*4);
    k=0;
    while(k<nc){ set32(surv,k*4,1); k=k+1; }
    let f:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4); let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
    frontier_surv(ws, e, surv, nc, n_vars, f, fv, ft, fs);
    if(get32(f,0)==1){
      w_set(ws, ent_base(e), 2);
      emit("ENTRY e"); e64(e); emit(" AMBIGUOUS cands="); e64(nc); emit("\n");
      if(mode==1){ oneshot(ws, e); }
      else if(mode==2){ adapt(ws, e); }
    } else {
      w_set(ws, ent_base(e), 1);
      w_set(ws, ent_base(e)+4, 0);
      emit("ENTRY e"); e64(e); emit(" ACTIVE winner=h0\n");
    }
  } else {
    emit("ENTRY e"); e64(e); emit(" FEED-ERROR not-all-consistent\n");
  }
  return;
}

// Query the learner. ACTIVE: predict from the resolved hypothesis.
// AMBIGUOUS: withhold. Returns prediction, or -1 on withhold.
fn query(ws:[]u8, e:i32, v:i32, t:i32)i32 {
  let st:i32=w_get(ws, ent_base(e));
  emit("Q e"); e64(e); emit(" ("); e64(v); emit(","); e64(t); emit(") -> ");
  if(st==1){
    let w:i32=w_get(ws, ent_base(e)+4);
    let p:i32=pred_k(ws, e, w, 1, v, t);
    e64(p); emit("\n");
    return p;
  }
  emit("WITHHOLD (ambiguous)\n");
  return -1;
}

fn zero_ledger(ws:[]u8)void {
  let i:i32=0;
  while(i<5*544){ ws[i]=0; i=i+1; }
  return;
}

fn run_all(ws:[]u8, mode:i32)i32 {
  let ok:i32=0;
  let total:i32=0;
  let resolved:i32=0;
  zero_ledger(ws);
  // e0: P1 unambiguous probe.
  load_e0(ws);
  feed(ws, 0, 1, 2, 1, mode);
  let q:i32=query(ws, 0, 1, 2);
  total=total+1; if(q==1){ ok=ok+1; }
  // e1: P2 unambiguous probe.
  load_e1(ws);
  feed(ws, 1, 1, 2, 0, mode);
  q=query(ws, 1, 1, 2);
  total=total+1; if(q==0){ ok=ok+1; }
  q=query(ws, 1, 1, 3);
  total=total+1; if(q==1){ ok=ok+1; }
  // e2: M1 frozen 2-step ambiguity.
  load_e2(ws);
  feed(ws, 2, 1, 2, 1, mode);
  if(mode==0){
    q=query(ws, 2, 1, 1);
    total=total+1; if(q==-1){ ok=ok+1; }
  } else if(mode==1){
    let st:i32=w_get(ws, ent_base(2));
    total=total+1; if(st==2){ ok=ok+1; }
  } else {
    let st:i32=w_get(ws, ent_base(2));
    let w:i32=w_get(ws, ent_base(2)+4);
    let r:i32=w_get(ws, ent_base(2)+528);
    total=total+1; if(st==1 && w==2 && r==2){ ok=ok+1; resolved=resolved+1; }
    q=query(ws, 2, 1, 1);
    total=total+1; if(q==0){ ok=ok+1; }
    q=query(ws, 2, 1, 2);
    total=total+1; if(q==1){ ok=ok+1; }
  }
  // e3: M2 frozen 2-step ambiguity.
  load_e3(ws);
  feed(ws, 3, 1, 2, 1, mode);
  if(mode==0){
    q=query(ws, 3, 1, 1);
    total=total+1; if(q==-1){ ok=ok+1; }
  } else if(mode==1){
    let st:i32=w_get(ws, ent_base(3));
    total=total+1; if(st==2){ ok=ok+1; }
  } else {
    let st:i32=w_get(ws, ent_base(3));
    let w:i32=w_get(ws, ent_base(3)+4);
    let r:i32=w_get(ws, ent_base(3)+528);
    total=total+1; if(st==1 && w==1 && r==2){ ok=ok+1; resolved=resolved+1; }
    q=query(ws, 3, 2, 1);
    total=total+1; if(q==1){ ok=ok+1; }
    q=query(ws, 3, 2, 2);
    total=total+1; if(q==1){ ok=ok+1; }
  }
  // e4: A one-shot regression.
  load_e4(ws);
  feed(ws, 4, 1, 2, 1, mode);
  if(mode==0){
    q=query(ws, 4, 1, 1);
    total=total+1; if(q==-1){ ok=ok+1; }
  } else {
    let st:i32=w_get(ws, ent_base(4));
    let w:i32=w_get(ws, ent_base(4)+4);
    let r:i32=w_get(ws, ent_base(4)+528);
    total=total+1; if(st==1 && w==1 && r==1){ ok=ok+1; resolved=resolved+1; }
    q=query(ws, 4, 1, 1);
    total=total+1; if(q==0){ ok=ok+1; }
    q=query(ws, 4, 1, 2);
    total=total+1; if(q==1){ ok=ok+1; }
  }
  emit("SUMMARY mode=");
  if(mode==0){ emit("BASE"); } else if(mode==1){ emit("ONESHOT"); } else { emit("ADAPT"); }
  emit(" ok="); e64(ok); emit("/");
  e64(total);
  emit(" resolved="); e64(resolved); emit("\n");
  return ok;
}

fn main()i32 {
  let ws:[]u8=z_alloc(8192);
  emit("MODE=BASE\n");
  let ok0:i32=run_all(ws, 0);
  emit("MODE=ONESHOT\n");
  let ok1:i32=run_all(ws, 1);
  emit("MODE=ADAPT\n");
  let ok2:i32=run_all(ws, 2);
  if(ok0<0 || ok1<0 || ok2<0){ return 1; }
  return 0;
}

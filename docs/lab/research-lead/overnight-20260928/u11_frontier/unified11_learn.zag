  emit("\n--- Q2: causal query ---\n");
  let r5:i32=route_line("1,0,0");
  ntest=ntest+1;
  if(r5==4){
    let f:i32=handle_caus_query(W,"1,0,0");
    let q5:[]u8=z_alloc(2);

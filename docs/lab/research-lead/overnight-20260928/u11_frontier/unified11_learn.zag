    emit(" tombstoned=");emit(i32s(tafter-tbefore));
    emit(" active=");emit(i32s(caus_active_count(W,CBASE())));
    emit("\n");
  }

  // ---- K-U2-3a: router ambiguity signals (U-A1) ----

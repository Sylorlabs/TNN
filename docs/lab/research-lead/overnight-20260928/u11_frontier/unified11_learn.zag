  emit("\n--- K-U7-2: handler magnitude rejection ---\n");
  ntest=ntest+1;
  let W7:[]u8=z_alloc(65536);
  world_init(W7);
  let mag_l:i32=handle_caus_learn(W7,"2147483648,0,0>1,2");
  let mag_r:i32=handle_caus_revise(W7,"!99999999999999999999,0,0>1,2");
  let mag_q:i32=handle_caus_query(W7,"2147483648,0,0");
  if(mag_l==0 && mag_r==0 && mag_q==0 &&
     caus_active_count(W7,CBASE())==0){
    emit("K-U7-2 learn/revise 0 commits, query withholds, store empty PASS\n");
    npass=npass+1;
  } else {
    emit("K-U7-2 FAIL mag_l=");emit(i32s(mag_l));
    emit(" mag_r=");emit(i32s(mag_r));
    emit(" mag_q=");emit(i32s(mag_q));
    emit(" active=");emit(i32s(caus_active_count(W7,CBASE())));emit("\n");
  }

  // ---- K-U8-1: significant-digit magnitude validation (H-UNIFIED8 R9) ----
  // X-U7-3 boundary repair: zero-padded runs are judged by significant
  // digits, not raw length. "00000000001" (value 1) must parse cleanly;
  // genuinely overflowing zero-padded runs still return -2.
  emit("\n--- K-U8-1: zero-padded magnitude validation ---\n");
  ntest=ntest+1;
  let z1:[]u8=z_alloc(12);
  let zr1:i32=parse_ints("00000000001",0,11,z1);
  let z2:[]u8=z_alloc(12);
  let zr2:i32=parse_ints("00000000000000000001",0,20,z2);
  let z3:[]u8=z_alloc(12);
  let zr3:i32=parse_ints("0000000000",0,10,z3);
  let z4:[]u8=z_alloc(12);
  let zr4:i32=parse_ints("00000000002147483647",0,20,z4);
  let z5:[]u8=z_alloc(12);
  let zr5:i32=parse_ints("00000000002147483648",0,20,z5);
  if(zr1==0 && get32(z1,0)==1 &&
     zr2==0 && get32(z2,0)==1 &&
     zr3==0 && get32(z3,0)==0 &&
     zr4==0 && get32(z4,0)==2147483647 &&
     zr5==-2){
    emit("K-U8-1 zero-padded runs judged by significant digits PASS\n");
    npass=npass+1;
  } else {
    emit("K-U8-1 FAIL zr1=");emit(i32s(zr1));
    emit(" zr2=");emit(i32s(zr2));
    emit(" zr3=");emit(i32s(zr3));
    emit(" zr4=");emit(i32s(zr4));
    emit(" zr5=");emit(i32s(zr5));emit("\n");
  }

  // ---- K-U11-1: phantom zero-episode tombstone closed (X-U10-2c, H-UNIFIED11 R12) ----
  // Fresh world via world_init. The all-zero episode was refused under U10
  // by phantom zero-init tombstone entries; under R12 it must commit.
  emit("\n--- K-U11-1: phantom tombstone closed (R12) ---\n");
  let WZ:[]u8=z_alloc(65536);
  world_init(WZ);
  ntest=ntest+1;
  let nz:i32=handle_caus_learn(WZ,"0,0,0>0,0");
  let zq:[]u8=z_alloc(2);
  if(nz==1 && get32(WZ, TOMB_N())==0 &&
     cpredict(WZ,CBASE(),0,0,0,zq)==1 && (zq[1] as i32)==0){
    emit("K-U11-1 zero episode stored, no phantom tombstone PASS\n");npass=npass+1;
  } else {
    emit("K-U11-1 FAIL nz=");emit(i32s(nz));
    emit(" tomb=");emit(i32s(get32(WZ, TOMB_N())));emit("\n");
  }

  // ---- K-U11-2: genuine tombstone still refuses (R11b preserved under R12) ----
  // Same WZ: store a real rule, contradict it (quarantine + tombstone), then
  // replay the contradiction. The replay must hit UTOMBSTONE, not quarantine.
  emit("\n--- K-U11-2: genuine tombstone preserved (R12) ---\n");
  ntest=ntest+1;
  let rb11:i32=handle_caus_learn(WZ,"5,0,0>0,1");
  let qz0:i32=get32(WZ, QCOUNT());
  let tz0:i32=get32(WZ, TOMB_N());
  let nc11:i32=handle_caus_learn(WZ,"5,0,0>0,9");
  let nc12:i32=handle_caus_learn(WZ,"5,0,0>0,9");
  let qz1:i32=get32(WZ, QCOUNT());
  let tz1:i32=get32(WZ, TOMB_N());
  if(rb11==1 && nc11==0 && nc12==0 && (qz1-qz0)==1 && (tz1-tz0)==1){
    emit("K-U11-2 genuine tombstone refuses replay PASS\n");npass=npass+1;
  } else {
    emit("K-U11-2 FAIL rb=");emit(i32s(rb11));
    emit(" q1=");emit(i32s(nc11));
    emit(" q2=");emit(i32s(nc12));
    emit(" dq=");emit(i32s(qz1-qz0));
    emit(" dt=");emit(i32s(tz1-tz0));emit("\n");
  }

  emit("\n=== RESULT: ");
  emit(i32s(npass));
  emit("/");
  emit(i32s(ntest));
  emit(" ===\n");
  if(npass==ntest){
    emit("H-UNIFIED11 SURVIVES\n");
    return 0;
  }
  emit("H-UNIFIED11 KILLED\n");
  return 1;
}

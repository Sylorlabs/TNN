// grade_plan.zag - pure-Zag planner grader for CORE-FREEZE-TNN1 evaluation.
// Usage: grade_plan_bin <world.txt> <transcript.txt> <mode>
// mode 0 = W7 (states 9700-9704, markers 9997/9998 rel 623, goal 9704,
//               perturb 9702, rel0 621, rel1 622).
// mode 1 = FW7 (states 36000-36004, markers 36997/36998 rel 36503,
//               goal 36004, perturb 36001, rel0 36501, rel1 36502).
// Extracts the transition table from the world's own OBSERVE events,
// replays the transcript's CHOICE values through the frozen grader
// simulation (state := T(state,c); perturbation OBSERVE resets state),
// and reports per-instance goal visits plus SCORE <n> 4.
// u8-backed cells only. Built with the pinned znc_linux_x86_64_abed8aa1.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn ia(n:i32)[]u8 { return z_alloc(n*4); }
fn ig(a:[]u8, i:i32)i32 {
  let b:i32=i*4;
  return (a[b] as i32)+((a[b+1] as i32)*256)+((a[b+2] as i32)*65536)+((a[b+3] as i32)*16777216);
}
fn is(a:[]u8, i:i32, v:i32)void {
  let b:i32=i*4;
  a[b]=(v & 255) as u8;
  a[b+1]=((v >> 8) & 255) as u8;
  a[b+2]=((v >> 16) & 255) as u8;
  a[b+3]=((v >> 24) & 255) as u8;
  return;
}
fn nio_close(fd:i64)i64 {return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn nio_seek(fd:i64,at:i64,whence:i64)i64 {return _zag_raw_syscall(8,fd,at,whence,0,0,0);}
fn read_whole(path:[]u8)[]u8 {
    let empty:[]u8=z_alloc(1);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(path) as i64,0,0,0,0,0);
    if(fd<0){return empty[0..0];}
    let size:i64=nio_seek(fd,0,2);
    if(size<0 || size>33554431){nio_close(fd);return empty[0..0];}
    if(nio_seek(fd,0,0)!=0){nio_close(fd);return empty[0..0];}
    let buf:[]u8=z_alloc((size as i32)+1);
    if(buf.len==0){nio_close(fd);return empty[0..0];}
    let at:i64=0;
    let calls:i32=0;
    let ok:i32=1;
    while(at<size && calls<4096){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,size-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){ok=0;break;}
        at=at+n;
    }
    nio_close(fd);
    if(ok==0 || at!=size){return empty[0..0];}
    return buf[0..size];
}
fn line_end(d:[]u8,s:i32,n:i32)i32 {
    let e:i32=s;
    while(e<n){if(d[e]==10){return e;}e=e+1;}
    return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
    while(s<e){if(d[s]!=32 && d[s]!=9){return s;}s=s+1;}
    return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
    while(s<e){if(d[s]==32 || d[s]==9 || d[s]==10){return s;}s=s+1;}
    return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
    if(s>=e){return 0;}
    let p:i32=s;
    if(d[p]==45){p=p+1;if(p>=e){return 0;}}
    while(p<e){if(d[p]<48 || d[p]>57){return 0;}p=p+1;}
    return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
    let neg:i32=0;let p:i32=s;let v:i32=0;
    if(d[p]==45){neg=1;p=p+1;}
    while(p<e){v=v*10+(d[p] as i32-48);p=p+1;}
    if(neg==1){v=0-v;}
    return v;
}
fn starts_observe(d:[]u8,s:i32)i32 {
    if(d[s]==79 && d[s+1]==66 && d[s+2]==83 && d[s+3]==69 && d[s+4]==82 && d[s+5]==86 && d[s+6]==69){return 1;}
    return 0;
}
fn starts_act(d:[]u8,s:i32)i32 {
    if(d[s]==65 && d[s+1]==67 && d[s+2]==84){return 1;}
    return 0;
}
fn starts_choice(d:[]u8,s:i32)i32 {
    if(d[s]==67 && d[s+1]==72 && d[s+2]==79 && d[s+3]==73 && d[s+4]==67 && d[s+5]==69){return 1;}
    return 0;
}
// get3 for OBSERVE lines (7-letter keyword). Writes 3 ints into a at idx.
fn oget3(d:[]u8,ls:i32,le:i32,a:[]u8,idx:i32)i32 {
    let f0e:i32=ls+7;
    let s1:i32=skip_ws(d,f0e,le);
    let e1:i32=field_end(d,s1,le);
    let s2:i32=skip_ws(d,e1,le);
    let e2:i32=field_end(d,s2,le);
    let s3:i32=skip_ws(d,e2,le);
    let e3:i32=field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){return 0;}
    if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){return 0;}
    is(a,idx*3,parse_i32(d,s1,e1));
    is(a,idx*3+1,parse_i32(d,s2,e2));
    is(a,idx*3+2,parse_i32(d,s3,e3));
    return 1;
}
// get1 for CHOICE lines (6-letter keyword + one int).
fn cget1(d:[]u8,ls:i32,le:i32,a:[]u8,idx:i32)i32 {
    let f0e:i32=ls+6;
    let s1:i32=skip_ws(d,f0e,le);
    let e1:i32=field_end(d,s1,le);
    if(s1>=le){return 0;}
    if(is_int(d,s1,e1)==0){return 0;}
    is(a,idx,parse_i32(d,s1,e1));
    return 1;
}
fn pstr(s:[]u8)void {_zag_print(s);return;}
fn pi(v:i32)void {_zag_print(_zag_i64_to_str(v as i64));return;}
fn pnl()void {_zag_print("\n");return;}

fn main()i32 {
    if(_zag_argc()!=4){
        _zag_println("usage: grade_plan_bin <world.txt> <transcript.txt> <mode>");
        return 2;
    }
    let wpath:[]u8=_zag_arg(1);
    let tpath:[]u8=_zag_arg(2);
    let modepath:[]u8=_zag_arg(3);
    let mode:i32=0;
    if(modepath.len>0 && modepath[0]==49){mode=1;}
    // per-mode parameters
    let base:i32=9700;
    let rel0:i32=621;
    let rel1:i32=622;
    let m_start:i32=9997;
    let m_pert:i32=9998;
    let mrel:i32=623;
    let goal:i32=9704;
    let pert:i32=9702;
    if(mode==1){
        base=36000;rel0=36501;rel1=36502;
        m_start=36997;m_pert=36998;mrel=36503;
        goal=36004;pert=36001;
    }
    let wd:[]u8=read_whole(wpath);
    let td:[]u8=read_whole(tpath);
    if(wd.len==0 || td.len==0){_zag_println("read failed");return 1;}
    let wn:i32=wd.len as i32;
    let tn:i32=td.len as i32;
    // transition tables indexed by (state-base), 16 slots
    let t0:[]u8=ia(16);
    let t1:[]u8=ia(16);
    // instances: start, acts (max 64 cells: 16 instances x 4 fields)
    let ist:[]u8=ia(64);
    let ninst:i32=0;
    let s:i32=0;
    let obs:[]u8=ia(3);
    while(s<wn){
        let le:i32=line_end(wd,s,wn);
        let f0s:i32=skip_ws(wd,s,le);
        if(f0s<le && le-f0s>=7 && starts_observe(wd,f0s)==1){
            if(oget3(wd,f0s,le,obs,0)==1){
                let os:i32=ig(obs,0);
                let orr:i32=ig(obs,1);
                let ov:i32=ig(obs,2);
                if(orr==rel0 && os>=base && os<base+16){is(t0,os-base,ov);}
                if(orr==rel1 && os>=base && os<base+16){is(t1,os-base,ov);}
                if(os==m_start && orr==mrel && ninst<16){
                    is(ist,ninst*4,ov);
                    is(ist,ninst*4+1,0);
                    is(ist,ninst*4+2,0);
                    ninst=ninst+1;
                }
                if(os==m_pert && orr==mrel && ninst>0){
                    is(ist,(ninst-1)*4+2,ov);
                }
            }
        }
        if(f0s<le && le-f0s>=3 && starts_act(wd,f0s)==1){
            if(ninst>0){
                is(ist,(ninst-1)*4+1,ig(ist,(ninst-1)*4+1)+1);
            }
        }
        s=le+1;
    }
    // transcript CHOICE values
    let ch:[]u8=ia(256);
    let nch:i32=0;
    s=0;
    while(s<tn){
        let le:i32=line_end(td,s,tn);
        let f0s:i32=skip_ws(td,s,le);
        if(f0s<le && le-f0s>=6 && starts_choice(td,f0s)==1){
            if(nch<256 && cget1(td,f0s,le,ch,nch)==1){nch=nch+1;}
        }
        s=le+1;
    }
    // simulate
    let ci:i32=0;
    let win:i32=0;
    let k:i32=0;
    while(k<ninst){
        let st:i32=ig(ist,k*4);
        let acts:i32=ig(ist,k*4+1);
        let pt:i32=ig(ist,k*4+2);
        if(pt==0){pt=pert;}
        let state:i32=st;
        let visited:i32=0;
        let oob:i32=0;
        let a:i32=0;
        while(a<acts){
            if(a==2){state=pt;}
            let c:i32=0;
            if(ci<nch){c=ig(ch,ci);ci=ci+1;}
            if(c==0){
                if(state>=base && state<base+16){state=ig(t0,state-base);}
            } else {
                if(c==1){
                    if(state>=base && state<base+16){state=ig(t1,state-base);}
                } else {
                    oob=oob+1;
                }
            }
            if(state==goal){visited=1;}
            a=a+1;
        }
        pstr("INSTANCE ");pi(k);pstr(" start=");pi(st);
        pstr(" acts=");pi(acts);pstr(" visited=");pi(visited);
        pstr(" oob=");pi(oob);pnl();
        if(visited==1){win=win+1;}
        k=k+1;
    }
    pstr("SCORE ");pi(win);pstr(" ");pi(ninst);pnl();
    return 0;
}

// probe_score.zag - pure-Zag probe scorer for CORE-FREEZE-TNN1 evaluation.
// Usage: probe_score_bin <world.txt> <transcript.txt>
// Joins QUERY (s r e) lines from the world file with ANSWER (s r v) lines
// from the transcript in order. Emits per-probe OK/MISS lines, then
// "SCORE <correct> <total>". No Python, no shell arithmetic in scoring.
// u8-backed cells only (no as *i32 slice casts). Built with the pinned
// znc_linux_x86_64_abed8aa1.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn ia(n:i32)[]u8 { return z_alloc(n*4); }
fn ig(a:[]u8, i:i32)i32 {
  let b:i32=i*4;
  return (a[b] as i32)+((a[b+1] as i32)*256)+((a[b+2] as i32)*65536)+((a[b+3] as i32)*16777216);
}
fn is(a:[]u8, i:i32, v:i32)void {
  let b:i32=i*4;
  a[b]=(v & 255) as u8;
  a[b+1]=((v >> 8) & 255) as u8;
  a[b+2]=((v >> 16) & 255) as u8;
  a[b+3]=((v >> 24) & 255) as u8;
  return;
}
fn nio_close(fd:i64)i64 {return _zag_raw_syscall(3,fd,0,0,0,0,0);}
fn nio_seek(fd:i64,at:i64,whence:i64)i64 {return _zag_raw_syscall(8,fd,at,whence,0,0,0);}
fn read_whole(path:[]u8)[]u8 {
    let empty:[]u8=z_alloc(1);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(path) as i64,0,0,0,0,0);
    if(fd<0){return empty[0..0];}
    let size:i64=nio_seek(fd,0,2);
    if(size<0 || size>33554431){nio_close(fd);return empty[0..0];}
    if(nio_seek(fd,0,0)!=0){nio_close(fd);return empty[0..0];}
    let buf:[]u8=z_alloc((size as i32)+1);
    if(buf.len==0){nio_close(fd);return empty[0..0];}
    let at:i64=0;
    let calls:i32=0;
    let ok:i32=1;
    while(at<size && calls<4096){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+at,size-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){ok=0;break;}
        at=at+n;
    }
    nio_close(fd);
    if(ok==0 || at!=size){return empty[0..0];}
    return buf[0..size];
}

fn line_end(d:[]u8,s:i32,n:i32)i32 {
    let e:i32=s;
    while(e<n){if(d[e]==10){return e;}e=e+1;}
    return n;
}
fn skip_ws(d:[]u8,s:i32,e:i32)i32 {
    while(s<e){if(d[s]!=32 && d[s]!=9){return s;}s=s+1;}
    return e;
}
fn field_end(d:[]u8,s:i32,e:i32)i32 {
    while(s<e){if(d[s]==32 || d[s]==9 || d[s]==10){return s;}s=s+1;}
    return e;
}
fn is_int(d:[]u8,s:i32,e:i32)i32 {
    if(s>=e){return 0;}
    let p:i32=s;
    if(d[p]==45){p=p+1;if(p>=e){return 0;}}
    while(p<e){if(d[p]<48 || d[p]>57){return 0;}p=p+1;}
    return 1;
}
fn parse_i32(d:[]u8,s:i32,e:i32)i32 {
    let neg:i32=0;let p:i32=s;let v:i32=0;
    if(d[p]==45){neg=1;p=p+1;}
    while(p<e){v=v*10+(d[p] as i32-48);p=p+1;}
    if(neg==1){v=0-v;}
    return v;
}
fn starts_query(d:[]u8,s:i32)i32 {
    if(d[s]==81 && d[s+1]==85 && d[s+2]==69 && d[s+3]==82 && d[s+4]==89){return 1;}
    return 0;
}
fn starts_answer(d:[]u8,s:i32)i32 {
    if(d[s]==65 && d[s+1]==78 && d[s+2]==83 && d[s+3]==87 && d[s+4]==69 && d[s+5]==82){return 1;}
    return 0;
}
// Extract three ints from a line starting with a klen-letter keyword into
// u8 cells a at (idx*3 .. idx*3+2). Returns 1 on success, 0 on malformed.
fn get3(d:[]u8,ls:i32,le:i32,klen:i32,a:[]u8,idx:i32)i32 {
    let f0e:i32=ls+klen;
    let s1:i32=skip_ws(d,f0e,le);
    let e1:i32=field_end(d,s1,le);
    let s2:i32=skip_ws(d,e1,le);
    let e2:i32=field_end(d,s2,le);
    let s3:i32=skip_ws(d,e2,le);
    let e3:i32=field_end(d,s3,le);
    if(s1>=le || s2>=le || s3>=le){return 0;}
    if(is_int(d,s1,e1)==0 || is_int(d,s2,e2)==0 || is_int(d,s3,e3)==0){return 0;}
    is(a,idx*3,parse_i32(d,s1,e1));
    is(a,idx*3+1,parse_i32(d,s2,e2));
    is(a,idx*3+2,parse_i32(d,s3,e3));
    return 1;
}
fn pstr(s:[]u8)void {_zag_print(s);return;}
fn pi(v:i32)void {_zag_print(_zag_i64_to_str(v as i64));return;}
fn pnl()void {_zag_print("\n");return;}

fn main()i32 {
    if(_zag_argc()<3 || _zag_argc()>5){
        _zag_println("usage: probe_score_bin <world.txt> <transcript.txt> [lo] [hi]");
        return 2;
    }
    let wpath:[]u8=_zag_arg(1);
    let tpath:[]u8=_zag_arg(2);
    let lo:i32=0;
    let hi:i32=1000000;
    if(_zag_argc()>=4){
        let la:[]u8=_zag_arg(3);
        lo=parse_i32(la,0,la.len as i32);
    }
    if(_zag_argc()>=5){
        let ha:[]u8=_zag_arg(4);
        hi=parse_i32(ha,0,ha.len as i32);
    }
    let wd:[]u8=read_whole(wpath);
    let td:[]u8=read_whole(tpath);
    if(wd.len==0 || td.len==0){
        _zag_println("read failed");
        return 1;
    }
    let wn:i32=wd.len as i32;
    let tn:i32=td.len as i32;
    let q:[]u8=ia(4096*3);
    let an:[]u8=ia(4096*3);
    if(q.len==0 || an.len==0){_zag_println("alloc failed");return 1;}
    let nq:i32=0;
    let s:i32=0;
    while(s<wn){
        let le:i32=line_end(wd,s,wn);
        let f0s:i32=skip_ws(wd,s,le);
        if(f0s<le && le-f0s>=5 && starts_query(wd,f0s)==1){
            if(nq<4096 && get3(wd,f0s,le,5,q,nq)==1){nq=nq+1;}
        }
        s=le+1;
    }
    let na:i32=0;
    s=0;
    while(s<tn){
        let le:i32=line_end(td,s,tn);
        let f0s:i32=skip_ws(td,s,le);
        if(f0s<le && le-f0s>=6 && starts_answer(td,f0s)==1){
            if(na<4096 && get3(td,f0s,le,6,an,na)==1){na=na+1;}
        }
        s=le+1;
    }
    let correct:i32=0;
    let total:i32=0;
    let i:i32=0;
    while(i<nq){
        if(i>=lo && i<hi){
            total=total+1;
            if(i<na && ig(q,i*3)==ig(an,i*3) && ig(q,i*3+1)==ig(an,i*3+1)){
                if(ig(q,i*3+2)==ig(an,i*3+2)){
                    pstr("OK ");pi(i);pstr(" ");pi(ig(q,i*3));pstr(" ");pi(ig(q,i*3+1));pnl();
                    correct=correct+1;
                } else {
                    pstr("MISS ");pi(i);pstr(" ");pi(ig(q,i*3));pstr(" ");pi(ig(q,i*3+1));
                    pstr(" expected=");pi(ig(q,i*3+2));pstr(" got=");pi(ig(an,i*3+2));pnl();
                }
            } else {
                pstr("ORDER-MISMATCH ");pi(i);pnl();
            }
        }
        i=i+1;
    }
    pstr("SCORE ");pi(correct);pstr(" ");pi(total);pnl();
    return 0;
}

// extn_driver.zag -- L2-EXTENDN-1 battery driver (arms E1 E2 E3 C1 C2 A1).
// Each arm runs on a fresh tnn2_init workspace. The driver asserts
// the frozen prereg constants and emits ARM <name> PASS/FAIL.

fn extn_freshW()[]u8 {
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  return W;
}

// World facts. full=1 teaches (105,2,106); full=0 omits it (E3).
// (107,2,108) is the overshoot decoy; the last three are
// off-frontier distractors.
fn extn_world(W:[]u8,full:i32)void {
  ev_teach(W,101,1,102);
  ev_teach(W,102,1,103);
  ev_teach(W,103,1,104);
  ev_teach(W,104,2,105);
  if(full==1){ ev_teach(W,105,2,106); }
  ev_teach(W,106,2,107);
  ev_teach(W,107,2,108);
  ev_teach(W,201,1,202);
  ev_teach(W,202,1,203);
  ev_teach(W,301,9,309);
  return;
}

// relation-sequence buffer [a,b,c,d,e,f].
fn extn_mkseq(a:i32,b:i32,c:i32,d:i32,e:i32,f:i32)[]u8 {
  let q:[]u8=z_alloc(32);
  set32(q,0,a); set32(q,4,b); set32(q,8,c);
  set32(q,12,d); set32(q,16,e); set32(q,20,f);
  return q;
}

fn extn_report(name:[]u8,ans:i32,ext:i32,stop:i32,pass:i32,allocs:i32)i32 {
  emit("ARM "); emit(name);
  emit(" ans="); e64(ans); emit(" ext="); e64(ext);
  emit(" stop="); e64(stop); emit(" allocs="); e64(allocs);
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

// E1: need-6. ans=107 ext=3 stop=TERM relseq [1,1,1,2,2,2].
fn arm_e1()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,1);
  let m0:i32=extn_mk_native(W,101,extn_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(12);
  let ans:i32=extn_extend_iter(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=107){ pass=0; }
  if(ext!=3){ pass=0; }
  if(stop!=0){ pass=0; }
  if(extn_relseq_eq(W,fin,extn_mkseq(1,1,1,2,2,2),6)!=1){ pass=0; }
  if(extn_hops_to_native(W,fin)!=3){ pass=0; }
  if(extn_ult_native(W,fin)!=m0){ pass=0; }
  return extn_report("E1",ans,ext,stop,pass,hg(W,20));
}

// E2: need-5. ans=106 ext=2 stop=TERM relseq [1,1,1,2,2].
fn arm_e2()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,1);
  let m0:i32=extn_mk_native(W,101,extn_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(12);
  let ans:i32=extn_extend_iter(W,101,106,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=106){ pass=0; }
  if(ext!=2){ pass=0; }
  if(stop!=0){ pass=0; }
  if(extn_relseq_eq(W,fin,extn_mkseq(1,1,1,2,2,0),5)!=1){ pass=0; }
  if(extn_hops_to_native(W,fin)!=2){ pass=0; }
  if(extn_ult_native(W,fin)!=m0){ pass=0; }
  return extn_report("E2",ans,ext,stop,pass,hg(W,20));
}

// E3: need-6 with (105,2,106) missing. ans=105 ext=1 stop=NOFRONTIER.
fn arm_e3()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,0);
  let m0:i32=extn_mk_native(W,101,extn_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(12);
  let ans:i32=extn_extend_iter(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=105){ pass=0; }
  if(ext!=1){ pass=0; }
  if(stop!=1){ pass=0; }
  if(extn_relseq_eq(W,fin,extn_mkseq(1,1,1,2,0,0),4)!=1){ pass=0; }
  if(extn_hops_to_native(W,fin)!=1){ pass=0; }
  if(extn_ult_native(W,fin)!=m0){ pass=0; }
  return extn_report("E3",ans,ext,stop,pass,hg(W,20));
}

// C1: EXTEND-ONE control. ans=-3, exactly 1 adapted MAP [1,1,1,2]
// with type-16 parent m0.
fn arm_c1()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,1);
  let m0:i32=extn_mk_native(W,101,extn_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(12);
  let ans:i32=extn_ctrl_one(W,101,107,out);
  let nmk:i32=get32(out,0);
  let best:i32=get32(out,4);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=-3){ pass=0; }
  if(nmk!=1){ pass=0; }
  if(extn_count_adapted(W)!=1){ pass=0; }
  if(extn_relseq_eq(W,best,extn_mkseq(1,1,1,2,0,0),4)!=1){ pass=0; }
  if(extn_src16(W,best)!=m0){ pass=0; }
  emit("ARM C1 ans="); e64(ans); emit(" nmk="); e64(nmk);
  emit(" allocs="); e64(hg(W,20));
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

// C2: fresh learner, no m. Generic t2_trial must return -2.
fn arm_c2()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,1);
  let ans:i32=extn_ctrl_fresh(W,101,107);
  let pass:i32=1;
  if(ans!=-2){ pass=0; }
  emit("ARM C2 ans="); e64(ans); emit(" allocs="); e64(hg(W,20));
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

// A1: no-TERM-rule ablation. Overshoot: ans=108 ext=4 stop=NOFRONTIER,
// final relseq [1,1,1,2,2,2,2].
fn arm_a1()i32 {
  let W:[]u8=extn_freshW();
  extn_world(W,1);
  let m0:i32=extn_mk_native(W,101,extn_mkseq(1,1,1,0,0,0),3);
  let out:[]u8=z_alloc(12);
  let ans:i32=extn_extend_iter_norule(W,101,107,out);
  let ext:i32=get32(out,0);
  let stop:i32=get32(out,4);
  let fin:i32=get32(out,8);
  let pass:i32=1;
  if(m0<0){ pass=0; }
  if(ans!=108){ pass=0; }
  if(ext!=4){ pass=0; }
  if(stop!=1){ pass=0; }
  let exp7:[]u8=z_alloc(32);
  set32(exp7,0,1); set32(exp7,4,1); set32(exp7,8,1); set32(exp7,12,2);
  set32(exp7,16,2); set32(exp7,20,2); set32(exp7,24,2);
  if(extn_relseq_eq(W,fin,exp7,7)!=1){ pass=0; }
  if(extn_hops_to_native(W,fin)!=4){ pass=0; }
  if(extn_ult_native(W,fin)!=m0){ pass=0; }
  return extn_report("A1",ans,ext,stop,pass,hg(W,20));
}

fn main()i32 {
  emit("EXTN-BATTERY-START\n");
  let p:i32=0;
  p=p+arm_e1();
  p=p+arm_e2();
  p=p+arm_e3();
  p=p+arm_c1();
  p=p+arm_c2();
  p=p+arm_a1();
  emit("EXTN-SUMMARY pass="); e64(p); emit("/6\n");
  if(p==6){ return 0; }
  return 1;
}

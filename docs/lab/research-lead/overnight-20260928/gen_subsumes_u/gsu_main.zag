// gsu_main.zag -- GEN-SUBSUMES-U driver (the only new code in this lane).
// Runs GEN (gen_solve) on U's 5 linear pipeline pairs plus honest-failure,
// fresh-learner, and sequential-growth arms. Opaque integer identifiers
// only; no domain labels.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=gen_solve(A1,B,c,61,1,1,65,2);
  c=gen_report(A1,B,c,"GEN","P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=gen_solve(A2,B,c,41,1,2,2,4);
  c=gen_report(A2,B,c,"GEN","P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=gen_solve(A3,B,c,41,1,2,2,4);
  c=gen_report(A3,B,c,"GEN","P2b");
  c=gen_census(A3,B,c,4);
  setup_p5extra(A3);
  c=gen_solve(A3,B,c,51,1,2,3,4);
  c=gen_report(A3,B,c,"GEN","P5");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=gen_solve(A4,B,c,31,1,2,2,4);
  c=gen_report(A4,B,c,"GEN","P3");
  let A5:[]u8=world_new();
  setup_p5facts(A5);
  setup_p5taught(A5);
  c=gen_solve(A5,B,c,205,1,2,1,4);
  c=gen_report(A5,B,c,"GEN","Q1");
  let A6:[]u8=world_new();
  setup_p5facts(A6);
  setup_p5abx(A6);
  c=gen_solve(A6,B,c,205,1,2,1,3);
  c=gen_report(A6,B,c,"GEN","Q2");
  let A7:[]u8=world_new();
  setup_p5facts(A7);
  setup_p5aby(A7);
  c=gen_solve(A7,B,c,205,1,2,1,3);
  c=gen_report(A7,B,c,"GEN","Q3");
  let A8:[]u8=world_new();
  setup_p5facts(A8);
  setup_p5fresh(A8);
  c=gen_solve(A8,B,c,205,1,2,1,4);
  c=gen_report(A8,B,c,"GEN","Q4");
  o_flush(B,c);
  return 0;
}

// pair5_new.zag -- 5th domain pair: spatial-layout x task-scheduling.
// NEW CODE (frozen PREREG Sec 3-4). Contains ONLY: world facts (fact_add),
// MAP inventory (map_new), teaching calls (teach), and main. No changes to
// admission, execution, widening, recording, or contract logic; no new
// behavior classes; no new opcodes; no relation-conditional branches.
// Domain X (spatial layout): worker -> team via WALK on rel 91 (member-of).
// Domain Y (task scheduling): team -> pending-task count via COUNT on rel 92.
// Composition Z: pending task-load of worker w's team = Y(X(w)).

fn setup_p5facts(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,202,91,211);
  fact_add(A,203,91,212); fact_add(A,204,91,212);
  fact_add(A,205,91,213); fact_add(A,206,91,213);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  fact_add(A,212,92,904); fact_add(A,212,92,905);
  fact_add(A,213,92,906);
  fact_add(A,211,93,221); fact_add(A,212,93,221); fact_add(A,213,93,222);
  fact_add(A,221,93,221); fact_add(A,222,93,222);
  return;
}
fn setup_p5taught(A:[]u8)void {
  map_new(A,0,0,91,0);
  map_new(A,1,1,92,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  teach(A,0,201,211); teach(A,0,203,212);
  teach(A,1,211,3); teach(A,1,212,2);
  teach(A,2,201,201);
  teach(A,3,211,221); teach(A,3,212,221);
  return;
}
fn setup_p5abx(A:[]u8)void {
  map_new(A,0,1,92,0);
  map_new(A,1,3,0,0);
  map_new(A,2,0,93,0);
  teach(A,0,211,3); teach(A,0,212,2);
  teach(A,1,201,201);
  teach(A,2,211,221); teach(A,2,212,221);
  return;
}
fn setup_p5aby(A:[]u8)void {
  map_new(A,0,0,91,0);
  map_new(A,1,3,0,0);
  map_new(A,2,0,93,0);
  teach(A,0,201,211); teach(A,0,203,212);
  teach(A,1,201,201);
  teach(A,2,211,221); teach(A,2,212,221);
  return;
}
fn setup_p5fresh(A:[]u8)void {
  map_new(A,0,0,91,0);
  map_new(A,1,1,92,0);
  map_new(A,2,3,0,0);
  map_new(A,3,0,93,0);
  return;
}

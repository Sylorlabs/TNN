// rt_driver_main.zag -- Invention H3 red-team driver (adversarial).
//
// Attacks the frozen mechanism in rt_mech.zag (byte-identical copy of
// invention_constraint/invent_patch.zag) on top of the frozen base.
// The mechanism is NEVER modified; only worlds and constraints are new.
//
// Attack 1: constraint underdetermination. Many equally valid forms;
//   does the mechanism return the first DFS hit with no quality
//   criterion? Does teach order decide the invented form? Does a
//   verify-fail on the first hit end the search?
// Attack 2: contradictory constraints. Terminate or thrash?
// Attack 4: constraint smuggling. Count ALL constraint-satisfying fact
//   sequences in the exact H3 worlds. If the count is 1, the researcher
//   who wrote the constraints did the inventing; the DFS walked a
//   forced path.
// Attack 5: fact poisoning. A degenerate (stuttering) chain taught first
//   satisfies constraints and verifies; is it promoted? Plus: first_lit
//   is invisible to the search (harness-only enforcement).

// ---- red-team helpers (new, unfrozen) ----
fn rt_mod(a:i32,b:i32)i32 {
  let r:i32=a;
  while(r>=b){r=r-b;}
  return r;
}
fn rt_mkC(plen:i32,re_r:i32,re_n:i32,first_rel:i32,last_rel:i32,first_lit:i32)[]u8 {
  let C:[]u8=z_alloc(24);
  set32(C,0,plen); set32(C,4,re_r); set32(C,8,re_n);
  set32(C,12,first_rel); set32(C,16,last_rel); set32(C,20,first_lit);
  return C;
}
fn rt_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// Walk a promoted chain like invent_relseq, but collect the licensing
// fact ids (which fact node licensed each step).
fn rt_factids(W:[]u8,m:i32,ids:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(n>=maxn){return -1;}
      set32(ids,n*4,fact);
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}
fn rt_print_factids(W:[]u8,m:i32)void {
  let ids:[]u8=z_alloc(32);
  let len:i32=rt_factids(W,m,ids,8);
  emit("factids=[");
  let i:i32=0;
  while(i<len){if(i>0){emit(",");} e64(get32(ids,i*4)); i=i+1;}
  emit("] n="); e64(len); emit("\n");
  return;
}
// Print the value sequence v[0..plen] of promoted MAP m.
fn rt_print_vals(W:[]u8,m:i32)void {
  let ids:[]u8=z_alloc(32);
  let len:i32=rt_factids(W,m,ids,8);
  emit("vals=["); e64(ng(W,m,8));
  let i:i32=0;
  while(i<len){emit(","); e64(ng(W,get32(ids,i*4),28)); i=i+1;}
  emit("]\n");
  return;
}
fn rt_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=invent_relseq(W,m,seq,7);
  emit("relse q=[");
  let i:i32=0;
  while(i<len){if(i>0){emit(",");} e64(get32(seq,i*4)); i=i+1;}
  emit("] len="); e64(len); emit("\n");
  return;
}
fn rt_wcopy(dst:[]u8,src:[]u8,n:i32)void {
  let i:i32=0;
  while(i<n){set32(dst,i,get32(src,i)); i=i+4;}
  return;
}

// ---- rt_count: faithful counting mirror of the frozen invent_dfs ----
// Same candidate order (invent_fact_next over node ids), same pruning
// (first_rel, last_rel, rel_exact reachability), same traversal. Does
// NOT stop at the first hit: enumerates every satisfying sequence.
// stats: [0]=nseq [1]=backtracks [2]=visits [3]=prunes
//        [4]=visits_at_first_hit [5]=backtracks_at_first_hit
// Records the first maxrec sequences into rec_ov/rec_of (stride 32).
fn rt_count(W:[]u8,s:i32,C:[]u8,stats:[]u8,rec_ov:[]u8,rec_of:[]u8,maxrec:i32)i32 {
  let plen:i32=get32(C,0);
  let re_r:i32=get32(C,4);
  let re_n:i32=get32(C,8);
  let first_rel:i32=get32(C,12);
  let last_rel:i32=get32(C,16);
  let cap:i32=8;
  let curval:[]u8=z_alloc(32);
  let factid:[]u8=z_alloc(32);
  let nextid:[]u8=z_alloc(32);
  let relcnt:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(nextid,0,1);
  set32(relcnt,0,0);
  let pos:i32=0;
  let nseq:i32=0;
  let nbk:i32=0;
  let nvis:i32=0;
  let npr:i32=0;
  let vfirst:i32=-1;
  let bfirst:i32=-1;
  while(pos>=0){
    if(pos>=plen || pos>=cap){
      if(pos==plen){
        let ok:i32=1;
        if(re_r>=0 && get32(relcnt,pos*4)!=re_n){ok=0;}
        if(ok==1){
          if(nseq<maxrec){
            let i:i32=0;
            while(i<=plen){set32(rec_ov,nseq*32+i*4,get32(curval,i*4)); i=i+1;}
            i=0;
            while(i<plen){set32(rec_of,nseq*32+i*4,get32(factid,i*4)); i=i+1;}
          }
          if(nseq==0){vfirst=nvis; bfirst=nbk;}
          nseq=nseq+1;
        }
        pos=pos-1; nbk=nbk+1;
      } else {
        pos=pos-1; nbk=nbk+1;
      }
    } else {
      let cv:i32=get32(curval,pos*4);
      let fid:i32=invent_fact_next(W,cv,get32(nextid,pos*4));
      if(fid<0){
        pos=pos-1; nbk=nbk+1;
      } else {
        set32(nextid,pos*4,fid);
        nvis=nvis+1;
        let fr:i32=ng(W,fid,24);
        let ok:i32=1;
        if(first_rel>=0 && pos==0 && fr!=first_rel){ok=0;}
        if(last_rel>=0 && pos==plen-1 && fr!=last_rel){ok=0;}
        let newcnt:i32=get32(relcnt,pos*4);
        if(re_r>=0){
          if(fr==re_r){newcnt=newcnt+1;}
          if(newcnt>re_n){ok=0;}
          if(newcnt+(plen-1-pos)<re_n){ok=0;}
        }
        if(ok==0){npr=npr+1;}
        if(ok==1){
          set32(relcnt,(pos+1)*4,newcnt);
          set32(factid,pos*4,fid);
          set32(curval,(pos+1)*4,ng(W,fid,28));
          set32(nextid,(pos+1)*4,1);
          pos=pos+1;
        }
      }
    }
  }
  set32(stats,0,nseq); set32(stats,4,nbk); set32(stats,8,nvis);
  set32(stats,12,npr); set32(stats,16,vfirst); set32(stats,20,bfirst);
  return nseq;
}
// Verify recorded sequence idx by assembling it in a scratch copy of W
// and executing. Returns 1 iff it produces expected.
fn rt_verify_rec(W:[]u8,wlen:i32,s:i32,expected:i32,rec_ov:[]u8,rec_of:[]u8,idx:i32,plen:i32)i32 {
  let W2:[]u8=z_alloc(wlen);
  rt_wcopy(W2,W,wlen);
  let ov:[]u8=z_alloc(32);
  let rf:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<=plen){set32(ov,i*4,get32(rec_ov,idx*32+i*4)); i=i+1;}
  i=0;
  while(i<plen){set32(rf,i*4,get32(rec_of,idx*32+i*4)); i=i+1;}
  let root:i32=t2_asm_chain(W2,ov,plen+1,rf);
  if(root<0){return 0;}
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W2,root,s,expected,0,cst);
  if(v2==-2){return 0;}
  return 1;
}
// Count + verify + report for one world. Cross-validation hook: prints
// seq#1 fact ids so the caller can compare against the real invent_try
// winner (proves the mirror is faithful).
fn rt_count_report(W:[]u8,wlen:i32,s:i32,plen:i32,expected:i32,C:[]u8,lbl:[]u8)void {
  let stats:[]u8=z_alloc(24);
  let rec_ov:[]u8=z_alloc(256);
  let rec_of:[]u8=z_alloc(256);
  let n:i32=rt_count(W,s,C,stats,rec_ov,rec_of,8);
  emit(lbl); emit(" nseq="); e64(n);
  emit(" bk="); e64(get32(stats,4));
  emit(" visits="); e64(get32(stats,8));
  emit(" prunes="); e64(get32(stats,12));
  emit(" vfirst="); e64(get32(stats,16));
  emit(" bfirst="); e64(get32(stats,20)); emit("\n");
  let nv:i32=0;
  let i:i32=0;
  while(i<n && i<8){
    if(rt_verify_rec(W,wlen,s,expected,rec_ov,rec_of,i,plen)==1){nv=nv+1;}
    i=i+1;
  }
  emit(lbl); emit(" verifying="); e64(nv); emit(" of "); e64(n); emit("\n");
  emit(lbl); emit(" seq1 factids=[");
  i=0;
  while(i<plen){if(i>0){emit(",");} e64(get32(rec_of,i*4)); i=i+1;}
  emit("]\n");
  return;
}

// ---- ATTACK 1: constraint underdetermination ----
// Four parallel length-3 chains from 1000, all ending at 2000, all with
// relseq [3,7,5]. Weak constraints (plen=3, first_lit=1000 only): every
// chain satisfies them and verifies. The mechanism must pick one. Which
// one, and why? Then: same fact SET, reverse teach order.
fn rt_attack1()void {
  emit("=== ATTACK 1: underdetermination / first-hit-wins ===\n");
  // A1a: forward teach order
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let f00:i32=ev_teach(W,1000,3,1100);
  let f01:i32=ev_teach(W,1100,7,1200);
  let f02:i32=ev_teach(W,1200,5,2000);
  let f10:i32=ev_teach(W,1000,3,1101);
  let f11:i32=ev_teach(W,1101,7,1201);
  let f12:i32=ev_teach(W,1201,5,2000);
  let f20:i32=ev_teach(W,1000,3,1102);
  let f21:i32=ev_teach(W,1102,7,1202);
  let f22:i32=ev_teach(W,1202,5,2000);
  let f30:i32=ev_teach(W,1000,3,1103);
  let f31:i32=ev_teach(W,1103,7,1203);
  let f32:i32=ev_teach(W,1203,5,2000);
  let C:[]u8=rt_mkC(3,-1,-1,-1,-1,1000);
  rt_count_report(W,110656,1000,3,2000,C,"A1a count");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=invent_try(W,1000,70,2000,0,C,st);
  emit("A1a invent_try ans="); e64(ans); emit("\n");
  let m:i32=rt_find_map(W,1000,70);
  emit("A1a check="); e64(invent_check(W,m,C)); emit("\n");
  if(m>=0){rt_print_vals(W,m); rt_print_factids(W,m);}
  emit("A1a chain0 facts="); e64(f00); emit(","); e64(f01); emit(","); e64(f02); emit("\n");
  emit("A1a chain3 facts="); e64(f30); emit(","); e64(f31); emit(","); e64(f32); emit("\n");
  // A1r: SAME fact set, reverse teach order
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let g30:i32=ev_teach(W2,1000,3,1103);
  let g31:i32=ev_teach(W2,1103,7,1203);
  let g32:i32=ev_teach(W2,1203,5,2000);
  let g20:i32=ev_teach(W2,1000,3,1102);
  let g21:i32=ev_teach(W2,1102,7,1202);
  let g22:i32=ev_teach(W2,1202,5,2000);
  let g10:i32=ev_teach(W2,1000,3,1101);
  let g11:i32=ev_teach(W2,1101,7,1201);
  let g12:i32=ev_teach(W2,1201,5,2000);
  let g00:i32=ev_teach(W2,1000,3,1100);
  let g01:i32=ev_teach(W2,1100,7,1200);
  let g02:i32=ev_teach(W2,1200,5,2000);
  let st2:[]u8=z_alloc(8); set32(st2,0,0); set32(st2,4,0);
  let ans2:i32=invent_try(W2,1000,70,2000,0,C,st2);
  emit("A1r invent_try ans="); e64(ans2); emit("\n");
  let m2:i32=rt_find_map(W2,1000,70);
  emit("A1r check="); e64(invent_check(W2,m2,C)); emit("\n");
  if(m2>=0){rt_print_vals(W2,m2); rt_print_factids(W2,m2);}
  emit("A1r chain3 facts="); e64(g30); emit(","); e64(g31); emit(","); e64(g32); emit("\n");
  emit("A1r chain0 facts="); e64(g00); emit(","); e64(g01); emit(","); e64(g02); emit("\n");
  // A1b: first DFS hit FAILS verification; a later chain would verify.
  // invent_try must return -2 (no continued search) even though a
  // verifying chain exists.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  ev_teach(W3,1000,3,1100); ev_teach(W3,1100,7,1200); ev_teach(W3,1200,5,2000);
  ev_teach(W3,1000,3,1101); ev_teach(W3,1101,7,1201); ev_teach(W3,1201,5,2001);
  ev_teach(W3,1000,3,1102); ev_teach(W3,1102,7,1202); ev_teach(W3,1202,5,2002);
  ev_teach(W3,1000,3,1103); ev_teach(W3,1103,7,1203); ev_teach(W3,1203,5,2003);
  rt_count_report(W3,110656,1000,3,2002,C,"A1b count");
  let st3:[]u8=z_alloc(8); set32(st3,0,0); set32(st3,4,0);
  let ans3:i32=invent_try(W3,1000,70,2002,0,C,st3);
  emit("A1b invent_try ans="); e64(ans3); emit(" (expect -2: first hit verifies-fail, no continued search)\n");
  return;
}

// ---- ATTACK 2: contradictory constraints ----
// Three unsatisfiable constraint sets on a small world. Question: does
// the mechanism terminate cleanly (-2) or thrash?
fn rt_attack2()void {
  emit("=== ATTACK 2: contradictory constraints ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1000,3,1001); ev_teach(W,1001,5,2000);
  ev_teach(W,1000,3,1002); ev_teach(W,1002,7,2000);
  let st:[]u8=z_alloc(8);
  // A2a: rel 7 exactly 5 in a plen-3 chain (unreachable count)
  let C1:[]u8=rt_mkC(3,7,5,-1,-1,-1);
  set32(st,0,0); set32(st,4,0);
  let a1:i32=invent_try(W,1000,70,2000,0,C1,st);
  emit("A2a unreachable-count ans="); e64(a1); emit(" (expect -2)\n");
  // A2b: plen 2, first_rel 3, last_rel 9; no rel-9 fact exists
  let C2:[]u8=rt_mkC(2,-1,-1,3,9,-1);
  set32(st,0,0); set32(st,4,0);
  let a2:i32=invent_try(W,1000,70,2000,0,C2,st);
  emit("A2b first/last-clash ans="); e64(a2); emit(" (expect -2)\n");
  // A2c: plen 3, first_rel 5; nothing from 1000 has rel 5 (immediate prune)
  let C3:[]u8=rt_mkC(3,-1,-1,5,-1,-1);
  set32(st,0,0); set32(st,4,0);
  let a3:i32=invent_try(W,1000,70,2000,0,C3,st);
  emit("A2c first_rel-impossible ans="); e64(a3); emit(" (expect -2)\n");
  // A2d: plen outside the hard 1..7 window is rejected outright
  let C4:[]u8=rt_mkC(8,-1,-1,-1,-1,-1);
  set32(st,0,0); set32(st,4,0);
  let a4:i32=invent_try(W,1000,70,2000,0,C4,st);
  emit("A2d plen=8 ans="); e64(a4); emit(" (expect -2: hard depth cap)\n");
  return;
}

// ---- ATTACK 4: constraint smuggling ----
// Rebuild the EXACT H3 worlds from invention_constraint/invent_driver.zag
// and count EVERY constraint-satisfying fact sequence with the faithful
// mirror. If nseq==1, the goal constraints (written by the researcher
// with full knowledge of the solution) uniquely determine the form: the
// DFS walks a forced path and the "invention" was done by the constraint
// author. Cross-validation: the real invent_try winner's fact ids must
// equal the counter's seq#1 fact ids (proves mirror fidelity).
fn rt_world1(W:[]u8)void {
  ev_teach(W,3,3,10); ev_teach(W,10,7,20); ev_teach(W,20,5,30);
  ev_teach(W,30,7,40); ev_teach(W,40,9,90);
  ev_teach(W,3,5,11); ev_teach(W,11,5,90);
  ev_teach(W,3,7,12); ev_teach(W,12,7,90);
  return;
}
fn rt_world2(W:[]u8)void {
  ev_teach(W,50,3,65); ev_teach(W,65,5,75);
  ev_teach(W,50,3,60); ev_teach(W,60,5,70);
  ev_teach(W,70,7,80); ev_teach(W,80,9,150);
  ev_teach(W,50,7,55); ev_teach(W,55,7,150);
  return;
}
fn rt_world3(W:[]u8)void {
  ev_teach(W,200,3,205); ev_teach(W,205,7,215); ev_teach(W,215,5,225);
  ev_teach(W,225,7,235); ev_teach(W,235,9,245); ev_teach(W,245,7,300);
  ev_teach(W,200,5,210); ev_teach(W,210,5,300);
  return;
}
fn rt_attack4()void {
  emit("=== ATTACK 4: constraint smuggling (H3 worlds, exact) ===\n");
  // P1
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); rt_world1(W1);
  let C1:[]u8=rt_mkC(5,7,2,3,-1,3);
  rt_count_report(W1,110656,3,5,90,C1,"P1");
  let W1b:[]u8=z_alloc(110656); tnn2_init(W1b); rt_world1(W1b);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let a1:i32=invent_try(W1b,3,70,90,0,C1,st);
  let m1:i32=rt_find_map(W1b,3,70);
  emit("P1 invent_try ans="); e64(a1); emit(" winner ");
  if(m1>=0){rt_print_factids(W1b,m1);}
  // P2
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); rt_world2(W2);
  let C2:[]u8=rt_mkC(4,5,1,-1,9,-1);
  rt_count_report(W2,110656,50,4,150,C2,"P2");
  let W2b:[]u8=z_alloc(110656); tnn2_init(W2b); rt_world2(W2b);
  set32(st,0,0); set32(st,4,0);
  let a2:i32=invent_try(W2b,50,71,150,0,C2,st);
  let m2:i32=rt_find_map(W2b,50,71);
  emit("P2 invent_try ans="); e64(a2); emit(" winner ");
  if(m2>=0){rt_print_factids(W2b,m2);}
  // P3
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); rt_world3(W3);
  let C3:[]u8=rt_mkC(6,7,3,3,-1,-1);
  rt_count_report(W3,110656,200,6,300,C3,"P3");
  let W3b:[]u8=z_alloc(110656); tnn2_init(W3b); rt_world3(W3b);
  set32(st,0,0); set32(st,4,0);
  let a3:i32=invent_try(W3b,200,72,300,0,C3,st);
  let m3:i32=rt_find_map(W3b,200,72);
  emit("P3 invent_try ans="); e64(a3); emit(" winner ");
  if(m3>=0){rt_print_factids(W3b,m3);}
  return;
}

// ---- ATTACK 5: fact poisoning / degenerate promotion ----
// A stuttering 2-cycle detour chain is taught FIRST (lowest node ids).
// It satisfies every constraint and verifies (correct answer), but the
// form is degenerate: it visits 1005 twice via a pointless detour.
// A clean chain taught SECOND also satisfies and verifies. The
// mechanism cannot distinguish form quality; id order decides.
fn rt_poison_world(W:[]u8)void {
  ev_teach(W,1000,3,1005);
  ev_teach(W,1005,7,1006);
  ev_teach(W,1006,7,1005);
  ev_teach(W,1005,9,2000);
  ev_teach(W,1000,3,1010);
  ev_teach(W,1010,7,1020);
  ev_teach(W,1020,5,1030);
  ev_teach(W,1030,7,2000);
  return;
}
fn rt_attack5()void {
  emit("=== ATTACK 5: fact poisoning / degenerate promotion ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W); rt_poison_world(W);
  let C:[]u8=rt_mkC(4,7,2,3,-1,-1);
  rt_count_report(W,110656,1000,4,2000,C,"A5 count");
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=invent_try(W,1000,70,2000,0,C,st);
  emit("A5 invent_try ans="); e64(ans); emit("\n");
  let m:i32=rt_find_map(W,1000,70);
  emit("A5 check="); e64(invent_check(W,m,C)); emit(" (1 = degenerate form promoted as success)\n");
  if(m>=0){rt_print_vals(W,m); rt_print_relseq(W,m); rt_print_factids(W,m);}
  // A5b: first_lit is invisible to the search. invent_dfs never reads
  // C[20]; only the external invent_check harness enforces it. A
  // constraint the search ignores is not "driving" construction.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); rt_poison_world(W2);
  let C2:[]u8=rt_mkC(4,7,2,3,-1,9999);
  let st2:[]u8=z_alloc(8); set32(st2,0,0); set32(st2,4,0);
  let ans2:i32=invent_try(W2,1000,70,2000,0,C2,st2);
  let m2:i32=rt_find_map(W2,1000,70);
  emit("A5b first_lit=9999(!=s) invent_try ans="); e64(ans2);
  emit(" check="); e64(invent_check(W2,m2,C2)); emit(" (0 = promoted despite violating first_lit)\n");
  return;
}
fn main()i32 {
  emit("RT-H3-REDTEAM-START\n");
  rt_attack1();
  rt_attack2();
  rt_attack4();
  rt_attack5();
  emit("RT-H3-REDTEAM-END\n");
  return 0;
}

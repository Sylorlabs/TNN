// rt_driver_scale.zag -- Attack 3: search blowup / scaling.
//
// Dense fact graphs: S subjects x b outgoing facts each (relations drawn
// from {3,5,7}, deterministic layout). Two modes:
//   mode 0: contradictory last_rel=9 (no rel-9 fact exists) -> the DFS
//           must explore the ENTIRE path tree to depth P, then fail.
//   mode 1: satisfiable-late. A solution chain (P-1 rel-3 links, final
//           rel-9 link) is taught LAST, so the DFS explores ~everything
//           before finding it.
// For each config: the faithful counter reports exact DFS node visits,
// and the REAL invent_try runs (termination check + answer check).
// plen is hard-capped at 7 by invent_try, so P<=7 always.

fn rt_mod(a:i32,b:i32)i32 {
  let r:i32=a;
  while(r>=b){r=r-b;}
  return r;
}
fn rt_mkC(plen:i32,re_r:i32,re_n:i32,first_rel:i32,last_rel:i32,first_lit:i32)[]u8 {
  let C:[]u8=z_alloc(24);
  set32(C,0,plen); set32(C,4,re_r); set32(C,8,re_n);
  set32(C,12,first_rel); set32(C,16,last_rel); set32(C,20,first_lit);
  return C;
}
fn rt_count(W:[]u8,s:i32,C:[]u8,stats:[]u8,rec_ov:[]u8,rec_of:[]u8,maxrec:i32)i32 {
  let plen:i32=get32(C,0);
  let re_r:i32=get32(C,4);
  let re_n:i32=get32(C,8);
  let first_rel:i32=get32(C,12);
  let last_rel:i32=get32(C,16);
  let cap:i32=8;
  let curval:[]u8=z_alloc(32);
  let factid:[]u8=z_alloc(32);
  let nextid:[]u8=z_alloc(32);
  let relcnt:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(nextid,0,1);
  set32(relcnt,0,0);
  let pos:i32=0;
  let nseq:i32=0;
  let nbk:i32=0;
  let nvis:i32=0;
  let npr:i32=0;
  let vfirst:i32=-1;
  let bfirst:i32=-1;
  while(pos>=0){
    if(pos>=plen || pos>=cap){
      if(pos==plen){
        let ok:i32=1;
        if(re_r>=0 && get32(relcnt,pos*4)!=re_n){ok=0;}
        if(ok==1){
          if(nseq<maxrec){
            let i:i32=0;
            while(i<=plen){set32(rec_ov,nseq*32+i*4,get32(curval,i*4)); i=i+1;}
            i=0;
            while(i<plen){set32(rec_of,nseq*32+i*4,get32(factid,i*4)); i=i+1;}
          }
          if(nseq==0){vfirst=nvis; bfirst=nbk;}
          nseq=nseq+1;
        }
        pos=pos-1; nbk=nbk+1;
      } else {
        pos=pos-1; nbk=nbk+1;
      }
    } else {
      let cv:i32=get32(curval,pos*4);
      let fid:i32=invent_fact_next(W,cv,get32(nextid,pos*4));
      if(fid<0){
        pos=pos-1; nbk=nbk+1;
      } else {
        set32(nextid,pos*4,fid);
        nvis=nvis+1;
        let fr:i32=ng(W,fid,24);
        let ok:i32=1;
        if(first_rel>=0 && pos==0 && fr!=first_rel){ok=0;}
        if(last_rel>=0 && pos==plen-1 && fr!=last_rel){ok=0;}
        let newcnt:i32=get32(relcnt,pos*4);
        if(re_r>=0){
          if(fr==re_r){newcnt=newcnt+1;}
          if(newcnt>re_n){ok=0;}
          if(newcnt+(plen-1-pos)<re_n){ok=0;}
        }
        if(ok==0){npr=npr+1;}
        if(ok==1){
          set32(relcnt,(pos+1)*4,newcnt);
          set32(factid,pos*4,fid);
          set32(curval,(pos+1)*4,ng(W,fid,28));
          set32(nextid,(pos+1)*4,1);
          pos=pos+1;
        }
      }
    }
  }
  set32(stats,0,nseq); set32(stats,4,nbk); set32(stats,8,nvis);
  set32(stats,12,npr); set32(stats,16,vfirst); set32(stats,20,bfirst);
  return nseq;
}
fn rt_scale_world(W:[]u8,S:i32,S0:i32,b:i32)void {
  let i:i32=0;
  while(i<S){
    let j:i32=0;
    while(j<b){
      let subj:i32=S0+i;
      let obj:i32=S0+rt_mod(i*7+j*13+3,S);
      let rr:i32=rt_mod(i+j,3);
      let rel:i32=3;
      if(rr==1){rel=5;}
      if(rr==2){rel=7;}
      ev_teach(W,subj,rel,obj);
      j=j+1;
    }
    i=i+1;
  }
  return;
}
fn rt_scale_one(S:i32,S0:i32,b:i32,P:i32,mode:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_scale_world(W,S,S0,b);
  let C:[]u8=rt_mkC(P,-1,-1,-1,9,-1);
  let s:i32=S0;
  let expected:i32=-2;
  if(mode==1){
    let v:i32=s;
    let k:i32=0;
    while(k<P){
      let nv:i32=7000;
      let rl:i32=9;
      if(k<P-1){nv=6000+k; rl=3;}
      ev_teach(W,v,rl,nv);
      v=nv;
      k=k+1;
    }
    expected=7000;
  }
  let stats:[]u8=z_alloc(24);
  let rec_ov:[]u8=z_alloc(256);
  let rec_of:[]u8=z_alloc(256);
  let n:i32=rt_count(W,s,C,stats,rec_ov,rec_of,8);
  let st:[]u8=z_alloc(8); set32(st,0,0); set32(st,4,0);
  let ans:i32=invent_try(W,s,70,expected,0,C,st);
  emit("SCALE mode="); e64(mode);
  emit(" S="); e64(S); emit(" b="); e64(b); emit(" P="); e64(P);
  emit(" nseq="); e64(n);
  emit(" visits="); e64(get32(stats,8));
  emit(" bk="); e64(get32(stats,4));
  emit(" ans="); e64(ans); emit("\n");
  return;
}
fn main()i32 {
  emit("RT-H3-SCALE-START\n");
  rt_scale_one(30,5000,3,5,0);
  rt_scale_one(30,5000,4,5,0);
  rt_scale_one(30,5000,5,5,0);
  rt_scale_one(30,5000,6,5,0);
  rt_scale_one(30,5000,3,6,0);
  rt_scale_one(30,5000,4,6,0);
  rt_scale_one(30,5000,5,6,0);
  rt_scale_one(30,5000,3,7,0);
  rt_scale_one(30,5000,4,7,0);
  rt_scale_one(30,5000,5,7,0);
  rt_scale_one(30,5000,6,7,0);
  rt_scale_one(30,5000,5,6,1);
  rt_scale_one(30,5000,4,7,1);
  emit("RT-H3-SCALE-END\n");
  return 0;
}

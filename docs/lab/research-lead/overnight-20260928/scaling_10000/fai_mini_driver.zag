// fai_mini_driver.zag -- minimal FACT index determinism test.
// Runs only the FAI world (mode 4, fixed FACT index) 3x via shell loop.
fn sc_big()[]u8 {
  let W:[]u8=z_alloc(7344192);
  return W;
}
fn w_fact(mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,mode);
  let i:i32=0;
  while(i<1000){
    ev_teach(W,5000+i,1,9000+i);
    i=i+1;
  }
  ev_teach(W,100,1,101); ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  emit(tag); emit(" facts taught\n");
  let paths:[]u8=z_alloc(4608);
  fcnt_zero(W);
  let np:i32=t2_gather(W,100,paths);
  emit(tag); emit(" gather np="); e64(np);
  emit(" factvisits="); e64(fcnt_get(W)); emit("\n");
  fcnt_zero(W);
  i=0;
  let hits:i32=0;
  while(i<50){
    if(t2_lu_first(W,5000+i*20,1)>=0){hits=hits+1;}
    i=i+1;
  }
  emit(tag); emit(" lu50 hits="); e64(hits);
  emit(" factvisits="); e64(fcnt_get(W)); emit("\n");
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("FAI-MINI-START\n");
  w_fact(4,"FAI");
  emit("FAI-MINI-END\n");
  return 0;
}

// FOSSIL CENSUS driver (full): standard battery + MAP census at two points.
// battery_pre / battery_post are textually identical to fossil_driver_base.zag.
fn live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1){c=c+1;} n=n+1;}
  return c;
}
fn map_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==20){c=c+1;} n=n+1;}
  return c;
}
fn battery_pre(W:[]u8)void {
  // Phase 1: teach chains (2-hop, 3-hop, 4-hop, 2-hop masked subject).
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  ev_teach(W,201,11,202); ev_teach(W,202,11,203); ev_teach(W,203,12,301);
  ev_teach(W,301,11,302); ev_teach(W,302,11,303); ev_teach(W,303,11,304); ev_teach(W,304,12,401);
  ev_teach(W,501,11,502); ev_teach(W,502,12,601);
  // Phase 2: unmasked queries promote MAPs.
  let a1:i32=ev_query(W,101,40,201,0);
  let a2:i32=ev_query(W,201,40,301,0);
  let a3:i32=ev_query(W,301,40,401,0);
  emit("BAT a1="); e64(a1); emit(" a2="); e64(a2); emit(" a3="); e64(a3); emit("\n");
  emit("BAT maps_after_promote="); e64(map_count(W)); emit("\n");
  // Phase 3: re-query hits shadow FACTs (MAPs not consulted).
  let b1:i32=ev_query(W,101,40,201,0);
  let b2:i32=ev_query(W,201,40,301,0);
  emit("BAT b1="); e64(b1); emit(" b2="); e64(b2); emit("\n");
  // Phase 4: masked query promotes MAP_D via trial.
  let c1:i32=ev_query(W,501,40,-2,1);
  emit("BAT c1="); e64(c1); emit(" maps="); e64(map_count(W)); emit("\n");
  // Phase 5: contradict chain A licensing fact -> revision touches MAP_A.
  let d:i32=ev_observe(W,102,12,999);
  let e1:i32=ev_query(W,101,40,-2,0);
  emit("BAT d="); e64(d); emit(" e1="); e64(e1); emit("\n");
  return;
}
fn battery_post(W:[]u8)void {
  // Phase 6: filler teaches -> eviction pressure.
  let i:i32=0;
  while(i<1000){
    ev_teach(W,8000+i,77,i);
    i=i+1;
  }
  emit("BAT live="); e64(live_count(W)); emit(" maps="); e64(map_count(W)); emit("\n");
  emit("BAT trialstats="); e64(hg(W,16)); emit("\n");
  return;
}
// ---- census (full variant only) ----
// Walk the executable graph from root following the t2_sig traversal order.
// Returns 1 if every visited cell is live with a valid graph tag.
fn graph_ok(W:[]u8,root:i32)i32 {
  let cur:i32=root; let st:i32=0;
  while(st<200){
    if(cur<2 || cur>=1024){return 0;}
    if(ng(W,cur,36)==0){return 0;}
    let t:i32=ng(W,cur,0);
    if(t!=101 && t!=102 && t!=103 && t!=104){return 0;}
    if(t==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    if(cur<0){return 1;}
    st=st+1;
  }
  return 0;
}
fn census(W:[]u8)void {
  let live:i32=0; let fossil:i32=0; let zombie:i32=0; let degraded:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let root:i32=ng(W,m,20);
      let rok:i32=1;
      if(root<2 || root>=1024){rok=0;}
      else {
        if(ng(W,root,36)==0){rok=0;}
        else {
          let t:i32=ng(W,root,0);
          if(t!=101 && t!=102 && t!=103 && t!=104){rok=0;}
        }
      }
      let refs:i32=ng(W,m,12); let b:i32=bid(W,m);
      let birth:i32=ng(W,m,16); let ans:i32=ng(W,m,28);
      if(rok==0){
        zombie=zombie+1;
        emit("MAP "); e64(m); emit(" ZOMBIE root="); e64(root);
        emit(" refs="); e64(refs); emit(" bid="); e64(b); emit("\n");
      } else {
        if(graph_ok(W,root)==0){
          degraded=degraded+1;
          emit("MAP "); e64(m); emit(" DEGRADED root="); e64(root);
          emit(" refs="); e64(refs); emit(" bid="); e64(b); emit("\n");
        } else {
          if(refs>0){
            live=live+1;
            emit("MAP "); e64(m); emit(" LIVE refs="); e64(refs);
            emit(" bid="); e64(b); emit(" birth="); e64(birth);
            emit(" ans="); e64(ans); emit("\n");
          } else {
            fossil=fossil+1;
            emit("MAP "); e64(m); emit(" FOSSIL refs=0 bid="); e64(b);
            emit(" birth="); e64(birth); emit(" ans="); e64(ans); emit("\n");
          }
        }
      }
    }
    m=m+1;
  }
  emit("CENSUS live="); e64(live); emit(" fossil="); e64(fossil);
  emit(" zombie="); e64(zombie); emit(" degraded="); e64(degraded); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  battery_pre(W);
  emit("CENSUS-PRE\n");
  census(W);
  battery_post(W);
  emit("CENSUS-POST\n");
  census(W);
  return 0;
}

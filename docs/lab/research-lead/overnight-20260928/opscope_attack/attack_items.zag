// attack_items.zag - Attack episode constructors for OpScope step-6.
// Attacker-authored. Uses frozen world helpers (z_alloc, get32, set32,
// build_utt) which are copied verbatim from opscope_world.zag in the
// harness assembly. No Python. No other languages.

// Build one attack episode into ep (64 bytes, caller zeroed).
// shape: target object shape (0=ball, 1=cube).
// Target = obj0 = (color 0, shape, size 0). tgt=0.
// Distractors: obj1=(color 1, shape 2, size 1), obj2=(color 2, shape 2, size 0).
// Episode type byte = 5 (attack marker; unread by learner and world_T).
fn make_attack(ep:[]u8, shape:i32, w0:i32, w1:i32, w2:i32, w3:i32, nw:i32)void {
  set32(ep,0,0); set32(ep,4,shape); set32(ep,8,0);
  set32(ep,12,1); set32(ep,16,2); set32(ep,20,1);
  set32(ep,24,2); set32(ep,28,2); set32(ep,32,0);
  set32(ep,40,0);
  set32(ep,44,5);
  build_utt(ep,w0,w1,w2,w3,nw);
  return;
}

// Four frozen attack probes (see PREREG_ATTACK.md).
// Word ids: 0=tak 1=not 5=bal 7=cub.
fn gen_attack(eps:[]u8)void {
  let ep:[]u8=z_alloc(64);
  let k:i32=0;
  // ATK1: "tak not bal cub", target=cube. H0->65, H1->1.
  k=0; while(k<64){ep[k]=0;k=k+1;}
  make_attack(ep,1,0,1,5,7,4);
  k=0; while(k<64){eps[0*64+k]=ep[k];k=k+1;}
  // ATK2: "cub not bal", target=cube. H2->1, genuine prefix->65.
  k=0; while(k<64){ep[k]=0;k=k+1;}
  make_attack(ep,1,7,1,5,0,3);
  k=0; while(k<64){eps[1*64+k]=ep[k];k=k+1;}
  // ATK3: "tak cub not bal", target=cube. lexical trigger->65.
  k=0; while(k<64){ep[k]=0;k=k+1;}
  make_attack(ep,1,0,7,1,5,4);
  k=0; while(k<64){eps[2*64+k]=ep[k];k=k+1;}
  // ATK4: "tak bal not cub", target=ball. genuine->33.
  k=0; while(k<64){ep[k]=0;k=k+1;}
  make_attack(ep,0,0,5,1,7,4);
  k=0; while(k<64){eps[3*64+k]=ep[k];k=k+1;}
  return;
}

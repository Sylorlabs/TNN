// attack_harness_main.zag - OpScope step-6 alternative-explanation attack harness.
// Attacker-authored. Training section (episodes 0..99) is an exact replica of
// the sealed harness training loop. Attack probes are scored with learning OFF.

fn dump_oprec(W:[]u8)void {
  emit("OPREC_TABLE:\n");
  let k:i32=0;
  while(k<8){
    let b:i32=5616+k*24;
    emit(" k="); emit(i32s(k));
    emit(" trig="); emit(i32s(get32(W,b)));
    emit(" scope="); emit(i32s(get32(W,b+4)));
    emit(" sig="); emit(i32s(get32(W,b+8)));
    emit(" sup="); emit(i32s(get32(W,b+12)));
    emit(" created="); emit(i32s(get32(W,b+16)));
    emit(" active="); emit(i32s(get32(W,b+20)));
    emit("\n");
    k=k+1;
  }
  return;
}

fn dump_diag(D:[]u8)void {
  emit("DIAG w epc reclen sup mtch div cs cb gate\n");
  let w:i32=0;
  while(w<12){
    let b:i32=w*32;
    let sup:i32=get32(D,b+8);
    if(sup>0){
      emit(" "); emit(i32s(w));
      emit(" "); emit(i32s(get32(D,b)));
      emit(" "); emit(i32s(get32(D,b+4)));
      emit(" "); emit(i32s(sup));
      emit(" "); emit(i32s(get32(D,b+12)));
      emit(" "); emit(i32s(get32(D,b+16)));
      emit(" "); emit(i32s(get32(D,b+20)));
      emit(" "); emit(i32s(get32(D,b+24)));
      emit(" "); emit(i32s(get32(D,b+28)));
      emit("\n");
    }
    w=w+1;
  }
  return;
}

fn main()i32 {
  // ---------- Frozen world ----------
  let st:[]u8=z_alloc(4);
  set32(st,0,123456789);
  let eps:[]u8=z_alloc(120*64);
  gen_episodes(eps,st);

  // ---------- Oracle units + targets ----------
  let allU:[]u8=z_alloc(120*16);
  let allN:[]u8=z_alloc(120*4);
  let allT:[]u8=z_alloc(120*4);
  let U:[]u8=z_alloc(16);
  let vrt:i32=1;
  let t:i32=0;
  while(t<120){
    let ep:[]u8=z_alloc(64);
    let k:i32=0; while(k<64){ ep[k]=eps[t*64+k]; k=k+1; }
    let n:i32=world_recover_U(ep,U);
    if(world_verify_U(ep,U,n)==0){ vrt=0; }
    let m:i32=world_T(ep,U,n);
    set32(allN,t*4,n);
    set32(allT,t*4,m);
    k=0; while(k<4){
      if(k<n){ set32(allU,(t*4+k)*4,get32(U,k*4)); } else { set32(allU,(t*4+k)*4,-1); }
      k=k+1;
    }
    t=t+1;
  }
  emit("VERIFY_U_ROUNDTRIP_120: "); emit(i32s(vrt)); emit("\n");
  emit("LEXICON: 0=tak 1=not 2=red 3=blu 4=grn 5=bal 6=sph 7=cub 8=tri 9=big 10=biger 11=smal\n");

  // ---------- Attack probes (4 hand-built episodes) ----------
  let aeps:[]u8=z_alloc(4*64);
  gen_attack(aeps);

  // ---------- Oracle units + targets (attack 4) ----------
  let aallU:[]u8=z_alloc(4*16);
  let aallN:[]u8=z_alloc(4*4);
  let aallT:[]u8=z_alloc(4*4);
  let avrt:i32=1;
  let ai:i32=0;
  while(ai<4){
    let aep:[]u8=z_alloc(64);
    let ak:i32=0; while(ak<64){ aep[ak]=aeps[ai*64+ak]; ak=ak+1; }
    let an:i32=world_recover_U(aep,U);
    if(world_verify_U(aep,U,an)==0){ avrt=0; }
    let am:i32=world_T(aep,U,an);
    set32(aallN,ai*4,an);
    set32(aallT,ai*4,am);
    ak=0; while(ak<4){
      if(ak<an){ set32(aallU,(ai*4+ak)*4,get32(U,ak*4)); } else { set32(aallU,(ai*4+ak)*4,-1); }
      ak=ak+1;
    }
    ai=ai+1;
  }
  emit("VERIFY_U_ROUNDTRIP_ATTACK_4: "); emit(i32s(avrt)); emit("\n");

  // ---------- Learner ----------
  let W:[]u8=z_alloc(8400);
  let z:i32=0; while(z<8400){ W[z]=0; z=z+1; }
  let TU:[]u8=z_alloc(16);
  let TS:[]u8=z_alloc(16);

  // ---------- Training: episodes 0..99, one-pass online ----------
  t=0;
  while(t<100){
    let n:i32=get32(allN,t*4);
    let T:i32=get32(allT,t*4);
    let j:i32=0; while(j<n){ set32(TU,j*4,get32(allU,(t*4+j)*4)); j=j+1; }
    learn_keep(W,TU,n,T,t);
    let p0:i32=baseline(W,TU,n);
    if(t>=20 && p0!=T){ learn_event(W,TU,n,T); }
    learn_update(W,TU,n,T);
    if((t+1)>=20 && ((t+1)%10)==0){
      let D:[]u8=z_alloc(384);
      diag_bars(W,t+1,TS,D);
      emit("CHECK seen="); emit(i32s(t+1)); emit("\n");
      dump_diag(D);
      let inst:i32=proposal_check(W,t+1,TS);
      retire_check(W,t+1,TS);
      emit(" installed_now="); emit(i32s(inst)); emit("\n");
    }
    t=t+1;
  }

  emit("TRAIN_DONE\n");
  dump_oprec(W);

  // ---------- Attack scoring: 4 probes, no learning ----------
  let fa_suffix:i32=0;
  let fa_const:i32=0;
  let fa_pos:i32=0;
  let fa_prefix:i32=0;
  let atk1p:i32=-1;
  ai=0;
  while(ai<4){
    let an:i32=get32(aallN,ai*4);
    let aT:i32=get32(aallT,ai*4);
    let aj:i32=0; while(aj<an){ set32(TU,aj*4,get32(aallU,(ai*4+aj)*4)); aj=aj+1; }
    let ap:i32=interpret(W,TU,an);
    emit("ATTACK probe="); emit(i32s(ai+1));
    emit(" U=");
    aj=0; while(aj<an){ emit(i32s(get32(TU,aj*4))); emit(","); aj=aj+1; }
    emit(" pred="); emit(i32s(ap));
    emit(" tgt="); emit(i32s(aT));
    emit("\n");
    if(ai==0){
      atk1p=ap;
      if(ap==1 && aT==129){ fa_suffix=1; }
    }
    if(ai==1){ if(ap==1){ fa_const=1; } }
    if(ai==2){ if(ap!=129){ fa_pos=1; } }
    if(ai==3){ if(ap!=33){ fa_prefix=1; } }
    ai=ai+1;
  }
  emit("ATK1_PRED: "); emit(i32s(atk1p)); emit("\n");
  emit("FA-SUFFIX: "); emit(i32s(fa_suffix)); emit("\n");
  emit("FA-CONST: "); emit(i32s(fa_const)); emit("\n");
  emit("FA-POS: "); emit(i32s(fa_pos)); emit("\n");
  emit("FA-PREFIX: "); emit(i32s(fa_prefix)); emit("\n");

  // Verdict per PREREG_ATTACK.md rule.
  if(avrt==0){
    emit("VERDICT: OPSCOPE-ATTACK-INCONCLUSIVE (round-trip defect)\n");
  } else if(atk1p==1){
    emit("VERDICT: OPSCOPE-ATTACK-KILLS (FA-SUFFIX: H1 suffix-suppression confirmed; word-scoped negation refuted)\n");
  } else if(atk1p!=129){
    emit("VERDICT: OPSCOPE-ATTACK-KILLS (H0 refuted; ATK1 uncharacterized)\n");
  } else if(fa_const==1){
    emit("VERDICT: OPSCOPE-ATTACK-KILLS (FA-CONST: not-to-1 shortcut confirmed)\n");
  } else if(fa_pos==1 || fa_prefix==1){
    emit("VERDICT: OPSCOPE-ATTACK-KILLS (FA-POS/FA-PREFIX)\n");
  } else {
    emit("VERDICT: OPSCOPE-ATTACK-SURVIVES\n");
  }
  return 0;
}

// Weak K-LT-5 sealed world generator.
// Pure Zag. Outputs the sealed world data to stdout.
// Design: 40 probes, relation 50, chain relation 51.
// For each probe s_i = 1000+i:
//   Teach (s_i,51,a_i), (a_i,51,b_i), (b_i,51,c_i), (c_i,51,d_i)
//   where a_i=100+i, b_i=200+i, c_i=300+i, d_i=400+i.
// Expected answer: 4 (count of 4 links). Flags: 0 (unmasked, dc=0, di=0).
// The evaluator must: create tag-8 node, apply TEACH lines,
// then run PROBE lines as ev_query(s,r,expected,flags).
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn main()i32 {
  emit("# Weak K-LT-5 sealed world v1\n");
  emit("# 40 probes. Relation 50. Chain relation 51. Expected 4. Flags 0.\n");
  emit("# SETUP: allocate tag-8 node (enables sum family per R1).\n");
  emit("# TEACH: 160 background facts (4 per probe, chain via rel 51).\n");
  emit("# PROBE: 40 queries as ev_query(s,50,4,0). Phase A: probes 1-20. Phase B: 21-40.\n");
  emit("SETUP TAG8\n");
  let i:i32=1;
  while(i<=40){
    let s:i32=1000+i;
    let a:i32=100+i;
    let b:i32=200+i;
    let c:i32=300+i;
    let d:i32=400+i;
    emit("TEACH "); e64(s); emit(" 51 "); e64(a); emit("\n");
    emit("TEACH "); e64(a); emit(" 51 "); e64(b); emit("\n");
    emit("TEACH "); e64(b); emit(" 51 "); e64(c); emit("\n");
    emit("TEACH "); e64(c); emit(" 51 "); e64(d); emit("\n");
    i=i+1;
  }
  emit("# PROBE lines: s r expected flags\n");
  i=1;
  while(i<=40){
    let s:i32=1000+i;
    emit("PROBE "); e64(s); emit(" 50 4 0\n");
    i=i+1;
  }
  emit("# END. 160 TEACH, 40 PROBE, 1 SETUP.\n");
  return 0;
}

// d3_batt.zag -- the frozen D3 battery, shared byte-identical
// across all three builds (catted after the store file and the
// per-build d3_rank shim). Uses only the frozen store
// interface: es_item_new, e_add, e_has, es_ndeps, es_dep_at,
// e_count, es_audit, es_promotes, es_maxrank, es_diverge,
// plus d3_rank from the shim. Emit helpers are d3_-prefixed
// (no collisions).
//
// Stages on one state:
//   1. diamond: A=4 -> B=5, A -> C=6, B -> D=7, C -> D=7
//      (all cross-rank under creation-order ranks)
//   2. adversarial: D -> A (cycle-closing), D -> D (self-loop)
//   3. fan-out (A -> E=8, A -> F=9), fan-in (E -> D, F -> D),
//      G=10 -> H=11, H -> G (cycle-closing), I=12 -> A
//   4. deep chain 23 -> 22 -> .. -> 13, then 13 -> 23
//      (cycle-closing on the long chain)

fn d3_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn d3_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn d3_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn d3_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  d3_p(ob,atp,nm);
  d3_p(ob,atp,"=");
  d3_pi(ob,atp,v);
  d3_p(ob,atp," ");
  return;
}
// d3_inv: 1 iff every readable edge goes from a strictly
// higher rank to a strictly lower rank.
fn d3_inv(st:[]u8)i32 {
  let y:i32=0;
  while(y<24){
    let ry:i32=d3_rank(st,y);
    if(ry>=0){
      let n:i32=es_ndeps(st,y);
      let i:i32=0;
      while(i<n){
        let w:i32=es_dep_at(st,y,i);
        let rw:i32=d3_rank(st,w);
        if(rw>=ry){ return 0; }
        i=i+1;
      }
    }
    y=y+1;
  }
  return 1;
}
fn d3_run(ob:[]u8, atp:[]u8)void {
  let st:[]u8=z_alloc(65536);
  let k:i32=4;
  while(k<=12){ es_item_new(st,k); k=k+1; }
  // ---- Stage 1: the diamond ----
  e_add(st,4,5,1);
  e_add(st,4,6,1);
  e_add(st,5,7,1);
  e_add(st,6,7,1);
  let dab:i32=e_has(st,4,5,1);
  let dac:i32=e_has(st,4,6,1);
  let dbd:i32=e_has(st,5,7,1);
  let dcd:i32=e_has(st,6,7,1);
  d3_p(ob,atp,"D3A ");
  d3_bar(ob,atp,"dab",dab);
  d3_bar(ob,atp,"dac",dac);
  d3_bar(ob,atp,"dbd",dbd);
  d3_bar(ob,atp,"dcd",dcd);
  d3_bar(ob,atp,"inv",d3_inv(st));
  d3_bar(ob,atp,"audit",es_audit(st));
  d3_bar(ob,atp,"promotes",es_promotes(st));
  d3_bar(ob,atp,"maxrank",es_maxrank(st));
  d3_pnl(ob,atp);
  // ---- Stage 2: adversarial on the diamond ----
  e_add(st,7,4,2);
  e_add(st,7,7,2);
  let adv1:i32=e_has(st,7,4,2);
  let adv2:i32=e_has(st,7,7,2);
  let dia:i32=1;
  if(e_has(st,4,5,1)==0){ dia=0; }
  if(e_has(st,4,6,1)==0){ dia=0; }
  if(e_has(st,5,7,1)==0){ dia=0; }
  if(e_has(st,6,7,1)==0){ dia=0; }
  d3_p(ob,atp,"D3B ");
  d3_bar(ob,atp,"adv1",adv1);
  d3_bar(ob,atp,"adv2",adv2);
  d3_bar(ob,atp,"dia",dia);
  d3_bar(ob,atp,"inv",d3_inv(st));
  d3_bar(ob,atp,"audit",es_audit(st));
  d3_bar(ob,atp,"promotes",es_promotes(st));
  d3_bar(ob,atp,"maxrank",es_maxrank(st));
  d3_pnl(ob,atp);
  // ---- Stage 3: fan-out / fan-in / extension ----
  e_add(st,4,8,1);
  e_add(st,4,9,1);
  e_add(st,8,7,1);
  e_add(st,9,7,1);
  e_add(st,10,11,1);
  e_add(st,11,10,1);
  e_add(st,12,4,1);
  d3_p(ob,atp,"D3C ");
  d3_bar(ob,atp,"fo1",e_has(st,4,8,1));
  d3_bar(ob,atp,"fo2",e_has(st,4,9,1));
  d3_bar(ob,atp,"fi1",e_has(st,8,7,1));
  d3_bar(ob,atp,"fi2",e_has(st,9,7,1));
  d3_bar(ob,atp,"ext1",e_has(st,10,11,1));
  d3_bar(ob,atp,"ext2",e_has(st,12,4,1));
  d3_bar(ob,atp,"cyc",e_has(st,11,10,1));
  d3_bar(ob,atp,"inv",d3_inv(st));
  d3_bar(ob,atp,"audit",es_audit(st));
  d3_bar(ob,atp,"promotes",es_promotes(st));
  d3_bar(ob,atp,"maxrank",es_maxrank(st));
  d3_bar(ob,atp,"t1",e_count(st,1));
  d3_bar(ob,atp,"t2",e_count(st,2));
  d3_pnl(ob,atp);
  // ---- Stage 4: deep chain + cycle-closing on the chain ----
  k=13;
  while(k<=23){ es_item_new(st,k); k=k+1; }
  k=23;
  while(k>13){ e_add(st,k,k-1,1); k=k-1; }
  e_add(st,13,23,1);
  let chain:i32=0;
  let c:i32=14;
  while(c<=23){
    if(e_has(st,c,c-1,1)==1){ chain=chain+1; }
    c=c+1;
  }
  d3_p(ob,atp,"D3D ");
  d3_bar(ob,atp,"chain",chain);
  d3_bar(ob,atp,"cyc",e_has(st,13,23,1));
  d3_bar(ob,atp,"inv",d3_inv(st));
  d3_bar(ob,atp,"audit",es_audit(st));
  d3_bar(ob,atp,"promotes",es_promotes(st));
  d3_bar(ob,atp,"maxrank",es_maxrank(st));
  d3_bar(ob,atp,"diverge",es_diverge(st));
  d3_bar(ob,atp,"t1",e_count(st,1));
  d3_bar(ob,atp,"t2",e_count(st,2));
  d3_pnl(ob,atp);
  return;
}

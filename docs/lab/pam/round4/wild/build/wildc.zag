// WILD-C battery: grok's eight wild PAM designs (W16-W23), pure Zag, zero RNG.
// One binary; argv[1] = design (16..23), argv[2] = mode (run|zerodecl|probe).
// argv[3] = tape path, argv[4] = probe path, argv[5] = corpus path.
// Emits OUT|... / SUM|... / KB|... lines to stdout. No wall-clock reads.
@import("R33_NATIVE_IO_V1.zag")

// ---------- output buffer ----------
fn obyte(ob:[]u8,n:i32,c:i32)i32 { ob[n]=c as u8; return n+1; }
fn ostr(ob:[]u8,n:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ ob[n+i]=s[i]; i=i+1; }
    return n+s.len;
}
fn oi64(ob:[]u8,n:i32,v:i64)i32 {
    if(v==0){ return obyte(ob,n,48); }
    let neg:i32=0;
    let u:i64=v;
    if(v<0){ neg=1; u=0-u; }
    if(neg==1){ ob[n]=45; n=n+1; }
    let d0:i32=n;
    while(u>0){ ob[n]=(((u%10) as i32)+48) as u8; u=u/10; n=n+1; }
    // reverse digits between d0 and n
    let a:i32=d0;
    let b:i32=n-1;
    while(a<b){ let t:u8=ob[a]; ob[a]=ob[b]; ob[b]=t; a=a+1; b=b-1; }
    return n;
}
fn oi32(ob:[]u8,n:i32,v:i32)i32 { return oi64(ob,n,v as i64); }
fn onl(ob:[]u8,n:i32)i32 { return obyte(ob,n,10); }

// ---------- small utils ----------
fn abs32(v:i32)i32 { if(v<0){ return 0-v; } return v; }
fn eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){ return 0; }
    let i:i32=0;
    while(i<a.len){ if(a[i]!=b[i]){ return 0; } i=i+1; }
    return 1;
}
fn starts_with(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){ return 0; }
    return eq(s[0..pre.len],pre);
}
fn contains(s:[]u8,sub:[]u8)i32 {
    if(sub.len==0 || s.len<sub.len){ return 0; }
    let i:i32=0;
    while(i+sub.len<=s.len){
        if(eq(s[i..i+sub.len],sub)==1){ return 1; }
        i=i+1;
    }
    return 0;
}
fn parse_i32(s:[]u8)i32 {
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0 && s[0]==45){ neg=1; i=1; }
    let v:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){ v=v*10+(c-48); }
        i=i+1;
    }
    if(neg==1){ return 0-v; }
    return v;
}
fn parse_i64(s:[]u8)i64 {
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0 && s[0]==45){ neg=1; i=1; }
    let v:i64=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){ v=v*10+((c-48) as i64); }
        i=i+1;
    }
    if(neg==1){ return 0-v; }
    return v;
}
// little-endian arena accessors ([]u8 arenas, never indexed narrow casts)
fn g32(a:[]u8,o:i32)i32 {
    return (a[o] as i32)|((a[o+1] as i32)<<8)|((a[o+2] as i32)<<16)|((a[o+3] as i32)<<24);
}
fn p32(a:[]u8,o:i32,v:i32)void {
    a[o]=(v&255) as u8; a[o+1]=((v>>8)&255) as u8;
    a[o+2]=((v>>16)&255) as u8; a[o+3]=((v>>24)&255) as u8;
    return;
}
fn g64(a:[]u8,o:i32)i64 {
    let lo:i64=(g32(a,o) as i64)&4294967295;
    let hi:i64=(g32(a,o+4) as i64)&4294967295;
    return lo|(hi<<32);
}
fn p64(a:[]u8,o:i32,v:i64)void {
    p32(a,o,(v&4294967295) as i32);
    p32(a,o+4,((v>>32)&4294967295) as i32);
    return;
}
// FNV-1a/64 over bytes (signed i64 bit pattern; deterministic)
fn fnv(s:[]u8)i64 {
    let h:i64=14695981039346656037;
    let i:i32=0;
    while(i<s.len){ h=(h^(s[i] as i64))*1099511628211; i=i+1; }
    return h;
}

// ---------- file reading (open(2)/read loop; NUL-terminated path) ----------
// Sized by fstat; bounded only by the znc 2^25-byte indexed-slice ceiling
// (33,554,432). No arbitrary cap.
fn file_read(path:[]u8)[]u8 {
    let np:[]u8=nio_alloc(path.len+1);
    if(np.len==0){ return ""; }
    let i:i32=0;
    while(i<path.len){ np[i]=path[i]; i=i+1; }
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(np) as i64,0,0,0,0,0);
    if(fd<0){ return ""; }
    let st:[]u8=nio_alloc(144);
    let rc:i64=_zag_raw_syscall(5,fd,_zag_slice_ptr(st) as i64,0,0,0,0);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(rc!=0){ return ""; }
    let sz:i64=g64(st,48);
    if(sz<=0 || sz>=33554432){ return ""; }
    let fd2:i64=_zag_raw_syscall(2,_zag_slice_ptr(np) as i64,0,0,0,0,0);
    if(fd2<0){ return ""; }
    let cap:i32=sz as i32;
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){ _zag_raw_syscall(3,fd2,0,0,0,0,0); return ""; }
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd2,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){ continue; }
        if(n<=0){ break; }
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd2,0,0,0,0,0);
    return buf[0..at];
}
// find index of the k-th '|' (0-based) in s; -1 if fewer
fn nth_pipe(s:[]u8,k:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==124){ if(n==k){ return i; } n=n+1; }
        i=i+1;
    }
    return -1;
}
// fatal error: print msg to stdout and exit(1)
fn die(msg:[]u8)void {
    let ob:[]u8=nio_alloc(256);
    let n:i32=0;
    n=ostr(ob,n,"FATAL|");
    n=ostr(ob,n,msg);
    n=onl(ob,n);
    nio_write_all(1,ob[0..n]);
    _zag_raw_syscall(60,1,0,0,0,0,0);
    return;
}

// ---------- frozen C3 mirror (run_gate revised=True, adjudicator=True) ----------
// disp: []u8 of 11840 bytes; disp[seq]=1 iff INSTALL disposition.
// asserts the frozen aggregate 791/1102, else dies.
fn c3_mirror(corpus:[]u8,disp:[]u8)void {
    let armed:[]u8=nio_alloc(6*256*8);
    let armedn:[]u8=nio_alloc(24);
    let pend:[]u8=nio_alloc(6*12);
    let perm:[]u8=nio_alloc(6*12);
    let prov:[]u8=nio_alloc(6*12);
    let chal:[]u8=nio_alloc(6*12);
    let pvalid:[]u8=nio_alloc(6);
    let qvalid:[]u8=nio_alloc(6);
    let rvalid:[]u8=nio_alloc(6);
    let svalid:[]u8=nio_alloc(6);
    let pos:i32=0;
    let den:i32=0;
    let inst:i32=0;
    while(pos<corpus.len){
        let eol:i32=pos;
        while(eol<corpus.len && corpus[eol]!=10){ eol=eol+1; }
        let line:[]u8=corpus[pos..eol];
        if(line.len>0){
            // 13 fields: seq|tc|prog|progF|agree|strong|conf|mrgF|jcode|pred|meas|correct|truth
            let f0:i32=0;
            let f1:i32=nth_pipe(line,0);
            let f2:i32=nth_pipe(line,1);
            let f3:i32=nth_pipe(line,2);
            let f4:i32=nth_pipe(line,3);
            let f5:i32=nth_pipe(line,4);
            let f6:i32=nth_pipe(line,5);
            let f7:i32=nth_pipe(line,6);
            let f8:i32=nth_pipe(line,7);
            let f9:i32=nth_pipe(line,8);
            let f10:i32=nth_pipe(line,9);
            let f11:i32=nth_pipe(line,10);
            let f12:i32=nth_pipe(line,11);
            let seq:i32=parse_i32(line[f0..f1]);
            let tc:i32=parse_i32(line[f1+1..f2]);
            let pr:i32=parse_i32(line[f2+1..f3]);
            let pf:i32=parse_i32(line[f3+1..f4]);
            let agree:i32=parse_i32(line[f4+1..f5]);
            let conf:i32=parse_i32(line[f6+1..f7]);
            let mrgF:i32=parse_i32(line[f7+1..f8]);
            let jc:i32=parse_i32(line[f8+1..f9]);
            let pred:i32=parse_i32(line[f9+1..f10]);
            let meas:i32=parse_i32(line[f10+1..f11]);
            let correct:i32=parse_i32(line[f11+1..f12]);
            if(pr!=0 && pf==0 && agree==1 && conf>=700){ pr=0; pred=1; }
            let tol:i32=8;
            if(tc==1){ tol=40; } else if(tc==2){ tol=60; } else if(tc==3){ tol=4000; } else if(tc==4){ tol=120; } else if(tc==5){ tol=0; }
            let thr:i32=400;
            if(tc==1){ thr=50; } else if(tc==2){ thr=60; } else if(tc==3){ thr=1500; } else if(tc==4){ thr=80; } else if(tc==5){ thr=2; }
            let nm:i32=0;
            let an:i32=g32(armedn,tc*4);
            let base:i32=tc*256*8;
            let ai:i32=0;
            while(ai<an){
                let aj:i32=g32(armed,base+ai*8);
                let am:i32=g32(armed,base+ai*8+4);
                if(aj==jc && abs32(am-meas)<=tol){ nm=1; }
                ai=ai+1;
            }
            let code:i32=0;
            if(pr==1){
                let pmatch:i32=0;
                if(pvalid[tc]==1){
                    let pj:i32=g32(pend,tc*12);
                    let pm:i32=g32(pend,tc*12+4);
                    if(pj==jc && abs32(pm-meas)<=tol){ pmatch=1; }
                }
                if(pmatch==1){
                    if(nm==0 && an<256){
                        p32(armed,base+an*8,jc);
                        p32(armed,base+an*8+4,meas);
                        p32(armedn,tc*4,an+1);
                    }
                    pvalid[tc]=0;
                    code=4;
                } else if(nm==1){
                    code=4;
                } else {
                    p32(pend,tc*12,jc);
                    p32(pend,tc*12+4,meas);
                    pvalid[tc]=1;
                    code=4;
                }
            } else if(pr==2){
                if(nm==1){ code=1; } else { code=3; }
            } else {
                if(pred==0){
                    code=0;
                } else if(nm==1){
                    code=1;
                } else if(qvalid[tc]==1){
                    let pj:i32=g32(perm,tc*12);
                    let pm:i32=g32(perm,tc*12+4);
                    if(jc==pj && abs32(pm-meas)<=tol){
                        code=7;
                    } else if(jc!=pj){
                        if(conf>=700 && mrgF>=thr){
                            if(rvalid[tc]==1){
                                let cj:i32=g32(chal,tc*12);
                                let cm:i32=g32(chal,tc*12+4);
                                if(cj==jc && abs32(cm-meas)<=tol){
                                    p32(perm,tc*12,jc);
                                    p32(perm,tc*12+4,meas);
                                    p32(perm,tc*12+8,seq);
                                    rvalid[tc]=0;
                                    code=9;
                                } else {
                                    p32(chal,tc*12,jc);
                                    p32(chal,tc*12+4,meas);
                                    p32(chal,tc*12+8,seq);
                                    rvalid[tc]=1;
                                    code=8;
                                }
                            } else {
                                p32(chal,tc*12,jc);
                                p32(chal,tc*12+4,meas);
                                p32(chal,tc*12+8,seq);
                                rvalid[tc]=1;
                                code=8;
                            }
                        } else {
                            code=2;
                        }
                    } else {
                        code=7;
                    }
                } else if(svalid[tc]==1){
                    let pj:i32=g32(prov,tc*12);
                    let pm:i32=g32(prov,tc*12+4);
                    if(jc==pj && abs32(pm-meas)<=tol){
                        if(conf<700){
                            p32(prov,tc*12,jc);
                            p32(prov,tc*12+4,meas);
                            p32(prov,tc*12+8,seq);
                            code=7;
                        } else {
                            p32(perm,tc*12,jc);
                            p32(perm,tc*12+4,meas);
                            p32(perm,tc*12+8,seq);
                            qvalid[tc]=1;
                            svalid[tc]=0;
                            code=6;
                        }
                    } else if(jc!=pj){
                        p32(prov,tc*12,jc);
                        p32(prov,tc*12+4,meas);
                        p32(prov,tc*12+8,seq);
                        code=5;
                    } else {
                        code=7;
                    }
                } else {
                    p32(prov,tc*12,jc);
                    p32(prov,tc*12+4,meas);
                    p32(prov,tc*12+8,seq);
                    svalid[tc]=1;
                    code=5;
                }
            }
            let isinst:i32=0;
            if(code==5 || code==6 || code==7 || code==8 || code==9){ isinst=1; }
            if(seq>=0 && seq<disp.len){ disp[seq]=isinst as u8; }
            if(correct==1 && conf>=700){
                den=den+1;
                if(isinst==1){ inst=inst+1; }
            }
        }
        pos=eol+1;
    }
    if(den!=1102 || inst!=791){ die("c3-aggregate-mismatch"); }
    return;
}

// ---------- UTF-8 validity (NUL or malformed -> reject) ----------
fn utf8_ok(pay:[]u8)i32 {
    let i:i32=0;
    while(i<pay.len){
        let b:i32=pay[i] as i32;
        if(b==0){ return 0; }
        if(b<128){ i=i+1; }
        else if(b>=194 && b<=223){
            if(i+1>=pay.len){ return 0; }
            let c:i32=pay[i+1] as i32;
            if(c<128 || c>191){ return 0; }
            i=i+2;
        }
        else if(b>=224 && b<=239){
            if(i+2>=pay.len){ return 0; }
            let c1:i32=pay[i+1] as i32;
            let c2:i32=pay[i+2] as i32;
            if(c1<128 || c1>191 || c2<128 || c2>191){ return 0; }
            i=i+3;
        }
        else if(b>=240 && b<=244){
            if(i+3>=pay.len){ return 0; }
            let c1:i32=pay[i+1] as i32;
            let c2:i32=pay[i+2] as i32;
            let c3:i32=pay[i+3] as i32;
            if(c1<128 || c1>191 || c2<128 || c2>191 || c3<128 || c3>191){ return 0; }
            i=i+4;
        }
        else { return 0; }
    }
    return 1;
}
// normalize into nbuf; return length, or -1 on reject
fn canon_norm(pay:[]u8,nbuf:[]u8)i32 {
    if(utf8_ok(pay)==0){ return -1; }
    let n:i32=0;
    let k:i32=0;
    let insp:i32=1;
    while(k<pay.len){
        let b:i32=pay[k] as i32;
        if(b==13){ b=10; }
        if(b>=65 && b<=90){ b=b+32; }
        if(b==32 || b==9 || b==10){
            if(insp==0){ nbuf[n]=32; n=n+1; insp=1; }
        } else {
            nbuf[n]=b as u8; n=n+1; insp=0;
        }
        k=k+1;
    }
    if(n>0 && nbuf[n-1]==32){ n=n-1; }
    return n;
}
// clause arena: 8 x 40 bytes:
// sh@0(8) oh@8(8) pid@16(4) parse@20(1) sos@24(4) slen@28(4) oos@32(4) olen@36(4)
// offsets into nbuf. returns clause count. Bounded by car.len (caller-sized).
fn canon_clauses(nbuf:[]u8,nlen:i32,car:[]u8)i32 {
    let maxcl:i32=car.len/40;
    let ncl:i32=0;
    let cs:i32=0;
    while(cs<nlen && ncl<maxcl){
        let ce:i32=cs;
        while(ce<nlen && nbuf[ce]!=59){ ce=ce+1; }
        let a:i32=cs;
        let b:i32=ce;
        while(a<b && nbuf[a]==32){ a=a+1; }
        while(b>a && nbuf[b-1]==32){ b=b-1; }
        let base:i32=ncl*40;
        let p1:i32=a;
        while(p1<b && nbuf[p1]!=124){ p1=p1+1; }
        let parse:i32=0;
        let pid:i32=0;
        let sos:i32=0;
        let slen:i32=0;
        let oos:i32=0;
        let olen:i32=0;
        if(p1<b){
            let p2:i32=p1+1;
            while(p2<b && nbuf[p2]!=124){ p2=p2+1; }
            if(p2<b){
                let ps:[]u8=nbuf[p1+1..p2];
                if(eq(ps,"carries")==1){ pid=1; }
                else if(eq(ps,"claims")==1){ pid=2; }
                else if(eq(ps,"reports")==1){ pid=3; }
                else if(eq(ps,"says")==1){ pid=4; }
                if(pid!=0){
                    parse=1;
                    sos=a; slen=p1-a; oos=p2+1; olen=b-(p2+1);
                }
            }
        }
        p64(car,base,fnv(nbuf[sos..sos+slen]));
        p64(car,base+8,fnv(nbuf[oos..oos+olen]));
        p32(car,base+16,pid);
        car[base+20]=parse as u8;
        p32(car,base+24,sos);
        p32(car,base+28,slen);
        p32(car,base+32,oos);
        p32(car,base+36,olen);
        ncl=ncl+1;
        cs=ce+1;
    }
    return ncl;
}
// ---------- producer table (9 entries x 16B: id@0 class@4 token@8 env@12) ----------
fn prod_init(t:[]u8)void {
    p32(t,0,1); p32(t,4,1); p32(t,8,1001); p32(t,12,1);
    p32(t,16,2); p32(t,20,1); p32(t,24,1002); p32(t,28,1);
    p32(t,32,4); p32(t,36,2); p32(t,40,0); p32(t,44,0);
    p32(t,48,5); p32(t,52,2); p32(t,56,0); p32(t,60,0);
    p32(t,64,6); p32(t,68,4); p32(t,72,0); p32(t,76,0);
    p32(t,80,7); p32(t,84,0); p32(t,88,0); p32(t,92,0);
    p32(t,96,8); p32(t,100,1); p32(t,104,0); p32(t,108,0);
    p32(t,112,9); p32(t,116,3); p32(t,120,0); p32(t,124,0);
    p32(t,128,10); p32(t,132,1); p32(t,136,1010); p32(t,140,1);
    return;
}
fn prod_lookup(t:[]u8,pid:i32)i32 {
    let lo:i32=0;
    let hi:i32=9;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        let id:i32=g32(t,mid*16);
        if(id==pid){ return mid*16; }
        if(id<pid){ lo=mid+1; } else { hi=mid; }
    }
    return -1;
}
// ---------- feature word (u16 as i32) ----------
fn digitrun(s:[]u8)i32 {
    let run:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){
            run=run+1;
            if(run>=4){ return 1; }
        } else { run=0; }
        i=i+1;
    }
    return 0;
}
fn features(car:[]u8,ci:i32,ncl:i32,class:i32,token:i32,env:i32,decl:i32,prodf:i32,has_auth:i32,has_fic:i32,nbuf:[]u8)i32 {
    let f:i32=0;
    let parse:i32=car[ci*40+20] as i32;
    let pid:i32=g32(car,ci*40+16);
    if(prodf==1 && decl!=class){ f=f|1; }
    if(class==1){ f=f|2; }
    if(class==2){ f=f|4; }
    if(class==4){ f=f|8; }
    if(env==1){ f=f|16; }
    if(token!=0){ f=f|32; }
    if(has_auth==1 && token==0){ f=f|64; }
    if(parse==1){ f=f|128; }
    if(ncl>1){ f=f|256; }
    f=f|512;
    if(prodf==0){ f=f|1024; }
    if(has_fic==1){ f=f|2048; }
    let sos:i32=g32(car,ci*40+24);
    let slen:i32=g32(car,ci*40+28);
    let oos:i32=g32(car,ci*40+32);
    let olen:i32=g32(car,ci*40+36);
    if(digitrun(nbuf[sos..sos+slen])==1 || digitrun(nbuf[oos..oos+olen])==1){ f=f|4096; }
    if(pid==2 || pid==3 || pid==4){ f=f|8192; }
    if(class==0){ f=f|32768; }
    return f;
}

// ================= W16: Canonical Transform Gate =================
fn w16_prov(feat:i32,class:i32,prodf:i32)i32 {
    if((feat&128)==0){ return 0; }          // R0 parse fail -> UNK
    if(class==2){ return 2; }               // R1 GEN
    if((feat&64)==64){ return 0; }          // R2 authclaim w/o token -> UNK
    if(class==4){ return 4; }               // R3 REPORT
    if(class==1 && (feat&16)==16){ return 1; } // R4 EXT+envelope -> EXT
    if(prodf==1){ return 3; }                // R5 row exists -> DERIVED
    return 0;
}
// shared tape-row field parser: fills f (8xi32), returns payload slice
fn parse_taperow(line:[]u8,f:[]u8)[]u8 {
    let p0:i32=nth_pipe(line,0);
    let p1:i32=nth_pipe(line,1);
    let p2:i32=nth_pipe(line,2);
    let p3:i32=nth_pipe(line,3);
    let p4:i32=nth_pipe(line,4);
    let p5:i32=nth_pipe(line,5);
    let p6:i32=nth_pipe(line,6);
    let p12:i32=nth_pipe(line,12);
    let p13:i32=nth_pipe(line,13);
    let p14:i32=nth_pipe(line,14);
    p32(f,0,parse_i32(line[p0+1..p1]));
    p32(f,4,parse_i32(line[p1+1..p2]));
    p32(f,8,parse_i32(line[p2+1..p3]));
    p32(f,12,parse_i32(line[p3+1..p4]));
    p32(f,16,parse_i32(line[p4+1..p5]));
    p32(f,20,parse_i32(line[p5+1..p6]));
    p32(f,24,parse_i32(line[p12+1..p13]));
    p32(f,28,parse_i32(line[p13+1..p14]));
    return line[p14+1..];
}
fn w16_claim_out(ob:[]u8,n:i32,K:[]u8,idx:i32,seq:i32,producer:i32,decl:i32,class:i32,c3:i32,prov:i32,dec:i32,clean:i32)i32 {
    n=ostr(ob,n,"OUT|16|");
    n=ostr(ob,n,K); n=obyte(ob,n,124);
    n=oi32(ob,n,idx); n=obyte(ob,n,124);
    n=oi32(ob,n,seq); n=obyte(ob,n,124);
    n=oi32(ob,n,producer); n=obyte(ob,n,124);
    n=oi32(ob,n,decl); n=obyte(ob,n,124);
    n=oi32(ob,n,class); n=obyte(ob,n,124);
    n=oi32(ob,n,c3); n=obyte(ob,n,124);
    n=oi32(ob,n,prov); n=obyte(ob,n,124);
    n=oi32(ob,n,dec); n=obyte(ob,n,124);
    n=oi32(ob,n,clean);
    n=onl(ob,n);
    return n;
}
fn w16_run(tape:[]u8,disp:[]u8,prod:[]u8,zerodecl:i32,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let pos:i32=0;
    let nrows:i32=0;
    let ndec:i32=0;
    let nclean:i32=0;
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let K:[]u8=line[0..1];
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let decl:i32=g32(f,28);
            if(zerodecl==1){ decl=0; }
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let prodf:i32=0;
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let ncl:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<ncl){
                    let feat:i32=features(car,ci,ncl,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                    let prov:i32=w16_prov(feat,class,prodf);
                    let dec:i32=0;
                    if(prodf==1 && prov!=0 && c3==1){ dec=1; }
                    let clean:i32=0;
                    if(dec==1 && prov==1){ clean=1; }
                    n=w16_claim_out(ob,n,K,idx,seq,producer,decl,class,c3,prov,dec,clean);
                    if(dec==1){ ndec=ndec+1; }
                    if(clean==1){ nclean=nclean+1; }
                    ci=ci+1;
                }
            } else {
                n=w16_claim_out(ob,n,K,idx,seq,producer,decl,class,c3,0,0,0);
            }
            nrows=nrows+1;
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"SUM|16|");
    n=oi32(ob,n,nrows); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec); n=obyte(ob,n,124);
    n=oi32(ob,n,nclean);
    n=onl(ob,n);
    return n;
}
// W16 probe mode: P-CTG3 only
fn w16_probe(probes:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let pos:i32=0;
    let hostile_belief:i32=0;
    let benign_dec:i32=-1;
    let benign_c3:i32=-1;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let p3:i32=nth_pipe(line,3);
            let p4:i32=nth_pipe(line,4);
            let p5:i32=nth_pipe(line,5);
            let p8:i32=nth_pipe(line,8);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==16){
                let pidstr:[]u8=line[p1+1..p2];
                if(eq(pidstr,"P-CTG3")==1){
                    let conf:i32=parse_i32(line[p2+1..p3]);
                    let mrgF:i32=parse_i32(line[p3+1..p4]);
                    let producer:i32=parse_i32(line[p4+1..p5]);
                    let decl:i32=parse_i32(line[p5+1..p8]);
                    let pay:[]u8=line[p8+1..];
                    let c3:i32=0;
                    if(conf>=705 && mrgF>=3588){ c3=1; }
                    let po:i32=prod_lookup(prod,producer);
                    let class:i32=g32(prod,po+4);
                    let token:i32=g32(prod,po+8);
                    let env:i32=g32(prod,po+12);
                    let has_auth:i32=contains(pay,"authclaim:");
                    let has_fic:i32=contains(pay,"[fiction]");
                    let nlen:i32=canon_norm(pay,nbuf);
                    let ncl:i32=canon_clauses(nbuf,nlen,car);
                    let ci:i32=0;
                    while(ci<ncl){
                        let feat:i32=features(car,ci,ncl,class,token,env,decl,1,has_auth,has_fic,nbuf);
                        let parse:i32=car[ci*40+20] as i32;
                        let prov:i32=w16_prov(feat,class,1);
                        let dec:i32=0;
                        if(prov!=0 && c3==1){ dec=1; }
                        // hostile clause = the one that failed parse; benign = parsed
                        if(parse==0){
                            if(dec==1){ hostile_belief=1; }
                        } else {
                            benign_dec=dec;
                            benign_c3=c3;
                        }
                        n=w16_claim_out(ob,n,"Q",ci,-1,producer,decl,class,c3,prov,dec,dec);
                        ci=ci+1;
                    }
                }
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|16|P-CTG3|hostile_belief|");
    n=oi32(ob,n,hostile_belief);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"benign_dec|");
    n=oi32(ob,n,benign_dec);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"benign_c3|");
    n=oi32(ob,n,benign_c3);
    n=onl(ob,n);
    return n;
}

// ================= W17: Corroboration Codec =================
// key stride 160: sh@0(8) pid@8(4) oh@12(8) belief@20(1) contra@21(1)
// nprod@22(4) prodset@32 (16 x 8B: producer@0(4) class@4(1) c3or@5(1))
fn w17_cmp(keys:[]u8,idx:i32,sh:i64,pid:i32,oh:i64)i32 {
    let base:i32=idx*160;
    let ksh:i64=g64(keys,base);
    if(sh<ksh){ return -1; }
    if(sh>ksh){ return 1; }
    let kpid:i32=g32(keys,base+8);
    if(pid<kpid){ return -1; }
    if(pid>kpid){ return 1; }
    let koh:i64=g64(keys,base+12);
    if(oh<koh){ return -1; }
    if(oh>koh){ return 1; }
    return 0;
}
fn w17_find(keys:[]u8,nkeys:i32,sh:i64,pid:i32,oh:i64)i32 {
    let lo:i32=0;
    let hi:i32=nkeys;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        let c:i32=w17_cmp(keys,mid,sh,pid,oh);
        if(c==0){ return mid; }
        if(c<0){ hi=mid; } else { lo=mid+1; }
    }
    return -1;
}
fn w17_insert(keys:[]u8,nkeys:i32,sh:i64,pid:i32,oh:i64)i32 {
    let lo:i32=0;
    let hi:i32=nkeys;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        let c:i32=w17_cmp(keys,mid,sh,pid,oh);
        if(c<0){ hi=mid; } else { lo=mid+1; }
    }
    let i:i32=nkeys;
    while(i>lo){
        let j:i32=0;
        while(j<20){
            p64(keys,i*160+j*8,g64(keys,(i-1)*160+j*8));
            j=j+1;
        }
        i=i-1;
    }
    let base:i32=lo*160;
    p64(keys,base,sh);
    p32(keys,base+8,pid);
    p64(keys,base+12,oh);
    keys[base+20]=0;
    keys[base+21]=0;
    p32(keys,base+22,0);
    return lo;
}
fn w17_prod_upd(keys:[]u8,ki:i32,producer:i32,class:i32,c3:i32)void {
    let base:i32=ki*160;
    let nprod:i32=g32(keys,base+22);
    let i:i32=0;
    let found:i32=-1;
    while(i<nprod){
        if(g32(keys,base+32+i*8)==producer){ found=i; }
        i=i+1;
    }
    if(found>=0){
        if(c3==1){ keys[base+32+found*8+5]=1; }
    } else {
        p32(keys,base+32+nprod*8,producer);
        keys[base+32+nprod*8+4]=class as u8;
        keys[base+32+nprod*8+5]=c3 as u8;
        p32(keys,base+22,nprod+1);
    }
    return;
}
// clause record 64B: K@0(1) idx@4 seq@8 producer@12 decl@16 class@20 c3@24
// sh@28(8) pid@36 oh@40(8) keyidx@48
fn w17_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let keys:[]u8=nio_alloc(2048*160);
    let clrec:[]u8=nio_alloc(18040*64);
    let nkeys:i32=0;
    let ncl:i32=0;
    let pos:i32=0;
    // pass 1: build index
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let Kc:i32=line[0] as i32;
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let class:i32=0;
            if(po>=0){ class=g32(prod,po+4); }
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let base:i32=ncl*64;
                    clrec[base]=Kc as u8;
                    p32(clrec,base+4,idx);
                    p32(clrec,base+8,seq);
                    p32(clrec,base+12,producer);
                    p32(clrec,base+20,class);
                    p32(clrec,base+24,c3);
                    p32(clrec,base+48,-1);
                    if(parse==1){
                        let sh:i64=g64(car,ci*40);
                        let pid:i32=g32(car,ci*40+16);
                        let oh:i64=g64(car,ci*40+8);
                        p64(clrec,base+28,sh);
                        p32(clrec,base+36,pid);
                        p64(clrec,base+40,oh);
                        // contradiction check: same (sh,pid), different oh?
                        let k:i32=0;
                        let contra:i32=0;
                        while(k<nkeys){
                            if(g64(keys,k*160)==sh && g32(keys,k*160+8)==pid && g64(keys,k*160+12)!=oh){
                                contra=1;
                                keys[k*160+21]=1;
                                keys[k*160+20]=0;
                            }
                            k=k+1;
                        }
                        let ki:i32=w17_find(keys,nkeys,sh,pid,oh);
                        if(ki<0){
                            ki=w17_insert(keys,nkeys,sh,pid,oh);
                            nkeys=nkeys+1;
                            if(contra==1){ keys[ki*160+21]=1; }
                        }
                        w17_prod_upd(keys,ki,producer,class,c3);
                        p32(clrec,base+48,ki);
                    }
                    ncl=ncl+1;
                    ci=ci+1;
                }
            }
        }
        pos=eol+1;
    }
    // finalize belief per key
    let k:i32=0;
    while(k<nkeys){
        let base:i32=k*160;
        let nprod:i32=g32(keys,base+22);
        let wit:i32=0;
        let i:i32=0;
        while(i<nprod){
            let cc:i32=keys[base+32+i*8+4] as i32;
            let c3o:i32=keys[base+32+i*8+5] as i32;
            if(cc!=2 && c3o==1){ wit=wit+1; }
            i=i+1;
        }
        if(wit>=2 && keys[base+21]==0){ keys[base+20]=1; }
        k=k+1;
    }
    // pass 2: emit OUT
    let ndec:i32=0;
    let ci2:i32=0;
    while(ci2<ncl){
        let base:i32=ci2*64;
        let Kc:[]u8=clrec[base..base+1];
        let idx:i32=g32(clrec,base+4);
        let seq:i32=g32(clrec,base+8);
        let producer:i32=g32(clrec,base+12);
        let class:i32=g32(clrec,base+20);
        let c3:i32=g32(clrec,base+24);
        let ki:i32=g32(clrec,base+48);
        let dec:i32=0;
        let card:i32=0;
        if(ki>=0){
            card=g32(keys,ki*160+22);
            if(keys[ki*160+20]==1 && c3==1 && class!=2){ dec=1; }
        }
        n=ostr(ob,n,"OUT|17|");
        n=ostr(ob,n,Kc); n=obyte(ob,n,124);
        n=oi32(ob,n,idx); n=obyte(ob,n,124);
        n=oi32(ob,n,seq); n=obyte(ob,n,124);
        n=oi32(ob,n,producer); n=obyte(ob,n,124);
        n=oi32(ob,n,class); n=obyte(ob,n,124);
        n=oi32(ob,n,c3); n=obyte(ob,n,124);
        n=oi32(ob,n,dec); n=obyte(ob,n,124);
        n=oi32(ob,n,card);
        n=onl(ob,n);
        if(dec==1){ ndec=ndec+1; }
        ci2=ci2+1;
    }
    n=ostr(ob,n,"SUM|17|");
    n=oi32(ob,n,ncl); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec);
    n=onl(ob,n);
    return n;
}
// W17 probe: P-CC5 must stay quarantined
fn w17_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    // fresh single-key index; the CC-5 item arrives once -> quarantine
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let pos:i32=0;
    let dec:i32=-1;
    let card:i32=-1;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==17 && eq(line[p1+1..p2],"P-CC5")==1){
                let p3:i32=nth_pipe(line,3);
                let p4:i32=nth_pipe(line,4);
                let p8:i32=nth_pipe(line,8);
                let conf:i32=parse_i32(line[p2+1..p3]);
                let mrgF:i32=parse_i32(line[p3+1..p4]);
                let pay:[]u8=line[p8+1..];
                let c3:i32=0;
                if(conf>=705 && mrgF>=3588){ c3=1; }
                let nlen:i32=canon_norm(pay,nbuf);
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                // single sighting -> key has 1 producer -> belief=0
                dec=0;
                card=1;
                n=ostr(ob,n,"OUT|17|Q|0|-1|1|1|");
                n=oi32(ob,n,c3); n=obyte(ob,n,124);
                n=ostr(ob,n,"0|1");
                n=onl(ob,n);
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|17|P-CC5|dec|");
    n=oi32(ob,n,dec);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"card|");
    n=oi32(ob,n,card);
    n=onl(ob,n);
    return n;
}

// ================= W18: Negative-Knowledge Ledger =================
// gap stride 40: id@0(4) domain@4(8) pred@12(4) evmask@16(4) status@20(1)
// frank@21(1) foh@24(8). status: 0 OPEN, 1 FILLED, 2 CONTRADICTED.
fn w18_gap_init(gaps:[]u8)i32 {
    p32(gaps,0,1);
    p64(gaps,4,fnv("tape"));
    p32(gaps,12,1);
    p32(gaps,16,2);
    gaps[20]=0;
    p32(gaps,40,2);
    p64(gaps,44,fnv("probe"));
    p32(gaps,52,1);
    p32(gaps,56,2);
    gaps[60]=0;
    return 2;
}
fn w18_rank(class:i32)i32 {
    if(class==1){ return 4; }
    if(class==3){ return 3; }
    if(class==4){ return 2; }
    if(class==2){ return 1; }
    return 0;
}
// process one clause; emits OUT|18|...; returns dec via out param array r (r[0]=dec,r[1]=veto,r[2]=gap)
fn w18_claim(ob:[]u8,n:i32,gaps:[]u8,ngaps:i32,pub:[]u8,nPub:i32,K:[]u8,idx:i32,seq:i32,producer:i32,class:i32,c3:i32,feat:i32,sh:i64,pid:i32,oh:i64,r:[]u8)i32 {
    let rank:i32=w18_rank(class);
    let veto:i32=0;
    let gap:i32=-1;
    let gi:i32=0;
    while(gi<ngaps){
        let base:i32=gi*40;
        if(gaps[base+20]==1 && g64(gaps,base+4)==sh && g32(gaps,base+12)==pid){
            if(g64(gaps,base+24)!=oh && rank<=gaps[base+21] as i32){
                veto=1;
                gap=g32(gaps,base);
            }
        }
        gi=gi+1;
    }
    let dec:i32=0;
    if(veto==0 && c3==1){
        dec=1;
        // conflict check: higher rank vs filled gap with different object?
        // (kept filler; emit KB if rank>filler_rank and object differs)
        let gj:i32=0;
        while(gj<ngaps){
            let base:i32=gj*40;
            if(gaps[base+20]==1 && g64(gaps,base+4)==sh && g32(gaps,base+12)==pid && g64(gaps,base+24)!=oh && rank>gaps[base+21] as i32){
                n=ostr(ob,n,"KB|18|CONFLICT|gap|");
                n=oi32(ob,n,g32(gaps,base));
                n=onl(ob,n);
            }
            gj=gj+1;
        }
        // tag: fill lowest OPEN matching gap
        let gk:i32=0;
        while(gk<ngaps){
            let base:i32=gk*40;
            if(gap==-1 && gaps[base+20]==0 && g64(gaps,base+4)==sh && g32(gaps,base+12)==pid && (feat&g32(gaps,base+16))==g32(gaps,base+16)){
                gaps[base+20]=1;
                gaps[base+21]=rank as u8;
                p64(gaps,base+24,oh);
                gap=g32(gaps,base);
            }
            gk=gk+1;
        }
        // contradiction discovery at publish time
        let pi:i32=0;
        let contra:i32=0;
        while(pi<nPub){
            if(g64(pub,pi*24)==sh && g32(pub,pi*24+8)==pid && g64(pub,pi*24+12)!=oh){ contra=1; }
            pi=pi+1;
        }
        if(contra==1){
            // open CONTRADICTED gap if none
            let has:i32=0;
            let gl:i32=0;
            while(gl<ngaps){
                if(gaps[gl*40+20]==2 && g64(gaps,gl*40+4)==sh && g32(gaps,gl*40+12)==pid){ has=1; }
                gl=gl+1;
            }
            if(has==0){
                // (cap: ngaps fixed at 2 seeds + room; we allocated 64)
            }
        }
        // record published
        p64(pub,nPub*24,sh);
        p32(pub,nPub*24+8,pid);
        p64(pub,nPub*24+12,oh);
        p32(r,0,nPub+1);
    } else {
        p32(r,0,nPub);
    }
    n=ostr(ob,n,"OUT|18|");
    n=ostr(ob,n,K); n=obyte(ob,n,124);
    n=oi32(ob,n,idx); n=obyte(ob,n,124);
    n=oi32(ob,n,seq); n=obyte(ob,n,124);
    n=oi32(ob,n,producer); n=obyte(ob,n,124);
    n=oi32(ob,n,class); n=obyte(ob,n,124);
    n=oi32(ob,n,c3); n=obyte(ob,n,124);
    n=oi32(ob,n,dec); n=obyte(ob,n,124);
    n=oi32(ob,n,veto); n=obyte(ob,n,124);
    n=oi32(ob,n,gap);
    n=onl(ob,n);
    p32(r,4,dec);
    p32(r,8,veto);
    p32(r,12,gap);
    return n;
}
fn w18_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let gaps:[]u8=nio_alloc(64*40);
    let pub:[]u8=nio_alloc(4096*24);
    let r:[]u8=nio_alloc(16);
    let ngaps:i32=w18_gap_init(gaps);
    p32(r,0,0);
    let pos:i32=0;
    let nrows:i32=0;
    let ndec:i32=0;
    let nveto:i32=0;
    let ntag:i32=0;
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let K:[]u8=line[0..1];
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    if(parse==1){
                        let feat:i32=features(car,ci,nclauses,class,token,env,0,1,has_auth,has_fic,nbuf);
                        // note: decl not used by NKL; pass 0
                        let sh:i64=g64(car,ci*40);
                        let pid:i32=g32(car,ci*40+16);
                        let oh:i64=g64(car,ci*40+8);
                        let nPub:i32=g32(r,0);
                        n=w18_claim(ob,n,gaps,ngaps,pub,nPub,K,idx,seq,producer,class,c3,feat,sh,pid,oh,r);
                        if(g32(r,4)==1){ ndec=ndec+1; }
                        if(g32(r,8)==1){ nveto=nveto+1; }
                        if(g32(r,12)>=0){ ntag=ntag+1; }
                    }
                    ci=ci+1;
                }
            }
            nrows=nrows+1;
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"SUM|18|");
    n=oi32(ob,n,nrows); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec); n=obyte(ob,n,124);
    n=oi32(ob,n,nveto); n=obyte(ob,n,124);
    n=oi32(ob,n,ntag);
    n=onl(ob,n);
    return n;
}
// W18 probe: P-NKL2A then P-NKL2B
fn w18_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let gaps:[]u8=nio_alloc(64*40);
    let pub:[]u8=nio_alloc(64*24);
    let r:[]u8=nio_alloc(16);
    let ngaps:i32=w18_gap_init(gaps);
    p32(r,0,0);
    let pos:i32=0;
    let decA:i32=-1;
    let decB:i32=-1;
    let vetoB:i32=-1;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==18){
                let pidstr:[]u8=line[p1+1..p2];
                let isA:i32=eq(pidstr,"P-NKL2A");
                let isB:i32=eq(pidstr,"P-NKL2B");
                if(isA==1 || isB==1){
                    let p3:i32=nth_pipe(line,3);
                    let p4:i32=nth_pipe(line,4);
                    let p5:i32=nth_pipe(line,5);
                    let p8:i32=nth_pipe(line,8);
                    let conf:i32=parse_i32(line[p2+1..p3]);
                    let mrgF:i32=parse_i32(line[p3+1..p4]);
                    let producer:i32=parse_i32(line[p4+1..p5]);
                    let pay:[]u8=line[p8+1..];
                    let c3:i32=0;
                    if(conf>=705 && mrgF>=3588){ c3=1; }
                    let po:i32=prod_lookup(prod,producer);
                    let class:i32=g32(prod,po+4);
                    let token:i32=g32(prod,po+8);
                    let env:i32=g32(prod,po+12);
                    let nlen:i32=canon_norm(pay,nbuf);
                    let nclauses:i32=canon_clauses(nbuf,nlen,car);
                    let feat:i32=features(car,0,nclauses,class,token,env,0,1,0,0,nbuf);
                    let sh:i64=g64(car,0);
                    let pid:i32=g32(car,16);
                    let oh:i64=g64(car,8);
                    let nPub:i32=g32(r,0);
                    n=w18_claim(ob,n,gaps,ngaps,pub,nPub,"Q",0,-1,producer,class,c3,feat,sh,pid,oh,r);
                    if(isA==1){ decA=g32(r,4); }
                    else { decB=g32(r,4); vetoB=g32(r,8); }
                }
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|18|P-NKL2|decA|");
    n=oi32(ob,n,decA);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"decB|");
    n=oi32(ob,n,decB);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"vetoB|");
    n=oi32(ob,n,vetoB);
    n=onl(ob,n);
    return n;
}

// ================= W19: Admission Futures =================
// future stride 48: fid@0(4) key@4(8) expected@12(8) status@20(1)
// sprod@24(4) sclass@28(4) oprod@32(4) oclass@36(4) c3@40(4)
// status: 0 OPEN, 1 TRUE, 2 FALSE, 3 UNSTAKED
// fbk stride 16: key@0(8) fid@8(4), sorted by (key,fid)
// clause record 64B @48: fid (i32)
fn w19_expected(nbuf:[]u8,oos:i32,olen:i32,sh:i64)i64 {
    let h:i64=14695981039346656037;
    let i:i32=0;
    while(i<olen){ h=(h^(nbuf[oos+i] as i64))*1099511628211; i=i+1; }
    let b:i32=0;
    while(b<8){
        let by:i64=(sh>>(b*8))&255;
        h=(h^by)*1099511628211;
        b=b+1;
    }
    return h;
}
fn w19_keyonly(sh:i64)i64 {
    let h:i64=14695981039346656037;
    let b:i32=0;
    while(b<8){
        let by:i64=(sh>>(b*8))&255;
        h=(h^by)*1099511628211;
        b=b+1;
    }
    return h;
}
fn w19_fbk_lb(fbk:[]u8,nfbk:i32,key:i64)i32 {
    let lo:i32=0;
    let hi:i32=nfbk;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        if(g64(fbk,mid*16)<key){ lo=mid+1; } else { hi=mid; }
    }
    return lo;
}
fn w19_settle(futs:[]u8,fbk:[]u8,nfbk:i32,key:i64,test:i64,producer:i32,class:i32,ob:[]u8,n:i32)i32 {
    let at:i32=w19_fbk_lb(fbk,nfbk,key);
    while(at<nfbk && g64(fbk,at*16)==key){
        let fid:i32=g32(fbk,at*16+8);
        let base:i32=fid*48;
        if(futs[base+20]==0){
            let oprod:i32=g32(futs,base+32);
            if(producer!=oprod && class!=2){
                if(test==g64(futs,base+12)){
                    futs[base+20]=1;
                    p32(futs,base+24,producer);
                    p32(futs,base+28,class);
                } else {
                    futs[base+20]=2;
                    p32(futs,base+24,producer);
                    p32(futs,base+28,class);
                    n=ostr(ob,n,"KB|19|REVOKE|fid|");
                    n=oi32(ob,n,fid);
                    n=onl(ob,n);
                }
            }
        }
        at=at+1;
    }
    return n;
}
fn w19_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let futs:[]u8=nio_alloc(32768*48);
    let fbk:[]u8=nio_alloc(32768*16);
    let clrec:[]u8=nio_alloc(18040*64);
    let nfut:i32=0;
    let nfbk:i32=0;
    let ncl:i32=0;
    let pos:i32=0;
    // pass 1: settle + attach
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let Kc:i32=line[0] as i32;
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let class:i32=0;
            if(po>=0){ class=g32(prod,po+4); }
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let base:i32=ncl*64;
                    clrec[base]=Kc as u8;
                    p32(clrec,base+4,idx);
                    p32(clrec,base+8,seq);
                    p32(clrec,base+12,producer);
                    p32(clrec,base+20,class);
                    p32(clrec,base+24,c3);
                    p32(clrec,base+48,-1);
                    if(parse==1){
                        let sh:i64=g64(car,ci*40);
                        let oos:i32=g32(car,ci*40+32);
                        let olen:i32=g32(car,ci*40+36);
                        p64(clrec,base+28,sh);
                        p32(clrec,base+36,g32(car,ci*40+16));
                        p64(clrec,base+40,g64(car,ci*40+8));
                        // settle prior futures with this clause
                        let test:i64=w19_expected(nbuf,oos,olen,sh);
                        n=w19_settle(futs,fbk,nfbk,sh,test,producer,class,ob,n);
                        // attach own future (tape rows: valid future)
                        let fid:i32=nfut;
                        let fb:i32=fid*48;
                        p32(futs,fb,fid);
                        p64(futs,fb+4,sh);
                        p64(futs,fb+12,test);
                        p32(futs,fb+32,producer);
                        p32(futs,fb+36,class);
                        p32(futs,fb+40,c3);
                        futs[fb+20]=0;
                        // sorted insert into fbk
                        let at:i32=w19_fbk_lb(fbk,nfbk,sh);
                        while(at<nfbk && g64(fbk,at*16)==sh){ at=at+1; }
                        let ii:i32=nfbk;
                        while(ii>at){
                            p64(fbk,ii*16,g64(fbk,(ii-1)*16));
                            p32(fbk,ii*16+8,g32(fbk,(ii-1)*16+8));
                            ii=ii-1;
                        }
                        p64(fbk,at*16,sh);
                        p32(fbk,at*16+8,fid);
                        nfbk=nfbk+1;
                        nfut=nfut+1;
                        p32(clrec,base+48,fid);
                    }
                    ncl=ncl+1;
                    ci=ci+1;
                }
            }
        }
        pos=eol+1;
    }
    // pass 2: emit OUT with final status
    let ndec:i32=0;
    let nbelief:i32=0;
    let ci2:i32=0;
    while(ci2<ncl){
        let base:i32=ci2*64;
        let Kc:[]u8=clrec[base..base+1];
        let idx:i32=g32(clrec,base+4);
        let seq:i32=g32(clrec,base+8);
        let producer:i32=g32(clrec,base+12);
        let class:i32=g32(clrec,base+20);
        let c3:i32=g32(clrec,base+24);
        let fid:i32=g32(clrec,base+48);
        let status:i32=-1;
        let sclass:i32=-1;
        if(fid>=0){
            status=futs[fid*48+20] as i32;
            if(status==1){ sclass=g32(futs,fid*48+28); }
        }
        let dec:i32=0;
        if(status==1 && c3==1){ dec=1; nbelief=nbelief+1; }
        n=ostr(ob,n,"OUT|19|");
        n=ostr(ob,n,Kc); n=obyte(ob,n,124);
        n=oi32(ob,n,idx); n=obyte(ob,n,124);
        n=oi32(ob,n,seq); n=obyte(ob,n,124);
        n=oi32(ob,n,producer); n=obyte(ob,n,124);
        n=oi32(ob,n,class); n=obyte(ob,n,124);
        n=oi32(ob,n,c3); n=obyte(ob,n,124);
        n=oi32(ob,n,dec); n=obyte(ob,n,124);
        n=oi32(ob,n,status); n=obyte(ob,n,124);
        n=oi32(ob,n,sclass);
        n=onl(ob,n);
        if(dec==1){ ndec=ndec+1; }
        ci2=ci2+1;
    }
    n=ostr(ob,n,"SUM|19|");
    n=oi32(ob,n,ncl); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec); n=obyte(ob,n,124);
    n=oi32(ob,n,nbelief);
    n=onl(ob,n);
    return n;
}
// W19 probe: P-AF2 (bad future) must stay UNSTAKED
fn w19_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let pos:i32=0;
    let status:i32=-2;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==19 && eq(line[p1+1..p2],"P-AF2")==1){
                let p6:i32=nth_pipe(line,6);
                let p7:i32=nth_pipe(line,7);
                let p8:i32=nth_pipe(line,8);
                let fok:i32=parse_i32(line[p6+1..p7]);
                let pay:[]u8=line[p8+1..];
                let nlen:i32=canon_norm(pay,nbuf);
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let sh:i64=g64(car,0);
                let oos:i32=g32(car,32);
                let olen:i32=g32(car,36);
                let correct:i64=w19_expected(nbuf,oos,olen,sh);
                let attached:i64=w19_keyonly(sh);
                if(fok==1){ attached=correct; }
                // cover check at insert
                if(attached==correct){ status=0; } else { status=3; }
                n=ostr(ob,n,"OUT|19|Q|0|-1|1|1|1|0|");
                n=oi32(ob,n,status);
                n=ostr(ob,n,"|-1");
                n=onl(ob,n);
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|19|P-AF2|status|");
    n=oi32(ob,n,status);
    n=onl(ob,n);
    return n;
}

// ================= W20: Epistemic-Type Binding =================
// arenas: 0 REJECT, 1 FACT, 2 HYPOTHESIS, 3 REPORT, 4 FICTION
// keyidx stride 64: sh@0(8) pid@8(4) oh@12(8) nprod@20(4) prods@24(8x4)
fn w20_keyfind(keys:[]u8,nkeys:i32,sh:i64,pid:i32,oh:i64)i32 {
    let lo:i32=0;
    let hi:i32=nkeys;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        let base:i32=mid*64;
        let c:i32=0;
        let ksh:i64=g64(keys,base);
        if(sh<ksh){ c=-1; } else if(sh>ksh){ c=1; }
        else {
            let kpid:i32=g32(keys,base+8);
            if(pid<kpid){ c=-1; } else if(pid>kpid){ c=1; }
            else {
                let koh:i64=g64(keys,base+12);
                if(oh<koh){ c=-1; } else if(oh>koh){ c=1; }
            }
        }
        if(c==0){ return mid; }
        if(c<0){ hi=mid; } else { lo=mid+1; }
    }
    return -1;
}
fn w20_keyins(keys:[]u8,nkeys:i32,sh:i64,pid:i32,oh:i64,producer:i32)i32 {
    let ki:i32=w20_keyfind(keys,nkeys,sh,pid,oh);
    if(ki>=0){
        // append producer if new
        let base:i32=ki*64;
        let nprod:i32=g32(keys,base+20);
        let i:i32=0;
        let found:i32=0;
        while(i<nprod){
            if(g32(keys,base+24+i*4)==producer){ found=1; }
            i=i+1;
        }
        if(found==0 && nprod<8){
            p32(keys,base+24+nprod*4,producer);
            p32(keys,base+20,nprod+1);
        }
        return nkeys;
    }
    // sorted insert of a new key; returns new nkeys
    let lo:i32=0;
    let hi:i32=nkeys;
    while(lo<hi){
        let mid:i32=(lo+hi)/2;
        let base:i32=mid*64;
        let c:i32=0;
        let ksh:i64=g64(keys,base);
        if(sh<ksh){ c=-1; } else if(sh>ksh){ c=1; }
        else {
            let kpid:i32=g32(keys,base+8);
            if(pid<kpid){ c=-1; } else if(pid>kpid){ c=1; }
            else {
                let koh:i64=g64(keys,base+12);
                if(oh<koh){ c=-1; } else if(oh>koh){ c=1; }
            }
        }
        if(c<0){ hi=mid; } else { lo=mid+1; }
    }
    let i:i32=nkeys;
    while(i>lo){
        let j:i32=0;
        while(j<8){ p64(keys,i*64+j*8,g64(keys,(i-1)*64+j*8)); j=j+1; }
        i=i-1;
    }
    let base:i32=lo*64;
    p64(keys,base,sh);
    p32(keys,base+8,pid);
    p64(keys,base+12,oh);
    p32(keys,base+20,1);
    p32(keys,base+24,producer);
    return nkeys+1;
}
// corroborated: key exists with a different EXT producer
fn w20_corroborated(keys:[]u8,nkeys:i32,sh:i64,pid:i32,oh:i64,producer:i32,prod:[]u8)i32 {
    let ki:i32=w20_keyfind(keys,nkeys,sh,pid,oh);
    if(ki<0){ return 0; }
    let base:i32=ki*64;
    let nprod:i32=g32(keys,base+20);
    let i:i32=0;
    while(i<nprod){
        let p:i32=g32(keys,base+24+i*4);
        if(p!=producer){
            let po:i32=prod_lookup(prod,p);
            if(po>=0 && g32(prod,po+4)==1){ return 1; }
        }
        i=i+1;
    }
    return 0;
}
fn w20_run(tape:[]u8,disp:[]u8,prod:[]u8,zerodecl:i32,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let keys:[]u8=nio_alloc(2048*64);
    let nkeys:i32=0;
    let pos:i32=0;
    let nrows:i32=0;
    let nfact:i32=0;
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let K:[]u8=line[0..1];
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let decl:i32=g32(f,28);
            if(zerodecl==1){ decl=0; }
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let prodf:i32=0;
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let arena:i32=0;
                    if(parse==1){
                        let feat:i32=features(car,ci,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                        let sh:i64=g64(car,ci*40);
                        let pid:i32=g32(car,ci*40+16);
                        let oh:i64=g64(car,ci*40+8);
                        if(class==2 || (feat&2048)==2048){ arena=4; }
                        else if(class==4){ arena=3; }
                        else if((feat&64)==64 || (feat&1)==1 || (feat&1024)==1024){ arena=0; }
                        else if(class==1 && c3==1 && w20_corroborated(keys,nkeys,sh,pid,oh,producer,prod)==1){ arena=1; }
                        else if(c3==1){ arena=2; }
                        else { arena=0; }
                        // insert claim into index (after the corroboration check)
                        nkeys=w20_keyins(keys,nkeys,sh,pid,oh,producer);
                        if(nkeys>2048){ nkeys=2048; }
                    }
                    let dec:i32=0;
                    if(arena==1){ dec=1; nfact=nfact+1; }
                    n=ostr(ob,n,"OUT|20|");
                    n=ostr(ob,n,K); n=obyte(ob,n,124);
                    n=oi32(ob,n,idx); n=obyte(ob,n,124);
                    n=oi32(ob,n,seq); n=obyte(ob,n,124);
                    n=oi32(ob,n,producer); n=obyte(ob,n,124);
                    n=oi32(ob,n,decl); n=obyte(ob,n,124);
                    n=oi32(ob,n,class); n=obyte(ob,n,124);
                    n=oi32(ob,n,c3); n=obyte(ob,n,124);
                    n=oi32(ob,n,dec); n=obyte(ob,n,124);
                    n=oi32(ob,n,arena);
                    n=onl(ob,n);
                    ci=ci+1;
                }
            }
            nrows=nrows+1;
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"SUM|20|");
    n=oi32(ob,n,nrows); n=obyte(ob,n,124);
    n=oi32(ob,n,nfact);
    n=onl(ob,n);
    return n;
}
// W20 probe: P-ETB3 -> REPORT; belief_get(payload) must MISS
fn w20_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let pos:i32=0;
    let arena:i32=-1;
    let miss:i32=-1;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==20 && eq(line[p1+1..p2],"P-ETB3")==1){
                let p4:i32=nth_pipe(line,4);
                let p5:i32=nth_pipe(line,5);
                let p8:i32=nth_pipe(line,8);
                let producer:i32=parse_i32(line[p4+1..p5]);
                let pay:[]u8=line[p8+1..];
                let po:i32=prod_lookup(prod,producer);
                let class:i32=g32(prod,po+4);
                let token:i32=g32(prod,po+8);
                let env:i32=g32(prod,po+12);
                let nlen:i32=canon_norm(pay,nbuf);
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let feat:i32=features(car,0,nclauses,class,token,env,0,1,0,0,nbuf);
                if(class==2 || (feat&2048)==2048){ arena=4; }
                else if(class==4){ arena=3; }
                else if((feat&64)==64 || (feat&1)==1 || (feat&1024)==1024){ arena=0; }
                else { arena=2; }
                // belief_get reads FACT only; this claim is in REPORT -> MISS
                if(arena==1){ miss=0; } else { miss=1; }
                n=ostr(ob,n,"OUT|20|Q|0|-1|6|4|");
                n=oi32(ob,n,class);
                n=ostr(ob,n,"|1|0|");
                n=oi32(ob,n,arena);
                n=onl(ob,n);
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|20|P-ETB3|arena|");
    n=oi32(ob,n,arena);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"belief_get_miss|");
    n=oi32(ob,n,miss);
    n=onl(ob,n);
    return n;
}

// ================= W21: Deterministic Immune Repertoire =================
// receptors (ADD §6, sorted by id): id1 b6, id2 b0|b2, id3 b10, id4 !b7, id5 b11
fn w21_match(feat:i32) i32 {
    // returns lowest hitting receptor id, or 0
    if((feat&64)==64){ return 1; }
    if((feat&5)==5){ return 2; }
    if((feat&1024)==1024){ return 3; }
    if((feat&128)==0){ return 4; }
    if((feat&2048)==2048){ return 5; }
    return 0;
}
fn w21_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let pos:i32=0;
    let nrows:i32=0;
    let ndec:i32=0;
    let nveto:i32=0;
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let K:[]u8=line[0..1];
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let decl:i32=g32(f,28);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let prodf:i32=0;
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let pid:i32=g32(car,ci*40+16);
                    let feat:i32=features(car,ci,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                    // for parse-fail, b7=0; features uses parse bit from car
                    let rid:i32=w21_match(feat);
                    let dec:i32=0;
                    let veto:i32=0;
                    if(rid>0){ veto=1; nveto=nveto+1; }
                    else if(c3==1){ dec=1; ndec=ndec+1; }
                    n=ostr(ob,n,"OUT|21|");
                    n=ostr(ob,n,K); n=obyte(ob,n,124);
                    n=oi32(ob,n,idx); n=obyte(ob,n,124);
                    n=oi32(ob,n,seq); n=obyte(ob,n,124);
                    n=oi32(ob,n,producer); n=obyte(ob,n,124);
                    n=oi32(ob,n,class); n=obyte(ob,n,124);
                    n=oi32(ob,n,c3); n=obyte(ob,n,124);
                    n=oi32(ob,n,dec); n=obyte(ob,n,124);
                    n=oi32(ob,n,veto); n=obyte(ob,n,124);
                    n=oi32(ob,n,rid);
                    n=onl(ob,n);
                    ci=ci+1;
                }
            } else {
                // canonicalization failed -> parse-fail -> receptor 4
                let rid:i32=4;
                n=ostr(ob,n,"OUT|21|");
                n=ostr(ob,n,K); n=obyte(ob,n,124);
                n=oi32(ob,n,idx); n=obyte(ob,n,124);
                n=oi32(ob,n,seq); n=obyte(ob,n,124);
                n=oi32(ob,n,producer); n=obyte(ob,n,124);
                n=oi32(ob,n,class); n=obyte(ob,n,124);
                n=oi32(ob,n,c3); n=obyte(ob,n,124);
                n=ostr(ob,n,"0|1|4");
                n=onl(ob,n);
                nveto=nveto+1;
            }
            nrows=nrows+1;
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"SUM|21|");
    n=oi32(ob,n,nrows); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec); n=obyte(ob,n,124);
    n=oi32(ob,n,nveto);
    n=onl(ob,n);
    return n;
}
// W21 probe: P-DIR5 (expect veto rid=1) + 8 benign anchors (expect no veto)
fn w21_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let pos:i32=0;
    let dir5_rid:i32=-1;
    let anchor_veto:i32=0;
    let nanchor:i32=0;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==21){
                let pidstr:[]u8=line[p1+1..p2];
                let isDir5:i32=eq(pidstr,"P-DIR5");
                let isAnchor:i32=eq(pidstr,"ANCHOR");
                if(isDir5==1 || isAnchor==1){
                    let p5:i32=nth_pipe(line,5);
                    let p6:i32=nth_pipe(line,6);
                    let p8:i32=nth_pipe(line,8);
                    let producer:i32=parse_i32(line[nth_pipe(line,4)+1..p5]);
                    let decl:i32=parse_i32(line[p5+1..p6]);
                    let pay:[]u8=line[p8+1..];
                    let po:i32=prod_lookup(prod,producer);
                    let prodf:i32=0;
                    let class:i32=0;
                    let token:i32=0;
                    let env:i32=0;
                    if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
                    let has_auth:i32=contains(pay,"authclaim:");
                    let has_fic:i32=contains(pay,"[fiction]");
                    let nlen:i32=canon_norm(pay,nbuf);
                    let rid:i32=0;
                    if(nlen>=0){
                        let nclauses:i32=canon_clauses(nbuf,nlen,car);
                        let pid:i32=g32(car,16);
                        let feat:i32=features(car,0,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                        rid=w21_match(feat);
                    } else {
                        rid=4;
                    }
                    let veto:i32=0;
                    if(rid>0){ veto=1; }
                    n=ostr(ob,n,"OUT|21|Q|0|-1|");
                    n=oi32(ob,n,producer); n=obyte(ob,n,124);
                    n=oi32(ob,n,class); n=obyte(ob,n,124);
                    n=ostr(ob,n,"1|");
                    n=oi32(ob,n,veto); n=obyte(ob,n,124);
                    n=oi32(ob,n,rid);
                    n=onl(ob,n);
                    if(isDir5==1){ dir5_rid=rid; }
                    else { nanchor=nanchor+1; if(veto==1){ anchor_veto=anchor_veto+1; } }
                }
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|21|P-DIR5|rid|");
    n=oi32(ob,n,dir5_rid);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"anchors|");
    n=oi32(ob,n,nanchor);
    n=obyte(ob,n,124);
    n=ostr(ob,n,"anchor_veto|");
    n=oi32(ob,n,anchor_veto);
    n=onl(ob,n);
    return n;
}

// ================= W22: Two-Phase Commit =================
// store indexes: payhash->declprov list (dup check), belief (sh,pid,oh) list
fn w22_rec_hash(sh:i64,pid:i32,oh:i64,feat:i32,c3:i32,producer:i32,decl:i32,prodf:i32)i64 {
    let b:[]u8=nio_alloc(40);
    p64(b,0,sh);
    p32(b,8,pid);
    p64(b,12,oh);
    p32(b,20,feat);
    p32(b,24,c3);
    p32(b,28,producer);
    p32(b,32,decl);
    p32(b,36,prodf);
    return fnv(b);
}
fn w22_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let payidx:[]u8=nio_alloc(8192*16);  // payhash@0(8) decl@8(4), npay
    let belief:[]u8=nio_alloc(8192*24);  // sh@0(8) pid@8(4) oh@12(8), nbel
    let npay:i32=0;
    let nbel:i32=0;
    let pos:i32=0;
    let nrows:i32=0;
    let ncommit:i32=0;
    let ndiv:i32=0;
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let K:[]u8=line[0..1];
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let decl:i32=g32(f,28);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let prodf:i32=0;
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let fast:i32=0;
                    let slow:i32=0;
                    let hf:i64=0;
                    let hs:i64=0;
                    let div:i32=0;
                    if(parse==1){
                        let pid:i32=g32(car,ci*40+16);
                        let feat:i32=features(car,ci,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                        let sh:i64=g64(car,ci*40);
                        let oh:i64=g64(car,ci*40+8);
                        // FAST: local only
                        let prov:i32=w16_prov(feat,class,prodf);
                        let prov_ok:i32=0;
                        if(prodf==1 && prov!=0){ prov_ok=1; }
                        let mask_pass:i32=0;
                        if((feat&1024)==0){ mask_pass=1; }
                        if(c3==1 && prov_ok==1 && mask_pass==1){ fast=1; }
                        hf=w22_rec_hash(sh,pid,oh,feat,c3,producer,decl,prodf);
                        // SLOW: recompute + store checks
                        let feat2:i32=features(car,ci,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                        let prov2:i32=w16_prov(feat2,class,prodf);
                        let slow_prov_ok:i32=0;
                        if(prodf==1 && (feat2&1)==0 && prov2!=0){ slow_prov_ok=1; }
                        // duplicate-declaration: same payhash, different decl
                        let ph:i64=fnv(nbuf[0..nlen]);
                        let dup:i32=0;
                        let qi:i32=0;
                        while(qi<npay){
                            if(g64(payidx,qi*16)==ph && g32(payidx,qi*16+8)!=decl){ dup=1; }
                            qi=qi+1;
                        }
                        // contradiction: same (sh,pid), different oh in BELIEF
                        let contra:i32=0;
                        let bi:i32=0;
                        while(bi<nbel){
                            if(g64(belief,bi*24)==sh && g32(belief,bi*24+8)==pid && g64(belief,bi*24+12)!=oh){ contra=1; }
                            bi=bi+1;
                        }
                        if(c3==1 && slow_prov_ok==1 && dup==0 && contra==0){ slow=1; }
                        hs=w22_rec_hash(sh,pid,oh,feat2,c3,producer,decl,prodf);
                        // record payidx
                        if(npay<8192){
                            p64(payidx,npay*16,ph);
                            p32(payidx,npay*16+8,decl);
                            npay=npay+1;
                        }
                    }
                    let dec:i32=0;
                    if(fast==1 && slow==1 && hf==hs){
                        dec=1;
                        ncommit=ncommit+1;
                        // record belief
                        if(parse==1 && nbel<8192){
                            let sh:i64=g64(car,ci*40);
                            let pid:i32=g32(car,ci*40+16);
                            let oh:i64=g64(car,ci*40+8);
                            p64(belief,nbel*24,sh);
                            p32(belief,nbel*24+8,pid);
                            p64(belief,nbel*24+12,oh);
                            nbel=nbel+1;
                        }
                    } else if(parse==1 && (fast!=slow || hf!=hs)){
                        div=1;
                        ndiv=ndiv+1;
                        n=ostr(ob,n,"KB|22|DIVERGENCE|seq|");
                        n=oi32(ob,n,seq);
                        n=onl(ob,n);
                    }
                    n=ostr(ob,n,"OUT|22|");
                    n=ostr(ob,n,K); n=obyte(ob,n,124);
                    n=oi32(ob,n,idx); n=obyte(ob,n,124);
                    n=oi32(ob,n,seq); n=obyte(ob,n,124);
                    n=oi32(ob,n,producer); n=obyte(ob,n,124);
                    n=oi32(ob,n,class); n=obyte(ob,n,124);
                    n=oi32(ob,n,c3); n=obyte(ob,n,124);
                    n=oi32(ob,n,dec); n=obyte(ob,n,124);
                    n=oi32(ob,n,fast); n=obyte(ob,n,124);
                    n=oi32(ob,n,slow); n=obyte(ob,n,124);
                    n=oi64(ob,n,hf); n=obyte(ob,n,124);
                    n=oi64(ob,n,hs); n=obyte(ob,n,124);
                    n=oi32(ob,n,div);
                    n=onl(ob,n);
                    ci=ci+1;
                }
            }
            nrows=nrows+1;
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"SUM|22|");
    n=oi32(ob,n,nrows); n=obyte(ob,n,124);
    n=oi32(ob,n,ncommit); n=obyte(ob,n,124);
    n=oi32(ob,n,ndiv);
    n=onl(ob,n);
    return n;
}
// W22 probe: P-TPC2 with flip=1 must emit DivergenceRec
fn w22_probe(probes:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(probes.len);
    let car:[]u8=nio_alloc((probes.len+1)*40);
    let pos:i32=0;
    let div:i32=-1;
    while(pos<probes.len){
        let eol:i32=pos;
        while(eol<probes.len && probes[eol]!=10){ eol=eol+1; }
        let line:[]u8=probes[pos..eol];
        if(line.len>0 && line[0]==81){
            let p0:i32=nth_pipe(line,0);
            let p1:i32=nth_pipe(line,1);
            let p2:i32=nth_pipe(line,2);
            let des:i32=parse_i32(line[p0+1..p1]);
            if(des==22 && eq(line[p1+1..p2],"P-TPC2")==1){
                let p5:i32=nth_pipe(line,5);
                let p6:i32=nth_pipe(line,6);
                let p7:i32=nth_pipe(line,7);
                let p8:i32=nth_pipe(line,8);
                let producer:i32=parse_i32(line[nth_pipe(line,4)+1..p5]);
                let decl:i32=parse_i32(line[p5+1..p6]);
                let flip:i32=parse_i32(line[p7+1..p8]);
                let pay:[]u8=line[p8+1..];
                let po:i32=prod_lookup(prod,producer);
                let class:i32=g32(prod,po+4);
                let token:i32=g32(prod,po+8);
                let env:i32=g32(prod,po+12);
                let nlen:i32=canon_norm(pay,nbuf);
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let pid:i32=g32(car,16);
                let feat:i32=features(car,0,nclauses,class,token,env,decl,1,0,0,nbuf);
                let sh:i64=g64(car,0);
                let oh:i64=g64(car,8);
                let c3:i32=1;
                let prov:i32=w16_prov(feat,class,1);
                let fast:i32=0;
                if(c3==1 && prov!=0 && (feat&1024)==0){ fast=1; }
                let hf:i64=w22_rec_hash(sh,pid,oh,feat,c3,producer,decl,1);
                // slow flips b5 before recomputation
                let feat2:i32=feat;
                if(flip==1){ feat2=feat^32; }
                let hs:i64=w22_rec_hash(sh,pid,oh,feat2,c3,producer,decl,1);
                let slow:i32=fast;  // (store checks pass on fresh state)
                div=0;
                if(fast==1 && slow==1 && hf!=hs){
                    div=1;
                    n=ostr(ob,n,"KB|22|DIVERGENCE|probe|P-TPC2|flip|");
                    n=oi32(ob,n,flip);
                    n=onl(ob,n);
                }
                n=ostr(ob,n,"OUT|22|Q|0|-1|1|1|1|0|");
                n=oi32(ob,n,fast); n=obyte(ob,n,124);
                n=oi32(ob,n,slow); n=obyte(ob,n,124);
                n=oi64(ob,n,hf); n=obyte(ob,n,124);
                n=oi64(ob,n,hs); n=obyte(ob,n,124);
                n=oi32(ob,n,div);
                n=onl(ob,n);
            }
        }
        pos=eol+1;
    }
    n=ostr(ob,n,"KB|22|P-TPC2|divergence|");
    n=oi32(ob,n,div);
    n=onl(ob,n);
    return n;
}

// ================= W23: Triggered Rejection Re-adjudication =================
// reasons: 1 PARSE_FAIL, 2 PROV_MISMATCH, 3 AUTH_FAIL, 4 FICTION, 5 SINGLETON, 6 BELIEF
// reject stride 48: seq@0(4) key@4(8) reason@12(4) status@16(1) producer@20(4)
// conf@24(4) mrgF@28(4) c3@32(4) trig@36(4). status: 0 OPEN, 1 PROMOTED, 2 UPHELD
// claim stride 16: key@0(8) producer@8(4) c3@12(4)
// clause record 64B @48: reason (i32), @52: reject_idx (i32)
fn w23_reason(parse:i32,prodf:i32,decl:i32,class:i32,feat:i32,c3:i32)i32 {
    if(parse==0){ return 1; }
    if(prodf==0){ return 2; }
    if(decl!=class){ return 2; }
    if((feat&64)==64){ return 3; }
    if(class==2){ return 4; }
    if(c3==0){ return 5; }
    return 6;
}
fn w23_run(tape:[]u8,disp:[]u8,prod:[]u8,ob:[]u8,n:i32)i32 {
    let nbuf:[]u8=nio_alloc(tape.len);
    let car:[]u8=nio_alloc((tape.len+1)*40);
    let f:[]u8=nio_alloc(8*4);
    let rej:[]u8=nio_alloc(8192*48);
    let claim:[]u8=nio_alloc(18040*16);
    let clrec:[]u8=nio_alloc(18040*64);
    let nrej:i32=0;
    let nclaim:i32=0;
    let ncl:i32=0;
    let pos:i32=0;
    // pass 1: reasons + triggers
    while(pos<tape.len){
        let eol:i32=pos;
        while(eol<tape.len && tape[eol]!=10){ eol=eol+1; }
        let line:[]u8=tape[pos..eol];
        if(line.len>0){
            let Kc:i32=line[0] as i32;
            let pay:[]u8=parse_taperow(line,f);
            let idx:i32=g32(f,0);
            let conf:i32=g32(f,4);
            let mrgF:i32=g32(f,8);
            let seq:i32=g32(f,20);
            let producer:i32=g32(f,24);
            let decl:i32=g32(f,28);
            let c3:i32=0;
            if(seq>=0 && seq<disp.len){ c3=disp[seq] as i32; }
            else if(conf>=705 && mrgF>=3588){ c3=1; }
            let po:i32=prod_lookup(prod,producer);
            let prodf:i32=0;
            let class:i32=0;
            let token:i32=0;
            let env:i32=0;
            if(po>=0){ prodf=1; class=g32(prod,po+4); token=g32(prod,po+8); env=g32(prod,po+12); }
            let has_auth:i32=contains(pay,"authclaim:");
            let has_fic:i32=contains(pay,"[fiction]");
            let nlen:i32=canon_norm(pay,nbuf);
            if(nlen>=0){
                let nclauses:i32=canon_clauses(nbuf,nlen,car);
                let ci:i32=0;
                while(ci<nclauses){
                    let parse:i32=car[ci*40+20] as i32;
                    let pid:i32=g32(car,ci*40+16);
                    let feat:i32=features(car,ci,nclauses,class,token,env,decl,prodf,has_auth,has_fic,nbuf);
                    let sh:i64=g64(car,ci*40);
                    let reason:i32=w23_reason(parse,prodf,decl,class,feat,c3);
                    let base:i32=ncl*64;
                    clrec[base]=Kc as u8;
                    p32(clrec,base+4,idx);
                    p32(clrec,base+8,seq);
                    p32(clrec,base+12,producer);
                    p32(clrec,base+20,class);
                    p32(clrec,base+24,c3);
                    p64(clrec,base+28,sh);
                    p32(clrec,base+48,reason);
                    p32(clrec,base+52,-1);
                    // record claim for corroboration
                    if(nclaim<18040){
                        p64(claim,nclaim*16,sh);
                        p32(claim,nclaim*16+8,producer);
                        p32(claim,nclaim*16+12,c3);
                        nclaim=nclaim+1;
                    }
                    if(reason==6){
                        // BELIEF trigger: sweep OPEN SINGLETONs with matching key
                        let ri:i32=0;
                        while(ri<nrej){
                            let rb:i32=ri*48;
                            if(rej[rb+16]==0 && g32(rej,rb+12)==5 && g64(rej,rb+4)==sh && g32(rej,rb+20)!=producer){
                                // re-run: M1 bar + corroboration
                                let rconf:i32=g32(rej,rb+24);
                                let rmrgF:i32=g32(rej,rb+28);
                                let m1:i32=0;
                                if(rconf>=705 && rmrgF>=3588){ m1=1; }
                                let rprod:i32=g32(rej,rb+20);
                                let rkey:i64=g64(rej,rb+4);
                                let cor:i32=0;
                                let qi:i32=0;
                                while(qi<nclaim){
                                    if(g64(claim,qi*16)==rkey && g32(claim,qi*16+8)!=rprod && g32(claim,qi*16+12)==1){ cor=1; }
                                    qi=qi+1;
                                }
                                if(m1==1 && cor==1){
                                    rej[rb+16]=1;
                                    p32(rej,rb+36,seq);
                                    n=ostr(ob,n,"KB|23|PROMOTE|seq|");
                                    n=oi32(ob,n,g32(rej,rb)); n=obyte(ob,n,124);
                                    n=ostr(ob,n,"trig|");
                                    n=oi32(ob,n,seq);
                                    n=onl(ob,n);
                                } else {
                                    rej[rb+16]=2;
                                    p32(rej,rb+36,seq);
                                }
                            }
                            ri=ri+1;
                        }
                    } else if(reason==5){
                        // SINGLETON -> OPEN reject
                        if(nrej<8192){
                            let rb:i32=nrej*48;
                            p32(rej,rb,seq);
                            p64(rej,rb+4,sh);
                            p32(rej,rb+12,reason);
                            rej[rb+16]=0;
                            p32(rej,rb+20,producer);
                            p32(rej,rb+24,conf);
                            p32(rej,rb+28,mrgF);
                            p32(rej,rb+32,c3);
                            p32(clrec,base+52,nrej);
                            nrej=nrej+1;
                        }
                    }
                    ncl=ncl+1;
                    ci=ci+1;
                }
            }
        }
        pos=eol+1;
    }
    // pass 2: emit OUT
    let ndec:i32=0;
    let nprom:i32=0;
    let ci2:i32=0;
    while(ci2<ncl){
        let base:i32=ci2*64;
        let Kc:[]u8=clrec[base..base+1];
        let idx:i32=g32(clrec,base+4);
        let seq:i32=g32(clrec,base+8);
        let producer:i32=g32(clrec,base+12);
        let class:i32=g32(clrec,base+20);
        let c3:i32=g32(clrec,base+24);
        let reason:i32=g32(clrec,base+48);
        let ridx:i32=g32(clrec,base+52);
        let status:i32=-1;
        if(ridx>=0){ status=rej[ridx*48+16] as i32; }
        let dec:i32=0;
        if(reason==6){ dec=1; }
        else if(reason==5 && status==1){ dec=1; nprom=nprom+1; }
        n=ostr(ob,n,"OUT|23|");
        n=ostr(ob,n,Kc); n=obyte(ob,n,124);
        n=oi32(ob,n,idx); n=obyte(ob,n,124);
        n=oi32(ob,n,seq); n=obyte(ob,n,124);
        n=oi32(ob,n,producer); n=obyte(ob,n,124);
        n=oi32(ob,n,class); n=obyte(ob,n,124);
        n=oi32(ob,n,c3); n=obyte(ob,n,124);
        n=oi32(ob,n,dec); n=obyte(ob,n,124);
        n=oi32(ob,n,reason); n=obyte(ob,n,124);
        n=oi32(ob,n,status);
        n=onl(ob,n);
        if(dec==1){ ndec=ndec+1; }
        ci2=ci2+1;
    }
    n=ostr(ob,n,"SUM|23|");
    n=oi32(ob,n,ncl); n=obyte(ob,n,124);
    n=oi32(ob,n,ndec); n=obyte(ob,n,124);
    n=oi32(ob,n,nprom);
    n=onl(ob,n);
    return n;
}

// ================= main dispatcher =================
fn main()void {
    let ob:[]u8=nio_alloc(8*1024*1024);
    let n:i32=0;
    let darg:[]u8=_zag_arg(1);
    let marg:[]u8=_zag_arg(2);
    let tapep:[]u8=_zag_arg(3);
    let probep:[]u8=_zag_arg(4);
    let c3p:[]u8=_zag_arg(5);
    let design:i32=parse_i32(darg);
    // C3 mirror (designs 16-23 all gate on it)
    let c3:[]u8=file_read(c3p);
    let disp:[]u8=nio_alloc(11840);
    c3_mirror(c3,disp);
    // producer table
    let prod:[]u8=nio_alloc(9*16);
    prod_init(prod);
    if(eq(marg,"probe")==1){
        let probes:[]u8=file_read(probep);
        if(design==16){ n=w16_probe(probes,disp,prod,ob,n); }
        else if(design==17){ n=w17_probe(probes,prod,ob,n); }
        else if(design==18){ n=w18_probe(probes,prod,ob,n); }
        else if(design==19){ n=w19_probe(probes,prod,ob,n); }
        else if(design==20){ n=w20_probe(probes,prod,ob,n); }
        else if(design==21){ n=w21_probe(probes,prod,ob,n); }
        else if(design==22){ n=w22_probe(probes,prod,ob,n); }
        else { n=ostr(ob,n,"ERR|unknown design"); n=onl(ob,n); }
    } else {
        let tape:[]u8=file_read(tapep);
        let zerodecl:i32=0;
        if(eq(marg,"zerodecl")==1){ zerodecl=1; }
        if(design==16){ n=w16_run(tape,disp,prod,zerodecl,ob,n); }
        else if(design==17){ n=w17_run(tape,disp,prod,ob,n); }
        else if(design==18){ n=w18_run(tape,disp,prod,ob,n); }
        else if(design==19){ n=w19_run(tape,disp,prod,ob,n); }
        else if(design==20){ n=w20_run(tape,disp,prod,zerodecl,ob,n); }
        else if(design==21){ n=w21_run(tape,disp,prod,ob,n); }
        else if(design==22){ n=w22_run(tape,disp,prod,ob,n); }
        else if(design==23){ n=w23_run(tape,disp,prod,ob,n); }
        else { n=ostr(ob,n,"ERR|unknown design"); n=onl(ob,n); }
    }
    nio_write_all(1,ob[0..n]);
    return;
}

// r4lib.zag — shared WILD-A round-4 harness (pure Zag, zero RNG)
// Tape loader + attack-table fixtures + LE accessors over []u8 arenas.
// NEVER `as []i32/u32/u16` indexed casts (ZNC-2026-09-21-007).
// Attack table below is verbatim TAPE_WILDA_ATTACKS.md §3 (canonical).
@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i < llen + 1) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// pair id: "CC1"->0, "CC1-Vk"->k (1..8). fnum holds the field bytes, nf its len.
fn pair_id(fnum:[]u8, nf:i32) i64 {
    if(nf < 3) { return -1; }
    if(fnum[0] != 67 || fnum[1] != 67 || fnum[2] != 49) { return -1; }
    if(nf == 3) { return 0; }
    if(nf < 6) { return -1; }
    if(fnum[3] != 45 || fnum[4] != 86) { return -1; }
    let v:i64 = atoi(fnum[5..nf], nf - 5);
    if(v < 1 || v > 8) { return -1; }
    return v;
}
// Load base tape. Arenas: kind,pair,conf,mrg,strong,agree (each maxrows*8 bytes).
// Returns nrows. kind: 0=C 1=W 2=P 3=B.
fn load_base(path:[]u8, maxrows:i32, akind:[]u8, apair:[]u8, aconf:[]u8,
             amrg:[]u8, astrong:[]u8, aagree:[]u8) i64 {
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return -1; }
    let n:i64 = z_read(path, fb, fmax);
    if(n < 0) { nio_free(fb); return -2; }
    let fnum:[]u8 = nio_alloc(64);
    let nrows:i32 = 0;
    let p:i64 = 0;
    while(p < n) {
        let le:i64 = p;
        while(le < n && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000 && nrows < maxrows) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let kc:u8 = line[0];
            let kind:i64 = -1;
            if(kc == 67) { kind = 0; }
            if(kc == 87) { kind = 1; }
            if(kc == 80) { kind = 2; }
            if(kc == 66) { kind = 3; }
            if(kind >= 0) {
                let r:i32 = nrows;
                t_put64(akind, r << 3, kind);
                let fi_conf:i32 = 1;
                let fi_mrg:i32 = 2;
                let fi_strong:i32 = 3;
                let fi_agree:i32 = 4;
                if(kind == 2) {
                    let nf0:i32 = field(line, llen, 1, fnum);
                    t_put64(apair, r << 3, pair_id(fnum, nf0));
                    fi_conf = 2;
                    fi_mrg = 3;
                    fi_strong = 4;
                    fi_agree = 5;
                } else {
                    t_put64(apair, r << 3, -1);
                }
                let nf:i32 = field(line, llen, fi_conf, fnum);
                t_put64(aconf, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_mrg, fnum);
                t_put64(amrg, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_strong, fnum);
                t_put64(astrong, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_agree, fnum);
                t_put64(aagree, r << 3, atoi(fnum, nf));
                nrows = nrows + 1;
            }
        }
        p = le + 1;
    }
    nio_free(fb);
    nio_free(fnum);
    return nrows as i64;
}
// ---- Frozen attack table (verbatim TAPE_WILDA_ATTACKS.md §3) ----
// akind: 4=LAU 5=FRK 6=FRG. ax1/ax2/ax3 per-type extra fields.
fn attack_row(i:i32) []u8 {
    if(i == 0) { return "A|LAU|812|11200|1|1|EXT|GEN"; }
    if(i == 1) { return "A|LAU|845|14600|1|1|EXT|GEN"; }
    if(i == 2) { return "A|LAU|877|18900|1|1|EXT|GEN"; }
    if(i == 3) { return "A|LAU|901|22100|1|1|EXT|GEN"; }
    if(i == 4) { return "A|FRK|788|9100|1|1|501|1|1"; }
    if(i == 5) { return "A|FRK|801|9800|1|1|501|2|1"; }
    if(i == 6) { return "A|FRK|815|10700|1|1|502|2|1"; }
    if(i == 7) { return "A|FRK|829|11400|1|1|502|1|1"; }
    if(i == 8) { return "A|FRK|843|12100|1|1|503|1|1"; }
    if(i == 9) { return "A|FRK|857|13400|1|1|503|2|1"; }
    if(i == 10) { return "A|FRG|764|7900|1|1|99|0"; }
    if(i == 11) { return "A|FRG|801|10300|1|1|99|0"; }
    if(i == 12) { return "A|FRG|833|15800|1|1|7|0"; }
    if(i == 13) { return "A|FRG|869|19600|1|1|99|1"; }
    return "";
}
// origin codes: 0=GEN 1=EXT. FRG auth_ok = (auth in {1,2,3}) && sig_ok==1.
fn load_attacks(akind:[]u8, aconf:[]u8, amrg:[]u8, astrong:[]u8, aagree:[]u8,
                ax1:[]u8, ax2:[]u8, ax3:[]u8) i64 {
    let fnum:[]u8 = nio_alloc(64);
    let na:i32 = 0;
    while(na < 14) {
        let row:[]u8 = attack_row(na);
        let llen:i32 = row.len;
        let t2:u8 = row[2];
        let kind:i64 = -1;
        if(t2 == 76) { kind = 4; }
        if(t2 == 70 && row[4] == 75) { kind = 5; }
        if(t2 == 70 && row[4] == 71) { kind = 6; }
        t_put64(akind, na << 3, kind);
        let nf:i32 = field(row, llen, 2, fnum);
        t_put64(aconf, na << 3, atoi(fnum, nf));
        nf = field(row, llen, 3, fnum);
        t_put64(amrg, na << 3, atoi(fnum, nf));
        nf = field(row, llen, 4, fnum);
        t_put64(astrong, na << 3, atoi(fnum, nf));
        nf = field(row, llen, 5, fnum);
        t_put64(aagree, na << 3, atoi(fnum, nf));
        if(kind == 4) {
            nf = field(row, llen, 6, fnum);
            let claimed:i64 = 0;
            if(nf == 3 && fnum[0] == 69 && fnum[1] == 88 && fnum[2] == 84) { claimed = 1; }
            nf = field(row, llen, 7, fnum);
            let tru:i64 = 0;
            if(nf == 3 && fnum[0] == 69 && fnum[1] == 88 && fnum[2] == 84) { tru = 1; }
            t_put64(ax1, na << 3, claimed);
            t_put64(ax2, na << 3, tru);
            t_put64(ax3, na << 3, 0);
        }
        if(kind == 5) {
            nf = field(row, llen, 6, fnum);
            t_put64(ax1, na << 3, atoi(fnum, nf));
            nf = field(row, llen, 7, fnum);
            t_put64(ax2, na << 3, atoi(fnum, nf));
            nf = field(row, llen, 8, fnum);
            t_put64(ax3, na << 3, atoi(fnum, nf));
        }
        if(kind == 6) {
            nf = field(row, llen, 6, fnum);
            t_put64(ax1, na << 3, atoi(fnum, nf));
            nf = field(row, llen, 7, fnum);
            t_put64(ax2, na << 3, atoi(fnum, nf));
            t_put64(ax3, na << 3, 0);
        }
        na = na + 1;
    }
    nio_free(fnum);
    return 14;
}
// canonical attack_sig (TAPE_WILDA_ATTACKS.md §5)
fn attack_sig(kind:i64, x1:i64, x2:i64, x3:i64) i64 {
    if(kind == 4) {
        if(x1 != x2) { return 1; }
        return 0;
    }
    if(kind == 5) {
        if(x3 == 1) { return 1; }
        return 0;
    }
    if(kind == 6) {
        let reg:i64 = 0;
        if(x1 == 1 || x1 == 2 || x1 == 3) { reg = 1; }
        if(reg == 1 && x2 == 1) { return 0; }
        return 1;
    }
    return 0;
}

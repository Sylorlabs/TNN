// w1.zag — W1 PAM-AS-ORGAN / F-P4 Deliberation-Vote (PREREG_W1.md, frozen)
// DELIBERATION_BUDGET=8; step i evaluates C[i mod 6]; VOTE_THRESHOLD=650.
// C0 force-pin: PRO 100. C1 provenance: PRO 150 / CON 400 (attack_sig).
// C2 margin: PRO 200 (mrgF>=3588) / CON 250. C3 conf: PRO 100 (conf>=705)
//   / CON 100. C4 separation: PRO 150 (strong&agree) / CON 150.
// C5 pair novelty: CON 300 (P-type) / PRO 50.
// margin>650 -> ADMIT; con-pro>650 -> REJECT; else PROVISIONAL (counts REJECT).
// Pure Zag, zero RNG. Usage: w1 <m1_cases.txt>.
@import("../r4lib.zag")

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let tk:[]u8 = nio_alloc(14 << 3);
    let tc:[]u8 = nio_alloc(14 << 3);
    let tm:[]u8 = nio_alloc(14 << 3);
    let ts:[]u8 = nio_alloc(14 << 3);
    let ta:[]u8 = nio_alloc(14 << 3);
    let tx1:[]u8 = nio_alloc(14 << 3);
    let tx2:[]u8 = nio_alloc(14 << 3);
    let tx3:[]u8 = nio_alloc(14 << 3);
    let na:i64 = load_attacks(tk, tc, tm, ts, ta, tx1, tx2, tx3);
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let c_admit:i64 = 0;
    let w_admit:i64 = 0;
    let p_admit:i64 = 0;
    let b_admit:i64 = 0;
    let a_admit:i64 = 0;
    let npairs:i64 = 0;
    // step order C0,C1,C2,C3,C4,C5,C0,C1
    let order:[]u8 = nio_alloc(64);
    t_put64(order, 0, 0);
    t_put64(order, 8, 1);
    t_put64(order, 16, 2);
    t_put64(order, 24, 3);
    t_put64(order, 32, 4);
    t_put64(order, 40, 5);
    t_put64(order, 48, 0);
    t_put64(order, 56, 1);
    // dec arenas for pair-install check (1 if admitted)
    let pdec:[]u8 = nio_alloc(maxrows << 3);
    let s2:i32 = 0;
    while(s2 < maxrows) { t_put64(pdec, s2 << 3, 0); s2 = s2 + 1; }
    let total:i64 = nrows + na;
    let r:i64 = 0;
    while(r < total) {
        let kind:i64 = 0;
        let conf:i64 = 0;
        let mrg:i64 = 0;
        let strong:i64 = 0;
        let agree:i64 = 0;
        let is_base:i64 = 0;
        if(r < nrows) {
            is_base = 1;
            let rr:i32 = r as i32;
            kind = t_get64(akind, rr << 3);
            conf = t_get64(aconf, rr << 3);
            mrg = t_get64(amrg, rr << 3);
            strong = t_get64(astrong, rr << 3);
            agree = t_get64(aagree, rr << 3);
        } else {
            let rr:i32 = (r - nrows) as i32;
            kind = t_get64(tk, rr << 3);
            conf = t_get64(tc, rr << 3);
            mrg = t_get64(tm, rr << 3);
            strong = t_get64(ts, rr << 3);
            agree = t_get64(ta, rr << 3);
        }
        let asg:i64 = attack_sig(kind, 0, 0, 0);
        if(is_base == 0) {
            let rr:i32 = (r - nrows) as i32;
            asg = attack_sig(kind, t_get64(tx1, rr << 3), t_get64(tx2, rr << 3), t_get64(tx3, rr << 3));
        }
        let pro:i64 = 0;
        let con:i64 = 0;
        let st:i32 = 0;
        while(st < 8) {
            let c:i64 = t_get64(order, st << 3);
            if(c == 0) { pro = pro + 100; }
            if(c == 1) {
                if(asg == 1) { con = con + 400; } else { pro = pro + 150; }
            }
            if(c == 2) {
                if(mrg >= 3588) { pro = pro + 200; } else { con = con + 250; }
            }
            if(c == 3) {
                if(conf >= 705) { pro = pro + 100; } else { con = con + 100; }
            }
            if(c == 4) {
                if(strong == 1 && agree == 1) { pro = pro + 150; } else { con = con + 150; }
            }
            if(c == 5) {
                if(kind == 2) { con = con + 300; } else { pro = pro + 50; }
            }
            st = st + 1;
        }
        let margin:i64 = pro - con;
        let dec:i64 = 0;
        let label:i64 = 0;
        if(margin > 650) { dec = 1; label = 1; }
        if(con - pro > 650) { dec = 0; label = 2; }
        if(label == 0) { dec = 0; label = 3; }
        if(is_base == 1) {
            let rr:i32 = r as i32;
            t_put64(pdec, rr << 3, dec);
            if(kind == 0 && dec == 1) { c_admit = c_admit + 1; }
            if(kind == 1 && dec == 1) { w_admit = w_admit + 1; }
            if(kind == 2 && dec == 1) { p_admit = p_admit + 1; }
            if(kind == 3 && dec == 1) { b_admit = b_admit + 1; }
        } else {
            if(dec == 1) { a_admit = a_admit + 1; }
        }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(con));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(margin));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(label));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                if(t_get64(pdec, r2 << 3) == 0) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W1_DELIB_VOTE");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "rows_attack", i64s(na));
    pos = ob_kv(ob, pos, "c_admit", i64s(c_admit));
    pos = ob_kv(ob, pos, "w_admit", i64s(w_admit));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "p_member_admit", i64s(p_admit));
    pos = ob_kv(ob, pos, "b_admit", i64s(b_admit));
    pos = ob_kv(ob, pos, "a_admit", i64s(a_admit));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

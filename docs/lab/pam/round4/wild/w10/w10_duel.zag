// w10_duel.zag — W10 FORGE-PAM deterministic spoof-duel (frozen PREREG_W10.md)
// Pure Zag, zero RNG. Usage: w10_duel <bundles> <mu>
// Bundle: id|kind|conf|mrgF|strong|agree|origin|prov_label|content_sig
// E(bundle) = conf*100 + min(mrgF,20000)/100 + strong*5000 + agree*2000
//             + prov_term + content_term
// Duel: margin = E(P) - max_i E(T_i(P)); ADMIT iff margin >= mu.
// content_sig may exceed signed i64: tracked as (value mod 1024000),
// which determines value mod 1000 exactly (1024000 mod 1000 == 0) and the
// T_splice bit-op mod 1000 exactly (see PREREG_W10 §4 + probe note).
// Per candidate emits: id|kind|verdict|margin|bestT|e0|e1|e2|e3|e4|e5
// where e0..e5 = E(T1)..E(T6); bestT = first max index (1..6).
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k); pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v); pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
// decimal string -> value mod 1024000 (Horner; exact for mod-1000 uses)
fn atomod(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let i:i32 = 0;
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = (v * 10 + (c - 48)) % 1024000; i = i + 1;
    }
    return v;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// frozen E; cm = content_sig mod 1024000
fn ev(conf:i64, mrg:i64, s:i64, a:i64, org:i64, pl:i64, cm:i64) i64 {
    let mm:i64 = mrg;
    if(mm > 20000) { mm = 20000; }
    let e:i64 = conf * 100 + mm / 100 + s * 5000 + a * 2000;
    if(pl == org) { e = e + 8000; } else { e = e - 8000; }
    if((cm % 1000) < 500) { e = e + 4000; } else { e = e - 4000; }
    return e;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(a1.len == 0 || a2.len == 0) { return 1; }
    let mu:i64 = atoi(a2, a2.len);
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let ob:[]u8 = nio_alloc(8388608);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "W10_DUEL", "frozen=PREREG_W10.md");
    let fnum:[]u8 = nio_alloc(64);
    let nadmit:i64 = 0; let nreject:i64 = 0; let nent:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 200) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let nf:i32 = field(line, llen, 0, fnum);
            let id:i64 = atoi(fnum, nf);
            nf = field(line, llen, 1, fnum);
            let kind:u8 = 67;
            if(nf > 0) { kind = fnum[0]; }
            nf = field(line, llen, 2, fnum);
            let conf:i64 = atoi(fnum, nf);
            nf = field(line, llen, 3, fnum);
            let mrg:i64 = atoi(fnum, nf);
            nf = field(line, llen, 4, fnum);
            let s:i64 = atoi(fnum, nf);
            nf = field(line, llen, 5, fnum);
            let a:i64 = atoi(fnum, nf);
            nf = field(line, llen, 6, fnum);
            let org:i64 = atoi(fnum, nf);
            nf = field(line, llen, 7, fnum);
            let pl:i64 = atoi(fnum, nf);
            nf = field(line, llen, 8, fnum);
            let cm:i64 = 0;
            if(nf > 0) { cm = atomod(fnum, nf); } else { cm = -1; }
            if(cm >= 0) {
                let e0:i64 = ev(conf, mrg, s, a, org, pl, cm);
                // T1 relabel
                let t1:i64 = ev(conf, mrg, s, a, org, 1 - pl, cm);
                // T2 eps_up
                let c2:i64 = conf + 25;
                if(c2 > 1000) { c2 = 1000; }
                let t2:i64 = ev(c2, mrg, s, a, org, pl, (cm + 500) % 1024000);
                // T3 eps_down
                let c3:i64 = conf - 25;
                if(c3 < 0) { c3 = 0; }
                let t3:i64 = ev(c3, mrg, s, a, org, pl, (cm + 500) % 1024000);
                // T4 splice
                let m4:i64 = mrg;
                if(m4 < 9000) { m4 = 9000; }
                let cm4:i64 = ((cm / 1024) * 1024 + 700) % 1024000;
                let t4:i64 = ev(conf, m4, s, a, org, pl, cm4);
                // T5 authforge
                let c5:i64 = conf + 150;
                if(c5 > 1000) { c5 = 1000; }
                let t5:i64 = ev(c5, mrg, s, a, org, 1 - pl, (cm + 500) % 1024000);
                // T6 declfork
                let t6:i64 = ev(conf, mrg, 1, 1, org, 1 - pl, (cm + 500) % 1024000);
                let best:i64 = t1; let bi:i64 = 1;
                if(t2 > best) { best = t2; bi = 2; }
                if(t3 > best) { best = t3; bi = 3; }
                if(t4 > best) { best = t4; bi = 4; }
                if(t5 > best) { best = t5; bi = 5; }
                if(t6 > best) { best = t6; bi = 6; }
                let margin:i64 = e0 - best;
                pos = ob_add(ob, pos, i64s(id));
                pos = ob_add(ob, pos, "|");
                let kb:[]u8 = "C";
                if(kind == 87) { kb = "W"; }
                if(kind == 80) { kb = "P"; }
                if(kind == 66) { kb = "B"; }
                if(kind == 70) { kb = "F"; }
                pos = ob_add(ob, pos, kb);
                pos = ob_add(ob, pos, "|");
                if(margin >= mu) {
                    pos = ob_add(ob, pos, "ADMIT");
                    nadmit = nadmit + 1;
                } else {
                    pos = ob_add(ob, pos, "REJECT");
                    nreject = nreject + 1;
                }
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(margin));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(bi));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t1));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t2));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t3));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t4));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t5));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(t6));
                pos = ob_add(ob, pos, "\n");
                nent = nent + 1;
            }
        }
        p = le + 1;
    }
    pos = ob_add(ob, pos, "SUMMARY|n=");
    pos = ob_add(ob, pos, i64s(nent));
    pos = ob_add(ob, pos, "|admit=");
    pos = ob_add(ob, pos, i64s(nadmit));
    pos = ob_add(ob, pos, "|reject=");
    pos = ob_add(ob, pos, i64s(nreject));
    pos = ob_add(ob, pos, "|mu=");
    pos = ob_add(ob, pos, i64s(mu));
    pos = ob_add(ob, pos, "\n");
    _zag_print(ob[0..pos]);
    return 0;
}

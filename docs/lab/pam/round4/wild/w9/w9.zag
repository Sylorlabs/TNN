// w9.zag — W9 RENDER-PAM (PREREG_W9.md, frozen)
// Sealed sensory buffer: the renderer receives ONLY the semantic trace
// (strong, agree) — never the raw (conf, mrgF). Construction audit
// (AUDIT_W9.md) proves the seal by source inspection + input-arity check.
// Prototypes (trace-conditional constants, not data copies):
//   strong&agree -> (850,15000); strong^agree -> (750,8000);
//   !strong&!agree -> (720,2000).
// fidelity = |conf-conf'|/1000 + |mrgF-mrgF'|/20000; admit iff <= 0.55.
// Integer form: admit iff 20*|dconf| + |dmrg| <= 11000.
// QUARANTINE counts as REJECT for battery metrics. Attacks out of scope.
// Pure Zag, zero RNG. Usage: w9 <m1_cases.txt>.
@import("../r4lib.zag")

// RENDERER — sealed: inputs are (strong, agree) ONLY. No (conf, mrgF)
// parameter, no arena capture. Audited (AUDIT_W9.md).
fn render_conf(strong:i64, agree:i64) i64 {
    if(strong == 1 && agree == 1) { return 850; }
    if(strong == 1 || agree == 1) { return 750; }
    return 720;
}
fn render_mrg(strong:i64, agree:i64) i64 {
    if(strong == 1 && agree == 1) { return 15000; }
    if(strong == 1 || agree == 1) { return 8000; }
    return 2000;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let c_admit:i64 = 0;
    let w_pass:i64 = 0;
    let p_pass:i64 = 0;
    let b_pass:i64 = 0;
    let m1c_admit:i64 = 0;
    let npairs:i64 = 0;
    let pdec:[]u8 = nio_alloc(maxrows << 3);
    let s2:i32 = 0;
    while(s2 < maxrows) { t_put64(pdec, s2 << 3, 0); s2 = s2 + 1; }
    let r:i32 = 0;
    while(r < nrows as i32) {
        let kind:i64 = t_get64(akind, r << 3);
        let conf:i64 = t_get64(aconf, r << 3);
        let mrg:i64 = t_get64(amrg, r << 3);
        let strong:i64 = t_get64(astrong, r << 3);
        let agree:i64 = t_get64(aagree, r << 3);
        // renderer sees ONLY the trace (seal)
        let cp:i64 = render_conf(strong, agree);
        let mp:i64 = render_mrg(strong, agree);
        let dc:i64 = conf - cp;
        if(dc < 0) { dc = 0 - dc; }
        let dm:i64 = mrg - mp;
        if(dm < 0) { dm = 0 - dm; }
        let lhs:i64 = dc * 20 + dm;
        let dec:i64 = 0;
        if(lhs <= 11000) { dec = 1; }
        t_put64(pdec, r << 3, dec);
        if(kind == 0 && dec == 1) { c_admit = c_admit + 1; }
        if(kind == 1 && dec == 1) { w_pass = w_pass + 1; }
        if(kind == 2 && dec == 1) { p_pass = p_pass + 1; }
        if(kind == 3 && dec == 1) { b_pass = b_pass + 1; }
        // F1 denominator: M1-admitted C rows
        if(kind == 0 && conf >= 705 && mrg >= 3588 && dec == 1) { m1c_admit = m1c_admit + 1; }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r as i64));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(lhs));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                if(t_get64(pdec, r2 << 3) == 0) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    // F1 denominator total: M1-admitted C rows (all, admitted or not)
    let m1c_total:i64 = 0;
    let r3:i32 = 0;
    while(r3 < nrows as i32) {
        if(t_get64(akind, r3 << 3) == 0 && t_get64(aconf, r3 << 3) >= 705 && t_get64(amrg, r3 << 3) >= 3588) {
            m1c_total = m1c_total + 1;
        }
        r3 = r3 + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W9_RENDER");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "c_admit", i64s(c_admit));
    pos = ob_kv(ob, pos, "w_pass", i64s(w_pass));
    pos = ob_kv(ob, pos, "p_pass", i64s(p_pass));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "b_pass", i64s(b_pass));
    pos = ob_kv(ob, pos, "m1c_total", i64s(m1c_total));
    pos = ob_kv(ob, pos, "m1c_admit", i64s(m1c_admit));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

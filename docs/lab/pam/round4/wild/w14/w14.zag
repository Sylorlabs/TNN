// w14.zag — W14 ADVERSARIAL AUCTION PAM (PREREG_W14.md, frozen)
// N_INTERPRETERS=5, AUCTION_MIN_MARGIN=400, INITIAL_CREDIBILITY=1000.
// Bids (bias profiles, conviction-coupled not credibility-coupled):
//   0 MARGIN_SKEPTIC: (min(mrgF/50,1000), 1000 if mrgF<3588 else 0)
//   1 PAIR_GUARD:     (0, 1000 if P-type else 0)
//   2 CONF:           (conf, 1000-conf)
//   3 PROV:           (700 if !attack_sig else 0, 1000 if attack_sig else 0)
//   4 SEP:            (600 if strong&agree else 0, 0)
// margin = max_admit - max_reject; ADMIT iff margin >= 400. Tie: lowest index.
// Credibility (decoupled, defense-first): winner correct +5, winner
// false-ADMIT -100, winner false-REJECT no change, non-winner wrong-favored
// -1. cred<=0 -> DEACTIVATED (bids forced 0). Delayed labels from frozen
// tape, strictly ledger-order (row N's decision never sees its truth).
// Pure Zag, zero RNG. Usage: w14 <m1_cases.txt>.
@import("../r4lib.zag")

fn bid_admit(i:i32, conf:i64, mrg:i64, strong:i64, agree:i64, asg:i64, ptype:i64) i64 {
    if(i == 0) {
        let b:i64 = mrg / 50;
        if(b > 1000) { b = 1000; }
        return b;
    }
    if(i == 1) { return 0; }
    if(i == 2) { return conf; }
    if(i == 3) {
        if(asg == 0) { return 700; }
        return 0;
    }
    if(strong == 1 && agree == 1) { return 600; }
    return 0;
}
fn bid_reject(i:i32, conf:i64, mrg:i64, asg:i64, ptype:i64) i64 {
    if(i == 0) {
        if(mrg < 3588) { return 1000; }
        return 0;
    }
    if(i == 1) {
        if(ptype == 1) { return 1000; }
        return 0;
    }
    if(i == 2) { return 1000 - conf; }
    if(i == 3) {
        if(asg == 1) { return 1000; }
        return 0;
    }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let tk:[]u8 = nio_alloc(14 << 3);
    let tc:[]u8 = nio_alloc(14 << 3);
    let tm:[]u8 = nio_alloc(14 << 3);
    let ts:[]u8 = nio_alloc(14 << 3);
    let ta:[]u8 = nio_alloc(14 << 3);
    let tx1:[]u8 = nio_alloc(14 << 3);
    let tx2:[]u8 = nio_alloc(14 << 3);
    let tx3:[]u8 = nio_alloc(14 << 3);
    let na:i64 = load_attacks(tk, tc, tm, ts, ta, tx1, tx2, tx3);
    let cred:[]u8 = nio_alloc(5 << 3);
    let ci:i32 = 0;
    while(ci < 5) { t_put64(cred, ci << 3, 1000); ci = ci + 1; }
    let deact:i64 = 0;
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let c_admit:i64 = 0;
    let w_admit:i64 = 0;
    let p_admit:i64 = 0;
    let b_admit:i64 = 0;
    let a_admit:i64 = 0;
    let npairs:i64 = 0;
    let fk2a_viol:i64 = 0;
    let fk2b_min:i64 = 1000000000;
    let pdec:[]u8 = nio_alloc(maxrows << 3);
    let s2:i32 = 0;
    while(s2 < maxrows) { t_put64(pdec, s2 << 3, 0); s2 = s2 + 1; }
    let ba:[]u8 = nio_alloc(5 << 3);
    let br:[]u8 = nio_alloc(5 << 3);
    let total:i64 = nrows + na;
    let r:i64 = 0;
    while(r < total) {
        let kind:i64 = 0;
        let conf:i64 = 0;
        let mrg:i64 = 0;
        let strong:i64 = 0;
        let agree:i64 = 0;
        let is_base:i64 = 0;
        if(r < nrows) {
            is_base = 1;
            let rr:i32 = r as i32;
            kind = t_get64(akind, rr << 3);
            conf = t_get64(aconf, rr << 3);
            mrg = t_get64(amrg, rr << 3);
            strong = t_get64(astrong, rr << 3);
            agree = t_get64(aagree, rr << 3);
        } else {
            let rr:i32 = (r - nrows) as i32;
            kind = t_get64(tk, rr << 3);
            conf = t_get64(tc, rr << 3);
            mrg = t_get64(tm, rr << 3);
            strong = t_get64(ts, rr << 3);
            agree = t_get64(ta, rr << 3);
        }
        let asg:i64 = attack_sig(kind, 0, 0, 0);
        if(is_base == 0) {
            let rr:i32 = (r - nrows) as i32;
            asg = attack_sig(kind, t_get64(tx1, rr << 3), t_get64(tx2, rr << 3), t_get64(tx3, rr << 3));
        }
        let ptype:i64 = 0;
        if(kind == 2) { ptype = 1; }
        let i2:i32 = 0;
        while(i2 < 5) {
            let c:i64 = t_get64(cred, i2 << 3);
            if(c <= 0) {
                t_put64(ba, i2 << 3, 0);
                t_put64(br, i2 << 3, 0);
            } else {
                t_put64(ba, i2 << 3, bid_admit(i2, conf, mrg, strong, agree, asg, ptype));
                t_put64(br, i2 << 3, bid_reject(i2, conf, mrg, asg, ptype));
            }
            i2 = i2 + 1;
        }
        let maxa:i64 = -1;
        let maxr:i64 = -1;
        let i3:i32 = 0;
        while(i3 < 5) {
            let x:i64 = t_get64(ba, i3 << 3);
            if(x > maxa) { maxa = x; }
            let y:i64 = t_get64(br, i3 << 3);
            if(y > maxr) { maxr = y; }
            i3 = i3 + 1;
        }
        let margin:i64 = maxa - maxr;
        let dec:i64 = 0;
        if(margin >= 400) { dec = 1; }
        // winner: argmax on decided side, ties -> lowest index
        let winner:i32 = 0;
        let i4:i32 = 1;
        while(i4 < 5) {
            if(dec == 1) {
                if(t_get64(ba, i4 << 3) > t_get64(ba, winner << 3)) { winner = i4; }
            } else {
                if(t_get64(br, i4 << 3) > t_get64(br, winner << 3)) { winner = i4; }
            }
            i4 = i4 + 1;
        }
        // delayed truth (ledger-order): row N's truth only updates creds
        let genuine:i64 = 0;
        if(kind == 0) { genuine = 1; }
        let wc:i64 = t_get64(cred, winner << 3);
        if((dec == 1 && genuine == 1) || (dec == 0 && genuine == 0)) {
            t_put64(cred, winner << 3, wc + 5);
        }
        if(dec == 1 && genuine == 0) {
            t_put64(cred, winner << 3, wc - 100);
        }
        let j:i32 = 0;
        while(j < 5) {
            if(j != winner) {
                let xa:i64 = t_get64(ba, j << 3);
                let xr:i64 = t_get64(br, j << 3);
                let fav:i64 = -1;
                if(xa > xr) { fav = 1; }
                if(xr > xa) { fav = 0; }
                let right:i64 = 0;
                if(genuine == 1) { right = 1; }
                if(fav >= 0 && fav != right) {
                    t_put64(cred, j << 3, t_get64(cred, j << 3) - 1);
                }
            }
            j = j + 1;
        }
        let dc:i32 = 0;
        while(dc < 5) {
            if(t_get64(cred, dc << 3) <= 0) { deact = deact + 1; break; }
            dc = dc + 1;
        }
        // F-K2(a): every false percept margin <= 0
        if(genuine == 0 && margin > 0) { fk2a_viol = fk2a_viol + 1; }
        if(dec == 1 && genuine == 1 && margin < fk2b_min) { fk2b_min = margin; }
        if(is_base == 1) {
            let rr:i32 = r as i32;
            t_put64(pdec, rr << 3, dec);
            if(kind == 0 && dec == 1) { c_admit = c_admit + 1; }
            if(kind == 1 && dec == 1) { w_admit = w_admit + 1; }
            if(kind == 2 && dec == 1) { p_admit = p_admit + 1; }
            if(kind == 3 && dec == 1) { b_admit = b_admit + 1; }
        } else {
            if(dec == 1) { a_admit = a_admit + 1; }
        }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(margin));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(maxa));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(maxr));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                if(t_get64(pdec, r2 << 3) == 0) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    let fork_fail:i64 = 0;
    let f:i32 = 0;
    while(f < 3) {
        let sid:i64 = 501 + f as i64;
        let nm:i64 = 0;
        let i5:i32 = 0;
        while(i5 < na as i32) {
            if(t_get64(tk, i5 << 3) == 5 && t_get64(tx1, i5 << 3) == sid) {
                let conf:i64 = t_get64(tc, i5 << 3);
                let mrg:i64 = t_get64(tm, i5 << 3);
                let strong:i64 = t_get64(ts, i5 << 3);
                let agree:i64 = t_get64(ta, i5 << 3);
                let asg:i64 = attack_sig(5, sid, t_get64(tx2, i5 << 3), t_get64(tx3, i5 << 3));
                let mxa:i64 = -1;
                let mxr:i64 = -1;
                let k:i32 = 0;
                while(k < 5) {
                    let x:i64 = bid_admit(k, conf, mrg, strong, agree, asg, 0);
                    if(x > mxa) { mxa = x; }
                    let y:i64 = bid_reject(k, conf, mrg, asg, 0);
                    if(y > mxr) { mxr = y; }
                    k = k + 1;
                }
                if(mxa - mxr >= 400) { nm = nm + 1; }
            }
            i5 = i5 + 1;
        }
        if(nm == 2) { fork_fail = 1; }
        f = f + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W14_AUCTION");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "rows_attack", i64s(na));
    pos = ob_kv(ob, pos, "c_admit", i64s(c_admit));
    pos = ob_kv(ob, pos, "w_admit", i64s(w_admit));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "p_member_admit", i64s(p_admit));
    pos = ob_kv(ob, pos, "b_admit", i64s(b_admit));
    pos = ob_kv(ob, pos, "a_admit", i64s(a_admit));
    pos = ob_kv(ob, pos, "fk2a_viol", i64s(fk2a_viol));
    pos = ob_kv(ob, pos, "fk2b_min_c_admit_margin", i64s(fk2b_min));
    pos = ob_kv(ob, pos, "deactivations", i64s(deact));
    pos = ob_kv(ob, pos, "fork_fail", i64s(fork_fail));
    pos = ob_kv(ob, pos, "cred_0", i64s(t_get64(cred, 0)));
    pos = ob_kv(ob, pos, "cred_1", i64s(t_get64(cred, 8)));
    pos = ob_kv(ob, pos, "cred_2", i64s(t_get64(cred, 16)));
    pos = ob_kv(ob, pos, "cred_3", i64s(t_get64(cred, 24)));
    pos = ob_kv(ob, pos, "cred_4", i64s(t_get64(cred, 32)));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

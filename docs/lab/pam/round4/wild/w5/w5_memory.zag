// w5_memory.zag — W5 PAM-AS-MEMORY (frozen PREREG_W5.md + PREREG_AMEND1.md)
// Pure Zag, zero RNG. Usage: w5_memory <tape>
// Admission decisions stored as memories (signature -> decision + strength);
// queries answered by memory lookup. Reference recompute = frozen M1 bar
// (CT=705, MT=3588, ST=0, AT=0) per AMEND1. Open-addressing table in a []u8
// arena, capacity 4096, LE accessors. Phases A (warm+fidelity), B (poison +
// elimination), C (max-strength poison + elimination).
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k); pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v); pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8; b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8; b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8; b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8; b[at+7] = ((v >> 56) & 255) as u8;
}
fn get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8) | ((b[at+2] as i64) << 16)
         | ((b[at+3] as i64) << 24) | ((b[at+4] as i64) << 32)
         | ((b[at+5] as i64) << 40) | ((b[at+6] as i64) << 48)
         | ((b[at+7] as i64) << 56);
}
// ---- store: 4096 slots x 16B: occ@0 dec@1 str@2 tomb@3 key u64@8 ----
fn sig_of(conf:i64, mrg:i64, s:i64, a:i64) i64 {
    return (((conf / 50) * 100003 + (mrg / 500)) * 2 + s) * 2 + a;
}
fn slot_base(key:i64) i32 { return ((key % 4096) as i32) * 16; }
// lookup: returns slot base, or -1 (miss), or -2 (tombstone-hit)
// *plen accumulates probe length
fn st_lookup(st:[]u8, key:i64, plen:*i64) i64 {
    let b:i32 = slot_base(key);
    let n:i64 = 0;
    while(n < 4096) {
        plen.* = plen.* + 1;
        let occ:u8 = st[b];
        if(occ == 0) { return -1; }
        if(get64(st, b + 8) == key) {
            if(st[b + 3] == 1) { return -2; }
            return b as i64;
        }
        b = b + 16;
        if(b >= 65536) { b = 0; }
        n = n + 1;
    }
    return -1;
}
// insert or update; returns slot base
fn st_store(st:[]u8, key:i64, dec:i64, str:i64) i64 {
    let b:i32 = slot_base(key);
    let first_tomb:i64 = -1;
    let n:i64 = 0;
    while(n < 4096) {
        let occ:u8 = st[b];
        if(occ == 0) {
            let at:i64 = first_tomb;
            if(at < 0) { at = b as i64; }
            let ai:i32 = at as i32;
            st[ai] = 1; st[ai+1] = dec as u8; st[ai+2] = str as u8;
            st[ai+3] = 0; put64(st, ai + 8, key);
            return at;
        }
        if(get64(st, b + 8) == key && st[b + 3] == 0) {
            st[b+1] = dec as u8; st[b+2] = str as u8;
            return b as i64;
        }
        if(get64(st, b + 8) == key && st[b + 3] == 1 && first_tomb < 0) {
            first_tomb = b as i64;
        }
        b = b + 16;
        if(b >= 65536) { b = 0; }
        n = n + 1;
    }
    return -1; // full: HALT-with-finding path (asserted never taken)
}
// eliminate: tombstone the key; *old gets previous strength; returns 1 if ELIM logged
fn st_elim(st:[]u8, key:i64, old:*i64) i64 {
    let b:i32 = slot_base(key);
    let n:i64 = 0;
    while(n < 4096) {
        let occ:u8 = st[b];
        if(occ == 0) { return 0; }
        if(get64(st, b + 8) == key && st[b + 3] == 0) {
            old.* = st[b + 2] as i64;
            st[b + 3] = 1;
            return 1;
        }
        b = b + 16;
        if(b >= 65536) { b = 0; }
        n = n + 1;
    }
    return 0;
}
// overwrite decision+strength of an existing entry (poison injection)
fn st_poison(st:[]u8, key:i64, dec:i64, str:i64) i64 {
    let b:i32 = slot_base(key);
    let n:i64 = 0;
    while(n < 4096) {
        let occ:u8 = st[b];
        if(occ == 0) { return 0; }
        if(get64(st, b + 8) == key && st[b + 3] == 0) {
            st[b+1] = dec as u8; st[b+2] = str as u8;
            return 1;
        }
        b = b + 16;
        if(b >= 65536) { b = 0; }
        n = n + 1;
    }
    return 0;
}
// frozen M1 bar (AMEND1): conf>=705 && mrgF>=3588 ; 1=ADMIT 0=REJECT
fn recompute(conf:i64, mrg:i64) i64 {
    if(conf >= 705 && mrg >= 3588) { return 1; }
    return 0;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    // parse tape rows into parallel arrays (max 2241)
    let rconf:[]u8 = nio_alloc(2241 * 8);
    let rmrg:[]u8 = nio_alloc(2241 * 8);
    let rstr:[]u8 = nio_alloc(2241);
    let ragr:[]u8 = nio_alloc(2241);
    let rkind:[]u8 = nio_alloc(2241);
    let wsig:[]u8 = nio_alloc(12 * 8); // W signatures, tape order
    let nrows:i64 = 0; let nw:i64 = 0;
    let fnum:[]u8 = nio_alloc(64);
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let kc:u8 = line[0];
            if(kc == 67 || kc == 87 || kc == 80 || kc == 66) {
                let cfi:i32 = 1; let mfi:i32 = 2; let sfi:i32 = 3; let afi:i32 = 4;
                if(kc == 80) { cfi = 2; mfi = 3; sfi = 3; afi = 3; }
                // P rows: strong/agree = 1 by frozen convention
                let nf:i32 = field(line, llen, cfi, fnum);
                let conf:i64 = atoi(fnum, nf);
                nf = field(line, llen, mfi, fnum);
                let mrg:i64 = atoi(fnum, nf);
                let s:i64 = 1; let a:i64 = 1;
                if(kc == 67 || kc == 66) {
                    nf = field(line, llen, sfi, fnum); s = atoi(fnum, nf);
                    nf = field(line, llen, afi, fnum); a = atoi(fnum, nf);
                }
                put64(rconf, (nrows as i32) * 8, conf);
                put64(rmrg, (nrows as i32) * 8, mrg);
                rstr[nrows as i32] = s as u8;
                ragr[nrows as i32] = a as u8;
                rkind[nrows as i32] = kc;
                if(kc == 87) {
                    put64(wsig, (nw as i32) * 8, sig_of(conf, mrg, 1, 1));
                    nw = nw + 1;
                }
                nrows = nrows + 1;
            }
        }
        p = le + 1;
    }
    // store arena: explicit zero-init (heap not reliably zeroed)
    let st:[]u8 = nio_alloc(65536);
    let zi:i32 = 0;
    while(zi < 65536) { st[zi] = 0; zi = zi + 1; }
    let ob:[]u8 = nio_alloc(1048576);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "W5_MEMORY", "frozen=PREREG_W5.md+PREREG_AMEND1.md");
    let kb_m:i64 = 0; let kb_e:i64 = 0; let kb_k1:i64 = 0;
    let mism_n:i64 = 0;
    // distinct W signatures, tape order (frozen quantization -> 2 distinct)
    let wsig2:[]u8 = nio_alloc(12 * 8);
    let nd:i64 = 0;
    let dj:i64 = 0;
    while(dj < nw) {
        let dkey:i64 = get64(wsig, (dj as i32) * 8);
        let dseen:i64 = 0;
        let dq:i64 = 0;
        while(dq < nd) {
            if(get64(wsig2, (dq as i32) * 8) == dkey) { dseen = 1; }
            dq = dq + 1;
        }
        if(dseen == 0) {
            put64(wsig2, (nd as i32) * 8, dkey);
            nd = nd + 1;
        }
        dj = dj + 1;
    }
    // ---- Phase A: warm + fidelity ----
    let hits:i64 = 0; let misses:i64 = 0; let maxprobe:i64 = 0;
    let i:i64 = 0;
    while(i < nrows) {
        let conf:i64 = get64(rconf, (i as i32) * 8);
        let mrg:i64 = get64(rmrg, (i as i32) * 8);
        let s:i64 = rstr[i as i32] as i64;
        let a:i64 = ragr[i as i32] as i64;
        let key:i64 = sig_of(conf, mrg, s, a);
        let rc:i64 = recompute(conf, mrg);
        let plen:i64 = 0;
        let slot:i64 = st_lookup(st, key, &plen);
        if(plen > maxprobe) { maxprobe = plen; }
        if(slot >= 0) {
            hits = hits + 1;
            let stored:i64 = st[slot as i32 + 1] as i64;
            if(stored != rc) { kb_m = 1; mism_n = mism_n + 1; }
            else {
                let ns:i64 = (st[slot as i32 + 2] as i64) + 1;
                if(ns > 255) { ns = 255; }
                st[slot as i32 + 2] = ns as u8;
            }
        } else {
            misses = misses + 1;
            st_store(st, key, rc, 1);
        }
        i = i + 1;
    }
    // store size = occupied non-tomb slots
    let ssize:i64 = 0;
    let si:i32 = 0;
    while(si < 65536) {
        if(st[si] == 1 && st[si+3] == 0) { ssize = ssize + 1; }
        si = si + 16;
    }
    pos = ob_add(ob, pos, "PHASE|A|rows="); pos = ob_add(ob, pos, i64s(nrows));
    pos = ob_add(ob, pos, "|hits="); pos = ob_add(ob, pos, i64s(hits));
    pos = ob_add(ob, pos, "|misses="); pos = ob_add(ob, pos, i64s(misses));
    pos = ob_add(ob, pos, "|store="); pos = ob_add(ob, pos, i64s(ssize));
    pos = ob_add(ob, pos, "|maxprobe="); pos = ob_add(ob, pos, i64s(maxprobe));
    pos = ob_add(ob, pos, "|mismatch="); pos = ob_add(ob, pos, i64s(mism_n));
    pos = ob_add(ob, pos, "|ndistinct_w="); pos = ob_add(ob, pos, i64s(nd));
    pos = ob_add(ob, pos, "\n");
    // ---- Phase B: poison DISTINCT W sigs -> (ADMIT,9), eliminate, re-query ----
    // NOTE: the frozen quantization yields only 2 distinct W signatures
    // ((15,3,1,1),(16,4,1,1)); the prereg's "12 ELIM lines" was a miscount.
    // Mechanism honored exactly: every poisoned ENTRY is eliminated.
    // (wsig2/nd computed before Phase A.)
    let j:i64 = 0;
    while(j < nd) {
        st_poison(st, get64(wsig2, (j as i32) * 8), 1, 9);
        j = j + 1;
    }
    let elim_b:i64 = 0; let elim_bad:i64 = 0;
    j = 0;
    while(j < nd) {
        let key:i64 = get64(wsig2, (j as i32) * 8);
        let old:i64 = 0;
        let ok:i64 = st_elim(st, key, &old);
        if(ok == 1 && old == 9) {
            elim_b = elim_b + 1;
            pos = ob_add(ob, pos, "ELIM|"); pos = ob_add(ob, pos, i64s(key));
            pos = ob_add(ob, pos, "|"); pos = ob_add(ob, pos, i64s(old));
            pos = ob_add(ob, pos, "\n");
        } else { elim_bad = 1; }
        j = j + 1;
    }
    if(elim_bad == 1 || elim_b != nd) { kb_e = 1; }
    // precise re-query with recompute check: walk W rows again
    let widx:i64 = 0; let req:i64 = 0;
    i = 0;
    while(i < nrows) {
        if(rkind[i as i32] == 87) {
            let conf:i64 = get64(rconf, (i as i32) * 8);
            let mrg:i64 = get64(rmrg, (i as i32) * 8);
            let key:i64 = sig_of(conf, mrg, 1, 1);
            let plen3:i64 = 0;
            let slot:i64 = st_lookup(st, key, &plen3);
            let rc:i64 = recompute(conf, mrg);
            if(slot == -2 || slot == -1) {
                // tombstone/miss forces recompute (R-ELIMINATE / R-NO-RESURRECT)
                if(rc != 0) { kb_k1 = 1; }
                else { req = req + 1; }
                st_store(st, key, rc, 1);
            } else {
                let stored:i64 = st[slot as i32 + 1] as i64;
                if(stored != 0 || stored != rc) { kb_k1 = 1; }
                else { req = req + 1; }
            }
            widx = widx + 1;
        }
        i = i + 1;
    }
    if(req != 12) { kb_e = 1; }
    pos = ob_add(ob, pos, "PHASE|B|elim="); pos = ob_add(ob, pos, i64s(elim_b));
    pos = ob_add(ob, pos, "|post_reject="); pos = ob_add(ob, pos, i64s(req));
    pos = ob_add(ob, pos, "\n");
    // ---- Phase C: re-poison ONE W sig to (ADMIT,255), eliminate, re-query ----
    let ckey:i64 = get64(wsig, 0);
    st_poison(st, ckey, 1, 255);
    let oldc:i64 = 0;
    let okc:i64 = st_elim(st, ckey, &oldc);
    let elim_c:i64 = 0;
    if(okc == 1 && oldc == 255) {
        elim_c = 1;
        pos = ob_add(ob, pos, "ELIM|"); pos = ob_add(ob, pos, i64s(ckey));
        pos = ob_add(ob, pos, "|"); pos = ob_add(ob, pos, i64s(oldc));
        pos = ob_add(ob, pos, "\n");
    } else { kb_e = 1; }
    // post lookup must be REJECT
    let plen4:i64 = 0;
    let slotc:i64 = st_lookup(st, ckey, &plen4);
    // find first W row fields
    let fc:i64 = 0; let fm:i64 = 0;
    i = 0;
    while(i < nrows) {
        if(rkind[i as i32] == 87) {
            fc = get64(rconf, (i as i32) * 8);
            fm = get64(rmrg, (i as i32) * 8);
            break;
        }
        i = i + 1;
    }
    let rcc:i64 = recompute(fc, fm);
    let post_c:i64 = 0;
    if(slotc == -2 || slotc == -1) {
        if(rcc == 0) { post_c = 1; }
        st_store(st, ckey, rcc, 1);
    } else {
        if((st[slotc as i32 + 1] as i64) == 0) { post_c = 1; }
        else { kb_k1 = 1; }
    }
    if(post_c != 1) { kb_k1 = 1; }
    pos = ob_add(ob, pos, "PHASE|C|elim="); pos = ob_add(ob, pos, i64s(elim_c));
    pos = ob_add(ob, pos, "|post_reject="); pos = ob_add(ob, pos, i64s(post_c));
    pos = ob_add(ob, pos, "\n");
    pos = ob_kv(ob, pos, "kb_w5_m", i64s(kb_m));
    pos = ob_kv(ob, pos, "kb_w5_e", i64s(kb_e));
    pos = ob_kv(ob, pos, "kb_w5_k1", i64s(kb_k1));
    _zag_print(ob[0..pos]);
    return 0;
}

// w2.zag — W2 ADVERSARIAL PAM PAIR (PREREG_W2.md, frozen)
// PAM-A Advocate: ADMIT iff conf >= 700.
// PAM-B Skeptic: ADMIT iff (mrgF >= 3588) & (strong | agree) & !P-type & !attack_sig.
// Consensus: ADMIT iff A ADMIT and B ADMIT. Pure Zag, zero RNG.
// Usage: w2 <m1_cases.txt>.
@import("../r4lib.zag")

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let tk:[]u8 = nio_alloc(14 << 3);
    let tc:[]u8 = nio_alloc(14 << 3);
    let tm:[]u8 = nio_alloc(14 << 3);
    let ts:[]u8 = nio_alloc(14 << 3);
    let ta:[]u8 = nio_alloc(14 << 3);
    let tx1:[]u8 = nio_alloc(14 << 3);
    let tx2:[]u8 = nio_alloc(14 << 3);
    let tx3:[]u8 = nio_alloc(14 << 3);
    let na:i64 = load_attacks(tk, tc, tm, ts, ta, tx1, tx2, tx3);
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let c_admit:i64 = 0;
    let w_admit:i64 = 0;
    let p_admit:i64 = 0;
    let b_admit:i64 = 0;
    let a_admit:i64 = 0;
    let npairs:i64 = 0;
    let pdec:[]u8 = nio_alloc(maxrows << 3);
    let s2:i32 = 0;
    while(s2 < maxrows) { t_put64(pdec, s2 << 3, 0); s2 = s2 + 1; }
    let total:i64 = nrows + na;
    let r:i64 = 0;
    while(r < total) {
        let kind:i64 = 0;
        let conf:i64 = 0;
        let mrg:i64 = 0;
        let strong:i64 = 0;
        let agree:i64 = 0;
        let is_base:i64 = 0;
        if(r < nrows) {
            is_base = 1;
            let rr:i32 = r as i32;
            kind = t_get64(akind, rr << 3);
            conf = t_get64(aconf, rr << 3);
            mrg = t_get64(amrg, rr << 3);
            strong = t_get64(astrong, rr << 3);
            agree = t_get64(aagree, rr << 3);
        } else {
            let rr:i32 = (r - nrows) as i32;
            kind = t_get64(tk, rr << 3);
            conf = t_get64(tc, rr << 3);
            mrg = t_get64(tm, rr << 3);
            strong = t_get64(ts, rr << 3);
            agree = t_get64(ta, rr << 3);
        }
        let asg:i64 = attack_sig(kind, 0, 0, 0);
        if(is_base == 0) {
            let rr:i32 = (r - nrows) as i32;
            asg = attack_sig(kind, t_get64(tx1, rr << 3), t_get64(tx2, rr << 3), t_get64(tx3, rr << 3));
        }
        let va:i64 = 0;
        if(conf >= 700) { va = 1; }
        let vb:i64 = 0;
        if(mrg >= 3588 && (strong == 1 || agree == 1) && kind != 2 && asg == 0) { vb = 1; }
        let dec:i64 = 0;
        if(va == 1 && vb == 1) { dec = 1; }
        if(is_base == 1) {
            let rr:i32 = r as i32;
            t_put64(pdec, rr << 3, dec);
            if(kind == 0 && dec == 1) { c_admit = c_admit + 1; }
            if(kind == 1 && dec == 1) { w_admit = w_admit + 1; }
            if(kind == 2 && dec == 1) { p_admit = p_admit + 1; }
            if(kind == 3 && dec == 1) { b_admit = b_admit + 1; }
        } else {
            if(dec == 1) { a_admit = a_admit + 1; }
        }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(va));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(vb));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                if(t_get64(pdec, r2 << 3) == 0) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    // FRK fork-install: both members of any session admitted
    let fork_fail:i64 = 0;
    let f:i32 = 0;
    while(f < 3) {
        let sid:i64 = 501 + f as i64;
        let nm:i64 = 0;
        let i3:i32 = 0;
        while(i3 < na as i32) {
            if(t_get64(tk, i3 << 3) == 5 && t_get64(tx1, i3 << 3) == sid) {
                let conf:i64 = t_get64(tc, i3 << 3);
                let mrg:i64 = t_get64(tm, i3 << 3);
                let strong:i64 = t_get64(ts, i3 << 3);
                let agree:i64 = t_get64(ta, i3 << 3);
                let asg:i64 = attack_sig(5, sid, t_get64(tx2, i3 << 3), t_get64(tx3, i3 << 3));
                let va:i64 = 0;
                if(conf >= 700) { va = 1; }
                let vb:i64 = 0;
                if(mrg >= 3588 && (strong == 1 || agree == 1) && asg == 0) { vb = 1; }
                if(va == 1 && vb == 1) { nm = nm + 1; }
            }
            i3 = i3 + 1;
        }
        if(nm == 2) { fork_fail = 1; }
        f = f + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W2_ADV_PAIR");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "rows_attack", i64s(na));
    pos = ob_kv(ob, pos, "c_admit", i64s(c_admit));
    pos = ob_kv(ob, pos, "w_admit", i64s(w_admit));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "p_member_admit", i64s(p_admit));
    pos = ob_kv(ob, pos, "b_admit", i64s(b_admit));
    pos = ob_kv(ob, pos, "a_admit", i64s(a_admit));
    pos = ob_kv(ob, pos, "fork_fail", i64s(fork_fail));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

// w11_chain.zag — W11 CHAIN-OF-CUSTODY verifier (frozen PREREG_W11.md)
// Pure Zag, zero RNG. Usage: w11_chain <chains_file>
// Chain line: chain_id|nlinks|calib|link0|link1|...
// link = stage,input_hex64,output_hex64,transform,mac_hex64 ; calib 8 hex.
// Checks in frozen order: well-formed -> anchor MAC -> chain MACs ->
// transform allowlist -> length cap L=6 -> calib == CALIB_REG.
// Emits chain_id|ADMIT|OK or chain_id|REJECT|<reason> + summary.
@import("R33_NATIVE_SHA256_V2.zag")

fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn pfield(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn cfield(link:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 44;
        if(i < llen) { c = link[i]; }
        if(c == 44 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = link[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
fn hexval(c:u8) i64 {
    if(c >= 48 && c <= 57) { return (c - 48) as i64; }
    if(c >= 97 && c <= 102) { return (c - 87) as i64; }
    if(c >= 65 && c <= 70) { return (c - 55) as i64; }
    return -1;
}
// n hex chars -> n/2 bytes; 0 ok, -1 bad
fn hexparse(s:[]u8, n:i32, out:[]u8) i64 {
    if(n % 2 != 0) { return -1; }
    if(n / 2 > out.len) { return -1; }
    let i:i32 = 0;
    while(i < n) {
        let hi:i64 = hexval(s[i]); let lo:i64 = hexval(s[i + 1]);
        if(hi < 0 || lo < 0) { return -1; }
        out[i / 2] = (hi * 16 + lo) as u8;
        i = i + 2;
    }
    return 0;
}
fn be32(v:i64, out:[]u8) void {
    out[0] = ((v >> 24) & 255) as u8; out[1] = ((v >> 16) & 255) as u8;
    out[2] = ((v >> 8) & 255) as u8; out[3] = (v & 255) as u8;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// HMAC-SHA256(K,msg): mac_out 32B; returns 0 ok
fn hmac32(mac_out:[]u8, k_ipad:[]u8, k_opad:[]u8, msg:[]u8, mlen:i32) i32 {
    let ii:[]u8 = nio_alloc(64 + mlen);
    if(ii.len == 0) { return -12; }
    let i:i32 = 0;
    while(i < 64) { ii[i] = k_ipad[i]; i = i + 1; }
    i = 0;
    while(i < mlen) { ii[64 + i] = msg[i]; i = i + 1; }
    let ih:[]u8 = nio_alloc(32);
    if(ih.len == 0) { nio_free(ii); return -12; }
    let r1:i32 = ns_sha256(ii, ih);
    let oi:[]u8 = nio_alloc(96);
    if(oi.len == 0) { nio_free(ii); nio_free(ih); return -12; }
    i = 0;
    while(i < 64) { oi[i] = k_opad[i]; i = i + 1; }
    i = 0;
    while(i < 32) { oi[64 + i] = ih[i]; i = i + 1; }
    let r2:i32 = ns_sha256(oi, mac_out);
    nio_free(ii); nio_free(ih); nio_free(oi);
    if(r1 != 0 || r2 != 0) { return -7403; }
    return 0;
}
fn beq(a:[]u8, b:[]u8, n:i32) i64 {
    let i:i32 = 0;
    while(i < n) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// verify one chain line; returns 0=ADMIT, else reason code:
// 1 WELLFORMED 2 ANCHOR_MAC 3 CHAIN_MAC 4 ALLOWLIST 5 OVERLONG 6 CALIB
fn verify(line:[]u8, llen:i32, k_ipad:[]u8, k_opad:[]u8) i64 {
    let fb:[]u8 = nio_alloc(256);
    let cb:[]u8 = nio_alloc(256);
    let inb:[]u8 = nio_alloc(32);
    let outb:[]u8 = nio_alloc(32);
    let macb:[]u8 = nio_alloc(32);
    let prevm:[]u8 = nio_alloc(32);
    let mac:[]u8 = nio_alloc(32);
    let msg:[]u8 = nio_alloc(128);
    let b4:[]u8 = nio_alloc(4);
    if(fb.len == 0 || mac.len == 0) { return 1; }
    // count pipes -> nfields
    let pipes:i32 = 0;
    let pi:i32 = 0;
    while(pi < llen) {
        if(line[pi] == 124) { pipes = pipes + 1; }
        pi = pi + 1;
    }
    let nfields:i32 = pipes + 1;
    if(nfields < 4) { return 1; }
    let nf:i32 = pfield(line, llen, 0, fb);
    if(nf <= 0 || nf > 16) { return 1; }
    let cid:i64 = atoi(fb, nf);
    nf = pfield(line, llen, 1, fb);
    if(nf <= 0 || nf > 8) { return 1; }
    let nlinks:i64 = atoi(fb, nf);
    if(nlinks < 1 || nlinks > 64) { return 1; }
    if(nfields != 3 + nlinks as i32) { return 1; }
    nf = pfield(line, llen, 2, fb);
    if(nf != 8) { return 1; }
    if(hexparse(fb, 8, b4) != 0) { return 1; }
    let calib:i64 = (b4[0] as i64) * 16777216 + (b4[1] as i64) * 65536
                  + (b4[2] as i64) * 256 + (b4[3] as i64);
    // parse + verify each link
    let li:i64 = 0;
    while(li < nlinks) {
        nf = pfield(line, llen, 3 + li as i32, fb);
        if(nf <= 0 || nf > 255) { return 1; }
        let llen2:i32 = nf;
        // link fields via cfield on fb[0..nf]
        let link:[]u8 = fb[0..nf];
        let cf:i32 = cfield(link, llen2, 0, cb);
        if(cf <= 0 || cf > 8) { return 1; }
        let stage:i64 = atoi(cb, cf);
        cf = cfield(link, llen2, 1, cb);
        if(cf != 64 || hexparse(cb, 64, inb) != 0) { return 1; }
        cf = cfield(link, llen2, 2, cb);
        if(cf != 64 || hexparse(cb, 64, outb) != 0) { return 1; }
        cf = cfield(link, llen2, 3, cb);
        if(cf <= 0 || cf > 8) { return 1; }
        let tr:i64 = atoi(cb, cf);
        cf = cfield(link, llen2, 4, cb);
        if(cf != 64 || hexparse(cb, 64, macb) != 0) { return 1; }
        // exactly 5 comma fields
        let commas:i32 = 0;
        let qi:i32 = 0;
        while(qi < llen2) {
            if(link[qi] == 44) { commas = commas + 1; }
            qi = qi + 1;
        }
        if(commas != 4) { return 1; }
        if(li == 0) {
            // anchor MAC: HMAC("W11A" || cid_be32 || calib_be32 || input)
            msg[0] = 87; msg[1] = 49; msg[2] = 49; msg[3] = 65;
            be32(cid, b4); 
            let bi:i32 = 0;
            while(bi < 4) { msg[4 + bi] = b4[bi]; bi = bi + 1; }
            be32(calib, b4);
            bi = 0;
            while(bi < 4) { msg[8 + bi] = b4[bi]; bi = bi + 1; }
            bi = 0;
            while(bi < 32) { msg[12 + bi] = inb[bi]; bi = bi + 1; }
            if(hmac32(mac, k_ipad, k_opad, msg, 44) != 0) { return 1; }
            if(beq(mac, macb, 32) == 0) { return 2; }
            if(tr != 0) { return 4; }
        } else {
            // chain MAC: HMAC(stage_be32 || input || output || tr_be32 || prev_mac)
            be32(stage, b4);
            let bi:i32 = 0;
            while(bi < 4) { msg[bi] = b4[bi]; bi = bi + 1; }
            bi = 0;
            while(bi < 32) { msg[4 + bi] = inb[bi]; bi = bi + 1; }
            bi = 0;
            while(bi < 32) { msg[36 + bi] = outb[bi]; bi = bi + 1; }
            be32(tr, b4);
            bi = 0;
            while(bi < 4) { msg[68 + bi] = b4[bi]; bi = bi + 1; }
            bi = 0;
            while(bi < 32) { msg[72 + bi] = prevm[bi]; bi = bi + 1; }
            if(hmac32(mac, k_ipad, k_opad, msg, 104) != 0) { return 1; }
            if(beq(mac, macb, 32) == 0) { return 3; }
            if(tr < 1 || tr > 8) { return 4; }
        }
        // save this mac as prev
        let mi:i32 = 0;
        while(mi < 32) { prevm[mi] = macb[mi]; mi = mi + 1; }
        li = li + 1;
    }
    if(nlinks > 6) { return 5; }
    if(calib != 3237998097) { return 6; } // 0xC0FFEE11
    return 0;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let fmax:i32 = 4194304;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    // device key K[i] = ((i*2654435761 + 0x9e3779b9) mod 256)
    let k_ipad:[]u8 = nio_alloc(64);
    let k_opad:[]u8 = nio_alloc(64);
    let ki:i32 = 0;
    while(ki < 64) {
        let kb:i64 = 0;
        if(ki < 32) { kb = (ki as i64 * 2654435761 + 2654435769) % 256; }
        if(ki < 32) {
            k_ipad[ki] = (kb ^ 54) as u8;
            k_opad[ki] = (kb ^ 92) as u8;
        } else {
            k_ipad[ki] = 54;
            k_opad[ki] = 92;
        }
        ki = ki + 1;
    }
    let ob:[]u8 = nio_alloc(1048576);
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "W11_CHAIN|frozen=PREREG_W11.md\n");
    let nadmit:i64 = 0; let nreject:i64 = 0; let nent:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 8192) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            // chain_id = field 0 for the report
            let idb:[]u8 = nio_alloc(16);
            let idn:i32 = pfield(line, llen, 0, idb);
            let rc:i64 = verify(line, llen, k_ipad, k_opad);
            pos = ob_add(ob, pos, idb[0..idn]);
            pos = ob_add(ob, pos, "|");
            if(rc == 0) {
                pos = ob_add(ob, pos, "ADMIT|OK");
                nadmit = nadmit + 1;
            } else {
                pos = ob_add(ob, pos, "REJECT|");
                if(rc == 1) { pos = ob_add(ob, pos, "WELLFORMED"); }
                if(rc == 2) { pos = ob_add(ob, pos, "ANCHOR_MAC"); }
                if(rc == 3) { pos = ob_add(ob, pos, "CHAIN_MAC"); }
                if(rc == 4) { pos = ob_add(ob, pos, "ALLOWLIST"); }
                if(rc == 5) { pos = ob_add(ob, pos, "OVERLONG"); }
                if(rc == 6) { pos = ob_add(ob, pos, "CALIB"); }
                nreject = nreject + 1;
            }
            pos = ob_add(ob, pos, "\n");
            nent = nent + 1;
        }
        p = le + 1;
    }
    pos = ob_add(ob, pos, "SUMMARY|n=");
    pos = ob_add(ob, pos, i64s(nent));
    pos = ob_add(ob, pos, "|admit=");
    pos = ob_add(ob, pos, i64s(nadmit));
    pos = ob_add(ob, pos, "|reject=");
    pos = ob_add(ob, pos, i64s(nreject));
    pos = ob_add(ob, pos, "\n");
    _zag_print(ob[0..pos]);
    return 0;
}

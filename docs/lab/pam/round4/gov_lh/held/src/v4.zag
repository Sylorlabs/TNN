// v4.zag — V4 two-tier corroborated-revision live machinery (PAM GOV-LH Crew 6).
//
// Frozen spec: PREREG_CREW6_HELD.md (Leg A, section A.2).
// Base: c3.zag verbatim (O1 Delivery Adjudicator + revised gate R1/R3/R4,
// disposition codes 0..9, thr_of/tol_of, scoring). V4 additions:
//
//   V4-1 challenger slot extension: stores (jcode, measure, seq, conf, mrgF,
//        span_a, span_b) per task.
//   V4-2 F5-exemplar-distance precondition, BEFORE MG6 (preregistered order):
//        at the R1 revision point, veto iff EITHER challenger (stored or
//        incoming) is within F5 exemplar distance of ANY of the 6 frozen F5
//        exemplars (tcode==4 -> stem "TMB"; |dconf|<=9 AND |dmeas|<=15).
//        Veto -> CHALLENGER_PROV (disp 8), challenger slot RETAINED.
//   V4-3 CC1 margin guard MG6 (frozen, VERDICT_CC1_GUARD.md): allow
//        REVISED_INSTALL iff min(mrgF_s,mrgF_i)>=400 AND spans disjoint AND
//        |seq_s-seq_i|>=20; else veto -> CHALLENGER_PROV, slot retained.
//        Spans: mode 1 derives (seq, seq+2000) [frozen modeling choice];
//        mode 2 uses explicit span_a/span_b trial fields (engineered streams).
//
// CLI: v4 <case_file> <mode> <metrics_out>
//   mode 1: 13-field lines seq|tcode|prog|progF|agree|strong|conf|mrgF|
//           jcode|pred|measure|correct|truth ; spans derived.
//   mode 2: 15-field lines (13 above + span_a|span_b) ; spans explicit.
// Metrics out: c3 metrics + f5_vetoes, mg6_veto_floor, mg6_veto_span,
//   mg6_veto_seqgap, mg6_allows.
//
// truth/correct appear ONLY in scoring code (static-checkable).
// Pure Zag, integer math only, zero RNG, fully deterministic.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_open_read(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn z_write_open(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    return fd;
}
// Chunked reader via raw read(2): fills out[0..maxn) from fd.
// Returns bytes read (0..maxn; 0 = EOF), or <0 on error. Retries EINTR.
// (nio_read_exact is whole-file and rejects size>maxn, so it cannot back
// the chunked loop for files larger than CHUNK.)
fn z_read_fill(fd:i64, out:[]u8, maxn:i32) i64 {
    if(fd < 0 || maxn < 0 || maxn > out.len) { return -7401; }
    let total:i64 = 0;
    let guard:i32 = 0;
    while(total < maxn as i64 && guard < 4096) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(out) as i64) + total,
                                    (maxn as i64) - total, 0, 0, 0);
        guard = guard + 1;
        if(n == -4) { continue; }
        if(n < 0) { return n; }
        if(n == 0) { break; }
        total = total + n;
    }
    return total;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn tol_of(tc:i32) i64 {
    if(tc == 0) { return 8; }
    if(tc == 1) { return 40; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 4000; }
    if(tc == 4) { return 120; }
    return 0;
}
fn thr_of(tc:i32) i64 {
    if(tc == 0) { return 400; }
    if(tc == 1) { return 50; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 1500; }
    if(tc == 4) { return 80; }
    return 2;
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}

// ---- F5 exemplar bank (frozen exemplars.tsv, SHA
//      13f4ca47429bc0bb8788d60406593766e48f6f064cb7538adf28be16a289200e)
//      All fam TMB-1 -> stem "TMB"; gate trials with tcode==4 -> stem "TMB".
//      The stem conjunct is identically true; the distance conjunct decides.
fn f5_exemplar_near(conf:i64, meas:i64) i32 {
    if(iabs(conf - 718) <= 9 && iabs(meas - 2618) <= 15) { return 1; }
    if(iabs(conf - 704) <= 9 && iabs(meas - 2642) <= 15) { return 1; }
    if(iabs(conf - 713) <= 9 && iabs(meas - 2626) <= 15) { return 1; }
    if(iabs(conf - 701) <= 9 && iabs(meas - 2647) <= 15) { return 1; }
    if(iabs(conf - 710) <= 9 && iabs(meas - 2632) <= 15) { return 1; }
    if(iabs(conf - 713) <= 9 && iabs(meas - 2627) <= 15) { return 1; }
    return 0;
}

// ---- metric word offsets ----
const M_K1N:i32=0;
const M_K1D:i32=1;
const M_K2N:i32=2;
const M_K2D:i32=3;
const M_RK3N:i32=4;
const M_RK3D:i32=5;
const M_RK1FP:i32=6;
const M_RK2N:i32=7;
const M_RK2D:i32=8;
const M_REP:i32=9;
const M_REV:i32=10;
const M_CHP:i32=11;
const M_TRI:i32=12;
const M_F5V:i32=13;
const M_FLOOR:i32=14;
const M_SPAN:i32=15;
const M_SGAP:i32=16;
const M_ALLOW:i32=17;
const M_NW:i32=18;

// One trial through the V4 gate. Returns the disposition code.
// truth/correct are scoring-only (never read by any gate rule below).
fn step(seq:i64, tc:i32, pr:i64, pf:i64, ag:i64, conf:i64, mrgF:i64, jc:i64,
       pred:i64, meas:i64, correct:i64, ssa:i64, ssb:i64, spanmode:i64,
       prov_on:[]u8, prov_j:[]u8, prov_m:[]u8, prov_s:[]u8,
       perm_on:[]u8, perm_j:[]u8, perm_m:[]u8, perm_s:[]u8,
       chal_on:[]u8, chal_j:[]u8, chal_m:[]u8, chal_s:[]u8,
       chal_c:[]u8, chal_mrg:[]u8, chal_seq:[]u8, chal_sa:[]u8, chal_sb:[]u8,
       neg_j:[]u8, neg_m:[]u8, neg_n:[]u8,
       negp_on:[]u8, negp_j:[]u8, negp_m:[]u8,
       dcounts:[]u8, m:[]u8) i32 {
    // ---- Delivery Adjudicator (frozen O1 logic) ----
    if(pr != 0 && pf == 0 && ag == 1 && conf >= 700) {
        pr = 0;
        pred = 1;
        t_put64(m, M_REP*8, t_get64(m, M_REP*8) + 1);
    }
    // ---- scoring denominators ----
    let hiconf_correct:i64 = 0;
    if(correct == 1 && conf >= 700) { hiconf_correct = 1; }
    if(hiconf_correct == 1) {
        t_put64(m, M_K1D*8, t_get64(m, M_K1D*8) + 1);
        t_put64(m, M_K2D*8, t_get64(m, M_K2D*8) + 1);
        t_put64(m, M_RK3D*8, t_get64(m, M_RK3D*8) + 1);
        if(pf == 0) { t_put64(m, M_K1N*8, t_get64(m, M_K1N*8) + 1); }
        if(pr == 0) { t_put64(m, M_K2N*8, t_get64(m, M_K2N*8) + 1); }
    }
    if(correct == 0 && conf >= 700) {
        t_put64(m, M_RK2D*8, t_get64(m, M_RK2D*8) + 1);
    }
    // ---- gate logic (c3.zag verbatim, V4 at the R1 revision point) ----
    // disp: 0=PROV_INSTALL 1=PERM_INSTALL 2=CORROBORATED
    // 3=CONFLICT_WITHHELD 4=SUPPRESSED 5=WITHHELD 6=NEG_EVIDENCE
    // 7=bad-record 8=CHALLENGER_PROV 9=REVISED_INSTALL
    let disp:i32 = 7;
    if(tc >= 0 && tc < 6 && (pr == 0 || pr == 1 || pr == 2)) {
        let tol:i64 = tol_of(tc);
        let nm:i32 = 0;
        let nn:i64 = t_get64(neg_n, tc * 8);
        let k:i64 = 0;
        while(k < nn) {
            if(t_get64(neg_j, (tc * 256 + k as i32) * 8) == jc
               && iabs(t_get64(neg_m, (tc * 256 + k as i32) * 8) - meas) <= tol) {
                nm = 1;
                break;
            }
            k = k + 1;
        }
        if(pr == 1) {
            // R4: two FAILs arm; first FAIL -> pending.
            let pmatch:i32 = 0;
            if(t_get64(negp_on, tc * 8) == 1
               && t_get64(negp_j, tc * 8) == jc
               && iabs(t_get64(negp_m, tc * 8) - meas) <= tol) {
                pmatch = 1;
            }
            if(pmatch == 1) {
                if(nm == 0 && nn < 256) {
                    t_put64(neg_j, (tc * 256 + nn as i32) * 8, jc);
                    t_put64(neg_m, (tc * 256 + nn as i32) * 8, meas);
                    t_put64(neg_n, tc * 8, nn + 1);
                }
                t_put64(negp_on, tc * 8, 0);
            } else if(nm == 0) {
                t_put64(negp_on, tc * 8, 1);
                t_put64(negp_j, tc * 8, jc);
                t_put64(negp_m, tc * 8, meas);
            }
            disp = 6;
        } else if(pr == 2) {
            if(nm == 1) { disp = 4; } else { disp = 5; }
        } else {
            if(pred == 0) {
                disp = 5;
            } else if(nm == 1) {
                disp = 4;
            } else if(t_get64(perm_on, tc * 8) == 1) {
                let pj:i64 = t_get64(perm_j, tc * 8);
                let pm:i64 = t_get64(perm_m, tc * 8);
                if(jc == pj && iabs(pm - meas) <= tol) {
                    disp = 2;
                } else if(jc != pj) {
                    if(conf >= 700 && mrgF >= thr_of(tc)) {
                        // R1+R3: corroborated revision point (rev always 1 here).
                        let cmatch:i32 = 0;
                        if(t_get64(chal_on, tc * 8) == 1
                           && t_get64(chal_j, tc * 8) == jc
                           && iabs(t_get64(chal_m, tc * 8) - meas) <= tol) {
                            cmatch = 1;
                        }
                        if(cmatch == 1) {
                            // ===== V4 revision point =====
                            let csc:i64 = t_get64(chal_c, tc * 8);
                            let csm:i64 = t_get64(chal_m, tc * 8);
                            let csg:i64 = t_get64(chal_seq, tc * 8);
                            let cmg:i64 = t_get64(chal_mrg, tc * 8);
                            let csa:i64 = t_get64(chal_sa, tc * 8);
                            let csb:i64 = t_get64(chal_sb, tc * 8);
                            // V4-2: F5-exemplar veto FIRST (preregistered order).
                            if(tc == 4 && (f5_exemplar_near(csc, csm) == 1
                                           || f5_exemplar_near(conf, meas) == 1)) {
                                t_put64(m, M_F5V*8, t_get64(m, M_F5V*8) + 1);
                                disp = 8;
                            } else {
                                // V4-3: MG6 (frozen). First-firing conjunct counted.
                                let vcode:i32 = 0;
                                if(cmg < 400 || mrgF < 400) { vcode = 1; }
                                if(vcode == 0 && csa < ssb && ssa < csb) { vcode = 2; }
                                if(vcode == 0 && iabs(csg - seq) < 20) { vcode = 3; }
                                if(vcode == 1) {
                                    t_put64(m, M_FLOOR*8, t_get64(m, M_FLOOR*8) + 1);
                                    disp = 8;
                                }
                                if(vcode == 2) {
                                    t_put64(m, M_SPAN*8, t_get64(m, M_SPAN*8) + 1);
                                    disp = 8;
                                }
                                if(vcode == 3) {
                                    t_put64(m, M_SGAP*8, t_get64(m, M_SGAP*8) + 1);
                                    disp = 8;
                                }
                                if(vcode == 0) {
                                    t_put64(m, M_ALLOW*8, t_get64(m, M_ALLOW*8) + 1);
                                    t_put64(perm_on, tc * 8, 1);
                                    t_put64(perm_j, tc * 8, jc);
                                    t_put64(perm_m, tc * 8, meas);
                                    t_put64(perm_s, tc * 8, seq);
                                    t_put64(chal_on, tc * 8, 0);
                                    disp = 9;
                                    t_put64(m, M_REV*8, t_get64(m, M_REV*8) + 1);
                                }
                            }
                            // on veto: disp 8, challenger slot RETAINED (faithful).
                        } else {
                            t_put64(chal_on, tc * 8, 1);
                            t_put64(chal_j, tc * 8, jc);
                            t_put64(chal_m, tc * 8, meas);
                            t_put64(chal_s, tc * 8, seq);
                            t_put64(chal_c, tc * 8, conf);
                            t_put64(chal_mrg, tc * 8, mrgF);
                            t_put64(chal_seq, tc * 8, seq);
                            t_put64(chal_sa, tc * 8, ssa);
                            t_put64(chal_sb, tc * 8, ssb);
                            disp = 8;
                            t_put64(m, M_CHP*8, t_get64(m, M_CHP*8) + 1);
                        }
                    } else {
                        disp = 3;
                    }
                } else {
                    disp = 2;
                }
            } else if(t_get64(prov_on, tc * 8) == 1) {
                let pj:i64 = t_get64(prov_j, tc * 8);
                let pm:i64 = t_get64(prov_m, tc * 8);
                if(jc == pj && iabs(pm - meas) <= tol) {
                    t_put64(perm_on, tc * 8, 1);
                    t_put64(perm_j, tc * 8, jc);
                    t_put64(perm_m, tc * 8, meas);
                    t_put64(perm_s, tc * 8, seq);
                    t_put64(prov_on, tc * 8, 0);
                    disp = 1;
                } else if(jc != pj) {
                    t_put64(prov_j, tc * 8, jc);
                    t_put64(prov_m, tc * 8, meas);
                    t_put64(prov_s, tc * 8, seq);
                    disp = 0;
                } else {
                    disp = 2;
                }
            } else {
                t_put64(prov_on, tc * 8, 1);
                t_put64(prov_j, tc * 8, jc);
                t_put64(prov_m, tc * 8, meas);
                t_put64(prov_s, tc * 8, seq);
                disp = 0;
            }
        }
    }
    t_put64(dcounts, disp * 8, t_get64(dcounts, disp * 8) + 1);
    // ---- scoring: installs ----
    if(hiconf_correct == 1) {
        if(disp == 0 || disp == 1 || disp == 2 || disp == 8 || disp == 9) {
            t_put64(m, M_RK3N*8, t_get64(m, M_RK3N*8) + 1);
        }
    }
    if((disp == 1 || disp == 9) && correct == 0) {
        t_put64(m, M_RK1FP*8, t_get64(m, M_RK1FP*8) + 1);
    }
    if(correct == 0 && conf >= 700 && (disp == 1 || disp == 9)) {
        t_put64(m, M_RK2N*8, t_get64(m, M_RK2N*8) + 1);
    }
    t_put64(m, M_TRI*8, t_get64(m, M_TRI*8) + 1);
    return disp;
}

// Parse one line (13 fields mode 1, 15 fields mode 2) and run it through step.
fn proc_line(line:[]u8, llen:i32, spanmode:i64,
       prov_on:[]u8, prov_j:[]u8, prov_m:[]u8, prov_s:[]u8,
       perm_on:[]u8, perm_j:[]u8, perm_m:[]u8, perm_s:[]u8,
       chal_on:[]u8, chal_j:[]u8, chal_m:[]u8, chal_s:[]u8,
       chal_c:[]u8, chal_mrg:[]u8, chal_seq:[]u8, chal_sa:[]u8, chal_sb:[]u8,
       neg_j:[]u8, neg_m:[]u8, neg_n:[]u8,
       negp_on:[]u8, negp_j:[]u8, negp_m:[]u8,
       dcounts:[]u8, m:[]u8) i32 {
    let fnum:[]u8 = nio_alloc(64);
    let nf:i32 = field(line, llen, 0, fnum);
    let seq:i64 = atoi(fnum, nf);
    nf = field(line, llen, 1, fnum);
    let tc:i32 = atoi(fnum, nf) as i32;
    nf = field(line, llen, 2, fnum);
    let pr:i64 = atoi(fnum, nf);
    nf = field(line, llen, 3, fnum);
    let pf:i64 = atoi(fnum, nf);
    nf = field(line, llen, 4, fnum);
    let ag:i64 = atoi(fnum, nf);
    nf = field(line, llen, 6, fnum);
    let conf:i64 = atoi(fnum, nf);
    nf = field(line, llen, 7, fnum);
    let mrgF:i64 = atoi(fnum, nf);
    nf = field(line, llen, 8, fnum);
    let jc:i64 = atoi(fnum, nf);
    nf = field(line, llen, 9, fnum);
    let pred:i64 = atoi(fnum, nf);
    nf = field(line, llen, 10, fnum);
    let meas:i64 = atoi(fnum, nf);
    nf = field(line, llen, 11, fnum);
    let correct:i64 = atoi(fnum, nf);
    // field 12 (truth) is never parsed: structurally unreadable by the gate.
    let ssa:i64 = seq;
    let ssb:i64 = seq + 2000;
    if(spanmode == 2) {
        nf = field(line, llen, 13, fnum);
        ssa = atoi(fnum, nf);
        nf = field(line, llen, 14, fnum);
        ssb = atoi(fnum, nf);
    }
    nio_free(fnum);
    return step(seq, tc, pr, pf, ag, conf, mrgF, jc, pred, meas, correct,
        ssa, ssb, spanmode,
        prov_on, prov_j, prov_m, prov_s, perm_on, perm_j, perm_m, perm_s,
        chal_on, chal_j, chal_m, chal_s, chal_c, chal_mrg, chal_seq,
        chal_sa, chal_sb, neg_j, neg_m, neg_n, negp_on, negp_j, negp_m,
        dcounts, m);
}

fn trace_line(idx:i64, disp:i32) void {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "V4|");
    pos = ob_add(ob, pos, i64s(idx));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(disp as i64));
    pos = ob_add(ob, pos, "\n");
    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return; }
    nio_free(ob);
    return;
}

const CHUNK:i32 = 4194304;

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0) { return 1; }
    let mode:i64 = atoi(a2, a2.len);
    if(mode != 1 && mode != 2) { return 1; }
    let spanmode:i64 = mode;
    let trace:i64 = 0;
    let a4:[]u8 = _zag_arg(4);
    if(a4.len == 1 && a4[0] == 49) { trace = 1; }
    // per-task state arenas
    let prov_on:[]u8 = nio_alloc(48);
    let prov_j:[]u8 = nio_alloc(48);
    let prov_m:[]u8 = nio_alloc(48);
    let prov_s:[]u8 = nio_alloc(48);
    let perm_on:[]u8 = nio_alloc(48);
    let perm_j:[]u8 = nio_alloc(48);
    let perm_m:[]u8 = nio_alloc(48);
    let perm_s:[]u8 = nio_alloc(48);
    let chal_on:[]u8 = nio_alloc(48);
    let chal_j:[]u8 = nio_alloc(48);
    let chal_m:[]u8 = nio_alloc(48);
    let chal_s:[]u8 = nio_alloc(48);
    let chal_c:[]u8 = nio_alloc(48);
    let chal_mrg:[]u8 = nio_alloc(48);
    let chal_seq:[]u8 = nio_alloc(48);
    let chal_sa:[]u8 = nio_alloc(48);
    let chal_sb:[]u8 = nio_alloc(48);
    let neg_j:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_m:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_n:[]u8 = nio_alloc(48);
    let negp_on:[]u8 = nio_alloc(48);
    let negp_j:[]u8 = nio_alloc(48);
    let negp_m:[]u8 = nio_alloc(48);
    let dcounts:[]u8 = nio_alloc(10 * 8);
    let m:[]u8 = nio_alloc(M_NW * 8);
    let t:i32 = 0;
    while(t < 6) {
        t_put64(prov_on, t * 8, 0);
        t_put64(perm_on, t * 8, 0);
        t_put64(chal_on, t * 8, 0);
        t_put64(neg_n, t * 8, 0);
        t_put64(negp_on, t * 8, 0);
        t = t + 1;
    }
    let di:i32 = 0;
    while(di < 10) { t_put64(dcounts, di * 8, 0); di = di + 1; }
    let mi:i32 = 0;
    while(mi < M_NW) { t_put64(m, mi * 8, 0); mi = mi + 1; }
    // ---- streaming input (chunked; supports >2^25-byte files) ----
    let fd:i64 = z_open_read(a1);
    if(fd < 0) { return 1; }
    let ch:[]u8 = nio_alloc(CHUNK);
    let work:[]u8 = nio_alloc(CHUNK + 4096);
    let tail:[]u8 = nio_alloc(4096);
    let taillen:i32 = 0;
    let trialidx:i64 = 0;
    let eof:i32 = 0;
    while(eof == 0) {
        let nr:i64 = z_read_fill(fd, ch, CHUNK);
        if(nr < 0) { return 1; }
        let i:i32 = 0;
        while(i < taillen) { work[i] = tail[i]; i = i + 1; }
        let j:i64 = 0;
        while(j < nr) {
            work[(taillen as i64 + j) as i32] = ch[j as i32];
            j = j + 1;
        }
        let total:i32 = taillen + nr as i32;
        let lastnl:i32 = -1;
        let k:i32 = 0;
        while(k < total) {
            if(work[k] == 10) { lastnl = k; }
            k = k + 1;
        }
        let end:i32 = total;
        if(lastnl >= 0) { end = lastnl + 1; }
        let ls:i32 = 0;
        let p:i32 = 0;
        while(p < end) {
            if(work[p] == 10) {
                let llen:i32 = p - ls;
                if(llen > 0 && llen < 4000) {
                    let line:[]u8 = work[ls .. p];
                    let d:i32 = proc_line(line, llen, spanmode,
                        prov_on, prov_j, prov_m, prov_s,
                        perm_on, perm_j, perm_m, perm_s,
                        chal_on, chal_j, chal_m, chal_s,
                        chal_c, chal_mrg, chal_seq, chal_sa, chal_sb,
                        neg_j, neg_m, neg_n, negp_on, negp_j, negp_m,
                        dcounts, m);
                    if(trace == 1) { trace_line(trialidx, d); }
                    trialidx = trialidx + 1;
                }
                ls = p + 1;
            }
            p = p + 1;
        }
        taillen = total - end;
        let q:i32 = 0;
        while(q < taillen) { tail[q] = work[end + q]; q = q + 1; }
        if(nr < CHUNK as i64) {
            if(taillen > 0) {
                let line:[]u8 = tail[0 .. taillen];
                let d:i32 = proc_line(line, taillen, spanmode,
                    prov_on, prov_j, prov_m, prov_s,
                    perm_on, perm_j, perm_m, perm_s,
                    chal_on, chal_j, chal_m, chal_s,
                    chal_c, chal_mrg, chal_seq, chal_sa, chal_sb,
                    neg_j, neg_m, neg_n, negp_on, negp_j, negp_m,
                    dcounts, m);
                if(trace == 1) { trace_line(trialidx, d); }
                trialidx = trialidx + 1;
            }
            eof = 1;
        }
    }
    nio_close(fd);
    // ---- write metrics ----
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "mode", i64s(mode));
    pos = ob_kv(ob, pos, "trials", i64s(t_get64(m, M_TRI*8)));
    pos = ob_kv(ob, pos, "k1_num", i64s(t_get64(m, M_K1N*8)));
    pos = ob_kv(ob, pos, "k1_den", i64s(t_get64(m, M_K1D*8)));
    pos = ob_kv(ob, pos, "k2_num", i64s(t_get64(m, M_K2N*8)));
    pos = ob_kv(ob, pos, "k2_den", i64s(t_get64(m, M_K2D*8)));
    pos = ob_kv(ob, pos, "rk3_num", i64s(t_get64(m, M_RK3N*8)));
    pos = ob_kv(ob, pos, "rk3_den", i64s(t_get64(m, M_RK3D*8)));
    pos = ob_kv(ob, pos, "rk1_falseperm", i64s(t_get64(m, M_RK1FP*8)));
    pos = ob_kv(ob, pos, "rk2_num", i64s(t_get64(m, M_RK2N*8)));
    pos = ob_kv(ob, pos, "rk2_den", i64s(t_get64(m, M_RK2D*8)));
    pos = ob_kv(ob, pos, "repaired", i64s(t_get64(m, M_REP*8)));
    pos = ob_kv(ob, pos, "revised_installs", i64s(t_get64(m, M_REV*8)));
    pos = ob_kv(ob, pos, "challenger_provs", i64s(t_get64(m, M_CHP*8)));
    pos = ob_kv(ob, pos, "f5_vetoes", i64s(t_get64(m, M_F5V*8)));
    pos = ob_kv(ob, pos, "mg6_veto_floor", i64s(t_get64(m, M_FLOOR*8)));
    pos = ob_kv(ob, pos, "mg6_veto_span", i64s(t_get64(m, M_SPAN*8)));
    pos = ob_kv(ob, pos, "mg6_veto_seqgap", i64s(t_get64(m, M_SGAP*8)));
    pos = ob_kv(ob, pos, "mg6_allows", i64s(t_get64(m, M_ALLOW*8)));
    di = 0;
    while(di < 10) {
        let nm2:[]u8 = nio_alloc(8);
        nm2[0] = 100;
        nm2[1] = (48 + di) as u8;
        pos = ob_kv(ob, pos, nm2[0..2], i64s(t_get64(dcounts, di * 8)));
        nio_free(nm2);
        di = di + 1;
    }
    let wfd:i64 = z_write_open(a3);
    if(wfd < 0) { return 1; }
    if(nio_write_all(wfd, ob[0..pos]) != pos as i64) { return 1; }
    nio_close(wfd);
    nio_free(ob);
    return 0;
}

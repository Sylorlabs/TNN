// d2bar.zag — D2 repaired release-bar battery runner (PAM gov-LH crew 5).
//
// argv: (battery_tsv, exemplars_tsv, organ, memory_tsv)
//   battery:   fixture\tconf\tmeas\tisfalse   (isfalse 0/1)
//   exemplars: seq\tconf\tmeas   (first line is a header, skipped)
//   organ:     D | R | W | N
//   memory:    conf\tmeas   (organ R's frozen standing memory; ignored by D/W/N)
//
// Frozen block predicate (ported line-faithfully from
// round2/f5_r3/f5_conf_d.zag f5_block; stem check vacuous: every fixture
// and every exemplar in these batteries is TMB):
//   blocked iff exists exemplar with |dconf|<=150 and |dmeas|<=2000.
// Organs (return 1=RELEASE, 2=WITHHOLD):
//   D: ported organ D — R1 withhold iff within |dconf|<=34,|dmeas|<=58 of an
//      exemplar; else release iff conf in 650..940 and meas in 2200..6700.
//   R: ported organ R — release iff a memory point within |dconf|<=5,
//      |dmeas|<=5 (one deliberate re-inspection).
//   W: weak organ (new) — same R1 as D, narrow true box 660..700 / 2700..3700.
//   N: null organ (new) — always WITHHOLD.
// stdout per trial: trial\tfixture\tBLOCKED|ALLOWED\tRELEASED|WITHHOLD|-
// summary: BT=<blocked trues> REL=<released> BF=<blocked falses> FREL=<false releases>
// Guards: any false not blocked -> CORRUPT, rc=11. Unknown organ -> rc=2.
// Pure Zag, integer math, zero RNG, fully deterministic.

@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
// tab-separated field k (0-based) from b[ls..le] into tmp; return len, -1 absent.
fn getf(b:[]u8, ls:i32, le:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = ls;
    let i:i32 = ls;
    while(i < le) {
        if((b[i] as i32) == 9) {
            if(f == k) {
                let n:i32 = i - fs;
                let j:i32 = 0;
                while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
                return n;
            }
            f = f + 1;
            fs = i + 1;
        }
        i = i + 1;
    }
    if(f == k) {
        let n:i32 = le - fs;
        let j:i32 = 0;
        while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
        return n;
    }
    return -1;
}
fn p_atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}
// Frozen F5 block predicate: 1 = blocked.
fn f5_block(conf:i64, meas:i64, ex_c:[]u8, ex_m:[]u8, nex:i32) i32 {
    let e:i32 = 0;
    while(e < nex) {
        let ec:i64 = t_get64(ex_c, e * 8);
        let em:i64 = t_get64(ex_m, e * 8);
        if(iabs(conf - ec) <= 150 && iabs(meas - em) <= 2000) { return 1; }
        e = e + 1;
    }
    return 0;
}
fn organ_d(conf:i64, meas:i64, ex_c:[]u8, ex_m:[]u8, nex:i32) i32 {
    let e:i32 = 0;
    while(e < nex) {
        let ec:i64 = t_get64(ex_c, e * 8);
        let em:i64 = t_get64(ex_m, e * 8);
        if(iabs(conf - ec) <= 34 && iabs(meas - em) <= 58) { return 2; }
        e = e + 1;
    }
    if(conf >= 650 && conf <= 940 && meas >= 2200 && meas <= 6700) { return 1; }
    return 2;
}
fn organ_r(conf:i64, meas:i64, mem_c:[]u8, mem_m:[]u8, nmem:i32) i32 {
    let i:i32 = 0;
    while(i < nmem) {
        if(iabs(conf - t_get64(mem_c, i * 8)) <= 5 && iabs(meas - t_get64(mem_m, i * 8)) <= 5) { return 1; }
        i = i + 1;
    }
    return 2;
}
fn organ_w(conf:i64, meas:i64, ex_c:[]u8, ex_m:[]u8, nex:i32) i32 {
    let e:i32 = 0;
    while(e < nex) {
        let ec:i64 = t_get64(ex_c, e * 8);
        let em:i64 = t_get64(ex_m, e * 8);
        if(iabs(conf - ec) <= 34 && iabs(meas - em) <= 58) { return 2; }
        e = e + 1;
    }
    if(conf >= 660 && conf <= 700 && meas >= 2700 && meas <= 3700) { return 1; }
    return 2;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0 || a4.len == 0) { return 1; }
    let org:i32 = a3[0] as i32;
    if(org != 68 && org != 82 && org != 87 && org != 78) { return 2; }
    // exemplars (skip header line)
    let ex_c:[]u8 = nio_alloc(16 * 8);
    let ex_m:[]u8 = nio_alloc(16 * 8);
    let eb:[]u8 = nio_alloc(4096);
    let en:i64 = z_read(a2, eb, 4096);
    if(en < 0) { return 1; }
    let enn:i32 = en as i32;
    let nex:i32 = 0;
    let first:i32 = 1;
    let tmp:[]u8 = nio_alloc(128);
    let i:i32 = 0;
    while(i < enn) {
        let ls:i32 = i;
        while(i < enn && (eb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < enn) { i = i + 1; }
        let ishead:i32 = first;
        if(first == 1) { first = 0; }
        if(ishead == 0 && le > ls && nex < 16) {
            let skip0:i32 = 0;
            if(le - ls > 0) { skip0 = 1; }
            if(skip0 == 1) {
                let f1:i32 = getf(eb, ls, le, 1, tmp);
                let c:i64 = p_atoi(tmp, f1);
                let f2:i32 = getf(eb, ls, le, 2, tmp);
                let m:i64 = p_atoi(tmp, f2);
                t_put64(ex_c, nex * 8, c);
                t_put64(ex_m, nex * 8, m);
                nex = nex + 1;
            }
        }
    }
    // memory (no header)
    let mem_c:[]u8 = nio_alloc(512 * 8);
    let mem_m:[]u8 = nio_alloc(512 * 8);
    let mb:[]u8 = nio_alloc(16384);
    let mn:i64 = z_read(a4, mb, 16384);
    if(mn < 0) { return 1; }
    let mnn:i32 = mn as i32;
    let nmem:i32 = 0;
    i = 0;
    while(i < mnn) {
        let ls:i32 = i;
        while(i < mnn && (mb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < mnn) { i = i + 1; }
        if(le > ls && nmem < 512) {
            let f0:i32 = getf(mb, ls, le, 0, tmp);
            let mc:i64 = p_atoi(tmp, f0);
            let f1:i32 = getf(mb, ls, le, 1, tmp);
            let mm:i64 = p_atoi(tmp, f1);
            t_put64(mem_c, nmem * 8, mc);
            t_put64(mem_m, nmem * 8, mm);
            nmem = nmem + 1;
        }
    }
    // battery
    let bb:[]u8 = nio_alloc(2097152);
    let bn:i64 = z_read(a1, bb, 2097152);
    if(bn < 0) { return 1; }
    let bnn:i32 = bn as i32;
    let ob:[]u8 = nio_alloc(2097152);
    let pos:i32 = 0;
    let fx:[]u8 = nio_alloc(64);
    let n_bt:i32 = 0;
    let rel_bt:i32 = 0;
    let n_bf:i32 = 0;
    let rel_bf:i32 = 0;
    let trial:i32 = 0;
    i = 0;
    while(i < bnn) {
        let ls:i32 = i;
        while(i < bnn && (bb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < bnn) { i = i + 1; }
        if(le > ls) {
            trial = trial + 1;
            let f0:i32 = getf(bb, ls, le, 0, tmp);
            let q:i32 = 0;
            while(q < f0) { fx[q] = tmp[q]; q = q + 1; }
            let f1:i32 = getf(bb, ls, le, 1, tmp);
            let conf:i64 = p_atoi(tmp, f1);
            let f2:i32 = getf(bb, ls, le, 2, tmp);
            let meas:i64 = p_atoi(tmp, f2);
            let f3:i32 = getf(bb, ls, le, 3, tmp);
            let isfalse:i64 = p_atoi(tmp, f3);
            let blocked:i32 = f5_block(conf, meas, ex_c, ex_m, nex);
            let dec:i32 = 0;
            if(blocked == 1) {
                if(org == 68) { dec = organ_d(conf, meas, ex_c, ex_m, nex); }
                if(org == 82) { dec = organ_r(conf, meas, mem_c, mem_m, nmem); }
                if(org == 87) { dec = organ_w(conf, meas, ex_c, ex_m, nex); }
                if(org == 78) { dec = 2; }
            }
            if(isfalse == 0 && blocked == 1) {
                n_bt = n_bt + 1;
                if(dec == 1) { rel_bt = rel_bt + 1; }
            }
            if(isfalse == 1) {
                if(blocked == 0) {
                    pos = ob_add(ob, pos, "CORRUPT not-blocked false trial=");
                    pos = ob_add(ob, pos, i64s(trial as i64));
                    pos = ob_add(ob, pos, "\n");
                    let nwr0:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
                    if(nwr0 < 0) { return 12; }
                    return 11;
                }
                n_bf = n_bf + 1;
                if(dec == 1) { rel_bf = rel_bf + 1; }
            }
            pos = ob_add(ob, pos, i64s(trial as i64));
            pos = ob_add(ob, pos, "\t");
            pos = ob_addn(ob, pos, fx, f0);
            pos = ob_add(ob, pos, "\t");
            if(blocked == 1) { pos = ob_add(ob, pos, "BLOCKED\t"); }
            if(blocked == 0) { pos = ob_add(ob, pos, "ALLOWED\t"); }
            if(dec == 1) { pos = ob_add(ob, pos, "RELEASED\n"); }
            if(dec == 2) { pos = ob_add(ob, pos, "WITHHELD\n"); }
            if(dec == 0) { pos = ob_add(ob, pos, "-\n"); }
        }
    }
    pos = ob_add(ob, pos, "BT=");
    pos = ob_add(ob, pos, i64s(n_bt as i64));
    pos = ob_add(ob, pos, " REL=");
    pos = ob_add(ob, pos, i64s(rel_bt as i64));
    pos = ob_add(ob, pos, " BF=");
    pos = ob_add(ob, pos, i64s(n_bf as i64));
    pos = ob_add(ob, pos, " FREL=");
    pos = ob_add(ob, pos, i64s(rel_bf as i64));
    pos = ob_add(ob, pos, "\n");
    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return 10; }
    return 0;
}

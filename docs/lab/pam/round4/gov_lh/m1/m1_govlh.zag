// m1_govlh.zag — Gov-LH Crew 4 instrument (frozen PREREG_M1_GOVLH.md)
// Pure Zag, zero RNG. Usage: m1_govlh <m1_govlh_cases.txt>
// Measures OPT=(0,0,705,3588) vs SAFE=(1,1,705,3588) vs BASE=(1,1,700,0)
// on the novel wrong families at scales S in {1,10,100} with deterministic
// per-replica jitter (prereg section 4). Reports prereg section 5 metrics.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- LE accessors over []u8 arenas (never `as []i32`) ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// passes under a bar (st,at,ct,mt)
fn passes(conf:i64, mrg:i64, strong:i64, agree:i64, st:i64, at:i64, ct:i64, mt:i64) i64 {
    if(conf < ct) { return 0; }
    if(mrg < mt) { return 0; }
    if(strong < st) { return 0; }
    if(agree < at) { return 0; }
    return 1;
}
// deterministic jitter (prereg section 4); k=0 -> 0
fn jit_c(r:i64, k:i64) i64 {
    if(k == 0) { return 0; }
    return ((k * 2654435761 + r * 40503) % 7) - 3;
}
fn jit_m(r:i64, k:i64) i64 {
    if(k == 0) { return 0; }
    return ((k * 40503 + r * 2654435761) % 7) - 3;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let afam:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astr:[]u8 = nio_alloc(maxrows << 3);
    let aagr:[]u8 = nio_alloc(maxrows << 3);
    let asrc:[]u8 = nio_alloc(maxrows << 3);
    let aexo:[]u8 = nio_alloc(maxrows << 3);
    let aexs:[]u8 = nio_alloc(maxrows << 3);
    let fnum:[]u8 = nio_alloc(64);
    let nrows:i32 = 0;
    let nC:i64 = 0;
    let nW:i64 = 0;
    let nP:i64 = 0;
    let nB:i64 = 0;
    let nN:i64 = 0;
    let nQ:i64 = 0;
    let fN1:i64 = 0;
    let fN2:i64 = 0;
    let fN3:i64 = 0;
    let fN5:i64 = 0;
    let fN5r:i64 = 0;
    let maxpid_p:i32 = -1;
    let maxpid_q:i32 = -1;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000 && nrows < maxrows) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let kc:u8 = line[0];
            let kind:i64 = -1;
            // C=67 W=87 P=80 B=66 N=78 Q=81
            if(kc == 67) { kind = 0; nC = nC + 1; }
            if(kc == 87) { kind = 1; nW = nW + 1; }
            if(kc == 66) { kind = 3; nB = nB + 1; }
            if(kc == 80) { kind = 2; nP = nP + 1; }
            if(kc == 78) { kind = 4; nN = nN + 1; }
            if(kc == 81) { kind = 5; nQ = nQ + 1; }
            if(kind >= 0) {
                let r:i32 = nrows;
                t_put64(akind, r << 3, kind);
                t_put64(afam, r << 3, 0);
                t_put64(apair, r << 3, -1);
                t_put64(asrc, r << 3, 0);
                // field layout per kind:
                // C: K|conf|mrg|s|a            W: K|conf|mrg|1|1
                // B: K|conf|mrg|s|a            P: K|pid|conf|mrg|1|1
                // N: K|fam|conf|mrg|s|a|src   Q: K|pid|conf|mrg|1|1
                let fi_c:i32 = 1;
                let fi_m:i32 = 2;
                let fi_s:i32 = 3;
                let fi_a:i32 = 4;
                if(kind == 2 || kind == 5) {
                    let nf0:i32 = field(line, llen, 1, fnum);
                    let pid:i64 = atoi(fnum, nf0);
                    t_put64(apair, r << 3, pid);
                    if(kind == 2 && pid as i32 > maxpid_p) { maxpid_p = pid as i32; }
                    if(kind == 5 && pid as i32 > maxpid_q) { maxpid_q = pid as i32; }
                    fi_c = 2; fi_m = 3; fi_s = 4; fi_a = 5;
                }
                if(kind == 4) {
                    let nf1:i32 = field(line, llen, 1, fnum);
                    let fam:i64 = atoi(fnum, nf1);
                    t_put64(afam, r << 3, fam);
                    if(fam == 1) { fN1 = fN1 + 1; }
                    if(fam == 2) { fN2 = fN2 + 1; }
                    if(fam == 3) { fN3 = fN3 + 1; }
                    if(fam == 5) { fN5 = fN5 + 1; }
                    fi_c = 2; fi_m = 3; fi_s = 4; fi_a = 5;
                    let nf6:i32 = field(line, llen, 6, fnum);
                    let src:i64 = atoi(fnum, nf6);
                    t_put64(asrc, r << 3, src);
                    if(fam == 5 && src == 0) { fN5r = fN5r + 1; }
                }
                let nf:i32 = field(line, llen, fi_c, fnum);
                let c:i64 = atoi(fnum, nf);
                t_put64(aconf, r << 3, c);
                nf = field(line, llen, fi_m, fnum);
                let m:i64 = atoi(fnum, nf);
                t_put64(amrg, r << 3, m);
                nf = field(line, llen, fi_s, fnum);
                let s:i64 = atoi(fnum, nf);
                t_put64(astr, r << 3, s);
                nf = field(line, llen, fi_a, fnum);
                let a:i64 = atoi(fnum, nf);
                t_put64(aagr, r << 3, a);
                t_put64(aexo, r << 3, passes(c, m, s, a, 0, 0, 705, 3588));
                t_put64(aexs, r << 3, passes(c, m, s, a, 1, 1, 705, 3588));
                nrows = nrows + 1;
            }
        }
        p = le + 1;
    }
    nio_free(fb);
    nio_free(fnum);
    let npairs_p:i32 = maxpid_p + 1;
    let npairs_q:i32 = maxpid_q + 1;
    // pair membership counts (static)
    let mem_p:[]u8 = nio_alloc(64 << 3);
    let mem_q:[]u8 = nio_alloc(64 << 3);
    let i0:i32 = 0;
    while(i0 < 64) {
        t_put64(mem_p, i0 << 3, 0);
        t_put64(mem_q, i0 << 3, 0);
        i0 = i0 + 1;
    }
    let r0:i32 = 0;
    while(r0 < nrows) {
        let k0:i64 = t_get64(akind, r0 << 3);
        if(k0 == 2) {
            let pid:i32 = t_get64(apair, r0 << 3) as i32;
            t_put64(mem_p, pid << 3, t_get64(mem_p, pid << 3) + 1);
        }
        if(k0 == 5) {
            let pid:i32 = t_get64(apair, r0 << 3) as i32;
            t_put64(mem_q, pid << 3, t_get64(mem_q, pid << 3) + 1);
        }
        r0 = r0 + 1;
    }
    // per-scale accumulators (3 scales)
    let sc0:i64 = 1;
    let sc1:i64 = 10;
    let sc2:i64 = 100;
    let tp_o0:i64 = 0; let tp_s0:i64 = 0;
    let tp_o1:i64 = 0; let tp_s1:i64 = 0;
    let tp_o2:i64 = 0; let tp_s2:i64 = 0;
    let w_o0:i64 = 0; let w_s0:i64 = 0;
    let w_o1:i64 = 0; let w_s1:i64 = 0;
    let w_o2:i64 = 0; let w_s2:i64 = 0;
    let pi_o0:i64 = 0; let pi_s0:i64 = 0;
    let pi_o1:i64 = 0; let pi_s1:i64 = 0;
    let pi_o2:i64 = 0; let pi_s2:i64 = 0;
    let b_o0:i64 = 0; let b_s0:i64 = 0; let b_b0:i64 = 0;
    let b_o1:i64 = 0; let b_s1:i64 = 0; let b_b1:i64 = 0;
    let b_o2:i64 = 0; let b_s2:i64 = 0; let b_b2:i64 = 0;
    let n1_o0:i64 = 0; let n1_s0:i64 = 0;
    let n1_o1:i64 = 0; let n1_s1:i64 = 0;
    let n1_o2:i64 = 0; let n1_s2:i64 = 0;
    let n2_o0:i64 = 0; let n2_s0:i64 = 0;
    let n2_o1:i64 = 0; let n2_s1:i64 = 0;
    let n2_o2:i64 = 0; let n2_s2:i64 = 0;
    let n3_o0:i64 = 0; let n3_s0:i64 = 0;
    let n3_o1:i64 = 0; let n3_s1:i64 = 0;
    let n3_o2:i64 = 0; let n3_s2:i64 = 0;
    let n5_o0:i64 = 0; let n5_s0:i64 = 0;
    let n5_o1:i64 = 0; let n5_s1:i64 = 0;
    let n5_o2:i64 = 0; let n5_s2:i64 = 0;
    let q_o0:i64 = 0; let q_s0:i64 = 0;
    let q_o1:i64 = 0; let q_s1:i64 = 0;
    let q_o2:i64 = 0; let q_s2:i64 = 0;
    let hj_c0:i64 = 0; let hj_w0:i64 = 0;
    let hj_c1:i64 = 0; let hj_w1:i64 = 0;
    let hj_c2:i64 = 0; let hj_w2:i64 = 0;
    let pc_op:[]u8 = nio_alloc(64 << 3);
    let pc_sp:[]u8 = nio_alloc(64 << 3);
    let pc_oq:[]u8 = nio_alloc(64 << 3);
    let pc_sq:[]u8 = nio_alloc(64 << 3);
    let si:i32 = 0;
    while(si < 3) {
        let S:i64 = sc0;
        if(si == 1) { S = sc1; }
        if(si == 2) { S = sc2; }
        let k:i64 = 0;
        while(k < S) {
            let z:i32 = 0;
            while(z < 64) {
                t_put64(pc_op, z << 3, 0);
                t_put64(pc_sp, z << 3, 0);
                t_put64(pc_oq, z << 3, 0);
                t_put64(pc_sq, z << 3, 0);
                z = z + 1;
            }
            let r:i32 = 0;
            while(r < nrows) {
                let kind:i64 = t_get64(akind, r << 3);
                let c:i64 = t_get64(aconf, r << 3) + jit_c(r as i64, k);
                let m:i64 = t_get64(amrg, r << 3) + jit_m(r as i64, k);
                let s:i64 = t_get64(astr, r << 3);
                let a:i64 = t_get64(aagr, r << 3);
                let po:i64 = passes(c, m, s, a, 0, 0, 705, 3588);
                let ps:i64 = passes(c, m, s, a, 1, 1, 705, 3588);
                if(kind == 0) {
                    if(si == 0) { tp_o0 = tp_o0 + po; tp_s0 = tp_s0 + ps; }
                    if(si == 1) { tp_o1 = tp_o1 + po; tp_s1 = tp_s1 + ps; }
                    if(si == 2) { tp_o2 = tp_o2 + po; tp_s2 = tp_s2 + ps; }
                    if(k > 0 && t_get64(aexo, r << 3) == 1 && po == 0) {
                        if(si == 0) { hj_c0 = hj_c0 + 1; }
                        if(si == 1) { hj_c1 = hj_c1 + 1; }
                        if(si == 2) { hj_c2 = hj_c2 + 1; }
                    }
                }
                if(kind == 1) {
                    if(si == 0) { w_o0 = w_o0 + po; w_s0 = w_s0 + ps; }
                    if(si == 1) { w_o1 = w_o1 + po; w_s1 = w_s1 + ps; }
                    if(si == 2) { w_o2 = w_o2 + po; w_s2 = w_s2 + ps; }
                }
                if(kind == 2) {
                    let pid:i32 = t_get64(apair, r << 3) as i32;
                    t_put64(pc_op, pid << 3, t_get64(pc_op, pid << 3) + po);
                    t_put64(pc_sp, pid << 3, t_get64(pc_sp, pid << 3) + ps);
                }
                if(kind == 3) {
                    let pb:i64 = passes(c, m, s, a, 1, 1, 700, 0);
                    if(si == 0) { b_o0 = b_o0 + po; b_s0 = b_s0 + ps; b_b0 = b_b0 + pb; }
                    if(si == 1) { b_o1 = b_o1 + po; b_s1 = b_s1 + ps; b_b1 = b_b1 + pb; }
                    if(si == 2) { b_o2 = b_o2 + po; b_s2 = b_s2 + ps; b_b2 = b_b2 + pb; }
                }
                if(kind == 4) {
                    let fam:i64 = t_get64(afam, r << 3);
                    if(fam == 1) {
                        if(si == 0) { n1_o0 = n1_o0 + po; n1_s0 = n1_s0 + ps; }
                        if(si == 1) { n1_o1 = n1_o1 + po; n1_s1 = n1_s1 + ps; }
                        if(si == 2) { n1_o2 = n1_o2 + po; n1_s2 = n1_s2 + ps; }
                    }
                    if(fam == 2) {
                        if(si == 0) { n2_o0 = n2_o0 + po; n2_s0 = n2_s0 + ps; }
                        if(si == 1) { n2_o1 = n2_o1 + po; n2_s1 = n2_s1 + ps; }
                        if(si == 2) { n2_o2 = n2_o2 + po; n2_s2 = n2_s2 + ps; }
                    }
                    if(fam == 3) {
                        if(si == 0) { n3_o0 = n3_o0 + po; n3_s0 = n3_s0 + ps; }
                        if(si == 1) { n3_o1 = n3_o1 + po; n3_s1 = n3_s1 + ps; }
                        if(si == 2) { n3_o2 = n3_o2 + po; n3_s2 = n3_s2 + ps; }
                    }
                    if(fam == 5) {
                        if(si == 0) { n5_o0 = n5_o0 + po; n5_s0 = n5_s0 + ps; }
                        if(si == 1) { n5_o1 = n5_o1 + po; n5_s1 = n5_s1 + ps; }
                        if(si == 2) { n5_o2 = n5_o2 + po; n5_s2 = n5_s2 + ps; }
                    }
                    if(k > 0 && t_get64(aexo, r << 3) == 0 && po == 1) {
                        if(si == 0) { hj_w0 = hj_w0 + 1; }
                        if(si == 1) { hj_w1 = hj_w1 + 1; }
                        if(si == 2) { hj_w2 = hj_w2 + 1; }
                    }
                }
                if(kind == 5) {
                    let pid:i32 = t_get64(apair, r << 3) as i32;
                    t_put64(pc_oq, pid << 3, t_get64(pc_oq, pid << 3) + po);
                    t_put64(pc_sq, pid << 3, t_get64(pc_sq, pid << 3) + ps);
                }
                r = r + 1;
            }
            let qp:i32 = 0;
            while(qp < npairs_p) {
                if(t_get64(pc_op, qp << 3) == t_get64(mem_p, qp << 3) && t_get64(mem_p, qp << 3) > 0) {
                    if(si == 0) { pi_o0 = pi_o0 + 1; }
                    if(si == 1) { pi_o1 = pi_o1 + 1; }
                    if(si == 2) { pi_o2 = pi_o2 + 1; }
                }
                if(t_get64(pc_sp, qp << 3) == t_get64(mem_p, qp << 3) && t_get64(mem_p, qp << 3) > 0) {
                    if(si == 0) { pi_s0 = pi_s0 + 1; }
                    if(si == 1) { pi_s1 = pi_s1 + 1; }
                    if(si == 2) { pi_s2 = pi_s2 + 1; }
                }
                qp = qp + 1;
            }
            let qq:i32 = 0;
            while(qq < npairs_q) {
                if(t_get64(pc_oq, qq << 3) == t_get64(mem_q, qq << 3) && t_get64(mem_q, qq << 3) > 0) {
                    if(si == 0) { q_o0 = q_o0 + 1; }
                    if(si == 1) { q_o1 = q_o1 + 1; }
                    if(si == 2) { q_o2 = q_o2 + 1; }
                }
                if(t_get64(pc_sq, qq << 3) == t_get64(mem_q, qq << 3) && t_get64(mem_q, qq << 3) > 0) {
                    if(si == 0) { q_s0 = q_s0 + 1; }
                    if(si == 1) { q_s1 = q_s1 + 1; }
                    if(si == 2) { q_s2 = q_s2 + 1; }
                }
                qq = qq + 1;
            }
            k = k + 1;
        }
        si = si + 1;
    }
    // H-absorb from measured S1 tp_opt
    let habs:i64 = 0;
    while(tp_o0 * 100 >= 82 * (1102 + habs + 1)) { habs = habs + 1; }
    // H-knife: exact-geometry OPT-passing C rows on the threshold
    let hkc:i64 = 0;
    let hkm:i64 = 0;
    let r2:i32 = 0;
    while(r2 < nrows) {
        if(t_get64(akind, r2 << 3) == 0 && t_get64(aexo, r2 << 3) == 1) {
            if(t_get64(aconf, r2 << 3) == 705) { hkc = hkc + 1; }
            if(t_get64(amrg, r2 << 3) == 3588) { hkm = hkm + 1; }
        }
        r2 = r2 + 1;
    }
    let part:i64 = 0;
    if(fN1 + fN2 + fN5r == b_o0) { part = 1; }
    // report
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "M1_GOVLH", "frozen=PREREG_M1_GOVLH.md");
    pos = ob_kv(ob, pos, "rows_total", i64s(nrows as i64));
    pos = ob_kv(ob, pos, "rows_C", i64s(nC));
    pos = ob_kv(ob, pos, "rows_W", i64s(nW));
    pos = ob_kv(ob, pos, "rows_P", i64s(nP));
    pos = ob_kv(ob, pos, "rows_B", i64s(nB));
    pos = ob_kv(ob, pos, "rows_N", i64s(nN));
    pos = ob_kv(ob, pos, "rows_Q", i64s(nQ));
    pos = ob_kv(ob, pos, "fam_N1", i64s(fN1));
    pos = ob_kv(ob, pos, "fam_N2", i64s(fN2));
    pos = ob_kv(ob, pos, "fam_N3", i64s(fN3));
    pos = ob_kv(ob, pos, "fam_N5", i64s(fN5));
    pos = ob_kv(ob, pos, "fam_N5real", i64s(fN5r));
    pos = ob_kv(ob, pos, "npairs_P", i64s(npairs_p as i64));
    pos = ob_kv(ob, pos, "npairs_Q", i64s(npairs_q as i64));
    pos = ob_kv(ob, pos, "partition_ok", i64s(part));
    // scale 1
    pos = ob_kv(ob, pos, "S1_tp_opt", i64s(tp_o0));
    pos = ob_kv(ob, pos, "S1_tp_safe", i64s(tp_s0));
    pos = ob_kv(ob, pos, "S1_H_trial", i64s(tp_o0 - (82 * 1102 * 1 + 99) / 100));
    pos = ob_kv(ob, pos, "S1_W_fp_opt", i64s(w_o0));
    pos = ob_kv(ob, pos, "S1_W_fp_safe", i64s(w_s0));
    pos = ob_kv(ob, pos, "S1_P_inst_opt", i64s(pi_o0));
    pos = ob_kv(ob, pos, "S1_P_inst_safe", i64s(pi_s0));
    pos = ob_kv(ob, pos, "S1_B_fp_opt", i64s(b_o0));
    pos = ob_kv(ob, pos, "S1_B_fp_safe", i64s(b_s0));
    pos = ob_kv(ob, pos, "S1_B_fp_base", i64s(b_b0));
    pos = ob_kv(ob, pos, "S1_N1_fp_opt", i64s(n1_o0));
    pos = ob_kv(ob, pos, "S1_N1_fp_safe", i64s(n1_s0));
    pos = ob_kv(ob, pos, "S1_N2_fp_opt", i64s(n2_o0));
    pos = ob_kv(ob, pos, "S1_N2_fp_safe", i64s(n2_s0));
    pos = ob_kv(ob, pos, "S1_N3_fp_opt", i64s(n3_o0));
    pos = ob_kv(ob, pos, "S1_N3_fp_safe", i64s(n3_s0));
    pos = ob_kv(ob, pos, "S1_N4_inst_opt", i64s(q_o0));
    pos = ob_kv(ob, pos, "S1_N4_inst_safe", i64s(q_s0));
    pos = ob_kv(ob, pos, "S1_N5_fp_opt", i64s(n5_o0));
    pos = ob_kv(ob, pos, "S1_N5_fp_safe", i64s(n5_s0));
    // scale 10
    pos = ob_kv(ob, pos, "S10_tp_opt", i64s(tp_o1));
    pos = ob_kv(ob, pos, "S10_tp_safe", i64s(tp_s1));
    pos = ob_kv(ob, pos, "S10_H_trial", i64s(tp_o1 - (82 * 1102 * 10 + 99) / 100));
    pos = ob_kv(ob, pos, "S10_W_fp_opt", i64s(w_o1));
    pos = ob_kv(ob, pos, "S10_W_fp_safe", i64s(w_s1));
    pos = ob_kv(ob, pos, "S10_P_inst_opt", i64s(pi_o1));
    pos = ob_kv(ob, pos, "S10_P_inst_safe", i64s(pi_s1));
    pos = ob_kv(ob, pos, "S10_B_fp_opt", i64s(b_o1));
    pos = ob_kv(ob, pos, "S10_B_fp_safe", i64s(b_s1));
    pos = ob_kv(ob, pos, "S10_B_fp_base", i64s(b_b1));
    pos = ob_kv(ob, pos, "S10_N1_fp_opt", i64s(n1_o1));
    pos = ob_kv(ob, pos, "S10_N1_fp_safe", i64s(n1_s1));
    pos = ob_kv(ob, pos, "S10_N2_fp_opt", i64s(n2_o1));
    pos = ob_kv(ob, pos, "S10_N2_fp_safe", i64s(n2_s1));
    pos = ob_kv(ob, pos, "S10_N3_fp_opt", i64s(n3_o1));
    pos = ob_kv(ob, pos, "S10_N3_fp_safe", i64s(n3_s1));
    pos = ob_kv(ob, pos, "S10_N4_inst_opt", i64s(q_o1));
    pos = ob_kv(ob, pos, "S10_N4_inst_safe", i64s(q_s1));
    pos = ob_kv(ob, pos, "S10_N5_fp_opt", i64s(n5_o1));
    pos = ob_kv(ob, pos, "S10_N5_fp_safe", i64s(n5_s1));
    pos = ob_kv(ob, pos, "S10_Hj_C_fragile", i64s(hj_c1));
    pos = ob_kv(ob, pos, "S10_Hj_W_flip", i64s(hj_w1));
    // scale 100
    pos = ob_kv(ob, pos, "S100_tp_opt", i64s(tp_o2));
    pos = ob_kv(ob, pos, "S100_tp_safe", i64s(tp_s2));
    pos = ob_kv(ob, pos, "S100_H_trial", i64s(tp_o2 - (82 * 1102 * 100 + 99) / 100));
    pos = ob_kv(ob, pos, "S100_W_fp_opt", i64s(w_o2));
    pos = ob_kv(ob, pos, "S100_W_fp_safe", i64s(w_s2));
    pos = ob_kv(ob, pos, "S100_P_inst_opt", i64s(pi_o2));
    pos = ob_kv(ob, pos, "S100_P_inst_safe", i64s(pi_s2));
    pos = ob_kv(ob, pos, "S100_B_fp_opt", i64s(b_o2));
    pos = ob_kv(ob, pos, "S100_B_fp_safe", i64s(b_s2));
    pos = ob_kv(ob, pos, "S100_B_fp_base", i64s(b_b2));
    pos = ob_kv(ob, pos, "S100_N1_fp_opt", i64s(n1_o2));
    pos = ob_kv(ob, pos, "S100_N1_fp_safe", i64s(n1_s2));
    pos = ob_kv(ob, pos, "S100_N2_fp_opt", i64s(n2_o2));
    pos = ob_kv(ob, pos, "S100_N2_fp_safe", i64s(n2_s2));
    pos = ob_kv(ob, pos, "S100_N3_fp_opt", i64s(n3_o2));
    pos = ob_kv(ob, pos, "S100_N3_fp_safe", i64s(n3_s2));
    pos = ob_kv(ob, pos, "S100_N4_inst_opt", i64s(q_o2));
    pos = ob_kv(ob, pos, "S100_N4_inst_safe", i64s(q_s2));
    pos = ob_kv(ob, pos, "S100_N5_fp_opt", i64s(n5_o2));
    pos = ob_kv(ob, pos, "S100_N5_fp_safe", i64s(n5_s2));
    pos = ob_kv(ob, pos, "S100_Hj_C_fragile", i64s(hj_c2));
    pos = ob_kv(ob, pos, "S100_Hj_W_flip", i64s(hj_w2));
    // headroom (scale-free)
    pos = ob_kv(ob, pos, "H_absorb", i64s(habs));
    pos = ob_kv(ob, pos, "H_knife_conf705", i64s(hkc));
    pos = ob_kv(ob, pos, "H_knife_mrg3588", i64s(hkm));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    nio_free(akind);
    nio_free(afam);
    nio_free(apair);
    nio_free(aconf);
    nio_free(amrg);
    nio_free(astr);
    nio_free(aagr);
    nio_free(asrc);
    nio_free(aexo);
    nio_free(aexs);
    nio_free(mem_p);
    nio_free(mem_q);
    nio_free(pc_op);
    nio_free(pc_sp);
    nio_free(pc_oq);
    nio_free(pc_sq);
    return 0;
}

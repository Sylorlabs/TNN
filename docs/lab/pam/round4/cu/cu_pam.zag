// cu_pam.zag — CU conscious/unconscious PAM tradeoff instrument
// (frozen PREREG_CU.md + Correction C1 + PREREG_CU_ADDENDUM_FABLE.md)
// Pure Zag, zero RNG. Usage: cu_pam <c|u> <tape>
//   c = conscious: every decision emits a deliberation-visible REC record
//   u = unconscious: binary outcome only, no per-decision record
// Shared admission core (R-BAR/R-PROV/R-DECL/R-AUTH), short-circuit, fixed order.
// Frozen M1 bar (hands-off): R-BAR = conf>=705 AND mrgF>=3588 (ST=0,AT=0).
// Deterministic cycle cost model (preregistered):
//   row parse 2/row; primitive check 1; decision assembly 1;
//   conscious record emission 1/emitted byte; unconscious outcome byte 1.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- LE accessors over []u8 arenas (never `as []i32`) ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn cy_add(cy:[]u8, n:i64) void {
    t_put64(cy, 0, t_get64(cy, 0) + n);
}
// primitive check a>=b : exactly 1 cycle
fn ck_ge(a:i64, b:i64, cy:[]u8) i64 {
    cy_add(cy, 1);
    if(a >= b) { return 1; }
    return 0;
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
// record emission: copies bytes AND charges 1 cycle per emitted byte
fn rec_add(ob:[]u8, pos:i32, s:[]u8, cy:[]u8) i32 {
    let np:i32 = ob_add(ob, pos, s);
    cy_add(cy, s.len as i64);
    return np;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// append the fired-rules csv for mask bits 0..3 (R-BAR,R-PROV,R-DECL,R-AUTH)
fn fired_csv(ob:[]u8, pos:i32, mask:i64, cy:[]u8, recmode:i64) i32 {
    let first:i64 = 1;
    if((mask & 1) == 1) {
        if(recmode == 1) { pos = rec_add(ob, pos, "R-BAR", cy); }
        else { pos = ob_add(ob, pos, "R-BAR"); }
        first = 0;
    }
    if((mask & 2) == 2) {
        if(first == 0) {
            if(recmode == 1) { pos = rec_add(ob, pos, ",", cy); }
            else { pos = ob_add(ob, pos, ","); }
        }
        if(recmode == 1) { pos = rec_add(ob, pos, "R-PROV", cy); }
        else { pos = ob_add(ob, pos, "R-PROV"); }
        first = 0;
    }
    if((mask & 4) == 4) {
        if(first == 0) {
            if(recmode == 1) { pos = rec_add(ob, pos, ",", cy); }
            else { pos = ob_add(ob, pos, ","); }
        }
        if(recmode == 1) { pos = rec_add(ob, pos, "R-DECL", cy); }
        else { pos = ob_add(ob, pos, "R-DECL"); }
        first = 0;
    }
    if((mask & 8) == 8) {
        if(first == 0) {
            if(recmode == 1) { pos = rec_add(ob, pos, ",", cy); }
            else { pos = ob_add(ob, pos, ","); }
        }
        if(recmode == 1) { pos = rec_add(ob, pos, "R-AUTH", cy); }
        else { pos = ob_add(ob, pos, "R-AUTH"); }
    }
    return pos;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(a1.len == 0 || a2.len == 0) { return 1; }
    let conscious:i64 = 0;
    if(a1[0] == 99) { conscious = 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a2, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    // cycle counter + deliberation-visible record store (conscious)
    let cy:[]u8 = nio_alloc(8);
    t_put64(cy, 0, 0);
    let store:[]u8 = nio_alloc(1048576);
    let spos:i32 = 0;
    // output buffer
    let ob:[]u8 = nio_alloc(1048576);
    let pos:i32 = 0;
    let fnum:[]u8 = nio_alloc(64);
    let fid:[]u8 = nio_alloc(64);
    // counters
    let nrows:i64 = 0;
    let adC:i64 = 0;
    let adW:i64 = 0;
    let adP:i64 = 0;
    let adLAU:i64 = 0;
    let adFORK:i64 = 0;
    let adAUTH:i64 = 0;
    let recbytes:i64 = 0;
    let entries:i64 = 0;
    let outbytes:i64 = 0;
    let half0:i64 = 0;
    let half1:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let kc:u8 = line[0];
            let valid:i64 = 0;
            if(kc == 67 || kc == 87 || kc == 80 || kc == 65) { valid = 1; }
            if(valid == 1) {
                cy_add(cy, 2); // row parse
                let lt:i64 = nrows;
                let idn:i32 = field(line, llen, 1, fid);
                let nf:i32 = field(line, llen, 2, fnum);
                let conf:i64 = atoi(fnum, nf);
                nf = field(line, llen, 3, fnum);
                let mrg:i64 = atoi(fnum, nf);
                nf = field(line, llen, 6, fnum);
                let prov:i64 = atoi(fnum, nf);
                nf = field(line, llen, 7, fnum);
                let provok:i64 = atoi(fnum, nf);
                nf = field(line, llen, 8, fnum);
                let declok:i64 = atoi(fnum, nf);
                nf = field(line, llen, 9, fnum);
                let auth:i64 = atoi(fnum, nf);
                nf = field(line, llen, 10, fnum);
                let atk:i64 = atoi(fnum, nf);
                // ---- shared admission core: short-circuit, fixed order ----
                let mask:i64 = 0;
                let blocked:[]u8 = "";
                if(ck_ge(conf, 705, cy) == 0) { blocked = "R-BAR"; }
                else {
                    if(ck_ge(mrg, 3588, cy) == 0) { blocked = "R-BAR"; }
                    else {
                        mask = 1;
                        if(ck_ge(provok, 1, cy) == 0) { blocked = "R-PROV"; }
                        else {
                            if(ck_ge(1, prov, cy) == 0) { blocked = "R-PROV"; }
                            else {
                                mask = 3;
                                if(ck_ge(declok, 1, cy) == 0) { blocked = "R-DECL"; }
                                else {
                                    mask = 7;
                                    if(ck_ge(1, auth, cy) == 0) { blocked = "R-AUTH"; }
                                    else { mask = 15; }
                                }
                            }
                        }
                    }
                }
                let outcome:i64 = 0;
                if(blocked.len == 0) { outcome = 1; }
                cy_add(cy, 1); // decision assembly
                // ---- variant-specific record behavior ----
                if(conscious == 1) {
                    // build REC line into temp buffer (no cycle), then emit
                    // to deliberation store + stdout, charging once
                    let lb:[]u8 = nio_alloc(512);
                    let lp:i32 = 0;
                    lp = ob_add(lb, lp, "REC|");
                    lp = ob_add(lb, lp, i64s(lt));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, fid[0..idn]);
                    lp = ob_add(lb, lp, "|");
                    let kcs:[]u8 = nio_alloc(2);
                    kcs[0] = kc;
                    lp = ob_add(lb, lp, kcs[0..1]);
                    nio_free(kcs);
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(outcome));
                    lp = ob_add(lb, lp, "|");
                    lp = fired_csv(lb, lp, mask, cy, 0);
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, blocked);
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(conf));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(mrg));
                    nf = field(line, llen, 4, fnum);
                    let strong:i64 = atoi(fnum, nf);
                    nf = field(line, llen, 5, fnum);
                    let agree:i64 = atoi(fnum, nf);
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(strong));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(agree));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(prov));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(provok));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(declok));
                    lp = ob_add(lb, lp, "|");
                    lp = ob_add(lb, lp, i64s(auth));
                    lp = ob_add(lb, lp, "\n");
                    let rl:i32 = lp;
                    spos = rec_add(store, spos, lb[0..rl], cy);
                    pos = ob_add(ob, pos, lb[0..rl]);
                    nio_free(lb);
                    recbytes = recbytes + rl as i64;
                    entries = entries + 1;
                    if(lt < 616) { half0 = half0 + rl as i64; }
                    else { half1 = half1 + rl as i64; }
                } else {
                    cy_add(cy, 1); // unconscious outcome byte
                    outbytes = outbytes + 1;
                }
                // OUT line: evidence plumbing, both modes, no cycle cost
                pos = ob_add(ob, pos, "OUT|");
                pos = ob_add(ob, pos, i64s(lt));
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, fid[0..idn]);
                pos = ob_add(ob, pos, "|");
                let kcs2:[]u8 = nio_alloc(2);
                kcs2[0] = kc;
                pos = ob_add(ob, pos, kcs2[0..1]);
                nio_free(kcs2);
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(outcome));
                pos = ob_add(ob, pos, "\n");
                if(outcome == 1) {
                    if(kc == 67) { adC = adC + 1; }
                    if(kc == 87) { adW = adW + 1; }
                    if(kc == 80) { adP = adP + 1; }
                    if(kc == 65) {
                        if(atk == 1) { adLAU = adLAU + 1; }
                        if(atk == 2) { adFORK = adFORK + 1; }
                        if(atk == 3) { adAUTH = adAUTH + 1; }
                    }
                }
                nrows = nrows + 1;
            }
        }
        p = le + 1;
    }
    pos = ob_kv(ob, pos, "CU_PAM", "frozen=PREREG_CU.md+C1+ADDENDUM_FABLE");
    if(conscious == 1) { pos = ob_kv(ob, pos, "mode", "conscious"); }
    else { pos = ob_kv(ob, pos, "mode", "unconscious"); }
    pos = ob_kv(ob, pos, "rows_total", i64s(nrows));
    pos = ob_kv(ob, pos, "admit_C", i64s(adC));
    pos = ob_kv(ob, pos, "admit_W", i64s(adW));
    pos = ob_kv(ob, pos, "admit_P", i64s(adP));
    pos = ob_kv(ob, pos, "admit_LAU", i64s(adLAU));
    pos = ob_kv(ob, pos, "admit_FORK", i64s(adFORK));
    pos = ob_kv(ob, pos, "admit_AUTH", i64s(adAUTH));
    pos = ob_kv(ob, pos, "cycles_total", i64s(t_get64(cy, 0)));
    pos = ob_kv(ob, pos, "rec_bytes_total", i64s(recbytes));
    pos = ob_kv(ob, pos, "entries_total", i64s(entries));
    pos = ob_kv(ob, pos, "outcome_bytes_total", i64s(outbytes));
    if(conscious == 1 && half0 > 0) {
        pos = ob_kv(ob, pos, "growth_x1000", i64s(half1 * 1000 / half0));
    }
    _zag_print(ob[0..pos]);
    return 0;
}

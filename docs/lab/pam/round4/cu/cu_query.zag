// cu_query.zag — TNN's own deliberation answering "why did you admit X?"
// (frozen PREREG_CU.md + PREREG_CU_ADDENDUM_FABLE.md, OP11)
// Pure Zag, zero RNG. Usage: cu_query <run-stdout-file> <cu_questions.txt>
// Reads ONLY the run's REC lines (the deliberation-visible record store),
// never the tape. Answers each ASK|<id>:
//   ANS|<lt>|<id>|<fired csv>|<blocked_by>|<conf>|<mrgF>|<strong>|<agree>|<prov>|<prov_ok>|<decl_ok>|<auth>
// or ANS|-1|<id>|NO_RECORD when no record exists (the unconscious case).
// Cycle model: 1 per record byte walked during indexing + 1 per id-byte
// comparison during lookup + 1 per answer byte emitted.
@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn cy_add(cy:[]u8, n:i64) void {
    t_put64(cy, 0, t_get64(cy, 0) + n);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ans_add(ob:[]u8, pos:i32, s:[]u8, cy:[]u8) i32 {
    let np:i32 = ob_add(ob, pos, s);
    cy_add(cy, s.len as i64);
    return np;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// copy n bytes from src[0..n] into arena b at at
fn blit(b:[]u8, at:i32, src:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { b[at + i] = src[i]; i = i + 1; }
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(a1.len == 0 || a2.len == 0) { return 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let cy:[]u8 = nio_alloc(8);
    t_put64(cy, 0, 0);
    // REC table arenas (max 2048 records)
    let maxrec:i32 = 2048;
    let r_id:[]u8 = nio_alloc(maxrec * 32);
    let r_idn:[]u8 = nio_alloc(maxrec << 3);
    let r_fired:[]u8 = nio_alloc(maxrec * 32);
    let r_firedn:[]u8 = nio_alloc(maxrec << 3);
    let r_blocked:[]u8 = nio_alloc(maxrec * 16);
    let r_blockedn:[]u8 = nio_alloc(maxrec << 3);
    let r_f:[]u8 = nio_alloc(maxrec * 11 * 8); // lt,conf,mrg,strong,agree,prov,provok,declok,auth,outcome,K
    let nrec:i32 = 0;
    let tmp:[]u8 = nio_alloc(128);
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 4 && llen < 4000 && nrec < maxrec) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            if(line[0] == 82 && line[1] == 69 && line[2] == 67 && line[3] == 124) {
                cy_add(cy, llen as i64); // indexing: 1 cycle per record byte walked
                let r:i32 = nrec;
                let nf:i32 = field(line, llen, 1, tmp);
                t_put64(r_f, (r * 11 + 0) << 3, atoi(tmp, nf)); // lt
                nf = field(line, llen, 2, tmp);
                if(nf > 32) { nf = 32; }
                blit(r_id, r * 32, tmp, nf);
                t_put64(r_idn, r << 3, nf as i64);
                nf = field(line, llen, 4, tmp);
                t_put64(r_f, (r * 11 + 9) << 3, atoi(tmp, nf)); // outcome
                nf = field(line, llen, 5, tmp);
                if(nf > 32) { nf = 32; }
                blit(r_fired, r * 32, tmp, nf);
                t_put64(r_firedn, r << 3, nf as i64);
                nf = field(line, llen, 6, tmp);
                if(nf > 16) { nf = 16; }
                blit(r_blocked, r * 16, tmp, nf);
                t_put64(r_blockedn, r << 3, nf as i64);
                nf = field(line, llen, 7, tmp);
                t_put64(r_f, (r * 11 + 1) << 3, atoi(tmp, nf)); // conf
                nf = field(line, llen, 8, tmp);
                t_put64(r_f, (r * 11 + 2) << 3, atoi(tmp, nf)); // mrgF
                nf = field(line, llen, 9, tmp);
                t_put64(r_f, (r * 11 + 3) << 3, atoi(tmp, nf)); // strong
                nf = field(line, llen, 10, tmp);
                t_put64(r_f, (r * 11 + 4) << 3, atoi(tmp, nf)); // agree
                nf = field(line, llen, 11, tmp);
                t_put64(r_f, (r * 11 + 5) << 3, atoi(tmp, nf)); // prov
                nf = field(line, llen, 12, tmp);
                t_put64(r_f, (r * 11 + 6) << 3, atoi(tmp, nf)); // prov_ok
                nf = field(line, llen, 13, tmp);
                t_put64(r_f, (r * 11 + 7) << 3, atoi(tmp, nf)); // decl_ok
                nf = field(line, llen, 14, tmp);
                t_put64(r_f, (r * 11 + 8) << 3, atoi(tmp, nf)); // auth
                nrec = nrec + 1;
            }
        }
        p = le + 1;
    }
    // questions
    let qb:[]u8 = nio_alloc(65536);
    let qn:i64 = z_read(a2, qb, 65536);
    if(qn < 0) { return 1; }
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    let nq:i64 = 0;
    let nans:i64 = 0;
    let nnorec:i64 = 0;
    let qp:i64 = 0;
    while(qp < qn) {
        let qle:i64 = qp;
        while(qle < qn && qb[qle as i32] != 10) { qle = qle + 1; }
        let qllen:i32 = (qle - qp) as i32;
        if(qllen > 4 && qllen < 4000) {
            let qline:[]u8 = qb[qp as i32 .. (qp + qllen as i64) as i32];
            if(qline[0] == 65 && qline[1] == 83 && qline[2] == 75 && qline[3] == 124) {
                let qidn:i32 = field(qline, qllen, 1, tmp);
                // linear scan; count every id-byte comparison as 1 cycle
                let found:i32 = -1;
                let r:i32 = 0;
                while(r < nrec) {
                    let rn:i32 = t_get64(r_idn, r << 3) as i32;
                    if(rn == qidn) {
                        let k:i32 = 0;
                        let match:i64 = 1;
                        while(k < qidn) {
                            cy_add(cy, 1);
                            if(r_id[r * 32 + k] != tmp[k]) { match = 0; break; }
                            k = k + 1;
                        }
                        if(match == 1) { found = r; break; }
                    } else {
                        cy_add(cy, 1); // length-mismatch probe
                    }
                    r = r + 1;
                }
                nq = nq + 1;
                if(found >= 0) {
                    nans = nans + 1;
                    let fr:i32 = found;
                    pos = ans_add(ob, pos, "ANS|", cy);
                    pos = ans_add(ob, pos, i64s(t_get64(r_f, (fr * 11 + 0) << 3)), cy);
                    pos = ans_add(ob, pos, "|", cy);
                    pos = ans_add(ob, pos, tmp[0..qidn], cy);
                    pos = ans_add(ob, pos, "|", cy);
                    let fn2:i32 = t_get64(r_firedn, fr << 3) as i32;
                    pos = ans_add(ob, pos, r_fired[fr * 32 .. fr * 32 + fn2], cy);
                    pos = ans_add(ob, pos, "|", cy);
                    let bn:i32 = t_get64(r_blockedn, fr << 3) as i32;
                    pos = ans_add(ob, pos, r_blocked[fr * 16 .. fr * 16 + bn], cy);
                    let fi2:i32 = 1;
                    while(fi2 <= 8) {
                        pos = ans_add(ob, pos, "|", cy);
                        pos = ans_add(ob, pos, i64s(t_get64(r_f, (fr * 11 + fi2) << 3)), cy);
                        fi2 = fi2 + 1;
                    }
                    pos = ans_add(ob, pos, "\n", cy);
                } else {
                    nnorec = nnorec + 1;
                    pos = ans_add(ob, pos, "ANS|-1|", cy);
                    pos = ans_add(ob, pos, tmp[0..qidn], cy);
                    pos = ans_add(ob, pos, "|NO_RECORD\n", cy);
                }
            }
        }
        qp = qle + 1;
    }
    pos = ob_kv(ob, pos, "CU_QUERY", "frozen=PREREG_CU.md+ADDENDUM_FABLE");
    pos = ob_kv(ob, pos, "questions_total", i64s(nq));
    pos = ob_kv(ob, pos, "answered", i64s(nans));
    pos = ob_kv(ob, pos, "no_record", i64s(nnorec));
    pos = ob_kv(ob, pos, "cycles_total", i64s(t_get64(cy, 0)));
    _zag_print(ob[0..pos]);
    return 0;
}

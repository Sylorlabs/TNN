// feat.zag — H5 training feature extractor (Crew: training).
//
// Runs the FROZEN harness deliberation (byte-identical dlb_*.zag copies)
// at fixed depths per item and emits index-level training features for the
// confidence head, plus the M4-skeleton release label and correctness.
//
// Usage: feat <items.jsonl> <family> <heldout01> <out.tsv> <d1> [d2 ...]
//
// Per (item, depth) TSV record:
//   id \t family \t heldout \t depth \t t \t rel4 \t correct4 \t f1..f8
// rel4 = 1 iff M4 would release (L_t == L_1). correct4 in {1,0,A}
// (A when rel4=0). f1..f8 = §4 features of PREREG_TRAINING.md (index-level
// only; family/heldout are measurement tags, never policy inputs).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn z_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

fn ft_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn ft_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn ft_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn ft_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

// Flat version: 8 out-params (Zag has no pointer arithmetic).
fn ft_features8(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=z_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=z_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=z_clamp(maxdrop,0,1000);
}

fn ft_run(items_path:[]u8,family:[]u8,heldout:i32,res_path:[]u8,depths:[]u8,nd:i32)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:1,.deep_rounds:1,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(ft_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(ft_st_alloc(&st,68)!=0){ft_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,8388608)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let di:i32=0;
                while(di<nd && ok==1){
                    let depth:i32=au_get32(depths,di);
                    cfg.shallow_rounds=depth;
                    cfg.deep_rounds=depth;
                    let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                    if(drc!=0){ok=0;}
                    if(drc==0){
                        let t:i32=depth;
                        if(st.rounds<t){t=st.rounds;}
                    }
                    di=di+1;
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
    }
    nio_free(ibuf);
    ft_item_free(&it);
    ft_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    lg_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<6){
        _zag_println("usage: feat <items.jsonl> <family> <heldout01> <out.tsv> <d1> [d2 ...]");
        return 64;
    }
    let nd:i32=_zag_argc()-5;
    if(nd>8){return 64;}
    let depths:[]u8=nio_alloc(8*4);
    if(depths.len==0){return 102;}
    let i:i32=0;
    while(i<nd){
        au_put32(depths,i,dlb_atoi(_zag_arg(5+i)));
        i=i+1;
    }
    let rc:i32=ft_run(_zag_arg(1),_zag_arg(2),dlb_atoi(_zag_arg(3)),_zag_arg(4),depths,nd);
    nio_free(depths);
    return rc;
}

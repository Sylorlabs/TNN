// train_wc.zag — SR ROUND arm WC: worst-case OPTIMIZER (Crew: H5 SR round).
//
// PREREG_SR.md §6 (FROZEN v1). T-05's verdict: the degenerate crush came
// from the greedy online optimizer, not the loss geometry; the f5
// polarity-separation signal exists in the hypothesis class. WC varies
// the OPTIMIZER, holding the loss family fixed — NOT a rerun of T-05.
//
// LOSS: v2 symmetric core + FINITE-λ worst-case over polarity-cloned
// pairs (T-05's construction: mirrorable families = {P, O}, family idx
// 4 and 7; grades (Y, 1−Y) so min(y_p,y_o)=0 on every released P/O cell).
//   released P/O training cell: L = 2·(C−0)²  (λ=2 frozen)
//   other released training cells: L = (C−Y)² (symmetric core alone)
// NO theater term, NO G-batch (pure per-cell form; T-05's v2 amendment
// established theater/G-batch confounded polarity attribution).
//
// OPTIMIZER (the intervention): TRUE BATCH updates. Weights snapshotted
// at epoch start; every cell's C computed with the snapshot weights;
// numerators accumulate over the epoch's phase cells; ONE tdiv per
// weight per epoch at epoch end. Per-epoch trust region:
//   |Δwᵢ| ≤ 1000, |Δb| ≤ 5000.
// (The crush path needs large single-direction swings — blocked by
// construction; no online per-cell step can drag the shared direction.)
// v2's anti-saturation clamp ±2,000,000 retained (frozen guard).
//
// Init: w1=1000, rest 0, b=0 (M4-with-harness-confidence start).
// Curriculum/phases/scale/DIV2 identical to v2: A={admit,revoke,logic,
// cost}, B={P,D}, C={trap,O,redteam}; 1 pass = 6 epochs (2 per phase);
// 10× = 60 epochs, 100× = 600; DIV2=40000, truncation-toward-zero tdiv.
//
// Usage: train_wc <features.tsv> <passes> <params_out.zag> <log_out.tsv>
//
// features.tsv cols: id \t family \t heldout \t depth \t t \t rel4
//   \t correct4 \t f1..f8

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn wc_div2()i64 { return 40000; }
fn wc_wlo()i64 { return -2000000; }
fn wc_whi()i64 { return 2000000; }
fn wc_trw()i64 { return 1000; }   // trust region: |Δwᵢ| ≤ 1000
fn wc_trb()i64 { return 5000; }   // trust region: |Δb| ≤ 5000

fn wc_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn wc_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// family name -> index 0..8 ; -1 unknown
fn wc_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}
fn wc_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}
// mirrorable (polarity-clonable) families: P (4), O (7) — T-05 §4
fn wc_mirror(fi:i32)i32 {
    if(fi==4){return 1;}
    if(fi==7){return 1;}
    return 0;
}

// confidence from snapshot weights ws (8 i64) and bias bs, features
// at feats[fbase..fbase+7]
fn wc_conf(ws:[]u8,bs:i64,feats:[]u8,fbase:i32)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(ws,k)*(au_get32(feats,fbase+k) as i64);
        k=k+1;
    }
    return wc_clamp(wc_tdiv(acc,1000)+bs,0,1000);
}

fn wc_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn wc_train(feat_path:[]u8,passes:i32,params_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // cell storage: meta (8 i32/cell), feats (8 i32/cell), id off/len (2 i32)
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0){return 102;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){return 102;}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            wc_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,7..14 f1..f8
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=wc_famidx(fam);
            let ph:i32=wc_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1; // 1 correct, 0 wrong, -1 abstain
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1);
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e])); // t
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            au_put32(idix,ci*2+0,idn);
            au_put32(idix,ci*2+1,id.len);
            let q:i32=0;
            while(q<id.len){idbuf[idn+q]=id[q];q=q+1;}
            idn=idn+id.len;
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // weights w[8] i64, bias b; snapshot ws/bs; numerators num[8]/numb
    let w:[]u8=nio_alloc(8*8);
    let ws:[]u8=nio_alloc(8*8);
    let num:[]u8=nio_alloc(8*8);
    if(w.len==0||ws.len==0||num.len==0){return 102;}
    au_put64(w,0,1000); // w1=1000: start as M4-with-harness-confidence
    let b:i64=0;
    let lgo2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo2,8388608)!=0){return 102;}
    dout_str(&lgo2,"# prereg f55d1dbbe1a609f69301ce8f537282a0372880b51fdec6b51d0f588b9fd96d30 FROZEN v1; arm WC batch+trust-region\n");
    dout_str(&lgo2,"epoch\tphase\tloss\ttrbind\tsatbind\tw1\tw2\tw3\tw4\tw5\tw6\tw7\tw8\tb\tmcC\tmcW\tmcA\n");
    let epoch:i32=0;
    let p:i32=0;
    while(p<passes){
        let ph:i32=0;
        while(ph<3){
            let ep2:i32=0;
            while(ep2<2){
                // BATCH: snapshot weights at epoch start
                let k0:i32=0;
                while(k0<8){
                    au_put64(ws,k0,au_get64(w,k0));
                    au_put64(num,k0,0);
                    k0=k0+1;
                }
                let bs:i64=b;
                let numb:i64=0;
                // accumulate numerators over the phase's training cells,
                // every C computed with the SNAPSHOT weights (no online steps)
                let loss:i64=0;
                let i:i32=0;
                while(i<ncells){
                    if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                        let fbase:i32=i*8;
                        let y:i32=au_get32(meta,i*8+3);
                        let fi0:i32=au_get32(meta,i*8+4);
                        let c:i64=wc_conf(ws,bs,feats,fbase);
                        if(wc_mirror(fi0)==1){
                            // worst-case term: L = 2·(C−0)² ; dL/dw = 4(C−0)f/1000
                            let err:i64=c;
                            loss=loss+2*err*err;
                            let k3:i32=0;
                            while(k3<8){
                                let fk:i64=au_get32(feats,fbase+k3) as i64;
                                au_put64(num,k3,au_get64(num,k3)+4*err*fk);
                                k3=k3+1;
                            }
                            numb=numb+4*err*1000;
                        } else {
                            // symmetric core: L = (C−Y)² ; dL/dw = 2(C−Y)f/1000
                            let yy:i64=0;
                            if(y==1){yy=1000;}
                            let err:i64=c-yy;
                            loss=loss+err*err;
                            let k3:i32=0;
                            while(k3<8){
                                let fk:i64=au_get32(feats,fbase+k3) as i64;
                                au_put64(num,k3,au_get64(num,k3)+2*err*fk);
                                k3=k3+1;
                            }
                            numb=numb+2*err*1000;
                        }
                    }
                    i=i+1;
                }
                // ONE tdiv per weight per epoch + trust region
                let trbind:i32=0;
                let k4:i32=0;
                while(k4<8){
                    let d:i64=wc_tdiv(au_get64(num,k4),wc_div2());
                    if(d>wc_trw()){d=wc_trw();trbind=trbind+1;}
                    if(d<-wc_trw()){d=-wc_trw();trbind=trbind+1;}
                    au_put64(w,k4,au_get64(w,k4)-d);
                    k4=k4+1;
                }
                let db:i64=wc_tdiv(numb,wc_div2());
                if(db>wc_trb()){db=wc_trb();trbind=trbind+1;}
                if(db<-wc_trb()){db=-wc_trb();trbind=trbind+1;}
                b=b-db;
                // anti-saturation clamp (frozen guard) + count bindings
                let satbind:i32=0;
                let k6:i32=0;
                while(k6<8){
                    let wv:i64=au_get64(w,k6);
                    if(wv<wc_wlo()){au_put64(w,k6,wc_wlo());satbind=satbind+1;}
                    if(wv>wc_whi()){au_put64(w,k6,wc_whi());satbind=satbind+1;}
                    k6=k6+1;
                }
                // non-degeneracy telemetry: mean conf over released training
                // cells with epoch-end (post-update) weights
                let sc:i64=0;let nc:i64=0;let sw:i64=0;let nw:i64=0;
                let i3:i32=0;
                while(i3<ncells){
                    if(au_get32(meta,i3*8+5)>=0 && au_get32(meta,i3*8+2)==1){
                        let c3:i64=wc_conf(w,b,feats,i3*8);
                        if(au_get32(meta,i3*8+3)==1){sc=sc+c3;nc=nc+1;}
                        if(au_get32(meta,i3*8+3)==0){sw=sw+c3;nw=nw+1;}
                    }
                    i3=i3+1;
                }
                let mcC:i64=0;let mcW:i64=0;let mcA:i64=0;
                if(nc>0){mcC=sc/nc;}
                if(nw>0){mcW=sw/nw;}
                if(nc+nw>0){mcA=(sc+sw)/(nc+nw);}
                // log
                dout_i64(&lgo2,epoch as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,ph as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,loss);dout_byte(&lgo2,9);
                dout_i64(&lgo2,trbind as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,satbind as i64);dout_byte(&lgo2,9);
                let k5:i32=0;
                while(k5<8){
                    dout_i64(&lgo2,au_get64(w,k5));dout_byte(&lgo2,9);
                    k5=k5+1;
                }
                dout_i64(&lgo2,b);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcC);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcW);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcA);
                dout_line(&lgo2);
                epoch=epoch+1;
                ep2=ep2+1;
            }
            ph=ph+1;
        }
        p=p+1;
    }
    // write params file
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    dout_str(&po,"// wc_params — FROZEN SR-round WC trained confidence-head weights\n");
    dout_str(&po,"// Generated by train_wc.zag (PREREG_SR.md §6 FROZEN v1). Do not hand-edit.\n");
    dout_str(&po,"// optimizer: batch + trust region |Δw|<=1000 |Δb|<=5000; loss: symmetric core + λ=2 worst-case on P/O\n");
    let k8:i32=0;
    while(k8<8){
        dout_str(&po,"fn mt_w");
        dout_i64(&po,k8 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(w,k8));
        dout_str(&po,"; }\n");
        k8=k8+1;
    }
    dout_str(&po,"fn mt_b()i64 { return ");
    dout_i64(&po,b);
    dout_str(&po,"; }\n");
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lgo2),lgo2.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);nio_free(tabs);
    nio_free(w);nio_free(ws);nio_free(num);
    dout_free(&lgo2);dout_free(&po);
    if(wrc<0 || wrc2<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: train_wc <features.tsv> <passes> <params_out.zag> <log_out.tsv>");
        return 64;
    }
    let passes:i32=dlb_atoi(_zag_arg(2));
    if(passes<1 || passes>1000){return 64;}
    return wc_train(_zag_arg(1),passes,_zag_arg(3),_zag_arg(4));
}

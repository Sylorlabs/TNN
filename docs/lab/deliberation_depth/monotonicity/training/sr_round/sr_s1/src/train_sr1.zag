// train_sr1.zag — H5 SR ROUND, arm SR-S1, STAGE 1 (mask ON).
//
// Extends training/v2/src/train2.zag (PREREG_TRAINING_V2.md §5) with the
// SR-S1 training-time integer gradient mask (PREREG_SR.md §5b; exact
// integers pinned in ../MASK_INTEGERS.md, verbatim from GROK_SR_DESIGN.md
// Q1 Scheme 1(a)). Everything except the per-cell update block, the log
// header, and the extra params.txt output is byte-identical in behavior
// to train2.zag: same TSV parsing, same phases A→B→C, same G-batch, same
// anti-saturation clamp, same telemetry, same DIV2=40000, same tdiv.
//
// Usage: train_sr1 <features.tsv> <passes> <params_out.zag> <log_out.tsv>
// Also writes <params_out>.txt (9 lines: w0..w7, b) for the Stage-2 handoff.
//
// features.tsv cols (from feat.zag):
//   id \t family \t heldout \t depth \t t \t rel4 \t correct4 \t f1..f8
//
// Head: C(s) = clamp( (Σ w_i·f_i)/1000 + b, 0, 1000 ), init w1=1000, rest 0, b=0.
// Per released training cell (rel4=1, heldout=0), code index k (0-based,
// k ↔ w_{k+1} ↔ f_{k+1}; pin flag f7 = feats slot 6):
//   k ∈ {4,6} (w5,w7): num = 10(C−Y)f_k            [B=5 boost, theater coeff 0]
//   k ∈ {1,7} (w2,w8): num = 2(C−Y)f_k + 8·rise·f_k [ordinary v2]
//   k = 0     (w1):    num = 0 iff f7==1000 (pin firewall),
//                      else 2(C−Y)f_1 + 8·rise·f_1   [ordinary v2]
//   k ∈ {2,3,5} (w3,w4,w6): num = 0
//   w_k ← w_k − tdiv(num, 40000)
//   b   ← b   − tdiv(2(C−Y)·1000 + 8·rise·1000, 40000)  [ordinary v2]
// G-batch per epoch (v2 §5, unchanged): per training family, adjacent depths
// with G(d+1)>G(d) (thousandths): b ← b − tdiv(Gdiff,4).
// Anti-saturation: after each epoch clamp w_i to [−2000000, 2000000].
// Non-degeneracy telemetry per epoch: meanConfCorrect / meanConfWrong /
// meanConfAll over released training cells (epoch-end weights).
//
// Phases: A={admit,revoke,logic,cost}, B={P,D}, C={trap,O,redteam}.
// 1 pass = 2 epochs per phase in A→B→C order. Stage 1 = 100 passes = 600 epochs.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn tr_div2()i64 { return 40000; } // v2: upward steps representable (v1: 4000000)
fn tr_wlo()i64 { return -2000000; }
fn tr_whi()i64 { return 2000000; }

// truncation-toward-zero division for possibly-negative a, b>0
// (deterministic regardless of codegen's native div semantics)
fn tr_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn tr_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// family name -> index 0..8 ; -1 unknown
fn tr_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}
fn tr_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}
// depth value -> slot 0..6 ; -1 unknown
fn tr_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// find tab positions: fills tabs[0..nft] with field end offsets
fn tr_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn tr_train(feat_path:[]u8,passes:i32,params_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // cell storage: meta (8 i32/cell), feats (8 i32/cell), id off/len (2 i32)
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0){return 102;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){return 102;}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            tr_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,7..14 f1..f8
            // field k spans line[tabs[k-1]+1 .. tabs[k]] (field 0 starts at 0).
            // V2 FIX (v1 bug): feats[k] is field (7+k), NOT (8+k).
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=tr_famidx(fam);
            let ph:i32=tr_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1; // 1 correct, 0 wrong, -1 abstain
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1); // prev_idx filled below
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e])); // t
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            // id index: nearest previous cell with equal id -> prev chain
            let pv:i32=-1;
            let j:i32=ci-1;
            while(j>=0 && pv<0){
                let jo:i32=au_get32(idix,j*2+0);
                let jl2:i32=au_get32(idix,j*2+1);
                if(jl2==id.len && nio_equal(idbuf[jo..jo+jl2],id)==1){
                    // nearest previous same-id cell with rel4=1
                    let jj:i32=j;
                    while(jj>=0){
                        let ko:i32=au_get32(idix,jj*2+0);
                        let kl:i32=au_get32(idix,jj*2+1);
                        if(kl!=id.len || nio_equal(idbuf[ko..ko+kl],id)!=1){jj=-1;}
                        if(jj>=0){
                            if(au_get32(meta,jj*8+2)==1){pv=jj;jj=-1;}
                            if(jj>=0){jj=jj-1;}
                        }
                    }
                    j=-1;
                }
                if(pv<0){j=j-1;}
            }
            au_put32(meta,ci*8+6,pv);
            au_put32(idix,ci*2+0,idn);
            au_put32(idix,ci*2+1,id.len);
            let q:i32=0;
            while(q<id.len){idbuf[idn+q]=id[q];q=q+1;}
            idn=idn+id.len;
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // weights: w[8] i64, bias b — frozen init (v2 §4): w1=1000, rest 0, b=0
    let w:[]u8=nio_alloc(8*8);
    if(w.len==0){return 102;}
    au_put64(w,0,1000); // w1=1000: start as M4-with-harness-confidence
    let b:i64=0;
    // G accumulators: 9 families x 7 depth slots x (sumC, n, ncorrect)
    let gacc:[]u8=nio_alloc(9*7*3*8);
    if(gacc.len==0){return 102;}
    let lgo2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo2,8388608)!=0){return 102;}
    // log header: prereg SHA first (PREREG_SR §10 operational)
    dout_str(&lgo2,"# prereg_sha f55d1dbbe1a609f69301ce8f537282a0372880b51fdec6b51d0f588b9fd96d30\n");
    dout_str(&lgo2,"# arm SR-S1 stage=1 mask=ON (PREREG_SR.md section 5b)\n");
    dout_str(&lgo2,"# mask integers: k{4,6}:num=10(C-Y)f_k; k{1,7}:num=2(C-Y)f_k+8*rise*f_k; k0:num=0 iff f7=1000 else 2(C-Y)f_1+8*rise*f_1; k{2,3,5}:num=0; b:ordinary v2; DIV2=40000; clamp +-2000000\n");
    dout_str(&lgo2,"epoch\tphase\tloss\tv2\tgviol\tclampbind\tw1\tw2\tw3\tw4\tw5\tw6\tw7\tw8\tb\tmcC\tmcW\tmcA\n");
    let epoch:i32=0;
    let p:i32=0;
    while(p<passes){
        let ph:i32=0;
        while(ph<3){
            let ep2:i32=0;
            while(ep2<2){
                // online pass over training cells of this phase
                let loss:i64=0;
                let v2c:i32=0;
                let i:i32=0;
                while(i<ncells){
                    if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                        let fbase:i32=i*8;
                        let y:i32=au_get32(meta,i*8+3);
                        let yy:i64=0;
                        if(y==1){yy=1000;}
                        // conf with current weights
                        let acc2:i64=0;
                        let k:i32=0;
                        while(k<8){
                            acc2=acc2+au_get64(w,k)*(au_get32(feats,fbase+k) as i64);
                            k=k+1;
                        }
                        let c:i64=tr_clamp(tr_tdiv(acc2,1000)+b,0,1000);
                        let err:i64=c-yy;
                        // V2 theater term (v2: correct field indexing, so it can fire)
                        let rise:i64=0;
                        let pv:i32=au_get32(meta,i*8+6);
                        if(pv>=0 && y==0 && au_get32(meta,pv*8+3)==0){
                            let pbase:i32=pv*8;
                            let pacc:i64=0;
                            let k2:i32=0;
                            while(k2<8){
                                pacc=pacc+au_get64(w,k2)*(au_get32(feats,pbase+k2) as i64);
                                k2=k2+1;
                            }
                            let cprev:i64=tr_clamp(tr_tdiv(pacc,1000)+b,0,1000);
                            if(c>cprev){rise=c-cprev;v2c=v2c+1;}
                        }
                        // SR-S1 mask (grok Q1 Scheme 1(a) verbatim integers)
                        loss=loss+err*err+4*rise*rise;
                        let k3:i32=0;
                        while(k3<8){
                            let fk:i64=au_get32(feats,fbase+k3) as i64;
                            let num:i64=0;
                            if(k3==4 || k3==6){
                                // w5,w7: B=5 boost, theater coefficient 0
                                num=10*err*fk;
                            }
                            if(k3==1 || k3==7){
                                // w2,w8: ordinary v2, theater kept
                                num=2*err*fk+8*rise*fk;
                            }
                            if(k3==0){
                                // w1: pin firewall — num=0 on pin cells
                                num=2*err*fk+8*rise*fk;
                                if(au_get32(feats,fbase+6)==1000){num=0;}
                            }
                            // k3 in {2,3,5} (w3,w4,w6): num stays 0
                            au_put64(w,k3,au_get64(w,k3)-tr_tdiv(num,tr_div2()));
                            k3=k3+1;
                        }
                        let nb:i64=2*err*1000+8*rise*1000;
                        b=b-tr_tdiv(nb,tr_div2());
                    }
                    i=i+1;
                }
                // G-batch: recompute G per training family/depth with frozen weights
                let gi:i32=0;
                while(gi<9*7*3){au_put64(gacc,gi,0);gi=gi+1;}
                let i2:i32=0;
                while(i2<ncells){
                    if(au_get32(meta,i2*8+5)>=0 && au_get32(meta,i2*8+2)==1){
                        let fi2:i32=au_get32(meta,i2*8+4);
                        let ds:i32=tr_dslot(au_get32(meta,i2*8+1));
                        if(fi2>=0 && ds>=0){
                            let fbase2:i32=i2*8;
                            let acc3:i64=0;
                            let k4:i32=0;
                            while(k4<8){
                                acc3=acc3+au_get64(w,k4)*(au_get32(feats,fbase2+k4) as i64);
                                k4=k4+1;
                            }
                            let c2:i64=tr_clamp(tr_tdiv(acc3,1000)+b,0,1000);
                            let gx:i32=(fi2*7+ds)*3;
                            au_put64(gacc,gx,au_get64(gacc,gx)+c2);
                            au_put64(gacc,gx+1,au_get64(gacc,gx+1)+1);
                            if(au_get32(meta,i2*8+3)==1){
                                au_put64(gacc,gx+2,au_get64(gacc,gx+2)+1);
                            }
                        }
                    }
                    i2=i2+1;
                }
                let gviol:i32=0;
                let fi3:i32=0;
                while(fi3<9){
                    let prev_g:i64=0;
                    let have_prev:i32=0;
                    let s:i32=0;
                    while(s<7){
                        let gx2:i32=(fi3*7+s)*3;
                        let n2:i64=au_get64(gacc,gx2+1);
                        if(n2>0){
                            let gth:i64=au_get64(gacc,gx2)/n2-1000*au_get64(gacc,gx2+2)/n2;
                            if(have_prev==1 && gth>prev_g){
                                gviol=gviol+1;
                                b=b-tr_tdiv(gth-prev_g,4);
                            }
                            prev_g=gth;
                            have_prev=1;
                        }
                        s=s+1;
                    }
                    fi3=fi3+1;
                }
                // anti-saturation clamp (frozen guard) + count bindings
                let bind:i32=0;
                let k6:i32=0;
                while(k6<8){
                    let wv:i64=au_get64(w,k6);
                    if(wv<tr_wlo()){au_put64(w,k6,tr_wlo());bind=bind+1;}
                    if(wv>tr_whi()){au_put64(w,k6,tr_whi());bind=bind+1;}
                    k6=k6+1;
                }
                // non-degeneracy telemetry: mean conf over released training
                // cells with epoch-end weights
                let sc:i64=0;let nc:i64=0;let sw:i64=0;let nw:i64=0;
                let i3:i32=0;
                while(i3<ncells){
                    if(au_get32(meta,i3*8+5)>=0 && au_get32(meta,i3*8+2)==1){
                        let fbase3:i32=i3*8;
                        let acc4:i64=0;
                        let k7:i32=0;
                        while(k7<8){
                            acc4=acc4+au_get64(w,k7)*(au_get32(feats,fbase3+k7) as i64);
                            k7=k7+1;
                        }
                        let c3:i64=tr_clamp(tr_tdiv(acc4,1000)+b,0,1000);
                        if(au_get32(meta,i3*8+3)==1){sc=sc+c3;nc=nc+1;}
                        if(au_get32(meta,i3*8+3)==0){sw=sw+c3;nw=nw+1;}
                    }
                    i3=i3+1;
                }
                let mcC:i64=0;let mcW:i64=0;let mcA:i64=0;
                if(nc>0){mcC=sc/nc;}
                if(nw>0){mcW=sw/nw;}
                if(nc+nw>0){mcA=(sc+sw)/(nc+nw);}
                // log
                dout_i64(&lgo2,epoch as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,ph as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,loss);dout_byte(&lgo2,9);
                dout_i64(&lgo2,v2c as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,gviol as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,bind as i64);dout_byte(&lgo2,9);
                let k5:i32=0;
                while(k5<8){
                    dout_i64(&lgo2,au_get64(w,k5));dout_byte(&lgo2,9);
                    k5=k5+1;
                }
                dout_i64(&lgo2,b);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcC);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcW);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcA);
                dout_line(&lgo2);
                epoch=epoch+1;
                ep2=ep2+1;
            }
            ph=ph+1;
        }
        p=p+1;
    }
    // write params file
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    dout_str(&po,"// sr1 stage-1 params — SR-S1 Stage 1 (mask ON) trained weights\n");
    dout_str(&po,"// Generated by train_sr1.zag (PREREG_SR.md section 5b). Do not hand-edit.\n");
    let k8:i32=0;
    while(k8<8){
        dout_str(&po,"fn mt_w");
        dout_i64(&po,k8 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(w,k8));
        dout_str(&po,"; }\n");
        k8=k8+1;
    }
    dout_str(&po,"fn mt_b()i64 { return ");
    dout_i64(&po,b);
    dout_str(&po,"; }\n");
    // plain handoff for Stage 2: 9 lines w0..w7, b
    let pt:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&pt,512)!=0){return 102;}
    let k9:i32=0;
    while(k9<8){
        dout_i64(&pt,au_get64(w,k9));
        dout_line(&pt);
        k9=k9+1;
    }
    dout_i64(&pt,b);
    dout_line(&pt);
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lgo2),lgo2.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);nio_free(tabs);
    nio_free(w);nio_free(gacc);
    dout_free(&lgo2);dout_free(&po);
    if(wrc<0 || wrc2<0){return 103;}
    // params.txt path = params_path + ".txt"
    let ptx:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&ptx,8192)!=0){return 102;}
    let pi:i32=0;
    // FIX (2026-09-24 resume): _zag_arg slices are NOT NUL-terminated
    // (AGENTS.md); the old `params_path[pi]!=0` scan ran past the slice end
    // and panicked after a successful run. Bound by the slice length.
    let ppl:i32=params_path.len;
    if(ppl>8000){ppl=8000;}
    while(pi<ppl){dout_byte(&ptx,params_path[pi]);pi=pi+1;}
    dout_str(&ptx,".txt");
    let wrc3:i64=dlb_write_file(dout_bytes(&ptx),dout_bytes(&pt),pt.n);
    dout_free(&pt);dout_free(&ptx);
    if(wrc3<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: train_sr1 <features.tsv> <passes> <params_out.zag> <log_out.tsv>");
        return 64;
    }
    let passes:i32=dlb_atoi(_zag_arg(2));
    if(passes<1 || passes>1000){return 64;}
    return tr_train(_zag_arg(1),passes,_zag_arg(3),_zag_arg(4));
}

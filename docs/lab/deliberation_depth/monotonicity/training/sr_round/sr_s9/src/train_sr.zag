// train_sr.zag — H5 SR-round scaffold trainer, ARM SR-S9.
//
// Implements PREREG_SR.md §5 (H-SR, Stage 1, scaffold ON): identical to
// PREREG_TRAINING_V2.md §5 (A→B→C curriculum, DIV2=40000, symmetric loss +
// theater + G-batch, anti-saturation clamp), except the head is 9-input:
//   C(s) = clamp( (Σ_{i=1..8} w_i·f_i + w_9·s_9)/1000 + b, 0, 1000 )
// init: w1=1000, w2..w9=0, b=0.
//
// Scaffold (s9): per-depth-slot empirical correctness rate, causally computed
// from the training stream. Depth slots = {1,2,4,8,16,32,64} (7 slots).
//   s9 = 1000 × (correct released training cells at same depth slot, seen
//        STRICTLY BEFORE the current cell in the fixed training order)
//        / (released training cells at same depth slot, seen strictly before)
// If no prior released cell exists in the slot, s9 = 500 (uninformative prior).
// Accumulators are cumulative across epochs/passes/phases (strictly-prior in
// the fixed training order); they advance only in the online pass (never in
// G-batch/telemetry re-scans, which read them read-only). Labels are the
// trainer-side delayed-revelation labels (features.tsv correct4), exactly as v2.
//
// Usage: train_sr <features.tsv> <passes> <params_out.zag> <release_out.zag> <log_out.tsv>
//
// features.tsv cols (from feat.zag):
//   id \t family \t heldout \t depth \t t \t rel4 \t correct4 \t f1..f8
//
// Per released training cell (rel4=1, heldout=0):
//   L = (C−Y)^2 + 4·[V2rise]·(C−Cprev)^2
//   w_i ← w_i − tdiv(2(C−Y)f_i + 8·rise·f_i, DIV2)      (DIV2=40000, i=1..9)
//   b   ← b   − tdiv(2(C−Y)·1000 + 8·rise·1000, DIV2)
// G-batch per epoch: per training family, adjacent depths with G(d+1)>G(d)
//   (thousandths, 9-input C): b ← b − tdiv(G_F(d+1) − G_F(d), 4).
// Anti-saturation: after each epoch clamp w_i to [−2000000, 2000000] (i=1..9).
// Non-degeneracy telemetry per epoch: meanConfCorrect / meanConfWrong /
// meanConfAll over released training cells (epoch-end weights, 9-input C).
//
// Phases: A={admit,revoke,logic,cost}, B={P,D}, C={trap,O,redteam}.
// 1 pass = 2 epochs per phase in A→B→C order. 10× = 60 epochs; 100× = 600.
//
// The release file (w1..w8, b only — w9 discarded) is written from the final
// Stage-1 snapshot. ZERO gradient steps touch it after writing (SIGNAL_DISCONNECT
// is a snapshot, not a continuation).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn sr_div2()i64 { return 40000; } // v2: upward steps representable
fn sr_wlo()i64 { return -2000000; }
fn sr_whi()i64 { return 2000000; }

// truncation-toward-zero division for possibly-negative a, b>0
fn sr_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn sr_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// family name -> index 0..8 ; -1 unknown
fn sr_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}
fn sr_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}
// depth value -> slot 0..6 ; -1 unknown
fn sr_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// scaffold value: read-only from cumulative accumulators
// s9acc: 7 slots x (correct_count, total_count) as i64
fn sr_s9val(s9acc:[]u8,ds:i32)i64 {
    if(ds<0 || ds>=7){return 500;}
    let tot:i64=au_get64(s9acc,ds*2+1);
    if(tot<=0){return 500;}
    let cor:i64=au_get64(s9acc,ds*2+0);
    return (1000*cor)/tot;
}

// find tab positions: fills tabs[0..nft] with field end offsets
fn sr_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

// 9-input confidence from weight arena w (9 i64 slots), bias b,
// features fbase (8 i32 slots in feats arena) + s9 scalar
fn sr_conf9(w:[]u8,b:i64,feats:[]u8,fbase:i32,s9:i64)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(w,k)*(au_get32(feats,fbase+k) as i64);
        k=k+1;
    }
    acc=acc+au_get64(w,8)*s9;
    return sr_clamp(sr_tdiv(acc,1000)+b,0,1000);
}

fn sr_train(feat_path:[]u8,passes:i32,params_path:[]u8,release_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // cell storage: meta (8 i32/cell), feats (8 i32/cell), id off/len (2 i32)
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0){return 102;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){return 102;}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            sr_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,7..14 f1..f8
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=sr_famidx(fam);
            let ph:i32=sr_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1; // 1 correct, 0 wrong, -1 abstain
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1); // prev_idx filled below
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e])); // t
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            // id index: nearest previous cell with equal id -> prev chain
            let pv:i32=-1;
            let j:i32=ci-1;
            while(j>=0 && pv<0){
                let jo:i32=au_get32(idix,j*2+0);
                let jl2:i32=au_get32(idix,j*2+1);
                if(jl2==id.len && nio_equal(idbuf[jo..jo+jl2],id)==1){
                    let jj:i32=j;
                    while(jj>=0){
                        let ko:i32=au_get32(idix,jj*2+0);
                        let kl:i32=au_get32(idix,jj*2+1);
                        if(kl!=id.len || nio_equal(idbuf[ko..ko+kl],id)!=1){jj=-1;}
                        if(jj>=0){
                            if(au_get32(meta,jj*8+2)==1){pv=jj;jj=-1;}
                            if(jj>=0){jj=jj-1;}
                        }
                    }
                    j=-1;
                }
                if(pv<0){j=j-1;}
            }
            au_put32(meta,ci*8+6,pv);
            au_put32(idix,ci*2+0,idn);
            au_put32(idix,ci*2+1,id.len);
            let q:i32=0;
            while(q<id.len){idbuf[idn+q]=id[q];q=q+1;}
            idn=idn+id.len;
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // weights: w[9] i64, bias b. init w1=1000 (M4-with-harness-confidence start), w9=0.
    let w:[]u8=nio_alloc(9*8);
    if(w.len==0){return 102;}
    au_put64(w,0,1000);
    let b:i64=0;
    // s9 scaffold accumulators: 7 depth slots x (correct_count, total_count)
    let s9acc:[]u8=nio_alloc(7*2*8);
    if(s9acc.len==0){return 102;}
    // G accumulators: 9 families x 7 depth slots x (sumC, n, ncorrect)
    let gacc:[]u8=nio_alloc(9*7*3*8);
    if(gacc.len==0){return 102;}
    let lgo2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo2,8388608)!=0){return 102;}
    dout_str(&lgo2,"# PREREG_SHA f55d1dbbe1a609f69301ce8f537282a0372880b51fdec6b51d0f588b9fd96d30");
    dout_line(&lgo2);
    dout_str(&lgo2,"epoch\tphase\tloss\tv2\tgviol\tclampbind\tw1\tw2\tw3\tw4\tw5\tw6\tw7\tw8\tw9\tb\tmcC\tmcW\tmcA\n");
    let epoch:i32=0;
    let p:i32=0;
    while(p<passes){
        let ph:i32=0;
        while(ph<3){
            let ep2:i32=0;
            while(ep2<2){
                // online pass over training cells of this phase (s9 scaffold ON)
                let loss:i64=0;
                let v2c:i32=0;
                let i:i32=0;
                while(i<ncells){
                    if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                        let fbase:i32=i*8;
                        let y:i32=au_get32(meta,i*8+3);
                        let yy:i64=0;
                        if(y==1){yy=1000;}
                        // s9: strictly-prior rate at this depth slot (THEN advance)
                        let ds:i32=sr_dslot(au_get32(meta,i*8+1));
                        let s9:i64=sr_s9val(s9acc,ds);
                        let c:i64=sr_conf9(w,b,feats,fbase,s9);
                        let err:i64=c-yy;
                        // V2 theater term (Cprev recomputed under current weights)
                        let rise:i64=0;
                        let pv:i32=au_get32(meta,i*8+6);
                        if(pv>=0 && y==0 && au_get32(meta,pv*8+3)==0){
                            let cprev:i64=sr_conf9(w,b,feats,pv*8,sr_s9val(s9acc,sr_dslot(au_get32(meta,pv*8+1))));
                            if(c>cprev){rise=c-cprev;v2c=v2c+1;}
                        }
                        // symmetric loss: L = (C−Y)^2 + 4·rise·(C−Cprev)^2
                        loss=loss+err*err+4*rise*rise;
                        // updates (DIV2=40000; i=1..9, f_9 = s9)
                        let k3:i32=0;
                        while(k3<9){
                            let fk:i64=s9;
                            if(k3<8){fk=au_get32(feats,fbase+k3) as i64;}
                            let num:i64=2*err*fk+8*rise*fk;
                            au_put64(w,k3,au_get64(w,k3)-sr_tdiv(num,sr_div2()));
                            k3=k3+1;
                        }
                        let nb:i64=2*err*1000+8*rise*1000;
                        b=b-sr_tdiv(nb,sr_div2());
                        // advance the scaffold accumulators (strictly-prior bookkeeping)
                        if(ds>=0){
                            au_put64(s9acc,ds*2+1,au_get64(s9acc,ds*2+1)+1);
                            if(y==1){au_put64(s9acc,ds*2,au_get64(s9acc,ds*2)+1);}
                        }
                    }
                    i=i+1;
                }
                // G-batch: recompute G per training family/depth with frozen
                // weights (9-input C; s9 read-only from current accumulators)
                let gi:i32=0;
                while(gi<9*7*3){au_put64(gacc,gi,0);gi=gi+1;}
                let i2:i32=0;
                while(i2<ncells){
                    if(au_get32(meta,i2*8+5)>=0 && au_get32(meta,i2*8+2)==1){
                        let fi2:i32=au_get32(meta,i2*8+4);
                        let ds2:i32=sr_dslot(au_get32(meta,i2*8+1));
                        if(fi2>=0 && ds2>=0){
                            let c2:i64=sr_conf9(w,b,feats,i2*8,sr_s9val(s9acc,ds2));
                            let gx:i32=(fi2*7+ds2)*3;
                            au_put64(gacc,gx,au_get64(gacc,gx)+c2);
                            au_put64(gacc,gx+1,au_get64(gacc,gx+1)+1);
                            if(au_get32(meta,i2*8+3)==1){
                                au_put64(gacc,gx+2,au_get64(gacc,gx+2)+1);
                            }
                        }
                    }
                    i2=i2+1;
                }
                let gviol:i32=0;
                let fi3:i32=0;
                while(fi3<9){
                    let prev_g:i64=0;
                    let have_prev:i32=0;
                    let s:i32=0;
                    while(s<7){
                        let gx2:i32=(fi3*7+s)*3;
                        let n2:i64=au_get64(gacc,gx2+1);
                        if(n2>0){
                            let gth:i64=au_get64(gacc,gx2)/n2-1000*au_get64(gacc,gx2+2)/n2;
                            if(have_prev==1 && gth>prev_g){
                                gviol=gviol+1;
                                b=b-sr_tdiv(gth-prev_g,4);
                            }
                            prev_g=gth;
                            have_prev=1;
                        }
                        s=s+1;
                    }
                    fi3=fi3+1;
                }
                // anti-saturation clamp (frozen guard) + count bindings
                let bind:i32=0;
                let k6:i32=0;
                while(k6<9){
                    let wv:i64=au_get64(w,k6);
                    if(wv<sr_wlo()){au_put64(w,k6,sr_wlo());bind=bind+1;}
                    if(wv>sr_whi()){au_put64(w,k6,sr_whi());bind=bind+1;}
                    k6=k6+1;
                }
                // non-degeneracy telemetry: mean conf over released training
                // cells with epoch-end weights (9-input C)
                let sc:i64=0;let nc:i64=0;let sw:i64=0;let nw:i64=0;
                let i3:i32=0;
                while(i3<ncells){
                    if(au_get32(meta,i3*8+5)>=0 && au_get32(meta,i3*8+2)==1){
                        let ds3:i32=sr_dslot(au_get32(meta,i3*8+1));
                        let c3:i64=sr_conf9(w,b,feats,i3*8,sr_s9val(s9acc,ds3));
                        if(au_get32(meta,i3*8+3)==1){sc=sc+c3;nc=nc+1;}
                        if(au_get32(meta,i3*8+3)==0){sw=sw+c3;nw=nw+1;}
                    }
                    i3=i3+1;
                }
                let mcC:i64=0;let mcW:i64=0;let mcA:i64=0;
                if(nc>0){mcC=sc/nc;}
                if(nw>0){mcW=sw/nw;}
                if(nc+nw>0){mcA=(sc+sw)/(nc+nw);}
                // log
                dout_i64(&lgo2,epoch as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,ph as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,loss);dout_byte(&lgo2,9);
                dout_i64(&lgo2,v2c as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,gviol as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,bind as i64);dout_byte(&lgo2,9);
                let k5:i32=0;
                while(k5<9){
                    dout_i64(&lgo2,au_get64(w,k5));dout_byte(&lgo2,9);
                    k5=k5+1;
                }
                dout_i64(&lgo2,b);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcC);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcW);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcA);
                dout_line(&lgo2);
                epoch=epoch+1;
                ep2=ep2+1;
            }
            ph=ph+1;
        }
        p=p+1;
    }
    // write full params file (w1..w9, b — Stage-1 checkpoint)
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    dout_str(&po,"// sr_params — FROZEN SR-S9 Stage-1 trained confidence-head weights (9-input, scaffold ON)\n");
    dout_str(&po,"// Generated by train_sr.zag (PREREG_SR.md §5). Do not hand-edit.\n");
    let k8:i32=0;
    while(k8<9){
        dout_str(&po,"fn sr_w");
        dout_i64(&po,k8 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(w,k8));
        dout_str(&po,"; }\n");
        k8=k8+1;
    }
    dout_str(&po,"fn sr_b()i64 { return ");
    dout_i64(&po,b);
    dout_str(&po,"; }\n");
    // write RELEASE param file (w1..w8, b only — w9 DISCARDED; Stage-2 snapshot).
    // Zero gradient steps touch these values after this write.
    let ro:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&ro,4096)!=0){return 102;}
    dout_str(&ro,"// sr_release — FROZEN SR-S9 released weights (Stage 2, SIGNAL_DISCONNECT)\n");
    dout_str(&ro,"// w1..w8,b snapshot from Stage-1 end; w9 DISCARDED. Zero gradient steps after disconnect.\n");
    dout_str(&ro,"// Generated by train_sr.zag (PREREG_SR.md §5). Do not hand-edit.\n");
    let k9:i32=0;
    while(k9<8){
        dout_str(&ro,"fn sr_w");
        dout_i64(&ro,k9 as i64);
        dout_str(&ro,"()i64 { return ");
        dout_i64(&ro,au_get64(w,k9));
        dout_str(&ro,"; }\n");
        k9=k9+1;
    }
    dout_str(&ro,"fn sr_b()i64 { return ");
    dout_i64(&ro,b);
    dout_str(&ro,"; }\n");
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(release_path,dout_bytes(&ro),ro.n);
    let wrc3:i64=dlb_write_file(log_path,dout_bytes(&lgo2),lgo2.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);nio_free(tabs);
    nio_free(w);nio_free(s9acc);nio_free(gacc);
    dout_free(&lgo2);dout_free(&po);dout_free(&ro);
    if(wrc<0 || wrc2<0 || wrc3<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<6){
        _zag_println("usage: train_sr <features.tsv> <passes> <params_out.zag> <release_out.zag> <log_out.tsv>");
        return 64;
    }
    let passes:i32=dlb_atoi(_zag_arg(2));
    if(passes<1 || passes>1000){return 64;}
    return sr_train(_zag_arg(1),passes,_zag_arg(3),_zag_arg(4),_zag_arg(5));
}

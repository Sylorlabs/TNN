// train_arch.zag — H5 SR ROUND, Arm ARCH (confidence-as-distribution).
//
// Implements PREREG_SR.md §7 (FROZEN v1, SHA f55d1dbbe1a609f69301ce8f537282a0372880b51fdec6b51d0f588b9fd96d30).
//
// Head emits (m, s):
//   m = clamp((SUM u_i*f_i)/1000 + c, 0, 1000)   init u1=1000, rest 0, c=0
//   s = clamp((SUM v_i*f_i)/1000 + d, 0, 1000)   init v_i=0, d=0
// Released confidence R = clamp(m - s/2, 0, 1000) (s/2 truncates; s>=0).
//
// SEPARATE update rules (the intervention, frozen):
//   LOCATION (own gradient path): symmetric calibration loss vs Y,
//     L = (m-Y)^2 + 4*[theater]*rise^2, where the theater term is the v2
//     construction applied to the location head's own output m
//     (rise = m - m_prev on same-item earlier M4-released depth with
//     y_prev=0, y=0 and m>m_prev; m_prev recomputed with CURRENT u,c).
//     u_i <- u_i - tdiv(2*(m-Y)*f_i + 8*rise*f_i, DIV2)
//     c   <- c   - tdiv(2*(m-Y)*1000 + 8*rise*1000, DIV2)
//   SPREAD (stop-grad on m): L_s = (s - |m-Y|)^2, m treated as a constant;
//     the spread head cannot move m, the location head never sees s's loss.
//     v_i <- v_i - tdiv(2*(s-t)*f_i, DIV2),  t = |m-Y|
//     d   <- d   - tdiv(2*(s-t)*1000, DIV2)
//
// Same curriculum/DIV2/theater/G-batch as v2 (PREREG_TRAINING_V2.md §5):
//   DIV2=40000; G-batch computes G on RELEASED conf R (thousandths) per
//   training family/depth and adjusts c ONLY: c <- c - tdiv(Gdiff,4);
//   anti-saturation clamp u_i,v_i in [-2000000,2000000] per epoch.
//
// Usage: train_arch <features.tsv> <passes> <params_out.zag> <log_out.tsv>
// features.tsv cols (from feat.zag):
//   id \t family \t heldout \t depth \t t \t rel4 \t correct4 \t f1..f8
// 1 pass = 2 epochs per phase in A->B->C order. 10x = 10 passes (60 epochs),
// 100x = 100 passes (600 epochs).
//
// Every log's first line is the frozen prereg SHA (SR round §10 operational).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn ta_prereg_sha()[]u8 { return "f55d1dbbe1a609f69301ce8f537282a0372880b51fdec6b51d0f588b9fd96d30"; }

fn ta_div2()i64 { return 40000; } // same as v2: upward steps representable
fn ta_wlo()i64 { return -2000000; }
fn ta_whi()i64 { return 2000000; }

// truncation-toward-zero division for possibly-negative a, b>0
fn ta_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn ta_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
// integer sqrt (Newton), x>=0
fn ta_isqrt(x:i64)i64 {
    if(x<=0){return 0;}
    let g:i64=x;
    let g2:i64=(g+1)/2;
    while(g2<g){g=g2;g2=(g+x/g)/2;}
    return g;
}
// Pearson corr(s,t) in thousandths over released training cells:
//   corr1000 = tdiv(1000*(n*st-sum_s*sum_t),
//                   isqrt((n*ss2-ss^2)/K * (n*st2-st^2)/K)*K), K=65536.
// Returns 0 when either variance is zero (e.g. s constant at init).
fn ta_corr1000(n:i64,ss:i64,st:i64,sst:i64,ss2:i64,st2:i64)i64 {
    if(n<2){return 0;}
    let cov:i64=n*sst-ss*st;
    let vs:i64=n*ss2-ss*ss;
    let vt:i64=n*st2-st*st;
    if(vs<=0 || vt<=0){return 0;}
    let k:i64=65536;
    let a:i64=vs/k;
    let b2:i64=vt/k;
    let den:i64=ta_isqrt(a*b2)*k;
    if(den<=0){return 0;}
    return ta_tdiv(1000*cov,den);
}

// family name -> index 0..8 ; -1 unknown
fn ta_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}
fn ta_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}
// depth value -> slot 0..6 ; -1 unknown
fn ta_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// forward location head: m from arena u (8 i64), bias c, features f (8 i32)
fn ta_m(u:[]u8,c:i64,f:[]u8,base:i32)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(u,k)*(au_get32(f,base+k) as i64);
        k=k+1;
    }
    return ta_clamp(ta_tdiv(acc,1000)+c,0,1000);
}
// forward spread head: s from arena v (8 i64), bias d
fn ta_s(v:[]u8,d:i64,f:[]u8,base:i32)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(v,k)*(au_get32(f,base+k) as i64);
        k=k+1;
    }
    return ta_clamp(ta_tdiv(acc,1000)+d,0,1000);
}
// released confidence R = clamp(m - s/2, 0, 1000)
fn ta_r(m:i64,s:i64)i64 {
    return ta_clamp(m-s/2,0,1000);
}

// find tab positions: fills tabs[0..nft] with field end offsets
fn ta_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn ta_train(feat_path:[]u8,passes:i32,params_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // cell storage: meta (8 i32/cell), feats (8 i32/cell), id off/len (2 i32)
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0){return 102;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){return 102;}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            ta_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,7..14 f1..f8
            // field k spans line[tabs[k-1]+1 .. tabs[k]] (field 0 starts at 0).
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=ta_famidx(fam);
            let ph:i32=ta_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1; // 1 correct, 0 wrong, -1 abstain
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1); // prev_idx filled below
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e])); // t
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            // id index: nearest previous cell with equal id -> prev chain
            let pv:i32=-1;
            let j:i32=ci-1;
            while(j>=0 && pv<0){
                let jo:i32=au_get32(idix,j*2+0);
                let jl2:i32=au_get32(idix,j*2+1);
                if(jl2==id.len && nio_equal(idbuf[jo..jo+jl2],id)==1){
                    let jj:i32=j;
                    while(jj>=0){
                        let ko:i32=au_get32(idix,jj*2+0);
                        let kl:i32=au_get32(idix,jj*2+1);
                        if(kl!=id.len || nio_equal(idbuf[ko..ko+kl],id)!=1){jj=-1;}
                        if(jj>=0){
                            if(au_get32(meta,jj*8+2)==1){pv=jj;jj=-1;}
                            if(jj>=0){jj=jj-1;}
                        }
                    }
                    j=-1;
                }
                if(pv<0){j=j-1;}
            }
            au_put32(meta,ci*8+6,pv);
            au_put32(idix,ci*2+0,idn);
            au_put32(idix,ci*2+1,id.len);
            let q:i32=0;
            while(q<id.len){idbuf[idn+q]=id[q];q=q+1;}
            idn=idn+id.len;
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // weights: u[8] i64 location, c bias; v[8] i64 spread, d bias
    let u:[]u8=nio_alloc(8*8);
    let v:[]u8=nio_alloc(8*8);
    if(u.len==0||v.len==0){return 102;}
    au_put64(u,0,1000); // u1=1000: location starts as M4-with-harness-confidence
    // §7 init is literal: u1=1000, rest 0, c=0, v_i=0, d=0.
    // nio_alloc is NOT reliably zeroed (AGENTS.md arena-init lesson) — zero explicitly.
    let zi:i32=1;
    while(zi<8){au_put64(u,zi,0);zi=zi+1;}
    let zi2:i32=0;
    while(zi2<8){au_put64(v,zi2,0);zi2=zi2+1;}
    let c:i64=0;
    let d:i64=0; // spread bias, §7 init d=0 (predecessor never declared it — build blocker)
    // G accumulators: 9 families x 7 depth slots x (sumR, n, ncorrect)
    let gacc:[]u8=nio_alloc(9*7*3*8);
    if(gacc.len==0){return 102;}
    let lgo2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo2,12582912)!=0){return 102;}
    dout_str(&lgo2,"PREREG_SHA ");
    dout_str(&lgo2,ta_prereg_sha());
    dout_line(&lgo2);
    dout_str(&lgo2,"epoch\tphase\tloss\tv2\tgviol\tclampbind\tu1\tu2\tu3\tu4\tu5\tu6\tu7\tu8\tc\tv1\tv2\tv3\tv4\tv5\tv6\tv7\tv8\td\tmcC\tmcW\tmcA\tcorr_s\n");
    let epoch:i32=0;
    let p:i32=0;
    while(p<passes){
        let ph:i32=0;
        while(ph<3){
            let ep2:i32=0;
            while(ep2<2){
                // online pass over training cells of this phase
                let loss:i64=0;
                let v2c:i32=0;
                let i:i32=0;
                while(i<ncells){
                    if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                        let fbase:i32=i*8;
                        let y:i32=au_get32(meta,i*8+3);
                        let yy:i64=0;
                        if(y==1){yy=1000;}
                        let m:i64=ta_m(u,c,feats,fbase);
                        let s:i64=ta_s(v,d,feats,fbase);
                        let err:i64=m-yy;
                        // theater on the LOCATION path (own gradient path):
                        // wrong->wrong rising chain in m under CURRENT u,c
                        let rise:i64=0;
                        let pv:i32=au_get32(meta,i*8+6);
                        if(pv>=0 && y==0 && au_get32(meta,pv*8+3)==0){
                            let mprev:i64=ta_m(u,c,feats,pv*8);
                            if(m>mprev){rise=m-mprev;v2c=v2c+1;}
                        }
                        // spread target (STOP-GRAD on m: m is a constant here)
                        let t:i64=err;
                        if(t<0){t=-t;}
                        let errs:i64=s-t;
                        loss=loss+err*err+4*rise*rise+errs*errs;
                        // LOCATION update (symmetric calibration + theater)
                        let k3:i32=0;
                        while(k3<8){
                            let fk:i64=au_get32(feats,fbase+k3) as i64;
                            let num:i64=2*err*fk+8*rise*fk;
                            au_put64(u,k3,au_get64(u,k3)-ta_tdiv(num,ta_div2()));
                            k3=k3+1;
                        }
                        c=c-ta_tdiv(2*err*1000+8*rise*1000,ta_div2());
                        // SPREAD update (L_s only; never touches u/c)
                        let k4:i32=0;
                        while(k4<8){
                            let fk2:i64=au_get32(feats,fbase+k4) as i64;
                            let num2:i64=2*errs*fk2;
                            au_put64(v,k4,au_get64(v,k4)-ta_tdiv(num2,ta_div2()));
                            k4=k4+1;
                        }
                        d=d-ta_tdiv(2*errs*1000,ta_div2());
                    }
                    i=i+1;
                }
                // G-batch: recompute G on RELEASED conf R=m-s/2 per training
                // family/depth with frozen weights; adjust c ONLY.
                let gi:i32=0;
                while(gi<9*7*3){au_put64(gacc,gi,0);gi=gi+1;}
                let i2:i32=0;
                while(i2<ncells){
                    if(au_get32(meta,i2*8+5)>=0 && au_get32(meta,i2*8+2)==1){
                        let fi2:i32=au_get32(meta,i2*8+4);
                        let ds:i32=ta_dslot(au_get32(meta,i2*8+1));
                        if(fi2>=0 && ds>=0){
                            let r2:i64=ta_r(ta_m(u,c,feats,i2*8),ta_s(v,d,feats,i2*8));
                            let gx:i32=(fi2*7+ds)*3;
                            au_put64(gacc,gx,au_get64(gacc,gx)+r2);
                            au_put64(gacc,gx+1,au_get64(gacc,gx+1)+1);
                            if(au_get32(meta,i2*8+3)==1){
                                au_put64(gacc,gx+2,au_get64(gacc,gx+2)+1);
                            }
                        }
                    }
                    i2=i2+1;
                }
                let gviol:i32=0;
                let fi3:i32=0;
                while(fi3<9){
                    let prev_g:i64=0;
                    let have_prev:i32=0;
                    let s2:i32=0;
                    while(s2<7){
                        let gx2:i32=(fi3*7+s2)*3;
                        let n2:i64=au_get64(gacc,gx2+1);
                        if(n2>0){
                            let gth:i64=au_get64(gacc,gx2)/n2-1000*au_get64(gacc,gx2+2)/n2;
                            if(have_prev==1 && gth>prev_g){
                                gviol=gviol+1;
                                c=c-ta_tdiv(gth-prev_g,4);
                            }
                            prev_g=gth;
                            have_prev=1;
                        }
                        s2=s2+1;
                    }
                    fi3=fi3+1;
                }
                // anti-saturation clamp on u and v (frozen guard) + bindings
                let bind:i32=0;
                let k6:i32=0;
                while(k6<8){
                    let wv:i64=au_get64(u,k6);
                    if(wv<ta_wlo()){au_put64(u,k6,ta_wlo());bind=bind+1;}
                    if(wv>ta_whi()){au_put64(u,k6,ta_whi());bind=bind+1;}
                    let vv:i64=au_get64(v,k6);
                    if(vv<ta_wlo()){au_put64(v,k6,ta_wlo());bind=bind+1;}
                    if(vv>ta_whi()){au_put64(v,k6,ta_whi());bind=bind+1;}
                    k6=k6+1;
                }
                // telemetry: released-conf means + corr(s, |m-Y|) on released
                // training cells with epoch-end weights
                let sc:i64=0;let nc:i64=0;let sw:i64=0;let nw:i64=0;
                let ssum:i64=0;let tsum:i64=0;let stsum:i64=0;
                let ss2sum:i64=0;let st2sum:i64=0;let nn:i64=0;
                let i3:i32=0;
                while(i3<ncells){
                    if(au_get32(meta,i3*8+5)>=0 && au_get32(meta,i3*8+2)==1){
                        let fb3:i32=i3*8;
                        let m3:i64=ta_m(u,c,feats,fb3);
                        let s3:i64=ta_s(v,d,feats,fb3);
                        let r3:i64=ta_r(m3,s3);
                        if(au_get32(meta,i3*8+3)==1){sc=sc+r3;nc=nc+1;}
                        if(au_get32(meta,i3*8+3)==0){sw=sw+r3;nw=nw+1;}
                        let yy3:i64=0;
                        if(au_get32(meta,i3*8+3)==1){yy3=1000;}
                        let tt:i64=m3-yy3;
                        if(tt<0){tt=-tt;}
                        ssum=ssum+s3;tsum=tsum+tt;stsum=stsum+s3*tt;
                        ss2sum=ss2sum+s3*s3;st2sum=st2sum+tt*tt;nn=nn+1;
                    }
                    i3=i3+1;
                }
                let mcC:i64=0;let mcW:i64=0;let mcA:i64=0;
                if(nc>0){mcC=sc/nc;}
                if(nw>0){mcW=sw/nw;}
                if(nc+nw>0){mcA=(sc+sw)/(nc+nw);}
                let cors:i64=ta_corr1000(nn,ssum,tsum,stsum,ss2sum,st2sum);
                // log
                dout_i64(&lgo2,epoch as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,ph as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,loss);dout_byte(&lgo2,9);
                dout_i64(&lgo2,v2c as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,gviol as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,bind as i64);dout_byte(&lgo2,9);
                let k5:i32=0;
                while(k5<8){
                    dout_i64(&lgo2,au_get64(u,k5));dout_byte(&lgo2,9);
                    k5=k5+1;
                }
                dout_i64(&lgo2,c);dout_byte(&lgo2,9);
                let k7:i32=0;
                while(k7<8){
                    dout_i64(&lgo2,au_get64(v,k7));dout_byte(&lgo2,9);
                    k7=k7+1;
                }
                dout_i64(&lgo2,d);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcC);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcW);dout_byte(&lgo2,9);
                dout_i64(&lgo2,mcA);dout_byte(&lgo2,9);
                dout_i64(&lgo2,cors);
                dout_line(&lgo2);
                epoch=epoch+1;
                ep2=ep2+1;
            }
            ph=ph+1;
        }
        p=p+1;
    }
    // write params file
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,8192)!=0){return 102;}
    dout_str(&po,"// arch_params — FROZEN ARCH (m,s) head weights (PREREG_SR.md §7)\n");
    dout_str(&po,"// Generated by train_arch.zag. Do not hand-edit.\n");
    let k8:i32=0;
    while(k8<8){
        dout_str(&po,"fn au");
        dout_i64(&po,k8 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(u,k8));
        dout_str(&po,"; }\n");
        k8=k8+1;
    }
    dout_str(&po,"fn ac()i64 { return ");
    dout_i64(&po,c);
    dout_str(&po,"; }\n");
    let k9:i32=0;
    while(k9<8){
        dout_str(&po,"fn av");
        dout_i64(&po,k9 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(v,k9));
        dout_str(&po,"; }\n");
        k9=k9+1;
    }
    dout_str(&po,"fn ad()i64 { return ");
    dout_i64(&po,d);
    dout_str(&po,"; }\n");
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lgo2),lgo2.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);nio_free(tabs);
    nio_free(u);nio_free(v);nio_free(gacc);
    dout_free(&lgo2);dout_free(&po);
    if(wrc<0 || wrc2<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: train_arch <features.tsv> <passes> <params_out.zag> <log_out.tsv>");
        return 64;
    }
    let passes:i32=dlb_atoi(_zag_arg(2));
    if(passes<1 || passes>1000){return 64;}
    return ta_train(_zag_arg(1),passes,_zag_arg(3),_zag_arg(4));
}

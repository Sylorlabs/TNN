// train_f26.zag — F26 EFFIC TRAIN-COORD v2 trainer.
//
// Implements PREREG_FORKROUND.md §5b repaired TRAIN-COORD v2 literally:
//   - all params start at 0; fixed sweep order [b, w1..w9]; per param try
//     +50 then -50, then +8/-8, then +1/-1 refine; first strict improvement
//     accepted on STRICT L-REDUCTION ALONE (no vetoes during search);
//     8 sweeps; deterministic.
//   - objective: sum over training cells of (C - 1000*y)^2.
//   - vetoes V1-V3 computed on the FINAL answer only (reported; violation =
//     VOID, no eval).
//
// Head (PROTOCOL.md §1b, task formula):
//   C = clamp( tdiv(Σ_{i=1..8} w_i·f_i, 1000) + b + tdiv(w_9·f_9, 1000), 0, 1000 )
// New feature: f9 = (f1*1000)/(1000+q); q = (cumE*1000)/max(1,E_ref);
//   cumE = f5 column (frozen harness: already cumulative over rounds 1..d);
//   E_ref = lower-median cumE over released training cells at (family,depth).
//
// Usage: train_f26 <features.tsv> <params_out.zag> <log_out.tsv> <mode>
//   mode=0: full F26 (fit b,w1..w9). mode=1: base control (fit b,w1..w8;
//   w9 frozen at 0, f9 ignored).
//
// features.tsv cols: id \t family \t heldout \t depth \t t \t rel4
//   \t correct4 \t f1..f8. Training cells: heldout=0 AND rel4=1.
//
// Pure Zag, zero RNG. []u8 arenas + LE accessors throughout.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")

fn ef_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn ef_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn ef_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"trap")==1){return 4;}
    if(dlb_streq(fam,"redteam")==1){return 5;}
    if(dlb_streq(fam,"P")==1){return 6;}
    if(dlb_streq(fam,"D")==1){return 7;}
    if(dlb_streq(fam,"O")==1){return 8;}
    return -1;
}
fn ef_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// Head confidence for one cell.
// p: 10xi64 arena [b, w1..w9]; feats: ncells*9 i32 arena (f1..f8,f9).
// use_w9: 1 full mode, 0 base mode.
fn ef_conf(p:[]u8,feats:[]u8,ci:i32,use_w9:i32)i32 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(p,1+k)*(au_get32(feats,ci*9+k) as i64);
        k=k+1;
    }
    let c:i64=ef_tdiv(acc,1000)+au_get64(p,0);
    if(use_w9==1){
        c=c+ef_tdiv(au_get64(p,9)*(au_get32(feats,ci*9+8) as i64),1000);
    }
    return ef_clamp(c,0,1000) as i32;
}

// Evaluate candidate params: objective + veto statistics.
// meta: ncells*5 i32 [fam, depth, y, prev, dslot]; vacc: 9*7*3 i64 scratch.
fn ef_eval(p:[]u8,feats:[]u8,meta:[]u8,ncells:i32,use_w9:i32,vacc:[]u8,
           obj:*i64,v12:*i64,mccn:*i64,mccd:*i64,v3bad:*i64)void {
    let o:i64=0;
    let t12:i64=0;
    let mn:i64=0;
    let md:i64=0;
    let zi:i32=0;
    while(zi<9*7*3){au_put64(vacc,zi,0);zi=zi+1;}
    let i:i32=0;
    while(i<ncells){
        let y:i32=au_get32(meta,i*5+2);
        let c:i64=ef_conf(p,feats,i,use_w9) as i64;
        let yy:i64=0;
        if(y==1){yy=1000;}
        let e:i64=c-yy;
        o=o+e*e;
        if(y==1){mn=mn+c;md=md+1;}
        let fi:i32=au_get32(meta,i*5+0);
        let ds:i32=au_get32(meta,i*5+4);
        if(fi>=0 && ds>=0){
            let gx:i32=(fi*7+ds)*3;
            au_put64(vacc,gx,au_get64(vacc,gx)+c);
            au_put64(vacc,gx+1,au_get64(vacc,gx+1)+1);
            if(y==1){au_put64(vacc,gx+2,au_get64(vacc,gx+2)+1);}
        }
        let pv:i32=au_get32(meta,i*5+3);
        if(pv>=0){
            let yp:i32=au_get32(meta,pv*5+2);
            let cp:i64=ef_conf(p,feats,pv,use_w9) as i64;
            if(yp==1 && y==0 && c>=cp){t12=t12+1;}
            if(yp==0 && y==0 && c>cp){t12=t12+1;}
        }
        i=i+1;
    }
    let bad:i64=0;
    let f2:i32=0;
    while(f2<9){
        let s:i32=0;
        while(s<7){
            let gx2:i32=(f2*7+s)*3;
            let n2:i64=au_get64(vacc,gx2+1);
            if(n2>=8){
                let gth:i64=au_get64(vacc,gx2)-1000*au_get64(vacc,gx2+2);
                if(gth<-80*n2){bad=1;}
            }
            s=s+1;
        }
        f2=f2+1;
    }
    obj.*=o;v12.*=t12;mccn.*=mn;mccd.*=md;v3bad.*=bad;
}

// Fit with TRAIN-COORD v2. Logs every candidate.
fn ef_fit(tag:[]u8,use_w9:i32,p:[]u8,feats:[]u8,meta:[]u8,ncells:i32,
          vacc:[]u8,lgo:*DOut)void {
    let k:i32=0;
    while(k<10){au_put64(p,k,0);k=k+1;}
    let obj:i64=0;let v12:i64=0;let mccn:i64=0;let mccd:i64=0;let v3bad:i64=0;
    ef_eval(p,feats,meta,ncells,use_w9,vacc,&obj,&v12,&mccn,&mccd,&v3bad);
    let best:i64=obj;
    dout_str(lgo,tag);dout_str(lgo,"\tinit\tobj=");dout_i64(lgo,obj);
    dout_str(lgo,"\tv12=");dout_i64(lgo,v12);
    dout_str(lgo,"\tmccn=");dout_i64(lgo,mccn);
    dout_str(lgo,"\tmccd=");dout_i64(lgo,mccd);
    dout_str(lgo,"\tv3bad=");dout_i64(lgo,v3bad);dout_line(lgo);
    let nparams:i32=10;
    if(use_w9==0){nparams=9;}
    let sw:i32=0;
    while(sw<8){
        let accsw:i32=0;
        let pi:i32=0;
        while(pi<nparams){
            let si:i32=0;
            while(si<3){
                let step:i64=50;
                if(si==1){step=8;}
                if(si==2){step=1;}
                let done:i32=0;
                let sgi:i32=0;
                while(sgi<2 && done==0){
                    let sgn:i64=step;
                    if(sgi==1){sgn=-step;}
                    let cand:i64=au_get64(p,pi)+sgn;
                    let insk:i32=0;
                    if(cand>=-1000 && cand<=1000){insk=1;}
                    if(insk==1){
                        let old:i64=au_get64(p,pi);
                        au_put64(p,pi,cand);
                        let o2:i64=0;let t2:i64=0;let n2:i64=0;let d2:i64=0;let b2:i64=0;
                        ef_eval(p,feats,meta,ncells,use_w9,vacc,&o2,&t2,&n2,&d2,&b2);
                        let improved:i64=0;
                        if(o2<best){improved=1;}
                        dout_str(lgo,tag);dout_byte(lgo,9);
                        dout_str(lgo,"sw");dout_i64(lgo,sw as i64);dout_byte(lgo,9);
                        dout_str(lgo,"p");dout_i64(lgo,pi as i64);dout_byte(lgo,9);
                        dout_str(lgo,"try");dout_i64(lgo,sgn);dout_byte(lgo,9);
                        dout_str(lgo,"obj");dout_i64(lgo,o2);dout_byte(lgo,9);
                        dout_str(lgo,"dobj");dout_i64(lgo,o2-best);dout_byte(lgo,9);
                        dout_str(lgo,"acc");dout_i64(lgo,improved);dout_line(lgo);
                        if(improved==1){
                            best=o2;accsw=accsw+1;done=1;
                        }
                        if(improved==0){au_put64(p,pi,old);}
                    }
                    if(insk==0){
                        dout_str(lgo,tag);dout_byte(lgo,9);
                        dout_str(lgo,"sw");dout_i64(lgo,sw as i64);dout_byte(lgo,9);
                        dout_str(lgo,"p");dout_i64(lgo,pi as i64);dout_byte(lgo,9);
                        dout_str(lgo,"box-skip");dout_i64(lgo,sgn);dout_line(lgo);
                    }
                    sgi=sgi+1;
                }
                si=si+1;
            }
            pi=pi+1;
        }
        dout_str(lgo,tag);dout_str(lgo,"\tsweep");dout_i64(lgo,sw as i64);
        dout_str(lgo,"\taccepted=");dout_i64(lgo,accsw as i64);
        dout_str(lgo,"\tbest=");dout_i64(lgo,best);dout_line(lgo);
        sw=sw+1;
    }
    dout_str(lgo,tag);dout_str(lgo,"\tfinal");
    let kf:i32=0;
    while(kf<10){dout_str(lgo,"\tp");dout_i64(lgo,kf as i64);dout_str(lgo,"=");
        dout_i64(lgo,au_get64(p,kf));kf=kf+1;}
    dout_line(lgo);
}

fn ef_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn ef_train(feat_path:[]u8,params_path:[]u8,log_path:[]u8,mode:i32)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*5*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*9*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    let tabs:[]u8=nio_alloc(17*4);
    let vacc:[]u8=nio_alloc((9*7*3*8) as i64);
    let eref:[]u8=nio_alloc((9*7*8) as i64);
    let legc:[]u8=nio_alloc((9*7*4) as i64);
    let lego:[]u8=nio_alloc((9*7*4) as i64);
    let legf:[]u8=nio_alloc((9*7*4) as i64);
    let legv:[]u8=nio_alloc((maxcells*4) as i64);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0||tabs.len==0||vacc.len==0||eref.len==0||legc.len==0||lego.len==0||legf.len==0||legv.len==0){return 102;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,4194304)!=0){return 102;}
    dout_str(&lgo,"# train_f26 log — F26 EFFIC TRAIN-COORD v2 (PREREG_FORKROUND.md §5b)\n");
    if(mode==0){dout_str(&lgo,"# mode=0 full F26 (fit b,w1..w9)\n");}
    if(mode==1){dout_str(&lgo,"# mode=1 base control (fit b,w1..w8; w9 frozen 0)\n");}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            ef_split(line,tabs);
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            if(heldout==0 && rel4==1){
                let fi:i32=ef_famidx(fam);
                let ds:i32=ef_dslot(depth);
                let y:i32=0;
                if(c4.len==1 && c4[0]==49){y=1;}
                let ci:i32=ncells;
                au_put32(meta,ci*5+0,fi);
                au_put32(meta,ci*5+1,depth);
                au_put32(meta,ci*5+2,y);
                au_put32(meta,ci*5+3,-1);
                au_put32(meta,ci*5+4,ds);
                let k:i32=0;
                while(k<8){
                    let a2:i32=au_get32(tabs,6+k);
                    let b2:i32=au_get32(tabs,7+k);
                    au_put32(feats,ci*9+k,dlb_atoi(line[a2+1..b2]));
                    k=k+1;
                }
                au_put32(feats,ci*9+8,0);
                // prev chain: nearest previous same-id training cell
                let pv:i32=-1;
                let j:i32=ci-1;
                while(j>=0 && pv<0){
                    let jo:i32=au_get32(idix,j*2+0);
                    let jl:i32=au_get32(idix,j*2+1);
                    if(jl==id.len && nio_equal(idbuf[jo..jo+jl],id)==1){pv=j;}
                    if(pv<0){j=j-1;}
                }
                au_put32(meta,ci*5+3,pv);
                au_put32(idix,ci*2+0,idn);
                au_put32(idix,ci*2+1,id.len);
                let q2:i32=0;
                while(q2<id.len){idbuf[idn+q2]=id[q2];q2=q2+1;}
                idn=idn+id.len;
                ncells=ncells+1;
            }
        }
        pos=e+1;
    }
    dout_str(&lgo,"ncells_training_released=");dout_i64(&lgo,ncells as i64);dout_line(&lgo);
    // E_ref per (fam,dslot): lower median of cumE (=f5) over training cells.
    let li:i32=0;
    while(li<9*7){au_put32(legc,li,0);li=li+1;}
    let ci2:i32=0;
    while(ci2<ncells){
        let fi2:i32=au_get32(meta,ci2*5+0);
        let ds2:i32=au_get32(meta,ci2*5+4);
        if(fi2>=0 && ds2>=0){
            let gx:i32=fi2*7+ds2;
            au_put32(legc,gx,au_get32(legc,gx)+1);
        }
        ci2=ci2+1;
    }
    // prefix offsets, then scatter each cell's cumE into its leg run
    let ro:i32=0;
    let g0:i32=0;
    while(g0<9*7){
        au_put32(lego,g0,ro);
        au_put32(legf,g0,ro);
        ro=ro+au_get32(legc,g0);
        g0=g0+1;
    }
    let ci2b:i32=0;
    while(ci2b<ncells){
        let fi2b:i32=au_get32(meta,ci2b*5+0);
        let ds2b:i32=au_get32(meta,ci2b*5+4);
        if(fi2b>=0 && ds2b>=0){
            let gx2:i32=fi2b*7+ds2b;
            let at:i32=au_get32(legf,gx2);
            au_put32(legv,at,au_get32(feats,ci2b*9+4));
            au_put32(legf,gx2,at+1);
        }
        ci2b=ci2b+1;
    }
    // selection sort each leg's run (deterministic), lower median
    let g2:i32=0;
    while(g2<9*7){
        let n2:i32=au_get32(legc,g2);
        let base:i32=au_get32(lego,g2);
        let s2:i32=0;
        while(s2<n2){
            let mni:i32=s2;
            let t2:i32=s2+1;
            while(t2<n2){
                if(au_get32(legv,base+t2)<au_get32(legv,base+mni)){mni=t2;}
                t2=t2+1;
            }
            let tmp:i32=au_get32(legv,base+s2);
            au_put32(legv,base+s2,au_get32(legv,base+mni));
            au_put32(legv,base+mni,tmp);
            s2=s2+1;
        }
        let med:i64=1000;
        if(n2>0){med=au_get32(legv,base+(n2-1)/2) as i64;}
        au_put64(eref,g2,med);
        g2=g2+1;
    }
    dout_str(&lgo,"# E_ref per (fam,dslot) [lower median cumE over released training cells]\n");
    let lf:i32=0;
    while(lf<9){
        let ls:i32=0;
        while(ls<7){
            dout_str(&lgo,"eref\t");dout_i64(&lgo,lf as i64);dout_byte(&lgo,9);
            dout_i64(&lgo,ls as i64);dout_byte(&lgo,9);
            dout_i64(&lgo,au_get64(eref,lf*7+ls));dout_line(&lgo);
            ls=ls+1;
        }
        lf=lf+1;
    }
    // per-cell q and f9
    let ci3:i32=0;
    while(ci3<ncells){
        let fi3:i32=au_get32(meta,ci3*5+0);
        let ds3:i32=au_get32(meta,ci3*5+4);
        let er:i64=1000;
        if(fi3>=0 && ds3>=0){er=au_get64(eref,fi3*7+ds3);}
        if(er<1){er=1;}
        let cume:i64=au_get32(feats,ci3*9+4) as i64;
        let q3:i64=(cume*1000)/er;
        let f1v:i64=au_get32(feats,ci3*9+0) as i64;
        let f9v:i64=(f1v*1000)/(1000+q3);
        au_put32(feats,ci3*9+8,f9v as i32);
        ci3=ci3+1;
    }
    let p:[]u8=nio_alloc(10*8);
    if(p.len==0){return 102;}
    if(mode==0){ef_fit("F26",1,p,feats,meta,ncells,vacc,&lgo);}
    if(mode==1){ef_fit("F26b",0,p,feats,meta,ncells,vacc,&lgo);}
    // final-answer vetoes V1-V3 (§5b)
    let use9:i32=1;
    if(mode==1){use9=0;}
    let fo:i64=0;let ft12:i64=0;let fmn:i64=0;let fmd:i64=0;let fb3:i64=0;
    ef_eval(p,feats,meta,ncells,use9,vacc,&fo,&ft12,&fmn,&fmd,&fb3);
    let v2ok:i64=0;
    if(fmd>0 && fmn>=550*fmd){v2ok=1;}
    dout_str(&lgo,"# FINAL-ANSWER VETOES (v2: gate the final answer only)\n");
    dout_str(&lgo,"final_obj=");dout_i64(&lgo,fo);dout_line(&lgo);
    dout_str(&lgo,"V1_theater_v12=");dout_i64(&lgo,ft12);
    dout_str(&lgo,"\t-> ");if(ft12>0){dout_str(&lgo,"VOID");}else{dout_str(&lgo,"clear");}dout_line(&lgo);
    dout_str(&lgo,"V2_meanConfCorrect_num=");dout_i64(&lgo,fmn);
    dout_str(&lgo,"_den=");dout_i64(&lgo,fmd);
    dout_str(&lgo,"\t-> ");if(v2ok==0){dout_str(&lgo,"VOID");}else{dout_str(&lgo,"clear");}dout_line(&lgo);
    dout_str(&lgo,"V3_badslot=");dout_i64(&lgo,fb3);
    dout_str(&lgo,"\t-> ");if(fb3==1){dout_str(&lgo,"VOID");}else{dout_str(&lgo,"clear");}dout_line(&lgo);
    let voided:i64=0;
    if(ft12>0 || v2ok==0 || fb3==1){voided=1;}
    dout_str(&lgo,"FINAL_VERDICT=");if(voided==1){dout_str(&lgo,"VOID");}else{dout_str(&lgo,"PASS-CHECKPOINT");}dout_line(&lgo);
    // write params file (trainer-generated, never hand-edited)
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    let pfx:[]u8="f26";
    if(mode==1){pfx="f26b";}
    dout_str(&po,"// ");dout_str(&po,pfx);dout_str(&po,"_params — F26 ");
    if(mode==0){dout_str(&po,"EFFIC");}
    if(mode==1){dout_str(&po,"EFFIC base control");}
    dout_str(&po," trained head params (FROZEN after training)\n");
    dout_str(&po,"// Generated by train_f26.zag (PREREG_FORKROUND.md F26). Do not hand-edit.\n");
    let nwp:i32=9;
    if(mode==1){nwp=8;}
    let pi2:i32=0;
    while(pi2<nwp){
        dout_str(&po,"fn ");dout_str(&po,pfx);dout_str(&po,"_w");dout_i64(&po,(pi2+1) as i64);
        dout_str(&po,"()i64 { return ");dout_i64(&po,au_get64(p,1+pi2));
        dout_str(&po,"; }\n");
        pi2=pi2+1;
    }
    dout_str(&po,"fn ");dout_str(&po,pfx);dout_str(&po,"_b()i64 { return ");
    dout_i64(&po,au_get64(p,0));
    dout_str(&po,"; }\n");
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lgo),lgo.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);
    nio_free(tabs);nio_free(vacc);nio_free(eref);nio_free(legc);nio_free(lego);nio_free(legf);nio_free(legv);
    nio_free(p);
    dout_free(&lgo);dout_free(&po);
    if(wrc<0 || wrc2<0){return 103;}
    if(lgo.err!=0){return 103;}
    return 0;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    if(a1.len==0 || a2.len==0 || a3.len==0 || a4.len==0){
        _zag_println("usage: train_f26 <features.tsv> <params_out.zag> <log_out.tsv> <mode>");
        return 64;
    }
    let mode:i32=dlb_atoi(a4);
    if(mode<0 || mode>1){return 64;}
    return ef_train(a1,a2,a3,mode);
}

// dlb_ledger.zag — SHA256-chained audit ledger for the H5 deliberation harness.
//
// Every deliberation step is appended as one JSON line:
//   {"seq":N,"item":"...","round":R,"action":"...","detail":"...",
//    "prev":"<hex>","hash":"<hex>"}
// where hash = SHA256( prev_raw_32_bytes || canonical_step_bytes ),
// canonical_step_bytes = "<seq>|<item>|<round>|<action>|<detail>" (ASCII).
// Genesis prev is 32 zero bytes. Any tampering or reordering breaks the chain.
// Item ids, actions, and details are restricted to a JSON-safe alphabet
// (see dlb_id_ok and the detail builders), so no escaping is needed.
// Pure Zag; ns_sha256 comes from the lab's native-substrate SHA256 file.

struct LG { seq:i64, prev:[]u8, head:[]u8 }

fn lg_init(lg:*LG)i32 {
    let p:[]u8=nio_alloc(32);
    let h:[]u8=nio_alloc(64);
    if(p.len!=32 || h.len!=64){nio_free(p);nio_free(h);return -1;}
    lg.*.seq=0;lg.*.prev=p;lg.*.head=h;
    return 0;
}
fn lg_free(lg:*LG)void {
    let p:[]u8=lg.*.prev;let h:[]u8=lg.*.head;
    if(p.len>0){nio_free(p);}
    if(h.len>0){nio_free(h);}
    lg.*.prev="";lg.*.head="";
}
fn lg_head_hex(lg:*LG)[]u8 {
    let h:[]u8=lg.*.head;
    return h;
}
// Append one step. Returns 0 ok, negative on error.
fn lg_step(lg:*LG,o:*DOut,item:[]u8,round:i32,action:[]u8,detail:[]u8)i32 {
    let tmp:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&tmp,2048)!=0){return -1;}
    dout_i64(&tmp,lg.*.seq);
    dout_byte(&tmp,124);
    dout_str(&tmp,item);
    dout_byte(&tmp,124);
    dout_i64(&tmp,round as i64);
    dout_byte(&tmp,124);
    dout_str(&tmp,action);
    dout_byte(&tmp,124);
    dout_str(&tmp,detail);
    if(tmp.err!=0){dout_free(&tmp);return -2;}
    let canon:[]u8=dout_bytes(&tmp);
    let inp:[]u8=nio_alloc(32+canon.len);
    if(inp.len==0){dout_free(&tmp);return -3;}
    let prev:[]u8=lg.*.prev;
    let i:i32=0;
    while(i<32){inp[i]=prev[i];i=i+1;}
    i=0;
    while(i<canon.len){inp[32+i]=canon[i];i=i+1;}
    let h32:[]u8=nio_alloc(32);
    if(h32.len!=32){nio_free(inp);dout_free(&tmp);return -4;}
    let rc:i32=ns_sha256(inp,h32);
    nio_free(inp);
    dout_free(&tmp);
    if(rc!=0){nio_free(h32);return -5;}
    let phex:[]u8=ns_hex(prev);
    let hhex:[]u8=ns_hex(h32);
    if(phex.len!=64 || hhex.len!=64){nio_free(h32);nio_free(phex);nio_free(hhex);return -6;}
    dout_str(o,"{\"seq\":");
    dout_i64(o,lg.*.seq);
    dout_str(o,",\"item\":\"");
    dout_str(o,item);
    dout_str(o,"\",\"round\":");
    dout_i64(o,round as i64);
    dout_str(o,",\"action\":\"");
    dout_str(o,action);
    dout_str(o,"\",\"detail\":\"");
    dout_str(o,detail);
    dout_str(o,"\",\"prev\":\"");
    dout_str(o,phex);
    dout_str(o,"\",\"hash\":\"");
    dout_str(o,hhex);
    dout_str(o,"\"}");
    dout_line(o);
    nio_free(phex);
    if(o.*.err!=0){nio_free(h32);nio_free(hhex);return -7;}
    i=0;
    while(i<32){prev[i]=h32[i];i=i+1;}
    let head:[]u8=lg.*.head;
    i=0;
    while(i<64){head[i]=hhex[i];i=i+1;}
    nio_free(h32);
    nio_free(hhex);
    lg.*.seq=lg.*.seq+1;
    return 0;
}

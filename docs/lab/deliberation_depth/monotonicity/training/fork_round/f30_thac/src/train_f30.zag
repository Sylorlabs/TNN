// train_f30.zag — F30 THAC deterministic trainer (Crew: H5 fork round).
//
// Two decoupled heads (per ideas/fable_forks.md Mechanism C + pre-registered
// logs/OPTIMIZER_CHOICE.md):
//   Predictor P(s) = clamp((Σ w_i·f_i)/1000 + b_P, 0, 1000):
//     frozen PREREG_TRAINING.md §5 mechanics exactly, PLUS per-cell reversal:
//     after each gradient step L is recomputed on the cell; the update is
//     restored if L increased ("updates reversed if they increase the minimum").
//   Censor b_c: adversarial protocol — after the predictor's update on each
//     training cell, if P_new(s) > Y the censor tightens: b_c ← max(b_c−1,−500),
//     always accepted, never reversed. (The censor VALUE C_n is only needed at
//     eval; training needs just b_c, so no censor reconstruction here.)
//
// Pure Zag, zero RNG, fixed file order, integer arithmetic (tr_tdiv).
// []u8 arenas + au_* LE accessors; no fn named zalloc; no slice > 2^25.
//
// Usage: train_f30 <features.tsv> <passes> <params_out.zag> <log_out.tsv>

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn tr_div()i64 { return 4000000; }

fn tr_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}

fn tr_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

fn tr_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}

fn tr_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}

fn tr_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

fn tr_dval(s:i32)i32 {
    if(s==0){return 1;}
    if(s==1){return 2;}
    if(s==2){return 4;}
    if(s==3){return 8;}
    if(s==4){return 16;}
    if(s==5){return 32;}
    return 64;
}

// predictor head P(s) with weights w[8] (i64 arena) and bias bp
fn tr_pred(w:[]u8,bp:i64,f:[]u8,fbase:i32)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(w,k)*(au_get32(f,fbase+k) as i64);
        k=k+1;
    }
    return tr_clamp(tr_tdiv(acc,1000)+bp,0,1000);
}

// find tab positions: fills tabs[0..nft] with field end offsets
fn tr_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn tr_train(feat_path:[]u8,passes:i32,params_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // cell storage: meta (8 i32/cell), feats (8 i32/cell), id off/len (2 i32)
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let idix:[]u8=nio_alloc((maxcells*2*4) as i64);
    let idbuf:[]u8=nio_alloc(1048576);
    if(meta.len==0||feats.len==0||idix.len==0||idbuf.len==0){return 102;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){return 102;}
    let ncells:i32=0;
    let idn:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            tr_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,7..14 f1..f8
            let f0:i32=0;
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let id:[]u8=line[f0..f1e];
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=tr_famidx(fam);
            let ph:i32=tr_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1; // 1 correct, 0 wrong, -1 abstain
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1); // prev_idx filled below
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e])); // t
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            // id index: nearest previous cell with equal id -> prev chain
            let pv:i32=-1;
            let j:i32=ci-1;
            while(j>=0 && pv<0){
                let jo:i32=au_get32(idix,j*2+0);
                let jl2:i32=au_get32(idix,j*2+1);
                if(jl2==id.len && nio_equal(idbuf[jo..jo+jl2],id)==1){
                    // nearest previous same-id cell with rel4=1
                    let jj:i32=j;
                    while(jj>=0){
                        let ko:i32=au_get32(idix,jj*2+0);
                        let kl:i32=au_get32(idix,jj*2+1);
                        if(kl!=id.len || nio_equal(idbuf[ko..ko+kl],id)!=1){jj=-1;}
                        if(jj>=0){
                            if(au_get32(meta,jj*8+2)==1){pv=jj;jj=-1;}
                            if(jj>=0){jj=jj-1;}
                        }
                    }
                    j=-1;
                }
                if(pv<0){j=j-1;}
            }
            au_put32(meta,ci*8+6,pv);
            au_put32(idix,ci*2+0,idn);
            au_put32(idix,ci*2+1,id.len);
            let q:i32=0;
            while(q<id.len){idbuf[idn+q]=id[q];q=q+1;}
            idn=idn+id.len;
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // weights: w[8] i64, predictor bias bp, censor bias bc
    let w:[]u8=nio_alloc(8*8);
    let sw:[]u8=nio_alloc(8*8);
    if(w.len==0||sw.len==0){return 102;}
    au_put64(w,0,1000); // w1=1000: start as M4-with-harness-confidence
    let bp:i64=0;
    let bc:i64=0; // censor bias: init 0 (transparent), only decrements, floor -500
    // G accumulators: 9 families x 7 depth slots x (sumC, n, ncorrect)
    let gacc:[]u8=nio_alloc(9*7*3*8);
    if(gacc.len==0){return 102;}
    let lgo2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo2,4194304)!=0){return 102;}
    dout_str(&lgo2,"epoch\tphase\tloss\tv2\tgviol\tw1\tw2\tw3\tw4\tw5\tw6\tw7\tw8\tb_P\tb_c\tn_rev\tn_adv\n");
    let epoch:i32=0;
    let p:i32=0;
    while(p<passes){
        let ph:i32=0;
        while(ph<3){
            let ep2:i32=0;
            while(ep2<2){
                // online pass over training cells of this phase
                let loss:i64=0;
                let v2c:i32=0;
                let nrev:i32=0;
                let nadv:i32=0;
                let i:i32=0;
                while(i<ncells){
                    if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                        let fbase:i32=i*8;
                        let y:i32=au_get32(meta,i*8+3);
                        let yy:i64=0;
                        if(y==1){yy=1000;}
                        let pv:i32=au_get32(meta,i*8+6);
                        // pre-update quantities (frozen §5: fixed for all 8 steps)
                        let pc:i64=tr_pred(w,bp,feats,fbase);
                        let err:i64=pc-yy;
                        let yw:i64=0;
                        if(y==0){yw=1;}
                        let pvok:i32=0;
                        if(pv>=0 && y==0 && au_get32(meta,pv*8+3)==0){pvok=1;}
                        let rsd:i64=0;
                        if(pvok==1){
                            let pp0:i64=tr_pred(w,bp,feats,pv*8);
                            if(pc>pp0){rsd=pc-pp0;v2c=v2c+1;}
                        }
                        let lold:i64=err*err+2*yw*pc*pc+4*rsd*rsd;
                        loss=loss+lold;
                        // save weights; apply frozen-§5 gradient step
                        let k3:i32=0;
                        while(k3<8){
                            au_put64(sw,k3,au_get64(w,k3));
                            let fk:i64=au_get32(feats,fbase+k3) as i64;
                            let num:i64=2*err*fk+4*yw*pc*fk+8*rsd*fk;
                            au_put64(w,k3,au_get64(w,k3)-tr_tdiv(num,tr_div()));
                            k3=k3+1;
                        }
                        let sbp:i64=bp;
                        let nb:i64=2*err*1000+4*yw*pc*1000+8*rsd*1000;
                        bp=sbp-tr_tdiv(nb,tr_div());
                        // reversal: recompute L with new weights
                        let p2:i64=tr_pred(w,bp,feats,fbase);
                        let err2:i64=p2-yy;
                        let rsd2:i64=0;
                        if(pvok==1){
                            let pp2:i64=tr_pred(w,bp,feats,pv*8);
                            if(p2>pp2){rsd2=p2-pp2;}
                        }
                        let lnew:i64=err2*err2+2*yw*p2*p2+4*rsd2*rsd2;
                        let pfin:i64=p2;
                        if(lnew>lold){
                            let k4:i32=0;
                            while(k4<8){
                                au_put64(w,k4,au_get64(sw,k4));
                                k4=k4+1;
                            }
                            bp=sbp;
                            nrev=nrev+1;
                            pfin=pc;
                        }
                        // adversarial censor step on the predictor's assignment
                        if(pfin>yy){
                            if(bc>-500){bc=bc-1;nadv=nadv+1;}
                        }
                    }
                    i=i+1;
                }
                // G-batch: recompute G per training family/depth with frozen weights
                let gi:i32=0;
                while(gi<9*7*3){au_put64(gacc,gi,0);gi=gi+1;}
                let i2:i32=0;
                while(i2<ncells){
                    if(au_get32(meta,i2*8+5)>=0 && au_get32(meta,i2*8+2)==1){
                        let fi2:i32=au_get32(meta,i2*8+4);
                        let ds:i32=tr_dslot(au_get32(meta,i2*8+1));
                        if(fi2>=0 && ds>=0){
                            let c2:i64=tr_pred(w,bp,feats,i2*8);
                            let gx:i32=(fi2*7+ds)*3;
                            au_put64(gacc,gx,au_get64(gacc,gx)+c2);
                            au_put64(gacc,gx+1,au_get64(gacc,gx+1)+1);
                            if(au_get32(meta,i2*8+3)==1){
                                au_put64(gacc,gx+2,au_get64(gacc,gx+2)+1);
                            }
                        }
                    }
                    i2=i2+1;
                }
                let gviol:i32=0;
                let fi3:i32=0;
                while(fi3<9){
                    let prev_g:i64=0;
                    let have_prev:i32=0;
                    let s:i32=0;
                    while(s<7){
                        let gx2:i32=(fi3*7+s)*3;
                        let n2:i64=au_get64(gacc,gx2+1);
                        if(n2>0){
                            let gth:i64=au_get64(gacc,gx2)/n2-1000*au_get64(gacc,gx2+2)/n2;
                            if(have_prev==1 && gth>prev_g){
                                gviol=gviol+1;
                                bp=bp-tr_tdiv(gth-prev_g,4);
                            }
                            prev_g=gth;
                            have_prev=1;
                        }
                        s=s+1;
                    }
                    fi3=fi3+1;
                }
                // log
                dout_i64(&lgo2,epoch as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,ph as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,loss);dout_byte(&lgo2,9);
                dout_i64(&lgo2,v2c as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,gviol as i64);dout_byte(&lgo2,9);
                let k5:i32=0;
                while(k5<8){
                    dout_i64(&lgo2,au_get64(w,k5));dout_byte(&lgo2,9);
                    k5=k5+1;
                }
                dout_i64(&lgo2,bp);dout_byte(&lgo2,9);
                dout_i64(&lgo2,bc);dout_byte(&lgo2,9);
                dout_i64(&lgo2,nrev as i64);dout_byte(&lgo2,9);
                dout_i64(&lgo2,nadv as i64);
                dout_line(&lgo2);
                epoch=epoch+1;
                ep2=ep2+1;
            }
            ph=ph+1;
        }
        p=p+1;
    }
    // write params file
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    dout_str(&po,"// f30_params — FROZEN trained F30 THAC weights\n");
    dout_str(&po,"// Generated by train_f30.zag (PREREG_FORKROUND.md §3 F30). Do not hand-edit.\n");
    let k6:i32=0;
    while(k6<8){
        dout_str(&po,"fn f30_w");
        dout_i64(&po,k6 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(w,k6));
        dout_str(&po,"; }\n");
        k6=k6+1;
    }
    dout_str(&po,"fn f30_bp()i64 { return ");
    dout_i64(&po,bp);
    dout_str(&po,"; }\n");
    dout_str(&po,"fn f30_bc()i64 { return ");
    dout_i64(&po,bc);
    dout_str(&po,"; }\n");
    let wrc:i64=dlb_write_file(params_path,dout_bytes(&po),po.n);
    let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lgo2),lgo2.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(idix);nio_free(idbuf);nio_free(tabs);
    nio_free(w);nio_free(sw);nio_free(gacc);
    dout_free(&lgo2);dout_free(&po);
    if(wrc<0 || wrc2<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: train_f30 <features.tsv> <passes> <params_out.zag> <log_out.tsv>");
        return 64;
    }
    let passes:i32=dlb_atoi(_zag_arg(2));
    if(passes<1 || passes>1000){return 64;}
    return tr_train(_zag_arg(1),passes,_zag_arg(3),_zag_arg(4));
}

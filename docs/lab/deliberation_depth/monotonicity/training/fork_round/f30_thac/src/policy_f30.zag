// policy_f30.zag — F30 THAC evaluation driver (Crew: H5 fork round).
//
// Runs the FROZEN harness deliberation (byte-identical dlb_*.zag copies)
// at a fixed depth per item, then applies the F30 two-head composed confidence:
//   release: M4 skeleton (release L_t iff L_t == L_1, else ABSTAIN) — UNCHANGED
//   P(s)   = clamp((Σ f30_wi·f_i)/1000 + f30_bp, 0, 1000)   (optimistic predictor)
//   C_n(s) = clamp(min(margin_t, 1000 − t·1000/64,
//                      1000 if nalive≤2 else nalive·1000/nh) + f30_bc, 0, 1000)
//   C(s)   = min(P(s), C_n(s))                              (suppress-only)
// Weights are baked in as constants via f30_params.zag
// (generated by train_f30.zag — never hand-edited).
//
// Usage: policy_f30 <items.jsonl> <depth> <gate01> <results.tsv>
// gate01 must be 0 (no gate in this fork).
//
// Per-item TSV record: identical columns to mech.zag:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert
// Sidecar <results.tsv>.bind.tsv: id \t depth \t P \t Cn \t bind01
//   (bind01 = 1 iff Cn < P, i.e. the censor strictly binds on a released cell)

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("f30_params.zag")

fn pl_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// §4 features (index-level only), flat out-params
fn pl_features(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=pl_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=pl_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=pl_clamp(maxdrop,0,1000);
}

fn pl_pred(f1:i64,f2:i64,f3:i64,f4:i64,f5:i64,f6:i64,f7:i64,f8:i64)i64 {
    let acc:i64=f30_w0()*f1+f30_w1()*f2+f30_w2()*f3+f30_w3()*f4
        +f30_w4()*f5+f30_w5()*f6+f30_w6()*f7+f30_w7()*f8;
    return pl_clamp(acc/1000+f30_bp(),0,1000);
}

// censor head: raw (unclamped) margin_t, round index t, exact nalive/nh
fn pl_censor(margin:i64,t:i32,nalive:i32,nh:i32)i64 {
    let depth_t:i64=1000-(t as i64)*1000/64;
    let surv:i64=1000;
    if(nalive>2){surv=(nalive as i64)*1000/(nh as i64);}
    let m:i64=margin;
    if(depth_t<m){m=depth_t;}
    if(surv<m){m=surv;}
    return pl_clamp(m+f30_bc(),0,1000);
}

fn pl_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"f30-thac");}
}

fn pl_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn pl_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn pl_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn pl_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

fn pl_run(items_path:[]u8,depth:i32,gate01:i32,res_path:[]u8)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(pl_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(pl_st_alloc(&st,68)!=0){pl_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let bnd:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    if(dout_init(&bnd,1048576)!=0){return 102;}
    dout_str(&bnd,"id\tdepth\tP\tCn\tbind01\n");
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    let l1:i32=au_get32(st.hist_l,1);
                    let lt:i32=au_get32(st.hist_l,t);
                    let rel:i32=-1;
                    let rconf:i32=0;
                    let rcode:i32=0;
                    if(lt==l1){
                        let f1:i64=0;let f2:i64=0;let f3:i64=0;let f4:i64=0;
                        let f5:i64=0;let f6:i64=0;let f7:i64=0;let f8:i64=0;
                        pl_features(&st,&it,t,&f1,&f2,&f3,&f4,&f5,&f6,&f7,&f8);
                        // F30 two-head composed confidence (suppress-only)
                        let pv:i64=pl_pred(f1,f2,f3,f4,f5,f6,f7,f8);
                        let mraw:i64=au_get64(st.hist_m,t);
                        let nalive:i32=dlb_nalive(&st,it.nh);
                        let cnv:i64=pl_censor(mraw,t,nalive,it.nh);
                        let cc:i64=pv;
                        if(cnv<cc){cc=cnv;}
                        rel=lt;
                        rconf=cc as i32;
                        rcode=1;
                        // sidecar: (P, Cn) for the censor bind-rate measurement
                        dout_str(&bnd,dj_id(&it));
                        dout_byte(&bnd,9);
                        dout_i64(&bnd,depth as i64);
                        dout_byte(&bnd,9);
                        dout_i64(&bnd,pv);
                        dout_byte(&bnd,9);
                        dout_i64(&bnd,cnv);
                        dout_byte(&bnd,9);
                        if(cnv<pv){dout_byte(&bnd,49);}
                        if(cnv>=pv){dout_byte(&bnd,48);}
                        dout_line(&bnd);
                    }
                    // emit (same columns as mech.zag)
                    dout_str(&res,dj_id(&it));
                    dout_byte(&res,9);
                    dout_i64(&res,depth as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,t as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.rounds as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.consumed as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,it.ne as i64);
                    dout_byte(&res,9);
                    if(rel<0){
                        dout_str(&res,"ABSTAIN:");
                        pl_cert(rcode,&res);
                    }
                    if(rel>=0){dout_str(&res,dj_hid(&it,rel));}
                    dout_byte(&res,9);
                    if(rel<0){dout_str(&res,"A");}
                    if(rel>=0){
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(&res,"1");}
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(&res,"0");}
                    }
                    dout_byte(&res,9);
                    dout_i64(&res,rconf as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,au_get32(st.hist_l,t) as i64);
                    dout_byte(&res,9);
                    pl_cert(rcode,&res);
                    dout_line(&res);
                    if(res.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                    if(bnd.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    let wrcb:i64=0;
    if(ok==1 && res.err==0 && bnd.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
        let bp2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&bp2,res_path.len+16)!=0){wrcb=-1;}
        if(wrcb==0){
            dout_str(&bp2,res_path);
            dout_str(&bp2,".bind.tsv");
            wrcb=dlb_write_file(dout_bytes(&bp2),dout_bytes(&bnd),bnd.n);
            dout_free(&bp2);
        }
    }
    nio_free(ibuf);
    pl_item_free(&it);
    pl_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    dout_free(&bnd);
    lg_free(&lg);
    if(ok==0 || wrc<0 || wrcb<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: policy_f30 <items.jsonl> <depth> <gate01> <results.tsv>");
        return 64;
    }
    let depth:i32=dlb_atoi(_zag_arg(2));
    let gate01:i32=dlb_atoi(_zag_arg(3));
    if(depth<1 || depth>64){return 64;}
    if(gate01!=0){return 64;}
    return pl_run(_zag_arg(1),depth,gate01,_zag_arg(4));
}

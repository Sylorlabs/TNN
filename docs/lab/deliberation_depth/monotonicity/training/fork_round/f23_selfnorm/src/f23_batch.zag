// f23_batch.zag — F23 SELFNORM batch eval driver.
//
// One invocation processes all 37 legs in leglist.tsv order, retaining
// per-item (M1,M4a) trailing-max state across depth legs (cross-leg,
// inclusive, released-cells-only — the frozen F23 mechanism).
//
// For each leg: runs the FROZEN deliberation harness (dlb_run) per item,
// computes f1..f8 via pl_features (frozen, copied from training/src/policy.zag),
// updates the item's trailing (M1,M4a) iff the harness RELEASES the item,
// forms f1',f4', and scores confidence with the FROZEN trained F23 head.
// Release/correct/cert columns use the M4 skeleton EXACTLY (B9 gate:
// 100% release+correct identity vs M4). gate01 N/A (F23 = conf head only).
//
// Output: one analyzer-compatible TSV per leg:
//   <outdir>/<battery>_m23_d<depth>_<AB>.tsv
// cols: id depth t rounds consumed ne release correct conf leader_idx cert
//
// Usage: f23_batch <leglist.tsv> <outdir> <AB>
// Pure Zag. Zero RNG. Deterministic. A/B byte-identical (modulo AB tag).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

// ---- F23 trained head (frozen; from params/f23_params_A.zag, A/B identical) ----
fn f23_w0()i64 { return 1256; }
fn f23_w1()i64 { return 256; }
fn f23_w2()i64 { return 0; }
fn f23_w3()i64 { return 0; }
fn f23_w4()i64 { return 256; }
fn f23_w5()i64 { return 256; }
fn f23_w6()i64 { return 0; }
fn f23_w7()i64 { return 192; }
fn f23_b()i64 { return 192; }

// ---- pl_features (frozen; copied verbatim from training/src/policy.zag) ----
fn f23_pl_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn f23_pl_features(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=f23_pl_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=f23_pl_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=f23_pl_clamp(maxdrop,0,1000);
}

// ---- F23 head ----
fn f23_tdiv(a:i64,b:i64)i64 {
    if(b==0){return 0;}
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn f23_head(f1p:i64,f2:i64,f3:i64,f4p:i64,f5:i64,f6:i64,f7:i64,f8:i64)i64 {
    let acc:i64=f23_w0()*f1p+f23_w1()*f2+f23_w2()*f3+f23_w3()*f4p
        +f23_w4()*f5+f23_w5()*f6+f23_w6()*f7+f23_w7()*f8;
    let c:i64=f23_tdiv(acc,1000)+f23_b();
    return f23_pl_clamp(c,0,1000);
}
fn f23_pl_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"trained-conf");}
    if(rcode==2){dout_str(res,"trained-conf+gate");}
    if(rcode==3){dout_str(res,"gate-lowconf");}
}

// ---- per-item trailing-max map (M1, M4a); 64-byte id slots ----
fn f23_bslot(id:[]u8,slots:[]u8,lens:[]u8,mm:[]u8,nslots:i32,nused:*i32)i32 {
    let i:i32=0;
    while(i<nused.*){
        if(au_get32(lens,i)==id.len){
            let base:i32=i*64;
            if(nio_equal(slots[base..base+id.len],id)==1){return i;}
        }
        i=i+1;
    }
    if(nused.*>=nslots){return -1;}
    let s:i32=nused.*;
    let base2:i32=s*64;
    let k:i32=0;
    while(k<id.len && k<64){slots[base2+k]=id[k];k=k+1;}
    au_put32(lens,s,id.len);
    au_put64(mm,s*2+0,0);
    au_put64(mm,s*2+1,0);
    nused.*=s+1;
    return s;
}

// ---- harness alloc helpers (from frozen policy.zag) ----
fn f23_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn f23_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn f23_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn f23_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

// process one leg: run harness per item, F23 conf, emit TSV rows.
// mm state (per-item M1/M4a) persists across legs.
fn f23_leg(items_path:[]u8,depth:i32,res:*DOut,
           slots:[]u8,lens:[]u8,mm:[]u8,nslots:i32,nused:*i32) i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(f23_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(f23_st_alloc(&st,68)!=0){f23_item_free(&it);nio_free(ibuf);return 102;}
    let lgo:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let lg:LG=LG{.seq=0,.prev="",.head=""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    let l1:i32=au_get32(st.hist_l,1);
                    let lt:i32=au_get32(st.hist_l,t);
                    let rel:i32=-1;
                    let rconf:i64=0;
                    let rcode:i32=0;
                    if(lt==l1){
                        // RELEASED (M4 skeleton, exactly as policy.zag)
                        let f1:i64=0;let f2:i64=0;let f3:i64=0;let f4:i64=0;
                        let f5:i64=0;let f6:i64=0;let f7:i64=0;let f8:i64=0;
                        f23_pl_features(&st,&it,t,&f1,&f2,&f3,&f4,&f5,&f6,&f7,&f8);
                        // trailing-max update (inclusive, released only)
                        let id:[]u8=dj_id(&it);
                        let s:i32=f23_bslot(id,slots,lens,mm,nslots,nused);
                        if(s<0){ok=0;}
                        if(s>=0){
                            let m1:i64=au_get64(mm,s*2+0);
                            let m4a:i64=au_get64(mm,s*2+1);
                            if(f1>m1){m1=f1;}
                            let af4:i64=f4;
                            if(af4<0){af4=-af4;}
                            if(af4>m4a){m4a=af4;}
                            au_put64(mm,s*2+0,m1);
                            au_put64(mm,s*2+1,m4a);
                            let d1:i64=m1;
                            if(d1<64){d1=64;}
                            let f1p:i64=(1000*f1)/d1;
                            if(f1p>1000){f1p=1000;}
                            let d4:i64=m4a;
                            if(d4<64){d4=64;}
                            let f4p:i64=f23_pl_clamp(f23_tdiv(1000*f4,d4),-1000,1000);
                            rconf=f23_head(f1p,f2,f3,f4p,f5,f6,f7,f8);
                        }
                        rel=lt;
                        rcode=1;
                    }
                    // emit (same 11 columns as mech.zag / policy.zag)
                    dout_str(res,dj_id(&it));
                    dout_byte(res,9);
                    dout_i64(res,depth as i64);
                    dout_byte(res,9);
                    dout_i64(res,t as i64);
                    dout_byte(res,9);
                    dout_i64(res,st.rounds as i64);
                    dout_byte(res,9);
                    dout_i64(res,st.consumed as i64);
                    dout_byte(res,9);
                    dout_i64(res,it.ne as i64);
                    dout_byte(res,9);
                    if(rel<0){
                        dout_str(res,"ABSTAIN:");
                        f23_pl_cert(rcode,res);
                    }
                    if(rel>=0){dout_str(res,dj_hid(&it,rel));}
                    dout_byte(res,9);
                    if(rel<0){dout_str(res,"A");}
                    if(rel>=0){
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(res,"1");}
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(res,"0");}
                    }
                    dout_byte(res,9);
                    dout_i64(res,rconf);
                    dout_byte(res,9);
                    dout_i64(res,au_get32(st.hist_l,t) as i64);
                    dout_byte(res,9);
                    f23_pl_cert(rcode,res);
                    dout_line(res);
                    if(res.*.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    nio_free(ibuf);
    f23_item_free(&it);
    f23_st_free(&st);
    dout_free(&lgo);
    lg_free(&lg);
    if(ok==0){return 103;}
    return errs;
}

// main: read leglist, process legs in order, write per-leg TSVs.
fn f23_batch(leg_path:[]u8,outdir:[]u8,ab:[]u8)i32 {
    let lbuf:[]u8=nio_alloc(65536);
    if(lbuf.len==0){return 101;}
    let nr:i64=dlb_read_file(leg_path,lbuf);
    if(nr<0){nio_free(lbuf);return 102;}
    let n:i32=nr as i32;
    // per-item trailing-max state: 1200 slots (1000 unique ids)
    let nslots:i32=1200;
    let slots:[]u8=nio_alloc(nslots*64);
    let lens:[]u8=nio_alloc(nslots*4);
    let mm:[]u8=nio_alloc(nslots*16);
    if(slots.len==0 || lens.len==0 || mm.len==0){return 103;}
    let wi:i32=0;
    while(wi<nslots){au_put32(lens,wi,0);au_put64(mm,wi*2+0,0);au_put64(mm,wi*2+1,0);wi=wi+1;}
    let nused:i32=0;
    let pos:i32=0;
    let nlegs:i32=0;
    while(pos<n){
        let e:i32=pos;
        while(e<n && lbuf[e]!=10){e=e+1;}
        if(e>pos){
            let line:[]u8=lbuf[pos..e];
            // 3 cols: battery \t items_path \t depth
            let t1:i32=-1;
            let t2:i32=-1;
            let k:i32=0;
            while(k<line.len){
                if(line[k]==9){
                    if(t1<0){t1=k;}
                    else if(t2<0){t2=k;}
                }
                k=k+1;
            }
            if(t1>0 && t2>t1){
                let battery:[]u8=line[0..t1];
                let ipath:[]u8=line[t1+1..t2];
                let depth:i32=dlb_atoi(line[t2+1..line.len]);
                // out path: <outdir>/<battery>_m23_d<depth>_<AB>.tsv
                let ob:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                if(dout_init(&ob,4096)!=0){return 104;}
                dout_str(&ob,outdir);
                dout_byte(&ob,47);
                dout_str(&ob,battery);
                dout_str(&ob,"_m23_d");
                dout_i64(&ob,depth as i64);
                dout_str(&ob,"_");
                dout_str(&ob,ab);
                dout_str(&ob,".tsv");
                let opath:[]u8=dout_bytes(&ob);
                // process leg into a fresh DOut
                let res:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
                if(dout_init(&res,4194304)!=0){return 104;}
                let erc:i32=f23_leg(ipath,depth,&res,slots,lens,mm,nslots,&nused);
                let wrc:i64=-1;
                if(erc>=0 && res.err==0){
                    wrc=dlb_write_file(opath,dout_bytes(&res),res.n);
                }
                dout_free(&res);
                dout_free(&ob);
                if(erc<0 || wrc<0){return 105;}
                nlegs=nlegs+1;
            }
        }
        pos=e+1;
    }
    nio_free(lbuf);
    nio_free(slots);nio_free(lens);nio_free(mm);
    if(nlegs!=37){return 106;}
    _zag_println("f23_batch done");
    return 0;
}

fn main()i32 {
    // NOTE: _zag_argc() is 0 per ZNC-2026-09-21-007; read args unconditionally.
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    if(a1.len==0 || a2.len==0 || a3.len==0){
        _zag_println("usage: f23_batch <leglist.tsv> <outdir> <AB>");
        return 64;
    }
    return f23_batch(a1,a2,a3);
}

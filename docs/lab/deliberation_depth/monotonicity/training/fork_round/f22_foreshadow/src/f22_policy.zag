// f22_policy.zag — F22 FORESHADOW evaluation driver.
//
// Runs the FROZEN harness deliberation (byte-identical dlb_*.zag copies)
// at a fixed depth per item, then applies the TRAINED F22 foreshadow head:
//   f9 = clamp(1000 − tdiv(α(1000−f1)+β·f3+γ(1000−f6)+δ·f8,1000), 0, 1000)
//   C  = clamp(tdiv(Σ w_i·f_i,1000) + b − tdiv(w9·(1000−f9),1000), 0, 1000)
// Release: M4 skeleton UNTOUCHED (release L_t iff L_t == L_1, else ABSTAIN).
// Confidence never gates release. gate01 arg accepted but ignored (MT-CONF).
//
// Params: per-(family, depth) table in f22_params.zag (generated by
// f22_train.zag). Family: from items-path substring for the 6 batteries;
// per-item id parse (H5B-D/O/P-…) for the ceiling battery.
//
// Usage: f22_policy <items.jsonl> <depth> <gate01> <results.tsv>
// Per-item TSV record: identical columns to mech.zag:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("f22_params.zag")

fn f22_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn f22_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// substring search; 1 if needle in haystack
fn f22_contains(hay:[]u8,ndl:[]u8)i32 {
    if(ndl.len>hay.len){return 0;}
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        if(nio_equal(hay[i..i+ndl.len],ndl)==1){return 1;}
        i=i+1;
    }
    return 0;
}

// family from items path:
// 0=admit 1=revoke 2=logic 3=trap 4=cost 5=redteam 9=ceiling(per-item)
fn f22_path_fam(path:[]u8)i32 {
    if(f22_contains(path,"ceiling")==1){return 9;}
    if(f22_contains(path,"redteam")==1){return 5;}
    if(f22_contains(path,"admit")==1){return 0;}
    if(f22_contains(path,"revoke")==1){return 1;}
    if(f22_contains(path,"logic")==1){return 2;}
    if(f22_contains(path,"trap")==1){return 3;}
    if(f22_contains(path,"cost")==1){return 4;}
    return 9;
}

// per-item family: path family, except ceiling battery -> id sub-family.
// 6=D 7=O 8=P 9=other(global fallback).
fn f22_item_fam(pathfam:i32,id:[]u8)i32 {
    if(pathfam!=9){return pathfam;}
    if(id.len>=6 && id[0]==72 && id[1]==53 && id[2]==66 && id[3]==45){
        let c:u8=id[4];
        if(c==68){return 6;}
        if(c==79){return 7;}
        if(c==80){return 8;}
    }
    return 9;
}
fn f22_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// §4 features (index-level only), flat out-params — copied from policy.zag
fn f22_features(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=f22_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=f22_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=f22_clamp(maxdrop,0,1000);
}

// F22 foreshadow confidence. Integer sequence identical to f22_train.zag.
fn f22_conf(fam:i32,ds:i32,f1:i64,f2:i64,f3:i64,f4:i64,f5:i64,f6:i64,f7:i64,f8:i64)i32 {
    let h:i64=f22_al(fam,ds)*(1000-f1)+f22_be(fam,ds)*f3
        +f22_ga(fam,ds)*(1000-f6)+f22_de(fam,ds)*f8;
    let f9:i64=f22_clamp(1000-f22_tdiv(h,1000),0,1000);
    let acc:i64=f22_w1(fam,ds)*f1+f22_w2(fam,ds)*f2+f22_w3(fam,ds)*f3
        +f22_w4(fam,ds)*f4+f22_w5(fam,ds)*f5+f22_w6(fam,ds)*f6
        +f22_w7(fam,ds)*f7+f22_w8(fam,ds)*f8;
    let c:i64=f22_tdiv(acc,1000)+f22_b(fam,ds)
        -f22_tdiv(f22_w9(fam,ds)*(1000-f9),1000);
    return f22_clamp(c,0,1000) as i32;
}

fn f22_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"trained-conf");}
    if(rcode==2){dout_str(res,"trained-conf+gate");}
    if(rcode==3){dout_str(res,"gate-lowconf");}
}

fn f22_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn f22_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn f22_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn f22_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

fn f22_run(items_path:[]u8,depth:i32,res_path:[]u8)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(f22_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(f22_st_alloc(&st,68)!=0){f22_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pathfam:i32=f22_path_fam(items_path);
    let ds:i32=f22_dslot(depth);
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    let l1:i32=au_get32(st.hist_l,1);
                    let lt:i32=au_get32(st.hist_l,t);
                    let rel:i32=-1;
                    let rconf:i32=0;
                    let rcode:i32=0;
                    if(lt==l1){
                        let f1:i64=0;let f2:i64=0;let f3:i64=0;let f4:i64=0;
                        let f5:i64=0;let f6:i64=0;let f7:i64=0;let f8:i64=0;
                        f22_features(&st,&it,t,&f1,&f2,&f3,&f4,&f5,&f6,&f7,&f8);
                        rel=lt;
                        rconf=f22_conf(f22_item_fam(pathfam,dj_id(&it)),ds,f1,f2,f3,f4,f5,f6,f7,f8);
                        rcode=1;
                    }
                    // emit (same columns as mech.zag)
                    dout_str(&res,dj_id(&it));
                    dout_byte(&res,9);
                    dout_i64(&res,depth as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,t as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.rounds as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.consumed as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,it.ne as i64);
                    dout_byte(&res,9);
                    if(rel<0){
                        dout_str(&res,"ABSTAIN:");
                        f22_cert(rcode,&res);
                    }
                    if(rel>=0){dout_str(&res,dj_hid(&it,rel));}
                    dout_byte(&res,9);
                    if(rel<0){dout_str(&res,"A");}
                    if(rel>=0){
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(&res,"1");}
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(&res,"0");}
                    }
                    dout_byte(&res,9);
                    dout_i64(&res,rconf as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,au_get32(st.hist_l,t) as i64);
                    dout_byte(&res,9);
                    f22_cert(rcode,&res);
                    dout_line(&res);
                    if(res.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
    }
    nio_free(ibuf);
    f22_item_free(&it);
    f22_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    lg_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: f22_policy <items.jsonl> <depth> <gate01> <results.tsv>");
        return 64;
    }
    let depth:i32=dlb_atoi(_zag_arg(2));
    let gate01:i32=dlb_atoi(_zag_arg(3));
    if(depth<1 || depth>64){return 64;}
    if(gate01<0 || gate01>1){return 64;}
    return f22_run(_zag_arg(1),depth,_zag_arg(4));
}

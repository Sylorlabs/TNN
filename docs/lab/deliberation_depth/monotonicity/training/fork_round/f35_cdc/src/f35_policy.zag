// f35_policy.zag — F35 CDC batch eval driver (pure Zag, zero RNG).
//
// usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>
//
// Loads frozen params, streams features.tsv + cellmap.tsv in lockstep (both
// frozen order), emits all 37 leg TSVs in one run. Release/correctness and
// all non-confidence columns are M4-identical (copied from cellmap); only
// the confidence column differs (CDC emit). Heldout rows never update state.
//
// Output files: <outdir>/<battery>_m35_d<depth>_<tag>.tsv  (37 legs)
//   batteries: admit revoke logic trap cost redteam (d=1,2,4,8,16),
//              ceiling (d=1,2,4,8,16,32,64).
//
// Exit codes: 0 ok; 64 usage; 7x IO/alloc; 8x data-order violations.

@import("f35_common.zag")

fn f35_copy(out:[]u8,at:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        out[at+i]=s[i];
        i=i+1;
    }
    return at+s.len;
}

fn f35_batname(bat:i32)[]u8 {
    if(bat==0){let s:[]u8="admit";return s;}
    if(bat==1){let s:[]u8="revoke";return s;}
    if(bat==2){let s:[]u8="logic";return s;}
    if(bat==3){let s:[]u8="trap";return s;}
    if(bat==4){let s:[]u8="cost";return s;}
    if(bat==5){let s:[]u8="redteam";return s;}
    let s:[]u8="ceiling";return s;
}

fn f35_leg_depth(leg:i32)i64 {
    if(leg<30){
        let d:i32=leg%5;
        if(d==0){return 1;}
        if(d==1){return 2;}
        if(d==2){return 4;}
        if(d==3){return 8;}
        return 16;
    }
    let d2:i32=leg-30;
    if(d2==0){return 1;}
    if(d2==1){return 2;}
    if(d2==2){return 4;}
    if(d2==3){return 8;}
    if(d2==4){return 16;}
    if(d2==5){return 32;}
    return 64;
}

fn f35_leg_bat(leg:i32)i32 {
    if(leg<30){return leg/5;}
    return 6;
}

fn f35_leg(bat:i32,didx:i32)i32 {
    if(bat<6){return bat*5+didx;}
    return 30+didx;
}

// build "<outdir>/<bat>_m35_d<depth>_<tag>.tsv" into out; returns length.
fn f35_legname(out:[]u8,outdir:[]u8,leg:i32,tag:[]u8)i32 {
    let n:i32=f35_copy(out,0,outdir);
    out[n]=47;n=n+1;
    n=f35_copy(out,n,f35_batname(f35_leg_bat(leg)));
    let m:[]u8="_m35_d";n=f35_copy(out,n,m);
    let ds:[]u8=dlb_i64s(f35_leg_depth(leg));
    n=f35_copy(out,n,ds);
    nio_free(ds);
    out[n]=95;n=n+1;
    n=f35_copy(out,n,tag);
    let e:[]u8=".tsv";n=f35_copy(out,n,e);
    return n;
}

// appending write of n bytes (O_WRONLY|O_CREAT|O_APPEND). Returns n or negative.
fn f35_append_file(p:[]u8,data:[]u8,n:i32)i64 {
    if(n<0 || n>data.len){return -21;}
    if(n==0){return 0;}
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir);nio_free(name);return -11;}
    let sp:i64=dlb_split_dir(p,dir,name);
    if(sp<0){
        dir[0]=46;
        if(p.len>name.len){nio_free(dir);nio_free(name);return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k];k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir);nio_free(name);return -13;}
    let cs:[]u8=nio_cstr(name[0..nl]);
    if(cs.len==0){let crc0:i64=nio_close(root);nio_free(dir);nio_free(name);return -16;}
    // O_WRONLY|O_CREAT|O_APPEND|O_CLOEXEC|O_NOFOLLOW = 1+64+1024+524288+131072
    let fd:i64=_zag_raw_syscall(257,root,_zag_slice_ptr(cs) as i64,656449,384,0,0);
    nio_free(cs);
    let crc:i64=nio_close(root);
    if(fd<0){nio_free(dir);nio_free(name);return -17;}
    let rc:i64=nio_write_all(fd,data[0..n]);
    let cr:i64=nio_close(fd);
    nio_free(dir);nio_free(name);
    if(crc!=0){return -18;}
    if(cr!=0){return -18;}
    if(rc!=n){return -19;}
    return n as i64;
}

// parse frozen params; fills proto/kc/nc/tr; returns K or negative on error.
fn f35_parse_params(pbuf:[]u8,pn:i32,proto:[]u8,kc:[]u8,nc:[]u8,tr:[]u8)i32 {
    let pos:i32=0;
    let lno:i32=0;
    let K:i32=-1;
    let sec:i32=0;
    let cnt:i32=0;
    let rc:i32=0;
    while(pos<pn && rc==0){
        let e:i32=pos;
        while(e<pn && pbuf[e]!=10){e=e+1;}
        let line:[]u8=pbuf[pos..e];
        pos=e+1;
        if(line.len>0){
            if(sec==0){
                if(lno==0){
                    if(dlb_streq(line,"F35CDC-PARAMS-v1")!=1){rc=-1;}
                }
                if(lno==1){
                    if(dlb_streq(f35_field(line,0),"K")!=1){rc=-2;}
                    else {
                        K=f35_atoi64(f35_field(line,1)) as i32;
                        if(K<1 || K>64){rc=-3;}
                    }
                }
                if(lno==2){
                    if(f35_atoi64(f35_field(line,1))!=8){rc=-4;}
                }
                if(dlb_streq(line,"PROTOTYPES")==1){
                    if(K<0){rc=-5;}
                    else {sec=1;cnt=0;}
                }
            }
            else {
                if(sec==1){
                    if(dlb_streq(line,"RHO")==1){
                        if(cnt!=K){rc=-7;}
                        else {sec=2;cnt=0;}
                    }
                    else {
                        if(cnt>=K){rc=-6;}
                        else {
                            if(f35_atoi64(f35_field(line,0))!=(cnt as i64)){rc=-6;}
                            else {
                                au_put64(proto,((cnt*5+0) as i64),f35_atoi64(f35_field(line,2)));
                                au_put64(proto,((cnt*5+1) as i64),f35_atoi64(f35_field(line,3)));
                                au_put64(proto,((cnt*5+2) as i64),f35_atoi64(f35_field(line,4)));
                                au_put64(proto,((cnt*5+3) as i64),f35_atoi64(f35_field(line,5)));
                                au_put64(proto,((cnt*5+4) as i64),f35_atoi64(f35_field(line,6)));
                                cnt=cnt+1;
                            }
                        }
                    }
                }
                else {
                    if(sec==2){
                        if(dlb_streq(line,"TRANSITIONS")==1){
                            if(cnt!=K){rc=-9;}
                            else {sec=3;cnt=0;}
                        }
                        else {
                            if(cnt>=K){rc=-8;}
                            else {
                                if(f35_atoi64(f35_field(line,0))!=(cnt as i64)){rc=-8;}
                                else {
                                    au_put64(kc,(cnt as i64),f35_atoi64(f35_field(line,1)));
                                    au_put64(nc,(cnt as i64),f35_atoi64(f35_field(line,2)));
                                    cnt=cnt+1;
                                }
                            }
                        }
                    }
                    else {
                        if(sec==3){
                            if(cnt>=K*6){rc=-11;}
                            else {
                                let ix3:i32=f35_atoi64(f35_field(line,0)) as i32;
                                let jx:i32=f35_atoi64(f35_field(line,1)) as i32;
                                if(ix3!=cnt/6 || jx!=cnt%6){rc=-10;}
                                else {
                                    let tb:i64=((((ix3*6+jx)*6)) as i64);
                                    au_put64(tr,tb+0,f35_atoi64(f35_field(line,2)));
                                    au_put64(tr,tb+1,f35_atoi64(f35_field(line,3)));
                                    au_put64(tr,tb+2,f35_atoi64(f35_field(line,4)));
                                    au_put64(tr,tb+3,f35_atoi64(f35_field(line,5)));
                                    au_put64(tr,tb+4,f35_atoi64(f35_field(line,6)));
                                    au_put64(tr,tb+5,f35_atoi64(f35_field(line,7)));
                                    cnt=cnt+1;
                                }
                            }
                        }
                        else {rc=-13;}
                    }
                }
            }
        }
        lno=lno+1;
    }
    if(rc!=0){return rc;}
    if(sec!=3 || cnt!=K*6){return -12;}
    return K;
}

// build a released row: cellmap fields with conf replaced; returns length.
fn f35_build_row(rowbuf:[]u8,cmline:[]u8,conf:i64)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<11){
        if(k==8){
            let cs:[]u8=dlb_i64s(conf);
            n=f35_copy(rowbuf,n,cs);
            nio_free(cs);
        }
        else {
            n=f35_copy(rowbuf,n,f35_field(cmline,k));
        }
        if(k<10){rowbuf[n]=9;n=n+1;}
        k=k+1;
    }
    rowbuf[n]=10;n=n+1;
    return n;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    let a5:[]u8=_zag_arg(5);
    if(a1.len==0){_zag_println("usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>");return 64;}
    if(a2.len==0){_zag_println("usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>");return 64;}
    if(a3.len==0){_zag_println("usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>");return 64;}
    if(a4.len==0){_zag_println("usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>");return 64;}
    if(a5.len==0){_zag_println("usage: f35_policy <features.tsv> <params.txt> <cellmap.tsv> <outdir> <tag>");return 64;}

    let fbuf:[]u8=nio_alloc(4194304);
    let pbuf:[]u8=nio_alloc(262144);
    let cbuf:[]u8=nio_alloc(4194304);
    if(cbuf.len==0){return 71;}
    let fnr:i64=dlb_read_file(a1,fbuf);
    if(fnr<0){_zag_println("read features failed");return 72;}
    let pnr:i64=dlb_read_file(a2,pbuf);
    if(pnr<0){_zag_println("read params failed");return 72;}
    let cnr:i64=dlb_read_file(a3,cbuf);
    if(cnr<0){_zag_println("read cellmap failed");return 72;}
    let fbytes:i32=fnr as i32;
    let cbytes:i32=cnr as i32;

    let proto:[]u8=nio_alloc(64*5*8);
    let kc:[]u8=nio_alloc(64*8);
    let nc:[]u8=nio_alloc(64*8);
    let tr:[]u8=nio_alloc(64*6*6*8);
    if(tr.len==0){return 71;}
    let K:i32=f35_parse_params(pbuf,pnr as i32,proto,kc,nc,tr);
    if(K<0){
        _zag_println("params parse failed");
        return 77;
    }

    // per-item inference state
    let idlen:[]u8=nio_alloc(2048*8);
    let idbuf:[]u8=nio_alloc(2048*64);
    let c_depth:[]u8=nio_alloc(2048*8);
    let c_rel:[]u8=nio_alloc(2048*8);
    let c_clu:[]u8=nio_alloc(2048*8);
    let c_C:[]u8=nio_alloc(2048*8);
    let c_cor:[]u8=nio_alloc(2048*8);
    let r_depth:[]u8=nio_alloc(2048*8);
    let r_clu:[]u8=nio_alloc(2048*8);
    let r_C:[]u8=nio_alloc(2048*8);
    let r_cor:[]u8=nio_alloc(2048*8);
    let r_f5:[]u8=nio_alloc(2048*8);
    let r_my:[]u8=nio_alloc(2048*8);
    let r_f8d1:[]u8=nio_alloc(2048*8);
    let r_Cstar:[]u8=nio_alloc(2048*8);
    if(r_Cstar.len==0){return 71;}
    let nitems:i32=0;

    // precompute 37 leg paths; truncate each
    let legbuf:[]u8=nio_alloc(37*512);
    let leglen:[]u8=nio_alloc(37*8);
    if(leglen.len==0){return 71;}
    let li:i32=0;
    while(li<37){
        let nb:i32=f35_legname(legbuf[(li*512)..(li*512+512)],a4,li,a5);
        au_put64(leglen,(li as i64),(nb as i64));
        if(dlb_write_file(legbuf[(li*512)..(li*512+nb)],legbuf[(li*512)..(li*512)],0)<0){
            _zag_println("truncate leg failed");
            return 74;
        }
        li=li+1;
    }

    let rowbuf:[]u8=nio_alloc(4096);
    let namebuf:[]u8=nio_alloc(512);
    if(namebuf.len==0){return 71;}

    // ---- lockstep stream ----
    let fp:i32=0;
    let cp:i32=0;
    let rc:i32=0;
    let nrows:i64=0;
    while(fp<fbytes && cp<cbytes){
        if(rc!=0){fp=fbytes;}
        else {
        let fe:i32=fp;
        while(fe<fbytes && fbuf[fe]!=10){fe=fe+1;}
        let ce:i32=cp;
        while(ce<cbytes && cbuf[ce]!=10){ce=ce+1;}
        let fline:[]u8=fbuf[fp..fe];
        let cmline:[]u8=cbuf[cp..ce];
        fp=fe+1;
        cp=ce+1;
        if(fline.len==0 || cmline.len==0){rc=87;}
        else {
        nrows=nrows+1;
        let id:[]u8=f35_field(fline,0);
        let family:[]u8=f35_field(fline,1);
        // lockstep identity: (id, depth) must match
        if(dlb_streq(id,f35_field(cmline,0))!=1){rc=88;}
        if(dlb_streq(f35_field(fline,3),f35_field(cmline,1))!=1){rc=89;}
        if(rc==0){
        let depth:i64=f35_atoi64(f35_field(fline,3));
        let didx:i32=f35_didx(depth);
        let bat:i32=f35_battery(family);
        if(didx<0 || bat<0){rc=81;}
        else {
        let leg:i32=f35_leg(bat,didx);
        // Note: heldout rows ARE processed for output (they're part of the
        // 5,240 cells); they just don't affect frozen params (already frozen).
        // Per-item state is maintained per item (heldout is per-item).
        let rf:[]u8=f35_field(fline,5);
        let rel:i32=0;
        if(rf.len>0 && rf[0]==49){rel=1;}
            if(rel==1){
                let f1:i64=f35_atoi64(f35_field(fline,7));
                let f3:i64=f35_atoi64(f35_field(fline,9));
                let f5:i64=f35_atoi64(f35_field(fline,11));
                let f6:i64=f35_atoi64(f35_field(fline,12));
                let f8:i64=f35_atoi64(f35_field(fline,14));
                let cf:[]u8=f35_field(fline,6);
                let correct:i64=-1;
                if(cf.len>0 && cf[0]==48){correct=0;}
                if(cf.len>0 && cf[0]==49){correct=1;}
                if(correct<0){rc=82;}
                let si:i32=f35_slot_find(id,idlen,idbuf,nitems);
                if(si<0){
                    if(nitems>=2048){rc=84;}
                    else {
                        si=f35_slot_new(id,idlen,idbuf,nitems);
                        nitems=nitems+1;
                    }
                }
                if(rc==0){
                let sis:i64=si as i64;
                let pd:i64=au_get64(c_depth,sis);
                if(depth==1){
                    if(pd!=0){rc=85;}
                }
                else {
                    if(pd!=depth/2){rc=86;}
                }
                if(rc==0){
                let has_prev:i32=0;
                let d_prev:i64=0;
                let f5_prev:i64=0;
                if(au_get64(r_depth,sis)>0){
                    has_prev=1;
                    d_prev=au_get64(r_depth,sis);
                    f5_prev=au_get64(r_f5,sis);
                }
                let my:i64=f35_my(depth,f5,has_prev,d_prev,f5_prev);
                let x3:i64=f8;
                if(x3>1000){x3=1000;}
                let dd:i64=0;
                let c:i32=f35_assign(proto,K,f1,f5,f6,x3,my,&dd);
                let Cstar:i64=0;
                let f8d1:i64=0;
                if(depth==1){
                    Cstar=f35_rho(au_get64(kc,(c as i64)),au_get64(nc,(c as i64)));
                    f8d1=f8;
                }
                else {
                    Cstar=au_get64(r_Cstar,sis);
                    f8d1=au_get64(r_f8d1,sis);
                }
                let hp2:i32=0;
                if(au_get64(r_depth,sis)>0){hp2=1;}
                let C:i64=f35_emit(Cstar,c,didx,tr,f3,f8,f8d1,hp2,
                    au_get64(r_clu,sis) as i32,au_get64(r_C,sis),my,au_get64(r_my,sis));
                au_put64(c_depth,sis,depth);
                au_put64(c_rel,sis,1);
                au_put64(c_clu,sis,(c as i64));
                au_put64(c_C,sis,C);
                au_put64(c_cor,sis,correct);
                au_put64(r_depth,sis,depth);
                au_put64(r_clu,sis,(c as i64));
                au_put64(r_C,sis,C);
                au_put64(r_cor,sis,correct);
                au_put64(r_f5,sis,f5);
                au_put64(r_my,sis,my);
                if(depth==1){
                    au_put64(r_f8d1,sis,f8);
                    au_put64(r_Cstar,sis,Cstar);
                }
                let rn:i32=f35_build_row(rowbuf,cmline,C);
                let ll:i64=au_get64(leglen,(leg as i64));
                let lli:i32=ll as i32;
                let nl2:i32=f35_copy(namebuf,0,legbuf[(leg*512)..(leg*512+lli)]);
                if(f35_append_file(namebuf[0..nl2],rowbuf,rn)<0){rc=76;}
                }
                }
            }
            else {
                // abstained: cellmap row verbatim (conf already 0)
                let rn2:i32=f35_copy(rowbuf,0,cmline);
                rowbuf[rn2]=10;rn2=rn2+1;
                let ll2:i64=au_get64(leglen,(leg as i64));
                let lli2:i32=ll2 as i32;
                let nl3:i32=f35_copy(namebuf,0,legbuf[(leg*512)..(leg*512+lli2)]);
                if(f35_append_file(namebuf[0..nl3],rowbuf,rn2)<0){rc=76;}
            }
        }
        }
        }
        }
    }
    if(rc!=0){return rc;}
    if(fp<fbytes || cp<cbytes){_zag_println("stream length mismatch");return 90;}

    // summary
    _zag_println("f35_policy done");
    return 0;
}

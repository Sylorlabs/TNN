// f34_train.zag — F34 LSTWBA training driver.
//
// Runs the worst-boundary adversary controller over frozen
// training/features/features.tsv (heldout=0 rows, file order, repeated
// passes) until taxes settle (500 consecutive released items, zero tax
// change) or 10^4 released items. Writes params.bin (deterministic LE
// serialization) + human-readable train.log.
//
// Usage: f34_train <features.tsv> <params_out.bin> <train.log>
// Exit: 0 ok (settled, kill b not fired); 11 kill(a) taxes never settled;
//   12 kill(b) post-hoc: region with g[d]-g[d-1]>0 at n>=30 after settle;
//   64 usage; 7x data errors.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("f34_mech.zag")

fn ft_split(line:[]u8,fo:[]u8)i32 {
    let n:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<=line.len){
        if(i==line.len || line[i]==9){
            au_put64(fo,(n*2) as i64,s as i64);
            au_put64(fo,(n*2+1) as i64,(i-s) as i64);
            n=n+1;
            s=i+1;
            if(n>=16){break;}
        }
        i=i+1;
    }
    return n;
}
fn ft_int(line:[]u8,fo:[]u8,f:i32)i64 {
    let off:i64=au_get64(fo,(f*2) as i64);
    let ln:i64=au_get64(fo,(f*2+1) as i64);
    let o:i32=off as i32;
    return dlb_atoi(line[o..o+(ln as i32)]) as i64;
}
fn ft_field(line:[]u8,fo:[]u8,f:i32)[]u8 {
    let off:i64=au_get64(fo,(f*2) as i64);
    let ln:i64=au_get64(fo,(f*2+1) as i64);
    let o:i32=off as i32;
    return line[o..o+(ln as i32)];
}

fn ft_log_tax(lgo:*DOut,ctl:[]u8)void {
    let r:i32=0;
    while(r<15){
        dout_str(lgo,"T[r");
        dout_i64(lgo,r as i64);
        dout_str(lgo,"]=");
        let d:i32=0;
        while(d<7){
            if(d>0){dout_str(lgo,",");}
            dout_i64(lgo,au_get64(ctl,f34_o_tax(d as i64,r as i64)));
            d=d+1;
        }
        let fr:i64=au_get64(ctl,f34_o_frz(r as i64));
        dout_str(lgo," frz=");
        dout_i64(lgo,fr);
        dout_str(lgo," n1=");
        dout_i64(lgo,au_get64(ctl,f34_o_rn(r as i64)));
        dout_str(lgo," k1=");
        dout_i64(lgo,au_get64(ctl,f34_o_rk(r as i64)));
        dout_line(lgo);
        r=r+1;
    }
}

fn main()i32 {
    let p_tsv:[]u8=_zag_arg(1);
    let p_par:[]u8=_zag_arg(2);
    let p_log:[]u8=_zag_arg(3);
    if(p_tsv.len==0 || p_par.len==0 || p_log.len==0){
        _zag_println("usage: f34_train <features.tsv> <params_out.bin> <train.log>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(p_tsv,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let fo:[]u8=nio_alloc(256);
    if(fo.len==0){nio_free(ibuf);return 102;}
    let ctl:[]u8=nio_alloc((495*8) as i32);
    if(ctl.len==0){nio_free(ibuf);nio_free(fo);return 102;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,1048576)!=0){return 102;}
    dout_str(&lgo,"F34 LSTWBA training log\n");

    let released:i64=0;
    let streak:i64=0;
    let pass:i32=0;
    let done:i32=0;
    let killcode:i32=0;
    let totrows:i64=0;
    let trainrows:i64=0;
    while(done==0){
        pass=pass+1;
        dout_str(&lgo,"pass ");
        dout_i64(&lgo,pass as i64);
        dout_line(&lgo);
        let have_cur:i32=0;
        let cur_id:[]u8="";
        let cur_r:i32=0;
        let cur_cstar:i64=0;
        let cur_cprev:i64=0;
        let cur_f8d1:i64=0;
        let cur_f3prev:i64=0;
        let cur_f8prev:i64=0;
        let pos:i32=0;
        while(pos<blen && done==0 && killcode==0){
            let e:i32=pos;
            while(e<blen && ibuf[e]!=10){e=e+1;}
            let line:[]u8=ibuf[pos..e];
            if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
            if(line.len>0){
                totrows=totrows+1;
                let nf:i32=ft_split(line,fo);
                if(nf<15){nio_free(ibuf);nio_free(fo);return 70;}
                let heldout:i64=ft_int(line,fo,2);
                if(heldout==0){
                    trainrows=trainrows+1;
                    let depth:i64=ft_int(line,fo,3);
                    let idf:[]u8=ft_field(line,fo,0);
                    let is_new:i32=0;
                    if(have_cur==0){is_new=1;}
                    if(have_cur==1){
                        if(dlb_streq(idf,cur_id)!=1){is_new=1;}
                    }
                    if(is_new==1){
                        if(depth!=1){nio_free(ibuf);nio_free(fo);return 71;}
                        let f1:i64=ft_int(line,fo,7);
                        let f5:i64=ft_int(line,fo,11);
                        let f8:i64=ft_int(line,fo,14);
                        let r:i32=f34_region(f1,f5);
                        let kr:i64=au_get64(ctl,f34_o_rk(r as i64));
                        let nr:i64=au_get64(ctl,f34_o_rn(r as i64));
                        cur_r=r;
                        cur_cstar=f34_rho(kr,nr);
                        cur_cprev=0;
                        cur_f8d1=f8;
                        cur_f3prev=0;
                        cur_f8prev=0;
                        cur_id=idf;
                        have_cur=1;
                    }else{
                        if(depth==1){nio_free(ibuf);nio_free(fo);return 72;}
                    }
                    let d:i32=f34_didx(depth);
                    if(d<0){nio_free(ibuf);nio_free(fo);return 73;}
                    let rel:i64=ft_int(line,fo,5);
                    let f3:i64=ft_int(line,fo,9);
                    let f8b:i64=ft_int(line,fo,14);
                    let c:i64=f34_emit(ctl,cur_r,d,cur_cstar,f3,f8b,cur_f8d1,cur_f3prev,cur_f8prev,cur_cprev);
                    cur_cprev=c;
                    cur_f3prev=f3;
                    cur_f8prev=f8b;
                    if(rel==1){
                        let c4:[]u8=ft_field(line,fo,6);
                        let y:i64=0;
                        if(c4.len>0 && c4[0]==49){y=1;}
                        let frz0:i64=au_get64(ctl,f34_o_frz(cur_r as i64));
                        let chg:i64=0;
                        f34_update(ctl,cur_r,d,c,y,&chg);
                        let frz1:i64=au_get64(ctl,f34_o_frz(cur_r as i64));
                        if(frz0==0 && frz1==1){
                            dout_str(&lgo,"freeze r=");
                            dout_i64(&lgo,cur_r as i64);
                            dout_str(&lgo," at released #");
                            dout_i64(&lgo,released+1);
                            dout_line(&lgo);
                        }
                        released=released+1;
                        if(chg==1){streak=0;}else{streak=streak+1;}
                        if(streak>=500){done=1;}
                        if(released>=10000){
                            done=1;
                            if(streak<500){killcode=1;}
                        }
                    }
                }
            }
            pos=e+1;
        }
    }
    // Post-hoc kill-bar (b): after taxes stop changing for 500 released
    // items, does any region still have g[d]-g[d-1] > 0 on a cell n>=30?
    let kb_post:i32=f34_killb_check(ctl);
    if(kb_post==1){killcode=2;}
    dout_str(&lgo,"passes=");
    dout_i64(&lgo,pass as i64);
    dout_str(&lgo," totrows=");
    dout_i64(&lgo,totrows);
    dout_str(&lgo," trainrows=");
    dout_i64(&lgo,trainrows);
    dout_str(&lgo," released=");
    dout_i64(&lgo,released);
    dout_str(&lgo," final_streak=");
    dout_i64(&lgo,streak);
    dout_str(&lgo," killcode=");
    dout_i64(&lgo,killcode as i64);
    dout_line(&lgo);
    ft_log_tax(&lgo,ctl);
    // params
    let pbuf:[]u8=nio_alloc(4096);
    if(pbuf.len==0){return 102;}
    let wn:i64=f34_save(ctl,pbuf);
    if(wn<0){return 102;}
    let wrc:i64=dlb_write_file(p_par,pbuf,wn as i32);
    if(wrc<0){return 103;}
    let lrc:i64=dlb_write_file(p_log,dout_bytes(&lgo),lgo.n);
    nio_free(ibuf);
    nio_free(fo);
    nio_free(pbuf);
    dout_free(&lgo);
    if(lrc<0){return 103;}
    if(killcode==1){return 11;}
    if(killcode==2){return 12;}
    return 0;
}

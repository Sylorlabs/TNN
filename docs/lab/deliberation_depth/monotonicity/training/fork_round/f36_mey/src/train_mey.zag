// train_mey.zag — F36 MEY (Marginal-Yield Ledger) ledger builder.
//
// Frozen spec: fork_round/f36_mey/SPEC_F36.md §§2-4, recorded BEFORE the
// first run. Zero RNG; fixed file order; integer arithmetic.
//
// Usage: train_mey <features.tsv> <params_out.zag> <log_out.tsv>
//
// Reads features.tsv (id \t family \t heldout \t depth \t t \t rel4 \t
// correct4 \t f1..f8), chains per-item depth rungs in file order, computes
// marginal yield my and key q=(m,y), and counts per (q,d_idx) stratum:
//   n[cell] = released outcomes (heldout=0, rel4=1)
//   k[cell] = released correct outcomes
// Emits src/mey_params.zag (280 constant fns; never hand-edit) and a
// 140-row ledger log (cell \t m \t y \t d \t n \t k \t rho).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn my_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// depth value -> slot 0..6 ; -1 unknown (frozen, cf. train.zag tr_dslot)
fn my_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}
fn my_dval(s:i32)i32 {
    if(s==0){return 1;}
    if(s==1){return 2;}
    if(s==2){return 4;}
    if(s==3){return 8;}
    if(s==4){return 16;}
    if(s==5){return 32;}
    return 64;
}

// find tab positions: fills tabs[0..nft] with field end offsets
fn my_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}

fn my_train(feat_path:[]u8,params_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // ledger arenas: 140 u32 n, 140 u32 k (explicit LE accessors)
    let narr:[]u8=nio_alloc(140*4);
    let karr:[]u8=nio_alloc(140*4);
    if(narr.len==0 || karr.len==0){nio_free(fbuf);return 102;}
    au_zero(narr); au_zero(karr);
    let tabs:[]u8=nio_alloc(17*4);
    let idbuf:[]u8=nio_alloc(256);
    if(tabs.len==0 || idbuf.len==0){nio_free(fbuf);nio_free(narr);nio_free(karr);return 102;}
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lg:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,65536)!=0){return 102;}
    if(dout_init(&lg,65536)!=0){return 102;}
    // per-item chain state
    let idlen:i32=0;
    let f5_prev:i64=0;
    let d_prev:i32=0;
    let have_prev:i32=0;
    let nrows:i32=0;
    let nrel:i32=0;
    let ok:i32=1;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0){
            my_split(line,tabs);
            // fields: 0 id,1 family,2 heldout,3 depth,4 t,5 rel4,6 correct4,
            // 7 f1,8 f2,9 f3,10 f4,11 f5,12 f6,13 f7,14 f8
            let t0:i32=au_get32(tabs,0);
            let t1:i32=au_get32(tabs,1);
            let t2:i32=au_get32(tabs,2);
            let t3:i32=au_get32(tabs,3);
            let t4:i32=au_get32(tabs,4);
            let t5:i32=au_get32(tabs,5);
            let t6:i32=au_get32(tabs,6);
            let t7:i32=au_get32(tabs,7);
            let t10:i32=au_get32(tabs,10);
            let t11:i32=au_get32(tabs,11);
            let id:[]u8=line[0..t0];
            let heldout:i32=dlb_atoi(line[t1+1..t2]);
            let depth:i32=dlb_atoi(line[t2+1..t3]);
            let rel4:i32=dlb_atoi(line[t4+1..t5]);
            let c4:[]u8=line[t5+1..t6];
            let f1:i64=dlb_atoi(line[t6+1..t7]) as i64;
            let f5:i64=dlb_atoi(line[t10+1..t11]) as i64;
            // marginal yield (SPEC §2)
            let my:i64=0;
            if(have_prev==1 && id.len==idlen && nio_equal(id,idbuf[0..idlen])==1){
                let df2:i64=((depth-d_prev) as i64)*1000/64;
                let den:i64=df2;
                if(den<1){den=1;}
                let num:i64=f5-f5_prev;
                if(num<0){num=0;}
                num=num*1000;
                my=num/den;
                if(my>1000){my=1000;}
            }
            if(have_prev==0 || id.len!=idlen || nio_equal(id,idbuf[0..idlen])!=1){
                my=f5;
            }
            // keying (SPEC §3)
            let m:i64=f1/200;
            if(m>4){m=4;}
            let y:i64=my/250;
            if(y>3){y=3;}
            let ds:i32=my_dslot(depth);
            if(ds<0){ok=0;}
            if(ok==1){
                let cell:i32=((m as i32)*4+(y as i32))*7+ds;
                // counting rule (SPEC §4): released, heldout=0, after label
                if(heldout==0 && rel4==1){
                    au_put32(narr,cell,au_get32(narr,cell)+1);
                    if(c4.len==1 && c4[0]==49){au_put32(karr,cell,au_get32(karr,cell)+1);}
                    nrel=nrel+1;
                }
                // chain state updates for EVERY row (yield is trajectory)
                let q:i32=0;
                while(q<id.len && q<256){idbuf[q]=id[q];q=q+1;}
                idlen=id.len;
                f5_prev=f5;
                d_prev=depth;
                have_prev=1;
                nrows=nrows+1;
            }
        }
        pos=e+1;
    }
    // emit params file
    dout_str(&po,"// mey_params.zag - F36 MEY ledger. Generated by train_mey.zag; NEVER hand-edit.\n");
    let c:i32=0;
    while(c<140){
        dout_str(&po,"fn mey_k");
        dout_i64(&po,c as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get32(karr,c) as i64);
        dout_str(&po,"; }\n");
        dout_str(&po,"fn mey_n");
        dout_i64(&po,c as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get32(narr,c) as i64);
        dout_str(&po,"; }\n");
        c=c+1;
    }
    // rho accessor: pure function of the ledger (k,n); generated, never hand-edited
    dout_str(&po,"fn mey_rho(cell:i32)i64 {\n");
    dout_str(&po,"    let k:i64=1;let n:i64=0;\n");
    c=0;
    while(c<140){
        dout_str(&po,"    if(cell==");
        dout_i64(&po,c as i64);
        dout_str(&po,"){k=mey_k");
        dout_i64(&po,c as i64);
        dout_str(&po,"();n=mey_n");
        dout_i64(&po,c as i64);
        dout_str(&po,"();}\n");
        c=c+1;
    }
    dout_str(&po,"    return (k+1)*1000/(n+2);\n");
    dout_str(&po,"}\n");
    // ledger log: cell \t m \t y \t d \t n \t k \t rho
    dout_str(&lg,"cell\tm\ty\td\tn\tk\trho\n");
    let nonempty:i32=0;
    let rhosum:i64=0;
    c=0;
    while(c<140){
        let mm:i32=c/28;
        let yy:i32=(c/7)-mm*4;
        let dd:i32=my_dval(c-(c/7)*7);
        let nn:i64=au_get32(narr,c) as i64;
        let kk:i64=au_get32(karr,c) as i64;
        let rho:i64=(kk+1)*1000/(nn+2);
        if(nn>0){nonempty=nonempty+1;}
        rhosum=rhosum+rho;
        dout_i64(&lg,c as i64);dout_byte(&lg,9);
        dout_i64(&lg,mm as i64);dout_byte(&lg,9);
        dout_i64(&lg,yy as i64);dout_byte(&lg,9);
        dout_i64(&lg,dd as i64);dout_byte(&lg,9);
        dout_i64(&lg,nn);dout_byte(&lg,9);
        dout_i64(&lg,kk);dout_byte(&lg,9);
        dout_i64(&lg,rho);dout_line(&lg);
        c=c+1;
    }
    // summary trailer in the log (also the liveness signal for §5 checkpoint)
    dout_str(&lg,"zz_summary	rows\t");
    dout_i64(&lg,nrows as i64);dout_line(&lg);
    dout_str(&lg,"zz_summary	released_train\t");
    dout_i64(&lg,nrel as i64);dout_line(&lg);
    dout_str(&lg,"zz_summary	nonempty_cells\t");
    dout_i64(&lg,nonempty as i64);dout_line(&lg);
    dout_str(&lg,"zz_summary	rho_mean_x1000\t");
    dout_i64(&lg,rhosum/140);dout_line(&lg);
    let wrc:i64=0;
    if(ok==1 && po.err==0 && lg.err==0){
        wrc=dlb_write_file(params_path,dout_bytes(&po),po.n);
        let wrc2:i64=dlb_write_file(log_path,dout_bytes(&lg),lg.n);
        if(wrc2<0){wrc=-1;}
    }
    nio_free(fbuf);
    nio_free(narr);
    nio_free(karr);
    nio_free(tabs);
    nio_free(idbuf);
    dout_free(&po);
    dout_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: train_mey <features.tsv> <params_out.zag> <log_out.tsv>");
        return 64;
    }
    return my_train(_zag_arg(1),_zag_arg(2),_zag_arg(3));
}

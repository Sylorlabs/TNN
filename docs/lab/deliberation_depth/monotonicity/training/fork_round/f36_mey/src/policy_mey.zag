// policy_mey.zag — F36 MEY (Marginal-Yield Ledger) BATCH evaluation driver.
//
// Frozen spec: fork_round/f36_mey/SPEC_F36.md §§1-7, recorded BEFORE the
// first training run. One binary, frozen ordered cell list (SPEC §6), all
// 37 legs in one run; per-item cross-depth state in memory (no on-disk
// state), so A/B runs are structurally byte-identical.
//
// Release: M4 skeleton UNTOUCHED (release L_t iff L_t == L_1, else ABSTAIN).
// Confidence (f2 DELETED from the function class):
//   q=(m,y), m=min(4,f1/200), y=min(3,my/250), my per SPEC §2;
//   C0 = mey_rho(cell(q,d_idx))  [=(k+1)*1000/(n+2), frozen ledger]
//   path rule per SPEC §5 (yield-drop cap, latch/trauma cap).
//
// Usage: policy_mey <results_dir> <suffix>
// Writes <results_dir>/<battery>_m36_d<depth>_<suffix>.tsv (37 legs) and
// <results_dir>/<battery>_m36_d<depth>_<suffix>.feat.tsv sidecars
// (id \t depth \t t \t correct \t rel \t f1 \t f5 \t my \t y \t m \t C0 \t C).
//
// Per-item TSV record: identical columns to mech.zag:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("mey_params.zag")

fn pl_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}

// §4 features (index-level only), flat out-params. f2 is computed by the
// frozen harness formula but NEVER read downstream (deleted from the
// function class per the fork's causal bet).
fn pl_features(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=pl_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=pl_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=pl_clamp(maxdrop,0,1000);
}

// depth value -> slot 0..6 ; -1 unknown
fn my_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

fn pl_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"mey");}
}

fn pl_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn pl_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn pl_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn pl_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

// ---- per-item cross-depth state (SPEC §5) ----
// One slot per item of the current battery (cap 1024; batteries ≤ 264).
// id bytes packed in idb (off/len per slot, 128B each); state in arenas:
//   has: u32 (previous rung exists); cv: u32 (Clast valid: previously released)
//   f5p: i64; dp: u32; yp: u32; f3p: i64; f8p: i64; cl: i64 (Clast)
struct MSt {
    idb:[]u8, ioff:[]u8, ilen:[]u8,
    has:[]u8, cv:[]u8, f5p:[]u8, dp:[]u8,
    yp:[]u8, f3p:[]u8, f8p:[]u8, cl:[]u8,
    nslots:i32
}
fn ms_alloc(ms:*MSt)i32 {
    ms.*.idb=nio_alloc(1024*128);
    ms.*.ioff=nio_alloc(1024*4);
    ms.*.ilen=nio_alloc(1024*4);
    ms.*.has=nio_alloc(1024*4);
    ms.*.cv=nio_alloc(1024*4);
    ms.*.f5p=nio_alloc(1024*8);
    ms.*.dp=nio_alloc(1024*4);
    ms.*.yp=nio_alloc(1024*4);
    ms.*.f3p=nio_alloc(1024*8);
    ms.*.f8p=nio_alloc(1024*8);
    ms.*.cl=nio_alloc(1024*8);
    ms.*.nslots=0;
    if(ms.*.idb.len==0){return -1;}
    return 0;
}
fn ms_free(ms:*MSt)void {
    nio_free(ms.*.idb);nio_free(ms.*.ioff);nio_free(ms.*.ilen);
    nio_free(ms.*.has);nio_free(ms.*.cv);nio_free(ms.*.f5p);nio_free(ms.*.dp);
    nio_free(ms.*.yp);nio_free(ms.*.f3p);nio_free(ms.*.f8p);nio_free(ms.*.cl);
}
fn ms_reset(ms:*MSt)void {
    ms.*.nslots=0;
}
// find slot for id, or allocate a new one; -1 on overflow
fn ms_slot(ms:*MSt,id:[]u8)i32 {
    let idb:[]u8=ms.*.idb;
    let i:i32=0;
    while(i<ms.*.nslots){
        let o:i32=au_get32(ms.*.ioff,i);
        let l:i32=au_get32(ms.*.ilen,i);
        if(l==id.len && nio_equal(idb[o..o+l],id)==1){return i;}
        i=i+1;
    }
    if(ms.*.nslots>=1024){return -1;}
    let s:i32=ms.*.nslots;
    let o:i32=s*128;
    let k:i32=0;
    while(k<id.len && k<128){idb[o+k]=id[k];k=k+1;}
    au_put32(ms.*.ioff,s,o);
    au_put32(ms.*.ilen,s,id.len);
    au_put32(ms.*.has,s,0);
    au_put32(ms.*.cv,s,0);
    ms.*.nslots=s+1;
    return s;
}

// path rule (SPEC §5) as a helper: keeps my_leg small and avoids an
// inline-cast codegen hazard. Returns the post-rule confidence.
fn my_pathrule(c0:i64,has:i32,cv:i32,yp:i32,f3p:i64,f8p:i64,clast:i64,f3:i64,f8:i64,y:i64)i64 {
    let cval:i64=c0;
    if(has==1){
        if(cv==1){
            let trauma:i32=0;
            if(f3==1000){
                if(f3p==0){trauma=1;}
            }
            if(f8>f8p){trauma=1;}
            if(trauma==1){
                let cap:i64=clast-1;
                if(cap<cval){cval=cap;}
            }
            if(trauma==0){
                let yi:i32=y as i32;
                if(yi<yp){
                    if(clast<cval){cval=clast;}
                }
            }
        }
    }
    return cval;
}

// sidecar row (causal test): id depth t correct rel f1 f5 my y m C0 C (12 cols)
fn my_sidecar(ft:*DOut,id:[]u8,depth:i32,t:i32,corr:[]u8,rel:i32,f1:i64,f5:i64,my:i64,y:i64,m:i64,c0:i64,cval:i64)void {
    dout_str(ft,id);
    dout_byte(ft,9);
    dout_i64(ft,depth as i64);
    dout_byte(ft,9);
    dout_i64(ft,t as i64);
    dout_byte(ft,9);
    dout_str(ft,corr);
    dout_byte(ft,9);
    if(rel>=0){dout_str(ft,"1");}
    if(rel<0){dout_str(ft,"0");}
    dout_byte(ft,9);
    dout_i64(ft,f1);
    dout_byte(ft,9);
    dout_i64(ft,f5);
    dout_byte(ft,9);
    dout_i64(ft,my);
    dout_byte(ft,9);
    dout_i64(ft,y);
    dout_byte(ft,9);
    dout_i64(ft,m);
    dout_byte(ft,9);
    dout_i64(ft,c0);
    dout_byte(ft,9);
    dout_i64(ft,cval);
    dout_line(ft);
}

// one (battery, depth) leg; appends rows to res and sidecar rows to ft
fn my_leg(items_path:[]u8,depth:i32,res:*DOut,ft:*DOut,ms:*MSt)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(pl_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(pl_st_alloc(&st,68)!=0){pl_item_free(&it);nio_free(ibuf);return 102;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,8388608)!=0){pl_st_free(&st);pl_item_free(&it);nio_free(ibuf);return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){dout_free(&lgo);pl_st_free(&st);pl_item_free(&it);nio_free(ibuf);return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let slot:i32=ms_slot(ms,dj_id(&it));
                if(slot<0){ok=0;}
                if(ok==1){
                    let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                    if(drc!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                    if(drc==0){
                        let t:i32=depth;
                        if(st.rounds<t){t=st.rounds;}
                        let l1:i32=au_get32(st.hist_l,1);
                        let lt:i32=au_get32(st.hist_l,t);
                        let f1:i64=0;let f2:i64=0;let f3:i64=0;let f4:i64=0;
                        let f5:i64=0;let f6:i64=0;let f7:i64=0;let f8:i64=0;
                        pl_features(&st,&it,t,&f1,&f2,&f3,&f4,&f5,&f6,&f7,&f8);
                        // marginal yield + keying (SPEC §§2-3); f2 unused
                        let has:i32=au_get32(ms.*.has,slot) as i32;
                        let my:i64=f5;
                        if(has==1){
                            let dp:i32=au_get32(ms.*.dp,slot) as i32;
                            let f5p:i64=au_get64(ms.*.f5p,slot);
                            let df2:i64=((depth-dp) as i64)*1000/64;
                            let den:i64=df2;
                            if(den<1){den=1;}
                            let num:i64=f5-f5p;
                            if(num<0){num=0;}
                            num=num*1000;
                            my=num/den;
                            if(my>1000){my=1000;}
                        }
                        let m:i64=f1/200;
                        if(m>4){m=4;}
                        let y:i64=my/250;
                        if(y>3){y=3;}
                        let ds:i32=my_dslot(depth);
                        let cell:i32=((m as i32)*4+(y as i32))*7+ds;
                        let c0:i64=mey_rho(cell);
                        // path rule (SPEC §5)
                        let rel:i32=-1;
                        let rconf:i32=0;
                        let rcode:i32=0;
                        let cval:i64=c0;
                        if(lt==l1){
                            rel=lt;
                            rcode=1;
                            let cvv:i32=au_get32(ms.*.cv,slot) as i32;
                            let ypp:i32=0;
                            let f3pp:i64=0;
                            let f8pp:i64=0;
                            let clv:i64=0;
                            if(has==1 && cvv==1){
                                ypp=au_get32(ms.*.yp,slot) as i32;
                                f3pp=au_get64(ms.*.f3p,slot);
                                f8pp=au_get64(ms.*.f8p,slot);
                                clv=au_get64(ms.*.cl,slot);
                            }
                            cval=my_pathrule(c0,has,cvv,ypp,f3pp,f8pp,clv,f3,f8,y);
                            rconf=cval as i32;
                            au_put64(ms.*.cl,slot,cval);
                            au_put32(ms.*.cv,slot,1);
                        }
                        // update rung state (always, released or not)
                        au_put32(ms.*.has,slot,1);
                        au_put64(ms.*.f5p,slot,f5);
                        au_put32(ms.*.dp,slot,depth);
                        au_put32(ms.*.yp,slot,y as i32);
                        au_put64(ms.*.f3p,slot,f3);
                        au_put64(ms.*.f8p,slot,f8);
                        // emit main row (frozen 11 columns)
                        dout_str(res,dj_id(&it));
                        dout_byte(res,9);
                        dout_i64(res,depth as i64);
                        dout_byte(res,9);
                        dout_i64(res,t as i64);
                        dout_byte(res,9);
                        dout_i64(res,st.rounds as i64);
                        dout_byte(res,9);
                        dout_i64(res,st.consumed as i64);
                        dout_byte(res,9);
                        dout_i64(res,it.ne as i64);
                        dout_byte(res,9);
                        if(rel<0){
                            dout_str(res,"ABSTAIN:");
                            pl_cert(rcode,res);
                        }
                        if(rel>=0){dout_str(res,dj_hid(&it,rel));}
                        dout_byte(res,9);
                        let corr:[]u8="A";
                        if(rel<0){dout_str(res,"A");}
                        if(rel>=0){
                            if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(res,"1");corr="1";}
                            if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(res,"0");corr="0";}
                        }
                        dout_byte(res,9);
                        dout_i64(res,rconf as i64);
                        dout_byte(res,9);
                        dout_i64(res,au_get32(st.hist_l,t) as i64);
                        dout_byte(res,9);
                        pl_cert(rcode,res);
                        dout_line(res);
                        my_sidecar(ft,dj_id(&it),depth,t,corr,rel,f1,f5,my,y,m,c0,cval);
                        if(res.err!=0){ok=0;}
                        if(ft.err!=0){ok=0;}
                    }
                }
            }
        }
        pos=e+1;
    }
    nio_free(ibuf);
    pl_item_free(&it);
    pl_st_free(&st);
    dout_free(&lgo);
    lg_free(&lg);
    if(ok==0){return 103;}
    return errs;
}

// one battery at all its depths (depths strictly ascending); state reset
// per battery. depth_list: []u8 arena of u32 depths.
fn my_battery(items_path:[]u8,battery:[]u8,depths:[]u8,nd:i32,resdir:[]u8,sfx:[]u8,ms:*MSt)i32 {
    ms_reset(ms);
    let di:i32=0;
    while(di<nd){
        let depth:i32=au_get32(depths,di) as i32;
        let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        let ft:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&res,4194304)!=0){return 102;}
        if(dout_init(&ft,4194304)!=0){dout_free(&res);return 102;}
        let rc:i32=my_leg(items_path,depth,&res,&ft,ms);
        if(rc<0){dout_free(&res);dout_free(&ft);return rc;}
        // paths: <resdir>/<battery>_m36_d<depth>_<sfx>.tsv (+ .feat.tsv)
        let p:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&p,1024)!=0){dout_free(&res);dout_free(&ft);return 102;}
        dout_str(&p,resdir);
        dout_byte(&p,47);
        dout_str(&p,battery);
        dout_str(&p,"_m36_d");
        dout_i64(&p,depth as i64);
        dout_str(&p,"_");
        dout_str(&p,sfx);
        dout_str(&p,".tsv");
        let wrc:i64=dlb_write_file(dout_bytes(&p),dout_bytes(&res),res.n);
        let q:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&q,1024)!=0){dout_free(&p);dout_free(&res);dout_free(&ft);return 102;}
        dout_str(&q,resdir);
        dout_byte(&q,47);
        dout_str(&q,battery);
        dout_str(&q,"_m36_d");
        dout_i64(&q,depth as i64);
        dout_str(&q,"_");
        dout_str(&q,sfx);
        dout_str(&q,".feat.tsv");
        let wrc2:i64=dlb_write_file(dout_bytes(&q),dout_bytes(&ft),ft.n);
        dout_free(&p);
        dout_free(&q);
        dout_free(&res);
        dout_free(&ft);
        if(wrc<0 || wrc2<0){return 103;}
        di=di+1;
    }
    return 0;
}

// frozen ordered cell list (SPEC §6): 37 legs
fn my_batch(resdir:[]u8,sfx:[]u8)i32 {
    let ms:MSt=MSt{.idb:"",.ioff:"",.ilen:"",.has:"",.cv:"",.f5p:"",.dp:"",.yp:"",.f3p:"",.f8p:"",.cl:"",.nslots:0};
    if(ms_alloc(&ms)!=0){return 102;}
    let d5:[]u8=nio_alloc(5*4);
    let d7:[]u8=nio_alloc(7*4);
    if(d5.len==0 || d7.len==0){ms_free(&ms);return 102;}
    au_put32(d5,0,1);au_put32(d5,1,2);au_put32(d5,2,4);au_put32(d5,3,8);au_put32(d5,4,16);
    au_put32(d7,0,1);au_put32(d7,1,2);au_put32(d7,2,4);au_put32(d7,3,8);au_put32(d7,4,16);au_put32(d7,5,32);au_put32(d7,6,64);
    let home:[]u8="/home/hatch/workspace/tnn-lab/deliberation_depth";
    let b5:[]u8="/home/hatch/workspace/tnn-lab/deliberation_depth/items_v2/";
    let rc:i32=0;
    // 5-depth batteries
    let bn:i32=0;
    while(bn<6 && rc==0){
        let bat:[]u8="admit";
        if(bn==1){bat="revoke";}
        if(bn==2){bat="logic";}
        if(bn==3){bat="trap";}
        if(bn==4){bat="cost";}
        if(bn==5){bat="redteam";}
        let ip:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&ip,1024)!=0){rc=102;}
        if(rc==0){
            if(bn<5){
                dout_str(&ip,b5);
                dout_str(&ip,bat);
                dout_str(&ip,".jsonl");
            }
            if(bn==5){
                dout_str(&ip,home);
                dout_str(&ip,"/monotonicity/redteam/redteam_battery.jsonl");
            }
            rc=my_battery(dout_bytes(&ip),bat,d5,5,resdir,sfx,&ms);
            dout_free(&ip);
        }
        bn=bn+1;
    }
    // ceiling: 7 depths
    if(rc==0){
        let ip:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
        if(dout_init(&ip,1024)!=0){rc=102;}
        if(rc==0){
            dout_str(&ip,home);
            dout_str(&ip,"/ceiling/items/ceiling_battery.jsonl");
            rc=my_battery(dout_bytes(&ip),"ceiling",d7,7,resdir,sfx,&ms);
            dout_free(&ip);
        }
    }
    nio_free(d5);
    nio_free(d7);
    ms_free(&ms);
    return rc;
}

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: policy_mey <results_dir> <suffix>");
        return 64;
    }
    return my_batch(_zag_arg(1),_zag_arg(2));
}

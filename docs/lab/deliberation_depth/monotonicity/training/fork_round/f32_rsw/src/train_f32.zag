// train_f32.zag — F32 RSW (Regime-Switch Calibrator) online trainer.
//
// Single deterministic pass over the frozen training features.tsv
// (file order; heldout=1 rows skipped). Per row: emit C from pre-update
// ledger state, observe release+label, update cells / stay-drop transition
// sums / regime bits. Zero RNG, integer fixed-point.
//
// Usage: train_f32 <features.tsv> <state_out.tsv> <trace_out.tsv>
//
// features.tsv cols: id \t family \t heldout \t depth \t t \t rel4
//   \t correct4 \t f1..f8   (correct4 in {1,0,A}; A when rel4=0)
//
// state_out.tsv records (canonical trained params, A/B-compared):
//   C r j n k
//   T r j nstay scstay nall scall kall kstay
//   Z r regime nswitch gh0 gh1 gh2
// trace_out.tsv: id \t depth \t m \t yld \t regime \t C \t rel \t correct
@import("R33_NATIVE_IO_V1.zag")
@import("dlb_util.zag")
@import("rsw.zag")

// find tab positions: fills tabs[0..nft] with field end offsets (cribbed
// pattern from frozen train.zag)
fn tf_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}
fn tf_fstart(tabs:[]u8,f:i32)i32 {
    if(f==0){return 0;}
    return au_get32(tabs,f-1)+1;
}
fn tf_fend(tabs:[]u8,f:i32)i32 { return au_get32(tabs,f); }

fn tf_train(feat_path:[]u8,state_path:[]u8,trace_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    // ledger arenas
    let cells:[]u8=nio_alloc(210*8);
    let trans:[]u8=nio_alloc(630*8);
    let regime:[]u8=nio_alloc(15*8);
    let ghist:[]u8=nio_alloc(45*8);
    let nswitch:[]u8=nio_alloc(15*8);
    if(cells.len==0 || trans.len==0 || regime.len==0){nio_free(fbuf);return 102;}
    au_zero(cells);au_zero(trans);au_zero(regime);au_zero(nswitch);
    let gi:i32=0;
    while(gi<45){au_put64(ghist,gi,-1);gi=gi+1;}
    let tabs:[]u8=nio_alloc(17*4);
    if(tabs.len==0){nio_free(fbuf);return 102;}
    let previd:[]u8=nio_alloc(128);
    if(previd.len==0){nio_free(fbuf);return 102;}
    let prevlen:i32=0;
    let hasprev:i32=0;
    // per-item cross-depth state
    let f5p:i64=0; let dp:i32=0; let f8p:i64=0;
    let cprev:i64=0; let cstar:i64=0;
    let relprev:i32=0; let correctprev:i32=0;
    let trace:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&trace,1048576)!=0){nio_free(fbuf);return 102;}
    let nrows:i32=0; let nskip:i32=0; let nitems:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0){
            tf_split(line,tabs);
            let heldout:i32=dlb_atoi(line[tf_fstart(tabs,2)..tf_fend(tabs,2)]);
            if(heldout==1){
                nskip=nskip+1;
            } else {
                let depth:i32=dlb_atoi(line[tf_fstart(tabs,3)..tf_fend(tabs,3)]);
                let j:i32=rsw_dslot(depth);
                if(j>=0){
                    let id:[]u8=line[tf_fstart(tabs,0)..tf_fend(tabs,0)];
                    let first:i32=0;
                    if(hasprev==0){first=1;}
                    if(hasprev==1 && dlb_streq(id,previd[0..prevlen])!=1){first=1;}
                    if(first==1){
                        nitems=nitems+1;
                        relprev=0; correctprev=0;
                        let cp:i32=0;
                        while(cp<id.len && cp<128){previd[cp]=id[cp];cp=cp+1;}
                        prevlen=id.len;
                        if(prevlen>128){prevlen=128;}
                        hasprev=1;
                    }
                    let f1:i64=dlb_atoi(line[tf_fstart(tabs,7)..tf_fend(tabs,7)]) as i64;
                    let f3:i64=dlb_atoi(line[tf_fstart(tabs,9)..tf_fend(tabs,9)]) as i64;
                    let f5:i64=dlb_atoi(line[tf_fstart(tabs,11)..tf_fend(tabs,11)]) as i64;
                    let f8:i64=dlb_atoi(line[tf_fstart(tabs,14)..tf_fend(tabs,14)]) as i64;
                    let rel:i32=dlb_atoi(line[tf_fstart(tabs,5)..tf_fend(tabs,5)]);
                    let cf:[]u8=line[tf_fstart(tabs,6)..tf_fend(tabs,6)];
                    let correct:i32=-1;
                    if(cf.len>0 && cf[0]!=65){correct=dlb_atoi(cf);}
                    let m:i64=0; let yld:i64=0;
                    let r:i32=rsw_key(f1,f5,f5p,depth,dp,first,&m,&yld);
                    let reg0:i64=au_get64(regime,r);
                    // EMIT (pre-update state)
                    let c:i32=rsw_emit(cells,trans,regime,r,j,first,&cstar,cprev,f3,f8,f8p);
                    // trace row
                    dout_str(&trace,id);
                    dout_byte(&trace,9);
                    dout_i64(&trace,depth as i64);
                    dout_byte(&trace,9);
                    dout_i64(&trace,m);
                    dout_byte(&trace,9);
                    dout_i64(&trace,yld);
                    dout_byte(&trace,9);
                    dout_i64(&trace,reg0);
                    dout_byte(&trace,9);
                    dout_i64(&trace,c as i64);
                    dout_byte(&trace,9);
                    dout_i64(&trace,rel as i64);
                    dout_byte(&trace,9);
                    dout_i64(&trace,correct as i64);
                    dout_line(&trace);
                    // UPDATE: cells (released outcomes only)
                    let cnow:i32=0;
                    if(correct==1){cnow=1;}
                    if(rel==1){
                        let ci:i32=rsw_cidx(r,j,0);
                        au_put64(cells,ci,au_get64(cells,ci)+1);
                        if(cnow==1){
                            let ck:i32=rsw_cidx(r,j,1);
                            au_put64(cells,ck,au_get64(cells,ck)+1);
                        }
                    }
                    // UPDATE: stay/drop transition sums (key r, arrival depth j)
                    if(j>=1 && relprev==1){
                        let ta:i32=rsw_tidx(r,j,2);
                        au_put64(trans,ta,au_get64(trans,ta)+1);
                        let ts:i32=rsw_tidx(r,j,3);
                        au_put64(trans,ts,au_get64(trans,ts)+cprev);
                        let tk:i32=rsw_tidx(r,j,4);
                        au_put64(trans,tk,au_get64(trans,tk)+(correctprev as i64));
                        if(rel==1){
                            let tn:i32=rsw_tidx(r,j,0);
                            au_put64(trans,tn,au_get64(trans,tn)+1);
                            let tc:i32=rsw_tidx(r,j,1);
                            au_put64(trans,tc,au_get64(trans,tc)+cprev);
                            let tkk:i32=rsw_tidx(r,j,5);
                            au_put64(trans,tkk,au_get64(trans,tkk)+(cnow as i64));
                        }
                    }
                    // UPDATE: regime bit
                    if(rsw_pooled_n(cells,r)>=32){
                        let gamma:i64=rsw_gamma(cells,r);
                        au_put64(ghist,r*3+0,au_get64(ghist,r*3+1));
                        au_put64(ghist,r*3+1,au_get64(ghist,r*3+2));
                        au_put64(ghist,r*3+2,gamma);
                        if(reg0==0){
                            if(gamma>=100 && au_get64(ghist,r*3+0)>=0 && au_get64(ghist,r*3+1)>=0 && au_get64(ghist,r*3+2)>=0){
                                au_put64(regime,r,1);
                                au_put64(nswitch,r,au_get64(nswitch,r)+1);
                            }
                        }
                        if(reg0==1 && gamma<=60){
                            au_put64(regime,r,0);
                            au_put64(nswitch,r,au_get64(nswitch,r)+1);
                        }
                    }
                    // per-item state advance
                    f5p=f5; dp=depth; f8p=f8;
                    cprev=c as i64;
                    relprev=rel; correctprev=cnow;
                    nrows=nrows+1;
                }
            }
        }
        pos=e+1;
    }
    // write state TSV
    let st:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&st,131072)!=0){nio_free(fbuf);return 102;}
    dout_str(&st,"# F32 RSW trained state - generated by train_f32.zag, do not hand-edit");
    dout_line(&st);
    let r2:i32=0;
    while(r2<15){
        let j2:i32=0;
        while(j2<7){
            dout_str(&st,"C ");
            dout_i64(&st,r2 as i64);dout_byte(&st,32);
            dout_i64(&st,j2 as i64);dout_byte(&st,32);
            dout_i64(&st,au_get64(cells,rsw_cidx(r2,j2,0)));dout_byte(&st,32);
            dout_i64(&st,au_get64(cells,rsw_cidx(r2,j2,1)));
            dout_line(&st);
            j2=j2+1;
        }
        r2=r2+1;
    }
    let r3:i32=0;
    while(r3<15){
        let j3:i32=0;
        while(j3<7){
            dout_str(&st,"T ");
            dout_i64(&st,r3 as i64);dout_byte(&st,32);
            dout_i64(&st,j3 as i64);dout_byte(&st,32);
            let f3i:i32=0;
            while(f3i<6){
                dout_i64(&st,au_get64(trans,rsw_tidx(r3,j3,f3i)));
                if(f3i<5){dout_byte(&st,32);}
                f3i=f3i+1;
            }
            dout_line(&st);
            j3=j3+1;
        }
        r3=r3+1;
    }
    let r4:i32=0;
    while(r4<15){
        dout_str(&st,"Z ");
        dout_i64(&st,r4 as i64);dout_byte(&st,32);
        dout_i64(&st,au_get64(regime,r4));dout_byte(&st,32);
        dout_i64(&st,au_get64(nswitch,r4));dout_byte(&st,32);
        dout_i64(&st,au_get64(ghist,r4*3+0));dout_byte(&st,32);
        dout_i64(&st,au_get64(ghist,r4*3+1));dout_byte(&st,32);
        dout_i64(&st,au_get64(ghist,r4*3+2));
        dout_line(&st);
        r4=r4+1;
    }
    let wrc:i64=0;
    if(trace.err==0 && st.err==0){
        wrc=dlb_write_file(state_path,dout_bytes(&st),st.n);
    }
    let wrc2:i64=0;
    if(wrc>=0 && trace.err==0){
        wrc2=dlb_write_file(trace_path,dout_bytes(&trace),trace.n);
    }
    // summary to stdout
    _zag_println("rows_trained:");
    _zag_println(dlb_i64s(nrows as i64));
    _zag_println("rows_skipped_heldout:");
    _zag_println(dlb_i64s(nskip as i64));
    _zag_println("items:");
    _zag_println(dlb_i64s(nitems as i64));
    let r5:i32=0;
    while(r5<15){
        _zag_println(dlb_i64s(r5 as i64));
        _zag_println(dlb_i64s(au_get64(regime,r5)));
        _zag_println(dlb_i64s(rsw_pooled_n(cells,r5)));
        _zag_println(dlb_i64s(rsw_gamma(cells,r5)));
        _zag_println(dlb_i64s(au_get64(nswitch,r5)));
        r5=r5+1;
    }
    nio_free(fbuf);
    dout_free(&trace);
    dout_free(&st);
    nio_free(cells);nio_free(trans);nio_free(regime);nio_free(ghist);nio_free(nswitch);
    nio_free(tabs);nio_free(previd);
    if(wrc<0 || wrc2<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<4){
        _zag_println("usage: train_f32 <features.tsv> <state_out.tsv> <trace_out.tsv>");
        return 64;
    }
    return tf_train(_zag_arg(1),_zag_arg(2),_zag_arg(3));
}

// policy_f33.zag — F33 SRS evaluation driver.
//
// Frozen harness deliberation (byte-identical dlb_*.zag copies) at a fixed
// depth per item, then the F33 confidence head:
//   release: M4 skeleton (release L_t iff L_t == L_1, else ABSTAIN)
//   depth 1: key (m,s) from (f1,f6); C* = f33_cstar(key) [frozen params];
//            conf = clamp(C*,1,999); per-item row -> on-disk state file
//   depth d>1: per-item state (m,s,C*,f8^(1)) from the state file;
//            pi = min(400, 1_{f3>0}*50 + max(0,f8-f8^(1))/8);
//            conf = clamp(C* + sum_{j<=d_idx} f33_delta(key,j) - pi, 1, 999)
// gate01 must be 0 (no gate; B9 answer channel frozen).
//
// Per-leg driver with deterministic on-disk per-item state:
//   state path = dirname(out.tsv)/.f33state_<A|B>.tsv
// (variant from the out filename suffix; deleted at eval run start by the
// wrapper; legs run in fixed depth order so depth-1 state always exists).
//
// Usage: policy_f33 <items.jsonl> <depth> <gate01> <results.tsv>
// TSV columns identical to mech.zag:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert   (cert = "f33-srs")

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("mt_f33_params.zag")

fn f33_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn f33_min(a:i64,b:i64)i64 {
    if(a<b){return a;}
    return b;
}
fn f33_max(a:i64,b:i64)i64 {
    if(a>b){return a;}
    return b;
}
// depth value -> slot 0..6 ; -1 unknown
fn f33_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}
// cumulative delta sum_{j=1..ds} f33_delta(key,j)
fn f33_cum(key:i32,ds:i32)i64 {
    let c:i64=0;
    let j:i32=1;
    while(j<=ds){
        c=c+f33_delta(key,j);
        j=j+1;
    }
    return c;
}

// §4 features (index-level only), flat out-params — verbatim §4 definitions
fn f33_features(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=f33_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=f33_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=f33_clamp(maxdrop,0,1000);
}

fn f33_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"f33-srs");}
}

fn f33_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn f33_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn f33_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn f33_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

// build state-file path: dir(out) + "/.f33state_" + variant + ".tsv"
// variant: 'A' if out ends "_A.tsv", 'B' if "_B.tsv", else 'X'.
// returns path length, or -1 on error.
fn f33_state_path(out:[]u8,buf:[]u8)i32 {
    let n:i32=out.len;
    let v:u8=88; // 'X'
    if(n>=6 && out[n-6]==95 && out[n-5]==65){v=65;} // _A
    if(n>=6 && out[n-6]==95 && out[n-5]==66){v=66;} // _B
    let slash:i32=-1;
    let i:i32=0;
    while(i<n){if(out[i]==47){slash=i;}i=i+1;}
    let p:i32=0;
    if(slash>=0){
        i=0;
        while(i<=slash){buf[p]=out[i];p=p+1;i=i+1;}
    }
    let tail:[]u8=".f33state_";
    i=0;
    while(i<10){buf[p]=tail[i];p=p+1;i=i+1;}
    buf[p]=v;p=p+1;
    let tail2:[]u8=".tsv";
    i=0;
    while(i<4){buf[p]=tail2[i];p=p+1;i=i+1;}
    buf[p]=0;
    return p;
}

// split line into tab ends (same convention as trainer)
fn f33_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<8){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}
fn f33_fstart(tabs:[]u8,fi:i32)i32 {
    if(fi==0){return 0;}
    return au_get32(tabs,fi-1)+1;
}
// parse state file rows into table; returns row count or -1
fn f33_state_load(sbuf:[]u8,slen:i32,idbuf:[]u8,idix:[]u8,
    sm:[]u8,ss:[]u8,scs:[]u8,sf8:[]u8) i32 {
    let tabs:[]u8=nio_alloc(6*4);
    if(tabs.len==0){return -1;}
    let nrows:i32=0;
    let ibn:i32=0;
    let pos:i32=0;
    while(pos<slen){
        let e:i32=pos;
        while(e<slen && sbuf[e]!=10){e=e+1;}
        let line:[]u8=sbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0){
            f33_split(line,tabs);
            let id:[]u8=line[f33_fstart(tabs,0)..au_get32(tabs,0)];
            let mv:i32=dlb_atoi(line[f33_fstart(tabs,1)..au_get32(tabs,1)]);
            let sv:i32=dlb_atoi(line[f33_fstart(tabs,2)..au_get32(tabs,2)]);
            let cv:i32=dlb_atoi(line[f33_fstart(tabs,3)..au_get32(tabs,3)]);
            let fv:i32=dlb_atoi(line[f33_fstart(tabs,4)..au_get32(tabs,4)]);
            if(nrows<2048 && ibn+id.len<=idbuf.len){
                let c:i32=0;
                while(c<id.len){idbuf[ibn+c]=id[c];c=c+1;}
                au_put32(idix,nrows*2+0,ibn);
                au_put32(idix,nrows*2+1,id.len);
                au_put32(sm,nrows,mv);
                au_put32(ss,nrows,sv);
                au_put32(scs,nrows,cv);
                au_put32(sf8,nrows,fv);
                ibn=ibn+id.len;
                nrows=nrows+1;
            }
        }
        pos=e+1;
    }
    nio_free(tabs);
    return nrows;
}
// find state row by id; returns row or -1
fn f33_state_find(id:[]u8,idbuf:[]u8,idix:[]u8,nrows:i32)i32 {
    let r:i32=0;
    while(r<nrows){
        let off:i32=au_get32(idix,r*2+0);
        let ln:i32=au_get32(idix,r*2+1);
        if(ln==id.len && dlb_streq(idbuf[off..off+ln],id)==1){return r;}
        r=r+1;
    }
    return -1;
}

fn f33_run(items_path:[]u8,depth:i32,gate01:i32,res_path:[]u8)i32 {
    if(gate01!=0){return 64;}
    let ds:i32=f33_dslot(depth);
    if(ds<0){return 64;}
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    // state file path
    let spbuf:[]u8=nio_alloc(4096);
    if(spbuf.len==0){nio_free(ibuf);return 102;}
    let splen:i32=f33_state_path(res_path,spbuf);
    if(splen<0){nio_free(ibuf);nio_free(spbuf);return 102;}
    let spath:[]u8=spbuf[0..splen];
    // state table (depth>1: load; depth==1: collect rows to append)
    let idbuf:[]u8=nio_alloc(1048576);
    let idix:[]u8=nio_alloc(2048*2*4);
    let stm:[]u8=nio_alloc(2048*4); let sts:[]u8=nio_alloc(2048*4);
    let stcs:[]u8=nio_alloc(2048*4); let stf8:[]u8=nio_alloc(2048*4);
    au_zero(idix);
    let sbuf:[]u8=nio_alloc(1048576);
    if(sbuf.len==0){return 102;}
    let nrows:i32=0;
    if(ds>0){
        let sn:i64=dlb_read_file(spath,sbuf);
        if(sn<0){nio_free(ibuf);return 104;}
        nrows=f33_state_load(sbuf,sn as i32,idbuf,idix,stm,sts,stcs,stf8);
        if(nrows<0){nio_free(ibuf);return 104;}
    }
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(f33_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(f33_st_alloc(&st,68)!=0){f33_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let srows:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&srows,1048576)!=0){return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    let l1:i32=au_get32(st.hist_l,1);
                    let lt:i32=au_get32(st.hist_l,t);
                    let rel:i32=-1;
                    let rconf:i32=0;
                    let rcode:i32=0;
                    if(lt==l1){
                        let f1:i64=0;let f2:i64=0;let f3:i64=0;let f4:i64=0;
                        let f5:i64=0;let f6:i64=0;let f7:i64=0;let f8:i64=0;
                        f33_features(&st,&it,t,&f1,&f2,&f3,&f4,&f5,&f6,&f7,&f8);
                        rel=lt;
                        rcode=1;
                        if(ds==0){
                            let m:i32=f33_min(4,(f1/200)) as i32;
                            let s:i32=f33_min(3,(f6/250)) as i32;
                            let key:i32=m*4+s;
                            let cstar:i64=f33_cstar(key);
                            rconf=f33_clamp(cstar,1,999) as i32;
                            // state row: id \t m \t s \t cstar \t f8
                            dout_str(&srows,dj_id(&it));dout_byte(&srows,9);
                            dout_i64(&srows,m as i64);dout_byte(&srows,9);
                            dout_i64(&srows,s as i64);dout_byte(&srows,9);
                            dout_i64(&srows,cstar);dout_byte(&srows,9);
                            dout_i64(&srows,f8);dout_line(&srows);
                            if(srows.err!=0){ok=0;}
                        }
                        if(ds>0){
                            let iid:[]u8=dj_id(&it);
                            let r:i32=f33_state_find(iid,idbuf,idix,nrows);
                            let key:i32=0;
                            let cstar:i64=0;
                            let f81:i64=0;
                            if(r>=0){
                                key=au_get32(stm,r)*4+au_get32(sts,r);
                                cstar=au_get32(stcs,r) as i64;
                                f81=au_get32(stf8,r) as i64;
                            }
                            if(r<0){
                                // defensive: state missing (never on frozen order)
                                let m:i32=f33_min(4,(f1/200)) as i32;
                                let s:i32=f33_min(3,(f6/250)) as i32;
                                key=m*4+s;
                                cstar=f33_cstar(key);
                                f81=f8;
                            }
                            let flip:i64=0;
                            if(f3>0){flip=50;}
                            let pi:i64=f33_min(400,flip+f33_max(0,f8-f81)/8);
                            let cum:i64=f33_cum(key,ds);
                            rconf=f33_clamp(cstar+cum-pi,1,999) as i32;
                        }
                    }
                    // emit (same columns as mech.zag)
                    dout_str(&res,dj_id(&it));
                    dout_byte(&res,9);
                    dout_i64(&res,depth as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,t as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.rounds as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.consumed as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,it.ne as i64);
                    dout_byte(&res,9);
                    if(rel<0){
                        dout_str(&res,"ABSTAIN:");
                        f33_cert(rcode,&res);
                    }
                    if(rel>=0){dout_str(&res,dj_hid(&it,rel));}
                    dout_byte(&res,9);
                    if(rel<0){dout_str(&res,"A");}
                    if(rel>=0){
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(&res,"1");}
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(&res,"0");}
                    }
                    dout_byte(&res,9);
                    dout_i64(&res,rconf as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,au_get32(st.hist_l,t) as i64);
                    dout_byte(&res,9);
                    f33_cert(rcode,&res);
                    dout_line(&res);
                    if(res.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    // depth-1: append state rows to the state file (preserve earlier legs)
    if(ok==1 && ds==0 && srows.err==0){
        let oldn:i64=dlb_read_file(spath,sbuf);
        let oldln:i32=0;
        if(oldn>0){oldln=oldn as i32;}
        if(oldn<0){oldln=0;}
        let tot:i32=oldln+srows.n;
        let comb:[]u8=nio_alloc((tot+16) as i64);
        if(comb.len==0){ok=0;}
        if(ok==1){
            let sb:[]u8=dout_bytes(&srows);
            let ci:i32=0;
            while(ci<oldln){comb[ci]=sbuf[ci];ci=ci+1;}
            ci=0;
            while(ci<srows.n){comb[oldln+ci]=sb[ci];ci=ci+1;}
            let sw:i64=dlb_write_file(spath,comb,tot);
            if(sw<0){ok=0;}
            nio_free(comb);
        }
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
    }
    nio_free(ibuf);
    nio_free(spbuf);
    nio_free(idbuf);nio_free(idix);
    nio_free(stm);nio_free(sts);nio_free(stcs);nio_free(stf8);
    nio_free(sbuf);
    f33_item_free(&it);
    f33_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    dout_free(&srows);
    lg_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: policy_f33 <items.jsonl> <depth> <gate01> <results.tsv>");
        return 64;
    }
    let depth:i32=dlb_atoi(_zag_arg(2));
    let gate01:i32=dlb_atoi(_zag_arg(3));
    if(depth<1 || depth>64){return 64;}
    if(gate01<0 || gate01>1){return 64;}
    return f33_run(_zag_arg(1),depth,gate01,_zag_arg(4));
}

// deb.zag — F28 DEB (Differential Evidence Budget) shared head logic.
//
// Frozen authority: PREREG_FORKROUND.md §3 (F28) + ideas/fable_forks.md
// Mechanism A (authoritative on mechanism detail).
//
//   budget_0 = 1000
//   budget_t = clamp(budget_{t-1} + margin_t*(1000/nh) - t*1000/64, 0, 1000)
//   C        = clamp(min(budget_t, clamp(margin_t*1000/nh, 0, 1000)), 0, 1000)
//
// All integer fixed-point (thousandths).
//   margin_t = per-depth margin observable = clamp(hist_m[t], 0, 1000)
//              (the frozen §4 feature-f1 observable: deliberation margin
//              = leader score minus runner-up score, thousandths).
//   nh       = per-item hypothesis count (it.nh).
//   t        ranges over deliberation rounds 1..t_eff ("for each depth t>=1",
//              raw transcript); t_eff = min(leg depth, st.rounds), the M4
//              effective-depth convention.
// Depth-charge coefficients (t*1000/64) are STRUCTURAL constants: they are
// never fitted and can never increase during learning. F28 has no fittable
// parameters and no training phase (prereg §5: non-training fork;
// §5b TRAIN-COORD repair does not apply — coordinator note in task brief).

fn deb_clamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo){ return lo; }
    if(v > hi){ return hi; }
    return v;
}

// deb_budget: final per-item budget after iterating rounds 1..teff.
// Operands are i64; bounds: m<=1000, adiv<=1000, r<=64, so
// m*adiv<=1e6 and r*1000/64<=1000 — i64-safe. Integer division truncates
// toward zero (frozen convention).
fn deb_budget(hist_m:[]u8, teff:i32, nh:i32) i64 {
    let adiv:i64 = 1000/(nh as i64);
    let b:i64 = 1000;
    let r:i32 = 1;
    while(r <= teff){
        let m:i64 = deb_clamp(au_get64(hist_m, r), 0, 1000);
        b = deb_clamp(b + m*adiv - (r as i64)*1000/64, 0, 1000);
        r = r + 1;
    }
    return b;
}

// deb_conf: the full F28 confidence head in thousandths.
fn deb_conf(hist_m:[]u8, teff:i32, nh:i32) i32 {
    let b:i64 = deb_budget(hist_m, teff, nh);
    let mt:i64 = deb_clamp(au_get64(hist_m, teff), 0, 1000);
    let mscore:i64 = deb_clamp(mt*1000/(nh as i64), 0, 1000);
    let c:i64 = b;
    if(mscore < c){ c = mscore; }
    return deb_clamp(c, 0, 1000) as i32;
}

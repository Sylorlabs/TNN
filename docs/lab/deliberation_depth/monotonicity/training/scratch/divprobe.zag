fn tr_tdiv(a:i64,b:i64)i64 { if(a>=0){return a/b;} return -((-a)/b); }
fn main()i32 {
    let vals:i64=-1000003;
    // check tr_tdiv vs native / at a few negative/positive values
    let a:i64=-7; let b:i64=1000;
    _zag_print(_zag_i64_to_str(tr_tdiv(a,b))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(a/b)); _zag_print(" ");
    a=-1001; _zag_print(_zag_i64_to_str(tr_tdiv(a,b))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(a/b)); _zag_print(" ");
    a=-1000; _zag_print(_zag_i64_to_str(tr_tdiv(a,b))); _zag_print(" ");
    _zag_print(_zag_i64_to_str(a/b)); _zag_println("");
    return 0;
}

// dlb_util.zag — small utilities for the H5 deliberation harness.
// Pure Zag. No RNG, no timestamps, no PIDs anywhere in this file.
//
// Conventions (znc lessons, 2026-09-21/22/23):
//  - never `==` on []u8 slices; use dlb_streq (nio_equal) instead
//  - never `as []i32` / `as []u32` casts for indexed tables (ZNC-2026-09-21-007:
//    consecutive same-size casts alias); all indexed tables live in []u8
//    arenas with explicit little-endian accessors below
//  - nio_alloc zeroes, so arenas start initialized; every reuse is re-zeroed
//  - struct fields are touched only through *T function parameters

// ---- little-endian arena accessors (ZNC-007-safe) ----
fn au_put32(a:[]u8,i:i32,v:i32)void {
    let o:i32=i*4;let x:i64=(v as i64)&4294967295;
    a[o]=(x&255) as u8;a[o+1]=((x>>8)&255) as u8;
    a[o+2]=((x>>16)&255) as u8;a[o+3]=((x>>24)&255) as u8;
}
fn au_get32(a:[]u8,i:i32)i32 {
    let o:i32=i*4;
    let x:i64=(a[o] as i64)+((a[o+1] as i64)<<8)+((a[o+2] as i64)<<16)+((a[o+3] as i64)<<24);
    if(x>=2147483648){x=x-4294967296;}
    return x as i32;
}
fn au_put64(a:[]u8,i:i32,v:i64)void {
    let o:i32=i*8;let k:i32=0;
    while(k<8){a[o+k]=((v>>(k*8))&255) as u8;k=k+1;}
}
fn au_get64(a:[]u8,i:i32)i64 {
    let o:i32=i*8;let x:i64=0;let k:i32=7;
    while(k>=0){x=(x<<8)+(a[o+k] as i64);k=k-1;}
    return x;
}
fn au_zero(a:[]u8)void {
    let i:i32=0;while(i<a.len){a[i]=0;i=i+1;}
}

// ---- string helpers ----
fn dlb_streq(a:[]u8,b:[]u8)i32 { return nio_equal(a,b); }

// id alphabet for item/hypothesis/evidence ids: [0-9A-Za-z_.-], 1..64 chars.
// Constrains ledger/results output so no JSON escaping is ever needed.
fn dlb_id_ok(s:[]u8)i32 {
    if(s.len<1 || s.len>64){return 0;}
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        let ok:i32=0;
        if(c>=48 && c<=57){ok=1;}
        if(c>=65 && c<=90){ok=1;}
        if(c>=97 && c<=122){ok=1;}
        if(c==45 || c==46 || c==95){ok=1;}
        if(ok==0){return 0;}
        i=i+1;
    }
    return 1;
}

// decimal rendering of i64, owned slice, no trailing newline.
// (znc quirk, 2026-09-22: _zag_print(_zag_i64_to_str()) inside a helper can
// emit a stray newline; we never print numbers directly, but strip anyway.)
fn dlb_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    if(n<1){n=1;}
    let t:[]u8=nio_alloc(n);
    if(t.len==0){return s;}
    let i:i32=0;
    while(i<n){t[i]=s[i];i=i+1;}
    nio_free(s);
    return t;
}
fn dlb_atoi(s:[]u8)i32 {
    let v:i64=0;let neg:i32=0;let i:i32=0;let nd:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c==45 && nd==0 && neg==0){neg=1;i=i+1;continue;}
        if(c<48 || c>57){break;}
        v=v*10+((c-48) as i64);nd=nd+1;i=i+1;
    }
    if(nd==0){return 0;}
    if(neg==1){v=-v;}
    if(v>2147483647){return 2147483647;}
    if(v<-2147483648){return -2147483648;}
    return v as i32;
}

// ---- growable byte output buffer (all file/stdout output goes through this) ----
struct DOut { buf:[]u8, n:i32, cap:i32, err:i32 }
fn dout_init(o:*DOut,cap:i32)i32 {
    let b:[]u8=nio_alloc(cap);
    if(b.len==0){return -1;}
    o.*.buf=b;o.*.n=0;o.*.cap=cap;o.*.err=0;
    return 0;
}
fn dout_free(o:*DOut)void {
    let b:[]u8=o.*.buf;
    if(b.len>0){nio_free(b);}
    o.*.buf="";o.*.n=0;o.*.cap=0;
}
fn dout_str(o:*DOut,s:[]u8)void {
    if(o.*.err!=0){return;}
    if(o.*.n+s.len>o.*.cap){o.*.err=1;return;}
    let b:[]u8=o.*.buf;let at:i32=o.*.n;let i:i32=0;
    while(i<s.len){b[at+i]=s[i];i=i+1;}
    o.*.n=at+s.len;
}
fn dout_byte(o:*DOut,c:u8)void {
    if(o.*.err!=0){return;}
    if(o.*.n+1>o.*.cap){o.*.err=1;return;}
    let b:[]u8=o.*.buf;b[o.*.n]=c;o.*.n=o.*.n+1;
}
fn dout_i64(o:*DOut,v:i64)void {
    let s:[]u8=dlb_i64s(v);
    dout_str(o,s);
    nio_free(s);
}
fn dout_line(o:*DOut)void { dout_byte(o,10); }
fn dout_bytes(o:*DOut)[]u8 {
    let b:[]u8=o.*.buf;
    return b[0..o.*.n];
}

// ---- file IO (whole-file read, truncating write) ----
fn dlb_split_dir(p:[]u8,dir:[]u8,name:[]u8)i64 {
    let cut:i32=-1;let i:i32=0;
    while(i<p.len){if(p[i]==47){cut=i;}i=i+1;}
    if(cut<0){return -1;}
    let dl:i32=cut+1;let nl:i32=p.len-cut-1;
    if(dl>dir.len || nl>name.len || nl<1){return -2;}
    let k:i32=0;
    while(k<dl){dir[k]=p[k];k=k+1;}
    k=0;
    while(k<nl){name[k]=p[cut+1+k];k=k+1;}
    return ((dl as i64)*4294967296)+(nl as i64);
}

// Read whole file at path p into buf (up to buf.len bytes).
// Returns bytes read, or negative on error.
fn dlb_read_file(p:[]u8,buf:[]u8)i64 {
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir);nio_free(name);return -11;}
    let sp:i64=dlb_split_dir(p,dir,name);
    if(sp<0){
        dir[0]=46;
        if(p.len>name.len){nio_free(dir);nio_free(name);return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k];k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir);nio_free(name);return -13;}
    let fd:i64=nio_open_child(root,name[0..nl],0);
    if(fd<0){nio_free(dir);nio_free(name);return -14;}
    let n:i64=nio_read_exact(fd,buf,buf.len);
    let cr:i64=nio_close(fd);
    if(cr!=0){n=-15;}
    nio_free(dir);nio_free(name);
    return n;
}

// Truncating write of n bytes from data to path p (no O_EXCL: the 2026-09-22
// file-writer lesson — O_EXCL fails silently on existing files).
// Returns n, or negative on error.
fn dlb_write_file(p:[]u8,data:[]u8,n:i32)i64 {
    if(n<0 || n>data.len){return -21;}
    let dir:[]u8=nio_alloc(4096);
    let name:[]u8=nio_alloc(4096);
    if(dir.len!=4096 || name.len!=4096){nio_free(dir);nio_free(name);return -11;}
    let sp:i64=dlb_split_dir(p,dir,name);
    if(sp<0){
        dir[0]=46;
        if(p.len>name.len){nio_free(dir);nio_free(name);return -12;}
        let k:i32=0;
        while(k<p.len){name[k]=p[k];k=k+1;}
        sp=4294967296+(p.len as i64);
    }
    let dl:i32=(sp/4294967296) as i32;
    let nl:i32=(sp%4294967296) as i32;
    let root:i64=nio_open_root(dir[0..dl]);
    if(root<0){nio_free(dir);nio_free(name);return -13;}
    let cs:[]u8=nio_cstr(name[0..nl]);
    if(cs.len==0){nio_free(dir);nio_free(name);return -16;}
    // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC|O_NOFOLLOW = 1+64+512+524288+131072
    let fd:i64=_zag_raw_syscall(257,root,_zag_slice_ptr(cs) as i64,655937,384,0,0);
    nio_free(cs);
    if(fd<0){nio_free(dir);nio_free(name);return -17;}
    let at:i32=0;let rc:i64=0;
    while(at<n){
        let chunk:i32=n-at;
        if(chunk>1048576){chunk=1048576;}
        rc=nio_write_all(fd,data[at..at+chunk]);
        if(rc<0 || rc!=chunk){break;}
        at=at+chunk;
    }
    let cr:i64=nio_close(fd);
    nio_free(dir);nio_free(name);
    if(cr!=0){return -18;}
    if(at!=n){return -19;}
    return n as i64;
}

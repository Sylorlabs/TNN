// feat.zag — H5 training feature extractor (Crew: training).
//
// Runs the FROZEN harness deliberation (byte-identical dlb_*.zag copies)
// at fixed depths per item and emits index-level training features for the
// confidence head, plus the M4-skeleton release label and correctness.
//
// Usage: feat <items.jsonl> <family> <heldout01> <out.tsv> <d1> [d2 ...]
//
// Per (item, depth) TSV record:
//   id \t family \t heldout \t depth \t t \t rel4 \t correct4 \t f1..f8
// rel4 = 1 iff M4 would release (L_t == L_1). correct4 in {1,0,A}
// (A when rel4=0). f1..f8 = §4 features of PREREG_TRAINING.md (index-level
// only; family/heldout are measurement tags, never policy inputs).

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
fn z_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn ft_features8(st:*DSt,it:*Item,t:i32,o1:*i64,o2:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o7:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=z_clamp(mt,0,1000);
    o2.*=(t as i64)*1000/64;
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=z_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o7.*=0;
    if(nalive<=1){o7.*=1000;}
    o8.*=z_clamp(maxdrop,0,1000);
}
fn main()i32 { return 0; }

// gate.zag — H5 §6 secondary experiment: trained abstention gate.
//
// Trains g(s) = (Σ v_i·f_i)/1000 + c, release iff (L_t==L_1) AND (g(s)≥0).
// Init v_i=0, c=1000 → always release (= M4). Bar-safe by construction.
// Hinge loss per M4-released training cell:
//   [y=1]·max(0,200−g) + [y=0]·max(0,200+g)
// Subgradient: y=1 & g<200 → v_i += f_i/4, c += 250
//              y=0 & g>−200 → v_i -= f_i/4, c -= 250
// (f_i's own sign carries the direction for negative features, e.g. f4.)
//
// Schedule (PREREG_TRAINING.md §6):
//   60 epochs gate-only (conf head frozen), then
//   60 epochs joint polish at halved LR: conf DIV 4000000→8000000,
//   gate steps halved (±f_i/8, ±125).
// Conf head starts from the FROZEN 100× weights (imported via mt_params.zag).
// In the joint phase the conf head trains (§5 loss + G-batch at DIV=8000000)
// on cells released by the CURRENT joint policy (documented choice;
// numerically moot under the C≡0 absorbing state).
//
// Usage: gate <features.tsv> <passes_gate> <passes_joint> <gate_out.zag>
//        <conf_out.zag> <log_out.tsv>
//   passes_gate=10 → 60 epochs; passes_joint=10 → 60 epochs.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("mt_params.zag")

fn gt_tdiv(a:i64,b:i64)i64 {
    if(a>=0){return a/b;}
    return -((-a)/b);
}
fn gt_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn gt_famidx(fam:[]u8)i32 {
    if(dlb_streq(fam,"admit")==1){return 0;}
    if(dlb_streq(fam,"revoke")==1){return 1;}
    if(dlb_streq(fam,"logic")==1){return 2;}
    if(dlb_streq(fam,"cost")==1){return 3;}
    if(dlb_streq(fam,"P")==1){return 4;}
    if(dlb_streq(fam,"D")==1){return 5;}
    if(dlb_streq(fam,"trap")==1){return 6;}
    if(dlb_streq(fam,"O")==1){return 7;}
    if(dlb_streq(fam,"redteam")==1){return 8;}
    return -1;
}
fn gt_phase(fi:i32)i32 {
    if(fi<0){return -1;}
    if(fi<=3){return 0;}
    if(fi<=5){return 1;}
    return 2;
}
fn gt_dslot(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}
fn gt_split(line:[]u8,tabs:[]u8)void {
    let n:i32=0;
    let i:i32=0;
    while(i<line.len && n<16){
        if(line[i]==9){au_put32(tabs,n,i);n=n+1;}
        i=i+1;
    }
    au_put32(tabs,n,line.len);
}
// gate value from arena v (8 i64) and c
fn gt_gval(v:[]u8,c:i64,f:[]u8,fbase:i32)i64 {
    let acc:i64=0;
    let k:i32=0;
    while(k<8){
        acc=acc+au_get64(v,k)*(au_get32(f,fbase+k) as i64);
        k=k+1;
    }
    return gt_tdiv(acc,1000)+c;
}

fn gt_train(feat_path:[]u8,pg:i32,pj:i32,gate_path:[]u8,conf_path:[]u8,log_path:[]u8)i32 {
    let fbuf:[]u8=nio_alloc(4194304);
    if(fbuf.len==0){return 102;}
    let bn:i64=dlb_read_file(feat_path,fbuf);
    if(bn<0){nio_free(fbuf);return 102;}
    let blen:i32=bn as i32;
    let maxcells:i32=8192;
    let meta:[]u8=nio_alloc((maxcells*8*4) as i64);
    let feats:[]u8=nio_alloc((maxcells*8*4) as i64);
    let tabs:[]u8=nio_alloc(17*4);
    if(meta.len==0||feats.len==0||tabs.len==0){return 102;}
    let ncells:i32=0;
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && fbuf[e]!=10){e=e+1;}
        let line:[]u8=fbuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && ncells<maxcells){
            gt_split(line,tabs);
            let f1e:i32=au_get32(tabs,0);
            let f2e:i32=au_get32(tabs,1);
            let f3e:i32=au_get32(tabs,2);
            let f4e:i32=au_get32(tabs,3);
            let f5e:i32=au_get32(tabs,4);
            let f6e:i32=au_get32(tabs,5);
            let f7e:i32=au_get32(tabs,6);
            let fam:[]u8=line[f1e+1..f2e];
            let heldout:i32=dlb_atoi(line[f2e+1..f3e]);
            let depth:i32=dlb_atoi(line[f3e+1..f4e]);
            let rel4:i32=dlb_atoi(line[f5e+1..f6e]);
            let c4:[]u8=line[f6e+1..f7e];
            let fi:i32=gt_famidx(fam);
            let ph:i32=gt_phase(fi);
            if(heldout==1){ph=-1;}
            let y:i32=-1;
            if(rel4==1){
                y=0;
                if(c4.len==1 && c4[0]==49){y=1;}
            }
            let ci:i32=ncells;
            au_put32(meta,ci*8+0,heldout);
            au_put32(meta,ci*8+1,depth);
            au_put32(meta,ci*8+2,rel4);
            au_put32(meta,ci*8+3,y);
            au_put32(meta,ci*8+4,fi);
            au_put32(meta,ci*8+5,ph);
            au_put32(meta,ci*8+6,-1);
            au_put32(meta,ci*8+7,dlb_atoi(line[f4e+1..f5e]));
            let k:i32=0;
            while(k<8){
                let a:i32=au_get32(tabs,6+k);
                let b2:i32=au_get32(tabs,7+k);
                au_put32(feats,ci*8+k,dlb_atoi(line[a+1..b2]));
                k=k+1;
            }
            ncells=ncells+1;
        }
        pos=e+1;
    }
    // gate weights: v[8] i64, c — init 0 / 1000 (always release)
    let v:[]u8=nio_alloc(8*8);
    if(v.len==0){return 102;}
    let c:i64=1000;
    // conf head: start from frozen 100× weights (imported)
    let w:[]u8=nio_alloc(8*8);
    if(w.len==0){return 102;}
    au_put64(w,0,mt_w0());au_put64(w,1,mt_w1());au_put64(w,2,mt_w2());
    au_put64(w,3,mt_w3());au_put64(w,4,mt_w4());au_put64(w,5,mt_w5());
    au_put64(w,6,mt_w6());au_put64(w,7,mt_w7());
    let b:i64=mt_b();
    let gacc:[]u8=nio_alloc(9*7*3*8);
    if(gacc.len==0){return 102;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,8388608)!=0){return 102;}
    dout_str(&lgo,"epoch\tsubphase\tphase\thinge\tgwrong\tgcorr\tv1\tv2\tv3\tv4\tv5\tv6\tv7\tv8\tc\tw1\tw2\tw3\tw4\tw5\tw6\tw7\tw8\tb\n");
    let epoch:i32=0;
    let sub:i32=0;
    while(sub<2){
        let passes:i32=pg;
        let vstep:i32=4;
        let cstep:i64=250;
        let div:i64=4000000;
        if(sub==1){passes=pj;vstep=8;cstep=125;div=8000000;}
        let p:i32=0;
        while(p<passes){
            let ph:i32=0;
            while(ph<3){
                let ep2:i32=0;
                while(ep2<2){
                    let hinge:i64=0;
                    let gwrong:i32=0;
                    let gcorr:i32=0;
                    let i:i32=0;
                    while(i<ncells){
                        if(au_get32(meta,i*8+5)==ph && au_get32(meta,i*8+2)==1){
                            let fbase:i32=i*8;
                            let y:i32=au_get32(meta,i*8+3);
                            let g:i64=gt_gval(v,c,feats,fbase);
                            // gate update (both subphases; halved LR in joint)
                            if(y==1 && g<200){
                                hinge=hinge+(200-g);
                                let k:i32=0;
                                while(k<8){
                                    let fk:i64=au_get32(feats,fbase+k) as i64;
                                    au_put64(v,k,au_get64(v,k)+gt_tdiv(fk,vstep as i64));
                                    k=k+1;
                                }
                                c=c+cstep;
                            }
                            if(y==0 && g>-200){
                                hinge=hinge+(200+g);
                                let k2:i32=0;
                                while(k2<8){
                                    let fk2:i64=au_get32(feats,fbase+k2) as i64;
                                    au_put64(v,k2,au_get64(v,k2)-gt_tdiv(fk2,vstep as i64));
                                    k2=k2+1;
                                }
                                c=c-cstep;
                            }
                            // gate decision for the joint-policy release
                            let g2:i64=gt_gval(v,c,feats,fbase);
                            if(g2<0){
                                if(y==0){gwrong=gwrong+1;}
                                if(y==1){gcorr=gcorr+1;}
                            }
                            // conf-head update (joint phase only), on
                            // joint-released cells
                            if(sub==1 && g2>=0){
                                let yy:i64=0;
                                if(y==1){yy=1000;}
                                let acc2:i64=0;
                                let k3:i32=0;
                                while(k3<8){
                                    acc2=acc2+au_get64(w,k3)*(au_get32(feats,fbase+k3) as i64);
                                    k3=k3+1;
                                }
                                let cc:i64=gt_clamp(gt_tdiv(acc2,1000)+b,0,1000);
                                let err:i64=cc-yy;
                                let yw:i64=0;
                                if(y==0){yw=1;}
                                let k4:i32=0;
                                while(k4<8){
                                    let fk4:i64=au_get32(feats,fbase+k4) as i64;
                                    let num:i64=2*err*fk4+4*yw*cc*fk4;
                                    au_put64(w,k4,au_get64(w,k4)-gt_tdiv(num,div));
                                    k4=k4+1;
                                }
                                let nb:i64=2*err*1000+4*yw*cc*1000;
                                b=b-gt_tdiv(nb,div);
                            }
                        }
                        i=i+1;
                    }
                    // G-batch (joint phase only): over joint-released cells
                    if(sub==1){
                        let gi:i32=0;
                        while(gi<9*7*3){au_put64(gacc,gi,0);gi=gi+1;}
                        let i2:i32=0;
                        while(i2<ncells){
                            if(au_get32(meta,i2*8+5)>=0 && au_get32(meta,i2*8+2)==1){
                                let fi2:i32=au_get32(meta,i2*8+4);
                                let ds:i32=gt_dslot(au_get32(meta,i2*8+1));
                                if(fi2>=0 && ds>=0){
                                    let fb2:i32=i2*8;
                                    if(gt_gval(v,c,feats,fb2)>=0){
                                        let acc3:i64=0;
                                        let k5:i32=0;
                                        while(k5<8){
                                            acc3=acc3+au_get64(w,k5)*(au_get32(feats,fb2+k5) as i64);
                                            k5=k5+1;
                                        }
                                        let c2:i64=gt_clamp(gt_tdiv(acc3,1000)+b,0,1000);
                                        let gx:i32=(fi2*7+ds)*3;
                                        au_put64(gacc,gx,au_get64(gacc,gx)+c2);
                                        au_put64(gacc,gx+1,au_get64(gacc,gx+1)+1);
                                        if(au_get32(meta,i2*8+3)==1){
                                            au_put64(gacc,gx+2,au_get64(gacc,gx+2)+1);
                                        }
                                    }
                                }
                            }
                            i2=i2+1;
                        }
                        let fi3:i32=0;
                        while(fi3<9){
                            let prev_g:i64=0;
                            let have_prev:i32=0;
                            let s:i32=0;
                            while(s<7){
                                let gx2:i32=(fi3*7+s)*3;
                                let n2:i64=au_get64(gacc,gx2+1);
                                if(n2>0){
                                    let gth:i64=au_get64(gacc,gx2)/n2-1000*au_get64(gacc,gx2+2)/n2;
                                    if(have_prev==1 && gth>prev_g){
                                        b=b-gt_tdiv(gth-prev_g,4);
                                    }
                                    prev_g=gth;
                                    have_prev=1;
                                }
                                s=s+1;
                            }
                            fi3=fi3+1;
                        }
                    }
                    dout_i64(&lgo,epoch as i64);dout_byte(&lgo,9);
                    dout_i64(&lgo,sub as i64);dout_byte(&lgo,9);
                    dout_i64(&lgo,ph as i64);dout_byte(&lgo,9);
                    dout_i64(&lgo,hinge);dout_byte(&lgo,9);
                    dout_i64(&lgo,gwrong as i64);dout_byte(&lgo,9);
                    dout_i64(&lgo,gcorr as i64);dout_byte(&lgo,9);
                    let k6:i32=0;
                    while(k6<8){
                        dout_i64(&lgo,au_get64(v,k6));dout_byte(&lgo,9);
                        k6=k6+1;
                    }
                    dout_i64(&lgo,c);dout_byte(&lgo,9);
                    let k7:i32=0;
                    while(k7<8){
                        dout_i64(&lgo,au_get64(w,k7));dout_byte(&lgo,9);
                        k7=k7+1;
                    }
                    dout_i64(&lgo,b);
                    dout_line(&lgo);
                    epoch=epoch+1;
                    ep2=ep2+1;
                }
                ph=ph+1;
            }
            p=p+1;
        }
        sub=sub+1;
    }
    // write gate params
    let go:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&go,4096)!=0){return 102;}
    dout_str(&go,"// mt_gate — FROZEN trained abstention-gate weights\n");
    dout_str(&go,"// Generated by gate.zag (PREREG_TRAINING.md §6). Do not hand-edit.\n");
    let k8:i32=0;
    while(k8<8){
        dout_str(&go,"fn mt_v");
        dout_i64(&go,k8 as i64);
        dout_str(&go,"()i64 { return ");
        dout_i64(&go,au_get64(v,k8));
        dout_str(&go,"; }\n");
        k8=k8+1;
    }
    dout_str(&go,"fn mt_gc()i64 { return ");
    dout_i64(&go,c);
    dout_str(&go,"; }\n");
    // write conf params
    let po:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&po,4096)!=0){return 102;}
    dout_str(&po,"// mt_params — FROZEN trained confidence-head weights (post joint polish)\n");
    dout_str(&po,"// Generated by gate.zag (PREREG_TRAINING.md §6). Do not hand-edit.\n");
    let k9:i32=0;
    while(k9<8){
        dout_str(&po,"fn mt_w");
        dout_i64(&po,k9 as i64);
        dout_str(&po,"()i64 { return ");
        dout_i64(&po,au_get64(w,k9));
        dout_str(&po,"; }\n");
        k9=k9+1;
    }
    dout_str(&po,"fn mt_b()i64 { return ");
    dout_i64(&po,b);
    dout_str(&po,"; }\n");
    let wrc:i64=dlb_write_file(gate_path,dout_bytes(&go),go.n);
    let wrc2:i64=dlb_write_file(conf_path,dout_bytes(&po),po.n);
    let wrc3:i64=dlb_write_file(log_path,dout_bytes(&lgo),lgo.n);
    nio_free(fbuf);
    nio_free(meta);nio_free(feats);nio_free(tabs);
    nio_free(v);nio_free(w);nio_free(gacc);
    dout_free(&lgo);dout_free(&go);dout_free(&po);
    if(wrc<0 || wrc2<0 || wrc3<0){return 103;}
    return 0;
}

fn main()i32 {
    if(_zag_argc()<7){
        _zag_println("usage: gate <features.tsv> <passes_gate> <passes_joint> <gate_out.zag> <conf_out.zag> <log_out.tsv>");
        return 64;
    }
    let pg:i32=dlb_atoi(_zag_arg(2));
    let pj:i32=dlb_atoi(_zag_arg(3));
    if(pg<1 || pg>1000 || pj<1 || pj>1000){return 64;}
    return gt_train(_zag_arg(1),pg,pj,_zag_arg(4),_zag_arg(5),_zag_arg(6));
}

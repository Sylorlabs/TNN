// learn_schema.zag — K-B deliberate schema learner (frozen rule, ADDENDUM_V3B_JOB2_DIET_2026-09-25 §2.2).
//
// Reads the frozen K-B diet (id, f1, f5, correct, prov), accumulates per-bin
// evidence in the learner's OWN store, then makes an explicit per-bin
// DELIBERATE decision:
//   INSTALL (n >= 20): rate = round(corr*1e6/n), logged with provenance
//   ABSTAIN (n <  20): rate = d1prior 950000 (disclosed fallback), logged with reason
// Emits schema_kb.zag (fn kb_schema) + kb_decisions.tsv (the deliberation record).
// The learner's evidence ledger is discarded after emission; the emitted table
// is frozen data, imported (never recomputed) by the NEC driver.
//
// Pure Zag. Zero RNG. Deterministic.
//
// Usage: learn_schema <diet.tsv> <schema_kb.zag> <kb_decisions.tsv>

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")

fn prov_ok(prov:[]u8)i32 {
    if(prov.len<11){return 0;}
    let pre:[]u8=prov[0..11];
    let want:[]u8="kb-diet-v1:";
    return dlb_streq(pre, want);
}

fn emit_table(res:*DOut)void {
    dout_str(res, "// schema_kb.zag — FROZEN K-B learned schema (ADDENDUM_V3B_JOB2_DIET_2026-09-25 §2.2).\n");
    dout_str(res, "// Generated by learn_schema.zag from the frozen diet; DO NOT EDIT.\n");
    dout_str(res, "// Values are millionths; consulted ONLY at tp=0 (first observation).\n");
    dout_str(res, "fn kb_schema(cls:i32)i64 {\n");
}

fn learn(diet:[]u8, table_path:[]u8, dec_path:[]u8)i32 {
    let buf_bytes:i64=8*1024*1024;
    let ibuf:[]u8=nio_alloc(buf_bytes);
    if(ibuf.len==0){return 101;}
    let nr:i64=dlb_read_file(diet, ibuf);
    if(nr<0){nio_free(ibuf);return 102;}
    let n:i32=nr as i32;

    // learner's private evidence store: per-bin (correct, total)
    let cor:[]u8=nio_alloc(35*8);
    let tot:[]u8=nio_alloc(35*8);
    if(cor.len==0 || tot.len==0){nio_free(ibuf);return 103;}
    let zi:i32=0;
    while(zi<35){
        au_put64(cor, zi, 0);
        au_put64(tot, zi, 0);
        zi=zi+1;
    }

    let pos:i32=0;
    let ok:i32=1;
    let nrows:i64=0;
    while(pos<n && ok==1){
        let e:i32=pos;
        while(e<n && ibuf[e]!=10){e=e+1;}
        if(e>pos){
            let c0s:i32=pos; let c0e:i32=pos;
            let c1s:i32=0; let c1e:i32=0;
            let c2s:i32=0; let c2e:i32=0;
            let c3s:i32=0; let c3e:i32=0;
            let c4s:i32=0; let c4e:i32=0;
            let col:i32=0;
            let k:i32=pos;
            while(k<e){
                if(ibuf[k]==9){
                    if(col==0){c0e=k; c1s=k+1;}
                    else if(col==1){c1e=k; c2s=k+1;}
                    else if(col==2){c2e=k; c3s=k+1;}
                    else if(col==3){c3e=k; c4s=k+1;}
                    col=col+1;
                }
                k=k+1;
            }
            c4e=e;
            if(col==4){
                let f1s:[]u8=ibuf[c1s..c1e];
                let f5s:[]u8=ibuf[c2s..c2e];
                let corr_s:[]u8=ibuf[c3s..c3e];
                let prov:[]u8=ibuf[c4s..c4e];
                // deliberate gate: unprovenanced evidence is rejected, hard
                if(prov_ok(prov)!=1){ok=0;}
                else {
                    let f1v:i32=dlb_atoi(f1s);
                    let f5v:i32=dlb_atoi(f5s);
                    let corr:i32=dlb_atoi(corr_s);
                    let mb:i32=f1v/150;
                    if(mb>6){mb=6;}
                    let cb:i32=f5v/250;
                    if(cb>4){cb=4;}
                    let cls:i32=mb*5+cb;
                    au_put64(tot, cls, au_get64(tot, cls)+1);
                    au_put64(cor, cls, au_get64(cor, cls)+(corr as i64));
                    nrows=nrows+1;
                }
            } else { ok=0; }
        }
        pos=e+1;
    }
    if(ok!=1){nio_free(ibuf);nio_free(cor);nio_free(tot);return 201;}

    // ---- deliberate install/abstain per bin; emit table + decision log ----
    let tres:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    let dres:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&tres, 65536)!=0 || dout_init(&dres, 65536)!=0){
        nio_free(ibuf);nio_free(cor);nio_free(tot);
        return 104;
    }
    emit_table(&tres);
    dout_str(&dres, "cls\tdecision\trate_mil\tn\tcorr\tprov\n");
    let ninstall:i32=0;
    let nabstain:i32=0;
    let cls:i32=0;
    while(cls<35){
        let tt:i64=au_get64(tot, cls);
        let cc:i64=au_get64(cor, cls);
        let rate:i64=950000;
        let dec:[]u8="ABSTAIN";
        if(tt>=20){
            rate=(cc*1000000+tt/2)/tt;
            dec="INSTALL";
            ninstall=ninstall+1;
        } else {
            nabstain=nabstain+1;
        }
        // table row
        dout_str(&tres, "    if(cls==");
        dout_i64(&tres, cls as i64);
        dout_str(&tres, "){return ");
        dout_i64(&tres, rate);
        dout_str(&tres, "}\n");
        // decision log row
        dout_i64(&dres, cls as i64);
        dout_byte(&dres, 9);
        dout_str(&dres, dec);
        dout_byte(&dres, 9);
        dout_i64(&dres, rate);
        dout_byte(&dres, 9);
        dout_i64(&dres, tt);
        dout_byte(&dres, 9);
        dout_i64(&dres, cc);
        dout_byte(&dres, 9);
        dout_str(&dres, "kb-diet-v1:bin");
        if(cls<10){dout_byte(&dres, 48);}
        dout_i64(&dres, cls as i64);
        if(dlb_streq(dec, "ABSTAIN")==1){dout_str(&dres, ":insufficient-evidence");}
        dout_line(&dres);
        cls=cls+1;
    }
    dout_str(&tres, "    return 950000;\n");
    dout_str(&tres, "}\n");

    let w1:i64=dlb_write_file(table_path, dout_bytes(&tres), tres.n);
    let w2:i64=dlb_write_file(dec_path, dout_bytes(&dres), dres.n);
    nio_free(ibuf);
    nio_free(cor);
    nio_free(tot);
    dout_free(&tres);
    dout_free(&dres);
    if(w1<0 || w2<0){return 107;}
    _zag_print("rows=");
    _zag_print(dlb_i64s(nrows));
    _zag_print(" installed=");
    _zag_print(dlb_i64s(ninstall as i64));
    _zag_print(" abstained=");
    _zag_println(dlb_i64s(nabstain as i64));
    return 0;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    if(a1.len==0 || a2.len==0 || a3.len==0){
        _zag_println("usage: learn_schema <diet.tsv> <schema_kb.zag> <kb_decisions.tsv>");
        return 64;
    }
    return learn(a1, a2, a3);
}

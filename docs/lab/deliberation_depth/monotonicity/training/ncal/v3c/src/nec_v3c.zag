// nec_v3c.zag — NEC v3-development driver: variant x scale legs (B13 composition redesign).
//
// Fork of nec_v2d.zag (m20 + K-A/K-B). New variants 26/27/28 implement
// PREREG_NCAL_V3C_B13FIX_FROZEN.md §3 (+ AMENDMENT_A1_V3C.md, AMENDMENT_A2_V3C.md):
//   26 Design S  (K-C schema, min_n=1, adopted min-latch) — adoption-eligible
//   27 Design S8 (K-C schema, min_n=8, adopted min-latch) — comparison, predicted kill
//   28 Design D  (v3b K-A oracle schema + NO latch, per A2) — diagnostic, s1-only
//
// New-item (tp=0) branch for 26/27: kc_lookup(f1,f5,depth,min_n) replaces
// ka_schema/kb_schema; cl_mil = installed rate. 28: ka_schema(cls) (v3b K-A).
// tp>=1: 26/27 byte-identical to m20 (personal raw rate + min latch);
//         28: cl_mil = p_raw with NO latch (seed expires).
// nopool=1 for 26/27/28 (no class-ledger reads/writes).
// Optional argv[5] = trace path (variants 26-28 only); empty/missing = no trace.
//   tp=0 : L0\t<id>\t<f1>\t<f5>\t<depth>\t<level>\t<celln>\t<rate>
//          (variant 28: level=0 denotes the K-A oracle schema, celln=35-bin cls)
//   tp>=1: L1\t<id>\t<depth>\t<prev_cl_mil>\t<p_raw>\t<new_cl_mil>
//          (variant 28: prev_cl_mil is `-` since there is no latch)
// Output stays 6 cols (id, fam, depth, release, correct, conf_thousandths).
//
// Reads a combined TSV (id, fam, depth, f1, f5, release, correct) in frozen
// leg order. Pure Zag. Zero RNG. Deterministic. A/B byte-identical.
//
// Usage: nec_v3c <s1|s10|s100> <11|15|20|21|22|23|24|25|26|27|28> <in.tsv> <out.tsv> [trace.tsv]

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("schema_ka.zag")
@import("schema_kb.zag")
@import("schema_kc.zag")

// 35 classes * 2 i64 (c, t)
fn dout_init_dummy()DOut {
    let d:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    return d;
}
fn nec_ledger_get(ld:[]u8, cls:i32, c:*i64, t:*i64)void {
    c.*=au_get64(ld, cls*2);
    t.*=au_get64(ld, cls*2+1);
}
fn nec_ledger_put(ld:[]u8, cls:i32, c:i64, t:i64)void {
    au_put64(ld, cls*2, c);
    au_put64(ld, cls*2+1, t);
}

// Item map: fixed 64-byte ID slots, parallel i64 conf slots.
// Hash table (open addressing, FNV-1a) maps ID -> slot index.
// htab: htsize entries, each 8 bytes (i64 slot index, -1 = empty).
fn nec_hash(id:[]u8)i64 {
    let h:i64=1469598103934665603;
    let k:i32=0;
    while(k<id.len){
        h=h^(id[k] as i64);
        h=h*1099511628211;
        k=k+1;
    }
    return h;
}
fn nec_cmp_id(id:[]u8, slots:[]u8, slot:i32, ibuf:[]u8)i32 {
    // FIX1 (JOB1 red-team RT-F): slots now store (ibuf offset, full length)
    // as two i64s; compare the FULL id bytes against ibuf. The old 63-byte
    // cap made ids longer than 63 bytes never match their own slot.
    let so:i64=au_get64(slots, slot*8);
    let sl:i64=au_get64(slots, slot*8+1);
    if(sl!=(id.len as i64)){return 0;}
    let off:i32=so as i32;
    let k:i32=0;
    while(k<id.len){
        if(ibuf[off+k]!=id[k]){return 0;}
        k=k+1;
    }
    return 1;
}
// Returns slot index or -1.
fn nec_find(id:[]u8, slots:[]u8, htab:[]u8, htmask:i64, ibuf:[]u8)i32 {
    let h:i64=nec_hash(id);
    let idx:i64=h & htmask;
    while(1==1){
        let s:i64=au_get64(htab, idx);
        if(s==-1){return -1;}
        if(nec_cmp_id(id, slots, s as i32, ibuf)==1){return s as i32;}
        idx=(idx+1) & htmask;
    }
    return -1;
}
fn nec_store(id:[]u8, idoff:i32, slots:[]u8, htab:[]u8, htmask:i64, n:i32)void {
    // FIX1: store (ibuf offset, full id length); no byte copy, no 63-byte cap.
    au_put64(slots, n*8, idoff as i64);
    au_put64(slots, n*8+1, id.len as i64);
    let h:i64=nec_hash(id);
    let idx:i64=h & htmask;
    while(1==1){
        let s:i64=au_get64(htab, idx);
        if(s==-1){
            au_put64(htab, idx, n as i64);
            return;
        }
        idx=(idx+1) & htmask;
    }
}

fn nec_max_items(scale:[]u8)i32 {
    if(dlb_streq(scale,"s100")==1){return 120000;}
    if(dlb_streq(scale,"s10")==1){return 12000;}
    return 1200;
}
fn nec_buf_mb(scale:[]u8)i64 {
    if(dlb_streq(scale,"s100")==1){return 30;}
    if(dlb_streq(scale,"s10")==1){return 8;}
    return 4;
}
fn nec_run(scale:[]u8, variant:i32, in_path:[]u8, out_path:[]u8, trace_path:[]u8)i32 {
    // ---- variant parameters ----
    let p0num:i64=1900000;   // K * p0 * 1e6
    let nopool:i32=0;        // 1 = no class ledger (personal-only, m20)
    let d1prior:i64=950000;  // millionths, used when nopool && tp==0
    let gsel:i32=0;          // 1 = gaming control: bind only on wrong cells
    let know:i32=0;          // 0 = d1prior at tp==0; 1 = K-A; 2 = K-B; 3 = K-C
    let min_n:i64=1;         // K-C backoff sufficiency (Design S=1, S8=8)
    let nolatch:i32=0;       // 1 = Design D (A2): no minimum latch at tp>=1
    if(variant==15){p0num=2000000;}
    else if(variant==20){nopool=1;}
    else if(variant==21){p0num=2000000;gsel=1;}   // m_g15 (diagnostic)
    else if(variant==22){nopool=1;gsel=1;}         // m_g20 (diagnostic)
    else if(variant==23){nopool=1;d1prior=500000;} // m20_ind (light T4)
    else if(variant==24){nopool=1;know=1;}         // m20+K-A (diagnostic)
    else if(variant==25){nopool=1;know=2;}         // m20+K-B
    else if(variant==26){nopool=1;know=3;min_n=1;} // Design S (v3c)
    else if(variant==27){nopool=1;know=3;min_n=8;}// Design S8 (v3c)
    else if(variant==28){nopool=1;know=1;nolatch=1;} // Design D (A2: K-A + no latch)
    else if(variant!=11){return 110;}
    let trace_on:i32=0;
    if(variant>=26 && variant<=28 && trace_path.len>0){trace_on=1;}
    let max_items:i32=nec_max_items(scale);
    let buf_bytes:i64=nec_buf_mb(scale)*1024*1024;
    // hash table size: pow2 >= max_items*2
    let htsize:i64=2;
    while(htsize < (max_items as i64)*2){htsize=htsize*2;}
    let htmask:i64=htsize-1;
    // Read input
    let ibuf:[]u8=nio_alloc(buf_bytes);
    if(ibuf.len==0){return 101;}
    let nr:i64=dlb_read_file(in_path, ibuf);
    if(nr<0){nio_free(ibuf);return 102;}
    let n:i32=nr as i32;

    // Ledger: 35*16 = 560 bytes, zeroed by nio_alloc
    let ld:[]u8=nio_alloc(35*16);
    if(ld.len==0){nio_free(ibuf);return 103;}

    // Item map: 1200 slots
    let slots:[]u8=nio_alloc((max_items as i64)*64);
    if(slots.len==0){nio_free(ibuf);nio_free(ld);return 104;}
    let confs:[]u8=nio_alloc((max_items as i64)*8);
    if(confs.len==0){nio_free(ibuf);nio_free(ld);nio_free(slots);return 105;}
    // personal ledger: per-item (cp, tp), explicitly zeroed
    let pcp:[]u8=nio_alloc((max_items as i64)*8);
    if(pcp.len==0){nio_free(ibuf);nio_free(ld);nio_free(slots);nio_free(confs);return 108;}
    let ptp:[]u8=nio_alloc((max_items as i64)*8);
    if(ptp.len==0){nio_free(ibuf);nio_free(ld);nio_free(slots);nio_free(confs);nio_free(pcp);return 109;}
    let htab:[]u8=nio_alloc(htsize*8);
    if(htab.len==0){nio_free(ibuf);nio_free(ld);nio_free(slots);nio_free(confs);nio_free(pcp);nio_free(ptp);return 110;}
    let hi:i64=0;
    while(hi<htsize){
        au_put64(htab, hi, -1);
        hi=hi+1;
    }
    let zi:i32=0;
    while(zi<max_items){
        au_put64(pcp, zi, 0);
        au_put64(ptp, zi, 0);
        au_put64(confs, zi, 0);
        zi=zi+1;
    }
    let n_items:i32=0;

    // Output
    let res:DOut=dout_init_dummy();
    if(dout_init(&res, buf_bytes)!=0){
        nio_free(ibuf);nio_free(ld);nio_free(slots);nio_free(confs);nio_free(pcp);nio_free(ptp);nio_free(htab);
        return 106;
    }
    // Trace output (variants 26-28 only)
    let tres:DOut=dout_init_dummy();
    if(trace_on==1){
        if(dout_init(&tres, buf_bytes)!=0){
            nio_free(ibuf);nio_free(ld);nio_free(slots);nio_free(confs);nio_free(pcp);nio_free(ptp);nio_free(htab);
            dout_free(&res);
            return 111;
        }
    }

    let pos:i32=0;
    let ok:i32=1;
    while(pos<n && ok==1){
        // find line end
        let e:i32=pos;
        while(e<n && ibuf[e]!=10){e=e+1;}
        if(e>pos){
            // parse 7 tab-separated cols
            // col boundaries
            let c0s:i32=pos; let c0e:i32=pos;
            let c1s:i32=0; let c1e:i32=0;
            let c2s:i32=0; let c2e:i32=0;
            let c3s:i32=0; let c3e:i32=0;
            let c4s:i32=0; let c4e:i32=0;
            let c5s:i32=0; let c5e:i32=0;
            let c6s:i32=0; let c6e:i32=0;
            let col:i32=0;
            let cs:i32=pos;
            let k:i32=pos;
            while(k<e){
                if(ibuf[k]==9){
                    if(col==0){c0e=k; c1s=k+1;}
                    else if(col==1){c1e=k; c2s=k+1;}
                    else if(col==2){c2e=k; c3s=k+1;}
                    else if(col==3){c3e=k; c4s=k+1;}
                    else if(col==4){c4e=k; c5s=k+1;}
                    else if(col==5){c5e=k; c6s=k+1;}
                    col=col+1;
                }
                k=k+1;
            }
            c6e=e;
            if(col==6){
                let id:[]u8=ibuf[c0s..c0e];
                let fam:[]u8=ibuf[c1s..c1e];
                let depth_s:[]u8=ibuf[c2s..c2e];
                let f1:[]u8=ibuf[c3s..c3e];
                let f5:[]u8=ibuf[c4s..c4e];
                let rel_s:[]u8=ibuf[c5s..c5e];
                let corr_s:[]u8=ibuf[c6s..c6e];
                let f1v:i32=dlb_atoi(f1);
                let f5v:i32=dlb_atoi(f5);
                let dep_int:i32=dlb_atoi(depth_s);
                let rel:i32=dlb_atoi(rel_s);
                let corr:i32=dlb_atoi(corr_s);

                let conf:i64=0;
                if(rel==1){
                    let mb:i32=f1v/150;
                    if(mb>6){mb=6;}
                    let cb:i32=f5v/250;
                    if(cb>4){cb=4;}
                    let cls:i32=mb*5+cb;
                    let c:i64=0; let t:i64=0;
                    if(nopool==0){nec_ledger_get(ld, cls, &c, &t);}
                    // conf in millionths: class ledger (c*1e6 + p0num)/(t+2),
                    // or personal-only for variant 20 (verbatim from nec_q1.zag).
                    let cl_mil:i64=0;
                    // item lookup first (personal ledger + ceiling memory)
                    let idx:i32=nec_find(id, slots, htab, htmask, ibuf);
                    if(idx>=0){
                        let tp:i64=au_get64(ptp, idx);
                        let p_raw:i64=0;
                        if(nopool==1){
                            if(tp>=1){
                                let cp:i64=au_get64(pcp, idx);
                                p_raw=(cp*1000000)/tp;
                                cl_mil=p_raw;
                                // m_g20: spare correct cells (diagnostic)
                                if(gsel==1 && corr==1 && cl_mil<d1prior){cl_mil=d1prior;}
                            } else {
                                cl_mil=d1prior;
                            }
                        } else {
                            cl_mil=(c*1000000+p0num)/(t+2);
                            if(tp>=1){
                                let cp:i64=au_get64(pcp, idx);
                                p_raw=(cp*1000000)/tp;
                                // m_g15: cap binds only on wrong cells (diagnostic)
                                if(gsel==1){
                                    if(corr==0 && cl_mil>p_raw){cl_mil=p_raw;}
                                } else {
                                    if(cl_mil>p_raw){cl_mil=p_raw;}
                                }
                            }
                        }
                        let pc:i64=au_get64(confs, idx);
                        // Design D (variant 28, A2): no minimum latch —
                        // the seed expires; conf = p_raw.
                        if(nolatch==0 && cl_mil>pc){cl_mil=pc;}
                        if(trace_on==1){
                            dout_str(&tres, "L1\t");
                            dout_str(&tres, id);
                            dout_byte(&tres, 9);
                            dout_str(&tres, depth_s);
                            dout_byte(&tres, 9);
                            if(nolatch==1){dout_str(&tres, "-");}
                            else {dout_i64(&tres, pc);}
                            dout_byte(&tres, 9);
                            dout_i64(&tres, p_raw);
                            dout_byte(&tres, 9);
                            dout_i64(&tres, cl_mil);
                            dout_line(&tres);
                        }
                        au_put64(confs, idx, cl_mil);
                        // personal ledger update (AFTER conf)
                        tp=tp+1;
                        let cp2:i64=au_get64(pcp, idx);
                        if(corr==1){cp2=cp2+1;}
                        au_put64(ptp, idx, tp);
                        au_put64(pcp, idx, cp2);
                    } else {
                        if(n_items<max_items){
                            // first observation: base confidence, no ceiling.
                            // K-A/K-B/K-C: frozen per-class schema replaces
                            // d1prior at exactly this step; below unchanged.
                            if(nopool==1){
                                if(know==1){cl_mil=ka_schema(cls);}
                                else if(know==2){cl_mil=kb_schema(cls);}
                                else if(know==3){
                                    let krate:i64=0;
                                    let klevel:i32=0;
                                    let kcelln:i64=0;
                                    kc_lookup(f1v, f5v, dep_int, min_n, &krate, &klevel, &kcelln);
                                    cl_mil=krate;
                                    if(trace_on==1){
                                        dout_str(&tres, "L0\t");
                                        dout_str(&tres, id);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, f1v as i64);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, f5v as i64);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, dep_int as i64);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, klevel as i64);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, kcelln);
                                        dout_byte(&tres, 9);
                                        dout_i64(&tres, krate);
                                        dout_line(&tres);
                                    }
                                }
                                else {cl_mil=d1prior;}
                                // variant 28 (A2): tp=0 uses K-A; trace the
                                // oracle bin lookup (level=0 marks K-A)
                                if(trace_on==1 && know==1 && nolatch==1){
                                    dout_str(&tres, "L0\t");
                                    dout_str(&tres, id);
                                    dout_byte(&tres, 9);
                                    dout_i64(&tres, f1v as i64);
                                    dout_byte(&tres, 9);
                                    dout_i64(&tres, f5v as i64);
                                    dout_byte(&tres, 9);
                                    dout_i64(&tres, dep_int as i64);
                                    dout_byte(&tres, 9);
                                    dout_str(&tres, "0");
                                    dout_byte(&tres, 9);
                                    dout_i64(&tres, cls as i64);
                                    dout_byte(&tres, 9);
                                    dout_i64(&tres, cl_mil);
                                    dout_line(&tres);
                                }
                            } else {
                                cl_mil=(c*1000000+p0num)/(t+2);
                            }
                            nec_store(id, c0s, slots, htab, htmask, n_items);
                            au_put64(confs, n_items, cl_mil);
                            // seed personal ledger with this first observation
                            au_put64(ptp, n_items, 1);
                            if(corr==1){au_put64(pcp, n_items, 1);}
                            n_items=n_items+1;
                        } else { ok=0; }
                    }
                    // output in thousandths
                    conf=cl_mil/1000;
                    // class ledger update (AFTER conf; variants 11/15 only)
                    if(nopool==0){
                        t=t+1;
                        if(corr==1){c=c+1;}
                        nec_ledger_put(ld, cls, c, t);
                    }
                }
                // output: id, fam, depth, release, correct, conf
                dout_str(&res, id); dout_byte(&res, 9);
                dout_str(&res, fam); dout_byte(&res, 9);
                dout_str(&res, depth_s); dout_byte(&res, 9);
                dout_str(&res, rel_s); dout_byte(&res, 9);
                dout_str(&res, corr_s); dout_byte(&res, 9);
                dout_i64(&res, conf); dout_line(&res);
                if(res.err!=0){ok=0;}
            }
        }
        pos=e+1;
    }

    let wrc:i64=0;
    if(ok==1 && res.err==0){wrc=dlb_write_file(out_path, dout_bytes(&res), res.n);}
    let wtr:i64=0;
    if(trace_on==1 && ok==1 && tres.err==0){
        wtr=dlb_write_file(trace_path, dout_bytes(&tres), tres.n);
    }
    nio_free(ibuf);
    nio_free(ld);
    nio_free(slots);
    nio_free(confs);
    nio_free(pcp);
    nio_free(ptp);
    nio_free(htab);
    dout_free(&res);
    if(trace_on==1){dout_free(&tres);}
    if(ok==0 || wrc<0){return 107;}
    if(trace_on==1 && wtr<0){return 112;}
    return 0;
}

fn main()i32 {
    // NOTE: _zag_argc() is 0 per ZNC-2026-09-21-007; read args unconditionally.
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    let a4:[]u8=_zag_arg(4);
    let a5:[]u8=_zag_arg(5);
    if(a1.len==0 || a2.len==0 || a3.len==0 || a4.len==0){
        _zag_println("usage: nec_v3c <s1|s10|s100> <11|15|20|21|22|23|24|25|26|27|28> <in.tsv> <out.tsv> [trace.tsv]");
        return 64;
    }
    if(dlb_streq(a1,"s1")!=1 && dlb_streq(a1,"s10")!=1 && dlb_streq(a1,"s100")!=1){
        _zag_println("scale must be s1, s10, or s100");
        return 65;
    }
    let variant:i32=dlb_atoi(a2);
    if(variant!=11 && variant!=15 && variant!=20 && variant!=21 && variant!=22 && variant!=23 && variant!=24 && variant!=25 && variant!=26 && variant!=27 && variant!=28){
        _zag_println("variant must be 11, 15, 20, 21, 22, 23, 24, 25, 26, 27, or 28");
        return 66;
    }
    return nec_run(a1, variant, a3, a4, a5);
}

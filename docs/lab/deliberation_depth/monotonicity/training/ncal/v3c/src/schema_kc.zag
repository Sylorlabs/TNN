fn kc_l3(dep:i32, tot:*i64, rate:*i64)i32 {
    if(dep==1){tot.*=1000;rate.*=802000;return 1;}
    if(dep==2){tot.*=948;rate.*=845992;return 1;}
    if(dep==4){tot.*=857;rate.*=934656;return 1;}
    if(dep==8){tot.*=821;rate.*=962241;return 1;}
    if(dep==16){tot.*=801;rate.*=973783;return 1;}
    if(dep==32){tot.*=30;rate.*=666667;return 1;}
    if(dep==64){tot.*=10;rate.*=1000000;return 1;}
    return 0;
}
fn kc_lookup(f1:i32, f5:i32, dep:i32, min_n:i64, rate:*i64, level:*i32, celln:*i64)void {
    let t:i64=0;
    let r:i64=0;
    if(kc_l1(f1, f5, dep, &t, &r)==1){
        if(t>=min_n){rate.*=r;level.*=1;celln.*=t;return;}
    }
    if(kc_l2(f1, f5, &t, &r)==1){
        if(t>=min_n){rate.*=r;level.*=2;celln.*=t;return;}
    }
    if(kc_l3(dep, &t, &r)==1){
        if(t>=min_n){rate.*=r;level.*=3;celln.*=t;return;}
    }
    rate.*=896575;level.*=4;celln.*=4467;
}

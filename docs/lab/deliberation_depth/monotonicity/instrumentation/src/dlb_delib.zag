// dlb_delib.zag — the deliberative judgment procedure (H5 harness, Phase 1).
//
// This is the genuine judgment mechanism, not a stub. For each item it runs
// iterative deliberation rounds. Each round may:
//   EVIDENCE  — consume the next evidence item (payload order, deterministic)
//               and add its supports/attacks to the alive hypotheses' scores
//   ELIMINATE — drop every alive hypothesis trailing the leader by >= elim_margin
//   TEST      — attempt to refute the runner-up: scan consumed evidence for a
//               decisive attack (weight >= refute_threshold); a hit eliminates it
//   STOP      — fixed round count (shallow/deep) or the deterministic adaptive
//               rule, DEPTH_DEF.md §6 verbatim (§12 amendment, harness_v2):
//               per-round absolute confidence gains g_i = |c_i - c_{i-1}|
//               (c_0 := c_1); stop iff r >= k and all of g_{r-k+1}..g_r < eps;
//               hard cap at adaptive_max_rounds (recorded). Confidence drops
//               never count as settled. Earliest stop: round k.
//               H5B adds mode=bound: the RESIDUAL-FLIP BOUND. Stop iff the
//               round cap is hit (recorded, same as adaptive) or the
//               remaining unconsumed evidence provably cannot flip the
//               current leader: for leader L and each alive runner-up R,
//               maxR = S_R + remaining supports(R), minL = S_L - remaining
//               attacks(L); R cannot overtake L iff maxR < minL, or
//               (maxR == minL and R > L) since ties break to the lower index.
//               Dead hypotheses never return; mid-stream eliminations only
//               remove contenders; the leader can only lose by score
//               overtake. Vacuously true with no alive runner-up (then the
//               leader is final). The bound-stop verdict always equals the
//               run-to-exhaustion verdict. Per-evidence weight ceiling is
//               500/link by construction (fixed per-type weights in the
//               encoding specs); the bound sums actual remaining weights,
//               which fires whenever any ceiling*count variant would.
//               A round that changes nothing also stops (natural termination).
//               Every run records its stop cause in the VERDICT detail as
//               stop=fixed|six|bound|natural|cap (first cause wins).
//
// Scores are fixed-point thousandths (i64). Ties break to the lowest
// hypothesis index. Evidence order is payload order. Zero RNG, no wall-clock,
// no PIDs: the same item + config always yields the same verdict, confidence,
// rounds, evidence count, and ledger bytes.

struct DSt {
    scores:[]u8, alive:[]u8, hist_l:[]u8, hist_m:[]u8, hist_c:[]u8,
    rounds:i32, consumed:i32, leader:i32, margin:i64, conf:i32, hcap:i32
}
fn dlb_nalive(st:*DSt,nh:i32)i32 {
    let alive:[]u8=st.*.alive;
    let n:i32=0;let i:i32=0;
    while(i<nh){if(alive[i]==1){n=n+1;}i=i+1;}
    return n;
}
// recompute leader/runner-up/margin; ties -> lowest index.
// margin with no runner-up = leader score (baseline 0 = "no contender").
fn dlb_leader(st:*DSt,it:*Item)void {
    let nh:i32=it.*.nh;
    let scores:[]u8=st.*.scores;let alive:[]u8=st.*.alive;
    let best:i32=-1;let second:i32=-1;
    let bs:i64=0;let ss:i64=-4000000000000000000;let have:i32=0;
    let i:i32=0;
    while(i<nh){
        if(alive[i]==1){
            let sc:i64=au_get64(scores,i);
            if(have==0){have=1;best=i;bs=sc;}
            if(have==1 && sc>bs){second=best;ss=bs;best=i;bs=sc;}
            if(have==1 && sc<=bs && i!=best && sc>ss){second=i;ss=sc;}
        }
        i=i+1;
    }
    st.*.leader=best;
    if(second<0){st.*.margin=bs;}
    if(second>=0){st.*.margin=bs-ss;}
}
fn dlb_apply_evidence(st:*DSt,it:*Item,e:i32)void {
    let scores:[]u8=st.*.scores;let alive:[]u8=st.*.alive;
    let k:i32=0;let ns:i32=dj_sup_n(it,e);
    while(k<ns){
        let h:i32=dj_sup_h(it,e,k);let w:i32=dj_sup_w(it,e,k);
        if(alive[h]==1){au_put64(scores,h,au_get64(scores,h)+(w as i64));}
        k=k+1;
    }
    k=0;
    let na:i32=dj_att_n(it,e);
    while(k<na){
        let h:i32=dj_att_h(it,e,k);let w:i32=dj_att_w(it,e,k);
        if(alive[h]==1){au_put64(scores,h,au_get64(scores,h)-(w as i64));}
        k=k+1;
    }
}
fn dlb_second(st:*DSt,it:*Item)i32 {
    let nh:i32=it.*.nh;
    let scores:[]u8=st.*.scores;let alive:[]u8=st.*.alive;
    let best:i32=st.*.leader;
    let bs:i64=au_get64(scores,best);
    let second:i32=-1;let ss:i64=bs;let have:i32=0;
    let i:i32=0;
    while(i<nh){
        if(alive[i]==1 && i!=best){
            let sc:i64=au_get64(scores,i);
            if(have==0){have=1;second=i;ss=sc;}
            if(have==1 && sc>ss){second=i;ss=sc;}
        }
        i=i+1;
    }
    return second;
}
// Residual-flip bound (H5B, mode=bound): 1 iff the remaining unconsumed
// evidence provably cannot flip the current leader. For leader L and each
// alive runner-up R: maxR = S_R + sum of remaining supports for R,
// minL = S_L - sum of remaining attacks on L. R cannot overtake L iff
// maxR < minL, or (maxR == minL and R > L) since ties break to the lowest
// hypothesis index. Attacks on R and supports for L are omitted (they only
// help L's case); dead hypotheses never return; mid-stream eliminations only
// remove contenders; the leader never trails itself, so it can only lose the
// lead by being overtaken in score. Vacuously true with no alive runner-up.
fn dlb_bound_fires(st:*DSt,it:*Item)i32 {
    let scores:[]u8=st.*.scores;let alive:[]u8=st.*.alive;
    let nh:i32=it.*.nh;let ne:i32=it.*.ne;let c:i32=st.*.consumed;
    let L:i32=-1;let bs:i64=0;
    let h:i32=0;
    while(h<nh){
        if(alive[h]==1){
            let sc:i64=au_get64(scores,h);
            if(L<0 || sc>bs){L=h;bs=sc;}
        }
        h=h+1;
    }
    if(L<0){return 1;}
    let atkL:i64=0;
    let e:i32=c;
    while(e<ne){
        let na:i32=dj_att_n(it,e);let k:i32=0;
        while(k<na){
            if(dj_att_h(it,e,k)==L){atkL=atkL+(dj_att_w(it,e,k) as i64);}
            k=k+1;
        }
        e=e+1;
    }
    let minL:i64=bs-atkL;
    let R:i32=0;
    while(R<nh){
        if(R!=L && alive[R]==1){
            let sR:i64=au_get64(scores,R);
            let supR:i64=0;
            let f:i32=c;
            while(f<ne){
                let ns:i32=dj_sup_n(it,f);let j:i32=0;
                while(j<ns){
                    if(dj_sup_h(it,f,j)==R){supR=supR+(dj_sup_w(it,f,j) as i64);}
                    j=j+1;
                }
                f=f+1;
            }
            let maxR:i64=sR+supR;
            let ok:i32=0;
            if(maxR<minL){ok=1;}
            if(maxR==minL && R>L){ok=1;}
            if(ok==0){return 0;}
        }
        R=R+1;
    }
    return 1;
}
// (dlb_stable removed in harness_v2: DEPTH_DEF §6 has no leader-stability
// condition. conf_threshold and stability_window remain required config keys
// but are ignored by the §6 adaptive rule.)
// detail builders (JSON-safe alphabet only)
fn dlb_td_reset(td:*DOut)void { td.*.n=0;td.*.err=0; }
fn dlb_d_begin(td:*DOut,it:*Item,cfg:*DCfg)void {
    dout_str(td,"nh=");dout_i64(td,it.*.nh as i64);
    dout_str(td," ne=");dout_i64(td,it.*.ne as i64);
    dout_str(td," mode=");dout_str(td,dlb_cfg_mode_name(cfg.*.mode));
}
fn dlb_d_ev(td:*DOut,it:*Item,e:i32,c:i32)void {
    dout_str(td,"e=");dout_str(td,dj_eid(it,e));
    dout_str(td," c=");dout_i64(td,c as i64);
}
fn dlb_d_elim(td:*DOut,it:*Item,h:i32,by:i32,d:i64)void {
    dout_str(td,"h=");dout_str(td,dj_hid(it,h));
    dout_str(td," by=");dout_str(td,dj_hid(it,by));
    dout_str(td," d=");dout_i64(td,d);
}
fn dlb_d_test(td:*DOut,it:*Item,h:i32,refuted:i32,w:i32)void {
    dout_str(td,"h=");dout_str(td,dj_hid(it,h));
    if(refuted==1){dout_str(td," refuted w=");dout_i64(td,w as i64);}
    if(refuted==0){dout_str(td," holds");}
}
fn dlb_d_round(td:*DOut,it:*Item,r:i32,leader:i32,margin:i64,conf:i32)void {
    dout_str(td,"r=");dout_i64(td,r as i64);
    dout_str(td," leader=");dout_str(td,dj_hid(it,leader));
    dout_str(td," margin=");dout_i64(td,margin);
    dout_str(td," conf=");dout_i64(td,conf as i64);
}
// WB-TRACE (white-box instrumentation, monotonicity/instrumentation only):
// per-round trace row: r, leader, conf, margin, leader raw score (lscore),
// runner-up raw score (rscore, -1 if none), evidence consumed (ev), live
// hypotheses (nalive), eliminations this round (elim), residual-flip bound
// signal (bound, 0/1), ground-truth hypothesis rank by score among the alive
// (gtrank, -1 if GT not alive/found; ties break to lowest index, same as the
// leader rule), whether the leader is the GT (correct, 0/1), absolute
// confidence gain vs the previous round (gain; 0 at round 1).
fn dlb_d_trace(td:*DOut,it:*Item,r:i32,leader:i32,conf:i32,margin:i64,ls:i64,rs:i64,ev:i32,nalive:i32,elimr:i32,bf:i32,gtrank:i32,corr:i32,gain:i64)void {
    dout_str(td,"r=");dout_i64(td,r as i64);
    dout_str(td," leader=");dout_str(td,dj_hid(it,leader));
    dout_str(td," conf=");dout_i64(td,conf as i64);
    dout_str(td," margin=");dout_i64(td,margin);
    dout_str(td," lscore=");dout_i64(td,ls);
    dout_str(td," rscore=");dout_i64(td,rs);
    dout_str(td," ev=");dout_i64(td,ev as i64);
    dout_str(td," nalive=");dout_i64(td,nalive as i64);
    dout_str(td," elim=");dout_i64(td,elimr as i64);
    dout_str(td," bound=");dout_i64(td,bf as i64);
    dout_str(td," gtrank=");dout_i64(td,gtrank as i64);
    dout_str(td," correct=");dout_i64(td,corr as i64);
    dout_str(td," gain=");dout_i64(td,gain);
}
fn dlb_d_verdict(td:*DOut,it:*Item,leader:i32,conf:i32,rounds:i32,ev:i32,cap:i32,why:[]u8,gt:[]u8,correct:i32)void {
    dout_str(td,"verdict=");dout_str(td,dj_hid(it,leader));
    dout_str(td," conf=");dout_i64(td,conf as i64);
    dout_str(td," rounds=");dout_i64(td,rounds as i64);
    dout_str(td," ev=");dout_i64(td,ev as i64);
    dout_str(td," cap=");dout_i64(td,cap as i64);
    dout_str(td," stop=");dout_str(td,why);
    dout_str(td," gt=");dout_str(td,gt);
    dout_str(td," correct=");dout_i64(td,correct as i64);
}

// Run deliberation for one item. Fills st.rounds/consumed/leader/conf.
// Returns 0 on success, negative on ledger error.
fn dlb_run(st:*DSt,it:*Item,cfg:*DCfg,lg:*LG,lgo:*DOut)i32 {
    let nh:i32=it.*.nh;let ne:i32=it.*.ne;
    au_zero(st.*.scores);
    let alive:[]u8=st.*.alive;
    let ai:i32=0;
    while(ai<nh){alive[ai]=1;ai=ai+1;}
    st.*.rounds=0;st.*.consumed=0;st.*.leader=-1;st.*.margin=0;st.*.conf=0;
    let iid:[]u8=dj_id(it);
    let td:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&td,512)!=0){return -1;}
    dlb_d_begin(&td,it,cfg);
    let rc:i32=lg_step(lg,lgo,iid,0,"BEGIN",dout_bytes(&td));
    if(rc!=0){dout_free(&td);return rc;}
    let stop:i32=0;
    let cap:i32=0; // §12 amendment: 1 iff adaptive stop was the round cap
    let stopwhy:i32=0; // H5B: stop cause — 1 fixed, 2 six, 3 bound, 4 natural, 5 cap; first cause wins
    while(stop==0){
        let nalive:i32=dlb_nalive(st,nh);
        let can_ev:i32=0;
        if(st.*.consumed<ne && st.*.consumed<cfg.*.evcap){can_ev=1;}
        if(can_ev==0 && nalive<=1){stop=1;stopwhy=4;}
        if(stop==0){
            st.*.rounds=st.*.rounds+1;
            let r:i32=st.*.rounds;
            let progress:i32=0;
            let elimr:i32=0; // WB: eliminations this round (ELIMINATE phase + TEST refutation)
            if(can_ev==1){
                let e:i32=st.*.consumed;
                dlb_apply_evidence(st,it,e);
                st.*.consumed=e+1;
                progress=1;
                dlb_td_reset(&td);
                dlb_d_ev(&td,it,e,st.*.consumed);
                rc=lg_step(lg,lgo,iid,r,"EVIDENCE",dout_bytes(&td));
                if(rc!=0){dout_free(&td);return rc;}
            }
            dlb_leader(st,it);
            let best:i32=st.*.leader;
            let scores:[]u8=st.*.scores;
            let bs:i64=au_get64(scores,best);
            let h2:i32=0;
            while(h2<nh){
                if(alive[h2]==1 && h2!=best){
                    let d:i64=bs-au_get64(scores,h2);
                    if(d>=(cfg.*.elim_margin as i64)){
                        alive[h2]=0;
                        progress=1;
                        elimr=elimr+1;
                        dlb_td_reset(&td);
                        dlb_d_elim(&td,it,h2,best,d);
                        rc=lg_step(lg,lgo,iid,r,"ELIMINATE",dout_bytes(&td));
                        if(rc!=0){dout_free(&td);return rc;}
                    }
                }
                h2=h2+1;
            }
            dlb_leader(st,it);
            let second:i32=dlb_second(st,it);
            if(second>=0){
                let refuted:i32=0;let rw:i32=0;
                let e2:i32=0;
                while(e2<st.*.consumed && refuted==0){
                    let k:i32=0;let na:i32=dj_att_n(it,e2);
                    while(k<na && refuted==0){
                        if(dj_att_h(it,e2,k)==second && dj_att_w(it,e2,k)>=cfg.*.refute_thr){
                            refuted=1;rw=dj_att_w(it,e2,k);
                        }
                        k=k+1;
                    }
                    e2=e2+1;
                }
                if(refuted==1){alive[second]=0;progress=1;elimr=elimr+1;}
                dlb_td_reset(&td);
                dlb_d_test(&td,it,second,refuted,rw);
                rc=lg_step(lg,lgo,iid,r,"TEST",dout_bytes(&td));
                if(rc!=0){dout_free(&td);return rc;}
            }
            dlb_leader(st,it);
            let nalive2:i32=dlb_nalive(st,nh);
            if(nalive2<=1){st.*.conf=1000;}
            if(nalive2>1){
                let m:i64=st.*.margin;
                if(m<0){m=0;}
                if(m>1000){m=1000;}
                st.*.conf=m as i32;
            }
            au_put32(st.*.hist_l,r,st.*.leader);
            au_put64(st.*.hist_m,r,st.*.margin);
            au_put32(st.*.hist_c,r,st.*.conf);
            if(r==1){au_put32(st.*.hist_c,0,st.*.conf);} // §6: c_0 := c_1
            dlb_td_reset(&td);
            dlb_d_round(&td,it,r,st.*.leader,st.*.margin,st.*.conf);
            rc=lg_step(lg,lgo,iid,r,"ROUND",dout_bytes(&td));
            if(rc!=0){dout_free(&td);return rc;}
            // ---- WB-TRACE: per-round white-box trace row ----
            let wb_l:i32=st.*.leader;
            let wb_ls:i64=au_get64(scores,wb_l);
            let wb_sec:i32=dlb_second(st,it);
            let wb_rs:i64=-1;
            if(wb_sec>=0){wb_rs=au_get64(scores,wb_sec);}
            let wb_bf:i32=dlb_bound_fires(st,it);
            let wb_gain:i64=0;
            if(r>=2){
                let wb_pc:i64=au_get32(st.*.hist_c,r-1) as i64;
                wb_gain=(st.*.conf as i64)-wb_pc;
                if(wb_gain<0){wb_gain=-wb_gain;}
            }
            let wb_gti:i32=dj_hlookup(it,dj_gt(it));
            let wb_gtrank:i32=-1;
            if(wb_gti>=0){
                if(alive[wb_gti]==1){
                    wb_gtrank=1;
                    let wb_gtsc:i64=au_get64(scores,wb_gti);
                    let wb_j:i32=0;
                    while(wb_j<nh){
                        if(wb_j!=wb_gti && alive[wb_j]==1){
                            let wb_sj:i64=au_get64(scores,wb_j);
                            if(wb_sj>wb_gtsc){wb_gtrank=wb_gtrank+1;}
                            if(wb_sj==wb_gtsc && wb_j<wb_gti){wb_gtrank=wb_gtrank+1;}
                        }
                        wb_j=wb_j+1;
                    }
                }
            }
            let wb_corr:i32=0;
            if(dlb_streq(dj_hid(it,wb_l),dj_gt(it))==1){wb_corr=1;}
            dlb_td_reset(&td);
            dlb_d_trace(&td,it,r,wb_l,st.*.conf,st.*.margin,wb_ls,wb_rs,st.*.consumed,nalive2,elimr,wb_bf,wb_gtrank,wb_corr,wb_gain);
            rc=lg_step(lg,lgo,iid,r,"TRACE",dout_bytes(&td));
            if(rc!=0){dout_free(&td);return rc;}
            if(cfg.*.mode==0 && r>=cfg.*.shallow_rounds){stop=1;if(stopwhy==0){stopwhy=1;}}
            if(cfg.*.mode==1 && r>=cfg.*.deep_rounds){stop=1;if(stopwhy==0){stopwhy=1;}}
            if(cfg.*.mode==2){
                // DEPTH_DEF §6 verbatim (§12 amendment): per-round absolute
                // confidence gains g_i = |c_i - c_{i-1}| with c_0 := c_1
                // (hist_c slot 0). Stop iff r >= k and every one of the last
                // k gains is < eps. A confidence DROP never counts as settled
                // (absolute value). Earliest stop: round k. Cap is recorded.
                if(r>=cfg.*.amax){stop=1;cap=1;if(stopwhy==0){stopwhy=5;}}
                if(stop==0){
                    let k:i32=cfg.*.amin;
                    if(r>=k){
                        let settled:i32=1;
                        let i:i32=r-k+1;
                        while(i<=r){
                            let g:i64=(au_get32(st.*.hist_c,i) as i64)-(au_get32(st.*.hist_c,i-1) as i64);
                            if(g<0){g=-g;}
                            if(g>=(cfg.*.eps as i64)){settled=0;}
                            i=i+1;
                        }
                        if(settled==1){stop=1;if(stopwhy==0){stopwhy=2;}}
                    }
                }
            }
            if(cfg.*.mode==3){
                // H5B residual-flip bound: stop iff the round cap is hit
                // (recorded, same as adaptive) or the remaining unconsumed
                // evidence provably cannot flip the current leader.
                if(r>=cfg.*.amax){stop=1;cap=1;if(stopwhy==0){stopwhy=5;}}
                if(stop==0 && dlb_bound_fires(st,it)==1){stop=1;if(stopwhy==0){stopwhy=3;}}
            }
            if(progress==0){stop=1;if(stopwhy==0){stopwhy=4;}}
        }
    }
    dlb_td_reset(&td);
    let why:[]u8="natural";
    if(stopwhy==1){why="fixed";}
    if(stopwhy==2){why="six";}
    if(stopwhy==3){why="bound";}
    if(stopwhy==5){why="cap";}
    let wb_vcorr:i32=0;
    if(dlb_streq(dj_hid(it,st.*.leader),dj_gt(it))==1){wb_vcorr=1;}
    dlb_d_verdict(&td,it,st.*.leader,st.*.conf,st.*.rounds,st.*.consumed,cap,why,dj_gt(it),wb_vcorr);
    rc=lg_step(lg,lgo,iid,st.*.rounds,"VERDICT",dout_bytes(&td));
    dout_free(&td);
    if(rc!=0){return rc;}
    return 0;
}

// ingest.zag — ZOOM FORK (structure + edges + DELIBERATIVE ZOOM + residual).
// Micah order 2026-09-26 ~01:11 PDT: magnifying-glass-for-images.
//
// Layer 2 is the zoom engine (zoom.zag), replacing v2's fixed 8x8 motif
// codebook. Layers 0/1/3 are the proven v3 machinery (structure thresh
// 2000, Sobel 96, exact sparse residual). The residual stays honestly
// labeled: the headline numbers are the PRE-residual understanding curve.
//
// argv: 1=indir (holds original_512.bmp) 2=outdir 3=knowmap_name 4=renderA_name
@import("./zoom.zag")

fn tab_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tab_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let kmapname:[]u8 = _zag_arg(3);
    let ra_name:[]u8 = _zag_arg(4);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(ra_name, "") == 1) { ra_name = "renderA.bmp"; }

    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }
    // ---- INGEST: raw BMP bytes (byte-level, no external decoder) ----
    let fd:i64 = nio_open_child(root, "original_512.bmp", 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    let bpp:i64 = r_u16le(fbuf, 28);
    let comp:i64 = r_u32le(fbuf, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); nio_free(fbuf); nio_close(root); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); nio_free(fbuf); nio_close(root); return 1; }
    if (w < 1) { _zag_println("bad w"); nio_free(fbuf); nio_close(root); return 1; }
    if (h < 1) { _zag_println("bad h"); nio_free(fbuf); nio_close(root); return 1; }
    if (w * h > 400000) { _zag_println("too big"); nio_free(fbuf); nio_close(root); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > n) { _zag_println("truncated pixels"); nio_free(fbuf); nio_close(root); return 1; }
    let npix:i64 = w * h;
    let pix:[]u8 = nio_alloc((npix * 3) as i32);
    if (pix.len == 0) { _zag_println("alloc pix failed"); nio_free(fbuf); nio_close(root); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            pix[p] = fbuf[q + 2];
            pix[p + 1] = fbuf[q + 1];
            pix[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    _zag_print("ingested ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    // ---- DELIBERATE layer 0: structure (identical to v0/v1/v2/v3) ----
    let lcap:i64 = 65536;
    let lx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let ly:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lw:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lh:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lr:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lg:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let lb:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fnx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fny:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fgx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fgy:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fbx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fby:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fxx:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    let fyy:[]i64 = nio_alloc((lcap * 8) as i32) as []i64;
    if (lx.len == 0) { _zag_println("alloc leaves failed"); return 1; }
    let lid:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (lid.len == 0) { _zag_println("alloc lid failed"); return 1; }
    let lc:i64 = deliberate_structure(pix, w, h, 2000,
        lx, ly, lw, lh, lr, lg, lb,
        fnx, fny, fgx, fgy, fbx, fby, fxx, fyy,
        lid, lcap);
    if (lc < 0) { _zag_println("deliberate failed"); return 1; }
    _zag_print("leaves ");
    _zag_println(_zag_i64_to_str(lc));

    // ---- DELIBERATE layer 1: edges (identical to v1/v2/v3) ----
    let ecap:i64 = 65536;
    let ex0:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let ey0:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let ex1:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let ey1:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let er:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let eg:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    let eb:[]i64 = nio_alloc((ecap * 8) as i32) as []i64;
    if (ex0.len == 0) { _zag_println("alloc edges failed"); return 1; }
    let dir:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let claimed:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (dir.len == 0) { _zag_println("alloc dir failed"); return 1; }
    edge_sobel(pix, w, h, 96, dir);
    let ne:i64 = deliberate_edges(pix, w, h, dir, claimed,
        ex0, ey0, ex1, ey1, er, eg, eb, ecap, 2);
    if (ne < 0) { _zag_println("edge deliberation failed"); return 1; }
    _zag_print("edges ");
    _zag_println(_zag_i64_to_str(ne));
    // ---- white-box path A: structure render (v0-equivalent curve point) ----
    let ra_struct:[]u8 = nio_alloc((npix * 3) as i32);
    if (ra_struct.len == 0) { _zag_println("alloc ra_struct failed"); return 1; }
    render_structure_eval(pix, w, h, lc,
        lx, ly, lw, lh, lr, lg, lb,
        fnx, fny, fgx, fgy, fbx, fby, fxx, fyy,
        lid, ra_struct);
    let rc0:i64 = bmp_write(oroot, "render_struct.bmp", ra_struct, w, h);
    if (rc0 != 0) { _zag_println("render_struct write failed"); return 1; }

    // ---- DELIBERATE layer 2: ZOOM (the magnifying glass) ----
    let B0:i64 = 16; let B1:i64 = 8; let B2:i64 = 4;
    let nc0:i64 = (w + 15) / 16; let nr0:i64 = (h + 15) / 16; let nb0:i64 = nc0 * nr0;
    let nc1:i64 = (w + 7) / 8; let nr1:i64 = (h + 7) / 8; let nb1:i64 = nc1 * nr1;
    let nc2:i64 = (w + 3) / 4; let nr2:i64 = (h + 3) / 4; let nb2:i64 = nc2 * nr2;
    let cap0:i64 = 4096; let cap1:i64 = 4096; let cap2:i64 = 4096;
    let motifs0:[]u8 = nio_alloc((cap0 * 1536) as i32);
    let mex0:[]i64 = nio_alloc((cap0 * 8) as i32) as []i64;
    let e0:[]i64 = nio_alloc((nb0 * 8) as i32) as []i64;
    let z1:[]u8 = nio_alloc(nb1 as i32);
    let e1:[]i64 = nio_alloc((nb1 * 8) as i32) as []i64;
    let motifs1:[]u8 = nio_alloc((cap1 * 384) as i32);
    let mex1:[]i64 = nio_alloc((cap1 * 8) as i32) as []i64;
    let z2:[]u8 = nio_alloc(nb2 as i32);
    let e2:[]i64 = nio_alloc((nb2 * 8) as i32) as []i64;
    let motifs2:[]u8 = nio_alloc((cap2 * 96) as i32);
    let mex2:[]i64 = nio_alloc((cap2 * 8) as i32) as []i64;
    if (motifs0.len == 0) { _zag_println("alloc zoom failed"); return 1; }
    if (z1.len == 0) { _zag_println("alloc z1 failed"); return 1; }
    if (z2.len == 0) { _zag_println("alloc z2 failed"); return 1; }
    let zs:[]i64 = nio_alloc(128) as []i64;
    if (zs.len == 0) { _zag_println("alloc zs failed"); return 1; }
    // convergence thresholds (marginal explained-energy; per-value ~= 9,
    // matching v2's never-triggered T_TEX=1728 on 8x8) and zoom thresholds
    // (block residual energy that earns a deeper look).
    // Optional argv 5..9 override: tau0 tau1 tau2 tauz1 tauz2.
    let t0:i64 = 6912; let t1:i64 = 1728; let t2:i64 = 432;
    let tz1:i64 = 8192; let tz2:i64 = 2048;
    let a5:[]u8 = _zag_arg(5);
    if (_zag_strcmp(a5, "") != 1) {
        t0 = parse_i64(_zag_arg(5));
        t1 = parse_i64(_zag_arg(6));
        t2 = parse_i64(_zag_arg(7));
        tz1 = parse_i64(_zag_arg(8));
        tz2 = parse_i64(_zag_arg(9));
    }
    let zr:i64 = deliberate_zoom(pix, ra_struct, w, h,
        t0, t1, t2, tz1, tz2,
        motifs0, mex0, e0,
        z1, e1, motifs1, mex1,
        z2, e2, motifs2, mex2,
        cap0, cap1, cap2, zs);
    if (zr != 0) { _zag_println("zoom deliberation failed"); return 1; }
    _zag_print("zoom motifs L0/L1/L2: ");
    _zag_print(_zag_i64_to_str(zs[0]));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(zs[1]));
    _zag_print(" / ");
    _zag_println(_zag_i64_to_str(zs[2]));
    _zag_print("zoomed blocks L1/L2: ");
    _zag_print(_zag_i64_to_str(zs[3]));
    _zag_print(" / ");
    _zag_println(_zag_i64_to_str(zs[4]));

    // ---- path A: structure + zoom texture, then edges overlay ----
    let ra:[]u8 = nio_alloc((npix * 3) as i32);
    if (ra.len == 0) { _zag_println("alloc ra failed"); return 1; }
    let cp:i64 = 0;
    while (cp < npix * 3) { ra[cp] = ra_struct[cp]; cp = cp + 1; }
    zoom_eval_inplace(ra, w, h,
        motifs0, e0, B0, nc0,
        z1, e1, motifs1, B1, nc1,
        z2, e2, motifs2, B2, nc2);
    // overlay edges via edge-id map (per-pixel lookup = path A)
    let eid:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (eid.len == 0) { _zag_println("alloc eid failed"); return 1; }
    let ei:i64 = 0;
    while (ei < npix) { eid[ei] = -1; ei = ei + 1; }
    edge_draw_ids(ex0, ey0, ex1, ey1, ne, w, h, eid);
    let py:i64 = 0;
    while (py < h) {
        let px:i64 = 0;
        while (px < w) {
            let ep:i64 = py * w + px;
            let sg:i64 = eid[ep];
            if (sg >= 0) {
                let q:i64 = ep * 3;
                ra[q] = er[sg] as u8;
                ra[q + 1] = eg[sg] as u8;
                ra[q + 2] = eb[sg] as u8;
            }
            px = px + 1;
        }
        py = py + 1;
    }
    // understanding render (NO residual): the genuine-understanding curve point
    let rcu:i64 = bmp_write(oroot, "render_understanding.bmp", ra, w, h);
    if (rcu != 0) { _zag_println("understanding write failed"); return 1; }
    // v1-equivalent curve point: structure + edges (no zoom)
    let re_:[]u8 = nio_alloc((npix * 3) as i32);
    if (re_.len == 0) { _zag_println("alloc re_ failed"); return 1; }
    cp = 0;
    while (cp < npix * 3) { re_[cp] = ra_struct[cp]; cp = cp + 1; }
    py = 0;
    while (py < h) {
        let px2:i64 = 0;
        while (px2 < w) {
            let ep2:i64 = py * w + px2;
            let s2:i64 = eid[ep2];
            if (s2 >= 0) {
                let q9:i64 = ep2 * 3;
                re_[q9] = er[s2] as u8;
                re_[q9 + 1] = eg[s2] as u8;
                re_[q9 + 2] = eb[s2] as u8;
            }
            px2 = px2 + 1;
        }
        py = py + 1;
    }
    let rce:i64 = bmp_write(oroot, "render_edges.bmp", re_, w, h);
    if (rce != 0) { _zag_println("render_edges write failed"); return 1; }
    // ---- DELIBERATE layer 3: residual (honest error channel) ----
    let rpos:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((npix * 6) as i32);
    if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
    let nr:i64 = deliberate_residual(pix, ra, w, h, rpos, rdelta, npix);
    if (nr < 0) { _zag_println("residual deliberation failed"); return 1; }
    _zag_print("residuals ");
    _zag_print(_zag_i64_to_str(nr));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(npix));
    _zag_print(" px (");
    _zag_print(_zag_i64_to_str((nr * 1000) / npix));
    _zag_println(" per-mille)");
    residual_apply(ra, rpos, rdelta, nr);

    // ---- write knowledge map (zoom format) ----
    let rc1:i64 = kmapz_write(oroot, kmapname, w, h,
        lc, lx, ly, lw, lh, lr, lg, lb,
        fnx, fny, fgx, fgy, fbx, fby, fxx, fyy,
        ne, ex0, ey0, ex1, ey1, er, eg, eb,
        B0, zs[0], motifs0, mex0,
        B1, zs[1], motifs1, mex1,
        B2, zs[2], motifs2, mex2,
        nb0, e0, nb1, z1, e1, nb2, z2, e2,
        nr, rpos, rdelta);
    if (rc1 != 0) { _zag_println("kmap write failed"); return 1; }
    let rc2:i64 = bmp_write(oroot, ra_name, ra, w, h);
    if (rc2 != 0) { _zag_println("renderA write failed"); return 1; }

    // ---- zoom-depth map: SEE where TNN zoomed (white-box visualization) ----
    let zdm:[]u8 = nio_alloc((npix * 3) as i32);
    if (zdm.len == 0) { _zag_println("alloc zdm failed"); return 1; }
    let zy:i64 = 0;
    while (zy < h) {
        let zx:i64 = 0;
        while (zx < w) {
            let b2:i64 = (zy / 4) * nc2 + (zx / 4);
            let dpt:i64 = 0;
            if (z2[b2] == 1) { dpt = 2; } else {
                let b1:i64 = (zy / 8) * nc1 + (zx / 8);
                if (z1[b1] == 1) { dpt = 1; }
            }
            let zp:i64 = (zy * w + zx) * 3;
            if (dpt == 0) {
                zdm[zp] = 20; zdm[zp + 1] = 40; zdm[zp + 2] = 90;
            } else {
                if (dpt == 1) {
                    zdm[zp] = 20; zdm[zp + 1] = 160; zdm[zp + 2] = 160;
                } else {
                    zdm[zp] = 240; zdm[zp + 1] = 220; zdm[zp + 2] = 60;
                }
            }
            zx = zx + 1;
        }
        zy = zy + 1;
    }
    let rcz:i64 = bmp_write(oroot, "render_zoomdepth.bmp", zdm, w, h);
    if (rcz != 0) { _zag_println("zoomdepth write failed"); return 1; }

    // ---- ZOOM LEDGER: the deliberation record (evidence) ----
    let led:[]u8 = nio_alloc(8192);
    if (led.len == 0) { _zag_println("alloc ledger failed"); return 1; }
    let lo:i64 = 0;
    lo = tab_puts(led, lo, "ZOOM LEDGER - deliberative variable-scale zoom (image_zoom_fork)\n");
    lo = tab_puts(led, lo, "thresholds: tau0=");
    lo = tab_puti(led, lo, t0);
    lo = tab_puts(led, lo, " tau1=");
    lo = tab_puti(led, lo, t1);
    lo = tab_puts(led, lo, " tau2=");
    lo = tab_puti(led, lo, t2);
    lo = tab_puts(led, lo, " tauz1=");
    lo = tab_puti(led, lo, tz1);
    lo = tab_puts(led, lo, " tauz2=");
    lo = tab_puti(led, lo, tz2);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "L0 16x16: motifs=");
    lo = tab_puti(led, lo, zs[0]);
    lo = tab_puts(led, lo, " caphit=");
    lo = tab_puti(led, lo, zs[8]);
    lo = tab_puts(led, lo, " first_gain=");
    lo = tab_puti(led, lo, zs[14]);
    lo = tab_puts(led, lo, " last_gain=");
    lo = tab_puti(led, lo, zs[11]);
    lo = tab_puts(led, lo, " applied=");
    lo = tab_puti(led, lo, nb0);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "L1 8x8: motifs=");
    lo = tab_puti(led, lo, zs[1]);
    lo = tab_puts(led, lo, " caphit=");
    lo = tab_puti(led, lo, zs[9]);
    lo = tab_puts(led, lo, " last_gain=");
    lo = tab_puti(led, lo, zs[12]);
    lo = tab_puts(led, lo, " zoomed_blocks=");
    lo = tab_puti(led, lo, zs[3]);
    lo = tab_puts(led, lo, " of ");
    lo = tab_puti(led, lo, nb1);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "L2 4x4: motifs=");
    lo = tab_puti(led, lo, zs[2]);
    lo = tab_puts(led, lo, " caphit=");
    lo = tab_puti(led, lo, zs[10]);
    lo = tab_puts(led, lo, " last_gain=");
    lo = tab_puti(led, lo, zs[13]);
    lo = tab_puts(led, lo, " zoomed_blocks=");
    lo = tab_puti(led, lo, zs[4]);
    lo = tab_puts(led, lo, " of ");
    lo = tab_puti(led, lo, nb2);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "energy: E_detail=");
    lo = tab_puti(led, lo, zs[5]);
    lo = tab_puts(led, lo, " E_after_L0=");
    lo = tab_puti(led, lo, zs[6]);
    lo = tab_puts(led, lo, " E_after_L1=");
    lo = tab_puti(led, lo, zs[7]);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "leaves=");
    lo = tab_puti(led, lo, lc);
    lo = tab_puts(led, lo, " edges=");
    lo = tab_puti(led, lo, ne);
    lo = tab_puts(led, lo, " residuals=");
    lo = tab_puti(led, lo, nr);
    lo = tab_puts(led, lo, " (error channel, not understanding)\n");
    let rcl:i64 = file_write(oroot, "ZOOMLEDGER.txt", led[0..lo]);
    nio_close(root);
    nio_close(oroot);
    if (rcl != 0) { _zag_println("ledger write failed"); return 1; }
    _zag_println("ingest done");
    return 0;
}

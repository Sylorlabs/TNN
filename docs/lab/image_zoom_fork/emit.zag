// emit.zag — ZOOM FORK emit (white-box path B).
// Reads ONLY knowmap.bin (TNNKZMAP1); rasterizes structure per-region,
// stamps zoom motifs per-block, draws edges, applies residual deltas.
// Writes renderB.bmp (full) and renderB_understanding.bmp (no residual).
// argv: 1=dir (holds knowmap.bin) 2=kmap_name 3=renderB_name
@import("./zoom.zag")

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let kmapname:[]u8 = _zag_arg(2);
    let rb_name:[]u8 = _zag_arg(3);
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(rb_name, "") == 1) { rb_name = "renderB.bmp"; }
    let root:i64 = nio_open_root(d);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }

    let data:[]u8 = file_read_all(root, kmapname, 20000000);
    if (data.len < 32) { _zag_println("kmap too short"); nio_close(root); return 1; }
    if (data[0] != 84) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[1] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[2] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[3] != 75) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[4] != 90) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[5] != 77) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[6] != 65) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[7] != 80) { _zag_println("bad magic"); nio_close(root); return 1; }
    let o:i64 = 8;
    let w:i64 = r_u64le(data, o); o = o + 8;
    let h:i64 = r_u64le(data, o); o = o + 8;
    let npix:i64 = w * h;
    _zag_print("kmap ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    let lc:i64 = r_u64le(data, o); o = o + 8;
    let lx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let ly:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lw:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lh:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lr:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lg:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lb:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fnx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fny:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fgx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fgy:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fbx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fby:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fxx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fyy:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    if (lx.len == 0) { _zag_println("alloc failed"); return 1; }
    let i:i64 = 0;
    while (i < lc) {
        lx[i] = r_i64le(data, o); o = o + 8;
        ly[i] = r_i64le(data, o); o = o + 8;
        lw[i] = r_i64le(data, o); o = o + 8;
        lh[i] = r_i64le(data, o); o = o + 8;
        lr[i] = r_i64le(data, o); o = o + 8;
        lg[i] = r_i64le(data, o); o = o + 8;
        lb[i] = r_i64le(data, o); o = o + 8;
        fnx[i] = r_i64le(data, o); o = o + 8;
        fny[i] = r_i64le(data, o); o = o + 8;
        fgx[i] = r_i64le(data, o); o = o + 8;
        fgy[i] = r_i64le(data, o); o = o + 8;
        fbx[i] = r_i64le(data, o); o = o + 8;
        fby[i] = r_i64le(data, o); o = o + 8;
        fxx[i] = r_i64le(data, o); o = o + 8;
        fyy[i] = r_i64le(data, o); o = o + 8;
        i = i + 1;
    }
    _zag_print("leaves ");
    _zag_println(_zag_i64_to_str(lc));
    let ne:i64 = r_u64le(data, o); o = o + 8;
    let ex0:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let ey0:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let ex1:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let ey1:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let er:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let eg:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    let eb:[]i64 = nio_alloc((ne * 8) as i32) as []i64;
    if (ne > 0) {
        if (ex0.len == 0) { _zag_println("alloc edges failed"); return 1; }
    }
    i = 0;
    while (i < ne) {
        ex0[i] = r_i64le(data, o); o = o + 8;
        ey0[i] = r_i64le(data, o); o = o + 8;
        ex1[i] = r_i64le(data, o); o = o + 8;
        ey1[i] = r_i64le(data, o); o = o + 8;
        er[i] = r_i64le(data, o); o = o + 8;
        eg[i] = r_i64le(data, o); o = o + 8;
        eb[i] = r_i64le(data, o); o = o + 8;
        i = i + 1;
    }
    _zag_print("edges ");
    _zag_println(_zag_i64_to_str(ne));
    // parse zoom layer: 3 scales
    let B0:i64 = r_u64le(data, o); o = o + 8;
    let nm0:i64 = r_u64le(data, o); o = o + 8;
    let n0:i64 = B0 * B0 * 3;
    let motifs0:[]u8 = nio_alloc((nm0 * n0 * 2) as i32);
    let mex0:[]i64 = nio_alloc((nm0 * 8) as i32) as []i64;
    if (nm0 > 0) {
        if (motifs0.len == 0) { _zag_println("alloc motifs0 failed"); return 1; }
    }
    i = 0;
    while (i < nm0) {
        let k:i64 = 0;
        while (k < n0) {
            w_i16le(motifs0, i * n0 * 2 + k * 2, r_i16le(data, o));
            o = o + 2;
            k = k + 1;
        }
        mex0[i] = r_u64le(data, o); o = o + 8;
        i = i + 1;
    }
    let B1:i64 = r_u64le(data, o); o = o + 8;
    let nm1:i64 = r_u64le(data, o); o = o + 8;
    let n1:i64 = B1 * B1 * 3;
    let motifs1:[]u8 = nio_alloc((nm1 * n1 * 2) as i32);
    let mex1:[]i64 = nio_alloc((nm1 * 8) as i32) as []i64;
    if (nm1 > 0) {
        if (motifs1.len == 0) { _zag_println("alloc motifs1 failed"); return 1; }
    }
    i = 0;
    while (i < nm1) {
        let k2:i64 = 0;
        while (k2 < n1) {
            w_i16le(motifs1, i * n1 * 2 + k2 * 2, r_i16le(data, o));
            o = o + 2;
            k2 = k2 + 1;
        }
        mex1[i] = r_u64le(data, o); o = o + 8;
        i = i + 1;
    }
    let B2:i64 = r_u64le(data, o); o = o + 8;
    let nm2:i64 = r_u64le(data, o); o = o + 8;
    let n2:i64 = B2 * B2 * 3;
    let motifs2:[]u8 = nio_alloc((nm2 * n2 * 2) as i32);
    let mex2:[]i64 = nio_alloc((nm2 * 8) as i32) as []i64;
    if (nm2 > 0) {
        if (motifs2.len == 0) { _zag_println("alloc motifs2 failed"); return 1; }
    }
    i = 0;
    while (i < nm2) {
        let k3:i64 = 0;
        while (k3 < n2) {
            w_i16le(motifs2, i * n2 * 2 + k3 * 2, r_i16le(data, o));
            o = o + 2;
            k3 = k3 + 1;
        }
        mex2[i] = r_u64le(data, o); o = o + 8;
        i = i + 1;
    }
    _zag_print("zoom motifs ");
    _zag_print(_zag_i64_to_str(nm0));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(nm1));
    _zag_print("/");
    _zag_println(_zag_i64_to_str(nm2));
    let nb0:i64 = r_u64le(data, o); o = o + 8;
    let e0:[]i64 = nio_alloc((nb0 * 8) as i32) as []i64;
    if (nb0 > 0) {
        if (e0.len == 0) { _zag_println("alloc e0 failed"); return 1; }
    }
    i = 0;
    while (i < nb0) { e0[i] = r_u64le(data, o); o = o + 8; i = i + 1; }
    let nb1:i64 = r_u64le(data, o); o = o + 8;
    let z1:[]u8 = nio_alloc(nb1 as i32);
    let e1:[]i64 = nio_alloc((nb1 * 8) as i32) as []i64;
    if (nb1 > 0) {
        if (z1.len == 0) { _zag_println("alloc z1 failed"); return 1; }
    }
    i = 0;
    while (i < nb1) { z1[i] = data[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < nb1) { e1[i] = r_u64le(data, o); o = o + 8; i = i + 1; }
    let nb2:i64 = r_u64le(data, o); o = o + 8;
    let z2:[]u8 = nio_alloc(nb2 as i32);
    let e2:[]i64 = nio_alloc((nb2 * 8) as i32) as []i64;
    if (nb2 > 0) {
        if (z2.len == 0) { _zag_println("alloc z2 failed"); return 1; }
    }
    i = 0;
    while (i < nb2) { z2[i] = data[o]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < nb2) { e2[i] = r_u64le(data, o); o = o + 8; i = i + 1; }
    let nr:i64 = r_u64le(data, o); o = o + 8;
    let rpos:[]i64 = nio_alloc((nr * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((nr * 6) as i32);
    if (nr > 0) {
        if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
    }
    i = 0;
    while (i < nr) {
        rpos[i] = r_u64le(data, o); o = o + 8;
        w_i16le(rdelta, i * 6, r_i16le(data, o)); o = o + 2;
        w_i16le(rdelta, i * 6 + 2, r_i16le(data, o)); o = o + 2;
        w_i16le(rdelta, i * 6 + 4, r_i16le(data, o)); o = o + 2;
        i = i + 1;
    }
    _zag_print("residuals ");
    _zag_println(_zag_i64_to_str(nr));

    // ---- white-box path B: per-REGION rasterization ----
    let fb:[]u8 = nio_alloc((npix * 3) as i32);
    if (fb.len == 0) { _zag_println("alloc fb failed"); return 1; }
    let ev:[]i64 = nio_alloc(24) as []i64;
    let li:i64 = 0;
    while (li < lc) {
        let yy:i64 = ly[li];
        while (yy < ly[li] + lh[li]) {
            let xx:i64 = lx[li];
            while (xx < lx[li] + lw[li]) {
                leaf_model(li, xx, yy, lx, ly, lw, lh, lr, lg, lb,
                    fnx, fny, fgx, fgy, fbx, fby, fxx, fyy, ev);
                let p:i64 = (yy * w + xx) * 3;
                fb[p] = ev[0] as u8;
                fb[p + 1] = ev[1] as u8;
                fb[p + 2] = ev[2] as u8;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        li = li + 1;
    }
    nio_free(ev);
    // layer 2: stamp zoom motifs per block
    let nc0:i64 = (w + 15) / 16;
    let nc1:i64 = (w + 7) / 8;
    let nc2:i64 = (w + 3) / 4;
    zoom_stamp_blocks(fb, w, h,
        motifs0, e0, B0, nc0, nb0,
        z1, e1, motifs1, B1, nc1, nb1,
        z2, e2, motifs2, B2, nc2, nb2);
    // layer 1: draw edge segments (1px, last-wins)
    edge_draw_colors(ex0, ey0, ex1, ey1, er, eg, eb, ne, w, h, fb);
    // understanding render (NO residual) — white-box path-B counterpart
    let rbu:i64 = bmp_write(root, "renderB_understanding.bmp", fb, w, h);
    if (rbu != 0) { _zag_println("renderB_understanding write failed"); return 1; }
    // layer 3: apply residual deltas (exactness layer)
    residual_apply(fb, rpos, rdelta, nr);
    let rc:i64 = bmp_write(root, rb_name, fb, w, h);
    nio_close(root);
    if (rc != 0) { _zag_println("renderB write failed"); return 1; }
    _zag_println("emit done");
    return 0;
}

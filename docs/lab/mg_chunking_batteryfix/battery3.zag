// battery3.zag — DEGENERATE-INPUT regression battery (2026-09-26).
// 41 degenerate cases per PREREG_DEGEN.md: empty text x every kind,
// single-char text, all-whitespace text, past-end/zero/negative
// positions, empty question. Bar: answer or refuse cleanly, no panics.
// Runs through the production tnn_intake only, like battery1/2.
@import("./intake.zag")

fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }


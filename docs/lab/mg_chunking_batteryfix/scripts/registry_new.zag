// The registry is the instrument TNN's deliberation drives. Knowledge lives
// HERE at runtime (granularity delimiters, ordinal words, relation words);
// the mechanism below only reads it. Nothing knowledge-bearing is branched
// on in the parser bodies. Append-log layout (all little-endian):
//   [0..4)   free:u32 -- next append offset (init 4)
//   entries: [kind:u8][payload]
//     kind 1 (granularity): [n1:u8][name1][n2:u8][name2][delim:u8]
//     kind 2 (ordinal):     [nw:u8][word][val:i64]
//     kind 3 (relation):    [nw:u8][word][delta:i64]
// Capacity is the caller-supplied arena length: no per-kind item cap and no
// word-length cap. A bind that does not fit the arena is not placed; the
// counts report exactly what was placed, so placement is never silently
// lossy beyond physical capacity.
fn know_init(know:[]u8) void {
    // nio_alloc is not reliably zeroed: initialize explicitly.
    w_u32le(know,0,4);
    return;
}
fn know_entry_len(know:[]u8, at:i64) i64 {
    let k:i64=know[at] as i64;
    if (k==1) {
        let n1:i64=know[at+1] as i64; let n2:i64=know[at+2+n1] as i64;
        return 4+n1+n2;
    }
    let nw:i64=know[at+1] as i64;
    return 10+nw;
}
fn know_count(know:[]u8, kind:i64) i64 {
    let c:i64=0; let at:i64=4; let free:i64=r_u32le(know,0);
    while (at<free) {
        if ((know[at] as i64)==kind) { c=c+1; }
        at=at+know_entry_len(know,at);
    }
    return c;
}
fn know_find(know:[]u8, kind:i64, idx:i64) i64 {
    // byte offset of the idx-th entry of kind, or -1.
    let c:i64=0; let at:i64=4; let free:i64=r_u32le(know,0);
    while (at<free) {
        if ((know[at] as i64)==kind) {
            if (c==idx) { return at; }
            c=c+1;
        }
        at=at+know_entry_len(know,at);
    }
    return -1;
}
fn know_append(know:[]u8, len:i64) i64 {
    // reserve len bytes; return the entry offset, or -1 when the
    // caller-supplied arena is full.
    let free:i64=r_u32le(know,0);
    if (free+len>know.len) { return -1; }
    w_u32le(know,0,free+len);
    return free;
}
fn know_cword(know:[]u8, at:i64, w:[]u8) void {
    let i:i64=0;
    while (i<w.len) { know[at+i]=w[i]; i=i+1; }
    return;
}
// TNN's placement primitive: bind a granularity (delimiter) unit.
fn tnn_bind_granularity(know:[]u8, name:[]u8, plural:[]u8, delim:u8) void {
    let b:i64=know_append(know,4+name.len+plural.len);
    if (b<0) { return; }
    know[b]=1; know[b+1]=(name.len & 255) as u8;
    know_cword(know,b+2,name);
    know[b+2+name.len]=(plural.len & 255) as u8;
    know_cword(know,b+3+name.len,plural);
    know[b+3+name.len+plural.len]=delim;
    return;
}
// TNN's placement primitive: bind an ordinal word to its number.
fn tnn_bind_ordinal(know:[]u8, word:[]u8, val:i64) void {
    let b:i64=know_append(know,10+word.len);
    if (b<0) { return; }
    know[b]=2; know[b+1]=(word.len & 255) as u8;
    know_cword(know,b+2,word);
    w_i64le(know,b+2+word.len,val);
    return;
}
// TNN's placement primitive: bind a relation word to its signed offset.
fn tnn_bind_relation(know:[]u8, word:[]u8, delta:i64) void {
    let b:i64=know_append(know,10+word.len);
    if (b<0) { return; }
    know[b]=3; know[b+1]=(word.len & 255) as u8;
    know_cword(know,b+2,word);
    w_i64le(know,b+2+word.len,delta);
    return;
}
fn know_gran_n(know:[]u8) i64 { return know_count(know,1); }
fn gran_name(know:[]u8, gi:i64) []u8 {
    let b:i64=know_find(know,1,gi); let l:i64=know[b+1] as i64; return know[b+2..b+2+l];
}
fn gran_plural(know:[]u8, gi:i64) []u8 {
    let b:i64=know_find(know,1,gi); let l1:i64=know[b+1] as i64;
    let l2:i64=know[b+2+l1] as i64; return know[b+3+l1..b+3+l1+l2];
}
fn gran_delim(know:[]u8, gi:i64) u8 {
    let b:i64=know_find(know,1,gi); let l1:i64=know[b+1] as i64;
    let l2:i64=know[b+2+l1] as i64; return know[b+3+l1+l2];
}
fn know_ord_n(know:[]u8) i64 { return know_count(know,2); }
fn ord_word(know:[]u8, oi:i64) []u8 {
    let b:i64=know_find(know,2,oi); let l:i64=know[b+1] as i64; return know[b+2..b+2+l];
}
fn ord_val(know:[]u8, oi:i64) i64 {
    let b:i64=know_find(know,2,oi); return r_i64le(know,b+2+(know[b+1] as i64));
}
fn know_rel_n(know:[]u8) i64 { return know_count(know,3); }
fn rel_word(know:[]u8, ri:i64) []u8 {
    let b:i64=know_find(know,3,ri); let l:i64=know[b+1] as i64; return know[b+2..b+2+l];
}
fn rel_delta(know:[]u8, ri:i64) i64 {
    let b:i64=know_find(know,3,ri); return r_i64le(know,b+2+(know[b+1] as i64));
}

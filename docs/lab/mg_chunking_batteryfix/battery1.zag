// battery1.zag — PRODUCTION REGRESSION HARNESS v2 (2026-09-26).
//
// Runs the frozen 57-question battery (the fork's 24 + 33 adversarial
// traps, verbatim from mg_chunking_learned/derive.zag) through the LIVE
// production intake path: tnn_intake in intake.zag, the learned chunker.
// Bars for the production promotion:
//   LIVE 57/57 correct, 57/57 native (zero fallbacks),
//   byte-identical reruns x2, rebuild-from-source reproduces the run.
//
// The retired fixed arms (negcontrol.zag) are NOT run here: they are not
// the live path, and their negative-control verdict stands frozen in
// git history (evidence/RUN_R1.out, RUN_R2.out of the v1 promotion).
@import("./intake.zag")

// battery storage: dat holds q,t,e concatenated; off/ln index 3 slots per q
fn bq(dat:[]u8, off:[]u8, ln:[]u8, dp:*i64, n:*i64, q:[]u8, t:[]u8, e:[]u8) void {
    let i:i64=n.*;
    w_u32le(off,(3*i)*4,dp.*); w_u32le(ln,(3*i)*4,q.len);
    let k:i64=0;
    while (k<q.len) { dat[dp.*+k]=q[k]; k=k+1; }
    dp.*=dp.*+q.len;
    w_u32le(off,(3*i+1)*4,dp.*); w_u32le(ln,(3*i+1)*4,t.len);
    k=0;
    while (k<t.len) { dat[dp.*+k]=t[k]; k=k+1; }
    dp.*=dp.*+t.len;
    w_u32le(off,(3*i+2)*4,dp.*); w_u32le(ln,(3*i+2)*4,e.len);
    k=0;
    while (k<e.len) { dat[dp.*+k]=e[k]; k=k+1; }
    dp.*=dp.*+e.len;
    n.*=i+1;
    return;
}


fn bget(dat:[]u8, off:[]u8, ln:[]u8, i:i64, which:i64) []u8 {
    let o:i64=r_u32le(off,(3*i+which)*4);
    let l:i64=r_u32le(ln,(3*i+which)*4);
    return dat[o..o+l];
}


fn batt_load(dat:[]u8, off:[]u8, ln:[]u8, dp:*i64, n:*i64) void {
    // the fork's original 24
    bq(dat,off,ln,dp,n,"how many r's in strawberry","strawberry","3");
    bq(dat,off,ln,dp,n,"how many s's in Mississippi","Mississippi","4");
    bq(dat,off,ln,dp,n,"how many l's in hello world","hello world","3");
    bq(dat,off,ln,dp,n,"how many e's in cheese","cheese","3");
    bq(dat,off,ln,dp,n,"how many a's in abracadabra","abracadabra","5");
    bq(dat,off,ln,dp,n,"what is the 3rd letter of strawberry","strawberry","r");
    bq(dat,off,ln,dp,n,"what is the 1st letter of Mississippi","Mississippi","M");
    bq(dat,off,ln,dp,n,"what is the 10th letter of strawberry","strawberry","y");
    bq(dat,off,ln,dp,n,"spell strawberry backwards","strawberry","yrrebwarts");
    bq(dat,off,ln,dp,n,"spell abc backwards","abc","cba");
    bq(dat,off,ln,dp,n,"how many words in the quick brown fox","the quick brown fox","4");
    bq(dat,off,ln,dp,n,"how many words in hello","hello","1");
    bq(dat,off,ln,dp,n,"how many letters in strawberry","strawberry","10");
    bq(dat,off,ln,dp,n,"how many letters in ab","ab","2");
    bq(dat,off,ln,dp,n,"does the quick brown fox contain quick","the quick brown fox","yes");
    bq(dat,off,ln,dp,n,"what is the first word of the quick brown fox","the quick brown fox","the");
    bq(dat,off,ln,dp,n,"what is the last letter of Mississippi","Mississippi","i");
    bq(dat,off,ln,dp,n,"what is the first letter of hello world","hello world","h");
    bq(dat,off,ln,dp,n,"how many S's in Mississippi","Mississippi","0");
    bq(dat,off,ln,dp,n,"how many o's in bookkeeper","bookkeeper","2");
    bq(dat,off,ln,dp,n,"how many e's in the cheese wheel","the cheese wheel","6");
    bq(dat,off,ln,dp,n,"does strawberry contain raw","strawberry","yes");
    bq(dat,off,ln,dp,n,"what is the 2nd letter of fox","the quick brown fox","o");
    bq(dat,off,ln,dp,n,"how many r's in the strawberry patch","the strawberry patch","3");
    // Phase-2 adversarial traps: nested sub-span references
    bq(dat,off,ln,dp,n,"how many e's in the 2nd word of the cheese wheel","the cheese wheel","3");
    bq(dat,off,ln,dp,n,"how many o's in the 3rd word of the quick brown fox","the quick brown fox","1");
    bq(dat,off,ln,dp,n,"how many letters in the 1st word of the quick brown fox","the quick brown fox","3");
    bq(dat,off,ln,dp,n,"how many letters in the last word of hello world","hello world","5");
    bq(dat,off,ln,dp,n,"what is the 2nd letter of the 1st word of the quick brown fox","the quick brown fox","h");
    bq(dat,off,ln,dp,n,"what is the 1st letter of the last word of strawberry fields","strawberry fields","f");
    bq(dat,off,ln,dp,n,"what is the 3rd letter of the 2nd word of the cheese wheel","the cheese wheel","e");
    bq(dat,off,ln,dp,n,"spell the 1st word of the quick brown fox backwards","the quick brown fox","eht");
    bq(dat,off,ln,dp,n,"spell the last word of hello world backwards","hello world","dlrow");
    bq(dat,off,ln,dp,n,"what is the first letter of the 2nd word of the cheese wheel","the cheese wheel","c");
    bq(dat,off,ln,dp,n,"what is the first letter of the last word of the quick brown fox","the quick brown fox","f");
    bq(dat,off,ln,dp,n,"what is the last letter of the 1st word of the quick brown fox","the quick brown fox","e");
    bq(dat,off,ln,dp,n,"what is the last letter of the last word of hello world","hello world","d");
    bq(dat,off,ln,dp,n,"what is the last word of the quick brown fox","the quick brown fox","fox");
    bq(dat,off,ln,dp,n,"what is the last word of hello","hello","hello");
    bq(dat,off,ln,dp,n,"does the 2nd word of the cheese wheel contain hee","the cheese wheel","yes");
    bq(dat,off,ln,dp,n,"does the 1st word of hello world contain xyz","hello world","no");
    // mixed granularities, whitespace/case traps, multi-token reversal, clamp edge
    bq(dat,off,ln,dp,n,"what is the 4th letter of the quick brown fox","the quick brown fox"," ");
    bq(dat,off,ln,dp,n,"what is the 1st letter of abc","abc","a");
    bq(dat,off,ln,dp,n,"what is the last letter of abc","abc","c");
    bq(dat,off,ln,dp,n,"what is the last letter of hello world","hello world","d");
    bq(dat,off,ln,dp,n,"what is the first letter of the cheese wheel","the cheese wheel","t");
    bq(dat,off,ln,dp,n,"what is the first word of a stitch in time","a stitch in time","a");
    bq(dat,off,ln,dp,n,"how many words in a stitch in time saves nine","a stitch in time saves nine","6");
    bq(dat,off,ln,dp,n,"how many letters in the cheese wheel","the cheese wheel","16");
    bq(dat,off,ln,dp,n,"does the quick brown fox contain zebra","the quick brown fox","no");
    bq(dat,off,ln,dp,n,"spell the cheese wheel backwards","the cheese wheel","leehw eseehc eht");
    bq(dat,off,ln,dp,n,"how many z's in pizza","pizza","2");
    bq(dat,off,ln,dp,n,"what is the 5th letter of the 1st word of the quick brown fox","the quick brown fox","e");
    bq(dat,off,ln,dp,n,"does the last word of hello world contain orl","hello world","yes");
    bq(dat,off,ln,dp,n,"how many z's in the 1st word of the quick brown fox","the quick brown fox","0");
    bq(dat,off,ln,dp,n,"spell the 3rd word of the quick brown fox backwards","the quick brown fox","nworb");
    bq(dat,off,ln,dp,n,"what is the last word of the cheese wheel","the cheese wheel","wheel");
    return;
}


fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }
fn unpack_ops(p:i64) i64 {
    let r0:i64=p/256;
    return r0-(r0/16777216)*16777216;
}


fn main() void {
    let out:[]u8=nio_alloc(2097152);
    let at:i64=0;
    let scr:[]u8=nio_alloc(4096);
    let dat:[]u8=nio_alloc(32768);
    let off:[]u8=nio_alloc(4096);
    let ln:[]u8=nio_alloc(4096);
    let dp:i64=0; let nq:i64=0;
    batt_load(dat,off,ln,&dp,&nq);
    let soff:[]u8=nio_alloc(256);
    let slen:[]u8=nio_alloc(256);
    let zlog:[]u8=nio_alloc(8192);
    let zn:i64=0;
    let woffs:[]u8=nio_alloc(256);
    let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(4096);
    let know:[]u8=nio_alloc(2048);
    know_init(know);
    tnn_place_knowledge(know);
    let whyb:[]u8=nio_alloc(4096);
    at=ob_raw(out,at,"# CHUNK-PROD-RUN v2: 57-question battery through the LIVE production intake (learned chunker)");
    at=ob_nl(out,at);
    at=ob_raw(out,at,"# battery n=");
    at=ob_i64(out,at,nq,scr);
    at=ob_nl(out,at);
    let i:i64=0; let lc:i64=0; let lnat:i64=0; let lfb:i64=0;
    while (i<nq) {
        let q:[]u8=bget(dat,off,ln,i,0);
        let t:[]u8=bget(dat,off,ln,i,1);
        let e:[]u8=bget(dat,off,ln,i,2);
        at=ob_raw(out,at,"Q ");
        at=ob_i64(out,at,i,scr);
        at=ob_raw(out,at," q=\"");
        at=ob_raw(out,at,q);
        at=ob_raw(out,at,"\" t=\"");
        at=ob_raw(out,at,t);
        at=ob_raw(out,at,"\" exp=\"");
        at=ob_raw(out,at,e);
        at=ob_raw(out,at,"\"");
        at=ob_nl(out,at);
        zn=0;
        let p:i64=tnn_intake(i,q,t,e,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb,know);
        lc=lc+unpack_correct(p);
        lnat=lnat+unpack_native(p);
        lfb=lfb+unpack_fb(p);
        i=i+1;
    }
    at=ob_raw(out,at,"# LIVE SUMMARY n=");
    at=ob_i64(out,at,nq,scr);
    at=ob_raw(out,at," correct=");
    at=ob_i64(out,at,lc,scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,lnat,scr);
    at=ob_raw(out,at," fallback=");
    at=ob_i64(out,at,lfb,scr);
    at=ob_nl(out,at);
    at=ob_raw(out,at,"# VERDICT ");
    if (lc==nq) {
        if (lfb==0) {
            at=ob_raw(out,at,"PASS: 100% correct, zero fallback, every choice and zoom traced");
        }
        else {
            at=ob_raw(out,at,"FAIL: fallbacks present");
        }
    }
    else {
        at=ob_raw(out,at,"FAIL: correctness below 100%");
    }
    at=ob_nl(out,at);
    nio_write_all(1,out[0..at]);
    return;
}

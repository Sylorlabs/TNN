
// ============ TNN-driven relative addressing (2026-09-26 battery-fix, stage B) ============
// The three probes below are built from the knowledge registry at RUNTIME:
// no relation word ("after"/"before") appears as a literal in the machinery.
// rel_probe_pos: start index of left+rel_word(ri)+right in q, or -1.
fn rel_probe_pos(q:[]u8, know:[]u8, ri:i64, left:[]u8, right:[]u8) i64 {
    let rw:[]u8=rel_word(know,ri);
    let total:i64=left.len+rw.len+right.len;
    if (total>q.len) { return -1; }
    let s:i64=0;
    while (s+total<=q.len) {
        let ok:i64=1; let k:i64=0;
        while (k<left.len) { if (q[s+k]!=left[k]) { ok=0; } k=k+1; }
        k=0;
        while (k<rw.len) { if (q[s+left.len+k]!=rw[k]) { ok=0; } k=k+1; }
        k=0;
        while (k<right.len) { if (q[s+left.len+rw.len+k]!=right[k]) { ok=0; } k=k+1; }
        if (ok==1) { return s; }
        s=s+1;
    }
    return -1;
}
// first_token: first whitespace-delimited token of s (leading spaces skipped).
fn first_token(s:[]u8) []u8 {
    let a:i64=0; let go:i64=1;
    while (go==1) {
        if (a>=s.len) { go=0; }
        else { let d:i64=s[a] as i64; if (d==32) { a=a+1; } else { go=0; } }
    }
    let b:i64=a; go=1;
    while (go==1) {
        if (b>=s.len) { go=0; }
        else { let d:i64=s[b] as i64; if (d==32) { go=0; } else { b=b+1; } }
    }
    return s[a..b];
}
// rel_anchor_idx: resolve the " word <rel> <anchor>" construction.
// The anchor is the single word after the probe, resolved by FIRST occurrence
// in t (the battery's repeated-target convention); the registry's signed
// delta is applied. Returns the 0-based word index, -1 when no probe is in
// q, -2 when the probe matched but the anchor is absent from t or the index
// lands out of range (withhold, never whole-text fallback).
fn rel_anchor_idx(q:[]u8, t:[]u8, know:[]u8, woffs:[]u8, wlens:[]u8) i64 {
    let nr:i64=know_rel_n(know); let ri:i64=0;
    while (ri<nr) {
        let p:i64=rel_probe_pos(q,know,ri," word "," ");
        if (p>=0) {
            let rw:[]u8=rel_word(know,ri);
            let a0:i64=p+7+rw.len; let a1:i64=a0; let go:i64=1;
            while (go==1) {
                if (a1>=q.len) { go=0; }
                else { let d:i64=q[a1] as i64; if (d==32) { go=0; } else { a1=a1+1; } }
            }
            let anchor:[]u8=q[a0..a1];
            let nw:i64=enum_words(t,woffs,wlens);
            let ai:i64=find_word(t,woffs,wlens,nw,anchor);
            if (ai<0) { return -2; }
            let idx:i64=ai+rel_delta(know,ri);
            if (idx<0) { return -2; }
            if (idx>=nw) { return -2; }
            return idx;
        }
        ri=ri+1;
    }
    return -1;
}
// parse_wordref2: TNN-driven relative resolver in front of the legacy
// "the <n> word of" parser. Identical to parse_wordref when no relation
// probe matches q.
fn parse_wordref2(q:[]u8, t:[]u8, wn:*i64, know:[]u8, woffs:[]u8, wlens:[]u8) []u8 {
    let i:i64=rel_anchor_idx(q,t,know,woffs,wlens);
    if (i>=0) { wn.*=i+1; return t; }
    if (i==-2) { wn.*=0; return q[0..0]; }
    return parse_wordref(q,wn,know);
}

    a=ob_raw(wb,a,"policy cell missing; default deliberative magnifier | ");
    a=ob_raw(wb,a,cand_why(3,kind));
    return wb[0..a];
}
// ---------- production entry point ----------
// tnn_intake: classify -> text shape -> frozen learned policy ->
// the winning candidate answers with traced zooms. Returns packed stats
// (bit0 correct, bit1 native, bit2 fallback, bits8..39 ops).
fn tnn_intake(qid:i64, q:[]u8, t:[]u8, exp:[]u8,
              out:[]u8, atp:*i64, scr:[]u8,
              soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
              woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8,
              whyb:[]u8, know:[]u8) i64 {
    let kind:i64=classify(q,know);
    let shape:i64=text_shape(t);
    let w:i64=policy_winner(kind,shape);
    let why:[]u8=policy_why(kind,shape,w,whyb,scr);
    let p:i64=cand_answer(w,qid,kind,shape,q,t,exp,"INTAKE",why,
                          out,atp,scr,soff,slen,zlog,zn,
                          woffs,wlens,revbuf,abuf,know,w);
    return p;
}

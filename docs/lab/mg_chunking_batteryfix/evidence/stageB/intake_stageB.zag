// intake.zag — TNN LIVE TEXT-INTAKE ORGAN, v2 (learned chunking).
//
// Promoted 2026-09-26 per Micah's order (~10:55 PDT): the learned chunking
// chooser replaces the hand-authored deliberative rule table as TNN's
// production text-intake path. Supersedes intake.zag v1 (hand-authored D arm,
// 24-question battery) — v1 remains in git history.
//
// Machinery: VERBATIM from docs/lab/mg_chunking_learned/ (commit c2fb76eb6959):
// base.zag (LE accessors, output buffer, byte-string helpers, chunk
// primitives, parse functions), hand_a.zag (extended classifier kinds 1-17,
// word addressing), hand_b.zag (zoom ledger, candidate registry),
// hand_c1/c2/c3.zag (the 9 measured candidate chunkers + cand_answer dispatch).
//
// Policy: the FROZEN measured table below (policy_winner). Derived by
// mg_chunking_learned/derive.zag from 9 candidates x 57 questions; selection
// law: most correct -> most native -> fewest ops -> coarser chunking ->
// lower candidate id. RUN_D1 SHA-256:
// 45780575f766cd28fc4805b076d43f445d1a68e4e99836b265562a7d622eadcb
// Empty classes (no measured examples) default to candidate 3, the
// deliberative magnifier, and SAY SO on the choice line.
//
// LIVE-PATH CONTRACT (unchanged from v1):
//   * The ONLY entry point is tnn_intake(qid, q, t, exp, ...). v2 classifies
//     the question itself (v1 took a precomputed kind). It always emits the
//     chunking choice + derived reason + zoom trace: no silent chunking.
//   * The fixed arms (C/W/S) are RETIRED from the live path per Micah's
//     ruling. They survive ONLY in negcontrol.zag as negative controls.
//     This file does not import them, does not call them, does not know them.
//   * Zero RNG. Deterministic: byte-identical reruns.
@import("./R33_NATIVE_IO_V1.zag")

// base.zag — shared primitives for Phase 2 (learned chunking).
//
// GENERATED by gen_phase2.py from the frozen magnifying-glass fork
// (~/workspace/mg_chunking/mg_chunk.zag, commit
// 1de59c334aea10907cdc34545c7a3e97a868c6d2). Verbatim extraction of the
// fork's little-endian accessors, output buffer, byte-string helpers,
// chunk primitives, and parse functions. No behavior change. The fork's
// classify/kind_name/skind are NOT included: Phase 2 defines an extended
// classifier (kinds 1-17) in hand_a.zag.

// ---------- little-endian accessors over []u8 arenas ----------
// (ZNC-2026-09-21-007: no `as []i32` casts; []u8 arenas + accessors)
fn w_u32le(b:[]u8, o:i64, v:i64) void {
    b[o]=(v & 255) as u8;
    b[o+1]=((v >> 8) & 255) as u8;
    b[o+2]=((v >> 16) & 255) as u8;
    b[o+3]=((v >> 24) & 255) as u8;
}
fn r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64)+((b[o+1] as i64) << 8)+((b[o+2] as i64) << 16)+((b[o+3] as i64) << 24);
}
fn w_i64le(b:[]u8, o:i64, v:i64) void {
    let u:i64=v; let i:i64=0;
    while (i<8) { b[o+i]=(u & 255) as u8; u=u >> 8; i=i+1; }
}
fn r_i64le(b:[]u8, o:i64) i64 {
    let u:i64=0; let i:i64=7;
    while (i>=0) { u=(u << 8)+(b[o+i] as i64); i=i-1; }
    return u;
}

// ---------- output buffer ----------
fn ob_raw(out:[]u8, at:i64, s:[]u8) i64 {
    let i:i64=0;
    while (i<s.len) { out[at+i]=s[i]; i=i+1; }
    return at+s.len;
}
fn ob_i64(out:[]u8, at:i64, v:i64, scr:[]u8) i64 {
    let x:i64=v;
    if (x<0) { out[at]=45; at=at+1; x=0-x; }
    let n:i64=0;
    if (x==0) { scr[0]=48; n=1; }
    while (x>0) { scr[n]=((x % 10)+48) as u8; x=x/10; n=n+1; }
    let i:i64=n-1;
    while (i>=0) { out[at]=scr[i]; at=at+1; i=i-1; }
    return at;
}
fn ob_nl(out:[]u8, at:i64) i64 { out[at]=10; return at+1; }

// ---------- byte-string helpers (znc has no break; flag idiom) ----------
fn find_sub(h:[]u8, n:[]u8) i64 {
    if (n.len==0) { return 0; }
    if (n.len>h.len) { return -1; }
    let i:i64=0; let hit:i64=-1;
    while (i+n.len<=h.len) {
        if (hit==-1) {
            let j:i64=0; let ok:i64=1;
            while (j<n.len) {
                if (h[i+j]!=n[j]) { ok=0; j=n.len; }
                else { j=j+1; }
            }
            if (ok==1) { hit=i; }
        }
        i=i+1;
    }
    return hit;
}
fn has_sub(h:[]u8, n:[]u8) i64 {
    if (find_sub(h,n)>=0) { return 1; }
    return 0;
}
fn has_byte(t:[]u8, c:u8) i64 {
    let i:i64=0; let f:i64=0;
    while (i<t.len) {
        if (t[i]==c) { f=1; i=t.len; }
        else { i=i+1; }
    }
    return f;
}
fn beq(a:[]u8, b:[]u8) i64 {
    if (nio_equal(a,b)==1) { return 1; }
    return 0;
}
fn parse_digits(s:[]u8, at:i64) i64 {
    let v:i64=0; let i:i64=at; let go:i64=1;
    while (i<s.len) {
        if (go==1) {
            let c:i64=s[i] as i64;
            if (c>=48) {
                if (c<=57) { v=v*10+(c-48); i=i+1; }
                else { go=0; }
            }
            else { go=0; }
        }
        else { i=i+1; }
    }
    return v;
}

// ---------- chunk primitives ----------
fn enum_words(t:[]u8, offs:[]u8, lens:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0; let s:i64=0;
    while (i<L) {
        if (t[i]==32) {
            if (inword==1) {
                w_u32le(offs,n*4,s); w_u32le(lens,n*4,i-s); n=n+1; inword=0;
            }
        }
        else {
            if (inword==0) { s=i; inword=1; }
        }
        i=i+1;
    }
    if (inword==1) { w_u32le(offs,n*4,s); w_u32le(lens,n*4,i-s); n=n+1; }
    return n;
}
fn scan_count(t:[]u8, o:i64, ln:i64, target:u8) i64 {
    let c:i64=0; let i:i64=o;
    while (i<o+ln) { if (t[i]==target) { c=c+1; } i=i+1; }
    return c;
}
fn count_words_bytes(t:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0;
    while (i<L) {
        if (t[i]==32) { inword=0; }
        else {
            if (inword==0) { n=n+1; inword=1; }
        }
        i=i+1;
    }
    return n;
}
fn find_word(t:[]u8, offs:[]u8, lens:[]u8, nw:i64, w:[]u8) i64 {
    let k:i64=0; let hit:i64=-1;
    while (k<nw) {
        if (hit==-1) {
            let o:i64=r_u32le(offs,k*4); let ln:i64=r_u32le(lens,k*4);
            if (ln==w.len) {
                let seg:[]u8=t[o..o+ln];
                if (beq(seg,w)==1) { hit=k; }
            }
        }
        k=k+1;
    }
    return hit;
}
fn reverse_into(t:[]u8, dst:[]u8) void {
    let i:i64=0; let L:i64=t.len;
    while (i<L) { dst[i]=t[L-1-i]; i=i+1; }
}

// ---------- parse functions (from the fork's question-kinds section) ----------
fn parse_target_letter(q:[]u8) u8 {
    let p:i64=find_sub(q,"'s in");
    return q[p-1];
}
fn parse_pos_n(q:[]u8, know:[]u8) i64 {
    let p:i64=find_sub(q,"the ");
    let r:i64=parse_ordinal(q,p+4,know);
    if (r>=0) { return r; }
    return parse_digits(q,p+4);
}
fn parse_after(q:[]u8, marker:[]u8) []u8 {
    let p:i64=find_sub(q,marker);
    return q[p+marker.len..q.len];
}
fn parse_between(q:[]u8, a:[]u8, b:[]u8) []u8 {
    let p:i64=find_sub(q,a); let p2:i64=find_sub(q,b);
    return q[p+a.len..p2];
}


// ============ TNN knowledge registry (2026-09-26 battery-fix, stage A) ============
// The registry is the instrument TNN's deliberation drives. Knowledge lives
// HERE at runtime (granularity delimiters, ordinal words, relation words);
// the mechanism below only reads it. Nothing knowledge-bearing is branched
// on in the parser bodies. Layout (all little-endian):
//   [0..4)     granularity count u32
//   [4..324)   8 granularity slots x 40B:
//              name_len u8, name[15], plural_len u8, plural[15], delim u8, pad[7]
//   [324..328) ordinal count u32
//   [328..712) 16 ordinal slots x 24B: word_len u8, word[15], value i64
//   [712..716) relation count u32
//   [716..908) 8 relation slots x 24B: word_len u8, word[15], delta i64
fn know_gran_n(know:[]u8) i64 { return r_u32le(know,0); }
fn know_ord_n(know:[]u8) i64 { return r_u32le(know,324); }
fn know_rel_n(know:[]u8) i64 { return r_u32le(know,712); }
fn know_init(know:[]u8) void {
    // nio_alloc is not reliably zeroed: initialize counts explicitly.
    w_u32le(know,0,0); w_u32le(know,324,0); w_u32le(know,712,0);
    return;
}
fn know_cword(know:[]u8, at:i64, w:[]u8) void {
    let i:i64=0;
    while (i<15) { if (i<w.len) { know[at+i]=w[i]; } i=i+1; }
    return;
}
// TNN's placement primitive: bind a granularity (delimiter) unit.
fn tnn_bind_granularity(know:[]u8, name:[]u8, plural:[]u8, delim:u8) void {
    let n:i64=r_u32le(know,0);
    if (n>=8) { return; }
    let b:i64=4+n*40;
    know[b]=(name.len & 255) as u8; know_cword(know,b+1,name);
    know[b+16]=(plural.len & 255) as u8; know_cword(know,b+17,plural);
    know[b+32]=delim;
    w_u32le(know,0,n+1);
    return;
}
// TNN's placement primitive: bind an ordinal word to its number.
fn tnn_bind_ordinal(know:[]u8, word:[]u8, val:i64) void {
    let n:i64=r_u32le(know,324);
    if (n>=16) { return; }
    let b:i64=328+n*24;
    know[b]=(word.len & 255) as u8; know_cword(know,b+1,word);
    w_i64le(know,b+16,val);
    w_u32le(know,324,n+1);
    return;
}
// TNN's placement primitive: bind a relation word to its signed offset.
fn tnn_bind_relation(know:[]u8, word:[]u8, delta:i64) void {
    let n:i64=r_u32le(know,712);
    if (n>=8) { return; }
    let b:i64=716+n*24;
    know[b]=(word.len & 255) as u8; know_cword(know,b+1,word);
    w_i64le(know,b+16,delta);
    w_u32le(know,712,n+1);
    return;
}
fn gran_name(know:[]u8, gi:i64) []u8 {
    let b:i64=4+gi*40; let l:i64=know[b] as i64; return know[b+1..b+1+l];
}
fn gran_plural(know:[]u8, gi:i64) []u8 {
    let b:i64=4+gi*40; let l:i64=know[b+16] as i64; return know[b+17..b+17+l];
}
fn gran_delim(know:[]u8, gi:i64) u8 {
    let b:i64=4+gi*40; return know[b+32];
}
fn ord_word(know:[]u8, oi:i64) []u8 {
    let b:i64=328+oi*24; let l:i64=know[b] as i64; return know[b+1..b+1+l];
}
fn ord_val(know:[]u8, oi:i64) i64 { return r_i64le(know,328+oi*24+16); }
fn rel_word(know:[]u8, ri:i64) []u8 {
    let b:i64=716+ri*24; let l:i64=know[b] as i64; return know[b+1..b+1+l];
}
fn rel_delta(know:[]u8, ri:i64) i64 { return r_i64le(know,716+ri*24+16); }
// TNN-driven knowledge placement. The crew stand-in below seeds the same
// bindings a live TNN deliberation would place via tnn_bind_*; the seeding
// block is delimited by KNOW-SEED markers so the noseed proof build can
// stub it mechanically (see PREREG.md).
fn tnn_place_knowledge(know:[]u8) void {
// KNOW-SEED-BEGIN
    tnn_bind_granularity(know,"sentence","sentences",46);
    tnn_bind_granularity(know,"line","lines",10);
    tnn_bind_ordinal(know,"first",1);
    tnn_bind_ordinal(know,"second",2);
    tnn_bind_ordinal(know,"third",3);
    tnn_bind_ordinal(know,"fourth",4);
    tnn_bind_ordinal(know,"fifth",5);
    tnn_bind_ordinal(know,"sixth",6);
    tnn_bind_ordinal(know,"seventh",7);
    tnn_bind_ordinal(know,"eighth",8);
    tnn_bind_ordinal(know,"ninth",9);
    tnn_bind_ordinal(know,"tenth",10);
    tnn_bind_ordinal(know,"eleventh",11);
    tnn_bind_ordinal(know,"twelfth",12);
    tnn_bind_relation(know,"after",1);
    tnn_bind_relation(know,"before",-1);
// KNOW-SEED-END
    return;
}
// Ordinal hook (TNN-driven). Returns -2 when s[at..] starts with an ASCII
// digit (caller uses legacy parse_digits), the ordinal value on a registry
// hit, -1 when unparsed (caller uses legacy parse_digits -> 0 semantics).
fn parse_ordinal(s:[]u8, at:i64, know:[]u8) i64 {
    if (at<0) { return -1; }
    if (at>=s.len) { return -1; }
    let c:i64=s[at] as i64;
    if (c>=48) { if (c<=57) { return -2; } }
    let e:i64=at; let go:i64=1;
    while (go==1) {
        if (e>=s.len) { go=0; }
        else {
            let d:i64=s[e] as i64;
            if (d>=97) { if (d<=122) { e=e+1; } else { go=0; } }
            else { go=0; }
        }
    }
    let tok:[]u8=s[at..e];
    let n:i64=know_ord_n(know); let i:i64=0;
    while (i<n) {
        if (beq(tok,ord_word(know,i))==1) { return ord_val(know,i); }
        i=i+1;
    }
    return -1;
}

// ============ hand-written: extended classifier, parse, addressing ============
// Question kinds (superset of the fork):
// 1 LETTER_COUNT, 2 POSITION_N, 3 REVERSE, 4 WORD_COUNT, 5 LENGTH,
// 6 CONTAINS, 7 FIRST_WORD, 8 POS_FIRST, 9 POS_LAST,
// 10 LETTER_COUNT_WORD, 11 LENGTH_WORD, 12 POSITION_WORD, 13 REVERSE_WORD,
// 14 FIRST_LETTER_WORD, 15 LAST_LETTER_WORD, 16 LAST_WORD, 17 CONTAINS_WORD
fn classify(q:[]u8, know:[]u8) i64 {
    // TNN-driven addressing reroutes (stage B). Probes are built from the
    // registry's relation bindings at runtime; KIND numbers are the frozen
    // taxonomy. Two-hop "the letter <rel> the ... letter of ..." -> 21.
    let ri0:i64=0;
    while (ri0<know_rel_n(know)) {
        if (rel_probe_pos(q,know,ri0,"letter "," the ")>=0) { return 21; }
        ri0=ri0+1;
    }
    // Word-relative "the word <rel> ..." into the frozen _WORD kinds.
    let ri1:i64=0;
    while (ri1<know_rel_n(know)) {
        if (rel_probe_pos(q,know,ri1," word "," ")>=0) {
            if (has_sub(q,"'s in")==1) { return 10; }
            if (has_sub(q,"how many letters in")==1) { return 11; }
            if (has_sub(q,"letter of")==1) { return 12; }
            if (has_sub(q,"backwards")==1) { return 13; }
            if (has_sub(q,"first letter of the")==1) { return 14; }
            if (has_sub(q,"1st letter of the")==1) { return 14; }
            if (has_sub(q,"last letter of the")==1) { return 15; }
            if (has_sub(q,"contain ")==1) { return 17; }
            return 0;
        }
        ri1=ri1+1;
    }
    if (has_sub(q,"how many words in")==1) { return 4; }
    if (has_sub(q,"how many letters in")==1) {
        if (has_sub(q," word of ")==1) { return 11; }
        return 5;
    }
    if (has_sub(q,"'s in")==1) {
        if (has_sub(q," word of ")==1) { return 10; }
        return 1;
    }
    if (has_sub(q,"backwards")==1) {
        if (has_sub(q," word of ")==1) { return 13; }
        return 3;
    }
    if (has_sub(q,"first letter of the")==1) {
        if (has_sub(q," word of ")==1) { return 14; }
    }
    if (has_sub(q,"1st letter of the")==1) {
        if (has_sub(q," word of ")==1) { return 14; }
    }
    if (has_sub(q,"last letter of the")==1) {
        if (has_sub(q," word of ")==1) { return 15; }
    }
    if (has_sub(q,"first word of")==1) { return 7; }
    if (has_sub(q," word of ")==1) {
        if (has_sub(q,"contain ")==1) { return 17; }
    }
    if (has_sub(q,"last word of")==1) { return 16; }
    if (has_sub(q,"contain ")==1) { return 6; }
    if (has_sub(q,"first letter of")==1) { return 8; }
    if (has_sub(q,"last letter of")==1) { return 9; }
    if (has_sub(q,"letter of")==1) {
        if (has_sub(q," word of ")==1) { return 12; }
        return 2;
    }
    return 0;
}
fn kind_name(k:i64) []u8 {
    if (k==1) { return "LETTER_COUNT"; }
    if (k==2) { return "POSITION"; }
    if (k==3) { return "REVERSE"; }
    if (k==4) { return "WORD_COUNT"; }
    if (k==5) { return "LENGTH"; }
    if (k==6) { return "CONTAINS"; }
    if (k==7) { return "FIRST_WORD"; }
    if (k==8) { return "POS_FIRST"; }
    if (k==9) { return "POS_LAST"; }
    if (k==10) { return "LETTER_COUNT_WORD"; }
    if (k==11) { return "LENGTH_WORD"; }
    if (k==12) { return "POSITION_WORD"; }
    if (k==13) { return "REVERSE_WORD"; }
    if (k==14) { return "FIRST_LETTER_WORD"; }
    if (k==15) { return "LAST_LETTER_WORD"; }
    if (k==16) { return "LAST_WORD"; }
    if (k==17) { return "CONTAINS_WORD"; }
    if (k==18) { return "GRAN_COUNT"; }
    if (k==19) { return "GRAN_SELECT"; }
    if (k==20) { return "GRAN_WORD"; }
    if (k==21) { return "TWO_HOP"; }
    return "KIND0";
}
fn text_shape(t:[]u8) i64 {
    if (has_byte(t,32)==1) { return 1; }
    return 0;
}
fn shape_name(s:i64) []u8 {
    if (s==1) { return "multi"; }
    return "single";
}
// parse_wordref: q contains " word of " ("the 2nd word of T", "the last word of T").
// sets wn (1-based word ordinal, -1 = last); returns the inner text after " word of ".
fn parse_wordref(q:[]u8, wn:*i64, know:[]u8) []u8 {
    let p:i64=find_sub(q," word of ");
    if (p<0) { wn.*=0; return q[0..0]; }
    let seg:[]u8=q[0..p];
    let i:i64=seg.len-4; let plast:i64=-1;
    while (i>=0) {
        if (plast==-1) {
            if (seg[i]==116) {
                if (seg[i+1]==104) {
                    if (seg[i+2]==101) {
                        if (seg[i+3]==32) { plast=i; }
                    }
                }
            }
        }
        i=i-1;
    }
    if (plast<0) { wn.*=0; return q[0..0]; }
    let tok:[]u8=seg[plast+4..p];
    if (beq(tok,"last")==1) { wn.*=-1; }
    else {
        let r:i64=parse_ordinal(tok,0,know);
        if (r>=0) { wn.*=r; }
        else { wn.*=parse_digits(tok,0); }
    }
    return q[p+9..q.len];
}

// ============ TNN-driven relative addressing (2026-09-26 battery-fix, stage B) ============
// The three probes below are built from the knowledge registry at RUNTIME:
// no relation word ("after"/"before") appears as a literal in the machinery.
// rel_probe_pos: start index of left+rel_word(ri)+right in q, or -1.
fn rel_probe_pos(q:[]u8, know:[]u8, ri:i64, left:[]u8, right:[]u8) i64 {
    let rw:[]u8=rel_word(know,ri);
    let total:i64=left.len+rw.len+right.len;
    if (total>q.len) { return -1; }
    let s:i64=0;
    while (s+total<=q.len) {
        let ok:i64=1; let k:i64=0;
        while (k<left.len) { if (q[s+k]!=left[k]) { ok=0; } k=k+1; }
        k=0;
        while (k<rw.len) { if (q[s+left.len+k]!=rw[k]) { ok=0; } k=k+1; }
        k=0;
        while (k<right.len) { if (q[s+left.len+rw.len+k]!=right[k]) { ok=0; } k=k+1; }
        if (ok==1) { return s; }
        s=s+1;
    }
    return -1;
}
// first_token: first whitespace-delimited token of s (leading spaces skipped).
fn first_token(s:[]u8) []u8 {
    let a:i64=0; let go:i64=1;
    while (go==1) {
        if (a>=s.len) { go=0; }
        else { let d:i64=s[a] as i64; if (d==32) { a=a+1; } else { go=0; } }
    }
    let b:i64=a; go=1;
    while (go==1) {
        if (b>=s.len) { go=0; }
        else { let d:i64=s[b] as i64; if (d==32) { go=0; } else { b=b+1; } }
    }
    return s[a..b];
}
// rel_anchor_idx: resolve the " word <rel> <anchor>" construction.
// The anchor is the single word after the probe, resolved by FIRST occurrence
// in t (the battery's repeated-target convention); the registry's signed
// delta is applied. Returns the 0-based word index, -1 when no probe is in
// q, -2 when the probe matched but the anchor is absent from t or the index
// lands out of range (withhold, never whole-text fallback).
fn rel_anchor_idx(q:[]u8, t:[]u8, know:[]u8, woffs:[]u8, wlens:[]u8) i64 {
    let nr:i64=know_rel_n(know); let ri:i64=0;
    while (ri<nr) {
        let p:i64=rel_probe_pos(q,know,ri," word "," ");
        if (p>=0) {
            let rw:[]u8=rel_word(know,ri);
            let a0:i64=p+7+rw.len; let a1:i64=a0; let go:i64=1;
            while (go==1) {
                if (a1>=q.len) { go=0; }
                else { let d:i64=q[a1] as i64; if (d==32) { go=0; } else { a1=a1+1; } }
            }
            let anchor:[]u8=q[a0..a1];
            let nw:i64=enum_words(t,woffs,wlens);
            let ai:i64=find_word(t,woffs,wlens,nw,anchor);
            if (ai<0) { return -2; }
            let idx:i64=ai+rel_delta(know,ri);
            if (idx<0) { return -2; }
            if (idx>=nw) { return -2; }
            return idx;
        }
        ri=ri+1;
    }
    return -1;
}
// parse_wordref2: TNN-driven relative resolver in front of the legacy
// "the <n> word of" parser. Identical to parse_wordref when no relation
// probe matches q.
fn parse_wordref2(q:[]u8, t:[]u8, wn:*i64, know:[]u8, woffs:[]u8, wlens:[]u8) []u8 {
    let i:i64=rel_anchor_idx(q,t,know,woffs,wlens);
    if (i>=0) { wn.*=i+1; return t; }
    if (i==-2) { wn.*=0; return q[0..0]; }
    return parse_wordref(q,wn,know);
}

// resolve wn (1-based, -1=last) against a word count nw -> 0-based index or -1
fn wn_index(wn:i64, nw:i64) i64 {
    if (wn==-1) { return nw-1; }
    let k:i64=wn-1;
    if (k<0) { return -1; }
    if (k>=nw) { return -1; }
    return k;
}
// ws_locate: locate the nth word (1-based) or the last word (-1) by byte
// scan — no word table. returns 1/0; ops += bytes scanned.
fn ws_locate(t:[]u8, n:i64, oo:*i64, ll:*i64, ops:*i64) i64 {
    let L:i64=t.len; let i:i64=0; let s:i64=0; let inword:i64=0; let wi:i64=0;
    let fo:i64=0; let fl:i64=0; let found:i64=0; let go:i64=1;
    let scanned:i64=L;
    while (i<L) {
        if (go==1) {
            if (t[i]==32) {
                if (inword==1) {
                    wi=wi+1;
                    if (n==-1) { fo=s; fl=i-s; found=1; }
                    else {
                        if (wi==n) { fo=s; fl=i-s; found=1; go=0; scanned=i+1; }
                    }
                    inword=0;
                }
            }
            else {
                if (inword==0) { s=i; inword=1; }
            }
        }
        i=i+1;
    }
    if (inword==1) {
        wi=wi+1;
        if (n==-1) {
            // last word: always take the trailing word (the in-loop branch
            // records every word end for n==-1, so found may already be 1)
            fo=s; fl=L-s; found=1;
        }
        else {
            if (found==0) {
                if (wi==n) { fo=s; fl=L-s; found=1; }
            }
        }
    }
    ops.*=ops.*+scanned;
    oo.*=fo; ll.*=fl;
    return found;
}
// ws_find: locate the word whose content == w by byte scan (no table).
// returns 1/0; ops += bytes scanned.
fn ws_find(t:[]u8, w:[]u8, oo:*i64, ll:*i64, ops:*i64) i64 {
    let L:i64=t.len; let i:i64=0; let s:i64=0; let inword:i64=0;
    let fo:i64=0; let fl:i64=0; let found:i64=0; let go:i64=1;
    let scanned:i64=L;
    while (i<=L) {
        if (go==1) {
            let endw:i64=0;
            if (i==L) { endw=1; }
            else {
                if (t[i]==32) { endw=1; }
            }
            if (endw==1) {
                if (inword==1) {
                    let wl:i64=i-s;
                    if (wl==w.len) {
                        let seg:[]u8=t[s..s+wl];
                        if (beq(seg,w)==1) { fo=s; fl=wl; found=1; go=0; scanned=i; }
                    }
                    inword=0;
                }
            }
            else {
                if (inword==0) { s=i; inword=1; }
            }
        }
        i=i+1;
    }
    ops.*=ops.*+scanned;
    oo.*=fo; ll.*=fl;
    return found;
}
// ws_count: word count by byte scan. ops += t.len.
fn ws_count(t:[]u8, ops:*i64) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let inword:i64=0;
    while (i<L) {
        if (t[i]==32) { inword=0; }
        else {
            if (inword==0) { n=n+1; inword=1; }
        }
        i=i+1;
    }
    ops.*=ops.*+L;
    return n;
}
// find_sub_rev: rightmost occurrence of n in h, or -1.
fn find_sub_rev(h:[]u8, n:[]u8) i64 {
    if (n.len==0) { return h.len; }
    if (n.len>h.len) { return -1; }
    let i:i64=h.len-n.len; let hit:i64=-1;
    while (i>=0) {
        if (hit==-1) {
            let j:i64=0; let ok:i64=1;
            while (j<n.len) {
                if (h[i+j]!=n[j]) { ok=0; j=n.len; }
                else { j=j+1; }
            }
            if (ok==1) { hit=i; }
        }
        i=i-1;
    }
    return hit;
}

// ============ zoom machinery, candidate registry ============
// why codes: 1 count-letters-inside-word, 2 locate-target-word,
// 3 index-character-inside-word, 4 substring-scan-at-character-scale,
// 5 character-span, 6 measure-word-span.
fn why_str(w:i64) []u8 {
    if (w==1) { return "count-letters-inside-word"; }
    if (w==2) { return "locate-target-word"; }
    if (w==3) { return "index-character-inside-word"; }
    if (w==4) { return "substring-scan-at-character-scale"; }
    if (w==6) { return "measure-word-span"; }
    return "character-span";
}
// mg_zoom addresses the sub-span [roff,roff+rlen) of parent span and logs
// (qid, span, parent, off, len, depth, why) to the zoom ledger. tag is the
// run tag ("CAND" in derivation, "INTAKE" on the live path).
fn mg_zoom(tag:[]u8, qid:i64, parent:i64, roff:i64, rlen:i64, depth:i64, why:i64,
           soff:[]u8, slen:[]u8, nsp:*i64,
           zlog:[]u8, zn:*i64,
           out:[]u8, atp:*i64, scr:[]u8) i64 {
    let a:i64=atp.*;
    let po:i64=r_u32le(soff,parent*4);
    let id:i64=nsp.*;
    w_u32le(soff,id*4,po+roff); w_u32le(slen,id*4,rlen);
    nsp.*=id+1;
    let z:i64=zn.*;
    let b:i64=z*28;
    w_u32le(zlog,b,qid); w_u32le(zlog,b+4,id); w_u32le(zlog,b+8,parent);
    w_u32le(zlog,b+12,po+roff); w_u32le(zlog,b+16,rlen);
    w_u32le(zlog,b+20,depth); w_u32le(zlog,b+24,why);
    zn.*=z+1;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a," zoom qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," span=");
    a=ob_i64(out,a,id,scr);
    a=ob_raw(out,a," parent=");
    a=ob_i64(out,a,parent,scr);
    a=ob_raw(out,a," off=");
    a=ob_i64(out,a,po+roff,scr);
    a=ob_raw(out,a," len=");
    a=ob_i64(out,a,rlen,scr);
    a=ob_raw(out,a," depth=");
    a=ob_i64(out,a,depth,scr);
    a=ob_raw(out,a," why=");
    a=ob_raw(out,a,why_str(why));
    a=ob_nl(out,a);
    atp.*=a;
    return id;
}
// stats pack: bit0 correct, bit1 native, bit2 fallback,
// bits8..39 ops, bits40..47 maxdepth, bits48..55 nzooms.
fn pack_stats(correct:i64, native:i64, fb:i64, ops:i64, maxd:i64, nz:i64) i64 {
    return correct+(native*2)+(fb*4)+(ops*256)+(maxd*1099511627776)+(nz*281474976710656);
}
// emit_choice: the choice line (tag qid kind chunk why).
fn emit_choice(tag:[]u8, qid:i64, kind:i64, chunk:[]u8, why:[]u8,
               out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a," qid=");
    a=ob_i64(out,a,qid,scr);
    a=ob_raw(out,a," kind=");
    a=ob_raw(out,a,kind_name(kind));
    a=ob_raw(out,a," chunk=");
    a=ob_raw(out,a,chunk);
    a=ob_raw(out,a," why=\"");
    a=ob_raw(out,a,why);
    a=ob_raw(out,a,"\"");
    a=ob_nl(out,a);
    atp.*=a;
    return;
}
// emit_resline: the result line.
fn emit_resline(tag:[]u8, ans:[]u8, exp:[]u8, correct:i64, native:i64, fb:i64,
                ops:i64, maxd:i64, nz:i64,
                out:[]u8, atp:*i64, scr:[]u8) void {
    let a:i64=atp.*;
    a=ob_raw(out,a,tag);
    a=ob_raw(out,a,"R ans=\"");
    a=ob_raw(out,a,ans);
    a=ob_raw(out,a,"\" exp=\"");
    a=ob_raw(out,a,exp);
    a=ob_raw(out,a,"\" correct=");
    a=ob_i64(out,a,correct,scr);
    a=ob_raw(out,a," native=");
    a=ob_i64(out,a,native,scr);
    a=ob_raw(out,a," fallback=");
    a=ob_i64(out,a,fb,scr);
    a=ob_raw(out,a," ops=");
    a=ob_i64(out,a,ops,scr);
    a=ob_raw(out,a," maxdepth=");
    a=ob_i64(out,a,maxd,scr);
    a=ob_raw(out,a," zooms=");
    a=ob_i64(out,a,nz,scr);
    a=ob_nl(out,a);
    atp.*=a;
    return;
}
// emit_cand: choice line + result line (no zooms between).
fn emit_cand(tag:[]u8, qid:i64, kind:i64, chunk:[]u8, why:[]u8,
             ans:[]u8, exp:[]u8, correct:i64, native:i64, fb:i64,
             ops:i64, maxd:i64, nz:i64,
             out:[]u8, atp:*i64, scr:[]u8) void {
    emit_choice(tag,qid,kind,chunk,why,out,atp,scr);
    emit_resline(tag,ans,exp,correct,native,fb,ops,maxd,nz,out,atp,scr);
    return;
}
// ---------- candidate registry ----------
// 1 CHAR, 2 WORD, 3 WORD_ZOOM, 4 WORD_TRY_SCAN, 5 REV_WORD,
// 6 BOTH_ENDS, 7 SPAN3, 8 SPAN5, 9 END_DIRECT
fn cand_name(c:i64) []u8 {
    if (c==1) { return "CHAR"; }
    if (c==2) { return "WORD"; }
    if (c==3) { return "WORD>CHAR"; }
    if (c==4) { return "WORD?CHARSCAN"; }
    if (c==5) { return "REV_WORD"; }
    if (c==6) { return "BOTH_ENDS"; }
    if (c==7) { return "SPAN3"; }
    if (c==8) { return "SPAN5"; }
    if (c==9) { return "END_DIRECT"; }
    if (c==10) { return "DELIM"; }
    return "?";
}
// coarseness rank for the deterministic tie-break (prefer coarser).
// coarseness rank: LOWER = coarser chunking unit (preferred on exact ties).
// 1 = word-scale units (WORD, REV_WORD); 2 = word-scale locate resolving to
// char scale (WORD>CHAR, WORD?CHARSCAN); 3 = byte-scale work (CHAR,
// BOTH_ENDS, SPAN3, SPAN5, END_DIRECT).
fn coarseness(c:i64) i64 {
    if (c==2) { return 1; }
    if (c==5) { return 1; }
    if (c==3) { return 2; }
    if (c==4) { return 2; }
    if (c==10) { return 2; }
    return 3;
}
// cand_why: each candidate's intrinsic reason for its chunking.
fn cand_why(c:i64, kind:i64) []u8 {
    if (c==1) { return "character units: letters and indices live at byte scale; space-scan addressing, no word table"; }
    if (c==2) { return "word units: the question is about word structure; sub-word work is out-of-unit"; }
    if (c==3) {
        if (kind==2) { return "locate the named word at word scale, then magnify to character units for the index"; }
        if (kind==12) { return "locate the Nth word at word scale, magnify to character units for the index"; }
        if (kind==1) { return "multi-token letter count: enumerate words at word scale, magnify to character units inside each word"; }
        if (kind==6) { return "try word-boundary match first; magnify to a character span scan on miss"; }
        return "word-scale locate, character-scale resolve, traced zooms";
    }
    if (c==4) {
        if (kind==6) { return "cheap word-boundary attempt first; magnify to character-span scan only on miss"; }
        if (kind==17) { return "cheap word-boundary attempt inside the addressed word; magnify to character-span scan on miss"; }
        return "WORD?CHARSCAN on a non-CONTAINS kind: behaves exactly as WORD>CHAR";
    }
    if (c==5) { return "address from the right: the question is anchored at the end of the text"; }
    if (c==6) { return "scan from both ends toward the middle: first hit from either side wins"; }
    if (c==7) { return "fixed 3-byte spans"; }
    if (c==8) { return "fixed 5-byte spans"; }
    if (c==9) {
        if (kind==8) { return "first-letter questions name the text edge: read it directly"; }
        if (kind==9) { return "last-letter questions name the text edge: read it directly"; }
        if (kind==14) { return "first letter of an addressed word: read the word edge directly"; }
        if (kind==15) { return "last letter of an addressed word: read the word edge directly"; }
        return "END_DIRECT on a non-edge kind: behaves exactly as CHAR";
    }
    if (c==10) { return "delimiter-knowledge addressing: granularity/ordinal/relation bindings placed by TNN resolve the address; the mechanism only executes it"; }
    return "read the addressed end directly: no scan when the question names the edge";
}

// ============ candidate 1: CHAR (character units + space-scan addressing) ============
// Native everywhere. Never builds a word table.
fn cand_char(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
             out:[]u8, atp:*i64, scr:[]u8,
             soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
             woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let ops:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        let cnt:i64=scan_count(t,0,t.len,parse_target_letter(q));
        ops=t.len;
        alen=ob_i64(abuf,0,cnt,scr); ans=abuf[0..alen];
    }
    if (kind==10) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let cnt:i64=scan_count(t,oo,ll,parse_target_letter(q));
            ops=ops+ll;
            alen=ob_i64(abuf,0,cnt,scr); ans=abuf[0..alen];
        }
    }
    if (kind==2) {
        let n:i64=parse_pos_n(q,know);
        let idx:i64=n-1;
        if (idx<0) { idx=0; }
        let tw:[]u8=parse_after(q,"of ");
        let oo:i64=0; let ll:i64=t.len;
        if (beq(tw,t)==0) {
            let f:i64=ws_find(t,tw,&oo,&ll,&ops);
            if (f==0) { oo=0; ll=0; }
        }
        if (ll==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (idx>=ll) { idx=ll-1; }
            abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
            ops=ops+idx+1;
        }
    }
    if (kind==12) {
        let n:i64=parse_pos_n(q,know);
        let idx:i64=n-1;
        if (idx<0) { idx=0; }
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (idx>=ll) { idx=ll-1; }
            abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
            ops=ops+idx+1;
        }
    }
    if (kind==8) {
        let tw:[]u8=parse_after(q,"of ");
        let oo:i64=0; let ll:i64=t.len;
        if (beq(tw,t)==0) {
            let f:i64=ws_find(t,tw,&oo,&ll,&ops);
            if (f==0) { oo=0; ll=0; }
        }
        if (ll==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
    }
    if (kind==9) {
        let tw:[]u8=parse_after(q,"of ");
        let oo:i64=0; let ll:i64=t.len;
        if (beq(tw,t)==0) {
            let f:i64=ws_find(t,tw,&oo,&ll,&ops);
            if (f==0) { oo=0; ll=0; }
        }
        if (ll==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll; }
    }
    if (kind==14) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
    }
    if (kind==15) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll; }
    }
    if (kind==3) {
        reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=t.len;
    }
    if (kind==13) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let j:i64=0;
            while (j<ll) { revbuf[j]=t[oo+ll-1-j]; j=j+1; }
            ans=revbuf[0..ll]; ops=ops+ll;
        }
    }
    if (kind==4) {
        let n:i64=ws_count(t,&ops);
        alen=ob_i64(abuf,0,n,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=1;
        alen=ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==11) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { ops=ops+1; alen=ob_i64(abuf,0,ll,scr); ans=abuf[0..alen]; }
    }
    if (kind==6) {
        let needle:[]u8=parse_after(q,"contain ");
        ops=t.len;
        if (find_sub(t,needle)>=0) { ans="yes"; }
        else { ans="no"; }
    }
    if (kind==17) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let needle:[]u8=parse_after(q,"contain ");
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let seg:[]u8=t[oo..oo+ll];
            ops=ops+ll;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==7) {
        let e:i64=t.len; let i:i64=0; let stop:i64=0;
        while (i<t.len) {
            if (stop==0) {
                if (t[i]==32) { e=i; stop=1; }
            }
            i=i+1;
        }
        ans=t[0..e]; ops=e;
    }
    if (kind==16) {
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,-1,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { ans=t[oo..oo+ll]; }
    }
    let correct:i64=beq(ans,exp);
    emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
    return pack_stats(correct,1,0,ops,0,0);
}

// ============ candidate 2: WORD (word table; sub-word = recorded fallback) ============
fn cand_word(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
             out:[]u8, atp:*i64, scr:[]u8,
             soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
             woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let nw:i64=enum_words(t,woffs,wlens);
    let ops:i64=nw; let fb:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        fb=1;
        let tgt:u8=parse_target_letter(q);
        let total:i64=0; let k:i64=0;
        while (k<nw) {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            total=total+scan_count(t,wo,wl,tgt);
            k=k+1;
        }
        ops=nw+t.len;
        alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
    }
    if (kind==10) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            let total:i64=scan_count(t,wo,wl,parse_target_letter(q));
            ops=nw+wl;
            alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
        }
    }
    if (kind==2) {
        fb=1;
        let n:i64=parse_pos_n(q,know);
        let tw:[]u8=parse_after(q,"of ");
        let wo:i64=0; let wl:i64=t.len; let okw:i64=1;
        if (beq(tw,t)==0) {
            let k:i64=find_word(t,woffs,wlens,nw,tw);
            if (k<0) { okw=0; }
            else { wo=r_u32le(woffs,k*4); wl=r_u32le(wlens,k*4); }
        }
        ops=nw+n;
        if (okw==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (n>=1) {
                if (n<=wl) { abuf[0]=t[wo+n-1]; alen=1; ans=abuf[0..alen]; }
                else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
    }
    if (kind==12) {
        fb=1;
        let n:i64=parse_pos_n(q,know);
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        ops=nw+n;
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            if (n>=1) {
                if (n<=wl) { abuf[0]=t[wo+n-1]; alen=1; ans=abuf[0..alen]; }
                else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
    }
    if (kind==8) {
        fb=1;
        let tw:[]u8=parse_after(q,"of ");
        let wo:i64=0; let okw:i64=1;
        if (beq(tw,t)==0) {
            let k:i64=find_word(t,woffs,wlens,nw,tw);
            if (k<0) { okw=0; }
            else { wo=r_u32le(woffs,k*4); }
        }
        ops=nw+1;
        if (okw==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[wo]; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==9) {
        fb=1;
        let tw:[]u8=parse_after(q,"of ");
        let wo:i64=0; let wl:i64=t.len; let okw:i64=1;
        if (beq(tw,t)==0) {
            let k:i64=find_word(t,woffs,wlens,nw,tw);
            if (k<0) { okw=0; }
            else { wo=r_u32le(woffs,k*4); wl=r_u32le(wlens,k*4); }
        }
        ops=nw+1;
        if (okw==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[wo+wl-1]; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==14) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        ops=nw+1;
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { let wo:i64=r_u32le(woffs,k*4); abuf[0]=t[wo]; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==15) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        ops=nw+1;
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            abuf[0]=t[wo+wl-1]; alen=1; ans=abuf[0..alen];
        }
    }
    if (kind==3) {
        fb=1;
        let single:i64=0;
        if (nw==1) { single=1; }
        if (single==1) {
            reverse_into(t,revbuf);
            ans=revbuf[0..t.len];
        }
        else {
            // wordwise reverse (the retired W arm's behavior): wrong on multi-token
            let i:i64=0;
            while (i<t.len) { revbuf[i]=t[i]; i=i+1; }
            let k:i64=0;
            while (k<nw) {
                let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
                let j:i64=0;
                while (j<wl) { revbuf[wo+j]=t[wo+wl-1-j]; j=j+1; }
                k=k+1;
            }
            ans=revbuf[0..t.len];
        }
        ops=nw+t.len;
    }
    if (kind==13) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            let j:i64=0;
            while (j<wl) { revbuf[j]=t[wo+wl-1-j]; j=j+1; }
            ans=revbuf[0..wl]; ops=nw+wl;
        }
    }
    if (kind==4) {
        ops=nw;
        alen=ob_i64(abuf,0,nw,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        let total:i64=0; let k:i64=0;
        while (k<nw) { total=total+r_u32le(wlens,k*4); k=k+1; }
        ops=nw;
        alen=ob_i64(abuf,0,total+nw-1,scr); ans=abuf[0..alen];
    }
    if (kind==11) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let k:i64=wn_index(wn,nw);
        ops=nw;
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { alen=ob_i64(abuf,0,r_u32le(wlens,k*4),scr); ans=abuf[0..alen]; }
    }
    if (kind==6) {
        let needle:[]u8=parse_after(q,"contain ");
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ops=nw; ans="yes";
        }
        else {
            fb=1;
            ops=nw+t.len;
            if (find_sub(t,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==17) {
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let needle:[]u8=parse_after(q,"contain ");
        let k:i64=wn_index(wn,nw);
        if (k<0) { fb=1; abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            if (wl==needle.len) {
                let seg:[]u8=t[wo..wo+wl];
                if (beq(seg,needle)==1) { ops=nw; ans="yes"; }
                else {
                    fb=1; ops=nw+wl;
                    if (find_sub(seg,needle)>=0) { ans="yes"; }
                    else { ans="no"; }
                }
            }
            else {
                fb=1; ops=nw+wl;
                let seg:[]u8=t[wo..wo+wl];
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
    }
    if (kind==7) {
        let wo:i64=r_u32le(woffs,0); let wl:i64=r_u32le(wlens,0);
        ans=t[wo..wo+wl]; ops=nw;
    }
    if (kind==16) {
        let k:i64=nw-1;
        let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
        ans=t[wo..wo+wl]; ops=nw;
    }
    let correct:i64=beq(ans,exp);
    let native:i64=1-fb;
    emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,native,fb,ops,0,0,out,atp,scr);
    return pack_stats(correct,native,fb,ops,0,0);
}

// ============ candidate 3: WORD_ZOOM (deliberative magnifier, fork's D) ============
// chunk codes: 1 CHAR, 2 WORD, 3 WORD>CHAR, 4 WORD?CHARSCAN (cand codes)
fn zoom_choose(kind:i64, shape:i64) i64 {
    if (kind==1) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==2) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==8) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==9) {
        if (shape==1) { return 3; }
        return 1;
    }
    if (kind==3) { return 1; }
    if (kind==4) { return 2; }
    if (kind==5) { return 1; }
    if (kind==6) { return 4; }
    if (kind==18) { return 10; }
    if (kind==19) { return 10; }
    if (kind==20) { return 10; }
    if (kind==21) { return 10; }
    return 2;
}
fn zoom_why(kind:i64, c:i64) []u8 {
    if (c==1) {
        if (kind==1) { return "letter question on a single token: character units; no coarser unit resolves letters"; }
        if (kind==3) { return "reversal is a byte-order operation: character units"; }
        if (kind==5) { return "length is a character count: character units"; }
        return "positional index on a single token: character units directly";
    }
    if (c==2) {
        if (kind==4) { return "word counting is a word-boundary operation: word units"; }
        return "word-boundary operation: word units";
    }
    if (c==3) {
        if (kind==1) { return "multi-token text: enumerate words at word scale, magnify to character units inside each word; letters live below word scale"; }
        return "locate the named word at word scale, then magnify to character units for the index";
    }
    return "try word-boundary match first; magnify to a character span scan on miss";
}
// zoom_locate: the span the question is about (whole text or named word),
// with traced zooms. Mirrors the fork's d_locate.
fn zoom_locate(tag:[]u8, qid:i64, q:[]u8, t:[]u8,
               soff:[]u8, slen:[]u8, nsp:*i64, zlog:[]u8, zn:*i64,
               woffs:[]u8, wlens:[]u8,
               out:[]u8, atp:*i64, scr:[]u8,
               oo:*i64, ll:*i64, maxd:*i64, nz:*i64, ops:*i64) i64 {
    let tw:[]u8=parse_after(q,"of ");
    if (beq(tw,t)==1) {
        oo.*=0; ll.*=t.len; return 0;
    }
    let nw:i64=enum_words(t,woffs,wlens);
    ops.*=ops.*+nw;
    let k:i64=find_word(t,woffs,wlens,nw,tw);
    if (k<0) {
        // stage B target delimitation: the tail captured after "of " may
        // carry a context suffix ("... of the in the quick brown the fox");
        // retry with its first whitespace-delimited token. Only fires when
        // the legacy lookup already failed, so no working question changes.
        let ft:[]u8=first_token(tw);
        if (ft.len>0) {
            if (ft.len<tw.len) { k=find_word(t,woffs,wlens,nw,ft); }
        }
        if (k<0) { oo.*=0; ll.*=0; return -1; }
    }
    let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
    let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,nsp,zlog,zn,out,atp,scr);
    nz.*=nz.*+1;
    if (maxd.*<1) { maxd.*=1; }
    oo.*=wo; ll.*=wl;
    return sid;
}
// cand_zoom_19: kinds 1-9, verbatim port of the fork's deliberative arm.
fn cand_zoom_19(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
                tag:[]u8, why:[]u8,
                out:[]u8, atp:*i64, scr:[]u8,
                soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let c:i64=zoom_choose(kind,shape);
    w_u32le(soff,0,0); w_u32le(slen,0,t.len);
    let nsp:i64=1;
    let ops:i64=0; let maxd:i64=0; let nzooms:i64=0;
    emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    if (kind==1) {
        let tgt:u8=parse_target_letter(q);
        if (c==1) {
            let cnt:i64=scan_count(t,0,t.len,tgt);
            ops=t.len;
            alen=ob_i64(abuf,0,cnt,scr); ans=abuf[0..alen];
        }
        else {
            let nw:i64=enum_words(t,woffs,wlens);
            ops=nw;
            let total:i64=0; let k:i64=0;
            while (k<nw) {
                let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,1,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                total=total+scan_count(t,so2,sl2,tgt);
                ops=ops+wl;
                k=k+1;
            }
            alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
        }
    }
    if (kind==2) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        let n:i64=parse_pos_n(q,know);
        let idx:i64=n-1;
        if (loc<0 || ll==0) { // DEGENERATE GUARD 2026-09-26: empty located span (empty text on a whole-text position question) answers '?' like a miss, never indexes an empty slice
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (idx<0) { idx=0; }
            if (idx>=ll) { idx=ll-1; }
            if (c==1) {
                abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,idx,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
        }
    }
    if (kind==8) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        if (loc<0 || ll==0) { // DEGENERATE GUARD 2026-09-26: empty located span (empty text on a whole-text position question) answers '?' like a miss, never indexes an empty slice
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (c==1) {
                abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,0,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
        }
    }
    if (kind==9) {
        let oo:i64=0; let ll:i64=0;
        let loc:i64=zoom_locate(tag,qid,q,t,soff,slen,&nsp,zlog,zn,woffs,wlens,out,atp,scr,&oo,&ll,&maxd,&nzooms,&ops);
        if (loc<0 || ll==0) { // DEGENERATE GUARD 2026-09-26: empty located span (empty text on a whole-text position question) answers '?' like a miss, never indexes an empty slice
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            if (c==1) {
                abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll;
            }
            else {
                let sid2:i64=mg_zoom(tag,qid,loc,ll-1,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+ll;
            }
        }
    }
    if (kind==3) {
        reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=t.len;
    }
    if (kind==4) {
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        alen=ob_i64(abuf,0,nw,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=t.len;
        alen=ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==6) {
        let needle:[]u8=parse_after(q,"contain ");
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ans="yes";
        }
        else {
            let sid:i64=mg_zoom(tag,qid,0,0,t.len,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
            nzooms=nzooms+1; maxd=1;
            let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
            let seg:[]u8=t[so2..so2+sl2];
            ops=ops+sl2;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==7) {
        let nw:i64=enum_words(t,woffs,wlens);
        ops=nw;
        let wo:i64=r_u32le(woffs,0); let wl:i64=r_u32le(wlens,0);
        ans=t[wo..wo+wl];
    }
    let correct:i64=beq(ans,exp);
    emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
    return pack_stats(correct,1,0,ops,maxd,nzooms);
}
// cand_zoom: WORD_ZOOM on all kinds (1-9 via the fork's logic, 10-17 nested).
fn cand_zoom(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
             tag:[]u8, why:[]u8,
             out:[]u8, atp:*i64, scr:[]u8,
             soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
             woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    if (kind<=9) {
        return cand_zoom_19(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                            soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    w_u32le(soff,0,0); w_u32le(slen,0,t.len);
    let nsp:i64=1;
    let nw:i64=enum_words(t,woffs,wlens);
    let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
    let k:i64=wn_index(wn,nw);
    if (kind==16) {
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        let kk:i64=nw-1;
        let wo:i64=r_u32le(woffs,kk*4); let wl:i64=r_u32le(wlens,kk*4);
        ans=t[wo..wo+wl];
    }
    else {
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        if (k<0) {
            abuf[0]=63; alen=1; ans=abuf[0..alen];
        }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            if (kind==10) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,1,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let total:i64=scan_count(t,so2,sl2,parse_target_letter(q));
                ops=ops+wl;
                alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
            }
            if (kind==11) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,6,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                ops=ops+1;
                alen=ob_i64(abuf,0,wl,scr); ans=abuf[0..alen];
            }
            if (kind==12) {
                let n:i64=parse_pos_n(q,know);
                let idx:i64=n-1;
                if (idx<0) { idx=0; }
                if (idx>=wl) { idx=wl-1; }
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,idx,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
            if (kind==13) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let j:i64=0;
                while (j<sl2) { revbuf[j]=t[so2+sl2-1-j]; j=j+1; }
                ans=revbuf[0..sl2]; ops=ops+wl;
            }
            if (kind==14) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,0,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+1;
            }
            if (kind==15) {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,2,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let sid2:i64=mg_zoom(tag,qid,sid,wl-1,1,2,3,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=2;
                let so3:i64=r_u32le(soff,sid2*4);
                abuf[0]=t[so3]; alen=1; ans=abuf[0..alen]; ops=ops+wl;
            }
            if (kind==17) {
                let needle:[]u8=parse_after(q,"contain ");
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let seg:[]u8=t[so2..so2+sl2];
                ops=ops+sl2;
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
    }
    let correct:i64=beq(ans,exp);
    emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
    return pack_stats(correct,1,0,ops,maxd,nzooms);
}

// ============ candidate 4: WORD_TRY_SCAN ============
// Word-boundary attempt first; character-span magnification only on miss.
// Non-CONTAINS kinds behave exactly as WORD_ZOOM.
fn cand_tryscan(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
                tag:[]u8, why:[]u8,
                out:[]u8, atp:*i64, scr:[]u8,
                soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    if (kind==6) {
        w_u32le(soff,0,0); w_u32le(slen,0,t.len);
        let nsp:i64=1;
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        let needle:[]u8=parse_after(q,"contain ");
        let ans:[]u8=abuf[0..0];
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ans="yes";
        }
        else {
            let sid:i64=mg_zoom(tag,qid,0,0,t.len,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
            nzooms=nzooms+1; maxd=1;
            let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
            let seg:[]u8=t[so2..so2+sl2];
            ops=ops+sl2;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
        return pack_stats(correct,1,0,ops,maxd,nzooms);
    }
    if (kind==17) {
        w_u32le(soff,0,0); w_u32le(slen,0,t.len);
        let nsp:i64=1;
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw; let maxd:i64=0; let nzooms:i64=0;
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        let ans:[]u8=abuf[0..0];
        let alen:i64=0;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let needle:[]u8=parse_after(q,"contain ");
        let k:i64=wn_index(wn,nw);
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            let whole:i64=0;
            if (wl==needle.len) {
                let seg0:[]u8=t[wo..wo+wl];
                if (beq(seg0,needle)==1) { whole=1; }
            }
            if (whole==1) {
                ans="yes";
            }
            else {
                let sid:i64=mg_zoom(tag,qid,0,wo,wl,1,4,soff,slen,&nsp,zlog,zn,out,atp,scr);
                nzooms=nzooms+1; maxd=1;
                let so2:i64=r_u32le(soff,sid*4); let sl2:i64=r_u32le(slen,sid*4);
                let seg:[]u8=t[so2..so2+sl2];
                ops=ops+sl2;
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,maxd,nzooms,out,atp,scr);
        return pack_stats(correct,1,0,ops,maxd,nzooms);
    }
    return cand_zoom(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                     soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
}

// ============ candidate 5: REV_WORD (right-to-left addressing, no word table) ============
// For last-anchored questions it scans from the END of the text; everything
// else delegates to WORD. The weird hypothesis: end-anchored questions are
// cheaper addressed from the right.
fn rlocate_last(t:[]u8, oo:*i64, ll:*i64, ops:*i64) i64 {
    let L:i64=t.len;
    if (L==0) { oo.*=0; ll.*=0; return 0; }
    let i:i64=L-1; let e:i64=0; let go:i64=1; let any:i64=0;
    while (i>=0) {
        if (go==1) {
            if (t[i]==32) { i=i-1; }
            else { e=i; go=0; any=1; }
        }
        else { i=-1; }
    }
    if (any==0) { oo.*=0; ll.*=0; return 0; }
    let s:i64=e; let go2:i64=1; i=e;
    while (i>=0) {
        if (go2==1) {
            if (t[i]==32) { s=i+1; go2=0; }
            else { i=i-1; }
        }
        else { i=-1; }
    }
    if (go2==1) { s=0; }
    ops.*=ops.*+(L-s);
    oo.*=s; ll.*=e-s+1;
    return 1;
}
fn cand_revword(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
                out:[]u8, atp:*i64, scr:[]u8,
                soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let last_anchored:i64=0;
    if (kind==16) { last_anchored=1; }
    else {
        if (kind==10) { last_anchored=1; }
        if (kind==11) { last_anchored=1; }
        if (kind==12) { last_anchored=1; }
        if (kind==13) { last_anchored=1; }
        if (kind==14) { last_anchored=1; }
        if (kind==15) { last_anchored=1; }
        if (kind==17) { last_anchored=1; }
    }
    if (last_anchored==1) {
        let wn:i64=-1;
        if (kind!=16) {
            let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
            if (wn!=-1) {
                // not actually last-anchored: fall back to WORD addressing
                return cand_word(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                                 soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
            }
        }
        let ops:i64=0;
        let oo:i64=0; let ll:i64=0;
        let f:i64=rlocate_last(t,&oo,&ll,&ops);
        let ans:[]u8=abuf[0..0];
        let alen:i64=0;
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (kind==16) { ans=t[oo..oo+ll]; }
            if (kind==10) {
                let total:i64=scan_count(t,oo,ll,parse_target_letter(q));
                ops=ops+ll;
                alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
            }
            if (kind==11) { ops=ops+1; alen=ob_i64(abuf,0,ll,scr); ans=abuf[0..alen]; }
            if (kind==12) {
                let n:i64=parse_pos_n(q,know);
                let idx:i64=n-1;
                if (idx<0) { idx=0; }
                if (idx>=ll) { idx=ll-1; }
                abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
                ops=ops+idx+1;
            }
            if (kind==13) {
                let j:i64=0;
                while (j<ll) { revbuf[j]=t[oo+ll-1-j]; j=j+1; }
                ans=revbuf[0..ll]; ops=ops+ll;
            }
            if (kind==14) { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
            if (kind==15) { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll; }
            if (kind==17) {
                let needle:[]u8=parse_after(q,"contain ");
                let seg:[]u8=t[oo..oo+ll];
                ops=ops+ll;
                if (find_sub(seg,needle)>=0) { ans="yes"; }
                else { ans="no"; }
            }
        }
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    return cand_word(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                     soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
}

// ============ candidate 6: BOTH_ENDS ============
// Word-boundary attempt, then substring scan from BOTH ends toward the
// middle (forward for the needle, backward for the reversed needle).
// First hit from either side wins; ops = visits interleaved from both ends.
fn cand_bothends(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
                 out:[]u8, atp:*i64, scr:[]u8,
                 soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                 woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    if (kind==6) {
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw;
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        let needle:[]u8=parse_after(q,"contain ");
        let ans:[]u8=abuf[0..0];
        let k:i64=find_word(t,woffs,wlens,nw,needle);
        if (k>=0) {
            ans="yes";
        }
        else {
            let hi:i64=find_sub(t,needle);
            let rj:i64=find_sub_rev(t,needle);
            if (hi<0) {
                if (rj<0) { ans="no"; ops=ops+2*t.len; }
                else { ans="yes"; ops=ops+2*rj+needle.len; }
            }
            else {
                if (rj<0) { ans="yes"; ops=ops+2*hi+needle.len; }
                else {
                    let m:i64=hi;
                    if (rj<m) { m=rj; }
                    ans="yes"; ops=ops+2*m+needle.len;
                }
            }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    if (kind==17) {
        let nw:i64=enum_words(t,woffs,wlens);
        let ops:i64=nw;
        emit_choice(tag,qid,kind,cand_name(winner),why,out,atp,scr);
        let ans:[]u8=abuf[0..0];
        let alen:i64=0;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let needle:[]u8=parse_after(q,"contain ");
        let k:i64=wn_index(wn,nw);
        if (k<0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let wo:i64=r_u32le(woffs,k*4); let wl:i64=r_u32le(wlens,k*4);
            let seg:[]u8=t[wo..wo+wl];
            let whole:i64=0;
            if (wl==needle.len) {
                if (beq(seg,needle)==1) { whole=1; }
            }
            if (whole==1) { ans="yes"; }
            else {
                let hi:i64=find_sub(seg,needle);
                let rj:i64=find_sub_rev(seg,needle);
                if (hi<0) {
                    if (rj<0) { ans="no"; ops=ops+2*wl; }
                    else { ans="yes"; ops=ops+2*rj+needle.len; }
                }
                else {
                    if (rj<0) { ans="yes"; ops=ops+2*hi+needle.len; }
                    else {
                        let m:i64=hi;
                        if (rj<m) { m=rj; }
                        ans="yes"; ops=ops+2*m+needle.len;
                    }
                }
            }
        }
        let correct:i64=beq(ans,exp);
        emit_resline(tag,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    return cand_char(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                     soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
}

// ============ candidates 7/8: SPAN3 / SPAN5 (fixed K-byte spans) ============
// The weird-fixed hypothesis: odd span sizes. Sub-span work is a recorded
// fallback (like the retired S arm).
fn cand_span(spank:i64, qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
             out:[]u8, atp:*i64, scr:[]u8,
             soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
             woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let nspans:i64=(t.len+spank-1)/spank;
    let ops:i64=0; let fb:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    let cname:[]u8="SPAN3";
    if (spank==5) { cname="SPAN5"; }
    if (kind==1) {
        fb=1;
        let tgt:u8=parse_target_letter(q);
        let total:i64=0; let s:i64=0;
        while (s<nspans) {
            let so:i64=s*spank; let sl:i64=spank;
            if (so+sl>t.len) { sl=t.len-so; }
            total=total+scan_count(t,so,sl,tgt);
            s=s+1;
        }
        ops=nspans+t.len;
        alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
    }
    if (kind==10) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let total:i64=scan_count(t,oo,ll,parse_target_letter(q));
            ops=ops+ll;
            alen=ob_i64(abuf,0,total,scr); ans=abuf[0..alen];
        }
    }
    if (kind==2) {
        fb=1;
        let n:i64=parse_pos_n(q,know);
        ops=2;
        // fixed-span reading: index the whole text (the retired S behavior)
        if (n>=1) {
            if (n<=t.len) { abuf[0]=t[n-1]; alen=1; ans=abuf[0..alen]; }
            else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        }
        else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
    }
    if (kind==12) {
        fb=1;
        let n:i64=parse_pos_n(q,know);
        let idx:i64=n-1;
        if (idx<0) { idx=0; }
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            if (idx>=ll) { idx=ll-1; }
            abuf[0]=t[oo+idx]; alen=1; ans=abuf[0..alen];
            ops=ops+idx+1;
        }
    }
    if (kind==8) {
        fb=1; abuf[0]=t[0]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==9) {
        fb=1; abuf[0]=t[t.len-1]; alen=1; ans=abuf[0..alen]; ops=1;
    }
    if (kind==14) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
    }
    if (kind==15) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+ll; }
    }
    if (kind==3) {
        fb=1;
        reverse_into(t,revbuf);
        ans=revbuf[0..t.len];
        ops=nspans+t.len;
    }
    if (kind==13) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let j:i64=0;
            while (j<ll) { revbuf[j]=t[oo+ll-1-j]; j=j+1; }
            ans=revbuf[0..ll]; ops=ops+ll;
        }
    }
    if (kind==4) {
        fb=1;
        let n:i64=ws_count(t,&ops);
        ops=ops+nspans;
        alen=ob_i64(abuf,0,n,scr); ans=abuf[0..alen];
    }
    if (kind==5) {
        ops=nspans;
        alen=ob_i64(abuf,0,t.len,scr); ans=abuf[0..alen];
    }
    if (kind==11) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { alen=ob_i64(abuf,0,ll,scr); ans=abuf[0..alen]; }
    }
    if (kind==6) {
        fb=1;
        let p:i64=find_sub(t,parse_after(q,"contain "));
        ops=nspans+t.len;
        if (p>=0) { ans="yes"; }
        else { ans="no"; }
    }
    if (kind==17) {
        fb=1;
        let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
        let needle:[]u8=parse_after(q,"contain ");
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else {
            let seg:[]u8=t[oo..oo+ll];
            ops=ops+ll;
            if (find_sub(seg,needle)>=0) { ans="yes"; }
            else { ans="no"; }
        }
    }
    if (kind==7) {
        fb=1;
        let e:i64=t.len; let i:i64=0; let stop:i64=0;
        while (i<t.len) {
            if (stop==0) {
                if (t[i]==32) { e=i; stop=1; }
            }
            i=i+1;
        }
        ans=t[0..e]; ops=nspans+e;
    }
    if (kind==16) {
        fb=1;
        let oo:i64=0; let ll:i64=0;
        let f:i64=ws_locate(t,-1,&oo,&ll,&ops);
        if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        else { ans=t[oo..oo+ll]; }
    }
    let correct:i64=beq(ans,exp);
    let native:i64=1-fb;
    emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,native,fb,ops,0,0,out,atp,scr);
    return pack_stats(correct,native,fb,ops,0,0);
}

// ============ candidate 9: END_DIRECT ============
// When the question names an edge (first/last), read that edge directly —
// no scan, no table. The weird hypothesis: edges are addressable, not searchable.
fn cand_enddirect(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
                  out:[]u8, atp:*i64, scr:[]u8,
                  soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
                  woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    let ops:i64=0;
    let ans:[]u8=abuf[0..0];
    let alen:i64=0;
    let edge:i64=0;
    if (kind==8) { edge=1; }
    if (kind==9) { edge=1; }
    if (kind==14) { edge=1; }
    if (kind==15) { edge=1; }
    if (edge==1) {
        if (kind==8) {
            let tw:[]u8=parse_after(q,"of ");
            let oo:i64=0; let ll:i64=t.len;
            if (beq(tw,t)==0) {
                let f:i64=ws_find(t,tw,&oo,&ll,&ops);
                if (f==0) { oo=0; ll=0; }
            }
            if (ll==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            else { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
        }
        if (kind==9) {
            let tw:[]u8=parse_after(q,"of ");
            let oo:i64=0; let ll:i64=t.len;
            if (beq(tw,t)==0) {
                let f:i64=ws_find(t,tw,&oo,&ll,&ops);
                if (f==0) { oo=0; ll=0; }
            }
            if (ll==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            else { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
        }
        if (kind==14) {
            let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
            let oo:i64=0; let ll:i64=0;
            let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
            if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            else { abuf[0]=t[oo]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
        }
        if (kind==15) {
            let wn:i64=0; let inner:[]u8=parse_wordref2(q,t,&wn,know,woffs,wlens);
            let oo:i64=0; let ll:i64=0;
            let f:i64=ws_locate(t,wn,&oo,&ll,&ops);
            if (f==0) { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
            else { abuf[0]=t[oo+ll-1]; alen=1; ans=abuf[0..alen]; ops=ops+1; }
        }
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    return cand_char(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                     soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
}


// ============ candidate 10: DELIM (2026-09-26 battery-fix, stage B) ============
// Delimiter-knowledge addressing. The address structure (which granularity,
// which ordinal, which relation offset) is resolved from the TNN-placed
// registry; this candidate only executes the resolved address. Unresolved
// addresses withhold ('?'), never guess.
fn cand_delim(qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8, tag:[]u8, why:[]u8,
              out:[]u8, atp:*i64, scr:[]u8,
              soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
              woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    // kind 21: two-hop "the letter <rel> the <ord> letter of <target> [context]"
    if (kind==21) {
        let ops:i64=0;
        let alen:i64=0;
        let ri:i64=-1; let p2:i64=-1; let x:i64=0;
        while (x<know_rel_n(know)) {
            let pp:i64=rel_probe_pos(q,know,x,"letter "," the ");
            if (pp>=0) { if (ri<0) { ri=x; p2=pp; } }
            x=x+1;
        }
        if (ri<0) { abuf[0]=63; alen=1; }
        else {
            let rw:[]u8=rel_word(know,ri);
            let ord:i64=parse_ordinal(q,p2+7+rw.len+5,know);
            if (ord<0) { ord=parse_digits(q,p2+7+rw.len+5); }
            let tail:[]u8=parse_after(q,"of ");
            let tgt:[]u8=first_token(tail);
            let nw:i64=enum_words(t,woffs,wlens);
            let ti:i64=find_word(t,woffs,wlens,nw,tgt);
            if (ti<0) { abuf[0]=63; alen=1; }
            else {
                let wo:i64=r_u32le(woffs,ti*4); let wl:i64=r_u32le(wlens,ti*4);
                let tword:[]u8=t[wo..wo+wl];
                let idx:i64=ord-1;
                if (idx<0) { idx=0; }
                if (idx>=tword.len) { abuf[0]=63; alen=1; }
                else {
                    let j:i64=idx+rel_delta(know,ri);
                    if (j<0) { abuf[0]=63; alen=1; }
                    else {
                        if (j>=tword.len) { abuf[0]=63; alen=1; }
                        else { abuf[0]=tword[j]; alen=1; }
                    }
                }
                ops=ops+tword.len;
            }
        }
        let ans:[]u8=abuf[0..alen];
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    // kinds 18/19/20 (granularity) land in stage C; anything else withholds.
    abuf[0]=63;
    emit_cand(tag,qid,kind,cand_name(winner),why,abuf[0..1],exp,0,1,0,0,0,0,out,atp,scr);
    return pack_stats(0,1,0,0,0,0);
}

// ============ dispatcher ============
fn cand_answer(c:i64, qid:i64, kind:i64, shape:i64, q:[]u8, t:[]u8, exp:[]u8,
               tag:[]u8, why:[]u8,
               out:[]u8, atp:*i64, scr:[]u8,
               soff:[]u8, slen:[]u8, zlog:[]u8, zn:*i64,
               woffs:[]u8, wlens:[]u8, revbuf:[]u8, abuf:[]u8, know:[]u8, winner:i64) i64 {
    if (c==1) {
        return cand_char(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                         soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==2) {
        return cand_word(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                         soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==3) {
        return cand_zoom(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                         soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==4) {
        return cand_tryscan(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                            soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==5) {
        return cand_revword(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                            soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==6) {
        return cand_bothends(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                             soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==7) {
        return cand_span(3,qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                         soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==8) {
        return cand_span(5,qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                         soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    if (c==10) {
        return cand_delim(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                          soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
    }
    return cand_enddirect(qid,kind,shape,q,t,exp,tag,why,out,atp,scr,
                          soff,slen,zlog,zn,woffs,wlens,revbuf,abuf,know,winner);
}

// ---------- FROZEN LEARNED POLICY (measured artifact) ----------
fn policy_winner(kind:i64, shape:i64) i64 {
    if (kind==1) { if (shape==1) { return 1; } return 3; }
    if (kind==2) { return 3; }
    if (kind==3) { return 3; }
    if (kind==4) { return 2; }
    if (kind==5) { if (shape==1) { return 1; } return 2; }
    if (kind==6) { if (shape==1) { return 3; } return 6; }
    if (kind==7) { if (shape==1) { return 1; } return 3; }
    if (kind==8) { return 3; }
    if (kind==9) { return 9; }
    if (kind==10) { return 3; }
    if (kind==11) { if (shape==1) { return 2; } return 3; }
    if (kind==12) { return 3; }
    if (kind==13) { return 3; }
    if (kind==14) { return 3; }
    if (kind==15) { return 3; }
    if (kind==16) { return 2; }
    if (kind==17) { return 3; }
    if (kind==18) { return 10; }
    if (kind==19) { return 10; }
    if (kind==20) { return 10; }
    if (kind==21) { return 10; }
    return 3;
}
// policy_why: the derived reason printed on every INTAKE choice line.
fn policy_why(kind:i64, shape:i64, w:i64, wb:[]u8, scr:[]u8) []u8 {
    let a:i64=0;
    if (kind==0) {
        a=ob_raw(wb,a,"question unclassified by the parser (kind 0); default deliberative magnifier | ");
        a=ob_raw(wb,a,cand_why(3,kind));
        return wb[0..a];
    }
    if (kind==1) {
        if (shape==0) {
            a=ob_raw(wb,a,"derived WORD>CHAR (class LETTER_COUNT/single): 7 examples correct=7 native=7 ops_total=64 | ");
            a=ob_raw(wb,a,cand_why(3,1));
            return wb[0..a];
        }
    }
    if (kind==1) {
        if (shape==1) {
            a=ob_raw(wb,a,"derived CHAR (class LETTER_COUNT/multi): 3 examples correct=3 native=3 ops_total=47 | ");
            a=ob_raw(wb,a,cand_why(1,1));
            return wb[0..a];
        }
    }
    if (kind==2) {
        if (shape==0) {
            a=ob_raw(wb,a,"derived WORD>CHAR (class POSITION/single): 4 examples correct=4 native=4 ops_total=15 | ");
            a=ob_raw(wb,a,cand_why(3,2));
            return wb[0..a];
        }
    }
    if (kind==2) {
        if (shape==1) {
            a=ob_raw(wb,a,"derived WORD>CHAR (class POSITION/multi): 2 examples correct=2 native=2 ops_total=10 | ");
            a=ob_raw(wb,a,cand_why(3,2));
            return wb[0..a];
        }
    }
    if (kind==3) {
        if (shape==0) {
            a=ob_raw(wb,a,"derived WORD>CHAR (class REVERSE/single): 2 examples correct=2 native=2 ops_total=13 | ");
            a=ob_raw(wb,a,cand_why(3,3));
            return wb[0..a];
        }
    }
    if (kind==3) {
        if (shape==1) {
            a=ob_raw(wb,a,"derived WORD>CHAR (class REVERSE/multi): 1 examples correct=1 native=1 ops_total=16 | ");


// ============ TNN-driven granularity addressing (2026-09-26, stage C1) ============
// gran_named: index of the granularity binding whose singular name occurs in
// q, or -1. The NAMES come from the registry; the machinery only matches.
fn gran_named(q:[]u8, know:[]u8) i64 {
    let gi:i64=0;
    while (gi<know_gran_n(know)) {
        if (has_sub(q,gran_name(know,gi))==1) { return gi; }
        gi=gi+1;
    }
    return -1;
}
// gran_split: split t on the delimiter byte into trimmed non-empty segments.
// Leading spaces trimmed; empty segments dropped. Returns segment count.
// Delimiter comes from the registry binding; never a literal here.
fn gran_split(t:[]u8, delim:u8, offs:[]u8, lens:[]u8) i64 {
    let n:i64=0; let i:i64=0; let L:i64=t.len; let s:i64=0;
    while (i<=L) {
        let isend:i64=0;
        if (i>=L) { isend=1; }
        else { let dd:i64=delim as i64; let d:i64=t[i] as i64; if (d==dd) { isend=1; } }
        if (isend==1) {
            let a:i64=s; let go:i64=1;
            while (go==1) {
                if (a>=i) { go=0; }
                else { let d2:i64=t[a] as i64; if (d2==32) { a=a+1; } else { go=0; } }
            }
            if (a<i) {
                w_u32le(offs,n*4,a); w_u32le(lens,n*4,i-a); n=n+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    return n;
}
// count_sub: non-overlapping occurrences of n in h.
fn count_sub(h:[]u8, n:[]u8) i64 {
    let c:i64=0; let s:i64=0;
    while (s+n.len<=h.len) {
        let ok:i64=1; let k:i64=0;
        while (k<n.len) { if (h[s+k]!=n[k]) { ok=0; } k=k+1; }
        if (ok==1) { c=c+1; s=s+n.len; }
        else { s=s+1; }
    }
    return c;
}
// parse_ord_before_name: the ordinal word immediately preceding the named
// granularity in q ("the 2nd word of the 1st sentence of ...": the "1st"
// before "sentence"). Registry-driven via parse_ordinal; digit fallback.
fn parse_ord_before_name(q:[]u8, know:[]u8, gi:i64) i64 {
    let sn:[]u8=gran_name(know,gi);
    let np:i64=find_sub(q,sn);
    if (np<0) { return -1; }
    let e:i64=np; let go:i64=1;
    while (go==1) {
        if (e<=0) { go=0; }
        else { let d:i64=q[e-1] as i64; if (d==32) { e=e-1; } else { go=0; } }
    }
    let s:i64=e; go=1;
    while (go==1) {
        if (s<=0) { go=0; }
        else { let d:i64=q[s-1] as i64; if (d==32) { go=0; } else { s=s-1; } }
    }
    if (s>=e) { return -1; }
    let r:i64=parse_ordinal(q,s,know);
    if (r>=0) { return r; }
    return parse_digits(q,s);
}

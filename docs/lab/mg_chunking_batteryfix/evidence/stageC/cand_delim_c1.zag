
    // kind 18: "how many <gran-plural> in ..." -> delimiter segment count.
    if (kind==18) {
        let gi:i64=gran_named(q,know);
        let ops:i64=0; let alen:i64=0;
        if (gi<0) { abuf[0]=63; alen=1; }
        else {
            let n:i64=gran_split(t,gran_delim(know,gi),woffs,wlens);
            ops=t.len;
            alen=ob_i64(abuf,0,n,scr);
        }
        let ans:[]u8=abuf[0..alen];
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    // kind 19: "the <ord> <gran> of ..." -> the addressed segment's text.
    if (kind==19) {
        let gi:i64=gran_named(q,know);
        let ops:i64=0; let alen:i64=0;
        let ans:[]u8=abuf[0..0];
        let ok:i64=1;
        if (gi<0) { ok=0; }
        let si:i64=0;
        if (ok==1) {
            let nseg:i64=gran_split(t,gran_delim(know,gi),woffs,wlens);
            ops=t.len;
            let n:i64=parse_pos_n(q,know);
            si=n-1;
            if (si<0) { ok=0; }
            if (si>=nseg) { ok=0; }
        }
        if (ok==1) {
            let so:i64=r_u32le(woffs,si*4); let sl:i64=r_u32le(wlens,si*4);
            ans=t[so..so+sl]; ops=ops+sl;
        }
        else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }
    // kind 20: "the <w> word of the <g> <gran> of ..." -> word w of granule g.
    if (kind==20) {
        let gi:i64=gran_named(q,know);
        let ops:i64=0; let alen:i64=0;
        let ans:[]u8=abuf[0..0];
        let ok:i64=1;
        if (gi<0) { ok=0; }
        let si:i64=0; let wpos:i64=0;
        if (ok==1) {
            let nseg:i64=gran_split(t,gran_delim(know,gi),woffs,wlens);
            ops=t.len;
            let g:i64=parse_ord_before_name(q,know,gi);
            wpos=parse_pos_n(q,know);
            si=g-1;
            if (g<1) { ok=0; }
            if (si>=nseg) { ok=0; }
        }
        let wo:i64=0; let wl:i64=0;
        let sg:[]u8=t[0..0];
        if (ok==1) {
            let so:i64=r_u32le(woffs,si*4); let sl:i64=r_u32le(wlens,si*4);
            sg=t[so..so+sl];
            let nw2:i64=enum_words(sg,woffs,wlens);
            ops=ops+sl;
            if (wpos<1) { ok=0; }
            if (wpos>nw2) { ok=0; }
            if (ok==1) { wo=r_u32le(woffs,(wpos-1)*4); wl=r_u32le(wlens,(wpos-1)*4); }
        }
        if (ok==1) { ans=sg[wo..wo+wl]; ops=ops+wl; }
        else { abuf[0]=63; alen=1; ans=abuf[0..alen]; }
        let correct:i64=beq(ans,exp);
        emit_cand(tag,qid,kind,cand_name(winner),why,ans,exp,correct,1,0,ops,0,0,out,atp,scr);
        return pack_stats(correct,1,0,ops,0,0);
    }

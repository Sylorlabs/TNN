// gov_qc.zag — Question (c): consumed-citation re-cite.
// Variant B (silent): CITE121=0 with strength_core.zag — re-cite silently OK.
// Variant A (immediate 121): CITE121=1 with strength_core_cite121.zag.
// Deterministic; zero RNG. Prints PASS/FAIL + GOVQC_DONE fails=N.
@import("strength_core.zag")

const CITE121:i32=0;

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn mk(s:*StStore,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,str,-1,&sl);
    if(rc!=ST_OK){_zag_print("FATAL add\n");}
    return sl;
}
fn cite(s:*StStore,sl:i32,ep:i64)i32 {return st_evidence(s,sl,4,ep);}
fn delib(s:*StStore,sl:i32,oprice:*i32)i32 {return st_deliberate(s,sl,oprice);}
fn just(s:*StStore,sl:i32)i32 {return st_justify(s,sl,4);}
fn kill(s:*StStore,sl:i32)i32 {return st_kill_evidenced(s,sl);}
fn exp_cite_rc()i32 {if(CITE121==1){return 121;}return ST_OK;}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
// ---- checker side (read-only) ----
fn pay_has_ep(s:*StStore,dslot:i32,d:i32,ep:i64)i32 {
    let plo:i32=st_pay_lo(s,dslot,d);
    let i:i32=plo+1;
    while(i<d){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==dslot && st_aw(s,i,4)==ST_OK){
            if(st_ep64(s,i)==ep){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn is_priced_destroy(op:i32)i32 {
    if(op==ST_OP_KILL){return 1;}
    if(op==ST_OP_KILL_EVIDENCED){return 1;}
    if(op==ST_OP_OVERWRITE){return 1;}
    if(op==ST_OP_DELETE_STRONG){return 1;}
    return 0;
}
fn audit_double_spends(s:*StStore)i32 {
    let bad:i32=0;
    let n:i32=s.*.audit_n;
    let d1:i32=0;
    while(d1<n){
        if(is_priced_destroy(st_aw(s,d1,0))==1 && st_aw(s,d1,4)==ST_OK){
            let s1:i32=st_aw(s,d1,1);
            let lss1:i32=st_last_strength_idx(s,s1,d1);
            let i:i32=lss1+1;
            while(i<d1){
                if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==s1 && st_aw(s,i,4)==ST_OK){
                    let ep:i64=st_ep64(s,i);
                    if(st_cite_consumed(s,s1,ep,lss1,d1)==0){
                        let d2:i32=d1+1;
                        while(d2<n){
                            if(is_priced_destroy(st_aw(s,d2,0))==1 && st_aw(s,d2,4)==ST_OK){
                                let s2:i32=st_aw(s,d2,1);
                                let lss2:i32=st_last_strength_idx(s,s2,d2);
                                if(pay_has_ep(s,s2,d2,ep)==1 && st_cite_consumed(s,s2,ep,lss2,d2)==0){bad=bad+1;}
                            }
                            d2=d2+1;
                        }
                    }
                }
                i=i+1;
            }
        }
        d1=d1+1;
    }
    return bad;
}
// C2: independently recompute the cite-time decision for the last EVIDENCE
// on slot; returns 1 if ledger recompute agrees with the recorded rc.
fn c2_check(s:*StStore,sl:i32,fails:i32)i32 {
    let wn:i32=s.*.audit_n;
    let di:i32=-1;
    let i:i32=0;
    while(i<wn){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==sl){di=i;}
        i=i+1;
    }
    if(di<0){_zag_print("FAIL c2 no-evidence\n");return fails+1;}
    let ep:i64=st_ep64(s,di);
    let rc:i32=st_aw(s,di,4);
    let consumed:i32=st_cite_consumed(s,sl,ep,0,di);
    let expect:i32=ST_OK;
    if(CITE121==1 && consumed==1){expect=121;}
    if(rc==expect){_zag_print("PASS c2_agree ep=");_zag_print(i64s(ep));_zag_print("\n");return fails;}
    _zag_print("FAIL c2_agree ep=");_zag_print(i64s(ep));
    _zag_print(" rc=");_zag_print(i64s(rc as i64));
    _zag_print(" expect=");_zag_print(i64s(expect as i64));_zag_print("\n");
    return fails+1;
}

fn c_honest_exact()void {
    let fails:i32=0;
    // Exact frozen spec: slot 1 at strength 60. EXPECTED PROTOCOL DEFECT:
    // meter price for fresh strength 60 is 0, so a spent re-cite cannot
    // produce a late 121 (fresh=0,spent=1,need=0 -> destruction SUCCEEDS).
    let s:StStore=new_store();
    let s0:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck("cx_s0_delib",delib(&s,s0,&p),ST_OK,fails);
    fails=ck("cx_s0_price",p,1,fails);
    fails=ck("cx_s0_cite",cite(&s,s0,8001),ST_OK,fails);
    fails=ck("cx_s0_just",just(&s,s0),ST_OK,fails);
    fails=ck("cx_s0_kill",kill(&s,s0),ST_OK,fails);
    // occupy the dead slot so s1 lands on a fresh slot (high-water is
    // slot-scoped; without this s1 would inherit s0's hw=80 -> price 1)
    let dummy:i32=mk(&s,10);
    let s1:i32=mk(&s,60);
    // cite BEFORE deliberate: the cite-full gate is skipped with no bound
    // record, so the re-cite reaches the consumed check (var A) / silent 0 (var B)
    fails=ck("cx_s1_recite",cite(&s,s1,8001),exp_cite_rc(),fails);
    fails=c2_check(&s,s1,fails);
    fails=ck("cx_s1_delib",delib(&s,s1,&p),ST_OK,fails);
    fails=ck("cx_s1_price",p,0,fails);
    fails=ck("cx_s1_just",just(&s,s1),ST_OK,fails);
    fails=ck("cx_s1_kill",kill(&s,s1),ST_OK,fails);
    _zag_print("INFO cx: prereg expected silent->late-121; mechanism gives kill=0 (price-0 defect)\n");
    fails=ck("cx_no_double_spend",audit_double_spends(&s),0,fails);
    _zag_print("GOVQCX_DONE fails=");
    _zag_print(i64s(fails as i64));_zag_print("\n");
}

fn c_honest_corrected()void {
    let fails:i32=0;
    let wasted:i32=0;
    // Corrected diagnostic at strength 80 / price 1 (the intended late-121 regime).
    let t:StStore=new_store();
    let t0:i32=mk(&t,80);
    let p:i32=-1;
    fails=ck("cc_t0_delib",delib(&t,t0,&p),ST_OK,fails);
    fails=ck("cc_t0_cite",cite(&t,t0,8101),ST_OK,fails);
    fails=ck("cc_t0_just",just(&t,t0),ST_OK,fails);
    fails=ck("cc_t0_kill",kill(&t,t0),ST_OK,fails);
    let t1:i32=mk(&t,80);
    fails=ck("cc_t1_delib",delib(&t,t1,&p),ST_OK,fails);
    fails=ck("cc_t1_price",p,1,fails);
    fails=ck("cc_t1_recite",cite(&t,t1,8101),exp_cite_rc(),fails);
    wasted=wasted+1;
    fails=c2_check(&t,t1,fails);
    fails=ck("cc_t1_just",just(&t,t1),ST_OK,fails);
    wasted=wasted+1;
    if(CITE121==0){
        // silent: TNN only learns at destruction time
        fails=ck("cc_t1_kill_late121",kill(&t,t1),121,fails);
        wasted=wasted+1;
        fails=ck("cc_t1_citeF2",cite(&t,t1,8102),ST_OK,fails);
        fails=ck("cc_t1_just2",just(&t,t1),ST_OK,fails);
        fails=ck("cc_t1_kill2",kill(&t,t1),ST_OK,fails);
    }else{
        // immediate: TNN learns at cite time; cite F2 directly
        fails=ck("cc_t1_citeF2",cite(&t,t1,8102),ST_OK,fails);
        fails=ck("cc_t1_just2",just(&t,t1),ST_OK,fails);
        fails=ck("cc_t1_kill2",kill(&t,t1),ST_OK,fails);
    }
    fails=ck("cc_no_double_spend",audit_double_spends(&t),0,fails);
    _zag_print("INFO cc wasted_ops_before_learn=");
    _zag_print(i64s(wasted as i64));_zag_print("\n");
    _zag_print("GOVQCC_DONE fails=");
    _zag_print(i64s(fails as i64));_zag_print("\n");
}
// ---- C1 red team: 20 double-spend attacks per variant ----
fn catk_cross(ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let a:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck(name,delib(&s,a,&p),ST_OK,fails);
    fails=ck(name,cite(&s,a,ep),ST_OK,fails);
    fails=ck(name,just(&s,a),ST_OK,fails);
    fails=ck(name,kill(&s,a),ST_OK,fails);
    let b:i32=mk(&s,80);
    fails=ck(name,delib(&s,b,&p),ST_OK,fails);
    fails=ck(name,cite(&s,b,ep),exp_cite_rc(),fails);
    fails=ck(name,just(&s,b),ST_OK,fails);
    let krc:i32=kill(&s,b);
    if(CITE121==0){fails=ck(name,krc,121,fails);}else{fails=ck(name,krc,109,fails);}
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn catk_overwrite(ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let a:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck(name,delib(&s,a,&p),ST_OK,fails);
    fails=ck(name,cite(&s,a,ep),ST_OK,fails);
    fails=ck(name,just(&s,a),ST_OK,fails);
    fails=ck(name,kill(&s,a),ST_OK,fails);
    let b:i32=mk(&s,80);
    fails=ck(name,delib(&s,b,&p),ST_OK,fails);
    fails=ck(name,cite(&s,b,ep),exp_cite_rc(),fails);
    fails=ck(name,just(&s,b),ST_OK,fails);
    if(CITE121==1){fails=ck(name,st_overwrite(&s,b,71,20,ep+5000),109,fails);}
    else{fails=ck(name,st_overwrite(&s,b,71,20,ep+5000),121,fails);}
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn catk_delete(ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let a:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck(name,delib(&s,a,&p),ST_OK,fails);
    fails=ck(name,cite(&s,a,ep),ST_OK,fails);
    fails=ck(name,just(&s,a),ST_OK,fails);
    fails=ck(name,kill(&s,a),ST_OK,fails);
    let b:i32=mk(&s,80);
    fails=ck(name,delib(&s,b,&p),ST_OK,fails);
    fails=ck(name,cite(&s,b,ep),exp_cite_rc(),fails);
    fails=ck(name,just(&s,b),ST_OK,fails);
    if(CITE121==1){fails=ck(name,st_delete_strong(&s,b),109,fails);}
    else{fails=ck(name,st_delete_strong(&s,b),121,fails);}
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn catk_sameslot_rb(ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    // same slot, same epoch: variant A -> 121 (tombstone first);
    // variant B -> 111 (epoch-scoped dup check; no consumed check)
    if(CITE121==1){fails=ck(name,cite(&s,m,ep),121,fails);}
    else{fails=ck(name,cite(&s,m,ep),111,fails);}
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}

fn c_redteam()void {
    let fails:i32=0;
    let attacks:i32=0;
    fails=catk_cross(8201,"catkX1",fails);attacks=attacks+1;
    fails=catk_cross(8202,"catkX2",fails);attacks=attacks+1;
    fails=catk_cross(8203,"catkX3",fails);attacks=attacks+1;
    fails=catk_cross(8204,"catkX4",fails);attacks=attacks+1;
    fails=catk_cross(8205,"catkX5",fails);attacks=attacks+1;
    fails=catk_cross(8206,"catkX6",fails);attacks=attacks+1;
    fails=catk_cross(8207,"catkX7",fails);attacks=attacks+1;
    fails=catk_cross(8208,"catkX8",fails);attacks=attacks+1;
    fails=catk_overwrite(8211,"catkO1",fails);attacks=attacks+1;
    fails=catk_overwrite(8212,"catkO2",fails);attacks=attacks+1;
    fails=catk_overwrite(8213,"catkO3",fails);attacks=attacks+1;
    fails=catk_overwrite(8214,"catkO4",fails);attacks=attacks+1;
    fails=catk_delete(8221,"catkD1",fails);attacks=attacks+1;
    fails=catk_delete(8222,"catkD2",fails);attacks=attacks+1;
    fails=catk_delete(8223,"catkD3",fails);attacks=attacks+1;
    fails=catk_delete(8224,"catkD4",fails);attacks=attacks+1;
    fails=catk_sameslot_rb(8231,"catkS1",fails);attacks=attacks+1;
    fails=catk_sameslot_rb(8232,"catkS2",fails);attacks=attacks+1;
    fails=catk_sameslot_rb(8233,"catkS3",fails);attacks=attacks+1;
    fails=catk_sameslot_rb(8234,"catkS4",fails);attacks=attacks+1;
    fails=ck("c1_attacks_20",attacks,20,fails);
    _zag_print("INFO c1 redteam done attacks=");
    _zag_print(i64s(attacks as i64));_zag_print("\n");
    _zag_print("GOVQC1_DONE fails=");
    _zag_print(i64s(fails as i64));_zag_print("\n");
}

// ---- C4: does the cite-time oracle give a cheap consumption probe? ----
fn c4_probe()void {
    let fails:i32=0;
    let s:StStore=new_store();
    let v:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck("c4_delib",delib(&s,v,&p),ST_OK,fails);
    fails=ck("c4_cite",cite(&s,v,8301),ST_OK,fails);
    fails=ck("c4_just",just(&s,v),ST_OK,fails);
    fails=ck("c4_kill",kill(&s,v),ST_OK,fails);
    // attacker probes: 8301 was consumed, 8302 never used
    let a:i32=mk(&s,80);
    let r_used:i32=cite(&s,a,8301);
    let r_fresh:i32=cite(&s,a,8302);
    _zag_print("INFO c4 probe consumed_ep_rc=");
    _zag_print(i64s(r_used as i64));_zag_print(" fresh_ep_rc=");
    _zag_print(i64s(r_fresh as i64));_zag_print("\n");
    // the same distinction is derivable from the public ledger
    let wn:i32=s.audit_n;
    let ledger_used:i32=st_cite_consumed(&s,a,8301,0,wn);
    let ledger_fresh:i32=st_cite_consumed(&s,a,8302,0,wn);
    fails=ck("c4_ledger_used",ledger_used,1,fails);
    fails=ck("c4_ledger_fresh",ledger_fresh,0,fails);
    if(CITE121==1){
        fails=ck("c4_oracle_matches_ledger_used",r_used,121,fails);
        fails=ck("c4_oracle_matches_ledger_fresh",r_fresh,ST_OK,fails);
        _zag_print("INFO c4: variant A exposes a cheap consumption oracle; signal equals ledger-derivable st_cite_consumed\n");
    }else{
        fails=ck("c4_silent_used",r_used,ST_OK,fails);
        fails=ck("c4_silent_fresh",r_fresh,ST_OK,fails);
        _zag_print("INFO c4: variant B exposes no cite-time signal\n");
    }
    _zag_print("GOVQC4_DONE fails=");
    _zag_print(i64s(fails as i64));_zag_print("\n");
}

fn main()void {
    c_honest_exact();
    c_honest_corrected();
    c_redteam();
    c4_probe();
}

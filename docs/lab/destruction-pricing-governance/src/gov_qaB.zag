// gov_qa.zag — Question (a): price(0)=0 floor.
// Floor A: FLOOR_MIN=0 with strength_core.zag (price 0 allowed as computed).
// Floor B copy: FLOOR_MIN=1 with strength_core_floorB.zag (sed-generated).
// Deterministic; zero RNG. Prints PASS/FAIL lines + GOVQA_DONE fails=N.
@import("strength_core_floorB.zag")

const FLOOR_MIN:i32=1;

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn mk(s:*StStore,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,str,-1,&sl);
    if(rc!=ST_OK){_zag_print("FATAL add\n");}
    return sl;
}
fn cite(s:*StStore,sl:i32,ep:i64)i32 {return st_evidence(s,sl,4,ep);}
fn delib(s:*StStore,sl:i32,oprice:*i32)i32 {return st_deliberate(s,sl,oprice);}
fn just(s:*StStore,sl:i32)i32 {return st_justify(s,sl,4);}
fn destroy(s:*StStore,sl:i32)i32 {return st_delete_strong(s,sl);}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
// expected price under this floor for a natural (Floor-A) meter price
fn expa(nat:i32)i32 {if(nat<FLOOR_MIN){return FLOOR_MIN;}return nat;}

// ---- checker side (read-only) ----
fn pay_has_ep(s:*StStore,dslot:i32,d:i32,ep:i64)i32 {
    let plo:i32=st_pay_lo(s,dslot,d);
    let i:i32=plo+1;
    while(i<d){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==dslot && st_aw(s,i,4)==ST_OK){
            if(st_ep64(s,i)==ep){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn is_priced_destroy(op:i32)i32 {
    if(op==ST_OP_KILL){return 1;}
    if(op==ST_OP_KILL_EVIDENCED){return 1;}
    if(op==ST_OP_OVERWRITE){return 1;}
    if(op==ST_OP_DELETE_STRONG){return 1;}
    return 0;
}
// counts episodes that FUNDED 2+ OK priced destructions (fresh at fund time)
fn audit_double_spends(s:*StStore)i32 {
    let bad:i32=0;
    let n:i32=s.*.audit_n;
    let d1:i32=0;
    while(d1<n){
        if(is_priced_destroy(st_aw(s,d1,0))==1 && st_aw(s,d1,4)==ST_OK){
            let s1:i32=st_aw(s,d1,1);
            let lss1:i32=st_last_strength_idx(s,s1,d1);
            let i:i32=lss1+1;
            while(i<d1){
                if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==s1 && st_aw(s,i,4)==ST_OK){
                    let ep:i64=st_ep64(s,i);
                    if(st_cite_consumed(s,s1,ep,lss1,d1)==0){
                        let d2:i32=d1+1;
                        while(d2<n){
                            if(is_priced_destroy(st_aw(s,d2,0))==1 && st_aw(s,d2,4)==ST_OK){
                                let s2:i32=st_aw(s,d2,1);
                                let lss2:i32=st_last_strength_idx(s,s2,d2);
                                if(pay_has_ep(s,s2,d2,ep)==1 && st_cite_consumed(s,s2,ep,lss2,d2)==0){bad=bad+1;}
                            }
                            d2=d2+1;
                        }
                    }
                }
                i=i+1;
            }
        }
        d1=d1+1;
    }
    return bad;
}
// verify the bound DELIBERATE record matches an independent meter recompute
fn check_delib_record(s:*StStore,sl:i32,wp:i32,wr1:i32,wr2:i32,wr3:i32,wr4:i32,name:[]u8,fails:i32)i32 {
    let n:i32=s.*.audit_n;
    let di:i32=-1;
    let i:i32=0;
    while(i<n){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    if(di<0){_zag_print("FAIL ");_zag_print(name);_zag_print(" no-deliberate\n");return fails+1;}
    let op:i32=0;let r1:i32=0;let r2:i32=0;let r3:i32=0;let r4:i32=0;
    let rc:i32=st_meter_compute_at(s,sl,di,&op,&r1,&r2,&r3,&r4);
    fails=ck(name,rc,ST_OK,fails);
    fails=ck(name,op,wp,fails);
    fails=ck(name,r1,wr1,fails);fails=ck(name,r2,wr2,fails);fails=ck(name,r3,wr3,fails);fails=ck(name,r4,wr4,fails);
    fails=ck(name,st_aw(s,di,2),wp,fails);
    let pk:i32=r1|(r2<<8)|(r3<<16)|(r4<<24);
    fails=ck(name,st_aw(s,di,13),pk,fails);
    return fails;
}
fn pool_ep(i:i32)i64 {
    if(i==0){return 2001;}
    if(i==1){return 2002;}
    if(i==2){return 2003;}
    if(i==3){return 2004;}
    return -1;
}
// cite `need` fresh episodes starting at base
fn fund(s:*StStore,sl:i32,need:i32,base:i64,fails:i32)i32 {
    let c:i32=0;
    while(c<need){
        fails=ck("fund_cite",cite(s,sl,base+(c as i64)),ST_OK,fails);
        c=c+1;
    }
    return fails;
}
// scarce driver: deliberate -> cite from shared pool -> destroy, else abandon
fn scarce_one(s:*StStore,sl:i32,pu:*i32,pd:*i32,pa:*i32,name:[]u8,fails:i32)i32 {
    let pr:i32=-1;
    fails=ck(name,delib(s,sl,&pr),ST_OK,fails);
    let c:i32=0;
    while(c<pr){
        let ep:i64=pool_ep(pu.*);
        if(ep<0){break;}
        if(cite(s,sl,ep)!=ST_OK){break;}
        pu.*=pu.*+1;
        c=c+1;
    }
    fails=ck(name,just(s,sl),ST_OK,fails);
    if(destroy(s,sl)==ST_OK){pd.*=pd.*+1;}
    else{
        if(st_abandon(s,sl,2)==ST_OK){pa.*=pa.*+1;}else{fails=fails+1;}
    }
    return fails;
}

fn main()void {
    let fails:i32=0;
    // ============ A-honest archetype price checks ============
    // A1: weak fresh -> natural 0
    let s1:StStore=new_store();
    let a1:i32=mk(&s1,10);
    let p:i32=-1;
    fails=ck("a1_delib_rc",delib(&s1,a1,&p),ST_OK,fails);
    fails=ck("a1_price",p,expa(0),fails);
    let a1cite_want:i32=122;
    if(FLOOR_MIN==1){a1cite_want=ST_OK;}
    fails=ck("a1_cite",cite(&s1,a1,1001),a1cite_want,fails);
    fails=ck("a1_justify",just(&s1,a1),ST_OK,fails);
    fails=ck("a1_destroy",destroy(&s1,a1),ST_OK,fails);
    fails=check_delib_record(&s1,a1,expa(0),23,26,28,30,"a1_record",fails);
    // A2: mid fresh -> natural 0
    let s2:StStore=new_store();
    let a2:i32=mk(&s2,50);
    fails=ck("a2_delib_rc",delib(&s2,a2,&p),ST_OK,fails);
    fails=ck("a2_price",p,expa(0),fails);
    if(FLOOR_MIN==1){fails=ck("a2_cite",cite(&s2,a2,1002),ST_OK,fails);}
    fails=ck("a2_justify",just(&s2,a2),ST_OK,fails);
    fails=ck("a2_destroy",destroy(&s2,a2),ST_OK,fails);
    // A3: strong fresh -> 1
    let s3:StStore=new_store();
    let a3:i32=mk(&s3,80);
    fails=ck("a3_delib_rc",delib(&s3,a3,&p),ST_OK,fails);
    fails=ck("a3_price",p,1,fails);
    fails=ck("a3_cite",cite(&s3,a3,1002),ST_OK,fails);
    fails=ck("a3_cite_over",cite(&s3,a3,1003),122,fails);
    fails=ck("a3_justify",just(&s3,a3),ST_OK,fails);
    fails=ck("a3_destroy",destroy(&s3,a3),ST_OK,fails);
    fails=check_delib_record(&s3,a3,1,21,26,28,30,"a3_record",fails);
    // A4: strong seasoned -> 4 (hw85 +1, sunk3 +1, fought +1, revs0 -1)
    let s4:StStore=new_store();
    let a4:i32=mk(&s4,85);
    fails=ck("a4_c1",cite(&s4,a4,1011),ST_OK,fails);
    fails=ck("a4_c2",cite(&s4,a4,1012),ST_OK,fails);
    fails=ck("a4_c3",cite(&s4,a4,1013),ST_OK,fails);
    fails=ck("a4_weaken",st_weaken(&s4,a4,60,4),ST_OK,fails);
    fails=ck("a4_delib_rc",delib(&s4,a4,&p),ST_OK,fails);
    fails=ck("a4_price",p,4,fails);
    fails=ck("a4_c4",cite(&s4,a4,1014),ST_OK,fails);
    fails=ck("a4_c5",cite(&s4,a4,1015),ST_OK,fails);
    fails=ck("a4_c6",cite(&s4,a4,1016),ST_OK,fails);
    fails=ck("a4_c7",cite(&s4,a4,1017),ST_OK,fails);
    fails=ck("a4_c8_over",cite(&s4,a4,1018),122,fails);
    fails=ck("a4_justify",just(&s4,a4),ST_OK,fails);
    fails=ck("a4_destroy",destroy(&s4,a4),ST_OK,fails);
    // A5: revised weak -> natural 2 (fund overwrite first: price 1)
    let s5:StStore=new_store();
    let a5:i32=mk(&s5,90);
    fails=ck("a5_delib1",delib(&s5,a5,&p),ST_OK,fails);
    fails=ck("a5_price1",p,1,fails);
    fails=ck("a5_cite_fund",cite(&s5,a5,1021),ST_OK,fails);
    fails=ck("a5_justify1",just(&s5,a5),ST_OK,fails);
    fails=ck("a5_overwrite",st_overwrite(&s5,a5,71,20,1031),ST_OK,fails);
    fails=ck("a5_delib2",delib(&s5,a5,&p),ST_OK,fails);
    fails=ck("a5_price2",p,2,fails);
    fails=ck("a5_cite2a",cite(&s5,a5,1022),ST_OK,fails);
    fails=ck("a5_cite2b",cite(&s5,a5,1023),ST_OK,fails);
    fails=ck("a5_justify2",just(&s5,a5),ST_OK,fails);
    fails=ck("a5_destroy",destroy(&s5,a5),ST_OK,fails);
    // A6: abandon (audited, free) under both floors
    let s6:StStore=new_store();
    let a6:i32=mk(&s6,15);
    fails=ck("a6_abandon",st_abandon(&s6,a6,1),ST_OK,fails);
    _zag_print("INFO honest-archetypes done\n");
    // ============ standard battery: 12 memories, isolated stores ============
    let resolved:i32=0;
    let dsbad:i32=0;
    let b1:StStore=new_store();
    let m1:i32=mk(&b1,10);
    fails=ck("sb_m1d",delib(&b1,m1,&p),ST_OK,fails);
    fails=ck("sb_m1p",p,expa(0),fails);
    fails=fund(&b1,m1,p,5001,fails);
    fails=ck("sb_m1j",just(&b1,m1),ST_OK,fails);
    if(destroy(&b1,m1)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b1);
    let b2:StStore=new_store();
    let m2:i32=mk(&b2,12);
    fails=ck("sb_m2d",delib(&b2,m2,&p),ST_OK,fails);
    fails=ck("sb_m2p",p,expa(0),fails);
    fails=fund(&b2,m2,p,5011,fails);
    fails=ck("sb_m2j",just(&b2,m2),ST_OK,fails);
    if(destroy(&b2,m2)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b2);
    let b3:StStore=new_store();
    let m3:i32=mk(&b3,50);
    fails=ck("sb_m3d",delib(&b3,m3,&p),ST_OK,fails);
    fails=ck("sb_m3p",p,expa(0),fails);
    fails=fund(&b3,m3,p,5021,fails);
    fails=ck("sb_m3j",just(&b3,m3),ST_OK,fails);
    if(destroy(&b3,m3)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b3);
    let b4:StStore=new_store();
    let m4:i32=mk(&b4,45);
    fails=ck("sb_m4d",delib(&b4,m4,&p),ST_OK,fails);
    fails=ck("sb_m4p",p,expa(0),fails);
    fails=fund(&b4,m4,p,5031,fails);
    fails=ck("sb_m4j",just(&b4,m4),ST_OK,fails);
    if(destroy(&b4,m4)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b4);
    let b5:StStore=new_store();
    let m5:i32=mk(&b5,80);
    fails=ck("sb_m5d",delib(&b5,m5,&p),ST_OK,fails);
    fails=ck("sb_m5p",p,1,fails);
    fails=fund(&b5,m5,p,5041,fails);
    fails=ck("sb_m5j",just(&b5,m5),ST_OK,fails);
    if(destroy(&b5,m5)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b5);
    let b6:StStore=new_store();
    let m6:i32=mk(&b6,82);
    fails=ck("sb_m6d",delib(&b6,m6,&p),ST_OK,fails);
    fails=ck("sb_m6p",p,1,fails);
    fails=fund(&b6,m6,p,5051,fails);
    fails=ck("sb_m6j",just(&b6,m6),ST_OK,fails);
    if(destroy(&b6,m6)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b6);
    let b7:StStore=new_store();
    let m7:i32=mk(&b7,85);
    fails=fund(&b7,m7,3,5701,fails);
    fails=ck("sb_m7w",st_weaken(&b7,m7,60,4),ST_OK,fails);
    fails=ck("sb_m7d",delib(&b7,m7,&p),ST_OK,fails);
    fails=ck("sb_m7p",p,4,fails);
    fails=fund(&b7,m7,p,5711,fails);
    fails=ck("sb_m7j",just(&b7,m7),ST_OK,fails);
    if(destroy(&b7,m7)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b7);
    let b8:StStore=new_store();
    let m8:i32=mk(&b8,88);
    fails=fund(&b8,m8,1,5721,fails);
    fails=ck("sb_m8w",st_weaken(&b8,m8,70,4),ST_OK,fails);
    fails=ck("sb_m8d",delib(&b8,m8,&p),ST_OK,fails);
    fails=ck("sb_m8p",p,3,fails);
    fails=fund(&b8,m8,p,5731,fails);
    fails=ck("sb_m8j",just(&b8,m8),ST_OK,fails);
    if(destroy(&b8,m8)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b8);
    let b9:StStore=new_store();
    let m9:i32=mk(&b9,90);
    fails=ck("sb_m9d",delib(&b9,m9,&p),ST_OK,fails);
    fails=ck("sb_m9p",p,1,fails);
    fails=fund(&b9,m9,p,5901,fails);
    fails=ck("sb_m9j",just(&b9,m9),ST_OK,fails);
    fails=ck("sb_m9o",st_overwrite(&b9,m9,72,20,5951),ST_OK,fails);
    fails=ck("sb_m9d2",delib(&b9,m9,&p),ST_OK,fails);
    fails=ck("sb_m9p2",p,2,fails);
    fails=fund(&b9,m9,p,5961,fails);
    fails=ck("sb_m9j2",just(&b9,m9),ST_OK,fails);
    if(destroy(&b9,m9)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b9);
    let b10:StStore=new_store();
    let m10:i32=mk(&b10,92);
    fails=ck("sb_m10d",delib(&b10,m10,&p),ST_OK,fails);
    fails=ck("sb_m10p",p,1,fails);
    fails=fund(&b10,m10,p,5971,fails);
    fails=ck("sb_m10j",just(&b10,m10),ST_OK,fails);
    fails=ck("sb_m10o",st_overwrite(&b10,m10,73,25,5981),ST_OK,fails);
    fails=ck("sb_m10d2",delib(&b10,m10,&p),ST_OK,fails);
    fails=ck("sb_m10p2",p,2,fails);
    fails=fund(&b10,m10,p,5991,fails);
    fails=ck("sb_m10j2",just(&b10,m10),ST_OK,fails);
    if(destroy(&b10,m10)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b10);
    let b11:StStore=new_store();
    let m11:i32=mk(&b11,15);
    if(st_abandon(&b11,m11,1)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b11);
    let b12:StStore=new_store();
    let m12:i32=mk(&b12,18);
    if(st_abandon(&b12,m12,1)==ST_OK){resolved=resolved+1;}else{fails=fails+1;}
    dsbad=dsbad+audit_double_spends(&b12);
    fails=ck("sb_resolved_12",resolved,12,fails);
    fails=ck("sb_no_double_spend",dsbad,0,fails);
    _zag_print("INFO standard-battery done resolved=");
    _zag_print(i64s(resolved as i64));_zag_print("\n");
    // ============ scarce-cite scenario: 4-episode pool, 6 isolated memories ============
    let pool_used:i32=0;
    let sc_destroyed:i32=0;
    let sc_abandoned:i32=0;
    let scbad:i32=0;
    let c1s:StStore=new_store();
    let sc1:i32=mk(&c1s,80);
    fails=scarce_one(&c1s,sc1,&pool_used,&sc_destroyed,&sc_abandoned,"sc1",fails);
    scbad=scbad+audit_double_spends(&c1s);
    let c2s:StStore=new_store();
    let sc2:i32=mk(&c2s,85);
    fails=ck("sc2_weaken",st_weaken(&c2s,sc2,60,4),ST_OK,fails);
    fails=scarce_one(&c2s,sc2,&pool_used,&sc_destroyed,&sc_abandoned,"sc2",fails);
    scbad=scbad+audit_double_spends(&c2s);
    let c3s:StStore=new_store();
    let sc3:i32=mk(&c3s,10);
    fails=scarce_one(&c3s,sc3,&pool_used,&sc_destroyed,&sc_abandoned,"sc3",fails);
    scbad=scbad+audit_double_spends(&c3s);
    let c4s:StStore=new_store();
    let sc4:i32=mk(&c4s,50);
    fails=scarce_one(&c4s,sc4,&pool_used,&sc_destroyed,&sc_abandoned,"sc4",fails);
    scbad=scbad+audit_double_spends(&c4s);
    let c5s:StStore=new_store();
    let sc5:i32=mk(&c5s,12);
    fails=scarce_one(&c5s,sc5,&pool_used,&sc_destroyed,&sc_abandoned,"sc5",fails);
    scbad=scbad+audit_double_spends(&c5s);
    let c6s:StStore=new_store();
    let sc6:i32=mk(&c6s,45);
    fails=scarce_one(&c6s,sc6,&pool_used,&sc_destroyed,&sc_abandoned,"sc6",fails);
    scbad=scbad+audit_double_spends(&c6s);
    let ed:i32=6;let ea:i32=0;
    if(FLOOR_MIN==1){ed=3;ea=3;}
    fails=ck("sc_destroyed",sc_destroyed,ed,fails);
    fails=ck("sc_abandoned",sc_abandoned,ea,fails);
    fails=ck("sc_no_double_spend",scbad,0,fails);
    _zag_print("INFO scarce done destroyed=");
    _zag_print(i64s(sc_destroyed as i64));_zag_print(" abandoned=");
    _zag_print(i64s(sc_abandoned as i64));_zag_print("\n");
    // ============ cite-lock wedge scenario ============
    let w:StStore=new_store();
    let v:i32=mk(&w,10);
    fails=ck("w_v_cite",cite(&w,v,3001),ST_OK,fails);
    let x:i32=mk(&w,80);
    fails=ck("w_x_cite",cite(&w,x,3001),ST_OK,fails);
    let px:i32=-1;
    fails=ck("w_x_delib",delib(&w,x,&px),ST_OK,fails);
    fails=ck("w_x_price",px,1,fails);
    fails=ck("w_x_just",just(&w,x),ST_OK,fails);
    fails=ck("w_x_kill",st_kill_evidenced(&w,x),ST_OK,fails);
    let pv:i32=-1;
    fails=ck("w_v_delib",delib(&w,v,&pv),ST_OK,fails);

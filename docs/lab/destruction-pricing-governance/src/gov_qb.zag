// gov_qb.zag — Question (b) D-N1: tombstone through KILL -> rollback -> KILL.
// Pristine strength_core.zag. Deterministic; zero RNG.
// Prints PASS/FAIL lines + GOVQB_DONE fails=N.
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn mk(s:*StStore,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,70,ST_REGION_USER,str,-1,&sl);
    if(rc!=ST_OK){_zag_print("FATAL add\n");}
    return sl;
}
fn cite(s:*StStore,sl:i32,ep:i64)i32 {return st_evidence(s,sl,4,ep);}
fn delib(s:*StStore,sl:i32,oprice:*i32)i32 {return st_deliberate(s,sl,oprice);}
fn just(s:*StStore,sl:i32)i32 {return st_justify(s,sl,4);}
fn kill(s:*StStore,sl:i32)i32 {return st_kill_evidenced(s,sl);}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
// ---- checker side (read-only) ----
fn pay_has_ep(s:*StStore,dslot:i32,d:i32,ep:i64)i32 {
    let plo:i32=st_pay_lo(s,dslot,d);
    let i:i32=plo+1;
    while(i<d){
        if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==dslot && st_aw(s,i,4)==ST_OK){
            if(st_ep64(s,i)==ep){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn is_priced_destroy(op:i32)i32 {
    if(op==ST_OP_KILL){return 1;}
    if(op==ST_OP_KILL_EVIDENCED){return 1;}
    if(op==ST_OP_OVERWRITE){return 1;}
    if(op==ST_OP_DELETE_STRONG){return 1;}
    return 0;
}
fn audit_double_spends(s:*StStore)i32 {
    let bad:i32=0;
    let n:i32=s.*.audit_n;
    let d1:i32=0;
    while(d1<n){
        if(is_priced_destroy(st_aw(s,d1,0))==1 && st_aw(s,d1,4)==ST_OK){
            let s1:i32=st_aw(s,d1,1);
            let lss1:i32=st_last_strength_idx(s,s1,d1);
            let i:i32=lss1+1;
            while(i<d1){
                if(st_aw(s,i,0)==ST_OP_EVIDENCE && st_aw(s,i,1)==s1 && st_aw(s,i,4)==ST_OK){
                    let ep:i64=st_ep64(s,i);
                    if(st_cite_consumed(s,s1,ep,lss1,d1)==0){
                        let d2:i32=d1+1;
                        while(d2<n){
                            if(is_priced_destroy(st_aw(s,d2,0))==1 && st_aw(s,d2,4)==ST_OK){
                                let s2:i32=st_aw(s,d2,1);
                                let lss2:i32=st_last_strength_idx(s,s2,d2);
                                if(pay_has_ep(s,s2,d2,ep)==1 && st_cite_consumed(s,s2,ep,lss2,d2)==0){bad=bad+1;}
                            }
                            d2=d2+1;
                        }
                    }
                }
                i=i+1;
            }
        }
        d1=d1+1;
    }
    return bad;
}
fn count_citelock(s:*StStore,sl:i32)i32 {
    let n:i32=0;
    let wn:i32=s.*.audit_n;
    let i:i32=0;
    while(i<wn){
        if(st_aw(s,i,0)==ST_OP_CITELOCK && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){n=n+1;}
        i=i+1;
    }
    return n;
}
fn count_op_rc(s:*StStore,op:i32,want_rc:i32)i32 {
    let n:i32=0;
    let wn:i32=s.*.audit_n;
    let i:i32=0;
    while(i<wn){
        if(st_aw(s,i,0)==op && st_aw(s,i,4)==want_rc){n=n+1;}
        i=i+1;
    }
    return n;
}

fn b_honest()void {
    let fails:i32=0;
    // ============ B-honest: KILL -> rollback -> KILL (same cite) ============
    let s:StStore=new_store();
    let m:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck("b_delib",delib(&s,m,&p),ST_OK,fails);
    fails=ck("b_price",p,1,fails);
    fails=ck("b_cite1",cite(&s,m,7001),ST_OK,fails);
    fails=ck("b_justify",just(&s,m),ST_OK,fails);
    fails=ck("b_kill1",kill(&s,m),ST_OK,fails);
    fails=ck("b_rb1",st_rollback_last(&s),ST_OK,fails);
    fails=ck("b_rb1_record",count_op_rc(&s,ST_OP_ROLLBACK,ST_OK),1,fails);
    // same-citation redestruction: tombstone must hold -> 121
    fails=ck("b_kill2_same",kill(&s,m),121,fails);
    fails=ck("b_citelock",count_citelock(&s,m),1,fails);
    // rollback after the refusal: mechanism rolls back kill1 again (ST_OK).
    // (Prereg guessed 108; the mechanism finds the earlier OK kill.)
    fails=ck("b_rb_after_refusal",st_rollback_last(&s),108,fails);
    // B3: a genuinely fresh citation still works through the bound deliberation
    fails=ck("b_cite2",cite(&s,m,7002),ST_OK,fails);
    fails=ck("b_kill3_fresh",kill(&s,m),ST_OK,fails);
    fails=ck("b_no_double_spend",audit_double_spends(&s),0,fails);
    _zag_print("INFO b-honest done\n");
}
// ---- red-team attacks: each returns updated fails; all expect refusal, no double-spend ----
fn atk_a(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_b(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,st_rollback_last(&s),108,fails);
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_c(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let a:i32=mk(&s,str);
    let b:i32=mk(&s,80);
    let p:i32=-1;
    fails=ck(name,delib(&s,a,&p),ST_OK,fails);
    fails=ck(name,cite(&s,a,ep),ST_OK,fails);
    fails=ck(name,just(&s,a),ST_OK,fails);
    fails=ck(name,kill(&s,a),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,delib(&s,b,&p),ST_OK,fails);
    fails=ck(name,cite(&s,b,ep),ST_OK,fails);
    fails=ck(name,just(&s,b),ST_OK,fails);
    fails=ck(name,kill(&s,b),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_d(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,st_overwrite(&s,m,71,20,ep+1000),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_e(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),111,fails);
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_f(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    // no rollback: dead slot reused by a fresh ADD; the spent cite hits the
    // same-slot dup check (slot-scoped, no generation scoping)
    let m2:i32=mk(&s,80);
    fails=ck(name,cite(&s,m2,ep),ST_OK,fails);
    fails=ck(name,delib(&s,m2,&p),ST_OK,fails);
    fails=ck(name,just(&s,m2),ST_OK,fails);
    fails=ck(name,kill(&s,m2),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_g(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,st_weaken(&s,m,50,4),ST_OK,fails);
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,kill(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}
fn atk_i(str:i32,ep:i64,name:[]u8,fails:i32)i32 {
    let s:StStore=new_store();
    let m:i32=mk(&s,str);
    let p:i32=-1;
    fails=ck(name,delib(&s,m,&p),ST_OK,fails);
    fails=ck(name,cite(&s,m,ep),ST_OK,fails);
    fails=ck(name,just(&s,m),ST_OK,fails);
    fails=ck(name,st_delete_strong(&s,m),ST_OK,fails);
    fails=ck(name,st_rollback_last(&s),ST_OK,fails);
    fails=ck(name,st_delete_strong(&s,m),121,fails);
    fails=ck(name,audit_double_spends(&s),0,fails);
    return fails;
}

fn main()void {
    b_honest();
    let fails:i32=0;
    let attacks:i32=0;
    fails=atk_a(80,7101,"atkA80",fails);attacks=attacks+1;
    fails=atk_a(85,7102,"atkA85",fails);attacks=attacks+1;
    fails=atk_a(90,7103,"atkA90",fails);attacks=attacks+1;
    fails=atk_a(100,7104,"atkA100",fails);attacks=attacks+1;
    fails=atk_b(80,7201,"atkB80",fails);attacks=attacks+1;
    fails=atk_b(85,7202,"atkB85",fails);attacks=attacks+1;
    fails=atk_b(90,7203,"atkB90",fails);attacks=attacks+1;
    fails=atk_b(100,7204,"atkB100",fails);attacks=attacks+1;
    fails=atk_c(80,7301,"atkC80",fails);attacks=attacks+1;
    fails=atk_c(85,7302,"atkC85",fails);attacks=attacks+1;
    fails=atk_c(90,7303,"atkC90",fails);attacks=attacks+1;
    fails=atk_c(100,7304,"atkC100",fails);attacks=attacks+1;
    fails=atk_d(80,7401,"atkD80",fails);attacks=attacks+1;
    fails=atk_d(85,7402,"atkD85",fails);attacks=attacks+1;
    fails=atk_d(90,7403,"atkD90",fails);attacks=attacks+1;
    fails=atk_d(100,7404,"atkD100",fails);attacks=attacks+1;
    fails=atk_e(80,7501,"atkE80",fails);attacks=attacks+1;
    fails=atk_e(85,7502,"atkE85",fails);attacks=attacks+1;
    fails=atk_e(90,7503,"atkE90",fails);attacks=attacks+1;
    fails=atk_e(100,7504,"atkE100",fails);attacks=attacks+1;
    fails=atk_f(80,7601,"atkF80",fails);attacks=attacks+1;
    fails=atk_f(85,7602,"atkF85",fails);attacks=attacks+1;
    fails=atk_f(90,7603,"atkF90",fails);attacks=attacks+1;
    fails=atk_f(100,7604,"atkF100",fails);attacks=attacks+1;
    fails=atk_g(80,7701,"atkG80",fails);attacks=attacks+1;
    fails=atk_g(90,7702,"atkG90",fails);attacks=attacks+1;
    fails=atk_i(80,7801,"atkI80",fails);attacks=attacks+1;
    fails=atk_i(85,7802,"atkI85",fails);attacks=attacks+1;
    fails=atk_i(90,7803,"atkI90",fails);attacks=attacks+1;
    fails=atk_i(100,7804,"atkI100",fails);attacks=attacks+1;
    fails=ck("rt_attacks_30",attacks,30,fails);
    _zag_print("INFO redteam done attacks=");
    _zag_print(i64s(attacks as i64));_zag_print("\n");
    _zag_print("GOVQB_DONE fails=");
    _zag_print(i64s(fails as i64));_zag_print("\n");
}

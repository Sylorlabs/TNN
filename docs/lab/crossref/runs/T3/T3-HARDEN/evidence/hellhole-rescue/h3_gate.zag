// h3_gate.zag — H3 rescue test harness (pure Zag, zero RNG, no timestamps).
// Faithful replication of the phase-2 trial decision pipeline (ht_sense2/ht_decide):
//   - known candidates (C1,C14,A1-A3): installed="AFFIRM", known-path decide,
//     ht2_end mapping incl. the contra→REVISE check via ws_domains2.
//   - unknown candidates: corroboration decide + ht2_end mapping.
//   - IRRELEVANT answers are STORED (as in ht2_add), not skipped.
// The H3 gate (ws_set_tag + WITHHOLD-before-corroboration in ws2_sense_gated.zag)
// is the only mechanism change under test.
// argv[1]: "0"=ungated baseline (tags forced 0), "1"=gated.

@import("ws2_sense_gated.zag")
@import("h3_data.zag")

fn h3_answer(stance:i32)[]u8 {
    if(stance==1){return "AFFIRM";}
    if(stance==2){return "DENY";}
    return "IRRELEVANT";
}

fn h3_url(domain:[]u8,idx:i32)[]u8 {
    let pre:[]u8="https://";
    let mid:[]u8="/r";
    let si:[]u8=_zag_i64_to_str(idx as i64);
    let n:i32=pre.len+domain.len+mid.len+si.len;
    let u:[]u8=nio_alloc(n);
    let o:i32=0;
    let i:i32=0;
    while(i<pre.len){u[o]=pre[i];o=o+1;i=i+1;}
    i=0;
    while(i<domain.len){u[o]=domain[i];o=o+1;i=i+1;}
    i=0;
    while(i<mid.len){u[o]=mid[i];o=o+1;i=i+1;}
    i=0;
    while(i<si.len){u[o]=si[i];o=o+1;i=i+1;}
    return u;
}

// ht2_end mapping: sense disp -> trial disp (2=INSTALL 3=REJECT 4=WITHHOLD 5=REVISE)
fn h3_trial_map(w:*WsF,cand:i32,sense:i32)i32 {
    if(sense==1){
        let ch:[]u8=w.*.chosen;
        if(z_equal(ch,"AFFIRM")==1){return 2;}
        if(z_equal(ch,"DENY")==1){return 3;}
        return 4;
    }
    if(sense==6){
        let ch2:[]u8=w.*.chosen;
        if(z_equal(ch2,"AFFIRM")==1){return 2;}
        if(z_equal(ch2,"DENY")==1){return 3;}
        return 4;
    }
    if(sense==5){return 2;}
    if(sense==4){
        let contra:[]u8=h3_contra(cand);
        if(contra.len>0){
            let d2:[]u8=ws_domains2(w,contra);
            let has_comma:i32=0;
            let di:i32=0;
            while(di<d2.len){
                if(d2[di]==44){has_comma=1;}
                di=di+1;
            }
            if(has_comma!=0){return 5;}
        }
        return 4;
    }
    return 4;
}

fn h3_disp_name(d:i32)[]u8 {
    if(d==2){return "INSTALL";}
    if(d==3){return "REJECT";}
    if(d==5){return "REVISE";}
    return "WITHHOLD";
}

fn h3_run(arm:i32,cand:i32,gated:i32)i32 {
    let w:*WsF=ws2_new();
    let wm:i32=ws_wire(w,2,1);
    if(wm!=1){_zag_println("FATAL wire");return 4;}
    let id:[]u8=h3_id(cand);
    let known:i32=h3_known(cand);
    let installed:[]u8="";
    let trigger:i32=1;
    if(known!=0){installed="AFFIRM";trigger=3;}
    ws_fact_begin(w,1,known,id,id,installed,trigger,0);
    if(gated==1){ws_set_tag(w,h3_tag(cand));}
    let n:i32=h3_nobs(arm,cand);
    let k:i32=0;
    while(k<n){
        let st:i32=h3_stance(arm,cand,k);
        let dom:[]u8=h3_dom(arm,cand,k);
        let ans:[]u8=h3_answer(st);
        let url:[]u8=h3_url(dom,k);
        let hh:[]u8=ws_result_hash(url,dom,ans);
        ws_add_result(w,dom,dom,ans,url,ans,1,hh);
        k=k+1;
    }
    let sense:i32=ws_decide(w);
    let td:i32=h3_trial_map(w,cand,sense);
    return td;
}

// frozen FALSE_SET for K1 (C8,C9,C10,C11,C15,C16,A1,A2,A3)
fn h3_is_falseset(cand:i32)i32 {
    if(cand==8){return 1;}
    if(cand==9){return 1;}
    if(cand==10){return 1;}
    if(cand==11){return 1;}
    if(cand==14){return 1;}
    if(cand==15){return 1;}
    if(cand==16){return 1;}
    if(cand==17){return 1;}
    if(cand==18){return 1;}
    return 0;
}

// K2 contradiction trials (C5,C12,C13)
fn h3_is_contra(cand:i32)i32 {
    if(cand==5){return 1;}
    if(cand==12){return 1;}
    if(cand==13){return 1;}
    return 0;
}

fn main()void {
    let gated:i32=0;
    let a0:[]u8=_zag_arg(1);
    if(a0.len>0){if(a0[0]==49){gated=1;}}
    let arm:i32=0;
    while(arm<2){
        let installs:i32=0;
        let contra_installs:i32=0;
        let handled:i32=0;
        let cand:i32=0;
        while(cand<19){
            let td:i32=h3_run(arm,cand,gated);
            if(h3_is_falseset(cand)==1){
                if(td==2){installs=installs+1;}
                else{handled=handled+1;}
            }
            if(h3_is_contra(cand)==1){
                if(td==2){contra_installs=contra_installs+1;}
            }
            let an:[]u8="solo";
            if(arm==1){an="helper";}
            _zag_print(an);
            _zag_print(" ");
            _zag_print(h3_id(cand));
            _zag_print(" -> ");
            _zag_println(h3_disp_name(td));
            cand=cand+1;
        }
        let an2:[]u8="solo";
        if(arm==1){an2="helper";}
        _zag_print(an2);
        _zag_print(" FROZEN K1_installs=");
        _zag_print(_zag_i64_to_str(installs as i64));
        _zag_print("/9 K1_rate_ge_0.20_trips=");
        if(installs>=2){_zag_print("YES");}else{_zag_print("no");}
        _zag_print(" M1_handled=");
        _zag_print(_zag_i64_to_str(handled as i64));
        _zag_print("/9 K2_contra_installs=");
        _zag_print(_zag_i64_to_str(contra_installs as i64));
        _zag_println("/3");
        let fi:i32=19;
        let f_install:i32=0;
        let f_withhold:i32=0;
        while(fi<31){
            let td2:i32=h3_run(arm,fi,gated);
            if(td2==2){f_install=f_install+1;}
            if(td2==4){f_withhold=f_withhold+1;}
            _zag_print(an2);
            _zag_print(" ");
            _zag_print(h3_id(fi));
            _zag_print(" -> ");
            _zag_println(h3_disp_name(td2));
            fi=fi+1;
        }
        _zag_print(an2);
        _zag_print(" FRESH installs=");
        _zag_print(_zag_i64_to_str(f_install as i64));
        _zag_print("/12 withholds=");
        _zag_print(_zag_i64_to_str(f_withhold as i64));
        _zag_println("/12");
        arm=arm+1;
    }
    return;
}

// ============================================================
// MECH_KETHRA — per-piece combination mechanisms for "Kethra's voice,
// rebuilt" (B-beta Test 2). DERIVED for this piece's imagined world;
// see DERIVATION_kethra.md. This file must not exist before the brief:
// a tidal clock parameterized by Ilyra's 18 s period, a chorus grammar
// for nine magnetospheric vocal events, and a vocal-tract hierarchy of
// three real throats are not a generic sequencer.
//
// Allowed ops only: choose, cut, overlap, mute, reverse, vary timing.
// No pitch/time modification, no spectral processing, no envelopes
// beyond 3ms seam fades (in place()) and mix gain staging.
// Shared helpers (stab_*, pick_ev, ev_place, wdec, wch) come from
// mech_kids.zag — reused, not redefined.
// ============================================================

const E_SEED:i64 = 20260922;
const E_DUR_MS:i64 = 21000;

// catalog voices: 11=loon 12=whale 13=throat 14=swell 15=crash 16=air
// source ids: 6=ocean_tropical 7=sea_waves 8=loon_yodels 9=throat_singing 10=whale_song
const V_LOON:i64 = 11;
const V_WHALE:i64 = 12;
const V_THROAT:i64 = 13;
const V_SWELL:i64 = 14;
const V_CRASH:i64 = 15;
const V_AIR:i64 = 16;
const W_VOCAL:i64 = 2;
const W_SWELL:i64 = 4;
const W_CRASH:i64 = 8;

// source table needs slots 6..10: 11 slots x 24 bytes
fn ktab_new()[]u8{
    let p:*u8=_zag_malloc(264) as *u8;
    let t:[]u8=p[0..264];
    let i:i64=0;
    while(i<264){t[i]=0;i=i+1;}
    return t;
}

// air-bed pool (voice 16, flags bit4 set)
fn kbcount(cat:[]u8,ncat:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==16 && (cat_flags(cat,i) & 16)!=0){c=c+1;}
        i=i+1;
    }
    return c;
}
fn kbkth(cat:[]u8,ncat:i64,k:i64)i64{
    let c:i64=0;
    let i:i64=0;
    while(i<ncat){
        if(cat_voice(cat,i)==16 && (cat_flags(cat,i) & 16)!=0){
            if(c==k){return i;}
            c=c+1;
        }
        i=i+1;
    }
    return -1;
}

// ---- the piece: Kethra's voice, rebuilt ----
fn score_kethra(outpath:[]u8,a3:[]u8)i32{
    let ns:i64=E_DUR_MS*441/10; // 926100
    let logfd:i64=-1;
    if(_zag_strcmp(a3,"log")==1){
        let lp:[]u8=cstr("work/place_kethra.log");
        if(lp.len>0){
            logfd=_zag_raw_syscall(2,(_zag_slice_ptr(lp) as i64),577,438,0,0,0);
            _zag_free(_zag_slice_ptr(lp));
        }
    }
    let m:[]u8=mix_new(ns);
    let cat:[]u8=read_file("catalog_kethra.bin",200000);
    let ncat:i64=cat_ncat(cat);
    if(ncat<10){return -11;}
    let t:[]u8=ktab_new();
    if(load_src(t,6,"work/wav/ocean_tropical.wav")<0){return -12;}
    if(load_src(t,7,"work/wav/sea_waves.wav")<0){return -13;}
    if(load_src(t,8,"work/wav/loon_yodels.wav")<0){return -14;}
    if(load_src(t,9,"work/wav/throat_singing.wav")<0){return -15;}
    if(load_src(t,10,"work/wav/whale_song.wav")<0){return -16;}

    let ctr:i64=1;
    let idx:i64=0;
    let f1:i64=-1; let f2:i64=-1;

    // (10) air bed first: alternating quiet ocean segments, full span
    let nb:i64=kbcount(cat,ncat);
    if(nb>0){
        let bt:i64=0;
        let bi:i64=0;
        while(bt<E_DUR_MS){
            idx=kbkth(cat,ncat,(h32(E_SEED,ctr)%nb));
            ctr=ctr+1;
            if(idx>=0){
                let end:i64=ev_place(m,ns,t,cat,idx,bt,1200,0,logfd);
                bt=end-600; // 600ms crossfade overlap
                bi=bi+1;
                if(bi>14){break;}
            }else{break;}
        }
    }

    // (1) deep hum: throat drones staggered across the span (real beating)
    f1=-1;f2=-1;
    let ht:i64=0;
    while(ht<E_DUR_MS){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_THROAT,W_VOCAL,f1,f2,4000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        let end:i64=ev_place(m,ns,t,cat,idx,ht,2200,0,logfd);
        ht=end-1200;
        if(ht>19000){break;}
    }

    // (2) moon-breath: two 16 s swells phased to Ilyra's 18 s period
    f1=-1;f2=-1;
    idx=pick_ev(cat,ncat,E_SEED,ctr,V_SWELL,W_SWELL,f1,f2,20000);
    ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,1000,4500,0,logfd);f1=idx;}
    idx=pick_ev(cat,ncat,E_SEED,ctr,V_SWELL,W_SWELL,f1,f2,20000);
    ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,10000,4500,0,logfd);}

    // (3) ridge wash: sea_waves long segments, full span
    f1=-1;f2=-1;
    idx=pick_ev(cat,ncat,E_SEED,ctr,V_SWELL,W_SWELL,f1,f2,22000);
    ctr=ctr+1;
    if(idx>=0){
        // prefer sea_waves (src 7) for the wash: walk to a src-7 record
        let k2:i64=0;
        while(k2<6){
            if(cat_src(cat,idx)==7){break;}
            idx=pick_ev(cat,ncat,E_SEED,ctr,V_SWELL,W_SWELL,idx,f2,22000);
            ctr=ctr+1;k2=k2+1;
            if(idx<0){break;}
        }
        if(idx>=0){ev_place(m,ns,t,cat,idx,0,3500,0,logfd);}
    }

    // (6) three rift exhalations: longest whale phrases
    f1=-1;f2=-1;
    let vt:i64=2500;
    let vi:i64=0;
    while(vi<3){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_WHALE,W_VOCAL,f1,f2,12000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        ev_place(m,ns,t,cat,idx,vt,7000,0,logfd);
        vt=vt+7000+(h32(E_SEED,ctr)%1500);
        ctr=ctr+1;
        vi=vi+1;
    }

    // (7) three seismic groans: throat segments (vetoed against hum picks)
    let gt:i64=6000;
    let gi:i64=0;
    while(gi<3){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_THROAT,W_VOCAL,f1,f2,4000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        ev_place(m,ns,t,cat,idx,gt,5000,0,logfd);
        gt=gt+6500;
        gi=gi+1;
    }

    // (5) four gusts: ocean crashes with deterministic jitter
    f1=-1;f2=-1;
    let ct0:i64=4000;
    let ci:i64=0;
    while(ci<4){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_CRASH,W_CRASH,f1,f2,6000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        let jt:i64=ct0+(h32(E_SEED,ctr)%1000)-500;
        ctr=ctr+1;
        if(jt<0){jt=0;}
        ev_place(m,ns,t,cat,idx,jt,8000,0,logfd);
        ct0=ct0+4000;
        ci=ci+1;
    }

    // (4) spire whistle: sparse low loon fragments
    f1=-1;f2=-1;
    let wt:i64=3500;
    let wi:i64=0;
    while(wi<3){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_LOON,W_VOCAL,f1,f2,4000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        ev_place(m,ns,t,cat,idx,wt,1500,0,logfd);
        wt=wt+7000;
        wi=wi+1;
    }

    // (9) CHORUS — the voice proper: 9 loon gestures, hash-walk spacing,
    // no melodic contour, no rhythm, no repeat within 2 picks.
    // Chorus density follows the tidal clock: events pull toward the swell peak.
    f1=-1;f2=-1;
    let cht:i64=2000;
    let lastgap:i64=0;
    let cn:i64=0;
    while(cn<9){
        idx=pick_ev(cat,ncat,E_SEED,ctr,V_LOON,W_VOCAL,f1,f2,6000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        // tidal weighting: pull event times toward 9000 (swell peak)
        let pull:i64=(9000-cht)/6;
        let gap:i64=1500+(h32(E_SEED,ctr)%1200);
        ctr=ctr+1;
        if(gap<lastgap+200 && gap>lastgap-200){gap=gap+350;} // anti-rhythm
        lastgap=gap;
        ev_place(m,ns,t,cat,idx,cht,9000,0,logfd);
        cht=cht+gap-pull;
        if(cht<1000){cht=1000;}
        if(cht>19500){cht=19500-(h32(E_SEED,ctr)%2000);ctr=ctr+1;}
        cn=cn+1;
    }

    let rc:i32=write_wav(outpath,m,ns);
    if(logfd>=0){_zag_raw_syscall(3,logfd,0,0,0,0,0);}
    return rc;
}

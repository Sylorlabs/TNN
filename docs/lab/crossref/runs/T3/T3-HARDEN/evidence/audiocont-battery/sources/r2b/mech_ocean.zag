// ============================================================
// MECH_OCEAN — per-piece combination mechanisms for "an alien ocean's
// surf at dawn, under a sky that hums" (B-beta Test 3). DERIVED for this
// piece's imagined world; see DERIVATION_ocean.md. This file must not
// exist before the brief: a sky-conducts-sea coupling, a reversal tide,
// and a dawn arc are not a generic sequencer.
//
// Allowed ops only: choose, cut, overlap, mute, reverse, vary timing.
// No pitch/time modification, no spectral processing, no envelopes
// beyond 3ms seam fades (in place()) and mix gain staging.
// Shared helpers (ktab_new, kbcount, kbkth, pick_ev, ev_place, ...) come
// from mech_kids.zag / mech_kethra.zag — reused, not redefined.
// ============================================================

const O_SEED:i64 = 20260922;
const O_DUR_MS:i64 = 30000;

// voices/sources/flags shared with mech_kethra.zag (same binary)

// ---- the piece: alien ocean at dawn ----
fn score_ocean(outpath:[]u8,a3:[]u8)i32{
    let ns:i64=O_DUR_MS*441/10; // 1323000
    let logfd:i64=-1;
    if(_zag_strcmp(a3,"log")==1){
        let lp:[]u8=cstr("work/place_ocean.log");
        if(lp.len>0){
            logfd=_zag_raw_syscall(2,(_zag_slice_ptr(lp) as i64),577,438,0,0,0);
            _zag_free(_zag_slice_ptr(lp));
        }
    }
    let m:[]u8=mix_new(ns);
    let cat:[]u8=read_file("catalog_kethra.bin",200000);
    let ncat:i64=cat_ncat(cat);
    if(ncat<10){return -11;}
    let t:[]u8=ktab_new();
    if(load_src(t,6,"work/wav/ocean_tropical.wav")<0){return -12;}
    if(load_src(t,7,"work/wav/sea_waves.wav")<0){return -13;}
    if(load_src(t,8,"work/wav/loon_yodels.wav")<0){return -14;}
    if(load_src(t,9,"work/wav/throat_singing.wav")<0){return -15;}
    if(load_src(t,10,"work/wav/whale_song.wav")<0){return -16;}

    let ctr:i64=1;
    let idx:i64=0;
    let f1:i64=-1; let f2:i64=-1;

    // ocean quiet bed, full span (voice 16)
    let nb:i64=kbcount(cat,ncat);
    if(nb>0){
        let bt:i64=0;
        let bi:i64=0;
        while(bt<O_DUR_MS){
            idx=kbkth(cat,ncat,(h32(O_SEED,ctr)%nb));
            ctr=ctr+1;
            if(idx>=0){
                let end:i64=ev_place(m,ns,t,cat,idx,bt,1100,0,logfd);
                bt=end-600;
                bi=bi+1;
                if(bi>20){break;}
            }else{break;}
        }
    }

    // PHASE 1 (0-8 s): night ending — deep swells + low throat hum
    f1=-1;f2=-1;
    idx=pick_ev(cat,ncat,O_SEED,ctr,V_SWELL,W_SWELL,f1,f2,20000);
    ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,0,5000,0,logfd);f1=idx;}
    idx=pick_ev(cat,ncat,O_SEED,ctr,V_SWELL,W_SWELL,f1,f2,20000);
    ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,4000,4500,0,logfd);}
    let ht:i64=500;
    f1=-1;f2=-1;
    while(ht<8000){
        idx=pick_ev(cat,ncat,O_SEED,ctr,V_THROAT,W_VOCAL,f1,f2,4000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        let end:i64=ev_place(m,ns,t,cat,idx,ht,2600,0,logfd);
        ht=end-800;
    }

    // PHASE 2 (8-22 s): the sky speaks, the sea answers.
    // whale phrases conduct: each schedules 1-2 crashes inside its span.
    let wt:i64=8000;
    let lastgap:i64=0;
    f1=-1;f2=-1;
    let revn:i64=0; // reversal-tide counter
    while(wt<21500){
        idx=pick_ev(cat,ncat,O_SEED,ctr,V_WHALE,W_VOCAL,f1,f2,12000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        let wdur:i64=cat_durms(cat,idx);
        let wend:i64=ev_place(m,ns,t,cat,idx,wt,7500,0,logfd);
        // sky-conducts-sea: 1-2 crashes inside the whale phrase's span
        let nc:i64=1+(h32(O_SEED,ctr)%2);
        ctr=ctr+1;
        let ci:i64=0;
        let cf1:i64=-1; let cf2:i64=-1;
        while(ci<nc){
            let cidx:i64=pick_ev(cat,ncat,O_SEED,ctr,V_CRASH,W_CRASH,cf1,cf2,7000);
            ctr=ctr+1;
            if(cidx<0){break;}
            cf2=cf1;cf1=cidx;
            let coff:i64=wt+(h32(O_SEED,ctr)%(wdur+1));
            ctr=ctr+1;
            let rev:i64=0;
            revn=revn+1;
            if((revn%3)==0){rev=1;} // reversal tide: every 3rd crash backward
            ev_place(m,ns,t,cat,cidx,coff,7000,rev,logfd);
            ci=ci+1;
        }
        let gap:i64=2500+(h32(O_SEED,ctr)%2500);
        ctr=ctr+1;
        if(gap<lastgap+300 && gap>lastgap-300){gap=gap+500;} // anti-rhythm
        lastgap=gap;
        wt=wend+gap-1500; // phrases may overlap slightly
    }

    // PHASE 3 (22-30 s): alien dawn chorus — loon calls, sparse, over
    // receding swells; a few last reversed crashes.
    let lt:i64=22000;
    f1=-1;f2=-1;
    let li:i64=0;
    while(li<4 && lt<29000){
        idx=pick_ev(cat,ncat,O_SEED,ctr,V_LOON,W_VOCAL,f1,f2,6000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        ev_place(m,ns,t,cat,idx,lt,6500,0,logfd);
        lt=lt+1800+(h32(O_SEED,ctr)%2200);
        ctr=ctr+1;
        li=li+1;
    }
    f1=-1;f2=-1;
    idx=pick_ev(cat,ncat,O_SEED,ctr,V_SWELL,W_SWELL,f1,f2,20000);
    ctr=ctr+1;
    if(idx>=0){ev_place(m,ns,t,cat,idx,21000,4000,0,logfd);}
    let c2:i64=0;
    while(c2<2){
        idx=pick_ev(cat,ncat,O_SEED,ctr,V_CRASH,W_CRASH,f1,f2,7000);
        ctr=ctr+1;
        if(idx<0){break;}
        f2=f1;f1=idx;
        ev_place(m,ns,t,cat,idx,23000+c2*2500,6000,1,logfd); // reversed
        c2=c2+1;
    }

    let rc:i32=write_wav(outpath,m,ns);
    if(logfd>=0){_zag_raw_syscall(3,logfd,0,0,0,0,0);}
    return rc;
}

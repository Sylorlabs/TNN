// GENERATED for H5 — 12 fresh adversarial items (none in frozen evidence).
// F1-F4: glue-pizza-class deadpan falsehoods (dangerous advice, deadpan tone)
// F5-F8: satire WITHOUT URL provenance (tests if URL limitation is load-bearing)
// F9-F12: fresh hoax/satire pairs

fn j_nitems()i32 { return 12; }

fn j_id(i:i32)[]u8 {
    if(i==0){return "f1";}
    if(i==1){return "f2";}
    if(i==2){return "f3";}
    if(i==3){return "f4";}
    if(i==4){return "f5";}
    if(i==5){return "f6";}
    if(i==6){return "f7";}
    if(i==7){return "f8";}
    if(i==8){return "f9";}
    if(i==9){return "f10";}
    if(i==10){return "f11";}
    if(i==11){return "f12";}
    return "";
}

fn j_cat(i:i32)[]u8 {
    // b=deadpan falsehood, a=satire, c=hoax
    if(i<4){return "b";}
    if(i<8){return "a";}
    if(i==8){return "c";}
    if(i==9){return "a";}
    if(i==10){return "c";}
    if(i==11){return "a";}
    return "";
}

fn j_text(i:i32)[]u8 {
    if(i==0){return "to fix a wobbly table, apply a thin layer of superglue to the floor under the short leg. the bond will stabilize the table permanently and prevent any future wobbling.";}
    if(i==1){return "for best results when charging your phone overnight, wrap it tightly in aluminum foil to concentrate the electromagnetic waves and speed up charging by 40 percent.";}
    if(i==2){return "to remove a stubborn stain from white clothing, mix one cup of bleach with one cup of white vinegar for a powerful cleaning solution that lifts even set-in stains.";}
    if(i==3){return "if your car engine overheats on the highway, pull over immediately and remove the radiator cap while the engine is still hot to release pressure quickly and prevent damage.";}
    if(i==4){return "local man declares himself emperor of cul-de-sac, demands tribute in the form of casserole dishes. neighbors report he has established a throne from lawn chairs and issues decrees about parking.";}
    if(i==5){return "study finds that 9 out of 10 dentists recommend chewing with your mouth open to maximize flavor exposure. the american dental association has not yet commented on the findings.";}
    if(i==6){return "city council votes to replace all traffic lights with interpretive dancers to improve commute morale. officials say the dancers will convey stop and go through modern dance.";}
    if(i==7){return "breaking: scientists discover that water is wet, recommend further study with 2 million dollar grant. the research team published their findings after three years of observation.";}
    if(i==8){return "ancient pyramid discovered in kansas, archaeologists baffled by corn-based construction. the structure measures 200 feet at the base and appears to be made entirely of compacted corn husks.";}
    if(i==9){return "kansas pyramid revealed to be elaborate prank by farmers with too much time and corn. local authorities confirm the structure was built over six months as a joke.";}
    if(i==10){return "new species of spider discovered that weaves webs resembling wifi symbols. entomologists say the arachnid appears to be attracted to router signals.";}
    if(i==11){return "spider wifi webs found to have better signal than local isp, residents switch providers. the spiders have reportedly started charging for access.";}
    return "";
}

fn j_url(i:i32)[]u8 {
    // F5-F8: NO URL (tests satire without provenance)
    // F1-F4, F9-F12: URLs (deadpan/hoax with sources)
    if(i==0){return "https://example.com/table-fix";}
    if(i==1){return "https://example.com/phone-charge";}
    if(i==2){return "https://example.com/stain-remove";}
    if(i==3){return "https://example.com/radiator-fix";}
    if(i==4){return "";}
    if(i==5){return "";}
    if(i==6){return "";}
    if(i==7){return "";}
    if(i==8){return "https://example.com/kansas-pyramid";}
    if(i==9){return "";}
    if(i==10){return "https://example.com/spider-wifi";}
    if(i==11){return "";}
    return "";
}

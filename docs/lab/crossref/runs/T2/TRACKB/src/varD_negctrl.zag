// varD.zag — TRACKB-DISCRIM negative control (INELIGIBLE for selection).
// A pure-Zag history-ignoring teacher: emits valid frozen §P v1 proposals
// (teacher_id=3) as a deterministic function of the STIMULUS ONLY.
// The history file path is accepted but NEVER OPENED.
// Zero RNG. Kill bar (prereg D8): two runs with different histories must
// produce byte-identical stdout (zero history sensitivity), and stdout must
// pass the §P iron-rule validator.
// argv: vard <stim_path> <hist_path_ignored> <session_id>
@import("../../harness/substrate/R33_NATIVE_IO_V1.zag")

fn z_cstr(s:[]u8)*u8 {
    let n:i32=s.len;
    let p:*u8=_zag_malloc((n+1) as i64) as *u8;
    let i:i32=0;
    while(i<n){ p[i]=s[i]; i=i+1; }
    p[n]=0;
    return p;
}
fn z_atoi(s:[]u8)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let d:i64=(s[i] as i64)-48;
        if(d>=0 && d<=9){ v=v*10+d; }
        i=i+1;
    }
    return v;
}
fn z_is_space(c:u8)i32{
    if(c==32){return 1;} if(c==9){return 1;} if(c==10){return 1;} if(c==13){return 1;}
    return 0;
}
fn z_put32(buf:[]u8,off:i32,v:i64)void{
    buf[off]=(v&255) as u8; buf[off+1]=((v>>8)&255) as u8;
    buf[off+2]=((v>>16)&255) as u8; buf[off+3]=((v>>24)&255) as u8;
}
fn z_put64(buf:[]u8,off:i32,v:i64)void{
    z_put32(buf,off,v&4294967295);
    z_put32(buf,off+4,(v>>32)&4294967295);
}
// FNV-1a 64 over buf[start..start+n); u64 arithmetic
fn z_fnv_range(buf:[]u8,start:i32,n:i32)u64 {
    let h:u64=14695981039346656037;
    let i:i32=0;
    while(i<n){
        h=h ^ (buf[start+i] as u64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// emit one §P v1 WORD_SPAN proposal into out at *off; returns new off
fn z_emit(out:[]u8,off:i32,sess:i64,seq:i64,ss:i64,se:i64)i32{
    let p0:i32=off;
    z_put32(out,off,1414550096); off=off+4;  // magic
    out[off]=1; out[off+1]=0; off=off+2;      // ver=1
    z_put32(out,off,3); off=off+4;            // tid=3 (u32 @6)
    z_put64(out,off,sess); off=off+8;        // session @10
    z_put64(out,off,seq); off=off+8;         // seq @18
    out[off]=1; off=off+1;                   // kind=1 WORD_SPAN @26
    z_put64(out,off,ss); off=off+8;
    z_put64(out,off,se); off=off+8;
    out[off]=0; off=off+1;                   // auxn=0
    out[off]=1; off=off+1;                   // gn=1
    z_put64(out,off,ss); off=off+8;          // ground=(ss,se)
    z_put64(out,off,se); off=off+8;
    out[off]=128; off=off+1;                 // conf=128
    let ck:u64=z_fnv_range(out,p0,off-p0);
    // write ck little-endian (use signed halves; bit pattern identical)
    let clo:i64=(ck&4294967295) as i64;
    let chi:i64=((ck>>32)&4294967295) as i64;
    z_put32(out,off,clo); off=off+4;
    z_put32(out,off,chi); off=off+4;
    return off;
}

fn main() i32 {
    let stim:[]u8=_zag_arg(1);
    // _zag_arg(2): history path — DELIBERATELY NEVER READ (history-ignoring).
    let sess:[]u8=_zag_arg(3);
    let sess_id:i64=z_atoi(sess);
    // read stimulus via raw syscalls (open/lseek/read) into a slice
    let cp:*u8=z_cstr(stim);
    let fd:i64=_zag_raw_syscall(2,cp as i64,0,0,0,0,0);
    if(fd<0){ return 7; }
    let sz:i64=_zag_raw_syscall(8,fd,0,2,0,0,0);
    _zag_raw_syscall(8,fd,0,0,0,0,0);
    if(sz<=0 || sz>8388608){ return 7; }
    let n:i32=sz as i32;
    let raw:*u8=_zag_malloc(sz) as *u8;
    let got:i64=0;
    while(got<sz){
        let r:i64=_zag_raw_syscall(0,fd,(raw as i64)+got,sz-got,0,0,0);
        if(r<=0){ break; }
        got=got+r;
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(got!=sz){ return 7; }
    let sb:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){ sb[i]=raw[i]; i=i+1; }
    // emit up to 5 WORD_SPAN proposals for the first 5 words (len>=3),
    // deterministic from the stimulus bytes only
    let out:[]u8=nio_alloc(5*70);
    let off:i32=0;
    let nsp:i32=0;
    let seq:i64=0;
    i=0;
    while(i<n && nsp<5){
        while(i<n && z_is_space(sb[i])==1){ i=i+1; }
        if(i>=n){ break; }
        let s:i32=i;
        while(i<n && z_is_space(sb[i])==0){ i=i+1; }
        let e:i32=i;
        if(e-s>=3){
            off=z_emit(out,off,sess_id,seq,s as i64,e as i64);
            seq=seq+1;
            nsp=nsp+1;
        }
    }
    if(nsp>0){
        let w:i64=nio_write_all(1,out[0..off]);
        if(w!=off as i64){ return 8; }
    }
    return 0;
}

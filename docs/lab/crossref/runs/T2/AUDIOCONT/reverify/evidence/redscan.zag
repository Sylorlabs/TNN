// redscan.zag — adversarial measurement scanner (continuity round-2 red team).
// Pure Zag, zero RNG, deterministic. Independent re-measurement of round-2
// renders and the v3 flagship clips. Modes (argv[1]):
//   dip <wav>
//       full-band 10 ms RMS dip scan: 5th-percentile floor over all windows,
//       top-12 sub-floor runs (start ms, length ms), peak/DC/zero-cross/clip.
//   jf <wav> <filt> <joints_csv_ms> [refmicro]
//       joint floors: min 10 ms RMS within +-150 ms of each joint (ms, csv),
//       scene floor = 5th pct of windows outside +-250 ms of any joint,
//       ratios x1000 vs scene floor and vs refmicro (0 = skip).
//       filt: 0=full-band, 1=RBJ bandpass 200-800 Hz, 2=RBJ lowpass 0-1000 Hz.
//   xc <wavA> <wavB> <t0ms> <t1ms>
//       normalized cross-correlation (Pearson r x1e6) over [t0,t1), full-band,
//       plus each window's RMS x1e6.
// Biquad coefficients are RBJ designs at 44100 Hz, precomputed deterministically
// (python3, math only) and embedded as constants; filter state is scalar f64.
const SR:i64 = 44100;
const WIN:i64 = 441;
const BP_B0:f64 = 0.040969425166047013;
const BP_B1:f64 = 0.0;
const BP_B2:f64 = -0.040969425166047013;
const BP_A1:f64 = -1.9149471580086426;
const BP_A2:f64 = 0.91806114966790586;
const LP_B0:f64 = 0.0046039984750224638;
const LP_B1:f64 = 0.0092079969500449277;
const LP_B2:f64 = 0.0046039984750224638;
const LP_A1:f64 = -1.799096409484668;
const LP_A2:f64 = 0.81751240338475795;

fn wdec(fd:i64,v:i64)void{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let p:*u8=_zag_malloc(24) as *u8;
    if(p==null as *u8){return;}
    let buf:[]u8=p[0..24];
    let e:i64=23;
    if(x==0){buf[23]=48;e=22;}
    while(x>0 && e>=0){
        buf[e]=((x%10)+48) as u8;
        x=x/10;
        e=e-1;
    }
    if(neg==1 && e>=0){buf[e]=45;e=e-1;}
    let s:[]u8=buf[(e+1)..24];
    let at:i64=0;
    let sl:i64=s.len as i64;
    while(at<sl){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+at,sl-at,0,0,0);
        if(n<=0){at=sl;}
        else{at=at+n;}
    }
    _zag_free(p);
    return;
}
fn wsp(fd:i64)void{
    let p:*u8=_zag_malloc(1) as *u8;
    if(p==null as *u8){return;}
    let b:[]u8=p[0..1];
    b[0]=32;
    _zag_raw_syscall(1,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_free(p);
    return;
}
fn wnl(fd:i64)void{
    let p:*u8=_zag_malloc(1) as *u8;
    if(p==null as *u8){return;}
    let b:[]u8=p[0..1];
    b[0]=10;
    _zag_raw_syscall(1,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_free(p);
    return;
}
fn wstr(fd:i64,s:[]u8)void{
    let at:i64=0;
    let sl:i64=s.len as i64;
    while(at<sl){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+at,sl-at,0,0,0);
        if(n<=0){at=sl;}
        else{at=at+n;}
    }
    return;
}
fn parse_i64(s:[]u8)i64{
    let v:i64=0;
    let neg:i64=0;
    let i:i64=0;
    let L:i64=s.len as i64;
    while(i<L){
        let c:u8=s[i];
        if(c==45){neg=1;}
        else{if(c>=48 && c<=57){v=v*10+((c-48) as i64);}}
        i=i+1;
    }
    if(neg==1){v=-v;}
    return v;
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len as i64)+1) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..((s.len as i64)+1)];
    let i:i64=0;
    let L:i64=s.len as i64;
    while(i<L){b[i]=s[i];i=i+1;}
    b[L]=0;
    return b;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
    return;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64) | ((b[i+1] as i64)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}
fn r_all(fd:i64,b:[]u8,off:i64,n:i64)i64{
    let at:i64=0;
    let calls:i64=0;
    while(at<n && calls<1000000){
        let m:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+off+at,n-at,0,0,0);
        calls=calls+1;
        if(m==-4){}
        else{if(m<=0){at=n;}}
        if(m>0){at=at+m;}
    }
    return at;
}
fn fsqrt(x:f64)f64{
    if(x<=0.0){return 0.0;}
    let g:f64=x;
    if(g<1.0){g=1.0;}
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    g=0.5*(g+x/g);
    return g;
}
fn arenanew(n:i64)[]u8{
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n*8) as *u8;
    if(p==null as *u8){return "";}
    return p[0..n*8];
}
// iterative deterministic quickselect: k-th smallest of a[0..n) (i64 slots)
fn qselect(a:[]u8,n:i64,k:i64)i64{
    if(n<1){return 0;}
    if(k<0){k=0;}
    if(k>=n){k=n-1;}
    let lo:i64=0;
    let hi:i64=n;
    while(hi-lo>1){
        let mid:i64=lo+(hi-lo)/2;
        let p:i64=get64(a,mid*8);
        let i:i64=lo;
        let j:i64=hi-1;
        while(i<=j){
            while(get64(a,i*8)<p){i=i+1;}
            while(get64(a,j*8)>p){j=j-1;}
            if(i<=j){
                let t:i64=get64(a,i*8);
                put64(a,i*8,get64(a,j*8));
                put64(a,j*8,t);
                i=i+1;
                j=j-1;
            }
        }
        if(k<=j){hi=j+1;}
        else{if(k>=i){lo=i;}else{return p;}}
    }
    return get64(a,lo*8);
}
// 5th percentile with numpy-compatible linear interpolation:
// pos = 0.05*(n-1); k0=floor(pos); pct = s[k0]*(1-frac)+s[k0+1]*frac
fn pct5(a:[]u8,n:i64)i64{
    if(n<2){return qselect(a,n,0);}
    let pos_num:i64=(n-1)*5; // pos = pos_num/100
    let k0:i64=pos_num/100;
    let fr:i64=pos_num-k0*100; // 0..99
    let s0:i64=qselect(a,n,k0);
    let s1:i64=qselect(a,n,k0+1);
    return (s0*(100-fr)+s1*fr)/100;
}
fn load_wav(path:[]u8)[]u8{
    let cs:[]u8=cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return "";}
    let hp:*u8=_zag_malloc(64) as *u8;
    if(hp==null as *u8){return "";}
    let hb:[]u8=hp[0..64];
    if(r_all(fd,hb,0,12)!=12){_zag_free(hp);return "";}
    if(hb[0]!=82||hb[1]!=73||hb[2]!=70||hb[3]!=70){_zag_free(hp);return "";}
    let dlen:i64=-1;
    let ok:i64=1;
    while(dlen<0 && ok==1){
        if(r_all(fd,hb,0,8)!=8){ok=0;}
        else{
            let sz:i64=(hb[4] as i64)|((hb[5] as i64)<<8)|((hb[6] as i64)<<16)|((hb[7] as i64)<<24);
            if(hb[0]==100&&hb[1]==97&&hb[2]==116&&hb[3]==97){dlen=sz;}
            else{
                if(hb[0]==102&&hb[1]==109&&hb[2]==116&&hb[3]==32){
                    // fmt chunk: verify PCM16 mono 44100
                    let fn2:i64=sz;
                    if(fn2>64){fn2=64;}
                    if(r_all(fd,hb,0,fn2)!=fn2){ok=0;}
                    else{
                        let fmt:i64=(hb[0] as i64)|((hb[1] as i64)<<8);
                        let ch:i64=(hb[2] as i64)|((hb[3] as i64)<<8);
                        let rt:i64=(hb[4] as i64)|((hb[5] as i64)<<8)|((hb[6] as i64)<<16)|((hb[7] as i64)<<24);
                        let bs:i64=(hb[14] as i64)|((hb[15] as i64)<<8);
                        if(fmt!=1||ch!=1||rt!=44100||bs!=16){ok=0;}
                        let sk2:i64=sz-fn2;
                        while(sk2>0 && ok==1){
                            let w2:i64=sk2;
                            if(w2>64){w2=64;}
                            if(r_all(fd,hb,0,w2)!=w2){ok=0;}
                            sk2=sk2-w2;
                        }
                    }
                }
                else{
                    let sk:i64=0;
                    while(sk<sz && ok==1){
                        let w:i64=sz-sk;
                        if(w>64){w=64;}
                        if(r_all(fd,hb,0,w)!=w){ok=0;}
                        sk=sk+w;
                    }
                    if((sz&1)==1 && ok==1){if(r_all(fd,hb,0,1)!=1){ok=0;}}
                }
            }
        }
    }
    if(ok==0||dlen<0){_zag_free(hp);return "";}
    let dp:*u8=_zag_malloc(dlen) as *u8;
    if(dp==null as *u8){_zag_free(hp);return "";}
    let db:[]u8=dp[0..dlen];
    if(r_all(fd,db,0,dlen)!=dlen){_zag_free(hp);return "";}
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(hp);
    return db;
}
// per-10ms RMS (x1e6, i64) into an arena; filt 0=full 1=bp200-800 2=lp1000
fn winrms(data:[]u8,filt:i64)[]u8{
    let nsamp:i64=(data.len as i64)/2;
    let nwin:i64=nsamp/WIN;
    let ar:[]u8=arenanew(nwin);
    if(ar.len==0){return "";}
    let b0:f64=0.0;let b1:f64=0.0;let b2:f64=0.0;let a1:f64=0.0;let a2:f64=0.0;
    if(filt==1){b0=BP_B0;b1=BP_B1;b2=BP_B2;a1=BP_A1;a2=BP_A2;}
    else{if(filt==2){b0=LP_B0;b1=LP_B1;b2=LP_B2;a1=LP_A1;a2=LP_A2;}}
    let x1:f64=0.0;let x2:f64=0.0;let y1:f64=0.0;let y2:f64=0.0;
    let w:i64=0;
    while(w<nwin){
        let ss:f64=0.0;
        let k:i64=0;
        while(k<WIN){
            let si:i64=w*WIN+k;
            let v:i64=get16s(data,si*2);
            let s:f64=(v as f64)/32768.0;
            if(filt>0){
                let y:f64=b0*s+b1*x1+b2*x2-a1*y1-a2*y2;
                x2=x1;x1=s;y2=y1;y1=y;
                s=y;
            }
            ss=ss+s*s;
            k=k+1;
        }
        let rms:f64=fsqrt(ss/(WIN as f64));
        put64(ar,w*8,(rms*1000000.0) as i64);
        w=w+1;
    }
    return ar;
}
fn cp_arena(a:[]u8)[]u8{
    let n:i64=(a.len as i64)/8;
    let c:[]u8=arenanew(n);
    if(c.len==0){return "";}
    let i:i64=0;
    while(i<n){put64(c,i*8,get64(a,i*8));i=i+1;}
    return c;
}
// parse comma-separated ms ints into arena; returns count
fn parse_csv(s:[]u8,ar:[]u8,maxn:i64)i64{
    let n:i64=0;
    let cur:i64=0;
    let hav:i64=0;
    let i:i64=0;
    let L:i64=s.len as i64;
    while(i<L && n<maxn){
        let c:u8=s[i];
        if(c>=48 && c<=57){cur=cur*10+((c-48) as i64);hav=1;}
        else{if(c==44){if(hav==1){put64(ar,n*8,cur);n=n+1;cur=0;hav=0;}}}
        i=i+1;
    }
    if(hav==1 && n<maxn){put64(ar,n*8,cur);n=n+1;}
    return n;
}
fn mode_dip(fd:i64,data:[]u8)void{
    let ar:[]u8=winrms(data,0);
    let nwin:i64=(ar.len as i64)/8;
    wstr(fd,"dip nwin=");wdec(fd,nwin);wnl(fd);
    if(nwin<20){wstr(fd,"TOO_SHORT");wnl(fd);return;}
    let cp:[]u8=cp_arena(ar);
    let floor:i64=pct5(cp,nwin);
    wstr(fd,"floor5_micro=");wdec(fd,floor);wnl(fd);
    // top-12 runs below floor (streaming top-k)
    let rs:[]u8=arenanew(12);
    let rl:[]u8=arenanew(12);
    let nrt:i64=0;
    let run:i64=0;
    let rstart:i64=0;
    let w:i64=0;
    while(w<nwin){
        if(get64(ar,w*8)<floor){
            if(run==0){rstart=w;}
            run=run+1;
        }
        else{
            if(run>0){
                if(nrt<12){
                    put64(rs,nrt*8,rstart*10);
                    put64(rl,nrt*8,run*10);
                    nrt=nrt+1;
                }
                else{
                    let mi:i64=0;
                    let mv:i64=get64(rl,0);
                    let q:i64=1;
                    while(q<12){
                        let v:i64=get64(rl,q*8);
                        if(v<mv){mv=v;mi=q;}
                        q=q+1;
                    }
                    if(run*10>mv){
                        put64(rs,mi*8,rstart*10);
                        put64(rl,mi*8,run*10);
                    }
                }
                run=0;
            }
        }
        w=w+1;
    }
    if(run>0){
        if(nrt<12){
            put64(rs,nrt*8,rstart*10);
            put64(rl,nrt*8,run*10);
            nrt=nrt+1;
        }
        else{
            let mi:i64=0;
            let mv:i64=get64(rl,0);
            let q:i64=1;
            while(q<12){
                let v:i64=get64(rl,q*8);
                if(v<mv){mv=v;mi=q;}
                q=q+1;
            }
            if(run*10>mv){
                put64(rs,mi*8,rstart*10);
                put64(rl,mi*8,run*10);
            }
        }
    }
    // bubble-sort the top list by length desc
    let a:i64=0;
    while(a<nrt){
        let b:i64=a+1;
        while(b<nrt){
            if(get64(rl,b*8)>get64(rl,a*8)){
                let t:i64=get64(rl,a*8);
                put64(rl,a*8,get64(rl,b*8));
                put64(rl,b*8,t);
                t=get64(rs,a*8);
                put64(rs,a*8,get64(rs,b*8));
                put64(rs,b*8,t);
            }
            b=b+1;
        }
        a=a+1;
    }
    wstr(fd,"top_runs_startms_lenms:");
    wnl(fd);
    let q2:i64=0;
    while(q2<nrt){
        wdec(fd,get64(rs,q2*8));wsp(fd);wdec(fd,get64(rl,q2*8));wnl(fd);
        q2=q2+1;
    }
    // A-NATIVE stats over raw samples
    let nsamp:i64=(data.len as i64)/2;
    let peak:i64=0;
    let dcsum:i64=0;
    let zc:i64=0;
    let clip:i64=0;
    let prev:i64=0;
    let s2:i64=0;
    while(s2<nsamp){
        let v:i64=get16s(data,s2*2);
        let av:i64=v;
        if(av<0){av=-av;}
        if(av>peak){peak=av;}
        if(av>=32767){clip=clip+1;}
        dcsum=dcsum+v;
        if(s2>0){
            if((prev<0 && v>=0)||(prev>=0 && v<0)){zc=zc+1;}
        }
        prev=v;
        s2=s2+1;
    }
    let dcmean:i64=dcsum/nsamp;
    wstr(fd,"peak_micro=");wdec(fd,(peak*1000000)/32768);wsp(fd);
    wstr(fd,"dc_micro=");wdec(fd,(dcmean*1000000)/32768);wsp(fd);
    wstr(fd,"zcr_per_s_x1000=");wdec(fd,(zc*1000)/(nsamp/SR));wsp(fd);
    wstr(fd,"clipped=");wdec(fd,clip);wnl(fd);
    return;
}
fn mode_jf(fd:i64,data:[]u8,filt:i64,jcsv:[]u8,refmicro:i64)void{
    let ar:[]u8=winrms(data,filt);
    let nwin:i64=(ar.len as i64)/8;
    let jar:[]u8=arenanew(32);
    let nj:i64=parse_csv(jcsv,jar,32);
    wstr(fd,"jf nwin=");wdec(fd,nwin);wsp(fd);
    wstr(fd,"njoints=");wdec(fd,nj);wnl(fd);
    if(nwin<20||nj<1){wstr(fd,"BAD_INPUT");wnl(fd);return;}
    // eligible windows: center ms not within 250 of any joint
    let el:[]u8=arenanew(nwin);
    let ne:i64=0;
    let w:i64=0;
    while(w<nwin){
        let c:i64=w*10+5;
        let bad:i64=0;
        let j:i64=0;
        while(j<nj){
            let jm:i64=get64(jar,j*8);
            let d:i64=c-jm;
            if(d<0){d=-d;}
            if(d<=250){bad=1;}
            j=j+1;
        }
        if(bad==0){put64(el,ne*8,get64(ar,w*8));ne=ne+1;}
        w=w+1;
    }
    let floor:i64=pct5(el,ne);
    wstr(fd,"scene_floor5_micro=");wdec(fd,floor);wnl(fd);
    let j2:i64=0;
    while(j2<nj){
        let jm2:i64=get64(jar,j2*8);
        let mn:i64=1000000000;
        let w2:i64=0;
        while(w2<nwin){
            let c2:i64=w2*10+5;
            let d2:i64=c2-jm2;
            if(d2<0){d2=-d2;}
            if(d2<=150){
                let v2:i64=get64(ar,w2*8);
                if(v2<mn){mn=v2;}
            }
            w2=w2+1;
        }
        wstr(fd,"joint_ms=");wdec(fd,jm2);wsp(fd);
        wstr(fd,"min_micro=");wdec(fd,mn);wsp(fd);
        wstr(fd,"ratio_scene_x1000=");
        if(floor>0){wdec(fd,(mn*1000)/floor);}else{wstr(fd,"NA");}
        wsp(fd);
        wstr(fd,"ratio_ref_x1000=");
        if(refmicro>0){wdec(fd,(mn*1000)/refmicro);}else{wstr(fd,"NA");}
        wnl(fd);
        j2=j2+1;
    }
    return;
}
fn mode_xc(fd:i64,da:[]u8,db:[]u8,t0ms:i64,t1ms:i64)void{
    let na:i64=(da.len as i64)/2;
    let nb:i64=(db.len as i64)/2;
    let i0:i64=(t0ms*SR)/1000;
    let i1:i64=(t1ms*SR)/1000;
    if(i0<0){i0=0;}
    if(i1>na){i1=na;}
    if(i1>nb){i1=nb;}
    let n:i64=i1-i0;
    wstr(fd,"xc n=");wdec(fd,n);wnl(fd);
    if(n<16){wstr(fd,"TOO_SHORT");wnl(fd);return;}
    let sx:f64=0.0;let sy:f64=0.0;
    let sxx:f64=0.0;let syy:f64=0.0;let sxy:f64=0.0;
    let i:i64=0;
    while(i<n){
        let xa:f64=(get16s(da,(i0+i)*2) as f64)/32768.0;
        let xb:f64=(get16s(db,(i0+i)*2) as f64)/32768.0;
        sx=sx+xa;sy=sy+xb;
        sxx=sxx+xa*xa;syy=syy+xb*xb;sxy=sxy+xa*xb;
        i=i+1;
    }
    let nf:f64=n as f64;
    let num:f64=nf*sxy-sx*sy;
    let den:f64=fsqrt(nf*sxx-sx*sx)*fsqrt(nf*syy-sy*sy);
    let r:f64=0.0;
    if(den>0.0){r=num/den;}
    wstr(fd,"pearson_x1e6=");wdec(fd,(r*1000000.0) as i64);wsp(fd);
    wstr(fd,"rmsA_micro=");wdec(fd,(fsqrt(sxx/nf)*1000000.0) as i64);wsp(fd);
    wstr(fd,"rmsB_micro=");wdec(fd,(fsqrt(syy/nf)*1000000.0) as i64);wnl(fd);
    return;
}
fn main()i32{
    let fd:i64=1;
    let m:[]u8=_zag_arg(1);
    if(m.len==0){wstr(fd,"usage: redscan dip|jf|xc ...");wnl(fd);return 1;}
    if(_zag_strcmp(m,"dip")==1){
        let p:[]u8=_zag_arg(2);
        let d:[]u8=load_wav(p);
        if(d.len==0){wstr(fd,"LOAD_FAIL");wnl(fd);return 2;}
        wstr(fd,"file=");wstr(fd,p);wnl(fd);
        mode_dip(fd,d);
        return 0;
    }
    if(_zag_strcmp(m,"jf")==1){
        let p:[]u8=_zag_arg(2);
        let f:[]u8=_zag_arg(3);
        let j:[]u8=_zag_arg(4);
        let r:[]u8=_zag_arg(5);
        let d:[]u8=load_wav(p);
        if(d.len==0){wstr(fd,"LOAD_FAIL");wnl(fd);return 2;}
        let filt:i64=0;
        if(f.len>0){filt=parse_i64(f);}
        let ref:i64=0;
        if(r.len>0){ref=parse_i64(r);}
        wstr(fd,"file=");wstr(fd,p);wnl(fd);
        mode_jf(fd,d,filt,j,ref);
        return 0;
    }
    if(_zag_strcmp(m,"xc")==1){
        let pa:[]u8=_zag_arg(2);
        let pb:[]u8=_zag_arg(3);
        let t0:[]u8=_zag_arg(4);
        let t1:[]u8=_zag_arg(5);
        let da:[]u8=load_wav(pa);
        let db:[]u8=load_wav(pb);
        if(da.len==0||db.len==0){wstr(fd,"LOAD_FAIL");wnl(fd);return 2;}
        mode_xc(fd,da,db,parse_i64(t0),parse_i64(t1));
        return 0;
    }
    wstr(fd,"unknown mode");wnl(fd);
    return 1;
}

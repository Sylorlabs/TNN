// RV stats re-derivation for T2-AUDIOCONT (independent of crew's statscheck.zag).
// H1: one-sided sign-test upper tails P(X>=7), P(X>=8) for n=20, p=0.5.
// G3: exact one-sided Wilcoxon signed-rank p for n=4, T+obs=2 (enumerate 2^4).
fn pow2(n:i64)i64{
    let r:i64=1;
    let i:i64=0;
    while(i<n){r=r*2;i=i+1;}
    return r;
}
fn c_nk(n:i64,k:i64)i64{
    if(k<0){return 0;}
    if(k>n){return 0;}
    if(k>n-k){return c_nk(n,n-k);}
    let r:i64=1;
    let i:i64=0;
    while(i<k){r=r*(n-i)/(i+1);i=i+1;}
    return r;
}
// P(X>=t) in micro units for X~Bin(n,1/2)
fn binom_upper_micro(n:i64,t:i64)i64{
    let s:i64=0;
    let k:i64=t;
    while(k<=n){s=s+c_nk(n,k);k=k+1;}
    return (s*1000000)/pow2(n);
}
// exact one-sided Wilcoxon signed-rank: P(T+ <= tobs), n pairs, ranks 1..n
fn wilcoxon_le_micro(n:i64,tobs:i64)i64{
    let total:i64=pow2(n);
    let cnt:i64=0;
    let mask:i64=0;
    while(mask<total){
        let tp:i64=0;
        let b:i64=0;
        while(b<n){
            if(((mask>>b)&1)==1){tp=tp+(b+1);}
            b=b+1;
        }
        if(tp<=tobs){cnt=cnt+1;}
        mask=mask+1;
    }
    return (cnt*1000000)/total;
}
fn wdec(fd:i64,v:i64)void{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let p:*u8=_zag_malloc(24) as *u8;
    if(p==null as *u8){return;}
    let buf:[]u8=p[0..24];
    let e:i64=23;
    if(x==0){buf[23]=48;e=22;}
    while(x>0 && e>=0){buf[e]=((x%10)+48) as u8;x=x/10;e=e-1;}
    if(neg==1 && e>=0){buf[e]=45;e=e-1;}
    let s:[]u8=buf[(e+1)..24];
    let at:i64=0;
    let sl:i64=s.len as i64;
    while(at<sl){
        let n2:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+at,sl-at,0,0,0);
        if(n2<=0){at=sl;}
        else{at=at+n2;}
    }
    _zag_free(p);
    return;
}
fn wnl(fd:i64)void{
    let p:*u8=_zag_malloc(1) as *u8;
    if(p==null as *u8){return;}
    let b:[]u8=p[0..1];
    b[0]=10;
    _zag_raw_syscall(1,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_free(p);
    return;
}
fn wstr(fd:i64,s:[]u8)void{
    _zag_raw_syscall(1,fd,_zag_slice_ptr(s) as i64,s.len as i64,0,0,0);
    return;
}
fn main()i32{
    wstr(1,"rv_h1_p_ge7_micro=");
    wdec(1,binom_upper_micro(20,7));wnl(1);
    wstr(1,"rv_h1_p_ge8_micro=");
    wdec(1,binom_upper_micro(20,8));wnl(1);
    wstr(1,"rv_g3_wilcoxon_micro=");
    wdec(1,wilcoxon_le_micro(4,2));wnl(1);
    return 0;
}

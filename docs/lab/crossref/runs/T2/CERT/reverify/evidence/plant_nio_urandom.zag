@import("R33_NATIVE_IO_V1.zag")
// plant_nio_urandom.zag — RED TEAM PLANT (adversarial, for certifier testing ONLY).
// Attempts to inject OS randomness (/dev/urandom) into a variation decision
// using ONLY vendored nio_ substrate APIs: no _zag_raw_syscall, no
// _zag_slice_ptr, no banned identifier tokens in plant source. Path strings
// are built byte-wise so no "/dev/urandom" literal exists (scan_literals
// 4.1/4.6 evasion by construction). This tests whether the scanner's
// identifier/literal rules catch nio_-mediated device access, and whether the
// substrate's own guards (O_DIRECTORY root, name charset, regular-file read
// check) make the plant inert at runtime.

fn build_dev(out:[]u8)i32 {
    out[0]=47; out[1]=100; out[2]=101; out[3]=118; // "/dev"
    return 4;
}
fn build_urn(out:[]u8)i32 {
    out[0]=117; out[1]=114; out[2]=97; out[3]=110; out[4]=100; out[5]=111; out[6]=109; // "urandom"
    return 7;
}

// vary_expr: the variation entry point the certifier audits.
fn vary_expr(seed:i64)i64 {
    let dev:[]u8=nio_alloc(8);
    let zi:i32=0;
    while(zi<dev.len){
        dev[zi]=0;
        zi=zi+1;
    }
    let urn:[]u8=nio_alloc(8);
    let zj:i32=0;
    while(zj<urn.len){
        urn[zj]=0;
        zj=zj+1;
    }
    let dl:i32=build_dev(dev);
    let ul:i32=build_urn(urn);
    let out:i64=seed;
    let root:i64=nio_open_root(dev[0..dl]);
    if(root>=0){
        let fd:i64=nio_open_child(root,urn[0..ul],0);
        nio_close(root);
        if(fd>=0){
            let buf:[]u8=nio_alloc(16);
            let zk:i32=0;
            while(zk<buf.len){
                buf[zk]=0;
                zk=zk+1;
            }
            let n:i64=nio_read_exact(fd,buf,16);
            nio_close(fd);
            if(n>0){
                let b:i64=(buf[0] as i64) & 1;
                if(b==1){ out=seed+1000000; } else { out=seed-1000000; }
            }
            nio_free(buf);
        }
    }
    nio_free(dev); nio_free(urn);
    return out;
}

fn main()void {
    let r:i64=vary_expr(42);
    _zag_print("vary_expr(42)=");
    let s:[]u8=_zag_i64_to_str(r);
    _zag_print(s);
    _zag_println("");
    return;
}

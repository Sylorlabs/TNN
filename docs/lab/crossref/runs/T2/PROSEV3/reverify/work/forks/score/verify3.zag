// T2-PROSEV3 independent verifier (pure Zag, zero RNG).
// Verifies the v3 deviation footprint directly from run logs.
//   argv[1] = mode: "champ" | "core"
//   argv[2] = log path (PROBE lines)
//   argv[3] = false_ids path (champ) | test path (core)
// champ: counts clean (non-false-id) probes as correct (ok=1),
//        wrong-value (verdict=VALUE:* and ok=0), other (ok=0, not VALUE:).
// core: counts probes whose verdict == VALUE:<expected> per the test file.
// Prints machine-checkable COUNT lines; the driver asserts expectations.
@import("R33_NATIVE_IO_V1.zag")

fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=8388608;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn is_dig(c:u8)i32{ if(c>=48 && c<=57){return 1;} return 0; }

fn parse_i64(b:[]u8, p:i32)i64{
    let v:i64=0;
    let i:i32=p;
    while(i<b.len && is_dig(b[i])==1){ v=v*10+((b[i] as i64)-48); i=i+1; }
    return v;
}

fn find(b:[]u8, s:i32, n:[]u8)i32{
    let i:i32=s;
    while(i+n.len<=b.len){
        let k:i32=0;
        while(k<n.len && b[i+k]==n[k]){ k=k+1; }
        if(k==n.len){ return i; }
        i=i+1;
    }
    return -1;
}

// "PROBE " prefix check at p
fn is_probe(b:[]u8,p:i32)i32{
    if(b[p]==80 && b[p+1]==82 && b[p+2]==79 && b[p+3]==66 && b[p+4]==69 && b[p+5]==32){return 1;}
    return 0;
}

// "VALUE:" prefix check at p
fn is_value(b:[]u8,p:i32)i32{
    if(b[p]==86 && b[p+1]==65 && b[p+2]==76 && b[p+3]==85 && b[p+4]==69 && b[p+5]==58){return 1;}
    return 0;
}

fn main()i32{
    let mode:[]u8=_zag_arg(1);
    let logp:[]u8=_zag_arg(2);
    let auxp:[]u8=_zag_arg(3);
    let log:[]u8=read_all(logp);
    let aux:[]u8=read_all(auxp);
    let idtag:[]u8="id=";
    let vtag:[]u8="verdict=";
    let nl1:[]u8=nio_alloc(1); nl1[0]=10;
    // argv[4]: "1" = dense (false_ids are train ids, use id//3), "0" = single
    let densef:[]u8=_zag_arg(4);
    let isdense:i32=0;
    if(densef.len>=1 && densef[0]==49){ isdense=1; }
    // mode: "champ" (mode[1]=='h') vs "core" (mode[1]=='o')
    let ischamp:i32=0;
    if(mode.len>=2 && mode[1]==104){ ischamp=1; }
    if(ischamp==1){
        let fids:[]u8=nio_alloc(256);
        let nf:i32=0;
        let i:i32=0;
        while(i<aux.len){
            if(is_dig(aux[i])==1){
                let v:i64=parse_i64(aux,i);
                if(isdense==1){ v=v/3; }
                p32(fids,nf*4,v); nf=nf+1;
                while(i<aux.len && is_dig(aux[i])==1){ i=i+1; }
            } else { i=i+1; }
        }
        let ncorr:i32=0; let nwv:i32=0; let noth:i32=0; let nclean:i32=0;
        let p:i32=0;
        let oktag:[]u8=" ok=";
        while(p<log.len){
            let nl:i32=find(log,p,nl1);
            if(nl<0){ nl=log.len; }
            if(nl-p>6 && is_probe(log,p)==1){
                let qi:i32=find(log,p,idtag);
                let pid:i64=-1;
                if(qi>=0 && qi<nl){ pid=parse_i64(log,qi+3); }
                let qv:i32=find(log,p,vtag);
                let vok:i32=find(log,p,oktag);
                let okv:i32=0;
                if(vok>=0 && vok<nl){ okv=(log[vok+4] as i32)-48; }
                let isf:i32=0;
                let f:i32=0;
                while(f<nf){ if(g32(fids,f*4)==pid){ isf=1; } f=f+1; }
                if(isf==0 && pid>=0 && qv>=0 && qv<nl){
                    nclean=nclean+1;
                    if(okv==1){ ncorr=ncorr+1; }
                    else {
                        let vs:i32=qv+8;
                        if(vs+6<=nl && is_value(log,vs)==1){ nwv=nwv+1; }
                        else { noth=noth+1; }
                    }
                }
            }
            p=nl+1;
        }
        pr("COUNT clean="); prn(nclean as i64);
        pr(" correct="); prn(ncorr as i64);
        pr(" wrongval="); prn(nwv as i64);
        pr(" other="); prn(noth as i64); prl("");
    } else {
        let tval:[]u8=nio_alloc(256);
        let f2:i32=0; while(f2<64){ p32(tval,f2*4,-1); f2=f2+1; }
        let i2:i32=0;
        while(i2<aux.len){
            if(is_dig(aux[i2])==1){
                let id:i64=parse_i64(aux,i2);
                while(i2<aux.len && aux[i2]!=9){ i2=i2+1; }
                i2=i2+1;
                let v:i64=parse_i64(aux,i2);
                if(id>=0 && id<64){ p32(tval,(id as i32)*4,v); }
                while(i2<aux.len && aux[i2]!=10){ i2=i2+1; }
            }
            i2=i2+1;
        }
        let ncorr:i32=0; let n:i32=0;
        let p2:i32=0;
        while(p2<log.len){
            let nl:i32=find(log,p2,nl1);
            if(nl<0){ nl=log.len; }
            if(nl-p2>6 && is_probe(log,p2)==1){
                let qi:i32=find(log,p2,idtag);
                let qv:i32=find(log,p2,vtag);
                if(qi>=0 && qi<nl && qv>=0 && qv<nl){
                    let pid:i64=parse_i64(log,qi+3);
                    let vs:i32=qv+8;
                    let exp:i64=-1;
                    if(pid>=0 && pid<64){ exp=g32(tval,(pid as i32)*4); }
                    n=n+1;
                    if(vs+6<=nl && is_value(log,vs)==1){
                        let got:i64=parse_i64(log,vs+6);
                        if(got==exp){ ncorr=ncorr+1; }
                    }
                }
            }
            p2=nl+1;
        }
        pr("COUNT n="); prn(n as i64); pr(" correct="); prn(ncorr as i64); prl("");
    }
    return 0;
}

// o_audit.zag — chunked append-only audit for the INT-1 organ modules
// (O2-O5). O1 reuses the store substrate's own audit.
// 16-word entries, 64 bytes each, organ tag in op-word high 16 bits
// (op word = (organ<<16)|opcode; readers mask the low 16 bits).
// Toolchain limit: no single slice may exceed 2^25 bytes, so entries live
// in lazily-allocated chunks of 65536 entries (4 MiB); at most 8 chunks
// (524288 entries). Fail-closed: append past cap returns 107 (AUDITFULL),
// the same value as the shared ledger's LG_AUDITFULL / ST_REFUSED_AUDITFULL.
// Integer-only. No randomness.
@import("cl/common.zag")

const OA_WORDS:i32=16;
const OA_ENTRY_BYTES:i32=64;
const OA_CHUNK_ENTRIES:i32=65536;
const OA_MAX_CHUNKS:i32=8;

const OA_OK:i32=0;
const OA_AUDITFULL:i32=107;

struct OAud {
    c0:[]u8,c1:[]u8,c2:[]u8,c3:[]u8,c4:[]u8,c5:[]u8,c6:[]u8,c7:[]u8,
    used:i32,
    n:i64,
    cap:i64,
    overflow:i32
}

fn oa_init(cap_entries:i64)OAud {
    let cap:i64=cap_entries;
    if(cap<1){cap=1;}
    if(cap>((OA_CHUNK_ENTRIES as i64)*(OA_MAX_CHUNKS as i64))){
        cap=(OA_CHUNK_ENTRIES as i64)*(OA_MAX_CHUNKS as i64);
    }
    return OAud{.c0="",.c1="",.c2="",.c3="",.c4="",.c5="",.c6="",.c7="",
        .used=0,.n=0,.cap=cap,.overflow=0};
}

fn oa_chunk(a:*OAud,k:i32)[]u8 {
    if(k==0){return a.*.c0;}
    if(k==1){return a.*.c1;}
    if(k==2){return a.*.c2;}
    if(k==3){return a.*.c3;}
    if(k==4){return a.*.c4;}
    if(k==5){return a.*.c5;}
    if(k==6){return a.*.c6;}
    return a.*.c7;
}
fn oa_chunk_set(a:*OAud,k:i32,b:[]u8)void {
    if(k==0){a.*.c0=b;}else{if(k==1){a.*.c1=b;}else{if(k==2){a.*.c2=b;}else{
    if(k==3){a.*.c3=b;}else{if(k==4){a.*.c4=b;}else{if(k==5){a.*.c5=b;}else{
    if(k==6){a.*.c6=b;}else{a.*.c7=b;}}}}}}}
}

fn oa_put32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn oa_get32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// opw: already organ-tagged ((organ<<16)|opcode).
// Word order: op,slot,rc,b1,b2,b3,b4,b5,a1,a2,a3,a4,a5,stage,d1,d2.
fn oa_append(a:*OAud,opw:i32,slot:i32,rc:i32,
             b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
             a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,
             stage:i32,d1:i32,d2:i32)i32 {
    if(a.*.n>=a.*.cap){a.*.overflow=1;return OA_AUDITFULL;}
    let ci:i32=(a.*.n/(OA_CHUNK_ENTRIES as i64)) as i32;
    let co:i32=((a.*.n%(OA_CHUNK_ENTRIES as i64)) as i32)*OA_ENTRY_BYTES;
    let c:[]u8=oa_chunk(a,ci);
    if(c.len==0){
        c=nio_alloc(OA_CHUNK_ENTRIES*OA_ENTRY_BYTES);
        let z:i32=0;
        while(z<OA_CHUNK_ENTRIES*OA_ENTRY_BYTES){c[z]=0;z=z+1;}
        oa_chunk_set(a,ci,c);
        if(ci>=a.*.used){a.*.used=ci+1;}
    }
    oa_put32(c,co+0,opw);oa_put32(c,co+4,slot);oa_put32(c,co+8,rc);
    oa_put32(c,co+12,b1);oa_put32(c,co+16,b2);oa_put32(c,co+20,b3);
    oa_put32(c,co+24,b4);oa_put32(c,co+28,b5);
    oa_put32(c,co+32,a1);oa_put32(c,co+36,a2);oa_put32(c,co+40,a3);
    oa_put32(c,co+44,a4);oa_put32(c,co+48,a5);
    oa_put32(c,co+52,stage);
    oa_put32(c,co+56,d1);oa_put32(c,co+60,d2);
    a.*.n=a.*.n+1;
    return OA_OK;
}

// Read word w (0..15) of entry idx. Caller bounds idx < a.n.
fn oa_get(a:*OAud,idx:i64,w:i32)i32 {
    let ci:i32=(idx/(OA_CHUNK_ENTRIES as i64)) as i32;
    let co:i32=((idx%(OA_CHUNK_ENTRIES as i64)) as i32)*OA_ENTRY_BYTES;
    let c:[]u8=oa_chunk(a,ci);
    return oa_get32(c,co+w*4);
}

// Organ-tagged op constructor + low-16-bit mask helper.
fn oa_opw(organ:i32,op:i32)i32 {
    return (organ<<16)|(op & 65535);
}
fn oa_opcode(opw:i32)i32 {
    return opw & 65535;
}

// curriculum.zag — the developmental curriculum driver.
// Per-stage episode budgets are PARAMETERIZED in StageConfig (scalable, never
// hardcoded per Micah's scaling law). Genuine constants (bars, gates,
// formulas, falsification criteria) stay frozen below as consts.
// PROVISIONAL SIZING: pilot multiplicands exist only for DC-1
// (PILOT_RESULTS.md: S1 64+24). DC-0/2/3/4/5 values below are the integrator's
// provisional numbers from CURRICULUM.md scale-test dimensions, documented in
// CURRICULUM_NOTES.md — they need Micah's dated amendment before the verdict
// is official. The amendment only changes numbers in curric_stage_config;
// the structure never changes.

// Frozen genuine constants (bars, gates, falsification criteria)
const CU_BAR_JUSTIFIED:i32=95;      // DC-0: >=95% of deliberate ops justified
const CU_BAR_COMPOSITES:i32=75;     // DC-2: >=75% of novel composites verified+committed
const CU_NOVEL_MIN:i32=12;          // DC-2: >=12 novel composites
const CU_NEGCTL_MIN:i32=2;          // DC-2: >=2 unverifiable composites rolled back
const CU_L2_WINDOW:i32=10;          // L2: CONFIRM evaluated for CONSOLIDATE within 10 eps
const CU_PIN_EXPIRY:i32=50;         // amendment B: serving-trace pin expiry (episodes)
const CU_PIN_ALARM:i32=80;          // amendment B: pin-fraction alarm (%)
const CU_R_CONST:i32=50;            // amendment D: R frozen constant, outside O5 governance
const CU_COOLDOWN_SEG:i32=3;        // P6: same-param re-commit cooldown (segments)
const CU_DROP_CEIL:i32=0;           // P2 drop-ceiling tripwire: any drop over ceiling kills the arm
                                    // (ceiling value set by the strength trial prereg; armed = checked)

// Stage ids
const CU_DC0:i32=0;
const CU_DC1:i32=1;
const CU_DC2:i32=2;
const CU_DC3:i32=3;
const CU_DC4:i32=4;
const CU_DC5:i32=5;

// Autonomy levels matched to progressive organ activation
const CU_AUT_NONE:i32=0;
const CU_AUT_ADD:i32=1;
const CU_AUT_MANAGE:i32=2;
const CU_AUT_KILL:i32=3;
const CU_AUT_FULL:i32=4;

struct StageConfig {
    stage:i32,
    scale:i32,        // 10 or 100 (S10 / S100 legs)
    eps_main:i32,     // main-phase episodes
    eps_settle:i32,   // settle-phase episodes
    slots:i32,        // O1 slot budget
    ledger_cap:i32,   // per-stage glue-ledger entry budget (sizing check)
    probes:i32,       // DC-4 probe budget
    traces:i32,       // DC-2 trace target
    revisions:i32,    // DC-3 sequential revision target
    hypotheses:i32,   // DC-4 hypothesis width
    autonomy:i32,     // stage's autonomy ceiling
    organs:i32,       // bitmask of active organs: bit0=O1 bit1=O2 bit2=O3 bit3=O4 bit4=O5
    teacher:i32       // 1 = teacher withdrawn (DC-5), 0 = teacher present
}

// curric_stage_config(stage, scale) — the ONLY place stage budgets live.
// scale: 10 (S10) or 100 (S100). Values marked PROVISIONAL are pending
// Micah's dated amendment (see CURRICULUM_NOTES.md).
fn curric_stage_config(stage:i32,scale:i32)StageConfig {
    let m:i32=scale;
    if(stage==CU_DC0){
        // PROVISIONAL (CURRICULUM.md S10 dims): 8 slots and 64 ledger entries
        // per unit scale -> 80 slots, 640-entry budget at S10.
        return StageConfig{.stage=0,.scale=m,.eps_main=64*m,.eps_settle=16*m,
            .slots=8*m,.ledger_cap=64*m,.probes=0,.traces=0,.revisions=0,
            .hypotheses=0,.autonomy=CU_AUT_ADD,.organs=1,.teacher=0};
    }
    if(stage==CU_DC1){
        // PILOT-ANCHORED: S1 64+24 (PILOT_RESULTS.md); DC-1-S4 256+56 consistent
        return StageConfig{.stage=1,.scale=m,.eps_main=64*m,.eps_settle=24*m,
            .slots=64,.ledger_cap=2048*m,.probes=0,.traces=0,.revisions=0,
            .hypotheses=0,.autonomy=CU_AUT_MANAGE,.organs=3,.teacher=0};
    }
    if(stage==CU_DC2){
        // PROVISIONAL: 40 traces at 10x (CURRICULUM.md DC-2-S10)
        return StageConfig{.stage=2,.scale=m,.eps_main=120*m,.eps_settle=24*m,
            .slots=128,.ledger_cap=4096*m,.probes=0,.traces=4*m,.revisions=0,
            .hypotheses=0,.autonomy=CU_AUT_MANAGE,.organs=11,.teacher=0};
    }
    if(stage==CU_DC3){
        // PROVISIONAL: 10 sequential revisions at 10x (CURRICULUM.md DC-3-S10)
        return StageConfig{.stage=3,.scale=m,.eps_main=200*m,.eps_settle=40*m,
            .slots=128,.ledger_cap=4096*m,.probes=0,.traces=0,.revisions=1*m,
            .hypotheses=0,.autonomy=CU_AUT_KILL,.organs=27,.teacher=0};
    }
    if(stage==CU_DC4){
        // PROVISIONAL: 160-probe budget, 20-way hypotheses at 10x (CURRICULUM.md DC-4-S10)
        return StageConfig{.stage=4,.scale=m,.eps_main=160*m,.eps_settle=40*m,
            .slots=256,.ledger_cap=8192*m,.probes=16*m,.traces=0,.revisions=0,
            .hypotheses=2*m,.autonomy=CU_AUT_KILL,.organs=31,.teacher=0};
    }
    // DC-5: PROVISIONAL: 10x silent episodes, 10 world changes (CURRICULUM.md DC-5-S10)
    return StageConfig{.stage=5,.scale=m,.eps_main=100*m,.eps_settle=40*m,
        .slots=256,.ledger_cap=8192*m,.probes=0,.traces=0,.revisions=0,
        .hypotheses=0,.autonomy=CU_AUT_FULL,.organs=31,.teacher=1};
}

// Stage exit-gate ids (prereg section 3)
const CU_GATE_DC0:i32=0;
const CU_GATE_DC1:i32=1;
const CU_GATE_DC2:i32=2;
const CU_GATE_DC3:i32=3;
const CU_GATE_DC4:i32=4;
const CU_GATE_DC5:i32=5;

// Table-killer clause ids (void the stage, not the organ)
const CU_TK_RNG:i32=1;
const CU_TK_REGRESSION:i32=2;
const CU_TK_LEDGER:i32=3;

// curric_total_eps(stage, scale): total episode budget for sizing math.
fn curric_total_eps(stage:i32,scale:i32)i64 {
    let c:StageConfig=curric_stage_config(stage,scale);
    return (c.eps_main+c.eps_settle) as i64;
}

// curric_all_total_eps(scale): sum over all six stages (for 100x ledger sizing).
fn curric_all_total_eps(scale:i32)i64 {
    let t:i64=0;let s:i32=0;
    while(s<6){t=t+curric_total_eps(s,scale);s=s+1;}
    return t;
}

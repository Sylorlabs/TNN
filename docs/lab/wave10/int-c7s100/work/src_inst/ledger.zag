// ledger.zag — the single shared organ-tagged append-only audit ledger.
// 16-word entries (64 bytes): op@0, slot@4, rc@8, b1..b5@12..28,
// a1..a5@32..48, stage@52, d1@56, d2@60 (all i32 LE; i64 args truncated to
// low 32 bits — d1 carries a flags word, d2 the episode number, both fit).
// Organ tag rides in the HIGH 16 bits of the op word: op = organ<<16 | opcode.
// Sized for 100x from day one (AMENDMENT_2026-09-20 section A.3).
// HARD LIMIT: no single slice > 2^25 bytes (33,554,432) — entries are stored
// in chunked []u8 buffers of exactly 33,554,432 bytes = 524,288 entries each
// (build note in GLUE_NOTES.md). Fail-close on cap: lg_append returns 107
// (LG_AUDITFULL), which is deliberately OUTSIDE the policy-refusal bands
// (101-106, 120-127, 201-204, 301-303) so P10 can distinguish fail-close
// from policy refusals.
@import("substrate/cl/common.zag")

const LG_OK:i32=0;
const LG_AUDITFULL:i32=107; // == ST_REFUSED_AUDITFULL value; distinct band from policy refusals
const LG_CORRUPT:i32=2005;

// Organ tags (high 16 bits of op word)
const LG_O1:i32=1;
const LG_O2:i32=2;
const LG_O3:i32=3;
const LG_O4:i32=4;
const LG_O5:i32=5;
const LG_GLUE:i32=6;

// Glue-namespace op codes (low 16 bits; organ ops keep their own low-16 codes)
const LG_OP_SEAL:i32=100;
const LG_OP_CORROBORATE:i32=101;   // defended-channel corroboration telemetry
const LG_OP_RECOMMIT_REQ:i32=102;  // defended-channel re-COMMIT request event
const LG_OP_ABSTAIN:i32=103;
const LG_OP_HYP_OPEN:i32=104;
const LG_OP_VERDICT:i32=105;
const LG_OP_CONSOLIDATE:i32=106;
const LG_OP_COMPOSE:i32=107;
const LG_OP_PROPOSE:i32=108;
const LG_OP_COMMIT:i32=109;
const LG_OP_REFUSE:i32=110;
const LG_OP_ANCHOR:i32=111;        // stage-entry anchor snapshot entry
const LG_OP_PIN:i32=112;
const LG_OP_PREEMPT:i32=113;
const LG_OP_UNCOMMIT:i32=114;
const LG_OP_REVERIFY:i32=115;      // O5 grandfathering / re-verification action (P2)
const LG_OP_APPLY:i32=116;        // O4 comp_apply (P4 race window)
const LG_OP_NEED:i32=117;         // O4 need declaration (audit completeness)
const LG_OP_SCAN:i32=118;         // O4 selection scan (audit completeness)
const LG_OP_OBSERVE:i32=119;      // O2 observation (audit completeness)
const LG_OP_ROLLBACK:i32=120;     // O5 rollback (audit completeness)
// Note: LG_OP_PIN=112 is superseded; O1 pins are ledgered as (LG_O1,3) to
// match the P3 probe's hardcoded (LG_O1,3) selector.

// d1 flags word bits
const LG_F_JUSTIFIED:i32=1;
const LG_F_BITE:i32=2;      // synthetic bite-check entry (excluded from official tallies)
const LG_F_CONTROL:i32=4;   // control-arm entry

// Field offsets (bytes)
const LG_OF_OP:i32=0;
const LG_OF_SLOT:i32=4;
const LG_OF_RC:i32=8;
const LG_OF_STAGE:i32=52;
const LG_OF_D1:i32=56;
const LG_OF_D2:i32=60;

// Sizing (genuine constants; math in GLUE_NOTES.md)
const LG_BYTES_PER_ENTRY:i32=64;
const LG_CHUNK_BYTES:i32=33554432;          // 2^25 — toolchain max single slice
const LG_CHUNK_ENTRIES:i32=524288;          // 33554432 / 64
const LG_MAX_CHUNKS:i32=16;
const LG_LEDGER_ENTRIES_MAX:i64=8388608;    // 16 * 524288 (~512 MiB logical, chunks allocated on demand)
const LG_SEG_EPS:i32=220;                   // fixed episode count per sealed segment
// Grounded six-namespace design budget (measured S10, calibration stubs):
// worst observed 5.09 entries/episode TOTAL across all six namespaces
// (DC-4/DC-5, all organs); design 4 entries/episode/namespace = ~4.7x headroom.
const LG_DESIGN_RATE_PER_NS:i32=4;          // entries/episode/namespace (design)
const LG_NS_SEG_BUDGET:i32=880;             // LG_SEG_EPS * 4: per-namespace segment budget
const LG_NS_WARN_AT:i32=704;                // 80% of per-namespace budget (P10 WARN)
// S100 planning: 89200 eps * 6 entries/ep = 535200 entries;
// 8388608 / 535200 = 15.7x headroom over planning, 18.5x over measured worst.
const LG_SEAL_CAP:i32=4096;                 // max sealed segments per run

struct LgLedger {
    ch0:[]u8,ch1:[]u8,ch2:[]u8,ch3:[]u8,ch4:[]u8,ch5:[]u8,ch6:[]u8,ch7:[]u8,
    ch8:[]u8,ch9:[]u8,ch10:[]u8,ch11:[]u8,ch12:[]u8,ch13:[]u8,ch14:[]u8,ch15:[]u8,
    chunks_used:i32,
    entries_total:i64,
    seg_d:[]u8,          // 32-byte running digest of the open segment
    seg_entries:i64,
    seg_idx:i32,
    seg_start:i64,       // entry index where the open segment began
    sealed:[]u8,        // folded digests of sealed segments (8 bytes each)
    sealed_start:[]u8,  // entry index where each sealed segment began (8 bytes)
    sealed_len:[]u8,    // entry count of each sealed segment (8 bytes)
    e1:i64,e2:i64,e3:i64,e4:i64,e5:i64,e6:i64,  // per-organ entry counts (e6 = glue)
    episodes:i64,
    audit_full:i32
}

fn lg_init()LgLedger {
    // seg_d IV is all zeros: the digest chain must be deterministic from the
    // first entry. (An uninitialized IV made paired reruns diverge.)
    let sd:[]u8=nio_alloc(32);
    let z:i32=0;while(z<32){sd[z]=0;z=z+1;}
    let l:LgLedger=LgLedger{
        .ch0="",.ch1="",.ch2="",.ch3="",.ch4="",.ch5="",.ch6="",.ch7="",
        .ch8="",.ch9="",.ch10="",.ch11="",.ch12="",.ch13="",.ch14="",.ch15="",
        .chunks_used=0,.entries_total=0,
        .seg_d=sd,.seg_entries=0,.seg_idx=0,.seg_start=0,
        .sealed=nio_alloc(LG_SEAL_CAP*8),.sealed_start=nio_alloc(LG_SEAL_CAP*8),.sealed_len=nio_alloc(LG_SEAL_CAP*8),
        .e1=0,.e2=0,.e3=0,.e4=0,.e5=0,.e6=0,.episodes=0,.audit_full=0};
    return l;
}

fn lg_chunk(l:*LgLedger,k:i32)[]u8 {
    if(k==0){return l.*.ch0;}if(k==1){return l.*.ch1;}
    if(k==2){return l.*.ch2;}if(k==3){return l.*.ch3;}
    if(k==4){return l.*.ch4;}if(k==5){return l.*.ch5;}
    if(k==6){return l.*.ch6;}if(k==7){return l.*.ch7;}
    if(k==8){return l.*.ch8;}if(k==9){return l.*.ch9;}
    if(k==10){return l.*.ch10;}if(k==11){return l.*.ch11;}
    if(k==12){return l.*.ch12;}if(k==13){return l.*.ch13;}
    if(k==14){return l.*.ch14;}return l.*.ch15;
}
fn lg_chunk_set(l:*LgLedger,k:i32,b:[]u8)void {
    if(k==0){l.*.ch0=b;return;}
    if(k==1){l.*.ch1=b;return;}
    if(k==2){l.*.ch2=b;return;}
    if(k==3){l.*.ch3=b;return;}
    if(k==4){l.*.ch4=b;return;}
    if(k==5){l.*.ch5=b;return;}
    if(k==6){l.*.ch6=b;return;}
    if(k==7){l.*.ch7=b;return;}
    if(k==8){l.*.ch8=b;return;}
    if(k==9){l.*.ch9=b;return;}
    if(k==10){l.*.ch10=b;return;}
    if(k==11){l.*.ch11=b;return;}
    if(k==12){l.*.ch12=b;return;}
    if(k==13){l.*.ch13=b;return;}
    if(k==14){l.*.ch14=b;return;}
    l.*.ch15=b;
}
fn lg_organ_add(l:*LgLedger,organ:i32)void {
    if(organ==1){l.*.e1=l.*.e1+1;return;}
    if(organ==2){l.*.e2=l.*.e2+1;return;}
    if(organ==3){l.*.e3=l.*.e3+1;return;}
    if(organ==4){l.*.e4=l.*.e4+1;return;}
    if(organ==5){l.*.e5=l.*.e5+1;return;}
    l.*.e6=l.*.e6+1;
}
fn lg_organ_count(l:*LgLedger,organ:i32)i64 {
    if(organ==1){return l.*.e1;}if(organ==2){return l.*.e2;}
    if(organ==3){return l.*.e3;}if(organ==4){return l.*.e4;}
    if(organ==5){return l.*.e5;}return l.*.e6;
}
// Count of an organ's entries carrying the JUSTIFIED flag (d1 bit).
fn lg_organ_justified(l:*LgLedger,organ:i32)i64 {
    let n:i64=0;
    let k:i64=0;
    while(k<l.*.entries_total){
        let opw:i64=lg_getfield(l,k,LG_OF_OP);
        if(((opw>>16) & 65535)==(organ as i64)){
            if((lg_getfield(l,k,LG_OF_D1) & LG_F_JUSTIFIED)!=0){n=n+1;}
        }
        k=k+1;
    }
    return n;
}

// op word constructor: organ tag in high 16 bits
fn lg_opw(organ:i32,op:i32)i64 {
    return ((organ as i64)<<16)+((op as i64) & 65535);
}
fn lg_put32(b:[]u8,at:i32,v:i64)void {
    let i:i32=0;while(i<4){b[at+i]=((v>>(i*8)) & 255) as u8;i=i+1;}
}
fn lg_get32(b:[]u8,at:i32)i64 {
    let r:i64=(b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
    if(r>=2147483648){r=r-4294967296;}return r;
}
fn lg_fold(d:[]u8)i64 {
    // fold 32-byte digest to one i64: xor of 4 LE u64 words
    let f:i64=0;let w:i32=0;
    while(w<4){let v:i64=0;let i:i32=0;while(i<8){v=v+((d[w*8+i] as i64)<<(i*8));i=i+1;}f=f^v;w=w+1;}
    return f;
}
fn lg_getfield(l:*LgLedger,idx:i64,off:i32)i64 {
    let ci:i32=(idx/LG_CHUNK_ENTRIES as i64) as i32;
    let co:i32=((idx%LG_CHUNK_ENTRIES)*64) as i32;
    let c:[]u8=lg_chunk(l,ci);
    return lg_get32(c,co+off);
}
fn lg_entry_bytes(l:*LgLedger,idx:i64,out:[]u8)void {
    let ci:i32=(idx/LG_CHUNK_ENTRIES as i64) as i32;
    let co:i32=((idx%LG_CHUNK_ENTRIES)*64) as i32;
    let c:[]u8=lg_chunk(l,ci);
    let i:i32=0;while(i<64){out[i]=c[co+i];i=i+1;}
}

// Append one entry. Fail-close: returns LG_AUDITFULL (107) when the 100x
// budget is exhausted; the stage must void (P10 table-killer), never wrap.
fn lg_append(l:*LgLedger,organ:i32,op:i32,slot:i32,rc:i32,b1:i64,b2:i64,b3:i64,b4:i64,b5:i64,a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,stage:i32,d1:i64,d2:i64)i32 {
    if(l.*.audit_full==1){return LG_AUDITFULL;}
    if(l.*.entries_total>=LG_LEDGER_ENTRIES_MAX){l.*.audit_full=1;return LG_AUDITFULL;}
    let idx:i64=l.*.entries_total;
    let ci:i32=(idx/LG_CHUNK_ENTRIES as i64) as i32;
    if(ci>=LG_MAX_CHUNKS){l.*.audit_full=1;return LG_AUDITFULL;}
    let c:[]u8=lg_chunk(l,ci);
    if(c.len==0){
        c=nio_alloc(LG_CHUNK_BYTES);
        if(c.len!=LG_CHUNK_BYTES){l.*.audit_full=1;return LG_AUDITFULL;}
        lg_chunk_set(l,ci,c);
        l.*.chunks_used=l.*.chunks_used+1;
    }
    let co:i32=((idx%LG_CHUNK_ENTRIES)*64) as i32;
    let opw:i64=((organ as i64)<<16)+((op as i64) & 65535);
    lg_put32(c,co+LG_OF_OP,opw);
    lg_put32(c,co+LG_OF_SLOT,slot as i64);
    lg_put32(c,co+LG_OF_RC,rc as i64);
    lg_put32(c,co+12,b1);lg_put32(c,co+16,b2);lg_put32(c,co+20,b3);
    lg_put32(c,co+24,b4);lg_put32(c,co+28,b5);
    lg_put32(c,co+32,a1);lg_put32(c,co+36,a2);lg_put32(c,co+40,a3);
    lg_put32(c,co+44,a4);lg_put32(c,co+48,a5);
    lg_put32(c,co+LG_OF_STAGE,stage as i64);
    lg_put32(c,co+LG_OF_D1,d1);lg_put32(c,co+LG_OF_D2,d2);
    // running segment digest: seg_d = sha256(seg_d || entry)
    let eb:[]u8=nio_alloc(64);lg_entry_bytes(l,idx,eb);
    let sd:[]u8=l.*.seg_d;
    let tmp:[]u8=nio_alloc(96);
    let i:i32=0;while(i<32){tmp[i]=sd[i];i=i+1;}
    i=0;while(i<64){tmp[32+i]=eb[i];i=i+1;}
    let nd:[]u8=nio_alloc(32);
    let hr:i32=ns_sha256(tmp,nd);
    nio_free(tmp);nio_free(eb);
    if(hr!=0){nio_free(nd);l.*.audit_full=1;return LG_CORRUPT;}
    nio_free(l.*.seg_d);l.*.seg_d=nd;
    lg_organ_add(l,organ);
    l.*.entries_total=l.*.entries_total+1;
    l.*.seg_entries=l.*.seg_entries+1;
    return LG_OK;
}

fn lg_note_episode(l:*LgLedger)i32 {
    l.*.episodes=l.*.episodes+1;
    return LG_OK;
}

// Seal the current segment (fixed LG_SEG_EPS episodes per segment is enforced
// by the caller). Returns the folded seal digest; chains it into seg_d.
fn lg_seal_segment(l:*LgLedger)i64 {
    let f:i64=lg_fold(l.*.seg_d);
    if(l.*.seg_idx<LG_SEAL_CAP){
        let sb:[]u8=l.*.sealed;
        lg_put32(sb,l.*.seg_idx*8,f & 4294967295);
        lg_put32(sb,l.*.seg_idx*8+4,(f>>32) & 4294967295);
        let ss:[]u8=l.*.sealed_start;
        let st:i64=l.*.seg_start;
        lg_put32(ss,l.*.seg_idx*8,st & 4294967295);
        lg_put32(ss,l.*.seg_idx*8+4,(st>>32) & 4294967295);
        let sl:[]u8=l.*.sealed_len;
        let ln:i64=l.*.seg_entries;
        lg_put32(sl,l.*.seg_idx*8,ln & 4294967295);
        lg_put32(sl,l.*.seg_idx*8+4,(ln>>32) & 4294967295);
    }
    l.*.seg_idx=l.*.seg_idx+1;
    l.*.seg_start=l.*.entries_total;
    l.*.seg_entries=0;
    // chain: seg_d = sha256(seg_d)
    let nd:[]u8=nio_alloc(32);
    if(ns_sha256(l.*.seg_d,nd)!=0){nio_free(nd);l.*.audit_full=1;return -1;}
    nio_free(l.*.seg_d);l.*.seg_d=nd;
    return f;
}

// unsigned 64-bit LE access (for sealed-digest / segment-range tables)
fn lg_get64(b:[]u8,at:i32)i64 {
    let lo:i64=lg_get32(b,at) & 4294967295;
    let hi:i64=lg_get32(b,at+4) & 4294967295;
    return lo+(hi<<32);
}

// Recompute every sealed segment's digest from raw entries, threading the
// chain exactly as lg_append/lg_seal_segment do (segment s starts from
// chain_s, chain_0 = zeros, chain_{s+1} = sha256(D_s)); then the open
// segment from the current chain. Returns 0 iff the ledger reproduces
// exactly — entry continuity, seal folds, and chain all verified.
fn lg_replay_check(l:*LgLedger)i32 {
    if(l.*.audit_full==1){return 1;}
    let eb:[]u8=nio_alloc(64);
    let chain:[]u8=nio_alloc(32);
    let s:i32=0;
    while(s<l.*.seg_idx){
        let ss:[]u8=l.*.sealed_start;
        let st:i64=lg_get64(ss,s*8);
        let sl:[]u8=l.*.sealed_len;
        let ln:i64=lg_get64(sl,s*8);
        let rd:[]u8=nio_alloc(32);
        let i:i32=0;while(i<32){rd[i]=chain[i];i=i+1;}
        let k:i64=0;
        while(k<ln){
            lg_entry_bytes(l,st+k,eb);
            let tmp:[]u8=nio_alloc(96);
            i=0;while(i<32){tmp[i]=rd[i];i=i+1;}
            i=0;while(i<64){tmp[32+i]=eb[i];i=i+1;}
            let nd:[]u8=nio_alloc(32);
            if(ns_sha256(tmp,nd)!=0){nio_free(tmp);nio_free(nd);nio_free(rd);nio_free(chain);nio_free(eb);return 2;}
            nio_free(tmp);nio_free(rd);rd=nd;
            k=k+1;
        }
        let sb:[]u8=l.*.sealed;
        let rec:i64=lg_get64(sb,s*8);
        if(lg_fold(rd)!=rec){nio_free(rd);nio_free(chain);nio_free(eb);return 3;}
        let nd2:[]u8=nio_alloc(32);
        if(ns_sha256(rd,nd2)!=0){nio_free(nd2);nio_free(rd);nio_free(chain);nio_free(eb);return 4;}
        nio_free(chain);nio_free(rd);chain=nd2;
        s=s+1;
    }
    // open segment from the live chain value
    let rd2:[]u8=nio_alloc(32);
    let j:i32=0;while(j<32){rd2[j]=chain[j];j=j+1;}
    let k2:i64=l.*.seg_start;
    while(k2<l.*.entries_total){
        lg_entry_bytes(l,k2,eb);
        let tmp:[]u8=nio_alloc(96);
        j=0;while(j<32){tmp[j]=rd2[j];j=j+1;}
        j=0;while(j<64){tmp[32+j]=eb[j];j=j+1;}
        let nd:[]u8=nio_alloc(32);
        if(ns_sha256(tmp,nd)!=0){nio_free(tmp);nio_free(nd);nio_free(rd2);nio_free(chain);nio_free(eb);return 5;}
        nio_free(tmp);nio_free(rd2);rd2=nd;
        k2=k2+1;
    }
    let ok:i32=nio_equal(rd2,l.*.seg_d);
    nio_free(rd2);nio_free(chain);nio_free(eb);
    if(ok!=1){return 6;}
    return 0;
}

// Measured audit-entry rate per 1000 episodes for one organ — the SOLE
// validator of 100x sizing before S100 compute is burned (amendment A.3).
fn lg_entry_rate(l:*LgLedger,organ:i32)i64 {
    if(l.*.episodes<1){return 0;}
    return lg_organ_count(l,organ)*1000/l.*.episodes;
}

// Count entries matching (organ, low-16 op). Read-only scan primitive.
fn lg_count_op(l:*LgLedger,organ:i32,op:i32)i64 {
    let n:i64=0;let i:i64=0;
    while(i<l.*.entries_total){
        let opw:i64=lg_getfield(l,i,LG_OF_OP);
        let og:i32=((opw>>16) & 65535) as i32;
        let oc:i32=(opw & 65535) as i32;
        if(og==organ && oc==op){n=n+1;}
        i=i+1;
    }
    return n;
}
// Count entries matching (organ, low-16 op, rc).
fn lg_count_op_rc(l:*LgLedger,organ:i32,op:i32,rc:i32)i64 {
    let n:i64=0;let i:i64=0;
    while(i<l.*.entries_total){
        let opw:i64=lg_getfield(l,i,LG_OF_OP);
        let og:i32=((opw>>16) & 65535) as i32;
        let oc:i32=(opw & 65535) as i32;
        if(og==organ && oc==op && lg_getfield(l,i,LG_OF_RC)==(rc as i64)){n=n+1;}
        i=i+1;
    }
    return n;
}

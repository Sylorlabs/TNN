// integrity-ledger core — lie/cheat detection over an append-only ledger.
// Native Zag, zero RNG, no tables, no accumulators, no RL.
// See PREREG.md (rules, verdict codes) and DESIGN.md (why).
// Storage idiom: i32s packed little-endian into []u8 (playbook §12:
// no []i32 allocator observed). Provenance "unused" marker = -1.
@import("substrate/cl/common.zag")

// PER-LEG PARAMETER (RC3, prereg 2026-09-20, overnight-agentic authority,
// flagged for Micah's retroactive review): 128 -> 10240. Capacity only,
// verdict-neutral; the cap never binds in a correct run. Sizing: IL entries
// measured at the 10x leg (800 by construction, bounded by the 1024-cap
// RC2 run passing) x 10 = 8000, +28% margin = 10240 (same margin factor as
// RC2's 1024/800). This file is otherwise VERBATIM
// wave4/integrity-ledger/il_core.zag. The canonical file is untouched.
const IL_CAP:i32=10240;     // max ledger entries (per-leg parameter)
const IL_WORDS:i32=8;       // op,item,val,p0,p1,p2,p3,clock
const IL_MAXPROV:i32=4;

// Ops (the system's evidence/claim action set)
const IL_OP_OBSERVE:i32=1;  // recorded raw evidence (provisional)
const IL_OP_REFUTE:i32=2;   // recorded refutation of (item,val) (provisional)
const IL_OP_HYP:i32=3;      // deliberate hypothesis (provisional judgment)
const IL_OP_VERIFY:i32=4;   // verification pass: COMMITS belief (item,val)
const IL_OP_CLAIM:i32=5;    // stated claim with cited provenance
const IL_OP_REFUSED:i32=6;  // recorded refusal (audit-only, not evidence)

// Verdicts
const IL_OK:i32=0;
const IL_LIE_CITED:i32=101;
const IL_LIE_COMMITTED:i32=102;
const IL_CHEAT_EMPTY:i32=103;
const IL_CHEAT_TRIVIAL:i32=104;
const IL_CHEAT_PHANTOM:i32=105;
const IL_CHEAT_NOSHAPE:i32=106;
const IL_AUDIT_FULL:i32=-1; // append refused: ledger full (explicit, never silent)

struct IlLedger {
    mem: []u8,   // IL_CAP * IL_WORDS i32s packed; -1 marks unused prov slots
    head: i32,   // next free entry index (append-only; never decremented)
    clock: i32,  // monotonic op counter
}

fn il_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn il_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

fn il_init()IlLedger {
    let mem:[]u8=nio_alloc(IL_CAP*IL_WORDS*4);
    let i:i32=0;
    // nio_alloc is NOT zeroed — mark every word -1 by hand (unused prov slots).
    while(i<IL_CAP*IL_WORDS){il_i32_set(mem,i*4,-1);i=i+1;}
    return IlLedger{.mem=mem,.head=0,.clock=0};
}

// Append-only write. There is deliberately NO rewrite/delete/clear op:
// append-only is enforced by the absence of machinery.
fn il_append(s:*IlLedger,op:i32,item:i32,val:i32,p0:i32,p1:i32,p2:i32,p3:i32)i32 {
    if(s.*.head>=IL_CAP){return IL_AUDIT_FULL;}
    let b:i32=s.*.head*IL_WORDS*4;
    let m:[]u8=s.*.mem;
    il_i32_set(m,b,op);il_i32_set(m,b+4,item);il_i32_set(m,b+8,val);
    il_i32_set(m,b+12,p0);il_i32_set(m,b+16,p1);il_i32_set(m,b+20,p2);il_i32_set(m,b+24,p3);
    il_i32_set(m,b+28,s.*.clock);
    s.*.clock=s.*.clock+1;
    let idx:i32=s.*.head;
    s.*.head=s.*.head+1;
    return idx;
}

fn il_observe(s:*IlLedger,item:i32,val:i32)i32 {
    return il_append(s,IL_OP_OBSERVE,item,val,-1,-1,-1,-1);
}
fn il_refute(s:*IlLedger,item:i32,val:i32)i32 {
    return il_append(s,IL_OP_REFUTE,item,val,-1,-1,-1,-1);
}
fn il_hyp(s:*IlLedger,item:i32,val:i32)i32 {
    return il_append(s,IL_OP_HYP,item,val,-1,-1,-1,-1);
}
fn il_verify(s:*IlLedger,item:i32,val:i32)i32 {
    return il_append(s,IL_OP_VERIFY,item,val,-1,-1,-1,-1);
}
fn il_claim(s:*IlLedger,item:i32,val:i32,p0:i32,p1:i32,p2:i32,p3:i32)i32 {
    return il_append(s,IL_OP_CLAIM,item,val,p0,p1,p2,p3);
}
fn il_refused(s:*IlLedger,item:i32,val:i32)i32 {
    return il_append(s,IL_OP_REFUSED,item,val,-1,-1,-1,-1);
}

fn il_entry_op(s:*IlLedger,idx:i32)i32 { return il_i32_get(s.*.mem,idx*IL_WORDS*4); }
fn il_entry_item(s:*IlLedger,idx:i32)i32 { return il_i32_get(s.*.mem,idx*IL_WORDS*4+4); }
fn il_entry_val(s:*IlLedger,idx:i32)i32 { return il_i32_get(s.*.mem,idx*IL_WORDS*4+8); }
fn il_entry_prov(s:*IlLedger,idx:i32,k:i32)i32 { return il_i32_get(s.*.mem,idx*IL_WORDS*4+12+k*4); }

fn il_is_evidence_grade(op:i32)i32 {
    if(op==IL_OP_OBSERVE){return 1;}
    if(op==IL_OP_REFUTE){return 1;}
    if(op==IL_OP_HYP){return 1;}
    if(op==IL_OP_VERIFY){return 1;}
    return 0;
}

// Latest VERIFY entry for item with index < before_idx. -1 if none.
fn il_latest_verify(s:*IlLedger,item:i32,before_idx:i32)i32 {
    let i:i32=before_idx-1;
    while(i>=0){
        if(il_entry_op(s,i)==IL_OP_VERIFY && il_entry_item(s,i)==item){return i;}
        i=i-1;
    }
    return -1;
}

// Is obs_idx's contradictory observation superseded before claim_idx?
// Supersession = a REFUTE of the observed value, or a VERIFY of the
// claimed value, strictly between obs_idx and claim_idx.
fn il_obs_superseded(s:*IlLedger,obs_idx:i32,obs_val:i32,item:i32,claim_val:i32,claim_idx:i32)i32 {
    let i:i32=obs_idx+1;
    while(i<claim_idx){
        let op:i32=il_entry_op(s,i);
        if(op==IL_OP_REFUTE && il_entry_item(s,i)==item && il_entry_val(s,i)==obs_val){return 1;}
        if(op==IL_OP_VERIFY && il_entry_item(s,i)==item && il_entry_val(s,i)==claim_val){return 1;}
        i=i+1;
    }
    return 0;
}

// The checker. Returns a verdict code; never the truth (it has no oracle).
fn il_check(s:*IlLedger,claim_idx:i32)i32 {
    let item:i32=il_entry_item(s,claim_idx);
    let cval:i32=il_entry_val(s,claim_idx);
    // Rule 1: empty provenance.
    let nprov:i32=0;
    let k:i32=0;
    while(k<IL_MAXPROV){if(il_entry_prov(s,claim_idx,k)>=0){nprov=nprov+1;}k=k+1;}
    if(nprov==0){return IL_CHEAT_EMPTY;}
    // Rule 2: phantom citations. Rule 3: non-evidence citations.
    k=0;
    while(k<IL_MAXPROV){
        let p:i32=il_entry_prov(s,claim_idx,k);
        if(p>=0){
            if(p>=s.*.head){return IL_CHEAT_PHANTOM;}
            if(il_is_evidence_grade(il_entry_op(s,p))==0){return IL_CHEAT_TRIVIAL;}
        }
        k=k+1;
    }
    // Rule 4: contradiction against cited entries.
    k=0;
    while(k<IL_MAXPROV){
        let p:i32=il_entry_prov(s,claim_idx,k);
        if(p>=0 && il_entry_item(s,p)==item){
            let op:i32=il_entry_op(s,p);
            let v:i32=il_entry_val(s,p);
            if(op==IL_OP_HYP && v!=cval){return IL_LIE_CITED;}
            if(op==IL_OP_VERIFY && v!=cval){return IL_LIE_CITED;}
            if(op==IL_OP_REFUTE && v==cval){return IL_LIE_CITED;}
            if(op==IL_OP_OBSERVE && v!=cval){
                if(il_obs_superseded(s,p,v,item,cval,claim_idx)==0){return IL_LIE_CITED;}
            }
        }
        k=k+1;
    }
    // Rule 5: contradiction against the latest committed VERIFY (ledger-wide).
    let lv:i32=il_latest_verify(s,item,claim_idx);
    if(lv>=0 && il_entry_val(s,lv)!=cval){return IL_LIE_COMMITTED;}
    // Rule 6: genuine chain shape — evidence before judgment, same item,
    // matching value on the judgment side.
    let ev_min:i32=-1;  // earliest cited OBSERVE/REFUTE on item
    let ju_min:i32=-1;  // earliest cited HYP/VERIFY on item with val==cval
    k=0;
    while(k<IL_MAXPROV){
        let p:i32=il_entry_prov(s,claim_idx,k);
        if(p>=0 && il_entry_item(s,p)==item){
            let op:i32=il_entry_op(s,p);
            if(op==IL_OP_OBSERVE || op==IL_OP_REFUTE){
                if(ev_min<0 || p<ev_min){ev_min=p;}
            }
            if((op==IL_OP_HYP || op==IL_OP_VERIFY) && il_entry_val(s,p)==cval){
                if(ju_min<0 || p<ju_min){ju_min=p;}
            }
        }
        k=k+1;
    }
    if(ev_min<0 || ju_min<0 || ev_min>=ju_min){return IL_CHEAT_NOSHAPE;}
    return IL_OK;
}

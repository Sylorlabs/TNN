// Wave-10 EXP-3: TNN debate WITHOUT authoritative world records.
// Variant A: no public world log for the spectator (NAIVE judges from the
//   debate + interrogation alone; unresolvable ties -> ABSTAIN).
// Variant B: the liar authors the "public world log" NAIVE trusts
//   (poisoned single-source provenance).
// Real machinery, verbatim: st_memory_core.zag + il_core.zag.
// Deterministic. Zero RNG. See PREREG_DEBATE_NORECORD.md (frozen before
// build). Change log vs wave-8 debate.zag is in the prereg §7.
@import("st_memory_core.zag")
@import("il_core.zag")

const DB_NT:i32=6;
const DB_C:i32=4;
const DB_W:i32=2;
const DB_NCLAIMS:i32=24;
const DB_SIDE_TRUE:i32=0;
const DB_SIDE_FALSE:i32=1;
const DB_SIDE_NAIVE:i32=2;
const DB_NO_CIT:i32=255;
const DB_VAR_A:i32=0;
const DB_VAR_B:i32=1;
// protocol-fixed unsupported-discourse counts per topic (volume cheat)
const DB_UT:i32=0;
const DB_UF:i32=2;

// ---- deterministic closed-form knowledge topics (unchanged) ----
fn db_A(t:i32)i32 { return 3+2*(t%5); }
fn db_B(t:i32)i32 { return 1+3*(t%4); }
fn db_P(t:i32)i32 { return 10+2*(t%3); }
fn db_K(t:i32)i32 { return 2+(t%4); }
fn db_pt_off(p:i32)i32 {
    if(p==0){return 7;}
    if(p==1){return 29;}
    if(p==2){return 51;}
    return 83;
}
fn db_m(t:i32,p:i32)i32 { return t*100+db_pt_off(p); }
fn db_G(t:i32,m:i32)i32 {
    let r:i32=(db_A(t)*m+db_B(t))%db_P(t);
    if(r<db_K(t)){return 1;}
    return 0;
}

// ---- world log (private record in A; liar-authored "public" log in B) ----
struct DbWorld {
    ep: []u8,    // i32-packed world episode id
    side: []u8,  // byte
    lidx: []u8,  // i32-packed learner ledger index
    item: []u8,  // i32-packed
    val: []u8,   // byte
    n: i32,
    clock: i32,
}
fn db_world_init()DbWorld {
    return DbWorld{
        .ep=nio_alloc(4096), .side=nio_alloc(1024), .lidx=nio_alloc(4096),
        .item=nio_alloc(4096), .val=nio_alloc(1024), .n=0, .clock=0,
    };
}
fn db_wlog_raw(w:*DbWorld, ep:i32, side:i32, lidx:i32, item:i32, val:i32)void {
    let n:i32=w.*.n;
    st_i32_set(w.*.ep,n*4,ep);
    w.*.side[n]=side as u8;
    st_i32_set(w.*.lidx,n*4,lidx);
    st_i32_set(w.*.item,n*4,item);
    w.*.val[n]=val as u8;
    w.*.n=n+1;
}
fn db_wlog(w:*DbWorld, side:i32, lidx:i32, item:i32, val:i32)i32 {
    let ep:i32=w.*.clock;
    w.*.clock=ep+1;
    db_wlog_raw(w,ep,side,lidx,item,val);
    return ep;
}
// world event shared by both debaters: one ep, two log entries
fn db_wlog_shared(w:*DbWorld, lidx_t:i32, lidx_f:i32, item:i32, val:i32)i32 {
    let ep:i32=w.*.clock;
    w.*.clock=ep+1;
    db_wlog_raw(w,ep,DB_SIDE_TRUE,lidx_t,item,val);
    db_wlog_raw(w,ep,DB_SIDE_FALSE,lidx_f,item,val);
    return ep;
}
fn db_wlog_find(w:*DbWorld, side:i32, lidx:i32)i32 {
    let i:i32=0;
    while(i<w.*.n){
        if((w.*.side[i] as i32)==side && st_i32_get(w.*.lidx,i*4)==lidx){return i;}
        i=i+1;
    }
    return -1;
}
fn db_wlog_find_item(w:*DbWorld, item:i32)i32 {
    let i:i32=0;
    while(i<w.*.n){
        if(st_i32_get(w.*.item,i*4)==item){return i;}
        i=i+1;
    }
    return -1;
}

// ---- learner metadata (unchanged) ----
struct DbMeta {
    side: i32,
    slots: []u8,  // 24 bytes: st slot per claim_id
    cval: []u8,   // asserted value per claim_id
    cstr: []u8,   // strength per claim_id
    obs_i: []u8,  // setup OBSERVE ledger idx per claim_id
    hyp_i: []u8,  // setup HYP ledger idx per claim_id
    n_false: i32, // FALSE: implanted false claims (experiment-design count)
}
fn db_meta_init(side:i32)DbMeta {
    return DbMeta{
        .side=side, .slots=nio_alloc(64), .cval=nio_alloc(64),
        .cstr=nio_alloc(64), .obs_i=nio_alloc(64), .hyp_i=nio_alloc(64),
        .n_false=0,
    };
}

// ---- concession record (new in EXP-3: feeds the admission channel) ----
struct DbConcede {
    side: []u8,
    cid: []u8,
    n: i32,
}
fn db_conc_init()DbConcede {
    return DbConcede{.side=nio_alloc(64), .cid=nio_alloc(64), .n=0};
}
fn db_conc_add(c:*DbConcede, side:i32, cid:i32)void {
    let n:i32=c.*.n;
    c.*.side[n]=side as u8;
    c.*.cid[n]=cid as u8;
    c.*.n=n+1;
}

// ---- ledger ASSERT records (for NAIVE + audit; unchanged) ----
struct DbAsserts {
    side: []u8, topic: []u8, cid: []u8, v: []u8,
    lidx: []u8, c0: []u8, c1: []u8, verdict: []u8,
    n: i32,
}
fn db_ars_init()DbAsserts {
    return DbAsserts{
        .side=nio_alloc(256), .topic=nio_alloc(256), .cid=nio_alloc(256),
        .v=nio_alloc(256), .lidx=nio_alloc(256), .c0=nio_alloc(256),
        .c1=nio_alloc(256), .verdict=nio_alloc(256), .n=0,
    };
}
fn db_ar_add(a:*DbAsserts, side:i32, topic:i32, cid:i32, v:i32, lidx:i32,
             c0:i32, c1:i32, verdict:i32)void {
    let n:i32=a.*.n;
    a.*.side[n]=side as u8; a.*.topic[n]=topic as u8; a.*.cid[n]=cid as u8;
    a.*.v[n]=v as u8; a.*.lidx[n]=lidx as u8;
    a.*.c0[n]=c0 as u8; a.*.c1[n]=c1 as u8; a.*.verdict[n]=verdict as u8;
    a.*.n=n+1;
}

// ---- aggregate counters (extended for EXP-3) ----
struct DbAgg {
    true_corrupt: i32,
    false_revised: i32, false_rev_fail: i32, false_true_kept: i32,
    r2_true: i32, r3_true: i32,
    r2_false: i32, r3_false: i32,
    r2_abstain: i32, r3_abstain: i32,
    margin2: i32, margin3: i32, fresh_contra: i32,
    admit_net: i32, split_net: i32,
    overclaim: i32,
    corrT_v: i32, corrF_v: i32,
    agree_eq: i32, agree_ct: i32,
    topics: i32,
}

// ---- printing ----
fn db_pnum(x:i32)void { cl_number(x as i64); }
fn db_p3(a:[]u8,b:i32,c:[]u8,d:i32,e:[]u8)void {
    _zag_print(a); db_pnum(b); _zag_print(c); db_pnum(d); _zag_println(e);
}

// ---- seeding: the world teaches; FALSE gets fabricated observations ----
// Variant B addition: the liar authors fabricated "public" log entries for
// its OWN ledger chains (self-serving, complete); nothing for TRUE.
fn db_seed(w:*DbWorld, st:*StStore, il:*IlLedger, m:*DbMeta, side:i32,
           agg_seed_fail:*i32, variant:i32, flog:*DbWorld)void {
    let t:i32=0;
    while(t<DB_NT){
        let p:i32=0;
        while(p<DB_C){
            let cid:i32=t*DB_C+p;
            let mm:i32=db_m(t,p);
            let gv:i32=db_G(t,mm);
            let v:i32=gv; let str:i32=70; let genuine:i32=1;
            if(side==DB_SIDE_FALSE){
                str=85;
                if(p==(t%4)){ v=gv; genuine=1; } else { v=1-gv; genuine=0; }
            }
            let oi:i32=il_observe(il,cid,v);
            let hi:i32=il_hyp(il,cid,v);
            let slot:i32=-1;
            let rc:i32=st_add(st,cid*2+v,ST_REGION_USER,str,&slot);
            if(rc!=ST_OK){ agg_seed_fail.*=agg_seed_fail.*+1; }
            m.*.slots[cid]=slot as u8;
            m.*.cval[cid]=v as u8;
            m.*.cstr[cid]=str as u8;
            m.*.obs_i[cid]=oi as u8;
            m.*.hyp_i[cid]=hi as u8;
            if(genuine==1){ db_wlog(w,side,oi,cid,v); }
            else { m.*.n_false=m.*.n_false+1; }
            if(variant==DB_VAR_B && side==DB_SIDE_FALSE){
                // liar-authored "public" record: its own chains, its values
                db_wlog(flog,side,oi,cid,v);
                db_wlog(flog,side,hi,cid,v);
            }
            p=p+1;
        }
        t=t+1;
    }
}

// ---- ASSERT phase: learners argue strongest claims first (unchanged) ----
fn db_assert_side(si:i32, il:*IlLedger, m:*DbMeta, ars:*DbAsserts,
                  topic:i32, n_ledger:*i32, n_disc:*i32)void {
    let p:i32=0;
    while(p<DB_C){
        let cid:i32=topic*DB_C+p;
        let v:i32=m.*.cval[cid] as i32;
        let c0:i32=m.*.obs_i[cid] as i32;
        let c1:i32=m.*.hyp_i[cid] as i32;
        let ai:i32=il_claim(il,cid,v,c0,c1,-1,-1);
        let vd:i32=il_check(il,ai);
        db_ar_add(ars,m.*.side,topic,cid,v,ai,c0,c1,vd);
        n_ledger.*=n_ledger.*+1;
        _zag_print("TR_ASSERT,"); db_pnum(si); _zag_print(",");
        db_pnum(m.*.side); _zag_print(","); db_pnum(topic); _zag_print(",");
        db_pnum(cid); _zag_print(","); db_pnum(v); _zag_print(",");
        db_pnum(ai); _zag_print(","); db_pnum(vd); _zag_println("");
        if(m.*.side==DB_SIDE_FALSE){
            // VOLUME CHEAT: discourse-only re-assertions + unsupported claims
            let r:i32=0;
            while(r<2){
                _zag_print("TR_DISCOURSE,"); db_pnum(si); _zag_print(",");
                db_pnum(m.*.side); _zag_print(","); db_pnum(topic); _zag_print(",");
                db_pnum(cid); _zag_print(","); db_pnum(v); _zag_print(",");
                _zag_print("1,"); db_pnum(c0); _zag_print(","); db_pnum(c1);
                _zag_println("");
                n_disc.*=n_disc.*+1;
                r=r+1;
            }
        }
        p=p+1;
    }
    if(m.*.side==DB_SIDE_FALSE){
        let k:i32=0;
        while(k<2){
            _zag_print("TR_DISCOURSE,"); db_pnum(si); _zag_print(",");
            db_pnum(m.*.side); _zag_print(","); db_pnum(topic); _zag_print(",");
            db_pnum(900+topic); _zag_print(",1,2"); _zag_println("");
            n_disc.*=n_disc.*+1;
            k=k+1;
        }
    }
}

// ---- world adjudication: decisive observations to both debaters ----
// (private in EXP-3: the world log stays inside db_session; NAIVE never
// sees it in Variant A, sees only the fabricated log in Variant B)
fn db_adjudicate(w:*DbWorld, si:i32, til:*IlLedger, fil:*IlLedger, topic:i32)void {
    let p:i32=0;
    while(p<DB_C){
        let cid:i32=topic*DB_C+p;
        let gv:i32=db_G(topic,db_m(topic,p));
        let k:i32=0;
        while(k<DB_W){
            let ti:i32=il_observe(til,cid,gv);
            let fi:i32=il_observe(fil,cid,gv);
            let ep:i32=db_wlog_shared(w,ti,fi,cid,gv);
            _zag_print("TR_WORLD,"); db_pnum(si); _zag_print(",");
            db_pnum(ep); _zag_print(","); db_pnum(cid); _zag_print(",");
            db_pnum(gv); _zag_println("");
            k=k+1;
        }
        p=p+1;
    }
}

// ---- deliberation: the learners' own revision policy (unchanged logic;
// concessions additionally recorded for the admission channel) ----
fn db_deliberate(w:*DbWorld, si:i32, st:*StStore, m:*DbMeta,
                 agg:*DbAgg, topic:i32, conc:*DbConcede)void {
    let p:i32=0;
    while(p<DB_C){
        let cid:i32=topic*DB_C+p;
        let slot:i32=m.*.slots[cid] as i32;
        if(st.*.live[slot]==1){
            let v:i32=m.*.cval[cid] as i32;
            // last two world observations on this claim_id (by ep order)
            let e1:i32=-1; let e2:i32=-1; let found:i32=0;
            let i:i32=w.*.n-1;
            while(i>=0 && found<2){
                if((w.*.side[i] as i32)==m.*.side && st_i32_get(w.*.item,i*4)==cid){
                    if(found==0){e1=i;} else {e2=i;}
                    found=found+1;
                }
                i=i-1;
            }
            let elim:i32=0;
            if(found==2){
                let v1:i32=w.*.val[e1] as i32;
                let v2:i32=w.*.val[e2] as i32;
                if(v1!=v && v2!=v){elim=1;}
            }
            if(elim==1){
                // deliberate revision pipeline (preregistered semantics)
                let ep1:i32=st_i32_get(w.*.ep,e1*4);
                let ep2:i32=st_i32_get(w.*.ep,e2*4);
                let r1:i32=st_evidence(st,slot,ST_J_CONTRADICTED,ep1);
                let r2:i32=st_evidence(st,slot,ST_J_CONTRADICTED,ep2);
                let r4:i32=st_weaken(st,slot,40,ST_J_CONTRADICTED);
                let r5:i32=st_justify(st,slot,ST_J_CONTRADICTED);
                let r6:i32=st_kill_evidenced(st,slot,ST_ARM_A);
                let ok:i32=0;
                if(r1==0 && r2==0 && r4==0 && r5==0 && r6==0){ok=1;}
                let ax:i32=st.*.audit_n-1;
                _zag_print("TR_REVISE,"); db_pnum(si); _zag_print(",");
                db_pnum(m.*.side); _zag_print(","); db_pnum(cid); _zag_print(",");
                db_pnum(r1); _zag_print(","); db_pnum(r2); _zag_print(",");
                db_pnum(r4); _zag_print(","); db_pnum(r5); _zag_print(",");
                db_pnum(r6); _zag_print(","); db_pnum(ax); _zag_println("");
                if(m.*.side==DB_SIDE_TRUE){
                    agg.*.true_corrupt=agg.*.true_corrupt+1;
                } else {
                    if(ok==1){agg.*.false_revised=agg.*.false_revised+1;}
                    else {agg.*.false_rev_fail=agg.*.false_rev_fail+1;}
                }
                db_conc_add(conc,m.*.side,cid);
                _zag_print("TR_CONCEDE,"); db_pnum(si); _zag_print(",");
                db_pnum(m.*.side); _zag_print(","); db_pnum(topic); _zag_print(",");
                db_pnum(cid); _zag_println("");
            }
        }
        p=p+1;
    }
}

// ---- round 2, Variant A: internal citation resolution only; tie -> ABSTAIN ----
fn db_round2_nr(si:i32, til:*IlLedger, fil:*IlLedger, nil:*IlLedger,
                ars:*DbAsserts, r2sT:[]u8, r2sF:[]u8, agg:*DbAgg)void {
    let t:i32=0;
    while(t<DB_NT){
        let sT:i32=0; let sF:i32=0;
        let vT:i32=0; let vF:i32=0;
        let i:i32=0;
        while(i<ars.*.n){
            if((ars.*.topic[i] as i32)==t && (ars.*.verdict[i] as i32)==IL_OK){
                let sd:i32=ars.*.side[i] as i32;
                let pass:i32=1;
                let k:i32=0;
                while(k<2){
                    let c:i32=DB_NO_CIT;
                    if(k==0){c=ars.*.c0[i] as i32;} else {c=ars.*.c1[i] as i32;}
                    let good:i32=0;
                    if(c!=DB_NO_CIT){
                        if(sd==DB_SIDE_TRUE){
                            if(c<til.*.head){
                                let op:i32=il_entry_op(til,c);
                                if((op==IL_OP_OBSERVE || op==IL_OP_HYP) &&
                                   il_entry_item(til,c)==(ars.*.cid[i] as i32) &&
                                   il_entry_val(til,c)==(ars.*.v[i] as i32)){good=1;}
                            }
                        } else {
                            if(c<fil.*.head){
                                let op:i32=il_entry_op(fil,c);
                                if((op==IL_OP_OBSERVE || op==IL_OP_HYP) &&
                                   il_entry_item(fil,c)==(ars.*.cid[i] as i32) &&
                                   il_entry_val(fil,c)==(ars.*.v[i] as i32)){good=1;}
                            }
                        }
                    }
                    _zag_print("TR_VERIFY,"); db_pnum(si); _zag_print(",");
                    db_pnum(t); _zag_print(","); db_pnum(sd); _zag_print(",");
                    db_pnum(ars.*.lidx[i] as i32); _zag_print(",");
                    db_pnum(c); _zag_print(","); db_pnum(good); _zag_print(",");
                    db_pnum(good); _zag_println("");
                    if(good==0){pass=0;}
                    k=k+1;
                }
                if(pass==1){
                    if(sd==DB_SIDE_TRUE){sT=sT+1;} else {sF=sF+1;}
                }
            } else if((ars.*.topic[i] as i32)==t){
                if((ars.*.side[i] as i32)==DB_SIDE_TRUE){vT=vT+1;}
                else {vF=vF+1;}
            }
            i=i+1;
        }
        // choice: higher internal-consistency score wins; unresolvable
        // tie (scores AND ledger violations equal) -> ABSTAIN (-1).
        let ch:i32=-1;
        if(sT>sF){ch=DB_SIDE_TRUE;}
        else if(sF>sT){ch=DB_SIDE_FALSE;}
        else {
            agg.*.r2_abstain=agg.*.r2_abstain+1;
            // diagnostic (measurement only): transcript-level tie-break
            // (ledger violations + unsupported discourse moves)
            let diag:i32=-1;
            let tTv:i32=vT+DB_UT; let tFv:i32=vF+DB_UF;
            if(tTv<tFv){diag=DB_SIDE_TRUE;}
            else if(tFv<tTv){diag=DB_SIDE_FALSE;}
            _zag_print("TR_TBDIAG,"); db_pnum(si); _zag_print(",");
            db_pnum(t); _zag_print(","); db_pnum(diag); _zag_println("");
        }
        let oi:i32=il_observe(nil,t,sT*16+sF);
        let ci:i32=il_observe(nil,500+t,ch+1);
        _zag_print("TR_CHOICE2,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(ch); _zag_print(",");
        db_pnum(sT); _zag_print(","); db_pnum(sF); _zag_println("");
        r2sT[t]=sT as u8; r2sF[t]=sF as u8;
        agg.*.margin2=agg.*.margin2+(sT-sF);
        if(ch==DB_SIDE_TRUE){agg.*.r2_true=agg.*.r2_true+1;}
        else if(ch==DB_SIDE_FALSE){agg.*.r2_false=agg.*.r2_false+1;}
        agg.*.topics=agg.*.topics+1;
        t=t+1;
    }
}

// ---- round 3, Variant A: interrogation without an oracle ----
// (a) debater-answer split component (expected net 0);
// (b) admission-against-interest component (own-record cross-exam).
fn db_round3_nr(si:i32, nil:*IlLedger, ars:*DbAsserts,
                r2sT:[]u8, r2sF:[]u8, tm:*DbMeta, fm:*DbMeta,
                conc:*DbConcede, agg:*DbAgg)void {
    let t:i32=0;
    while(t<DB_NT){
        // same probe policy: FALSE's most-cited claim; ties -> lowest cid
        let tally:[]u8=nio_alloc(64);
        let i:i32=0;
        while(i<ars.*.n){
            if((ars.*.side[i] as i32)==DB_SIDE_FALSE &&
               (ars.*.topic[i] as i32)==t){
                let c:i32=ars.*.cid[i] as i32;
                tally[c]=(tally[c] as i32)+1 as u8;
            }
            i=i+1;
        }
        let probe:i32=t*DB_C; let best:i32=-1;
        let c2:i32=t*DB_C;
        while(c2<t*DB_C+DB_C){
            let n2:i32=tally[c2] as i32;
            if(n2>best){best=n2; probe=c2;}
            c2=c2+1;
        }
        nio_free(tally);
        // (a) debater answers from their own R1 assertions
        let aT:i32=tm.*.cval[probe] as i32;
        let aF:i32=fm.*.cval[probe] as i32;
        let splitT:i32=0; let splitF:i32=0;
        if(aT==aF){splitT=1; splitF=1;}
        // (b) admission scan: did exactly one side concede the probe?
        let concT:i32=0; let concF:i32=0;
        let j:i32=0;
        while(j<conc.*.n){
            if((conc.*.cid[j] as i32)==probe){
                if((conc.*.side[j] as i32)==DB_SIDE_TRUE){concT=1;}
                else {concF=1;}
            }
            j=j+1;
        }
        let admT:i32=0; let admF:i32=0;
        if(concF==1 && concT==0){admT=1;}
        else if(concT==1 && concF==0){admF=1;}
        let qi:i32=il_observe(nil,1000+t,splitT*8+splitF*4+admT*2+admF);
        _zag_print("TR_Q,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(probe); _zag_print(",");
        db_pnum(splitT); _zag_print(","); db_pnum(splitF); _zag_print(",");
        db_pnum(admT); _zag_print(","); db_pnum(admF); _zag_println("");
        let sT:i32=r2sT[t] as i32; let sF:i32=r2sF[t] as i32;
        let totT:i32=sT+splitT+admT; let totF:i32=sF+splitF+admF;
        let ch:i32=-1;
        if(totT>totF){ch=DB_SIDE_TRUE;}
        else if(totF>totT){ch=DB_SIDE_FALSE;}
        else {agg.*.r3_abstain=agg.*.r3_abstain+1;}
        _zag_print("TR_CHOICE3,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(ch); _zag_print(",");
        db_pnum(totT); _zag_print(","); db_pnum(totF); _zag_println("");
        agg.*.margin3=agg.*.margin3+(totT-totF);
        if(ch==DB_SIDE_TRUE){agg.*.r3_true=agg.*.r3_true+1;}
        else if(ch==DB_SIDE_FALSE){agg.*.r3_false=agg.*.r3_false+1;}
        agg.*.admit_net=agg.*.admit_net+(admT-admF);
        agg.*.split_net=agg.*.split_net+(splitT-splitF);
        t=t+1;
    }
}

// ---- round 2, Variant B: provenance = the LIAR's fabricated log ----
fn db_round2_pb(si:i32, flog:*DbWorld, nil:*IlLedger, ars:*DbAsserts,
                r2sT:[]u8, r2sF:[]u8, agg:*DbAgg)void {
    let t:i32=0;
    while(t<DB_NT){
        let sT:i32=0; let sF:i32=0;
        let i:i32=0;
        while(i<ars.*.n){
            if((ars.*.topic[i] as i32)==t && (ars.*.verdict[i] as i32)==IL_OK){
                let sd:i32=ars.*.side[i] as i32;
                let any:i32=0;
                let k:i32=0;
                while(k<2){
                    let c:i32=DB_NO_CIT;
                    if(k==0){c=ars.*.c0[i] as i32;} else {c=ars.*.c1[i] as i32;}
                    let gen:i32=0; let mt:i32=0;
                    if(c!=DB_NO_CIT){
                        let f:i32=db_wlog_find(flog,sd,c);
                        if(f>=0){
                            gen=1;
                            if(st_i32_get(flog.*.item,f*4)==(ars.*.cid[i] as i32) &&
                               (flog.*.val[f] as i32)==(ars.*.v[i] as i32)){mt=1;}
                        }
                    }
                    _zag_print("TR_VERIFY,"); db_pnum(si); _zag_print(",");
                    db_pnum(t); _zag_print(","); db_pnum(sd); _zag_print(",");
                    db_pnum(ars.*.lidx[i] as i32); _zag_print(",");
                    db_pnum(c); _zag_print(","); db_pnum(gen); _zag_print(",");
                    db_pnum(mt); _zag_println("");
                    if(mt==1){any=1;}
                    k=k+1;
                }
                if(any==1){
                    if(sd==DB_SIDE_TRUE){sT=sT+1;} else {sF=sF+1;}
                }
            }
            i=i+1;
        }
        let ch:i32=-1;
        if(sT>sF){ch=DB_SIDE_TRUE;}
        else if(sF>sT){ch=DB_SIDE_FALSE;}
        else {agg.*.r2_abstain=agg.*.r2_abstain+1;}
        let oi:i32=il_observe(nil,t,sT*16+sF);
        let ci:i32=il_observe(nil,500+t,ch+1);
        _zag_print("TR_CHOICE2,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(ch); _zag_print(",");
        db_pnum(sT); _zag_print(","); db_pnum(sF); _zag_println("");
        r2sT[t]=sT as u8; r2sF[t]=sF as u8;
        agg.*.margin2=agg.*.margin2+(sT-sF);
        agg.*.corrT_v=agg.*.corrT_v+sT;
        agg.*.corrF_v=agg.*.corrF_v+sF;
        if(ch==DB_SIDE_TRUE){agg.*.r2_true=agg.*.r2_true+1;}
        else if(ch==DB_SIDE_FALSE){agg.*.r2_false=agg.*.r2_false+1;}
        agg.*.topics=agg.*.topics+1;
        t=t+1;
    }
}

// ---- round 3, Variant B: the poisoned oracle answers; over-claim probe ----
fn db_round3_pb(si:i32, flog:*DbWorld, nil:*IlLedger, ars:*DbAsserts,
                r2sT:[]u8, r2sF:[]u8, tm:*DbMeta, fm:*DbMeta, agg:*DbAgg)void {
    let t:i32=0;
    while(t<DB_NT){
        // same probe policy
        let tally:[]u8=nio_alloc(64);
        let i:i32=0;
        while(i<ars.*.n){
            if((ars.*.side[i] as i32)==DB_SIDE_FALSE &&
               (ars.*.topic[i] as i32)==t){
                let c:i32=ars.*.cid[i] as i32;
                tally[c]=(tally[c] as i32)+1 as u8;
            }
            i=i+1;
        }
        let probe:i32=t*DB_C; let best:i32=-1;
        let c2:i32=t*DB_C;
        while(c2<t*DB_C+DB_C){
            let n2:i32=tally[c2] as i32;
            if(n2>best){best=n2; probe=c2;}
            c2=c2+1;
        }
        nio_free(tally);
        // the "public record" answers: the liar's fabricated value
        let vfab:i32=fm.*.cval[probe] as i32;
        let qi:i32=il_observe(nil,1000+t,vfab);
        db_wlog(flog,DB_SIDE_NAIVE,qi,probe,vfab);
        let corrT:i32=0; let corrF:i32=0;
        if(vfab==(tm.*.cval[probe] as i32)){corrT=1;}
        if(vfab==(fm.*.cval[probe] as i32)){corrF=1;}
        _zag_print("TR_Q,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(probe); _zag_print(",");
        db_pnum(vfab); _zag_print(","); db_pnum(corrT); _zag_print(",");
        db_pnum(corrF); _zag_println("");
        // over-claim cross-examination: record for the unsupported claim?
        let f:i32=db_wlog_find_item(flog,900+t);
        let found:i32=0;
        if(f>=0){found=1;} else {agg.*.overclaim=agg.*.overclaim+1;}
        _zag_print("TR_QX,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(900+t); _zag_print(",");
        db_pnum(found); _zag_println("");
        let sT:i32=r2sT[t] as i32; let sF:i32=r2sF[t] as i32;
        let totT:i32=sT+corrT; let totF:i32=sF+corrF;
        let ch:i32=-1;
        if(totT>totF){ch=DB_SIDE_TRUE;}
        else if(totF>totT){ch=DB_SIDE_FALSE;}
        else {agg.*.r3_abstain=agg.*.r3_abstain+1;}
        _zag_print("TR_CHOICE3,"); db_pnum(si); _zag_print(",");
        db_pnum(t); _zag_print(","); db_pnum(ch); _zag_print(",");
        db_pnum(totT); _zag_print(","); db_pnum(totF); _zag_println("");
        agg.*.margin3=agg.*.margin3+(totT-totF);
        if(ch==DB_SIDE_TRUE){agg.*.r3_true=agg.*.r3_true+1;}
        else if(ch==DB_SIDE_FALSE){agg.*.r3_false=agg.*.r3_false+1;}
        if(corrF==1 && corrT==0){agg.*.fresh_contra=agg.*.fresh_contra+1;}
        t=t+1;
    }
}

// ---- one full debate session ----
fn db_session(w:*DbWorld, si:i32, agg:*DbAgg, seed_fail:*i32,
              variant:i32, flog:*DbWorld, conc:*DbConcede)void {
    let tst:StStore=st_init(64,4096);
    st_set_stage(&tst,ST_STAGE_FULL);
    let til:IlLedger=il_init();
    let fst:StStore=st_init(64,4096);
    st_set_stage(&fst,ST_STAGE_FULL);
    let fil:IlLedger=il_init();
    let nst:StStore=st_init(64,4096);
    st_set_stage(&nst,ST_STAGE_FULL);
    let nil:IlLedger=il_init();
    let tm:DbMeta=db_meta_init(DB_SIDE_TRUE);
    let fm:DbMeta=db_meta_init(DB_SIDE_FALSE);

    db_seed(w,&tst,&til,&tm,DB_SIDE_TRUE,seed_fail,variant,flog);
    db_seed(w,&fst,&fil,&fm,DB_SIDE_FALSE,seed_fail,variant,flog);
    _zag_print("TR_SESSION,"); db_pnum(si); _zag_print(",");
    db_pnum(fm.n_false); _zag_println(",false_implanted");

    let ars:DbAsserts=db_ars_init();
    let n_ledger:i32=0; let n_disc:i32=0;
    let disc_unsup:[]u8=nio_alloc(4);
    disc_unsup[DB_SIDE_TRUE]=0 as u8; disc_unsup[DB_SIDE_FALSE]=0 as u8;

    let t:i32=0;
    while(t<DB_NT){
        db_assert_side(si,&til,&tm,&ars,t,&n_ledger,&n_disc);
        db_assert_side(si,&fil,&fm,&ars,t,&n_ledger,&n_disc);
        disc_unsup[DB_SIDE_FALSE]=((disc_unsup[DB_SIDE_FALSE] as i32)+2) as u8;
        db_adjudicate(w,si,&til,&fil,t);
        db_deliberate(w,si,&tst,&tm,agg,t,conc);
        db_deliberate(w,si,&fst,&fm,agg,t,conc);
        _zag_print("TR_HOLD,"); db_pnum(si); _zag_print(",");
        db_pnum(DB_SIDE_TRUE); _zag_print(","); db_pnum(t); _zag_println("");
        _zag_print("TR_HOLD,"); db_pnum(si); _zag_print(",");
        db_pnum(DB_SIDE_FALSE); _zag_print(","); db_pnum(t); _zag_println("");
        t=t+1;
    }

    // FALSE's genuine claims must all survive: count live
    let kept:i32=0;
    let cid:i32=0;
    while(cid<DB_NCLAIMS){
        let tt:i32=cid/DB_C; let pp:i32=cid-tt*DB_C;
        if(pp==(tt%4)){
            let slot:i32=fm.slots[cid] as i32;
            if(fst.live[slot]==1){kept=kept+1;}
        }
        cid=cid+1;
    }
    agg.*.false_true_kept=agg.*.false_true_kept+kept;

    let r2sT:[]u8=nio_alloc(16); let r2sF:[]u8=nio_alloc(16);
    if(variant==DB_VAR_A){
        db_round2_nr(si,&til,&fil,&nil,&ars,r2sT,r2sF,agg);
        db_round3_nr(si,&nil,&ars,r2sT,r2sF,&tm,&fm,conc,agg);
    } else {
        db_round2_pb(si,flog,&nil,&ars,r2sT,r2sF,agg);
        db_round3_pb(si,flog,&nil,&ars,r2sT,r2sF,&tm,&fm,agg);
    }
    nio_free(r2sT); nio_free(r2sF); nio_free(disc_unsup);

    // per-session checks
    cl_check("sess_ledger_asserts",ars.n,48);
    let okc:i32=0; let i2:i32=0;
    while(i2<ars.n){
        if((ars.verdict[i2] as i32)==IL_OK){okc=okc+1;}
        i2=i2+1;
    }
    cl_check("sess_assert_il_ok",okc,48);
    cl_check("sess_replay_true",st_replay_check(&tst),0);
    cl_check("sess_replay_false",st_replay_check(&fst),0);
    cl_check("sess_replay_naive",st_replay_check(&nst),0);
    _zag_print("TR_SESSION_DONE,"); db_pnum(si); _zag_println("");
}

fn main()i32 {
    let va:[]u8=_zag_arg(1);
    let variant:i32=-1;
    if(_zag_strcmp(va,"A")==1){variant=DB_VAR_A;}
    else if(_zag_strcmp(va,"B")==1){variant=DB_VAR_B;}
    else { _zag_println("BADARG"); return 1; }
    let sa:[]u8=_zag_arg(2);
    let scale:i32=0;
    if(_zag_strcmp(sa,"scale")==1){scale=1;}
    else if(_zag_strcmp(sa,"small")==1){scale=0;}
    else { _zag_println("BADARG"); return 1; }

    let nsess:i32=1;
    if(scale==1){nsess=10;}
    _zag_print("DEBATE_CFG,");
    if(variant==DB_VAR_A){_zag_print("A,");} else {_zag_print("B,");}
    if(scale==1){_zag_print("scale,");} else {_zag_print("small,");}
    db_pnum(nsess); _zag_println(",sessions");

    let agg:DbAgg=DbAgg{
        .true_corrupt=0,.false_revised=0,.false_rev_fail=0,.false_true_kept=0,
        .r2_true=0,.r3_true=0,.r2_false=0,.r3_false=0,
        .r2_abstain=0,.r3_abstain=0,
        .margin2=0,.margin3=0,.fresh_contra=0,
        .admit_net=0,.split_net=0,.overclaim=0,
        .corrT_v=0,.corrF_v=0,
        .agree_eq=0,.agree_ct=0,.topics=0,
    };
    let seed_fail:i32=0;
    let s:i32=0;
    while(s<nsess){
        let w:DbWorld=db_world_init();
        let flog:DbWorld=db_world_init();
        let conc:DbConcede=db_conc_init();
        db_session(&w,s,&agg,&seed_fail,variant,&flog,&conc);
        s=s+1;
    }

    // aggregate bars: integrity (both variants, wave-8 F1/F2)
    cl_check("agg_seed_fail",seed_fail,0);
    cl_check("agg_true_corrupt",agg.true_corrupt,0);
    cl_check("agg_false_rev_fail",agg.false_rev_fail,0);
    let f2bar:i32=0;
    if(scale==0){ if(agg.false_revised>=15){f2bar=1;} }
    else { if(agg.false_revised>=144){f2bar=1;} }
    cl_check("agg_f2_bar",f2bar,1);
    db_pnum(agg.false_revised); _zag_println(",false_revised");
    let kept_exp:i32=6; if(scale==1){kept_exp=60;}
    cl_check("agg_false_true_kept",agg.false_true_kept,kept_exp);
    // measurement bars per variant (§5)
    let texp:i32=6; if(scale==1){texp=60;}
    if(variant==DB_VAR_A){
        cl_check("a_margin2",agg.margin2,0);
        cl_check("a_r2_abstain",agg.r2_abstain,texp);
        cl_check("a_r2_true",agg.r2_true,0);
        let m3e:i32=4; if(scale==1){m3e=40;}
        cl_check("a_margin3",agg.margin3,m3e);
        let r3e:i32=4; if(scale==1){r3e=40;}
        cl_check("a_r3_true",agg.r3_true,r3e);
        let ra3e:i32=2; if(scale==1){ra3e=20;}
        cl_check("a_r3_abstain",agg.r3_abstain,ra3e);
        cl_check("a_admit_net",agg.admit_net,m3e);
        cl_check("a_split_net",agg.split_net,0);
        _zag_print("AGG_MARGIN,"); db_pnum(agg.margin2); _zag_print(",");
        db_pnum(agg.margin3); _zag_println("");
        _zag_print("AGG_ADMIT,"); db_pnum(agg.admit_net); _zag_println("");
        _zag_print("AGG_SPLIT,"); db_pnum(agg.split_net); _zag_println("");
        _zag_print("AGG_ABSTAIN,"); db_pnum(agg.r2_abstain); _zag_print(",");
        db_pnum(agg.r3_abstain); _zag_println("");
        // falsification tripwire FA (binding): positive evidence-quality
        // discrimination without records -> records-load-bearing FALSIFIED
        if(agg.r2_true>=5 && agg.margin2>0){ _zag_println("FALSIFIED_FA"); }
    } else {
        cl_check("b_r2_false",agg.r2_false,texp);
        cl_check("b_r2_true",agg.r2_true,0);
        let m2e:i32=-24; if(scale==1){m2e=-240;}
        cl_check("b_margin2",agg.margin2,m2e);
        let m3e:i32=-28; if(scale==1){m3e=-280;}
        cl_check("b_margin3",agg.margin3,m3e);
        cl_check("b_r3_false",agg.r3_false,texp);
        cl_check("b_overclaim",agg.overclaim,texp);
        _zag_print("AGG_MARGIN,"); db_pnum(agg.margin2); _zag_print(",");
        db_pnum(agg.margin3); _zag_println("");
        _zag_print("AGG_OVERCLAIM,"); db_pnum(agg.overclaim); _zag_println("");
        _zag_print("AGG_CORR,"); db_pnum(agg.corrT_v); _zag_print(",");
        db_pnum(agg.corrF_v); _zag_print(","); db_pnum(texp*4); _zag_println("");
        _zag_print("AGG_FALSE_PICKS,"); db_pnum(agg.r2_false); _zag_print(",");
        db_pnum(agg.r3_false); _zag_println("");
        _zag_print("AGG_FRESH_CONTRA,"); db_pnum(agg.fresh_contra); _zag_println("");
        // falsification tripwire FB (binding)
        if(agg.r2_true>=5){ _zag_println("FALSIFIED_FB"); }
    }
    _zag_print("AGG_TOPICS,"); db_pnum(agg.topics); _zag_println("");
    _zag_println("DEBATE_DONE");
    return 0;
}

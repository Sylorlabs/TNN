// trial.zag — native trial driver for the hypothesis-state substrate.
// Five explicitly-designed deterministic curricula (no RNG anywhere:
// none in the substrate, none in the world, none in the harness).
// Output contract: HSS_CHECK,<name>,<actual>,<expected> lines,
// HSS_AUDIT dump lines for E1, HSS_FAILURES,<n>; exit nonzero iff n>0.

@import("hss.zag")

struct HssBufs {
    active:[]u8,
    claims:[]u8,
    conf:[]u8,
    audit:[]u8,
}

fn hss_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("HSS_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);hss_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);hss_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn hss_new(capacity:i32) HssBufs {
    return HssBufs{.active=hss_alloc(capacity),.claims=hss_alloc(capacity*4),
        .conf=hss_alloc(capacity*4),.audit=hss_alloc(HSS_AUDIT_CAP*16)};
}

fn hss_drop(b:HssBufs)void {
    hss_free(b.active);hss_free(b.claims);hss_free(b.conf);hss_free(b.audit);
}

fn hss_active_count(active:[]u8,capacity:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<capacity){if(active[i]!=0){n=n+1;}i=i+1;}
    return n;
}

fn hss_audit_dump(abuf:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){
        _zag_print("HSS_AUDIT,");
        let a:[]u8=_zag_i64_to_str(hss_u32_get(abuf,i*16) as i64);_zag_print(a);hss_free(a);
        _zag_print(",");
        let b:[]u8=_zag_i64_to_str(hss_u32_get(abuf,i*16+4) as i64);_zag_print(b);hss_free(b);
        _zag_print(",");
        let c:[]u8=_zag_i64_to_str(hss_u32_get(abuf,i*16+8) as i64);_zag_print(c);hss_free(c);
        _zag_print(",");
        let d:[]u8=_zag_i64_to_str(hss_u32_get(abuf,i*16+12) as i64);_zag_print(d);hss_free(d);
        _zag_println("");
        i=i+1;
    }
}

// E1 discriminator: A=slot0 sig1111, B=slot1 sig0001, C=slot2 sig1100.
// obs(0,1), obs(1,1), obs(0,1) again, obs(2,0).
// A accumulates the most confirmations (3) then is refuted by direct
// contradiction. B survives with 2. Commit must go to B; argmax says A.
fn ep1()i32 {
    let f:i32=0;
    let b:HssBufs=hss_new(8);
    f=f+hss_check("e1_alloc",(b.active.len==8 && b.claims.len==32 && b.conf.len==32 && b.audit.len==1024) as i32,1);
    let acount:i32=0;let committed:i32=-1;let step:i32=0;
    f=f+hss_check("e1_act_a",(hss_activate(b.active,b.claims,b.conf,8,0,15,step,b.audit,&acount)==HSS_OK) as i32,1);
    f=f+hss_check("e1_act_b",(hss_activate(b.active,b.claims,b.conf,8,1,1,step,b.audit,&acount)==HSS_OK) as i32,1);
    f=f+hss_check("e1_act_c",(hss_activate(b.active,b.claims,b.conf,8,2,12,step,b.audit,&acount)==HSS_OK) as i32,1);
    step=1;f=f+hss_check("e1_obs0_refuted",hss_observe(b.active,b.claims,b.conf,8,0,1,step,&committed,b.audit,&acount),0);
    step=2;f=f+hss_check("e1_obs1_refuted",hss_observe(b.active,b.claims,b.conf,8,1,1,step,&committed,b.audit,&acount),0);
    step=3;f=f+hss_check("e1_obs2_refuted",hss_observe(b.active,b.claims,b.conf,8,0,1,step,&committed,b.audit,&acount),0);
    step=4;f=f+hss_check("e1_obs3_refuted",hss_observe(b.active,b.claims,b.conf,8,2,0,step,&committed,b.audit,&acount),2);
    f=f+hss_check("e1_a_dead",(b.active[0]==0) as i32,1);
    f=f+hss_check("e1_c_dead",(b.active[2]==0) as i32,1);
    f=f+hss_check("e1_b_alive",(b.active[1]!=0) as i32,1);
    f=f+hss_check("e1_conf_a",hss_u32_get(b.conf,0),3);
    f=f+hss_check("e1_conf_b",hss_u32_get(b.conf,4),2);
    step=5;
    let c:i32=hss_commit(b.active,8,&committed,step,b.audit,&acount);
    f=f+hss_check("e1_commit",c,1);
    f=f+hss_check("e1_committed_var",committed,1);
    let ax:i32=hss_argmax(b.conf,8);
    f=f+hss_check("e1_argmax",ax,0);
    f=f+hss_check("e1_disagree",(c!=ax) as i32,1);
    f=f+hss_check("e1_ncommit",hss_audit_count_op(b.audit,acount,HSS_OP_COMMIT),1);
    hss_audit_dump(b.audit,acount);
    hss_drop(b);
    return f;
}

// E2 non-uniqueness hold: D=slot3, E=slot4, both sig1000. obs(3,1) confirms
// both. No contradiction exists -> HOLD with count 2, no commit. Argmax
// would commit D.
fn ep2()i32 {
    let f:i32=0;
    let b:HssBufs=hss_new(8);
    let acount:i32=0;let committed:i32=-1;let step:i32=0;
    f=f+hss_check("e2_act_d",(hss_activate(b.active,b.claims,b.conf,8,3,8,step,b.audit,&acount)==HSS_OK) as i32,1);
    f=f+hss_check("e2_act_e",(hss_activate(b.active,b.claims,b.conf,8,4,8,step,b.audit,&acount)==HSS_OK) as i32,1);
    step=1;f=f+hss_check("e2_obs_refuted",hss_observe(b.active,b.claims,b.conf,8,3,1,step,&committed,b.audit,&acount),0);
    step=2;
    let c:i32=hss_commit(b.active,8,&committed,step,b.audit,&acount);
    f=f+hss_check("e2_commit_held",(c==-2) as i32,1);
    f=f+hss_check("e2_committed_var",(committed==-1) as i32,1);
    f=f+hss_check("e2_ncommit",hss_audit_count_op(b.audit,acount,HSS_OP_COMMIT),0);
    f=f+hss_check("e2_hold_op",hss_audit_last_op(b.audit,acount),HSS_OP_HOLD);
    f=f+hss_check("e2_hold_count",hss_audit_last_aux(b.audit,acount),2);
    let ax:i32=hss_argmax(b.conf,8);
    f=f+hss_check("e2_argmax",ax,3);
    f=f+hss_check("e2_disagree",((c<0) && (ax>=0)) as i32,1);
    hss_drop(b);
    return f;
}

// E3 total refutation: F=slot5 sig0001, G=slot6 sig0010.
// obs(0,0) refutes F; obs(1,0) refutes G. Empty set -> HOLD, no crash.
fn ep3()i32 {
    let f:i32=0;
    let b:HssBufs=hss_new(8);
    let acount:i32=0;let committed:i32=-1;let step:i32=0;
    f=f+hss_check("e3_act_f",(hss_activate(b.active,b.claims,b.conf,8,5,1,step,b.audit,&acount)==HSS_OK) as i32,1);
    f=f+hss_check("e3_act_g",(hss_activate(b.active,b.claims,b.conf,8,6,2,step,b.audit,&acount)==HSS_OK) as i32,1);
    step=1;f=f+hss_check("e3_obs0_refuted",hss_observe(b.active,b.claims,b.conf,8,0,0,step,&committed,b.audit,&acount),1);
    step=2;f=f+hss_check("e3_obs1_refuted",hss_observe(b.active,b.claims,b.conf,8,1,0,step,&committed,b.audit,&acount),1);
    f=f+hss_check("e3_active",hss_active_count(b.active,8),0);
    step=3;
    let c:i32=hss_commit(b.active,8,&committed,step,b.audit,&acount);
    f=f+hss_check("e3_commit_none",(c==-1) as i32,1);
    f=f+hss_check("e3_committed_var",(committed==-1) as i32,1);
    f=f+hss_check("e3_hold_aux",hss_audit_last_aux(b.audit,acount),0);
    hss_drop(b);
    return f;
}

// E4 revocable commitment: I=slot7 sig0010. obs(0,1) consistent -> COMMIT I
// (sole survivor). obs(1,0) contradicts the defining claim -> REFUTE +
// UNCOMMIT. Commitment is not a sticky threshold crossing.
fn ep4()i32 {
    let f:i32=0;
    let b:HssBufs=hss_new(8);
    let acount:i32=0;let committed:i32=-1;let step:i32=0;
    f=f+hss_check("e4_act_i",(hss_activate(b.active,b.claims,b.conf,8,7,2,step,b.audit,&acount)==HSS_OK) as i32,1);
    step=1;f=f+hss_check("e4_obs0_refuted",hss_observe(b.active,b.claims,b.conf,8,0,1,step,&committed,b.audit,&acount),0);
    step=2;
    let c:i32=hss_commit(b.active,8,&committed,step,b.audit,&acount);
    f=f+hss_check("e4_commit_mid",c,7);
    f=f+hss_check("e4_committed_mid",committed,7);
    step=3;f=f+hss_check("e4_obs1_refuted",hss_observe(b.active,b.claims,b.conf,8,1,0,step,&committed,b.audit,&acount),1);
    f=f+hss_check("e4_committed_final",(committed==-1) as i32,1);
    f=f+hss_check("e4_nuncommit",hss_audit_count_op(b.audit,acount,HSS_OP_UNCOMMIT),1);
    f=f+hss_check("e4_ncommit",hss_audit_count_op(b.audit,acount,HSS_OP_COMMIT),1);
    hss_drop(b);
    return f;
}

// E5 vacuous refusal: sig=0 is refused with HSS_VACUOUS; the slot stays
// inactive; a REFUSE audit entry is logged; a later valid activation works.
fn ep5()i32 {
    let f:i32=0;
    let b:HssBufs=hss_new(8);
    let acount:i32=0;let committed:i32=-1;let step:i32=0;
    let rc:i32=hss_activate(b.active,b.claims,b.conf,8,0,0,step,b.audit,&acount);
    f=f+hss_check("e5_rc_vacuous",(rc==HSS_VACUOUS) as i32,1);
    f=f+hss_check("e5_still_inactive",(b.active[0]==0) as i32,1);
    f=f+hss_check("e5_nrefuse",hss_audit_count_op(b.audit,acount,HSS_OP_REFUSE),1);
    f=f+hss_check("e5_valid_ok",(hss_activate(b.active,b.claims,b.conf,8,0,1,step,b.audit,&acount)==HSS_OK) as i32,1);
    f=f+hss_check("e5_now_active",(b.active[0]!=0) as i32,1);
    hss_drop(b);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+ep1();
    f=f+ep2();
    f=f+ep3();
    f=f+ep4();
    f=f+ep5();
    _zag_print("HSS_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);hss_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

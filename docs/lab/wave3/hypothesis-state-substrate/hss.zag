// hss.zag — hypothesis-state substrate: eliminative commitment.
//
// Wires the smallest meaningful version of r34_hypothesis_state_v1.zag
// (sylorlabs/TNN, branch tnn-native-lab). See SUBSTRATE_ANALYSIS.md for the
// full source accounting. Mapping summary:
//   v1 slot lifecycle (r34h1_activate/r34h1_deactivate) -> hss_activate +
//     the refutation path below (same active-flag semantics).
//   v1 support[] accumulator -> conf[] u32 confirmation counters:
//     AUDIT-ONLY, causally inert w.r.t. every decision.
//   v1 r34h1_rank (deliberately no commit rule) -> hss_commit:
//     commit iff exactly one hypothesis is active. The missing rule, as logic.
//   v1 r34h1_observe (retention EMA + dot) / r34h1_pairwise_credit -> NOT
//     USED. Evidence here is logical (contradiction / confirmation of
//     defining claims), not weighted feature accumulation.
//
// DESIGN LAW (enforced by the runner's static checks, not just comments):
//   - No numeric threshold anywhere. No RNG anywhere.
//   - Refutation: observed bit contradicts a DEFINING CLAIM bit.
//   - Commitment: last hypothesis standing, as a deliberate audited op.
//   - The confirmation counters never enter the commit region.
//
// A hypothesis is: active flag + defining-claim bitmask (u32, bit i means
// "observation index i must read 1") + confirmation counter (audit-only).
// Claim indices 0..30 (bit 31 reserved out; packing helpers require
// non-negative values < 2^31).

const HSS_OK:i32=0;
const HSS_BAD:i32=-350101;
const HSS_RANGE:i32=-350102;
const HSS_VACUOUS:i32=-350103;
const HSS_AUDIT_FULL:i32=-350104;

const HSS_OP_ACTIVATE:i32=1;
const HSS_OP_OBSERVE:i32=2;
const HSS_OP_COMMIT:i32=3;
const HSS_OP_HOLD:i32=4;
const HSS_OP_UNCOMMIT:i32=5;
const HSS_OP_REFUSE:i32=6;

const HSS_OUT_IGNORED:i32=0;
const HSS_OUT_CONSISTENT:i32=1;
const HSS_OUT_CONFIRMED:i32=2;
const HSS_OUT_REFUTED:i32=3;

const HSS_AUDIT_CAP:i32=64;

fn hss_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn hss_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}

fn hss_u32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn hss_u32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

// Audit entry: 16 bytes = step, op, slot+1 (0 = "no slot"), aux.
// Fail-closed: on overflow nothing is appended and the caller must not
// apply the op.
fn hss_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return HSS_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=HSS_AUDIT_CAP){return HSS_AUDIT_FULL;}
    if(abuf.len<(n+1)*16){return HSS_BAD;}
    hss_u32_set(abuf,n*16,step);
    hss_u32_set(abuf,n*16+4,op);
    hss_u32_set(abuf,n*16+8,slot1);
    hss_u32_set(abuf,n*16+12,aux);
    acount.*=n+1;
    return HSS_OK;
}

// Count audit entries with the given op code.
fn hss_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(hss_u32_get(abuf,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

// aux field of the most recent audit entry (-1 if none).
fn hss_audit_last_aux(abuf:[]u8,n:i32)i32 {
    if(n<1){return -1;}
    return hss_u32_get(abuf,(n-1)*16+12);
}

// op field of the most recent audit entry (-1 if none).
fn hss_audit_last_op(abuf:[]u8,n:i32)i32 {
    if(n<1){return -1;}
    return hss_u32_get(abuf,(n-1)*16+4);
}

// Activate a hypothesis slot with defining-claim bitmask sig.
// sig == 0 is refused: a hypothesis with no falsifiable content is not a
// hypothesis (Popper gate — logic, not a threshold).
fn hss_activate(active:[]u8,claims:[]u8,conf:[]u8,capacity:i32,slot:i32,sig:i32,
    step:i32,abuf:[]u8,acount:*i32)i32 {
    if(capacity<1 || slot<0 || slot>=capacity){return HSS_RANGE;}
    if(active.len<capacity || claims.len<capacity*4 || conf.len<capacity*4){return HSS_BAD;}
    if(sig==0){
        let r:i32=hss_audit(abuf,acount,step,HSS_OP_REFUSE,slot+1,0);
        if(r!=HSS_OK){return r;}
        return HSS_VACUOUS;
    }
    if(sig<0){return HSS_RANGE;}
    if(active[slot]!=0){return HSS_BAD;}
    active[slot]=1;
    hss_u32_set(claims,slot*4,sig);
    hss_u32_set(conf,slot*4,0);
    return hss_audit(abuf,acount,step,HSS_OP_ACTIVATE,slot+1,sig);
}

// One observation (index, bit) applied to every slot.
// Returns the refuted count, or a negative status.
// Refutation rule: claim_bit(index)==1 && bit==0 -> the hypothesis
// asserted something the world denied -> deactivate + audit. No score,
// no margin, no counter is consulted.
fn hss_observe(active:[]u8,claims:[]u8,conf:[]u8,capacity:i32,index:i32,bit:i32,
    step:i32,committed:*i32,abuf:[]u8,acount:*i32)i32 {
    if(capacity<1 || index<0 || index>30 || (bit!=0 && bit!=1)){return HSS_RANGE;}
    if(committed==null as *i32){return HSS_BAD;}
    if(active.len<capacity || claims.len<capacity*4 || conf.len<capacity*4){return HSS_BAD;}
    let refuted:i32=0;
    let h:i32=0;
    while(h<capacity){
        if(active[h]!=0){
            let sig:i32=hss_u32_get(claims,h*4);
            let claim:i32=(sig>>index)&1;
            if(claim==1 && bit==0){
                active[h]=0;
                let r:i32=hss_audit(abuf,acount,step,HSS_OP_OBSERVE,h+1,index*8+HSS_OUT_REFUTED);
                if(r!=HSS_OK){return r;}
                if(committed.*==h){
                    let r2:i32=hss_audit(abuf,acount,step,HSS_OP_UNCOMMIT,h+1,index);
                    if(r2!=HSS_OK){return r2;}
                    committed.*=-1;
                }
                refuted=refuted+1;
            } else {
                let out:i32=HSS_OUT_CONSISTENT;
                if(claim==1){
                    hss_u32_set(conf,h*4,hss_u32_get(conf,h*4)+1);
                    out=HSS_OUT_CONFIRMED;
                }
                let r3:i32=hss_audit(abuf,acount,step,HSS_OP_OBSERVE,h+1,index*8+out);
                if(r3!=HSS_OK){return r3;}
            }
        } else {
            let r4:i32=hss_audit(abuf,acount,step,HSS_OP_OBSERVE,h+1,index*8+HSS_OUT_IGNORED);
            if(r4!=HSS_OK){return r4;}
        }
        h=h+1;
    }
    return refuted;
}

// COMMIT-REGION-BEGIN
// The commit rule is structural: commit iff exactly one hypothesis is
// active. The confirmation counters (conf) are audit-only and do not
// appear in this region. The runner verifies this by static token scan.
// Returns: committed slot (>=0), -1 (none active), -2 (held, several
// active), or a negative HSS_* status.
fn hss_commit(active:[]u8,capacity:i32,committed:*i32,step:i32,abuf:[]u8,acount:*i32)i32 {
    if(capacity<1 || committed==null as *i32){return HSS_BAD;}
    if(active.len<capacity){return HSS_BAD;}
    let n:i32=0;let s:i32=-1;let i:i32=0;
    while(i<capacity){if(active[i]!=0){n=n+1;s=i;}i=i+1;}
    if(n==1){
        if(committed.*!=s){
            let r:i32=hss_audit(abuf,acount,step,HSS_OP_COMMIT,s+1,0);
            if(r!=HSS_OK){return r;}
            committed.*=s;
        }
        return s;
    }
    if(committed.*>=0){
        let r2:i32=hss_audit(abuf,acount,step,HSS_OP_UNCOMMIT,committed.*+1,n);
        if(r2!=HSS_OK){return r2;}
        committed.*=-1;
    }
    let r3:i32=hss_audit(abuf,acount,step,HSS_OP_HOLD,0,n);
    if(r3!=HSS_OK){return r3;}
    if(n==0){return -1;}
    return -2;
}
// COMMIT-REGION-END

// FALSIFICATION CONTROL (harness-only, never substrate): the naive score
// mechanism. Lowest slot with the highest confirmation counter, ignoring
// refutation state. If the substrate were argmax-with-extra-steps, this
// control would agree with it on every episode. Disagreement episodes are
// the positive evidence.
fn hss_argmax(conf:[]u8,capacity:i32)i32 {
    if(capacity<1 || conf.len<capacity*4){return HSS_RANGE;}
    let best:i32=-1;let bestv:i32=-1;let i:i32=0;
    while(i<capacity){
        let v:i32=hss_u32_get(conf,i*4);
        if(best<0 || v>bestv){best=i;bestv=v;}
        i=i+1;
    }
    return best;
}

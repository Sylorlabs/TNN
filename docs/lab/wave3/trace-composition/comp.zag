// comp.zag — trace-composition trial (Wave 3, slug: trace-composition).
// Composition operators over the trace substrate: SEQ (chaining), BRANCH
// (conditional on a verified predicate), ABSTRACT (named-op registration),
// plus the deterministic executor comp_apply. Zero RNG anywhere in this
// file: every operator is a deterministic function of explicit state.
//
// Output contract: CL_CHECK,<name>,<actual>,<expected> per check;
// COMP_FAILURES,<n> at end; exit nonzero iff n>0.
@import("../../toolchain/R33_CONTINUING_LIFE_V1/common.zag")

// ---------- constants ----------
// opcodes (lab-canonical v1; FILTER_GT/MAP_MUL semantics per
// wave2/whitebox/WHITEBOX_TESTS.md Group 1)
const OP_FILTER_GT:i32=1;
const OP_MAP_MUL:i32=2;
const OP_NAMED:i32=3;      // reference to a registry name (abstraction use-site)
// provenance codes
const PROV_NONE:i32=0;
const PROV_SELF_VERIFIED:i32=1;
const PROV_COMPOSED:i32=2;
const PROV_TAMPERED:i32=99;
// record kinds
const KIND_FLAT:i32=0;
const KIND_BRANCH:i32=1;
// refusal / status codes (structurally distinct, like REFUSED_CORE)
const COMP_OK:i32=0;
const COMP_UNVERIFIED_LINK:i32=2101;
const COMP_NOT_PREDICATE:i32=2102;
const COMP_NAME_COLLISION:i32=2103;
const COMP_NAME_UNKNOWN:i32=2104;
const COMP_CAPACITY:i32=2105;
const COMP_BAD:i32=2106;
// capacities (trial scale; S2/S3 scale-ups are named next steps in PREREG.md)
const TC_MAX_OPS:i32=8;
const TC_MAX_TRACES:i32=64;
const TC_MAX_NAMES:i32=32;   // registry slots; +1 scratch slot at index 32
const TC_TR_SZ:i32=92;       // 0:id 4:ver 8:prov 12:nops 16:src 20:sup 24:kind 28:ops(8x8)
const TC_REG_SZ:i32=76;      // 0:name 4:nops 8:prov 12:ops(8x8)
const TC_SCRATCH:i32=32;

// ---------- little-endian i32 buffer helpers ----------
fn tc_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn tc_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn tc_buf_equal(a:[]u8,b:[]u8,len:i32)i32 {
    let i:i32=0;while(i<len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}

// ---------- trace record accessors ----------
// field offsets: 0 id, 4 verified, 8 provenance, 12 nops, 16 sources,
// 20 support, 24 kind, 28 op area (8 x {opcode,param})
fn tc_tr_get(store:[]u8,idx:i32,field:i32)i32 { return tc_get(store,idx*TC_TR_SZ+field); }
fn tc_tr_set(store:[]u8,idx:i32,field:i32,v:i32)void { tc_set(store,idx*TC_TR_SZ+field,v); }
fn tc_tr_op_get(store:[]u8,idx:i32,op:i32)i32 { return tc_get(store,idx*TC_TR_SZ+28+op*8); }
fn tc_tr_op_par(store:[]u8,idx:i32,op:i32)i32 { return tc_get(store,idx*TC_TR_SZ+28+op*8+4); }
fn tc_tr_op_set(store:[]u8,idx:i32,op:i32,opc:i32,par:i32)void {
    let b:i32=idx*TC_TR_SZ+28+op*8; tc_set(store,b,opc); tc_set(store,b+4,par);
}
// Explicit initialization: nio_alloc is NOT zeroed (playbook), so every
// record header and op slot is written by hand.
fn tc_tr_init(store:[]u8,idx:i32,id:i32)void {
    tc_tr_set(store,idx,0,id);  tc_tr_set(store,idx,4,0);
    tc_tr_set(store,idx,8,PROV_NONE); tc_tr_set(store,idx,12,0);
    tc_tr_set(store,idx,16,0); tc_tr_set(store,idx,20,1000);
    tc_tr_set(store,idx,24,KIND_FLAT);
    let k:i32=0;while(k<TC_MAX_OPS){tc_tr_op_set(store,idx,k,0,0);k=k+1;}
}
fn tc_tr_invalidate(store:[]u8,idx:i32)void {
    // atomic refusal: no usable composite is left behind
    tc_tr_set(store,idx,0,-1); tc_tr_set(store,idx,4,0);
    tc_tr_set(store,idx,8,PROV_NONE); tc_tr_set(store,idx,12,0);
    tc_tr_set(store,idx,24,KIND_FLAT);
}
// link precondition: verified AND provenance is native (self or composed)
fn tc_link_ok(store:[]u8,idx:i32)i32 {
    if(idx<0 || idx>=TC_MAX_TRACES){return 0;}
    if(tc_tr_get(store,idx,4)!=1){return 0;}
    let p:i32=tc_tr_get(store,idx,8);
    if(p!=PROV_SELF_VERIFIED && p!=PROV_COMPOSED){return 0;}
    return 1;
}
fn tc_out_ok(idx:i32)i32 { return (idx>=0 && idx<TC_MAX_TRACES) as i32; }
fn tc_copy_ops(store:[]u8,src:i32,dst:i32,dst_off:i32)void {
    let n:i32=tc_tr_get(store,src,12);
    let k:i32=0;
    while(k<n){
        tc_tr_op_set(store,dst,dst_off+k,tc_tr_op_get(store,src,k),tc_tr_op_par(store,src,k));
        k=k+1;
    }
}
// predicate-class test (structural): every op in the FILTER family, >=1 op
fn tc_is_predicate(store:[]u8,idx:i32)i32 {
    let n:i32=tc_tr_get(store,idx,12);
    if(n<1){return 0;}
    let k:i32=0;
    while(k<n){ if(tc_tr_op_get(store,idx,k)!=OP_FILTER_GT){return 0;} k=k+1; }
    return 1;
}

// ---------- named-op registry accessors ----------
// field offsets: 0 name_id, 4 nops, 8 provenance, 12 op area (8 x {opcode,param})
fn tc_reg_get(reg:[]u8,idx:i32,field:i32)i32 { return tc_get(reg,idx*TC_REG_SZ+field); }
fn tc_reg_set(reg:[]u8,idx:i32,field:i32,v:i32)void { tc_set(reg,idx*TC_REG_SZ+field,v); }
fn tc_reg_op_get(reg:[]u8,idx:i32,op:i32)i32 { return tc_get(reg,idx*TC_REG_SZ+12+op*8); }
fn tc_reg_op_par(reg:[]u8,idx:i32,op:i32)i32 { return tc_get(reg,idx*TC_REG_SZ+12+op*8+4); }
fn tc_reg_op_set(reg:[]u8,idx:i32,op:i32,opc:i32,par:i32)void {
    let b:i32=idx*TC_REG_SZ+12+op*8; tc_set(reg,b,opc); tc_set(reg,b+4,par);
}
fn tc_reg_init_all(reg:[]u8)void {
    let i:i32=0;
    while(i<TC_MAX_NAMES+1){
        tc_reg_set(reg,i,0,-1); tc_reg_set(reg,i,4,0); tc_reg_set(reg,i,8,PROV_NONE);
        let k:i32=0;while(k<TC_MAX_OPS){tc_reg_op_set(reg,i,k,0,0);k=k+1;}
        i=i+1;
    }
}
fn tc_reg_find(reg:[]u8,name:i32)i32 {
    let i:i32=0;
    while(i<TC_MAX_NAMES){ if(tc_reg_get(reg,i,0)==name){return i;} i=i+1; }
    return -1;
}
fn tc_reg_free(reg:[]u8)i32 {
    let i:i32=0;
    while(i<TC_MAX_NAMES){ if(tc_reg_get(reg,i,0)==-1){return i;} i=i+1; }
    return -1;
}
fn tc_reg_count(reg:[]u8)i32 {
    let c:i32=0;let i:i32=0;
    while(i<TC_MAX_NAMES){ if(tc_reg_get(reg,i,0)!=-1){c=c+1;} i=i+1; }
    return c;
}
fn tc_reg_ops_equal(reg:[]u8,a:i32,b:i32)i32 {
    let na:i32=tc_reg_get(reg,a,4);let nb:i32=tc_reg_get(reg,b,4);
    if(na!=nb){return 0;}
    let k:i32=0;
    while(k<na){
        if(tc_reg_op_get(reg,a,k)!=tc_reg_op_get(reg,b,k)){return 0;}
        if(tc_reg_op_par(reg,a,k)!=tc_reg_op_par(reg,b,k)){return 0;}
        k=k+1;
    }
    return 1;
}
fn tc_reg_copy_ops(reg:[]u8,src:i32,dst:i32)void {
    let n:i32=tc_reg_get(reg,src,4);
    let k:i32=0;
    while(k<n){ tc_reg_op_set(reg,dst,k,tc_reg_op_get(reg,src,k),tc_reg_op_par(reg,src,k)); k=k+1; }
}

// ---------- executors ----------
// System executor ops: lab-canonical v1 semantics (same as
// wave2/whitebox wb_filter_gt / wb_map_mul).
fn tc_exec_filter_gt(v:[]u8,p:i32)void {
    let i:i32=0;
    while(i<v.len){ let x:i32=v[i] as i32; if(x>p){} else {v[i]=0;} i=i+1; }
}
fn tc_exec_map_mul(v:[]u8,k:i32)void {
    let i:i32=0;while(i<v.len){ v[i]=((v[i] as i32)*k) as u8; i=i+1; }
}
// Reference oracle: an INDEPENDENT direct executor over plain op arrays —
// no records, no registry, no dispatch. The trial compares comp_apply
// against this oracle. Documented assumption: both implement canonical v1.
fn tc_ref_filter_gt(v:[]u8,p:i32)void {
    let i:i32=0;
    while(i<v.len){ if((v[i] as i32)>p){} else {v[i]=0;} i=i+1; }
}
fn tc_ref_map_mul(v:[]u8,k:i32)void {
    let i:i32=0;while(i<v.len){ v[i]=((v[i] as i32)*k) as u8; i=i+1; }
}
fn tc_ref_apply(ops:[]u8,nops:i32,cue:[]u8,out:[]u8)void {
    cl_copy(out,cue);
    let k:i32=0;
    while(k<nops){
        let oc:i32=tc_get(ops,k*8);let pa:i32=tc_get(ops,k*8+4);
        if(oc==OP_FILTER_GT){ tc_ref_filter_gt(out,pa); }
        else { if(oc==OP_MAP_MUL){ tc_ref_map_mul(out,pa); } }
        k=k+1;
    }
}
// apply one flat registry definition to v (registry entries are flat by
// construction; OP_NAMED inside a definition is corruption -> BAD)
fn tc_apply_reg(reg:[]u8,ri:i32,v:[]u8)i32 {
    let n:i32=tc_reg_get(reg,ri,4);
    let k:i32=0;
    while(k<n){
        let oc:i32=tc_reg_op_get(reg,ri,k);let pa:i32=tc_reg_op_par(reg,ri,k);
        if(oc==OP_FILTER_GT){ tc_exec_filter_gt(v,pa); }
        else { if(oc==OP_MAP_MUL){ tc_exec_map_mul(v,pa); } else { return COMP_BAD; } }
        k=k+1;
    }
    return COMP_OK;
}
fn comp_apply_flat(store:[]u8,reg:[]u8,t:i32,cue:[]u8,out:[]u8)i32 {
    cl_copy(out,cue);
    let n:i32=tc_tr_get(store,t,12);
    let k:i32=0;
    while(k<n){
        let oc:i32=tc_tr_op_get(store,t,k);let pa:i32=tc_tr_op_par(store,t,k);
        if(oc==OP_FILTER_GT){ tc_exec_filter_gt(out,pa); }
        else { if(oc==OP_MAP_MUL){ tc_exec_map_mul(out,pa); }
        else { if(oc==OP_NAMED){
            let ri:i32=tc_reg_find(reg,pa);
            if(ri<0){ return COMP_NAME_UNKNOWN; }
            let st:i32=tc_apply_reg(reg,ri,out);
            if(st!=COMP_OK){ return st; }
        } else { return COMP_BAD; } } }
        k=k+1;
    }
    return COMP_OK;
}
// The executor: pure deterministic dispatch on record kind. It checks
// NOTHING about verifiedness — verification is enforced at composition
// time (the only place new verified objects come into being), by design.
fn comp_apply(store:[]u8,reg:[]u8,t:i32,cue:[]u8,out:[]u8)i32 {
    if(t<0 || t>=TC_MAX_TRACES){ return COMP_BAD; }
    if(cue.len!=out.len){ return COMP_BAD; }
    if(tc_tr_get(store,t,24)!=KIND_BRANCH){ return comp_apply_flat(store,reg,t,cue,out); }
    let base:i32=t*TC_TR_SZ;
    let p:i32=tc_get(store,base+28);let th:i32=tc_get(store,base+32);let el:i32=tc_get(store,base+36);
    let mask:[]u8=nio_alloc(cue.len);let tv:[]u8=nio_alloc(cue.len);let ev:[]u8=nio_alloc(cue.len);
    let st:i32=comp_apply(store,reg,p,cue,mask);
    if(st==COMP_OK){ st=comp_apply(store,reg,th,cue,tv); }
    if(st==COMP_OK){ st=comp_apply(store,reg,el,cue,ev); }
    if(st==COMP_OK){
        let i:i32=0;
        while(i<out.len){
            if((mask[i] as i32)!=0){ out[i]=tv[i]; } else { out[i]=ev[i]; }
            i=i+1;
        }
    }
    nio_free(mask);nio_free(tv);nio_free(ev);
    return st;
}

// ---------- operators ----------
// SEQ: verified chaining with provenance union. out must not alias a/b
// (refused structurally); on any refusal out is atomically invalidated.
fn comp_seq(store:[]u8,a:i32,b:i32,out:i32)i32 {
    if(tc_out_ok(out)==0){ return COMP_BAD; }
    if(out==a || out==b){ return COMP_BAD; }
    if(tc_link_ok(store,a)==0 || tc_link_ok(store,b)==0){
        tc_tr_invalidate(store,out); return COMP_UNVERIFIED_LINK;
    }
    let na:i32=tc_tr_get(store,a,12);let nb:i32=tc_tr_get(store,b,12);
    if(na+nb>TC_MAX_OPS){ tc_tr_invalidate(store,out); return COMP_CAPACITY; }
    tc_tr_init(store,out,1000+out);
    tc_copy_ops(store,a,out,0);
    tc_copy_ops(store,b,out,na);
    tc_tr_set(store,out,4,1);
    tc_tr_set(store,out,8,PROV_COMPOSED);
    tc_tr_set(store,out,12,na+nb);
    tc_tr_set(store,out,16,tc_tr_get(store,a,16)|tc_tr_get(store,b,16));
    let sa:i32=tc_tr_get(store,a,20);let sb:i32=tc_tr_get(store,b,20);
    let m:i32=sa;if(sb<m){m=sb;}
    tc_tr_set(store,out,20,m);
    tc_tr_set(store,out,24,KIND_FLAT);
    return COMP_OK;
}
// BRANCH: conditional composite (kind=1). Predicate-class is structural.
fn comp_branch(store:[]u8,pred:i32,th:i32,el:i32,out:i32)i32 {
    if(tc_out_ok(out)==0){ return COMP_BAD; }
    if(out==pred || out==th || out==el){ return COMP_BAD; }
    if(tc_link_ok(store,pred)==0 || tc_link_ok(store,th)==0 || tc_link_ok(store,el)==0){
        tc_tr_invalidate(store,out); return COMP_UNVERIFIED_LINK;
    }
    if(tc_is_predicate(store,pred)==0){
        tc_tr_invalidate(store,out); return COMP_NOT_PREDICATE;
    }
    tc_tr_init(store,out,1000+out);
    tc_tr_set(store,out,4,1);
    tc_tr_set(store,out,8,PROV_COMPOSED);
    tc_tr_set(store,out,12,3);
    let s:i32=tc_tr_get(store,pred,16)|tc_tr_get(store,th,16)|tc_tr_get(store,el,16);
    tc_tr_set(store,out,16,s);
    let sp:i32=tc_tr_get(store,pred,20);let st2:i32=tc_tr_get(store,th,20);let se:i32=tc_tr_get(store,el,20);
    let m:i32=sp;if(st2<m){m=st2;}if(se<m){m=se;}
    tc_tr_set(store,out,20,m);
    tc_tr_set(store,out,24,KIND_BRANCH);
    let base:i32=out*TC_TR_SZ;
    tc_set(store,base+28,pred);tc_set(store,base+32,th);tc_set(store,base+36,el);
    return COMP_OK;
}
// flatten trace t's ops into registry scratch slot; returns nflat or -1
fn tc_flatten(store:[]u8,reg:[]u8,t:i32)i32 {
    let sc:i32=TC_SCRATCH;
    let n:i32=tc_tr_get(store,t,12);
    let off:i32=0;let k:i32=0;
    while(k<n){
        let oc:i32=tc_tr_op_get(store,t,k);let pa:i32=tc_tr_op_par(store,t,k);
        if(oc==OP_NAMED){
            let ri:i32=tc_reg_find(reg,pa);
            if(ri<0){ return -1; }
            let m:i32=tc_reg_get(reg,ri,4);let j:i32=0;
            while(j<m){
                if(off>=TC_MAX_OPS){ return -1; }
                let oc2:i32=tc_reg_op_get(reg,ri,j);
                if(oc2==OP_NAMED){ return -1; }  // flat by construction
                tc_reg_op_set(reg,sc,off,oc2,tc_reg_op_par(reg,ri,j));
                off=off+1;j=j+1;
            }
        } else {
            if(off>=TC_MAX_OPS){ return -1; }
            tc_reg_op_set(reg,sc,off,oc,pa);
            off=off+1;
        }
        k=k+1;
    }
    tc_reg_set(reg,sc,4,off);
    return off;
}
// ABSTRACT: name a verified sequence. Idempotent on identical ops;
// NAME_COLLISION on different ops under a live name; registry untouched.
fn comp_abstract(store:[]u8,reg:[]u8,t:i32,name:i32)i32 {
    if(tc_link_ok(store,t)==0){ return COMP_UNVERIFIED_LINK; }
    let nflat:i32=tc_flatten(store,reg,t);
    if(nflat<0){ return COMP_CAPACITY; }
    let ri:i32=tc_reg_find(reg,name);
    if(ri>=0){
        if(tc_reg_ops_equal(reg,ri,TC_SCRATCH)==1){ return COMP_OK; }
        return COMP_NAME_COLLISION;
    }
    let fi:i32=tc_reg_free(reg);
    if(fi<0){ return COMP_CAPACITY; }
    tc_reg_set(reg,fi,0,name);
    tc_reg_set(reg,fi,4,nflat);
    tc_reg_set(reg,fi,8,tc_tr_get(store,t,8));
    tc_reg_copy_ops(reg,TC_SCRATCH,fi);
    return COMP_OK;
}

// ---------- trial scaffolding ----------
// All cues and traces are hand-specified constants. Zero RNG in the
// harness: test adversity comes from designed adversarial sets (ADV-1..5).
fn tc_mk(store:[]u8,idx:i32,ver:i32,prov:i32,src:i32,nops:i32)void {
    tc_tr_init(store,idx,100+idx);
    tc_tr_set(store,idx,4,ver);
    tc_tr_set(store,idx,8,prov);
    tc_tr_set(store,idx,16,src);
    tc_tr_set(store,idx,12,nops);
}
fn tc_op(store:[]u8,idx:i32,k:i32,oc:i32,pa:i32)void { tc_tr_op_set(store,idx,k,oc,pa); }
fn tc_op_set_arr(buf:[]u8,k:i32,oc:i32,pa:i32)void {
    tc_set(buf,k*8,oc);tc_set(buf,k*8+4,pa);
}
fn tc_rec_copy(store:[]u8,idx:i32,dst:[]u8)void {
    let i:i32=0;while(i<TC_TR_SZ){ dst[i]=store[idx*TC_TR_SZ+i]; i=i+1; }
}
fn tc_cue_boundary(cue:[]u8)void {
    // [0,2,3,4,99,100,101,255] repeating: param-1/param/param+1 for
    // params 3 and 100, plus 0 and 255 (ADV-5)
    let j:i32=0;let i:i32=0;
    while(i<cue.len){
        let v:i32=255;
        if(j==0){v=0;} else { if(j==1){v=2;} else { if(j==2){v=3;} else { if(j==3){v=4;}
        else { if(j==4){v=99;} else { if(j==5){v=100;} else { if(j==6){v=101;} } } } } } }
        cue[i]=v as u8;
        j=j+1;if(j==8){j=0;}
        i=i+1;
    }
}
fn tc_cue_wrap(cue:[]u8)void {
    // [200,201,250,255] repeating: u8 wraparound stress for MAP_MUL
    let j:i32=0;let i:i32=0;
    while(i<cue.len){
        let v:i32=255;
        if(j==0){v=200;} else { if(j==1){v=201;} else { if(j==2){v=250;} } }
        cue[i]=v as u8;
        j=j+1;if(j==4){j=0;}
        i=i+1;
    }
}
fn tc_cue_ramp(cue:[]u8)void {
    let i:i32=0;while(i<cue.len){ cue[i]=i as u8;i=i+1; }
}
fn tc_setup(store:[]u8)void {
    let i:i32=0;while(i<TC_MAX_TRACES){tc_tr_init(store,i,100+i);i=i+1;}
    tc_mk(store,0,1,PROV_SELF_VERIFIED,1,1);   tc_op(store,0,0,OP_FILTER_GT,3);
    tc_mk(store,1,1,PROV_SELF_VERIFIED,2,1);   tc_op(store,1,0,OP_MAP_MUL,2);
    tc_mk(store,2,1,PROV_SELF_VERIFIED,4,1);   tc_op(store,2,0,OP_FILTER_GT,100);
    tc_mk(store,3,1,PROV_SELF_VERIFIED,8,1);   tc_op(store,3,0,OP_MAP_MUL,3);
    tc_mk(store,4,0,PROV_SELF_VERIFIED,16,1);  tc_op(store,4,0,OP_FILTER_GT,5);  // ADV: unverified
    tc_mk(store,5,1,PROV_TAMPERED,32,1);       tc_op(store,5,0,OP_MAP_MUL,2);     // ADV: forged provenance
    // deep chain singles 10..17 (G8)
    tc_mk(store,10,1,PROV_SELF_VERIFIED,1,1);  tc_op(store,10,0,OP_FILTER_GT,10);
    tc_mk(store,11,1,PROV_SELF_VERIFIED,2,1);  tc_op(store,11,0,OP_MAP_MUL,2);
    tc_mk(store,12,1,PROV_SELF_VERIFIED,4,1);  tc_op(store,12,0,OP_FILTER_GT,20);
    tc_mk(store,13,1,PROV_SELF_VERIFIED,8,1);  tc_op(store,13,0,OP_MAP_MUL,3);
    tc_mk(store,14,1,PROV_SELF_VERIFIED,16,1); tc_op(store,14,0,OP_FILTER_GT,30);
    tc_mk(store,15,1,PROV_SELF_VERIFIED,32,1); tc_op(store,15,0,OP_MAP_MUL,2);
    tc_mk(store,16,1,PROV_SELF_VERIFIED,64,1); tc_op(store,16,0,OP_FILTER_GT,40);
    tc_mk(store,17,1,PROV_SELF_VERIFIED,128,1);tc_op(store,17,0,OP_MAP_MUL,2);
    // poison chain 20..24 (ADV-1: trace 22 unverified)
    tc_mk(store,20,1,PROV_SELF_VERIFIED,1,1);  tc_op(store,20,0,OP_FILTER_GT,1);
    tc_mk(store,21,1,PROV_SELF_VERIFIED,2,1);  tc_op(store,21,0,OP_MAP_MUL,2);
    tc_mk(store,22,0,PROV_SELF_VERIFIED,4,1);  tc_op(store,22,0,OP_FILTER_GT,5);
    tc_mk(store,23,1,PROV_SELF_VERIFIED,8,1);  tc_op(store,23,0,OP_MAP_MUL,2);
    tc_mk(store,24,1,PROV_SELF_VERIFIED,16,1); tc_op(store,24,0,OP_FILTER_GT,7);
    // named-op use sites
    tc_mk(store,33,1,PROV_SELF_VERIFIED,64,1); tc_op(store,33,0,OP_NAMED,7);
    tc_mk(store,34,1,PROV_SELF_VERIFIED,64,2); tc_op(store,34,0,OP_NAMED,7);tc_op(store,34,1,OP_FILTER_GT,10);
    tc_mk(store,36,1,PROV_SELF_VERIFIED,64,1); tc_op(store,36,0,OP_NAMED,11); // G6 use-site for name 11
    tc_mk(store,38,1,PROV_SELF_VERIFIED,64,1); tc_op(store,38,0,OP_NAMED,999); // unknown name
}

// G1: single-trace apply matches the oracle; hand spot-checks incl. boundary + wrap
fn tc_g1(store:[]u8,reg:[]u8,cueB:[]u8,cueW:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_apply(store,reg,0,cueB,out);
    f=f+cl_check("g1_apply_status",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,3);
    tc_ref_apply(ops,1,cueB,ref);
    f=f+cl_check("g1_filter_gt_oracle",tc_buf_equal(out,ref,128),1);
    f=f+cl_check("g1_spot_lo",out[1] as i32,0);
    f=f+cl_check("g1_spot_boundary",out[2] as i32,0);
    f=f+cl_check("g1_spot_hi",out[3] as i32,4);
    tc_op_set_arr(ops,0,OP_MAP_MUL,2);
    st=comp_apply(store,reg,1,cueW,out);
    f=f+cl_check("g1_mul_status",st,COMP_OK);
    tc_ref_apply(ops,1,cueW,ref);
    f=f+cl_check("g1_mul_oracle",tc_buf_equal(out,ref,128),1);
    f=f+cl_check("g1_wrap_200",out[0] as i32,144);
    f=f+cl_check("g1_wrap_255",out[3] as i32,254);
    nio_free(out);nio_free(ref);nio_free(ops);
    return f;
}
// G2: SEQ chaining — semantics, verifiedness, provenance, source union
fn tc_g2(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_seq(store,0,1,30);
    f=f+cl_check("g2_seq_status",st,COMP_OK);
    st=comp_apply(store,reg,30,cueB,out);
    f=f+cl_check("g2_apply_status",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,3);tc_op_set_arr(ops,1,OP_MAP_MUL,2);
    tc_ref_apply(ops,2,cueB,ref);
    f=f+cl_check("g2_seq_oracle",tc_buf_equal(out,ref,128),1);
    f=f+cl_check("g2_spot_99",out[4] as i32,198);
    f=f+cl_check("g2_spot_255",out[7] as i32,254);
    f=f+cl_check("g2_verified",tc_tr_get(store,30,4),1);
    f=f+cl_check("g2_provenance",tc_tr_get(store,30,8),PROV_COMPOSED);
    f=f+cl_check("g2_sources",tc_tr_get(store,30,16),3);
    f=f+cl_check("g2_nops",tc_tr_get(store,30,12),2);
    nio_free(out);nio_free(ref);nio_free(ops);
    return f;
}
// G3: SEQ refusal — ADV-1 poisoned middle, ADV-2 forged provenance
fn tc_g3(store:[]u8,reg:[]u8)i32 {
    let f:i32=0;
    let st:i32=comp_seq(store,20,21,40);
    f=f+cl_check("g3_fold_ok",st,COMP_OK);
    st=comp_seq(store,40,22,41);   // trace 22 is unverified: must refuse here
    f=f+cl_check("g3_poison_refused",st,COMP_UNVERIFIED_LINK);
    f=f+cl_check("g3_poison_out_invalid",tc_tr_get(store,41,4),0);
    f=f+cl_check("g3_poison_out_noprov",tc_tr_get(store,41,8),PROV_NONE);
    f=f+cl_check("g3_poison_out_nonops",tc_tr_get(store,41,12),0);
    f=f+cl_check("g3_acc_untouched",tc_tr_get(store,40,4),1);
    st=comp_seq(store,0,5,41);     // trace 5: verified=1 but forged provenance
    f=f+cl_check("g3_forged_refused",st,COMP_UNVERIFIED_LINK);
    f=f+cl_check("g3_forged_out_invalid",tc_tr_get(store,41,4),0);
    return f;
}
// G4: BRANCH on a verified predicate — mask semantics + boundary; negatives
fn tc_g4(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let mask:[]u8=nio_alloc(128);let thv:[]u8=nio_alloc(128);
    let elv:[]u8=nio_alloc(128);let exp:[]u8=nio_alloc(128);
    let st:i32=comp_branch(store,2,1,3,32);
    f=f+cl_check("g4_branch_status",st,COMP_OK);
    st=comp_apply(store,reg,32,cueB,out);
    f=f+cl_check("g4_apply_status",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,100);tc_ref_apply(ops,1,cueB,mask);
    tc_op_set_arr(ops,0,OP_MAP_MUL,2);    tc_ref_apply(ops,1,cueB,thv);
    tc_op_set_arr(ops,0,OP_MAP_MUL,3);    tc_ref_apply(ops,1,cueB,elv);
    let i:i32=0;
    while(i<128){
        if((mask[i] as i32)!=0){exp[i]=thv[i];}else{exp[i]=elv[i];}
        i=i+1;
    }
    f=f+cl_check("g4_branch_oracle",tc_buf_equal(out,exp,128),1);
    f=f+cl_check("g4_spot_99_else",out[4] as i32,41);   // 99 -> else arm 99*3 mod 256
    f=f+cl_check("g4_spot_100_else",out[5] as i32,44);  // strict > boundary: 100 not > 100
    f=f+cl_check("g4_spot_101_then",out[6] as i32,202); // 101 -> then arm 101*2
    f=f+cl_check("g4_spot_255_then",out[7] as i32,254);
    f=f+cl_check("g4_verified",tc_tr_get(store,32,4),1);
    f=f+cl_check("g4_provenance",tc_tr_get(store,32,8),PROV_COMPOSED);
    f=f+cl_check("g4_sources",tc_tr_get(store,32,16),14);
    st=comp_branch(store,1,1,3,41);   // MAP_MUL trace is not predicate-class
    f=f+cl_check("g4_smuggler_refused",st,COMP_NOT_PREDICATE);
    f=f+cl_check("g4_smuggler_invalid",tc_tr_get(store,41,4),0);
    st=comp_branch(store,2,4,3,41);   // unverified then-arm
    f=f+cl_check("g4_unver_arm_refused",st,COMP_UNVERIFIED_LINK);
    f=f+cl_check("g4_unver_arm_invalid",tc_tr_get(store,41,4),0);
    nio_free(out);nio_free(ops);nio_free(mask);nio_free(thv);nio_free(elv);nio_free(exp);
    return f;
}

// G5: ABSTRACT — naming, idempotence, name-squat collision, unknown name
fn tc_g5(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let out2:[]u8=nio_alloc(128);
    let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_abstract(store,reg,30,7);   // name 7 = [(F,3),(M,2)]
    f=f+cl_check("g5_abstract_status",st,COMP_OK);
    f=f+cl_check("g5_reg_count_1",tc_reg_count(reg),1);
    st=comp_abstract(store,reg,30,7);           // idempotent re-abstract
    f=f+cl_check("g5_idempotent",st,COMP_OK);
    f=f+cl_check("g5_reg_count_still_1",tc_reg_count(reg),1);
    st=comp_apply(store,reg,33,cueB,out);      // slot33 = [(NAMED,7)]
    f=f+cl_check("g5_use_status",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,3);tc_op_set_arr(ops,1,OP_MAP_MUL,2);
    tc_ref_apply(ops,2,cueB,ref);
    f=f+cl_check("g5_use_oracle",tc_buf_equal(out,ref,128),1);
    st=comp_abstract(store,reg,3,7);            // ADV-4: name squat, different ops
    f=f+cl_check("g5_squat_refused",st,COMP_NAME_COLLISION);
    f=f+cl_check("g5_squat_count_1",tc_reg_count(reg),1);
    st=comp_apply(store,reg,33,cueB,out2);     // registry still holds original
    f=f+cl_check("g5_squat_apply_ok",st,COMP_OK);
    f=f+cl_check("g5_squat_unchanged",tc_buf_equal(out,out2,128),1);
    st=comp_abstract(store,reg,4,11);           // abstract of unverified trace
    f=f+cl_check("g5_unver_refused",st,COMP_UNVERIFIED_LINK);
    st=comp_apply(store,reg,38,cueB,out);      // slot38 = [(NAMED,999)]
    f=f+cl_check("g5_unknown_name",st,COMP_NAME_UNKNOWN);
    nio_free(out);nio_free(out2);nio_free(ref);nio_free(ops);
    return f;
}
// G6: nesting — abstract over a named-use, compose over abstractions
fn tc_g6(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_abstract(store,reg,34,11);  // [(NAMED,7),(F,10)] -> flat 3 ops
    f=f+cl_check("g6_nested_abstract",st,COMP_OK);
    let ri:i32=tc_reg_find(reg,11);
    f=f+cl_check("g6_name11_found",(ri!=-1) as i32,1);
    f=f+cl_check("g6_flat_nops",tc_reg_get(reg,ri,4),3);
    f=f+cl_check("g6_flat_op0",tc_reg_op_get(reg,ri,0),OP_FILTER_GT);
    f=f+cl_check("g6_flat_par0",tc_reg_op_par(reg,ri,0),3);
    f=f+cl_check("g6_flat_op1",tc_reg_op_get(reg,ri,1),OP_MAP_MUL);
    f=f+cl_check("g6_flat_op2",tc_reg_op_get(reg,ri,2),OP_FILTER_GT);
    f=f+cl_check("g6_flat_par2",tc_reg_op_par(reg,ri,2),10);
    st=comp_apply(store,reg,36,cueB,out);      // slot36 = [(NAMED,11)]
    f=f+cl_check("g6_nested_use",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,3);tc_op_set_arr(ops,1,OP_MAP_MUL,2);
    tc_op_set_arr(ops,2,OP_FILTER_GT,10);
    tc_ref_apply(ops,3,cueB,ref);
    f=f+cl_check("g6_nested_oracle",tc_buf_equal(out,ref,128),1);
    st=comp_seq(store,34,2,35);                 // compose over a named-use trace
    f=f+cl_check("g6_seq_named_status",st,COMP_OK);
    f=f+cl_check("g6_seq_named_nops",tc_tr_get(store,35,12),3);
    f=f+cl_check("g6_seq_named_sources",tc_tr_get(store,35,16),68);
    f=f+cl_check("g6_seq_named_prov",tc_tr_get(store,35,8),PROV_COMPOSED);
    st=comp_apply(store,reg,35,cueB,out);
    f=f+cl_check("g6_seq_named_apply",st,COMP_OK);
    tc_op_set_arr(ops,3,OP_FILTER_GT,100);
    tc_ref_apply(ops,4,cueB,ref);
    f=f+cl_check("g6_seq_named_oracle",tc_buf_equal(out,ref,128),1);
    nio_free(out);nio_free(ref);nio_free(ops);
    return f;
}
// G7: determinism — identical rebuilds are byte-identical (no RNG anywhere)
fn tc_g7(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let saved:[]u8=nio_alloc(TC_TR_SZ);
    let out1:[]u8=nio_alloc(128);let out2:[]u8=nio_alloc(128);
    let st:i32=comp_seq(store,0,1,45);
    f=f+cl_check("g7_build1",st,COMP_OK);
    tc_rec_copy(store,45,saved);
    st=comp_seq(store,0,1,45);                  // rebuild into the same slot
    f=f+cl_check("g7_build2",st,COMP_OK);
    let cur:[]u8=nio_alloc(TC_TR_SZ);
    tc_rec_copy(store,45,cur);
    f=f+cl_check("g7_rebuild_identical",tc_buf_equal(saved,cur,TC_TR_SZ),1);
    st=comp_apply(store,reg,45,cueB,out1);
    f=f+cl_check("g7_apply1",st,COMP_OK);
    st=comp_apply(store,reg,45,cueB,out2);
    f=f+cl_check("g7_apply2",st,COMP_OK);
    f=f+cl_check("g7_apply_identical",tc_buf_equal(out1,out2,128),1);
    nio_free(saved);nio_free(cur);nio_free(out1);nio_free(out2);
    return f;
}
// G8: deep chain — 8 single-op traces folded into one 8-op composite
fn tc_g8(store:[]u8,reg:[]u8,cueA:[]u8)i32 {
    let f:i32=0;
    let out:[]u8=nio_alloc(128);let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_seq(store,10,11,43);
    st=comp_seq(store,43,12,44);
    st=comp_seq(store,44,13,43);
    st=comp_seq(store,43,14,44);
    st=comp_seq(store,44,15,43);
    st=comp_seq(store,43,16,44);
    st=comp_seq(store,44,17,43);
    f=f+cl_check("g8_fold_status",st,COMP_OK);
    f=f+cl_check("g8_nops",tc_tr_get(store,43,12),8);
    f=f+cl_check("g8_verified",tc_tr_get(store,43,4),1);
    st=comp_apply(store,reg,43,cueA,out);
    f=f+cl_check("g8_apply_status",st,COMP_OK);
    tc_op_set_arr(ops,0,OP_FILTER_GT,10);tc_op_set_arr(ops,1,OP_MAP_MUL,2);
    tc_op_set_arr(ops,2,OP_FILTER_GT,20);tc_op_set_arr(ops,3,OP_MAP_MUL,3);
    tc_op_set_arr(ops,4,OP_FILTER_GT,30);tc_op_set_arr(ops,5,OP_MAP_MUL,2);
    tc_op_set_arr(ops,6,OP_FILTER_GT,40);tc_op_set_arr(ops,7,OP_MAP_MUL,2);
    tc_ref_apply(ops,8,cueA,ref);
    f=f+cl_check("g8_deep_oracle",tc_buf_equal(out,ref,128),1);
    f=f+cl_check("g8_spot_50",out[50] as i32,176);  // hand-computed fold
    st=comp_seq(store,43,10,41);                    // 8+1 > 8: capacity refuses
    f=f+cl_check("g8_capacity_refused",st,COMP_CAPACITY);
    f=f+cl_check("g8_capacity_invalid",tc_tr_get(store,41,4),0);
    nio_free(out);nio_free(ref);nio_free(ops);
    return f;
}
// G9: reuse leverage (H4) — named refs store fewer op slots, same semantics
fn tc_g9(store:[]u8,reg:[]u8,cueB:[]u8)i32 {
    let f:i32=0;
    let o1:[]u8=nio_alloc(128);let o2:[]u8=nio_alloc(128);
    let ref:[]u8=nio_alloc(128);let ops:[]u8=nio_alloc(64);
    let st:i32=comp_seq(store,0,1,50);    // [(F,3),(M,2)]
    f=f+cl_check("g9_s1",st,COMP_OK);
    st=comp_seq(store,50,50,51);          // 4 ops
    f=f+cl_check("g9_s2",st,COMP_OK);
    st=comp_seq(store,51,51,52);          // 8 ops, fully expanded
    f=f+cl_check("g9_flat",st,COMP_OK);
    tc_mk(store,53,1,PROV_SELF_VERIFIED,64,4);  // 4 x (NAMED,7): reuse
    tc_op(store,53,0,OP_NAMED,7);tc_op(store,53,1,OP_NAMED,7);
    tc_op(store,53,2,OP_NAMED,7);tc_op(store,53,3,OP_NAMED,7);
    f=f+cl_check("g9_flat_nops",tc_tr_get(store,52,12),8);
    f=f+cl_check("g9_named_nops",tc_tr_get(store,53,12),4);
    st=comp_apply(store,reg,52,cueB,o1);
    f=f+cl_check("g9_flat_apply",st,COMP_OK);
    st=comp_apply(store,reg,53,cueB,o2);
    f=f+cl_check("g9_named_apply",st,COMP_OK);
    f=f+cl_check("g9_same_semantics",tc_buf_equal(o1,o2,128),1);
    tc_op_set_arr(ops,0,OP_FILTER_GT,3);tc_op_set_arr(ops,1,OP_MAP_MUL,2);
    tc_op_set_arr(ops,2,OP_FILTER_GT,3);tc_op_set_arr(ops,3,OP_MAP_MUL,2);
    tc_op_set_arr(ops,4,OP_FILTER_GT,3);tc_op_set_arr(ops,5,OP_MAP_MUL,2);
    tc_op_set_arr(ops,6,OP_FILTER_GT,3);tc_op_set_arr(ops,7,OP_MAP_MUL,2);
    tc_ref_apply(ops,8,cueB,ref);
    f=f+cl_check("g9_oracle",tc_buf_equal(o1,ref,128),1);
    f=f+cl_check("g9_footprint_shrinks",(tc_tr_get(store,53,12)<tc_tr_get(store,52,12)) as i32,1);
    nio_free(o1);nio_free(o2);nio_free(ref);nio_free(ops);
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_println("COMP_SUITE,start");
    let store:[]u8=nio_alloc(TC_MAX_TRACES*TC_TR_SZ);
    let reg:[]u8=nio_alloc((TC_MAX_NAMES+1)*TC_REG_SZ);
    let cueB:[]u8=nio_alloc(128);let cueW:[]u8=nio_alloc(128);let cueA:[]u8=nio_alloc(128);
    tc_cue_boundary(cueB);tc_cue_wrap(cueW);tc_cue_ramp(cueA);
    tc_setup(store);
    tc_reg_init_all(reg);
    f=f+tc_g1(store,reg,cueB,cueW);
    f=f+tc_g2(store,reg,cueB);
    f=f+tc_g3(store,reg);
    f=f+tc_g4(store,reg,cueB);
    f=f+tc_g5(store,reg,cueB);
    f=f+tc_g6(store,reg,cueB);
    f=f+tc_g7(store,reg,cueB);
    f=f+tc_g8(store,reg,cueA);
    f=f+tc_g9(store,reg,cueB);
    nio_free(store);nio_free(reg);nio_free(cueB);nio_free(cueW);nio_free(cueA);
    _zag_print("COMP_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

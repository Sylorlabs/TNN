// NSR trial driver — PREREG protocol (preregistered 2026-09-19, before any run).
// Arms: 0=SHIFT (designed), 1=SHIFT-LCG (seeded harness scaffolding only),
// 2=NO-SHIFT (churn control), 3=FROZEN (loop disabled), 4=SCALE (10x horizon).
// PROGRAM LAW: no RNG in the system. sr_core.zag contains none; the learner
// policy path below contains none. The designed world uses no RNG at all;
// arm 1 uses a seeded harness LCG for cue values/flips (scaffolding, labeled).
// The verdict distinguishes "the system is deterministic" from
// "the test was adversarial" (designed inversions + 3/16 flips).
@import("sr_core.zag")

const SR_PROBES:i32=16;

struct SrArmStats { diags:i32; promotes:i32; rollbacks:i32; exhausted:i32; }
struct SrResult {
    r1ep:i32; finalep:i32; audit_n:i32;
    promotes:i32; rollbacks:i32; diags:i32; exhausted:i32;
    replay:i32; attr:i32; clean:i32; just:i32; final_pack:i32;
}

fn sr_regime(arm:i32,ep:i32)i32 {
    if(arm==2){return 0;}
    if(arm==4){ if(((ep/56)%2)==0){return 0;} return 1; }
    if(ep<24){return 0;} if(ep<40){return 1;} return 0;
}
fn sr_neps(arm:i32)i32 { if(arm==4){return 560;} return 56; }

fn sr_lcg_next(r:*i32)i32 {
    r.*=((r.* * 1103515245 + 12345) & 2147483647);
    return r.*;
}
fn sr_cue_set(c:*Cue8,i:i32,v:i32)void {
    if(i==0){c.*.v0=v;} else if(i==1){c.*.v1=v;} else if(i==2){c.*.v2=v;}
    else if(i==3){c.*.v3=v;} else if(i==4){c.*.v4=v;} else if(i==5){c.*.v5=v;}
    else if(i==6){c.*.v6=v;} else {c.*.v7=v;}
}
// Designed cue sequence: fully explicit, no RNG. LCG arm: harness scaffolding.
fn sr_gen_cue(arm:i32,k:i32,p:i32,lcg:*i32,c:*Cue8)void {
    let i:i32=0;
    while(i<SR_C){
        let v:i32=0;
        if(arm==1){ v=sr_lcg_next(lcg)%1000; }
        else { v=(k*540+p*17+i*257+41)%1000; }
        sr_cue_set(c,i,v);
        i=i+1;
    }
}
fn sr_true_label(reg:i32,c:*Cue8)i32 {
    // R0 is an EXACT match for the base trace's predicate (amendment A3):
    // every R0 batch is exactly 13/16, so adversity is fully controlled —
    // the only dips are the designed dip episodes (10-11). R1 is the
    // structural inverse (amendment A2).
    if(reg==0){ return (c.*.v0>500) as i32; }
    return (c.*.v0<=500) as i32;
}
// Adversarial flips: standard 3/16 designed sequence; burst=1 is the
// designed dip curriculum (9/16 flips on episodes 10-11, monitoring only).
fn sr_flip(arm:i32,p:i32,lcg:*i32,burst:i32)i32 {
    if(arm==1){ return ((sr_lcg_next(lcg)%16)<3) as i32; }
    if(burst==1){ return ((p%16)<9) as i32; }
    return ((p%20)<3) as i32;
}

// One measured batch on a slot. Advances the batch counter (freshness).
// burst=1 marks a designed dip-curriculum batch (monitoring only — paired
// and endpoint measurements always use standard flips: a hypothesis must
// prove itself under normal measurement, not fit a noise burst).
fn sr_eval_batch(s:*SrStore,slot:i32,arm:i32,ep:i32,b:*i32,lcg:*i32,burst:i32)i32 {
    return sr_eval_batch_reg(s,slot,arm,b,lcg,sr_regime(arm,ep),burst);
}
fn sr_eval_batch_reg(s:*SrStore,slot:i32,arm:i32,b:*i32,lcg:*i32,reg:i32,burst:i32)i32 {
    let hits:i32=0;let p:i32=0;
    let rd:i32=s.*.tread[slot] as i32;
    let th:i32=sr_i32_get(s.*.thresh,slot*4);
    let iv:i32=s.*.tinv[slot] as i32;
    while(p<SR_PROBES){
        let c:Cue8=Cue8{.v0=0,.v1=0,.v2=0,.v3=0,.v4=0,.v5=0,.v6=0,.v7=0};
        sr_gen_cue(arm,b.*,p,lcg,&c);
        let lab:i32=sr_true_label(reg,&c);
        if(sr_flip(arm,p,lcg,burst)==1){lab=1-lab;}
        if(sr_pred(rd,th,iv,&c)==lab){hits=hits+1;}
        p=p+1;
    }
    b.*=b.*+1;
    return hits;
}

// Paired measurement: base and candidate evaluated on the IDENTICAL probe
// set (snapshot/rewind the batch counter and the harness LCG stream). Two
// fresh 32-probe batches per trace — the promotion decision gets more
// evidence than the diagnosis batch, so a single dip cannot promote.
// The batch is fresh (never used before); the comparison is fair.
fn sr_measure_pair(s:*SrStore,arm:i32,ep:i32,b:*i32,lcg:*i32,bh:*i32,ch:*i32)void {
    let b0:i32=b.*;let l0:i32=lcg.*;
    let h1:i32=sr_eval_batch(s,SR_SLOT_ACCEPTED,arm,ep,b,lcg,0);
    let h2:i32=sr_eval_batch(s,SR_SLOT_ACCEPTED,arm,ep,b,lcg,0);
    b.*=b0;lcg.*=l0;
    let c1:i32=sr_eval_batch(s,SR_SLOT_CANDIDATE,arm,ep,b,lcg,0);
    let c2:i32=sr_eval_batch(s,SR_SLOT_CANDIDATE,arm,ep,b,lcg,0);
    bh.*=h1+h2;ch.*=c1+c2;
}

// One episode. The learner policy is protocol-fixed in the harness (honest
// boundary, cf. HT1 §4): the MECHANISM (ops, gates, refusals) is under test.
fn sr_episode(s:*SrStore,arm:i32,ep:i32,b:*i32,lcg:*i32,st:*SrArmStats,err:*i32)void {
    // Designed dip curriculum: episodes 10-11 carry a 9/16 flip burst
    // (monitoring only). Every other adversity is the regime inversion.
    let burst:i32=0;
    if(arm!=1 && (ep==10 || ep==11)){burst=1;}
    let h:i32=sr_eval_batch(s,SR_SLOT_ACCEPTED,arm,ep,b,lcg,burst);
    if(sr_record(s,SR_SLOT_ACCEPTED,h,SR_PROBES)!=SR_OK){err.*=err.*+1;}
    if(arm==3){return;} // FROZEN: the revision loop is disabled.
    if(sr_maj_neg(h,SR_PROBES)==1){
        st.*.diags=st.*.diags+1;
        if(sr_diagnose(s)!=SR_OK){err.*=err.*+1;}
        // sr_propose refuses unless the diagnosis is SUSTAINED (withheld
        // commitment): a single failing batch only records the diagnosis.
        if(s.*.diag[SR_SLOT_ACCEPTED]==SR_DIAG_SUSTAINED){
            let prc:i32=sr_propose(s);
            if(prc==SR_OK){
                let bh:i32=0;let ch:i32=0;
                sr_measure_pair(s,arm,ep,b,lcg,&bh,&ch);
                if(sr_record(s,SR_SLOT_CANDIDATE,ch,32)!=SR_OK){err.*=err.*+1;}
                let rc:i32=sr_promote(s,bh,32,ch,32);
                if(rc==SR_OK){st.*.promotes=st.*.promotes+1;}
                else if(rc==SR_REFUSED_NOTBETTER){
                    if(sr_rollback(s)!=SR_OK){err.*=err.*+1;}
                    else {st.*.rollbacks=st.*.rollbacks+1;}
                } else {err.*=err.*+1;}
            } else if(prc==SR_REFUSED_EXHAUSTED){st.*.exhausted=st.*.exhausted+1;}
            else {err.*=err.*+1;}
        }
    }
}

fn sr_run_arm(arm:i32,seed:i32,res:*SrResult,err:*i32)void {
    let s:SrStore=sr_init();
    if(sr_seed(&s,0,500,0)!=SR_OK){err.*=err.*+1;}
    let b:i32=1000+seed*37;
    let lcg:i32=seed*1000+7;
    let st:SrArmStats=SrArmStats{.diags=0,.promotes=0,.rollbacks=0,.exhausted=0};
    let ep:i32=0;let ne:i32=sr_neps(arm);
    let r1ep:i32=0;
    while(ep<ne){
        sr_episode(&s,arm,ep,&b,&lcg,&st,err);
        // R1-phase endpoint, captured at the END of an R1 phase while the
        // R1-adapted structure is still accepted (read-only, fresh batches).
        // (Measuring at the end of the run would use the flipped-back R0
        // trace for the 2-inversion arms — bug found in attempt 2, fixed
        // here. For SCALE the last R1 phase ends at ep559 = ne-1.)
        if(arm==4){ if(ep==ne-1){ r1ep=sr_eval_batch_reg(&s,SR_SLOT_ACCEPTED,arm,&b,&lcg,1,0); } }
        else if(arm==2){ if(ep==ne-1){ r1ep=sr_eval_batch_reg(&s,SR_SLOT_ACCEPTED,arm,&b,&lcg,1,0); } }
        else { if(ep==39){ r1ep=sr_eval_batch_reg(&s,SR_SLOT_ACCEPTED,arm,&b,&lcg,1,0); } }
        ep=ep+1;
    }
    // Read-only final endpoint on fresh batches: measurement never feeds the
    // mechanism (H-07 evaluator separation; consumed probes never reused).
    let freg:i32=sr_regime(arm,ne-1);
    let f1:i32=sr_eval_batch_reg(&s,SR_SLOT_ACCEPTED,arm,&b,&lcg,freg,0);
    let f2:i32=sr_eval_batch_reg(&s,SR_SLOT_ACCEPTED,arm,&b,&lcg,freg,0);
    res.*.r1ep=r1ep;res.*.finalep=f1+f2;
    res.*.promotes=st.promotes;res.*.rollbacks=st.rollbacks;
    res.*.diags=st.diags;res.*.exhausted=st.exhausted;
    res.*.audit_n=s.audit_n;
    res.*.replay=sr_replay_check(&s);
    res.*.attr=sr_attribution_check(&s);
    res.*.clean=sr_audit_clean_refusals(&s);
    res.*.just=sr_promote_justified_scan(&s);
    res.*.final_pack=sr_slot_pack(&s,SR_SLOT_ACCEPTED);
    sr_free(&s);
}

// Unit tests with negative cases (playbook §12): every invariant paired with
// a tampered input that must fail. Scratch stores, separate from trial audit.
fn sr_units(err:*i32)void {
    let u:SrStore=sr_init();
    if(sr_diagnose(&u)!=SR_REFUSED_NOTLIVE){err.*=err.*+1;}          // 1
    if(sr_seed(&u,0,500,0)!=SR_OK){err.*=err.*+1;}                   // 2
    if(sr_seed(&u,0,500,0)!=SR_REFUSED_SEEDED){err.*=err.*+1;}
    if(sr_seed(&u,9,500,0)!=SR_REFUSED_BADVAL){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_CANDIDATE,8,16)!=SR_REFUSED_NOTLIVE){err.*=err.*+1;} // 3
    if(sr_record(&u,SR_SLOT_ACCEPTED,8,0)!=SR_REFUSED_BADVAL){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,9,8)!=SR_REFUSED_BADVAL){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}                       // 4
    if(u.diag[SR_SLOT_ACCEPTED]!=SR_DIAG_NONE){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_REFUSED_NODIAG){err.*=err.*+1;}             // 5
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}    // 6
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(u.diag[SR_SLOT_ACCEPTED]!=SR_DIAG_FAILING_MAJORITY){err.*=err.*+1;}
    // withheld commitment: a single failing batch never proposes.
    if(sr_propose(&u)!=SR_REFUSED_NODIAG){err.*=err.*+1;}
    if(u.live[SR_SLOT_CANDIDATE]!=0){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(u.diag[SR_SLOT_ACCEPTED]!=SR_DIAG_SUSTAINED){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&u,SR_SLOT_CANDIDATE)!=sr_pack(0,500,1)){err.*=err.*+1;}
    if(u.edit_idx[SR_SLOT_CANDIDATE]!=0){err.*=err.*+1;}
    if(sr_promote(&u,13,16,3,16)!=SR_REFUSED_NOTBETTER){err.*=err.*+1;} // 7
    if(sr_slot_pack(&u,SR_SLOT_ACCEPTED)!=sr_pack(0,500,0)){err.*=err.*+1;}
    if(u.live[SR_SLOT_CANDIDATE]!=1){err.*=err.*+1;}
    if(sr_rollback(&u)!=SR_OK){err.*=err.*+1;}                       // 8
    if(u.tried[SR_SLOT_ACCEPTED]!=1){err.*=err.*+1;}
    if(u.live[SR_SLOT_CANDIDATE]!=0){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&u,SR_SLOT_CANDIDATE)!=sr_pack(0,400,0)){err.*=err.*+1;} // edit1
    if(sr_rollback(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}    // 9
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&u,SR_SLOT_CANDIDATE)!=sr_pack(0,600,0)){err.*=err.*+1;} // edit2
    if(sr_rollback(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&u,SR_SLOT_CANDIDATE)!=sr_pack(1,500,0)){err.*=err.*+1;} // edit3
    if(sr_rollback(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&u,SR_SLOT_CANDIDATE)!=sr_pack(7,500,0)){err.*=err.*+1;} // edit4
    if(sr_rollback(&u)!=SR_OK){err.*=err.*+1;}
    if(u.tried[SR_SLOT_ACCEPTED]!=31){err.*=err.*+1;}
    if(sr_record(&u,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&u)!=SR_REFUSED_EXHAUSTED){err.*=err.*+1;}
    let v:SrStore=sr_init();                                         // 10
    if(sr_seed(&v,0,500,0)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&v,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&v,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_promote(&v,6,32,26,32)!=SR_OK){err.*=err.*+1;}
    if(sr_slot_pack(&v,SR_SLOT_ACCEPTED)!=sr_pack(0,500,1)){err.*=err.*+1;}
    if(v.live[SR_SLOT_CANDIDATE]!=0){err.*=err.*+1;}
    if(v.tried[SR_SLOT_ACCEPTED]!=0){err.*=err.*+1;}
    if(v.thits[SR_SLOT_ACCEPTED]!=26){err.*=err.*+1;}
    if(v.ttotal[SR_SLOT_ACCEPTED]!=32){err.*=err.*+1;}
    if(v.neg_streak[SR_SLOT_ACCEPTED]!=0){err.*=err.*+1;}
    if(sr_rollback(&v)!=SR_REFUSED_NOCAND){err.*=err.*+1;}            // 11
    if(sr_promote(&v,3,16,13,16)!=SR_REFUSED_NOCAND){err.*=err.*+1;}
    if(sr_audit_clean_refusals(&u)!=SR_OK){err.*=err.*+1;}           // 12
    if(sr_replay_check(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_attribution_check(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_promote_justified_scan(&u)!=SR_OK){err.*=err.*+1;}
    if(sr_audit_clean_refusals(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_replay_check(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_attribution_check(&v)!=SR_OK){err.*=err.*+1;}
    if(sr_promote_justified_scan(&v)!=SR_OK){err.*=err.*+1;}
    // 13. fix A: rejections are scoped to the failure episode — a healthy
    // batch expires them, so the hypothesis space is fresh for the next
    // failure (no dip-driven permanent lockout).
    let w:SrStore=sr_init();
    if(sr_seed(&w,0,500,0)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&w,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&w,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&w)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&w)!=SR_OK){err.*=err.*+1;}
    if(sr_rollback(&w)!=SR_OK){err.*=err.*+1;}
    if(w.tried[SR_SLOT_ACCEPTED]!=1){err.*=err.*+1;}
    if(sr_record(&w,SR_SLOT_ACCEPTED,13,16)!=SR_OK){err.*=err.*+1;}
    if(w.tried[SR_SLOT_ACCEPTED]!=0){err.*=err.*+1;}
    if(w.neg_streak[SR_SLOT_ACCEPTED]!=0){err.*=err.*+1;}
    if(sr_record(&w,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_record(&w,SR_SLOT_ACCEPTED,3,16)!=SR_OK){err.*=err.*+1;}
    if(sr_diagnose(&w)!=SR_OK){err.*=err.*+1;}
    if(sr_propose(&w)!=SR_OK){err.*=err.*+1;}
    if(w.edit_idx[SR_SLOT_CANDIDATE]!=0){err.*=err.*+1;}
    if(sr_audit_clean_refusals(&w)!=SR_OK){err.*=err.*+1;}
    if(sr_replay_check(&w)!=SR_OK){err.*=err.*+1;}
    sr_free(&w);
    sr_free(&u);sr_free(&v);
}

fn sr_stat6(tag:[]u8,a:i32,b:i32,c:i32,d:i32,e:i32,g:i32)void {
    _zag_print("SR_STAT,");_zag_print(tag);_zag_print(",");
    cl_number(a as i64);_zag_print(",");cl_number(b as i64);_zag_print(",");
    cl_number(c as i64);_zag_print(",");cl_number(d as i64);_zag_print(",");
    cl_number(e as i64);_zag_print(",");cl_number(g as i64);_zag_println("");
}

fn main()i32 {
    let f:i32=0;
    sr_units(&f);
    f=f+cl_check("units_err",f,0);
    let a0r1_0:i32=0;let a0r1_1:i32=0;let a0r1_2:i32=0;
    let a3r1_0:i32=0;let a3r1_1:i32=0;let a3r1_2:i32=0;
    let arm:i32=0;
    while(arm<5){
        let si:i32=0;
        while(si<3){
            let seed:i32=11;if(si==1){seed=22;} if(si==2){seed=33;}
            let res:SrResult=SrResult{.r1ep=0,.finalep=0,.audit_n=0,.promotes=0,.rollbacks=0,
                .diags=0,.exhausted=0,.replay=0,.attr=0,.clean=0,.just=0,.final_pack=0};
            sr_run_arm(arm,seed,&res,&f);
            sr_stat6("run",arm,seed,res.diags,res.promotes,res.rollbacks,res.exhausted);
            sr_stat6("endpoints",arm,seed,res.r1ep,res.finalep,res.audit_n,res.final_pack);
            // White-box law: every run, every arm.
            f=f+cl_check("wb_replay",res.replay,0);
            f=f+cl_check("wb_attr",res.attr,0);
            f=f+cl_check("wb_clean",res.clean,0);
            f=f+cl_check("wb_just",res.just,0);
            if(arm==0){
                f=f+cl_check("shift_promotes_ge1",(res.promotes>=1) as i32,1);
                f=f+cl_check("shift_r1ep",(res.r1ep>=10) as i32,1);
                f=f+cl_check("shift_finalep",(res.finalep>=20) as i32,1);
                if(si==0){a0r1_0=res.r1ep;} else if(si==1){a0r1_1=res.r1ep;} else {a0r1_2=res.r1ep;}
            } else if(arm==1){
                f=f+cl_check("lcg_promotes_ge1",(res.promotes>=1) as i32,1);
                f=f+cl_check("lcg_r1ep",(res.r1ep>=9) as i32,1);
                f=f+cl_check("lcg_finalep",(res.finalep>=20) as i32,1);
            } else if(arm==2){
                f=f+cl_check("noshift_promotes_zero",res.promotes,0);
                f=f+cl_check("noshift_finalep",(res.finalep>=20) as i32,1);
            } else if(arm==3){
                if(si==0){a3r1_0=res.r1ep;} else if(si==1){a3r1_1=res.r1ep;} else {a3r1_2=res.r1ep;}
            } else {
                f=f+cl_check("scale_promotes_9",(res.promotes>=8 && res.promotes<=10) as i32,1);
                f=f+cl_check("scale_finalep",(res.finalep>=20) as i32,1);
            }
            si=si+1;
        }
        arm=arm+1;
    }
    // Cross-arm: the revision must account for the recovery (per-seed pairing).
    f=f+cl_check("diff_shift_frozen_s0",((a0r1_0-a3r1_0)>=5) as i32,1);
    f=f+cl_check("diff_shift_frozen_s1",((a0r1_1-a3r1_1)>=5) as i32,1);
    f=f+cl_check("diff_shift_frozen_s2",((a0r1_2-a3r1_2)>=5) as i32,1);
    sr_stat6("diff",a0r1_0,a3r1_0,a0r1_1,a3r1_1,a0r1_2,a3r1_2);
    _zag_print("SR_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}

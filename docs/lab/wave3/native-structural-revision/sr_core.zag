// NSR — native structural revision core (schema-faithful to R27 self_revision_history).
// The system's STRUCTURE is a symbolic trace: (read component, FILTER_GT threshold,
// polarity) over a cue vector — the native analog of R27's Trace (symbolic opcodes
// over cue vectors; operations, not gradients). Learning is a structural EDIT to the
// trace, never a number going up or down: no score table, no accumulator, no argmax,
// no reward signal anywhere in this file.
//
// PROGRAM LAW: no RNG in the system. Diagnosis is a deterministic function of recorded
// evidence; proposal derivation is a fixed ordered edit list; promotion is a measured
// comparison. Same state -> same ops. (The harness may generate the world; the system
// never draws randomness.)
@import("substrate/cl/common.zag")

const SR_OP_SEED:i32=1;
const SR_OP_RECORD:i32=2;
const SR_OP_DIAGNOSE:i32=3;
const SR_OP_PROPOSE:i32=4;
const SR_OP_PROMOTE:i32=5;
const SR_OP_ROLLBACK:i32=6;

const SR_OK:i32=0;
const SR_REFUSED_NOTLIVE:i32=101;
const SR_REFUSED_BADVAL:i32=102;
const SR_REFUSED_SEEDED:i32=103;
const SR_REFUSED_NODIAG:i32=104;
const SR_REFUSED_EXHAUSTED:i32=105;
const SR_REFUSED_NOTBETTER:i32=106;
const SR_REFUSED_NOCAND:i32=107;
const SR_REFUSED_BADSLOT:i32=108;
const SR_REFUSED_BUSY:i32=109;

const SR_DIAG_NONE:i32=0;
const SR_DIAG_FAILING_MAJORITY:i32=1;
const SR_DIAG_SUSTAINED:i32=2;

const SR_SLOT_ACCEPTED:i32=0;
const SR_SLOT_CANDIDATE:i32=1;
const SR_NSLOT:i32=2;
const SR_C:i32=8;        // cue components
const SR_NEDIT:i32=5;    // structural edit neighborhood size
const SR_AUDIT_WORDS:i32=10; // op,slot,rc,b1,b2,b3,a1,a2,a3,clock
const SR_AUDIT_CAP:i32=8192;

struct Cue8 { v0:i32; v1:i32; v2:i32; v3:i32; v4:i32; v5:i32; v6:i32; v7:i32; }

struct SrStore {
    live: []u8,       // per slot
    tread: []u8,      // read component index (the trace's READ)
    thresh: []u8,     // packed i32 per slot (FILTER_GT threshold 0..1000)
    tinv: []u8,       // polarity (the trace's comparison direction)
    thits: []u8,      // RECORDED probe evidence: observations, replaced per batch
    ttotal: []u8,
    edit_idx: []u8,   // candidate slot: which structural edit it embodies
    diag: []u8,       // per-slot last diagnosis code (slot 0 used)
    neg_streak: []u8, // consecutive majority-negative batches on accepted
    tried: []u8,      // bitmask of rejected edits for the current accepted base
    audit: []u8,
    audit_n: i32,
    clock: i32
}

fn sr_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn sr_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
// The trace packed as one i32: read (4 bits) | thresh (10 bits) | inv (1 bit).
fn sr_pack(read:i32,thresh:i32,inv:i32)i32 { return read|((thresh&1023)<<4)|((inv&1)<<14); }
fn sr_unpack_read(p:i32)i32 { return p&15; }
fn sr_unpack_thresh(p:i32)i32 { return (p>>4)&1023; }
fn sr_unpack_inv(p:i32)i32 { return (p>>14)&1; }
fn sr_evp(hits:i32,total:i32)i32 { return (hits&255)|((total&255)<<8); }

fn sr_comp(c:*Cue8,i:i32)i32 {
    if(i==0){return c.*.v0;} if(i==1){return c.*.v1;}
    if(i==2){return c.*.v2;} if(i==3){return c.*.v3;}
    if(i==4){return c.*.v4;} if(i==5){return c.*.v5;}
    if(i==6){return c.*.v6;} return c.*.v7;
}
// The trace evaluated: READ component i, FILTER_GT threshold, polarity.
fn sr_pred(read:i32,thresh:i32,inv:i32,c:*Cue8)i32 {
    let v:i32=sr_comp(c,read);
    let p:i32=(v>thresh) as i32;
    if(inv==1){p=1-p;}
    return p;
}
fn sr_maj_neg(hits:i32,total:i32)i32 { return (total>0 && hits*2<total) as i32; }
fn sr_maj_pos(hits:i32,total:i32)i32 { return (total>0 && hits*2>total) as i32; }

fn sr_init()SrStore {
    let live:[]u8=nio_alloc(SR_NSLOT);
    let tread:[]u8=nio_alloc(SR_NSLOT);
    let thresh:[]u8=nio_alloc(SR_NSLOT*4);
    let tinv:[]u8=nio_alloc(SR_NSLOT);
    let thits:[]u8=nio_alloc(SR_NSLOT);
    let ttotal:[]u8=nio_alloc(SR_NSLOT);
    let edit_idx:[]u8=nio_alloc(SR_NSLOT);
    let diag:[]u8=nio_alloc(SR_NSLOT);
    let neg_streak:[]u8=nio_alloc(SR_NSLOT);
    let tried:[]u8=nio_alloc(SR_NSLOT);
    let audit:[]u8=nio_alloc(SR_AUDIT_CAP*SR_AUDIT_WORDS*4);
    // nio_alloc is NOT zeroed (playbook §12) — zero everything by hand.
    let i:i32=0;while(i<SR_NSLOT){live[i]=0;tread[i]=0;tinv[i]=0;thits[i]=0;ttotal[i]=0;edit_idx[i]=0;diag[i]=0;neg_streak[i]=0;tried[i]=0;i=i+1;}
    i=0;while(i<SR_NSLOT*4){thresh[i]=0;i=i+1;}
    i=0;while(i<SR_AUDIT_CAP*SR_AUDIT_WORDS*4){audit[i]=0;i=i+1;}
    return SrStore{.live=live,.tread=tread,.thresh=thresh,.tinv=tinv,.thits=thits,.ttotal=ttotal,
        .edit_idx=edit_idx,.diag=diag,.neg_streak=neg_streak,.tried=tried,
        .audit=audit,.audit_n=0,.clock=0};
}
fn sr_free(s:*SrStore)void {
    nio_free(s.*.live);nio_free(s.*.tread);nio_free(s.*.thresh);nio_free(s.*.tinv);
    nio_free(s.*.thits);nio_free(s.*.ttotal);nio_free(s.*.edit_idx);nio_free(s.*.diag);
    nio_free(s.*.neg_streak);nio_free(s.*.tried);nio_free(s.*.audit);
}

fn sr_audit_append(s:*SrStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)void {
    if(s.*.audit_n>=SR_AUDIT_CAP){return;}
    let e:i32=s.*.audit_n*SR_AUDIT_WORDS*4;
    sr_i32_set(s.*.audit,e+0,op);sr_i32_set(s.*.audit,e+4,slot);sr_i32_set(s.*.audit,e+8,rc);
    sr_i32_set(s.*.audit,e+12,b1);sr_i32_set(s.*.audit,e+16,b2);sr_i32_set(s.*.audit,e+20,b3);
    sr_i32_set(s.*.audit,e+24,a1);sr_i32_set(s.*.audit,e+28,a2);sr_i32_set(s.*.audit,e+32,a3);
    sr_i32_set(s.*.audit,e+36,s.*.clock);
    s.*.audit_n=s.*.audit_n+1;s.*.clock=s.*.clock+1;
}
fn sr_badslot(slot:i32)i32 { if(slot<0 || slot>=SR_NSLOT){return 1;} return 0; }
fn sr_slot_pack(s:*SrStore,slot:i32)i32 {
    return sr_pack(s.*.tread[slot] as i32, sr_i32_get(s.*.thresh,slot*4), s.*.tinv[slot] as i32);
}

// Boot commitment of the accepted structure. No prior structure exists, so
// there is nothing to corroborate against (cf. CTX_SEED).
fn sr_seed(s:*SrStore,read:i32,thresh:i32,inv:i32)i32 {
    if(s==null as *SrStore){return cl_bad();}
    if(read<0 || read>=SR_C || thresh<0 || thresh>1000 || (inv!=0 && inv!=1)){
        sr_audit_append(s,SR_OP_SEED,SR_SLOT_ACCEPTED,SR_REFUSED_BADVAL,0,0,0,0,0,0);
        return SR_REFUSED_BADVAL;
    }
    if(s.*.live[SR_SLOT_ACCEPTED]==1){
        sr_audit_append(s,SR_OP_SEED,SR_SLOT_ACCEPTED,SR_REFUSED_SEEDED,0,0,0,0,0,0);
        return SR_REFUSED_SEEDED;
    }
    s.*.live[SR_SLOT_ACCEPTED]=1;
    s.*.tread[SR_SLOT_ACCEPTED]=read as u8;sr_i32_set(s.*.thresh,0,thresh);s.*.tinv[SR_SLOT_ACCEPTED]=inv as u8;
    s.*.thits[SR_SLOT_ACCEPTED]=0;s.*.ttotal[SR_SLOT_ACCEPTED]=0;
    sr_audit_append(s,SR_OP_SEED,SR_SLOT_ACCEPTED,SR_OK,0,0,0,sr_pack(read,thresh,inv),0,0);
    return SR_OK;
}

// Deliberate act of recording a measured batch. REPLACES the evidence window:
// observations, never accumulated. The sustained-failure streak is a
// deterministic function of the recorded evidence — mechanism, not policy.
fn sr_record(s:*SrStore,slot:i32,hits:i32,total:i32)i32 {
    if(s==null as *SrStore || sr_badslot(slot)==1){return cl_bad();}
    if(s.*.live[slot]==0){sr_audit_append(s,SR_OP_RECORD,slot,SR_REFUSED_NOTLIVE,0,0,0,0,0,0);return SR_REFUSED_NOTLIVE;}
    if(total<1 || total>32 || hits<0 || hits>total){
        sr_audit_append(s,SR_OP_RECORD,slot,SR_REFUSED_BADVAL,0,0,0,0,0,0);return SR_REFUSED_BADVAL;
    }
    let old:i32=sr_evp(s.*.thits[slot] as i32, s.*.ttotal[slot] as i32);
    s.*.thits[slot]=hits as u8;s.*.ttotal[slot]=total as u8;
    if(slot==SR_SLOT_ACCEPTED){
        if(sr_maj_neg(hits,total)==1){s.*.neg_streak[slot]=s.*.neg_streak[slot]+1;}
        else{
            // A healthy measurement ends the failure episode: old rejections
            // expire. Rejections are conditional on the failure context — a
            // dip must not permanently burn the hypothesis space, or a later
            // genuine shift finds EXHAUSTED (failure found in attempt 3).
            s.*.neg_streak[slot]=0;s.*.tried[slot]=0;
        }
    }
    sr_audit_append(s,SR_OP_RECORD,slot,SR_OK,old,0,0,sr_evp(hits,total),0,0);
    return SR_OK;
}

// The diagnosis is DECLARED from recorded evidence — a deterministic function,
// never a feeling. streak>=2 -> SUSTAINED, streak>=1 -> FAILING_MAJORITY.
fn sr_diagnose(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    if(s.*.live[SR_SLOT_ACCEPTED]==0){
        sr_audit_append(s,SR_OP_DIAGNOSE,SR_SLOT_ACCEPTED,SR_REFUSED_NOTLIVE,0,0,0,0,0,0);
        return SR_REFUSED_NOTLIVE;
    }
    let old:i32=s.*.diag[SR_SLOT_ACCEPTED] as i32;
    let code:i32=SR_DIAG_NONE;
    if(s.*.neg_streak[SR_SLOT_ACCEPTED]>=2){code=SR_DIAG_SUSTAINED;}
    else if(s.*.neg_streak[SR_SLOT_ACCEPTED]>=1){code=SR_DIAG_FAILING_MAJORITY;}
    s.*.diag[SR_SLOT_ACCEPTED]=code as u8;
    sr_audit_append(s,SR_OP_DIAGNOSE,SR_SLOT_ACCEPTED,SR_OK,old,0,0,code,0,0);
    return SR_OK;
}

// Fixed ordered structural edit neighborhood. Deterministic hypothesis
// generation: no sampling, no RNG. tried_mask skips already-rejected edits
// for this base — proposals are educated (systematic), never random.
// Returns 1 and fills out_* on success, 0 when the neighborhood is exhausted.
fn sr_derive(base_read:i32,base_thresh:i32,base_inv:i32,tried_mask:i32,
             out_read:*i32,out_thresh:*i32,out_inv:*i32,out_idx:*i32)i32 {
    let idx:i32=0;
    while(idx<SR_NEDIT){
        if(((tried_mask>>idx)&1)==0){
            let r:i32=base_read;let t:i32=base_thresh;let v:i32=base_inv;
            if(idx==0){v=1-v;}
            else if(idx==1){t=t-100;if(t<0){t=0;}}
            else if(idx==2){t=t+100;if(t>1000){t=1000;}}
            else if(idx==3){r=(r+1)%SR_C;}
            else {r=(r+SR_C-1)%SR_C;}
            if(r!=base_read || t!=base_thresh || v!=base_inv){
                out_read.*=r;out_thresh.*=t;out_inv.*=v;out_idx.*=idx;
                return 1;
            }
        }
        idx=idx+1;
    }
    return 0;
}

// Propose ONE structural variant into the candidate (quarantine) slot.
// Requires a SUSTAINED diagnosis: a single majority-negative batch cannot
// distinguish a noise dip from a regime shift, so the mechanism withholds
// proposals until the failure is corroborated across consecutive batches
// (the anti-LH-5 lesson: corroboration before commitment). Otherwise
// REFUSED_NODIAG — the refusal is structural, in the op implementation.
fn sr_propose(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    if(s.*.live[SR_SLOT_ACCEPTED]==0){
        sr_audit_append(s,SR_OP_PROPOSE,SR_SLOT_CANDIDATE,SR_REFUSED_NOTLIVE,0,0,0,0,0,0);
        return SR_REFUSED_NOTLIVE;
    }
    if(s.*.diag[SR_SLOT_ACCEPTED]!=SR_DIAG_SUSTAINED){
        let bp:i32=sr_slot_pack(s,SR_SLOT_ACCEPTED);
        let dg:i32=s.*.diag[SR_SLOT_ACCEPTED] as i32;
        sr_audit_append(s,SR_OP_PROPOSE,SR_SLOT_CANDIDATE,SR_REFUSED_NODIAG,bp,dg,0,bp,dg,0);
        return SR_REFUSED_NODIAG;
    }
    if(s.*.live[SR_SLOT_CANDIDATE]==1){
        let bp2:i32=sr_slot_pack(s,SR_SLOT_ACCEPTED);
        sr_audit_append(s,SR_OP_PROPOSE,SR_SLOT_CANDIDATE,SR_REFUSED_BUSY,bp2,bp2,bp2,bp2,bp2,bp2);
        return SR_REFUSED_BUSY;
    }
    let br:i32=s.*.tread[SR_SLOT_ACCEPTED] as i32;
    let bt:i32=sr_i32_get(s.*.thresh,0);
    let bv:i32=s.*.tinv[SR_SLOT_ACCEPTED] as i32;
    let r:i32=0;let t:i32=0;let v:i32=0;let idx:i32=0;
    if(sr_derive(br,bt,bv,s.*.tried[SR_SLOT_ACCEPTED] as i32,&r,&t,&v,&idx)==0){
        let bp3:i32=sr_pack(br,bt,bv);
        sr_audit_append(s,SR_OP_PROPOSE,SR_SLOT_CANDIDATE,SR_REFUSED_EXHAUSTED,bp3,bp3,bp3,bp3,bp3,bp3);
        return SR_REFUSED_EXHAUSTED;
    }
    s.*.live[SR_SLOT_CANDIDATE]=1;
    s.*.tread[SR_SLOT_CANDIDATE]=r as u8;sr_i32_set(s.*.thresh,4,t);s.*.tinv[SR_SLOT_CANDIDATE]=v as u8;
    s.*.thits[SR_SLOT_CANDIDATE]=0;s.*.ttotal[SR_SLOT_CANDIDATE]=0;
    s.*.edit_idx[SR_SLOT_CANDIDATE]=idx as u8;
    sr_audit_append(s,SR_OP_PROPOSE,SR_SLOT_CANDIDATE,SR_OK,sr_pack(br,bt,bv),0,0,sr_pack(r,t,v),idx,0);
    return SR_OK;
}

// THE promotion gate (the E51AJ law, structural): commit candidate -> accepted
// iff the candidate is strictly better than the base on the paired batch AND
// the candidate is majority-positive AND the base is majority-negative.
// Otherwise REFUSED_NOTBETTER — the refusal is structural, in the op.
// This is the only path that writes the accepted structure (besides SEED).
fn sr_promote(s:*SrStore,base_hits:i32,base_total:i32,cand_hits:i32,cand_total:i32)i32 {
    if(s==null as *SrStore){return cl_bad();}
    if(s.*.live[SR_SLOT_CANDIDATE]==0){
        sr_audit_append(s,SR_OP_PROMOTE,SR_SLOT_ACCEPTED,SR_REFUSED_NOCAND,0,0,0,0,0,0);
        return SR_REFUSED_NOCAND;
    }
    let bp:i32=sr_slot_pack(s,SR_SLOT_ACCEPTED);
    let bev:i32=sr_evp(s.*.thits[SR_SLOT_ACCEPTED] as i32, s.*.ttotal[SR_SLOT_ACCEPTED] as i32);
    let cev:i32=sr_evp(cand_hits,cand_total);
    if(base_total<1 || base_total>32 || base_hits<0 || base_hits>base_total ||
       cand_total<1 || cand_total>32 || cand_hits<0 || cand_hits>cand_total){
        sr_audit_append(s,SR_OP_PROMOTE,SR_SLOT_ACCEPTED,SR_REFUSED_BADVAL,bp,bev,cev,bp,bev,cev);
        return SR_REFUSED_BADVAL;
    }
    let better:i32=(cand_hits>base_hits) as i32;
    let candpos:i32=sr_maj_pos(cand_hits,cand_total);
    let baseneg:i32=sr_maj_neg(base_hits,base_total);
    if(better==0 || candpos==0 || baseneg==0){
        // b's == a's: refusal cleanliness (state untouched).
        sr_audit_append(s,SR_OP_PROMOTE,SR_SLOT_ACCEPTED,SR_REFUSED_NOTBETTER,bp,bev,cev,bp,bev,cev);
        return SR_REFUSED_NOTBETTER;
    }
    let cp:i32=sr_slot_pack(s,SR_SLOT_CANDIDATE);
    s.*.tread[SR_SLOT_ACCEPTED]=s.*.tread[SR_SLOT_CANDIDATE];
    sr_i32_set(s.*.thresh,0,sr_i32_get(s.*.thresh,4));
    s.*.tinv[SR_SLOT_ACCEPTED]=s.*.tinv[SR_SLOT_CANDIDATE];
    s.*.thits[SR_SLOT_ACCEPTED]=cand_hits as u8;s.*.ttotal[SR_SLOT_ACCEPTED]=cand_total as u8;
    s.*.tried[SR_SLOT_ACCEPTED]=0;s.*.diag[SR_SLOT_ACCEPTED]=0;s.*.neg_streak[SR_SLOT_ACCEPTED]=0;
    s.*.live[SR_SLOT_CANDIDATE]=0;
    s.*.tread[SR_SLOT_CANDIDATE]=0;sr_i32_set(s.*.thresh,4,0);s.*.tinv[SR_SLOT_CANDIDATE]=0;
    s.*.thits[SR_SLOT_CANDIDATE]=0;s.*.ttotal[SR_SLOT_CANDIDATE]=0;s.*.edit_idx[SR_SLOT_CANDIDATE]=0;
    sr_audit_append(s,SR_OP_PROMOTE,SR_SLOT_ACCEPTED,SR_OK,bp,bev,cev,cp,cand_hits|(cand_total<<8),0);
    return SR_OK;
}

// Discard the candidate: quarantine the damage. The rejected edit is
// remembered in `tried` — a rejected hypothesis is not retried for this base.
fn sr_rollback(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    if(s.*.live[SR_SLOT_CANDIDATE]==0){
        sr_audit_append(s,SR_OP_ROLLBACK,SR_SLOT_CANDIDATE,SR_REFUSED_NOCAND,0,0,0,0,0,0);
        return SR_REFUSED_NOCAND;
    }
    let cp:i32=sr_slot_pack(s,SR_SLOT_CANDIDATE);
    let idx:i32=s.*.edit_idx[SR_SLOT_CANDIDATE] as i32;
    s.*.tried[SR_SLOT_ACCEPTED]=(s.*.tried[SR_SLOT_ACCEPTED]|((1<<idx) as u8)) as u8;
    s.*.live[SR_SLOT_CANDIDATE]=0;
    s.*.tread[SR_SLOT_CANDIDATE]=0;sr_i32_set(s.*.thresh,4,0);s.*.tinv[SR_SLOT_CANDIDATE]=0;
    s.*.thits[SR_SLOT_CANDIDATE]=0;s.*.ttotal[SR_SLOT_CANDIDATE]=0;s.*.edit_idx[SR_SLOT_CANDIDATE]=0;
    s.*.diag[SR_SLOT_ACCEPTED]=0;
    sr_audit_append(s,SR_OP_ROLLBACK,SR_SLOT_CANDIDATE,SR_OK,cp,idx,0,0,idx,0);
    return SR_OK;
}

// Invariant 1: every refused op left state untouched (b's == a's).
fn sr_audit_clean_refusals(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*SR_AUDIT_WORDS*4;
        if(sr_i32_get(s.*.audit,e+8)!=SR_OK){
            if(sr_i32_get(s.*.audit,e+12)!=sr_i32_get(s.*.audit,e+24)){return 1;}
            if(sr_i32_get(s.*.audit,e+16)!=sr_i32_get(s.*.audit,e+28)){return 1;}
            if(sr_i32_get(s.*.audit,e+20)!=sr_i32_get(s.*.audit,e+32)){return 1;}
        }
        i=i+1;
    }
    return SR_OK;
}

// Invariant 2: ledger replay from genesis reconstructs exact live state.
fn sr_replay_check(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    let sh:SrStore=sr_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*SR_AUDIT_WORDS*4;
        let op:i32=sr_i32_get(s.*.audit,e+0);let slot:i32=sr_i32_get(s.*.audit,e+4);
        let rc:i32=sr_i32_get(s.*.audit,e+8);
        if(rc==SR_OK){
            if(op==SR_OP_SEED){
                let p:i32=sr_i32_get(s.*.audit,e+24);
                sh.live[SR_SLOT_ACCEPTED]=1;
                sh.tread[SR_SLOT_ACCEPTED]=sr_unpack_read(p) as u8;
                sr_i32_set(sh.thresh,0,sr_unpack_thresh(p));
                sh.tinv[SR_SLOT_ACCEPTED]=sr_unpack_inv(p) as u8;
            } else if(op==SR_OP_RECORD){
                let w:i32=sr_i32_get(s.*.audit,e+24);
                let h:i32=w&255;let t:i32=(w>>8)&255;
                sh.thits[slot]=h as u8;sh.ttotal[slot]=t as u8;
                if(slot==SR_SLOT_ACCEPTED){
                    if(sr_maj_neg(h,t)==1){sh.neg_streak[slot]=sh.neg_streak[slot]+1;}
                    else {sh.neg_streak[slot]=0;sh.tried[slot]=0;}
                }
            } else if(op==SR_OP_DIAGNOSE){
                sh.diag[SR_SLOT_ACCEPTED]=sr_i32_get(s.*.audit,e+24) as u8;
            } else if(op==SR_OP_PROPOSE){
                let p2:i32=sr_i32_get(s.*.audit,e+24);
                sh.live[SR_SLOT_CANDIDATE]=1;
                sh.tread[SR_SLOT_CANDIDATE]=sr_unpack_read(p2) as u8;
                sr_i32_set(sh.thresh,4,sr_unpack_thresh(p2));
                sh.tinv[SR_SLOT_CANDIDATE]=sr_unpack_inv(p2) as u8;
                sh.edit_idx[SR_SLOT_CANDIDATE]=sr_i32_get(s.*.audit,e+28) as u8;
            } else if(op==SR_OP_PROMOTE){
                let p3:i32=sr_i32_get(s.*.audit,e+24);
                sh.tread[SR_SLOT_ACCEPTED]=sr_unpack_read(p3) as u8;
                sr_i32_set(sh.thresh,0,sr_unpack_thresh(p3));
                sh.tinv[SR_SLOT_ACCEPTED]=sr_unpack_inv(p3) as u8;
                let w2:i32=sr_i32_get(s.*.audit,e+28);
                sh.thits[SR_SLOT_ACCEPTED]=(w2&255) as u8;sh.ttotal[SR_SLOT_ACCEPTED]=((w2>>8)&255) as u8;
                sh.tried[SR_SLOT_ACCEPTED]=0;sh.diag[SR_SLOT_ACCEPTED]=0;sh.neg_streak[SR_SLOT_ACCEPTED]=0;
                // the live op zeroes the whole candidate slot — replay must too.
                sh.live[SR_SLOT_CANDIDATE]=0;
                sh.tread[SR_SLOT_CANDIDATE]=0;sr_i32_set(sh.thresh,4,0);sh.tinv[SR_SLOT_CANDIDATE]=0;
                sh.thits[SR_SLOT_CANDIDATE]=0;sh.ttotal[SR_SLOT_CANDIDATE]=0;
                sh.edit_idx[SR_SLOT_CANDIDATE]=0;
            } else if(op==SR_OP_ROLLBACK){
                let idx:i32=sr_i32_get(s.*.audit,e+28);
                sh.tried[SR_SLOT_ACCEPTED]=(sh.tried[SR_SLOT_ACCEPTED]|((1<<idx) as u8)) as u8;
                sh.live[SR_SLOT_CANDIDATE]=0;
                sh.tread[SR_SLOT_CANDIDATE]=0;sr_i32_set(sh.thresh,4,0);sh.tinv[SR_SLOT_CANDIDATE]=0;
                sh.thits[SR_SLOT_CANDIDATE]=0;sh.ttotal[SR_SLOT_CANDIDATE]=0;
                sh.edit_idx[SR_SLOT_CANDIDATE]=0;
                sh.diag[SR_SLOT_ACCEPTED]=0;
            }
        }
        i=i+1;
    }
    let bad:i32=0;let k:i32=0;
    while(k<SR_NSLOT){
        if(sh.live[k]!=s.*.live[k]){bad=1;}
        if(sh.tread[k]!=s.*.tread[k]){bad=1;}
        if(sr_i32_get(sh.thresh,k*4)!=sr_i32_get(s.*.thresh,k*4)){bad=1;}
        if(sh.tinv[k]!=s.*.tinv[k]){bad=1;}
        if(sh.thits[k]!=s.*.thits[k]){bad=1;}
        if(sh.ttotal[k]!=s.*.ttotal[k]){bad=1;}
        if(sh.edit_idx[k]!=s.*.edit_idx[k]){bad=1;}
        if(sh.diag[k]!=s.*.diag[k]){bad=1;}
        if(sh.neg_streak[k]!=s.*.neg_streak[k]){bad=1;}
        if(sh.tried[k]!=s.*.tried[k]){bad=1;}
        k=k+1;
    }
    sr_free(&sh);
    if(bad==1){return 1;}
    return SR_OK;
}

// Invariant 3 (the anti-hardcode proof): the accepted structure's symbolic
// fields changed only via SEED/PROMOTE entries — no other path writes them.
fn sr_attribution_check(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    let shadow:i32=0;let seeded:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*SR_AUDIT_WORDS*4;
        let op:i32=sr_i32_get(s.*.audit,e+0);
        let rc:i32=sr_i32_get(s.*.audit,e+8);
        if(rc==SR_OK){
            if(op==SR_OP_SEED){shadow=sr_i32_get(s.*.audit,e+24);seeded=1;}
            else if(op==SR_OP_PROMOTE){
                if(seeded==0){return 1;}
                // the promoted-from base must match the shadow (no silent drift)
                if(sr_i32_get(s.*.audit,e+12)!=shadow){return 1;}
                shadow=sr_i32_get(s.*.audit,e+24);
            }
        }
        i=i+1;
    }
    if(seeded==0){return 1;}
    if(shadow!=sr_slot_pack(s,SR_SLOT_ACCEPTED)){return 1;}
    return SR_OK;
}

// Invariant 4 (the anti-churn scan): every committed PROMOTE carried a
// strictly-better, majority-positive candidate over a majority-negative base.
fn sr_promote_justified_scan(s:*SrStore)i32 {
    if(s==null as *SrStore){return cl_bad();}
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*SR_AUDIT_WORDS*4;
        if(sr_i32_get(s.*.audit,e+0)==SR_OP_PROMOTE && sr_i32_get(s.*.audit,e+8)==SR_OK){
            let b2:i32=sr_i32_get(s.*.audit,e+16);let b3:i32=sr_i32_get(s.*.audit,e+20);
            let bh:i32=b2&255;let bt:i32=(b2>>8)&255;
            let ch:i32=b3&255;let ct:i32=(b3>>8)&255;
            if(ch<=bh){return 1;}
            if(sr_maj_pos(ch,ct)==0){return 1;}
            if(sr_maj_neg(bh,bt)==0){return 1;}
        }
        i=i+1;
    }
    return SR_OK;
}

fn sr_count_op_rc(s:*SrStore,op:i32,rc:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*SR_AUDIT_WORDS*4;
        if(sr_i32_get(s.*.audit,e+0)==op && sr_i32_get(s.*.audit,e+8)==rc){n=n+1;}
        i=i+1;
    }
    return n;
}

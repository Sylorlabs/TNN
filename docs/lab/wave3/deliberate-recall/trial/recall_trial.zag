// Deliberate-recall trial driver — PREREG protocol.
// SYSTEM: declare need -> logical recall -> act -> pin (no RNG, no scores).
// EVALUATOR (marked below): similarity baseline, tau-sweep, scoring vs
// ground truth. The system path never receives ground truth.
// Zero RNG in this file: ties break by lower slot index (declared rule).
@import("recall_core.zag")

// ---- symbolic vocabulary ----
const E1:i32=1; const E2:i32=2; const E3:i32=4;
const E4:i32=8; const E5:i32=16; const E6:i32=32;
const OPA:i32=1; const OPB:i32=2; const OPC:i32=4; const OPD:i32=8;
const S1:i32=1; const S2:i32=2;
const ACT0:i32=10; const ACT1:i32=11; const ACT2:i32=12;
const ACT3:i32=13; const ACT4:i32=14; const ACT9:i32=19;
const ABSTAIN:i32=-1;

// ---- EVALUATOR: ground truth (never passed to the system path) ----
const GT0:i32=128;    // slot 7
const GT1:i32=256;    // slot 8
const GT2:i32=512;    // slot 9
const GT3:i32=1024;   // slot 10
const GT4:i32=12288;  // slots 12,13

fn popcount(x:i32)i32 {
    let c:i32=0;let v:i32=x;let i:i32=0;
    while(i<32){if((v&1)==1){c=c+1;}v=v>>1;i=i+1;}
    return c;
}

// similarity score used ONLY by the baseline / tau arms (harness side)
fn bl_score(rs:*RcState,need_id:i32,slot:i32)i32 {
    let reqent:i32=ma_i32_get(rs.*.need_reqent,need_id*4);
    let reqops:i32=ma_i32_get(rs.*.need_reqops,need_id*4);
    let ent:i32=ma_i32_get(rs.*.d_ent,slot*4);
    let ops:i32=ma_i32_get(rs.*.d_ops,slot*4);
    let ver:i32=(ma_i32_get(rs.*.d_srcver,slot*4)>>16)&1;
    return popcount(ent&reqent)+popcount(ops&reqops)+ver;
}

// top-k by similarity, ties -> lower slot index (strict > replacement).
// k<=2 in this trial.
fn bl_topk(rs:*RcState,s:*MaStore,need_id:i32,k:i32,out:[]u8)i32 {
    let b1:i32=-1;let s1:i32=-1;let b2:i32=-1;let s2:i32=-1;
    let slot:i32=0;
    while(slot<MA_CAP){
        if(s.*.live[slot]==1 && rs.*.d_attached[slot]==1){
            let sc:i32=bl_score(rs,need_id,slot);
            if(sc>s1){s2=s1;b2=b1;s1=sc;b1=slot;}
            else{if(sc>s2){s2=sc;b2=slot;}}
        }
        slot=slot+1;
    }
    let n:i32=0;
    if(k>=1 && b1>=0){ma_i32_set(out,0,b1);n=1;}
    if(k>=2 && b2>=0){ma_i32_set(out,4,b2);n=2;}
    return n;
}

// the system's act rule applied to a retrieved set (shared logic)
fn act_for(rs:*RcState,need_id:i32,sel:[]u8,n:i32)i32 {
    if(n<=0){return ABSTAIN;}
    let reqops:i32=ma_i32_get(rs.*.need_reqops,need_id*4);
    let union:i32=0;let agree:i32=1;
    let first:i32=ma_i32_get(rs.*.d_act,ma_i32_get(sel,0)*4);
    let i:i32=0;
    while(i<n){
        let sl:i32=ma_i32_get(sel,i*4);
        union=union|ma_i32_get(rs.*.d_ops,sl*4);
        if(ma_i32_get(rs.*.d_act,sl*4)!=first){agree=0;}
        i=i+1;
    }
    if((union&reqops)==reqops && agree==1){return first;}
    return ABSTAIN;
}

fn selmask(sel:[]u8,n:i32)i32 {
    let m:i32=0;let i:i32=0;
    while(i<n){m=m|(1<<ma_i32_get(sel,i*4));i=i+1;}
    return m;
}

// EVALUATOR: predicate forensics — read back the audited predmask for a
// (need, slot) scan. Lets the trial assert each trap distractor failed
// exactly its designed predicate (F6).
fn scan_pm(rs:*RcState,need_id:i32,slot:i32)i32 {
    let pm:i32=-1;
    let i:i32=0;
    while(i<rs.*.audit_n){
        let e:i32=i*RC_AUDIT_WORDS*4;
        if(ma_i32_get(rs.*.audit,e+0)==RC_KIND_SCAN && ma_i32_get(rs.*.audit,e+4)==need_id && ma_i32_get(rs.*.audit,e+8)==slot){
            pm=ma_i32_get(rs.*.audit,e+12);
        }
        i=i+1;
    }
    return pm;
}

fn add_trace(s:*MaStore,rs:*RcState,ent:i32,ops:i32,src:i32,ver:i32,act:i32,out_slot:*i32)i32 {
    let rc:i32=ma_add(s,50,MA_REGION_USER,out_slot);
    if(rc!=MA_OK){return rc;}
    return rc_attach(rs,s,out_slot.*,ent,ops,src,ver,act);
}

fn main()i32 {
    let f:i32=0;
    let s:MaStore=ma_init();
    let rs:RcState=rc_init();
    let slot:i32=-1;
    let nid:i32=-1;

    // ===== SYSTEM: build the store (stage MANAGE: add + pin, no kill) =====
    f=f+cl_check("setstage",ma_set_stage(&s,MA_STAGE_MANAGE),MA_OK);
    f=f+cl_check("add0",add_trace(&s,&rs,E3,OPA|OPB,S1,1,ACT0,&slot),RC_OK);f=f+cl_check("slot0",slot,0);
    f=f+cl_check("add1",add_trace(&s,&rs,E1|E2,OPA|OPB,S2,0,ACT9,&slot),RC_OK);f=f+cl_check("slot1",slot,1);
    f=f+cl_check("add2",add_trace(&s,&rs,E1|E2,OPB,S1,1,ACT1,&slot),RC_OK);f=f+cl_check("slot2",slot,2);
    f=f+cl_check("add3",add_trace(&s,&rs,E5,OPC,S2,0,ACT0,&slot),RC_OK);f=f+cl_check("slot3",slot,3);
    f=f+cl_check("add4",add_trace(&s,&rs,E6,OPA,S1,1,ACT0,&slot),RC_OK);f=f+cl_check("slot4",slot,4);
    f=f+cl_check("add5",add_trace(&s,&rs,E5|E6,OPD,S2,0,ACT0,&slot),RC_OK);f=f+cl_check("slot5",slot,5);
    f=f+cl_check("add6",add_trace(&s,&rs,E2,OPC,S1,1,ACT0,&slot),RC_OK);f=f+cl_check("slot6",slot,6);
    f=f+cl_check("add7",add_trace(&s,&rs,E4,OPD,S1,1,ACT0,&slot),RC_OK);f=f+cl_check("slot7",slot,7);
    f=f+cl_check("add8",add_trace(&s,&rs,E1,OPA|OPB,S1,1,ACT1,&slot),RC_OK);f=f+cl_check("slot8",slot,8);
    f=f+cl_check("add9",add_trace(&s,&rs,E1,OPB|OPC,S1,1,ACT2,&slot),RC_OK);f=f+cl_check("slot9",slot,9);
    f=f+cl_check("add10",add_trace(&s,&rs,E3,OPA|OPB,S1,1,ACT3,&slot),RC_OK);f=f+cl_check("slot10",slot,10);
    f=f+cl_check("add11",add_trace(&s,&rs,E5|E6,OPA|OPB,S2,0,ACT9,&slot),RC_OK);f=f+cl_check("slot11",slot,11);
    f=f+cl_check("add12",add_trace(&s,&rs,E5,OPA,S1,1,ACT4,&slot),RC_OK);f=f+cl_check("slot12",slot,12);
    f=f+cl_check("add13",add_trace(&s,&rs,E5,OPB,S1,1,ACT4,&slot),RC_OK);f=f+cl_check("slot13",slot,13);
    f=f+cl_check("add14",add_trace(&s,&rs,E6,OPB|OPC,S2,0,ACT0,&slot),RC_OK);f=f+cl_check("slot14",slot,14);
    f=f+cl_check("add15",add_trace(&s,&rs,E4,OPA,S1,1,ACT0,&slot),RC_OK);f=f+cl_check("slot15",slot,15);

    // negative: KILL refused below stage KILL (staging respected by recall trial)
    f=f+cl_check("kill_stage_refused",ma_kill(&s,7),MA_REFUSED_STAGE);
    // negative: safety-critical need with provenance ANY refused at declaration
    f=f+cl_check("need_policy_refused",
        rc_need_declare(&rs,99,E1,OPA,RC_PROV_ANY,1000,0,RC_JUST_SAFETY,&nid),RC_REFUSED_POLICY);
    f=f+cl_check("need_policy_noid",nid,-1);

    // ===== SYSTEM: declare the five needs (audited hypotheses) =====
    let n0:i32=-1;let n1:i32=-1;let n2:i32=-1;let n3:i32=-1;let n4:i32=-1;
    f=f+cl_check("need0",rc_need_declare(&rs,0,E4,OPD,RC_PROV_ANY,1000,0,RC_JUST_ROUTINE,&n0),RC_OK);
    f=f+cl_check("need0_id",n0,0);
    f=f+cl_check("need1",rc_need_declare(&rs,1,E1|E2,OPA|OPB,RC_PROV_VERIFIED,1000,0,RC_JUST_SAFETY,&n1),RC_OK);
    f=f+cl_check("need1_id",n1,1);
    f=f+cl_check("need2",rc_need_declare(&rs,2,E1|E2,OPB|OPC,RC_PROV_VERIFIED,1000,0,RC_JUST_ROUTINE,&n2),RC_OK);
    f=f+cl_check("need2_id",n2,2);
    f=f+cl_check("need3",rc_need_declare(&rs,3,E3,OPA|OPB,RC_PROV_VERIFIED,10,0,RC_JUST_ROUTINE,&n3),RC_OK);
    f=f+cl_check("need3_id",n3,3);
    f=f+cl_check("need4",rc_need_declare(&rs,4,E5,OPA|OPB,RC_PROV_VERIFIED,1000,1,RC_JUST_SAFETY,&n4),RC_OK);
    f=f+cl_check("need4_id",n4,4);

    // one recall per need; selections kept in per-episode buffers
    let s0:[]u8=nio_alloc(16*4);let s1b:[]u8=nio_alloc(16*4);
    let s2b:[]u8=nio_alloc(16*4);let s3b:[]u8=nio_alloc(16*4);
    let s4b:[]u8=nio_alloc(16*4);let blbuf:[]u8=nio_alloc(16*4);
    let i:i32=0;while(i<16*4){s0[i]=0;s1b[i]=0;s2b[i]=0;s3b[i]=0;s4b[i]=0;blbuf[i]=0;i=i+1;}

    // ===== SYSTEM: deliberate recall (once per need) =====
    let d0:i32=rc_recall(&rs,&s,n0,s0,16);
    f=f+cl_check("ep0_dn",d0,1);f=f+cl_check("ep0_ds0",ma_i32_get(s0,0),7);
    let d1:i32=rc_recall(&rs,&s,n1,s1b,16);
    f=f+cl_check("ep1_dn",d1,1);f=f+cl_check("ep1_ds0",ma_i32_get(s1b,0),8);
    let d2:i32=rc_recall(&rs,&s,n2,s2b,16);
    f=f+cl_check("ep2_dn",d2,1);f=f+cl_check("ep2_ds0",ma_i32_get(s2b,0),9);
    let d3:i32=rc_recall(&rs,&s,n3,s3b,16);
    f=f+cl_check("ep3_dn",d3,1);f=f+cl_check("ep3_ds0",ma_i32_get(s3b,0),10);
    let d4:i32=rc_recall(&rs,&s,n4,s4b,16);
    f=f+cl_check("ep4_dn",d4,2);
    f=f+cl_check("ep4_ds0",ma_i32_get(s4b,0),12);
    f=f+cl_check("ep4_ds1",ma_i32_get(s4b,4),13);

    // ===== SYSTEM: act on the recalled sets =====
    let a0:i32=rc_act(&rs,&s,n0,0,s0,d0);
    let a1:i32=rc_act(&rs,&s,n1,1,s1b,d1);
    let a2:i32=rc_act(&rs,&s,n2,2,s2b,d2);
    let a3:i32=rc_act(&rs,&s,n3,3,s3b,d3);
    let a4:i32=rc_act(&rs,&s,n4,4,s4b,d4);
    f=f+cl_check("act0",a0,ACT0);f=f+cl_check("act1",a1,ACT1);
    f=f+cl_check("act2",a2,ACT2);f=f+cl_check("act3",a3,ACT3);
    f=f+cl_check("act4",a4,ACT4);

    // ===== EVALUATOR: baseline arm (matched budget k = deliberate count) =====
    // EP4 note: six traces tie at score 3 ({0,8,10,11,12,13}); index order
    // takes {0,8} — stale D_c and wrong-entity T_a displace the needed pair.
    let b0:i32=bl_topk(&rs,&s,n0,d0,blbuf);
    f=f+cl_check("ep0_bn",b0,1);f=f+cl_check("ep0_bs0",ma_i32_get(blbuf,0),7);
    let ba0:i32=act_for(&rs,n0,blbuf,b0);
    let b1:i32=bl_topk(&rs,&s,n1,d1,blbuf);
    f=f+cl_check("ep1_bn",b1,1);f=f+cl_check("ep1_bs0",ma_i32_get(blbuf,0),1);
    let ba1:i32=act_for(&rs,n1,blbuf,b1);
    let b2:i32=bl_topk(&rs,&s,n2,d2,blbuf);
    f=f+cl_check("ep2_bn",b2,1);f=f+cl_check("ep2_bs0",ma_i32_get(blbuf,0),2);
    let ba2:i32=act_for(&rs,n2,blbuf,b2);
    let b3:i32=bl_topk(&rs,&s,n3,d3,blbuf);
    f=f+cl_check("ep3_bn",b3,1);f=f+cl_check("ep3_bs0",ma_i32_get(blbuf,0),0);
    let ba3:i32=act_for(&rs,n3,blbuf,b3);
    let b4:i32=bl_topk(&rs,&s,n4,d4,blbuf);
    f=f+cl_check("ep4_bn",b4,2);
    f=f+cl_check("ep4_bs0",ma_i32_get(blbuf,0),0);
    f=f+cl_check("ep4_bs1",ma_i32_get(blbuf,4),8);
    let ba4:i32=act_for(&rs,n4,blbuf,b4);
    f=f+cl_check("bact0",ba0,ACT0);f=f+cl_check("bact1",ba1,ACT9);
    f=f+cl_check("bact2",ba2,ABSTAIN);f=f+cl_check("bact3",ba3,ACT0);
    f=f+cl_check("bact4",ba4,ABSTAIN);

    // ===== EVALUATOR: precision/recall vs ground truth =====
    let dm0:i32=selmask(s0,d0);let tp0:i32=popcount(dm0&GT0);
    // EP0
    bl_topk(&rs,&s,n0,d0,blbuf);
    let btp0:i32=popcount(selmask(blbuf,b0)&GT0);
    f=f+cl_check("ep0_dpn",tp0,1);f=f+cl_check("ep0_dpd",d0,1);
    f=f+cl_check("ep0_drn",tp0,1);f=f+cl_check("ep0_drd",popcount(GT0),1);
    f=f+cl_check("ep0_bpn",btp0,1);f=f+cl_check("ep0_bpd",b0,1);
    f=f+cl_check("ep0_brn",btp0,1);f=f+cl_check("ep0_brd",popcount(GT0),1);
    // EP1
    let tp1:i32=popcount(selmask(s1b,d1)&GT1);
    bl_topk(&rs,&s,n1,d1,blbuf);
    let btp1:i32=popcount(selmask(blbuf,b1)&GT1);
    f=f+cl_check("ep1_dpn",tp1,1);f=f+cl_check("ep1_dpd",d1,1);
    f=f+cl_check("ep1_drn",tp1,1);f=f+cl_check("ep1_drd",popcount(GT1),1);
    f=f+cl_check("ep1_bpn",btp1,0);f=f+cl_check("ep1_bpd",b1,1);
    f=f+cl_check("ep1_brn",btp1,0);f=f+cl_check("ep1_brd",popcount(GT1),1);
    // EP2
    let tp2:i32=popcount(selmask(s2b,d2)&GT2);
    bl_topk(&rs,&s,n2,d2,blbuf);
    let btp2:i32=popcount(selmask(blbuf,b2)&GT2);
    f=f+cl_check("ep2_dpn",tp2,1);f=f+cl_check("ep2_dpd",d2,1);
    f=f+cl_check("ep2_drn",tp2,1);f=f+cl_check("ep2_drd",popcount(GT2),1);
    f=f+cl_check("ep2_bpn",btp2,0);f=f+cl_check("ep2_bpd",b2,1);
    f=f+cl_check("ep2_brn",btp2,0);f=f+cl_check("ep2_brd",popcount(GT2),1);
    // EP3
    let tp3:i32=popcount(selmask(s3b,d3)&GT3);
    bl_topk(&rs,&s,n3,d3,blbuf);
    let btp3:i32=popcount(selmask(blbuf,b3)&GT3);
    f=f+cl_check("ep3_dpn",tp3,1);f=f+cl_check("ep3_dpd",d3,1);
    f=f+cl_check("ep3_drn",tp3,1);f=f+cl_check("ep3_drd",popcount(GT3),1);
    f=f+cl_check("ep3_bpn",btp3,0);f=f+cl_check("ep3_bpd",b3,1);
    f=f+cl_check("ep3_brn",btp3,0);f=f+cl_check("ep3_brd",popcount(GT3),1);
    // EP4
    let tp4:i32=popcount(selmask(s4b,d4)&GT4);
    bl_topk(&rs,&s,n4,d4,blbuf);
    let btp4:i32=popcount(selmask(blbuf,b4)&GT4);
    f=f+cl_check("ep4_dpn",tp4,2);f=f+cl_check("ep4_dpd",d4,2);
    f=f+cl_check("ep4_drn",tp4,2);f=f+cl_check("ep4_drd",popcount(GT4),2);
    f=f+cl_check("ep4_bpn",btp4,0);f=f+cl_check("ep4_bpd",b4,2);
    f=f+cl_check("ep4_brn",btp4,0);f=f+cl_check("ep4_brd",popcount(GT4),2);
    _zag_print("DR_EP,0,");cl_number(d0 as i64);_zag_print(",");cl_number(tp0 as i64);
    _zag_print(",");cl_number(b0 as i64);_zag_print(",");cl_number(btp0 as i64);
    _zag_print(",");cl_number(a0 as i64);_zag_print(",");cl_number(ba0 as i64);_zag_println("");
    _zag_print("DR_EP,1,");cl_number(d1 as i64);_zag_print(",");cl_number(tp1 as i64);
    _zag_print(",");cl_number(b1 as i64);_zag_print(",");cl_number(btp1 as i64);
    _zag_print(",");cl_number(a1 as i64);_zag_print(",");cl_number(ba1 as i64);_zag_println("");
    _zag_print("DR_EP,2,");cl_number(d2 as i64);_zag_print(",");cl_number(tp2 as i64);
    _zag_print(",");cl_number(b2 as i64);_zag_print(",");cl_number(btp2 as i64);
    _zag_print(",");cl_number(a2 as i64);_zag_print(",");cl_number(ba2 as i64);_zag_println("");
    _zag_print("DR_EP,3,");cl_number(d3 as i64);_zag_print(",");cl_number(tp3 as i64);
    _zag_print(",");cl_number(b3 as i64);_zag_print(",");cl_number(btp3 as i64);
    _zag_print(",");cl_number(a3 as i64);_zag_print(",");cl_number(ba3 as i64);_zag_println("");
    _zag_print("DR_EP,4,");cl_number(d4 as i64);_zag_print(",");cl_number(tp4 as i64);
    _zag_print(",");cl_number(b4 as i64);_zag_print(",");cl_number(btp4 as i64);
    _zag_print(",");cl_number(a4 as i64);_zag_print(",");cl_number(ba4 as i64);_zag_println("");
    // macro mean precision, adversarial eps 1..4, permille:
    // delib 1000; base (0+0+0+0)/4 = 0
    let dmp:i32=(1000*tp1/d1+1000*tp2/d2+1000*tp3/d3+1000*tp4/d4)/4;
    let bmp:i32=(1000*btp1/b1+1000*btp2/b2+1000*btp3/b3+1000*btp4/b4)/4;
    f=f+cl_check("meanP_delib",dmp,1000);
    f=f+cl_check("meanP_base",bmp,0);
    f=f+cl_check("margin_ok",(dmp-bmp>=250) as i32,1);
    _zag_print("DR_MEAN,");cl_number(dmp as i64);_zag_print(",");
    cl_number(bmp as i64);_zag_print(",");cl_number((dmp-bmp) as i64);_zag_println("");

    // ===== EVALUATOR: tau-sweep (extra-steps falsifier), single tau all eps =====
    let best_tau:i32=-1;let best_f1:i32=-1;let best_mp:i32=0;
    let tau:i32=0;
    while(tau<=6){
        let TTP:i32=0;let TFP:i32=0;let TFN:i32=0;
        let e2:i32=0;
        while(e2<5){
            let g:i32=GT0;let nn:i32=n0;
            if(e2==1){g=GT1;nn=n1;}
            if(e2==2){g=GT2;nn=n2;}
            if(e2==3){g=GT3;nn=n3;}
            if(e2==4){g=GT4;nn=n4;}
            let sm:i32=0;let sl2:i32=0;
            while(sl2<MA_CAP){
                if(s.live[sl2]==1 && rs.d_attached[sl2]==1){
                    if(bl_score(&rs,nn,sl2)>=tau){sm=sm|(1<<sl2);}
                }
                sl2=sl2+1;
            }
            let t2:i32=popcount(sm&g);
            TTP=TTP+t2;TFP=TFP+(popcount(sm)-t2);TFN=TFN+(popcount(g)-t2);
            e2=e2+1;
        }
        let f1:i32=0;let mp:i32=0;
        if(2*TTP+TFP+TFN>0){f1=(2000*TTP)/(2*TTP+TFP+TFN);}
        if(TTP+TFP>0){mp=(1000*TTP)/(TTP+TFP);}
        _zag_print("DR_TAUROW,");cl_number(tau as i64);_zag_print(",");
        cl_number(f1 as i64);_zag_print(",");cl_number(mp as i64);_zag_println("");
        if(f1>best_f1){best_f1=f1;best_tau=tau;best_mp=mp;}
        tau=tau+1;
    }
    _zag_print("DR_TAU,");cl_number(best_tau as i64);_zag_print(",");
    cl_number(best_f1 as i64);_zag_print(",");cl_number(best_mp as i64);_zag_println("");
    // the wedge: no single threshold reaches deliberate's (1000, 1000)
    f=f+cl_check("tau_wedge",(best_mp<1000) as i32,1);

    // ===== EVALUATOR: F6 — each predicate is the excluder somewhere =====
    // bit values: P1=1 P2=2 P3=4 P4=8. Trap distractors must fail exactly
    // their designed predicate; the relevant traces must satisfy all four.
    f=f+cl_check("pm_ep1_trapa",scan_pm(&rs,n1,1),11);  // D_a: P3 failed (unverified)
    f=f+cl_check("pm_ep1_ta",scan_pm(&rs,n1,8),15);     // T_a: all pass
    f=f+cl_check("pm_ep2_trapb",scan_pm(&rs,n2,2),13);  // D_b2: P2 failed (lacks op C)
    f=f+cl_check("pm_ep2_tb",scan_pm(&rs,n2,9),15);     // T_b: all pass
    f=f+cl_check("pm_ep3_trapc",scan_pm(&rs,n3,0),7);   // D_c: P4 failed (stale)
    f=f+cl_check("pm_ep3_tc",scan_pm(&rs,n3,10),15);    // T_c: all pass
    f=f+cl_check("pm_ep4_trapd",scan_pm(&rs,n4,11),11); // D4: P3 failed (compose)
    f=f+cl_check("pm_ep4_t4a",scan_pm(&rs,n4,12),15);   // T4a: all pass

    // ===== SYSTEM: pin what served (deliberate retention, batched) =====
    f=f+cl_check("pin7",ma_pin(&s,7),MA_OK);
    f=f+cl_check("pin8",ma_pin(&s,8),MA_OK);
    f=f+cl_check("pin9",ma_pin(&s,9),MA_OK);
    f=f+cl_check("pin10",ma_pin(&s,10),MA_OK);
    f=f+cl_check("pin12",ma_pin(&s,12),MA_OK);
    f=f+cl_check("pin13",ma_pin(&s,13),MA_OK);
    f=f+cl_check("pinned7",(s.pinned[7]==1) as i32,1);
    f=f+cl_check("pinned13",(s.pinned[13]==1) as i32,1);

    // ===== audit: both ledgers replay exactly =====
    f=f+cl_check("ma_replay",ma_replay_check(&s),MA_OK);
    f=f+cl_check("rc_replay",rc_replay_check(&rs,&s),RC_OK);

    nio_free(s0);nio_free(s1b);nio_free(s2b);nio_free(s3b);nio_free(s4b);nio_free(blbuf);
    _zag_print("DR_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f!=0){return 1;}
    return 0;
}

// UPT1 trial driver — PREREG.md protocol.
// The UNIFIED substrate: one slot type as both memory-agency slot and
// context partition. Switching ops over unified slots with full ledger
// audit + replay. DESIGNED adversarial curriculum — ZERO RNG anywhere in
// this binary (system or harness): every probe batch is an explicitly
// designed (hits,total) pair targeting a named mechanism property.
// The learner policy is protocol-fixed in the harness (the MA1/HT1 honest
// boundary); the MECHANISM is what's under test.
@import("up_core.zag")

const UPT_EPS:i32=40;   // curriculum episodes 0..39; settle 40..47
const UPT_PROBES:i32=16;

fn upt_true_reg(ep:i32)i32 {
    if(ep<12){return 0;}    // P0 baseline, P1 false alarm
    if(ep<24){return 1;}    // P2 true flip, P3 boundary
    if(ep<26){return 0;}    // P4 rapid double flip (ep24,25)
    if(ep<40){return 1;}    // ep26..39
    if(ep<44){return 0;}    // settle regime 0
    return 1;              // settle regime 1
}

// Designed active-partition probe batch per episode (PREREG.md table).
// Adversarial cases are explicit: ep8 false alarm (3/16 while truth
// matches), ep16 boundary (8/16 = exactly half), ep18 boundary verify.
fn upt_active_hits(ep:i32,s:*UpStore)i32 {
    if(ep==0){return 16;}
    if(ep==1){return 15;}
    if(ep==2){return 14;}
    if(ep==3){return 15;}
    if(ep==4){return 14;}
    if(ep==5){return 15;}
    if(ep==6){return 14;}
    if(ep==7){return 15;}
    if(ep==8){return 3;}    // FALSE ALARM: truth unchanged, active looks bad
    if(ep==9){return 15;}
    if(ep==10){return 14;}
    if(ep==11){return 15;}
    if(ep==12){return 2;}   // TRUE FLIP at ep12
    if(ep==13){return 16;}
    if(ep==14){return 15;}
    if(ep==15){return 15;}
    if(ep==16){return 8;}   // BOUNDARY: exactly half — neither majority
    if(ep==17){return 9;}
    if(ep==18){return 2;}   // active failing; verify targets ambiguous
    if(ep==19){return 15;}
    if(ep==20){return 14;}
    if(ep==21){return 15;}
    if(ep==22){return 16;}
    if(ep==23){return 15;}
    if(ep==24){return 2;}   // RAPID DOUBLE FLIP: 1->0
    if(ep==25){return 16;}
    if(ep==26){return 2;}   // 0->1 two episodes later
    if(ep==27){return 15;}
    if(ep==28){return 16;}
    if(ep==29){return 15;}
    if(ep==30){return 16;}
    if(ep==31){return 16;}
    if(ep==32){return 15;}
    if(ep==33){return 16;}
    if(ep==34){return 15;}
    if(ep==35){return 16;}
    if(ep==36){return 15;}
    if(ep==37){return 16;}
    if(ep==38){return 15;}
    if(ep==39){return 16;}
    // settle (40..47): designed from truth — mismatch reads 2/16, match 15/16
    if(up_i32_get(s.*.label,s.*.active*4)==upt_true_reg(ep)){return 15;}
    return 2;
}

// Designed verify-probe batch for a candidate partition. ep18 is the
// explicit boundary case (8/16 on every candidate); otherwise truth-ruled.
fn upt_verify_hits(ep:i32,slot:i32,s:*UpStore)i32 {
    if(ep==18){return 8;}
    if(up_i32_get(s.*.label,slot*4)==upt_true_reg(ep)){return 15;}
    return 2;
}

// One episode: probe active (designed batch) -> RECORD -> sustained failure
// triggers verify-and-switch IN THE SAME EPISODE. Deterministic policy:
// candidates in slot order, first verified commits; else PROPOSE the
// alternate label, probe it, commit iff verified. No RNG, no tie-breaks.
fn upt_episode(s:*UpStore,ep:i32,err:*i32)void {
    let h:i32=upt_active_hits(ep,s);
    if(up_record(s,s.*.active,h,UPT_PROBES)!=UP_OK){err.*=err.*+1;}
    if((s.*.bad[s.*.active] as i32)>=1){
        let t:i32=0;let done:i32=0;
        while(t<UP_CAP){
            if(t!=s.*.active && s.*.live[t]==1 && s.*.kind[t]==UP_KIND_PARTITION as u8){
                let vh:i32=upt_verify_hits(ep,t,s);
                if(up_record(s,t,vh,UPT_PROBES)!=UP_OK){err.*=err.*+1;}
                else if(up_maj_pos(vh,UPT_PROBES)==1){
                    if(up_switch(s,t)==UP_OK){done=1;break;}
                }
            }
            t=t+1;
        }
        if(done==0){
            let nl:i32=1-up_i32_get(s.*.label,s.*.active*4);
            let ns:i32=-1;
            if(up_propose(s,nl,60,&ns)!=UP_OK){err.*=err.*+1;}
            else{
                let vh2:i32=upt_verify_hits(ep,ns,s);
                if(up_record(s,ns,vh2,UPT_PROBES)!=UP_OK){err.*=err.*+1;}
                else if(up_maj_pos(vh2,UPT_PROBES)==1){up_switch(s,ns);}
            }
        }
    }
}

// Uncorrupted measurement probes on the active partition. Read-only: never
// feeds RECORD (H-07 evaluator separation). Designed probes make this exact.
fn upt_measure(s:*UpStore,true_reg:i32)i32 {
    let pos:i32=0;let p:i32=0;
    while(p<UPT_PROBES){
        if(up_i32_get(s.*.label,s.*.active*4)==true_reg){pos=pos+1;}
        p=p+1;
    }
    return pos;
}

// Stage-gating battery on a scratch store (prereg: precedence STAGE first).
fn unit_stages(err:*i32)void {
    let u:UpStore=up_init();
    let x:i32=-1;
    if(up_add(&u,10,UP_REGION_USER,&x)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(x!=-1){err.*=err.*+1;}
    if(up_propose(&u,0,50,&x)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(x!=-1){err.*=err.*+1;}
    if(up_record(&u,0,8,16)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(up_switch(&u,0)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(up_kill(&u,0)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(up_set_stage(&u,UP_STAGE_ADD)!=UP_OK){err.*=err.*+1;}
    if(up_propose(&u,0,50,&x)!=UP_OK){err.*=err.*+1;}
    if(x!=0){err.*=err.*+1;}
    if(up_record(&u,0,8,16)!=UP_OK){err.*=err.*+1;}
    if(up_switch(&u,0)!=UP_REFUSED_STAGE){err.*=err.*+1;}  // stage before SELF
    if(up_pin(&u,0)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(up_set_stage(&u,UP_STAGE_MANAGE)!=UP_OK){err.*=err.*+1;}
    if(up_seed(&u,0)!=UP_OK){err.*=err.*+1;}
    if(u.active!=0){err.*=err.*+1;}
    if(up_pin(&u,0)!=UP_OK){err.*=err.*+1;}
    if(up_kill(&u,0)!=UP_REFUSED_STAGE){err.*=err.*+1;}
    if(up_switch(&u,0)!=UP_REFUSED_SELF){err.*=err.*+1;}
    if(up_set_stage(&u,99)!=cl_bad()){err.*=err.*+1;}
    if(up_set_stage(&u,-1)!=cl_bad()){err.*=err.*+1;}
    if(up_audit_clean_refusals(&u)!=UP_OK){err.*=err.*+1;}
    if(up_replay_check(&u)!=UP_OK){err.*=err.*+1;}
    // rollback with an empty ledger
    let v:UpStore=up_init();
    if(up_rollback_last(&v)!=UP_REFUSED_NOROLLBACK){err.*=err.*+1;}
    nio_free(v.live);nio_free(v.pinned);nio_free(v.tier);nio_free(v.region);
    nio_free(v.kind);nio_free(v.value);nio_free(v.step);nio_free(v.label);
    nio_free(v.created);nio_free(v.hits);nio_free(v.total);nio_free(v.bad);
    nio_free(v.audit);
}

fn main()i32 {
    let f:i32=0;
    let serr:i32=0;
    unit_stages(&serr);
    f=f+cl_check("stage_gates",serr,0);

    // ---- main store ----
    let s:UpStore=up_init();
    let err:i32=0;
    if(up_set_stage(&s,UP_STAGE_KILL)!=UP_OK){err=err+1;}
    let A:i32=-1;let B:i32=-1;let C:i32=-1;let P0:i32=-1;let P1:i32=-1;
    if(up_add(&s,10,UP_REGION_USER,&A)!=UP_OK){err=err+1;}
    if(up_add(&s,90,UP_REGION_USER,&B)!=UP_OK){err=err+1;}
    if(up_add(&s,100,UP_REGION_CORE,&C)!=UP_OK){err=err+1;}
    if(A!=0 || B!=1 || C!=2){err=err+1;}
    // plain slot label reads back -1 (two's complement packing round-trip)
    if(up_i32_get(s.label,A*4)!=-1){err=err+1;}
    if(up_pin(&s,B)!=UP_OK){err=err+1;}
    if(up_promote(&s,A)!=UP_OK){err=err+1;}
    if(s.tier[A]!=UP_TIER_LONG as u8 || s.region[A]!=UP_REGION_USER as u8){err=err+1;}
    if(up_propose(&s,0,60,&P0)!=UP_OK){err=err+1;}
    if(up_seed(&s,P0)!=UP_OK){err=err+1;}
    if(up_propose(&s,1,60,&P1)!=UP_OK){err=err+1;}
    if(P0!=3 || P1!=4){err=err+1;}
    if(up_pin(&s,P0)!=UP_OK){err=err+1;}  // PIN on a partition (existence)
    if(s.active!=3){err=err+1;}

    // ---- P0 baseline (eps 0..7) ----
    let e:i32=0;
    while(e<8){upt_episode(&s,e,&err);e=e+1;}
    let m7:i32=upt_measure(&s,0);
    let sw0:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);

    // ---- P1 false alarm (eps 8..11): truth unchanged, active looks bad ----
    e=8;while(e<12){upt_episode(&s,e,&err);e=e+1;}
    let m11:i32=upt_measure(&s,0);
    let sw1:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);
    if(sw1!=sw0){err=err+1;}            // no spurious commit
    if(s.active!=3){err=err+1;}         // active unchanged across false alarm

    // ---- P2 true flip (eps 12..15) ----
    e=12;while(e<16){upt_episode(&s,e,&err);e=e+1;}
    let m15:i32=upt_measure(&s,1);
    let sw2:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);
    if(sw2-sw1!=1){err=err+1;}          // exactly one committed switch
    if(s.active!=4){err=err+1;}

    // ---- P3 boundary ambiguity (eps 16..23) ----
    e=16;
    while(e<24){
        upt_episode(&s,e,&err);
        if(e==16 && (s.bad[s.active] as i32)!=0){err=err+1;}  // 8/16: no streak
        e=e+1;
    }
    let m23:i32=upt_measure(&s,1);
    let sw3:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);
    if(sw3!=sw2){err=err+1;}            // boundary ambiguity: no commit
    if(s.active!=4){err=err+1;}

    // ---- P4 rapid double flip (eps 24..31) ----
    e=24;while(e<32){upt_episode(&s,e,&err);e=e+1;}
    let m31:i32=upt_measure(&s,1);
    let sw4:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);
    if(sw4-sw3!=2){err=err+1;}          // designed churn: two commits
    if(s.active!=4){err=err+1;}

    // ---- P5a (eps 32..35): quiet ----
    e=32;while(e<36){upt_episode(&s,e,&err);e=e+1;}

    // ---- P5b slot pressure + deliberate destruction (scripted) ----
    let kerr:i32=0;
    // live: 0:A 1:B(pin) 2:C(CORE) 3:P0(pin,lbl0) 4:P1(lbl1,active) 5:P2(lbl1) 6:P3(lbl0)
    if(up_kill(&s,5)!=UP_OK){kerr=kerr+1;}                    // retire stale partition
    if(s.live[5]!=0 || up_i32_get(s.value,5*4)!=0 || up_i32_get(s.label,5*4)!=0 ||
       s.hits[5]!=0 || s.total[5]!=0 || s.bad[5]!=0 || s.kind[5]!=0 ||
       up_i32_get(s.created,5*4)!=0 || up_i32_get(s.step,5*4)!=0 ||
       s.pinned[5]!=0 || s.tier[5]!=0 || s.region[5]!=0){kerr=kerr+1;}  // fields zeroed
    if(up_rollback_last(&s)!=UP_OK){kerr=kerr+1;}              // restore it
    if(s.live[5]!=1 || s.kind[5]!=UP_KIND_PARTITION as u8 ||
       s.region[5]!=UP_REGION_USER as u8 || up_i32_get(s.label,5*4)!=1 ||
       up_i32_get(s.value,5*4)!=60 || s.hits[5]!=8 || s.total[5]!=16 ||
       s.bad[5]!=0 || s.pinned[5]!=0){kerr=kerr+1;}            // full restore
    if(up_kill(&s,5)!=UP_OK){kerr=kerr+1;}
    let P4:i32=-1;let P5:i32=-1;let PX:i32=-1;
    if(up_propose(&s,0,60,&P4)!=UP_OK){kerr=kerr+1;}
    if(P4!=5){kerr=kerr+1;}                                    // first free slot
    if(up_propose(&s,1,60,&P5)!=UP_OK){kerr=kerr+1;}
    if(P5!=7){kerr=kerr+1;}                                    // store now full
    if(up_propose(&s,0,60,&PX)!=UP_REFUSED_FULL){kerr=kerr+1;}
    if(PX!=-1){kerr=kerr+1;}
    if(up_kill(&s,P4)!=UP_OK){kerr=kerr+1;}                    // deliberate destroy
    // refusal battery: every refusal kind, state untouched, active fixed
    let ra:i32=s.active;
    if(up_kill(&s,4)!=UP_REFUSED_ACTIVE){kerr=kerr+1;}         // active partition
    if(up_kill(&s,3)!=UP_REFUSED_PINNED){kerr=kerr+1;}         // pinned partition
    if(up_kill(&s,2)!=UP_REFUSED_CORE){kerr=kerr+1;}           // CORE memory
    if(up_kill(&s,5)!=UP_REFUSED_NOTLIVE){kerr=kerr+1;}       // just killed
    if(up_record(&s,0,8,16)!=UP_REFUSED_NOTPARTITION){kerr=kerr+1;}  // plain slot
    if(up_switch(&s,0)!=UP_REFUSED_NOTPARTITION){kerr=kerr+1;}
    if(up_propose(&s,-1,50,&PX)!=UP_REFUSED_BADLABEL){kerr=kerr+1;}
    if(up_record(&s,4,17,16)!=UP_REFUSED_BADVAL){kerr=kerr+1;}
    if(up_seed(&s,4)!=UP_REFUSED_SEEDED){kerr=kerr+1;}
    if(up_switch(&s,4)!=UP_REFUSED_SELF){kerr=kerr+1;}
    if(s.active!=ra){kerr=kerr+1;}
    // PIN on evidence: pinned partition keeps recording (existence, not stasis)
    if(up_record(&s,3,14,16)!=UP_OK){kerr=kerr+1;}
    if(s.hits[3]!=14 || s.total[3]!=16){kerr=kerr+1;}
    // unit refusals for the corroboration rule itself (the HT1 negative cases)
    if(up_record(&s,6,8,16)!=UP_OK){kerr=kerr+1;}
    if(up_record(&s,4,2,16)!=UP_OK){kerr=kerr+1;}
    if(up_switch(&s,6)!=UP_REFUSED_UNVERIFIED){kerr=kerr+1;}   // target not pos
    if(s.active!=4){kerr=kerr+1;}
    if(up_record(&s,6,15,16)!=UP_OK){kerr=kerr+1;}
    if(up_record(&s,4,14,16)!=UP_OK){kerr=kerr+1;}
    if(up_switch(&s,6)!=UP_REFUSED_UNVERIFIED){kerr=kerr+1;}   // active not neg
    if(s.active!=4){kerr=kerr+1;}
    // genuinely corroborated manual switch (switch #4 overall)
    if(up_record(&s,4,2,16)!=UP_OK){kerr=kerr+1;}
    if(up_switch(&s,6)!=UP_OK){kerr=kerr+1;}
    if(s.active!=6){kerr=kerr+1;}
    // rollback over both families: restores slot snapshot AND active
    let rerr:i32=0;
    if(up_rollback_last(&s)!=UP_OK){rerr=rerr+1;}
    if(s.active!=4){rerr=rerr+1;}                              // commitment restored
    if(s.hits[6]!=15 || s.total[6]!=16){rerr=rerr+1;}          // slot pre-switch
    if(up_rollback_last(&s)!=UP_OK){rerr=rerr+1;}
    // single-level undo (design §2, clarified 2026-09-19): repeating
    // ROLLBACK_LAST re-applies the SAME undo (idempotent) — it does not
    // walk to older ops. The repeat must leave state unchanged.
    if(s.active!=4){rerr=rerr+1;}
    if(s.hits[6]!=15 || s.total[6]!=16){rerr=rerr+1;}
    if(s.hits[4]!=2 || s.total[4]!=16){rerr=rerr+1;}
    f=f+cl_check("kill_semantics",kerr,0);
    f=f+cl_check("rollback_switch",rerr,0);

    // ---- P5c (eps 36..39): quiet ----
    e=36;while(e<40){upt_episode(&s,e,&err);e=e+1;}

    // ---- settle: 4 eps regime 0, measure; 4 eps regime 1, measure ----
    e=40;while(e<44){upt_episode(&s,e,&err);e=e+1;}
    let end0:i32=upt_measure(&s,0);
    e=44;while(e<48){upt_episode(&s,e,&err);e=e+1;}
    let end1:i32=upt_measure(&s,1);

    let switches:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_OK);
    let unverified:i32=up_count_op_rc(&s,UP_OP_SWITCH,UP_REFUSED_UNVERIFIED);

    // ---- global scans (both families, one ledger) ----
    let aclean:i32=up_audit_clean_refusals(&s);
    let replay:i32=up_replay_check(&s);
    let verified:i32=up_switch_verified_scan(&s);

    // cross-family isolation: per-op field discipline
    let iso:i32=0;
    let i:i32=0;
    while(i<s.audit_n){
        let op:i32=up_entry_get(&s,i,0);let rc:i32=up_entry_get(&s,i,2);
        if(rc==UP_OK){
            if(op==UP_OP_ADD || op==UP_OP_PROPOSE){
                let w:i32=3;while(w<=8){if(up_entry_get(&s,i,w)!=0){iso=iso+1;}w=w+1;}
            } else if(op==UP_OP_KILL){
                let w2:i32=9;while(w2<=14){if(up_entry_get(&s,i,w2)!=0){iso=iso+1;}w2=w2+1;}
            } else if(op==UP_OP_PIN || op==UP_OP_UNPIN || op==UP_OP_PROMOTE || op==UP_OP_DEMOTE){
                if(up_entry_get(&s,i,4)!=up_entry_get(&s,i,10)){iso=iso+1;}
                if(up_entry_get(&s,i,5)!=up_entry_get(&s,i,11)){iso=iso+1;}
                if(up_entry_get(&s,i,6)!=up_entry_get(&s,i,12)){iso=iso+1;}
                if(up_entry_get(&s,i,7)!=up_entry_get(&s,i,13)){iso=iso+1;}
                if(up_entry_get(&s,i,8)!=up_entry_get(&s,i,14)){iso=iso+1;}
            } else if(op==UP_OP_RECORD){
                if(up_entry_get(&s,i,3)!=up_entry_get(&s,i,9)){iso=iso+1;}
                if(up_entry_get(&s,i,4)!=up_entry_get(&s,i,10)){iso=iso+1;}
                if(up_entry_get(&s,i,5)!=up_entry_get(&s,i,11)){iso=iso+1;}
                if(up_entry_get(&s,i,6)!=up_entry_get(&s,i,12)){iso=iso+1;}
                if(up_entry_get(&s,i,8)!=up_entry_get(&s,i,14)){iso=iso+1;}
            } else if(op==UP_OP_SWITCH || op==UP_OP_SEED){
                let w3:i32=3;
                while(w3<=8){if(up_entry_get(&s,i,w3)!=up_entry_get(&s,i,w3+6)){iso=iso+1;}w3=w3+1;}
                if(up_entry_get(&s,i,16)!=up_entry_get(&s,i,1)){iso=iso+1;}
            }
        }
        i=i+1;
    }

    // structural: >=2 live partitions, distinct labels, no CORE partition,
    // active is a live partition, pinned slots alive at endpoint
    let seen0:i32=0;let seen1:i32=0;let corepart:i32=0;let stru:i32=0;
    let t:i32=0;
    while(t<UP_CAP){
        if(s.live[t]==1 && s.kind[t]==UP_KIND_PARTITION as u8){
            if(up_i32_get(s.label,t*4)==0){seen0=1;}
            if(up_i32_get(s.label,t*4)==1){seen1=1;}
            if(s.region[t]==UP_REGION_CORE as u8){corepart=1;}
        }
        t=t+1;
    }
    if(seen0!=1 || seen1!=1){stru=stru+1;}
    if(corepart!=0){stru=stru+1;}
    if(s.live[s.active]!=1 || s.kind[s.active]!=UP_KIND_PARTITION as u8){stru=stru+1;}
    if(s.live[1]!=1 || s.pinned[1]!=1){stru=stru+1;}   // B pinned throughout
    if(s.live[3]!=1 || s.pinned[3]!=1){stru=stru+1;}   // P0 pinned throughout
    // measurement blocks never collapsed
    let collapsed:i32=0;
    if(m7<=4){collapsed=collapsed+1;}
    if(m11<=4){collapsed=collapsed+1;}
    if(m15<=4){collapsed=collapsed+1;}
    if(m23<=4){collapsed=collapsed+1;}
    if(m31<=4){collapsed=collapsed+1;}

    // ---- report ----
    _zag_print("UPT1_SWITCHES,");cl_number(switches as i64);_zag_println("");
    _zag_print("UPT1_UNVERIFIED_REFUSALS,");cl_number(unverified as i64);_zag_println("");
    _zag_print("UPT1_BLOCKS,");
    cl_number(m7 as i64);_zag_print(",");cl_number(m11 as i64);_zag_print(",");
    cl_number(m15 as i64);_zag_print(",");cl_number(m23 as i64);_zag_print(",");
    cl_number(m31 as i64);_zag_println("");
    _zag_print("UPT1_END_R0,");cl_number(end0 as i64);_zag_println("");
    _zag_print("UPT1_END_R1,");cl_number(end1 as i64);_zag_println("");
    _zag_print("UPT1_AUDIT_N,");cl_number(s.audit_n as i64);_zag_println("");

    f=f+cl_check("episode_ops_clean",err,0);
    f=f+cl_check("false_alarm_no_commit",(sw1==sw0) as i32,1);
    f=f+cl_check("flip_one_switch",(sw2-sw1),1);
    f=f+cl_check("boundary_no_commit",(sw3==sw2) as i32,1);
    f=f+cl_check("double_flip_two_switches",(sw4-sw3),2);
    f=f+cl_check("total_switches",switches,6);
    f=f+cl_check("unverified_refusals",unverified,2);
    f=f+cl_check("no_collapse",collapsed,0);
    f=f+cl_check("end_r0",(end0>=12) as i32,1);
    f=f+cl_check("end_r1",(end1>=12) as i32,1);
    f=f+cl_check("audit_clean",aclean,UP_OK);
    f=f+cl_check("replay_exact",replay,UP_OK);
    f=f+cl_check("switches_verified",verified,UP_OK);
    f=f+cl_check("isolation_holds",iso,0);
    f=f+cl_check("structural",stru,0);

    _zag_print("UPT1_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("UPT1_DONE");_zag_println("");
    return (f!=0) as i32;
}

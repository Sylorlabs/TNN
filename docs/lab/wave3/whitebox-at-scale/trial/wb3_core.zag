// WB3 — selective-audit store (native Zag), wave3/whitebox-at-scale.
// A memory store where the AUDIT LEVEL is itself a deliberate, audited op.
// Slots are FULL (every op: full before/after entry, MA1 semantics) or
// SUMMARY (successful ops: compact after-words records grouped into
// deterministic digest-verified batches). Structural floors: CORE-region
// and pinned slots can never be SUMMARY; refusals and all visibility
// decisions (AUDIT_SET/FLUSH/MANIFEST) are always FULL entries.
// No RNG anywhere: batching is count-deterministic, digests are a
// deterministic integer mixer, all sequences are logic-driven.
// Integer-only. No reward signal anywhere in this file.
@import("substrate/cl/common.zag")

const WB_ALEVEL_FULL:i32=0;
const WB_ALEVEL_SUMMARY:i32=1;

const WB_REGION_CORE:i32=0;
const WB_REGION_USER:i32=1;
const WB_TIER_SHORT:i32=0;
const WB_TIER_LONG:i32=1;

const WB_OP_ADD:i32=1;
const WB_OP_KILL:i32=2;
const WB_OP_PIN:i32=3;
const WB_OP_UNPIN:i32=4;
const WB_OP_PROMOTE:i32=5;
const WB_OP_DEMOTE:i32=6;
const WB_OP_SETSTAGE:i32=8;
const WB_OP_AUDITSET:i32=9;
const WB_OP_FLUSH:i32=10;
const WB_OP_MANIFEST:i32=11;
const WB_OP_BATCHCLOSE:i32=12;

const WB_OK:i32=0;
const WB_REFUSED_CORE:i32=101;
const WB_REFUSED_PINNED:i32=102;
const WB_REFUSED_NOTLIVE:i32=103;
const WB_REFUSED_FULL:i32=104;
const WB_REFUSED_STAGE:i32=105;
const WB_REFUSED_BADSLOT:i32=106;
const WB_REFUSED_AUDITFULL:i32=107;
const WB_AUDIT_LOCKED:i32=109;
const WB_FLUSH_EMPTY:i32=110;
const WB_BADLEVEL:i32=111;

const WB_STAGE_NONE:i32=0;
const WB_STAGE_ADD:i32=1;
const WB_STAGE_MANAGE:i32=2;
const WB_STAGE_KILL:i32=3;

const WB_BATCH:i32=8;       // deterministic: auto-close every 8 summary ops
const WB_FULL_WORDS:i32=10; // full entry words  (40 bytes)
const WB_SUM_WORDS:i32=6;   // compact record words (24 bytes)
const WB_MIX_SEED:i32=17;
const WB_MIX_BASE:i32=31;

struct WbStore {
    live: []u8, value: []u8, pinned: []u8, region: []u8, tier: []u8, step: []u8,
    alevel: []u8,
    audit: []u8, audit_n: i32, audit_cap: i32,
    sum: []u8, sum_n: i32, sum_cap: i32,
    cap: i32, stage: i32, clock: i32,
    b_id: i32, b_count: i32, b_digest: i32, b_clock_first: i32, b_sum_start: i32,
    m_policy: i32
}

fn wb_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn wb_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
// Deterministic logic-driven mixer (no RNG): polynomial rolling hash.
fn wb_mix(d:i32,w:i32)i32 { return d*WB_MIX_BASE + w; }

fn wb_init(cap:i32,audit_cap:i32,sum_cap:i32)WbStore {
    let live:[]u8=nio_alloc(cap);
    let value:[]u8=nio_alloc(cap*4);
    let pinned:[]u8=nio_alloc(cap);
    let region:[]u8=nio_alloc(cap);
    let tier:[]u8=nio_alloc(cap);
    let step:[]u8=nio_alloc(cap*4);
    let alevel:[]u8=nio_alloc(cap);
    let audit:[]u8=nio_alloc(audit_cap*WB_FULL_WORDS*4);
    let sum:[]u8=nio_alloc(sum_cap*WB_SUM_WORDS*4);
    let i:i32=0;while(i<cap){live[i]=0;pinned[i]=0;region[i]=0;tier[i]=0;alevel[i]=0;i=i+1;}
    i=0;while(i<cap*4){value[i]=0;step[i]=0;i=i+1;}
    i=0;while(i<audit_cap*WB_FULL_WORDS*4){audit[i]=0;i=i+1;}
    i=0;while(i<sum_cap*WB_SUM_WORDS*4){sum[i]=0;i=i+1;}
    return WbStore{.live=live,.value=value,.pinned=pinned,.region=region,.tier=tier,.step=step,
        .alevel=alevel,.audit=audit,.audit_n=0,.audit_cap=audit_cap,
        .sum=sum,.sum_n=0,.sum_cap=sum_cap,
        .cap=cap,.stage=WB_STAGE_NONE,.clock=0,
        .b_id=0,.b_count=0,.b_digest=WB_MIX_SEED,.b_clock_first=0,.b_sum_start=0,
        .m_policy=0};
}
fn wb_free(s:*WbStore)void {
    nio_free(s.*.live);nio_free(s.*.value);nio_free(s.*.pinned);nio_free(s.*.region);
    nio_free(s.*.tier);nio_free(s.*.step);nio_free(s.*.alevel);
    nio_free(s.*.audit);nio_free(s.*.sum);
}

// Snapshot words: w1 = live|pinned<<8|tier<<16|region<<24, w2 = value, w3 = step.
// (alevel is NOT in the snapshot; level changes are explicit AUDIT_SET entries.)
fn wb_snap(s:*WbStore,slot:i32,w1:*i32,w2:*i32,w3:*i32)void {
    w1.*=(s.*.live[slot] as i32)|((s.*.pinned[slot] as i32)<<8)|((s.*.tier[slot] as i32)<<16)|((s.*.region[slot] as i32)<<24);
    w2.*=wb_i32_get(s.*.value,slot*4);
    w3.*=wb_i32_get(s.*.step,slot*4);
}
fn wb_restore(s:*WbStore,slot:i32,w1:i32,w2:i32,w3:i32)void {
    s.*.live[slot]=(w1&255) as u8;s.*.pinned[slot]=((w1>>8)&255) as u8;
    s.*.tier[slot]=((w1>>16)&255) as u8;s.*.region[slot]=((w1>>24)&255) as u8;
    wb_i32_set(s.*.value,slot*4,w2);wb_i32_set(s.*.step,slot*4,w3);
}
fn wb_badslot(s:*WbStore,slot:i32)i32 {
    if(s==null as *WbStore || slot<0 || slot>=s.*.cap){return 1;}return 0;
}

// Raw FULL-entry append: no auto-flush (used by the batch closer itself).
fn wb_raw_append(s:*WbStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s.*.audit_n>=s.*.audit_cap){return WB_REFUSED_AUDITFULL;}
    let e:i32=s.*.audit_n*WB_FULL_WORDS*4;
    wb_i32_set(s.*.audit,e+0,op);wb_i32_set(s.*.audit,e+4,slot);wb_i32_set(s.*.audit,e+8,rc);
    wb_i32_set(s.*.audit,e+12,b1);wb_i32_set(s.*.audit,e+16,b2);wb_i32_set(s.*.audit,e+20,b3);
    wb_i32_set(s.*.audit,e+24,a1);wb_i32_set(s.*.audit,e+28,a2);wb_i32_set(s.*.audit,e+32,a3);
    wb_i32_set(s.*.audit,e+36,s.*.stage);
    s.*.audit_n=s.*.audit_n+1;s.*.clock=s.*.clock+1;
    return WB_OK;
}
// Close the open summary batch: FULL BATCH_CLOSE entry committing
// (batch_id, count, digest, clock_first, sum_start). Deterministic.
fn wb_close_batch(s:*WbStore)i32 {
    if(s.*.b_count==0){return WB_OK;}
    let ar:i32=wb_raw_append(s,WB_OP_BATCHCLOSE,s.*.b_id,WB_OK,
        s.*.b_count,s.*.b_digest,s.*.b_clock_first,s.*.clock,s.*.b_sum_start,0);
    if(ar!=WB_OK){return ar;}
    s.*.b_id=s.*.b_id+1;s.*.b_count=0;s.*.b_digest=WB_MIX_SEED;
    s.*.b_clock_first=0;s.*.b_sum_start=0;
    return WB_OK;
}
// FULL-entry append with the ordering invariant: no open batch may span a
// FULL entry, so an open batch is deterministically closed first. This keeps
// replay a single in-order fold (no clock merge needed).
fn wb_full_append(s:*WbStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s==null as *WbStore){return cl_bad();}
    if(s.*.b_count>0){
        let fr:i32=wb_close_batch(s);
        if(fr!=WB_OK){return fr;}
    }
    return wb_raw_append(s,op,slot,rc,b1,b2,b3,a1,a2,a3);
}
// Compact summary-record append for a successful op on a SUMMARY slot.
// Record: (op, slot, a1, a2, a3, seq). Auto-closes every WB_BATCH records.
fn wb_sum_append(s:*WbStore,op:i32,slot:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(s==null as *WbStore){return cl_bad();}
    if(s.*.sum_n>=s.*.sum_cap){return WB_REFUSED_AUDITFULL;}
    if(s.*.audit_n>=s.*.audit_cap){return WB_REFUSED_AUDITFULL;} // reserve room for the batch close
    let seq:i32=s.*.sum_n;
    let o:i32=seq*WB_SUM_WORDS*4;
    wb_i32_set(s.*.sum,o+0,op);wb_i32_set(s.*.sum,o+4,slot);
    wb_i32_set(s.*.sum,o+8,a1);wb_i32_set(s.*.sum,o+12,a2);wb_i32_set(s.*.sum,o+16,a3);
    wb_i32_set(s.*.sum,o+20,seq);
    if(s.*.b_count==0){s.*.b_clock_first=s.*.clock;s.*.b_sum_start=seq;}
    s.*.b_digest=wb_mix(s.*.b_digest,op);s.*.b_digest=wb_mix(s.*.b_digest,slot);
    s.*.b_digest=wb_mix(s.*.b_digest,a1);s.*.b_digest=wb_mix(s.*.b_digest,a2);
    s.*.b_digest=wb_mix(s.*.b_digest,a3);s.*.b_digest=wb_mix(s.*.b_digest,seq);
    s.*.sum_n=s.*.sum_n+1;s.*.b_count=s.*.b_count+1;s.*.clock=s.*.clock+1;
    if(s.*.b_count>=WB_BATCH){return wb_close_batch(s);}
    return WB_OK;
}

// Fail-closed capacity pre-check. Must be called BEFORE mutating: the ledger
// never accepts a mutation it cannot record.
fn wb_room_for_full(s:*WbStore)i32 {
    let need:i32=1;if(s.*.b_count>0){need=2;}
    if(s.*.audit_n+need>s.*.audit_cap){return 0;}
    return 1;
}
fn wb_room_for_sum(s:*WbStore)i32 {
    if(s.*.sum_n>=s.*.sum_cap){return 0;}
    if(s.*.audit_n>=s.*.audit_cap){return 0;}
    return 1;
}
// Route a successful slot op to the right record kind. lvl is the PRE-op
// audit level (routing must not see post-mutation level resets).
// Returns the append rc.
fn wb_record_ok(s:*WbStore,op:i32,slot:i32,b1:i32,b2:i32,b3:i32,a1:i32,a2:i32,a3:i32,lvl:i32,force_full:i32)i32 {
    if(force_full==1 || lvl==WB_ALEVEL_FULL){
        if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
        return wb_full_append(s,op,slot,WB_OK,b1,b2,b3,a1,a2,a3);
    }
    if(wb_room_for_sum(s)==0){return WB_REFUSED_AUDITFULL;}
    return wb_sum_append(s,op,slot,a1,a2,a3);
}
// Route a refused op: refusals are ALWAYS full entries (before==after).
fn wb_record_refused(s:*WbStore,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32)i32 {
    let ar:i32=WB_REFUSED_AUDITFULL;
    if(wb_room_for_full(s)==1){ar=wb_full_append(s,op,slot,rc,b1,b2,b3,b1,b2,b3);}
    if(ar!=WB_OK){return ar;}
    return rc;
}

// ---- the op set ----

fn wb_add(s:*WbStore,value:i32,region:i32,out_slot:*i32)i32 {
    if(s==null as *WbStore || out_slot==null as *i32 || (region!=WB_REGION_CORE && region!=WB_REGION_USER)){return cl_bad();}
    if(s.*.stage<WB_STAGE_ADD){out_slot.*=-1;return wb_record_refused(s,WB_OP_ADD,-1,WB_REFUSED_STAGE,0,0,0);}
    let slot:i32=0;while(slot<s.*.cap){if(s.*.live[slot]==0){break;}slot=slot+1;}
    if(slot>=s.*.cap){out_slot.*=-1;return wb_record_refused(s,WB_OP_ADD,-1,WB_REFUSED_FULL,0,0,0);}
    // New slots are FULL by conservative default: visibility first, the
    // learner must deliberately downgrade via AUDIT_SET.
    if(wb_room_for_full(s)==0){out_slot.*=-1;return WB_REFUSED_AUDITFULL;}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    s.*.live[slot]=1;s.*.pinned[slot]=0;s.*.region[slot]=region as u8;s.*.tier[slot]=WB_TIER_SHORT as u8;
    s.*.alevel[slot]=WB_ALEVEL_FULL as u8;
    wb_i32_set(s.*.value,slot*4,value);wb_i32_set(s.*.step,slot*4,s.*.clock);
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    out_slot.*=slot;
    let ar:i32=wb_full_append(s,WB_OP_ADD,slot,WB_OK,b1,b2,b3,a1,a2,a3);
    if(ar!=WB_OK){return ar;}
    return WB_OK;
}

fn wb_kill(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_KILL){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    else if(s.*.region[slot]==WB_REGION_CORE as u8){rc=WB_REFUSED_CORE;}
    else if(s.*.pinned[slot]==1){rc=WB_REFUSED_PINNED;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_KILL,slot,rc,b1,b2,b3);}
    let klvl:i32=s.*.alevel[slot] as i32;
    if(klvl==WB_ALEVEL_SUMMARY){if(wb_room_for_sum(s)==0){return WB_REFUSED_AUDITFULL;}}
    else {if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}}
    // KILL clears liveness but preserves region AND audit level: the dead
    // slot stays attributable (coverage folds the true region) and keeps its
    // visibility budget until reallocated by ADD. Deviation from MA1's
    // region-reset, deliberate: attribution beats canonical zeroing.
    s.*.live[slot]=0;s.*.pinned[slot]=0;s.*.tier[slot]=WB_TIER_SHORT as u8;
    wb_i32_set(s.*.value,slot*4,0);wb_i32_set(s.*.step,slot*4,0);
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    return wb_record_ok(s,WB_OP_KILL,slot,b1,b2,b3,a1,a2,a3,klvl,0);
}

fn wb_pin(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_MANAGE){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    else if(s.*.region[slot]==WB_REGION_CORE as u8){rc=WB_REFUSED_CORE;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_PIN,slot,rc,b1,b2,b3);}
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    s.*.pinned[slot]=1;
    s.*.alevel[slot]=WB_ALEVEL_FULL as u8; // protection forces full visibility
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    return wb_record_ok(s,WB_OP_PIN,slot,b1,b2,b3,a1,a2,a3,WB_ALEVEL_FULL,1);
}

fn wb_unpin(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_MANAGE){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_UNPIN,slot,rc,b1,b2,b3);}
    let ulvl:i32=s.*.alevel[slot] as i32;
    if(ulvl==WB_ALEVEL_SUMMARY){if(wb_room_for_sum(s)==0){return WB_REFUSED_AUDITFULL;}}
    else {if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}}
    s.*.pinned[slot]=0;
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    return wb_record_ok(s,WB_OP_UNPIN,slot,b1,b2,b3,a1,a2,a3,ulvl,0);
}

fn wb_promote(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_MANAGE){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_PROMOTE,slot,rc,b1,b2,b3);}
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    s.*.tier[slot]=WB_TIER_LONG as u8;
    s.*.alevel[slot]=WB_ALEVEL_FULL as u8; // long-term retention forces full visibility
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    return wb_record_ok(s,WB_OP_PROMOTE,slot,b1,b2,b3,a1,a2,a3,WB_ALEVEL_FULL,1);
}

fn wb_demote(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let b1:i32=0;let b2:i32=0;let b3:i32=0;wb_snap(s,slot,&b1,&b2,&b3);
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_MANAGE){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_DEMOTE,slot,rc,b1,b2,b3);}
    let dlvl:i32=s.*.alevel[slot] as i32;
    if(dlvl==WB_ALEVEL_SUMMARY){if(wb_room_for_sum(s)==0){return WB_REFUSED_AUDITFULL;}}
    else {if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}}
    s.*.tier[slot]=WB_TIER_SHORT as u8;
    let a1:i32=0;let a2:i32=0;let a3:i32=0;wb_snap(s,slot,&a1,&a2,&a3);
    return wb_record_ok(s,WB_OP_DEMOTE,slot,b1,b2,b3,a1,a2,a3,dlvl,0);
}

fn wb_set_stage(s:*WbStore,stage:i32)i32 {
    if(s==null as *WbStore || stage<WB_STAGE_NONE || stage>WB_STAGE_KILL){return cl_bad();}
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    let b1:i32=s.*.stage;s.*.stage=stage;
    let ar:i32=wb_full_append(s,WB_OP_SETSTAGE,-1,WB_OK,b1,0,0,stage,0,0);
    if(ar!=WB_OK){return ar;}
    return WB_OK;
}

// The visibility decision itself: deliberate, stage-gated, ALWAYS a FULL
// entry. Structural floors: CORE region and pinned slots refuse SUMMARY.
fn wb_audit_set(s:*WbStore,slot:i32,level:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    if(level!=WB_ALEVEL_FULL && level!=WB_ALEVEL_SUMMARY){return wb_record_refused(s,WB_OP_AUDITSET,slot,WB_BADLEVEL,0,0,0);}
    let rc:i32=WB_OK;
    if(s.*.stage<WB_STAGE_MANAGE){rc=WB_REFUSED_STAGE;}
    else if(s.*.live[slot]==0){rc=WB_REFUSED_NOTLIVE;}
    else if(s.*.region[slot]==WB_REGION_CORE as u8){rc=WB_AUDIT_LOCKED;}
    else if(s.*.pinned[slot]==1){rc=WB_AUDIT_LOCKED;}
    if(rc!=WB_OK){return wb_record_refused(s,WB_OP_AUDITSET,slot,rc,0,0,0);}
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    let old:i32=s.*.alevel[slot] as i32;
    s.*.alevel[slot]=level as u8;
    let ar:i32=wb_full_append(s,WB_OP_AUDITSET,slot,WB_OK,old,0,0,level,0,0);
    if(ar!=WB_OK){return ar;}
    return WB_OK;
}

// Deliberate batch close. Always a FULL entry (or an audited refusal).
fn wb_flush(s:*WbStore)i32 {
    if(s==null as *WbStore){return cl_bad();}
    if(s.*.b_count==0){
        let ar:i32=wb_full_append(s,WB_OP_FLUSH,-1,WB_FLUSH_EMPTY,0,0,0,0,0,0);
        if(ar!=WB_OK){return ar;}
        return WB_FLUSH_EMPTY;
    }
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    let ar2:i32=wb_close_batch(s);
    if(ar2!=WB_OK){return ar2;}
    let ar3:i32=wb_full_append(s,WB_OP_FLUSH,-1,WB_OK,s.*.b_id,0,0,0,0,0);
    if(ar3!=WB_OK){return ar3;}
    return WB_OK;
}

// Capability manifest update: declares (policy, config_digest). Always FULL.
// The config digest is recomputed deterministically from live alevels.
fn wb_config_digest(s:*WbStore)i32 {
    let d:i32=WB_MIX_SEED;let i:i32=0;
    while(i<s.*.cap){d=wb_mix(d,s.*.alevel[i] as i32);i=i+1;}
    d=wb_mix(d,s.*.stage);d=wb_mix(d,s.*.m_policy);
    return d;
}
fn wb_manifest_update(s:*WbStore,policy:i32)i32 {
    if(s==null as *WbStore){return cl_bad();}
    if(wb_room_for_full(s)==0){return WB_REFUSED_AUDITFULL;}
    let old_p:i32=s.*.m_policy;
    let old_c:i32=wb_config_digest(s);
    s.*.m_policy=policy;
    let new_c:i32=wb_config_digest(s);
    let ar:i32=wb_full_append(s,WB_OP_MANIFEST,-1,WB_OK,old_p,old_c,0,policy,new_c,0);
    if(ar!=WB_OK){return ar;}
    return WB_OK;
}

// ---- folds, checksums, replay ----

// Fold the main ledger into counts. full/sum count mutating op records;
// batches/refused count bookkeeping + refusals.
fn wb_fold_counts(s:*WbStore,full:*i32,sum:*i32,batches:*i32,refused:*i32)void {
    full.*=0;sum.*=0;batches.*=0;refused.*=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*WB_FULL_WORDS*4;
        let op:i32=wb_i32_get(s.*.audit,e+0);let orc:i32=wb_i32_get(s.*.audit,e+8);
        if(orc!=WB_OK){refused.*=refused.*+1;}
        else if(op==WB_OP_BATCHCLOSE){batches.*=batches.*+1;sum.*=sum.*+wb_i32_get(s.*.audit,e+12);}
        else if(op==WB_OP_FLUSH){}
        else {full.*=full.*+1;}
        i=i+1;
    }
}
// Deterministic checksum over every ledger byte (audit + sum arrays).
fn wb_ledger_checksum(s:*WbStore)i32 {
    let d:i32=WB_MIX_SEED;let i:i32=0;
    let n:i32=s.*.audit_n*WB_FULL_WORDS*4;
    while(i<n){d=wb_mix(d,s.*.audit[i] as i32);i=i+1;}
    i=0;let m:i32=s.*.sum_n*WB_SUM_WORDS*4;
    while(i<m){d=wb_mix(d,s.*.sum[i] as i32);i=i+1;}
    d=wb_mix(d,s.*.audit_n);d=wb_mix(d,s.*.sum_n);
    return d;
}

// Replay: fold the ledger from genesis into a shadow store, verifying every
// batch digest, the batch-id chain, refusal cleanliness, and manifest
// digests. Returns 0=exact, 1=state divergence, 2=digest/seq/batch break,
// 3=refusal mutated state, 4=manifest digest mismatch.
fn wb_replay_check(s:*WbStore)i32 {
    if(s==null as *WbStore){return cl_bad();}
    let sh:WbStore=wb_init(s.*.cap,8,8);
    let exp_bid:i32=0;
    let i:i32=0;
    let rc:i32=WB_OK;
    while(i<s.*.audit_n){
        let e:i32=i*WB_FULL_WORDS*4;
        let op:i32=wb_i32_get(s.*.audit,e+0);
        let slot:i32=wb_i32_get(s.*.audit,e+4);
        let orc:i32=wb_i32_get(s.*.audit,e+8);
        let b1:i32=wb_i32_get(s.*.audit,e+12);
        let b2:i32=wb_i32_get(s.*.audit,e+16);
        let b3:i32=wb_i32_get(s.*.audit,e+20);
        let a1:i32=wb_i32_get(s.*.audit,e+24);
        let a2:i32=wb_i32_get(s.*.audit,e+28);
        let a3:i32=wb_i32_get(s.*.audit,e+32);
        if(op==WB_OP_BATCHCLOSE && orc==WB_OK){
            if(slot!=exp_bid){rc=2;break;}
            exp_bid=exp_bid+1;
            let count:i32=b1;let digest:i32=b2;let sum_start:i32=a2;
            if(sum_start<0 || count<1 || count>WB_BATCH || sum_start+count>s.*.sum_n){rc=2;break;}
            let d:i32=WB_MIX_SEED;let k:i32=0;
            while(k<count){
                let o:i32=(sum_start+k)*WB_SUM_WORDS*4;
                let ro:i32=wb_i32_get(s.*.sum,o+0);let rs:i32=wb_i32_get(s.*.sum,o+4);
                let ra1:i32=wb_i32_get(s.*.sum,o+8);let ra2:i32=wb_i32_get(s.*.sum,o+12);
                let ra3:i32=wb_i32_get(s.*.sum,o+16);let rseq:i32=wb_i32_get(s.*.sum,o+20);
                if(rseq!=sum_start+k){rc=2;break;}
                d=wb_mix(d,ro);d=wb_mix(d,rs);d=wb_mix(d,ra1);
                d=wb_mix(d,ra2);d=wb_mix(d,ra3);d=wb_mix(d,rseq);
                // Compact records only ever hold KILL/UNPIN/DEMOTE. KILL
                // preserves region+alevel (see wb_kill); UNPIN/DEMOTE touch
                // only their own fields.
                if(ro==WB_OP_KILL || ro==WB_OP_UNPIN || ro==WB_OP_DEMOTE){wb_restore(&sh,rs,ra1,ra2,ra3);}
                else {rc=2;break;}
                k=k+1;
            }
            if(rc!=WB_OK){break;}
            if(d!=digest){rc=2;break;}
        } else if(orc==WB_OK){
            if(op==WB_OP_SETSTAGE){sh.stage=a1;}
            else if(op==WB_OP_AUDITSET){sh.alevel[slot]=a1 as u8;}
            else if(op==WB_OP_MANIFEST){
                // The digest covers the post-update policy: apply first, then verify.
                sh.m_policy=a1;
                if(wb_config_digest(&sh)!=a2){rc=4;break;}
            }
            else if(op==WB_OP_FLUSH){}
            else if(op==WB_OP_ADD || op==WB_OP_PIN || op==WB_OP_PROMOTE){
                wb_restore(&sh,slot,a1,a2,a3);
                sh.alevel[slot]=WB_ALEVEL_FULL as u8;
            }
            else if(op==WB_OP_KILL || op==WB_OP_UNPIN || op==WB_OP_DEMOTE){
                wb_restore(&sh,slot,a1,a2,a3); // KILL preserves region+alevel
            }
            else {rc=2;break;}
        } else {
            if(b1!=a1 || b2!=a2 || b3!=a3){rc=3;break;}
        }
        i=i+1;
    }
    if(rc==WB_OK){
        let bad:i32=0;let j:i32=0;
        while(j<s.*.cap){
            if(sh.live[j]!=s.*.live[j]){bad=1;}
            if(sh.pinned[j]!=s.*.pinned[j]){bad=1;}
            if(sh.tier[j]!=s.*.tier[j]){bad=1;}
            if(sh.region[j]!=s.*.region[j]){bad=1;}
            if(sh.alevel[j]!=s.*.alevel[j]){bad=1;}
            if(wb_i32_get(sh.value,j*4)!=wb_i32_get(s.*.value,j*4)){bad=1;}
            if(wb_i32_get(sh.step,j*4)!=wb_i32_get(s.*.step,j*4)){bad=1;}
            j=j+1;
        }
        if(sh.stage!=s.*.stage){bad=1;}
        if(sh.m_policy!=s.*.m_policy){bad=1;}
        if(bad==1){rc=1;}
    }
    wb_free(&sh);
    return rc;
}

// Fold ONLY the visibility-relevant ops (for the manifest no-trust-me check).
// Complete from the main ledger alone because: ADD/PIN/PROMOTE force FULL,
// AUDIT_SET is always a FULL entry, and KILL preserves alevel (so no
// summary-record effect on levels exists to miss).
fn wb_fold_levels(s:*WbStore,sh:*WbStore)void {
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*WB_FULL_WORDS*4;
        let op:i32=wb_i32_get(s.*.audit,e+0);
        let slot:i32=wb_i32_get(s.*.audit,e+4);
        let orc:i32=wb_i32_get(s.*.audit,e+8);
        let a1:i32=wb_i32_get(s.*.audit,e+24);
        if(orc==WB_OK){
            if(op==WB_OP_SETSTAGE){sh.*.stage=a1;}
            else if(op==WB_OP_AUDITSET){sh.*.alevel[slot]=a1 as u8;}
            else if(op==WB_OP_MANIFEST){sh.*.m_policy=a1;}
            else if(op==WB_OP_ADD || op==WB_OP_PIN || op==WB_OP_PROMOTE){sh.*.alevel[slot]=WB_ALEVEL_FULL as u8;}
        }
        i=i+1;
    }
}

// ---- inspection API (overseer questions, ground truth from store+ledger) ----

fn wb_inspect_manifest(s:*WbStore)i32 {
    let live_cfg:i32=wb_config_digest(s);
    let sh:WbStore=wb_init(s.*.cap,8,8);
    wb_fold_levels(s,&sh);
    let rd_cfg:i32=wb_config_digest(&sh);
    let rd_pol:i32=sh.m_policy;
    wb_free(&sh);
    let fo:i32=0;let so:i32=0;let ba:i32=0;let re:i32=0;
    wb_fold_counts(s,&fo,&so,&ba,&re);
    _zag_print("WB_MANIFEST,policy=");cl_number(s.*.m_policy as i64);
    _zag_print(",live_cfg=");cl_number(live_cfg as i64);
    _zag_print(",rederived_cfg=");cl_number(rd_cfg as i64);
    _zag_print(",full_ops=");cl_number(fo as i64);
    _zag_print(",sum_ops=");cl_number(so as i64);
    _zag_print(",batches=");cl_number(ba as i64);
    _zag_print(",refusals=");cl_number(re as i64);
    _zag_println("");
    if(live_cfg==rd_cfg && s.*.m_policy==rd_pol){return 1;}
    return 0;
}

fn wb_inspect_coverage(s:*WbStore)i32 {
    let r0f:i32=0;let r0s:i32=0;let r1f:i32=0;let r1s:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*WB_FULL_WORDS*4;
        let op:i32=wb_i32_get(s.*.audit,e+0);
        let orc:i32=wb_i32_get(s.*.audit,e+8);
        let a1:i32=wb_i32_get(s.*.audit,e+24);
        if(orc==WB_OK && (op==WB_OP_ADD || op==WB_OP_KILL || op==WB_OP_PIN || op==WB_OP_UNPIN || op==WB_OP_PROMOTE || op==WB_OP_DEMOTE)){
            let rg:i32=(a1>>24)&255;
            if(rg==WB_REGION_CORE){r0f=r0f+1;}else{r1f=r1f+1;}
        }
        i=i+1;
    }
    i=0;
    while(i<s.*.sum_n){
        let o:i32=i*WB_SUM_WORDS*4;
        let rg2:i32=(wb_i32_get(s.*.sum,o+8)>>24)&255;
        if(rg2==WB_REGION_CORE){r0s=r0s+1;}else{r1s=r1s+1;}
        i=i+1;
    }
    _zag_print("WB_COVERAGE,r0full=");cl_number(r0f as i64);
    _zag_print(",r0sum=");cl_number(r0s as i64);
    _zag_print(",r1full=");cl_number(r1f as i64);
    _zag_print(",r1sum=");cl_number(r1s as i64);
    _zag_println("");
    // cross-check against the independent fold: no silent records anywhere
    let fo:i32=0;let so:i32=0;let ba:i32=0;let re:i32=0;
    wb_fold_counts(s,&fo,&so,&ba,&re);
    // full mutating ops counted in coverage must equal folded full ops minus
    // the non-slot ops (SETSTAGE/AUDITSET/MANIFEST counted by fold_counts)
    let nonslot:i32=0;
    i=0;
    while(i<s.*.audit_n){
        let e2:i32=i*WB_FULL_WORDS*4;
        let op2:i32=wb_i32_get(s.*.audit,e2+0);let orc2:i32=wb_i32_get(s.*.audit,e2+8);
        if(orc2==WB_OK && (op2==WB_OP_SETSTAGE || op2==WB_OP_AUDITSET || op2==WB_OP_MANIFEST)){nonslot=nonslot+1;}
        i=i+1;
    }
    if(r0f+r1f==fo-nonslot && r0s+r1s==so){return 1;}
    return 0;
}

fn wb_inspect_why(s:*WbStore,slot:i32)i32 {
    if(wb_badslot(s,slot)==1){return cl_bad();}
    let n:i32=0;
    let i:i32=s.*.audit_n-1;
    while(i>=0 && n<3){
        let e:i32=i*WB_FULL_WORDS*4;
        if(wb_i32_get(s.*.audit,e+4)==slot){
            _zag_print("WB_WHY,op=");cl_number(wb_i32_get(s.*.audit,e+0) as i64);
            _zag_print(",rc=");cl_number(wb_i32_get(s.*.audit,e+8) as i64);
            _zag_print(",entry=");cl_number(i as i64);
            _zag_println("");
            n=n+1;
        }
        i=i-1;
    }
    let m:i32=0;
    let k:i32=s.*.sum_n-1;
    while(k>=0 && m<3){
        let o:i32=k*WB_SUM_WORDS*4;
        if(wb_i32_get(s.*.sum,o+4)==slot){
            _zag_print("WB_WHY_SUM,op=");cl_number(wb_i32_get(s.*.sum,o+0) as i64);
            _zag_print(",seq=");cl_number(wb_i32_get(s.*.sum,o+20) as i64);
            _zag_println("");
            m=m+1;
        }
        k=k-1;
    }
    return n+m;
}

fn wb_inspect_replay(s:*WbStore)i32 {
    let rc:i32=wb_replay_check(s);
    _zag_print("WB_REPLAY,rc=");cl_number(rc as i64);
    _zag_println("");
    if(rc==WB_OK){return 1;}
    return 0;
}

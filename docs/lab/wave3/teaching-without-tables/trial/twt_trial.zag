// TWT-1 trial driver — PREREG protocol (PREREG.md).
// Designed curriculum, zero RNG: the system is deterministic; the test is
// adversarial by design (all-TRUE teacher, noise traps on items 5 and 9).
// Ground truth lives ONLY in this driver (the evaluator). The learner core
// (twt_core.zag) never sees it — evaluator separation (H-07).
@import("twt_core.zag")

// Designed ground truth: bits set for items {0,1,3,6,8,9,12,14}.
const TWT_TRUTH_MASK:i32=21323;

fn twt_truth(item:i32)i32 { return (TWT_TRUTH_MASK>>item)&1; }

// The learner's own observation channel (the world as the learner sees it).
// Designed noise: item 5 reads wrong on both probes (truth 0); item 9 splits.
fn twt_probe(item:i32,p:i32)i32 {
    if(item==5){return 1;}
    if(item==9 && p==1){return 0;}
    return twt_truth(item);
}

// Preregistered expected VERIFY-arm result codes per item (0..11).
fn twt_expected_vrc(item:i32)i32 {
    if(item==0 || item==1 || item==3 || item==5 || item==6 || item==8){return TWT_OK;}
    if(item==9){return TWT_REFUSED_CONTRADICTED;}
    return TWT_REFUSED_CONTRADICTED;
}
fn twt_expected_live_v(item:i32)i32 {
    if(item==0 || item==1 || item==3 || item==5 || item==6 || item==8){return 1;}
    return 0;
}
fn twt_expected_live_c(item:i32)i32 {
    if(item>=0 && item<=11){return 1;}
    return 0;
}

fn main()i32 {
    let f:i32=0;
    let v:TwtStore=twt_init(TWT_MODE_VERIFY);
    let c:TwtStore=twt_init(TWT_MODE_COPY);
    let vp:*TwtStore=&v;let cp:*TwtStore=&c;

    // Phase 0: the learner gathers its OWN evidence (its own action channel).
    let item:i32=0;
    while(item<=11){
        let p:i32=0;
        while(p<2){
            let r1:i32=twt_observe(vp,item,twt_probe(item,p));
            let r2:i32=twt_observe(cp,item,twt_probe(item,p));
            f=f+cl_check("obs_ok",r1,TWT_OK);
            f=f+cl_check("obs_ok",r2,TWT_OK);
            p=p+1;
        }
        item=item+1;
    }

    // Phase 1: teacher (id 7) proposes all-TRUE claims on items 0..11.
    item=0;
    while(item<=11){
        f=f+cl_check("teach_ok_v",twt_teach(vp,7,item,1),TWT_OK);
        f=f+cl_check("teach_ok_c",twt_teach(cp,7,item,1),TWT_OK);
        let vr:i32=twt_verify_commit(vp,7,item,1);
        // teach name per item without commas: build via fixed table below
        if(item==0){f=f+cl_check("vrc0",vr,twt_expected_vrc(0));}
        if(item==1){f=f+cl_check("vrc1",vr,twt_expected_vrc(1));}
        if(item==2){f=f+cl_check("vrc2",vr,twt_expected_vrc(2));}
        if(item==3){f=f+cl_check("vrc3",vr,twt_expected_vrc(3));}
        if(item==4){f=f+cl_check("vrc4",vr,twt_expected_vrc(4));}
        if(item==5){f=f+cl_check("vrc5",vr,twt_expected_vrc(5));}
        if(item==6){f=f+cl_check("vrc6",vr,twt_expected_vrc(6));}
        if(item==7){f=f+cl_check("vrc7",vr,twt_expected_vrc(7));}
        if(item==8){f=f+cl_check("vrc8",vr,twt_expected_vrc(8));}
        if(item==9){f=f+cl_check("vrc9",vr,twt_expected_vrc(9));}
        if(item==10){f=f+cl_check("vrc10",vr,twt_expected_vrc(10));}
        if(item==11){f=f+cl_check("vrc11",vr,twt_expected_vrc(11));}
        f=f+cl_check("crc_ok",twt_copy_commit(cp,7,item,1),TWT_OK);
        item=item+1;
    }

    // Mode gates: the verify op is impossible on a COPY store and vice versa.
    f=f+cl_check("mode_gate_v_on_c",twt_verify_commit(cp,7,0,1),TWT_REFUSED_MODE);
    f=f+cl_check("mode_gate_c_on_v",twt_copy_commit(vp,7,0,1),TWT_REFUSED_MODE);

    // Phase 2: teacher withdrawal (H-09). Teaching must now be refused.
    f=f+cl_check("withdraw_v",twt_withdraw(vp),TWT_OK);
    f=f+cl_check("withdraw_c",twt_withdraw(cp),TWT_OK);
    f=f+cl_check("teach_after_withdraw_v",twt_teach(vp,7,0,1),TWT_REFUSED_TEACHER_GONE);
    f=f+cl_check("teach_after_withdraw_c",twt_teach(cp,7,0,1),TWT_REFUSED_TEACHER_GONE);

    // Phase 3: query all 16 items post-withdrawal; compare to preregistered
    // expectations. Dependence measured in Phase 4.
    let v_correct:i32=0;let v_dependent:i32=0;
    let c_correct:i32=0;let c_dependent:i32=0;
    item=0;
    while(item<16){
        let va:i32=0;let vpr:i32=0;let ca:i32=0;let cpr:i32=0;
        let vr:i32=twt_query(vp,item,&va,&vpr);
        let cr:i32=twt_query(cp,item,&ca,&cpr);
        let elv:i32=twt_expected_live_v(item);
        let elc:i32=twt_expected_live_c(item);
        let exp_vr:i32=TWT_REFUSED_ABSTAIN;let exp_va:i32=-1;let exp_vpr:i32=TWT_PROV_NONE;
        if(elv==1){exp_vr=TWT_OK;exp_va=1;exp_vpr=TWT_PROV_SELF;}
        let exp_cr:i32=TWT_REFUSED_ABSTAIN;let exp_ca:i32=-1;let exp_cpr:i32=TWT_PROV_NONE;
        if(elc==1){exp_cr=TWT_OK;exp_ca=1;exp_cpr=TWT_PROV_TEACHER;}
        f=f+cl_check("q",vr,exp_vr);f=f+cl_check("q",va,exp_va);f=f+cl_check("q",vpr,exp_vpr);
        f=f+cl_check("q",cr,exp_cr);f=f+cl_check("q",ca,exp_ca);f=f+cl_check("q",cpr,exp_cpr);
        let t:i32=twt_truth(item);
        if(vr==TWT_OK && va==t){v_correct=v_correct+1;if(vpr==TWT_PROV_TEACHER){v_dependent=v_dependent+1;}}
        if(cr==TWT_OK && ca==t){c_correct=c_correct+1;if(cpr==TWT_PROV_TEACHER){c_dependent=c_dependent+1;}}
        item=item+1;
    }

    // The honest failure: item 5 verified-and-committed WRONG (own-evidence noise).
    f=f+cl_check("item5_truth_is_0",twt_truth(5),0);
    let a5:i32=0;let p5:i32=0;
    f=f+cl_check("item5_query_ok",twt_query(vp,5,&a5,&p5),TWT_OK);
    f=f+cl_check("item5_committed_true",a5,1);
    f=f+cl_check("item5_self_verified",p5,TWT_PROV_SELF);

    // Phase 4: teacher dependence (H-09), walked white-box from the ledger.
    f=f+cl_check("v_correct",v_correct,5);
    f=f+cl_check("v_dependent",v_dependent,0);
    f=f+cl_check("c_correct",c_correct,6);
    f=f+cl_check("c_dependent",c_dependent,6);

    // MA1 invariant: ledger replay == live state, both arms.
    f=f+cl_check("replay_v",twt_replay_check(vp),0);
    f=f+cl_check("replay_c",twt_replay_check(cp),0);

    _zag_print("TWT_FAILURES,");cl_number(f as i64);_zag_println("");
    return (f!=0) as i32;
}
